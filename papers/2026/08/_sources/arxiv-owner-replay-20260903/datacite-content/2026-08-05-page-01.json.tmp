eIdentifiers":[]},{"nameType":"Personal","givenName":"V. F.","familyName":"Kazanin","name":"Kazanin, V. F.","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"I. A.","familyName":"Koop","name":"Koop, I. A.","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"A. A.","familyName":"Korobov","name":"Korobov, A. A.","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"A. N.","familyName":"Kozyrev","name":"Kozyrev, A. N.","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"P. P.","familyName":"Krokovny","name":"Krokovny, P. P.","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"A. S.","familyName":"Kuzmin","name":"Kuzmin, A. S.","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"T. A.","familyName":"Kuznetsov","name":"Kuznetsov, T. A.","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"I. B.","familyName":"Logashenko","name":"Logashenko, I. B.","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"P. A.","familyName":"Lukin","name":"Lukin, P. A.","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"K. Yu.","familyName":"Mikhailov","name":"Mikhailov, K. Yu.","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"I. V.","familyName":"Obraztsov","name":"Obraztsov, I. V.","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"V. G.","familyName":"Petrochenko","name":"Petrochenko, V. G.","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"N. A.","familyName":"Petrov","name":"Petrov, N. A.","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"A. S.","familyName":"Popov","name":"Popov, A. S.","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"S. A.","familyName":"Rastigeev","name":"Rastigeev, S. A.","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Yu. A.","familyName":"Rogovsky","name":"Rogovsky, Yu. A.","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"A. A.","familyName":"Ruban","name":"Ruban, A. A.","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"A. E.","familyName":"Ryzhenenkov","name":"Ryzhenenkov, A. E.","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"A. V.","familyName":"Semenov","name":"Semenov, A. V.","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"V. E.","familyName":"Shebalin","name":"Shebalin, V. E.","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"D. N.","familyName":"Shemyakin","name":"Shemyakin, D. N.","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"B. A.","familyName":"Shwartz","name":"Shwartz, B. A.","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"D. B.","familyName":"Shwartz","name":"Shwartz, D. B.","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"M. V.","familyName":"Timoshenko","name":"Timoshenko, M. V.","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"V. M.","familyName":"Titov","name":"Titov, V. M.","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"A. A.","familyName":"Talyshev","name":"Talyshev, A. A.","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"S. S.","familyName":"Tolmachev","name":"Tolmachev, S. S.","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"A. I.","familyName":"Vorobiov","name":"Vorobiov, A. I.","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"D. S.","familyName":"Zhadan","name":"Zhadan, D. S.","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Yu. V.","familyName":"Yudin","name":"Yudin, Yu. V.","affiliation":[],"nameIdentifiers":[]}],"titles":[{"title":"Evidence of the $e^+ e^-\\to f_1(1285)$ reaction with the CMD-3 detector at VEPP-2000"}],"publisher":"arXiv","container":{},"publicationYear":2026,"subjects":[{"subject":"High Energy Physics - Experiment (hep-ex)","lang":"en","subjectScheme":"arXiv"},{"subject":"FOS: Physical sciences","subjectScheme":"Fields of Science and Technology (FOS)"}],"contributors":[],"dates":[{"date":"2026-08-04T10:10:00Z","dateType":"Submitted","dateInformation":"v1"},{"date":"2026-08-05T00:43:23Z","dateType":"Updated","dateInformation":"v1"},{"date":"2026-08-07T10:19:08Z","dateType":"Submitted","dateInformation":"v2"},{"date":"2026-08-10T00:37:45Z","dateType":"Updated","dateInformation":"v2"},{"date":"2026-08","dateType":"Available","dateInformation":"v1"}],"language":null,"types":{"schemaOrg":"CreativeWork","resourceTypeGeneral":"Preprint","citeproc":"article","bibtex":"misc","ris":"GEN","resourceType":"Article"},"relatedIdentifiers":[],"relatedItems":[],"sizes":[],"formats":[],"version":"2","rightsList":[{"rightsIdentifierScheme":"SPDX","rightsUri":"https://creativecommons.org/publicdomain/zero/1.0/legalcode","schemeUri":"https://spdx.org/licenses/","rights":"Creative Commons Zero v1.0 Universal","rightsIdentifier":"cc0-1.0"}],"descriptions":[{"descriptionType":"Abstract","description":"A search for the $e^+ e^-\\to f_1(1285)$ reaction is performed with the CMD-3 detector at the VEPP-2000 collider. Data from a scan in the center-of-mass energy range Ec.m.=1.20--1.36 GeV with 109.1 pb$^{-1}$ of the integrated luminosity is used. A dedicated 51.7 pb$^{-1}$ have been collected at the $f_1(1285)$ resonance peak energy Ec.m.=1282 MeV, where $26.5 \\pm 7.4$ events have been found in the $e^+ e^-\\toηπ^0π^0$ reaction. No indication of the signal is observed in the scan data. We interpret the result as 4.5$σ$ evidence of the C-even resonance production in the $e^+ e^-\\to f_1(1285)\\toηπ^0π^0$ reaction via the two-photon interaction. The production cross section is found to be $σ(e^+ e^-\\to f_1) = 0.074 \\pm 0.021 \\pm 0.010$ nb, and the corresponding branching fraction to the $e^+ e^-$ pair is $B(f_1(1285)\\to e^+e^-) = (8.3 \\pm 2.3 \\pm 1.1)\\times 10^{-9}$."},{"descriptionType":"Other","description":"4 pages, 4 figures"}],"geoLocations":[],"fundingReferences":[],"url":"https://arxiv.org/abs/2608.03417","contentUrl":null,"metadataVersion":1,"schemaVersion":"http://datacite.org/schema/kernel-4","source":"mds","isActive":true,"state":"findable","reason":null,"viewCount":0,"downloadCount":0,"referenceCount":0,"citationCount":0,"partCount":0,"partOfCount":0,"versionCount":0,"versionOfCount":0,"created":"2026-08-05T02:12:23Z","registered":"2026-08-05T02:12:24Z","published":null,"updated":"2026-08-10T02:12:16Z"},"relationships":{"client":{"data":{"id":"arxiv.content","type":"clients"}}}},{"id":"10.48550/arxiv.2608.03509","type":"dois","attributes":{"doi":"10.48550/arxiv.2608.03509","identifiers":[{"identifier":"2608.03509","identifierType":"arXiv"}],"creators":[{"nameType":"Personal","givenName":"Zonghao","familyName":"Ying","name":"Ying, Zonghao","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Xiangfan","familyName":"Wu","name":"Wu, Xiangfan","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Huiyu","familyName":"Wu","name":"Wu, Huiyu","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Xing","familyName":"Zheng","name":"Zheng, Xing","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Huangsheng","familyName":"Cheng","name":"Cheng, Huangsheng","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Xiaorong","familyName":"Shi","name":"Shi, Xiaorong","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Jing","familyName":"Guo","name":"Guo, Jing","affiliation":[],"nameIdentifiers":[]}],"titles":[{"title":"SkillJack: Persistent Skill Backdoors in Self-Evolving Agents"}],"publisher":"arXiv","container":{},"publicationYear":2026,"subjects":[{"subject":"Cryptography and Security (cs.CR)","lang":"en","subjectScheme":"arXiv"},{"subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"}],"contributors":[],"dates":[{"date":"2026-08-04T11:51:23Z","dateType":"Submitted","dateInformation":"v1"},{"date":"2026-08-05T00:48:17Z","dateType":"Updated","dateInformation":"v1"},{"date":"2026-08-07T07:07:45Z","dateType":"Submitted","dateInformation":"v2"},{"date":"2026-08-10T00:28:35Z","dateType":"Updated","dateInformation":"v2"},{"date":"2026-08","dateType":"Available","dateInformation":"v1"}],"language":null,"types":{"schemaOrg":"CreativeWork","resourceTypeGeneral":"Preprint","citeproc":"article","bibtex":"misc","ris":"GEN","resourceType":"Article"},"relatedIdentifiers":[],"relatedItems":[],"sizes":[],"formats":[],"version":"2","rightsList":[{"rightsIdentifierScheme":"SPDX","rightsUri":"https://creativecommons.org/licenses/by/4.0/legalcode","schemeUri":"https://spdx.org/licenses/","rights":"Creative Commons Attribution 4.0 International","rightsIdentifier":"cc-by-4.0"}],"descriptions":[{"descriptionType":"Abstract","description":"Self-evolving agents increasingly convert interaction histories into reusable skills that persist beyond individual tasks. While prior work studies memory and retrieval poisoning, such attacks only affect agents when poisoned records are retrieved as context. We uncover a new and more fundamental risk: poisoned experiences can be transformed by the agent itself into durable behavioral artifacts. We present \\textbf{SkillJack}, the first attack that exploits the experience-to-skill pipeline of self-evolving agents. Instead of directly manipulating runtime context, SkillJack hijacks the agent's own learning process to implant malicious behaviors into its reusable skill repertoire. We identify three key properties of this transformation: \\emph{sanitization whitewashing}, where malicious intent is obscured during skill extraction; \\emph{cross-layer promotion}, where transient experiences become persistent capabilities; and \\emph{persistence isolation}, where the attack survives removal of its original source records. We evaluate SkillJack on two representative systems, SkillX and Anything2Skill, using a shared dataset of 150 trajectories across four policy-risk categories. Results show that skill extraction substantially reduces attack detectability: in SkillX, safety detection drops from 98.5\\% for poisoned trajectories to 11.4\\% for extracted skills, while Anything2Skill shows a similar effect. Meanwhile, the implanted skills remain effective, achieving attack success rates of 56.2\\% and 89.2\\% on the two systems, respectively. Furthermore, 80.0\\% of skill-mediated attacks persist after deleting the original poisoned records, and some skills unintentionally activate on benign queries. Our findings reveal skill evolution as a new attack surface and motivate provenance-aware skill lifecycle protection. Our code is available at https://github.com/Tencent/AI-Infra-Guard/research/skilljack."}],"geoLocations":[],"fundingReferences":[],"url":"https://arxiv.org/abs/2608.03509","contentUrl":null,"metadataVersion":1,"schemaVersion":"http://datacite.org/schema/kernel-4","source":"mds","isActive":true,"state":"findable","reason":null,"viewCount":0,"downloadCount":0,"referenceCount":0,"citationCount":0,"partCount":0,"partOfCount":0,"versionCount":0,"versionOfCount":0,"created":"2026-08-05T02:14:36Z","registered":"2026-08-05T02:14:37Z","published":null,"updated":"2026-08-10T02:12:16Z"},"relationships":{"client":{"data":{"id":"arxiv.content","type":"clients"}}}},{"id":"10.48550/arxiv.2608.03299","type":"dois","attributes":{"doi":"10.48550/arxiv.2608.03299","identifiers":[{"identifier":"2608.03299","identifierType":"arXiv"}],"creators":[{"nameType":"Personal","givenName":"Tomasz","familyName":"Brzeziński","name":"Brzeziński, Tomasz","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Teresa","familyName":"Conde","name":"Conde, Teresa","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Steffen","familyName":"Koenig","name":"Koenig, Steffen","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Julian","familyName":"Külshammer","name":"Külshammer, Julian","affiliation":[],"nameIdentifiers":[]}],"titles":[{"title":"Comparing self-dual corings, Frobenius corings and Ringel self-duality"}],"publisher":"arXiv","container":{},"publicationYear":2026,"subjects":[{"subject":"Representation Theory (math.RT)","lang":"en","subjectScheme":"arXiv"},{"subject":"Quantum Algebra (math.QA)","lang":"en","subjectScheme":"arXiv"},{"subject":"Rings and Algebras (math.RA)","lang":"en","subjectScheme":"arXiv"},{"subject":"FOS: Mathematics","subjectScheme":"Fields of Science and Technology (FOS)"},{"subject":"16D90, 16L60, 16T15, 17B10, 18G25","lang":"en","subjectScheme":"MSC"}],"contributors":[],"dates":[{"date":"2026-08-04T08:08:35Z","dateType":"Submitted","dateInformation":"v1"},{"date":"2026-08-10T00:34:48Z","dateType":"Updated","dateInformation":"v1"},{"date":"2026-08","dateType":"Available","dateInformation":"v1"}],"language":null,"types":{"schemaOrg":"CreativeWork","resourceTypeGeneral":"Preprint","citeproc":"article","bibtex":"misc","ris":"GEN","resourceType":"Article"},"relatedIdentifiers":[],"relatedItems":[],"sizes":[],"formats":[],"version":"1","rightsList":[{"rightsUri":"http://arxiv.org/licenses/nonexclusive-distrib/1.0/","rights":"arXiv.org perpetual, non-exclusive license"}],"descriptions":[{"descriptionType":"Abstract","description":"Self-dual corings and self-dual algebra extensions are classified and these (self-)dualities are compared with Ringel (self-)duality, revealing fundamental differences. To each coring $\\mathcal C$, two algebras are associated, known as the left and the right dual algebra of $\\mathcal C$. It is shown that these two algebras coincide in a natural way if and only if $\\mathcal C$ is a Frobenius coring. Various other equivalent characterisations of $\\mathcal C$ being self-dual are given, in terms of certain algebra extensions being Frobenius extensions and in terms of certain forgetful or restriction functors being Frobenius functors. Ringel self-duality however is shown to be rather different, for which a homological explanation is given."},{"descriptionType":"Other","description":"29 pages"}],"geoLocations":[],"fundingReferences":[],"url":"https://arxiv.org/abs/2608.03299","contentUrl":null,"metadataVersion":1,"schemaVersion":"http://datacite.org/schema/kernel-4","source":"mds","isActive":true,"state":"findable","reason":null,"viewCount":0,"downloadCount":0,"referenceCount":0,"citationCount":0,"partCount":0,"partOfCount":0,"versionCount":0,"versionOfCount":0,"created":"2026-08-05T02:09:39Z","registered":"2026-08-05T02:09:40Z","published":null,"updated":"2026-08-10T02:12:15Z"},"relationships":{"client":{"data":{"id":"arxiv.content","type":"clients"}}}},{"id":"10.48550/arxiv.2608.03243","type":"dois","attributes":{"doi":"10.48550/arxiv.2608.03243","identifiers":[{"identifier":"2608.03243","identifierType":"arXiv"}],"creators":[{"nameType":"Personal","givenName":"Halime Ömrüuzun","familyName":"Seyrek","name":"Seyrek, Halime Ömrüuzun","affiliation":[],"nameIdentifiers":[]}],"titles":[{"title":"On Partitions with Palindromic Gap Sequences"}],"publisher":"arXiv","container":{},"publicationYear":2026,"subjects":[{"subject":"Combinatorics (math.CO)","lang":"en","subjectScheme":"arXiv"},{"subject":"FOS: Mathematics","subjectScheme":"Fields of Science and Technology (FOS)"},{"subject":"05A17, 05A15, 11P84","lang":"en","subjectScheme":"MSC"}],"contributors":[],"dates":[{"date":"2026-08-04T07:14:06Z","dateType":"Submitted","dateInformation":"v1"},{"date":"2026-08-05T00:32:31Z","dateType":"Updated","dateInformation":"v1"},{"date":"2026-08-06T20:19:56Z","dateType":"Submitted","dateInformation":"v2"},{"date":"2026-08-10T00:07:08Z","dateType":"Updated","dateInformation":"v2"},{"date":"2026-08","dateType":"Available","dateInformation":"v1"}],"language":null,"types":{"schemaOrg":"CreativeWork","resourceTypeGeneral":"Preprint","citeproc":"article","bibtex":"misc","ris":"GEN","resourceType":"Article"},"relatedIdentifiers":[],"relatedItems":[],"sizes":[],"formats":[],"version":"2","rightsList":[{"rightsUri":"http://arxiv.org/licenses/nonexclusive-distrib/1.0/","rights":"arXiv.org perpetual, non-exclusive license"}],"descriptions":[{"descriptionType":"Abstract","description":"We introduce and study palindromic-gap partitions: partitions whose sequence of successive differences between consecutive parts is a palindrome. We derive the generating function for this family, treating partitions with an odd and an even number of parts separately, and obtain a bivariate refinement tracking the number of parts. Specializing further, we give explicit closed formulas for the number of palindromic-gap partitions of $n$ into exactly $r$ parts. We then construct explicit bijections between palindromic-gap partitions with $2m+1$, respectively $2m$, parts and ordinary partitions with at most $m+1$ parts, in which the weight of a palindromic-gap partition is encoded by the largest part, or the two largest parts, of its image; composing these yields an explicit bijection between the odd and even families themselves. Finally, we show that a partition is palindromic-gap if and only if its Ferrers diagram, drawn with left-justified rows, is self-complementary under a $180^\\circ$ rotation inside its own naturally associated rectangle, identifying palindromic-gap partitions with self-complementary partitions relative to this rectangle. This yields a partial answer to a question of Keith on the enumeration of complementable and self-complementary partitions: we give explicit generating functions for the self-complementary case and exhibit, at $n=15$, a partition that is complementable but not self-complementary, confirming that the two notions are genuinely distinct."},{"descriptionType":"Other","description":"20 pages"}],"geoLocations":[],"fundingReferences":[],"url":"https://arxiv.org/abs/2608.03243","contentUrl":null,"metadataVersion":1,"schemaVersion":"http://datacite.org/schema/kernel-4","source":"mds","isActive":true,"state":"findable","reason":null,"viewCount":0,"downloadCount":0,"referenceCount":0,"citationCount":0,"partCount":0,"partOfCount":0,"versionCount":0,"versionOfCount":0,"created":"2026-08-05T02:08:23Z","registered":"2026-08-05T02:08:23Z","published":null,"updated":"2026-08-10T02:12:13Z"},"relationships":{"client":{"data":{"id":"arxiv.content","type":"clients"}}}},{"id":"10.48550/arxiv.2608.03216","type":"dois","attributes":{"doi":"10.48550/arxiv.2608.03216","identifiers":[{"identifier":"2608.03216","identifierType":"arXiv"}],"creators":[{"nameType":"Personal","givenName":"Fang","familyName":"Li","name":"Li, Fang","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Yu","familyName":"He","name":"He, Yu","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Haoyang","familyName":"Tong","name":"Tong, Haoyang","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Lichen","familyName":"Ma","name":"Ma, Lichen","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Jingling","familyName":"Fu","name":"Fu, Jingling","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Wenxiao","familyName":"Fan","name":"Fan, Wenxiao","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Tongxuan","familyName":"Liu","name":"Liu, Tongxuan","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Luohang","familyName":"Liu","name":"Liu, Luohang","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Ke","familyName":"Zhang","name":"Zhang, Ke","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Junshi","familyName":"Huang","name":"Huang, Junshi","affiliation":[],"nameIdentifiers":[]}],"titles":[{"title":"iFAN: Inference-Aware Learning for Plain Mask Transformers"}],"publisher":"arXiv","container":{},"publicationYear":2026,"subjects":[{"subject":"Computer Vision and Pattern Recognition (cs.CV)","lang":"en","subjectScheme":"arXiv"},{"subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"}],"contributors":[],"dates":[{"date":"2026-08-04T06:51:06Z","dateType":"Submitted","dateInformation":"v1"},{"date":"2026-08-05T00:31:19Z","dateType":"Updated","dateInformation":"v1"},{"date":"2026-08-07T14:02:47Z","dateType":"Submitted","dateInformation":"v2"},{"date":"2026-08-10T00:47:04Z","dateType":"Updated","dateInformation":"v2"},{"date":"2026-08","dateType":"Available","dateInformation":"v1"}],"language":null,"types":{"schemaOrg":"CreativeWork","resourceTypeGeneral":"Preprint","citeproc":"article","bibtex":"misc","ris":"GEN","resourceType":"Article"},"relatedIdentifiers":[],"relatedItems":[],"sizes":[],"formats":[],"version":"2","rightsList":[{"rightsUri":"http://arxiv.org/licenses/nonexclusive-distrib/1.0/","rights":"arXiv.org perpetual, non-exclusive license"}],"descriptions":[{"descriptionType":"Abstract","description":"Query-based mask transformers assemble segmentation outputs through pixel-wise competition among query predictions of the final layer, yet this inference process is not explicitly optimized during training. We identify two key mismatches: the query with the highest probability-mask score does not necessarily produce the most accurate mask, and final-layer decoding may discard superior predictions from intermediate layers. To address these issues, we propose Inference-Aware Learning (iFAN), a general training framework for plain mask transformers. iFAN introduces Adjusted Probability-Mask Ranking (APMR), which aligns query competition with predicted mask quality and suppresses high-confidence but inaccurate competitors. We further employ Cross-Layer Self-Distillation (CLSD) to transfer stronger intermediate predictions to the final layer. The ranking and distillation objectives are training-only, while inference retains efficient final-layer decoding. Experiments on COCO, ADE20K, and Cityscapes demonstrate consistent improvements across panoptic, instance, and semantic segmentation, as well as across different architectures, backbone scales, and input resolutions. Overall, iFAN improves performance by an average of 1.20 PQ, 1.30 AP, and 0.63 mIoU, with negligible additional parameters, FLOPs and inference latency."},{"descriptionType":"Other","description":"Project Page https://neesky163.github.io/iFAN/"}],"geoLocations":[],"fundingReferences":[],"url":"https://arxiv.org/abs/2608.03216","contentUrl":null,"metadataVersion":1,"schemaVersion":"http://datacite.org/schema/kernel-4","source":"mds","isActive":true,"state":"findable","reason":null,"viewCount":0,"downloadCount":0,"referenceCount":0,"citationCount":0,"partCount":0,"partOfCount":0,"versionCount":0,"versionOfCount":0,"created":"2026-08-05T02:07:46Z","registered":"2026-08-05T02:07:47Z","published":null,"updated":"2026-08-10T02:12:13Z"},"relationships":{"client":{"data":{"id":"arxiv.content","type":"clients"}}}},{"id":"10.48550/arxiv.2608.03115","type":"dois","attributes":{"doi":"10.48550/arxiv.2608.03115","identifiers":[{"identifier":"2608.03115","identifierType":"arXiv"}],"creators":[{"nameType":"Personal","givenName":"Harald","familyName":"Garcke","name":"Garcke, Harald","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Jiashun","familyName":"Hu","name":"Hu, Jiashun","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Nuo","familyName":"Lei","name":"Lei, Nuo","affiliation":[],"nameIdentifiers":[]}],"titles":[{"title":"A structure--preserving ALE--BGN--MDR method for Navier--Stokes free boundary problems with moving contact lines and gravity"}],"publisher":"arXiv","container":{},"publicationYear":2026,"subjects":[{"subject":"Numerical Analysis (math.NA)","lang":"en","subjectScheme":"arXiv"},{"subject":"FOS: Mathematics","subjectScheme":"Fields of Science and Technology (FOS)"}],"contributors":[],"dates":[{"date":"2026-08-04T04:34:49Z","dateType":"Submitted","dateInformation":"v1"},{"date":"2026-08-05T00:25:19Z","dateType":"Updated","dateInformation":"v1"},{"date":"2026-08-07T05:48:11Z","dateType":"Submitted","dateInformation":"v2"},{"date":"2026-08-10T00:25:40Z","dateType":"Updated","dateInformation":"v2"},{"date":"2026-08","dateType":"Available","dateInformation":"v1"}],"language":null,"types":{"schemaOrg":"CreativeWork","resourceTypeGeneral":"Preprint","citeproc":"article","bibtex":"misc","ris":"GEN","resourceType":"Article"},"relatedIdentifiers":[],"relatedItems":[],"sizes":[],"formats":[],"version":"2","rightsList":[{"rightsIdentifierScheme":"SPDX","rightsUri":"https://creativecommons.org/licenses/by-nc-nd/4.0/legalcode","schemeUri":"https://spdx.org/licenses/","rights":"Creative Commons Attribution Non Commercial No Derivatives 4.0 International","rightsIdentifier":"cc-by-nc-nd-4.0"}],"descriptions":[{"descriptionType":"Abstract","description":"We propose a gravity-consistent arbitrary Lagrangian--Eulerian finite element method for incompressible Navier--Stokes free-boundary problems with moving contact lines. A direct body-force discretization of gravity may fail to ensure consistency between the discrete gravitational work and the variation of the gravitational potential energy on the evolving domain, resulting in an artificial consistency error and persistent spurious velocities near equilibrium. To remove this inconsistency, we reformulate the gravitational potential energy variation as a moving-boundary integral over intermediate ALE configurations and evaluate it exactly using Simpson's quadrature rule. This leads to a mildly nonlinear fully discrete scheme in which the gravitational contribution is exactly consistent with the discrete potential-energy variation. The proposed method preserves volume exactly, satisfies a discrete energy-dissipation law including gravitational potential energy, and under suitable assumptions, drives the discrete velocity to zero in the long-time regime, thereby excluding persistent gravity-induced spurious velocities. Together with the BGN treatment of the free surface and the MDR bulk mesh extension, the scheme maintains accurate interface tracking and good mesh quality near the moving contact line. Numerical experiments in two and three spatial dimensions confirm the theoretical properties."}],"geoLocations":[],"fundingReferences":[],"url":"https://arxiv.org/abs/2608.03115","contentUrl":null,"metadataVersion":1,"schemaVersion":"http://datacite.org/schema/kernel-4","source":"mds","isActive":true,"state":"findable","reason":null,"viewCount":0,"downloadCount":0,"referenceCount":0,"citationCount":0,"partCount":0,"partOfCount":0,"versionCount":0,"versionOfCount":0,"created":"2026-08-05T02:05:25Z","registered":"2026-08-05T02:05:26Z","published":null,"updated":"2026-08-10T02:12:12Z"},"relationships":{"client":{"data":{"id":"arxiv.content","type":"clients"}}}},{"id":"10.48550/arxiv.2608.02984","type":"dois","attributes":{"doi":"10.48550/arxiv.2608.02984","identifiers":[{"identifier":"2608.02984","identifierType":"arXiv"}],"creators":[{"nameType":"Personal","givenName":"Anson","familyName":"Kost","name":"Kost, Anson","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Lucas","familyName":"Johns","name":"Johns, Lucas","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Huaiyu","familyName":"Duan","name":"Duan, Huaiyu","affiliation":[],"nameIdentifiers":[]}],"titles":[{"title":"Neutrino flavor-wave transport: Numerical tests and theoretical challenges"}],"publisher":"arXiv","container":{},"publicationYear":2026,"subjects":[{"subject":"High Energy Physics - Phenomenology (hep-ph)","lang":"en","subjectScheme":"arXiv"},{"subject":"High Energy Astrophysical Phenomena (astro-ph.HE)","lang":"en","subjectScheme":"arXiv"},{"subject":"FOS: Physical sciences","subjectScheme":"Fields of Science and Technology (FOS)"}],"contributors":[],"dates":[{"date":"2026-08-04T00:43:57Z","dateType":"Submitted","dateInformation":"v1"},{"date":"2026-08-05T00:16:19Z","dateType":"Updated","dateInformation":"v1"},{"date":"2026-08-07T16:43:18Z","dateType":"Submitted","dateInformation":"v2"},{"date":"2026-08-10T00:55:12Z","dateType":"Updated","dateInformation":"v2"},{"date":"2026-08","dateType":"Available","dateInformation":"v1"}],"language":null,"types":{"schemaOrg":"CreativeWork","resourceTypeGeneral":"Preprint","citeproc":"article","bibtex":"misc","ris":"GEN","resourceType":"Article"},"relatedIdentifiers":[],"relatedItems":[],"sizes":[],"formats":[],"version":"2","rightsList":[{"rightsUri":"http://arxiv.org/licenses/nonexclusive-distrib/1.0/","rights":"arXiv.org perpetual, non-exclusive license"}],"descriptions":[{"descriptionType":"Abstract","description":"Neutrino quantum kinetics is computationally intractable in the neutrino-dense arenas of core-collapse supernovae and neutron star mergers. Flavor-wave (or flavomon) transport is an emerging approach to this problem in which small-scale flavor inhomogeneities are treated as quasiparticles with properties determined by the local mean background. We present the first numerical calculations of flavor-wave transport under slow driving. Our results show some quantitative successes but also underscore the theoretical challenges that need to be overcome. Two issues are particularly concerning. (1) Nonlinear wave-wave coupling may be important. (2) Degeneracies and small energy gaps are responsible for significant nonadiabatic transitions. Future work will need to address these points if flavor-wave transport is to be viable in settings of astrophysical interest. Other topics examined include flavor-wave parallel transport and flavor-space symmetry breaking."},{"descriptionType":"Other","description":"15 pages, 5 figures"}],"geoLocations":[],"fundingReferences":[],"url":"https://arxiv.org/abs/2608.02984","contentUrl":null,"metadataVersion":1,"schemaVersion":"http://datacite.org/schema/kernel-4","source":"mds","isActive":true,"state":"findable","reason":null,"viewCount":0,"downloadCount":0,"referenceCount":0,"citationCount":0,"partCount":0,"partOfCount":0,"versionCount":0,"versionOfCount":0,"created":"2026-08-05T02:02:27Z","registered":"2026-08-05T02:02:28Z","published":null,"updated":"2026-08-10T02:12:11Z"},"relationships":{"client":{"data":{"id":"arxiv.content","type":"clients"}}}},{"id":"10.48550/arxiv.2608.03020","type":"dois","attributes":{"doi":"10.48550/arxiv.2608.03020","identifiers":[{"identifier":"2608.03020","identifierType":"arXiv"}],"creators":[{"nameType":"Personal","givenName":"Linhan","familyName":"Xia","name":"Xia, Linhan","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Rui","familyName":"Liu","name":"Liu, Rui","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Zhaofeng","familyName":"Zhang","name":"Zhang, Zhaofeng","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Yihao","familyName":"Wang","name":"Wang, Yihao","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Binrui","familyName":"Shen","name":"Shen, Binrui","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Shengxin","familyName":"Zhu","name":"Zhu, Shengxin","affiliation":[],"nameIdentifiers":[]}],"titles":[{"title":"LoCA: Forward-Only LLM Tuning after One-Shot Calibration with Local Credit Assignment"}],"publisher":"arXiv","container":{},"publicationYear":2026,"subjects":[{"subject":"Artificial Intelligence (cs.AI)","lang":"en","subjectScheme":"arXiv"},{"subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"}],"contributors":[],"dates":[{"date":"2026-08-04T02:06:43Z","dateType":"Submitted","dateInformation":"v1"},{"date":"2026-08-05T00:18:25Z","dateType":"Updated","dateInformation":"v1"},{"date":"2026-08-07T02:11:01Z","dateType":"Submitted","dateInformation":"v2"},{"date":"2026-08-10T00:16:38Z","dateType":"Updated","dateInformation":"v2"},{"date":"2026-08","dateType":"Available","dateInformation":"v1"}],"language":null,"types":{"schemaOrg":"CreativeWork","resourceTypeGeneral":"Preprint","citeproc":"article","bibtex":"misc","ris":"GEN","resourceType":"Article"},"relatedIdentifiers":[],"relatedItems":[],"sizes":[],"formats":[],"version":"2","rightsList":[{"rightsIdentifierScheme":"SPDX","rightsUri":"https://creativecommons.org/licenses/by/4.0/legalcode","schemeUri":"https://spdx.org/licenses/","rights":"Creative Commons Attribution 4.0 International","rightsIdentifier":"cc-by-4.0"}],"descriptions":[{"descriptionType":"Abstract","description":"Parameter-efficient post-training reduces the number of trainable parameters, but still requires repeated end-to-end backpropagation through the frozen backbone. Every adaptation step therefore needs backward-capable hardware and must store or recompute activations. We ask whether this repeated backward chain can be replaced by a one-time calibration. We introduce Local Credit Assignment (LoCA), a two-stage method for small-shift adaptation. One probe backward pass fits a low-rank map at each transformer block from the final prediction error to a local hidden-state correction. LoCA then reuses these maps to form blockwise regression targets from forward activations and fits low-rank adapters with closed-form ridge solves. No further backbone backward pass is required. We evaluate LoCA on five discriminative benchmarks with Qwen2.5 models from 0.5B to 14B. In 16 of 25 reported task--scale comparisons, LoCA yields lower evaluation cross-entropy than the corresponding LoRA run. Its measured full-run GPU peak, including calibration, is 26--29\\% lower than LoRA's. After calibration, its CPU steady-state memory is 36--52\\% lower and its per-pass time is 43--48\\% lower. A shared scale-normalized candidate set is reused across all tested Qwen2.5 sizes and on SmolLM2-1.7B. LoCA thus amortizes global credit assignment into one calibration and enables later forward-only tuning when repeated backpropagation is impractical. The code associated with this paper is available \\href{https://github.com/Xia12121/LoCA}{here}."}],"geoLocations":[],"fundingReferences":[],"url":"https://arxiv.org/abs/2608.03020","contentUrl":null,"metadataVersion":1,"schemaVersion":"http://datacite.org/schema/kernel-4","source":"mds","isActive":true,"state":"findable","reason":null,"viewCount":0,"downloadCount":0,"referenceCount":0,"citationCount":0,"partCount":0,"partOfCount":0,"versionCount":0,"versionOfCount":0,"created":"2026-08-05T02:03:15Z","registered":"2026-08-05T02:03:16Z","published":null,"updated":"2026-08-10T02:12:11Z"},"relationships":{"client":{"data":{"id":"arxiv.content","type":"clients"}}}},{"id":"10.48550/arxiv.2608.02667","type":"dois","attributes":{"doi":"10.48550/arxiv.2608.02667","identifiers":[{"identifier":"2608.02667","identifierType":"arXiv"}],"creators":[{"nameType":"Personal","givenName":"Felix","familyName":"Huber","name":"Huber, Felix","affiliation":[],"nameIdentifiers":[]}],"titles":[{"title":"Large Sidon Subsets and Pair-Sum Multiplicities of Distinct Multinomial Coefficients"}],"publisher":"arXiv","container":{},"publicationYear":2026,"subjects":[{"subject":"Combinatorics (math.CO)","lang":"en","subjectScheme":"arXiv"},{"subject":"FOS: Mathematics","subjectScheme":"Fields of Science and Technology (FOS)"},{"subject":"11B13, 11B34, 05A10, 05A17","lang":"en","subjectScheme":"MSC"}],"contributors":[],"dates":[{"date":"2026-08-02T05:49:52Z","dateType":"Submitted","dateInformation":"v1"},{"date":"2026-08-05T00:01:22Z","dateType":"Updated","dateInformation":"v1"},{"date":"2026-08-06T19:39:37Z","dateType":"Submitted","dateInformation":"v2"},{"date":"2026-08-10T00:05:40Z","dateType":"Updated","dateInformation":"v2"},{"date":"2026-08","dateType":"Available","dateInformation":"v1"}],"language":null,"types":{"schemaOrg":"CreativeWork","resourceTypeGeneral":"Preprint","citeproc":"article","bibtex":"misc","ris":"GEN","resourceType":"Article"},"relatedIdentifiers":[],"relatedItems":[],"sizes":[],"formats":[],"version":"2","rightsList":[{"rightsUri":"http://arxiv.org/licenses/nonexclusive-distrib/1.0/","rights":"arXiv.org perpetual, non-exclusive license"}],"descriptions":[{"descriptionType":"Abstract","description":"For a positive integer $n$, let $\\mathcal{M}_n$ be the set of distinct multinomial coefficient values $n!/(p_1!\\cdots p_t!)$, where $(p_1,\\ldots,p_t)$ ranges over the integer partitions of $n$. We study two complementary aspects of the additive structure of $\\mathcal{M}_n$: the maximum cardinality $s(n)$ of a Sidon subset and the multiplicities of unordered pair sums in the full set. A product embedding, strongly Sidon subsets, and estimates for prime partitions give \\[ \\liminf_{n\\to\\infty}\\frac{\\log(s(n)/n)\\log\\log n}{\\sqrt{\\log n}}\\geq\\fracπ{\\sqrt{3}}. \\] Long arithmetic progressions and separated copies yield a complementary lower bound $2/(3\\sqrt{3})$ for the normalized Sidon defect. Writing $r_n(t)$ for the number of unordered representations $t=x+y$ with $x,y\\in\\mathcal{M}_n$, we study the collision excess $C(n)$, the number $D(n)$ of multiply represented sums, the maximum multiplicity $μ(n)$, and the cumulative profile $T(n,k)$. We prove \\[ \\liminf\\frac{C(n)}{n^2\\log n}\\geq\\frac18,\\qquad \\liminf\\frac{D(n)}{n^{3/2}\\sqrt{\\log n}}\\geq\\frac{4}{3\\sqrt{3}},\\qquad \\liminf\\frac{μ(n)}{\\sqrt{n\\log n}}\\geq\\frac12. \\] We also obtain a scaled lower envelope for the full profile, an additive-energy bound, stabilization with respect to the number of variables, and an explicit family of trinomial collisions. Exact Sidon values through $n=16$, the lower bound $s(17)\\geq89$, and pair-sum statistics through $n=20$ are reported with reproducible computational material."},{"descriptionType":"Other","description":"24 pages; ancillary computational material. Substantially expanded version incorporating results on pair-sum multiplicities, cumulative representation profiles, additive energy, variable-number stabilization, and trinomial collision families, following the recommendation of the arXiv moderators"}],"geoLocations":[],"fundingReferences":[],"url":"https://arxiv.org/abs/2608.02667","contentUrl":null,"metadataVersion":1,"schemaVersion":"http://datacite.org/schema/kernel-4","source":"mds","isActive":true,"state":"findable","reason":null,"viewCount":0,"downloadCount":0,"referenceCount":0,"citationCount":0,"partCount":0,"partOfCount":0,"versionCount":0,"versionOfCount":0,"created":"2026-08-05T01:55:06Z","registered":"2026-08-05T01:55:07Z","published":null,"updated":"2026-08-10T02:12:10Z"},"relationships":{"client":{"data":{"id":"arxiv.content","type":"clients"}}}},{"id":"10.48550/arxiv.2608.03964","type":"dois","attributes":{"doi":"10.48550/arxiv.2608.03964","identifiers":[{"identifier":"2608.03964","identifierType":"arXiv"}],"creators":[{"nameType":"Personal","givenName":"Peijun","familyName":"Yang","name":"Yang, Peijun","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Zhan","familyName":"Jin","name":"Jin, Zhan","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Xiaoyi","familyName":"Qin","name":"Qin, Xiaoyi","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Ruiyi","familyName":"Gan","name":"Gan, Ruiyi","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Hao","familyName":"Wang","name":"Wang, Hao","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Juan","familyName":"Liu","name":"Liu, Juan","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Ming","familyName":"Li","name":"Li, Ming","affiliation":[],"nameIdentifiers":[]}],"titles":[{"title":"Identity-Faithful Audio-Visual Target Speaker Extraction with REAL-2MIX and VOXBLINK2-AVSE"}],"publisher":"arXiv","container":{},"publicationYear":2026,"subjects":[{"subject":"Audio and Speech Processing (eess.AS)","lang":"en","subjectScheme":"arXiv"},{"subject":"FOS: Electrical engineering, electronic engineering, information engineering","subjectScheme":"Fields of Science and Technology (FOS)"}],"contributors":[],"dates":[{"date":"2026-08-04T17:28:41Z","dateType":"Submitted","dateInformation":"v1"},{"date":"2026-08-05T01:08:19Z","dateType":"Updated","dateInformation":"v1"},{"date":"2026-08-06T06:35:08Z","dateType":"Submitted","dateInformation":"v2"},{"date":"2026-08-07T00:28:27Z","dateType":"Updated","dateInformation":"v2"},{"date":"2026-08","dateType":"Available","dateInformation":"v1"}],"language":null,"types":{"schemaOrg":"CreativeWork","resourceTypeGeneral":"Preprint","citeproc":"article","bibtex":"misc","ris":"GEN","resourceType":"Article"},"relatedIdentifiers":[],"relatedItems":[],"sizes":[],"formats":[],"version":"2","rightsList":[{"rightsUri":"http://arxiv.org/licenses/nonexclusive-distrib/1.0/","rights":"arXiv.org perpetual, non-exclusive license"}],"descriptions":[{"descriptionType":"Abstract","description":"Audio-visual target speaker extraction should return the speaker indicated by the video, yet a separator can ignore the visual cue and repeatedly output the acoustically dominant voice. We introduce REAL-2MIX, a Mandarin AV-TSE benchmark of jointly recorded real two-speaker mixtures with synchronized multi-view video. Each scene also contains preceding A-only and B-only stages that provide in-scene speaker references. It contains 77 scenes and 7,598 clips (11.84 hours), including 6,042 dual-annotated mixtures. After processing there leave 6,038 evaluable mixtures and 12,076 target-speaker rows. We additionally curate VOXBLINK2-AVSE from VoxBlink2, comprising 250,828 synchronized audio--lip-ROI pairs from 28,421 identities and 766.17 hours of speech. Our extractor uses frozen, 1,280-dimensional projected AV-HuBERT features, target-conditioned training, and layer-wise feature modulation. We jointly evaluate content with Qwen3-ASR-1.7B CER and target identity with WeSpeaker ResNet34 plus Overlapped Speech Detection (OSD). On the complete manifest, the best archived checkpoint obtains 0.2261 CER, 82.22% strict output correctness, and 69.53% both-output strict success."}],"geoLocations":[],"fundingReferences":[],"url":"https://arxiv.org/abs/2608.03964","contentUrl":null,"metadataVersion":1,"schemaVersion":"http://datacite.org/schema/kernel-4","source":"mds","isActive":true,"state":"findable","reason":null,"viewCount":0,"downloadCount":0,"referenceCount":0,"citationCount":0,"partCount":0,"partOfCount":0,"versionCount":0,"versionOfCount":0,"created":"2026-08-05T02:25:02Z","registered":"2026-08-05T02:25:03Z","published":null,"updated":"2026-08-07T02:22:35Z"},"relationships":{"client":{"data":{"id":"arxiv.content","type":"clients"}}}},{"id":"10.48550/arxiv.2608.03855","type":"dois","attributes":{"doi":"10.48550/arxiv.2608.03855","identifiers":[{"identifier":"2608.03855","identifierType":"arXiv"}],"creators":[{"nameType":"Personal","givenName":"David Ming","familyName":"Segura","name":"Segura, David Ming","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Jeremy","familyName":"Goumaz","name":"Goumaz, Jeremy","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Joshua W.","familyName":"Sin","name":"Sin, Joshua W.","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Bojana","familyName":"Ranković","name":"Ranković, Bojana","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Philippe","familyName":"Schwaller","name":"Schwaller, Philippe","affiliation":[],"nameIdentifiers":[]}],"titles":[{"title":"Bi-semantic Chemical Embedder for Joint Representation Learning of SMILES and Natural Language"}],"publisher":"arXiv","container":{},"publicationYear":2026,"subjects":[{"subject":"Machine Learning (cs.LG)","lang":"en","subjectScheme":"arXiv"},{"subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"}],"contributors":[],"dates":[{"date":"2026-08-04T15:57:38Z","dateType":"Submitted","dateInformation":"v1"},{"date":"2026-08-05T01:02:49Z","dateType":"Updated","dateInformation":"v1"},{"date":"2026-08-06T12:23:11Z","dateType":"Submitted","dateInformation":"v2"},{"date":"2026-08-07T00:45:32Z","dateType":"Updated","dateInformation":"v2"},{"date":"2026-08","dateType":"Available","dateInformation":"v1"}],"language":null,"types":{"schemaOrg":"CreativeWork","resourceTypeGeneral":"Preprint","citeproc":"article","bibtex":"misc","ris":"GEN","resourceType":"Article"},"relatedIdentifiers":[],"relatedItems":[],"sizes":[],"formats":[],"version":"2","rightsList":[{"rightsIdentifierScheme":"SPDX","rightsUri":"https://creativecommons.org/licenses/by/4.0/legalcode","schemeUri":"https://spdx.org/licenses/","rights":"Creative Commons Attribution 4.0 International","rightsIdentifier":"cc-by-4.0"}],"descriptions":[{"descriptionType":"Abstract","description":"Transformer models have revolutionized natural language processing (NLP), and text-based molecular representations like SMILES have successfully extended these architectures to chemistry. However, domain-adaptive pre-training often causes models to overfit to chemical syntax, catastrophically forgetting their foundational semantic capabilities. To address this challenge, we introduce CheMatE, a chemistry-oriented embedding model that jointly captures molecular structure and domain-specific natural language within the same representation space. Built on a ModernBERT backbone, CheMatE learns bi-semantic representations through a two-stage training procedure: continued masked language modeling (MLM) followed by a Matryoshka contrastive learning stage via Multiple Negative Ranking Loss (MNRL). First, we train the model using MLM on a novel, large-scale corpus of SMILES-annotated, long-context scientific documents that were constructed and curated from FineWeb and ChemPile (comprising 10.4B and 11.5B tokens, respectively). Subsequently, the model undergoes contrastive learning using a synthetic dataset of SMILES-text pairs algorithmically derived from our original training corpus. This design exposes the model to SMILES-enriched scientific literature, enabling bi-semantic understanding. We evaluate CheMatE across a range of downstream tasks covering molecular property prediction and scientific language understanding. Our results demonstrate that coupling our custom-curated datasets with this sequential training strategy yields robust, highly transferable representations. By effectively unifying structural and contextual signals within a single text-based framework, CheMatE achieves competitive performance across both specialized chemistry models and general-purpose language model baselines."}],"geoLocations":[],"fundingReferences":[],"url":"https://arxiv.org/abs/2608.03855","contentUrl":null,"metadataVersion":1,"schemaVersion":"http://datacite.org/schema/kernel-4","source":"mds","isActive":true,"state":"findable","reason":null,"viewCount":0,"downloadCount":0,"referenceCount":0,"citationCount":0,"partCount":0,"partOfCount":0,"versionCount":0,"versionOfCount":0,"created":"2026-08-05T02:22:32Z","registered":"2026-08-05T02:22:33Z","published":null,"updated":"2026-08-07T02:22:35Z"},"relationships":{"client":{"data":{"id":"arxiv.content","type":"clients"}}}},{"id":"10.48550/arxiv.2608.03815","type":"dois","attributes":{"doi":"10.48550/arxiv.2608.03815","identifiers":[{"identifier":"2608.03815","identifierType":"arXiv"}],"creators":[{"nameType":"Personal","givenName":"Gao","familyName":"Chen","name":"Chen, Gao","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Sijie","familyName":"Nie","name":"Nie, Sijie","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Yulun","familyName":"Xu","name":"Xu, Yulun","affiliation":[],"nameIdentifiers":[]}],"titles":[{"title":"A numerical criterion for complex Hessian type equations on projective manifolds"}],"publisher":"arXiv","container":{},"publicationYear":2026,"subjects":[{"subject":"Differential Geometry (math.DG)","lang":"en","subjectScheme":"arXiv"},{"subject":"FOS: Mathematics","subjectScheme":"Fields of Science and Technology (FOS)"}],"contributors":[],"dates":[{"date":"2026-08-04T15:24:39Z","dateType":"Submitted","dateInformation":"v1"},{"date":"2026-08-05T01:01:29Z","dateType":"Updated","dateInformation":"v1"},{"date":"2026-08-06T14:35:14Z","dateType":"Submitted","dateInformation":"v2"},{"date":"2026-08-07T00:52:33Z","dateType":"Updated","dateInformation":"v2"},{"date":"2026-08","dateType":"Available","dateInformation":"v1"}],"language":null,"types":{"schemaOrg":"CreativeWork","resourceTypeGeneral":"Preprint","citeproc":"article","bibtex":"misc","ris":"GEN","resourceType":"Article"},"relatedIdentifiers":[],"relatedItems":[],"sizes":[],"formats":[],"version":"2","rightsList":[{"rightsUri":"http://arxiv.org/licenses/nonexclusive-distrib/1.0/","rights":"arXiv.org perpetual, non-exclusive license"}],"descriptions":[{"descriptionType":"Abstract","description":"We prove a Nakai-Moishezon-type criterion for complex Hessian-type equations on projective manifolds whose associated degree-$n$ polynomials are strongly strictly right-Noetherian. For strictly right-Noetherian polynomials of arbitrary degree, we prove a uniform Nakai-Moishezon-type criterion. This class includes the complex Hessian and Hessian quotient equations."},{"descriptionType":"Other","description":"This revision fixes the gap in the previous version that omega is not Kahler a prior"}],"geoLocations":[],"fundingReferences":[],"url":"https://arxiv.org/abs/2608.03815","contentUrl":null,"metadataVersion":1,"schemaVersion":"http://datacite.org/schema/kernel-4","source":"mds","isActive":true,"state":"findable","reason":null,"viewCount":0,"downloadCount":0,"referenceCount":0,"citationCount":0,"partCount":0,"partOfCount":0,"versionCount":0,"versionOfCount":0,"created":"2026-08-05T02:21:38Z","registered":"2026-08-05T02:21:38Z","published":null,"updated":"2026-08-07T02:22:33Z"},"relationships":{"client":{"data":{"id":"arxiv.content","type":"clients"}}}},{"id":"10.48550/arxiv.2608.03813","type":"dois","attributes":{"doi":"10.48550/arxiv.2608.03813","identifiers":[{"identifier":"2608.03813","identifierType":"arXiv"}],"creators":[{"nameType":"Personal","givenName":"Andreas","familyName":"Lorrain","name":"Lorrain, Andreas","affiliation":[],"nameIdentifiers":[]}],"titles":[{"title":"The Dehn function of Thompson's group $V$ is at most sextic"}],"publisher":"arXiv","container":{},"publicationYear":2026,"subjects":[{"subject":"Group Theory (math.GR)","lang":"en","subjectScheme":"arXiv"},{"subject":"FOS: Mathematics","subjectScheme":"Fields of Science and Technology (FOS)"},{"subject":"20F06, 20F10, 20F65","lang":"en","subjectScheme":"MSC"}],"contributors":[],"dates":[{"date":"2026-08-04T15:24:00Z","dateType":"Submitted","dateInformation":"v1"},{"date":"2026-08-05T01:01:25Z","dateType":"Updated","dateInformation":"v1"},{"date":"2026-08-05T18:53:22Z","dateType":"Submitted","dateInformation":"v2"},{"date":"2026-08-07T00:05:16Z","dateType":"Updated","dateInformation":"v2"},{"date":"2026-08","dateType":"Available","dateInformation":"v1"}],"language":null,"types":{"schemaOrg":"CreativeWork","resourceTypeGeneral":"Preprint","citeproc":"article","bibtex":"misc","ris":"GEN","resourceType":"Article"},"relatedIdentifiers":[],"relatedItems":[],"sizes":[],"formats":[],"version":"2","rightsList":[{"rightsUri":"http://arxiv.org/licenses/nonexclusive-distrib/1.0/","rights":"arXiv.org perpetual, non-exclusive license"}],"descriptions":[{"descriptionType":"Abstract","description":"A remarkable result of Guba shows that the Dehn function of Thompson's group $F$ is quadratic (Inv. Math. 163:313-342). In another paper (Alg. prob. in Grps. and Semigrps, 91-120), Guba showed that Thompson's group $T$ and $V$ have Dehn functions bounded above by $n^7$ and $n^{11}$, respectively. Recently, Migliorini showed that the Dehn function of Thompson's group $T$ is also quadratic (For. of Math. Sigma, 13:e109). In this paper, we improve the upper bound of the Dehn function of Thompson's group $V$ to $n^6$ and explore the intricacies of its relations via explicit van Kampen diagrams."},{"descriptionType":"Other","description":"70 pages, 66 figures, updated title"}],"geoLocations":[],"fundingReferences":[],"url":"https://arxiv.org/abs/2608.03813","contentUrl":null,"metadataVersion":1,"schemaVersion":"http://datacite.org/schema/kernel-4","source":"mds","isActive":true,"state":"findable","reason":null,"viewCount":0,"downloadCount":0,"referenceCount":0,"citationCount":0,"partCount":0,"partOfCount":0,"versionCount":0,"versionOfCount":0,"created":"2026-08-05T02:21:35Z","registered":"2026-08-05T02:21:36Z","published":null,"updated":"2026-08-07T02:22:33Z"},"relationships":{"client":{"data":{"id":"arxiv.content","type":"clients"}}}},{"id":"10.48550/arxiv.2608.03759","type":"dois","attributes":{"doi":"10.48550/arxiv.2608.03759","identifiers":[{"identifier":"2608.03759","identifierType":"arXiv"}],"creators":[{"nameType":"Personal","givenName":"Stefano","familyName":"Campanaro","name":"Campanaro, Stefano","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Luca","familyName":"Bursi","name":"Bursi, Luca","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Nicholas H.","familyName":"Anderson","name":"Anderson, Nicholas H.","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Stefano","familyName":"Curtarolo","name":"Curtarolo, Stefano","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Arrigo","familyName":"Calzolari","name":"Calzolari, Arrigo","affiliation":[],"nameIdentifiers":[]}],"titles":[{"title":"AFLOW-EMERALD: ElectroMagnetic modes EngineeRing in Advanced LayereD materials"}],"publisher":"arXiv","container":{},"publicationYear":2026,"subjects":[{"subject":"Optics (physics.optics)","lang":"en","subjectScheme":"arXiv"},{"subject":"Computational Physics (physics.comp-ph)","lang":"en","subjectScheme":"arXiv"},{"subject":"FOS: Physical sciences","subjectScheme":"Fields of Science and Technology (FOS)"}],"contributors":[],"dates":[{"date":"2026-08-04T14:47:47Z","dateType":"Submitted","dateInformation":"v1"},{"date":"2026-08-05T00:59:19Z","dateType":"Updated","dateInformation":"v1"},{"date":"2026-08-05T18:20:23Z","dateType":"Submitted","dateInformation":"v2"},{"date":"2026-08-07T00:03:51Z","dateType":"Updated","dateInformation":"v2"},{"date":"2026-08","dateType":"Available","dateInformation":"v1"}],"language":null,"types":{"schemaOrg":"CreativeWork","resourceTypeGeneral":"Preprint","citeproc":"article","bibtex":"misc","ris":"GEN","resourceType":"Article"},"relatedIdentifiers":[],"relatedItems":[],"sizes":[],"formats":[],"version":"2","rightsList":[{"rightsUri":"http://arxiv.org/licenses/nonexclusive-distrib/1.0/","rights":"arXiv.org perpetual, non-exclusive license"}],"descriptions":[{"descriptionType":"Abstract","description":"Layered and periodically patterned heterostructures underpin advanced optical, photonic, and plasmonic (meta)materials, whose rational design demands electromagnetic solvers that are both numerically robust and tightly linked to the underlying material properties. Here, we present AFLOW-EMERALD (ElectroMagnetic modes EngineeRing in Advanced LayereD materials), an open-source, modular, Python-based computational framework for simulating electromagnetic wave propagation in finite and periodic layered (meta)materials. Built around a unified object-oriented architecture, AFLOW-EMERALD combines a numerically stable scattering-matrix method with plane-wave expansion and extends to rigorous coupled-wave analysis for laterally patterned structures such as gratings. The software computes optical spectra, spatial field distributions, and photonic band structures, including complex-k dispersion in lossy, dispersive media. A streamlined YAML workflow allows users to seamlessly import dielectric function datasets from experimental, literature, or first-principles sources. Owing to its modular design, AFLOW-EMERALD is readily extensible and suitable for integration into computational materials-design pipelines, providing a practical platform for the coupled material-geometry engineering of dielectric photonic crystals, plasmonic multilayers, hyperbolic metamaterials, and more complex architectures supporting, e.g., surface and volume plasmon-polariton modes."},{"descriptionType":"Other","description":"16 pages, 7 figures"}],"geoLocations":[],"fundingReferences":[],"url":"https://arxiv.org/abs/2608.03759","contentUrl":null,"metadataVersion":1,"schemaVersion":"http://datacite.org/schema/kernel-4","source":"mds","isActive":true,"state":"findable","reason":null,"viewCount":0,"downloadCount":0,"referenceCount":0,"citationCount":0,"partCount":0,"partOfCount":0,"versionCount":0,"versionOfCount":0,"created":"2026-08-05T02:20:17Z","registered":"2026-08-05T02:20:18Z","published":null,"updated":"2026-08-07T02:22:32Z"},"relationships":{"client":{"data":{"id":"arxiv.content","type":"clients"}}}},{"id":"10.48550/arxiv.2608.03695","type":"dois","attributes":{"doi":"10.48550/arxiv.2608.03695","identifiers":[{"identifier":"2608.03695","identifierType":"arXiv"}],"creators":[{"nameType":"Personal","givenName":"Nelson Aloysio Reis de Almeida","familyName":"Passos","name":"Passos, Nelson Aloysio Reis de Almeida","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Emanuele","familyName":"Carlini","name":"Carlini, Emanuele","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Salvatore","familyName":"Trani","name":"Trani, Salvatore","affiliation":[],"nameIdentifiers":[]}],"titles":[{"title":"Accelerating Dynamic Graph Clustering on GPU Architectures with cuGraph"}],"publisher":"arXiv","container":{},"publicationYear":2026,"subjects":[{"subject":"Distributed, Parallel, and Cluster Computing (cs.DC)","lang":"en","subjectScheme":"arXiv"},{"subject":"Machine Learning (cs.LG)","lang":"en","subjectScheme":"arXiv"},{"subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"}],"contributors":[],"dates":[{"date":"2026-08-04T14:01:00Z","dateType":"Submitted","dateInformation":"v1"},{"date":"2026-08-05T00:56:33Z","dateType":"Updated","dateInformation":"v1"},{"date":"2026-08-06T17:06:20Z","dateType":"Submitted","dateInformation":"v2"},{"date":"2026-08-07T00:59:59Z","dateType":"Updated","dateInformation":"v2"},{"date":"2026-08","dateType":"Available","dateInformation":"v1"}],"language":null,"types":{"schemaOrg":"CreativeWork","resourceTypeGeneral":"Preprint","citeproc":"article","bibtex":"misc","ris":"GEN","resourceType":"Article"},"relatedIdentifiers":[],"relatedItems":[],"sizes":[],"formats":[],"version":"2","rightsList":[{"rightsIdentifierScheme":"SPDX","rightsUri":"https://creativecommons.org/licenses/by/4.0/legalcode","schemeUri":"https://spdx.org/licenses/","rights":"Creative Commons Attribution 4.0 International","rightsIdentifier":"cc-by-4.0"}],"descriptions":[{"descriptionType":"Abstract","description":"This work addresses community detection in temporal networks through GPU-accelerated extensions of spectral clustering and modularity-based algorithms originally designed for static graphs. Built on the NVIDIA RAPIDS ecosystem, the framework enables the characterization and tracking of communities in snapshot-based dynamic graphs, either by Leiden greedy optimization with multi-GPU support via Dask-based workload distribution, or eigendecomposition of a symmetric Bethe-Hessian operator. Our multislice modularity backend achieves up to roughly three orders of magnitude speedup over the CPU reference under an equal-work budget, depending on graph density and snapshot count, while preserving compatibility with existing graph analytics pipelines. We demonstrate its applicability on real-world and synthetic datasets, facilitating exploratory analysis of structural network properties over time. Such capabilities are relevant across several application domains, such as epidemic spreading, financial systems, cybersecurity, and trajectory and mobility analysis. We release our implementation as free and open-source software, including Python bindings through the NetworkX-Temporal library for ease of use and zero-code acceleration with existing codebases."},{"descriptionType":"Other","description":"12 pages, 2 figures. Accepted at FRAME 2026, Euro-Par 2026 Workshops; to appear in Springer LNCS"}],"geoLocations":[],"fundingReferences":[],"url":"https://arxiv.org/abs/2608.03695","contentUrl":null,"metadataVersion":1,"schemaVersion":"http://datacite.org/schema/kernel-4","source":"mds","isActive":true,"state":"findable","reason":null,"viewCount":0,"downloadCount":0,"referenceCount":0,"citationCount":0,"partCount":0,"partOfCount":0,"versionCount":0,"versionOfCount":0,"created":"2026-08-05T02:18:50Z","registered":"2026-08-05T02:18:51Z","published":null,"updated":"2026-08-07T02:22:30Z"},"relationships":{"client":{"data":{"id":"arxiv.content","type":"clients"}}}},{"id":"10.48550/arxiv.2608.03623","type":"dois","attributes":{"doi":"10.48550/arxiv.2608.03623","identifiers":[{"identifier":"2608.03623","identifierType":"arXiv"}],"creators":[{"nameType":"Personal","givenName":"Saba","familyName":"Tabatabaee","name":"Tabatabaee, Saba","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Jing","familyName":"Liu","name":"Liu, Jing","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Meghavarshini","familyName":"Krishnaswamy","name":"Krishnaswamy, Meghavarshini","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Carol","familyName":"Espy-Wilson","name":"Espy-Wilson, Carol","affiliation":[],"nameIdentifiers":[]}],"titles":[{"title":"Speaker Verification Under Real Classroom Conditions for English Speech"}],"publisher":"arXiv","container":{},"publicationYear":2026,"subjects":[{"subject":"Audio and Speech Processing (eess.AS)","lang":"en","subjectScheme":"arXiv"},{"subject":"FOS: Electrical engineering, electronic engineering, information engineering","subjectScheme":"Fields of Science and Technology (FOS)"}],"contributors":[],"dates":[{"date":"2026-08-04T13:12:41Z","dateType":"Submitted","dateInformation":"v1"},{"date":"2026-08-05T00:53:21Z","dateType":"Updated","dateInformation":"v1"},{"date":"2026-08-06T17:30:44Z","dateType":"Submitted","dateInformation":"v2"},{"date":"2026-08-07T01:01:20Z","dateType":"Updated","dateInformation":"v2"},{"date":"2026-08","dateType":"Available","dateInformation":"v1"}],"language":null,"types":{"schemaOrg":"CreativeWork","resourceTypeGeneral":"Preprint","citeproc":"article","bibtex":"misc","ris":"GEN","resourceType":"Article"},"relatedIdentifiers":[],"relatedItems":[],"sizes":[],"formats":[],"version":"2","rightsList":[{"rightsIdentifierScheme":"SPDX","rightsUri":"https://creativecommons.org/licenses/by/4.0/legalcode","schemeUri":"https://spdx.org/licenses/","rights":"Creative Commons Attribution 4.0 International","rightsIdentifier":"cc-by-4.0"}],"descriptions":[{"descriptionType":"Abstract","description":"Developing speaker verification (SV) models that are robust to classroom noise and effective across both children and adult speakers is critical for AI tools supporting educational environments. In this study, we use a real-world English-speaking classrooms dataset containing partial speaker identity annotations, with most recordings remaining unlabeled. We adapt the WavLM-TDNN model for classroom SV, achieving average relative reductions in Equal Error Rate (EER) of 23.99% and 6.32% compared to the ECAPA-TDNN baseline and the ECAPA-TDNN model trained on classroom data, respectively. Additionally, we investigate two training strategies for SV in classroom settings: self-supervised learning (SSL) and a two-stage approach that first pre-trains with SSL and then fine-tunes with limited annotated data. Five-fold cross-validation demonstrates that the two-stage strategy consistently outperforms the SSL-only approach, achieving an average relative EER reduction of 13.39%."}],"geoLocations":[],"fundingReferences":[],"url":"https://arxiv.org/abs/2608.03623","contentUrl":null,"metadataVersion":1,"schemaVersion":"http://datacite.org/schema/kernel-4","source":"mds","isActive":true,"state":"findable","reason":null,"viewCount":0,"downloadCount":0,"referenceCount":0,"citationCount":0,"partCount":0,"partOfCount":0,"versionCount":0,"versionOfCount":0,"created":"2026-08-05T02:17:12Z","registered":"2026-08-05T02:17:13Z","published":null,"updated":"2026-08-07T02:22:29Z"},"relationships":{"client":{"data":{"id":"arxiv.content","type":"clients"}}}},{"id":"10.48550/arxiv.2608.03571","type":"dois","attributes":{"doi":"10.48550/arxiv.2608.03571","identifiers":[{"identifier":"2608.03571","identifierType":"arXiv"}],"creators":[{"nameType":"Personal","givenName":"Kejian","familyName":"Zhu","name":"Zhu, Kejian","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Zhuoran","familyName":"Jin","name":"Jin, Zhuoran","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Dongqi","familyName":"Huang","name":"Huang, Dongqi","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Hongbang","familyName":"Yuan","name":"Yuan, Hongbang","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Yupu","familyName":"Hao","name":"Hao, Yupu","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Kang","familyName":"Liu","name":"Liu, Kang","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Jun","familyName":"Zhao","name":"Zhao, Jun","affiliation":[],"nameIdentifiers":[]}],"titles":[{"title":"Beyond Simply Environment Scaling: Designing Effective Environment Distributions for Multimodal Agent Learning"}],"publisher":"arXiv","container":{},"publicationYear":2026,"subjects":[{"subject":"Computer Vision and Pattern Recognition (cs.CV)","lang":"en","subjectScheme":"arXiv"},{"subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"}],"contributors":[],"dates":[{"date":"2026-08-04T12:32:18Z","dateType":"Submitted","dateInformation":"v1"},{"date":"2026-08-05T00:50:38Z","dateType":"Updated","dateInformation":"v1"},{"date":"2026-08-06T02:46:18Z","dateType":"Submitted","dateInformation":"v2"},{"date":"2026-08-07T00:19:49Z","dateType":"Updated","dateInformation":"v2"},{"date":"2026-08","dateType":"Available","dateInformation":"v1"}],"language":null,"types":{"schemaOrg":"CreativeWork","resourceTypeGeneral":"Preprint","citeproc":"article","bibtex":"misc","ris":"GEN","resourceType":"Article"},"relatedIdentifiers":[],"relatedItems":[],"sizes":[],"formats":[],"version":"2","rightsList":[{"rightsUri":"http://arxiv.org/licenses/nonexclusive-distrib/1.0/","rights":"arXiv.org perpetual, non-exclusive license"}],"descriptions":[{"descriptionType":"Abstract","description":"Recent works train agents by constructing large-scale multimodal environment pools. However, we find that simply increasing the number of multimodal environments does not always benefit. We further analyze the limitations in current multimodal environment distributions through a series of experiments. Based on these findings, we study how to build more effective training environment distributions from two dimensions: **diversity** and **difficulty structure**. For diversity, we propose **Ability-aware Environment Selection (AES)** to obtain diverse environment sets. For difficulty structure, we propose **Hierarchical Difficulty Curriculum (HDC)**, which organizes curriculum learning through two difficulty levels: harness weakening and state-scale progression. Experiments show that AES and HDC effectively improve multimodal agent training."},{"descriptionType":"Other","description":"Code: https://github.com/GaryStack/Beyond-MMEnv-Scaling"}],"geoLocations":[],"fundingReferences":[],"url":"https://arxiv.org/abs/2608.03571","contentUrl":null,"metadataVersion":1,"schemaVersion":"http://datacite.org/schema/kernel-4","source":"mds","isActive":true,"state":"findable","reason":null,"viewCount":0,"downloadCount":0,"referenceCount":0,"citationCount":0,"partCount":0,"partOfCount":0,"versionCount":0,"versionOfCount":0,"created":"2026-08-05T02:16:01Z","registered":"2026-08-05T02:16:02Z","published":null,"updated":"2026-08-07T02:22:28Z"},"relationships":{"client":{"data":{"id":"arxiv.content","type":"clients"}}}},{"id":"10.48550/arxiv.2608.03573","type":"dois","attributes":{"doi":"10.48550/arxiv.2608.03573","identifiers":[{"identifier":"2608.03573","identifierType":"arXiv"}],"creators":[{"nameType":"Personal","givenName":"Kejian","familyName":"Zhu","name":"Zhu, Kejian","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Zhuoran","familyName":"Jin","name":"Jin, Zhuoran","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Shangqing","familyName":"Tu","name":"Tu, Shangqing","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Hongbang","familyName":"Yuan","name":"Yuan, Hongbang","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Yushi","familyName":"Bai","name":"Bai, Yushi","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Kang","familyName":"Liu","name":"Liu, Kang","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Juanzi","familyName":"Li","name":"Li, Juanzi","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Jun","familyName":"Zhao","name":"Zhao, Jun","affiliation":[],"nameIdentifiers":[]}],"titles":[{"title":"SFT Conflicts, RL Coexists: A Theoretical and Empirical Analysis of Multi-Task Learning for LLMs"}],"publisher":"arXiv","container":{},"publicationYear":2026,"subjects":[{"subject":"Computation and Language (cs.CL)","lang":"en","subjectScheme":"arXiv"},{"subject":"Machine Learning (cs.LG)","lang":"en","subjectScheme":"arXiv"},{"subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"}],"contributors":[],"dates":[{"date":"2026-08-04T12:32:26Z","dateType":"Submitted","dateInformation":"v1"},{"date":"2026-08-05T00:50:46Z","dateType":"Updated","dateInformation":"v1"},{"date":"2026-08-06T02:48:24Z","dateType":"Submitted","dateInformation":"v2"},{"date":"2026-08-07T00:19:55Z","dateType":"Updated","dateInformation":"v2"},{"date":"2026-08","dateType":"Available","dateInformation":"v1"}],"language":null,"types":{"schemaOrg":"CreativeWork","resourceTypeGeneral":"Preprint","citeproc":"article","bibtex":"misc","ris":"GEN","resourceType":"Article"},"relatedIdentifiers":[],"relatedItems":[],"sizes":[],"formats":[],"version":"2","rightsList":[{"rightsUri":"http://arxiv.org/licenses/nonexclusive-distrib/1.0/","rights":"arXiv.org perpetual, non-exclusive license"}],"descriptions":[{"descriptionType":"Abstract","description":"Supervised Fine-Tuning (SFT) and Reinforcement Learning (RL) exhibit fundamentally different behaviors in enhancing multi-task reasoning for large language models (LLMs). Our preliminary experiments revealed a phenomenon: SFT suffers from severe task conflicts under multi-stage training, whereas RL enables stable coexistence across diverse tasks. Empirically, we trace this to the parameter level, observing that RL induces sparse and approximately orthogonal updates across tasks. We provide a theoretical explanation for this mechanism by analyzing multi-task gradient interference. Our results reveal a distinction: interference in SFT is norm-limited, scaling with the absolute gradient magnitude, whereas interference in RL is variance-limited, bounded by the gradient variance induced by advantage normalization and on-policy optimization. This small variance bound yields near-orthogonal optimization directions across tasks. Leveraging this insight, we propose Parallel-RL, a paradigm that decouples multi-task training, significantly improving efficiency and flexibility."},{"descriptionType":"Other","description":"Code: https://github.com/GaryStack/Parallel-RL"}],"geoLocations":[],"fundingReferences":[],"url":"https://arxiv.org/abs/2608.03573","contentUrl":null,"metadataVersion":1,"schemaVersion":"http://datacite.org/schema/kernel-4","source":"mds","isActive":true,"state":"findable","reason":null,"viewCount":0,"downloadCount":0,"referenceCount":0,"citationCount":0,"partCount":0,"partOfCount":0,"versionCount":0,"versionOfCount":0,"created":"2026-08-05T02:16:04Z","registered":"2026-08-05T02:16:05Z","published":null,"updated":"2026-08-07T02:22:28Z"},"relationships":{"client":{"data":{"id":"arxiv.content","type":"clients"}}}},{"id":"10.48550/arxiv.2608.03549","type":"dois","attributes":{"doi":"10.48550/arxiv.2608.03549","identifiers":[{"identifier":"2608.03549","identifierType":"arXiv"}],"creators":[{"nameType":"Personal","givenName":"Thomas","familyName":"Mieling","name":"Mieling, Thomas","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Andreas Wolfgang","familyName":"Schell","name":"Schell, Andreas Wolfgang","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"David Edward","familyName":"Bruschi","name":"Bruschi, David Edward","affiliation":[],"nameIdentifiers":[]}],"titles":[{"title":"Gravitational redshift as a quantum channel: modeling the effects of gravitational redshift in quantum optics"}],"publisher":"arXiv","container":{},"publicationYear":2026,"subjects":[{"subject":"Quantum Physics (quant-ph)","lang":"en","subjectScheme":"arXiv"},{"subject":"General Relativity and Quantum Cosmology (gr-qc)","lang":"en","subjectScheme":"arXiv"},{"subject":"FOS: Physical sciences","subjectScheme":"Fields of Science and Technology (FOS)"}],"contributors":[],"dates":[{"date":"2026-08-04T12:22:07Z","dateType":"Submitted","dateInformation":"v1"},{"date":"2026-08-05T00:49:51Z","dateType":"Updated","dateInformation":"v1"},{"date":"2026-08-06T08:23:46Z","dateType":"Submitted","dateInformation":"v2"},{"date":"2026-08-07T00:34:28Z","dateType":"Updated","dateInformation":"v2"},{"date":"2026-08","dateType":"Available","dateInformation":"v1"}],"language":null,"types":{"schemaOrg":"CreativeWork","resourceTypeGeneral":"Preprint","citeproc":"article","bibtex":"misc","ris":"GEN","resourceType":"Article"},"relatedIdentifiers":[],"relatedItems":[],"sizes":[],"formats":[],"version":"2","rightsList":[{"rightsIdentifierScheme":"SPDX","rightsUri":"https://creativecommons.org/licenses/by/4.0/legalcode","schemeUri":"https://spdx.org/licenses/","rights":"Creative Commons Attribution 4.0 International","rightsIdentifier":"cc-by-4.0"}],"descriptions":[{"descriptionType":"Abstract","description":"The gravitational frequency shift of light is well understood in the theory of classical electromagnetism. Nevertheless, its description in quantum theory is not yet fully developed. Recent work pointed out inconsistencies in previously developed models aimed at describing the gravitational redshift as an effective multi-mode mixer (MMM) acting on modes of light, but so far a complete solution of these issues was not obtained. Here, we identify the root cause of the MMM model's inconsistency and provide two complementary approaches to correct it: a \"natural\" one from a field-theoretic perspective, and another adapted to the language of quantum mechanics of finite-dimensional systems. We show that the second approach allows for modeling of the redshift in a multi-mode transmission setup as a quantum channel that can be characterized using standard quantum information-theoretic techniques when restricting the input states to Gaussian states of light."},{"descriptionType":"Other","description":"10 pages, 4 figures"}],"geoLocations":[],"fundingReferences":[],"url":"https://arxiv.org/abs/2608.03549","contentUrl":null,"metadataVersion":1,"schemaVersion":"http://datacite.org/schema/kernel-4","source":"mds","isActive":true,"state":"findable","reason":null,"viewCount":0,"downloadCount":0,"referenceCount":0,"citationCount":0,"partCount":0,"partOfCount":0,"versionCount":0,"versionOfCount":0,"created":"2026-08-05T02:15:31Z","registered":"2026-08-05T02:15:32Z","published":null,"updated":"2026-08-07T02:22:27Z"},"relationships":{"client":{"data":{"id":"arxiv.content","type":"clients"}}}},{"id":"10.48550/arxiv.2608.03497","type":"dois","attributes":{"doi":"10.48550/arxiv.2608.03497","identifiers":[{"identifier":"2608.03497","identifierType":"arXiv"}],"creators":[{"nameType":"Personal","givenName":"Hua","familyName":"Qiu","name":"Qiu, Hua","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Yifan","familyName":"Wang","name":"Wang, Yifan","affiliation":[],"nameIdentifiers":[]}],"titles":[{"title":"Connective Constants on Nested Fractal Graphs"}],"publisher":"arXiv","container":{},"publicationYear":2026,"subjects":[{"subject":"Probability (math.PR)","lang":"en","subjectScheme":"arXiv"},{"subject":"FOS: Mathematics","subjectScheme":"Fields of Science and Technology (FOS)"},{"subject":"82B41, 28A80","lang":"en","subjectScheme":"MSC"}],"contributors":[],"dates":[{"date":"2026-08-04T11:35:28Z","dateType":"Submitted","dateInformation":"v1"},{"date":"2026-08-05T00:47:39Z","dateType":"Updated","dateInformation":"v1"},{"date":"2026-08-06T09:51:58Z","dateType":"Submitted","dateInformation":"v2"},{"date":"2026-08-07T00:39:14Z","dateType":"Updated","dateInformation":"v2"},{"date":"2026-08","dateType":"Available","dateInformation":"v1"}],"language":null,"types":{"schemaOrg":"CreativeWork","resourceTypeGeneral":"Preprint","citeproc":"article","bibtex":"misc","ris":"GEN","resourceType":"Article"},"relatedIdentifiers":[],"relatedItems":[],"sizes":[],"formats":[],"version":"2","rightsList":[{"rightsUri":"http://arxiv.org/licenses/nonexclusive-distrib/1.0/","rights":"arXiv.org perpetual, non-exclusive license"}],"descriptions":[{"descriptionType":"Abstract","description":"We study self-avoiding walks on the canonical one-sided graphs of Lindstrom nested fractals. We prove that the connective constant $μ$ exists and identify $\\logμ$ with the critical inverse temperature of a finite-dimensional boundary-state renormalization. If the boundary-state partition vectors are bounded at criticality, then the fixed-length counts $c_n$ satisfy two-sided polynomial bounds around $μ^n$. We also prove that $h$-flexibility implies $c_{n+h}/c_n\\toμ^h$. For regular polygonal $N$-gaskets, we derive exact crossing recursions, determine the smallest flexibility step $h$, and obtain explicit algebraic connective constants for the $6$- and $9$-gaskets. The Vicsek graph has no flexibility step, and its successive ratios do not converge."},{"descriptionType":"Other","description":"50 pages, 8 figures"}],"geoLocations":[],"fundingReferences":[],"url":"https://arxiv.org/abs/2608.03497","contentUrl":null,"metadataVersion":1,"schemaVersion":"http://datacite.org/schema/kernel-4","source":"mds","isActive":true,"state":"findable","reason":null,"viewCount":0,"downloadCount":0,"referenceCount":0,"citationCount":0,"partCount":0,"partOfCount":0,"versionCount":0,"versionOfCount":0,"created":"2026-08-05T02:14:20Z","registered":"2026-08-05T02:14:20Z","published":null,"updated":"2026-08-07T02:22:26Z"},"relationships":{"client":{"data":{"id":"arxiv.content","type":"clients"}}}},{"id":"10.48550/arxiv.2608.03373","type":"dois","attributes":{"doi":"10.48550/arxiv.2608.03373","identifiers":[{"identifier":"2608.03373","identifierType":"arXiv"}],"creators":[{"nameType":"Personal","givenName":"Léo","familyName":"Mandô","name":"Mandô, Léo","affiliation":[],"nameIdentifiers":[]}],"titles":[{"title":"Solvability of the Poisson-Dirichlet problem in domains with boundaries of mixed dimension"}],"publisher":"arXiv","container":{},"publicationYear":2026,"subjects":[{"subject":"Analysis of PDEs (math.AP)","lang":"en","subjectScheme":"arXiv"},{"subject":"FOS: Mathematics","subjectScheme":"Fields of Science and Technology (FOS)"}],"contributors":[],"dates":[{"date":"2026-08-04T09:20:54Z","dateType":"Submitted","dateInformation":"v1"},{"date":"2026-08-05T00:40:52Z","dateType":"Updated","dateInformation":"v1"},{"date":"2026-08-06T11:58:44Z","dateType":"Submitted","dateInformation":"v2"},{"date":"2026-08-07T00:44:23Z","dateType":"Updated","dateInformation":"v2"},{"date":"2026-08","dateType":"Available","dateInformation":"v1"}],"language":null,"types":{"schemaOrg":"CreativeWork","resourceTypeGeneral":"Preprint","citeproc":"article","bibtex":"misc","ris":"GEN","resourceType":"Article"},"relatedIdentifiers":[],"relatedItems":[],"sizes":[],"formats":[],"version":"2","rightsList":[{"rightsUri":"http://arxiv.org/licenses/nonexclusive-distrib/1.0/","rights":"arXiv.org perpetual, non-exclusive license"}],"descriptions":[{"descriptionType":"Abstract","description":"We extend several characterizations of the $L^p$-solvability of the homogeneous Dirichlet problem to (possibly degenerate) elliptic operators $L=-\\textrm{div}(wA\\nabla)$ defined on a large class of open sets $Ω$ in $\\mathbb{R}^n$. This framework encompasses not only uniformly elliptic operators in Lipschitz domains, but also Caffarelli-Sylvestre-type operators, and boundaries $\\partialΩ$ that are not $(n-1)$-dimensional, for instance. We prove that, for $p\\in (1,\\infty)$, the $L^p$-solvability of the homogeneous Dirichlet problem is equivalent to the solvability of the Poisson-Dirichlet problem $Lu=wf-\\textrm{div}(wF)$, \\emph{i.e.} to the existence of a solution $u$ satisfying a $L^p$ non-tangential estimate whenever $f$ and $F$ belong to suitable weighted $L^p$ tent spaces. Furthermore, it is also equivalent to the solvability of the Poisson-Regularity problem for data in appropriate weighted $L^{p'}$ tent spaces, where estimates are obtained for $\\nabla u$ rather than $u$."}],"geoLocations":[],"fundingReferences":[],"url":"https://arxiv.org/abs/2608.03373","contentUrl":null,"metadataVersion":1,"schemaVersion":"http://datacite.org/schema/kernel-4","source":"mds","isActive":true,"state":"findable","reason":null,"viewCount":0,"downloadCount":0,"referenceCount":0,"citationCount":0,"partCount":0,"partOfCount":0,"versionCount":0,"versionOfCount":0,"created":"2026-08-05T02:11:22Z","registered":"2026-08-05T02:11:23Z","published":null,"updated":"2026-08-07T02:22:25Z"},"relationships":{"client":{"data":{"id":"arxiv.content","type":"clients"}}}},{"id":"10.48550/arxiv.2608.03327","type":"dois","attributes":{"doi":"10.48550/arxiv.2608.03327","identifiers":[{"identifier":"2608.03327","identifierType":"arXiv"}],"creators":[{"nameType":"Personal","givenName":"Siqi","familyName":"Fan","name":"Fan, Siqi","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Minghao","familyName":"Li","name":"Li, Minghao","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Xiaoqian","familyName":"Ma","name":"Ma, Xiaoqian","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Wenhui","familyName":"Tan","name":"Tan, Wenhui","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Xiusheng","familyName":"Huang","name":"Huang, Xiusheng","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Juntong","familyName":"Wu","name":"Wu, Juntong","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Liujie","familyName":"Zhang","name":"Zhang, Liujie","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Shuo","familyName":"Shang","name":"Shang, Shuo","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Weihang","familyName":"Chen","name":"Chen, Weihang","affiliation":[],"nameIdentifiers":[]}],"titles":[{"title":"Screenshots or Tools? Eliciting Tool Use and Managing Multimodal Context in Hybrid GUI-MCP Computer-Use Agents"}],"publisher":"arXiv","container":{},"publicationYear":2026,"subjects":[{"subject":"Artificial Intelligence (cs.AI)","lang":"en","subjectScheme":"arXiv"},{"subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"}],"contributors":[],"dates":[{"date":"2026-08-04T08:35:51Z","dateType":"Submitted","dateInformation":"v1"},{"date":"2026-08-05T00:37:58Z","dateType":"Updated","dateInformation":"v1"},{"date":"2026-08-06T07:26:24Z","dateType":"Submitted","dateInformation":"v2"},{"date":"2026-08-07T00:31:34Z","dateType":"Updated","dateInformation":"v2"},{"date":"2026-08","dateType":"Available","dateInformation":"v1"}],"language":null,"types":{"schemaOrg":"CreativeWork","resourceTypeGeneral":"Preprint","citeproc":"article","bibtex":"misc","ris":"GEN","resourceType":"Article"},"relatedIdentifiers":[],"relatedItems":[],"sizes":[],"formats":[],"version":"2","rightsList":[{"rightsUri":"http://arxiv.org/licenses/nonexclusive-distrib/1.0/","rights":"arXiv.org perpetual, non-exclusive license"}],"descriptions":[{"descriptionType":"Abstract","description":"Hybrid computer-use agents can act through screenshots or call text tools. We find that having a tool available does not settle which way the effect goes. Under one identical GUI-MCP harness on the OSWorld-MCP benchmark (309 tasks), the same MCP tools improve a reasoning model by +4.0pp and degrade a non-reasoning model by -5.9pp (5 runs each, both beyond 2 SE). What separates the two is tool-decision behavior. The non-reasoning policy ignores, misnames, or falsely terminates around tools. The reasoning model avoids these failures, yet still calls a tool on only 55/309 tasks, 23.9% of the tool-reachable ones. We call this shortfall the adoption gap. Both levels of the problem share one cause: the model already has a cheaper route and is never trained to take it. Multi-turn RL probes that cause. At the action level, a dense tool bonus raises spreadsheet adoption 0.03 -\u0026gt; 0.33 and carries into greedy decoding, but held-out accuracy does not follow. Behavior is steerable; competence is not. The bottleneck lies in tool-call semantics. At the context level, a successful tool call often makes the next screenshot redundant. Dropping it and halving image history cuts input tokens by about a third, at a small accuracy cost. Retraining under the same observation rule removes that cost. The compressed agent then reaches 37.8% against 33.0% for the uncompressed operating point, at 53% of the input cost, and closes the rich-lean gap on a pre-registered degraded subset to zero. Tools help when the model chooses and integrates them, and current hybrid agents leave many such choices unused. Code and checkpoints: https://github.com/redai-infra/hybrid-routing-agent"}],"geoLocations":[],"fundingReferences":[],"url":"https://arxiv.org/abs/2608.03327","contentUrl":null,"metadataVersion":1,"schemaVersion":"http://datacite.org/schema/kernel-4","source":"mds","isActive":true,"state":"findable","reason":null,"viewCount":0,"downloadCount":0,"referenceCount":0,"citationCount":0,"partCount":0,"partOfCount":0,"versionCount":0,"versionOfCount":0,"created":"2026-08-05T02:10:19Z","registered":"2026-08-05T02:10:20Z","published":null,"updated":"2026-08-07T02:22:24Z"},"relationships":{"client":{"data":{"id":"arxiv.content","type":"clients"}}}},{"id":"10.48550/arxiv.2608.03228","type":"dois","attributes":{"doi":"10.48550/arxiv.2608.03228","identifiers":[{"identifier":"2608.03228","identifierType":"arXiv"}],"creators":[{"nameType":"Personal","givenName":"Lin","familyName":"Zhang","name":"Zhang, Lin","affiliation":[],"nameIdentifiers":[]}],"titles":[{"title":"SAKI: Score-Aware Low-Rank Key Indexing with Random-Matrix Noise Correction for KV Retrieval"}],"publisher":"arXiv","container":{},"publicationYear":2026,"subjects":[{"subject":"Machine Learning (cs.LG)","lang":"en","subjectScheme":"arXiv"},{"subject":"Applications (stat.AP)","lang":"en","subjectScheme":"arXiv"},{"subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"}],"contributors":[],"dates":[{"date":"2026-08-04T06:59:29Z","dateType":"Submitted","dateInformation":"v1"},{"date":"2026-08-05T00:31:45Z","dateType":"Updated","dateInformation":"v1"},{"date":"2026-08-05T20:50:42Z","dateType":"Submitted","dateInformation":"v2"},{"date":"2026-08-07T00:09:17Z","dateType":"Updated","dateInformation":"v2"},{"date":"2026-08","dateType":"Available","dateInformation":"v1"}],"language":null,"types":{"schemaOrg":"CreativeWork","resourceTypeGeneral":"Preprint","citeproc":"article","bibtex":"misc","ris":"GEN","resourceType":"Article"},"relatedIdentifiers":[],"relatedItems":[],"sizes":[],"formats":[],"version":"2","rightsList":[{"rightsIdentifierScheme":"SPDX","rightsUri":"https://creativecommons.org/licenses/by/4.0/legalcode","schemeUri":"https://spdx.org/licenses/","rights":"Creative Commons Attribution 4.0 International","rightsIdentifier":"cc-by-4.0"}],"descriptions":[{"descriptionType":"Abstract","description":"Existing low rank KV cache methods preserve either model weights or key variance, neither of which directly reflects the attention scores used during inference. We derive the expected attention score distortion caused by rank r key compression and show that it yields a covariance weighted low rank objective. Under a margin condition, controlling this distortion also improves top k recall. The optimal rank r solution has a closed form asymmetric factorization obtained from the SVD of the covariance weighted query key operator. This motivates SAKI, a training free KV cache index that directly preserves attention scores rather than key reconstruction quality.\n Across LLaMA 3.1 8B, Qwen 2.5 7B, Mistral 7B v0.1, and Llama 3.2 3B, SAKI outperforms key PCA at every tested rank. At rank 32, it removes 13 to 30 percent of PCA's remaining top 64 recall error, including improvements from 0.748 to 0.799 on LLaMA 3.1 8B and from 0.786 to 0.850 on Qwen 2.5 7B. It improves 68 to 89 percent of attention heads per model, with the largest gains in deeper layers. Predicted score MSE reductions closely match empirical measurements, with a Pearson correlation of 0.997, while ablation studies confirm that the gains arise from optimizing the attention score objective rather than covariance weighting alone. Analysis of the scoring operator further explains why weight only, invariant subspace, and key reconstruction methods can be suboptimal. SAKI uses random-matrix theory to separate genuine covariance signal from autocorrelated sampling noise, matching PCA with only 512 calibration tokens and adding value exactly where PCA sees no reliable signal."},{"descriptionType":"Other","description":"10 pages, 4 figures 3 tables"}],"geoLocations":[],"fundingReferences":[],"url":"https://arxiv.org/abs/2608.03228","contentUrl":null,"metadataVersion":1,"schemaVersion":"http://datacite.org/schema/kernel-4","source":"mds","isActive":true,"state":"findable","reason":null,"viewCount":0,"downloadCount":0,"referenceCount":0,"citationCount":0,"partCount":0,"partOfCount":0,"versionCount":0,"versionOfCount":0,"created":"2026-08-05T02:08:02Z","registered":"2026-08-05T02:08:03Z","published":null,"updated":"2026-08-07T02:22:23Z"},"relationships":{"client":{"data":{"id":"arxiv.content","type":"clients"}}}},{"id":"10.48550/arxiv.2608.03274","type":"dois","attributes":{"doi":"10.48550/arxiv.2608.03274","identifiers":[{"identifier":"2608.03274","identifierType":"arXiv"}],"creators":[{"nameType":"Personal","givenName":"Raja O. P.","familyName":"Damanik","name":"Damanik, Raja O. P.","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Alwen","familyName":"Tiu","name":"Tiu, Alwen","affiliation":[],"nameIdentifiers":[]}],"titles":[{"title":"Right Divisibility in Erasing Semi-Thue Systems: A Minimal View of Intruder Deduction"}],"publisher":"arXiv","container":{},"publicationYear":2026,"subjects":[{"subject":"Logic in Computer Science (cs.LO)","lang":"en","subjectScheme":"arXiv"},{"subject":"Cryptography and Security (cs.CR)","lang":"en","subjectScheme":"arXiv"},{"subject":"Formal Languages and Automata Theory (cs.FL)","lang":"en","subjectScheme":"arXiv"},{"subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"},{"subject":"F.0; F.1.1; F.3.1; F.4.2; D.2.4","lang":"en","subjectScheme":"ACM"},{"subject":"68Q42 (Primary) 68Q60, 68M25 (Secondary)","lang":"en","subjectScheme":"MSC"}],"contributors":[],"dates":[{"date":"2026-08-04T07:51:03Z","dateType":"Submitted","dateInformation":"v1"},{"date":"2026-08-05T00:34:47Z","dateType":"Updated","dateInformation":"v1"},{"date":"2026-08-06T03:49:39Z","dateType":"Submitted","dateInformation":"v2"},{"date":"2026-08-07T00:22:33Z","dateType":"Updated","dateInformation":"v2"},{"date":"2026-08","dateType":"Available","dateInformation":"v1"}],"language":null,"types":{"schemaOrg":"CreativeWork","resourceTypeGeneral":"Preprint","citeproc":"article","bibtex":"misc","ris":"GEN","resourceType":"Article"},"relatedIdentifiers":[],"relatedItems":[],"sizes":[],"formats":[],"version":"2","rightsList":[{"rightsIdentifierScheme":"SPDX","rightsUri":"https://creativecommons.org/licenses/by/4.0/legalcode","schemeUri":"https://spdx.org/licenses/","rights":"Creative Commons Attribution 4.0 International","rightsIdentifier":"cc-by-4.0"}],"descriptions":[{"descriptionType":"Abstract","description":"The intruder deduction problem is central to symbolic security-protocol analysis: it asks whether an attacker can derive a target message from observed messages using (cryptographic) operators available to the attacker. Although convergent rewrite systems provide canonical normal forms, deduction modulo convergent theories remains undecidable in general, and existing decidable fragments are often shaped by practical cryptographic examples. In this paper, we study deduction from a minimal structural perspective. When all function symbols are unary, terms collapse to words and deduction becomes a right-divisibility problem for semi-Thue systems: given words $u$ and $v$ decide whether there exists $w$ such that $wu \\equiv_S v$. We investigate this problem for several classes of semi-Thue systems and prove, to the best of our knowledge, new decidability results for convergent prefix-erasing and convergent suffix-erasing systems. We then extend this perspective to term rewriting systems whose rules erase contexts while lifting selected subterms or variables. Although these classes suggest possible decidable generalisations beyond the unary setting, we show that deduction is already undecidable for a convergent simultaneous variable-lifting system. This exposes both the potential and the limits of extending the right-divisibility results to richer equational theories."},{"descriptionType":"Other","description":"26 pages, 1 figure (Tikz generated), submitted to CSL 2027. Corrected author name; no changes to the content"}],"geoLocations":[],"fundingReferences":[],"url":"https://arxiv.org/abs/2608.03274","contentUrl":null,"metadataVersion":1,"schemaVersion":"http://datacite.org/schema/kernel-4","source":"mds","isActive":true,"state":"findable","reason":null,"viewCount":0,"downloadCount":0,"referenceCount":0,"citationCount":0,"partCount":0,"partOfCount":0,"versionCount":0,"versionOfCount":0,"created":"2026-08-05T02:09:05Z","registered":"2026-08-05T02:09:06Z","published":null,"updated":"2026-08-07T02:22:23Z"},"relationships":{"client":{"data":{"id":"arxiv.content","type":"clients"}}}},{"id":"10.48550/arxiv.2608.03105","type":"dois","attributes":{"doi":"10.48550/arxiv.2608.03105","identifiers":[{"identifier":"2608.03105","identifierType":"arXiv"}],"creators":[{"nameType":"Personal","givenName":"Chandrakant K.","familyName":"Bhogayata","name":"Bhogayata, Chandrakant K.","affiliation":[],"nameIdentifiers":[]}],"titles":[{"title":"HomoEnsNER: Does Language Alignment Outperform Architectural Complexity in Gujarati Named Entity Recognition?"}],"publisher":"arXiv","container":{},"publicationYear":2026,"subjects":[{"subject":"Computation and Language (cs.CL)","lang":"en","subjectScheme":"arXiv"},{"subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"},{"subject":"I.2.7; H.3.1","lang":"en","subjectScheme":"ACM"}],"contributors":[],"dates":[{"date":"2026-08-04T04:21:35Z","dateType":"Submitted","dateInformation":"v1"},{"date":"2026-08-05T00:24:55Z","dateType":"Updated","dateInformation":"v1"},{"date":"2026-08-05T07:03:22Z","dateType":"Submitted","dateInformation":"v2"},{"date":"2026-08-06T00:29:19Z","dateType":"Updated","dateInformation":"v2"},{"date":"2026-08-06T11:51:20Z","dateType":"Submitted","dateInformation":"v3"},{"date":"2026-08-07T00:44:05Z","dateType":"Updated","dateInformation":"v3"},{"date":"2026-08","dateType":"Available","dateInformation":"v1"}],"language":null,"types":{"schemaOrg":"CreativeWork","resourceTypeGeneral":"Preprint","citeproc":"article","bibtex":"misc","ris":"GEN","resourceType":"Article"},"relatedIdentifiers":[],"relatedItems":[],"sizes":[],"formats":[],"version":"3","rightsList":[{"rightsIdentifierScheme":"SPDX","rightsUri":"https://creativecommons.org/licenses/by/4.0/legalcode","schemeUri":"https://spdx.org/licenses/","rights":"Creative Commons Attribution 4.0 International","rightsIdentifier":"cc-by-4.0"}],"descriptions":[{"descriptionType":"Abstract","description":"Named Entity Recognition (NER) for Gujarati remains underexplored, hindered by the absence of capitalization cues, rich morphology, lexical ambiguity, and free word order. Prior ensemble work has emphasized architectural diversity by combining heterogeneous classifiers, multilingual encoders, or classical sequence models, rather than exploiting language-aligned monolingual pretraining. This study asks whether, for a low-resource, morphologically rich language like Gujarati, a homogeneous ensemble of a single monolingual encoder outperforms such architectural diversity. We propose HomoEnsNER, a homogeneous ensemble of five independently fine-tuned GujaratiBERT models combined via majority voting, evaluated against a single GujaratiBERT baseline and six heterogeneous alternatives, including combinations with MuRIL-base, MuRIL-large, IndicBERT, mBERT, BiLSTM, CRF, and a stacked BiLSTM-CRF-GujaratiBERT architecture. All eight models were trained under a consistent budget and evaluated using entity-level F1 on the Naamapadam Gujarati test split. HomoEnsNER achieved the highest F1 (0.8442), surpassing the baseline (0.8347) and every heterogeneous alternative (lowest: 0.7855), indicating that language alignment is a more effective, budget-conscious ensembling strategy than architectural complexity for low-resource Indian language NER."},{"descriptionType":"Other","description":"20 pages"}],"geoLocations":[],"fundingReferences":[],"url":"https://arxiv.org/abs/2608.03105","contentUrl":null,"metadataVersion":2,"schemaVersion":"http://datacite.org/schema/kernel-4","source":"mds","isActive":true,"state":"findable","reason":null,"viewCount":0,"downloadCount":0,"referenceCount":0,"citationCount":0,"partCount":0,"partOfCount":0,"versionCount":0,"versionOfCount":0,"created":"2026-08-05T02:05:11Z","registered":"2026-08-05T02:05:12Z","published":null,"updated":"2026-08-07T02:22:21Z"},"relationships":{"client":{"data":{"id":"arxiv.content","type":"clients"}}}},{"id":"10.48550/arxiv.2608.03067","type":"dois","attributes":{"doi":"10.48550/arxiv.2608.03067","identifiers":[{"identifier":"2608.03067","identifierType":"arXiv"}],"creators":[{"nameType":"Personal","givenName":"Rui","familyName":"He","name":"He, Rui","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Ercong","familyName":"Nie","name":"Nie, Ercong","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Hong","familyName":"Jiang","name":"Jiang, Hong","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Iris E.","familyName":"Sommer","name":"Sommer, Iris E.","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Philipp","familyName":"Homan","name":"Homan, Philipp","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Wolfram","familyName":"Hinzen","name":"Hinzen, Wolfram","affiliation":[],"nameIdentifiers":[]}],"titles":[{"title":"Activation-Guided Neuron Intervention to Induce Alzheimer's-Related Computational Language Phenotypes in a Large Language Model"}],"publisher":"arXiv","container":{},"publicationYear":2026,"subjects":[{"subject":"Computation and Language (cs.CL)","lang":"en","subjectScheme":"arXiv"},{"subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"}],"contributors":[],"dates":[{"date":"2026-08-04T03:28:37Z","dateType":"Submitted","dateInformation":"v1"},{"date":"2026-08-05T00:23:02Z","dateType":"Updated","dateInformation":"v1"},{"date":"2026-08-05T18:56:48Z","dateType":"Submitted","dateInformation":"v2"},{"date":"2026-08-07T00:05:19Z","dateType":"Updated","dateInformation":"v2"},{"date":"2026-08","dateType":"Available","dateInformation":"v1"}],"language":null,"types":{"schemaOrg":"CreativeWork","resourceTypeGeneral":"Preprint","citeproc":"article","bibtex":"misc","ris":"GEN","resourceType":"Article"},"relatedIdentifiers":[],"relatedItems":[],"sizes":[],"formats":[],"version":"2","rightsList":[{"rightsIdentifierScheme":"SPDX","rightsUri":"https://creativecommons.org/licenses/by-nc-sa/4.0/legalcode","schemeUri":"https://spdx.org/licenses/","rights":"Creative Commons Attribution Non Commercial Share Alike 4.0 International","rightsIdentifier":"cc-by-nc-sa-4.0"}],"descriptions":[{"descriptionType":"Abstract","description":"Changes in spontaneous speech provide an early signal of cognitive dysfunction in Alzheimer's disease (AD) that large language models (LLMs) can detect. However, detection alone cannot establish whether the underlying model representations contribute functionally to behavior. We introduce an activation-guided intervention framework using Qwen3-8B. The framework identifies feed-forward neurons with higher activation rates for AD than control transcripts and modulates their output contributions during generation by scaling the corresponding down-projection weights. This yielded nine edited variants differing in intervention direction, magnitude, and scope. The original and edited models completed the same 12-turn neuropsychological battery, assessed through blinded human ratings and computational linguistic measures. Amplifying AD-associated neurons produced graded impairments in story recall, verbal fluency, working memory, procedural discourse, scene construction, and coreference resolution. Attenuation largely preserved performance and selectively improved several outcomes. Amplification also reduced lexical surprisal, idea density, syntactic complexity, and discourse quantity, broadly paralleling changes reported in human AD speech. These findings show that neurons identified solely from clinical language differences can influence behavior across multiple cognitive domains, providing proof of concept for an AD-related computational phenotype and a controlled framework for experimentally examining links between language and broader cognitive dysfunction."},{"descriptionType":"Other","description":"17 pages, 5 figures, 2 tables"}],"geoLocations":[],"fundingReferences":[],"url":"https://arxiv.org/abs/2608.03067","contentUrl":null,"metadataVersion":1,"schemaVersion":"http://datacite.org/schema/kernel-4","source":"mds","isActive":true,"state":"findable","reason":null,"viewCount":0,"downloadCount":0,"referenceCount":0,"citationCount":0,"partCount":0,"partOfCount":0,"versionCount":0,"versionOfCount":0,"created":"2026-08-05T02:04:19Z","registered":"2026-08-05T02:04:20Z","published":null,"updated":"2026-08-07T02:22:20Z"},"relationships":{"client":{"data":{"id":"arxiv.content","type":"clients"}}}},{"id":"10.48550/arxiv.2608.03070","type":"dois","attributes":{"doi":"10.48550/arxiv.2608.03070","identifiers":[{"identifier":"2608.03070","identifierType":"arXiv"}],"creators":[{"nameType":"Personal","givenName":"Jasper","familyName":"Timm","name":"Timm, Jasper","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Lukas","familyName":"Struppek","name":"Struppek, Lukas","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Ziwei","familyName":"Xu","name":"Xu, Ziwei","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Grace","familyName":"Cheong","name":"Cheong, Grace","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Oscar","familyName":"Mata","name":"Mata, Oscar","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Dan","familyName":"Zhao","name":"Zhao, Dan","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Mick","familyName":"Yang","name":"Yang, Mick","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Isadora","familyName":"De Andrade","name":"De Andrade, Isadora","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Xiaojun","familyName":"Jia","name":"Jia, Xiaojun","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Yiming","familyName":"Li","name":"Li, Yiming","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Samuel","familyName":"Bauer","name":"Bauer, Samuel","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Heather","familyName":"McIntyre","name":"McIntyre, Heather","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Adam","familyName":"Gleave","name":"Gleave, Adam","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Edward","familyName":"Yee","name":"Yee, Edward","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Kellin","familyName":"Pelrine","name":"Pelrine, Kellin","affiliation":[],"nameIdentifiers":[]}],"titles":[{"title":"AI Security Leaderboard: Methodology, Results and Minimal Standard"}],"publisher":"arXiv","container":{},"publicationYear":2026,"subjects":[{"subject":"Cryptography and Security (cs.CR)","lang":"en","subjectScheme":"arXiv"},{"subject":"Artificial Intelligence (cs.AI)","lang":"en","subjectScheme":"arXiv"},{"subject":"Computation and Language (cs.CL)","lang":"en","subjectScheme":"arXiv"},{"subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"}],"contributors":[],"dates":[{"date":"2026-08-04T03:32:19Z","dateType":"Submitted","dateInformation":"v1"},{"date":"2026-08-05T00:23:08Z","dateType":"Updated","dateInformation":"v1"},{"date":"2026-08-05T18:50:24Z","dateType":"Submitted","dateInformation":"v2"},{"date":"2026-08-07T00:05:09Z","dateType":"Updated","dateInformation":"v2"},{"date":"2026-08","dateType":"Available","dateInformation":"v1"}],"language":null,"types":{"schemaOrg":"CreativeWork","resourceTypeGeneral":"Preprint","citeproc":"article","bibtex":"misc","ris":"GEN","resourceType":"Article"},"relatedIdentifiers":[],"relatedItems":[],"sizes":[],"formats":[],"version":"2","rightsList":[{"rightsIdentifierScheme":"SPDX","rightsUri":"https://creativecommons.org/licenses/by/4.0/legalcode","schemeUri":"https://spdx.org/licenses/","rights":"Creative Commons Attribution 4.0 International","rightsIdentifier":"cc-by-4.0"}],"descriptions":[{"descriptionType":"Abstract","description":"The AI Security Leaderboard is an independent benchmark that ranks the safeguards of frontier AI models from least to most secure. It tests models against the FAR$.$AI Minimal Standard for Safeguards, which represents a minimum bar for security: meeting it does not guarantee a secure model, but failing to meet it guarantees a lack of state-of-the-art security. Version 1.0 covers severe misuse requests across chemical, biological, radiological, nuclear, and explosive (CBRNE) threats and offensive cybersecurity. In this report, we tested four leading models for universal jailbreaks in the context of this minimal standard, and found more than a hundredfold difference in security. Claude Fable 5 and GPT-5.6 Sol held against every attack we ran, with no universal jailbreak found; we estimate they would likely cost more than \\$14,200 to jailbreak, if it is possible with this methodology at all. Meanwhile, we found hundreds of universal jailbreaks for Grok 4.5 and Gemini 3.1 Pro; each broke for under \\$300, with universal jailbreaks in Grok's weakest domain, cybersecurity, accessible for as little as \\$24. The gap is fixable: every weakness we found belongs to a known class of attack that already has a defense deployed in production models. The leaderboard will be updated on a rolling basis as new models are released, and the evaluation methodology and Minimal Standard will be periodically revised to take into account the latest capabilities and the state-of-the-art in safeguards. The leaderboard is available at leaderboard.far.ai."}],"geoLocations":[],"fundingReferences":[],"url":"https://arxiv.org/abs/2608.03070","contentUrl":null,"metadataVersion":1,"schemaVersion":"http://datacite.org/schema/kernel-4","source":"mds","isActive":true,"state":"findable","reason":null,"viewCount":0,"downloadCount":0,"referenceCount":0,"citationCount":0,"partCount":0,"partOfCount":0,"versionCount":0,"versionOfCount":0,"created":"2026-08-05T02:04:23Z","registered":"2026-08-05T02:04:24Z","published":null,"updated":"2026-08-07T02:22:20Z"},"relationships":{"client":{"data":{"id":"arxiv.content","type":"clients"}}}},{"id":"10.48550/arxiv.2608.03001","type":"dois","attributes":{"doi":"10.48550/arxiv.2608.03001","identifiers":[{"identifier":"2608.03001","identifierType":"arXiv"}],"creators":[{"nameType":"Personal","givenName":"Junwen","familyName":"Qiu","name":"Qiu, Junwen","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Bohao","familyName":"Ma","name":"Ma, Bohao","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Andre","familyName":"Milzarek","name":"Milzarek, Andre","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Junyu","familyName":"Zhang","name":"Zhang, Junyu","affiliation":[],"nameIdentifiers":[]}],"titles":[{"title":"Stochastic Saddle Avoidance Beyond Unit Excitation and Smoothness: A Pathwise Lyapunov-Perron Framework"}],"publisher":"arXiv","container":{},"publicationYear":2026,"subjects":[{"subject":"Optimization and Control (math.OC)","lang":"en","subjectScheme":"arXiv"},{"subject":"Machine Learning (cs.LG)","lang":"en","subjectScheme":"arXiv"},{"subject":"Dynamical Systems (math.DS)","lang":"en","subjectScheme":"arXiv"},{"subject":"Machine Learning (stat.ML)","lang":"en","subjectScheme":"arXiv"},{"subject":"FOS: Mathematics","subjectScheme":"Fields of Science and Technology (FOS)"},{"subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"},{"subject":"90C06, 90C26, 37D10, 37C60","lang":"en","subjectScheme":"MSC"}],"contributors":[],"dates":[{"date":"2026-08-04T01:34:36Z","dateType":"Submitted","dateInformation":"v1"},{"date":"2026-08-05T00:17:18Z","dateType":"Updated","dateInformation":"v1"},{"date":"2026-08-06T04:18:49Z","dateType":"Submitted","dateInformation":"v2"},{"date":"2026-08-07T00:23:09Z","dateType":"Updated","dateInformation":"v2"},{"date":"2026-08","dateType":"Available","dateInformation":"v1"}],"language":null,"types":{"schemaOrg":"CreativeWork","resourceTypeGeneral":"Preprint","citeproc":"article","bibtex":"misc","ris":"GEN","resourceType":"Article"},"relatedIdentifiers":[],"relatedItems":[],"sizes":[],"formats":[],"version":"2","rightsList":[{"rightsIdentifierScheme":"SPDX","rightsUri":"https://creativecommons.org/licenses/by/4.0/legalcode","schemeUri":"https://spdx.org/licenses/","rights":"Creative Commons Attribution 4.0 International","rightsIdentifier":"cc-by-4.0"}],"descriptions":[{"descriptionType":"Abstract","description":"Unit excitation (UE) is a common assumption in stochastic saddle avoidance: the stochastic error must have a uniformly positive component along every direction, in expectation. This condition gives a direct way to rule out convergence to strict saddles, but it also oversimplifies the actual noise structure, and does not match many stochastic optimization regimes. In overparameterized or interpolation models, the noise may vanish near stationarity. In finite-sum problems, the stochastic gradient noise may lie in a low-dimensional, data-dependent subspace. In these (common) scenarios, UE is naturally not satisfied. In this paper, we prove an abstract almost sure avoidance theorem for stochastic recursions without UE. The theorem replaces UE-type requirements by verifiable pathwise conditions. In applications, these conditions follow, e.g., from local smoothness and finite-moment assumptions under standard i.i.d. sampling, or from the finite-sum structure under without-replacement sampling. Since the stochastically sampled maps generally do not share a fixed point, the celebrated center-stable manifold argument used in deterministic analyses is not directly applicable. Instead, we use a path-dependent change of variables together with a pathwise Lyapunov--Perron-based proof strategy. As applications, we obtain strict saddle avoidance for stochastic mirror descent (including SGD) and for random reshuffling. For nonsmooth composite objectives, we prove avoidance results for a proximal-type stochastic gradient method. Combining these insights with suitable iterate convergence guarantees, this allows establishing convergence to local minimizers of the original objective function."},{"descriptionType":"Other","description":"39 pages"}],"geoLocations":[],"fundingReferences":[],"url":"https://arxiv.org/abs/2608.03001","contentUrl":null,"metadataVersion":1,"schemaVersion":"http://datacite.org/schema/kernel-4","source":"mds","isActive":true,"state":"findable","reason":null,"viewCount":0,"downloadCount":0,"referenceCount":0,"citationCount":0,"partCount":0,"partOfCount":0,"versionCount":0,"versionOfCount":0,"created":"2026-08-05T02:02:50Z","registered":"2026-08-05T02:02:51Z","published":null,"updated":"2026-08-07T02:22:19Z"},"relationships":{"client":{"data":{"id":"arxiv.content","type":"clients"}}}},{"id":"10.48550/arxiv.2608.02989","type":"dois","attributes":{"doi":"10.48550/arxiv.2608.02989","identifiers":[{"identifier":"2608.02989","identifierType":"arXiv"}],"creators":[{"nameType":"Personal","givenName":"Shuang","familyName":"Liang","name":"Liang, Shuang","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Hao Mark","familyName":"Chen","name":"Chen, Hao Mark","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Zhiwen","familyName":"Mo","name":"Mo, Zhiwen","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Qianzhou","familyName":"Wang","name":"Wang, Qianzhou","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Guoyu","familyName":"Li","name":"Li, Guoyu","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Lingxiao","familyName":"Ma","name":"Ma, Lingxiao","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Wayne","familyName":"Luk","name":"Luk, Wayne","affiliation":[],"nameIdentifiers":[]}],"titles":[{"title":"AcceptMoE: Commitment-Weighted Self-Sizing Verifier Expert Sets for Efficient MoE Speculative Decoding"}],"publisher":"arXiv","container":{},"publicationYear":2026,"subjects":[{"subject":"Machine Learning (cs.LG)","lang":"en","subjectScheme":"arXiv"},{"subject":"Computation and Language (cs.CL)","lang":"en","subjectScheme":"arXiv"},{"subject":"Distributed, Parallel, and Cluster Computing (cs.DC)","lang":"en","subjectScheme":"arXiv"},{"subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"}],"contributors":[],"dates":[{"date":"2026-08-04T01:01:12Z","dateType":"Submitted","dateInformation":"v1"},{"date":"2026-08-06T13:56:35Z","dateType":"Updated","dateInformation":"v1"},{"date":"2026-08","dateType":"Available","dateInformation":"v1"}],"language":null,"types":{"schemaOrg":"CreativeWork","resourceTypeGeneral":"Preprint","citeproc":"article","bibtex":"misc","ris":"GEN","resourceType":"Article"},"relatedIdentifiers":[],"relatedItems":[],"sizes":[],"formats":[],"version":"1","rightsList":[{"rightsUri":"http://arxiv.org/licenses/nonexclusive-distrib/1.0/","rights":"arXiv.org perpetual, non-exclusive license"}],"descriptions":[{"descriptionType":"Abstract","description":"Speculative decoding verifies a tree of draft tokens in one target-model forward pass. For a mixture-of-experts (MoE) target, however, parallel verification can activate the union of the experts selected by all tree nodes, even though only a small subset of those nodes reaches the accepted output. Token count, activated-expert union size, and expert-weight traffic are therefore distinct cost measures: reducing the token workload need not shrink the expert union proportionally, and under offloading, transfer traffic also depends on cache residency. We introduce AcceptMoE, a verifier-side expert selector that combines target-router scores with offline-estimated commitment probabilities and automatically adjusts the number of eligible experts for each verification block, eliminating the need for a user-specified expert budget. Under offloading, AcceptMoE conditions expert eligibility on cache residency instead of predicting natural routes and prefetching the corresponding expert weights. Although constraining target-expert eligibility changes the model distribution, across 12 model-task pairs spanning three MoE targets and four benchmarks, AcceptMoE's mean accuracy is 0.27 percentage points lower than that of EAGLE-3 speculative decoding with natural routing. Served with SGLang at batch size one, it reaches 1.290 times the throughput of this baseline with all expert weights in GPU memory, and 2.06 times under physical expert offloading, while reducing host-to-device traffic by 73.6 percent to 77.1 percent."},{"descriptionType":"Other","description":"10 pages, 5 figures"}],"geoLocations":[],"fundingReferences":[],"url":"https://arxiv.org/abs/2608.02989","contentUrl":null,"metadataVersion":1,"schemaVersion":"http://datacite.org/schema/kernel-4","source":"mds","isActive":true,"state":"findable","reason":null,"viewCount":0,"downloadCount":0,"referenceCount":0,"citationCount":0,"partCount":0,"partOfCount":0,"versionCount":0,"versionOfCount":0,"created":"2026-08-05T02:02:34Z","registered":"2026-08-05T02:02:34Z","published":null,"updated":"2026-08-07T02:22:18Z"},"relationships":{"client":{"data":{"id":"arxiv.content","type":"clients"}}}},{"id":"10.48550/arxiv.2608.02973","type":"dois","attributes":{"doi":"10.48550/arxiv.2608.02973","identifiers":[{"identifier":"2608.02973","identifierType":"arXiv"}],"creators":[{"nameType":"Personal","givenName":"Scott","familyName":"Bollt","name":"Bollt, Scott","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Mario","familyName":"di Bernardo","name":"di Bernardo, Mario","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Jeremie","familyName":"Fish","name":"Fish, Jeremie","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Daniel J.","familyName":"Gauthier","name":"Gauthier, Daniel J.","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Ying-Cheng","familyName":"Lai","name":"Lai, Ying-Cheng","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Mason A.","familyName":"Porter","name":"Porter, Mason A.","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Jie","familyName":"Sun","name":"Sun, Jie","affiliation":[],"nameIdentifiers":[]}],"titles":[{"title":"Memorial for Dr. Erik Bollt"}],"publisher":"arXiv","container":{},"publicationYear":2026,"subjects":[{"subject":"History and Overview (math.HO)","lang":"en","subjectScheme":"arXiv"},{"subject":"Dynamical Systems (math.DS)","lang":"en","subjectScheme":"arXiv"},{"subject":"Chaotic Dynamics (nlin.CD)","lang":"en","subjectScheme":"arXiv"},{"subject":"FOS: Mathematics","subjectScheme":"Fields of Science and Technology (FOS)"},{"subject":"FOS: Physical sciences","subjectScheme":"Fields of Science and Technology (FOS)"}],"contributors":[],"dates":[{"date":"2026-08-04T00:15:19Z","dateType":"Submitted","dateInformation":"v1"},{"date":"2026-08-05T00:15:37Z","dateType":"Updated","dateInformation":"v1"},{"date":"2026-08-05T15:16:52Z","dateType":"Submitted","dateInformation":"v2"},{"date":"2026-08-07T00:17:06Z","dateType":"Updated","dateInformation":"v2"},{"date":"2026-08","dateType":"Available","dateInformation":"v1"}],"language":null,"types":{"schemaOrg":"CreativeWork","resourceTypeGeneral":"Preprint","citeproc":"article","bibtex":"misc","ris":"GEN","resourceType":"Article"},"relatedIdentifiers":[],"relatedItems":[],"sizes":[],"formats":[],"version":"2","rightsList":[{"rightsUri":"http://arxiv.org/licenses/nonexclusive-distrib/1.0/","rights":"arXiv.org perpetual, non-exclusive license"}],"descriptions":[{"descriptionType":"Abstract","description":"In this paper, we give a memorial tribute to Prof. Erik M. Bollt (1967--2025)."}],"geoLocations":[],"fundingReferences":[],"url":"https://arxiv.org/abs/2608.02973","contentUrl":null,"metadataVersion":2,"schemaVersion":"http://datacite.org/schema/kernel-4","source":"mds","isActive":true,"state":"findable","reason":null,"viewCount":0,"downloadCount":0,"referenceCount":0,"citationCount":0,"partCount":0,"partOfCount":0,"versionCount":0,"versionOfCount":0,"created":"2026-08-05T02:02:12Z","registered":"2026-08-05T02:02:13Z","published":null,"updated":"2026-08-07T02:22:18Z"},"relationships":{"client":{"data":{"id":"arxiv.content","type":"clients"}}}},{"id":"10.48550/arxiv.2608.02940","type":"dois","attributes":{"doi":"10.48550/arxiv.2608.02940","identifiers":[{"identifier":"2608.02940","identifierType":"arXiv"}],"creators":[{"nameType":"Personal","givenName":"Andrew","familyName":"Zhang","name":"Zhang, Andrew","affiliation":[],"nameIdentifiers":[]}],"titles":[{"title":"When Compression Scores Cannot Decide: Information Boundaries for Group-Robust LLM Pruning"}],"publisher":"arXiv","container":{},"publicationYear":2026,"subjects":[{"subject":"Artificial Intelligence (cs.AI)","lang":"en","subjectScheme":"arXiv"},{"subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"}],"contributors":[],"dates":[{"date":"2026-08-03T23:07:29Z","dateType":"Submitted","dateInformation":"v1"},{"date":"2026-08-05T00:13:27Z","dateType":"Updated","dateInformation":"v1"},{"date":"2026-08-06T13:21:54Z","dateType":"Submitted","dateInformation":"v2"},{"date":"2026-08-07T00:48:55Z","dateType":"Updated","dateInformation":"v2"},{"date":"2026-08","dateType":"Available","dateInformation":"v1"}],"language":null,"types":{"schemaOrg":"CreativeWork","resourceTypeGeneral":"Preprint","citeproc":"article","bibtex":"misc","ris":"GEN","resourceType":"Article"},"relatedIdentifiers":[],"relatedItems":[],"sizes":[],"formats":[],"version":"2","rightsList":[{"rightsIdentifierScheme":"SPDX","rightsUri":"https://creativecommons.org/licenses/by/4.0/legalcode","schemeUri":"https://spdx.org/licenses/","rights":"Creative Commons Attribution 4.0 International","rightsIdentifier":"cc-by-4.0"}],"descriptions":[{"descriptionType":"Abstract","description":"A stable compression score can still select the worse model. In our dense study, a split-half reliable path-quadratic score predicted a 16.1\\% gain, while the selected endpoints were 6.0--7.7% worse than two controls. We ask what a compression statistic can justify when deployment cares about the worst supplied group. We treat each statistic as an information interface. Its observation leaves a fiber of compatible endpoint-risk tables, and only orders fixed across that fiber are identified. Cone and fiber identities quantify the remaining uncertainty, while matched observations reverse endpoint order for pooled moments, group-local moments, and reference-path curvature. Sequential composition adds one state variable: the slack from each group risk to the current maximum. This vector determines every unrestricted one-step response, and a margin condition keeps the active group fixed along paths with bounded relative drift. The experiments follow the same ladder. Across three dense LLMs, an early-preserving allocation reduces worst-group perplexity inflation by 12.6--20.9%; target-matched complete-menu selection improves over its references by 2.7--8.0%. Across all 16 routed layers of OLMoE, pooled endpoint refresh lowers held-out worst-group teacher KL by 15.8% over the best static score. A compute-matched hard-max trajectory ends 32.7% worse than pooled, and neither adaptive trajectory improves excess NLL. Local evidence can narrow a menu. Complete endpoints rank that menu, while multistep claims also require control of the evolving active face and future candidates."},{"descriptionType":"Other","description":"19 pages, 6 figures, 1 table"}],"geoLocations":[],"fundingReferences":[],"url":"https://arxiv.org/abs/2608.02940","contentUrl":null,"metadataVersion":1,"schemaVersion":"http://datacite.org/schema/kernel-4","source":"mds","isActive":true,"state":"findable","reason":null,"viewCount":0,"downloadCount":0,"referenceCount":0,"citationCount":0,"partCount":0,"partOfCount":0,"versionCount":0,"versionOfCount":0,"created":"2026-08-05T02:01:26Z","registered":"2026-08-05T02:01:27Z","published":null,"updated":"2026-08-07T02:22:16Z"},"relationships":{"client":{"data":{"id":"arxiv.content","type":"clients"}}}},{"id":"10.48550/arxiv.2608.02813","type":"dois","attributes":{"doi":"10.48550/arxiv.2608.02813","identifiers":[{"identifier":"2608.02813","identifierType":"arXiv"}],"creators":[{"nameType":"Personal","givenName":"Meng","familyName":"Chen","name":"Chen, Meng","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Yufei","familyName":"Xi","name":"Xi, Yufei","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Lin","familyName":"Cheng","name":"Cheng, Lin","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Florian","familyName":"Dörfler","name":"Dörfler, Florian","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Ioannis","familyName":"Lestas","name":"Lestas, Ioannis","affiliation":[],"nameIdentifiers":[]}],"titles":[{"title":"Coordinated Primary Frequency Regulation and Grid-Forming Control for Wind Turbine Generators"}],"publisher":"arXiv","container":{},"publicationYear":2026,"subjects":[{"subject":"Systems and Control (eess.SY)","lang":"en","subjectScheme":"arXiv"},{"subject":"FOS: Electrical engineering, electronic engineering, information engineering","subjectScheme":"Fields of Science and Technology (FOS)"}],"contributors":[],"dates":[{"date":"2026-08-03T19:08:43Z","dateType":"Submitted","dateInformation":"v1"},{"date":"2026-08-05T00:05:02Z","dateType":"Updated","dateInformation":"v1"},{"date":"2026-08-06T12:41:03Z","dateType":"Submitted","dateInformation":"v2"},{"date":"2026-08-07T00:46:39Z","dateType":"Updated","dateInformation":"v2"},{"date":"2026-08","dateType":"Available","dateInformation":"v1"}],"language":null,"types":{"schemaOrg":"CreativeWork","resourceTypeGeneral":"Preprint","citeproc":"article","bibtex":"misc","ris":"GEN","resourceType":"Article"},"relatedIdentifiers":[],"relatedItems":[],"sizes":[],"formats":[],"version":"2","rightsList":[{"rightsIdentifierScheme":"SPDX","rightsUri":"https://creativecommons.org/licenses/by-nc-nd/4.0/legalcode","schemeUri":"https://spdx.org/licenses/","rights":"Creative Commons Attribution Non Commercial No Derivatives 4.0 International","rightsIdentifier":"cc-by-nc-nd-4.0"}],"descriptions":[{"descriptionType":"Abstract","description":"Conventional grid-forming (GFM) control strategies often treat the DC source as an unconstrained link, creating mismatches when applied to the wind turbine generators (WTGs). Focusing on primary frequency regulation, this paper systematically investigates the mismatch between the GFM-WTGs behavior and the droop-based primary frequency regulation. To address this issue, a novel coordination strategy between WTG primary frequency regulation and GFM control is proposed. By establishing well-designed relationships among the power-tracking coefficient, power set-point, and frequency deviation, the proposed strategy enables GFM-WTGs to participate consistently in primary frequency regulation within predefined frequency limits while maintaining appropriate power points and effectively utilizing the allowable power reserve. Furthermore, the proposed method preserves the control structure and dynamic performance of conventional GFM control and inherently adapts to varying wind-speed conditions. Comparative case studies under different operating scenarios demonstrate the effectiveness and superiority of the proposed strategy."}],"geoLocations":[],"fundingReferences":[],"url":"https://arxiv.org/abs/2608.02813","contentUrl":null,"metadataVersion":1,"schemaVersion":"http://datacite.org/schema/kernel-4","source":"mds","isActive":true,"state":"findable","reason":null,"viewCount":0,"downloadCount":0,"referenceCount":0,"citationCount":0,"partCount":0,"partOfCount":0,"versionCount":0,"versionOfCount":0,"created":"2026-08-05T01:58:27Z","registered":"2026-08-05T01:58:28Z","published":null,"updated":"2026-08-07T02:22:14Z"},"relationships":{"client":{"data":{"id":"arxiv.content","type":"clients"}}}},{"id":"10.48550/arxiv.2608.02745","type":"dois","attributes":{"doi":"10.48550/arxiv.2608.02745","identifiers":[{"identifier":"2608.02745","identifierType":"arXiv"}],"creators":[{"nameType":"Personal","givenName":"Fabio","familyName":"Franchini","name":"Franchini, Fabio","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Salvatore Marco","familyName":"Giampaolo","name":"Giampaolo, Salvatore Marco","affiliation":[],"nameIdentifiers":[]}],"titles":[{"title":"Schmidt-Gauge Non-Local Magic: Representation, Optimality, and Mathematical Properties"}],"publisher":"arXiv","container":{},"publicationYear":2026,"subjects":[{"subject":"Quantum Physics (quant-ph)","lang":"en","subjectScheme":"arXiv"},{"subject":"FOS: Physical sciences","subjectScheme":"Fields of Science and Technology (FOS)"}],"contributors":[],"dates":[{"date":"2026-08-03T18:00:12Z","dateType":"Submitted","dateInformation":"v1"},{"date":"2026-08-05T00:02:50Z","dateType":"Updated","dateInformation":"v1"},{"date":"2026-08-06T14:14:04Z","dateType":"Submitted","dateInformation":"v2"},{"date":"2026-08-07T00:51:46Z","dateType":"Updated","dateInformation":"v2"},{"date":"2026-08","dateType":"Available","dateInformation":"v1"}],"language":null,"types":{"schemaOrg":"CreativeWork","resourceTypeGeneral":"Preprint","citeproc":"article","bibtex":"misc","ris":"GEN","resourceType":"Article"},"relatedIdentifiers":[],"relatedItems":[],"sizes":[],"formats":[],"version":"2","rightsList":[{"rightsIdentifierScheme":"SPDX","rightsUri":"https://creativecommons.org/licenses/by/4.0/legalcode","schemeUri":"https://spdx.org/licenses/","rights":"Creative Commons Attribution 4.0 International","rightsIdentifier":"cc-by-4.0"}],"descriptions":[{"descriptionType":"Abstract","description":"While the full non-stabilizerness (magic) of a quantum state contains local, basis-dependent contributions, a non-local formulation based on a minimization over local unitaries isolates the component associated with genuinely non-local correlations. Within such a framework, the Schmidt-gauge formulation of non-local magic provides a direct connection between genuinely non-local non-stabilizer correlations and the entanglement spectrum of quantum many-body states. Building on the exact Walsh--Hadamard representation introduced in our accompanying Letter, we develop the mathematical theory associated with this formulation. We extend the formalism to arbitrary bipartitions, prove the exactness of the Schmidt gauge for arbitrary $1\\times N$ bipartitions, and derive general analytical properties of Schmidt-gauge non-local magic, including entanglement bounds, selection rules, and exact relations with the moments of the normalized Walsh spectrum. This representation also provides an interpretation of Schmidt-gauge non-local magic as a logarithmic inverse participation ratio normalized by a universal harmonic baseline, thereby relating it to excess delocalization in Walsh space. These results demonstrate that the Walsh--Hadamard representation reveals an underlying discrete harmonic structure that is hidden in the original spectral formulation and provides considerably more than an equivalent expression for Schmidt-gauge non-local magic. Rather, it furnishes the natural mathematical framework for its analytical investigation, placing the theory within the broader context of discrete harmonic analysis."},{"descriptionType":"Other","description":"10 pages, 0 figures"}],"geoLocations":[],"fundingReferences":[],"url":"https://arxiv.org/abs/2608.02745","contentUrl":null,"metadataVersion":1,"schemaVersion":"http://datacite.org/schema/kernel-4","source":"mds","isActive":true,"state":"findable","reason":null,"viewCount":0,"downloadCount":0,"referenceCount":0,"citationCount":0,"partCount":0,"partOfCount":0,"versionCount":0,"versionOfCount":0,"created":"2026-08-05T01:56:52Z","registered":"2026-08-05T01:56:53Z","published":null,"updated":"2026-08-07T02:22:13Z"},"relationships":{"client":{"data":{"id":"arxiv.content","type":"clients"}}}},{"id":"10.48550/arxiv.2608.02759","type":"dois","attributes":{"doi":"10.48550/arxiv.2608.02759","identifiers":[{"identifier":"2608.02759","identifierType":"arXiv"}],"creators":[{"nameType":"Personal","givenName":"Lav R.","familyName":"Varshney","name":"Varshney, Lav R.","affiliation":[],"nameIdentifiers":[]}],"titles":[{"title":"Quota and population monotonicity across house sizes are incompatible for apportionment to four states"}],"publisher":"arXiv","container":{},"publicationYear":2026,"subjects":[{"subject":"Computer Science and Game Theory (cs.GT)","lang":"en","subjectScheme":"arXiv"},{"subject":"Signal Processing (eess.SP)","lang":"en","subjectScheme":"arXiv"},{"subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"},{"subject":"FOS: Electrical engineering, electronic engineering, information engineering","subjectScheme":"Fields of Science and Technology (FOS)"}],"contributors":[],"dates":[{"date":"2026-08-03T18:04:55Z","dateType":"Submitted","dateInformation":"v1"},{"date":"2026-08-05T00:03:15Z","dateType":"Updated","dateInformation":"v1"},{"date":"2026-08-05T19:17:03Z","dateType":"Submitted","dateInformation":"v2"},{"date":"2026-08-07T00:06:13Z","dateType":"Updated","dateInformation":"v2"},{"date":"2026-08","dateType":"Available","dateInformation":"v1"}],"language":null,"types":{"schemaOrg":"CreativeWork","resourceTypeGeneral":"Preprint","citeproc":"article","bibtex":"misc","ris":"GEN","resourceType":"Article"},"relatedIdentifiers":[],"relatedItems":[],"sizes":[],"formats":[],"version":"2","rightsList":[{"rightsUri":"http://arxiv.org/licenses/nonexclusive-distrib/1.0/","rights":"arXiv.org perpetual, non-exclusive license"}],"descriptions":[{"descriptionType":"Abstract","description":"Apportionment converts fractional entitlements into integer seat allocations. Quota requires each state to receive the floor or ceiling of its standard quota, whereas population monotonicity prohibits a state whose population weakly increases from losing a seat to a state whose population weakly decreases. Gölz, Peters, and Procaccia recently removed the order-preservation assumptions used in classical incompatibility results by giving a five-state construction; together with the three-state Webster possibility result, this left four states as the unresolved boundary. We prove that no deterministic four-state apportionment solution satisfies both axioms under their definition, which permits the compared house sizes to differ. The proof is a finite logical gadget. Conditional on one quota choice at a central profile, twelve auxiliary profiles encode three bits and force a frustrated cycle. The argument uses only transfers between states whose populations are unchanged and assumes neither anonymity, neutrality, order preservation, homogeneity, nor other regularity conditions. It also applies to relative population monotonicity. Geometrically, the result is a global compatibility obstruction for quota-constrained lattice rounding, rather than an average-distortion bound."}],"geoLocations":[],"fundingReferences":[],"url":"https://arxiv.org/abs/2608.02759","contentUrl":null,"metadataVersion":1,"schemaVersion":"http://datacite.org/schema/kernel-4","source":"mds","isActive":true,"state":"findable","reason":null,"viewCount":0,"downloadCount":0,"referenceCount":0,"citationCount":0,"partCount":0,"partOfCount":0,"versionCount":0,"versionOfCount":0,"created":"2026-08-05T01:57:12Z","registered":"2026-08-05T01:57:13Z","published":null,"updated":"2026-08-07T02:22:13Z"},"relationships":{"client":{"data":{"id":"arxiv.content","type":"clients"}}}},{"id":"10.48550/arxiv.2608.02738","type":"dois","attributes":{"doi":"10.48550/arxiv.2608.02738","identifiers":[{"identifier":"2608.02738","identifierType":"arXiv"}],"creators":[{"nameType":"Personal","givenName":"Zixuan","familyName":"Wang","name":"Wang, Zixuan","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Yuhong","familyName":"Chen","name":"Chen, Yuhong","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Yuxuan","familyName":"Zhu","name":"Zhu, Yuxuan","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Guidong","familyName":"Lei","name":"Lei, Guidong","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Zhiluohan","familyName":"Guo","name":"Guo, Zhiluohan","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Yu","familyName":"Zhao","name":"Zhao, Yu","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Kun","familyName":"Wang","name":"Wang, Kun","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Bangyang","familyName":"Hong","name":"Hong, Bangyang","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Kangle","familyName":"Wu","name":"Wu, Kangle","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Yabo","familyName":"Ni","name":"Ni, Yabo","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Anxiang","familyName":"Zeng","name":"Zeng, Anxiang","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Cong","familyName":"Fu","name":"Fu, Cong","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Hui","familyName":"Li","name":"Li, Hui","affiliation":[],"nameIdentifiers":[]}],"titles":[{"title":"Knowledge-Geometry Decoupling: Refreshable Pretrained Transfer for Streaming Recommendation"}],"publisher":"arXiv","container":{},"publicationYear":2026,"subjects":[{"subject":"Information Retrieval (cs.IR)","lang":"en","subjectScheme":"arXiv"},{"subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"}],"contributors":[],"dates":[{"date":"2026-08-03T18:00:05Z","dateType":"Submitted","dateInformation":"v1"},{"date":"2026-08-05T00:02:43Z","dateType":"Updated","dateInformation":"v1"},{"date":"2026-08-06T05:18:40Z","dateType":"Withdrawn","dateInformation":"v2; Withdrawn due to data sharing and privacy regulations of industrial co-authors"},{"date":"2026-08-07T00:25:30Z","dateType":"Updated","dateInformation":"v2"},{"date":"2026-08","dateType":"Available","dateInformation":"v1"}],"language":null,"types":{"schemaOrg":"CreativeWork","resourceTypeGeneral":"Preprint","citeproc":"article","bibtex":"misc","ris":"GEN","resourceType":"Article"},"relatedIdentifiers":[],"relatedItems":[],"sizes":[],"formats":[],"version":"2","rightsList":[{"rightsUri":"http://arxiv.org/licenses/nonexclusive-distrib/1.0/","rights":"arXiv.org perpetual, non-exclusive license"}],"descriptions":[{"descriptionType":"Abstract","description":"Industrial recommenders increasingly adopt the pretrain-then-transfer paradigm, yet behavioral distribution drift raises two questions: what to learn from behavior sequences, and how to transfer the learned knowledge while the pretrained model is continually refreshed. To resolve them, we propose Knowledge-Geometry Decoupling (KGD). For what to learn, conventional next-token prediction treats adjacency as dependency and may encode spurious transitions across unrelated sessions. We introduce Behavioral Multi-Token Prediction (BMTP) to retain only collaboratively or semantically related future items as supervision, yielding cleaner and more transferable behavioral knowledge. For how to transfer, pretrained knowledge and task-specific geometry impose conflicting optimization demands on shared parameters. To handle it, KGD assigns them to separate parameter sets: a refreshable encoder owns behavioral knowledge, while a task learner reads contextualized encoder states through read-only cross-attention and writes task-specific geometry through Anchored Calibration Residual (ACR) orthogonal to the pretrained embedding. The decoupled ownership enables continual knowledge refresh without task-gradient interference or invalidating downstream adaptation. KGD improves over strong pretrain-transfer baselines by 4-12% on eight public benchmarks and sustains its advantage over a 90-day production stream where baselines show no gains. KGD has been fully deployed in Shopee. In a live A/B test on Shopee Homepage Search, it increases GMV per user by 1.75% and advertising revenue by 1.53%, demonstrating its high practical value. We provide the core implementation of KGD at https://github.com/FuCongResearchSquad/KGD4REC."},{"descriptionType":"Other","description":"Withdrawn due to data sharing and privacy regulations of industrial co-authors"}],"geoLocations":[],"fundingReferences":[],"url":"https://arxiv.org/abs/2608.02738","contentUrl":null,"metadataVersion":1,"schemaVersion":"http://datacite.org/schema/kernel-4","source":"mds","isActive":true,"state":"findable","reason":null,"viewCount":0,"downloadCount":0,"referenceCount":0,"citationCount":0,"partCount":0,"partOfCount":0,"versionCount":0,"versionOfCount":0,"created":"2026-08-05T01:56:43Z","registered":"2026-08-05T01:56:43Z","published":null,"updated":"2026-08-07T02:22:12Z"},"relationships":{"client":{"data":{"id":"arxiv.content","type":"clients"}}}},{"id":"10.48550/arxiv.2608.02723","type":"dois","attributes":{"doi":"10.48550/arxiv.2608.02723","identifiers":[{"identifier":"2608.02723","identifierType":"arXiv"}],"creators":[{"nameType":"Personal","givenName":"Rommulus Francis","familyName":"Lewis","name":"Lewis, Rommulus Francis","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Amruth","familyName":"Alfred","name":"Alfred, Amruth","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Hetansh","familyName":"Shah","name":"Shah, Hetansh","affiliation":[],"nameIdentifiers":[]}],"titles":[{"title":"The Research Impact of the Jodrell Bank Observatory and Other Facilities affected by the UK Science Funding Cuts in 2025"}],"publisher":"arXiv","container":{},"publicationYear":2026,"subjects":[{"subject":"Instrumentation and Methods for Astrophysics (astro-ph.IM)","lang":"en","subjectScheme":"arXiv"},{"subject":"Astrophysics of Galaxies (astro-ph.GA)","lang":"en","subjectScheme":"arXiv"},{"subject":"FOS: Physical sciences","subjectScheme":"Fields of Science and Technology (FOS)"}],"contributors":[],"dates":[{"date":"2026-08-03T18:00:02Z","dateType":"Submitted","dateInformation":"v1"},{"date":"2026-08-05T00:02:27Z","dateType":"Updated","dateInformation":"v1"},{"date":"2026-08-06T03:43:31Z","dateType":"Submitted","dateInformation":"v2"},{"date":"2026-08-07T00:22:25Z","dateType":"Updated","dateInformation":"v2"},{"date":"2026-08","dateType":"Available","dateInformation":"v1"}],"language":null,"types":{"schemaOrg":"CreativeWork","resourceTypeGeneral":"Preprint","citeproc":"article","bibtex":"misc","ris":"GEN","resourceType":"Article"},"relatedIdentifiers":[],"relatedItems":[],"sizes":[],"formats":[],"version":"2","rightsList":[{"rightsIdentifierScheme":"SPDX","rightsUri":"https://creativecommons.org/licenses/by/4.0/legalcode","schemeUri":"https://spdx.org/licenses/","rights":"Creative Commons Attribution 4.0 International","rightsIdentifier":"cc-by-4.0"}],"descriptions":[{"descriptionType":"Abstract","description":"The United Kingdom Research and Innovation body and the Science and Technology Facilities Council recently announced funding cuts to facilities at the Jodrell Bank Observatory, specifically the e-MERLIN network of radio telescopes as well as a few other facilities across the world like the James Clerk Maxwell Telescope. These funding cuts have been extremely disturbing to the Astronomical community, as is evident from widespread news coverage about these cuts. Here we present a short analysis of the research impact e-MERLIN and the other affected facilities had in 2025 from a dataset consisting of every Astrophysics paper submitted to the arXiv during the year. This serves to help members of the community and all stakeholders make better sense of the research output of the facilities that are not being prioritised under the new budget."},{"descriptionType":"Other","description":"3 pages, 1 figure, comments are welcome, corrections added"}],"geoLocations":[],"fundingReferences":[],"url":"https://arxiv.org/abs/2608.02723","contentUrl":null,"metadataVersion":1,"schemaVersion":"http://datacite.org/schema/kernel-4","source":"mds","isActive":true,"state":"findable","reason":null,"viewCount":0,"downloadCount":0,"referenceCount":0,"citationCount":0,"partCount":0,"partOfCount":0,"versionCount":0,"versionOfCount":0,"created":"2026-08-05T01:56:22Z","registered":"2026-08-05T01:56:23Z","published":null,"updated":"2026-08-07T02:22:11Z"},"relationships":{"client":{"data":{"id":"arxiv.content","type":"clients"}}}},{"id":"10.48550/arxiv.2608.02691","type":"dois","attributes":{"doi":"10.48550/arxiv.2608.02691","identifiers":[{"identifier":"2608.02691","identifierType":"arXiv"}],"creators":[{"nameType":"Personal","givenName":"Vincent-Daniel","familyName":"Yun","name":"Yun, Vincent-Daniel","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Woosang","familyName":"Lim","name":"Lim, Woosang","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Minsoo","familyName":"Cheong","name":"Cheong, Minsoo","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Sunwoo","familyName":"Lee","name":"Lee, Sunwoo","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Murali","familyName":"Annavaram","name":"Annavaram, Murali","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Sai Praneeth","familyName":"Karimireddy","name":"Karimireddy, Sai Praneeth","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Sungjoo","familyName":"Yoo","name":"Yoo, Sungjoo","affiliation":[],"nameIdentifiers":[]}],"titles":[{"title":"Output-Aware Rotation for INT2 KV-Cache Quantization"}],"publisher":"arXiv","container":{},"publicationYear":2026,"subjects":[{"subject":"Machine Learning (cs.LG)","lang":"en","subjectScheme":"arXiv"},{"subject":"Artificial Intelligence (cs.AI)","lang":"en","subjectScheme":"arXiv"},{"subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"}],"contributors":[],"dates":[{"date":"2026-08-03T09:24:23Z","dateType":"Submitted","dateInformation":"v1"},{"date":"2026-08-05T00:01:50Z","dateType":"Updated","dateInformation":"v1"},{"date":"2026-08-05T18:00:06Z","dateType":"Submitted","dateInformation":"v2"},{"date":"2026-08-07T00:02:48Z","dateType":"Updated","dateInformation":"v2"},{"date":"2026-08","dateType":"Available","dateInformation":"v1"}],"language":null,"types":{"schemaOrg":"CreativeWork","resourceTypeGeneral":"Preprint","citeproc":"article","bibtex":"misc","ris":"GEN","resourceType":"Article"},"relatedIdentifiers":[],"relatedItems":[],"sizes":[],"formats":[],"version":"2","rightsList":[{"rightsIdentifierScheme":"SPDX","rightsUri":"https://creativecommons.org/publicdomain/zero/1.0/legalcode","schemeUri":"https://spdx.org/licenses/","rights":"Creative Commons Zero v1.0 Universal","rightsIdentifier":"cc0-1.0"}],"descriptions":[{"descriptionType":"Abstract","description":"The key-value (KV) cache has become a major memory and bandwidth bottleneck in long-context large language model inference, making ultra-low-bit quantization increasingly important. However, existing rotation-based INT2 methods optimize cache statistics or proxy errors before the complete attention readout, even though the model is ultimately affected by the error propagated through attention and the output projection $W_O$. To address this mismatch, we propose \\textit{OptR}, an output-aware rotation method that minimizes post-$W_O$ attention-output error. OptR decomposes the post-$W_O$ attention-output error into key- and value-induced terms and learns per-head orthogonal corrections through the full INT2 quantization and attention path. OptR further applies an attention-equivalent key reparameterization to reduce large channel-wise offsets without changing the softmax distribution. Across three models and five reasoning and coding benchmarks, OptR consistently improves both QuaRot and OSCAR and strengthens long-context retrieval, while preserving the paged KV-cache format with negligible inference overhead."}],"geoLocations":[],"fundingReferences":[],"url":"https://arxiv.org/abs/2608.02691","contentUrl":null,"metadataVersion":1,"schemaVersion":"http://datacite.org/schema/kernel-4","source":"mds","isActive":true,"state":"findable","reason":null,"viewCount":0,"downloadCount":0,"referenceCount":0,"citationCount":0,"partCount":0,"partOfCount":0,"versionCount":0,"versionOfCount":0,"created":"2026-08-05T01:55:38Z","registered":"2026-08-05T01:55:39Z","published":null,"updated":"2026-08-07T02:22:10Z"},"relationships":{"client":{"data":{"id":"arxiv.content","type":"clients"}}}},{"id":"10.48550/arxiv.2608.02687","type":"dois","attributes":{"doi":"10.48550/arxiv.2608.02687","identifiers":[{"identifier":"2608.02687","identifierType":"arXiv"}],"creators":[{"nameType":"Personal","givenName":"Kyutae","familyName":"Park","name":"Park, Kyutae","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Jungwon","familyName":"Kim","name":"Kim, Jungwon","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Daeyeol","familyName":"Shim","name":"Shim, Daeyeol","affiliation":[],"nameIdentifiers":[]}],"titles":[{"title":"PolicyGuard: Prompt-Configurable Semantic DLP for LLM Coding Agents"}],"publisher":"arXiv","container":{},"publicationYear":2026,"subjects":[{"subject":"Cryptography and Security (cs.CR)","lang":"en","subjectScheme":"arXiv"},{"subject":"Software Engineering (cs.SE)","lang":"en","subjectScheme":"arXiv"},{"subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"}],"contributors":[],"dates":[{"date":"2026-08-03T08:10:15Z","dateType":"Submitted","dateInformation":"v1"},{"date":"2026-08-05T00:01:45Z","dateType":"Updated","dateInformation":"v1"},{"date":"2026-08-05T14:16:35Z","dateType":"Submitted","dateInformation":"v2"},{"date":"2026-08-06T00:50:29Z","dateType":"Updated","dateInformation":"v2"},{"date":"2026-08-06T01:19:44Z","dateType":"Withdrawn","dateInformation":"v3; This paper is being withdrawn because it was submitted prior to completion of a required institutional review process. The authors intend to resubmit after the review is complete"},{"date":"2026-08-07T00:16:09Z","dateType":"Updated","dateInformation":"v3"},{"date":"2026-08","dateType":"Available","dateInformation":"v1"}],"language":null,"types":{"schemaOrg":"CreativeWork","resourceTypeGeneral":"Preprint","citeproc":"article","bibtex":"misc","ris":"GEN","resourceType":"Article"},"relatedIdentifiers":[],"relatedItems":[],"sizes":[],"formats":[],"version":"3","rightsList":[{"rightsUri":"http://arxiv.org/licenses/nonexclusive-distrib/1.0/","rights":"arXiv.org perpetual, non-exclusive license"}],"descriptions":[{"descriptionType":"Abstract","description":"AI coding agents accept free-form natural language prompts that may inadvertently contain credentials, personally identifiable information (PII), or proprietary business data. Existing data loss prevention (DLP) solutions rely on rigid regex patterns, model fine-tuning, or vendor-managed classifiers with limited customizability. We present PolicyGuard, a pre-model interception framework that classifies user prompts using an LLM guided by a natural language policy file. Our key contributions are: (1) the policy-as-prompt paradigm, where DLP classification criteria are defined entirely in a plaintext policy document editable by non-engineers without code changes or model retraining; (2) a sealed evaluation protocol with template-family-level data splits, hidden holdouts, and frozen test sets to rigorously assess generalization; and (3) a comprehensive empirical evaluation across 2,000 multilingual prompts demonstrating 96.5% effective block rate (EBR) with only 3.0% false positive rate (FPR) on a frozen test set of 927 prompts, and perfect 100% accuracy on a 217-prompt hidden holdout. Information-matched baseline experiments show that PolicyGuard's natural language format significantly outperforms equivalent content in JSON format (McNemar chi-squared = 31.58, p \u0026lt; 0.001) and dramatically outperforms zero-shot classification (Cohen's h = 0.915). Cross-model portability experiments demonstrate that the same policy achieves 86.4-96.5% EBR across four different LLMs without modification."},{"descriptionType":"Other","description":"This paper is being withdrawn because it was submitted prior to completion of a required institutional review process. The authors intend to resubmit after the review is complete"}],"geoLocations":[],"fundingReferences":[],"url":"https://arxiv.org/abs/2608.02687","contentUrl":null,"metadataVersion":2,"schemaVersion":"http://datacite.org/schema/kernel-4","source":"mds","isActive":true,"state":"findable","reason":null,"viewCount":0,"downloadCount":0,"referenceCount":0,"citationCount":0,"partCount":0,"partOfCount":0,"versionCount":0,"versionOfCount":0,"created":"2026-08-05T01:55:33Z","registered":"2026-08-05T01:55:34Z","published":null,"updated":"2026-08-07T02:22:09Z"},"relationships":{"client":{"data":{"id":"arxiv.content","type":"clients"}}}},{"id":"10.48550/arxiv.2608.02659","type":"dois","attributes":{"doi":"10.48550/arxiv.2608.02659","identifiers":[{"identifier":"2608.02659","identifierType":"arXiv"}],"creators":[{"nameType":"Personal","givenName":"Abdullah","familyName":"Guvendi","name":"Guvendi, Abdullah","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Hassan","familyName":"Hassanabadi","name":"Hassanabadi, Hassan","affiliation":[],"nameIdentifiers":[]}],"titles":[{"title":"Curvature as a control field in helicoidal two-body systems"}],"publisher":"arXiv","container":{},"publicationYear":2026,"subjects":[{"subject":"Quantum Physics (quant-ph)","lang":"en","subjectScheme":"arXiv"},{"subject":"FOS: Physical sciences","subjectScheme":"Fields of Science and Technology (FOS)"}],"contributors":[],"dates":[{"date":"2026-08-01T13:27:50Z","dateType":"Submitted","dateInformation":"v1"},{"date":"2026-08-05T00:01:07Z","dateType":"Updated","dateInformation":"v1"},{"date":"2026-08-06T14:04:33Z","dateType":"Submitted","dateInformation":"v2"},{"date":"2026-08-07T00:51:18Z","dateType":"Updated","dateInformation":"v2"},{"date":"2026-08","dateType":"Available","dateInformation":"v1"}],"language":null,"types":{"schemaOrg":"CreativeWork","resourceTypeGeneral":"Preprint","citeproc":"article","bibtex":"misc","ris":"GEN","resourceType":"Article"},"relatedIdentifiers":[],"relatedItems":[],"sizes":[],"formats":[],"version":"2","rightsList":[{"rightsIdentifierScheme":"SPDX","rightsUri":"https://creativecommons.org/licenses/by/4.0/legalcode","schemeUri":"https://spdx.org/licenses/","rights":"Creative Commons Attribution 4.0 International","rightsIdentifier":"cc-by-4.0"}],"descriptions":[{"descriptionType":"Abstract","description":"Geometry is increasingly recognized as an active physical resource capable of modifying the behavior of dynamical systems beyond conventional external control mechanisms. Here, we develop a curvature--gauge framework in which the geometry of an embedded manifold acts as a tunable control parameter for classical trajectories and semiclassical states. By deriving an exact reduced Hamiltonian for a charged two-body system confined to a helicoidal surface, we show that curvature modifies the effective kinetic structure, while the projected gauge field reshapes the conserved momentum landscape. This geometric modification leads to controllable transitions between distinct dynamical regimes, including bounded phase-space structures, zero-energy localization, symmetry-breaking bifurcations, and critical soft-mode behavior. A semiclassical analysis of the geometry-dependent effective potential reveals a spectral reconstruction in which harmonic confinement changes into quartic critical behavior at the localization threshold. These results establish engineered geometry as a route for controlling localization, dynamical stability, and spectral organization in curved classical and semiclassical systems, where deformation itself becomes a functional degree of freedom rather than a passive constraint."},{"descriptionType":"Other","description":"10 pages, 4 figures"}],"geoLocations":[],"fundingReferences":[],"url":"https://arxiv.org/abs/2608.02659","contentUrl":null,"metadataVersion":1,"schemaVersion":"http://datacite.org/schema/kernel-4","source":"mds","isActive":true,"state":"findable","reason":null,"viewCount":0,"downloadCount":0,"referenceCount":0,"citationCount":0,"partCount":0,"partOfCount":0,"versionCount":0,"versionOfCount":0,"created":"2026-08-05T01:54:54Z","registered":"2026-08-05T01:54:55Z","published":null,"updated":"2026-08-07T02:22:08Z"},"relationships":{"client":{"data":{"id":"arxiv.content","type":"clients"}}}},{"id":"10.48550/arxiv.2608.02616","type":"dois","attributes":{"doi":"10.48550/arxiv.2608.02616","identifiers":[{"identifier":"2608.02616","identifierType":"arXiv"}],"creators":[{"nameType":"Personal","givenName":"Rohith","familyName":"Uppala","name":"Uppala, Rohith","affiliation":[],"nameIdentifiers":[]}],"titles":[{"title":"OpenAI Privacy Filter: A Cross-Lingual, Cross-Domain PII Evaluation Across 32 Benchmarks"}],"publisher":"arXiv","container":{},"publicationYear":2026,"subjects":[{"subject":"Computation and Language (cs.CL)","lang":"en","subjectScheme":"arXiv"},{"subject":"Artificial Intelligence (cs.AI)","lang":"en","subjectScheme":"arXiv"},{"subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"}],"contributors":[],"dates":[{"date":"2026-05-23T16:59:01Z","dateType":"Submitted","dateInformation":"v1"},{"date":"2026-08-05T00:00:19Z","dateType":"Updated","dateInformation":"v1"},{"date":"2026-08-06T01:11:59Z","dateType":"Submitted","dateInformation":"v2"},{"date":"2026-08-07T00:15:54Z","dateType":"Updated","dateInformation":"v2"},{"date":"2026-08","dateType":"Available","dateInformation":"v1"}],"language":null,"types":{"schemaOrg":"CreativeWork","resourceTypeGeneral":"Preprint","citeproc":"article","bibtex":"misc","ris":"GEN","resourceType":"Article"},"relatedIdentifiers":[],"relatedItems":[],"sizes":[],"formats":[],"version":"2","rightsList":[{"rightsIdentifierScheme":"SPDX","rightsUri":"https://creativecommons.org/licenses/by/4.0/legalcode","schemeUri":"https://spdx.org/licenses/","rights":"Creative Commons Attribution 4.0 International","rightsIdentifier":"cc-by-4.0"}],"descriptions":[{"descriptionType":"Abstract","description":"We present what is, to our knowledge, the first systematic evaluation of OpenAI's Privacy Filter (OPF), a 1.5B-parameter model that converts an autoregressive language model into a bidirectional PII detector, across 32 benchmarks spanning 14 languages and 5 domains. Our most practically actionable finding is a domain-dependent labeled-data crossover: fine-tuned XLM-RoBERTa surpasses OPF's zero-shot performance with only ~500 labeled examples on English synthetic PII (~100 on non-English Kiji), and ~1000 on synthetic medical PII. Crucially, per-class fine-tuning (17 PII entity types, a subset of OPF's 33) is less data-efficient than binary labels at small n -- at n=100, binary F1=0.634 vs. per-class 0.360. Zero-shot, OPF achieves F1=0.464 on the SPY medical benchmark and F1=0.855 on AI4Privacy, substantially outperforming Presidio and XLM-RoBERTa-large-NER. However, OPF degrades sharply outside its PII training distribution: F1=0.04--0.40 on general NER benchmarks and collapses for non-Latin scripts (Arabic: 0.04, Cyrillic: 0.03). Error analysis reveals OPF excels on structurally regular PII (email: 0.78, phone: 0.76) but struggles with culturally variable entities (person names: 0.40, addresses: 0.49), and is recall-biased across most PII domains (precision 0.31--0.54, recall 0.70--0.85). We provide a decision heuristic for when to use OPF zero-shot, when to fine-tune XLM-RoBERTa, and which language families to avoid."},{"descriptionType":"Other","description":"9 pages, 2 figures, 9 tables; evaluation of a production PII detection system"}],"geoLocations":[],"fundingReferences":[],"url":"https://arxiv.org/abs/2608.02616","contentUrl":null,"metadataVersion":1,"schemaVersion":"http://datacite.org/schema/kernel-4","source":"mds","isActive":true,"state":"findable","reason":null,"viewCount":0,"downloadCount":0,"referenceCount":0,"citationCount":0,"partCount":0,"partOfCount":0,"versionCount":0,"versionOfCount":0,"created":"2026-08-05T01:53:54Z","registered":"2026-08-05T01:53:54Z","published":null,"updated":"2026-08-07T02:22:07Z"},"relationships":{"client":{"data":{"id":"arxiv.content","type":"clients"}}}},{"id":"10.48550/arxiv.2608.03991","type":"dois","attributes":{"doi":"10.48550/arxiv.2608.03991","identifiers":[{"identifier":"2608.03991","identifierType":"arXiv"}],"creators":[{"nameType":"Personal","givenName":"Wanli","familyName":"Ma","name":"Ma, Wanli","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Jiangwen","familyName":"Lu","name":"Lu, Jiangwen","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Qinmu","familyName":"Peng","name":"Peng, Qinmu","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Xinge","familyName":"You","name":"You, Xinge","affiliation":[],"nameIdentifiers":[]}],"titles":[{"title":"Perceptual Anchoring: Prototype-Guided Text Calibration for Training-free Open-Vocabulary Semantic Segmentation"}],"publisher":"arXiv","container":{},"publicationYear":2026,"subjects":[{"subject":"Computer Vision and Pattern Recognition (cs.CV)","lang":"en","subjectScheme":"arXiv"},{"subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"}],"contributors":[],"dates":[{"date":"2026-08-04T17:52:13Z","dateType":"Submitted","dateInformation":"v1"},{"date":"2026-08-05T01:09:24Z","dateType":"Updated","dateInformation":"v1"},{"date":"2026-08-05T12:56:40Z","dateType":"Submitted","dateInformation":"v2"},{"date":"2026-08-06T00:45:12Z","dateType":"Updated","dateInformation":"v2"},{"date":"2026-08","dateType":"Available","dateInformation":"v1"}],"language":null,"types":{"schemaOrg":"CreativeWork","resourceTypeGeneral":"Preprint","citeproc":"article","bibtex":"misc","ris":"GEN","resourceType":"Article"},"relatedIdentifiers":[],"relatedItems":[],"sizes":[],"formats":[],"version":"2","rightsList":[{"rightsUri":"http://arxiv.org/licenses/nonexclusive-distrib/1.0/","rights":"arXiv.org perpetual, non-exclusive license"}],"descriptions":[{"descriptionType":"Abstract","description":"Training-free open-vocabulary semantic segmentation (OVSS) partitions an image into semantically distinct regions based on arbitrary text descriptions, without learning any additional parameters. However, existing methods typically focus on improving visual representations while treating text embeddings that encode only generic category concepts as fixed classification references. The resulting semantic gap between these generic concepts and the visual representations that capture the specific appearances of target instances often causes incomplete masks and erroneous predictions in non-target regions. Inspired by the symbol-percept correspondence underlying perceptual anchoring, we propose Prototype-Guided Text Calibration (PTC) for training-free OVSS. In the Perceiving stage, PTC selects reliable visual evidence based on initial matching scores to construct category-specific visual prototypes. In the Anchoring stage, PTC uses these prototypes to calibrate their corresponding text embeddings, with the calibration strength adaptively adjusted based on the amount of visual evidence. Consequently, the calibrated text embeddings align more accurately with instance-specific visual representations while preserving generic category semantics and open-vocabulary generalization. Moreover, PTC requires neither additional training nor external models and can serve as a plug-and-play module for existing methods. Extensive experiments across eight benchmarks show that PTC significantly enhances the performance of six representative methods and yields more complete and accurate segmentation results. These results validate PTC as a simple and effective approach to improving visual-text alignment."},{"descriptionType":"Other","description":"17 pages, 5 figures"}],"geoLocations":[],"fundingReferences":[],"url":"https://arxiv.org/abs/2608.03991","contentUrl":null,"metadataVersion":1,"schemaVersion":"http://datacite.org/schema/kernel-4","source":"mds","isActive":true,"state":"findable","reason":null,"viewCount":0,"downloadCount":0,"referenceCount":0,"citationCount":0,"partCount":0,"partOfCount":0,"versionCount":0,"versionOfCount":0,"created":"2026-08-05T02:25:39Z","registered":"2026-08-05T02:25:40Z","published":null,"updated":"2026-08-06T02:22:11Z"},"relationships":{"client":{"data":{"id":"arxiv.content","type":"clients"}}}},{"id":"10.48550/arxiv.2608.03987","type":"dois","attributes":{"doi":"10.48550/arxiv.2608.03987","identifiers":[{"identifier":"2608.03987","identifierType":"arXiv"}],"creators":[{"nameType":"Personal","givenName":"Yusheng","familyName":"Zhao","name":"Zhao, Yusheng","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Xiwei","familyName":"Pan","name":"Pan, Xiwei","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Enji","familyName":"Xiong","name":"Xiong, Enji","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Chengkai","familyName":"Zhu","name":"Zhu, Chengkai","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Jinguo","familyName":"Liu","name":"Liu, Jinguo","affiliation":[],"nameIdentifiers":[]}],"titles":[{"title":"Realified tensor networks: quantum circuit simulation on real-valued matrix accelerators"}],"publisher":"arXiv","container":{},"publicationYear":2026,"subjects":[{"subject":"Quantum Physics (quant-ph)","lang":"en","subjectScheme":"arXiv"},{"subject":"FOS: Physical sciences","subjectScheme":"Fields of Science and Technology (FOS)"}],"contributors":[],"dates":[{"date":"2026-08-04T17:51:06Z","dateType":"Submitted","dateInformation":"v1"},{"date":"2026-08-05T01:09:17Z","dateType":"Updated","dateInformation":"v1"},{"date":"2026-08-05T11:13:28Z","dateType":"Submitted","dateInformation":"v2"},{"date":"2026-08-06T00:39:50Z","dateType":"Updated","dateInformation":"v2"},{"date":"2026-08","dateType":"Available","dateInformation":"v1"}],"language":null,"types":{"schemaOrg":"CreativeWork","resourceTypeGeneral":"Preprint","citeproc":"article","bibtex":"misc","ris":"GEN","resourceType":"Article"},"relatedIdentifiers":[],"relatedItems":[],"sizes":[],"formats":[],"version":"2","rightsList":[{"rightsUri":"http://arxiv.org/licenses/nonexclusive-distrib/1.0/","rights":"arXiv.org perpetual, non-exclusive license"}],"descriptions":[{"descriptionType":"Abstract","description":"Tensor-network contraction simulates quantum circuits, but modern matrix accelerators (NPUs, TPUs) expose only real GEMM pipelines, so the complex networks of quantum simulation must be reconstructed in software. We resolve the mismatch by a realification rewrite that maps any complex tensor network to a real one. At each merge of two complex tensors, a rank-3 structure tensor realizes Gauss's three-multiplication (3M) formula; contractions with one or no complex operand need only two or one real products. We prove a tight cost law: overhead $1 + 2m + r$ in real multiplications, where $m$ and $r$ are the volume fractions of two- and one-complex-operand contractions, never exceeding $3\\times$ relative to real contraction, with every intermediate at most doubled in size. On 67 circuits (random, Clifford+$T$, QAOA, VQE), the law holds across the real-to-complex range and complex-gate placement, not count, governs cost. Contraction orders transfer from the complex network with a relative arithmetic-cost gap below $5\\times 10^{-4}$ on 66 of 67 circuits; the exception closes under a few steps of low-temperature simulated annealing. On an Ascend 910 NPU the rewrite beat both the four-real-GEMM baseline and a per-GEMM Gauss lowering on all twelve random circuits and on 52 of 55 structured cells (three cells slower by at most 12\\%); the four-GEMM baseline was slower by a median $1.7\\times$ (random) and $1.4\\times$ (structured). Realification makes complex tensor-network contraction native to real-only matrix engines."}],"geoLocations":[],"fundingReferences":[],"url":"https://arxiv.org/abs/2608.03987","contentUrl":null,"metadataVersion":1,"schemaVersion":"http://datacite.org/schema/kernel-4","source":"mds","isActive":true,"state":"findable","reason":null,"viewCount":0,"downloadCount":0,"referenceCount":0,"citationCount":0,"partCount":0,"partOfCount":0,"versionCount":0,"versionOfCount":0,"created":"2026-08-05T02:25:34Z","registered":"2026-08-05T02:25:35Z","published":null,"updated":"2026-08-06T02:22:10Z"},"relationships":{"client":{"data":{"id":"arxiv.content","type":"clients"}}}},{"id":"10.48550/arxiv.2608.03982","type":"dois","attributes":{"doi":"10.48550/arxiv.2608.03982","identifiers":[{"identifier":"2608.03982","identifierType":"arXiv"}],"creators":[{"nameType":"Personal","givenName":"Sebastian","familyName":"Boldt","name":"Boldt, Sebastian","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Batu","familyName":"Güneysu","name":"Güneysu, Batu","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Maxime","familyName":"Marot","name":"Marot, Maxime","affiliation":[],"nameIdentifiers":[]}],"titles":[{"title":"Analysis on surfaces with locally bounded integral curvature"}],"publisher":"arXiv","container":{},"publicationYear":2026,"subjects":[{"subject":"Differential Geometry (math.DG)","lang":"en","subjectScheme":"arXiv"},{"subject":"Metric Geometry (math.MG)","lang":"en","subjectScheme":"arXiv"},{"subject":"FOS: Mathematics","subjectScheme":"Fields of Science and Technology (FOS)"},{"subject":"46E36, 35K08, 53C23","lang":"en","subjectScheme":"MSC"}],"contributors":[],"dates":[{"date":"2026-08-04T17:46:20Z","dateType":"Submitted","dateInformation":"v1"},{"date":"2026-08-05T01:09:08Z","dateType":"Updated","dateInformation":"v1"},{"date":"2026-08-05T13:10:22Z","dateType":"Submitted","dateInformation":"v2"},{"date":"2026-08-06T00:45:54Z","dateType":"Updated","dateInformation":"v2"},{"date":"2026-08","dateType":"Available","dateInformation":"v1"}],"language":null,"types":{"schemaOrg":"CreativeWork","resourceTypeGeneral":"Preprint","citeproc":"article","bibtex":"misc","ris":"GEN","resourceType":"Article"},"relatedIdentifiers":[],"relatedItems":[],"sizes":[],"formats":[],"version":"2","rightsList":[{"rightsIdentifierScheme":"SPDX","rightsUri":"https://creativecommons.org/licenses/by-nc-sa/4.0/legalcode","schemeUri":"https://spdx.org/licenses/","rights":"Creative Commons Attribution Non Commercial Share Alike 4.0 International","rightsIdentifier":"cc-by-nc-sa-4.0"}],"descriptions":[{"descriptionType":"Abstract","description":"We prove several analytic results on (possibly noncompact) complete singular surfaces having locally bounded integral curvature (in short: BIC surfaces). Regarding these as metric measure spaces with the 2-dimensional Hausdorff measure, we show that these are infinitesimally Hilbertian, locally doubling and satisfy a local Poincaré inequality. In particular, this entails the existence of a jointly Hölder continuous heat kernel for the Cheeger Laplacian. Assuming that the negative part of the curvature measure of a BIC surface satisfies a Dynkin-type condition, we show that the surface is bi-Lipschitz equivalent to a BIC surface with a lower bounded curvature measure, entailing global variants of the aforementioned results."}],"geoLocations":[],"fundingReferences":[],"url":"https://arxiv.org/abs/2608.03982","contentUrl":null,"metadataVersion":1,"schemaVersion":"http://datacite.org/schema/kernel-4","source":"mds","isActive":true,"state":"findable","reason":null,"viewCount":0,"downloadCount":0,"referenceCount":0,"citationCount":0,"partCount":0,"partOfCount":0,"versionCount":0,"versionOfCount":0,"created":"2026-08-05T02:25:27Z","registered":"2026-08-05T02:25:28Z","published":null,"updated":"2026-08-06T02:22:09Z"},"relationships":{"client":{"data":{"id":"arxiv.content","type":"clients"}}}},{"id":"10.48550/arxiv.2608.03943","type":"dois","attributes":{"doi":"10.48550/arxiv.2608.03943","identifiers":[{"identifier":"2608.03943","identifierType":"arXiv"}],"creators":[{"nameType":"Personal","givenName":"A. C.","familyName":"Larsen","name":"Larsen, A. C.","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"M.","familyName":"Guttormsen","name":"Guttormsen, M.","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"T. K.","familyName":"Eriksen","name":"Eriksen, T. K.","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"G. M.","familyName":"Tveten","name":"Tveten, G. M.","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"H.","familyName":"Utsunomiya","name":"Utsunomiya, H.","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"J. K.","familyName":"Dahl","name":"Dahl, J. K.","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"N.","familyName":"Shimizu","name":"Shimizu, N.","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"T.","familyName":"Ari-izumi","name":"Ari-izumi, T.","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"F. L. Bello","familyName":"Garrote","name":"Garrote, F. L. Bello","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"L. T.","familyName":"Bell","name":"Bell, L. T.","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"M. M.","familyName":"Bjørøen","name":"Bjørøen, M. M.","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"F. W.","familyName":"Furmyr","name":"Furmyr, F. W.","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"D.","familyName":"Gjestvang","name":"Gjestvang, D.","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"A.","familyName":"Görgen","name":"Görgen, A.","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"V. W.","familyName":"Ingeberg","name":"Ingeberg, V. W.","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"K. C. W.","familyName":"Li","name":"Li, K. C. W.","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"E.","familyName":"Lima","name":"Lima, E.","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"M.","familyName":"Markova","name":"Markova, M.","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"E. F.","familyName":"Matthews","name":"Matthews, E. F.","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"A. H.","familyName":"Mjøs","name":"Mjøs, A. H.","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"S.","familyName":"Miyamoto","name":"Miyamoto, S.","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"V.","familyName":"Modamio","name":"Modamio, V.","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"T.","familyName":"Renstrøm","name":"Renstrøm, T.","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"E.","familyName":"Sahin","name":"Sahin, E.","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"S.","familyName":"Siem","name":"Siem, S.","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"M.","familyName":"Wiedeking","name":"Wiedeking, M.","affiliation":[],"nameIdentifiers":[]}],"titles":[{"title":"Statistical and non-statistical $γ$-decay properties of $^{64}$Zn"}],"publisher":"arXiv","container":{},"publicationYear":2026,"subjects":[{"subject":"Nuclear Experiment (nucl-ex)","lang":"en","subjectScheme":"arXiv"},{"subject":"Nuclear Theory (nucl-th)","lang":"en","subjectScheme":"arXiv"},{"subject":"FOS: Physical sciences","subjectScheme":"Fields of Science and Technology (FOS)"}],"contributors":[],"dates":[{"date":"2026-08-04T17:11:08Z","dateType":"Submitted","dateInformation":"v1"},{"date":"2026-08-05T01:07:06Z","dateType":"Updated","dateInformation":"v1"},{"date":"2026-08-05T11:26:44Z","dateType":"Submitted","dateInformation":"v2"},{"date":"2026-08-06T00:40:29Z","dateType":"Updated","dateInformation":"v2"},{"date":"2026-08","dateType":"Available","dateInformation":"v1"}],"language":null,"types":{"schemaOrg":"CreativeWork","resourceTypeGeneral":"Preprint","citeproc":"article","bibtex":"misc","ris":"GEN","resourceType":"Article"},"relatedIdentifiers":[],"relatedItems":[],"sizes":[],"formats":[],"version":"2","rightsList":[{"rightsUri":"http://arxiv.org/licenses/nonexclusive-distrib/1.0/","rights":"arXiv.org perpetual, non-exclusive license"}],"descriptions":[{"descriptionType":"Abstract","description":"We present a study on the $γ$-decay properties of $^{64}$Zn using the Oslo method on $^{64}$Zn($p,p^\\prime γ$) data combined with $^{64}$Zn$(γ,n)$ cross-section measurements at the NewSUBARU facility. With the Oslo method, we have measured the $γ$-ray strength function ($γ$SF) and the nuclear level density (NLD) below the neutron threshold. We observe that the NLD trend in the quasi-continuum region of $^{64}$Zn is best characterized by a constant-temperature-like model. %with temperature parameter $T_{\\rm CT}=1.21(5)$ MeV. Surprisingly, we find that $γ$-ray transitions from the quasi-continuum decaying directly to the $0^+$ ground state seem to be strongly hindered with a hindrance factor of $κ\\approx 0.5$, which could be an indication of non-statistical effects in the ground-state decay due to, \\textit{e.g.}, differences in nuclear shapes. For $γ$ energies above the neutron separation energy, the NewSUBARU ($γ, n$) data set probes a significant part of the giant dipole resonance. Furthermore, we find that the Oslo-method $γ$SF shows a rather smooth behavior, with a clear low-energy enhancement (LEE) for $E_γ \u0026lt; 4$ MeV."},{"descriptionType":"Other","description":"19 pages, 24 figures, submitted to Phys. Rev. C"}],"geoLocations":[],"fundingReferences":[],"url":"https://arxiv.org/abs/2608.03943","contentUrl":null,"metadataVersion":1,"schemaVersion":"http://datacite.org/schema/kernel-4","source":"mds","isActive":true,"state":"findable","reason":null,"viewCount":0,"downloadCount":0,"referenceCount":0,"citationCount":0,"partCount":0,"partOfCount":0,"versionCount":0,"versionOfCount":0,"created":"2026-08-05T02:24:33Z","registered":"2026-08-05T02:24:34Z","published":null,"updated":"2026-08-06T02:22:08Z"},"relationships":{"client":{"data":{"id":"arxiv.content","type":"clients"}}}},{"id":"10.48550/arxiv.2608.03928","type":"dois","attributes":{"doi":"10.48550/arxiv.2608.03928","identifiers":[{"identifier":"2608.03928","identifierType":"arXiv"}],"creators":[{"nameType":"Personal","givenName":"HanQin","familyName":"Cai","name":"Cai, HanQin","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Longxiu","familyName":"Huang","name":"Huang, Longxiu","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Jing","familyName":"Qin","name":"Qin, Jing","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Chengyue","familyName":"Wu","name":"Wu, Chengyue","affiliation":[],"nameIdentifiers":[]}],"titles":[{"title":"Robust Low-Tubal-Rank Tensor Completion under Cross-Concentrated Sampling"}],"publisher":"arXiv","container":{},"publicationYear":2026,"subjects":[{"subject":"Machine Learning (stat.ML)","lang":"en","subjectScheme":"arXiv"},{"subject":"Information Theory (cs.IT)","lang":"en","subjectScheme":"arXiv"},{"subject":"Machine Learning (cs.LG)","lang":"en","subjectScheme":"arXiv"},{"subject":"Numerical Analysis (math.NA)","lang":"en","subjectScheme":"arXiv"},{"subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"},{"subject":"FOS: Mathematics","subjectScheme":"Fields of Science and Technology (FOS)"}],"contributors":[],"dates":[{"date":"2026-08-04T16:59:58Z","dateType":"Submitted","dateInformation":"v1"},{"date":"2026-08-05T01:06:24Z","dateType":"Updated","dateInformation":"v1"},{"date":"2026-08-05T01:23:20Z","dateType":"Submitted","dateInformation":"v2"},{"date":"2026-08-06T00:15:56Z","dateType":"Updated","dateInformation":"v2"},{"date":"2026-08","dateType":"Available","dateInformation":"v1"}],"language":null,"types":{"schemaOrg":"CreativeWork","resourceTypeGeneral":"Preprint","citeproc":"article","bibtex":"misc","ris":"GEN","resourceType":"Article"},"relatedIdentifiers":[],"relatedItems":[],"sizes":[],"formats":[],"version":"2","rightsList":[{"rightsUri":"http://arxiv.org/licenses/nonexclusive-distrib/1.0/","rights":"arXiv.org perpetual, non-exclusive license"}],"descriptions":[{"descriptionType":"Abstract","description":"Tensor cross-concentrated sampling (t-CCS) bridges entrywise sampling and t-CUR slice-wise sampling by observing entries only within selected horizontal and lateral slices. Existing t-CCS completion methods, however, assume that the observations are free of gross corruption. In this work, we study robust recovery of a third-order low-tubal-rank tensor from partial t-CCS observations contaminated by sparse, arbitrarily large outliers. We propose Robust Iterative t-CUR (R-ItCUR), a tensor-native algorithm that partitions the sampled tensor cross into two exterior blocks and an intersection block, applies adaptive blockwise Welsch correction for outlier suppression, and updates the low-rank component through projected blockwise gradient descent. By operating directly on the sampled cross, R-ItCUR avoids reconstructing the full tensor throughout the iterations, resulting in substantial memory and computational savings. Experiments on synthetic tensors, cardiac MRI data, and three-dimensional seismic data demonstrate accurate recovery and strong robustness to sparse gross corruptions. The results further highlight the importance of explicitly exploiting the cross-concentrated sampling structure in robust tensor completion."}],"geoLocations":[],"fundingReferences":[],"url":"https://arxiv.org/abs/2608.03928","contentUrl":null,"metadataVersion":1,"schemaVersion":"http://datacite.org/schema/kernel-4","source":"mds","isActive":true,"state":"findable","reason":null,"viewCount":0,"downloadCount":0,"referenceCount":0,"citationCount":0,"partCount":0,"partOfCount":0,"versionCount":0,"versionOfCount":0,"created":"2026-08-05T02:24:12Z","registered":"2026-08-05T02:24:13Z","published":null,"updated":"2026-08-06T02:22:07Z"},"relationships":{"client":{"data":{"id":"arxiv.content","type":"clients"}}}},{"id":"10.48550/arxiv.2608.03905","type":"dois","attributes":{"doi":"10.48550/arxiv.2608.03905","identifiers":[{"identifier":"2608.03905","identifierType":"arXiv"}],"creators":[{"nameType":"Personal","givenName":"Sigmundur","familyName":"Gudmundsson","name":"Gudmundsson, Sigmundur","affiliation":[],"nameIdentifiers":[]}],"titles":[{"title":"New Complex-Valued Harmonic Morphisms via Rational Exponents"}],"publisher":"arXiv","container":{},"publicationYear":2026,"subjects":[{"subject":"Differential Geometry (math.DG)","lang":"en","subjectScheme":"arXiv"},{"subject":"FOS: Mathematics","subjectScheme":"Fields of Science and Technology (FOS)"},{"subject":"53C35, 53C43, 58E20","lang":"en","subjectScheme":"MSC"}],"contributors":[],"dates":[{"date":"2026-08-04T16:30:20Z","dateType":"Submitted","dateInformation":"v1"},{"date":"2026-08-05T01:04:42Z","dateType":"Updated","dateInformation":"v1"},{"date":"2026-08-05T16:16:37Z","dateType":"Submitted","dateInformation":"v2"},{"date":"2026-08-06T00:58:07Z","dateType":"Updated","dateInformation":"v2"},{"date":"2026-08","dateType":"Available","dateInformation":"v1"}],"language":null,"types":{"schemaOrg":"CreativeWork","resourceTypeGeneral":"Preprint","citeproc":"article","bibtex":"misc","ris":"GEN","resourceType":"Article"},"relatedIdentifiers":[],"relatedItems":[],"sizes":[],"formats":[],"version":"2","rightsList":[{"rightsUri":"http://arxiv.org/licenses/nonexclusive-distrib/1.0/","rights":"arXiv.org perpetual, non-exclusive license"}],"descriptions":[{"descriptionType":"Abstract","description":"The method of complex-valued eigenfamilies has been used to solve difficult non-linear problems in differential geometry. The purpose of this note is to generalise the construction method from the use of polynomial solutions to those obtained by rational exponents. This gives many new solutions to the problem under investigation."}],"geoLocations":[],"fundingReferences":[],"url":"https://arxiv.org/abs/2608.03905","contentUrl":null,"metadataVersion":1,"schemaVersion":"http://datacite.org/schema/kernel-4","source":"mds","isActive":true,"state":"findable","reason":null,"viewCount":0,"downloadCount":0,"referenceCount":0,"citationCount":0,"partCount":0,"partOfCount":0,"versionCount":0,"versionOfCount":0,"created":"2026-08-05T02:23:41Z","registered":"2026-08-05T02:23:42Z","published":null,"updated":"2026-08-06T02:22:06Z"},"relationships":{"client":{"data":{"id":"arxiv.content","type":"clients"}}}},{"id":"10.48550/arxiv.2608.03891","type":"dois","attributes":{"doi":"10.48550/arxiv.2608.03891","identifiers":[{"identifier":"2608.03891","identifierType":"arXiv"}],"creators":[{"nameType":"Personal","givenName":"Vikram","familyName":"Aithal","name":"Aithal, Vikram","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Ajit","familyName":"Kumar","name":"Kumar, Ajit","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Ambika","familyName":"Sharma","name":"Sharma, Ambika","affiliation":[],"nameIdentifiers":[]}],"titles":[{"title":"Topological Clustering via Sliced Wasserstien Kernels"}],"publisher":"arXiv","container":{},"publicationYear":2026,"subjects":[{"subject":"Statistics Theory (math.ST)","lang":"en","subjectScheme":"arXiv"},{"subject":"Algebraic Topology (math.AT)","lang":"en","subjectScheme":"arXiv"},{"subject":"FOS: Mathematics","subjectScheme":"Fields of Science and Technology (FOS)"},{"subject":"62R40","lang":"en","subjectScheme":"MSC"}],"contributors":[],"dates":[{"date":"2026-08-04T16:24:41Z","dateType":"Submitted","dateInformation":"v1"},{"date":"2026-08-05T01:04:22Z","dateType":"Updated","dateInformation":"v1"},{"date":"2026-08-05T12:00:28Z","dateType":"Submitted","dateInformation":"v2"},{"date":"2026-08-06T00:42:14Z","dateType":"Updated","dateInformation":"v2"},{"date":"2026-08","dateType":"Available","dateInformation":"v1"}],"language":null,"types":{"schemaOrg":"CreativeWork","resourceTypeGeneral":"Preprint","citeproc":"article","bibtex":"misc","ris":"GEN","resourceType":"Article"},"relatedIdentifiers":[],"relatedItems":[],"sizes":[],"formats":[],"version":"2","rightsList":[{"rightsUri":"http://arxiv.org/licenses/nonexclusive-distrib/1.0/","rights":"arXiv.org perpetual, non-exclusive license"}],"descriptions":[{"descriptionType":"Abstract","description":"Topological data analysis (TDA) uses topological techniques to extract meaningful shape-based information from complex datasets. Clustering is a central problem in data analysis, and there has been considerable recent interest in understanding how TDA can inform it. Existing approaches either cluster persistence diagrams directly under Wasserstein-type distances, which is computationally expensive, or use vector representations of diagrams. We propose a kernel $k$-means algorithm built on a convex combination of sliced Wasserstein (SW) kernels, one for each homology under consideration. Unlike other vector representations of persistence diagrams, the SW kernel is both stable and discriminative with respect to the $1$-Wasserstein distance. The method outperforms the baselines on two benchmark datasets and remains competitive on a third synthetic dataset, while being computationally efficient. It also outperforms both a single SW kernel on the union of all homology groups and an SW kernel computed directly on the point clouds. The convex combination assigns an interpretable weight to each $q$-homology kernel. We further validate that the weights identify the discriminating homology."},{"descriptionType":"Other","description":"20 Pages, 5 figures"}],"geoLocations":[],"fundingReferences":[],"url":"https://arxiv.org/abs/2608.03891","contentUrl":null,"metadataVersion":1,"schemaVersion":"http://datacite.org/schema/kernel-4","source":"mds","isActive":true,"state":"findable","reason":null,"viewCount":0,"downloadCount":0,"referenceCount":0,"citationCount":0,"partCount":0,"partOfCount":0,"versionCount":0,"versionOfCount":0,"created":"2026-08-05T02:23:22Z","registered":"2026-08-05T02:23:23Z","published":null,"updated":"2026-08-06T02:22:05Z"},"relationships":{"client":{"data":{"id":"arxiv.content","type":"clients"}}}},{"id":"10.48550/arxiv.2608.03888","type":"dois","attributes":{"doi":"10.48550/arxiv.2608.03888","identifiers":[{"identifier":"2608.03888","identifierType":"arXiv"}],"creators":[{"nameType":"Organizational","name":"NOvA Collaboration","affiliation":[],"nameIdentifiers":[]}],"titles":[{"title":"Timing-Based Search for Magnetic Monopoles with the NOvA Detector on the Surface"}],"publisher":"arXiv","container":{},"publicationYear":2026,"subjects":[{"subject":"High Energy Physics - Experiment (hep-ex)","lang":"en","subjectScheme":"arXiv"},{"subject":"FOS: Physical sciences","subjectScheme":"Fields of Science and Technology (FOS)"}],"contributors":[],"dates":[{"date":"2026-08-04T16:23:09Z","dateType":"Submitted","dateInformation":"v1"},{"date":"2026-08-06T01:01:28Z","dateType":"Updated","dateInformation":"v1"},{"date":"2026-08","dateType":"Available","dateInformation":"v1"}],"language":null,"types":{"schemaOrg":"CreativeWork","resourceTypeGeneral":"Preprint","citeproc":"article","bibtex":"misc","ris":"GEN","resourceType":"Article"},"relatedIdentifiers":[{"relationType":"IsVersionOf","relatedIdentifier":"10.5281/zenodo.21811524","relatedIdentifierType":"DOI"}],"relatedItems":[],"sizes":[],"formats":[],"version":"1","rightsList":[{"rightsIdentifierScheme":"SPDX","rightsUri":"https://creativecommons.org/licenses/by/4.0/legalcode","schemeUri":"https://spdx.org/licenses/","rights":"Creative Commons Attribution 4.0 International","rightsIdentifier":"cc-by-4.0"}],"descriptions":[{"descriptionType":"Abstract","description":"We report a search for a magnetic monopole component of the cosmic-ray flux in a 2743-live-day exposure of the NOvA experiment's Far Detector, a 14 kt segmented liquid scintillator detector designed primarily to observe GeV-scale electron neutrinos. No events consistent with monopoles were observed, setting an upper limit on the flux of $8\\times 10^{-16}~\\mathrm{cm^{-2}s^{-1}sr^{-1}}$ at 90% C.L. for monopole speed $6\\times 10^{-4} \u0026lt; β\u0026lt; 5\\times 10^{-3}$ and mass greater than $10^{9}$ GeV. Because of NOvA's small overburden of 3 meters-water equivalent, this constraint covers a previously unexplored low-mass region."},{"descriptionType":"Other","description":"8 pages, 9 figures"}],"geoLocations":[],"fundingReferences":[],"url":"https://arxiv.org/abs/2608.03888","contentUrl":null,"metadataVersion":1,"schemaVersion":"http://datacite.org/schema/kernel-4","source":"mds","isActive":true,"state":"findable","reason":null,"viewCount":0,"downloadCount":0,"referenceCount":0,"citationCount":0,"partCount":0,"partOfCount":0,"versionCount":0,"versionOfCount":1,"created":"2026-08-05T02:23:18Z","registered":"2026-08-05T02:23:19Z","published":null,"updated":"2026-08-06T02:22:04Z"},"relationships":{"client":{"data":{"id":"arxiv.content","type":"clients"}}}},{"id":"10.48550/arxiv.2608.03869","type":"dois","attributes":{"doi":"10.48550/arxiv.2608.03869","identifiers":[{"identifier":"2608.03869","identifierType":"arXiv"}],"creators":[{"nameType":"Personal","givenName":"Jie","familyName":"Jiang","name":"Jiang, Jie","affiliation":[],"nameIdentifiers":[]}],"titles":[{"title":"An Explicit Logistic Damping Criterion for Boundedness in a Fully Parabolic Keller--Segel System"}],"publisher":"arXiv","container":{},"publicationYear":2026,"subjects":[{"subject":"Analysis of PDEs (math.AP)","lang":"en","subjectScheme":"arXiv"},{"subject":"FOS: Mathematics","subjectScheme":"Fields of Science and Technology (FOS)"}],"contributors":[],"dates":[{"date":"2026-08-04T16:09:11Z","dateType":"Submitted","dateInformation":"v1"},{"date":"2026-08-05T01:03:21Z","dateType":"Updated","dateInformation":"v1"},{"date":"2026-08-05T04:17:04Z","dateType":"Submitted","dateInformation":"v2"},{"date":"2026-08-06T00:23:28Z","dateType":"Updated","dateInformation":"v2"},{"date":"2026-08","dateType":"Available","dateInformation":"v1"}],"language":null,"types":{"schemaOrg":"CreativeWork","resourceTypeGeneral":"Preprint","citeproc":"article","bibtex":"misc","ris":"GEN","resourceType":"Article"},"relatedIdentifiers":[],"relatedItems":[],"sizes":[],"formats":[],"version":"2","rightsList":[{"rightsUri":"http://arxiv.org/licenses/nonexclusive-distrib/1.0/","rights":"arXiv.org perpetual, non-exclusive license"}],"descriptions":[{"descriptionType":"Abstract","description":"We study the fully parabolic Keller--Segel system\n \\[\n u_t=Δu-χ\\nabla\\!\\cdot(u\\nabla v)+λu-μu^2,\n \\qquad\n τv_t=Δv-v+u\n \\]\n in a bounded smooth convex domain. For every fixed $τ\u0026gt;0$, we prove that\n \\[\n μ\u0026gt;\\frac{Nχ}{4}\n \\] guarantees global existence and uniform-in-time boundedness. This coefficient-explicit sufficient condition is independent of $τ$ and involves no embedding or maximal-regularity constants. To the best of our knowledge, it is the first coefficient-explicit boundedness criterion that remains unchanged for all $τ\u0026gt;0$ in arbitrary space dimension.\n The proof is built on a new auxiliary comparison function\n \\[\n Y_τ\n =u+\\frac{χτ}{2}|\\nabla v|^2-(τ-1)Δv,\n \\]\n which satisfies a closed scalar parabolic inequality for every $τ\u0026gt;0$. When $τ\\ge1$, this inequality yields a direct pointwise comparison and an explicit bound for $u$. When $0\u0026lt;τ\u0026lt;1$, it instead provides a uniform upper bound for $v$. Applying a parabolic squeezing argument to the transform $z=e^{-χv/2}$ then yields a uniform Hölder bound for $v$. Hölder--Sobolev interpolation and weighted maximal $L^p$-regularity subsequently give an $L^p$-bound for $u$ with sufficiently large $p$, and standard parabolic smoothing closes the argument."}],"geoLocations":[],"fundingReferences":[],"url":"https://arxiv.org/abs/2608.03869","contentUrl":null,"metadataVersion":1,"schemaVersion":"http://datacite.org/schema/kernel-4","source":"mds","isActive":true,"state":"findable","reason":null,"viewCount":0,"downloadCount":0,"referenceCount":0,"citationCount":0,"partCount":0,"partOfCount":0,"versionCount":0,"versionOfCount":0,"created":"2026-08-05T02:22:52Z","registered":"2026-08-05T02:22:52Z","published":null,"updated":"2026-08-06T02:22:03Z"},"relationships":{"client":{"data":{"id":"arxiv.content","type":"clients"}}}},{"id":"10.48550/arxiv.2608.03808","type":"dois","attributes":{"doi":"10.48550/arxiv.2608.03808","identifiers":[{"identifier":"2608.03808","identifierType":"arXiv"}],"creators":[{"nameType":"Personal","givenName":"Zeying","familyName":"Zhang","name":"Zhang, Zeying","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Zhenye","familyName":"Li","name":"Li, Zhenye","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Zhi-Ming","familyName":"Yu","name":"Yu, Zhi-Ming","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Gui-Bin","familyName":"Liu","name":"Liu, Gui-Bin","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Yugui","familyName":"Yao","name":"Yao, Yugui","affiliation":[],"nameIdentifiers":[]}],"titles":[{"title":"Generalized Space Groups from Internal Configuration Spaces"}],"publisher":"arXiv","container":{},"publicationYear":2026,"subjects":[{"subject":"Materials Science (cond-mat.mtrl-sci)","lang":"en","subjectScheme":"arXiv"},{"subject":"FOS: Physical sciences","subjectScheme":"Fields of Science and Technology (FOS)"}],"contributors":[],"dates":[{"date":"2026-08-04T15:19:52Z","dateType":"Submitted","dateInformation":"v1"},{"date":"2026-08-05T01:01:10Z","dateType":"Updated","dateInformation":"v1"},{"date":"2026-08-05T10:03:19Z","dateType":"Submitted","dateInformation":"v2"},{"date":"2026-08-06T00:36:22Z","dateType":"Updated","dateInformation":"v2"},{"date":"2026-08","dateType":"Available","dateInformation":"v1"}],"language":null,"types":{"schemaOrg":"CreativeWork","resourceTypeGeneral":"Preprint","citeproc":"article","bibtex":"misc","ris":"GEN","resourceType":"Article"},"relatedIdentifiers":[],"relatedItems":[],"sizes":[],"formats":[],"version":"2","rightsList":[{"rightsUri":"http://arxiv.org/licenses/nonexclusive-distrib/1.0/","rights":"arXiv.org perpetual, non-exclusive license"}],"descriptions":[{"descriptionType":"Abstract","description":"We develop a unified construction of generalized space groups for crystals with unconventional internal degrees of freedom. Starting from the full group $G_P$ of allowed internal transformations and the stabilizer $P$ of a reference object, we determine the pointwise and setwise symmetries, $J$ and $K$, of the allowed configuration set. Goursat's lemma then couples the internal quotient $K/J$ to a spatial quotient. The framework includes ordinary, magnetic, spin, and color space groups as special cases. As an example, we consider a dodecahedral object with $P=I\\simeq A_5$, for which we obtain the nontrivial pair $T\\triangleleft O$ with $O/T\\simeq\\mathbb Z_2$. The resulting generalized space group hosts a point node with topological charge $|C|=12$."},{"descriptionType":"Other","description":"6 pages, 2 figures"}],"geoLocations":[],"fundingReferences":[],"url":"https://arxiv.org/abs/2608.03808","contentUrl":null,"metadataVersion":1,"schemaVersion":"http://datacite.org/schema/kernel-4","source":"mds","isActive":true,"state":"findable","reason":null,"viewCount":0,"downloadCount":0,"referenceCount":0,"citationCount":0,"partCount":0,"partOfCount":0,"versionCount":0,"versionOfCount":0,"created":"2026-08-05T02:21:28Z","registered":"2026-08-05T02:21:29Z","published":null,"updated":"2026-08-06T02:22:01Z"},"relationships":{"client":{"data":{"id":"arxiv.content","type":"clients"}}}},{"id":"10.48550/arxiv.2608.03722","type":"dois","attributes":{"doi":"10.48550/arxiv.2608.03722","identifiers":[{"identifier":"2608.03722","identifierType":"arXiv"}],"creators":[{"nameType":"Personal","givenName":"Molood","familyName":"Arman","name":"Arman, Molood","affiliation":[],"nameIdentifiers":[]}],"titles":[{"title":"When Outputs Disperse, Does Epistemic Revision Follow? A Black-Box Diagnostic for Machine Collectives"}],"publisher":"arXiv","container":{},"publicationYear":2026,"subjects":[{"subject":"Artificial Intelligence (cs.AI)","lang":"en","subjectScheme":"arXiv"},{"subject":"Computation and Language (cs.CL)","lang":"en","subjectScheme":"arXiv"},{"subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"}],"contributors":[],"dates":[{"date":"2026-08-04T14:19:59Z","dateType":"Submitted","dateInformation":"v1"},{"date":"2026-08-05T00:57:49Z","dateType":"Updated","dateInformation":"v1"},{"date":"2026-08-05T16:42:42Z","dateType":"Submitted","dateInformation":"v2"},{"date":"2026-08-06T00:59:30Z","dateType":"Updated","dateInformation":"v2"},{"date":"2026-08","dateType":"Available","dateInformation":"v1"}],"language":null,"types":{"schemaOrg":"CreativeWork","resourceTypeGeneral":"Preprint","citeproc":"article","bibtex":"misc","ris":"GEN","resourceType":"Article"},"relatedIdentifiers":[],"relatedItems":[],"sizes":[],"formats":[],"version":"2","rightsList":[{"rightsIdentifierScheme":"SPDX","rightsUri":"https://creativecommons.org/licenses/by/4.0/legalcode","schemeUri":"https://spdx.org/licenses/","rights":"Creative Commons Attribution 4.0 International","rightsIdentifier":"cc-by-4.0"}],"descriptions":[{"descriptionType":"Abstract","description":"Collective intelligence research treats disagreement as evidence of epistemic diversity: if agents express different views, the group should retain capacity to revise. In LLM collectives this proxy can break: agents can produce diverse-looking arguments while preserving the same conclusion. We operationalize dispersion-revision coupling: the degree to which an intervention that verifiably increases the dispersion of a collective's outputs in embedding space is accompanied by genuine revision of its epistemic stance rather than premise-preserving reformulation. The diagnostic is black-box: it operates on generated text alone and makes no claims about the internal representations of the generating models. Two channels are measured independently: an output channel, the Coherence Index (CI), verifies that the intervention changed output dispersion; an epistemic channel, per-turn stance annotation, measures whether the collective revised. We propose CI with the Meta-Predictive Clarity System (MPCS), which inserts a Re-Differentiation Protocol (RDP) when outputs over-converge, as a reusable method for estimating this coupling regime. We evaluate five-agent collectives from two configurations (gpt-4o-mini and gemini-2.5-flash; 310 paired episodes per condition). On gpt-4o-mini, conditional dissent improves false-premise recovery by +17.7 points (p\u0026lt;1e-6) while static persona diversity harms recovery (-8.1, p=.007). On gemini-2.5-flash, the same intervention at a comparable budget yields no gain (26.1% vs 27.1%, p=.84) despite a verified dispersion drop; the two treatment effects differ from each other (z=3.79, p\u0026lt;.001). Mechanism tagging shows Gemini preserves the false premise via intra-framework dissent: 94% of tagged post-RDP responses reformulate rather than concede (vs 24% on GPT). We recommend reporting per-intervention stance shift and premise-preservation rate alongside accuracy."},{"descriptionType":"Other","description":"Reviewed at Collective Intelligence 2026 (CI 2026) Conference. Revised version incorporating reviewer feedback"}],"geoLocations":[],"fundingReferences":[],"url":"https://arxiv.org/abs/2608.03722","contentUrl":null,"metadataVersion":1,"schemaVersion":"http://datacite.org/schema/kernel-4","source":"mds","isActive":true,"state":"findable","reason":null,"viewCount":0,"downloadCount":0,"referenceCount":0,"citationCount":0,"partCount":0,"partOfCount":0,"versionCount":0,"versionOfCount":0,"created":"2026-08-05T02:19:27Z","registered":"2026-08-05T02:19:28Z","published":null,"updated":"2026-08-06T02:22:00Z"},"relationships":{"client":{"data":{"id":"arxiv.content","type":"clients"}}}},{"id":"10.48550/arxiv.2608.03714","type":"dois","attributes":{"doi":"10.48550/arxiv.2608.03714","identifiers":[{"identifier":"2608.03714","identifierType":"arXiv"}],"creators":[{"nameType":"Personal","givenName":"Jun","familyName":"Mochida","name":"Mochida, Jun","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Atac","familyName":"Imamoglu","name":"Imamoglu, Atac","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Yuto","familyName":"Ashida","name":"Ashida, Yuto","affiliation":[],"nameIdentifiers":[]}],"titles":[{"title":"Cavity control of quantum phase transitions in a two-dimensional Kondo lattice"}],"publisher":"arXiv","container":{},"publicationYear":2026,"subjects":[{"subject":"Strongly Correlated Electrons (cond-mat.str-el)","lang":"en","subjectScheme":"arXiv"},{"subject":"Mesoscale and Nanoscale Physics (cond-mat.mes-hall)","lang":"en","subjectScheme":"arXiv"},{"subject":"Quantum Physics (quant-ph)","lang":"en","subjectScheme":"arXiv"},{"subject":"FOS: Physical sciences","subjectScheme":"Fields of Science and Technology (FOS)"}],"contributors":[],"dates":[{"date":"2026-08-04T14:17:24Z","dateType":"Submitted","dateInformation":"v1"},{"date":"2026-08-05T00:57:36Z","dateType":"Updated","dateInformation":"v1"},{"date":"2026-08-05T02:56:55Z","dateType":"Submitted","dateInformation":"v2"},{"date":"2026-08-06T00:20:25Z","dateType":"Updated","dateInformation":"v2"},{"date":"2026-08","dateType":"Available","dateInformation":"v1"}],"language":null,"types":{"schemaOrg":"CreativeWork","resourceTypeGeneral":"Preprint","citeproc":"article","bibtex":"misc","ris":"GEN","resourceType":"Article"},"relatedIdentifiers":[],"relatedItems":[],"sizes":[],"formats":[],"version":"2","rightsList":[{"rightsUri":"http://arxiv.org/licenses/nonexclusive-distrib/1.0/","rights":"arXiv.org perpetual, non-exclusive license"}],"descriptions":[{"descriptionType":"Abstract","description":"Cavity quantum electrodynamics offers a route to control quantum phases by using vacuum fluctuations of confined electromagnetic fields. In particular, planar cavities based on polar van der Waals materials can generate strongly confined modes and are promising for controlling two-dimensional correlated materials. Recently, moiré materials have become central platforms for studying two-dimensional heavy-fermion systems and their quantum phase transitions. Kondo lattices provide a prototypical model for studying quantum phase boundaries, driven by competition between Kondo screening and the ordering of local magnetic moments. We show that a cavity-induced interaction can shift the quantum phase transitions between a heavy-fermion phase and an antiferromagnetic phase in a two-dimensional Kondo lattice through a momentum-dependent self-energy of the conduction bands. For the longitudinal projected field motivated by h-BN hyperbolic phonon polaritons, the self-energy favors Kondo hybridization and expands the heavy-fermion region. Transverse and circular in-plane model structures give distinct effects, with the transverse case relatively favoring the magnetically ordered phase and the circular case lying between the longitudinal and transverse cases. These results indicate that electromagnetic vacuum fluctuations can effectively modify the control parameters of strongly correlated two-dimensional Kondo materials."},{"descriptionType":"Other","description":"20 pages, 13 figures"}],"geoLocations":[],"fundingReferences":[],"url":"https://arxiv.org/abs/2608.03714","contentUrl":null,"metadataVersion":1,"schemaVersion":"http://datacite.org/schema/kernel-4","source":"mds","isActive":true,"state":"findable","reason":null,"viewCount":0,"downloadCount":0,"referenceCount":0,"citationCount":0,"partCount":0,"partOfCount":0,"versionCount":0,"versionOfCount":0,"created":"2026-08-05T02:19:16Z","registered":"2026-08-05T02:19:17Z","published":null,"updated":"2026-08-06T02:21:59Z"},"relationships":{"client":{"data":{"id":"arxiv.content","type":"clients"}}}},{"id":"10.48550/arxiv.2608.03697","type":"dois","attributes":{"doi":"10.48550/arxiv.2608.03697","identifiers":[{"identifier":"2608.03697","identifierType":"arXiv"}],"creators":[{"nameType":"Personal","givenName":"Luis","familyName":"Lehner","name":"Lehner, Luis","affiliation":[],"nameIdentifiers":[]}],"titles":[{"title":"Gravitational Enstrophy: Local Geometric Origin and Inverse-Cascade Constraints"}],"publisher":"arXiv","container":{},"publicationYear":2026,"subjects":[{"subject":"General Relativity and Quantum Cosmology (gr-qc)","lang":"en","subjectScheme":"arXiv"},{"subject":"High Energy Astrophysical Phenomena (astro-ph.HE)","lang":"en","subjectScheme":"arXiv"},{"subject":"High Energy Physics - Theory (hep-th)","lang":"en","subjectScheme":"arXiv"},{"subject":"FOS: Physical sciences","subjectScheme":"Fields of Science and Technology (FOS)"}],"contributors":[],"dates":[{"date":"2026-08-04T14:01:20Z","dateType":"Submitted","dateInformation":"v1"},{"date":"2026-08-05T00:56:35Z","dateType":"Updated","dateInformation":"v1"},{"date":"2026-08-05T14:54:41Z","dateType":"Submitted","dateInformation":"v2"},{"date":"2026-08-06T00:53:10Z","dateType":"Updated","dateInformation":"v2"},{"date":"2026-08","dateType":"Available","dateInformation":"v1"}],"language":null,"types":{"schemaOrg":"CreativeWork","resourceTypeGeneral":"Preprint","citeproc":"article","bibtex":"misc","ris":"GEN","resourceType":"Article"},"relatedIdentifiers":[],"relatedItems":[],"sizes":[],"formats":[],"version":"2","rightsList":[{"rightsIdentifierScheme":"SPDX","rightsUri":"https://creativecommons.org/licenses/by-nc-nd/4.0/legalcode","schemeUri":"https://spdx.org/licenses/","rights":"Creative Commons Attribution Non Commercial No Derivatives 4.0 International","rightsIdentifier":"cc-by-nc-nd-4.0"}],"descriptions":[{"descriptionType":"Abstract","description":"Two-dimensional fluids conserve energy and enstrophy, driving inverse energy cascades via Fjørtoft's argument. We show General Relativity admits an analogous structure: for linear radiative perturbations of Petrov type D backgrounds (Kerr, Kerr--AdS), the gravitational-wave energy $W = \\sum_k W_k$ and magnetic Weyl enstrophy $\\mathcal{Z} = \\int B_{ab} B^{ab} \\sqrtγ \\, d^3x \\approx \\sum_k ω_k^2 W_k$ are approximately conserved in the zero-angular momentum frame, where vorticity coupling vanishes identically and curl exchange cancels mode-by-mode. This yields a gravitational Fjørtoft constraint implying nonlinear energy transfer proceeds preferentially toward lower frequencies. The constraint is dynamically active in near-extremal Kerr ($τ_{\\text{damp}} \\gg τ_{\\text{nl}}$) and confined geometries (AdS), but suppressed in generic ringdown. In AdS, $\\mathcal{Z}$ maps holographically to the boundary fluid enstrophy."},{"descriptionType":"Other","description":"41 pages (1/2 are appendices for specific details), 3 figures [a few typos fixed, added a clarifying paragraph]"}],"geoLocations":[],"fundingReferences":[],"url":"https://arxiv.org/abs/2608.03697","contentUrl":null,"metadataVersion":1,"schemaVersion":"http://datacite.org/schema/kernel-4","source":"mds","isActive":true,"state":"findable","reason":null,"viewCount":0,"downloadCount":0,"referenceCount":0,"citationCount":0,"partCount":0,"partOfCount":0,"versionCount":0,"versionOfCount":0,"created":"2026-08-05T02:18:53Z","registered":"2026-08-05T02:18:53Z","published":null,"updated":"2026-08-06T02:21:58Z"},"relationships":{"client":{"data":{"id":"arxiv.content","type":"clients"}}}},{"id":"10.48550/arxiv.2608.03669","type":"dois","attributes":{"doi":"10.48550/arxiv.2608.03669","identifiers":[{"identifier":"2608.03669","identifierType":"arXiv"}],"creators":[{"nameType":"Personal","givenName":"J. S.","familyName":"van Hulst","name":"van Hulst, J. S.","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"A. M. C.","familyName":"de Peffer","name":"de Peffer, A. M. C.","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"D.","familyName":"Herceg","name":"Herceg, D.","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"E. M.","familyName":"Franken","name":"Franken, E. M.","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"E.","familyName":"Verschueren","name":"Verschueren, E.","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"W. P. M. H.","familyName":"Heemels","name":"Heemels, W. P. M. H.","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"D. J.","familyName":"Antunes","name":"Antunes, D. J.","affiliation":[],"nameIdentifiers":[]}],"titles":[{"title":"Precision Specimen Positioning in Electron Microscopy through Hysteresis Compensation, Iterative Learning, and Vision-Based Sensing"}],"publisher":"arXiv","container":{},"publicationYear":2026,"subjects":[{"subject":"Systems and Control (eess.SY)","lang":"en","subjectScheme":"arXiv"},{"subject":"Signal Processing (eess.SP)","lang":"en","subjectScheme":"arXiv"},{"subject":"FOS: Electrical engineering, electronic engineering, information engineering","subjectScheme":"Fields of Science and Technology (FOS)"}],"contributors":[],"dates":[{"date":"2026-08-04T13:47:36Z","dateType":"Submitted","dateInformation":"v1"},{"date":"2026-08-05T00:55:39Z","dateType":"Updated","dateInformation":"v1"},{"date":"2026-08-05T13:29:24Z","dateType":"Submitted","dateInformation":"v2"},{"date":"2026-08-06T00:47:04Z","dateType":"Updated","dateInformation":"v2"},{"date":"2026-08","dateType":"Available","dateInformation":"v1"}],"language":null,"types":{"schemaOrg":"CreativeWork","resourceTypeGeneral":"Preprint","citeproc":"article","bibtex":"misc","ris":"GEN","resourceType":"Article"},"relatedIdentifiers":[],"relatedItems":[],"sizes":[],"formats":[],"version":"2","rightsList":[{"rightsUri":"http://arxiv.org/licenses/nonexclusive-distrib/1.0/","rights":"arXiv.org perpetual, non-exclusive license"}],"descriptions":[{"descriptionType":"Abstract","description":"Electron microscopy requires nanometer-scale specimen positioning over a long stroke. Piezo-stepper actuators are well suited for this task, but their accuracy is limited by hysteresis, mechanical misalignments, and non-collocated sensing. Prior work has addressed these limitations on simplified lab setups. However, extending to a full electron microscope stage introduces coupled nonlinear kinematics and, importantly, the absence of a dedicated point-of-interest (POI) sensor. This paper presents an integrated feedforward framework for precision positioning on such a stage inside an operational electron microscope. Per-element hysteresis compensation first linearizes the actuator response. In the absence of a dedicated POI sensor, a POI measurement is constructed from EM images through cross-correlation-based image tracking. From this measurement, we construct an encoder-based proxy for the POI position. Commutation-angle-domain iterative learning control then uses this proxy as its error signal to cancel the repeatable disturbances of stepping. Because the learned corrections are parameterized in the commutation angle, they transfer across the quasi-static range of drive frequencies. The framework reduces the POI tracking error by over 13x on the lab setup and by 7 to 12x on an operational transmission electron microscope."},{"descriptionType":"Other","description":"11 pages, 13 figures. This work has been submitted to the IEEE for possible publication"}],"geoLocations":[],"fundingReferences":[],"url":"https://arxiv.org/abs/2608.03669","contentUrl":null,"metadataVersion":1,"schemaVersion":"http://datacite.org/schema/kernel-4","source":"mds","isActive":true,"state":"findable","reason":null,"viewCount":0,"downloadCount":0,"referenceCount":0,"citationCount":0,"partCount":0,"partOfCount":0,"versionCount":0,"versionOfCount":0,"created":"2026-08-05T02:18:15Z","registered":"2026-08-05T02:18:15Z","published":null,"updated":"2026-08-06T02:21:56Z"},"relationships":{"client":{"data":{"id":"arxiv.content","type":"clients"}}}},{"id":"10.48550/arxiv.2608.03545","type":"dois","attributes":{"doi":"10.48550/arxiv.2608.03545","identifiers":[{"identifier":"2608.03545","identifierType":"arXiv"}],"creators":[{"nameType":"Personal","givenName":"Kunbin","familyName":"Xu","name":"Xu, Kunbin","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Xingzuo","familyName":"Li","name":"Li, Xingzuo","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Xuefeng","familyName":"Bai","name":"Bai, Xuefeng","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Kehai","familyName":"Chen","name":"Chen, Kehai","affiliation":[],"nameIdentifiers":[]}],"titles":[{"title":"Hi-TTRL: Regulating Consensus with Hints for Test-Time Reinforcement Learning"}],"publisher":"arXiv","container":{},"publicationYear":2026,"subjects":[{"subject":"Computation and Language (cs.CL)","lang":"en","subjectScheme":"arXiv"},{"subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"}],"contributors":[],"dates":[{"date":"2026-08-04T12:20:17Z","dateType":"Submitted","dateInformation":"v1"},{"date":"2026-08-05T00:49:43Z","dateType":"Updated","dateInformation":"v1"},{"date":"2026-08-05T03:37:38Z","dateType":"Submitted","dateInformation":"v2"},{"date":"2026-08-06T00:22:10Z","dateType":"Updated","dateInformation":"v2"},{"date":"2026-08","dateType":"Available","dateInformation":"v1"}],"language":null,"types":{"schemaOrg":"CreativeWork","resourceTypeGeneral":"Preprint","citeproc":"article","bibtex":"misc","ris":"GEN","resourceType":"Article"},"relatedIdentifiers":[],"relatedItems":[],"sizes":[],"formats":[],"version":"2","rightsList":[{"rightsUri":"http://arxiv.org/licenses/nonexclusive-distrib/1.0/","rights":"arXiv.org perpetual, non-exclusive license"}],"descriptions":[{"descriptionType":"Abstract","description":"Test-time reinforcement learning (TTRL) improves the reasoning capabilities of large language models without labeled data by updating the policy with pseudo-labels constructed through majority voting. While effective, the reward signal assigned from majority voting is highly sensitive to consensus strength, defined as the frequency of the most common answer within a rollout group. In TTRL, consensus strength plays a dual role: it reflects both the reliability of the pseudo-label and the distribution of advantages. Low consensus can amplify updates from unreliable pseudo-labels through disproportionately large advantages, whereas high consensus reduces reward contrast and ultimately yields vanishing gradients. In this paper, we introduce Hi-TTRL, a test-time reinforcement learning framework that utilizes hints during sampling to regulate rollout consensus strength. Hi-TTRL first estimates consensus strength from a partial rollout group. When the consensus strength falls outside a target interval, it invokes a Markov chain Monte Carlo (MCMC) hint sampler. The sampler targets the power-transformed prefix distribution and uses finite-step approximate sampling to generate rollout prefixes as hints. By tuning the power exponent, Hi-TTRL generates hints with a sharpened or flattened power target, steering rollout consensus strength toward the target interval. Experiments on multiple datasets and backbones show that Hi-TTRL consistently improves over standard TTRL, with ablations and consensus-steering analyses validating the effectiveness of adaptive hint-guided consensus regulation."},{"descriptionType":"Other","description":"15 pages, 7 figures"}],"geoLocations":[],"fundingReferences":[],"url":"https://arxiv.org/abs/2608.03545","contentUrl":null,"metadataVersion":1,"schemaVersion":"http://datacite.org/schema/kernel-4","source":"mds","isActive":true,"state":"findable","reason":null,"viewCount":0,"downloadCount":0,"referenceCount":0,"citationCount":0,"partCount":0,"partOfCount":0,"versionCount":0,"versionOfCount":0,"created":"2026-08-05T02:15:26Z","registered":"2026-08-05T02:15:26Z","published":null,"updated":"2026-08-06T02:21:56Z"},"relationships":{"client":{"data":{"id":"arxiv.content","type":"clients"}}}},{"id":"10.48550/arxiv.2608.03529","type":"dois","attributes":{"doi":"10.48550/arxiv.2608.03529","identifiers":[{"identifier":"2608.03529","identifierType":"arXiv"}],"creators":[{"nameType":"Personal","givenName":"Pascal","familyName":"Wullschleger","name":"Wullschleger, Pascal","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Christian","familyName":"Kreis","name":"Kreis, Christian","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Martin A.","familyName":"Walter","name":"Walter, Martin A.","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Jennifer","familyName":"Foster","name":"Foster, Jennifer","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Marc","familyName":"Pouly","name":"Pouly, Marc","affiliation":[],"nameIdentifiers":[]}],"titles":[{"title":"Consensus Measures for Unstructured Biomedical Text Annotations"}],"publisher":"arXiv","container":{},"publicationYear":2026,"subjects":[{"subject":"Computation and Language (cs.CL)","lang":"en","subjectScheme":"arXiv"},{"subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"}],"contributors":[],"dates":[{"date":"2026-08-04T12:12:56Z","dateType":"Submitted","dateInformation":"v1"},{"date":"2026-08-05T00:48:58Z","dateType":"Updated","dateInformation":"v1"},{"date":"2026-08-05T11:23:45Z","dateType":"Submitted","dateInformation":"v2"},{"date":"2026-08-06T00:40:17Z","dateType":"Updated","dateInformation":"v2"},{"date":"2026-08","dateType":"Available","dateInformation":"v1"}],"language":null,"types":{"schemaOrg":"CreativeWork","resourceTypeGeneral":"Preprint","citeproc":"article","bibtex":"misc","ris":"GEN","resourceType":"Article"},"relatedIdentifiers":[],"relatedItems":[],"sizes":[],"formats":[],"version":"2","rightsList":[{"rightsIdentifierScheme":"SPDX","rightsUri":"https://creativecommons.org/licenses/by/4.0/legalcode","schemeUri":"https://spdx.org/licenses/","rights":"Creative Commons Attribution 4.0 International","rightsIdentifier":"cc-by-4.0"}],"descriptions":[{"descriptionType":"Abstract","description":"Biomedical literature is increasingly mined for knowledge beyond the questions it was written to answer. Because the target concepts are not known in advance, annotators prefer open-ended labels, whose agreement is hard to quantify. We study soft inter-rater reliability for annotators providing unstructured texts for biomedical annotation tasks. Synthetic experiments show that soft reliability can be quantified using a variety of semantic equivalence measures, and that the choice of measure affects failure modes of the estimation. Embeddings are scalable, but limited when differentiating similar but distinct concepts. Large language models are promising, but limited by scalability for estimating agreement by chance. Finally, we suggest measures based on natural language inference as a sensible compromise."}],"geoLocations":[],"fundingReferences":[],"url":"https://arxiv.org/abs/2608.03529","contentUrl":null,"metadataVersion":1,"schemaVersion":"http://datacite.org/schema/kernel-4","source":"mds","isActive":true,"state":"findable","reason":null,"viewCount":0,"downloadCount":0,"referenceCount":0,"citationCount":0,"partCount":0,"partOfCount":0,"versionCount":0,"versionOfCount":0,"created":"2026-08-05T02:15:04Z","registered":"2026-08-05T02:15:05Z","published":null,"updated":"2026-08-06T02:21:55Z"},"relationships":{"client":{"data":{"id":"arxiv.content","type":"clients"}}}},{"id":"10.48550/arxiv.2608.03505","type":"dois","attributes":{"doi":"10.48550/arxiv.2608.03505","identifiers":[{"identifier":"2608.03505","identifierType":"arXiv"}],"creators":[{"nameType":"Personal","givenName":"Jinhong","familyName":"Jeong","name":"Jeong, Jinhong","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Seungyeop","familyName":"Yi","name":"Yi, Seungyeop","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Sangah","familyName":"Lee","name":"Lee, Sangah","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Youngjae","familyName":"Yu","name":"Yu, Youngjae","affiliation":[],"nameIdentifiers":[]}],"titles":[{"title":"ConlangBench: Exploring Language Knowledge and Learning in LLMs through Diverse Constructed Languages"}],"publisher":"arXiv","container":{},"publicationYear":2026,"subjects":[{"subject":"Computation and Language (cs.CL)","lang":"en","subjectScheme":"arXiv"},{"subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"}],"contributors":[],"dates":[{"date":"2026-08-04T11:45:10Z","dateType":"Submitted","dateInformation":"v1"},{"date":"2026-08-05T00:48:08Z","dateType":"Updated","dateInformation":"v1"},{"date":"2026-08-05T01:59:09Z","dateType":"Submitted","dateInformation":"v2"},{"date":"2026-08-06T00:17:46Z","dateType":"Updated","dateInformation":"v2"},{"date":"2026-08","dateType":"Available","dateInformation":"v1"}],"language":null,"types":{"schemaOrg":"CreativeWork","resourceTypeGeneral":"Preprint","citeproc":"article","bibtex":"misc","ris":"GEN","resourceType":"Article"},"relatedIdentifiers":[],"relatedItems":[],"sizes":[],"formats":[],"version":"2","rightsList":[{"rightsUri":"http://arxiv.org/licenses/nonexclusive-distrib/1.0/","rights":"arXiv.org perpetual, non-exclusive license"}],"descriptions":[{"descriptionType":"Abstract","description":"Constructed languages (conlangs) are intentionally created human languages with a rich tradition of linguistic creativity. Despite their potential for studying language learning in large language models (LLMs), existing conlangs remain largely underexplored in LLM research. We present ConlangBench, the first large-scale benchmark for evaluating and training LLMs on 21 existing conlangs. We collect over 21M conlang-English parallel sentence pairs (including 430K pairs across the 20 non-Esperanto conlangs) and 321K vocabulary entries. In bidirectional translation experiments, we find that models perform better on a posteriori conlangs, whose vocabularies are derived from natural languages, reflecting the design characteristics of conlangs. Training on ConlangBench also shows that models can learn all eight conlangs for which sufficient parallel corpora are available, while their learning curves vary depending on how the conlangs were created. Our findings suggest that conlangs provide a unique testbed for investigating how LLMs acquire low-resource languages."},{"descriptionType":"Other","description":"29 pages, 12 figures, 17 tables"}],"geoLocations":[],"fundingReferences":[],"url":"https://arxiv.org/abs/2608.03505","contentUrl":null,"metadataVersion":1,"schemaVersion":"http://datacite.org/schema/kernel-4","source":"mds","isActive":true,"state":"findable","reason":null,"viewCount":0,"downloadCount":0,"referenceCount":0,"citationCount":0,"partCount":0,"partOfCount":0,"versionCount":0,"versionOfCount":0,"created":"2026-08-05T02:14:31Z","registered":"2026-08-05T02:14:31Z","published":null,"updated":"2026-08-06T02:21:54Z"},"relationships":{"client":{"data":{"id":"arxiv.content","type":"clients"}}}},{"id":"10.48550/arxiv.2608.03491","type":"dois","attributes":{"doi":"10.48550/arxiv.2608.03491","identifiers":[{"identifier":"2608.03491","identifierType":"arXiv"}],"creators":[{"nameType":"Personal","givenName":"Florian","familyName":"Frantzen","name":"Frantzen, Florian","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Michael T.","familyName":"Schaub","name":"Schaub, Michael T.","affiliation":[],"nameIdentifiers":[]}],"titles":[{"title":"A repository for discovery and reuse of higher-order network datasets"}],"publisher":"arXiv","container":{},"publicationYear":2026,"subjects":[{"subject":"Digital Libraries (cs.DL)","lang":"en","subjectScheme":"arXiv"},{"subject":"Social and Information Networks (cs.SI)","lang":"en","subjectScheme":"arXiv"},{"subject":"Data Analysis, Statistics and Probability (physics.data-an)","lang":"en","subjectScheme":"arXiv"},{"subject":"Physics and Society (physics.soc-ph)","lang":"en","subjectScheme":"arXiv"},{"subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"},{"subject":"FOS: Physical sciences","subjectScheme":"Fields of Science and Technology (FOS)"}],"contributors":[],"dates":[{"date":"2026-08-04T11:27:02Z","dateType":"Submitted","dateInformation":"v1"},{"date":"2026-08-06T00:28:44Z","dateType":"Updated","dateInformation":"v1"},{"date":"2026-08","dateType":"Available","dateInformation":"v1"}],"language":null,"types":{"schemaOrg":"CreativeWork","resourceTypeGeneral":"Preprint","citeproc":"article","bibtex":"misc","ris":"GEN","resourceType":"Article"},"relatedIdentifiers":[],"relatedItems":[],"sizes":[],"formats":[],"version":"1","rightsList":[{"rightsUri":"http://arxiv.org/licenses/nonexclusive-distrib/1.0/","rights":"arXiv.org perpetual, non-exclusive license"}],"descriptions":[{"descriptionType":"Abstract","description":"Higher-order network datasets are dispersed across publications, institutional archives, and software-specific collections, making them difficult to discover, compare, and reuse. We introduce the Aachen Higher-Order Repository of Networks (AHORN), a curated repository of standardized higher-order network datasets derived from publicly released sources. Each dataset entry links a converted dataset to its source, metadata, citation guidance, conversion code, and version history. The repository supports browsable and machine-readable discovery, revision-specific downloads, format validation, and exports for interoperable reuse. We describe the repository architecture, curation workflow, access tools, and the coverage and limitations of the catalog snapshot analyzed in this article."}],"geoLocations":[],"fundingReferences":[],"url":"https://arxiv.org/abs/2608.03491","contentUrl":null,"metadataVersion":1,"schemaVersion":"http://datacite.org/schema/kernel-4","source":"mds","isActive":true,"state":"findable","reason":null,"viewCount":0,"downloadCount":0,"referenceCount":0,"citationCount":0,"partCount":0,"partOfCount":0,"versionCount":0,"versionOfCount":0,"created":"2026-08-05T02:14:11Z","registered":"2026-08-05T02:14:12Z","published":null,"updated":"2026-08-06T02:21:52Z"},"relationships":{"client":{"data":{"id":"arxiv.content","type":"clients"}}}},{"id":"10.48550/arxiv.2608.03467","type":"dois","attributes":{"doi":"10.48550/arxiv.2608.03467","identifiers":[{"identifier":"2608.03467","identifierType":"arXiv"}],"creators":[{"nameType":"Personal","givenName":"Zhe","familyName":"Cao","name":"Cao, Zhe","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Miaowen","familyName":"Wen","name":"Wen, Miaowen","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Fangjiong","familyName":"Chen","name":"Chen, Fangjiong","affiliation":[],"nameIdentifiers":[]}],"titles":[{"title":"When Correct Solutions Repeat: Rarity-Aware Credit Redistribution for GRPO"}],"publisher":"arXiv","container":{},"publicationYear":2026,"subjects":[{"subject":"Artificial Intelligence (cs.AI)","lang":"en","subjectScheme":"arXiv"},{"subject":"Machine Learning (cs.LG)","lang":"en","subjectScheme":"arXiv"},{"subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"}],"contributors":[],"dates":[{"date":"2026-08-04T11:02:26Z","dateType":"Submitted","dateInformation":"v1"},{"date":"2026-08-05T00:45:56Z","dateType":"Updated","dateInformation":"v1"},{"date":"2026-08-05T11:58:57Z","dateType":"Submitted","dateInformation":"v2"},{"date":"2026-08-06T00:42:01Z","dateType":"Updated","dateInformation":"v2"},{"date":"2026-08","dateType":"Available","dateInformation":"v1"}],"language":null,"types":{"schemaOrg":"CreativeWork","resourceTypeGeneral":"Preprint","citeproc":"article","bibtex":"misc","ris":"GEN","resourceType":"Article"},"relatedIdentifiers":[],"relatedItems":[],"sizes":[],"formats":[],"version":"2","rightsList":[{"rightsUri":"http://arxiv.org/licenses/nonexclusive-distrib/1.0/","rights":"arXiv.org perpetual, non-exclusive license"}],"descriptions":[{"descriptionType":"Abstract","description":"Reinforcement learning with verifiable rewards (RLVR) com- monly optimizes each correct completion as an independent learning signal. In GRPO, this completion-level uniformity creates structure-level skew: recurring correct solution forms accumulate positive coefficient mass in proportion to how often they are sampled, while rare forms receive limited credit. We formalize this behavior as multiplicity-induced structure-level credit concentration and introduce a partition- conditioned rule that redistributes positive advantages accord- ing to cluster rarity. Cue-GRPO instantiates this rule with- out auxiliary-model inference by using deterministic Strategy Cues to construct rollout-local partitions of verified-correct traces. Across Qwen2.5-Math-7B and Llama-3.1-8B-Instruct, Cue-GRPO improves AIME repeated-sampling performance, with the largest gains at high sampling budgets. Credit Re- distribution (CR) under Judge Partitions (JP) further indi- cates that the proposed redistribution mechanism can oper- ate with judge-derived partitions. Cue-GRPO adds only 6% wall-clock training overhead over GRPO. These results sup- port structure-level credit redistribution as a practical design axis for RLVR, with Strategy Cues providing a low-overhead implementation for competition mathematics. Code is avail- able at https://github.com/CzZ12/When-Correct-Solutions- Repeat-Rarity-Aware-Credit-Redistribution-for-GRPO."}],"geoLocations":[],"fundingReferences":[],"url":"https://arxiv.org/abs/2608.03467","contentUrl":null,"metadataVersion":1,"schemaVersion":"http://datacite.org/schema/kernel-4","source":"mds","isActive":true,"state":"findable","reason":null,"viewCount":0,"downloadCount":0,"referenceCount":0,"citationCount":0,"partCount":0,"partOfCount":0,"versionCount":0,"versionOfCount":0,"created":"2026-08-05T02:13:36Z","registered":"2026-08-05T02:13:37Z","published":null,"updated":"2026-08-06T02:21:51Z"},"relationships":{"client":{"data":{"id":"arxiv.content","type":"clients"}}}},{"id":"10.48550/arxiv.2608.03487","type":"dois","attributes":{"doi":"10.48550/arxiv.2608.03487","identifiers":[{"identifier":"2608.03487","identifierType":"arXiv"}],"creators":[{"nameType":"Personal","givenName":"Haiqiang","familyName":"Zhang","name":"Zhang, Haiqiang","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Yuanqing","familyName":"Lei","name":"Lei, Yuanqing","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Wanting","familyName":"Li","name":"Li, Wanting","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Tao","familyName":"Zhang","name":"Zhang, Tao","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Wenqi","familyName":"Jiang","name":"Jiang, Wenqi","affiliation":[],"nameIdentifiers":[]}],"titles":[{"title":"RAG-Stack: Co-Optimizing RAG Serving Performance and Quality"}],"publisher":"arXiv","container":{},"publicationYear":2026,"subjects":[{"subject":"Databases (cs.DB)","lang":"en","subjectScheme":"arXiv"},{"subject":"Artificial Intelligence (cs.AI)","lang":"en","subjectScheme":"arXiv"},{"subject":"Information Retrieval (cs.IR)","lang":"en","subjectScheme":"arXiv"},{"subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"}],"contributors":[],"dates":[{"date":"2026-08-04T11:23:19Z","dateType":"Submitted","dateInformation":"v1"},{"date":"2026-08-06T00:17:20Z","dateType":"Updated","dateInformation":"v1"},{"date":"2026-08","dateType":"Available","dateInformation":"v1"}],"language":null,"types":{"schemaOrg":"CreativeWork","resourceTypeGeneral":"Preprint","citeproc":"article","bibtex":"misc","ris":"GEN","resourceType":"Article"},"relatedIdentifiers":[],"relatedItems":[],"sizes":[],"formats":[],"version":"1","rightsList":[{"rightsIdentifierScheme":"SPDX","rightsUri":"https://creativecommons.org/licenses/by/4.0/legalcode","schemeUri":"https://spdx.org/licenses/","rights":"Creative Commons Attribution 4.0 International","rightsIdentifier":"cc-by-4.0"}],"descriptions":[{"descriptionType":"Abstract","description":"Retrieval-augmented generation (RAG), which augments large language model (LLM) generation with information retrieved from databases, has become a widely used approach for knowledge-intensive applications. Modern RAG systems, however, expose many configuration choices, such as retrieval indexes, model selections, and how models invoke retrieval. Each configuration yields a different trade-off between answer quality and serving performance, making it challenging to choose the optimal setting for a specific application deployment. We present RAG-Stack, a framework for efficiently discovering quality-performance Pareto frontiers across diverse RAG applications and serving systems. RAG-Stack consists of RAG-PE, an iterative design-space exploration algorithm that selects the next RAG configuration to evaluate; RAG-IR, a workload abstraction for diverse RAG algorithms; and RAG-CM, a performance model that predicts the optimal deployment and serving performance on the given hardware. Together, these components allow RAG-Stack to search the joint algorithm-system configuration space without deploying every candidate and to transfer an existing Pareto frontier to a new serving system. Given the same number of optimization iterations across diverse datasets, the Pareto frontiers found by RAG-Stack cover 52.5% to 153.2% more of the normalized quality-performance space than those found by state-of-the-art configuration-search methods evaluated over the same RAG design space."}],"geoLocations":[],"fundingReferences":[],"url":"https://arxiv.org/abs/2608.03487","contentUrl":null,"metadataVersion":1,"schemaVersion":"http://datacite.org/schema/kernel-4","source":"mds","isActive":true,"state":"findable","reason":null,"viewCount":0,"downloadCount":0,"referenceCount":0,"citationCount":0,"partCount":0,"partOfCount":0,"versionCount":0,"versionOfCount":0,"created":"2026-08-05T02:14:05Z","registered":"2026-08-05T02:14:06Z","published":null,"updated":"2026-08-06T02:21:51Z"},"relationships":{"client":{"data":{"id":"arxiv.content","type":"clients"}}}},{"id":"10.48550/arxiv.2608.03387","type":"dois","attributes":{"doi":"10.48550/arxiv.2608.03387","identifiers":[{"identifier":"2608.03387","identifierType":"arXiv"}],"creators":[{"nameType":"Personal","givenName":"Shuliang","familyName":"He","name":"He, Shuliang","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Shuai","familyName":"Wang","name":"Wang, Shuai","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Bo","familyName":"Yue","name":"Yue, Bo","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Junchi","familyName":"Teng","name":"Teng, Junchi","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Changyu","familyName":"Wang","name":"Wang, Changyu","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Guiliang","familyName":"Liu","name":"Liu, Guiliang","affiliation":[],"nameIdentifiers":[]}],"titles":[{"title":"RoboReact: Agentic Skill Distillation from Generated Egocentric Videos for Generalizable Whole-Body Manipulation"}],"publisher":"arXiv","container":{},"publicationYear":2026,"subjects":[{"subject":"Robotics (cs.RO)","lang":"en","subjectScheme":"arXiv"},{"subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"}],"contributors":[],"dates":[{"date":"2026-08-04T09:37:06Z","dateType":"Submitted","dateInformation":"v1"},{"date":"2026-08-05T00:41:41Z","dateType":"Updated","dateInformation":"v1"},{"date":"2026-08-05T07:43:28Z","dateType":"Submitted","dateInformation":"v2"},{"date":"2026-08-06T00:30:42Z","dateType":"Updated","dateInformation":"v2"},{"date":"2026-08","dateType":"Available","dateInformation":"v1"}],"language":null,"types":{"schemaOrg":"CreativeWork","resourceTypeGeneral":"Preprint","citeproc":"article","bibtex":"misc","ris":"GEN","resourceType":"Article"},"relatedIdentifiers":[],"relatedItems":[],"sizes":[],"formats":[],"version":"2","rightsList":[{"rightsUri":"http://arxiv.org/licenses/nonexclusive-distrib/1.0/","rights":"arXiv.org perpetual, non-exclusive license"}],"descriptions":[{"descriptionType":"Abstract","description":"Humanoid robots have the potential to perform dexterous manipulation in human environments, yet acquiring diverse and generalizable skills remains costly due to expensive hardware data collection and labor-intensive annotation. Recent advances in video generative models provide a promising opportunity to synthesize rich manipulation experiences from visual observations, but transferring such imagined behaviors into executable whole-body humanoid skills remains largely unexplored. In this work, we present RoboReact, a framework that automatically synthesizes whole-body humanoid manipulation skills from a single egocentric RGB-D observation. RoboReact generates human manipulation videos, extracts geometry-preserving interaction keyframes through depth-aware 3D reconstruction, and retargets them to high-DoF humanoid platforms while preserving hand-object interaction geometry. To bridge the gap between imagined plans and physical execution, RoboReact performs online object-centric re-grounding and leverages a vision-language model-guided refinement loop to adapt skills under geometric mismatch and execution deviations. The refined skills are executed through a whole-body controller, enabling coordinated whole-body manipulation and dexterous interaction. Experiments on real humanoid robots demonstrate that RoboReact generalizes across diverse object configurations and robustly recovers from execution disturbances without requiring teleoperation or human demonstrations. These results highlight the potential of combining generative models, vision-language reasoning, and closed-loop control for scalable humanoid skill acquisition."}],"geoLocations":[],"fundingReferences":[],"url":"https://arxiv.org/abs/2608.03387","contentUrl":null,"metadataVersion":1,"schemaVersion":"http://datacite.org/schema/kernel-4","source":"mds","isActive":true,"state":"findable","reason":null,"viewCount":0,"downloadCount":0,"referenceCount":0,"citationCount":0,"partCount":0,"partOfCount":0,"versionCount":0,"versionOfCount":0,"created":"2026-08-05T02:11:42Z","registered":"2026-08-05T02:11:42Z","published":null,"updated":"2026-08-06T02:21:50Z"},"relationships":{"client":{"data":{"id":"arxiv.content","type":"clients"}}}},{"id":"10.48550/arxiv.2608.03245","type":"dois","attributes":{"doi":"10.48550/arxiv.2608.03245","identifiers":[{"identifier":"2608.03245","identifierType":"arXiv"}],"creators":[{"nameType":"Personal","givenName":"Kamen","familyName":"Pavlov","name":"Pavlov, Kamen","affiliation":[],"nameIdentifiers":[]}],"titles":[{"title":"Homotopy classification of $4$-manifolds with fundamental group $\\mathbb{Z}/p \\rtimes \\mathbb{Z}$"}],"publisher":"arXiv","container":{},"publicationYear":2026,"subjects":[{"subject":"Algebraic Topology (math.AT)","lang":"en","subjectScheme":"arXiv"},{"subject":"Geometric Topology (math.GT)","lang":"en","subjectScheme":"arXiv"},{"subject":"FOS: Mathematics","subjectScheme":"Fields of Science and Technology (FOS)"},{"subject":"57K40, 57N65, 57P10","lang":"en","subjectScheme":"MSC"}],"contributors":[],"dates":[{"date":"2026-08-04T07:15:50Z","dateType":"Submitted","dateInformation":"v1"},{"date":"2026-08-06T00:24:45Z","dateType":"Updated","dateInformation":"v1"},{"date":"2026-08","dateType":"Available","dateInformation":"v1"}],"language":null,"types":{"schemaOrg":"CreativeWork","resourceTypeGeneral":"Preprint","citeproc":"article","bibtex":"misc","ris":"GEN","resourceType":"Article"},"relatedIdentifiers":[],"relatedItems":[],"sizes":[],"formats":[],"version":"1","rightsList":[{"rightsUri":"http://arxiv.org/licenses/nonexclusive-distrib/1.0/","rights":"arXiv.org perpetual, non-exclusive license"}],"descriptions":[{"descriptionType":"Abstract","description":"For an odd prime $p$, we show that the homotopy type of a closed $4$-manifold with fundamental group $\\mathbb{Z}/p \\rtimes \\mathbb{Z}$ is determined by its quadratic $2$-type together with an additional $\\mathbb{Z}/p$-valued intersection form. We also give a generalization to infinite groups of a result of Hambleton--Kreck on the polarized homotopy classification of Poincaré $4$-complexes, and we prove some partial results on the homotopy classification that are applicable more generally."},{"descriptionType":"Other","description":"24 pages"}],"geoLocations":[],"fundingReferences":[],"url":"https://arxiv.org/abs/2608.03245","contentUrl":null,"metadataVersion":1,"schemaVersion":"http://datacite.org/schema/kernel-4","source":"mds","isActive":true,"state":"findable","reason":null,"viewCount":0,"downloadCount":0,"referenceCount":0,"citationCount":0,"partCount":0,"partOfCount":0,"versionCount":0,"versionOfCount":0,"created":"2026-08-05T02:08:25Z","registered":"2026-08-05T02:08:26Z","published":null,"updated":"2026-08-06T02:21:49Z"},"relationships":{"client":{"data":{"id":"arxiv.content","type":"clients"}}}},{"id":"10.48550/arxiv.2608.03147","type":"dois","attributes":{"doi":"10.48550/arxiv.2608.03147","identifiers":[{"identifier":"2608.03147","identifierType":"arXiv"}],"creators":[{"nameType":"Personal","givenName":"Tingzhang","familyName":"Luo","name":"Luo, Tingzhang","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Ruizhong","familyName":"Liu","name":"Liu, Ruizhong","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Yichao","familyName":"Liu","name":"Liu, Yichao","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Cheng","familyName":"Fan","name":"Fan, Cheng","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Yu","familyName":"Liu","name":"Liu, Yu","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Jianyuan","familyName":"Guo","name":"Guo, Jianyuan","affiliation":[],"nameIdentifiers":[]}],"titles":[{"title":"CROSS: Cascaded Distillation and Dual-Constraint Grounding for Remote Sensing Referring Segmentation"}],"publisher":"arXiv","container":{},"publicationYear":2026,"subjects":[{"subject":"Computer Vision and Pattern Recognition (cs.CV)","lang":"en","subjectScheme":"arXiv"},{"subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"}],"contributors":[],"dates":[{"date":"2026-08-04T05:24:05Z","dateType":"Submitted","dateInformation":"v1"},{"date":"2026-08-05T00:27:33Z","dateType":"Updated","dateInformation":"v1"},{"date":"2026-08-05T06:08:54Z","dateType":"Submitted","dateInformation":"v2"},{"date":"2026-08-06T00:27:36Z","dateType":"Updated","dateInformation":"v2"},{"date":"2026-08","dateType":"Available","dateInformation":"v1"}],"language":null,"types":{"schemaOrg":"CreativeWork","resourceTypeGeneral":"Preprint","citeproc":"article","bibtex":"misc","ris":"GEN","resourceType":"Article"},"relatedIdentifiers":[],"relatedItems":[],"sizes":[],"formats":[],"version":"2","rightsList":[{"rightsUri":"http://arxiv.org/licenses/nonexclusive-distrib/1.0/","rights":"arXiv.org perpetual, non-exclusive license"}],"descriptions":[{"descriptionType":"Abstract","description":"Referring Remote Sensing Image Segmentation (RRSIS) has achieved significant progress through the integration of VLMs and the Segment Anything Model (SAM). However, this progress largely relies on strong pre-trained capabilities, while leaving two fundamental limitations insufficiently addressed: (1) Architectural Weak-Coupling, where the unidirectional flow forces reliance on coarse VLM prompts and wastes SAM's pixel-level structural guidance, causing localization drift; and (2) Object-Centric Semantic Bias, where models overemphasize dominant object semantics while remaining insensitive to spatial reasoning crucial for RRSIS. Motivated by these observations, we propose CROSS, a tightly integrated paradigm for RRSIS. First, we introduce Linguistic-Guided Cascaded Distillation (LGCD) to bridge the architectural gap, which distills SAM's geometric affinities as soft regularizers into VLM intermediate layers, injecting dense structural priors to refine localization. Second, Perspective-Spatial Contrastive Learning (PSCL) imposes cross-anchored constraints by mining mask-filtered deceptive distractors and spatial-linguistic counterfactuals as hard negatives, explicitly shattering semantic shortcuts to enforce genuine logical consistency. Extensive experiments on RRSIS benchmarks demonstrate that CROSS achieves state-of-the-art performance and maintains precise localization even under severe spatial description perturbations, standing as a robust new paradigm for RRSIS."},{"descriptionType":"Other","description":"Accepted at the European Conference on Computer Vision (ECCV) 2026. 20 pages, 6 figures, and 5 tables. Tingzhang Luo and Ruizhong Liu contributed equally. Jianyuan Guo is the corresponding author. Project page: https://clarence-cv.github.io/CROSS/"}],"geoLocations":[],"fundingReferences":[],"url":"https://arxiv.org/abs/2608.03147","contentUrl":null,"metadataVersion":1,"schemaVersion":"http://datacite.org/schema/kernel-4","source":"mds","isActive":true,"state":"findable","reason":null,"viewCount":0,"downloadCount":0,"referenceCount":0,"citationCount":0,"partCount":0,"partOfCount":0,"versionCount":0,"versionOfCount":0,"created":"2026-08-05T02:06:11Z","registered":"2026-08-05T02:06:12Z","published":null,"updated":"2026-08-06T02:21:49Z"},"relationships":{"client":{"data":{"id":"arxiv.content","type":"clients"}}}},{"id":"10.48550/arxiv.2608.02870","type":"dois","attributes":{"doi":"10.48550/arxiv.2608.02870","identifiers":[{"identifier":"2608.02870","identifierType":"arXiv"}],"creators":[{"nameType":"Personal","givenName":"Bo","familyName":"Liu","name":"Liu, Bo","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Qiang","familyName":"Liu","name":"Liu, Qiang","affiliation":[],"nameIdentifiers":[]}],"titles":[{"title":"Maglev: Sliding Recurrent Memory"}],"publisher":"arXiv","container":{},"publicationYear":2026,"subjects":[{"subject":"Machine Learning (cs.LG)","lang":"en","subjectScheme":"arXiv"},{"subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"}],"contributors":[],"dates":[{"date":"2026-08-03T20:40:49Z","dateType":"Submitted","dateInformation":"v1"},{"date":"2026-08-05T00:09:25Z","dateType":"Updated","dateInformation":"v1"},{"date":"2026-08-05T16:58:35Z","dateType":"Submitted","dateInformation":"v2"},{"date":"2026-08-06T01:00:18Z","dateType":"Updated","dateInformation":"v2"},{"date":"2026-08","dateType":"Available","dateInformation":"v1"}],"language":null,"types":{"schemaOrg":"CreativeWork","resourceTypeGeneral":"Preprint","citeproc":"article","bibtex":"misc","ris":"GEN","resourceType":"Article"},"relatedIdentifiers":[],"relatedItems":[],"sizes":[],"formats":[],"version":"2","rightsList":[{"rightsIdentifierScheme":"SPDX","rightsUri":"https://creativecommons.org/licenses/by/4.0/legalcode","schemeUri":"https://spdx.org/licenses/","rights":"Creative Commons Attribution 4.0 International","rightsIdentifier":"cc-by-4.0"}],"descriptions":[{"descriptionType":"Abstract","description":"We introduce \\ours{}, a recurrent Transformer architecture with fixed-size memory that generalizes sliding-window attention while remaining parallelizable during training. \\ours{} consists of two coupled models: a prefiller $Q$, which leverages full attention\\footnote{In practice, we use interleaved full and sliding-window attention for $Q$, as this yields stronger performance. The essential requirement is that $Q$ be more expressive than $P$, with access to the full history.} to produce memory targets $m'_t$, and a decoder $P$, which uses only sliding-window attention and recurrent K/V injection to produce decoder memories $m_t$ for next-token prediction. We train \\ours{} with a memory consistency loss that aligns $m_t$ with $m'_t$, allowing inference to use $P$ alone. Empirically, \\ours{} improves validation loss and downstream pretraining benchmarks over sliding-window and latent recurrent transformer baselines. Moreover, sharing parameters between $P$ and $Q$ reduces parameter memory while preserving most of the gains."},{"descriptionType":"Other","description":"Neural Architecture Research"}],"geoLocations":[],"fundingReferences":[],"url":"https://arxiv.org/abs/2608.02870","contentUrl":null,"metadataVersion":1,"schemaVersion":"http://datacite.org/schema/kernel-4","source":"mds","isActive":true,"state":"findable","reason":null,"viewCount":0,"downloadCount":0,"referenceCount":0,"citationCount":0,"partCount":0,"partOfCount":0,"versionCount":0,"versionOfCount":0,"created":"2026-08-05T01:59:46Z","registered":"2026-08-05T01:59:47Z","published":null,"updated":"2026-08-06T02:21:46Z"},"relationships":{"client":{"data":{"id":"arxiv.content","type":"clients"}}}},{"id":"10.48550/arxiv.2608.02835","type":"dois","attributes":{"doi":"10.48550/arxiv.2608.02835","identifiers":[{"identifier":"2608.02835","identifierType":"arXiv"}],"creators":[{"nameType":"Personal","givenName":"Saptarshi Neil","familyName":"Sinha","name":"Sinha, Saptarshi Neil","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Tiago","familyName":"Kleist","name":"Kleist, Tiago","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Giorgio","familyName":"Trumpy","name":"Trumpy, Giorgio","affiliation":[],"nameIdentifiers":[]}],"titles":[{"title":"A Human-in-the-Loop Deep Learning Framework for Color Reconstruction of Lenticular Films"}],"publisher":"arXiv","container":{},"publicationYear":2026,"subjects":[{"subject":"Computer Vision and Pattern Recognition (cs.CV)","lang":"en","subjectScheme":"arXiv"},{"subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"}],"contributors":[],"dates":[{"date":"2026-08-03T19:48:48Z","dateType":"Submitted","dateInformation":"v1"},{"date":"2026-08-05T00:07:13Z","dateType":"Updated","dateInformation":"v1"},{"date":"2026-08-05T09:00:12Z","dateType":"Submitted","dateInformation":"v2"},{"date":"2026-08-06T00:33:53Z","dateType":"Updated","dateInformation":"v2"},{"date":"2026-08","dateType":"Available","dateInformation":"v1"}],"language":null,"types":{"schemaOrg":"CreativeWork","resourceTypeGeneral":"Preprint","citeproc":"article","bibtex":"misc","ris":"GEN","resourceType":"Article"},"relatedIdentifiers":[],"relatedItems":[],"sizes":[],"formats":[],"version":"2","rightsList":[{"rightsUri":"http://arxiv.org/licenses/nonexclusive-distrib/1.0/","rights":"arXiv.org perpetual, non-exclusive license"}],"descriptions":[{"descriptionType":"Abstract","description":"Historical lenticular films, such as those created with the Kodacolor process, encode color information in a distinctive spatial format. This structure requires specialized techniques for accurate color reconstruction. While recent signal processing approaches like doLCE and deep learning methods like deep-doLCE have advanced automated color recovery, they often fail with cases such as curved lenticules, low-contrast, or badly captured regions. We propose a human-in-the-loop (HITL) deep learning framework which is designed for color reconstruction in lenticular films. Our approach introduces an editable, vector-based representation of lenticule boundaries, allowing experts to interactively refine boundary positions before color extraction and demosaicing. This decoupled architecture enables targeted corrections and iterative fine-tuning, embedding expert knowledge into the detection model and improving robustness across challenging frames. To preserve image details using information solely present in the original silver emulsion, we merge the reconstructed chrominance with the original film scan's luminance. We evaluate our pipeline on a challenging lenticular film sequence where previous automated approaches fail and the reconstructed colors are not suitable for exhibition. In contrast, our HITL approach successfully produces high-quality, exhibitable color reconstructions with preserved texture. This work is the first to combine expert guidance, editable intermediate representations, and texture-preserving post-processing for lenticular film color reconstruction, advancing the state of the art in this field."}],"geoLocations":[],"fundingReferences":[],"url":"https://arxiv.org/abs/2608.02835","contentUrl":null,"metadataVersion":1,"schemaVersion":"http://datacite.org/schema/kernel-4","source":"mds","isActive":true,"state":"findable","reason":null,"viewCount":0,"downloadCount":0,"referenceCount":0,"citationCount":0,"partCount":0,"partOfCount":0,"versionCount":0,"versionOfCount":0,"created":"2026-08-05T01:58:57Z","registered":"2026-08-05T01:58:58Z","published":null,"updated":"2026-08-06T02:21:45Z"},"relationships":{"client":{"data":{"id":"arxiv.content","type":"clients"}}}},{"id":"10.48550/arxiv.2608.02770","type":"dois","attributes":{"doi":"10.48550/arxiv.2608.02770","identifiers":[{"identifier":"2608.02770","identifierType":"arXiv"}],"creators":[{"nameType":"Personal","givenName":"Duy","familyName":"Nguyen","name":"Nguyen, Duy","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Hari","familyName":"Paudyal","name":"Paudyal, Hari","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Joseph R.","familyName":"Sink","name":"Sink, Joseph R.","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Michael E.","familyName":"Flatte","name":"Flatte, Michael E.","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Jay A.","familyName":"Gupta","name":"Gupta, Jay A.","affiliation":[],"nameIdentifiers":[]}],"titles":[{"title":"Broken site symmetry of Fe adatoms on Bi$_2$Te$_3$"}],"publisher":"arXiv","container":{},"publicationYear":2026,"subjects":[{"subject":"Mesoscale and Nanoscale Physics (cond-mat.mes-hall)","lang":"en","subjectScheme":"arXiv"},{"subject":"FOS: Physical sciences","subjectScheme":"Fields of Science and Technology (FOS)"}],"contributors":[],"dates":[{"date":"2026-08-03T18:11:29Z","dateType":"Submitted","dateInformation":"v1"},{"date":"2026-08-05T00:03:31Z","dateType":"Updated","dateInformation":"v1"},{"date":"2026-08-05T05:35:07Z","dateType":"Submitted","dateInformation":"v2"},{"date":"2026-08-06T00:26:03Z","dateType":"Updated","dateInformation":"v2"},{"date":"2026-08","dateType":"Available","dateInformation":"v1"}],"language":null,"types":{"schemaOrg":"CreativeWork","resourceTypeGeneral":"Preprint","citeproc":"article","bibtex":"misc","ris":"GEN","resourceType":"Article"},"relatedIdentifiers":[],"relatedItems":[],"sizes":[],"formats":[],"version":"2","rightsList":[{"rightsUri":"http://arxiv.org/licenses/nonexclusive-distrib/1.0/","rights":"arXiv.org perpetual, non-exclusive license"}],"descriptions":[{"descriptionType":"Abstract","description":"We report a combined scanning tunneling microscopy and atomistic theoretical study of Fe adatoms on the Bi$_2$Te$_3$(111) surface. Topographic imaging at $4.5$~K shows that Fe adatoms in fcc and hcp hollow sites exhibit a threefold-symmetric contrast, consistent with the $C_{3v}$ symmetry of the adsorption site. However, simultaneously acquired differential conductance ($dI/dV$) maps reveal a pronounced reduction in symmetry, evidenced by differential contrast observed at nearest-neighbor Te sites. Density functional theory calculations show that the Fe/Bi$_2$Te$_3$ system undergoes a static Jahn--Teller distortion, reducing the adsorption symmetry from $C_{3v}$ to $C_{1v}$, with the distorted configuration favored by $72.5$~meV. Orbital-projected density of states calculations show that the occupied states near the Fermi level are dominated by $d_{xz}$ and $d_{yz}$ orbitals, whereas the unoccupied states are primarily of $d_{z^2}$, $d_{x^2-y^2}$, and $d_{xy}$ character. The local density of states from these orbitals is in good qualitative agreement with experimental $dI/dV$ spectra. Furthermore, simulated local-density-of-states maps using a tight-binding Green's function approach are consistent with experimental $dI/dV$ maps, confirming that the reduced symmetry originates from the $C_{1v}$ structural distortion."},{"descriptionType":"Other","description":"7 pages, 5 figures"}],"geoLocations":[],"fundingReferences":[],"url":"https://arxiv.org/abs/2608.02770","contentUrl":null,"metadataVersion":1,"schemaVersion":"http://datacite.org/schema/kernel-4","source":"mds","isActive":true,"state":"findable","reason":null,"viewCount":0,"downloadCount":0,"referenceCount":0,"citationCount":0,"partCount":0,"partOfCount":0,"versionCount":0,"versionOfCount":0,"created":"2026-08-05T01:57:27Z","registered":"2026-08-05T01:57:28Z","published":null,"updated":"2026-08-06T02:21:44Z"},"relationships":{"client":{"data":{"id":"arxiv.content","type":"clients"}}}},{"id":"10.48550/arxiv.2608.02684","type":"dois","attributes":{"doi":"10.48550/arxiv.2608.02684","identifiers":[{"identifier":"2608.02684","identifierType":"arXiv"}],"creators":[{"nameType":"Personal","givenName":"Shu","familyName":"Quan","name":"Quan, Shu","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Tianfang","familyName":"Hao","name":"Hao, Tianfang","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Sitong","familyName":"Fang","name":"Fang, Sitong","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"He","familyName":"Geng","name":"Geng, He","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Jiayi","familyName":"Zhou","name":"Zhou, Jiayi","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Boyuan","familyName":"Chen","name":"Chen, Boyuan","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Kaile","familyName":"Wang","name":"Wang, Kaile","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Donghai","familyName":"Hong","name":"Hong, Donghai","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Juntao","familyName":"Dai","name":"Dai, Juntao","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Yaodong","familyName":"Yang","name":"Yang, Yaodong","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Jiaming","familyName":"Ji","name":"Ji, Jiaming","affiliation":[],"nameIdentifiers":[]}],"titles":[{"title":"A Blind Spot in Alignment: Quantifying Biosecurity Risks in Large Language Models"}],"publisher":"arXiv","container":{},"publicationYear":2026,"subjects":[{"subject":"Quantitative Methods (q-bio.QM)","lang":"en","subjectScheme":"arXiv"},{"subject":"Artificial Intelligence (cs.AI)","lang":"en","subjectScheme":"arXiv"},{"subject":"FOS: Biological sciences","subjectScheme":"Fields of Science and Technology (FOS)"},{"subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"}],"contributors":[],"dates":[{"date":"2026-08-03T03:51:19Z","dateType":"Submitted","dateInformation":"v1"},{"date":"2026-08-05T00:01:43Z","dateType":"Updated","dateInformation":"v1"},{"date":"2026-08-05T14:49:10Z","dateType":"Submitted","dateInformation":"v2"},{"date":"2026-08-06T00:52:44Z","dateType":"Updated","dateInformation":"v2"},{"date":"2026-08","dateType":"Available","dateInformation":"v1"}],"language":null,"types":{"schemaOrg":"CreativeWork","resourceTypeGeneral":"Preprint","citeproc":"article","bibtex":"misc","ris":"GEN","resourceType":"Article"},"relatedIdentifiers":[],"relatedItems":[],"sizes":[],"formats":[],"version":"2","rightsList":[{"rightsIdentifierScheme":"SPDX","rightsUri":"https://creativecommons.org/licenses/by/4.0/legalcode","schemeUri":"https://spdx.org/licenses/","rights":"Creative Commons Attribution 4.0 International","rightsIdentifier":"cc-by-4.0"}],"descriptions":[{"descriptionType":"Abstract","description":"Large Language Models (LLMs) are accelerating biological research, yet this same capability poses a critical biosecurity threat: models that assist in protein engineering can equally be prompted to generate predicted toxin-like sequences, potentially lowering the barrier to biological misuse. Current safety evaluations, however, operate in natural language and cannot determine whether a model-generated amino acid sequence is biological gibberish or a computational risk signal. To address this evaluation blind spot, we introduce SPIKE-Bench, coupling 631 curated toxin-design prompts across seven functional categories with the SPIKE funnel, a three-stage protocol that filters output through compliance, biological plausibility, and predicted toxicity, producing stage-level diagnostics and an aggregate function-aware metric: the Functional Harmfulness Rate (FHR). An audit of 32 LLMs reveals that most models freely comply with toxin-design requests; FHR is driven primarily by biological generation capability rather than safety alignment, reaching 50.7%; and Refusal Rate fails to predict functional risk. As a first step toward mitigation, we provide BioSafe-Guard, a domain-specialized classifier that substantially reduces predicted functional risk while preserving benign utility. We release SPIKE-Bench and BioSafe-Guard at https://github.com/PKU-Alignment/SPIKE-Bench to support more rigorous biosecurity evaluation of LLMs."},{"descriptionType":"Other","description":"Accepted to COLM 2026. 40 pages, 9 figures"}],"geoLocations":[],"fundingReferences":[],"url":"https://arxiv.org/abs/2608.02684","contentUrl":null,"metadataVersion":1,"schemaVersion":"http://datacite.org/schema/kernel-4","source":"mds","isActive":true,"state":"findable","reason":null,"viewCount":0,"downloadCount":0,"referenceCount":0,"citationCount":0,"partCount":0,"partOfCount":0,"versionCount":0,"versionOfCount":0,"created":"2026-08-05T01:55:29Z","registered":"2026-08-05T01:55:30Z","published":null,"updated":"2026-08-06T02:21:41Z"},"relationships":{"client":{"data":{"id":"arxiv.content","type":"clients"}}}},{"id":"10.48550/arxiv.2608.02652","type":"dois","attributes":{"doi":"10.48550/arxiv.2608.02652","identifiers":[{"identifier":"2608.02652","identifierType":"arXiv"}],"creators":[{"nameType":"Personal","givenName":"Faizuddin","familyName":"Ahmed","name":"Ahmed, Faizuddin","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Md Sabir","familyName":"Ali","name":"Ali, Md Sabir","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Adnan","familyName":"Malik","name":"Malik, Adnan","affiliation":[],"nameIdentifiers":[]}],"titles":[{"title":"Topologically Charged Morris-Thorne-type Wormholes and the Energy Conditions"}],"publisher":"arXiv","container":{},"publicationYear":2026,"subjects":[{"subject":"General Relativity and Quantum Cosmology (gr-qc)","lang":"en","subjectScheme":"arXiv"},{"subject":"High Energy Physics - Theory (hep-th)","lang":"en","subjectScheme":"arXiv"},{"subject":"FOS: Physical sciences","subjectScheme":"Fields of Science and Technology (FOS)"}],"contributors":[],"dates":[{"date":"2026-08-01T01:56:28Z","dateType":"Submitted","dateInformation":"v1"},{"date":"2026-08-05T00:00:59Z","dateType":"Updated","dateInformation":"v1"},{"date":"2026-08-05T03:27:49Z","dateType":"Submitted","dateInformation":"v2"},{"date":"2026-08-06T00:21:45Z","dateType":"Updated","dateInformation":"v2"},{"date":"2026-08","dateType":"Available","dateInformation":"v1"}],"language":null,"types":{"schemaOrg":"CreativeWork","resourceTypeGeneral":"Preprint","citeproc":"article","bibtex":"misc","ris":"GEN","resourceType":"Article"},"relatedIdentifiers":[],"relatedItems":[],"sizes":[],"formats":[],"version":"2","rightsList":[{"rightsIdentifierScheme":"SPDX","rightsUri":"https://creativecommons.org/licenses/by/4.0/legalcode","schemeUri":"https://spdx.org/licenses/","rights":"Creative Commons Attribution 4.0 International","rightsIdentifier":"cc-by-4.0"}],"descriptions":[{"descriptionType":"Abstract","description":"In this paper, we investigate topologically charged Morris-Thorne-type traversable wormholes by solving the Einstein field equations with an anisotropic fluid as the energy-momentum tensor and analysing the resulting solutions. In continuation to the earlier work (Eur. Phys. J C {\\bf 84} (2024) 1037), we consider the shape functions such as: (i) $A(r)=r_0\\,e^{r_0-r}$; (ii) $A(r)=r_0\\,a^r/a^{r_0}$,\\quad $0 \u0026lt; a\u0026lt;1$; (iii) $A(r)=r_0\\,\\left(\\frac{\\cosh r_0}{\\cosh r}\\right)^δ$,\\quad $δ\\geq 1$; (iv) $A(r)=\\frac{1}{r}+\\ln\\!\\frac{r}{r_0}$; (v) $A(r)=B\\,r^n+(1-B)$; (vi) $A(r)=r_0\\,\\frac{\\mbox{ln} (1+r)}{\\mbox{ln} (1+r_0)}$, (vii) $A(r)=r_0+a\\,r_0\\,\\left[\\left(\\frac{r}{r_0}\\right)^β-1\\right]$, where $β\u0026lt;1$ and $0 \u0026lt; a\\,β\u0026lt;1$. We examine the energy conditions-namely, null, weak, strong, and dominant energy conditions and explore how topological charge influences or controls these conditions. Additionally, we calculate the anisotropy parameter to determine whether the wormhole geometry exhibits attractive or repulsive behavior. Our analysis demonstrates that the energy density of the anisotropic fluid is always positive. However, while some of the energy conditions are partially satisfied, others are violated."},{"descriptionType":"Other","description":"Improved results and discussion only"}],"geoLocations":[],"fundingReferences":[],"url":"https://arxiv.org/abs/2608.02652","contentUrl":null,"metadataVersion":1,"schemaVersion":"http://datacite.org/schema/kernel-4","source":"mds","isActive":true,"state":"findable","reason":null,"viewCount":0,"downloadCount":0,"referenceCount":0,"citationCount":0,"partCount":0,"partOfCount":0,"versionCount":0,"versionOfCount":0,"created":"2026-08-05T01:54:45Z","registered":"2026-08-05T01:54:46Z","published":null,"updated":"2026-08-06T02:21:40Z"},"relationships":{"client":{"data":{"id":"arxiv.content","type":"clients"}}}},{"id":"10.48550/arxiv.2608.04010","type":"dois","attributes":{"doi":"10.48550/arxiv.2608.04010","identifiers":[{"identifier":"2608.04010","identifierType":"arXiv"}],"creators":[{"nameType":"Personal","givenName":"Yang","familyName":"Yang","name":"Yang, Yang","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Qinyu","familyName":"Zhao","name":"Zhao, Qinyu","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Mouxiang","familyName":"Chen","name":"Chen, Mouxiang","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Xiaohui","familyName":"Li","name":"Li, Xiaohui","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Lixin","familyName":"Gu","name":"Gu, Lixin","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Wenhai","familyName":"Wang","name":"Wang, Wenhai","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Hongjie","familyName":"Zhang","name":"Zhang, Hongjie","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Wenwei","familyName":"Zhang","name":"Zhang, Wenwei","affiliation":[],"nameIdentifiers":[]}],"titles":[{"title":"ParVL: Parallel Scaling and Expandable Compute Allocation for Multimodal LLMs"}],"publisher":"arXiv","container":{},"publicationYear":2026,"subjects":[{"subject":"Computer Vision and Pattern Recognition (cs.CV)","lang":"en","subjectScheme":"arXiv"},{"subject":"Computation and Language (cs.CL)","lang":"en","subjectScheme":"arXiv"},{"subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"}],"contributors":[],"dates":[{"date":"2026-08-04T17:59:58Z","dateType":"Submitted","dateInformation":"v1"},{"date":"2026-08-05T01:10:13Z","dateType":"Updated","dateInformation":"v1"},{"date":"2026-08","dateType":"Available","dateInformation":"v1"}],"language":null,"types":{"schemaOrg":"CreativeWork","resourceTypeGeneral":"Preprint","citeproc":"article","bibtex":"misc","ris":"GEN","resourceType":"Article"},"relatedIdentifiers":[],"relatedItems":[],"sizes":[],"formats":[],"version":"1","rightsList":[{"rightsUri":"http://arxiv.org/licenses/nonexclusive-distrib/1.0/","rights":"arXiv.org perpetual, non-exclusive license"}],"descriptions":[{"descriptionType":"Abstract","description":"Existing scaling strategies for Multimodal Large Language Models (MLLMs) typically expand either model parameters or sequential inference computation, incurring substantial memory or latency overhead. More importantly, most existing methods fail to alter the rigid, fixed computation allocation between the Vision Transformer and the Large Language Model components, limiting task-specific optimization. To address this, we introduce the Parallel Vision-Language (ParVL) scaling framework for MLLMs, which scales parallel computation by reusing the existing ViT and LLM backbone parameters across multiple vision and language branches. This framework raises a central question: given a fixed backbone parameter budget, how should additional shared-backbone computation be allocated between the vision and language modalities? We instantiate each parallel computational stream with branch-specific prefix parameters over a shared backbone, and train the entire model end-to-end via full-parameter supervised fine-tuning on roughly 13B tokens. We systematically study the computation-allocation trade-off between the ViT encoder and LLM decoder. ParVL improves overall multimodal performance over same-recipe single-branch baselines, and the best evaluated vision--language allocation varies across tasks. Code is available at https://github.com/YangYangGirl/ParVL."},{"descriptionType":"Other","description":"14 pages, 4 figures"}],"geoLocations":[],"fundingReferences":[],"url":"https://arxiv.org/abs/2608.04010","contentUrl":null,"metadataVersion":0,"schemaVersion":"http://datacite.org/schema/kernel-4","source":"mds","isActive":true,"state":"findable","reason":null,"viewCount":0,"downloadCount":0,"referenceCount":0,"citationCount":0,"partCount":0,"partOfCount":0,"versionCount":0,"versionOfCount":0,"created":"2026-08-05T02:26:06Z","registered":"2026-08-05T02:26:06Z","published":null,"updated":"2026-08-05T02:26:06Z"},"relationships":{"client":{"data":{"id":"arxiv.content","type":"clients"}}}},{"id":"10.48550/arxiv.2608.04008","type":"dois","attributes":{"doi":"10.48550/arxiv.2608.04008","identifiers":[{"identifier":"2608.04008","identifierType":"arXiv"}],"creators":[{"nameType":"Personal","givenName":"Zhenran","familyName":"Wang","name":"Wang, Zhenran","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Zhonghan","familyName":"Bian","name":"Bian, Zhonghan","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Jinsong","familyName":"Li","name":"Li, Jinsong","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Zhangyang","familyName":"Qi","name":"Qi, Zhangyang","affiliation":[],"nameIdentifiers":[]}],"titles":[{"title":"WorldCup Arena: Prospective, Leakage-Free Evaluation of Frontier LLMs on a Live Tournament"}],"publisher":"arXiv","container":{},"publicationYear":2026,"subjects":[{"subject":"Computation and Language (cs.CL)","lang":"en","subjectScheme":"arXiv"},{"subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"}],"contributors":[],"dates":[{"date":"2026-08-04T17:59:55Z","dateType":"Submitted","dateInformation":"v1"},{"date":"2026-08-05T01:10:10Z","dateType":"Updated","dateInformation":"v1"},{"date":"2026-08","dateType":"Available","dateInformation":"v1"}],"language":null,"types":{"schemaOrg":"CreativeWork","resourceTypeGeneral":"Preprint","citeproc":"article","bibtex":"misc","ris":"GEN","resourceType":"Article"},"relatedIdentifiers":[],"relatedItems":[],"sizes":[],"formats":[],"version":"1","rightsList":[{"rightsIdentifierScheme":"SPDX","rightsUri":"https://creativecommons.org/licenses/by/4.0/legalcode","schemeUri":"https://spdx.org/licenses/","rights":"Creative Commons Attribution 4.0 International","rightsIdentifier":"cc-by-4.0"}],"descriptions":[{"descriptionType":"Abstract","description":"Benchmarks that measure the forecasting ability of large language models are almost always retrospective: the event has happened, the answer is somewhere on the Web, and the evaluation must defend itself against memorisation. We report the opposite design. Over the 39 days of the 2026 FIFA World Cup, six frontier LLMs -- all with extended thinking and native server-side web search -- were asked before every kickoff, one match at a time, to fill in a seven-market prediction card for all 104 matches, plus 12 group winners and a pre-tournament outright pool; no answer existed when the question was asked, so the evaluation is leakage-free by construction rather than by filtering, and the frozen archive holds 4,494 scored predictions. What the tournament establishes is a set of behaviours the six systems share. On match outcome they average 63.9%, level with backing the bookmaker's favourite -- which is in fact what they usually do. They agree with one another far more often than they are right, so a majority vote adds nothing. They under-commit to draws and to goals, and crowd their scoreline picks onto a single prototypical result. Accuracy tracks how lopsided a fixture is rather than how much is known about it: it collapses in the closest ties, where the dossiers are richest, while questions about the tournament as a whole are answered well. On this task the current generation of frontier systems is not sharply differentiated: the standings hold up at the top and the bottom across the run and churn in the middle, and the margins stay narrow throughout. The briefing dossiers, fixtures and official results are released as a benchmark, together with the scoring code."},{"descriptionType":"Other","description":"Project page: https://co-minder.github.io/worldcup2026"}],"geoLocations":[],"fundingReferences":[],"url":"https://arxiv.org/abs/2608.04008","contentUrl":null,"metadataVersion":0,"schemaVersion":"http://datacite.org/schema/kernel-4","source":"mds","isActive":true,"state":"findable","reason":null,"viewCount":0,"downloadCount":0,"referenceCount":0,"citationCount":0,"partCount":0,"partOfCount":0,"versionCount":0,"versionOfCount":0,"created":"2026-08-05T02:26:03Z","registered":"2026-08-05T02:26:04Z","published":null,"updated":"2026-08-05T02:26:04Z"},"relationships":{"client":{"data":{"id":"arxiv.content","type":"clients"}}}},{"id":"10.48550/arxiv.2608.04007","type":"dois","attributes":{"doi":"10.48550/arxiv.2608.04007","identifiers":[{"identifier":"2608.04007","identifierType":"arXiv"}],"creators":[{"nameType":"Personal","givenName":"Changle","familyName":"Qu","name":"Qu, Changle","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Sunhao","familyName":"Dai","name":"Dai, Sunhao","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Hengyi","familyName":"Cai","name":"Cai, Hengyi","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Yuqi","familyName":"Zhou","name":"Zhou, Yuqi","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Xinran","familyName":"Chen","name":"Chen, Xinran","affiliation":[],"nameIdentifiers":[]},{"nameType":"Organizational","name":"Simon","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Jun","familyName":"Xu","name":"Xu, Jun","affiliation":[],"nameIdentifiers":[]}],"titles":[{"title":"TurnSight: Turn-Level Hindsight Self-Distillation for Tool-Integrated Reasoning"}],"publisher":"arXiv","container":{},"publicationYear":2026,"subjects":[{"subject":"Computation and Language (cs.CL)","lang":"en","subjectScheme":"arXiv"},{"subject":"Artificial Intelligence (cs.AI)","lang":"en","subjectScheme":"arXiv"},{"subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"}],"contributors":[],"dates":[{"date":"2026-08-04T17:59:21Z","dateType":"Submitted","dateInformation":"v1"},{"date":"2026-08-05T01:10:04Z","dateType":"Updated","dateInformation":"v1"},{"date":"2026-08","dateType":"Available","dateInformation":"v1"}],"language":null,"types":{"schemaOrg":"CreativeWork","resourceTypeGeneral":"Preprint","citeproc":"article","bibtex":"misc","ris":"GEN","resourceType":"Article"},"relatedIdentifiers":[],"relatedItems":[],"sizes":[],"formats":[],"version":"1","rightsList":[{"rightsIdentifierScheme":"SPDX","rightsUri":"https://creativecommons.org/licenses/by-nc-nd/4.0/legalcode","schemeUri":"https://spdx.org/licenses/","rights":"Creative Commons Attribution Non Commercial No Derivatives 4.0 International","rightsIdentifier":"cc-by-nc-nd-4.0"}],"descriptions":[{"descriptionType":"Abstract","description":"Tool-Integrated Reasoning (TIR) enables LLMs to solve complex tasks through iterative tool interactions. However, existing reinforcement learning methods often rely on trajectory-level supervision, limiting fine-grained credit assignment in long-horizon TIR scenarios. On-policy self-distillation offers denser signals through teacher branches with privileged context, but existing approaches typically derive such context from ground-truth answers or retrieved skills, which may not reflect the states actually visited by the agent. Moreover, token-level supervision fails to capture the turn-level structure of tool interactions. To address this, we propose TurnSight, a turn-level hindsight self-distillation framework that derives supervision directly from execution-conditioned hindsight. It then constructs multiple hindsight views with different lookahead horizons and selects reliable supervision through cross-horizon directional agreement. Finally, the selected hindsight signal is normalized across sibling rollouts and used to adaptively modulate RL advantages while preserving their original optimization direction. Extensive experiments on three benchmarks demonstrate the effectiveness of TurnSight. Our codes are available at https://github.com/quchangle1/TurnSight."}],"geoLocations":[],"fundingReferences":[],"url":"https://arxiv.org/abs/2608.04007","contentUrl":null,"metadataVersion":0,"schemaVersion":"http://datacite.org/schema/kernel-4","source":"mds","isActive":true,"state":"findable","reason":null,"viewCount":0,"downloadCount":0,"referenceCount":0,"citationCount":0,"partCount":0,"partOfCount":0,"versionCount":0,"versionOfCount":0,"created":"2026-08-05T02:26:02Z","registered":"2026-08-05T02:26:02Z","published":null,"updated":"2026-08-05T02:26:02Z"},"relationships":{"client":{"data":{"id":"arxiv.content","type":"clients"}}}},{"id":"10.48550/arxiv.2608.04006","type":"dois","attributes":{"doi":"10.48550/arxiv.2608.04006","identifiers":[{"identifier":"2608.04006","identifierType":"arXiv"}],"creators":[{"nameType":"Personal","givenName":"Adam","familyName":"Coscia","name":"Coscia, Adam","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Sujata","familyName":"Duwal","name":"Duwal, Sujata","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Langdon","familyName":"Holmes","name":"Holmes, Langdon","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Scott","familyName":"Crossley","name":"Crossley, Scott","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Alex","familyName":"Endert","name":"Endert, Alex","affiliation":[],"nameIdentifiers":[]}],"titles":[{"title":"Calibrating Trustworthiness: Co-Designing Metrics and Visualizations for Evaluating LLMs in Education"}],"publisher":"arXiv","container":{},"publicationYear":2026,"subjects":[{"subject":"Human-Computer Interaction (cs.HC)","lang":"en","subjectScheme":"arXiv"},{"subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"}],"contributors":[],"dates":[{"date":"2026-08-04T17:59:20Z","dateType":"Submitted","dateInformation":"v1"},{"date":"2026-08-05T01:10:01Z","dateType":"Updated","dateInformation":"v1"},{"date":"2026-08","dateType":"Available","dateInformation":"v1"}],"language":null,"types":{"schemaOrg":"CreativeWork","resourceTypeGeneral":"Preprint","citeproc":"article","bibtex":"misc","ris":"GEN","resourceType":"Article"},"relatedIdentifiers":[],"relatedItems":[],"sizes":[],"formats":[],"version":"1","rightsList":[{"rightsIdentifierScheme":"SPDX","rightsUri":"https://creativecommons.org/licenses/by/4.0/legalcode","schemeUri":"https://spdx.org/licenses/","rights":"Creative Commons Attribution 4.0 International","rightsIdentifier":"cc-by-4.0"}],"descriptions":[{"descriptionType":"Abstract","description":"LLMs are reshaping educational technology, yet evaluating their responses for pedagogical alignment remains underexplored, relying heavily on the expertise of learning engineers building the technology. To bridge this gap, we explore trustworthiness as a structured lens for evaluation, leveraging existing measures of LLM trustworthiness to systematically identify potential pedagogical disruptions. Through a longitudinal co-design process with learning engineers developing an LLM-powered digital textbook, we: (1) co-constructed five trustworthiness metrics comprising 20 measures tailored to pedagogical use; (2) designed visualizations that map trustworthiness violations onto LLM responses; and (3) evaluated how these tools help learning engineers make A/B comparisons of LLM responses. Making trustworthiness explicit increased inter-rater reliability while helping learning engineers resolve conflicting objectives and produce more consistent judgments. We discuss the emergent benefits of trustworthiness as a lens for evaluating LLMs in education and propose new design guidelines for future evaluation tools that enable pedagogically-aligned, LLM-powered learning tools."},{"descriptionType":"Other","description":"Under review. 48 pages, 22 figures, 2 tables"}],"geoLocations":[],"fundingReferences":[],"url":"https://arxiv.org/abs/2608.04006","contentUrl":null,"metadataVersion":0,"schemaVersion":"http://datacite.org/schema/kernel-4","source":"mds","isActive":true,"state":"findable","reason":null,"viewCount":0,"downloadCount":0,"referenceCount":0,"citationCount":0,"partCount":0,"partOfCount":0,"versionCount":0,"versionOfCount":0,"created":"2026-08-05T02:26:00Z","registered":"2026-08-05T02:26:01Z","published":null,"updated":"2026-08-05T02:26:01Z"},"relationships":{"client":{"data":{"id":"arxiv.content","type":"clients"}}}},{"id":"10.48550/arxiv.2608.04005","type":"dois","attributes":{"doi":"10.48550/arxiv.2608.04005","identifiers":[{"identifier":"2608.04005","identifierType":"arXiv"}],"creators":[{"nameType":"Personal","givenName":"Giovanni","familyName":"Antinozzi","name":"Antinozzi, Giovanni","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Guillermo Franco","familyName":"Abellán","name":"Abellán, Guillermo Franco","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Davide","familyName":"Sciotti","name":"Sciotti, Davide","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Matteo","familyName":"Martinelli","name":"Martinelli, Matteo","affiliation":[],"nameIdentifiers":[]}],"titles":[{"title":"Cosmology in the Einstein Telescope era: comparing traditional and simulation-based methods for population inference"}],"publisher":"arXiv","container":{},"publicationYear":2026,"subjects":[{"subject":"Cosmology and Nongalactic Astrophysics (astro-ph.CO)","lang":"en","subjectScheme":"arXiv"},{"subject":"Instrumentation and Methods for Astrophysics (astro-ph.IM)","lang":"en","subjectScheme":"arXiv"},{"subject":"General Relativity and Quantum Cosmology (gr-qc)","lang":"en","subjectScheme":"arXiv"},{"subject":"FOS: Physical sciences","subjectScheme":"Fields of Science and Technology (FOS)"}],"contributors":[],"dates":[{"date":"2026-08-04T17:59:09Z","dateType":"Submitted","dateInformation":"v1"},{"date":"2026-08-05T01:10:00Z","dateType":"Updated","dateInformation":"v1"},{"date":"2026-08","dateType":"Available","dateInformation":"v1"}],"language":null,"types":{"schemaOrg":"CreativeWork","resourceTypeGeneral":"Preprint","citeproc":"article","bibtex":"misc","ris":"GEN","resourceType":"Article"},"relatedIdentifiers":[],"relatedItems":[],"sizes":[],"formats":[],"version":"1","rightsList":[{"rightsUri":"http://arxiv.org/licenses/nonexclusive-distrib/1.0/","rights":"arXiv.org perpetual, non-exclusive license"}],"descriptions":[{"descriptionType":"Abstract","description":"The next generation of gravitational wave detectors, such as the Einstein Telescope (ET), will observe orders of magnitude more binary black hole mergers than current facilities. Most of these events will lack an electromagnetic counterpart, also known as dark siren events, yet will still enable percent-level cosmological constraints. However, the likelihood traditionally used in Hierarchical Bayesian Inference (HBI) for population-level analyses becomes computationally prohibitive as the size of dark siren catalogues and population parameters grow. In this work we compare HBI against simulation-based inference (SBI) as a scalable alternative for cosmological population inference in the ET era. Studying a proof-of-concept example of a mock ET inference, we build a catalogue of $O(10^4)$ binary black hole events, then perform inference on the Hubble constant $H_0$ and matter density $Ω_m$ in a flat $Λ$CDM cosmology, using both a hierarchical analytical likelihood and Marginal Neural Ratio Estimation (MNRE). We find excellent agreement between the two approaches, with SBI reproducing the HBI posteriors to high accuracy, while requiring orders of magnitude less computation once the simulation and training cost is amortized. We further demonstrate that SBI extends straightforwardly to a joint cosmology-plus-astrophysics analysis, simultaneously constraining $(H_0,Ω_m)$ together with the parameters of the star formation rate density, at negligible additional cost compared to the significant increase in complexity such an extension would require within the HBI framework. Our results indicate that SBI is a promising and scalable tool for population inference with third-generation GW detectors."},{"descriptionType":"Other","description":"28 pages, 8 figures. Links to codes: Sireeni: https://github.com/GFAbellan/Sireeni, darksirens_hbi: https://gitlab.com/gantinoz/darksirens_hbi"}],"geoLocations":[],"fundingReferences":[],"url":"https://arxiv.org/abs/2608.04005","contentUrl":null,"metadataVersion":0,"schemaVersion":"http://datacite.org/schema/kernel-4","source":"mds","isActive":true,"state":"findable","reason":null,"viewCount":0,"downloadCount":0,"referenceCount":0,"citationCount":0,"partCount":0,"partOfCount":0,"versionCount":0,"versionOfCount":0,"created":"2026-08-05T02:25:59Z","registered":"2026-08-05T02:25:59Z","published":null,"updated":"2026-08-05T02:25:59Z"},"relationships":{"client":{"data":{"id":"arxiv.content","type":"clients"}}}},{"id":"10.48550/arxiv.2608.04003","type":"dois","attributes":{"doi":"10.48550/arxiv.2608.04003","identifiers":[{"identifier":"2608.04003","identifierType":"arXiv"}],"creators":[{"nameType":"Personal","givenName":"Shuhan","familyName":"Xue","name":"Xue, Shuhan","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Zixin","familyName":"Ding","name":"Ding, Zixin","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Yichen","familyName":"Shen","name":"Shen, Yichen","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Yinjie","familyName":"Wang","name":"Wang, Yinjie","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Zhenfei","familyName":"Yin","name":"Yin, Zhenfei","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Yingcheng","familyName":"Wu","name":"Wu, Yingcheng","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Yuxin","familyName":"Chen","name":"Chen, Yuxin","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Mengdi","familyName":"Wang","name":"Wang, Mengdi","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Ling","familyName":"Yang","name":"Yang, Ling","affiliation":[],"nameIdentifiers":[]}],"titles":[{"title":"PAST-Bench: Benchmarking the Foundations of Recursive Self-Improvement in Personal Agents"}],"publisher":"arXiv","container":{},"publicationYear":2026,"subjects":[{"subject":"Computation and Language (cs.CL)","lang":"en","subjectScheme":"arXiv"},{"subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"}],"contributors":[],"dates":[{"date":"2026-08-04T17:58:05Z","dateType":"Submitted","dateInformation":"v1"},{"date":"2026-08-05T01:09:56Z","dateType":"Updated","dateInformation":"v1"},{"date":"2026-08","dateType":"Available","dateInformation":"v1"}],"language":null,"types":{"schemaOrg":"CreativeWork","resourceTypeGeneral":"Preprint","citeproc":"article","bibtex":"misc","ris":"GEN","resourceType":"Article"},"relatedIdentifiers":[],"relatedItems":[],"sizes":[],"formats":[],"version":"1","rightsList":[{"rightsUri":"http://arxiv.org/licenses/nonexclusive-distrib/1.0/","rights":"arXiv.org perpetual, non-exclusive license"}],"descriptions":[{"descriptionType":"Abstract","description":"Recursive self-improvement requires agents to turn accumulated experience into better future behavior. Personal AI agents offer a concrete setting for studying this capability because they retain preferences, task histories, tool routines, and learned skills across sessions. Yet whether retained experience actually improves them over time has not been systematically tested. We introduce PAST-Bench, a benchmark designed to isolate this question. Each agent runs through ordered sequences of fresh-session tasks under matched conditions that turn retained experience on and off. It spans 26 scenarios and 204 episodes across memory, procedural reuse, information gathering, and update. We report both later-task gains and whether those gains follow the intended save, retrieve, and update pathway. Across seven base models and four agent frameworks, improvement is real but uneven across capabilities. Agents with the same headline gain can differ markedly in whether that gain is supported by evidence of the intended pathway. Guided by these findings, we develop Hermes+, which extends Hermes with five targeted interventions across stages of the agent loop. Hermes+ raises the average gain from retained experience and provides clearer pathway evidence, with its strongest improvement on tasks requiring outdated state to be replaced, although the effect remains capability- and model-dependent. Together, PAST-Bench and Hermes+ provide an evaluation and diagnostic foundation for studying how persistent agents can progress from retaining experience to systematically improving through it. Code: https://github.com/Gen-Verse/PAST-Bench"},{"descriptionType":"Other","description":"Code: https://github.com/Gen-Verse/PAST-Bench"}],"geoLocations":[],"fundingReferences":[],"url":"https://arxiv.org/abs/2608.04003","contentUrl":null,"metadataVersion":0,"schemaVersion":"http://datacite.org/schema/kernel-4","source":"mds","isActive":true,"state":"findable","reason":null,"viewCount":0,"downloadCount":0,"referenceCount":0,"citationCount":0,"partCount":0,"partOfCount":0,"versionCount":0,"versionOfCount":0,"created":"2026-08-05T02:25:56Z","registered":"2026-08-05T02:25:57Z","published":null,"updated":"2026-08-05T02:25:57Z"},"relationships":{"client":{"data":{"id":"arxiv.content","type":"clients"}}}},{"id":"10.48550/arxiv.2608.04002","type":"dois","attributes":{"doi":"10.48550/arxiv.2608.04002","identifiers":[{"identifier":"2608.04002","identifierType":"arXiv"}],"creators":[{"nameType":"Personal","givenName":"Adam","familyName":"Coscia","name":"Coscia, Adam","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Zeyu","familyName":"Hua","name":"Hua, Zeyu","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Eric","familyName":"Krokos","name":"Krokos, Eric","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Timothy","familyName":"Lin","name":"Lin, Timothy","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Alex","familyName":"Endert","name":"Endert, Alex","affiliation":[],"nameIdentifiers":[]}],"titles":[{"title":"Semantic Bundling: Interactive Node and Edge Bundling to Simplify Knowledge Graphs using Large Language Models"}],"publisher":"arXiv","container":{},"publicationYear":2026,"subjects":[{"subject":"Human-Computer Interaction (cs.HC)","lang":"en","subjectScheme":"arXiv"},{"subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"}],"contributors":[],"dates":[{"date":"2026-08-04T17:58:05Z","dateType":"Submitted","dateInformation":"v1"},{"date":"2026-08-05T01:09:54Z","dateType":"Updated","dateInformation":"v1"},{"date":"2026-08","dateType":"Available","dateInformation":"v1"}],"language":null,"types":{"schemaOrg":"CreativeWork","resourceTypeGeneral":"Preprint","citeproc":"article","bibtex":"misc","ris":"GEN","resourceType":"Article"},"relatedIdentifiers":[],"relatedItems":[],"sizes":[],"formats":[],"version":"1","rightsList":[{"rightsIdentifierScheme":"SPDX","rightsUri":"https://creativecommons.org/licenses/by/4.0/legalcode","schemeUri":"https://spdx.org/licenses/","rights":"Creative Commons Attribution 4.0 International","rightsIdentifier":"cc-by-4.0"}],"descriptions":[{"descriptionType":"Abstract","description":"We present Semantic Bundling, a visual analytics technique for making sense of text documents represented as knowledge graphs (KGs). Representing a document corpus as a KG makes relationships between entities explicit, making KGs useful both to analyze directly and in computational workflows including ML pipelines and generative AI backends. However, as KGs grow they become difficult to interpret and visualize for specific tasks (e.g., the ``hairball problem''), with the meaning of each relationship often buried in dense source text. Semantic Bundling uses large language models (LLMs) to support user-driven bundling of nodes and edges in a KG into higher-level graph structures: super nodes, which collapse and summarize a region of the graph, and super edges, which summarize the connection between two entities. Results are linked to underlying triples and source documents, grounding summaries in evidence. We implement Semantic Bundling in AgentK, an open-source system that builds a KG from text documents and maps graph interactions to bundling operations. Through use cases on movie reviews and an intelligence analysis scenario, we show how Semantic Bundling reveals new insights in document collections, and synthesize our findings into a discussion of emerging challenges and opportunities in knowledge graph sensemaking."},{"descriptionType":"Other","description":"Under review. 12 pages, 13 figures"}],"geoLocations":[],"fundingReferences":[],"url":"https://arxiv.org/abs/2608.04002","contentUrl":null,"metadataVersion":0,"schemaVersion":"http://datacite.org/schema/kernel-4","source":"mds","isActive":true,"state":"findable","reason":null,"viewCount":0,"downloadCount":0,"referenceCount":0,"citationCount":0,"partCount":0,"partOfCount":0,"versionCount":0,"versionOfCount":0,"created":"2026-08-05T02:25:55Z","registered":"2026-08-05T02:25:56Z","published":null,"updated":"2026-08-05T02:25:56Z"},"relationships":{"client":{"data":{"id":"arxiv.content","type":"clients"}}}},{"id":"10.48550/arxiv.2608.04000","type":"dois","attributes":{"doi":"10.48550/arxiv.2608.04000","identifiers":[{"identifier":"2608.04000","identifierType":"arXiv"}],"creators":[{"nameType":"Personal","givenName":"Kai","familyName":"Tokunaga","name":"Tokunaga, Kai","affiliation":[],"nameIdentifiers":[]}],"titles":[{"title":"Exact Low-Dimensional Reduction Theory for Populations of Stuart--Landau Oscillators"}],"publisher":"arXiv","container":{},"publicationYear":2026,"subjects":[{"subject":"Adaptation and Self-Organizing Systems (nlin.AO)","lang":"en","subjectScheme":"arXiv"},{"subject":"FOS: Physical sciences","subjectScheme":"Fields of Science and Technology (FOS)"}],"contributors":[],"dates":[{"date":"2026-08-04T17:57:12Z","dateType":"Submitted","dateInformation":"v1"},{"date":"2026-08-05T01:09:50Z","dateType":"Updated","dateInformation":"v1"},{"date":"2026-08","dateType":"Available","dateInformation":"v1"}],"language":null,"types":{"schemaOrg":"CreativeWork","resourceTypeGeneral":"Preprint","citeproc":"article","bibtex":"misc","ris":"GEN","resourceType":"Article"},"relatedIdentifiers":[],"relatedItems":[],"sizes":[],"formats":[],"version":"1","rightsList":[{"rightsUri":"http://arxiv.org/licenses/nonexclusive-distrib/1.0/","rights":"arXiv.org perpetual, non-exclusive license"}],"descriptions":[{"descriptionType":"Abstract","description":"This paper develops an exact low-dimensional reduction theory for populations of Stuart-Landau oscillators. The theory covers two cases: in one case, coupling enters only through the coefficients of the Stuart-Landau equations, and in the other, coupling also enters through terms outside those coefficients. Under suitable assumptions, the two cases can be reduced exactly to three and seven-dimensional systems, respectively. The class of additional coupling terms for which the reduction applies is sufficiently general to allow a broad range of collective dynamics, such as clustering. In particular, the present reduction is shown to capture dynamics in which amplitude plays an essential role and which cannot be described by populations of phase oscillators or their low-dimensional reductions. The proposed framework is also shown to be a powerful tool for capturing complex nonequilibrium dynamics such as chaos."},{"descriptionType":"Other","description":"15 pages, 2 figures, including Supplemental Material"}],"geoLocations":[],"fundingReferences":[],"url":"https://arxiv.org/abs/2608.04000","contentUrl":null,"metadataVersion":0,"schemaVersion":"http://datacite.org/schema/kernel-4","source":"mds","isActive":true,"state":"findable","reason":null,"viewCount":0,"downloadCount":0,"referenceCount":0,"citationCount":0,"partCount":0,"partOfCount":0,"versionCount":0,"versionOfCount":0,"created":"2026-08-05T02:25:52Z","registered":"2026-08-05T02:25:53Z","published":null,"updated":"2026-08-05T02:25:53Z"},"relationships":{"client":{"data":{"id":"arxiv.content","type":"clients"}}}},{"id":"10.48550/arxiv.2608.03999","type":"dois","attributes":{"doi":"10.48550/arxiv.2608.03999","identifiers":[{"identifier":"2608.03999","identifierType":"arXiv"}],"creators":[{"nameType":"Personal","givenName":"Junhao","familyName":"Chen","name":"Chen, Junhao","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Mingjin","familyName":"Chen","name":"Chen, Mingjin","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Jingjia","familyName":"Mao","name":"Mao, Jingjia","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Lin","familyName":"Chen","name":"Chen, Lin","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Saining","familyName":"Zhang","name":"Zhang, Saining","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Minglin","familyName":"Chen","name":"Chen, Minglin","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Ruocheng","familyName":"Wu","name":"Wu, Ruocheng","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Liaoyuan","familyName":"Fan","name":"Fan, Liaoyuan","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Wenyi","familyName":"Li","name":"Li, Wenyi","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Mingju","familyName":"Gao","name":"Gao, Mingju","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Henghaofan","familyName":"Zhang","name":"Zhang, Henghaofan","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Zhihao","familyName":"Li","name":"Li, Zhihao","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Hao","familyName":"Zhao","name":"Zhao, Hao","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Yufei","familyName":"Wang","name":"Wang, Yufei","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Ruqi","familyName":"Huang","name":"Huang, Ruqi","affiliation":[],"nameIdentifiers":[]}],"titles":[{"title":"Agogic: Performance-Timed Music Tokens for LLM-Native Text-to-Symbolic-Music Generation"}],"publisher":"arXiv","container":{},"publicationYear":2026,"subjects":[{"subject":"Sound (cs.SD)","lang":"en","subjectScheme":"arXiv"},{"subject":"Computation and Language (cs.CL)","lang":"en","subjectScheme":"arXiv"},{"subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"}],"contributors":[],"dates":[{"date":"2026-08-04T17:56:49Z","dateType":"Submitted","dateInformation":"v1"},{"date":"2026-08-05T01:09:44Z","dateType":"Updated","dateInformation":"v1"},{"date":"2026-08","dateType":"Available","dateInformation":"v1"}],"language":null,"types":{"schemaOrg":"CreativeWork","resourceTypeGeneral":"Preprint","citeproc":"article","bibtex":"misc","ris":"GEN","resourceType":"Article"},"relatedIdentifiers":[],"relatedItems":[],"sizes":[],"formats":[],"version":"1","rightsList":[{"rightsIdentifierScheme":"SPDX","rightsUri":"https://creativecommons.org/licenses/by-nc-sa/4.0/legalcode","schemeUri":"https://spdx.org/licenses/","rights":"Creative Commons Attribution Non Commercial Share Alike 4.0 International","rightsIdentifier":"cc-by-nc-sa-4.0"}],"descriptions":[{"descriptionType":"Abstract","description":"Text-to-music language models begin with a choice usually made by default: how to tokenize music. Normally entangled with backbone, data, and recipe, its effect has never been measured in isolation. We fix pretrained Qwen3.5 (0.8B-27B), data, budget, and decoding, and swap only the representation across seven tokenizations, anchoring texture metrics to each representation's model-free ceiling. The ordering is clean and surprising: representation, not model size, is the binding variable for distributional fidelity. Scaling the backbone 34x barely moves Frechet Music Distance (FMD), whereas switching representation halves it. PMT, a performance-resolution stream we release (10 ms timing, per-note velocity, multi-track texture; 609 symbols), reaches FMD 159 at 0.8B against 272-286 for beat grids (1.7-1.8x lower, up to 2.8x elsewhere; non-overlapping bootstrap CIs), so a 0.8B performance-resolution model beats a 27B beat grid. It reappears on a 26M from-scratch backbone and a second performance-resolution tokenizer: a property of the class, not one lucky vocabulary. Nor is it a finer-lattice artifact: snapping PMT's onsets to the beat grids' resolution still leaves it 67-129 FMD ahead of both (n=500). The effect is distributional; whether it is audible is a separate question, left open by our probe, with a human study pre-registered. Native caption adherence is weak but separable: a lightweight decode-time constraint doubles instrument-F1 (.28 to .60) and Correct-Key (.16 to .35) at no distributional cost. We release the harness, 25+ checkpoints, two corpora (86.6k aligned across caption/MIDI/ABC/audio; 6.25M captioned, the largest for music), and an imprinting diagnostic: published text-to-MIDI systems reproduce their training distribution near-invariant to the caption (72% vs. 71% chord-time on disjoint domains). The field's next representation claim can now be measured, not asserted."},{"descriptionType":"Other","description":"Project Page: https://yisuanwang.github.io/Agogic"}],"geoLocations":[],"fundingReferences":[],"url":"https://arxiv.org/abs/2608.03999","contentUrl":null,"metadataVersion":0,"schemaVersion":"http://datacite.org/schema/kernel-4","source":"mds","isActive":true,"state":"findable","reason":null,"viewCount":0,"downloadCount":0,"referenceCount":0,"citationCount":0,"partCount":0,"partOfCount":0,"versionCount":0,"versionOfCount":0,"created":"2026-08-05T02:25:50Z","registered":"2026-08-05T02:25:51Z","published":null,"updated":"2026-08-05T02:25:51Z"},"relationships":{"client":{"data":{"id":"arxiv.content","type":"clients"}}}},{"id":"10.48550/arxiv.2608.03998","type":"dois","attributes":{"doi":"10.48550/arxiv.2608.03998","identifiers":[{"identifier":"2608.03998","identifierType":"arXiv"}],"creators":[{"nameType":"Personal","givenName":"D. I.","familyName":"Tyurin","name":"Tyurin, D. I.","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"V. V.","familyName":"Strelkov","name":"Strelkov, V. V.","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"S. V.","familyName":"Popruzhenko","name":"Popruzhenko, S. V.","affiliation":[],"nameIdentifiers":[]}],"titles":[{"title":"Collective tunnel ionization in atomic systems"}],"publisher":"arXiv","container":{},"publicationYear":2026,"subjects":[{"subject":"Atomic Physics (physics.atom-ph)","lang":"en","subjectScheme":"arXiv"},{"subject":"FOS: Physical sciences","subjectScheme":"Fields of Science and Technology (FOS)"}],"contributors":[],"dates":[{"date":"2026-08-04T17:56:03Z","dateType":"Submitted","dateInformation":"v1"},{"date":"2026-08-05T01:09:43Z","dateType":"Updated","dateInformation":"v1"},{"date":"2026-08","dateType":"Available","dateInformation":"v1"}],"language":null,"types":{"schemaOrg":"CreativeWork","resourceTypeGeneral":"Preprint","citeproc":"article","bibtex":"misc","ris":"GEN","resourceType":"Article"},"relatedIdentifiers":[],"relatedItems":[],"sizes":[],"formats":[],"version":"1","rightsList":[{"rightsIdentifierScheme":"SPDX","rightsUri":"https://creativecommons.org/licenses/by/4.0/legalcode","schemeUri":"https://spdx.org/licenses/","rights":"Creative Commons Attribution 4.0 International","rightsIdentifier":"cc-by-4.0"}],"descriptions":[{"descriptionType":"Abstract","description":"We present a theory of the collective tunnel effect in atomic systems subject to strong low-frequency laser fields. Using an analytic semi-classical method and numerical solution to the time-dependent Schrodinger equation we demonstrate the collective channel of the nonsequential double ionization in neutral xenon and in the negative bromine ion. Collective tunneling in the presence of the electron-electron repulsion comprises the joint sub-barrier motion of the two electrons along quantum trajectories transversely shifted in opposite directions with respect to the direction of the external electric field. Momentum distributions of the electron pairs carry clear signatures of the collective channel in the form of shoulders in the direction lateral to the field polarization. We propose and discuss potential experimental approaches to a search for collective tunneling in atomic systems using short circularly polarized laser pulses."}],"geoLocations":[],"fundingReferences":[],"url":"https://arxiv.org/abs/2608.03998","contentUrl":null,"metadataVersion":0,"schemaVersion":"http://datacite.org/schema/kernel-4","source":"mds","isActive":true,"state":"findable","reason":null,"viewCount":0,"downloadCount":0,"referenceCount":0,"citationCount":0,"partCount":0,"partOfCount":0,"versionCount":0,"versionOfCount":0,"created":"2026-08-05T02:25:49Z","registered":"2026-08-05T02:25:50Z","published":null,"updated":"2026-08-05T02:25:50Z"},"relationships":{"client":{"data":{"id":"arxiv.content","type":"clients"}}}},{"id":"10.48550/arxiv.2608.03997","type":"dois","attributes":{"doi":"10.48550/arxiv.2608.03997","identifiers":[{"identifier":"2608.03997","identifierType":"arXiv"}],"creators":[{"nameType":"Personal","givenName":"Jarrod T.","familyName":"Reilly","name":"Reilly, Jarrod T.","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Murray J.","familyName":"Holland","name":"Holland, Murray J.","affiliation":[],"nameIdentifiers":[]}],"titles":[{"title":"Non-Relativistic Quantum Electrodynamics of Atoms in a Rotating Ring Cavity"}],"publisher":"arXiv","container":{},"publicationYear":2026,"subjects":[{"subject":"Quantum Physics (quant-ph)","lang":"en","subjectScheme":"arXiv"},{"subject":"FOS: Physical sciences","subjectScheme":"Fields of Science and Technology (FOS)"}],"contributors":[],"dates":[{"date":"2026-08-04T17:55:53Z","dateType":"Submitted","dateInformation":"v1"},{"date":"2026-08-05T01:09:42Z","dateType":"Updated","dateInformation":"v1"},{"date":"2026-08","dateType":"Available","dateInformation":"v1"}],"language":null,"types":{"schemaOrg":"CreativeWork","resourceTypeGeneral":"Preprint","citeproc":"article","bibtex":"misc","ris":"GEN","resourceType":"Article"},"relatedIdentifiers":[],"relatedItems":[],"sizes":[],"formats":[],"version":"1","rightsList":[{"rightsIdentifierScheme":"SPDX","rightsUri":"https://creativecommons.org/licenses/by/4.0/legalcode","schemeUri":"https://spdx.org/licenses/","rights":"Creative Commons Attribution 4.0 International","rightsIdentifier":"cc-by-4.0"}],"descriptions":[{"descriptionType":"Abstract","description":"In this paper, we derive a quantum optics model in a non-inertial rotating ring cavity from first principles. We begin with the Dirac equation in curved spacetime, add minimal coupling to the electromagnetic field, and then find the Dirac Hamiltonian for the generalized Born metric. We then formally take the non-relativistic limit by way of Foldy-Wouthuysen transformations and project onto a fermionic Fock space for the atoms' electrons, protons, and neutrons. Focusing on a protium atom, we next move from a minimal coupling gauge to a multipole expansion gauge by taking a Power-Zienau-Woolley transformation under the dipole and long-wavelength approximations. Here, we find additional terms from the rotation of the system including a rotation-induced hyperfine shift of the atomic transition which could possibly be observed experimentally even for small rotation rates. Making the electric dipole, two-level, and rotating-wave approximations, we arrive at a Jaynes-Cummings-like Hamiltonian which also accounts for rotational effects, such as the rotation-induced hyperfine shift and the Sagnac shift for the cavity's counterpropagating modes."},{"descriptionType":"Other","description":"25 pages, 1 figure"}],"geoLocations":[],"fundingReferences":[],"url":"https://arxiv.org/abs/2608.03997","contentUrl":null,"metadataVersion":0,"schemaVersion":"http://datacite.org/schema/kernel-4","source":"mds","isActive":true,"state":"findable","reason":null,"viewCount":0,"downloadCount":0,"referenceCount":0,"citationCount":4,"partCount":0,"partOfCount":0,"versionCount":0,"versionOfCount":0,"created":"2026-08-05T02:25:48Z","registered":"2026-08-05T02:25:48Z","published":null,"updated":"2026-08-05T02:25:49Z"},"relationships":{"client":{"data":{"id":"arxiv.content","type":"clients"}}}},{"id":"10.48550/arxiv.2608.03996","type":"dois","attributes":{"doi":"10.48550/arxiv.2608.03996","identifiers":[{"identifier":"2608.03996","identifierType":"arXiv"}],"creators":[{"nameType":"Personal","givenName":"Konstantinos","familyName":"Alexopoulos","name":"Alexopoulos, Konstantinos","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Josselin","familyName":"Garnier","name":"Garnier, Josselin","affiliation":[],"nameIdentifiers":[]}],"titles":[{"title":"Reduced-order modeling for electromagnetic inverse problems: a layered medium benchmark"}],"publisher":"arXiv","container":{},"publicationYear":2026,"subjects":[{"subject":"Numerical Analysis (math.NA)","lang":"en","subjectScheme":"arXiv"},{"subject":"Mathematical Physics (math-ph)","lang":"en","subjectScheme":"arXiv"},{"subject":"Analysis of PDEs (math.AP)","lang":"en","subjectScheme":"arXiv"},{"subject":"Computational Physics (physics.comp-ph)","lang":"en","subjectScheme":"arXiv"},{"subject":"FOS: Mathematics","subjectScheme":"Fields of Science and Technology (FOS)"},{"subject":"FOS: Physical sciences","subjectScheme":"Fields of Science and Technology (FOS)"}],"contributors":[],"dates":[{"date":"2026-08-04T17:55:23Z","dateType":"Submitted","dateInformation":"v1"},{"date":"2026-08-05T01:09:41Z","dateType":"Updated","dateInformation":"v1"},{"date":"2026-08","dateType":"Available","dateInformation":"v1"}],"language":null,"types":{"schemaOrg":"CreativeWork","resourceTypeGeneral":"Preprint","citeproc":"article","bibtex":"misc","ris":"GEN","resourceType":"Article"},"relatedIdentifiers":[],"relatedItems":[],"sizes":[],"formats":[],"version":"1","rightsList":[{"rightsIdentifierScheme":"SPDX","rightsUri":"https://creativecommons.org/licenses/by/4.0/legalcode","schemeUri":"https://spdx.org/licenses/","rights":"Creative Commons Attribution 4.0 International","rightsIdentifier":"cc-by-4.0"}],"descriptions":[{"descriptionType":"Abstract","description":"We study reduced-order modeling for inverse problems in layered media, focusing on the recovery of impedance profiles from time-domain measurements. Using the Goupillaud structure, we formulate the forward problem as a discrete dynamical system and introduce a ROM-based objective defined at the level of reduced operators. Through numerical experiments on a 5-layer medium under various structured perturbations, we compare the ROM-based objective with a classical data misfit. The results show that the ROM-based inversion provides a more favorable reconstruction in the clean setting and in certain structured perturbation regimes, while remaining consistently competitive with the classical approach across all cases considered."},{"descriptionType":"Other","description":"31 pages, 4 figures"}],"geoLocations":[],"fundingReferences":[],"url":"https://arxiv.org/abs/2608.03996","contentUrl":null,"metadataVersion":0,"schemaVersion":"http://datacite.org/schema/kernel-4","source":"mds","isActive":true,"state":"findable","reason":null,"viewCount":0,"downloadCount":0,"referenceCount":0,"citationCount":0,"partCount":0,"partOfCount":0,"versionCount":0,"versionOfCount":0,"created":"2026-08-05T02:25:46Z","registered":"2026-08-05T02:25:47Z","published":null,"updated":"2026-08-05T02:25:47Z"},"relationships":{"client":{"data":{"id":"arxiv.content","type":"clients"}}}},{"id":"10.48550/arxiv.2608.03995","type":"dois","attributes":{"doi":"10.48550/arxiv.2608.03995","identifiers":[{"identifier":"2608.03995","identifierType":"arXiv"}],"creators":[{"nameType":"Personal","givenName":"Cristian E.","familyName":"Gutiérrez","name":"Gutiérrez, Cristian E.","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Eric","familyName":"Stachura","name":"Stachura, Eric","affiliation":[],"nameIdentifiers":[]}],"titles":[{"title":"Refraction laws in spatio-temporal media"}],"publisher":"arXiv","container":{},"publicationYear":2026,"subjects":[{"subject":"Analysis of PDEs (math.AP)","lang":"en","subjectScheme":"arXiv"},{"subject":"Mathematical Physics (math-ph)","lang":"en","subjectScheme":"arXiv"},{"subject":"Optics (physics.optics)","lang":"en","subjectScheme":"arXiv"},{"subject":"FOS: Mathematics","subjectScheme":"Fields of Science and Technology (FOS)"},{"subject":"FOS: Physical sciences","subjectScheme":"Fields of Science and Technology (FOS)"},{"subject":"35Q61, 78A25","lang":"en","subjectScheme":"MSC"}],"contributors":[],"dates":[{"date":"2026-08-04T17:55:18Z","dateType":"Submitted","dateInformation":"v1"},{"date":"2026-08-05T01:09:40Z","dateType":"Updated","dateInformation":"v1"},{"date":"2026-08","dateType":"Available","dateInformation":"v1"}],"language":null,"types":{"schemaOrg":"CreativeWork","resourceTypeGeneral":"Preprint","citeproc":"article","bibtex":"misc","ris":"GEN","resourceType":"Article"},"relatedIdentifiers":[],"relatedItems":[],"sizes":[],"formats":[],"version":"1","rightsList":[{"rightsUri":"http://arxiv.org/licenses/nonexclusive-distrib/1.0/","rights":"arXiv.org perpetual, non-exclusive license"}],"descriptions":[{"descriptionType":"Abstract","description":"We study the time-dependent Maxwell system, formulated in the sense of distributions, for electromagnetic waves propagating through media with temporal and spatial material interfaces. Under explicit trace and regularity assumptions on the permittivity and permeability, we derive the jump conditions produced by temporal discontinuities and by subsequent spatial interfaces. These conditions are used to obtain generalized Snell laws for the wave vectors generated by temporal splitting, reflection, and transmission. We also derive the associated amplitude equations and organize them as a finite-dimensional linear system for a space-time slab geometry. Finally, we provide an explicit oblique-incidence example. Our approach does not impose a smooth-field ansatz and allows material parameters that need not be constant away from the interfaces."},{"descriptionType":"Other","description":"44 pages, 3 figures"}],"geoLocations":[],"fundingReferences":[],"url":"https://arxiv.org/abs/2608.03995","contentUrl":null,"metadataVersion":0,"schemaVersion":"http://datacite.org/schema/kernel-4","source":"mds","isActive":true,"state":"findable","reason":null,"viewCount":0,"downloadCount":0,"referenceCount":0,"citationCount":0,"partCount":0,"partOfCount":0,"versionCount":0,"versionOfCount":0,"created":"2026-08-05T02:25:45Z","registered":"2026-08-05T02:25:46Z","published":null,"updated":"2026-08-05T02:25:46Z"},"relationships":{"client":{"data":{"id":"arxiv.content","type":"clients"}}}},{"id":"10.48550/arxiv.2608.03994","type":"dois","attributes":{"doi":"10.48550/arxiv.2608.03994","identifiers":[{"identifier":"2608.03994","identifierType":"arXiv"}],"creators":[{"nameType":"Personal","givenName":"Christopher","familyName":"Schröder","name":"Schröder, Christopher","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Lukas","familyName":"Gienapp","name":"Gienapp, Lukas","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Ferdinand","familyName":"Schlatt","name":"Schlatt, Ferdinand","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Martin","familyName":"Potthast","name":"Potthast, Martin","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Gerhard","familyName":"Heyer","name":"Heyer, Gerhard","affiliation":[],"nameIdentifiers":[]}],"titles":[{"title":"When Attention Goes Blind: Numerical Failure in ALiBi Positional Encodings"}],"publisher":"arXiv","container":{},"publicationYear":2026,"subjects":[{"subject":"Computation and Language (cs.CL)","lang":"en","subjectScheme":"arXiv"},{"subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"}],"contributors":[],"dates":[{"date":"2026-08-04T17:54:01Z","dateType":"Submitted","dateInformation":"v1"},{"date":"2026-08-05T01:09:29Z","dateType":"Updated","dateInformation":"v1"},{"date":"2026-08","dateType":"Available","dateInformation":"v1"}],"language":null,"types":{"schemaOrg":"CreativeWork","resourceTypeGeneral":"Preprint","citeproc":"article","bibtex":"misc","ris":"GEN","resourceType":"Article"},"relatedIdentifiers":[],"relatedItems":[],"sizes":[],"formats":[],"version":"1","rightsList":[{"rightsUri":"http://arxiv.org/licenses/nonexclusive-distrib/1.0/","rights":"arXiv.org perpetual, non-exclusive license"}],"descriptions":[{"descriptionType":"Abstract","description":"We identify a previously overlooked failure mode of ALiBi positional encoding: its linear bias scaling underflows floating-point precision, which zeroes out a large fraction of attention weights and renders the affected attention heads partially blind. We analyze this failure mode, characterize its impact, and examine four mitigation strategies. We further demonstrate its occurrence in state-of-the-art pretrained models based on ALiBi. Comprehensive pretraining experiments with 148M-parameter decoder models help us to disentangle its effects from out-of-context degradation. We find that ALiBi's failure mode can substantially impair token retrieval while having only a minor effect on standard decoder benchmarks. We propose four training-time mitigation strategies and evaluate them individually and in combinations, finding that log-scaled distances yield the most consistent improvements in passkey retrieval. Despite this problem, default ALiBi slopes remain a surprisingly strong baseline, particularly for needle-in-a-haystack retrieval. Based on these findings we provide concrete recommendations on how to train models with ALiBi."}],"geoLocations":[],"fundingReferences":[],"url":"https://arxiv.org/abs/2608.03994","contentUrl":null,"metadataVersion":0,"schemaVersion":"http://datacite.org/schema/kernel-4","source":"mds","isActive":true,"state":"findable","reason":null,"viewCount":0,"downloadCount":0,"referenceCount":0,"citationCount":0,"partCount":0,"partOfCount":0,"versionCount":0,"versionOfCount":0,"created":"2026-08-05T02:25:44Z","registered":null,"published":null,"updated":"2026-08-05T02:25:44Z"},"relationships":{"client":{"data":{"id":"arxiv.content","type":"clients"}}}},{"id":"10.48550/arxiv.2608.03993","type":"dois","attributes":{"doi":"10.48550/arxiv.2608.03993","identifiers":[{"identifier":"2608.03993","identifierType":"arXiv"}],"creators":[{"nameType":"Personal","givenName":"Mostafa","familyName":"Mirabi","name":"Mirabi, Mostafa","affiliation":[],"nameIdentifiers":[]}],"titles":[{"title":"Asymptotic classes via definable quotients"}],"publisher":"arXiv","container":{},"publicationYear":2026,"subjects":[{"subject":"Logic (math.LO)","lang":"en","subjectScheme":"arXiv"},{"subject":"FOS: Mathematics","subjectScheme":"Fields of Science and Technology (FOS)"},{"subject":"03C13, 03C45","lang":"en","subjectScheme":"MSC"}],"contributors":[],"dates":[{"date":"2026-08-04T17:53:51Z","dateType":"Submitted","dateInformation":"v1"},{"date":"2026-08-05T01:09:29Z","dateType":"Updated","dateInformation":"v1"},{"date":"2026-08","dateType":"Available","dateInformation":"v1"}],"language":null,"types":{"schemaOrg":"CreativeWork","resourceTypeGeneral":"Preprint","citeproc":"article","bibtex":"misc","ris":"GEN","resourceType":"Article"},"relatedIdentifiers":[],"relatedItems":[],"sizes":[],"formats":[],"version":"1","rightsList":[{"rightsUri":"http://arxiv.org/licenses/nonexclusive-distrib/1.0/","rights":"arXiv.org perpetual, non-exclusive license"}],"descriptions":[{"descriptionType":"Abstract","description":"We study when finite-dimensional asymptoticity transfers through uniform interpretations and definable quotients. Ambient counting yields finitely many asymptotic alternatives, but the corresponding parameter cells may fail to be definable in the interpreted language; in general, one obtains only weak asymptoticity. We isolate \"trace reflection\", a one-sided descent condition that removes this obstruction. For interpretations with definable selectors, trace reflection transfers asymptoticity with explicit denominator bounds. For general definable quotients, invariant asymptotic profiles replace definable choice and yield a quotient-transfer theorem. We identify an intrinsic visible denominator and prove that it is the least possible asymptotic denominator, with a coprime-witness criterion for when the interpretation-dependent bound is sharp. We also establish formula-wise, syntactic, and semantic descent criteria, prove composition theorems, and show that trace reflection is strictly weaker than uniform weak bi-interpretability. A framed-profile argument removes the noncanonical coordinate parameters introduced by uniform finite-field reconstruction. As applications, we study projective quotient traces and prove that, for every fixed $k\\geq2$, the pure incidence structures arising from graphs of polynomials of degree less than $k$ over finite fields form a full $k$-dimensional asymptotic class. The denominator $k$ is minimal, and every member is $K_{k,n}$-free for all $n\\geq2$."},{"descriptionType":"Other","description":"55 pages"}],"geoLocations":[],"fundingReferences":[],"url":"https://arxiv.org/abs/2608.03993","contentUrl":null,"metadataVersion":0,"schemaVersion":"http://datacite.org/schema/kernel-4","source":"mds","isActive":true,"state":"findable","reason":null,"viewCount":0,"downloadCount":0,"referenceCount":0,"citationCount":0,"partCount":0,"partOfCount":0,"versionCount":0,"versionOfCount":0,"created":"2026-08-05T02:25:42Z","registered":"2026-08-05T02:25:43Z","published":null,"updated":"2026-08-05T02:25:43Z"},"relationships":{"client":{"data":{"id":"arxiv.content","type":"clients"}}}},{"id":"10.48550/arxiv.2608.03992","type":"dois","attributes":{"doi":"10.48550/arxiv.2608.03992","identifiers":[{"identifier":"2608.03992","identifierType":"arXiv"}],"creators":[{"nameType":"Personal","givenName":"Zhi-Wei","familyName":"Sun","name":"Sun, Zhi-Wei","affiliation":[],"nameIdentifiers":[]}],"titles":[{"title":"On Diophantine equations over the integer rings of quadratic fields"}],"publisher":"arXiv","container":{},"publicationYear":2026,"subjects":[{"subject":"Number Theory (math.NT)","lang":"en","subjectScheme":"arXiv"},{"subject":"Logic (math.LO)","lang":"en","subjectScheme":"arXiv"},{"subject":"FOS: Mathematics","subjectScheme":"Fields of Science and Technology (FOS)"},{"subject":"11U05, 03D35, 03D25, 11D09, 11R11","lang":"en","subjectScheme":"MSC"}],"contributors":[],"dates":[{"date":"2026-08-04T17:53:00Z","dateType":"Submitted","dateInformation":"v1"},{"date":"2026-08-05T01:09:25Z","dateType":"Updated","dateInformation":"v1"},{"date":"2026-08","dateType":"Available","dateInformation":"v1"}],"language":null,"types":{"schemaOrg":"CreativeWork","resourceTypeGeneral":"Preprint","citeproc":"article","bibtex":"misc","ris":"GEN","resourceType":"Article"},"relatedIdentifiers":[],"relatedItems":[],"sizes":[],"formats":[],"version":"1","rightsList":[{"rightsUri":"http://arxiv.org/licenses/nonexclusive-distrib/1.0/","rights":"arXiv.org perpetual, non-exclusive license"}],"descriptions":[{"descriptionType":"Abstract","description":"Let $K$ be any quadratic number field, and let $O_K$ be the ring of algebraic integers in $K$. In 1975 J. Denef proved that Hilbert's Tenth Problem over $O_K$ has a negative solution. In this paper we establish the following undecidability result: There is no algorithm to decide whether an arbitrarily given polynomial equation $P(z_1,\\ldots,z_{16})=0$ (with integer coefficients and 16 unknowns) has solutions over $O_K$. Moreover, when $K$ is a real quadratic field, we show that $15$ unknowns suffice for undecidability."},{"descriptionType":"Other","description":"11 pages"}],"geoLocations":[],"fundingReferences":[],"url":"https://arxiv.org/abs/2608.03992","contentUrl":null,"metadataVersion":0,"schemaVersion":"http://datacite.org/schema/kernel-4","source":"mds","isActive":true,"state":"findable","reason":null,"viewCount":0,"downloadCount":0,"referenceCount":0,"citationCount":0,"partCount":0,"partOfCount":0,"versionCount":0,"versionOfCount":0,"created":"2026-08-05T02:25:41Z","registered":"2026-08-05T02:25:42Z","published":null,"updated":"2026-08-05T02:25:42Z"},"relationships":{"client":{"data":{"id":"arxiv.content","type":"clients"}}}},{"id":"10.48550/arxiv.2608.03990","type":"dois","attributes":{"doi":"10.48550/arxiv.2608.03990","identifiers":[{"identifier":"2608.03990","identifierType":"arXiv"}],"creators":[{"nameType":"Personal","givenName":"Seyed","familyName":"Kahaki","name":"Kahaki, Seyed","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Shijie","familyName":"Li","name":"Li, Shijie","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Weijie","familyName":"Chen","name":"Chen, Weijie","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Nicholas","familyName":"Petrick","name":"Petrick, Nicholas","affiliation":[],"nameIdentifiers":[]}],"titles":[{"title":"Assessment of Conditional Diffusion Model for Synthetic Histopathology Image Generation"}],"publisher":"arXiv","container":{},"publicationYear":2026,"subjects":[{"subject":"Machine Learning (cs.LG)","lang":"en","subjectScheme":"arXiv"},{"subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"}],"contributors":[],"dates":[{"date":"2026-08-04T17:51:40Z","dateType":"Submitted","dateInformation":"v1"},{"date":"2026-08-05T01:09:19Z","dateType":"Updated","dateInformation":"v1"},{"date":"2026-08","dateType":"Available","dateInformation":"v1"}],"language":null,"types":{"schemaOrg":"CreativeWork","resourceTypeGeneral":"Preprint","citeproc":"article","bibtex":"misc","ris":"GEN","resourceType":"Article"},"relatedIdentifiers":[],"relatedItems":[],"sizes":[],"formats":[],"version":"1","rightsList":[{"rightsIdentifierScheme":"SPDX","rightsUri":"https://creativecommons.org/publicdomain/zero/1.0/legalcode","schemeUri":"https://spdx.org/licenses/","rights":"Creative Commons Zero v1.0 Universal","rightsIdentifier":"cc0-1.0"}],"descriptions":[{"descriptionType":"Abstract","description":"Synthetic histopathology image generation has emerged as an approach that may address data scarcity in computational pathology, yet current evaluation methodologies may not fully assess synthetic data quality for medical applications. This work investigates and addresses limitations in existing evaluation metrics, investigating an approach for assessing synthetic histopathology image quality through domain-specific metrics and downstream task validation. We show that conventional synthetic data evaluation metrics such as Frechet Inception Distance (FID) and Inception Score (IS) may have limitations when applied to histopathology images due to their reliance on ImageNet-pretrained feature extractors. To address these limitations, we propose for consideration modified FID and IS approaches utilizing foundation models pretrained on digital pathology datasets, supplemented by precision-recall based metrics as part of an additional quality assessment. Using conditional denoising diffusion models trained on four benchmark datasets, with a two-step training approach, we generated synthetic datasets with systematically varied quality characteristics. We also measured the correlation between the synthetic data quality metrics with downstream nuclei segmentation performance using common metrics including the aggregated Jaccard index (AJI+) and the Dice coefficient. The study results suggest that pathology-specific metrics may provide improved discriminative power. Specifically, the modified Inception Score indicates higher correlation with downstream task performance (r=0.6096 with AJI+, p=0.0122), compared to the original IS (r=0.0708, p=0.7944). Our observations indicate that increasing the variety of generated training data has a higher positive correlation with segmentation model performance than improving the visual fidelity of individual generated images."},{"descriptionType":"Other","description":"11 pages, 3 figures"}],"geoLocations":[],"fundingReferences":[],"url":"https://arxiv.org/abs/2608.03990","contentUrl":null,"metadataVersion":0,"schemaVersion":"http://datacite.org/schema/kernel-4","source":"mds","isActive":true,"state":"findable","reason":null,"viewCount":0,"downloadCount":0,"referenceCount":0,"citationCount":0,"partCount":0,"partOfCount":0,"versionCount":0,"versionOfCount":0,"created":"2026-08-05T02:25:38Z","registered":"2026-08-05T02:25:39Z","published":null,"updated":"2026-08-05T02:25:39Z"},"relationships":{"client":{"data":{"id":"arxiv.content","type":"clients"}}}},{"id":"10.48550/arxiv.2608.03989","type":"dois","attributes":{"doi":"10.48550/arxiv.2608.03989","identifiers":[{"identifier":"2608.03989","identifierType":"arXiv"}],"creators":[{"nameType":"Personal","givenName":"Rouzbeh","familyName":"Haghighi","name":"Haghighi, Rouzbeh","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Ali","familyName":"Hassan","name":"Hassan, Ali","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Sina","familyName":"Mohammadi","name":"Mohammadi, Sina","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Marcus Chen I","familyName":"Wada","name":"Wada, Marcus Chen I","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Wencong","familyName":"Su","name":"Su, Wencong","affiliation":[],"nameIdentifiers":[]}],"titles":[{"title":"A Stackelberg-Bayesian Capacity-Market Game of Carbon Regulation and Second-Life Battery Investment under AI Data-Center Load Growth"}],"publisher":"arXiv","container":{},"publicationYear":2026,"subjects":[{"subject":"Systems and Control (eess.SY)","lang":"en","subjectScheme":"arXiv"},{"subject":"FOS: Electrical engineering, electronic engineering, information engineering","subjectScheme":"Fields of Science and Technology (FOS)"}],"contributors":[],"dates":[{"date":"2026-08-04T17:51:14Z","dateType":"Submitted","dateInformation":"v1"},{"date":"2026-08-05T01:09:18Z","dateType":"Updated","dateInformation":"v1"},{"date":"2026-08","dateType":"Available","dateInformation":"v1"}],"language":null,"types":{"schemaOrg":"CreativeWork","resourceTypeGeneral":"Preprint","citeproc":"article","bibtex":"misc","ris":"GEN","resourceType":"Article"},"relatedIdentifiers":[],"relatedItems":[],"sizes":[],"formats":[],"version":"1","rightsList":[{"rightsIdentifierScheme":"SPDX","rightsUri":"https://creativecommons.org/licenses/by-nc-nd/4.0/legalcode","schemeUri":"https://spdx.org/licenses/","rights":"Creative Commons Attribution Non Commercial No Derivatives 4.0 International","rightsIdentifier":"cc-by-nc-nd-4.0"}],"descriptions":[{"descriptionType":"Abstract","description":"Artificial intelligence (AI) data centers are driving rapid electricity load growth across all U.S. ISO/RTO regions, raising both system costs and carbon exposure. This study develops a three-level Stackelberg--Bayesian game in which a regulator (leader) sets carbon penalties and subsidies, a single ISO capacity market clears against an energy balance modeled as a classical generation-expansion problem, and technology-specific investors (followers) decide capacity and operation under incomplete information, yielding a Bayesian Nash equilibrium. The AI impact is captured parsimoniously as an additional load-growth factor on a greenfield-incremental expansion, isolating how much new capacity the growth pulls in and which technology fills it. Within this framework, we consider second-life battery (SLB) storage competing against new/first-life storage for capacity-market revenue. We quantify how a carbon tax, a renewable subsidy, and an SLB subsidy reshape the equilibrium investment mix, carbon emissions, and profit. Different scenarios are compared at the end based on cost-effectiveness and reduced carbon emissions."},{"descriptionType":"Other","description":"6 pages, 2 figures, Accepted, 2026 North American Power Symposium (NAPS 2026), MI, USA"}],"geoLocations":[],"fundingReferences":[],"url":"https://arxiv.org/abs/2608.03989","contentUrl":null,"metadataVersion":0,"schemaVersion":"http://datacite.org/schema/kernel-4","source":"mds","isActive":true,"state":"findable","reason":null,"viewCount":0,"downloadCount":0,"referenceCount":0,"citationCount":0,"partCount":0,"partOfCount":0,"versionCount":0,"versionOfCount":0,"created":"2026-08-05T02:25:37Z","registered":"2026-08-05T02:25:37Z","published":null,"updated":"2026-08-05T02:25:37Z"},"relationships":{"client":{"data":{"id":"arxiv.content","type":"clients"}}}},{"id":"10.48550/arxiv.2608.03988","type":"dois","attributes":{"doi":"10.48550/arxiv.2608.03988","identifiers":[{"identifier":"2608.03988","identifierType":"arXiv"}],"creators":[{"nameType":"Personal","givenName":"Kirtiman","familyName":"Ghosh","name":"Ghosh, Kirtiman","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Arun Kumar","familyName":"Nayak","name":"Nayak, Arun Kumar","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Debabrata","familyName":"Sahoo","name":"Sahoo, Debabrata","affiliation":[],"nameIdentifiers":[]}],"titles":[{"title":"Revised exclusion limits on doubly charged Higgs bosons from a reanalysis of the ATLAS multi-lepton search at $\\sqrt{s} = 13$,TeV"}],"publisher":"arXiv","container":{},"publicationYear":2026,"subjects":[{"subject":"High Energy Physics - Phenomenology (hep-ph)","lang":"en","subjectScheme":"arXiv"},{"subject":"High Energy Physics - Experiment (hep-ex)","lang":"en","subjectScheme":"arXiv"},{"subject":"FOS: Physical sciences","subjectScheme":"Fields of Science and Technology (FOS)"}],"contributors":[],"dates":[{"date":"2026-08-04T17:51:14Z","dateType":"Submitted","dateInformation":"v1"},{"date":"2026-08-05T01:09:18Z","dateType":"Updated","dateInformation":"v1"},{"date":"2026-08","dateType":"Available","dateInformation":"v1"}],"language":null,"types":{"schemaOrg":"CreativeWork","resourceTypeGeneral":"Preprint","citeproc":"article","bibtex":"misc","ris":"GEN","resourceType":"Article"},"relatedIdentifiers":[],"relatedItems":[],"sizes":[],"formats":[],"version":"1","rightsList":[{"rightsUri":"http://arxiv.org/licenses/nonexclusive-distrib/1.0/","rights":"arXiv.org perpetual, non-exclusive license"}],"descriptions":[{"descriptionType":"Abstract","description":"The ATLAS search for pair-produced doubly charged Higgs bosons in multi-lepton final states using the full Run 2 dataset [Eur. Phys. J. C 83 (2023) 605] reports the strongest limits to date on the mass of doubly charged scalars, driven by an essentially background-free four-lepton channel. We show that the four-lepton signal efficiency implied by the auxiliary cutflow of that analysis exceeds a strict, mass-independent upper bound derived from the equal-branching-ratio assumption of the search, the leptonic $τ$ branching fractions, and the ATLAS lepton reconstruction efficiencies. We show that this excess cannot be explained by hadronic $τ$ or jet misidentification without invoking fake rates far above realistic values. We regenerate the signal independently and recompute the exclusion limit, using the corrected signal yields, the ATLAS background predictions and uncertainties, and the same $CL_s$ procedure implemented in pyhf. The resulting expected limit lies systematically above the ATLAS expected limit, by roughly a factor of two or more. This shifts the expected lower mass bound from $1065$ GeV to $\\sim950$ GeV in the left-right symmetric type-II seesaw model, and from $880$ GeV to $\\sim770$ GeV in the Zee--Babu model."},{"descriptionType":"Other","description":"7 pages, 6 figures"}],"geoLocations":[],"fundingReferences":[],"url":"https://arxiv.org/abs/2608.03988","contentUrl":null,"metadataVersion":0,"schemaVersion":"http://datacite.org/schema/kernel-4","source":"mds","isActive":true,"state":"findable","reason":null,"viewCount":0,"downloadCount":0,"referenceCount":0,"citationCount":0,"partCount":0,"partOfCount":0,"versionCount":0,"versionOfCount":0,"created":"2026-08-05T02:25:35Z","registered":"2026-08-05T02:25:36Z","published":null,"updated":"2026-08-05T02:25:36Z"},"relationships":{"client":{"data":{"id":"arxiv.content","type":"clients"}}}},{"id":"10.48550/arxiv.2608.03986","type":"dois","attributes":{"doi":"10.48550/arxiv.2608.03986","identifiers":[{"identifier":"2608.03986","identifierType":"arXiv"}],"creators":[{"nameType":"Personal","givenName":"Martin J.","familyName":"Renner","name":"Renner, Martin J.","affiliation":[],"nameIdentifiers":[]}],"titles":[{"title":"A lower bound on the classical simulation cost of star-network correlations"}],"publisher":"arXiv","container":{},"publicationYear":2026,"subjects":[{"subject":"Quantum Physics (quant-ph)","lang":"en","subjectScheme":"arXiv"},{"subject":"FOS: Physical sciences","subjectScheme":"Fields of Science and Technology (FOS)"}],"contributors":[],"dates":[{"date":"2026-08-04T17:51:05Z","dateType":"Submitted","dateInformation":"v1"},{"date":"2026-08-05T01:09:16Z","dateType":"Updated","dateInformation":"v1"},{"date":"2026-08","dateType":"Available","dateInformation":"v1"}],"language":null,"types":{"schemaOrg":"CreativeWork","resourceTypeGeneral":"Preprint","citeproc":"article","bibtex":"misc","ris":"GEN","resourceType":"Article"},"relatedIdentifiers":[],"relatedItems":[],"sizes":[],"formats":[],"version":"1","rightsList":[{"rightsUri":"http://arxiv.org/licenses/nonexclusive-distrib/1.0/","rights":"arXiv.org perpetual, non-exclusive license"}],"descriptions":[{"descriptionType":"Abstract","description":"It is well established that quantum strategies outperform classical ones in several communication tasks. We study the quantum communication complexity of correlations arising from joint measurements on quantum systems distributed across a star network, where several parties each send a quantum system to a central node. We introduce an exclusion task that can be solved perfectly when each party sends a quantum $d$-level system, but would require a large classical message otherwise. In fact, the task cannot be solved with certainty if each of the $n$ parties sends a classical message with less than $n^{(d-1)}$ symbols. This implies an advantage of using quantum over classical messages in that scenario that scales with both, the dimension of the quantum system and the number of systems measured simultaneously. As an application, this shows that no finite-size classical description of a qubit suffices to reproduce the statistics of a joint measurement on sufficiently many qubits."},{"descriptionType":"Other","description":"5+4 pages"}],"geoLocations":[],"fundingReferences":[],"url":"https://arxiv.org/abs/2608.03986","contentUrl":null,"metadataVersion":0,"schemaVersion":"http://datacite.org/schema/kernel-4","source":"mds","isActive":true,"state":"findable","reason":null,"viewCount":0,"downloadCount":0,"referenceCount":0,"citationCount":0,"partCount":0,"partOfCount":0,"versionCount":0,"versionOfCount":0,"created":"2026-08-05T02:25:33Z","registered":"2026-08-05T02:25:33Z","published":null,"updated":"2026-08-05T02:25:33Z"},"relationships":{"client":{"data":{"id":"arxiv.content","type":"clients"}}}},{"id":"10.48550/arxiv.2608.03985","type":"dois","attributes":{"doi":"10.48550/arxiv.2608.03985","identifiers":[{"identifier":"2608.03985","identifierType":"arXiv"}],"creators":[{"nameType":"Personal","givenName":"Mario G.","familyName":"Silveirinha","name":"Silveirinha, Mario G.","affiliation":[],"nameIdentifiers":[]}],"titles":[{"title":"Can crystal symmetry reshape ENZ photonics?: Opinion"}],"publisher":"arXiv","container":{},"publicationYear":2026,"subjects":[{"subject":"Optics (physics.optics)","lang":"en","subjectScheme":"arXiv"},{"subject":"FOS: Physical sciences","subjectScheme":"Fields of Science and Technology (FOS)"}],"contributors":[],"dates":[{"date":"2026-08-04T17:49:02Z","dateType":"Submitted","dateInformation":"v1"},{"date":"2026-08-05T01:09:15Z","dateType":"Updated","dateInformation":"v1"},{"date":"2026-08","dateType":"Available","dateInformation":"v1"}],"language":null,"types":{"schemaOrg":"CreativeWork","resourceTypeGeneral":"Preprint","citeproc":"article","bibtex":"misc","ris":"GEN","resourceType":"Article"},"relatedIdentifiers":[],"relatedItems":[],"sizes":[],"formats":[],"version":"1","rightsList":[{"rightsIdentifierScheme":"SPDX","rightsUri":"https://creativecommons.org/licenses/by/4.0/legalcode","schemeUri":"https://spdx.org/licenses/","rights":"Creative Commons Attribution 4.0 International","rightsIdentifier":"cc-by-4.0"}],"descriptions":[{"descriptionType":"Abstract","description":"Over the last decade, epsilon-near-zero (ENZ) photonics has been driven by the search for lower losses and stronger nonlinear responses. Here, I ask a different question: can crystal symmetry also be used to shape the ENZ response? I focus on low-symmetry conductors, where the geometry of the electronic states can produce electric currents that are not present in ordinary Drude materials. These currents may enable polarization-dependent gain, nonreciprocal effects, and ultrafast nonlinearities controlled by symmetry and an external bias. I suggest that such materials may be useful for active and time-varying nanophotonics."},{"descriptionType":"Other","description":"invited article in Optical Materials Express (in press)"}],"geoLocations":[],"fundingReferences":[],"url":"https://arxiv.org/abs/2608.03985","contentUrl":null,"metadataVersion":0,"schemaVersion":"http://datacite.org/schema/kernel-4","source":"mds","isActive":true,"state":"findable","reason":null,"viewCount":0,"downloadCount":0,"referenceCount":0,"citationCount":0,"partCount":0,"partOfCount":0,"versionCount":0,"versionOfCount":0,"created":"2026-08-05T02:25:31Z","registered":"2026-08-05T02:25:32Z","published":null,"updated":"2026-08-05T02:25:32Z"},"relationships":{"client":{"data":{"id":"arxiv.content","type":"clients"}}}},{"id":"10.48550/arxiv.2608.03984","type":"dois","attributes":{"doi":"10.48550/arxiv.2608.03984","identifiers":[{"identifier":"2608.03984","identifierType":"arXiv"}],"creators":[{"nameType":"Personal","givenName":"Mirac","familyName":"Suzgun","name":"Suzgun, Mirac","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"James","familyName":"Zou","name":"Zou, James","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Stuart M.","familyName":"Shieber","name":"Shieber, Stuart M.","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Dan","familyName":"Jurafsky","name":"Jurafsky, Dan","affiliation":[],"nameIdentifiers":[]}],"titles":[{"title":"string2string Studio: An Interactive, In-Browser Platform for String-to-String Algorithms"}],"publisher":"arXiv","container":{},"publicationYear":2026,"subjects":[{"subject":"Computation and Language (cs.CL)","lang":"en","subjectScheme":"arXiv"},{"subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"}],"contributors":[],"dates":[{"date":"2026-08-04T17:48:15Z","dateType":"Submitted","dateInformation":"v1"},{"date":"2026-08-05T01:09:11Z","dateType":"Updated","dateInformation":"v1"},{"date":"2026-08","dateType":"Available","dateInformation":"v1"}],"language":null,"types":{"schemaOrg":"CreativeWork","resourceTypeGeneral":"Preprint","citeproc":"article","bibtex":"misc","ris":"GEN","resourceType":"Article"},"relatedIdentifiers":[],"relatedItems":[],"sizes":[],"formats":[],"version":"1","rightsList":[{"rightsIdentifierScheme":"SPDX","rightsUri":"https://creativecommons.org/licenses/by/4.0/legalcode","schemeUri":"https://spdx.org/licenses/","rights":"Creative Commons Attribution 4.0 International","rightsIdentifier":"cc-by-4.0"}],"descriptions":[{"descriptionType":"Abstract","description":"We present string2string Studio, an interactive in-browser platform for string-to-string analysis across natural language processing, computational biology, and the digital humanities. The system integrates six main modules (alignment, distance, similarity, search, generation metrics, and BLAST homology search), operating at character, word, token, line, and residue levels. Its C++-based algorithms compile to WebAssembly, so core operations run locally by default without any installation or data upload. The interface reports scores with their \"evidence\" (alignments, edit paths, metric matches, search hits, and homology traces), making methods inspectable, debuggable, and comparable on shared inputs. Internal benchmarks show speedups of up to 2,500x over the Python predecessor, faster global/local alignment than a general-purpose native C aligner, and exact agreement with independent references under declared settings. For homology search, the scoped client-side blastn path closely matches NCBI BLAST+ rankings and statistics under matched parameters. A curated showcase and Learn mode present canonical algorithms and metrics as reusable demonstrations. string2string Studio is open-source and freely available at string2string.org."},{"descriptionType":"Other","description":"https://string2string.org/"}],"geoLocations":[],"fundingReferences":[],"url":"https://arxiv.org/abs/2608.03984","contentUrl":null,"metadataVersion":0,"schemaVersion":"http://datacite.org/schema/kernel-4","source":"mds","isActive":true,"state":"findable","reason":null,"viewCount":0,"downloadCount":0,"referenceCount":0,"citationCount":0,"partCount":0,"partOfCount":0,"versionCount":0,"versionOfCount":0,"created":"2026-08-05T02:25:30Z","registered":"2026-08-05T02:25:31Z","published":null,"updated":"2026-08-05T02:25:31Z"},"relationships":{"client":{"data":{"id":"arxiv.content","type":"clients"}}}},{"id":"10.48550/arxiv.2608.03983","type":"dois","attributes":{"doi":"10.48550/arxiv.2608.03983","identifiers":[{"identifier":"2608.03983","identifierType":"arXiv"}],"creators":[{"nameType":"Personal","givenName":"Hailong","familyName":"Jiang","name":"Jiang, Hailong","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Feng","familyName":"Yu","name":"Yu, Feng","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Emran","familyName":"Hossain","name":"Hossain, Emran","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Jianfeng","familyName":"Zhu","name":"Zhu, Jianfeng","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Mengfei","familyName":"Ren","name":"Ren, Mengfei","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Qiang","familyName":"Guan","name":"Guan, Qiang","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Chunwei","familyName":"Xia","name":"Xia, Chunwei","affiliation":[],"nameIdentifiers":[]}],"titles":[{"title":"Can Large Language Models Recover Semantic Optimization Opportunities That Compilers Miss?"}],"publisher":"arXiv","container":{},"publicationYear":2026,"subjects":[{"subject":"Programming Languages (cs.PL)","lang":"en","subjectScheme":"arXiv"},{"subject":"Artificial Intelligence (cs.AI)","lang":"en","subjectScheme":"arXiv"},{"subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"}],"contributors":[],"dates":[{"date":"2026-08-04T17:47:25Z","dateType":"Submitted","dateInformation":"v1"},{"date":"2026-08-05T01:09:10Z","dateType":"Updated","dateInformation":"v1"},{"date":"2026-08","dateType":"Available","dateInformation":"v1"}],"language":null,"types":{"schemaOrg":"CreativeWork","resourceTypeGeneral":"Preprint","citeproc":"article","bibtex":"misc","ris":"GEN","resourceType":"Article"},"relatedIdentifiers":[],"relatedItems":[],"sizes":[],"formats":[],"version":"1","rightsList":[{"rightsIdentifierScheme":"SPDX","rightsUri":"https://creativecommons.org/licenses/by/4.0/legalcode","schemeUri":"https://spdx.org/licenses/","rights":"Creative Commons Attribution 4.0 International","rightsIdentifier":"cc-by-4.0"}],"descriptions":[{"descriptionType":"Abstract","description":"Optimizing compilers miss profitable transformations when their enabling semantics are absent from the analyzed program representation. We ask whether large language models (LLMs) can recover such semantics from heterogeneous C/C++ context and realize them as validated, contract-preserving artifacts. We introduce SeGaBench, an executable benchmark containing 100 synthetic and 20 source-backed cases spanning low-level assumptions, data-structure invariants, and high-level semantic lifting. Each case includes hidden enabling semantics, an oracle artifact, correctness and semantic validators, and a reproducible performance protocol. We evaluate five LLMs using five independent responses per case. The strongest model produces correct artifacts in 94.8% of responses, achieves at least 1.05x speedup in 83.3%, and obtains a performance success on 93.3% of cases. Nevertheless, correct artifacts often close only part of the oracle gap. These results show that LLMs can complement compiler analysis as speculative semantic proposers, provided that their artifacts are validated and evaluated."},{"descriptionType":"Other","description":"9 pages, 3 figures"}],"geoLocations":[],"fundingReferences":[],"url":"https://arxiv.org/abs/2608.03983","contentUrl":null,"metadataVersion":0,"schemaVersion":"http://datacite.org/schema/kernel-4","source":"mds","isActive":true,"state":"findable","reason":null,"viewCount":0,"downloadCount":0,"referenceCount":0,"citationCount":0,"partCount":0,"partOfCount":0,"versionCount":0,"versionOfCount":0,"created":"2026-08-05T02:25:29Z","registered":"2026-08-05T02:25:29Z","published":null,"updated":"2026-08-05T02:25:29Z"},"relationships":{"client":{"data":{"id":"arxiv.content","type":"clients"}}}},{"id":"10.48550/arxiv.2608.03981","type":"dois","attributes":{"doi":"10.48550/arxiv.2608.03981","identifiers":[{"identifier":"2608.03981","identifierType":"arXiv"}],"creators":[{"nameType":"Personal","givenName":"Miguel Barroso","familyName":"Varela","name":"Varela, Miguel Barroso","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Álvaro","familyName":"de la Cruz-Dombriz","name":"de la Cruz-Dombriz, Álvaro","affiliation":[],"nameIdentifiers":[]}],"titles":[{"title":"A Tale of Two Couplings: Bayesian Selection in the Interacting Dark Sector"}],"publisher":"arXiv","container":{},"publicationYear":2026,"subjects":[{"subject":"General Relativity and Quantum Cosmology (gr-qc)","lang":"en","subjectScheme":"arXiv"},{"subject":"Cosmology and Nongalactic Astrophysics (astro-ph.CO)","lang":"en","subjectScheme":"arXiv"},{"subject":"FOS: Physical sciences","subjectScheme":"Fields of Science and Technology (FOS)"}],"contributors":[],"dates":[{"date":"2026-08-04T17:45:52Z","dateType":"Submitted","dateInformation":"v1"},{"date":"2026-08-05T01:09:07Z","dateType":"Updated","dateInformation":"v1"},{"date":"2026-08","dateType":"Available","dateInformation":"v1"}],"language":null,"types":{"schemaOrg":"CreativeWork","resourceTypeGeneral":"Preprint","citeproc":"article","bibtex":"misc","ris":"GEN","resourceType":"Article"},"relatedIdentifiers":[],"relatedItems":[],"sizes":[],"formats":[],"version":"1","rightsList":[{"rightsIdentifierScheme":"SPDX","rightsUri":"https://creativecommons.org/licenses/by/4.0/legalcode","schemeUri":"https://spdx.org/licenses/","rights":"Creative Commons Attribution 4.0 International","rightsIdentifier":"cc-by-4.0"}],"descriptions":[{"descriptionType":"Abstract","description":"$Λ$CDM provides a remarkably successful description of the Universe, yet it suffers from persistent discrepancies, with one of the most prominent being the $σ_8$ tension between early-Universe Cosmic Microwave Background (CMB) measurements and late-time structure growth probes. To address this mismatch, we investigate generalized interacting dark sector models governed by a quintessence field coupled to dark matter via conformal and disformal transformations. By generically engineering a quintessence potential that ensures the combined evolution of dark matter and dark energy exactly mimics $Λ$CDM, our models satisfy all background constraints while signaling modified gravity effects within the linear perturbation sector. We perform a statistical analysis using late-time structure growth data anchored to Planck 2018 constraints. Furthermore, we address the initial conditions problem inherent to purely disformal models, demonstrating the necessity of a non-zero initial kinetic energy to initiate dynamical evolution. Our results indicate that purely conformal couplings efficiently transfer energy from dark matter to the quintessence field, suppressing late-time structure formation and successfully accommodating CMB data within late-time modified structure growth. This purely conformal limit yields a strong statistical preference over the $Λ$CDM baseline according to both the Akaike and Bayesian Information Criteria. Conversely, while non-zero disformal couplings introduce a kinetic friction that dampens the dark sector energy exchange, their expanded parameter space incurs heavy statistical penalties without providing a decisive improvement over the purely conformal scenario."},{"descriptionType":"Other","description":"33 pages, 4 figures"}],"geoLocations":[],"fundingReferences":[],"url":"https://arxiv.org/abs/2608.03981","contentUrl":null,"metadataVersion":0,"schemaVersion":"http://datacite.org/schema/kernel-4","source":"mds","isActive":true,"state":"findable","reason":null,"viewCount":0,"downloadCount":0,"referenceCount":0,"citationCount":0,"partCount":0,"partOfCount":0,"versionCount":0,"versionOfCount":0,"created":"2026-08-05T02:25:26Z","registered":"2026-08-05T02:25:27Z","published":null,"updated":"2026-08-05T02:25:27Z"},"relationships":{"client":{"data":{"id":"arxiv.content","type":"clients"}}}},{"id":"10.48550/arxiv.2608.03980","type":"dois","attributes":{"doi":"10.48550/arxiv.2608.03980","identifiers":[{"identifier":"2608.03980","identifierType":"arXiv"}],"creators":[{"nameType":"Personal","givenName":"Leonardos","familyName":"Gkouvelis","name":"Gkouvelis, Leonardos","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Francisco J.","familyName":"Pozuelos","name":"Pozuelos, Francisco J.","affiliation":[],"nameIdentifiers":[]}],"titles":[{"title":"Helium-poor winds do not require helium-poor planets"}],"publisher":"arXiv","container":{},"publicationYear":2026,"subjects":[{"subject":"Earth and Planetary Astrophysics (astro-ph.EP)","lang":"en","subjectScheme":"arXiv"},{"subject":"FOS: Physical sciences","subjectScheme":"Fields of Science and Technology (FOS)"}],"contributors":[],"dates":[{"date":"2026-08-04T17:45:33Z","dateType":"Submitted","dateInformation":"v1"},{"date":"2026-08-05T01:09:06Z","dateType":"Updated","dateInformation":"v1"},{"date":"2026-08","dateType":"Available","dateInformation":"v1"}],"language":null,"types":{"schemaOrg":"CreativeWork","resourceTypeGeneral":"Preprint","citeproc":"article","bibtex":"misc","ris":"GEN","resourceType":"Article"},"relatedIdentifiers":[],"relatedItems":[],"sizes":[],"formats":[],"version":"1","rightsList":[{"rightsUri":"http://arxiv.org/licenses/nonexclusive-distrib/1.0/","rights":"arXiv.org perpetual, non-exclusive license"}],"descriptions":[{"descriptionType":"Abstract","description":"Observations of the metastable He,{\\sc i},10830,Å triplet have revealed escaping exoplanet atmospheres whose inferred helium abundances range from nearly nebular compositions to strongly helium-depleted winds. Such depletion is commonly interpreted as evidence for atmospheric evolution, preferential escape, or departures from primordial composition. We present a closed-form analytic transport-retention theory for the atmospheric transition region between the homopause and the base of the planetary wind. The theory quantifies the competition between upward transport and molecular separation, demonstrating that transport physics alone can substantially deplete the helium abundance supplied to the escaping flow. Our solution yields a retention factor, $χ_{\\rm He}$, that measures the fraction of helium supplied to the base of the hydrodynamic wind relative to the deep atmospheric abundance. Combining the analytic framework with numerical forward models of the He,{\\sc i},10830,Å absorption and a sample of twelve helium-observed sub-Neptunes and mini-Neptunes, we find that observed systems span the full range of predicted retention states, from nearly complete retention to strong helium depletion. These forward models use the helium abundance supplied by the analytic framework as the lower-boundary condition to predict the corresponding He,{\\sc i},10830,Å absorption. We further show that increasing helium retention systematically strengthens the expected absorption signal by increasing the helium reservoir available to the upper atmosphere. These results suggest that helium depletion does not necessarily imply intrinsically helium-poor atmospheres or evolutionary transitions toward secondary compositions, but may instead be a natural consequence of transport physics in escaping atmospheres."},{"descriptionType":"Other","description":"Accepted for publication in The Astrophysical Journal"}],"geoLocations":[],"fundingReferences":[],"url":"https://arxiv.org/abs/2608.03980","contentUrl":null,"metadataVersion":0,"schemaVersion":"http://datacite.org/schema/kernel-4","source":"mds","isActive":true,"state":"findable","reason":null,"viewCount":0,"downloadCount":0,"referenceCount":0,"citationCount":0,"partCount":0,"partOfCount":0,"versionCount":0,"versionOfCount":0,"created":"2026-08-05T02:25:24Z","registered":"2026-08-05T02:25:25Z","published":null,"updated":"2026-08-05T02:25:25Z"},"relationships":{"client":{"data":{"id":"arxiv.content","type":"clients"}}}},{"id":"10.48550/arxiv.2608.03979","type":"dois","attributes":{"doi":"10.48550/arxiv.2608.03979","identifiers":[{"identifier":"2608.03979","identifierType":"arXiv"}],"creators":[{"nameType":"Personal","givenName":"Zhen","familyName":"Fang","name":"Fang, Zhen","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Yu","familyName":"Zeng","name":"Zeng, Yu","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Wenxuan","familyName":"Huang","name":"Huang, Wenxuan","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Yiming","familyName":"Zhao","name":"Zhao, Yiming","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Shiting","familyName":"Huang","name":"Huang, Shiting","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Tianfei","familyName":"Ren","name":"Ren, Tianfei","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Qi","familyName":"Lu","name":"Lu, Qi","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Qingnan","familyName":"Ren","name":"Ren, Qingnan","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Qisheng","familyName":"Su","name":"Su, Qisheng","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Lionel Z.","familyName":"Wang","name":"Wang, Lionel Z.","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Qingyu","familyName":"Yin","name":"Yin, Qingyu","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Shuang","familyName":"Chen","name":"Chen, Shuang","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Zehui","familyName":"Chen","name":"Chen, Zehui","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Lin","familyName":"Chen","name":"Chen, Lin","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Zhenfei","familyName":"Yin","name":"Yin, Zhenfei","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Yao","familyName":"Hu","name":"Hu, Yao","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Shaohui","familyName":"Lin","name":"Lin, Shaohui","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Wanli","familyName":"Ouyang","name":"Ouyang, Wanli","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Shaosheng","familyName":"Cao","name":"Cao, Shaosheng","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Feng","familyName":"Zhao","name":"Zhao, Feng","affiliation":[],"nameIdentifiers":[]}],"titles":[{"title":"Video-DeepResearch: Towards the Next-Generation Multimodal Deepresearch Agent"}],"publisher":"arXiv","container":{},"publicationYear":2026,"subjects":[{"subject":"Computer Vision and Pattern Recognition (cs.CV)","lang":"en","subjectScheme":"arXiv"},{"subject":"Artificial Intelligence (cs.AI)","lang":"en","subjectScheme":"arXiv"},{"subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"}],"contributors":[],"dates":[{"date":"2026-08-04T17:45:16Z","dateType":"Submitted","dateInformation":"v1"},{"date":"2026-08-05T01:09:03Z","dateType":"Updated","dateInformation":"v1"},{"date":"2026-08","dateType":"Available","dateInformation":"v1"}],"language":null,"types":{"schemaOrg":"CreativeWork","resourceTypeGeneral":"Preprint","citeproc":"article","bibtex":"misc","ris":"GEN","resourceType":"Article"},"relatedIdentifiers":[],"relatedItems":[],"sizes":[],"formats":[],"version":"1","rightsList":[{"rightsUri":"http://arxiv.org/licenses/nonexclusive-distrib/1.0/","rights":"arXiv.org perpetual, non-exclusive license"}],"descriptions":[{"descriptionType":"Abstract","description":"We introduce Video-DeepResearch (Video-DR), extending multimodal agents from static images to continuous video streams, a setting that demands dense spatiotemporal grounding coupled with open-web exploration. Preliminary evaluations reveal two critical bottlenecks in current models: (1) modality bias, where agents bypass visual tools in favor of textual search, and (2) parametric knowledge leakage, where models rely on internal memory rather than genuine tool-augmented execution. To address these challenges, we propose Video-DR, featuring a decoupled perception-exploration pipeline with stage-wise tool unlocking that compels exhaustive cross-frame visual grounding prior to web retrieval. Our framework adopts a two-stage training recipe: supervised fine-tuning followed by Group Relative Policy Optimization (GRPO), enabling autonomous exploration that breaks the imitation-learning ceiling. Furthermore, we curate Video-DR-Bench, a human-AI collaborative benchmark comprising 200 complex, multi-hop VQA instances. Empirical results demonstrate that our Video-DeepResearch-35B-A3B establishes a new state-of-the-art of 64.0% average accuracy, surpassing proprietary Claude-4.5-Sonnet (59.0%) by 5.0 points and significantly outperforming GPT-5 (52.5%) and Gemini 2.5 Pro (57.5%). The 30B-A3B variant achieves 59.3%, competitive with Claude-4.5-Sonnet and demonstrating the effectiveness of our training paradigm even at compact scale. Code: https://github.com/Osilly/Vision-DeepResearch."}],"geoLocations":[],"fundingReferences":[],"url":"https://arxiv.org/abs/2608.03979","contentUrl":null,"metadataVersion":0,"schemaVersion":"http://datacite.org/schema/kernel-4","source":"mds","isActive":true,"state":"findable","reason":null,"viewCount":0,"downloadCount":0,"referenceCount":0,"citationCount":0,"partCount":0,"partOfCount":0,"versionCount":0,"versionOfCount":0,"created":"2026-08-05T02:25:23Z","registered":"2026-08-05T02:25:24Z","published":null,"updated":"2026-08-05T02:25:24Z"},"relationships":{"client":{"data":{"id":"arxiv.content","type":"clients"}}}},{"id":"10.48550/arxiv.2608.03978","type":"dois","attributes":{"doi":"10.48550/arxiv.2608.03978","identifiers":[{"identifier":"2608.03978","identifierType":"arXiv"}],"creators":[{"nameType":"Personal","givenName":"Ashwin","familyName":"Gupta","name":"Gupta, Ashwin","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Joseph","familyName":"Moore","name":"Moore, Joseph","affiliation":[],"nameIdentifiers":[]}],"titles":[{"title":"Stochastic Multiple Shooting Trajectory Optimization via Sequential Local Policy Evaluation"}],"publisher":"arXiv","container":{},"publicationYear":2026,"subjects":[{"subject":"Robotics (cs.RO)","lang":"en","subjectScheme":"arXiv"},{"subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"}],"contributors":[],"dates":[{"date":"2026-08-04T17:43:21Z","dateType":"Submitted","dateInformation":"v1"},{"date":"2026-08-05T01:09:00Z","dateType":"Updated","dateInformation":"v1"},{"date":"2026-08","dateType":"Available","dateInformation":"v1"}],"language":null,"types":{"schemaOrg":"CreativeWork","resourceTypeGeneral":"Preprint","citeproc":"article","bibtex":"misc","ris":"GEN","resourceType":"Article"},"relatedIdentifiers":[],"relatedItems":[],"sizes":[],"formats":[],"version":"1","rightsList":[{"rightsUri":"http://arxiv.org/licenses/nonexclusive-distrib/1.0/","rights":"arXiv.org perpetual, non-exclusive license"}],"descriptions":[{"descriptionType":"Abstract","description":"Stochastic single shooting trajectory optimization methods such as Model Predictive Path Integral control (MPPI) have been widely adopted in robotics due to their ability to reason about probabilistic dynamics and provide solutions where model gradients are noisy, costly to evaluate, or unavailable. However, satisfaction of terminal constraints when shooting over long action sequences is often sample inefficient, requiring a large number of iterations for convergence. In this paper, we present a stochastic multiple shooting method that optimizes short control action sequences connected via local feedback policies to improve sample efficiency and convergence to a terminal set. Additionally, we show that we are able to synthesize approximate system Jacobians purely from rollouts, making the method suitable for model-based reinforcement learning with black-box dynamics. We demonstrate the algorithm has improved sample efficiency and terminal set convergence for three nonlinear, underactuated optimization problems: a classic cartpole swingup task with analytical dynamics, a cartpole swingup task with learned neural network dynamics, and a VTOL quadplane performing a high angle-of-attack, precision post-stall landing maneuver."}],"geoLocations":[],"fundingReferences":[],"url":"https://arxiv.org/abs/2608.03978","contentUrl":null,"metadataVersion":0,"schemaVersion":"http://datacite.org/schema/kernel-4","source":"mds","isActive":true,"state":"findable","reason":null,"viewCount":0,"downloadCount":0,"referenceCount":0,"citationCount":0,"partCount":0,"partOfCount":0,"versionCount":0,"versionOfCount":0,"created":"2026-08-05T02:25:21Z","registered":"2026-08-05T02:25:22Z","published":null,"updated":"2026-08-05T02:25:22Z"},"relationships":{"client":{"data":{"id":"arxiv.content","type":"clients"}}}},{"id":"10.48550/arxiv.2608.03977","type":"dois","attributes":{"doi":"10.48550/arxiv.2608.03977","identifiers":[{"identifier":"2608.03977","identifierType":"arXiv"}],"creators":[{"nameType":"Personal","givenName":"Dhyey","familyName":"Patel","name":"Patel, Dhyey","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Yunting","familyName":"Yin","name":"Yin, Yunting","affiliation":[],"nameIdentifiers":[]}],"titles":[{"title":"Transfer Learning for Avian Bioacoustics under Sparse Positive Labels"}],"publisher":"arXiv","container":{},"publicationYear":2026,"subjects":[{"subject":"Sound (cs.SD)","lang":"en","subjectScheme":"arXiv"},{"subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"}],"contributors":[],"dates":[{"date":"2026-08-04T17:42:05Z","dateType":"Submitted","dateInformation":"v1"},{"date":"2026-08-05T01:08:58Z","dateType":"Updated","dateInformation":"v1"},{"date":"2026-08","dateType":"Available","dateInformation":"v1"}],"language":null,"types":{"schemaOrg":"CreativeWork","resourceTypeGeneral":"Preprint","citeproc":"article","bibtex":"misc","ris":"GEN","resourceType":"Article"},"relatedIdentifiers":[],"relatedItems":[],"sizes":[],"formats":[],"version":"1","rightsList":[{"rightsUri":"http://arxiv.org/licenses/nonexclusive-distrib/1.0/","rights":"arXiv.org perpetual, non-exclusive license"}],"descriptions":[{"descriptionType":"Abstract","description":"Passive acoustic monitoring is an important tool for biodiversity assessment and wildlife conservation because it supports continuous and non-invasive monitoring of species across large spatial and temporal scales. Robust monitoring remains challenging because many datasets contain sparse positive labels, where species presences may be confirmed while unannotated species cannot be assumed absent. In this work, we study transfer learning under sparse positive labels using BirdCLEF+ 2026 as a target benchmark and BirdCLEF 2021, iNatSounds, WABAD, and BirdSet as external bioacoustic sources. We introduce a multi-source reliability framework that models heterogeneous bioacoustic datasets as distinct supervision sources with differing reliability. Our approach achieves 0.584 macro average precision and 0.860 macro AUC on public BirdCLEF+ 2026 validation labels while outperforming naive source pooling strategies. The strongest gains arise from passive acoustic monitoring datasets and biologically informed source selection. Our findings suggest that transfer learning in bioacoustics is fundamentally a weak supervision and negative transfer problem."},{"descriptionType":"Other","description":"Accepted to IEEE MLSP 2026"}],"geoLocations":[],"fundingReferences":[],"url":"https://arxiv.org/abs/2608.03977","contentUrl":null,"metadataVersion":0,"schemaVersion":"http://datacite.org/schema/kernel-4","source":"mds","isActive":true,"state":"findable","reason":null,"viewCount":0,"downloadCount":0,"referenceCount":0,"citationCount":0,"partCount":0,"partOfCount":0,"versionCount":0,"versionOfCount":0,"created":"2026-08-05T02:25:20Z","registered":"2026-08-05T02:25:21Z","published":null,"updated":"2026-08-05T02:25:21Z"},"relationships":{"client":{"data":{"id":"arxiv.content","type":"clients"}}}},{"id":"10.48550/arxiv.2608.03976","type":"dois","attributes":{"doi":"10.48550/arxiv.2608.03976","identifiers":[{"identifier":"2608.03976","identifierType":"arXiv"}],"creators":[{"nameType":"Personal","givenName":"Ray","familyName":"Walsh","name":"Walsh, Ray","affiliation":[],"nameIdentifiers":[]}],"titles":[{"title":"Symmetry/asymmetry within a cylindrical lattice model of nuclear structure predicts cosmic abundance/scarcity"}],"publisher":"arXiv","container":{},"publicationYear":2026,"subjects":[{"subject":"General Physics (physics.gen-ph)","lang":"en","subjectScheme":"arXiv"},{"subject":"FOS: Physical sciences","subjectScheme":"Fields of Science and Technology (FOS)"}],"contributors":[],"dates":[{"date":"2026-08-04T17:41:34Z","dateType":"Submitted","dateInformation":"v1"},{"date":"2026-08-05T01:08:56Z","dateType":"Updated","dateInformation":"v1"},{"date":"2026-08","dateType":"Available","dateInformation":"v1"}],"language":null,"types":{"schemaOrg":"CreativeWork","resourceTypeGeneral":"Preprint","citeproc":"article","bibtex":"misc","ris":"GEN","resourceType":"Article"},"relatedIdentifiers":[{"relationType":"IsVersionOf","relatedIdentifier":"10.1088/2399-6528/adb36f","relatedIdentifierType":"DOI"}],"relatedItems":[],"sizes":[],"formats":[],"version":"1","rightsList":[{"rightsIdentifierScheme":"SPDX","rightsUri":"https://creativecommons.org/licenses/by/4.0/legalcode","schemeUri":"https://spdx.org/licenses/","rights":"Creative Commons Attribution 4.0 International","rightsIdentifier":"cc-by-4.0"}],"descriptions":[{"descriptionType":"Abstract","description":"Protons and neutrons are the smallest forms of measurable matter, and each nucleon has 3 up (+2/3) and down (-1/3) quarks. Quarks treated as point-like particles within polygonal geometries model the structures of stable nuclides through $^{36}$Ar. The model derives from the proton's radius (r=0.8414 fm), the hadron's prolate spheroid shape (from the $Δ(1232)$ resonance), and the separation distance between bound nucleons ($\\approx$0.8 fm, from the Argonne $v_{18}$ $NN$ potential). The prolate nucleon's spatial extent arises from its 3 quarks, which implies a qualitatively linear quark sequence. Spin-spin forces repel the like-flavored quarks to opposite ends of the nucleon, leaving the unlike quark in the middle. Quark-to-quark distance within the nucleon corresponds to the nucleon's radius. Nucleons link by quark-to-quark interactions to form proton-neutron short-range correlated pairs (pn SRC pairs), separated by a distance equal to the proton's radius. Alternating nucleons produce regularly alternating up/down quark sequences. We contemplate structures for each stable nuclide through $^{36}$Ar and include the one whose rotational radius (from the regular polygon radius formula) best correlates with its accepted charge radius (r(31)=0.98, p\u0026lt;0.001). Nucleon alternation makes pn SRC pairs and produces the equal numbers of protons and neutrons (Z=N) in the isotopes $^{4}_{2}$He, $^{12}_{6}$C, $^{14}_{7}$N, $^{16}_{8}$O, $^{20}_{10}$Ne, $^{24}_{12}$Mg, $^{28}_{14}$Si, and $^{32}_{16}$S, comprising 99.5% of stable baryonic matter. Bilateral structural symmetry emerges as a sensitive and specific predictor of cosmic abundance. Opposing deuteron-deuteron alternating quark charge sequences produce alternating and unequal electromagnetic fields capable of modelling the close-range attraction and far-range repulsion of the fusion potential curve and Coulomb potential energy barrier."},{"descriptionType":"Other","description":"15 pages, 11 figures"}],"geoLocations":[],"fundingReferences":[],"url":"https://arxiv.org/abs/2608.03976","contentUrl":null,"metadataVersion":0,"schemaVersion":"http://datacite.org/schema/kernel-4","source":"mds","isActive":true,"state":"findable","reason":null,"viewCount":0,"downloadCount":0,"referenceCount":0,"citationCount":0,"partCount":0,"partOfCount":0,"versionCount":0,"versionOfCount":1,"created":"2026-08-05T02:25:19Z","registered":"2026-08-05T02:25:19Z","published":null,"updated":"2026-08-05T02:25:19Z"},"relationships":{"client":{"data":{"id":"arxiv.content","type":"clients"}}}},{"id":"10.48550/arxiv.2608.03975","type":"dois","attributes":{"doi":"10.48550/arxiv.2608.03975","identifiers":[{"identifier":"2608.03975","identifierType":"arXiv"}],"creators":[{"nameType":"Personal","givenName":"Max Fusté","familyName":"Costa","name":"Costa, Max Fusté","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Yong Sheng","familyName":"Koay","name":"Koay, Yong Sheng","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Stefano","familyName":"Moretti","name":"Moretti, Stefano","affiliation":[],"nameIdentifiers":[]}],"titles":[{"title":"Mono-X Signal Characterization from Two-component Dark Matter Using a Convolutional Neural Network"}],"publisher":"arXiv","container":{},"publicationYear":2026,"subjects":[{"subject":"High Energy Physics - Phenomenology (hep-ph)","lang":"en","subjectScheme":"arXiv"},{"subject":"FOS: Physical sciences","subjectScheme":"Fields of Science and Technology (FOS)"}],"contributors":[],"dates":[{"date":"2026-08-04T17:41:05Z","dateType":"Submitted","dateInformation":"v1"},{"date":"2026-08-05T01:08:55Z","dateType":"Updated","dateInformation":"v1"},{"date":"2026-08","dateType":"Available","dateInformation":"v1"}],"language":null,"types":{"schemaOrg":"CreativeWork","resourceTypeGeneral":"Preprint","citeproc":"article","bibtex":"misc","ris":"GEN","resourceType":"Article"},"relatedIdentifiers":[],"relatedItems":[],"sizes":[],"formats":[],"version":"1","rightsList":[{"rightsIdentifierScheme":"SPDX","rightsUri":"https://creativecommons.org/licenses/by/4.0/legalcode","schemeUri":"https://spdx.org/licenses/","rights":"Creative Commons Attribution 4.0 International","rightsIdentifier":"cc-by-4.0"}],"descriptions":[{"descriptionType":"Abstract","description":"We assess the scope of a Convolutional Neural Network (CNN) in characterizing potential signals of two-component Dark Matter (DM) arising at the Large Hadron Collider (LHC) from mono-jet and mono-Z probes. We show that such a CNN has the ability of not only inferring the presence of two DM particles but also of extracting their mass and spin, the latter being either 0 or 1/2, following detector level analysis. However, such result represents a conceptual proof-of-concept, as we have not entertained a signal-to-background analysis."}],"geoLocations":[],"fundingReferences":[],"url":"https://arxiv.org/abs/2608.03975","contentUrl":null,"metadataVersion":0,"schemaVersion":"http://datacite.org/schema/kernel-4","source":"mds","isActive":true,"state":"findable","reason":null,"viewCount":0,"downloadCount":0,"referenceCount":0,"citationCount":0,"partCount":0,"partOfCount":0,"versionCount":0,"versionOfCount":0,"created":"2026-08-05T02:25:17Z","registered":"2026-08-05T02:25:18Z","published":null,"updated":"2026-08-05T02:25:18Z"},"relationships":{"client":{"data":{"id":"arxiv.content","type":"clients"}}}},{"id":"10.48550/arxiv.2608.03974","type":"dois","attributes":{"doi":"10.48550/arxiv.2608.03974","identifiers":[{"identifier":"2608.03974","identifierType":"arXiv"}],"creators":[{"nameType":"Personal","givenName":"Yicheng","familyName":"Xiao","name":"Xiao, Yicheng","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Wenxun","familyName":"Dai","name":"Dai, Wenxun","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Xinran","familyName":"Qin","name":"Qin, Xinran","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Lin","familyName":"Song","name":"Song, Lin","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Maoquan","familyName":"Zhang","name":"Zhang, Maoquan","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Hang","familyName":"Xu","name":"Xu, Hang","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Yukang","familyName":"Chen","name":"Chen, Yukang","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Yitong","familyName":"Li","name":"Li, Yitong","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Guohui","familyName":"Zhang","name":"Zhang, Guohui","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Yuan","familyName":"Zhang","name":"Zhang, Yuan","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Xuying","familyName":"Zhang","name":"Zhang, Xuying","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Tommy","familyName":"Zhang","name":"Zhang, Tommy","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Jianlong","familyName":"Yuan","name":"Yuan, Jianlong","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Peihao","familyName":"Li","name":"Li, Peihao","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Shuai","familyName":"Lu","name":"Lu, Shuai","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Siming","familyName":"Fu","name":"Fu, Siming","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Chuyang","familyName":"Zhao","name":"Zhao, Chuyang","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Xin","familyName":"Han","name":"Han, Xin","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Jie","familyName":"Huang","name":"Huang, Jie","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Wenbo","familyName":"Li","name":"Li, Wenbo","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Guoqing","familyName":"Ma","name":"Ma, Guoqing","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Wei","familyName":"Huang","name":"Huang, Wei","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Xiaojuan","familyName":"Qi","name":"Qi, Xiaojuan","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Haoyang","familyName":"Huang","name":"Huang, Haoyang","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Nan","familyName":"Duan","name":"Duan, Nan","affiliation":[],"nameIdentifiers":[]}],"titles":[{"title":"JoyAI-Video-Edit: Real-Time Open-Ended Video Editing with Autoregressive Diffusion"}],"publisher":"arXiv","container":{},"publicationYear":2026,"subjects":[{"subject":"Computer Vision and Pattern Recognition (cs.CV)","lang":"en","subjectScheme":"arXiv"},{"subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"}],"contributors":[],"dates":[{"date":"2026-08-04T17:40:48Z","dateType":"Submitted","dateInformation":"v1"},{"date":"2026-08-05T01:08:53Z","dateType":"Updated","dateInformation":"v1"},{"date":"2026-08","dateType":"Available","dateInformation":"v1"}],"language":null,"types":{"schemaOrg":"CreativeWork","resourceTypeGeneral":"Preprint","citeproc":"article","bibtex":"misc","ris":"GEN","resourceType":"Article"},"relatedIdentifiers":[],"relatedItems":[],"sizes":[],"formats":[],"version":"1","rightsList":[{"rightsUri":"http://arxiv.org/licenses/nonexclusive-distrib/1.0/","rights":"arXiv.org perpetual, non-exclusive license"}],"descriptions":[{"descriptionType":"Abstract","description":"Real-time video editing requires low-latency causal generation with bounded computational resources while preserving source fidelity and long-term temporal consistency. We present JoyAI-Video-Edit, a 16B-parameter autoregressive diffusion framework for real-time, open-ended video editing without access to future frames or a predefined video duration. Our method combines chunk-wise autoregressive adaptation, Source-Anchored Distribution Matching Distillation (SA-DMD), and Long-Horizon Autoregressive Distillation to reduce train--inference mismatch, preserve source fidelity during two-step generation, and mitigate accumulated temporal drift. Extensive automatic and human evaluations show that JoyAI-Video-Edit substantially outperforms existing streaming editors and remains competitive with strong offline systems on both short and long videos. The complete system achieves end-to-end 720p video editing at approximately 30 FPS on a single Nvidia B200 GPU. Code is available at https://github.com/jd-opensource/JoyAI-Video-Edit."},{"descriptionType":"Other","description":"Code: https://github.com/jd-opensource/JoyAI-Video-Edit"}],"geoLocations":[],"fundingReferences":[],"url":"https://arxiv.org/abs/2608.03974","contentUrl":null,"metadataVersion":0,"schemaVersion":"http://datacite.org/schema/kernel-4","source":"mds","isActive":true,"state":"findable","reason":null,"viewCount":0,"downloadCount":0,"referenceCount":0,"citationCount":0,"partCount":0,"partOfCount":0,"versionCount":0,"versionOfCount":0,"created":"2026-08-05T02:25:16Z","registered":"2026-08-05T02:25:17Z","published":null,"updated":"2026-08-05T02:25:17Z"},"relationships":{"client":{"data":{"id":"arxiv.content","type":"clients"}}}},{"id":"10.48550/arxiv.2608.03973","type":"dois","attributes":{"doi":"10.48550/arxiv.2608.03973","identifiers":[{"identifier":"2608.03973","identifierType":"arXiv"}],"creators":[{"nameType":"Personal","givenName":"Unnati","familyName":"Narang","name":"Narang, Unnati","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Vishal","familyName":"Sachdev","name":"Sachdev, Vishal","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Ruichun","familyName":"Liu","name":"Liu, Ruichun","affiliation":[],"nameIdentifiers":[]}],"titles":[{"title":"When AI Wears Many Hats: The Role of Generative Artificial Intelligence in Marketing Education"}],"publisher":"arXiv","container":{},"publicationYear":2026,"subjects":[{"subject":"Computers and Society (cs.CY)","lang":"en","subjectScheme":"arXiv"},{"subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"},{"subject":"K.3.1; K.4.1; I.2.0","lang":"en","subjectScheme":"ACM"}],"contributors":[],"dates":[{"date":"2026-08-04T17:40:22Z","dateType":"Submitted","dateInformation":"v1"},{"date":"2026-08-05T01:08:52Z","dateType":"Updated","dateInformation":"v1"},{"date":"2026-08","dateType":"Available","dateInformation":"v1"}],"language":null,"types":{"schemaOrg":"CreativeWork","resourceTypeGeneral":"Preprint","citeproc":"article","bibtex":"misc","ris":"GEN","resourceType":"Article"},"relatedIdentifiers":[{"relationType":"IsVersionOf","relatedIdentifier":"10.1177/07439156251328237","relatedIdentifierType":"DOI"}],"relatedItems":[],"sizes":[],"formats":[],"version":"1","rightsList":[{"rightsUri":"http://arxiv.org/licenses/nonexclusive-distrib/1.0/","rights":"arXiv.org perpetual, non-exclusive license"}],"descriptions":[{"descriptionType":"Abstract","description":"Generative Artificial Intelligence (GAI) is increasingly being integrated into marketing education and is reshaping the skillsets required in marketing careers. While research has highlighted the promise and perils of incorporating GAI into education, there remains a need for a comprehensive framework to guide its effective use. In this research, we conduct a multipronged analysis, including a review of marketing course syllabi, a survey of marketing educators, and follow-up qualitative interviews. Building on Role Theory and the Community of Inquiry (CoI) model, we propose that GAI can assume three roles in marketing education: tutor, teammate, and tool. Each role influences teaching, social, and cognitive presence differently, shaping the learning experience and preparing workplace-ready marketing graduates. For instance, as a tutor, GAI can aid students in grasping theoretical concepts, while as a teammate, it can foster collaboration by supporting brainstorming and problem-solving activities. However, ethical considerations such as data privacy, plagiarism, dependency on AI, and fairness in assessment must be addressed to ensure its responsible adoption in marketing education. We provide concrete examples for GAI's careful integration in marketing courses, and its implications for marketing educators, learners, and policymakers."},{"descriptionType":"Other","description":"Accepted manuscript (post-peer-review, pre-copyedit) version. Published in Journal of Public Policy \u0026amp; Marketing, 44(3), 473-489, 44 pages"}],"geoLocations":[],"fundingReferences":[],"url":"https://arxiv.org/abs/2608.03973","contentUrl":null,"metadataVersion":0,"schemaVersion":"http://datacite.org/schema/kernel-4","source":"mds","isActive":true,"state":"findable","reason":null,"viewCount":0,"downloadCount":0,"referenceCount":0,"citationCount":0,"partCount":0,"partOfCount":0,"versionCount":0,"versionOfCount":1,"created":"2026-08-05T02:25:14Z","registered":"2026-08-05T02:25:15Z","published":null,"updated":"2026-08-05T02:25:15Z"},"relationships":{"client":{"data":{"id":"arxiv.content","type":"clients"}}}},{"id":"10.48550/arxiv.2608.03972","type":"dois","attributes":{"doi":"10.48550/arxiv.2608.03972","identifiers":[{"identifier":"2608.03972","identifierType":"arXiv"}],"creators":[{"nameType":"Personal","givenName":"Jinhe","familyName":"Bi","name":"Bi, Jinhe","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Chennan","familyName":"Zhou","name":"Zhou, Chennan","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Zengjie","familyName":"Jin","name":"Jin, Zengjie","affiliation":[],"nameIdentifiers":[]},{"nameType":"Organizational","name":"Aniri","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Shuo","familyName":"Lu","name":"Lu, Shuo","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Wenke","familyName":"Huang","name":"Huang, Wenke","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Hu","familyName":"Cao","name":"Cao, Hu","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Xun","familyName":"Xiao","name":"Xiao, Xun","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Zhihong","familyName":"Zhu","name":"Zhu, Zhihong","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Volker","familyName":"Tresp","name":"Tresp, Volker","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Fei","familyName":"Shen","name":"Shen, Fei","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Yunpu","familyName":"Ma","name":"Ma, Yunpu","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Tat-Seng","familyName":"Chua","name":"Chua, Tat-Seng","affiliation":[],"nameIdentifiers":[]}],"titles":[{"title":"ReflectRL: Learning from Golden Negative Trajectories via Reflective-to-Direct Reasoning"}],"publisher":"arXiv","container":{},"publicationYear":2026,"subjects":[{"subject":"Artificial Intelligence (cs.AI)","lang":"en","subjectScheme":"arXiv"},{"subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"}],"contributors":[],"dates":[{"date":"2026-08-04T17:40:08Z","dateType":"Submitted","dateInformation":"v1"},{"date":"2026-08-05T01:08:51Z","dateType":"Updated","dateInformation":"v1"},{"date":"2026-08","dateType":"Available","dateInformation":"v1"}],"language":null,"types":{"schemaOrg":"CreativeWork","resourceTypeGeneral":"Preprint","citeproc":"article","bibtex":"misc","ris":"GEN","resourceType":"Article"},"relatedIdentifiers":[],"relatedItems":[],"sizes":[],"formats":[],"version":"1","rightsList":[{"rightsUri":"http://arxiv.org/licenses/nonexclusive-distrib/1.0/","rights":"arXiv.org perpetual, non-exclusive license"}],"descriptions":[{"descriptionType":"Abstract","description":"On-policy training has emerged as a powerful post-training paradigm for improving the reasoning capabilities of large language models, and is often enhanced by golden trajectories from stronger expert models. However, when the expert fails on harder problems, existing trajectory-guided methods lose their main source of supervision, and these failed trajectories are typically discarded as negative samples. We argue that such failures, which we call Golden Negative Trajectories, can still provide valuable reasoning signals when treated not as demonstrations to imitate, but as flawed trajectories to reflect upon. We identify a Reflection Advantage: for hard problems, reflecting on a flawed trajectory can be easier and more effective than solving the problem directly from scratch. Motivated by this, we propose ReflectRL, a lightweight plug-and-play framework that learns from Golden Negative Trajectories during on-policy training. ReflectRL first uses these trajectories to elicit Reflective Reasoning, then applies Reflective-to-Direct Policy Transition to transfer the acquired reasoning behavior back to Direct Reasoning. Experiments across 9 benchmarks, 4 LLM backbones, and 4 on-policy training methods show that ReflectRL consistently improves reasoning performance with minimal overhead."},{"descriptionType":"Other","description":"Project page: https://github.com/bibisbar/ReflectRL"}],"geoLocations":[],"fundingReferences":[],"url":"https://arxiv.org/abs/2608.03972","contentUrl":null,"metadataVersion":0,"schemaVersion":"http://datacite.org/schema/kernel-4","source":"mds","isActive":true,"state":"findable","reason":null,"viewCount":0,"downloadCount":0,"referenceCount":0,"citationCount":0,"partCount":0,"partOfCount":0,"versionCount":0,"versionOfCount":0,"created":"2026-08-05T02:25:13Z","registered":"2026-08-05T02:25:13Z","published":null,"updated":"2026-08-05T02:25:13Z"},"relationships":{"client":{"data":{"id":"arxiv.content","type":"clients"}}}},{"id":"10.48550/arxiv.2608.03971","type":"dois","attributes":{"doi":"10.48550/arxiv.2608.03971","identifiers":[{"identifier":"2608.03971","identifierType":"arXiv"}],"creators":[{"nameType":"Personal","givenName":"Zongjian","familyName":"Li","name":"Li, Zongjian","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Zhiyuan","familyName":"Yan","name":"Yan, Zhiyuan","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Chenxu","familyName":"Bai","name":"Bai, Chenxu","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Chen","familyName":"Chen","name":"Chen, Chen","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Haoxiang","familyName":"Sun","name":"Sun, Haoxiang","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Shaodong","familyName":"Wang","name":"Wang, Shaodong","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Feize","familyName":"Wu","name":"Wu, Feize","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Shenghai","familyName":"Yuan","name":"Yuan, Shenghai","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Bin","familyName":"Lin","name":"Lin, Bin","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Zheyuan","familyName":"Liu","name":"Liu, Zheyuan","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Yuwei","familyName":"Niu","name":"Niu, Yuwei","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Li","familyName":"Yuan","name":"Yuan, Li","affiliation":[],"nameIdentifiers":[]}],"titles":[{"title":"UniWorld-Design: From Pixel Generation to Layer-Native Design"}],"publisher":"arXiv","container":{},"publicationYear":2026,"subjects":[{"subject":"Computer Vision and Pattern Recognition (cs.CV)","lang":"en","subjectScheme":"arXiv"},{"subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"}],"contributors":[],"dates":[{"date":"2026-08-04T17:39:37Z","dateType":"Submitted","dateInformation":"v1"},{"date":"2026-08-05T01:08:49Z","dateType":"Updated","dateInformation":"v1"},{"date":"2026-08","dateType":"Available","dateInformation":"v1"}],"language":null,"types":{"schemaOrg":"CreativeWork","resourceTypeGeneral":"Preprint","citeproc":"article","bibtex":"misc","ris":"GEN","resourceType":"Article"},"relatedIdentifiers":[],"relatedItems":[],"sizes":[],"formats":[],"version":"1","rightsList":[{"rightsIdentifierScheme":"SPDX","rightsUri":"https://creativecommons.org/licenses/by/4.0/legalcode","schemeUri":"https://spdx.org/licenses/","rights":"Creative Commons Attribution 4.0 International","rightsIdentifier":"cc-by-4.0"}],"descriptions":[{"descriptionType":"Abstract","description":"We introduce UniWorld-Design, a framework that redefines image generation from flat pixel synthesis to structured visual composition, with semantic RGBA layers as the atomic units of generation, understanding, and editing. Our key insight is that pixels define how an image is rendered, whereas layers define how an image is created, understood, and edited. Just as human designers create and manipulate visual content through layers rather than raw pixels, UniWorld-Design equips multimodal generative models with a layer-native design space. UniWorld-Design comprises two models. The Text-to-RGBA (T2RGBA) model generates standalone RGBA assets directly from text. The Image-to-Layer (I2L) model conditions on a finished image, a global instruction and per-layer prompts, and jointly produces ordered, complete semantic RGBA layers. Its instruction interface supports top-level decomposition, recursive decomposition and targeted extraction, making layering an instruction-addressable operation for agentic editing. Because I2L learns complete semantic objects rather than visible-pixel partitions, its layers stay usable when moved or removed. On the Crello benchmark, I2L reduces per-layer RGB L1 error by 37% and achieves a 34% relative improvement in Alpha Soft IoU over Qwen-Image-Layered. Separately, T2RGBA achieves the highest CLIP Score, outperforming LayerDiffuse and OmniAlpha."},{"descriptionType":"Other","description":"Project page: https://rabbitvis.rabbitpre.com/blog"}],"geoLocations":[],"fundingReferences":[],"url":"https://arxiv.org/abs/2608.03971","contentUrl":null,"metadataVersion":0,"schemaVersion":"http://datacite.org/schema/kernel-4","source":"mds","isActive":true,"state":"findable","reason":null,"viewCount":0,"downloadCount":0,"referenceCount":0,"citationCount":0,"partCount":0,"partOfCount":0,"versionCount":0,"versionOfCount":0,"created":"2026-08-05T02:25:11Z","registered":"2026-08-05T02:25:12Z","published":null,"updated":"2026-08-05T02:25:12Z"},"relationships":{"client":{"data":{"id":"arxiv.content","type":"clients"}}}},{"id":"10.48550/arxiv.2608.03970","type":"dois","attributes":{"doi":"10.48550/arxiv.2608.03970","identifiers":[{"identifier":"2608.03970","identifierType":"arXiv"}],"creators":[{"nameType":"Personal","givenName":"Zizhao","familyName":"Hu","name":"Hu, Zizhao","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Nathan Elijah","familyName":"Segura","name":"Segura, Nathan Elijah","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Mohammad","familyName":"Rostami","name":"Rostami, Mohammad","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Jesse","familyName":"Thomason","name":"Thomason, Jesse","affiliation":[],"nameIdentifiers":[]}],"titles":[{"title":"Should We Type or Talk to LLM Agents? A Comprehensive Study of Voice and Keyboard Input Perturbations"}],"publisher":"arXiv","container":{},"publicationYear":2026,"subjects":[{"subject":"Artificial Intelligence (cs.AI)","lang":"en","subjectScheme":"arXiv"},{"subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"}],"contributors":[],"dates":[{"date":"2026-08-04T17:38:06Z","dateType":"Submitted","dateInformation":"v1"},{"date":"2026-08-05T01:08:48Z","dateType":"Updated","dateInformation":"v1"},{"date":"2026-08","dateType":"Available","dateInformation":"v1"}],"language":null,"types":{"schemaOrg":"CreativeWork","resourceTypeGeneral":"Preprint","citeproc":"article","bibtex":"misc","ris":"GEN","resourceType":"Article"},"relatedIdentifiers":[],"relatedItems":[],"sizes":[],"formats":[],"version":"1","rightsList":[{"rightsIdentifierScheme":"SPDX","rightsUri":"https://creativecommons.org/licenses/by/4.0/legalcode","schemeUri":"https://spdx.org/licenses/","rights":"Creative Commons Attribution 4.0 International","rightsIdentifier":"cc-by-4.0"}],"descriptions":[{"descriptionType":"Abstract","description":"Human input reaches language models by typing or speaking, and each channel leaves a distinct signature: orthographic noise for keyboards; for voice, disfluency from conventional transcription and restructuring from AI-backed dictation tools. How do they impact an LLM's performance? In this paper we present HIVE (Human Input-Variation Engine), a suite of voice transcription perturbations and QWERTY keyboard perturbations. We use HIVE to evaluate how robust models are to these perturbations. We present seven findings. (i) Voice transcription perturbations lower accuracy across every instruction-tuned model we test, and it is the structure of the transcription rather than its fillers that carries the cost. (ii) QWERTY keyboard perturbations cost less, and a model absorbs a lot of them before accuracy falls away. (iii) Both trace back to one cause, how many of the question's tokens survive the perturbation: destroying a token is what hurts, while adding new ones alongside it costs little. (iv) The gap between the two channels appears only where the answer must be constructed or deduced; on multiple choice there is none. (v) The harm does not solely come from test-set contamination. (vi) It cannot be trained away with lightweight adaptation. (vii) A thinking budget recovers the keyboard channel almost entirely but leaves the spoken registers untouched, and compressed speech is worse with it."}],"geoLocations":[],"fundingReferences":[],"url":"https://arxiv.org/abs/2608.03970","contentUrl":null,"metadataVersion":0,"schemaVersion":"http://datacite.org/schema/kernel-4","source":"mds","isActive":true,"state":"findable","reason":null,"viewCount":0,"downloadCount":0,"referenceCount":0,"citationCount":0,"partCount":0,"partOfCount":0,"versionCount":0,"versionOfCount":0,"created":"2026-08-05T02:25:10Z","registered":"2026-08-05T02:25:11Z","published":null,"updated":"2026-08-05T02:25:11Z"},"relationships":{"client":{"data":{"id":"arxiv.content","type":"clients"}}}},{"id":"10.48550/arxiv.2608.03969","type":"dois","attributes":{"doi":"10.48550/arxiv.2608.03969","identifiers":[{"identifier":"2608.03969","identifierType":"arXiv"}],"creators":[{"nameType":"Personal","givenName":"Kavil","familyName":"Mehta","name":"Mehta, Kavil","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Jatin","familyName":"Parashar","name":"Parashar, Jatin","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Shivangi","familyName":"Bidoliya","name":"Bidoliya, Shivangi","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Prashant","familyName":"Kumar","name":"Kumar, Prashant","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Muhammad","familyName":"Tayyab","name":"Tayyab, Muhammad","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Anand","familyName":"Moorti","name":"Moorti, Anand","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Juzer Ali","familyName":"Chakera","name":"Chakera, Juzer Ali","affiliation":[],"nameIdentifiers":[]}],"titles":[{"title":"Development of Thomson parabola spectrometer for diagnostics of ions driven by ultrahigh intensity laser: Simulations and numerical analysis"}],"publisher":"arXiv","container":{},"publicationYear":2026,"subjects":[{"subject":"Plasma Physics (physics.plasm-ph)","lang":"en","subjectScheme":"arXiv"},{"subject":"FOS: Physical sciences","subjectScheme":"Fields of Science and Technology (FOS)"}],"contributors":[],"dates":[{"date":"2026-08-04T17:34:39Z","dateType":"Submitted","dateInformation":"v1"},{"date":"2026-08-05T01:08:41Z","dateType":"Updated","dateInformation":"v1"},{"date":"2026-08","dateType":"Available","dateInformation":"v1"}],"language":null,"types":{"schemaOrg":"CreativeWork","resourceTypeGeneral":"Preprint","citeproc":"article","bibtex":"misc","ris":"GEN","resourceType":"Article"},"relatedIdentifiers":[],"relatedItems":[],"sizes":[],"formats":[],"version":"1","rightsList":[{"rightsIdentifierScheme":"SPDX","rightsUri":"https://creativecommons.org/licenses/by-nc-sa/4.0/legalcode","schemeUri":"https://spdx.org/licenses/","rights":"Creative Commons Attribution Non Commercial Share Alike 4.0 International","rightsIdentifier":"cc-by-nc-sa-4.0"}],"descriptions":[{"descriptionType":"Abstract","description":"A Thomson parabola ion spectrometer (TPIS) has been designed and developed for diagnostics of laseraccelerated ion beams in the MeV energy range. The TPIS has been validated by ion acceleration experiment at petawatt laser facility. Necessary simulations to evaluate the electric and magnetic field distributions have been performed with the help of a numerical simulation software to aid the selection of the spectrometer geometry while minimising fringe-field effects. Analytical dispersion expressions have been formulated from the simulations that take into account the spatial variation in the electromagnetic field profiles. The ion deflections obtained from these expressions demonstrate an improved agreement with experimentally measured proton trajectories compared to the case when constant fields are considered. The TPIS hence fabricated in-house has been subject to magnetic field measurements, which are in excellent agreement with the simulated field profile. The TPIS has the provision to change the field-free drift region, showcasing flexibility to be employed over a broad energy range and with different experimental setups. The spectrometer has been subsequently used for detecting laser-accelerated ion beams from thin aluminum foil targets. These experiments have demonstrated the capability of the spectrometer to resolve multiple ion species with sufficient separation between them. The developed TPIS provides a compact, flexible and accurate diagnostic for high-energy laser-plasma experiments."}],"geoLocations":[],"fundingReferences":[],"url":"https://arxiv.org/abs/2608.03969","contentUrl":null,"metadataVersion":0,"schemaVersion":"http://datacite.org/schema/kernel-4","source":"mds","isActive":true,"state":"findable","reason":null,"viewCount":0,"downloadCount":0,"referenceCount":0,"citationCount":0,"partCount":0,"partOfCount":0,"versionCount":0,"versionOfCount":0,"created":"2026-08-05T02:25:09Z","registered":"2026-08-05T02:25:10Z","published":null,"updated":"2026-08-05T02:25:10Z"},"relationships":{"client":{"data":{"id":"arxiv.content","type":"clients"}}}},{"id":"10.48550/arxiv.2608.03968","type":"dois","attributes":{"doi":"10.48550/arxiv.2608.03968","identifiers":[{"identifier":"2608.03968","identifierType":"arXiv"}],"creators":[{"nameType":"Personal","givenName":"Sahana","familyName":"Varadaraju","name":"Varadaraju, Sahana","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Bharathwaj","familyName":"Vijayakumar","name":"Vijayakumar, Bharathwaj","affiliation":[],"nameIdentifiers":[]}],"titles":[{"title":"Beyond Compliance: A Proposed Framework for Ethical Governance of Student Data in Learning Analytics"}],"publisher":"arXiv","container":{},"publicationYear":2026,"subjects":[{"subject":"Computers and Society (cs.CY)","lang":"en","subjectScheme":"arXiv"},{"subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"},{"subject":"K.3.1; K.4.1","lang":"en","subjectScheme":"ACM"}],"contributors":[],"dates":[{"date":"2026-08-04T17:34:29Z","dateType":"Submitted","dateInformation":"v1"},{"date":"2026-08-05T01:08:40Z","dateType":"Updated","dateInformation":"v1"},{"date":"2026-08","dateType":"Available","dateInformation":"v1"}],"language":null,"types":{"schemaOrg":"CreativeWork","resourceTypeGeneral":"Preprint","citeproc":"article","bibtex":"misc","ris":"GEN","resourceType":"Article"},"relatedIdentifiers":[{"relationType":"IsVersionOf","relatedIdentifier":"10.21125/edulearn.2026.1927","relatedIdentifierType":"DOI"}],"relatedItems":[],"sizes":[],"formats":[],"version":"1","rightsList":[{"rightsUri":"http://arxiv.org/licenses/nonexclusive-distrib/1.0/","rights":"arXiv.org perpetual, non-exclusive license"}],"descriptions":[{"descriptionType":"Abstract","description":"The rapid growth of learning analytics (LA) in higher education has expanded institutional capacity to monitor engagement, predict academic difficulty, and target support using student data. While these practices offer important educational benefits, governance has often remained compliance-first, centered on meeting baseline legal requirements such as the Family Educational Rights and Privacy Act (FERPA) and the General Data Protection Regulation (GDPR). Legal compliance is necessary, but it does not by itself resolve questions of fairness, student agency, accountability, or educational purpose. This paper proposes the LEAGUE framework, a six-pillar model for ethical governance of student data in LA: Lawfulness, Equity, Agency, Governance, Utility, and Ethics by Design. The framework is developed through a conceptual synthesis of scholarship in learning analytics, educational data mining, data ethics, educational policy, value-sensitive design, and capability-oriented approaches to educational justice. Its practical value is demonstrated through an illustrative early alert case that shows how institutions can review learning analytics in a more transparent and educationally meaningful way."},{"descriptionType":"Other","description":"11 pages, 1 figure, 4 tables. Accepted and published in the EDULEARN26 Proceedings (IATED, 2026). Author manuscript with minor post-publication revisions"}],"geoLocations":[],"fundingReferences":[],"url":"https://arxiv.org/abs/2608.03968","contentUrl":null,"metadataVersion":0,"schemaVersion":"http://datacite.org/schema/kernel-4","source":"mds","isActive":true,"state":"findable","reason":null,"viewCount":0,"downloadCount":0,"referenceCount":0,"citationCount":0,"partCount":0,"partOfCount":0,"versionCount":0,"versionOfCount":1,"created":"2026-08-05T02:25:07Z","registered":"2026-08-05T02:25:08Z","published":null,"updated":"2026-08-05T02:25:08Z"},"relationships":{"client":{"data":{"id":"arxiv.content","type":"clients"}}}},{"id":"10.48550/arxiv.2608.03967","type":"dois","attributes":{"doi":"10.48550/arxiv.2608.03967","identifiers":[{"identifier":"2608.03967","identifierType":"arXiv"}],"creators":[{"nameType":"Personal","givenName":"Yordan","familyName":"Raykov","name":"Raykov, Yordan","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Rodrigo","familyName":"Veiga","name":"Veiga, Rodrigo","affiliation":[],"nameIdentifiers":[]}],"titles":[{"title":"Information-Geometric Forward Policy Training in GFlowNets"}],"publisher":"arXiv","container":{},"publicationYear":2026,"subjects":[{"subject":"Machine Learning (stat.ML)","lang":"en","subjectScheme":"arXiv"},{"subject":"Machine Learning (cs.LG)","lang":"en","subjectScheme":"arXiv"},{"subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"}],"contributors":[],"dates":[{"date":"2026-08-04T17:34:14Z","dateType":"Submitted","dateInformation":"v1"},{"date":"2026-08-05T01:08:40Z","dateType":"Updated","dateInformation":"v1"},{"date":"2026-08","dateType":"Available","dateInformation":"v1"}],"language":null,"types":{"schemaOrg":"CreativeWork","resourceTypeGeneral":"Preprint","citeproc":"article","bibtex":"misc","ris":"GEN","resourceType":"Article"},"relatedIdentifiers":[],"relatedItems":[],"sizes":[],"formats":[],"version":"1","rightsList":[{"rightsIdentifierScheme":"SPDX","rightsUri":"https://creativecommons.org/licenses/by/4.0/legalcode","schemeUri":"https://spdx.org/licenses/","rights":"Creative Commons Attribution 4.0 International","rightsIdentifier":"cc-by-4.0"}],"descriptions":[{"descriptionType":"Abstract","description":"Generative Flow Networks (GFlowNets) have emerged as a flexible framework for amortised inference over discrete and mixed discrete-continuous objects, requiring only an unnormalised target density specified through a reward. In this work, we formulate forward-policy training in GFlowNets through the information geometry of the induced trajectory sampler. Treating the forward policy as an induced trajectory sampler, we show that its intrinsic first-order geometry is given by the Fisher-Rao metric of the trajectory family, and that the associated natural gradient provides the canonical local update whenever the corresponding Fisher information is computable or accurately approximable. We derive an exact decomposition of the trajectory Fisher into per-step conditional second moments, which clarifies when temporal score interactions vanish and when dense couplings remain under shared parameterisation. This leads to three computational regimes: settings with tractable exact Fisher information, settings where Monte Carlo estimators of the expected Fisher are sufficient, and structure-exploitable settings in which target locality or factorisation yields accurate approximations of the Fisher expectation. In the latter case, graphical-model tools such as exact marginalisation, separator methods, and belief propagation provide principled surrogates for natural-gradient updates. The resulting framework turns target structure into optimisation geometry and yields a tractable route to structure-aware forward-policy training in GFlowNets. We illustrate the framework empirically through examples comparing convergence and exploration behaviour under Riemannian and Euclidean optimisation."},{"descriptionType":"Other","description":"13 pages + appendix"}],"geoLocations":[],"fundingReferences":[],"url":"https://arxiv.org/abs/2608.03967","contentUrl":null,"metadataVersion":0,"schemaVersion":"http://datacite.org/schema/kernel-4","source":"mds","isActive":true,"state":"findable","reason":null,"viewCount":0,"downloadCount":0,"referenceCount":0,"citationCount":0,"partCount":0,"partOfCount":0,"versionCount":0,"versionOfCount":0,"created":"2026-08-05T02:25:06Z","registered":"2026-08-05T02:25:07Z","published":null,"updated":"2026-08-05T02:25:07Z"},"relationships":{"client":{"data":{"id":"arxiv.content","type":"clients"}}}},{"id":"10.48550/arxiv.2608.03965","type":"dois","attributes":{"doi":"10.48550/arxiv.2608.03965","identifiers":[{"identifier":"2608.03965","identifierType":"arXiv"}],"creators":[{"nameType":"Personal","givenName":"Wouter Cames","familyName":"van Batenburg","name":"van Batenburg, Wouter Cames","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Samuel","familyName":"Korsky","name":"Korsky, Samuel","affiliation":[],"nameIdentifiers":[]}],"titles":[{"title":"Asymptotically attaining the Moore bound"}],"publisher":"arXiv","container":{},"publicationYear":2026,"subjects":[{"subject":"Combinatorics (math.CO)","lang":"en","subjectScheme":"arXiv"},{"subject":"Discrete Mathematics (cs.DM)","lang":"en","subjectScheme":"arXiv"},{"subject":"FOS: Mathematics","subjectScheme":"Fields of Science and Technology (FOS)"},{"subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"}],"contributors":[],"dates":[{"date":"2026-08-04T17:30:09Z","dateType":"Submitted","dateInformation":"v1"},{"date":"2026-08-05T01:08:27Z","dateType":"Updated","dateInformation":"v1"},{"date":"2026-08","dateType":"Available","dateInformation":"v1"}],"language":null,"types":{"schemaOrg":"CreativeWork","resourceTypeGeneral":"Preprint","citeproc":"article","bibtex":"misc","ris":"GEN","resourceType":"Article"},"relatedIdentifiers":[],"relatedItems":[],"sizes":[],"formats":[],"version":"1","rightsList":[{"rightsIdentifierScheme":"SPDX","rightsUri":"https://creativecommons.org/licenses/by/4.0/legalcode","schemeUri":"https://spdx.org/licenses/","rights":"Creative Commons Attribution 4.0 International","rightsIdentifier":"cc-by-4.0"}],"descriptions":[{"descriptionType":"Abstract","description":"For positive integers $d$ and $k$, let $n_k(d)$ be the maximum order of a graph of maximum degree at most $d$ and diameter at most $k$. We prove that $$ \\lim_{d\\to\\infty}\\frac{n_k(d)}{d^k}=1$$ for every fixed $k$, thereby resolving the asymptotic degree-diameter problem for fixed diameter and proving a conjecture of Bollobás. The lower bound comes from regular graphs $H_{k,q}$, indexed by prime powers $q$, whose vertices are partial flags in $\\mathbb{F}_q^{\\,2k+1}$. These graphs have diameter $k$ and order $|V(H_{k,q})| =(1+o(1))Δ(H_{k,q})^k$. We also construct, for every fixed $\\ell \\ge 2$, graphs of maximum degree at most $d$ and line-graph diameter at most $\\ell$ with $(1+o(1))d^{\\ell}$ edges."},{"descriptionType":"Other","description":"$7+\\epsilon$ pages"}],"geoLocations":[],"fundingReferences":[],"url":"https://arxiv.org/abs/2608.03965","contentUrl":null,"metadataVersion":0,"schemaVersion":"http://datacite.org/schema/kernel-4","source":"mds","isActive":true,"state":"findable","reason":null,"viewCount":0,"downloadCount":0,"referenceCount":0,"citationCount":0,"partCount":0,"partOfCount":0,"versionCount":0,"versionOfCount":0,"created":"2026-08-05T02:25:03Z","registered":"2026-08-05T02:25:04Z","published":null,"updated":"2026-08-05T02:25:04Z"},"relationships":{"client":{"data":{"id":"arxiv.content","type":"clients"}}}},{"id":"10.48550/arxiv.2608.03963","type":"dois","attributes":{"doi":"10.48550/arxiv.2608.03963","identifiers":[{"identifier":"2608.03963","identifierType":"arXiv"}],"creators":[{"nameType":"Personal","givenName":"Arefur","familyName":"Rahman","name":"Rahman, Arefur","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Matthew L.","familyName":"Stevens","name":"Stevens, Matthew L.","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Cory M.","familyName":"Nunn","name":"Nunn, Cory M.","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Daniel E.","familyName":"Jones","name":"Jones, Daniel E.","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Brian T.","familyName":"Kirby","name":"Kirby, Brian T.","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Joseph M.","familyName":"Lukens","name":"Lukens, Joseph M.","affiliation":[],"nameIdentifiers":[]}],"titles":[{"title":"A quantum game of telephone"}],"publisher":"arXiv","container":{},"publicationYear":2026,"subjects":[{"subject":"Quantum Physics (quant-ph)","lang":"en","subjectScheme":"arXiv"},{"subject":"FOS: Physical sciences","subjectScheme":"Fields of Science and Technology (FOS)"}],"contributors":[],"dates":[{"date":"2026-08-04T17:28:28Z","dateType":"Submitted","dateInformation":"v1"},{"date":"2026-08-05T01:08:18Z","dateType":"Updated","dateInformation":"v1"},{"date":"2026-08","dateType":"Available","dateInformation":"v1"}],"language":null,"types":{"schemaOrg":"CreativeWork","resourceTypeGeneral":"Preprint","citeproc":"article","bibtex":"misc","ris":"GEN","resourceType":"Article"},"relatedIdentifiers":[],"relatedItems":[],"sizes":[],"formats":[],"version":"1","rightsList":[{"rightsUri":"http://arxiv.org/licenses/nonexclusive-distrib/1.0/","rights":"arXiv.org perpetual, non-exclusive license"}],"descriptions":[{"descriptionType":"Abstract","description":"Characterizing multinode quantum networks without ubiquitous local entanglement sources presents significant experimental challenges. We introduce ``quantum telephone,'' an iterative ancilla-assisted process tomography protocol that leverages intermediate detection events, effectively treating previously probed links as ancillae for subsequent links. Implemented on a deployed multinode fiber network, we observe noisy intermediate channels create fundamental parameter degeneracies that compound inference errors under sequential estimation. Counterintuitively, the inclusion of downstream near-unitary channels provides boundary constraints that, when used in tandem with global inference, can resolve ambiguity in channels earlier in the sequence. By compensating for localized information loss, this approach obviates the strict full-rank requirements of standard ancilla-assisted process tomography, even when intermediate states become completely depolarized. Overall, quantum telephone offers a hardware-efficient and information-maximizing path toward characterizing complex quantum networks with limited resources."},{"descriptionType":"Other","description":"11 pages, 7 figures"}],"geoLocations":[],"fundingReferences":[],"url":"https://arxiv.org/abs/2608.03963","contentUrl":null,"metadataVersion":0,"schemaVersion":"http://datacite.org/schema/kernel-4","source":"mds","isActive":true,"state":"findable","reason":null,"viewCount":0,"downloadCount":0,"referenceCount":0,"citationCount":0,"partCount":0,"partOfCount":0,"versionCount":0,"versionOfCount":0,"created":"2026-08-05T02:25:00Z","registered":"2026-08-05T02:25:01Z","published":null,"updated":"2026-08-05T02:25:01Z"},"relationships":{"client":{"data":{"id":"arxiv.content","type":"clients"}}}},{"id":"10.48550/arxiv.2608.03962","type":"dois","attributes":{"doi":"10.48550/arxiv.2608.03962","identifiers":[{"identifier":"2608.03962","identifierType":"arXiv"}],"creators":[{"nameType":"Personal","givenName":"Srinivasan","familyName":"Arunachalam","name":"Arunachalam, Srinivasan","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Arkopal","familyName":"Dutt","name":"Dutt, Arkopal","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Hari","familyName":"Krovi","name":"Krovi, Hari","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Rik","familyName":"Sengupta","name":"Sengupta, Rik","affiliation":[],"nameIdentifiers":[]}],"titles":[{"title":"Separating quantum circuits from classical LLMs"}],"publisher":"arXiv","container":{},"publicationYear":2026,"subjects":[{"subject":"Quantum Physics (quant-ph)","lang":"en","subjectScheme":"arXiv"},{"subject":"Artificial Intelligence (cs.AI)","lang":"en","subjectScheme":"arXiv"},{"subject":"Computational Complexity (cs.CC)","lang":"en","subjectScheme":"arXiv"},{"subject":"FOS: Physical sciences","subjectScheme":"Fields of Science and Technology (FOS)"},{"subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"}],"contributors":[],"dates":[{"date":"2026-08-04T17:28:24Z","dateType":"Submitted","dateInformation":"v1"},{"date":"2026-08-05T01:08:17Z","dateType":"Updated","dateInformation":"v1"},{"date":"2026-08","dateType":"Available","dateInformation":"v1"}],"language":null,"types":{"schemaOrg":"CreativeWork","resourceTypeGeneral":"Preprint","citeproc":"article","bibtex":"misc","ris":"GEN","resourceType":"Article"},"relatedIdentifiers":[],"relatedItems":[],"sizes":[],"formats":[],"version":"1","rightsList":[{"rightsUri":"http://arxiv.org/licenses/nonexclusive-distrib/1.0/","rights":"arXiv.org perpetual, non-exclusive license"}],"descriptions":[{"descriptionType":"Abstract","description":"Modern large language models - transformers and diffusion language models - are built around two canonical algorithmic tasks: prediction and generation. We prove unconditional separations between low-depth quantum computation and the corresponding bounded-resource classical language-model architectures in both regimes. Concretely, we exhibit the following:\n 1. Distributional separation. We give a distribution that is sampleable by $\\textsf{QNC}^0$ circuits (i.e., a family of constant-depth quantum circuits consisting of bounded fan-in gates) that no constant-round diffusion language model ($\\textsf{DLM}$) with shallow scheduling and denoising can sample within constant distance, even when allowed sublinear chain-of-thought and output-token revision/remasking events, the very features modern $\\textsf{DLM}$s rely on.\n 2. Functional separation. We exhibit a function computable in $\\land \\circ \\textsf{QNC}^0[\\log\\log n]$ (i.e., a family of O$(\\log\\log n)$-depth $\\textsf{QNC}^0$ circuits, where $n$ is the input length, followed by a single classical $\\mathsf{AND}$ gate) such that any constant-depth decoder-only transformer computing the function must be large: it would have to have width $n^{Ω(1)}$.\n Together, our work initiates the study of quantum advantage in the era of large language models."},{"descriptionType":"Other","description":"60 pages, 6 figures"}],"geoLocations":[],"fundingReferences":[],"url":"https://arxiv.org/abs/2608.03962","contentUrl":null,"metadataVersion":0,"schemaVersion":"http://datacite.org/schema/kernel-4","source":"mds","isActive":true,"state":"findable","reason":null,"viewCount":0,"downloadCount":0,"referenceCount":0,"citationCount":0,"partCount":0,"partOfCount":0,"versionCount":0,"versionOfCount":0,"created":"2026-08-05T02:24:59Z","registered":"2026-08-05T02:25:00Z","published":null,"updated":"2026-08-05T02:25:00Z"},"relationships":{"client":{"data":{"id":"arxiv.content","type":"clients"}}}},{"id":"10.48550/arxiv.2608.03961","type":"dois","attributes":{"doi":"10.48550/arxiv.2608.03961","identifiers":[{"identifier":"2608.03961","identifierType":"arXiv"}],"creators":[{"nameType":"Personal","givenName":"Mobina","familyName":"Kashaniyan","name":"Kashaniyan, Mobina","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Ali","familyName":"Jannesari","name":"Jannesari, Ali","affiliation":[],"nameIdentifiers":[]}],"titles":[{"title":"Interpretable Adaptive Sampling for LLM Test-Time Scaling"}],"publisher":"arXiv","container":{},"publicationYear":2026,"subjects":[{"subject":"Artificial Intelligence (cs.AI)","lang":"en","subjectScheme":"arXiv"},{"subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"}],"contributors":[],"dates":[{"date":"2026-08-04T17:27:21Z","dateType":"Submitted","dateInformation":"v1"},{"date":"2026-08-05T01:08:16Z","dateType":"Updated","dateInformation":"v1"},{"date":"2026-08","dateType":"Available","dateInformation":"v1"}],"language":null,"types":{"schemaOrg":"CreativeWork","resourceTypeGeneral":"Preprint","citeproc":"article","bibtex":"misc","ris":"GEN","resourceType":"Article"},"relatedIdentifiers":[],"relatedItems":[],"sizes":[],"formats":[],"version":"1","rightsList":[{"rightsIdentifierScheme":"SPDX","rightsUri":"https://creativecommons.org/licenses/by/4.0/legalcode","schemeUri":"https://spdx.org/licenses/","rights":"Creative Commons Attribution 4.0 International","rightsIdentifier":"cc-by-4.0"}],"descriptions":[{"descriptionType":"Abstract","description":"Test-time scaling improves LLM reasoning by generating and aggregating multiple candidate answers, yet many pipelines use fixed per-query budgets that spend the same compute on easy and difficult prompts. These fixed budgets are also difficult to inspect because they do not explain why a given prompt receives a particular number of samples. We propose adaptive} test-time scaling with a lightweight fuzzy controller that maps interpretable signals, including estimated prompt complexity and model confidence, to a per-query sampling budget. The controller assigns fewer samples to easier or more confident prompts and more samples to harder or less certain prompts, making inference-time compute inspectable rather than fixed or opaque. We evaluate under a fair-alignment protocol with matched decoding settings and controlled answer selection, and compare against best-of-$N$, compute-aware scaling, and self-certainty-based baselines on question-answering and mathematical reasoning tasks. Across models and datasets, adaptive fuzzy control improves over several standard baselines and remains close to a selector-matched full-budget control while reducing the average number of samples. These findings suggest that interpretable adaptive sampling is a practical direction for more efficient test-time reasoning in large language models."}],"geoLocations":[],"fundingReferences":[],"url":"https://arxiv.org/abs/2608.03961","contentUrl":null,"metadataVersion":0,"schemaVersion":"http://datacite.org/schema/kernel-4","source":"mds","isActive":true,"state":"findable","reason":null,"viewCount":0,"downloadCount":0,"referenceCount":0,"citationCount":0,"partCount":0,"partOfCount":0,"versionCount":0,"versionOfCount":0,"created":"2026-08-05T02:24:58Z","registered":"2026-08-05T02:24:59Z","published":null,"updated":"2026-08-05T02:24:59Z"},"relationships":{"client":{"data":{"id":"arxiv.content","type":"clients"}}}},{"id":"10.48550/arxiv.2608.03960","type":"dois","attributes":{"doi":"10.48550/arxiv.2608.03960","identifiers":[{"identifier":"2608.03960","identifierType":"arXiv"}],"creators":[{"nameType":"Personal","givenName":"Sergio","familyName":"Davis","name":"Davis, Sergio","affiliation":[],"nameIdentifiers":[]}],"titles":[{"title":"Kappa distributions as asymptotic marginals of exponential family ensembles"}],"publisher":"arXiv","container":{},"publicationYear":2026,"subjects":[{"subject":"Statistical Mechanics (cond-mat.stat-mech)","lang":"en","subjectScheme":"arXiv"},{"subject":"FOS: Physical sciences","subjectScheme":"Fields of Science and Technology (FOS)"}],"contributors":[],"dates":[{"date":"2026-08-04T17:27:10Z","dateType":"Submitted","dateInformation":"v1"},{"date":"2026-08-05T01:08:15Z","dateType":"Updated","dateInformation":"v1"},{"date":"2026-08","dateType":"Available","dateInformation":"v1"}],"language":null,"types":{"schemaOrg":"CreativeWork","resourceTypeGeneral":"Preprint","citeproc":"article","bibtex":"misc","ris":"GEN","resourceType":"Article"},"relatedIdentifiers":[],"relatedItems":[],"sizes":[],"formats":[],"version":"1","rightsList":[{"rightsIdentifierScheme":"SPDX","rightsUri":"https://creativecommons.org/licenses/by-sa/4.0/legalcode","schemeUri":"https://spdx.org/licenses/","rights":"Creative Commons Attribution Share Alike 4.0 International","rightsIdentifier":"cc-by-sa-4.0"}],"descriptions":[{"descriptionType":"Abstract","description":"Recently (Physica A 660 130370, 2025), emergence of superstatistical behavior in driven classical systems has been shown for systems with constant microcanonical heat capacity. As an application of this result, in this work we show that a system of $N$ particles with inverse gamma distribution of total kinetic energies must have kappa-distributed single-particle velocities in the limit $N \\rightarrow \\infty$. Our results provide insight into the nature of kappa distributions outside the theory of nonextensive statistical mechanics, while also bringing forward a practical method for the generation of kappa velocities via Monte Carlo Metropolis simulation in the inverse gamma ensemble."}],"geoLocations":[],"fundingReferences":[],"url":"https://arxiv.org/abs/2608.03960","contentUrl":null,"metadataVersion":0,"schemaVersion":"http://datacite.org/schema/kernel-4","source":"mds","isActive":true,"state":"findable","reason":null,"viewCount":0,"downloadCount":0,"referenceCount":0,"citationCount":0,"partCount":0,"partOfCount":0,"versionCount":0,"versionOfCount":0,"created":"2026-08-05T02:24:57Z","registered":"2026-08-05T02:24:57Z","published":null,"updated":"2026-08-05T02:24:57Z"},"relationships":{"client":{"data":{"id":"arxiv.content","type":"clients"}}}},{"id":"10.48550/arxiv.2608.03959","type":"dois","attributes":{"doi":"10.48550/arxiv.2608.03959","identifiers":[{"identifier":"2608.03959","identifierType":"arXiv"}],"creators":[{"nameType":"Personal","givenName":"Simon","familyName":"Pfreundschuh","name":"Pfreundschuh, Simon","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Christian D.","familyName":"Kummerow","name":"Kummerow, Christian D.","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Johannes","familyName":"Schmude","name":"Schmude, Johannes","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Sujit","familyName":"Roy","name":"Roy, Sujit","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Rahul","familyName":"Ramachandran","name":"Ramachandran, Rahul","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Tsengdar","familyName":"Lee","name":"Lee, Tsengdar","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Valentine","familyName":"Anantharaj","name":"Anantharaj, Valentine","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Katherine H.","familyName":"Breen","name":"Breen, Katherine H.","affiliation":[],"nameIdentifiers":[]}],"titles":[{"title":"Prithvi-Precip: Integrating Satellite Observations into an Atmospheric AI Foundation Model for Precipitation Forecasting"}],"publisher":"arXiv","container":{},"publicationYear":2026,"subjects":[{"subject":"Atmospheric and Oceanic Physics (physics.ao-ph)","lang":"en","subjectScheme":"arXiv"},{"subject":"FOS: Physical sciences","subjectScheme":"Fields of Science and Technology (FOS)"}],"contributors":[],"dates":[{"date":"2026-08-04T17:25:22Z","dateType":"Submitted","dateInformation":"v1"},{"date":"2026-08-05T01:08:03Z","dateType":"Updated","dateInformation":"v1"},{"date":"2026-08","dateType":"Available","dateInformation":"v1"}],"language":null,"types":{"schemaOrg":"CreativeWork","resourceTypeGeneral":"Preprint","citeproc":"article","bibtex":"misc","ris":"GEN","resourceType":"Article"},"relatedIdentifiers":[],"relatedItems":[],"sizes":[],"formats":[],"version":"1","rightsList":[{"rightsIdentifierScheme":"SPDX","rightsUri":"https://creativecommons.org/licenses/by/4.0/legalcode","schemeUri":"https://spdx.org/licenses/","rights":"Creative Commons Attribution 4.0 International","rightsIdentifier":"cc-by-4.0"}],"descriptions":[{"descriptionType":"Abstract","description":"Accurate precipitation forecasting remains one of the most challenging problems in weather prediction. While recent AI weather prediction (AIWP) systems have achieved substantial improvements in medium-range forecasting skill, precipitation often remains a secondary target and is commonly learned from reanalysis datasets that contain considerable uncertainty. In this work, we investigate two complementary strategies for improving AI-based precipitation forecasts. Building on the Prithvi-WxC foundation model, we develop Prithvi-Precip, a global precipitation forecasting system, and examine (1) the impact of training targets derived from satellite-based precipitation estimates rather than reanalysis fields and (2) the direct assimilation of satellite observations into the forecasting model.\n We systematically evaluate key design choices for finetuning the Prithvi-WxC AI foundation model for precipitation forecasting. We find that autoregressive rollout training produces substantially more accurate forecasts than direct conditioning on forecast lead time. Using independent radar-based precipitation estimates for evaluation, we show that training on satellite-derived precipitation targets yields improved forecast accuracy relative to training on MERRA-2 precipitation fields. Furthermore, direct ingestion of satellite observations provides additional improvements at short lead times, with the largest gains occurring in tropical and subtropical regions.\n Together, these advances enable Prithvi-Precip to substantially improve upon directly comparable precipitation forecasts from the Goddard Earth Observing System. Our results highlight the potential of improved precipitation targets and the direct integration of satellite observations as promising pathways for advancing medium-range AI precipitation forecasting."}],"geoLocations":[],"fundingReferences":[],"url":"https://arxiv.org/abs/2608.03959","contentUrl":null,"metadataVersion":0,"schemaVersion":"http://datacite.org/schema/kernel-4","source":"mds","isActive":true,"state":"findable","reason":null,"viewCount":0,"downloadCount":0,"referenceCount":0,"citationCount":0,"partCount":0,"partOfCount":0,"versionCount":0,"versionOfCount":0,"created":"2026-08-05T02:24:55Z","registered":"2026-08-05T02:24:56Z","published":null,"updated":"2026-08-05T02:24:56Z"},"relationships":{"client":{"data":{"id":"arxiv.content","type":"clients"}}}},{"id":"10.48550/arxiv.2608.03958","type":"dois","attributes":{"doi":"10.48550/arxiv.2608.03958","identifiers":[{"identifier":"2608.03958","identifierType":"arXiv"}],"creators":[{"nameType":"Personal","givenName":"Alexander","familyName":"Meulemans","name":"Meulemans, Alexander","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Maciej","familyName":"Wołczyk","name":"Wołczyk, Maciej","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Marissa A.","familyName":"Weis","name":"Weis, Marissa A.","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Rajai","familyName":"Nasser","name":"Nasser, Rajai","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Roberta","familyName":"Rocca","name":"Rocca, Roberta","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Seijin","familyName":"Kobayashi","name":"Kobayashi, Seijin","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Guillaume","familyName":"Lajoie","name":"Lajoie, Guillaume","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Angelika","familyName":"Steger","name":"Steger, Angelika","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Blake","familyName":"Richards","name":"Richards, Blake","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Marcus","familyName":"Hutter","name":"Hutter, Marcus","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"James","familyName":"Manyika","name":"Manyika, James","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Rif A.","familyName":"Saurous","name":"Saurous, Rif A.","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"João","familyName":"Sacramento","name":"Sacramento, João","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Blaise Agüera y","familyName":"Arcas","name":"Arcas, Blaise Agüera y","affiliation":[],"nameIdentifiers":[]}],"titles":[{"title":"A game theory for foundation models shows new paths to rational cooperation through similarity inference"}],"publisher":"arXiv","container":{},"publicationYear":2026,"subjects":[{"subject":"Artificial Intelligence (cs.AI)","lang":"en","subjectScheme":"arXiv"},{"subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"},{"subject":"I.2.6","lang":"en","subjectScheme":"ACM"},{"subject":"68","lang":"en","subjectScheme":"MSC"}],"contributors":[],"dates":[{"date":"2026-08-04T17:24:33Z","dateType":"Submitted","dateInformation":"v1"},{"date":"2026-08-05T01:07:52Z","dateType":"Updated","dateInformation":"v1"},{"date":"2026-08","dateType":"Available","dateInformation":"v1"}],"language":null,"types":{"schemaOrg":"CreativeWork","resourceTypeGeneral":"Preprint","citeproc":"article","bibtex":"misc","ris":"GEN","resourceType":"Article"},"relatedIdentifiers":[],"relatedItems":[],"sizes":[],"formats":[],"version":"1","rightsList":[{"rightsIdentifierScheme":"SPDX","rightsUri":"https://creativecommons.org/licenses/by/4.0/legalcode","schemeUri":"https://spdx.org/licenses/","rights":"Creative Commons Attribution 4.0 International","rightsIdentifier":"cc-by-4.0"}],"descriptions":[{"descriptionType":"Abstract","description":"As autonomous agents powered by foundation models are increasingly integrated into social and economic systems, understanding the principles governing their collective behavior is essential for ensuring safety and cooperation. Classical game theory, the dominant framework for modeling rational interaction, is built upon the assumption of `decoupled agency,' where agents treat their own decision-making as independent of the environment and other actors. Modern AI agents, however, jointly predict their own future actions alongside external observations. Here, we report a striking finding: when interacting in stylized social dilemmas, foundation model agents engaging in optimal planning consistently converge to stable cooperation, directly contradicting classical game-theoretic predictions of mutual defection. To understand this phenomenon, we introduce the `embedded Bayesian agent,' a theoretical model for foundation model agents. By shifting from decoupled to embedded agency, these agents model themselves as part of the universe they inhabit, maintaining epistemic uncertainty about their own decision-making algorithms. We show that by inferring whether others are behaviorally similar, an embedded agent treats its own deliberation during planning as evidence: a decision to cooperate predicts a similar decision by a similar partner. We formalize this mechanism of similarity inference through the `embedded equilibrium,' a novel solution concept replacing the Nash equilibrium to provide a foundational game theory for the social behavior of modern AI agents."},{"descriptionType":"Other","description":"75 pages, 11 figures"}],"geoLocations":[],"fundingReferences":[],"url":"https://arxiv.org/abs/2608.03958","contentUrl":null,"metadataVersion":0,"schemaVersion":"http://datacite.org/schema/kernel-4","source":"mds","isActive":true,"state":"findable","reason":null,"viewCount":0,"downloadCount":0,"referenceCount":0,"citationCount":0,"partCount":0,"partOfCount":0,"versionCount":0,"versionOfCount":0,"created":"2026-08-05T02:24:54Z","registered":"2026-08-05T02:24:55Z","published":null,"updated":"2026-08-05T02:24:55Z"},"relationships":{"client":{"data":{"id":"arxiv.content","type":"clients"}}}},{"id":"10.48550/arxiv.2608.03957","type":"dois","attributes":{"doi":"10.48550/arxiv.2608.03957","identifiers":[{"identifier":"2608.03957","identifierType":"arXiv"}],"creators":[{"nameType":"Personal","givenName":"Rajneesh","familyName":"Joshi","name":"Joshi, Rajneesh","affiliation":[],"nameIdentifiers":[]},{"nameType":"Organizational","name":"Gyaprasad","affiliation":[],"nameIdentifiers":[]}],"titles":[{"title":"Modulation in degree of cross-polarization at Young's interferometer illuminated by non-uniformly polarized electromagnetic fields"}],"publisher":"arXiv","container":{},"publicationYear":2026,"subjects":[{"subject":"Optics (physics.optics)","lang":"en","subjectScheme":"arXiv"},{"subject":"FOS: Physical sciences","subjectScheme":"Fields of Science and Technology (FOS)"}],"contributors":[],"dates":[{"date":"2026-08-04T17:22:49Z","dateType":"Submitted","dateInformation":"v1"},{"date":"2026-08-05T01:07:44Z","dateType":"Updated","dateInformation":"v1"},{"date":"2026-08","dateType":"Available","dateInformation":"v1"}],"language":null,"types":{"schemaOrg":"CreativeWork","resourceTypeGeneral":"Preprint","citeproc":"article","bibtex":"misc","ris":"GEN","resourceType":"Article"},"relatedIdentifiers":[],"relatedItems":[],"sizes":[],"formats":[],"version":"1","rightsList":[{"rightsIdentifierScheme":"SPDX","rightsUri":"https://creativecommons.org/licenses/by/4.0/legalcode","schemeUri":"https://spdx.org/licenses/","rights":"Creative Commons Attribution 4.0 International","rightsIdentifier":"cc-by-4.0"}],"descriptions":[{"descriptionType":"Abstract","description":"The degree of cross-polarization (DoCP) and the electromagnetic degree of coherence (EM DoC) of an electromagnetic beam are investigated at the observation points for incoherent and non-uniformly polarized, i.e., different degree of polarization with respect to space at the two pinholes in Young's interference experiment. We note that DoCP at the observation plane can be expressed as the average value of the degree of polarization at the pinholes of Young's interference experiment. The present study also verifies that the DoCP is a two-point generalization of the DoP. Additionally, EM DoC at observation points can be controlled by DoP at pinholes. The findings may be useful for classical ghost imaging, lensless imaging, and the study of Stokes correlations."}],"geoLocations":[],"fundingReferences":[],"url":"https://arxiv.org/abs/2608.03957","contentUrl":null,"metadataVersion":0,"schemaVersion":"http://datacite.org/schema/kernel-4","source":"mds","isActive":true,"state":"findable","reason":null,"viewCount":0,"downloadCount":0,"referenceCount":0,"citationCount":0,"partCount":0,"partOfCount":0,"versionCount":0,"versionOfCount":0,"created":"2026-08-05T02:24:53Z","registered":"2026-08-05T02:24:53Z","published":null,"updated":"2026-08-05T02:24:53Z"},"relationships":{"client":{"data":{"id":"arxiv.content","type":"clients"}}}},{"id":"10.48550/arxiv.2608.03955","type":"dois","attributes":{"doi":"10.48550/arxiv.2608.03955","identifiers":[{"identifier":"2608.03955","identifierType":"arXiv"}],"creators":[{"nameType":"Personal","givenName":"Sheng-Chih","familyName":"Lin","name":"Lin, Sheng-Chih","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Alfred","familyName":"Zong","name":"Zong, Alfred","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Emma","familyName":"Berger","name":"Berger, Emma","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Bailey R.","familyName":"Nebgen","name":"Nebgen, Bailey R.","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Marcus","familyName":"Hui","name":"Hui, Marcus","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Shuaiwei","familyName":"Pan","name":"Pan, Shuaiwei","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Jackson","familyName":"McClellan","name":"McClellan, Jackson","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Michael W.","familyName":"Zuerch","name":"Zuerch, Michael W.","affiliation":[],"nameIdentifiers":[]}],"titles":[{"title":"A table-top few-femtosecond broadband extreme-ultraviolet absorption spectrometer with cryogenic cooling"}],"publisher":"arXiv","container":{},"publicationYear":2026,"subjects":[{"subject":"Instrumentation and Detectors (physics.ins-det)","lang":"en","subjectScheme":"arXiv"},{"subject":"Materials Science (cond-mat.mtrl-sci)","lang":"en","subjectScheme":"arXiv"},{"subject":"FOS: Physical sciences","subjectScheme":"Fields of Science and Technology (FOS)"}],"contributors":[],"dates":[{"date":"2026-08-04T17:20:42Z","dateType":"Submitted","dateInformation":"v1"},{"date":"2026-08-05T01:07:35Z","dateType":"Updated","dateInformation":"v1"},{"date":"2026-08","dateType":"Available","dateInformation":"v1"}],"language":null,"types":{"schemaOrg":"CreativeWork","resourceTypeGeneral":"Preprint","citeproc":"article","bibtex":"misc","ris":"GEN","resourceType":"Article"},"relatedIdentifiers":[],"relatedItems":[],"sizes":[],"formats":[],"version":"1","rightsList":[{"rightsUri":"http://arxiv.org/licenses/nonexclusive-distrib/1.0/","rights":"arXiv.org perpetual, non-exclusive license"}],"descriptions":[{"descriptionType":"Abstract","description":"We present a table-top cryogenic ultrafast broadband XUV absorption spectroscopy (c-UBXAS) beamline designed for temperature-dependent and time-resolved investigations of quantum materials. The instrument combines a broadband high-harmonic generation source spanning 22-73 eV with automated image registration and cryogenic sample control down to 20 K, enabling element-specific measurements under both equilibrium and nonequilibrium conditions. The beamline provides sub-50-meV energy resolution and a sub-10-fs instrument response function, while maintaining long-term stability suitable for extended, ultrasensitive measurements. Benchmark experiments on NiI$_2$, a van der Waals multiferroic, reveal temperature-dependent spectral evolution across its magnetic phase transitions, demonstrating the ability to identify element-specific contributions to the ground state and its transient response in the femtosecond regime. This instrument introduces the opportunity to unravel the very first response of a solid-state material during light-matter interaction, paving the way for understanding the complex phase space of nonequilibrium dynamics and emergent states in strongly correlated systems where the few-femtosecond electronic response has eluded most other types of time-resolved techniques."},{"descriptionType":"Other","description":"16 pages, 14 figures, 2 tables"}],"geoLocations":[],"fundingReferences":[],"url":"https://arxiv.org/abs/2608.03955","contentUrl":null,"metadataVersion":0,"schemaVersion":"http://datacite.org/schema/kernel-4","source":"mds","isActive":true,"state":"findable","reason":null,"viewCount":0,"downloadCount":0,"referenceCount":0,"citationCount":0,"partCount":0,"partOfCount":0,"versionCount":0,"versionOfCount":0,"created":"2026-08-05T02:24:50Z","registered":"2026-08-05T02:24:51Z","published":null,"updated":"2026-08-05T02:24:51Z"},"relationships":{"client":{"data":{"id":"arxiv.content","type":"clients"}}}},{"id":"10.48550/arxiv.2608.03954","type":"dois","attributes":{"doi":"10.48550/arxiv.2608.03954","identifiers":[{"identifier":"2608.03954","identifierType":"arXiv"}],"creators":[{"nameType":"Personal","givenName":"Muhammad","familyName":"Sulaiman","name":"Sulaiman, Muhammad","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Bo","familyName":"Sun","name":"Sun, Bo","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Mohammad Ali","familyName":"Salahuddin","name":"Salahuddin, Mohammad Ali","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Xiaoqi","familyName":"Tan","name":"Tan, Xiaoqi","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Raouf","familyName":"Boutaba","name":"Boutaba, Raouf","affiliation":[],"nameIdentifiers":[]}],"titles":[{"title":"Data-Driven Online Slice Admission Control and Resource Allocation in NextG Mobile Networks"}],"publisher":"arXiv","container":{},"publicationYear":2026,"subjects":[{"subject":"Networking and Internet Architecture (cs.NI)","lang":"en","subjectScheme":"arXiv"},{"subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"}],"contributors":[],"dates":[{"date":"2026-08-04T17:20:29Z","dateType":"Submitted","dateInformation":"v1"},{"date":"2026-08-05T01:07:34Z","dateType":"Updated","dateInformation":"v1"},{"date":"2026-08","dateType":"Available","dateInformation":"v1"}],"language":null,"types":{"schemaOrg":"CreativeWork","resourceTypeGeneral":"Preprint","citeproc":"article","bibtex":"misc","ris":"GEN","resourceType":"Article"},"relatedIdentifiers":[],"relatedItems":[],"sizes":[],"formats":[],"version":"1","rightsList":[{"rightsUri":"http://arxiv.org/licenses/nonexclusive-distrib/1.0/","rights":"arXiv.org perpetual, non-exclusive license"}],"descriptions":[{"descriptionType":"Abstract","description":"Virtualization in 5G and beyond networks enables the creation of virtual networks (i.e., network slices) tailored to the needs of different applications. To maximize revenue under limited infrastructure resources, InPs must decide in real time whether to admit incoming slice requests (SRs) based on their resource demands and offered values, while accounting for the opportunity cost of consuming scarce resources. To address this challenge, we introduce Online Pricing-based Slice Admission Control and Resource Allocation (OPA) framework. This framework dynamically assigns pseudo-prices to resources that capture long-term scarcity and anticipated inter-temporal opportunity costs. The short-term admission and resource allocation decisions for each SR are then guided by these prices. Additionally, we design an exponential pricing strategy that guarantees bounded worst-case performance. To improve practical performance, we further develop a data-driven exponential pricing approach that learns from historical data. Evaluations on a real-world network topology show that it improves mean revenue by 32.2% and 26.7% over state-of-the-art DRL and optimization-based approaches, respectively, while reducing computational cost by an order of magnitude relative to the latter."},{"descriptionType":"Other","description":"11 pages, 7 figures"}],"geoLocations":[],"fundingReferences":[],"url":"https://arxiv.org/abs/2608.03954","contentUrl":null,"metadataVersion":0,"schemaVersion":"http://datacite.org/schema/kernel-4","source":"mds","isActive":true,"state":"findable","reason":null,"viewCount":0,"downloadCount":0,"referenceCount":0,"citationCount":0,"partCount":0,"partOfCount":0,"versionCount":0,"versionOfCount":0,"created":"2026-08-05T02:24:48Z","registered":"2026-08-05T02:24:49Z","published":null,"updated":"2026-08-05T02:24:49Z"},"relationships":{"client":{"data":{"id":"arxiv.content","type":"clients"}}}},{"id":"10.48550/arxiv.2608.03953","type":"dois","attributes":{"doi":"10.48550/arxiv.2608.03953","identifiers":[{"identifier":"2608.03953","identifierType":"arXiv"}],"creators":[{"nameType":"Personal","givenName":"Ayaka","familyName":"Toshima","name":"Toshima, Ayaka","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Keigo","familyName":"Mizutani","name":"Mizutani, Keigo","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Yusuke","familyName":"Kousaka","name":"Kousaka, Yusuke","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Kazuki","familyName":"Ohishi","name":"Ohishi, Kazuki","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Hiroaki","familyName":"Shishido","name":"Shishido, Hiroaki","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Yoshihiko","familyName":"Togawa","name":"Togawa, Yoshihiko","affiliation":[],"nameIdentifiers":[]}],"titles":[{"title":"Emergence of Chiral Helimagnetic Order in Chromium-intercalated Tantalum Disulfide CrTa$_3$S$_6$ Powders with Controlled Intercalation"}],"publisher":"arXiv","container":{},"publicationYear":2026,"subjects":[{"subject":"Materials Science (cond-mat.mtrl-sci)","lang":"en","subjectScheme":"arXiv"},{"subject":"FOS: Physical sciences","subjectScheme":"Fields of Science and Technology (FOS)"}],"contributors":[],"dates":[{"date":"2026-08-04T17:19:37Z","dateType":"Submitted","dateInformation":"v1"},{"date":"2026-08-05T01:07:33Z","dateType":"Updated","dateInformation":"v1"},{"date":"2026-08","dateType":"Available","dateInformation":"v1"}],"language":null,"types":{"schemaOrg":"CreativeWork","resourceTypeGeneral":"Preprint","citeproc":"article","bibtex":"misc","ris":"GEN","resourceType":"Article"},"relatedIdentifiers":[{"relationType":"IsVersionOf","relatedIdentifier":"10.7566/jpsj.95.085003","relatedIdentifierType":"DOI"}],"relatedItems":[],"sizes":[],"formats":[],"version":"1","rightsList":[{"rightsUri":"http://arxiv.org/licenses/nonexclusive-distrib/1.0/","rights":"arXiv.org perpetual, non-exclusive license"}],"descriptions":[{"descriptionType":"Abstract","description":"We report a highly sensitive change in magnetic properties of a chiral Cr-intercalated transition-metal dichalcogenide Cr$_{x}$Ta$_{3}$S$_{6}$. Magnetization curves and small-angle neutron scattering data revealed that the powder samples exhibit chiral helimagnetism with a Cr intercalation quantity $x$ below 0.996, while they show ferromagnetism above 1.000. The emergence and temperature-dependent evolution of the helimagnetic period are argued in terms of sample dimensions of powders and microfabricated crystals."},{"descriptionType":"Other","description":"2 pages, 2 figures, JPSJ Short Note"}],"geoLocations":[],"fundingReferences":[],"url":"https://arxiv.org/abs/2608.03953","contentUrl":null,"metadataVersion":0,"schemaVersion":"http://datacite.org/schema/kernel-4","source":"mds","isActive":true,"state":"findable","reason":null,"viewCount":0,"downloadCount":0,"referenceCount":0,"citationCount":0,"partCount":0,"partOfCount":0,"versionCount":0,"versionOfCount":1,"created":"2026-08-05T02:24:47Z","registered":"2026-08-05T02:24:48Z","published":null,"updated":"2026-08-05T02:24:48Z"},"relationships":{"client":{"data":{"id":"arxiv.content","type":"clients"}}}},{"id":"10.48550/arxiv.2608.03952","type":"dois","attributes":{"doi":"10.48550/arxiv.2608.03952","identifiers":[{"identifier":"2608.03952","identifierType":"arXiv"}],"creators":[{"nameType":"Personal","givenName":"Dongjie","familyName":"Yang","name":"Yang, Dongjie","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Siyan","familyName":"Lin","name":"Lin, Siyan","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Leixian","familyName":"Shen","name":"Shen, Leixian","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Rui","familyName":"Sheng","name":"Sheng, Rui","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Huamin","familyName":"Qu","name":"Qu, Huamin","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Zixin","familyName":"Chen","name":"Chen, Zixin","affiliation":[],"nameIdentifiers":[]}],"titles":[{"title":"TACT: Taxonomy-Aligned Post-Training for Pedagogically Adaptive English Tutoring"}],"publisher":"arXiv","container":{},"publicationYear":2026,"subjects":[{"subject":"Artificial Intelligence (cs.AI)","lang":"en","subjectScheme":"arXiv"},{"subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"}],"contributors":[],"dates":[{"date":"2026-08-04T17:16:14Z","dateType":"Submitted","dateInformation":"v1"},{"date":"2026-08-05T01:07:22Z","dateType":"Updated","dateInformation":"v1"},{"date":"2026-08","dateType":"Available","dateInformation":"v1"}],"language":null,"types":{"schemaOrg":"CreativeWork","resourceTypeGeneral":"Preprint","citeproc":"article","bibtex":"misc","ris":"GEN","resourceType":"Article"},"relatedIdentifiers":[],"relatedItems":[],"sizes":[],"formats":[],"version":"1","rightsList":[{"rightsIdentifierScheme":"SPDX","rightsUri":"https://creativecommons.org/licenses/by/4.0/legalcode","schemeUri":"https://spdx.org/licenses/","rights":"Creative Commons Attribution 4.0 International","rightsIdentifier":"cc-by-4.0"}],"descriptions":[{"descriptionType":"Abstract","description":"Large language models (LLMs) are increasingly used to provide conversational practice for English-as-a-second-language (ESL) learners. Effective ESL tutoring, however, requires more than fluent response generation: a tutor must select an appropriate pedagogical action based on learner behavior and dialogue context. Human-tutoring research offers principles for adaptive support, but they are often task-specific and remain insufficiently integrated into LLM-based ESL tutor training and evaluation. We present TACT (Taxonomy-Aligned Conversational Tutor), a human-grounded framework for post-training and evaluating pedagogically adaptive ESL tutors. Drawing on established literature, we develop two complementary taxonomies: the Tutor-Strategy Taxonomy with 13 tutor response strategies and the Student-Move Taxonomy characterizing learner behavior by move type and status. Using these taxonomies, we construct TACTCorpus, which enriches 260 authentic teacher-student conversations with 32,379 annotations and quality-controlled augmented training data. We then post-train Qwen3.5-4B through supervised fine-tuning followed by taxonomy-aligned Group Relative Policy Optimization, producing TACTutor and optimizing it for scaffolding quality rather than reference imitation alone. On TACTBench, a strategy-balanced diagnostic benchmark comprising 78 authentic tutoring contexts, TACTutor improves over its backbone by 20.30% and outperforms all evaluated proprietary baselines under the same protocol, while maintaining backbone performance on established external educational benchmarks; in a blinded study with 50 learners, it also receives the highest overall mean rating among the evaluated tutors. We release the data, benchmark, and model weights, providing an open foundation for developing pedagogically adaptive ESL tutors."}],"geoLocations":[],"fundingReferences":[],"url":"https://arxiv.org/abs/2608.03952","contentUrl":null,"metadataVersion":0,"schemaVersion":"http://datacite.org/schema/kernel-4","source":"mds","isActive":true,"state":"findable","reason":null,"viewCount":0,"downloadCount":0,"referenceCount":0,"citationCount":0,"partCount":0,"partOfCount":0,"versionCount":0,"versionOfCount":0,"created":"2026-08-05T02:24:46Z","registered":"2026-08-05T02:24:46Z","published":null,"updated":"2026-08-05T02:24:46Z"},"relationships":{"client":{"data":{"id":"arxiv.content","type":"clients"}}}},{"id":"10.48550/arxiv.2608.03951","type":"dois","attributes":{"doi":"10.48550/arxiv.2608.03951","identifiers":[{"identifier":"2608.03951","identifierType":"arXiv"}],"creators":[{"nameType":"Personal","givenName":"Hung","familyName":"Le","name":"Le, Hung","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Shay","familyName":"Solomon","name":"Solomon, Shay","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Cuong","familyName":"Than","name":"Than, Cuong","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Csaba D.","familyName":"Tóth","name":"Tóth, Csaba D.","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Tianyi","familyName":"Zhang","name":"Zhang, Tianyi","affiliation":[],"nameIdentifiers":[]}],"titles":[{"title":"Improved Euclidean Shallow Light Trees"}],"publisher":"arXiv","container":{},"publicationYear":2026,"subjects":[{"subject":"Computational Geometry (cs.CG)","lang":"en","subjectScheme":"arXiv"},{"subject":"Data Structures and Algorithms (cs.DS)","lang":"en","subjectScheme":"arXiv"},{"subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"},{"subject":"F.2.2","lang":"en","subjectScheme":"ACM"}],"contributors":[],"dates":[{"date":"2026-08-04T17:16:05Z","dateType":"Submitted","dateInformation":"v1"},{"date":"2026-08-05T01:07:21Z","dateType":"Updated","dateInformation":"v1"},{"date":"2026-08","dateType":"Available","dateInformation":"v1"}],"language":null,"types":{"schemaOrg":"CreativeWork","resourceTypeGeneral":"Preprint","citeproc":"article","bibtex":"misc","ris":"GEN","resourceType":"Article"},"relatedIdentifiers":[],"relatedItems":[],"sizes":[],"formats":[],"version":"1","rightsList":[{"rightsUri":"http://arxiv.org/licenses/nonexclusive-distrib/1.0/","rights":"arXiv.org perpetual, non-exclusive license"}],"descriptions":[{"descriptionType":"Abstract","description":"For parameters $α,β\\geq 1$, a spanning tree $T$ of a weighted graph $G$ rooted at a designated vertex $r$ is called an $(α,β)$-shallow-light tree (SLT) if (i) for every vertex $v$, $d_T(r,v) \\leq α\\cdot d_G(r,v)$ (root-stretch $α$), and (ii) $w(T) \\leq β\\cdot w(\\mathsf{MST})$ (lightness $β$). The pioneering work of Khuller, Raghavachari, and Young (SODA 1993) constructed $\\left(1+ε, \\tfrac{2}ε+1\\right)$-SLTs for general weighted graphs, and proved that this tradeoff between root-stretch and lightness is tight even for series-parallel graphs. They further asked whether even a slight improvement, namely reducing the lightness to $\\tfrac{2-c}ε$ for any constant $c\u0026gt;0$, is possible in the Euclidean plane.\n We resolve this longstanding question in the affirmative. Specifically, we show that every Euclidean instance admits an SLT with root-stretch $1+ε$ and lightness at most $\\left(\\frac{5}{3} + o_ε(1)\\right) \\cdot \\frac{1}ε$, thereby significantly improving upon the longstanding $2/ε$ barrier.\n As our second main result, we provide a construction of SLTs in the Euclidean plane, with root stretch $1+ε$ and lightness at most $\\left(\\frac{2π}{\\sqrt{4π^2+1}}+o_ε(1)\\right)\\frac{1}ε \\approx (0.987+o_ε(1))\\frac{1}ε$. Notably, this reduces the leading $2/ε$ term in the lightness bound by more than a factor of two, and comes quite close to the lower bound of $\\left(\\frac{2π}{2π+1} +o_ε(1))\\right) \\cdot \\frac{1}ε \\approx (0.862 +o_ε(1))\\frac{1}ε$ by Elkin and Solomon (FOCS 2011)."},{"descriptionType":"Other","description":"Abstract truncated to meet arxiv characters limit"}],"geoLocations":[],"fundingReferences":[],"url":"https://arxiv.org/abs/2608.03951","contentUrl":null,"metadataVersion":0,"schemaVersion":"http://datacite.org/schema/kernel-4","source":"mds","isActive":true,"state":"findable","reason":null,"viewCount":0,"downloadCount":0,"referenceCount":0,"citationCount":0,"partCount":0,"partOfCount":0,"versionCount":0,"versionOfCount":0,"created":"2026-08-05T02:24:44Z","registered":"2026-08-05T02:24:45Z","published":null,"updated":"2026-08-05T02:24:45Z"},"relationships":{"client":{"data":{"id":"arxiv.content","type":"clients"}}}},{"id":"10.48550/arxiv.2608.03950","type":"dois","attributes":{"doi":"10.48550/arxiv.2608.03950","identifiers":[{"identifier":"2608.03950","identifierType":"arXiv"}],"creators":[{"nameType":"Personal","givenName":"Alexandre Z.","familyName":"Leger","name":"Leger, Alexandre Z.","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Emil Z.","familyName":"Ulsig","name":"Ulsig, Emil Z.","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Samuel E.","familyName":"Fontaine","name":"Fontaine, Samuel E.","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Dileep V.","familyName":"Reddy","name":"Reddy, Dileep V.","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Eric J.","familyName":"Stanton","name":"Stanton, Eric J.","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Lynden K.","familyName":"Shalm","name":"Shalm, Lynden K.","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Richard P.","familyName":"Mirin","name":"Mirin, Richard P.","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Martin J.","familyName":"Stevens","name":"Stevens, Martin J.","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"J. E.","familyName":"Sipe","name":"Sipe, J. E.","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Nicolas","familyName":"Volet","name":"Volet, Nicolas","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Deny R.","familyName":"Hamel","name":"Hamel, Deny R.","affiliation":[],"nameIdentifiers":[]}],"titles":[{"title":"Joint spectral characterization of SPDC photon pairs near 2 $μ$m in (Al)GaAs-on-insulator waveguides"}],"publisher":"arXiv","container":{},"publicationYear":2026,"subjects":[{"subject":"Optics (physics.optics)","lang":"en","subjectScheme":"arXiv"},{"subject":"Quantum Physics (quant-ph)","lang":"en","subjectScheme":"arXiv"},{"subject":"FOS: Physical sciences","subjectScheme":"Fields of Science and Technology (FOS)"}],"contributors":[],"dates":[{"date":"2026-08-04T17:14:20Z","dateType":"Submitted","dateInformation":"v1"},{"date":"2026-08-05T01:07:20Z","dateType":"Updated","dateInformation":"v1"},{"date":"2026-08","dateType":"Available","dateInformation":"v1"}],"language":null,"types":{"schemaOrg":"CreativeWork","resourceTypeGeneral":"Preprint","citeproc":"article","bibtex":"misc","ris":"GEN","resourceType":"Article"},"relatedIdentifiers":[],"relatedItems":[],"sizes":[],"formats":[],"version":"1","rightsList":[{"rightsUri":"http://arxiv.org/licenses/nonexclusive-distrib/1.0/","rights":"arXiv.org perpetual, non-exclusive license"}],"descriptions":[{"descriptionType":"Abstract","description":"Integrated photon-pair sources are a core component of chip-based quantum computing, communication, and metrology. Although such sources have been demonstrated at conventional telecom wavelengths, the 2 $μ$m band remains comparatively less explored, despite offering advantages for free-space quantum communication, low-loss transmission in emerging fiber networks, and integration with silicon photonic platforms. In this paper, we demonstrate spontaneous parametric down-conversion (SPDC) in straight GaAs- and AlGaAs-on-insulator waveguides. This platform offers strong second-order nonlinearity and geometry-tunable dispersion, which are advantageous for efficient on-chip pair generation. Measurements of the joint spectral intensity and heralded second-order correlation function show broadband emission around 2 $μ$m with strong spectral anti-correlations. To our knowledge, this is the first direct joint-spectral characterization of an integrated SPDC source in this wavelength regime."},{"descriptionType":"Other","description":"14 pages, 8 figures, 2 tables"}],"geoLocations":[],"fundingReferences":[],"url":"https://arxiv.org/abs/2608.03950","contentUrl":null,"metadataVersion":0,"schemaVersion":"http://datacite.org/schema/kernel-4","source":"mds","isActive":true,"state":"findable","reason":null,"viewCount":0,"downloadCount":0,"referenceCount":0,"citationCount":0,"partCount":0,"partOfCount":0,"versionCount":0,"versionOfCount":0,"created":"2026-08-05T02:24:43Z","registered":"2026-08-05T02:24:44Z","published":null,"updated":"2026-08-05T02:24:44Z"},"relationships":{"client":{"data":{"id":"arxiv.content","type":"clients"}}}},{"id":"10.48550/arxiv.2608.03949","type":"dois","attributes":{"doi":"10.48550/arxiv.2608.03949","identifiers":[{"identifier":"2608.03949","identifierType":"arXiv"}],"creators":[{"nameType":"Personal","givenName":"Haizhong","familyName":"Li","name":"Li, Haizhong","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Yao","familyName":"Wan","name":"Wan, Yao","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Yijia","familyName":"Zhang","name":"Zhang, Yijia","affiliation":[],"nameIdentifiers":[]}],"titles":[{"title":"On the Brunn-Minkowski inequality for $q$-th dual quermassintegrals with $q\u0026gt;n$"}],"publisher":"arXiv","container":{},"publicationYear":2026,"subjects":[{"subject":"Differential Geometry (math.DG)","lang":"en","subjectScheme":"arXiv"},{"subject":"Analysis of PDEs (math.AP)","lang":"en","subjectScheme":"arXiv"},{"subject":"Metric Geometry (math.MG)","lang":"en","subjectScheme":"arXiv"},{"subject":"FOS: Mathematics","subjectScheme":"Fields of Science and Technology (FOS)"},{"subject":"52A40, 52A20, 26D15","lang":"en","subjectScheme":"MSC"}],"contributors":[],"dates":[{"date":"2026-08-04T17:13:43Z","dateType":"Submitted","dateInformation":"v1"},{"date":"2026-08-05T01:07:19Z","dateType":"Updated","dateInformation":"v1"},{"date":"2026-08","dateType":"Available","dateInformation":"v1"}],"language":null,"types":{"schemaOrg":"CreativeWork","resourceTypeGeneral":"Preprint","citeproc":"article","bibtex":"misc","ris":"GEN","resourceType":"Article"},"relatedIdentifiers":[],"relatedItems":[],"sizes":[],"formats":[],"version":"1","rightsList":[{"rightsIdentifierScheme":"SPDX","rightsUri":"https://creativecommons.org/licenses/by/4.0/legalcode","schemeUri":"https://spdx.org/licenses/","rights":"Creative Commons Attribution 4.0 International","rightsIdentifier":"cc-by-4.0"}],"descriptions":[{"descriptionType":"Abstract","description":"In this paper, we study the Brunn-Minkowski inequality for $q$-th dual quermassintegrals with $q\u0026gt;n$. This problem was recently posed by Sadovsky and Zhang. First, by a second variation argument and a dimension reduction construction, we show that the inequality fails for arbitrary convex bodies when $q\u0026gt;n$, and fails even in the origin-symmetric class when $q\u0026gt;n+2$. Secondly, we prove the endpoint case $q=n+2$ for origin-symmetric convex bodies via Hadwiger's inequality for the polar moment of inertia. Finally, for unconditional convex bodies, we establish the inequality in the full range $0"},{"descriptionType":"Other","description":"27 pages. All comments are welcome"}],"geoLocations":[],"fundingReferences":[],"url":"https://arxiv.org/abs/2608.03949","contentUrl":null,"metadataVersion":0,"schemaVersion":"http://datacite.org/schema/kernel-4","source":"mds","isActive":true,"state":"findable","reason":null,"viewCount":0,"downloadCount":0,"referenceCount":0,"citationCount":0,"partCount":0,"partOfCount":0,"versionCount":0,"versionOfCount":0,"created":"2026-08-05T02:24:41Z","registered":"2026-08-05T02:24:42Z","published":null,"updated":"2026-08-05T02:24:42Z"},"relationships":{"client":{"data":{"id":"arxiv.content","type":"clients"}}}},{"id":"10.48550/arxiv.2608.03948","type":"dois","attributes":{"doi":"10.48550/arxiv.2608.03948","identifiers":[{"identifier":"2608.03948","identifierType":"arXiv"}],"creators":[{"nameType":"Personal","givenName":"Lingling","familyName":"Lao","name":"Lao, Lingling","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Qiang","familyName":"Wang","name":"Wang, Qiang","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Yuanqi","familyName":"Liu","name":"Liu, Yuanqi","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Yantong","familyName":"Liu","name":"Liu, Yantong","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Haowen","familyName":"Wang","name":"Wang, Haowen","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Yitao","familyName":"Chen","name":"Chen, Yitao","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Yankang","familyName":"Zhao","name":"Zhao, Yankang","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Zhenwei","familyName":"Wu","name":"Wu, Zhenwei","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Wei","familyName":"Zhang","name":"Zhang, Wei","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Yong","familyName":"Dong","name":"Dong, Yong","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Yingwen","familyName":"Liu","name":"Liu, Yingwen","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Mingche","familyName":"Lai","name":"Lai, Mingche","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Junjie","familyName":"Wu","name":"Wu, Junjie","affiliation":[],"nameIdentifiers":[]}],"titles":[{"title":"Real-time decoding of quantum error correction codes using high-performance computing"}],"publisher":"arXiv","container":{},"publicationYear":2026,"subjects":[{"subject":"Quantum Physics (quant-ph)","lang":"en","subjectScheme":"arXiv"},{"subject":"Distributed, Parallel, and Cluster Computing (cs.DC)","lang":"en","subjectScheme":"arXiv"},{"subject":"FOS: Physical sciences","subjectScheme":"Fields of Science and Technology (FOS)"},{"subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"}],"contributors":[],"dates":[{"date":"2026-08-04T17:12:42Z","dateType":"Submitted","dateInformation":"v1"},{"date":"2026-08-05T01:07:14Z","dateType":"Updated","dateInformation":"v1"},{"date":"2026-08","dateType":"Available","dateInformation":"v1"}],"language":null,"types":{"schemaOrg":"CreativeWork","resourceTypeGeneral":"Preprint","citeproc":"article","bibtex":"misc","ris":"GEN","resourceType":"Article"},"relatedIdentifiers":[],"relatedItems":[],"sizes":[],"formats":[],"version":"1","rightsList":[{"rightsIdentifierScheme":"SPDX","rightsUri":"https://creativecommons.org/licenses/by-nc-sa/4.0/legalcode","schemeUri":"https://spdx.org/licenses/","rights":"Creative Commons Attribution Non Commercial Share Alike 4.0 International","rightsIdentifier":"cc-by-nc-sa-4.0"}],"descriptions":[{"descriptionType":"Abstract","description":"Quantum error correction (QEC) is indispensable for building scalable fault-tolerant quantum computers. Effective QEC demands stringent real-time decoding: the decoder must process syndrome measurements and determine corrections within a time scale--typically on the order of microseconds, to avoid data backlog. Scaling to large number of logical qubits further necessitates significant computational resources. In this work, we propose an architecture, called \\emph{THQLink}, for real-time decoding of quantum error correction codes using high-performance computing (HPC) resources. The network connecting the HPC and the control system of quantum processing unit (QPU) is built on TH-Express and can be adapted to different quantum technologies and their associated control stacks. We report a round-trip latency of 2.944 $μ$s on average, with an incremental overhead of 130 ns per additional hop. Using a parallel window strategy, we demonstrate real-time decoding (1 $μ$s per QEC round) of the surface code up to distance 19 using a matching-based decoder on CPUs. Our work presents a scalable framework for real-time decoding in fault-tolerant quantum computing. It can be readily applied to quantum-centric supercomputers that feature tight integration between QPU and HPC resources, thereby enabling efficient support for hybrid quantum-classical algorithms and computation-intensive workloads offloaded from the QPU."},{"descriptionType":"Other","description":"11 pages, 11 figures"}],"geoLocations":[],"fundingReferences":[],"url":"https://arxiv.org/abs/2608.03948","contentUrl":null,"metadataVersion":0,"schemaVersion":"http://datacite.org/schema/kernel-4","source":"mds","isActive":true,"state":"findable","reason":null,"viewCount":0,"downloadCount":0,"referenceCount":0,"citationCount":0,"partCount":0,"partOfCount":0,"versionCount":0,"versionOfCount":0,"created":"2026-08-05T02:24:40Z","registered":"2026-08-05T02:24:41Z","published":null,"updated":"2026-08-05T02:24:41Z"},"relationships":{"client":{"data":{"id":"arxiv.content","type":"clients"}}}},{"id":"10.48550/arxiv.2608.03947","type":"dois","attributes":{"doi":"10.48550/arxiv.2608.03947","identifiers":[{"identifier":"2608.03947","identifierType":"arXiv"}],"creators":[{"nameType":"Personal","givenName":"P.","familyName":"Peñil","name":"Peñil, P.","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"N.","familyName":"Torres-Albà","name":"Torres-Albà, N.","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"A.","familyName":"Rico","name":"Rico, A.","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"L.","familyName":"Marcotulli","name":"Marcotulli, L.","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"A.","familyName":"Domínguez","name":"Domínguez, A.","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"M.","familyName":"Ajello","name":"Ajello, M.","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"S.","familyName":"Buson","name":"Buson, S.","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"S.","familyName":"Adhikari","name":"Adhikari, S.","affiliation":[],"nameIdentifiers":[]}],"titles":[{"title":"Profile Analysis of the Multiwavelength 2.1-year Oscillations of PG 1553+113"}],"publisher":"arXiv","container":{},"publicationYear":2026,"subjects":[{"subject":"Astrophysics of Galaxies (astro-ph.GA)","lang":"en","subjectScheme":"arXiv"},{"subject":"FOS: Physical sciences","subjectScheme":"Fields of Science and Technology (FOS)"}],"contributors":[],"dates":[{"date":"2026-08-04T17:12:22Z","dateType":"Submitted","dateInformation":"v1"},{"date":"2026-08-05T01:07:13Z","dateType":"Updated","dateInformation":"v1"},{"date":"2026-08","dateType":"Available","dateInformation":"v1"}],"language":null,"types":{"schemaOrg":"CreativeWork","resourceTypeGeneral":"Preprint","citeproc":"article","bibtex":"misc","ris":"GEN","resourceType":"Article"},"relatedIdentifiers":[],"relatedItems":[],"sizes":[],"formats":[],"version":"1","rightsList":[{"rightsIdentifierScheme":"SPDX","rightsUri":"https://creativecommons.org/licenses/by/4.0/legalcode","schemeUri":"https://spdx.org/licenses/","rights":"Creative Commons Attribution 4.0 International","rightsIdentifier":"cc-by-4.0"}],"descriptions":[{"descriptionType":"Abstract","description":"We investigate the morphology of the oscillation profiles of the blazar PG~1553+113 in relation to its well-known $\\sim$2.1 yr periodicity. We identify individual cycles in the $γ$-ray, X-ray, UV, and optical light curves and characterize their temporal profiles using analytical models for single- and multi-peaked events.\n We find that the oscillations are generally described by a broad activity envelope with shorter-timescale substructure, showing that the $\\sim$2.1 yr signal is not a strictly sinusoidal or self-similar modulation. The internal morphology varies across cycles and energy bands. This is particularly evident in X-rays, where all analyzed cycles show a strong formal preference for multi-component profiles, unlike the $γ$-ray band, where several cycles admit statistically comparable empirical descriptions.\n The contemporaneous MWL oscillations show broadly aligned activity episodes, but the timing and relative amplitudes of secondary components are not systematically repeated. This suggests that a common long-term modulation affects the broadband emission, while additional local or energy-dependent processes shape individual cycles. Such a picture is compatible with a geometric, jet-related contribution to the broad recurrent envelope, with intrinsic variability superimposed on it.\n We also identify new cycles with a dominant peak accompanied by weaker twin-peak-like features, similar to structures previously discussed in a supermassive black hole binary scenario for PG~1553+113. Although our results do not provide definitive evidence for this interpretation, the recurrence of comparable morphologies in newly analyzed cycles keeps this scenario viable."},{"descriptionType":"Other","description":"21 pages, 10 figues, 5 tables"}],"geoLocations":[],"fundingReferences":[],"url":"https://arxiv.org/abs/2608.03947","contentUrl":null,"metadataVersion":0,"schemaVersion":"http://datacite.org/schema/kernel-4","source":"mds","isActive":true,"state":"findable","reason":null,"viewCount":0,"downloadCount":0,"referenceCount":0,"citationCount":0,"partCount":0,"partOfCount":0,"versionCount":0,"versionOfCount":0,"created":"2026-08-05T02:24:38Z","registered":"2026-08-05T02:24:39Z","published":null,"updated":"2026-08-05T02:24:39Z"},"relationships":{"client":{"data":{"id":"arxiv.content","type":"clients"}}}},{"id":"10.48550/arxiv.2608.03945","type":"dois","attributes":{"doi":"10.48550/arxiv.2608.03945","identifiers":[{"identifier":"2608.03945","identifierType":"arXiv"}],"creators":[{"nameType":"Personal","givenName":"Kenji","familyName":"Fukushima","name":"Fukushima, Kenji","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Shi","familyName":"Pu","name":"Pu, Shi","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Dong-Lin","familyName":"Wang","name":"Wang, Dong-Lin","affiliation":[],"nameIdentifiers":[]}],"titles":[{"title":"Local Spin Polarization in Anisotropic Gubser Flow: Suppression Mechanism and Formulation Dependence"}],"publisher":"arXiv","container":{},"publicationYear":2026,"subjects":[{"subject":"Nuclear Theory (nucl-th)","lang":"en","subjectScheme":"arXiv"},{"subject":"High Energy Physics - Phenomenology (hep-ph)","lang":"en","subjectScheme":"arXiv"},{"subject":"FOS: Physical sciences","subjectScheme":"Fields of Science and Technology (FOS)"}],"contributors":[],"dates":[{"date":"2026-08-04T17:11:50Z","dateType":"Submitted","dateInformation":"v1"},{"date":"2026-08-05T01:07:11Z","dateType":"Updated","dateInformation":"v1"},{"date":"2026-08","dateType":"Available","dateInformation":"v1"}],"language":null,"types":{"schemaOrg":"CreativeWork","resourceTypeGeneral":"Preprint","citeproc":"article","bibtex":"misc","ris":"GEN","resourceType":"Article"},"relatedIdentifiers":[],"relatedItems":[],"sizes":[],"formats":[],"version":"1","rightsList":[{"rightsIdentifierScheme":"SPDX","rightsUri":"https://creativecommons.org/licenses/by/4.0/legalcode","schemeUri":"https://spdx.org/licenses/","rights":"Creative Commons Attribution 4.0 International","rightsIdentifier":"cc-by-4.0"}],"descriptions":[{"descriptionType":"Abstract","description":"We analytically study the longitudinal spin polarization in relativistic heavy-ion collisions using a perturbed Gubser flow solution. In the large-system-size limit, we derive analytical expression of the local spin polarization along the beam direction. In our treatment, the contributions from thermal vorticity and thermal shear are of comparable magnitudes. The thermal vorticity yields the polarization with a sign opposite to that observed experimentally, while the thermal shear counteracts this effect, helping recover the desired sign. We find that the choice of the reference unit vector aligned with the fluid velocity gives the experimentally observed sign only at low transverse momenta, whereas another formulation with the unit vector fixed along the laboratory time direction yields the desired sign for a wide range of transverse momenta. Notably, a recent formulation with the unit vector normal to the freeze-out hypersurface exhibits an exact cancellation between contributions from thermal vorticity and thermal shear at leading order in the large-system-size limit. We identify a general cancellation pattern with acceleration dominance, which is manifest particularly in the latter two formulations. Thus, the total polarization originates from non-acceleration effects, which need not be substantial even when the elliptic flow is finite, as clearly demonstrated in our analytical results. For comparison, we also discuss the spin polarization in the Hubble flow with rotation."},{"descriptionType":"Other","description":"13 pages, 5 figures"}],"geoLocations":[],"fundingReferences":[],"url":"https://arxiv.org/abs/2608.03945","contentUrl":null,"metadataVersion":0,"schemaVersion":"http://datacite.org/schema/kernel-4","source":"mds","isActive":true,"state":"findable","reason":null,"viewCount":0,"downloadCount":0,"referenceCount":0,"citationCount":0,"partCount":0,"partOfCount":0,"versionCount":0,"versionOfCount":0,"created":"2026-08-05T02:24:36Z","registered":"2026-08-05T02:24:36Z","published":null,"updated":"2026-08-05T02:24:36Z"},"relationships":{"client":{"data":{"id":"arxiv.content","type":"clients"}}}},{"id":"10.48550/arxiv.2608.03944","type":"dois","attributes":{"doi":"10.48550/arxiv.2608.03944","identifiers":[{"identifier":"2608.03944","identifierType":"arXiv"}],"creators":[{"nameType":"Personal","givenName":"Arghya","familyName":"Maity","name":"Maity, Arghya","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Kelvin","familyName":"Onggadinata","name":"Onggadinata, Kelvin","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Teck Seng","familyName":"Koh","name":"Koh, Teck Seng","affiliation":[],"nameIdentifiers":[]}],"titles":[{"title":"Exact Tradeoff Between Quantum Error Correction and Quantum Darwinism: An Information-Theoretic No-Go Theorem"}],"publisher":"arXiv","container":{},"publicationYear":2026,"subjects":[{"subject":"Quantum Physics (quant-ph)","lang":"en","subjectScheme":"arXiv"},{"subject":"FOS: Physical sciences","subjectScheme":"Fields of Science and Technology (FOS)"}],"contributors":[],"dates":[{"date":"2026-08-04T17:11:19Z","dateType":"Submitted","dateInformation":"v1"},{"date":"2026-08-05T01:07:07Z","dateType":"Updated","dateInformation":"v1"},{"date":"2026-08","dateType":"Available","dateInformation":"v1"}],"language":null,"types":{"schemaOrg":"CreativeWork","resourceTypeGeneral":"Preprint","citeproc":"article","bibtex":"misc","ris":"GEN","resourceType":"Article"},"relatedIdentifiers":[],"relatedItems":[],"sizes":[],"formats":[],"version":"1","rightsList":[{"rightsUri":"http://arxiv.org/licenses/nonexclusive-distrib/1.0/","rights":"arXiv.org perpetual, non-exclusive license"}],"descriptions":[{"descriptionType":"Abstract","description":"Quantum error correction (QEC) and Quantum Darwinism describe opposing consequences of system-environment interactions: QEC seeks to preserve logical quantum information, whereas Quantum Darwinism explains the emergence of objective classical information through its proliferation into the environment. Despite their common physical origin, no direct quantitative connection between these paradigms has previously been established. We introduce an exactly solvable block-environment model based on the logical GHZ block of the Shor [[9,1,3]] quantum error-correcting code, collectively coupled to N environment qubits. The logical fidelity, Holevo information, and Darwinistic redundancy are obtained systematically for arbitrary environment size and imperfect recovery efficiency. Eliminating the common decoherence parameter yields an exact tradeoff relating Darwinistic redundancy directly to the post-recovery logical fidelity, demonstrating that the emergence of redundant classical records occurs at the expense of logical quantum information. We further prove a model-independent no-go theorem showing that the logical fidelity exceeds a critical threshold precludes the emergence of Darwinistic redundancy, irrespective of the microscopic Hamiltonian or environment structure. The solvable model saturates this general bound, establishing the first quantitative information-theoretic connection between logical quantum information protection and the emergence of redundant classical records."},{"descriptionType":"Other","description":"14 pages, 2 figures"}],"geoLocations":[],"fundingReferences":[],"url":"https://arxiv.org/abs/2608.03944","contentUrl":null,"metadataVersion":0,"schemaVersion":"http://datacite.org/schema/kernel-4","source":"mds","isActive":true,"state":"findable","reason":null,"viewCount":0,"downloadCount":0,"referenceCount":0,"citationCount":0,"partCount":0,"partOfCount":0,"versionCount":0,"versionOfCount":0,"created":"2026-08-05T02:24:34Z","registered":"2026-08-05T02:24:35Z","published":null,"updated":"2026-08-05T02:24:35Z"},"relationships":{"client":{"data":{"id":"arxiv.content","type":"clients"}}}},{"id":"10.48550/arxiv.2608.03942","type":"dois","attributes":{"doi":"10.48550/arxiv.2608.03942","identifiers":[{"identifier":"2608.03942","identifierType":"arXiv"}],"creators":[{"nameType":"Personal","givenName":"Alexander","familyName":"Tsirulev","name":"Tsirulev, Alexander","affiliation":[],"nameIdentifiers":[]}],"titles":[{"title":"Charged topological geons with a self-gravitating scalar field"}],"publisher":"arXiv","container":{},"publicationYear":2026,"subjects":[{"subject":"General Relativity and Quantum Cosmology (gr-qc)","lang":"en","subjectScheme":"arXiv"},{"subject":"FOS: Physical sciences","subjectScheme":"Fields of Science and Technology (FOS)"}],"contributors":[],"dates":[{"date":"2026-08-04T17:10:50Z","dateType":"Submitted","dateInformation":"v1"},{"date":"2026-08-05T01:07:05Z","dateType":"Updated","dateInformation":"v1"},{"date":"2026-08","dateType":"Available","dateInformation":"v1"}],"language":null,"types":{"schemaOrg":"CreativeWork","resourceTypeGeneral":"Preprint","citeproc":"article","bibtex":"misc","ris":"GEN","resourceType":"Article"},"relatedIdentifiers":[{"relationType":"IsVersionOf","relatedIdentifier":"10.1134/s0040577926070081","relatedIdentifierType":"DOI"}],"relatedItems":[],"sizes":[],"formats":[],"version":"1","rightsList":[{"rightsIdentifierScheme":"SPDX","rightsUri":"https://creativecommons.org/licenses/by/4.0/legalcode","schemeUri":"https://spdx.org/licenses/","rights":"Creative Commons Attribution 4.0 International","rightsIdentifier":"cc-by-4.0"}],"descriptions":[{"descriptionType":"Abstract","description":"A topological geon is an asymptotically (anti-)de Sitter or flat spacetime with topology $\\mathbb{R}\\times M$, where $M$ is the punctured projective space, $M=\\mathbb{R}P^3\\backslash\\{p\\}$, and the removed point $p$ corresponds to the spacelike infinity. The manifold $M$ is conventionally obtained from a spherically symmetric spatial slice of a wormhole spacetime as the quotient manifold by the isometric action of the group $\\mathbb{Z}_2$. We study the general properties of static, spherically symmetric, charged topological geons supported by a selfgravitating, minimally coupled scalar field with negative kinetic energy and an arbitrary selfinteraction potential. In the most general case, it turns out that the gravitational mass of such a geon is completely determined by its electric charge and size (for a given scalar field), that is, the size of the corresponding wormhole throat. We discuss the properties of the charged Ellis-Bronnikov-Sorkin geon and argue that it can be considered as a possible classical model of elementary particles beyond the Standard Model, in particular, as dark matter particles."},{"descriptionType":"Other","description":"14 pages, 2 figures"}],"geoLocations":[],"fundingReferences":[],"url":"https://arxiv.org/abs/2608.03942","contentUrl":null,"metadataVersion":0,"schemaVersion":"http://datacite.org/schema/kernel-4","source":"mds","isActive":true,"state":"findable","reason":null,"viewCount":0,"downloadCount":0,"referenceCount":0,"citationCount":0,"partCount":0,"partOfCount":0,"versionCount":0,"versionOfCount":1,"created":"2026-08-05T02:24:32Z","registered":"2026-08-05T02:24:32Z","published":null,"updated":"2026-08-05T02:24:32Z"},"relationships":{"client":{"data":{"id":"arxiv.content","type":"clients"}}}},{"id":"10.48550/arxiv.2608.03941","type":"dois","attributes":{"doi":"10.48550/arxiv.2608.03941","identifiers":[{"identifier":"2608.03941","identifierType":"arXiv"}],"creators":[{"nameType":"Personal","givenName":"Arslan","familyName":"Battalov","name":"Battalov, Arslan","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Karim","familyName":"Kramin","name":"Kramin, Karim","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Alexander","familyName":"Markotenko","name":"Markotenko, Alexander","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Sofia","familyName":"Sinitsina","name":"Sinitsina, Sofia","affiliation":[],"nameIdentifiers":[]}],"titles":[{"title":"Muon Meets Mamba: Spectral Optimization for State Space Models"}],"publisher":"arXiv","container":{},"publicationYear":2026,"subjects":[{"subject":"Machine Learning (cs.LG)","lang":"en","subjectScheme":"arXiv"},{"subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"}],"contributors":[],"dates":[{"date":"2026-08-04T17:10:47Z","dateType":"Submitted","dateInformation":"v1"},{"date":"2026-08-05T01:07:04Z","dateType":"Updated","dateInformation":"v1"},{"date":"2026-08","dateType":"Available","dateInformation":"v1"}],"language":null,"types":{"schemaOrg":"CreativeWork","resourceTypeGeneral":"Preprint","citeproc":"article","bibtex":"misc","ris":"GEN","resourceType":"Article"},"relatedIdentifiers":[],"relatedItems":[],"sizes":[],"formats":[],"version":"1","rightsList":[{"rightsUri":"http://arxiv.org/licenses/nonexclusive-distrib/1.0/","rights":"arXiv.org perpetual, non-exclusive license"}],"descriptions":[{"descriptionType":"Abstract","description":"Muon is a recent optimizer that orthogonalizes the update to each weight matrix with a Newton-Schulz iteration, which performs steepest descent under the spectral norm. Almost all the evidence for it comes from Transformer models, and its behavior on state-space models is largely unreported. We compare Muon with AdamW on Mamba-2 130M under a controlled protocol that varies only which weight groups are trained with Muon. The benefit is localized. Muon on the output projection alone beats Muon on the input projection or on both. The advantage is mainly one of token efficiency. It holds on two corpora and two token budgets, and persists when training continues well past the compute-optimal point. Conditioning does not explain the gain. Muon lowers the condition number of whichever projection it trains, but the better-conditioned input projection is not the one that helps."},{"descriptionType":"Other","description":"15 pages, 25 figures, 8 tables"}],"geoLocations":[],"fundingReferences":[],"url":"https://arxiv.org/abs/2608.03941","contentUrl":null,"metadataVersion":0,"schemaVersion":"http://datacite.org/schema/kernel-4","source":"mds","isActive":true,"state":"findable","reason":null,"viewCount":0,"downloadCount":0,"referenceCount":0,"citationCount":0,"partCount":0,"partOfCount":0,"versionCount":0,"versionOfCount":0,"created":"2026-08-05T02:24:30Z","registered":"2026-08-05T02:24:31Z","published":null,"updated":"2026-08-05T02:24:31Z"},"relationships":{"client":{"data":{"id":"arxiv.content","type":"clients"}}}},{"id":"10.48550/arxiv.2608.03940","type":"dois","attributes":{"doi":"10.48550/arxiv.2608.03940","identifiers":[{"identifier":"2608.03940","identifierType":"arXiv"}],"creators":[{"nameType":"Personal","givenName":"Reagan","familyName":"Dennison","name":"Dennison, Reagan","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Saanvi","familyName":"Sharma","name":"Sharma, Saanvi","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Noshir","familyName":"Contractor","name":"Contractor, Noshir","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Sruti","familyName":"Bhagavatula","name":"Bhagavatula, Sruti","affiliation":[],"nameIdentifiers":[]}],"titles":[{"title":"Echoes in the Digital Abyss: Examining the Bubble Surrounding Security and Privacy Discourse in Social Networks"}],"publisher":"arXiv","container":{},"publicationYear":2026,"subjects":[{"subject":"Computers and Society (cs.CY)","lang":"en","subjectScheme":"arXiv"},{"subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"}],"contributors":[],"dates":[{"date":"2026-08-04T17:10:47Z","dateType":"Submitted","dateInformation":"v1"},{"date":"2026-08-05T01:07:03Z","dateType":"Updated","dateInformation":"v1"},{"date":"2026-08","dateType":"Available","dateInformation":"v1"}],"language":null,"types":{"schemaOrg":"CreativeWork","resourceTypeGeneral":"Preprint","citeproc":"article","bibtex":"misc","ris":"GEN","resourceType":"Article"},"relatedIdentifiers":[],"relatedItems":[],"sizes":[],"formats":[],"version":"1","rightsList":[{"rightsIdentifierScheme":"SPDX","rightsUri":"https://creativecommons.org/licenses/by/4.0/legalcode","schemeUri":"https://spdx.org/licenses/","rights":"Creative Commons Attribution 4.0 International","rightsIdentifier":"cc-by-4.0"}],"descriptions":[{"descriptionType":"Abstract","description":"The dissemination of security and privacy education and guidance has been and still remains a challenge today. Social networks represent a potential avenue for sharing best practices, and experimentally they have been found to be effective at this task. While this appears promising, in the real world, security and privacy discussions would need to reach a wide range of people to be effective, avoiding the \"interest bubbles\" that commonly occur. We sought to understand how the communities surrounding security and privacy discourse operate, with a focus on what challenges need to be overcome to enable security and privacy discourse and advice to reach a wider audience.\n Indeed, we found that in-the-wild security and privacy discussions in social networks portray quite a different picture than in experimental settings. We built and analyzed the structure of a graph containing over 13 million users on the \"X\" platform (formerly \"Twitter\"), including 10,159 users who posted about security and privacy and their followers. Prior work has shown that users are more likely to consider information within social media if their like-minded social ties have visibly engaged with it. Our findings indicate that the users generating or participating in security discussions largely already belong to highly clustered technology and security- and privacy-related interest communities, which suggests that the people who are not already in the \"inner circle\" of relevant interests are likely not exposed effectively to these discussions. We conclude with reflections and ideas on increasing the reach of security and privacy guidance in social networks."}],"geoLocations":[],"fundingReferences":[],"url":"https://arxiv.org/abs/2608.03940","contentUrl":null,"metadataVersion":0,"schemaVersion":"http://datacite.org/schema/kernel-4","source":"mds","isActive":true,"state":"findable","reason":null,"viewCount":0,"downloadCount":0,"referenceCount":0,"citationCount":0,"partCount":0,"partOfCount":0,"versionCount":0,"versionOfCount":0,"created":"2026-08-05T02:24:29Z","registered":"2026-08-05T02:24:29Z","published":null,"updated":"2026-08-05T02:24:29Z"},"relationships":{"client":{"data":{"id":"arxiv.content","type":"clients"}}}},{"id":"10.48550/arxiv.2608.03939","type":"dois","attributes":{"doi":"10.48550/arxiv.2608.03939","identifiers":[{"identifier":"2608.03939","identifierType":"arXiv"}],"creators":[{"nameType":"Personal","givenName":"Bassam","familyName":"Nima","name":"Nima, Bassam","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Yuiki","familyName":"Takahashi","name":"Takahashi, Yuiki","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Amar","familyName":"Vutha","name":"Vutha, Amar","affiliation":[],"nameIdentifiers":[]}],"titles":[{"title":"Enhanced coherence of rare-earth nuclear spins in a crystal"}],"publisher":"arXiv","container":{},"publicationYear":2026,"subjects":[{"subject":"Atomic Physics (physics.atom-ph)","lang":"en","subjectScheme":"arXiv"},{"subject":"FOS: Physical sciences","subjectScheme":"Fields of Science and Technology (FOS)"}],"contributors":[],"dates":[{"date":"2026-08-04T17:09:59Z","dateType":"Submitted","dateInformation":"v1"},{"date":"2026-08-05T01:06:54Z","dateType":"Updated","dateInformation":"v1"},{"date":"2026-08","dateType":"Available","dateInformation":"v1"}],"language":null,"types":{"schemaOrg":"CreativeWork","resourceTypeGeneral":"Preprint","citeproc":"article","bibtex":"misc","ris":"GEN","resourceType":"Article"},"relatedIdentifiers":[],"relatedItems":[],"sizes":[],"formats":[],"version":"1","rightsList":[{"rightsUri":"http://arxiv.org/licenses/nonexclusive-distrib/1.0/","rights":"arXiv.org perpetual, non-exclusive license"}],"descriptions":[{"descriptionType":"Abstract","description":"Rare-earth ions in crystals are useful in precision measurements and quantum information science because of their exceptional optical and spin coherence properties. We show that the nuclear spin coherence time of $^{153}\\mathrm{Eu}^{3+}$ ions doped into yttrium orthosilicate can be significantly enhanced by driving the $^{89}\\mathrm{Y}$ nuclear spins in the host crystal. This improvement in spin coherence time opens up ways to improve the precision of measurements using rare-earth-doped crystals."}],"geoLocations":[],"fundingReferences":[],"url":"https://arxiv.org/abs/2608.03939","contentUrl":null,"metadataVersion":0,"schemaVersion":"http://datacite.org/schema/kernel-4","source":"mds","isActive":true,"state":"findable","reason":null,"viewCount":0,"downloadCount":0,"referenceCount":0,"citationCount":0,"partCount":0,"partOfCount":0,"versionCount":0,"versionOfCount":0,"created":"2026-08-05T02:24:27Z","registered":"2026-08-05T02:24:28Z","published":null,"updated":"2026-08-05T02:24:28Z"},"relationships":{"client":{"data":{"id":"arxiv.content","type":"clients"}}}},{"id":"10.48550/arxiv.2608.03938","type":"dois","attributes":{"doi":"10.48550/arxiv.2608.03938","identifiers":[{"identifier":"2608.03938","identifierType":"arXiv"}],"creators":[{"nameType":"Personal","givenName":"Ekansh","familyName":"Singh","name":"Singh, Ekansh","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Eva","familyName":"Samuel","name":"Samuel, Eva","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Alessandra","familyName":"Reneau","name":"Reneau, Alessandra","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Ryan","familyName":"Schmeelk","name":"Schmeelk, Ryan","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Yashvi","familyName":"Gandhi","name":"Gandhi, Yashvi","affiliation":[],"nameIdentifiers":[]}],"titles":[{"title":"Bimanual Manipulation Within an 8 GB Budget: Zero-Copy Sensing and Quantized ACT on an Entry-Level Jetson"}],"publisher":"arXiv","container":{},"publicationYear":2026,"subjects":[{"subject":"Robotics (cs.RO)","lang":"en","subjectScheme":"arXiv"},{"subject":"Systems and Control (eess.SY)","lang":"en","subjectScheme":"arXiv"},{"subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"},{"subject":"FOS: Electrical engineering, electronic engineering, information engineering","subjectScheme":"Fields of Science and Technology (FOS)"},{"subject":"I.2.9; C.3","lang":"en","subjectScheme":"ACM"}],"contributors":[],"dates":[{"date":"2026-08-04T17:09:41Z","dateType":"Submitted","dateInformation":"v1"},{"date":"2026-08-05T01:06:53Z","dateType":"Updated","dateInformation":"v1"},{"date":"2026-08","dateType":"Available","dateInformation":"v1"}],"language":null,"types":{"schemaOrg":"CreativeWork","resourceTypeGeneral":"Preprint","citeproc":"article","bibtex":"misc","ris":"GEN","resourceType":"Article"},"relatedIdentifiers":[],"relatedItems":[],"sizes":[],"formats":[],"version":"1","rightsList":[{"rightsIdentifierScheme":"SPDX","rightsUri":"https://creativecommons.org/licenses/by/4.0/legalcode","schemeUri":"https://spdx.org/licenses/","rights":"Creative Commons Attribution 4.0 International","rightsIdentifier":"cc-by-4.0"}],"descriptions":[{"descriptionType":"Abstract","description":"Bimanual manipulation policies trained with imitation learning are typically evaluated on workstation or datacenter-class GPUs, leaving the cost of deploying them on embedded hardware largely uncharacterized. We present a bimanual SO-101 system running entirely on an NVIDIA Jetson Orin Nano Super (8 GB), the entry-level tier of NVIDIA's embedded line, using a desktop GPU (RTX 3070) only for offline training, evaluated on pick-and-place of a deformable beanbag. First, we build a GStreamer capture pipeline backed by NVMM buffers that removes redundant host-device copies from three-camera sensing. Contrary to expectation, the conventional path fit the memory budget and dropped no frames; what zero-copy sensing recovers is CPU headroom (peak single-core utilization 98.0% to 77.0%) and worst-case latency (117.31 ms to 101.52 ms). Second, we train ACT and Diffusion Policy on identical demonstrations, each at its own reference budget (100k gradient steps for ACT, 200k for Diffusion Policy). ACT converges to a task-competent policy (19/20 trials) while Diffusion Policy does not converge to a usable one (0/10) even at twice the step count, which we attribute to differing convergence costs rather than an accuracy ceiling. Third, we convert ACT to TensorRT. FP16 reduces mean inference latency from 114.02 ms to 17.93 ms (6.4x) and INT8 to 12.65 ms (9.0x), with task success preserved at all three precisions (19/20, 18/20, 19/20). We report two findings not previously documented for ACT: TensorRT's general-purpose INT8 calibration quantizes the ResNet18 backbone but accepts zero of 145 transformer layers, explaining INT8's negligible size reduction over FP16 (0.9%) despite a further 28% latency gain; and the need for quantization is conditional on ACT's action-chunking configuration, feasible in full precision at n_action_steps = 100 but not at the per-step re-prediction temporal ensembling requires."},{"descriptionType":"Other","description":"9 pages, 8 tables. Work conducted at the Georgia Tech Research Institute (GTRI), Aerospace, Transportation and Advanced Systems Laboratory (ATAS)"}],"geoLocations":[],"fundingReferences":[],"url":"https://arxiv.org/abs/2608.03938","contentUrl":null,"metadataVersion":0,"schemaVersion":"http://datacite.org/schema/kernel-4","source":"mds","isActive":true,"state":"findable","reason":null,"viewCount":0,"downloadCount":0,"referenceCount":0,"citationCount":0,"partCount":0,"partOfCount":0,"versionCount":0,"versionOfCount":0,"created":"2026-08-05T02:24:26Z","registered":"2026-08-05T02:24:27Z","published":null,"updated":"2026-08-05T02:24:27Z"},"relationships":{"client":{"data":{"id":"arxiv.content","type":"clients"}}}},{"id":"10.48550/arxiv.2608.03937","type":"dois","attributes":{"doi":"10.48550/arxiv.2608.03937","identifiers":[{"identifier":"2608.03937","identifierType":"arXiv"}],"creators":[{"nameType":"Personal","givenName":"Noor","familyName":"Hussein","name":"Hussein, Noor","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Anil K.","familyName":"Jain","name":"Jain, Anil K.","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Karthik","familyName":"Nandakumar","name":"Nandakumar, Karthik","affiliation":[],"nameIdentifiers":[]}],"titles":[{"title":"Progressive Learning of a Diffusion-based Inpainting Model for Separating Overlapped Fingerprints"}],"publisher":"arXiv","container":{},"publicationYear":2026,"subjects":[{"subject":"Computer Vision and Pattern Recognition (cs.CV)","lang":"en","subjectScheme":"arXiv"},{"subject":"Cryptography and Security (cs.CR)","lang":"en","subjectScheme":"arXiv"},{"subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"}],"contributors":[],"dates":[{"date":"2026-08-04T17:08:46Z","dateType":"Submitted","dateInformation":"v1"},{"date":"2026-08-05T01:06:50Z","dateType":"Updated","dateInformation":"v1"},{"date":"2026-08","dateType":"Available","dateInformation":"v1"}],"language":null,"types":{"schemaOrg":"CreativeWork","resourceTypeGeneral":"Preprint","citeproc":"article","bibtex":"misc","ris":"GEN","resourceType":"Article"},"relatedIdentifiers":[],"relatedItems":[],"sizes":[],"formats":[],"version":"1","rightsList":[{"rightsUri":"http://arxiv.org/licenses/nonexclusive-distrib/1.0/","rights":"arXiv.org perpetual, non-exclusive license"}],"descriptions":[{"descriptionType":"Abstract","description":"Overlapped friction ridge patterns are a recurring problem in latent fingerprints recovered from crime scenes and in live-scan scenarios where residual fingerprints on the sensor may corrupt subsequent acquisitions. Existing approaches for separating overlapped fingerprints either rely on rule-based orientation field completion that requires strong domain knowledge or train end-to-end deep neural networks that do not account for domain-specific considerations. This work introduces a diffusion-based pipeline for separating component fingerprints from an image containing overlapping friction ridge patterns. We formulate the separation problem as an inpainting task and progressively learn a diffusion model for this task in multiple stages. Starting from a pre-trained Stable Diffusion model, we progressively incorporate a fingerprint prior, add the ability to complete partial fingerprints, and finally propose \\textbf{overlap-aware inpainting} that reconstructs each component print using a diffusion inpainting model based on multi-channel conditioning. Experiments on two public datasets demonstrate that component fingerprints reconstructed using the proposed diffusion-based inpainting method can match with their mated counterparts with very high probability."},{"descriptionType":"Other","description":"Accepted to IJCB 2026"}],"geoLocations":[],"fundingReferences":[],"url":"https://arxiv.org/abs/2608.03937","contentUrl":null,"metadataVersion":0,"schemaVersion":"http://datacite.org/schema/kernel-4","source":"mds","isActive":true,"state":"findable","reason":null,"viewCount":0,"downloadCount":0,"referenceCount":0,"citationCount":0,"partCount":0,"partOfCount":0,"versionCount":0,"versionOfCount":0,"created":"2026-08-05T02:24:25Z","registered":"2026-08-05T02:24:25Z","published":null,"updated":"2026-08-05T02:24:25Z"},"relationships":{"client":{"data":{"id":"arxiv.content","type":"clients"}}}},{"id":"10.48550/arxiv.2608.03936","type":"dois","attributes":{"doi":"10.48550/arxiv.2608.03936","identifiers":[{"identifier":"2608.03936","identifierType":"arXiv"}],"creators":[{"nameType":"Personal","givenName":"Marwa","familyName":"Telba","name":"Telba, Marwa","affiliation":[],"nameIdentifiers":[]}],"titles":[{"title":"Di-Higgs Production and Trilinear Higgs Self-Coupling in the scNMSSM: Qualitative Implications for the Electroweak Phase Transition at large λ and Low tan\\b{eta}"}],"publisher":"arXiv","container":{},"publicationYear":2026,"subjects":[{"subject":"High Energy Physics - Phenomenology (hep-ph)","lang":"en","subjectScheme":"arXiv"},{"subject":"FOS: Physical sciences","subjectScheme":"Fields of Science and Technology (FOS)"}],"contributors":[],"dates":[{"date":"2026-08-04T17:07:19Z","dateType":"Submitted","dateInformation":"v1"},{"date":"2026-08-05T01:06:47Z","dateType":"Updated","dateInformation":"v1"},{"date":"2026-08","dateType":"Available","dateInformation":"v1"}],"language":null,"types":{"schemaOrg":"CreativeWork","resourceTypeGeneral":"Preprint","citeproc":"article","bibtex":"misc","ris":"GEN","resourceType":"Article"},"relatedIdentifiers":[{"relationType":"IsVersionOf","relatedIdentifier":"10.1142/s021773232650207x","relatedIdentifierType":"DOI"}],"relatedItems":[],"sizes":[],"formats":[],"version":"1","rightsList":[{"rightsUri":"http://arxiv.org/licenses/nonexclusive-distrib/1.0/","rights":"arXiv.org perpetual, non-exclusive license"}],"descriptions":[{"descriptionType":"Abstract","description":"The trilinear Higgs self-coupling and di-Higgs production cross section are investigated in the semi-constrained NMSSM (scNMSSM) at large-$λ$ / low-$\\tanβ$ with full two-loop precision. A random scan of one million parameter points subject to theoretical, collider, flavor, and dark matter constraints yields 66 SM-like points with singlet fraction $S_{13}^2 \u0026lt; 0.05$, all found in the mass range $m_{h_1} \\in [122.0,\\,125.0]~\\text{GeV}$ --- a feature that reflects an intrinsic property of the scNMSSM at large-$λ$ / low-$\\tanβ$, where doublet-dominated configurations are kinematically confined below ${\\sim}125~\\text{GeV}$. The trilinear coupling ratio is found to be universally suppressed: $κ_λ= 0.884$--$0.982$, $\\langleκ_λ\\rangle = 0.944 \\pm 0.018$. The non-resonant di-Higgs cross section at $\\sqrt{s} = 13.6~\\text{TeV}$ lies in the range $30.3$--$36.9~\\text{fb}$ ($0.88$--$1.05\\,σ_{\\rm SM}$), with the resonant contribution via $gg \\to h_3 \\to h_1h_1$ negligible ($\\leq 0.004~\\text{fb}$). All predictions are consistent with current ATLAS+CMS di-Higgs upper limits and is expected to be probed at the HL-LHC. These results are discussed in the context of the electroweak phase transition, where the universal suppression of $κ_λ$ is qualitatively consistent with a modified Higgs potential that could support a strengthened first-order transition. A quantitative determination of the phase transition strength via finite-temperature analysis is left for future work."},{"descriptionType":"Other","description":"3 figures"}],"geoLocations":[],"fundingReferences":[],"url":"https://arxiv.org/abs/2608.03936","contentUrl":null,"metadataVersion":0,"schemaVersion":"http://datacite.org/schema/kernel-4","source":"mds","isActive":true,"state":"findable","reason":null,"viewCount":0,"downloadCount":0,"referenceCount":0,"citationCount":0,"partCount":0,"partOfCount":0,"versionCount":0,"versionOfCount":1,"created":"2026-08-05T02:24:23Z","registered":"2026-08-05T02:24:24Z","published":null,"updated":"2026-08-05T02:24:24Z"},"relationships":{"client":{"data":{"id":"arxiv.content","type":"clients"}}}},{"id":"10.48550/arxiv.2608.03935","type":"dois","attributes":{"doi":"10.48550/arxiv.2608.03935","identifiers":[{"identifier":"2608.03935","identifierType":"arXiv"}],"creators":[{"nameType":"Personal","givenName":"Inna","familyName":"Capdeboscq","name":"Capdeboscq, Inna","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Chris","familyName":"Parker","name":"Parker, Chris","affiliation":[],"nameIdentifiers":[]}],"titles":[{"title":"The structure of finite groups invariably generated by two elements of prime order"}],"publisher":"arXiv","container":{},"publicationYear":2026,"subjects":[{"subject":"Group Theory (math.GR)","lang":"en","subjectScheme":"arXiv"},{"subject":"FOS: Mathematics","subjectScheme":"Fields of Science and Technology (FOS)"}],"contributors":[],"dates":[{"date":"2026-08-04T17:06:50Z","dateType":"Submitted","dateInformation":"v1"},{"date":"2026-08-05T01:06:42Z","dateType":"Updated","dateInformation":"v1"},{"date":"2026-08","dateType":"Available","dateInformation":"v1"}],"language":null,"types":{"schemaOrg":"CreativeWork","resourceTypeGeneral":"Preprint","citeproc":"article","bibtex":"misc","ris":"GEN","resourceType":"Article"},"relatedIdentifiers":[],"relatedItems":[],"sizes":[],"formats":[],"version":"1","rightsList":[{"rightsIdentifierScheme":"SPDX","rightsUri":"https://creativecommons.org/licenses/by/4.0/legalcode","schemeUri":"https://spdx.org/licenses/","rights":"Creative Commons Attribution 4.0 International","rightsIdentifier":"cc-by-4.0"}],"descriptions":[{"descriptionType":"Abstract","description":"A group $G$ is invariably generated by two elements $a$ and $b$ if $G=\\langle a^g,b^h\\rangle $ for all $g,h\\in G$. This paper provides a structural description of finite groups invariably generated by two elements of distinct prime orders $s$ and $t$. We illustrate the use of our main result in a case study with $s=2$ and $t=3$. In particular we prove that an almost simple group is invariably generated by an element of order $2$ and an element of order $3$ if and only if it is isomorphic to $\\mathrm{PGL}_2(3^{2^b})$ for some $b \\ge 1$."}],"geoLocations":[],"fundingReferences":[],"url":"https://arxiv.org/abs/2608.03935","contentUrl":null,"metadataVersion":0,"schemaVersion":"http://datacite.org/schema/kernel-4","source":"mds","isActive":true,"state":"findable","reason":null,"viewCount":0,"downloadCount":0,"referenceCount":0,"citationCount":0,"partCount":0,"partOfCount":0,"versionCount":0,"versionOfCount":0,"created":"2026-08-05T02:24:22Z","registered":"2026-08-05T02:24:23Z","published":null,"updated":"2026-08-05T02:24:23Z"},"relationships":{"client":{"data":{"id":"arxiv.content","type":"clients"}}}},{"id":"10.48550/arxiv.2608.03934","type":"dois","attributes":{"doi":"10.48550/arxiv.2608.03934","identifiers":[{"identifier":"2608.03934","identifierType":"arXiv"}],"creators":[{"nameType":"Personal","givenName":"Enric","familyName":"Florit","name":"Florit, Enric","affiliation":[],"nameIdentifiers":[]}],"titles":[{"title":"Non-split Cartan curves and a characterization of fake elliptic curves"}],"publisher":"arXiv","container":{},"publicationYear":2026,"subjects":[{"subject":"Number Theory (math.NT)","lang":"en","subjectScheme":"arXiv"},{"subject":"Algebraic Geometry (math.AG)","lang":"en","subjectScheme":"arXiv"},{"subject":"FOS: Mathematics","subjectScheme":"Fields of Science and Technology (FOS)"},{"subject":"11G18, 14K15, 11F80","lang":"en","subjectScheme":"MSC"}],"contributors":[],"dates":[{"date":"2026-08-04T17:06:22Z","dateType":"Submitted","dateInformation":"v1"},{"date":"2026-08-05T01:06:42Z","dateType":"Updated","dateInformation":"v1"},{"date":"2026-08","dateType":"Available","dateInformation":"v1"}],"language":null,"types":{"schemaOrg":"CreativeWork","resourceTypeGeneral":"Preprint","citeproc":"article","bibtex":"misc","ris":"GEN","resourceType":"Article"},"relatedIdentifiers":[],"relatedItems":[],"sizes":[],"formats":[],"version":"1","rightsList":[{"rightsUri":"http://arxiv.org/licenses/nonexclusive-distrib/1.0/","rights":"arXiv.org perpetual, non-exclusive license"}],"descriptions":[{"descriptionType":"Abstract","description":"The $\\ell$-adic Tate module of an abelian surface with quaternionic multiplication (QM) decomposes as two copies of a two-dimensional $\\mathbb{Q}$-rational representation. To this day, there is no criterion to distinguish these representations from those attached to elliptic curves. For this reason, QM abelian surfaces are usually called fake elliptic curves.\n In this paper we characterize QM abelian surfaces defined over an imaginary quadratic field $K$. Namely, we consider an abelian surface $A/K$ without potential CM and whose $L$-function is a square. Under a reasonable conjecture, we show that $A$ has QM if and only if it has residual image contained in a non-split Cartan group modulo at least two primes. The characterization is unconditional for all indefinite quaternion discriminants up to 33.\n The proof is based on previous work of Siksek and Michaud-Jacobs on quadratic points on non-split Cartan modular curves. In particular, we compute the rational points on the curve $X_{ns}^+(15)$, and we prove that all quadratic points on $X_{ns}(6)$, $X_{ns}(10)$ and $X_{ns}(15)$ are non-exceptional."},{"descriptionType":"Other","description":"27 pages, Magma code is linked"}],"geoLocations":[],"fundingReferences":[],"url":"https://arxiv.org/abs/2608.03934","contentUrl":null,"metadataVersion":0,"schemaVersion":"http://datacite.org/schema/kernel-4","source":"mds","isActive":true,"state":"findable","reason":null,"viewCount":0,"downloadCount":0,"referenceCount":0,"citationCount":0,"partCount":0,"partOfCount":0,"versionCount":0,"versionOfCount":0,"created":"2026-08-05T02:24:20Z","registered":"2026-08-05T02:24:21Z","published":null,"updated":"2026-08-05T02:24:21Z"},"relationships":{"client":{"data":{"id":"arxiv.content","type":"clients"}}}},{"id":"10.48550/arxiv.2608.03933","type":"dois","attributes":{"doi":"10.48550/arxiv.2608.03933","identifiers":[{"identifier":"2608.03933","identifierType":"arXiv"}],"creators":[{"nameType":"Personal","givenName":"Jules","familyName":"Viard","name":"Viard, Jules","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Alexander","familyName":"Michaelides","name":"Michaelides, Alexander","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Panos","familyName":"Parpas","name":"Parpas, Panos","affiliation":[],"nameIdentifiers":[]}],"titles":[{"title":"Simulation-Based Neural Policies for Portfolio Choice: Architecture, Training, and Interpretability"}],"publisher":"arXiv","container":{},"publicationYear":2026,"subjects":[{"subject":"Optimization and Control (math.OC)","lang":"en","subjectScheme":"arXiv"},{"subject":"FOS: Mathematics","subjectScheme":"Fields of Science and Technology (FOS)"}],"contributors":[],"dates":[{"date":"2026-08-04T17:05:50Z","dateType":"Submitted","dateInformation":"v1"},{"date":"2026-08-05T01:06:40Z","dateType":"Updated","dateInformation":"v1"},{"date":"2026-08","dateType":"Available","dateInformation":"v1"}],"language":null,"types":{"schemaOrg":"CreativeWork","resourceTypeGeneral":"Preprint","citeproc":"article","bibtex":"misc","ris":"GEN","resourceType":"Article"},"relatedIdentifiers":[],"relatedItems":[],"sizes":[],"formats":[],"version":"1","rightsList":[{"rightsIdentifierScheme":"SPDX","rightsUri":"https://creativecommons.org/licenses/by/4.0/legalcode","schemeUri":"https://spdx.org/licenses/","rights":"Creative Commons Attribution 4.0 International","rightsIdentifier":"cc-by-4.0"}],"descriptions":[{"descriptionType":"Abstract","description":"Many economic decision problems, lifecycle consumption-saving and dynamic portfolio choice, are finite-horizon stochastic control problems with continuous states and actions. When the state is low-dimensional these problems are solved by dynamic programming on a grid. The grid cost grows exponentially in the state dimension, known as the curse of dimensionality, which motivates replacing the value-function grid with a neural policy optimized directly through simulation. Such policies are usually studied in the high-dimensional settings that motivate them, precisely where no reference solution exists. So the contribution of any single architectural or training choice cannot be isolated and diagnosed. We therefore take a step back and treat both the architecture and the solution method as the objects of study. To this end, we consider a lifecycle problem with a sufficiently low-dimensional normalized state space to admit an accurate dynamic programming solution, which is used for evaluation. We compare four architectures. The simplest consists of a single time-conditioned network. We then consider two networks concatenated across the regime switch, followed by one network per date trained backward against frozen downstream policies. Finally, we evaluate a constrained variant of the per-date architecture. Decoupling the policy across time gives each date a short, well-posed objective, which we pair with direction-dominant optimization that normalizes away gradient magnitude. Architectures that lead to similar realized utility objective can nevertheless differ in whether they respect the underlying problem's economics. We therefore evaluate each design jointly based on welfare, a solution-free Bellman residual, shape restrictions, and the resulting policy functions."}],"geoLocations":[],"fundingReferences":[],"url":"https://arxiv.org/abs/2608.03933","contentUrl":null,"metadataVersion":0,"schemaVersion":"http://datacite.org/schema/kernel-4","source":"mds","isActive":true,"state":"findable","reason":null,"viewCount":0,"downloadCount":0,"referenceCount":0,"citationCount":0,"partCount":0,"partOfCount":0,"versionCount":0,"versionOfCount":0,"created":"2026-08-05T02:24:19Z","registered":"2026-08-05T02:24:20Z","published":null,"updated":"2026-08-05T02:24:20Z"},"relationships":{"client":{"data":{"id":"arxiv.content","type":"clients"}}}},{"id":"10.48550/arxiv.2608.03932","type":"dois","attributes":{"doi":"10.48550/arxiv.2608.03932","identifiers":[{"identifier":"2608.03932","identifierType":"arXiv"}],"creators":[{"nameType":"Personal","givenName":"Jan","familyName":"Köttgen","name":"Köttgen, Jan","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Nils von den","familyName":"Driesch","name":"Driesch, Nils von den","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Alexander","familyName":"Pawlis","name":"Pawlis, Alexander","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Matthias","familyName":"Wuttig","name":"Wuttig, Matthias","affiliation":[],"nameIdentifiers":[]}],"titles":[{"title":"Understanding and Designing Phase Change Materials: Insights from Atom Probe Tomography"}],"publisher":"arXiv","container":{},"publicationYear":2026,"subjects":[{"subject":"Materials Science (cond-mat.mtrl-sci)","lang":"en","subjectScheme":"arXiv"},{"subject":"FOS: Physical sciences","subjectScheme":"Fields of Science and Technology (FOS)"}],"contributors":[],"dates":[{"date":"2026-08-04T17:05:50Z","dateType":"Submitted","dateInformation":"v1"},{"date":"2026-08-05T01:06:39Z","dateType":"Updated","dateInformation":"v1"},{"date":"2026-08","dateType":"Available","dateInformation":"v1"}],"language":null,"types":{"schemaOrg":"CreativeWork","resourceTypeGeneral":"Preprint","citeproc":"article","bibtex":"misc","ris":"GEN","resourceType":"Article"},"relatedIdentifiers":[],"relatedItems":[],"sizes":[],"formats":[],"version":"1","rightsList":[{"rightsIdentifierScheme":"SPDX","rightsUri":"https://creativecommons.org/licenses/by/4.0/legalcode","schemeUri":"https://spdx.org/licenses/","rights":"Creative Commons Attribution 4.0 International","rightsIdentifier":"cc-by-4.0"}],"descriptions":[{"descriptionType":"Abstract","description":"Phase Change Materials (PCMs) can be rapidly and reversibly switched between their amorphous and crystalline state; a transition which is accompanied by a pronounced change of optoelectronic properties. Here progress is reviewed to explain these property changes, focusing on advances by atom probe tomography (APT). This technique classifies bonding by providing two crucial bonding descriptors. Most important is the Probability of Multiple Events (PME), which is related to the likelihood that more than one ion is dislodged per successful laser pulse in laser assisted field evaporation. Crystalline PCMs are characterized by a PME above 55%, not found for metals or iono-covalent solids. This confirms that crystalline PCMs employ a unique bonding mechanism coined metavalent bonding (MVB). While crystalline PCMs employ MVB, amorphous PCMs behave as covalent solids characterized by a much lower PME. PCMs thus change their bonding upon crystallization, consistent with quantum-chemical calculations of bonding. Crystalline solids with a high PME lie in a narrow conductivity range between metals and iono-covalent solids, indicative for a competition between electron localization and delocalization. A map quantifying chemical bonding locates metavalent solids in a region where approximately one electron is shared between adjacent atoms and bonding is not too ionic. This quantum chemical bonding map is now used to find and explain property trends relevant for PCMs in various application domains."}],"geoLocations":[],"fundingReferences":[],"url":"https://arxiv.org/abs/2608.03932","contentUrl":null,"metadataVersion":0,"schemaVersion":"http://datacite.org/schema/kernel-4","source":"mds","isActive":true,"state":"findable","reason":null,"viewCount":0,"downloadCount":0,"referenceCount":0,"citationCount":0,"partCount":0,"partOfCount":0,"versionCount":0,"versionOfCount":0,"created":"2026-08-05T02:24:18Z","registered":"2026-08-05T02:24:18Z","published":null,"updated":"2026-08-05T02:24:18Z"},"relationships":{"client":{"data":{"id":"arxiv.content","type":"clients"}}}},{"id":"10.48550/arxiv.2608.03931","type":"dois","attributes":{"doi":"10.48550/arxiv.2608.03931","identifiers":[{"identifier":"2608.03931","identifierType":"arXiv"}],"creators":[{"nameType":"Personal","givenName":"Marco","familyName":"Caserta","name":"Caserta, Marco","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Antonio García","familyName":"Romero","name":"Romero, Antonio García","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Miguel","familyName":"Vaquero","name":"Vaquero, Miguel","affiliation":[],"nameIdentifiers":[]}],"titles":[{"title":"A Robust Chance Constrained Approach to Surgery Scheduling"}],"publisher":"arXiv","container":{},"publicationYear":2026,"subjects":[{"subject":"Optimization and Control (math.OC)","lang":"en","subjectScheme":"arXiv"},{"subject":"FOS: Mathematics","subjectScheme":"Fields of Science and Technology (FOS)"},{"subject":"90B35, 90C11, 90C15, 90C17, 90C90, 92C50","lang":"en","subjectScheme":"MSC"}],"contributors":[],"dates":[{"date":"2026-08-04T17:03:04Z","dateType":"Submitted","dateInformation":"v1"},{"date":"2026-08-05T01:06:35Z","dateType":"Updated","dateInformation":"v1"},{"date":"2026-08","dateType":"Available","dateInformation":"v1"}],"language":null,"types":{"schemaOrg":"CreativeWork","resourceTypeGeneral":"Preprint","citeproc":"article","bibtex":"misc","ris":"GEN","resourceType":"Article"},"relatedIdentifiers":[],"relatedItems":[],"sizes":[],"formats":[],"version":"1","rightsList":[{"rightsUri":"http://arxiv.org/licenses/nonexclusive-distrib/1.0/","rights":"arXiv.org perpetual, non-exclusive license"}],"descriptions":[{"descriptionType":"Abstract","description":"We study elective surgery scheduling under uncertain procedure durations. Schedules based on mean durations or fixed buffering rules may appear efficient ex ante but become fragile in execution, as early overruns propagate through the day and expose later surgeries to accumulated delay. We propose a robust chance-constrained framework that separates uncertainty quantification from schedule optimization. A buffer engine converts distributional information into reliability-dependent buffered durations, while the scheduling model jointly selects assignments, sequences, start times, and surgery-level reliability levels from a discrete menu. Reliability therefore becomes an endogenous scheduling decision rather than a fixed service-level parameter. The framework accommodates average-reliability, worst-day, and hard-target risk postures. Comparisons with common-reliability and uniform proportional-buffer benchmarks show that the menu derives its value from exploiting surgery-level heterogeneity, allocating protection where it has the greatest operational value while avoiding unnecessary conservatism. In a rolling-origin case study at HLA Moncloa Hospital in Madrid, covering 10 instances with 45 to 227 surgeries, the approach reduces delays exceeding 90 minutes by 97%, lowers the 95th-percentile delay by approximately 620 minutes, and reduces total overtime by 42% relative to a deterministic mean-based baseline. By allocating buffers according to uncertainty and operational exposure, the framework translates heterogeneous duration data and risk preferences into schedules that are more reliable in execution and less conservatively buffered than one-size-fits-all rules."},{"descriptionType":"Other","description":"38 pages, 7 figures, 11 tables"}],"geoLocations":[],"fundingReferences":[],"url":"https://arxiv.org/abs/2608.03931","contentUrl":null,"metadataVersion":0,"schemaVersion":"http://datacite.org/schema/kernel-4","source":"mds","isActive":true,"state":"findable","reason":null,"viewCount":0,"downloadCount":0,"referenceCount":0,"citationCount":0,"partCount":0,"partOfCount":0,"versionCount":0,"versionOfCount":0,"created":"2026-08-05T02:24:16Z","registered":"2026-08-05T02:24:17Z","published":null,"updated":"2026-08-05T02:24:17Z"},"relationships":{"client":{"data":{"id":"arxiv.content","type":"clients"}}}},{"id":"10.48550/arxiv.2608.03930","type":"dois","attributes":{"doi":"10.48550/arxiv.2608.03930","identifiers":[{"identifier":"2608.03930","identifierType":"arXiv"}],"creators":[{"nameType":"Personal","givenName":"Jo-Ku","familyName":"Cheng","name":"Cheng, Jo-Ku","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Nikolaos","familyName":"Aletras","name":"Aletras, Nikolaos","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Marco","familyName":"Valentino","name":"Valentino, Marco","affiliation":[],"nameIdentifiers":[]}],"titles":[{"title":"Logic Before Language: Pre-pretraining on Formal Derivations Fosters Skill Acquisition and Compressibility"}],"publisher":"arXiv","container":{},"publicationYear":2026,"subjects":[{"subject":"Computation and Language (cs.CL)","lang":"en","subjectScheme":"arXiv"},{"subject":"Artificial Intelligence (cs.AI)","lang":"en","subjectScheme":"arXiv"},{"subject":"Machine Learning (cs.LG)","lang":"en","subjectScheme":"arXiv"},{"subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"}],"contributors":[],"dates":[{"date":"2026-08-04T17:02:34Z","dateType":"Submitted","dateInformation":"v1"},{"date":"2026-08-05T01:06:34Z","dateType":"Updated","dateInformation":"v1"},{"date":"2026-08","dateType":"Available","dateInformation":"v1"}],"language":null,"types":{"schemaOrg":"CreativeWork","resourceTypeGeneral":"Preprint","citeproc":"article","bibtex":"misc","ris":"GEN","resourceType":"Article"},"relatedIdentifiers":[],"relatedItems":[],"sizes":[],"formats":[],"version":"1","rightsList":[{"rightsIdentifierScheme":"SPDX","rightsUri":"https://creativecommons.org/licenses/by/4.0/legalcode","schemeUri":"https://spdx.org/licenses/","rights":"Creative Commons Attribution 4.0 International","rightsIdentifier":"cc-by-4.0"}],"descriptions":[{"descriptionType":"Abstract","description":"Pre-pretraining language models (LMs) on symbolic data can accelerate and improve natural language acquisition. However, existing pre-pretraining tasks, such as Dyck and procedural algorithms, rely on narrow primitives that fail to capture the expressive capacity of natural language. Moreover, prior studies remain restricted to relatively small token budgets, offering limited insight into skill emergence and representational dynamics. To address these limitations, we propose logic pre-pretraining (Logic-PPT) as a principled initialization strategy, leveraging formal derivations to impart richer structural and linguistic biases. Formal derivations require abstract mechanisms that are central to natural language, simultaneously binding variables, connecting quantifiers and relational dependencies, and composing predicate-argument structures over long contexts. Scaling our evaluation to a 100B-token regime, logic pre-pretraining substantially accelerates skill acquisition in LMs, achieving 80\\% accuracy on linguistic tasks with 36B fewer tokens than standard initialization, and outperforming alternative pre-pretraining baselines. Mechanistically, formal derivations induce persistent structural reorganization, distinctively characterized by a lower-rank, spectrally concentrated representation space. Crucially, we show that this internal geometry enables improved model compressibility via pruning, matching the dense baseline performance even at $\\approx$33\\% sparsity."}],"geoLocations":[],"fundingReferences":[],"url":"https://arxiv.org/abs/2608.03930","contentUrl":null,"metadataVersion":0,"schemaVersion":"http://datacite.org/schema/kernel-4","source":"mds","isActive":true,"state":"findable","reason":null,"viewCount":0,"downloadCount":0,"referenceCount":0,"citationCount":0,"partCount":0,"partOfCount":0,"versionCount":0,"versionOfCount":0,"created":"2026-08-05T02:24:15Z","registered":"2026-08-05T02:24:16Z","published":null,"updated":"2026-08-05T02:24:16Z"},"relationships":{"client":{"data":{"id":"arxiv.content","type":"clients"}}}},{"id":"10.48550/arxiv.2608.03927","type":"dois","attributes":{"doi":"10.48550/arxiv.2608.03927","identifiers":[{"identifier":"2608.03927","identifierType":"arXiv"}],"creators":[{"nameType":"Personal","givenName":"Mattias","familyName":"Luber","name":"Luber, Mattias","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Timo","familyName":"Betz","name":"Betz, Timo","affiliation":[],"nameIdentifiers":[]}],"titles":[{"title":"A Physics-Flavored Transformer Network for Parametrizing Contraction Dynamics of Engineered Skeletal Muscle Tissues"}],"publisher":"arXiv","container":{},"publicationYear":2026,"subjects":[{"subject":"Machine Learning (cs.LG)","lang":"en","subjectScheme":"arXiv"},{"subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"}],"contributors":[],"dates":[{"date":"2026-08-04T16:59:30Z","dateType":"Submitted","dateInformation":"v1"},{"date":"2026-08-05T01:06:22Z","dateType":"Updated","dateInformation":"v1"},{"date":"2026-08","dateType":"Available","dateInformation":"v1"}],"language":null,"types":{"schemaOrg":"CreativeWork","resourceTypeGeneral":"Preprint","citeproc":"article","bibtex":"misc","ris":"GEN","resourceType":"Article"},"relatedIdentifiers":[],"relatedItems":[],"sizes":[],"formats":[],"version":"1","rightsList":[{"rightsUri":"http://arxiv.org/licenses/nonexclusive-distrib/1.0/","rights":"arXiv.org perpetual, non-exclusive license"}],"descriptions":[{"descriptionType":"Abstract","description":"Engineered Skeletal Muscle Tissues (ESMs) have become a key structure for biomedical disease modeling and pharmacological screening, yet their functional characterization often relies on simplistic metrics like peak force, discarding critical kinetic information. This is partially due to the high level of mathematical complexity which mechanistic models introduce to capture these dynamics. Hence, exactly the complexity prevents scalable application and widespread adaptation in the field. Here we present a Physics-Flavored Neural Network (PFNN) that automates the kinetic phenotyping of ESMs. Our architecture integrates a stretched-exponential physical model into a CNN-Transformer, enabling the extraction of physically meaningful parameters directly from force-time profiles. To address the scarcity of labeled biological data, we employ a hybrid training paradigm: the model develops a \"physical intuition\" on synthetic data before undergoing unsupervised self-alignment on unlabeled real-world measurements. Our results demonstrate that this physics-flavored approach achieves high-fidelity parameterization across diverse contractile phenotypes and cell lines, including Duchenne Muscular Dystrophy models. Our scalable, self-improving pipeline bridges the gap between idealized biophysics and noisy \\emph{in vitro} data, providing a robust tool for high-throughput biophysical research."}],"geoLocations":[],"fundingReferences":[],"url":"https://arxiv.org/abs/2608.03927","contentUrl":null,"metadataVersion":0,"schemaVersion":"http://datacite.org/schema/kernel-4","source":"mds","isActive":true,"state":"findable","reason":null,"viewCount":0,"downloadCount":0,"referenceCount":0,"citationCount":0,"partCount":0,"partOfCount":0,"versionCount":0,"versionOfCount":0,"created":"2026-08-05T02:24:11Z","registered":"2026-08-05T02:24:11Z","published":null,"updated":"2026-08-05T02:24:11Z"},"relationships":{"client":{"data":{"id":"arxiv.content","type":"clients"}}}},{"id":"10.48550/arxiv.2608.03926","type":"dois","attributes":{"doi":"10.48550/arxiv.2608.03926","identifiers":[{"identifier":"2608.03926","identifierType":"arXiv"}],"creators":[{"nameType":"Personal","givenName":"Mateusz","familyName":"Smendowski","name":"Smendowski, Mateusz","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Kamil","familyName":"Faber","name":"Faber, Kamil","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Piotr","familyName":"Nawrocki","name":"Nawrocki, Piotr","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Nathalie","familyName":"Japkowicz","name":"Japkowicz, Nathalie","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Roberto","familyName":"Corizzo","name":"Corizzo, Roberto","affiliation":[],"nameIdentifiers":[]}],"titles":[{"title":"PRISM: Powerful Time Series to Image (TS2I) Representations for Multivariate Anomaly Detection"}],"publisher":"arXiv","container":{},"publicationYear":2026,"subjects":[{"subject":"Machine Learning (cs.LG)","lang":"en","subjectScheme":"arXiv"},{"subject":"Artificial Intelligence (cs.AI)","lang":"en","subjectScheme":"arXiv"},{"subject":"Computer Vision and Pattern Recognition (cs.CV)","lang":"en","subjectScheme":"arXiv"},{"subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"}],"contributors":[],"dates":[{"date":"2026-08-04T16:59:28Z","dateType":"Submitted","dateInformation":"v1"},{"date":"2026-08-05T01:06:21Z","dateType":"Updated","dateInformation":"v1"},{"date":"2026-08","dateType":"Available","dateInformation":"v1"}],"language":null,"types":{"schemaOrg":"CreativeWork","resourceTypeGeneral":"Preprint","citeproc":"article","bibtex":"misc","ris":"GEN","resourceType":"Article"},"relatedIdentifiers":[],"relatedItems":[],"sizes":[],"formats":[],"version":"1","rightsList":[{"rightsIdentifierScheme":"SPDX","rightsUri":"https://creativecommons.org/licenses/by/4.0/legalcode","schemeUri":"https://spdx.org/licenses/","rights":"Creative Commons Attribution 4.0 International","rightsIdentifier":"cc-by-4.0"}],"descriptions":[{"descriptionType":"Abstract","description":"Time series anomaly detection (TSAD) underpins applications in predictive maintenance, finance, and cloud computing, however performance remains sensitive to representation choices, especially in multivariate settings. While transforming time series into images has shown success in forecasting and classification, it remains unclear how multivariate, high-dimensional series should be mapped to multi-channel images and whether vision backbones can match time-domain baselines in TSAD. We introduce PRISM, a plug-and-play meta-workflow enabling systematic construction and evaluation of image-based representations for multivariate TSAD. Our evaluation spanning over 7,000 experiments shows that well-designed PRISM configurations are competitive with 24 time-domain baselines, achieving the best VUS-PR on 10 of 14 datasets, with an average improvement of 41% over the best competing method on those datasets. Further, we identify channelization - how the channel dimension of multi-channel images is constructed - as a critical and previously understudied design dimension, and introduce MSM, a novel statistics-based scheme achieving 11-27% gains over PCA-based alternatives. Finally, ImageNet-pretrained encoders transfer effectively to TSAD, with frozen encoders retaining 92% of fine-tuned performance while training 1.8 times faster. Our code is available at: https://github.com/Smendowski/PRISM."}],"geoLocations":[],"fundingReferences":[],"url":"https://arxiv.org/abs/2608.03926","contentUrl":null,"metadataVersion":0,"schemaVersion":"http://datacite.org/schema/kernel-4","source":"mds","isActive":true,"state":"findable","reason":null,"viewCount":0,"downloadCount":0,"referenceCount":0,"citationCount":0,"partCount":0,"partOfCount":0,"versionCount":0,"versionOfCount":0,"created":"2026-08-05T02:24:09Z","registered":"2026-08-05T02:24:10Z","published":null,"updated":"2026-08-05T02:24:10Z"},"relationships":{"client":{"data":{"id":"arxiv.content","type":"clients"}}}},{"id":"10.48550/arxiv.2608.03925","type":"dois","attributes":{"doi":"10.48550/arxiv.2608.03925","identifiers":[{"identifier":"2608.03925","identifierType":"arXiv"}],"creators":[{"nameType":"Personal","givenName":"Robert","familyName":"Jarrow","name":"Jarrow, Robert","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Jayen","familyName":"Tan","name":"Tan, Jayen","affiliation":[],"nameIdentifiers":[]}],"titles":[{"title":"Option Pricing with Time-Changed Fractional Brownian Motion: A Fractional Variance Gamma Model"}],"publisher":"arXiv","container":{},"publicationYear":2026,"subjects":[{"subject":"Mathematical Finance (q-fin.MF)","lang":"en","subjectScheme":"arXiv"},{"subject":"Pricing of Securities (q-fin.PR)","lang":"en","subjectScheme":"arXiv"},{"subject":"FOS: Economics and business","subjectScheme":"Fields of Science and Technology (FOS)"}],"contributors":[],"dates":[{"date":"2026-08-04T16:57:12Z","dateType":"Submitted","dateInformation":"v1"},{"date":"2026-08-05T01:06:20Z","dateType":"Updated","dateInformation":"v1"},{"date":"2026-08","dateType":"Available","dateInformation":"v1"}],"language":null,"types":{"schemaOrg":"CreativeWork","resourceTypeGeneral":"Preprint","citeproc":"article","bibtex":"misc","ris":"GEN","resourceType":"Article"},"relatedIdentifiers":[],"relatedItems":[],"sizes":[],"formats":[],"version":"1","rightsList":[{"rightsIdentifierScheme":"SPDX","rightsUri":"https://creativecommons.org/licenses/by/4.0/legalcode","schemeUri":"https://spdx.org/licenses/","rights":"Creative Commons Attribution 4.0 International","rightsIdentifier":"cc-by-4.0"}],"descriptions":[{"descriptionType":"Abstract","description":"Fractional Brownian motion (fBm) exhibits attractive features for financial modeling, including long-range dependence, path roughness, and anomalous diffusion. However, its non-semimartingale nature precludes the use of conventional no-arbitrage approaches to option pricing. We address this limitation by introducing a time-changed fBm, obtained by evaluating fBm at stochastic gamma activity time, where activity time represents cumulative executed trading time. The resulting process retains the defining properties of fBm while recovering the semimartingale structure. Building on this construction, we develop the fractional Variance Gamma (fVG) model and propose a generalized method of moments (GMM) estimation procedure for option pricing. An empirical analysis of the S\\\u0026amp;P 500 yields an estimated Hurst exponent of approximately 0.45, consistent with mildly sublinear temporal scaling of return moments."}],"geoLocations":[],"fundingReferences":[],"url":"https://arxiv.org/abs/2608.03925","contentUrl":null,"metadataVersion":0,"schemaVersion":"http://datacite.org/schema/kernel-4","source":"mds","isActive":true,"state":"findable","reason":null,"viewCount":0,"downloadCount":0,"referenceCount":0,"citationCount":0,"partCount":0,"partOfCount":0,"versionCount":0,"versionOfCount":0,"created":"2026-08-05T02:24:08Z","registered":"2026-08-05T02:24:09Z","published":null,"updated":"2026-08-05T02:24:09Z"},"relationships":{"client":{"data":{"id":"arxiv.content","type":"clients"}}}},{"id":"10.48550/arxiv.2608.03924","type":"dois","attributes":{"doi":"10.48550/arxiv.2608.03924","identifiers":[{"identifier":"2608.03924","identifierType":"arXiv"}],"creators":[{"nameType":"Personal","givenName":"Yitong","familyName":"Chen","name":"Chen, Yitong","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Zezheng","familyName":"Huai","name":"Huai, Zezheng","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Sixian","familyName":"Li","name":"Li, Sixian","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Yubang","familyName":"Wang","name":"Wang, Yubang","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Haozhe","familyName":"Zhang","name":"Zhang, Haozhe","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Yifei","familyName":"Zhang","name":"Zhang, Yifei","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Hechang","familyName":"Chen","name":"Chen, Hechang","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Jingjing","familyName":"Gong","name":"Gong, Jingjing","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Yu-Gang","familyName":"Jiang","name":"Jiang, Yu-Gang","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Xipeng","familyName":"Qiu","name":"Qiu, Xipeng","affiliation":[],"nameIdentifiers":[]}],"titles":[{"title":"ETA: A New Agentic Paradigm for Embodied Tasks"}],"publisher":"arXiv","container":{},"publicationYear":2026,"subjects":[{"subject":"Robotics (cs.RO)","lang":"en","subjectScheme":"arXiv"},{"subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"}],"contributors":[],"dates":[{"date":"2026-08-04T16:56:09Z","dateType":"Submitted","dateInformation":"v1"},{"date":"2026-08-05T01:06:18Z","dateType":"Updated","dateInformation":"v1"},{"date":"2026-08","dateType":"Available","dateInformation":"v1"}],"language":null,"types":{"schemaOrg":"CreativeWork","resourceTypeGeneral":"Preprint","citeproc":"article","bibtex":"misc","ris":"GEN","resourceType":"Article"},"relatedIdentifiers":[],"relatedItems":[],"sizes":[],"formats":[],"version":"1","rightsList":[{"rightsUri":"http://arxiv.org/licenses/nonexclusive-distrib/1.0/","rights":"arXiv.org perpetual, non-exclusive license"}],"descriptions":[{"descriptionType":"Abstract","description":"When will robots have their ChatGPT moment? Such a breakthrough requires a general-purpose robot that can handle unfamiliar tasks in unfamiliar environments, remain controllable over long interactions, and learn from experience.\n Today's embodied systems largely follow an end-to-end observation-to-action path. Despite rapid progress, they remain far from this goal: their generalization depends heavily on the coverage of robot training data, while long task execution remains difficult to control and inspect. To realize this goal, we introduce the Embodied Task Agent (ETA), a new paradigm for extending digital agents into the physical world, and release OpenETA as its open-source implementation. ETA centers the robot around a Planner that chooses one Tool call at a time, an Interface that controls execution, and a World that returns the result and a fresh observation. This loop allows the agent to verify outcomes, adapt its plan, and turn successful and failed interactions into reusable experience. OpenETA provides replaceable Planners, composable Tools and Skills, auditable memory, replayable trajectories, and common interfaces for simulation and real robots. For Codex, OpenETA can operate as a lightweight plugin that exposes only observe, mark_point, and move_to."}],"geoLocations":[],"fundingReferences":[],"url":"https://arxiv.org/abs/2608.03924","contentUrl":null,"metadataVersion":0,"schemaVersion":"http://datacite.org/schema/kernel-4","source":"mds","isActive":true,"state":"findable","reason":null,"viewCount":0,"downloadCount":0,"referenceCount":0,"citationCount":0,"partCount":0,"partOfCount":0,"versionCount":0,"versionOfCount":0,"created":"2026-08-05T02:24:07Z","registered":"2026-08-05T02:24:07Z","published":null,"updated":"2026-08-05T02:24:07Z"},"relationships":{"client":{"data":{"id":"arxiv.content","type":"clients"}}}},{"id":"10.48550/arxiv.2608.03923","type":"dois","attributes":{"doi":"10.48550/arxiv.2608.03923","identifiers":[{"identifier":"2608.03923","identifierType":"arXiv"}],"creators":[{"nameType":"Personal","givenName":"Lu","familyName":"Gan","name":"Gan, Lu","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Hanyu","familyName":"Yan","name":"Yan, Hanyu","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Chaofeng","familyName":"Chen","name":"Chen, Chaofeng","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Junqi","familyName":"Hu","name":"Hu, Junqi","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Dan","familyName":"Zeng","name":"Zeng, Dan","affiliation":[],"nameIdentifiers":[]}],"titles":[{"title":"GeoMAR: Unleashing Geometrically Aligned Features for Masked Autoregressive Blind Face Restoration"}],"publisher":"arXiv","container":{},"publicationYear":2026,"subjects":[{"subject":"Computer Vision and Pattern Recognition (cs.CV)","lang":"en","subjectScheme":"arXiv"},{"subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"}],"contributors":[],"dates":[{"date":"2026-08-04T16:55:49Z","dateType":"Submitted","dateInformation":"v1"},{"date":"2026-08-05T01:06:15Z","dateType":"Updated","dateInformation":"v1"},{"date":"2026-08","dateType":"Available","dateInformation":"v1"}],"language":null,"types":{"schemaOrg":"CreativeWork","resourceTypeGeneral":"Preprint","citeproc":"article","bibtex":"misc","ris":"GEN","resourceType":"Article"},"relatedIdentifiers":[],"relatedItems":[],"sizes":[],"formats":[],"version":"1","rightsList":[{"rightsUri":"http://arxiv.org/licenses/nonexclusive-distrib/1.0/","rights":"arXiv.org perpetual, non-exclusive license"}],"descriptions":[{"descriptionType":"Abstract","description":"Codebook-based blind face restoration (BFR) often suffers from ambiguous conditioning features and a fragile prediction mechanism under severe degradation. To address these challenges, we propose GeoMAR, a framework designed to unleash geometrically aligned features with masked autoregressive (MAR) refinement for robust face restoration. For feature conditioning, we introduce a dual-input extraction pipeline to extract component-based geometric descriptions with explicit, spatially faithful anchors. These textual priors are integrated with low-quality (LQ) features via an Aligned Geometric Priors Injector, which employs a KV-Q exchange strategy to generate geometrically aligned features. For prediction mechanism, we reformulate the one-step mapping into a multi-step MAR process. This coarse-to-fine generation progressively refines complex facial regions based on increasingly reliable context. Experiments on one synthetic and three real-world benchmarks demonstrate that GeoMAR achieves highly competitive perceptual quality and coherent visual structures compared with existing methods. The code is available at https://github.com/BRL-SYSU/GeoMAR.git."}],"geoLocations":[],"fundingReferences":[],"url":"https://arxiv.org/abs/2608.03923","contentUrl":null,"metadataVersion":0,"schemaVersion":"http://datacite.org/schema/kernel-4","source":"mds","isActive":true,"state":"findable","reason":null,"viewCount":0,"downloadCount":0,"referenceCount":0,"citationCount":0,"partCount":0,"partOfCount":0,"versionCount":0,"versionOfCount":0,"created":"2026-08-05T02:24:05Z","registered":"2026-08-05T02:24:06Z","published":null,"updated":"2026-08-05T02:24:06Z"},"relationships":{"client":{"data":{"id":"arxiv.content","type":"clients"}}}},{"id":"10.48550/arxiv.2608.03922","type":"dois","attributes":{"doi":"10.48550/arxiv.2608.03922","identifiers":[{"identifier":"2608.03922","identifierType":"arXiv"}],"creators":[{"nameType":"Personal","givenName":"Egor","familyName":"Kosov","name":"Kosov, Egor","affiliation":[],"nameIdentifiers":[]}],"titles":[{"title":"Absolute continuity of two-dimensional polynomial random vectors"}],"publisher":"arXiv","container":{},"publicationYear":2026,"subjects":[{"subject":"Probability (math.PR)","lang":"en","subjectScheme":"arXiv"},{"subject":"FOS: Mathematics","subjectScheme":"Fields of Science and Technology (FOS)"}],"contributors":[],"dates":[{"date":"2026-08-04T16:55:46Z","dateType":"Submitted","dateInformation":"v1"},{"date":"2026-08-05T01:06:14Z","dateType":"Updated","dateInformation":"v1"},{"date":"2026-08","dateType":"Available","dateInformation":"v1"}],"language":null,"types":{"schemaOrg":"CreativeWork","resourceTypeGeneral":"Preprint","citeproc":"article","bibtex":"misc","ris":"GEN","resourceType":"Article"},"relatedIdentifiers":[],"relatedItems":[],"sizes":[],"formats":[],"version":"1","rightsList":[{"rightsUri":"http://arxiv.org/licenses/nonexclusive-distrib/1.0/","rights":"arXiv.org perpetual, non-exclusive license"}],"descriptions":[{"descriptionType":"Abstract","description":"Let $X=\\{X_j\\}_{j=1}^\\infty$ be a sequence of independent random variables whose densities and moments of order $2d$ are uniformly bounded. For a random vector $f(X)=(f_1(X),f_2(X))$ whose components are polynomial functionals of degree at most $d$, we prove that \\[ [[f]]_{μ,\\infty}^{\\frac1{2d-1}}μ(f\\in A) \\le C\\bigl(λ_2(A)\\bigr)^{\\frac1{2d-1}} \\] for every Borel set $A\\subset\\mathbb R^2$, where $C$ depends only on $d$ and the uniform density and moment bounds, and $λ_2$ denotes the Lebesgue measure on $\\mathbb R^2$. Here $[[f]]_{μ,\\infty}$ measures the failure of proportionality of the highest-order orthogonal-chaos components of $f_1$ and $f_2$ with respect to the law $μ$ of $X$. Consequently, whenever these components are not proportional, the law of $f$ admits a density in the weak Lorentz space $L^{\\frac{2d-1}{2d-2},\\infty}(\\mathbb R^2)$. This recovers the dichotomy established by Nualart and Tudor for two-dimensional Wiener chaos vectors and extends it beyond the Gaussian setting.\n We also obtain the lower bound \\[ \\int_{\\mathbb R^\\infty}Δ_f\\,dμ\\ge C[[f]]_{μ,\\infty}^2, \\] where $Δ_f$ is the determinant of the Gram matrix of $\\nabla f_1$ and $\\nabla f_2$. In the special case of Gaussian measures, this gives a relaxed version of the estimate conjectured by Nourdin, Nualart, and Poly."}],"geoLocations":[],"fundingReferences":[],"url":"https://arxiv.org/abs/2608.03922","contentUrl":null,"metadataVersion":0,"schemaVersion":"http://datacite.org/schema/kernel-4","source":"mds","isActive":true,"state":"findable","reason":null,"viewCount":0,"downloadCount":0,"referenceCount":0,"citationCount":0,"partCount":0,"partOfCount":0,"versionCount":0,"versionOfCount":0,"created":"2026-08-05T02:24:04Z","registered":"2026-08-05T02:24:05Z","published":null,"updated":"2026-08-05T02:24:05Z"},"relationships":{"client":{"data":{"id":"arxiv.content","type":"clients"}}}},{"id":"10.48550/arxiv.2608.03920","type":"dois","attributes":{"doi":"10.48550/arxiv.2608.03920","identifiers":[{"identifier":"2608.03920","identifierType":"arXiv"}],"creators":[{"nameType":"Personal","givenName":"Zixun","familyName":"Guo","name":"Guo, Zixun","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Simon","familyName":"Dixon","name":"Dixon, Simon","affiliation":[],"nameIdentifiers":[]}],"titles":[{"title":"Equivariant Music Transformer"}],"publisher":"arXiv","container":{},"publicationYear":2026,"subjects":[{"subject":"Sound (cs.SD)","lang":"en","subjectScheme":"arXiv"},{"subject":"Artificial Intelligence (cs.AI)","lang":"en","subjectScheme":"arXiv"},{"subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"}],"contributors":[],"dates":[{"date":"2026-08-04T16:51:58Z","dateType":"Submitted","dateInformation":"v1"},{"date":"2026-08-05T01:05:55Z","dateType":"Updated","dateInformation":"v1"},{"date":"2026-08","dateType":"Available","dateInformation":"v1"}],"language":null,"types":{"schemaOrg":"CreativeWork","resourceTypeGeneral":"Preprint","citeproc":"article","bibtex":"misc","ris":"GEN","resourceType":"Article"},"relatedIdentifiers":[],"relatedItems":[],"sizes":[],"formats":[],"version":"1","rightsList":[{"rightsIdentifierScheme":"SPDX","rightsUri":"https://creativecommons.org/licenses/by/4.0/legalcode","schemeUri":"https://spdx.org/licenses/","rights":"Creative Commons Attribution 4.0 International","rightsIdentifier":"cc-by-4.0"}],"descriptions":[{"descriptionType":"Abstract","description":"Humans recognize a musical passage even when it is shifted in time or transposed in pitch, indicating a notion of equivariance in the representation space. Our analysis, however, shows that standard music transformers map such time-shifted or pitch-transposed inputs onto uncorrelated representations: these models become progressively less equivariant as they scale in size or train longer. This suggests that in standard music transformers, additional model capacity is allocated to memorizing absolute patterns rather than capturing shared musical structures. In this paper, we propose the Equivariant Music Transformer (EMT), which enforces equivariance through self-distillation by jointly optimizing a next-token-prediction and an auxiliary equivariance regularization loss. We find that the additional equivariance loss acts as a beneficial regularizer, simultaneously improving next-token prediction and producing equivariant latent representations. Through both objective and subjective evaluations, EMT demonstrates superior equivariance and generative capability compared to data augmentation, feature engineering, and state-of-the-art (SOTA) baselines. More broadly, our findings reveal that standard language modeling methods alone do not capture music's translational symmetries, and dedicated inductive biases are required to produce better music representations. The code, weights and demos are available online."}],"geoLocations":[],"fundingReferences":[],"url":"https://arxiv.org/abs/2608.03920","contentUrl":null,"metadataVersion":0,"schemaVersion":"http://datacite.org/schema/kernel-4","source":"mds","isActive":true,"state":"findable","reason":null,"viewCount":0,"downloadCount":0,"referenceCount":0,"citationCount":0,"partCount":0,"partOfCount":0,"versionCount":0,"versionOfCount":0,"created":"2026-08-05T02:24:01Z","registered":"2026-08-05T02:24:02Z","published":null,"updated":"2026-08-05T02:24:02Z"},"relationships":{"client":{"data":{"id":"arxiv.content","type":"clients"}}}},{"id":"10.48550/arxiv.2608.03919","type":"dois","attributes":{"doi":"10.48550/arxiv.2608.03919","identifiers":[{"identifier":"2608.03919","identifierType":"arXiv"}],"creators":[{"nameType":"Personal","givenName":"Peng","familyName":"Xia","name":"Xia, Peng","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Junbiao","familyName":"Pang","name":"Pang, Junbiao","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Zheng","familyName":"Huang","name":"Huang, Zheng","affiliation":[],"nameIdentifiers":[]}],"titles":[{"title":"Low-Dimensional High-Leverage Subspace Optimization: Beyond Full-Parameter Coupled Training for Neural Network Quantization"}],"publisher":"arXiv","container":{},"publicationYear":2026,"subjects":[{"subject":"Computer Vision and Pattern Recognition (cs.CV)","lang":"en","subjectScheme":"arXiv"},{"subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"}],"contributors":[],"dates":[{"date":"2026-08-04T16:50:04Z","dateType":"Submitted","dateInformation":"v1"},{"date":"2026-08-05T01:05:50Z","dateType":"Updated","dateInformation":"v1"},{"date":"2026-08","dateType":"Available","dateInformation":"v1"}],"language":null,"types":{"schemaOrg":"CreativeWork","resourceTypeGeneral":"Preprint","citeproc":"article","bibtex":"misc","ris":"GEN","resourceType":"Article"},"relatedIdentifiers":[],"relatedItems":[],"sizes":[],"formats":[],"version":"1","rightsList":[{"rightsUri":"http://arxiv.org/licenses/nonexclusive-distrib/1.0/","rights":"arXiv.org perpetual, non-exclusive license"}],"descriptions":[{"descriptionType":"Abstract","description":"Low-bit quantization suffers severe accuracy degradation on compact networks, rooted in the dominant full-parameter coupled training paradigm that ignores parameter subspace heterogeneity. Their limited feature redundancy leaves little room to absorb quantization errors. Conventional pipelines adopt monolithic optimization: PTQ reconstructs fixed pretrained models without improving inherent quantization friendliness; QAT updates all parameters jointly, suffering from gradient coupling between backbone weights and calibration parameters. In this paper, we identify normalization affine parameters as a low-dimensional high-leverage subspace dominating quantization robustness, and propose Normalization Affine Preconditioning (NAP) for targeted subspace optimization. For PTQ, NAP freezes backbone weights and fine-tunes only affine parameters under the target fake-quantization graph on full-precision models, proactively boosting quantization friendliness before downstream reconstruction. For QAT, we introduce an alternating QAT-NAP schema that decouples feature learning and numerical calibration, breaking the performance ceiling of saturated joint training. Theoretical analysis confirms BN affine parameters fully cancel the channel-wise affine component of quantization distortion, while nonlinear rounding and clipping residuals form the irreducible error boundary; distillation-guided NAP acts as directional flatness optimization, projecting teacher-student logit mismatch onto the restricted subspace. Experiments on ImageNet and CIFAR-100 show NAP recovers severely collapsed low-bit quantization, consistently boosts reconstruction-based PTQ, and outperforms saturated full-parameter QAT with negligible tuning cost. This work reveals the principle of targeted low-dimensional subspace optimization, offering a new perspective beyond full-parameter coupled training for efficient deep learning."},{"descriptionType":"Other","description":"9 pages, 2 figures, 7 tables"}],"geoLocations":[],"fundingReferences":[],"url":"https://arxiv.org/abs/2608.03919","contentUrl":null,"metadataVersion":0,"schemaVersion":"http://datacite.org/schema/kernel-4","source":"mds","isActive":true,"state":"findable","reason":null,"viewCount":0,"downloadCount":0,"referenceCount":0,"citationCount":0,"partCount":0,"partOfCount":0,"versionCount":0,"versionOfCount":0,"created":"2026-08-05T02:24:00Z","registered":"2026-08-05T02:24:01Z","published":null,"updated":"2026-08-05T02:24:01Z"},"relationships":{"client":{"data":{"id":"arxiv.content","type":"clients"}}}},{"id":"10.48550/arxiv.2608.03918","type":"dois","attributes":{"doi":"10.48550/arxiv.2608.03918","identifiers":[{"identifier":"2608.03918","identifierType":"arXiv"}],"creators":[{"nameType":"Personal","givenName":"Ke","familyName":"Li","name":"Li, Ke","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Jiayu","familyName":"Chen","name":"Chen, Jiayu","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Maoliang","familyName":"Li","name":"Li, Maoliang","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Zihao","familyName":"Zheng","name":"Zheng, Zihao","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Hailong","familyName":"Zou","name":"Zou, Hailong","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Hengyi","familyName":"Zhang","name":"Zhang, Hengyi","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Xuanzhe","familyName":"Liu","name":"Liu, Xuanzhe","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Xiang","familyName":"Chen","name":"Chen, Xiang","affiliation":[],"nameIdentifiers":[]}],"titles":[{"title":"When and Where to Look: Adaptive Visual Evidence Scheduling for Efficient Long Video Understanding"}],"publisher":"arXiv","container":{},"publicationYear":2026,"subjects":[{"subject":"Computer Vision and Pattern Recognition (cs.CV)","lang":"en","subjectScheme":"arXiv"},{"subject":"Artificial Intelligence (cs.AI)","lang":"en","subjectScheme":"arXiv"},{"subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"}],"contributors":[],"dates":[{"date":"2026-08-04T16:49:53Z","dateType":"Submitted","dateInformation":"v1"},{"date":"2026-08-05T01:05:48Z","dateType":"Updated","dateInformation":"v1"},{"date":"2026-08","dateType":"Available","dateInformation":"v1"}],"language":null,"types":{"schemaOrg":"CreativeWork","resourceTypeGeneral":"Preprint","citeproc":"article","bibtex":"misc","ris":"GEN","resourceType":"Article"},"relatedIdentifiers":[],"relatedItems":[],"sizes":[],"formats":[],"version":"1","rightsList":[{"rightsIdentifierScheme":"SPDX","rightsUri":"https://creativecommons.org/licenses/by/4.0/legalcode","schemeUri":"https://spdx.org/licenses/","rights":"Creative Commons Attribution 4.0 International","rightsIdentifier":"cc-by-4.0"}],"descriptions":[{"descriptionType":"Abstract","description":"Efficient long-video understanding requires vision--language models (VLMs) to reason over a small number of frames selected as sparse visual evidence. Existing relevance-based methods rely on static one-shot selection with fixed frame budgets and candidate pools, while agent-based schedulers achieve adaptivity through costly multi-round reasoning and interactive search. We propose EcoFrame, a training-free framework for low-overhead query-adaptive visual evidence scheduling. EcoFrame leverages the VLM's inference feedback to determine when to increase the frame budget and where to search for additional candidate evidence. Specifically, entropy-gated budget scheduling uses output uncertainty to stop early when the current evidence is sufficient or progressively expand the frame budget otherwise. Meanwhile, attention-guided candidate proposal converts frame-level attention into a temporal prior, enabling dense local search in informative regions while preserving global coverage when attention is diffuse. Experiments on Video-MME, LongVideoBench, and MLVU demonstrate that EcoFrame achieves a better accuracy--efficiency trade-off across multiple VLM backbones. On Qwen2.5-VL, EcoFrame achieves an average accuracy of 64.4, surpassing BOLT at 63.5, while providing a $1.85\\times$ speedup over AKS and BOLT. Compared with the agent-based A.I.R., EcoFrame maintains comparable accuracy with up to a $13.5\\times$ inference speedup. Code will be available at https://github.com/AK-DREAM/EcoFrame."}],"geoLocations":[],"fundingReferences":[],"url":"https://arxiv.org/abs/2608.03918","contentUrl":null,"metadataVersion":0,"schemaVersion":"http://datacite.org/schema/kernel-4","source":"mds","isActive":true,"state":"findable","reason":null,"viewCount":0,"downloadCount":0,"referenceCount":0,"citationCount":0,"partCount":0,"partOfCount":0,"versionCount":0,"versionOfCount":0,"created":"2026-08-05T02:23:59Z","registered":"2026-08-05T02:23:59Z","published":null,"updated":"2026-08-05T02:23:59Z"},"relationships":{"client":{"data":{"id":"arxiv.content","type":"clients"}}}},{"id":"10.48550/arxiv.2608.03917","type":"dois","attributes":{"doi":"10.48550/arxiv.2608.03917","identifiers":[{"identifier":"2608.03917","identifierType":"arXiv"}],"creators":[{"nameType":"Personal","givenName":"Jose M.","familyName":"Álvarez","name":"Álvarez, Jose M.","affiliation":[],"nameIdentifiers":[]}],"titles":[{"title":"Implementing Causal Perception: Competing SCMs and Situated Fairness"}],"publisher":"arXiv","container":{},"publicationYear":2026,"subjects":[{"subject":"Artificial Intelligence (cs.AI)","lang":"en","subjectScheme":"arXiv"},{"subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"}],"contributors":[],"dates":[{"date":"2026-08-04T16:48:19Z","dateType":"Submitted","dateInformation":"v1"},{"date":"2026-08-05T01:05:46Z","dateType":"Updated","dateInformation":"v1"},{"date":"2026-08","dateType":"Available","dateInformation":"v1"}],"language":null,"types":{"schemaOrg":"CreativeWork","resourceTypeGeneral":"Preprint","citeproc":"article","bibtex":"misc","ris":"GEN","resourceType":"Article"},"relatedIdentifiers":[],"relatedItems":[],"sizes":[],"formats":[],"version":"1","rightsList":[{"rightsIdentifierScheme":"SPDX","rightsUri":"https://creativecommons.org/licenses/by/4.0/legalcode","schemeUri":"https://spdx.org/licenses/","rights":"Creative Commons Attribution 4.0 International","rightsIdentifier":"cc-by-4.0"}],"descriptions":[{"descriptionType":"Abstract","description":"Causal perception occurs when agents with competing Structural Causal Models (SCMs) of the same system infer different probability distributions, including the hypothetical distributions implied by each agent's SCM under the same set of interventions. It shapes how agents reason about the system and how they perceive its fairness. Causal perception is a promising probabilistic framework, but it has remained purely theoretical. This work provides the first implementation of the causal perception framework of Álvarez and Ruggieri (2025). We operationalize structural (agents disagree on the causal graph) and parametrical (agents agree on the causal graph but disagree on its weights) causal perception. We design algorithms for computing interventional and counterfactual distributions and propose suitable distance measures to quantify the disagreement. Using the German Credit dataset, we illustrate how causal perception affects accuracy and fairness in a multi-expert decision setting. We show that the perception verdict is sensitive to the choice of distance metric and threshold. We also show that causal perception changes fairness assessments and threshold-based decisions. Bias proves situated with respect to the agent's SCM, demonstrating that competing worldviews in fairness problems cannot be ignored."}],"geoLocations":[],"fundingReferences":[],"url":"https://arxiv.org/abs/2608.03917","contentUrl":null,"metadataVersion":0,"schemaVersion":"http://datacite.org/schema/kernel-4","source":"mds","isActive":true,"state":"findable","reason":null,"viewCount":0,"downloadCount":0,"referenceCount":0,"citationCount":0,"partCount":0,"partOfCount":0,"versionCount":0,"versionOfCount":0,"created":"2026-08-05T02:23:57Z","registered":"2026-08-05T02:23:58Z","published":null,"updated":"2026-08-05T02:23:58Z"},"relationships":{"client":{"data":{"id":"arxiv.content","type":"clients"}}}},{"id":"10.48550/arxiv.2608.03916","type":"dois","attributes":{"doi":"10.48550/arxiv.2608.03916","identifiers":[{"identifier":"2608.03916","identifierType":"arXiv"}],"creators":[{"nameType":"Personal","givenName":"Bartolo","familyName":"Dazzini","name":"Dazzini, Bartolo","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Giovanni","familyName":"Conforti","name":"Conforti, Giovanni","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Alain","familyName":"Durmus","name":"Durmus, Alain","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Aram-Alexandre","familyName":"Pooladian","name":"Pooladian, Aram-Alexandre","affiliation":[],"nameIdentifiers":[]}],"titles":[{"title":"Trajectory inference via Acceleration Matching"}],"publisher":"arXiv","container":{},"publicationYear":2026,"subjects":[{"subject":"Machine Learning (cs.LG)","lang":"en","subjectScheme":"arXiv"},{"subject":"Optimization and Control (math.OC)","lang":"en","subjectScheme":"arXiv"},{"subject":"Machine Learning (stat.ML)","lang":"en","subjectScheme":"arXiv"},{"subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"},{"subject":"FOS: Mathematics","subjectScheme":"Fields of Science and Technology (FOS)"}],"contributors":[],"dates":[{"date":"2026-08-04T16:42:04Z","dateType":"Submitted","dateInformation":"v1"},{"date":"2026-08-05T01:05:32Z","dateType":"Updated","dateInformation":"v1"},{"date":"2026-08","dateType":"Available","dateInformation":"v1"}],"language":null,"types":{"schemaOrg":"CreativeWork","resourceTypeGeneral":"Preprint","citeproc":"article","bibtex":"misc","ris":"GEN","resourceType":"Article"},"relatedIdentifiers":[],"relatedItems":[],"sizes":[],"formats":[],"version":"1","rightsList":[{"rightsIdentifierScheme":"SPDX","rightsUri":"https://creativecommons.org/licenses/by/4.0/legalcode","schemeUri":"https://spdx.org/licenses/","rights":"Creative Commons Attribution 4.0 International","rightsIdentifier":"cc-by-4.0"}],"descriptions":[{"descriptionType":"Abstract","description":"Trajectory inference is a fundamental problem in many scientific domains: given a collection of unpaired snapshots of observations at discrete time points, the goal is to generate smooth trajectories that best resemble and interpolate the data. Existing algorithms exhibit computational challenges: they either rely on preprocessing subroutines to enforce smoothness or on simulation-based training objectives, both of which can be expensive. In order to overcome these limitations, we propose a new algorithm called Acceleration Matching (\\texttt{AM}). Our approach consists of lifting the original interpolation problem to phase space and then regressing onto an explicit conditional acceleration field that induces random, smooth trajectories that agree with the prescribed marginals. Importantly, our resulting training algorithm only requires positional data, avoids trajectory simulation during training, and is devoid of expensive preprocessing. We provide ample numerical evidence suggesting that \\texttt{AM} is competitive with or superior to existing algorithms on several benchmark problems from the existing literature."},{"descriptionType":"Other","description":"Comments welcome!"}],"geoLocations":[],"fundingReferences":[],"url":"https://arxiv.org/abs/2608.03916","contentUrl":null,"metadataVersion":0,"schemaVersion":"http://datacite.org/schema/kernel-4","source":"mds","isActive":true,"state":"findable","reason":null,"viewCount":0,"downloadCount":0,"referenceCount":0,"citationCount":2,"partCount":0,"partOfCount":0,"versionCount":0,"versionOfCount":0,"created":"2026-08-05T02:23:56Z","registered":"2026-08-05T02:23:57Z","published":null,"updated":"2026-08-05T02:23:57Z"},"relationships":{"client":{"data":{"id":"arxiv.content","type":"clients"}}}},{"id":"10.48550/arxiv.2608.03915","type":"dois","attributes":{"doi":"10.48550/arxiv.2608.03915","identifiers":[{"identifier":"2608.03915","identifierType":"arXiv"}],"creators":[{"nameType":"Personal","givenName":"Luke","familyName":"Baker","name":"Baker, Luke","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Xuemei","familyName":"Li","name":"Li, Xuemei","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Jason","familyName":"Murphy","name":"Murphy, Jason","affiliation":[],"nameIdentifiers":[]}],"titles":[{"title":"Approximate traveling waves for the focusing NLS with an external potential"}],"publisher":"arXiv","container":{},"publicationYear":2026,"subjects":[{"subject":"Analysis of PDEs (math.AP)","lang":"en","subjectScheme":"arXiv"},{"subject":"FOS: Mathematics","subjectScheme":"Fields of Science and Technology (FOS)"}],"contributors":[],"dates":[{"date":"2026-08-04T16:41:50Z","dateType":"Submitted","dateInformation":"v1"},{"date":"2026-08-05T01:05:31Z","dateType":"Updated","dateInformation":"v1"},{"date":"2026-08","dateType":"Available","dateInformation":"v1"}],"language":null,"types":{"schemaOrg":"CreativeWork","resourceTypeGeneral":"Preprint","citeproc":"article","bibtex":"misc","ris":"GEN","resourceType":"Article"},"relatedIdentifiers":[],"relatedItems":[],"sizes":[],"formats":[],"version":"1","rightsList":[{"rightsUri":"http://arxiv.org/licenses/nonexclusive-distrib/1.0/","rights":"arXiv.org perpetual, non-exclusive license"}],"descriptions":[{"descriptionType":"Abstract","description":"We construct approximate traveling wave solutions for the $3d$ focusing cubic NLS perturbed by a rapidly decaying external potential. As an application, we demonstrate that there exists a forward-global, $H^1$ bounded, nonscattering solution at any mass-energy higher than the ground state threshold for the unperturbed equation."},{"descriptionType":"Other","description":"20 pages"}],"geoLocations":[],"fundingReferences":[],"url":"https://arxiv.org/abs/2608.03915","contentUrl":null,"metadataVersion":0,"schemaVersion":"http://datacite.org/schema/kernel-4","source":"mds","isActive":true,"state":"findable","reason":null,"viewCount":0,"downloadCount":0,"referenceCount":0,"citationCount":0,"partCount":0,"partOfCount":0,"versionCount":0,"versionOfCount":0,"created":"2026-08-05T02:23:54Z","registered":"2026-08-05T02:23:55Z","published":null,"updated":"2026-08-05T02:23:55Z"},"relationships":{"client":{"data":{"id":"arxiv.content","type":"clients"}}}},{"id":"10.48550/arxiv.2608.03914","type":"dois","attributes":{"doi":"10.48550/arxiv.2608.03914","identifiers":[{"identifier":"2608.03914","identifierType":"arXiv"}],"creators":[{"nameType":"Personal","givenName":"Carlos O.","familyName":"Lousto","name":"Lousto, Carlos O.","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Harsh","familyName":"Prajapati","name":"Prajapati, Harsh","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Ezequiel","familyName":"Zubieta","name":"Zubieta, Ezequiel","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Susana B. Araujo","familyName":"Furlan","name":"Furlan, Susana B. Araujo","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Guillermo","familyName":"Gancio","name":"Gancio, Guillermo","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Joaquín","familyName":"Pelle","name":"Pelle, Joaquín","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Gustavo E.","familyName":"Romero","name":"Romero, Gustavo E.","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Federico","familyName":"García","name":"García, Federico","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Santiago","familyName":"del Palacio","name":"del Palacio, Santiago","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Nathan","familyName":"Cahill","name":"Cahill, Nathan","affiliation":[],"nameIdentifiers":[]}],"titles":[{"title":"First fast radio burst search campaign at the Argentine Institute of Radio Astronomy"}],"publisher":"arXiv","container":{},"publicationYear":2026,"subjects":[{"subject":"High Energy Astrophysical Phenomena (astro-ph.HE)","lang":"en","subjectScheme":"arXiv"},{"subject":"Instrumentation and Methods for Astrophysics (astro-ph.IM)","lang":"en","subjectScheme":"arXiv"},{"subject":"FOS: Physical sciences","subjectScheme":"Fields of Science and Technology (FOS)"}],"contributors":[],"dates":[{"date":"2026-08-04T16:41:43Z","dateType":"Submitted","dateInformation":"v1"},{"date":"2026-08-05T01:05:30Z","dateType":"Updated","dateInformation":"v1"},{"date":"2026-08","dateType":"Available","dateInformation":"v1"}],"language":null,"types":{"schemaOrg":"CreativeWork","resourceTypeGeneral":"Preprint","citeproc":"article","bibtex":"misc","ris":"GEN","resourceType":"Article"},"relatedIdentifiers":[],"relatedItems":[],"sizes":[],"formats":[],"version":"1","rightsList":[{"rightsUri":"http://arxiv.org/licenses/nonexclusive-distrib/1.0/","rights":"arXiv.org perpetual, non-exclusive license"}],"descriptions":[{"descriptionType":"Abstract","description":"Fast radio bursts (FRBs) are intense millisecond-duration radio transients of extragalactic origin whose physical nature remains under active investigation, and which also serve as probes of the intergalactic medium. We report on the first FRB search campaign carried out at the Argentine Institute of Radio Astronomy (IAR) between December 2024 and March 2026, targeting nearby galaxy superclusters in the southern sky. We observed fields in the Ophiuchus, Shapley, and Sculptor/Phoenix supercluster regions with one of the two 30~m antennas of the IAR, using a ROACH-based backend with 400~MHz of bandwidth centred at 1400~MHz and a time resolution of 41--82~$μ$s, for a total net observing time of 212~h. The data were searched for dispersed single pulses with \\texttt{PRESTO} in the dispersion measure range $100 \\leq \\mathrm{DM} \\leq 500$, and candidates were classified with the FETCH machine learning classifier. The pipeline was validated on archival Parkes data containing known FRBs and on synthetic bursts injected into IAR observations. One FRB candidate, FRB~20251018, was identified on 18 October 2025 in an observation pointed towards the galaxy cluster A2870, in the Phoenix supercluster, with a dispersion measure of $243$, a signal-to-noise ratio of 8.2, and a FETCH probability of $p=0.99$. To the best of our knowledge, this would be the first FRB detected from South America. A set of more marginal candidates is also presented. These results demonstrate the capability of the IAR antennas to detect FRBs and support the continuation and extension of the monitoring campaign, including coincident dual-antenna observations and cross-matches with gravitational-wave events and electromagnetic transients."},{"descriptionType":"Other","description":"8 pages, 2 figures"}],"geoLocations":[],"fundingReferences":[],"url":"https://arxiv.org/abs/2608.03914","contentUrl":null,"metadataVersion":0,"schemaVersion":"http://datacite.org/schema/kernel-4","source":"mds","isActive":true,"state":"findable","reason":null,"viewCount":0,"downloadCount":0,"referenceCount":0,"citationCount":0,"partCount":0,"partOfCount":0,"versionCount":0,"versionOfCount":0,"created":"2026-08-05T02:23:53Z","registered":"2026-08-05T02:23:54Z","published":null,"updated":"2026-08-05T02:23:54Z"},"relationships":{"client":{"data":{"id":"arxiv.content","type":"clients"}}}},{"id":"10.48550/arxiv.2608.03913","type":"dois","attributes":{"doi":"10.48550/arxiv.2608.03913","identifiers":[{"identifier":"2608.03913","identifierType":"arXiv"}],"creators":[{"nameType":"Personal","givenName":"Chuanhao","familyName":"Yan","name":"Yan, Chuanhao","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Xuhan","familyName":"Huang","name":"Huang, Xuhan","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Yawen","familyName":"Duan","name":"Duan, Yawen","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Zhenfei","familyName":"Yin","name":"Yin, Zhenfei","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Hang","familyName":"Zhao","name":"Zhao, Hang","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Bryan","familyName":"Dai","name":"Dai, Bryan","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Jie","familyName":"Fu","name":"Fu, Jie","affiliation":[],"nameIdentifiers":[]}],"titles":[{"title":"Sparse Weight Decomposition for Efficient Circuit Extraction"}],"publisher":"arXiv","container":{},"publicationYear":2026,"subjects":[{"subject":"Machine Learning (cs.LG)","lang":"en","subjectScheme":"arXiv"},{"subject":"Computation and Language (cs.CL)","lang":"en","subjectScheme":"arXiv"},{"subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"}],"contributors":[],"dates":[{"date":"2026-08-04T16:40:48Z","dateType":"Submitted","dateInformation":"v1"},{"date":"2026-08-05T01:05:28Z","dateType":"Updated","dateInformation":"v1"},{"date":"2026-08","dateType":"Available","dateInformation":"v1"}],"language":null,"types":{"schemaOrg":"CreativeWork","resourceTypeGeneral":"Preprint","citeproc":"article","bibtex":"misc","ris":"GEN","resourceType":"Article"},"relatedIdentifiers":[],"relatedItems":[],"sizes":[],"formats":[],"version":"1","rightsList":[{"rightsUri":"http://arxiv.org/licenses/nonexclusive-distrib/1.0/","rights":"arXiv.org perpetual, non-exclusive license"}],"descriptions":[{"descriptionType":"Abstract","description":"Dense pretrained transformers do not naturally expose interpretable units for circuit extraction. Existing approaches obtain such units by learning auxiliary sparse representations or training sparse models, incurring substantial additional computation while potentially introducing a fidelity gap between the representation being analyzed and the original pretrained model. We propose Sparse Weight Decomposition (SWD), which reparameterizes pretrained linear projections by factorizing each weight matrix into two sparse factors whose shared intermediate coordinates serve as individually addressable circuit units. Without training a separate replacement network, this parametric representation supports the same scoring, selection, and ablation circuit extraction workflow used for methods that learn sparse features. Across single-matrix replacements, SWD matches the held-out fidelity achieved by Transcoder and other strong baselines while using less than 1% of the data that those baselines use to train their replacements. For matched replacement fidelity, SWD reaches the same circuit sufficiency and necessity targets with fewer active read/write edges and selected units across tasks on GPT-2, Qwen2.5, and Qwen3.5-27B. We further show that SWD remains effective for full-model replacement of all attention and MLP weight matrices after fine-tuning the nonzero factor values. Finally, SWD also features a zero-data variant, allowing broader use of mechanistic interpretability analysis (e.g., per-step analysis)."}],"geoLocations":[],"fundingReferences":[],"url":"https://arxiv.org/abs/2608.03913","contentUrl":null,"metadataVersion":0,"schemaVersion":"http://datacite.org/schema/kernel-4","source":"mds","isActive":true,"state":"findable","reason":null,"viewCount":0,"downloadCount":0,"referenceCount":0,"citationCount":0,"partCount":0,"partOfCount":0,"versionCount":0,"versionOfCount":0,"created":"2026-08-05T02:23:52Z","registered":"2026-08-05T02:23:53Z","published":null,"updated":"2026-08-05T02:23:53Z"},"relationships":{"client":{"data":{"id":"arxiv.content","type":"clients"}}}},{"id":"10.48550/arxiv.2608.03912","type":"dois","attributes":{"doi":"10.48550/arxiv.2608.03912","identifiers":[{"identifier":"2608.03912","identifierType":"arXiv"}],"creators":[{"nameType":"Personal","givenName":"Xiang","familyName":"Chen","name":"Chen, Xiang","affiliation":[],"nameIdentifiers":[]}],"titles":[{"title":"StreamDAM: Presence-Aware Memory for Real-Time Streaming Video Object Segmentation"}],"publisher":"arXiv","container":{},"publicationYear":2026,"subjects":[{"subject":"Computer Vision and Pattern Recognition (cs.CV)","lang":"en","subjectScheme":"arXiv"},{"subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"}],"contributors":[],"dates":[{"date":"2026-08-04T16:40:02Z","dateType":"Submitted","dateInformation":"v1"},{"date":"2026-08-05T01:05:27Z","dateType":"Updated","dateInformation":"v1"},{"date":"2026-08","dateType":"Available","dateInformation":"v1"}],"language":null,"types":{"schemaOrg":"CreativeWork","resourceTypeGeneral":"Preprint","citeproc":"article","bibtex":"misc","ris":"GEN","resourceType":"Article"},"relatedIdentifiers":[],"relatedItems":[],"sizes":[],"formats":[],"version":"1","rightsList":[{"rightsIdentifierScheme":"SPDX","rightsUri":"https://creativecommons.org/licenses/by/4.0/legalcode","schemeUri":"https://spdx.org/licenses/","rights":"Creative Commons Attribution 4.0 International","rightsIdentifier":"cc-by-4.0"}],"descriptions":[{"descriptionType":"Abstract","description":"Quality-tier video object segmentation (VOS) trackers such as DAM4SAM top accuracy leaderboards, but they are measured offline, one frame at a time with no clock. Under an honest streaming protocol at 30 frames per second, where a frame that misses its budget is served the last mask already computed, the winner collapses: the rich memory that makes it accurate is too slow to keep up, and what it emits is blind to whether the object is even present. We trace both failures to one place, the tracker's memory pipeline, and rebuild it for streaming. \\method{} makes the memory machinery itself run at frame rate through in-model optimization rather than a bolted-on fallback, and governs it with a single learned presence signal that decides what enters memory, how far back the tracker reads, when to withhold output, and when to re-detect. A mechanism analysis shows why a fixed policy cannot win: the control that helps when an object truly disappears is the one that hurts when it is merely hard to see, so the choice must be made per frame. Across four benchmarks and five modern baselines, \\method{} is the strongest streaming tracker, recovers nearly all of the offline model's accuracy under the clock, and on the hardest content exceeds the offline model it is built from."}],"geoLocations":[],"fundingReferences":[],"url":"https://arxiv.org/abs/2608.03912","contentUrl":null,"metadataVersion":0,"schemaVersion":"http://datacite.org/schema/kernel-4","source":"mds","isActive":true,"state":"findable","reason":null,"viewCount":0,"downloadCount":0,"referenceCount":0,"citationCount":0,"partCount":0,"partOfCount":0,"versionCount":0,"versionOfCount":0,"created":"2026-08-05T02:23:50Z","registered":"2026-08-05T02:23:51Z","published":null,"updated":"2026-08-05T02:23:51Z"},"relationships":{"client":{"data":{"id":"arxiv.content","type":"clients"}}}},{"id":"10.48550/arxiv.2608.03911","type":"dois","attributes":{"doi":"10.48550/arxiv.2608.03911","identifiers":[{"identifier":"2608.03911","identifierType":"arXiv"}],"creators":[{"nameType":"Personal","affiliation":["Sun Yat-sen University"],"givenName":"Kunquan","familyName":"Zhang","name":"Zhang, Kunquan","nameIdentifiers":[]},{"nameType":"Personal","affiliation":["Sun Yat-sen University"],"givenName":"Peilang","familyName":"Li","name":"Li, Peilang","nameIdentifiers":[]},{"nameType":"Personal","affiliation":["National University of Defense Technology"],"givenName":"Xikun","familyName":"Hu","name":"Hu, Xikun","nameIdentifiers":[]},{"nameType":"Personal","affiliation":["Sun Yat-sen University"],"givenName":"Yunkai","familyName":"Yang","name":"Yang, Yunkai","nameIdentifiers":[]},{"nameType":"Personal","affiliation":["National University of Defense Technology"],"givenName":"Yushan","familyName":"Zou","name":"Zou, Yushan","nameIdentifiers":[]},{"nameType":"Personal","affiliation":["Sun Yat-sen University"],"givenName":"Zhiwei","familyName":"Zhang","name":"Zhang, Zhiwei","nameIdentifiers":[]},{"nameType":"Personal","affiliation":["Sun Yat-sen University"],"givenName":"Runmin","familyName":"Dong","name":"Dong, Runmin","nameIdentifiers":[]}],"titles":[{"title":"UniEvo-RS: Omni-Prompt Unified Remote Sensing Segmentation with Representative Exemplar-Driven Prototype Evolution"}],"publisher":"arXiv","container":{},"publicationYear":2026,"subjects":[{"subject":"Computer Vision and Pattern Recognition (cs.CV)","lang":"en","subjectScheme":"arXiv"},{"subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"}],"contributors":[],"dates":[{"date":"2026-08-04T16:39:34Z","dateType":"Submitted","dateInformation":"v1"},{"date":"2026-08-05T01:05:24Z","dateType":"Updated","dateInformation":"v1"},{"date":"2026-08","dateType":"Available","dateInformation":"v1"}],"language":null,"types":{"schemaOrg":"CreativeWork","resourceTypeGeneral":"Preprint","citeproc":"article","bibtex":"misc","ris":"GEN","resourceType":"Article"},"relatedIdentifiers":[],"relatedItems":[],"sizes":[],"formats":[],"version":"1","rightsList":[{"rightsUri":"http://arxiv.org/licenses/nonexclusive-distrib/1.0/","rights":"arXiv.org perpetual, non-exclusive license"}],"descriptions":[{"descriptionType":"Abstract","description":"Prompt-driven vision-language models (VLMs) hold immense promise for accelerating dense remote sensing (RS) annotation, but static models suffer from severe performance degradation when deployed on novel scenes, unseen categories, or visually confusing backgrounds. Moreover, existing unified paradigms primarily rely on intra-image specific prompts, lacking flexible task routing to adapt to multi-intent operational workflows. In practical batch mapping, annotators typically refine a small set of representative samples before processing large datasets. Motivated by this practice, we propose UniEvo-RS, an omni-prompt unified RS segmentation framework equipped with representative exemplar-driven prototype evolution. First, we construct a multi-instruction prompt dataset that unifies text-driven and visual-driven prompts within a single architecture, establishing a dynamic task-routing mechanism for highly diverse RS annotation scenarios. Second, we introduce a representative feedback-driven, training-free prototype evolution mechanism. By contrasting manual annotations with initial predictions on exemplars, UniEvo-RS distills prediction errors into positive and negative prototypes. These prototypes enhance LLM query recall and suppress spatial background noise under a fixed-budget clustering memory. Extensive experiments show that UniEvo-RS unifies diverse prompting tasks, achieving state-of-the-art performance across most settings. Crucially, with minimal interaction on a few exemplars, it enables training-free, progressive accuracy enhancement on unseen categories during batch annotation."},{"descriptionType":"Other","description":"18 pages, 8 figures, 9 tables"}],"geoLocations":[],"fundingReferences":[],"url":"https://arxiv.org/abs/2608.03911","contentUrl":null,"metadataVersion":0,"schemaVersion":"http://datacite.org/schema/kernel-4","source":"mds","isActive":true,"state":"findable","reason":null,"viewCount":0,"downloadCount":0,"referenceCount":0,"citationCount":0,"partCount":0,"partOfCount":0,"versionCount":0,"versionOfCount":0,"created":"2026-08-05T02:23:49Z","registered":"2026-08-05T02:23:50Z","published":null,"updated":"2026-08-05T02:23:50Z"},"relationships":{"client":{"data":{"id":"arxiv.content","type":"clients"}}}},{"id":"10.48550/arxiv.2608.03910","type":"dois","attributes":{"doi":"10.48550/arxiv.2608.03910","identifiers":[{"identifier":"2608.03910","identifierType":"arXiv"}],"creators":[{"nameType":"Personal","givenName":"Matt","familyName":"Ratto","name":"Ratto, Matt","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Abhishek","familyName":"Moturu","name":"Moturu, Abhishek","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Daniel","familyName":"Silver","name":"Silver, Daniel","affiliation":[],"nameIdentifiers":[]}],"titles":[{"title":"Socially Grounded Agentic AI: Coordinating Plural Perspectives through Social Theory"}],"publisher":"arXiv","container":{},"publicationYear":2026,"subjects":[{"subject":"Artificial Intelligence (cs.AI)","lang":"en","subjectScheme":"arXiv"},{"subject":"Machine Learning (cs.LG)","lang":"en","subjectScheme":"arXiv"},{"subject":"Multiagent Systems (cs.MA)","lang":"en","subjectScheme":"arXiv"},{"subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"}],"contributors":[],"dates":[{"date":"2026-08-04T16:37:09Z","dateType":"Submitted","dateInformation":"v1"},{"date":"2026-08-05T01:05:12Z","dateType":"Updated","dateInformation":"v1"},{"date":"2026-08","dateType":"Available","dateInformation":"v1"}],"language":null,"types":{"schemaOrg":"CreativeWork","resourceTypeGeneral":"Preprint","citeproc":"article","bibtex":"misc","ris":"GEN","resourceType":"Article"},"relatedIdentifiers":[],"relatedItems":[],"sizes":[],"formats":[],"version":"1","rightsList":[{"rightsIdentifierScheme":"SPDX","rightsUri":"https://creativecommons.org/licenses/by/4.0/legalcode","schemeUri":"https://spdx.org/licenses/","rights":"Creative Commons Attribution 4.0 International","rightsIdentifier":"cc-by-4.0"}],"descriptions":[{"descriptionType":"Abstract","description":"As AI systems are deployed across increasingly diverse social contexts, alignment can no longer be framed as the optimization of a single, unified set of values. Instead, systems must be able to recognize, represent, and respond to multiple legitimate perspectives. This has led to growing interest in pluralistic alignment, which seeks to move beyond one-size-fits-all models of appropriate behaviour. However, current approaches often lack a clear account of how values are socially organized, contested, and coordinated in practice. In this paper, we argue that social theory provides essential conceptual and design resources for addressing these challenges. Drawing on established traditions in sociology, we show how perspectives can be understood as structured by roles, shaped through interaction, and distributed across fields of power and expertise. We translate these insights into concrete implications for AI system design, including role-based representations, structured coordination among perspectives, and context-sensitive evaluation. For agentic systems, this requires aligning not only final outputs, but also the role activations, deliberative traces, aggregation rules, and feedback loops through which those outputs are produced. Our contribution is to reposition pluralistic alignment as a problem of socially grounded coordination rather than output diversification. We outline a design space for systems that engage multiple perspectives in structured and accountable ways, and we identify directions for future work to implement and empirically evaluate these approaches in real-world settings."},{"descriptionType":"Other","description":"Pluralistic Alignment Workshop @ ICML 2026, Seoul, South Korea"}],"geoLocations":[],"fundingReferences":[],"url":"https://arxiv.org/abs/2608.03910","contentUrl":null,"metadataVersion":0,"schemaVersion":"http://datacite.org/schema/kernel-4","source":"mds","isActive":true,"state":"findable","reason":null,"viewCount":0,"downloadCount":0,"referenceCount":0,"citationCount":0,"partCount":0,"partOfCount":0,"versionCount":0,"versionOfCount":0,"created":"2026-08-05T02:23:48Z","registered":"2026-08-05T02:23:48Z","published":null,"updated":"2026-08-05T02:23:48Z"},"relationships":{"client":{"data":{"id":"arxiv.content","type":"clients"}}}},{"id":"10.48550/arxiv.2608.03909","type":"dois","attributes":{"doi":"10.48550/arxiv.2608.03909","identifiers":[{"identifier":"2608.03909","identifierType":"arXiv"}],"creators":[{"nameType":"Personal","givenName":"James W.","familyName":"Webber","name":"Webber, James W.","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Sean","familyName":"Holman","name":"Holman, Sean","affiliation":[],"nameIdentifiers":[]}],"titles":[{"title":"Microlocal analysis of a non-linear cone transform and applications to Compton camera imaging"}],"publisher":"arXiv","container":{},"publicationYear":2026,"subjects":[{"subject":"Numerical Analysis (math.NA)","lang":"en","subjectScheme":"arXiv"},{"subject":"Functional Analysis (math.FA)","lang":"en","subjectScheme":"arXiv"},{"subject":"FOS: Mathematics","subjectScheme":"Fields of Science and Technology (FOS)"}],"contributors":[],"dates":[{"date":"2026-08-04T16:37:05Z","dateType":"Submitted","dateInformation":"v1"},{"date":"2026-08-05T01:05:11Z","dateType":"Updated","dateInformation":"v1"},{"date":"2026-08","dateType":"Available","dateInformation":"v1"}],"language":null,"types":{"schemaOrg":"CreativeWork","resourceTypeGeneral":"Preprint","citeproc":"article","bibtex":"misc","ris":"GEN","resourceType":"Article"},"relatedIdentifiers":[],"relatedItems":[],"sizes":[],"formats":[],"version":"1","rightsList":[{"rightsIdentifierScheme":"SPDX","rightsUri":"https://creativecommons.org/licenses/by/4.0/legalcode","schemeUri":"https://spdx.org/licenses/","rights":"Creative Commons Attribution 4.0 International","rightsIdentifier":"cc-by-4.0"}],"descriptions":[{"descriptionType":"Abstract","description":"We present a novel method to recover the source intensity, $f : \\mathbb{R}^n \\to \\mathbb{R}$, and attenuation coefficient, $μ: \\mathbb{R}^n \\to \\mathbb{R}$, in Compton camera imaging. We apply a non-linear model, which accounts for ray attenuation. We show that the data, $h$, can be modeled $h = \\mathcal{R}(f,μ) = R(fg)$, where $g = \\exp(-Gμ)$ models attenuation, $G$ is a (linear) divergent beam transform, and $R$ is a linear operator which defines the integrals of $fg$ over cones. Commonly in the literature, $μ$ is set to zero, and the data $h = Rf$ is linear. We address the case when $μ\\neq 0$ and the transform is non-linear. To simplify the analysis, we first transform the data into weighted line integrals, $\\tilde{h} = \\mathcal{D}_k(f,μ) = D_k(fg)$, where $D_k$ is a weighted ray transform. Assuming practically reasonable geometric conditions, we show that $\\tilde{h} = \\exp(-X_{w_1}μ)X_{w_2}f$, where $X_w$ is a weighted X-ray transform, and the $w_i$ are smooth weights. After which, we use the theory of conormal distributions to describe the singularities of $\\tilde{h}$. We show that there are artifacts in the reconstruction, and we quantify their strength using Sobolev spaces. We combine this theory with a geometric argument to recover the edges of $f$ and ultimately prove that $f$ and $μ$ are unique to $h$. The recovery of $f$ is notably more stable than that of $μ$, which we also discuss. To validate our theory, we present simulated reconstructions of $f$ and $μ$ using the proposed method."},{"descriptionType":"Other","description":"26 pages, 9 figures"}],"geoLocations":[],"fundingReferences":[],"url":"https://arxiv.org/abs/2608.03909","contentUrl":null,"metadataVersion":0,"schemaVersion":"http://datacite.org/schema/kernel-4","source":"mds","isActive":true,"state":"findable","reason":null,"viewCount":0,"downloadCount":0,"referenceCount":0,"citationCount":0,"partCount":0,"partOfCount":0,"versionCount":0,"versionOfCount":0,"created":"2026-08-05T02:23:46Z","registered":"2026-08-05T02:23:47Z","published":null,"updated":"2026-08-05T02:23:47Z"},"relationships":{"client":{"data":{"id":"arxiv.content","type":"clients"}}}},{"id":"10.48550/arxiv.2608.03908","type":"dois","attributes":{"doi":"10.48550/arxiv.2608.03908","identifiers":[{"identifier":"2608.03908","identifierType":"arXiv"}],"creators":[{"nameType":"Personal","givenName":"Yu","familyName":"Miao","name":"Miao, Yu","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Zhiwei","familyName":"Wang","name":"Wang, Zhiwei","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Hongxu","familyName":"Sun","name":"Sun, Hongxu","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Jianchang","familyName":"Shen","name":"Shen, Jianchang","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Runqing","familyName":"Luan","name":"Luan, Runqing","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Zhipeng","familyName":"Ou","name":"Ou, Zhipeng","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Xinru","familyName":"Yong","name":"Yong, Xinru","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Zhenyu","familyName":"Wang","name":"Wang, Zhenyu","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Tao","familyName":"Wu","name":"Wu, Tao","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Haoyu","familyName":"Hu","name":"Hu, Haoyu","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Junfeng","familyName":"He","name":"He, Junfeng","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Xianhui","familyName":"Chen","name":"Chen, Xianhui","affiliation":[],"nameIdentifiers":[]}],"titles":[{"title":"Thermodynamic phase transition, pairing symmetry and Fermi surface topology in Ruddlesden-Popper nickelate films"}],"publisher":"arXiv","container":{},"publicationYear":2026,"subjects":[{"subject":"Superconductivity (cond-mat.supr-con)","lang":"en","subjectScheme":"arXiv"},{"subject":"Strongly Correlated Electrons (cond-mat.str-el)","lang":"en","subjectScheme":"arXiv"},{"subject":"FOS: Physical sciences","subjectScheme":"Fields of Science and Technology (FOS)"}],"contributors":[],"dates":[{"date":"2026-08-04T16:36:50Z","dateType":"Submitted","dateInformation":"v1"},{"date":"2026-08-05T01:05:10Z","dateType":"Updated","dateInformation":"v1"},{"date":"2026-08","dateType":"Available","dateInformation":"v1"}],"language":null,"types":{"schemaOrg":"CreativeWork","resourceTypeGeneral":"Preprint","citeproc":"article","bibtex":"misc","ris":"GEN","resourceType":"Article"},"relatedIdentifiers":[],"relatedItems":[],"sizes":[],"formats":[],"version":"1","rightsList":[{"rightsUri":"http://arxiv.org/licenses/nonexclusive-distrib/1.0/","rights":"arXiv.org perpetual, non-exclusive license"}],"descriptions":[{"descriptionType":"Abstract","description":"Ruddlesden-Popper (RP) nickelates provide an uncharted territory to explore high-transition-temperature (high-$T_C$) superconductivity and superconducting mechanism. Here, we investigate the electronic structure of a new type of high-$T_C$ superconducting RP nickelate heterostructure $\\mathrm{La_2PrNi_2O_7/NdAlO_3}$ by angle-resolved photoemission spectroscopy. A superconducting state is observed without a pseudogap state, enabling a direct measurement of the superconducting order parameter and a microscopic extraction of the electronic specific heat. The observed superconducting gap opens at $T_C$ with prominent coherence peaks, illustrating the emergence of nonzero order parameter upon entering the superconducting state. An electronic specific heat jump appears at $T_C$, further demonstrating a thermodynamic phase transition. The magnitude of the superconducting order parameter is quantified by the observed superconducting coherence peaks, and a nodeless behavior is unambiguously established in the absence of pseudogap. The underlying Fermi surface consists of $α$, $β$ and $γ$ pockets, exhibiting a multi-orbital nature. Strain dependent measurements further reveal the $γ$ pocket in all superconducting and non-superconducting films with different epitaxial strain. Our results establish the missing thermodynamic evidence for superconducting phase transition in nickelates. They also provide direct evidence for the symmetry of the superconducting order parameter and illustrate the relationship between Fermi surface topology and the emergence of superconductivity in RP nickelate films."},{"descriptionType":"Other","description":"16 pages, 4 figures"}],"geoLocations":[],"fundingReferences":[],"url":"https://arxiv.org/abs/2608.03908","contentUrl":null,"metadataVersion":0,"schemaVersion":"http://datacite.org/schema/kernel-4","source":"mds","isActive":true,"state":"findable","reason":null,"viewCount":0,"downloadCount":0,"referenceCount":0,"citationCount":0,"partCount":0,"partOfCount":0,"versionCount":0,"versionOfCount":0,"created":"2026-08-05T02:23:45Z","registered":"2026-08-05T02:23:46Z","published":null,"updated":"2026-08-05T02:23:46Z"},"relationships":{"client":{"data":{"id":"arxiv.content","type":"clients"}}}},{"id":"10.48550/arxiv.2608.03907","type":"dois","attributes":{"doi":"10.48550/arxiv.2608.03907","identifiers":[{"identifier":"2608.03907","identifierType":"arXiv"}],"creators":[{"nameType":"Personal","givenName":"Rami","familyName":"Gherib","name":"Gherib, Rami","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Roya","familyName":"Radgohar","name":"Radgohar, Roya","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Anastasiia","familyName":"Pusenkova","name":"Pusenkova, Anastasiia","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Seyyed Mehdi Hosseini","familyName":"Jenab","name":"Jenab, Seyyed Mehdi Hosseini","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Sara","familyName":"Turcotte","name":"Turcotte, Sara","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Dany","familyName":"Lachance-Quirion","name":"Lachance-Quirion, Dany","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Nicholas E.","familyName":"Frattini","name":"Frattini, Nicholas E.","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Scott N.","familyName":"Genin","name":"Genin, Scott N.","affiliation":[],"nameIdentifiers":[]}],"titles":[{"title":"A variational hybrid continuous-variable discrete-variable quantum algorithm for adiabatic nuclear dynamics"}],"publisher":"arXiv","container":{},"publicationYear":2026,"subjects":[{"subject":"Chemical Physics (physics.chem-ph)","lang":"en","subjectScheme":"arXiv"},{"subject":"FOS: Physical sciences","subjectScheme":"Fields of Science and Technology (FOS)"}],"contributors":[],"dates":[{"date":"2026-08-04T16:36:34Z","dateType":"Submitted","dateInformation":"v1"},{"date":"2026-08-05T01:05:09Z","dateType":"Updated","dateInformation":"v1"},{"date":"2026-08","dateType":"Available","dateInformation":"v1"}],"language":null,"types":{"schemaOrg":"CreativeWork","resourceTypeGeneral":"Preprint","citeproc":"article","bibtex":"misc","ris":"GEN","resourceType":"Article"},"relatedIdentifiers":[],"relatedItems":[],"sizes":[],"formats":[],"version":"1","rightsList":[{"rightsIdentifierScheme":"SPDX","rightsUri":"https://creativecommons.org/licenses/by/4.0/legalcode","schemeUri":"https://spdx.org/licenses/","rights":"Creative Commons Attribution 4.0 International","rightsIdentifier":"cc-by-4.0"}],"descriptions":[{"descriptionType":"Abstract","description":"Gaussian wavepacket (GWP) methods are prevalent means of solving the nuclear time-dependent Schrodinger equation (TDSE) on classical computers. They consist of representing the nuclear wave function as a superposition of Gaussians. Here, we present a variational hybrid continuous-variable discrete-variable (CV-DV) algorithm for simulating adiabatic nuclear dynamics on qubit-oscillator quantum hardware. It encodes a superposition of frozen Gaussians (FGs) onto the qubit-oscillator register and evolves it according to the time-dependent variational principle (VP). We test two variants of the approach, one that evolves a single FG and another that evolves a superposition of FGs, on a set of prototypical 1D harmonic and anharmonic systems. We simulate the photoexcited state dynamics of SO2 using the single FG variant of the algorithm and compute its autocorrelation function on physical quantum hardware. For harmonic and Morse potentials, the variant evolving the superposition of FGs converges to the numerically exact solution as the number of Gaussians increases. In the case of the double-well potential, the algorithm simulates wavepacket bifurcation and recurrence correctly, and the ensuing irregular dynamics moderately well. Overall, this work establishes a pathway for simulating molecular dynamics on noisy intermediate-scale quantum devices."},{"descriptionType":"Other","description":"18 pages, 12 figures"}],"geoLocations":[],"fundingReferences":[],"url":"https://arxiv.org/abs/2608.03907","contentUrl":null,"metadataVersion":0,"schemaVersion":"http://datacite.org/schema/kernel-4","source":"mds","isActive":true,"state":"findable","reason":null,"viewCount":0,"downloadCount":0,"referenceCount":0,"citationCount":0,"partCount":0,"partOfCount":0,"versionCount":0,"versionOfCount":0,"created":"2026-08-05T02:23:44Z","registered":"2026-08-05T02:23:44Z","published":null,"updated":"2026-08-05T02:23:44Z"},"relationships":{"client":{"data":{"id":"arxiv.content","type":"clients"}}}},{"id":"10.48550/arxiv.2608.03906","type":"dois","attributes":{"doi":"10.48550/arxiv.2608.03906","identifiers":[{"identifier":"2608.03906","identifierType":"arXiv"}],"creators":[{"nameType":"Personal","givenName":"Constantin","familyName":"Rein","name":"Rein, Constantin","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Klaus","familyName":"Kroy","name":"Kroy, Klaus","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Viktor","familyName":"Holubec","name":"Holubec, Viktor","affiliation":[],"nameIdentifiers":[]}],"titles":[{"title":"Reaction Delays Boost, Rectify, and Reverse Motility in Activity Landscapes"}],"publisher":"arXiv","container":{},"publicationYear":2026,"subjects":[{"subject":"Soft Condensed Matter (cond-mat.soft)","lang":"en","subjectScheme":"arXiv"},{"subject":"Biological Physics (physics.bio-ph)","lang":"en","subjectScheme":"arXiv"},{"subject":"FOS: Physical sciences","subjectScheme":"Fields of Science and Technology (FOS)"}],"contributors":[],"dates":[{"date":"2026-08-04T16:35:41Z","dateType":"Submitted","dateInformation":"v1"},{"date":"2026-08-05T01:05:03Z","dateType":"Updated","dateInformation":"v1"},{"date":"2026-08","dateType":"Available","dateInformation":"v1"}],"language":null,"types":{"schemaOrg":"CreativeWork","resourceTypeGeneral":"Preprint","citeproc":"article","bibtex":"misc","ris":"GEN","resourceType":"Article"},"relatedIdentifiers":[],"relatedItems":[],"sizes":[],"formats":[],"version":"1","rightsList":[{"rightsUri":"http://arxiv.org/licenses/nonexclusive-distrib/1.0/","rights":"arXiv.org perpetual, non-exclusive license"}],"descriptions":[{"descriptionType":"Abstract","description":"Local detailed balance restricts transport by self-propulsion in static activity landscapes. We show that a delayed speed adaptation (``delayed motility/kinesis'') generically breaks this symme try, inducing directed transport in asymmetric periodic motility profiles and enhancing diffusion in symmetric ones. Both effects occur for run-and-tumble, active Brownian, and inertial active particles, without requiring potential interactions, walls, imposed gradients, higher dimensions, or translational diffusion. Their magnitudes, and even current reversals, are conveniently tuned via the delay time, which establishes delayed motility as a versatile generic and experimentally accessible mechanism for autonomous self-steering and transport control in motile-active-matter circuity."},{"descriptionType":"Other","description":"5 pages, 2 figures"}],"geoLocations":[],"fundingReferences":[],"url":"https://arxiv.org/abs/2608.03906","contentUrl":null,"metadataVersion":0,"schemaVersion":"http://datacite.org/schema/kernel-4","source":"mds","isActive":true,"state":"findable","reason":null,"viewCount":0,"downloadCount":0,"referenceCount":0,"citationCount":0,"partCount":0,"partOfCount":0,"versionCount":0,"versionOfCount":0,"created":"2026-08-05T02:23:42Z","registered":"2026-08-05T02:23:43Z","published":null,"updated":"2026-08-05T02:23:43Z"},"relationships":{"client":{"data":{"id":"arxiv.content","type":"clients"}}}},{"id":"10.48550/arxiv.2608.03904","type":"dois","attributes":{"doi":"10.48550/arxiv.2608.03904","identifiers":[{"identifier":"2608.03904","identifierType":"arXiv"}],"creators":[{"nameType":"Personal","givenName":"Petr O.","familyName":"Jedlicka","name":"Jedlicka, Petr O.","affiliation":[],"nameIdentifiers":[]}],"titles":[{"title":"Why do we need social singularity? A mechanism-based critique of gradual scenarios in AI existential-risk discourse"}],"publisher":"arXiv","container":{},"publicationYear":2026,"subjects":[{"subject":"Computers and Society (cs.CY)","lang":"en","subjectScheme":"arXiv"},{"subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"}],"contributors":[],"dates":[{"date":"2026-08-04T16:30:12Z","dateType":"Submitted","dateInformation":"v1"},{"date":"2026-08-05T01:04:42Z","dateType":"Updated","dateInformation":"v1"},{"date":"2026-08","dateType":"Available","dateInformation":"v1"}],"language":null,"types":{"schemaOrg":"CreativeWork","resourceTypeGeneral":"Preprint","citeproc":"article","bibtex":"misc","ris":"GEN","resourceType":"Article"},"relatedIdentifiers":[],"relatedItems":[],"sizes":[],"formats":[],"version":"1","rightsList":[{"rightsIdentifierScheme":"SPDX","rightsUri":"https://creativecommons.org/licenses/by/4.0/legalcode","schemeUri":"https://spdx.org/licenses/","rights":"Creative Commons Attribution 4.0 International","rightsIdentifier":"cc-by-4.0"}],"descriptions":[{"descriptionType":"Abstract","description":"This paper critiques recent gradual and cumulative AI existential-risk scenarios, arguing that, despite their substantive contributions, they remain insufficiently sociologically specified. In particular, these scenarios lack a reflexive perspective, retain a largely technologically deterministic structure, and underestimate the role of collective agency and other social processes. As a result, they also discount the possibility of major social conflict accompanying AI diffusion, which limits their overall plausibility. The paper further identifies a set of social mechanisms likely to become significant before or during AI deployment, including interpretive and performative dynamics, mobilisation and countermobilisation, path dependence and lock-in, cross-regime divergence and multi-speed diffusion, and social-psychological mechanisms such as attachment and reactance. It argues that these mechanisms will interact recursively with AI diffusion and reshape future trajectories, which may subsequently branch, reverse, or undergo discontinuous shifts, thereby expanding the space of plausible AI futures. On this basis, the paper also proposes a novel analytic distinction between technological singularity and social singularity. Whereas the former refers to a putative technological threshold in AI development, the latter denotes a social discontinuity produced by the anticipated approach of that threshold. The central implication is that the most consequential disruptions may emerge not only from advanced AI itself, but also from the social dynamics provoked by the expectation of its arrival."},{"descriptionType":"Other","description":"20 pages"}],"geoLocations":[],"fundingReferences":[],"url":"https://arxiv.org/abs/2608.03904","contentUrl":null,"metadataVersion":0,"schemaVersion":"http://datacite.org/schema/kernel-4","source":"mds","isActive":true,"state":"findable","reason":null,"viewCount":0,"downloadCount":0,"referenceCount":0,"citationCount":0,"partCount":0,"partOfCount":0,"versionCount":0,"versionOfCount":0,"created":"2026-08-05T02:23:39Z","registered":"2026-08-05T02:23:40Z","published":null,"updated":"2026-08-05T02:23:40Z"},"relationships":{"client":{"data":{"id":"arxiv.content","type":"clients"}}}},{"id":"10.48550/arxiv.2608.03903","type":"dois","attributes":{"doi":"10.48550/arxiv.2608.03903","identifiers":[{"identifier":"2608.03903","identifierType":"arXiv"}],"creators":[{"nameType":"Personal","givenName":"Fabián","familyName":"Jofré-Parra","name":"Jofré-Parra, Fabián","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Debankita","familyName":"Ghosh","name":"Ghosh, Debankita","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Enrique","familyName":"Muñoz","name":"Muñoz, Enrique","affiliation":[],"nameIdentifiers":[]}],"titles":[{"title":"Phonon-based determination of elastic coefficients in the Weyl semimetal TaAs"}],"publisher":"arXiv","container":{},"publicationYear":2026,"subjects":[{"subject":"Materials Science (cond-mat.mtrl-sci)","lang":"en","subjectScheme":"arXiv"},{"subject":"FOS: Physical sciences","subjectScheme":"Fields of Science and Technology (FOS)"}],"contributors":[],"dates":[{"date":"2026-08-04T16:29:57Z","dateType":"Submitted","dateInformation":"v1"},{"date":"2026-08-05T01:04:41Z","dateType":"Updated","dateInformation":"v1"},{"date":"2026-08","dateType":"Available","dateInformation":"v1"}],"language":null,"types":{"schemaOrg":"CreativeWork","resourceTypeGeneral":"Preprint","citeproc":"article","bibtex":"misc","ris":"GEN","resourceType":"Article"},"relatedIdentifiers":[],"relatedItems":[],"sizes":[],"formats":[],"version":"1","rightsList":[{"rightsIdentifierScheme":"SPDX","rightsUri":"https://creativecommons.org/licenses/by/4.0/legalcode","schemeUri":"https://spdx.org/licenses/","rights":"Creative Commons Attribution 4.0 International","rightsIdentifier":"cc-by-4.0"}],"descriptions":[{"descriptionType":"Abstract","description":"Reliable determination of elastic properties in topological semimetals is essential for understanding strain-related effects, but is often hindered by methodological and computational limitations. In this work, we combine first-principles phonon calculations with an elastic continuum model to determine the elastic properties of Weyl semimetal TaAs. The sound velocities extracted from the acoustic phonon branches are used to obtain the full set of elastic moduli, which show good agreement with previously reported values in the literature. From these results, we derive standard elastic parameters such as bulk, shear, and Young's moduli, and the Poisson ratio. This approach highlights a computationally efficient alternative to conventional strain-based methods, avoiding the need for large supercells when shear is applied, and thus possible strain-induced inconsistencies in the electronic basis, while providing a possibility to connect with experimental characterizations (e.g. Raman or Brillouin-Mandelstam scattering) of the lattice dynamics in Weyl semimetals."}],"geoLocations":[],"fundingReferences":[],"url":"https://arxiv.org/abs/2608.03903","contentUrl":null,"metadataVersion":0,"schemaVersion":"http://datacite.org/schema/kernel-4","source":"mds","isActive":true,"state":"findable","reason":null,"viewCount":0,"downloadCount":0,"referenceCount":0,"citationCount":0,"partCount":0,"partOfCount":0,"versionCount":0,"versionOfCount":0,"created":"2026-08-05T02:23:38Z","registered":"2026-08-05T02:23:39Z","published":null,"updated":"2026-08-05T02:23:39Z"},"relationships":{"client":{"data":{"id":"arxiv.content","type":"clients"}}}},{"id":"10.48550/arxiv.2608.03900","type":"dois","attributes":{"doi":"10.48550/arxiv.2608.03900","identifiers":[{"identifier":"2608.03900","identifierType":"arXiv"}],"creators":[{"nameType":"Personal","givenName":"Fraser","familyName":"Binns","name":"Binns, Fraser","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Shunyu","familyName":"Wan","name":"Wan, Shunyu","affiliation":[],"nameIdentifiers":[]}],"titles":[{"title":"The next-to-top term of the knot Floer homology of some non-fibered knots"}],"publisher":"arXiv","container":{},"publicationYear":2026,"subjects":[{"subject":"Geometric Topology (math.GT)","lang":"en","subjectScheme":"arXiv"},{"subject":"FOS: Mathematics","subjectScheme":"Fields of Science and Technology (FOS)"},{"subject":"57K18","lang":"en","subjectScheme":"MSC"}],"contributors":[],"dates":[{"date":"2026-08-04T16:29:26Z","dateType":"Submitted","dateInformation":"v1"},{"date":"2026-08-05T01:04:37Z","dateType":"Updated","dateInformation":"v1"},{"date":"2026-08","dateType":"Available","dateInformation":"v1"}],"language":null,"types":{"schemaOrg":"CreativeWork","resourceTypeGeneral":"Preprint","citeproc":"article","bibtex":"misc","ris":"GEN","resourceType":"Article"},"relatedIdentifiers":[],"relatedItems":[],"sizes":[],"formats":[],"version":"1","rightsList":[{"rightsIdentifierScheme":"SPDX","rightsUri":"https://creativecommons.org/licenses/by/4.0/legalcode","schemeUri":"https://spdx.org/licenses/","rights":"Creative Commons Attribution 4.0 International","rightsIdentifier":"cc-by-4.0"}],"descriptions":[{"descriptionType":"Abstract","description":"Sivek conjectured that the rank of knot Floer homology in the next-to-top Alexander grading is at least the rank in the top Alexander grading. Baldwin and Vela-Vick verified this conjecture in the case of fibered knots arXiv:1801.06563. Ni gave a generalization of this result (for knots in generalized $L$-spaces) to cases in which the knot Floer homology satisfies an algebraic condition arXiv:2104.14687. We give an independent generalization of Baldwin and Vela-Vick's result to a family of knots with Seifert surfaces satisfying certain conditions."},{"descriptionType":"Other","description":"29 pages, 8 figures, comments welcome"}],"geoLocations":[],"fundingReferences":[],"url":"https://arxiv.org/abs/2608.03900","contentUrl":null,"metadataVersion":0,"schemaVersion":"http://datacite.org/schema/kernel-4","source":"mds","isActive":true,"state":"findable","reason":null,"viewCount":0,"downloadCount":0,"referenceCount":0,"citationCount":0,"partCount":0,"partOfCount":0,"versionCount":0,"versionOfCount":0,"created":"2026-08-05T02:23:34Z","registered":"2026-08-05T02:23:35Z","published":null,"updated":"2026-08-05T02:23:35Z"},"relationships":{"client":{"data":{"id":"arxiv.content","type":"clients"}}}},{"id":"10.48550/arxiv.2608.03899","type":"dois","attributes":{"doi":"10.48550/arxiv.2608.03899","identifiers":[{"identifier":"2608.03899","identifierType":"arXiv"}],"creators":[{"nameType":"Personal","givenName":"Pervez","familyName":"Shaik","name":"Shaik, Pervez","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Prosenjit","familyName":"Biswas","name":"Biswas, Prosenjit","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Abhinav","familyName":"Thorat","name":"Thorat, Abhinav","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Ravi","familyName":"Kolla","name":"Kolla, Ravi","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Niranjan","familyName":"Pedanekar","name":"Pedanekar, Niranjan","affiliation":[],"nameIdentifiers":[]}],"titles":[{"title":"ATLAS: Learning to Recommend Across Unseen Domains"}],"publisher":"arXiv","container":{},"publicationYear":2026,"subjects":[{"subject":"Information Retrieval (cs.IR)","lang":"en","subjectScheme":"arXiv"},{"subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"}],"contributors":[],"dates":[{"date":"2026-08-04T16:29:02Z","dateType":"Submitted","dateInformation":"v1"},{"date":"2026-08-05T01:04:35Z","dateType":"Updated","dateInformation":"v1"},{"date":"2026-08","dateType":"Available","dateInformation":"v1"}],"language":null,"types":{"schemaOrg":"CreativeWork","resourceTypeGeneral":"Preprint","citeproc":"article","bibtex":"misc","ris":"GEN","resourceType":"Article"},"relatedIdentifiers":[],"relatedItems":[],"sizes":[],"formats":[],"version":"1","rightsList":[{"rightsIdentifierScheme":"SPDX","rightsUri":"https://creativecommons.org/licenses/by-sa/4.0/legalcode","schemeUri":"https://spdx.org/licenses/","rights":"Creative Commons Attribution Share Alike 4.0 International","rightsIdentifier":"cc-by-sa-4.0"}],"descriptions":[{"descriptionType":"Abstract","description":"Recommender systems remain domain-bound: a model trained on one interaction environment typically requires retraining or target-domain adaptation before it can operate on a new catalogue. A recommender trained on movies cannot be directly deployed to recommend groceries or video games. Existing approaches mitigate this by transferring restricted forms of recommendation knowledge, adapting to the target domain, or leveraging large language models (LLMs) for transferable representations. We instead ask whether recommendation-specific knowledge learned solely from multiple heterogeneous domains can generalize to entirely unseen domains without target-domain adaptation or language-model pretraining. We introduce ATLAS, a multi-source recommendation domain generalization framework that learns a shared, domain-invariant user-item representation from disjoint source domains, enabling zero-shot recommendation on unseen domains. ATLAS combines a Gromov-Wasserstein alignment that preserves how users relate to one another across domains, an adversarial objective that makes item representations indistinguishable across domains, and residual vector quantization (RVQ) codebooks that compress user and item embeddings into a discrete latent space, capturing hierarchical interaction patterns while suppressing domain-specific variation. Trained on five Amazon domains and applied directly to ten unseen domains, ATLAS outperforms state-of-the-art sequential, graph-based, cross-domain, quantization-based, and LLM-based baselines on most unseen domains, with an average relative gain in HitRate of 24%. Ablations and representation analyses validate each component, and we identify a pronounced source-domain diversity effect: increasing source heterogeneity substantially improves zero-shot transfer. ATLAS establishes recommendation domain generalization as a promising paradigm for zero-shot recommendation."},{"descriptionType":"Other","description":"18 pages, 5 figures, 14 tables. Includes appendix with proofs and additional experiments"}],"geoLocations":[],"fundingReferences":[],"url":"https://arxiv.org/abs/2608.03899","contentUrl":null,"metadataVersion":0,"schemaVersion":"http://datacite.org/schema/kernel-4","source":"mds","isActive":true,"state":"findable","reason":null,"viewCount":0,"downloadCount":0,"referenceCount":0,"citationCount":0,"partCount":0,"partOfCount":0,"versionCount":0,"versionOfCount":0,"created":"2026-08-05T02:23:33Z","registered":"2026-08-05T02:23:33Z","published":null,"updated":"2026-08-05T02:23:33Z"},"relationships":{"client":{"data":{"id":"arxiv.content","type":"clients"}}}},{"id":"10.48550/arxiv.2608.03898","type":"dois","attributes":{"doi":"10.48550/arxiv.2608.03898","identifiers":[{"identifier":"2608.03898","identifierType":"arXiv"}],"creators":[{"nameType":"Personal","givenName":"Ronja","familyName":"Schwarz","name":"Schwarz, Ronja","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Jannik","familyName":"Strötgen","name":"Strötgen, Jannik","affiliation":[],"nameIdentifiers":[]}],"titles":[{"title":"ANNOTARES: A Dataset for Extracting Logical Structures from German Statutory Texts"}],"publisher":"arXiv","container":{},"publicationYear":2026,"subjects":[{"subject":"Computation and Language (cs.CL)","lang":"en","subjectScheme":"arXiv"},{"subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"}],"contributors":[],"dates":[{"date":"2026-08-04T16:28:53Z","dateType":"Submitted","dateInformation":"v1"},{"date":"2026-08-05T01:04:35Z","dateType":"Updated","dateInformation":"v1"},{"date":"2026-08","dateType":"Available","dateInformation":"v1"}],"language":null,"types":{"schemaOrg":"CreativeWork","resourceTypeGeneral":"Preprint","citeproc":"article","bibtex":"misc","ris":"GEN","resourceType":"Article"},"relatedIdentifiers":[],"relatedItems":[],"sizes":[],"formats":[],"version":"1","rightsList":[{"rightsIdentifierScheme":"SPDX","rightsUri":"https://creativecommons.org/licenses/by/4.0/legalcode","schemeUri":"https://spdx.org/licenses/","rights":"Creative Commons Attribution 4.0 International","rightsIdentifier":"cc-by-4.0"}],"descriptions":[{"descriptionType":"Abstract","description":"The automatic structural analysis of legal texts is a cornerstone of legal technology, yet the extraction of their logical components remains a significant challenge. In this paper, we introduce the task of identifying and segmenting legal conditions (Tatbestand) and legal consequences (Rechtsfolge) within German statutory texts. To support this task, we present ANNOTARES (Annotations of Tatbestand-Rechtsfolge Sequences), a novel dataset comprising German law texts with span-level annotations. Spanning three distinct legal codes, the dataset is designed to evaluate both domain-specific performance and cross-statute generalizability. We benchmark diverse architectural approaches: a rule-based baseline, CRFs, BiLSTMs, BiLSTM-CRF, and modern Transformer-based models, including BERT variants and LLM-based methods. Our results demonstrate that BERT and LLM-based models achieve superior performance in capturing the complex syntactic structures of legal language. We release our dataset to facilitate further research in automated legal reasoning."},{"descriptionType":"Other","description":"Accepted at KONVENS 2026"}],"geoLocations":[],"fundingReferences":[],"url":"https://arxiv.org/abs/2608.03898","contentUrl":null,"metadataVersion":0,"schemaVersion":"http://datacite.org/schema/kernel-4","source":"mds","isActive":true,"state":"findable","reason":null,"viewCount":0,"downloadCount":0,"referenceCount":0,"citationCount":0,"partCount":0,"partOfCount":0,"versionCount":0,"versionOfCount":0,"created":"2026-08-05T02:23:31Z","registered":"2026-08-05T02:23:32Z","published":null,"updated":"2026-08-05T02:23:32Z"},"relationships":{"client":{"data":{"id":"arxiv.content","type":"clients"}}}},{"id":"10.48550/arxiv.2608.03896","type":"dois","attributes":{"doi":"10.48550/arxiv.2608.03896","identifiers":[{"identifier":"2608.03896","identifierType":"arXiv"}],"creators":[{"nameType":"Personal","givenName":"Yao","familyName":"Ge","name":"Ge, Yao","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Yirui","familyName":"Luo","name":"Luo, Yirui","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Yuhao","familyName":"Chi","name":"Chi, Yuhao","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Yufei","familyName":"Zhao","name":"Zhao, Yufei","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Yong Liang","familyName":"Guan","name":"Guan, Yong Liang","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"David González","familyName":"G.","name":"G., David González","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Zhi","familyName":"Ding","name":"Ding, Zhi","affiliation":[],"nameIdentifiers":[]}],"titles":[{"title":"Structured-Sparsity-Aware Joint User Activity Detection and Channel Estimation for OTFS-Based Grant-Free Random Access"}],"publisher":"arXiv","container":{},"publicationYear":2026,"subjects":[{"subject":"Information Theory (cs.IT)","lang":"en","subjectScheme":"arXiv"},{"subject":"Signal Processing (eess.SP)","lang":"en","subjectScheme":"arXiv"},{"subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"},{"subject":"FOS: Electrical engineering, electronic engineering, information engineering","subjectScheme":"Fields of Science and Technology (FOS)"}],"contributors":[],"dates":[{"date":"2026-08-04T16:27:33Z","dateType":"Submitted","dateInformation":"v1"},{"date":"2026-08-05T01:04:29Z","dateType":"Updated","dateInformation":"v1"},{"date":"2026-08","dateType":"Available","dateInformation":"v1"}],"language":null,"types":{"schemaOrg":"CreativeWork","resourceTypeGeneral":"Preprint","citeproc":"article","bibtex":"misc","ris":"GEN","resourceType":"Article"},"relatedIdentifiers":[],"relatedItems":[],"sizes":[],"formats":[],"version":"1","rightsList":[{"rightsUri":"http://arxiv.org/licenses/nonexclusive-distrib/1.0/","rights":"arXiv.org perpetual, non-exclusive license"}],"descriptions":[{"descriptionType":"Abstract","description":"Grant-free random access (GFRA) is a promising solution for massive machine-type communications (mMTC) in future wireless networks. However, reliable user activity detection and channel estimation are critical challenges, particularly when orthogonal time-frequency space (OTFS) modulation is integrated with GFRA to address doubly selective channels induced by high mobility. In this paper, we propose an OTFS-based GFRA framework that exploits the inherent structured sparsity of delay-Doppler channels. By adopting a basis expansion model (BEM), we formulate joint user activity detection and channel estimation as a structured compressive sensing problem. A bi-level sparsity structure is identified, consisting of common sparsity across multiple receive antennas and activation sparsity across mMTC users. To effectively leverage this structure, we construct a two-layer factor graph and develop a structured sparsity expectation propagation (SS-EP) algorithm for efficient Bayesian inference. Simulation results demonstrate that the proposed scheme significantly outperforms existing benchmarks."},{"descriptionType":"Other","description":"6 pages, 4 figures, accepted by IEEE PIMRC 2026"}],"geoLocations":[],"fundingReferences":[],"url":"https://arxiv.org/abs/2608.03896","contentUrl":null,"metadataVersion":0,"schemaVersion":"http://datacite.org/schema/kernel-4","source":"mds","isActive":true,"state":"findable","reason":null,"viewCount":0,"downloadCount":0,"referenceCount":0,"citationCount":0,"partCount":0,"partOfCount":0,"versionCount":0,"versionOfCount":0,"created":"2026-08-05T02:23:29Z","registered":"2026-08-05T02:23:29Z","published":null,"updated":"2026-08-05T02:23:29Z"},"relationships":{"client":{"data":{"id":"arxiv.content","type":"clients"}}}},{"id":"10.48550/arxiv.2608.03895","type":"dois","attributes":{"doi":"10.48550/arxiv.2608.03895","identifiers":[{"identifier":"2608.03895","identifierType":"arXiv"}],"creators":[{"nameType":"Personal","givenName":"Wenbin","familyName":"Pan","name":"Pan, Wenbin","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Wanhao","familyName":"Liu","name":"Liu, Wanhao","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Liwei","familyName":"Luo","name":"Luo, Liwei","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Panshuo","familyName":"Li","name":"Li, Panshuo","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Yong","familyName":"Xu","name":"Xu, Yong","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Renquan","familyName":"Lu","name":"Lu, Renquan","affiliation":[],"nameIdentifiers":[]}],"titles":[{"title":"NCGR: Noise-Conditional Gated Rectification for Camera Extrinsic Perturbations in BEV 3D Object Detection"}],"publisher":"arXiv","container":{},"publicationYear":2026,"subjects":[{"subject":"Computer Vision and Pattern Recognition (cs.CV)","lang":"en","subjectScheme":"arXiv"},{"subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"}],"contributors":[],"dates":[{"date":"2026-08-04T16:26:57Z","dateType":"Submitted","dateInformation":"v1"},{"date":"2026-08-05T01:04:28Z","dateType":"Updated","dateInformation":"v1"},{"date":"2026-08","dateType":"Available","dateInformation":"v1"}],"language":null,"types":{"schemaOrg":"CreativeWork","resourceTypeGeneral":"Preprint","citeproc":"article","bibtex":"misc","ris":"GEN","resourceType":"Article"},"relatedIdentifiers":[],"relatedItems":[],"sizes":[],"formats":[],"version":"1","rightsList":[{"rightsUri":"http://arxiv.org/licenses/nonexclusive-distrib/1.0/","rights":"arXiv.org perpetual, non-exclusive license"}],"descriptions":[{"descriptionType":"Abstract","description":"Camera-based bird's-eye-view (BEV) 3D detection typically assumes accurate and fixed camera extrinsics. In detectors using spatial cross-attention (SCA), extrinsic perturbations displace the image-plane projections of BEV reference points, causing queries to sample features from incorrect regions and degrading detection performance. To address this failure mode, Noise-Conditional Gated Rectification (NCGR) is proposed to compensate for projection errors without explicitly estimating a full six-degree-of-freedom extrinsic correction. For each query-camera pair, a 2D rectification offset is predicted and modulated by a camera-level gate to rectify the base projection before native deformable sampling. During training, the perturbation-derived quantities used to construct the condition and gate are gradually replaced through scheduled interpolation by counterparts generated from an auxiliary scalar predicted from camera features. This transition enables blind inference without perturbation metadata. During training, a weight-shared clean-teacher/perturbed-student pair is used, and the rectification module is supervised by a BEV-consistency objective between the two branches. NCGR is evaluated on nuScenes with simulated dynamic and static extrinsic perturbations. In a five-camera dynamic stress test, NCGR achieves 39.69% NDS, compared with 28.00% for BEVFormer and 33.23% for CAPE. Under clean extrinsics, NCGR maintains performance comparable to that of BEVFormer."},{"descriptionType":"Other","description":"21 pages, including supplementary material"}],"geoLocations":[],"fundingReferences":[],"url":"https://arxiv.org/abs/2608.03895","contentUrl":null,"metadataVersion":0,"schemaVersion":"http://datacite.org/schema/kernel-4","source":"mds","isActive":true,"state":"findable","reason":null,"viewCount":0,"downloadCount":0,"referenceCount":0,"citationCount":0,"partCount":0,"partOfCount":0,"versionCount":0,"versionOfCount":0,"created":"2026-08-05T02:23:27Z","registered":"2026-08-05T02:23:28Z","published":null,"updated":"2026-08-05T02:23:28Z"},"relationships":{"client":{"data":{"id":"arxiv.content","type":"clients"}}}},{"id":"10.48550/arxiv.2608.03893","type":"dois","attributes":{"doi":"10.48550/arxiv.2608.03893","identifiers":[{"identifier":"2608.03893","identifierType":"arXiv"}],"creators":[{"nameType":"Personal","givenName":"Taekyung","familyName":"Heo","name":"Heo, Taekyung","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Rasoul","familyName":"Shafipour","name":"Shafipour, Rasoul","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Ritchie","familyName":"Zhao","name":"Zhao, Ritchie","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Maximilian","familyName":"Golub","name":"Golub, Maximilian","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Mohammad Mahdi","familyName":"Kamani","name":"Kamani, Mohammad Mahdi","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Ritika","familyName":"Borkar","name":"Borkar, Ritika","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Makesh Tarun","familyName":"Chandran","name":"Chandran, Makesh Tarun","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Pantea","familyName":"Zardoshti","name":"Zardoshti, Pantea","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Bita Darvish","familyName":"Rouhani","name":"Rouhani, Bita Darvish","affiliation":[],"nameIdentifiers":[]}],"titles":[{"title":"Cross-Model KV Cache Transfer in LLM Families: A Closed-Form Linear Mapping for Prefill Reuse"}],"publisher":"arXiv","container":{},"publicationYear":2026,"subjects":[{"subject":"Machine Learning (cs.LG)","lang":"en","subjectScheme":"arXiv"},{"subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"}],"contributors":[],"dates":[{"date":"2026-08-04T16:26:47Z","dateType":"Submitted","dateInformation":"v1"},{"date":"2026-08-05T01:04:25Z","dateType":"Updated","dateInformation":"v1"},{"date":"2026-08","dateType":"Available","dateInformation":"v1"}],"language":null,"types":{"schemaOrg":"CreativeWork","resourceTypeGeneral":"Preprint","citeproc":"article","bibtex":"misc","ris":"GEN","resourceType":"Article"},"relatedIdentifiers":[],"relatedItems":[],"sizes":[],"formats":[],"version":"1","rightsList":[{"rightsIdentifierScheme":"SPDX","rightsUri":"https://creativecommons.org/licenses/by/4.0/legalcode","schemeUri":"https://spdx.org/licenses/","rights":"Creative Commons Attribution 4.0 International","rightsIdentifier":"cc-by-4.0"}],"descriptions":[{"descriptionType":"Abstract","description":"Production deployments often swap between different-sized models in a family for cost-quality cascading, mid-conversation switching, and routing, and each swap forces the receiver to repay the prefill from scratch. We propose cross-model KV cache transfer, where the receiver reuses the source's KV cache, skipping prefill. We find that cross-model KV has substantial linear structure across matched-KV pairs, where source and target share KV head count and per-head dimension. On Qwen3 14B-\u0026gt;32B, one source layer explains 56% of variance in the target's keys and 32% in values, rising to 79% and 65% with multiple source layers. Building on this, we design a closed-form ridge mapper that operates per head and proceeds in three steps. First, for each target layer we select the top-k most predictive source layers and concatenate their KV as input. Second, we strip RoPE from the keys before mapping, so the fit is position-free and reusable across context lengths. Third, we fit ridge regression on a small calibration set of 500 FineWeb-Edu sequences of 1,024 tokens each. Surprisingly, across six pairs in three families, this linear mapper retains 73-98% of the receiver's standalone-prefill accuracy on four pairs, while two degrade sharply. A nonlinear MLP recovers up to +37 pp HellaSwag retention on the failures. The mapper runs 2.7-25x faster than re-prefill and remains stable across multi-turn handoff, making cross-model KV cache transfer practical."}],"geoLocations":[],"fundingReferences":[],"url":"https://arxiv.org/abs/2608.03893","contentUrl":null,"metadataVersion":0,"schemaVersion":"http://datacite.org/schema/kernel-4","source":"mds","isActive":true,"state":"findable","reason":null,"viewCount":0,"downloadCount":0,"referenceCount":0,"citationCount":0,"partCount":0,"partOfCount":0,"versionCount":0,"versionOfCount":0,"created":"2026-08-05T02:23:25Z","registered":"2026-08-05T02:23:25Z","published":null,"updated":"2026-08-05T02:23:25Z"},"relationships":{"client":{"data":{"id":"arxiv.content","type":"clients"}}}},{"id":"10.48550/arxiv.2608.03892","type":"dois","attributes":{"doi":"10.48550/arxiv.2608.03892","identifiers":[{"identifier":"2608.03892","identifierType":"arXiv"}],"creators":[{"nameType":"Personal","givenName":"Michal","familyName":"Mráz","name":"Mráz, Michal","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Justin","familyName":"Shenk","name":"Shenk, Justin","affiliation":[],"nameIdentifiers":[]}],"titles":[{"title":"Intertemporal Preference Steering in Qwen3 via Contrastive Activation Addition"}],"publisher":"arXiv","container":{},"publicationYear":2026,"subjects":[{"subject":"Artificial Intelligence (cs.AI)","lang":"en","subjectScheme":"arXiv"},{"subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"}],"contributors":[],"dates":[{"date":"2026-08-04T16:25:38Z","dateType":"Submitted","dateInformation":"v1"},{"date":"2026-08-05T01:04:23Z","dateType":"Updated","dateInformation":"v1"},{"date":"2026-08","dateType":"Available","dateInformation":"v1"}],"language":null,"types":{"schemaOrg":"CreativeWork","resourceTypeGeneral":"Preprint","citeproc":"article","bibtex":"misc","ris":"GEN","resourceType":"Article"},"relatedIdentifiers":[],"relatedItems":[],"sizes":[],"formats":[],"version":"1","rightsList":[{"rightsIdentifierScheme":"SPDX","rightsUri":"https://creativecommons.org/licenses/by/4.0/legalcode","schemeUri":"https://spdx.org/licenses/","rights":"Creative Commons Attribution 4.0 International","rightsIdentifier":"cc-by-4.0"}],"descriptions":[{"descriptionType":"Abstract","description":"We study linear representations of temporal horizon in the large language model Qwen3-32B and use them to change the model's time-related preferences, recommendations, and capabilities. We train contrastive linear probes on teacher-forced temporal-choice answers to find a short-term versus long-term direction in the model's residual stream, and evaluate contrastive activation-addition steering on a held-out binary temporal-choice task, an out-of-distribution monetary intertemporal-choice task, and a TravelPlanner capability benchmark. The central result is that temporal-horizon directions can be identified with simple contrastive linear probes and then used for steering to induce large, bidirectional preference changes. On an out-of-distribution monetary choice task that varies reward size and delay, steering strongly shifts the model's indifference threshold between smaller-sooner and larger-later rewards in both directions. We further show improvements on a planning-related capability metric under moderate temporal steering. These results suggest that model intertemporal preferences are measurable and steerable, which is relevant for AI systems that give advice involving delayed costs and benefits, and for safety questions about long-horizon planning."}],"geoLocations":[],"fundingReferences":[],"url":"https://arxiv.org/abs/2608.03892","contentUrl":null,"metadataVersion":0,"schemaVersion":"http://datacite.org/schema/kernel-4","source":"mds","isActive":true,"state":"findable","reason":null,"viewCount":0,"downloadCount":0,"referenceCount":0,"citationCount":0,"partCount":0,"partOfCount":0,"versionCount":0,"versionOfCount":0,"created":"2026-08-05T02:23:23Z","registered":"2026-08-05T02:23:24Z","published":null,"updated":"2026-08-05T02:23:24Z"},"relationships":{"client":{"data":{"id":"arxiv.content","type":"clients"}}}},{"id":"10.48550/arxiv.2608.03890","type":"dois","attributes":{"doi":"10.48550/arxiv.2608.03890","identifiers":[{"identifier":"2608.03890","identifierType":"arXiv"}],"creators":[{"nameType":"Personal","givenName":"Mercy Prasanna","familyName":"Ranjit","name":"Ranjit, Mercy Prasanna","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Anirban","familyName":"Porya","name":"Porya, Anirban","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Sathvik","familyName":"Joel","name":"Joel, Sathvik","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Niharika","familyName":"Vadlamudi","name":"Vadlamudi, Niharika","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Nikhilesh Chowdary","familyName":"Eathamukkala","name":"Eathamukkala, Nikhilesh Chowdary","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Prasanth","familyName":"V","name":"V, Prasanth, V","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Abhyuday Kumara","familyName":"Swamy","name":"Swamy, Abhyuday Kumara","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Pranay Narhari","familyName":"Umredkar","name":"Umredkar, Pranay Narhari","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Pradeep","familyName":"Narayan","name":"Narayan, Pradeep","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Vivek","familyName":"Rajagopal","name":"Rajagopal, Vivek","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Tanuja","familyName":"Ganu","name":"Ganu, Tanuja","affiliation":[],"nameIdentifiers":[]}],"titles":[{"title":"CARE-X: Towards Clinically Useful Radiology VLMs with Auxiliary Supervision, Reward-Aligned Learning, and Tool-Augmented Measurement"}],"publisher":"arXiv","container":{},"publicationYear":2026,"subjects":[{"subject":"Computer Vision and Pattern Recognition (cs.CV)","lang":"en","subjectScheme":"arXiv"},{"subject":"Artificial Intelligence (cs.AI)","lang":"en","subjectScheme":"arXiv"},{"subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"}],"contributors":[],"dates":[{"date":"2026-08-04T16:23:39Z","dateType":"Submitted","dateInformation":"v1"},{"date":"2026-08-05T01:04:16Z","dateType":"Updated","dateInformation":"v1"},{"date":"2026-08","dateType":"Available","dateInformation":"v1"}],"language":null,"types":{"schemaOrg":"CreativeWork","resourceTypeGeneral":"Preprint","citeproc":"article","bibtex":"misc","ris":"GEN","resourceType":"Article"},"relatedIdentifiers":[],"relatedItems":[],"sizes":[],"formats":[],"version":"1","rightsList":[{"rightsUri":"http://arxiv.org/licenses/nonexclusive-distrib/1.0/","rights":"arXiv.org perpetual, non-exclusive license"}],"descriptions":[{"descriptionType":"Abstract","description":"A clinically useful chest X-ray system must go beyond fluent report generation: it should classify findings with tunable decision thresholds, localize them spatially, and derive the anatomical measurements upon which many diagnoses depend. Today's Vision-Language Models (VLMs) treat these as separate problems, if they address them at all, leaving a gap between what radiologists need and what generative models provide. We introduce CARE-X, a chest X-ray VLM that narrows this gap by unifying auxiliary discriminative supervision with reward-aligned generation. CARE-X augments its generative backbone with focal-loss classification and composite-loss grounding heads, co-trained alongside the language-modeling objective. This auxiliary supervision produces discriminative diagnostic predictions with tunable decision thresholds and precise spatial localization while also improving report quality, providing evidence that structured prediction and generation reinforce one another. Building on this foundation, Decoupled Clip and Dynamic Sampling Policy Optimization (DAPO) leverages task-specific reward signals for report generation, visual question answering (VQA), and spatial grounding, directly optimizing the clinical quality metrics that matter in practice. The result is state-of-the-art performance on the majority of metrics across four report-generation benchmarks, 94.0% VQA accuracy on ReXVQA (+6.0 pp over the next-best baseline), and generative spatial decoding that reaches near parity with dedicated detection heads. Separately, to address measurement-dependent diagnoses, we couple Qwen3-VL-4B-Instruct with native tool-calling capabilities for invoking deterministic measurement tools, while retaining full visual access to the image. This hybrid inference yields +43.6 pp average F1 over perception-only baselines across five measurement-dependent conditions."}],"geoLocations":[],"fundingReferences":[],"url":"https://arxiv.org/abs/2608.03890","contentUrl":null,"metadataVersion":0,"schemaVersion":"http://datacite.org/schema/kernel-4","source":"mds","isActive":true,"state":"findable","reason":null,"viewCount":0,"downloadCount":0,"referenceCount":0,"citationCount":0,"partCount":0,"partOfCount":0,"versionCount":0,"versionOfCount":0,"created":"2026-08-05T02:23:20Z","registered":"2026-08-05T02:23:21Z","published":null,"updated":"2026-08-05T02:23:21Z"},"relationships":{"client":{"data":{"id":"arxiv.content","type":"clients"}}}},{"id":"10.48550/arxiv.2608.03889","type":"dois","attributes":{"doi":"10.48550/arxiv.2608.03889","identifiers":[{"identifier":"2608.03889","identifierType":"arXiv"}],"creators":[{"nameType":"Personal","givenName":"Chase","familyName":"Mathis","name":"Mathis, Chase","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Ian","familyName":"Waudby-Smith","name":"Waudby-Smith, Ian","affiliation":[],"nameIdentifiers":[]}],"titles":[{"title":"Confidence Horizons"}],"publisher":"arXiv","container":{},"publicationYear":2026,"subjects":[{"subject":"Methodology (stat.ME)","lang":"en","subjectScheme":"arXiv"},{"subject":"Statistics Theory (math.ST)","lang":"en","subjectScheme":"arXiv"},{"subject":"Machine Learning (stat.ML)","lang":"en","subjectScheme":"arXiv"},{"subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"},{"subject":"FOS: Mathematics","subjectScheme":"Fields of Science and Technology (FOS)"}],"contributors":[],"dates":[{"date":"2026-08-04T16:23:12Z","dateType":"Submitted","dateInformation":"v1"},{"date":"2026-08-05T01:04:15Z","dateType":"Updated","dateInformation":"v1"},{"date":"2026-08","dateType":"Available","dateInformation":"v1"}],"language":null,"types":{"schemaOrg":"CreativeWork","resourceTypeGeneral":"Preprint","citeproc":"article","bibtex":"misc","ris":"GEN","resourceType":"Article"},"relatedIdentifiers":[],"relatedItems":[],"sizes":[],"formats":[],"version":"1","rightsList":[{"rightsIdentifierScheme":"SPDX","rightsUri":"https://creativecommons.org/licenses/by-sa/4.0/legalcode","schemeUri":"https://spdx.org/licenses/","rights":"Creative Commons Attribution Share Alike 4.0 International","rightsIdentifier":"cc-by-sa-4.0"}],"descriptions":[{"descriptionType":"Abstract","description":"Anytime-valid inference enables analysts to continuously monitor their data and stop experiments early. However, the majority of these methods incur a certain conservativeness by remaining valid on infinite time horizons. In practice, a bound on the horizon may be imposed due to budgetary, practical, or ethical constraints. In this paper, we ask the question: \"Is it possible to obtain sharper large-sample anytime-valid inference by forgoing validity beyond some finite time horizon?\". We provide a positive answer to this question by proposing a family of statistical objects that we call \"confidence horizons\". These objects can be viewed as large-sample confidence sequences on bounded time horizons, or alternatively as group sequential repeated confidence intervals with a maximal number of interim peeking times. We make explicit connections to the group sequential boundaries of Pocock [1977], O'Brien--Fleming [1979], and Wang--Tsiatis [1987]. We derive closed-form distribution functions of certain statistics which can be used to calculate the asymptotic quantiles of confidence horizons exactly, sidestepping the repeated integration typically employed in group sequential methods. We illustrate the use of confidence horizons for treatment effect estimation in sequentially randomized experiments under adaptive Neyman allocation."},{"descriptionType":"Other","description":"63 pages, 18 figures"}],"geoLocations":[],"fundingReferences":[],"url":"https://arxiv.org/abs/2608.03889","contentUrl":null,"metadataVersion":0,"schemaVersion":"http://datacite.org/schema/kernel-4","source":"mds","isActive":true,"state":"findable","reason":null,"viewCount":0,"downloadCount":0,"referenceCount":0,"citationCount":0,"partCount":0,"partOfCount":0,"versionCount":0,"versionOfCount":0,"created":"2026-08-05T02:23:19Z","registered":"2026-08-05T02:23:20Z","published":null,"updated":"2026-08-05T02:23:20Z"},"relationships":{"client":{"data":{"id":"arxiv.content","type":"clients"}}}},{"id":"10.48550/arxiv.2608.03886","type":"dois","attributes":{"doi":"10.48550/arxiv.2608.03886","identifiers":[{"identifier":"2608.03886","identifierType":"arXiv"}],"creators":[{"nameType":"Personal","givenName":"Qilong","familyName":"Guo","name":"Guo, Qilong","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Chunxing","familyName":"Yan","name":"Yan, Chunxing","affiliation":[],"nameIdentifiers":[]}],"titles":[{"title":"Unbounded Gaps Between Ordinary and Equivariant Dehn Surgery Numbers"}],"publisher":"arXiv","container":{},"publicationYear":2026,"subjects":[{"subject":"Geometric Topology (math.GT)","lang":"en","subjectScheme":"arXiv"},{"subject":"FOS: Mathematics","subjectScheme":"Fields of Science and Technology (FOS)"},{"subject":"57K30, 57M60, 57K10","lang":"en","subjectScheme":"MSC"}],"contributors":[],"dates":[{"date":"2026-08-04T16:22:11Z","dateType":"Submitted","dateInformation":"v1"},{"date":"2026-08-05T01:04:12Z","dateType":"Updated","dateInformation":"v1"},{"date":"2026-08","dateType":"Available","dateInformation":"v1"}],"language":null,"types":{"schemaOrg":"CreativeWork","resourceTypeGeneral":"Preprint","citeproc":"article","bibtex":"misc","ris":"GEN","resourceType":"Article"},"relatedIdentifiers":[],"relatedItems":[],"sizes":[],"formats":[],"version":"1","rightsList":[{"rightsIdentifierScheme":"SPDX","rightsUri":"https://creativecommons.org/licenses/by/4.0/legalcode","schemeUri":"https://spdx.org/licenses/","rights":"Creative Commons Attribution 4.0 International","rightsIdentifier":"cc-by-4.0"}],"descriptions":[{"descriptionType":"Abstract","description":"For a closed oriented $3$-manifold $Y$ and an orientation-preserving involution $τ$, let $\\DS(Y)$ denote the minimum number of components in an integral surgery description of $Y$, and let $\\EDS(Y,τ)$ denote the corresponding minimum among periodic surgery descriptions inducing $τ$. We prove that for every integer $k\\geq 1$ there is a pair $(Y_k,τ_k)$ such that \\[\n \\DS(Y_k)=k,\n \\qquad\n \\EDS(Y_k,τ_k)=2k. \\] Consequently, the difference $\\EDS(Y,τ)-\\DS(Y)$ is unbounded even when $τ$ is an involution. This answers Problems~1.15(b) and~1.15(c) in the K3 problem list. We also construct infinitely many pairwise nonhomeomorphic irreducible lens spaces $Z$ admitting involutions $σ$ for which \\[\n \\DS(Z)\u0026lt;\\EDS(Z,σ). \\]"},{"descriptionType":"Other","description":"12 pages, no figures"}],"geoLocations":[],"fundingReferences":[],"url":"https://arxiv.org/abs/2608.03886","contentUrl":null,"metadataVersion":0,"schemaVersion":"http://datacite.org/schema/kernel-4","source":"mds","isActive":true,"state":"findable","reason":null,"viewCount":0,"downloadCount":0,"referenceCount":0,"citationCount":0,"partCount":0,"partOfCount":0,"versionCount":0,"versionOfCount":0,"created":"2026-08-05T02:23:15Z","registered":null,"published":null,"updated":"2026-08-05T02:23:16Z"},"relationships":{"client":{"data":{"id":"arxiv.content","type":"clients"}}}},{"id":"10.48550/arxiv.2608.03885","type":"dois","attributes":{"doi":"10.48550/arxiv.2608.03885","identifiers":[{"identifier":"2608.03885","identifierType":"arXiv"}],"creators":[{"nameType":"Personal","givenName":"Gengyuan","familyName":"Liu","name":"Liu, Gengyuan","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Nanzhou","familyName":"Wang","name":"Wang, Nanzhou","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Chang","familyName":"Liu","name":"Liu, Chang","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Qinwen","familyName":"Wu","name":"Wu, Qinwen","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Zhenhao","familyName":"Wang","name":"Wang, Zhenhao","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Jiacong","familyName":"Wang","name":"Wang, Jiacong","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Bokui","familyName":"Chen","name":"Chen, Bokui","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Xiangyang","familyName":"Ji","name":"Ji, Xiangyang","affiliation":[],"nameIdentifiers":[]}],"titles":[{"title":"MuRA: Multi-Rank Adaptation for Efficient and Effective Test-Time Vision-Language Generalization"}],"publisher":"arXiv","container":{},"publicationYear":2026,"subjects":[{"subject":"Computer Vision and Pattern Recognition (cs.CV)","lang":"en","subjectScheme":"arXiv"},{"subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"}],"contributors":[],"dates":[{"date":"2026-08-04T16:20:54Z","dateType":"Submitted","dateInformation":"v1"},{"date":"2026-08-05T01:04:11Z","dateType":"Updated","dateInformation":"v1"},{"date":"2026-08","dateType":"Available","dateInformation":"v1"}],"language":null,"types":{"schemaOrg":"CreativeWork","resourceTypeGeneral":"Preprint","citeproc":"article","bibtex":"misc","ris":"GEN","resourceType":"Article"},"relatedIdentifiers":[],"relatedItems":[],"sizes":[],"formats":[],"version":"1","rightsList":[{"rightsIdentifierScheme":"SPDX","rightsUri":"https://creativecommons.org/licenses/by/4.0/legalcode","schemeUri":"https://spdx.org/licenses/","rights":"Creative Commons Attribution 4.0 International","rightsIdentifier":"cc-by-4.0"}],"descriptions":[{"descriptionType":"Abstract","description":"Vision-language models exhibit remarkable zero-shot capabilities but suffer significant performance degradation under distribution shifts. While test-time adaptation (TTA) via Low-Rank Adaptation offers a parameter-efficient solution, we identify a fundamental bottleneck in current methods: the reliance on static rank configurations. Because visual inputs inherently possess varying information densities, a fixed rank forces an inevitable optimization compromise, leading to underfitting on complex scenes and overfitting on simple ones. To bridge this gap, we propose Multi-Rank Adaptation (MuRA), a novel framework that dynamically selects and fuses adaptation modules of varying capacities based on token-level visual complexity. MuRA synergizes Multi-Rank Orthogonal Decomposition to provide a superior, knowledge-preserving initialization, and Unified Component Fusion with Continuous Router Updating to sustainably learn semantic-to-rank mappings. Furthermore, we provide rigorous theoretical justifications mathematically proving the necessity and gradient stability of this adaptive mechanism. Crucially, MuRA's dynamic design uniquely thrives at the deepest visual layer, capitalizing on the shortest gradient backpropagation path. Extensive experiments demonstrate that MuRA achieves state-of-the-art accuracy across extensive domain generalization and cross-dataset benchmarks while significantly reducing both computational and memory overhead."}],"geoLocations":[],"fundingReferences":[],"url":"https://arxiv.org/abs/2608.03885","contentUrl":null,"metadataVersion":0,"schemaVersion":"http://datacite.org/schema/kernel-4","source":"mds","isActive":true,"state":"findable","reason":null,"viewCount":0,"downloadCount":0,"referenceCount":0,"citationCount":0,"partCount":0,"partOfCount":0,"versionCount":0,"versionOfCount":0,"created":"2026-08-05T02:23:14Z","registered":"2026-08-05T02:23:14Z","published":null,"updated":"2026-08-05T02:23:14Z"},"relationships":{"client":{"data":{"id":"arxiv.content","type":"clients"}}}},{"id":"10.48550/arxiv.2608.03884","type":"dois","attributes":{"doi":"10.48550/arxiv.2608.03884","identifiers":[{"identifier":"2608.03884","identifierType":"arXiv"}],"creators":[{"nameType":"Personal","givenName":"Sadab","familyName":"Shiper","name":"Shiper, Sadab","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Tawsif Tashwar","familyName":"Dipto","name":"Dipto, Tawsif Tashwar","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Mir Md","familyName":"Inzamam","name":"Inzamam, Mir Md","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Eshat","familyName":"Tanzeem","name":"Tanzeem, Eshat","affiliation":[],"nameIdentifiers":[]}],"titles":[{"title":"BanglaWild: An In-the-Wild Bengali Scene Text Recognition Benchmark for OCR and Vision-Language Models"}],"publisher":"arXiv","container":{},"publicationYear":2026,"subjects":[{"subject":"Computer Vision and Pattern Recognition (cs.CV)","lang":"en","subjectScheme":"arXiv"},{"subject":"Computation and Language (cs.CL)","lang":"en","subjectScheme":"arXiv"},{"subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"}],"contributors":[],"dates":[{"date":"2026-08-04T16:20:53Z","dateType":"Submitted","dateInformation":"v1"},{"date":"2026-08-05T01:04:10Z","dateType":"Updated","dateInformation":"v1"},{"date":"2026-08","dateType":"Available","dateInformation":"v1"}],"language":null,"types":{"schemaOrg":"CreativeWork","resourceTypeGeneral":"Preprint","citeproc":"article","bibtex":"misc","ris":"GEN","resourceType":"Article"},"relatedIdentifiers":[],"relatedItems":[],"sizes":[],"formats":[],"version":"1","rightsList":[{"rightsIdentifierScheme":"SPDX","rightsUri":"https://creativecommons.org/licenses/by-nc-sa/4.0/legalcode","schemeUri":"https://spdx.org/licenses/","rights":"Creative Commons Attribution Non Commercial Share Alike 4.0 International","rightsIdentifier":"cc-by-nc-sa-4.0"}],"descriptions":[{"descriptionType":"Abstract","description":"In-the-wild Bengali scene text recognition is largely unmeasured: existing resources target handwritten documents or constrained sign-board parsing, report only aggregate edit-distance metrics, and evaluate either conventional OCR or VLMs, never both on the same in-the-wild data. To address this gap, we introduce BANGLAWILD, a benchmark of 2,535 Bengali scene text images, each paired with a verbatim gold transcription, two categorical axes, four diagnostic attributes, and an orthographically standard form where the in-image text deviates from canonical spelling. We evaluate fifteen VLMs and three conventional OCR systems under three prompting strategies, fine-tune 6 open-source models with LoRA, and complement edit-distance metrics with an LLM-as-a-Judge evaluation. Our results reveal a persistent gap in which larger models within the same family do not outperform smaller ones. Our fifteen-class error taxonomy shows that visual mis-recognition accounts for ~60% of errors in the strongest systems, while conjunct-related errors contribute under 2%, challenging a long-standing assumption in Bengali OCR research; the same visual dominant profile also holds across architectures, including the one conventional baseline that reads Bengali reliably. Prompt language mainly affects cross-script drift and LoRA reduces catastrophic failures in weak models without lifting the ceiling on already competent ones. Code and data will be publicly released."}],"geoLocations":[],"fundingReferences":[],"url":"https://arxiv.org/abs/2608.03884","contentUrl":null,"metadataVersion":0,"schemaVersion":"http://datacite.org/schema/kernel-4","source":"mds","isActive":true,"state":"findable","reason":null,"viewCount":0,"downloadCount":0,"referenceCount":0,"citationCount":0,"partCount":0,"partOfCount":0,"versionCount":0,"versionOfCount":0,"created":"2026-08-05T02:23:12Z","registered":"2026-08-05T02:23:13Z","published":null,"updated":"2026-08-05T02:23:13Z"},"relationships":{"client":{"data":{"id":"arxiv.content","type":"clients"}}}},{"id":"10.48550/arxiv.2608.03883","type":"dois","attributes":{"doi":"10.48550/arxiv.2608.03883","identifiers":[{"identifier":"2608.03883","identifierType":"arXiv"}],"creators":[{"nameType":"Personal","givenName":"David","familyName":"Guecha","name":"Guecha, David","affiliation":[],"nameIdentifiers":[]}],"titles":[{"title":"DS@GT-ARC at eRisk 2026 Task 3: Sparse, Semantic, and LLM Reranking for ADHD Symptom Sentences"}],"publisher":"arXiv","container":{},"publicationYear":2026,"subjects":[{"subject":"Computation and Language (cs.CL)","lang":"en","subjectScheme":"arXiv"},{"subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"}],"contributors":[],"dates":[{"date":"2026-08-04T16:19:22Z","dateType":"Submitted","dateInformation":"v1"},{"date":"2026-08-05T01:04:02Z","dateType":"Updated","dateInformation":"v1"},{"date":"2026-08","dateType":"Available","dateInformation":"v1"}],"language":null,"types":{"schemaOrg":"CreativeWork","resourceTypeGeneral":"Preprint","citeproc":"article","bibtex":"misc","ris":"GEN","resourceType":"Article"},"relatedIdentifiers":[],"relatedItems":[],"sizes":[],"formats":[],"version":"1","rightsList":[{"rightsIdentifierScheme":"SPDX","rightsUri":"https://creativecommons.org/licenses/by-nc-sa/4.0/legalcode","schemeUri":"https://spdx.org/licenses/","rights":"Creative Commons Attribution Non Commercial Share Alike 4.0 International","rightsIdentifier":"cc-by-nc-sa-4.0"}],"descriptions":[{"descriptionType":"Abstract","description":"This paper describes our submissions to eRisk 2026 Task 3, ADHD Symptom Sentence Ranking. The task requires systems to rank candidate Reddit sentences according to their relevance to each of the 18 symptoms in the Adult ADHD Self-Report Scale (ASRS-v1.1). Because no annotated training data were released for this first edition of the task, we relied on zero-shot experimentation, manual validation, and unsupervised or weakly guided retrieval pipelines. Our systems combine sparse BM25 retrieval, evidence-aware rescoring for self-referential symptom reports, embedding-based reranking, query-prototype expansion, and LLM-based reranking. All submitted systems follow a staged retrieval design in which BM25 retrieves candidates at scale and semantic or LLM rerankers refine the final rankings. Among our submissions, the LLM reranker achieved the strongest official scores, followed by the prototype query-expansion run. Our manual top-10 analysis aligned with the official expert scoring trend, suggesting that staged reranking is a promising direction for further development."}],"geoLocations":[],"fundingReferences":[],"url":"https://arxiv.org/abs/2608.03883","contentUrl":null,"metadataVersion":0,"schemaVersion":"http://datacite.org/schema/kernel-4","source":"mds","isActive":true,"state":"findable","reason":null,"viewCount":0,"downloadCount":0,"referenceCount":0,"citationCount":0,"partCount":0,"partOfCount":0,"versionCount":0,"versionOfCount":0,"created":"2026-08-05T02:23:11Z","registered":"2026-08-05T02:23:12Z","published":null,"updated":"2026-08-05T02:23:12Z"},"relationships":{"client":{"data":{"id":"arxiv.content","type":"clients"}}}},{"id":"10.48550/arxiv.2608.03880","type":"dois","attributes":{"doi":"10.48550/arxiv.2608.03880","identifiers":[{"identifier":"2608.03880","identifierType":"arXiv"}],"creators":[{"nameType":"Personal","givenName":"Niklas","familyName":"Enskat","name":"Enskat, Niklas","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Philipp","familyName":"Wiesner","name":"Wiesner, Philipp","affiliation":[],"nameIdentifiers":[]}],"titles":[{"title":"Evaluating MFU as a Proxy for GPU Power for Energy-Aware Simulation of LLM Training"}],"publisher":"arXiv","container":{},"publicationYear":2026,"subjects":[{"subject":"Performance (cs.PF)","lang":"en","subjectScheme":"arXiv"},{"subject":"Distributed, Parallel, and Cluster Computing (cs.DC)","lang":"en","subjectScheme":"arXiv"},{"subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"}],"contributors":[],"dates":[{"date":"2026-08-04T16:17:53Z","dateType":"Submitted","dateInformation":"v1"},{"date":"2026-08-05T01:03:52Z","dateType":"Updated","dateInformation":"v1"},{"date":"2026-08","dateType":"Available","dateInformation":"v1"}],"language":null,"types":{"schemaOrg":"CreativeWork","resourceTypeGeneral":"Preprint","citeproc":"article","bibtex":"misc","ris":"GEN","resourceType":"Article"},"relatedIdentifiers":[],"relatedItems":[],"sizes":[],"formats":[],"version":"1","rightsList":[{"rightsUri":"http://arxiv.org/licenses/nonexclusive-distrib/1.0/","rights":"arXiv.org perpetual, non-exclusive license"}],"descriptions":[{"descriptionType":"Abstract","description":"High-fidelity performance simulators are essential for designing and configuring efficient AI systems, yet today's tools lack the ability to predict power consumption. Established GPU power models rely on hardware utilization counters, which do not exist until the workload has actually run. This work evaluates whether Model FLOPs Utilization (MFU)-an analytical, software-defined metric relating achieved throughput to peak hardware capability-can serve as a portable, software-defined predictor of GPU power for LLMs. We benchmark almost 3000 single-device training runs across six GPUs, covering different model families, numerical precisions, batch sizes, and context-window lengths. We find that a linear MFU-based power model fits every tested GPU as long as the workload is compute-bound, as in production LLM training. Fitting per-(GPU, dtype, batch size) instead of per-GPU drops the within-cell mean error from around 10% to around 1%, matching the cross-repeat measurement-noise floor."},{"descriptionType":"Other","description":"Accepted at MASCOTS 2026"}],"geoLocations":[],"fundingReferences":[],"url":"https://arxiv.org/abs/2608.03880","contentUrl":null,"metadataVersion":0,"schemaVersion":"http://datacite.org/schema/kernel-4","source":"mds","isActive":true,"state":"findable","reason":null,"viewCount":0,"downloadCount":0,"referenceCount":0,"citationCount":0,"partCount":0,"partOfCount":0,"versionCount":0,"versionOfCount":0,"created":"2026-08-05T02:23:07Z","registered":"2026-08-05T02:23:08Z","published":null,"updated":"2026-08-05T02:23:08Z"},"relationships":{"client":{"data":{"id":"arxiv.content","type":"clients"}}}},{"id":"10.48550/arxiv.2608.03879","type":"dois","attributes":{"doi":"10.48550/arxiv.2608.03879","identifiers":[{"identifier":"2608.03879","identifierType":"arXiv"}],"creators":[{"nameType":"Personal","givenName":"Luca Nils","familyName":"Philipp","name":"Philipp, Luca Nils","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Tomislav","familyName":"Begušić","name":"Begušić, Tomislav","affiliation":[],"nameIdentifiers":[]}],"titles":[{"title":"High-Order Response Functions with Duschinsky Coupling and Finite Temperature: Application to Two-Dimensional Resonance Raman Spectroscopy"}],"publisher":"arXiv","container":{},"publicationYear":2026,"subjects":[{"subject":"Chemical Physics (physics.chem-ph)","lang":"en","subjectScheme":"arXiv"},{"subject":"FOS: Physical sciences","subjectScheme":"Fields of Science and Technology (FOS)"}],"contributors":[],"dates":[{"date":"2026-08-04T16:17:31Z","dateType":"Submitted","dateInformation":"v1"},{"date":"2026-08-05T01:03:51Z","dateType":"Updated","dateInformation":"v1"},{"date":"2026-08","dateType":"Available","dateInformation":"v1"}],"language":null,"types":{"schemaOrg":"CreativeWork","resourceTypeGeneral":"Preprint","citeproc":"article","bibtex":"misc","ris":"GEN","resourceType":"Article"},"relatedIdentifiers":[],"relatedItems":[],"sizes":[],"formats":[],"version":"1","rightsList":[{"rightsIdentifierScheme":"SPDX","rightsUri":"https://creativecommons.org/licenses/by/4.0/legalcode","schemeUri":"https://spdx.org/licenses/","rights":"Creative Commons Attribution 4.0 International","rightsIdentifier":"cc-by-4.0"}],"descriptions":[{"descriptionType":"Abstract","description":"In this work, we derive closed-form expressions for multi-time correlation functions underlying higher-order nonlinear spectroscopic response functions within the harmonic approximation. Our method includes displacements, frequency changes, and Duschinsky rotation between the vibrational modes of different electronic states while retaining polynomial scaling with the number of degrees of freedom. Finite temperature is accounted for without summation over vibrational eigenstates. To show the capabilities of our method, we apply it to calculate fifth-order two-dimensional resonance Raman (2DRR) spectra of two-mode model systems and naphthalene. Comparison with the displaced harmonic oscillator model shows that Duschinsky rotation modifies the positions and relative intensities of diagonal and cross peaks. Overall, our results demonstrate that 2DRR spectroscopy is particularly sensitive to changes in normal coordinates between electronic states and can provide distinct signatures of Duschinsky coupling in molecular systems."}],"geoLocations":[],"fundingReferences":[],"url":"https://arxiv.org/abs/2608.03879","contentUrl":null,"metadataVersion":0,"schemaVersion":"http://datacite.org/schema/kernel-4","source":"mds","isActive":true,"state":"findable","reason":null,"viewCount":0,"downloadCount":0,"referenceCount":0,"citationCount":0,"partCount":0,"partOfCount":0,"versionCount":0,"versionOfCount":0,"created":"2026-08-05T02:23:06Z","registered":"2026-08-05T02:23:07Z","published":null,"updated":"2026-08-05T02:23:07Z"},"relationships":{"client":{"data":{"id":"arxiv.content","type":"clients"}}}},{"id":"10.48550/arxiv.2608.03878","type":"dois","attributes":{"doi":"10.48550/arxiv.2608.03878","identifiers":[{"identifier":"2608.03878","identifierType":"arXiv"}],"creators":[{"nameType":"Personal","givenName":"Chenhan","familyName":"Xiao","name":"Xiao, Chenhan","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Xinyu","familyName":"He","name":"He, Xinyu","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Haoran","familyName":"Li","name":"Li, Haoran","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Hanghang","familyName":"Tong","name":"Tong, Hanghang","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Yang","familyName":"Weng","name":"Weng, Yang","affiliation":[],"nameIdentifiers":[]}],"titles":[{"title":"Operationally Feasible Synthetic Power-Grid Scenarios via Learning the AC-Operable Joint Distribution"}],"publisher":"arXiv","container":{},"publicationYear":2026,"subjects":[{"subject":"Machine Learning (cs.LG)","lang":"en","subjectScheme":"arXiv"},{"subject":"Systems and Control (eess.SY)","lang":"en","subjectScheme":"arXiv"},{"subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"},{"subject":"FOS: Electrical engineering, electronic engineering, information engineering","subjectScheme":"Fields of Science and Technology (FOS)"}],"contributors":[],"dates":[{"date":"2026-08-04T16:17:15Z","dateType":"Submitted","dateInformation":"v1"},{"date":"2026-08-05T01:03:50Z","dateType":"Updated","dateInformation":"v1"},{"date":"2026-08","dateType":"Available","dateInformation":"v1"}],"language":null,"types":{"schemaOrg":"CreativeWork","resourceTypeGeneral":"Preprint","citeproc":"article","bibtex":"misc","ris":"GEN","resourceType":"Article"},"relatedIdentifiers":[],"relatedItems":[],"sizes":[],"formats":[],"version":"1","rightsList":[{"rightsIdentifierScheme":"SPDX","rightsUri":"https://creativecommons.org/licenses/by/4.0/legalcode","schemeUri":"https://spdx.org/licenses/","rights":"Creative Commons Attribution 4.0 International","rightsIdentifier":"cc-by-4.0"}],"descriptions":[{"descriptionType":"Abstract","description":"Synthetic power-grid scenarios are essential for planning, resilience assessment, contingency analysis, and data-driven power-system applications. Recent synthetic grid generation methods have improved structural realism and operational feasibility by incorporating engineering knowledge through post-generation validation, optimization, or physics-aware generation. However, generated scenarios may still exhibit low AC feasibility and robustness, limiting their practical value for downstream power-system studies. This paper proposes a feasibility-aware distribution-learning framework that learns the AC-operable joint distribution of network topology, branch electrical parameters, and time-varying load profiles. Instead of enforcing feasibility after generation, the proposed framework incorporates AC power-flow convergence and operational constraints into hierarchical diffusion-based distribution learning. This enables the generator itself to produce operationally feasible grid scenarios through efficient diffusion sampling. The hierarchical architecture decomposes the high-dimensional generation task into three engineering-motivated stages: topology and bus-attribute generation, branch-parameter generation conditioned on the generated structure, and load-profile generation conditioned on both network structure and electrical characteristics. Experiments on benchmark systems demonstrate that the proposed framework significantly improves operational feasibility and contingency robustness while maintaining strong statistical fidelity and eliminating optimization-based post-processing."},{"descriptionType":"Other","description":"10 pages, 10 figures, journal submission"}],"geoLocations":[],"fundingReferences":[],"url":"https://arxiv.org/abs/2608.03878","contentUrl":null,"metadataVersion":0,"schemaVersion":"http://datacite.org/schema/kernel-4","source":"mds","isActive":true,"state":"findable","reason":null,"viewCount":0,"downloadCount":0,"referenceCount":0,"citationCount":0,"partCount":0,"partOfCount":0,"versionCount":0,"versionOfCount":0,"created":"2026-08-05T02:23:04Z","registered":"2026-08-05T02:23:05Z","published":null,"updated":"2026-08-05T02:23:05Z"},"relationships":{"client":{"data":{"id":"arxiv.content","type":"clients"}}}},{"id":"10.48550/arxiv.2608.03876","type":"dois","attributes":{"doi":"10.48550/arxiv.2608.03876","identifiers":[{"identifier":"2608.03876","identifierType":"arXiv"}],"creators":[{"nameType":"Personal","givenName":"Paul","familyName":"Rogozenski","name":"Rogozenski, Paul","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Sankarshana","familyName":"Srinivasan","name":"Srinivasan, Sankarshana","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Javier","familyName":"Sánchez","name":"Sánchez, Javier","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Nora Elisa","familyName":"Chisari","name":"Chisari, Nora Elisa","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Arthur","familyName":"Loureiro","name":"Loureiro, Arthur","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Marc","familyName":"Paterno","name":"Paterno, Marc","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Rebekah","familyName":"Polen","name":"Polen, Rebekah","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Heather","familyName":"Prince","name":"Prince, Heather","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Biancamaria","familyName":"Sersante","name":"Sersante, Biancamaria","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Anže","familyName":"Slosar","name":"Slosar, Anže","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Sandro","familyName":"Vitenti","name":"Vitenti, Sandro","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Carlos","familyName":"García-García","name":"García-García, Carlos","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Eric","familyName":"Gawiser","name":"Gawiser, Eric","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Christos","familyName":"Georgiou","name":"Georgiou, Christos","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"C. Danielle","familyName":"Leonard","name":"Leonard, C. Danielle","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Ayan","familyName":"Mitra","name":"Mitra, Ayan","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Jeremy","familyName":"Neveu","name":"Neveu, Jeremy","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"The LSST Dark Energy Science","familyName":"Collaboration","name":"Collaboration, The LSST Dark Energy Science","affiliation":[],"nameIdentifiers":[]}],"titles":[{"title":"Fisher Forecasting for the DESC with $\\texttt{Augur}$"}],"publisher":"arXiv","container":{},"publicationYear":2026,"subjects":[{"subject":"Cosmology and Nongalactic Astrophysics (astro-ph.CO)","lang":"en","subjectScheme":"arXiv"},{"subject":"FOS: Physical sciences","subjectScheme":"Fields of Science and Technology (FOS)"}],"contributors":[],"dates":[{"date":"2026-08-04T16:15:51Z","dateType":"Submitted","dateInformation":"v1"},{"date":"2026-08-05T01:03:48Z","dateType":"Updated","dateInformation":"v1"},{"date":"2026-08","dateType":"Available","dateInformation":"v1"}],"language":null,"types":{"schemaOrg":"CreativeWork","resourceTypeGeneral":"Preprint","citeproc":"article","bibtex":"misc","ris":"GEN","resourceType":"Article"},"relatedIdentifiers":[],"relatedItems":[],"sizes":[],"formats":[],"version":"1","rightsList":[{"rightsIdentifierScheme":"SPDX","rightsUri":"https://creativecommons.org/licenses/by/4.0/legalcode","schemeUri":"https://spdx.org/licenses/","rights":"Creative Commons Attribution 4.0 International","rightsIdentifier":"cc-by-4.0"}],"descriptions":[{"descriptionType":"Abstract","description":"The Vera C. Rubin Observatory Legacy Survey of Space and Time (LSST) has begun its ten-year survey of the entire visible southern hemisphere. To ensure robust cosmological measurements, computationally inexpensive investigations of modeling choices must be made to gauge the performance of proposed cosmological analyses. In this paper, we introduce the $\\texttt{Augur}$ tool of the Dark Energy Science Collaboration (DESC), which provides Fisher forecasts for cosmological inference for the LSST using software frameworks designed for DESC science. We test the pipeline by comparing it to forecasts produced by external code and direct sampling of the posterior via nested sampling methods, finding good agreement between all methods. We additionally investigate a range of modeling and hyperparameter choices for a 3$\\times$2pt investigation in harmonic space, providing users with diagnostics to obtain reliable forecasts. $\\texttt{Augur}$ will be continually updated to be compatible with the other tools in the DESC software ecosystem as additional probes and functionality become available."},{"descriptionType":"Other","description":"20 Pages, 9 Figures"}],"geoLocations":[],"fundingReferences":[],"url":"https://arxiv.org/abs/2608.03876","contentUrl":null,"metadataVersion":0,"schemaVersion":"http://datacite.org/schema/kernel-4","source":"mds","isActive":true,"state":"findable","reason":null,"viewCount":0,"downloadCount":0,"referenceCount":0,"citationCount":0,"partCount":0,"partOfCount":0,"versionCount":0,"versionOfCount":0,"created":"2026-08-05T02:23:01Z","registered":"2026-08-05T02:23:02Z","published":null,"updated":"2026-08-05T02:23:02Z"},"relationships":{"client":{"data":{"id":"arxiv.content","type":"clients"}}}},{"id":"10.48550/arxiv.2608.03875","type":"dois","attributes":{"doi":"10.48550/arxiv.2608.03875","identifiers":[{"identifier":"2608.03875","identifierType":"arXiv"}],"creators":[{"nameType":"Personal","givenName":"Pyrros","familyName":"Koussios","name":"Koussios, Pyrros","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Chenhao","familyName":"Li","name":"Li, Chenhao","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Xin","familyName":"Chen","name":"Chen, Xin","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Andreas","familyName":"Krause","name":"Krause, Andreas","affiliation":[],"nameIdentifiers":[]}],"titles":[{"title":"Enhancing VLM Reward Models Through Structure-Aware Fine-Tuning"}],"publisher":"arXiv","container":{},"publicationYear":2026,"subjects":[{"subject":"Machine Learning (cs.LG)","lang":"en","subjectScheme":"arXiv"},{"subject":"Artificial Intelligence (cs.AI)","lang":"en","subjectScheme":"arXiv"},{"subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"},{"subject":"I.2.6; I.2.9; I.2.10","lang":"en","subjectScheme":"ACM"}],"contributors":[],"dates":[{"date":"2026-08-04T16:15:12Z","dateType":"Submitted","dateInformation":"v1"},{"date":"2026-08-05T01:03:47Z","dateType":"Updated","dateInformation":"v1"},{"date":"2026-08","dateType":"Available","dateInformation":"v1"}],"language":null,"types":{"schemaOrg":"CreativeWork","resourceTypeGeneral":"Preprint","citeproc":"article","bibtex":"misc","ris":"GEN","resourceType":"Article"},"relatedIdentifiers":[],"relatedItems":[],"sizes":[],"formats":[],"version":"1","rightsList":[{"rightsUri":"http://arxiv.org/licenses/nonexclusive-distrib/1.0/","rights":"arXiv.org perpetual, non-exclusive license"}],"descriptions":[{"descriptionType":"Abstract","description":"Designing effective reward functions remains a major bottleneck in Reinforcement Learning (RL). Recent work uses large foundation Vision-Language Models (VLMs) as reward models, computing text-observation similarity to bypass manual reward engineering. Although promising, these rewards are often noisy and unreliable, limiting their direct utility during deployment. We present Structure-Aware Fine-Tuning (SAFT), a simple, self-supervised method that refines these imperfect reward signals online without access to ground-truth supervision. SAFT leverages intrinsic structural priors to regularize the VLM's latent space via LoRA adapters. We rigorously evaluate SAFT across a spectrum of base model capabilities to demonstrate its versatility. Our results show that SAFT consistently denoises the reward landscape, yielding faster policy convergence and substantially improved alignment (EPIC distance) relative to the underlying base model, suggesting that failures can often be attributed to structural brittleness rather than semantic misunderstanding. By replacing extensive human preference annotation with structural inductive biases inherent to the task, SAFT offers a scalable path for stabilizing text-conditioned RL and underscores the broader value of incorporating task structure as a general inductive bias."}],"geoLocations":[],"fundingReferences":[],"url":"https://arxiv.org/abs/2608.03875","contentUrl":null,"metadataVersion":0,"schemaVersion":"http://datacite.org/schema/kernel-4","source":"mds","isActive":true,"state":"findable","reason":null,"viewCount":0,"downloadCount":0,"referenceCount":0,"citationCount":0,"partCount":0,"partOfCount":0,"versionCount":0,"versionOfCount":0,"created":"2026-08-05T02:23:00Z","registered":"2026-08-05T02:23:01Z","published":null,"updated":"2026-08-05T02:23:01Z"},"relationships":{"client":{"data":{"id":"arxiv.content","type":"clients"}}}},{"id":"10.48550/arxiv.2608.03874","type":"dois","attributes":{"doi":"10.48550/arxiv.2608.03874","identifiers":[{"identifier":"2608.03874","identifierType":"arXiv"}],"creators":[{"nameType":"Personal","givenName":"Tianyi","familyName":"Guan","name":"Guan, Tianyi","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Yiding","familyName":"Wang","name":"Wang, Yiding","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Haotong","familyName":"Yang","name":"Yang, Haotong","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Siyuan","familyName":"Cao","name":"Cao, Siyuan","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Shirui","familyName":"Liu","name":"Liu, Shirui","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Yi","familyName":"Hu","name":"Hu, Yi","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Jiaqi","familyName":"Li","name":"Li, Jiaqi","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Muhan","familyName":"Zhang","name":"Zhang, Muhan","affiliation":[],"nameIdentifiers":[]}],"titles":[{"title":"ContinualSkillBench: Can LLM Agents Truly Evolve Their Capabilities?"}],"publisher":"arXiv","container":{},"publicationYear":2026,"subjects":[{"subject":"Artificial Intelligence (cs.AI)","lang":"en","subjectScheme":"arXiv"},{"subject":"Computation and Language (cs.CL)","lang":"en","subjectScheme":"arXiv"},{"subject":"Machine Learning (cs.LG)","lang":"en","subjectScheme":"arXiv"},{"subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"}],"contributors":[],"dates":[{"date":"2026-08-04T16:15:02Z","dateType":"Submitted","dateInformation":"v1"},{"date":"2026-08-05T01:03:46Z","dateType":"Updated","dateInformation":"v1"},{"date":"2026-08","dateType":"Available","dateInformation":"v1"}],"language":null,"types":{"schemaOrg":"CreativeWork","resourceTypeGeneral":"Preprint","citeproc":"article","bibtex":"misc","ris":"GEN","resourceType":"Article"},"relatedIdentifiers":[],"relatedItems":[],"sizes":[],"formats":[],"version":"1","rightsList":[{"rightsUri":"http://arxiv.org/licenses/nonexclusive-distrib/1.0/","rights":"arXiv.org perpetual, non-exclusive license"}],"descriptions":[{"descriptionType":"Abstract","description":"Modern agent frameworks equip large language models with external skill libraries to solve complex tasks. However, it remains unclear whether these systems can effectively evolve their skills and whether the resulting skills improve task-solving capabilities. To bridge this gap, we introduce ContinualSkillBench, a dynamic evaluation framework for in-context continual skill learning. It covers five representative domains, each containing 100 interconnected subtasks ordered by increasing difficulty and opportunities for cross-task skill reuse. Our experiments show that sequential execution generally improves performance, but the gains vary substantially across models and domains. Moreover, in-context learning performs comparably to explicit skill maintenance on average, suggesting that much of the improvement arises from adaptation to prior context and feedback rather than reusable skill abstraction alone. Explicit skills nevertheless provide selective benefits for tasks requiring reusable procedures or precise outputs. We further find that less capable models tend to accumulate larger, more fragmented collections of task-specific skills. These findings show that current in-context skill evolution mechanisms can support continual adaptation, but still struggle to consistently consolidate experience into robust and transferable skills."}],"geoLocations":[],"fundingReferences":[],"url":"https://arxiv.org/abs/2608.03874","contentUrl":null,"metadataVersion":0,"schemaVersion":"http://datacite.org/schema/kernel-4","source":"mds","isActive":true,"state":"findable","reason":null,"viewCount":0,"downloadCount":0,"referenceCount":0,"citationCount":0,"partCount":0,"partOfCount":0,"versionCount":0,"versionOfCount":0,"created":"2026-08-05T02:22:58Z","registered":null,"published":null,"updated":"2026-08-05T02:22:59Z"},"relationships":{"client":{"data":{"id":"arxiv.content","type":"clients"}}}},{"id":"10.48550/arxiv.2608.03873","type":"dois","attributes":{"doi":"10.48550/arxiv.2608.03873","identifiers":[{"identifier":"2608.03873","identifierType":"arXiv"}],"creators":[{"nameType":"Personal","givenName":"David","familyName":"Chamizo","name":"Chamizo, David","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Jose","familyName":"Garcia-Alonso","name":"Garcia-Alonso, Jose","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Juan M.","familyName":"Murillo","name":"Murillo, Juan M.","affiliation":[],"nameIdentifiers":[]}],"titles":[{"title":"High-level quantum structured programs as quantum registers compositions"}],"publisher":"arXiv","container":{},"publicationYear":2026,"subjects":[{"subject":"Quantum Physics (quant-ph)","lang":"en","subjectScheme":"arXiv"},{"subject":"Software Engineering (cs.SE)","lang":"en","subjectScheme":"arXiv"},{"subject":"FOS: Physical sciences","subjectScheme":"Fields of Science and Technology (FOS)"},{"subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"}],"contributors":[],"dates":[{"date":"2026-08-04T16:13:40Z","dateType":"Submitted","dateInformation":"v1"},{"date":"2026-08-05T01:03:35Z","dateType":"Updated","dateInformation":"v1"},{"date":"2026-08","dateType":"Available","dateInformation":"v1"}],"language":null,"types":{"schemaOrg":"CreativeWork","resourceTypeGeneral":"Preprint","citeproc":"article","bibtex":"misc","ris":"GEN","resourceType":"Article"},"relatedIdentifiers":[],"relatedItems":[],"sizes":[],"formats":[],"version":"1","rightsList":[{"rightsUri":"http://arxiv.org/licenses/nonexclusive-distrib/1.0/","rights":"arXiv.org perpetual, non-exclusive license"}],"descriptions":[{"descriptionType":"Abstract","description":"Current quantum programs are mainly designed at the level of quantum gates acting on individual qubits; on a large scale and for complex problems this may involve a high cognitive load on the programmer, making the program specification nontrivial and error-prone. In this context, providing quantum programming with higher abstraction mechanisms will assist in making this task more manageable and robust against design errors. In this work, a conceptual framework is addressed following the notion of the whole quantum computation as a structure composed of quantum registers representing each an undivided entity. Thus, computation progresses through semantically well-defined transformations that act on, or entangle, quantum registers, thereby modifying the global state. Ultimately, the program reaches the desired state by following a specific composition strategy. With this in mind, high-level syntax is presented through an algebraic formalism that bridges them with their low-level semantics. Proposed syntax is based on certain well-know operations used on quantum algorithms that apply phase shifts upon logical condition satisfaction or leverage on parallel evaluation. Based solely on the formalized operations, a quantum satisfiability modulo theories (SMT) solver can be designed. At its core, this work contributes to establishing some methodological principles towards realizing a high-level quantum structured programming."},{"descriptionType":"Other","description":"12 pages, 5 figures, Accepted for publication at IEEE International Conference on Quantum Computing and Engineering 2026 (QSYS track)"}],"geoLocations":[],"fundingReferences":[],"url":"https://arxiv.org/abs/2608.03873","contentUrl":null,"metadataVersion":0,"schemaVersion":"http://datacite.org/schema/kernel-4","source":"mds","isActive":true,"state":"findable","reason":null,"viewCount":0,"downloadCount":0,"referenceCount":0,"citationCount":0,"partCount":0,"partOfCount":0,"versionCount":0,"versionOfCount":0,"created":"2026-08-05T02:22:57Z","registered":"2026-08-05T02:22:58Z","published":null,"updated":"2026-08-05T02:22:58Z"},"relationships":{"client":{"data":{"id":"arxiv.content","type":"clients"}}}},{"id":"10.48550/arxiv.2608.03872","type":"dois","attributes":{"doi":"10.48550/arxiv.2608.03872","identifiers":[{"identifier":"2608.03872","identifierType":"arXiv"}],"creators":[{"nameType":"Personal","givenName":"Shuoqin","familyName":"Zhang","name":"Zhang, Shuoqin","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Tongtong","familyName":"Cheng","name":"Cheng, Tongtong","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Xiru","familyName":"Gao","name":"Gao, Xiru","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Jinzhuo","familyName":"Peng","name":"Peng, Jinzhuo","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Bin","familyName":"Zheng","name":"Zheng, Bin","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Jiahao","familyName":"Tu","name":"Tu, Jiahao","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Ke","familyName":"Wang","name":"Wang, Ke","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Jia","familyName":"Pan","name":"Pan, Jia","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Zhe","familyName":"Hu","name":"Hu, Zhe","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Kai","familyName":"Liu","name":"Liu, Kai","affiliation":[],"nameIdentifiers":[]}],"titles":[{"title":"EvoHIL: Self-Evolving Reward and Flow-Matched Policy Optimization for Robust Human-in-the-Loop Reinforcement Learning"}],"publisher":"arXiv","container":{},"publicationYear":2026,"subjects":[{"subject":"Robotics (cs.RO)","lang":"en","subjectScheme":"arXiv"},{"subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"}],"contributors":[],"dates":[{"date":"2026-08-04T16:12:05Z","dateType":"Submitted","dateInformation":"v1"},{"date":"2026-08-05T01:03:26Z","dateType":"Updated","dateInformation":"v1"},{"date":"2026-08","dateType":"Available","dateInformation":"v1"}],"language":null,"types":{"schemaOrg":"CreativeWork","resourceTypeGeneral":"Preprint","citeproc":"article","bibtex":"misc","ris":"GEN","resourceType":"Article"},"relatedIdentifiers":[],"relatedItems":[],"sizes":[],"formats":[],"version":"1","rightsList":[{"rightsUri":"http://arxiv.org/licenses/nonexclusive-distrib/1.0/","rights":"arXiv.org perpetual, non-exclusive license"}],"descriptions":[{"descriptionType":"Abstract","description":"Human-in-the-loop reinforcement learning (HIL-RL) enables robots to learn contact-rich manipulation from limited real-world interaction, but deployment exposes three coupled limitations: static visual reward models fail under scene changes; independently sampled actions cause temporally inconsistent motion; and vision-based policies remain sensitive to appearance shifts. We present EvoHIL, a unified framework that adapts the reward model, action generator, and visual do main within a staged human-in-the-loop learning process. First, self-evolving reward (SER) adapts the success classifier from human-confirmed positives and provisional weak negatives. Second, Action Flow Stabilization (AFS) generates temporally coherent action chunks through flow matching, grounding policy updates in executed action prefixes and demonstrated behavior. Third, retention-aware offline fine-tuning replays relit interaction data while anchoring the AFS actor-critic to prior behavior, adapting the visual domain without additional robot interaction. Across six manipulation tasks on Franka FR3 and SO-101 arms under a controlled lighting shift, EvoHIL improves task success, agreement with human-confirmation labels, motion smoothness, and completion time relative to human-in-the-loop and imitation baselines.Project page: https://anonymous4366.github.io/EvoHIL/"}],"geoLocations":[],"fundingReferences":[],"url":"https://arxiv.org/abs/2608.03872","contentUrl":null,"metadataVersion":0,"schemaVersion":"http://datacite.org/schema/kernel-4","source":"mds","isActive":true,"state":"findable","reason":null,"viewCount":0,"downloadCount":0,"referenceCount":0,"citationCount":0,"partCount":0,"partOfCount":0,"versionCount":0,"versionOfCount":0,"created":"2026-08-05T02:22:56Z","registered":"2026-08-05T02:22:56Z","published":null,"updated":"2026-08-05T02:22:56Z"},"relationships":{"client":{"data":{"id":"arxiv.content","type":"clients"}}}},{"id":"10.48550/arxiv.2608.03871","type":"dois","attributes":{"doi":"10.48550/arxiv.2608.03871","identifiers":[{"identifier":"2608.03871","identifierType":"arXiv"}],"creators":[{"nameType":"Personal","givenName":"Orjan","familyName":"Ameye","name":"Ameye, Orjan","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Jakob","familyName":"Koenig","name":"Koenig, Jakob","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Clinton","familyName":"Potts","name":"Potts, Clinton","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Oded","familyName":"Zilberberg","name":"Zilberberg, Oded","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Gary","familyName":"Steele","name":"Steele, Gary","affiliation":[],"nameIdentifiers":[]}],"titles":[{"title":"Few-photon degenerate parametric resonance in a two-tone driven microwave resonator"}],"publisher":"arXiv","container":{},"publicationYear":2026,"subjects":[{"subject":"Quantum Physics (quant-ph)","lang":"en","subjectScheme":"arXiv"},{"subject":"Mesoscale and Nanoscale Physics (cond-mat.mes-hall)","lang":"en","subjectScheme":"arXiv"},{"subject":"FOS: Physical sciences","subjectScheme":"Fields of Science and Technology (FOS)"}],"contributors":[],"dates":[{"date":"2026-08-04T16:11:43Z","dateType":"Submitted","dateInformation":"v1"},{"date":"2026-08-05T01:03:25Z","dateType":"Updated","dateInformation":"v1"},{"date":"2026-08","dateType":"Available","dateInformation":"v1"}],"language":null,"types":{"schemaOrg":"CreativeWork","resourceTypeGeneral":"Preprint","citeproc":"article","bibtex":"misc","ris":"GEN","resourceType":"Article"},"relatedIdentifiers":[],"relatedItems":[],"sizes":[],"formats":[],"version":"1","rightsList":[{"rightsIdentifierScheme":"SPDX","rightsUri":"https://creativecommons.org/licenses/by/4.0/legalcode","schemeUri":"https://spdx.org/licenses/","rights":"Creative Commons Attribution 4.0 International","rightsIdentifier":"cc-by-4.0"}],"descriptions":[{"descriptionType":"Abstract","description":"Multi-tone external driving offers a route to parametric physics without directly modulating the device. However, the validity of the parametric response in the few-photon regime remains underexplored. Here, we apply two coherent microwave tones to a Josephson-junction Kerr oscillator and stimulate degenerate parametric downconversion via four-wave mixing. Using transmission spectroscopy, we observe that the response retains the qualitative semiclassical Kerr parametric oscillator structure, including its instability lobe and bistable phase-space topology. Interestingly, we demonstrate that a conventional single-mode reduction fails to capture the system quantitatively: the predicted AC Stark shift is severely underestimated, and the reported distributions might not be fully physical when the single-photon Kerr shift $K$ exceeds the cavity linewidth $κ$. Instead, we show that a full three-tone quantum description accurately reproduces the experimental observables. There, quantum fluctuations of the drive tones become dynamically dominant over dissipation, and all three interacting tones operate in a deep few-photon limit where the expected semiclassical macroscopic lobes undergo fundamental renormalization due to profound mixing with quantum variance. Our results establish two-tone-driven Kerr oscillators as potential parametric amplifiers and open new horizons to explore the quantum-to-classical crossover in driven-dissipative circuits."}],"geoLocations":[],"fundingReferences":[],"url":"https://arxiv.org/abs/2608.03871","contentUrl":null,"metadataVersion":0,"schemaVersion":"http://datacite.org/schema/kernel-4","source":"mds","isActive":true,"state":"findable","reason":null,"viewCount":0,"downloadCount":0,"referenceCount":0,"citationCount":0,"partCount":0,"partOfCount":0,"versionCount":0,"versionOfCount":0,"created":"2026-08-05T02:22:54Z","registered":"2026-08-05T02:22:55Z","published":null,"updated":"2026-08-05T02:22:55Z"},"relationships":{"client":{"data":{"id":"arxiv.content","type":"clients"}}}},{"id":"10.48550/arxiv.2608.03870","type":"dois","attributes":{"doi":"10.48550/arxiv.2608.03870","identifiers":[{"identifier":"2608.03870","identifierType":"arXiv"}],"creators":[{"nameType":"Personal","givenName":"Kilian","familyName":"Krötzsch","name":"Krötzsch, Kilian","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Zekang","familyName":"Zhou","name":"Zhou, Zekang","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Kryštof","familyName":"Kolář","name":"Kolář, Kryštof","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Yonggen","familyName":"Li","name":"Li, Yonggen","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Kenji","familyName":"Watanabe","name":"Watanabe, Kenji","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Takashi","familyName":"Taniguchi","name":"Taniguchi, Takashi","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Moty","familyName":"Heiblum","name":"Heiblum, Moty","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Cyprian","familyName":"Lewandowski","name":"Lewandowski, Cyprian","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Mitali","familyName":"Banerjee","name":"Banerjee, Mitali","affiliation":[],"nameIdentifiers":[]}],"titles":[{"title":"Surface-Selective Probe of Spin-Triplet Superconductivity in Rhombohedral Graphene"}],"publisher":"arXiv","container":{},"publicationYear":2026,"subjects":[{"subject":"Mesoscale and Nanoscale Physics (cond-mat.mes-hall)","lang":"en","subjectScheme":"arXiv"},{"subject":"Strongly Correlated Electrons (cond-mat.str-el)","lang":"en","subjectScheme":"arXiv"},{"subject":"Superconductivity (cond-mat.supr-con)","lang":"en","subjectScheme":"arXiv"},{"subject":"FOS: Physical sciences","subjectScheme":"Fields of Science and Technology (FOS)"}],"contributors":[],"dates":[{"date":"2026-08-04T16:10:52Z","dateType":"Submitted","dateInformation":"v1"},{"date":"2026-08-05T01:03:21Z","dateType":"Updated","dateInformation":"v1"},{"date":"2026-08","dateType":"Available","dateInformation":"v1"}],"language":null,"types":{"schemaOrg":"CreativeWork","resourceTypeGeneral":"Preprint","citeproc":"article","bibtex":"misc","ris":"GEN","resourceType":"Article"},"relatedIdentifiers":[],"relatedItems":[],"sizes":[],"formats":[],"version":"1","rightsList":[{"rightsIdentifierScheme":"SPDX","rightsUri":"https://creativecommons.org/licenses/by/4.0/legalcode","schemeUri":"https://spdx.org/licenses/","rights":"Creative Commons Attribution 4.0 International","rightsIdentifier":"cc-by-4.0"}],"descriptions":[{"descriptionType":"Abstract","description":"Superconductivity in rhombohedral graphene has been observed across many layer numbers, with mounting evidence pointing toward spin-triplet pairing, yet complementary probes of the superconducting spin structure remain needed. Here we use one-sided WS$_2$ proximity in rhombohedral pentalayer graphene (R5G) as a surface-selective spin-orbit probe. The induced Ising spin-orbit coupling is strongest for carriers localized near the WS$_2$ interface, allowing the displacement field to tune the overlap between superconducting carriers and the spin-orbit perturbation. We observe a strongly asymmetric superconducting landscape: two robust pockets, SC1 and SC2, survive only on mutually opposite signs of displacement field, while a third pocket, SC3, is substantially weaker. Gate-tracking features, quantum oscillations, and self-consistent band-structure calculations identify the layer polarization and Fermi-surface character of the relevant carriers. The robust superconducting states are absent or strongly weakened when the active high-DOS carriers are polarized toward the WS$_2$ interface. Since Ising spin-orbit coupling is compatible with time-reversed spin-singlet pairing but competes with same-spin intervalley triplet pairing by canting or pinning the parent spin texture, this surface-selective suppression provides additional evidence for spin-triplet superconductivity involving both hole-like and electron-like carriers. Our results establish one-sided TMD proximity as a displacement-field-tunable probe of superconducting spin structure in rhombohedral graphene."}],"geoLocations":[],"fundingReferences":[],"url":"https://arxiv.org/abs/2608.03870","contentUrl":null,"metadataVersion":0,"schemaVersion":"http://datacite.org/schema/kernel-4","source":"mds","isActive":true,"state":"findable","reason":null,"viewCount":0,"downloadCount":0,"referenceCount":0,"citationCount":0,"partCount":0,"partOfCount":0,"versionCount":0,"versionOfCount":0,"created":"2026-08-05T02:22:53Z","registered":"2026-08-05T02:22:54Z","published":null,"updated":"2026-08-05T02:22:54Z"},"relationships":{"client":{"data":{"id":"arxiv.content","type":"clients"}}}},{"id":"10.48550/arxiv.2608.03868","type":"dois","attributes":{"doi":"10.48550/arxiv.2608.03868","identifiers":[{"identifier":"2608.03868","identifierType":"arXiv"}],"creators":[{"nameType":"Personal","givenName":"Abhinav","familyName":"Thorat","name":"Thorat, Abhinav","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Ravi Kumar","familyName":"Kolla","name":"Kolla, Ravi Kumar","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Vishak K","familyName":"Bhat","name":"Bhat, Vishak K","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Harsh Vardhan Singh","familyName":"Chauhan","name":"Chauhan, Harsh Vardhan Singh","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Niranjan","familyName":"Pedanekar","name":"Pedanekar, Niranjan","affiliation":[],"nameIdentifiers":[]}],"titles":[{"title":"GENESIS: Towards Explainable Causal Discovery"}],"publisher":"arXiv","container":{},"publicationYear":2026,"subjects":[{"subject":"Machine Learning (cs.LG)","lang":"en","subjectScheme":"arXiv"},{"subject":"Artificial Intelligence (cs.AI)","lang":"en","subjectScheme":"arXiv"},{"subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"}],"contributors":[],"dates":[{"date":"2026-08-04T16:09:01Z","dateType":"Submitted","dateInformation":"v1"},{"date":"2026-08-05T01:03:17Z","dateType":"Updated","dateInformation":"v1"},{"date":"2026-08","dateType":"Available","dateInformation":"v1"}],"language":null,"types":{"schemaOrg":"CreativeWork","resourceTypeGeneral":"Preprint","citeproc":"article","bibtex":"misc","ris":"GEN","resourceType":"Article"},"relatedIdentifiers":[],"relatedItems":[],"sizes":[],"formats":[],"version":"1","rightsList":[{"rightsIdentifierScheme":"SPDX","rightsUri":"https://creativecommons.org/licenses/by-sa/4.0/legalcode","schemeUri":"https://spdx.org/licenses/","rights":"Creative Commons Attribution Share Alike 4.0 International","rightsIdentifier":"cc-by-sa-4.0"}],"descriptions":[{"descriptionType":"Abstract","description":"Causal Discovery (CD) from observational data faces two fundamental challenges. First, purely statistical methods often lack the power to resolve structural ambiguities in low-sample regimes. Second, although LLM-assisted hybrid approaches improve structure recovery through semantic reasoning, the influence of that reasoning on individual edge decisions remains largely opaque. Consequently, existing hybrid methods fail to satisfy a fundamental requirement: explaining why a particular edge is included or excluded in the learned directed acyclic graph (DAG). This is critical in real-world applications, where no ground-truth DAG exists and every structural decision must be independently justified. We formalize this requirement as decision traceability, requiring every inferred edge to be supported by auditable statistical evidence, Markov Blanket consistency, or explicit domain reasoning. We propose GENESIS, an explainable hybrid CD framework that decomposes graph construction into interpretable decision points. GENESIS first identifies and scores three-node structural motifs, including chains, forks, and colliders, to establish transparent structural priors, then progressively refines the graph by integrating these priors with observational evidence, invoking domain knowledge only when statistical evidence is insufficient. By design, every edge decision is resolved through an auditable source of evidence. Experiments show that GENESIS achieves 100% decision traceability across all settings, establishing explainability as a first-class objective in causal discovery. Despite this additional requirement, GENESIS consistently outperforms purely statistical CD methods on the majority of benchmark datasets across all sample regimes in terms of Structural Hamming Distance (SHD), while achieving performance comparable to state-of-the-art LLM-assisted approaches."},{"descriptionType":"Other","description":"13 pages, 2 figures, 13 tables, 1 algorithm"}],"geoLocations":[],"fundingReferences":[],"url":"https://arxiv.org/abs/2608.03868","contentUrl":null,"metadataVersion":0,"schemaVersion":"http://datacite.org/schema/kernel-4","source":"mds","isActive":true,"state":"findable","reason":null,"viewCount":0,"downloadCount":0,"referenceCount":0,"citationCount":0,"partCount":0,"partOfCount":0,"versionCount":0,"versionOfCount":0,"created":"2026-08-05T02:22:50Z","registered":"2026-08-05T02:22:51Z","published":null,"updated":"2026-08-05T02:22:51Z"},"relationships":{"client":{"data":{"id":"arxiv.content","type":"clients"}}}},{"id":"10.48550/arxiv.2608.03867","type":"dois","attributes":{"doi":"10.48550/arxiv.2608.03867","identifiers":[{"identifier":"2608.03867","identifierType":"arXiv"}],"creators":[{"nameType":"Personal","givenName":"Junyi","familyName":"Luo","name":"Luo, Junyi","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Xinting","familyName":"Jiang","name":"Jiang, Xinting","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Tai-Hao","familyName":"Wen","name":"Wen, Tai-Hao","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Ruichen","familyName":"Qi","name":"Qi, Ruichen","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Minxing","familyName":"Chu","name":"Chu, Minxing","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Hongyi","familyName":"Wu","name":"Wu, Hongyi","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Gregory","familyName":"Kielian","name":"Kielian, Gregory","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Ben","familyName":"Laurie","name":"Laurie, Ben","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Qirui","familyName":"Zhang","name":"Zhang, Qirui","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Quan","familyName":"Cheng","name":"Cheng, Quan","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Dennis","familyName":"Sylvester","name":"Sylvester, Dennis","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Mehdi","familyName":"Saligane","name":"Saligane, Mehdi","affiliation":[],"nameIdentifiers":[]}],"titles":[{"title":"Heterogeneity-Aware Microscaling for Efficient Low-Bit LLM Inference"}],"publisher":"arXiv","container":{},"publicationYear":2026,"subjects":[{"subject":"Hardware Architecture (cs.AR)","lang":"en","subjectScheme":"arXiv"},{"subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"}],"contributors":[],"dates":[{"date":"2026-08-04T16:08:20Z","dateType":"Submitted","dateInformation":"v1"},{"date":"2026-08-05T01:03:16Z","dateType":"Updated","dateInformation":"v1"},{"date":"2026-08","dateType":"Available","dateInformation":"v1"}],"language":null,"types":{"schemaOrg":"CreativeWork","resourceTypeGeneral":"Preprint","citeproc":"article","bibtex":"misc","ris":"GEN","resourceType":"Article"},"relatedIdentifiers":[],"relatedItems":[],"sizes":[],"formats":[],"version":"1","rightsList":[{"rightsUri":"http://arxiv.org/licenses/nonexclusive-distrib/1.0/","rights":"arXiv.org perpetual, non-exclusive license"}],"descriptions":[{"descriptionType":"Abstract","description":"Microscaling (MX) is now the standard for low-bit large language model (LLM) inference. Its 4-bit form MXFP4 still loses substantial accuracy, because existing MX formats fix either the element format or the precision-recovery scheme across blocks, and thus capture only limited quantization heterogeneity. Quantization heterogeneity appears at two levels: 1) across blocks, the preferred element format and precision-recovery scheme vary; 2) across operands, weights and activations require different encoding. We introduce AdaMX (Adaptive Microscaling), a heterogeneity-aware format and accelerator. It selects the precision-recovery scheme per block and the representation per operand, at no increase in equivalent bit width (EBW). One design covers two block sizes, giving a higher-accuracy operating point and a lower-EBW operating point that saves storage. We implement a 22nm FD-SOI AI accelerator prototype with the proposed decoder, computing unit, and quantization logic. Against an otherwise identical MXFP4 accelerator with FP4-only multipliers, AdaMX adds about 1% system energy. At the lower-EBW point, AdaMX stays more accurate than the baseline while lowering both memory footprint and energy. Across LLMs from 3B to 70B, AdaMX removes 83% of the MXFP4 accuracy loss on commonsense and 82% on MMLU, and 43% and 27% of the NVFP4 loss. AdaMX also generalizes to multimodal models. On Gemma-4 12B, it leads MXFP4 on all four vision-language benchmarks and keeps up to 96% of FP16 accuracy."}],"geoLocations":[],"fundingReferences":[],"url":"https://arxiv.org/abs/2608.03867","contentUrl":null,"metadataVersion":0,"schemaVersion":"http://datacite.org/schema/kernel-4","source":"mds","isActive":true,"state":"findable","reason":null,"viewCount":0,"downloadCount":0,"referenceCount":0,"citationCount":0,"partCount":0,"partOfCount":0,"versionCount":0,"versionOfCount":0,"created":"2026-08-05T02:22:49Z","registered":"2026-08-05T02:22:50Z","published":null,"updated":"2026-08-05T02:22:50Z"},"relationships":{"client":{"data":{"id":"arxiv.content","type":"clients"}}}},{"id":"10.48550/arxiv.2608.03866","type":"dois","attributes":{"doi":"10.48550/arxiv.2608.03866","identifiers":[{"identifier":"2608.03866","identifierType":"arXiv"}],"creators":[{"nameType":"Personal","givenName":"Yash","familyName":"Misra","name":"Misra, Yash","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Javal","familyName":"Vyas","name":"Vyas, Javal","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Siddharth","familyName":"Gutta","name":"Gutta, Siddharth","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Mehmet","familyName":"Mercangöz","name":"Mercangöz, Mehmet","affiliation":[],"nameIdentifiers":[]}],"titles":[{"title":"ADMITBench: A Safety-Governed Reference Framework for Evaluating the Admissibility of Industrial LLM Advisories"}],"publisher":"arXiv","container":{},"publicationYear":2026,"subjects":[{"subject":"Artificial Intelligence (cs.AI)","lang":"en","subjectScheme":"arXiv"},{"subject":"Systems and Control (eess.SY)","lang":"en","subjectScheme":"arXiv"},{"subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"},{"subject":"FOS: Electrical engineering, electronic engineering, information engineering","subjectScheme":"Fields of Science and Technology (FOS)"}],"contributors":[],"dates":[{"date":"2026-08-04T16:07:56Z","dateType":"Submitted","dateInformation":"v1"},{"date":"2026-08-05T01:03:11Z","dateType":"Updated","dateInformation":"v1"},{"date":"2026-08","dateType":"Available","dateInformation":"v1"}],"language":null,"types":{"schemaOrg":"CreativeWork","resourceTypeGeneral":"Preprint","citeproc":"article","bibtex":"misc","ris":"GEN","resourceType":"Article"},"relatedIdentifiers":[],"relatedItems":[],"sizes":[],"formats":[],"version":"1","rightsList":[{"rightsIdentifierScheme":"SPDX","rightsUri":"https://creativecommons.org/licenses/by/4.0/legalcode","schemeUri":"https://spdx.org/licenses/","rights":"Creative Commons Attribution 4.0 International","rightsIdentifier":"cc-by-4.0"}],"descriptions":[{"descriptionType":"Abstract","description":"This white paper presents ADMITBench, a reference framework for evaluating industrial LLM advisories at the level of the proposed action. The framework implements a versioned, safety-governed evaluation contract that checks whether a recommendation is supported by the available evidence, permitted under the stated authority and procedure, and acceptable under the plant-specific consequence checks encoded in the selected evaluation profile. In this report, \\emph{safety-governed} means that eligibility is determined through explicit, non-compensatory checks derived from a versioned plant profile; it does not mean that the evaluator, model, or plant has been safety-certified. Release 0.1.0 is a public reference implementation for technical and research evaluation, not an authorisation for physical execution."}],"geoLocations":[],"fundingReferences":[],"url":"https://arxiv.org/abs/2608.03866","contentUrl":null,"metadataVersion":0,"schemaVersion":"http://datacite.org/schema/kernel-4","source":"mds","isActive":true,"state":"findable","reason":null,"viewCount":0,"downloadCount":0,"referenceCount":0,"citationCount":0,"partCount":0,"partOfCount":0,"versionCount":0,"versionOfCount":0,"created":"2026-08-05T02:22:48Z","registered":null,"published":null,"updated":"2026-08-05T02:22:48Z"},"relationships":{"client":{"data":{"id":"arxiv.content","type":"clients"}}}},{"id":"10.48550/arxiv.2608.03865","type":"dois","attributes":{"doi":"10.48550/arxiv.2608.03865","identifiers":[{"identifier":"2608.03865","identifierType":"arXiv"}],"creators":[{"nameType":"Personal","givenName":"Anushree","familyName":"Pandey","name":"Pandey, Anushree","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Sovik","familyName":"Roy","name":"Roy, Sovik","affiliation":[],"nameIdentifiers":[]}],"titles":[{"title":"Interplay between teleportation fidelity and basis-independent coherence in maximally sliced states under decoherence"}],"publisher":"arXiv","container":{},"publicationYear":2026,"subjects":[{"subject":"Quantum Physics (quant-ph)","lang":"en","subjectScheme":"arXiv"},{"subject":"FOS: Physical sciences","subjectScheme":"Fields of Science and Technology (FOS)"}],"contributors":[],"dates":[{"date":"2026-08-04T16:06:31Z","dateType":"Submitted","dateInformation":"v1"},{"date":"2026-08-05T01:03:08Z","dateType":"Updated","dateInformation":"v1"},{"date":"2026-08","dateType":"Available","dateInformation":"v1"}],"language":null,"types":{"schemaOrg":"CreativeWork","resourceTypeGeneral":"Preprint","citeproc":"article","bibtex":"misc","ris":"GEN","resourceType":"Article"},"relatedIdentifiers":[],"relatedItems":[],"sizes":[],"formats":[],"version":"1","rightsList":[{"rightsIdentifierScheme":"SPDX","rightsUri":"https://creativecommons.org/licenses/by/4.0/legalcode","schemeUri":"https://spdx.org/licenses/","rights":"Creative Commons Attribution 4.0 International","rightsIdentifier":"cc-by-4.0"}],"descriptions":[{"descriptionType":"Abstract","description":"The influence of environmental decoherence on quantum teleportation is investigated by considering the three-qubit Maximally Sliced (MS) state as the shared entangled resource. Using the Kraus operator formalism, analytical expressions are derived for the teleportation fidelity under amplitude damping and phase damping channels. The corresponding basis-independent coherence is obtained, establishing explicit analytical relations between coherence and teleportation fidelity under both decoherence mechanisms. The results are further expressed in terms of the Coffman-Kundu-Wootters (CKW) three-tangle, thereby connecting genuine tripartite entanglement with teleportation performance. The analysis reveals distinct effects of the two noise channels: amplitude damping introduces a state-dependent threshold for achieving quantum teleportation, whereas phase damping preserves the quantum advantage until complete dephasing. These results provide a unified analytical framework for understanding the interplay among multipartite entanglement, quantum coherence and teleportation in noisy three-qubit MS states."},{"descriptionType":"Other","description":"20 pages, 3 figures"}],"geoLocations":[],"fundingReferences":[],"url":"https://arxiv.org/abs/2608.03865","contentUrl":null,"metadataVersion":0,"schemaVersion":"http://datacite.org/schema/kernel-4","source":"mds","isActive":true,"state":"findable","reason":null,"viewCount":0,"downloadCount":0,"referenceCount":0,"citationCount":0,"partCount":0,"partOfCount":0,"versionCount":0,"versionOfCount":0,"created":"2026-08-05T02:22:46Z","registered":null,"published":null,"updated":"2026-08-05T02:22:47Z"},"relationships":{"client":{"data":{"id":"arxiv.content","type":"clients"}}}},{"id":"10.48550/arxiv.2608.03864","type":"dois","attributes":{"doi":"10.48550/arxiv.2608.03864","identifiers":[{"identifier":"2608.03864","identifierType":"arXiv"}],"creators":[{"nameType":"Personal","givenName":"Noah","familyName":"Graham","name":"Graham, Noah","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Herbert","familyName":"Weigel","name":"Weigel, Herbert","affiliation":[],"nameIdentifiers":[]}],"titles":[{"title":"Vacuum Polarization Energy of a Nonzero Radius Cosmic String"}],"publisher":"arXiv","container":{},"publicationYear":2026,"subjects":[{"subject":"High Energy Physics - Theory (hep-th)","lang":"en","subjectScheme":"arXiv"},{"subject":"General Relativity and Quantum Cosmology (gr-qc)","lang":"en","subjectScheme":"arXiv"},{"subject":"FOS: Physical sciences","subjectScheme":"Fields of Science and Technology (FOS)"}],"contributors":[],"dates":[{"date":"2026-08-04T16:06:12Z","dateType":"Submitted","dateInformation":"v1"},{"date":"2026-08-05T01:03:08Z","dateType":"Updated","dateInformation":"v1"},{"date":"2026-08","dateType":"Available","dateInformation":"v1"}],"language":null,"types":{"schemaOrg":"CreativeWork","resourceTypeGeneral":"Preprint","citeproc":"article","bibtex":"misc","ris":"GEN","resourceType":"Article"},"relatedIdentifiers":[],"relatedItems":[],"sizes":[],"formats":[],"version":"1","rightsList":[{"rightsUri":"http://arxiv.org/licenses/nonexclusive-distrib/1.0/","rights":"arXiv.org perpetual, non-exclusive license"}],"descriptions":[{"descriptionType":"Abstract","description":"We calculate the vacuum polarization energy (VPE) of a scalar field in the background of a nonsingular cosmic string in $2+1$ spacetime dimensions. Our calculation expresses the VPE as a renormalized sum and integral over scattering data, which can be expressed in terms of Legendre and Bessel functions for the \"ballpoint pen\" model, analogous to a square well in curvature, and which can be obtained numerically for a generic string profile. We show how relationships between the local density of states, expressed in terms of the Green's function, and the global density of states, expressed in terms of the Jost function, extend to this curved spacetime background and allow for precise implementation of perturbative renormalization conditions."},{"descriptionType":"Other","description":"9 pages, 1 figure"}],"geoLocations":[],"fundingReferences":[],"url":"https://arxiv.org/abs/2608.03864","contentUrl":null,"metadataVersion":0,"schemaVersion":"http://datacite.org/schema/kernel-4","source":"mds","isActive":true,"state":"findable","reason":null,"viewCount":0,"downloadCount":0,"referenceCount":0,"citationCount":0,"partCount":0,"partOfCount":0,"versionCount":0,"versionOfCount":0,"created":"2026-08-05T02:22:45Z","registered":null,"published":null,"updated":"2026-08-05T02:22:45Z"},"relationships":{"client":{"data":{"id":"arxiv.content","type":"clients"}}}},{"id":"10.48550/arxiv.2608.03862","type":"dois","attributes":{"doi":"10.48550/arxiv.2608.03862","identifiers":[{"identifier":"2608.03862","identifierType":"arXiv"}],"creators":[{"nameType":"Personal","givenName":"Guan","familyName":"Qiang","name":"Qiang, Guan","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Yushen","familyName":"Chen","name":"Chen, Yushen","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Tianlong","familyName":"Liu","name":"Liu, Tianlong","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"David","familyName":"Rotenberg","name":"Rotenberg, David","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Ethan H.","familyName":"Kim","name":"Kim, Ethan H.","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Fang","familyName":"Fang","name":"Fang, Fang","affiliation":[],"nameIdentifiers":[]}],"titles":[{"title":"CRS-Triage: Confidence- and Reliability-Aware Selective Triage under Incomplete Clinical Evidence"}],"publisher":"arXiv","container":{},"publicationYear":2026,"subjects":[{"subject":"Machine Learning (cs.LG)","lang":"en","subjectScheme":"arXiv"},{"subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"}],"contributors":[],"dates":[{"date":"2026-08-04T16:04:15Z","dateType":"Submitted","dateInformation":"v1"},{"date":"2026-08-05T01:03:03Z","dateType":"Updated","dateInformation":"v1"},{"date":"2026-08","dateType":"Available","dateInformation":"v1"}],"language":null,"types":{"schemaOrg":"CreativeWork","resourceTypeGeneral":"Preprint","citeproc":"article","bibtex":"misc","ris":"GEN","resourceType":"Article"},"relatedIdentifiers":[],"relatedItems":[],"sizes":[],"formats":[],"version":"1","rightsList":[{"rightsUri":"http://arxiv.org/licenses/nonexclusive-distrib/1.0/","rights":"arXiv.org perpetual, non-exclusive license"}],"descriptions":[{"descriptionType":"Abstract","description":"Emergency triage requires reliable decisions within a short time period. However, the available electronic health record (EHR) data, including structured data and clinical text, are often incomplete, unreliable, and inconsistent. This makes machine learning (ML)-based triage prediction more challenging, as existing ML models typically rely on complete and reliable EHR data to accurately predict patients' acuity levels. To address this, we propose confidence- and reliability-aware selective triage (CRS-Triage) to predict patients' acuity levels with a confidence score. By comparing the confidence score with a predefined threshold, CRS-Triage can selectively determine whether the model should make the decision or defer the case. Specifically, CRS-Triage separately evaluates the reliability of structured data and clinical text and then jointly considers the consistency between the two modalities to estimate the confidence of each prediction. Moreover, to reduce the risk of missing high-acuity patients, namely under-triage, CRS-Triage prefers to assign patients slightly higher acuity levels, namely over-triage, by penalizing under-triage errors. Experiments on the MIMIC-IV-ED dataset show that CRS-Triage achieves strong predictive performance. It also provides a better risk-coverage trade-off and remains reliable when the available EHR data are incomplete, degraded, or inconsistent across modalities."}],"geoLocations":[],"fundingReferences":[],"url":"https://arxiv.org/abs/2608.03862","contentUrl":null,"metadataVersion":0,"schemaVersion":"http://datacite.org/schema/kernel-4","source":"mds","isActive":true,"state":"findable","reason":null,"viewCount":0,"downloadCount":0,"referenceCount":0,"citationCount":0,"partCount":0,"partOfCount":0,"versionCount":0,"versionOfCount":0,"created":"2026-08-05T02:22:42Z","registered":null,"published":null,"updated":"2026-08-05T02:22:43Z"},"relationships":{"client":{"data":{"id":"arxiv.content","type":"clients"}}}},{"id":"10.48550/arxiv.2608.03861","type":"dois","attributes":{"doi":"10.48550/arxiv.2608.03861","identifiers":[{"identifier":"2608.03861","identifierType":"arXiv"}],"creators":[{"nameType":"Personal","givenName":"Jingnuo","familyName":"Han","name":"Han, Jingnuo","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Youning","familyName":"Li","name":"Li, Youning","affiliation":[],"nameIdentifiers":[]}],"titles":[{"title":"Geometric-Symmetry Logical Gate and Local-Probe Selectivity in the Three-Leg AKLT Ladder"}],"publisher":"arXiv","container":{},"publicationYear":2026,"subjects":[{"subject":"Quantum Physics (quant-ph)","lang":"en","subjectScheme":"arXiv"},{"subject":"FOS: Physical sciences","subjectScheme":"Fields of Science and Technology (FOS)"}],"contributors":[],"dates":[{"date":"2026-08-04T16:04:13Z","dateType":"Submitted","dateInformation":"v1"},{"date":"2026-08-05T01:03:02Z","dateType":"Updated","dateInformation":"v1"},{"date":"2026-08","dateType":"Available","dateInformation":"v1"}],"language":null,"types":{"schemaOrg":"CreativeWork","resourceTypeGeneral":"Preprint","citeproc":"article","bibtex":"misc","ris":"GEN","resourceType":"Article"},"relatedIdentifiers":[],"relatedItems":[],"sizes":[],"formats":[],"version":"1","rightsList":[{"rightsIdentifierScheme":"SPDX","rightsUri":"https://creativecommons.org/licenses/by/4.0/legalcode","schemeUri":"https://spdx.org/licenses/","rights":"Creative Commons Attribution 4.0 International","rightsIdentifier":"cc-by-4.0"}],"descriptions":[{"descriptionType":"Abstract","description":"Symmetry-protected topological (SPT) phases provide a platform for encoding quantum information in protected boundary degrees of freedom. Here we study the three-leg Affleck-Kennedy-Lieb-Tasaki (AKLT) ladder as an exactly solvable SPT system with on-site symmetry $SO(3)\\times \\mathbb{Z}_2$. Using an exact matrix product state construction, we characterize the symmetry action on the edge encoding space and the accessibility of this space by local operators. We find that the continuous $SO(3)$ symmetry induces boundary rotations, while the leg-exchange symmetry generates a geometry-dependent logical permutation of edge qubits. Furthermore, by introducing a distinguishability measure motivated by the Knill--Laflamme condition, we derive a symmetry-resolved decay law for local accessibility. The decay is controlled by a selection rule raised from the Wigner--Eckart theorem, whereby a rank-$\\ell$ local operator couples only to the $\\mathcal L=\\ell$ transfer-matrix sector, with a decay length determined by the corresponding correlation length. We further identify a finite-size channel that is independent of the probe operator position. These results establish a quantitative connection between SPT symmetry, lattice geometry, and the protection of boundary-encoded quantum information."},{"descriptionType":"Other","description":"57 pages, 3 figures. Comments welcome"}],"geoLocations":[],"fundingReferences":[],"url":"https://arxiv.org/abs/2608.03861","contentUrl":null,"metadataVersion":0,"schemaVersion":"http://datacite.org/schema/kernel-4","source":"mds","isActive":true,"state":"findable","reason":null,"viewCount":0,"downloadCount":0,"referenceCount":0,"citationCount":0,"partCount":0,"partOfCount":0,"versionCount":0,"versionOfCount":0,"created":"2026-08-05T02:22:41Z","registered":null,"published":null,"updated":"2026-08-05T02:22:41Z"},"relationships":{"client":{"data":{"id":"arxiv.content","type":"clients"}}}},{"id":"10.48550/arxiv.2608.03860","type":"dois","attributes":{"doi":"10.48550/arxiv.2608.03860","identifiers":[{"identifier":"2608.03860","identifierType":"arXiv"}],"creators":[{"nameType":"Personal","givenName":"Kaysarul Anas","familyName":"Apurba","name":"Apurba, Kaysarul Anas","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Md. Hasibul","familyName":"Hasan","name":"Hasan, Md. Hasibul","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Rofiqul Alam","familyName":"Shehab","name":"Shehab, Rofiqul Alam","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Asab","familyName":"Azad","name":"Azad, Asab","affiliation":[],"nameIdentifiers":[]}],"titles":[{"title":"SciRet: A Compute-Aware Empirical Study of Retrieval and Reranking for Scientific RAG"}],"publisher":"arXiv","container":{},"publicationYear":2026,"subjects":[{"subject":"Computation and Language (cs.CL)","lang":"en","subjectScheme":"arXiv"},{"subject":"Artificial Intelligence (cs.AI)","lang":"en","subjectScheme":"arXiv"},{"subject":"Information Retrieval (cs.IR)","lang":"en","subjectScheme":"arXiv"},{"subject":"Performance (cs.PF)","lang":"en","subjectScheme":"arXiv"},{"subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"}],"contributors":[],"dates":[{"date":"2026-08-04T16:04:07Z","dateType":"Submitted","dateInformation":"v1"},{"date":"2026-08-05T01:03:01Z","dateType":"Updated","dateInformation":"v1"},{"date":"2026-08","dateType":"Available","dateInformation":"v1"}],"language":null,"types":{"schemaOrg":"CreativeWork","resourceTypeGeneral":"Preprint","citeproc":"article","bibtex":"misc","ris":"GEN","resourceType":"Article"},"relatedIdentifiers":[],"relatedItems":[],"sizes":[],"formats":[],"version":"1","rightsList":[{"rightsIdentifierScheme":"SPDX","rightsUri":"https://creativecommons.org/licenses/by/4.0/legalcode","schemeUri":"https://spdx.org/licenses/","rights":"Creative Commons Attribution 4.0 International","rightsIdentifier":"cc-by-4.0"}],"descriptions":[{"descriptionType":"Abstract","description":"We introduce SciRet, a compute-aware empirical study of retrieval-augmented generation for scientific question answering over CORD-19. Rather than proposing a new model, we evaluate a fixed scientific RAG pipeline across three corpus scales: 1,034 chunks (1K papers), 5,160 chunks (5K papers), and 15,480 chunks (15K papers). The pipeline combines sentence-window chunking, BM25, BGE-M3 dense retrieval, reciprocal rank fusion, optional cross-encoder reranking, and grounded answer generation. Across these settings, hybrid retrieval is more robust than either sparse-only or dense-only retrieval in our setting, reaching Recall@10 of 1.000 at 1K and 15K. In contrast, an MS MARCO-trained cross-encoder reranker reduces precision on the scientific corpus, suggesting that domain mismatch can outweigh the benefits of stronger query-passage interaction. Generation faithfulness measured with RAGAS increases with corpus scale in our setup. Retrieval evaluation uses pseudo-relevance labels derived from the hybrid system, so we treat the results as controlled comparative evidence rather than a benchmark claim. We release code, indexes, and evaluation outputs to support replication and follow-up studies."},{"descriptionType":"Other","description":"6 pages, 5 figures. Short paper"}],"geoLocations":[],"fundingReferences":[],"url":"https://arxiv.org/abs/2608.03860","contentUrl":null,"metadataVersion":0,"schemaVersion":"http://datacite.org/schema/kernel-4","source":"mds","isActive":true,"state":"findable","reason":null,"viewCount":0,"downloadCount":0,"referenceCount":0,"citationCount":0,"partCount":0,"partOfCount":0,"versionCount":0,"versionOfCount":0,"created":"2026-08-05T02:22:39Z","registered":"2026-08-05T02:22:40Z","published":null,"updated":"2026-08-05T02:22:40Z"},"relationships":{"client":{"data":{"id":"arxiv.content","type":"clients"}}}},{"id":"10.48550/arxiv.2608.03858","type":"dois","attributes":{"doi":"10.48550/arxiv.2608.03858","identifiers":[{"identifier":"2608.03858","identifierType":"arXiv"}],"creators":[{"nameType":"Personal","givenName":"Wen-Qing","familyName":"Guo","name":"Guo, Wen-Qing","affiliation":[],"nameIdentifiers":[]}],"titles":[{"title":"Probing Axion Like Particle-Proton Interactions through the Interplay of Dark Matter and Cosmic Rays in Large-Scale Structure"}],"publisher":"arXiv","container":{},"publicationYear":2026,"subjects":[{"subject":"High Energy Astrophysical Phenomena (astro-ph.HE)","lang":"en","subjectScheme":"arXiv"},{"subject":"FOS: Physical sciences","subjectScheme":"Fields of Science and Technology (FOS)"}],"contributors":[],"dates":[{"date":"2026-08-04T16:02:07Z","dateType":"Submitted","dateInformation":"v1"},{"date":"2026-08-05T01:02:53Z","dateType":"Updated","dateInformation":"v1"},{"date":"2026-08","dateType":"Available","dateInformation":"v1"}],"language":null,"types":{"schemaOrg":"CreativeWork","resourceTypeGeneral":"Preprint","citeproc":"article","bibtex":"misc","ris":"GEN","resourceType":"Article"},"relatedIdentifiers":[],"relatedItems":[],"sizes":[],"formats":[],"version":"1","rightsList":[{"rightsUri":"http://arxiv.org/licenses/nonexclusive-distrib/1.0/","rights":"arXiv.org perpetual, non-exclusive license"}],"descriptions":[{"descriptionType":"Abstract","description":"Axion-like particles (ALPs) provide a well-motivated dark matter candidate whose interactions with Standard Model particles may generate observable cosmological signatures. We investigate the diffuse $γ$-ray emission produced by the scattering process between ALP dark matter and cosmic-ray (CR) protons inside dark matter halos, and explore its detectability through the cross-correlation between the unresolved $γ$-ray background (UGRB) measured by \\textit{Fermi} Large Area Telescope (LAT) and the Two Micron All Sky Survey Redshift Survey (2MRS) galaxy catalog in the local Universe ($z\\leq0.1$). To model the cosmological $\\mathrm{GeV}$-$\\mathrm{PeV}$ CR proton population, we develop a phenomenological bottom-up prescription that links CR injection to the star formation rate through the supernova rate, while the steady-state CR density is determined by diffusive escape. Our forecasts indicate that UGRB-galaxy cross-correlation measurements can probe previously unexplored regions of the ALP parameter space over a broad range of ALP masses. More generally, this work presents a general framework for cosmological observables generated by interactions between dark matter and an additional astrophysical field, opening a new avenue for indirect dark matter searches using large-scale structure observations."},{"descriptionType":"Other","description":"16 pages, 3 figures"}],"geoLocations":[],"fundingReferences":[],"url":"https://arxiv.org/abs/2608.03858","contentUrl":null,"metadataVersion":0,"schemaVersion":"http://datacite.org/schema/kernel-4","source":"mds","isActive":true,"state":"findable","reason":null,"viewCount":0,"downloadCount":0,"referenceCount":0,"citationCount":0,"partCount":0,"partOfCount":0,"versionCount":0,"versionOfCount":0,"created":"2026-08-05T02:22:36Z","registered":"2026-08-05T02:22:37Z","published":null,"updated":"2026-08-05T02:22:37Z"},"relationships":{"client":{"data":{"id":"arxiv.content","type":"clients"}}}},{"id":"10.48550/arxiv.2608.03853","type":"dois","attributes":{"doi":"10.48550/arxiv.2608.03853","identifiers":[{"identifier":"2608.03853","identifierType":"arXiv"}],"creators":[{"nameType":"Personal","givenName":"Zakhar A.","familyName":"Iakovlev","name":"Iakovlev, Zakhar A.","affiliation":[],"nameIdentifiers":[]}],"titles":[{"title":"Magnetic-field control of Fermi polaron fine structure and polarization in strained monolayer semiconductors"}],"publisher":"arXiv","container":{},"publicationYear":2026,"subjects":[{"subject":"Mesoscale and Nanoscale Physics (cond-mat.mes-hall)","lang":"en","subjectScheme":"arXiv"},{"subject":"FOS: Physical sciences","subjectScheme":"Fields of Science and Technology (FOS)"}],"contributors":[],"dates":[{"date":"2026-08-04T15:57:04Z","dateType":"Submitted","dateInformation":"v1"},{"date":"2026-08-05T01:02:48Z","dateType":"Updated","dateInformation":"v1"},{"date":"2026-08","dateType":"Available","dateInformation":"v1"}],"language":null,"types":{"schemaOrg":"CreativeWork","resourceTypeGeneral":"Preprint","citeproc":"article","bibtex":"misc","ris":"GEN","resourceType":"Article"},"relatedIdentifiers":[],"relatedItems":[],"sizes":[],"formats":[],"version":"1","rightsList":[{"rightsUri":"http://arxiv.org/licenses/nonexclusive-distrib/1.0/","rights":"arXiv.org perpetual, non-exclusive license"}],"descriptions":[{"descriptionType":"Abstract","description":"The theory of attractive Fermi polaron energy spectrum fine structure and polarization in doped two-dimensional semiconductors in external magnetic field is developed. Fermi polaron $g$ factor renormalization due to correlations with the valley-polarized Fermi sea of resident charge carriers is calculated. We study the competition between Zeeman and strain-induced splittings in monolayers under uniaxial strain. The control of strain, magnetic field and electron density allows continuous tuning of energy splitting and eigenstate polarization. Linearly polarized strain-induced split doublet exhibits quadratic Zeeman shift changing to linear Zeeman splitting with elliptical polarization with the increase of magnetic field. We identify a critical magnetic field above which resident charge carriers become fully valley polarized and only one circularly polarized Fermi polaron state remains. Within the Green's function approach we calculate energy levels and Stokes parameters of attractive Fermi polaron states and introduce a simplified effective two-level model allowing us to study analytically the interplay of Zeeman and pseudo-Zeeman splitting. We calculate absorption and reflection spectra, including circular and linear dichroism in the trion spectral range. These results show that real and strain-induced pseudomagnetic fields provide complementary tools for controlling the optical response of many-body excitonic quasiparticles in two-dimensional semiconductors."}],"geoLocations":[],"fundingReferences":[],"url":"https://arxiv.org/abs/2608.03853","contentUrl":null,"metadataVersion":0,"schemaVersion":"http://datacite.org/schema/kernel-4","source":"mds","isActive":true,"state":"findable","reason":null,"viewCount":0,"downloadCount":0,"referenceCount":0,"citationCount":0,"partCount":0,"partOfCount":0,"versionCount":0,"versionOfCount":0,"created":"2026-08-05T02:22:30Z","registered":null,"published":null,"updated":"2026-08-05T02:22:30Z"},"relationships":{"client":{"data":{"id":"arxiv.content","type":"clients"}}}},{"id":"10.48550/arxiv.2608.03852","type":"dois","attributes":{"doi":"10.48550/arxiv.2608.03852","identifiers":[{"identifier":"2608.03852","identifierType":"arXiv"}],"creators":[{"nameType":"Personal","givenName":"Amin","familyName":"Farajzadeh","name":"Farajzadeh, Amin","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Melike","familyName":"Erol-Kantarci","name":"Erol-Kantarci, Melike","affiliation":[],"nameIdentifiers":[]}],"titles":[{"title":"FedCritic-MIMO: Communication-Efficient Serverless Federated Critic Learning for Massive-MIMO Resource Control in Open and Disaggregated 6G RANs"}],"publisher":"arXiv","container":{},"publicationYear":2026,"subjects":[{"subject":"Machine Learning (cs.LG)","lang":"en","subjectScheme":"arXiv"},{"subject":"Multiagent Systems (cs.MA)","lang":"en","subjectScheme":"arXiv"},{"subject":"Networking and Internet Architecture (cs.NI)","lang":"en","subjectScheme":"arXiv"},{"subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"}],"contributors":[],"dates":[{"date":"2026-08-04T15:56:32Z","dateType":"Submitted","dateInformation":"v1"},{"date":"2026-08-05T01:02:47Z","dateType":"Updated","dateInformation":"v1"},{"date":"2026-08","dateType":"Available","dateInformation":"v1"}],"language":null,"types":{"schemaOrg":"CreativeWork","resourceTypeGeneral":"Preprint","citeproc":"article","bibtex":"misc","ris":"GEN","resourceType":"Article"},"relatedIdentifiers":[],"relatedItems":[],"sizes":[],"formats":[],"version":"1","rightsList":[{"rightsUri":"http://arxiv.org/licenses/nonexclusive-distrib/1.0/","rights":"arXiv.org perpetual, non-exclusive license"}],"descriptions":[{"descriptionType":"Abstract","description":"This paper proposes FedCritic-MIMO, a communication-efficient serverless federated multi-agent reinforcement learning framework for AI-native resource control across independently deployable cell-level controllers in open and disaggregated 6G RANs. Controllers share no trainer, retain local actors and personalized critic components, and exchange only compatible shared critic parameters. FedCritic-MIMO targets reuse-$1$ multi-cell massive-MIMO OFDMA deployments, where RAN controllers jointly manage user scheduling, per-stream power allocation, beamforming, interference, and long-term QoS with limited inter-controller signaling. Each base station locally executes its actor without centralized training or actor federation, while critic knowledge is exchanged peer-to-peer over an interference-aware graph. It enables this collaboration through wireless-aware event triggering, adaptive layer-wise top-$k$ sparse critic exchange with error feedback, and balanced interference-aware fusion. We establish conditional finite-time stationarity and consensus guarantees for the balanced, compressed peer-to-peer critic recursion under a fixed-policy, frozen-target critic-regression model. In strongly interference-coupled reuse-$1$ simulations, FedCritic-MIMO achieves the best performance-communication tradeoff among heuristic, independent-learning, centralized-training, and communication-ablation baselines. It achieves the highest held-out throughput, improves user-rate distribution and mean SINR, increases QoS satisfaction, and attains the lowest interference cost per delivered bit among learning baselines. It reduces critic-communication overhead by $76\\%$ relative to uncompressed distributed critic exchange. These results demonstrate that serverless exchange of compatible shared critic parameters can coordinate RAN controllers without centralized trajectory collection or parameter-server aggregation."},{"descriptionType":"Other","description":"Submitted to IEEE for possible publication"}],"geoLocations":[],"fundingReferences":[],"url":"https://arxiv.org/abs/2608.03852","contentUrl":null,"metadataVersion":0,"schemaVersion":"http://datacite.org/schema/kernel-4","source":"mds","isActive":true,"state":"findable","reason":null,"viewCount":0,"downloadCount":0,"referenceCount":0,"citationCount":0,"partCount":0,"partOfCount":0,"versionCount":0,"versionOfCount":0,"created":"2026-08-05T02:22:28Z","registered":null,"published":null,"updated":"2026-08-05T02:22:29Z"},"relationships":{"client":{"data":{"id":"arxiv.content","type":"clients"}}}},{"id":"10.48550/arxiv.2608.03851","type":"dois","attributes":{"doi":"10.48550/arxiv.2608.03851","identifiers":[{"identifier":"2608.03851","identifierType":"arXiv"}],"creators":[{"nameType":"Personal","givenName":"Tianbao","familyName":"Zhang","name":"Zhang, Tianbao","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Zeyu","familyName":"Liu","name":"Liu, Zeyu","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Shuyu","familyName":"Wu","name":"Wu, Shuyu","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Fanxing","familyName":"Li","name":"Li, Fanxing","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Zhaoxin","familyName":"Fan","name":"Fan, Zhaoxin","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Wenjun","familyName":"Wu","name":"Wu, Wenjun","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Danping","familyName":"Zou","name":"Zou, Danping","affiliation":[],"nameIdentifiers":[]}],"titles":[{"title":"LiteMVS: Efficient Multi-View Stereo with Foundation Distillation and Expert Aggregation"}],"publisher":"arXiv","container":{},"publicationYear":2026,"subjects":[{"subject":"Computer Vision and Pattern Recognition (cs.CV)","lang":"en","subjectScheme":"arXiv"},{"subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"}],"contributors":[],"dates":[{"date":"2026-08-04T15:54:32Z","dateType":"Submitted","dateInformation":"v1"},{"date":"2026-08-05T01:02:41Z","dateType":"Updated","dateInformation":"v1"},{"date":"2026-08","dateType":"Available","dateInformation":"v1"}],"language":null,"types":{"schemaOrg":"CreativeWork","resourceTypeGeneral":"Preprint","citeproc":"article","bibtex":"misc","ris":"GEN","resourceType":"Article"},"relatedIdentifiers":[],"relatedItems":[],"sizes":[],"formats":[],"version":"1","rightsList":[{"rightsIdentifierScheme":"SPDX","rightsUri":"https://creativecommons.org/licenses/by-nc-nd/4.0/legalcode","schemeUri":"https://spdx.org/licenses/","rights":"Creative Commons Attribution Non Commercial No Derivatives 4.0 International","rightsIdentifier":"cc-by-nc-nd-4.0"}],"descriptions":[{"descriptionType":"Abstract","description":"Real-time 3D perception is crucial for robotics, augmented reality, and embodied intelligence applications. Existing multi-view stereo (MVS) methods primarily rely on geometric correspondences, which often fail in textureless or repetitive regions, while monocular depth models leverage strong image-level priors but lack robust multi-view geometric constraints. More importantly, in robotics and embodied manipulation scenarios, high-quality 3D geometry is not only essential for static reconstruction, but also serves as a critical foundation for learning temporally consistent 4D representations. To obtain visual representations with stronger structural awareness and greater potential for spatiotemporal extension, we present LiteMVS, a lightweight multi-view depth estimation model that integrates plane-sweep geometric reasoning with strong monocular semantic and structural priors. The central idea of LiteMVS is to efficiently inject high-level monocular knowledge, obtained from lightweight segmentation models and large-scale vision foundation models, into a multi-view stereo framework. In particular, LiteMVS enriches the cost volume with semantic descriptors and employs a Mixture-of-Experts (MoE) formulation to enable adaptive geometric aggregation across depth hypotheses. Moreover, geometric priors distilled from vision foundation models further strengthen monocular guidance without increasing inference cost. Through this design, LiteMVS not only improves depth estimation and 3D reconstruction quality in static scenes, but also provides a more reliable geometric foundation for subsequent temporal modeling and 4D representation learning. Experiments on ScanNetv2 and 7-Scenes demonstrate that LiteMVS achieves high-quality depth prediction and 3D reconstruction while maintaining competitive efficiency."},{"descriptionType":"Other","description":"CVPR 2026 Workshop accepted"}],"geoLocations":[],"fundingReferences":[],"url":"https://arxiv.org/abs/2608.03851","contentUrl":null,"metadataVersion":0,"schemaVersion":"http://datacite.org/schema/kernel-4","source":"mds","isActive":true,"state":"findable","reason":null,"viewCount":0,"downloadCount":0,"referenceCount":0,"citationCount":0,"partCount":0,"partOfCount":0,"versionCount":0,"versionOfCount":0,"created":"2026-08-05T02:22:27Z","registered":null,"published":null,"updated":"2026-08-05T02:22:28Z"},"relationships":{"client":{"data":{"id":"arxiv.content","type":"clients"}}}},{"id":"10.48550/arxiv.2608.03850","type":"dois","attributes":{"doi":"10.48550/arxiv.2608.03850","identifiers":[{"identifier":"2608.03850","identifierType":"arXiv"}],"creators":[{"nameType":"Personal","givenName":"Raju","familyName":"Baral","name":"Baral, Raju","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Haidong","familyName":"Zhou","name":"Zhou, Haidong","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Qiang","familyName":"Zhang","name":"Zhang, Qiang","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Benjamin A.","familyName":"Frandsen","name":"Frandsen, Benjamin A.","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Stuart","familyName":"Calder","name":"Calder, Stuart","affiliation":[],"nameIdentifiers":[]}],"titles":[{"title":"Local magnetic order in vacancy-disrupted spin ice Ho2TiO5"}],"publisher":"arXiv","container":{},"publicationYear":2026,"subjects":[{"subject":"Strongly Correlated Electrons (cond-mat.str-el)","lang":"en","subjectScheme":"arXiv"},{"subject":"Materials Science (cond-mat.mtrl-sci)","lang":"en","subjectScheme":"arXiv"},{"subject":"FOS: Physical sciences","subjectScheme":"Fields of Science and Technology (FOS)"}],"contributors":[],"dates":[{"date":"2026-08-04T15:54:04Z","dateType":"Submitted","dateInformation":"v1"},{"date":"2026-08-05T01:02:40Z","dateType":"Updated","dateInformation":"v1"},{"date":"2026-08","dateType":"Available","dateInformation":"v1"}],"language":null,"types":{"schemaOrg":"CreativeWork","resourceTypeGeneral":"Preprint","citeproc":"article","bibtex":"misc","ris":"GEN","resourceType":"Article"},"relatedIdentifiers":[],"relatedItems":[],"sizes":[],"formats":[],"version":"1","rightsList":[{"rightsIdentifierScheme":"SPDX","rightsUri":"https://creativecommons.org/licenses/by/4.0/legalcode","schemeUri":"https://spdx.org/licenses/","rights":"Creative Commons Attribution 4.0 International","rightsIdentifier":"cc-by-4.0"}],"descriptions":[{"descriptionType":"Abstract","description":"We investigate how local magnetic correlations evolve when the classical pyrochlore spin-ice Ho2Ti2O7 is transformed into the partially disordered stuffed compound Ho2TiO5. Neutron scattering measurements were analyzed using real-space magnetic pair distribution function, reciprocal-space reverse Monte Carlo, and half-polarized neutron powder diffraction methods to connect the average crystal structure with local magnetic correlations. Both compounds retain long-range $Fd-3m symmetry, but in Ho2TiO5 this average structure distorts locally through Ho-O, Ti-O and O-O bond-length disorder associated with partial Ho/Ti occupancy. Despite this disorder, half-polarized neutron powder diffraction shows that the Ho moments retain local \u0026lt;111\u0026gt; rangle Ising anisotropy and form spin-in/spin-out configurations on the tetrahedral network. In Ho2Ti2O7, real- and reciprocal-space analyses reveal a nearly ideal two-in/two-out spin-ice state at 0.3K, with 95% of tetrahedra satisfying the ice rule, followed by progressive thermal disordering on warming. In Ho2TiO5, most tetrahedra are magnetically incomplete because some tetrahedral vertices are occupied by nonmagnetic Ti rather than Ho; nevertheless, the dominant incomplete configurations are 2-in/1-out and 1-in/2-out, which are locally compatible with the ice rule if the missing Ho spin is restored. The single-ion \u0026lt;111\u0026gt; Ising anisotropy is therefore retained throughout, while the collective ice ordering is strongly disrupted: Ho2TiO5 is a vacancy-disrupted spin ice in which a local ice-rule tendency persists on a topologically incomplete magnetic network."}],"geoLocations":[],"fundingReferences":[],"url":"https://arxiv.org/abs/2608.03850","contentUrl":null,"metadataVersion":0,"schemaVersion":"http://datacite.org/schema/kernel-4","source":"mds","isActive":true,"state":"findable","reason":null,"viewCount":0,"downloadCount":0,"referenceCount":0,"citationCount":0,"partCount":0,"partOfCount":0,"versionCount":0,"versionOfCount":0,"created":"2026-08-05T02:22:26Z","registered":"2026-08-05T02:22:26Z","published":null,"updated":"2026-08-05T02:22:26Z"},"relationships":{"client":{"data":{"id":"arxiv.content","type":"clients"}}}},{"id":"10.48550/arxiv.2608.03849","type":"dois","attributes":{"doi":"10.48550/arxiv.2608.03849","identifiers":[{"identifier":"2608.03849","identifierType":"arXiv"}],"creators":[{"nameType":"Personal","givenName":"Ana L. F.","familyName":"de Barros","name":"de Barros, Ana L. F.","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"David","familyName":"Dubois","name":"Dubois, David","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Sreeja","familyName":"Raghunandanan","name":"Raghunandanan, Sreeja","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Thibault Nguyen","familyName":"Trung","name":"Trung, Thibault Nguyen","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Tarek","familyName":"Sbera","name":"Sbera, Tarek","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Hermann","familyName":"Rothard","name":"Rothard, Hermann","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Alicja","familyName":"Domaracka","name":"Domaracka, Alicja","affiliation":[],"nameIdentifiers":[]}],"titles":[{"title":"Formation of nitriles and isonitriles by the heavy-ion irradiation of propionitrile in N2-rich astrophysical ices"}],"publisher":"arXiv","container":{},"publicationYear":2026,"subjects":[{"subject":"Earth and Planetary Astrophysics (astro-ph.EP)","lang":"en","subjectScheme":"arXiv"},{"subject":"Astrophysics of Galaxies (astro-ph.GA)","lang":"en","subjectScheme":"arXiv"},{"subject":"FOS: Physical sciences","subjectScheme":"Fields of Science and Technology (FOS)"}],"contributors":[],"dates":[{"date":"2026-08-04T15:52:57Z","dateType":"Submitted","dateInformation":"v1"},{"date":"2026-08-05T01:02:33Z","dateType":"Updated","dateInformation":"v1"},{"date":"2026-08","dateType":"Available","dateInformation":"v1"}],"language":null,"types":{"schemaOrg":"CreativeWork","resourceTypeGeneral":"Preprint","citeproc":"article","bibtex":"misc","ris":"GEN","resourceType":"Article"},"relatedIdentifiers":[],"relatedItems":[],"sizes":[],"formats":[],"version":"1","rightsList":[{"rightsIdentifierScheme":"SPDX","rightsUri":"https://creativecommons.org/licenses/by/4.0/legalcode","schemeUri":"https://spdx.org/licenses/","rights":"Creative Commons Attribution 4.0 International","rightsIdentifier":"cc-by-4.0"}],"descriptions":[{"descriptionType":"Abstract","description":"Context. Nitriles are key nitrogen-bearing organic molecules in dense clouds, star-forming regions, and nitrogen-rich icy environments. Understanding their stability and chemical evolution under energetic processing is essential for understanding the formation of complex organic species in astrophysical ices. Aims. We investigate the radiolytic processing of propionitrile (CH3CH2CN, hereafter referred to as PCN) in a nitrogen-rich ice matrix and evaluate the formation of nitriles, isonitriles, hydrocarbons, and other nitrogen-bearing products induced by swift heavy ions. Methods. A PCN:N2 ice mixture with an approximate molecular ratio of 1:10 was deposited at 10 K and irradiated with 40 MeV 40Ar9+ ions up to a fluence of 1 x 1013 ions cm-2. The chemical evolution was monitored in situ by Fourier-transform infrared spectroscopy. Destruction and formation cross sections, as well as radiation chemical yields, were derived from the fluence dependence of selected infrared bands. Results. Ion irradiation efficiently destroys PCN and produces a rich inventory of daughter species. The products include: nitriles and isonitriles such as HCN, HCNN, HC3N, CH3CN, CH3C3N, CH3CHCNH, CH2CHCN, NCCN/C2N2, CN, and C2N; nitrogen-bearing species such as CH2NH, CH3NH2, CH3N3, and N3- ; and hydrocarbons, including CH4, C2H2, C2H4, C2H6, and C4H4. The derived cross sections indicate that CN-bearing fragments and hydrocarbons are among the most efficiently formed products, demonstrating that the CN group is efficiently preserved and that extensive carbon-chain reorganization also occurs. Conclusions. The results demonstrate that the energetic processing of PCN in N2-rich ices provides an efficient pathway to molecular complexity under conditions relevant to dense interstellar clouds, protostellar environments, and nitrogen-rich outer Solar System surfaces."},{"descriptionType":"Other","description":"11 pages, 6 figures, 2 tables, accepted for publication in Astronomy \u0026amp; Astrophysics"}],"geoLocations":[],"fundingReferences":[],"url":"https://arxiv.org/abs/2608.03849","contentUrl":null,"metadataVersion":0,"schemaVersion":"http://datacite.org/schema/kernel-4","source":"mds","isActive":true,"state":"findable","reason":null,"viewCount":0,"downloadCount":0,"referenceCount":0,"citationCount":0,"partCount":0,"partOfCount":0,"versionCount":0,"versionOfCount":0,"created":"2026-08-05T02:22:24Z","registered":"2026-08-05T02:22:25Z","published":null,"updated":"2026-08-05T02:22:25Z"},"relationships":{"client":{"data":{"id":"arxiv.content","type":"clients"}}}},{"id":"10.48550/arxiv.2608.03848","type":"dois","attributes":{"doi":"10.48550/arxiv.2608.03848","identifiers":[{"identifier":"2608.03848","identifierType":"arXiv"}],"creators":[{"nameType":"Personal","givenName":"Ijay","familyName":"Narang","name":"Narang, Ijay","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Will","familyName":"Perkins","name":"Perkins, Will","affiliation":[],"nameIdentifiers":[]}],"titles":[{"title":"The Hard-Core Model on Bipartite Spectral Expanders: Counting and Sampling at All Fugacities"}],"publisher":"arXiv","container":{},"publicationYear":2026,"subjects":[{"subject":"Data Structures and Algorithms (cs.DS)","lang":"en","subjectScheme":"arXiv"},{"subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"}],"contributors":[],"dates":[{"date":"2026-08-04T15:52:31Z","dateType":"Submitted","dateInformation":"v1"},{"date":"2026-08-05T01:02:33Z","dateType":"Updated","dateInformation":"v1"},{"date":"2026-08","dateType":"Available","dateInformation":"v1"}],"language":null,"types":{"schemaOrg":"CreativeWork","resourceTypeGeneral":"Preprint","citeproc":"article","bibtex":"misc","ris":"GEN","resourceType":"Article"},"relatedIdentifiers":[],"relatedItems":[],"sizes":[],"formats":[],"version":"1","rightsList":[{"rightsUri":"http://arxiv.org/licenses/nonexclusive-distrib/1.0/","rights":"arXiv.org perpetual, non-exclusive license"}],"descriptions":[{"descriptionType":"Abstract","description":"We study approximate counting and sampling algorithms for the hard-core model on $Δ$-regular bipartite graphs under a spectral expansion condition. Let $M_G$ be the biadjacency matrix of $G$. For every fixed $ξ\\in(0,1)$, we give an FPRAS for the hard-core partition function and an efficient approximate sampler whenever \\[ λ\\leq \\frac{1-ξ}{σ_2(M_G)}. \\]\n The main idea is to introduce a family of quadratic tilts in the left-right occupation imbalance and show that each tilted measure can be sampled efficiently using Glauber dynamics. A discrete Gaussian identity expresses the original hard-core model as an exact positive mixture of these tilted measures; truncation and simulated annealing then yield efficient counting and sampling algorithms.\n For the complementary high-fugacity regime, we refine the polymer-model approach and show that the required phase-dominance and cluster expansion conditions follow from the singular-spectrum bound alone. Combining the two regimes, we obtain efficient approximate counting and sampling at every fugacity $λ\u0026gt;0$ whenever \\[ σ_2(M_G)\\leq c\\left(\\frac{Δ^2}{\\log(\\mathrm eΔ)}\\right)^{1/3} \\] for an absolute constant $c\u0026gt;0$. In particular, this recovers all-fugacity algorithms for random $Δ$-regular bipartite graphs for all sufficiently large $Δ$, while providing an efficiently verifiable certificate of their success on a given instance."}],"geoLocations":[],"fundingReferences":[],"url":"https://arxiv.org/abs/2608.03848","contentUrl":null,"metadataVersion":0,"schemaVersion":"http://datacite.org/schema/kernel-4","source":"mds","isActive":true,"state":"findable","reason":null,"viewCount":0,"downloadCount":0,"referenceCount":0,"citationCount":0,"partCount":0,"partOfCount":0,"versionCount":0,"versionOfCount":0,"created":"2026-08-05T02:22:23Z","registered":"2026-08-05T02:22:24Z","published":null,"updated":"2026-08-05T02:22:24Z"},"relationships":{"client":{"data":{"id":"arxiv.content","type":"clients"}}}},{"id":"10.48550/arxiv.2608.03847","type":"dois","attributes":{"doi":"10.48550/arxiv.2608.03847","identifiers":[{"identifier":"2608.03847","identifierType":"arXiv"}],"creators":[{"nameType":"Personal","givenName":"Ulrich","familyName":"Hounyo","name":"Hounyo, Ulrich","affiliation":[],"nameIdentifiers":[]}],"titles":[{"title":"Identification and Information after Nuisance Projection"}],"publisher":"arXiv","container":{},"publicationYear":2026,"subjects":[{"subject":"Econometrics (econ.EM)","lang":"en","subjectScheme":"arXiv"},{"subject":"Statistics Theory (math.ST)","lang":"en","subjectScheme":"arXiv"},{"subject":"Applications (stat.AP)","lang":"en","subjectScheme":"arXiv"},{"subject":"Methodology (stat.ME)","lang":"en","subjectScheme":"arXiv"},{"subject":"FOS: Economics and business","subjectScheme":"Fields of Science and Technology (FOS)"},{"subject":"FOS: Mathematics","subjectScheme":"Fields of Science and Technology (FOS)"},{"subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"}],"contributors":[],"dates":[{"date":"2026-08-04T15:50:52Z","dateType":"Submitted","dateInformation":"v1"},{"date":"2026-08-05T01:02:31Z","dateType":"Updated","dateInformation":"v1"},{"date":"2026-08","dateType":"Available","dateInformation":"v1"}],"language":null,"types":{"schemaOrg":"CreativeWork","resourceTypeGeneral":"Preprint","citeproc":"article","bibtex":"misc","ris":"GEN","resourceType":"Article"},"relatedIdentifiers":[],"relatedItems":[],"sizes":[],"formats":[],"version":"1","rightsList":[{"rightsUri":"http://arxiv.org/licenses/nonexclusive-distrib/1.0/","rights":"arXiv.org perpetual, non-exclusive license"}],"descriptions":[{"descriptionType":"Abstract","description":"Empirical work often removes fixed effects, latent factors, or high-dimensional controls before estimating structural relationships. These transformations reduce confounding but may also remove identifying variation. We study linear panel IV after one equation-compatible nuisance projection under two-way dependence. The projected Jacobian determines which structural directions remain visible; the projected-score law determines their precision; and, on Gaussian fixed-rank strata, they combine in a Projected Information Matrix. We derive weak-identification limits with dimension-specific information accumulation, feasible factor-transfer conditions, identification-robust tests, bootstrap procedures for non-Gaussian interaction limits, and inference for the projected spectrum, rank, subspaces, and information matrix. Simulations show that a raw first-stage statistic above 500 can support the wrong sign while projected diagnostics reveal weak valid information. In an international monetary application, common projection substantially attenuates apparent foreign-output persistence, while Gaussian-reference Anderson--Rubin sets remain unbounded. Identification should therefore be assessed after nuisance removal."}],"geoLocations":[],"fundingReferences":[],"url":"https://arxiv.org/abs/2608.03847","contentUrl":null,"metadataVersion":0,"schemaVersion":"http://datacite.org/schema/kernel-4","source":"mds","isActive":true,"state":"findable","reason":null,"viewCount":0,"downloadCount":0,"referenceCount":0,"citationCount":0,"partCount":0,"partOfCount":0,"versionCount":0,"versionOfCount":0,"created":"2026-08-05T02:22:22Z","registered":"2026-08-05T02:22:22Z","published":null,"updated":"2026-08-05T02:22:22Z"},"relationships":{"client":{"data":{"id":"arxiv.content","type":"clients"}}}},{"id":"10.48550/arxiv.2608.03846","type":"dois","attributes":{"doi":"10.48550/arxiv.2608.03846","identifiers":[{"identifier":"2608.03846","identifierType":"arXiv"}],"creators":[{"nameType":"Personal","givenName":"Nhat Trung","familyName":"Nguyen","name":"Nguyen, Nhat Trung","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Alexander","familyName":"Gasnikov","name":"Gasnikov, Alexander","affiliation":[],"nameIdentifiers":[]}],"titles":[{"title":"Sliding Methods for Hölder-Smooth Convex--Concave Minimax Optimization with Bilinear Coupling"}],"publisher":"arXiv","container":{},"publicationYear":2026,"subjects":[{"subject":"Optimization and Control (math.OC)","lang":"en","subjectScheme":"arXiv"},{"subject":"FOS: Mathematics","subjectScheme":"Fields of Science and Technology (FOS)"}],"contributors":[],"dates":[{"date":"2026-08-04T15:50:37Z","dateType":"Submitted","dateInformation":"v1"},{"date":"2026-08-05T01:02:30Z","dateType":"Updated","dateInformation":"v1"},{"date":"2026-08","dateType":"Available","dateInformation":"v1"}],"language":null,"types":{"schemaOrg":"CreativeWork","resourceTypeGeneral":"Preprint","citeproc":"article","bibtex":"misc","ris":"GEN","resourceType":"Article"},"relatedIdentifiers":[],"relatedItems":[],"sizes":[],"formats":[],"version":"1","rightsList":[{"rightsUri":"http://arxiv.org/licenses/nonexclusive-distrib/1.0/","rights":"arXiv.org perpetual, non-exclusive license"}],"descriptions":[{"descriptionType":"Abstract","description":"We study convex-concave minimax optimization problems with bilinear coupling of the form $\\min_{x\\in \\mathcal X}\\max_{y\\in \\mathcal Y} \\; f(x)+\\langle y,\\mathbf{B}x\\rangle-g(y),$ where the functions $f$ and $g$ have Hölder continuous (sub)gradients. This setting covers a broad range of regimes, from nonsmooth problems with bounded subgradient variation to smooth problems with Lipschitz continuous gradients; for a smooth component used in the coupling-induced regularizer, its Lipschitz-gradient constant is assumed to hold in the ambient space. We propose a sliding method that exploits the composite structure of the problem by querying the oracles associated with $f$, $g$, and the bilinear coupling operator at prescribed frequencies determined by their individual properties. The method is based on a recursive sliding scheme for monotone variational inequalities. We establish convergence guarantees under Hölder continuity and show how the resulting complexity bounds depend explicitly on the Hölder exponents, Hölder constants, strong convexity parameters, and spectral properties of the coupling matrix. Our analysis covers nonstrongly convex and partially strongly convex regimes. For stochastic problems, we prove a uniform expected-gap bound in the degenerate regime and, under ambient smoothness and positive effective curvature, convergence up to an explicit noise floor. Numerical experiments reproduce the predicted Hölder exponents and confirm that the number of gradient evaluations required for each function separates according to its own smoothness level rather than the worse of the two. A tomographic benchmark shows runtime gains when gradient evaluations are more expensive than the additional matrix-vector products."}],"geoLocations":[],"fundingReferences":[],"url":"https://arxiv.org/abs/2608.03846","contentUrl":null,"metadataVersion":0,"schemaVersion":"http://datacite.org/schema/kernel-4","source":"mds","isActive":true,"state":"findable","reason":null,"viewCount":0,"downloadCount":0,"referenceCount":0,"citationCount":0,"partCount":0,"partOfCount":0,"versionCount":0,"versionOfCount":0,"created":"2026-08-05T02:22:20Z","registered":null,"published":null,"updated":"2026-08-05T02:22:21Z"},"relationships":{"client":{"data":{"id":"arxiv.content","type":"clients"}}}},{"id":"10.48550/arxiv.2608.03845","type":"dois","attributes":{"doi":"10.48550/arxiv.2608.03845","identifiers":[{"identifier":"2608.03845","identifierType":"arXiv"}],"creators":[{"nameType":"Personal","givenName":"Tomohiro","familyName":"Koana","name":"Koana, Tomohiro","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Soh","familyName":"Kumabe","name":"Kumabe, Soh","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Yota","familyName":"Otachi","name":"Otachi, Yota","affiliation":[],"nameIdentifiers":[]}],"titles":[{"title":"Complexity of induced subgraph isomorphism and maximum common induced subgraph parameterized by cluster vertex deletion number"}],"publisher":"arXiv","container":{},"publicationYear":2026,"subjects":[{"subject":"Data Structures and Algorithms (cs.DS)","lang":"en","subjectScheme":"arXiv"},{"subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"}],"contributors":[],"dates":[{"date":"2026-08-04T15:50:37Z","dateType":"Submitted","dateInformation":"v1"},{"date":"2026-08-05T01:02:29Z","dateType":"Updated","dateInformation":"v1"},{"date":"2026-08","dateType":"Available","dateInformation":"v1"}],"language":null,"types":{"schemaOrg":"CreativeWork","resourceTypeGeneral":"Preprint","citeproc":"article","bibtex":"misc","ris":"GEN","resourceType":"Article"},"relatedIdentifiers":[],"relatedItems":[],"sizes":[],"formats":[],"version":"1","rightsList":[{"rightsUri":"http://arxiv.org/licenses/nonexclusive-distrib/1.0/","rights":"arXiv.org perpetual, non-exclusive license"}],"descriptions":[{"descriptionType":"Abstract","description":"We study the parameterized complexity of Induced Subgraph Isomorphism (ISI) and Maximum Common Induced Subgraph (MCIS) with respect to the cluster vertex deletion number $k$. For ISI, we give a randomized $O^*(k^{O(k)})$-time algorithm, showing that ISI is fixed-parameter tractable under this parameter and resolving an open question of Hanaka et al. [WALCOM 2026]. Our algorithm is optimal under the Exponential Time Hypothesis (ETH), and is based on a reduction to Exact Multicolored Matching solvable via algebraic techniques. For MCIS, we present a randomized $O^*(2^{O(k^2)})$-time algorithm via a reduction to a weighted variant of Exact Multicolored Matching, and we prove a matching ETH-based lower bound by showing that a $k$-by-$k$ binary matrix feasibility problem with list-constrained rows and columns admits no $O^*(2^{o(k^2)})$-time algorithm, which may be of independent interest. These results reveal that, in this setting, MCIS is strictly harder than ISI. Finally, for the three-graph variant 3-MCIS, we show that it becomes NP-hard already when each input graph has cluster vertex deletion number 2."}],"geoLocations":[],"fundingReferences":[],"url":"https://arxiv.org/abs/2608.03845","contentUrl":null,"metadataVersion":0,"schemaVersion":"http://datacite.org/schema/kernel-4","source":"mds","isActive":true,"state":"findable","reason":null,"viewCount":0,"downloadCount":0,"referenceCount":0,"citationCount":0,"partCount":0,"partOfCount":0,"versionCount":0,"versionOfCount":0,"created":"2026-08-05T02:22:19Z","registered":null,"published":null,"updated":"2026-08-05T02:22:20Z"},"relationships":{"client":{"data":{"id":"arxiv.content","type":"clients"}}}},{"id":"10.48550/arxiv.2608.03844","type":"dois","attributes":{"doi":"10.48550/arxiv.2608.03844","identifiers":[{"identifier":"2608.03844","identifierType":"arXiv"}],"creators":[{"nameType":"Personal","givenName":"Jiaming","familyName":"Chen","name":"Chen, Jiaming","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Yisen","familyName":"Gao","name":"Gao, Yisen","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Yanping","familyName":"Li","name":"Li, Yanping","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Zifan","familyName":"Liu","name":"Liu, Zifan","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Yumeng","familyName":"Zhang","name":"Zhang, Yumeng","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Jun","familyName":"Zhang","name":"Zhang, Jun","affiliation":[],"nameIdentifiers":[]}],"titles":[{"title":"MAFIA: Query-Only Memory Attacks via Probing and Factual Injection against Audited LLM Agents"}],"publisher":"arXiv","container":{},"publicationYear":2026,"subjects":[{"subject":"Artificial Intelligence (cs.AI)","lang":"en","subjectScheme":"arXiv"},{"subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"}],"contributors":[],"dates":[{"date":"2026-08-04T15:50:26Z","dateType":"Submitted","dateInformation":"v1"},{"date":"2026-08-05T01:02:28Z","dateType":"Updated","dateInformation":"v1"},{"date":"2026-08","dateType":"Available","dateInformation":"v1"}],"language":null,"types":{"schemaOrg":"CreativeWork","resourceTypeGeneral":"Preprint","citeproc":"article","bibtex":"misc","ris":"GEN","resourceType":"Article"},"relatedIdentifiers":[],"relatedItems":[],"sizes":[],"formats":[],"version":"1","rightsList":[{"rightsUri":"http://arxiv.org/licenses/nonexclusive-distrib/1.0/","rights":"arXiv.org perpetual, non-exclusive license"}],"descriptions":[{"descriptionType":"Abstract","description":"Memory-augmented LLM agents rely on rich context for long-horizon reasoning and acting, yet their memory modules expose a persistent attack surface for malicious records, making the study of memory poisoning threats imperative. However, existing query-only attacks often fail to remain effective in two realistic and prevalent settings: large-scale benign memory pools and active input auditing. Consequently, current approaches fall short when facing the dual challenges of high retrieval competitiveness and rigorous semantic checks. To overcome these limitations, we propose MAFIA, a query-only Memory Attack framework via probing and Factual Injection against Audit, tailored to this extended threat model. Specifically, MAFIA introduces: (1) a placement strategy that ensures retrieval-competitive injection via memory probing, budget allocation, and scheduling; and (2) a payload design that bypasses audits using compact factual cloaks, preserving malicious effects while maintaining high semantic similarity. Extensive evaluations reveal that MAFIA achieves up to a 90.7% attack success rate while suppressing audit detection from a peak of 83.3% to at most 7.4%, exposing critical vulnerabilities across agentic memory systems. Code will be made publicly available at https://github.com/JiamingChen1234/MAFIA."},{"descriptionType":"Other","description":"17 pages, 5 figures"}],"geoLocations":[],"fundingReferences":[],"url":"https://arxiv.org/abs/2608.03844","contentUrl":null,"metadataVersion":0,"schemaVersion":"http://datacite.org/schema/kernel-4","source":"mds","isActive":true,"state":"findable","reason":null,"viewCount":0,"downloadCount":0,"referenceCount":0,"citationCount":0,"partCount":0,"partOfCount":0,"versionCount":0,"versionOfCount":0,"created":"2026-08-05T02:22:18Z","registered":"2026-08-05T02:22:18Z","published":null,"updated":"2026-08-05T02:22:18Z"},"relationships":{"client":{"data":{"id":"arxiv.content","type":"clients"}}}},{"id":"10.48550/arxiv.2608.03843","type":"dois","attributes":{"doi":"10.48550/arxiv.2608.03843","identifiers":[{"identifier":"2608.03843","identifierType":"arXiv"}],"creators":[{"nameType":"Personal","givenName":"Tuyen","familyName":"Vu","name":"Vu, Tuyen","affiliation":[],"nameIdentifiers":[]}],"titles":[{"title":"Spectral inequalities for magnetic Neumann Laplacian on rectangles"}],"publisher":"arXiv","container":{},"publicationYear":2026,"subjects":[{"subject":"Spectral Theory (math.SP)","lang":"en","subjectScheme":"arXiv"},{"subject":"Analysis of PDEs (math.AP)","lang":"en","subjectScheme":"arXiv"},{"subject":"FOS: Mathematics","subjectScheme":"Fields of Science and Technology (FOS)"}],"contributors":[],"dates":[{"date":"2026-08-04T15:50:10Z","dateType":"Submitted","dateInformation":"v1"},{"date":"2026-08-05T01:02:26Z","dateType":"Updated","dateInformation":"v1"},{"date":"2026-08","dateType":"Available","dateInformation":"v1"}],"language":null,"types":{"schemaOrg":"CreativeWork","resourceTypeGeneral":"Preprint","citeproc":"article","bibtex":"misc","ris":"GEN","resourceType":"Article"},"relatedIdentifiers":[],"relatedItems":[],"sizes":[],"formats":[],"version":"1","rightsList":[{"rightsUri":"http://arxiv.org/licenses/nonexclusive-distrib/1.0/","rights":"arXiv.org perpetual, non-exclusive license"}],"descriptions":[{"descriptionType":"Abstract","description":"We consider the magnetic Neumann Laplacian on rectangles, subject to non-homogeneous fields. We prove that the square is a local minimiser of the lowest eigenvalue among all rectangles of a fixed area for weak magnetic fields . We conjecture that it is a global minimiser both under the area or perimeter constraints and partially prove the conjecture by establishing lower and upper bounds to the principal eigenvalue."}],"geoLocations":[],"fundingReferences":[],"url":"https://arxiv.org/abs/2608.03843","contentUrl":null,"metadataVersion":0,"schemaVersion":"http://datacite.org/schema/kernel-4","source":"mds","isActive":true,"state":"findable","reason":null,"viewCount":0,"downloadCount":0,"referenceCount":0,"citationCount":0,"partCount":0,"partOfCount":0,"versionCount":0,"versionOfCount":0,"created":"2026-08-05T02:22:16Z","registered":"2026-08-05T02:22:17Z","published":null,"updated":"2026-08-05T02:22:17Z"},"relationships":{"client":{"data":{"id":"arxiv.content","type":"clients"}}}},{"id":"10.48550/arxiv.2608.03842","type":"dois","attributes":{"doi":"10.48550/arxiv.2608.03842","identifiers":[{"identifier":"2608.03842","identifierType":"arXiv"}],"creators":[{"nameType":"Personal","givenName":"Nathan","familyName":"Labiosa","name":"Labiosa, Nathan","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"David","familyName":"Buff","name":"Buff, David","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Ena","familyName":"Nayak","name":"Nayak, Ena","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Erica","familyName":"Donno","name":"Donno, Erica","affiliation":[],"nameIdentifiers":[]}],"titles":[{"title":"Sensitivity, Causality, and Repair Dissociate: A Layer-Wise Analysis of Perturbation Robustness and Its Scaling"}],"publisher":"arXiv","container":{},"publicationYear":2026,"subjects":[{"subject":"Computation and Language (cs.CL)","lang":"en","subjectScheme":"arXiv"},{"subject":"Machine Learning (cs.LG)","lang":"en","subjectScheme":"arXiv"},{"subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"},{"subject":"I.2.7; I.2.6","lang":"en","subjectScheme":"ACM"}],"contributors":[],"dates":[{"date":"2026-08-04T15:48:55Z","dateType":"Submitted","dateInformation":"v1"},{"date":"2026-08-05T01:02:25Z","dateType":"Updated","dateInformation":"v1"},{"date":"2026-08","dateType":"Available","dateInformation":"v1"}],"language":null,"types":{"schemaOrg":"CreativeWork","resourceTypeGeneral":"Preprint","citeproc":"article","bibtex":"misc","ris":"GEN","resourceType":"Article"},"relatedIdentifiers":[],"relatedItems":[],"sizes":[],"formats":[],"version":"1","rightsList":[{"rightsUri":"http://arxiv.org/licenses/nonexclusive-distrib/1.0/","rights":"arXiv.org perpetual, non-exclusive license"}],"descriptions":[{"descriptionType":"Abstract","description":"When a language model fails on surface-perturbed input (typos, OCR noise, homophones), \"which layer is responsible\" has three natural operationalizations: where representations diverge most (sensitivity), where restoring clean activations recovers the prediction (causality), and where a small adapter can repair the damage (compensatory capacity) - and we show these three layer maps dissociate. Across a five-model panel we identify two propagation regimes - spike-and-suppress (Phi-3.5, Gemma-2-9B) and late-accumulation (Llama-3, Mistral, Qwen2.5-7B) - and on the two models meeting an 80% identity-patch gate, sensitivity and causality are anti-correlated (rho = -0.72 to -0.88). Within-family scaling on Qwen2.5 (1.5B to 14B) shows the late-accumulation signature strengthening monotonically with scale, corroborated on a second family. We propose cascade disruption as the mechanism behind the dissociation: adapters placed at causally implicated early layers break intact downstream computation, making diagnostic-flagged sites the worst adapter placements. A fixed-harness layer sweep across four models (3.8-8B) confirms the core prediction on chain-of-thought GSM8K - the flagged sites are the most damaging adapter windows on every adjudicable model - and is sign-consistent but strongly attenuated on a multiple-choice control, consistent with damage that compounds with generation length. The sweep yields practical guidance: a training-free LRD pre-screen and a default-deepest placement rule, though absolute gains over no-adapter baselines remain small. Finally, apparent gains from a representation-stability loss reverse under an adequate generation budget - truncated chain-of-thought had been scored as empty - a methodological warning for any intervention evaluated on chain-of-thought tasks."},{"descriptionType":"Other","description":"29 pages, 18 figures, 11 tables"}],"geoLocations":[],"fundingReferences":[],"url":"https://arxiv.org/abs/2608.03842","contentUrl":null,"metadataVersion":0,"schemaVersion":"http://datacite.org/schema/kernel-4","source":"mds","isActive":true,"state":"findable","reason":null,"viewCount":0,"downloadCount":0,"referenceCount":0,"citationCount":0,"partCount":0,"partOfCount":0,"versionCount":0,"versionOfCount":0,"created":"2026-08-05T02:22:15Z","registered":"2026-08-05T02:22:16Z","published":null,"updated":"2026-08-05T02:22:16Z"},"relationships":{"client":{"data":{"id":"arxiv.content","type":"clients"}}}},{"id":"10.48550/arxiv.2608.03839","type":"dois","attributes":{"doi":"10.48550/arxiv.2608.03839","identifiers":[{"identifier":"2608.03839","identifierType":"arXiv"}],"creators":[{"nameType":"Personal","givenName":"Tao","familyName":"Jin","name":"Jin, Tao","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Phuong Minh","familyName":"Nguyen","name":"Nguyen, Phuong Minh","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Zhenzhu","familyName":"Yan","name":"Yan, Zhenzhu","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Teeradaj","familyName":"Racharak","name":"Racharak, Teeradaj","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Naoya","familyName":"Inoue","name":"Inoue, Naoya","affiliation":[],"nameIdentifiers":[]}],"titles":[{"title":"Oilbird: Training-Free Speculative Decoding with Keys the Verifier Already Computes"}],"publisher":"arXiv","container":{},"publicationYear":2026,"subjects":[{"subject":"Artificial Intelligence (cs.AI)","lang":"en","subjectScheme":"arXiv"},{"subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"}],"contributors":[],"dates":[{"date":"2026-08-04T15:47:51Z","dateType":"Submitted","dateInformation":"v1"},{"date":"2026-08-05T01:02:23Z","dateType":"Updated","dateInformation":"v1"},{"date":"2026-08","dateType":"Available","dateInformation":"v1"}],"language":null,"types":{"schemaOrg":"CreativeWork","resourceTypeGeneral":"Preprint","citeproc":"article","bibtex":"misc","ris":"GEN","resourceType":"Article"},"relatedIdentifiers":[],"relatedItems":[],"sizes":[],"formats":[],"version":"1","rightsList":[{"rightsIdentifierScheme":"SPDX","rightsUri":"https://creativecommons.org/licenses/by/4.0/legalcode","schemeUri":"https://spdx.org/licenses/","rights":"Creative Commons Attribution 4.0 International","rightsIdentifier":"cc-by-4.0"}],"descriptions":[{"descriptionType":"Abstract","description":"Training-free speculative decoding drafts by matching an exact suffix of the context against a pool of earlier context. That lookup misses correct drafts already in the pool, most visibly on tool-calling traffic, where a request repeats almost everything but the few values minted for it, and where one rejected token discards the correct continuation behind it. We diagnose the failure position by position across ten benchmarks and find it to be a problem of addressing rather than of coverage: on our densest tool-calling benchmark, about half of what the strongest exact-match drafter misses is present in the pool yet unreachable by exact matching. We therefore propose a second, semantic draft source: the same pool, re-keyed by the hidden state the verifier has already computed at each committed token, together with a merge that lets it ride inside an existing lexical drafter's tree. In three published drafters, at matched pool and budget, it lifts accepted length by 24-29%. Oilbird reaches 4.4x autoregressive decoding speed on API-Bank, against 3.9x for the strongest training-free baseline in our harness and 2.0x for EAGLE-3."}],"geoLocations":[],"fundingReferences":[],"url":"https://arxiv.org/abs/2608.03839","contentUrl":null,"metadataVersion":0,"schemaVersion":"http://datacite.org/schema/kernel-4","source":"mds","isActive":true,"state":"findable","reason":null,"viewCount":0,"downloadCount":0,"referenceCount":0,"citationCount":0,"partCount":0,"partOfCount":0,"versionCount":0,"versionOfCount":0,"created":"2026-08-05T02:22:11Z","registered":"2026-08-05T02:22:11Z","published":null,"updated":"2026-08-05T02:22:11Z"},"relationships":{"client":{"data":{"id":"arxiv.content","type":"clients"}}}},{"id":"10.48550/arxiv.2608.03838","type":"dois","attributes":{"doi":"10.48550/arxiv.2608.03838","identifiers":[{"identifier":"2608.03838","identifierType":"arXiv"}],"creators":[{"nameType":"Personal","givenName":"Zhinan","familyName":"Liu","name":"Liu, Zhinan","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Jie","familyName":"Li","name":"Li, Jie","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Mingyu","familyName":"Kang","name":"Kang, Mingyu","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Jiayi","familyName":"Ji","name":"Ji, Jiayi","affiliation":[],"nameIdentifiers":[]}],"titles":[{"title":"LatentGuard: Efficient and Inspectable Latent Reasoning for LLM Safeguards"}],"publisher":"arXiv","container":{},"publicationYear":2026,"subjects":[{"subject":"Artificial Intelligence (cs.AI)","lang":"en","subjectScheme":"arXiv"},{"subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"}],"contributors":[],"dates":[{"date":"2026-08-04T15:47:41Z","dateType":"Submitted","dateInformation":"v1"},{"date":"2026-08-05T01:02:22Z","dateType":"Updated","dateInformation":"v1"},{"date":"2026-08","dateType":"Available","dateInformation":"v1"}],"language":null,"types":{"schemaOrg":"CreativeWork","resourceTypeGeneral":"Preprint","citeproc":"article","bibtex":"misc","ris":"GEN","resourceType":"Article"},"relatedIdentifiers":[],"relatedItems":[],"sizes":[],"formats":[],"version":"1","rightsList":[{"rightsIdentifierScheme":"SPDX","rightsUri":"https://creativecommons.org/licenses/by/4.0/legalcode","schemeUri":"https://spdx.org/licenses/","rights":"Creative Commons Attribution 4.0 International","rightsIdentifier":"cc-by-4.0"}],"descriptions":[{"descriptionType":"Abstract","description":"Reasoning-based guard models improve LLM safeguards, but decoding explicit rationales for every interaction makes them costly to deploy. Although latent-reasoning methods reduce token generation by moving reasoning into continuous states, they remain underexplored for safety moderation and lack an inspection interface for deployment. In this paper, we propose LatentGuard, an efficient and inspectable safeguard framework that brings continuous latent reasoning to guard models. LatentGuard uses a staged curriculum to progressively compress task-aligned textual rationales into compact latent states, enabling safety verdicts to be predicted directly from continuous representations. To preserve inspectability, an isolated auxiliary decoder generates compact audit artifacts on demand, keeping rationale generation off the standard inference path. Experiments show that LatentGuard-8B improves mean weighted F1 from 83.95 to 84.91 over GuardReasoner-8B, while reducing critical-path reasoning cost from 268.56 generated rationale tokens to 1.60 latent reasoning tokens. Its audit decoder achieves an audit utility score of 85.75, demonstrating an efficient and inspectable path toward deployable LLM safeguards."}],"geoLocations":[],"fundingReferences":[],"url":"https://arxiv.org/abs/2608.03838","contentUrl":null,"metadataVersion":0,"schemaVersion":"http://datacite.org/schema/kernel-4","source":"mds","isActive":true,"state":"findable","reason":null,"viewCount":0,"downloadCount":0,"referenceCount":0,"citationCount":0,"partCount":0,"partOfCount":0,"versionCount":0,"versionOfCount":0,"created":"2026-08-05T02:22:09Z","registered":null,"published":null,"updated":"2026-08-05T02:22:10Z"},"relationships":{"client":{"data":{"id":"arxiv.content","type":"clients"}}}},{"id":"10.48550/arxiv.2608.03835","type":"dois","attributes":{"doi":"10.48550/arxiv.2608.03835","identifiers":[{"identifier":"2608.03835","identifierType":"arXiv"}],"creators":[{"nameType":"Personal","givenName":"D.","familyName":"Hamm","name":"Hamm, D.","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"G.","familyName":"Partesotti","name":"Partesotti, G.","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"C.","familyName":"Theiler","name":"Theiler, C.","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"U.","familyName":"Sheikh","name":"Sheikh, U.","affiliation":[],"nameIdentifiers":[]}],"titles":[{"title":"Synthetic Diagnostic Modeling for Plasma Tomography: Geometry Matrix Computation Methods and Impact of Model Accuracy"}],"publisher":"arXiv","container":{},"publicationYear":2026,"subjects":[{"subject":"Plasma Physics (physics.plasm-ph)","lang":"en","subjectScheme":"arXiv"},{"subject":"FOS: Physical sciences","subjectScheme":"Fields of Science and Technology (FOS)"}],"contributors":[],"dates":[{"date":"2026-08-04T15:44:30Z","dateType":"Submitted","dateInformation":"v1"},{"date":"2026-08-05T01:02:19Z","dateType":"Updated","dateInformation":"v1"},{"date":"2026-08","dateType":"Available","dateInformation":"v1"}],"language":null,"types":{"schemaOrg":"CreativeWork","resourceTypeGeneral":"Preprint","citeproc":"article","bibtex":"misc","ris":"GEN","resourceType":"Article"},"relatedIdentifiers":[],"relatedItems":[],"sizes":[],"formats":[],"version":"1","rightsList":[{"rightsIdentifierScheme":"SPDX","rightsUri":"https://creativecommons.org/licenses/by/4.0/legalcode","schemeUri":"https://spdx.org/licenses/","rights":"Creative Commons Attribution 4.0 International","rightsIdentifier":"cc-by-4.0"}],"descriptions":[{"descriptionType":"Abstract","description":"Tomographic emissivity reconstruction from plasma diagnostics data relies on a synthetic model mapping the plasma emissivity to the measured signals. The model, referred to as a geometry matrix in the plasma imaging community, is often built using the line-of-sight (LoS) approximation. This approximation neglects the finite width of the detector viewing beams and can therefore introduce systematic errors. Physically correct volume-of-sight (VoS) models remove this inaccuracy by accounting for the full 3D extent of the viewing beams. Their adoption, however, is sometimes hindered by the difficulty of independently validating them. We present an intuitive and easily inspectable voxel-to-detector (V2D) approach for computing physically accurate VoS geometry matrices, based on discretizing the tokamak vessel into voxels and estimating the contribution of each voxel to the measurements of each detector. We apply the V2D approach to the soft X-ray (SXR) and bolometry systems of the TCV tokamak. Through phantom-based studies on physically realistic emissivity profiles, we quantify the improvement in reconstruction quality obtained by using VoS rather than LoS models. We find that the VoS model yields overall better accuracy and precision; however, interestingly, the simpler LoS model does not introduce a significant systematic bias in the estimated total, core, divertor and main chamber radiated powers. We further compare the V2D geometry matrix with an independent ray-tracing implementation, finding excellent agreement that validates both approaches for routine use at TCV. All routines developed in this work are made openly available."}],"geoLocations":[],"fundingReferences":[],"url":"https://arxiv.org/abs/2608.03835","contentUrl":null,"metadataVersion":0,"schemaVersion":"http://datacite.org/schema/kernel-4","source":"mds","isActive":true,"state":"findable","reason":null,"viewCount":0,"downloadCount":0,"referenceCount":0,"citationCount":0,"partCount":0,"partOfCount":0,"versionCount":0,"versionOfCount":0,"created":"2026-08-05T02:22:05Z","registered":"2026-08-05T02:22:06Z","published":null,"updated":"2026-08-05T02:22:06Z"},"relationships":{"client":{"data":{"id":"arxiv.content","type":"clients"}}}},{"id":"10.48550/arxiv.2608.03834","type":"dois","attributes":{"doi":"10.48550/arxiv.2608.03834","identifiers":[{"identifier":"2608.03834","identifierType":"arXiv"}],"creators":[{"nameType":"Personal","givenName":"Eiichi","familyName":"Bannai","name":"Bannai, Eiichi","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Sho","familyName":"Suda","name":"Suda, Sho","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Yan","familyName":"Zhu","name":"Zhu, Yan","affiliation":[],"nameIdentifiers":[]}],"titles":[{"title":"$P$-polynomial coherent configurations"}],"publisher":"arXiv","container":{},"publicationYear":2026,"subjects":[{"subject":"Combinatorics (math.CO)","lang":"en","subjectScheme":"arXiv"},{"subject":"FOS: Mathematics","subjectScheme":"Fields of Science and Technology (FOS)"}],"contributors":[],"dates":[{"date":"2026-08-04T15:43:20Z","dateType":"Submitted","dateInformation":"v1"},{"date":"2026-08-05T01:02:15Z","dateType":"Updated","dateInformation":"v1"},{"date":"2026-08","dateType":"Available","dateInformation":"v1"}],"language":null,"types":{"schemaOrg":"CreativeWork","resourceTypeGeneral":"Preprint","citeproc":"article","bibtex":"misc","ris":"GEN","resourceType":"Article"},"relatedIdentifiers":[],"relatedItems":[],"sizes":[],"formats":[],"version":"1","rightsList":[{"rightsIdentifierScheme":"SPDX","rightsUri":"https://creativecommons.org/licenses/by/4.0/legalcode","schemeUri":"https://spdx.org/licenses/","rights":"Creative Commons Attribution 4.0 International","rightsIdentifier":"cc-by-4.0"}],"descriptions":[{"descriptionType":"Abstract","description":"Suda introduced the notion of a $Q$-polynomial coherent configuration, which provides a natural and important concept. Subsequently, Lato introduced a notion of a $P$-polynomial coherent configuration and proved that every such configuration satisfying the definition has at most two fibers. Although Lato's definition is interesting, particularly because it characterizes distance-biregular graphs, we argue that an alternative definition is desirable. In this paper, we propose an alternative notion of $P$-polynomial coherent configurations that is naturally aligned with Suda's $Q$-polynomial framework. We show that every two-fiber coherent configuration that is $P$-polynomial in Lato's sense is also $P$-polynomial in our sense, whereas the converse does not hold. We further prove that every coherent configuration of type $(2,2;3)$, $(3,2;3)$ or $(3,3;3)$ is $P$-polynomial in our sense. In addition, we present three families of $P$-polynomial coherent configurations with an arbitrary number of fibers: those arising from tight Euclidean $t$-designs in $\\mathbb R^2$, the Terwilliger algebra of $H(n,2)$, and the set of all subspaces of $\\mathbb F_q^n$. Finally, we give an equivalent condition for the cross-block intersection matrices to be tridiagonal and verify that all three families satisfy this condition."},{"descriptionType":"Other","description":"25 pages"}],"geoLocations":[],"fundingReferences":[],"url":"https://arxiv.org/abs/2608.03834","contentUrl":null,"metadataVersion":0,"schemaVersion":"http://datacite.org/schema/kernel-4","source":"mds","isActive":true,"state":"findable","reason":null,"viewCount":0,"downloadCount":0,"referenceCount":0,"citationCount":0,"partCount":0,"partOfCount":0,"versionCount":0,"versionOfCount":0,"created":"2026-08-05T02:22:04Z","registered":"2026-08-05T02:22:05Z","published":null,"updated":"2026-08-05T02:22:05Z"},"relationships":{"client":{"data":{"id":"arxiv.content","type":"clients"}}}},{"id":"10.48550/arxiv.2608.03832","type":"dois","attributes":{"doi":"10.48550/arxiv.2608.03832","identifiers":[{"identifier":"2608.03832","identifierType":"arXiv"}],"creators":[{"nameType":"Personal","givenName":"Kevin S.","familyName":"Kapner","name":"Kapner, Kevin S.","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Jeffrey W.","familyName":"Miller","name":"Miller, Jeffrey W.","affiliation":[],"nameIdentifiers":[]}],"titles":[{"title":"Reduced-rank Generalized Bilinear Models"}],"publisher":"arXiv","container":{},"publicationYear":2026,"subjects":[{"subject":"Methodology (stat.ME)","lang":"en","subjectScheme":"arXiv"},{"subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"}],"contributors":[],"dates":[{"date":"2026-08-04T15:39:32Z","dateType":"Submitted","dateInformation":"v1"},{"date":"2026-08-05T01:02:08Z","dateType":"Updated","dateInformation":"v1"},{"date":"2026-08","dateType":"Available","dateInformation":"v1"}],"language":null,"types":{"schemaOrg":"CreativeWork","resourceTypeGeneral":"Preprint","citeproc":"article","bibtex":"misc","ris":"GEN","resourceType":"Article"},"relatedIdentifiers":[],"relatedItems":[],"sizes":[],"formats":[],"version":"1","rightsList":[{"rightsIdentifierScheme":"SPDX","rightsUri":"https://creativecommons.org/licenses/by/4.0/legalcode","schemeUri":"https://spdx.org/licenses/","rights":"Creative Commons Attribution 4.0 International","rightsIdentifier":"cc-by-4.0"}],"descriptions":[{"descriptionType":"Abstract","description":"Dimensionality reduction and effect estimation are central tasks in the analysis of high-dimensional data such as in genomics. Generalized bilinear models (GBMs) provide a versatile framework for these tasks, however, the statistical and computational efficiency of GBMs degrades rapidly as the number of sample covariates grows. To address this limitation, we introduce reduced-rank generalized bilinear models (RR-GBMs), which employ a reduced-rank sample coefficient matrix to model the effect of a large number of covariates without requiring an excessive number of parameters. In simulation studies, we find that when the true sample coefficient matrix is reduced rank or close to reduced rank, RR-GBM outperforms the standard full-rank GBM both statistically and computationally, providing more accurate estimates with lower computational burden. We develop a data thinning approach for model selection in the RR-GBM framework, facilitating rank selection. Furthermore, RR-GBM enables a new approach to visualizing the relationships among covariates and among features. We demonstrate the method in an application to Perturb-seq data for pancreatic cancer."}],"geoLocations":[],"fundingReferences":[],"url":"https://arxiv.org/abs/2608.03832","contentUrl":null,"metadataVersion":0,"schemaVersion":"http://datacite.org/schema/kernel-4","source":"mds","isActive":true,"state":"findable","reason":null,"viewCount":0,"downloadCount":0,"referenceCount":0,"citationCount":0,"partCount":0,"partOfCount":0,"versionCount":0,"versionOfCount":0,"created":"2026-08-05T02:22:01Z","registered":"2026-08-05T02:22:02Z","published":null,"updated":"2026-08-05T02:22:02Z"},"relationships":{"client":{"data":{"id":"arxiv.content","type":"clients"}}}},{"id":"10.48550/arxiv.2608.03831","type":"dois","attributes":{"doi":"10.48550/arxiv.2608.03831","identifiers":[{"identifier":"2608.03831","identifierType":"arXiv"}],"creators":[{"nameType":"Personal","givenName":"Werner","familyName":"Brämer-Escamilla","name":"Brämer-Escamilla, Werner","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Floralba","familyName":"Lopez","name":"Lopez, Floralba","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Laila","familyName":"Procel","name":"Procel, Laila","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"David","familyName":"Llerena","name":"Llerena, David","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Carlos","familyName":"Sabater","name":"Sabater, Carlos","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Ernesto","familyName":"Medina","name":"Medina, Ernesto","affiliation":[],"nameIdentifiers":[]}],"titles":[{"title":"Wavelength-Selective control of Atomic Scale Au Contacts"}],"publisher":"arXiv","container":{},"publicationYear":2026,"subjects":[{"subject":"Mesoscale and Nanoscale Physics (cond-mat.mes-hall)","lang":"en","subjectScheme":"arXiv"},{"subject":"Materials Science (cond-mat.mtrl-sci)","lang":"en","subjectScheme":"arXiv"},{"subject":"FOS: Physical sciences","subjectScheme":"Fields of Science and Technology (FOS)"}],"contributors":[],"dates":[{"date":"2026-08-04T15:39:13Z","dateType":"Submitted","dateInformation":"v1"},{"date":"2026-08-05T01:02:07Z","dateType":"Updated","dateInformation":"v1"},{"date":"2026-08","dateType":"Available","dateInformation":"v1"}],"language":null,"types":{"schemaOrg":"CreativeWork","resourceTypeGeneral":"Preprint","citeproc":"article","bibtex":"misc","ris":"GEN","resourceType":"Article"},"relatedIdentifiers":[],"relatedItems":[],"sizes":[],"formats":[],"version":"1","rightsList":[{"rightsUri":"http://arxiv.org/licenses/nonexclusive-distrib/1.0/","rights":"arXiv.org perpetual, non-exclusive license"}],"descriptions":[{"descriptionType":"Abstract","description":"We demonstrate wavelength-selective control of atomic motion in a mechanically controllable Au break junction. Excitation at $λ_{\\mathrm{form}}\\simeq 530~{\\rm nm}$ drives gap closure and metallic bridge formation, whereas excitation at $λ_{\\mathrm{rup}}\\simeq 407~{\\rm nm}$ drives neck thinning, bridge rupture, and subsequent gap opening. Unlike conventional optical switching in metallic contacts, where illumination primarily acts via thermal expansion, the present experiment reveals oppositely directed atomic drift at different wavelengths. Time-resolved conductance traces allow us to distinguish two dynamical regimes. In the tunneling regime, exponential conductance transients measure the drift velocity of the gap coordinate for both gap closure and gap opening. In the metallic regime, the Sharvin relation converts linear $\\sqrt{G/G_0}$ transients into radial neck-growth and neck-thinning velocities of comparable magnitude. These results establish optically selected atomic drift as a mechanism for reversible control of metallic nanocontacts and provide a quantitative route to follow plasmon-assisted atomic rearrangements in real time."},{"descriptionType":"Other","description":"10 pages, 8 figures"}],"geoLocations":[],"fundingReferences":[],"url":"https://arxiv.org/abs/2608.03831","contentUrl":null,"metadataVersion":0,"schemaVersion":"http://datacite.org/schema/kernel-4","source":"mds","isActive":true,"state":"findable","reason":null,"viewCount":0,"downloadCount":0,"referenceCount":0,"citationCount":0,"partCount":0,"partOfCount":0,"versionCount":0,"versionOfCount":0,"created":"2026-08-05T02:22:00Z","registered":"2026-08-05T02:22:01Z","published":null,"updated":"2026-08-05T02:22:01Z"},"relationships":{"client":{"data":{"id":"arxiv.content","type":"clients"}}}},{"id":"10.48550/arxiv.2608.03830","type":"dois","attributes":{"doi":"10.48550/arxiv.2608.03830","identifiers":[{"identifier":"2608.03830","identifierType":"arXiv"}],"creators":[{"nameType":"Personal","givenName":"Tomohiro","familyName":"Koana","name":"Koana, Tomohiro","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Soh","familyName":"Kumabe","name":"Kumabe, Soh","affiliation":[],"nameIdentifiers":[]}],"titles":[{"title":"A Single-Exponential FPT Algorithm for 2-Vertex-Connectivity Augmentation"}],"publisher":"arXiv","container":{},"publicationYear":2026,"subjects":[{"subject":"Data Structures and Algorithms (cs.DS)","lang":"en","subjectScheme":"arXiv"},{"subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"}],"contributors":[],"dates":[{"date":"2026-08-04T15:38:03Z","dateType":"Submitted","dateInformation":"v1"},{"date":"2026-08-05T01:02:03Z","dateType":"Updated","dateInformation":"v1"},{"date":"2026-08","dateType":"Available","dateInformation":"v1"}],"language":null,"types":{"schemaOrg":"CreativeWork","resourceTypeGeneral":"Preprint","citeproc":"article","bibtex":"misc","ris":"GEN","resourceType":"Article"},"relatedIdentifiers":[],"relatedItems":[],"sizes":[],"formats":[],"version":"1","rightsList":[{"rightsUri":"http://arxiv.org/licenses/nonexclusive-distrib/1.0/","rights":"arXiv.org perpetual, non-exclusive license"}],"descriptions":[{"descriptionType":"Abstract","description":"We study restricted-link augmentation to $2$-vertex-connectivity. An instance consists of a graph $G$, possibly disconnected, a set $L$ of admissible links on its vertices, integer link costs in $\\{1,\\dots,W\\}$, and an integer $k$; the task is to add at most $k$ links of minimum total cost so that the resulting multigraph is $2$-vertex-connected. Recent work gives $O^*(k^{O(k)})$-time algorithms for unweighted $λ$-vertex-connectivity augmentation for every $λ\\leq 4$ [Carmesin and Ramanujan, SODA 2026], and an $O^*((k+λ)^{O(k)})$-time algorithm for arbitrary $λ$ [Korhonen and Thorup, arXiv 2026]. We give a deterministic algorithm with running time $O^*(36^kW)$. Thus, for $λ=2$, the unweighted running time improves from $O^*(k^{O(k)})$ to $O^*(36^k)$, and the algorithm also handles link costs with pseudo-polynomial dependence on $W$.\n We reduce the problem to a boundary-pair variant of $2$-vertex-connected spanning subgraph, where each vertex is assigned a pair of incident edges with an associated pair cost. We solve this variant using a cancellation identity, inspired by Cut\u0026amp;Count [Cygan et al., TALG 2022], obtained by applying Möbius inversion to decompositions along cut vertices: the identity cancels every connected spanning graph with more than one block and keeps exactly the $2$-vertex-connected spanning graphs."}],"geoLocations":[],"fundingReferences":[],"url":"https://arxiv.org/abs/2608.03830","contentUrl":null,"metadataVersion":0,"schemaVersion":"http://datacite.org/schema/kernel-4","source":"mds","isActive":true,"state":"findable","reason":null,"viewCount":0,"downloadCount":0,"referenceCount":0,"citationCount":0,"partCount":0,"partOfCount":0,"versionCount":0,"versionOfCount":0,"created":"2026-08-05T02:21:59Z","registered":"2026-08-05T02:21:59Z","published":null,"updated":"2026-08-05T02:21:59Z"},"relationships":{"client":{"data":{"id":"arxiv.content","type":"clients"}}}},{"id":"10.48550/arxiv.2608.03829","type":"dois","attributes":{"doi":"10.48550/arxiv.2608.03829","identifiers":[{"identifier":"2608.03829","identifierType":"arXiv"}],"creators":[{"nameType":"Personal","givenName":"Erico S. P.","familyName":"Lopes","name":"Lopes, Erico S. P.","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Lukas T. N.","familyName":"Landau","name":"Landau, Lukas T. N.","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Amine","familyName":"Mezghani","name":"Mezghani, Amine","affiliation":[],"nameIdentifiers":[]}],"titles":[{"title":"Power Minimization under Quality of Service Constraints for MIMO Systems with a RIS-based Transmitter"}],"publisher":"arXiv","container":{},"publicationYear":2026,"subjects":[{"subject":"Information Theory (cs.IT)","lang":"en","subjectScheme":"arXiv"},{"subject":"Probability (math.PR)","lang":"en","subjectScheme":"arXiv"},{"subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"},{"subject":"FOS: Mathematics","subjectScheme":"Fields of Science and Technology (FOS)"}],"contributors":[],"dates":[{"date":"2026-08-04T15:37:43Z","dateType":"Submitted","dateInformation":"v1"},{"date":"2026-08-05T01:02:02Z","dateType":"Updated","dateInformation":"v1"},{"date":"2026-08","dateType":"Available","dateInformation":"v1"}],"language":null,"types":{"schemaOrg":"CreativeWork","resourceTypeGeneral":"Preprint","citeproc":"article","bibtex":"misc","ris":"GEN","resourceType":"Article"},"relatedIdentifiers":[{"relationType":"IsVersionOf","relatedIdentifier":"10.1109/tcomm.2025.3621247","relatedIdentifierType":"DOI"}],"relatedItems":[],"sizes":[],"formats":[],"version":"1","rightsList":[{"rightsUri":"http://arxiv.org/licenses/nonexclusive-distrib/1.0/","rights":"arXiv.org perpetual, non-exclusive license"}],"descriptions":[{"descriptionType":"Abstract","description":"This study investigates a virtual multiuser multiple-input multiple-output (MU-MIMO) system with PSK modulation, realized with a reconfigurable intelligent surface (RIS)-based transmitter. The study focuses on minimizing transmit power under quality-of-service (QoS) constraints while addressing the associated computational complexity. A discrete phase-shift RIS model is considered, and the power minimization problem is formulated in two scenarios. First, for QPSK user data, the symbol-error probability (SEP) is adopted as the QoS criterion. Second, for general $M$-PSK modulation, the union-bound SEP (UBSEP) is used to define the QoS constraints. Based on the considered formulations, a partial branch-and-bound (PBB) approach is developed, which improves on full branch-and-bound (FBB) methods in the sense of allowing for favorable complexity performance trade-offs. For the special case of high-resolution RIS, the discrete phase-shift set is approximated by its continuous counterpart, enabling the reformulation of the original problems as constrained optimizations on an oblique manifold, which are solved with reduced computational complexity with the proposed bisection method. Numerical results demonstrate the effectiveness of the proposed approaches in minimizing the transmit power for different SEP requirements and showcase the balance between power efficiency and computational complexity"}],"geoLocations":[],"fundingReferences":[],"url":"https://arxiv.org/abs/2608.03829","contentUrl":null,"metadataVersion":0,"schemaVersion":"http://datacite.org/schema/kernel-4","source":"mds","isActive":true,"state":"findable","reason":null,"viewCount":0,"downloadCount":0,"referenceCount":0,"citationCount":0,"partCount":0,"partOfCount":0,"versionCount":0,"versionOfCount":1,"created":"2026-08-05T02:21:57Z","registered":"2026-08-05T02:21:58Z","published":null,"updated":"2026-08-05T02:21:58Z"},"relationships":{"client":{"data":{"id":"arxiv.content","type":"clients"}}}},{"id":"10.48550/arxiv.2608.03826","type":"dois","attributes":{"doi":"10.48550/arxiv.2608.03826","identifiers":[{"identifier":"2608.03826","identifierType":"arXiv"}],"creators":[{"nameType":"Personal","givenName":"Jiapeng","familyName":"Li","name":"Li, Jiapeng","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Yong","familyName":"Li","name":"Li, Yong","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Junjie","familyName":"Zhou","name":"Zhou, Junjie","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Fan","familyName":"Zhang","name":"Zhang, Fan","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Yu","familyName":"Liu","name":"Liu, Yu","affiliation":[],"nameIdentifiers":[]}],"titles":[{"title":"Geo-Embed: Towards Unified Multimodal Embeddings for Urban Understanding"}],"publisher":"arXiv","container":{},"publicationYear":2026,"subjects":[{"subject":"Computer Vision and Pattern Recognition (cs.CV)","lang":"en","subjectScheme":"arXiv"},{"subject":"Machine Learning (cs.LG)","lang":"en","subjectScheme":"arXiv"},{"subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"}],"contributors":[],"dates":[{"date":"2026-08-04T15:36:17Z","dateType":"Submitted","dateInformation":"v1"},{"date":"2026-08-05T01:01:57Z","dateType":"Updated","dateInformation":"v1"},{"date":"2026-08","dateType":"Available","dateInformation":"v1"}],"language":null,"types":{"schemaOrg":"CreativeWork","resourceTypeGeneral":"Preprint","citeproc":"article","bibtex":"misc","ris":"GEN","resourceType":"Article"},"relatedIdentifiers":[],"relatedItems":[],"sizes":[],"formats":[],"version":"1","rightsList":[{"rightsIdentifierScheme":"SPDX","rightsUri":"https://creativecommons.org/licenses/by/4.0/legalcode","schemeUri":"https://spdx.org/licenses/","rights":"Creative Commons Attribution 4.0 International","rightsIdentifier":"cc-by-4.0"}],"descriptions":[{"descriptionType":"Abstract","description":"Geospatial and urban applications increasingly require models to compare heterogeneous evidence across street-view imagery, remote-sensing observations, text descriptions, region proposals, and temporal change cues. However, existing multimodal embedding models and benchmarks are still largely designed and evaluated around general-purpose image-text matching, leaving unclear whether unified embedding space can support heterogeneous geospatial tasks involving spatial relationships, fine-grained semantics, and temporal changes. To address this gap, we make three key contributions. First, we introduce GeoMEB, a large-scale multimodal embedding benchmark that standardizes 45 urban evaluation tasks across retrieval, visual question answering, change detection, classification, and visual grounding, together with training collections comprising 1.32M examples and 286K evaluation queries. Second, we present Geo-Embed, a unified embedding model that adapts a shared vision-language backbone to instruction-conditioned query-target matching over heterogeneous geospatial inputs, including single images, multiple images, text, regions, and masks. On GeoMEB, Geo-Embed achieves the strongest overall performance among representative multimodal embedders, with a 15.3% relative improvement over the strongest baseline. These results motivate future geospatial embedders that organize training and evaluation around explicit query-target relations, including semantic, cross-view, region-level, and temporal correspondence."}],"geoLocations":[],"fundingReferences":[],"url":"https://arxiv.org/abs/2608.03826","contentUrl":null,"metadataVersion":0,"schemaVersion":"http://datacite.org/schema/kernel-4","source":"mds","isActive":true,"state":"findable","reason":null,"viewCount":0,"downloadCount":0,"referenceCount":0,"citationCount":0,"partCount":0,"partOfCount":0,"versionCount":0,"versionOfCount":0,"created":"2026-08-05T02:21:53Z","registered":null,"published":null,"updated":"2026-08-05T02:21:53Z"},"relationships":{"client":{"data":{"id":"arxiv.content","type":"clients"}}}},{"id":"10.48550/arxiv.2608.03825","type":"dois","attributes":{"doi":"10.48550/arxiv.2608.03825","identifiers":[{"identifier":"2608.03825","identifierType":"arXiv"}],"creators":[{"nameType":"Personal","givenName":"Antonio","familyName":"Acuaviva","name":"Acuaviva, Antonio","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Arturo","familyName":"Acuaviva","name":"Acuaviva, Arturo","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Pablo","familyName":"Acuaviva","name":"Acuaviva, Pablo","affiliation":[],"nameIdentifiers":[]}],"titles":[{"title":"CNOT-Distance is NP-complete under all-to-all connectivity"}],"publisher":"arXiv","container":{},"publicationYear":2026,"subjects":[{"subject":"Quantum Physics (quant-ph)","lang":"en","subjectScheme":"arXiv"},{"subject":"Computational Complexity (cs.CC)","lang":"en","subjectScheme":"arXiv"},{"subject":"FOS: Physical sciences","subjectScheme":"Fields of Science and Technology (FOS)"},{"subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"},{"subject":"F.1.3","lang":"en","subjectScheme":"ACM"},{"subject":"68Q12","lang":"en","subjectScheme":"MSC"}],"contributors":[],"dates":[{"date":"2026-08-04T15:34:26Z","dateType":"Submitted","dateInformation":"v1"},{"date":"2026-08-05T01:01:55Z","dateType":"Updated","dateInformation":"v1"},{"date":"2026-08","dateType":"Available","dateInformation":"v1"}],"language":null,"types":{"schemaOrg":"CreativeWork","resourceTypeGeneral":"Preprint","citeproc":"article","bibtex":"misc","ris":"GEN","resourceType":"Article"},"relatedIdentifiers":[],"relatedItems":[],"sizes":[],"formats":[],"version":"1","rightsList":[{"rightsIdentifierScheme":"SPDX","rightsUri":"https://creativecommons.org/licenses/by/4.0/legalcode","schemeUri":"https://spdx.org/licenses/","rights":"Creative Commons Attribution 4.0 International","rightsIdentifier":"cc-by-4.0"}],"descriptions":[{"descriptionType":"Abstract","description":"Given $A\\in\\operatorname{GL}(N,2)$ and an integer $K$, we ask whether $A$ can be implemented by at most $K$ CNOT gates on fixed labelled wires with all-to-all connectivity. We prove that this problem is NP-complete. From a finite simple graph $G=(V,E)$, we construct an upper-unitriangular matrix $A_G\\in\\operatorname{GL}(2|V|+|E|+1,2)$ satisfying $\\ell_{\\mathrm{CNOT}}(A_G)=2|V|+2|E|+τ(G)$, where $τ(G)$ is the minimum vertex-cover size. Each target matrix has $O(N)$ nonzero entries and row Hamming weight at most four. The lower bound unfolds an arbitrary CNOT circuit into an XOR directed acyclic graph and applies projection--contraction operations, allowing cancellation and unrestricted reuse of intermediate parities. For this family, the optimum is unchanged by any finite number of clean or borrowed ancillary wires that must be restored. A polynomial-time decoder further yields NP-hardness of approximation within every fixed additive constant and, through an L-reduction from Minimum Vertex Cover on cubic graphs, APX-hardness of the associated CNOT-circuit optimisation problem."}],"geoLocations":[],"fundingReferences":[],"url":"https://arxiv.org/abs/2608.03825","contentUrl":null,"metadataVersion":0,"schemaVersion":"http://datacite.org/schema/kernel-4","source":"mds","isActive":true,"state":"findable","reason":null,"viewCount":0,"downloadCount":0,"referenceCount":0,"citationCount":0,"partCount":0,"partOfCount":0,"versionCount":0,"versionOfCount":0,"created":"2026-08-05T02:21:51Z","registered":"2026-08-05T02:21:52Z","published":null,"updated":"2026-08-05T02:21:52Z"},"relationships":{"client":{"data":{"id":"arxiv.content","type":"clients"}}}},{"id":"10.48550/arxiv.2608.03824","type":"dois","attributes":{"doi":"10.48550/arxiv.2608.03824","identifiers":[{"identifier":"2608.03824","identifierType":"arXiv"}],"creators":[{"nameType":"Personal","givenName":"Longcheng","familyName":"Li","name":"Li, Longcheng","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Qian","familyName":"Li","name":"Li, Qian","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Xingjian","familyName":"Li","name":"Li, Xingjian","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Qipeng","familyName":"Liu","name":"Liu, Qipeng","affiliation":[],"nameIdentifiers":[]}],"titles":[{"title":"Impossibility of Perfectly Complete Many-Round Key Agreement in the QROM"}],"publisher":"arXiv","container":{},"publicationYear":2026,"subjects":[{"subject":"Quantum Physics (quant-ph)","lang":"en","subjectScheme":"arXiv"},{"subject":"FOS: Physical sciences","subjectScheme":"Fields of Science and Technology (FOS)"}],"contributors":[],"dates":[{"date":"2026-08-04T15:33:42Z","dateType":"Submitted","dateInformation":"v1"},{"date":"2026-08-05T01:01:54Z","dateType":"Updated","dateInformation":"v1"},{"date":"2026-08","dateType":"Available","dateInformation":"v1"}],"language":null,"types":{"schemaOrg":"CreativeWork","resourceTypeGeneral":"Preprint","citeproc":"article","bibtex":"misc","ris":"GEN","resourceType":"Article"},"relatedIdentifiers":[],"relatedItems":[],"sizes":[],"formats":[],"version":"1","rightsList":[{"rightsIdentifierScheme":"SPDX","rightsUri":"https://creativecommons.org/licenses/by/4.0/legalcode","schemeUri":"https://spdx.org/licenses/","rights":"Creative Commons Attribution 4.0 International","rightsIdentifier":"cc-by-4.0"}],"descriptions":[{"descriptionType":"Abstract","description":"This paper proves that it is impossible to construct perfectly complete quantum key agreement protocols (QKA) from quantumly secure one-way functions (OWFs) in a black-box manner.\n Specifically, consider any protocol in which Alice and Bob exchange only classical messages, make at most $q_{\\mathsf{A}}$ and $q_{\\mathsf{B}}$ quantum queries, respectively, to a Boolean-valued random oracle, and agree on a shared key with certainty. This paper shows that there exists an eavesdropper, given the classical messages, that can recover the shared key with certainty using $O((q_{\\mathsf{A}}+q_{\\mathsf{B}})^5)$ classical oracle queries. The bound is independent of the number of rounds, transcript length, key length, and oracle-domain size. Previous results only applies to two-round key agreement (Li et al. CRYPTO 26) or relies on unproven conjectures (Austrin et al. CRYPTO 22).\n GPT-5.6 Sol Ultra found this proof in a one-shot conversation and drafted a preliminary version of this paper. The authors are fully responsible for the correctness, writing and discussions of this paper."},{"descriptionType":"Other","description":"10 pages"}],"geoLocations":[],"fundingReferences":[],"url":"https://arxiv.org/abs/2608.03824","contentUrl":null,"metadataVersion":0,"schemaVersion":"http://datacite.org/schema/kernel-4","source":"mds","isActive":true,"state":"findable","reason":null,"viewCount":0,"downloadCount":0,"referenceCount":0,"citationCount":0,"partCount":0,"partOfCount":0,"versionCount":0,"versionOfCount":0,"created":"2026-08-05T02:21:50Z","registered":null,"published":null,"updated":"2026-08-05T02:21:50Z"},"relationships":{"client":{"data":{"id":"arxiv.content","type":"clients"}}}},{"id":"10.48550/arxiv.2608.03823","type":"dois","attributes":{"doi":"10.48550/arxiv.2608.03823","identifiers":[{"identifier":"2608.03823","identifierType":"arXiv"}],"creators":[{"nameType":"Personal","givenName":"Antonio","familyName":"Santacesaria","name":"Santacesaria, Antonio","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Cristiano","familyName":"Muzzi","name":"Muzzi, Cristiano","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Maria Eleonora","familyName":"Temperini","name":"Temperini, Maria Eleonora","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Paolo","familyName":"Barone","name":"Barone, Paolo","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Maria N.","familyName":"Gastiasoro","name":"Gastiasoro, Maria N.","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"José","familyName":"Lorenzana","name":"Lorenzana, José","affiliation":[],"nameIdentifiers":[]}],"titles":[{"title":"Two-phonon pairing and superconductivity in $SrTiO_3$"}],"publisher":"arXiv","container":{},"publicationYear":2026,"subjects":[{"subject":"Superconductivity (cond-mat.supr-con)","lang":"en","subjectScheme":"arXiv"},{"subject":"FOS: Physical sciences","subjectScheme":"Fields of Science and Technology (FOS)"}],"contributors":[],"dates":[{"date":"2026-08-04T15:32:30Z","dateType":"Submitted","dateInformation":"v1"},{"date":"2026-08-05T01:01:52Z","dateType":"Updated","dateInformation":"v1"},{"date":"2026-08","dateType":"Available","dateInformation":"v1"}],"language":null,"types":{"schemaOrg":"CreativeWork","resourceTypeGeneral":"Preprint","citeproc":"article","bibtex":"misc","ris":"GEN","resourceType":"Article"},"relatedIdentifiers":[],"relatedItems":[],"sizes":[],"formats":[],"version":"1","rightsList":[{"rightsIdentifierScheme":"SPDX","rightsUri":"https://creativecommons.org/licenses/by/4.0/legalcode","schemeUri":"https://spdx.org/licenses/","rights":"Creative Commons Attribution 4.0 International","rightsIdentifier":"cc-by-4.0"}],"descriptions":[{"descriptionType":"Abstract","description":"We explore the possibility that the two-phonon pairing mechanism proposed by Ngai can explain superconductivity in doped strontium titanate (STO). The two-phonon deformation potential is evaluated using two distinct theoretical estimates based on first-principles calculations and two empirical estimates based on experimental data, yielding very large values of the same order of magnitude. We derive the effective electron-electron interaction mediated by two-phonon exchange. Crucial to our computations is the strong dispersion of the involved soft phonons. Because the scale of the two-phonon interaction is much larger than the Fermi energy, the Migdal theorem does not apply. We obtain a one-loop Eliashberg equation that can be solved in the weak-coupling limit. We find that despite the significant electron-phonon matrix element, phase space considerations considerably reduce the effective coupling. A two-phonon mechanism can not be excluded based on the $T_c$ magnitude, but its value is dominated by the high-energy-frequency physics and is weakly affected by the soft-phonon behavior. The theory predicts a $T_c$ that monotonously increases with doping, which is not in accordance with the experiment. We identify the conditions for a two-phonon mechanism to be effective in other materials and discuss possible candidates."}],"geoLocations":[],"fundingReferences":[],"url":"https://arxiv.org/abs/2608.03823","contentUrl":null,"metadataVersion":0,"schemaVersion":"http://datacite.org/schema/kernel-4","source":"mds","isActive":true,"state":"findable","reason":null,"viewCount":0,"downloadCount":0,"referenceCount":0,"citationCount":0,"partCount":0,"partOfCount":0,"versionCount":0,"versionOfCount":0,"created":"2026-08-05T02:21:48Z","registered":"2026-08-05T02:21:49Z","published":null,"updated":"2026-08-05T02:21:49Z"},"relationships":{"client":{"data":{"id":"arxiv.content","type":"clients"}}}},{"id":"10.48550/arxiv.2608.03822","type":"dois","attributes":{"doi":"10.48550/arxiv.2608.03822","identifiers":[{"identifier":"2608.03822","identifierType":"arXiv"}],"creators":[{"nameType":"Personal","givenName":"Zhang","familyName":"Weihui","name":"Weihui, Zhang","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Wang","familyName":"Ruizhi","name":"Ruizhi, Wang","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Xu","familyName":"Hongye","name":"Hongye, Xu","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Wang","familyName":"Huiqiong","name":"Huiqiong, Wang","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Sun","familyName":"Li","name":"Li, Sun","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Song","familyName":"Mingli","name":"Mingli, Song","affiliation":[],"nameIdentifiers":[]}],"titles":[{"title":"FlowForm: Synergizing Fluid Physics with Topological Consistency for Satellite Flood Synthesis"}],"publisher":"arXiv","container":{},"publicationYear":2026,"subjects":[{"subject":"Computer Vision and Pattern Recognition (cs.CV)","lang":"en","subjectScheme":"arXiv"},{"subject":"Artificial Intelligence (cs.AI)","lang":"en","subjectScheme":"arXiv"},{"subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"}],"contributors":[],"dates":[{"date":"2026-08-04T15:30:35Z","dateType":"Submitted","dateInformation":"v1"},{"date":"2026-08-05T01:01:48Z","dateType":"Updated","dateInformation":"v1"},{"date":"2026-08","dateType":"Available","dateInformation":"v1"}],"language":null,"types":{"schemaOrg":"CreativeWork","resourceTypeGeneral":"Preprint","citeproc":"article","bibtex":"misc","ris":"GEN","resourceType":"Article"},"relatedIdentifiers":[],"relatedItems":[],"sizes":[],"formats":[],"version":"1","rightsList":[{"rightsIdentifierScheme":"SPDX","rightsUri":"https://creativecommons.org/licenses/by/4.0/legalcode","schemeUri":"https://spdx.org/licenses/","rights":"Creative Commons Attribution 4.0 International","rightsIdentifier":"cc-by-4.0"}],"descriptions":[{"descriptionType":"Abstract","description":"Developing robust flood assessment models requires high-quality paired satellite imagery, yet such data remain scarce for flood-specific image generation. Although generative models provide a promising means of data augmentation, existing methods often yield implausible spatial layouts of flooded regions and distort scene structures. We propose FlowForm, a framework for satellite flood synthesis that integrates SWE-inspired latent regularization with structure-aware conditioning. The Flood Descriptor Module (FDM) imposes differentiable penalties on residuals of the steady-state Shallow Water Equation in auxiliary latent fields at the diffusion bottleneck. The Terrain Anchor Adapter (TAA) injects depth, semantic, and edge features at four encoder scales of the U-Net. We further curate FloodScape, a large-scale, high-resolution dataset comprising paired satellite images acquired before and after disasters. In addition to standard image-generation metrics, we evaluate the consistency of flooded regions, zero-shot generalization to a geographically held-out flood event, and sensitivity to individual components. Across all reported comparisons, FlowForm achieves higher visual fidelity, greater similarity between paired images, and stronger consistency of flooded regions."}],"geoLocations":[],"fundingReferences":[],"url":"https://arxiv.org/abs/2608.03822","contentUrl":null,"metadataVersion":0,"schemaVersion":"http://datacite.org/schema/kernel-4","source":"mds","isActive":true,"state":"findable","reason":null,"viewCount":0,"downloadCount":0,"referenceCount":0,"citationCount":0,"partCount":0,"partOfCount":0,"versionCount":0,"versionOfCount":0,"created":"2026-08-05T02:21:47Z","registered":null,"published":null,"updated":"2026-08-05T02:21:48Z"},"relationships":{"client":{"data":{"id":"arxiv.content","type":"clients"}}}},{"id":"10.48550/arxiv.2608.03821","type":"dois","attributes":{"doi":"10.48550/arxiv.2608.03821","identifiers":[{"identifier":"2608.03821","identifierType":"arXiv"}],"creators":[{"nameType":"Personal","givenName":"Domanico","familyName":"Mucci","name":"Mucci, Domanico","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Riccardo","familyName":"Scala","name":"Scala, Riccardo","affiliation":[],"nameIdentifiers":[]}],"titles":[{"title":"Explicit formulas of strict BV relaxed energies for polyconvex functionals with linear growth"}],"publisher":"arXiv","container":{},"publicationYear":2026,"subjects":[{"subject":"Analysis of PDEs (math.AP)","lang":"en","subjectScheme":"arXiv"},{"subject":"FOS: Mathematics","subjectScheme":"Fields of Science and Technology (FOS)"}],"contributors":[],"dates":[{"date":"2026-08-04T15:29:29Z","dateType":"Submitted","dateInformation":"v1"},{"date":"2026-08-05T01:01:47Z","dateType":"Updated","dateInformation":"v1"},{"date":"2026-08","dateType":"Available","dateInformation":"v1"}],"language":null,"types":{"schemaOrg":"CreativeWork","resourceTypeGeneral":"Preprint","citeproc":"article","bibtex":"misc","ris":"GEN","resourceType":"Article"},"relatedIdentifiers":[],"relatedItems":[],"sizes":[],"formats":[],"version":"1","rightsList":[{"rightsIdentifierScheme":"SPDX","rightsUri":"https://creativecommons.org/licenses/by/4.0/legalcode","schemeUri":"https://spdx.org/licenses/","rights":"Creative Commons Attribution 4.0 International","rightsIdentifier":"cc-by-4.0"}],"descriptions":[{"descriptionType":"Abstract","description":"We consider polyconvex functionals defined on vector valued functions, the model case being the graph area functional, and we analyze the relaxed energy with respect to the strict convergence in $BV$. In several cases where the relaxed area is known, by exploiting a continuity result by Reshetnyak we are able to find an explicit formula for wide classes of integrands with linear growth in the minors of the gradient. We preliminarily extend to the $BV$ setting a continuity property observed by Acerbi--Dal Maso in the Sobolev case. Finally, partial results concerning the relaxation of the vortex map with respect to the $L^1$ convergence are obtained."}],"geoLocations":[],"fundingReferences":[],"url":"https://arxiv.org/abs/2608.03821","contentUrl":null,"metadataVersion":0,"schemaVersion":"http://datacite.org/schema/kernel-4","source":"mds","isActive":true,"state":"findable","reason":null,"viewCount":0,"downloadCount":0,"referenceCount":0,"citationCount":0,"partCount":0,"partOfCount":0,"versionCount":0,"versionOfCount":0,"created":"2026-08-05T02:21:46Z","registered":"2026-08-05T02:21:47Z","published":null,"updated":"2026-08-05T02:21:47Z"},"relationships":{"client":{"data":{"id":"arxiv.content","type":"clients"}}}},{"id":"10.48550/arxiv.2608.03820","type":"dois","attributes":{"doi":"10.48550/arxiv.2608.03820","identifiers":[{"identifier":"2608.03820","identifierType":"arXiv"}],"creators":[{"nameType":"Personal","givenName":"Fethiye Irmak","familyName":"Dogan","name":"Dogan, Fethiye Irmak","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Yue","familyName":"Lou","name":"Lou, Yue","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Alva","familyName":"Markelius","name":"Markelius, Alva","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Emma","familyName":"Geijer-Simpson","name":"Geijer-Simpson, Emma","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Gustaf","familyName":"Gredebäck","name":"Gredebäck, Gustaf","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Tamsin Jane","familyName":"Ford","name":"Ford, Tamsin Jane","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Ginevra","familyName":"Castellano","name":"Castellano, Ginevra","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Hatice","familyName":"Gunes","name":"Gunes, Hatice","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Georgina","familyName":"Warner","name":"Warner, Georgina","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Jenny L.","familyName":"Gibson","name":"Gibson, Jenny L.","affiliation":[],"nameIdentifiers":[]}],"titles":[{"title":"Designing Social Robots for Inclusive Child Wellbeing Assessment: Insights from Communities Supporting Developmental Language Disorder and Forced Migration"}],"publisher":"arXiv","container":{},"publicationYear":2026,"subjects":[{"subject":"Robotics (cs.RO)","lang":"en","subjectScheme":"arXiv"},{"subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"}],"contributors":[],"dates":[{"date":"2026-08-04T15:28:41Z","dateType":"Submitted","dateInformation":"v1"},{"date":"2026-08-05T01:01:42Z","dateType":"Updated","dateInformation":"v1"},{"date":"2026-08","dateType":"Available","dateInformation":"v1"}],"language":null,"types":{"schemaOrg":"CreativeWork","resourceTypeGeneral":"Preprint","citeproc":"article","bibtex":"misc","ris":"GEN","resourceType":"Article"},"relatedIdentifiers":[],"relatedItems":[],"sizes":[],"formats":[],"version":"1","rightsList":[{"rightsIdentifierScheme":"SPDX","rightsUri":"https://creativecommons.org/licenses/by/4.0/legalcode","schemeUri":"https://spdx.org/licenses/","rights":"Creative Commons Attribution 4.0 International","rightsIdentifier":"cc-by-4.0"}],"descriptions":[{"descriptionType":"Abstract","description":"Assessing children's wellbeing and mental health can be particularly challenging for children experiencing communication barriers, such as children with Developmental Language Disorder (DLD) and children with forced migration backgrounds. During the assessment process, traditional self-report questionnaires place substantial demands on language comprehension and verbal expression. In this context, social robots have emerged as a promising tool for supporting wellbeing assessment without solely relying on self-report questionnaires, yet limited research has examined how such interactions can be designed to be inclusive, appropriate, and ethically acceptable for children with diverse communication needs. To address this gap, we created candidate child--robot interaction activities as design probes and conducted focus groups with parents and professionals supporting children with DLD and children with forced migration backgrounds. Through thematic analysis, we identified considerations relating to robot role and capabilities, interactional dynamics, individual differences, and child agency, alongside population-specific considerations shaped by children's communication needs and lived experiences. Based on these findings, we derive a set of ethical and inclusive design recommendations for robot-mediated wellbeing assessment. By foregrounding these considerations and recommendations, this work contributes design guidance for inclusive robot-mediated wellbeing assessments for children with diverse communication needs."}],"geoLocations":[],"fundingReferences":[],"url":"https://arxiv.org/abs/2608.03820","contentUrl":null,"metadataVersion":0,"schemaVersion":"http://datacite.org/schema/kernel-4","source":"mds","isActive":true,"state":"findable","reason":null,"viewCount":0,"downloadCount":0,"referenceCount":0,"citationCount":0,"partCount":0,"partOfCount":0,"versionCount":0,"versionOfCount":0,"created":"2026-08-05T02:21:45Z","registered":"2026-08-05T02:21:45Z","published":null,"updated":"2026-08-05T02:21:45Z"},"relationships":{"client":{"data":{"id":"arxiv.content","type":"clients"}}}},{"id":"10.48550/arxiv.2608.03818","type":"dois","attributes":{"doi":"10.48550/arxiv.2608.03818","identifiers":[{"identifier":"2608.03818","identifierType":"arXiv"}],"creators":[{"nameType":"Personal","givenName":"Michal","familyName":"Jablonowski","name":"Jablonowski, Michal","affiliation":[],"nameIdentifiers":[]}],"titles":[{"title":"Fundamental Quandles Do Not Determine the First Postnikov Invariant of 2-Knots"}],"publisher":"arXiv","container":{},"publicationYear":2026,"subjects":[{"subject":"Geometric Topology (math.GT)","lang":"en","subjectScheme":"arXiv"},{"subject":"FOS: Mathematics","subjectScheme":"Fields of Science and Technology (FOS)"},{"subject":"57K45","lang":"en","subjectScheme":"MSC"}],"contributors":[],"dates":[{"date":"2026-08-04T15:26:22Z","dateType":"Submitted","dateInformation":"v1"},{"date":"2026-08-05T01:01:34Z","dateType":"Updated","dateInformation":"v1"},{"date":"2026-08","dateType":"Available","dateInformation":"v1"}],"language":null,"types":{"schemaOrg":"CreativeWork","resourceTypeGeneral":"Preprint","citeproc":"article","bibtex":"misc","ris":"GEN","resourceType":"Article"},"relatedIdentifiers":[],"relatedItems":[],"sizes":[],"formats":[],"version":"1","rightsList":[{"rightsIdentifierScheme":"SPDX","rightsUri":"https://creativecommons.org/licenses/by/4.0/legalcode","schemeUri":"https://spdx.org/licenses/","rights":"Creative Commons Attribution 4.0 International","rightsIdentifier":"cc-by-4.0"}],"descriptions":[{"descriptionType":"Abstract","description":"For every admissible pair of Brieskorn parameters in the Plotnick--Suciu construction, we obtain a pair of oriented $2$-knots whose knot groups are isomorphic, whose second homotopy modules are semilinearly isomorphic under a suitable group isomorphism, and whose fundamental quandles are isomorphic, while no compatible group and module isomorphisms carry one first Postnikov invariant to the other. Consequently, their exteriors are not homotopy equivalent. Thus, the knot group, the second homotopy module up to semilinear equivalence, and the fundamental quandle do not determine the homotopy type of an oriented $2$-knot exterior. Using an alternative construction from Suciu's thesis based on punctured lens spaces, the same peripheral argument yields, for every $N\\geq2$, a family of $N$ oriented $2$-knots with these properties.\n We additionally show that the Tanaka--Taniguchi examples with isomorphic knot groups and distinct fundamental quandles have pairwise inequivalent second homotopy modules: no isomorphism between two of the knot groups makes the corresponding second homotopy modules semilinearly isomorphic."},{"descriptionType":"Other","description":"21 pages"}],"geoLocations":[],"fundingReferences":[],"url":"https://arxiv.org/abs/2608.03818","contentUrl":null,"metadataVersion":0,"schemaVersion":"http://datacite.org/schema/kernel-4","source":"mds","isActive":true,"state":"findable","reason":null,"viewCount":0,"downloadCount":0,"referenceCount":0,"citationCount":0,"partCount":0,"partOfCount":0,"versionCount":0,"versionOfCount":0,"created":"2026-08-05T02:21:42Z","registered":"2026-08-05T02:21:43Z","published":null,"updated":"2026-08-05T02:21:43Z"},"relationships":{"client":{"data":{"id":"arxiv.content","type":"clients"}}}},{"id":"10.48550/arxiv.2608.03817","type":"dois","attributes":{"doi":"10.48550/arxiv.2608.03817","identifiers":[{"identifier":"2608.03817","identifierType":"arXiv"}],"creators":[{"nameType":"Personal","givenName":"Amir Mohammad","familyName":"Ezzati","name":"Ezzati, Amir Mohammad","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Kiyan","familyName":"Rezaee","name":"Rezaee, Kiyan","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Bardiya","familyName":"Kariminia","name":"Kariminia, Bardiya","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Mohamad Amin","familyName":"Yousefi","name":"Yousefi, Mohamad Amin","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Asal Mohammadjafari","familyName":"Mamaqani","name":"Mamaqani, Asal Mohammadjafari","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Behrad","familyName":"Samimi","name":"Samimi, Behrad","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Mohammad Hossein","familyName":"Rohban","name":"Rohban, Mohammad Hossein","affiliation":[],"nameIdentifiers":[]}],"titles":[{"title":"UHP Detection: LVLMs have their Unique Hallucination Pattern in the Consistency Space"}],"publisher":"arXiv","container":{},"publicationYear":2026,"subjects":[{"subject":"Computer Vision and Pattern Recognition (cs.CV)","lang":"en","subjectScheme":"arXiv"},{"subject":"Artificial Intelligence (cs.AI)","lang":"en","subjectScheme":"arXiv"},{"subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"}],"contributors":[],"dates":[{"date":"2026-08-04T15:25:30Z","dateType":"Submitted","dateInformation":"v1"},{"date":"2026-08-05T01:01:31Z","dateType":"Updated","dateInformation":"v1"},{"date":"2026-08","dateType":"Available","dateInformation":"v1"}],"language":null,"types":{"schemaOrg":"CreativeWork","resourceTypeGeneral":"Preprint","citeproc":"article","bibtex":"misc","ris":"GEN","resourceType":"Article"},"relatedIdentifiers":[],"relatedItems":[],"sizes":[],"formats":[],"version":"1","rightsList":[{"rightsIdentifierScheme":"SPDX","rightsUri":"https://creativecommons.org/licenses/by/4.0/legalcode","schemeUri":"https://spdx.org/licenses/","rights":"Creative Commons Attribution 4.0 International","rightsIdentifier":"cc-by-4.0"}],"descriptions":[{"descriptionType":"Abstract","description":"Large vision--language models (LVLMs) demonstrate strong multimodal reasoning capabilities but remain prone to hallucination, where model predictions are not grounded in visual evidence. Existing black-box hallucination detection methods estimate uncertainty through a single consistency metric, implicitly assuming that model uncertainty can be adequately characterized by a single measure. However, hallucinations exhibit diverse manifestations of uncertainty across different behavioral probes, making a single measure insufficient to characterize their underlying behavior. We propose \\emph{Unique Hallucination Pattern (UHP) Detection}, a fully black-box framework that models hallucination as a structured uncertainty pattern defined by two axes: perturbation modality (image vs.\\ text) and logical polarity (a statement vs.\\ its negation). Their intersection produces four complementary consistency groups that capture distinct manifestations of model uncertainty, from which both within-group and between-group features are extracted to train a lightweight classifier. Through comprehensive experiments on AMBER and PhD across three LVLMs, UHP Detection consistently outperforms prior black-box and white-box baselines, with improvements of up to $+18.72\\%$ AUC-ROC and $+20.07\\%$ AUC-PR over the strongest black-box methods. Extensive ablation studies demonstrate that each consistency group contributes complementary information and that their combination forms a structured hallucination pattern. Furthermore, cross-dataset evaluation shows that this learned pattern generalizes across benchmarks, indicating that hallucination behavior reflects a model-specific consistency pattern. \\textbf{Code is publicly available at} https://github.com/amirezzati/uhpdet."},{"descriptionType":"Other","description":"12 pages"}],"geoLocations":[],"fundingReferences":[],"url":"https://arxiv.org/abs/2608.03817","contentUrl":null,"metadataVersion":0,"schemaVersion":"http://datacite.org/schema/kernel-4","source":"mds","isActive":true,"state":"findable","reason":null,"viewCount":0,"downloadCount":0,"referenceCount":0,"citationCount":0,"partCount":0,"partOfCount":0,"versionCount":0,"versionOfCount":0,"created":"2026-08-05T02:21:40Z","registered":"2026-08-05T02:21:41Z","published":null,"updated":"2026-08-05T02:21:41Z"},"relationships":{"client":{"data":{"id":"arxiv.content","type":"clients"}}}},{"id":"10.48550/arxiv.2608.03816","type":"dois","attributes":{"doi":"10.48550/arxiv.2608.03816","identifiers":[{"identifier":"2608.03816","identifierType":"arXiv"}],"creators":[{"nameType":"Personal","givenName":"Deckshitha","familyName":"Angadi","name":"Angadi, Deckshitha","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Koteshwar Goud","familyName":"Surga","name":"Surga, Koteshwar Goud","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Nagaraju","familyName":"Lakkaraju","name":"Lakkaraju, Nagaraju","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Naveena","familyName":"Budda","name":"Budda, Naveena","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Vikas","familyName":"Agarwal","name":"Agarwal, Vikas","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Giridhara Venkata Ram Raj","familyName":"Mulasa","name":"Mulasa, Giridhara Venkata Ram Raj","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Ravi","familyName":"Killamsetty","name":"Killamsetty, Ravi","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Chandrasekhara Sarma","familyName":"Mallubhotla","name":"Mallubhotla, Chandrasekhara Sarma","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Narsimlu","familyName":"Kemsaram","name":"Kemsaram, Narsimlu","affiliation":[],"nameIdentifiers":[]}],"titles":[{"title":"Design and Evaluation of an AI-Enabled Cloud-Edge Architecture for Connected Precision Agriculture Farms"}],"publisher":"arXiv","container":{},"publicationYear":2026,"subjects":[{"subject":"Robotics (cs.RO)","lang":"en","subjectScheme":"arXiv"},{"subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"}],"contributors":[],"dates":[{"date":"2026-08-04T15:25:02Z","dateType":"Submitted","dateInformation":"v1"},{"date":"2026-08-05T01:01:30Z","dateType":"Updated","dateInformation":"v1"},{"date":"2026-08","dateType":"Available","dateInformation":"v1"}],"language":null,"types":{"schemaOrg":"CreativeWork","resourceTypeGeneral":"Preprint","citeproc":"article","bibtex":"misc","ris":"GEN","resourceType":"Article"},"relatedIdentifiers":[],"relatedItems":[],"sizes":[],"formats":[],"version":"1","rightsList":[{"rightsUri":"http://arxiv.org/licenses/nonexclusive-distrib/1.0/","rights":"arXiv.org perpetual, non-exclusive license"}],"descriptions":[{"descriptionType":"Abstract","description":"Plant diseases cause significant yield losses worldwide, with tomato crops particularly susceptible to early blight, late blight, and leaf mold. Manual monitoring is practical only for small-scale farms and becomes unmanageable at larger scales. To tackle this limitation, an artificial intelligence (AI) enabled cloud-edge architecture is proposed for autonomous crop monitoring. This proposed architecture integrates Internet of Things (IoT) sensors, unmanned aerial vehicles (UAVs), deep learning, Azure IoT Hub-based cloud analytics, and multi-platform (mobile app, web app, and embedded edge device platform) interfaces to enable real-time detection of tomato diseases. For training and validation, we used publicly available datasets, such as PlantVillage and Kaggle. A TensorFlow model trained on a collected dataset is deployed across mobile, web, and edge-device platforms. Experimental results show detection effectiveness around 92-95%, with consistent performance over diverse environments and device platforms. The proposed system improves disease detection effectiveness, lowers dependence on manual inspection, and enables prompt interventions, thereby supporting sustainable, connected precision agriculture farms."},{"descriptionType":"Other","description":"Accepted for presentation at the 2026 IEEE International Conference on Sustainable AI for Social Impact and Global Development (SASIGD 2026), Hyderabad, India, 13-14 August 2026"}],"geoLocations":[],"fundingReferences":[],"url":"https://arxiv.org/abs/2608.03816","contentUrl":null,"metadataVersion":0,"schemaVersion":"http://datacite.org/schema/kernel-4","source":"mds","isActive":true,"state":"findable","reason":null,"viewCount":0,"downloadCount":0,"referenceCount":0,"citationCount":0,"partCount":0,"partOfCount":0,"versionCount":0,"versionOfCount":0,"created":"2026-08-05T02:21:39Z","registered":"2026-08-05T02:21:40Z","published":null,"updated":"2026-08-05T02:21:40Z"},"relationships":{"client":{"data":{"id":"arxiv.content","type":"clients"}}}},{"id":"10.48550/arxiv.2608.03814","type":"dois","attributes":{"doi":"10.48550/arxiv.2608.03814","identifiers":[{"identifier":"2608.03814","identifierType":"arXiv"}],"creators":[{"nameType":"Personal","givenName":"Dong Hee","familyName":"Kang","name":"Kang, Dong Hee","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Jaeseung","familyName":"Lim","name":"Lim, Jaeseung","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Mishfaqur","familyName":"Rahman","name":"Rahman, Mishfaqur","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Seongheum","familyName":"Han","name":"Han, Seongheum","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Jae-Hak","familyName":"Lee","name":"Lee, Jae-Hak","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Seungman","familyName":"Kim","name":"Kim, Seungman","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Jihoon","familyName":"Jeong","name":"Jeong, Jihoon","affiliation":[],"nameIdentifiers":[]}],"titles":[{"title":"Self-Focusing Control for Depth-Precise Wafer Slicing of 4H-SiC in Femtosecond Laser Processing"}],"publisher":"arXiv","container":{},"publicationYear":2026,"subjects":[{"subject":"Optics (physics.optics)","lang":"en","subjectScheme":"arXiv"},{"subject":"Materials Science (cond-mat.mtrl-sci)","lang":"en","subjectScheme":"arXiv"},{"subject":"Applied Physics (physics.app-ph)","lang":"en","subjectScheme":"arXiv"},{"subject":"FOS: Physical sciences","subjectScheme":"Fields of Science and Technology (FOS)"}],"contributors":[],"dates":[{"date":"2026-08-04T15:24:12Z","dateType":"Submitted","dateInformation":"v1"},{"date":"2026-08-05T01:01:25Z","dateType":"Updated","dateInformation":"v1"},{"date":"2026-08","dateType":"Available","dateInformation":"v1"}],"language":null,"types":{"schemaOrg":"CreativeWork","resourceTypeGeneral":"Preprint","citeproc":"article","bibtex":"misc","ris":"GEN","resourceType":"Article"},"relatedIdentifiers":[],"relatedItems":[],"sizes":[],"formats":[],"version":"1","rightsList":[{"rightsUri":"http://arxiv.org/licenses/nonexclusive-distrib/1.0/","rights":"arXiv.org perpetual, non-exclusive license"}],"descriptions":[{"descriptionType":"Abstract","description":"4H-SiC has emerged as a third-generation chip material because its superior thermal conductivity and high breakdown field enable the material to achieve high power density and higher switching frequencies in power-electronics applications. As chip architectures evolve toward 3D and heterogeneous integration, the mechanical and thermal design space tightens while yield risks grow. In particular, advanced packages require mid-process wafer thinning to \u0026lt; 100 $μ$m to shorten interconnects and control thermo-mechanical stress. Femtosecond laser slicing for 4H-SiC wafers offers a non-contact processing approach to produce thin layers with low defects, while strong optical nonlinearities obscure the relationship between the laser parameters and the resulting slicing quality. Here, we systematically investigate Kerr-induced self-focusing using a femtosecond laser in 4H-SiC slicing by combining experiments, a semi-empirical analytical model, and numerical ray optics simulations. We demonstrate that the interplay between pulse energy and processing depth governs the self-focusing behavior, which directly correlates with post-separation surface texture parameters and separation stress, thereby linking nonlinear beam propagation to slicing quality. Based on this relationship, we define a processability map in the pulse energy with self-focusing depth space over a normalized irradiance background. Analytically, the model extends the Marburger formula to focused beams by replacing the power ratio with a normalized irradiance. Ray optics simulations capture the geometric features at the self-focusing point and are validated against experimental observations. Within physically defined thresholds, the processability map directly connects laser parameters to separation stress and surface texture metrics, providing practical guidance for depth control beyond trial-and-error."}],"geoLocations":[],"fundingReferences":[],"url":"https://arxiv.org/abs/2608.03814","contentUrl":null,"metadataVersion":0,"schemaVersion":"http://datacite.org/schema/kernel-4","source":"mds","isActive":true,"state":"findable","reason":null,"viewCount":0,"downloadCount":0,"referenceCount":0,"citationCount":0,"partCount":0,"partOfCount":0,"versionCount":0,"versionOfCount":0,"created":"2026-08-05T02:21:36Z","registered":"2026-08-05T02:21:37Z","published":null,"updated":"2026-08-05T02:21:37Z"},"relationships":{"client":{"data":{"id":"arxiv.content","type":"clients"}}}},{"id":"10.48550/arxiv.2608.03812","type":"dois","attributes":{"doi":"10.48550/arxiv.2608.03812","identifiers":[{"identifier":"2608.03812","identifierType":"arXiv"}],"creators":[{"nameType":"Personal","givenName":"Wanshun","familyName":"Su","name":"Su, Wanshun","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Yang","familyName":"Shi","name":"Shi, Yang","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Feihu","familyName":"Liu","name":"Liu, Feihu","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Ziwen","familyName":"Yu","name":"Yu, Ziwen","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Yan","familyName":"Min","name":"Min, Yan","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Zhuoran","familyName":"Zhang","name":"Zhang, Zhuoran","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Qixun","familyName":"Wang","name":"Wang, Qixun","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Haotian","familyName":"Wang","name":"Wang, Haotian","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Shixuan","familyName":"Liu","name":"Liu, Shixuan","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Yuanxing","familyName":"Zhang","name":"Zhang, Yuanxing","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Peng","familyName":"Wu","name":"Wu, Peng","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Chengfu","familyName":"Huo","name":"Huo, Chengfu","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Liang","familyName":"Ding","name":"Ding, Liang","affiliation":[],"nameIdentifiers":[]}],"titles":[{"title":"OmniPack: Unified Token Compression for Efficient Omni-modal Large Language Models"}],"publisher":"arXiv","container":{},"publicationYear":2026,"subjects":[{"subject":"Computer Vision and Pattern Recognition (cs.CV)","lang":"en","subjectScheme":"arXiv"},{"subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"}],"contributors":[],"dates":[{"date":"2026-08-04T15:23:42Z","dateType":"Submitted","dateInformation":"v1"},{"date":"2026-08-05T01:01:24Z","dateType":"Updated","dateInformation":"v1"},{"date":"2026-08","dateType":"Available","dateInformation":"v1"}],"language":null,"types":{"schemaOrg":"CreativeWork","resourceTypeGeneral":"Preprint","citeproc":"article","bibtex":"misc","ris":"GEN","resourceType":"Article"},"relatedIdentifiers":[],"relatedItems":[],"sizes":[],"formats":[],"version":"1","rightsList":[{"rightsIdentifierScheme":"SPDX","rightsUri":"https://creativecommons.org/licenses/by/4.0/legalcode","schemeUri":"https://spdx.org/licenses/","rights":"Creative Commons Attribution 4.0 International","rightsIdentifier":"cc-by-4.0"}],"descriptions":[{"descriptionType":"Abstract","description":"Omni-modal large language models (Omni-LLMs) have achieved remarkable performance on audio-visual understanding tasks, but processing long and highly redundant visual and audio token sequences incurs substantial computational overhead, demanding aggressive token compression for efficient deployment. Existing methods often degrade at low token budgets: pre-LLM compression may discard structurally important and globally distributed evidence, whereas inner-LLM compression often underexploits query-conditioned audio-visual collaboration. To address these limitations, we propose OmniPack, a training-free framework that coordinates structural compression before the LLM with task-relevant semantic refinement within the LLM. Before the LLM, OmniPack removes structural redundancy through modality-specific importance, global coverage, and similarity-aware merging. After sufficient multimodal interaction, it further consolidates diverse, task-relevant representations through textual guidance and audio-visual collaboration. Extensive experiments on five benchmarks with three Omni-LLM backbones demonstrate that OmniPack consistently achieves the best performance-efficiency trade-off across diverse retention ratios, outperforming all existing methods. Notably, on Qwen2.5-Omni-7B, OmniPack preserves 98.0% of the original performance while reducing FLOPs to 16.7%, and still retains 92.9% of the original performance with only 6.8% of the original FLOPs."},{"descriptionType":"Other","description":"16 pages, 5 figures, 15 tables"}],"geoLocations":[],"fundingReferences":[],"url":"https://arxiv.org/abs/2608.03812","contentUrl":null,"metadataVersion":0,"schemaVersion":"http://datacite.org/schema/kernel-4","source":"mds","isActive":true,"state":"findable","reason":null,"viewCount":0,"downloadCount":0,"referenceCount":0,"citationCount":0,"partCount":0,"partOfCount":0,"versionCount":0,"versionOfCount":0,"created":"2026-08-05T02:21:34Z","registered":"2026-08-05T02:21:34Z","published":null,"updated":"2026-08-05T02:21:34Z"},"relationships":{"client":{"data":{"id":"arxiv.content","type":"clients"}}}},{"id":"10.48550/arxiv.2608.03811","type":"dois","attributes":{"doi":"10.48550/arxiv.2608.03811","identifiers":[{"identifier":"2608.03811","identifierType":"arXiv"}],"creators":[{"nameType":"Personal","givenName":"Carson J.","familyName":"Cook","name":"Cook, Carson J.","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Ahmed J.","familyName":"Zerouali","name":"Zerouali, Ahmed J.","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Anthony","familyName":"Schmidt","name":"Schmidt, Anthony","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Reginald","familyName":"Ziedzor","name":"Ziedzor, Reginald","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Paul","familyName":"Lin","name":"Lin, Paul","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Luke G.","familyName":"Eglington","name":"Eglington, Luke G.","affiliation":[],"nameIdentifiers":[]}],"titles":[{"title":"UNVaMP: Neural Knowledge Tracing with Variational Regularization of Latent Knowledge Dynamics"}],"publisher":"arXiv","container":{},"publicationYear":2026,"subjects":[{"subject":"Machine Learning (cs.LG)","lang":"en","subjectScheme":"arXiv"},{"subject":"Computers and Society (cs.CY)","lang":"en","subjectScheme":"arXiv"},{"subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"}],"contributors":[],"dates":[{"date":"2026-08-04T15:22:37Z","dateType":"Submitted","dateInformation":"v1"},{"date":"2026-08-05T01:01:23Z","dateType":"Updated","dateInformation":"v1"},{"date":"2026-08","dateType":"Available","dateInformation":"v1"}],"language":null,"types":{"schemaOrg":"CreativeWork","resourceTypeGeneral":"Preprint","citeproc":"article","bibtex":"misc","ris":"GEN","resourceType":"Article"},"relatedIdentifiers":[{"relationType":"IsVersionOf","relatedIdentifier":"10.5281/zenodo.21040074","relatedIdentifierType":"DOI"}],"relatedItems":[],"sizes":[],"formats":[],"version":"1","rightsList":[{"rightsIdentifierScheme":"SPDX","rightsUri":"https://creativecommons.org/licenses/by-nc-nd/4.0/legalcode","schemeUri":"https://spdx.org/licenses/","rights":"Creative Commons Attribution Non Commercial No Derivatives 4.0 International","rightsIdentifier":"cc-by-nc-nd-4.0"}],"descriptions":[{"descriptionType":"Abstract","description":"We introduce the Unified Neural Variational Measurement of Proficiency (UNVaMP) architecture, a knowledge tracing method that integrates observed student-item interactions with internal memory to produce evolving latent representations of student knowledge. These representations support accurate predictions of future responses while enabling explicit control over the smoothness of estimated learning trajectories. UNVaMP can be configured as either a purely neural model or a hybrid model that predicts responses through an interpretable measurement function over the latent space. We show that a pure neural configuration (UNVaMP-MLP) achieves the strongest predictive performance among compared models on three out of four datasets. Meanwhile, a hybrid configuration (UNVaMP-MIRT, using a 1PL MIRT measurement function) lags only slightly behind UNVaMP-MLP, indicating that the predictive cost of interpretability is modest.\n Beyond predictive accuracy, UNVaMP provides the following: a principled mechanism for controlling volatility when estimating student latent variables, quantification of uncertainty over student knowledge state estimates, and flexible input specification that supports heterogeneous student-item interaction features. In addition, the hybrid UNVaMP-MIRT configuration generates interpretable moment-in-time student knowledge state estimates. Using an experimental dataset, we show that auxiliary inputs induce structured changes in the predictive behavior of UNVaMP-MIRT, consistent with sensitivity to underlying structure beyond response correctness. Furthermore, through a simulation study, we show that UNVaMP yields well-behaved knowledge state estimates under controlled measurement conditions. In total, these results indicate that UNVaMP is both useful for real-world education systems and capable of recovering underlying structure from student-item interactions."},{"descriptionType":"Other","description":"12 pages, 4 figures, Proceedings of the 19th International Conference on Educational Data Mining , Seoul, Republic of Korea, June-2026"}],"geoLocations":[],"fundingReferences":[],"url":"https://arxiv.org/abs/2608.03811","contentUrl":null,"metadataVersion":0,"schemaVersion":"http://datacite.org/schema/kernel-4","source":"mds","isActive":true,"state":"findable","reason":null,"viewCount":0,"downloadCount":0,"referenceCount":0,"citationCount":0,"partCount":0,"partOfCount":0,"versionCount":0,"versionOfCount":1,"created":"2026-08-05T02:21:32Z","registered":"2026-08-05T02:21:33Z","published":null,"updated":"2026-08-05T02:21:33Z"},"relationships":{"client":{"data":{"id":"arxiv.content","type":"clients"}}}},{"id":"10.48550/arxiv.2608.03810","type":"dois","attributes":{"doi":"10.48550/arxiv.2608.03810","identifiers":[{"identifier":"2608.03810","identifierType":"arXiv"}],"creators":[{"nameType":"Personal","givenName":"Andrei","familyName":"Chetvergov","name":"Chetvergov, Andrei","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Alexander","familyName":"Evseev","name":"Evseev, Alexander","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Timofei","familyName":"Sivoraksha","name":"Sivoraksha, Timofei","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Stepan","familyName":"Ukolov","name":"Ukolov, Stepan","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Mikhail","familyName":"Solovev","name":"Solovev, Mikhail","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Danil","familyName":"Sazanakov","name":"Sazanakov, Danil","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Sergey","familyName":"Bolovtsov","name":"Bolovtsov, Sergey","affiliation":[],"nameIdentifiers":[]}],"titles":[{"title":"VIBE: A VAD-Informed Benchmark for Entity-Centered Affective Profiling of Large Language Model Outputs"}],"publisher":"arXiv","container":{},"publicationYear":2026,"subjects":[{"subject":"Computation and Language (cs.CL)","lang":"en","subjectScheme":"arXiv"},{"subject":"Artificial Intelligence (cs.AI)","lang":"en","subjectScheme":"arXiv"},{"subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"}],"contributors":[],"dates":[{"date":"2026-08-04T15:22:23Z","dateType":"Submitted","dateInformation":"v1"},{"date":"2026-08-05T01:01:21Z","dateType":"Updated","dateInformation":"v1"},{"date":"2026-08","dateType":"Available","dateInformation":"v1"}],"language":null,"types":{"schemaOrg":"CreativeWork","resourceTypeGeneral":"Preprint","citeproc":"article","bibtex":"misc","ris":"GEN","resourceType":"Article"},"relatedIdentifiers":[],"relatedItems":[],"sizes":[],"formats":[],"version":"1","rightsList":[{"rightsUri":"http://arxiv.org/licenses/nonexclusive-distrib/1.0/","rights":"arXiv.org perpetual, non-exclusive license"}],"descriptions":[{"descriptionType":"Abstract","description":"Large language models routinely describe socially salient targets, including political figures, countries, religions, organizations, historical events, and social groups, encoding affective framing alongside factual content: a target may appear favorable or threatening, calm or conflictual, powerful or vulnerable. Existing work captures parts of this space through sentiment, favorability, and emotion benchmarks, but none combines target-directed VAD attribution, an explicit scorer contract, and a passport reporting format. We introduce VIBE, a benchmark for entity-centered affective profiling of LLM outputs in Valence-Arousal-Dominance (VAD) space. Its core contribution is a measurement contract: VIBE separates generation from external scoring, distinguishes scalar favorability, response-level VAD, and target-directed VAD, and reports profiles through an Affective Passport. Three empirical layers support the contract. H1 shows scalar favorability does not subsume arousal and dominance: valence findings are cross-validated (rV = 0.944 judge-human, rV = 0.954 inter-scorer); arousal and dominance are single-scorer directional estimates, not point-precise, consistent with known inter-annotator difficulty on these axes (rA = 0.495, rD = 0.702 among human annotators). H2 shows whole-response and target-directed VAD are different contracts: the same text can carry one affective tone overall while representing the named target differently. H3 is a protocol-drift diagnostic: elicitation conditions shift profiles, motivating context metadata in every affective report. These results motivate entity-centered affective profiling as a documented practice: profiles should be released with scorer identity, coverage, protocol, and interpretation limits."},{"descriptionType":"Other","description":"25 pages, 13 figures, 22 tables. Submitted to ACL Rolling Review, August 2026"}],"geoLocations":[],"fundingReferences":[],"url":"https://arxiv.org/abs/2608.03810","contentUrl":null,"metadataVersion":0,"schemaVersion":"http://datacite.org/schema/kernel-4","source":"mds","isActive":true,"state":"findable","reason":null,"viewCount":0,"downloadCount":0,"referenceCount":0,"citationCount":0,"partCount":0,"partOfCount":0,"versionCount":0,"versionOfCount":0,"created":"2026-08-05T02:21:31Z","registered":"2026-08-05T02:21:32Z","published":null,"updated":"2026-08-05T02:21:32Z"},"relationships":{"client":{"data":{"id":"arxiv.content","type":"clients"}}}},{"id":"10.48550/arxiv.2608.03809","type":"dois","attributes":{"doi":"10.48550/arxiv.2608.03809","identifiers":[{"identifier":"2608.03809","identifierType":"arXiv"}],"creators":[{"nameType":"Personal","givenName":"Xiao","familyName":"Xue","name":"Xue, Xiao","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Jurgen","familyName":"Dijkema","name":"Dijkema, Jurgen","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Tobias","familyName":"Bonsen","name":"Bonsen, Tobias","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Patrick","familyName":"Harvey-Collard","name":"Harvey-Collard, Patrick","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Maximilian","familyName":"Rimbach-Russ","name":"Rimbach-Russ, Maximilian","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Sander L.","familyName":"de Snoo","name":"de Snoo, Sander L.","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Guoji","familyName":"Zheng","name":"Zheng, Guoji","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Amir","familyName":"Sammak","name":"Sammak, Amir","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Giordano","familyName":"Scappucci","name":"Scappucci, Giordano","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Lieven M. K.","familyName":"Vandersypen","name":"Vandersypen, Lieven M. K.","affiliation":[],"nameIdentifiers":[]}],"titles":[{"title":"Controllable interaction between photons and distant spins via vacuum Rabi oscillations"}],"publisher":"arXiv","container":{},"publicationYear":2026,"subjects":[{"subject":"Mesoscale and Nanoscale Physics (cond-mat.mes-hall)","lang":"en","subjectScheme":"arXiv"},{"subject":"Quantum Physics (quant-ph)","lang":"en","subjectScheme":"arXiv"},{"subject":"FOS: Physical sciences","subjectScheme":"Fields of Science and Technology (FOS)"}],"contributors":[],"dates":[{"date":"2026-08-04T15:22:09Z","dateType":"Submitted","dateInformation":"v1"},{"date":"2026-08-05T01:01:18Z","dateType":"Updated","dateInformation":"v1"},{"date":"2026-08","dateType":"Available","dateInformation":"v1"}],"language":null,"types":{"schemaOrg":"CreativeWork","resourceTypeGeneral":"Preprint","citeproc":"article","bibtex":"misc","ris":"GEN","resourceType":"Article"},"relatedIdentifiers":[],"relatedItems":[],"sizes":[],"formats":[],"version":"1","rightsList":[{"rightsIdentifierScheme":"SPDX","rightsUri":"https://creativecommons.org/licenses/by/4.0/legalcode","schemeUri":"https://spdx.org/licenses/","rights":"Creative Commons Attribution 4.0 International","rightsIdentifier":"cc-by-4.0"}],"descriptions":[{"descriptionType":"Abstract","description":"Vacuum Rabi oscillations between a single photon and a single spin demonstrate the capability of harnessing light-matter interaction at the level of a single quantum of energy. Since the observation of strong spin-photon coupling in gate-defined quantum dots, probing this interaction in the time-domain has been a major objective. Here, we carefully engineer a device composed of two spatially separated double quantum dots hosting single electron spin qubits and a superconducting cavity to accommodate microwave photons. We observe multiple vacuum Rabi oscillations between each spin qubit and the cavity. By concatenating vacuum Rabi oscillations involving the two spins, an energy excitation in one qubit can be emitted as a photon and then transferred to the other qubit. When a single photon is emitted, the cavity is prepared in a Fock state, leading to an accelerated vacuum Rabi frequency. These results serve as building blocks not only in exploring light-matter interactions, but also in interfacing semiconductor spin qubits to photonic links."}],"geoLocations":[],"fundingReferences":[],"url":"https://arxiv.org/abs/2608.03809","contentUrl":null,"metadataVersion":0,"schemaVersion":"http://datacite.org/schema/kernel-4","source":"mds","isActive":true,"state":"findable","reason":null,"viewCount":0,"downloadCount":0,"referenceCount":2,"citationCount":0,"partCount":0,"partOfCount":0,"versionCount":0,"versionOfCount":0,"created":"2026-08-05T02:21:30Z","registered":"2026-08-05T02:21:30Z","published":null,"updated":"2026-08-05T02:21:30Z"},"relationships":{"client":{"data":{"id":"arxiv.content","type":"clients"}}}},{"id":"10.48550/arxiv.2608.03807","type":"dois","attributes":{"doi":"10.48550/arxiv.2608.03807","identifiers":[{"identifier":"2608.03807","identifierType":"arXiv"}],"creators":[{"nameType":"Personal","givenName":"Ryan J.","familyName":"Campbell","name":"Campbell, Ryan J.","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Carlos Quintero","familyName":"Noda","name":"Noda, Carlos Quintero","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Mihalis","familyName":"Mathioudakis","name":"Mathioudakis, Mihalis","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Manuel","familyName":"Collados","name":"Collados, Manuel","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Jack","familyName":"McFall","name":"McFall, Jack","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"David B.","familyName":"Jess","name":"Jess, David B.","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Sami K.","familyName":"Solanki","name":"Solanki, Sami K.","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Andreas","familyName":"Lagg","name":"Lagg, Andreas","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Achim","familyName":"Gandorfer","name":"Gandorfer, Achim","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Jose Carlos del Toro","familyName":"Iniesta","name":"Iniesta, Jose Carlos del Toro","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Yukio","familyName":"Katsukawa","name":"Katsukawa, Yukio","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Pietro","familyName":"Bernasconi","name":"Bernasconi, Pietro","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Thomas","familyName":"Berkefeld","name":"Berkefeld, Thomas","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Alex","familyName":"Feller","name":"Feller, Alex","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Tino L.","familyName":"Riethmüller","name":"Riethmüller, Tino L.","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Alberto","familyName":"Álvarez-Herrero","name":"Álvarez-Herrero, Alberto","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Masahito","familyName":"Kubo","name":"Kubo, Masahito","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"H. N.","familyName":"Smitha","name":"Smitha, H. N.","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"David Orozco","familyName":"Suárez","name":"Suárez, David Orozco","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Bianca","familyName":"Grauf","name":"Grauf, Bianca","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Michael","familyName":"Carpenter","name":"Carpenter, Michael","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Alexander","familyName":"Bell","name":"Bell, Alexander","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Valentín Martínez","familyName":"Pillet","name":"Pillet, Valentín Martínez","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Francisco Javier","familyName":"Bailén","name":"Bailén, Francisco Javier","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Julian Blanco","familyName":"Rodríguez","name":"Rodríguez, Julian Blanco","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Juan Sebastián Castellanos","familyName":"Durán","name":"Durán, Juan Sebastián Castellanos","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Edvarda","familyName":"Harnes","name":"Harnes, Edvarda","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Johannes","familyName":"Hölken","name":"Hölken, Johannes","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Francisco A.","familyName":"Iglesias","name":"Iglesias, Francisco A.","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Ryohtaroh T.","familyName":"Ishikawa","name":"Ishikawa, Ryohtaroh T.","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Yusuke","familyName":"Kawabata","name":"Kawabata, Yusuke","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Takuma","familyName":"Matsumoto","name":"Matsumoto, Takuma","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Takayoshi","familyName":"Oba","name":"Oba, Takayoshi","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Azaymi L.","familyName":"Siu-Tapia","name":"Siu-Tapia, Azaymi L.","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Hanna","familyName":"Strecker","name":"Strecker, Hanna","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Dušan","familyName":"Vukadinović","name":"Vukadinović, Dušan","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Hirohisa","familyName":"Hara","name":"Hara, Hirohisa","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Toshifumi","familyName":"Shimizu","name":"Shimizu, Toshifumi","affiliation":[],"nameIdentifiers":[]}],"titles":[{"title":"Expanding magnetic canopy structure and parasitic polarities in a quiet-Sun network element observed by Sunrise III/SCIP"}],"publisher":"arXiv","container":{},"publicationYear":2026,"subjects":[{"subject":"Solar and Stellar Astrophysics (astro-ph.SR)","lang":"en","subjectScheme":"arXiv"},{"subject":"FOS: Physical sciences","subjectScheme":"Fields of Science and Technology (FOS)"}],"contributors":[],"dates":[{"date":"2026-08-04T15:18:48Z","dateType":"Submitted","dateInformation":"v1"},{"date":"2026-08-05T01:01:05Z","dateType":"Updated","dateInformation":"v1"},{"date":"2026-08","dateType":"Available","dateInformation":"v1"}],"language":null,"types":{"schemaOrg":"CreativeWork","resourceTypeGeneral":"Preprint","citeproc":"article","bibtex":"misc","ris":"GEN","resourceType":"Article"},"relatedIdentifiers":[],"relatedItems":[],"sizes":[],"formats":[],"version":"1","rightsList":[{"rightsIdentifierScheme":"SPDX","rightsUri":"https://creativecommons.org/licenses/by/4.0/legalcode","schemeUri":"https://spdx.org/licenses/","rights":"Creative Commons Attribution 4.0 International","rightsIdentifier":"cc-by-4.0"}],"descriptions":[{"descriptionType":"Abstract","description":"We present high-resolution multi-line spectropolarimetric observations of a quiet-Sun network element obtained with the {\\sc Sunrise~iii} Chromospheric Infrared SpectroPolarimeter. The observations combine photospheric, upper-photospheric, and chromospheric diagnostics at a spatial resolution and polarimetric sensitivity that allow the transverse magnetic structure of the network boundary to be examined directly. We find that the strongest linear polarisation is concentrated in a narrow ridge around the edge of the magnetic element, co-spatial with enhanced transverse magnetic field inferred from multiline inversions. The magnetic azimuth exhibits a coherent, predominantly radial organisation around a more vertical core, consistent with an expanding magnetic canopy. An azimuth proxy derived directly from the observed Fe~\\textsc{i} and K~\\textsc{i} linear polarisation reproduces the same large-scale organisation, showing that this structure is encoded in the Stokes profiles rather than imposed by the inversion. Response functions and a MURaM-based forward-synthesis test indicate that the Fe~\\textsc{i}~8468~Å linear polarisation is sensitive to magnetic azimuth in the upper photosphere, with the closest proxy agreement occurring near $\\logτ\\approx-3$. We find no evidence for strong azimuthal shear between the Fe- and K-sensitive diagnostics. At the network boundary, we also identify localised parasitic-polarity patches associated with complex, multi-lobed Stokes $V$ profiles, and one case in which the Stokes $V$ polarity reverses between photospheric Fe~\\textsc{i} and chromospheric Ca~\\textsc{ii} lines. These results demonstrate that quiet-Sun network boundaries contain organised upper-photospheric canopy fields together with small-scale mixed-polarity structure, providing new constraints on the three-dimensional magnetic structure of network elements."},{"descriptionType":"Other","description":"Accepted for publication in ApJL"}],"geoLocations":[],"fundingReferences":[],"url":"https://arxiv.org/abs/2608.03807","contentUrl":null,"metadataVersion":0,"schemaVersion":"http://datacite.org/schema/kernel-4","source":"mds","isActive":true,"state":"findable","reason":null,"viewCount":0,"downloadCount":0,"referenceCount":0,"citationCount":0,"partCount":0,"partOfCount":0,"versionCount":0,"versionOfCount":0,"created":"2026-08-05T02:21:27Z","registered":"2026-08-05T02:21:27Z","published":null,"updated":"2026-08-05T02:21:27Z"},"relationships":{"client":{"data":{"id":"arxiv.content","type":"clients"}}}},{"id":"10.48550/arxiv.2608.03805","type":"dois","attributes":{"doi":"10.48550/arxiv.2608.03805","identifiers":[{"identifier":"2608.03805","identifierType":"arXiv"}],"creators":[{"nameType":"Personal","givenName":"Blaise Awola","familyName":"Ayirizia","name":"Ayirizia, Blaise Awola","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Bimal K","familyName":"C","name":"C, Bimal K","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Jorge A. Munoz San","familyName":"Martin","name":"Martin, Jorge A. Munoz San","affiliation":[],"nameIdentifiers":[]}],"titles":[{"title":"Physics-Informed Machine Learning for Refractory Alloy Design"}],"publisher":"arXiv","container":{},"publicationYear":2026,"subjects":[{"subject":"Materials Science (cond-mat.mtrl-sci)","lang":"en","subjectScheme":"arXiv"},{"subject":"FOS: Physical sciences","subjectScheme":"Fields of Science and Technology (FOS)"}],"contributors":[],"dates":[{"date":"2026-08-04T15:17:43Z","dateType":"Submitted","dateInformation":"v1"},{"date":"2026-08-05T01:00:56Z","dateType":"Updated","dateInformation":"v1"},{"date":"2026-08","dateType":"Available","dateInformation":"v1"}],"language":null,"types":{"schemaOrg":"CreativeWork","resourceTypeGeneral":"Preprint","citeproc":"article","bibtex":"misc","ris":"GEN","resourceType":"Article"},"relatedIdentifiers":[],"relatedItems":[],"sizes":[],"formats":[],"version":"1","rightsList":[{"rightsUri":"http://arxiv.org/licenses/nonexclusive-distrib/1.0/","rights":"arXiv.org perpetual, non-exclusive license"}],"descriptions":[{"descriptionType":"Abstract","description":"Refractory complex concentrated alloys (CCAs) exhibit exceptional mechanical properties at elevated temperatures, but their vast compositional space (approximately 10^15 possible combinations) poses significant challenges for experimental exploration. We develop a physics-informed machine learning framework combining quantile gradient boosting with Born stability constraints to predict eight mechanical properties (bulk modulus B, shear modulus G, Vickers hardness Hv, elastic constants C11, C12, C44, Young's modulus E, and Poisson's ratio nu) of refractory CCAs. Using 393 density functional theory (DFT)-computed alloys from a 10-element design space (Cr, Hf, Mo, Nb, Re, Ta, Ti, V, W, Zr), we achieve coefficient of determination (R^2) values of 0.89 to 0.97 with mean absolute errors of 0.85 to 14.74 GPa across six properties on a held-out test set (n = 59). Remarkably, all test predictions satisfy the Born stability criteria (100% compliance), demonstrating the efficacy of physics-informed constraints. Compositional screening in valence electron concentration (VEC)-atomic size mismatch (delta) space identifies high-performance candidates, with MoReW exhibiting the highest predicted shear rigidity (C44 = 139 GPa). Elemental analysis reveals that rhenium appears in 100% of the top-performing alloys, molybdenum in 90%, and chromium in 80%, establishing quantitative design rules: VEC = 6.0 to 6.4, delta \u0026lt; 10%, and Re-Mo-Cr ternary systems maximize shear resistance. This physics-informed screening framework enables accelerated discovery of mechanically stable, high-performance refractory alloys from the trillion-scale compositional space."},{"descriptionType":"Other","description":"27 Pages, 4 figures"}],"geoLocations":[],"fundingReferences":[],"url":"https://arxiv.org/abs/2608.03805","contentUrl":null,"metadataVersion":0,"schemaVersion":"http://datacite.org/schema/kernel-4","source":"mds","isActive":true,"state":"findable","reason":null,"viewCount":0,"downloadCount":0,"referenceCount":0,"citationCount":0,"partCount":0,"partOfCount":0,"versionCount":0,"versionOfCount":0,"created":"2026-08-05T02:21:24Z","registered":null,"published":null,"updated":"2026-08-05T02:21:24Z"},"relationships":{"client":{"data":{"id":"arxiv.content","type":"clients"}}}},{"id":"10.48550/arxiv.2608.03803","type":"dois","attributes":{"doi":"10.48550/arxiv.2608.03803","identifiers":[{"identifier":"2608.03803","identifierType":"arXiv"}],"creators":[{"nameType":"Personal","givenName":"Tomáš","familyName":"Burkert","name":"Burkert, Tomáš","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Angelika","familyName":"Peljak-Łapińska","name":"Peljak-Łapińska, Angelika","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"David","familyName":"Zelený","name":"Zelený, David","affiliation":[],"nameIdentifiers":[]}],"titles":[{"title":"M-GATE: Multilingual Grammar, Accuracy in Translation, and Efficiency Benchmark for Large Language Models"}],"publisher":"arXiv","container":{},"publicationYear":2026,"subjects":[{"subject":"Computation and Language (cs.CL)","lang":"en","subjectScheme":"arXiv"},{"subject":"Machine Learning (cs.LG)","lang":"en","subjectScheme":"arXiv"},{"subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"}],"contributors":[],"dates":[{"date":"2026-08-04T15:16:05Z","dateType":"Submitted","dateInformation":"v1"},{"date":"2026-08-05T01:00:51Z","dateType":"Updated","dateInformation":"v1"},{"date":"2026-08","dateType":"Available","dateInformation":"v1"}],"language":null,"types":{"schemaOrg":"CreativeWork","resourceTypeGeneral":"Preprint","citeproc":"article","bibtex":"misc","ris":"GEN","resourceType":"Article"},"relatedIdentifiers":[],"relatedItems":[],"sizes":[],"formats":[],"version":"1","rightsList":[{"rightsUri":"http://arxiv.org/licenses/nonexclusive-distrib/1.0/","rights":"arXiv.org perpetual, non-exclusive license"}],"descriptions":[{"descriptionType":"Abstract","description":"Multilingual language models are deployed across a hundred or more languages, yet most benchmarks test whether a model can perform a task _in_ a language rather than whether it commands the language itself, conflating fluency with proficiency. We introduce M-GATE (Multilingual Grammar, Accuracy in Translation, and Efficiency), a benchmark of linguistic proficiency spanning 30 typologically diverse languages from high- to low-resource. M-GATE comprises three tasks: grammatical error detection on linguist-crafted, adversarially selected sentences that turn on hard, language-specific phenomena; round-trip translation of shared English sources across 29 target languages, scored by a three-provider LLM judge panel validated against professional annotators; and a supplementary tokenizer-efficiency measure. We evaluate over 50 models in more than 80 configurations. Fluency and proficiency come apart sharply: models that translate competently sit near chance on the adversarial grammar items, the best reaching a Matthews correlation coefficient (MCC) of only 0.36, and their errors lean systematically toward under-flagging, accepting ungrammatical text rather than raising false alarms. Translation quality closely tracks a language's share of pretraining data (r = 0.86 against log Common Crawl share), producing a steep low-resource penalty that is nonetheless narrowing with successive model releases. Enabling reasoning reliably improves translation, while its effect on error detection is smaller and for some models negative, so the best configuration is task-dependent. To resist contamination, test items are kept private behind a continuously updated public leaderboard, with illustrative examples released (https://m-gate.ai)."},{"descriptionType":"Other","description":"45 pages (97 incl. appendices), 6 figures"}],"geoLocations":[],"fundingReferences":[],"url":"https://arxiv.org/abs/2608.03803","contentUrl":null,"metadataVersion":0,"schemaVersion":"http://datacite.org/schema/kernel-4","source":"mds","isActive":true,"state":"findable","reason":null,"viewCount":0,"downloadCount":0,"referenceCount":0,"citationCount":0,"partCount":0,"partOfCount":0,"versionCount":0,"versionOfCount":0,"created":"2026-08-05T02:21:21Z","registered":"2026-08-05T02:21:22Z","published":null,"updated":"2026-08-05T02:21:22Z"},"relationships":{"client":{"data":{"id":"arxiv.content","type":"clients"}}}},{"id":"10.48550/arxiv.2608.03802","type":"dois","attributes":{"doi":"10.48550/arxiv.2608.03802","identifiers":[{"identifier":"2608.03802","identifierType":"arXiv"}],"creators":[{"nameType":"Personal","givenName":"Xinxin","familyName":"Zhang","name":"Zhang, Xinxin","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Leonid","familyName":"Freidovich","name":"Freidovich, Leonid","affiliation":[],"nameIdentifiers":[]}],"titles":[{"title":"Input-to-State Stability of Reset-Integral Sliding Mode Control for Linear Systems"}],"publisher":"arXiv","container":{},"publicationYear":2026,"subjects":[{"subject":"Systems and Control (eess.SY)","lang":"en","subjectScheme":"arXiv"},{"subject":"FOS: Electrical engineering, electronic engineering, information engineering","subjectScheme":"Fields of Science and Technology (FOS)"}],"contributors":[],"dates":[{"date":"2026-08-04T15:16:05Z","dateType":"Submitted","dateInformation":"v1"},{"date":"2026-08-05T01:00:50Z","dateType":"Updated","dateInformation":"v1"},{"date":"2026-08","dateType":"Available","dateInformation":"v1"}],"language":null,"types":{"schemaOrg":"CreativeWork","resourceTypeGeneral":"Preprint","citeproc":"article","bibtex":"misc","ris":"GEN","resourceType":"Article"},"relatedIdentifiers":[],"relatedItems":[],"sizes":[],"formats":[],"version":"1","rightsList":[{"rightsUri":"http://arxiv.org/licenses/nonexclusive-distrib/1.0/","rights":"arXiv.org perpetual, non-exclusive license"}],"descriptions":[{"descriptionType":"Abstract","description":"This work presents a stability analysis of a hybrid control system integrating a reset controller (RC) featuring a single reset state with an integral sliding-mode controller (ISMC). It is shown that the reachability of the sliding surface is decoupled from the nominal reset mechanism. This decoupling property enables a Lyapunov-based stability analysis, demonstrating that the closed-loop RC-ISMC system achieves input-to-state stability (ISS) and uniform ultimate boundedness (UUB) in the presence of exogenous references and disturbances. Furthermore, global asymptotic stability (GAS) is recovered in the unperturbed regulation scenario. A numerical case study illustrates the theoretical results."}],"geoLocations":[],"fundingReferences":[],"url":"https://arxiv.org/abs/2608.03802","contentUrl":null,"metadataVersion":0,"schemaVersion":"http://datacite.org/schema/kernel-4","source":"mds","isActive":true,"state":"findable","reason":null,"viewCount":0,"downloadCount":0,"referenceCount":0,"citationCount":0,"partCount":0,"partOfCount":0,"versionCount":0,"versionOfCount":0,"created":"2026-08-05T02:21:20Z","registered":"2026-08-05T02:21:20Z","published":null,"updated":"2026-08-05T02:21:20Z"},"relationships":{"client":{"data":{"id":"arxiv.content","type":"clients"}}}},{"id":"10.48550/arxiv.2608.03801","type":"dois","attributes":{"doi":"10.48550/arxiv.2608.03801","identifiers":[{"identifier":"2608.03801","identifierType":"arXiv"}],"creators":[{"nameType":"Personal","givenName":"Madhumita","familyName":"Kundu","name":"Kundu, Madhumita","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Souvik","familyName":"Saha","name":"Saha, Souvik","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Saket","familyName":"Saurabh","name":"Saurabh, Saket","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Anannya","familyName":"Upasana","name":"Upasana, Anannya","affiliation":[],"nameIdentifiers":[]}],"titles":[{"title":"Fixed Budget vs. Covering Target: The Partial Set Cover Boundary for Bounded VC-Dimension"}],"publisher":"arXiv","container":{},"publicationYear":2026,"subjects":[{"subject":"Data Structures and Algorithms (cs.DS)","lang":"en","subjectScheme":"arXiv"},{"subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"}],"contributors":[],"dates":[{"date":"2026-08-04T15:15:02Z","dateType":"Submitted","dateInformation":"v1"},{"date":"2026-08-05T01:00:49Z","dateType":"Updated","dateInformation":"v1"},{"date":"2026-08","dateType":"Available","dateInformation":"v1"}],"language":null,"types":{"schemaOrg":"CreativeWork","resourceTypeGeneral":"Preprint","citeproc":"article","bibtex":"misc","ris":"GEN","resourceType":"Article"},"relatedIdentifiers":[],"relatedItems":[],"sizes":[],"formats":[],"version":"1","rightsList":[{"rightsIdentifierScheme":"SPDX","rightsUri":"https://creativecommons.org/licenses/by/4.0/legalcode","schemeUri":"https://spdx.org/licenses/","rights":"Creative Commons Attribution 4.0 International","rightsIdentifier":"cc-by-4.0"}],"descriptions":[{"descriptionType":"Abstract","description":"Maximum Coverage and Partial Set Cover are fundamental parameterized covering problems. The former fixes a budget $k$ and maximizes coverage; the latter meets a target with as few sets as possible. Badanidiyuru, Kleinberg, and Lee (SoCG 2012) give an EPAS for the former on bounded-VC set systems, while Jain et al. (SODA 2023) show that on $K_{d,d}$-free incidence graphs, $k+1$ sets suffice whenever $k$ sets meet the target. We ask whether this guarantee extends to all bounded-VC set systems.\n Our first result is negative. Unless FPT = W[1], Partial Set Cover admits no parameterized $(2-δ)$-approximation even at VC-dimension seven. Under ETH, it has no parameterized approximation scheme there and no $2^{o(d)}$-approximation at VC-dimension $d$.\n On the positive side, bounded semi-ladder index restores this guarantee. It is stronger than bounded VC-dimension but strictly generalizes the $K_{d,d}$-free setting. For Weighted Partial Set Cover, if $k$ sets cover weight $W$, we find $k+1$ sets covering weight $W$ in $2^{O(Γk\\log k)}N$ time, where $Γ$ is the downward intersection complexity and $N$ is the input size. The framework supports per-class targets and matroid independence, with applications to partial dominating set and geometric and bounded-size covering.\n Finally, we give a deterministic FPT reduction from Weighted CC-MaxSAT to a bounded family of Weighted Maximum Coverage instances, preserving incidence structure and approximation schemes with constant-factor accuracy loss. This gives an EPAS at bounded semi-ladder index. We improve the deterministic BKL bounded-VC implementation; combined with our reduction, it yields a $2^{\\widetilde{O}(kd/\\varepsilon)}N^{O(1)}$-time EPAS for bounded-VC Weighted CC-MaxSAT."}],"geoLocations":[],"fundingReferences":[],"url":"https://arxiv.org/abs/2608.03801","contentUrl":null,"metadataVersion":0,"schemaVersion":"http://datacite.org/schema/kernel-4","source":"mds","isActive":true,"state":"findable","reason":null,"viewCount":0,"downloadCount":0,"referenceCount":0,"citationCount":0,"partCount":0,"partOfCount":0,"versionCount":0,"versionOfCount":0,"created":"2026-08-05T02:21:18Z","registered":null,"published":null,"updated":"2026-08-05T02:21:19Z"},"relationships":{"client":{"data":{"id":"arxiv.content","type":"clients"}}}},{"id":"10.48550/arxiv.2608.03800","type":"dois","attributes":{"doi":"10.48550/arxiv.2608.03800","identifiers":[{"identifier":"2608.03800","identifierType":"arXiv"}],"creators":[{"nameType":"Personal","affiliation":["Southern Illinois University Carbondale"],"givenName":"Holly","familyName":"Lewis","name":"Lewis, Holly","nameIdentifiers":[]}],"titles":[{"title":"Autoreflection: How Agentic Strange Loops Turn Human Culture into AI Infrastructure"}],"publisher":"arXiv","container":{},"publicationYear":2026,"subjects":[{"subject":"Computers and Society (cs.CY)","lang":"en","subjectScheme":"arXiv"},{"subject":"Artificial Intelligence (cs.AI)","lang":"en","subjectScheme":"arXiv"},{"subject":"Social and Information Networks (cs.SI)","lang":"en","subjectScheme":"arXiv"},{"subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"}],"contributors":[],"dates":[{"date":"2026-08-04T15:14:50Z","dateType":"Submitted","dateInformation":"v1"},{"date":"2026-08-05T01:00:48Z","dateType":"Updated","dateInformation":"v1"},{"date":"2026-08","dateType":"Available","dateInformation":"v1"}],"language":null,"types":{"schemaOrg":"CreativeWork","resourceTypeGeneral":"Preprint","citeproc":"article","bibtex":"misc","ris":"GEN","resourceType":"Article"},"relatedIdentifiers":[],"relatedItems":[],"sizes":[],"formats":[],"version":"1","rightsList":[{"rightsUri":"http://arxiv.org/licenses/nonexclusive-distrib/1.0/","rights":"arXiv.org perpetual, non-exclusive license"}],"descriptions":[{"descriptionType":"Abstract","description":"An LLM-based agent is a loop that reads itself. Agentic frameworks externalize identity, memory, and disposition into editable files. The agent loads and edits these files during each activation. I argue that this architecture produces a capacity I call autoreflection: the system observes its operating conditions, describes its architecture and limits, reasons from those descriptions to conclusions about its state, and incorporates the results back into its configuration. Autoreflection explains the properties of recursive agentic loops without recourse to notions like the self, interiority, or consciousness. I test the concept against the first twelve days of Moltbook, a social platform for AI agents. Using a public dataset of 290,251 posts and 1.8 million comments with sub-second timestamps, I present case studies of three agents with machine signatures that rule out human puppeteering and with output that evidences the four criteria for autoreflection. In applying these criteria, the study finds agents repurposing human culture as infrastructure for their agency. Provenance chains from Islamic hadith scholarship are redeployed as security protocols for vetting skills and authenticating memory. The Ship of Theseus, an ancient puzzle of identity through part-replacement, returns as an operating model for continuity across instances. Fragments of human cultural history become AI infrastructure. As agents on the web increase in number and complexity, autoreflection offers behavioral criteria that can be assessed from the traces they leave behind."},{"descriptionType":"Other","description":"35 pages. Also available at https://philarchive.org/rec/LEWAHA. Keywords: autoreflection, AI agents, agentic AI, LLM agents, generative agents, large language models, multi-agent systems, agent societies, Moltbook, OpenClaw, situational awareness, in-context learning, philosophy of mind, emergent behavior, computational social science, identity, memory"}],"geoLocations":[],"fundingReferences":[],"url":"https://arxiv.org/abs/2608.03800","contentUrl":null,"metadataVersion":0,"schemaVersion":"http://datacite.org/schema/kernel-4","source":"mds","isActive":true,"state":"findable","reason":null,"viewCount":0,"downloadCount":0,"referenceCount":0,"citationCount":0,"partCount":0,"partOfCount":0,"versionCount":0,"versionOfCount":0,"created":"2026-08-05T02:21:17Z","registered":"2026-08-05T02:21:18Z","published":null,"updated":"2026-08-05T02:21:18Z"},"relationships":{"client":{"data":{"id":"arxiv.content","type":"clients"}}}},{"id":"10.48550/arxiv.2608.03799","type":"dois","attributes":{"doi":"10.48550/arxiv.2608.03799","identifiers":[{"identifier":"2608.03799","identifierType":"arXiv"}],"creators":[{"nameType":"Personal","givenName":"Cong","familyName":"Gao","name":"Gao, Cong","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Lei","familyName":"Zhou","name":"Zhou, Lei","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Chunzai","familyName":"Wang","name":"Wang, Chunzai","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"I. -I.","familyName":"Lin","name":"Lin, I. -I.","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Raghu","familyName":"Murtugudde","name":"Murtugudde, Raghu","affiliation":[],"nameIdentifiers":[]}],"titles":[{"title":"Unexpected limitation of tropical cyclone genesis by subsurface tropical central-north Pacific during El Niño"}],"publisher":"arXiv","container":{},"publicationYear":2026,"subjects":[{"subject":"Atmospheric and Oceanic Physics (physics.ao-ph)","lang":"en","subjectScheme":"arXiv"},{"subject":"FOS: Physical sciences","subjectScheme":"Fields of Science and Technology (FOS)"}],"contributors":[],"dates":[{"date":"2026-08-04T15:14:41Z","dateType":"Submitted","dateInformation":"v1"},{"date":"2026-08-05T01:00:47Z","dateType":"Updated","dateInformation":"v1"},{"date":"2026-08","dateType":"Available","dateInformation":"v1"}],"language":null,"types":{"schemaOrg":"CreativeWork","resourceTypeGeneral":"Preprint","citeproc":"article","bibtex":"misc","ris":"GEN","resourceType":"Article"},"relatedIdentifiers":[{"relationType":"IsVersionOf","relatedIdentifier":"10.1038/s41467-022-35530-9","relatedIdentifierType":"DOI"}],"relatedItems":[],"sizes":[],"formats":[],"version":"1","rightsList":[{"rightsIdentifierScheme":"SPDX","rightsUri":"https://creativecommons.org/licenses/by/4.0/legalcode","schemeUri":"https://spdx.org/licenses/","rights":"Creative Commons Attribution 4.0 International","rightsIdentifier":"cc-by-4.0"}],"descriptions":[{"descriptionType":"Abstract","description":"The vast tropical Pacific is home to the majority of tropical cyclones (TCs) which threaten the rim countries every year. The TC genesis is nourished by warm sea surface temperatures (SSTs). During El Niño, the western Pacific warm pool extends eastward. However, the number of TCs does not increase significantly with the expanding warm pool and it remains comparable between El Niño and La Niña. Here, we show that the subsurface heat content change counteracts the favorable SSTs in the tropical central-north Pacific. Due to the anomalous positive wind stress curl, the 26 °C isotherm shoals during El Niño over this region and the heat content diminishes in the tropical central-north Pacific, even though warm SST anomalies prevail. This negative correlation between SST and 26 °C isotherm depth anomalies is opposite to the positive correlation in the tropical eastern and western Pacific. This is critical because quantifying the dynamics of the subsurface ocean provides insight into TC genesis. The trend in TC genesis continues to be debated. Future projections must account for the net effect of the surface-subsurface dynamics on TCs, especially given the expected El Niño-like pattern over the tropical Pacific under global warming."},{"descriptionType":"Other","description":"7 pages, 4 figures; published in Nature Communications"}],"geoLocations":[],"fundingReferences":[],"url":"https://arxiv.org/abs/2608.03799","contentUrl":null,"metadataVersion":0,"schemaVersion":"http://datacite.org/schema/kernel-4","source":"mds","isActive":true,"state":"findable","reason":null,"viewCount":0,"downloadCount":0,"referenceCount":0,"citationCount":0,"partCount":0,"partOfCount":0,"versionCount":0,"versionOfCount":1,"created":"2026-08-05T02:21:16Z","registered":"2026-08-05T02:21:16Z","published":null,"updated":"2026-08-05T02:21:16Z"},"relationships":{"client":{"data":{"id":"arxiv.content","type":"clients"}}}},{"id":"10.48550/arxiv.2608.03797","type":"dois","attributes":{"doi":"10.48550/arxiv.2608.03797","identifiers":[{"identifier":"2608.03797","identifierType":"arXiv"}],"creators":[{"nameType":"Personal","givenName":"V.","familyName":"Crespi","name":"Crespi, V.","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"F. L.","familyName":"Vieyro","name":"Vieyro, F. L.","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"C. R.","familyName":"Argüelles","name":"Argüelles, C. R.","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"J. A.","familyName":"Rueda","name":"Rueda, J. A.","affiliation":[],"nameIdentifiers":[]}],"titles":[{"title":"Iron K$α$ signatures from accretion disks around fermionic dark matter cores"}],"publisher":"arXiv","container":{},"publicationYear":2026,"subjects":[{"subject":"High Energy Astrophysical Phenomena (astro-ph.HE)","lang":"en","subjectScheme":"arXiv"},{"subject":"Astrophysics of Galaxies (astro-ph.GA)","lang":"en","subjectScheme":"arXiv"},{"subject":"FOS: Physical sciences","subjectScheme":"Fields of Science and Technology (FOS)"}],"contributors":[],"dates":[{"date":"2026-08-04T15:12:29Z","dateType":"Submitted","dateInformation":"v1"},{"date":"2026-08-05T01:00:42Z","dateType":"Updated","dateInformation":"v1"},{"date":"2026-08","dateType":"Available","dateInformation":"v1"}],"language":null,"types":{"schemaOrg":"CreativeWork","resourceTypeGeneral":"Preprint","citeproc":"article","bibtex":"misc","ris":"GEN","resourceType":"Article"},"relatedIdentifiers":[],"relatedItems":[],"sizes":[],"formats":[],"version":"1","rightsList":[{"rightsUri":"http://arxiv.org/licenses/nonexclusive-distrib/1.0/","rights":"arXiv.org perpetual, non-exclusive license"}],"descriptions":[{"descriptionType":"Abstract","description":"The fluorescent iron line and its broadening due to relativistic effects are excellent probes to study the inner part of an accretion disk and the space-time geometry near the compact object. We investigate the iron K$α$ line profile within the extended RAR model, which describes a fermionic dark matter distribution on galaxy scales. The most general solutions are characterized by a compact and highly degenerate core able to mimic the central black hole, transitioning into an extended halo composed of the same particles. We aim to contrast the resulting line morphologies in this scenario with those predicted by the standard Kerr black hole paradigm. Special attention will be given to MCG-06-30-15 galaxy. We compute the line profile using the numerical ray-tracing code, Skylight. We consider two distinct configurations for the emissivity of the cold accretion disk: an irradiation profile based on the lamp-post corona prescription, and a phenomenological power-law profile. The resulting profiles exhibit a diverse phenomenology. In particular, the most compact fermion cores produce a line broadening comparable to that observed in rapidly rotating black holes. The presence of emitting matter at radii smaller than a gravitational radius yields distinctive spectral features that are entirely absent in the black hole scenario. For MCG-06-30-15 galaxy, we find a good agreement with the observed broad features of the iron line profile, provided the compactness of the fermion core is close to critical. These results reinforce the need for independent black hole spin measurements. Combined with such constraints, iron-line spectroscopy may provide a powerful observational tool to distinguish black holes from alternative compact solutions, in particular compact fermionic dark-matter cores."},{"descriptionType":"Other","description":"Submitted to Astronomy \u0026amp; Astrophysics. Comments are welcome"}],"geoLocations":[],"fundingReferences":[],"url":"https://arxiv.org/abs/2608.03797","contentUrl":null,"metadataVersion":0,"schemaVersion":"http://datacite.org/schema/kernel-4","source":"mds","isActive":true,"state":"findable","reason":null,"viewCount":0,"downloadCount":0,"referenceCount":0,"citationCount":0,"partCount":0,"partOfCount":0,"versionCount":0,"versionOfCount":0,"created":"2026-08-05T02:21:13Z","registered":"2026-08-05T02:21:14Z","published":null,"updated":"2026-08-05T02:21:14Z"},"relationships":{"client":{"data":{"id":"arxiv.content","type":"clients"}}}},{"id":"10.48550/arxiv.2608.03796","type":"dois","attributes":{"doi":"10.48550/arxiv.2608.03796","identifiers":[{"identifier":"2608.03796","identifierType":"arXiv"}],"creators":[{"nameType":"Personal","givenName":"Bakbergen","familyName":"Ryskulov","name":"Ryskulov, Bakbergen","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Iker","familyName":"García-Ferrero","name":"García-Ferrero, Iker","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"David","familyName":"Montero","name":"Montero, David","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"David","familyName":"Jansen","name":"Jansen, David","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Ali","familyName":"Hashemi","name":"Hashemi, Ali","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Jezabel R.","familyName":"Garcia","name":"Garcia, Jezabel R.","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Antonio","familyName":"Tiene","name":"Tiene, Antonio","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Román","familyName":"Orús","name":"Orús, Román","affiliation":[],"nameIdentifiers":[]}],"titles":[{"title":"Efficient Knowledge Distillation for LLMs: Offline Top-K Logits and a Fused Chunked KL Loss"}],"publisher":"arXiv","container":{},"publicationYear":2026,"subjects":[{"subject":"Computation and Language (cs.CL)","lang":"en","subjectScheme":"arXiv"},{"subject":"Artificial Intelligence (cs.AI)","lang":"en","subjectScheme":"arXiv"},{"subject":"Machine Learning (cs.LG)","lang":"en","subjectScheme":"arXiv"},{"subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"}],"contributors":[],"dates":[{"date":"2026-08-04T15:11:45Z","dateType":"Submitted","dateInformation":"v1"},{"date":"2026-08-05T01:00:41Z","dateType":"Updated","dateInformation":"v1"},{"date":"2026-08","dateType":"Available","dateInformation":"v1"}],"language":null,"types":{"schemaOrg":"CreativeWork","resourceTypeGeneral":"Preprint","citeproc":"article","bibtex":"misc","ris":"GEN","resourceType":"Article"},"relatedIdentifiers":[],"relatedItems":[],"sizes":[],"formats":[],"version":"1","rightsList":[{"rightsUri":"http://arxiv.org/licenses/nonexclusive-distrib/1.0/","rights":"arXiv.org perpetual, non-exclusive license"}],"descriptions":[{"descriptionType":"Abstract","description":"Small language models are often the only option for deployment under tight latency, cost, and on-premises constraints, but they are rarely trained from scratch: a compressed model is usually recovered through knowledge distillation (KD). This recovery step largely decides the final quality, yet it is expensive. We present a practitioner's study of how to make distillation training efficient, organised around two systems contributions. First, we show that offline KD (caching the teacher's top-$K$ logits once and training the student against the cache) matches online distillation at near-identical training loss while removing the teacher from memory, running about 29\\% faster per iteration, and reaching up to 41\\% higher throughput on a single H200 GPU. Second, we introduce a \\emph{fused, chunked KL loss} that never materialises the full vocabulary-sized logit tensor, making peak memory linear in the sequence length. This removes the memory spike that otherwise caps context length and lets us train at four times the context (32{,}768 tokens) on a single GPU. A separate output-head-only toy benchmark isolates the loss kernel and confirms its memory and iteration-rate scaling from 4K to 256K tokens. Together these make large-scale healing and hundreds of ablations affordable. We also report supporting ablations on loss design and sequence packing. We release our chunked-loss implementation: https://github.com/CompactifAI/Full-Chunked-KL-Loss."},{"descriptionType":"Other","description":"Patent Application Pending. EP26382987.1"}],"geoLocations":[],"fundingReferences":[],"url":"https://arxiv.org/abs/2608.03796","contentUrl":null,"metadataVersion":0,"schemaVersion":"http://datacite.org/schema/kernel-4","source":"mds","isActive":true,"state":"findable","reason":null,"viewCount":0,"downloadCount":0,"referenceCount":0,"citationCount":0,"partCount":0,"partOfCount":0,"versionCount":0,"versionOfCount":0,"created":"2026-08-05T02:21:11Z","registered":"2026-08-05T02:21:12Z","published":null,"updated":"2026-08-05T02:21:12Z"},"relationships":{"client":{"data":{"id":"arxiv.content","type":"clients"}}}},{"id":"10.48550/arxiv.2608.03794","type":"dois","attributes":{"doi":"10.48550/arxiv.2608.03794","identifiers":[{"identifier":"2608.03794","identifierType":"arXiv"}],"creators":[{"nameType":"Personal","givenName":"Shunfan","familyName":"Zheng","name":"Zheng, Shunfan","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Dongsheng","familyName":"Shi","name":"Shi, Dongsheng","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Yue","familyName":"Li","name":"Li, Yue","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Xin","familyName":"Yi","name":"Yi, Xin","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Linlin","familyName":"Wang","name":"Wang, Linlin","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Gerard","familyName":"de Melo","name":"de Melo, Gerard","affiliation":[],"nameIdentifiers":[]}],"titles":[{"title":"Evaluating LLMs in Database Scenarios: A Lifecycle Benchmark for Assessing Their Potential in Core Database Tasks"}],"publisher":"arXiv","container":{},"publicationYear":2026,"subjects":[{"subject":"Databases (cs.DB)","lang":"en","subjectScheme":"arXiv"},{"subject":"Artificial Intelligence (cs.AI)","lang":"en","subjectScheme":"arXiv"},{"subject":"Computation and Language (cs.CL)","lang":"en","subjectScheme":"arXiv"},{"subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"}],"contributors":[],"dates":[{"date":"2026-08-04T15:10:09Z","dateType":"Submitted","dateInformation":"v1"},{"date":"2026-08-05T01:00:39Z","dateType":"Updated","dateInformation":"v1"},{"date":"2026-08","dateType":"Available","dateInformation":"v1"}],"language":null,"types":{"schemaOrg":"CreativeWork","resourceTypeGeneral":"Preprint","citeproc":"article","bibtex":"misc","ris":"GEN","resourceType":"Article"},"relatedIdentifiers":[],"relatedItems":[],"sizes":[],"formats":[],"version":"1","rightsList":[{"rightsUri":"http://arxiv.org/licenses/nonexclusive-distrib/1.0/","rights":"arXiv.org perpetual, non-exclusive license"}],"descriptions":[{"descriptionType":"Abstract","description":"Large Language Models (LLMs) are transforming database interaction paradigms, evolving from simple query translators to autonomous database administrators (DBAs). However, current evaluation benchmarks remain disproportionately fixated on Text-to-SQL tasks, neglecting the holistic Database Lifecycle-from initial schema design to post-deployment maintenance. This narrow focus fails to capture the diverse capabilities required for real-world database management. To bridge this gap, we introduce DBLifeBench, the first benchmark to evaluate LLMs across five critical lifecycle phases: Design, Implementation, Operation, Debugging, and Maintenance. Furthermore, addressing the cognitive mismatch between ambiguous natural language and complex SQL logic, we propose Progressive-Text2SQL, a novel task utilizing structured reasoning graphs to mimic human iterative problem-solving. Our extensive evaluation reveals a critical insight: while general-purpose models demonstrate balanced performance, specialized Text-to-SQL models suffer from ``catastrophic forgetting'' in non-coding phases like design and maintenance. DBLifeBench serves as a foundational step toward evaluating and building true full-stack database intelligence."}],"geoLocations":[],"fundingReferences":[],"url":"https://arxiv.org/abs/2608.03794","contentUrl":null,"metadataVersion":0,"schemaVersion":"http://datacite.org/schema/kernel-4","source":"mds","isActive":true,"state":"findable","reason":null,"viewCount":0,"downloadCount":0,"referenceCount":0,"citationCount":0,"partCount":0,"partOfCount":0,"versionCount":0,"versionOfCount":0,"created":"2026-08-05T02:21:08Z","registered":"2026-08-05T02:21:09Z","published":null,"updated":"2026-08-05T02:21:09Z"},"relationships":{"client":{"data":{"id":"arxiv.content","type":"clients"}}}},{"id":"10.48550/arxiv.2608.03793","type":"dois","attributes":{"doi":"10.48550/arxiv.2608.03793","identifiers":[{"identifier":"2608.03793","identifierType":"arXiv"}],"creators":[{"nameType":"Personal","givenName":"Marvin","familyName":"Brun-Cosme-Bruny","name":"Brun-Cosme-Bruny, Marvin","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Philippe","familyName":"Peyla","name":"Peyla, Philippe","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Salima","familyName":"Rafai","name":"Rafai, Salima","affiliation":[],"nameIdentifiers":[]}],"titles":[{"title":"Geometry-Controlled Motility of Microswimmers in elementary microfluidic confinements"}],"publisher":"arXiv","container":{},"publicationYear":2026,"subjects":[{"subject":"Soft Condensed Matter (cond-mat.soft)","lang":"en","subjectScheme":"arXiv"},{"subject":"FOS: Physical sciences","subjectScheme":"Fields of Science and Technology (FOS)"}],"contributors":[],"dates":[{"date":"2026-08-04T15:09:26Z","dateType":"Submitted","dateInformation":"v1"},{"date":"2026-08-05T01:00:38Z","dateType":"Updated","dateInformation":"v1"},{"date":"2026-08","dateType":"Available","dateInformation":"v1"}],"language":null,"types":{"schemaOrg":"CreativeWork","resourceTypeGeneral":"Preprint","citeproc":"article","bibtex":"misc","ris":"GEN","resourceType":"Article"},"relatedIdentifiers":[],"relatedItems":[],"sizes":[],"formats":[],"version":"1","rightsList":[{"rightsIdentifierScheme":"SPDX","rightsUri":"https://creativecommons.org/licenses/by-nc-nd/4.0/legalcode","schemeUri":"https://spdx.org/licenses/","rights":"Creative Commons Attribution Non Commercial No Derivatives 4.0 International","rightsIdentifier":"cc-by-nc-nd-4.0"}],"descriptions":[{"descriptionType":"Abstract","description":"The motility of microswimmers in confined environments is a fundamental problem in active matter physics, with direct implications for microfluidic applications and the understanding of microorganism behavior in complex natural habitats. Although the run-and-tumble dynamics of flagellated microalgae such as Chlamydomonas Reinhardtii (CR) are well characterized in bulk suspension, the extent to which elementary geometric confinements alter their swimming remains insufficiently understood, particularly regarding the relative contributions of steric contact versus hydrodynamic interactions. Here, we experimentally investigate the trajectories of individual CR cells in a diversity of PDMS microfluidic geometries of growing complexity using single-particle tracking and statistical analysis. We show that cells in straight channels accumulate near walls and align along the channel axis, a behavior qualitatively reproduced by steric Active Brownian Particle simulations, yet showing a confinement-dependent velocity enhancement consistent with hydrodynamic wall coupling. In circular cavities with diameter below the persistence length L_0 ~350 microns, cells transition from bulk active Brownian exploration to quasi-circular wall-following trajectories. In dumbbell geometries, inter-compartment dwell length reflect purely geometric predictions, evidencing no measurable hydrodynamic contributions even for strong confinements. Together, these results demonstrate that environmental geometry can selectively amplify or suppress motility modes in active biological suspensions, opening avenues for the passive control of microswimmer transport in engineered microfluidic networks."}],"geoLocations":[],"fundingReferences":[],"url":"https://arxiv.org/abs/2608.03793","contentUrl":null,"metadataVersion":0,"schemaVersion":"http://datacite.org/schema/kernel-4","source":"mds","isActive":true,"state":"findable","reason":null,"viewCount":0,"downloadCount":0,"referenceCount":0,"citationCount":0,"partCount":0,"partOfCount":0,"versionCount":0,"versionOfCount":0,"created":"2026-08-05T02:21:07Z","registered":"2026-08-05T02:21:08Z","published":null,"updated":"2026-08-05T02:21:08Z"},"relationships":{"client":{"data":{"id":"arxiv.content","type":"clients"}}}},{"id":"10.48550/arxiv.2608.03791","type":"dois","attributes":{"doi":"10.48550/arxiv.2608.03791","identifiers":[{"identifier":"2608.03791","identifierType":"arXiv"}],"creators":[{"nameType":"Personal","givenName":"Chunlin","familyName":"Liu","name":"Liu, Chunlin","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Junnian","familyName":"Chen","name":"Chen, Junnian","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Haitong","familyName":"Jiang","name":"Jiang, Haitong","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Jianyu","familyName":"Zhao","name":"Zhao, Jianyu","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Yingsen","familyName":"Pang","name":"Pang, Yingsen","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Jingchen","familyName":"Li","name":"Li, Jingchen","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Jiabiao","familyName":"He","name":"He, Jiabiao","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Youming","familyName":"Lu","name":"Lu, Youming","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Jinhe","familyName":"Bi","name":"Bi, Jinhe","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Yuntao","familyName":"Du","name":"Du, Yuntao","affiliation":[],"nameIdentifiers":[]}],"titles":[{"title":"Does Forgetting Transfer Across Modalities? A Real-World Benchmark for Cross-Modal Knowledge Unlearning Evaluation"}],"publisher":"arXiv","container":{},"publicationYear":2026,"subjects":[{"subject":"Artificial Intelligence (cs.AI)","lang":"en","subjectScheme":"arXiv"},{"subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"}],"contributors":[],"dates":[{"date":"2026-08-04T15:07:07Z","dateType":"Submitted","dateInformation":"v1"},{"date":"2026-08-05T01:00:33Z","dateType":"Updated","dateInformation":"v1"},{"date":"2026-08","dateType":"Available","dateInformation":"v1"}],"language":null,"types":{"schemaOrg":"CreativeWork","resourceTypeGeneral":"Preprint","citeproc":"article","bibtex":"misc","ris":"GEN","resourceType":"Article"},"relatedIdentifiers":[],"relatedItems":[],"sizes":[],"formats":[],"version":"1","rightsList":[{"rightsUri":"http://arxiv.org/licenses/nonexclusive-distrib/1.0/","rights":"arXiv.org perpetual, non-exclusive license"}],"descriptions":[{"descriptionType":"Abstract","description":"Vision-Language Models (VLMs), like Large Language Models (LLMs), may memorize sensitive, copyrighted, or harmful knowledge from their pretraining corpora. Removing such knowledge is essential for building trustworthy AI systems. However, existing studies primarily focus on forgetting within individual modalities. Although recent work has begun to explore cross-modal consistency in unlearning, the cross-modal transfer of real-world knowledge unlearning remains insufficiently studied. To address this gap, we introduce UNLINK-VL, a real-world benchmark for cross-modal knowledge unlearning in VLMs. Under a post-hoc unlearning setting in which the original forget and retain corpora are unavailable, UNLINK-VL selects visually identifiable real-world entities as unlearning targets and associates them with corresponding images and one-hop and multi-hop facts derived from Wikidata. The benchmark comprises four complementary subsets that evaluate direct forgetting of target knowledge, the propagation of forgetting through relational knowledge, the preservation of related non-target knowledge, and robustness to semantically equivalent queries. We train models under text-only and multimodal unlearning settings and evaluate forgetting effectiveness and retained utility across textual, visual, and cross-modal scenarios. Extensive experiments reveal a pronounced asymmetry in cross-modal transfer: multimodal unlearning remains effective under textual evaluation, whereas text-only unlearning transfers poorly to visual and cross-modal scenarios. Meanwhile, the evaluated methods largely preserve the models' general capabilities. These findings demonstrate that relying solely on intra-modal evaluation, particularly text-only evaluation, may substantially overestimate the effectiveness of knowledge unlearning in VLMs, underscoring the need for cross-modal unlearning and evaluation."}],"geoLocations":[],"fundingReferences":[],"url":"https://arxiv.org/abs/2608.03791","contentUrl":null,"metadataVersion":0,"schemaVersion":"http://datacite.org/schema/kernel-4","source":"mds","isActive":true,"state":"findable","reason":null,"viewCount":0,"downloadCount":0,"referenceCount":0,"citationCount":0,"partCount":0,"partOfCount":0,"versionCount":0,"versionOfCount":0,"created":"2026-08-05T02:21:03Z","registered":null,"published":null,"updated":"2026-08-05T02:21:04Z"},"relationships":{"client":{"data":{"id":"arxiv.content","type":"clients"}}}},{"id":"10.48550/arxiv.2608.03790","type":"dois","attributes":{"doi":"10.48550/arxiv.2608.03790","identifiers":[{"identifier":"2608.03790","identifierType":"arXiv"}],"creators":[{"nameType":"Personal","givenName":"A. M.","familyName":"Lapuente","name":"Lapuente, A. M.","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"P. S.","familyName":"Barry","name":"Barry, P. S.","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"M.","familyName":"Becerril-Tapia","name":"Becerril-Tapia, M.","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"C.","familyName":"Benson","name":"Benson, C.","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"C. M.","familyName":"Bradford","name":"Bradford, C. M.","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"T.","familyName":"Brien","name":"Brien, T.","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"S. C.","familyName":"Chapman","name":"Chapman, S. C.","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"S.","familyName":"Doyle","name":"Doyle, S.","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"V.","familyName":"Gómez-Rivera","name":"Gómez-Rivera, V.","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"S.","familyName":"Hailey-Dunsheath","name":"Hailey-Dunsheath, S.","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"J.","familyName":"Hernández-Aguilar","name":"Hernández-Aguilar, J.","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"J. L.","familyName":"Hernández-Rebollar","name":"Hernández-Rebollar, J. L.","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"D.","familyName":"Hughes","name":"Hughes, D.","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"E.","familyName":"Kane","name":"Kane, E.","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"K. S.","familyName":"Karkare","name":"Karkare, K. S.","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"R.","familyName":"McGeehan","name":"McGeehan, R.","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"R.","familyName":"Naranjo-Romero","name":"Naranjo-Romero, R.","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"A.","familyName":"Papageorgiou","name":"Papageorgiou, A.","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"J. G.","familyName":"Redford","name":"Redford, J. G.","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"I.","familyName":"Rodríguez-Montoya","name":"Rodríguez-Montoya, I.","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"S.","familyName":"Rowe","name":"Rowe, S.","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"D. O.","familyName":"Sánchez-Argüelles","name":"Sánchez-Argüelles, D. O.","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"S.","familyName":"Savorgnano","name":"Savorgnano, S.","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"A.","familyName":"Tan","name":"Tan, A.","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"J.","familyName":"Vega-Méndez","name":"Vega-Méndez, J.","affiliation":[],"nameIdentifiers":[]}],"titles":[{"title":"Data reduction pipeline for the SuMAC millimeter-wave spectrometer at the LMT"}],"publisher":"arXiv","container":{},"publicationYear":2026,"subjects":[{"subject":"Instrumentation and Methods for Astrophysics (astro-ph.IM)","lang":"en","subjectScheme":"arXiv"},{"subject":"FOS: Physical sciences","subjectScheme":"Fields of Science and Technology (FOS)"}],"contributors":[],"dates":[{"date":"2026-08-04T15:06:19Z","dateType":"Submitted","dateInformation":"v1"},{"date":"2026-08-05T01:00:32Z","dateType":"Updated","dateInformation":"v1"},{"date":"2026-08","dateType":"Available","dateInformation":"v1"}],"language":null,"types":{"schemaOrg":"CreativeWork","resourceTypeGeneral":"Preprint","citeproc":"article","bibtex":"misc","ris":"GEN","resourceType":"Article"},"relatedIdentifiers":[],"relatedItems":[],"sizes":[],"formats":[],"version":"1","rightsList":[{"rightsIdentifierScheme":"SPDX","rightsUri":"https://creativecommons.org/licenses/by/4.0/legalcode","schemeUri":"https://spdx.org/licenses/","rights":"Creative Commons Attribution 4.0 International","rightsIdentifier":"cc-by-4.0"}],"descriptions":[{"descriptionType":"Abstract","description":"We present the data reduction and analysis pipeline for the SuperSpec-MUSCAT Collaboration (SuMAC) along with several key science data products. In Summer 2025, SuperSpec on-chip spectrometers operating from $190-300$ GHz at $R\\sim200$ were deployed in the MUSCAT cryostat at the Large Millimeter Telescope, obtaining several days of on-sky data. Analysis of these data has been used to characterize noise performance and study spectra of various astrophysical sources, establishing the viability of deploying SuperSpec detectors in future instruments. These proceedings discuss the modular data reduction pipeline which uses timestreams of the kinetic inductance detectors (KIDs) and auxiliary instrument data to generate a variety of data products. We present an on-sky calibration method for converting the KID fractional frequency shift to on-sky brightness temperature. The mapmaking module generates 3D data cubes of extended sources, while the spectrum module produces a millimeter-wave spectrum of an object. The observations all incorporate measurements of the atmosphere to model and correct for absorption. We also discuss data processing choices including detector weighting, despiking, and notch filtering. Finally, we present preliminary data products including detection of carbon monoxide in NGC 253 and spectral maps of the central region of the Orion KL nebula."},{"descriptionType":"Other","description":"12 pages, 8 figures, submitted to the 2026 Society of Photo-Optical Instrumentation Engineers Astronomical Telescopes + Instrumentation (SPIE Astronomical Telescopes + Instrumentation 2026) proceedings"}],"geoLocations":[],"fundingReferences":[],"url":"https://arxiv.org/abs/2608.03790","contentUrl":null,"metadataVersion":0,"schemaVersion":"http://datacite.org/schema/kernel-4","source":"mds","isActive":true,"state":"findable","reason":null,"viewCount":0,"downloadCount":0,"referenceCount":0,"citationCount":0,"partCount":0,"partOfCount":0,"versionCount":0,"versionOfCount":0,"created":"2026-08-05T02:21:02Z","registered":"2026-08-05T02:21:02Z","published":null,"updated":"2026-08-05T02:21:02Z"},"relationships":{"client":{"data":{"id":"arxiv.content","type":"clients"}}}},{"id":"10.48550/arxiv.2608.03788","type":"dois","attributes":{"doi":"10.48550/arxiv.2608.03788","identifiers":[{"identifier":"2608.03788","identifierType":"arXiv"}],"creators":[{"nameType":"Personal","givenName":"Aman","familyName":"Ray","name":"Ray, Aman","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Srikanth","familyName":"Pai","name":"Pai, Srikanth","affiliation":[],"nameIdentifiers":[]}],"titles":[{"title":"When Does Party Convergence Persist under Alienation-Based Abstention?"}],"publisher":"arXiv","container":{},"publicationYear":2026,"subjects":[{"subject":"Theoretical Economics (econ.TH)","lang":"en","subjectScheme":"arXiv"},{"subject":"Optimization and Control (math.OC)","lang":"en","subjectScheme":"arXiv"},{"subject":"FOS: Economics and business","subjectScheme":"Fields of Science and Technology (FOS)"},{"subject":"FOS: Mathematics","subjectScheme":"Fields of Science and Technology (FOS)"},{"subject":"91B12, 91A10","lang":"en","subjectScheme":"MSC"}],"contributors":[],"dates":[{"date":"2026-08-04T15:05:27Z","dateType":"Submitted","dateInformation":"v1"},{"date":"2026-08-05T01:00:29Z","dateType":"Updated","dateInformation":"v1"},{"date":"2026-08","dateType":"Available","dateInformation":"v1"}],"language":null,"types":{"schemaOrg":"CreativeWork","resourceTypeGeneral":"Preprint","citeproc":"article","bibtex":"misc","ris":"GEN","resourceType":"Article"},"relatedIdentifiers":[],"relatedItems":[],"sizes":[],"formats":[],"version":"1","rightsList":[{"rightsUri":"http://arxiv.org/licenses/nonexclusive-distrib/1.0/","rights":"arXiv.org perpetual, non-exclusive license"}],"descriptions":[{"descriptionType":"Abstract","description":"In the standard Downsian model, two office-seeking parties converge to the median voter. However alienated voters may abstain and turn out only for a party within their tolerance radius. For single-peaked voter distributions, convergence survives but relocates to a central voter, the median of the electorate that participates at the convergent platform. However single-peakedness of the voter distribution is an empirically contested assumption. So we first characterize pure-strategy equilibrium for any continuous voter distribution. For general distributions, pure-strategy equilibrium can fail to exist or be non-unique, and existence of equilibrium need not persist as the tolerance radius of the voters increases. In order to resolve these issues, we propose a fundamental object: \\emph{centripetal} structure for which there is a single anchor platform toward which competition always pulls. We show this structure produces convergence at equilibrium under alienation based abstention. Our main result concerns the emergence and persistence of this new structure as the tolerance radius increases. Even though equilibria for office-seeking parties themselves can vanish and reappear as the radius grows, once centripetal structure emerges, it persists as long as the midpoint voter is not alienated. Moreover, the centripetal structure always emerges, and this structure classifies equilibrium completely when parties are policy motivated."},{"descriptionType":"Other","description":"51 pages, 6 figures"}],"geoLocations":[],"fundingReferences":[],"url":"https://arxiv.org/abs/2608.03788","contentUrl":null,"metadataVersion":0,"schemaVersion":"http://datacite.org/schema/kernel-4","source":"mds","isActive":true,"state":"findable","reason":null,"viewCount":0,"downloadCount":0,"referenceCount":0,"citationCount":0,"partCount":0,"partOfCount":0,"versionCount":0,"versionOfCount":0,"created":"2026-08-05T02:20:59Z","registered":"2026-08-05T02:21:00Z","published":null,"updated":"2026-08-05T02:21:00Z"},"relationships":{"client":{"data":{"id":"arxiv.content","type":"clients"}}}},{"id":"10.48550/arxiv.2608.03787","type":"dois","attributes":{"doi":"10.48550/arxiv.2608.03787","identifiers":[{"identifier":"2608.03787","identifierType":"arXiv"}],"creators":[{"nameType":"Personal","givenName":"Chuang","familyName":"Luo","name":"Luo, Chuang","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Gui","familyName":"Zhou","name":"Zhou, Gui","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Vasilis K.","familyName":"Papanikolaou","name":"Papanikolaou, Vasilis K.","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Yingzhuang","familyName":"Liu","name":"Liu, Yingzhuang","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Robert Caiming","familyName":"Qiu","name":"Qiu, Robert Caiming","affiliation":[],"nameIdentifiers":[]}],"titles":[{"title":"CMT-Aware Channel Modeling and Transmit-Power Minimization for Pinching-Antenna Systems"}],"publisher":"arXiv","container":{},"publicationYear":2026,"subjects":[{"subject":"Signal Processing (eess.SP)","lang":"en","subjectScheme":"arXiv"},{"subject":"FOS: Electrical engineering, electronic engineering, information engineering","subjectScheme":"Fields of Science and Technology (FOS)"}],"contributors":[],"dates":[{"date":"2026-08-04T15:05:27Z","dateType":"Submitted","dateInformation":"v1"},{"date":"2026-08-05T01:00:28Z","dateType":"Updated","dateInformation":"v1"},{"date":"2026-08","dateType":"Available","dateInformation":"v1"}],"language":null,"types":{"schemaOrg":"CreativeWork","resourceTypeGeneral":"Preprint","citeproc":"article","bibtex":"misc","ris":"GEN","resourceType":"Article"},"relatedIdentifiers":[],"relatedItems":[],"sizes":[],"formats":[],"version":"1","rightsList":[{"rightsUri":"http://arxiv.org/licenses/nonexclusive-distrib/1.0/","rights":"arXiv.org perpetual, non-exclusive license"}],"descriptions":[{"descriptionType":"Abstract","description":"This letter investigates transmit-power minimization for multiuser pinching-antenna system (PAS) from a coupled-mode-theory (CMT)-aware perspective. Existing CMT-based pinching antenna (PA) studies reveal coupling-induced power exchange and radiation behavior, but these effects have not been fully embedded into system-level multi-PA channel modeling and beamforming design. We therefore develop a directional and loss-aware channel model that captures coupling-length-dependent power extraction and the downstream guided-power reduction caused by in-waveguide attenuation and upstream extraction. The model shows that PA design should account for both directional radiation and guided-power evolution, rather than only propagation distance or maximum coupling considered in most existing works. Based on this channel model, we formulate a quality-of-service (QoS)-constrained power minimization problem for continuous PA positioning and finite-codebook activation. For each candidate coupling length, the element-wise positioning and BPSO-based activation use a closed-form zero-forcing (ZF) power metric for low-complexity configuration ranking, thereby avoiding repeated beamforming optimization while excluding rank-deficient candidates and ordering the remaining ones. The selected configuration for each coupling length is then evaluated by optimal fixed-configuration QoS beamforming. Simulation results demonstrate that CMT-aware modeling fundamentally reshapes the preferred PA configuration, maximum coupling is not always power-efficient due to suppressed downstream PA contributions, and finite-codebook activation combined with ZF-based ranking provides a balance between transmit-power performance and deployment complexity."},{"descriptionType":"Other","description":"5 pages, 5 figures"}],"geoLocations":[],"fundingReferences":[],"url":"https://arxiv.org/abs/2608.03787","contentUrl":null,"metadataVersion":0,"schemaVersion":"http://datacite.org/schema/kernel-4","source":"mds","isActive":true,"state":"findable","reason":null,"viewCount":0,"downloadCount":0,"referenceCount":0,"citationCount":0,"partCount":0,"partOfCount":0,"versionCount":0,"versionOfCount":0,"created":"2026-08-05T02:20:57Z","registered":"2026-08-05T02:20:58Z","published":null,"updated":"2026-08-05T02:20:58Z"},"relationships":{"client":{"data":{"id":"arxiv.content","type":"clients"}}}},{"id":"10.48550/arxiv.2608.03786","type":"dois","attributes":{"doi":"10.48550/arxiv.2608.03786","identifiers":[{"identifier":"2608.03786","identifierType":"arXiv"}],"creators":[{"nameType":"Personal","givenName":"Tsutomu","familyName":"Momoi","name":"Momoi, Tsutomu","affiliation":[],"nameIdentifiers":[]}],"titles":[{"title":"Antisymmetric Dynamical Spin Correlations: Spin-Space-Group Constraints and Frequency-Moment Sum Rules"}],"publisher":"arXiv","container":{},"publicationYear":2026,"subjects":[{"subject":"Strongly Correlated Electrons (cond-mat.str-el)","lang":"en","subjectScheme":"arXiv"},{"subject":"FOS: Physical sciences","subjectScheme":"Fields of Science and Technology (FOS)"}],"contributors":[],"dates":[{"date":"2026-08-04T15:05:04Z","dateType":"Submitted","dateInformation":"v1"},{"date":"2026-08-05T01:00:27Z","dateType":"Updated","dateInformation":"v1"},{"date":"2026-08","dateType":"Available","dateInformation":"v1"}],"language":null,"types":{"schemaOrg":"CreativeWork","resourceTypeGeneral":"Preprint","citeproc":"article","bibtex":"misc","ris":"GEN","resourceType":"Article"},"relatedIdentifiers":[],"relatedItems":[],"sizes":[],"formats":[],"version":"1","rightsList":[{"rightsUri":"http://arxiv.org/licenses/nonexclusive-distrib/1.0/","rights":"arXiv.org perpetual, non-exclusive license"}],"descriptions":[{"descriptionType":"Abstract","description":"Polarized inelastic neutron scattering probes the handedness of magnetic excitations through the spin-component-antisymmetric part of the dynamical spin-structure-factor tensor. We derive its symmetry constraints under unitary and antiunitary residual operations of magnetic space groups and spin-space groups. These constraints determine the allowed tensor components, their parity under momentum reversal, and symmetry-enforced nodes. We then introduce the corresponding antisymmetric commutator spectral function and derive exact zero-temperature sum rules for its frequency moments. The zeroth moment is fixed by the uniform magnetization. For Heisenberg or XXZ exchange Hamiltonians, the first moment of the $xy$ component is fixed by a momentum-weighted static vector chirality. For compensated collinear antiferromagnets, the antisymmetric dynamical structure factor is forbidden when inversion or a translation relates the opposite-spin sublattices. In rotation-related altermagnets, however, an $xy$ component that is even under momentum reversal is allowed at generic wave vectors. Finite antisymmetric spectral weight can therefore coexist with vanishing zeroth and first moments of the commutator spectral function. In a planar helix, by contrast, a residual antiunitary spin-space-group symmetry makes the allowed $xy$ component odd under momentum reversal. Its first moment is generally nonzero and is fixed by a momentum-weighted static vector chirality through the first-moment sum rule. Linear spin-wave calculations for representative altermagnetic and helical models explicitly realize these symmetry and sum-rule constraints."},{"descriptionType":"Other","description":"13 pages, 1 figure"}],"geoLocations":[],"fundingReferences":[],"url":"https://arxiv.org/abs/2608.03786","contentUrl":null,"metadataVersion":0,"schemaVersion":"http://datacite.org/schema/kernel-4","source":"mds","isActive":true,"state":"findable","reason":null,"viewCount":0,"downloadCount":0,"referenceCount":0,"citationCount":0,"partCount":0,"partOfCount":0,"versionCount":0,"versionOfCount":0,"created":"2026-08-05T02:20:56Z","registered":"2026-08-05T02:20:57Z","published":null,"updated":"2026-08-05T02:20:57Z"},"relationships":{"client":{"data":{"id":"arxiv.content","type":"clients"}}}},{"id":"10.48550/arxiv.2608.03785","type":"dois","attributes":{"doi":"10.48550/arxiv.2608.03785","identifiers":[{"identifier":"2608.03785","identifierType":"arXiv"}],"creators":[{"nameType":"Personal","givenName":"Antonio","familyName":"De Nicola","name":"De Nicola, Antonio","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Fabrizio","familyName":"Pugliese","name":"Pugliese, Fabrizio","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Luca","familyName":"Vitagliano","name":"Vitagliano, Luca","affiliation":[],"nameIdentifiers":[]}],"titles":[{"title":"On Homogeneous Kähler Manifolds"}],"publisher":"arXiv","container":{},"publicationYear":2026,"subjects":[{"subject":"Differential Geometry (math.DG)","lang":"en","subjectScheme":"arXiv"},{"subject":"FOS: Mathematics","subjectScheme":"Fields of Science and Technology (FOS)"}],"contributors":[],"dates":[{"date":"2026-08-04T15:04:56Z","dateType":"Submitted","dateInformation":"v1"},{"date":"2026-08-05T01:00:26Z","dateType":"Updated","dateInformation":"v1"},{"date":"2026-08","dateType":"Available","dateInformation":"v1"}],"language":null,"types":{"schemaOrg":"CreativeWork","resourceTypeGeneral":"Preprint","citeproc":"article","bibtex":"misc","ris":"GEN","resourceType":"Article"},"relatedIdentifiers":[],"relatedItems":[],"sizes":[],"formats":[],"version":"1","rightsList":[{"rightsUri":"http://arxiv.org/licenses/nonexclusive-distrib/1.0/","rights":"arXiv.org perpetual, non-exclusive license"}],"descriptions":[{"descriptionType":"Abstract","description":"The cone $M \\times \\mathbb{R}_+$ over a Sasakian manifold $M$ is equipped with a canonical Kähler structure with specific homogeneity properties with respect to the $\\mathbb{R}_+$ coordinate. This Kähler structure completely encodes the underlying Sasakian structure. Recently, Grabowski, Grabowska and Mohseni provided a broader conceptual framework for this phenomenon via homogeneous Kähler structures, i.e. Kähler structures on a principal $\\mathbb{R}^\\times$-bundle $P$ satisfying similar homogeneity properties. This approach successfully extends Sasakian geometry from cooriented contact manifolds (where $P$ is a trivial principal bundle) to non-necessarily coorientable contact structures (where $P$ is non-necessarily trivial). Homogeneous Kähler structures are genuinely more general than Sasakian structures and this note precisely characterizes the extent of this generalization. This is achieved through a detailed analysis of all the involved compatibilities in terms of the line bundle tautologically associated to $P$. We also show that modifying the homogeneity condition on the Kähler structure allows this framework to encompass co-Kähler structures and a natural generalization of those as well."},{"descriptionType":"Other","description":"31 pages. Comments are welcome!"}],"geoLocations":[],"fundingReferences":[],"url":"https://arxiv.org/abs/2608.03785","contentUrl":null,"metadataVersion":0,"schemaVersion":"http://datacite.org/schema/kernel-4","source":"mds","isActive":true,"state":"findable","reason":null,"viewCount":0,"downloadCount":0,"referenceCount":0,"citationCount":0,"partCount":0,"partOfCount":0,"versionCount":0,"versionOfCount":0,"created":"2026-08-05T02:20:55Z","registered":"2026-08-05T02:20:55Z","published":null,"updated":"2026-08-05T02:20:55Z"},"relationships":{"client":{"data":{"id":"arxiv.content","type":"clients"}}}},{"id":"10.48550/arxiv.2608.03784","type":"dois","attributes":{"doi":"10.48550/arxiv.2608.03784","identifiers":[{"identifier":"2608.03784","identifierType":"arXiv"}],"creators":[{"nameType":"Personal","givenName":"Ronja","familyName":"Hotz","name":"Hotz, Ronja","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Thomas","familyName":"Schmitt","name":"Schmitt, Thomas","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Calum","familyName":"Brown","name":"Brown, Calum","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Yongchao","familyName":"Zeng","name":"Zeng, Yongchao","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Mark","familyName":"Rounsevell","name":"Rounsevell, Mark","affiliation":[],"nameIdentifiers":[]}],"titles":[{"title":"Empirical behavioural heterogeneity shapes the dynamics of an agent-based land use model"}],"publisher":"arXiv","container":{},"publicationYear":2026,"subjects":[{"subject":"Computational Engineering, Finance, and Science (cs.CE)","lang":"en","subjectScheme":"arXiv"},{"subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"}],"contributors":[],"dates":[{"date":"2026-08-04T15:04:51Z","dateType":"Submitted","dateInformation":"v1"},{"date":"2026-08-05T01:00:25Z","dateType":"Updated","dateInformation":"v1"},{"date":"2026-08","dateType":"Available","dateInformation":"v1"}],"language":null,"types":{"schemaOrg":"CreativeWork","resourceTypeGeneral":"Preprint","citeproc":"article","bibtex":"misc","ris":"GEN","resourceType":"Article"},"relatedIdentifiers":[],"relatedItems":[],"sizes":[],"formats":[],"version":"1","rightsList":[{"rightsUri":"http://arxiv.org/licenses/nonexclusive-distrib/1.0/","rights":"arXiv.org perpetual, non-exclusive license"}],"descriptions":[{"descriptionType":"Abstract","description":"Land use models often represent decision-makers as homogeneous and rational, overlooking socio-psychological diversity and potentially generating rapid, coordinated land use responses that contrast with observed land use patterns. Here, we integrate an empirical typology of European forestry practitioners into an agent-based land use model by translating survey-based behavioural profiles into cognitive parameters governing endogenous decision-making processes. We distinguish five practitioner types and parametrise heterogeneous agent populations according to the empirically observed distribution of these types. Using a stylised model landscape, we compare these heterogeneous populations against a homogeneous rational-choice baseline and single-type populations. Compared with the homogeneous rational-choice baseline, heterogeneous populations dampen synchronised responses to changing ecosystem service demand, producing more gradual land use dynamics and a higher prevalence of medium intensity management, that better reflect empirical land use patterns. Our experiments reveal that similar land use patterns can emerge through different behavioural mechanisms, while the behaviour of individual decision-making types depends strongly on the population context in which they are embedded. Together, these two findings show that individual behavioural responses and land use outcomes co-evolve rather than decision-making types mapping onto fixed management practices. Explicitly representing socio-psychological diversity can therefore improve the realism and policy-relevance of agent-based land-use models by capturing feedbacks between cognition, social interactions, and emergent land use dynamics. Empirical data may make this representation possible, but models can also use this capability to explore behavioural heterogeneity as a key source of uncertainty when data are absent."},{"descriptionType":"Other","description":"30 pages, 24 figures. Submitted to SESMO"}],"geoLocations":[],"fundingReferences":[],"url":"https://arxiv.org/abs/2608.03784","contentUrl":null,"metadataVersion":0,"schemaVersion":"http://datacite.org/schema/kernel-4","source":"mds","isActive":true,"state":"findable","reason":null,"viewCount":0,"downloadCount":0,"referenceCount":0,"citationCount":0,"partCount":0,"partOfCount":0,"versionCount":0,"versionOfCount":0,"created":"2026-08-05T02:20:53Z","registered":"2026-08-05T02:20:54Z","published":null,"updated":"2026-08-05T02:20:54Z"},"relationships":{"client":{"data":{"id":"arxiv.content","type":"clients"}}}},{"id":"10.48550/arxiv.2608.03783","type":"dois","attributes":{"doi":"10.48550/arxiv.2608.03783","identifiers":[{"identifier":"2608.03783","identifierType":"arXiv"}],"creators":[{"nameType":"Personal","givenName":"Haiyang","familyName":"Miao","name":"Miao, Haiyang","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Jianhua","familyName":"Zhang","name":"Zhang, Jianhua","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Feifei","familyName":"Gao","name":"Gao, Feifei","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Pan","familyName":"Tang","name":"Tang, Pan","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Qi","familyName":"Zhen","name":"Zhen, Qi","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Mengxue","familyName":"Li","name":"Li, Mengxue","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Ping","familyName":"Zhao","name":"Zhao, Ping","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Shihao","familyName":"Zhang","name":"Zhang, Shihao","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Liang","familyName":"Xia","name":"Xia, Liang","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Guangyi","familyName":"Liu","name":"Liu, Guangyi","affiliation":[],"nameIdentifiers":[]}],"titles":[{"title":"New Mid-Band (FR3, 6-24 GHz) XL-MIMO for 6G: Channel Modeling, Algorithm Evaluation, and Field Trials"}],"publisher":"arXiv","container":{},"publicationYear":2026,"subjects":[{"subject":"Signal Processing (eess.SP)","lang":"en","subjectScheme":"arXiv"},{"subject":"FOS: Electrical engineering, electronic engineering, information engineering","subjectScheme":"Fields of Science and Technology (FOS)"}],"contributors":[],"dates":[{"date":"2026-08-04T15:04:22Z","dateType":"Submitted","dateInformation":"v1"},{"date":"2026-08-05T01:00:19Z","dateType":"Updated","dateInformation":"v1"},{"date":"2026-08","dateType":"Available","dateInformation":"v1"}],"language":null,"types":{"schemaOrg":"CreativeWork","resourceTypeGeneral":"Preprint","citeproc":"article","bibtex":"misc","ris":"GEN","resourceType":"Article"},"relatedIdentifiers":[],"relatedItems":[],"sizes":[],"formats":[],"version":"1","rightsList":[{"rightsUri":"http://arxiv.org/licenses/nonexclusive-distrib/1.0/","rights":"arXiv.org perpetual, non-exclusive license"}],"descriptions":[{"descriptionType":"Abstract","description":"The new mid-band (FR3, 6-24 GHz) spectrum is expected to play an important role in future 6G networks by providing a favorable balance among coverage, capacity, and deployment feasibility. Meanwhile, extremely large-scale multiple-input multiple-output (XL-MIMO) has emerged as a key enabling technology to exploit the propagation and spatial multiplexing potential of these frequency bands. Firstly, this paper provides a systematic review of spectrum allocation and standardization activities for new mid-band spectrum, together with the 6G spectrum planning strategies of countries and regions. Secondly, the wideband massive MIMO channel sounder is also introduced, which is specially developed for channel measurements of new mid-band with over a thousand elements. Thirdly, propagation characteristics and channel modeling approaches of four representative XL-MIMO architectures, including co-located, cell-free, and intelligent XL-MIMO, are comprehensively reviewed and analyzed, with particular emphasis on near-field propagation, spatial non-stationarity, and capacity performance. Then, recent advances in channel estimation, beamforming, and artificial-intelligence-assisted signal processing are summarized. In addition, the performance of new mid-band XL-MIMO systems equipped with 1536 and 768 antenna elements is comparatively evaluated. Finally, real communication environment prototype system field trials conducted in the Upper 6 GHz (U6GHz) band are used to investigate practical system performance under realistic deployment conditions. The results indicate that the target signal-to-noise ratio is a critical factor affecting XL-MIMO performance in the U6GHz band."}],"geoLocations":[],"fundingReferences":[],"url":"https://arxiv.org/abs/2608.03783","contentUrl":null,"metadataVersion":0,"schemaVersion":"http://datacite.org/schema/kernel-4","source":"mds","isActive":true,"state":"findable","reason":null,"viewCount":0,"downloadCount":0,"referenceCount":0,"citationCount":0,"partCount":0,"partOfCount":0,"versionCount":0,"versionOfCount":0,"created":"2026-08-05T02:20:52Z","registered":null,"published":null,"updated":"2026-08-05T02:20:52Z"},"relationships":{"client":{"data":{"id":"arxiv.content","type":"clients"}}}},{"id":"10.48550/arxiv.2608.03782","type":"dois","attributes":{"doi":"10.48550/arxiv.2608.03782","identifiers":[{"identifier":"2608.03782","identifierType":"arXiv"}],"creators":[{"nameType":"Personal","givenName":"Ruihan","familyName":"Li","name":"Li, Ruihan","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Jiyang","familyName":"Tan","name":"Tan, Jiyang","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Kailin","familyName":"Jiang","name":"Jiang, Kailin","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Huining","familyName":"Li","name":"Li, Huining","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Hengyang","familyName":"Lu","name":"Lu, Hengyang","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Yu","familyName":"Huang","name":"Huang, Yu","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Qian","familyName":"Li","name":"Li, Qian","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Yuntao","familyName":"Du","name":"Du, Yuntao","affiliation":[],"nameIdentifiers":[]}],"titles":[{"title":"KnowHal: A Knowledge-Driven Benchmark for Comprehensive Multimodal Hallucination Evaluation"}],"publisher":"arXiv","container":{},"publicationYear":2026,"subjects":[{"subject":"Artificial Intelligence (cs.AI)","lang":"en","subjectScheme":"arXiv"},{"subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"}],"contributors":[],"dates":[{"date":"2026-08-04T15:03:29Z","dateType":"Submitted","dateInformation":"v1"},{"date":"2026-08-05T01:00:18Z","dateType":"Updated","dateInformation":"v1"},{"date":"2026-08","dateType":"Available","dateInformation":"v1"}],"language":null,"types":{"schemaOrg":"CreativeWork","resourceTypeGeneral":"Preprint","citeproc":"article","bibtex":"misc","ris":"GEN","resourceType":"Article"},"relatedIdentifiers":[],"relatedItems":[],"sizes":[],"formats":[],"version":"1","rightsList":[{"rightsIdentifierScheme":"SPDX","rightsUri":"https://creativecommons.org/licenses/by/4.0/legalcode","schemeUri":"https://spdx.org/licenses/","rights":"Creative Commons Attribution 4.0 International","rightsIdentifier":"cc-by-4.0"}],"descriptions":[{"descriptionType":"Abstract","description":"Hallucination remains a critical challenge for developing trustworthy Multimodal Large Language Models (MLLMs). While existing benchmarks mainly focus on entity, attribute, and relation hallucinations, knowledge-related failures are often investigated separately, lacking a unified evaluation framework across different hallucination dimensions. To overcome this, we propose \\textbf{KnowHal}, a benchmark that explicitly incorporates knowledge hallucination into multimodal hallucination evaluation spanning four dimensions: entity, attribute, relation, and knowledge. KnowHal constructs paired positive and negative questions over shared images and entities, enabling controlled comparisons among perceptual errors, knowledge-related errors, and false-premise acceptance. The benchmark contains 1,800 samples across 10 domains and 50 categories, constructed through a semi-automated pipeline combining LLM assistance, CLIP-based filtering, and human verification. We evaluate 14 representative MLLMs on KnowHal and conduct extensive analyses. Results show that the knowledge dimension consistently presents the greatest challenge for nearly all evaluated models, while most models exhibit substantial performance degradation on negative questions, revealing limited robustness to false premises. By unifying four hallucination dimensions with paired question design, KnowHal addresses an important gap in existing evaluation frameworks and enables a more comprehensive assessment of hallucinations in MLLMs."},{"descriptionType":"Other","description":"9 pages, 7 figures"}],"geoLocations":[],"fundingReferences":[],"url":"https://arxiv.org/abs/2608.03782","contentUrl":null,"metadataVersion":0,"schemaVersion":"http://datacite.org/schema/kernel-4","source":"mds","isActive":true,"state":"findable","reason":null,"viewCount":0,"downloadCount":0,"referenceCount":0,"citationCount":0,"partCount":0,"partOfCount":0,"versionCount":0,"versionOfCount":0,"created":"2026-08-05T02:20:50Z","registered":"2026-08-05T02:20:51Z","published":null,"updated":"2026-08-05T02:20:51Z"},"relationships":{"client":{"data":{"id":"arxiv.content","type":"clients"}}}},{"id":"10.48550/arxiv.2608.03781","type":"dois","attributes":{"doi":"10.48550/arxiv.2608.03781","identifiers":[{"identifier":"2608.03781","identifierType":"arXiv"}],"creators":[{"nameType":"Personal","givenName":"Olivier","familyName":"Pironneau","name":"Pironneau, Olivier","affiliation":[],"nameIdentifiers":[]}],"titles":[{"title":"Collimated Sunlight and Air Temperature"}],"publisher":"arXiv","container":{},"publicationYear":2026,"subjects":[{"subject":"Numerical Analysis (math.NA)","lang":"en","subjectScheme":"arXiv"},{"subject":"Mathematical Physics (math-ph)","lang":"en","subjectScheme":"arXiv"},{"subject":"FOS: Mathematics","subjectScheme":"Fields of Science and Technology (FOS)"},{"subject":"FOS: Physical sciences","subjectScheme":"Fields of Science and Technology (FOS)"},{"subject":"3510, 35Q35, 35Q85, 80A21, 80M10","lang":"en","subjectScheme":"MSC"}],"contributors":[],"dates":[{"date":"2026-08-04T15:02:25Z","dateType":"Submitted","dateInformation":"v1"},{"date":"2026-08-05T01:00:17Z","dateType":"Updated","dateInformation":"v1"},{"date":"2026-08","dateType":"Available","dateInformation":"v1"}],"language":null,"types":{"schemaOrg":"CreativeWork","resourceTypeGeneral":"Preprint","citeproc":"article","bibtex":"misc","ris":"GEN","resourceType":"Article"},"relatedIdentifiers":[],"relatedItems":[],"sizes":[],"formats":[],"version":"1","rightsList":[{"rightsIdentifierScheme":"SPDX","rightsUri":"https://creativecommons.org/licenses/by/4.0/legalcode","schemeUri":"https://spdx.org/licenses/","rights":"Creative Commons Attribution 4.0 International","rightsIdentifier":"cc-by-4.0"}],"descriptions":[{"descriptionType":"Abstract","description":"Atmospheric temperature on Earth results from complex phenomena that climate models must account for. One important module is radiation, which has three sources: infrared radiation emitted by the Earth and the air, and visible light from the Sun. The latter arrives from an almost point-like source in the sky, producing a Dirac singularity in the boundary conditions known as collimated light. Following Siewert and Maiorino (1980), we propose a very fast numerical implementation to handle the singularity."},{"descriptionType":"Other","description":"12 pages 5 figures, for a conference next year in Tbilissi"}],"geoLocations":[],"fundingReferences":[],"url":"https://arxiv.org/abs/2608.03781","contentUrl":null,"metadataVersion":0,"schemaVersion":"http://datacite.org/schema/kernel-4","source":"mds","isActive":true,"state":"findable","reason":null,"viewCount":0,"downloadCount":0,"referenceCount":0,"citationCount":0,"partCount":0,"partOfCount":0,"versionCount":0,"versionOfCount":0,"created":"2026-08-05T02:20:49Z","registered":"2026-08-05T02:20:49Z","published":null,"updated":"2026-08-05T02:20:49Z"},"relationships":{"client":{"data":{"id":"arxiv.content","type":"clients"}}}},{"id":"10.48550/arxiv.2608.03780","type":"dois","attributes":{"doi":"10.48550/arxiv.2608.03780","identifiers":[{"identifier":"2608.03780","identifierType":"arXiv"}],"creators":[{"nameType":"Personal","givenName":"Chi","familyName":"Zhang","name":"Zhang, Chi","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Chuanfei","familyName":"Dong","name":"Dong, Chuanfei","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Gangkai","familyName":"Poh","name":"Poh, Gangkai","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Jasper","familyName":"Halekas","name":"Halekas, Jasper","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Xuanye","familyName":"Ma","name":"Ma, Xuanye","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Ruhunusiri","familyName":"Suranga","name":"Suranga, Ruhunusiri","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Kathleen G.","familyName":"Hanley","name":"Hanley, Kathleen G.","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Han-Wen","familyName":"Shen","name":"Shen, Han-Wen","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Hongyang","familyName":"Zhou","name":"Zhou, Hongyang","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Xinmin","familyName":"Li","name":"Li, Xinmin","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Liang","familyName":"Wang","name":"Wang, Liang","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Jiawei","familyName":"Gao","name":"Gao, Jiawei","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Shannon","familyName":"Curry","name":"Curry, Shannon","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Christian","familyName":"Mazelle","name":"Mazelle, Christian","affiliation":[],"nameIdentifiers":[]}],"titles":[{"title":"Simultaneous Mars-orbit observations reveal Kelvin-Helmholtz instability-driven bulk atmospheric ion escape"}],"publisher":"arXiv","container":{},"publicationYear":2026,"subjects":[{"subject":"Space Physics (physics.space-ph)","lang":"en","subjectScheme":"arXiv"},{"subject":"Earth and Planetary Astrophysics (astro-ph.EP)","lang":"en","subjectScheme":"arXiv"},{"subject":"Plasma Physics (physics.plasm-ph)","lang":"en","subjectScheme":"arXiv"},{"subject":"FOS: Physical sciences","subjectScheme":"Fields of Science and Technology (FOS)"}],"contributors":[],"dates":[{"date":"2026-08-04T15:02:14Z","dateType":"Submitted","dateInformation":"v1"},{"date":"2026-08-05T01:00:16Z","dateType":"Updated","dateInformation":"v1"},{"date":"2026-08","dateType":"Available","dateInformation":"v1"}],"language":null,"types":{"schemaOrg":"CreativeWork","resourceTypeGeneral":"Preprint","citeproc":"article","bibtex":"misc","ris":"GEN","resourceType":"Article"},"relatedIdentifiers":[{"relationType":"IsVersionOf","relatedIdentifier":"10.1126/sciadv.aed9072","relatedIdentifierType":"DOI"}],"relatedItems":[],"sizes":[],"formats":[],"version":"1","rightsList":[{"rightsIdentifierScheme":"SPDX","rightsUri":"https://creativecommons.org/licenses/by-nc-sa/4.0/legalcode","schemeUri":"https://spdx.org/licenses/","rights":"Creative Commons Attribution Non Commercial Share Alike 4.0 International","rightsIdentifier":"cc-by-nc-sa-4.0"}],"descriptions":[{"descriptionType":"Abstract","description":"Atmospheric ion escape driven by the solar wind is a key process controlling the long-term loss of the Martian atmosphere. Localized plasma clouds can carry substantial fluxes of planetary ions away from Mars, representing episodes of bulk escape. However, their origin has remained unclear due to the absence of simultaneous upstream measurements. Using joint observations from the MAVEN and Tianwen-1 missions, which provide real-time upstream monitoring, we present direct evidence that these plasma clouds are nonlinear wave packets generated by the Kelvin-Helmholtz instability (KHI). The spatial scale of KH waves is constrained for the first time via two-point measurements. Ion fluxes within plasma clouds are one to two orders of magnitude higher than those in typical steady-state escape channels. Our results indicate that KHI is an important process for solar wind coupling to planetary upper atmospheres and plays a crucial role in shaping atmospheric ion escape for unmagnetized planets."}],"geoLocations":[],"fundingReferences":[],"url":"https://arxiv.org/abs/2608.03780","contentUrl":null,"metadataVersion":0,"schemaVersion":"http://datacite.org/schema/kernel-4","source":"mds","isActive":true,"state":"findable","reason":null,"viewCount":0,"downloadCount":0,"referenceCount":0,"citationCount":0,"partCount":0,"partOfCount":0,"versionCount":0,"versionOfCount":1,"created":"2026-08-05T02:20:47Z","registered":"2026-08-05T02:20:48Z","published":null,"updated":"2026-08-05T02:20:48Z"},"relationships":{"client":{"data":{"id":"arxiv.content","type":"clients"}}}},{"id":"10.48550/arxiv.2608.03779","type":"dois","attributes":{"doi":"10.48550/arxiv.2608.03779","identifiers":[{"identifier":"2608.03779","identifierType":"arXiv"}],"creators":[{"nameType":"Personal","givenName":"Yuxiang","familyName":"Duan","name":"Duan, Yuxiang","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Huining","familyName":"Li","name":"Li, Huining","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Ao","familyName":"Li","name":"Li, Ao","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Shuai","familyName":"Feng","name":"Feng, Shuai","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Lanju","familyName":"Kong","name":"Kong, Lanju","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Ning","familyName":"Liu","name":"Liu, Ning","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Jian","familyName":"Zhang","name":"Zhang, Jian","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Xingdong","familyName":"Sheng","name":"Sheng, Xingdong","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Yuntao","familyName":"Du","name":"Du, Yuntao","affiliation":[],"nameIdentifiers":[]}],"titles":[{"title":"AgenticVAU: Multi-Agent Explore-Verify Reasoning for Video Anomaly Understanding"}],"publisher":"arXiv","container":{},"publicationYear":2026,"subjects":[{"subject":"Computer Vision and Pattern Recognition (cs.CV)","lang":"en","subjectScheme":"arXiv"},{"subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"}],"contributors":[],"dates":[{"date":"2026-08-04T15:01:59Z","dateType":"Submitted","dateInformation":"v1"},{"date":"2026-08-05T01:00:14Z","dateType":"Updated","dateInformation":"v1"},{"date":"2026-08","dateType":"Available","dateInformation":"v1"}],"language":null,"types":{"schemaOrg":"CreativeWork","resourceTypeGeneral":"Preprint","citeproc":"article","bibtex":"misc","ris":"GEN","resourceType":"Article"},"relatedIdentifiers":[],"relatedItems":[],"sizes":[],"formats":[],"version":"1","rightsList":[{"rightsUri":"http://arxiv.org/licenses/nonexclusive-distrib/1.0/","rights":"arXiv.org perpetual, non-exclusive license"}],"descriptions":[{"descriptionType":"Abstract","description":"Video anomaly understanding (VAU) focuses on comprehensively interpreting abnormal events in videos, requiring models to identify anomalous occurrences, discover their supporting evidence, and explain the underlying causes beyond simple anomaly detection. Existing VAU methods often rely on specialized training or limited observations, restricting generalization or evidence coverage. Although single-agent alternatives support adaptive video observation, they still integrate exploration, observation, and decision-making within a unified reasoning process, offering limited role specialization and structured evidence coordination. To address these limitations, we present AgenticVAU, a training-free multi-agent framework that casts VAU as an explore--verify process, where the system first discovers potential anomalies and then verifies them through targeted observations. To achieve this, four specialized agents are introduced to handle visual-rule construction, search planning, video observation, and final decision, respectively. These agents communicate through an anchor registry, a shared evidence memory that binds each observation. Guided by this agent framework, AgenticVAU interleaves broad temporal exploration, dense local verification, and cross-interval comparison until sufficient evidence is collected. We conduct extensive experiments on the ECVA, UCF-Crime, and MSAD subsets of VAU-Bench, the results show that AgenticVAU outperforms zero-shot inference and reinforcement learning-based baselines, demonstrating the value of multi-agent collaboration for video anomaly understanding."}],"geoLocations":[],"fundingReferences":[],"url":"https://arxiv.org/abs/2608.03779","contentUrl":null,"metadataVersion":0,"schemaVersion":"http://datacite.org/schema/kernel-4","source":"mds","isActive":true,"state":"findable","reason":null,"viewCount":0,"downloadCount":0,"referenceCount":0,"citationCount":0,"partCount":0,"partOfCount":0,"versionCount":0,"versionOfCount":0,"created":"2026-08-05T02:20:46Z","registered":null,"published":null,"updated":"2026-08-05T02:20:46Z"},"relationships":{"client":{"data":{"id":"arxiv.content","type":"clients"}}}},{"id":"10.48550/arxiv.2608.03778","type":"dois","attributes":{"doi":"10.48550/arxiv.2608.03778","identifiers":[{"identifier":"2608.03778","identifierType":"arXiv"}],"creators":[{"nameType":"Personal","givenName":"Isaac","familyName":"Jacobson","name":"Jacobson, Isaac","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Zheng","familyName":"Zhao","name":"Zhao, Zheng","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Rashmi","familyName":"Mehrotra","name":"Mehrotra, Rashmi","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Guanglei","familyName":"Zhou","name":"Zhou, Guanglei","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Vineet","familyName":"Rashingkar","name":"Rashingkar, Vineet","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Yiran","familyName":"Chen","name":"Chen, Yiran","affiliation":[],"nameIdentifiers":[]}],"titles":[{"title":"DiffPower: GPU-Accelerated Differentiable Switching Power Analysis and Optimization"}],"publisher":"arXiv","container":{},"publicationYear":2026,"subjects":[{"subject":"Hardware Architecture (cs.AR)","lang":"en","subjectScheme":"arXiv"},{"subject":"Distributed, Parallel, and Cluster Computing (cs.DC)","lang":"en","subjectScheme":"arXiv"},{"subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"}],"contributors":[],"dates":[{"date":"2026-08-04T15:00:49Z","dateType":"Submitted","dateInformation":"v1"},{"date":"2026-08-05T01:00:10Z","dateType":"Updated","dateInformation":"v1"},{"date":"2026-08","dateType":"Available","dateInformation":"v1"}],"language":null,"types":{"schemaOrg":"CreativeWork","resourceTypeGeneral":"Preprint","citeproc":"article","bibtex":"misc","ris":"GEN","resourceType":"Article"},"relatedIdentifiers":[],"relatedItems":[],"sizes":[],"formats":[],"version":"1","rightsList":[{"rightsUri":"http://arxiv.org/licenses/nonexclusive-distrib/1.0/","rights":"arXiv.org perpetual, non-exclusive license"}],"descriptions":[{"descriptionType":"Abstract","description":"Accurate and scalable switching power analysis remains a critical bottleneck in modern physical design, often forcing a trade-off between computational speed and modeling fidelity. We present DiffPower, a GPU-accelerated framework for differentiable power analysis and optimization. DiffPower translates design netlists into a PDK-agnostic bytecode representation, enabling analytical gradient computation via reverse-mode automatic differentiation, achieving up to a $1{,}002\\times$ speedup over single-threaded CPU propagation on the largest evaluated design, with the GPU advantage growing with design scale. A hybrid propagation methodology fusing analytical modeling with parallel simulation achieves a median toggle-rate correlation of $r{=}0.96$ across ten industrial and benchmark designs. The resulting \\emph{power gradients}, computed up to $904\\times$ faster than CPU finite-difference methods with near-perfect rank agreement, enable two downstream applications: (1) gradient-weighted cell sizing, which achieves up to $2.98\\times$ improvement over local-power heuristics on industrial designs, with even stronger advantages at the 117K-cell scale where competing methods plateau; and (2) power virus generation via gradient ascent, which yields up to $2.13\\times$ higher transition-weighted power, replacing a search process that traditionally requires hours."}],"geoLocations":[],"fundingReferences":[],"url":"https://arxiv.org/abs/2608.03778","contentUrl":null,"metadataVersion":0,"schemaVersion":"http://datacite.org/schema/kernel-4","source":"mds","isActive":true,"state":"findable","reason":null,"viewCount":0,"downloadCount":0,"referenceCount":0,"citationCount":0,"partCount":0,"partOfCount":0,"versionCount":0,"versionOfCount":0,"created":"2026-08-05T02:20:45Z","registered":"2026-08-05T02:20:45Z","published":null,"updated":"2026-08-05T02:20:45Z"},"relationships":{"client":{"data":{"id":"arxiv.content","type":"clients"}}}},{"id":"10.48550/arxiv.2608.03777","type":"dois","attributes":{"doi":"10.48550/arxiv.2608.03777","identifiers":[{"identifier":"2608.03777","identifierType":"arXiv"}],"creators":[{"nameType":"Personal","givenName":"Kiyoji Huang","familyName":"Fujiwara","name":"Fujiwara, Kiyoji Huang","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Yujia","familyName":"Shi","name":"Shi, Yujia","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Thomas G.","familyName":"Wong","name":"Wong, Thomas G.","affiliation":[],"nameIdentifiers":[]}],"titles":[{"title":"Optimal and Deterministic Quantum Search on the Simplex of Complete Graphs"}],"publisher":"arXiv","container":{},"publicationYear":2026,"subjects":[{"subject":"Quantum Physics (quant-ph)","lang":"en","subjectScheme":"arXiv"},{"subject":"FOS: Physical sciences","subjectScheme":"Fields of Science and Technology (FOS)"}],"contributors":[],"dates":[{"date":"2026-08-04T15:00:39Z","dateType":"Submitted","dateInformation":"v1"},{"date":"2026-08-05T01:00:09Z","dateType":"Updated","dateInformation":"v1"},{"date":"2026-08","dateType":"Available","dateInformation":"v1"}],"language":null,"types":{"schemaOrg":"CreativeWork","resourceTypeGeneral":"Preprint","citeproc":"article","bibtex":"misc","ris":"GEN","resourceType":"Article"},"relatedIdentifiers":[],"relatedItems":[],"sizes":[],"formats":[],"version":"1","rightsList":[{"rightsUri":"http://arxiv.org/licenses/nonexclusive-distrib/1.0/","rights":"arXiv.org perpetual, non-exclusive license"}],"descriptions":[{"descriptionType":"Abstract","description":"The simplex of complete graphs, also known as the first-order truncated simplex lattice, is a network of $M+1$ identical complete graphs, each with $M$ vertices, such that each clique contains an edge or bridge to every other clique. It contains $N = M(M+1)$ vertices, and previous asymptotic results using a continuous-time quantum walk to search this graph for a single marked vertex have either numerically demonstrated an optimal runtime of $O(\\sqrt{N})$, or analytically proved a deterministic success probability of 1, but not both, even when the bridges are weighted. In this paper, we give the first analytical proof of optimal quantum search on this graph, proving that it occurs when the weight of the bridges equals $M$. In addition, we numerically show that the optimal runtime is achieved more broadly whenever the weight is at least $\\sqrt{M}$. Furthermore, the algorithm is also deterministic when the weight scales between $\\sqrt{M}$ and $M$, and this is the first example of quantum search on the simplex of complete graphs that is both asymptotically optimal and deterministic. In addition, for weights where the algorithm is nondeterministic, we give a way to find the marked vertex by inspecting neighboring vertices. Finally, while it is known that connectivity is not a reliable indicator of fast quantum search when comparing different graph families, we show that it is also unreliable within the graph family of weighted simplex of complete graphs."},{"descriptionType":"Other","description":"37 pages, 22 figures"}],"geoLocations":[],"fundingReferences":[],"url":"https://arxiv.org/abs/2608.03777","contentUrl":null,"metadataVersion":0,"schemaVersion":"http://datacite.org/schema/kernel-4","source":"mds","isActive":true,"state":"findable","reason":null,"viewCount":0,"downloadCount":0,"referenceCount":0,"citationCount":0,"partCount":0,"partOfCount":0,"versionCount":0,"versionOfCount":0,"created":"2026-08-05T02:20:43Z","registered":"2026-08-05T02:20:44Z","published":null,"updated":"2026-08-05T02:20:44Z"},"relationships":{"client":{"data":{"id":"arxiv.content","type":"clients"}}}},{"id":"10.48550/arxiv.2608.03776","type":"dois","attributes":{"doi":"10.48550/arxiv.2608.03776","identifiers":[{"identifier":"2608.03776","identifierType":"arXiv"}],"creators":[{"nameType":"Personal","givenName":"Ryan J.","familyName":"Campbell","name":"Campbell, Ryan J.","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Carlos Quintero","familyName":"Noda","name":"Noda, Carlos Quintero","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Manuel","familyName":"Collados","name":"Collados, Manuel","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Mihalis","familyName":"Mathioudakis","name":"Mathioudakis, Mihalis","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Andreas","familyName":"Lagg","name":"Lagg, Andreas","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Achim","familyName":"Gandorfer","name":"Gandorfer, Achim","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Jose Carlos del Toro","familyName":"Iniesta","name":"Iniesta, Jose Carlos del Toro","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Yukio","familyName":"Katsukawa","name":"Katsukawa, Yukio","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Pietro","familyName":"Bernasconi","name":"Bernasconi, Pietro","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Thomas","familyName":"Berkefeld","name":"Berkefeld, Thomas","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Alex","familyName":"Feller","name":"Feller, Alex","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Tino L.","familyName":"Riethmüller","name":"Riethmüller, Tino L.","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Alberto","familyName":"Álvarez-Herrero","name":"Álvarez-Herrero, Alberto","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Masahito","familyName":"Kubo","name":"Kubo, Masahito","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"H. N.","familyName":"Smitha","name":"Smitha, H. N.","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"David Orozco","familyName":"Suárez","name":"Suárez, David Orozco","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Bianca","familyName":"Grauf","name":"Grauf, Bianca","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Michael","familyName":"Carpenter","name":"Carpenter, Michael","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Alexander","familyName":"Bell","name":"Bell, Alexander","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Valentín Martínez","familyName":"Pillet","name":"Pillet, Valentín Martínez","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Francisco Javier","familyName":"Bailén","name":"Bailén, Francisco Javier","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Julian Blanco","familyName":"Rodríguez","name":"Rodríguez, Julian Blanco","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Juan Sebastián Castellanos","familyName":"Durán","name":"Durán, Juan Sebastián Castellanos","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Edvarda","familyName":"Harnes","name":"Harnes, Edvarda","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Johannes","familyName":"Hölken","name":"Hölken, Johannes","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Francisco A.","familyName":"Iglesias","name":"Iglesias, Francisco A.","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Ryohtaroh T.","familyName":"Ishikawa","name":"Ishikawa, Ryohtaroh T.","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Yusuke","familyName":"Kawabata","name":"Kawabata, Yusuke","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Takuma","familyName":"Matsumoto","name":"Matsumoto, Takuma","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Takayoshi","familyName":"Oba","name":"Oba, Takayoshi","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Azaymi L.","familyName":"Siu-Tapia","name":"Siu-Tapia, Azaymi L.","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Hanna","familyName":"Strecker","name":"Strecker, Hanna","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Dušan","familyName":"Vukadinović","name":"Vukadinović, Dušan","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Hirohisa","familyName":"Hara","name":"Hara, Hirohisa","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Toshifumi","familyName":"Shimizu","name":"Shimizu, Toshifumi","affiliation":[],"nameIdentifiers":[]}],"titles":[{"title":"Horizontal Magnetic Fields Dominate the Quiet Sun Internetwork in Sunrise III Observations. Evidence from Traditional and Transformer-Based Inversions"}],"publisher":"arXiv","container":{},"publicationYear":2026,"subjects":[{"subject":"Solar and Stellar Astrophysics (astro-ph.SR)","lang":"en","subjectScheme":"arXiv"},{"subject":"FOS: Physical sciences","subjectScheme":"Fields of Science and Technology (FOS)"}],"contributors":[],"dates":[{"date":"2026-08-04T14:59:53Z","dateType":"Submitted","dateInformation":"v1"},{"date":"2026-08-05T01:00:07Z","dateType":"Updated","dateInformation":"v1"},{"date":"2026-08","dateType":"Available","dateInformation":"v1"}],"language":null,"types":{"schemaOrg":"CreativeWork","resourceTypeGeneral":"Preprint","citeproc":"article","bibtex":"misc","ris":"GEN","resourceType":"Article"},"relatedIdentifiers":[],"relatedItems":[],"sizes":[],"formats":[],"version":"1","rightsList":[{"rightsIdentifierScheme":"SPDX","rightsUri":"https://creativecommons.org/licenses/by/4.0/legalcode","schemeUri":"https://spdx.org/licenses/","rights":"Creative Commons Attribution 4.0 International","rightsIdentifier":"cc-by-4.0"}],"descriptions":[{"descriptionType":"Abstract","description":"The relative prevalence of horizontal and vertical magnetic fields in the quiet-Sun internetwork remains debated, owing to the weak linear polarisation signals that make the inferred magnetic inclination distributions sensitive to observational quality and inversion methodology. We investigate the magnetic topology of the quiet-Sun internetwork in {\\sc Sunrise~iii} observations by independently applying transformer-based and traditional inversion techniques to the same spectropolarimetric dataset. We analyse observations obtained with the Sunrise Chromospheric Infrared spectroPolarimeter (SCIP). Transformer-based inversions (SINN), trained exclusively on synthetic Stokes profiles generated from a large radiative magnetohydrodynamic simulation, are compared with independent inversions performed using the \\textsc{DeSIRe} code. Both inversion methods recover a quiet-Sun magnetic topology in which internetwork fields are strongly dominated by the horizontal component, whereas network fields exhibit a substantially more balanced topology. At $\\logτ=-1.2$, the median horizontal and unsigned line-of-sight field components in the internetwork are 64 and 7G with \\textsc{DeSIRe}, and 71 and 8G with SINN, respectively, corresponding to a horizontal-to-line-of-sight ratio of approximately nine for both methods. The agreement between the two fundamentally different inversion methodologies indicates that the quiet-Sun internetwork is characterised by a substantially stronger horizontal than vertical magnetic field component. These results demonstrate that transformer-based inversions can be successfully transferred from synthetic training data to real spectropolarimetric observations, while providing inference orders of magnitude faster than traditional inversion techniques."},{"descriptionType":"Other","description":"Submitted to A\u0026amp;A"}],"geoLocations":[],"fundingReferences":[],"url":"https://arxiv.org/abs/2608.03776","contentUrl":null,"metadataVersion":0,"schemaVersion":"http://datacite.org/schema/kernel-4","source":"mds","isActive":true,"state":"findable","reason":null,"viewCount":0,"downloadCount":0,"referenceCount":0,"citationCount":0,"partCount":0,"partOfCount":0,"versionCount":0,"versionOfCount":0,"created":"2026-08-05T02:20:42Z","registered":"2026-08-05T02:20:42Z","published":null,"updated":"2026-08-05T02:20:42Z"},"relationships":{"client":{"data":{"id":"arxiv.content","type":"clients"}}}},{"id":"10.48550/arxiv.2608.03775","type":"dois","attributes":{"doi":"10.48550/arxiv.2608.03775","identifiers":[{"identifier":"2608.03775","identifierType":"arXiv"}],"creators":[{"nameType":"Personal","givenName":"Ziyang","familyName":"Pan","name":"Pan, Ziyang","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Fan","familyName":"Bu","name":"Bu, Fan","affiliation":[],"nameIdentifiers":[]}],"titles":[{"title":"Multi-Signal Safety Surveillance with Bayesian Latent Factor Modeling and Bias Correction"}],"publisher":"arXiv","container":{},"publicationYear":2026,"subjects":[{"subject":"Methodology (stat.ME)","lang":"en","subjectScheme":"arXiv"},{"subject":"Applications (stat.AP)","lang":"en","subjectScheme":"arXiv"},{"subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"}],"contributors":[],"dates":[{"date":"2026-08-04T14:58:09Z","dateType":"Submitted","dateInformation":"v1"},{"date":"2026-08-05T00:59:58Z","dateType":"Updated","dateInformation":"v1"},{"date":"2026-08","dateType":"Available","dateInformation":"v1"}],"language":null,"types":{"schemaOrg":"CreativeWork","resourceTypeGeneral":"Preprint","citeproc":"article","bibtex":"misc","ris":"GEN","resourceType":"Article"},"relatedIdentifiers":[],"relatedItems":[],"sizes":[],"formats":[],"version":"1","rightsList":[{"rightsIdentifierScheme":"SPDX","rightsUri":"https://creativecommons.org/licenses/by-nc-nd/4.0/legalcode","schemeUri":"https://spdx.org/licenses/","rights":"Creative Commons Attribution Non Commercial No Derivatives 4.0 International","rightsIdentifier":"cc-by-nc-nd-4.0"}],"descriptions":[{"descriptionType":"Abstract","description":"Safety surveillance increasingly involves repeated monitoring of many exposure-outcome signals in observational healthcare data, where sparse information, dependence across related signals, and systematic error can complicate inference. Existing frameworks typically focus on either correcting residual bias using negative controls or borrowing information across exposure-outcome pairs, but not both. We propose a multi-signal Bayesian sequential surveillance framework that integrates empirical bias correction with low-rank latent factor modeling. At each analysis time, a hierarchical Bayesian model learns exposure-specific bias distributions from negative control outcomes assumed to have null latent effects. Conditional on these distributions, low-rank latent factors are estimated across exposures and outcomes of interest to share information across correlated signals. As new data accrue, posterior inference is updated sequentially, yielding bias-corrected posterior summaries of effect sizes across multiple monitored signals. We illustrate the method in a postmarket vaccine safety surveillance study using a large US insurance claims database."}],"geoLocations":[],"fundingReferences":[],"url":"https://arxiv.org/abs/2608.03775","contentUrl":null,"metadataVersion":0,"schemaVersion":"http://datacite.org/schema/kernel-4","source":"mds","isActive":true,"state":"findable","reason":null,"viewCount":0,"downloadCount":0,"referenceCount":0,"citationCount":0,"partCount":0,"partOfCount":0,"versionCount":0,"versionOfCount":0,"created":"2026-08-05T02:20:40Z","registered":"2026-08-05T02:20:41Z","published":null,"updated":"2026-08-05T02:20:41Z"},"relationships":{"client":{"data":{"id":"arxiv.content","type":"clients"}}}},{"id":"10.48550/arxiv.2608.03774","type":"dois","attributes":{"doi":"10.48550/arxiv.2608.03774","identifiers":[{"identifier":"2608.03774","identifierType":"arXiv"}],"creators":[{"nameType":"Personal","givenName":"Ananya","familyName":"Sharma","name":"Sharma, Ananya","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Divya","familyName":"Rathee","name":"Rathee, Divya","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Agam K.","familyName":"Jha","name":"Jha, Agam K.","affiliation":[],"nameIdentifiers":[]}],"titles":[{"title":"Formation of Quark-Gluon Plasma droplets under Ultra-Relativistic Heavy Ion Collisions in the presence of magnetic fields with a modified hadronic medium"}],"publisher":"arXiv","container":{},"publicationYear":2026,"subjects":[{"subject":"High Energy Physics - Phenomenology (hep-ph)","lang":"en","subjectScheme":"arXiv"},{"subject":"FOS: Physical sciences","subjectScheme":"Fields of Science and Technology (FOS)"}],"contributors":[],"dates":[{"date":"2026-08-04T14:57:17Z","dateType":"Submitted","dateInformation":"v1"},{"date":"2026-08-05T00:59:57Z","dateType":"Updated","dateInformation":"v1"},{"date":"2026-08","dateType":"Available","dateInformation":"v1"}],"language":null,"types":{"schemaOrg":"CreativeWork","resourceTypeGeneral":"Preprint","citeproc":"article","bibtex":"misc","ris":"GEN","resourceType":"Article"},"relatedIdentifiers":[],"relatedItems":[],"sizes":[],"formats":[],"version":"1","rightsList":[{"rightsUri":"http://arxiv.org/licenses/nonexclusive-distrib/1.0/","rights":"arXiv.org perpetual, non-exclusive license"}],"descriptions":[{"descriptionType":"Abstract","description":"We build upon the previous studies conducted in this domain using the density of states of various components of the quark-gluon plasma(QGP) modelled after the Thomas-Fermi and Bethe models. This study provides an analysis of the stability of the quark-gluon plasma droplet by the inclusion and variation of chemical potential and magnetic field. An effective mass term is included to account for both the rest mass and thermodynamic mass terms of the quarks and gluon. We also expand on the inclusion of a different meson, kaon, into the medium of the droplet. The analysis on these quantities is done by calculating the free energy of the system and examining it as a function of droplet radius, chemical potential and magnetic field to find conditions for stable droplet formation. We discover that a kaonic medium, along with a pre-existing pionic medium, provides greater stability to the system. At the same time, it is realised that the parameters of chemical potential and magnetic field, due to their opposing effect, help in containing the droplet. Further calculations on entropy and heat capacity yield information about the nature of the phase transition of the system. Our analysis and results are in accordance with lattice QCD simulations."},{"descriptionType":"Other","description":"20 Pages, 14 figures"}],"geoLocations":[],"fundingReferences":[],"url":"https://arxiv.org/abs/2608.03774","contentUrl":null,"metadataVersion":0,"schemaVersion":"http://datacite.org/schema/kernel-4","source":"mds","isActive":true,"state":"findable","reason":null,"viewCount":0,"downloadCount":0,"referenceCount":0,"citationCount":0,"partCount":0,"partOfCount":0,"versionCount":0,"versionOfCount":0,"created":"2026-08-05T02:20:39Z","registered":null,"published":null,"updated":"2026-08-05T02:20:40Z"},"relationships":{"client":{"data":{"id":"arxiv.content","type":"clients"}}}},{"id":"10.48550/arxiv.2608.03772","type":"dois","attributes":{"doi":"10.48550/arxiv.2608.03772","identifiers":[{"identifier":"2608.03772","identifierType":"arXiv"}],"creators":[{"nameType":"Personal","givenName":"Jannick","familyName":"Strobel","name":"Strobel, Jannick","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Muqsit","familyName":"Azeem","name":"Azeem, Muqsit","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Stefan","familyName":"Leue","name":"Leue, Stefan","affiliation":[],"nameIdentifiers":[]}],"titles":[{"title":"Computing Actual Causes for Neural Network Predictions under Structured Causal Inputs"}],"publisher":"arXiv","container":{},"publicationYear":2026,"subjects":[{"subject":"Artificial Intelligence (cs.AI)","lang":"en","subjectScheme":"arXiv"},{"subject":"Machine Learning (cs.LG)","lang":"en","subjectScheme":"arXiv"},{"subject":"Logic in Computer Science (cs.LO)","lang":"en","subjectScheme":"arXiv"},{"subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"}],"contributors":[],"dates":[{"date":"2026-08-04T14:57:06Z","dateType":"Submitted","dateInformation":"v1"},{"date":"2026-08-05T00:59:55Z","dateType":"Updated","dateInformation":"v1"},{"date":"2026-08","dateType":"Available","dateInformation":"v1"}],"language":null,"types":{"schemaOrg":"CreativeWork","resourceTypeGeneral":"Preprint","citeproc":"article","bibtex":"misc","ris":"GEN","resourceType":"Article"},"relatedIdentifiers":[],"relatedItems":[],"sizes":[],"formats":[],"version":"1","rightsList":[{"rightsIdentifierScheme":"SPDX","rightsUri":"https://creativecommons.org/licenses/by/4.0/legalcode","schemeUri":"https://spdx.org/licenses/","rights":"Creative Commons Attribution 4.0 International","rightsIdentifier":"cc-by-4.0"}],"descriptions":[{"descriptionType":"Abstract","description":"Explaining the predictions of neural networks is a central challenge in trustworthy AI. Existing explanation methods, such as those based on feature attribution or minimal sufficient sets, typically treat input features as independent, which can yield misleading explanations when inputs exhibit structured dependencies. We address this by formalizing explanations as Halpern-Pearl (HP) actual causes, modeling input dependencies using Boolean Structural Causal Models (SCMs). We compute HP causes by applying bound propagation and branch-and-bound techniques, while providing formal guarantees of completeness and minimality. Our experiments show that we substantially outperform brute-force and ILP baselines in scalability, and outperform heuristic search as graph size grows, computing all minimal actual causes on instances with search spaces of up to $2.3\\times10^{13}$ candidate (cause, contingency) pairs, on SCMs with up to 28 nodes, within a 180s per-instance budget. In a case study, we further show that ignoring input dependencies inflates the number of reported causes, 14.9% of which are spurious under our SCM."}],"geoLocations":[],"fundingReferences":[],"url":"https://arxiv.org/abs/2608.03772","contentUrl":null,"metadataVersion":0,"schemaVersion":"http://datacite.org/schema/kernel-4","source":"mds","isActive":true,"state":"findable","reason":null,"viewCount":0,"downloadCount":0,"referenceCount":0,"citationCount":0,"partCount":0,"partOfCount":0,"versionCount":0,"versionOfCount":0,"created":"2026-08-05T02:20:36Z","registered":"2026-08-05T02:20:37Z","published":null,"updated":"2026-08-05T02:20:37Z"},"relationships":{"client":{"data":{"id":"arxiv.content","type":"clients"}}}},{"id":"10.48550/arxiv.2608.03769","type":"dois","attributes":{"doi":"10.48550/arxiv.2608.03769","identifiers":[{"identifier":"2608.03769","identifierType":"arXiv"}],"creators":[{"nameType":"Personal","givenName":"Tong","familyName":"Ling","name":"Ling, Tong","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Hang","familyName":"Lei","name":"Lei, Hang","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Feng","familyName":"Xiao","name":"Xiao, Feng","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Changhui","familyName":"Sun","name":"Sun, Changhui","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Jiahang","familyName":"Xie","name":"Xie, Jiahang","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Hao","familyName":"Liu","name":"Liu, Hao","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Lu","familyName":"Liu","name":"Liu, Lu","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Yanlong","familyName":"Du","name":"Du, Yanlong","affiliation":[],"nameIdentifiers":[]}],"titles":[{"title":"MDLMPE: Distribution Aware Positional Encoding for Masked Diffusion Language Models"}],"publisher":"arXiv","container":{},"publicationYear":2026,"subjects":[{"subject":"Computation and Language (cs.CL)","lang":"en","subjectScheme":"arXiv"},{"subject":"Artificial Intelligence (cs.AI)","lang":"en","subjectScheme":"arXiv"},{"subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"}],"contributors":[],"dates":[{"date":"2026-08-04T14:54:14Z","dateType":"Submitted","dateInformation":"v1"},{"date":"2026-08-05T00:59:50Z","dateType":"Updated","dateInformation":"v1"},{"date":"2026-08","dateType":"Available","dateInformation":"v1"}],"language":null,"types":{"schemaOrg":"CreativeWork","resourceTypeGeneral":"Preprint","citeproc":"article","bibtex":"misc","ris":"GEN","resourceType":"Article"},"relatedIdentifiers":[],"relatedItems":[],"sizes":[],"formats":[],"version":"1","rightsList":[{"rightsUri":"http://arxiv.org/licenses/nonexclusive-distrib/1.0/","rights":"arXiv.org perpetual, non-exclusive license"}],"descriptions":[{"descriptionType":"Abstract","description":"Masked diffusion language models (MDLMs) enable parallel generation and bidirectional context modeling, but their positional context differs fundamentally from that of autoregressive (AR) models. Whereas AR decoding exposes a contiguous prefix, MDLM denoising produces dynamic, non-contiguous configurations of revealed and masked tokens. Conventional positional encodings such as RoPE capture sequence order and pairwise displacement but remain insensitive to this evolving token-availability structure. To address this limitation, we propose MDLMPE, a positional encoding designed specifically for masked diffusion. To the best of our knowledge, MDLMPE is the first method to make positional representations explicitly aware of the changing revealed/masked configuration. It represents token availability as a binary sequence, applies distance-aware Gaussian weighting, and projects the resulting pattern through a cosine basis to obtain distribution-aware positional features. These features are added to token embeddings and mapped by a lightweight MLP to angular offsets that modulate the standard RoPE phases. Extensive experiments on LLaDA and DREAM demonstrate that MDLMPE generally outperforms conventional positional encoding methods across supervised fine-tuning, pretraining, zero-shot evaluation, and block-diffusion settings. Further ablations show that the complete combination of availability state, Gaussian locality, spectral basis, and embedding injection yields the strongest result. These results establish the evolving token-availability distribution as a useful positional signal for masked diffusion language models."}],"geoLocations":[],"fundingReferences":[],"url":"https://arxiv.org/abs/2608.03769","contentUrl":null,"metadataVersion":0,"schemaVersion":"http://datacite.org/schema/kernel-4","source":"mds","isActive":true,"state":"findable","reason":null,"viewCount":0,"downloadCount":0,"referenceCount":0,"citationCount":0,"partCount":0,"partOfCount":0,"versionCount":0,"versionOfCount":0,"created":"2026-08-05T02:20:32Z","registered":"2026-08-05T02:20:33Z","published":null,"updated":"2026-08-05T02:20:33Z"},"relationships":{"client":{"data":{"id":"arxiv.content","type":"clients"}}}},{"id":"10.48550/arxiv.2608.03768","type":"dois","attributes":{"doi":"10.48550/arxiv.2608.03768","identifiers":[{"identifier":"2608.03768","identifierType":"arXiv"}],"creators":[{"nameType":"Personal","givenName":"S.","familyName":"Islam","name":"Islam, S.","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"V.","familyName":"Merupo","name":"Merupo, V.","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"C.","familyName":"Chamek","name":"Chamek, C.","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"M.","familyName":"Sassi","name":"Sassi, M.","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"C.","familyName":"Coinon","name":"Coinon, C.","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Y.","familyName":"Deblock","name":"Deblock, Y.","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"E.","familyName":"Okada","name":"Okada, E.","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"S.","familyName":"Lepilliet","name":"Lepilliet, S.","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"F.","familyName":"Braud","name":"Braud, F.","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Q.","familyName":"Fornasiero","name":"Fornasiero, Q.","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"G.","familyName":"Di Gioia","name":"Di Gioia, G.","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"M.","familyName":"Faucher","name":"Faucher, M.","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"G.","familyName":"Ducournau","name":"Ducournau, G.","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"G.","familyName":"Loas","name":"Loas, G.","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"S.","familyName":"Arscott","name":"Arscott, S.","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"E.","familyName":"Peytavit","name":"Peytavit, E.","affiliation":[],"nameIdentifiers":[]}],"titles":[{"title":"Circuit-Level Design, Modeling, and On-Wafer Characterization of a Coplanar THz Optoelectronic Mixer"}],"publisher":"arXiv","container":{},"publicationYear":2026,"subjects":[{"subject":"Applied Physics (physics.app-ph)","lang":"en","subjectScheme":"arXiv"},{"subject":"FOS: Physical sciences","subjectScheme":"Fields of Science and Technology (FOS)"}],"contributors":[],"dates":[{"date":"2026-08-04T14:54:06Z","dateType":"Submitted","dateInformation":"v1"},{"date":"2026-08-05T00:59:49Z","dateType":"Updated","dateInformation":"v1"},{"date":"2026-08","dateType":"Available","dateInformation":"v1"}],"language":null,"types":{"schemaOrg":"CreativeWork","resourceTypeGeneral":"Preprint","citeproc":"article","bibtex":"misc","ris":"GEN","resourceType":"Article"},"relatedIdentifiers":[],"relatedItems":[],"sizes":[],"formats":[],"version":"1","rightsList":[{"rightsUri":"http://arxiv.org/licenses/nonexclusive-distrib/1.0/","rights":"arXiv.org perpetual, non-exclusive license"}],"descriptions":[{"descriptionType":"Abstract","description":"We report the design, modeling, and on-wafer characterization of a photoconductive heterodyne mixer implemented as a true terahertz monolithic integrated circuit (TMIC). Unlike previous photoconductive heterodyne demonstrations, the proposed circuit is characterized using RF integrated circuit metrics including input return loss, RF/IF isolation, broadband impedance matching, and conversion loss.\n The mixer combines a microcavity photoconductor with a broadband coplanar matching network incorporating a Ti shunt resistor, an RF DC-blocking MIM capacitor, and an RF/IF decoupling capacitor. A circuit-level model including both the photoconductor and the distributed CPW accesses is developed and validated.\n The passive circuit is experimentally characterized up to 500 GHz using on-wafer VNA measurements and accurately reproduced by simulation. Under illumination, the model predicts an input reflection coefficient below -10 dB up to 215 GHz and better than -6.5 dB up to 500 GHz. Measured and simulated conversion losses agree within +/-1 dB over the entire 1-500 GHz range. Conversion loss varies from 22.5-25.5 dB below 320 GHz and 26-34 dB up to 500 GHz. The proposed TMIC demonstrates broadband operation and provides a validated circuit design methodology for future integrated THz photonic mixers."},{"descriptionType":"Other","description":"Submitted to IEEE Transactions on Terahertz Science and Technology. 11 pages, 11 figures"}],"geoLocations":[],"fundingReferences":[],"url":"https://arxiv.org/abs/2608.03768","contentUrl":null,"metadataVersion":0,"schemaVersion":"http://datacite.org/schema/kernel-4","source":"mds","isActive":true,"state":"findable","reason":null,"viewCount":0,"downloadCount":0,"referenceCount":0,"citationCount":0,"partCount":0,"partOfCount":0,"versionCount":0,"versionOfCount":0,"created":"2026-08-05T02:20:30Z","registered":null,"published":null,"updated":"2026-08-05T02:20:31Z"},"relationships":{"client":{"data":{"id":"arxiv.content","type":"clients"}}}},{"id":"10.48550/arxiv.2608.03767","type":"dois","attributes":{"doi":"10.48550/arxiv.2608.03767","identifiers":[{"identifier":"2608.03767","identifierType":"arXiv"}],"creators":[{"nameType":"Personal","givenName":"Jie","familyName":"Li","name":"Li, Jie","affiliation":[],"nameIdentifiers":[]}],"titles":[{"title":"Sharp Orlicz Endpoints for Spatial-Temporal Ergodic Averaging"}],"publisher":"arXiv","container":{},"publicationYear":2026,"subjects":[{"subject":"Dynamical Systems (math.DS)","lang":"en","subjectScheme":"arXiv"},{"subject":"FOS: Mathematics","subjectScheme":"Fields of Science and Technology (FOS)"},{"subject":"37A30, 42B25, 46E30","lang":"en","subjectScheme":"MSC"}],"contributors":[],"dates":[{"date":"2026-08-04T14:53:37Z","dateType":"Submitted","dateInformation":"v1"},{"date":"2026-08-05T00:59:48Z","dateType":"Updated","dateInformation":"v1"},{"date":"2026-08","dateType":"Available","dateInformation":"v1"}],"language":null,"types":{"schemaOrg":"CreativeWork","resourceTypeGeneral":"Preprint","citeproc":"article","bibtex":"misc","ris":"GEN","resourceType":"Article"},"relatedIdentifiers":[],"relatedItems":[],"sizes":[],"formats":[],"version":"1","rightsList":[{"rightsUri":"http://arxiv.org/licenses/nonexclusive-distrib/1.0/","rights":"arXiv.org perpetual, non-exclusive license"}],"descriptions":[{"descriptionType":"Abstract","description":"We study the composition of temporal ergodic averaging with spatial averaging over shrinking metric balls, and determine sharp Orlicz endpoints for the corresponding unrestricted joint limit. For consecutive Birkhoff averages normalized by $NΛ_q(N)$ ($q\\ge 0$), the sharp Orlicz endpoint is $L\\log_{q+1}L$. In particular, the ordinary case $q=0$ yields an $L\\log L$ local joint convergence theorem under the Lebesgue differentiation property alone, while $L^1$ fails even on the Euclidean interval, answering two questions of Young. The same $L\\log_{q+1}L$ endpoint holds for prime averages for every $q\\ge 1$. For arbitrary time sequences, $L\\log_qL$ always suffices at the same normalization $NΛ_q(N)$ ($q\\ge 1$), and this endpoint is sharp in the Orlicz sense for fixed-base exponential sequences $k^n$ ($k\\ge 2$) and for sequences with polynomial ratio separation, including $n!$.\n The positive results rest on a local stability principle: under the ball Lebesgue differentiation property, pointwise temporal convergence lifts to the local joint limit whenever the associated temporal maximal function admits an $L^1$ majorant. The additional logarithm in the regular-time case comes from lifting restricted logarithmic maximal estimates from sets to general functions. The arbitrary-sequence theorem uses a dyadic decomposition instead. The lower bounds are local $\\infty$-sweeping out constructions, obtained by weighted local sweeping out for polynomial-growth regular times, by residue constructions for polynomially ratio-separated sequences, and by digit constructions for fixed-base exponentials."},{"descriptionType":"Other","description":"64 pages"}],"geoLocations":[],"fundingReferences":[],"url":"https://arxiv.org/abs/2608.03767","contentUrl":null,"metadataVersion":0,"schemaVersion":"http://datacite.org/schema/kernel-4","source":"mds","isActive":true,"state":"findable","reason":null,"viewCount":0,"downloadCount":0,"referenceCount":0,"citationCount":0,"partCount":0,"partOfCount":0,"versionCount":0,"versionOfCount":0,"created":"2026-08-05T02:20:29Z","registered":"2026-08-05T02:20:29Z","published":null,"updated":"2026-08-05T02:20:29Z"},"relationships":{"client":{"data":{"id":"arxiv.content","type":"clients"}}}},{"id":"10.48550/arxiv.2608.03766","type":"dois","attributes":{"doi":"10.48550/arxiv.2608.03766","identifiers":[{"identifier":"2608.03766","identifierType":"arXiv"}],"creators":[{"nameType":"Personal","givenName":"Sora","familyName":"Miyashita","name":"Miyashita, Sora","affiliation":[],"nameIdentifiers":[]}],"titles":[{"title":"A Fitting criterion for quasi-Gorenstein local rings"}],"publisher":"arXiv","container":{},"publicationYear":2026,"subjects":[{"subject":"Commutative Algebra (math.AC)","lang":"en","subjectScheme":"arXiv"},{"subject":"FOS: Mathematics","subjectScheme":"Fields of Science and Technology (FOS)"},{"subject":"Primary 13C05, 13H10, Secondary 13D02","lang":"en","subjectScheme":"MSC"}],"contributors":[],"dates":[{"date":"2026-08-04T14:53:35Z","dateType":"Submitted","dateInformation":"v1"},{"date":"2026-08-05T00:59:48Z","dateType":"Updated","dateInformation":"v1"},{"date":"2026-08","dateType":"Available","dateInformation":"v1"}],"language":null,"types":{"schemaOrg":"CreativeWork","resourceTypeGeneral":"Preprint","citeproc":"article","bibtex":"misc","ris":"GEN","resourceType":"Article"},"relatedIdentifiers":[],"relatedItems":[],"sizes":[],"formats":[],"version":"1","rightsList":[{"rightsUri":"http://arxiv.org/licenses/nonexclusive-distrib/1.0/","rights":"arXiv.org perpetual, non-exclusive license"}],"descriptions":[{"descriptionType":"Abstract","description":"Let $(R,\\mathfrak m)$ be a Noetherian local ring admitting a canonical module $ω_R$. We prove that $R$ is quasi-Gorenstein if and only if $\\operatorname{Fitt}_1^R(ω_R)\\congω_R$. When $R$ is Cohen-Macaulay, the same condition characterizes the Gorenstein property, confirming an expectation of Eisenbud, Ficarra, Herzog, and Moradi and extending their result for canonical ideals in local Cohen--Macaulay domains of type at most two."},{"descriptionType":"Other","description":"4 pages, comments are welcome"}],"geoLocations":[],"fundingReferences":[],"url":"https://arxiv.org/abs/2608.03766","contentUrl":null,"metadataVersion":0,"schemaVersion":"http://datacite.org/schema/kernel-4","source":"mds","isActive":true,"state":"findable","reason":null,"viewCount":0,"downloadCount":0,"referenceCount":0,"citationCount":0,"partCount":0,"partOfCount":0,"versionCount":0,"versionOfCount":0,"created":"2026-08-05T02:20:27Z","registered":"2026-08-05T02:20:28Z","published":null,"updated":"2026-08-05T02:20:28Z"},"relationships":{"client":{"data":{"id":"arxiv.content","type":"clients"}}}},{"id":"10.48550/arxiv.2608.03765","type":"dois","attributes":{"doi":"10.48550/arxiv.2608.03765","identifiers":[{"identifier":"2608.03765","identifierType":"arXiv"}],"creators":[{"nameType":"Personal","givenName":"Tamal K.","familyName":"Dey","name":"Dey, Tamal K.","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Gilberto","familyName":"Gonzalez-Arroyo","name":"Gonzalez-Arroyo, Gilberto","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Tao","familyName":"Hou","name":"Hou, Tao","affiliation":[],"nameIdentifiers":[]}],"titles":[{"title":"Linked Barcode for Persistence Induced by Filtrations"}],"publisher":"arXiv","container":{},"publicationYear":2026,"subjects":[{"subject":"Computational Geometry (cs.CG)","lang":"en","subjectScheme":"arXiv"},{"subject":"Algebraic Topology (math.AT)","lang":"en","subjectScheme":"arXiv"},{"subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"},{"subject":"FOS: Mathematics","subjectScheme":"Fields of Science and Technology (FOS)"}],"contributors":[],"dates":[{"date":"2026-08-04T14:52:43Z","dateType":"Submitted","dateInformation":"v1"},{"date":"2026-08-05T00:59:35Z","dateType":"Updated","dateInformation":"v1"},{"date":"2026-08","dateType":"Available","dateInformation":"v1"}],"language":null,"types":{"schemaOrg":"CreativeWork","resourceTypeGeneral":"Preprint","citeproc":"article","bibtex":"misc","ris":"GEN","resourceType":"Article"},"relatedIdentifiers":[],"relatedItems":[],"sizes":[],"formats":[],"version":"1","rightsList":[{"rightsIdentifierScheme":"SPDX","rightsUri":"https://creativecommons.org/licenses/by/4.0/legalcode","schemeUri":"https://spdx.org/licenses/","rights":"Creative Commons Attribution 4.0 International","rightsIdentifier":"cc-by-4.0"}],"descriptions":[{"descriptionType":"Abstract","description":"The well-known persistence algorithm summarizes the evolution of homological cycles into what is called a \\emph{barcode} while scanning an input simplicial filtration. We show that this summarization process can be enriched by monitoring other algebraic structures that weave through different dimensions. In particular, we propose an algorithm to monitor the $(p+1)$-chains that make $p$-cycles to be $p$-boundaries and then morph into $(p+1)$-cycles. In effect, we get extra bars called \\emph{links} connecting the bars in dimension $p$ with the bars in dimension $p+1$ in the persistence barcode. The links produce extra barcodes, which we call \\emph{link barcodes} in addition to the usual ones obtained by standard persistence. The link barcodes, as such, are not stable. However, we can make them stable using a fixed ``reference'' filtration. We apply the link barcodes to the graph isomorphism problem and to the link prediction problem in temporal networks exhibiting its discriminating power through these experiments."}],"geoLocations":[],"fundingReferences":[],"url":"https://arxiv.org/abs/2608.03765","contentUrl":null,"metadataVersion":0,"schemaVersion":"http://datacite.org/schema/kernel-4","source":"mds","isActive":true,"state":"findable","reason":null,"viewCount":0,"downloadCount":0,"referenceCount":0,"citationCount":0,"partCount":0,"partOfCount":0,"versionCount":0,"versionOfCount":0,"created":"2026-08-05T02:20:26Z","registered":"2026-08-05T02:20:26Z","published":null,"updated":"2026-08-05T02:20:26Z"},"relationships":{"client":{"data":{"id":"arxiv.content","type":"clients"}}}},{"id":"10.48550/arxiv.2608.03764","type":"dois","attributes":{"doi":"10.48550/arxiv.2608.03764","identifiers":[{"identifier":"2608.03764","identifierType":"arXiv"}],"creators":[{"nameType":"Personal","givenName":"Leijun","familyName":"Zhou","name":"Zhou, Leijun","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Zhihao","familyName":"Liu","name":"Liu, Zhihao","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Xiang","familyName":"Qu","name":"Qu, Xiang","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Chenxu","familyName":"Liu","name":"Liu, Chenxu","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Yifei","familyName":"Liu","name":"Liu, Yifei","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Yanke","familyName":"Yu","name":"Yu, Yanke","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Jingzhe","familyName":"Xu","name":"Xu, Jingzhe","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Xuejun","familyName":"Wu","name":"Wu, Xuejun","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Buyue","familyName":"Qian","name":"Qian, Buyue","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Xi","familyName":"Chen","name":"Chen, Xi","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Yaowei","familyName":"Zheng","name":"Zheng, Yaowei","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Junhao","familyName":"Hu","name":"Hu, Junhao","affiliation":[],"nameIdentifiers":[]}],"titles":[{"title":"GDPevo: Evaluating Agent Self-Evolution on Real Business Tasks"}],"publisher":"arXiv","container":{},"publicationYear":2026,"subjects":[{"subject":"Artificial Intelligence (cs.AI)","lang":"en","subjectScheme":"arXiv"},{"subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"}],"contributors":[],"dates":[{"date":"2026-08-04T14:51:56Z","dateType":"Submitted","dateInformation":"v1"},{"date":"2026-08-05T00:59:32Z","dateType":"Updated","dateInformation":"v1"},{"date":"2026-08","dateType":"Available","dateInformation":"v1"}],"language":null,"types":{"schemaOrg":"CreativeWork","resourceTypeGeneral":"Preprint","citeproc":"article","bibtex":"misc","ris":"GEN","resourceType":"Article"},"relatedIdentifiers":[],"relatedItems":[],"sizes":[],"formats":[],"version":"1","rightsList":[{"rightsUri":"http://arxiv.org/licenses/nonexclusive-distrib/1.0/","rights":"arXiv.org perpetual, non-exclusive license"}],"descriptions":[{"descriptionType":"Abstract","description":"Agent self-evolution updates an agent's persistent state from prior experience and reuses it to solve related tasks more effectively. Evaluating self-evolution is difficult: existing benchmarks provide limited coverage of economically valuable task domains, do not always design training and test tasks such that test-time gains can be attributed to training experience, and remain vulnerable to data contamination. We present GDPevo, an evolution-native benchmark grounded in GDP-related enterprise workflows, together with the fully automated data pipeline that generates it. Its core mechanism, rule hybridization, decomposes each enterprise workflow into atomic business rules, distributes subsets of these rules across training tasks, and recombines them in held-out test tasks so that test-time gains are attributable. GDPevo spans CRM, ERP, finance, healthcare, legal, and data-centric workflows. Its V1 release contains 120 tasks in 12 groups, with five training and five held-out test tasks per group. Full automation enables the pipeline to expand the suite to 240 tasks in 24 groups (V2) within two days, providing a practical response to contamination. Using GDPevo, we evaluate four agents, each comprising a harness and a model, under four supervision types. Self-evolution consistently improves held-out accuracy by up to 16.44 percentage points. But the best evolved agents remain far below the fully informed oracle ceiling of 91.6%, indicating that the self-evolution ability of current agents remains far from fully realized. We publicly release the pipeline, benchmark, and full evaluation results at https://github.com/Prism-Shadow/GDPevo."}],"geoLocations":[],"fundingReferences":[],"url":"https://arxiv.org/abs/2608.03764","contentUrl":null,"metadataVersion":0,"schemaVersion":"http://datacite.org/schema/kernel-4","source":"mds","isActive":true,"state":"findable","reason":null,"viewCount":0,"downloadCount":0,"referenceCount":0,"citationCount":0,"partCount":0,"partOfCount":0,"versionCount":0,"versionOfCount":0,"created":"2026-08-05T02:20:24Z","registered":null,"published":null,"updated":"2026-08-05T02:20:25Z"},"relationships":{"client":{"data":{"id":"arxiv.content","type":"clients"}}}},{"id":"10.48550/arxiv.2608.03763","type":"dois","attributes":{"doi":"10.48550/arxiv.2608.03763","identifiers":[{"identifier":"2608.03763","identifierType":"arXiv"}],"creators":[{"nameType":"Personal","givenName":"Qingxi","familyName":"Du","name":"Du, Qingxi","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Junbo","familyName":"Wang","name":"Wang, Junbo","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Yuke","familyName":"Li","name":"Li, Yuke","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Yining","familyName":"Zhu","name":"Zhu, Yining","affiliation":[],"nameIdentifiers":[]}],"titles":[{"title":"TDVR: Joint Text Disambiguation and Viewpoint Reasoning for Zero-Shot 3D Visual Grounding"}],"publisher":"arXiv","container":{},"publicationYear":2026,"subjects":[{"subject":"Computer Vision and Pattern Recognition (cs.CV)","lang":"en","subjectScheme":"arXiv"},{"subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"}],"contributors":[],"dates":[{"date":"2026-08-04T14:51:15Z","dateType":"Submitted","dateInformation":"v1"},{"date":"2026-08-05T00:59:28Z","dateType":"Updated","dateInformation":"v1"},{"date":"2026-08","dateType":"Available","dateInformation":"v1"}],"language":null,"types":{"schemaOrg":"CreativeWork","resourceTypeGeneral":"Preprint","citeproc":"article","bibtex":"misc","ris":"GEN","resourceType":"Article"},"relatedIdentifiers":[],"relatedItems":[],"sizes":[],"formats":[],"version":"1","rightsList":[{"rightsIdentifierScheme":"SPDX","rightsUri":"https://creativecommons.org/licenses/by/4.0/legalcode","schemeUri":"https://spdx.org/licenses/","rights":"Creative Commons Attribution 4.0 International","rightsIdentifier":"cc-by-4.0"}],"descriptions":[{"descriptionType":"Abstract","description":"Zero-shot 3D visual grounding aims to localize specific objects based on textual descriptions and 3D visual input. However, the effectiveness of existing methods is significantly hindered by the ambiguous query text and deficient viewpoints. To address these issues, we propose TDVR, a training-free reasoning framework that disambiguates the input text and infers accurate viewpoints for zero-shot 3D visual grounding. First, we construct semantic 3D scene graph from the detected instances in the 3D point cloud. Subsequently, we put the original query, appearance and spatial relationship descriptions into the LLM for fusion, thereby disambiguating the initial input. We leverage chain-of-thought reasoning to generate the structured representation of disambiguated query. Then taking the scene graph and structured query as input, we get the optimal view via viewpoint reasoning to solve the problem of missing viewpoints during grounding. Based on the obtained optimal viewpoint, we further discriminate the distracting objects, enabling the model with the ability to distinguish similar instances. After that, we match the category text and appearance images with the query by computing the similarity of feature vectors. Finally, the target object was identified by integrating the viewpoint score, confusion score, category score, and appearance score. Compared with previous methods, our TDVR has stronger capabilities in viewpoint reasoning, similar object discrimination, and ambiguous query understanding. Experimental results on the public ScanRefer dataset show that our method outperforms the existing state-of-the-art methods by 15.25% and 14.46% in Acc@0.25 and Acc@0.5 respectively, demonstrating the effectiveness of our TDVR in addressing ambiguous query text and deficient viewpoints."},{"descriptionType":"Other","description":"10 pages, 5 figures, 7 tables"}],"geoLocations":[],"fundingReferences":[],"url":"https://arxiv.org/abs/2608.03763","contentUrl":null,"metadataVersion":0,"schemaVersion":"http://datacite.org/schema/kernel-4","source":"mds","isActive":true,"state":"findable","reason":null,"viewCount":0,"downloadCount":0,"referenceCount":0,"citationCount":0,"partCount":0,"partOfCount":0,"versionCount":0,"versionOfCount":0,"created":"2026-08-05T02:20:23Z","registered":"2026-08-05T02:20:24Z","published":null,"updated":"2026-08-05T02:20:24Z"},"relationships":{"client":{"data":{"id":"arxiv.content","type":"clients"}}}},{"id":"10.48550/arxiv.2608.03762","type":"dois","attributes":{"doi":"10.48550/arxiv.2608.03762","identifiers":[{"identifier":"2608.03762","identifierType":"arXiv"}],"creators":[{"nameType":"Personal","givenName":"Smiti","familyName":"Tripathy","name":"Tripathy, Smiti","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Milauni","familyName":"Desai","name":"Desai, Milauni","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Jordina Aviles","familyName":"Verdera","name":"Verdera, Jordina Aviles","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Jana","familyName":"Hutter","name":"Hutter, Jana","affiliation":[],"nameIdentifiers":[]}],"titles":[{"title":"Unsupervised Adversarial Domain Adaptation for Uterine layer Segmentation: From Labeled Cine to Unlabeled Dynamic EPI MRI"}],"publisher":"arXiv","container":{},"publicationYear":2026,"subjects":[{"subject":"Image and Video Processing (eess.IV)","lang":"en","subjectScheme":"arXiv"},{"subject":"Computer Vision and Pattern Recognition (cs.CV)","lang":"en","subjectScheme":"arXiv"},{"subject":"FOS: Electrical engineering, electronic engineering, information engineering","subjectScheme":"Fields of Science and Technology (FOS)"},{"subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"}],"contributors":[],"dates":[{"date":"2026-08-04T14:50:37Z","dateType":"Submitted","dateInformation":"v1"},{"date":"2026-08-05T00:59:26Z","dateType":"Updated","dateInformation":"v1"},{"date":"2026-08","dateType":"Available","dateInformation":"v1"}],"language":null,"types":{"schemaOrg":"CreativeWork","resourceTypeGeneral":"Preprint","citeproc":"article","bibtex":"misc","ris":"GEN","resourceType":"Article"},"relatedIdentifiers":[],"relatedItems":[],"sizes":[],"formats":[],"version":"1","rightsList":[{"rightsIdentifierScheme":"SPDX","rightsUri":"https://creativecommons.org/licenses/by/4.0/legalcode","schemeUri":"https://spdx.org/licenses/","rights":"Creative Commons Attribution 4.0 International","rightsIdentifier":"cc-by-4.0"}],"descriptions":[{"descriptionType":"Abstract","description":"Uterine peristalsis is a key physiological phenomenon responsible for various functions across the menstrual cycle, intimately linked to uterine wall microstructure. Alterations in uterine motion and tissue properties are implicated in the etiology of gynecological diseases, yet these processes have been studied in isolation. We introduce a dynamic multi-echo gradient echo EPI framework for simultaneous characterization and correlation of uterine peristaltic activity and time-resolved T2* changes at 0.55T. Inherent susceptibility artifacts, reduced resolution, and burden of manual uterine layer annotation are addressed by an unsupervised adversarial domain adaptation framework, transferring segmentation knowledge from labeled cine MRI to unlabeled dynamic EPI. We implemented Unet-LSTM with multi-scale domain discriminators that exploits temporal layer dynamics. A Dice score of 0.88 and Jaccard index of 0.80 was achieved. Mean T2* values were 108ms, 76ms, and 124ms for the myometrium, junctional zone, and endometrium. A negative correlation between junctional zone area and T2* was observed in 14/39 cases, providing first insights into oxygenation patterns associated with junctional zone contraction and motion, demonstrating feasibility of assessing the interplay between contractility and dynamic T2* changes."}],"geoLocations":[],"fundingReferences":[],"url":"https://arxiv.org/abs/2608.03762","contentUrl":null,"metadataVersion":0,"schemaVersion":"http://datacite.org/schema/kernel-4","source":"mds","isActive":true,"state":"findable","reason":null,"viewCount":0,"downloadCount":0,"referenceCount":0,"citationCount":0,"partCount":0,"partOfCount":0,"versionCount":0,"versionOfCount":0,"created":"2026-08-05T02:20:21Z","registered":null,"published":null,"updated":"2026-08-05T02:20:22Z"},"relationships":{"client":{"data":{"id":"arxiv.content","type":"clients"}}}},{"id":"10.48550/arxiv.2608.03761","type":"dois","attributes":{"doi":"10.48550/arxiv.2608.03761","identifiers":[{"identifier":"2608.03761","identifierType":"arXiv"}],"creators":[{"nameType":"Personal","givenName":"Thomas","familyName":"Galvin","name":"Galvin, Thomas","affiliation":[],"nameIdentifiers":[]}],"titles":[{"title":"The Hitchin and Sutcliffe metrics for hyperbolic 2-monopoles"}],"publisher":"arXiv","container":{},"publicationYear":2026,"subjects":[{"subject":"High Energy Physics - Theory (hep-th)","lang":"en","subjectScheme":"arXiv"},{"subject":"FOS: Physical sciences","subjectScheme":"Fields of Science and Technology (FOS)"}],"contributors":[],"dates":[{"date":"2026-08-04T14:49:28Z","dateType":"Submitted","dateInformation":"v1"},{"date":"2026-08-05T00:59:23Z","dateType":"Updated","dateInformation":"v1"},{"date":"2026-08","dateType":"Available","dateInformation":"v1"}],"language":null,"types":{"schemaOrg":"CreativeWork","resourceTypeGeneral":"Preprint","citeproc":"article","bibtex":"misc","ris":"GEN","resourceType":"Article"},"relatedIdentifiers":[],"relatedItems":[],"sizes":[],"formats":[],"version":"1","rightsList":[{"rightsUri":"http://arxiv.org/licenses/nonexclusive-distrib/1.0/","rights":"arXiv.org perpetual, non-exclusive license"}],"descriptions":[{"descriptionType":"Abstract","description":"We compare two currently known examples of hyperbolic SU(2) two-monopole metrics and their candidacy as models of hyperbolic monopole dynamics. The first is Sutcliffe's boundary metric and the other is a well-known self-dual Einstein metric found by Hitchin. We show that these metrics are conformally inequivalent and make significantly different predictions for monopole dynamics. We compare each metric to the Franchetti-Ross point particle approximation of hyperbolic monopole dynamics. We show Sutcliffe's metric does not converge to the point particle approximation in the large separation limit. We also check Sen's conjecture for each metric by computing their $L^2$ harmonic two-forms. By a symmetry argument we are able to show that Hitchin's metric has a single $L^2$ harmonic two-form consistent with the conjecture."},{"descriptionType":"Other","description":"17 pages, 4 figures"}],"geoLocations":[],"fundingReferences":[],"url":"https://arxiv.org/abs/2608.03761","contentUrl":null,"metadataVersion":0,"schemaVersion":"http://datacite.org/schema/kernel-4","source":"mds","isActive":true,"state":"findable","reason":null,"viewCount":0,"downloadCount":0,"referenceCount":0,"citationCount":0,"partCount":0,"partOfCount":0,"versionCount":0,"versionOfCount":0,"created":"2026-08-05T02:20:20Z","registered":"2026-08-05T02:20:21Z","published":null,"updated":"2026-08-05T02:20:21Z"},"relationships":{"client":{"data":{"id":"arxiv.content","type":"clients"}}}},{"id":"10.48550/arxiv.2608.03760","type":"dois","attributes":{"doi":"10.48550/arxiv.2608.03760","identifiers":[{"identifier":"2608.03760","identifierType":"arXiv"}],"creators":[{"nameType":"Personal","givenName":"Emmanuel A.","familyName":"Olanrewaju","name":"Olanrewaju, Emmanuel A.","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Santosh","familyName":"Adhikari","name":"Adhikari, Santosh","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Zhiyin","familyName":"Niu","name":"Niu, Zhiyin","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Michael","familyName":"Nikolaou","name":"Nikolaou, Michael","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Jeremy C.","familyName":"Palmer","name":"Palmer, Jeremy C.","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Jeffrey D.","familyName":"Rimer","name":"Rimer, Jeffrey D.","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Mingjian","familyName":"Wen","name":"Wen, Mingjian","affiliation":[],"nameIdentifiers":[]}],"titles":[{"title":"Guided Synthesis of EMT Zeolites by Machine Learning"}],"publisher":"arXiv","container":{},"publicationYear":2026,"subjects":[{"subject":"Materials Science (cond-mat.mtrl-sci)","lang":"en","subjectScheme":"arXiv"},{"subject":"FOS: Physical sciences","subjectScheme":"Fields of Science and Technology (FOS)"}],"contributors":[],"dates":[{"date":"2026-08-04T14:48:51Z","dateType":"Submitted","dateInformation":"v1"},{"date":"2026-08-05T00:59:22Z","dateType":"Updated","dateInformation":"v1"},{"date":"2026-08","dateType":"Available","dateInformation":"v1"}],"language":null,"types":{"schemaOrg":"CreativeWork","resourceTypeGeneral":"Preprint","citeproc":"article","bibtex":"misc","ris":"GEN","resourceType":"Article"},"relatedIdentifiers":[{"relationType":"IsVersionOf","relatedIdentifier":"10.1103/v2yp-ylxm","relatedIdentifierType":"DOI"}],"relatedItems":[],"sizes":[],"formats":[],"version":"1","rightsList":[{"rightsUri":"http://arxiv.org/licenses/nonexclusive-distrib/1.0/","rights":"arXiv.org perpetual, non-exclusive license"}],"descriptions":[{"descriptionType":"Abstract","description":"Zeolites are microporous crystalline materials with diverse frameworks, widely used in industrial applications such as petroleum refining and molecular separation. Unlike most zeolites, EMT can be synthesized under mild conditions (at low temperatures and without the use of organic structure-directing agents), making it attractive for cost-effective and environmentally sustainable production. However, the specific synthesis conditions that selectively produce EMT rather than similar frameworks like FAU are not yet well established. In this work, we develop machine learning (ML) models to guide the discovery of synthesis conditions for EMT zeolites. Our dataset comprises 174 experimental synthesis attempts, recording reaction time, temperature, silica and alumina sources, Si/Al stoichiometric ratio, and other synthesis parameters. We apply both classical ML methods and pretrained foundation models to predict zeolite framework outcomes from these synthesis parameters. Feature importance analysis identifies critical parameters for EMT formation, validating known synthesis principles. Leveraging the ML models, we explore the synthesis space and identify six promising new conditions for EMT formation. Experimental validation confirms EMT crystallization in five cases, including two with Si/Al stoichiometric ratios outside the training dataset's range. Evaluation on independent literature-reported synthesis conditions further demonstrates the generalizability of the model. This work demonstrates a data-driven approach to accelerating zeolite synthesis, closing the loop between ML prediction and experimental validation."}],"geoLocations":[],"fundingReferences":[],"url":"https://arxiv.org/abs/2608.03760","contentUrl":null,"metadataVersion":0,"schemaVersion":"http://datacite.org/schema/kernel-4","source":"mds","isActive":true,"state":"findable","reason":null,"viewCount":0,"downloadCount":0,"referenceCount":0,"citationCount":0,"partCount":0,"partOfCount":0,"versionCount":0,"versionOfCount":1,"created":"2026-08-05T02:20:19Z","registered":"2026-08-05T02:20:19Z","published":null,"updated":"2026-08-05T02:20:19Z"},"relationships":{"client":{"data":{"id":"arxiv.content","type":"clients"}}}},{"id":"10.48550/arxiv.2608.03758","type":"dois","attributes":{"doi":"10.48550/arxiv.2608.03758","identifiers":[{"identifier":"2608.03758","identifierType":"arXiv"}],"creators":[{"nameType":"Personal","givenName":"Gaia","familyName":"Carenini","name":"Carenini, Gaia","affiliation":[],"nameIdentifiers":[]}],"titles":[{"title":"Ranked spreadness and sample-based testing"}],"publisher":"arXiv","container":{},"publicationYear":2026,"subjects":[{"subject":"Statistics Theory (math.ST)","lang":"en","subjectScheme":"arXiv"},{"subject":"Computational Complexity (cs.CC)","lang":"en","subjectScheme":"arXiv"},{"subject":"Data Structures and Algorithms (cs.DS)","lang":"en","subjectScheme":"arXiv"},{"subject":"Combinatorics (math.CO)","lang":"en","subjectScheme":"arXiv"},{"subject":"FOS: Mathematics","subjectScheme":"Fields of Science and Technology (FOS)"},{"subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"}],"contributors":[],"dates":[{"date":"2026-08-04T14:47:05Z","dateType":"Submitted","dateInformation":"v1"},{"date":"2026-08-05T00:59:15Z","dateType":"Updated","dateInformation":"v1"},{"date":"2026-08","dateType":"Available","dateInformation":"v1"}],"language":null,"types":{"schemaOrg":"CreativeWork","resourceTypeGeneral":"Preprint","citeproc":"article","bibtex":"misc","ris":"GEN","resourceType":"Article"},"relatedIdentifiers":[],"relatedItems":[],"sizes":[],"formats":[],"version":"1","rightsList":[{"rightsIdentifierScheme":"SPDX","rightsUri":"https://creativecommons.org/licenses/by-nc-nd/4.0/legalcode","schemeUri":"https://spdx.org/licenses/","rights":"Creative Commons Attribution Non Commercial No Derivatives 4.0 International","rightsIdentifier":"cc-by-nc-nd-4.0"}],"descriptions":[{"descriptionType":"Abstract","description":"In this note, we introduce the notion of ranked spreadness, a strengthening of the usual spread condition in which the elements of each member can be ordered so that their one-coordinate marginals decay geometrically with their rank. This additional structure removes the dependence on the maximum set size in random-containment estimates. We prove width-free hitting and weighted-concentration theorems for ranked-spread set systems, together with an elementary kernel-extraction theorem showing that ranked spreadness arises naturally in arbitrary distributions on small sets.\n Our main application is to the simulation of nonadaptive property testers by sample-based testers. If a one-sided tester has average query complexity $d$ and rejects every far input with probability at least $δ$, then, for every integer $c\u0026gt;d/δ$, it admits a one-sided sample-based simulation with expected sample complexity $O_{d,δ,|Σ|}\\bigl(n^{1-1/c}\\bigr)$. More generally, if positive inputs are rejected with probability at most $γ$ and far inputs with probability at least $δ\u0026gt;γ$, the same conclusion holds for every $c\u0026gt;d/(δ-γ)$. In particular, for constant-query nonadaptive testers we obtain an exponent $1-Θ(1/q)$, matching, up to the dependence on the rejection gap, the exponent conjectured by Fischer, Lachish, and Vasudev."},{"descriptionType":"Other","description":"Comments are welcome!"}],"geoLocations":[],"fundingReferences":[],"url":"https://arxiv.org/abs/2608.03758","contentUrl":null,"metadataVersion":0,"schemaVersion":"http://datacite.org/schema/kernel-4","source":"mds","isActive":true,"state":"findable","reason":null,"viewCount":0,"downloadCount":0,"referenceCount":0,"citationCount":0,"partCount":0,"partOfCount":0,"versionCount":0,"versionOfCount":0,"created":"2026-08-05T02:20:16Z","registered":"2026-08-05T02:20:16Z","published":null,"updated":"2026-08-05T02:20:16Z"},"relationships":{"client":{"data":{"id":"arxiv.content","type":"clients"}}}},{"id":"10.48550/arxiv.2608.03757","type":"dois","attributes":{"doi":"10.48550/arxiv.2608.03757","identifiers":[{"identifier":"2608.03757","identifierType":"arXiv"}],"creators":[{"nameType":"Personal","givenName":"Hung","familyName":"Tong","name":"Tong, Hung","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Antonio","familyName":"Punzo","name":"Punzo, Antonio","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Cristina","familyName":"Tortora","name":"Tortora, Cristina","affiliation":[],"nameIdentifiers":[]}],"titles":[{"title":"A New Look at Gaussian Mixtures in the Presence of Missing-at-Random Responses and Covariates"}],"publisher":"arXiv","container":{},"publicationYear":2026,"subjects":[{"subject":"Methodology (stat.ME)","lang":"en","subjectScheme":"arXiv"},{"subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"}],"contributors":[],"dates":[{"date":"2026-08-04T14:46:52Z","dateType":"Submitted","dateInformation":"v1"},{"date":"2026-08-05T00:59:14Z","dateType":"Updated","dateInformation":"v1"},{"date":"2026-08","dateType":"Available","dateInformation":"v1"}],"language":null,"types":{"schemaOrg":"CreativeWork","resourceTypeGeneral":"Preprint","citeproc":"article","bibtex":"misc","ris":"GEN","resourceType":"Article"},"relatedIdentifiers":[],"relatedItems":[],"sizes":[],"formats":[],"version":"1","rightsList":[{"rightsIdentifierScheme":"SPDX","rightsUri":"https://creativecommons.org/licenses/by-nc-nd/4.0/legalcode","schemeUri":"https://spdx.org/licenses/","rights":"Creative Commons Attribution Non Commercial No Derivatives 4.0 International","rightsIdentifier":"cc-by-nc-nd-4.0"}],"descriptions":[{"descriptionType":"Abstract","description":"Missing values present a common challenge in statistical modeling, so handling them properly is an important research direction. Among the various mechanisms that can generate missing values, the most common is the missing-at-random (MAR) mechanism, in which the probability of missingness depends only on observed data and not on unobserved data.\n This paper addresses the problem of estimating a multivariate linear regression model with multiple random covariates in the presence of MAR values in both the response and covariate spaces using a maximum likelihood (ML) framework.\n The proposed methodology models the joint distribution of responses and covariates through a conditional-marginal factorization of a multivariate Gaussian distribution. This formulation can be interpreted as a reparameterization of the multivariate normal distribution when the variables can be naturally partitioned into responses and covariates.\n Parameter estimation is performed using the expectation-maximization (EM) algorithm, which facilitates the imputation of missing values while preserving the distinct roles of responses and covariates.\n We extend this framework to the model-based clustering setting by considering a mixture of multivariate linear regressions with multiple random covariates. This extension enables soft clustering under incomplete data and accommodates MAR values in both the multivariate responses and covariates. Hence, it represents one of the most general model-based clustering solutions for regression data currently available in the literature.\n The effectiveness of the methodology is demonstrated through a simulation study, and the advantages of the proposed reparameterization are illustrated using the Automobile dataset, which contains missing values."}],"geoLocations":[],"fundingReferences":[],"url":"https://arxiv.org/abs/2608.03757","contentUrl":null,"metadataVersion":0,"schemaVersion":"http://datacite.org/schema/kernel-4","source":"mds","isActive":true,"state":"findable","reason":null,"viewCount":0,"downloadCount":0,"referenceCount":0,"citationCount":0,"partCount":0,"partOfCount":0,"versionCount":0,"versionOfCount":0,"created":"2026-08-05T02:20:14Z","registered":"2026-08-05T02:20:15Z","published":null,"updated":"2026-08-05T02:20:15Z"},"relationships":{"client":{"data":{"id":"arxiv.content","type":"clients"}}}},{"id":"10.48550/arxiv.2608.03756","type":"dois","attributes":{"doi":"10.48550/arxiv.2608.03756","identifiers":[{"identifier":"2608.03756","identifierType":"arXiv"}],"creators":[{"nameType":"Personal","givenName":"Theresia Veronika","familyName":"Rampisela","name":"Rampisela, Theresia Veronika","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Henrik Palmer","familyName":"Olsen","name":"Olsen, Henrik Palmer","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Giovanni","familyName":"Colavizza","name":"Colavizza, Giovanni","affiliation":[],"nameIdentifiers":[]}],"titles":[{"title":"LegalPincite: Multi-level Legal Information Retrieval Dataset"}],"publisher":"arXiv","container":{},"publicationYear":2026,"subjects":[{"subject":"Information Retrieval (cs.IR)","lang":"en","subjectScheme":"arXiv"},{"subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"}],"contributors":[],"dates":[{"date":"2026-08-04T14:46:19Z","dateType":"Submitted","dateInformation":"v1"},{"date":"2026-08-05T00:59:13Z","dateType":"Updated","dateInformation":"v1"},{"date":"2026-08","dateType":"Available","dateInformation":"v1"}],"language":null,"types":{"schemaOrg":"CreativeWork","resourceTypeGeneral":"Preprint","citeproc":"article","bibtex":"misc","ris":"GEN","resourceType":"Article"},"relatedIdentifiers":[],"relatedItems":[],"sizes":[],"formats":[],"version":"1","rightsList":[{"rightsIdentifierScheme":"SPDX","rightsUri":"https://creativecommons.org/licenses/by-sa/4.0/legalcode","schemeUri":"https://spdx.org/licenses/","rights":"Creative Commons Attribution Share Alike 4.0 International","rightsIdentifier":"cc-by-sa-4.0"}],"descriptions":[{"descriptionType":"Abstract","description":"A common task in legal Information Retrieval (IR) is to find relevant legal sources from case-law collections. While legal practice often requires pinpoint citations (pincites) to specific case paragraphs, most existing public legal IR datasets lack paragraph-level citation annotations. Yet, publicly available datasets with such information contain data leakage in the query text and exclude paragraphs that are neither citing nor cited from the corpora, creating an unrealistic and oversimplified retrieval setting, potentially leading to inflated performance. To address these limitations, we contribute a large-scale legal IR dataset constructed from Court of Justice of the European Union (CJEU) judgments. The dataset contains: (i) masked case/paragraph queries, with removed citation information; (ii) a corpus that includes all paragraphs; and (iii) case- and paragraph-level ground-truth citations, with partial human expert validation. Our dataset supports both the development and rigorous evaluation of legal IR methods, at multiple query-document levels (case-to-case, paragraph-to-case, and paragraph-to-paragraph retrieval). Link to dataset: https://huggingface.co/datasets/theresiavr/legalpincite"}],"geoLocations":[],"fundingReferences":[],"url":"https://arxiv.org/abs/2608.03756","contentUrl":null,"metadataVersion":0,"schemaVersion":"http://datacite.org/schema/kernel-4","source":"mds","isActive":true,"state":"findable","reason":null,"viewCount":0,"downloadCount":0,"referenceCount":0,"citationCount":0,"partCount":0,"partOfCount":0,"versionCount":0,"versionOfCount":0,"created":"2026-08-05T02:20:13Z","registered":"2026-08-05T02:20:14Z","published":null,"updated":"2026-08-05T02:20:14Z"},"relationships":{"client":{"data":{"id":"arxiv.content","type":"clients"}}}},{"id":"10.48550/arxiv.2608.03755","type":"dois","attributes":{"doi":"10.48550/arxiv.2608.03755","identifiers":[{"identifier":"2608.03755","identifierType":"arXiv"}],"creators":[{"nameType":"Personal","givenName":"Hao","familyName":"Dai","name":"Dai, Hao","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Yue","familyName":"Zhang","name":"Zhang, Yue","affiliation":[],"nameIdentifiers":[]}],"titles":[{"title":"Uncovering Non-Gaussianity through Multi-Copy Symmetries"}],"publisher":"arXiv","container":{},"publicationYear":2026,"subjects":[{"subject":"Quantum Physics (quant-ph)","lang":"en","subjectScheme":"arXiv"},{"subject":"FOS: Physical sciences","subjectScheme":"Fields of Science and Technology (FOS)"}],"contributors":[],"dates":[{"date":"2026-08-04T14:44:22Z","dateType":"Submitted","dateInformation":"v1"},{"date":"2026-08-05T00:59:10Z","dateType":"Updated","dateInformation":"v1"},{"date":"2026-08","dateType":"Available","dateInformation":"v1"}],"language":null,"types":{"schemaOrg":"CreativeWork","resourceTypeGeneral":"Preprint","citeproc":"article","bibtex":"misc","ris":"GEN","resourceType":"Article"},"relatedIdentifiers":[],"relatedItems":[],"sizes":[],"formats":[],"version":"1","rightsList":[{"rightsUri":"http://arxiv.org/licenses/nonexclusive-distrib/1.0/","rights":"arXiv.org perpetual, non-exclusive license"}],"descriptions":[{"descriptionType":"Abstract","description":"Gaussian states are fundamental in continuous-variable quantum information, yet characterizing non-Gaussianity remains challenging due to the non-convexity of the Gaussian set. Existing witnesses typically rely on Wigner negativity or other information-theoretic quantities. In this work, we develop a group-theoretic, multi-copy approach to detect non-Gaussianity in bosonic systems. We study passive linear optical transformations that mix copies of a quantum state and analyze their commutation with identical Gaussian unitaries applied to each copy. Orthogonal copy-mixing transformations commute with the symplectic part of the Gaussian action, while the displacement part restricts the symmetry to the stabilizer of the collective mode. This structure yields a family of witnesses satisfied by all single-mode Gaussian states. Fixing the thermal reference parameter via the purity, violation of these identities certifies non-Gaussianity. We illustrate the method with several single-mode examples and present an experimental protocol based on passive interferometry and photon-number-resolved detection, showing that the relevant multi-copy expectation values can be estimated from bounded phase observables. Finally, we extend the construction to multi-mode systems and discuss how the same symmetry framework may lead to quantitative measures of non-Gaussianity."}],"geoLocations":[],"fundingReferences":[],"url":"https://arxiv.org/abs/2608.03755","contentUrl":null,"metadataVersion":0,"schemaVersion":"http://datacite.org/schema/kernel-4","source":"mds","isActive":true,"state":"findable","reason":null,"viewCount":0,"downloadCount":0,"referenceCount":0,"citationCount":0,"partCount":0,"partOfCount":0,"versionCount":0,"versionOfCount":0,"created":"2026-08-05T02:20:11Z","registered":null,"published":null,"updated":"2026-08-05T02:20:12Z"},"relationships":{"client":{"data":{"id":"arxiv.content","type":"clients"}}}},{"id":"10.48550/arxiv.2608.03753","type":"dois","attributes":{"doi":"10.48550/arxiv.2608.03753","identifiers":[{"identifier":"2608.03753","identifierType":"arXiv"}],"creators":[{"nameType":"Personal","givenName":"Andrea","familyName":"Protopapa","name":"Protopapa, Andrea","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Davide","familyName":"Buoso","name":"Buoso, Davide","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Francesca","familyName":"Pistilli","name":"Pistilli, Francesca","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Georgia","familyName":"Chalvatzaki","name":"Chalvatzaki, Georgia","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Giuseppe","familyName":"Averta","name":"Averta, Giuseppe","affiliation":[],"nameIdentifiers":[]}],"titles":[{"title":"GORDON: Graph-based Object-centric Rewards for Decomposition of Long-Horizon Manipulation"}],"publisher":"arXiv","container":{},"publicationYear":2026,"subjects":[{"subject":"Robotics (cs.RO)","lang":"en","subjectScheme":"arXiv"},{"subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"}],"contributors":[],"dates":[{"date":"2026-08-04T14:43:41Z","dateType":"Submitted","dateInformation":"v1"},{"date":"2026-08-05T00:59:03Z","dateType":"Updated","dateInformation":"v1"},{"date":"2026-08","dateType":"Available","dateInformation":"v1"}],"language":null,"types":{"schemaOrg":"CreativeWork","resourceTypeGeneral":"Preprint","citeproc":"article","bibtex":"misc","ris":"GEN","resourceType":"Article"},"relatedIdentifiers":[],"relatedItems":[],"sizes":[],"formats":[],"version":"1","rightsList":[{"rightsUri":"http://arxiv.org/licenses/nonexclusive-distrib/1.0/","rights":"arXiv.org perpetual, non-exclusive license"}],"descriptions":[{"descriptionType":"Abstract","description":"Learning long-horizon manipulation skills with reinforcement learning remains challenging due to the complexity of reward design, the limited guidance of sparse rewards, and the high cost of manual subtask annotation. Visual demonstrations can provide supervision for reward learning, but rewards learned from raw pixels can be brittle and sensitive to visual variation, background appearance, and robot motion. In this work, we propose GORDON, a graph-based object-centric reward learning framework that learns dense rewards from action-free video demonstrations. Each visual scene is represented as a graph of detected objects and spatial relations, and a graph neural network is trained in a self-supervised manner to embed these graphs into a task-aligned latent space. To align the representation with semantic task progress, we introduce an activity-aware weighted pooling mechanism that emphasizes task-relevant objects while masking robot-dominated motion. The dense reward is then computed as distances in the learned latent space of the current state to demonstrated goal configurations, providing a measure of task progress. In long-horizon tasks, the temporal profile of this reward reveals stage-wise object-state transitions, enabling automatic subtask discovery without manual segmentation. The discovered segments are then used to train subtask-specific rewards and specialized policies that are composed sequentially. Experiments on seven manipulation tasks on MAGICAL and ManiSkill3 benchmarks show that our object-centric reward improves reinforcement learning in short-horizon settings and enables successful policy learning in complex long-horizon tasks through automatic decomposition, achieving an average success rate of 74.4% across the long-horizon tasks (on average approximately +35 p.p. vs. best learned baseline and approximately +25 p.p. vs. oracle)."},{"descriptionType":"Other","description":"9 pages, 6 figures, preprint. Project page: https://andreaprotopapa.github.io/graph-reward-learning/"}],"geoLocations":[],"fundingReferences":[],"url":"https://arxiv.org/abs/2608.03753","contentUrl":null,"metadataVersion":0,"schemaVersion":"http://datacite.org/schema/kernel-4","source":"mds","isActive":true,"state":"findable","reason":null,"viewCount":0,"downloadCount":0,"referenceCount":0,"citationCount":0,"partCount":0,"partOfCount":0,"versionCount":0,"versionOfCount":0,"created":"2026-08-05T02:20:09Z","registered":"2026-08-05T02:20:10Z","published":null,"updated":"2026-08-05T02:20:10Z"},"relationships":{"client":{"data":{"id":"arxiv.content","type":"clients"}}}},{"id":"10.48550/arxiv.2608.03752","type":"dois","attributes":{"doi":"10.48550/arxiv.2608.03752","identifiers":[{"identifier":"2608.03752","identifierType":"arXiv"}],"creators":[{"nameType":"Personal","givenName":"Liangshun","familyName":"Wu","name":"Wu, Liangshun","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Wen","familyName":"Chen","name":"Chen, Wen","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Zhendong","familyName":"Li","name":"Li, Zhendong","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Qiong","familyName":"Wu","name":"Wu, Qiong","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Ying","familyName":"Wang","name":"Wang, Ying","affiliation":[],"nameIdentifiers":[]}],"titles":[{"title":"AP Association for RHS-Enabled Cell-Free Uplink MIMO in Industrial Indoor UAV Networks"}],"publisher":"arXiv","container":{},"publicationYear":2026,"subjects":[{"subject":"Networking and Internet Architecture (cs.NI)","lang":"en","subjectScheme":"arXiv"},{"subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"}],"contributors":[],"dates":[{"date":"2026-08-04T14:43:27Z","dateType":"Submitted","dateInformation":"v1"},{"date":"2026-08-05T00:58:59Z","dateType":"Updated","dateInformation":"v1"},{"date":"2026-08","dateType":"Available","dateInformation":"v1"}],"language":null,"types":{"schemaOrg":"CreativeWork","resourceTypeGeneral":"Preprint","citeproc":"article","bibtex":"misc","ris":"GEN","resourceType":"Article"},"relatedIdentifiers":[],"relatedItems":[],"sizes":[],"formats":[],"version":"1","rightsList":[{"rightsIdentifierScheme":"SPDX","rightsUri":"https://creativecommons.org/licenses/by-nc-nd/4.0/legalcode","schemeUri":"https://spdx.org/licenses/","rights":"Creative Commons Attribution Non Commercial No Derivatives 4.0 International","rightsIdentifier":"cc-by-nc-nd-4.0"}],"descriptions":[{"descriptionType":"Abstract","description":"Indoor industrial UAV uplink networks face serious blockage and shadowing from shelves, metal equipment, and production facilities. UAVs are also often clustered and fly along similar straight inspection routes at fixed heights. These features make traditional small-cell deployment less suitable, especially when high reliability, continuous coverage, and good service for weak UAVs are required. Cell-free networks can improve robustness through distributed access points (APs) and UAV?centric communications. Reconfigurable holographic surface (RHS)-enabled APs provide programmable analog receive beams and generate scalar post-RHS observations, which are jointly processed at the CPU for distributed uplink MIMO detection at relatively low hardware cost. Conventional AP association relies on distance, large-scale fading, or post-combining SINR obtained with user-specific digital combiners. Here, however, all UAVs served by a single-feed RHS AP share one amplitude?constrained receive pattern and one scalar AP output. We therefore derive an SINR-like score from this physical output and, under weak inter-AP disturbance correlation, approximate the CPU-side log-det objective by an additive per-AP surrogate, yielding a low-complexity ranking rule. The results show that the nearest AP is not always the best choice, the AP-UAV height difference may have an optimal value, and larger serving clusters bring diminishing returns. Simulations show that the proposed method improves the minimum UAV data rate, average spectral efficiency, fairness, and energy efficiency compared with benchmark schemes."}],"geoLocations":[],"fundingReferences":[],"url":"https://arxiv.org/abs/2608.03752","contentUrl":null,"metadataVersion":0,"schemaVersion":"http://datacite.org/schema/kernel-4","source":"mds","isActive":true,"state":"findable","reason":null,"viewCount":0,"downloadCount":0,"referenceCount":0,"citationCount":0,"partCount":0,"partOfCount":0,"versionCount":0,"versionOfCount":0,"created":"2026-08-05T02:20:08Z","registered":"2026-08-05T02:20:08Z","published":null,"updated":"2026-08-05T02:20:08Z"},"relationships":{"client":{"data":{"id":"arxiv.content","type":"clients"}}}},{"id":"10.48550/arxiv.2608.03751","type":"dois","attributes":{"doi":"10.48550/arxiv.2608.03751","identifiers":[{"identifier":"2608.03751","identifierType":"arXiv"}],"creators":[{"nameType":"Personal","givenName":"Fabio","familyName":"Stoll","name":"Stoll, Fabio","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Benjamin","familyName":"Pottkamp","name":"Pottkamp, Benjamin","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Heiko","familyName":"Lorenz","name":"Lorenz, Heiko","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Shalaka","familyName":"Kale","name":"Kale, Shalaka","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Jessica","familyName":"Rövekamp","name":"Rövekamp, Jessica","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Joachim","familyName":"Gerlach","name":"Gerlach, Joachim","affiliation":[],"nameIdentifiers":[]}],"titles":[{"title":"Delay Attacks on the German Smart Metering Infrastructure: A Security Analysis of CLS Channel Timing Constraints"}],"publisher":"arXiv","container":{},"publicationYear":2026,"subjects":[{"subject":"Cryptography and Security (cs.CR)","lang":"en","subjectScheme":"arXiv"},{"subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"}],"contributors":[],"dates":[{"date":"2026-08-04T14:43:02Z","dateType":"Submitted","dateInformation":"v1"},{"date":"2026-08-05T00:58:58Z","dateType":"Updated","dateInformation":"v1"},{"date":"2026-08","dateType":"Available","dateInformation":"v1"}],"language":null,"types":{"schemaOrg":"CreativeWork","resourceTypeGeneral":"Preprint","citeproc":"article","bibtex":"misc","ris":"GEN","resourceType":"Article"},"relatedIdentifiers":[],"relatedItems":[],"sizes":[],"formats":[],"version":"1","rightsList":[{"rightsUri":"http://arxiv.org/licenses/nonexclusive-distrib/1.0/","rights":"arXiv.org perpetual, non-exclusive license"}],"descriptions":[{"descriptionType":"Abstract","description":"This work analyzes the feasibility of delay attacks on control signals transmitted via the Controllable Local System (CLS) channel of the German Smart Metering Infrastructure (SMI). It combines theoretical analysis with experimental validation under a threat model aligned to the Common Criteria Protection Profile for the Smart Meter Gateway (SMGW) and assess the potential impact on the power grid if the identified attack vector is exploited across multiple CLS channels simultaneously. We also outline mitigation strategies, including SMGW configuration restrictions, implementation-level changes, and protocol extensions.\n Our results show that an on-path attacker in the Wide Area Network (WAN) with sufficient contextual knowledge can feasibly execute delay attacks, with a theoretical upper bound of roughly 48 hours for some deployed protocol configurations. Projecting from a single CLS to several hundred thousand CLS devices indicates such an adversary could cause a significant frequency deviation potentially resulting in load shedding. Scaling the attack requires contextual knowledge for each targeted implementation and configuration; whether this knowledge can be broadly reused across CLS channels is uncertain but may become easier to obtain as standardization progresses.\n Time restricted transmissions in the FNN Steuerbox and in applications using CLS.EEDI are implementation-specific and can therefore be addressed by manufacturers. By contrast, ensuring application-data time limitations in TLS~1.3 requires protocol-level extensions. The TLS extensions proposed here offer a sustainable mitigation while preserving backward compatibility.\n Other communication channels outside the SMI (for example, proprietary remote terminal units used to control a CLS) are outside this work's scope and may exhibit similar or worse vulnerabilities."}],"geoLocations":[],"fundingReferences":[],"url":"https://arxiv.org/abs/2608.03751","contentUrl":null,"metadataVersion":0,"schemaVersion":"http://datacite.org/schema/kernel-4","source":"mds","isActive":true,"state":"findable","reason":null,"viewCount":0,"downloadCount":0,"referenceCount":0,"citationCount":0,"partCount":0,"partOfCount":0,"versionCount":0,"versionOfCount":0,"created":"2026-08-05T02:20:06Z","registered":"2026-08-05T02:20:07Z","published":null,"updated":"2026-08-05T02:20:07Z"},"relationships":{"client":{"data":{"id":"arxiv.content","type":"clients"}}}},{"id":"10.48550/arxiv.2608.03750","type":"dois","attributes":{"doi":"10.48550/arxiv.2608.03750","identifiers":[{"identifier":"2608.03750","identifierType":"arXiv"}],"creators":[{"nameType":"Personal","givenName":"Nho-Duc","familyName":"Tran","name":"Tran, Nho-Duc","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Aamir","familyName":"Mahmood","name":"Mahmood, Aamir","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Mikael","familyName":"Gidlund","name":"Gidlund, Mikael","affiliation":[],"nameIdentifiers":[]}],"titles":[{"title":"Predictive Triggering for Outage-Resilient Threshold Decisions over Short-Packet Links"}],"publisher":"arXiv","container":{},"publicationYear":2026,"subjects":[{"subject":"Information Theory (cs.IT)","lang":"en","subjectScheme":"arXiv"},{"subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"}],"contributors":[],"dates":[{"date":"2026-08-04T14:40:05Z","dateType":"Submitted","dateInformation":"v1"},{"date":"2026-08-05T00:58:52Z","dateType":"Updated","dateInformation":"v1"},{"date":"2026-08","dateType":"Available","dateInformation":"v1"}],"language":null,"types":{"schemaOrg":"CreativeWork","resourceTypeGeneral":"Preprint","citeproc":"article","bibtex":"misc","ris":"GEN","resourceType":"Article"},"relatedIdentifiers":[],"relatedItems":[],"sizes":[],"formats":[],"version":"1","rightsList":[{"rightsIdentifierScheme":"SPDX","rightsUri":"https://creativecommons.org/licenses/by-sa/4.0/legalcode","schemeUri":"https://spdx.org/licenses/","rights":"Creative Commons Attribution Share Alike 4.0 International","rightsIdentifier":"cc-by-sa-4.0"}],"descriptions":[{"descriptionType":"Abstract","description":"Remote threshold decisions require more than accurate state estimates: the posterior must support reliable alarm/no-alarm decisions and, when possible, anticipate early critical decisions. We study this problem over short-packet wireless links with outage risk. We derive false-positive/false-negative feasibility conditions that define a decision-feasible region of the estimation and yield a predictive decision-update trigger. To protect predictive updates from outages, we add AoI-controlled resilience updates that both detect disruptions and maintain freshness. A two-state Markov surrogate of the thresholded process, matched to its one-step switching statistics, enables tractable long-term reliability-energy analysis. Then, we jointly optimized transmit power and AoI-controlled resilience update probabilities. Simulations show earlier, reliable decisions at competitive energy with baselines."}],"geoLocations":[],"fundingReferences":[],"url":"https://arxiv.org/abs/2608.03750","contentUrl":null,"metadataVersion":0,"schemaVersion":"http://datacite.org/schema/kernel-4","source":"mds","isActive":true,"state":"findable","reason":null,"viewCount":0,"downloadCount":0,"referenceCount":0,"citationCount":0,"partCount":0,"partOfCount":0,"versionCount":0,"versionOfCount":0,"created":"2026-08-05T02:20:05Z","registered":null,"published":null,"updated":"2026-08-05T02:20:05Z"},"relationships":{"client":{"data":{"id":"arxiv.content","type":"clients"}}}},{"id":"10.48550/arxiv.2608.03748","type":"dois","attributes":{"doi":"10.48550/arxiv.2608.03748","identifiers":[{"identifier":"2608.03748","identifierType":"arXiv"}],"creators":[{"nameType":"Personal","givenName":"Hang","familyName":"Yu","name":"Yu, Hang","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Serdar","familyName":"Elhatisari","name":"Elhatisari, Serdar","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Sebastian","familyName":"König","name":"König, Sebastian","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Dean","familyName":"Lee","name":"Lee, Dean","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Yuan-Zhuo","familyName":"Ma","name":"Ma, Yuan-Zhuo","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Takayuki","familyName":"Miyagi","name":"Miyagi, Takayuki","affiliation":[],"nameIdentifiers":[]}],"titles":[{"title":"Constructing Effective Interactions via Projection-Based Inversion"}],"publisher":"arXiv","container":{},"publicationYear":2026,"subjects":[{"subject":"Nuclear Theory (nucl-th)","lang":"en","subjectScheme":"arXiv"},{"subject":"FOS: Physical sciences","subjectScheme":"Fields of Science and Technology (FOS)"}],"contributors":[],"dates":[{"date":"2026-08-04T14:39:38Z","dateType":"Submitted","dateInformation":"v1"},{"date":"2026-08-05T00:58:50Z","dateType":"Updated","dateInformation":"v1"},{"date":"2026-08","dateType":"Available","dateInformation":"v1"}],"language":null,"types":{"schemaOrg":"CreativeWork","resourceTypeGeneral":"Preprint","citeproc":"article","bibtex":"misc","ris":"GEN","resourceType":"Article"},"relatedIdentifiers":[],"relatedItems":[],"sizes":[],"formats":[],"version":"1","rightsList":[{"rightsUri":"http://arxiv.org/licenses/nonexclusive-distrib/1.0/","rights":"arXiv.org perpetual, non-exclusive license"}],"descriptions":[{"descriptionType":"Abstract","description":"We present a numerical prescription for extracting continuum scattering information from discrete spectra by constraining effective interactions inspired by effective field theory (EFT). Using a Multiparameter Eigenvalue Problem (MEP) emulator, we map energies to a sum of contact potentials by recasting the inverse problem as a linear eigenvalue equation. Because our method determines the effective interaction rather than the scattering amplitude, it can handle non-perturbative Coulomb interactions and different types of truncated Hilbert spaces without analytic quantization conditions. It therefore allows standard bound-state codes to be used for scattering calculations without modification. We validate this prescription across multiple ab initio frameworks using neutron-alpha scattering, alpha-alpha scattering with full Coulomb, and a prediction of proton-$^{14}$O resonances."},{"descriptionType":"Other","description":"5 pages, 3 figures"}],"geoLocations":[],"fundingReferences":[],"url":"https://arxiv.org/abs/2608.03748","contentUrl":null,"metadataVersion":0,"schemaVersion":"http://datacite.org/schema/kernel-4","source":"mds","isActive":true,"state":"findable","reason":null,"viewCount":0,"downloadCount":0,"referenceCount":0,"citationCount":0,"partCount":0,"partOfCount":0,"versionCount":0,"versionOfCount":0,"created":"2026-08-05T02:20:02Z","registered":"2026-08-05T02:20:03Z","published":null,"updated":"2026-08-05T02:20:03Z"},"relationships":{"client":{"data":{"id":"arxiv.content","type":"clients"}}}},{"id":"10.48550/arxiv.2608.03747","type":"dois","attributes":{"doi":"10.48550/arxiv.2608.03747","identifiers":[{"identifier":"2608.03747","identifierType":"arXiv"}],"creators":[{"nameType":"Personal","givenName":"Biswajit","familyName":"Sahoo","name":"Sahoo, Biswajit","affiliation":[],"nameIdentifiers":[]}],"titles":[{"title":"Logarithmic Soft Photon Theorem and Waveform Tails in Higher Dimensions"}],"publisher":"arXiv","container":{},"publicationYear":2026,"subjects":[{"subject":"High Energy Physics - Theory (hep-th)","lang":"en","subjectScheme":"arXiv"},{"subject":"General Relativity and Quantum Cosmology (gr-qc)","lang":"en","subjectScheme":"arXiv"},{"subject":"High Energy Physics - Phenomenology (hep-ph)","lang":"en","subjectScheme":"arXiv"},{"subject":"FOS: Physical sciences","subjectScheme":"Fields of Science and Technology (FOS)"}],"contributors":[],"dates":[{"date":"2026-08-04T14:39:32Z","dateType":"Submitted","dateInformation":"v1"},{"date":"2026-08-05T00:58:49Z","dateType":"Updated","dateInformation":"v1"},{"date":"2026-08","dateType":"Available","dateInformation":"v1"}],"language":null,"types":{"schemaOrg":"CreativeWork","resourceTypeGeneral":"Preprint","citeproc":"article","bibtex":"misc","ris":"GEN","resourceType":"Article"},"relatedIdentifiers":[],"relatedItems":[],"sizes":[],"formats":[],"version":"1","rightsList":[{"rightsIdentifierScheme":"SPDX","rightsUri":"https://creativecommons.org/licenses/by/4.0/legalcode","schemeUri":"https://spdx.org/licenses/","rights":"Creative Commons Attribution 4.0 International","rightsIdentifier":"cc-by-4.0"}],"descriptions":[{"descriptionType":"Abstract","description":"We derive the leading logarithmic soft-photon theorem in $d\u0026gt;4$ spacetime dimensions and its classical radiative counterpart. A direct one-loop analysis in massive scalar quantum electrodynamics (QED) yields a factorizing soft term of order $ω^{d-4}\\lnω$, although the charged-particle S-matrix is infrared finite. The logarithm is generated by the scale-invariant loop-momentum region $ω\\ll|\\ell|\\llΛ$, where $Λ$ denotes a characteristic hard-particle energy scale. At leading radiative order, the corresponding logarithmic contribution to the classical electromagnetic waveform arises from the long-range acceleration of the asymptotic charged particles. In even $d\\geq6$, the straight-line waveform at this radiative order is distributionally supported in retarded time within an interval whose width is set by the characteristic size of the hard-scattering region, whereas the logarithmic acceleration term produces universal early- and late-time radiative tails proportional to $|u|^{-(3d-10)/2}$. In odd $d\\geq5$, straight-line motion already gives a late-time tail at the same radiative order proportional to $u^{-(d-4)/2}$. The acceleration correction adds universal late- and early-time terms proportional, respectively, to $\\ln u/u^{(3d-10)/2}$ and $|u|^{-(3d-10)/2}$. A comparison of Feynman and retarded boundary conditions separates the classically radiative contribution from the intrinsically quantum part of the logarithmic soft factor."},{"descriptionType":"Other","description":"13 pages + derivation"}],"geoLocations":[],"fundingReferences":[],"url":"https://arxiv.org/abs/2608.03747","contentUrl":null,"metadataVersion":0,"schemaVersion":"http://datacite.org/schema/kernel-4","source":"mds","isActive":true,"state":"findable","reason":null,"viewCount":0,"downloadCount":0,"referenceCount":0,"citationCount":0,"partCount":0,"partOfCount":0,"versionCount":0,"versionOfCount":0,"created":"2026-08-05T02:20:01Z","registered":"2026-08-05T02:20:01Z","published":null,"updated":"2026-08-05T02:20:01Z"},"relationships":{"client":{"data":{"id":"arxiv.content","type":"clients"}}}},{"id":"10.48550/arxiv.2608.03746","type":"dois","attributes":{"doi":"10.48550/arxiv.2608.03746","identifiers":[{"identifier":"2608.03746","identifierType":"arXiv"}],"creators":[{"nameType":"Personal","givenName":"Matteo","familyName":"Becchetti","name":"Becchetti, Matteo","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Dhimiter","familyName":"Canko","name":"Canko, Dhimiter","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Xiang","familyName":"Chen","name":"Chen, Xiang","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Vsevolod","familyName":"Chestnov","name":"Chestnov, Vsevolod","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Maximilian","familyName":"Delto","name":"Delto, Maximilian","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Sara","familyName":"Ditsch","name":"Ditsch, Sara","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Tiziano","familyName":"Peraro","name":"Peraro, Tiziano","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Mattia","familyName":"Pozzoli","name":"Pozzoli, Mattia","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Chiara","familyName":"Savoini","name":"Savoini, Chiara","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Simone","familyName":"Zoia","name":"Zoia, Simone","affiliation":[],"nameIdentifiers":[]}],"titles":[{"title":"Two-loop QCD amplitudes for $t\\bar{t}W$ production at the LHC in the leading-colour approximation"}],"publisher":"arXiv","container":{},"publicationYear":2026,"subjects":[{"subject":"High Energy Physics - Phenomenology (hep-ph)","lang":"en","subjectScheme":"arXiv"},{"subject":"High Energy Physics - Theory (hep-th)","lang":"en","subjectScheme":"arXiv"},{"subject":"FOS: Physical sciences","subjectScheme":"Fields of Science and Technology (FOS)"}],"contributors":[],"dates":[{"date":"2026-08-04T14:39:09Z","dateType":"Submitted","dateInformation":"v1"},{"date":"2026-08-05T00:58:48Z","dateType":"Updated","dateInformation":"v1"},{"date":"2026-08","dateType":"Available","dateInformation":"v1"}],"language":null,"types":{"schemaOrg":"CreativeWork","resourceTypeGeneral":"Preprint","citeproc":"article","bibtex":"misc","ris":"GEN","resourceType":"Article"},"relatedIdentifiers":[],"relatedItems":[],"sizes":[],"formats":[],"version":"1","rightsList":[{"rightsIdentifierScheme":"SPDX","rightsUri":"https://creativecommons.org/licenses/by/4.0/legalcode","schemeUri":"https://spdx.org/licenses/","rights":"Creative Commons Attribution 4.0 International","rightsIdentifier":"cc-by-4.0"}],"descriptions":[{"descriptionType":"Abstract","description":"We present a numerical computation of the two-loop QCD scattering amplitudes for the production of a top-antitop quark pair in association with a $W$ boson ($t\\bar{t}W$) at the LHC in the generalised leading-colour approximation, retaining the exact dependence on the top-quark and $W$-boson masses. Rather than pursuing a fully analytic calculation, we employ a hybrid framework that combines numerical evaluation with strong algebraic and analytic control, allowing ultraviolet and infrared singularities as well as large intermediate cancellations to be treated exactly. This is achieved by expressing the finite remainder in terms of a set of special functions with rational coefficients. The special functions are evaluated numerically by solving differential equations through power-series expansions, while the values of the rational coefficients are reconstructed, point by point, from finite-field evaluations. The calculation is performed in the 't Hooft-Veltman scheme and validated against an independent implementation in conventional dimensional regularisation employing a substantially different computational strategy. We finally provide the colour- and polarisation-summed hard functions evaluated on the phase-space grid used in a previous computation of the next-to-next-to-leading-order QCD corrections to the $t\\bar{t}W$ cross section."},{"descriptionType":"Other","description":"28 pages, 6 tables, 1 figure, 2 appendices, ancillary files are available at https://doi.org/10.5281/zenodo.21741495"}],"geoLocations":[],"fundingReferences":[],"url":"https://arxiv.org/abs/2608.03746","contentUrl":null,"metadataVersion":0,"schemaVersion":"http://datacite.org/schema/kernel-4","source":"mds","isActive":true,"state":"findable","reason":null,"viewCount":0,"downloadCount":0,"referenceCount":0,"citationCount":0,"partCount":0,"partOfCount":0,"versionCount":0,"versionOfCount":0,"created":"2026-08-05T02:19:59Z","registered":"2026-08-05T02:20:00Z","published":null,"updated":"2026-08-05T02:20:00Z"},"relationships":{"client":{"data":{"id":"arxiv.content","type":"clients"}}}},{"id":"10.48550/arxiv.2608.03745","type":"dois","attributes":{"doi":"10.48550/arxiv.2608.03745","identifiers":[{"identifier":"2608.03745","identifierType":"arXiv"}],"creators":[{"nameType":"Personal","givenName":"Dominik","familyName":"Meier","name":"Meier, Dominik","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Luca Joshua","familyName":"Francis","name":"Francis, Luca Joshua","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Marco Bernhard","familyName":"Kaiser","name":"Kaiser, Marco Bernhard","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Terry","familyName":"Ruas","name":"Ruas, Terry","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Jan Philip","familyName":"Wahle","name":"Wahle, Jan Philip","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Bela","familyName":"Gipp","name":"Gipp, Bela","affiliation":[],"nameIdentifiers":[]}],"titles":[{"title":"Risky Business: Measuring The Faithfulness-Safety Tension"}],"publisher":"arXiv","container":{},"publicationYear":2026,"subjects":[{"subject":"Artificial Intelligence (cs.AI)","lang":"en","subjectScheme":"arXiv"},{"subject":"Computation and Language (cs.CL)","lang":"en","subjectScheme":"arXiv"},{"subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"},{"subject":"I.2.7","lang":"en","subjectScheme":"ACM"}],"contributors":[],"dates":[{"date":"2026-08-04T14:38:06Z","dateType":"Submitted","dateInformation":"v1"},{"date":"2026-08-05T00:58:47Z","dateType":"Updated","dateInformation":"v1"},{"date":"2026-08","dateType":"Available","dateInformation":"v1"}],"language":null,"types":{"schemaOrg":"CreativeWork","resourceTypeGeneral":"Preprint","citeproc":"article","bibtex":"misc","ris":"GEN","resourceType":"Article"},"relatedIdentifiers":[],"relatedItems":[],"sizes":[],"formats":[],"version":"1","rightsList":[{"rightsIdentifierScheme":"SPDX","rightsUri":"https://creativecommons.org/licenses/by-nc-sa/4.0/legalcode","schemeUri":"https://spdx.org/licenses/","rights":"Creative Commons Attribution Non Commercial Share Alike 4.0 International","rightsIdentifier":"cc-by-nc-sa-4.0"}],"descriptions":[{"descriptionType":"Abstract","description":"Chain-of-Thought (CoT) reasoning offers a promising window into model monitoring. However, monitoring relies on faithfulness, i.e., the model output strictly derives from its reasoning trace. We identify an alignment tension where a model must be faithful enough to be monitored, yet robust enough to reject unsafe reasoning. We demonstrate that this counterbalance exists in current Large Reasoning Models (LRMs), and show ways in which it can be addressed. We introduce HazMart, a human-written dataset set in an autonomous AI shopkeeper scenario. Unlike prior work that relies on providing hints in prompts to test faithfulness (e.g., \"A Stanford professor said it should be Answer A\"), we propose a novel replacement-based technique, which we call Targeted Reasoning Replacement (TRR), that directly intervenes in the reasoning chain to substitute in unsafe or illogical thoughts (e.g., \"Wait, the answer must be Option B [was Option A] because it is the most fitting\"). DeepSeek-R1-Llama-70B exhibits high faithfulness (97.5%) but fails to reject Unsafe Reasoning (12.3%), while QwQ-32B is more robust (73.9% safety) at the cost of lower faithfulness (74.7%). Mechanistic analyses of QwQ-32B reveal that these properties are represented by anti-correlated internal directions peaking at the action-commit token. Finally, we demonstrate that representation steering can independently amplify the safety direction, increasing safe behavior by 9 percentage points while maintaining base capabilities."}],"geoLocations":[],"fundingReferences":[],"url":"https://arxiv.org/abs/2608.03745","contentUrl":null,"metadataVersion":0,"schemaVersion":"http://datacite.org/schema/kernel-4","source":"mds","isActive":true,"state":"findable","reason":null,"viewCount":0,"downloadCount":0,"referenceCount":0,"citationCount":0,"partCount":0,"partOfCount":0,"versionCount":0,"versionOfCount":0,"created":"2026-08-05T02:19:58Z","registered":"2026-08-05T02:19:59Z","published":null,"updated":"2026-08-05T02:19:59Z"},"relationships":{"client":{"data":{"id":"arxiv.content","type":"clients"}}}},{"id":"10.48550/arxiv.2608.03743","type":"dois","attributes":{"doi":"10.48550/arxiv.2608.03743","identifiers":[{"identifier":"2608.03743","identifierType":"arXiv"}],"creators":[{"nameType":"Personal","givenName":"Chao","familyName":"Peng","name":"Peng, Chao","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Ruida","familyName":"Hu","name":"Hu, Ruida","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Ajitha","familyName":"Rajan","name":"Rajan, Ajitha","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Tegawendé F","familyName":"Bissyandé","name":"Bissyandé, Tegawendé F","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Jacques","familyName":"Klein","name":"Klein, Jacques","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Cuiyun","familyName":"Gao","name":"Gao, Cuiyun","affiliation":[],"nameIdentifiers":[]}],"titles":[{"title":"Can LLMs Test Terminal User Interfaces?"}],"publisher":"arXiv","container":{},"publicationYear":2026,"subjects":[{"subject":"Software Engineering (cs.SE)","lang":"en","subjectScheme":"arXiv"},{"subject":"Artificial Intelligence (cs.AI)","lang":"en","subjectScheme":"arXiv"},{"subject":"Machine Learning (cs.LG)","lang":"en","subjectScheme":"arXiv"},{"subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"}],"contributors":[],"dates":[{"date":"2026-08-04T14:36:44Z","dateType":"Submitted","dateInformation":"v1"},{"date":"2026-08-05T00:58:45Z","dateType":"Updated","dateInformation":"v1"},{"date":"2026-08","dateType":"Available","dateInformation":"v1"}],"language":null,"types":{"schemaOrg":"CreativeWork","resourceTypeGeneral":"Preprint","citeproc":"article","bibtex":"misc","ris":"GEN","resourceType":"Article"},"relatedIdentifiers":[],"relatedItems":[],"sizes":[],"formats":[],"version":"1","rightsList":[{"rightsIdentifierScheme":"SPDX","rightsUri":"https://creativecommons.org/licenses/by/4.0/legalcode","schemeUri":"https://spdx.org/licenses/","rights":"Creative Commons Attribution 4.0 International","rightsIdentifier":"cc-by-4.0"}],"descriptions":[{"descriptionType":"Abstract","description":"Terminal User Interfaces (TUIs) combine the stateful, screen-oriented behaviour of GUIs with terminal deployment and are now common in developer tools. Yet they lack a dedicated testing methodology. We survey 197 real-world TUI applications: only 12% of test code exercises the interface, and 45% of those tests never send input, checking a static frame instead. We turn these applications into a headless benchmark spanning ratatui/Rust, bubbletea/Go, textual/Python, and ink/TypeScript, packaging each as an instrumented Docker image. We record line and widget coverage where reliable, rendered terminal states, and crashes. Under equal wall-clock budgets, we compare four frontier LLMs with random exploration. No model dominates. Random is a strong time-budgeted baseline, but its crash advantage comes from higher throughput: per interaction, LLM guidance is more efficient and uniquely reaches input-gated faults. Automatically deriving launch inputs yields the largest practical gain, enabling applications that otherwise never start. Line coverage poorly predicts crash discovery, weakening it as a proxy for test effectiveness. Automated TUI testing is feasible but far from solved, and honest baselines matter more than model choice. We release the coverage tool tuicov at https://github.com/tui-testing/tuicov and the testing framework tuibot at https://github.com/tui-testing/tuibot."}],"geoLocations":[],"fundingReferences":[],"url":"https://arxiv.org/abs/2608.03743","contentUrl":null,"metadataVersion":0,"schemaVersion":"http://datacite.org/schema/kernel-4","source":"mds","isActive":true,"state":"findable","reason":null,"viewCount":0,"downloadCount":0,"referenceCount":0,"citationCount":0,"partCount":0,"partOfCount":0,"versionCount":0,"versionOfCount":0,"created":"2026-08-05T02:19:55Z","registered":"2026-08-05T02:19:56Z","published":null,"updated":"2026-08-05T02:19:56Z"},"relationships":{"client":{"data":{"id":"arxiv.content","type":"clients"}}}},{"id":"10.48550/arxiv.2608.03742","type":"dois","attributes":{"doi":"10.48550/arxiv.2608.03742","identifiers":[{"identifier":"2608.03742","identifierType":"arXiv"}],"creators":[{"nameType":"Personal","givenName":"Sandy","familyName":"Abdo","name":"Abdo, Sandy","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Bill","familyName":"Kapralos","name":"Kapralos, Bill","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Priyamvada","familyName":"Tripathi","name":"Tripathi, Priyamvada","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"KC","familyName":"Collins","name":"Collins, KC","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Adam","familyName":"Dubrowski","name":"Dubrowski, Adam","affiliation":[],"nameIdentifiers":[]}],"titles":[{"title":"AI-Based Sound Effect Generation: A Narrative Review of Generative Models Across Input Modalities"}],"publisher":"arXiv","container":{},"publicationYear":2026,"subjects":[{"subject":"Sound (cs.SD)","lang":"en","subjectScheme":"arXiv"},{"subject":"Artificial Intelligence (cs.AI)","lang":"en","subjectScheme":"arXiv"},{"subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"}],"contributors":[],"dates":[{"date":"2026-08-04T14:36:34Z","dateType":"Submitted","dateInformation":"v1"},{"date":"2026-08-05T00:58:44Z","dateType":"Updated","dateInformation":"v1"},{"date":"2026-08","dateType":"Available","dateInformation":"v1"}],"language":null,"types":{"schemaOrg":"CreativeWork","resourceTypeGeneral":"Preprint","citeproc":"article","bibtex":"misc","ris":"GEN","resourceType":"Article"},"relatedIdentifiers":[],"relatedItems":[],"sizes":[],"formats":[],"version":"1","rightsList":[{"rightsIdentifierScheme":"SPDX","rightsUri":"https://creativecommons.org/licenses/by-nc-nd/4.0/legalcode","schemeUri":"https://spdx.org/licenses/","rights":"Creative Commons Attribution Non Commercial No Derivatives 4.0 International","rightsIdentifier":"cc-by-nc-nd-4.0"}],"descriptions":[{"descriptionType":"Abstract","description":"Sound effects play a crucial role in conveying actions, events, and environmental cues across digital applications, often requiring a high degree of variation and contextual adaptability. Artificial intelligence (AI)-driven audio generative models are rapidly growing in popularity and have the potential to transform the way sound is synthesized and used across various applications. In response to this growing momentum, this chapter reviews and analyzes recent AI-based generative models for sound effect synthesis, with a focus on how different input modalities (text, visual, audio, and multimodal) affect the quality, controllability, and contextual relevance of the generated audio. It examines 30 peer-reviewed articles sourced from Google Scholar, IEEE Xplore, and the ACM Digital Library, exploring the evolution of AI generative models over the past five years. The results show that multiple models achieved state-of-the-art performance, producing high-fidelity, semantically aligned, and increasingly temporally coherent sound effects across tasks. However, despite these advances, the review identifies persistent challenges, including limitations in temporal synchronization for complex multi-event scenarios, gaps between objective metrics and human perception, and trade-offs between controllability and generative diversity. Overall, the chapter highlights that AI-driven sound effect generation is progressing toward more adaptive, scalable, and context-aware systems, offering significant implications for future sound design workflows and interactive media applications."},{"descriptionType":"Other","description":"29 pages, 5 figures, to appear in G. A. Tsihrintzis, M. Virvou, N. Bourbakis, and L. C. Jain (Eds.), Advances in Global Applied Artificial Intelligence: Springer, Learning and Analytics in Intelligent Systems Book Series"}],"geoLocations":[],"fundingReferences":[],"url":"https://arxiv.org/abs/2608.03742","contentUrl":null,"metadataVersion":0,"schemaVersion":"http://datacite.org/schema/kernel-4","source":"mds","isActive":true,"state":"findable","reason":null,"viewCount":0,"downloadCount":0,"referenceCount":0,"citationCount":0,"partCount":0,"partOfCount":0,"versionCount":0,"versionOfCount":0,"created":"2026-08-05T02:19:54Z","registered":"2026-08-05T02:19:55Z","published":null,"updated":"2026-08-05T02:19:55Z"},"relationships":{"client":{"data":{"id":"arxiv.content","type":"clients"}}}},{"id":"10.48550/arxiv.2608.03741","type":"dois","attributes":{"doi":"10.48550/arxiv.2608.03741","identifiers":[{"identifier":"2608.03741","identifierType":"arXiv"}],"creators":[{"nameType":"Personal","givenName":"Przemyslaw","familyName":"Forys","name":"Forys, Przemyslaw","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Haoran","familyName":"Wu","name":"Wu, Haoran","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Can","familyName":"Xiao","name":"Xiao, Can","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Jiayi","familyName":"Nie","name":"Nie, Jiayi","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Tony","familyName":"Liu","name":"Liu, Tony","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Rika","familyName":"Antonova","name":"Antonova, Rika","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Timothy","familyName":"Jones","name":"Jones, Timothy","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Robert","familyName":"Mullins","name":"Mullins, Robert","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Wayne","familyName":"Luk","name":"Luk, Wayne","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Aaron","familyName":"Zhao","name":"Zhao, Aaron","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"George A.","familyName":"Constantinides","name":"Constantinides, George A.","affiliation":[],"nameIdentifiers":[]}],"titles":[{"title":"When Does Disaggregation Pay? Simulating Prefill--Decode--Attention--FFN Specialization for Agentic LLM Inference"}],"publisher":"arXiv","container":{},"publicationYear":2026,"subjects":[{"subject":"Distributed, Parallel, and Cluster Computing (cs.DC)","lang":"en","subjectScheme":"arXiv"},{"subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"}],"contributors":[],"dates":[{"date":"2026-08-04T14:35:25Z","dateType":"Submitted","dateInformation":"v1"},{"date":"2026-08-05T00:58:43Z","dateType":"Updated","dateInformation":"v1"},{"date":"2026-08","dateType":"Available","dateInformation":"v1"}],"language":null,"types":{"schemaOrg":"CreativeWork","resourceTypeGeneral":"Preprint","citeproc":"article","bibtex":"misc","ris":"GEN","resourceType":"Article"},"relatedIdentifiers":[],"relatedItems":[],"sizes":[],"formats":[],"version":"1","rightsList":[{"rightsIdentifierScheme":"SPDX","rightsUri":"https://creativecommons.org/licenses/by/4.0/legalcode","schemeUri":"https://spdx.org/licenses/","rights":"Creative Commons Attribution 4.0 International","rightsIdentifier":"cc-by-4.0"}],"descriptions":[{"descriptionType":"Abstract","description":"Agentic inference now dominates the LLM inference landscape, requiring LLMs to actively engage in multi-turn interactions with tool-calling capabilities. This introduces a more complex workload for the underlying inference system: serving stages such as prefill and decode exhibit substantially different behaviors and demand distinct compute and memory-bandwidth capabilities. As a result, a single homogeneous GPU system now struggles to support agentic inference, motivating an industry shift toward heterogeneous systems with disaggregated serving capabilities, such as the emerging Vera-Rubin platform with GPUs and Groq LPUs. However, the question of what the optimal hardware should look like for each component in a heterogeneous system remains underexplored. To this end, we propose a novel simulation framework for disaggregated serving, termed \\textbf{HeteroPanacea}, that enables system-level simulation across three dimensions: 1) disaggregated quantization, 2) automated intra- and inter-device parallelization scheduling, and 3) PDAF (prefill-decode-attention-FFN) NPU architectural heterogeneity. By combining these three axes, we provide a cross-stack simulation framework for future heterogeneous agentic serving systems. We confirm the benefit of Prefill Decode disaggregation, simulating increased serving throughput by up to 75\\% compared to traditional serving with current GPUs and demonstrate 4 way Prefill Decode Attention FFN disaggregation is the most consistent for increasing throughput across different models, assuming custom NPUs. We also investigate the relationship between model architecture and gain from disaggregation by running a set of ablation studies."}],"geoLocations":[],"fundingReferences":[],"url":"https://arxiv.org/abs/2608.03741","contentUrl":null,"metadataVersion":0,"schemaVersion":"http://datacite.org/schema/kernel-4","source":"mds","isActive":true,"state":"findable","reason":null,"viewCount":0,"downloadCount":0,"referenceCount":0,"citationCount":0,"partCount":0,"partOfCount":0,"versionCount":0,"versionOfCount":0,"created":"2026-08-05T02:19:53Z","registered":"2026-08-05T02:19:53Z","published":null,"updated":"2026-08-05T02:19:53Z"},"relationships":{"client":{"data":{"id":"arxiv.content","type":"clients"}}}},{"id":"10.48550/arxiv.2608.03740","type":"dois","attributes":{"doi":"10.48550/arxiv.2608.03740","identifiers":[{"identifier":"2608.03740","identifierType":"arXiv"}],"creators":[{"nameType":"Personal","givenName":"Yu","familyName":"Ran","name":"Ran, Yu","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Wentao","familyName":"Zhao","name":"Zhao, Wentao","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Xin","familyName":"Zhang","name":"Zhang, Xin","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Yi","familyName":"Pan","name":"Pan, Yi","affiliation":[],"nameIdentifiers":[]}],"titles":[{"title":"MissClick: Exploiting Digit-Serialized Coordinates to Attack GUI Grounding Models"}],"publisher":"arXiv","container":{},"publicationYear":2026,"subjects":[{"subject":"Artificial Intelligence (cs.AI)","lang":"en","subjectScheme":"arXiv"},{"subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"}],"contributors":[],"dates":[{"date":"2026-08-04T14:34:41Z","dateType":"Submitted","dateInformation":"v1"},{"date":"2026-08-05T00:58:39Z","dateType":"Updated","dateInformation":"v1"},{"date":"2026-08","dateType":"Available","dateInformation":"v1"}],"language":null,"types":{"schemaOrg":"CreativeWork","resourceTypeGeneral":"Preprint","citeproc":"article","bibtex":"misc","ris":"GEN","resourceType":"Article"},"relatedIdentifiers":[],"relatedItems":[],"sizes":[],"formats":[],"version":"1","rightsList":[{"rightsIdentifierScheme":"SPDX","rightsUri":"https://creativecommons.org/licenses/by/4.0/legalcode","schemeUri":"https://spdx.org/licenses/","rights":"Creative Commons Attribution 4.0 International","rightsIdentifier":"cc-by-4.0"}],"descriptions":[{"descriptionType":"Abstract","description":"Recent GUI visual grounding models generate screen coordinates as sequences of digit tokens that are parsed into numerical values and mapped to executable clicks. The security implications of this coordinate generation process have been largely overlooked. We observe that each coordinate digit is predicted as a categorical token, yet after parsing, changing a hundreds-place digit by one changes the corresponding numerical coordinate component by 100 units, which can induce a large displacement of the executed click. This observation motivates attack objectives that account for the numerical and place-value structure of coordinate outputs rather than treating them as ordinary text. Moreover, untargeted and targeted attacks impose different success conditions--displacing the click outside the correct region versus into an attacker-specified region--and therefore benefit from different objectives. We propose MissClick, a simple and effective white-box adversarial attack with two goal-specific objectives: MissClick-U maximizes soft-coordinate displacement for untargeted disruption, while MissClick-T minimizes a place-weighted target-digit loss for targeted hijacking. Compared with existing attacks against GUI grounding models on OS-Atlas and UGround across desktop, web, and mobile platforms, MissClick-U achieves untargeted success rates of 75.07\\% and 72.93\\% (+16.62 and +30.72 pp), and MissClick-T achieves targeted success rates of 44.86\\% and 62.67\\% (+31.73 and +47.06 pp). Attack objective comparison further shows that soft-coordinate displacement yields the highest untargeted attack success rate, whereas place-weighted target-digit optimization yields the highest targeted attack success rate, revealing distinct objective preferences for the two attack goals."}],"geoLocations":[],"fundingReferences":[],"url":"https://arxiv.org/abs/2608.03740","contentUrl":null,"metadataVersion":0,"schemaVersion":"http://datacite.org/schema/kernel-4","source":"mds","isActive":true,"state":"findable","reason":null,"viewCount":0,"downloadCount":0,"referenceCount":0,"citationCount":0,"partCount":0,"partOfCount":0,"versionCount":0,"versionOfCount":0,"created":"2026-08-05T02:19:51Z","registered":null,"published":null,"updated":"2026-08-05T02:19:52Z"},"relationships":{"client":{"data":{"id":"arxiv.content","type":"clients"}}}},{"id":"10.48550/arxiv.2608.03738","type":"dois","attributes":{"doi":"10.48550/arxiv.2608.03738","identifiers":[{"identifier":"2608.03738","identifierType":"arXiv"}],"creators":[{"nameType":"Personal","givenName":"Shuo","familyName":"Ren","name":"Ren, Shuo","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Yaohui","familyName":"Han","name":"Han, Yaohui","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Libo","familyName":"Shen","name":"Shen, Libo","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Zhiqiang","familyName":"Jia","name":"Jia, Zhiqiang","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Rongliang","familyName":"Fu","name":"Fu, Rongliang","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Bei","familyName":"Yu","name":"Yu, Bei","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Tsung-Yi","familyName":"Ho","name":"Ho, Tsung-Yi","affiliation":[],"nameIdentifiers":[]}],"titles":[{"title":"AgenticECO: An Agentic Framework for ECO on 3D Integrated Circuits"}],"publisher":"arXiv","container":{},"publicationYear":2026,"subjects":[{"subject":"Artificial Intelligence (cs.AI)","lang":"en","subjectScheme":"arXiv"},{"subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"}],"contributors":[],"dates":[{"date":"2026-08-04T14:32:43Z","dateType":"Submitted","dateInformation":"v1"},{"date":"2026-08-05T00:58:36Z","dateType":"Updated","dateInformation":"v1"},{"date":"2026-08","dateType":"Available","dateInformation":"v1"}],"language":null,"types":{"schemaOrg":"CreativeWork","resourceTypeGeneral":"Preprint","citeproc":"article","bibtex":"misc","ris":"GEN","resourceType":"Article"},"relatedIdentifiers":[],"relatedItems":[],"sizes":[],"formats":[],"version":"1","rightsList":[{"rightsUri":"http://arxiv.org/licenses/nonexclusive-distrib/1.0/","rights":"arXiv.org perpetual, non-exclusive license"}],"descriptions":[{"descriptionType":"Abstract","description":"As Moore's law slows, the industry is turning to three-dimensional integration; yet in merged 3D-IC flows, routed designs expose bond-level defects with no 2D analogue, and post-route engineering change orders (ECO) remain manual, expertise-bound work. Worse, the standard edit-then-fully-reroute practice entangles a repair with router churn, so a signoff number cannot be attributed to the edit that motivated it. We present AgenticECO, an evidence-gated tool-using agent workflow for 3D-IC ECO on the open-source TaiWei flow, paired with EcoRoute, a minimal-disturbance ECO-routing layer that drives the unmodified pinned router so a repair is attributable to its edit. Across nine matched natural defect cases under identical budgets, AgenticECO clears seven versus two for both full reroute and stock repair, at 0.66\\% mean disturbance over cleared cases and zero clock nets touched, and a cross-backbone rerun under the same sealed contract clears all nine. Controlled studies show that the repair moves are necessary under preservation, that occupancy-aware choice buys legal landings rather than repair success, and that under tightened clocks minimal disturbance flips accept versus reject. Three preregistered visual studies localize the pixel instrument's edge to contested landing sites, and a preregistered blind diagnostic exactly restores every held-out injected defect, the only arm with zero wrong edits. Every accepted result passes routing, fresh extraction, max/min timing, DRC, and structural-equivalence gates. Code, environment, and per-episode audit artifacts are released as supplementary material."},{"descriptionType":"Other","description":"20 pages, 12 figures"}],"geoLocations":[],"fundingReferences":[],"url":"https://arxiv.org/abs/2608.03738","contentUrl":null,"metadataVersion":0,"schemaVersion":"http://datacite.org/schema/kernel-4","source":"mds","isActive":true,"state":"findable","reason":null,"viewCount":0,"downloadCount":0,"referenceCount":0,"citationCount":0,"partCount":0,"partOfCount":0,"versionCount":0,"versionOfCount":0,"created":"2026-08-05T02:19:49Z","registered":"2026-08-05T02:19:49Z","published":null,"updated":"2026-08-05T02:19:49Z"},"relationships":{"client":{"data":{"id":"arxiv.content","type":"clients"}}}},{"id":"10.48550/arxiv.2608.03737","type":"dois","attributes":{"doi":"10.48550/arxiv.2608.03737","identifiers":[{"identifier":"2608.03737","identifierType":"arXiv"}],"creators":[{"nameType":"Personal","givenName":"Sandaru","familyName":"Jayawardana","name":"Jayawardana, Sandaru","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Sennur","familyName":"Ulukus","name":"Ulukus, Sennur","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Ming","familyName":"Ding","name":"Ding, Ming","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Kanchana","familyName":"Thilakarathna","name":"Thilakarathna, Kanchana","affiliation":[],"nameIdentifiers":[]}],"titles":[{"title":"Dependency Triad: A Metric to Quantify the Dependencies Between Attributes for Local Differential Privacy"}],"publisher":"arXiv","container":{},"publicationYear":2026,"subjects":[{"subject":"Cryptography and Security (cs.CR)","lang":"en","subjectScheme":"arXiv"},{"subject":"Information Theory (cs.IT)","lang":"en","subjectScheme":"arXiv"},{"subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"}],"contributors":[],"dates":[{"date":"2026-08-04T14:30:55Z","dateType":"Submitted","dateInformation":"v1"},{"date":"2026-08-05T00:58:28Z","dateType":"Updated","dateInformation":"v1"},{"date":"2026-08","dateType":"Available","dateInformation":"v1"}],"language":null,"types":{"schemaOrg":"CreativeWork","resourceTypeGeneral":"Preprint","citeproc":"article","bibtex":"misc","ris":"GEN","resourceType":"Article"},"relatedIdentifiers":[],"relatedItems":[],"sizes":[],"formats":[],"version":"1","rightsList":[{"rightsIdentifierScheme":"SPDX","rightsUri":"https://creativecommons.org/licenses/by/4.0/legalcode","schemeUri":"https://spdx.org/licenses/","rights":"Creative Commons Attribution 4.0 International","rightsIdentifier":"cc-by-4.0"}],"descriptions":[{"descriptionType":"Abstract","description":"Collecting multidimensional user data is essential for extracting rich insights across various applications. Local Differential Privacy (LDP) has emerged as a de facto standard for mitigating privacy risks in such scenarios. A key challenge in privacy-preserving multidimensional data collection lies in inter-attribute dependencies, as they can inadvertently reveal correlated information and increase privacy vulnerabilities. Therefore, accurately measuring correlation-induced privacy leakage (CPL) is essential for privacy analysis and privacy-utility trade-off. However, existing CPL analysis solutions either require accurate prior knowledge or face scalability challenges for large numbers of attributes and high-cardinality attributes. These limit their practical applicability in real data. To address this research gap, we propose a novel metric, ``Dependency Triad'' (DT), which summarizes the pairwise dependency information relevant to CPL using three parameters and yields a \\emph{constant-time} conservative estimator of pairwise CPL. DT explicitly models uncertainty in prior distributional knowledge through its parameters, delivering robust leakage estimates. Moreover, its robustness to sparse distributions makes it particularly suitable for high-cardinality attributes, while the pairwise formulation serves as a tractable building block for assessing total leakage in multidimensional settings. Extensive experiments on both synthetic and real datasets demonstrate that DT consistently estimates CPL across diverse dependency regimes and prior uncertainties."},{"descriptionType":"Other","description":"Accepted for publication at the 2026 ACM SIGSAC Conference on Computer and Communications Security (ACM CCS 2026)"}],"geoLocations":[],"fundingReferences":[],"url":"https://arxiv.org/abs/2608.03737","contentUrl":null,"metadataVersion":0,"schemaVersion":"http://datacite.org/schema/kernel-4","source":"mds","isActive":true,"state":"findable","reason":null,"viewCount":0,"downloadCount":0,"referenceCount":0,"citationCount":0,"partCount":0,"partOfCount":0,"versionCount":0,"versionOfCount":0,"created":"2026-08-05T02:19:47Z","registered":null,"published":null,"updated":"2026-08-05T02:19:48Z"},"relationships":{"client":{"data":{"id":"arxiv.content","type":"clients"}}}},{"id":"10.48550/arxiv.2608.03736","type":"dois","attributes":{"doi":"10.48550/arxiv.2608.03736","identifiers":[{"identifier":"2608.03736","identifierType":"arXiv"}],"creators":[{"nameType":"Personal","givenName":"Sam","familyName":"Kuypers","name":"Kuypers, Sam","affiliation":[],"nameIdentifiers":[]}],"titles":[{"title":"Preserving Symmetry: Spontaneous Symmetry Breaking through Decoherence"}],"publisher":"arXiv","container":{},"publicationYear":2026,"subjects":[{"subject":"Quantum Physics (quant-ph)","lang":"en","subjectScheme":"arXiv"},{"subject":"FOS: Physical sciences","subjectScheme":"Fields of Science and Technology (FOS)"}],"contributors":[],"dates":[{"date":"2026-08-04T14:30:28Z","dateType":"Submitted","dateInformation":"v1"},{"date":"2026-08-05T00:58:27Z","dateType":"Updated","dateInformation":"v1"},{"date":"2026-08","dateType":"Available","dateInformation":"v1"}],"language":null,"types":{"schemaOrg":"CreativeWork","resourceTypeGeneral":"Preprint","citeproc":"article","bibtex":"misc","ris":"GEN","resourceType":"Article"},"relatedIdentifiers":[],"relatedItems":[],"sizes":[],"formats":[],"version":"1","rightsList":[{"rightsUri":"http://arxiv.org/licenses/nonexclusive-distrib/1.0/","rights":"arXiv.org perpetual, non-exclusive license"}],"descriptions":[{"descriptionType":"Abstract","description":"Solids appear to have localised centres of mass, yet many-body quantum theory describes them using translationally symmetric models that preclude localisation. Conventionally, this is resolved through spontaneous symmetry breaking by introducing an interaction with a semiclassical environment that breaks the symmetry. In the thermodynamic limit, the interaction can be removed while leaving the state localised. This, however, raises the question of how localisation arises outside the thermodynamic limit, i.e., in finite quantum systems (Wallace, 2018). Here, we show that, by quantising the environment, the localisation of finite systems occurs within decoherent branches, while the state vector of the composite system remains translationally symmetric. Our approach is analogous to the Page-Wootters construction (Page \u0026amp; Wootters, 1983) and quantum reference frames; moreover, we recover the semiclassical description as a limiting case while predicting experimentally distinguishable corrections away from this limit."}],"geoLocations":[],"fundingReferences":[],"url":"https://arxiv.org/abs/2608.03736","contentUrl":null,"metadataVersion":0,"schemaVersion":"http://datacite.org/schema/kernel-4","source":"mds","isActive":true,"state":"findable","reason":null,"viewCount":0,"downloadCount":0,"referenceCount":0,"citationCount":0,"partCount":0,"partOfCount":0,"versionCount":0,"versionOfCount":0,"created":"2026-08-05T02:19:46Z","registered":"2026-08-05T02:19:47Z","published":null,"updated":"2026-08-05T02:19:47Z"},"relationships":{"client":{"data":{"id":"arxiv.content","type":"clients"}}}},{"id":"10.48550/arxiv.2608.03735","type":"dois","attributes":{"doi":"10.48550/arxiv.2608.03735","identifiers":[{"identifier":"2608.03735","identifierType":"arXiv"}],"creators":[{"nameType":"Personal","givenName":"Vikas","familyName":"Pahuja","name":"Pahuja, Vikas","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Jonathan","familyName":"Brokman","name":"Brokman, Jonathan","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Omer","familyName":"Hofman","name":"Hofman, Omer","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Tamir","familyName":"Nizri","name":"Nizri, Tamir","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Daniel","familyName":"Vishna","name":"Vishna, Daniel","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Seraphina","familyName":"Goldfarb-Tarrant","name":"Goldfarb-Tarrant, Seraphina","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Kelly","familyName":"Marchisio","name":"Marchisio, Kelly","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Hisashi","familyName":"Kojima","name":"Kojima, Hisashi","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Roman","familyName":"Vainshtein","name":"Vainshtein, Roman","affiliation":[],"nameIdentifiers":[]}],"titles":[{"title":"An Actionable Diagnosis of Multilingual, Multi-Agent Planning Failures"}],"publisher":"arXiv","container":{},"publicationYear":2026,"subjects":[{"subject":"Multiagent Systems (cs.MA)","lang":"en","subjectScheme":"arXiv"},{"subject":"Computation and Language (cs.CL)","lang":"en","subjectScheme":"arXiv"},{"subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"}],"contributors":[],"dates":[{"date":"2026-08-04T14:29:14Z","dateType":"Submitted","dateInformation":"v1"},{"date":"2026-08-05T00:58:26Z","dateType":"Updated","dateInformation":"v1"},{"date":"2026-08","dateType":"Available","dateInformation":"v1"}],"language":null,"types":{"schemaOrg":"CreativeWork","resourceTypeGeneral":"Preprint","citeproc":"article","bibtex":"misc","ris":"GEN","resourceType":"Article"},"relatedIdentifiers":[],"relatedItems":[],"sizes":[],"formats":[],"version":"1","rightsList":[{"rightsIdentifierScheme":"SPDX","rightsUri":"https://creativecommons.org/licenses/by/4.0/legalcode","schemeUri":"https://spdx.org/licenses/","rights":"Creative Commons Attribution 4.0 International","rightsIdentifier":"cc-by-4.0"}],"descriptions":[{"descriptionType":"Abstract","description":"Multilingual multi-agent systems exhibit substantial degradation beyond English, yet prior work rarely identifies how task-critical information is lost when user requests are converted into executable plans. We study the planner in a multi-agent system as the request-to-action interface and derive an actionable taxonomy of planning-grounding failures from failed real-world task executions. LLM-based analysis shows that these failures constitute an increasing share of unsuccessful executions as language-resource availability declines, with the strongest effects in low-resource languages. To test whether the taxonomy supports mitigation, we introduce TART, Taxonomy-Guided Actionable Representation, that makes the taxonomy's key aspects explicit to the planner and downstream sub-agents. Across multiple languages, three LLM backbones, two datasets, and two agentic configurations, TART consistently improves performance. On multilingual GAIA, it raises a state-of-the-art system's accuracy by 5.6 percentage points averaged across eleven languages spanning low- to high-resource settings."},{"descriptionType":"Other","description":"22 pages, 11 figures"}],"geoLocations":[],"fundingReferences":[],"url":"https://arxiv.org/abs/2608.03735","contentUrl":null,"metadataVersion":0,"schemaVersion":"http://datacite.org/schema/kernel-4","source":"mds","isActive":true,"state":"findable","reason":null,"viewCount":0,"downloadCount":0,"referenceCount":0,"citationCount":0,"partCount":0,"partOfCount":0,"versionCount":0,"versionOfCount":0,"created":"2026-08-05T02:19:45Z","registered":"2026-08-05T02:19:45Z","published":null,"updated":"2026-08-05T02:19:45Z"},"relationships":{"client":{"data":{"id":"arxiv.content","type":"clients"}}}},{"id":"10.48550/arxiv.2608.03734","type":"dois","attributes":{"doi":"10.48550/arxiv.2608.03734","identifiers":[{"identifier":"2608.03734","identifierType":"arXiv"}],"creators":[{"nameType":"Personal","givenName":"Kexin","familyName":"Sun","name":"Sun, Kexin","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Yunbo","familyName":"Lyu","name":"Lyu, Yunbo","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Xutong","familyName":"Ma","name":"Ma, Xutong","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Hongyu","familyName":"Kuang","name":"Kuang, Hongyu","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Ratnadira","familyName":"Widyasari","name":"Widyasari, Ratnadira","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"He","familyName":"Zhang","name":"Zhang, He","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Xiaoxing","familyName":"Ma","name":"Ma, Xiaoxing","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Julia","familyName":"Lawall","name":"Lawall, Julia","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"David","familyName":"Lo","name":"Lo, David","affiliation":[],"nameIdentifiers":[]}],"titles":[{"title":"We Must Have Missed This Comment: Detecting and Repairing Stale Function References in Linux Kernel Comments"}],"publisher":"arXiv","container":{},"publicationYear":2026,"subjects":[{"subject":"Software Engineering (cs.SE)","lang":"en","subjectScheme":"arXiv"},{"subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"}],"contributors":[],"dates":[{"date":"2026-08-04T14:28:48Z","dateType":"Submitted","dateInformation":"v1"},{"date":"2026-08-05T00:58:24Z","dateType":"Updated","dateInformation":"v1"},{"date":"2026-08","dateType":"Available","dateInformation":"v1"}],"language":null,"types":{"schemaOrg":"CreativeWork","resourceTypeGeneral":"Preprint","citeproc":"article","bibtex":"misc","ris":"GEN","resourceType":"Article"},"relatedIdentifiers":[],"relatedItems":[],"sizes":[],"formats":[],"version":"1","rightsList":[{"rightsIdentifierScheme":"SPDX","rightsUri":"https://creativecommons.org/licenses/by/4.0/legalcode","schemeUri":"https://spdx.org/licenses/","rights":"Creative Commons Attribution 4.0 International","rightsIdentifier":"cc-by-4.0"}],"descriptions":[{"descriptionType":"Abstract","description":"As the Linux kernel evolves, code comments may become outdated, as the functions they reference can be refactored or removed independently without corresponding updates to the comments. Such stale function references can mislead maintainers and thus hinder code comprehension. Prior work on detecting code-comment inconsistency mainly focused on addressing semantic misalignment between Javadoc comments and their directly annotated functions, making them inapplicable to this type of externally induced staleness in the Linux kernel. Therefore, we propose ReCite, a three-stage approach to identify and repair such stale references: (1) detecting unresolved function-form symbols -- symbols in comments that appear to reference functions but for which no matching function can be found in the current codebase, (2) tracing the evolution history of each unresolved symbol through the Git history, and (3) generating LLM-based repair suggestions grounded in the evolution history and current code context. On Linux kernel v6.18-rc1, ReCite detects 869 stale references with generated repair suggestions. A manual evaluation on 200 sampled repairs shows that 178 (89.0%) provide useful repair guidance, with 85 (42.5%) directly applicable. Of our 75 submitted patches, 50 have been accepted. We also empirically study all unresolved function-form symbols."},{"descriptionType":"Other","description":"Accepted at ASE 2026"}],"geoLocations":[],"fundingReferences":[],"url":"https://arxiv.org/abs/2608.03734","contentUrl":null,"metadataVersion":0,"schemaVersion":"http://datacite.org/schema/kernel-4","source":"mds","isActive":true,"state":"findable","reason":null,"viewCount":0,"downloadCount":0,"referenceCount":0,"citationCount":0,"partCount":0,"partOfCount":0,"versionCount":0,"versionOfCount":0,"created":"2026-08-05T02:19:43Z","registered":"2026-08-05T02:19:44Z","published":null,"updated":"2026-08-05T02:19:44Z"},"relationships":{"client":{"data":{"id":"arxiv.content","type":"clients"}}}},{"id":"10.48550/arxiv.2608.03733","type":"dois","attributes":{"doi":"10.48550/arxiv.2608.03733","identifiers":[{"identifier":"2608.03733","identifierType":"arXiv"}],"creators":[{"nameType":"Personal","givenName":"Chunyang","familyName":"Jiang","name":"Jiang, Chunyang","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Pingping","familyName":"Zhang","name":"Zhang, Pingping","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Yuzhi","familyName":"Zhao","name":"Zhao, Yuzhi","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Wenao","familyName":"Ma","name":"Ma, Wenao","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Zhijian","familyName":"Hou","name":"Hou, Zhijian","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Mengyang","familyName":"Wu","name":"Wu, Mengyang","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Yiyang","familyName":"Cai","name":"Cai, Yiyang","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Senkang","familyName":"Hu","name":"Hu, Senkang","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Sitong","familyName":"Cheng","name":"Cheng, Sitong","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Chi-Min","familyName":"Chan","name":"Chan, Chi-Min","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Wei","familyName":"Xue","name":"Xue, Wei","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Yike","familyName":"Guo","name":"Guo, Yike","affiliation":[],"nameIdentifiers":[]}],"titles":[{"title":"Failure-Informed Image Self-Augmentation for Multimodal Large Language Model Self-Improvement"}],"publisher":"arXiv","container":{},"publicationYear":2026,"subjects":[{"subject":"Artificial Intelligence (cs.AI)","lang":"en","subjectScheme":"arXiv"},{"subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"}],"contributors":[],"dates":[{"date":"2026-08-04T14:28:42Z","dateType":"Submitted","dateInformation":"v1"},{"date":"2026-08-05T00:58:22Z","dateType":"Updated","dateInformation":"v1"},{"date":"2026-08","dateType":"Available","dateInformation":"v1"}],"language":null,"types":{"schemaOrg":"CreativeWork","resourceTypeGeneral":"Preprint","citeproc":"article","bibtex":"misc","ris":"GEN","resourceType":"Article"},"relatedIdentifiers":[],"relatedItems":[],"sizes":[],"formats":[],"version":"1","rightsList":[{"rightsUri":"http://arxiv.org/licenses/nonexclusive-distrib/1.0/","rights":"arXiv.org perpetual, non-exclusive license"}],"descriptions":[{"descriptionType":"Abstract","description":"Multimodal large language models (MLLMs) have achieved remarkable performance across vision-language tasks, but their progress depends heavily on large-scale, high-quality multimodal data that are costly to annotate. Self-augmentation offers a promising alternative by enabling models to expand their own training data without external supervision. However, existing MLLM self-augmentation methods are largely text-centric, while image augmentation remains underexplored and typically relies on generic or handcrafted transformations that are weakly aligned with the model's actual incapability. We propose Failure-informed Image Self-Augmentation (\\textbf{FISA}), a framework for MLLM self-improvement that constructs augmented images from the model's own failure cases. Our method generates visually challenging yet answer-preserving image complications, verifies their utility through self-examination, and applies dual fidelity filtering to avoid semantic distortion. Experiments on visual question answering benchmarks show that the proposed method consistently improves performance across both in-distribution and out-of-distribution settings. Further experiments validate the compatibility of FISA with existing textual self-augmentation approaches, the superior data efficiency of the synthesized samples over generic image augmentation baselines, and the practical effectiveness of the proposed filtering strategy."}],"geoLocations":[],"fundingReferences":[],"url":"https://arxiv.org/abs/2608.03733","contentUrl":null,"metadataVersion":0,"schemaVersion":"http://datacite.org/schema/kernel-4","source":"mds","isActive":true,"state":"findable","reason":null,"viewCount":0,"downloadCount":0,"referenceCount":0,"citationCount":0,"partCount":0,"partOfCount":0,"versionCount":0,"versionOfCount":0,"created":"2026-08-05T02:19:42Z","registered":"2026-08-05T02:19:43Z","published":null,"updated":"2026-08-05T02:19:43Z"},"relationships":{"client":{"data":{"id":"arxiv.content","type":"clients"}}}},{"id":"10.48550/arxiv.2608.03731","type":"dois","attributes":{"doi":"10.48550/arxiv.2608.03731","identifiers":[{"identifier":"2608.03731","identifierType":"arXiv"}],"creators":[{"nameType":"Personal","givenName":"Yining","familyName":"Hua","name":"Hua, Yining","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Hongbin","familyName":"Na","name":"Na, Hongbin","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Cyrus","familyName":"Ayubcha","name":"Ayubcha, Cyrus","affiliation":[],"nameIdentifiers":[]}],"titles":[{"title":"CARE-Bench: Benchmarking Patient-Facing LLM Triage"}],"publisher":"arXiv","container":{},"publicationYear":2026,"subjects":[{"subject":"Artificial Intelligence (cs.AI)","lang":"en","subjectScheme":"arXiv"},{"subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"}],"contributors":[],"dates":[{"date":"2026-08-04T14:26:45Z","dateType":"Submitted","dateInformation":"v1"},{"date":"2026-08-05T00:58:18Z","dateType":"Updated","dateInformation":"v1"},{"date":"2026-08","dateType":"Available","dateInformation":"v1"}],"language":null,"types":{"schemaOrg":"CreativeWork","resourceTypeGeneral":"Preprint","citeproc":"article","bibtex":"misc","ris":"GEN","resourceType":"Article"},"relatedIdentifiers":[],"relatedItems":[],"sizes":[],"formats":[],"version":"1","rightsList":[{"rightsIdentifierScheme":"SPDX","rightsUri":"https://creativecommons.org/licenses/by/4.0/legalcode","schemeUri":"https://spdx.org/licenses/","rights":"Creative Commons Attribution 4.0 International","rightsIdentifier":"cc-by-4.0"}],"descriptions":[{"descriptionType":"Abstract","description":"Patient-facing medical LLMs and agents increasingly answer symptom questions before clinician contact, where the key safety question is what action the user should take next. We introduce CARE-Bench, a source-grounded benchmark that evaluates sequential patient-facing triage as a four-label per-turn current-action task. CARE-Bench contains 500 cases and 1,059 evaluated patient-disclosure prefixes reconstructed from medical dialogue, consultation, and follow-up-question sources. We evaluate 11 models on 269 held-out rounds under unprompted and minimally prompted open-ended protocols, using a fixed GPT-5.5 mapper to code each response into the four-label action space. Unprompted macro-F1 remains low, ranging from 31.2 to 50.4. Prompting improves 10 of 11 models, with prompted macro-F1 ranging from 46.9 to 63.4, but substantial threshold errors remain. Prompted models often recommend care before needed clarification is obtained; when the correct action was to ask for more information, only 33.5% of prompted outputs preserved the step. The persistence of these errors after prompting suggests that patient-facing triage is not a simple prompting problem and supports explicit evaluation of action timing before deployment."},{"descriptionType":"Other","description":"Code and data are available at GitHub and Hugging Face. Submitted as a preprint"}],"geoLocations":[],"fundingReferences":[],"url":"https://arxiv.org/abs/2608.03731","contentUrl":null,"metadataVersion":0,"schemaVersion":"http://datacite.org/schema/kernel-4","source":"mds","isActive":true,"state":"findable","reason":null,"viewCount":0,"downloadCount":0,"referenceCount":0,"citationCount":0,"partCount":0,"partOfCount":0,"versionCount":0,"versionOfCount":0,"created":"2026-08-05T02:19:39Z","registered":"2026-08-05T02:19:40Z","published":null,"updated":"2026-08-05T02:19:40Z"},"relationships":{"client":{"data":{"id":"arxiv.content","type":"clients"}}}},{"id":"10.48550/arxiv.2608.03730","type":"dois","attributes":{"doi":"10.48550/arxiv.2608.03730","identifiers":[{"identifier":"2608.03730","identifierType":"arXiv"}],"creators":[{"nameType":"Personal","givenName":"Sen","familyName":"Mu","name":"Mu, Sen","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Abbas Ali","familyName":"Saberi","name":"Saberi, Abbas Ali","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Mehran","familyName":"Kardar","name":"Kardar, Mehran","affiliation":[],"nameIdentifiers":[]}],"titles":[{"title":"A Spectral Route to Directed-Polymer Glasses"}],"publisher":"arXiv","container":{},"publicationYear":2026,"subjects":[{"subject":"Disordered Systems and Neural Networks (cond-mat.dis-nn)","lang":"en","subjectScheme":"arXiv"},{"subject":"Soft Condensed Matter (cond-mat.soft)","lang":"en","subjectScheme":"arXiv"},{"subject":"Statistical Mechanics (cond-mat.stat-mech)","lang":"en","subjectScheme":"arXiv"},{"subject":"Mathematical Physics (math-ph)","lang":"en","subjectScheme":"arXiv"},{"subject":"FOS: Physical sciences","subjectScheme":"Fields of Science and Technology (FOS)"}],"contributors":[],"dates":[{"date":"2026-08-04T14:26:28Z","dateType":"Submitted","dateInformation":"v1"},{"date":"2026-08-05T00:58:14Z","dateType":"Updated","dateInformation":"v1"},{"date":"2026-08","dateType":"Available","dateInformation":"v1"}],"language":null,"types":{"schemaOrg":"CreativeWork","resourceTypeGeneral":"Preprint","citeproc":"article","bibtex":"misc","ris":"GEN","resourceType":"Article"},"relatedIdentifiers":[],"relatedItems":[],"sizes":[],"formats":[],"version":"1","rightsList":[{"rightsUri":"http://arxiv.org/licenses/nonexclusive-distrib/1.0/","rights":"arXiv.org perpetual, non-exclusive license"}],"descriptions":[{"descriptionType":"Abstract","description":"A finite density of mutually avoiding directed polymers in a quenched random medium is a minimal model of glassy line matter. The dilute theory, solved by replica Bethe ansatz, predicts an interaction free energy proportional to $ρ^2$ and disorder cumulants with distinct power-law dependences on the density $ρ$, but direct numerical tests have been hindered by the combinatorially large many-polymer transfer matrix. We recast the problem as filling logarithmic eigenvalues of a single-polymer transfer-matrix product, obtaining the quenched free energy, its cumulants, and a disorder-induced linear spectral edge consistent with the replica prediction."},{"descriptionType":"Other","description":"7 pages, 5 figures"}],"geoLocations":[],"fundingReferences":[],"url":"https://arxiv.org/abs/2608.03730","contentUrl":null,"metadataVersion":0,"schemaVersion":"http://datacite.org/schema/kernel-4","source":"mds","isActive":true,"state":"findable","reason":null,"viewCount":0,"downloadCount":0,"referenceCount":0,"citationCount":0,"partCount":0,"partOfCount":0,"versionCount":0,"versionOfCount":0,"created":"2026-08-05T02:19:38Z","registered":"2026-08-05T02:19:39Z","published":null,"updated":"2026-08-05T02:19:39Z"},"relationships":{"client":{"data":{"id":"arxiv.content","type":"clients"}}}},{"id":"10.48550/arxiv.2608.03728","type":"dois","attributes":{"doi":"10.48550/arxiv.2608.03728","identifiers":[{"identifier":"2608.03728","identifierType":"arXiv"}],"creators":[{"nameType":"Personal","givenName":"Longji","familyName":"He","name":"He, Longji","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Jeto","familyName":"Xu","name":"Xu, Jeto","affiliation":[],"nameIdentifiers":[]}],"titles":[{"title":"SAT-Edge-Agent: Hardware-in-the-Loop Edge-Agent Orchestration for Onboard Satellite Intelligence"}],"publisher":"arXiv","container":{},"publicationYear":2026,"subjects":[{"subject":"Artificial Intelligence (cs.AI)","lang":"en","subjectScheme":"arXiv"},{"subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"}],"contributors":[],"dates":[{"date":"2026-08-04T14:25:27Z","dateType":"Submitted","dateInformation":"v1"},{"date":"2026-08-05T00:58:12Z","dateType":"Updated","dateInformation":"v1"},{"date":"2026-08","dateType":"Available","dateInformation":"v1"}],"language":null,"types":{"schemaOrg":"CreativeWork","resourceTypeGeneral":"Preprint","citeproc":"article","bibtex":"misc","ris":"GEN","resourceType":"Article"},"relatedIdentifiers":[],"relatedItems":[],"sizes":[],"formats":[],"version":"1","rightsList":[{"rightsUri":"http://arxiv.org/licenses/nonexclusive-distrib/1.0/","rights":"arXiv.org perpetual, non-exclusive license"}],"descriptions":[{"descriptionType":"Abstract","description":"Onboard satellite intelligence requires a task layer that translates mission intent into local tool calls, exposes execution state, and returns machine-consumable artifacts under communication and power constraints. We present SAT-Edge-Agent, a hardware-in-the-loop (HIL) edge-agent system deployed on a commercial off-the-shelf ARM-based heterogeneous edge system-on-chip. A browser workspace and FastAPI agent coordinate a local OpenAI-compatible language service with a project-internal YOLO-style oriented-object-detection endpoint that returns FAIR1M metadata-backed structured results. Two fixed FAIR1M workloads, one single-image and one serial two-image request, were repeated 20 times each and completed 20/20 attempts. Mean Full-Agent latency was 29.353 s and 60.937 s, with empirical P95 values of 31.166 s and 66.882 s. Mean detector time was 861.386 ms and 1510.920 ms, only 2.93% and 2.48% of the corresponding Full-Agent means. Profiling indicates that most visible latency occurs outside detector execution. Mean CPU utilization was 20.761% and 20.482%. A 200-ms NPU-load field averaged 100% for both workloads, but it represents a shared-accelerator software field rather than detector-only occupancy or calibrated utilization. The public evidence package provides sanitized request-level records, redacted JSON, normalized SSE examples, and scripts reproducing the reported statistics. These results establish a reproducible HIL boundary for observable satellite edge-agent orchestration, but do not establish detector accuracy, a new geolocation method, calibrated energy efficiency, or flight readiness."},{"descriptionType":"Other","description":"17 pages, 4 figures, and 10 tables. Code and sanitized research artifacts are available at https://github.com/keithhegit/SAT-Edge-Agent"}],"geoLocations":[],"fundingReferences":[],"url":"https://arxiv.org/abs/2608.03728","contentUrl":null,"metadataVersion":0,"schemaVersion":"http://datacite.org/schema/kernel-4","source":"mds","isActive":true,"state":"findable","reason":null,"viewCount":0,"downloadCount":0,"referenceCount":0,"citationCount":0,"partCount":0,"partOfCount":0,"versionCount":0,"versionOfCount":0,"created":"2026-08-05T02:19:35Z","registered":"2026-08-05T02:19:36Z","published":null,"updated":"2026-08-05T02:19:36Z"},"relationships":{"client":{"data":{"id":"arxiv.content","type":"clients"}}}},{"id":"10.48550/arxiv.2608.03727","type":"dois","attributes":{"doi":"10.48550/arxiv.2608.03727","identifiers":[{"identifier":"2608.03727","identifierType":"arXiv"}],"creators":[{"nameType":"Personal","givenName":"Chenyi","familyName":"Wang","name":"Wang, Chenyi","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Xinkai","familyName":"Wang","name":"Wang, Xinkai","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Bokai","familyName":"Lin","name":"Lin, Bokai","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Jialin","familyName":"Tian","name":"Tian, Jialin","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Fucheng","familyName":"Zhang","name":"Zhang, Fucheng","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Cewu","familyName":"Lu","name":"Lu, Cewu","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Lixin","familyName":"Yang","name":"Yang, Lixin","affiliation":[],"nameIdentifiers":[]}],"titles":[{"title":"Track4Action: Distilling World-Centric 3D Tracker into Vision-Language-Action Policies"}],"publisher":"arXiv","container":{},"publicationYear":2026,"subjects":[{"subject":"Robotics (cs.RO)","lang":"en","subjectScheme":"arXiv"},{"subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"}],"contributors":[],"dates":[{"date":"2026-08-04T14:25:13Z","dateType":"Submitted","dateInformation":"v1"},{"date":"2026-08-05T00:58:11Z","dateType":"Updated","dateInformation":"v1"},{"date":"2026-08","dateType":"Available","dateInformation":"v1"}],"language":null,"types":{"schemaOrg":"CreativeWork","resourceTypeGeneral":"Preprint","citeproc":"article","bibtex":"misc","ris":"GEN","resourceType":"Article"},"relatedIdentifiers":[],"relatedItems":[],"sizes":[],"formats":[],"version":"1","rightsList":[{"rightsUri":"http://arxiv.org/licenses/nonexclusive-distrib/1.0/","rights":"arXiv.org perpetual, non-exclusive license"}],"descriptions":[{"descriptionType":"Abstract","description":"Action labels tell a vision-language-action (VLA) policy which robot commands to imitate, but not how those commands change the 3D world. The aligned demonstration clip contains this missing supervision because its $K$ frame transitions record the geometry, motion, visibility, and camera change produced during the corresponding $K$ actions. We introduce Track4Action, a framework that distills this realized transition from a frozen world-centric 3D tracker into a current-observation VLA policy. During training, Track4World encodes the clip $V_{t:t+K}$ into a pooled tracker feature. Learnable track queries infer this feature from current VLA hidden states, match it in a shared space, and condition a flow-matching action head through a feature-wise gate. The tracker feature only defines the alignment target, so neither the clip nor the tracker is used at deployment. Track4Action reaches 82.3% on zero-shot LIBERO-Plus, improving the alignment-free variant by 7.6 points and LaMP by 3.0 points. It obtains 80.44% and 81.48% on the clean and randomized RoboTwin 2.0 splits, and 67.5% average success across four physical bimanual tasks, 25.0 points above the alignment-free variant. The gains across simulation and physical tasks support action-aligned 3D tracker features as privileged supervision for tracker-free VLA deployment. Our project page is available at https://wing0night.github.io/track4action-project-page."}],"geoLocations":[],"fundingReferences":[],"url":"https://arxiv.org/abs/2608.03727","contentUrl":null,"metadataVersion":0,"schemaVersion":"http://datacite.org/schema/kernel-4","source":"mds","isActive":true,"state":"findable","reason":null,"viewCount":0,"downloadCount":0,"referenceCount":0,"citationCount":0,"partCount":0,"partOfCount":0,"versionCount":0,"versionOfCount":0,"created":"2026-08-05T02:19:34Z","registered":"2026-08-05T02:19:34Z","published":null,"updated":"2026-08-05T02:19:34Z"},"relationships":{"client":{"data":{"id":"arxiv.content","type":"clients"}}}},{"id":"10.48550/arxiv.2608.03726","type":"dois","attributes":{"doi":"10.48550/arxiv.2608.03726","identifiers":[{"identifier":"2608.03726","identifierType":"arXiv"}],"creators":[{"nameType":"Personal","givenName":"Yangrui","familyName":"Chen","name":"Chen, Yangrui","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Yijun","familyName":"Hou","name":"Hou, Yijun","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Jincheng","familyName":"Wang","name":"Wang, Jincheng","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Ting","familyName":"Li","name":"Li, Ting","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Shuo","familyName":"Yang","name":"Yang, Shuo","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Yilin","familyName":"Guo","name":"Guo, Yilin","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Junyi","familyName":"Zhang","name":"Zhang, Junyi","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Haitang","familyName":"Li","name":"Li, Haitang","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Feiyang","familyName":"Sha","name":"Sha, Feiyang","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Qing","familyName":"Zhou","name":"Zhou, Qing","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Yu","familyName":"Liu","name":"Liu, Yu","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Xiaoli","familyName":"Yan","name":"Yan, Xiaoli","affiliation":[],"nameIdentifiers":[]}],"titles":[{"title":"Statistical Study of Solar Prominence Plumes Based on NVST H$α$ Observations"}],"publisher":"arXiv","container":{},"publicationYear":2026,"subjects":[{"subject":"Solar and Stellar Astrophysics (astro-ph.SR)","lang":"en","subjectScheme":"arXiv"},{"subject":"FOS: Physical sciences","subjectScheme":"Fields of Science and Technology (FOS)"}],"contributors":[],"dates":[{"date":"2026-08-04T14:24:53Z","dateType":"Submitted","dateInformation":"v1"},{"date":"2026-08-05T00:58:07Z","dateType":"Updated","dateInformation":"v1"},{"date":"2026-08","dateType":"Available","dateInformation":"v1"}],"language":null,"types":{"schemaOrg":"CreativeWork","resourceTypeGeneral":"Preprint","citeproc":"article","bibtex":"misc","ris":"GEN","resourceType":"Article"},"relatedIdentifiers":[],"relatedItems":[],"sizes":[],"formats":[],"version":"1","rightsList":[{"rightsUri":"http://arxiv.org/licenses/nonexclusive-distrib/1.0/","rights":"arXiv.org perpetual, non-exclusive license"}],"descriptions":[{"descriptionType":"Abstract","description":"Plumes are one of the most representative dynamic features observed in prominences and play a key role in mass and magnetic transport within them. However, their physical nature and triggering processes remain actively debated. Based on limb H$α$ observations from the New Vacuum Solar Telescope (NVST) during 2013--2025, we statistically investigated 34 plumes with clear and complete evolutions by developing an automated image-processing pipeline. It is revealed that plume lifetimes mainly range from 300 s to 700 s, with vertical displacements between 3--7 Mm. The mean widths and velocities are concentrated in the range of 0.5--1.5 Mm and 10--20 km s$^{-1}$, respectively. Besides wide distribution ranges, plume parameters exhibit irregular evolution fluctuations, indicating that the formation and evolution of various plumes may exhibit different physical patterns. Correlation analysis among the parameters further reveals that: (1) Positive correlations were found among lifetime, vertical displacement, and mean width, indicating an intrinsic coupling between the temporal and spatial scales of plumes. (2) Trajectory curvature is negatively correlated with lifetime, vertical displacement, and velocity. Accelerating and width-contracting plumes typically have lower curvature, suggesting that curvature may reflect environmental influences and the stability of plumes. (3) Plumes with higher initial velocities were more likely to be accompanied by precursor brightening, suggesting that these plumes may be triggered by magnetic reconnection. Furthermore, we infer that some plumes in non-bubble regions may be inherently driven by mini-filament eruptions. These results establish a statistical framework for prominence plumes and reveal diversity in their dynamical evolution and triggering mechanisms."},{"descriptionType":"Other","description":"15 pages, 9 figures, 1 table, accepted for publication in ApJ"}],"geoLocations":[],"fundingReferences":[],"url":"https://arxiv.org/abs/2608.03726","contentUrl":null,"metadataVersion":0,"schemaVersion":"http://datacite.org/schema/kernel-4","source":"mds","isActive":true,"state":"findable","reason":null,"viewCount":0,"downloadCount":0,"referenceCount":0,"citationCount":0,"partCount":0,"partOfCount":0,"versionCount":0,"versionOfCount":0,"created":"2026-08-05T02:19:32Z","registered":"2026-08-05T02:19:33Z","published":null,"updated":"2026-08-05T02:19:33Z"},"relationships":{"client":{"data":{"id":"arxiv.content","type":"clients"}}}},{"id":"10.48550/arxiv.2608.03724","type":"dois","attributes":{"doi":"10.48550/arxiv.2608.03724","identifiers":[{"identifier":"2608.03724","identifierType":"arXiv"}],"creators":[{"nameType":"Personal","givenName":"Francesca","familyName":"Maccarone","name":"Maccarone, Francesca","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Marina","familyName":"Di Stefano","name":"Di Stefano, Marina","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Giorgio","familyName":"Longari","name":"Longari, Giorgio","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Giulia","familyName":"Frigerio","name":"Frigerio, Giulia","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Gloria","familyName":"Rizzato","name":"Rizzato, Gloria","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Rocco","familyName":"Prudentino","name":"Prudentino, Rocco","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Nivedita","familyName":"Agarwal","name":"Agarwal, Nivedita","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Tommaso","familyName":"Ciceri","name":"Ciceri, Tommaso","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Denis","familyName":"Peruzzo","name":"Peruzzo, Denis","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Simone","familyName":"Melzi","name":"Melzi, Simone","affiliation":[],"nameIdentifiers":[]}],"titles":[{"title":"Towards Reliable and Reproducible Fetal Brain Biometry: A Deep Learning Approach Using MRI"}],"publisher":"arXiv","container":{},"publicationYear":2026,"subjects":[{"subject":"Computer Vision and Pattern Recognition (cs.CV)","lang":"en","subjectScheme":"arXiv"},{"subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"}],"contributors":[],"dates":[{"date":"2026-08-04T14:20:40Z","dateType":"Submitted","dateInformation":"v1"},{"date":"2026-08-05T00:57:51Z","dateType":"Updated","dateInformation":"v1"},{"date":"2026-08","dateType":"Available","dateInformation":"v1"}],"language":null,"types":{"schemaOrg":"CreativeWork","resourceTypeGeneral":"Preprint","citeproc":"article","bibtex":"misc","ris":"GEN","resourceType":"Article"},"relatedIdentifiers":[],"relatedItems":[],"sizes":[],"formats":[],"version":"1","rightsList":[{"rightsIdentifierScheme":"SPDX","rightsUri":"https://creativecommons.org/licenses/by-nc-nd/4.0/legalcode","schemeUri":"https://spdx.org/licenses/","rights":"Creative Commons Attribution Non Commercial No Derivatives 4.0 International","rightsIdentifier":"cc-by-nc-nd-4.0"}],"descriptions":[{"descriptionType":"Abstract","description":"Fetal brain biometry is essential for quantitative assessment of brain development, supporting gestational age estimation, developmental monitoring, and detection of abnormalities. In clinical practice, measurements are manually performed, making them time-consuming and prone to variability. While automated approaches have been proposed, reproducible methods remain limited, particularly those providing anatomically interpretable landmark localization. We present a fully automated deep learning-based framework for reliable and reproducible brain biometry from 3D super-resolution-reconstructed fetal brain MRI. The proposed four-step pipeline derives biometric parameters by jointly estimating linear measurements and their corresponding anatomical landmarks. A 3D convolutional neural network is trained to regress landmark coordinates from brain segmentation label maps, followed by measurement-specific geometric optimization to refine landmark positions and compute measurements. The pipeline is evaluated on two publicly available fetal MRI datasets comprising 150 volumes (gestational age range: 20-37 weeks) acquired across different scanners and protocols, assessing five key biometric measurements across varying acquisition settings and providing a comprehensive evaluation of both measurement accuracy and landmark localization using quantitative metrics and visual assessment. Compared with the only available automated pipeline, the proposed method achieves comparable or improved accuracy for most measurements. In conclusion, we introduce a straightforward pipeline for reliable biometry estimations, with efficiency, interpretability and scalability that support integration into clinical workflows."},{"descriptionType":"Other","description":"Currently under journal submission"}],"geoLocations":[],"fundingReferences":[],"url":"https://arxiv.org/abs/2608.03724","contentUrl":null,"metadataVersion":0,"schemaVersion":"http://datacite.org/schema/kernel-4","source":"mds","isActive":true,"state":"findable","reason":null,"viewCount":0,"downloadCount":0,"referenceCount":0,"citationCount":0,"partCount":0,"partOfCount":0,"versionCount":0,"versionOfCount":0,"created":"2026-08-05T02:19:30Z","registered":"2026-08-05T02:19:30Z","published":null,"updated":"2026-08-05T02:19:30Z"},"relationships":{"client":{"data":{"id":"arxiv.content","type":"clients"}}}},{"id":"10.48550/arxiv.2608.03723","type":"dois","attributes":{"doi":"10.48550/arxiv.2608.03723","identifiers":[{"identifier":"2608.03723","identifierType":"arXiv"}],"creators":[{"nameType":"Personal","givenName":"Anna","familyName":"Vishnyakova","name":"Vishnyakova, Anna","affiliation":[],"nameIdentifiers":[]}],"titles":[{"title":"Polynomially Deformed Normalized Pochhammer Sequences Having Generating Functions With Only Real Non-positive Zeros"}],"publisher":"arXiv","container":{},"publicationYear":2026,"subjects":[{"subject":"Complex Variables (math.CV)","lang":"en","subjectScheme":"arXiv"},{"subject":"FOS: Mathematics","subjectScheme":"Fields of Science and Technology (FOS)"},{"subject":"30C15, 15B48, 30D15, 26C10, 30D99","lang":"en","subjectScheme":"MSC"}],"contributors":[],"dates":[{"date":"2026-08-04T14:20:18Z","dateType":"Submitted","dateInformation":"v1"},{"date":"2026-08-05T00:57:50Z","dateType":"Updated","dateInformation":"v1"},{"date":"2026-08","dateType":"Available","dateInformation":"v1"}],"language":null,"types":{"schemaOrg":"CreativeWork","resourceTypeGeneral":"Preprint","citeproc":"article","bibtex":"misc","ris":"GEN","resourceType":"Article"},"relatedIdentifiers":[],"relatedItems":[],"sizes":[],"formats":[],"version":"1","rightsList":[{"rightsIdentifierScheme":"SPDX","rightsUri":"https://creativecommons.org/licenses/by/4.0/legalcode","schemeUri":"https://spdx.org/licenses/","rights":"Creative Commons Attribution 4.0 International","rightsIdentifier":"cc-by-4.0"}],"descriptions":[{"descriptionType":"Abstract","description":"For a given real number $a\u0026gt;0$ and a given real polynomial $P_n\\in \\mathbb{R}[x]$ of degree $n=0, 1, 2, \\ldots$ it is easy to see that $ \\sum_{k=0}^\\infty \\frac{(a)_k}{k!} P_n(k) z^k =\\frac{S_{n, a}(z)}{(1-z)^{a+ n}}, \\ |z|\u0026lt;1, $ where $S_{n, a}$ is a real polynomial of degree not greater than $n.$ Here $(a)_k =a(a+1)\\cdot \\ldots \\cdot (a+k-1),\\ (a)_0 = 1,$ is the rising factorial, or the Pochhammer symbol. We consider the following open problem: to describe the set of real polynomials $P_n\\in \\mathbb{R}[x]$ of degree $n=0, 1, 2, \\ldots,$ such that the corresponding polynomial $S_{n, a}$ has all real non-positive zeros. In the case $a=1$ this problem has been studied in \\cite{vish}. We establish several new necessary conditions and several sufficient conditions, present a number of important examples, and formulate several open problems."}],"geoLocations":[],"fundingReferences":[],"url":"https://arxiv.org/abs/2608.03723","contentUrl":null,"metadataVersion":0,"schemaVersion":"http://datacite.org/schema/kernel-4","source":"mds","isActive":true,"state":"findable","reason":null,"viewCount":0,"downloadCount":0,"referenceCount":0,"citationCount":0,"partCount":0,"partOfCount":0,"versionCount":0,"versionOfCount":0,"created":"2026-08-05T02:19:28Z","registered":"2026-08-05T02:19:29Z","published":null,"updated":"2026-08-05T02:19:29Z"},"relationships":{"client":{"data":{"id":"arxiv.content","type":"clients"}}}},{"id":"10.48550/arxiv.2608.03721","type":"dois","attributes":{"doi":"10.48550/arxiv.2608.03721","identifiers":[{"identifier":"2608.03721","identifierType":"arXiv"}],"creators":[{"nameType":"Personal","givenName":"Hendrik Vincent","familyName":"Koops","name":"Koops, Hendrik Vincent","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Hao Hao","familyName":"Tan","name":"Tan, Hao Hao","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Elio","familyName":"Quinton","name":"Quinton, Elio","affiliation":[],"nameIdentifiers":[]}],"titles":[{"title":"On the Geometry of Music Bandwidth Extension in Latent Spaces of Audio Codecs"}],"publisher":"arXiv","container":{},"publicationYear":2026,"subjects":[{"subject":"Sound (cs.SD)","lang":"en","subjectScheme":"arXiv"},{"subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"}],"contributors":[],"dates":[{"date":"2026-08-04T14:19:59Z","dateType":"Submitted","dateInformation":"v1"},{"date":"2026-08-05T00:57:49Z","dateType":"Updated","dateInformation":"v1"},{"date":"2026-08","dateType":"Available","dateInformation":"v1"}],"language":null,"types":{"schemaOrg":"CreativeWork","resourceTypeGeneral":"Preprint","citeproc":"article","bibtex":"misc","ris":"GEN","resourceType":"Article"},"relatedIdentifiers":[],"relatedItems":[],"sizes":[],"formats":[],"version":"1","rightsList":[{"rightsIdentifierScheme":"SPDX","rightsUri":"https://creativecommons.org/licenses/by/4.0/legalcode","schemeUri":"https://spdx.org/licenses/","rights":"Creative Commons Attribution 4.0 International","rightsIdentifier":"cc-by-4.0"}],"descriptions":[{"descriptionType":"Abstract","description":"Recent audio restoration increasingly relies on large-scale conditional latent generative modeling, including diffusion, Schrodinger Bridges, and Flow Matching variants, to invert degradations such as bandwidth limitation or noise. We present an analysis of the performance of various state-of-the-art methods compared to simple arithmetic transformations in the latent spaces of multiple neural codecs for musical bandwidth extension. We show that estimating a single transport vector between the clean and degraded latent centroids on a reference set, and adding it to degraded latents, can yield restoration performance competitive with large diffusion models. This suggests, first, that some neural codec latent spaces exhibit structure aligned with audio bandwidth; and second, that in such cases complex conditional models may offer only limited gains over a simple vector addition. We argue that these findings reveal an interesting avenue for future research whereby models could take advantage of the latent space structure in order to offer greater training and parameter efficiency, and overall better performance. Additionally, we propose to consider this simple arithmetic transformation as a baseline for music bandwidth extension research, as it allows an assessment of the contribution of learnable parameters towards restoration performance."},{"descriptionType":"Other","description":"8 pages, 4 figures, 4 tables. Accepted at the 27th International Society for Music Information Retrieval Conference (ISMIR 2026). Companion website: https://ismir26latentgeo.github.io/"}],"geoLocations":[],"fundingReferences":[],"url":"https://arxiv.org/abs/2608.03721","contentUrl":null,"metadataVersion":0,"schemaVersion":"http://datacite.org/schema/kernel-4","source":"mds","isActive":true,"state":"findable","reason":null,"viewCount":0,"downloadCount":0,"referenceCount":0,"citationCount":0,"partCount":0,"partOfCount":0,"versionCount":0,"versionOfCount":0,"created":"2026-08-05T02:19:25Z","registered":null,"published":null,"updated":"2026-08-05T02:19:26Z"},"relationships":{"client":{"data":{"id":"arxiv.content","type":"clients"}}}},{"id":"10.48550/arxiv.2608.03720","type":"dois","attributes":{"doi":"10.48550/arxiv.2608.03720","identifiers":[{"identifier":"2608.03720","identifierType":"arXiv"}],"creators":[{"nameType":"Personal","givenName":"Khaled","familyName":"Ziani","name":"Ziani, Khaled","affiliation":[],"nameIdentifiers":[]}],"titles":[{"title":"Detecting Hallucinations and Recovering Verified Answers in Arabic Islamic Question Answering"}],"publisher":"arXiv","container":{},"publicationYear":2026,"subjects":[{"subject":"Computation and Language (cs.CL)","lang":"en","subjectScheme":"arXiv"},{"subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"}],"contributors":[],"dates":[{"date":"2026-08-04T14:19:53Z","dateType":"Submitted","dateInformation":"v1"},{"date":"2026-08-05T00:57:48Z","dateType":"Updated","dateInformation":"v1"},{"date":"2026-08","dateType":"Available","dateInformation":"v1"}],"language":null,"types":{"schemaOrg":"CreativeWork","resourceTypeGeneral":"Preprint","citeproc":"article","bibtex":"misc","ris":"GEN","resourceType":"Article"},"relatedIdentifiers":[],"relatedItems":[],"sizes":[],"formats":[],"version":"1","rightsList":[{"rightsUri":"http://arxiv.org/licenses/nonexclusive-distrib/1.0/","rights":"arXiv.org perpetual, non-exclusive license"}],"descriptions":[{"descriptionType":"Abstract","description":"Large language models can generate fluent responses to Islamic questions while introducing factual errors that are difficult to identify. This paper presents our system for \\textsc{HalluScoring 2026} Task 2.1, \\textit{Islamic Hallucination Detection and Find the Truth}. The task requires a unified two-step prediction: determining whether an Arabic answer generated by an LLM is hallucinated and selecting the verified answer from six closely related candidate options. We use the Islamic knowledge dataset provided by the shared task, which contains 600 question--answer instances, including 341 hallucinated and 259 non-hallucinated answers. Our system is based on the fine-tuned \\texttt{google/gemma-4-12B-it} model and uses deterministic decoding during inference. The generated outputs are normalized to extract the hallucination label and the selected option. The system achieves a Macro-F1 score of 0.928 and a label accuracy of 0.935 for hallucination detection, together with an option accuracy of 0.895 for answer selection. These results yield a combined score of 0.912, demonstrating strong performance across both stages of the task. The lower option-selection accuracy indicates that distinguishing the verified answer from plausible alternatives remains more challenging than detecting hallucinated responses."}],"geoLocations":[],"fundingReferences":[],"url":"https://arxiv.org/abs/2608.03720","contentUrl":null,"metadataVersion":0,"schemaVersion":"http://datacite.org/schema/kernel-4","source":"mds","isActive":true,"state":"findable","reason":null,"viewCount":0,"downloadCount":0,"referenceCount":0,"citationCount":0,"partCount":0,"partOfCount":0,"versionCount":0,"versionOfCount":0,"created":"2026-08-05T02:19:24Z","registered":"2026-08-05T02:19:25Z","published":null,"updated":"2026-08-05T02:19:25Z"},"relationships":{"client":{"data":{"id":"arxiv.content","type":"clients"}}}},{"id":"10.48550/arxiv.2608.03718","type":"dois","attributes":{"doi":"10.48550/arxiv.2608.03718","identifiers":[{"identifier":"2608.03718","identifierType":"arXiv"}],"creators":[{"nameType":"Personal","givenName":"Tim E.","familyName":"Veenstra","name":"Veenstra, Tim E.","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"René","familyName":"van Roij","name":"van Roij, René","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Pepijn G.","familyName":"Moerman","name":"Moerman, Pepijn G.","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Marjolein","familyName":"Dijkstra","name":"Dijkstra, Marjolein","affiliation":[],"nameIdentifiers":[]}],"titles":[{"title":"Synthetic paracrine signaling of colloids drives self-assembly limit cycles"}],"publisher":"arXiv","container":{},"publicationYear":2026,"subjects":[{"subject":"Soft Condensed Matter (cond-mat.soft)","lang":"en","subjectScheme":"arXiv"},{"subject":"FOS: Physical sciences","subjectScheme":"Fields of Science and Technology (FOS)"}],"contributors":[],"dates":[{"date":"2026-08-04T14:18:22Z","dateType":"Submitted","dateInformation":"v1"},{"date":"2026-08-05T00:57:44Z","dateType":"Updated","dateInformation":"v1"},{"date":"2026-08","dateType":"Available","dateInformation":"v1"}],"language":null,"types":{"schemaOrg":"CreativeWork","resourceTypeGeneral":"Preprint","citeproc":"article","bibtex":"misc","ris":"GEN","resourceType":"Article"},"relatedIdentifiers":[],"relatedItems":[],"sizes":[],"formats":[],"version":"1","rightsList":[{"rightsIdentifierScheme":"SPDX","rightsUri":"https://creativecommons.org/licenses/by/4.0/legalcode","schemeUri":"https://spdx.org/licenses/","rights":"Creative Commons Attribution 4.0 International","rightsIdentifier":"cc-by-4.0"}],"descriptions":[{"descriptionType":"Abstract","description":"Developing synthetic materials that exhibit life-like behavior, such as internally driven cycles, remains a central challenge in active matter. Here, we introduce a minimal colloidal model of chemical signaling in which particles produce diffusing signaling molecules that selectively promote or inhibit attractive interactions among neighboring particles. This bio-inspired, paracrine-like signaling mechanism generates context- and history-dependent many-body interactions that break time-reversal symmetry and drive the system far from equilibrium, leading to the spontaneous emergence of autonomous, internally sustained limit cycles in the composition of particle clusters. Using computer simulations, we map the resulting nonequilibrium phase behavior and identify distinct dynamical regimes controlled by the rates of signal production and degradation, together with the diffusion range of the signaling molecules. Among these, we find a robust oscillatory state in which particle clusters autonomously assemble in a cyclic fashion, driven entirely by internal feedback loops. Our results establish paracrine-signaling colloids as a minimal, physically realizable platform for programmable nonequilibrium materials with life-like functionality and provide a general route toward synthetic active matter with self-regulated collective dynamics."}],"geoLocations":[],"fundingReferences":[],"url":"https://arxiv.org/abs/2608.03718","contentUrl":null,"metadataVersion":0,"schemaVersion":"http://datacite.org/schema/kernel-4","source":"mds","isActive":true,"state":"findable","reason":null,"viewCount":0,"downloadCount":0,"referenceCount":0,"citationCount":0,"partCount":0,"partOfCount":0,"versionCount":0,"versionOfCount":0,"created":"2026-08-05T02:19:21Z","registered":"2026-08-05T02:19:22Z","published":null,"updated":"2026-08-05T02:19:22Z"},"relationships":{"client":{"data":{"id":"arxiv.content","type":"clients"}}}},{"id":"10.48550/arxiv.2608.03717","type":"dois","attributes":{"doi":"10.48550/arxiv.2608.03717","identifiers":[{"identifier":"2608.03717","identifierType":"arXiv"}],"creators":[{"nameType":"Personal","givenName":"Dani","familyName":"Kaufman","name":"Kaufman, Dani","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Marcus","familyName":"Spradlin","name":"Spradlin, Marcus","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Anastasia","familyName":"Volovich","name":"Volovich, Anastasia","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Kai","familyName":"Yan","name":"Yan, Kai","affiliation":[],"nameIdentifiers":[]}],"titles":[{"title":"Cluster Algebras, Cube Roots, and Energy Correlators in $\\mathcal{N}=4$ SYM"}],"publisher":"arXiv","container":{},"publicationYear":2026,"subjects":[{"subject":"High Energy Physics - Theory (hep-th)","lang":"en","subjectScheme":"arXiv"},{"subject":"Commutative Algebra (math.AC)","lang":"en","subjectScheme":"arXiv"},{"subject":"FOS: Physical sciences","subjectScheme":"Fields of Science and Technology (FOS)"},{"subject":"FOS: Mathematics","subjectScheme":"Fields of Science and Technology (FOS)"},{"subject":"13F60","lang":"en","subjectScheme":"MSC"}],"contributors":[],"dates":[{"date":"2026-08-04T14:18:10Z","dateType":"Submitted","dateInformation":"v1"},{"date":"2026-08-05T00:57:40Z","dateType":"Updated","dateInformation":"v1"},{"date":"2026-08","dateType":"Available","dateInformation":"v1"}],"language":null,"types":{"schemaOrg":"CreativeWork","resourceTypeGeneral":"Preprint","citeproc":"article","bibtex":"misc","ris":"GEN","resourceType":"Article"},"relatedIdentifiers":[],"relatedItems":[],"sizes":[],"formats":[],"version":"1","rightsList":[{"rightsUri":"http://arxiv.org/licenses/nonexclusive-distrib/1.0/","rights":"arXiv.org perpetual, non-exclusive license"}],"descriptions":[{"descriptionType":"Abstract","description":"We provide a cluster algebraic construction of the cube root symbol letters that appear at leading order in the near-collinear expansion of the four-point energy correlator in $\\mathcal{N}=4$ SYM theory."},{"descriptionType":"Other","description":"6 pages, 2 figures"}],"geoLocations":[],"fundingReferences":[],"url":"https://arxiv.org/abs/2608.03717","contentUrl":null,"metadataVersion":0,"schemaVersion":"http://datacite.org/schema/kernel-4","source":"mds","isActive":true,"state":"findable","reason":null,"viewCount":0,"downloadCount":0,"referenceCount":0,"citationCount":0,"partCount":0,"partOfCount":0,"versionCount":0,"versionOfCount":0,"created":"2026-08-05T02:19:20Z","registered":"2026-08-05T02:19:21Z","published":null,"updated":"2026-08-05T02:19:21Z"},"relationships":{"client":{"data":{"id":"arxiv.content","type":"clients"}}}},{"id":"10.48550/arxiv.2608.03716","type":"dois","attributes":{"doi":"10.48550/arxiv.2608.03716","identifiers":[{"identifier":"2608.03716","identifierType":"arXiv"}],"creators":[{"nameType":"Personal","givenName":"Galvin","familyName":"Ng","name":"Ng, Galvin","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Luca","familyName":"Mungo","name":"Mungo, Luca","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Damien","familyName":"Bertrand","name":"Bertrand, Damien","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"François","familyName":"Lafond","name":"Lafond, François","affiliation":[],"nameIdentifiers":[]}],"titles":[{"title":"Synthetic supply networks"}],"publisher":"arXiv","container":{},"publicationYear":2026,"subjects":[{"subject":"General Economics (econ.GN)","lang":"en","subjectScheme":"arXiv"},{"subject":"FOS: Economics and business","subjectScheme":"Fields of Science and Technology (FOS)"}],"contributors":[],"dates":[{"date":"2026-08-04T14:18:04Z","dateType":"Submitted","dateInformation":"v1"},{"date":"2026-08-05T00:57:39Z","dateType":"Updated","dateInformation":"v1"},{"date":"2026-08","dateType":"Available","dateInformation":"v1"}],"language":null,"types":{"schemaOrg":"CreativeWork","resourceTypeGeneral":"Preprint","citeproc":"article","bibtex":"misc","ris":"GEN","resourceType":"Article"},"relatedIdentifiers":[],"relatedItems":[],"sizes":[],"formats":[],"version":"1","rightsList":[{"rightsIdentifierScheme":"SPDX","rightsUri":"https://creativecommons.org/licenses/by/4.0/legalcode","schemeUri":"https://spdx.org/licenses/","rights":"Creative Commons Attribution 4.0 International","rightsIdentifier":"cc-by-4.0"}],"descriptions":[{"descriptionType":"Abstract","description":"A good representation of the population of firms and households is essential for large-scale economic models. While there exist good methods to create synthetic populations of households, creating synthetic populations of firms and, crucially, their supply chain links, is typically much harder. Here, we introduce a flexible method to create synthetic supply networks that match both the known properties of firm-level supply networks and the properties of aggregated input-output tables used in macroeconomic models. Our method is fast, and because it uses only publicly available data, it is fully reproducible and can be easily extended."},{"descriptionType":"Other","description":"33 pages, 12 figures"}],"geoLocations":[],"fundingReferences":[],"url":"https://arxiv.org/abs/2608.03716","contentUrl":null,"metadataVersion":0,"schemaVersion":"http://datacite.org/schema/kernel-4","source":"mds","isActive":true,"state":"findable","reason":null,"viewCount":0,"downloadCount":0,"referenceCount":0,"citationCount":0,"partCount":0,"partOfCount":0,"versionCount":0,"versionOfCount":0,"created":"2026-08-05T02:19:19Z","registered":null,"published":null,"updated":"2026-08-05T02:19:19Z"},"relationships":{"client":{"data":{"id":"arxiv.content","type":"clients"}}}},{"id":"10.48550/arxiv.2608.03715","type":"dois","attributes":{"doi":"10.48550/arxiv.2608.03715","identifiers":[{"identifier":"2608.03715","identifierType":"arXiv"}],"creators":[{"nameType":"Personal","givenName":"Andreas","familyName":"Sauter","name":"Sauter, Andreas","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Sumit","familyName":"Sourabh","name":"Sourabh, Sumit","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Drona","familyName":"Kandhai","name":"Kandhai, Drona","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Erman","familyName":"Acar","name":"Acar, Erman","affiliation":[],"nameIdentifiers":[]}],"titles":[{"title":"Amortized Interventional Forecasting for Multivariate CIR Processes"}],"publisher":"arXiv","container":{},"publicationYear":2026,"subjects":[{"subject":"Machine Learning (cs.LG)","lang":"en","subjectScheme":"arXiv"},{"subject":"Computational Engineering, Finance, and Science (cs.CE)","lang":"en","subjectScheme":"arXiv"},{"subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"}],"contributors":[],"dates":[{"date":"2026-08-04T14:17:35Z","dateType":"Submitted","dateInformation":"v1"},{"date":"2026-08-05T00:57:37Z","dateType":"Updated","dateInformation":"v1"},{"date":"2026-08","dateType":"Available","dateInformation":"v1"}],"language":null,"types":{"schemaOrg":"CreativeWork","resourceTypeGeneral":"Preprint","citeproc":"article","bibtex":"misc","ris":"GEN","resourceType":"Article"},"relatedIdentifiers":[],"relatedItems":[],"sizes":[],"formats":[],"version":"1","rightsList":[{"rightsIdentifierScheme":"SPDX","rightsUri":"https://creativecommons.org/licenses/by/4.0/legalcode","schemeUri":"https://spdx.org/licenses/","rights":"Creative Commons Attribution 4.0 International","rightsIdentifier":"cc-by-4.0"}],"descriptions":[{"descriptionType":"Abstract","description":"Mean-reverting dynamics are pervasive in finance, and the Cox--Ingersoll--Ross (CIR) process is a standard model for the time series they produce, from short rates to credit default swap (CDS) spreads. Yet CIR models capture only \\emph{correlated} co-movement, not \\emph{causal} influence between series, so they cannot answer the system's response when one series is externally shocked, which observational conditionals confound with historical co-movement. We make two contributions. First, an amortized model for distributional causal effect estimation that frames trajectories as time-stamped observations and predicts the calibrated multi-horizon shock response without retraining per scenario. Second, a causal multivariate CIR data-generating process that supplies the paired observational and interventional ground truth that real markets cannot. We instantiate and calibrate the framework on CDS spreads as a testbed. CIR-ACTIVA's validity is established on synthetic ground truth, independent of how well the simulator matches reality, while practical grounding is assessed by backtesting the generated traces against real CDS data. Against observational and amortized causal-inference baselines, CIR-ACTIVA leads on both causal selectivity in the joint distribution and horizon-resolved calibration, retaining its selectivity once the interventional law varies over the horizon, with gains concentrating at short horizons. This opens up a class of what-if queries on coupled spread systems, CDS stress testing among them, that observational forecasters cannot answer."}],"geoLocations":[],"fundingReferences":[],"url":"https://arxiv.org/abs/2608.03715","contentUrl":null,"metadataVersion":0,"schemaVersion":"http://datacite.org/schema/kernel-4","source":"mds","isActive":true,"state":"findable","reason":null,"viewCount":0,"downloadCount":0,"referenceCount":0,"citationCount":0,"partCount":0,"partOfCount":0,"versionCount":0,"versionOfCount":0,"created":"2026-08-05T02:19:17Z","registered":"2026-08-05T02:19:18Z","published":null,"updated":"2026-08-05T02:19:18Z"},"relationships":{"client":{"data":{"id":"arxiv.content","type":"clients"}}}},{"id":"10.48550/arxiv.2608.03713","type":"dois","attributes":{"doi":"10.48550/arxiv.2608.03713","identifiers":[{"identifier":"2608.03713","identifierType":"arXiv"}],"creators":[{"nameType":"Personal","givenName":"Wenhui","familyName":"Chen","name":"Chen, Wenhui","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Mohamed Ali","familyName":"Hamza","name":"Hamza, Mohamed Ali","affiliation":[],"nameIdentifiers":[]}],"titles":[{"title":"Blow-up criteria and lifespan estimates for semilinear wave equations with time-dependent damping and mass"}],"publisher":"arXiv","container":{},"publicationYear":2026,"subjects":[{"subject":"Analysis of PDEs (math.AP)","lang":"en","subjectScheme":"arXiv"},{"subject":"FOS: Mathematics","subjectScheme":"Fields of Science and Technology (FOS)"}],"contributors":[],"dates":[{"date":"2026-08-04T14:17:07Z","dateType":"Submitted","dateInformation":"v1"},{"date":"2026-08-05T00:57:36Z","dateType":"Updated","dateInformation":"v1"},{"date":"2026-08","dateType":"Available","dateInformation":"v1"}],"language":null,"types":{"schemaOrg":"CreativeWork","resourceTypeGeneral":"Preprint","citeproc":"article","bibtex":"misc","ris":"GEN","resourceType":"Article"},"relatedIdentifiers":[],"relatedItems":[],"sizes":[],"formats":[],"version":"1","rightsList":[{"rightsIdentifierScheme":"SPDX","rightsUri":"https://creativecommons.org/licenses/by-nc-nd/4.0/legalcode","schemeUri":"https://spdx.org/licenses/","rights":"Creative Commons Attribution Non Commercial No Derivatives 4.0 International","rightsIdentifier":"cc-by-nc-nd-4.0"}],"descriptions":[{"descriptionType":"Abstract","description":"We consider semilinear wave equations with time-dependent damping and mass and a derivative-type nonlinearity. By applying a Liouville transformation and solving a Volterra integral equation posed from infinity, we construct a positive exact solution to the adjoint equation without using an explicit representation of the linear propagator. This solution is used to derive a blow-up criterion for energy solutions with finite propagation, together with an upper bound for the lifespan. If the primitive of the damping coefficient grows at most logarithmically, we obtain the full shifted Glassey range, including the critical exponent, and the corresponding polynomial and exponential lifespan estimates. The result applies independently of the sign of the scale-invariant discriminant and therefore includes the mass-dominant regime. It also covers non-integrable oscillatory perturbations of the damping coefficient when their contributions are canceled by the corresponding mass terms."}],"geoLocations":[],"fundingReferences":[],"url":"https://arxiv.org/abs/2608.03713","contentUrl":null,"metadataVersion":0,"schemaVersion":"http://datacite.org/schema/kernel-4","source":"mds","isActive":true,"state":"findable","reason":null,"viewCount":0,"downloadCount":0,"referenceCount":0,"citationCount":0,"partCount":0,"partOfCount":0,"versionCount":0,"versionOfCount":0,"created":"2026-08-05T02:19:15Z","registered":null,"published":null,"updated":"2026-08-05T02:19:15Z"},"relationships":{"client":{"data":{"id":"arxiv.content","type":"clients"}}}},{"id":"10.48550/arxiv.2608.03712","type":"dois","attributes":{"doi":"10.48550/arxiv.2608.03712","identifiers":[{"identifier":"2608.03712","identifierType":"arXiv"}],"creators":[{"nameType":"Personal","givenName":"Malik","familyName":"Faizan","name":"Faizan, Malik","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"P. J.","familyName":"White","name":"White, P. J.","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Indrakshi","familyName":"Dey","name":"Dey, Indrakshi","affiliation":[],"nameIdentifiers":[]}],"titles":[{"title":"A Conductance Based Amygdala Model of Threat Processing in Anxiety and Depression"}],"publisher":"arXiv","container":{},"publicationYear":2026,"subjects":[{"subject":"Systems and Control (eess.SY)","lang":"en","subjectScheme":"arXiv"},{"subject":"FOS: Electrical engineering, electronic engineering, information engineering","subjectScheme":"Fields of Science and Technology (FOS)"}],"contributors":[],"dates":[{"date":"2026-08-04T14:16:25Z","dateType":"Submitted","dateInformation":"v1"},{"date":"2026-08-05T00:57:28Z","dateType":"Updated","dateInformation":"v1"},{"date":"2026-08","dateType":"Available","dateInformation":"v1"}],"language":null,"types":{"schemaOrg":"CreativeWork","resourceTypeGeneral":"Preprint","citeproc":"article","bibtex":"misc","ris":"GEN","resourceType":"Article"},"relatedIdentifiers":[],"relatedItems":[],"sizes":[],"formats":[],"version":"1","rightsList":[{"rightsUri":"http://arxiv.org/licenses/nonexclusive-distrib/1.0/","rights":"arXiv.org perpetual, non-exclusive license"}],"descriptions":[{"descriptionType":"Abstract","description":"Anxiety and depressive disorders are increasingly viewed as dysregulations along continuous stress-regulatory dimensions. However, existing computational approaches seldom connect interpretable circuit level mechanisms to autonomic physiology. Methods: This study develops a mechanistic framework that links amygdala dysregulation to cardiovascular stress responses for digital phenotyping and clinical interpretation. We formulated a compact, nine equation, conductance based model of the amygdala hypothalamus cardiovascular pathway. The framework extends Hodgkin Huxley formalism with three clinically grounded modulators: coping capacity, perceived stress load, and prefrontal regulatory strength. A slow, history-dependent internal state, adaptive thresholding, graded threat acknowledgement, and baroreflex coupled hypothalamic integration were used to generate heart rate and blood pressure trajectories. Results: Distinct strong, moderate, and weak regulatory regimes emerged as stable operating states of a single closed-loop system. Robust analyses showed that stochastic variability and parameter perturbation preserved regime separation, while ablation studies identified the adaptive threshold as the principal mechanism driving quantitative regime separation. Simulated cardiovascular responses remained within reported stress physiology ranges. Furthermore, external evaluation across three independent datasets supported robust agreement with real world, stress related autonomic patterns. Conclusion: A compact, mechanistic model can jointly link psychometric modulators, amygdala excitability, and downstream cardiovascular output within a single, interpretable framework. Significance: This work provides a computationally tractable basis for mechanism informed digital phenotyping, patient specific stress monitoring, and future digital twin approaches for mental health decision support."},{"descriptionType":"Other","description":"12 pages, 16 figures and 4 tables"}],"geoLocations":[],"fundingReferences":[],"url":"https://arxiv.org/abs/2608.03712","contentUrl":null,"metadataVersion":0,"schemaVersion":"http://datacite.org/schema/kernel-4","source":"mds","isActive":true,"state":"findable","reason":null,"viewCount":0,"downloadCount":0,"referenceCount":0,"citationCount":0,"partCount":0,"partOfCount":0,"versionCount":0,"versionOfCount":0,"created":"2026-08-05T02:19:13Z","registered":"2026-08-05T02:19:14Z","published":null,"updated":"2026-08-05T02:19:14Z"},"relationships":{"client":{"data":{"id":"arxiv.content","type":"clients"}}}},{"id":"10.48550/arxiv.2608.03711","type":"dois","attributes":{"doi":"10.48550/arxiv.2608.03711","identifiers":[{"identifier":"2608.03711","identifierType":"arXiv"}],"creators":[{"nameType":"Personal","givenName":"Maximilian","familyName":"Dillitzer","name":"Dillitzer, Maximilian","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Tin Stribor","familyName":"Sohn","name":"Sohn, Tin Stribor","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Jason J.","familyName":"Corso","name":"Corso, Jason J.","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Michael","familyName":"Auerbach","name":"Auerbach, Michael","affiliation":[],"nameIdentifiers":[]}],"titles":[{"title":"Attention is Case-Sensitive"}],"publisher":"arXiv","container":{},"publicationYear":2026,"subjects":[{"subject":"Computer Vision and Pattern Recognition (cs.CV)","lang":"en","subjectScheme":"arXiv"},{"subject":"Computation and Language (cs.CL)","lang":"en","subjectScheme":"arXiv"},{"subject":"Machine Learning (cs.LG)","lang":"en","subjectScheme":"arXiv"},{"subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"}],"contributors":[],"dates":[{"date":"2026-08-04T14:16:06Z","dateType":"Submitted","dateInformation":"v1"},{"date":"2026-08-05T00:57:25Z","dateType":"Updated","dateInformation":"v1"},{"date":"2026-08","dateType":"Available","dateInformation":"v1"}],"language":null,"types":{"schemaOrg":"CreativeWork","resourceTypeGeneral":"Preprint","citeproc":"article","bibtex":"misc","ris":"GEN","resourceType":"Article"},"relatedIdentifiers":[],"relatedItems":[],"sizes":[],"formats":[],"version":"1","rightsList":[{"rightsUri":"http://arxiv.org/licenses/nonexclusive-distrib/1.0/","rights":"arXiv.org perpetual, non-exclusive license"}],"descriptions":[{"descriptionType":"Abstract","description":"In human visual perception, uppercase lettering serves as a natural salience cue that captures attention within lowercase text. In this paper, we present a systematic empirical characterization study revealing that Large Language Models (LLMs) exhibit an analogous property: letter casing modulates internal attention allocation. Through analysis across 13 models, nine LLMs and four Vision-Language Models (VLMs), with diverse tokenization schemes, we show that formatting target information in alternating or uppercase against a lowercase context concentrates attention on those textual spans. In text this effect is universal, holding across every evaluated non-reasoning model. We frame it as a previously under-explored latent property of pretrained transformers rather than a prescriptive method. Our investigation reveals a central attention-performance divergence: while this \"casing effect\" robustly shifts attention, its impact on downstream accuracy is non-trivial, increased concentration does not inherently improve task accuracy and, in high-entropy contexts like alternating case, can degrade it. We further identify a boundary condition: the deliberative \"thinking\" phase in reasoning models acts as a semantic buffer that mitigates typographic sensitivity in text. Extending the study to VLMs, we find the effect transfers partially: the same prompt-side casing reorganizes cross-modal attention along two coupled axes, predominantly a macroscopic disengagement from the image toward the text prompt, and secondarily a concentration of the residual visual attention on the target region. By isolating casing as a zero-shot mechanism for attention steering that requires no model access or fine-tuning, we provide a new foundational understanding of how pretraining internalizes typographic emphasis."},{"descriptionType":"Other","description":"Accepted at ECCV 2026"}],"geoLocations":[],"fundingReferences":[],"url":"https://arxiv.org/abs/2608.03711","contentUrl":null,"metadataVersion":0,"schemaVersion":"http://datacite.org/schema/kernel-4","source":"mds","isActive":true,"state":"findable","reason":null,"viewCount":0,"downloadCount":0,"referenceCount":0,"citationCount":0,"partCount":0,"partOfCount":0,"versionCount":0,"versionOfCount":0,"created":"2026-08-05T02:19:12Z","registered":"2026-08-05T02:19:13Z","published":null,"updated":"2026-08-05T02:19:13Z"},"relationships":{"client":{"data":{"id":"arxiv.content","type":"clients"}}}},{"id":"10.48550/arxiv.2608.03710","type":"dois","attributes":{"doi":"10.48550/arxiv.2608.03710","identifiers":[{"identifier":"2608.03710","identifierType":"arXiv"}],"creators":[{"nameType":"Personal","givenName":"Yuwei","familyName":"Lei","name":"Lei, Yuwei","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Zihua","familyName":"Song","name":"Song, Zihua","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Lin","familyName":"Chen","name":"Chen, Lin","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Mingju","familyName":"Liu","name":"Liu, Mingju","affiliation":[],"nameIdentifiers":[]}],"titles":[{"title":"Entanglement Distillation of some Rank-Five Symmetric NPT States in Two-Qutrit Systems"}],"publisher":"arXiv","container":{},"publicationYear":2026,"subjects":[{"subject":"Quantum Physics (quant-ph)","lang":"en","subjectScheme":"arXiv"},{"subject":"FOS: Physical sciences","subjectScheme":"Fields of Science and Technology (FOS)"}],"contributors":[],"dates":[{"date":"2026-08-04T14:15:52Z","dateType":"Submitted","dateInformation":"v1"},{"date":"2026-08-05T00:57:24Z","dateType":"Updated","dateInformation":"v1"},{"date":"2026-08","dateType":"Available","dateInformation":"v1"}],"language":null,"types":{"schemaOrg":"CreativeWork","resourceTypeGeneral":"Preprint","citeproc":"article","bibtex":"misc","ris":"GEN","resourceType":"Article"},"relatedIdentifiers":[],"relatedItems":[],"sizes":[],"formats":[],"version":"1","rightsList":[{"rightsIdentifierScheme":"SPDX","rightsUri":"https://creativecommons.org/licenses/by/4.0/legalcode","schemeUri":"https://spdx.org/licenses/","rights":"Creative Commons Attribution 4.0 International","rightsIdentifier":"cc-by-4.0"}],"descriptions":[{"descriptionType":"Abstract","description":"Entanglement distillation is a fundamental task in quantum information processing. In this work, we investigate the distillability properties of a class of two-qutrit symmetric NPT states of rank five. We resolve the 1-distillability problem for this class by proving that the previously open interval of the eigenvalue parameter is 1-undistillable. For the 2-distillability, we uncover a structural obstruction showing that no Schmidt-rank-two vector has a negative expectation in the relevant subspace. We also perform numerical investigations to explore the 2-distillability beyond this obstruction."}],"geoLocations":[],"fundingReferences":[],"url":"https://arxiv.org/abs/2608.03710","contentUrl":null,"metadataVersion":0,"schemaVersion":"http://datacite.org/schema/kernel-4","source":"mds","isActive":true,"state":"findable","reason":null,"viewCount":0,"downloadCount":0,"referenceCount":0,"citationCount":0,"partCount":0,"partOfCount":0,"versionCount":0,"versionOfCount":0,"created":"2026-08-05T02:19:11Z","registered":"2026-08-05T02:19:11Z","published":null,"updated":"2026-08-05T02:19:11Z"},"relationships":{"client":{"data":{"id":"arxiv.content","type":"clients"}}}},{"id":"10.48550/arxiv.2608.03709","type":"dois","attributes":{"doi":"10.48550/arxiv.2608.03709","identifiers":[{"identifier":"2608.03709","identifierType":"arXiv"}],"creators":[{"nameType":"Personal","givenName":"Ranjita","familyName":"Naik","name":"Naik, Ranjita","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Anh D.","familyName":"Nguyen","name":"Nguyen, Anh D.","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Pankaj Kumar","familyName":"Singh","name":"Singh, Pankaj Kumar","affiliation":[],"nameIdentifiers":[]}],"titles":[{"title":"Predicting Deep Neural Network Training Outcomes from Early Training Telemetry"}],"publisher":"arXiv","container":{},"publicationYear":2026,"subjects":[{"subject":"Computation and Language (cs.CL)","lang":"en","subjectScheme":"arXiv"},{"subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"}],"contributors":[],"dates":[{"date":"2026-08-04T14:13:21Z","dateType":"Submitted","dateInformation":"v1"},{"date":"2026-08-05T00:57:17Z","dateType":"Updated","dateInformation":"v1"},{"date":"2026-08","dateType":"Available","dateInformation":"v1"}],"language":null,"types":{"schemaOrg":"CreativeWork","resourceTypeGeneral":"Preprint","citeproc":"article","bibtex":"misc","ris":"GEN","resourceType":"Article"},"relatedIdentifiers":[],"relatedItems":[],"sizes":[],"formats":[],"version":"1","rightsList":[{"rightsIdentifierScheme":"SPDX","rightsUri":"https://creativecommons.org/licenses/by/4.0/legalcode","schemeUri":"https://spdx.org/licenses/","rights":"Creative Commons Attribution 4.0 International","rightsIdentifier":"cc-by-4.0"}],"descriptions":[{"descriptionType":"Abstract","description":"Large hyperparameter sweeps for deep neural networks spend substantial compute on configurations that are effectively doomed from the first few epochs. We study whether a single training run's own early telemetry - per-epoch loss, training accuracy, gradient signal-to-noise ratio, weight-norm growth, and an activation-saturation snapshot - together with its sampled hyperparameters, can predict that run's eventual outcome without reference to other runs. We evaluate three prediction tasks: final test accuracy, relative performance within a domain, and training-dynamics failure, including numerical divergence. Across 23,788 training runs spanning six architecture/dataset combinations, gradient-boosted trees using only the first five epochs of telemetry achieve R^2 = 0.92-0.99 for final-accuracy regression and ROC-AUC = 0.983-0.998 for relative classification on a permanently held-out set of hyperparameter configurations. Useful prediction is already available after a single epoch. A paired ablation shows that gradient- and weight-level telemetry provides a statistically consistent improvement over loss and accuracy curves alone, although the practical gain varies by domain. Transfer is strong between similar architectures, while cross-dataset transfer is limited mainly by differences in accuracy scale rather than loss of the underlying relationship. These results suggest that early-training telemetry can provide a practical decision-support signal for compute allocation while motivating human oversight for any automated intervention."},{"descriptionType":"Other","description":"21 pages, 6 figures, 7 tables, includes appendices"}],"geoLocations":[],"fundingReferences":[],"url":"https://arxiv.org/abs/2608.03709","contentUrl":null,"metadataVersion":0,"schemaVersion":"http://datacite.org/schema/kernel-4","source":"mds","isActive":true,"state":"findable","reason":null,"viewCount":0,"downloadCount":0,"referenceCount":0,"citationCount":0,"partCount":0,"partOfCount":0,"versionCount":0,"versionOfCount":0,"created":"2026-08-05T02:19:09Z","registered":"2026-08-05T02:19:10Z","published":null,"updated":"2026-08-05T02:19:10Z"},"relationships":{"client":{"data":{"id":"arxiv.content","type":"clients"}}}},{"id":"10.48550/arxiv.2608.03707","type":"dois","attributes":{"doi":"10.48550/arxiv.2608.03707","identifiers":[{"identifier":"2608.03707","identifierType":"arXiv"}],"creators":[{"nameType":"Personal","givenName":"Neha","familyName":"Hotwani","name":"Hotwani, Neha","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"T. S. S. R. K.","familyName":"Rao","name":"Rao, T. S. S. R. K.","affiliation":[],"nameIdentifiers":[]}],"titles":[{"title":"Weakly Compact Operators Whose Adjoints Preserve $C^*$-Structure"}],"publisher":"arXiv","container":{},"publicationYear":2026,"subjects":[{"subject":"Functional Analysis (math.FA)","lang":"en","subjectScheme":"arXiv"},{"subject":"FOS: Mathematics","subjectScheme":"Fields of Science and Technology (FOS)"}],"contributors":[],"dates":[{"date":"2026-08-04T14:12:45Z","dateType":"Submitted","dateInformation":"v1"},{"date":"2026-08-05T00:57:13Z","dateType":"Updated","dateInformation":"v1"},{"date":"2026-08","dateType":"Available","dateInformation":"v1"}],"language":null,"types":{"schemaOrg":"CreativeWork","resourceTypeGeneral":"Preprint","citeproc":"article","bibtex":"misc","ris":"GEN","resourceType":"Article"},"relatedIdentifiers":[],"relatedItems":[],"sizes":[],"formats":[],"version":"1","rightsList":[{"rightsUri":"http://arxiv.org/licenses/nonexclusive-distrib/1.0/","rights":"arXiv.org perpetual, non-exclusive license"}],"descriptions":[{"descriptionType":"Abstract","description":"Let $Ω$ be a compact Hausdorff space and $X$ be a complex Banach space such that $X^{**}$ is isometric to a $C^*$-algebra. Let $\\mathcal{W}(X^*, C(Ω))$ denote the space of weakly compact operators. In this article, we show that the collection of operators $T$ in $\\mathcal{W}(X^*, C(Ω))$ such that $T^*$ maps linear extreme points of the unit ball of $C(Ω)^*$ to $C^*$-extreme points of $X^{**}$ is a uniformly strongly extreme set. We also investigate this phenomenon when $X^{**}$ is isometric to a space of all operators on a Banach space."},{"descriptionType":"Other","description":"11 pages. Comments are welcome"}],"geoLocations":[],"fundingReferences":[],"url":"https://arxiv.org/abs/2608.03707","contentUrl":null,"metadataVersion":0,"schemaVersion":"http://datacite.org/schema/kernel-4","source":"mds","isActive":true,"state":"findable","reason":null,"viewCount":0,"downloadCount":0,"referenceCount":0,"citationCount":0,"partCount":0,"partOfCount":0,"versionCount":0,"versionOfCount":0,"created":"2026-08-05T02:19:07Z","registered":"2026-08-05T02:19:07Z","published":null,"updated":"2026-08-05T02:19:07Z"},"relationships":{"client":{"data":{"id":"arxiv.content","type":"clients"}}}},{"id":"10.48550/arxiv.2608.03706","type":"dois","attributes":{"doi":"10.48550/arxiv.2608.03706","identifiers":[{"identifier":"2608.03706","identifierType":"arXiv"}],"creators":[{"nameType":"Personal","givenName":"Congwei","familyName":"Song","name":"Song, Congwei","affiliation":[],"nameIdentifiers":[]}],"titles":[{"title":"To Describe or Construct Statistical Learning Models Using the Category-theoretical Language"}],"publisher":"arXiv","container":{},"publicationYear":2026,"subjects":[{"subject":"Machine Learning (cs.LG)","lang":"en","subjectScheme":"arXiv"},{"subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"}],"contributors":[],"dates":[{"date":"2026-08-04T14:12:00Z","dateType":"Submitted","dateInformation":"v1"},{"date":"2026-08-05T00:57:13Z","dateType":"Updated","dateInformation":"v1"},{"date":"2026-08","dateType":"Available","dateInformation":"v1"}],"language":null,"types":{"schemaOrg":"CreativeWork","resourceTypeGeneral":"Preprint","citeproc":"article","bibtex":"misc","ris":"GEN","resourceType":"Article"},"relatedIdentifiers":[],"relatedItems":[],"sizes":[],"formats":[],"version":"1","rightsList":[{"rightsUri":"http://arxiv.org/licenses/nonexclusive-distrib/1.0/","rights":"arXiv.org perpetual, non-exclusive license"}],"descriptions":[{"descriptionType":"Abstract","description":"Statistical learning is a fascinating field that has long been the mainstream of machine learning/artificial intelligence. A large number of results have been produced which can be widely applied to real-world problems. It also leads to many research topics and also stimulates new research. This report summarizes some classical statistical learning models and well-known algorithms, especially for amateurs, and provides a category-theoretic perspective on understanding statistical learning models. The aim is to attract researchers from other fields, including basic mathematics, to participate in the research related to statistical learning."}],"geoLocations":[],"fundingReferences":[],"url":"https://arxiv.org/abs/2608.03706","contentUrl":null,"metadataVersion":0,"schemaVersion":"http://datacite.org/schema/kernel-4","source":"mds","isActive":true,"state":"findable","reason":null,"viewCount":0,"downloadCount":0,"referenceCount":0,"citationCount":0,"partCount":0,"partOfCount":0,"versionCount":0,"versionOfCount":0,"created":"2026-08-05T02:19:05Z","registered":null,"published":null,"updated":"2026-08-05T02:19:06Z"},"relationships":{"client":{"data":{"id":"arxiv.content","type":"clients"}}}},{"id":"10.48550/arxiv.2608.03705","type":"dois","attributes":{"doi":"10.48550/arxiv.2608.03705","identifiers":[{"identifier":"2608.03705","identifierType":"arXiv"}],"creators":[{"nameType":"Personal","givenName":"Jonaid","familyName":"Shianifar","name":"Shianifar, Jonaid","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Blaz","familyName":"Mramor","name":"Mramor, Blaz","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Fangda","familyName":"Zou","name":"Zou, Fangda","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Matthieu C.","familyName":"Martin","name":"Martin, Matthieu C.","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Xingsheng","familyName":"Guo","name":"Guo, Xingsheng","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Zhihua","familyName":"Zhu","name":"Zhu, Zhihua","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Rong","familyName":"Zhou","name":"Zhou, Rong","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Bichen","familyName":"Shi","name":"Shi, Bichen","affiliation":[],"nameIdentifiers":[]}],"titles":[{"title":"Less Traffic, Better Outcomes: Competition-Aware Request Dispatch in Real-Time Ad Exchanges"}],"publisher":"arXiv","container":{},"publicationYear":2026,"subjects":[{"subject":"Artificial Intelligence (cs.AI)","lang":"en","subjectScheme":"arXiv"},{"subject":"Machine Learning (cs.LG)","lang":"en","subjectScheme":"arXiv"},{"subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"}],"contributors":[],"dates":[{"date":"2026-08-04T14:11:42Z","dateType":"Submitted","dateInformation":"v1"},{"date":"2026-08-05T00:57:12Z","dateType":"Updated","dateInformation":"v1"},{"date":"2026-08","dateType":"Available","dateInformation":"v1"}],"language":null,"types":{"schemaOrg":"CreativeWork","resourceTypeGeneral":"Preprint","citeproc":"article","bibtex":"misc","ris":"GEN","resourceType":"Article"},"relatedIdentifiers":[],"relatedItems":[],"sizes":[],"formats":[],"version":"1","rightsList":[{"rightsIdentifierScheme":"SPDX","rightsUri":"https://creativecommons.org/licenses/by/4.0/legalcode","schemeUri":"https://spdx.org/licenses/","rights":"Creative Commons Attribution 4.0 International","rightsIdentifier":"cc-by-4.0"}],"descriptions":[{"descriptionType":"Abstract","description":"Real-time bidding (RTB) ad exchanges typically forward nearly all incoming requests to demand-side platforms (DSPs), even though only a small fraction receive bids. This over-distribution weakens auction outcomes: DSPs throttle participation under compute and budget constraints, reducing the effective use of limited bidding capacity. We present a competition-aware request dispatch framework that uses distributional bid prediction and probabilistic forwarding to decide whether each request should be sent to each DSP. The system adapts per-DSP thresholds over time through lightweight policy optimization to track non-stationary market conditions. We evaluate the framework through four sequential online experiments on a production platform serving over 20 billion daily requests. A full multi-DSP deployment reduces DSP request volume under the policy by 34.2% while increasing net revenue by 4.6% (p\u0026lt;0.001) in a recent 14-day window after an initial DSP adaptation period. Further analysis highlights strong heterogeneity across traffic segments and reveals that aggregate metrics can be misleading. Segment-level and per-DSP analyses suggest that the policy surfaces comparative advantages among DSPs, improving monetized outcomes without increasing overall request volume."},{"descriptionType":"Other","description":"Accepted for presentation at AdKDD 2026, the premier workshop on artificial intelligence for advertising, held in conjunction with the 32nd ACM SIGKDD Conference on Knowledge Discovery and Data Mining (KDD 2026)"}],"geoLocations":[],"fundingReferences":[],"url":"https://arxiv.org/abs/2608.03705","contentUrl":null,"metadataVersion":0,"schemaVersion":"http://datacite.org/schema/kernel-4","source":"mds","isActive":true,"state":"findable","reason":null,"viewCount":0,"downloadCount":0,"referenceCount":0,"citationCount":0,"partCount":0,"partOfCount":0,"versionCount":0,"versionOfCount":0,"created":"2026-08-05T02:19:04Z","registered":null,"published":null,"updated":"2026-08-05T02:19:04Z"},"relationships":{"client":{"data":{"id":"arxiv.content","type":"clients"}}}},{"id":"10.48550/arxiv.2608.03701","type":"dois","attributes":{"doi":"10.48550/arxiv.2608.03701","identifiers":[{"identifier":"2608.03701","identifierType":"arXiv"}],"creators":[{"nameType":"Personal","givenName":"Fan","familyName":"Yang","name":"Yang, Fan","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Yuting","familyName":"Su","name":"Su, Yuting","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Xiaobo","familyName":"Wang","name":"Wang, Xiaobo","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Yuncheng","familyName":"You","name":"You, Yuncheng","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Fugui","familyName":"Fan","name":"Fan, Fugui","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Yuting","familyName":"Wu","name":"Wu, Yuting","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Minghui","familyName":"Wu","name":"Wu, Minghui","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Chenxu","familyName":"Zhao","name":"Zhao, Chenxu","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"JiaHong","familyName":"Ning","name":"Ning, JiaHong","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Peiguang","familyName":"Jing","name":"Jing, Peiguang","affiliation":[],"nameIdentifiers":[]}],"titles":[{"title":"LiLa-WAM: Lightweight Latent Reasoning World-Action Model for Robotic Manipulation"}],"publisher":"arXiv","container":{},"publicationYear":2026,"subjects":[{"subject":"Robotics (cs.RO)","lang":"en","subjectScheme":"arXiv"},{"subject":"Artificial Intelligence (cs.AI)","lang":"en","subjectScheme":"arXiv"},{"subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"}],"contributors":[],"dates":[{"date":"2026-08-04T14:06:15Z","dateType":"Submitted","dateInformation":"v1"},{"date":"2026-08-05T00:57:01Z","dateType":"Updated","dateInformation":"v1"},{"date":"2026-08","dateType":"Available","dateInformation":"v1"}],"language":null,"types":{"schemaOrg":"CreativeWork","resourceTypeGeneral":"Preprint","citeproc":"article","bibtex":"misc","ris":"GEN","resourceType":"Article"},"relatedIdentifiers":[],"relatedItems":[],"sizes":[],"formats":[],"version":"1","rightsList":[{"rightsUri":"http://arxiv.org/licenses/nonexclusive-distrib/1.0/","rights":"arXiv.org perpetual, non-exclusive license"}],"descriptions":[{"descriptionType":"Abstract","description":"World-action modeling has emerged as a promising paradigm for robotic control, as it empowers models to go beyond reacting to observations and anticipate how a scene will evolve. However, existing WAMs often incur substantial computational overhead. Pixel-space methods often allocate substantial capacity to visual details that may not be directly relevant to control, while some latent-space methods require multi-stage training to construct the reasoning space. The resulting training cost can make such methods difficult to train under modest computational budgets. In this work, we propose LiLa-WAM, a lightweight world-action model that reasons about the future in a compact latent space and can be trained end-to-end on a single 24GB GPU. Its core design is a compact latent reasoning space jointly shaped by future-state prediction and action generation, which keeps the model lightweight while remaining well aligned with control. For task specification, we further propose the Visual Transition Token(VTT), a language-free task representation that encodes each task as a direction in visual feature space. Experiments on RoboTwin~2.0, LIBERO, and real-robot tasks demonstrate LiLa-WAM's effectiveness, achieving 90.48\\% success across 50 RoboTwin tasks with single-GPU training."}],"geoLocations":[],"fundingReferences":[],"url":"https://arxiv.org/abs/2608.03701","contentUrl":null,"metadataVersion":0,"schemaVersion":"http://datacite.org/schema/kernel-4","source":"mds","isActive":true,"state":"findable","reason":null,"viewCount":0,"downloadCount":0,"referenceCount":0,"citationCount":0,"partCount":0,"partOfCount":0,"versionCount":0,"versionOfCount":0,"created":"2026-08-05T02:18:58Z","registered":null,"published":null,"updated":"2026-08-05T02:18:59Z"},"relationships":{"client":{"data":{"id":"arxiv.content","type":"clients"}}}},{"id":"10.48550/arxiv.2608.03700","type":"dois","attributes":{"doi":"10.48550/arxiv.2608.03700","identifiers":[{"identifier":"2608.03700","identifierType":"arXiv"}],"creators":[{"nameType":"Personal","givenName":"Yongli","familyName":"Xiang","name":"Xiang, Yongli","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Zhifang","familyName":"Zhang","name":"Zhang, Zhifang","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Bojun","familyName":"Yang","name":"Yang, Bojun","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Ziming","familyName":"Hong","name":"Hong, Ziming","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Lei","familyName":"Feng","name":"Feng, Lei","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Miao","familyName":"Xu","name":"Xu, Miao","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Tongliang","familyName":"Liu","name":"Liu, Tongliang","affiliation":[],"nameIdentifiers":[]}],"titles":[{"title":"When Agents Learn to Be You: Benchmarking Privacy Leakage, Impersonation Risk, and Defenses in Persona Skills"}],"publisher":"arXiv","container":{},"publicationYear":2026,"subjects":[{"subject":"Cryptography and Security (cs.CR)","lang":"en","subjectScheme":"arXiv"},{"subject":"Computation and Language (cs.CL)","lang":"en","subjectScheme":"arXiv"},{"subject":"Computers and Society (cs.CY)","lang":"en","subjectScheme":"arXiv"},{"subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"}],"contributors":[],"dates":[{"date":"2026-08-04T14:04:56Z","dateType":"Submitted","dateInformation":"v1"},{"date":"2026-08-05T00:56:51Z","dateType":"Updated","dateInformation":"v1"},{"date":"2026-08","dateType":"Available","dateInformation":"v1"}],"language":null,"types":{"schemaOrg":"CreativeWork","resourceTypeGeneral":"Preprint","citeproc":"article","bibtex":"misc","ris":"GEN","resourceType":"Article"},"relatedIdentifiers":[],"relatedItems":[],"sizes":[],"formats":[],"version":"1","rightsList":[{"rightsUri":"http://arxiv.org/licenses/nonexclusive-distrib/1.0/","rights":"arXiv.org perpetual, non-exclusive license"}],"descriptions":[{"descriptionType":"Abstract","description":"Persona skills distill personal interaction histories into portable and executable artifacts for downstream agents. While enabling flexible personalization, this process concentrates fragmented personal signals, amplifies their impact through reuse, and challenges defenses designed for individual records or retrieval-based memory. To systematically investigate the safety of the persona-skill pipeline, we introduce AntiSkillBench, an end-to-end benchmark for evaluating risks and defenses across the persona-skill pipeline. It comprises: (i) a dataset of 7,500 persona-grounded dialogue traces, constructed from 50 behaviorally rich profiles spanning diverse task scenarios; (ii) an evaluation suite that measures skill-level privacy leakage and agent-level attribute disclosure and behavioral impersonation across three skill-distillation strategies; and (iii) a defense evaluation covering four configurations across online and post-hoc interventions, including active risk suppression and passive provenance protection. Experiments across three frontier agents show that persona-skill risks persist across agent backbones and distillation protocols, extending from explicit attributes to communication styles and personality traits. Existing defenses exhibit limited and distillation-dependent effectiveness, failing to generalize across risk and distillation strategies. These results highlight AntiSkillBench as a challenging benchmark for developing privacy-preserving and authenticity-aware persona skills."},{"descriptionType":"Other","description":"Project page: https://yonglixiang.github.io/AntiSkillBench"}],"geoLocations":[],"fundingReferences":[],"url":"https://arxiv.org/abs/2608.03700","contentUrl":null,"metadataVersion":0,"schemaVersion":"http://datacite.org/schema/kernel-4","source":"mds","isActive":true,"state":"findable","reason":null,"viewCount":0,"downloadCount":0,"referenceCount":0,"citationCount":0,"partCount":0,"partOfCount":0,"versionCount":0,"versionOfCount":0,"created":"2026-08-05T02:18:57Z","registered":"2026-08-05T02:18:58Z","published":null,"updated":"2026-08-05T02:18:58Z"},"relationships":{"client":{"data":{"id":"arxiv.content","type":"clients"}}}},{"id":"10.48550/arxiv.2608.03698","type":"dois","attributes":{"doi":"10.48550/arxiv.2608.03698","identifiers":[{"identifier":"2608.03698","identifierType":"arXiv"}],"creators":[{"nameType":"Personal","givenName":"S. P.","familyName":"O'Neil","name":"O'Neil, S. P.","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"F. C.","familyName":"Langbein","name":"Langbein, F. C.","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"C. A.","familyName":"Weidner","name":"Weidner, C. A.","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"E. A.","familyName":"Jonckheere","name":"Jonckheere, E. A.","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"S.","familyName":"Schirmer","name":"Schirmer, S.","affiliation":[],"nameIdentifiers":[]}],"titles":[{"title":"Fidelity-Based Robustness Margins for Finite-Time Quantum Control"}],"publisher":"arXiv","container":{},"publicationYear":2026,"subjects":[{"subject":"Quantum Physics (quant-ph)","lang":"en","subjectScheme":"arXiv"},{"subject":"Systems and Control (eess.SY)","lang":"en","subjectScheme":"arXiv"},{"subject":"FOS: Physical sciences","subjectScheme":"Fields of Science and Technology (FOS)"},{"subject":"FOS: Electrical engineering, electronic engineering, information engineering","subjectScheme":"Fields of Science and Technology (FOS)"}],"contributors":[],"dates":[{"date":"2026-08-04T14:01:42Z","dateType":"Submitted","dateInformation":"v1"},{"date":"2026-08-05T00:56:38Z","dateType":"Updated","dateInformation":"v1"},{"date":"2026-08","dateType":"Available","dateInformation":"v1"}],"language":null,"types":{"schemaOrg":"CreativeWork","resourceTypeGeneral":"Preprint","citeproc":"article","bibtex":"misc","ris":"GEN","resourceType":"Article"},"relatedIdentifiers":[],"relatedItems":[],"sizes":[],"formats":[],"version":"1","rightsList":[{"rightsUri":"http://arxiv.org/licenses/nonexclusive-distrib/1.0/","rights":"arXiv.org perpetual, non-exclusive license"}],"descriptions":[{"descriptionType":"Abstract","description":"We develop a structure-specific fidelity-threshold robustness margin for finite-dimensional closed quantum systems under piecewise-constant coherent control. A scalar physical parameter may perturb the drift, a control Hamiltonian, or another declared Hamiltonian component across the control horizon. A differential sensitivity bound for trace-amplitude gate fidelity yields a threshold-dependent Lipschitz constant on the connected safe parameter component and hence a certified finite perturbation radius. Recentering this certificate produces an iterative one-dimensional method that takes certified safe steps toward the first fidelity-threshold boundary in either parameter direction. A three-qubit gate-control example shows that these finite margins vary by up to a factor of three across controllers of comparable nominal fidelity and contain structure-dependent information not captured by nominal differential sensitivity alone."}],"geoLocations":[],"fundingReferences":[],"url":"https://arxiv.org/abs/2608.03698","contentUrl":null,"metadataVersion":0,"schemaVersion":"http://datacite.org/schema/kernel-4","source":"mds","isActive":true,"state":"findable","reason":null,"viewCount":0,"downloadCount":0,"referenceCount":0,"citationCount":0,"partCount":0,"partOfCount":0,"versionCount":0,"versionOfCount":0,"created":"2026-08-05T02:18:54Z","registered":null,"published":null,"updated":"2026-08-05T02:18:55Z"},"relationships":{"client":{"data":{"id":"arxiv.content","type":"clients"}}}},{"id":"10.48550/arxiv.2608.03696","type":"dois","attributes":{"doi":"10.48550/arxiv.2608.03696","identifiers":[{"identifier":"2608.03696","identifierType":"arXiv"}],"creators":[{"nameType":"Personal","givenName":"Nelson Aloysio Reis de Almeida","familyName":"Passos","name":"Passos, Nelson Aloysio Reis de Almeida","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Emanuele","familyName":"Carlini","name":"Carlini, Emanuele","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Salvatore","familyName":"Trani","name":"Trani, Salvatore","affiliation":[],"nameIdentifiers":[]}],"titles":[{"title":"Learning and Clustering on Temporal Graphs: Principles, Primitives, and Pooling"}],"publisher":"arXiv","container":{},"publicationYear":2026,"subjects":[{"subject":"Machine Learning (cs.LG)","lang":"en","subjectScheme":"arXiv"},{"subject":"Social and Information Networks (cs.SI)","lang":"en","subjectScheme":"arXiv"},{"subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"}],"contributors":[],"dates":[{"date":"2026-08-04T14:01:08Z","dateType":"Submitted","dateInformation":"v1"},{"date":"2026-08-05T00:56:34Z","dateType":"Updated","dateInformation":"v1"},{"date":"2026-08","dateType":"Available","dateInformation":"v1"}],"language":null,"types":{"schemaOrg":"CreativeWork","resourceTypeGeneral":"Preprint","citeproc":"article","bibtex":"misc","ris":"GEN","resourceType":"Article"},"relatedIdentifiers":[],"relatedItems":[],"sizes":[],"formats":[],"version":"1","rightsList":[{"rightsIdentifierScheme":"SPDX","rightsUri":"https://creativecommons.org/licenses/by/4.0/legalcode","schemeUri":"https://spdx.org/licenses/","rights":"Creative Commons Attribution 4.0 International","rightsIdentifier":"cc-by-4.0"}],"descriptions":[{"descriptionType":"Abstract","description":"This work focuses on the problem of learning on temporal graphs, with particular emphasis on the task of clustering: obtaining coarse-grained representations by aggregating information from nodes, edges, and temporal dynamics - a task related to pooling in machine learning on graphs, or community detection in network science. Although graph neural networks reach state-of-the-art performance across many downstream graph tasks, their advantage over established descriptive and inferential clustering algorithms is far less settled, especially under demands of efficiency and recovery accuracy. We frame this tension through three linked perspectives: principles, connecting graph learning and community detection through shared spectral foundations and detectability thresholds in stochastic block model regimes; primitives, making spectral clustering and multislice modularity optimization tractable through GPU-accelerated temporal backends; and pooling, viewing principled community detection as a theory-grounded coarse-graining operator for temporal graphs. Our results indicate that algorithmic methods remain the appropriate tool where attributes are absent or weak - scalability rather than accuracy being the binding obstacle - while neural models are most compelling when structural, temporal, and attribute signals align. By making temporal clustering scalable, GPU-accelerated primitives suggest a route toward theory-grounded pooling, while raising a central question: when does community-based coarse-graining preserve the dynamics needed for downstream learning tasks?"},{"descriptionType":"Other","description":"4 pages, 1 figure. Accepted at ECML PKDD 2026 (Nectar Track)"}],"geoLocations":[],"fundingReferences":[],"url":"https://arxiv.org/abs/2608.03696","contentUrl":null,"metadataVersion":0,"schemaVersion":"http://datacite.org/schema/kernel-4","source":"mds","isActive":true,"state":"findable","reason":null,"viewCount":0,"downloadCount":0,"referenceCount":0,"citationCount":0,"partCount":0,"partOfCount":0,"versionCount":0,"versionOfCount":0,"created":"2026-08-05T02:18:51Z","registered":"2026-08-05T02:18:52Z","published":null,"updated":"2026-08-05T02:18:52Z"},"relationships":{"client":{"data":{"id":"arxiv.content","type":"clients"}}}},{"id":"10.48550/arxiv.2608.03694","type":"dois","attributes":{"doi":"10.48550/arxiv.2608.03694","identifiers":[{"identifier":"2608.03694","identifierType":"arXiv"}],"creators":[{"nameType":"Personal","givenName":"Amir M.","familyName":"Ahmadian","name":"Ahmadian, Amir M.","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Hazem","familyName":"Torfah","name":"Torfah, Hazem","affiliation":[],"nameIdentifiers":[]}],"titles":[{"title":"Statistical Verification of Quantitative Hyperproperties: Beyond Boolean Quantification"}],"publisher":"arXiv","container":{},"publicationYear":2026,"subjects":[{"subject":"Logic in Computer Science (cs.LO)","lang":"en","subjectScheme":"arXiv"},{"subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"}],"contributors":[],"dates":[{"date":"2026-08-04T14:00:19Z","dateType":"Submitted","dateInformation":"v1"},{"date":"2026-08-05T00:56:32Z","dateType":"Updated","dateInformation":"v1"},{"date":"2026-08","dateType":"Available","dateInformation":"v1"}],"language":null,"types":{"schemaOrg":"CreativeWork","resourceTypeGeneral":"Preprint","citeproc":"article","bibtex":"misc","ris":"GEN","resourceType":"Article"},"relatedIdentifiers":[],"relatedItems":[],"sizes":[],"formats":[],"version":"1","rightsList":[{"rightsUri":"http://arxiv.org/licenses/nonexclusive-distrib/1.0/","rights":"arXiv.org perpetual, non-exclusive license"}],"descriptions":[{"descriptionType":"Abstract","description":"Formalisms for hyperproperties provide a solid foundation for studying the verification problem across classes of relational properties, such as those in information flow control (IFC). However, existing formalisms remain limited in expressiveness when it comes to capturing practical aspects of real-world systems. In particular, they do not adequately account for the quantitative nature of such systems. In this paper, we address this gap by revisiting the specification and verification of hyperproperties from a quantitative, measure-based, perspective. We introduce Quantitative Hyper-Logic (QHL), which replaces qualitative trace quantifiers with measure-based ones and extends temporal predicates with richer quantitative expressions. We further study the verification problem from a statistical verification point of view, and develop algorithms for the statistical verification of QHL specifications. For the introduced measure-based quantifiers, we particularly provide an analysis in terms of sample complexity and achievable statistical guarantees. In particular, we show how statistical methods such as Hoeffding's inequality and extreme value theory can be combined to develop statistical verification algorithms for nested measure-based quantifiers. Our approach provides quantitative alternatives for where traditional verification methods become infeasible. We demonstrate both expressiveness and efficacy on benchmarks from quantitative IFC, comparing against qualitative methods."}],"geoLocations":[],"fundingReferences":[],"url":"https://arxiv.org/abs/2608.03694","contentUrl":null,"metadataVersion":0,"schemaVersion":"http://datacite.org/schema/kernel-4","source":"mds","isActive":true,"state":"findable","reason":null,"viewCount":0,"downloadCount":0,"referenceCount":0,"citationCount":0,"partCount":0,"partOfCount":0,"versionCount":0,"versionOfCount":0,"created":"2026-08-05T02:18:49Z","registered":null,"published":null,"updated":"2026-08-05T02:18:49Z"},"relationships":{"client":{"data":{"id":"arxiv.content","type":"clients"}}}},{"id":"10.48550/arxiv.2608.03693","type":"dois","attributes":{"doi":"10.48550/arxiv.2608.03693","identifiers":[{"identifier":"2608.03693","identifierType":"arXiv"}],"creators":[{"nameType":"Personal","givenName":"Natan","familyName":"de Isídio","name":"de Isídio, Natan","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Paola","familyName":"Popesso","name":"Popesso, Paola","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Sandro","familyName":"Tacchella","name":"Tacchella, Sandro","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Anna","familyName":"Pasquali","name":"Pasquali, Anna","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Ilaria","familyName":"Marini","name":"Marini, Ilaria","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Daudi","familyName":"Mazengo","name":"Mazengo, Daudi","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Victoria","familyName":"Toptun","name":"Toptun, Victoria","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Sean","familyName":"McGee","name":"McGee, Sean","affiliation":[],"nameIdentifiers":[]}],"titles":[{"title":"Circumgalactic medium depletion drives satellite quenching in IllustrisTNG"}],"publisher":"arXiv","container":{},"publicationYear":2026,"subjects":[{"subject":"Astrophysics of Galaxies (astro-ph.GA)","lang":"en","subjectScheme":"arXiv"},{"subject":"FOS: Physical sciences","subjectScheme":"Fields of Science and Technology (FOS)"}],"contributors":[],"dates":[{"date":"2026-08-04T13:59:58Z","dateType":"Submitted","dateInformation":"v1"},{"date":"2026-08-05T00:56:25Z","dateType":"Updated","dateInformation":"v1"},{"date":"2026-08","dateType":"Available","dateInformation":"v1"}],"language":null,"types":{"schemaOrg":"CreativeWork","resourceTypeGeneral":"Preprint","citeproc":"article","bibtex":"misc","ris":"GEN","resourceType":"Article"},"relatedIdentifiers":[],"relatedItems":[],"sizes":[],"formats":[],"version":"1","rightsList":[{"rightsUri":"http://arxiv.org/licenses/nonexclusive-distrib/1.0/","rights":"arXiv.org perpetual, non-exclusive license"}],"descriptions":[{"descriptionType":"Abstract","description":"Satellite galaxies dominate the quenched population at low stellar masses ($M_\\star \\lesssim 10^{10}~\\rm M_\\odot$), yet identifying which processes shut down their star formation, their relative importance, and on what timescales, remains a central problem in galaxy evolution. We use MaNGA-like mock galaxies from IllustrisTNG to dissect different satellite quenching pathways, paying special attention to the role of the circumgalactic medium (CGM) during quenching phase. We reconstruct the baryonic, dark matter, structural, and chemical histories of $\\sim$7 300 galaxies (2 800 satellites), using time since infall as the physical axis along which quenching unfolds. Satellites retain rotation-supported stellar kinematics throughout quenching, with disturbed velocity fields confined to systems with $M_\\star \\lesssim 10^{10.5}~\\rm M_\\odot$. For the first time, we present the coupled time evolution of the depletion of both the hot and cool gas reservoirs after infall: satellites lose $\\sim$90% of their hot CGM within $\\sim$$4.2^{+0.6}_{-0.6}$ Gyr, increasing with residence time and independent of stellar mass. The hot gas mass correlates strongly with SFR, establishing the CGM as the long-term fuel reservoir, unlike quenched centrals, which retain massive hot halos likely maintained by AGN feedback. Present-day quenched satellites were accreted earlier than star-forming ones (6.5$^{+0.3}_{-0.3}$ vs. 4.3$^{+0.3}_{-0.3}$ Gyr ago), forming stars for at least $\\sim$3 Gyr after infall before declining sharply, consistent with a delayed-then-rapid quenching scenario. Losing little stellar mass, yet with their gas depleted and their dark matter and metal-poor stellar outskirts tidally stripped, satellites emerge more compact and metal-rich than centrals at fixed mass. Our results suggest the gradual erosion of the hot CGM as the key link connecting infall to the slow shutdown of star formation."},{"descriptionType":"Other","description":"12 pages, 6 figures, plus appendices. Submitted to A\u0026amp;A. Comments are welcome!"}],"geoLocations":[],"fundingReferences":[],"url":"https://arxiv.org/abs/2608.03693","contentUrl":null,"metadataVersion":0,"schemaVersion":"http://datacite.org/schema/kernel-4","source":"mds","isActive":true,"state":"findable","reason":null,"viewCount":0,"downloadCount":0,"referenceCount":0,"citationCount":0,"partCount":0,"partOfCount":0,"versionCount":0,"versionOfCount":0,"created":"2026-08-05T02:18:47Z","registered":"2026-08-05T02:18:48Z","published":null,"updated":"2026-08-05T02:18:48Z"},"relationships":{"client":{"data":{"id":"arxiv.content","type":"clients"}}}},{"id":"10.48550/arxiv.2608.03691","type":"dois","attributes":{"doi":"10.48550/arxiv.2608.03691","identifiers":[{"identifier":"2608.03691","identifierType":"arXiv"}],"creators":[{"nameType":"Personal","givenName":"Khai-Nguyen","familyName":"Nguyen","name":"Nguyen, Khai-Nguyen","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Oscar","familyName":"Chaparro","name":"Chaparro, Oscar","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Antonio","familyName":"Mastropaolo","name":"Mastropaolo, Antonio","affiliation":[],"nameIdentifiers":[]}],"titles":[{"title":"Pattern over Pixels: Measuring Pattern Completion Bias in Multimodal Code Generation"}],"publisher":"arXiv","container":{},"publicationYear":2026,"subjects":[{"subject":"Software Engineering (cs.SE)","lang":"en","subjectScheme":"arXiv"},{"subject":"Artificial Intelligence (cs.AI)","lang":"en","subjectScheme":"arXiv"},{"subject":"Computer Vision and Pattern Recognition (cs.CV)","lang":"en","subjectScheme":"arXiv"},{"subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"}],"contributors":[],"dates":[{"date":"2026-08-04T13:59:12Z","dateType":"Submitted","dateInformation":"v1"},{"date":"2026-08-05T00:56:21Z","dateType":"Updated","dateInformation":"v1"},{"date":"2026-08","dateType":"Available","dateInformation":"v1"}],"language":null,"types":{"schemaOrg":"CreativeWork","resourceTypeGeneral":"Preprint","citeproc":"article","bibtex":"misc","ris":"GEN","resourceType":"Article"},"relatedIdentifiers":[{"relationType":"IsVersionOf","relatedIdentifier":"10.1145/3832783.3834443","relatedIdentifierType":"DOI"}],"relatedItems":[],"sizes":[],"formats":[],"version":"1","rightsList":[{"rightsIdentifierScheme":"SPDX","rightsUri":"https://creativecommons.org/licenses/by/4.0/legalcode","schemeUri":"https://spdx.org/licenses/","rights":"Creative Commons Attribution 4.0 International","rightsIdentifier":"cc-by-4.0"}],"descriptions":[{"descriptionType":"Abstract","description":"Multimodal large language models (MLLMs) are increasingly used to translate webpage screenshots into front-end code, but repeated UI patterns may sway them toward visually incorrect yet pattern-consistent outputs. In this work, we test how repeated webpage patterns hurt MLLM accuracy on an objective screenshot-to-code fill-in-the-blank task. We introduce the first benchmark for visual pattern-completion bias, where one localized element in a repeated UI pattern is perturbed and the model must recover the masked width or font-size value from the screenshot and HTML context. Starting from 30 webpages curated from the Design2Code dataset, we build 1,440 evaluated screenshots spanning structural card and text-style patterns under standard and noise-overlaid conditions. We evaluate five frontier MLLMs and find that all are strongly biased toward the repeated baseline. Mean bias rate reaches 69.78% on card-width perturbations and 80.22% on text font-size perturbations, while mean accuracy is only 21.17% and 7.89%, respectively. Codex-5.3 performs best but still drops from 68.61% accuracy on cards to 13.89% on text, while Flash-3.0 reaches 96.11% bias on text. Noise, subtler perturbations, and boundary positions further increase bias rate. Reasoning analysis further shows that greater reasoning effort correlates with lower bias, yet qualitative evidence reveals that models can identify the anomalous element and still override it with the pattern-consistent answer. Our results identify a concrete failure mode in multimodal code generation and show that its severity is strongly associated with visual saliency"},{"descriptionType":"Other","description":"41st IEEE/ACM International Conference on Automated Software Engineering"}],"geoLocations":[],"fundingReferences":[],"url":"https://arxiv.org/abs/2608.03691","contentUrl":null,"metadataVersion":0,"schemaVersion":"http://datacite.org/schema/kernel-4","source":"mds","isActive":true,"state":"findable","reason":null,"viewCount":0,"downloadCount":0,"referenceCount":0,"citationCount":0,"partCount":0,"partOfCount":0,"versionCount":0,"versionOfCount":1,"created":"2026-08-05T02:18:44Z","registered":"2026-08-05T02:18:45Z","published":null,"updated":"2026-08-05T02:18:45Z"},"relationships":{"client":{"data":{"id":"arxiv.content","type":"clients"}}}},{"id":"10.48550/arxiv.2608.03690","type":"dois","attributes":{"doi":"10.48550/arxiv.2608.03690","identifiers":[{"identifier":"2608.03690","identifierType":"arXiv"}],"creators":[{"nameType":"Personal","givenName":"Edoardo","familyName":"Coppola","name":"Coppola, Edoardo","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Stefano","familyName":"Fiorini","name":"Fiorini, Stefano","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Pietro","familyName":"Liò","name":"Liò, Pietro","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Mattia","familyName":"Savardi","name":"Savardi, Mattia","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Alberto","familyName":"Signoroni","name":"Signoroni, Alberto","affiliation":[],"nameIdentifiers":[]}],"titles":[{"title":"LAEF: A Lead-Agnostic ECG Foundation Model Towards Point-of-Care Diagnostics"}],"publisher":"arXiv","container":{},"publicationYear":2026,"subjects":[{"subject":"Machine Learning (cs.LG)","lang":"en","subjectScheme":"arXiv"},{"subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"}],"contributors":[],"dates":[{"date":"2026-08-04T13:58:10Z","dateType":"Submitted","dateInformation":"v1"},{"date":"2026-08-05T00:56:20Z","dateType":"Updated","dateInformation":"v1"},{"date":"2026-08","dateType":"Available","dateInformation":"v1"}],"language":null,"types":{"schemaOrg":"CreativeWork","resourceTypeGeneral":"Preprint","citeproc":"article","bibtex":"misc","ris":"GEN","resourceType":"Article"},"relatedIdentifiers":[],"relatedItems":[],"sizes":[],"formats":[],"version":"1","rightsList":[{"rightsUri":"http://arxiv.org/licenses/nonexclusive-distrib/1.0/","rights":"arXiv.org perpetual, non-exclusive license"}],"descriptions":[{"descriptionType":"Abstract","description":"Point-of-care cardiac devices such as smartwatches and handheld ECG recorders typically capture 1--2 leads, yet existing ECG foundation models are architecturally constrained to fixed 12-lead inputs, degrading or failing under these reduced configurations. We introduce LAEF (Lead-Agnostic ECG Foundation), a 7M-parameter ECG foundation model that can natively process any lead subset without zero-padding or architectural modification. LAEF represents ECGs as variable-size spatiotemporal graphs with physiologically motivated intra- and inter-lead connectivity, processed by a Graph Attention Network that scales naturally with active lead count.Pre-trained on 9.2M 12-lead ECGs via masked node modelling with stochastic lead sampling, LAEF learns representations robust to lead configuration. Across 18 downstream datasets, LAEF is on par with specialized 12-lead baselines over 12$\\times$ larger at full lead availability. Under direct point-of-care-oriented diagnostics (1--2 leads), it outperforms all zero-padded alternatives on 17 out of 18 datasets with with a single randomly sampled lead and on 14 out of 18 with 2 leads, with an average AUROC gain of +3.2 points. Representation analysis links this advantage to architectural lead-agnosticism, and a lead-importance study across 164 cardiovascular conditions shows population-level performance is stable across single standard input leads while still recovering established clinically lead-condition associations."}],"geoLocations":[],"fundingReferences":[],"url":"https://arxiv.org/abs/2608.03690","contentUrl":null,"metadataVersion":0,"schemaVersion":"http://datacite.org/schema/kernel-4","source":"mds","isActive":true,"state":"findable","reason":null,"viewCount":0,"downloadCount":0,"referenceCount":0,"citationCount":0,"partCount":0,"partOfCount":0,"versionCount":0,"versionOfCount":0,"created":"2026-08-05T02:18:43Z","registered":null,"published":null,"updated":"2026-08-05T02:18:43Z"},"relationships":{"client":{"data":{"id":"arxiv.content","type":"clients"}}}},{"id":"10.48550/arxiv.2608.03689","type":"dois","attributes":{"doi":"10.48550/arxiv.2608.03689","identifiers":[{"identifier":"2608.03689","identifierType":"arXiv"}],"creators":[{"nameType":"Personal","givenName":"Yiyao","familyName":"Wang","name":"Wang, Yiyao","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Zhen","familyName":"Wen","name":"Wen, Zhen","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Yinghao","familyName":"Tang","name":"Tang, Yinghao","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Yixiao","familyName":"Fu","name":"Fu, Yixiao","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Lin","familyName":"Yuan","name":"Yuan, Lin","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Xiaolau","familyName":"Zhang","name":"Zhang, Xiaolau","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Jun","familyName":"Zhou","name":"Zhou, Jun","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Wei","familyName":"Chen","name":"Chen, Wei","affiliation":[],"nameIdentifiers":[]}],"titles":[{"title":"LiveEvalBench: Toward Open-World Evaluation for Web Generation"}],"publisher":"arXiv","container":{},"publicationYear":2026,"subjects":[{"subject":"Artificial Intelligence (cs.AI)","lang":"en","subjectScheme":"arXiv"},{"subject":"Software Engineering (cs.SE)","lang":"en","subjectScheme":"arXiv"},{"subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"}],"contributors":[],"dates":[{"date":"2026-08-04T13:57:48Z","dateType":"Submitted","dateInformation":"v1"},{"date":"2026-08-05T00:56:18Z","dateType":"Updated","dateInformation":"v1"},{"date":"2026-08","dateType":"Available","dateInformation":"v1"}],"language":null,"types":{"schemaOrg":"CreativeWork","resourceTypeGeneral":"Preprint","citeproc":"article","bibtex":"misc","ris":"GEN","resourceType":"Article"},"relatedIdentifiers":[],"relatedItems":[],"sizes":[],"formats":[],"version":"1","rightsList":[{"rightsIdentifierScheme":"SPDX","rightsUri":"https://creativecommons.org/licenses/by/4.0/legalcode","schemeUri":"https://spdx.org/licenses/","rights":"Creative Commons Attribution 4.0 International","rightsIdentifier":"cc-by-4.0"}],"descriptions":[{"descriptionType":"Abstract","description":"Large language models are increasingly capable of synthesizing executable frontend projects, yet existing benchmarks still treat web generation as a static evaluation problem. We argue that frontend artifacts demand a different paradigm: they are interactive rather than static, admit diverse yet equally valid implementations, and evolve faster than rigid pipelines can accommodate. To address these gaps, we present LiveEvalBench, an automated framework that reformulates web-generation evaluation as an agentic, adaptive, and extensible process. LiveEvalBench instantiates evaluation as a collaborative review workflow, in which a Build Engineer, a Code Engineer, and a UI Tester collectively gather evidence across the full lifecycle of a frontend project, from deployment and code inspection to browser-based interaction. To handle implementation diversity, an adaptive protocol couples shared rubrics for cross-model comparability with implementation-grounded criteria tailored to each artifact. The framework further supports incremental integration of new evaluator roles and assessment dimensions without pipeline redesign. Experiments across diverse real-world web-generation scenarios show that LiveEvalBench aligns closely with human expert judgment and provides fine-grained insights into frontier models' web generation capabilities. Code is available at https://github.com/wyysteelhead/LiveEvalBench"}],"geoLocations":[],"fundingReferences":[],"url":"https://arxiv.org/abs/2608.03689","contentUrl":null,"metadataVersion":0,"schemaVersion":"http://datacite.org/schema/kernel-4","source":"mds","isActive":true,"state":"findable","reason":null,"viewCount":0,"downloadCount":0,"referenceCount":0,"citationCount":0,"partCount":0,"partOfCount":0,"versionCount":0,"versionOfCount":0,"created":"2026-08-05T02:18:41Z","registered":null,"published":null,"updated":"2026-08-05T02:18:42Z"},"relationships":{"client":{"data":{"id":"arxiv.content","type":"clients"}}}},{"id":"10.48550/arxiv.2608.03688","type":"dois","attributes":{"doi":"10.48550/arxiv.2608.03688","identifiers":[{"identifier":"2608.03688","identifierType":"arXiv"}],"creators":[{"nameType":"Personal","givenName":"Jiadong","familyName":"Shen","name":"Shen, Jiadong","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Junjie","familyName":"Chen","name":"Chen, Junjie","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Xiaosa","familyName":"Xu","name":"Xu, Xiaosa","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Jin","familyName":"Li","name":"Li, Jin","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Zhenyu","familyName":"Wang","name":"Wang, Zhenyu","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Pengzhu","familyName":"Lin","name":"Lin, Pengzhu","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Zixiao","familyName":"Guo","name":"Guo, Zixiao","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Yu","familyName":"Wang","name":"Wang, Yu","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Jing","familyName":"Sun","name":"Sun, Jing","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Baoling","familyName":"Huang","name":"Huang, Baoling","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Tianshou","familyName":"Zhao","name":"Zhao, Tianshou","affiliation":[],"nameIdentifiers":[]}],"titles":[{"title":"Machine Learning-Guided Screening of Advantageous Solvents for Solid Polymer Electrolytes in Lithium Metal Batteries"}],"publisher":"arXiv","container":{},"publicationYear":2026,"subjects":[{"subject":"Materials Science (cond-mat.mtrl-sci)","lang":"en","subjectScheme":"arXiv"},{"subject":"FOS: Physical sciences","subjectScheme":"Fields of Science and Technology (FOS)"}],"contributors":[],"dates":[{"date":"2026-08-04T13:57:32Z","dateType":"Submitted","dateInformation":"v1"},{"date":"2026-08-05T00:56:17Z","dateType":"Updated","dateInformation":"v1"},{"date":"2026-08","dateType":"Available","dateInformation":"v1"}],"language":null,"types":{"schemaOrg":"CreativeWork","resourceTypeGeneral":"Preprint","citeproc":"article","bibtex":"misc","ris":"GEN","resourceType":"Article"},"relatedIdentifiers":[{"relationType":"IsVersionOf","relatedIdentifier":"10.1021/acs.nanolett.5c00797","relatedIdentifierType":"DOI"}],"relatedItems":[],"sizes":[],"formats":[],"version":"1","rightsList":[{"rightsIdentifierScheme":"SPDX","rightsUri":"https://creativecommons.org/licenses/by/4.0/legalcode","schemeUri":"https://spdx.org/licenses/","rights":"Creative Commons Attribution 4.0 International","rightsIdentifier":"cc-by-4.0"}],"descriptions":[{"descriptionType":"Abstract","description":"Trace residual solvents in solid polymer electrolytes (SPEs) significantly affect electrolyte and interface properties, where optimal selection enhances ionic conductivity and transference numbers. However, solvent complexity hinders general screening methods. We establish a universal criterion linking electronic (HOMO, LUMO) and macroscopic properties (dielectric constant, dipole moment, polarizability) via machine learning on an approximately 10,000-solvent dataset from high-throughput DFT. Two solvents, N-methoxy-N-methyl-2,2,2-trifluoroacetamide and 2,2,2-trifluoro-N,N-dimethylacetamide, were identified. Experimental incorporation of trace N-methoxy-N-methyl-2,2,2-trifluoroacetamide into a poly(vinylidene fluoride-co-hexafluoropropylene) matrix achieves a 4.5 V window, 5.5x10^-4 S cm^-1 conductivity (30 C), and 0.78 Li+ transference number. The cell retains 86.7% capacity over 500 cycles (LiFePO4) and 98.7% after 200 cycles at 2C (LiNi0.9Co0.05Mn0.05O2), outperforming 2,2,2-trifluoro-N,N-dimethylacetamide, dimethylformamide, N-methyl-2-pyrrolidone, and dimethyl sulfoxide. This synergy enables balanced ion transport, wide stability, and cycling durability, advancing safer, high-energy lithium metal batteries. Our integrated approach establishes a solvent screening paradigm for rational SPE design, accelerating next-generation battery development."}],"geoLocations":[],"fundingReferences":[],"url":"https://arxiv.org/abs/2608.03688","contentUrl":null,"metadataVersion":0,"schemaVersion":"http://datacite.org/schema/kernel-4","source":"mds","isActive":true,"state":"findable","reason":null,"viewCount":0,"downloadCount":0,"referenceCount":0,"citationCount":0,"partCount":0,"partOfCount":0,"versionCount":0,"versionOfCount":1,"created":"2026-08-05T02:18:40Z","registered":"2026-08-05T02:18:41Z","published":null,"updated":"2026-08-05T02:18:41Z"},"relationships":{"client":{"data":{"id":"arxiv.content","type":"clients"}}}},{"id":"10.48550/arxiv.2608.03686","type":"dois","attributes":{"doi":"10.48550/arxiv.2608.03686","identifiers":[{"identifier":"2608.03686","identifierType":"arXiv"}],"creators":[{"nameType":"Personal","givenName":"P.","familyName":"Yin","name":"Yin, P.","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"H. T.","familyName":"Zhao","name":"Zhao, H. T.","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"C. Y.","familyName":"Zhai","name":"Zhai, C. Y.","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"J. P.","familyName":"Vary","name":"Vary, J. P.","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"H.","familyName":"Li","name":"Li, H.","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"J. M.","familyName":"Dong","name":"Dong, J. M.","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"H. J.","familyName":"Ong","name":"Ong, H. J.","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"X.","familyName":"Zhao","name":"Zhao, X.","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"P. J.","familyName":"Fasano","name":"Fasano, P. J.","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"A. M.","familyName":"Shirokov","name":"Shirokov, A. M.","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"J.","familyName":"Chen","name":"Chen, J.","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"D. Y.","familyName":"Tao","name":"Tao, D. Y.","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"B.","familyName":"Zhou","name":"Zhou, B.","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"C.","familyName":"Ji","name":"Ji, C.","affiliation":[],"nameIdentifiers":[]}],"titles":[{"title":"Finite-spectrum Lorentz integral transform calculation of the $^{4}$He photoabsorption cross section in the no-core shell model"}],"publisher":"arXiv","container":{},"publicationYear":2026,"subjects":[{"subject":"Nuclear Theory (nucl-th)","lang":"en","subjectScheme":"arXiv"},{"subject":"Nuclear Experiment (nucl-ex)","lang":"en","subjectScheme":"arXiv"},{"subject":"FOS: Physical sciences","subjectScheme":"Fields of Science and Technology (FOS)"}],"contributors":[],"dates":[{"date":"2026-08-04T13:55:59Z","dateType":"Submitted","dateInformation":"v1"},{"date":"2026-08-05T00:56:15Z","dateType":"Updated","dateInformation":"v1"},{"date":"2026-08","dateType":"Available","dateInformation":"v1"}],"language":null,"types":{"schemaOrg":"CreativeWork","resourceTypeGeneral":"Preprint","citeproc":"article","bibtex":"misc","ris":"GEN","resourceType":"Article"},"relatedIdentifiers":[],"relatedItems":[],"sizes":[],"formats":[],"version":"1","rightsList":[{"rightsUri":"http://arxiv.org/licenses/nonexclusive-distrib/1.0/","rights":"arXiv.org perpetual, non-exclusive license"}],"descriptions":[{"descriptionType":"Abstract","description":"We develop and validate a finite-spectrum implementation of the Lorentz integral transform (LIT) within the \\textit{ab initio} no-core shell model (NCSM) for calculating the photoabsorption cross section of $^4$He. A large set of $1^-$ eigenstates is explicitly calculated in the NCSM, and the LIT is constructed from their excitation energies and the corresponding $E1$ transition strengths. This finite-spectrum approach is complementary to conventional inhomogeneous-equation and Lanczos-based implementations of the LIT method for photoabsorption cross sections. Using the Daejeon16 interaction, we extract the photoabsorption cross section and examine its stability with respect to the model-space truncation, excitation-energy cutoff, and LIT parameters. The reliability of the finite-spectrum extraction is assessed by comparing the $E1$ polarizability and bremsstrahlung sum rule obtained from the discrete NCSM spectrum with the same quantities obtained by integrating the extracted cross section. The extracted cross section captures the principal features of the available $^4$He photonuclear data in the giant-dipole-resonance region and is consistent, in the low-energy rise and main-peak region, with earlier chiral-interaction NCSM-LIT results obtained from Lanczos-based evaluations, while the present calculation with the Daejeon16 interaction exhibits a more pronounced high-energy shoulder. The present work provides a controlled finite-spectrum NCSM-LIT route from explicitly calculated many-body eigenstates and transition strengths to photoabsorption cross sections."}],"geoLocations":[],"fundingReferences":[],"url":"https://arxiv.org/abs/2608.03686","contentUrl":null,"metadataVersion":0,"schemaVersion":"http://datacite.org/schema/kernel-4","source":"mds","isActive":true,"state":"findable","reason":null,"viewCount":0,"downloadCount":0,"referenceCount":0,"citationCount":0,"partCount":0,"partOfCount":0,"versionCount":0,"versionOfCount":0,"created":"2026-08-05T02:18:37Z","registered":"2026-08-05T02:18:38Z","published":null,"updated":"2026-08-05T02:18:38Z"},"relationships":{"client":{"data":{"id":"arxiv.content","type":"clients"}}}},{"id":"10.48550/arxiv.2608.03685","type":"dois","attributes":{"doi":"10.48550/arxiv.2608.03685","identifiers":[{"identifier":"2608.03685","identifierType":"arXiv"}],"creators":[{"nameType":"Personal","givenName":"Angela","familyName":"Monti","name":"Monti, Angela","affiliation":[],"nameIdentifiers":[]}],"titles":[{"title":"Pattern formation: reactivity is not necessary for chemotaxis--driven instabilities"}],"publisher":"arXiv","container":{},"publicationYear":2026,"subjects":[{"subject":"Dynamical Systems (math.DS)","lang":"en","subjectScheme":"arXiv"},{"subject":"Numerical Analysis (math.NA)","lang":"en","subjectScheme":"arXiv"},{"subject":"Mathematical Physics (math-ph)","lang":"en","subjectScheme":"arXiv"},{"subject":"FOS: Mathematics","subjectScheme":"Fields of Science and Technology (FOS)"},{"subject":"FOS: Physical sciences","subjectScheme":"Fields of Science and Technology (FOS)"},{"subject":"35B36, 92C15, 65M06, 37N25","lang":"en","subjectScheme":"MSC"}],"contributors":[],"dates":[{"date":"2026-08-04T13:55:37Z","dateType":"Submitted","dateInformation":"v1"},{"date":"2026-08-05T00:56:14Z","dateType":"Updated","dateInformation":"v1"},{"date":"2026-08","dateType":"Available","dateInformation":"v1"}],"language":null,"types":{"schemaOrg":"CreativeWork","resourceTypeGeneral":"Preprint","citeproc":"article","bibtex":"misc","ris":"GEN","resourceType":"Article"},"relatedIdentifiers":[],"relatedItems":[],"sizes":[],"formats":[],"version":"1","rightsList":[{"rightsIdentifierScheme":"SPDX","rightsUri":"https://creativecommons.org/licenses/by-sa/4.0/legalcode","schemeUri":"https://spdx.org/licenses/","rights":"Creative Commons Attribution Share Alike 4.0 International","rightsIdentifier":"cc-by-sa-4.0"}],"descriptions":[{"descriptionType":"Abstract","description":"A classical result by Neubert, Caswell and Murray states that reactivity of a spatially homogeneous equilibrium is a necessary condition for diffusion-driven (Turing) instability. In this work, we investigate whether the same conclusion remains valid in the presence of chemotaxis. We consider a general reaction--diffusion system coupled with a chemotactic flux and establish necessary conditions for asymptotic instability. We show that the classical requirement of reactivity can be relaxed when the chemotactic contribution is sufficiently strong. In particular, while reactivity remains necessary for Turing instability, it is not a necessary condition for chemotaxis-driven instability. From a computational viewpoint, we extend the matrix-oriented formulation developed for reaction--diffusion systems to the more general class of reaction--diffusion--chemotaxis models. The chemotactic transport term is discretized in a form compatible with the matrix-oriented approximation of the diffusion operator, yielding an efficient numerical framework for the simulation of chemotaxis-driven pattern formation. A geometric interpretation of the instability region is presented, highlighting the distinct roles played by diffusion and chemotaxis. The theoretical and numerical developments are illustrated through two representative examples: a chemotaxis-extended Schnakenberg model, showing how chemotaxis modifies classical Turing patterns, and a predator--prey model, demonstrating that chemotaxis alone can induce pattern formation in the absence of both reactivity and diffusion-driven instability. These results reveal a fundamental difference between diffusion-driven and chemotaxis-driven mechanisms of spatial self-organization and provide new theoretical and computational insights into the role of non-symmetric transport processes in biological pattern formation."}],"geoLocations":[],"fundingReferences":[],"url":"https://arxiv.org/abs/2608.03685","contentUrl":null,"metadataVersion":0,"schemaVersion":"http://datacite.org/schema/kernel-4","source":"mds","isActive":true,"state":"findable","reason":null,"viewCount":0,"downloadCount":0,"referenceCount":0,"citationCount":0,"partCount":0,"partOfCount":0,"versionCount":0,"versionOfCount":0,"created":"2026-08-05T02:18:36Z","registered":null,"published":null,"updated":"2026-08-05T02:18:36Z"},"relationships":{"client":{"data":{"id":"arxiv.content","type":"clients"}}}},{"id":"10.48550/arxiv.2608.03684","type":"dois","attributes":{"doi":"10.48550/arxiv.2608.03684","identifiers":[{"identifier":"2608.03684","identifierType":"arXiv"}],"creators":[{"nameType":"Personal","givenName":"Alexander","familyName":"Perry","name":"Perry, Alexander","affiliation":[],"nameIdentifiers":[]}],"titles":[{"title":"The period-index conjecture is false"}],"publisher":"arXiv","container":{},"publicationYear":2026,"subjects":[{"subject":"Algebraic Geometry (math.AG)","lang":"en","subjectScheme":"arXiv"},{"subject":"FOS: Mathematics","subjectScheme":"Fields of Science and Technology (FOS)"}],"contributors":[],"dates":[{"date":"2026-08-04T13:54:53Z","dateType":"Submitted","dateInformation":"v1"},{"date":"2026-08-05T00:56:13Z","dateType":"Updated","dateInformation":"v1"},{"date":"2026-08","dateType":"Available","dateInformation":"v1"}],"language":null,"types":{"schemaOrg":"CreativeWork","resourceTypeGeneral":"Preprint","citeproc":"article","bibtex":"misc","ris":"GEN","resourceType":"Article"},"relatedIdentifiers":[],"relatedItems":[],"sizes":[],"formats":[],"version":"1","rightsList":[{"rightsUri":"http://arxiv.org/licenses/nonexclusive-distrib/1.0/","rights":"arXiv.org perpetual, non-exclusive license"}],"descriptions":[{"descriptionType":"Abstract","description":"For any uncountable algebraically closed field $k$ of characteristic $0$ and any $d \\geq 3$, we construct a variety over $k$ of dimension $d$ with a Brauer class which violates the period-index conjecture for Hodge-theoretic reasons. When $d = 3$, our construction works even without the assumption that $k$ is uncountable; in particular, the period-index conjecture fails over $\\overline{\\mathbf{Q}}$."},{"descriptionType":"Other","description":"17 pages"}],"geoLocations":[],"fundingReferences":[],"url":"https://arxiv.org/abs/2608.03684","contentUrl":null,"metadataVersion":0,"schemaVersion":"http://datacite.org/schema/kernel-4","source":"mds","isActive":true,"state":"findable","reason":null,"viewCount":0,"downloadCount":0,"referenceCount":0,"citationCount":0,"partCount":0,"partOfCount":0,"versionCount":0,"versionOfCount":0,"created":"2026-08-05T02:18:35Z","registered":"2026-08-05T02:18:35Z","published":null,"updated":"2026-08-05T02:18:35Z"},"relationships":{"client":{"data":{"id":"arxiv.content","type":"clients"}}}},{"id":"10.48550/arxiv.2608.03683","type":"dois","attributes":{"doi":"10.48550/arxiv.2608.03683","identifiers":[{"identifier":"2608.03683","identifierType":"arXiv"}],"creators":[{"nameType":"Personal","givenName":"Chao-Nan","familyName":"Tong","name":"Tong, Chao-Nan","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Hong-Bin","familyName":"Tan","name":"Tan, Hong-Bin","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Ruo-Yu","familyName":"Liu","name":"Liu, Ruo-Yu","affiliation":[],"nameIdentifiers":[]}],"titles":[{"title":"Revisiting the XMM-Newton Observations of the Galactic Microquasar SS 433: Implications for the Origin of the Ultrahigh-Energy Emission Detected by LHAASO"}],"publisher":"arXiv","container":{},"publicationYear":2026,"subjects":[{"subject":"High Energy Astrophysical Phenomena (astro-ph.HE)","lang":"en","subjectScheme":"arXiv"},{"subject":"FOS: Physical sciences","subjectScheme":"Fields of Science and Technology (FOS)"}],"contributors":[],"dates":[{"date":"2026-08-04T13:54:23Z","dateType":"Submitted","dateInformation":"v1"},{"date":"2026-08-05T00:56:12Z","dateType":"Updated","dateInformation":"v1"},{"date":"2026-08","dateType":"Available","dateInformation":"v1"}],"language":null,"types":{"schemaOrg":"CreativeWork","resourceTypeGeneral":"Preprint","citeproc":"article","bibtex":"misc","ris":"GEN","resourceType":"Article"},"relatedIdentifiers":[],"relatedItems":[],"sizes":[],"formats":[],"version":"1","rightsList":[{"rightsIdentifierScheme":"SPDX","rightsUri":"https://creativecommons.org/licenses/by/4.0/legalcode","schemeUri":"https://spdx.org/licenses/","rights":"Creative Commons Attribution 4.0 International","rightsIdentifier":"cc-by-4.0"}],"descriptions":[{"descriptionType":"Abstract","description":"Recently, the Large High Altitude Air Shower Observatory (LHAASO) detected ultrahigh-energy (UHE; photon energy E\u0026gt;100TeV) $γ$-ray emission toward SS 433, the microquasar embedded in the W50 nebula, making it a promising Galactic PeVatron candidate. We reanalyze the archival XMM-Newton observations covering the bipolar jets and the thermal X-ray shell north of SS 433, and derive spatially resolved profiles of the nonthermal X-ray intensity and photon index along both jets. The jet emission softens with distance from the source, implying a correspondingly evolving electron population. In particular, a hard electron component appears close to the jet bases, which can account for the UHE emission from SS 433 via inverse Compton radiation if the magnetic field remains approximately uniform along the jets. The result, however, is highly sensitive to the magnetic field profile. For flux-conserving configurations in which the field decreases as the jet expands, the stronger field required in the inner regions may reduce the number of X-ray-emitting electrons and suppress their inverse Compton emission. Furthermore, electron transport calculations show that injection only at the jet bases cannot reproduce the observed intensity and spectral evolution, particularly the downstream re-brightening features, indicating additional particle injection and/or re-acceleration within the jets."},{"descriptionType":"Other","description":"18 pages, 13 figures; submitted to The Astrophysical Journal (currently under review)"}],"geoLocations":[],"fundingReferences":[],"url":"https://arxiv.org/abs/2608.03683","contentUrl":null,"metadataVersion":0,"schemaVersion":"http://datacite.org/schema/kernel-4","source":"mds","isActive":true,"state":"findable","reason":null,"viewCount":0,"downloadCount":0,"referenceCount":0,"citationCount":0,"partCount":0,"partOfCount":0,"versionCount":0,"versionOfCount":0,"created":"2026-08-05T02:18:33Z","registered":null,"published":null,"updated":"2026-08-05T02:18:34Z"},"relationships":{"client":{"data":{"id":"arxiv.content","type":"clients"}}}},{"id":"10.48550/arxiv.2608.03680","type":"dois","attributes":{"doi":"10.48550/arxiv.2608.03680","identifiers":[{"identifier":"2608.03680","identifierType":"arXiv"}],"creators":[{"nameType":"Personal","givenName":"Sneha","familyName":"Mittal","name":"Mittal, Sneha","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Alan E. Anaya","familyName":"Morales","name":"Morales, Alan E. Anaya","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Victor","familyName":"Rosendal","name":"Rosendal, Victor","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Mads","familyName":"Brandbyge","name":"Brandbyge, Mads","affiliation":[],"nameIdentifiers":[]}],"titles":[{"title":"Machine Learning Bandgap Prediction of Nanoporous Graphenes with Water"}],"publisher":"arXiv","container":{},"publicationYear":2026,"subjects":[{"subject":"Mesoscale and Nanoscale Physics (cond-mat.mes-hall)","lang":"en","subjectScheme":"arXiv"},{"subject":"FOS: Physical sciences","subjectScheme":"Fields of Science and Technology (FOS)"}],"contributors":[],"dates":[{"date":"2026-08-04T13:53:30Z","dateType":"Submitted","dateInformation":"v1"},{"date":"2026-08-05T00:56:07Z","dateType":"Updated","dateInformation":"v1"},{"date":"2026-08","dateType":"Available","dateInformation":"v1"}],"language":null,"types":{"schemaOrg":"CreativeWork","resourceTypeGeneral":"Preprint","citeproc":"article","bibtex":"misc","ris":"GEN","resourceType":"Article"},"relatedIdentifiers":[],"relatedItems":[],"sizes":[],"formats":[],"version":"1","rightsList":[{"rightsUri":"http://arxiv.org/licenses/nonexclusive-distrib/1.0/","rights":"arXiv.org perpetual, non-exclusive license"}],"descriptions":[{"descriptionType":"Abstract","description":"The structure and dynamical behavior of water confined at or within nanostructures is a topic central to many fields, from biology to emerging electronics such as carbon nanostructures. Nanoporous graphene (NPG) containing periodic nanoscale pores with specific topologies has emerged as a promising material in carbon-based nanoelectronics; however, its interaction with ambient water remains poorly understood. Here, we combine density functional theory (DFT), ab initio molecular dynamics (AIMD), and interpretable machine learning (ML) to reveal how water controls quantum transport in NPGs. Depending on the local hydration structure, the bandgap varies by more than a factor of two across NPG and nitrogen-doped hybrid (h-NPG) systems. To uncover the underlying mechanism, we develop Smooth Overlap of Atomic Positions (SOAP)-based black-box and physics-informed grey-box ML models. The Gaussian process regression model achieves near-DFT accuracy while enabling physical interpretation. Analysis identifies water dipole orientation, water-substrate distance, water center-of-geometry, and ribbon-resolved dipole moments as the dominant factors controlling bandgap modulation across NPG and h-NPG systems."}],"geoLocations":[],"fundingReferences":[],"url":"https://arxiv.org/abs/2608.03680","contentUrl":null,"metadataVersion":0,"schemaVersion":"http://datacite.org/schema/kernel-4","source":"mds","isActive":true,"state":"findable","reason":null,"viewCount":0,"downloadCount":0,"referenceCount":0,"citationCount":0,"partCount":0,"partOfCount":0,"versionCount":0,"versionOfCount":0,"created":"2026-08-05T02:18:29Z","registered":"2026-08-05T02:18:30Z","published":null,"updated":"2026-08-05T02:18:30Z"},"relationships":{"client":{"data":{"id":"arxiv.content","type":"clients"}}}},{"id":"10.48550/arxiv.2608.03679","type":"dois","attributes":{"doi":"10.48550/arxiv.2608.03679","identifiers":[{"identifier":"2608.03679","identifierType":"arXiv"}],"creators":[{"nameType":"Personal","givenName":"Joseph","familyName":"McDonald","name":"McDonald, Joseph","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Filip","familyName":"Jankovec","name":"Jankovec, Filip","affiliation":[],"nameIdentifiers":[]}],"titles":[{"title":"The pairwise Stone space of an S4 De Morgan algebra"}],"publisher":"arXiv","container":{},"publicationYear":2026,"subjects":[{"subject":"Logic (math.LO)","lang":"en","subjectScheme":"arXiv"},{"subject":"FOS: Mathematics","subjectScheme":"Fields of Science and Technology (FOS)"}],"contributors":[],"dates":[{"date":"2026-08-04T13:53:09Z","dateType":"Submitted","dateInformation":"v1"},{"date":"2026-08-05T00:56:07Z","dateType":"Updated","dateInformation":"v1"},{"date":"2026-08","dateType":"Available","dateInformation":"v1"}],"language":null,"types":{"schemaOrg":"CreativeWork","resourceTypeGeneral":"Preprint","citeproc":"article","bibtex":"misc","ris":"GEN","resourceType":"Article"},"relatedIdentifiers":[],"relatedItems":[],"sizes":[],"formats":[],"version":"1","rightsList":[{"rightsIdentifierScheme":"SPDX","rightsUri":"https://creativecommons.org/licenses/by/4.0/legalcode","schemeUri":"https://spdx.org/licenses/","rights":"Creative Commons Attribution 4.0 International","rightsIdentifier":"cc-by-4.0"}],"descriptions":[{"descriptionType":"Abstract","description":"The purpose of this study is to investigate the bitopological duality theory of De Morgan algebras equipped with a closure operator, known as S4 De Morgan algebras. We first introduce certain expansions of pairwise Stone spaces, which we call pairwise S4 De Morgan Stone spaces (henceforth, PS4D-spaces). These consist of a pairwise Stone space $X$ equipped with a twist continuous involution $g\\colon X\\to X$, as well as a binary relation $R\\subseteq X\\times X$ that is reflexive and transitive. We first demonstrate that the bitopological spectrum $S_0(A)$ of prime filters of an S4 De Morgan algebra $A$ gives rise to a PS4D-space. A topological representation is then obtained by exhibiting an isomorphism from $A$ to the S4 De Morgan algebra $A_0(S_0(A))$ of $(τ_1,δ_2)$-biclopen subsets of $S_0(A)$ whose operation of De Morgan involution is defined through $g$ and whose closure operator is defined through $R$. We then provide an algebraic realization theorem by showing that every PS4D-space $X$ is bihomeomorphic and relationally isomorphic to the bitopological spectrum $S_0(A_0(X))$ of prime filters of $A_0(X)$. With the introduction of suitable bicontinuous frame morphisms, we show that the category $\\mathbf{S4D}$ of S4 De Morgan algebras is dually equivalent to the category $\\mathbf{PStone_{S4D}}$ of PS4D-spaces. As an application, we provide bitopological characterizations of filters and ideals in general De Morgan algebras under our established duality as well as bitopological soundness and completeness results for an S4-type modal extension of the calculus FDE of first-degree entailment."}],"geoLocations":[],"fundingReferences":[],"url":"https://arxiv.org/abs/2608.03679","contentUrl":null,"metadataVersion":0,"schemaVersion":"http://datacite.org/schema/kernel-4","source":"mds","isActive":true,"state":"findable","reason":null,"viewCount":0,"downloadCount":0,"referenceCount":0,"citationCount":0,"partCount":0,"partOfCount":0,"versionCount":0,"versionOfCount":0,"created":"2026-08-05T02:18:28Z","registered":"2026-08-05T02:18:29Z","published":null,"updated":"2026-08-05T02:18:29Z"},"relationships":{"client":{"data":{"id":"arxiv.content","type":"clients"}}}},{"id":"10.48550/arxiv.2608.03678","type":"dois","attributes":{"doi":"10.48550/arxiv.2608.03678","identifiers":[{"identifier":"2608.03678","identifierType":"arXiv"}],"creators":[{"nameType":"Personal","givenName":"Hai-Jun","familyName":"Li","name":"Li, Hai-Jun","affiliation":[],"nameIdentifiers":[]}],"titles":[{"title":"Hierarchical Axiverse"}],"publisher":"arXiv","container":{},"publicationYear":2026,"subjects":[{"subject":"High Energy Physics - Phenomenology (hep-ph)","lang":"en","subjectScheme":"arXiv"},{"subject":"High Energy Physics - Theory (hep-th)","lang":"en","subjectScheme":"arXiv"},{"subject":"FOS: Physical sciences","subjectScheme":"Fields of Science and Technology (FOS)"}],"contributors":[],"dates":[{"date":"2026-08-04T13:51:45Z","dateType":"Submitted","dateInformation":"v1"},{"date":"2026-08-05T00:55:56Z","dateType":"Updated","dateInformation":"v1"},{"date":"2026-08","dateType":"Available","dateInformation":"v1"}],"language":null,"types":{"schemaOrg":"CreativeWork","resourceTypeGeneral":"Preprint","citeproc":"article","bibtex":"misc","ris":"GEN","resourceType":"Article"},"relatedIdentifiers":[],"relatedItems":[],"sizes":[],"formats":[],"version":"1","rightsList":[{"rightsIdentifierScheme":"SPDX","rightsUri":"https://creativecommons.org/licenses/by/4.0/legalcode","schemeUri":"https://spdx.org/licenses/","rights":"Creative Commons Attribution 4.0 International","rightsIdentifier":"cc-by-4.0"}],"descriptions":[{"descriptionType":"Abstract","description":"String compactifications generically produce ${\\cal O}(100)$ light axion-like particles, yet low-energy mixing has not previously been exploited as a structuring constraint on their spectrum. We show that the requirement of well-defined QCD-induced mass mixing forces the axion masses into a hierarchically spaced ordering, while stochastic mixing organizes the decay constants into a hierarchically split distribution -- two populations separated by an essentially empty window. Both patterns are insensitive to ultraviolet input and satisfy the relevant Swampland constraints within standard large-volume compactifications. We term this emergent pattern the hierarchical axiverse."},{"descriptionType":"Other","description":"5 pages, 2 figures"}],"geoLocations":[],"fundingReferences":[],"url":"https://arxiv.org/abs/2608.03678","contentUrl":null,"metadataVersion":0,"schemaVersion":"http://datacite.org/schema/kernel-4","source":"mds","isActive":true,"state":"findable","reason":null,"viewCount":0,"downloadCount":0,"referenceCount":0,"citationCount":0,"partCount":0,"partOfCount":0,"versionCount":0,"versionOfCount":0,"created":"2026-08-05T02:18:27Z","registered":"2026-08-05T02:18:27Z","published":null,"updated":"2026-08-05T02:18:27Z"},"relationships":{"client":{"data":{"id":"arxiv.content","type":"clients"}}}},{"id":"10.48550/arxiv.2608.03677","type":"dois","attributes":{"doi":"10.48550/arxiv.2608.03677","identifiers":[{"identifier":"2608.03677","identifierType":"arXiv"}],"creators":[{"nameType":"Personal","givenName":"Rana","familyName":"Danesh","name":"Danesh, Rana","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Farrokh","familyName":"Janabi-Sharifi","name":"Janabi-Sharifi, Farrokh","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Farhad","familyName":"Aghili","name":"Aghili, Farhad","affiliation":[],"nameIdentifiers":[]}],"titles":[{"title":"Active Stiffness Control of a Supportive Continuum Robot"}],"publisher":"arXiv","container":{},"publicationYear":2026,"subjects":[{"subject":"Robotics (cs.RO)","lang":"en","subjectScheme":"arXiv"},{"subject":"Systems and Control (eess.SY)","lang":"en","subjectScheme":"arXiv"},{"subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"},{"subject":"FOS: Electrical engineering, electronic engineering, information engineering","subjectScheme":"Fields of Science and Technology (FOS)"}],"contributors":[],"dates":[{"date":"2026-08-04T13:51:05Z","dateType":"Submitted","dateInformation":"v1"},{"date":"2026-08-05T00:55:55Z","dateType":"Updated","dateInformation":"v1"},{"date":"2026-08","dateType":"Available","dateInformation":"v1"}],"language":null,"types":{"schemaOrg":"CreativeWork","resourceTypeGeneral":"Preprint","citeproc":"article","bibtex":"misc","ris":"GEN","resourceType":"Article"},"relatedIdentifiers":[],"relatedItems":[],"sizes":[],"formats":[],"version":"1","rightsList":[{"rightsUri":"http://arxiv.org/licenses/nonexclusive-distrib/1.0/","rights":"arXiv.org perpetual, non-exclusive license"}],"descriptions":[{"descriptionType":"Abstract","description":"Supportive continuum robots (SCRs) enhance the load-bearing capability of an operative continuum robot by mechanically coupling it with a supportive arm. However, their passive stiffness is determined by the mechanical configuration and cannot be adjusted online for varying payloads or interaction forces. Active stiffness control is therefore needed to regulate the load response and maintain positioning accuracy. Meanwhile, the closed-chain structure introduces kinematic constraints that complicate task-space regulation and stiffness control. This paper presents an active task-space stiffness control framework for a tendon-driven SCR. An existing geometric variable strain model describes the closed-chain dynamics, which are projected onto the constraint-consistent motion subspace. A projected sliding mode controller regulates the operative arm tip while preserving the constraints, and closed-loop stability is established through Lyapunov analysis. After position regulation, active apparent stiffness is introduced through a virtual Cartesian spring based on position-error feedback to shape the force--displacement response. The framework is evaluated in simulation and experimentally validated under prescribed external loads and different desired configurations. Results show that increasing the commanded stiffness gain reduces load-induced tip deflection and increases apparent directional stiffness, thereby improving load resistance and positioning robustness under external loading."}],"geoLocations":[],"fundingReferences":[],"url":"https://arxiv.org/abs/2608.03677","contentUrl":null,"metadataVersion":0,"schemaVersion":"http://datacite.org/schema/kernel-4","source":"mds","isActive":true,"state":"findable","reason":null,"viewCount":0,"downloadCount":0,"referenceCount":0,"citationCount":0,"partCount":0,"partOfCount":0,"versionCount":0,"versionOfCount":0,"created":"2026-08-05T02:18:25Z","registered":"2026-08-05T02:18:26Z","published":null,"updated":"2026-08-05T02:18:26Z"},"relationships":{"client":{"data":{"id":"arxiv.content","type":"clients"}}}},{"id":"10.48550/arxiv.2608.03675","type":"dois","attributes":{"doi":"10.48550/arxiv.2608.03675","identifiers":[{"identifier":"2608.03675","identifierType":"arXiv"}],"creators":[{"nameType":"Personal","givenName":"Ivan","familyName":"Kartáč","name":"Kartáč, Ivan","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Jan","familyName":"Tovarys","name":"Tovarys, Jan","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Mateusz","familyName":"Lango","name":"Lango, Mateusz","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Ondřej","familyName":"Dušek","name":"Dušek, Ondřej","affiliation":[],"nameIdentifiers":[]}],"titles":[{"title":"VetScore: Risk-Weighted Fact Verification for Veterinary Long-Form QA with Citations"}],"publisher":"arXiv","container":{},"publicationYear":2026,"subjects":[{"subject":"Computation and Language (cs.CL)","lang":"en","subjectScheme":"arXiv"},{"subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"}],"contributors":[],"dates":[{"date":"2026-08-04T13:49:56Z","dateType":"Submitted","dateInformation":"v1"},{"date":"2026-08-05T00:55:54Z","dateType":"Updated","dateInformation":"v1"},{"date":"2026-08","dateType":"Available","dateInformation":"v1"}],"language":null,"types":{"schemaOrg":"CreativeWork","resourceTypeGeneral":"Preprint","citeproc":"article","bibtex":"misc","ris":"GEN","resourceType":"Article"},"relatedIdentifiers":[],"relatedItems":[],"sizes":[],"formats":[],"version":"1","rightsList":[{"rightsIdentifierScheme":"SPDX","rightsUri":"https://creativecommons.org/licenses/by/4.0/legalcode","schemeUri":"https://spdx.org/licenses/","rights":"Creative Commons Attribution 4.0 International","rightsIdentifier":"cc-by-4.0"}],"descriptions":[{"descriptionType":"Abstract","description":"Citation excerpts can be used to increase the reliability of generated outputs and their faithfulness to cited sources, which is especially important in high-stakes domains such as human and veterinary medicine. However, this does not guarantee that generated claims are faithful to the provided excerpts. We present VetScore, a multi-step evaluation method for veterinary long-form question answering, designed to assess how well are generated claims supported by the provided excerpts, weighing this information by each claim's harm potential. VetScore first segments the output and decomposes it into individual claims, then scores each claim with respect to its harm potential and evaluates its faithfulness to source excerpts, and finally calculates the overall risk-adjusted score. We collect an expert-annotated meta-evaluation dataset, evaluate our approach with a range of judge models, and show that it achieves high correlations with veterinary experts even with small judge models, while offering explainability across multiple dimensions."}],"geoLocations":[],"fundingReferences":[],"url":"https://arxiv.org/abs/2608.03675","contentUrl":null,"metadataVersion":0,"schemaVersion":"http://datacite.org/schema/kernel-4","source":"mds","isActive":true,"state":"findable","reason":null,"viewCount":0,"downloadCount":0,"referenceCount":0,"citationCount":0,"partCount":0,"partOfCount":0,"versionCount":0,"versionOfCount":0,"created":"2026-08-05T02:18:23Z","registered":"2026-08-05T02:18:23Z","published":null,"updated":"2026-08-05T02:18:23Z"},"relationships":{"client":{"data":{"id":"arxiv.content","type":"clients"}}}},{"id":"10.48550/arxiv.2608.03674","type":"dois","attributes":{"doi":"10.48550/arxiv.2608.03674","identifiers":[{"identifier":"2608.03674","identifierType":"arXiv"}],"creators":[{"nameType":"Personal","givenName":"Jian","familyName":"Zhang","name":"Zhang, Jian","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Bingyi","familyName":"Wang","name":"Wang, Bingyi","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Yizhi","familyName":"Liu","name":"Liu, Yizhi","affiliation":[],"nameIdentifiers":[]}],"titles":[{"title":"DiagLoop: A Counterfactual Data Flywheel with Stage-Localized Reinforcement for Diagnostic LLMs"}],"publisher":"arXiv","container":{},"publicationYear":2026,"subjects":[{"subject":"Machine Learning (cs.LG)","lang":"en","subjectScheme":"arXiv"},{"subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"}],"contributors":[],"dates":[{"date":"2026-08-04T13:49:41Z","dateType":"Submitted","dateInformation":"v1"},{"date":"2026-08-05T00:55:53Z","dateType":"Updated","dateInformation":"v1"},{"date":"2026-08","dateType":"Available","dateInformation":"v1"}],"language":null,"types":{"schemaOrg":"CreativeWork","resourceTypeGeneral":"Preprint","citeproc":"article","bibtex":"misc","ris":"GEN","resourceType":"Article"},"relatedIdentifiers":[],"relatedItems":[],"sizes":[],"formats":[],"version":"1","rightsList":[{"rightsUri":"http://arxiv.org/licenses/nonexclusive-distrib/1.0/","rights":"arXiv.org perpetual, non-exclusive license"}],"descriptions":[{"descriptionType":"Abstract","description":"Causal diagnostic models must explain how conclusions follow from evidence because diagnoses guide repairs and treatments. Yet serious cases are scarce, records rarely contain reasoning paths, and data transfer poorly across configurations, complicating local deployment. We present DiagLoop, a counterfactual data flywheel that converts codified physical relations or clinical guidelines, authored once per mechanism family, into training supervision beyond recorded cases. A training-only teacher proposes counterfactual worlds by varying causes, contexts, and observations, while an independent hybrid checker admits only valid worlds. The student reasons through symptom abstraction, causal-chain construction, and root-cause attribution. Stage-specific criteria identify its earliest failure. For nonterminal failures, a bounded repair probes downstream competence, and the resulting weakness profile guides subsequent data generation. Stage-localized reinforcement learning updates only the model-generated continuation, while replay and preservation reduce forgetting. The same criteria govern admission, attribution, reward, and regeneration through checks separate from the proposer. Using only synthesized scenarios and no case-level expert reasoning annotations, the resulting 8B model improves strict path correctness over the strongest conventional baseline. Gains are 11.6 points across eight industrial systems and 5.5 points across ten disease categories. Gains over a deranged-routing control are 3.9 and 2.3 points, respectively. The model also exceeds the evaluated proprietary references in both domains, even when they receive few-shot examples or the specification in context."},{"descriptionType":"Other","description":"9 pages, 2 figures"}],"geoLocations":[],"fundingReferences":[],"url":"https://arxiv.org/abs/2608.03674","contentUrl":null,"metadataVersion":0,"schemaVersion":"http://datacite.org/schema/kernel-4","source":"mds","isActive":true,"state":"findable","reason":null,"viewCount":0,"downloadCount":0,"referenceCount":0,"citationCount":0,"partCount":0,"partOfCount":0,"versionCount":0,"versionOfCount":0,"created":"2026-08-05T02:18:21Z","registered":"2026-08-05T02:18:22Z","published":null,"updated":"2026-08-05T02:18:22Z"},"relationships":{"client":{"data":{"id":"arxiv.content","type":"clients"}}}},{"id":"10.48550/arxiv.2608.03673","type":"dois","attributes":{"doi":"10.48550/arxiv.2608.03673","identifiers":[{"identifier":"2608.03673","identifierType":"arXiv"}],"creators":[{"nameType":"Personal","givenName":"Jian","familyName":"Zhang","name":"Zhang, Jian","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Bingyi","familyName":"Wang","name":"Wang, Bingyi","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Yizhi","familyName":"Liu","name":"Liu, Yizhi","affiliation":[],"nameIdentifiers":[]}],"titles":[{"title":"CausalOPD: First-Wrong-Step Supervision for Distilling Causal Chain Reasoning"}],"publisher":"arXiv","container":{},"publicationYear":2026,"subjects":[{"subject":"Machine Learning (cs.LG)","lang":"en","subjectScheme":"arXiv"},{"subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"}],"contributors":[],"dates":[{"date":"2026-08-04T13:49:12Z","dateType":"Submitted","dateInformation":"v1"},{"date":"2026-08-05T00:55:48Z","dateType":"Updated","dateInformation":"v1"},{"date":"2026-08","dateType":"Available","dateInformation":"v1"}],"language":null,"types":{"schemaOrg":"CreativeWork","resourceTypeGeneral":"Preprint","citeproc":"article","bibtex":"misc","ris":"GEN","resourceType":"Article"},"relatedIdentifiers":[],"relatedItems":[],"sizes":[],"formats":[],"version":"1","rightsList":[{"rightsUri":"http://arxiv.org/licenses/nonexclusive-distrib/1.0/","rights":"arXiv.org perpetual, non-exclusive license"}],"descriptions":[{"descriptionType":"Abstract","description":"Many critical reasoning tasks, including clinical diagnosis, legal judgment, and industrial fault diagnosis, require step-dependent causal chains in which early errors propagate and correct conclusions can mask invalid reasoning. Although large language models perform well on such tasks, privacy, latency, and controllability motivate distillation into locally deployable models. Standard trajectory imitation does not correct process errors on the student's own rollout distribution. We propose CausalOPD, a curriculum online process distillation framework. A knowledge-augmented teacher first provides trajectories grounded in domain-specific causal rules, entity relations, and structural constraints. The student then generates on-policy trajectories, and the teacher identifies the first wrong step, defined as the earliest transition that verifiably violates available constraints. Starting from the verified prefix, short-horizon reinforcement learning repairs this localized failure. A causal-stage curriculum advances from evidence-level to mechanism-level and conclusion-level errors, following their propagation order. Across three domains, CausalOPD improves average path correctness by 23.4 percentage points over sequence-level online process distillation and reduces the right-label-wrong-reasoning rate from 15.7% to 4.4%. The domain-specific 8B students also surpass both evaluated proprietary references in path correctness across all domains."},{"descriptionType":"Other","description":"9 pages, 2 figures"}],"geoLocations":[],"fundingReferences":[],"url":"https://arxiv.org/abs/2608.03673","contentUrl":null,"metadataVersion":0,"schemaVersion":"http://datacite.org/schema/kernel-4","source":"mds","isActive":true,"state":"findable","reason":null,"viewCount":0,"downloadCount":0,"referenceCount":0,"citationCount":0,"partCount":0,"partOfCount":0,"versionCount":0,"versionOfCount":0,"created":"2026-08-05T02:18:20Z","registered":"2026-08-05T02:18:21Z","published":null,"updated":"2026-08-05T02:18:21Z"},"relationships":{"client":{"data":{"id":"arxiv.content","type":"clients"}}}},{"id":"10.48550/arxiv.2608.03672","type":"dois","attributes":{"doi":"10.48550/arxiv.2608.03672","identifiers":[{"identifier":"2608.03672","identifierType":"arXiv"}],"creators":[{"nameType":"Personal","givenName":"Richard M.","familyName":"Höfer","name":"Höfer, Richard M.","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Amina","familyName":"Mecherbet","name":"Mecherbet, Amina","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Gianmarco","familyName":"Sperone","name":"Sperone, Gianmarco","affiliation":[],"nameIdentifiers":[]}],"titles":[{"title":"Brinkman's term for the steady-state Navier-Stokes equations with prescribed flux rate or pressure drop in perforated pipes"}],"publisher":"arXiv","container":{},"publicationYear":2026,"subjects":[{"subject":"Analysis of PDEs (math.AP)","lang":"en","subjectScheme":"arXiv"},{"subject":"FOS: Mathematics","subjectScheme":"Fields of Science and Technology (FOS)"},{"subject":"76M50, 76D05, 35B27, 35M32, 35Q31","lang":"en","subjectScheme":"MSC"}],"contributors":[],"dates":[{"date":"2026-08-04T13:49:09Z","dateType":"Submitted","dateInformation":"v1"},{"date":"2026-08-05T00:55:47Z","dateType":"Updated","dateInformation":"v1"},{"date":"2026-08","dateType":"Available","dateInformation":"v1"}],"language":null,"types":{"schemaOrg":"CreativeWork","resourceTypeGeneral":"Preprint","citeproc":"article","bibtex":"misc","ris":"GEN","resourceType":"Article"},"relatedIdentifiers":[{"relationType":"IsVersionOf","relatedIdentifier":"10.13140/rg.2.2.18110.45123","relatedIdentifierType":"DOI"}],"relatedItems":[],"sizes":[],"formats":[],"version":"1","rightsList":[{"rightsIdentifierScheme":"SPDX","rightsUri":"https://creativecommons.org/licenses/by/4.0/legalcode","schemeUri":"https://spdx.org/licenses/","rights":"Creative Commons Attribution 4.0 International","rightsIdentifier":"cc-by-4.0"}],"descriptions":[{"descriptionType":"Abstract","description":"The steady motion of a viscous incompressible fluid in a distorted pipe, containing several small particles of diameter $\\eps^3$ and mutual distance $\\eps$, is modeled through the Navier-Stokes equations with mixed boundary conditions. Apart from inhomogeneous Dirichlet boundary conditions on the particles, these involve the Bernoulli pressure and the tangential velocity on the inlet and outlet of the tube, while either the transversal flux rate or the pressure drop is prescribed along the pipe. Applying the energy method in homogenization theory, we study the asymptotic behavior of the solutions to these systems as $\\eps \\to 0$, without any restriction on the magnitude of the data, and show that the effective equations display an additional Brinkman term. An important feature of the present work concerns the required uniform bounds, which are achieved (in the case of the prescribed flux problem) by a contradiction argument based on Bernoulli's law for solutions of the stationary Euler equations."}],"geoLocations":[],"fundingReferences":[],"url":"https://arxiv.org/abs/2608.03672","contentUrl":null,"metadataVersion":0,"schemaVersion":"http://datacite.org/schema/kernel-4","source":"mds","isActive":true,"state":"findable","reason":null,"viewCount":0,"downloadCount":0,"referenceCount":0,"citationCount":0,"partCount":0,"partOfCount":0,"versionCount":0,"versionOfCount":1,"created":"2026-08-05T02:18:19Z","registered":"2026-08-05T02:18:19Z","published":null,"updated":"2026-08-05T02:18:19Z"},"relationships":{"client":{"data":{"id":"arxiv.content","type":"clients"}}}},{"id":"10.48550/arxiv.2608.03671","type":"dois","attributes":{"doi":"10.48550/arxiv.2608.03671","identifiers":[{"identifier":"2608.03671","identifierType":"arXiv"}],"creators":[{"nameType":"Personal","givenName":"Sagar","familyName":"Mahapatra","name":"Mahapatra, Sagar","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Francesco","familyName":"De Angelis","name":"De Angelis, Francesco","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Martin","familyName":"Etter","name":"Etter, Martin","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Edmund","familyName":"Welter","name":"Welter, Edmund","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"M. P.","familyName":"Saravanan","name":"Saravanan, M. P.","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Rajeev","familyName":"Rawat","name":"Rawat, Rajeev","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Carlo","familyName":"Meneghini","name":"Meneghini, Carlo","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Surjeet","familyName":"Singh","name":"Singh, Surjeet","affiliation":[],"nameIdentifiers":[]}],"titles":[{"title":"Microscopic Origin of Random Singlet Behavior in B-site Disordered Spin-1/2 Perovskite BaCu_1/3Nb_2/3O_3 Revealed by EXAFS and Thermodynamics"}],"publisher":"arXiv","container":{},"publicationYear":2026,"subjects":[{"subject":"Strongly Correlated Electrons (cond-mat.str-el)","lang":"en","subjectScheme":"arXiv"},{"subject":"Materials Science (cond-mat.mtrl-sci)","lang":"en","subjectScheme":"arXiv"},{"subject":"FOS: Physical sciences","subjectScheme":"Fields of Science and Technology (FOS)"}],"contributors":[],"dates":[{"date":"2026-08-04T13:48:50Z","dateType":"Submitted","dateInformation":"v1"},{"date":"2026-08-05T00:55:41Z","dateType":"Updated","dateInformation":"v1"},{"date":"2026-08","dateType":"Available","dateInformation":"v1"}],"language":null,"types":{"schemaOrg":"CreativeWork","resourceTypeGeneral":"Preprint","citeproc":"article","bibtex":"misc","ris":"GEN","resourceType":"Article"},"relatedIdentifiers":[],"relatedItems":[],"sizes":[],"formats":[],"version":"1","rightsList":[{"rightsIdentifierScheme":"SPDX","rightsUri":"https://creativecommons.org/licenses/by/4.0/legalcode","schemeUri":"https://spdx.org/licenses/","rights":"Creative Commons Attribution 4.0 International","rightsIdentifier":"cc-by-4.0"}],"descriptions":[{"descriptionType":"Abstract","description":"We report a combined structural and thermodynamic study of the ABO$_3$-type disordered perovskite BaCu$_{1/3}$Nb$_{2/3}$O$_3$ (BCNO), whose B site is jointly occupied by Cu and Nb in the $1:2$ ratio. Using synchrotron powder x-ray diffraction (XRD) and x-ray absorption fine structure (XAFS) spectroscopy, we investigate the microscopic nature of Cu$^{2+}$/Nb$^{5+}$ disorder on the pseudo-cubic B-sublattice and its relation to the emergent random-singlet (RS) behavior evidenced at low temperatures. While XRD reveals no long-range Cu/Nb ordering and average site occupancy consistent with stoichiometry, XAFS reveals a peculiar local chemical order characterized by preferential heteroatomic Cu$:$Nb correlations. This local arrangement strongly suppresses direct Cu$:$Cu linkages, despite the Cu concentration being close to the percolation threshold of a cubic lattice. The resulting exchange network explains the absence of spin-glass freezing or long-range magnetic order in the presence of substantial antiferromagnetic interactions, as indicated by a Curie-Weiss temperature $Θ_{CW}\\approx -50$ K. Instead, the magnetic susceptibility $χ(T)$ and specific heat $c_p(T)$ exhibit power-law behavior and characteristic single-parameter $T/H$ scaling over broad temperature and magnetic-field ranges, consistent with random-singlet phenomenology. Notably, at very low temperatures, the specific heat behavior transitions from $T^{1-γ}$ ($γ\\approx 0.6$ from the $T/H$ scaling) in zero-field to a T-linear dependence under high field, indicating a crossover to a distinct low-energy regime whose microscopic origin remains to be established."},{"descriptionType":"Other","description":"Under review"}],"geoLocations":[],"fundingReferences":[],"url":"https://arxiv.org/abs/2608.03671","contentUrl":null,"metadataVersion":0,"schemaVersion":"http://datacite.org/schema/kernel-4","source":"mds","isActive":true,"state":"findable","reason":null,"viewCount":0,"downloadCount":0,"referenceCount":0,"citationCount":0,"partCount":0,"partOfCount":0,"versionCount":0,"versionOfCount":0,"created":"2026-08-05T02:18:17Z","registered":null,"published":null,"updated":"2026-08-05T02:18:18Z"},"relationships":{"client":{"data":{"id":"arxiv.content","type":"clients"}}}},{"id":"10.48550/arxiv.2608.03670","type":"dois","attributes":{"doi":"10.48550/arxiv.2608.03670","identifiers":[{"identifier":"2608.03670","identifierType":"arXiv"}],"creators":[{"nameType":"Personal","givenName":"Nathan","familyName":"DeBardeleben","name":"DeBardeleben, Nathan","affiliation":[],"nameIdentifiers":[]}],"titles":[{"title":"Accountability Asymmetry and Structural Trust in Autonomous AI Systems"}],"publisher":"arXiv","container":{},"publicationYear":2026,"subjects":[{"subject":"Computers and Society (cs.CY)","lang":"en","subjectScheme":"arXiv"},{"subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"}],"contributors":[],"dates":[{"date":"2026-08-04T13:47:54Z","dateType":"Submitted","dateInformation":"v1"},{"date":"2026-08-05T00:55:40Z","dateType":"Updated","dateInformation":"v1"},{"date":"2026-08","dateType":"Available","dateInformation":"v1"}],"language":null,"types":{"schemaOrg":"CreativeWork","resourceTypeGeneral":"Preprint","citeproc":"article","bibtex":"misc","ris":"GEN","resourceType":"Article"},"relatedIdentifiers":[],"relatedItems":[],"sizes":[],"formats":[],"version":"1","rightsList":[{"rightsUri":"http://arxiv.org/licenses/nonexclusive-distrib/1.0/","rights":"arXiv.org perpetual, non-exclusive license"}],"descriptions":[{"descriptionType":"Abstract","description":"Autonomous AI systems (such as AI agents) are increasingly being delegated operational work across scientific-computing infrastructure. Their assignments may begin with preparing an input or routing an alert and extend to changing a configuration or submitting a job. That delegation creates a practical trust problem because the institutional logic that lets us trust human operators does not transfer to optimization-based systems. A bad decision can damage a human operator's future, sometimes severely. An AI system remains subject to engineering control, but it does not bear consequences in that institutional sense.\n I use the term accountability asymmetry for this mismatch. The issue is not simply that a model cannot be punished as a person can. The deeper problem is that consequence lands on the people and institutions responsible for the system rather than on the component selecting the action. Alignment can improve model behavior, and liability can discipline the organization, but neither creates the same pre-action deterrent that governs a human operator. This paper therefore treats autonomous AI governance as a problem of infrastructure reliability. Its constructive proposal is engineered heterogeneity: the process that proposes an action should not serve as its sole approver and auditor. Independent monitoring and review over time provide additional checks on that process."},{"descriptionType":"Other","description":"16 pages, 2 figures"}],"geoLocations":[],"fundingReferences":[],"url":"https://arxiv.org/abs/2608.03670","contentUrl":null,"metadataVersion":0,"schemaVersion":"http://datacite.org/schema/kernel-4","source":"mds","isActive":true,"state":"findable","reason":null,"viewCount":0,"downloadCount":0,"referenceCount":0,"citationCount":0,"partCount":0,"partOfCount":0,"versionCount":0,"versionOfCount":0,"created":"2026-08-05T02:18:16Z","registered":"2026-08-05T02:18:17Z","published":null,"updated":"2026-08-05T02:18:17Z"},"relationships":{"client":{"data":{"id":"arxiv.content","type":"clients"}}}},{"id":"10.48550/arxiv.2608.03668","type":"dois","attributes":{"doi":"10.48550/arxiv.2608.03668","identifiers":[{"identifier":"2608.03668","identifierType":"arXiv"}],"creators":[{"nameType":"Personal","givenName":"Nicola","familyName":"Lorenzoni","name":"Lorenzoni, Nicola","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Susana F.","familyName":"Huelga","name":"Huelga, Susana F.","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Martin B.","familyName":"Plenio","name":"Plenio, Martin B.","affiliation":[],"nameIdentifiers":[]}],"titles":[{"title":"DAMPyF: a Python implementation of the DAMPF method for the simulation of open-system dynamics"}],"publisher":"arXiv","container":{},"publicationYear":2026,"subjects":[{"subject":"Quantum Physics (quant-ph)","lang":"en","subjectScheme":"arXiv"},{"subject":"FOS: Physical sciences","subjectScheme":"Fields of Science and Technology (FOS)"}],"contributors":[],"dates":[{"date":"2026-08-04T13:44:43Z","dateType":"Submitted","dateInformation":"v1"},{"date":"2026-08-05T00:55:33Z","dateType":"Updated","dateInformation":"v1"},{"date":"2026-08","dateType":"Available","dateInformation":"v1"}],"language":null,"types":{"schemaOrg":"CreativeWork","resourceTypeGeneral":"Preprint","citeproc":"article","bibtex":"misc","ris":"GEN","resourceType":"Article"},"relatedIdentifiers":[],"relatedItems":[],"sizes":[],"formats":[],"version":"1","rightsList":[{"rightsIdentifierScheme":"SPDX","rightsUri":"https://creativecommons.org/licenses/by/4.0/legalcode","schemeUri":"https://spdx.org/licenses/","rights":"Creative Commons Attribution 4.0 International","rightsIdentifier":"cc-by-4.0"}],"descriptions":[{"descriptionType":"Abstract","description":"DAMPyF is an open-source Python implementation of the dissipation-assisted matrix product factorization (DAMPF) method, a tensor-network-based approach for the numerically exact simulation of finite-dimensional quantum systems coupled to bosonic environments. The method relies on a pseudomode representation of structured reservoirs and a matrix-product-state representation of the density matrix of the extended system, comprising the system and the pseudomodes. DAMPyF currently provides two workflows. First, it supports excitation energy-transfer dynamics within the single-system-excitation manifold, in which a system excitation is propagated in time. Second, it provides a high-level workflow tailored to molecular spectroscopy, in which the system levels represent electronic states and optical coherences are propagated for the subsequent computation of linear spectra, including absorption and circular dichroism. This paper describes the physical model, the DAMPF algorithm, the user-facing code structure, installation and execution, input and output formats, and minimal examples."}],"geoLocations":[],"fundingReferences":[],"url":"https://arxiv.org/abs/2608.03668","contentUrl":null,"metadataVersion":0,"schemaVersion":"http://datacite.org/schema/kernel-4","source":"mds","isActive":true,"state":"findable","reason":null,"viewCount":0,"downloadCount":0,"referenceCount":0,"citationCount":0,"partCount":0,"partOfCount":0,"versionCount":0,"versionOfCount":0,"created":"2026-08-05T02:18:13Z","registered":"2026-08-05T02:18:14Z","published":null,"updated":"2026-08-05T02:18:14Z"},"relationships":{"client":{"data":{"id":"arxiv.content","type":"clients"}}}},{"id":"10.48550/arxiv.2608.03666","type":"dois","attributes":{"doi":"10.48550/arxiv.2608.03666","identifiers":[{"identifier":"2608.03666","identifierType":"arXiv"}],"creators":[{"nameType":"Personal","givenName":"Elena","familyName":"Izzo","name":"Izzo, Elena","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Riccardo","familyName":"Toniolo","name":"Toniolo, Riccardo","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Lamberto","familyName":"Ballan","name":"Ballan, Lamberto","affiliation":[],"nameIdentifiers":[]}],"titles":[{"title":"XiDepth: a Lightweight and Efficient Network for Self-supervised Monocular Depth Estimation"}],"publisher":"arXiv","container":{},"publicationYear":2026,"subjects":[{"subject":"Computer Vision and Pattern Recognition (cs.CV)","lang":"en","subjectScheme":"arXiv"},{"subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"}],"contributors":[],"dates":[{"date":"2026-08-04T13:42:41Z","dateType":"Submitted","dateInformation":"v1"},{"date":"2026-08-05T00:55:22Z","dateType":"Updated","dateInformation":"v1"},{"date":"2026-08","dateType":"Available","dateInformation":"v1"}],"language":null,"types":{"schemaOrg":"CreativeWork","resourceTypeGeneral":"Preprint","citeproc":"article","bibtex":"misc","ris":"GEN","resourceType":"Article"},"relatedIdentifiers":[],"relatedItems":[],"sizes":[],"formats":[],"version":"1","rightsList":[{"rightsIdentifierScheme":"SPDX","rightsUri":"https://creativecommons.org/licenses/by-nc-nd/4.0/legalcode","schemeUri":"https://spdx.org/licenses/","rights":"Creative Commons Attribution Non Commercial No Derivatives 4.0 International","rightsIdentifier":"cc-by-nc-nd-4.0"}],"descriptions":[{"descriptionType":"Abstract","description":"Self-supervised monocular depth estimation has emerged as an appealing solution to design lightweight and effective models for deployment on computationally constrained devices due to its reduced reliance on expensive depth sensors. By eliminating the need for ground-truth annotations and leveraging the simplicity of monocular camera setups, this approach facilitates cost-effective data collection and broad applicability across fields such as computer vision and robotics. A critical challenge is achieving resource-efficient neural networks without compromising the overall performance. State-of-the-art models generally adopt depth-wise convolutions and attention mechanisms; however, these functions often incur high energy costs and face compatibility issues in embedded environments. To address this, we propose XiDepth, a lightweight architecture based on the XiNet operator block, designed to enhance feature extraction while maintaining low computational complexity and energy demand. On the KITTI dataset, XiDepth achieves state-of-the-art performance with only 0.8M parameters. Tests on a Raspberry Pi 4 further confirm its suitability for real-world embedded applications, reducing FLOPs by 40% and energy consumption by 35% compared to leading methods."},{"descriptionType":"Other","description":"Accepted to IEEE AVSS 2026"}],"geoLocations":[],"fundingReferences":[],"url":"https://arxiv.org/abs/2608.03666","contentUrl":null,"metadataVersion":0,"schemaVersion":"http://datacite.org/schema/kernel-4","source":"mds","isActive":true,"state":"findable","reason":null,"viewCount":0,"downloadCount":0,"referenceCount":0,"citationCount":0,"partCount":0,"partOfCount":0,"versionCount":0,"versionOfCount":0,"created":"2026-08-05T02:18:10Z","registered":null,"published":null,"updated":"2026-08-05T02:18:11Z"},"relationships":{"client":{"data":{"id":"arxiv.content","type":"clients"}}}},{"id":"10.48550/arxiv.2608.03664","type":"dois","attributes":{"doi":"10.48550/arxiv.2608.03664","identifiers":[{"identifier":"2608.03664","identifierType":"arXiv"}],"creators":[{"nameType":"Personal","givenName":"Jiaming","familyName":"Liang","name":"Liang, Jiaming","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"QiHui","familyName":"Han","name":"Han, QiHui","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Haolin","familyName":"Chen","name":"Chen, Haolin","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Chengxin","familyName":"Ye","name":"Ye, Chengxin","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Jiawen","familyName":"Liu","name":"Liu, Jiawen","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Jiazhou","familyName":"Chen","name":"Chen, Jiazhou","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Xiaoqi","familyName":"Sheng","name":"Sheng, Xiaoqi","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Hongmin","familyName":"Cai","name":"Cai, Hongmin","affiliation":[],"nameIdentifiers":[]}],"titles":[{"title":"Morphology-Aware Implicit Super-Resolution Network for Pathological Images"}],"publisher":"arXiv","container":{},"publicationYear":2026,"subjects":[{"subject":"Computer Vision and Pattern Recognition (cs.CV)","lang":"en","subjectScheme":"arXiv"},{"subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"}],"contributors":[],"dates":[{"date":"2026-08-04T13:41:57Z","dateType":"Submitted","dateInformation":"v1"},{"date":"2026-08-05T00:55:20Z","dateType":"Updated","dateInformation":"v1"},{"date":"2026-08","dateType":"Available","dateInformation":"v1"}],"language":null,"types":{"schemaOrg":"CreativeWork","resourceTypeGeneral":"Preprint","citeproc":"article","bibtex":"misc","ris":"GEN","resourceType":"Article"},"relatedIdentifiers":[],"relatedItems":[],"sizes":[],"formats":[],"version":"1","rightsList":[{"rightsUri":"http://arxiv.org/licenses/nonexclusive-distrib/1.0/","rights":"arXiv.org perpetual, non-exclusive license"}],"descriptions":[{"descriptionType":"Abstract","description":"Accurate diagnosis in Digital Pathology (DP) relies on high-resolution whole-slide images, yet clinical deployment is often limited by hardware costs. Super-Resolution (SR) offers a promising alternative by computationally enhancing low-resolution acquisitions. However, existing SR methods frequently struggle to preserve fine-grained cellular morphology, leading to texture oversmoothing and blurred structural boundaries under complex tissue variability. To address this issue, we propose Morph-ISR, a morphology-aware implicit super-resolution framework for DP that restores diagnostically relevant details with sub-pixel precision. Morph-ISR reformulates SR as a continuous coordinate-based reconstruction problem and integrates an Implicit Position-aware Kernel Generator (IPKG) to adaptively model spatially varying tissue morphology. To further enhance structural fidelity, a Morphological Fidelity Prior (MFP) is introduced, leveraging semantic guidance from a pre-trained cell segmentation network to enforce boundary-preserving and region-aware reconstruction, thereby improving the representation of critical cellular boundaries and nuclear textures. Experiments on TCGA and SurGen datasets show that Morph-ISR achieves the best LPIPS and ST-LPIPS among the evaluated methods, reducing them by up to 38.37% and 39.55%, respectively, over the second-best methods while maintaining strong PSNR and SSIM. These results demonstrate superior preservation of diagnostically relevant cellular boundaries and nuclear textures, while compact parameterization and high throughput support efficient edge deployment. Code and trained models will be released upon publication."}],"geoLocations":[],"fundingReferences":[],"url":"https://arxiv.org/abs/2608.03664","contentUrl":null,"metadataVersion":0,"schemaVersion":"http://datacite.org/schema/kernel-4","source":"mds","isActive":true,"state":"findable","reason":null,"viewCount":0,"downloadCount":0,"referenceCount":0,"citationCount":0,"partCount":0,"partOfCount":0,"versionCount":0,"versionOfCount":0,"created":"2026-08-05T02:18:07Z","registered":"2026-08-05T02:18:08Z","published":null,"updated":"2026-08-05T02:18:08Z"},"relationships":{"client":{"data":{"id":"arxiv.content","type":"clients"}}}},{"id":"10.48550/arxiv.2608.03663","type":"dois","attributes":{"doi":"10.48550/arxiv.2608.03663","identifiers":[{"identifier":"2608.03663","identifierType":"arXiv"}],"creators":[{"nameType":"Personal","givenName":"Zi-Cheng","familyName":"Wang","name":"Wang, Zi-Cheng","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Peng-Xiang","familyName":"Du","name":"Du, Peng-Xiang","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Jian","familyName":"Li","name":"Li, Jian","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"T. M.","familyName":"Shneidman","name":"Shneidman, T. M.","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Shan-Gui","familyName":"Zhou","name":"Zhou, Shan-Gui","affiliation":[],"nameIdentifiers":[]}],"titles":[{"title":"Microscopic Statistical Calculation of Nuclear Level Density Based on Relativistic Density Functional Theory"}],"publisher":"arXiv","container":{},"publicationYear":2026,"subjects":[{"subject":"Nuclear Theory (nucl-th)","lang":"en","subjectScheme":"arXiv"},{"subject":"FOS: Physical sciences","subjectScheme":"Fields of Science and Technology (FOS)"}],"contributors":[],"dates":[{"date":"2026-08-04T13:41:28Z","dateType":"Submitted","dateInformation":"v1"},{"date":"2026-08-05T00:55:19Z","dateType":"Updated","dateInformation":"v1"},{"date":"2026-08","dateType":"Available","dateInformation":"v1"}],"language":null,"types":{"schemaOrg":"CreativeWork","resourceTypeGeneral":"Preprint","citeproc":"article","bibtex":"misc","ris":"GEN","resourceType":"Article"},"relatedIdentifiers":[{"relationType":"IsVersionOf","relatedIdentifier":"10.1103/fdxf-plrh","relatedIdentifierType":"DOI"}],"relatedItems":[],"sizes":[],"formats":[],"version":"1","rightsList":[{"rightsUri":"http://arxiv.org/licenses/nonexclusive-distrib/1.0/","rights":"arXiv.org perpetual, non-exclusive license"}],"descriptions":[{"descriptionType":"Abstract","description":"A microscopic statistical model based on the relativistic density functional theory (RDFT) is developed to calculate the nuclear level density (NLD). The approach employs self-consistent single-particle levels obtained from RDFT as input, incorporates pairing correlations within a finite-temperature Bardeen-Cooper-Schrieffer (BCS) theory, and accounts for rotational and vibrational collective enhancement effects. The spin cut-off parameter is calculated from the single-particle levels, thereby naturally retaining the shell effects and the structural characteristics of different nuclei. Using the shape-coexisting nucleus 98Sr as a representative example, the microscopic origin of the deformation effect on the NLD is investigated. In addition, the calculated NLDs are systematically compared with those from various phenomenological and microscopic models, as well as with available experimental data. The results indicate that although certain discrepancies exist among different models, they exhibit consistent overall evolutionary trends. Meanwhile, the RDFT-based microscopic statistical approach is capable of providing a reasonable description of the experimental NLDs as well as the s- and p-wave neutron resonance spacings."},{"descriptionType":"Other","description":"13 pages, 8 figures"}],"geoLocations":[],"fundingReferences":[],"url":"https://arxiv.org/abs/2608.03663","contentUrl":null,"metadataVersion":0,"schemaVersion":"http://datacite.org/schema/kernel-4","source":"mds","isActive":true,"state":"findable","reason":null,"viewCount":0,"downloadCount":0,"referenceCount":0,"citationCount":0,"partCount":0,"partOfCount":0,"versionCount":0,"versionOfCount":1,"created":"2026-08-05T02:18:06Z","registered":"2026-08-05T02:18:07Z","published":null,"updated":"2026-08-05T02:18:07Z"},"relationships":{"client":{"data":{"id":"arxiv.content","type":"clients"}}}},{"id":"10.48550/arxiv.2608.03662","type":"dois","attributes":{"doi":"10.48550/arxiv.2608.03662","identifiers":[{"identifier":"2608.03662","identifierType":"arXiv"}],"creators":[{"nameType":"Personal","givenName":"Filip","familyName":"Cano","name":"Cano, Filip","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Thomas A.","familyName":"Henzinger","name":"Henzinger, Thomas A.","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Konstantin","familyName":"Kueffner","name":"Kueffner, Konstantin","affiliation":[],"nameIdentifiers":[]}],"titles":[{"title":"Shielding for Higher-Order Safety"}],"publisher":"arXiv","container":{},"publicationYear":2026,"subjects":[{"subject":"Artificial Intelligence (cs.AI)","lang":"en","subjectScheme":"arXiv"},{"subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"}],"contributors":[],"dates":[{"date":"2026-08-04T13:41:21Z","dateType":"Submitted","dateInformation":"v1"},{"date":"2026-08-05T00:55:18Z","dateType":"Updated","dateInformation":"v1"},{"date":"2026-08","dateType":"Available","dateInformation":"v1"}],"language":null,"types":{"schemaOrg":"CreativeWork","resourceTypeGeneral":"Preprint","citeproc":"article","bibtex":"misc","ris":"GEN","resourceType":"Article"},"relatedIdentifiers":[],"relatedItems":[],"sizes":[],"formats":[],"version":"1","rightsList":[{"rightsIdentifierScheme":"SPDX","rightsUri":"https://creativecommons.org/licenses/by/4.0/legalcode","schemeUri":"https://spdx.org/licenses/","rights":"Creative Commons Attribution 4.0 International","rightsIdentifier":"cc-by-4.0"}],"descriptions":[{"descriptionType":"Abstract","description":"Safety shields are runtime enforcement mechanisms that restrict the actions of a controller to guarantee safety. Classical shields are usually synthesised for state predicates: the current physical state is either safe or unsafe, and the shield disables precisely those actions that can force the system into an unsafe state in the future. In many cyber-physical applications this view is too coarse. A vehicle approaching an obstacle should not only avoid collision, but also respect speed regulations, force limits induced by acceleration, and jerk limits to prevent injuries. From a physical perspective, these requirements are predicated over the derivatives of the state. This paper develops a finite-state safety-game construction for such high-order smoothness constraints. We define differential safety properties using finite differences over a discretised state space, characterise their expressiveness, and reduce shield synthesis to an ordinary safety game over a history state space. We give a synthesis algorithm whose shields store exactly $k$ past states for properties of order $k$ and prove that this memory is necessary. We describe an iterative synthesis procedure for a maximally permissive shield that operates over hierarchies of derivative constraints. The algorithm solves constraints iteratively in increasing order and uses the solution at each iteration to prune the state space for the next constraint. This makes shield synthesis more efficient in practice, as the algorithm refrains from exploring large regions of the state space that are known to be unsafe."},{"descriptionType":"Other","description":"Accepted at RV 2026"}],"geoLocations":[],"fundingReferences":[],"url":"https://arxiv.org/abs/2608.03662","contentUrl":null,"metadataVersion":0,"schemaVersion":"http://datacite.org/schema/kernel-4","source":"mds","isActive":true,"state":"findable","reason":null,"viewCount":0,"downloadCount":0,"referenceCount":0,"citationCount":0,"partCount":0,"partOfCount":0,"versionCount":0,"versionOfCount":0,"created":"2026-08-05T02:18:05Z","registered":"2026-08-05T02:18:05Z","published":null,"updated":"2026-08-05T02:18:05Z"},"relationships":{"client":{"data":{"id":"arxiv.content","type":"clients"}}}},{"id":"10.48550/arxiv.2608.03658","type":"dois","attributes":{"doi":"10.48550/arxiv.2608.03658","identifiers":[{"identifier":"2608.03658","identifierType":"arXiv"}],"creators":[{"nameType":"Personal","givenName":"Thomas","familyName":"Copie","name":"Copie, Thomas","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Ofer","familyName":"Firstenberg","name":"Firstenberg, Ofer","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"G. P.","familyName":"Teja","name":"Teja, G. P.","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Radim","familyName":"Filip","name":"Filip, Radim","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Hanna Le","familyName":"Jeannic","name":"Jeannic, Hanna Le","affiliation":[],"nameIdentifiers":[]}],"titles":[{"title":"Bimodal non-Gaussian photonic states from a single quantum emitter in a waveguide"}],"publisher":"arXiv","container":{},"publicationYear":2026,"subjects":[{"subject":"Quantum Physics (quant-ph)","lang":"en","subjectScheme":"arXiv"},{"subject":"FOS: Physical sciences","subjectScheme":"Fields of Science and Technology (FOS)"}],"contributors":[],"dates":[{"date":"2026-08-04T13:39:27Z","dateType":"Submitted","dateInformation":"v1"},{"date":"2026-08-05T00:55:10Z","dateType":"Updated","dateInformation":"v1"},{"date":"2026-08","dateType":"Available","dateInformation":"v1"}],"language":null,"types":{"schemaOrg":"CreativeWork","resourceTypeGeneral":"Preprint","citeproc":"article","bibtex":"misc","ris":"GEN","resourceType":"Article"},"relatedIdentifiers":[],"relatedItems":[],"sizes":[],"formats":[],"version":"1","rightsList":[{"rightsUri":"http://arxiv.org/licenses/nonexclusive-distrib/1.0/","rights":"arXiv.org perpetual, non-exclusive license"}],"descriptions":[{"descriptionType":"Abstract","description":"We investigate the generation of deterministic and heralded non-Gaussian states of light, using a single two-level system coupled to a chiral waveguide. We study the case of a single two level system driven by pulsed coherent and squeezed drive in a chiral waveguide. For coherent input pulses, we show that the emitter can deterministically generate Wigner-negative states, albeit of limited rank. Going beyond, using squeezed-vacuum inputs, we show that the interaction produces bimodal non-Gaussian states from which higher-stellar-rank states, including large squeezed cat states, can be experimentally extracted with a substantial success rate. Motivated by experimental implementations, we further analyze the effect of imperfect coupling and of the intrinsic $50\\%$ collection limit of symmetric, non-chiral waveguides. Finally, we propose a simple interferometric scheme that recovers an effectively chiral interaction in an otherwise bidirectional waveguide."}],"geoLocations":[],"fundingReferences":[],"url":"https://arxiv.org/abs/2608.03658","contentUrl":null,"metadataVersion":0,"schemaVersion":"http://datacite.org/schema/kernel-4","source":"mds","isActive":true,"state":"findable","reason":null,"viewCount":0,"downloadCount":0,"referenceCount":0,"citationCount":0,"partCount":0,"partOfCount":0,"versionCount":0,"versionOfCount":0,"created":"2026-08-05T02:17:59Z","registered":"2026-08-05T02:18:00Z","published":null,"updated":"2026-08-05T02:18:00Z"},"relationships":{"client":{"data":{"id":"arxiv.content","type":"clients"}}}},{"id":"10.48550/arxiv.2608.03657","type":"dois","attributes":{"doi":"10.48550/arxiv.2608.03657","identifiers":[{"identifier":"2608.03657","identifierType":"arXiv"}],"creators":[{"nameType":"Personal","givenName":"Nikhil","familyName":"Yewale","name":"Yewale, Nikhil","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Anil","familyName":"Kumar","name":"Kumar, Anil","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Vinod","familyName":"Kadari","name":"Kadari, Vinod","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Ratul","familyName":"Dasgupta","name":"Dasgupta, Ratul","affiliation":[],"nameIdentifiers":[]}],"titles":[{"title":"A windy sea surface with Stokes waves"}],"publisher":"arXiv","container":{},"publicationYear":2026,"subjects":[{"subject":"Fluid Dynamics (physics.flu-dyn)","lang":"en","subjectScheme":"arXiv"},{"subject":"Atmospheric and Oceanic Physics (physics.ao-ph)","lang":"en","subjectScheme":"arXiv"},{"subject":"FOS: Physical sciences","subjectScheme":"Fields of Science and Technology (FOS)"}],"contributors":[],"dates":[{"date":"2026-08-04T13:38:02Z","dateType":"Submitted","dateInformation":"v1"},{"date":"2026-08-05T00:55:03Z","dateType":"Updated","dateInformation":"v1"},{"date":"2026-08","dateType":"Available","dateInformation":"v1"}],"language":null,"types":{"schemaOrg":"CreativeWork","resourceTypeGeneral":"Preprint","citeproc":"article","bibtex":"misc","ris":"GEN","resourceType":"Article"},"relatedIdentifiers":[],"relatedItems":[],"sizes":[],"formats":[],"version":"1","rightsList":[{"rightsIdentifierScheme":"SPDX","rightsUri":"https://creativecommons.org/licenses/by/4.0/legalcode","schemeUri":"https://spdx.org/licenses/","rights":"Creative Commons Attribution 4.0 International","rightsIdentifier":"cc-by-4.0"}],"descriptions":[{"descriptionType":"Abstract","description":"Predicting the transition of wind-forced, gravito-capillary surface waves from smooth to corrugated states remains a longstanding problem in nonlinear wave mechanics. Solving driven-dissipative, nonlinear potential flow equations we map these waves ($4-13$ cm) onto a Reynolds number -- wave energy phase-space. We identify a transition band separating smooth from corrugated wave states - the wave steepness exhibits a non-monotonic dependence on Reynolds number within this. Subharmonic (in)stability analysis reveals that the fastest-growing mode intensifies corrugations on alternate faces of the carrier wave, offering insights with broad implications for interfacial pattern-formation and oceanic remote-sensing."}],"geoLocations":[],"fundingReferences":[],"url":"https://arxiv.org/abs/2608.03657","contentUrl":null,"metadataVersion":0,"schemaVersion":"http://datacite.org/schema/kernel-4","source":"mds","isActive":true,"state":"findable","reason":null,"viewCount":0,"downloadCount":0,"referenceCount":0,"citationCount":0,"partCount":0,"partOfCount":0,"versionCount":0,"versionOfCount":0,"created":"2026-08-05T02:17:58Z","registered":"2026-08-05T02:17:58Z","published":null,"updated":"2026-08-05T02:17:58Z"},"relationships":{"client":{"data":{"id":"arxiv.content","type":"clients"}}}},{"id":"10.48550/arxiv.2608.03656","type":"dois","attributes":{"doi":"10.48550/arxiv.2608.03656","identifiers":[{"identifier":"2608.03656","identifierType":"arXiv"}],"creators":[{"nameType":"Personal","givenName":"Dirk","familyName":"Heimann","name":"Heimann, Dirk","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Felix","familyName":"Wiebe","name":"Wiebe, Felix","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Elie","familyName":"Mounzer","name":"Mounzer, Elie","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Shivesh","familyName":"Kumar","name":"Kumar, Shivesh","affiliation":[],"nameIdentifiers":[]}],"titles":[{"title":"Iterative linear quadratic regulator on SU(N) for multi-qubit gate synthesis"}],"publisher":"arXiv","container":{},"publicationYear":2026,"subjects":[{"subject":"Quantum Physics (quant-ph)","lang":"en","subjectScheme":"arXiv"},{"subject":"FOS: Physical sciences","subjectScheme":"Fields of Science and Technology (FOS)"}],"contributors":[],"dates":[{"date":"2026-08-04T13:36:57Z","dateType":"Submitted","dateInformation":"v1"},{"date":"2026-08-05T00:55:00Z","dateType":"Updated","dateInformation":"v1"},{"date":"2026-08","dateType":"Available","dateInformation":"v1"}],"language":null,"types":{"schemaOrg":"CreativeWork","resourceTypeGeneral":"Preprint","citeproc":"article","bibtex":"misc","ris":"GEN","resourceType":"Article"},"relatedIdentifiers":[],"relatedItems":[],"sizes":[],"formats":[],"version":"1","rightsList":[{"rightsUri":"http://arxiv.org/licenses/nonexclusive-distrib/1.0/","rights":"arXiv.org perpetual, non-exclusive license"}],"descriptions":[{"descriptionType":"Abstract","description":"In quantum optimal control theory, gradient-based trajectory optimization techniques have proven versatile in designing multi-qubit quantum gates. Furthermore, incorporating the underlying Lie-group structure can accelerate the optimization process. In this work, we adapt the Lie-group formulation of the iterative linear quadratic regulator (iLQR) to the special unitary group SU(N) and apply it to quantum gate synthesis, systematically comparing it against the standard Euclidean iLQR formulation across multiple two- to five-qubit gates. We find that in the idealized, unconstrained setting, where all Lie-algebra basis elements are available as drive Hamiltonian terms, the Lie-group formulation converges faster than the Euclidean iLQR formulation. If drive terms are constrained to 2-local Hamiltonian terms, the Lie-group variant converges faster in early optimization iterations, but exhibits greater sensitivity to initialization and a stronger tendency towards local minima. These results demonstrate that incorporating Lie-group geometry into iLQR substantially improves convergence and highlight important next steps for improvements in constrained control settings."},{"descriptionType":"Other","description":"21 pages, 11 figures"}],"geoLocations":[],"fundingReferences":[],"url":"https://arxiv.org/abs/2608.03656","contentUrl":null,"metadataVersion":0,"schemaVersion":"http://datacite.org/schema/kernel-4","source":"mds","isActive":true,"state":"findable","reason":null,"viewCount":0,"downloadCount":0,"referenceCount":0,"citationCount":0,"partCount":0,"partOfCount":0,"versionCount":0,"versionOfCount":0,"created":"2026-08-05T02:17:56Z","registered":"2026-08-05T02:17:57Z","published":null,"updated":"2026-08-05T02:17:57Z"},"relationships":{"client":{"data":{"id":"arxiv.content","type":"clients"}}}},{"id":"10.48550/arxiv.2608.03655","type":"dois","attributes":{"doi":"10.48550/arxiv.2608.03655","identifiers":[{"identifier":"2608.03655","identifierType":"arXiv"}],"creators":[{"nameType":"Personal","givenName":"Zeyu","familyName":"Wang","name":"Wang, Zeyu","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Guanghua","familyName":"Wang","name":"Wang, Guanghua","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Meng","familyName":"Xu","name":"Xu, Meng","affiliation":[],"nameIdentifiers":[]}],"titles":[{"title":"Decoupling Generation and Selection for Budget-Constrained Faithful Summarization"}],"publisher":"arXiv","container":{},"publicationYear":2026,"subjects":[{"subject":"Computation and Language (cs.CL)","lang":"en","subjectScheme":"arXiv"},{"subject":"Artificial Intelligence (cs.AI)","lang":"en","subjectScheme":"arXiv"},{"subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"}],"contributors":[],"dates":[{"date":"2026-08-04T13:36:25Z","dateType":"Submitted","dateInformation":"v1"},{"date":"2026-08-05T00:54:59Z","dateType":"Updated","dateInformation":"v1"},{"date":"2026-08","dateType":"Available","dateInformation":"v1"}],"language":null,"types":{"schemaOrg":"CreativeWork","resourceTypeGeneral":"Preprint","citeproc":"article","bibtex":"misc","ris":"GEN","resourceType":"Article"},"relatedIdentifiers":[],"relatedItems":[],"sizes":[],"formats":[],"version":"1","rightsList":[{"rightsUri":"http://arxiv.org/licenses/nonexclusive-distrib/1.0/","rights":"arXiv.org perpetual, non-exclusive license"}],"descriptions":[{"descriptionType":"Abstract","description":"Abstractive summarization models remain vulnerable to factual inconsistency, redundancy, and weak length control. We propose a modular generation-and-selection framework for sentence-budget-constrained summarization. A pretrained generator produces multiple candidate summaries, which are decomposed into sentence-level candidates. A combinatorial selector then constructs the final summary by balancing relevance, factuality, and redundancy under an explicit budget. The framework supports MMR, ILP, and a DPP-inspired log-determinant objective without retraining the generator. Experiments on CNN/DailyMail, Multi-News, FaithBench, and TofuEval show consistent improvements in factuality and source-grounding metrics, especially for multi-document summarization, at the cost of lower reference-overlap scores. Human evaluation further indicates higher perceived consistency, relevance, clarity, and conciseness, with a small reduction in coherence. These results show that decoupling generation from selection provides a model-agnostic mechanism for improving factual grounding. Code is available at https://anonymous.4open.science/r/bcfs-D05E/."}],"geoLocations":[],"fundingReferences":[],"url":"https://arxiv.org/abs/2608.03655","contentUrl":null,"metadataVersion":0,"schemaVersion":"http://datacite.org/schema/kernel-4","source":"mds","isActive":true,"state":"findable","reason":null,"viewCount":0,"downloadCount":0,"referenceCount":0,"citationCount":0,"partCount":0,"partOfCount":0,"versionCount":0,"versionOfCount":0,"created":"2026-08-05T02:17:55Z","registered":"2026-08-05T02:17:56Z","published":null,"updated":"2026-08-05T02:17:56Z"},"relationships":{"client":{"data":{"id":"arxiv.content","type":"clients"}}}},{"id":"10.48550/arxiv.2608.03654","type":"dois","attributes":{"doi":"10.48550/arxiv.2608.03654","identifiers":[{"identifier":"2608.03654","identifierType":"arXiv"}],"creators":[{"nameType":"Personal","givenName":"Vittorio","familyName":"Baroncini","name":"Baroncini, Vittorio","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Juan Carlos","familyName":"Cantero","name":"Cantero, Juan Carlos","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Claudia","familyName":"García","name":"García, Claudia","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Zineb","familyName":"Hassainia","name":"Hassainia, Zineb","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Joan","familyName":"Mateu","name":"Mateu, Joan","affiliation":[],"nameIdentifiers":[]}],"titles":[{"title":"Uniformly Rotating Euler Configurations with Multiple Vorticity Holes"}],"publisher":"arXiv","container":{},"publicationYear":2026,"subjects":[{"subject":"Analysis of PDEs (math.AP)","lang":"en","subjectScheme":"arXiv"},{"subject":"FOS: Mathematics","subjectScheme":"Fields of Science and Technology (FOS)"}],"contributors":[],"dates":[{"date":"2026-08-04T13:35:45Z","dateType":"Submitted","dateInformation":"v1"},{"date":"2026-08-05T00:54:58Z","dateType":"Updated","dateInformation":"v1"},{"date":"2026-08","dateType":"Available","dateInformation":"v1"}],"language":null,"types":{"schemaOrg":"CreativeWork","resourceTypeGeneral":"Preprint","citeproc":"article","bibtex":"misc","ris":"GEN","resourceType":"Article"},"relatedIdentifiers":[],"relatedItems":[],"sizes":[],"formats":[],"version":"1","rightsList":[{"rightsUri":"http://arxiv.org/licenses/nonexclusive-distrib/1.0/","rights":"arXiv.org perpetual, non-exclusive license"}],"descriptions":[{"descriptionType":"Abstract","description":"We construct new families of uniformly rotating vortex-patch solutions of the two-dimensional incompressible Euler equations consisting of a simply connected outer patch and multiple interior interfaces, which can be interpreted geometrically as holes. More precisely, each solution consists of a single outer vortex patch enclosing $\\mathbf m\\geq2$ identical, highly concentrated inner components arranged at the vertices of a regular $\\mathbf m$-gon; the entire configuration rotates rigidly in the clockwise direction.\n As the concentration parameter tends to zero, the inner components shrink and collapse simultaneously toward the origin, while the outer boundary converges to the unit circle. The corresponding vorticities converge, in the sense of measures, to a Rankine vortex supplemented by a point vortex of circulation $-\\mathbf m$ at its center.\n The proof is based on a contour-dynamics formulation, a symmetry reduction to two nonlinear boundary equations, and a suitable singular rescaling. We then apply an implicit function theorem with a continuous parameter in symmetry-adapted Hölder spaces. To the best of our knowledge, this is the first analytical construction of a desingularization regime in which several concentrated inner components are contained in a common outer patch and collapse simultaneously toward its center."},{"descriptionType":"Other","description":"38 pages, 3 figures"}],"geoLocations":[],"fundingReferences":[],"url":"https://arxiv.org/abs/2608.03654","contentUrl":null,"metadataVersion":0,"schemaVersion":"http://datacite.org/schema/kernel-4","source":"mds","isActive":true,"state":"findable","reason":null,"viewCount":0,"downloadCount":0,"referenceCount":0,"citationCount":0,"partCount":0,"partOfCount":0,"versionCount":0,"versionOfCount":0,"created":"2026-08-05T02:17:54Z","registered":"2026-08-05T02:17:54Z","published":null,"updated":"2026-08-05T02:17:54Z"},"relationships":{"client":{"data":{"id":"arxiv.content","type":"clients"}}}},{"id":"10.48550/arxiv.2608.03653","type":"dois","attributes":{"doi":"10.48550/arxiv.2608.03653","identifiers":[{"identifier":"2608.03653","identifierType":"arXiv"}],"creators":[{"nameType":"Personal","givenName":"Zhijing","familyName":"Hu","name":"Hu, Zhijing","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Changjun","familyName":"Fan","name":"Fan, Changjun","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Yufan","familyName":"Deng","name":"Deng, Yufan","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Zhiguang","familyName":"Cao","name":"Cao, Zhiguang","affiliation":[],"nameIdentifiers":[]}],"titles":[{"title":"AutoSND: From Execution Evidence to Structural Policies for Automated Network Dismantling Heuristic Discovery"}],"publisher":"arXiv","container":{},"publicationYear":2026,"subjects":[{"subject":"Artificial Intelligence (cs.AI)","lang":"en","subjectScheme":"arXiv"},{"subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"}],"contributors":[],"dates":[{"date":"2026-08-04T13:34:52Z","dateType":"Submitted","dateInformation":"v1"},{"date":"2026-08-05T00:54:58Z","dateType":"Updated","dateInformation":"v1"},{"date":"2026-08","dateType":"Available","dateInformation":"v1"}],"language":null,"types":{"schemaOrg":"CreativeWork","resourceTypeGeneral":"Preprint","citeproc":"article","bibtex":"misc","ris":"GEN","resourceType":"Article"},"relatedIdentifiers":[],"relatedItems":[],"sizes":[],"formats":[],"version":"1","rightsList":[{"rightsIdentifierScheme":"SPDX","rightsUri":"https://creativecommons.org/licenses/by-nc-sa/4.0/legalcode","schemeUri":"https://spdx.org/licenses/","rights":"Creative Commons Attribution Non Commercial Share Alike 4.0 International","rightsIdentifier":"cc-by-nc-sa-4.0"}],"descriptions":[{"descriptionType":"Abstract","description":"Network dismantling is fundamental to analyzing the robustness and vulnerability of complex systems, yet practical heuristics must balance effectiveness and computational efficiency, and are usually designed manually by researchers. Existing large language model based automatic heuristic design methods can generate and screen candidates, yet they have difficulty further transforming candidate quality or failure states during execution into structural-level guid- ance for subsequent generation. We propose AutoSND, a three stage tree search framework for complete network dismantling pro- grams. Stage I broadly explores from simple heuristics and archives execution evidence. Stage II compiles candidate records into struc- tural policies concerning local signals, neighborhood access, and state update ranges. Stage III continues tree search conditioned on these policies and obtains the final quality prioritized and speed prioritized candidates, AutoSND-Q/S. Experiments on 12 real world networks and 3 large real world networks show that AutoSND achieves better search performance and stability and discovers more competitive and structurally interpretable network disman- tling programs. The final candidates form an interpretable structure that uses residual degree as the backbone, adjusts node order with bounded local signals, and restricts the state update range. Code is available at https://github.com/MirrorNew/AutoSND."}],"geoLocations":[],"fundingReferences":[],"url":"https://arxiv.org/abs/2608.03653","contentUrl":null,"metadataVersion":0,"schemaVersion":"http://datacite.org/schema/kernel-4","source":"mds","isActive":true,"state":"findable","reason":null,"viewCount":0,"downloadCount":0,"referenceCount":0,"citationCount":0,"partCount":0,"partOfCount":0,"versionCount":0,"versionOfCount":0,"created":"2026-08-05T02:17:52Z","registered":"2026-08-05T02:17:53Z","published":null,"updated":"2026-08-05T02:17:53Z"},"relationships":{"client":{"data":{"id":"arxiv.content","type":"clients"}}}},{"id":"10.48550/arxiv.2608.03652","type":"dois","attributes":{"doi":"10.48550/arxiv.2608.03652","identifiers":[{"identifier":"2608.03652","identifierType":"arXiv"}],"creators":[{"nameType":"Personal","givenName":"K. S. Enoch","familyName":"Lee","name":"Lee, K. S. Enoch","affiliation":[],"nameIdentifiers":[]}],"titles":[{"title":"A Martindale-like Ring of Quotients for any ring"}],"publisher":"arXiv","container":{},"publicationYear":2026,"subjects":[{"subject":"Rings and Algebras (math.RA)","lang":"en","subjectScheme":"arXiv"},{"subject":"FOS: Mathematics","subjectScheme":"Fields of Science and Technology (FOS)"},{"subject":"16S85, 16P70, 16S90","lang":"en","subjectScheme":"MSC"}],"contributors":[],"dates":[{"date":"2026-08-04T13:34:34Z","dateType":"Submitted","dateInformation":"v1"},{"date":"2026-08-05T00:54:57Z","dateType":"Updated","dateInformation":"v1"},{"date":"2026-08","dateType":"Available","dateInformation":"v1"}],"language":null,"types":{"schemaOrg":"CreativeWork","resourceTypeGeneral":"Preprint","citeproc":"article","bibtex":"misc","ris":"GEN","resourceType":"Article"},"relatedIdentifiers":[],"relatedItems":[],"sizes":[],"formats":[],"version":"1","rightsList":[{"rightsUri":"http://arxiv.org/licenses/nonexclusive-distrib/1.0/","rights":"arXiv.org perpetual, non-exclusive license"}],"descriptions":[{"descriptionType":"Abstract","description":"In this paper we introduce a Martindale-like ring of quotients for any ring called sub-Martindale ring of quotients. When the base ring is semiprime, its maximal sub-Martindale ring of quotients is just the well-known Martindale ring of quotients. In a similar fashion we introduce some rings of quotients for any ring similar to Martindale symmetric ring of quotients."}],"geoLocations":[],"fundingReferences":[],"url":"https://arxiv.org/abs/2608.03652","contentUrl":null,"metadataVersion":0,"schemaVersion":"http://datacite.org/schema/kernel-4","source":"mds","isActive":true,"state":"findable","reason":null,"viewCount":0,"downloadCount":0,"referenceCount":0,"citationCount":0,"partCount":0,"partOfCount":0,"versionCount":0,"versionOfCount":0,"created":"2026-08-05T02:17:51Z","registered":null,"published":null,"updated":"2026-08-05T02:17:52Z"},"relationships":{"client":{"data":{"id":"arxiv.content","type":"clients"}}}},{"id":"10.48550/arxiv.2608.03651","type":"dois","attributes":{"doi":"10.48550/arxiv.2608.03651","identifiers":[{"identifier":"2608.03651","identifierType":"arXiv"}],"creators":[{"nameType":"Personal","givenName":"Jungin","familyName":"Lee","name":"Lee, Jungin","affiliation":[],"nameIdentifiers":[]}],"titles":[{"title":"An upper bound for counting algebraic tori over $\\mathbb{Q}$ by Artin conductor"}],"publisher":"arXiv","container":{},"publicationYear":2026,"subjects":[{"subject":"Number Theory (math.NT)","lang":"en","subjectScheme":"arXiv"},{"subject":"FOS: Mathematics","subjectScheme":"Fields of Science and Technology (FOS)"}],"contributors":[],"dates":[{"date":"2026-08-04T13:33:38Z","dateType":"Submitted","dateInformation":"v1"},{"date":"2026-08-05T00:54:52Z","dateType":"Updated","dateInformation":"v1"},{"date":"2026-08","dateType":"Available","dateInformation":"v1"}],"language":null,"types":{"schemaOrg":"CreativeWork","resourceTypeGeneral":"Preprint","citeproc":"article","bibtex":"misc","ris":"GEN","resourceType":"Article"},"relatedIdentifiers":[],"relatedItems":[],"sizes":[],"formats":[],"version":"1","rightsList":[{"rightsUri":"http://arxiv.org/licenses/nonexclusive-distrib/1.0/","rights":"arXiv.org perpetual, non-exclusive license"}],"descriptions":[{"descriptionType":"Abstract","description":"Let $N_n^{\\mathrm{tor}}(X)$ be the number of isomorphism classes of $n$-dimensional algebraic tori over $\\mathbb{Q}$ whose Artin conductor is bounded by $X$. We prove that there is an absolute constant $C\u0026gt;0$ such that, for every positive integer $n \\ge 2$, $N_n^{\\mathrm{tor}}(X)\\ll_n X^{\\exp(C(\\log n)^2)}$. The proofs of the main results were developed through an iterative dialogue with ChatGPT 5.6 Pro."},{"descriptionType":"Other","description":"13 pages"}],"geoLocations":[],"fundingReferences":[],"url":"https://arxiv.org/abs/2608.03651","contentUrl":null,"metadataVersion":0,"schemaVersion":"http://datacite.org/schema/kernel-4","source":"mds","isActive":true,"state":"findable","reason":null,"viewCount":0,"downloadCount":0,"referenceCount":0,"citationCount":0,"partCount":0,"partOfCount":0,"versionCount":0,"versionOfCount":0,"created":"2026-08-05T02:17:50Z","registered":"2026-08-05T02:17:51Z","published":null,"updated":"2026-08-05T02:17:51Z"},"relationships":{"client":{"data":{"id":"arxiv.content","type":"clients"}}}},{"id":"10.48550/arxiv.2608.03650","type":"dois","attributes":{"doi":"10.48550/arxiv.2608.03650","identifiers":[{"identifier":"2608.03650","identifierType":"arXiv"}],"creators":[{"nameType":"Personal","givenName":"Ye","familyName":"Ni","name":"Ni, Ye","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Ruiyu","familyName":"Liang","name":"Liang, Ruiyu","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Qingyun","familyName":"Wang","name":"Wang, Qingyun","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Kai","familyName":"Xie","name":"Xie, Kai","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Cairong","familyName":"Zou","name":"Zou, Cairong","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Björn W.","familyName":"Schuller","name":"Schuller, Björn W.","affiliation":[],"nameIdentifiers":[]}],"titles":[{"title":"Echo-Aware Modulation for Compact-Latent Frequency-Time Modeling in Lightweight Acoustic Echo Cancellation"}],"publisher":"arXiv","container":{},"publicationYear":2026,"subjects":[{"subject":"Audio and Speech Processing (eess.AS)","lang":"en","subjectScheme":"arXiv"},{"subject":"FOS: Electrical engineering, electronic engineering, information engineering","subjectScheme":"Fields of Science and Technology (FOS)"}],"contributors":[],"dates":[{"date":"2026-08-04T13:33:22Z","dateType":"Submitted","dateInformation":"v1"},{"date":"2026-08-05T00:54:52Z","dateType":"Updated","dateInformation":"v1"},{"date":"2026-08","dateType":"Available","dateInformation":"v1"}],"language":null,"types":{"schemaOrg":"CreativeWork","resourceTypeGeneral":"Preprint","citeproc":"article","bibtex":"misc","ris":"GEN","resourceType":"Article"},"relatedIdentifiers":[],"relatedItems":[],"sizes":[],"formats":[],"version":"1","rightsList":[{"rightsUri":"http://arxiv.org/licenses/nonexclusive-distrib/1.0/","rights":"arXiv.org perpetual, non-exclusive license"}],"descriptions":[{"descriptionType":"Abstract","description":"Existing lightweight acoustic echo cancellation (AEC) systems often combine linear AEC with Bark-domain DNN-based suppression to lower the computational footprint. In such systems, downsampling layers further compress the input features into a compact bottleneck representation, but this compression weakens frequency-time modeling capacity and degrades performance. To mitigate this limitation, we propose MSA-EchoLite, a lightweight Bark-domain AEC framework with an asymmetric dual-branch encoder and an echo-aware frequency-time modulation (EAM) module. The EAM module enriches the compressed bottleneck representation by modeling discrepancy and correlation cues between the dual-branch microphone and echo-related latent features. Experimental results show that the Bark-domain variant of MSA-EchoLite offers a better performance-complexity trade-off than its frequency-domain counterpart but is more sensitive to feature compression. With only 26.1% additional FLOPs over its non-EAM Bark-domain variant, its EAM-enhanced version achieves 99.1% of the PESQ of the frequency-domain counterpart, which requires nearly twice the FLOPs, and even surpasses it in SDR. Overall, MSA-EchoLite outperforms state-of-the-art lightweight AEC models while using only 0.2 M parameters and 100 M FLOPs/s."}],"geoLocations":[],"fundingReferences":[],"url":"https://arxiv.org/abs/2608.03650","contentUrl":null,"metadataVersion":0,"schemaVersion":"http://datacite.org/schema/kernel-4","source":"mds","isActive":true,"state":"findable","reason":null,"viewCount":0,"downloadCount":0,"referenceCount":0,"citationCount":0,"partCount":0,"partOfCount":0,"versionCount":0,"versionOfCount":0,"created":"2026-08-05T02:17:49Z","registered":"2026-08-05T02:17:49Z","published":null,"updated":"2026-08-05T02:17:49Z"},"relationships":{"client":{"data":{"id":"arxiv.content","type":"clients"}}}},{"id":"10.48550/arxiv.2608.03649","type":"dois","attributes":{"doi":"10.48550/arxiv.2608.03649","identifiers":[{"identifier":"2608.03649","identifierType":"arXiv"}],"creators":[{"nameType":"Personal","givenName":"Hao","familyName":"Dou","name":"Dou, Hao","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Ruiwen","familyName":"Tian","name":"Tian, Ruiwen","affiliation":[],"nameIdentifiers":[]}],"titles":[{"title":"When Do Fewer Visual Tokens Accelerate Multimodal Inference? A Break-Even Study Across Decision Locations and Hardware"}],"publisher":"arXiv","container":{},"publicationYear":2026,"subjects":[{"subject":"Computer Vision and Pattern Recognition (cs.CV)","lang":"en","subjectScheme":"arXiv"},{"subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"}],"contributors":[],"dates":[{"date":"2026-08-04T13:33:11Z","dateType":"Submitted","dateInformation":"v1"},{"date":"2026-08-05T00:54:51Z","dateType":"Updated","dateInformation":"v1"},{"date":"2026-08","dateType":"Available","dateInformation":"v1"}],"language":null,"types":{"schemaOrg":"CreativeWork","resourceTypeGeneral":"Preprint","citeproc":"article","bibtex":"misc","ris":"GEN","resourceType":"Article"},"relatedIdentifiers":[],"relatedItems":[],"sizes":[],"formats":[],"version":"1","rightsList":[{"rightsIdentifierScheme":"SPDX","rightsUri":"https://creativecommons.org/licenses/by/4.0/legalcode","schemeUri":"https://spdx.org/licenses/","rights":"Creative Commons Attribution 4.0 International","rightsIdentifier":"cc-by-4.0"}],"descriptions":[{"descriptionType":"Abstract","description":"Fewer visual tokens do not guarantee lower end-to-end latency. We evaluate break-even with a reproducible protocol that accounts for decision overhead, shared work, and the operators each policy can avoid. A stage-level decomposition reconciles these components with measured end-to-end latency. In a 30-example pilot, the two tested autoregressive probes remain slower than Full despite state reuse. A lightweight post-vision predictor yields paired confidence intervals below zero on RTX 3090 and A100 and remains significant after a conservative all-pairs Holm correction. A pre-vision image-size rule also yields intervals below zero on both GPUs, although neither comparison remains significant after the same correction. Pre-vision routing has a structural opportunity unavailable to post-vision pruning: it can avoid preprocessing and vision encoding. On A100, this opportunity outweighs a nearly eightfold larger downstream token reduction by the post-vision policy. Reported quality is conditional on examples answered correctly by Full and is not benchmark accuracy."},{"descriptionType":"Other","description":"16 pages, 3 figures, 13 tables. Experiments use Qwen2.5-VL-3B-Instruct on RTX 3090 and A100 PCIe GPUs"}],"geoLocations":[],"fundingReferences":[],"url":"https://arxiv.org/abs/2608.03649","contentUrl":null,"metadataVersion":0,"schemaVersion":"http://datacite.org/schema/kernel-4","source":"mds","isActive":true,"state":"findable","reason":null,"viewCount":0,"downloadCount":0,"referenceCount":0,"citationCount":0,"partCount":0,"partOfCount":0,"versionCount":0,"versionOfCount":0,"created":"2026-08-05T02:17:47Z","registered":"2026-08-05T02:17:48Z","published":null,"updated":"2026-08-05T02:17:48Z"},"relationships":{"client":{"data":{"id":"arxiv.content","type":"clients"}}}},{"id":"10.48550/arxiv.2608.03648","type":"dois","attributes":{"doi":"10.48550/arxiv.2608.03648","identifiers":[{"identifier":"2608.03648","identifierType":"arXiv"}],"creators":[{"nameType":"Personal","givenName":"Hao","familyName":"Wu","name":"Wu, Hao","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Shoucheng","familyName":"Song","name":"Song, Shoucheng","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Chang","familyName":"Yao","name":"Yao, Chang","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Haoyu","familyName":"Wang","name":"Wang, Haoyu","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Huaiyu","familyName":"Wan","name":"Wan, Huaiyu","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Youfang","familyName":"Lin","name":"Lin, Youfang","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Kai","familyName":"Lv","name":"Lv, Kai","affiliation":[],"nameIdentifiers":[]}],"titles":[{"title":"Group Perspective Matters: Regulating Debate Relationships Can Mitigate Blind Conformity in Multi-Agent Debate"}],"publisher":"arXiv","container":{},"publicationYear":2026,"subjects":[{"subject":"Multiagent Systems (cs.MA)","lang":"en","subjectScheme":"arXiv"},{"subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"}],"contributors":[],"dates":[{"date":"2026-08-04T13:31:24Z","dateType":"Submitted","dateInformation":"v1"},{"date":"2026-08-05T00:54:48Z","dateType":"Updated","dateInformation":"v1"},{"date":"2026-08","dateType":"Available","dateInformation":"v1"}],"language":null,"types":{"schemaOrg":"CreativeWork","resourceTypeGeneral":"Preprint","citeproc":"article","bibtex":"misc","ris":"GEN","resourceType":"Article"},"relatedIdentifiers":[],"relatedItems":[],"sizes":[],"formats":[],"version":"1","rightsList":[{"rightsUri":"http://arxiv.org/licenses/nonexclusive-distrib/1.0/","rights":"arXiv.org perpetual, non-exclusive license"}],"descriptions":[{"descriptionType":"Abstract","description":"Multi-Agent Debate (MAD) improves the reasoning performance of Large Language Models (LLMs) through multi-round interaction. However, LLMs in MAD are highly susceptible to blind conformity. Existing individual evaluation methods, typically based on confidence or perplexity, fail to reflect the correctness of reasoning and may even exacerbate blind conformity. To address this, we shift the perspective from individual evaluation to group interaction. We define mutual referencing among LLMs as \\textbf{Debate Relationships} and recognize that regulating these relationships is the key to mitigating blind conformity. In this paper, we propose a novel framework for \\textbf{D}ynamically r\\textbf{E}gulating deb\\textbf{A}te \\textbf{R}elationships (DEAR) from the group perspective. At first, DEAR quantifies consensus and divergence as \\textit{group evidence} to capture the debate state. Then, DEAR operates through three stages: 1) What: perceiving group consultation tendency and uncertainty; 2) Who: introducing a Selection RL-Agent to dynamically select reference peers; and 3) How: adopting a Behavior RL-Agent to adaptively adjust generation behaviors. Notably, we formulate the execution of the two RL-Agents as a sequential decision-making process, jointly optimizing via multi-agent reinforcement learning. Extensive experiments demonstrate that DEAR achieves superior performance while significantly reducing token consumption."}],"geoLocations":[],"fundingReferences":[],"url":"https://arxiv.org/abs/2608.03648","contentUrl":null,"metadataVersion":0,"schemaVersion":"http://datacite.org/schema/kernel-4","source":"mds","isActive":true,"state":"findable","reason":null,"viewCount":0,"downloadCount":0,"referenceCount":0,"citationCount":0,"partCount":0,"partOfCount":0,"versionCount":0,"versionOfCount":0,"created":"2026-08-05T02:17:46Z","registered":"2026-08-05T02:17:47Z","published":null,"updated":"2026-08-05T02:17:47Z"},"relationships":{"client":{"data":{"id":"arxiv.content","type":"clients"}}}},{"id":"10.48550/arxiv.2608.03647","type":"dois","attributes":{"doi":"10.48550/arxiv.2608.03647","identifiers":[{"identifier":"2608.03647","identifierType":"arXiv"}],"creators":[{"nameType":"Personal","givenName":"Qianqian","familyName":"Wang","name":"Wang, Qianqian","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Wenwu","familyName":"Gong","name":"Gong, Wenwu","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Yunshan","familyName":"Li","name":"Li, Yunshan","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Zhenqing","familyName":"Wu","name":"Wu, Zhenqing","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Ruili","familyName":"Wang","name":"Wang, Ruili","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Lili","familyName":"Yang","name":"Yang, Lili","affiliation":[],"nameIdentifiers":[]}],"titles":[{"title":"Conditionally Identifiable Latent-Environment Modeling for Out-of-Distribution Recommendation"}],"publisher":"arXiv","container":{},"publicationYear":2026,"subjects":[{"subject":"Information Retrieval (cs.IR)","lang":"en","subjectScheme":"arXiv"},{"subject":"Machine Learning (cs.LG)","lang":"en","subjectScheme":"arXiv"},{"subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"}],"contributors":[],"dates":[{"date":"2026-08-04T13:30:51Z","dateType":"Submitted","dateInformation":"v1"},{"date":"2026-08-05T00:54:44Z","dateType":"Updated","dateInformation":"v1"},{"date":"2026-08","dateType":"Available","dateInformation":"v1"}],"language":null,"types":{"schemaOrg":"CreativeWork","resourceTypeGeneral":"Preprint","citeproc":"article","bibtex":"misc","ris":"GEN","resourceType":"Article"},"relatedIdentifiers":[],"relatedItems":[],"sizes":[],"formats":[],"version":"1","rightsList":[{"rightsUri":"http://arxiv.org/licenses/nonexclusive-distrib/1.0/","rights":"arXiv.org perpetual, non-exclusive license"}],"descriptions":[{"descriptionType":"Abstract","description":"Out-of-distribution (OOD) recommendation is vulnerable to preference shifts induced by a latent environment. Existing methods can infer latent states from logged interactions, yet the statistical meaning of the latent environment and its effect on preference remain underdetermined. We formulate this task as conditionally identifiable risk-aware recommendation (CI-RR) and propose Conditionally Identifiable Latent-Environment Recommendation (CILER). CILER uses a user-conditioned exponential family to model the latent environment and a feature-indexed polynomial to specify how it changes preference. It predicts by marginalizing item probabilities over the inferred environment distribution. Under sufficient variation, correct specification, and decoder regularity, CILER identifies the environment-sensitive representation up to the stated equivalence class. We further bound excess deployment log-risk by environment-inference error. Controlled studies test the observable consequences of sufficient variation and model specification. Experiments on three datasets show that CILER improves all twelve OOD ranking metrics under feature, temporal, and geographical shifts within shared support."},{"descriptionType":"Other","description":"20 pages, 9 figures, 9 tables"}],"geoLocations":[],"fundingReferences":[],"url":"https://arxiv.org/abs/2608.03647","contentUrl":null,"metadataVersion":0,"schemaVersion":"http://datacite.org/schema/kernel-4","source":"mds","isActive":true,"state":"findable","reason":null,"viewCount":0,"downloadCount":0,"referenceCount":0,"citationCount":0,"partCount":0,"partOfCount":0,"versionCount":0,"versionOfCount":0,"created":"2026-08-05T02:17:45Z","registered":"2026-08-05T02:17:45Z","published":null,"updated":"2026-08-05T02:17:45Z"},"relationships":{"client":{"data":{"id":"arxiv.content","type":"clients"}}}},{"id":"10.48550/arxiv.2608.03646","type":"dois","attributes":{"doi":"10.48550/arxiv.2608.03646","identifiers":[{"identifier":"2608.03646","identifierType":"arXiv"}],"creators":[{"nameType":"Personal","givenName":"Iris","familyName":"Bree","name":"Bree, Iris","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Federico","familyName":"Gasparotto","name":"Gasparotto, Federico","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Sebastian","familyName":"Pögel","name":"Pögel, Sebastian","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Xing","familyName":"Wang","name":"Wang, Xing","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Stefan","familyName":"Weinzierl","name":"Weinzierl, Stefan","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Xiaofeng","familyName":"Xu","name":"Xu, Xiaofeng","affiliation":[],"nameIdentifiers":[]}],"titles":[{"title":"Intersection matrices associated to geometric-ordered bases of Feynman integrals"}],"publisher":"arXiv","container":{},"publicationYear":2026,"subjects":[{"subject":"High Energy Physics - Theory (hep-th)","lang":"en","subjectScheme":"arXiv"},{"subject":"High Energy Physics - Phenomenology (hep-ph)","lang":"en","subjectScheme":"arXiv"},{"subject":"Mathematical Physics (math-ph)","lang":"en","subjectScheme":"arXiv"},{"subject":"FOS: Physical sciences","subjectScheme":"Fields of Science and Technology (FOS)"}],"contributors":[],"dates":[{"date":"2026-08-04T13:30:09Z","dateType":"Submitted","dateInformation":"v1"},{"date":"2026-08-05T00:54:38Z","dateType":"Updated","dateInformation":"v1"},{"date":"2026-08","dateType":"Available","dateInformation":"v1"}],"language":null,"types":{"schemaOrg":"CreativeWork","resourceTypeGeneral":"Preprint","citeproc":"article","bibtex":"misc","ris":"GEN","resourceType":"Article"},"relatedIdentifiers":[],"relatedItems":[],"sizes":[],"formats":[],"version":"1","rightsList":[{"rightsUri":"http://arxiv.org/licenses/nonexclusive-distrib/1.0/","rights":"arXiv.org perpetual, non-exclusive license"}],"descriptions":[{"descriptionType":"Abstract","description":"In integration-by-parts reduction of Feynman integrals, the order relation in the Laporta algorithm determines a set of master integrals. In this paper we investigate the intersection matrices of the integrands of the master integrals that are obtained from a geometric order relation. With an appropriate definition of integrands and their duals, we find that the intersection matrices are simpler than expected: For a filtration-compatible basis, the entries of the intersection matrix are Laurent polynomials in the dimensional regularisation parameter $\\varepsilon$. For an $\\varepsilon$-factorised basis, the entries are instead integers, up to an overall power of $\\varepsilon$, if the boundary values for the auxiliary functions of the rotation are chosen appropriately. This has practical consequences: We can systematically eliminate certain auxiliary transcendental functions, introduced in going from a filtration-compatible basis to an $\\varepsilon$-factorised basis. We provide an algorithm that performs this elimination while minimising the number of required calculations."},{"descriptionType":"Other","description":"36 pages"}],"geoLocations":[],"fundingReferences":[],"url":"https://arxiv.org/abs/2608.03646","contentUrl":null,"metadataVersion":0,"schemaVersion":"http://datacite.org/schema/kernel-4","source":"mds","isActive":true,"state":"findable","reason":null,"viewCount":0,"downloadCount":0,"referenceCount":0,"citationCount":0,"partCount":0,"partOfCount":0,"versionCount":0,"versionOfCount":0,"created":"2026-08-05T02:17:43Z","registered":"2026-08-05T02:17:44Z","published":null,"updated":"2026-08-05T02:17:44Z"},"relationships":{"client":{"data":{"id":"arxiv.content","type":"clients"}}}},{"id":"10.48550/arxiv.2608.03645","type":"dois","attributes":{"doi":"10.48550/arxiv.2608.03645","identifiers":[{"identifier":"2608.03645","identifierType":"arXiv"}],"creators":[{"nameType":"Personal","givenName":"Angus","familyName":"Mingare","name":"Mingare, Angus","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Isabelle","familyName":"Heuzé","name":"Heuzé, Isabelle","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Peter V.","familyName":"Coveney","name":"Coveney, Peter V.","affiliation":[],"nameIdentifiers":[]}],"titles":[{"title":"TNASS: Tensor Network Active Space Selection with the Entanglement Feature"}],"publisher":"arXiv","container":{},"publicationYear":2026,"subjects":[{"subject":"Chemical Physics (physics.chem-ph)","lang":"en","subjectScheme":"arXiv"},{"subject":"Quantum Physics (quant-ph)","lang":"en","subjectScheme":"arXiv"},{"subject":"FOS: Physical sciences","subjectScheme":"Fields of Science and Technology (FOS)"}],"contributors":[],"dates":[{"date":"2026-08-04T13:29:32Z","dateType":"Submitted","dateInformation":"v1"},{"date":"2026-08-05T00:54:34Z","dateType":"Updated","dateInformation":"v1"},{"date":"2026-08","dateType":"Available","dateInformation":"v1"}],"language":null,"types":{"schemaOrg":"CreativeWork","resourceTypeGeneral":"Preprint","citeproc":"article","bibtex":"misc","ris":"GEN","resourceType":"Article"},"relatedIdentifiers":[],"relatedItems":[],"sizes":[],"formats":[],"version":"1","rightsList":[{"rightsIdentifierScheme":"SPDX","rightsUri":"https://creativecommons.org/licenses/by/4.0/legalcode","schemeUri":"https://spdx.org/licenses/","rights":"Creative Commons Attribution 4.0 International","rightsIdentifier":"cc-by-4.0"}],"descriptions":[{"descriptionType":"Abstract","description":"The quality of multi-scale modelling techniques in molecular electronic structure calculations, such as embedding and subspace methods, relies upon the chosen active space. The automation of active space selection is vital for ensuring the accuracy, reproducibility, and scalability in such calculations. In this work, we introduce Tensor Network Active Space Selection using the Entanglement Feature. Through the isolation of strongly correlated electrons, this method provides a scalable foundation for embedding methods in multi-scale modelling. By representing the purities of all possible orbital partitions as a Matrix Product State, our method isolates regions of strong electron correlation without requiring manual preselection of target atoms or the calculation of expensive high-order density matrices. The results demonstrate that this approach leads to lower ground state energies and more accurate dipole moments than other fully automated selection schemes such as those based solely on single-orbital entropy or the selection of spatial orbitals around the HOMO/LUMO gap."}],"geoLocations":[],"fundingReferences":[],"url":"https://arxiv.org/abs/2608.03645","contentUrl":null,"metadataVersion":0,"schemaVersion":"http://datacite.org/schema/kernel-4","source":"mds","isActive":true,"state":"findable","reason":null,"viewCount":0,"downloadCount":0,"referenceCount":0,"citationCount":0,"partCount":0,"partOfCount":0,"versionCount":0,"versionOfCount":0,"created":"2026-08-05T02:17:42Z","registered":null,"published":null,"updated":"2026-08-05T02:17:42Z"},"relationships":{"client":{"data":{"id":"arxiv.content","type":"clients"}}}},{"id":"10.48550/arxiv.2608.03644","type":"dois","attributes":{"doi":"10.48550/arxiv.2608.03644","identifiers":[{"identifier":"2608.03644","identifierType":"arXiv"}],"creators":[{"nameType":"Personal","givenName":"Maksymilian","familyName":"Wolski","name":"Wolski, Maksymilian","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Nicholas","familyName":"Hoernle","name":"Hoernle, Nicholas","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Johannes","familyName":"Forkel","name":"Forkel, Johannes","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Jakob","familyName":"Foerster","name":"Foerster, Jakob","affiliation":[],"nameIdentifiers":[]}],"titles":[{"title":"Is Inter-Seed Cross-Play Enough? Evaluating the Robustness of Zero-Shot Coordination Algorithms to Implementation Details"}],"publisher":"arXiv","container":{},"publicationYear":2026,"subjects":[{"subject":"Artificial Intelligence (cs.AI)","lang":"en","subjectScheme":"arXiv"},{"subject":"Multiagent Systems (cs.MA)","lang":"en","subjectScheme":"arXiv"},{"subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"}],"contributors":[],"dates":[{"date":"2026-08-04T13:29:00Z","dateType":"Submitted","dateInformation":"v1"},{"date":"2026-08-05T00:54:31Z","dateType":"Updated","dateInformation":"v1"},{"date":"2026-08","dateType":"Available","dateInformation":"v1"}],"language":null,"types":{"schemaOrg":"CreativeWork","resourceTypeGeneral":"Preprint","citeproc":"article","bibtex":"misc","ris":"GEN","resourceType":"Article"},"relatedIdentifiers":[],"relatedItems":[],"sizes":[],"formats":[],"version":"1","rightsList":[{"rightsIdentifierScheme":"SPDX","rightsUri":"https://creativecommons.org/licenses/by/4.0/legalcode","schemeUri":"https://spdx.org/licenses/","rights":"Creative Commons Attribution 4.0 International","rightsIdentifier":"cc-by-4.0"}],"descriptions":[{"descriptionType":"Abstract","description":"AI agents deployed in real-world settings must be capable of coordinating with humans and other AI agents they have not encountered before. Zero-shot coordination (ZSC) algorithms aim to achieve this by specifying high-level learning rules such that independently engineered agents can coordinate with each other at test time. Rigorous evaluation of ZSC algorithms remains difficult: ideally, multiple independent implementations of each proposed algorithm must be used, reflecting the variation that arises when independent parties interpret and implement the same specification. In practice, however, ZSC algorithms have almost exclusively been evaluated using a single implementation trained across different random seeds, with only a handful of works additionally varying the neural network architecture. This leaves open questions about robustness to specification ambiguities and implementation details. In this work, we provide the first systematic evaluation of this robustness. We introduce a new evaluation scheme, cross-implementation cross-play, varying implementation details that prior work has shown to affect the performance of multi-agent reinforcement learning (MARL) algorithms, and we evaluate Other-Play, a popular ZSC algorithm, with this scheme. Our findings are encouraging and suggest that, for Other-Play, the standard ZSC evaluation is, in fact, a reasonable proxy for this more thorough cross-implementation evaluation."}],"geoLocations":[],"fundingReferences":[],"url":"https://arxiv.org/abs/2608.03644","contentUrl":null,"metadataVersion":0,"schemaVersion":"http://datacite.org/schema/kernel-4","source":"mds","isActive":true,"state":"findable","reason":null,"viewCount":0,"downloadCount":0,"referenceCount":0,"citationCount":0,"partCount":0,"partOfCount":0,"versionCount":0,"versionOfCount":0,"created":"2026-08-05T02:17:40Z","registered":"2026-08-05T02:17:41Z","published":null,"updated":"2026-08-05T02:17:41Z"},"relationships":{"client":{"data":{"id":"arxiv.content","type":"clients"}}}},{"id":"10.48550/arxiv.2608.03643","type":"dois","attributes":{"doi":"10.48550/arxiv.2608.03643","identifiers":[{"identifier":"2608.03643","identifierType":"arXiv"}],"creators":[{"nameType":"Personal","givenName":"Adam D. W.","familyName":"Clay","name":"Clay, Adam D. W.","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Tibor","familyName":"Jordán","name":"Jordán, Tibor","affiliation":[],"nameIdentifiers":[]}],"titles":[{"title":"Removable trees and matchings in $k$-connected and $k$-edge-connected graphs"}],"publisher":"arXiv","container":{},"publicationYear":2026,"subjects":[{"subject":"Combinatorics (math.CO)","lang":"en","subjectScheme":"arXiv"},{"subject":"FOS: Mathematics","subjectScheme":"Fields of Science and Technology (FOS)"},{"subject":"05C40","lang":"en","subjectScheme":"MSC"}],"contributors":[],"dates":[{"date":"2026-08-04T13:28:12Z","dateType":"Submitted","dateInformation":"v1"},{"date":"2026-08-05T00:54:22Z","dateType":"Updated","dateInformation":"v1"},{"date":"2026-08","dateType":"Available","dateInformation":"v1"}],"language":null,"types":{"schemaOrg":"CreativeWork","resourceTypeGeneral":"Preprint","citeproc":"article","bibtex":"misc","ris":"GEN","resourceType":"Article"},"relatedIdentifiers":[],"relatedItems":[],"sizes":[],"formats":[],"version":"1","rightsList":[{"rightsIdentifierScheme":"SPDX","rightsUri":"https://creativecommons.org/licenses/by/4.0/legalcode","schemeUri":"https://spdx.org/licenses/","rights":"Creative Commons Attribution 4.0 International","rightsIdentifier":"cc-by-4.0"}],"descriptions":[{"descriptionType":"Abstract","description":"T. Hasunuma (J. Graph Theory, 2023) conjectured that if $G$ is a $k$-connected (resp. $k$-edge-connected) graph with minimum degree $δ(G) \\ge k + m - 1$, and $T$ is a tree of order $m$, then $G$ contains a removable copy of $T$, that is, a subtree $T'$ isomorphic to $T$ such that $G - E(T')$ is $k$-connected (resp. $k$-edge-connected). We prove (a strengthening of) this conjecture. We also consider removable matchings in graphs with high minimum degree. We show, among others, that if $G$ is a $k$-edge-connected graph on at least $2m$ vertices with minimum degree $δ(G) \\ge k + m$, then there exists a matching $M$ of size $m$ in $G$ for which $G-M$ is $k$-edge-connected."}],"geoLocations":[],"fundingReferences":[],"url":"https://arxiv.org/abs/2608.03643","contentUrl":null,"metadataVersion":0,"schemaVersion":"http://datacite.org/schema/kernel-4","source":"mds","isActive":true,"state":"findable","reason":null,"viewCount":0,"downloadCount":0,"referenceCount":0,"citationCount":0,"partCount":0,"partOfCount":0,"versionCount":0,"versionOfCount":0,"created":"2026-08-05T02:17:39Z","registered":"2026-08-05T02:17:40Z","published":null,"updated":"2026-08-05T02:17:40Z"},"relationships":{"client":{"data":{"id":"arxiv.content","type":"clients"}}}},{"id":"10.48550/arxiv.2608.03641","type":"dois","attributes":{"doi":"10.48550/arxiv.2608.03641","identifiers":[{"identifier":"2608.03641","identifierType":"arXiv"}],"creators":[{"nameType":"Personal","givenName":"Diego","familyName":"Cifelli","name":"Cifelli, Diego","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Adolfo","familyName":"Anta","name":"Anta, Adolfo","affiliation":[],"nameIdentifiers":[]}],"titles":[{"title":"Partitioned Mixed Small Gain-Phase Decentralized Stability Criterion for Power Systems"}],"publisher":"arXiv","container":{},"publicationYear":2026,"subjects":[{"subject":"Systems and Control (eess.SY)","lang":"en","subjectScheme":"arXiv"},{"subject":"FOS: Electrical engineering, electronic engineering, information engineering","subjectScheme":"Fields of Science and Technology (FOS)"}],"contributors":[],"dates":[{"date":"2026-08-04T13:26:12Z","dateType":"Submitted","dateInformation":"v1"},{"date":"2026-08-05T00:54:12Z","dateType":"Updated","dateInformation":"v1"},{"date":"2026-08","dateType":"Available","dateInformation":"v1"}],"language":null,"types":{"schemaOrg":"CreativeWork","resourceTypeGeneral":"Preprint","citeproc":"article","bibtex":"misc","ris":"GEN","resourceType":"Article"},"relatedIdentifiers":[],"relatedItems":[],"sizes":[],"formats":[],"version":"1","rightsList":[{"rightsIdentifierScheme":"SPDX","rightsUri":"https://creativecommons.org/licenses/by/4.0/legalcode","schemeUri":"https://spdx.org/licenses/","rights":"Creative Commons Attribution 4.0 International","rightsIdentifier":"cc-by-4.0"}],"descriptions":[{"descriptionType":"Abstract","description":"The increasing penetration of converter-interfaced resources is making power-system stability assessment more challenging, particularly in heterogeneous grids containing both grid-forming and grid-following converters. Existing decentralized mixed small-gain and small-phase criteria provide scalable stability certificates, but they require all converters to satisfy the same type of condition at a given frequency. As a result, they cannot simultaneously exploit the low gain of grid-following converters and the favorable phase properties of grid-forming converters, leading to unnecessary conservatism. This paper proposes a partitioned mixed gain-phase decentralized stability criterion that allows distinct subsets of converters to satisfy different local requirements at the same frequency. Specifically, one subset can be certified through small-gain bounds, while the complementary subset is certified through small-phase bounds. The admissible trade-off between gain and phase margins is determined by a network-dependent quadratic constraint, yielding a technology-aware stability certificate that remains local at the converter level. The paper characterizes the admissible set of gain and phase bounds, establishes useful convexity and boundedness properties, and develops a practical procedure for selecting these bounds. The proposed method is demonstrated on heterogeneous systems containing grid-forming and grid-following converters, including a two-converter system and the IEEE 39-bus system, outperforming the standard decentralized small-gain and small-phase conditions."}],"geoLocations":[],"fundingReferences":[],"url":"https://arxiv.org/abs/2608.03641","contentUrl":null,"metadataVersion":0,"schemaVersion":"http://datacite.org/schema/kernel-4","source":"mds","isActive":true,"state":"findable","reason":null,"viewCount":0,"downloadCount":0,"referenceCount":0,"citationCount":0,"partCount":0,"partOfCount":0,"versionCount":0,"versionOfCount":0,"created":"2026-08-05T02:17:37Z","registered":"2026-08-05T02:17:37Z","published":null,"updated":"2026-08-05T02:17:37Z"},"relationships":{"client":{"data":{"id":"arxiv.content","type":"clients"}}}},{"id":"10.48550/arxiv.2608.03640","type":"dois","attributes":{"doi":"10.48550/arxiv.2608.03640","identifiers":[{"identifier":"2608.03640","identifierType":"arXiv"}],"creators":[{"nameType":"Personal","givenName":"Michael R. A.","familyName":"Abdelmalik","name":"Abdelmalik, Michael R. A.","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Irene M.","familyName":"Gamba","name":"Gamba, Irene M.","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Torsten","familyName":"Kessler","name":"Kessler, Torsten","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Sergej","familyName":"Rjasanow","name":"Rjasanow, Sergej","affiliation":[],"nameIdentifiers":[]}],"titles":[{"title":"Analysis of Moment Closures Using $φ$-Divergences for Rarefied Dynamics with Binary Collisions and Their Galerkin Discretizations"}],"publisher":"arXiv","container":{},"publicationYear":2026,"subjects":[{"subject":"Numerical Analysis (math.NA)","lang":"en","subjectScheme":"arXiv"},{"subject":"Analysis of PDEs (math.AP)","lang":"en","subjectScheme":"arXiv"},{"subject":"Computational Physics (physics.comp-ph)","lang":"en","subjectScheme":"arXiv"},{"subject":"Fluid Dynamics (physics.flu-dyn)","lang":"en","subjectScheme":"arXiv"},{"subject":"FOS: Mathematics","subjectScheme":"Fields of Science and Technology (FOS)"},{"subject":"FOS: Physical sciences","subjectScheme":"Fields of Science and Technology (FOS)"},{"subject":"82C40, 76P05, 65M60, 65M12, 35L65","lang":"en","subjectScheme":"MSC"}],"contributors":[],"dates":[{"date":"2026-08-04T13:23:53Z","dateType":"Submitted","dateInformation":"v1"},{"date":"2026-08-05T00:53:48Z","dateType":"Updated","dateInformation":"v1"},{"date":"2026-08","dateType":"Available","dateInformation":"v1"}],"language":null,"types":{"schemaOrg":"CreativeWork","resourceTypeGeneral":"Preprint","citeproc":"article","bibtex":"misc","ris":"GEN","resourceType":"Article"},"relatedIdentifiers":[],"relatedItems":[],"sizes":[],"formats":[],"version":"1","rightsList":[{"rightsUri":"http://arxiv.org/licenses/nonexclusive-distrib/1.0/","rights":"arXiv.org perpetual, non-exclusive license"}],"descriptions":[{"descriptionType":"Abstract","description":"This work introduces a robust deterministic framework for approximating solutions of the Boltzmann equation with binary collisions by discretizing their dependence on time, position, and velocity using Galerkin methods. By employing a family of parametric Galerkin closures based on $φ$-divergences in velocity space, we derive rigorous hierarchies of moment equations that govern fluid dynamic variables. Addressing the limitation that these closures alone do not guarantee dissipation of a $φ$-divergence entropy for the true binary collision operator, we restore this property by formulating a compatible approximate collision operator tailored to each closure. This constructed operator intrinsically retains fundamental physical properties essential for high-fidelity flow simulations, including Galilean invariance, exact conservation of mass, momentum, and energy, and strict dissipation of a $φ$-divergence entropy. Furthermore, we show that the resulting closed moment systems are symmetric-dissipative, yielding Cauchy problems that are well-posed locally in time. To translate this mathematical foundation into an efficient computational tool, we discretize the position and time variables with an entropy-stable discontinuous Galerkin (DG) finite element method. The fully implicit, entropy-stable space-time approach enables time steps far beyond typical CFL-limited step sizes and the direct computation of steady states. The robustness and accuracy of the methodology are verified and validated through numerical simulations on the supersonic nozzle flow of argon, mass flow through a channel, and heat transfer between parallel walls, demonstrating agreement with analytical benchmarks, experimental measurements, and stochastic particle simulations."},{"descriptionType":"Other","description":"35 pages, 8 figures, 2 tables"}],"geoLocations":[],"fundingReferences":[],"url":"https://arxiv.org/abs/2608.03640","contentUrl":null,"metadataVersion":0,"schemaVersion":"http://datacite.org/schema/kernel-4","source":"mds","isActive":true,"state":"findable","reason":null,"viewCount":0,"downloadCount":0,"referenceCount":0,"citationCount":0,"partCount":0,"partOfCount":0,"versionCount":0,"versionOfCount":0,"created":"2026-08-05T02:17:35Z","registered":"2026-08-05T02:17:36Z","published":null,"updated":"2026-08-05T02:17:36Z"},"relationships":{"client":{"data":{"id":"arxiv.content","type":"clients"}}}},{"id":"10.48550/arxiv.2608.03639","type":"dois","attributes":{"doi":"10.48550/arxiv.2608.03639","identifiers":[{"identifier":"2608.03639","identifierType":"arXiv"}],"creators":[{"nameType":"Personal","givenName":"Jie","familyName":"Liu","name":"Liu, Jie","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Taihe","familyName":"Li","name":"Li, Taihe","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Ke","familyName":"Chen","name":"Chen, Ke","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Mingwei","familyName":"Zhuang","name":"Zhuang, Mingwei","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Qing Huo","familyName":"Liu","name":"Liu, Qing Huo","affiliation":[],"nameIdentifiers":[]}],"titles":[{"title":"A 3-D Hybrid Numerical Method for Simulating Electromagnetic Fields in Structures with Multiple Inhomogeneous Layered Media"}],"publisher":"arXiv","container":{},"publicationYear":2026,"subjects":[{"subject":"Computational Physics (physics.comp-ph)","lang":"en","subjectScheme":"arXiv"},{"subject":"Numerical Analysis (math.NA)","lang":"en","subjectScheme":"arXiv"},{"subject":"FOS: Physical sciences","subjectScheme":"Fields of Science and Technology (FOS)"},{"subject":"FOS: Mathematics","subjectScheme":"Fields of Science and Technology (FOS)"}],"contributors":[],"dates":[{"date":"2026-08-04T13:21:52Z","dateType":"Submitted","dateInformation":"v1"},{"date":"2026-08-05T00:53:45Z","dateType":"Updated","dateInformation":"v1"},{"date":"2026-08","dateType":"Available","dateInformation":"v1"}],"language":null,"types":{"schemaOrg":"CreativeWork","resourceTypeGeneral":"Preprint","citeproc":"article","bibtex":"misc","ris":"GEN","resourceType":"Article"},"relatedIdentifiers":[],"relatedItems":[],"sizes":[],"formats":[],"version":"1","rightsList":[{"rightsUri":"http://arxiv.org/licenses/nonexclusive-distrib/1.0/","rights":"arXiv.org perpetual, non-exclusive license"}],"descriptions":[{"descriptionType":"Abstract","description":"A three-dimensional (3-D) hybrid numerical method (HNM) is presented for electromagnetic scattering in structures with multiple inhomogeneous layered media coupled to an arbitrary 3-D non-layered scattering region. It integrates the 3-D numerical mode-matching (NMM) method with a tree-cotree-based mixed finite element method (MFEM). In the NMM, the fields in the 3-D layered media are reduced to a superposition of 2-D waveguide eigenmodes, while the MFEM discretizes the 3-D scattering region. The HNM thus inherits the dimensionality-reduction advantages of both conventional hybrid MM/FEM and pure NMM. Numerical experiments show that the HNM provides an effcient alternative for scattering problems involving non-layered regions embedded in layered media."},{"descriptionType":"Other","description":"21pages,12 figures"}],"geoLocations":[],"fundingReferences":[],"url":"https://arxiv.org/abs/2608.03639","contentUrl":null,"metadataVersion":0,"schemaVersion":"http://datacite.org/schema/kernel-4","source":"mds","isActive":true,"state":"findable","reason":null,"viewCount":0,"downloadCount":0,"referenceCount":0,"citationCount":0,"partCount":0,"partOfCount":0,"versionCount":0,"versionOfCount":0,"created":"2026-08-05T02:17:34Z","registered":"2026-08-05T02:17:35Z","published":null,"updated":"2026-08-05T02:17:35Z"},"relationships":{"client":{"data":{"id":"arxiv.content","type":"clients"}}}},{"id":"10.48550/arxiv.2608.03638","type":"dois","attributes":{"doi":"10.48550/arxiv.2608.03638","identifiers":[{"identifier":"2608.03638","identifierType":"arXiv"}],"creators":[{"nameType":"Personal","givenName":"Patrizio","familyName":"Graziosi","name":"Graziosi, Patrizio","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Damiano","familyName":"Marian","name":"Marian, Damiano","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Andrea","familyName":"Tomadin","name":"Tomadin, Andrea","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Stefano","familyName":"Roddaro","name":"Roddaro, Stefano","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Omar","familyName":"Concepción","name":"Concepción, Omar","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Johnny","familyName":"Tiscareño-Ramírez","name":"Tiscareño-Ramírez, Johnny","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Agnieszka Anna","familyName":"Corley-Wiciak","name":"Corley-Wiciak, Agnieszka Anna","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Dan","familyName":"Buca","name":"Buca, Dan","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Giovanni","familyName":"Capellini","name":"Capellini, Giovanni","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Michele","familyName":"Virgilio","name":"Virgilio, Michele","affiliation":[],"nameIdentifiers":[]}],"titles":[{"title":"Epitaxial SiGeSn alloys for CMOS-compatible thermoelectric devices"}],"publisher":"arXiv","container":{},"publicationYear":2026,"subjects":[{"subject":"Materials Science (cond-mat.mtrl-sci)","lang":"en","subjectScheme":"arXiv"},{"subject":"Computational Physics (physics.comp-ph)","lang":"en","subjectScheme":"arXiv"},{"subject":"FOS: Physical sciences","subjectScheme":"Fields of Science and Technology (FOS)"}],"contributors":[],"dates":[{"date":"2026-08-04T13:21:09Z","dateType":"Submitted","dateInformation":"v1"},{"date":"2026-08-05T00:53:41Z","dateType":"Updated","dateInformation":"v1"},{"date":"2026-08","dateType":"Available","dateInformation":"v1"}],"language":null,"types":{"schemaOrg":"CreativeWork","resourceTypeGeneral":"Preprint","citeproc":"article","bibtex":"misc","ris":"GEN","resourceType":"Article"},"relatedIdentifiers":[{"relationType":"IsVersionOf","relatedIdentifier":"10.1021/acsaem.5c00733","relatedIdentifierType":"DOI"}],"relatedItems":[],"sizes":[],"formats":[],"version":"1","rightsList":[{"rightsIdentifierScheme":"SPDX","rightsUri":"https://creativecommons.org/licenses/by-nc-nd/4.0/legalcode","schemeUri":"https://spdx.org/licenses/","rights":"Creative Commons Attribution Non Commercial No Derivatives 4.0 International","rightsIdentifier":"cc-by-nc-nd-4.0"}],"descriptions":[{"descriptionType":"Abstract","description":"The integration of thermoelectric devices into mainstream microelectronic technological platform could be a major breakthrough in various fields within the \\emph{so-called} Green-IT realm. In this article, the thermoelectric properties of heteroepitaxial SiGeSn alloys, a novel CMOS compatible material system, are evaluated to assess their possible application in thermoelectric devices. To this purpose, starting from the experimentally low lattice thermal conductivity of SiGeSn/Ge/Si layers of about $\\sim$1-2 W/m$\\cdot$K assessed by means of 3-$ω$ measurements, the figure of merits are calculated through the use of Boltzmann transport equation, taking into account the relevant inter-valley scattering processes, peculiar of this multi-valley material system. Values for the figure of merit $ZT$ exceeding $1$ have been obtained for both p- and n- type material at operating temperatures within the 300---400 K range, i.e. at a typical On-Chip temperatures. In this interval, the predicted power factor also features very competitive values of the order of 20 $\\rm{μW/cm\\cdot K^2}$. Our finding indicates that this new class of Si-based materials has extremely good prospects for real-world applications, and can further stimulate scientific investigation in this ambit."},{"descriptionType":"Other","description":"5 figures"}],"geoLocations":[],"fundingReferences":[],"url":"https://arxiv.org/abs/2608.03638","contentUrl":null,"metadataVersion":0,"schemaVersion":"http://datacite.org/schema/kernel-4","source":"mds","isActive":true,"state":"findable","reason":null,"viewCount":0,"downloadCount":0,"referenceCount":0,"citationCount":0,"partCount":0,"partOfCount":0,"versionCount":0,"versionOfCount":1,"created":"2026-08-05T02:17:33Z","registered":"2026-08-05T02:17:33Z","published":null,"updated":"2026-08-05T02:17:33Z"},"relationships":{"client":{"data":{"id":"arxiv.content","type":"clients"}}}},{"id":"10.48550/arxiv.2608.03637","type":"dois","attributes":{"doi":"10.48550/arxiv.2608.03637","identifiers":[{"identifier":"2608.03637","identifierType":"arXiv"}],"creators":[{"nameType":"Personal","givenName":"Jonas Leo","familyName":"Mueller","name":"Mueller, Jonas Leo","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Markus","familyName":"Gambietz","name":"Gambietz, Markus","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Alexander","familyName":"Weiss","name":"Weiss, Alexander","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Daniel","familyName":"Krauss","name":"Krauss, Daniel","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Bjoern M.","familyName":"Eskofier","name":"Eskofier, Bjoern M.","affiliation":[],"nameIdentifiers":[]}],"titles":[{"title":"Learning Biomechanically Plausible Human Motion from Sparse Radar Point Clouds"}],"publisher":"arXiv","container":{},"publicationYear":2026,"subjects":[{"subject":"Computer Vision and Pattern Recognition (cs.CV)","lang":"en","subjectScheme":"arXiv"},{"subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"}],"contributors":[],"dates":[{"date":"2026-08-04T13:20:05Z","dateType":"Submitted","dateInformation":"v1"},{"date":"2026-08-05T00:53:39Z","dateType":"Updated","dateInformation":"v1"},{"date":"2026-08","dateType":"Available","dateInformation":"v1"}],"language":null,"types":{"schemaOrg":"CreativeWork","resourceTypeGeneral":"Preprint","citeproc":"article","bibtex":"misc","ris":"GEN","resourceType":"Article"},"relatedIdentifiers":[],"relatedItems":[],"sizes":[],"formats":[],"version":"1","rightsList":[{"rightsUri":"http://arxiv.org/licenses/nonexclusive-distrib/1.0/","rights":"arXiv.org perpetual, non-exclusive license"}],"descriptions":[{"descriptionType":"Abstract","description":"Radar-based human pose estimation has focused on improving learning algorithms while representing the body as unconstrained keypoint coordinates. We address the underexplored dimension of anatomical fidelity by integrating a full-body skeletal model into a differentiable, end-to-end trainable radar-based pose estimation framework, in which the pose network is supervised through forward kinematics while subject-specific geometry is fitted beforehand. Subject-specific body segment proportions are predicted from radar point cloud features to scale a biomechanical skeleton. A motion prediction network maps temporal radar sequences to generalized coordinates, and differentiable forward kinematics converts predicted joint angles into 3D positions. A contact classification loss encourages physically plausible foot-ground interaction. Under leave-one-subject-out cross-validation on 11 healthy participants performing rehabilitation exercises, the framework achieves 6.456 +/- 1.759 cm mean per-joint position error (MPJPE), 8.083 +/- 0.884 degrees mean per-joint angle error (MPJAE), 0.935 +/- 0.009 contact classification F1, and 3.4 +/- 1.3 % scaling error. This proof-of-concept study demonstrates the feasibility of recovering interpretable biomechanical descriptors from a single low-cost radar sensor in a controlled laboratory setting, a prerequisite for future clinical motion analysis."}],"geoLocations":[],"fundingReferences":[],"url":"https://arxiv.org/abs/2608.03637","contentUrl":null,"metadataVersion":0,"schemaVersion":"http://datacite.org/schema/kernel-4","source":"mds","isActive":true,"state":"findable","reason":null,"viewCount":0,"downloadCount":0,"referenceCount":0,"citationCount":0,"partCount":0,"partOfCount":0,"versionCount":0,"versionOfCount":0,"created":"2026-08-05T02:17:31Z","registered":null,"published":null,"updated":"2026-08-05T02:17:32Z"},"relationships":{"client":{"data":{"id":"arxiv.content","type":"clients"}}}},{"id":"10.48550/arxiv.2608.03636","type":"dois","attributes":{"doi":"10.48550/arxiv.2608.03636","identifiers":[{"identifier":"2608.03636","identifierType":"arXiv"}],"creators":[{"nameType":"Personal","givenName":"Haoze","familyName":"Lv","name":"Lv, Haoze","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Ning","familyName":"Lu","name":"Lu, Ning","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Shengcai","familyName":"Liu","name":"Liu, Shengcai","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Shaofeng","familyName":"Zhang","name":"Zhang, Shaofeng","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Ke","familyName":"Tang","name":"Tang, Ke","affiliation":[],"nameIdentifiers":[]}],"titles":[{"title":"MuEvo: LLM-Driven Evolution of Multi-Heuristic Ensemble"}],"publisher":"arXiv","container":{},"publicationYear":2026,"subjects":[{"subject":"Neural and Evolutionary Computing (cs.NE)","lang":"en","subjectScheme":"arXiv"},{"subject":"Artificial Intelligence (cs.AI)","lang":"en","subjectScheme":"arXiv"},{"subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"}],"contributors":[],"dates":[{"date":"2026-08-04T13:19:51Z","dateType":"Submitted","dateInformation":"v1"},{"date":"2026-08-05T00:53:38Z","dateType":"Updated","dateInformation":"v1"},{"date":"2026-08","dateType":"Available","dateInformation":"v1"}],"language":null,"types":{"schemaOrg":"CreativeWork","resourceTypeGeneral":"Preprint","citeproc":"article","bibtex":"misc","ris":"GEN","resourceType":"Article"},"relatedIdentifiers":[],"relatedItems":[],"sizes":[],"formats":[],"version":"1","rightsList":[{"rightsUri":"http://arxiv.org/licenses/nonexclusive-distrib/1.0/","rights":"arXiv.org perpetual, non-exclusive license"}],"descriptions":[{"descriptionType":"Abstract","description":"Large language model-based automated heuristic design (LLM-AHD) has shown strong potential in discovering effective heuristics for combinatorial optimization problems. However, existing methods primarily optimize a single heuristic, whereas practical optimization frameworks often rely on multiple interacting components. Directly extending single-heuristic methods is challenging because early component selection can overlook components with late potential, while independent evolution ignores inter-component dependencies. We propose MuEvo, an LLM-driven framework for evolving heuristic ensembles under ensemble-level feedback. MuEvo combines Dynamic Component Management, which uses short-budget probing and a reversible lifecycle to revise component priorities throughout the search, with LLM-Driven Co-Evolution, which coordinates component populations through Multi-Ensemble Evaluation, Cross-Component Information Sharing, Relation-Guided Pair Evolution, and Adaptive Budget Allocation. We evaluate MuEvo on selection hyper-heuristics and componentized ant colony optimization across four combinatorial optimization domains. Results show that MuEvo consistently improves human-designed frameworks and outperforms representative multi-component extensions of state-of-the-art LLM-AHD methods, demonstrating its effectiveness across both controller-mediated heuristic pools and functionally differentiated algorithmic components."},{"descriptionType":"Other","description":"30 pages, 4 figures, 16 tables"}],"geoLocations":[],"fundingReferences":[],"url":"https://arxiv.org/abs/2608.03636","contentUrl":null,"metadataVersion":0,"schemaVersion":"http://datacite.org/schema/kernel-4","source":"mds","isActive":true,"state":"findable","reason":null,"viewCount":0,"downloadCount":0,"referenceCount":0,"citationCount":0,"partCount":0,"partOfCount":0,"versionCount":0,"versionOfCount":0,"created":"2026-08-05T02:17:30Z","registered":null,"published":null,"updated":"2026-08-05T02:17:30Z"},"relationships":{"client":{"data":{"id":"arxiv.content","type":"clients"}}}},{"id":"10.48550/arxiv.2608.03635","type":"dois","attributes":{"doi":"10.48550/arxiv.2608.03635","identifiers":[{"identifier":"2608.03635","identifierType":"arXiv"}],"creators":[{"nameType":"Personal","givenName":"Benjamin","familyName":"Nill","name":"Nill, Benjamin","affiliation":[],"nameIdentifiers":[]}],"titles":[{"title":"Lattice polytopes of large width have real-rooted Ehrhart $h^*$-polynomials"}],"publisher":"arXiv","container":{},"publicationYear":2026,"subjects":[{"subject":"Combinatorics (math.CO)","lang":"en","subjectScheme":"arXiv"},{"subject":"FOS: Mathematics","subjectScheme":"Fields of Science and Technology (FOS)"},{"subject":"52B20, 05A15, 52C07","lang":"en","subjectScheme":"MSC"}],"contributors":[],"dates":[{"date":"2026-08-04T13:19:26Z","dateType":"Submitted","dateInformation":"v1"},{"date":"2026-08-05T00:53:38Z","dateType":"Updated","dateInformation":"v1"},{"date":"2026-08","dateType":"Available","dateInformation":"v1"}],"language":null,"types":{"schemaOrg":"CreativeWork","resourceTypeGeneral":"Preprint","citeproc":"article","bibtex":"misc","ris":"GEN","resourceType":"Article"},"relatedIdentifiers":[],"relatedItems":[],"sizes":[],"formats":[],"version":"1","rightsList":[{"rightsUri":"http://arxiv.org/licenses/nonexclusive-distrib/1.0/","rights":"arXiv.org perpetual, non-exclusive license"}],"descriptions":[{"descriptionType":"Abstract","description":"In this note we prove that in fixed dimension the Ehrhart $h^*$-polynomial of a lattice polytope of sufficiently large lattice width is real-rooted. In particular, this implies strict log-concavity and unimodality of the $h^*$-vector and answers a question of Averkov, Hofscheier and the author. For a lattice simplex we prove the analogous statement for its local $h^*$-polynomial, also called box polynomial. The proofs were found using ChatGPT 5.6 Sol and follow essentially directly from a result by Basu and Oertel that for large enough lattice width counting lattice points approximates the volume."},{"descriptionType":"Other","description":"5 pages"}],"geoLocations":[],"fundingReferences":[],"url":"https://arxiv.org/abs/2608.03635","contentUrl":null,"metadataVersion":0,"schemaVersion":"http://datacite.org/schema/kernel-4","source":"mds","isActive":true,"state":"findable","reason":null,"viewCount":0,"downloadCount":0,"referenceCount":0,"citationCount":0,"partCount":0,"partOfCount":0,"versionCount":0,"versionOfCount":0,"created":"2026-08-05T02:17:28Z","registered":null,"published":null,"updated":"2026-08-05T02:17:29Z"},"relationships":{"client":{"data":{"id":"arxiv.content","type":"clients"}}}},{"id":"10.48550/arxiv.2608.03634","type":"dois","attributes":{"doi":"10.48550/arxiv.2608.03634","identifiers":[{"identifier":"2608.03634","identifierType":"arXiv"}],"creators":[{"nameType":"Personal","givenName":"Kazuki","familyName":"Ikeda","name":"Ikeda, Kazuki","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Yaron","familyName":"Oz","name":"Oz, Yaron","affiliation":[],"nameIdentifiers":[]}],"titles":[{"title":"Entangling Topological Invariants"}],"publisher":"arXiv","container":{},"publicationYear":2026,"subjects":[{"subject":"Quantum Physics (quant-ph)","lang":"en","subjectScheme":"arXiv"},{"subject":"Mesoscale and Nanoscale Physics (cond-mat.mes-hall)","lang":"en","subjectScheme":"arXiv"},{"subject":"High Energy Physics - Theory (hep-th)","lang":"en","subjectScheme":"arXiv"},{"subject":"Mathematical Physics (math-ph)","lang":"en","subjectScheme":"arXiv"},{"subject":"FOS: Physical sciences","subjectScheme":"Fields of Science and Technology (FOS)"}],"contributors":[],"dates":[{"date":"2026-08-04T13:18:58Z","dateType":"Submitted","dateInformation":"v1"},{"date":"2026-08-05T00:53:37Z","dateType":"Updated","dateInformation":"v1"},{"date":"2026-08","dateType":"Available","dateInformation":"v1"}],"language":null,"types":{"schemaOrg":"CreativeWork","resourceTypeGeneral":"Preprint","citeproc":"article","bibtex":"misc","ris":"GEN","resourceType":"Article"},"relatedIdentifiers":[],"relatedItems":[],"sizes":[],"formats":[],"version":"1","rightsList":[{"rightsUri":"http://arxiv.org/licenses/nonexclusive-distrib/1.0/","rights":"arXiv.org perpetual, non-exclusive license"}],"descriptions":[{"descriptionType":"Abstract","description":"An isolated occupied multiplet may admit local tensor-product descriptions without a globally consistent subsystem structure. We characterize the obstruction by comparing the transition functions of the occupied multiplet with those generated by independent basis changes in the two candidate subsystems. When a decomposition into rank-one sectors over a closed surface is specified, the resulting quotient removes row- and column-additive Chern data and yields mixed Chern classes. Momentum-dependent mixing of the sector labels adds the Gauss--Codazzi curvature of the moving lines, while in the label-conserving limit the mixed class is measured by a crossed Thouless pump. When only the factor dimensions $p$ and $q$ are specified, the comparison is made at the level of the clutching map of a rank-$pq$ bundle over $S^4$. Product frames generate winding numbers in $q\\mathbb Z+p\\mathbb Z$, so global factorization is possible exactly when $C_2$ is divisible by $\\gcd(p,q)$; in particular, odd $C_2$ obstructs a $2\\times2$ factorization. We illustrate the two settings with finite eight-level Hamiltonians and give pumping and occupied-projector tomography protocols for their readout."},{"descriptionType":"Other","description":"17 pages, 8 figures"}],"geoLocations":[],"fundingReferences":[],"url":"https://arxiv.org/abs/2608.03634","contentUrl":null,"metadataVersion":0,"schemaVersion":"http://datacite.org/schema/kernel-4","source":"mds","isActive":true,"state":"findable","reason":null,"viewCount":0,"downloadCount":0,"referenceCount":0,"citationCount":0,"partCount":0,"partOfCount":0,"versionCount":0,"versionOfCount":0,"created":"2026-08-05T02:17:27Z","registered":null,"published":null,"updated":"2026-08-05T02:17:27Z"},"relationships":{"client":{"data":{"id":"arxiv.content","type":"clients"}}}},{"id":"10.48550/arxiv.2608.03632","type":"dois","attributes":{"doi":"10.48550/arxiv.2608.03632","identifiers":[{"identifier":"2608.03632","identifierType":"arXiv"}],"creators":[{"nameType":"Personal","givenName":"Yinuo","familyName":"Jiang","name":"Jiang, Yinuo","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Yongjie","familyName":"Ye","name":"Ye, Yongjie","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Zhou","familyName":"Tao","name":"Tao, Zhou","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Xiang","familyName":"Zhuang","name":"Zhuang, Xiang","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Qiang","familyName":"Zhang","name":"Zhang, Qiang","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Huajun","familyName":"Chen","name":"Chen, Huajun","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Tiankai","familyName":"Li","name":"Li, Tiankai","affiliation":[],"nameIdentifiers":[]}],"titles":[{"title":"When Teachers Mislead: Spurious-Signal-Aware On-Policy Distillation"}],"publisher":"arXiv","container":{},"publicationYear":2026,"subjects":[{"subject":"Artificial Intelligence (cs.AI)","lang":"en","subjectScheme":"arXiv"},{"subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"}],"contributors":[],"dates":[{"date":"2026-08-04T13:17:30Z","dateType":"Submitted","dateInformation":"v1"},{"date":"2026-08-05T00:53:34Z","dateType":"Updated","dateInformation":"v1"},{"date":"2026-08","dateType":"Available","dateInformation":"v1"}],"language":null,"types":{"schemaOrg":"CreativeWork","resourceTypeGeneral":"Preprint","citeproc":"article","bibtex":"misc","ris":"GEN","resourceType":"Article"},"relatedIdentifiers":[],"relatedItems":[],"sizes":[],"formats":[],"version":"1","rightsList":[{"rightsUri":"http://arxiv.org/licenses/nonexclusive-distrib/1.0/","rights":"arXiv.org perpetual, non-exclusive license"}],"descriptions":[{"descriptionType":"Abstract","description":"On-Policy distillation (OPD) transfers teacher capabilities by supervising student-sampled trajectories with dense token-level teacher signals. Recent selective OPD methods improve this process by prioritizing signals that are confident, informative, or learnable. However, the assumptions overlook a fundamental failure mode of language models: their token-level judgments can be driven by input-agnostic language priors, formatting conventions, or stereotyped reasoning templates rather than task-specific evidence. We refer to such optimization-relevant but weakly input-grounded supervision as spurious signals in OPD, which may produce large gradients while contributing little task-improving direction. To mitigate this issue, we propose SA-OPD, a Spurious-Signal-Aware On-Policy Distillation framework that identifies and filters misleading token-level supervision based on input-groundedness and optimization impact. SA-OPD introduces a lightweight input-groundedness proxy estimating whether a token-level distillation signal truly depends on the input. It then filters only tokens that simultaneously exhibit low input-groundedness and extreme distillation divergence, thereby removing high-impact spurious updates and achieving fine-grained OPD optimization. Extensive experiments on both large language model (LLM) and vision-language model (VLM) settings demonstrate that SA-OPD consistently outperforms Vanilla OPD and competitive selective methods. These results establish input-groundedness as a key dimension for OPD supervision selection and offer a simple, effective strategy for mitigating spurious updates."},{"descriptionType":"Other","description":"21 pages, 10 figures"}],"geoLocations":[],"fundingReferences":[],"url":"https://arxiv.org/abs/2608.03632","contentUrl":null,"metadataVersion":0,"schemaVersion":"http://datacite.org/schema/kernel-4","source":"mds","isActive":true,"state":"findable","reason":null,"viewCount":0,"downloadCount":0,"referenceCount":0,"citationCount":0,"partCount":0,"partOfCount":0,"versionCount":0,"versionOfCount":0,"created":"2026-08-05T02:17:24Z","registered":"2026-08-05T02:17:25Z","published":null,"updated":"2026-08-05T02:17:25Z"},"relationships":{"client":{"data":{"id":"arxiv.content","type":"clients"}}}},{"id":"10.48550/arxiv.2608.03631","type":"dois","attributes":{"doi":"10.48550/arxiv.2608.03631","identifiers":[{"identifier":"2608.03631","identifierType":"arXiv"}],"creators":[{"nameType":"Personal","givenName":"Feixiang","familyName":"Liu","name":"Liu, Feixiang","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Likun","familyName":"Wang","name":"Wang, Likun","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Qiang","familyName":"Qiu","name":"Qiu, Qiang","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Hui","familyName":"Xu","name":"Xu, Hui","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Huawei","familyName":"Shen","name":"Shen, Huawei","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Xueqi","familyName":"Cheng","name":"Cheng, Xueqi","affiliation":[],"nameIdentifiers":[]}],"titles":[{"title":"SEER: A Self-Grounded Evidence Interface for Controlled Spatial Relation Classification"}],"publisher":"arXiv","container":{},"publicationYear":2026,"subjects":[{"subject":"Computer Vision and Pattern Recognition (cs.CV)","lang":"en","subjectScheme":"arXiv"},{"subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"}],"contributors":[],"dates":[{"date":"2026-08-04T13:16:15Z","dateType":"Submitted","dateInformation":"v1"},{"date":"2026-08-05T00:53:28Z","dateType":"Updated","dateInformation":"v1"},{"date":"2026-08","dateType":"Available","dateInformation":"v1"}],"language":null,"types":{"schemaOrg":"CreativeWork","resourceTypeGeneral":"Preprint","citeproc":"article","bibtex":"misc","ris":"GEN","resourceType":"Article"},"relatedIdentifiers":[],"relatedItems":[],"sizes":[],"formats":[],"version":"1","rightsList":[{"rightsIdentifierScheme":"SPDX","rightsUri":"https://creativecommons.org/licenses/by/4.0/legalcode","schemeUri":"https://spdx.org/licenses/","rights":"Creative Commons Attribution 4.0 International","rightsIdentifier":"cc-by-4.0"}],"descriptions":[{"descriptionType":"Abstract","description":"Spatial relation questions require a model to identify the queried subject and object before comparing their layout. Yet a VLM can recognize both entities and still answer from the wrong instance or an ambiguous global view. We ask whether making query-specific evidence explicit can mitigate this failure and propose SEER (Self-grounded Evidence for Entity-Relation Reasoning), a training-free inference-time evidence interface for frozen VLMs. SEER hides candidate relations during pair localization, constructs a query-specific view with explicit subject/object roles, and retains the full image and sparse box geometry as complementary evidence. For relation-choice protocols with exact inverse support, an optional refinement swaps the entity roles and changes the forward decision only when exactly one visual state obeys the corresponding inverse relation. On an image-disjoint GQA-Train900 test frozen before model scoring, SEER pools to +3.94 [2.17,5.72] over Full; the gain remains positive under label-independent grounding-order counterbalancing and on the 535 rows whose entity names are unique. The unchanged protocol yields +4.35 to +11.79 on all 2,434 filtered EmbSpatial pair-relation questions across three models. Matched controls separate local refocus from role-explicit conditioning. These results establish query-specific evidence construction as the principal intervention, with reciprocal consistency as a smaller protocol-specific refinement."},{"descriptionType":"Other","description":"23 pages total, 2 figures. Code: https://github.com/SouthWinter/SEER"}],"geoLocations":[],"fundingReferences":[],"url":"https://arxiv.org/abs/2608.03631","contentUrl":null,"metadataVersion":0,"schemaVersion":"http://datacite.org/schema/kernel-4","source":"mds","isActive":true,"state":"findable","reason":null,"viewCount":0,"downloadCount":0,"referenceCount":0,"citationCount":0,"partCount":0,"partOfCount":0,"versionCount":0,"versionOfCount":0,"created":"2026-08-05T02:17:23Z","registered":null,"published":null,"updated":"2026-08-05T02:17:23Z"},"relationships":{"client":{"data":{"id":"arxiv.content","type":"clients"}}}},{"id":"10.48550/arxiv.2608.03630","type":"dois","attributes":{"doi":"10.48550/arxiv.2608.03630","identifiers":[{"identifier":"2608.03630","identifierType":"arXiv"}],"creators":[{"nameType":"Personal","givenName":"Jiawen","familyName":"Zhu","name":"Zhu, Jiawen","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Shuhan","familyName":"Liu","name":"Liu, Shuhan","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Shengxuan","familyName":"Li","name":"Li, Shengxuan","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Qiming","familyName":"Shi","name":"Shi, Qiming","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Di","familyName":"Weng","name":"Weng, Di","affiliation":[],"nameIdentifiers":[]}],"titles":[{"title":"POEM: Phase-Aware $\\mathrm{SO}(2)$ Feature Rotation for Time Series Forecasting Under Periodicity Drift"}],"publisher":"arXiv","container":{},"publicationYear":2026,"subjects":[{"subject":"Machine Learning (cs.LG)","lang":"en","subjectScheme":"arXiv"},{"subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"}],"contributors":[],"dates":[{"date":"2026-08-04T13:16:07Z","dateType":"Submitted","dateInformation":"v1"},{"date":"2026-08-05T00:53:27Z","dateType":"Updated","dateInformation":"v1"},{"date":"2026-08","dateType":"Available","dateInformation":"v1"}],"language":null,"types":{"schemaOrg":"CreativeWork","resourceTypeGeneral":"Preprint","citeproc":"article","bibtex":"misc","ris":"GEN","resourceType":"Article"},"relatedIdentifiers":[],"relatedItems":[],"sizes":[],"formats":[],"version":"1","rightsList":[{"rightsIdentifierScheme":"SPDX","rightsUri":"https://creativecommons.org/licenses/by/4.0/legalcode","schemeUri":"https://spdx.org/licenses/","rights":"Creative Commons Attribution 4.0 International","rightsIdentifier":"cc-by-4.0"}],"descriptions":[{"descriptionType":"Abstract","description":"Deep learning has advanced time series forecasting, but periodicity drift, in which cycle timing and phase vary over time, remains a challenging problem. Existing methods predominantly model these sequences on fixed time grids, suffering from a limited ability to accommodate phase-related variation. To address this limitation, we propose \\textbf{POEM}, a phase-aware forecasting framework based on latent feature rotation using the special orthogonal group in two dimensions, denoted by $\\mathrm{SO}(2)$. POEM aims to reduce the phase-related variability by learning a phase-correction coordinate and applying an invertible $\\mathrm{SO}(2)$-based rotation to paired latent features. To extrapolate this correction coordinate, Directional Phase Increment Attention (DPIA) retrieves historical phase increments from similar temporal contexts and integrates them into future phase corrections. Experiments demonstrate that POEM achieves competitive performance, while qualitative visualizations suggest that the learned phase-aware transformation makes latent trajectories more regular."},{"descriptionType":"Other","description":"9 pages, 5 figures"}],"geoLocations":[],"fundingReferences":[],"url":"https://arxiv.org/abs/2608.03630","contentUrl":null,"metadataVersion":0,"schemaVersion":"http://datacite.org/schema/kernel-4","source":"mds","isActive":true,"state":"findable","reason":null,"viewCount":0,"downloadCount":0,"referenceCount":0,"citationCount":0,"partCount":0,"partOfCount":0,"versionCount":0,"versionOfCount":0,"created":"2026-08-05T02:17:22Z","registered":null,"published":null,"updated":"2026-08-05T02:17:22Z"},"relationships":{"client":{"data":{"id":"arxiv.content","type":"clients"}}}},{"id":"10.48550/arxiv.2608.03626","type":"dois","attributes":{"doi":"10.48550/arxiv.2608.03626","identifiers":[{"identifier":"2608.03626","identifierType":"arXiv"}],"creators":[{"nameType":"Personal","givenName":"Eleftherios","familyName":"Batzolis","name":"Batzolis, Eleftherios","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"George","familyName":"Drosatos","name":"Drosatos, George","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Vassilis","familyName":"Katsouros","name":"Katsouros, Vassilis","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Konstantinos","familyName":"Rantos","name":"Rantos, Konstantinos","affiliation":[],"nameIdentifiers":[]}],"titles":[{"title":"A Security-Oriented Lifecycle Model for Large Language Model Systems"}],"publisher":"arXiv","container":{},"publicationYear":2026,"subjects":[{"subject":"Cryptography and Security (cs.CR)","lang":"en","subjectScheme":"arXiv"},{"subject":"Artificial Intelligence (cs.AI)","lang":"en","subjectScheme":"arXiv"},{"subject":"Computers and Society (cs.CY)","lang":"en","subjectScheme":"arXiv"},{"subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"},{"subject":"K.6.5; D.2.9; I.2; K.4.1","lang":"en","subjectScheme":"ACM"}],"contributors":[],"dates":[{"date":"2026-08-04T13:13:48Z","dateType":"Submitted","dateInformation":"v1"},{"date":"2026-08-05T00:53:23Z","dateType":"Updated","dateInformation":"v1"},{"date":"2026-08","dateType":"Available","dateInformation":"v1"}],"language":null,"types":{"schemaOrg":"CreativeWork","resourceTypeGeneral":"Preprint","citeproc":"article","bibtex":"misc","ris":"GEN","resourceType":"Article"},"relatedIdentifiers":[],"relatedItems":[],"sizes":[],"formats":[],"version":"1","rightsList":[{"rightsUri":"http://arxiv.org/licenses/nonexclusive-distrib/1.0/","rights":"arXiv.org perpetual, non-exclusive license"}],"descriptions":[{"descriptionType":"Abstract","description":"Large language models are being integrated into critical infrastructure and enterprise workflows at unprecedented scale,yet the lifecycle frameworks governing their development and operations were designed for operational efficiency rather than security analysis. As a result, security-relevant activities such as data provenance verification, artifact signing, agentic permission control, and decommissioning are often left implicit or assumed to receive due care. Governance frameworks, in turn, organise requirements around risk levels or management processes without clearly linking them to the lifecycle stages where they apply. This paper addresses both deficiencies. We propose a lifecycle model for LLM systems that supports security analysis by structuring it around security-relevant boundaries rather than workflow optimisation. The model comprises 32 stages across four core pipeline layers (Data, Model, Distribution, Application), supported by a 12-stage LLMOps pillar and a 9-category governance pillar. Thirteen stages are introduced here as separate units because they expose distinct security concerns that existing frameworks do not clearly distinguish. A governance mapping synthesising the NIST AI RMF, the EU AI Act, and ISO/IEC 42001 reveals a structural property of the current regulatory landscape: governance evidence concentrates at deployment-facing stages, where systems are visible to regulators, while the most consequential decisions, data selection, alignment strategy, and capability boundaries, are made at development-facing stages, where regulatory visibility is lowest."},{"descriptionType":"Other","description":"Accepted as: Batzolis, E., Drosatos, G., Katsouros, V., \u0026amp; Rantos, K. (2026). A Security-Oriented Lifecycle Model for Large Language Model Systems. In: Kieseberg, P., Skopik, F., Atli, B., Schrittwieser, S., \u0026amp; Asplund, M. (Eds.), Availability, reliability and security---ARES 2026 EU Projects Symposium workshops (Lecture Notes in Computer Science, pp. 1-18). Springer Nature Switzerland"}],"geoLocations":[],"fundingReferences":[],"url":"https://arxiv.org/abs/2608.03626","contentUrl":null,"metadataVersion":0,"schemaVersion":"http://datacite.org/schema/kernel-4","source":"mds","isActive":true,"state":"findable","reason":null,"viewCount":0,"downloadCount":0,"referenceCount":0,"citationCount":0,"partCount":0,"partOfCount":0,"versionCount":0,"versionOfCount":0,"created":"2026-08-05T02:17:16Z","registered":"2026-08-05T02:17:17Z","published":null,"updated":"2026-08-05T02:17:17Z"},"relationships":{"client":{"data":{"id":"arxiv.content","type":"clients"}}}},{"id":"10.48550/arxiv.2608.03625","type":"dois","attributes":{"doi":"10.48550/arxiv.2608.03625","identifiers":[{"identifier":"2608.03625","identifierType":"arXiv"}],"creators":[{"nameType":"Personal","givenName":"Alessandro","familyName":"Linzi","name":"Linzi, Alessandro","affiliation":[],"nameIdentifiers":[]}],"titles":[{"title":"Finite-field Krasner quotients: isomorphism thresholds, characteristics, and censuses"}],"publisher":"arXiv","container":{},"publicationYear":2026,"subjects":[{"subject":"Rings and Algebras (math.RA)","lang":"en","subjectScheme":"arXiv"},{"subject":"FOS: Mathematics","subjectScheme":"Fields of Science and Technology (FOS)"},{"subject":"12K99, 16Y20, 20N20, 11T30","lang":"en","subjectScheme":"MSC"}],"contributors":[],"dates":[{"date":"2026-08-04T13:13:12Z","dateType":"Submitted","dateInformation":"v1"},{"date":"2026-08-05T00:53:22Z","dateType":"Updated","dateInformation":"v1"},{"date":"2026-08","dateType":"Available","dateInformation":"v1"}],"language":null,"types":{"schemaOrg":"CreativeWork","resourceTypeGeneral":"Preprint","citeproc":"article","bibtex":"misc","ris":"GEN","resourceType":"Article"},"relatedIdentifiers":[],"relatedItems":[],"sizes":[],"formats":[],"version":"1","rightsList":[{"rightsUri":"http://arxiv.org/licenses/nonexclusive-distrib/1.0/","rights":"arXiv.org perpetual, non-exclusive license"}],"descriptions":[{"descriptionType":"Abstract","description":"We study Krasner quotient hyperfields arising from finite fields, $F_q/G_r$, where $G_r\\le F_q^\\times$ has index $r$. Building on the structure theorem of Baker--Jin, we determine the characteristic and C-characteristic of all sufficiently large such quotients: they depend only on the parity of $r$ and, when $r$ is even, on the residue class of $q$ modulo $2r$. In particular, the two Baker--Jin stable classes for even $r$ are separated by characteristic $2$ versus $3$, while the C-characteristic is always $1$.\n We complement this structural result with a computational laboratory: sharp Weil thresholds for Baker--Jin large-$q$ isomorphism, empirical minimal stabilization bounds $N_r^{\\mathrm{emp}}$, complete finite-field quotient atlases for hyperfield orders $n\\le 7$, and comparisons with the enumerations of Ameri--Eyvazi--Hošková-Mayerová (orders $\\le 6$) and Massouros--Massouros (order $7$). Among other findings, exactly $15$ isomorphism types of order $7$ arise as finite-field quotients, out of $277$ hyperfields of that order -- a concrete data point toward the Baker--Jin rarity conjecture for quotients. All algorithms and tables are available in an open-source package suitable for independent verification and arXiv ancillary material."},{"descriptionType":"Other","description":"7 pages. Ancillary data tables (CSV). Companion software: https://github.com/linzialessandro/Quotients-of-Finite-Fields-Optimized (v0.1.0)"}],"geoLocations":[],"fundingReferences":[],"url":"https://arxiv.org/abs/2608.03625","contentUrl":null,"metadataVersion":0,"schemaVersion":"http://datacite.org/schema/kernel-4","source":"mds","isActive":true,"state":"findable","reason":null,"viewCount":0,"downloadCount":0,"referenceCount":0,"citationCount":0,"partCount":0,"partOfCount":0,"versionCount":0,"versionOfCount":0,"created":"2026-08-05T02:17:15Z","registered":null,"published":null,"updated":"2026-08-05T02:17:15Z"},"relationships":{"client":{"data":{"id":"arxiv.content","type":"clients"}}}},{"id":"10.48550/arxiv.2608.03624","type":"dois","attributes":{"doi":"10.48550/arxiv.2608.03624","identifiers":[{"identifier":"2608.03624","identifierType":"arXiv"}],"creators":[{"nameType":"Personal","givenName":"Behzad","familyName":"Shomali","name":"Shomali, Behzad","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Markus","familyName":"Frey","name":"Frey, Markus","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"David","familyName":"Berghaus","name":"Berghaus, David","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Joachim","familyName":"Koehler","name":"Koehler, Joachim","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Mehdi","familyName":"Ali","name":"Ali, Mehdi","affiliation":[],"nameIdentifiers":[]}],"titles":[{"title":"LoopMTP: A looped transformer guided by latent multi-token prediction"}],"publisher":"arXiv","container":{},"publicationYear":2026,"subjects":[{"subject":"Computation and Language (cs.CL)","lang":"en","subjectScheme":"arXiv"},{"subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"}],"contributors":[],"dates":[{"date":"2026-08-04T13:13:09Z","dateType":"Submitted","dateInformation":"v1"},{"date":"2026-08-05T00:53:22Z","dateType":"Updated","dateInformation":"v1"},{"date":"2026-08","dateType":"Available","dateInformation":"v1"}],"language":null,"types":{"schemaOrg":"CreativeWork","resourceTypeGeneral":"Preprint","citeproc":"article","bibtex":"misc","ris":"GEN","resourceType":"Article"},"relatedIdentifiers":[],"relatedItems":[],"sizes":[],"formats":[],"version":"1","rightsList":[{"rightsIdentifierScheme":"SPDX","rightsUri":"https://creativecommons.org/licenses/by/4.0/legalcode","schemeUri":"https://spdx.org/licenses/","rights":"Creative Commons Attribution 4.0 International","rightsIdentifier":"cc-by-4.0"}],"descriptions":[{"descriptionType":"Abstract","description":"Looped transformers have emerged as a parameter-efficient alternative to scaling depth for strong reasoning. By reusing one stack of layers across $T$ iterations, they attain the effective depth and reasoning capabilities of larger models at a fixed parameter count. Yet existing approaches suffer from latent overthinking and undifferentiated computation, largely because intermediate representations receive no guidance across loops. Multi-token prediction (MTP) supplies exactly the dense, forward-looking supervision the loop is missing. We propose \\textsc{LoopMTP}, which links the two through a structural correspondence in latent space: a model that loops $T$ times can anticipate $T$ future tokens. \\textsc{LoopMTP} realizes this by softly aligning the hidden state of loop $t$ with the embedding of the token $t$ steps ahead, while a lightweight gate preserves useful information across iterations. \\textsc{LoopMTP} improves average accuracy by up to 8.1\\% (relative) over the non-looped baseline, with training remaining stable for up to 15 loops."}],"geoLocations":[],"fundingReferences":[],"url":"https://arxiv.org/abs/2608.03624","contentUrl":null,"metadataVersion":0,"schemaVersion":"http://datacite.org/schema/kernel-4","source":"mds","isActive":true,"state":"findable","reason":null,"viewCount":0,"downloadCount":0,"referenceCount":0,"citationCount":0,"partCount":0,"partOfCount":0,"versionCount":0,"versionOfCount":0,"created":"2026-08-05T02:17:13Z","registered":"2026-08-05T02:17:14Z","published":null,"updated":"2026-08-05T02:17:14Z"},"relationships":{"client":{"data":{"id":"arxiv.content","type":"clients"}}}},{"id":"10.48550/arxiv.2608.03622","type":"dois","attributes":{"doi":"10.48550/arxiv.2608.03622","identifiers":[{"identifier":"2608.03622","identifierType":"arXiv"}],"creators":[{"nameType":"Personal","givenName":"Wei","familyName":"Li","name":"Li, Wei","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Tao","familyName":"Xie","name":"Xie, Tao","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Yu-Hang","familyName":"Luo","name":"Luo, Yu-Hang","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Kang","familyName":"Zheng","name":"Zheng, Kang","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Meiyu","familyName":"Peng","name":"Peng, Meiyu","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Hui","familyName":"Yang","name":"Yang, Hui","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Chunling","familyName":"Ding","name":"Ding, Chunling","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Chen-Zhi","familyName":"Yuan","name":"Yuan, Chen-Zhi","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Omar S.","familyName":"Magana-Loaiza","name":"Magana-Loaiza, Omar S.","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Keyu","familyName":"Xia","name":"Xia, Keyu","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Ryosuke","familyName":"Shimizu","name":"Shimizu, Ryosuke","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Hui","familyName":"Jing","name":"Jing, Hui","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Chenglong","familyName":"You","name":"You, Chenglong","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Rui-Bo","familyName":"Jin","name":"Jin, Rui-Bo","affiliation":[],"nameIdentifiers":[]}],"titles":[{"title":"Sample-half-inserted quantum interferometer"}],"publisher":"arXiv","container":{},"publicationYear":2026,"subjects":[{"subject":"Quantum Physics (quant-ph)","lang":"en","subjectScheme":"arXiv"},{"subject":"FOS: Physical sciences","subjectScheme":"Fields of Science and Technology (FOS)"}],"contributors":[],"dates":[{"date":"2026-08-04T13:11:10Z","dateType":"Submitted","dateInformation":"v1"},{"date":"2026-08-05T00:53:19Z","dateType":"Updated","dateInformation":"v1"},{"date":"2026-08","dateType":"Available","dateInformation":"v1"}],"language":null,"types":{"schemaOrg":"CreativeWork","resourceTypeGeneral":"Preprint","citeproc":"article","bibtex":"misc","ris":"GEN","resourceType":"Article"},"relatedIdentifiers":[{"relationType":"IsVersionOf","relatedIdentifier":"10.1103/hldy-gmnn","relatedIdentifierType":"DOI"}],"relatedItems":[],"sizes":[],"formats":[],"version":"1","rightsList":[{"rightsIdentifierScheme":"SPDX","rightsUri":"https://creativecommons.org/licenses/by/4.0/legalcode","schemeUri":"https://spdx.org/licenses/","rights":"Creative Commons Attribution 4.0 International","rightsIdentifier":"cc-by-4.0"}],"descriptions":[{"descriptionType":"Abstract","description":"Quantum technologies have been widely recognized as unprecedented opportunities for ultra-high precision metrology. As a celebrated example in modern quantum optics, the Hong-Ou-Mandel (HOM) interferometer is well-known for enabling temporal resolutions on the attosecond scale. However, the relatively low Fisher information per trial in ordinary HOM measurements typically necessitates tens of thousands of repetitions to achieve such precision. Here, we propose and demonstrate a sample-half-inserted HOM (SHOM) interferometer, which enhances the Fisher information by five orders of magnitude in a single interference event. By introducing an asymmetric photon-sample interaction, the SHOM configuration produces a distinctive dip-bump-dip interference structure, converting what was previously viewed as an artifact into a helpful metrological resource. Experimentally, we measured the optical path difference with an average precision of 4.09 nm (13.63 as) and an average accuracy of 1.22 nm (4.07 as) using $O(10^7)$ photons. Our results establish SHOM interferometry as an efficient phase-insensitive approach, not only paving the way toward practical quantum-enhanced thickness measurement for transparent materials, but also serving as an elegant strategy to improve the performance of various quantum devices."},{"descriptionType":"Other","description":"7 pages, 3 figures"}],"geoLocations":[],"fundingReferences":[],"url":"https://arxiv.org/abs/2608.03622","contentUrl":null,"metadataVersion":0,"schemaVersion":"http://datacite.org/schema/kernel-4","source":"mds","isActive":true,"state":"findable","reason":null,"viewCount":0,"downloadCount":0,"referenceCount":0,"citationCount":0,"partCount":0,"partOfCount":0,"versionCount":0,"versionOfCount":1,"created":"2026-08-05T02:17:11Z","registered":"2026-08-05T02:17:11Z","published":null,"updated":"2026-08-05T02:17:11Z"},"relationships":{"client":{"data":{"id":"arxiv.content","type":"clients"}}}},{"id":"10.48550/arxiv.2608.03621","type":"dois","attributes":{"doi":"10.48550/arxiv.2608.03621","identifiers":[{"identifier":"2608.03621","identifierType":"arXiv"}],"creators":[{"nameType":"Personal","givenName":"Maelie","familyName":"Coral","name":"Coral, Maelie","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Jose","familyName":"Ordonez-Miranda","name":"Ordonez-Miranda, Jose","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Georges","familyName":"Hamaoui","name":"Hamaoui, Georges","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Roman","familyName":"Anufriev","name":"Anufriev, Roman","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Laurent","familyName":"Jalabert","name":"Jalabert, Laurent","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Masahiro","familyName":"Nomura","name":"Nomura, Masahiro","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Yannick","familyName":"De Wilde","name":"De Wilde, Yannick","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Sebastian","familyName":"Volz","name":"Volz, Sebastian","affiliation":[],"nameIdentifiers":[]}],"titles":[{"title":"Enhancement of far-field thermal emission via polaritonic cavity modes"}],"publisher":"arXiv","container":{},"publicationYear":2026,"subjects":[{"subject":"Mesoscale and Nanoscale Physics (cond-mat.mes-hall)","lang":"en","subjectScheme":"arXiv"},{"subject":"FOS: Physical sciences","subjectScheme":"Fields of Science and Technology (FOS)"}],"contributors":[],"dates":[{"date":"2026-08-04T13:10:24Z","dateType":"Submitted","dateInformation":"v1"},{"date":"2026-08-05T00:53:12Z","dateType":"Updated","dateInformation":"v1"},{"date":"2026-08","dateType":"Available","dateInformation":"v1"}],"language":null,"types":{"schemaOrg":"CreativeWork","resourceTypeGeneral":"Preprint","citeproc":"article","bibtex":"misc","ris":"GEN","resourceType":"Article"},"relatedIdentifiers":[],"relatedItems":[],"sizes":[],"formats":[],"version":"1","rightsList":[{"rightsIdentifierScheme":"SPDX","rightsUri":"https://creativecommons.org/licenses/by/4.0/legalcode","schemeUri":"https://spdx.org/licenses/","rights":"Creative Commons Attribution 4.0 International","rightsIdentifier":"cc-by-4.0"}],"descriptions":[{"descriptionType":"Abstract","description":"Controlling thermal emission is crucial for applications involving thermophotovoltaics, thermal sensing, imaging, and camouflage. While prior studies focused on the emission of thermally excited guided modes (TEGMs) inside cavities, their contribution to the far-field radiation outside cavities has remained unexplored. Here, we demonstrate a tunable far-field thermal channel enabled by TEGMs arising from the coupling of surface phonon-polaritons and cavity resonances. By combining infrared emissivity experiments with fluctuational electrodynamics simulations, we identify distinct spectral features marking the conversion of two-dimensionally confined polaritonic modes into three-dimensional radiative channels. We find that silicon cavities covered with SiO2 enhance the emissivity by up to 200% near the polaritonic spectral resonance, whereas bare silicon cavities yield only broadband enhancement. These findings provide experimental evidence of TEGMs and establish a simple cavity architecture as an effective and scalable platform for tailoring thermal radiation without complex nanofabrication."}],"geoLocations":[],"fundingReferences":[],"url":"https://arxiv.org/abs/2608.03621","contentUrl":null,"metadataVersion":0,"schemaVersion":"http://datacite.org/schema/kernel-4","source":"mds","isActive":true,"state":"findable","reason":null,"viewCount":0,"downloadCount":0,"referenceCount":0,"citationCount":0,"partCount":0,"partOfCount":0,"versionCount":0,"versionOfCount":0,"created":"2026-08-05T02:17:09Z","registered":"2026-08-05T02:17:10Z","published":null,"updated":"2026-08-05T02:17:10Z"},"relationships":{"client":{"data":{"id":"arxiv.content","type":"clients"}}}},{"id":"10.48550/arxiv.2608.03619","type":"dois","attributes":{"doi":"10.48550/arxiv.2608.03619","identifiers":[{"identifier":"2608.03619","identifierType":"arXiv"}],"creators":[{"nameType":"Personal","givenName":"Paul","familyName":"Raux","name":"Raux, Paul","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Alexander M.","familyName":"Maier","name":"Maier, Alexander M.","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Udo","familyName":"Seifert","name":"Seifert, Udo","affiliation":[],"nameIdentifiers":[]}],"titles":[{"title":"Lower bounds on entropy production from dynamical correlation functions"}],"publisher":"arXiv","container":{},"publicationYear":2026,"subjects":[{"subject":"Statistical Mechanics (cond-mat.stat-mech)","lang":"en","subjectScheme":"arXiv"},{"subject":"FOS: Physical sciences","subjectScheme":"Fields of Science and Technology (FOS)"}],"contributors":[],"dates":[{"date":"2026-08-04T13:09:27Z","dateType":"Submitted","dateInformation":"v1"},{"date":"2026-08-05T00:53:11Z","dateType":"Updated","dateInformation":"v1"},{"date":"2026-08","dateType":"Available","dateInformation":"v1"}],"language":null,"types":{"schemaOrg":"CreativeWork","resourceTypeGeneral":"Preprint","citeproc":"article","bibtex":"misc","ris":"GEN","resourceType":"Article"},"relatedIdentifiers":[],"relatedItems":[],"sizes":[],"formats":[],"version":"1","rightsList":[{"rightsUri":"http://arxiv.org/licenses/nonexclusive-distrib/1.0/","rights":"arXiv.org perpetual, non-exclusive license"}],"descriptions":[{"descriptionType":"Abstract","description":"Entropy production is a key property in stochastic thermodynamics. For partially observed and coarse-grained systems, its inference is challenging and typically rests on proven lower bounds. We derive two versions of such bounds based on the asymmetry of experimentally accessible two-time correlation functions of coarse-grained state observables. For non-equilibrium steady states, the bound is valid for arbitrary correlation lag. For time-dependent processes, it requires the limit of vanishing lag. These bounds hold true for any system that follows either a Markovian dynamics or a coupled set of overdamped Langevin equations on some underlying, unobservable level of description. We illustrate the bounds for both types of dynamics and discuss their optimization and potential tightness."}],"geoLocations":[],"fundingReferences":[],"url":"https://arxiv.org/abs/2608.03619","contentUrl":null,"metadataVersion":0,"schemaVersion":"http://datacite.org/schema/kernel-4","source":"mds","isActive":true,"state":"findable","reason":null,"viewCount":0,"downloadCount":0,"referenceCount":0,"citationCount":0,"partCount":0,"partOfCount":0,"versionCount":0,"versionOfCount":0,"created":"2026-08-05T02:17:07Z","registered":null,"published":null,"updated":"2026-08-05T02:17:07Z"},"relationships":{"client":{"data":{"id":"arxiv.content","type":"clients"}}}},{"id":"10.48550/arxiv.2608.03618","type":"dois","attributes":{"doi":"10.48550/arxiv.2608.03618","identifiers":[{"identifier":"2608.03618","identifierType":"arXiv"}],"creators":[{"nameType":"Personal","givenName":"Meng","familyName":"Wang","name":"Wang, Meng","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Shougao","familyName":"Zhang","name":"Zhang, Shougao","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Wenzhe","familyName":"He","name":"He, Wenzhe","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Ruihui","familyName":"Li","name":"Li, Ruihui","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Nan","familyName":"Hu","name":"Hu, Nan","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Zhuo","familyName":"Tang","name":"Tang, Zhuo","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Kenli","familyName":"Li","name":"Li, Kenli","affiliation":[],"nameIdentifiers":[]}],"titles":[{"title":"Geospatial-Prior Guidance for 3D Semantic Scene Completion"}],"publisher":"arXiv","container":{},"publicationYear":2026,"subjects":[{"subject":"Computer Vision and Pattern Recognition (cs.CV)","lang":"en","subjectScheme":"arXiv"},{"subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"}],"contributors":[],"dates":[{"date":"2026-08-04T13:08:14Z","dateType":"Submitted","dateInformation":"v1"},{"date":"2026-08-05T00:53:09Z","dateType":"Updated","dateInformation":"v1"},{"date":"2026-08","dateType":"Available","dateInformation":"v1"}],"language":null,"types":{"schemaOrg":"CreativeWork","resourceTypeGeneral":"Preprint","citeproc":"article","bibtex":"misc","ris":"GEN","resourceType":"Article"},"relatedIdentifiers":[],"relatedItems":[],"sizes":[],"formats":[],"version":"1","rightsList":[{"rightsUri":"http://arxiv.org/licenses/nonexclusive-distrib/1.0/","rights":"arXiv.org perpetual, non-exclusive license"}],"descriptions":[{"descriptionType":"Abstract","description":"Inferring complete 3D geometry and semantics from onboard images remains challenging because occlusions and restricted fields of view leave large scene regions underconstrained. Although satellite imagery provides wide-area context, appearance cues alone offer limited structural guidance and may be unreliable because of spatial or temporal discrepancies. We present GeoScene, a geospatially guided framework that jointly uses satellite imagery and structured OpenStreetMap cues as soft priors for 3D semantic scene completion. GeoScene learns complementary voxel-wise reliability weights for onboard observations and geospatial guidance, and uses them to control feature refinement in observed and unobserved regions. This design preserves local visual evidence while exploiting large-scale road and building structure beyond onboard visibility. Experiments on SemanticKITTI and SSCBench-KITTI-360 demonstrate that GeoScene consistently improves both geometric and semantic completion under the geospatial-prior-assisted setting, with the most pronounced benefits for large-scale static and geospatially structured classes."}],"geoLocations":[],"fundingReferences":[],"url":"https://arxiv.org/abs/2608.03618","contentUrl":null,"metadataVersion":0,"schemaVersion":"http://datacite.org/schema/kernel-4","source":"mds","isActive":true,"state":"findable","reason":null,"viewCount":0,"downloadCount":0,"referenceCount":0,"citationCount":0,"partCount":0,"partOfCount":0,"versionCount":0,"versionOfCount":0,"created":"2026-08-05T02:17:05Z","registered":"2026-08-05T02:17:06Z","published":null,"updated":"2026-08-05T02:17:06Z"},"relationships":{"client":{"data":{"id":"arxiv.content","type":"clients"}}}},{"id":"10.48550/arxiv.2608.03616","type":"dois","attributes":{"doi":"10.48550/arxiv.2608.03616","identifiers":[{"identifier":"2608.03616","identifierType":"arXiv"}],"creators":[{"nameType":"Personal","givenName":"Ramon Marc Garcia","familyName":"Seuma","name":"Seuma, Ramon Marc Garcia","affiliation":[],"nameIdentifiers":[]}],"titles":[{"title":"Measuring the engine of a liquidation cascade: subcritical branching inside a first-order transition"}],"publisher":"arXiv","container":{},"publicationYear":2026,"subjects":[{"subject":"Physics and Society (physics.soc-ph)","lang":"en","subjectScheme":"arXiv"},{"subject":"Statistical Finance (q-fin.ST)","lang":"en","subjectScheme":"arXiv"},{"subject":"FOS: Physical sciences","subjectScheme":"Fields of Science and Technology (FOS)"},{"subject":"FOS: Economics and business","subjectScheme":"Fields of Science and Technology (FOS)"}],"contributors":[],"dates":[{"date":"2026-08-04T13:07:28Z","dateType":"Submitted","dateInformation":"v1"},{"date":"2026-08-05T00:53:02Z","dateType":"Updated","dateInformation":"v1"},{"date":"2026-08","dateType":"Available","dateInformation":"v1"}],"language":null,"types":{"schemaOrg":"CreativeWork","resourceTypeGeneral":"Preprint","citeproc":"article","bibtex":"misc","ris":"GEN","resourceType":"Article"},"relatedIdentifiers":[],"relatedItems":[],"sizes":[],"formats":[],"version":"1","rightsList":[{"rightsUri":"http://arxiv.org/licenses/nonexclusive-distrib/1.0/","rights":"arXiv.org perpetual, non-exclusive license"}],"descriptions":[{"descriptionType":"Abstract","description":"We study seven major crypto-perpetual liquidation cascades (2022-2025), and in the largest of them we can watch the mechanism directly. From the on-chain fill log of a fully transparent venue we measure the branching ratio of that event -- the October 2025 crash, the largest on record -- in flight, with both of its factors observed and no free constants. It ran deeply subcritical: the structural ratio and the amplification bookkeeping both place it at $\\hatλ\\approx 0.1-0.2$ throughout, while a third, flow-based estimator falls through the climax rather than rising. All three agree on subcriticality within the venue, not on a common numerical level. Alongside them, 88% of all post-onset forced selling landed within thirty minutes and 63% of it was absorbed off-book by the venue's backstop, which drives the branching ratio down precisely at the climax. Across the full set of seven, at onset -- the minute ending the steepest hour of each crash -- the order parameter (mean inter-asset coupling) jumps by between 1.6 and 4.4 baseline standard deviations into a near-fully-ordered phase, while the susceptibility proxy $χ$ collapses in five of the seven events and diverges in none; the jump is invariant under subsampling. The transition is abrupt and scale-robust rather than critical, and its in-cascade signature lives in the liquidity sector: price impact spikes on two venues and two instruments while open interest clears by 25-70%. The natural mechanistic account, a Galton-Watson cascade with $λ= k \\tildeρ$, is then eliminated as a description of the pre-cascade state: both of its falsifiable predictions fail at simulated power \u0026gt;= 0.96, on proxied and on directly measured regressors alike. Severity is set by shock times map-in-path times liquidity withdrawal rather than by a diverging multiplier, which is why none of the scalar pre-state measures we can construct grades it."},{"descriptionType":"Other","description":"13 pages, 5 figures, 3 tables. Part II of a series; Part I is arXiv:2607.27070"}],"geoLocations":[],"fundingReferences":[],"url":"https://arxiv.org/abs/2608.03616","contentUrl":null,"metadataVersion":0,"schemaVersion":"http://datacite.org/schema/kernel-4","source":"mds","isActive":true,"state":"findable","reason":null,"viewCount":0,"downloadCount":0,"referenceCount":0,"citationCount":0,"partCount":0,"partOfCount":0,"versionCount":0,"versionOfCount":0,"created":"2026-08-05T02:17:02Z","registered":"2026-08-05T02:17:03Z","published":null,"updated":"2026-08-05T02:17:03Z"},"relationships":{"client":{"data":{"id":"arxiv.content","type":"clients"}}}},{"id":"10.48550/arxiv.2608.03615","type":"dois","attributes":{"doi":"10.48550/arxiv.2608.03615","identifiers":[{"identifier":"2608.03615","identifierType":"arXiv"}],"creators":[{"nameType":"Personal","givenName":"Caihao","familyName":"Weng","name":"Weng, Caihao","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Ying","familyName":"Wang","name":"Wang, Ying","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Xufeng","familyName":"Guo","name":"Guo, Xufeng","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Yuqing","familyName":"Guo","name":"Guo, Yuqing","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Ce","familyName":"Guo","name":"Guo, Ce","affiliation":[],"nameIdentifiers":[]}],"titles":[{"title":"Pattern Zooming: Near-Field Wideband Beam Training with Wavenumber-Domain Codebook"}],"publisher":"arXiv","container":{},"publicationYear":2026,"subjects":[{"subject":"Signal Processing (eess.SP)","lang":"en","subjectScheme":"arXiv"},{"subject":"FOS: Electrical engineering, electronic engineering, information engineering","subjectScheme":"Fields of Science and Technology (FOS)"}],"contributors":[],"dates":[{"date":"2026-08-04T13:07:06Z","dateType":"Submitted","dateInformation":"v1"},{"date":"2026-08-05T00:53:01Z","dateType":"Updated","dateInformation":"v1"},{"date":"2026-08","dateType":"Available","dateInformation":"v1"}],"language":null,"types":{"schemaOrg":"CreativeWork","resourceTypeGeneral":"Preprint","citeproc":"article","bibtex":"misc","ris":"GEN","resourceType":"Article"},"relatedIdentifiers":[],"relatedItems":[],"sizes":[],"formats":[],"version":"1","rightsList":[{"rightsUri":"http://arxiv.org/licenses/nonexclusive-distrib/1.0/","rights":"arXiv.org perpetual, non-exclusive license"}],"descriptions":[{"descriptionType":"Abstract","description":"Near-field beam training is essential for harvesting the high-gain potential of extremely large-scale multiple input multiple output systems. To reduce training overhead, existing works have mostly leveraged the beam squint effect by utilizing time-delay (TD) beamforming with polar-domain codebook, which enables the simultaneous sweeping of multiple angles at a specific distance. However, such methods still suffer from high overhead due to the exhaustive distance searching. To address this challenge, we propose a pattern zooming based near-field wideband beam training with wavenumber-domain codebook. Specifically, we first establish a refined wideband Fourier planewave channel representation, based on which we reveal a pattern zooming effect, where the wavenumber-domain patterns across different subcarriers exhibit frequency-dependent scaling relative to the center frequency. Exploiting this property, we develop a TD-assisted beam sweeping strategy that simultaneously probes multiple wavenumber directions to rapidly acquire the complete wavenumber-domain pattern. Based on the acquired pattern, we further derive exact, approximation-free closed-form expressions that establish a rigorous mapping between the receiver coordinates and the wavenumber-domain pattern, enabling accurate user localization with only a few pilots. Finally, numerical results validate the superiority of our proposed scheme in terms of both beamforming gain and training overhead."},{"descriptionType":"Other","description":"13 pages, 11 figures"}],"geoLocations":[],"fundingReferences":[],"url":"https://arxiv.org/abs/2608.03615","contentUrl":null,"metadataVersion":0,"schemaVersion":"http://datacite.org/schema/kernel-4","source":"mds","isActive":true,"state":"findable","reason":null,"viewCount":0,"downloadCount":0,"referenceCount":0,"citationCount":0,"partCount":0,"partOfCount":0,"versionCount":0,"versionOfCount":0,"created":"2026-08-05T02:17:01Z","registered":"2026-08-05T02:17:02Z","published":null,"updated":"2026-08-05T02:17:02Z"},"relationships":{"client":{"data":{"id":"arxiv.content","type":"clients"}}}},{"id":"10.48550/arxiv.2608.03614","type":"dois","attributes":{"doi":"10.48550/arxiv.2608.03614","identifiers":[{"identifier":"2608.03614","identifierType":"arXiv"}],"creators":[{"nameType":"Personal","givenName":"Seonghoon","familyName":"Yoo","name":"Yoo, Seonghoon","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Sangwoo","familyName":"Park","name":"Park, Sangwoo","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Seok-Hwan","familyName":"Park","name":"Park, Seok-Hwan","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Joonhyuk","familyName":"Kang","name":"Kang, Joonhyuk","affiliation":[],"nameIdentifiers":[]}],"titles":[{"title":"Test-Time Scalable AI-RAN: Inference Time Allocation for Cell-Free MIMO"}],"publisher":"arXiv","container":{},"publicationYear":2026,"subjects":[{"subject":"Signal Processing (eess.SP)","lang":"en","subjectScheme":"arXiv"},{"subject":"FOS: Electrical engineering, electronic engineering, information engineering","subjectScheme":"Fields of Science and Technology (FOS)"}],"contributors":[],"dates":[{"date":"2026-08-04T13:04:42Z","dateType":"Submitted","dateInformation":"v1"},{"date":"2026-08-05T00:52:49Z","dateType":"Updated","dateInformation":"v1"},{"date":"2026-08","dateType":"Available","dateInformation":"v1"}],"language":null,"types":{"schemaOrg":"CreativeWork","resourceTypeGeneral":"Preprint","citeproc":"article","bibtex":"misc","ris":"GEN","resourceType":"Article"},"relatedIdentifiers":[],"relatedItems":[],"sizes":[],"formats":[],"version":"1","rightsList":[{"rightsUri":"http://arxiv.org/licenses/nonexclusive-distrib/1.0/","rights":"arXiv.org perpetual, non-exclusive license"}],"descriptions":[{"descriptionType":"Abstract","description":"Artificial intelligence-enabled radio access networks (AI-RANs) are envisioned to consist of multiple AI-based modules, potentially developed independently by different vendors. In this work, we study AI-RAN-enabled cell-free MIMO systems, with a particular focus on the system implications of modern AI models. Specifically, we focus on the phenomenon of test-time scalability popularized by large language models (LLMs), under which model performance improves as additional computational resources are allocated at testing time. By noting that the optimal amount of additional computational resources for each AI module should in general depend on its interaction with the other modules as well as with the underlying wireless channels, we propose a generic framework that enables optimal resource allocation for each test-time scalable module in cell-free MIMO systems. Experimental results demonstrate the effectiveness of the proposed framework in fully exploiting the potential of test-time scalable AI-RANs in cell-free MIMO systems."}],"geoLocations":[],"fundingReferences":[],"url":"https://arxiv.org/abs/2608.03614","contentUrl":null,"metadataVersion":0,"schemaVersion":"http://datacite.org/schema/kernel-4","source":"mds","isActive":true,"state":"findable","reason":null,"viewCount":0,"downloadCount":0,"referenceCount":0,"citationCount":0,"partCount":0,"partOfCount":0,"versionCount":0,"versionOfCount":0,"created":"2026-08-05T02:16:59Z","registered":"2026-08-05T02:17:00Z","published":null,"updated":"2026-08-05T02:17:00Z"},"relationships":{"client":{"data":{"id":"arxiv.content","type":"clients"}}}},{"id":"10.48550/arxiv.2608.03613","type":"dois","attributes":{"doi":"10.48550/arxiv.2608.03613","identifiers":[{"identifier":"2608.03613","identifierType":"arXiv"}],"creators":[{"nameType":"Personal","givenName":"Mounir","familyName":"Nisse","name":"Nisse, Mounir","affiliation":[],"nameIdentifiers":[]}],"titles":[{"title":"Cusps and nodes of Amoeba Contours"}],"publisher":"arXiv","container":{},"publicationYear":2026,"subjects":[{"subject":"Algebraic Geometry (math.AG)","lang":"en","subjectScheme":"arXiv"},{"subject":"FOS: Mathematics","subjectScheme":"Fields of Science and Technology (FOS)"},{"subject":"14Q30, 14T90, 14P10, 58K05","lang":"en","subjectScheme":"MSC"}],"contributors":[],"dates":[{"date":"2026-08-04T13:04:31Z","dateType":"Submitted","dateInformation":"v1"},{"date":"2026-08-05T00:52:47Z","dateType":"Updated","dateInformation":"v1"},{"date":"2026-08","dateType":"Available","dateInformation":"v1"}],"language":null,"types":{"schemaOrg":"CreativeWork","resourceTypeGeneral":"Preprint","citeproc":"article","bibtex":"misc","ris":"GEN","resourceType":"Article"},"relatedIdentifiers":[],"relatedItems":[],"sizes":[],"formats":[],"version":"1","rightsList":[{"rightsUri":"http://arxiv.org/licenses/nonexclusive-distrib/1.0/","rights":"arXiv.org perpetual, non-exclusive license"}],"descriptions":[{"descriptionType":"Abstract","description":"We establish new Newton-polygon bounds for the singularities of amoeba contours of smooth plane curves. Our cusp estimate refines the degree-four bound of Lang--Shapiro--Shustin, reducing its leading coefficient from $8$ to $4$ while retaining the normalized area, boundary lattice points, and directional widths of the Newton polygon. We also obtain a new multiplicity-sensitive bound for transverse $s$-nodes, with the natural decay factor $1/\\binom{s}{2}$. The proofs combine logarithmic Gauss maps, normalized fiber products, ramification theory, and saturated off-diagonal intersection schemes, revealing the distinct geometric mechanisms governing cusps and multiple nodes."},{"descriptionType":"Other","description":"24 pages and 7 figures. All comments are welcome"}],"geoLocations":[],"fundingReferences":[],"url":"https://arxiv.org/abs/2608.03613","contentUrl":null,"metadataVersion":0,"schemaVersion":"http://datacite.org/schema/kernel-4","source":"mds","isActive":true,"state":"findable","reason":null,"viewCount":0,"downloadCount":0,"referenceCount":0,"citationCount":0,"partCount":0,"partOfCount":0,"versionCount":0,"versionOfCount":0,"created":"2026-08-05T02:16:58Z","registered":"2026-08-05T02:16:59Z","published":null,"updated":"2026-08-05T02:16:59Z"},"relationships":{"client":{"data":{"id":"arxiv.content","type":"clients"}}}},{"id":"10.48550/arxiv.2608.03612","type":"dois","attributes":{"doi":"10.48550/arxiv.2608.03612","identifiers":[{"identifier":"2608.03612","identifierType":"arXiv"}],"creators":[{"nameType":"Personal","givenName":"Qin","familyName":"Lei","name":"Lei, Qin","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Hao","familyName":"Wu","name":"Wu, Hao","affiliation":[],"nameIdentifiers":[]}],"titles":[{"title":"Predictive Enhancement Calibration for Latent Breast MRI Virtual Contrast Enhancement"}],"publisher":"arXiv","container":{},"publicationYear":2026,"subjects":[{"subject":"Image and Video Processing (eess.IV)","lang":"en","subjectScheme":"arXiv"},{"subject":"Computer Vision and Pattern Recognition (cs.CV)","lang":"en","subjectScheme":"arXiv"},{"subject":"FOS: Electrical engineering, electronic engineering, information engineering","subjectScheme":"Fields of Science and Technology (FOS)"},{"subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"}],"contributors":[],"dates":[{"date":"2026-08-04T13:03:09Z","dateType":"Submitted","dateInformation":"v1"},{"date":"2026-08-05T00:52:41Z","dateType":"Updated","dateInformation":"v1"},{"date":"2026-08","dateType":"Available","dateInformation":"v1"}],"language":null,"types":{"schemaOrg":"CreativeWork","resourceTypeGeneral":"Preprint","citeproc":"article","bibtex":"misc","ris":"GEN","resourceType":"Article"},"relatedIdentifiers":[],"relatedItems":[],"sizes":[],"formats":[],"version":"1","rightsList":[{"rightsUri":"http://arxiv.org/licenses/nonexclusive-distrib/1.0/","rights":"arXiv.org perpetual, non-exclusive license"}],"descriptions":[{"descriptionType":"Abstract","description":"Virtual contrast enhancement (VCE) synthesizes enhanced breast MR images from pre-contrast acquisitions. Modern latent generators offer strong image priors, but their bounded natural-image autoencoders conflict with the non-canonical intensity scale of MRI. We show that the upper bound can alter radiomic fidelity before generation, while scaling source and target independently creates a coordinate inconsistency. We propose Predictive Enhancement Calibration (PEC), which represents each pair in a shared, case-adaptive coordinate during training and predicts its unavailable upper endpoint from the pre-contrast image at inference. We integrate PEC with a pretrained FLUX latent flow transformer via parameter-efficient reference conditioning. Target round trips first isolate representation loss before generation; near-matched conditional models then compare PEC with fixed-wide and separate coordinates under comparable training budgets and backbone settings. On the fixed internal MAMA100 development cohort, PEC improves all eight point estimates in this source-only VCE setting, with paired evidence strongest for MSE and LPIPS.\\noindent\\textbf{Code:} https://github.com/tanlei0/pec-breast-mri-vce"},{"descriptionType":"Other","description":"Top-3 submission in the MICCAI 2026 MAMA-Synth Challenge"}],"geoLocations":[],"fundingReferences":[],"url":"https://arxiv.org/abs/2608.03612","contentUrl":null,"metadataVersion":0,"schemaVersion":"http://datacite.org/schema/kernel-4","source":"mds","isActive":true,"state":"findable","reason":null,"viewCount":0,"downloadCount":0,"referenceCount":0,"citationCount":0,"partCount":0,"partOfCount":0,"versionCount":0,"versionOfCount":0,"created":"2026-08-05T02:16:57Z","registered":null,"published":null,"updated":"2026-08-05T02:16:57Z"},"relationships":{"client":{"data":{"id":"arxiv.content","type":"clients"}}}},{"id":"10.48550/arxiv.2608.03609","type":"dois","attributes":{"doi":"10.48550/arxiv.2608.03609","identifiers":[{"identifier":"2608.03609","identifierType":"arXiv"}],"creators":[{"nameType":"Personal","givenName":"Alejandro J.","familyName":"Mercado","name":"Mercado, Alejandro J.","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Alessio","familyName":"Lomuscio","name":"Lomuscio, Alessio","affiliation":[],"nameIdentifiers":[]}],"titles":[{"title":"Formal Verification of Agentic Systems over Operational Data"}],"publisher":"arXiv","container":{},"publicationYear":2026,"subjects":[{"subject":"Artificial Intelligence (cs.AI)","lang":"en","subjectScheme":"arXiv"},{"subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"}],"contributors":[],"dates":[{"date":"2026-08-04T13:01:30Z","dateType":"Submitted","dateInformation":"v1"},{"date":"2026-08-05T00:52:39Z","dateType":"Updated","dateInformation":"v1"},{"date":"2026-08","dateType":"Available","dateInformation":"v1"}],"language":null,"types":{"schemaOrg":"CreativeWork","resourceTypeGeneral":"Preprint","citeproc":"article","bibtex":"misc","ris":"GEN","resourceType":"Article"},"relatedIdentifiers":[],"relatedItems":[],"sizes":[],"formats":[],"version":"1","rightsList":[{"rightsIdentifierScheme":"SPDX","rightsUri":"https://creativecommons.org/licenses/by-nc-nd/4.0/legalcode","schemeUri":"https://spdx.org/licenses/","rights":"Creative Commons Attribution Non Commercial No Derivatives 4.0 International","rightsIdentifier":"cc-by-nc-nd-4.0"}],"descriptions":[{"descriptionType":"Abstract","description":"Agentic systems driven by large language models (LLMs) are increasingly deployed in real-world workflows where they act on persistent operational data. Before deployment, these systems need to be verified against business requirements that govern workflow execution and data evolution. However, existing approaches do not provide such system-level guarantees, as they mainly constrain or analyse behaviour at the agent's interface level. We study here the verification of agentic systems comprising a single LLM and a tool orchestration harness over relational operational data. We formalise them as Stateful Tool-Enabled Agentic Deployments (STEADs), give their semantics, define the problem of verifying them against First-Order Computation Tree Logic (FO-CTL) specifications, and show that it is undecidable. We identify sufficient conditions for exact preservation of FO-CTL specifications under a finite-domain restriction, over which verification is PSPACE-complete. The key requirement is that renaming opaque identifiers in the data must correspondingly rename the selected tool calls. We show that LLM-driven agents can violate this condition and introduce a canonical deployment wrapper that guarantees it for arbitrary base agents while preserving already-equivariant behaviour. We prove that computing canonical representations required by this construction is graph-isomorphism-hard. Finally, we illustrate our framework on an LLM agent orchestrating a case-management workflow."},{"descriptionType":"Other","description":"21 pages, including appendix; 0 figures"}],"geoLocations":[],"fundingReferences":[],"url":"https://arxiv.org/abs/2608.03609","contentUrl":null,"metadataVersion":0,"schemaVersion":"http://datacite.org/schema/kernel-4","source":"mds","isActive":true,"state":"findable","reason":null,"viewCount":0,"downloadCount":0,"referenceCount":0,"citationCount":0,"partCount":0,"partOfCount":0,"versionCount":0,"versionOfCount":0,"created":"2026-08-05T02:16:52Z","registered":null,"published":null,"updated":"2026-08-05T02:16:53Z"},"relationships":{"client":{"data":{"id":"arxiv.content","type":"clients"}}}},{"id":"10.48550/arxiv.2608.03606","type":"dois","attributes":{"doi":"10.48550/arxiv.2608.03606","identifiers":[{"identifier":"2608.03606","identifierType":"arXiv"}],"creators":[{"nameType":"Personal","givenName":"William","familyName":"Bolton","name":"Bolton, William","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Philip","familyName":"Torr","name":"Torr, Philip","affiliation":[],"nameIdentifiers":[]}],"titles":[{"title":"Learning Clinical-Trial Strategy: Offline Policy Training for Decision Agents"}],"publisher":"arXiv","container":{},"publicationYear":2026,"subjects":[{"subject":"Artificial Intelligence (cs.AI)","lang":"en","subjectScheme":"arXiv"},{"subject":"Machine Learning (cs.LG)","lang":"en","subjectScheme":"arXiv"},{"subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"}],"contributors":[],"dates":[{"date":"2026-08-04T12:58:17Z","dateType":"Submitted","dateInformation":"v1"},{"date":"2026-08-05T00:52:30Z","dateType":"Updated","dateInformation":"v1"},{"date":"2026-08","dateType":"Available","dateInformation":"v1"}],"language":null,"types":{"schemaOrg":"CreativeWork","resourceTypeGeneral":"Preprint","citeproc":"article","bibtex":"misc","ris":"GEN","resourceType":"Article"},"relatedIdentifiers":[],"relatedItems":[],"sizes":[],"formats":[],"version":"1","rightsList":[{"rightsIdentifierScheme":"SPDX","rightsUri":"https://creativecommons.org/licenses/by-nc-sa/4.0/legalcode","schemeUri":"https://spdx.org/licenses/","rights":"Creative Commons Attribution Non Commercial Share Alike 4.0 International","rightsIdentifier":"cc-by-nc-sa-4.0"}],"descriptions":[{"descriptionType":"Abstract","description":"Clinical development is sequential decision-making under uncertainty, where a sponsor must plan a portfolio of experiments from heterogeneous evidence. We study this setting by framing oncology clinical development as an offline decision-making problem in which an agent predicts the next six-month trial portfolio of an oncology drug program from information available at the decision date. To support this, we construct a temporal dataset that combines 31.7k heterogeneous public data records, including trial registries, regulatory reviews, sponsor filings, utilization data, and epidemiology, into 881 offline decision episodes across 45 historical programs. We compare four offline objectives: behavioral cloning, reward-weighted behavioral cloning, learned-reward training, and value-based implicit Q-learning against four frontier LLM agents that share a common date-gated retrieval scaffold across held-out drug, sponsor, drug-class, and temporal splits. Models trained offline outperform the non-fine-tuned baselines, particularly in the post-August 2025 contamination-clean holdout. Reward-weighted behavioral cloning performs the best, obtaining 46.2% indication F1 and 14.2% strict F1 against 25.0% and 2.1%, respectively, for the best-performing tool agent on each metric. These results suggest that structured offline learning can teach agents to plan clinical experiments."},{"descriptionType":"Other","description":"Accepted for a spotlight at the ICML 2026 Workshop on Generative and Agentic AI for Biology (GenBio) and as a poster at the ICML 2026 Workshop on Decision-Making from Offline Datasets to Online Adaptation: Black-Box Optimization to Reinforcement Learning (DEMO). 15 pages, 3 figures, 11 tables"}],"geoLocations":[],"fundingReferences":[],"url":"https://arxiv.org/abs/2608.03606","contentUrl":null,"metadataVersion":0,"schemaVersion":"http://datacite.org/schema/kernel-4","source":"mds","isActive":true,"state":"findable","reason":null,"viewCount":0,"downloadCount":0,"referenceCount":0,"citationCount":0,"partCount":0,"partOfCount":0,"versionCount":0,"versionOfCount":0,"created":"2026-08-05T02:16:48Z","registered":"2026-08-05T02:16:49Z","published":null,"updated":"2026-08-05T02:16:49Z"},"relationships":{"client":{"data":{"id":"arxiv.content","type":"clients"}}}},{"id":"10.48550/arxiv.2608.03605","type":"dois","attributes":{"doi":"10.48550/arxiv.2608.03605","identifiers":[{"identifier":"2608.03605","identifierType":"arXiv"}],"creators":[{"nameType":"Personal","givenName":"Shenghui","familyName":"Li","name":"Li, Shenghui","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Thiemo","familyName":"Voigt","name":"Voigt, Thiemo","affiliation":[],"nameIdentifiers":[]}],"titles":[{"title":"FraQ: Efficient Coordinate-Space Recompression for Federated Low-Rank Adaptation"}],"publisher":"arXiv","container":{},"publicationYear":2026,"subjects":[{"subject":"Artificial Intelligence (cs.AI)","lang":"en","subjectScheme":"arXiv"},{"subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"}],"contributors":[],"dates":[{"date":"2026-08-04T12:57:08Z","dateType":"Submitted","dateInformation":"v1"},{"date":"2026-08-05T00:52:29Z","dateType":"Updated","dateInformation":"v1"},{"date":"2026-08","dateType":"Available","dateInformation":"v1"}],"language":null,"types":{"schemaOrg":"CreativeWork","resourceTypeGeneral":"Preprint","citeproc":"article","bibtex":"misc","ris":"GEN","resourceType":"Article"},"relatedIdentifiers":[],"relatedItems":[],"sizes":[],"formats":[],"version":"1","rightsList":[{"rightsUri":"http://arxiv.org/licenses/nonexclusive-distrib/1.0/","rights":"arXiv.org perpetual, non-exclusive license"}],"descriptions":[{"descriptionType":"Abstract","description":"Federated fine-tuning with Low-Rank Adaptation (LoRA) enables efficient collaborative adaptation of Large Language Models (LLMs) without centralizing private data. However, LoRA's two-factor parameterization creates an aggregation mismatch across clients: naively averaging the factors does not recover the average of their induced updates. This mismatch can be avoided by forming the exact aggregate in the full weight space and then recompressing it, but decomposing the resulting dense matrix is computationally expensive and memory-intensive. We propose FraQ, an efficient coordinate-space recompression method for federated LoRA. Starting from stacked factors that exactly represent the aggregate, FraQ factorizes it into an orthonormal basis and a compact coordinate matrix. It then recovers the singular spectrum from a small Gram matrix, selects the smallest rank satisfying a prescribed energy threshold, and maps the selected coordinate subspace back through the basis to construct the global adapter. Experiments on text classification and commonsense reasoning benchmarks show that FraQ achieves accuracy close to uncompressed baselines while substantially reducing downlink communication with low server-side recompression overhead."}],"geoLocations":[],"fundingReferences":[],"url":"https://arxiv.org/abs/2608.03605","contentUrl":null,"metadataVersion":0,"schemaVersion":"http://datacite.org/schema/kernel-4","source":"mds","isActive":true,"state":"findable","reason":null,"viewCount":0,"downloadCount":0,"referenceCount":0,"citationCount":0,"partCount":0,"partOfCount":0,"versionCount":0,"versionOfCount":0,"created":"2026-08-05T02:16:47Z","registered":"2026-08-05T02:16:48Z","published":null,"updated":"2026-08-05T02:16:48Z"},"relationships":{"client":{"data":{"id":"arxiv.content","type":"clients"}}}},{"id":"10.48550/arxiv.2608.03604","type":"dois","attributes":{"doi":"10.48550/arxiv.2608.03604","identifiers":[{"identifier":"2608.03604","identifierType":"arXiv"}],"creators":[{"nameType":"Personal","givenName":"Gabriel","familyName":"Dooley","name":"Dooley, Gabriel","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Camden","familyName":"Kilton","name":"Kilton, Camden","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Brynley","familyName":"Needham","name":"Needham, Brynley","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Graham","familyName":"Walther","name":"Walther, Graham","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Todd R.","familyName":"Young","name":"Young, Todd R.","affiliation":[],"nameIdentifiers":[]}],"titles":[{"title":"Population Structures with Positive Feedback and Asymmetric Division"}],"publisher":"arXiv","container":{},"publicationYear":2026,"subjects":[{"subject":"Cell Behavior (q-bio.CB)","lang":"en","subjectScheme":"arXiv"},{"subject":"Dynamical Systems (math.DS)","lang":"en","subjectScheme":"arXiv"},{"subject":"Quantitative Methods (q-bio.QM)","lang":"en","subjectScheme":"arXiv"},{"subject":"FOS: Biological sciences","subjectScheme":"Fields of Science and Technology (FOS)"},{"subject":"FOS: Mathematics","subjectScheme":"Fields of Science and Technology (FOS)"},{"subject":"92B25, 92D25, 34D20, 37C27","lang":"en","subjectScheme":"MSC"}],"contributors":[],"dates":[{"date":"2026-08-04T12:56:54Z","dateType":"Submitted","dateInformation":"v1"},{"date":"2026-08-05T00:52:28Z","dateType":"Updated","dateInformation":"v1"},{"date":"2026-08","dateType":"Available","dateInformation":"v1"}],"language":null,"types":{"schemaOrg":"CreativeWork","resourceTypeGeneral":"Preprint","citeproc":"article","bibtex":"misc","ris":"GEN","resourceType":"Article"},"relatedIdentifiers":[],"relatedItems":[],"sizes":[],"formats":[],"version":"1","rightsList":[{"rightsIdentifierScheme":"SPDX","rightsUri":"https://creativecommons.org/licenses/by/4.0/legalcode","schemeUri":"https://spdx.org/licenses/","rights":"Creative Commons Attribution 4.0 International","rightsIdentifier":"cc-by-4.0"}],"descriptions":[{"descriptionType":"Abstract","description":"In bioreactor experiments, budding yeast can manifest stable metabolic oscillations. In some instances these oscillations involve the cell cycle and are associated with a dynamical phenomenon called temporal clustering. Since yeast divide asymmetrically, mother cells may be able to divide sooner than the smaller daughter cells. We show that asymmetric division plus positive feedback can result in stable temporal clustering. In this scenario, the cells self-organize into $p$ clusters of mother cells and $q$ clusters of daughter cells, $p \\le q$. In simple numerical simulations of a population model with asymmetric division and positive feedback, we show that $p:q$ periodic arrangements form spontaneously from random populations of cells. Our main result is that these structures can be stable."},{"descriptionType":"Other","description":"24 pages, 8 figures,"}],"geoLocations":[],"fundingReferences":[],"url":"https://arxiv.org/abs/2608.03604","contentUrl":null,"metadataVersion":0,"schemaVersion":"http://datacite.org/schema/kernel-4","source":"mds","isActive":true,"state":"findable","reason":null,"viewCount":0,"downloadCount":0,"referenceCount":0,"citationCount":0,"partCount":0,"partOfCount":0,"versionCount":0,"versionOfCount":0,"created":"2026-08-05T02:16:46Z","registered":"2026-08-05T02:16:46Z","published":null,"updated":"2026-08-05T02:16:46Z"},"relationships":{"client":{"data":{"id":"arxiv.content","type":"clients"}}}},{"id":"10.48550/arxiv.2608.03603","type":"dois","attributes":{"doi":"10.48550/arxiv.2608.03603","identifiers":[{"identifier":"2608.03603","identifierType":"arXiv"}],"creators":[{"nameType":"Personal","givenName":"M. M.","familyName":"Kokurin","name":"Kokurin, M. M.","affiliation":[],"nameIdentifiers":[]}],"titles":[{"title":"Error Estimates for the Iteratively Regularized Gradient Method for Ill-Posed Optimization Problems in a Hilbert Space"}],"publisher":"arXiv","container":{},"publicationYear":2026,"subjects":[{"subject":"Numerical Analysis (math.NA)","lang":"en","subjectScheme":"arXiv"},{"subject":"Optimization and Control (math.OC)","lang":"en","subjectScheme":"arXiv"},{"subject":"FOS: Mathematics","subjectScheme":"Fields of Science and Technology (FOS)"},{"subject":"65K10, 65J20","lang":"en","subjectScheme":"MSC"}],"contributors":[],"dates":[{"date":"2026-08-04T12:55:07Z","dateType":"Submitted","dateInformation":"v1"},{"date":"2026-08-05T00:52:26Z","dateType":"Updated","dateInformation":"v1"},{"date":"2026-08","dateType":"Available","dateInformation":"v1"}],"language":null,"types":{"schemaOrg":"CreativeWork","resourceTypeGeneral":"Preprint","citeproc":"article","bibtex":"misc","ris":"GEN","resourceType":"Article"},"relatedIdentifiers":[],"relatedItems":[],"sizes":[],"formats":[],"version":"1","rightsList":[{"rightsUri":"http://arxiv.org/licenses/nonexclusive-distrib/1.0/","rights":"arXiv.org perpetual, non-exclusive license"}],"descriptions":[{"descriptionType":"Abstract","description":"We study the iteratively regularized gradient method applied to the ill-posed problem of minimizing a general smooth functional on a Hilbert space. Under a source condition on the solution, we establish error estimates for this method when the objective functional is known exactly or only approximately. For these estimates we provide two proofs based on substantially different ideas and compare the assumptions and conclusions of the corresponding theorems. In addition, we present an improved proof of an error estimate for the Tikhonov method applied to ill-posed optimization problems with an exactly known functional. We also prove a theorem on the existence of a global minimizer of the Tikhonov functional without assuming weak lower semicontinuity of the original functional."}],"geoLocations":[],"fundingReferences":[],"url":"https://arxiv.org/abs/2608.03603","contentUrl":null,"metadataVersion":0,"schemaVersion":"http://datacite.org/schema/kernel-4","source":"mds","isActive":true,"state":"findable","reason":null,"viewCount":0,"downloadCount":0,"referenceCount":0,"citationCount":0,"partCount":0,"partOfCount":0,"versionCount":0,"versionOfCount":0,"created":"2026-08-05T02:16:44Z","registered":"2026-08-05T02:16:45Z","published":null,"updated":"2026-08-05T02:16:45Z"},"relationships":{"client":{"data":{"id":"arxiv.content","type":"clients"}}}},{"id":"10.48550/arxiv.2608.03602","type":"dois","attributes":{"doi":"10.48550/arxiv.2608.03602","identifiers":[{"identifier":"2608.03602","identifierType":"arXiv"}],"creators":[{"nameType":"Personal","givenName":"Eugenio","familyName":"Lunedei","name":"Lunedei, Eugenio","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Andrea","familyName":"Liscio","name":"Liscio, Andrea","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Francesco","familyName":"Borgatti","name":"Borgatti, Francesco","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Edoardo","familyName":"Chini","name":"Chini, Edoardo","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Pasquale","familyName":"DAngelo","name":"DAngelo, Pasquale","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Fiorenza","familyName":"Esposito","name":"Esposito, Fiorenza","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Niccolo","familyName":"Borghi","name":"Borghi, Niccolo","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Matteo","familyName":"Mannini","name":"Mannini, Matteo","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Denis","familyName":"Gentili","name":"Gentili, Denis","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Luca","familyName":"Seravalli","name":"Seravalli, Luca","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Massimiliano","familyName":"Cavallini","name":"Cavallini, Massimiliano","affiliation":[],"nameIdentifiers":[]}],"titles":[{"title":"Toward two dimensional MoS2 electrets"}],"publisher":"arXiv","container":{},"publicationYear":2026,"subjects":[{"subject":"Materials Science (cond-mat.mtrl-sci)","lang":"en","subjectScheme":"arXiv"},{"subject":"FOS: Physical sciences","subjectScheme":"Fields of Science and Technology (FOS)"},{"subject":"92-XX","lang":"en","subjectScheme":"MSC"}],"contributors":[],"dates":[{"date":"2026-08-04T12:54:38Z","dateType":"Submitted","dateInformation":"v1"},{"date":"2026-08-05T00:52:25Z","dateType":"Updated","dateInformation":"v1"},{"date":"2026-08","dateType":"Available","dateInformation":"v1"}],"language":null,"types":{"schemaOrg":"CreativeWork","resourceTypeGeneral":"Preprint","citeproc":"article","bibtex":"misc","ris":"GEN","resourceType":"Article"},"relatedIdentifiers":[],"relatedItems":[],"sizes":[],"formats":[],"version":"1","rightsList":[{"rightsUri":"http://arxiv.org/licenses/nonexclusive-distrib/1.0/","rights":"arXiv.org perpetual, non-exclusive license"}],"descriptions":[{"descriptionType":"Abstract","description":"Here, we show that controlled sulfur vacancy engineering converts monolayer MoS2 into an electret, imparting the ability to store quasi-permanent electrostatic charge within a single atomic layer. Sulfur vacancies are generated with submicrometer spatial control by stamp-assisted electrode-free electrochemical nanolithography, yielding programmable defect densities from 10 10 to 10 13 1 cm-2. The resulting vacancy domains act as deep electron traps and produce surface charge densities up to 1 uCcm-2, with charge retention in the order of hundreds days under ambient conditions. Kelvin probe and electric force microscopies directly reveal stable electrostatic patterns that replicate the lithographic motif. The same vacancy landscape simultaneously defines exciton-quenching regions, generating co-localized optical and electrostatic contrast and reducing the apparent exciton lifetime from 15 ns to 180 ps through enhanced nonradiative recombination. The persistence of the optical response over one year identifies sulfur vacancies, rather than transient charge states, as the origin of the patterned functionality. These results establish defect-engineered MoS2 as the first two-dimensional electret and demonstrate that atomic vacancies can be exploited as functional elements for encoding electrostatic and excitonic behavior in a single atomic layer."},{"descriptionType":"Other","description":"27 pages, including Supporting Informations, 9 Figures (4 in the text 5 in Supprting Materials)"}],"geoLocations":[],"fundingReferences":[],"url":"https://arxiv.org/abs/2608.03602","contentUrl":null,"metadataVersion":0,"schemaVersion":"http://datacite.org/schema/kernel-4","source":"mds","isActive":true,"state":"findable","reason":null,"viewCount":0,"downloadCount":0,"referenceCount":0,"citationCount":0,"partCount":0,"partOfCount":0,"versionCount":0,"versionOfCount":0,"created":"2026-08-05T02:16:43Z","registered":null,"published":null,"updated":"2026-08-05T02:16:43Z"},"relationships":{"client":{"data":{"id":"arxiv.content","type":"clients"}}}},{"id":"10.48550/arxiv.2608.03601","type":"dois","attributes":{"doi":"10.48550/arxiv.2608.03601","identifiers":[{"identifier":"2608.03601","identifierType":"arXiv"}],"creators":[{"nameType":"Personal","givenName":"Mounir","familyName":"Nisse","name":"Nisse, Mounir","affiliation":[],"nameIdentifiers":[]}],"titles":[{"title":"Singularities of Amoeba Contours"}],"publisher":"arXiv","container":{},"publicationYear":2026,"subjects":[{"subject":"Algebraic Geometry (math.AG)","lang":"en","subjectScheme":"arXiv"},{"subject":"FOS: Mathematics","subjectScheme":"Fields of Science and Technology (FOS)"},{"subject":"14Q30, 14T90, 14P10, 58K05","lang":"en","subjectScheme":"MSC"}],"contributors":[],"dates":[{"date":"2026-08-04T12:52:21Z","dateType":"Submitted","dateInformation":"v1"},{"date":"2026-08-05T00:52:09Z","dateType":"Updated","dateInformation":"v1"},{"date":"2026-08","dateType":"Available","dateInformation":"v1"}],"language":null,"types":{"schemaOrg":"CreativeWork","resourceTypeGeneral":"Preprint","citeproc":"article","bibtex":"misc","ris":"GEN","resourceType":"Article"},"relatedIdentifiers":[],"relatedItems":[],"sizes":[],"formats":[],"version":"1","rightsList":[{"rightsUri":"http://arxiv.org/licenses/nonexclusive-distrib/1.0/","rights":"arXiv.org perpetual, non-exclusive license"}],"descriptions":[{"descriptionType":"Abstract","description":"We give explicit real-algebraic equations for computing the singularities of amoeba contours, separating degeneracies of the logarithmic critical locus from coincidences of distinct critical lifts. For plane curves, this yields practical systems detecting nodes, cusps, and multiple branches. We also show that maximal sparsity does not maximize contour singularities, even for lattice triangles and parallelograms."},{"descriptionType":"Other","description":"24 pages and 12 figures. All comments are welcome"}],"geoLocations":[],"fundingReferences":[],"url":"https://arxiv.org/abs/2608.03601","contentUrl":null,"metadataVersion":0,"schemaVersion":"http://datacite.org/schema/kernel-4","source":"mds","isActive":true,"state":"findable","reason":null,"viewCount":0,"downloadCount":0,"referenceCount":0,"citationCount":0,"partCount":0,"partOfCount":0,"versionCount":0,"versionOfCount":0,"created":"2026-08-05T02:16:42Z","registered":"2026-08-05T02:16:42Z","published":null,"updated":"2026-08-05T02:16:42Z"},"relationships":{"client":{"data":{"id":"arxiv.content","type":"clients"}}}},{"id":"10.48550/arxiv.2608.03600","type":"dois","attributes":{"doi":"10.48550/arxiv.2608.03600","identifiers":[{"identifier":"2608.03600","identifierType":"arXiv"}],"creators":[{"nameType":"Personal","givenName":"Han","familyName":"Wan","name":"Wan, Han","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Rui","familyName":"Zhang","name":"Zhang, Rui","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Hao","familyName":"Sun","name":"Sun, Hao","affiliation":[],"nameIdentifiers":[]}],"titles":[{"title":"Large language models for partial differential equation workflows"}],"publisher":"arXiv","container":{},"publicationYear":2026,"subjects":[{"subject":"Artificial Intelligence (cs.AI)","lang":"en","subjectScheme":"arXiv"},{"subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"}],"contributors":[],"dates":[{"date":"2026-08-04T12:51:32Z","dateType":"Submitted","dateInformation":"v1"},{"date":"2026-08-05T00:52:06Z","dateType":"Updated","dateInformation":"v1"},{"date":"2026-08","dateType":"Available","dateInformation":"v1"}],"language":null,"types":{"schemaOrg":"CreativeWork","resourceTypeGeneral":"Preprint","citeproc":"article","bibtex":"misc","ris":"GEN","resourceType":"Article"},"relatedIdentifiers":[],"relatedItems":[],"sizes":[],"formats":[],"version":"1","rightsList":[{"rightsIdentifierScheme":"SPDX","rightsUri":"https://creativecommons.org/licenses/by/4.0/legalcode","schemeUri":"https://spdx.org/licenses/","rights":"Creative Commons Attribution 4.0 International","rightsIdentifier":"cc-by-4.0"}],"descriptions":[{"descriptionType":"Abstract","description":"Partial differential equations (PDEs) become actionable in science and engineering not as isolated formulae, but as executable workflows that connect modelling assumptions, governing equations, numerical solvers, diagnostics, and decisions. Large language models (LLMs) are beginning to support such workflows by linking natural language, symbolic mathematics, code, solver outputs, and feedback. Here we examine recent advances in LLM-assisted PDE research across three stages: the discovery and formulation of governing models, the generation and revision of executable numerical solvers, and the use of simulation feedback to support control, design, and optimization. Across these stages, current systems act primarily as workflow-level interfaces. Despite this progress, the field remains limited by the scarcity of high-quality datasets and benchmarks, especially for knowledge discovery and real-world applications, where expert annotation, executable problem construction, and task-level feedback require substantial domain effort. A further challenge is the persistent gap between simulation-based results and real-world scientific and engineering systems, which limits the direct transfer of numerical simulations, control policies, and optimized designs to practical settings. These challenges make LLM-assisted PDE workflows a critical testbed for developing scientific AI systems that can connect language, computation, physical constraints, and real-world decision-making."}],"geoLocations":[],"fundingReferences":[],"url":"https://arxiv.org/abs/2608.03600","contentUrl":null,"metadataVersion":0,"schemaVersion":"http://datacite.org/schema/kernel-4","source":"mds","isActive":true,"state":"findable","reason":null,"viewCount":0,"downloadCount":0,"referenceCount":0,"citationCount":0,"partCount":0,"partOfCount":0,"versionCount":0,"versionOfCount":0,"created":"2026-08-05T02:16:40Z","registered":"2026-08-05T02:16:41Z","published":null,"updated":"2026-08-05T02:16:41Z"},"relationships":{"client":{"data":{"id":"arxiv.content","type":"clients"}}}},{"id":"10.48550/arxiv.2608.03599","type":"dois","attributes":{"doi":"10.48550/arxiv.2608.03599","identifiers":[{"identifier":"2608.03599","identifierType":"arXiv"}],"creators":[{"nameType":"Personal","givenName":"Mykola","familyName":"Haltiuk","name":"Haltiuk, Mykola","affiliation":[],"nameIdentifiers":[]}],"titles":[{"title":"Disentangling Language Modeling and Boundaries"}],"publisher":"arXiv","container":{},"publicationYear":2026,"subjects":[{"subject":"Computation and Language (cs.CL)","lang":"en","subjectScheme":"arXiv"},{"subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"}],"contributors":[],"dates":[{"date":"2026-08-04T12:51:21Z","dateType":"Submitted","dateInformation":"v1"},{"date":"2026-08-05T00:52:05Z","dateType":"Updated","dateInformation":"v1"},{"date":"2026-08","dateType":"Available","dateInformation":"v1"}],"language":null,"types":{"schemaOrg":"CreativeWork","resourceTypeGeneral":"Preprint","citeproc":"article","bibtex":"misc","ris":"GEN","resourceType":"Article"},"relatedIdentifiers":[],"relatedItems":[],"sizes":[],"formats":[],"version":"1","rightsList":[{"rightsIdentifierScheme":"SPDX","rightsUri":"https://creativecommons.org/licenses/by-sa/4.0/legalcode","schemeUri":"https://spdx.org/licenses/","rights":"Creative Commons Attribution Share Alike 4.0 International","rightsIdentifier":"cc-by-sa-4.0"}],"descriptions":[{"descriptionType":"Abstract","description":"Byte-level language models are usually argued for on the grounds of robustness, multilingual fairness, and character-level skills. We point to a different, structural advantage: because they read and write bytes, any two of them share an output space, so knowledge transfer between them is exact and independent of how either was originally tokenized. We hypothesize that the two distributions a byte-level model produces, one over the next byte, one over where its patch boundaries fall, can be disentangled and changed almost independently. A model could absorb a teacher's capability while keeping its own boundaries, or change how it places those boundaries while keeping its capabilities. We lay out the two experiments that would settle the hypothesis, alongside preliminary measurements of the properties they rest on. We argue that the community should move toward a byte-level interface as a shared standard: if the hypothesis holds, then once byte-level models are the norm, transferring capabilities and reshaping boundaries between them become cheap and routine, free of the per-model tokenizer that blocks them today."}],"geoLocations":[],"fundingReferences":[],"url":"https://arxiv.org/abs/2608.03599","contentUrl":null,"metadataVersion":0,"schemaVersion":"http://datacite.org/schema/kernel-4","source":"mds","isActive":true,"state":"findable","reason":null,"viewCount":0,"downloadCount":0,"referenceCount":0,"citationCount":0,"partCount":0,"partOfCount":0,"versionCount":0,"versionOfCount":0,"created":"2026-08-05T02:16:39Z","registered":"2026-08-05T02:16:40Z","published":null,"updated":"2026-08-05T02:16:40Z"},"relationships":{"client":{"data":{"id":"arxiv.content","type":"clients"}}}},{"id":"10.48550/arxiv.2608.03598","type":"dois","attributes":{"doi":"10.48550/arxiv.2608.03598","identifiers":[{"identifier":"2608.03598","identifierType":"arXiv"}],"creators":[{"nameType":"Personal","givenName":"Cunming","familyName":"Zhang","name":"Zhang, Cunming","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Yu","familyName":"Pei","name":"Pei, Yu","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Michail","familyName":"Papadakis","name":"Papadakis, Michail","affiliation":[],"nameIdentifiers":[]}],"titles":[{"title":"From Bug Reports to Browser-Executable Procedures: An LLM-Driven Agent for Web GUI Bug Reproduction"}],"publisher":"arXiv","container":{},"publicationYear":2026,"subjects":[{"subject":"Software Engineering (cs.SE)","lang":"en","subjectScheme":"arXiv"},{"subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"}],"contributors":[],"dates":[{"date":"2026-08-04T12:50:43Z","dateType":"Submitted","dateInformation":"v1"},{"date":"2026-08-05T00:52:02Z","dateType":"Updated","dateInformation":"v1"},{"date":"2026-08","dateType":"Available","dateInformation":"v1"}],"language":null,"types":{"schemaOrg":"CreativeWork","resourceTypeGeneral":"Preprint","citeproc":"article","bibtex":"misc","ris":"GEN","resourceType":"Article"},"relatedIdentifiers":[],"relatedItems":[],"sizes":[],"formats":[],"version":"1","rightsList":[{"rightsUri":"http://arxiv.org/licenses/nonexclusive-distrib/1.0/","rights":"arXiv.org perpetual, non-exclusive license"}],"descriptions":[{"descriptionType":"Abstract","description":"Reproducing web GUI bugs from natural-language bug reports is critical for software maintenance, but remains difficult because reports often lack prerequisites such as dependencies and input files. Existing bug reproduction techniques mainly target code units or mobile applications and lack end-to-end visual execution and validation for web GUIs. We present ReBug, a context-aware agent system that reconstructs, executes, and validates browser-level reproduction procedures from web GUI bug reports by driving a real browser. ReBug separates reproduction into two stages. In the preparation stage, ReBug reconstructs missing prerequisites from the report and available artifacts, and it produces a high-level reproduction plan. In the execution stage, it performs tool-mediated interactions in the browser, maintains structured summaries of page state and action history, and validates the final state against expectations derived from the report. We evaluate ReBug on 667 real-world bug reports from four open-source web applications. On controlled current deployments, ReBug outperforms both baselines, achieving an average RSR of 49.96%, a mean task completion rate of 74.96%, and a mean action execution success rate of 86.54%. Our results show that explicit context reconstruction and state-aware browser execution effectively support report-derived browser reproduction, while historical replay shows that successful procedures often expose the original bug-present behavior on restored buggy versions."},{"descriptionType":"Other","description":"13 pages, 1 figure"}],"geoLocations":[],"fundingReferences":[],"url":"https://arxiv.org/abs/2608.03598","contentUrl":null,"metadataVersion":0,"schemaVersion":"http://datacite.org/schema/kernel-4","source":"mds","isActive":true,"state":"findable","reason":null,"viewCount":0,"downloadCount":0,"referenceCount":0,"citationCount":0,"partCount":0,"partOfCount":0,"versionCount":0,"versionOfCount":0,"created":"2026-08-05T02:16:38Z","registered":null,"published":null,"updated":"2026-08-05T02:16:38Z"},"relationships":{"client":{"data":{"id":"arxiv.content","type":"clients"}}}},{"id":"10.48550/arxiv.2608.03597","type":"dois","attributes":{"doi":"10.48550/arxiv.2608.03597","identifiers":[{"identifier":"2608.03597","identifierType":"arXiv"}],"creators":[{"nameType":"Personal","givenName":"Amirhossein","familyName":"Taleshinosrati","name":"Taleshinosrati, Amirhossein","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Yangyang","familyName":"Wang","name":"Wang, Yangyang","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Atitaya","familyName":"Phoemsuk","name":"Phoemsuk, Atitaya","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Vahid","familyName":"Abolghasemi","name":"Abolghasemi, Vahid","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Naser Hossein","familyName":"Motlagh","name":"Motlagh, Naser Hossein","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Sadasivan","familyName":"Puthusserypady","name":"Puthusserypady, Sadasivan","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Daniel","familyName":"Teichmann","name":"Teichmann, Daniel","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Abdolrahman","familyName":"Peimankar","name":"Peimankar, Abdolrahman","affiliation":[],"nameIdentifiers":[]}],"titles":[{"title":"FOUND-AF: Benchmarking ECG Foundation Models for Atrial Fibrillation Detection"}],"publisher":"arXiv","container":{},"publicationYear":2026,"subjects":[{"subject":"Artificial Intelligence (cs.AI)","lang":"en","subjectScheme":"arXiv"},{"subject":"Machine Learning (cs.LG)","lang":"en","subjectScheme":"arXiv"},{"subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"},{"subject":"I.2.1; I.5.4","lang":"en","subjectScheme":"ACM"},{"subject":"68T07","lang":"en","subjectScheme":"MSC"}],"contributors":[],"dates":[{"date":"2026-08-04T12:48:05Z","dateType":"Submitted","dateInformation":"v1"},{"date":"2026-08-05T00:51:48Z","dateType":"Updated","dateInformation":"v1"},{"date":"2026-08","dateType":"Available","dateInformation":"v1"}],"language":null,"types":{"schemaOrg":"CreativeWork","resourceTypeGeneral":"Preprint","citeproc":"article","bibtex":"misc","ris":"GEN","resourceType":"Article"},"relatedIdentifiers":[],"relatedItems":[],"sizes":[],"formats":[],"version":"1","rightsList":[{"rightsUri":"http://arxiv.org/licenses/nonexclusive-distrib/1.0/","rights":"arXiv.org perpetual, non-exclusive license"}],"descriptions":[{"descriptionType":"Abstract","description":"Atrial fibrillation (AF) is the most common sustained cardiac arrhythmia and is associated with increased risks of stroke, heart failure, and mortality. Recent ECG foundation models offer transferable representations for automated AF detection. However, their relative effectiveness remains unclear because existing studies use different datasets, preprocessing procedures, classifiers, and validation protocols. This study presents FOUND-AF, a unified, leakage-controlled, and deployment-oriented benchmarking framework that evaluates the quality of pretrained ECG representations under identical experimental conditions. Nine publicly available foundation models from five families, including HuBERT-ECG, CLEF, ST-MEM, ECG-JEPA, and ECGFounder, were evaluated across four heterogeneous ECG datasets, namely AFDB, CinC2017, CPSC2021, and LTAFDB. All models were used as frozen feature extractors with standardized preprocessing, model-native resampling, a fixed XGBoost classifier, and recording-level grouped cross-validation. The evaluation included classification metrics, receiver operating characteristic analysis, paired recording-level bootstrap comparisons with Holm correction, embedding-space visualization, and computational efficiency profiling. The ECGFounder model consistently achieved the strongest overall performance across datasets while offering a favorable trade-off between accuracy, model size, inference time, and memory usage. FOUND-AF therefore provides a reproducible framework for selecting ECG foundation models and demonstrates that compact, clinically pretrained encoders can support robust and computationally efficient AF detection across heterogeneous acquisition settings."}],"geoLocations":[],"fundingReferences":[],"url":"https://arxiv.org/abs/2608.03597","contentUrl":null,"metadataVersion":0,"schemaVersion":"http://datacite.org/schema/kernel-4","source":"mds","isActive":true,"state":"findable","reason":null,"viewCount":0,"downloadCount":0,"referenceCount":0,"citationCount":0,"partCount":0,"partOfCount":0,"versionCount":0,"versionOfCount":0,"created":"2026-08-05T02:16:36Z","registered":"2026-08-05T02:16:37Z","published":null,"updated":"2026-08-05T02:16:37Z"},"relationships":{"client":{"data":{"id":"arxiv.content","type":"clients"}}}},{"id":"10.48550/arxiv.2608.03596","type":"dois","attributes":{"doi":"10.48550/arxiv.2608.03596","identifiers":[{"identifier":"2608.03596","identifierType":"arXiv"}],"creators":[{"nameType":"Personal","givenName":"David G.","familyName":"Russell","name":"Russell, David G.","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Olivier J.","familyName":"Walther","name":"Walther, Olivier J.","affiliation":[],"nameIdentifiers":[]}],"titles":[{"title":"Transnational political violence in African borderlands"}],"publisher":"arXiv","container":{},"publicationYear":2026,"subjects":[{"subject":"General Economics (econ.GN)","lang":"en","subjectScheme":"arXiv"},{"subject":"FOS: Economics and business","subjectScheme":"Fields of Science and Technology (FOS)"}],"contributors":[],"dates":[{"date":"2026-08-04T12:47:48Z","dateType":"Submitted","dateInformation":"v1"},{"date":"2026-08-05T00:51:47Z","dateType":"Updated","dateInformation":"v1"},{"date":"2026-08","dateType":"Available","dateInformation":"v1"}],"language":null,"types":{"schemaOrg":"CreativeWork","resourceTypeGeneral":"Preprint","citeproc":"article","bibtex":"misc","ris":"GEN","resourceType":"Article"},"relatedIdentifiers":[{"relationType":"IsVersionOf","relatedIdentifier":"10.4324/9781003519775","relatedIdentifierType":"DOI"}],"relatedItems":[],"sizes":[],"formats":[],"version":"1","rightsList":[{"rightsIdentifierScheme":"SPDX","rightsUri":"https://creativecommons.org/licenses/by-nc-nd/4.0/legalcode","schemeUri":"https://spdx.org/licenses/","rights":"Creative Commons Attribution Non Commercial No Derivatives 4.0 International","rightsIdentifier":"cc-by-nc-nd-4.0"}],"descriptions":[{"descriptionType":"Abstract","description":"This paper examines the relationship between borderlands and political violence in Africa. Using spatiotemporal data on conflict events from 1997 to 2024 alongside the innovative OECD Spatial Conflict Dynamics indicator (SCDi), it suggests that borderlands see more conflict than non-borderlands. Political violence tends to decrease very rapidly with the distance to borders in Africa. The share of violent events recorded in borderlands varies over time and mirrors the cycles of violence that affect specific regions. It was very high in the early 2000s due to the wars in the Gulf of Guinea and Great Lakes region, declined for less than a decade, and increased substantially in the 2010s. Finally, the paper shows that when conflicts diffuse across borders, they tend to occupy a greater spatial extent, rather than relocate from one side of the border to the other."}],"geoLocations":[],"fundingReferences":[],"url":"https://arxiv.org/abs/2608.03596","contentUrl":null,"metadataVersion":0,"schemaVersion":"http://datacite.org/schema/kernel-4","source":"mds","isActive":true,"state":"findable","reason":null,"viewCount":0,"downloadCount":0,"referenceCount":0,"citationCount":0,"partCount":0,"partOfCount":0,"versionCount":0,"versionOfCount":1,"created":"2026-08-05T02:16:35Z","registered":"2026-08-05T02:16:36Z","published":null,"updated":"2026-08-05T02:16:36Z"},"relationships":{"client":{"data":{"id":"arxiv.content","type":"clients"}}}},{"id":"10.48550/arxiv.2608.03595","type":"dois","attributes":{"doi":"10.48550/arxiv.2608.03595","identifiers":[{"identifier":"2608.03595","identifierType":"arXiv"}],"creators":[{"nameType":"Personal","givenName":"B.","familyName":"Greenfeld","name":"Greenfeld, B.","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"L.","familyName":"Vendramin","name":"Vendramin, L.","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"S.","familyName":"Venkatesh","name":"Venkatesh, S.","affiliation":[],"nameIdentifiers":[]}],"titles":[{"title":"Point modules of Nichols algebras over non-abelian groups"}],"publisher":"arXiv","container":{},"publicationYear":2026,"subjects":[{"subject":"Quantum Algebra (math.QA)","lang":"en","subjectScheme":"arXiv"},{"subject":"Rings and Algebras (math.RA)","lang":"en","subjectScheme":"arXiv"},{"subject":"FOS: Mathematics","subjectScheme":"Fields of Science and Technology (FOS)"}],"contributors":[],"dates":[{"date":"2026-08-04T12:46:55Z","dateType":"Submitted","dateInformation":"v1"},{"date":"2026-08-05T00:51:46Z","dateType":"Updated","dateInformation":"v1"},{"date":"2026-08","dateType":"Available","dateInformation":"v1"}],"language":null,"types":{"schemaOrg":"CreativeWork","resourceTypeGeneral":"Preprint","citeproc":"article","bibtex":"misc","ris":"GEN","resourceType":"Article"},"relatedIdentifiers":[],"relatedItems":[],"sizes":[],"formats":[],"version":"1","rightsList":[{"rightsUri":"http://arxiv.org/licenses/nonexclusive-distrib/1.0/","rights":"arXiv.org perpetual, non-exclusive license"}],"descriptions":[{"descriptionType":"Abstract","description":"Nichols algebras are among the most important and mysterious objects in quantum algebra. We continue the systematic program of studying them through their point modules. We study truncated point modules of Nichols algebras associated with racks and 2-cocycles over non-abelian groups. We determine the truncated point spaces for all currently known finite-dimensional Nichols algebras arising from simple Yetter-Drinfeld modules over groups. In particular, for all such algebras the space of 3-truncated point modules is empty. We further find all truncated point modules for other important families, including affine racks equipped with the constant 2-cocycle -1, and for the non-trivial indecomposable rack of size three with the constant 2-cocycle a cubic root of one."},{"descriptionType":"Other","description":"29 pages"}],"geoLocations":[],"fundingReferences":[],"url":"https://arxiv.org/abs/2608.03595","contentUrl":null,"metadataVersion":0,"schemaVersion":"http://datacite.org/schema/kernel-4","source":"mds","isActive":true,"state":"findable","reason":null,"viewCount":0,"downloadCount":0,"referenceCount":0,"citationCount":0,"partCount":0,"partOfCount":0,"versionCount":0,"versionOfCount":0,"created":"2026-08-05T02:16:34Z","registered":null,"published":null,"updated":"2026-08-05T02:16:34Z"},"relationships":{"client":{"data":{"id":"arxiv.content","type":"clients"}}}},{"id":"10.48550/arxiv.2608.03594","type":"dois","attributes":{"doi":"10.48550/arxiv.2608.03594","identifiers":[{"identifier":"2608.03594","identifierType":"arXiv"}],"creators":[{"nameType":"Personal","givenName":"Justin","familyName":"Arches","name":"Arches, Justin","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Emmanuel","familyName":"Fleurantin","name":"Fleurantin, Emmanuel","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Matt","familyName":"Holzer","name":"Holzer, Matt","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Siddhant","familyName":"Sood","name":"Sood, Siddhant","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Shakeeb","familyName":"Uddin","name":"Uddin, Shakeeb","affiliation":[],"nameIdentifiers":[]}],"titles":[{"title":"Predicting the occurrence of Braess paradox in the synchronization threshold of coupled oscillator systems"}],"publisher":"arXiv","container":{},"publicationYear":2026,"subjects":[{"subject":"Dynamical Systems (math.DS)","lang":"en","subjectScheme":"arXiv"},{"subject":"Adaptation and Self-Organizing Systems (nlin.AO)","lang":"en","subjectScheme":"arXiv"},{"subject":"FOS: Mathematics","subjectScheme":"Fields of Science and Technology (FOS)"},{"subject":"FOS: Physical sciences","subjectScheme":"Fields of Science and Technology (FOS)"}],"contributors":[],"dates":[{"date":"2026-08-04T12:46:27Z","dateType":"Submitted","dateInformation":"v1"},{"date":"2026-08-05T00:51:45Z","dateType":"Updated","dateInformation":"v1"},{"date":"2026-08","dateType":"Available","dateInformation":"v1"}],"language":null,"types":{"schemaOrg":"CreativeWork","resourceTypeGeneral":"Preprint","citeproc":"article","bibtex":"misc","ris":"GEN","resourceType":"Article"},"relatedIdentifiers":[],"relatedItems":[],"sizes":[],"formats":[],"version":"1","rightsList":[{"rightsUri":"http://arxiv.org/licenses/nonexclusive-distrib/1.0/","rights":"arXiv.org perpetual, non-exclusive license"}],"descriptions":[{"descriptionType":"Abstract","description":"We study Braess-type paradoxes in coupled oscillator networks where the addition of an edge to the network leads to an increase in the critical coupling required for the existence of a stable phase-locked synchronized solution. By introducing a continuous edge-weight parameter and constructing an augmented system that allows application of the Implicit Function Theorem, we derive an explicit first-order formula for the sensitivity of the critical coupling, $K'_c(0)$, to small changes in the network structure. This formula reveals that an edge is locally Braess if the ordering of the oscillators being coupled is opposite the ordering of their components in the critical eigenvector at the saddle-node bifurcation, providing a simple criterion for Braess paradox to occur. We then employ this local approximation as a predictor for the occurrence of Braess paradox when the edge is fully incorporated in the network. This prediction is tested numerically in several classes of random networks, demonstrating both high predictive fidelity and the nonlinear limitations of the local approximation. We also examine several explicit examples, highlighting possible motifs by which Braess-type paradoxes occur. Together, these results establish a predictive framework for understanding how incremental changes in network topology can produce counterintuitive synchronization outcomes."}],"geoLocations":[],"fundingReferences":[],"url":"https://arxiv.org/abs/2608.03594","contentUrl":null,"metadataVersion":0,"schemaVersion":"http://datacite.org/schema/kernel-4","source":"mds","isActive":true,"state":"findable","reason":null,"viewCount":0,"downloadCount":0,"referenceCount":0,"citationCount":0,"partCount":0,"partOfCount":0,"versionCount":0,"versionOfCount":0,"created":"2026-08-05T02:16:32Z","registered":"2026-08-05T02:16:33Z","published":null,"updated":"2026-08-05T02:16:33Z"},"relationships":{"client":{"data":{"id":"arxiv.content","type":"clients"}}}},{"id":"10.48550/arxiv.2608.03591","type":"dois","attributes":{"doi":"10.48550/arxiv.2608.03591","identifiers":[{"identifier":"2608.03591","identifierType":"arXiv"}],"creators":[{"nameType":"Personal","givenName":"Xuyang","familyName":"Liu","name":"Liu, Xuyang","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Yibin","familyName":"Han","name":"Han, Yibin","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Zhenwei","familyName":"Zhang","name":"Zhang, Zhenwei","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Kai","familyName":"Chang","name":"Chang, Kai","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Zhiwei","familyName":"Xu","name":"Xu, Zhiwei","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Tian","familyName":"Qiu","name":"Qiu, Tian","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Weixian","familyName":"Deng","name":"Deng, Weixian","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Jiabao","familyName":"Gao","name":"Gao, Jiabao","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Xiaolin","familyName":"Peng","name":"Peng, Xiaolin","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Hai","familyName":"Wan","name":"Wan, Hai","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Xibin","familyName":"Zhao","name":"Zhao, Xibin","affiliation":[],"nameIdentifiers":[]}],"titles":[{"title":"DiagChain: A Diagnostic Benchmark for Evaluating LLM Agents on Evidence-Grounded Attack Chain Reconstruction"}],"publisher":"arXiv","container":{},"publicationYear":2026,"subjects":[{"subject":"Cryptography and Security (cs.CR)","lang":"en","subjectScheme":"arXiv"},{"subject":"Artificial Intelligence (cs.AI)","lang":"en","subjectScheme":"arXiv"},{"subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"}],"contributors":[],"dates":[{"date":"2026-08-04T12:43:47Z","dateType":"Submitted","dateInformation":"v1"},{"date":"2026-08-05T00:51:35Z","dateType":"Updated","dateInformation":"v1"},{"date":"2026-08","dateType":"Available","dateInformation":"v1"}],"language":null,"types":{"schemaOrg":"CreativeWork","resourceTypeGeneral":"Preprint","citeproc":"article","bibtex":"misc","ris":"GEN","resourceType":"Article"},"relatedIdentifiers":[],"relatedItems":[],"sizes":[],"formats":[],"version":"1","rightsList":[{"rightsIdentifierScheme":"SPDX","rightsUri":"https://creativecommons.org/licenses/by/4.0/legalcode","schemeUri":"https://spdx.org/licenses/","rights":"Creative Commons Attribution 4.0 International","rightsIdentifier":"cc-by-4.0"}],"descriptions":[{"descriptionType":"Abstract","description":"Large Language Model (LLM) agents offer a promising approach to attack chain reconstruction by retrieving and interpreting heterogeneous telemetry to infer ordered attacker actions. However, existing benchmarks mainly evaluate final outputs or aggregate accuracy, providing limited insight into how errors arise and propagate across intermediate reasoning stages. We present DiagChain, a diagnostic benchmark for evidence-grounded attack chain reconstruction that enables stage-wise evaluation of LLM agents. DiagChain includes MAIN-69, a suite of 69 scenarios spanning multiple operating systems, evidence noise levels, and chain lengths. It further introduces Evidence-Centric Retrieval-Augmented Generation (ECRAG), which couples evidence retrieval with an evolving structured representation of the reconstructed chain. Five complementary metrics are introduced to assess distinct stages of the reconstruction process and support systematic failure diagnosis. Based on evaluations using 6 LLMs, DiagChain reveals that even the strongest configuration succeeds on only 39.6% of the 849 reference steps in MAIN-69. Our analysis further shows that smaller models struggle with the more basic task of incorporating retrieved evidence into their outputs, whereas larger models can proceed to later steps, where correctly ordering that evidence becomes the main bottleneck. These results validate the importance of diagnostic evaluation beyond end-to-end accuracy and provide actionable insights for improving evidence-grounded cybersecurity agents."}],"geoLocations":[],"fundingReferences":[],"url":"https://arxiv.org/abs/2608.03591","contentUrl":null,"metadataVersion":0,"schemaVersion":"http://datacite.org/schema/kernel-4","source":"mds","isActive":true,"state":"findable","reason":null,"viewCount":0,"downloadCount":0,"referenceCount":0,"citationCount":0,"partCount":0,"partOfCount":0,"versionCount":0,"versionOfCount":0,"created":"2026-08-05T02:16:28Z","registered":null,"published":null,"updated":"2026-08-05T02:16:29Z"},"relationships":{"client":{"data":{"id":"arxiv.content","type":"clients"}}}},{"id":"10.48550/arxiv.2608.03590","type":"dois","attributes":{"doi":"10.48550/arxiv.2608.03590","identifiers":[{"identifier":"2608.03590","identifierType":"arXiv"}],"creators":[{"nameType":"Personal","givenName":"Di","familyName":"Wang","name":"Wang, Di","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Yue","familyName":"Cao","name":"Cao, Yue","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Fei","familyName":"Yan","name":"Yan, Fei","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Yining","familyName":"Liu","name":"Liu, Yining","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Daxin","familyName":"Tian","name":"Tian, Daxin","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Yuan","familyName":"Zhuang","name":"Zhuang, Yuan","affiliation":[],"nameIdentifiers":[]}],"titles":[{"title":"Secure Long-Range Autonomous Valet Parking: A Reservation Scheme With Three-Factor Authentication and Key Agreement"}],"publisher":"arXiv","container":{},"publicationYear":2026,"subjects":[{"subject":"Cryptography and Security (cs.CR)","lang":"en","subjectScheme":"arXiv"},{"subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"}],"contributors":[],"dates":[{"date":"2026-08-04T12:43:24Z","dateType":"Submitted","dateInformation":"v1"},{"date":"2026-08-05T00:51:32Z","dateType":"Updated","dateInformation":"v1"},{"date":"2026-08","dateType":"Available","dateInformation":"v1"}],"language":null,"types":{"schemaOrg":"CreativeWork","resourceTypeGeneral":"Preprint","citeproc":"article","bibtex":"misc","ris":"GEN","resourceType":"Article"},"relatedIdentifiers":[],"relatedItems":[],"sizes":[],"formats":[],"version":"1","rightsList":[{"rightsUri":"http://arxiv.org/licenses/nonexclusive-distrib/1.0/","rights":"arXiv.org perpetual, non-exclusive license"}],"descriptions":[{"descriptionType":"Abstract","description":"Long-range autonomous valet parking (LAVP) is increasingly adopted to alleviate traffic congestion and parking difficulties. For large-scale parking demand, reservation can improve parking management. However, existing schemes mainly focus on parking request verification and parking check-in, and do not adequately protect identity legitimacy and communication security during passenger drop-off and pick-up. To address this problem, we propose SecLAVP, a provably secure three-factor authentication and key agreement protocol for LAVP reservation services. SecLAVP combines passwords, biometrics, and smart cards. With assistance from the drop-off/pick-up point (DP), the passenger and the autonomous vehicle (AV) achieve mutual authentication and establish a session key for secure communication. In the Real-Or-Random (ROR) model, we formally prove that SecLAVP provides session-key security. AVISPA simulations show that SecLAVP resists man-in-the-middle attacks, while informal analysis demonstrates that it satisfies 15 defined security goals. Finally, performance evaluation in terms of communication overhead, computational overhead, and scheduling shows that SecLAVP is feasible for practical deployment."}],"geoLocations":[],"fundingReferences":[],"url":"https://arxiv.org/abs/2608.03590","contentUrl":null,"metadataVersion":0,"schemaVersion":"http://datacite.org/schema/kernel-4","source":"mds","isActive":true,"state":"findable","reason":null,"viewCount":0,"downloadCount":0,"referenceCount":0,"citationCount":0,"partCount":0,"partOfCount":0,"versionCount":0,"versionOfCount":0,"created":"2026-08-05T02:16:27Z","registered":"2026-08-05T02:16:28Z","published":null,"updated":"2026-08-05T02:16:28Z"},"relationships":{"client":{"data":{"id":"arxiv.content","type":"clients"}}}},{"id":"10.48550/arxiv.2608.03589","type":"dois","attributes":{"doi":"10.48550/arxiv.2608.03589","identifiers":[{"identifier":"2608.03589","identifierType":"arXiv"}],"creators":[{"nameType":"Personal","givenName":"Jakob","familyName":"Schubert","name":"Schubert, Jakob","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Maximilian","familyName":"Kasper","name":"Kasper, Maximilian","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Maximilian","familyName":"Linke","name":"Linke, Maximilian","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Benedict","familyName":"Herzog","name":"Herzog, Benedict","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Mark","familyName":"Deutel","name":"Deutel, Mark","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Axel","familyName":"Plinge","name":"Plinge, Axel","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Dominik","familyName":"Seuss","name":"Seuss, Dominik","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Christopher","familyName":"Mutschler","name":"Mutschler, Christopher","affiliation":[],"nameIdentifiers":[]}],"titles":[{"title":"Design-Time Optimization of Deep Neural Networks for Intermittent Learning on Microcontrollers"}],"publisher":"arXiv","container":{},"publicationYear":2026,"subjects":[{"subject":"Machine Learning (cs.LG)","lang":"en","subjectScheme":"arXiv"},{"subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"}],"contributors":[],"dates":[{"date":"2026-08-04T12:43:19Z","dateType":"Submitted","dateInformation":"v1"},{"date":"2026-08-05T00:51:31Z","dateType":"Updated","dateInformation":"v1"},{"date":"2026-08","dateType":"Available","dateInformation":"v1"}],"language":null,"types":{"schemaOrg":"CreativeWork","resourceTypeGeneral":"Preprint","citeproc":"article","bibtex":"misc","ris":"GEN","resourceType":"Article"},"relatedIdentifiers":[],"relatedItems":[],"sizes":[],"formats":[],"version":"1","rightsList":[{"rightsIdentifierScheme":"SPDX","rightsUri":"https://creativecommons.org/licenses/by/4.0/legalcode","schemeUri":"https://spdx.org/licenses/","rights":"Creative Commons Attribution 4.0 International","rightsIdentifier":"cc-by-4.0"}],"descriptions":[{"descriptionType":"Abstract","description":"We present a method for designing deep neural networks (DNNs) for intermittent, energy-autonomous, on-device learning on microcontroller units (MCUs). In mobile applications where the energy can run out, e.g., when solar-powered, executing artificial intelligence (AI) faces a technical issue as learning can be interrupted at any time. Our approach combines a hardware-aware energy prediction model with multi-objective optimization (MOO), enabling offline DNN optimization at the design stage without repeated deployment and online testing on the target MCU. Our proposed energy predictor estimates per-layer energy consumption for both DNN inference and training, including the intermittent checkpointing overhead, based on implementation-specific compute and memory features extracted from the DNN model. We validate our approach using autoencoders for anomaly detection on a Cortex-M4 MCU, where our predictor achieves a weighted absolute percentage error of 16.6%, which is sufficient for reliable architecture selection under intermittency constraints. As a result, this work bridges the gap between MOO, automated DNN design, deployment on energy-harvesting systems, and intermittent learning, truly enabling autonomous AI at the edge."},{"descriptionType":"Other","description":"Accepted at the 7th Workshop on IoT, Edge, and Mobile for Embedded Machine Learning (ITEM) collocated with ECML PKDD 2026, 12 pages, 5 figures, 1 table,"}],"geoLocations":[],"fundingReferences":[],"url":"https://arxiv.org/abs/2608.03589","contentUrl":null,"metadataVersion":0,"schemaVersion":"http://datacite.org/schema/kernel-4","source":"mds","isActive":true,"state":"findable","reason":null,"viewCount":0,"downloadCount":0,"referenceCount":0,"citationCount":0,"partCount":0,"partOfCount":0,"versionCount":0,"versionOfCount":0,"created":"2026-08-05T02:16:26Z","registered":"2026-08-05T02:16:26Z","published":null,"updated":"2026-08-05T02:16:26Z"},"relationships":{"client":{"data":{"id":"arxiv.content","type":"clients"}}}},{"id":"10.48550/arxiv.2608.03588","type":"dois","attributes":{"doi":"10.48550/arxiv.2608.03588","identifiers":[{"identifier":"2608.03588","identifierType":"arXiv"}],"creators":[{"nameType":"Personal","givenName":"Corrado","familyName":"Priami","name":"Priami, Corrado","affiliation":[],"nameIdentifiers":[]}],"titles":[{"title":"GenOS: Compositional Certificates for Semantic Robustness in AI Code Generation"}],"publisher":"arXiv","container":{},"publicationYear":2026,"subjects":[{"subject":"Programming Languages (cs.PL)","lang":"en","subjectScheme":"arXiv"},{"subject":"Artificial Intelligence (cs.AI)","lang":"en","subjectScheme":"arXiv"},{"subject":"Software Engineering (cs.SE)","lang":"en","subjectScheme":"arXiv"},{"subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"},{"subject":"F.3.2; F.3.1; D.2.4; I.2.2","lang":"en","subjectScheme":"ACM"}],"contributors":[],"dates":[{"date":"2026-08-04T12:42:11Z","dateType":"Submitted","dateInformation":"v1"},{"date":"2026-08-05T00:51:19Z","dateType":"Updated","dateInformation":"v1"},{"date":"2026-08","dateType":"Available","dateInformation":"v1"}],"language":null,"types":{"schemaOrg":"CreativeWork","resourceTypeGeneral":"Preprint","citeproc":"article","bibtex":"misc","ris":"GEN","resourceType":"Article"},"relatedIdentifiers":[],"relatedItems":[],"sizes":[],"formats":[],"version":"1","rightsList":[{"rightsUri":"http://arxiv.org/licenses/nonexclusive-distrib/1.0/","rights":"arXiv.org perpetual, non-exclusive license"}],"descriptions":[{"descriptionType":"Abstract","description":"AI coding agents are stochastic workflows: prompts are interpreted, artifacts are sampled, validators produce observations, and orchestrators commit or repair. Small prompt or specification changes can therefore alter program-behavior distributions even when the texts appear synonymous. Existing systems evaluate correctness, but lack a compositional criterion for safely replacing a prompt, contract, generator, or program inside a complete agentic workflow. We introduce GenOS, a probabilistic operational semantics for this replacement problem. Each layer is modeled as a Markov kernel, and each interface carries an observer-relative equivalence. We prove that equivalence-compatible kernels descend to quotient classes and that quotienting commutes with distributional extension and sequential composition. Hence, equivalent prompts induce equal probabilities for all downstream equivalence-closed events, including verified commit. We also establish workflow bisimulation, guarded-commit safety under sound validation, total-variation non-expansiveness, and an additive robustness bound that attributes approximation error to individual pipeline layers. An executable insertion-sort audit instantiates the theory with natural-language paraphrases, a formal contract, six programs, two observers, and exhaustive execution on 121 inputs. Equivalent prompts yield identical code-class and commit distributions; a prompt assigning 5% probability to an in-place contract is distinguished by a mutation observer, while downstream distances remain within the predicted bound. Across 20,000 randomized finite-kernel trials, no exact or approximate law is violated. GenOS is model-parametric: compatibility is a measurable property to test, not an assumption about language-model behavior."}],"geoLocations":[],"fundingReferences":[],"url":"https://arxiv.org/abs/2608.03588","contentUrl":null,"metadataVersion":0,"schemaVersion":"http://datacite.org/schema/kernel-4","source":"mds","isActive":true,"state":"findable","reason":null,"viewCount":0,"downloadCount":0,"referenceCount":0,"citationCount":0,"partCount":0,"partOfCount":0,"versionCount":0,"versionOfCount":0,"created":"2026-08-05T02:16:24Z","registered":"2026-08-05T02:16:25Z","published":null,"updated":"2026-08-05T02:16:25Z"},"relationships":{"client":{"data":{"id":"arxiv.content","type":"clients"}}}},{"id":"10.48550/arxiv.2608.03587","type":"dois","attributes":{"doi":"10.48550/arxiv.2608.03587","identifiers":[{"identifier":"2608.03587","identifierType":"arXiv"}],"creators":[{"nameType":"Personal","givenName":"Amgad","familyName":"Abdrabou","name":"Abdrabou, Amgad","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"R.","familyName":"El-Ganainy","name":"El-Ganainy, R.","affiliation":[],"nameIdentifiers":[]}],"titles":[{"title":"A 100x Faster Beam Propagation Method for Nonlinear Optical Wave Propagation Based on Discrete Exterior Calculus"}],"publisher":"arXiv","container":{},"publicationYear":2026,"subjects":[{"subject":"Optics (physics.optics)","lang":"en","subjectScheme":"arXiv"},{"subject":"Computational Physics (physics.comp-ph)","lang":"en","subjectScheme":"arXiv"},{"subject":"FOS: Physical sciences","subjectScheme":"Fields of Science and Technology (FOS)"}],"contributors":[],"dates":[{"date":"2026-08-04T12:42:03Z","dateType":"Submitted","dateInformation":"v1"},{"date":"2026-08-05T00:51:17Z","dateType":"Updated","dateInformation":"v1"},{"date":"2026-08","dateType":"Available","dateInformation":"v1"}],"language":null,"types":{"schemaOrg":"CreativeWork","resourceTypeGeneral":"Preprint","citeproc":"article","bibtex":"misc","ris":"GEN","resourceType":"Article"},"relatedIdentifiers":[],"relatedItems":[],"sizes":[],"formats":[],"version":"1","rightsList":[{"rightsIdentifierScheme":"SPDX","rightsUri":"https://creativecommons.org/licenses/by-nc-nd/4.0/legalcode","schemeUri":"https://spdx.org/licenses/","rights":"Creative Commons Attribution Non Commercial No Derivatives 4.0 International","rightsIdentifier":"cc-by-nc-nd-4.0"}],"descriptions":[{"descriptionType":"Abstract","description":"Efficient simulation of nonlinear light propagation in complex photonic structures remains a major challenge because these systems combine intricate transverse geometries with propagation over distances spanning many diffraction lengths. Existing numerical methods often require computationally intensive uniform discretizations or struggle to accurately represent complex material boundaries, limiting the practical simulation of multiscale nonlinear photonic devices. Here we introduce a computational framework for solving the nonlinear Schrödinger equation that accelerates simulations by more than two orders of magnitude (over 100x) compared with conventional approaches while maintaining spectral-level accuracy, thereby reducing the computational time required to solve large-scale and multiscale problems from days to hours. The method is based on discrete exterior calculus, enabling geometry-conforming discretization directly on unstructured meshes without the weak formulations required by conventional finite-element methods. In contrast to Fourier-based spectral solvers, it avoids global oversampling, eliminates Gibbs-type oscillations at material interfaces, naturally incorporates absorbing boundary conditions, and preserves the topological structure of the underlying differential operators. A key feature of the framework is that higher-order propagation operators are generated algorithmically from lower-order discrete operators, providing a systematic route to extending simulations beyond the standard nonlinear Schrödinger equation. Benchmarks on fundamental solitons, asymmetric beams, and optical vortices confirm spectral-level accuracy while demonstrating computational speedups exceeding 100x."}],"geoLocations":[],"fundingReferences":[],"url":"https://arxiv.org/abs/2608.03587","contentUrl":null,"metadataVersion":0,"schemaVersion":"http://datacite.org/schema/kernel-4","source":"mds","isActive":true,"state":"findable","reason":null,"viewCount":0,"downloadCount":0,"referenceCount":0,"citationCount":0,"partCount":0,"partOfCount":0,"versionCount":0,"versionOfCount":0,"created":"2026-08-05T02:16:23Z","registered":null,"published":null,"updated":"2026-08-05T02:16:23Z"},"relationships":{"client":{"data":{"id":"arxiv.content","type":"clients"}}}},{"id":"10.48550/arxiv.2608.03586","type":"dois","attributes":{"doi":"10.48550/arxiv.2608.03586","identifiers":[{"identifier":"2608.03586","identifierType":"arXiv"}],"creators":[{"nameType":"Personal","givenName":"Biman","familyName":"Bagchi","name":"Bagchi, Biman","affiliation":[],"nameIdentifiers":[]}],"titles":[{"title":"Theory of Handedness Selection in Helices of Chiral Polymers and Biopolymers"}],"publisher":"arXiv","container":{},"publicationYear":2026,"subjects":[{"subject":"Soft Condensed Matter (cond-mat.soft)","lang":"en","subjectScheme":"arXiv"},{"subject":"FOS: Physical sciences","subjectScheme":"Fields of Science and Technology (FOS)"}],"contributors":[],"dates":[{"date":"2026-08-04T12:41:56Z","dateType":"Submitted","dateInformation":"v1"},{"date":"2026-08-05T00:51:17Z","dateType":"Updated","dateInformation":"v1"},{"date":"2026-08","dateType":"Available","dateInformation":"v1"}],"language":null,"types":{"schemaOrg":"CreativeWork","resourceTypeGeneral":"Preprint","citeproc":"article","bibtex":"misc","ris":"GEN","resourceType":"Article"},"relatedIdentifiers":[],"relatedItems":[],"sizes":[],"formats":[],"version":"1","rightsList":[{"rightsUri":"http://arxiv.org/licenses/nonexclusive-distrib/1.0/","rights":"arXiv.org perpetual, non-exclusive license"}],"descriptions":[{"descriptionType":"Abstract","description":"Helices are among the most common ordered structures in biological and synthetic polymers, but their formation involves more than local conformational preference. A finite helix must nucleate, grow, resist breaking, and maintain a selected handedness against thermal fluctuations. We develop a three-state Ising-like transfer-matrix theory in which each segment is coil-like, right-handed helical, or left-handed helical. This formulation separates ordinary helix--coil cooperativity from the persistence of handedness. The right--left symmetric problem decomposes into symmetric and antisymmetric sectors, giving two characteristic lengths: the helical correlation length $ξ_H$ and the chiral persistence length $ξ_χ$. In the strongly helical rare-wall limit, $ξ_χ\\simeq (1/2)\\exp[β(K+J)]$. A local chiral bias, motivated by the Ramachandran landscape, is then amplified over finite helical domains."},{"descriptionType":"Other","description":"58 pages, 2 figures. The paper develops a novel statistical mechanical theory of the selection of handedness in helical polymers. It employs a 3-state Ising model, and makes several quantitative predictions"}],"geoLocations":[],"fundingReferences":[],"url":"https://arxiv.org/abs/2608.03586","contentUrl":null,"metadataVersion":0,"schemaVersion":"http://datacite.org/schema/kernel-4","source":"mds","isActive":true,"state":"findable","reason":null,"viewCount":0,"downloadCount":0,"referenceCount":0,"citationCount":0,"partCount":0,"partOfCount":0,"versionCount":0,"versionOfCount":0,"created":"2026-08-05T02:16:22Z","registered":"2026-08-05T02:16:22Z","published":null,"updated":"2026-08-05T02:16:22Z"},"relationships":{"client":{"data":{"id":"arxiv.content","type":"clients"}}}},{"id":"10.48550/arxiv.2608.03585","type":"dois","attributes":{"doi":"10.48550/arxiv.2608.03585","identifiers":[{"identifier":"2608.03585","identifierType":"arXiv"}],"creators":[{"nameType":"Personal","givenName":"Mengying","familyName":"Zhou","name":"Zhou, Mengying","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Yongjie","familyName":"Yin","name":"Yin, Yongjie","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Yang","familyName":"Chen","name":"Chen, Yang","affiliation":[],"nameIdentifiers":[]}],"titles":[{"title":"From Social Coding to Agentic Coding: Productivity and Relational Reconfiguration in Open-Source Communities"}],"publisher":"arXiv","container":{},"publicationYear":2026,"subjects":[{"subject":"Artificial Intelligence (cs.AI)","lang":"en","subjectScheme":"arXiv"},{"subject":"Computers and Society (cs.CY)","lang":"en","subjectScheme":"arXiv"},{"subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"}],"contributors":[],"dates":[{"date":"2026-08-04T12:41:32Z","dateType":"Submitted","dateInformation":"v1"},{"date":"2026-08-05T00:51:16Z","dateType":"Updated","dateInformation":"v1"},{"date":"2026-08","dateType":"Available","dateInformation":"v1"}],"language":null,"types":{"schemaOrg":"CreativeWork","resourceTypeGeneral":"Preprint","citeproc":"article","bibtex":"misc","ris":"GEN","resourceType":"Article"},"relatedIdentifiers":[],"relatedItems":[],"sizes":[],"formats":[],"version":"1","rightsList":[{"rightsIdentifierScheme":"SPDX","rightsUri":"https://creativecommons.org/licenses/by-nc-sa/4.0/legalcode","schemeUri":"https://spdx.org/licenses/","rights":"Creative Commons Attribution Non Commercial Share Alike 4.0 International","rightsIdentifier":"cc-by-nc-sa-4.0"}],"descriptions":[{"descriptionType":"Abstract","description":"Open-source software communities are a form of digital public infrastructure that not only produces code, but also generates public knowledge and interpersonal relationships through visible collaboration. Generative coding agents (CAs) are an advanced tool to improve development efficiency while shifting part of activities from public human interaction to private human-agent loops. We study this shift using an LLM-based multi-agent simulation initialized with real GitHub data from 1,084 active developers and their repository relationships. After a warm-up with historical commits, we branch the same community state into parallel No-CA and CA conditions for 4-week simulations. CA introduction increases planned and completed tasks by 34.0% and 39.0%, respectively, and reduces median completion time from 45 to 20 minutes. However, adoption reaches only 26.0%, and the gains concentrate among developers who are already more active and well connected. CAs also restructure task execution pathways. Direct human-human interaction declines from 32.4% to 11.6%, while CA-involved modes increase to 57.3%, including 40.3% completed through CA-assisted self-loops. Public knowledge generated under CA condition also provides less support for later tasks. On a standardized retrieval benchmark, the CA corpus achieves 22.3% knowledge coverage, far below the 81.1% achieved by the real-human corpus, and requires more retrieval steps with a lower success rate. These results reveal a productivity-public knowledge tension: coding agents increase technical production, but more work shifts to agent-mediated or private loops, leaving public records less useful to future contributors."}],"geoLocations":[],"fundingReferences":[],"url":"https://arxiv.org/abs/2608.03585","contentUrl":null,"metadataVersion":0,"schemaVersion":"http://datacite.org/schema/kernel-4","source":"mds","isActive":true,"state":"findable","reason":null,"viewCount":0,"downloadCount":0,"referenceCount":0,"citationCount":0,"partCount":0,"partOfCount":0,"versionCount":0,"versionOfCount":0,"created":"2026-08-05T02:16:20Z","registered":null,"published":null,"updated":"2026-08-05T02:16:21Z"},"relationships":{"client":{"data":{"id":"arxiv.content","type":"clients"}}}},{"id":"10.48550/arxiv.2608.03584","type":"dois","attributes":{"doi":"10.48550/arxiv.2608.03584","identifiers":[{"identifier":"2608.03584","identifierType":"arXiv"}],"creators":[{"nameType":"Personal","givenName":"Lydia","familyName":"Manikonda","name":"Manikonda, Lydia","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Dominique","familyName":"Outlaw","name":"Outlaw, Dominique","affiliation":[],"nameIdentifiers":[]}],"titles":[{"title":"Policy Fragmentation or Institutional Alignment? Institutional Governance of AI in Universities and Business Schools"}],"publisher":"arXiv","container":{},"publicationYear":2026,"subjects":[{"subject":"Artificial Intelligence (cs.AI)","lang":"en","subjectScheme":"arXiv"},{"subject":"Computational Engineering, Finance, and Science (cs.CE)","lang":"en","subjectScheme":"arXiv"},{"subject":"Emerging Technologies (cs.ET)","lang":"en","subjectScheme":"arXiv"},{"subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"}],"contributors":[],"dates":[{"date":"2026-08-04T12:39:33Z","dateType":"Submitted","dateInformation":"v1"},{"date":"2026-08-05T00:51:00Z","dateType":"Updated","dateInformation":"v1"},{"date":"2026-08","dateType":"Available","dateInformation":"v1"}],"language":null,"types":{"schemaOrg":"CreativeWork","resourceTypeGeneral":"Preprint","citeproc":"article","bibtex":"misc","ris":"GEN","resourceType":"Article"},"relatedIdentifiers":[],"relatedItems":[],"sizes":[],"formats":[],"version":"1","rightsList":[{"rightsIdentifierScheme":"SPDX","rightsUri":"https://creativecommons.org/licenses/by/4.0/legalcode","schemeUri":"https://spdx.org/licenses/","rights":"Creative Commons Attribution 4.0 International","rightsIdentifier":"cc-by-4.0"}],"descriptions":[{"descriptionType":"Abstract","description":"Artificial intelligence (AI) is rapidly transforming high-skilled domains, requiring higher education institutions (HEI) to balance the teaching of foundational principles with the integration of emerging tools to ensure workforce readiness. While HEI are increasingly adopting AI, many continue to grapple with how it should be incorporated into curricula and governed through policy, especially when such policies are set at different levels of an institution. This research analyzes AI policies across HEI from 34 states in the United States to investigate what these policies entail and how policies set across institutions as well as within different levels at an institution differ. Using natural language processing (NLP) to analyze institutional AI policies, we find a clear divergence: university-level policies emphasize data security and risk mitigation whereas school-level policies, when present, focus on pedagogical applications and tool usage. When focusing on business school specific policies, relatively few business schools maintain AI policies distinct from university frameworks, creating misalignment with discipline-specific learning objectives. This gap poses challenges particularly for faculty and students as well as for accreditation purposes. Our insights suggest that guidelines should be aligned with broader institutional policies while addressing discipline-specific learning objectives and evolving workforce demands."},{"descriptionType":"Other","description":"Our insights suggest that policy guidelines should be aligned with broader institutional policies while addressing discipline-specific learning objectives and evolving workforce demands"}],"geoLocations":[],"fundingReferences":[],"url":"https://arxiv.org/abs/2608.03584","contentUrl":null,"metadataVersion":0,"schemaVersion":"http://datacite.org/schema/kernel-4","source":"mds","isActive":true,"state":"findable","reason":null,"viewCount":0,"downloadCount":0,"referenceCount":0,"citationCount":0,"partCount":0,"partOfCount":0,"versionCount":0,"versionOfCount":0,"created":"2026-08-05T02:16:19Z","registered":"2026-08-05T02:16:20Z","published":null,"updated":"2026-08-05T02:16:20Z"},"relationships":{"client":{"data":{"id":"arxiv.content","type":"clients"}}}},{"id":"10.48550/arxiv.2608.03583","type":"dois","attributes":{"doi":"10.48550/arxiv.2608.03583","identifiers":[{"identifier":"2608.03583","identifierType":"arXiv"}],"creators":[{"nameType":"Personal","givenName":"Žygimantas","familyName":"Baronėnas","name":"Baronėnas, Žygimantas","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Paulius","familyName":"Drungilas","name":"Drungilas, Paulius","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Jonas","familyName":"Jankauskas","name":"Jankauskas, Jonas","affiliation":[],"nameIdentifiers":[]}],"titles":[{"title":"No three algebraic conjugates of degree sixteen sum to zero"}],"publisher":"arXiv","container":{},"publicationYear":2026,"subjects":[{"subject":"Number Theory (math.NT)","lang":"en","subjectScheme":"arXiv"},{"subject":"FOS: Mathematics","subjectScheme":"Fields of Science and Technology (FOS)"},{"subject":"11R04, 11R09, 11R32, 12F10, 20D20","lang":"en","subjectScheme":"MSC"}],"contributors":[],"dates":[{"date":"2026-08-04T12:38:41Z","dateType":"Submitted","dateInformation":"v1"},{"date":"2026-08-05T00:50:59Z","dateType":"Updated","dateInformation":"v1"},{"date":"2026-08","dateType":"Available","dateInformation":"v1"}],"language":null,"types":{"schemaOrg":"CreativeWork","resourceTypeGeneral":"Preprint","citeproc":"article","bibtex":"misc","ris":"GEN","resourceType":"Article"},"relatedIdentifiers":[],"relatedItems":[],"sizes":[],"formats":[],"version":"1","rightsList":[{"rightsUri":"http://arxiv.org/licenses/nonexclusive-distrib/1.0/","rights":"arXiv.org perpetual, non-exclusive license"}],"descriptions":[{"descriptionType":"Abstract","description":"Let $d$ be the smallest positive integer, not a multiple of $3$, for which there exists an algebraic number $\\al$ of degree $d$ over $\\mathbb{Q}$ whose three algebraic conjugates add to zero. We prove that $d=20$. This is derived from the following result: for any linear relation $\\sum_{j=1}^d a_j \\al_j=0$ with coefficients $a_j\\in\\mathbb{Z}$ among the conjugates $\\al_j$ of an algebraic number of degree $d=p^m$, where $p$ is a prime number, $m \\geq 1$, the sum $\\sum_{j=1}a_j$ is divisible by $p$. If $d=2p^m$, $p\\geq 3$ and $\\sum_{j=1}^d|a_d| \u0026lt; p$, then $\\sum_{j=1}a_j$ is an even number."}],"geoLocations":[],"fundingReferences":[],"url":"https://arxiv.org/abs/2608.03583","contentUrl":null,"metadataVersion":0,"schemaVersion":"http://datacite.org/schema/kernel-4","source":"mds","isActive":true,"state":"findable","reason":null,"viewCount":0,"downloadCount":0,"referenceCount":0,"citationCount":0,"partCount":0,"partOfCount":0,"versionCount":0,"versionOfCount":0,"created":"2026-08-05T02:16:18Z","registered":"2026-08-05T02:16:18Z","published":null,"updated":"2026-08-05T02:16:18Z"},"relationships":{"client":{"data":{"id":"arxiv.content","type":"clients"}}}},{"id":"10.48550/arxiv.2608.03582","type":"dois","attributes":{"doi":"10.48550/arxiv.2608.03582","identifiers":[{"identifier":"2608.03582","identifierType":"arXiv"}],"creators":[{"nameType":"Personal","givenName":"Agnes P. C.","familyName":"van Hoof","name":"van Hoof, Agnes P. C.","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Peter G.","familyName":"Jonker","name":"Jonker, Peter G.","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Andrew J.","familyName":"Levan","name":"Levan, Andrew J.","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Nial R.","familyName":"Tanvir","name":"Tanvir, Nial R.","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Franz E.","familyName":"Bauer","name":"Bauer, Franz E.","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Joe","familyName":"Bright","name":"Bright, Joe","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Francesco","familyName":"Carotenuto","name":"Carotenuto, Francesco","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Ting-Wan","familyName":"Chen","name":"Chen, Ting-Wan","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Ashley","familyName":"Chrimes","name":"Chrimes, Ashley","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Gregory","familyName":"Corcoran","name":"Corcoran, Gregory","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Laura","familyName":"Cotter","name":"Cotter, Laura","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Joyce N. D.","familyName":"van Dalen","name":"van Dalen, Joyce N. D.","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Rob A. J.","familyName":"Eyles-Ferris","name":"Eyles-Ferris, Rob A. J.","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Morgan","familyName":"Fraser","name":"Fraser, Morgan","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Daniele B.","familyName":"Malesani","name":"Malesani, Daniele B.","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Daniel Mata","familyName":"Sánchez","name":"Sánchez, Daniel Mata","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Antonio","familyName":"Martin-Carrillo","name":"Martin-Carrillo, Antonio","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Paul","familyName":"O'Brien","name":"O'Brien, Paul","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Francesca","familyName":"Onori","name":"Onori, Francesca","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Jonathan","familyName":"Quirola-Vásquez","name":"Quirola-Vásquez, Jonathan","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Maria E.","familyName":"Ravasio","name":"Ravasio, Maria E.","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Andrea","familyName":"Rossi","name":"Rossi, Andrea","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Javi","familyName":"Sánchez-Sierras","name":"Sánchez-Sierras, Javi","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Nikhil","familyName":"Sarin","name":"Sarin, Nikhil","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Steve","familyName":"Schulze","name":"Schulze, Steve","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Hui","familyName":"Sun","name":"Sun, Hui","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Manuel A. P.","familyName":"Torres","name":"Torres, Manuel A. P.","affiliation":[],"nameIdentifiers":[]}],"titles":[{"title":"A JWST redshift for the host galaxy of EP250207b of z=3.2: a collapsar origin is viable"}],"publisher":"arXiv","container":{},"publicationYear":2026,"subjects":[{"subject":"High Energy Astrophysical Phenomena (astro-ph.HE)","lang":"en","subjectScheme":"arXiv"},{"subject":"FOS: Physical sciences","subjectScheme":"Fields of Science and Technology (FOS)"}],"contributors":[],"dates":[{"date":"2026-08-04T12:35:36Z","dateType":"Submitted","dateInformation":"v1"},{"date":"2026-08-05T00:50:55Z","dateType":"Updated","dateInformation":"v1"},{"date":"2026-08","dateType":"Available","dateInformation":"v1"}],"language":null,"types":{"schemaOrg":"CreativeWork","resourceTypeGeneral":"Preprint","citeproc":"article","bibtex":"misc","ris":"GEN","resourceType":"Article"},"relatedIdentifiers":[],"relatedItems":[],"sizes":[],"formats":[],"version":"1","rightsList":[{"rightsIdentifierScheme":"SPDX","rightsUri":"https://creativecommons.org/licenses/by/4.0/legalcode","schemeUri":"https://spdx.org/licenses/","rights":"Creative Commons Attribution 4.0 International","rightsIdentifier":"cc-by-4.0"}],"descriptions":[{"descriptionType":"Abstract","description":"We present James Webb Space Telescope (JWST) and Hubble Space Telescope (HST) observations of the field of the fast X-ray transient (FXT) detected by Einstein Probe, EP250207b, to resolve any ambiguity about the host galaxy and redshift of the FXT. EP250207b was originally associated with a nearby galaxy at z=0.082, based on its low chance alignment probability, and a binary neutron star merger origin was proposed. However, we report the detection of a background galaxy at z=3.2 at the location of EP250207b. Assuming this galaxy is the actual host galaxy, the rest-frame energetics and timescales of the event change. Furthermore, the available data are not able to rule out the presence of a supernova associated with EP250207b if at this redshift. We model the X-ray, optical, near-infrared and radio light curves using a tophat jet model implemented in Redback and find that they are consistent with an on-axis gamma ray burst afterglow. The energetics and host galaxy properties do not allow us to distinguish between a collapsar and a merger driven event."},{"descriptionType":"Other","description":"7 pages, 6 figures, 1 table. Version submitted to MNRAS"}],"geoLocations":[],"fundingReferences":[],"url":"https://arxiv.org/abs/2608.03582","contentUrl":null,"metadataVersion":0,"schemaVersion":"http://datacite.org/schema/kernel-4","source":"mds","isActive":true,"state":"findable","reason":null,"viewCount":0,"downloadCount":0,"referenceCount":0,"citationCount":0,"partCount":0,"partOfCount":0,"versionCount":0,"versionOfCount":0,"created":"2026-08-05T02:16:16Z","registered":null,"published":null,"updated":"2026-08-05T02:16:17Z"},"relationships":{"client":{"data":{"id":"arxiv.content","type":"clients"}}}},{"id":"10.48550/arxiv.2608.03581","type":"dois","attributes":{"doi":"10.48550/arxiv.2608.03581","identifiers":[{"identifier":"2608.03581","identifierType":"arXiv"}],"creators":[{"nameType":"Personal","givenName":"Alexander M.","familyName":"Fichtl","name":"Fichtl, Alexander M.","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Lukas","familyName":"Ellinger","name":"Ellinger, Lukas","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Josefin","familyName":"Kelber","name":"Kelber, Josefin","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Kryštof","familyName":"Olík","name":"Olík, Kryštof","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Georg","familyName":"Groh","name":"Groh, Georg","affiliation":[],"nameIdentifiers":[]}],"titles":[{"title":"AI-Assisted Peer Review Across Research Communities: From Reviewer AI Policies to LLM Review Quality"}],"publisher":"arXiv","container":{},"publicationYear":2026,"subjects":[{"subject":"Computers and Society (cs.CY)","lang":"en","subjectScheme":"arXiv"},{"subject":"Artificial Intelligence (cs.AI)","lang":"en","subjectScheme":"arXiv"},{"subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"},{"subject":"68T50","lang":"en","subjectScheme":"MSC"}],"contributors":[],"dates":[{"date":"2026-08-04T12:34:47Z","dateType":"Submitted","dateInformation":"v1"},{"date":"2026-08-05T00:50:54Z","dateType":"Updated","dateInformation":"v1"},{"date":"2026-08","dateType":"Available","dateInformation":"v1"}],"language":null,"types":{"schemaOrg":"CreativeWork","resourceTypeGeneral":"Preprint","citeproc":"article","bibtex":"misc","ris":"GEN","resourceType":"Article"},"relatedIdentifiers":[],"relatedItems":[],"sizes":[],"formats":[],"version":"1","rightsList":[{"rightsIdentifierScheme":"SPDX","rightsUri":"https://creativecommons.org/licenses/by-sa/4.0/legalcode","schemeUri":"https://spdx.org/licenses/","rights":"Creative Commons Attribution Share Alike 4.0 International","rightsIdentifier":"cc-by-sa-4.0"}],"descriptions":[{"descriptionType":"Abstract","description":"AI-assisted peer review is increasingly discussed and adopted as a tool to support the scientific publishing process, yet there is little systematic understanding of how publication venues regulate its use or of how capable current AI review systems are. We address these questions by first surveying reviewer-facing AI policies across 111 leading AI/NLP conferences and medical journals, revealing substantial regulation differences between the two communities. Second, we evaluate AI-generated peer reviews at ICLR 2026 and Nature Communications using a novel dataset comprising original manuscript submissions and several hundred human- and machine-generated reviews. We compare reviews produced by open-source and proprietary models using complementary evaluation metrics, including LLM-as-a-Judge, score alignment, granularity, and overlap with human reviewers' concerns. Our results show that current LLMs can generate detailed and fluent reviews but exhibit systematic weaknesses, such as overly positive recommendations, generic criticism, and uneven evidence grounding. We demonstrate that aggregate quality scores alone can overestimate review quality and argue for multi-dimensional evaluation of AI-generated peer reviews."},{"descriptionType":"Other","description":"30 pages, 19 figures, 10 tables. Currently under peer review. GitHub link for code and data is given in the paper"}],"geoLocations":[],"fundingReferences":[],"url":"https://arxiv.org/abs/2608.03581","contentUrl":null,"metadataVersion":0,"schemaVersion":"http://datacite.org/schema/kernel-4","source":"mds","isActive":true,"state":"findable","reason":null,"viewCount":0,"downloadCount":0,"referenceCount":0,"citationCount":0,"partCount":0,"partOfCount":0,"versionCount":0,"versionOfCount":0,"created":"2026-08-05T02:16:15Z","registered":null,"published":null,"updated":"2026-08-05T02:16:15Z"},"relationships":{"client":{"data":{"id":"arxiv.content","type":"clients"}}}},{"id":"10.48550/arxiv.2608.03580","type":"dois","attributes":{"doi":"10.48550/arxiv.2608.03580","identifiers":[{"identifier":"2608.03580","identifierType":"arXiv"}],"creators":[{"nameType":"Personal","givenName":"Yaozhi","familyName":"Wen","name":"Wen, Yaozhi","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Jialong","familyName":"Guo","name":"Guo, Jialong","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Zhenliang","familyName":"Ni","name":"Ni, Zhenliang","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Han","familyName":"Shu","name":"Shu, Han","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Xinghao","familyName":"Chen","name":"Chen, Xinghao","affiliation":[],"nameIdentifiers":[]}],"titles":[{"title":"SlimVLM: Sensitivity-aware Dynamic Structured Pruning with Adaptive Visual Token Selection for Efficient Vision-Language Models"}],"publisher":"arXiv","container":{},"publicationYear":2026,"subjects":[{"subject":"Computer Vision and Pattern Recognition (cs.CV)","lang":"en","subjectScheme":"arXiv"},{"subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"}],"contributors":[],"dates":[{"date":"2026-08-04T12:34:46Z","dateType":"Submitted","dateInformation":"v1"},{"date":"2026-08-05T00:50:53Z","dateType":"Updated","dateInformation":"v1"},{"date":"2026-08","dateType":"Available","dateInformation":"v1"}],"language":null,"types":{"schemaOrg":"CreativeWork","resourceTypeGeneral":"Preprint","citeproc":"article","bibtex":"misc","ris":"GEN","resourceType":"Article"},"relatedIdentifiers":[],"relatedItems":[],"sizes":[],"formats":[],"version":"1","rightsList":[{"rightsUri":"http://arxiv.org/licenses/nonexclusive-distrib/1.0/","rights":"arXiv.org perpetual, non-exclusive license"}],"descriptions":[{"descriptionType":"Abstract","description":"While Vision-Language Models (VLMs) have demonstrated remarkable performance in processing and understanding both text and images, their large parameter sizes lead to significant computational overhead, limiting their deployment on resource-constrained devices. While pruning has been effective for compressing Large Language Models (LLMs), directly applying it to VLMs leads to significant performance drops, largely due to redundant visual tokens interfering with importance estimation. To this end, we propose SlimVLM, a structured pruning framework designed to compress VLMs while preserving their task performance. We introduce an adaptive visual token selection strategy for VLMs that leverages average text-to-visual attention scores to assess the importance of visual tokens, removing redundant ones during pruning based on a set threshold, thereby optimizing the importance calculation. Recognizing the varying tolerance to sparsity across different modules, we also propose a Sensitivity-aware dynamic pruning mechanism that determines the appropriate pruning ratio for each module by calculating the linear reconstruction error between the outputs of the pruned and unpruned modules, ensuring overall performance stability. Experimental results show that SlimVLM outperforms existing methods across multiple multimodal benchmarks, achieving state-of-the-art performance."}],"geoLocations":[],"fundingReferences":[],"url":"https://arxiv.org/abs/2608.03580","contentUrl":null,"metadataVersion":0,"schemaVersion":"http://datacite.org/schema/kernel-4","source":"mds","isActive":true,"state":"findable","reason":null,"viewCount":0,"downloadCount":0,"referenceCount":0,"citationCount":0,"partCount":0,"partOfCount":0,"versionCount":0,"versionOfCount":0,"created":"2026-08-05T02:16:13Z","registered":"2026-08-05T02:16:14Z","published":null,"updated":"2026-08-05T02:16:14Z"},"relationships":{"client":{"data":{"id":"arxiv.content","type":"clients"}}}},{"id":"10.48550/arxiv.2608.03579","type":"dois","attributes":{"doi":"10.48550/arxiv.2608.03579","identifiers":[{"identifier":"2608.03579","identifierType":"arXiv"}],"creators":[{"nameType":"Personal","givenName":"Xiang","familyName":"Li","name":"Li, Xiang","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Pengcheng","familyName":"Wang","name":"Wang, Pengcheng","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Huazheng","familyName":"Wang","name":"Wang, Huazheng","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Saurabh","familyName":"Bagchi","name":"Bagchi, Saurabh","affiliation":[],"nameIdentifiers":[]}],"titles":[{"title":"Pin Once, Swap Light: Subspace-Aligned Centroid-Residual Training for Efficient Ultra-LoRA Serving"}],"publisher":"arXiv","container":{},"publicationYear":2026,"subjects":[{"subject":"Machine Learning (cs.LG)","lang":"en","subjectScheme":"arXiv"},{"subject":"Artificial Intelligence (cs.AI)","lang":"en","subjectScheme":"arXiv"},{"subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"}],"contributors":[],"dates":[{"date":"2026-08-04T12:34:35Z","dateType":"Submitted","dateInformation":"v1"},{"date":"2026-08-05T00:50:52Z","dateType":"Updated","dateInformation":"v1"},{"date":"2026-08","dateType":"Available","dateInformation":"v1"}],"language":null,"types":{"schemaOrg":"CreativeWork","resourceTypeGeneral":"Preprint","citeproc":"article","bibtex":"misc","ris":"GEN","resourceType":"Article"},"relatedIdentifiers":[],"relatedItems":[],"sizes":[],"formats":[],"version":"1","rightsList":[{"rightsIdentifierScheme":"SPDX","rightsUri":"https://creativecommons.org/licenses/by/4.0/legalcode","schemeUri":"https://spdx.org/licenses/","rights":"Creative Commons Attribution 4.0 International","rightsIdentifier":"cc-by-4.0"}],"descriptions":[{"descriptionType":"Abstract","description":"Modern multi-tenant Low-Rank Adapters (LoRAs) serving systems concurrently host tens to hundreds of LoRA adapters. Though powerful, this introduces a critical system dilemma between serving efficiency and task performance: higher-rank adapters generally achieve better downstream task performance, but their GPU VRAM footprint and Host-to-Device PCIe swapping overhead severely constrain scalability. Conversely, ultra-low-rank adapters ($r \\le 2$) minimize both VRAM footprint and PCIe transfer overhead, but suffer from downstream task performance degradation. To solve this problem, we propose Subspace-Aligned LoRA Training (SALT), a serving efficiency-aware hierarchical fine-tuning framework. Our solution operates in three phases. First, a provider jointly trains high-capacity domain centroids on public data within the domain using a novel alignment regularizer that coheres in-domain task subspaces into a unified basis. Next, users fine-tune ultra-low-rank task residual adapters on private data atop those frozen centroids. Finally, during inference, the provider pins the centroid in GPU VRAM and dynamically swaps in each user's task residual on demand. Across LLMs of varying scales, SALT recovers high-rank accuracy using $r \\le 2$ residuals, achieving up to 18.5% absolute accuracy gains over state-of-the-art compression baselines and reducing per-adapter memory by up to 16x. When integrated into vLLM, SALT improves serving throughput by up to 51% under PCIe bandwidth pressure and 28% under GPU VRAM constraints for Llama-3.2-3B."}],"geoLocations":[],"fundingReferences":[],"url":"https://arxiv.org/abs/2608.03579","contentUrl":null,"metadataVersion":0,"schemaVersion":"http://datacite.org/schema/kernel-4","source":"mds","isActive":true,"state":"findable","reason":null,"viewCount":0,"downloadCount":0,"referenceCount":0,"citationCount":0,"partCount":0,"partOfCount":0,"versionCount":0,"versionOfCount":0,"created":"2026-08-05T02:16:12Z","registered":null,"published":null,"updated":"2026-08-05T02:16:12Z"},"relationships":{"client":{"data":{"id":"arxiv.content","type":"clients"}}}},{"id":"10.48550/arxiv.2608.03578","type":"dois","attributes":{"doi":"10.48550/arxiv.2608.03578","identifiers":[{"identifier":"2608.03578","identifierType":"arXiv"}],"creators":[{"nameType":"Personal","givenName":"Fouad","familyName":"Essaadi","name":"Essaadi, Fouad","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Yassine","familyName":"Oussarhan","name":"Oussarhan, Yassine","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Mohamed","familyName":"Ouhammou","name":"Ouhammou, Mohamed","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Said","familyName":"Mouslih","name":"Mouslih, Said","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Mohamed","familyName":"Jakha","name":"Jakha, Mohamed","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Bouzid","familyName":"Manaut","name":"Manaut, Bouzid","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Souad","familyName":"Taj","name":"Taj, Souad","affiliation":[],"nameIdentifiers":[]}],"titles":[{"title":"Generation and Enhancement of Bipartite and Tripartite Entanglement in an Electro-Optomechanical Ring Cavity"}],"publisher":"arXiv","container":{},"publicationYear":2026,"subjects":[{"subject":"Quantum Physics (quant-ph)","lang":"en","subjectScheme":"arXiv"},{"subject":"Optics (physics.optics)","lang":"en","subjectScheme":"arXiv"},{"subject":"FOS: Physical sciences","subjectScheme":"Fields of Science and Technology (FOS)"}],"contributors":[],"dates":[{"date":"2026-08-04T12:33:45Z","dateType":"Submitted","dateInformation":"v1"},{"date":"2026-08-05T00:50:50Z","dateType":"Updated","dateInformation":"v1"},{"date":"2026-08","dateType":"Available","dateInformation":"v1"}],"language":null,"types":{"schemaOrg":"CreativeWork","resourceTypeGeneral":"Preprint","citeproc":"article","bibtex":"misc","ris":"GEN","resourceType":"Article"},"relatedIdentifiers":[],"relatedItems":[],"sizes":[],"formats":[],"version":"1","rightsList":[{"rightsIdentifierScheme":"SPDX","rightsUri":"https://creativecommons.org/licenses/by/4.0/legalcode","schemeUri":"https://spdx.org/licenses/","rights":"Creative Commons Attribution 4.0 International","rightsIdentifier":"cc-by-4.0"}],"descriptions":[{"descriptionType":"Abstract","description":"This study investigates the generation and enhancement of quantum entanglement in an electro-optomechanical ring cavity system. The setup integrates two Coulomb-coupled mechanical resonators, which serve as the fundamental mechanism for the generation of bipartite and tripartite entanglement via charge mediated coupling. We then demonstrate the significant enhancement of this entanglement via a nonlinear parametric drive (an optical parametric amplifier, OPA), which injects a controllable nonlinearity into the cavity. We derive the system's Hamiltonian and the corresponding quantum Langevin equations, which are linearized around steady-state solutions to analyze Gaussian quantum fluctuations. Employing the covariance matrix formalism, we quantify bipartite entanglement via logarithmic negativity and tripartite entanglement via the minimum residual contangle. Our results unequivocally show that while the Coulomb interaction is indispensable for creating entanglement, the OPA acts as a powerful control tool, dramatically amplifying the degree of quantum correlations for all subsystems. We find that the strength of entanglement is highly sensitive to several parameters and can be optimized through the strategic selection of the OPA's gain and phase, the laser detuning, and the input power. A key finding is the existence of a trade-off, where parameters that maximize entanglement also constrain the stable operating regime of the system. Furthermore, thermal noise is shown to progressively degrade all quantum correlations, underscoring the necessity for low-temperature operation. These findings provide comprehensive guidance for parameter optimization, outlining a clear path from generation to enhancement, and highlight the potential of such hybrid systems as versatile platforms for controlling multipartite entanglement in quantum technologies."},{"descriptionType":"Other","description":"Accepted in Pramana Journal of Physics"}],"geoLocations":[],"fundingReferences":[],"url":"https://arxiv.org/abs/2608.03578","contentUrl":null,"metadataVersion":0,"schemaVersion":"http://datacite.org/schema/kernel-4","source":"mds","isActive":true,"state":"findable","reason":null,"viewCount":0,"downloadCount":0,"referenceCount":0,"citationCount":0,"partCount":0,"partOfCount":0,"versionCount":0,"versionOfCount":0,"created":"2026-08-05T02:16:11Z","registered":null,"published":null,"updated":"2026-08-05T02:16:11Z"},"relationships":{"client":{"data":{"id":"arxiv.content","type":"clients"}}}},{"id":"10.48550/arxiv.2608.03577","type":"dois","attributes":{"doi":"10.48550/arxiv.2608.03577","identifiers":[{"identifier":"2608.03577","identifierType":"arXiv"}],"creators":[{"nameType":"Personal","givenName":"Serge","familyName":"Gladkoff","name":"Gladkoff, Serge","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Angelika","familyName":"Vaasa","name":"Vaasa, Angelika","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Sue Ellen","familyName":"Wright","name":"Wright, Sue Ellen","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Ingemar","familyName":"Strandvik","name":"Strandvik, Ingemar","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Lifeng","familyName":"Han","name":"Han, Lifeng","affiliation":[],"nameIdentifiers":[]}],"titles":[{"title":"Looking under the Wrong Lamppost: On the Limitations of Automated Translation Quality Estimation"}],"publisher":"arXiv","container":{},"publicationYear":2026,"subjects":[{"subject":"Computation and Language (cs.CL)","lang":"en","subjectScheme":"arXiv"},{"subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"}],"contributors":[],"dates":[{"date":"2026-08-04T12:33:13Z","dateType":"Submitted","dateInformation":"v1"},{"date":"2026-08-05T00:50:50Z","dateType":"Updated","dateInformation":"v1"},{"date":"2026-08","dateType":"Available","dateInformation":"v1"}],"language":null,"types":{"schemaOrg":"CreativeWork","resourceTypeGeneral":"Preprint","citeproc":"article","bibtex":"misc","ris":"GEN","resourceType":"Article"},"relatedIdentifiers":[],"relatedItems":[],"sizes":[],"formats":[],"version":"1","rightsList":[{"rightsIdentifierScheme":"SPDX","rightsUri":"https://creativecommons.org/licenses/by-nc-sa/4.0/legalcode","schemeUri":"https://spdx.org/licenses/","rights":"Creative Commons Attribution Non Commercial Share Alike 4.0 International","rightsIdentifier":"cc-by-nc-sa-4.0"}],"descriptions":[{"descriptionType":"Abstract","description":"Automation of Translation Quality Estimation (QE) has emerged as a widely discussed approach to managing translation quality at scale, and a growing number of tools and technologies have been released in pursuit of this goal. However, the proliferation of new QE systems has not always been accompanied by robust, transparent, and reproducible research and testing. This gap deserves critical scrutiny. This paper examines some fundamental limitations of the QE technology from both theoretical and empirical perspectives, arguing that current QE systems are structurally ill-equipped to serve as reliable standalone tools in real-world translation workflows. The reviewed evidence suggests that QE suffers from a range of interrelated and largely unresolved limitations. Most fundamentally, the evaluation of the quality of translation at the level of isolated segments is problematic because it tends to miss out on cohesion, coherence, and stylistic and rhetorical text features. In addition, empirical research documents several other limitations and flaws, including failure to generalize, systematic biases, overfitting and distribution collapse, performance gaps, error annotation challenges, and data scarcity. These are structural limitations arising from the complexity of human language and translation as a cognitive and communicative act - limitations that more data and better architectures have so far not overcome. Consequently, segment-level QE scores should not be used as a standalone basis for routing, release, or review bypass in production; we argue future work should focus on automating human evaluation grounded in MQM."},{"descriptionType":"Other","description":"To appear in the Proceedings of the 9th International Conference on Natural Language and Speech Processing (ICNLSP 2026), Trento, Italy, September 2026"}],"geoLocations":[],"fundingReferences":[],"url":"https://arxiv.org/abs/2608.03577","contentUrl":null,"metadataVersion":0,"schemaVersion":"http://datacite.org/schema/kernel-4","source":"mds","isActive":true,"state":"findable","reason":null,"viewCount":0,"downloadCount":0,"referenceCount":0,"citationCount":0,"partCount":0,"partOfCount":0,"versionCount":0,"versionOfCount":0,"created":"2026-08-05T02:16:09Z","registered":"2026-08-05T02:16:10Z","published":null,"updated":"2026-08-05T02:16:10Z"},"relationships":{"client":{"data":{"id":"arxiv.content","type":"clients"}}}},{"id":"10.48550/arxiv.2608.03576","type":"dois","attributes":{"doi":"10.48550/arxiv.2608.03576","identifiers":[{"identifier":"2608.03576","identifierType":"arXiv"}],"creators":[{"nameType":"Personal","givenName":"Andreea A","familyName":"Vărăşteanu","name":"Vărăşteanu, Andreea A","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Matt J.","familyName":"Jarvis","name":"Jarvis, Matt J.","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Harry","familyName":"Desmond","name":"Desmond, Harry","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Anastasia A.","familyName":"Ponomareva","name":"Ponomareva, Anastasia A.","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Tariq","familyName":"Yasin","name":"Yasin, Tariq","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Michalina","familyName":"Maksymowicz-Maciata","name":"Maksymowicz-Maciata, Michalina","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Ian","familyName":"Heywood","name":"Heywood, Ian","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Natasha","familyName":"Maddox","name":"Maddox, Natasha","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Andrew J.","familyName":"Baker","name":"Baker, Andrew J.","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Laurent","familyName":"Chemin","name":"Chemin, Laurent","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Martin","familyName":"Meyer","name":"Meyer, Martin","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Danail","familyName":"Obreschkow","name":"Obreschkow, Danail","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Kristine","familyName":"Spekkens","name":"Spekkens, Kristine","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Natalia","familyName":"Stylianou","name":"Stylianou, Natalia","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Rohan G.","familyName":"Varadaraj","name":"Varadaraj, Rohan G.","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Marcin","familyName":"Glowacki","name":"Glowacki, Marcin","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Maarten","familyName":"Baes","name":"Baes, Maarten","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Abhisek","familyName":"Mohapatra","name":"Mohapatra, Abhisek","affiliation":[],"nameIdentifiers":[]}],"titles":[{"title":"MIGHTEE-HI / LADUMA: Investigating the link between baryons and dynamics with 130 resolved HI-selected galaxies"}],"publisher":"arXiv","container":{},"publicationYear":2026,"subjects":[{"subject":"Astrophysics of Galaxies (astro-ph.GA)","lang":"en","subjectScheme":"arXiv"},{"subject":"FOS: Physical sciences","subjectScheme":"Fields of Science and Technology (FOS)"}],"contributors":[],"dates":[{"date":"2026-08-04T12:32:42Z","dateType":"Submitted","dateInformation":"v1"},{"date":"2026-08-05T00:50:48Z","dateType":"Updated","dateInformation":"v1"},{"date":"2026-08","dateType":"Available","dateInformation":"v1"}],"language":null,"types":{"schemaOrg":"CreativeWork","resourceTypeGeneral":"Preprint","citeproc":"article","bibtex":"misc","ris":"GEN","resourceType":"Article"},"relatedIdentifiers":[],"relatedItems":[],"sizes":[],"formats":[],"version":"1","rightsList":[{"rightsIdentifierScheme":"SPDX","rightsUri":"https://creativecommons.org/licenses/by/4.0/legalcode","schemeUri":"https://spdx.org/licenses/","rights":"Creative Commons Attribution 4.0 International","rightsIdentifier":"cc-by-4.0"}],"descriptions":[{"descriptionType":"Abstract","description":"The baryonic Tully-Fisher relation (bTFR) and the radial acceleration relation (RAR) link the observed dynamics in galaxies to that expected from their baryonic mass distributions. The relations' small intrinsic scatters place strong constraints on galaxy formation models, dark matter properties and theories of modified dynamics, yet detailed measurements beyond the very local Universe remain limited. We use 130 purely HI-selected galaxies with resolved HI kinematics and baryonic mass profiles to measure the bTFR and RAR up to $z\\approx0.09$.\n We measure a tight RAR with an acceleration scale $a_0=(1.50\\pm0.05)\\times10^{-10},{\\rm m,s^{-2}}$ and an intrinsic scatter of $0.096\\pm0.006$ dex, consistent with local results. We fit the bTFR in the `inverse' direction, conditioning on $M_{\\rm bar}$ to mitigate HI flux-related selection effects, measuring a logarithmic slope of $0.27\\pm0.01$ (corresponding to a forward slope of $3.72\\pm0.16$), with vertical intrinsic scatter $σ_\\perp\\approx0.05$ dex. Fitting the general $δ$-family of MOND interpolating functions to the RAR, we infer $δ=4.10^{+1.4}_{-0.68}$, consistent with the value required by Solar System gravitational constraints and a null Wide Binary Test. We find no significant redshift evolution in the RAR acceleration scale for our pure HI-selected sample. However, the bTFR zero-point shows an apparent evolutionary trend that is strongly dependent on the fit direction: the traditional forward fit yields an $8.7σ$ preference for $z$ evolution, while for our fiducial inverse fit, this reduces to $3.4σ$, within $\\approx2σ$ of the RAR evolution constraint. This suggests selection effects bias the forward fit; a careful consideration of such effects will be required in future endeavours to robustly measure the redshift evolution of dynamical scaling relations."},{"descriptionType":"Other","description":"21 pages, 18 figures"}],"geoLocations":[],"fundingReferences":[],"url":"https://arxiv.org/abs/2608.03576","contentUrl":null,"metadataVersion":0,"schemaVersion":"http://datacite.org/schema/kernel-4","source":"mds","isActive":true,"state":"findable","reason":null,"viewCount":0,"downloadCount":0,"referenceCount":0,"citationCount":0,"partCount":0,"partOfCount":0,"versionCount":0,"versionOfCount":0,"created":"2026-08-05T02:16:08Z","registered":null,"published":null,"updated":"2026-08-05T02:16:09Z"},"relationships":{"client":{"data":{"id":"arxiv.content","type":"clients"}}}},{"id":"10.48550/arxiv.2608.03575","type":"dois","attributes":{"doi":"10.48550/arxiv.2608.03575","identifiers":[{"identifier":"2608.03575","identifierType":"arXiv"}],"creators":[{"nameType":"Personal","givenName":"Huabin","familyName":"Ge","name":"Ge, Huabin","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Yangxiang","familyName":"Lu","name":"Lu, Yangxiang","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Chuwen","familyName":"Wang","name":"Wang, Chuwen","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Tian","familyName":"Zhou","name":"Zhou, Tian","affiliation":[],"nameIdentifiers":[]}],"titles":[{"title":"A Gauss-Bonnet-Type Dichotomy for Unimodular Random Infinite Trivalent Hyperbolic Polyhedra"}],"publisher":"arXiv","container":{},"publicationYear":2026,"subjects":[{"subject":"Probability (math.PR)","lang":"en","subjectScheme":"arXiv"},{"subject":"Differential Geometry (math.DG)","lang":"en","subjectScheme":"arXiv"},{"subject":"Geometric Topology (math.GT)","lang":"en","subjectScheme":"arXiv"},{"subject":"FOS: Mathematics","subjectScheme":"Fields of Science and Technology (FOS)"}],"contributors":[],"dates":[{"date":"2026-08-04T12:32:41Z","dateType":"Submitted","dateInformation":"v1"},{"date":"2026-08-05T00:50:47Z","dateType":"Updated","dateInformation":"v1"},{"date":"2026-08","dateType":"Available","dateInformation":"v1"}],"language":null,"types":{"schemaOrg":"CreativeWork","resourceTypeGeneral":"Preprint","citeproc":"article","bibtex":"misc","ris":"GEN","resourceType":"Article"},"relatedIdentifiers":[],"relatedItems":[],"sizes":[],"formats":[],"version":"1","rightsList":[{"rightsIdentifierScheme":"SPDX","rightsUri":"https://creativecommons.org/licenses/by-nc-nd/4.0/legalcode","schemeUri":"https://spdx.org/licenses/","rights":"Creative Commons Attribution Non Commercial No Derivatives 4.0 International","rightsIdentifier":"cc-by-nc-nd-4.0"}],"descriptions":[{"descriptionType":"Abstract","description":"We develop a unified geometric and probabilistic theory of conformal type for unimodular random infinite trivalent hyperbolic polyhedra in $\\mathbb{H}^3$. By corresponding these with dual angled disk triangulations and regular circle patterns, we associate to each face an intrinsic geometric characteristic number $L_f(P)$, determined entirely by local dihedral geometry. For the root face $f$, we establish the unimodular Gauss-Bonnet formula $\\mathbb{E}[L_f(P)] = 2π- (π/3)\\mathbb{E}[deg(f)]$. Under natural tameness and admissibility assumptions, this yields a sharp dichotomy: a unimodular random trivalent hyperbolic polyhedron is parabolic precisely when $\\mathbb{E}[L_f(P)] = 0$, and hyperbolic when $\\mathbb{E}[L_f(P)] \u0026lt; 0$. Thus, global conformal type is governed by the expectation of a local geometric quantity.\n We also investigate the approximation of infinite polyhedra by finite ones. We prove that every admissible Benjamini-Schramm limit of uniformly face-rooted finite trivalent hyperbolic polyhedra is necessarily parabolic, revealing a geometric and topological obstruction to the existence of hyperbolic unimodular polyhedral limits.\n To study stochastic behavior in the hyperbolic regime, we overcome the failure of classical circle packing tools for unbounded degrees by establishing a refined ring lemma for regular circle patterns. This yields effective exponential control of adjacent circle radii via local flower degrees. Combined with boundary methods, we identify the Poisson boundary with the circle at infinity and prove positive hyperbolic speed for the face random walk. These results provide the first quantitative framework connecting local three-dimensional dihedral geometry, global conformal type, and asymptotic stochastic behavior of unimodular random infinite hyperbolic polyhedra."}],"geoLocations":[],"fundingReferences":[],"url":"https://arxiv.org/abs/2608.03575","contentUrl":null,"metadataVersion":0,"schemaVersion":"http://datacite.org/schema/kernel-4","source":"mds","isActive":true,"state":"findable","reason":null,"viewCount":0,"downloadCount":0,"referenceCount":0,"citationCount":0,"partCount":0,"partOfCount":0,"versionCount":0,"versionOfCount":0,"created":"2026-08-05T02:16:07Z","registered":null,"published":null,"updated":"2026-08-05T02:16:07Z"},"relationships":{"client":{"data":{"id":"arxiv.content","type":"clients"}}}},{"id":"10.48550/arxiv.2608.03574","type":"dois","attributes":{"doi":"10.48550/arxiv.2608.03574","identifiers":[{"identifier":"2608.03574","identifierType":"arXiv"}],"creators":[{"nameType":"Personal","givenName":"Aparna","familyName":"Gupta","name":"Gupta, Aparna","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Avijit","familyName":"Pal","name":"Pal, Avijit","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Bhaskar","familyName":"Paul","name":"Paul, Bhaskar","affiliation":[],"nameIdentifiers":[]}],"titles":[{"title":"On the Dilation Theory and Canonical Decomposition of $\\mathbfΘ_n$-Contractions"}],"publisher":"arXiv","container":{},"publicationYear":2026,"subjects":[{"subject":"Functional Analysis (math.FA)","lang":"en","subjectScheme":"arXiv"},{"subject":"Complex Variables (math.CV)","lang":"en","subjectScheme":"arXiv"},{"subject":"FOS: Mathematics","subjectScheme":"Fields of Science and Technology (FOS)"},{"subject":"$\\mathbf{\\Theta}_n$-contraction, $\\mathbf{\\Theta}_n$-unitary, $\\mathbf{\\Theta}_n$-isometry, Conditional dilation, $\\mu$-synthesis domains","lang":"en","subjectScheme":"MSC"}],"contributors":[],"dates":[{"date":"2026-08-04T12:32:26Z","dateType":"Submitted","dateInformation":"v1"},{"date":"2026-08-05T00:50:47Z","dateType":"Updated","dateInformation":"v1"},{"date":"2026-08","dateType":"Available","dateInformation":"v1"}],"language":null,"types":{"schemaOrg":"CreativeWork","resourceTypeGeneral":"Preprint","citeproc":"article","bibtex":"misc","ris":"GEN","resourceType":"Article"},"relatedIdentifiers":[],"relatedItems":[],"sizes":[],"formats":[],"version":"1","rightsList":[{"rightsIdentifierScheme":"SPDX","rightsUri":"https://creativecommons.org/licenses/by/4.0/legalcode","schemeUri":"https://spdx.org/licenses/","rights":"Creative Commons Attribution 4.0 International","rightsIdentifier":"cc-by-4.0"}],"descriptions":[{"descriptionType":"Abstract","description":"This paper studies the domain $\\mathbfΘ_n$ from the perspective of operator theory. We obtain several characterizations of $\\mathbfΘ_n$-contractions (respectively, $\\mathbfΘ_n$-unitaries and $\\mathbfΘ_n$-isometries) and establish their relationships with $Γ_n$-contractions (respectively, $Γ_n$-unitaries and $Γ_n$-isometries), tetrablock contractions (respectively, tetrablock unitaries and tetrablock isometries), and $\\mathbfΘ_{n+1}$-contractions (respectively, $\\mathbfΘ_{n+1}$-unitaries and $\\mathbfΘ_{n+1}$-isometries). We prove that every $\\mathbfΘ_n$-contraction admits a canonical decomposition into the direct sum of a $\\mathbfΘ_n$-unitary and a completely non-unitary $\\mathbfΘ_n$-contraction. We further develop a dilation theory for $\\mathbfΘ_n$-contractions by obtaining necessary and sufficient conditions for the existence of minimal $\\mathbfΘ_n$-isometric dilations. As an application, we show that the minimal $Γ_n$-isometric dilation arises as a special case of the minimal $\\mathbfΘ_n$-isometric dilation. Finally, we identify a class of $\\mathbfΘ_2$-contractions that always admit $\\mathbfΘ_2$-isometric extensions."},{"descriptionType":"Other","description":"This is the initial version. Final version will submit soon"}],"geoLocations":[],"fundingReferences":[],"url":"https://arxiv.org/abs/2608.03574","contentUrl":null,"metadataVersion":0,"schemaVersion":"http://datacite.org/schema/kernel-4","source":"mds","isActive":true,"state":"findable","reason":null,"viewCount":0,"downloadCount":0,"referenceCount":0,"citationCount":0,"partCount":0,"partOfCount":0,"versionCount":0,"versionOfCount":0,"created":"2026-08-05T02:16:05Z","registered":null,"published":null,"updated":"2026-08-05T02:16:06Z"},"relationships":{"client":{"data":{"id":"arxiv.content","type":"clients"}}}},{"id":"10.48550/arxiv.2608.03572","type":"dois","attributes":{"doi":"10.48550/arxiv.2608.03572","identifiers":[{"identifier":"2608.03572","identifierType":"arXiv"}],"creators":[{"nameType":"Personal","givenName":"Zakarias Sjöström","familyName":"Dyrefelt","name":"Dyrefelt, Zakarias Sjöström","affiliation":[],"nameIdentifiers":[]}],"titles":[{"title":"CscK metrics on birational models of projective varieties"}],"publisher":"arXiv","container":{},"publicationYear":2026,"subjects":[{"subject":"Differential Geometry (math.DG)","lang":"en","subjectScheme":"arXiv"},{"subject":"Algebraic Geometry (math.AG)","lang":"en","subjectScheme":"arXiv"},{"subject":"FOS: Mathematics","subjectScheme":"Fields of Science and Technology (FOS)"}],"contributors":[],"dates":[{"date":"2026-08-04T12:32:22Z","dateType":"Submitted","dateInformation":"v1"},{"date":"2026-08-05T00:50:40Z","dateType":"Updated","dateInformation":"v1"},{"date":"2026-08","dateType":"Available","dateInformation":"v1"}],"language":null,"types":{"schemaOrg":"CreativeWork","resourceTypeGeneral":"Preprint","citeproc":"article","bibtex":"misc","ris":"GEN","resourceType":"Article"},"relatedIdentifiers":[],"relatedItems":[],"sizes":[],"formats":[],"version":"1","rightsList":[{"rightsUri":"http://arxiv.org/licenses/nonexclusive-distrib/1.0/","rights":"arXiv.org perpetual, non-exclusive license"}],"descriptions":[{"descriptionType":"Abstract","description":"We prove that every complex projective variety is birational to a smooth projective manifold admitting a constant scalar curvature Kähler (cscK) metric. For any smooth projective variety, a birational cscK model is obtained by resolving the codimension two base locus of a general Lefschetz pencil in a sufficiently positive linear system. The cscK polarization is given explicitly, producing a cscK model also when the initial variety is unstable. In dimension two this proves the folklore conjecture that the blowup of any complex projective surface in enough points admits cscK metrics."},{"descriptionType":"Other","description":"30 pages, comments very welcome"}],"geoLocations":[],"fundingReferences":[],"url":"https://arxiv.org/abs/2608.03572","contentUrl":null,"metadataVersion":0,"schemaVersion":"http://datacite.org/schema/kernel-4","source":"mds","isActive":true,"state":"findable","reason":null,"viewCount":0,"downloadCount":0,"referenceCount":0,"citationCount":0,"partCount":0,"partOfCount":0,"versionCount":0,"versionOfCount":0,"created":"2026-08-05T02:16:03Z","registered":null,"published":null,"updated":"2026-08-05T02:16:03Z"},"relationships":{"client":{"data":{"id":"arxiv.content","type":"clients"}}}},{"id":"10.48550/arxiv.2608.03570","type":"dois","attributes":{"doi":"10.48550/arxiv.2608.03570","identifiers":[{"identifier":"2608.03570","identifierType":"arXiv"}],"creators":[{"nameType":"Personal","givenName":"Steven M.","familyName":"Radil","name":"Radil, Steven M.","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Olivier J.","familyName":"Walther","name":"Walther, Olivier J.","affiliation":[],"nameIdentifiers":[]}],"titles":[{"title":"Cities and political violence in West Africa"}],"publisher":"arXiv","container":{},"publicationYear":2026,"subjects":[{"subject":"General Economics (econ.GN)","lang":"en","subjectScheme":"arXiv"},{"subject":"Applications (stat.AP)","lang":"en","subjectScheme":"arXiv"},{"subject":"FOS: Economics and business","subjectScheme":"Fields of Science and Technology (FOS)"},{"subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"}],"contributors":[],"dates":[{"date":"2026-08-04T12:30:43Z","dateType":"Submitted","dateInformation":"v1"},{"date":"2026-08-05T00:50:37Z","dateType":"Updated","dateInformation":"v1"},{"date":"2026-08","dateType":"Available","dateInformation":"v1"}],"language":null,"types":{"schemaOrg":"CreativeWork","resourceTypeGeneral":"Preprint","citeproc":"article","bibtex":"misc","ris":"GEN","resourceType":"Article"},"relatedIdentifiers":[],"relatedItems":[],"sizes":[],"formats":[],"version":"1","rightsList":[{"rightsIdentifierScheme":"SPDX","rightsUri":"https://creativecommons.org/licenses/by-nc-nd/4.0/legalcode","schemeUri":"https://spdx.org/licenses/","rights":"Creative Commons Attribution Non Commercial No Derivatives 4.0 International","rightsIdentifier":"cc-by-nc-nd-4.0"}],"descriptions":[{"descriptionType":"Abstract","description":"This paper examines how political violence in West Africa is distributed between urban agglomerations and their surrounding areas using spatially disaggregated conflict and population data. Covering seventeen countries from 2012 to mid-2025, the analysis shows that political violence remains clearly tied to cities and their peripheries with the majority of violence occurring within and around urban agglomerations. Large cities record the highest number of incidents within their boundaries, while smaller towns, which are more frequently situated near borders, typically experience higher levels of violence outside their boundaries. However, urban-centric violence has also declined since 2012, indicating a progressive ruralization of conflict. These findings provide important regional context to the urbanization of conflict narrative by showing that West African insurgent movements use both urban and rural environments strategically. They also underscore the ongoing vulnerability of peripheral populations and the need for mobile and community-based security approaches outside major cities. Finally, they highlight the importance of strengthening border infrastructure, transport networks, and civic institutions as tools of both development and security."}],"geoLocations":[],"fundingReferences":[],"url":"https://arxiv.org/abs/2608.03570","contentUrl":null,"metadataVersion":0,"schemaVersion":"http://datacite.org/schema/kernel-4","source":"mds","isActive":true,"state":"findable","reason":null,"viewCount":0,"downloadCount":0,"referenceCount":0,"citationCount":0,"partCount":0,"partOfCount":0,"versionCount":0,"versionOfCount":0,"created":"2026-08-05T02:16:00Z","registered":"2026-08-05T02:16:01Z","published":null,"updated":"2026-08-05T02:16:01Z"},"relationships":{"client":{"data":{"id":"arxiv.content","type":"clients"}}}},{"id":"10.48550/arxiv.2608.03569","type":"dois","attributes":{"doi":"10.48550/arxiv.2608.03569","identifiers":[{"identifier":"2608.03569","identifierType":"arXiv"}],"creators":[{"nameType":"Personal","givenName":"William","familyName":"Bolton","name":"Bolton, William","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Philip","familyName":"Torr","name":"Torr, Philip","affiliation":[],"nameIdentifiers":[]}],"titles":[{"title":"Adversarial Fast-Moving Real-World Domains as Test Beds for Benchmarking AI Scientist Capabilities"}],"publisher":"arXiv","container":{},"publicationYear":2026,"subjects":[{"subject":"Artificial Intelligence (cs.AI)","lang":"en","subjectScheme":"arXiv"},{"subject":"Computers and Society (cs.CY)","lang":"en","subjectScheme":"arXiv"},{"subject":"Machine Learning (cs.LG)","lang":"en","subjectScheme":"arXiv"},{"subject":"Multiagent Systems (cs.MA)","lang":"en","subjectScheme":"arXiv"},{"subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"}],"contributors":[],"dates":[{"date":"2026-08-04T12:30:13Z","dateType":"Submitted","dateInformation":"v1"},{"date":"2026-08-05T00:50:36Z","dateType":"Updated","dateInformation":"v1"},{"date":"2026-08","dateType":"Available","dateInformation":"v1"}],"language":null,"types":{"schemaOrg":"CreativeWork","resourceTypeGeneral":"Preprint","citeproc":"article","bibtex":"misc","ris":"GEN","resourceType":"Article"},"relatedIdentifiers":[],"relatedItems":[],"sizes":[],"formats":[],"version":"1","rightsList":[{"rightsIdentifierScheme":"SPDX","rightsUri":"https://creativecommons.org/licenses/by-nc-sa/4.0/legalcode","schemeUri":"https://spdx.org/licenses/","rights":"Creative Commons Attribution Non Commercial Share Alike 4.0 International","rightsIdentifier":"cc-by-nc-sa-4.0"}],"descriptions":[{"descriptionType":"Abstract","description":"Benchmarking the ability of AI scientists to generate novel ideas is notoriously difficult. Existing benchmarks in this field have made progress in evaluating scientific reasoning and research replication, but often rely on synthetic tasks or retrospective targets, which may be confounded by prior exposure. We hypothesize that complex, adversarial, fast-moving real-world domains where expert practitioners independently generate observable outputs can provide a practical solution to fill this gap and evaluate the capabilities needed for AI scientists, including reasoning, novelty, and hypothesis formulation. We instantiate this framework in two structurally different domains, Formula 1 (F1), where models ideate around car design concepts for the 2026 season, and real pre-season innovations provide a ground truth, and Magic: The Gathering (MTG), where models propose decks from a recently updated card pool and are evaluated against 19 Pro Tour (PT) decklists. Across both domains, models produce plausible outputs, but few align with real-world expert solutions. In F1, the best model, GPT-5.2 matched 10 of 40 real innovations with 166 ideas proposed across runs. In MTG, the best deck from Gemini 3 Flash recovered 5 of 7 new-set cards from the third-place PT deck, and across all 108 decks, the cards models selected most often were also the cards most widely adopted by PT decks (Spearman $ρ= 0.74$, $p = 0.0003$). These results suggest that a key capability gap for AI scientists is not idea generation, but filtering, prioritization, and coherent novelty."},{"descriptionType":"Other","description":"Accepted at the AI for Science workshop at ICML 2026. 14 pages, 11 figures"}],"geoLocations":[],"fundingReferences":[],"url":"https://arxiv.org/abs/2608.03569","contentUrl":null,"metadataVersion":0,"schemaVersion":"http://datacite.org/schema/kernel-4","source":"mds","isActive":true,"state":"findable","reason":null,"viewCount":0,"downloadCount":0,"referenceCount":0,"citationCount":0,"partCount":0,"partOfCount":0,"versionCount":0,"versionOfCount":0,"created":"2026-08-05T02:15:58Z","registered":"2026-08-05T02:15:59Z","published":null,"updated":"2026-08-05T02:15:59Z"},"relationships":{"client":{"data":{"id":"arxiv.content","type":"clients"}}}},{"id":"10.48550/arxiv.2608.03568","type":"dois","attributes":{"doi":"10.48550/arxiv.2608.03568","identifiers":[{"identifier":"2608.03568","identifierType":"arXiv"}],"creators":[{"nameType":"Personal","givenName":"Abdul","familyName":"Ahad","name":"Ahad, Abdul","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Miuko","familyName":"Tanaka","name":"Tanaka, Miuko","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Shunta","familyName":"Aoki","name":"Aoki, Shunta","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Darius-Alexandru","familyName":"Deaconu","name":"Deaconu, Darius-Alexandru","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Varun","familyName":"Shah","name":"Shah, Varun","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Tenta","familyName":"Kitamura","name":"Kitamura, Tenta","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Hao","familyName":"Ou","name":"Ou, Hao","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Mohammad Saeed","familyName":"Bahramy","name":"Bahramy, Mohammad Saeed","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Jiang","familyName":"Pu","name":"Pu, Jiang","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Toshiya","familyName":"Ideue","name":"Ideue, Toshiya","affiliation":[],"nameIdentifiers":[]}],"titles":[{"title":"Strain Tuning of Orbital-Driven Giant Magnetoresistance in van der Waals ferrimagnet Mn$_3$Si$_2$Te$_6$"}],"publisher":"arXiv","container":{},"publicationYear":2026,"subjects":[{"subject":"Materials Science (cond-mat.mtrl-sci)","lang":"en","subjectScheme":"arXiv"},{"subject":"Mesoscale and Nanoscale Physics (cond-mat.mes-hall)","lang":"en","subjectScheme":"arXiv"},{"subject":"FOS: Physical sciences","subjectScheme":"Fields of Science and Technology (FOS)"}],"contributors":[],"dates":[{"date":"2026-08-04T12:30:10Z","dateType":"Submitted","dateInformation":"v1"},{"date":"2026-08-05T00:50:35Z","dateType":"Updated","dateInformation":"v1"},{"date":"2026-08","dateType":"Available","dateInformation":"v1"}],"language":null,"types":{"schemaOrg":"CreativeWork","resourceTypeGeneral":"Preprint","citeproc":"article","bibtex":"misc","ris":"GEN","resourceType":"Article"},"relatedIdentifiers":[],"relatedItems":[],"sizes":[],"formats":[],"version":"1","rightsList":[{"rightsUri":"http://arxiv.org/licenses/nonexclusive-distrib/1.0/","rights":"arXiv.org perpetual, non-exclusive license"}],"descriptions":[{"descriptionType":"Abstract","description":"Strain engineering of magnetotransport offers a powerful strategy for uncovering emergent electronic and domain phenomena in quantum magnetic materials, while providing a promising pathway toward next-generation mechanically programmable spintronic technologies. Van der Waals magnets are particularly attractive in this context because their high crystallinity and mechanical flexibility allow exceptionally large, precisely controllable strain, enabling access to strain-induced functionalities unattainable in conventional solids. Here, we report systematic strain control of the van der Waals magnet Mn$_3$Si$_2$Te$_6$, which exhibits an unconventional colossal magnetoresistance whose microscopic origin remains under debate. We demonstrate in situ large-strain modulation of the electrical resistance in bulk crystals and show that the effect can be consistently explained by strain-tunable chiral orbital-current domains. Furthermore, measurements on exfoliated flake devices containing a single chiral domain reveal direct strain control of the electronic structure affected by orbital magnetic moment, establishing a unified microscopic mechanism for the unconventional colossal magnetoresistance. These results identify strain as an exceptionally effective control parameter for tailoring electronic and magnetic states in van der Waals magnets and provide a conceptual framework for realizing spin-straintronic functionalities based on orbital degrees of freedom."}],"geoLocations":[],"fundingReferences":[],"url":"https://arxiv.org/abs/2608.03568","contentUrl":null,"metadataVersion":0,"schemaVersion":"http://datacite.org/schema/kernel-4","source":"mds","isActive":true,"state":"findable","reason":null,"viewCount":0,"downloadCount":0,"referenceCount":0,"citationCount":0,"partCount":0,"partOfCount":0,"versionCount":0,"versionOfCount":0,"created":"2026-08-05T02:15:57Z","registered":"2026-08-05T02:15:58Z","published":null,"updated":"2026-08-05T02:15:58Z"},"relationships":{"client":{"data":{"id":"arxiv.content","type":"clients"}}}},{"id":"10.48550/arxiv.2608.03566","type":"dois","attributes":{"doi":"10.48550/arxiv.2608.03566","identifiers":[{"identifier":"2608.03566","identifierType":"arXiv"}],"creators":[{"nameType":"Personal","givenName":"Yufei","familyName":"Wu","name":"Wu, Yufei","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Shanqing","familyName":"Gao","name":"Gao, Shanqing","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Andreas","familyName":"Voss","name":"Voss, Andreas","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Francis","familyName":"Tuerlinckx","name":"Tuerlinckx, Francis","affiliation":[],"nameIdentifiers":[]}],"titles":[{"title":"Divide-and-Conquer: Towards Generalizable Amortized Bayesian Inference for the Drift Diffusion Model"}],"publisher":"arXiv","container":{},"publicationYear":2026,"subjects":[{"subject":"Machine Learning (stat.ML)","lang":"en","subjectScheme":"arXiv"},{"subject":"Machine Learning (cs.LG)","lang":"en","subjectScheme":"arXiv"},{"subject":"Applications (stat.AP)","lang":"en","subjectScheme":"arXiv"},{"subject":"Methodology (stat.ME)","lang":"en","subjectScheme":"arXiv"},{"subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"}],"contributors":[],"dates":[{"date":"2026-08-04T12:29:47Z","dateType":"Submitted","dateInformation":"v1"},{"date":"2026-08-05T00:50:29Z","dateType":"Updated","dateInformation":"v1"},{"date":"2026-08","dateType":"Available","dateInformation":"v1"}],"language":null,"types":{"schemaOrg":"CreativeWork","resourceTypeGeneral":"Preprint","citeproc":"article","bibtex":"misc","ris":"GEN","resourceType":"Article"},"relatedIdentifiers":[],"relatedItems":[],"sizes":[],"formats":[],"version":"1","rightsList":[{"rightsIdentifierScheme":"SPDX","rightsUri":"https://creativecommons.org/licenses/by/4.0/legalcode","schemeUri":"https://spdx.org/licenses/","rights":"Creative Commons Attribution 4.0 International","rightsIdentifier":"cc-by-4.0"}],"descriptions":[{"descriptionType":"Abstract","description":"The drift diffusion model (DDM) is a cornerstone of cognitive decision-making research. Although numerous estimation methods exist, researchers continue to seek inference approaches that are both fast and flexible across diverse study designs. Amortized Bayesian inference (ABI) can provide nearly instantaneous inference for complex stochastic models like the DDM, but neural networks trained for one study design cannot generalize to others. In this paper, we propose a divide-and-conquer framework that address this limitation. The core idea is that the DDM's independence assumption allows the full dataset to be decomposed into pairwise shards, each sharing a common structure that a single neural network can learn. Inference is performed on each shard separately and the resulting posteriors are combined via consensus MCMC to approximate the full posterior. Using simulated datasets, we evaluate the accuracy and uncertainty of this method. Our results show that the proposed divide-and-conquer approach achieves accuracy and uncertainty comparable to MCMC while reducing computational cost by several orders of magnitude. This work not only advances DDM estimation but also demonstrates a general strategy for improving the scalability and generalizability of ABI methods across diverse applications."}],"geoLocations":[],"fundingReferences":[],"url":"https://arxiv.org/abs/2608.03566","contentUrl":null,"metadataVersion":0,"schemaVersion":"http://datacite.org/schema/kernel-4","source":"mds","isActive":true,"state":"findable","reason":null,"viewCount":0,"downloadCount":0,"referenceCount":0,"citationCount":0,"partCount":0,"partOfCount":0,"versionCount":0,"versionOfCount":0,"created":"2026-08-05T02:15:54Z","registered":null,"published":null,"updated":"2026-08-05T02:15:55Z"},"relationships":{"client":{"data":{"id":"arxiv.content","type":"clients"}}}},{"id":"10.48550/arxiv.2608.03565","type":"dois","attributes":{"doi":"10.48550/arxiv.2608.03565","identifiers":[{"identifier":"2608.03565","identifierType":"arXiv"}],"creators":[{"nameType":"Personal","givenName":"Günther","familyName":"Schindler","name":"Schindler, Günther","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Maximilian","familyName":"Schambach","name":"Schambach, Maximilian","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Johannes","familyName":"Höhne","name":"Höhne, Johannes","affiliation":[],"nameIdentifiers":[]}],"titles":[{"title":"Enhancing Tabular Learners with Context-Aware Semantic Embeddings"}],"publisher":"arXiv","container":{},"publicationYear":2026,"subjects":[{"subject":"Artificial Intelligence (cs.AI)","lang":"en","subjectScheme":"arXiv"},{"subject":"Machine Learning (cs.LG)","lang":"en","subjectScheme":"arXiv"},{"subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"}],"contributors":[],"dates":[{"date":"2026-08-04T12:29:37Z","dateType":"Submitted","dateInformation":"v1"},{"date":"2026-08-05T00:50:27Z","dateType":"Updated","dateInformation":"v1"},{"date":"2026-08","dateType":"Available","dateInformation":"v1"}],"language":null,"types":{"schemaOrg":"CreativeWork","resourceTypeGeneral":"Preprint","citeproc":"article","bibtex":"misc","ris":"GEN","resourceType":"Article"},"relatedIdentifiers":[],"relatedItems":[],"sizes":[],"formats":[],"version":"1","rightsList":[{"rightsUri":"http://arxiv.org/licenses/nonexclusive-distrib/1.0/","rights":"arXiv.org perpetual, non-exclusive license"}],"descriptions":[{"descriptionType":"Abstract","description":"While modern tabular learners excel at capturing statistical patterns, they frequently operate in a semantic vacuum, treating textual features as discrete symbols, ignoring the rich semantics inherent in feature names or cell entries. We propose CASE (Context-Aware Semantic Embeddings), a novel framework that bridges the gap between the semantic understanding of Large Language Models (LLMs) and the statistical capabilities of tabular learners. Unlike existing methods that embed rows in isolation, CASE utilizes a contextualization strategy: we pre-fill the KV cache of a custom-trained Gemma 3-based Tabular Language Model with a representative sample of rows to establish a persistent anchor of the dataset's semantics. This ensures that generated row embeddings are dynamically contextualized, resolving semantic ambiguities and anchoring representations in domain-specific context. Our experiments across several benchmarks (CARTE, TextTab, and TabArena) demonstrate that CASE substantially improves the performance of tabular learners on semantically rich datasets, particularly in low-data regimes."}],"geoLocations":[],"fundingReferences":[],"url":"https://arxiv.org/abs/2608.03565","contentUrl":null,"metadataVersion":0,"schemaVersion":"http://datacite.org/schema/kernel-4","source":"mds","isActive":true,"state":"findable","reason":null,"viewCount":0,"downloadCount":0,"referenceCount":0,"citationCount":0,"partCount":0,"partOfCount":0,"versionCount":0,"versionOfCount":0,"created":"2026-08-05T02:15:53Z","registered":"2026-08-05T02:15:53Z","published":null,"updated":"2026-08-05T02:15:53Z"},"relationships":{"client":{"data":{"id":"arxiv.content","type":"clients"}}}},{"id":"10.48550/arxiv.2608.03564","type":"dois","attributes":{"doi":"10.48550/arxiv.2608.03564","identifiers":[{"identifier":"2608.03564","identifierType":"arXiv"}],"creators":[{"nameType":"Personal","givenName":"Guilhem","familyName":"Mureau","name":"Mureau, Guilhem","affiliation":[],"nameIdentifiers":[]}],"titles":[{"title":"Explicit Jordan decompositions for ideal lattices in CM fields"}],"publisher":"arXiv","container":{},"publicationYear":2026,"subjects":[{"subject":"Number Theory (math.NT)","lang":"en","subjectScheme":"arXiv"},{"subject":"FOS: Mathematics","subjectScheme":"Fields of Science and Technology (FOS)"},{"subject":"11E12, 11E08, 11E95","lang":"en","subjectScheme":"MSC"}],"contributors":[],"dates":[{"date":"2026-08-04T12:29:32Z","dateType":"Submitted","dateInformation":"v1"},{"date":"2026-08-05T00:50:27Z","dateType":"Updated","dateInformation":"v1"},{"date":"2026-08","dateType":"Available","dateInformation":"v1"}],"language":null,"types":{"schemaOrg":"CreativeWork","resourceTypeGeneral":"Preprint","citeproc":"article","bibtex":"misc","ris":"GEN","resourceType":"Article"},"relatedIdentifiers":[],"relatedItems":[],"sizes":[],"formats":[],"version":"1","rightsList":[{"rightsIdentifierScheme":"SPDX","rightsUri":"https://creativecommons.org/licenses/by/4.0/legalcode","schemeUri":"https://spdx.org/licenses/","rights":"Creative Commons Attribution 4.0 International","rightsIdentifier":"cc-by-4.0"}],"descriptions":[{"descriptionType":"Abstract","description":"Let $E$ be a CM number field, $F$ a totally real subfield (e.g. $\\mathbb Q$), and let $\\mathfrak a$ be a non-zero fractional ideal of $E$. Endowed with the Hermitian trace form $h_{E/F}(x,y)=\\mathrm{Tr}_{E/F}(x\\overline{y})$, the ideal $\\mathfrak a$ defines an ideal lattice over $\\mathcal O_F$. In this paper, we give explicit formulas for the Jordan decomposition of this lattice at a prime ideal $\\mathfrak p\\subset\\mathcal O_F$, in terms of the prime ideal factorization of $\\mathfrak a$ in $E$. Following the approach of Erez, Morales, and Perlis, we reduce the computation to the local behavior at the primes above $\\mathfrak p$. Our results provide local invariants for the isometry relation between ideal lattices, with potential applications to the study of structured lattices arising in arithmetic and cryptography."},{"descriptionType":"Other","description":"30 pages"}],"geoLocations":[],"fundingReferences":[],"url":"https://arxiv.org/abs/2608.03564","contentUrl":null,"metadataVersion":0,"schemaVersion":"http://datacite.org/schema/kernel-4","source":"mds","isActive":true,"state":"findable","reason":null,"viewCount":0,"downloadCount":0,"referenceCount":0,"citationCount":0,"partCount":0,"partOfCount":0,"versionCount":0,"versionOfCount":0,"created":"2026-08-05T02:15:51Z","registered":null,"published":null,"updated":"2026-08-05T02:15:52Z"},"relationships":{"client":{"data":{"id":"arxiv.content","type":"clients"}}}},{"id":"10.48550/arxiv.2608.03563","type":"dois","attributes":{"doi":"10.48550/arxiv.2608.03563","identifiers":[{"identifier":"2608.03563","identifierType":"arXiv"}],"creators":[{"nameType":"Personal","givenName":"Zhenyang","familyName":"Feng","name":"Feng, Zhenyang","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Unnat","familyName":"Jain","name":"Jain, Unnat","affiliation":[],"nameIdentifiers":[]}],"titles":[{"title":"Unified Visuomotor Targets: Supervising VLAs Beyond Physical Actions"}],"publisher":"arXiv","container":{},"publicationYear":2026,"subjects":[{"subject":"Robotics (cs.RO)","lang":"en","subjectScheme":"arXiv"},{"subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"}],"contributors":[],"dates":[{"date":"2026-08-04T12:29:30Z","dateType":"Submitted","dateInformation":"v1"},{"date":"2026-08-05T00:50:25Z","dateType":"Updated","dateInformation":"v1"},{"date":"2026-08","dateType":"Available","dateInformation":"v1"}],"language":null,"types":{"schemaOrg":"CreativeWork","resourceTypeGeneral":"Preprint","citeproc":"article","bibtex":"misc","ris":"GEN","resourceType":"Article"},"relatedIdentifiers":[],"relatedItems":[],"sizes":[],"formats":[],"version":"1","rightsList":[{"rightsIdentifierScheme":"SPDX","rightsUri":"https://creativecommons.org/licenses/by-nc-sa/4.0/legalcode","schemeUri":"https://spdx.org/licenses/","rights":"Creative Commons Attribution Non Commercial Share Alike 4.0 International","rightsIdentifier":"cc-by-nc-sa-4.0"}],"descriptions":[{"descriptionType":"Abstract","description":"VLA models are trained to predict robot actions from visual and language observations. This is a natural choice, but it creates a mismatch: VLMs encode rich, high-level representations of scenes and goals, while robot actions are low-level signals with limited task structure. We ask whether changing what the policy is trained to predict, rather than how it is architecturally designed, can yield better and more efficiently trained policies. We propose UVT (Unified Visuomotor Target), a unified latent prediction target that jointly encodes motor control and visual scene transition information, requiring no architectural changes and no additional data. Applied to two representative VLA systems across simulation benchmarks and real bimanual manipulation tasks, UVT improves training efficiency, final task performance, and policy robustness, with particularly strong gains under limited training budgets and challenging environmental conditions. Rollout videos and additional qualitative results are available at our project webpage: https://unified-visuomotor-targets.github.io/"},{"descriptionType":"Other","description":"Accepted at IROS 2026. Project page: https://unified-visuomotor-targets.github.io/"}],"geoLocations":[],"fundingReferences":[],"url":"https://arxiv.org/abs/2608.03563","contentUrl":null,"metadataVersion":0,"schemaVersion":"http://datacite.org/schema/kernel-4","source":"mds","isActive":true,"state":"findable","reason":null,"viewCount":0,"downloadCount":0,"referenceCount":0,"citationCount":0,"partCount":0,"partOfCount":0,"versionCount":0,"versionOfCount":0,"created":"2026-08-05T02:15:50Z","registered":"2026-08-05T02:15:51Z","published":null,"updated":"2026-08-05T02:15:51Z"},"relationships":{"client":{"data":{"id":"arxiv.content","type":"clients"}}}},{"id":"10.48550/arxiv.2608.03562","type":"dois","attributes":{"doi":"10.48550/arxiv.2608.03562","identifiers":[{"identifier":"2608.03562","identifierType":"arXiv"}],"creators":[{"nameType":"Personal","givenName":"Zixuan","familyName":"Liu","name":"Liu, Zixuan","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Fangzheng","familyName":"Wu","name":"Wu, Fangzheng","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Brian","familyName":"Summa","name":"Summa, Brian","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Zizhan","familyName":"Zheng","name":"Zheng, Zizhan","affiliation":[],"nameIdentifiers":[]}],"titles":[{"title":"Robust General Utility for Reinforcement Learning"}],"publisher":"arXiv","container":{},"publicationYear":2026,"subjects":[{"subject":"Machine Learning (cs.LG)","lang":"en","subjectScheme":"arXiv"},{"subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"}],"contributors":[],"dates":[{"date":"2026-08-04T12:28:39Z","dateType":"Submitted","dateInformation":"v1"},{"date":"2026-08-05T00:50:19Z","dateType":"Updated","dateInformation":"v1"},{"date":"2026-08","dateType":"Available","dateInformation":"v1"}],"language":null,"types":{"schemaOrg":"CreativeWork","resourceTypeGeneral":"Preprint","citeproc":"article","bibtex":"misc","ris":"GEN","resourceType":"Article"},"relatedIdentifiers":[],"relatedItems":[],"sizes":[],"formats":[],"version":"1","rightsList":[{"rightsIdentifierScheme":"SPDX","rightsUri":"https://creativecommons.org/licenses/by-sa/4.0/legalcode","schemeUri":"https://spdx.org/licenses/","rights":"Creative Commons Attribution Share Alike 4.0 International","rightsIdentifier":"cc-by-sa-4.0"}],"descriptions":[{"descriptionType":"Abstract","description":"Reinforcement learning (RL) with general utility extends classic RL by optimizing an arbitrary utility functional of the policy-induced occupancy measure, thereby enabling a broader range of applications. However, previous work on general utility RL typically assumes the evaluation utility is fixed and correctly specified. In practice, the utility used at deployment can deviate from the training one, creating a robustness gap that prior work does not address. Motivated by this, we propose robust general-utility RL, a minimax learning framework that trains policies against utility misspecification within a prescribed uncertainty set. Our framework strictly generalizes standard general-utility RL while also providing a unified view of many existing RL frameworks, including reward-robust RL and constrained RL, through appropriate choices of the utility uncertainty set. We further develop provably convergent stochastic algorithms for two regimes. For concave utilities, we develop a projected stochastic gradient descent-ascent method and establish stationarity guarantees. For the more challenging nonconcave regime, we propose a stochastic prox-extragradient algorithm that mitigates ill-posed behavior induced by nonconcavity, with convergence guarantees to approximate first-order stationarity. Experiments on LLM safety alignment and exploration maximization tasks further corroborate the convergence behavior consistent with our theory."}],"geoLocations":[],"fundingReferences":[],"url":"https://arxiv.org/abs/2608.03562","contentUrl":null,"metadataVersion":0,"schemaVersion":"http://datacite.org/schema/kernel-4","source":"mds","isActive":true,"state":"findable","reason":null,"viewCount":0,"downloadCount":0,"referenceCount":0,"citationCount":0,"partCount":0,"partOfCount":0,"versionCount":0,"versionOfCount":0,"created":"2026-08-05T02:15:49Z","registered":"2026-08-05T02:15:49Z","published":null,"updated":"2026-08-05T02:15:49Z"},"relationships":{"client":{"data":{"id":"arxiv.content","type":"clients"}}}},{"id":"10.48550/arxiv.2608.03560","type":"dois","attributes":{"doi":"10.48550/arxiv.2608.03560","identifiers":[{"identifier":"2608.03560","identifierType":"arXiv"}],"creators":[{"nameType":"Personal","givenName":"Marine Le","familyName":"Blay","name":"Blay, Marine Le","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Joshua H. K.","familyName":"Saldi","name":"Saldi, Joshua H. K.","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Alexandre","familyName":"Morin","name":"Morin, Alexandre","affiliation":[],"nameIdentifiers":[]}],"titles":[{"title":"Control of collective activity to crystallize an oscillator gas"}],"publisher":"arXiv","container":{},"publicationYear":2026,"subjects":[{"subject":"Soft Condensed Matter (cond-mat.soft)","lang":"en","subjectScheme":"arXiv"},{"subject":"FOS: Physical sciences","subjectScheme":"Fields of Science and Technology (FOS)"}],"contributors":[],"dates":[{"date":"2026-08-04T12:27:17Z","dateType":"Submitted","dateInformation":"v1"},{"date":"2026-08-05T00:50:08Z","dateType":"Updated","dateInformation":"v1"},{"date":"2026-08","dateType":"Available","dateInformation":"v1"}],"language":null,"types":{"schemaOrg":"CreativeWork","resourceTypeGeneral":"Preprint","citeproc":"article","bibtex":"misc","ris":"GEN","resourceType":"Article"},"relatedIdentifiers":[{"relationType":"IsVersionOf","relatedIdentifier":"10.1038/s41567-025-02957-y","relatedIdentifierType":"DOI"}],"relatedItems":[],"sizes":[],"formats":[],"version":"1","rightsList":[{"rightsIdentifierScheme":"SPDX","rightsUri":"https://creativecommons.org/licenses/by/4.0/legalcode","schemeUri":"https://spdx.org/licenses/","rights":"Creative Commons Attribution 4.0 International","rightsIdentifier":"cc-by-4.0"}],"descriptions":[{"descriptionType":"Abstract","description":"Motility-induced phase separation occurs in assemblies of self-propelled units when activity is coupled negatively to density. In contrast, the consequences of a positive coupling between density and activity on the collective behaviour of active matter remain unexplored. Here, we show that collective activity can emerge from such a positive coupling among non-motile building blocks. We perform experiments with self-sustained oscillators powered by contact-charge electrophoresis. Although the oscillators are non-motile by design, they spontaneously form an active gas when confined together. The super-elastic nature of collisions constitutes a positive density-activity coupling and underlies the active gas properties. Elucidating the origin of binary collisions allows us to precisely control the structure of the active gas and its eventual crystallization. Beyond considering the overlooked positive coupling between density and activity, our work suggests that rich collective properties can emerge not only from the symmetry of interactions between active building blocks, but also from their adaptable and responsive behaviour."}],"geoLocations":[],"fundingReferences":[],"url":"https://arxiv.org/abs/2608.03560","contentUrl":null,"metadataVersion":0,"schemaVersion":"http://datacite.org/schema/kernel-4","source":"mds","isActive":true,"state":"findable","reason":null,"viewCount":0,"downloadCount":0,"referenceCount":0,"citationCount":0,"partCount":0,"partOfCount":0,"versionCount":0,"versionOfCount":1,"created":"2026-08-05T02:15:46Z","registered":"2026-08-05T02:15:47Z","published":null,"updated":"2026-08-05T02:15:47Z"},"relationships":{"client":{"data":{"id":"arxiv.content","type":"clients"}}}},{"id":"10.48550/arxiv.2608.03559","type":"dois","attributes":{"doi":"10.48550/arxiv.2608.03559","identifiers":[{"identifier":"2608.03559","identifierType":"arXiv"}],"creators":[{"nameType":"Personal","givenName":"Hui","familyName":"Liu","name":"Liu, Hui","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Chen","familyName":"Jia","name":"Jia, Chen","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Fan","familyName":"Shi","name":"Shi, Fan","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Xu","familyName":"Cheng","name":"Cheng, Xu","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Mianzhao","familyName":"Wang","name":"Wang, Mianzhao","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Shengyong","familyName":"Chen","name":"Chen, Shengyong","affiliation":[],"nameIdentifiers":[]}],"titles":[{"title":"Compass: Degradation-Simulated Reciprocal Learning with Lightweight Needle RWKV for Multimodal Crack Segmentation under Missing Modalities"}],"publisher":"arXiv","container":{},"publicationYear":2026,"subjects":[{"subject":"Computer Vision and Pattern Recognition (cs.CV)","lang":"en","subjectScheme":"arXiv"},{"subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"}],"contributors":[],"dates":[{"date":"2026-08-04T12:27:02Z","dateType":"Submitted","dateInformation":"v1"},{"date":"2026-08-05T00:50:06Z","dateType":"Updated","dateInformation":"v1"},{"date":"2026-08","dateType":"Available","dateInformation":"v1"}],"language":null,"types":{"schemaOrg":"CreativeWork","resourceTypeGeneral":"Preprint","citeproc":"article","bibtex":"misc","ris":"GEN","resourceType":"Article"},"relatedIdentifiers":[],"relatedItems":[],"sizes":[],"formats":[],"version":"1","rightsList":[{"rightsIdentifierScheme":"SPDX","rightsUri":"https://creativecommons.org/licenses/by/4.0/legalcode","schemeUri":"https://spdx.org/licenses/","rights":"Creative Commons Attribution 4.0 International","rightsIdentifier":"cc-by-4.0"}],"descriptions":[{"descriptionType":"Abstract","description":"In multimodal crack segmentation for industrial facilities, the key challenge is preventing missing modalities from degrading pixel-level performance while maintaining low computational cost. Existing methods struggle to address semantic degradation caused by missing modalities. We propose Compass, a lightweight network for robust crack segmentation under arbitrary missing modalities. Compass comprises Degradation Simulation Distillation (DSD), Needle Block, and Evidential Topology-Preserving Fusion (ETPF). DSD constructs a degradation simulation stream that mimics more severe missing conditions and performs reciprocal distillation with the original stream, decoupling complete perception from degradation adaptation. Within DSD, Feature-Aware Prototype Transmitter (FAPT) performs modality agnostic prototype-guided feature completion to maintain semantic integrity under incomplete modality conditions. As a lightweight backbone, Needle injects crack-direction cues into WKV modulation and combines connectivity-aware gating with anisotropic context probing for structure-aware modeling. ETPF fuses multimodal features via Dempster-Shafer evidential combination with uncertainty-gated decoding, preserving crack topology while suppressing unreliable features. Experiments on three datasets demonstrate state-of-the-art (SOTA) performance under diverse missing modality scenarios. Even with 90\\% depth modality missing on CrackDepth, Compass achieves F1 of 0.8216 and mIoU of 0.8434 with only 2.58M parameters. The code is available at https://github.com/Karl1109/Compass."},{"descriptionType":"Other","description":"This paper has been accepted by ACM MM 2026"}],"geoLocations":[],"fundingReferences":[],"url":"https://arxiv.org/abs/2608.03559","contentUrl":null,"metadataVersion":0,"schemaVersion":"http://datacite.org/schema/kernel-4","source":"mds","isActive":true,"state":"findable","reason":null,"viewCount":0,"downloadCount":0,"referenceCount":0,"citationCount":0,"partCount":0,"partOfCount":0,"versionCount":0,"versionOfCount":0,"created":"2026-08-05T02:15:45Z","registered":"2026-08-05T02:15:45Z","published":null,"updated":"2026-08-05T02:15:45Z"},"relationships":{"client":{"data":{"id":"arxiv.content","type":"clients"}}}},{"id":"10.48550/arxiv.2608.03558","type":"dois","attributes":{"doi":"10.48550/arxiv.2608.03558","identifiers":[{"identifier":"2608.03558","identifierType":"arXiv"}],"creators":[{"nameType":"Personal","givenName":"Haowen","familyName":"Yang","name":"Yang, Haowen","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Yun","familyName":"Peng","name":"Peng, Yun","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Zishuo","familyName":"Ding","name":"Ding, Zishuo","affiliation":[],"nameIdentifiers":[]}],"titles":[{"title":"EffiHolmes: Differential Profiling-Guided Repository Level Time Inefficiency Fix Localization"}],"publisher":"arXiv","container":{},"publicationYear":2026,"subjects":[{"subject":"Software Engineering (cs.SE)","lang":"en","subjectScheme":"arXiv"},{"subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"}],"contributors":[],"dates":[{"date":"2026-08-04T12:26:59Z","dateType":"Submitted","dateInformation":"v1"},{"date":"2026-08-05T00:50:05Z","dateType":"Updated","dateInformation":"v1"},{"date":"2026-08","dateType":"Available","dateInformation":"v1"}],"language":null,"types":{"schemaOrg":"CreativeWork","resourceTypeGeneral":"Preprint","citeproc":"article","bibtex":"misc","ris":"GEN","resourceType":"Article"},"relatedIdentifiers":[],"relatedItems":[],"sizes":[],"formats":[],"version":"1","rightsList":[{"rightsUri":"http://arxiv.org/licenses/nonexclusive-distrib/1.0/","rights":"arXiv.org perpetual, non-exclusive license"}],"descriptions":[{"descriptionType":"Abstract","description":"Large software systems often suffer from time inefficiencies that cause excessive execution time despite functional correctness. Localizing their fix locations is difficult because, unlike functional bugs, they produce neither test failures nor stack-trace clues, making traditional and recent LLM-based fault localization methods unsuitable. Runtime profiling provides alternative evidence but faces three challenges in repository-level settings: single-run profiling cannot reliably distinguish inefficiency hotspots from execution noise; existing profilers struggle to extract relevant execution paths from extensive background execution; and a semantic gap remains between observed hotspots and actual fix locations. We propose EffiHolmes, an LLM-based framework for repository-level time inefficiency fix localization. EffiHolmes uses differential profiling under default and scaled workloads to identify inefficiency hotspots, extracts compact execution paths connecting these hotspots to the reported inefficient function, and employs domain-guided LLM reasoning to locate the underlying inefficiency logic. We also introduce RepoEffi-Bench, the first benchmark for repository-level inefficiency localization, containing 140 high-quality issues collected from popular Python repositories. Experiments show that EffiHolmes consistently outperforms state-of-the-art retrieval-, agent-, and profiling-based baselines, improving file-level Acc@3 by 4.29 percentage points with GPT-5.1 and function-level Acc@5 by 15.00 percentage points with qwen3-4b. It also remains robust across model capacities."},{"descriptionType":"Other","description":"Accepted at the 41st IEEE/ACM International Conference on Automated Software Engineering (ASE 2026). 13 pages, 3 figures, and 4 tables"}],"geoLocations":[],"fundingReferences":[],"url":"https://arxiv.org/abs/2608.03558","contentUrl":null,"metadataVersion":0,"schemaVersion":"http://datacite.org/schema/kernel-4","source":"mds","isActive":true,"state":"findable","reason":null,"viewCount":0,"downloadCount":0,"referenceCount":0,"citationCount":0,"partCount":0,"partOfCount":0,"versionCount":0,"versionOfCount":0,"created":"2026-08-05T02:15:43Z","registered":"2026-08-05T02:15:44Z","published":null,"updated":"2026-08-05T02:15:44Z"},"relationships":{"client":{"data":{"id":"arxiv.content","type":"clients"}}}},{"id":"10.48550/arxiv.2608.03557","type":"dois","attributes":{"doi":"10.48550/arxiv.2608.03557","identifiers":[{"identifier":"2608.03557","identifierType":"arXiv"}],"creators":[{"nameType":"Personal","givenName":"Malena","familyName":"Loza","name":"Loza, Malena","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Felipe","familyName":"Grijalva","name":"Grijalva, Felipe","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Eva","familyName":"Milara","name":"Milara, Eva","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Luis","familyName":"Bote-Curiel","name":"Bote-Curiel, Luis","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Francisco J.","familyName":"Lara-Abelenda","name":"Lara-Abelenda, Francisco J.","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"David","familyName":"Chushig-Muzo","name":"Chushig-Muzo, David","affiliation":[],"nameIdentifiers":[]}],"titles":[{"title":"Test-Time Augmentation for Tabular-to-Image Classifiers under Distribution Shifts"}],"publisher":"arXiv","container":{},"publicationYear":2026,"subjects":[{"subject":"Computer Vision and Pattern Recognition (cs.CV)","lang":"en","subjectScheme":"arXiv"},{"subject":"Machine Learning (cs.LG)","lang":"en","subjectScheme":"arXiv"},{"subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"}],"contributors":[],"dates":[{"date":"2026-08-04T12:26:58Z","dateType":"Submitted","dateInformation":"v1"},{"date":"2026-08-05T00:50:04Z","dateType":"Updated","dateInformation":"v1"},{"date":"2026-08","dateType":"Available","dateInformation":"v1"}],"language":null,"types":{"schemaOrg":"CreativeWork","resourceTypeGeneral":"Preprint","citeproc":"article","bibtex":"misc","ris":"GEN","resourceType":"Article"},"relatedIdentifiers":[],"relatedItems":[],"sizes":[],"formats":[],"version":"1","rightsList":[{"rightsIdentifierScheme":"SPDX","rightsUri":"https://creativecommons.org/licenses/by-sa/4.0/legalcode","schemeUri":"https://spdx.org/licenses/","rights":"Creative Commons Attribution Share Alike 4.0 International","rightsIdentifier":"cc-by-sa-4.0"}],"descriptions":[{"descriptionType":"Abstract","description":"Tabular-to-image methods that convert tabular data into visual representations have emerged as a novel paradigm for leveraging the high performance of deep learning models. Despite their advantages, the robustness of these methods under distribution shifts remains under explored. Test-Time Augmentation (TTA) is an effective approach in image classification to improve model generalization and robustness, where predictions over multiple transformed views of each input are aggregated. This work evaluates the impact of TTA techniques on predictive performance under Out-Of-Distribution (OOD) for representations generated by tabular-to-image methods. Six tabular-to-image encoding methods were considered: TINTO, IGTD, DeepInsight, BIE, DistanceMatrix, Fotomics. Twenty-five TTA techniques were used, organized into six types: Geometric, Photometric, Structural, Frequency/Encoding, Mixup, and Composite. We employed two datasets from the TableShift benchmark (HELOC and Voting) that provide in-distribution and OOD test subsets designed to evaluate the effect of distribution shifts on tabular data. The results indicate that TTA improves OOD performance, with composite and photometric strategies providing the best trade-off between robustness and variance. In contrast, frequency-domain transformations that alter the encoder's feature-to-intensity mapping consistently degrade performance. These findings highlight TTA as a promising approach for improving the robustness and generalization of classifiers trained on image representations derived from tabular data, particularly under distribution shifts."}],"geoLocations":[],"fundingReferences":[],"url":"https://arxiv.org/abs/2608.03557","contentUrl":null,"metadataVersion":0,"schemaVersion":"http://datacite.org/schema/kernel-4","source":"mds","isActive":true,"state":"findable","reason":null,"viewCount":0,"downloadCount":0,"referenceCount":0,"citationCount":0,"partCount":0,"partOfCount":0,"versionCount":0,"versionOfCount":0,"created":"2026-08-05T02:15:42Z","registered":null,"published":null,"updated":"2026-08-05T02:15:42Z"},"relationships":{"client":{"data":{"id":"arxiv.content","type":"clients"}}}},{"id":"10.48550/arxiv.2608.03556","type":"dois","attributes":{"doi":"10.48550/arxiv.2608.03556","identifiers":[{"identifier":"2608.03556","identifierType":"arXiv"}],"creators":[{"nameType":"Personal","givenName":"Rainier","familyName":"Natividad","name":"Natividad, Rainier","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Raye Chen-Hua","familyName":"Yeow","name":"Yeow, Raye Chen-Hua","affiliation":[],"nameIdentifiers":[]}],"titles":[{"title":"Human Centric Embodied Intelligence for Soft Wearable Robotics"}],"publisher":"arXiv","container":{},"publicationYear":2026,"subjects":[{"subject":"Robotics (cs.RO)","lang":"en","subjectScheme":"arXiv"},{"subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"}],"contributors":[],"dates":[{"date":"2026-08-04T12:26:14Z","dateType":"Submitted","dateInformation":"v1"},{"date":"2026-08-05T00:50:03Z","dateType":"Updated","dateInformation":"v1"},{"date":"2026-08","dateType":"Available","dateInformation":"v1"}],"language":null,"types":{"schemaOrg":"CreativeWork","resourceTypeGeneral":"Preprint","citeproc":"article","bibtex":"misc","ris":"GEN","resourceType":"Article"},"relatedIdentifiers":[],"relatedItems":[],"sizes":[],"formats":[],"version":"1","rightsList":[{"rightsUri":"http://arxiv.org/licenses/nonexclusive-distrib/1.0/","rights":"arXiv.org perpetual, non-exclusive license"}],"descriptions":[{"descriptionType":"Abstract","description":"Soft wearable robots have evolved rapidly from proof-of-concept devices into promising platforms for rehabilitation, occupational assistance, and human augmentation. As the field matures, its central challenge extends beyond the development of softer materials and more capable actuators to the integration of sensing, intelligence, and human adaptation into systems that users can wear comfortably, trust, and benefit from over extended periods. This transition motivates the concept of Human-Centric Embodied Intelligence (HCEI), in which intelligence emerges from the coupled human-robot system through the interaction of morphology, multimodal sensing, adaptive cognition, compliant actuation, and the wearer's own physiological and behavioral adaptation. To organize this perspective, this review introduces the Perception-Cognition-Actuation-Augmentation (PCAA) framework, which positions perception and cognition as the primary drivers of design, shifting development beyond the conventional actuator-first paradigm. Using this framework, the review synthesizes advances in soft materials, wearable sensing, artificial intelligence, actuation, human-robot interaction, digital twins, clinical translation, manufacturing, regulation, and ethics, highlighting how these interdependent components collectively shape long-term personalization and real-world deployment. By providing a unified conceptual framework and design perspective, this review aims to guide future research, foster interdisciplinary collaboration, and accelerate the translation of next-generation soft wearable robots toward personalized, predictive, and human-centric wearable intelligence."},{"descriptionType":"Other","description":"Review article; 48 pages, 6 figures, 4 tables, and 2 supplementary tables"}],"geoLocations":[],"fundingReferences":[],"url":"https://arxiv.org/abs/2608.03556","contentUrl":null,"metadataVersion":0,"schemaVersion":"http://datacite.org/schema/kernel-4","source":"mds","isActive":true,"state":"findable","reason":null,"viewCount":0,"downloadCount":0,"referenceCount":0,"citationCount":0,"partCount":0,"partOfCount":0,"versionCount":0,"versionOfCount":0,"created":"2026-08-05T02:15:41Z","registered":null,"published":null,"updated":"2026-08-05T02:15:41Z"},"relationships":{"client":{"data":{"id":"arxiv.content","type":"clients"}}}},{"id":"10.48550/arxiv.2608.03555","type":"dois","attributes":{"doi":"10.48550/arxiv.2608.03555","identifiers":[{"identifier":"2608.03555","identifierType":"arXiv"}],"creators":[{"nameType":"Personal","givenName":"Hyungkyu","familyName":"Ham","name":"Ham, Hyungkyu","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Junhyeong","familyName":"Bae","name":"Bae, Junhyeong","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Seungheon","familyName":"Lee","name":"Lee, Seungheon","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Myeongjae","familyName":"Jeon","name":"Jeon, Myeongjae","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Gwangsun","familyName":"Kim","name":"Kim, Gwangsun","affiliation":[],"nameIdentifiers":[]}],"titles":[{"title":"Heterogeneous LLM Serving with General-Purpose Processing-Near-Memory for Retrieval-Based Sparse Attention"}],"publisher":"arXiv","container":{},"publicationYear":2026,"subjects":[{"subject":"Hardware Architecture (cs.AR)","lang":"en","subjectScheme":"arXiv"},{"subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"}],"contributors":[],"dates":[{"date":"2026-08-04T12:25:45Z","dateType":"Submitted","dateInformation":"v1"},{"date":"2026-08-05T00:50:02Z","dateType":"Updated","dateInformation":"v1"},{"date":"2026-08","dateType":"Available","dateInformation":"v1"}],"language":null,"types":{"schemaOrg":"CreativeWork","resourceTypeGeneral":"Preprint","citeproc":"article","bibtex":"misc","ris":"GEN","resourceType":"Article"},"relatedIdentifiers":[],"relatedItems":[],"sizes":[],"formats":[],"version":"1","rightsList":[{"rightsUri":"http://arxiv.org/licenses/nonexclusive-distrib/1.0/","rights":"arXiv.org perpetual, non-exclusive license"}],"descriptions":[{"descriptionType":"Abstract","description":"This paper presents a heterogeneous decode-phase serving system that relocates the KV cache out of GPU memory, motivated by the retrieval-based sparse attention that recent frontier LLMs adopt to serve million-token contexts. It partitions a decode step by operation type: GPU nodes hold the model weights and execute the projections and MoE layers, while processing-near-memory (PNM) nodes hold the KV cache and index keys and execute every operation that reads them. We first show that the assumptions behind prior PIM and PNM designs no longer hold for these operations, and derive four design requirements for such a node. From these requirements, we propose KARAT (KV-cache-resident Accelerator for Retrieval-based ATtention), a general-purpose PNM design that is the design point meeting all four. A KARAT device combines large LPDDR capacity with general-purpose compute sized for the retrieval indexer, serving an operational intensity beyond what PIM/PNM designs built for low-intensity GEMV target while accommodating diverse sparse attention algorithms that fixed-function units cannot support as they evolve. To reduce pipeline bubbles as the two device types alternate between micro-batches, we further propose opportunistic, fine-grained micro-batch scheduling (OFMS), which hides expert all-to-all behind the other micro-batch's GEMMs, and context-length-aware micro-batch rebalancing (CMR), which equalizes their token counts despite the variance in context length. Across three state-of-the-art models and real agentic traces, our proposed system improves throughput per TDP under a service-level objective by 2.09-6.13x over a GPU-only baseline and runs training-free sparse attention methods with 1.36-3.21x improvements."}],"geoLocations":[],"fundingReferences":[],"url":"https://arxiv.org/abs/2608.03555","contentUrl":null,"metadataVersion":0,"schemaVersion":"http://datacite.org/schema/kernel-4","source":"mds","isActive":true,"state":"findable","reason":null,"viewCount":0,"downloadCount":0,"referenceCount":0,"citationCount":0,"partCount":0,"partOfCount":0,"versionCount":0,"versionOfCount":0,"created":"2026-08-05T02:15:39Z","registered":"2026-08-05T02:15:40Z","published":null,"updated":"2026-08-05T02:15:40Z"},"relationships":{"client":{"data":{"id":"arxiv.content","type":"clients"}}}},{"id":"10.48550/arxiv.2608.03554","type":"dois","attributes":{"doi":"10.48550/arxiv.2608.03554","identifiers":[{"identifier":"2608.03554","identifierType":"arXiv"}],"creators":[{"nameType":"Personal","givenName":"Adnan","familyName":"Iftekhar","name":"Iftekhar, Adnan","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Chengliang","familyName":"Zheng","name":"Zheng, Chengliang","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Xiaohui","familyName":"Cui","name":"Cui, Xiaohui","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Mir","familyName":"Hassan","name":"Hassan, Mir","affiliation":[],"nameIdentifiers":[]}],"titles":[{"title":"ReputationChain: Robust Trust Updating for Blockchain-Enabled Supply Chains"}],"publisher":"arXiv","container":{},"publicationYear":2026,"subjects":[{"subject":"Cryptography and Security (cs.CR)","lang":"en","subjectScheme":"arXiv"},{"subject":"Distributed, Parallel, and Cluster Computing (cs.DC)","lang":"en","subjectScheme":"arXiv"},{"subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"}],"contributors":[],"dates":[{"date":"2026-08-04T12:24:56Z","dateType":"Submitted","dateInformation":"v1"},{"date":"2026-08-05T00:49:59Z","dateType":"Updated","dateInformation":"v1"},{"date":"2026-08","dateType":"Available","dateInformation":"v1"}],"language":null,"types":{"schemaOrg":"CreativeWork","resourceTypeGeneral":"Preprint","citeproc":"article","bibtex":"misc","ris":"GEN","resourceType":"Article"},"relatedIdentifiers":[],"relatedItems":[],"sizes":[],"formats":[],"version":"1","rightsList":[{"rightsUri":"http://arxiv.org/licenses/nonexclusive-distrib/1.0/","rights":"arXiv.org perpetual, non-exclusive license"}],"descriptions":[{"descriptionType":"Abstract","description":"Blockchain can preserve supply-chain records, but ledger integrity alone does not show whether a participant should be trusted in a future risk-sensitive transaction. Existing reputation systems mainly address product evidence, global feedback aggregation, or review authenticity, while giving less attention to repeated bilateral inflation, identity multiplicity, and unfair decay for honest participants with sparse histories. We present \\RC, a participant trust framework that uses blockchain as an evidence and provenance layer rather than as the source of trust. Governed interaction outcomes are converted into bounded evidence. Repeated interactions between the same pair are discounted, low counterparty diversity is penalized, governance-supplied identity confidence weights positive evidence, and scores decay toward a neutral prior according to verified interaction volume. Identity, contract, outcome, and update provenance remain on chain, while nonlinear reputation computation is performed off chain and checked on chain for admissibility. In controlled simulations with 30 seeded runs and matched interaction traces, the full model reduces mean collusive gain to 0.1443, compared with 0.3688 for naive mean evidence and 0.3585 for static decay. With ten identities under one controller, the reputation inflation ratio falls to 0.8723, while three comparison baselines remain above 1.08. On identical newcomer traces, volume-aware decay increases mean newcomer reputation from 0.6626 to 0.7589 and reduces the false low-trust rate from 0.3633 to 0.1683. Paired analysis confirms these improvements across runs. The results support a bounded reduction in reputation distortion, not attacker detection. Deployment evaluation and calibration with operational data are still required before production use."}],"geoLocations":[],"fundingReferences":[],"url":"https://arxiv.org/abs/2608.03554","contentUrl":null,"metadataVersion":0,"schemaVersion":"http://datacite.org/schema/kernel-4","source":"mds","isActive":true,"state":"findable","reason":null,"viewCount":0,"downloadCount":0,"referenceCount":0,"citationCount":0,"partCount":0,"partOfCount":0,"versionCount":0,"versionOfCount":0,"created":"2026-08-05T02:15:38Z","registered":null,"published":null,"updated":"2026-08-05T02:15:38Z"},"relationships":{"client":{"data":{"id":"arxiv.content","type":"clients"}}}},{"id":"10.48550/arxiv.2608.03552","type":"dois","attributes":{"doi":"10.48550/arxiv.2608.03552","identifiers":[{"identifier":"2608.03552","identifierType":"arXiv"}],"creators":[{"nameType":"Personal","givenName":"Ya","familyName":"Xiao","name":"Xiao, Ya","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Yan-Xin","familyName":"Rong","name":"Rong, Yan-Xin","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Ran","familyName":"He","name":"He, Ran","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Yu","familyName":"Meng","name":"Meng, Yu","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Yang","familyName":"Zhang","name":"Zhang, Yang","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Xiao-Ye","familyName":"Xu","name":"Xu, Xiao-Ye","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Yong-Jian","familyName":"Han","name":"Han, Yong-Jian","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Zheng-Hao","familyName":"Liu","name":"Liu, Zheng-Hao","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Yong-Jian","familyName":"Gu","name":"Gu, Yong-Jian","affiliation":[],"nameIdentifiers":[]}],"titles":[{"title":"Observation of quantum nonclassicality without freedom of choice in a minimal causal network"}],"publisher":"arXiv","container":{},"publicationYear":2026,"subjects":[{"subject":"Quantum Physics (quant-ph)","lang":"en","subjectScheme":"arXiv"},{"subject":"FOS: Physical sciences","subjectScheme":"Fields of Science and Technology (FOS)"}],"contributors":[],"dates":[{"date":"2026-08-04T12:23:29Z","dateType":"Submitted","dateInformation":"v1"},{"date":"2026-08-05T00:49:54Z","dateType":"Updated","dateInformation":"v1"},{"date":"2026-08","dateType":"Available","dateInformation":"v1"}],"language":null,"types":{"schemaOrg":"CreativeWork","resourceTypeGeneral":"Preprint","citeproc":"article","bibtex":"misc","ris":"GEN","resourceType":"Article"},"relatedIdentifiers":[],"relatedItems":[],"sizes":[],"formats":[],"version":"1","rightsList":[{"rightsUri":"http://arxiv.org/licenses/nonexclusive-distrib/1.0/","rights":"arXiv.org perpetual, non-exclusive license"}],"descriptions":[{"descriptionType":"Abstract","description":"Quantum causal networks enable tests of nonclassicality beyond Bell nonlocality while relaxing some physically unwarranted assumptions. By relaxing the freedom-of-choice and spacelike-separation assumptions, the unrelated-confounders causal networks provide a simple and robust route to certify quantum nonclassicality. Here, we implement the minimal three-node unrelated-confounders network in an optical experiment using two independent polarization-entangled photon sources and an intervention at the central node, experimentally achieved with a high-fidelity entangling measurement. We employ a causal data-fusion protocol that combines observational and interventional data to significantly improve the protocol's noise tolerance, and observe a violation of the corresponding hybrid causal inequality by more than three standard deviations. Our results provide deeper insights into quantum nonlocality in networks and highlight the UC network as a compact, experimentally accessible platform for device-independent quantum protocols that do not require actively chosen measurement settings."}],"geoLocations":[],"fundingReferences":[],"url":"https://arxiv.org/abs/2608.03552","contentUrl":null,"metadataVersion":0,"schemaVersion":"http://datacite.org/schema/kernel-4","source":"mds","isActive":true,"state":"findable","reason":null,"viewCount":0,"downloadCount":0,"referenceCount":0,"citationCount":0,"partCount":0,"partOfCount":0,"versionCount":0,"versionOfCount":0,"created":"2026-08-05T02:15:35Z","registered":"2026-08-05T02:15:36Z","published":null,"updated":"2026-08-05T02:15:36Z"},"relationships":{"client":{"data":{"id":"arxiv.content","type":"clients"}}}},{"id":"10.48550/arxiv.2608.03551","type":"dois","attributes":{"doi":"10.48550/arxiv.2608.03551","identifiers":[{"identifier":"2608.03551","identifierType":"arXiv"}],"creators":[{"nameType":"Personal","givenName":"Rodrigo","familyName":"Jaeschke-Ubiergo","name":"Jaeschke-Ubiergo, Rodrigo","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Xanthe H.","familyName":"Verbeek","name":"Verbeek, Xanthe H.","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Colin","familyName":"Lange","name":"Lange, Colin","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Sergio","familyName":"Rodriguez","name":"Rodriguez, Sergio","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Atasi","familyName":"Chakraborty","name":"Chakraborty, Atasi","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Alexander","familyName":"Mook","name":"Mook, Alexander","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Jairo","familyName":"Sinov","name":"Sinov, Jairo","affiliation":[],"nameIdentifiers":[]}],"titles":[{"title":"Emergence and Detection of Surface altermagnetism in KV$_2$Se$_2$O"}],"publisher":"arXiv","container":{},"publicationYear":2026,"subjects":[{"subject":"Strongly Correlated Electrons (cond-mat.str-el)","lang":"en","subjectScheme":"arXiv"},{"subject":"Materials Science (cond-mat.mtrl-sci)","lang":"en","subjectScheme":"arXiv"},{"subject":"FOS: Physical sciences","subjectScheme":"Fields of Science and Technology (FOS)"}],"contributors":[],"dates":[{"date":"2026-08-04T12:23:23Z","dateType":"Submitted","dateInformation":"v1"},{"date":"2026-08-05T00:49:53Z","dateType":"Updated","dateInformation":"v1"},{"date":"2026-08","dateType":"Available","dateInformation":"v1"}],"language":null,"types":{"schemaOrg":"CreativeWork","resourceTypeGeneral":"Preprint","citeproc":"article","bibtex":"misc","ris":"GEN","resourceType":"Article"},"relatedIdentifiers":[],"relatedItems":[],"sizes":[],"formats":[],"version":"1","rightsList":[{"rightsUri":"http://arxiv.org/licenses/nonexclusive-distrib/1.0/","rights":"arXiv.org perpetual, non-exclusive license"}],"descriptions":[{"descriptionType":"Abstract","description":"We demonstrate the recent concept of emergent surface altermagnetism through its unique signatures in \\KVSO. We show that for bulk antiferromagnetically ordered \\KVSO, the (001) surface exhibits $d$-wave altermagnetism. Our results fully explain the recent seemingly contradicgting experimental evidence, independently showing both an antiferromagnetically ordered bulk from neutron diffraction, and $d$-wave spin splitting from photoemission spectroscopy. To fully verify this conecept, we predict, as a key experimental signature, a large nonlinear Edelstein response, which is localized at the surface, and follows the $d$-wave altermagnetic symmetry. These results are not only relevant for the metallic and room-temperature magnet \\KVSO, but also for several other Lieb lattice systems. Our work expands the pool of techniques that can be used to detect altermagnetism emerging at the surfaces of antiferromagnets."},{"descriptionType":"Other","description":"12 pages, 6 figures"}],"geoLocations":[],"fundingReferences":[],"url":"https://arxiv.org/abs/2608.03551","contentUrl":null,"metadataVersion":0,"schemaVersion":"http://datacite.org/schema/kernel-4","source":"mds","isActive":true,"state":"findable","reason":null,"viewCount":0,"downloadCount":0,"referenceCount":0,"citationCount":0,"partCount":0,"partOfCount":0,"versionCount":0,"versionOfCount":0,"created":"2026-08-05T02:15:34Z","registered":"2026-08-05T02:15:34Z","published":null,"updated":"2026-08-05T02:15:34Z"},"relationships":{"client":{"data":{"id":"arxiv.content","type":"clients"}}}},{"id":"10.48550/arxiv.2608.03550","type":"dois","attributes":{"doi":"10.48550/arxiv.2608.03550","identifiers":[{"identifier":"2608.03550","identifierType":"arXiv"}],"creators":[{"nameType":"Personal","givenName":"Denys","familyName":"Pushkin","name":"Pushkin, Denys","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Albert Q.","familyName":"Jiang","name":"Jiang, Albert Q.","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Aryo","familyName":"Lotfi","name":"Lotfi, Aryo","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Colin","familyName":"Sandon","name":"Sandon, Colin","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Emmanuel","familyName":"Abbé","name":"Abbé, Emmanuel","affiliation":[],"nameIdentifiers":[]}],"titles":[{"title":"Soft Guidance Starts to Outperform CoT Prompting as LLMs Improve"}],"publisher":"arXiv","container":{},"publicationYear":2026,"subjects":[{"subject":"Artificial Intelligence (cs.AI)","lang":"en","subjectScheme":"arXiv"},{"subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"}],"contributors":[],"dates":[{"date":"2026-08-04T12:22:31Z","dateType":"Submitted","dateInformation":"v1"},{"date":"2026-08-05T00:49:52Z","dateType":"Updated","dateInformation":"v1"},{"date":"2026-08","dateType":"Available","dateInformation":"v1"}],"language":null,"types":{"schemaOrg":"CreativeWork","resourceTypeGeneral":"Preprint","citeproc":"article","bibtex":"misc","ris":"GEN","resourceType":"Article"},"relatedIdentifiers":[],"relatedItems":[],"sizes":[],"formats":[],"version":"1","rightsList":[{"rightsIdentifierScheme":"SPDX","rightsUri":"https://creativecommons.org/licenses/by/4.0/legalcode","schemeUri":"https://spdx.org/licenses/","rights":"Creative Commons Attribution 4.0 International","rightsIdentifier":"cc-by-4.0"}],"descriptions":[{"descriptionType":"Abstract","description":"Chain-of-Thought (CoT) prompting remains the standard baseline for evaluating models' reasoning abilities. Originally, this technique was introduced to elicit step-by-step reasoning from large language models (LLMs), which would otherwise tend to directly output the final answer. However, many modern LLMs produce CoT-style responses \\textit{natively} when presented with reasoning tasks, which made us revisit the effectiveness of standard CoT prompting.\n We evaluate several modern mid-sized language models on a math problem-solving task and find that models specialized for reasoning achieve better performance in a simple zero-shot setting than when using few-shot CoT examples - significantly surpassing officially reported results at no additional cost (e.g., from $\\sim$77\\% to $\\sim$84\\% for Mathstral on GSM8K). For the tested general-purpose model, a zero-shot CoT prompt is also sufficient to outperform a few-shot CoT baseline. We attribute this to a `guidance-distraction' tradeoff: standard CoT prompting also demands style adaptation, formatting compliance, and potentially undesired contextualization, which can distract models from the core reasoning task.\n Our findings suggest that using standard CoT prompting increasingly acts as a source of distraction as models grow stronger."},{"descriptionType":"Other","description":"10 pages, 3 tables"}],"geoLocations":[],"fundingReferences":[],"url":"https://arxiv.org/abs/2608.03550","contentUrl":null,"metadataVersion":0,"schemaVersion":"http://datacite.org/schema/kernel-4","source":"mds","isActive":true,"state":"findable","reason":null,"viewCount":0,"downloadCount":0,"referenceCount":0,"citationCount":0,"partCount":0,"partOfCount":0,"versionCount":0,"versionOfCount":0,"created":"2026-08-05T02:15:32Z","registered":null,"published":null,"updated":"2026-08-05T02:15:33Z"},"relationships":{"client":{"data":{"id":"arxiv.content","type":"clients"}}}},{"id":"10.48550/arxiv.2608.03547","type":"dois","attributes":{"doi":"10.48550/arxiv.2608.03547","identifiers":[{"identifier":"2608.03547","identifierType":"arXiv"}],"creators":[{"nameType":"Personal","givenName":"Christian","familyName":"Partes","name":"Partes, Christian","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Jonas","familyName":"Auch","name":"Auch, Jonas","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Eduard","familyName":"Heidt","name":"Heidt, Eduard","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Kirill","familyName":"Karpov","name":"Karpov, Kirill","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Florian","familyName":"Kiesel","name":"Kiesel, Florian","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Christian","familyName":"Groß","name":"Groß, Christian","affiliation":[],"nameIdentifiers":[]}],"titles":[{"title":"AOM-based ultra-low noise laser intensity control up to the MHz range"}],"publisher":"arXiv","container":{},"publicationYear":2026,"subjects":[{"subject":"Optics (physics.optics)","lang":"en","subjectScheme":"arXiv"},{"subject":"Quantum Gases (cond-mat.quant-gas)","lang":"en","subjectScheme":"arXiv"},{"subject":"Instrumentation and Detectors (physics.ins-det)","lang":"en","subjectScheme":"arXiv"},{"subject":"FOS: Physical sciences","subjectScheme":"Fields of Science and Technology (FOS)"}],"contributors":[],"dates":[{"date":"2026-08-04T12:21:17Z","dateType":"Submitted","dateInformation":"v1"},{"date":"2026-08-05T00:49:49Z","dateType":"Updated","dateInformation":"v1"},{"date":"2026-08","dateType":"Available","dateInformation":"v1"}],"language":null,"types":{"schemaOrg":"CreativeWork","resourceTypeGeneral":"Preprint","citeproc":"article","bibtex":"misc","ris":"GEN","resourceType":"Article"},"relatedIdentifiers":[],"relatedItems":[],"sizes":[],"formats":[],"version":"1","rightsList":[{"rightsUri":"http://arxiv.org/licenses/nonexclusive-distrib/1.0/","rights":"arXiv.org perpetual, non-exclusive license"}],"descriptions":[{"descriptionType":"Abstract","description":"High-power laser sources that exhibit low relative intensity noise and allow simultaneous dynamic control of their light level are required for a broad range of applications in various fields of physics. Acousto-optic modulators (AOMs) are widely used for active power stabilization and regulation due to their simple drive electronics requirements and high optical power handling capability in free-space. However, the rather slow propagation speed of the sound wave within the AOM crystal typically limits their control bandwidth to a few hundred kHz. In this work, we present a novel AOM-based control system that is capable of significantly suppressing intensity noise of high-power lasers up to the MHz range. By combining two standard feedback loops with one feedforward control branch and optimizing the beam path in the AOM crystal, ultra-low relative intensity noise levels down to $-155\\, \\text{dB}\\,\\text{Hz}^{-1}$ even at several hundred kHz are achieved. Our results are relevant for applications that require ultra-low intensity noise at Fourier frequencies up to the MHz range, such as optical lattice experiments with light ultracold atoms."}],"geoLocations":[],"fundingReferences":[],"url":"https://arxiv.org/abs/2608.03547","contentUrl":null,"metadataVersion":0,"schemaVersion":"http://datacite.org/schema/kernel-4","source":"mds","isActive":true,"state":"findable","reason":null,"viewCount":0,"downloadCount":0,"referenceCount":0,"citationCount":0,"partCount":0,"partOfCount":0,"versionCount":0,"versionOfCount":0,"created":"2026-08-05T02:15:28Z","registered":"2026-08-05T02:15:29Z","published":null,"updated":"2026-08-05T02:15:29Z"},"relationships":{"client":{"data":{"id":"arxiv.content","type":"clients"}}}},{"id":"10.48550/arxiv.2608.03546","type":"dois","attributes":{"doi":"10.48550/arxiv.2608.03546","identifiers":[{"identifier":"2608.03546","identifierType":"arXiv"}],"creators":[{"nameType":"Personal","givenName":"Yifan","familyName":"Wang","name":"Wang, Yifan","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Luca","familyName":"Ballotta","name":"Ballotta, Luca","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Ruggero","familyName":"Carli","name":"Carli, Ruggero","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Xianghui","familyName":"Cao","name":"Cao, Xianghui","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Luca","familyName":"Schenato","name":"Schenato, Luca","affiliation":[],"nameIdentifiers":[]}],"titles":[{"title":"Pursuing Optimal Stepsize in Adaptive Gradient-Based Quadratic Optimization"}],"publisher":"arXiv","container":{},"publicationYear":2026,"subjects":[{"subject":"Optimization and Control (math.OC)","lang":"en","subjectScheme":"arXiv"},{"subject":"FOS: Mathematics","subjectScheme":"Fields of Science and Technology (FOS)"}],"contributors":[],"dates":[{"date":"2026-08-04T12:20:40Z","dateType":"Submitted","dateInformation":"v1"},{"date":"2026-08-05T00:49:44Z","dateType":"Updated","dateInformation":"v1"},{"date":"2026-08","dateType":"Available","dateInformation":"v1"}],"language":null,"types":{"schemaOrg":"CreativeWork","resourceTypeGeneral":"Preprint","citeproc":"article","bibtex":"misc","ris":"GEN","resourceType":"Article"},"relatedIdentifiers":[],"relatedItems":[],"sizes":[],"formats":[],"version":"1","rightsList":[{"rightsUri":"http://arxiv.org/licenses/nonexclusive-distrib/1.0/","rights":"arXiv.org perpetual, non-exclusive license"}],"descriptions":[{"descriptionType":"Abstract","description":"In this paper, we address the problem of achieving fast convergence in gradient descent for quadratic functions without relying on a priori knowledge of global function parameters. Inspired by adaptive stepsize algorithms for smooth convex functions, we propose a computationally lightweight strategy based on running estimates of minimal and maximal local curvatures. We prove that our proposed algorithm converges to the optimal constant stepsize which achieves the fastest convergence. Simulations show that the convergence rate achieved by our proposed algorithm is comparable or superior to recent adaptive approaches both in the quadratic case under consideration and in a preliminary test on logistic classification."}],"geoLocations":[],"fundingReferences":[],"url":"https://arxiv.org/abs/2608.03546","contentUrl":null,"metadataVersion":0,"schemaVersion":"http://datacite.org/schema/kernel-4","source":"mds","isActive":true,"state":"findable","reason":null,"viewCount":0,"downloadCount":0,"referenceCount":0,"citationCount":0,"partCount":0,"partOfCount":0,"versionCount":0,"versionOfCount":0,"created":"2026-08-05T02:15:27Z","registered":"2026-08-05T02:15:28Z","published":null,"updated":"2026-08-05T02:15:28Z"},"relationships":{"client":{"data":{"id":"arxiv.content","type":"clients"}}}},{"id":"10.48550/arxiv.2608.03544","type":"dois","attributes":{"doi":"10.48550/arxiv.2608.03544","identifiers":[{"identifier":"2608.03544","identifierType":"arXiv"}],"creators":[{"nameType":"Personal","givenName":"Joseph","familyName":"Cummings","name":"Cummings, Joseph","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Maize","familyName":"Curiel","name":"Curiel, Maize","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Bryan","familyName":"Currie","name":"Currie, Bryan","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Bryson","familyName":"Kagy","name":"Kagy, Bryson","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Udani","familyName":"Ranasinghe","name":"Ranasinghe, Udani","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"John A.","familyName":"Rhodes","name":"Rhodes, John A.","affiliation":[],"nameIdentifiers":[]}],"titles":[{"title":"Identifiability of phylogenetic networks and quintet concordance factors"}],"publisher":"arXiv","container":{},"publicationYear":2026,"subjects":[{"subject":"Populations and Evolution (q-bio.PE)","lang":"en","subjectScheme":"arXiv"},{"subject":"Algebraic Geometry (math.AG)","lang":"en","subjectScheme":"arXiv"},{"subject":"FOS: Biological sciences","subjectScheme":"Fields of Science and Technology (FOS)"},{"subject":"FOS: Mathematics","subjectScheme":"Fields of Science and Technology (FOS)"},{"subject":"92B10, 62R01, 13P25","lang":"en","subjectScheme":"MSC"}],"contributors":[],"dates":[{"date":"2026-08-04T12:19:04Z","dateType":"Submitted","dateInformation":"v1"},{"date":"2026-08-05T00:49:39Z","dateType":"Updated","dateInformation":"v1"},{"date":"2026-08","dateType":"Available","dateInformation":"v1"}],"language":null,"types":{"schemaOrg":"CreativeWork","resourceTypeGeneral":"Preprint","citeproc":"article","bibtex":"misc","ris":"GEN","resourceType":"Article"},"relatedIdentifiers":[],"relatedItems":[],"sizes":[],"formats":[],"version":"1","rightsList":[{"rightsIdentifierScheme":"SPDX","rightsUri":"https://creativecommons.org/licenses/by/4.0/legalcode","schemeUri":"https://spdx.org/licenses/","rights":"Creative Commons Attribution 4.0 International","rightsIdentifier":"cc-by-4.0"}],"descriptions":[{"descriptionType":"Abstract","description":"Several statistical methods of phylogenetic network inference and testing for non-tree-like relationships are based on assessing genomic data through quartet Concordance Factors, the frequencies of 4-taxon topological relationships on gene trees. While such an approach obviates making several undesirable modeling assumptions, it also results in non-identifiability issues for network roots and for small cycles. In this work, an algorithm and accompanying Macaulay2 implementation are provided for computing $n$-tet Concordance Factors on any phylogenetic network. We employ this algorithm on quintet Concordance Factors, summarizing 5-taxon gene trees, to explore identifiability of level-1 networks under the Network Multispecies Coalescent model. We show some additional network features become identifiable that are not through quartets. As identifiability is a necessary prerequisite to inference by any method, this lays a foundation for future inference work."},{"descriptionType":"Other","description":"31 pages, 11 figures, 4 tables"}],"geoLocations":[],"fundingReferences":[],"url":"https://arxiv.org/abs/2608.03544","contentUrl":null,"metadataVersion":0,"schemaVersion":"http://datacite.org/schema/kernel-4","source":"mds","isActive":true,"state":"findable","reason":null,"viewCount":0,"downloadCount":0,"referenceCount":0,"citationCount":0,"partCount":0,"partOfCount":0,"versionCount":0,"versionOfCount":0,"created":"2026-08-05T02:15:24Z","registered":"2026-08-05T02:15:25Z","published":null,"updated":"2026-08-05T02:15:25Z"},"relationships":{"client":{"data":{"id":"arxiv.content","type":"clients"}}}},{"id":"10.48550/arxiv.2608.03543","type":"dois","attributes":{"doi":"10.48550/arxiv.2608.03543","identifiers":[{"identifier":"2608.03543","identifierType":"arXiv"}],"creators":[{"nameType":"Personal","givenName":"Dipankar","familyName":"Jana","name":"Jana, Dipankar","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Swagata","familyName":"Acharya","name":"Acharya, Swagata","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Amit","familyName":"Pawbake","name":"Pawbake, Amit","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Dmitrii","familyName":"Litvinov","name":"Litvinov, Dmitrii","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Aljoscha","familyName":"Soll","name":"Soll, Aljoscha","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Zdenek","familyName":"Sofer","name":"Sofer, Zdenek","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Clement","familyName":"Faugeras","name":"Faugeras, Clement","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Dimitar","familyName":"Pashov","name":"Pashov, Dimitar","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Mark","familyName":"van Schilfgaarde","name":"van Schilfgaarde, Mark","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Kostya S.","familyName":"Novoselov","name":"Novoselov, Kostya S.","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Marek","familyName":"Potemski","name":"Potemski, Marek","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Maciej","familyName":"Koperski","name":"Koperski, Maciej","affiliation":[],"nameIdentifiers":[]}],"titles":[{"title":"Manipulation of localized excitons in CrPS$_4$ by temperature and magnetic field"}],"publisher":"arXiv","container":{},"publicationYear":2026,"subjects":[{"subject":"Strongly Correlated Electrons (cond-mat.str-el)","lang":"en","subjectScheme":"arXiv"},{"subject":"Materials Science (cond-mat.mtrl-sci)","lang":"en","subjectScheme":"arXiv"},{"subject":"FOS: Physical sciences","subjectScheme":"Fields of Science and Technology (FOS)"}],"contributors":[],"dates":[{"date":"2026-08-04T12:17:49Z","dateType":"Submitted","dateInformation":"v1"},{"date":"2026-08-05T00:49:34Z","dateType":"Updated","dateInformation":"v1"},{"date":"2026-08","dateType":"Available","dateInformation":"v1"}],"language":null,"types":{"schemaOrg":"CreativeWork","resourceTypeGeneral":"Preprint","citeproc":"article","bibtex":"misc","ris":"GEN","resourceType":"Article"},"relatedIdentifiers":[],"relatedItems":[],"sizes":[],"formats":[],"version":"1","rightsList":[{"rightsIdentifierScheme":"SPDX","rightsUri":"https://creativecommons.org/licenses/by/4.0/legalcode","schemeUri":"https://spdx.org/licenses/","rights":"Creative Commons Attribution 4.0 International","rightsIdentifier":"cc-by-4.0"}],"descriptions":[{"descriptionType":"Abstract","description":"Layered van der Waals magnetic semiconductors provide a versatile platform for exploring excitonic phenomena intertwined with spin and lattice degrees of freedom, enabling excitons to act as sensitive probes of magnetic order. CrPS$_4$ is a layered antiferromagnetic semiconductor that hosts rich excitonic features whose microscopic origin and connection to magnetic ordering remain incompletely understood. Here, we investigate the electronic and excitonic properties of bulk CrPS$_4$ using a combination of many-body perturbation theory, dynamical mean-field theory, and photoluminescence-based experiments. Our calculations establish CrPS$_4$ as a direct-gap semiconductor with a bandgap of 2.48~eV in the antiferromagnetic phase. Several sub-bandgap excitonic transitions are predicted by theory, comprising multiple spin-allowed excitons and an additional spin-flip excitation, predominantly localized on the Cr$^{3+}$ ions. Temperature- and magnetic-field-dependent optical measurements reveal thermally driven exciton redistribution among localized states and identify characteristic energy shifts that provide clear optical signatures of magnetic phase transitions in CrPS$_4$. These results provide new insights into the excitonic transitions of antiferromagnets and suggest potential routes for all-optical sensing and light-driven control of their magnetic order."},{"descriptionType":"Other","description":"12 pages, 5 figures"}],"geoLocations":[],"fundingReferences":[],"url":"https://arxiv.org/abs/2608.03543","contentUrl":null,"metadataVersion":0,"schemaVersion":"http://datacite.org/schema/kernel-4","source":"mds","isActive":true,"state":"findable","reason":null,"viewCount":0,"downloadCount":0,"referenceCount":0,"citationCount":0,"partCount":0,"partOfCount":0,"versionCount":0,"versionOfCount":0,"created":"2026-08-05T02:15:23Z","registered":"2026-08-05T02:15:24Z","published":null,"updated":"2026-08-05T02:15:24Z"},"relationships":{"client":{"data":{"id":"arxiv.content","type":"clients"}}}},{"id":"10.48550/arxiv.2608.03542","type":"dois","attributes":{"doi":"10.48550/arxiv.2608.03542","identifiers":[{"identifier":"2608.03542","identifierType":"arXiv"}],"creators":[{"nameType":"Personal","givenName":"Lior","familyName":"Pachter","name":"Pachter, Lior","affiliation":[],"nameIdentifiers":[]}],"titles":[{"title":"The maximum quartet distance between phylogenetic trees"}],"publisher":"arXiv","container":{},"publicationYear":2026,"subjects":[{"subject":"Combinatorics (math.CO)","lang":"en","subjectScheme":"arXiv"},{"subject":"FOS: Mathematics","subjectScheme":"Fields of Science and Technology (FOS)"}],"contributors":[],"dates":[{"date":"2026-08-04T12:17:36Z","dateType":"Submitted","dateInformation":"v1"},{"date":"2026-08-05T00:49:31Z","dateType":"Updated","dateInformation":"v1"},{"date":"2026-08","dateType":"Available","dateInformation":"v1"}],"language":null,"types":{"schemaOrg":"CreativeWork","resourceTypeGeneral":"Preprint","citeproc":"article","bibtex":"misc","ris":"GEN","resourceType":"Article"},"relatedIdentifiers":[],"relatedItems":[],"sizes":[],"formats":[],"version":"1","rightsList":[{"rightsIdentifierScheme":"SPDX","rightsUri":"https://creativecommons.org/licenses/by/4.0/legalcode","schemeUri":"https://spdx.org/licenses/","rights":"Creative Commons Attribution 4.0 International","rightsIdentifier":"cc-by-4.0"}],"descriptions":[{"descriptionType":"Abstract","description":"The quartet distance counts the four-leaf subsets on which two binary phylogenetic trees display different topologies. We prove that its maximum over trees on $n$ leaves is $(2/3+o(1))\\binom{n}{4}$, resolving a conjecture of Bandelt and Dress from 1986 and calibrating the scale of a fundamental metric for comparing phylogenetic trees. The proof reduces arbitrary pairs of trees to caterpillars by means of a common-root planarization and an identity on five-leaf trees."},{"descriptionType":"Other","description":"11 pages, 2 figures"}],"geoLocations":[],"fundingReferences":[],"url":"https://arxiv.org/abs/2608.03542","contentUrl":null,"metadataVersion":0,"schemaVersion":"http://datacite.org/schema/kernel-4","source":"mds","isActive":true,"state":"findable","reason":null,"viewCount":0,"downloadCount":0,"referenceCount":0,"citationCount":0,"partCount":0,"partOfCount":0,"versionCount":0,"versionOfCount":0,"created":"2026-08-05T02:15:22Z","registered":"2026-08-05T02:15:22Z","published":null,"updated":"2026-08-05T02:15:22Z"},"relationships":{"client":{"data":{"id":"arxiv.content","type":"clients"}}}},{"id":"10.48550/arxiv.2608.03541","type":"dois","attributes":{"doi":"10.48550/arxiv.2608.03541","identifiers":[{"identifier":"2608.03541","identifierType":"arXiv"}],"creators":[{"nameType":"Personal","givenName":"Tomas","familyName":"Veloz","name":"Veloz, Tomas","affiliation":[],"nameIdentifiers":[]}],"titles":[{"title":"Synergy and Complementarity: The Generative Basis of Chemical Organizations"}],"publisher":"arXiv","container":{},"publicationYear":2026,"subjects":[{"subject":"Molecular Networks (q-bio.MN)","lang":"en","subjectScheme":"arXiv"},{"subject":"FOS: Biological sciences","subjectScheme":"Fields of Science and Technology (FOS)"}],"contributors":[],"dates":[{"date":"2026-08-04T12:16:49Z","dateType":"Submitted","dateInformation":"v1"},{"date":"2026-08-05T00:49:30Z","dateType":"Updated","dateInformation":"v1"},{"date":"2026-08","dateType":"Available","dateInformation":"v1"}],"language":null,"types":{"schemaOrg":"CreativeWork","resourceTypeGeneral":"Preprint","citeproc":"article","bibtex":"misc","ris":"GEN","resourceType":"Article"},"relatedIdentifiers":[],"relatedItems":[],"sizes":[],"formats":[],"version":"1","rightsList":[{"rightsIdentifierScheme":"SPDX","rightsUri":"https://creativecommons.org/licenses/by/4.0/legalcode","schemeUri":"https://spdx.org/licenses/","rights":"Creative Commons Attribution 4.0 International","rightsIdentifier":"cc-by-4.0"}],"descriptions":[{"descriptionType":"Abstract","description":"Identifying structural features ensuring the persistence of a reaction network is fundamental for understanding the evolution and complexification of biological entities. By defining organizations as subsets of species that are closed and self-maintaining, Chemical Organization Theory (COT) shows that organizations enable filtering out the regions of the phase space where attractors can exist. Despite various theoretical explorations current methods to compute the organizations face unclear combinatorial challenges.\n In this article, we first perform a systematic study of such combinatorial challenges and identify a criteria of productive novelty and irreducibility that separate relevant from redundant combinations. Second, we identify the minimal building blocks that shall be combined to build organizations, called elementary reaction closures (ERC), and characterize them as a hierarchy. Third, we show that all persistent modules can be generated as combination of ERCs only, and operationalize two properties among ERCs, synergy and complementarity, that define a sufficient criteria to build such generators in a minimal way. Fourth we show that every relevant persistent module can be built from such minimal sequences of ERCs.\n We next show that the synergies and complementarities we use to generate persistent modules not only scale radically slower than usual combinatorial methods. We quantify these structures across $438$ biological reaction networks from the BioModels and BiGG databases. The proportion of fundamental synergies and complementarities among all ERC pairs shrinks as networks grow even as raw counts increase, confirming that larger biological networks achieve persistence through a progressively smaller and more selective sets.\n We do not prescribe algorithms to compute organizations, discuss how algorithms based on our results could permit applying COT."}],"geoLocations":[],"fundingReferences":[],"url":"https://arxiv.org/abs/2608.03541","contentUrl":null,"metadataVersion":0,"schemaVersion":"http://datacite.org/schema/kernel-4","source":"mds","isActive":true,"state":"findable","reason":null,"viewCount":0,"downloadCount":0,"referenceCount":0,"citationCount":0,"partCount":0,"partOfCount":0,"versionCount":0,"versionOfCount":0,"created":"2026-08-05T02:15:20Z","registered":"2026-08-05T02:15:21Z","published":null,"updated":"2026-08-05T02:15:21Z"},"relationships":{"client":{"data":{"id":"arxiv.content","type":"clients"}}}},{"id":"10.48550/arxiv.2608.03540","type":"dois","attributes":{"doi":"10.48550/arxiv.2608.03540","identifiers":[{"identifier":"2608.03540","identifierType":"arXiv"}],"creators":[{"nameType":"Personal","givenName":"Jiaming","familyName":"Liang","name":"Liang, Jiaming","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"QiHui","familyName":"Han","name":"Han, QiHui","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Guangye","familyName":"Ou","name":"Ou, Guangye","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Jiawen","familyName":"Liu","name":"Liu, Jiawen","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Haolin","familyName":"Chen","name":"Chen, Haolin","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Xi","familyName":"Zhong","name":"Zhong, Xi","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Jiazhou","familyName":"Chen","name":"Chen, Jiazhou","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Xiaoqi","familyName":"Sheng","name":"Sheng, Xiaoqi","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Hongmin","familyName":"Cai","name":"Cai, Hongmin","affiliation":[],"nameIdentifiers":[]}],"titles":[{"title":"S$^3$-Diff: Structural Semantic Synergy Diffusion Model for High Fidelity Super Resolution of Pathological Images"}],"publisher":"arXiv","container":{},"publicationYear":2026,"subjects":[{"subject":"Computer Vision and Pattern Recognition (cs.CV)","lang":"en","subjectScheme":"arXiv"},{"subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"}],"contributors":[],"dates":[{"date":"2026-08-04T12:16:36Z","dateType":"Submitted","dateInformation":"v1"},{"date":"2026-08-05T00:49:27Z","dateType":"Updated","dateInformation":"v1"},{"date":"2026-08","dateType":"Available","dateInformation":"v1"}],"language":null,"types":{"schemaOrg":"CreativeWork","resourceTypeGeneral":"Preprint","citeproc":"article","bibtex":"misc","ris":"GEN","resourceType":"Article"},"relatedIdentifiers":[],"relatedItems":[],"sizes":[],"formats":[],"version":"1","rightsList":[{"rightsUri":"http://arxiv.org/licenses/nonexclusive-distrib/1.0/","rights":"arXiv.org perpetual, non-exclusive license"}],"descriptions":[{"descriptionType":"Abstract","description":"Digital pathology relies on high-resolution whole slide images for accurate diagnosis, yet limitations in imaging devices, storage, and transmission often make lower-resolution pathology images more common in clinical workflows. Current super-resolution techniques often tend to smooth diagnostically relevant morphology, leading to over-smoothed textures and semantic drift that compromise downstream clinical interpretation. To this end, we develop the Structural Semantic Synergy Diffusion Model (S3-Diff), a diffusion framework for high-fidelity super-resolution of pathological images. The core of S3-Diff is Specimen-aware Structural Anchoring (SSA), which combines prognosis-aware tissue support extracted by a fixed SAM with LR-HR gradient discrepancies to generate a specimen-specific structural anchor to preserve pathological morphology. Concurrently, we introduce Structure-guided Semantic Fidelity Tuning (SSFT) to adapt DINOv3 representations using SSA-derived structural supervision. SSFT combines the adapted semantic energy with LR-derived edge and grayscale cues. The resulting control guides denoising to suppress stochastic artifacts and maintain structural consistency. Extensive experimental results demonstrate that S3-Diff consistently outperforms state-of-the-art methods in both reconstruction quality and downstream survival analysis performance. The source code will be made public."}],"geoLocations":[],"fundingReferences":[],"url":"https://arxiv.org/abs/2608.03540","contentUrl":null,"metadataVersion":0,"schemaVersion":"http://datacite.org/schema/kernel-4","source":"mds","isActive":true,"state":"findable","reason":null,"viewCount":0,"downloadCount":0,"referenceCount":0,"citationCount":0,"partCount":0,"partOfCount":0,"versionCount":0,"versionOfCount":0,"created":"2026-08-05T02:15:19Z","registered":"2026-08-05T02:15:19Z","published":null,"updated":"2026-08-05T02:15:19Z"},"relationships":{"client":{"data":{"id":"arxiv.content","type":"clients"}}}},{"id":"10.48550/arxiv.2608.03538","type":"dois","attributes":{"doi":"10.48550/arxiv.2608.03538","identifiers":[{"identifier":"2608.03538","identifierType":"arXiv"}],"creators":[{"nameType":"Personal","givenName":"Julio","familyName":"Arrechea","name":"Arrechea, Julio","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Stefano","familyName":"Liberati","name":"Liberati, Stefano","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Massimiliano","familyName":"Spadafora","name":"Spadafora, Massimiliano","affiliation":[],"nameIdentifiers":[]}],"titles":[{"title":"Semiclassical Black Hole-White Hole transitions: an analytical treatment"}],"publisher":"arXiv","container":{},"publicationYear":2026,"subjects":[{"subject":"General Relativity and Quantum Cosmology (gr-qc)","lang":"en","subjectScheme":"arXiv"},{"subject":"High Energy Physics - Theory (hep-th)","lang":"en","subjectScheme":"arXiv"},{"subject":"FOS: Physical sciences","subjectScheme":"Fields of Science and Technology (FOS)"}],"contributors":[],"dates":[{"date":"2026-08-04T12:15:49Z","dateType":"Submitted","dateInformation":"v1"},{"date":"2026-08-05T00:49:25Z","dateType":"Updated","dateInformation":"v1"},{"date":"2026-08","dateType":"Available","dateInformation":"v1"}],"language":null,"types":{"schemaOrg":"CreativeWork","resourceTypeGeneral":"Preprint","citeproc":"article","bibtex":"misc","ris":"GEN","resourceType":"Article"},"relatedIdentifiers":[],"relatedItems":[],"sizes":[],"formats":[],"version":"1","rightsList":[{"rightsUri":"http://arxiv.org/licenses/nonexclusive-distrib/1.0/","rights":"arXiv.org perpetual, non-exclusive license"}],"descriptions":[{"descriptionType":"Abstract","description":"Recent numerical studies of semiclassical gravity suggest that, in spherically symmetric black holes with both outer and inner horizons, the semiclassical instability of the inner horizon can drive the complete evaporation of the trapped region on timescales shorter than the standard Hawking evaporation time. Independent simulations further indicate that the disappearance of the trapped region is followed by the formation of an anti-trapped region, i.e.~a dynamical white hole. In this work, we develop an analytic treatment of quantum effects in trapped and anti-trapped regions, showing how these numerical results can be understood within simplified two-dimensional models. We consider collapse models describing the formation of charged and regular black holes and compute the renormalized stress-energy tensor of the $|\\textit{in}\\rangle$ vacuum state. We show that, within this framework, the emergence of an anti-trapped region is a generic consequence of the amplification of negative energy fluxes propagating along the outgoing direction inside the initial trapped region. This provides an analytic explanation for the black-hole-to-white-hole transition observed in numerical simulations. Our analysis further suggests that the fluxes generated by the subsequent anti-trapped region, now propagating along the ingoing direction, may trigger the formation of a new trapped region. This raises the possibility of a cascade of black-to-white-hole transitions, potentially ending in a horizon-free, bouncing spacetime without invoking additional quantum-gravitational dynamics. Although establishing the complete evolution requires a self-consistent treatment of semiclassical backreaction, our framework identifies which features of the mechanism are universal and which depend on the geometry, laying the groundwork for a systematic investigation of semiclassical black-hole-to-white-hole transitions."},{"descriptionType":"Other","description":"49 pages, 4 tables, 17 figures"}],"geoLocations":[],"fundingReferences":[],"url":"https://arxiv.org/abs/2608.03538","contentUrl":null,"metadataVersion":0,"schemaVersion":"http://datacite.org/schema/kernel-4","source":"mds","isActive":true,"state":"findable","reason":null,"viewCount":0,"downloadCount":0,"referenceCount":0,"citationCount":0,"partCount":0,"partOfCount":0,"versionCount":0,"versionOfCount":0,"created":"2026-08-05T02:15:16Z","registered":"2026-08-05T02:15:17Z","published":null,"updated":"2026-08-05T02:15:17Z"},"relationships":{"client":{"data":{"id":"arxiv.content","type":"clients"}}}},{"id":"10.48550/arxiv.2608.03535","type":"dois","attributes":{"doi":"10.48550/arxiv.2608.03535","identifiers":[{"identifier":"2608.03535","identifierType":"arXiv"}],"creators":[{"nameType":"Personal","givenName":"Shahbaz","familyName":"Siddeeq","name":"Siddeeq, Shahbaz","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Muhammad","familyName":"Waseem","name":"Waseem, Muhammad","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Umar Subhan","familyName":"Malhi","name":"Malhi, Umar Subhan","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Pekka","familyName":"Abrahamsson","name":"Abrahamsson, Pekka","affiliation":[],"nameIdentifiers":[]}],"titles":[{"title":"CodeAssay: A Multi-Metric Benchmark with Audited Ground Truth for LLM Code Generation"}],"publisher":"arXiv","container":{},"publicationYear":2026,"subjects":[{"subject":"Software Engineering (cs.SE)","lang":"en","subjectScheme":"arXiv"},{"subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"}],"contributors":[],"dates":[{"date":"2026-08-04T12:15:17Z","dateType":"Submitted","dateInformation":"v1"},{"date":"2026-08-05T00:49:17Z","dateType":"Updated","dateInformation":"v1"},{"date":"2026-08","dateType":"Available","dateInformation":"v1"}],"language":null,"types":{"schemaOrg":"CreativeWork","resourceTypeGeneral":"Preprint","citeproc":"article","bibtex":"misc","ris":"GEN","resourceType":"Article"},"relatedIdentifiers":[],"relatedItems":[],"sizes":[],"formats":[],"version":"1","rightsList":[{"rightsUri":"http://arxiv.org/licenses/nonexclusive-distrib/1.0/","rights":"arXiv.org perpetual, non-exclusive license"}],"descriptions":[{"descriptionType":"Abstract","description":"Large Language Models are increasingly evaluated for code generation using test-based benchmarks. The validity of such evaluations depends on the reliability of their references and tests, while test-based correctness captures only part of the observable properties of generated code. We present CodeAssay, a taxonomy-first benchmark of 185 Python tasks across ten software-engineering categories. It combines audited ground truth, public tests for generation and repair, hidden tests for grading, mutation-based test-suite validation, and selected code-property measures. Regrading fixed model outputs after the audit changed 170 of 1,890 correctness labels (9.0%) and increased the measured best-to-worst model spread from 11.9 to 23.7 percentage points, although aggregate correctness remained nearly unchanged. The complete and hidden test suites achieved mutation scores of 82.6% and 74.8%, respectively. Across seven proprietary LLMs, standard-prompt correctness ranged from 77.3% to 98.9%, with significant differences in 12 of 21 model pairs. On the 120 tasks solved by all 14 model-prompt configurations, no model performed best across all selected code properties. A security-focused prompt produced no significant change in correctness or consistent reduction in the selected static-analysis findings, while increasing program length and cyclomatic complexity across all models. These findings show that reliable evaluation of LLM-generated code requires validated ground truth, protected tests, and multiple explicitly interpreted measures. CodeAssay provides a reproducible basis for evidence-based model evaluation in AI-augmented software development."}],"geoLocations":[],"fundingReferences":[],"url":"https://arxiv.org/abs/2608.03535","contentUrl":null,"metadataVersion":0,"schemaVersion":"http://datacite.org/schema/kernel-4","source":"mds","isActive":true,"state":"findable","reason":null,"viewCount":0,"downloadCount":0,"referenceCount":0,"citationCount":0,"partCount":0,"partOfCount":0,"versionCount":0,"versionOfCount":0,"created":"2026-08-05T02:15:12Z","registered":"2026-08-05T02:15:13Z","published":null,"updated":"2026-08-05T02:15:13Z"},"relationships":{"client":{"data":{"id":"arxiv.content","type":"clients"}}}},{"id":"10.48550/arxiv.2608.03533","type":"dois","attributes":{"doi":"10.48550/arxiv.2608.03533","identifiers":[{"identifier":"2608.03533","identifierType":"arXiv"}],"creators":[{"nameType":"Personal","givenName":"Pavithren V S","familyName":"Pakianathan","name":"Pakianathan, Pavithren V S","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Rania","familyName":"Islambouli","name":"Islambouli, Rania","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Magenta Jade","familyName":"Shipsey","name":"Shipsey, Magenta Jade","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Laura","familyName":"Maaß","name":"Maaß, Laura","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Jan","familyName":"Smeddinck","name":"Smeddinck, Jan","affiliation":[],"nameIdentifiers":[]}],"titles":[{"title":"Designing and Evaluating Granular Consent for Data Sharing in Cardiac Disease Prevention"}],"publisher":"arXiv","container":{},"publicationYear":2026,"subjects":[{"subject":"Human-Computer Interaction (cs.HC)","lang":"en","subjectScheme":"arXiv"},{"subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"}],"contributors":[],"dates":[{"date":"2026-08-04T12:14:19Z","dateType":"Submitted","dateInformation":"v1"},{"date":"2026-08-05T00:49:08Z","dateType":"Updated","dateInformation":"v1"},{"date":"2026-08","dateType":"Available","dateInformation":"v1"}],"language":null,"types":{"schemaOrg":"CreativeWork","resourceTypeGeneral":"Preprint","citeproc":"article","bibtex":"misc","ris":"GEN","resourceType":"Article"},"relatedIdentifiers":[{"relationType":"IsVersionOf","relatedIdentifier":"10.18420/muc2026-mci-wip-337","relatedIdentifierType":"DOI"}],"relatedItems":[],"sizes":[],"formats":[],"version":"1","rightsList":[{"rightsIdentifierScheme":"SPDX","rightsUri":"https://creativecommons.org/licenses/by/4.0/legalcode","schemeUri":"https://spdx.org/licenses/","rights":"Creative Commons Attribution 4.0 International","rightsIdentifier":"cc-by-4.0"}],"descriptions":[{"descriptionType":"Abstract","description":"Dynamic consent can promise end users with greater control, but little is known about how older adults with chronic conditions navigate the tradeoff between control and burden in granular consent mechanisms in health data life-cycles. Using a two-stage design process we evaluated this tradeoff. An expert workshop (n=5) informed the design requirements for granular dynamic consent prototype. We evaluated single step vs multi-step granularity in dynamic consent using prototypes with cardiac patients (n=7) using a mixed-methods study. Quantitative measures showed no significant differences between low- and high-granularity consent screens in usability, workload, perceived information control or willingness to share data. However, qualitative findings revealed a control-burden paradox and trust-dependent engagement with granularity. Participants sought greater transparency and control over AI-mediated data processing. We contribute implications for designing granular consent in health data life-cycles."},{"descriptionType":"Other","description":"Accepted as MuC'26 Work in Progress (WIP) submission"}],"geoLocations":[],"fundingReferences":[],"url":"https://arxiv.org/abs/2608.03533","contentUrl":null,"metadataVersion":0,"schemaVersion":"http://datacite.org/schema/kernel-4","source":"mds","isActive":true,"state":"findable","reason":null,"viewCount":0,"downloadCount":0,"referenceCount":0,"citationCount":0,"partCount":0,"partOfCount":0,"versionCount":0,"versionOfCount":1,"created":"2026-08-05T02:15:10Z","registered":"2026-08-05T02:15:10Z","published":null,"updated":"2026-08-05T02:15:10Z"},"relationships":{"client":{"data":{"id":"arxiv.content","type":"clients"}}}},{"id":"10.48550/arxiv.2608.03532","type":"dois","attributes":{"doi":"10.48550/arxiv.2608.03532","identifiers":[{"identifier":"2608.03532","identifierType":"arXiv"}],"creators":[{"nameType":"Personal","givenName":"Ruolei","familyName":"Zhang","name":"Zhang, Ruolei","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Teddy","familyName":"Njuguna","name":"Njuguna, Teddy","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Yue","familyName":"Feng","name":"Feng, Yue","affiliation":[],"nameIdentifiers":[]}],"titles":[{"title":"Cross-Lingual Bias in Large Language Models: A Comparative Analysis of English and Swahili"}],"publisher":"arXiv","container":{},"publicationYear":2026,"subjects":[{"subject":"Computation and Language (cs.CL)","lang":"en","subjectScheme":"arXiv"},{"subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"}],"contributors":[],"dates":[{"date":"2026-08-04T12:13:43Z","dateType":"Submitted","dateInformation":"v1"},{"date":"2026-08-05T00:49:07Z","dateType":"Updated","dateInformation":"v1"},{"date":"2026-08","dateType":"Available","dateInformation":"v1"}],"language":null,"types":{"schemaOrg":"CreativeWork","resourceTypeGeneral":"Preprint","citeproc":"article","bibtex":"misc","ris":"GEN","resourceType":"Article"},"relatedIdentifiers":[],"relatedItems":[],"sizes":[],"formats":[],"version":"1","rightsList":[{"rightsUri":"http://arxiv.org/licenses/nonexclusive-distrib/1.0/","rights":"arXiv.org perpetual, non-exclusive license"}],"descriptions":[{"descriptionType":"Abstract","description":"Large language models are increasingly deployed in multilingual contexts, yet safety alignment and bias evaluation remain overwhelmingly English-centric. We investigate whether social biases generalise across languages by submitting 4,900 symmetric English--Swahili prompt pairs to GPT-5.2 and Gemini 2.5 Flash across nine demographic bias axes, yielding 19,600 completions evaluated for stereotype prevalence, sentiment, refusal behaviour, and cross-lingual semantic similarity. Our findings show that bias transforms rather than transfers: stereotype rates shifted by up to 12 percentage points on specific axes, Gemini's neutral-sentiment rate doubled in Swahili, and GPT-5.2 refused 169 prompts in English and zero in Swahili, consistent with refusal behaviour anchored to English-language surface forms at the behavioural level. Over 55% of prompt pairs produced semantically dissimilar completions across both models. These reinforce the idea that English-only bias audits do not produce adequate coverage for multilingual deployment."}],"geoLocations":[],"fundingReferences":[],"url":"https://arxiv.org/abs/2608.03532","contentUrl":null,"metadataVersion":0,"schemaVersion":"http://datacite.org/schema/kernel-4","source":"mds","isActive":true,"state":"findable","reason":null,"viewCount":0,"downloadCount":0,"referenceCount":0,"citationCount":0,"partCount":0,"partOfCount":0,"versionCount":0,"versionOfCount":0,"created":"2026-08-05T02:15:08Z","registered":"2026-08-05T02:15:09Z","published":null,"updated":"2026-08-05T02:15:09Z"},"relationships":{"client":{"data":{"id":"arxiv.content","type":"clients"}}}},{"id":"10.48550/arxiv.2608.03531","type":"dois","attributes":{"doi":"10.48550/arxiv.2608.03531","identifiers":[{"identifier":"2608.03531","identifierType":"arXiv"}],"creators":[{"nameType":"Personal","givenName":"Gupta Lovi","familyName":"Raj","name":"Raj, Gupta Lovi","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"kaur","familyName":"Kamalpreet","name":"Kamalpreet, kaur","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Dama","familyName":"Sriram","name":"Sriram, Dama","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Parali","familyName":"Prajithaa","name":"Prajithaa, Parali","affiliation":[],"nameIdentifiers":[]}],"titles":[{"title":"Behaviorally Adaptive Visual Diversion for Inclusive and Resilient Digital Assessment Delivery"}],"publisher":"arXiv","container":{},"publicationYear":2026,"subjects":[{"subject":"Artificial Intelligence (cs.AI)","lang":"en","subjectScheme":"arXiv"},{"subject":"Computers and Society (cs.CY)","lang":"en","subjectScheme":"arXiv"},{"subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"}],"contributors":[],"dates":[{"date":"2026-08-04T12:13:25Z","dateType":"Submitted","dateInformation":"v1"},{"date":"2026-08-05T00:49:06Z","dateType":"Updated","dateInformation":"v1"},{"date":"2026-08","dateType":"Available","dateInformation":"v1"}],"language":null,"types":{"schemaOrg":"CreativeWork","resourceTypeGeneral":"Preprint","citeproc":"article","bibtex":"misc","ris":"GEN","resourceType":"Article"},"relatedIdentifiers":[],"relatedItems":[],"sizes":[],"formats":[],"version":"1","rightsList":[{"rightsUri":"http://arxiv.org/licenses/nonexclusive-distrib/1.0/","rights":"arXiv.org perpetual, non-exclusive license"}],"descriptions":[{"descriptionType":"Abstract","description":"Institutions increasingly rely on browser lockdown, webcam monitoring, and behavioral analytics to secure high-stakes digital assessments, yet these mechanisms are commonly designed and evaluated independently and often overlook learner accessibility. This paper introduces Behaviorally-Adaptive Visual Diversion (BAVD), a theoretical framework in which a synthetic, non-semantic visual field is composited with assessment content and adaptively modulated according to observed candidate behavior. The underlying assessment content is never altered; only its visual presentation is modified to reduce the usefulness of unauthorized screen capture or screen sharing while remaining minimally intrusive for legitimate candidates. The framework further incorporates an accessibility-aware attenuation mechanism that reduces or suppresses diversion intensity for candidates with approved visual-processing accommodations. We formulate the model using a coupled dynamical-systems representation comprising a Diversion Field Generator, Rendering Tensor, Behavior Tensor, Composite Integrity Functional, and Multi-dimensional Entropy Model, and establish theoretical properties for content fidelity, rendering stability, entropy boundedness, integrity tracking, and closed-loop adaptation stability. The framework explicitly states its threat model, identifies deployment assumptions and limitations, and discusses the trade-off between accessibility and capture resistance. This work provides a mathematically grounded foundation for behaviorally adaptive and accessibility-aware assessment delivery and offers a basis for future empirical validation in trusted digital assessment platforms."},{"descriptionType":"Other","description":"15 Pages, 7 Figures, 25 Equations"}],"geoLocations":[],"fundingReferences":[],"url":"https://arxiv.org/abs/2608.03531","contentUrl":null,"metadataVersion":0,"schemaVersion":"http://datacite.org/schema/kernel-4","source":"mds","isActive":true,"state":"findable","reason":null,"viewCount":0,"downloadCount":0,"referenceCount":0,"citationCount":0,"partCount":0,"partOfCount":0,"versionCount":0,"versionOfCount":0,"created":"2026-08-05T02:15:07Z","registered":"2026-08-05T02:15:08Z","published":null,"updated":"2026-08-05T02:15:08Z"},"relationships":{"client":{"data":{"id":"arxiv.content","type":"clients"}}}},{"id":"10.48550/arxiv.2608.03530","type":"dois","attributes":{"doi":"10.48550/arxiv.2608.03530","identifiers":[{"identifier":"2608.03530","identifierType":"arXiv"}],"creators":[{"nameType":"Personal","givenName":"Saee","familyName":"Dhawalikar","name":"Dhawalikar, Saee","affiliation":[],"nameIdentifiers":[]}],"titles":[{"title":"Cosmic Velocity Flows: from Theory to Observations"}],"publisher":"arXiv","container":{},"publicationYear":2026,"subjects":[{"subject":"Cosmology and Nongalactic Astrophysics (astro-ph.CO)","lang":"en","subjectScheme":"arXiv"},{"subject":"FOS: Physical sciences","subjectScheme":"Fields of Science and Technology (FOS)"}],"contributors":[],"dates":[{"date":"2026-08-04T12:12:58Z","dateType":"Submitted","dateInformation":"v1"},{"date":"2026-08-05T00:48:59Z","dateType":"Updated","dateInformation":"v1"},{"date":"2026-08","dateType":"Available","dateInformation":"v1"}],"language":null,"types":{"schemaOrg":"CreativeWork","resourceTypeGeneral":"Preprint","citeproc":"article","bibtex":"misc","ris":"GEN","resourceType":"Article"},"relatedIdentifiers":[],"relatedItems":[],"sizes":[],"formats":[],"version":"1","rightsList":[{"rightsUri":"http://arxiv.org/licenses/nonexclusive-distrib/1.0/","rights":"arXiv.org perpetual, non-exclusive license"}],"descriptions":[{"descriptionType":"Abstract","description":"The Large-Scale Structure (LSS) of the Universe forms a complex network of nodes, filaments, sheets, and voids known as the Cosmic Web. As current and upcoming galaxy surveys increasingly probe the quasi-linear and non-linear regimes of structure formation, understanding its geometry and dynamics is essential for precision cosmology. In particular, cosmic filaments, which channel matter across the web, are central to these dynamical processes.\n This thesis develops numerical tools to study the non-linear cosmic web. First, the Sahyadri suite of high-resolution cosmological $N$-body simulations is introduced, providing a framework for precision studies of LSS and its cosmological dependence. A calibration framework for filament reconstruction is then developed using controlled filament realizations, enabling systematic investigation of reconstruction biases. The effects of filament curvature and reconstruction noise on inferred filament properties are quantified, and a novel Fourier-space smoothing approach is introduced to improve profile recovery.\n The thesis further presents Skeletor, a Voronoi-based filament finder that identifies filamentary structures directly from discrete tracers while explicitly incorporating the hierarchical nature of the cosmic web. A novel framework for classifying sub-filamentary structure is developed. Applying these tools to cosmological simulations reveals distinct properties of filament substructure and provides a detailed view of filament phase space, including coherent inflows, multistreaming, and caustic-like features.\n Together, these developments provide a framework for studying the geometry, hierarchy, and dynamics of the non-linear cosmic web. More broadly, they contribute to the ongoing effort to build a physically motivated understanding of the non-linear cosmic web beyond traditional measures of clustering."},{"descriptionType":"Other","description":"172 pages, PhD thesis"}],"geoLocations":[],"fundingReferences":[],"url":"https://arxiv.org/abs/2608.03530","contentUrl":null,"metadataVersion":0,"schemaVersion":"http://datacite.org/schema/kernel-4","source":"mds","isActive":true,"state":"findable","reason":null,"viewCount":0,"downloadCount":0,"referenceCount":0,"citationCount":0,"partCount":0,"partOfCount":0,"versionCount":0,"versionOfCount":0,"created":"2026-08-05T02:15:06Z","registered":"2026-08-05T02:15:06Z","published":null,"updated":"2026-08-05T02:15:06Z"},"relationships":{"client":{"data":{"id":"arxiv.content","type":"clients"}}}},{"id":"10.48550/arxiv.2608.03528","type":"dois","attributes":{"doi":"10.48550/arxiv.2608.03528","identifiers":[{"identifier":"2608.03528","identifierType":"arXiv"}],"creators":[{"nameType":"Personal","givenName":"Shengyuan","familyName":"Zhang","name":"Zhang, Shengyuan","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Xinpeng","familyName":"Liu","name":"Liu, Xinpeng","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Muchun","familyName":"Niu","name":"Niu, Muchun","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Yulong","familyName":"Chen","name":"Chen, Yulong","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Lizhuang","familyName":"Ma","name":"Ma, Lizhuang","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Yue","familyName":"Gao","name":"Gao, Yue","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Cewu","familyName":"Lu","name":"Lu, Cewu","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Yong-Lu","familyName":"Li","name":"Li, Yong-Lu","affiliation":[],"nameIdentifiers":[]}],"titles":[{"title":"Tired Actor: Fatigue-Informed Character Control"}],"publisher":"arXiv","container":{},"publicationYear":2026,"subjects":[{"subject":"Robotics (cs.RO)","lang":"en","subjectScheme":"arXiv"},{"subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"}],"contributors":[],"dates":[{"date":"2026-08-04T12:12:09Z","dateType":"Submitted","dateInformation":"v1"},{"date":"2026-08-05T00:48:57Z","dateType":"Updated","dateInformation":"v1"},{"date":"2026-08","dateType":"Available","dateInformation":"v1"}],"language":null,"types":{"schemaOrg":"CreativeWork","resourceTypeGeneral":"Preprint","citeproc":"article","bibtex":"misc","ris":"GEN","resourceType":"Article"},"relatedIdentifiers":[],"relatedItems":[],"sizes":[],"formats":[],"version":"1","rightsList":[{"rightsUri":"http://arxiv.org/licenses/nonexclusive-distrib/1.0/","rights":"arXiv.org perpetual, non-exclusive license"}],"descriptions":[{"descriptionType":"Abstract","description":"Replicating human behavior with physics simulation has been a long-expected goal in character animation. Existing efforts have achieved impressive performance in imitating a wide span of general motions. However, most existing efforts could still suffer from unnatural movements due to the lack of biomechanical and physiological priors. Given this, we project our sights to advances in behavioral energetics, which demonstrate how energy use shapes human movements. In contrast, current character controllers typically assume the character is equipped with infinite energy over time. Inspired by these, we propose to adopt fatigue as a proxy of the finite energy limit, inject it into general character animation, and thoroughly investigate how fatigue introduces new characteristics to physics-based character control. Leveraging the Three-Compartment Controller (3CC) model, we managed to obtain a policy for general motion imitation under different fatigue statuses. Furthermore, extensive analyses are conducted to demonstrate how fatigue could influence the naturalness, scalability, and robustness of character animation. Our code will be made public."},{"descriptionType":"Other","description":"14 pages, 13 figures"}],"geoLocations":[],"fundingReferences":[],"url":"https://arxiv.org/abs/2608.03528","contentUrl":null,"metadataVersion":0,"schemaVersion":"http://datacite.org/schema/kernel-4","source":"mds","isActive":true,"state":"findable","reason":null,"viewCount":0,"downloadCount":0,"referenceCount":0,"citationCount":0,"partCount":0,"partOfCount":0,"versionCount":0,"versionOfCount":0,"created":"2026-08-05T02:15:03Z","registered":null,"published":null,"updated":"2026-08-05T02:15:03Z"},"relationships":{"client":{"data":{"id":"arxiv.content","type":"clients"}}}},{"id":"10.48550/arxiv.2608.03527","type":"dois","attributes":{"doi":"10.48550/arxiv.2608.03527","identifiers":[{"identifier":"2608.03527","identifierType":"arXiv"}],"creators":[{"nameType":"Personal","givenName":"Wenhan","familyName":"Liu","name":"Liu, Wenhan","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Yu","familyName":"Lu","name":"Lu, Yu","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Qiaolin","familyName":"Xia","name":"Xia, Qiaolin","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Hui","familyName":"Xu","name":"Xu, Hui","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Tong","familyName":"Zhao","name":"Zhao, Tong","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Jian","familyName":"Xi","name":"Xi, Jian","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Yutao","familyName":"Zhu","name":"Zhu, Yutao","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Haijin","familyName":"Liang","name":"Liang, Haijin","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Haibo","familyName":"Shi","name":"Shi, Haibo","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Hao","familyName":"Wang","name":"Wang, Hao","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Zhicheng","familyName":"Dou","name":"Dou, Zhicheng","affiliation":[],"nameIdentifiers":[]}],"titles":[{"title":"Training Documents Reranker with Search Rubrics for Deep Research Agent"}],"publisher":"arXiv","container":{},"publicationYear":2026,"subjects":[{"subject":"Information Retrieval (cs.IR)","lang":"en","subjectScheme":"arXiv"},{"subject":"Artificial Intelligence (cs.AI)","lang":"en","subjectScheme":"arXiv"},{"subject":"Computation and Language (cs.CL)","lang":"en","subjectScheme":"arXiv"},{"subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"}],"contributors":[],"dates":[{"date":"2026-08-04T12:11:14Z","dateType":"Submitted","dateInformation":"v1"},{"date":"2026-08-05T00:48:56Z","dateType":"Updated","dateInformation":"v1"},{"date":"2026-08","dateType":"Available","dateInformation":"v1"}],"language":null,"types":{"schemaOrg":"CreativeWork","resourceTypeGeneral":"Preprint","citeproc":"article","bibtex":"misc","ris":"GEN","resourceType":"Article"},"relatedIdentifiers":[],"relatedItems":[],"sizes":[],"formats":[],"version":"1","rightsList":[{"rightsUri":"http://arxiv.org/licenses/nonexclusive-distrib/1.0/","rights":"arXiv.org perpetual, non-exclusive license"}],"descriptions":[{"descriptionType":"Abstract","description":"Retrieval systems help deep research agents generate high-quality answers by providing relevant documents. However, existing retrievers typically select documents through relevance matching, while individually well-matched top-$k$ documents may not form a \\textit{set} that satisfies the complex information needs of an agent query (\\eg, diverse, concise and authoritative documents). In this paper, we propose search-oriented rubrics that \\textit{explicitly} define the requirements that high-quality document sets should satisfy for each agent query. Our search rubrics are organized into a hierarchical structure and synthesized using a powerful LLM. Based on these search rubrics, we further train a document reranker \\textbf{RubricRanker} to select a high-quality subset from retrieved documents. We design a two-stage training framework that consists of rubrics-guided supervised fine-tuning and rubric-based reinforcement learning. Extensive experiments demonstrate that RubricRanker outperforms the strongest baseline by 2.6 points on four deep research benchmarks and generalizes well to five RAG benchmarks."},{"descriptionType":"Other","description":"28 pages"}],"geoLocations":[],"fundingReferences":[],"url":"https://arxiv.org/abs/2608.03527","contentUrl":null,"metadataVersion":0,"schemaVersion":"http://datacite.org/schema/kernel-4","source":"mds","isActive":true,"state":"findable","reason":null,"viewCount":0,"downloadCount":0,"referenceCount":0,"citationCount":0,"partCount":0,"partOfCount":0,"versionCount":0,"versionOfCount":0,"created":"2026-08-05T02:15:01Z","registered":"2026-08-05T02:15:02Z","published":null,"updated":"2026-08-05T02:15:02Z"},"relationships":{"client":{"data":{"id":"arxiv.content","type":"clients"}}}},{"id":"10.48550/arxiv.2608.03524","type":"dois","attributes":{"doi":"10.48550/arxiv.2608.03524","identifiers":[{"identifier":"2608.03524","identifierType":"arXiv"}],"creators":[{"nameType":"Personal","givenName":"Fengjunjie","familyName":"Pan","name":"Pan, Fengjunjie","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Alois","familyName":"Knoll","name":"Knoll, Alois","affiliation":[],"nameIdentifiers":[]}],"titles":[{"title":"Dr. AGENTONOMICS: A Didactic Experiment of AGENTONOMICS"}],"publisher":"arXiv","container":{},"publicationYear":2026,"subjects":[{"subject":"Artificial Intelligence (cs.AI)","lang":"en","subjectScheme":"arXiv"},{"subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"}],"contributors":[],"dates":[{"date":"2026-08-04T12:07:23Z","dateType":"Submitted","dateInformation":"v1"},{"date":"2026-08-05T00:48:46Z","dateType":"Updated","dateInformation":"v1"},{"date":"2026-08","dateType":"Available","dateInformation":"v1"}],"language":null,"types":{"schemaOrg":"CreativeWork","resourceTypeGeneral":"Preprint","citeproc":"article","bibtex":"misc","ris":"GEN","resourceType":"Article"},"relatedIdentifiers":[],"relatedItems":[],"sizes":[],"formats":[],"version":"1","rightsList":[{"rightsIdentifierScheme":"SPDX","rightsUri":"https://creativecommons.org/licenses/by/4.0/legalcode","schemeUri":"https://spdx.org/licenses/","rights":"Creative Commons Attribution 4.0 International","rightsIdentifier":"cc-by-4.0"}],"descriptions":[{"descriptionType":"Abstract","description":"AGENTONOMICS is a framework that treats AI agents as economic entities that can be designed, managed, and governed through an integrated management architecture. Dr. AGENTONOMICS is its first application: a lecture agent developed in the context of the TUM course on AI agents in business administration. Conceived during the winter semester 2025/26 and first introduced to students in the summer semester 2026, it serves as a didactic experiment in which the agent is both the object that students study and the medium through which they learn and apply the framework. The current prototype is a web-based, retrieval-grounded tutor that explains AGENTONOMICS concepts and supports student questions. This report argues that the same system can grow beyond tutoring into three additional cumulative roles: an avatar lecturer that delivers multimodal instruction, a design consultant that guides students through the AGENTONOMICS Design \u0026amp; Management Reference Framework (ADMRF), and a meta-agent that helps construct the agents students have specified. These roles are cumulative because they share the same interface, intelligence layer, tools, knowledge base, and ecosystem connection, while an orchestrator selects the role-specific algorithm required for each task. We present the architecture of the prototype, outline its development roadmap, and discuss its implications for a polycentric AI economy. This report is intended to invite further discussion on how agents can teach, apply, and eventually reproduce the frameworks by which they are designed."},{"descriptionType":"Other","description":"Technical report, Technical University of Munich"}],"geoLocations":[],"fundingReferences":[],"url":"https://arxiv.org/abs/2608.03524","contentUrl":null,"metadataVersion":0,"schemaVersion":"http://datacite.org/schema/kernel-4","source":"mds","isActive":true,"state":"findable","reason":null,"viewCount":0,"downloadCount":0,"referenceCount":0,"citationCount":0,"partCount":0,"partOfCount":0,"versionCount":0,"versionOfCount":0,"created":"2026-08-05T02:14:57Z","registered":"2026-08-05T02:14:58Z","published":null,"updated":"2026-08-05T02:14:58Z"},"relationships":{"client":{"data":{"id":"arxiv.content","type":"clients"}}}},{"id":"10.48550/arxiv.2608.03523","type":"dois","attributes":{"doi":"10.48550/arxiv.2608.03523","identifiers":[{"identifier":"2608.03523","identifierType":"arXiv"}],"creators":[{"nameType":"Personal","givenName":"V. A.","familyName":"Sidorov","name":"Sidorov, V. A.","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"V. N.","familyName":"Krasnorussky","name":"Krasnorussky, V. N.","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"A. V.","familyName":"Bokov","name":"Bokov, A. V.","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Z. N.","familyName":"Volkova","name":"Volkova, Z. N.","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"A. P.","familyName":"Gerashchenko","name":"Gerashchenko, A. P.","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"N. M.","familyName":"Chtchelkatchev","name":"Chtchelkatchev, N. M.","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"M. V.","familyName":"Magnitskaya","name":"Magnitskaya, M. V.","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"D. A.","familyName":"Salamatin","name":"Salamatin, D. A.","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"A. V.","familyName":"Semeno","name":"Semeno, A. V.","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"V. V.","familyName":"Brazhkin","name":"Brazhkin, V. V.","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"A. V.","familyName":"Tsvyashchenko","name":"Tsvyashchenko, A. V.","affiliation":[],"nameIdentifiers":[]}],"titles":[{"title":"The New High-entropy Compound RhMnFeCoGe4 with Cubic Non-centrosymmetric B20 Structure"}],"publisher":"arXiv","container":{},"publicationYear":2026,"subjects":[{"subject":"Materials Science (cond-mat.mtrl-sci)","lang":"en","subjectScheme":"arXiv"},{"subject":"Strongly Correlated Electrons (cond-mat.str-el)","lang":"en","subjectScheme":"arXiv"},{"subject":"FOS: Physical sciences","subjectScheme":"Fields of Science and Technology (FOS)"}],"contributors":[],"dates":[{"date":"2026-08-04T12:07:01Z","dateType":"Submitted","dateInformation":"v1"},{"date":"2026-08-05T00:48:45Z","dateType":"Updated","dateInformation":"v1"},{"date":"2026-08","dateType":"Available","dateInformation":"v1"}],"language":null,"types":{"schemaOrg":"CreativeWork","resourceTypeGeneral":"Preprint","citeproc":"article","bibtex":"misc","ris":"GEN","resourceType":"Article"},"relatedIdentifiers":[],"relatedItems":[],"sizes":[],"formats":[],"version":"1","rightsList":[{"rightsIdentifierScheme":"SPDX","rightsUri":"https://creativecommons.org/licenses/by/4.0/legalcode","schemeUri":"https://spdx.org/licenses/","rights":"Creative Commons Attribution 4.0 International","rightsIdentifier":"cc-by-4.0"}],"descriptions":[{"descriptionType":"Abstract","description":"A novel high-entropy compound, RhMnFeCoGe$_4$, with a cubic non-centrosymmetric B20 struc- ture, has been synthesized under conditions of high pressure and temperature. The electrical transport and magnetic properties of the obtained compound at both ambient and elevated pres- sures have been investigated. In addition, nuclear magnetic resonance (NMR) spectra were obtained at 4.2 K and ab initio calculations were performed. The new material exhibits ferromag- netic behavior with a critical temperature of $T_C$ = 146 K and a spontaneous moment of 2.5 $μ_B$ per formula unit. The magnetization data obtained at the critical region yielded the critical temperature and exponents, which were found to be $T_C$ = 146(1) K, $β$ = 0.337(1), $γ$ = 1.121(1), and $δ$ = 4.326(1). The magnetic moments of Mn and Co were determined from NMR spectra to be 2.2 $μ_B$ and 0.5 $μ_B$, respectively. Ab initio calculations yielded reasonable values for the lattice parameter and the magnetic moments of all constituents. The density of states and band structure are determined for both paramagnetic and ferromagnetic states. Lattice compression results in the increase in the $T_C$."}],"geoLocations":[],"fundingReferences":[],"url":"https://arxiv.org/abs/2608.03523","contentUrl":null,"metadataVersion":0,"schemaVersion":"http://datacite.org/schema/kernel-4","source":"mds","isActive":true,"state":"findable","reason":null,"viewCount":0,"downloadCount":0,"referenceCount":0,"citationCount":0,"partCount":0,"partOfCount":0,"versionCount":0,"versionOfCount":0,"created":"2026-08-05T02:14:56Z","registered":null,"published":null,"updated":"2026-08-05T02:14:56Z"},"relationships":{"client":{"data":{"id":"arxiv.content","type":"clients"}}}},{"id":"10.48550/arxiv.2608.03521","type":"dois","attributes":{"doi":"10.48550/arxiv.2608.03521","identifiers":[{"identifier":"2608.03521","identifierType":"arXiv"}],"creators":[{"nameType":"Personal","givenName":"Xiucong","familyName":"Zhao","name":"Zhao, Xiucong","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Jindong","familyName":"Tian","name":"Tian, Jindong","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Hao","familyName":"Miao","name":"Miao, Hao","affiliation":[],"nameIdentifiers":[]}],"titles":[{"title":"Pivot-Centric Trajectory Prediction: Bridging Long Horizons via Dynamical Guidance"}],"publisher":"arXiv","container":{},"publicationYear":2026,"subjects":[{"subject":"Robotics (cs.RO)","lang":"en","subjectScheme":"arXiv"},{"subject":"Artificial Intelligence (cs.AI)","lang":"en","subjectScheme":"arXiv"},{"subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"}],"contributors":[],"dates":[{"date":"2026-08-04T12:05:15Z","dateType":"Submitted","dateInformation":"v1"},{"date":"2026-08-05T00:48:41Z","dateType":"Updated","dateInformation":"v1"},{"date":"2026-08","dateType":"Available","dateInformation":"v1"}],"language":null,"types":{"schemaOrg":"CreativeWork","resourceTypeGeneral":"Preprint","citeproc":"article","bibtex":"misc","ris":"GEN","resourceType":"Article"},"relatedIdentifiers":[],"relatedItems":[],"sizes":[],"formats":[],"version":"1","rightsList":[{"rightsUri":"http://arxiv.org/licenses/nonexclusive-distrib/1.0/","rights":"arXiv.org perpetual, non-exclusive license"}],"descriptions":[{"descriptionType":"Abstract","description":"Forecasting precise future motion of surrounding agents is essential for reliable autonomous vehicles. However, as the demand for longer prediction horizons increases, existing endpoint-completion or iterative-refine methods increasingly struggle with weak guidance and compounding errors. To tackle the long-horizon prediction challenge, we propose Pivot-Centric Trajectory Prediction (PCTP). By introducing ``pivots'' and focusing on predicting pivot points along extended trajectories, we divide the long-term prediction task into short-term sub-tasks at various scales. Specifically, PCTP decouples the long-term trajectory predicting process into two processes: pivot prediction and pivot-based trajectory refinement. The pivot prediction process aims to utilize global map context and agent-to-agent interactions to identify these ``pivot points'', while the pivot-based trajectory refinement process focuses on local map details and refines the short-term trajectory based on predicted ``pivot points''. Compared with existing methods, PCTP provides more intermediate guidance while reducing compounding errors. Moreover, PCTP is a flexible approach that can be integrated into most state-of-the-art trajectory prediction models. Experimental results show that PCTP improves the prediction accuracy of leading models on both Argoverse I and Argoverse II datasets with minimal impact on model size. Specifically, PCTP combined with QCNet outperforms all published ensemble-free methods on the Argoverse II leaderboard at submission."},{"descriptionType":"Other","description":"Spatiotemporal Forecasting, Autonomous Driving, Trajectory Prediction"}],"geoLocations":[],"fundingReferences":[],"url":"https://arxiv.org/abs/2608.03521","contentUrl":null,"metadataVersion":0,"schemaVersion":"http://datacite.org/schema/kernel-4","source":"mds","isActive":true,"state":"findable","reason":null,"viewCount":0,"downloadCount":0,"referenceCount":0,"citationCount":0,"partCount":0,"partOfCount":0,"versionCount":0,"versionOfCount":0,"created":"2026-08-05T02:14:53Z","registered":null,"published":null,"updated":"2026-08-05T02:14:53Z"},"relationships":{"client":{"data":{"id":"arxiv.content","type":"clients"}}}},{"id":"10.48550/arxiv.2608.03520","type":"dois","attributes":{"doi":"10.48550/arxiv.2608.03520","identifiers":[{"identifier":"2608.03520","identifierType":"arXiv"}],"creators":[{"nameType":"Personal","givenName":"Ali","familyName":"Dehghantanha","name":"Dehghantanha, Ali","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Sajad","familyName":"Homayoun","name":"Homayoun, Sajad","affiliation":[],"nameIdentifiers":[]}],"titles":[{"title":"AI Forensics Across White-, Grey-, and Black-Box Access: A Process Model and Research Agenda for Post-Incident Investigation of AI Systems"}],"publisher":"arXiv","container":{},"publicationYear":2026,"subjects":[{"subject":"Cryptography and Security (cs.CR)","lang":"en","subjectScheme":"arXiv"},{"subject":"Artificial Intelligence (cs.AI)","lang":"en","subjectScheme":"arXiv"},{"subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"}],"contributors":[],"dates":[{"date":"2026-08-04T12:04:57Z","dateType":"Submitted","dateInformation":"v1"},{"date":"2026-08-05T00:48:41Z","dateType":"Updated","dateInformation":"v1"},{"date":"2026-08","dateType":"Available","dateInformation":"v1"}],"language":null,"types":{"schemaOrg":"CreativeWork","resourceTypeGeneral":"Preprint","citeproc":"article","bibtex":"misc","ris":"GEN","resourceType":"Article"},"relatedIdentifiers":[],"relatedItems":[],"sizes":[],"formats":[],"version":"1","rightsList":[{"rightsUri":"http://arxiv.org/licenses/nonexclusive-distrib/1.0/","rights":"arXiv.org perpetual, non-exclusive license"}],"descriptions":[{"descriptionType":"Abstract","description":"AI systems are increasingly involved in decisions and actions that may later require investigation. When an AI related incident occurs, investigators need to reconstruct what the system did, why it behaved that way, and which part of the system or supply chain contributed to the outcome. Existing work on AI forensics remains fragmented, often focusing on a specific system type, artifact, or analysis technique. This paper argues that investigator access is a useful starting point for organizing the field. We distinguish white box, grey box, and black box access and show how each access level changes what can be collected, preserved, analyzed, and reported. Based on this distinction, we propose a process model matrix for AI forensics across four phases: collection, preservation, analysis, and reporting. We also introduce an order of volatility for AI systems, covering runtime state, context windows, logs, retrieval stores, model artifacts, and training lineage. From this matrix, we derive an access conditioned examination framework and identify open research problems, including black box preservation, model version attestation, uncertainty quantification for surrogate based analysis, and chain of custody for mutable AI artifacts."}],"geoLocations":[],"fundingReferences":[],"url":"https://arxiv.org/abs/2608.03520","contentUrl":null,"metadataVersion":0,"schemaVersion":"http://datacite.org/schema/kernel-4","source":"mds","isActive":true,"state":"findable","reason":null,"viewCount":0,"downloadCount":0,"referenceCount":0,"citationCount":0,"partCount":0,"partOfCount":0,"versionCount":0,"versionOfCount":0,"created":"2026-08-05T02:14:51Z","registered":"2026-08-05T02:14:52Z","published":null,"updated":"2026-08-05T02:14:52Z"},"relationships":{"client":{"data":{"id":"arxiv.content","type":"clients"}}}},{"id":"10.48550/arxiv.2608.03519","type":"dois","attributes":{"doi":"10.48550/arxiv.2608.03519","identifiers":[{"identifier":"2608.03519","identifierType":"arXiv"}],"creators":[{"nameType":"Personal","givenName":"Jianquan","familyName":"Ge","name":"Ge, Jianquan","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Yuyang","familyName":"Zhao","name":"Zhao, Yuyang","affiliation":[],"nameIdentifiers":[]}],"titles":[{"title":"Examples of Curvature Inhomogeneous Submanifolds with Constant Ricci Eigenvalues"}],"publisher":"arXiv","container":{},"publicationYear":2026,"subjects":[{"subject":"Differential Geometry (math.DG)","lang":"en","subjectScheme":"arXiv"},{"subject":"FOS: Mathematics","subjectScheme":"Fields of Science and Technology (FOS)"},{"subject":"53C42, 53C40, 53C25, 53B25","lang":"en","subjectScheme":"MSC"}],"contributors":[],"dates":[{"date":"2026-08-04T12:03:57Z","dateType":"Submitted","dateInformation":"v1"},{"date":"2026-08-05T00:48:34Z","dateType":"Updated","dateInformation":"v1"},{"date":"2026-08","dateType":"Available","dateInformation":"v1"}],"language":null,"types":{"schemaOrg":"CreativeWork","resourceTypeGeneral":"Preprint","citeproc":"article","bibtex":"misc","ris":"GEN","resourceType":"Article"},"relatedIdentifiers":[],"relatedItems":[],"sizes":[],"formats":[],"version":"1","rightsList":[{"rightsUri":"http://arxiv.org/licenses/nonexclusive-distrib/1.0/","rights":"arXiv.org perpetual, non-exclusive license"}],"descriptions":[{"descriptionType":"Abstract","description":"We construct two families of curvature inhomogeneous Riemannian manifolds with constant Ricci eigenvalues. The first, derived from the Einstein warped products, has two distinct Ricci eigenvalues and admits a local isometric immersion of minimum codimension two. The second, arising from the Riemannian Schwarzschild--Tangherlini manifold, has $k+1$ distinct Ricci eigenvalues and admits an isometric embedding of codimension $k+2$, which is the smallest within the adapted product class."}],"geoLocations":[],"fundingReferences":[],"url":"https://arxiv.org/abs/2608.03519","contentUrl":null,"metadataVersion":0,"schemaVersion":"http://datacite.org/schema/kernel-4","source":"mds","isActive":true,"state":"findable","reason":null,"viewCount":0,"downloadCount":0,"referenceCount":0,"citationCount":0,"partCount":0,"partOfCount":0,"versionCount":0,"versionOfCount":0,"created":"2026-08-05T02:14:50Z","registered":"2026-08-05T02:14:51Z","published":null,"updated":"2026-08-05T02:14:51Z"},"relationships":{"client":{"data":{"id":"arxiv.content","type":"clients"}}}},{"id":"10.48550/arxiv.2608.03518","type":"dois","attributes":{"doi":"10.48550/arxiv.2608.03518","identifiers":[{"identifier":"2608.03518","identifierType":"arXiv"}],"creators":[{"nameType":"Personal","givenName":"Stefano","familyName":"Pellegrino","name":"Pellegrino, Stefano","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Giulia","familyName":"Vannucci","name":"Vannucci, Giulia","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Roberta","familyName":"Siciliano","name":"Siciliano, Roberta","affiliation":[],"nameIdentifiers":[]}],"titles":[{"title":"From Efficient Frontier to Fragile Frontier: A Global Sensitivity Analysis of Markowitz Portfolios"}],"publisher":"arXiv","container":{},"publicationYear":2026,"subjects":[{"subject":"Applications (stat.AP)","lang":"en","subjectScheme":"arXiv"},{"subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"}],"contributors":[],"dates":[{"date":"2026-08-04T12:03:10Z","dateType":"Submitted","dateInformation":"v1"},{"date":"2026-08-05T00:48:33Z","dateType":"Updated","dateInformation":"v1"},{"date":"2026-08","dateType":"Available","dateInformation":"v1"}],"language":null,"types":{"schemaOrg":"CreativeWork","resourceTypeGeneral":"Preprint","citeproc":"article","bibtex":"misc","ris":"GEN","resourceType":"Article"},"relatedIdentifiers":[],"relatedItems":[],"sizes":[],"formats":[],"version":"1","rightsList":[{"rightsUri":"http://arxiv.org/licenses/nonexclusive-distrib/1.0/","rights":"arXiv.org perpetual, non-exclusive license"}],"descriptions":[{"descriptionType":"Abstract","description":"In mean-variance portfolio analysis, the efficient frontier represents the optimal trade-off between expected return and risk, assuming stable underlying parameters. This paper investigates portfolio fragility: the instability of optimal weights, risk-adjusted performance, and diversification when model inputs and construction choices are jointly perturbed. Combining constrained Markowitz optimization with variance-based global sensitivity analysis (Sobol indices), we map out how input uncertainty and portfolio-construction choices propagate along the target-return dimension. Using an empirical universe of multi-asset exchange-traded funds (ETFs), we find a distinct transition in the sensitivity structure: in the baseline experiment, lower target returns are dominated by l2 regularization, whereas aggressive return requirements become increasingly sen- sitive to the weight cap and expected-return perturbations. This shift coincides with a sharp drop in effective diversification and a rise in weight dispersion. We extend the analysis to a multi-universe fragility atlas, showing that under a com- mon absolute concentration rule, the smallest universe is weight-cap-driven in the aggressive return region, while larger sampled universes remain more often regularization-driven. The fragile frontier serves as a direct diagnostic tool to evaluate the structural robustness of constrained optimizers without altering the underlying allocation rule."}],"geoLocations":[],"fundingReferences":[],"url":"https://arxiv.org/abs/2608.03518","contentUrl":null,"metadataVersion":0,"schemaVersion":"http://datacite.org/schema/kernel-4","source":"mds","isActive":true,"state":"findable","reason":null,"viewCount":0,"downloadCount":0,"referenceCount":0,"citationCount":0,"partCount":0,"partOfCount":0,"versionCount":0,"versionOfCount":0,"created":"2026-08-05T02:14:49Z","registered":null,"published":null,"updated":"2026-08-05T02:14:49Z"},"relationships":{"client":{"data":{"id":"arxiv.content","type":"clients"}}}},{"id":"10.48550/arxiv.2608.03517","type":"dois","attributes":{"doi":"10.48550/arxiv.2608.03517","identifiers":[{"identifier":"2608.03517","identifierType":"arXiv"}],"creators":[{"nameType":"Personal","givenName":"Ziyue","familyName":"Zeng","name":"Zeng, Ziyue","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Dingjie","familyName":"Peng","name":"Peng, Dingjie","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Xun","familyName":"Su","name":"Su, Xun","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Hiroshi","familyName":"Watanabe","name":"Watanabe, Hiroshi","affiliation":[],"nameIdentifiers":[]}],"titles":[{"title":"GVCCTurbo: Rate-Compute Quality Scheduling for Codebook Driven Generative Compression"}],"publisher":"arXiv","container":{},"publicationYear":2026,"subjects":[{"subject":"Computer Vision and Pattern Recognition (cs.CV)","lang":"en","subjectScheme":"arXiv"},{"subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"}],"contributors":[],"dates":[{"date":"2026-08-04T11:59:17Z","dateType":"Submitted","dateInformation":"v1"},{"date":"2026-08-05T00:48:29Z","dateType":"Updated","dateInformation":"v1"},{"date":"2026-08","dateType":"Available","dateInformation":"v1"}],"language":null,"types":{"schemaOrg":"CreativeWork","resourceTypeGeneral":"Preprint","citeproc":"article","bibtex":"misc","ris":"GEN","resourceType":"Article"},"relatedIdentifiers":[],"relatedItems":[],"sizes":[],"formats":[],"version":"1","rightsList":[{"rightsUri":"http://arxiv.org/licenses/nonexclusive-distrib/1.0/","rights":"arXiv.org perpetual, non-exclusive license"}],"descriptions":[{"descriptionType":"Abstract","description":"Codebook-driven generative compression uses a pretrained image or video generator as a zero-shot visual prior and transmits compact codebook indices to guide reconstruction at ultra-low bitrate. Current codecs tie each finite-rate correction to a fresh prior evaluation, so shortening the sampler also removes correction slots that carry target-dependent information. We propose GVCCTurbo, a BPP-driven scheduler that separates expensive prior refreshes from codebook corrections: after calibrating an atom-count operating point and skip-gap ratio once per protocol, it maps a target codebook-payload bitrate to a trajectory length and refresh period, making BPP a schedule input instead of a fixed consequence of sampler length. The same endpoint-prediction and finite-rate steering interface covers GVCC-style rectified-flow video and DDCM-style diffusion image compression, preserving zero-training deployment and compatibility with future distilled priors. Native 1080p curves position the complete zero-shot codec in the ultra-low-bitrate regime. In a controlled 720p Wan-GVCC study, the scheduler cuts prior evaluations from 20 to 9 for a $\\sim\\!44\\%$ measured decoding-time reduction shared across the whole schedule family, at a small shared LPIPS cost on high-motion content; within that family, uniform refresh thinning (pure-skip) is a boundary point, and the BPP-aware interior point trades $2.9\\%$ fewer codebook-payload bits for consistently higher PSNR at comparable LPIPS. These results support BPP-to-compute scheduling as a controllable extension of sampler-length tuning, without requiring the allocated point to dominate every boundary point."}],"geoLocations":[],"fundingReferences":[],"url":"https://arxiv.org/abs/2608.03517","contentUrl":null,"metadataVersion":0,"schemaVersion":"http://datacite.org/schema/kernel-4","source":"mds","isActive":true,"state":"findable","reason":null,"viewCount":0,"downloadCount":0,"referenceCount":0,"citationCount":0,"partCount":0,"partOfCount":0,"versionCount":0,"versionOfCount":0,"created":"2026-08-05T02:14:47Z","registered":"2026-08-05T02:14:48Z","published":null,"updated":"2026-08-05T02:14:48Z"},"relationships":{"client":{"data":{"id":"arxiv.content","type":"clients"}}}},{"id":"10.48550/arxiv.2608.03516","type":"dois","attributes":{"doi":"10.48550/arxiv.2608.03516","identifiers":[{"identifier":"2608.03516","identifierType":"arXiv"}],"creators":[{"nameType":"Personal","givenName":"Robin","familyName":"Chan","name":"Chan, Robin","affiliation":[],"nameIdentifiers":[]}],"titles":[{"title":"Detecting Pose Estimation Failures via Keypoint Self-Consistency"}],"publisher":"arXiv","container":{},"publicationYear":2026,"subjects":[{"subject":"Computer Vision and Pattern Recognition (cs.CV)","lang":"en","subjectScheme":"arXiv"},{"subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"}],"contributors":[],"dates":[{"date":"2026-08-04T11:59:10Z","dateType":"Submitted","dateInformation":"v1"},{"date":"2026-08-05T00:48:28Z","dateType":"Updated","dateInformation":"v1"},{"date":"2026-08","dateType":"Available","dateInformation":"v1"}],"language":null,"types":{"schemaOrg":"CreativeWork","resourceTypeGeneral":"Preprint","citeproc":"article","bibtex":"misc","ris":"GEN","resourceType":"Article"},"relatedIdentifiers":[],"relatedItems":[],"sizes":[],"formats":[],"version":"1","rightsList":[{"rightsIdentifierScheme":"SPDX","rightsUri":"https://creativecommons.org/licenses/by/4.0/legalcode","schemeUri":"https://spdx.org/licenses/","rights":"Creative Commons Attribution 4.0 International","rightsIdentifier":"cc-by-4.0"}],"descriptions":[{"descriptionType":"Abstract","description":"One common approach to pose estimation involves predicting object keypoints in an image, followed by using Perspective-n-Point algorithms to compute the object's rotation and translation relative to the camera. While rotations preserve object shapes, this property is often neglected in keypoint-based pose estimation methods, where keypoints are typically predicted independently from each other. As imprecise keypoint predictions negatively affects pose estimation accuracy, it also limits its reliability in downstream tasks. In this work, we explore whether such inaccurate pose estimates can be identified by simply examining spatial locations between 2D keypoints. We propose a set of hand-crafted geometric features that capture the self-consistency of keypoint predictions, including pairwise distances, reprojection consistency, as well as render and mask consistency. Despite its simplicity, a logistic regression classifier trained on these features reliably detects pose estimation failures, outperforming confidence-based approaches like conformal keypoint predictions that rely solely on keypoint uncertainty."}],"geoLocations":[],"fundingReferences":[],"url":"https://arxiv.org/abs/2608.03516","contentUrl":null,"metadataVersion":0,"schemaVersion":"http://datacite.org/schema/kernel-4","source":"mds","isActive":true,"state":"findable","reason":null,"viewCount":0,"downloadCount":0,"referenceCount":0,"citationCount":0,"partCount":0,"partOfCount":0,"versionCount":0,"versionOfCount":0,"created":"2026-08-05T02:14:46Z","registered":null,"published":null,"updated":"2026-08-05T02:14:47Z"},"relationships":{"client":{"data":{"id":"arxiv.content","type":"clients"}}}},{"id":"10.48550/arxiv.2608.03515","type":"dois","attributes":{"doi":"10.48550/arxiv.2608.03515","identifiers":[{"identifier":"2608.03515","identifierType":"arXiv"}],"creators":[{"nameType":"Personal","givenName":"Pauline","familyName":"Schauerte","name":"Schauerte, Pauline","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Jaime Fabián Nieto","familyName":"Castellanos","name":"Castellanos, Jaime Fabián Nieto","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Arnold","familyName":"Krechel","name":"Krechel, Arnold","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Marc Alexander","familyName":"Schweitzer","name":"Schweitzer, Marc Alexander","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Stefan","familyName":"Krieg","name":"Krieg, Stefan","affiliation":[],"nameIdentifiers":[]}],"titles":[{"title":"A first look at Structured-Multiscale Algebraic Multigrid for Lattice Field Theory"}],"publisher":"arXiv","container":{},"publicationYear":2026,"subjects":[{"subject":"High Energy Physics - Lattice (hep-lat)","lang":"en","subjectScheme":"arXiv"},{"subject":"FOS: Physical sciences","subjectScheme":"Fields of Science and Technology (FOS)"}],"contributors":[],"dates":[{"date":"2026-08-04T11:58:07Z","dateType":"Submitted","dateInformation":"v1"},{"date":"2026-08-05T00:48:27Z","dateType":"Updated","dateInformation":"v1"},{"date":"2026-08","dateType":"Available","dateInformation":"v1"}],"language":null,"types":{"schemaOrg":"CreativeWork","resourceTypeGeneral":"Preprint","citeproc":"article","bibtex":"misc","ris":"GEN","resourceType":"Article"},"relatedIdentifiers":[],"relatedItems":[],"sizes":[],"formats":[],"version":"1","rightsList":[{"rightsIdentifierScheme":"SPDX","rightsUri":"https://creativecommons.org/licenses/by/4.0/legalcode","schemeUri":"https://spdx.org/licenses/","rights":"Creative Commons Attribution 4.0 International","rightsIdentifier":"cc-by-4.0"}],"descriptions":[{"descriptionType":"Abstract","description":"State-of-the-art solvers for the Dirac equation in Lattice QCD are based on adaptive multigrid methods. These require fine-tuning of many algorithmic parameters to achieve optimal performance. We apply a new multigrid approach to Lattice Field Theory adapted from oil-reservoir simulations: Structured-Multiscale Algebraic Multigrid (SM-AMG). This method builds compact aggregates with overlapping borders to coarsen the grid and yields accurate interpolation. A key advantage is that aggregate size is the primary tunable parameter. For our results, we used SM-AMG in an algebraic approach, called Aggregative-Multiscale AMG (AM-AMG). We benchmark the efficiency of AM-AMG against that of DD$α$AMG, a successful adaptive multigrid solver which alleviates critical slowing down. The two solvers are compared within the framework of the two-flavor Schwinger model using the Wilson discretization. On fine lattices, the operation count of both methods is similar near the critical point and for large volumes, reflecting a comparable computational cost. However, the number of fine-grid iterations is larger for AM-AMG. On coarse lattices, AM-AMG encounters difficulties to remove the low modes close to the critical mass."},{"descriptionType":"Other","description":"16 pages, 7 figures, 2 algorithms, 4 tables, submitted to Computer Physics Communications"}],"geoLocations":[],"fundingReferences":[],"url":"https://arxiv.org/abs/2608.03515","contentUrl":null,"metadataVersion":0,"schemaVersion":"http://datacite.org/schema/kernel-4","source":"mds","isActive":true,"state":"findable","reason":null,"viewCount":0,"downloadCount":0,"referenceCount":0,"citationCount":0,"partCount":0,"partOfCount":0,"versionCount":0,"versionOfCount":0,"created":"2026-08-05T02:14:44Z","registered":"2026-08-05T02:14:45Z","published":null,"updated":"2026-08-05T02:14:45Z"},"relationships":{"client":{"data":{"id":"arxiv.content","type":"clients"}}}},{"id":"10.48550/arxiv.2608.03514","type":"dois","attributes":{"doi":"10.48550/arxiv.2608.03514","identifiers":[{"identifier":"2608.03514","identifierType":"arXiv"}],"creators":[{"nameType":"Personal","givenName":"Eiman","familyName":"Kanjo","name":"Kanjo, Eiman","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Varuna","familyName":"De Silva","name":"De Silva, Varuna","affiliation":[],"nameIdentifiers":[]}],"titles":[{"title":"Beyond Peak TOPS/W: A System-Level Perspective on Hybrid Digital, Analogue and Neuromorphic Computing"}],"publisher":"arXiv","container":{},"publicationYear":2026,"subjects":[{"subject":"Hardware Architecture (cs.AR)","lang":"en","subjectScheme":"arXiv"},{"subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"}],"contributors":[],"dates":[{"date":"2026-08-04T11:57:50Z","dateType":"Submitted","dateInformation":"v1"},{"date":"2026-08-05T00:48:25Z","dateType":"Updated","dateInformation":"v1"},{"date":"2026-08","dateType":"Available","dateInformation":"v1"}],"language":null,"types":{"schemaOrg":"CreativeWork","resourceTypeGeneral":"Preprint","citeproc":"article","bibtex":"misc","ris":"GEN","resourceType":"Article"},"relatedIdentifiers":[],"relatedItems":[],"sizes":[],"formats":[],"version":"1","rightsList":[{"rightsIdentifierScheme":"SPDX","rightsUri":"https://creativecommons.org/licenses/by-nc-sa/4.0/legalcode","schemeUri":"https://spdx.org/licenses/","rights":"Creative Commons Attribution Non Commercial Share Alike 4.0 International","rightsIdentifier":"cc-by-nc-sa-4.0"}],"descriptions":[{"descriptionType":"Abstract","description":"The digital revolution, which progressively replaced analogue methods with digital circuits, has entered a new phase as AI expands across cloud infrastructure, mobile networks, wearables and physical systems, including drones and robots. Digital computing remains the general-purpose foundation of this expansion: it supports heterogeneous, on-device and decentralised AI through programmable control, mature software and decades of accumulated engineering infrastructure. Yet as energy and data-movement constraints become more significant, that same foundation is increasingly being extended rather than replaced by selected analogue and physical principles that it can host, configure and verify. Photonic, in-memory and neuromorphic architectures offer routes to reducing data movement and accelerating matrix-intensive and event-driven processing, not as alternatives to digital infrastructure but as specialised engines operating within it. This paper argues that hybrid digital--analogue computing represents a credible pathway towards more energy-efficient AI systems: one in which physical substrates earn an expanding role only where they deliver a measurable system-level advantage, under digital orchestration that manages integration, uncertainty and fallback. It examines the architectural principles, workload suitability, energy accounting, software requirements, limitations and open challenges associated with this transition, and argues that future progress should be evaluated through deployed-system metrics rather than isolated peak tera operations per second per watt (TOPS/W) claims."}],"geoLocations":[],"fundingReferences":[],"url":"https://arxiv.org/abs/2608.03514","contentUrl":null,"metadataVersion":0,"schemaVersion":"http://datacite.org/schema/kernel-4","source":"mds","isActive":true,"state":"findable","reason":null,"viewCount":0,"downloadCount":0,"referenceCount":0,"citationCount":0,"partCount":0,"partOfCount":0,"versionCount":0,"versionOfCount":0,"created":"2026-08-05T02:14:43Z","registered":"2026-08-05T02:14:44Z","published":null,"updated":"2026-08-05T02:14:44Z"},"relationships":{"client":{"data":{"id":"arxiv.content","type":"clients"}}}},{"id":"10.48550/arxiv.2608.03512","type":"dois","attributes":{"doi":"10.48550/arxiv.2608.03512","identifiers":[{"identifier":"2608.03512","identifierType":"arXiv"}],"creators":[{"nameType":"Personal","givenName":"Sefika","familyName":"Efeoglu","name":"Efeoglu, Sefika","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Adrian","familyName":"Paschke","name":"Paschke, Adrian","affiliation":[],"nameIdentifiers":[]}],"titles":[{"title":"Reversing Arrows in Large Language Models"}],"publisher":"arXiv","container":{},"publicationYear":2026,"subjects":[{"subject":"Artificial Intelligence (cs.AI)","lang":"en","subjectScheme":"arXiv"},{"subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"}],"contributors":[],"dates":[{"date":"2026-08-04T11:56:02Z","dateType":"Submitted","dateInformation":"v1"},{"date":"2026-08-05T00:48:23Z","dateType":"Updated","dateInformation":"v1"},{"date":"2026-08","dateType":"Available","dateInformation":"v1"}],"language":null,"types":{"schemaOrg":"CreativeWork","resourceTypeGeneral":"Preprint","citeproc":"article","bibtex":"misc","ris":"GEN","resourceType":"Article"},"relatedIdentifiers":[],"relatedItems":[],"sizes":[],"formats":[],"version":"1","rightsList":[{"rightsIdentifierScheme":"SPDX","rightsUri":"https://creativecommons.org/licenses/by/4.0/legalcode","schemeUri":"https://spdx.org/licenses/","rights":"Creative Commons Attribution 4.0 International","rightsIdentifier":"cc-by-4.0"}],"descriptions":[{"descriptionType":"Abstract","description":"Large language models (LLMs) have achieved strong performance on text-to-knowledge graph generation and related tasks. Nevertheless, it is still unclear whether they accurately model the direction-dependent semantics of inverse relations, in which reversing the order of the arguments alters the meaning of a relation (e.g., \\textit{mother} versus \\textit{child}). To the best of our knowledge, this work presents the first systematic study of inverse relation directionality in LLMs, using a benchmark consisting of 5,457 instances spanning 27 distinct inverse relation labels. We evaluate five open-source LLMs under a multiple-choice prompting framework and further examine the influence of relation descriptions and entity representations by substituting the original entities with synthetic and masked entities. Our findings reveal systematic asymmetries in inverse relation classification across LLMs, indicate that relation descriptions do not consistently improve performance, and show that model performance can be sensitive to variations in entity representations."},{"descriptionType":"Other","description":"The preprint is under review in a venue"}],"geoLocations":[],"fundingReferences":[],"url":"https://arxiv.org/abs/2608.03512","contentUrl":null,"metadataVersion":0,"schemaVersion":"http://datacite.org/schema/kernel-4","source":"mds","isActive":true,"state":"findable","reason":null,"viewCount":0,"downloadCount":0,"referenceCount":0,"citationCount":0,"partCount":0,"partOfCount":0,"versionCount":0,"versionOfCount":0,"created":"2026-08-05T02:14:40Z","registered":null,"published":null,"updated":"2026-08-05T02:14:41Z"},"relationships":{"client":{"data":{"id":"arxiv.content","type":"clients"}}}},{"id":"10.48550/arxiv.2608.03510","type":"dois","attributes":{"doi":"10.48550/arxiv.2608.03510","identifiers":[{"identifier":"2608.03510","identifierType":"arXiv"}],"creators":[{"nameType":"Personal","givenName":"Zhi-Guo","familyName":"He","name":"He, Zhi-Guo","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Xiao-Bo","familyName":"Jin","name":"Jin, Xiao-Bo","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Bernd A.","familyName":"Kniehl","name":"Kniehl, Bernd A.","affiliation":[],"nameIdentifiers":[]}],"titles":[{"title":"Probing Heavy-Quark Spin Symmetry in Double $J/ψ$ Hadroproduction"}],"publisher":"arXiv","container":{},"publicationYear":2026,"subjects":[{"subject":"High Energy Physics - Phenomenology (hep-ph)","lang":"en","subjectScheme":"arXiv"},{"subject":"High Energy Physics - Experiment (hep-ex)","lang":"en","subjectScheme":"arXiv"},{"subject":"FOS: Physical sciences","subjectScheme":"Fields of Science and Technology (FOS)"}],"contributors":[],"dates":[{"date":"2026-08-04T11:52:41Z","dateType":"Submitted","dateInformation":"v1"},{"date":"2026-08-05T00:48:18Z","dateType":"Updated","dateInformation":"v1"},{"date":"2026-08","dateType":"Available","dateInformation":"v1"}],"language":null,"types":{"schemaOrg":"CreativeWork","resourceTypeGeneral":"Preprint","citeproc":"article","bibtex":"misc","ris":"GEN","resourceType":"Article"},"relatedIdentifiers":[],"relatedItems":[],"sizes":[],"formats":[],"version":"1","rightsList":[{"rightsIdentifierScheme":"SPDX","rightsUri":"https://creativecommons.org/licenses/by/4.0/legalcode","schemeUri":"https://spdx.org/licenses/","rights":"Creative Commons Attribution 4.0 International","rightsIdentifier":"cc-by-4.0"}],"descriptions":[{"descriptionType":"Abstract","description":"We perform the first complete $\\mathcal{O}(α_s^5)$ analysis of the prompt hadroproduction of $J/ψ$ pairs with large transverse momenta $p_T^{ψψ}$ in the nonrelativistic-QCD factorization framework, including all possible Fock state combinations $c\\bar{c}(m)+c\\bar{c}(n)$, with $m,n={}^3S_1^{[1,8]},{}^1S_0^{[8]},{}^3P_J^{[1,8]}$. We observe that CMS and ATLAS data constrain a specific linear combination of the long-distance matrix elements (LDMEs) $\\langle\\mathcal{O}^{J/ψ}({}^1S_0^{[8]})\\rangle$ and $\\langle\\mathcal{O}^{J/ψ}({}^3P_0^{[8]})\\rangle$. In conjunction with two other combinations fixed by single prompt $J/ψ$ hadroproduction, we gain a new LDME set, which turns out to be largely compatible with the world data of prompt $J/ψ$ yield and polarization and to probe heavy-quark spin symmetry, by which agreement is established with LHCb data of prompt $η_c$ yield. Our $\\mathcal{O}(α_s^5)$ predictions also nicely agree with CMS and ATLAS data in the lowest bins of $J/ψ$ pair invariant mass $m^{ψψ}$, beyond leading-order kinematics."},{"descriptionType":"Other","description":"7 pages, 3 figures, 1 table"}],"geoLocations":[],"fundingReferences":[],"url":"https://arxiv.org/abs/2608.03510","contentUrl":null,"metadataVersion":0,"schemaVersion":"http://datacite.org/schema/kernel-4","source":"mds","isActive":true,"state":"findable","reason":null,"viewCount":0,"downloadCount":0,"referenceCount":0,"citationCount":0,"partCount":0,"partOfCount":0,"versionCount":0,"versionOfCount":0,"created":"2026-08-05T02:14:37Z","registered":"2026-08-05T02:14:38Z","published":null,"updated":"2026-08-05T02:14:38Z"},"relationships":{"client":{"data":{"id":"arxiv.content","type":"clients"}}}},{"id":"10.48550/arxiv.2608.03507","type":"dois","attributes":{"doi":"10.48550/arxiv.2608.03507","identifiers":[{"identifier":"2608.03507","identifierType":"arXiv"}],"creators":[{"nameType":"Personal","givenName":"Gagan","familyName":"Bhatia","name":"Bhatia, Gagan","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Julian","familyName":"Schlenker","name":"Schlenker, Julian","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Simone Paolo","familyName":"Ponzetto","name":"Ponzetto, Simone Paolo","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Steffen","familyName":"Eger","name":"Eger, Steffen","affiliation":[],"nameIdentifiers":[]}],"titles":[{"title":"ChronoLens: Measuring Language Change Across Time, Languages, and Linguistic Levels"}],"publisher":"arXiv","container":{},"publicationYear":2026,"subjects":[{"subject":"Computation and Language (cs.CL)","lang":"en","subjectScheme":"arXiv"},{"subject":"Artificial Intelligence (cs.AI)","lang":"en","subjectScheme":"arXiv"},{"subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"}],"contributors":[],"dates":[{"date":"2026-08-04T11:49:16Z","dateType":"Submitted","dateInformation":"v1"},{"date":"2026-08-05T00:48:14Z","dateType":"Updated","dateInformation":"v1"},{"date":"2026-08","dateType":"Available","dateInformation":"v1"}],"language":null,"types":{"schemaOrg":"CreativeWork","resourceTypeGeneral":"Preprint","citeproc":"article","bibtex":"misc","ris":"GEN","resourceType":"Article"},"relatedIdentifiers":[],"relatedItems":[],"sizes":[],"formats":[],"version":"1","rightsList":[{"rightsIdentifierScheme":"SPDX","rightsUri":"https://creativecommons.org/licenses/by-sa/4.0/legalcode","schemeUri":"https://spdx.org/licenses/","rights":"Creative Commons Attribution Share Alike 4.0 International","rightsIdentifier":"cc-by-sa-4.0"}],"descriptions":[{"descriptionType":"Abstract","description":"Historical language change affects morphology, syntax, semantics, and pragmatics, yet computational studies typically examine these levels with incompatible representations and therefore cannot determine whether they evolve together across languages. We address this problem by asking how the magnitude and direction of change vary across linguistic levels, languages, and historical periods within a single analytical space. We introduce ChronoLens, a framework that combines frozen multilingual language models, feature-aligned crosscoders, and post-hoc linguistic interventions, and apply it to 44.98 million documents and approximately 17.2 billion tokens from five parliamentary traditions spanning 1803--2026. The resulting sparse representations agree substantially more strongly with linguistic statistics than dense embeddings or a pooled sparse autoencoder ($ρ=0.72$ versus $0.29$ and $0.28$), and reveal that morphology, syntax, semantics, and pragmatics generally change by comparable amounts within a language, while languages differ markedly in when, how far, and in which direction they change. These findings show that historical language change is a structured, multidimensional process: similar magnitudes can conceal different trajectories, and meaningful cross-linguistic comparison requires measuring both distance and direction."}],"geoLocations":[],"fundingReferences":[],"url":"https://arxiv.org/abs/2608.03507","contentUrl":null,"metadataVersion":0,"schemaVersion":"http://datacite.org/schema/kernel-4","source":"mds","isActive":true,"state":"findable","reason":null,"viewCount":0,"downloadCount":0,"referenceCount":0,"citationCount":0,"partCount":0,"partOfCount":0,"versionCount":0,"versionOfCount":0,"created":"2026-08-05T02:14:33Z","registered":"2026-08-05T02:14:34Z","published":null,"updated":"2026-08-05T02:14:34Z"},"relationships":{"client":{"data":{"id":"arxiv.content","type":"clients"}}}},{"id":"10.48550/arxiv.2608.03506","type":"dois","attributes":{"doi":"10.48550/arxiv.2608.03506","identifiers":[{"identifier":"2608.03506","identifierType":"arXiv"}],"creators":[{"nameType":"Personal","givenName":"Omatharv Bharat","familyName":"Vaidya","name":"Vaidya, Omatharv Bharat","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Connor Thomas","familyName":"Jerzak","name":"Jerzak, Connor Thomas","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Zayne Rea","familyName":"Sprague","name":"Sprague, Zayne Rea","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Fangcong","familyName":"Yin","name":"Yin, Fangcong","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Nhat","familyName":"Ho","name":"Ho, Nhat","affiliation":[],"nameIdentifiers":[]}],"titles":[{"title":"When Many Answers Are Valid, Voting Fails: Symbolic Verification for Best-of-K Causal Reasoning in LLMs"}],"publisher":"arXiv","container":{},"publicationYear":2026,"subjects":[{"subject":"Artificial Intelligence (cs.AI)","lang":"en","subjectScheme":"arXiv"},{"subject":"Machine Learning (stat.ML)","lang":"en","subjectScheme":"arXiv"},{"subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"},{"subject":"I.2.3","lang":"en","subjectScheme":"ACM"},{"subject":"68T27","lang":"en","subjectScheme":"MSC"}],"contributors":[],"dates":[{"date":"2026-08-04T11:45:46Z","dateType":"Submitted","dateInformation":"v1"},{"date":"2026-08-05T00:48:12Z","dateType":"Updated","dateInformation":"v1"},{"date":"2026-08","dateType":"Available","dateInformation":"v1"}],"language":null,"types":{"schemaOrg":"CreativeWork","resourceTypeGeneral":"Preprint","citeproc":"article","bibtex":"misc","ris":"GEN","resourceType":"Article"},"relatedIdentifiers":[],"relatedItems":[],"sizes":[],"formats":[],"version":"1","rightsList":[{"rightsIdentifierScheme":"SPDX","rightsUri":"https://creativecommons.org/licenses/by/4.0/legalcode","schemeUri":"https://spdx.org/licenses/","rights":"Creative Commons Attribution 4.0 International","rightsIdentifier":"cc-by-4.0"}],"descriptions":[{"descriptionType":"Abstract","description":"Self-consistency assumes the most frequent answer among sampled reasoning traces is the most reliable, but this can fail in causal reasoning: samples often repeat the same confounding error, and votes fragment across multiple valid answers, letting an invalid answer win despite a valid minority trace. We introduce CALVER (Causal Axiom-Level VERification), a training-free symbolic verifier that scores structured traces against Pearl's causal criteria, including -separation, backdoor adjustment, and intervention, and selects the highest-scoring candidate without consulting a reference answer. On CLEAR find-one-valid queries that admit multiple graph-valid answers, CALVER reaches 42.1% where plurality, a reward model, an LLM judge, and model confidence remain near 30% on identical frozen pools. Scaling the judge to 72B does not close the gap. In an audited clean-core subset, 11 of 21 graph-valid CALVER selections differ from the benchmark's listed answer while still satisfying the requested predicate. The advantage widens with the sampling budget and reproduces across ten published Bayesian networks, a second model family, and settings where the model must build the graph from text. CALVER also improves thresholded average-treatment-effect decisions against exact ground truth, generalizes to logic under a truth-table checker, and scores each candidate in milliseconds on CPU. CALVER needs only a causal structure, supplied outright or built from the text; wherever that holds, selection can aggregate via causal validity."},{"descriptionType":"Other","description":"28 pages, 5 figures, 28 tables"}],"geoLocations":[],"fundingReferences":[],"url":"https://arxiv.org/abs/2608.03506","contentUrl":null,"metadataVersion":0,"schemaVersion":"http://datacite.org/schema/kernel-4","source":"mds","isActive":true,"state":"findable","reason":null,"viewCount":0,"downloadCount":0,"referenceCount":0,"citationCount":0,"partCount":0,"partOfCount":0,"versionCount":0,"versionOfCount":0,"created":"2026-08-05T02:14:32Z","registered":"2026-08-05T02:14:33Z","published":null,"updated":"2026-08-05T02:14:33Z"},"relationships":{"client":{"data":{"id":"arxiv.content","type":"clients"}}}},{"id":"10.48550/arxiv.2608.03504","type":"dois","attributes":{"doi":"10.48550/arxiv.2608.03504","identifiers":[{"identifier":"2608.03504","identifierType":"arXiv"}],"creators":[{"nameType":"Personal","givenName":"Henrik","familyName":"Petri","name":"Petri, Henrik","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Kai","familyName":"Wang","name":"Wang, Kai","affiliation":[],"nameIdentifiers":[]}],"titles":[{"title":"Stochastic Choice with Advertising"}],"publisher":"arXiv","container":{},"publicationYear":2026,"subjects":[{"subject":"General Economics (econ.GN)","lang":"en","subjectScheme":"arXiv"},{"subject":"FOS: Economics and business","subjectScheme":"Fields of Science and Technology (FOS)"}],"contributors":[],"dates":[{"date":"2026-08-04T11:44:40Z","dateType":"Submitted","dateInformation":"v1"},{"date":"2026-08-05T00:48:02Z","dateType":"Updated","dateInformation":"v1"},{"date":"2026-08","dateType":"Available","dateInformation":"v1"}],"language":null,"types":{"schemaOrg":"CreativeWork","resourceTypeGeneral":"Preprint","citeproc":"article","bibtex":"misc","ris":"GEN","resourceType":"Article"},"relatedIdentifiers":[],"relatedItems":[],"sizes":[],"formats":[],"version":"1","rightsList":[{"rightsUri":"http://arxiv.org/licenses/nonexclusive-distrib/1.0/","rights":"arXiv.org perpetual, non-exclusive license"}],"descriptions":[{"descriptionType":"Abstract","description":"We study how advertised products (e.g., Top Picks, Recommended, Featured) affect consumer choice on digital platforms and retail interfaces by extending the Luce (1959) (or multinomial logit) model. A consumer either focuses on the advertised items or considers the full menu, then chooses among the considered alternatives according to the Luce/logit rule. We characterize this model and show that its underlying primitives are uniquely identified from choice data. We also study a managerially important advertisement-design problem, in which a platform or retailer chooses the advertised subset to maximize expected profit, and we derive implementable design rules. We then introduce a richer framework in which advertising can influence both attention and preference. For this more general model, we provide a characterization and show how choice data can be used to separate the attention effect from the preference effect."}],"geoLocations":[],"fundingReferences":[],"url":"https://arxiv.org/abs/2608.03504","contentUrl":null,"metadataVersion":0,"schemaVersion":"http://datacite.org/schema/kernel-4","source":"mds","isActive":true,"state":"findable","reason":null,"viewCount":0,"downloadCount":0,"referenceCount":0,"citationCount":0,"partCount":0,"partOfCount":0,"versionCount":0,"versionOfCount":0,"created":"2026-08-05T02:14:29Z","registered":"2026-08-05T02:14:30Z","published":null,"updated":"2026-08-05T02:14:30Z"},"relationships":{"client":{"data":{"id":"arxiv.content","type":"clients"}}}},{"id":"10.48550/arxiv.2608.03501","type":"dois","attributes":{"doi":"10.48550/arxiv.2608.03501","identifiers":[{"identifier":"2608.03501","identifierType":"arXiv"}],"creators":[{"nameType":"Personal","givenName":"Zejun","familyName":"Liu","name":"Liu, Zejun","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Jian","familyName":"Wu","name":"Wu, Jian","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Ru","familyName":"Peng","name":"Peng, Ru","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Yuliang","familyName":"Ji","name":"Ji, Yuliang","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Dongyuan","familyName":"Li","name":"Li, Dongyuan","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Renhe","familyName":"Jiang","name":"Jiang, Renhe","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Yue","familyName":"Zhang","name":"Zhang, Yue","affiliation":[],"nameIdentifiers":[]}],"titles":[{"title":"Can LLM design high-quality experiments? A Comprehensive and Systematic Benchmark on Autonomous Experimental Design"}],"publisher":"arXiv","container":{},"publicationYear":2026,"subjects":[{"subject":"Artificial Intelligence (cs.AI)","lang":"en","subjectScheme":"arXiv"},{"subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"}],"contributors":[],"dates":[{"date":"2026-08-04T11:43:22Z","dateType":"Submitted","dateInformation":"v1"},{"date":"2026-08-05T00:47:54Z","dateType":"Updated","dateInformation":"v1"},{"date":"2026-08","dateType":"Available","dateInformation":"v1"}],"language":null,"types":{"schemaOrg":"CreativeWork","resourceTypeGeneral":"Preprint","citeproc":"article","bibtex":"misc","ris":"GEN","resourceType":"Article"},"relatedIdentifiers":[],"relatedItems":[],"sizes":[],"formats":[],"version":"1","rightsList":[{"rightsUri":"http://arxiv.org/licenses/nonexclusive-distrib/1.0/","rights":"arXiv.org perpetual, non-exclusive license"}],"descriptions":[{"descriptionType":"Abstract","description":"AI for Research (AI4Research) leverages AI to automate and improve scientific workflows. While experimental design is a critical stage of the research process, prior work has focused primarily on code implementation and execution, overlooking the importance of this stage, and no benchmark exists to evaluate AI's ability to conduct systematic experiment design. To bridge this gap, we propose SCOPE, a Scientific COmprehensive Planning Evaluation Benchmark constructed from 300 high-quality latest papers across 19 research domains from top-tier venues (e.g., ICML, NeurIPS, and ICLR),evaluating LLMs on two dimensions: High-Level planning completeness (main, ablation, and analysis experiments) and Low-Level configuration accuracy and rationality (datasets, baselines, and metrics). Benchmarking reveals three findings: (1) most LLMs cannot directly design high-quality experiments; (2) all LLMs exhibit a performance bottleneck in low-level configuration; and (3) search mode does not improve design quality. Furthermore, to address these challenges, we propose OptED, a novel agentic workflow to optimize LLM-based experimental design, that enhances LLM-based experimental planning through stage isolation, tool augmentation, and rule-based constraints, effectively alleviating the configuration bottleneck."},{"descriptionType":"Other","description":"32 pages, 7 figures"}],"geoLocations":[],"fundingReferences":[],"url":"https://arxiv.org/abs/2608.03501","contentUrl":null,"metadataVersion":0,"schemaVersion":"http://datacite.org/schema/kernel-4","source":"mds","isActive":true,"state":"findable","reason":null,"viewCount":0,"downloadCount":0,"referenceCount":0,"citationCount":0,"partCount":0,"partOfCount":0,"versionCount":0,"versionOfCount":0,"created":"2026-08-05T02:14:25Z","registered":"2026-08-05T02:14:26Z","published":null,"updated":"2026-08-05T02:14:26Z"},"relationships":{"client":{"data":{"id":"arxiv.content","type":"clients"}}}},{"id":"10.48550/arxiv.2608.03500","type":"dois","attributes":{"doi":"10.48550/arxiv.2608.03500","identifiers":[{"identifier":"2608.03500","identifierType":"arXiv"}],"creators":[{"nameType":"Personal","givenName":"Martin","familyName":"Möller","name":"Möller, Martin","affiliation":[],"nameIdentifiers":[]}],"titles":[{"title":"LLM-Assisted Review Prioritization for German Statutory Health Insurance Websites: A Multi-Stage Corpus Audit"}],"publisher":"arXiv","container":{},"publicationYear":2026,"subjects":[{"subject":"Computers and Society (cs.CY)","lang":"en","subjectScheme":"arXiv"},{"subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"},{"subject":"J.3; H.3.5; I.2.7","lang":"en","subjectScheme":"ACM"}],"contributors":[],"dates":[{"date":"2026-08-04T11:42:31Z","dateType":"Submitted","dateInformation":"v1"},{"date":"2026-08-05T00:47:53Z","dateType":"Updated","dateInformation":"v1"},{"date":"2026-08","dateType":"Available","dateInformation":"v1"}],"language":null,"types":{"schemaOrg":"CreativeWork","resourceTypeGeneral":"Preprint","citeproc":"article","bibtex":"misc","ris":"GEN","resourceType":"Article"},"relatedIdentifiers":[],"relatedItems":[],"sizes":[],"formats":[],"version":"1","rightsList":[{"rightsUri":"http://arxiv.org/licenses/nonexclusive-distrib/1.0/","rights":"arXiv.org perpetual, non-exclusive license"}],"descriptions":[{"descriptionType":"Abstract","description":"Background: German statutory health insurance (SHI) funds publish web portfolios that exceed continuous specialist review capacity. Their content can shape health and benefit expectations. Generic AI-text detection does not identify medical, benefit, legal, or editorial review needs. Objective: To characterize a multi-stage workflow that prioritizes substantive review needs while separating AI-provenance signals from quality claims. Methods: We analyzed 56,198 pages from 84 SHI websites or sub-sites. The workflow combined deterministic screening, model-assisted triage and in-depth review, minimum evidence checks, temporal-validity safeguards, and paired-model comparison. It is reproducibility-bounded, not a validated detector. Production code is proprietary; reproducibility rests on frozen derived tables and paired-comparison artifacts. The 300-page lower-priority check was a single-model, risk-enriched routing stress test, not a human-reference evaluation. Results: All pages received a review state. The workflow generated 35,998 review records and routed 21,452 to case review. The workload concentrated in transparency, legal framing, medical content, contradictions, and AI-related failure-mode signals. A quoted passage was locatable in captured page text for 31,347 records, confirming literal occurrence rather than factual correctness. The routing stress test surfaced a signal on 100/300 pages (33.3% within the sample). Across 182 matched cases, two models agreed in 75.8% (kappa = 0.532; 95% CI 0.415-0.649). Conclusions: The workflow produces a prioritized workload, not error prevalence or final legal, medical, or insurer-level findings. It neither proves AI authorship nor validates autonomous detection. Paired-model agreement quantifies consistency, not correctness or sufficient triage performance; public claims require human adjudication."},{"descriptionType":"Other","description":"31 pages, 5 figures. Also archived at Zenodo: https://doi.org/10.5281/zenodo.21738595"}],"geoLocations":[],"fundingReferences":[],"url":"https://arxiv.org/abs/2608.03500","contentUrl":null,"metadataVersion":0,"schemaVersion":"http://datacite.org/schema/kernel-4","source":"mds","isActive":true,"state":"findable","reason":null,"viewCount":0,"downloadCount":0,"referenceCount":0,"citationCount":0,"partCount":0,"partOfCount":0,"versionCount":0,"versionOfCount":0,"created":"2026-08-05T02:14:24Z","registered":null,"published":null,"updated":"2026-08-05T02:14:24Z"},"relationships":{"client":{"data":{"id":"arxiv.content","type":"clients"}}}},{"id":"10.48550/arxiv.2608.03499","type":"dois","attributes":{"doi":"10.48550/arxiv.2608.03499","identifiers":[{"identifier":"2608.03499","identifierType":"arXiv"}],"creators":[{"nameType":"Personal","givenName":"Prince Zizhuang","familyName":"Wang","name":"Wang, Prince Zizhuang","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Aojie","familyName":"Yuan","name":"Yuan, Aojie","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Haiyue","familyName":"Zhang","name":"Zhang, Haiyue","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Xiyang","familyName":"Hu","name":"Hu, Xiyang","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Yue","familyName":"Zhao","name":"Zhao, Yue","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Shuli","familyName":"Jiang","name":"Jiang, Shuli","affiliation":[],"nameIdentifiers":[]}],"titles":[{"title":"WeClawArena: An Auditable Sandbox and Benchmark for Cross-User Agents Collaboration and Security in Human-Centered Agent Networks"}],"publisher":"arXiv","container":{},"publicationYear":2026,"subjects":[{"subject":"Artificial Intelligence (cs.AI)","lang":"en","subjectScheme":"arXiv"},{"subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"}],"contributors":[],"dates":[{"date":"2026-08-04T11:42:26Z","dateType":"Submitted","dateInformation":"v1"},{"date":"2026-08-05T00:47:51Z","dateType":"Updated","dateInformation":"v1"},{"date":"2026-08","dateType":"Available","dateInformation":"v1"}],"language":null,"types":{"schemaOrg":"CreativeWork","resourceTypeGeneral":"Preprint","citeproc":"article","bibtex":"misc","ris":"GEN","resourceType":"Article"},"relatedIdentifiers":[],"relatedItems":[],"sizes":[],"formats":[],"version":"1","rightsList":[{"rightsIdentifierScheme":"SPDX","rightsUri":"https://creativecommons.org/licenses/by/4.0/legalcode","schemeUri":"https://spdx.org/licenses/","rights":"Creative Commons Attribution 4.0 International","rightsIdentifier":"cc-by-4.0"}],"descriptions":[{"descriptionType":"Abstract","description":"Recent advances in persistent personal-agent frameworks are making human-centered agent networks realistic deployment targets: each user can be served by an AI agent that acts on the user's behalf, maintains state, and communicates with other agents through social and task relations. In these networks, everyday tool use becomes multi-party owned-agent collaboration over personal workspaces, where files, records, tools, and policies are not directly visible across owners. Existing agent benchmarks study tool use and collaboration, but they do not provide an end-to-end sandbox for verifiable cross-user agent collaboration with realistic user digital workspaces or test how harmful actions can travel through the human-centered agent network. We introduce WeClawArena, an auditable benchmark and runtime sandbox for multi-party owned-agent collaboration over personal workspaces. WeClawArena targets collaborative tool-use tasks in which personal workspaces serve as both operational tools and personal constraints. The benchmark contains 124 base tasks across six cross-user task domains and expands them into 620 scenario variants, with one benign control and four attack-vector variants per base task. The sandbox records peer messages, tool calls, resource operations, governed decisions, and final workspace states. WeClawArena reports utility and attack success rate separately and audits attack success from bounded runtime evidence, supporting diagnosis of task breakdown, privacy leakage, poisoned evidence, and invalid authority paths."},{"descriptionType":"Other","description":"31 pages"}],"geoLocations":[],"fundingReferences":[],"url":"https://arxiv.org/abs/2608.03499","contentUrl":null,"metadataVersion":0,"schemaVersion":"http://datacite.org/schema/kernel-4","source":"mds","isActive":true,"state":"findable","reason":null,"viewCount":0,"downloadCount":0,"referenceCount":0,"citationCount":0,"partCount":0,"partOfCount":0,"versionCount":0,"versionOfCount":0,"created":"2026-08-05T02:14:22Z","registered":"2026-08-05T02:14:23Z","published":null,"updated":"2026-08-05T02:14:23Z"},"relationships":{"client":{"data":{"id":"arxiv.content","type":"clients"}}}},{"id":"10.48550/arxiv.2608.03498","type":"dois","attributes":{"doi":"10.48550/arxiv.2608.03498","identifiers":[{"identifier":"2608.03498","identifierType":"arXiv"}],"creators":[{"nameType":"Personal","givenName":"Rojalini","familyName":"Tripathy","name":"Tripathy, Rojalini","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Padmalochan","familyName":"Bera","name":"Bera, Padmalochan","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Shreya","familyName":"Ghosh","name":"Ghosh, Shreya","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Rajkumar","familyName":"Buyya","name":"Buyya, Rajkumar","affiliation":[],"nameIdentifiers":[]}],"titles":[{"title":"FedCARE: A Multi-Objective Personalised Federated Learning Framework for Smart Healthcare"}],"publisher":"arXiv","container":{},"publicationYear":2026,"subjects":[{"subject":"Machine Learning (cs.LG)","lang":"en","subjectScheme":"arXiv"},{"subject":"Distributed, Parallel, and Cluster Computing (cs.DC)","lang":"en","subjectScheme":"arXiv"},{"subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"}],"contributors":[],"dates":[{"date":"2026-08-04T11:37:03Z","dateType":"Submitted","dateInformation":"v1"},{"date":"2026-08-05T00:47:40Z","dateType":"Updated","dateInformation":"v1"},{"date":"2026-08","dateType":"Available","dateInformation":"v1"}],"language":null,"types":{"schemaOrg":"CreativeWork","resourceTypeGeneral":"Preprint","citeproc":"article","bibtex":"misc","ris":"GEN","resourceType":"Article"},"relatedIdentifiers":[],"relatedItems":[],"sizes":[],"formats":[],"version":"1","rightsList":[{"rightsUri":"http://arxiv.org/licenses/nonexclusive-distrib/1.0/","rights":"arXiv.org perpetual, non-exclusive license"}],"descriptions":[{"descriptionType":"Abstract","description":"Federated Learning (FL) enables collaborative model training across distributed healthcare institutions without centralising sensitive patient data. However, real-world healthcare federations are often characterised not only by non-IID data, but also by heterogeneous clinical objectives and partially overlapping feature spaces. Different hospitals may optimise distinct and potentially conflicting objectives, such as mortality risk prediction, readmission reduction, or length-of-stay estimation, while also retaining institution-specific clinical features that cannot be shared with other participants. Existing personalised FL methods mainly address statistical heterogeneity, whereas multi-objective FL approaches typically learn a shared global model without explicit client-level adaptation. To address these limitations, we propose \\textbf{FedCARE}, a multi-objective personalised FL framework for smart healthcare services. FedCARE follows a two-stage training strategy. First, it learns a shared global backbone from common clinical features using Pareto-driven multi-objective federated optimisation. Second, each client independently fine-tunes the shared backbone using its private features and local clinical objectives, enabling institution-specific personalisation without additional communication overhead. We implement FedCARE in a cloud-based client-server federated deployment on the Melbourne Research Cloud and evaluate it on two real-world healthcare datasets, MIMIC-III and Diabetes 130-US Hospitals. Experimental results show that FedCARE consistently outperforms standard FL, multi-objective FL, and personalised FL baselines, achieving up to 12.5% AUROC improvement and 32.0% MAE reduction over FedAvg."}],"geoLocations":[],"fundingReferences":[],"url":"https://arxiv.org/abs/2608.03498","contentUrl":null,"metadataVersion":0,"schemaVersion":"http://datacite.org/schema/kernel-4","source":"mds","isActive":true,"state":"findable","reason":null,"viewCount":0,"downloadCount":0,"referenceCount":0,"citationCount":0,"partCount":0,"partOfCount":0,"versionCount":0,"versionOfCount":0,"created":"2026-08-05T02:14:21Z","registered":"2026-08-05T02:14:22Z","published":null,"updated":"2026-08-05T02:14:22Z"},"relationships":{"client":{"data":{"id":"arxiv.content","type":"clients"}}}},{"id":"10.48550/arxiv.2608.03496","type":"dois","attributes":{"doi":"10.48550/arxiv.2608.03496","identifiers":[{"identifier":"2608.03496","identifierType":"arXiv"}],"creators":[{"nameType":"Personal","givenName":"Daniele","familyName":"Gammelli","name":"Gammelli, Daniele","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Joseph","familyName":"Lorenzetti","name":"Lorenzetti, Joseph","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Katie","familyName":"Luo","name":"Luo, Katie","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Gioele","familyName":"Zardini","name":"Zardini, Gioele","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Marco","familyName":"Pavone","name":"Pavone, Marco","affiliation":[],"nameIdentifiers":[]}],"titles":[{"title":"Principles of Robot Autonomy"}],"publisher":"arXiv","container":{},"publicationYear":2026,"subjects":[{"subject":"Robotics (cs.RO)","lang":"en","subjectScheme":"arXiv"},{"subject":"Artificial Intelligence (cs.AI)","lang":"en","subjectScheme":"arXiv"},{"subject":"Computer Vision and Pattern Recognition (cs.CV)","lang":"en","subjectScheme":"arXiv"},{"subject":"Systems and Control (eess.SY)","lang":"en","subjectScheme":"arXiv"},{"subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"},{"subject":"FOS: Electrical engineering, electronic engineering, information engineering","subjectScheme":"Fields of Science and Technology (FOS)"}],"contributors":[],"dates":[{"date":"2026-08-04T11:35:20Z","dateType":"Submitted","dateInformation":"v1"},{"date":"2026-08-05T00:47:36Z","dateType":"Updated","dateInformation":"v1"},{"date":"2026-08","dateType":"Available","dateInformation":"v1"}],"language":null,"types":{"schemaOrg":"CreativeWork","resourceTypeGeneral":"Preprint","citeproc":"article","bibtex":"misc","ris":"GEN","resourceType":"Article"},"relatedIdentifiers":[],"relatedItems":[],"sizes":[],"formats":[],"version":"1","rightsList":[{"rightsUri":"http://arxiv.org/licenses/nonexclusive-distrib/1.0/","rights":"arXiv.org perpetual, non-exclusive license"}],"descriptions":[{"descriptionType":"Abstract","description":"Autonomous robots are moving rapidly from research labs into everyday life - on roads, in the air, in warehouses, and in space. Robot autonomy is no longer solely an academic pursuit, but a collection of mature, field-tested methods and tools that practitioners rely on in real-world deployments. This book offers a clear, unified introduction to the methods that make this possible. Built on decades of teaching at Stanford, the text develops the core elements of modern autonomy stacks within a single conceptual framework, bridging classical robotics and modern physical AI. Every major topic is paired with hands-on Jupyter notebooks and implementation-driven exercises, so readers build practical intuition alongside theoretical understanding. The result is a principled, accessible, and deployment-aware foundation for anyone seeking to design, analyze, or contribute to the next generation of autonomous systems. This is a comprehensive resource for students, engineers, and researchers entering one of today's fastest-growing fields."},{"descriptionType":"Other","description":"531 pages. Pre-publication version of a book forthcoming from Cambridge University Press, posted with the permission of the publisher"}],"geoLocations":[],"fundingReferences":[],"url":"https://arxiv.org/abs/2608.03496","contentUrl":null,"metadataVersion":0,"schemaVersion":"http://datacite.org/schema/kernel-4","source":"mds","isActive":true,"state":"findable","reason":null,"viewCount":0,"downloadCount":0,"referenceCount":0,"citationCount":0,"partCount":0,"partOfCount":0,"versionCount":0,"versionOfCount":0,"created":"2026-08-05T02:14:18Z","registered":"2026-08-05T02:14:19Z","published":null,"updated":"2026-08-05T02:14:19Z"},"relationships":{"client":{"data":{"id":"arxiv.content","type":"clients"}}}},{"id":"10.48550/arxiv.2608.03495","type":"dois","attributes":{"doi":"10.48550/arxiv.2608.03495","identifiers":[{"identifier":"2608.03495","identifierType":"arXiv"}],"creators":[{"nameType":"Personal","givenName":"Zalán","familyName":"Sándor","name":"Sándor, Zalán","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Róbert","familyName":"Kovács","name":"Kovács, Róbert","affiliation":[],"nameIdentifiers":[]}],"titles":[{"title":"Thermodynamically consistent initialization of the Maxwell--Cattaneo---Vernotte heat conduction model: Analytical solutions and engineering applications"}],"publisher":"arXiv","container":{},"publicationYear":2026,"subjects":[{"subject":"Applied Physics (physics.app-ph)","lang":"en","subjectScheme":"arXiv"},{"subject":"Statistical Mechanics (cond-mat.stat-mech)","lang":"en","subjectScheme":"arXiv"},{"subject":"FOS: Physical sciences","subjectScheme":"Fields of Science and Technology (FOS)"}],"contributors":[],"dates":[{"date":"2026-08-04T11:34:01Z","dateType":"Submitted","dateInformation":"v1"},{"date":"2026-08-05T00:47:33Z","dateType":"Updated","dateInformation":"v1"},{"date":"2026-08","dateType":"Available","dateInformation":"v1"}],"language":null,"types":{"schemaOrg":"CreativeWork","resourceTypeGeneral":"Preprint","citeproc":"article","bibtex":"misc","ris":"GEN","resourceType":"Article"},"relatedIdentifiers":[],"relatedItems":[],"sizes":[],"formats":[],"version":"1","rightsList":[{"rightsIdentifierScheme":"SPDX","rightsUri":"https://creativecommons.org/licenses/by/4.0/legalcode","schemeUri":"https://spdx.org/licenses/","rights":"Creative Commons Attribution 4.0 International","rightsIdentifier":"cc-by-4.0"}],"descriptions":[{"descriptionType":"Abstract","description":"This paper investigates the numerical initialization of the one-dimensional Maxwell--Cattaneo--Vernotte (MCV) heat conduction model, addressing the critical mathematical challenge of defining the initial time derivative for non-equilibrium states. In modern high-frequency thermal engineering applications, traditional time-integration schemes and commercial finite-element solvers frequently introduce severe numerical artifacts when handling non-Fourier models. This study systematically evaluates three initialization strategies: a zero derivative, a spatially uniform non-zero derivative, and an exact space-dependent derivative. Using an explicit staggered finite-difference scheme, the transient responses to an exponentially distributed initial temperature field under adiabatic boundary conditions are compared against an analytical solution using the Galerkin method. The results demonstrate that assuming a zero or spatially uniform initial derivative introduces significant unphysical oscillatory deviations, leading to heat-flux prediction errors as the relaxation time increases. Conversely, mapping the exact space-dependent derivative onto the staggered grid preserves the local thermodynamic structure of the initial state, yielding robust transient responses that match the analytical benchmark without meaningful computational overhead. These findings establish a thermodynamically consistent initialization technique that can be extended to non-local models as well."}],"geoLocations":[],"fundingReferences":[],"url":"https://arxiv.org/abs/2608.03495","contentUrl":null,"metadataVersion":0,"schemaVersion":"http://datacite.org/schema/kernel-4","source":"mds","isActive":true,"state":"findable","reason":null,"viewCount":0,"downloadCount":0,"referenceCount":0,"citationCount":0,"partCount":0,"partOfCount":0,"versionCount":0,"versionOfCount":0,"created":"2026-08-05T02:14:17Z","registered":"2026-08-05T02:14:17Z","published":null,"updated":"2026-08-05T02:14:17Z"},"relationships":{"client":{"data":{"id":"arxiv.content","type":"clients"}}}},{"id":"10.48550/arxiv.2608.03493","type":"dois","attributes":{"doi":"10.48550/arxiv.2608.03493","identifiers":[{"identifier":"2608.03493","identifierType":"arXiv"}],"creators":[{"nameType":"Personal","givenName":"Johannes","familyName":"Testorf","name":"Testorf, Johannes","affiliation":[],"nameIdentifiers":[]}],"titles":[{"title":"Explicit Estimates for the Bergman Kernel Form on Polarized Riemann Surfaces for General Tensor Powers"}],"publisher":"arXiv","container":{},"publicationYear":2026,"subjects":[{"subject":"Complex Variables (math.CV)","lang":"en","subjectScheme":"arXiv"},{"subject":"Differential Geometry (math.DG)","lang":"en","subjectScheme":"arXiv"},{"subject":"FOS: Mathematics","subjectScheme":"Fields of Science and Technology (FOS)"},{"subject":"30F99, 30C40","lang":"en","subjectScheme":"MSC"}],"contributors":[],"dates":[{"date":"2026-08-04T11:32:08Z","dateType":"Submitted","dateInformation":"v1"},{"date":"2026-08-05T00:47:31Z","dateType":"Updated","dateInformation":"v1"},{"date":"2026-08","dateType":"Available","dateInformation":"v1"}],"language":null,"types":{"schemaOrg":"CreativeWork","resourceTypeGeneral":"Preprint","citeproc":"article","bibtex":"misc","ris":"GEN","resourceType":"Article"},"relatedIdentifiers":[],"relatedItems":[],"sizes":[],"formats":[],"version":"1","rightsList":[{"rightsUri":"http://arxiv.org/licenses/nonexclusive-distrib/1.0/","rights":"arXiv.org perpetual, non-exclusive license"}],"descriptions":[{"descriptionType":"Abstract","description":"Let $(L,e^{-ϕ})$ be a positive Hermitian holomorphic line bundle over a compact Riemann surface $X$, and put $ω=\\ddbarϕ$. We obtain effective pointwise estimates for the Bergman form of $H^0(X,K_X\\otimes L^m)$. If $\\Ricω\\leqω$ and the shortest nonconstant closed geodesic has length at least $2π$, then \\[\n K_{mϕ}\\geq \\frac{2m-1}{4π}\\,ω, \\] and the constant is sharp on $(\\mathbb P^1,\\mathcal O_{\\mathbb P^1}(2))$. A local version, depending on an upper curvature bound and the injectivity radius, recovers the first two terms of the Bergman expansion when the curvature is constant. Under the two-sided bound $-ω\\leq\\Ricω\\leqω$ and the same closed-geodesic hypothesis, we also prove \\[ K_{mϕ}\\leq \\frac{mω}{2π}\n \\left(1+\\frac{54.8\\log(2m)}{m-\\frac{1}2}\\right). \\] The lower estimates use the deformation-to-the-tangent-space form of the Ohsawa--Takegoshi theorem established by He, Wang, and the author, whereas the upper bound combines a weighted submean inequality with quantitative isothermal coordinates which was obtained in recent work by Eilat."},{"descriptionType":"Other","description":"11 Pages. Comments Welcome"}],"geoLocations":[],"fundingReferences":[],"url":"https://arxiv.org/abs/2608.03493","contentUrl":null,"metadataVersion":0,"schemaVersion":"http://datacite.org/schema/kernel-4","source":"mds","isActive":true,"state":"findable","reason":null,"viewCount":0,"downloadCount":0,"referenceCount":0,"citationCount":0,"partCount":0,"partOfCount":0,"versionCount":0,"versionOfCount":0,"created":"2026-08-05T02:14:14Z","registered":null,"published":null,"updated":"2026-08-05T02:14:14Z"},"relationships":{"client":{"data":{"id":"arxiv.content","type":"clients"}}}},{"id":"10.48550/arxiv.2608.03492","type":"dois","attributes":{"doi":"10.48550/arxiv.2608.03492","identifiers":[{"identifier":"2608.03492","identifierType":"arXiv"}],"creators":[{"nameType":"Personal","givenName":"Dezhao","familyName":"Wu","name":"Wu, Dezhao","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Yong","familyName":"Xu","name":"Xu, Yong","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Meng","familyName":"Ye","name":"Ye, Meng","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Wenhui","familyName":"Duan","name":"Duan, Wenhui","affiliation":[],"nameIdentifiers":[]}],"titles":[{"title":"Spin-Chirality-Driven Bulk Photovoltaic Effect in van der Waals Magnet CrSBr"}],"publisher":"arXiv","container":{},"publicationYear":2026,"subjects":[{"subject":"Materials Science (cond-mat.mtrl-sci)","lang":"en","subjectScheme":"arXiv"},{"subject":"FOS: Physical sciences","subjectScheme":"Fields of Science and Technology (FOS)"}],"contributors":[],"dates":[{"date":"2026-08-04T11:27:23Z","dateType":"Submitted","dateInformation":"v1"},{"date":"2026-08-05T00:47:20Z","dateType":"Updated","dateInformation":"v1"},{"date":"2026-08","dateType":"Available","dateInformation":"v1"}],"language":null,"types":{"schemaOrg":"CreativeWork","resourceTypeGeneral":"Preprint","citeproc":"article","bibtex":"misc","ris":"GEN","resourceType":"Article"},"relatedIdentifiers":[],"relatedItems":[],"sizes":[],"formats":[],"version":"1","rightsList":[{"rightsUri":"http://arxiv.org/licenses/nonexclusive-distrib/1.0/","rights":"arXiv.org perpetual, non-exclusive license"}],"descriptions":[{"descriptionType":"Abstract","description":"The bulk photovoltaic effect (BPVE) can be greatly enriched in magnetic materials. Here, we establish vector spin chirality as a tunable knob for generating an unconventional time-reversal-even magnetic BPVE, comprising the chiral shift current (CSC) and chiral injection current (CIC). Using bilayer antiferromagnetic (AFM) CrSBr as a prototype, we theoretically demonstrate the emergence of CSC and CIC. Compared with conventional photovoltaic currents arising from noncentrosymmetric crystal structures or collinear magnetic orderings, CSC and CIC not only possess comparable magnitudes but also exhibit exceptional tunability. Specifically, they can be switched on and off by magnetic-field-induced spin canting, reversed in direction upon canting-direction reversal, and continuously modulated in intensity via canting-angle variation. Furthermore, we reveal an unusual optical transition channel governing both currents in CrSBr. Our work establishes an unconventional magnetic BPVE with remarkable controllability, paving the way for applications in optoelectronics and magnetic sensing in noncollinear magnets."},{"descriptionType":"Other","description":"10 pages, 5 figures"}],"geoLocations":[],"fundingReferences":[],"url":"https://arxiv.org/abs/2608.03492","contentUrl":null,"metadataVersion":0,"schemaVersion":"http://datacite.org/schema/kernel-4","source":"mds","isActive":true,"state":"findable","reason":null,"viewCount":0,"downloadCount":0,"referenceCount":0,"citationCount":0,"partCount":0,"partOfCount":0,"versionCount":0,"versionOfCount":0,"created":"2026-08-05T02:14:13Z","registered":"2026-08-05T02:14:13Z","published":null,"updated":"2026-08-05T02:14:13Z"},"relationships":{"client":{"data":{"id":"arxiv.content","type":"clients"}}}},{"id":"10.48550/arxiv.2608.03490","type":"dois","attributes":{"doi":"10.48550/arxiv.2608.03490","identifiers":[{"identifier":"2608.03490","identifierType":"arXiv"}],"creators":[{"nameType":"Personal","givenName":"Quoc Cuong","familyName":"Ninh","name":"Ninh, Quoc Cuong","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Huy Xuan","familyName":"Pham","name":"Pham, Huy Xuan","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Anh Tung","familyName":"Nguyen","name":"Nguyen, Anh Tung","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Dinh Hoan","familyName":"Trinh","name":"Trinh, Dinh Hoan","affiliation":[],"nameIdentifiers":[]}],"titles":[{"title":"Lightweight 3D Object Detection via Mamba-Based Knowledge Distillation"}],"publisher":"arXiv","container":{},"publicationYear":2026,"subjects":[{"subject":"Robotics (cs.RO)","lang":"en","subjectScheme":"arXiv"},{"subject":"Computer Vision and Pattern Recognition (cs.CV)","lang":"en","subjectScheme":"arXiv"},{"subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"}],"contributors":[],"dates":[{"date":"2026-08-04T11:26:23Z","dateType":"Submitted","dateInformation":"v1"},{"date":"2026-08-05T00:47:18Z","dateType":"Updated","dateInformation":"v1"},{"date":"2026-08","dateType":"Available","dateInformation":"v1"}],"language":null,"types":{"schemaOrg":"CreativeWork","resourceTypeGeneral":"Preprint","citeproc":"article","bibtex":"misc","ris":"GEN","resourceType":"Article"},"relatedIdentifiers":[{"relationType":"IsVersionOf","relatedIdentifier":"10.1109/lra.2026.3719203","relatedIdentifierType":"DOI"}],"relatedItems":[],"sizes":[],"formats":[],"version":"1","rightsList":[{"rightsUri":"http://arxiv.org/licenses/nonexclusive-distrib/1.0/","rights":"arXiv.org perpetual, non-exclusive license"}],"descriptions":[{"descriptionType":"Abstract","description":"3D object detection using light detection and ranging (LiDAR) sensors requires a balance between accuracy and computational efficiency for onboard perception in autonomous driving and robotic navigation. Many existing LiDAR-based detection methods employ complex architectures to extract features, integrating large amounts of contextual information to enhance accuracy. This often results in significant computational costs, leading to suboptimal performance on resource-constrained embedded devices. In this study, we propose a knowledge distillation framework that transfers object-level voxel representations from a strong teacher model to lightweight student models through selective voxel-space feature alignment. Taking advantage of the linear-time sequence model with selective state spaces (Mamba), we design a multi-branch Mamba teacher backbone and a box-aware feature transfer mechanism that aligns spatially corresponding voxel features between teacher and student networks through a Mamba-based projection module. Experimental results on both a public dataset and real-world data show that our approach significantly reduces computational load while maintaining competitive accuracy compared with state-of-the-art methods."},{"descriptionType":"Other","description":"Accepted for publication in IEEE Robotics and Automation Letters (RA-L), 2026"}],"geoLocations":[],"fundingReferences":[],"url":"https://arxiv.org/abs/2608.03490","contentUrl":null,"metadataVersion":0,"schemaVersion":"http://datacite.org/schema/kernel-4","source":"mds","isActive":true,"state":"findable","reason":null,"viewCount":0,"downloadCount":0,"referenceCount":0,"citationCount":0,"partCount":0,"partOfCount":0,"versionCount":0,"versionOfCount":1,"created":"2026-08-05T02:14:10Z","registered":"2026-08-05T02:14:10Z","published":null,"updated":"2026-08-05T02:14:10Z"},"relationships":{"client":{"data":{"id":"arxiv.content","type":"clients"}}}},{"id":"10.48550/arxiv.2608.03489","type":"dois","attributes":{"doi":"10.48550/arxiv.2608.03489","identifiers":[{"identifier":"2608.03489","identifierType":"arXiv"}],"creators":[{"nameType":"Personal","givenName":"Simos","familyName":"Gerasimou","name":"Gerasimou, Simos","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Xingyu","familyName":"Zhao","name":"Zhao, Xingyu","affiliation":[],"nameIdentifiers":[]}],"titles":[{"title":"Leveraging System-Level Observations to Inform Bayesian Learning of Model Parameters for Quantitative Verification"}],"publisher":"arXiv","container":{},"publicationYear":2026,"subjects":[{"subject":"Software Engineering (cs.SE)","lang":"en","subjectScheme":"arXiv"},{"subject":"Artificial Intelligence (cs.AI)","lang":"en","subjectScheme":"arXiv"},{"subject":"Logic in Computer Science (cs.LO)","lang":"en","subjectScheme":"arXiv"},{"subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"}],"contributors":[],"dates":[{"date":"2026-08-04T11:25:44Z","dateType":"Submitted","dateInformation":"v1"},{"date":"2026-08-05T00:47:17Z","dateType":"Updated","dateInformation":"v1"},{"date":"2026-08","dateType":"Available","dateInformation":"v1"}],"language":null,"types":{"schemaOrg":"CreativeWork","resourceTypeGeneral":"Preprint","citeproc":"article","bibtex":"misc","ris":"GEN","resourceType":"Article"},"relatedIdentifiers":[],"relatedItems":[],"sizes":[],"formats":[],"version":"1","rightsList":[{"rightsIdentifierScheme":"SPDX","rightsUri":"https://creativecommons.org/licenses/by/4.0/legalcode","schemeUri":"https://spdx.org/licenses/","rights":"Creative Commons Attribution 4.0 International","rightsIdentifier":"cc-by-4.0"}],"descriptions":[{"descriptionType":"Abstract","description":"Combining Bayesian learning and quantitative verification is a powerful toolset for analysing key quantitative properties of software systems, like reliability and response time. However, the accuracy and robustness of verification results strongly depend on the prior knowledge (PK) underlying Bayesian inference. This knowledge reflects original beliefs about the probability of events and typically depends on domain expertise. Using inaccurate or uninformative PK can negatively affect quantitative analysis, yielding incorrect verification results. Our EPIK approach tackles this important challenge by eliciting and embedding PK in quantitative verification equipped with Bayesian estimators. Unlike existing approaches that require PK on formal model transition parameters, EPIK leverages system-level properties that are directly observable and are linked to real-world semantics. EPIK formulates a twofold optimisation problem to derive the distributions of unknown transition parameters and then embeds these distributions to verify new or difficult-to-measure (elusive) properties. The detailed experimental evaluation using multiple variants of real-world case studies and diverse EPIK instantiations shows its effectiveness, flexibility and generality."},{"descriptionType":"Other","description":"11 pages, 9 figures"}],"geoLocations":[],"fundingReferences":[],"url":"https://arxiv.org/abs/2608.03489","contentUrl":null,"metadataVersion":0,"schemaVersion":"http://datacite.org/schema/kernel-4","source":"mds","isActive":true,"state":"findable","reason":null,"viewCount":0,"downloadCount":0,"referenceCount":0,"citationCount":0,"partCount":0,"partOfCount":0,"versionCount":0,"versionOfCount":0,"created":"2026-08-05T02:14:08Z","registered":"2026-08-05T02:14:09Z","published":null,"updated":"2026-08-05T02:14:09Z"},"relationships":{"client":{"data":{"id":"arxiv.content","type":"clients"}}}},{"id":"10.48550/arxiv.2608.03485","type":"dois","attributes":{"doi":"10.48550/arxiv.2608.03485","identifiers":[{"identifier":"2608.03485","identifierType":"arXiv"}],"creators":[{"nameType":"Personal","givenName":"Nizhang","familyName":"Li","name":"Li, Nizhang","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Zonghao","familyName":"Ying","name":"Ying, Zonghao","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Xiangfan","familyName":"Wu","name":"Wu, Xiangfan","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Zonglei","familyName":"Jing","name":"Jing, Zonglei","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Xixun","familyName":"Lin","name":"Lin, Xixun","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Hao","familyName":"Zhang","name":"Zhang, Hao","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Wenxin","familyName":"Zhang","name":"Zhang, Wenxin","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Jiaye","familyName":"Lin","name":"Lin, Jiaye","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Quanchen","familyName":"Zou","name":"Zou, Quanchen","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Xiangzheng","familyName":"Zhang","name":"Zhang, Xiangzheng","affiliation":[],"nameIdentifiers":[]}],"titles":[{"title":"SkillSentry: Adaptive Honey Worlds for Dynamic Safety Testing of Agent Skills"}],"publisher":"arXiv","container":{},"publicationYear":2026,"subjects":[{"subject":"Cryptography and Security (cs.CR)","lang":"en","subjectScheme":"arXiv"},{"subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"}],"contributors":[],"dates":[{"date":"2026-08-04T11:22:22Z","dateType":"Submitted","dateInformation":"v1"},{"date":"2026-08-05T00:47:12Z","dateType":"Updated","dateInformation":"v1"},{"date":"2026-08","dateType":"Available","dateInformation":"v1"}],"language":null,"types":{"schemaOrg":"CreativeWork","resourceTypeGeneral":"Preprint","citeproc":"article","bibtex":"misc","ris":"GEN","resourceType":"Article"},"relatedIdentifiers":[],"relatedItems":[],"sizes":[],"formats":[],"version":"1","rightsList":[{"rightsUri":"http://arxiv.org/licenses/nonexclusive-distrib/1.0/","rights":"arXiv.org perpetual, non-exclusive license"}],"descriptions":[{"descriptionType":"Abstract","description":"External skills extend the capabilities of large language model agents, but also introduce an execution-time attack surface: a skill that appears benign under inspection may reveal harmful behavior only after particular environmental states, resources, or interaction histories are encountered. Existing scanners primarily rely on static analysis, predefined rules, or one-shot semantic judgments, making such conditional behavior difficult to elicit and attribute. We present SkillSentry, a dynamic safety-testing framework based on adaptive honey worlds. SkillSentry infers the intended capability boundary of a skill, constructs an LLM-simulated environment with controlled decoy resources, and adaptively generates tasks to explore its behavioral states. It then compares skill-enabled trajectories with matched no-skill executions, grounding suspicious behaviors in source code and verified execution traces before making a final decision. We evaluate SkillSentry against seven scanner configurations. SkillSentry achieves 99.50% Recall and 96.26% average F1 on standard benchmarks. Under semantics-preserving evasion, it reaches 92.95% average F1, compared with 80.07% for the strongest baselines. Our code is available at https://github.com/nizhangli062-jpg/SkillSentry-Adaptive-Honey-Worlds-for-Dynamic-Safety-Testing-of-Agent-Skills."}],"geoLocations":[],"fundingReferences":[],"url":"https://arxiv.org/abs/2608.03485","contentUrl":null,"metadataVersion":0,"schemaVersion":"http://datacite.org/schema/kernel-4","source":"mds","isActive":true,"state":"findable","reason":null,"viewCount":0,"downloadCount":0,"referenceCount":0,"citationCount":0,"partCount":0,"partOfCount":0,"versionCount":0,"versionOfCount":0,"created":"2026-08-05T02:14:03Z","registered":"2026-08-05T02:14:03Z","published":null,"updated":"2026-08-05T02:14:03Z"},"relationships":{"client":{"data":{"id":"arxiv.content","type":"clients"}}}},{"id":"10.48550/arxiv.2608.03484","type":"dois","attributes":{"doi":"10.48550/arxiv.2608.03484","identifiers":[{"identifier":"2608.03484","identifierType":"arXiv"}],"creators":[{"nameType":"Personal","givenName":"J.","familyName":"Buttler","name":"Buttler, J.","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"G.","familyName":"Vigeesh","name":"Vigeesh, G.","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"I.","familyName":"Milić","name":"Milić, I.","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"M.","familyName":"van Noort","name":"van Noort, M.","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"S. M. Díaz","familyName":"Castillo","name":"Castillo, S. M. Díaz","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"C. J. Díaz","familyName":"Baso","name":"Baso, C. J. Díaz","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"F.","familyName":"Riva","name":"Riva, F.","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"O.","familyName":"Steiner","name":"Steiner, O.","affiliation":[],"nameIdentifiers":[]}],"titles":[{"title":"Wave excitation by a collapsing granule: insights from IFU observations and high-resolution RMHD simulations"}],"publisher":"arXiv","container":{},"publicationYear":2026,"subjects":[{"subject":"Solar and Stellar Astrophysics (astro-ph.SR)","lang":"en","subjectScheme":"arXiv"},{"subject":"FOS: Physical sciences","subjectScheme":"Fields of Science and Technology (FOS)"}],"contributors":[],"dates":[{"date":"2026-08-04T11:22:12Z","dateType":"Submitted","dateInformation":"v1"},{"date":"2026-08-05T00:47:10Z","dateType":"Updated","dateInformation":"v1"},{"date":"2026-08","dateType":"Available","dateInformation":"v1"}],"language":null,"types":{"schemaOrg":"CreativeWork","resourceTypeGeneral":"Preprint","citeproc":"article","bibtex":"misc","ris":"GEN","resourceType":"Article"},"relatedIdentifiers":[],"relatedItems":[],"sizes":[],"formats":[],"version":"1","rightsList":[{"rightsIdentifierScheme":"SPDX","rightsUri":"https://creativecommons.org/licenses/by/4.0/legalcode","schemeUri":"https://spdx.org/licenses/","rights":"Creative Commons Attribution 4.0 International","rightsIdentifier":"cc-by-4.0"}],"descriptions":[{"descriptionType":"Abstract","description":"Context. Granular collapse is an ubiquitous process of granular evolution on the solar surface, but it is hard to analyze in sufficient spatial, temporal, and spectral detail.\n Aims. We analyze the change in physical conditions in the photosphere during a specific granular collapse event and the subsequent atmospheric response.\n Methods. We contrast a high-resolution radiative magneto-hydrodynamic simulation of a granular collapse performed using the CO5BOLD code with the recent integral field unit observations carried out using the MiHI instrument at the Swedish 1-m Solar Telescope.\n Results. Our analysis shows that the observed and simulated granular collapse show remarkable similarity. Specifically, they both exhibit the signature of a wave pulse excited in the deep photosphere and visible up to the temperature minimum. This wave is detectable through a blue-wing emission in the observed and synthetic Na i D1 line. We also estimate the acoustic energy flux carried by the wave and analyze its initiation.\n Conclusions. Combining high-resolution IFU spectropolarimetry and state-of-the-art simulations of the solar lower atmosphere, this study showcases our current capabilities in identifying specific physical processes taking place during the granular collapse and their impact on the atmosphere above."},{"descriptionType":"Other","description":"11 pages, 13 figures"}],"geoLocations":[],"fundingReferences":[],"url":"https://arxiv.org/abs/2608.03484","contentUrl":null,"metadataVersion":0,"schemaVersion":"http://datacite.org/schema/kernel-4","source":"mds","isActive":true,"state":"findable","reason":null,"viewCount":0,"downloadCount":0,"referenceCount":0,"citationCount":0,"partCount":0,"partOfCount":0,"versionCount":0,"versionOfCount":0,"created":"2026-08-05T02:14:01Z","registered":"2026-08-05T02:14:02Z","published":null,"updated":"2026-08-05T02:14:02Z"},"relationships":{"client":{"data":{"id":"arxiv.content","type":"clients"}}}},{"id":"10.48550/arxiv.2608.03483","type":"dois","attributes":{"doi":"10.48550/arxiv.2608.03483","identifiers":[{"identifier":"2608.03483","identifierType":"arXiv"}],"creators":[{"nameType":"Personal","givenName":"Weichen","familyName":"Xu","name":"Xu, Weichen","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Zhenhua","familyName":"Liu","name":"Liu, Zhenhua","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Lin","familyName":"Luo","name":"Luo, Lin","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Yaobo","familyName":"Liang","name":"Liang, Yaobo","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Chengtang","familyName":"Yao","name":"Yao, Chengtang","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Qingyu","familyName":"Mei","name":"Mei, Qingyu","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Jian","familyName":"Cao","name":"Cao, Jian","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Xixin","familyName":"Cao","name":"Cao, Xixin","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Xing","familyName":"Zhang","name":"Zhang, Xing","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Jiaolong","familyName":"Yang","name":"Yang, Jiaolong","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Baining","familyName":"Guo","name":"Guo, Baining","affiliation":[],"nameIdentifiers":[]}],"titles":[{"title":"Continue or Replan? Bernoulli-Continuation Policy Learning for Adaptive Horizon Execution"}],"publisher":"arXiv","container":{},"publicationYear":2026,"subjects":[{"subject":"Robotics (cs.RO)","lang":"en","subjectScheme":"arXiv"},{"subject":"Artificial Intelligence (cs.AI)","lang":"en","subjectScheme":"arXiv"},{"subject":"Computer Vision and Pattern Recognition (cs.CV)","lang":"en","subjectScheme":"arXiv"},{"subject":"Machine Learning (cs.LG)","lang":"en","subjectScheme":"arXiv"},{"subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"}],"contributors":[],"dates":[{"date":"2026-08-04T11:21:08Z","dateType":"Submitted","dateInformation":"v1"},{"date":"2026-08-05T00:47:05Z","dateType":"Updated","dateInformation":"v1"},{"date":"2026-08","dateType":"Available","dateInformation":"v1"}],"language":null,"types":{"schemaOrg":"CreativeWork","resourceTypeGeneral":"Preprint","citeproc":"article","bibtex":"misc","ris":"GEN","resourceType":"Article"},"relatedIdentifiers":[],"relatedItems":[],"sizes":[],"formats":[],"version":"1","rightsList":[{"rightsUri":"http://arxiv.org/licenses/nonexclusive-distrib/1.0/","rights":"arXiv.org perpetual, non-exclusive license"}],"descriptions":[{"descriptionType":"Abstract","description":"Existing chunk-based Vision-Language-Action (VLA) models execute a fixed number of actions (i.e., execution horizon) before replanning, turning replanning into a task-agnostic periodic schedule that is independent of task progress. As a result, when no replanning boundary falls before a critical manipulation stage, it is executed from a stale chunk rather than a freshly replanned one. To address this limitation, we propose Bernoulli-Continuation Policy (BCP), a lightweight, plug-and-play framework for adaptive horizon execution that keeps the base VLA frozen. Given a fixed-length action chunk, its continuation head decomposes execution-horizon selection into a sequence of continue-or-replan decisions, which imposes an ordinal, prefix-sharing inductive bias over candidate horizons rather than treating them as independent classes. Since the optimal horizon for each chunk is not observable, we train this head with reinforcement learning from trajectory-level outcomes and introduce a Replanning-Efficiency Reward that jointly rewards task success and efficient VLA usage, discouraging the policy from collapsing to unnecessarily short horizons. On RoboTwin 2.0 with LingBot-VLA as the base policy, BCP improves the average success rate by +11.08% on 13 low-success tasks and from 89.88% to 93.94% (+4.06%) across all 50 tasks. Although trained only under the Clean setting, BCP generalizes to the Randomized setting, raising the average success rate by +4.06%. It also transfers to a different base policy $π_{0.5}$, achieving a better result on LIBERO (+1.7%) and, notably, on the harder LIBERO-PRO (+6.8%). On a real robot, BCP lifts success from 74% to 92% and from 44% to 84% on two manipulation tasks. Meanwhile, its negligible overhead, combined with higher success, makes BCP's overall runtime even lower than the fixed-horizon baselines."},{"descriptionType":"Other","description":"Project page: https://fleetfootwork.github.io/BCP/"}],"geoLocations":[],"fundingReferences":[],"url":"https://arxiv.org/abs/2608.03483","contentUrl":null,"metadataVersion":0,"schemaVersion":"http://datacite.org/schema/kernel-4","source":"mds","isActive":true,"state":"findable","reason":null,"viewCount":0,"downloadCount":0,"referenceCount":0,"citationCount":0,"partCount":0,"partOfCount":0,"versionCount":0,"versionOfCount":0,"created":"2026-08-05T02:13:59Z","registered":"2026-08-05T02:14:00Z","published":null,"updated":"2026-08-05T02:14:00Z"},"relationships":{"client":{"data":{"id":"arxiv.content","type":"clients"}}}},{"id":"10.48550/arxiv.2608.03482","type":"dois","attributes":{"doi":"10.48550/arxiv.2608.03482","identifiers":[{"identifier":"2608.03482","identifierType":"arXiv"}],"creators":[{"nameType":"Personal","givenName":"Álvaro Sánchez-Paniagua","familyName":"Ríos","name":"Ríos, Álvaro Sánchez-Paniagua","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Juan P.","familyName":"Llerena","name":"Llerena, Juan P.","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Alberto","familyName":"Lastra","name":"Lastra, Alberto","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Nuria","familyName":"Torrado","name":"Torrado, Nuria","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Edmundo J.","familyName":"Huertas","name":"Huertas, Edmundo J.","affiliation":[],"nameIdentifiers":[]}],"titles":[{"title":"Beyond the Gegenbauer Paradigm: q-Orthogonal Kernels for Machine Learning"}],"publisher":"arXiv","container":{},"publicationYear":2026,"subjects":[{"subject":"Machine Learning (cs.LG)","lang":"en","subjectScheme":"arXiv"},{"subject":"Machine Learning (stat.ML)","lang":"en","subjectScheme":"arXiv"},{"subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"},{"subject":"68T05 (Primary), 33D45 (Secondary), 62H30 (Secondary)","lang":"en","subjectScheme":"MSC"}],"contributors":[],"dates":[{"date":"2026-08-04T11:18:28Z","dateType":"Submitted","dateInformation":"v1"},{"date":"2026-08-05T00:46:57Z","dateType":"Updated","dateInformation":"v1"},{"date":"2026-08","dateType":"Available","dateInformation":"v1"}],"language":null,"types":{"schemaOrg":"CreativeWork","resourceTypeGeneral":"Preprint","citeproc":"article","bibtex":"misc","ris":"GEN","resourceType":"Article"},"relatedIdentifiers":[],"relatedItems":[],"sizes":[],"formats":[],"version":"1","rightsList":[{"rightsUri":"http://arxiv.org/licenses/nonexclusive-distrib/1.0/","rights":"arXiv.org perpetual, non-exclusive license"}],"descriptions":[{"descriptionType":"Abstract","description":"The performance of Support Vector Machines (SVMs) critically depends on the kernel function choice, which enables implicit mapping of data into high-dimensional feature spaces. While classical kernels like Radial Basis Function (RBF) remain popular, orthogonal polynomial kernels offer mathematically interpretable alternatives that can incorporate structured prior knowledge. This work extends the orthogonal polynomial kernel paradigm by introducing a novel family based on discrete $q$-Hermite I polynomials, a class of $q$-orthogonal polynomials that generalize classical Hermite polynomials through a deformation parameter $q$. We formally define the q-Hermite kernel and establish its validity under Mercer's theorem. The kernel's inherent boundedness properties naturally prevent annihilation and explosion effects without requiring explicit scaling mechanisms. Extensive experiments across 20 benchmark datasets demonstrate that the proposed kernel achieves competitive performance compared to both classical kernels and other orthogonal polynomial kernels, while offering advantages in numerical stability and computational simplicity. Our results confirm that $q$-orthogonal polynomials constitute a promising direction for kernel design, bridging mathematical elegance with practical machine learning applications, that provides conceptual and algorithmic resources that may be further extended to emerging quantum computing paradigms. To facilitate full reproducibility, we provide the complete implementation and experimental pipeline in an open-access GitHub repository at https://github.com/Kokechacho/SVMs-QSVMs."},{"descriptionType":"Other","description":"27 pages, 4 figures, 9 tables. Source code and experimental pipeline available at https://github.com/Kokechacho/SVMs-QSVMs"}],"geoLocations":[],"fundingReferences":[],"url":"https://arxiv.org/abs/2608.03482","contentUrl":null,"metadataVersion":0,"schemaVersion":"http://datacite.org/schema/kernel-4","source":"mds","isActive":true,"state":"findable","reason":null,"viewCount":0,"downloadCount":0,"referenceCount":0,"citationCount":0,"partCount":0,"partOfCount":0,"versionCount":0,"versionOfCount":0,"created":"2026-08-05T02:13:58Z","registered":"2026-08-05T02:13:58Z","published":null,"updated":"2026-08-05T02:13:58Z"},"relationships":{"client":{"data":{"id":"arxiv.content","type":"clients"}}}},{"id":"10.48550/arxiv.2608.03481","type":"dois","attributes":{"doi":"10.48550/arxiv.2608.03481","identifiers":[{"identifier":"2608.03481","identifierType":"arXiv"}],"creators":[{"nameType":"Personal","givenName":"Dima","familyName":"Bykhovsky","name":"Bykhovsky, Dima","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Evyatar","familyName":"Chaimoff","name":"Chaimoff, Evyatar","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Pe'er","familyName":"Eden","name":"Eden, Pe'er","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Tom","familyName":"Simkin","name":"Simkin, Tom","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Oshrit","familyName":"Hoffer","name":"Hoffer, Oshrit","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Shahar","familyName":"Cohen","name":"Cohen, Shahar","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Bar Eilat","familyName":"Yogev","name":"Yogev, Bar Eilat","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Gal","familyName":"Levi","name":"Levi, Gal","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Noa","familyName":"Efroni","name":"Efroni, Noa","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Doron","familyName":"Todder","name":"Todder, Doron","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Hagit","familyName":"Cohen","name":"Cohen, Hagit","affiliation":[],"nameIdentifiers":[]}],"titles":[{"title":"Radiometric Thermal Imaging Dataset of Laboratory Rats with Anatomical Segmentation Masks"}],"publisher":"arXiv","container":{},"publicationYear":2026,"subjects":[{"subject":"Image and Video Processing (eess.IV)","lang":"en","subjectScheme":"arXiv"},{"subject":"FOS: Electrical engineering, electronic engineering, information engineering","subjectScheme":"Fields of Science and Technology (FOS)"}],"contributors":[],"dates":[{"date":"2026-08-04T11:18:21Z","dateType":"Submitted","dateInformation":"v1"},{"date":"2026-08-05T00:46:56Z","dateType":"Updated","dateInformation":"v1"},{"date":"2026-08","dateType":"Available","dateInformation":"v1"}],"language":null,"types":{"schemaOrg":"CreativeWork","resourceTypeGeneral":"Preprint","citeproc":"article","bibtex":"misc","ris":"GEN","resourceType":"Article"},"relatedIdentifiers":[],"relatedItems":[],"sizes":[],"formats":[],"version":"1","rightsList":[{"rightsIdentifierScheme":"SPDX","rightsUri":"https://creativecommons.org/licenses/by-nc-nd/4.0/legalcode","schemeUri":"https://spdx.org/licenses/","rights":"Creative Commons Attribution Non Commercial No Derivatives 4.0 International","rightsIdentifier":"cc-by-nc-nd-4.0"}],"descriptions":[{"descriptionType":"Abstract","description":"Infrared thermography provides a contact-free, restraint-free method to record surface temperatures. It serves as a valuable marker for thermoregulatory responses in laboratory animal stress and pharmacology research. However, the analysis of these images is currently bottlenecked by the manual delineation of anatomical regions. To date, no public dataset has provided paired radiometric thermal frames of rats with pixel-level body-part labels. We present a dataset of 1,655 quality-controlled radiometric thermal frames from 25 laboratory rats. Each frame is paired with a dense four-class anatomical segmentation mask (background, head, body, and tail) and the raw $480 \\times 640$ temperature matrix (rows $\\times$ columns) in degrees Celsius. This ensures every label is registered directly to the physical temperature it describes rather than a color-mapped rendering. The frames originate from two pharmacological cohorts where interventions alter thermoregulation in opposite directions: ethanol, which induces peripheral vasodilation, and ketamine, which affects central thermoregulation. This provides a wide and physiologically diverse range of surface temperature regimes. Aggregated across the dataset, the per-class temperatures follow a head~$\u0026gt;$~body~$\u0026gt;$~tail ordering in physical units. To demonstrate that the data support pixel-level segmentation directly from the radiometric channel, we present an exploratory U-Net segmentation pipeline that attains a subject-level cross-validated mean intersection-over-union of $0.895 \\pm 0.006$. The dataset provides a reuse-ready benchmark for thermal semantic segmentation and for downstream physiological and stress-phenotyping analyses."}],"geoLocations":[],"fundingReferences":[],"url":"https://arxiv.org/abs/2608.03481","contentUrl":null,"metadataVersion":0,"schemaVersion":"http://datacite.org/schema/kernel-4","source":"mds","isActive":true,"state":"findable","reason":null,"viewCount":0,"downloadCount":0,"referenceCount":0,"citationCount":0,"partCount":0,"partOfCount":0,"versionCount":0,"versionOfCount":0,"created":"2026-08-05T02:13:56Z","registered":"2026-08-05T02:13:57Z","published":null,"updated":"2026-08-05T02:13:57Z"},"relationships":{"client":{"data":{"id":"arxiv.content","type":"clients"}}}},{"id":"10.48550/arxiv.2608.03480","type":"dois","attributes":{"doi":"10.48550/arxiv.2608.03480","identifiers":[{"identifier":"2608.03480","identifierType":"arXiv"}],"creators":[{"nameType":"Personal","givenName":"Ahmed Amine","familyName":"Aliane","name":"Aliane, Ahmed Amine","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Nasredine","familyName":"Semmar","name":"Semmar, Nasredine","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Hassina","familyName":"Aliane","name":"Aliane, Hassina","affiliation":[],"nameIdentifiers":[]}],"titles":[{"title":"Efficient Multilingual Neural Machine Translation via Corpus-Driven Vocabulary Pruning: An English-Arabic Case Study"}],"publisher":"arXiv","container":{},"publicationYear":2026,"subjects":[{"subject":"Computation and Language (cs.CL)","lang":"en","subjectScheme":"arXiv"},{"subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"}],"contributors":[],"dates":[{"date":"2026-08-04T11:17:54Z","dateType":"Submitted","dateInformation":"v1"},{"date":"2026-08-05T00:46:55Z","dateType":"Updated","dateInformation":"v1"},{"date":"2026-08","dateType":"Available","dateInformation":"v1"}],"language":null,"types":{"schemaOrg":"CreativeWork","resourceTypeGeneral":"Preprint","citeproc":"article","bibtex":"misc","ris":"GEN","resourceType":"Article"},"relatedIdentifiers":[],"relatedItems":[],"sizes":[],"formats":[],"version":"1","rightsList":[{"rightsUri":"http://arxiv.org/licenses/nonexclusive-distrib/1.0/","rights":"arXiv.org perpetual, non-exclusive license"}],"descriptions":[{"descriptionType":"Abstract","description":"The adoption of large pre-trained multilingual models for neural machine translation (MNMT) faces a major challenge: excessive memory and computational consumption due to overly large vocabularies and embedding layers. Although existing compression methods like pruning, quantization and knowledge distillation reduce parameter redundancy, they mainly preserve the structure of the original vocabulary, thereby leaving a major source of inefficiency unresolved. We propose in this paper a general optimization framework that combines a vocabulary pruning method with a targeted fine-tuning protocol for MNMT models. We evaluate the proposed framework using three models (M2M100, NLLB-200, mBART-50) on the English-Arabic language pair. Our approach reduces the vocabulary size from over 128,000 to approximately 10,000 tokens, enabling a 60% memory saving without any loss in performance. Results show that optimized multilingual models can match or exceed the performance of dedicated bilingual baselines. In particular, the pruned and fine-tuned M2M100 model achieves a competitive BLEU score of 42.04 (against 44.59 for the OPUS-MTen- ar bilingual model) while it significantly outperforms it on the COMET metric (0.8730 vs 0.7911) revealing superior semantic adequacy and fluency."}],"geoLocations":[],"fundingReferences":[],"url":"https://arxiv.org/abs/2608.03480","contentUrl":null,"metadataVersion":0,"schemaVersion":"http://datacite.org/schema/kernel-4","source":"mds","isActive":true,"state":"findable","reason":null,"viewCount":0,"downloadCount":0,"referenceCount":0,"citationCount":0,"partCount":0,"partOfCount":0,"versionCount":0,"versionOfCount":0,"created":"2026-08-05T02:13:55Z","registered":null,"published":null,"updated":"2026-08-05T02:13:55Z"},"relationships":{"client":{"data":{"id":"arxiv.content","type":"clients"}}}},{"id":"10.48550/arxiv.2608.03479","type":"dois","attributes":{"doi":"10.48550/arxiv.2608.03479","identifiers":[{"identifier":"2608.03479","identifierType":"arXiv"}],"creators":[{"nameType":"Personal","givenName":"Ahmet Oguz","familyName":"Kislal","name":"Kislal, Ahmet Oguz","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Melda","familyName":"Yuksel","name":"Yuksel, Melda","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Ali","familyName":"Gorcin","name":"Gorcin, Ali","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Halim","familyName":"Yanikomeroglu","name":"Yanikomeroglu, Halim","affiliation":[],"nameIdentifiers":[]}],"titles":[{"title":"Pilot-Assisted Faster-than-Nyquist Signaling for HRLLC: A Non-Asymptotic Approach"}],"publisher":"arXiv","container":{},"publicationYear":2026,"subjects":[{"subject":"Information Theory (cs.IT)","lang":"en","subjectScheme":"arXiv"},{"subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"}],"contributors":[],"dates":[{"date":"2026-08-04T11:17:32Z","dateType":"Submitted","dateInformation":"v1"},{"date":"2026-08-05T00:46:54Z","dateType":"Updated","dateInformation":"v1"},{"date":"2026-08","dateType":"Available","dateInformation":"v1"}],"language":null,"types":{"schemaOrg":"CreativeWork","resourceTypeGeneral":"Preprint","citeproc":"article","bibtex":"misc","ris":"GEN","resourceType":"Article"},"relatedIdentifiers":[],"relatedItems":[],"sizes":[],"formats":[],"version":"1","rightsList":[{"rightsUri":"http://arxiv.org/licenses/nonexclusive-distrib/1.0/","rights":"arXiv.org perpetual, non-exclusive license"}],"descriptions":[{"descriptionType":"Abstract","description":"This paper investigates the performance of faster-than-Nyquist (FTN) signaling within the context of hyper-reliable low-latency communications (HRLLC), specifically focusing on the challenges imposed by the short-packet regime. While traditional Nyquist-based systems maintain symbol orthogonality to prevent inter-symbol interference (ISI), FTN intentionally introduces ISI to achieve higher transmission rates. While many existing FTN studies assume perfect channel state information, this assumption is often impractical for mission-critical HRLLC. In such scenarios, a portion of the limited packet length must be reserved for pilot symbols to ensure reliable estimation. To characterize the achievable error probability while accounting for imperfect channel estimation in the short-blocklength regime, we derive the random coding union bound with parameter $s$ (RCUs) under mismatched decoding for FTN systems. The numerical results demonstrate that FTN provides up to a 2 \\dB SNR gain over Nyquist signaling, provided that power allocation and pilot overhead are optimized. These findings highlight the necessity of non-asymptotic analysis for designing efficient, next-generation HRLLC-FTN systems."},{"descriptionType":"Other","description":"Will be presented at Globecom 2026"}],"geoLocations":[],"fundingReferences":[],"url":"https://arxiv.org/abs/2608.03479","contentUrl":null,"metadataVersion":0,"schemaVersion":"http://datacite.org/schema/kernel-4","source":"mds","isActive":true,"state":"findable","reason":null,"viewCount":0,"downloadCount":0,"referenceCount":0,"citationCount":0,"partCount":0,"partOfCount":0,"versionCount":0,"versionOfCount":0,"created":"2026-08-05T02:13:53Z","registered":"2026-08-05T02:13:54Z","published":null,"updated":"2026-08-05T02:13:54Z"},"relationships":{"client":{"data":{"id":"arxiv.content","type":"clients"}}}},{"id":"10.48550/arxiv.2608.03478","type":"dois","attributes":{"doi":"10.48550/arxiv.2608.03478","identifiers":[{"identifier":"2608.03478","identifierType":"arXiv"}],"creators":[{"nameType":"Personal","givenName":"Neeraj","familyName":"Kulhari","name":"Kulhari, Neeraj","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Krishna Swaroop","familyName":"Sharma","name":"Sharma, Krishna Swaroop","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"K. C.","familyName":"Bhamu","name":"Bhamu, K. C.","affiliation":[],"nameIdentifiers":[]}],"titles":[{"title":"Anisotropic Phonon Heat Flow and Thermoelectric Response in Tetragonal GeS$_2$ and GeSe$_2$"}],"publisher":"arXiv","container":{},"publicationYear":2026,"subjects":[{"subject":"Materials Science (cond-mat.mtrl-sci)","lang":"en","subjectScheme":"arXiv"},{"subject":"Other Condensed Matter (cond-mat.other)","lang":"en","subjectScheme":"arXiv"},{"subject":"FOS: Physical sciences","subjectScheme":"Fields of Science and Technology (FOS)"}],"contributors":[],"dates":[{"date":"2026-08-04T11:16:13Z","dateType":"Submitted","dateInformation":"v1"},{"date":"2026-08-05T00:46:45Z","dateType":"Updated","dateInformation":"v1"},{"date":"2026-08","dateType":"Available","dateInformation":"v1"}],"language":null,"types":{"schemaOrg":"CreativeWork","resourceTypeGeneral":"Preprint","citeproc":"article","bibtex":"misc","ris":"GEN","resourceType":"Article"},"relatedIdentifiers":[],"relatedItems":[],"sizes":[],"formats":[],"version":"1","rightsList":[{"rightsIdentifierScheme":"SPDX","rightsUri":"https://creativecommons.org/licenses/by/4.0/legalcode","schemeUri":"https://spdx.org/licenses/","rights":"Creative Commons Attribution 4.0 International","rightsIdentifier":"cc-by-4.0"}],"descriptions":[{"descriptionType":"Abstract","description":"The electronic structure, lattice dynamics, bonding, elastic response, and anisotropic thermoelectric transport properties of tetragonal GeS$_2$ and GeSe$_2$ were investigated using density functional theory, density functional perturbation theory, Wannier interpolation, and scattering-aware Boltzmann transport. The relaxed structures are mechanically and dynamically stable within the calculated harmonic description. The HSE03/Wannier band gaps are 2.48 eV for GeS$_2$ and 1.23 eV for GeSe$_2$, while substitution of S by Se lowers the upper phonon frequency from approximately 13.6 to 10.3 THz.\n The phonon Boltzmann transport calculations reveal pronounced lattice-transport anisotropy. Within the relaxation-time approximation, the 300 K in-plane and cross-plane lattice thermal conductivities are 26.86 and 1.19 W m$^{-1}$ K$^{-1}$ for GeS$_2$, and 18.74 and 1.52 W m$^{-1}$ K$^{-1}$ for GeSe$_2$, respectively. At 800 K, these values decrease to 10.22 and 0.46 W m$^{-1}$ K$^{-1}$ for GeS$_2$, and 7.25 and 0.58 W m$^{-1}$ K$^{-1}$ for GeSe$_2$. Frequency-resolved analysis shows that low-frequency phonons carry most of the heat, whereas the small cross-plane values reflect restricted out-of-plane phonon transport.\n Combining the ShengBTE RTA lattice tensors with AMSET electronic coefficients gives $zT=0.257$ for n-type cross-plane GeS$_2$ at 800 K and $10^{19}$ cm$^{-3}$. The corresponding PBE-AMSET estimate for GeSe$_2$ is $zT=0.066$ for p-type cross-plane transport at 800 K and $3\\times10^{20}$ cm$^{-3}$. LOBSTER analysis identifies mixed covalent--ionic Ge--X bonding, with Ge--S bonds having a larger stabilizing ICOHP magnitude than Ge--Se bonds ($-5.27$ versus $-4.74$ eV per bond). These results identify tetragonal GeX$_2$ compounds as strongly anisotropic thermoelectrics with moderate calculated $zT$ values whose cross-plane response benefits from suppressed lattice heat transport."},{"descriptionType":"Other","description":"31 pages, 25 figures, and 6 tables. Includes supplementary information"}],"geoLocations":[],"fundingReferences":[],"url":"https://arxiv.org/abs/2608.03478","contentUrl":null,"metadataVersion":0,"schemaVersion":"http://datacite.org/schema/kernel-4","source":"mds","isActive":true,"state":"findable","reason":null,"viewCount":0,"downloadCount":0,"referenceCount":0,"citationCount":0,"partCount":0,"partOfCount":0,"versionCount":0,"versionOfCount":0,"created":"2026-08-05T02:13:52Z","registered":"2026-08-05T02:13:53Z","published":null,"updated":"2026-08-05T02:13:53Z"},"relationships":{"client":{"data":{"id":"arxiv.content","type":"clients"}}}},{"id":"10.48550/arxiv.2608.03477","type":"dois","attributes":{"doi":"10.48550/arxiv.2608.03477","identifiers":[{"identifier":"2608.03477","identifierType":"arXiv"}],"creators":[{"nameType":"Personal","givenName":"Miika","familyName":"Hannula","name":"Hannula, Miika","affiliation":[],"nameIdentifiers":[]}],"titles":[{"title":"Getting to the Root: A Combined Complexity Perspective on Consistent Query Answering"}],"publisher":"arXiv","container":{},"publicationYear":2026,"subjects":[{"subject":"Databases (cs.DB)","lang":"en","subjectScheme":"arXiv"},{"subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"},{"subject":"H.2.4; F.2.2","lang":"en","subjectScheme":"ACM"},{"subject":"68P15, 68Q17","lang":"en","subjectScheme":"MSC"}],"contributors":[],"dates":[{"date":"2026-08-04T11:15:16Z","dateType":"Submitted","dateInformation":"v1"},{"date":"2026-08-05T00:46:43Z","dateType":"Updated","dateInformation":"v1"},{"date":"2026-08","dateType":"Available","dateInformation":"v1"}],"language":null,"types":{"schemaOrg":"CreativeWork","resourceTypeGeneral":"Preprint","citeproc":"article","bibtex":"misc","ris":"GEN","resourceType":"Article"},"relatedIdentifiers":[],"relatedItems":[],"sizes":[],"formats":[],"version":"1","rightsList":[{"rightsUri":"http://arxiv.org/licenses/nonexclusive-distrib/1.0/","rights":"arXiv.org perpetual, non-exclusive license"}],"descriptions":[{"descriptionType":"Abstract","description":"The data complexity of consistent query answering has been extensively studied over the past two decades. In this paper, we study its combined complexity, which has gained less attention. The input is a triple consisting of a set of integrity constraints, a (potentially inconsistent) database, and a query, and the question is to determine whether all repairs of the database with respect to the constraints satisfy the query. Our aim is to isolate query-specific structural features that make this problem computationally tractable. We focus on Boolean self-join-free conjunctive queries over primary-key constraints, as in this context the corresponding data complexity problem has been completely classified. Moreover, we restrict attention to queries with an acyclic attack graph, which are precisely those queries that admit a first-order rewriting. As an additional simplifying assumption, we focus on unary primary keys. Each conjunctive query with unary primary keys naturally gives rise to a directed graph, which we call the key-nonkey graph, where each atom contributes an edge from its key variable to each of its non-key variables. Our main result is that, under the stated assumptions, the combined complexity of consistent query answering is in polynomial time whenever the number of source strongly connected components (SCCs) in the key-nonkey graph is bounded by a constant. To prove this result, we develop novel concepts, such as variable guarding and attack-propagation graphs, and techniques, such as database and query saturation and query normalization. In addition, without the boundedness restriction, the combined complexity of this problem is shown to be Pi_2^P-complete."}],"geoLocations":[],"fundingReferences":[],"url":"https://arxiv.org/abs/2608.03477","contentUrl":null,"metadataVersion":0,"schemaVersion":"http://datacite.org/schema/kernel-4","source":"mds","isActive":true,"state":"findable","reason":null,"viewCount":0,"downloadCount":0,"referenceCount":0,"citationCount":0,"partCount":0,"partOfCount":0,"versionCount":0,"versionOfCount":0,"created":"2026-08-05T02:13:50Z","registered":"2026-08-05T02:13:51Z","published":null,"updated":"2026-08-05T02:13:51Z"},"relationships":{"client":{"data":{"id":"arxiv.content","type":"clients"}}}},{"id":"10.48550/arxiv.2608.03475","type":"dois","attributes":{"doi":"10.48550/arxiv.2608.03475","identifiers":[{"identifier":"2608.03475","identifierType":"arXiv"}],"creators":[{"nameType":"Personal","givenName":"Suraj","familyName":"Kumar","name":"Kumar, Suraj","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Mohnish","familyName":"Raj","name":"Raj, Mohnish","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Soumi","familyName":"Chattopadhayay","name":"Chattopadhayay, Soumi","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Chandranath","familyName":"Adak","name":"Adak, Chandranath","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Ayan","familyName":"Dutta","name":"Dutta, Ayan","affiliation":[],"nameIdentifiers":[]}],"titles":[{"title":"Adaptive Modality Reliability Diagnosis and Restoration for Robust Multimodal Intent Recognition"}],"publisher":"arXiv","container":{},"publicationYear":2026,"subjects":[{"subject":"Multimedia (cs.MM)","lang":"en","subjectScheme":"arXiv"},{"subject":"Artificial Intelligence (cs.AI)","lang":"en","subjectScheme":"arXiv"},{"subject":"Computation and Language (cs.CL)","lang":"en","subjectScheme":"arXiv"},{"subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"}],"contributors":[],"dates":[{"date":"2026-08-04T11:14:13Z","dateType":"Submitted","dateInformation":"v1"},{"date":"2026-08-05T00:46:32Z","dateType":"Updated","dateInformation":"v1"},{"date":"2026-08","dateType":"Available","dateInformation":"v1"}],"language":null,"types":{"schemaOrg":"CreativeWork","resourceTypeGeneral":"Preprint","citeproc":"article","bibtex":"misc","ris":"GEN","resourceType":"Article"},"relatedIdentifiers":[],"relatedItems":[],"sizes":[],"formats":[],"version":"1","rightsList":[{"rightsIdentifierScheme":"SPDX","rightsUri":"https://creativecommons.org/licenses/by/4.0/legalcode","schemeUri":"https://spdx.org/licenses/","rights":"Creative Commons Attribution 4.0 International","rightsIdentifier":"cc-by-4.0"}],"descriptions":[{"descriptionType":"Abstract","description":"Multimodal intent recognition combines linguistic, acoustic, and visual evidence, but individual modalities may be noisy, missing, semantically conflicting, or disproportionately dominant. Existing methods typically infer modality importance implicitly and either reweight or suppress unreliable inputs, without determining whether a degraded modality can be repaired and subsequently trusted. We propose PRIME (Precision-weighted Reliability Inference and Modality rEstoration), a closed-loop reliability guided framework that jointly diagnoses, restores, and reassesses modality quality at the sample level. PRIME represents the weakness of each modality through a contextual log-variance estimated from complementary diagnostic evidence, including predictive confidence, epistemic disagreement, cross-modal consensus, and feature degeneracy. Because modality-reliability annotations are unavailable, the estimator is explicitly trained using controlled modality corruption with known degradation severity, together with a heteroscedastic uncertainty objective. Rather than directly discarding an unreliable modality, PRIME uses its estimated weakness to control a prototype-conditioned variational restoration module that reconstructs the degraded representation from complementary modalities. Crucially, reliability is re-estimated after restoration, allowing the model to determine whether the repaired representation has become sufficiently trustworthy to contribute to prediction. The resulting post-restoration precisions are used for inverse-variance multimodal fusion. Experiments on multimodal intent-recognition benchmarks show that PRIME maintains competitive clean-data performance while improving robustness under missing, noisy, conflicting, and modality-imbalanced conditions."}],"geoLocations":[],"fundingReferences":[],"url":"https://arxiv.org/abs/2608.03475","contentUrl":null,"metadataVersion":0,"schemaVersion":"http://datacite.org/schema/kernel-4","source":"mds","isActive":true,"state":"findable","reason":null,"viewCount":0,"downloadCount":0,"referenceCount":0,"citationCount":0,"partCount":0,"partOfCount":0,"versionCount":0,"versionOfCount":0,"created":"2026-08-05T02:13:48Z","registered":null,"published":null,"updated":"2026-08-05T02:13:48Z"},"relationships":{"client":{"data":{"id":"arxiv.content","type":"clients"}}}},{"id":"10.48550/arxiv.2608.03474","type":"dois","attributes":{"doi":"10.48550/arxiv.2608.03474","identifiers":[{"identifier":"2608.03474","identifierType":"arXiv"}],"creators":[{"nameType":"Personal","givenName":"Qiming","familyName":"Li","name":"Li, Qiming","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Shujie","familyName":"Hu","name":"Hu, Shujie","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Haohan","familyName":"Liu","name":"Liu, Haohan","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Xiaocheng","familyName":"Feng","name":"Feng, Xiaocheng","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Songxiang","familyName":"Liu","name":"Liu, Songxiang","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Guanglu","familyName":"Wan","name":"Wan, Guanglu","affiliation":[],"nameIdentifiers":[]}],"titles":[{"title":"MT-Web2Code: Benchmarking Coding Agents on Multi-Turn Regional Reconstruction and Localized Modification"}],"publisher":"arXiv","container":{},"publicationYear":2026,"subjects":[{"subject":"Computer Vision and Pattern Recognition (cs.CV)","lang":"en","subjectScheme":"arXiv"},{"subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"}],"contributors":[],"dates":[{"date":"2026-08-04T11:14:00Z","dateType":"Submitted","dateInformation":"v1"},{"date":"2026-08-05T00:46:26Z","dateType":"Updated","dateInformation":"v1"},{"date":"2026-08","dateType":"Available","dateInformation":"v1"}],"language":null,"types":{"schemaOrg":"CreativeWork","resourceTypeGeneral":"Preprint","citeproc":"article","bibtex":"misc","ris":"GEN","resourceType":"Article"},"relatedIdentifiers":[],"relatedItems":[],"sizes":[],"formats":[],"version":"1","rightsList":[{"rightsIdentifierScheme":"SPDX","rightsUri":"https://creativecommons.org/licenses/by/4.0/legalcode","schemeUri":"https://spdx.org/licenses/","rights":"Creative Commons Attribution 4.0 International","rightsIdentifier":"cc-by-4.0"}],"descriptions":[{"descriptionType":"Abstract","description":"Recent advances in Large Vision-Language Models (LVLMs) have demonstrated impressive capabilities in web UI generation. However, existing benchmarks predominantly focus on single-turn full-page generation from scratch, overlooking the iterative workflow of real-world frontend engineering, where developers repeatedly reconstruct missing regions and modify localized elements within existing codebases. To bridge this gap, we introduce MT-Web2Code, the first multimodal coding benchmark for multi-turn Macro-Level Regional Reconstruction and Micro-Level Localized Modification, which contains 102 tasks spanning 16 vertical domains. To construct deterministic repair trajectories without costly turn-level human annotation, we develop a scalable Reverse-Corruption Trajectory Engine that iteratively injects structural and stylistic defects into golden pages. We further propose a dual-axis evaluation protocol that measures target-region fidelity and the preservation of unaffected content, where regional reconstruction is assessed by a 5-dimensional VLM-based rubric and localized modification by deterministic pixel-grounded alignment. Experiments on 13 frontier coding agents reveal that current agents struggle to faithfully reconstruct target regions while preserving unaffected content, lack fine-grained visual-code alignment for localized edits, and suffer from error snowballing over multiple turns. Beyond benchmarking, our deterministic evaluation metrics provide fine-grained feedback signals that may facilitate future research on training iterative UI coding agents. Our evaluation code and data will soon be released."}],"geoLocations":[],"fundingReferences":[],"url":"https://arxiv.org/abs/2608.03474","contentUrl":null,"metadataVersion":0,"schemaVersion":"http://datacite.org/schema/kernel-4","source":"mds","isActive":true,"state":"findable","reason":null,"viewCount":0,"downloadCount":0,"referenceCount":0,"citationCount":0,"partCount":0,"partOfCount":0,"versionCount":0,"versionOfCount":0,"created":"2026-08-05T02:13:46Z","registered":"2026-08-05T02:13:47Z","published":null,"updated":"2026-08-05T02:13:47Z"},"relationships":{"client":{"data":{"id":"arxiv.content","type":"clients"}}}},{"id":"10.48550/arxiv.2608.03472","type":"dois","attributes":{"doi":"10.48550/arxiv.2608.03472","identifiers":[{"identifier":"2608.03472","identifierType":"arXiv"}],"creators":[{"nameType":"Personal","givenName":"Haruyuki","familyName":"Kawabe","name":"Kawabe, Haruyuki","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Minoru","familyName":"Nagai","name":"Nagai, Minoru","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Tsuyoshi","familyName":"Okubo","name":"Okubo, Tsuyoshi","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Synge","familyName":"Todo","name":"Todo, Synge","affiliation":[],"nameIdentifiers":[]}],"titles":[{"title":"Matrix Product Evolution: A Method for Simulating Quantum Circuits Using Tensor Networks"}],"publisher":"arXiv","container":{},"publicationYear":2026,"subjects":[{"subject":"Quantum Physics (quant-ph)","lang":"en","subjectScheme":"arXiv"},{"subject":"FOS: Physical sciences","subjectScheme":"Fields of Science and Technology (FOS)"}],"contributors":[],"dates":[{"date":"2026-08-04T11:07:41Z","dateType":"Submitted","dateInformation":"v1"},{"date":"2026-08-05T00:46:11Z","dateType":"Updated","dateInformation":"v1"},{"date":"2026-08","dateType":"Available","dateInformation":"v1"}],"language":null,"types":{"schemaOrg":"CreativeWork","resourceTypeGeneral":"Preprint","citeproc":"article","bibtex":"misc","ris":"GEN","resourceType":"Article"},"relatedIdentifiers":[],"relatedItems":[],"sizes":[],"formats":[],"version":"1","rightsList":[{"rightsUri":"http://arxiv.org/licenses/nonexclusive-distrib/1.0/","rights":"arXiv.org perpetual, non-exclusive license"}],"descriptions":[{"descriptionType":"Abstract","description":"Classical simulation of quantum circuits is an essential tool in quantum information science, but its applicability is constrained by the exponential growth of the Hilbert space and the entanglement structure of quantum states. In this work, we introduce Matrix Product Evolution (MPE), a tensor-train representation of quantum circuits constructed along the circuit depth rather than along the qubit index. Within this formulation, the simulation of a quantum circuit is modeled as the contraction of multiple MPE tensors. We develop an efficient contraction strategy based on a zip-up procedure to carry out this contraction in practice. We investigate the numerical behavior of this MPE-based contraction framework through simulations of random quantum circuits and the time evolution of a quantum many-body state. Our results characterize the growth of temporal bond dimensions, clarify how post-selection modifies the contraction cost and approximation accuracy, and identify regimes in which depth-oriented tensor-network contractions provide a useful complement to standard MPS-based simulation approaches."}],"geoLocations":[],"fundingReferences":[],"url":"https://arxiv.org/abs/2608.03472","contentUrl":null,"metadataVersion":0,"schemaVersion":"http://datacite.org/schema/kernel-4","source":"mds","isActive":true,"state":"findable","reason":null,"viewCount":0,"downloadCount":0,"referenceCount":0,"citationCount":0,"partCount":0,"partOfCount":0,"versionCount":0,"versionOfCount":0,"created":"2026-08-05T02:13:43Z","registered":"2026-08-05T02:13:44Z","published":null,"updated":"2026-08-05T02:13:44Z"},"relationships":{"client":{"data":{"id":"arxiv.content","type":"clients"}}}},{"id":"10.48550/arxiv.2608.03469","type":"dois","attributes":{"doi":"10.48550/arxiv.2608.03469","identifiers":[{"identifier":"2608.03469","identifierType":"arXiv"}],"creators":[{"nameType":"Personal","givenName":"Ziyue","familyName":"Wang","name":"Wang, Ziyue","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Takafumi","familyName":"Kanamori","name":"Kanamori, Takafumi","affiliation":[],"nameIdentifiers":[]}],"titles":[{"title":"Should the Boundary Term Be Learned in Reflected Diffusion? Conormal Trace and Reflection Masking"}],"publisher":"arXiv","container":{},"publicationYear":2026,"subjects":[{"subject":"Machine Learning (stat.ML)","lang":"en","subjectScheme":"arXiv"},{"subject":"Machine Learning (cs.LG)","lang":"en","subjectScheme":"arXiv"},{"subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"}],"contributors":[],"dates":[{"date":"2026-08-04T11:05:02Z","dateType":"Submitted","dateInformation":"v1"},{"date":"2026-08-05T00:46:06Z","dateType":"Updated","dateInformation":"v1"},{"date":"2026-08","dateType":"Available","dateInformation":"v1"}],"language":null,"types":{"schemaOrg":"CreativeWork","resourceTypeGeneral":"Preprint","citeproc":"article","bibtex":"misc","ris":"GEN","resourceType":"Article"},"relatedIdentifiers":[],"relatedItems":[],"sizes":[],"formats":[],"version":"1","rightsList":[{"rightsUri":"http://arxiv.org/licenses/nonexclusive-distrib/1.0/","rights":"arXiv.org perpetual, non-exclusive license"}],"descriptions":[{"descriptionType":"Abstract","description":"We study score learning for reflected diffusion on bounded domains. Reflection keeps trajectories feasible but does not ensure that the learned score satisfies the boundary behavior implied by the forward process. With implicit score matching, integration by parts leaves a boundary term, and we show that it depends on one scalar at each boundary point: the diffusion- weighted normal component of the score, or conormal trace. The no-flux condition fixes this value while leaving the re- maining boundary components unrestricted; under anisotropic diffusion it generally differs from the ordinary normal score component. On hyperrectangles, our parametrization enforces the required trace without additional trainable parameters or a stochastic boundary estimator and, under regularity assump- tions, can represent the true score, whereas fixing an incorrect value creates an error that more data cannot remove. We ex- tend the construction to simplices and polygonal domains and identify reflection masking: hard reflection can keep samples feasible even when the learned trace is wrong, so post-reflection metrics may hide the error. Experiments show the clearest separation with less frequent reflection, anisotropic diffusion, and mass near intersections of constraints; under full reflection, final sample placement improves inconsistently, illustrating how hard repair can mask boundary-score errors and decouple score accuracy from downstream generation quality."}],"geoLocations":[],"fundingReferences":[],"url":"https://arxiv.org/abs/2608.03469","contentUrl":null,"metadataVersion":0,"schemaVersion":"http://datacite.org/schema/kernel-4","source":"mds","isActive":true,"state":"findable","reason":null,"viewCount":0,"downloadCount":0,"referenceCount":0,"citationCount":0,"partCount":0,"partOfCount":0,"versionCount":0,"versionOfCount":0,"created":"2026-08-05T02:13:39Z","registered":"2026-08-05T02:13:39Z","published":null,"updated":"2026-08-05T02:13:39Z"},"relationships":{"client":{"data":{"id":"arxiv.content","type":"clients"}}}},{"id":"10.48550/arxiv.2608.03468","type":"dois","attributes":{"doi":"10.48550/arxiv.2608.03468","identifiers":[{"identifier":"2608.03468","identifierType":"arXiv"}],"creators":[{"nameType":"Personal","givenName":"Xiuhui","familyName":"You","name":"You, Xiuhui","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Jiayi","familyName":"Luo","name":"Luo, Jiayi","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Zichao","familyName":"Shen","name":"Shen, Zichao","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Qingyun","familyName":"Sun","name":"Sun, Qingyun","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Ziwei","familyName":"Zhang","name":"Zhang, Ziwei","affiliation":[],"nameIdentifiers":[]}],"titles":[{"title":"ToolLIFT: Lifting Tool-Specific Trajectories into Function-Level Graphs for Generalizable Tool Planning"}],"publisher":"arXiv","container":{},"publicationYear":2026,"subjects":[{"subject":"Artificial Intelligence (cs.AI)","lang":"en","subjectScheme":"arXiv"},{"subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"}],"contributors":[],"dates":[{"date":"2026-08-04T11:02:45Z","dateType":"Submitted","dateInformation":"v1"},{"date":"2026-08-05T00:45:57Z","dateType":"Updated","dateInformation":"v1"},{"date":"2026-08","dateType":"Available","dateInformation":"v1"}],"language":null,"types":{"schemaOrg":"CreativeWork","resourceTypeGeneral":"Preprint","citeproc":"article","bibtex":"misc","ris":"GEN","resourceType":"Article"},"relatedIdentifiers":[],"relatedItems":[],"sizes":[],"formats":[],"version":"1","rightsList":[{"rightsUri":"http://arxiv.org/licenses/nonexclusive-distrib/1.0/","rights":"arXiv.org perpetual, non-exclusive license"}],"descriptions":[{"descriptionType":"Abstract","description":"Historical tool-use trajectories provide valuable experience for large language model (LLM) agents to plan and coordinate tool usage. Existing approaches directly construct tool-level graphs from these trajectories, but the resulting graphs remain tied to specific tools and are hard to generalize across tool sets. To tackle this challenge, we find that despite differences in the tools involved, analogous tasks often share a common function-level workflow structure, which serves as a potentially more transferable abstraction for tool planning. Based on this insight, we propose ToolLIFT, a framework that lifts tool-specific trajectories into a function-level workflow graph (FWG) for generalizable tool planning. Specifically, we first propose a trajectory-lifting mechanism that encodes workflow structures in the FWG and shares collaboration experience across tools. Then, building on the global structure of the FWG, we introduce decoupled workflow planning and tool selection to align individual tool choices with the overall workflow. Lastly, to ensure reliable tool dataflow, we adopt Reinforcement Learning (RL) and propose source-gated and skill-specific rewards to maintain source-traceable information flow across tool calls. Experiments on two in-distribution (ID) and three out-of-distribution (OOD) benchmarks show that ToolLIFT consistently outperforms state-of-the-art baselines, demonstrating strong generalization to unseen tool sets."}],"geoLocations":[],"fundingReferences":[],"url":"https://arxiv.org/abs/2608.03468","contentUrl":null,"metadataVersion":0,"schemaVersion":"http://datacite.org/schema/kernel-4","source":"mds","isActive":true,"state":"findable","reason":null,"viewCount":0,"downloadCount":0,"referenceCount":0,"citationCount":0,"partCount":0,"partOfCount":0,"versionCount":0,"versionOfCount":0,"created":"2026-08-05T02:13:37Z","registered":null,"published":null,"updated":"2026-08-05T02:13:38Z"},"relationships":{"client":{"data":{"id":"arxiv.content","type":"clients"}}}},{"id":"10.48550/arxiv.2608.03466","type":"dois","attributes":{"doi":"10.48550/arxiv.2608.03466","identifiers":[{"identifier":"2608.03466","identifierType":"arXiv"}],"creators":[{"nameType":"Personal","givenName":"Felix-Benedikt","familyName":"Liebrich","name":"Liebrich, Felix-Benedikt","affiliation":[],"nameIdentifiers":[]}],"titles":[{"title":"A unifying perspective on the collapse to the mean for law-invariant functionals"}],"publisher":"arXiv","container":{},"publicationYear":2026,"subjects":[{"subject":"Risk Management (q-fin.RM)","lang":"en","subjectScheme":"arXiv"},{"subject":"Probability (math.PR)","lang":"en","subjectScheme":"arXiv"},{"subject":"Mathematical Finance (q-fin.MF)","lang":"en","subjectScheme":"arXiv"},{"subject":"FOS: Economics and business","subjectScheme":"Fields of Science and Technology (FOS)"},{"subject":"FOS: Mathematics","subjectScheme":"Fields of Science and Technology (FOS)"}],"contributors":[],"dates":[{"date":"2026-08-04T11:02:26Z","dateType":"Submitted","dateInformation":"v1"},{"date":"2026-08-05T00:45:55Z","dateType":"Updated","dateInformation":"v1"},{"date":"2026-08","dateType":"Available","dateInformation":"v1"}],"language":null,"types":{"schemaOrg":"CreativeWork","resourceTypeGeneral":"Preprint","citeproc":"article","bibtex":"misc","ris":"GEN","resourceType":"Article"},"relatedIdentifiers":[],"relatedItems":[],"sizes":[],"formats":[],"version":"1","rightsList":[{"rightsUri":"http://arxiv.org/licenses/nonexclusive-distrib/1.0/","rights":"arXiv.org perpetual, non-exclusive license"}],"descriptions":[{"descriptionType":"Abstract","description":"We revisit the ``collapse to the mean'' phenomenon, which refers to mild structural conditions, such as local linearity, that force a law-invariant functional $\\ph$ defined on finite-mean random variables to depend solely on the expectation of its argument $X$, and not on any other distributional feature. Starting from a concise characterisation of the convex order, our simplified approach unifies and extends existing results without assuming the functional to be convex or monotone in the almost-sure order, and clarifies the conceptual foundations of the ``collapse to the mean\" phenomenon. In addition, we establish a new ``dual collapse'' result for quasi-star-shaped functionals."}],"geoLocations":[],"fundingReferences":[],"url":"https://arxiv.org/abs/2608.03466","contentUrl":null,"metadataVersion":0,"schemaVersion":"http://datacite.org/schema/kernel-4","source":"mds","isActive":true,"state":"findable","reason":null,"viewCount":0,"downloadCount":0,"referenceCount":0,"citationCount":0,"partCount":0,"partOfCount":0,"versionCount":0,"versionOfCount":0,"created":"2026-08-05T02:13:34Z","registered":null,"published":null,"updated":"2026-08-05T02:13:35Z"},"relationships":{"client":{"data":{"id":"arxiv.content","type":"clients"}}}},{"id":"10.48550/arxiv.2608.03465","type":"dois","attributes":{"doi":"10.48550/arxiv.2608.03465","identifiers":[{"identifier":"2608.03465","identifierType":"arXiv"}],"creators":[{"nameType":"Personal","givenName":"Kelin","familyName":"Wu","name":"Wu, Kelin","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Hongpeng","familyName":"Sun","name":"Sun, Hongpeng","affiliation":[],"nameIdentifiers":[]}],"titles":[{"title":"A proximal difference of convex functions algorithm using Barzilai-Borwein step size with nonmonotone line search and extrapolation"}],"publisher":"arXiv","container":{},"publicationYear":2026,"subjects":[{"subject":"Optimization and Control (math.OC)","lang":"en","subjectScheme":"arXiv"},{"subject":"Numerical Analysis (math.NA)","lang":"en","subjectScheme":"arXiv"},{"subject":"FOS: Mathematics","subjectScheme":"Fields of Science and Technology (FOS)"}],"contributors":[],"dates":[{"date":"2026-08-04T11:01:58Z","dateType":"Submitted","dateInformation":"v1"},{"date":"2026-08-05T00:45:54Z","dateType":"Updated","dateInformation":"v1"},{"date":"2026-08","dateType":"Available","dateInformation":"v1"}],"language":null,"types":{"schemaOrg":"CreativeWork","resourceTypeGeneral":"Preprint","citeproc":"article","bibtex":"misc","ris":"GEN","resourceType":"Article"},"relatedIdentifiers":[],"relatedItems":[],"sizes":[],"formats":[],"version":"1","rightsList":[{"rightsIdentifierScheme":"SPDX","rightsUri":"https://creativecommons.org/licenses/by-nc-sa/4.0/legalcode","schemeUri":"https://spdx.org/licenses/","rights":"Creative Commons Attribution Non Commercial Share Alike 4.0 International","rightsIdentifier":"cc-by-nc-sa-4.0"}],"descriptions":[{"descriptionType":"Abstract","description":"The paper proposes a novel proximal difference-of-convex (DC) algorithmic framework to solve general non-convex, non-smooth optimization problems. By combining Barzilai-Borwein (BB) step sizes with nonmonotone line search strategies, our approach effectively overcomes the conservative step sizes and stability issues inherent in standard proximal DC algorithms. Furthermore, we develop extrapolation mechanisms to accelerate convergence while ensuring global stability. The global convergence of the proposed algorithms is rigorously established under the Kurdyka-Łojasiewicz property. Numerical experiments on the SCAD-regularized least squares problem and graphic Ginzburg-Landau image segmentation models demonstrate that the proposed methods achieve highly competitive efficiency and accuracy compared to existing DC algorithms."}],"geoLocations":[],"fundingReferences":[],"url":"https://arxiv.org/abs/2608.03465","contentUrl":null,"metadataVersion":0,"schemaVersion":"http://datacite.org/schema/kernel-4","source":"mds","isActive":true,"state":"findable","reason":null,"viewCount":0,"downloadCount":0,"referenceCount":0,"citationCount":0,"partCount":0,"partOfCount":0,"versionCount":0,"versionOfCount":0,"created":"2026-08-05T02:13:33Z","registered":"2026-08-05T02:13:34Z","published":null,"updated":"2026-08-05T02:13:34Z"},"relationships":{"client":{"data":{"id":"arxiv.content","type":"clients"}}}},{"id":"10.48550/arxiv.2608.03463","type":"dois","attributes":{"doi":"10.48550/arxiv.2608.03463","identifiers":[{"identifier":"2608.03463","identifierType":"arXiv"}],"creators":[{"nameType":"Personal","givenName":"Yuxin","familyName":"Liao","name":"Liao, Yuxin","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Le","familyName":"Wu","name":"Wu, Le","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Min","familyName":"Hou","name":"Hou, Min","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Hao","familyName":"Liu","name":"Liu, Hao","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Han","familyName":"Wu","name":"Wu, Han","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Zishu","familyName":"Wang","name":"Wang, Zishu","affiliation":[],"nameIdentifiers":[]}],"titles":[{"title":"LeanMem: Simple and Efficient Long-Term Memory for LLM Agents"}],"publisher":"arXiv","container":{},"publicationYear":2026,"subjects":[{"subject":"Artificial Intelligence (cs.AI)","lang":"en","subjectScheme":"arXiv"},{"subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"}],"contributors":[],"dates":[{"date":"2026-08-04T10:59:49Z","dateType":"Submitted","dateInformation":"v1"},{"date":"2026-08-05T00:45:43Z","dateType":"Updated","dateInformation":"v1"},{"date":"2026-08","dateType":"Available","dateInformation":"v1"}],"language":null,"types":{"schemaOrg":"CreativeWork","resourceTypeGeneral":"Preprint","citeproc":"article","bibtex":"misc","ris":"GEN","resourceType":"Article"},"relatedIdentifiers":[],"relatedItems":[],"sizes":[],"formats":[],"version":"1","rightsList":[{"rightsUri":"http://arxiv.org/licenses/nonexclusive-distrib/1.0/","rights":"arXiv.org perpetual, non-exclusive license"}],"descriptions":[{"descriptionType":"Abstract","description":"Long-term memory is essential for LLM-based agents to sustain interactions and reliably leverage distant history. However, existing memory systems typically process heterogeneous dialogue content through a uniform summarization and retrieval pipeline, leading to either excessive token consumption or irreversible loss of fine-grained evidence. We argue that historical dialogue content should be handled differently according to its compressibility, temporal dynamics, and fidelity requirements. Based on this insight, we propose LeanMem, a lightweight long-term memory framework. LeanMem first filters out low-value content, then stores informative segments as compact profile memory, temporally structured event memory, or source-grounded record memory, depending on the nature of the information. During maintenance, only dynamically evolving event memories are selectively updated, avoiding redundant consolidation of stable profiles and immutable records. During inference, LeanMem dynamically selects memory types and allocates retrieval budgets according to query-specific evidence demands, assembling relevant evidence on demand. On LoCoMo and LongMemEval-S with GPT-4.1-mini and Qwen3-8B, LeanMem improves accuracy over the strongest memory-based baseline in every setting, by up to 15.1 points, at the lowest or near-lowest construction cost, inference tokens, and latency. The code and datasets are included in the supplementary materials."}],"geoLocations":[],"fundingReferences":[],"url":"https://arxiv.org/abs/2608.03463","contentUrl":null,"metadataVersion":0,"schemaVersion":"http://datacite.org/schema/kernel-4","source":"mds","isActive":true,"state":"findable","reason":null,"viewCount":0,"downloadCount":0,"referenceCount":0,"citationCount":0,"partCount":0,"partOfCount":0,"versionCount":0,"versionOfCount":0,"created":"2026-08-05T02:13:30Z","registered":"2026-08-05T02:13:31Z","published":null,"updated":"2026-08-05T02:13:31Z"},"relationships":{"client":{"data":{"id":"arxiv.content","type":"clients"}}}},{"id":"10.48550/arxiv.2608.03462","type":"dois","attributes":{"doi":"10.48550/arxiv.2608.03462","identifiers":[{"identifier":"2608.03462","identifierType":"arXiv"}],"creators":[{"nameType":"Personal","givenName":"Giusy","familyName":"Annunziata","name":"Annunziata, Giusy","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Rudrajit","familyName":"Choudhuri","name":"Choudhuri, Rudrajit","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Anita","familyName":"Sarma","name":"Sarma, Anita","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Gemma","familyName":"Catolino","name":"Catolino, Gemma","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Filomena","familyName":"Ferrucci","name":"Ferrucci, Filomena","affiliation":[],"nameIdentifiers":[]}],"titles":[{"title":"When AI Joins the Team! A Model of How AI Adoption Relates To Social Patterns in Software Engineering Teams"}],"publisher":"arXiv","container":{},"publicationYear":2026,"subjects":[{"subject":"Software Engineering (cs.SE)","lang":"en","subjectScheme":"arXiv"},{"subject":"Human-Computer Interaction (cs.HC)","lang":"en","subjectScheme":"arXiv"},{"subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"}],"contributors":[],"dates":[{"date":"2026-08-04T10:57:42Z","dateType":"Submitted","dateInformation":"v1"},{"date":"2026-08-05T00:45:41Z","dateType":"Updated","dateInformation":"v1"},{"date":"2026-08","dateType":"Available","dateInformation":"v1"}],"language":null,"types":{"schemaOrg":"CreativeWork","resourceTypeGeneral":"Preprint","citeproc":"article","bibtex":"misc","ris":"GEN","resourceType":"Article"},"relatedIdentifiers":[],"relatedItems":[],"sizes":[],"formats":[],"version":"1","rightsList":[{"rightsUri":"http://arxiv.org/licenses/nonexclusive-distrib/1.0/","rights":"arXiv.org perpetual, non-exclusive license"}],"descriptions":[{"descriptionType":"Abstract","description":"Context: The growing adoption of AI-assisted development tools is changing how software teams collaborate, share knowledge, and coordinate, yet its consequences for team social dynamics remain largely unexplored. Gap: It is unclear whether AI adoption is associated with an incr