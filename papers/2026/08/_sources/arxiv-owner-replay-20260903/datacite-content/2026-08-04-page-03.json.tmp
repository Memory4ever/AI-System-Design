milyName":"Patel","name":"Patel, A.","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"M. A.","familyName":"Petroff","name":"Petroff, M. A.","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"A. R.","familyName":"Polish","name":"Polish, A. R.","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"T.","familyName":"Prouve","name":"Prouve, T.","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"C.","familyName":"Pryke","name":"Pryke, C.","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"C. D.","familyName":"Reintsema","name":"Reintsema, C. D.","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"T.","familyName":"Romand","name":"Romand, T.","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"D.","familyName":"Santalucia","name":"Santalucia, D.","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"A.","familyName":"Schillaci","name":"Schillaci, A.","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"B.","familyName":"Schmitt","name":"Schmitt, B.","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"E.","familyName":"Sheffield","name":"Sheffield, E.","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"B.","familyName":"Singari","name":"Singari, B.","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"K.","familyName":"Sjoberg","name":"Sjoberg, K.","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"A.","familyName":"Soliman","name":"Soliman, A.","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"T. St","familyName":"Germaine","name":"Germaine, T. St","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"B.","familyName":"Steinbach","name":"Steinbach, B.","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"R.","familyName":"Sudiwala","name":"Sudiwala, R.","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"K. L.","familyName":"Thompson","name":"Thompson, K. L.","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"C.","familyName":"Tsai","name":"Tsai, C.","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"C.","familyName":"Tucker","name":"Tucker, C.","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"A. D.","familyName":"Turner","name":"Turner, A. D.","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"C.","familyName":"Vergès","name":"Vergès, C.","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"A. G.","familyName":"Vieregg","name":"Vieregg, A. G.","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"A.","familyName":"Wandui","name":"Wandui, A.","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"A. C.","familyName":"Weber","name":"Weber, A. C.","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"J.","familyName":"Willmert","name":"Willmert, J.","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"W. L. K.","familyName":"Wu","name":"Wu, W. L. K.","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"H.","familyName":"Yang","name":"Yang, H.","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"C.","familyName":"Yu","name":"Yu, C.","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"L.","familyName":"Zeng","name":"Zeng, L.","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"C.","familyName":"Zhang","name":"Zhang, C.","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"S.","familyName":"Zhang","name":"Zhang, S.","affiliation":[],"nameIdentifiers":[]}],"titles":[{"title":"Design and Performance of 220 and 270 GHz Bandpass Filters for BICEP Array"}],"publisher":"arXiv","container":{},"publicationYear":2026,"subjects":[{"subject":"Instrumentation and Methods for Astrophysics (astro-ph.IM)","lang":"en","subjectScheme":"arXiv"},{"subject":"FOS: Physical sciences","subjectScheme":"Fields of Science and Technology (FOS)"}],"contributors":[],"dates":[{"date":"2026-07-31T22:25:58Z","dateType":"Submitted","dateInformation":"v1"},{"date":"2026-08-04T00:13:34Z","dateType":"Updated","dateInformation":"v1"},{"date":"2026-08","dateType":"Available","dateInformation":"v1"}],"language":null,"types":{"schemaOrg":"CreativeWork","resourceTypeGeneral":"Preprint","citeproc":"article","bibtex":"misc","ris":"GEN","resourceType":"Article"},"relatedIdentifiers":[{"relationType":"IsVersionOf","relatedIdentifier":"10.1109/tasc.2026.3677818","relatedIdentifierType":"DOI"}],"relatedItems":[],"sizes":[],"formats":[],"version":"1","rightsList":[{"rightsIdentifierScheme":"SPDX","rightsUri":"https://creativecommons.org/licenses/by/4.0/legalcode","schemeUri":"https://spdx.org/licenses/","rights":"Creative Commons Attribution 4.0 International","rightsIdentifier":"cc-by-4.0"}],"descriptions":[{"descriptionType":"Abstract","description":"The BICEP Array (BA) is the latest in the BICEP/ Keck series of experiments that aim to measure the polarization of the cosmic microwave background (CMB) with small aperture polarimeters located at the South Pole. To constrain the frequency response of these receivers, each detector is serially coupled to a band-pass filter (BPF). The electric circuits of these BPFs utilize series and shunt capacitors as well as series inductors, but critically do not include shunt inductors which simplifies fabrication. The filters are designed and simulated with Sonnet, and optimized for noise by considering loading from the atmosphere and the CMB. Multiple 220 GHz detector modules have had their frequency response measured at the South Pole. The 270 GHz detector modules have recently begun testing in a lab setting, and their performance in a BA receiver will be measured this winter."},{"descriptionType":"Other","description":"6 pages, 8 figures"}],"geoLocations":[],"fundingReferences":[],"url":"https://arxiv.org/abs/2608.00324","contentUrl":null,"metadataVersion":0,"schemaVersion":"http://datacite.org/schema/kernel-4","source":"mds","isActive":true,"state":"findable","reason":null,"viewCount":0,"downloadCount":0,"referenceCount":0,"citationCount":0,"partCount":0,"partOfCount":0,"versionCount":0,"versionOfCount":1,"created":"2026-08-04T03:36:38Z","registered":"2026-08-04T03:36:39Z","published":null,"updated":"2026-08-04T03:36:39Z"},"relationships":{"client":{"data":{"id":"arxiv.content","type":"clients"}}}},{"id":"10.48550/arxiv.2608.00323","type":"dois","attributes":{"doi":"10.48550/arxiv.2608.00323","identifiers":[{"identifier":"2608.00323","identifierType":"arXiv"}],"creators":[{"nameType":"Personal","givenName":"Ken","familyName":"Ono","name":"Ono, Ken","affiliation":[],"nameIdentifiers":[]}],"titles":[{"title":"On a conjecture of Han and Xiong for fractional Gaussian binomial coefficients"}],"publisher":"arXiv","container":{},"publicationYear":2026,"subjects":[{"subject":"Combinatorics (math.CO)","lang":"en","subjectScheme":"arXiv"},{"subject":"FOS: Mathematics","subjectScheme":"Fields of Science and Technology (FOS)"},{"subject":"05A20, 11P84, 68V15, 68V20","lang":"en","subjectScheme":"MSC"}],"contributors":[],"dates":[{"date":"2026-07-31T22:23:29Z","dateType":"Submitted","dateInformation":"v1"},{"date":"2026-08-04T00:13:31Z","dateType":"Updated","dateInformation":"v1"},{"date":"2026-08","dateType":"Available","dateInformation":"v1"}],"language":null,"types":{"schemaOrg":"CreativeWork","resourceTypeGeneral":"Preprint","citeproc":"article","bibtex":"misc","ris":"GEN","resourceType":"Article"},"relatedIdentifiers":[],"relatedItems":[],"sizes":[],"formats":[],"version":"1","rightsList":[{"rightsIdentifierScheme":"SPDX","rightsUri":"https://creativecommons.org/publicdomain/zero/1.0/legalcode","schemeUri":"https://spdx.org/licenses/","rights":"Creative Commons Zero v1.0 Universal","rightsIdentifier":"cc0-1.0"}],"descriptions":[{"descriptionType":"Abstract","description":"Han and Xiong recently extended the Gaussian binomial coefficient $\\genfrac{[}{]}{0pt}{}{r+k}{k}_{q}$ to positive rational $r$ and conjectured that its integer trace, the integer-exponent part of the resulting power series, is coefficientwise largest at $r=1/2$. We prove a support-dominance theorem comparing rational parameters under an explicit divisibility condition. It settles the conjecture for every $r\\geq 1/2$ and reduces the full conjecture to the unit fractions $r=\\frac{1}{2m}$, only finitely many of which are nontrivial for each fixed $k$. A computer computation then verifies the conjecture for every positive rational $r$ and every $k\\leq 200$. The theoretical results were autonomously produced and verified in Lean by AxiomProver."},{"descriptionType":"Other","description":"Comments welcome"}],"geoLocations":[],"fundingReferences":[],"url":"https://arxiv.org/abs/2608.00323","contentUrl":null,"metadataVersion":0,"schemaVersion":"http://datacite.org/schema/kernel-4","source":"mds","isActive":true,"state":"findable","reason":null,"viewCount":0,"downloadCount":0,"referenceCount":0,"citationCount":0,"partCount":0,"partOfCount":0,"versionCount":0,"versionOfCount":0,"created":"2026-08-04T03:36:37Z","registered":"2026-08-04T03:36:37Z","published":null,"updated":"2026-08-04T03:36:37Z"},"relationships":{"client":{"data":{"id":"arxiv.content","type":"clients"}}}},{"id":"10.48550/arxiv.2608.00322","type":"dois","attributes":{"doi":"10.48550/arxiv.2608.00322","identifiers":[{"identifier":"2608.00322","identifierType":"arXiv"}],"creators":[{"nameType":"Personal","givenName":"Sparsh","familyName":"Roy","name":"Roy, Sparsh","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Vihan","familyName":"Aggarwal","name":"Aggarwal, Vihan","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Davin","familyName":"Yin","name":"Yin, Davin","affiliation":[],"nameIdentifiers":[]}],"titles":[{"title":"Belief-Space Perception Routing under Coupled Sensor Faults and Compute Contention"}],"publisher":"arXiv","container":{},"publicationYear":2026,"subjects":[{"subject":"Robotics (cs.RO)","lang":"en","subjectScheme":"arXiv"},{"subject":"Computer Vision and Pattern Recognition (cs.CV)","lang":"en","subjectScheme":"arXiv"},{"subject":"Systems and Control (eess.SY)","lang":"en","subjectScheme":"arXiv"},{"subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"},{"subject":"FOS: Electrical engineering, electronic engineering, information engineering","subjectScheme":"Fields of Science and Technology (FOS)"}],"contributors":[],"dates":[{"date":"2026-07-31T22:17:12Z","dateType":"Submitted","dateInformation":"v1"},{"date":"2026-08-04T00:13:13Z","dateType":"Updated","dateInformation":"v1"},{"date":"2026-08","dateType":"Available","dateInformation":"v1"}],"language":null,"types":{"schemaOrg":"CreativeWork","resourceTypeGeneral":"Preprint","citeproc":"article","bibtex":"misc","ris":"GEN","resourceType":"Article"},"relatedIdentifiers":[],"relatedItems":[],"sizes":[],"formats":[],"version":"1","rightsList":[{"rightsUri":"http://arxiv.org/licenses/nonexclusive-distrib/1.0/","rights":"arXiv.org perpetual, non-exclusive license"}],"descriptions":[{"descriptionType":"Abstract","description":"A robot that has to see and react on a fixed clock runs into two problems at once. Its cameras degrade in rain, mud, fog, and darkness. And the single onboard processor it runs on is shared with planning and control, so the compute left over for perception moves around from second to second. Most systems model the two separately. We present a perception router that tracks probabilistic estimates of sensor-fault state and compute- contention state, couples them with a noisy-OR term, and uses the coupled estimate to pick one of four detector configurations (YOLO11x/n at 1280 or 640 px) so that the frame finishes before its deadline. Where the two stressors co-occur, the coupled policy cuts the deadline-miss rate by 1.1 to 9.4 percentage points against a policy that treats them independently. The interval excludes zero in five of six conditions, the pooled effect over 10 sequences and 6 conditions has sign-test p = 0.001, and every uncoupled control and the fault-free trajectory sit at exactly 0.0 pp. Routing costs tens of microseconds per frame. We then asked whether the coupling the method exploits arises on its own. Across eight real RADIATE adverse-weather sequences and three workload proxies independent of the fault signal, after Benjamini-Hochberg correction and a replication run, none of 24 tests found it. We report that null and scope the routing result as a proof of mechanism. Whether such coupling occurs in the field is still open, and the released evaluation pipeline lets a deployment settle it on its own traces."},{"descriptionType":"Other","description":"Submitted to MIT URTC 2026"}],"geoLocations":[],"fundingReferences":[],"url":"https://arxiv.org/abs/2608.00322","contentUrl":null,"metadataVersion":0,"schemaVersion":"http://datacite.org/schema/kernel-4","source":"mds","isActive":true,"state":"findable","reason":null,"viewCount":0,"downloadCount":0,"referenceCount":0,"citationCount":0,"partCount":0,"partOfCount":0,"versionCount":0,"versionOfCount":0,"created":"2026-08-04T03:36:35Z","registered":"2026-08-04T03:36:36Z","published":null,"updated":"2026-08-04T03:36:36Z"},"relationships":{"client":{"data":{"id":"arxiv.content","type":"clients"}}}},{"id":"10.48550/arxiv.2608.00321","type":"dois","attributes":{"doi":"10.48550/arxiv.2608.00321","identifiers":[{"identifier":"2608.00321","identifierType":"arXiv"}],"creators":[{"nameType":"Personal","givenName":"Mihnea C.","familyName":"Moldoveanu","name":"Moldoveanu, Mihnea C.","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Joel A. C.","familyName":"Baum","name":"Baum, Joel A. C.","affiliation":[],"nameIdentifiers":[]}],"titles":[{"title":"Trust and Its Betrayal under Three Representational Strategies"}],"publisher":"arXiv","container":{},"publicationYear":2026,"subjects":[{"subject":"Artificial Intelligence (cs.AI)","lang":"en","subjectScheme":"arXiv"},{"subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"}],"contributors":[],"dates":[{"date":"2026-07-31T22:15:31Z","dateType":"Submitted","dateInformation":"v1"},{"date":"2026-08-04T00:13:10Z","dateType":"Updated","dateInformation":"v1"},{"date":"2026-08","dateType":"Available","dateInformation":"v1"}],"language":null,"types":{"schemaOrg":"CreativeWork","resourceTypeGeneral":"Preprint","citeproc":"article","bibtex":"misc","ris":"GEN","resourceType":"Article"},"relatedIdentifiers":[],"relatedItems":[],"sizes":[],"formats":[],"version":"1","rightsList":[{"rightsIdentifierScheme":"SPDX","rightsUri":"https://creativecommons.org/licenses/by-nc-sa/4.0/legalcode","schemeUri":"https://spdx.org/licenses/","rights":"Creative Commons Attribution Non Commercial Share Alike 4.0 International","rightsIdentifier":"cc-by-nc-sa-4.0"}],"descriptions":[{"descriptionType":"Abstract","description":"Trust is a propositional attitude of a distinctive kind: to trust is to rely on another under conditions where reliance could be disappointed, and the disappointment of trust---betrayal---differs qualitatively from the disappointment of a prediction. We treat trust as a \\emph{subjunctive} epistemic state: $A$ trusts $B$'s competence when $A$ believes that \\emph{were $P$ true, $B$ would know it}, and $B$'s integrity when $A$ believes that \\emph{were $B$ to know $P$, he would disclose it to $A$}. We develop three representations of this state---as lexicographic \\emph{assumption} as \\emph{ordinal closeness} in a Lewis--Stalnaker sphere system , and as \\emph{strong belief} in a conditional probability system and for each we ask whether the Brandenburger--Keisler impossibility on common belief survives when the assumption of rationality is replaced by an assumption of trustworthiness. The three representations agree that every \\emph{finite} depth of common trust is realizable while the \\emph{completed} common-trust fixed point is the locus of difficulty, but they differ sharply in \\emph{how} the difficulty manifests, and---our organizing finding---in how each survives a concrete betrayal. W show that the same betrayal refutes an agent's \\emph{level ordering} under the lexicographic representation, contaminates her \\emph{closeness ordering} in proportion to the betrayer's deliberateness under the ordinal representation, and merely \\emph{shifts her operative conditioning hypothesis} while leaving her belief structure coherent under the strong-belief representation."},{"descriptionType":"Other","description":"27 pages"}],"geoLocations":[],"fundingReferences":[],"url":"https://arxiv.org/abs/2608.00321","contentUrl":null,"metadataVersion":0,"schemaVersion":"http://datacite.org/schema/kernel-4","source":"mds","isActive":true,"state":"findable","reason":null,"viewCount":0,"downloadCount":0,"referenceCount":0,"citationCount":0,"partCount":0,"partOfCount":0,"versionCount":0,"versionOfCount":0,"created":"2026-08-04T03:36:34Z","registered":"2026-08-04T03:36:35Z","published":null,"updated":"2026-08-04T03:36:35Z"},"relationships":{"client":{"data":{"id":"arxiv.content","type":"clients"}}}},{"id":"10.48550/arxiv.2608.00320","type":"dois","attributes":{"doi":"10.48550/arxiv.2608.00320","identifiers":[{"identifier":"2608.00320","identifierType":"arXiv"}],"creators":[{"nameType":"Personal","givenName":"Sidhdharth D.","familyName":"Sikka","name":"Sikka, Sidhdharth D.","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Suyi","familyName":"Gao","name":"Gao, Suyi","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Zehui","familyName":"Lu","name":"Lu, Zehui","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Rongjie","familyName":"Lai","name":"Lai, Rongjie","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Shaoshuai","familyName":"Mou","name":"Mou, Shaoshuai","affiliation":[],"nameIdentifiers":[]}],"titles":[{"title":"Neural operator learning for collision-aware trajectory planning of spacecraft swarms"}],"publisher":"arXiv","container":{},"publicationYear":2026,"subjects":[{"subject":"Machine Learning (cs.LG)","lang":"en","subjectScheme":"arXiv"},{"subject":"Multiagent Systems (cs.MA)","lang":"en","subjectScheme":"arXiv"},{"subject":"Systems and Control (eess.SY)","lang":"en","subjectScheme":"arXiv"},{"subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"},{"subject":"FOS: Electrical engineering, electronic engineering, information engineering","subjectScheme":"Fields of Science and Technology (FOS)"}],"contributors":[],"dates":[{"date":"2026-07-31T22:10:47Z","dateType":"Submitted","dateInformation":"v1"},{"date":"2026-08-04T00:13:08Z","dateType":"Updated","dateInformation":"v1"},{"date":"2026-08","dateType":"Available","dateInformation":"v1"}],"language":null,"types":{"schemaOrg":"CreativeWork","resourceTypeGeneral":"Preprint","citeproc":"article","bibtex":"misc","ris":"GEN","resourceType":"Article"},"relatedIdentifiers":[],"relatedItems":[],"sizes":[],"formats":[],"version":"1","rightsList":[{"rightsUri":"http://arxiv.org/licenses/nonexclusive-distrib/1.0/","rights":"arXiv.org perpetual, non-exclusive license"}],"descriptions":[{"descriptionType":"Abstract","description":"Autonomous spacecraft swarms must plan fuel-efficient, collision-free maneuvers in increasingly congested orbits, yet classical trajectory optimization scales poorly as pairwise safety constraints multiply with swarm size, and learning-based planners rarely transfer across swarm sizes or debris densities. Here we introduce a permutation-equivariant neural operator that maps distributions of spacecraft, targets and debris to collision-aware trajectories for an entire swarm in a single forward pass, paired with a batched Gauss-Newton finish that enforces exact orbital dynamics. The operator is trained without optimal-trajectory labels, combining self-supervised physics objectives with adversarial threats generated against its own rollouts. Trained on ten spacecraft, it generalizes zero-shot to swarms of 1,000 amid more than 11,000 catalogued objects, matching a per-agent optimal-control solver's accuracy, evading worst-case threats that a debris-blind baseline cannot, and reducing proximity within the swarm several-fold. Physics-grounded operator learning thus offers a fast, scalable alternative to optimal control for crowded orbits."},{"descriptionType":"Other","description":"27 pages, 6 figures, 6 tables. Submitted to Nature Machine Intelligence. Video abstract included as ancillary file"}],"geoLocations":[],"fundingReferences":[],"url":"https://arxiv.org/abs/2608.00320","contentUrl":null,"metadataVersion":0,"schemaVersion":"http://datacite.org/schema/kernel-4","source":"mds","isActive":true,"state":"findable","reason":null,"viewCount":0,"downloadCount":0,"referenceCount":0,"citationCount":0,"partCount":0,"partOfCount":0,"versionCount":0,"versionOfCount":0,"created":"2026-08-04T03:36:32Z","registered":"2026-08-04T03:36:33Z","published":null,"updated":"2026-08-04T03:36:33Z"},"relationships":{"client":{"data":{"id":"arxiv.content","type":"clients"}}}},{"id":"10.48550/arxiv.2608.00319","type":"dois","attributes":{"doi":"10.48550/arxiv.2608.00319","identifiers":[{"identifier":"2608.00319","identifierType":"arXiv"}],"creators":[{"nameType":"Personal","givenName":"Zhaoxi","familyName":"Cao","name":"Cao, Zhaoxi","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Samuel","familyName":"Price","name":"Price, Samuel","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Alessandra","familyName":"Crippa","name":"Crippa, Alessandra","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"John P.","familyName":"Reidy","name":"Reidy, John P.","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Gianna M.","familyName":"Valentino","name":"Valentino, Gianna M.","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Ian","familyName":"McCue","name":"McCue, Ian","affiliation":[],"nameIdentifiers":[]}],"titles":[{"title":"Transient Liquid Phase Bonding of NiTi Using Cu- and Nb-base Interlayers"}],"publisher":"arXiv","container":{},"publicationYear":2026,"subjects":[{"subject":"Materials Science (cond-mat.mtrl-sci)","lang":"en","subjectScheme":"arXiv"},{"subject":"FOS: Physical sciences","subjectScheme":"Fields of Science and Technology (FOS)"}],"contributors":[],"dates":[{"date":"2026-07-31T22:10:10Z","dateType":"Submitted","dateInformation":"v1"},{"date":"2026-08-04T00:13:07Z","dateType":"Updated","dateInformation":"v1"},{"date":"2026-08","dateType":"Available","dateInformation":"v1"}],"language":null,"types":{"schemaOrg":"CreativeWork","resourceTypeGeneral":"Preprint","citeproc":"article","bibtex":"misc","ris":"GEN","resourceType":"Article"},"relatedIdentifiers":[],"relatedItems":[],"sizes":[],"formats":[],"version":"1","rightsList":[{"rightsIdentifierScheme":"SPDX","rightsUri":"https://creativecommons.org/licenses/by-nc-nd/4.0/legalcode","schemeUri":"https://spdx.org/licenses/","rights":"Creative Commons Attribution Non Commercial No Derivatives 4.0 International","rightsIdentifier":"cc-by-nc-nd-4.0"}],"descriptions":[{"descriptionType":"Abstract","description":"Transient liquid phase (TLP) bonding was examined as an approach for joining NiTi to achieve a high joint efficiency while minimizing chemical variance within the joint region. Two bonding interlayer chemistries (Cu-base and Nb-base) were identified by screening thermodynamic criteria for TLP in ternary alloys using the CALPHAD method. These two systems were then experimentally evaluated with respect to their impact on solidification kinetics, microstructure in the joint region, and performance during quasistatic and cyclic tensile loading. For both interlayer chemistries, the composition profile and microstructure in the joint region confirmed an isothermal solidification mechanism. In addition, the joints were found to be fully dense and contain at most 1.2% intermetallic phases. Tensile testing showed excellent load transfer across the joints with approximately 4% recoverable strain and martensite onset stresses reaching 94% and 89% of the unbonded, annealed NiTi values for Cu-base and Nb-base interlayers, respectively. Lastly, a stable superelastic response was observed under cyclic loading for both bond chemistries, with spatial variation in the strain evolution linked to enhanced stiffness and hardness in the joint region arising from the substitutional Cu and Nb solutes, as confirmed via nanoindentation. This study demonstrates that TLP bonding of NiTi can produce high-strength and nearly intermetallic-free joints without sacrificing functional performance, such as the superelastic response."},{"descriptionType":"Other","description":"25 pages, 11 figures, 7 tables"}],"geoLocations":[],"fundingReferences":[],"url":"https://arxiv.org/abs/2608.00319","contentUrl":null,"metadataVersion":0,"schemaVersion":"http://datacite.org/schema/kernel-4","source":"mds","isActive":true,"state":"findable","reason":null,"viewCount":0,"downloadCount":0,"referenceCount":0,"citationCount":0,"partCount":0,"partOfCount":0,"versionCount":0,"versionOfCount":0,"created":"2026-08-04T03:36:31Z","registered":"2026-08-04T03:36:32Z","published":null,"updated":"2026-08-04T03:36:32Z"},"relationships":{"client":{"data":{"id":"arxiv.content","type":"clients"}}}},{"id":"10.48550/arxiv.2608.00318","type":"dois","attributes":{"doi":"10.48550/arxiv.2608.00318","identifiers":[{"identifier":"2608.00318","identifierType":"arXiv"}],"creators":[{"nameType":"Personal","givenName":"C. Villarreal","familyName":"D'Angelo","name":"D'Angelo, C. Villarreal","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"M. P.","familyName":"Ronco","name":"Ronco, M. P.","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"M. R.","familyName":"Schreiber","name":"Schreiber, M. R.","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"O.","familyName":"Toloza","name":"Toloza, O.","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"A.","familyName":"Esquivel","name":"Esquivel, A.","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"B. T.","familyName":"Gänsicke","name":"Gänsicke, B. T.","affiliation":[],"nameIdentifiers":[]}],"titles":[{"title":"Planetary atmospheric escape and disk formation around WDJ0914+1914"}],"publisher":"arXiv","container":{},"publicationYear":2026,"subjects":[{"subject":"Earth and Planetary Astrophysics (astro-ph.EP)","lang":"en","subjectScheme":"arXiv"},{"subject":"Solar and Stellar Astrophysics (astro-ph.SR)","lang":"en","subjectScheme":"arXiv"},{"subject":"FOS: Physical sciences","subjectScheme":"Fields of Science and Technology (FOS)"}],"contributors":[],"dates":[{"date":"2026-07-31T22:10:06Z","dateType":"Submitted","dateInformation":"v1"},{"date":"2026-08-04T00:13:06Z","dateType":"Updated","dateInformation":"v1"},{"date":"2026-08","dateType":"Available","dateInformation":"v1"}],"language":null,"types":{"schemaOrg":"CreativeWork","resourceTypeGeneral":"Preprint","citeproc":"article","bibtex":"misc","ris":"GEN","resourceType":"Article"},"relatedIdentifiers":[],"relatedItems":[],"sizes":[],"formats":[],"version":"1","rightsList":[{"rightsIdentifierScheme":"SPDX","rightsUri":"https://creativecommons.org/licenses/by-nc-sa/4.0/legalcode","schemeUri":"https://spdx.org/licenses/","rights":"Creative Commons Attribution Non Commercial Share Alike 4.0 International","rightsIdentifier":"cc-by-nc-sa-4.0"}],"descriptions":[{"descriptionType":"Abstract","description":"The spectrum of the white dwarf WD J091405.30+191412.25 displays the absorption and double-peaked emission lines of the volatiles hydrogen, oxygen, and sulfur. This unique characteristic has been interpreted as evidence of this white dwarf accreting mass from a circumstellar disk that had formed from atmospheric material evaporating off a close-in Neptune-like or super-puff mass planet. Thus far, however, the orbital separation of the planet and its mass-loss rate have only been estimated using simple analytical approximations. We investigate this scenario using 3D radiative-hydrodynamic simulations of irradiated hydrogen atmospheres together with 1D viscous disk evolution models. We compute atmospheric escape from Neptune-like and super-puff planets exposed to extreme ultraviolet (XUV) radiation of the white dwarf at different orbital separations and follow the evolution of the escaping gas after it forms a circumstellar disk. The simulations yield planetary mass-loss rates of $(1.8-4)x10^{12}$ g/s. The injected material forms a gaseous disk that reaches a quasi-steady state in less than $10^5$ through the balance between continuous mass supply and viscous accretion onto the white dwarf. The resulting accretion rates are consistent with observational estimates. In contrast to previous interpretations, our models predict that the disk extends beyond the planetary orbit. We conclude that a gas-rich planet orbiting at 15 solar radii undergoes sustained photoevaporation and naturally produces a circumstellar disk capable of reproducing the observed accretion rates and spectral signatures of WD J0914+1914. These results provide strong support for the evaporating-planet scenario and offer new constraints on the structure and extent of the circumstellar disk."}],"geoLocations":[],"fundingReferences":[],"url":"https://arxiv.org/abs/2608.00318","contentUrl":null,"metadataVersion":0,"schemaVersion":"http://datacite.org/schema/kernel-4","source":"mds","isActive":true,"state":"findable","reason":null,"viewCount":0,"downloadCount":0,"referenceCount":0,"citationCount":0,"partCount":0,"partOfCount":0,"versionCount":0,"versionOfCount":0,"created":"2026-08-04T03:36:30Z","registered":"2026-08-04T03:36:30Z","published":null,"updated":"2026-08-04T03:36:30Z"},"relationships":{"client":{"data":{"id":"arxiv.content","type":"clients"}}}},{"id":"10.48550/arxiv.2608.00317","type":"dois","attributes":{"doi":"10.48550/arxiv.2608.00317","identifiers":[{"identifier":"2608.00317","identifierType":"arXiv"}],"creators":[{"nameType":"Personal","givenName":"Emmanuel M.","familyName":"Rockwell","name":"Rockwell, Emmanuel M.","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Michael R.","familyName":"Kosorok","name":"Kosorok, Michael R.","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Nikki L. B.","familyName":"Freeman","name":"Freeman, Nikki L. B.","affiliation":[],"nameIdentifiers":[]}],"titles":[{"title":"Backward Bayesian Outcome Weighted Learning"}],"publisher":"arXiv","container":{},"publicationYear":2026,"subjects":[{"subject":"Methodology (stat.ME)","lang":"en","subjectScheme":"arXiv"},{"subject":"Machine Learning (stat.ML)","lang":"en","subjectScheme":"arXiv"},{"subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"},{"subject":"62F15, 62C10, 62H30, 62P10","lang":"en","subjectScheme":"MSC"}],"contributors":[],"dates":[{"date":"2026-07-31T22:07:29Z","dateType":"Submitted","dateInformation":"v1"},{"date":"2026-08-04T00:13:06Z","dateType":"Updated","dateInformation":"v1"},{"date":"2026-08","dateType":"Available","dateInformation":"v1"}],"language":null,"types":{"schemaOrg":"CreativeWork","resourceTypeGeneral":"Preprint","citeproc":"article","bibtex":"misc","ris":"GEN","resourceType":"Article"},"relatedIdentifiers":[],"relatedItems":[],"sizes":[],"formats":[],"version":"1","rightsList":[{"rightsUri":"http://arxiv.org/licenses/nonexclusive-distrib/1.0/","rights":"arXiv.org perpetual, non-exclusive license"}],"descriptions":[{"descriptionType":"Abstract","description":"A central objective of precision medicine is learning optimal dynamic treatment regimes (DTRs) from data. Classification-based methods, like outcome weighted learning (OWL) for single-stage and backward OWL (BOWL) for multi-stage problems, leverage machine learning to directly learn optimal DTRs. However, these methods lack a natural way to quantify uncertainty in treatment decisions at the individual level. In this paper, we extend Bayesian OWL, a Bayesian reformulation of OWL, to the multi-stage setting. We call this method backward Bayesian outcome weighted learning (BBOWL). Like BOWL, our method directly learns an optimal DTR via backward induction, and unlike existing methods, our approach propagates uncertainty backward through the DTR learning process and provides uncertainty quantification of individualized treatment recommendations. We present a theoretical justification of BBOWL and verify its performance via a simulation study."},{"descriptionType":"Other","description":"9 pages, 3 figures, 1 table"}],"geoLocations":[],"fundingReferences":[],"url":"https://arxiv.org/abs/2608.00317","contentUrl":null,"metadataVersion":0,"schemaVersion":"http://datacite.org/schema/kernel-4","source":"mds","isActive":true,"state":"findable","reason":null,"viewCount":0,"downloadCount":0,"referenceCount":0,"citationCount":0,"partCount":0,"partOfCount":0,"versionCount":0,"versionOfCount":0,"created":"2026-08-04T03:36:28Z","registered":"2026-08-04T03:36:29Z","published":null,"updated":"2026-08-04T03:36:29Z"},"relationships":{"client":{"data":{"id":"arxiv.content","type":"clients"}}}},{"id":"10.48550/arxiv.2608.00315","type":"dois","attributes":{"doi":"10.48550/arxiv.2608.00315","identifiers":[{"identifier":"2608.00315","identifierType":"arXiv"}],"creators":[{"nameType":"Personal","givenName":"Ihab","familyName":"Tabbara","name":"Tabbara, Ihab","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Yuxuan","familyName":"Yang","name":"Yang, Yuxuan","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Hussein","familyName":"Sibai","name":"Sibai, Hussein","affiliation":[],"nameIdentifiers":[]}],"titles":[{"title":"Towards General Language-Conditioned Latent Safety Filters"}],"publisher":"arXiv","container":{},"publicationYear":2026,"subjects":[{"subject":"Robotics (cs.RO)","lang":"en","subjectScheme":"arXiv"},{"subject":"Machine Learning (cs.LG)","lang":"en","subjectScheme":"arXiv"},{"subject":"Systems and Control (eess.SY)","lang":"en","subjectScheme":"arXiv"},{"subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"},{"subject":"FOS: Electrical engineering, electronic engineering, information engineering","subjectScheme":"Fields of Science and Technology (FOS)"}],"contributors":[],"dates":[{"date":"2026-07-31T22:00:35Z","dateType":"Submitted","dateInformation":"v1"},{"date":"2026-08-04T00:12:56Z","dateType":"Updated","dateInformation":"v1"},{"date":"2026-08","dateType":"Available","dateInformation":"v1"}],"language":null,"types":{"schemaOrg":"CreativeWork","resourceTypeGeneral":"Preprint","citeproc":"article","bibtex":"misc","ris":"GEN","resourceType":"Article"},"relatedIdentifiers":[],"relatedItems":[],"sizes":[],"formats":[],"version":"1","rightsList":[{"rightsIdentifierScheme":"SPDX","rightsUri":"https://creativecommons.org/licenses/by/4.0/legalcode","schemeUri":"https://spdx.org/licenses/","rights":"Creative Commons Attribution 4.0 International","rightsIdentifier":"cc-by-4.0"}],"descriptions":[{"descriptionType":"Abstract","description":"Robot policies are becoming increasingly general, with vision-language-action (VLA) models enabling a single policy to execute diverse tasks specified in natural language. Safe deployment, however, requires adapting not only to new tasks but also to varying safety requirements across users, environments, and applications. Existing safety filters remain largely constraint-specific and thus must be redesigned or relearned when safety requirements change. In this paper, we investigate language-conditioned safety filtering, in which a Hamilton-Jacobi safety actor and critic are conditioned on language-specified constraints. We evaluate this formulation across pick-and-place, table-wiping, and block-stacking tasks in the vision-based setting, examining its ability to enforce language-specified constraints and transfer to unseen constraint instances within the evaluated constraint families. Our experiments provide evidence that language-conditioned safety filters reduce constraint violations and exhibit partial transfer to unseen constraint instances."}],"geoLocations":[],"fundingReferences":[],"url":"https://arxiv.org/abs/2608.00315","contentUrl":null,"metadataVersion":0,"schemaVersion":"http://datacite.org/schema/kernel-4","source":"mds","isActive":true,"state":"findable","reason":null,"viewCount":0,"downloadCount":0,"referenceCount":0,"citationCount":0,"partCount":0,"partOfCount":0,"versionCount":0,"versionOfCount":0,"created":"2026-08-04T03:36:25Z","registered":"2026-08-04T03:36:26Z","published":null,"updated":"2026-08-04T03:36:26Z"},"relationships":{"client":{"data":{"id":"arxiv.content","type":"clients"}}}},{"id":"10.48550/arxiv.2608.00313","type":"dois","attributes":{"doi":"10.48550/arxiv.2608.00313","identifiers":[{"identifier":"2608.00313","identifierType":"arXiv"}],"creators":[{"nameType":"Personal","givenName":"Ivana","familyName":"Randelshofer","name":"Randelshofer, Ivana","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Joseph","familyName":"Tu","name":"Tu, Joseph","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Yifan","familyName":"Cao","name":"Cao, Yifan","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Reza H.","familyName":"Mogavi","name":"Mogavi, Reza H.","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Ville","familyName":"Mäkelä","name":"Mäkelä, Ville","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Lennart E.","familyName":"Nacke","name":"Nacke, Lennart E.","affiliation":[],"nameIdentifiers":[]}],"titles":[{"title":"Theory, Experience, and Instinct: A Glimpse Into AAA Game Processes and How UX Leaders Navigate Pre-Production"}],"publisher":"arXiv","container":{},"publicationYear":2026,"subjects":[{"subject":"Human-Computer Interaction (cs.HC)","lang":"en","subjectScheme":"arXiv"},{"subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"}],"contributors":[],"dates":[{"date":"2026-07-31T21:51:26Z","dateType":"Submitted","dateInformation":"v1"},{"date":"2026-08-04T00:12:38Z","dateType":"Updated","dateInformation":"v1"},{"date":"2026-08","dateType":"Available","dateInformation":"v1"}],"language":null,"types":{"schemaOrg":"CreativeWork","resourceTypeGeneral":"Preprint","citeproc":"article","bibtex":"misc","ris":"GEN","resourceType":"Article"},"relatedIdentifiers":[],"relatedItems":[],"sizes":[],"formats":[],"version":"1","rightsList":[{"rightsIdentifierScheme":"SPDX","rightsUri":"https://creativecommons.org/licenses/by/4.0/legalcode","schemeUri":"https://spdx.org/licenses/","rights":"Creative Commons Attribution 4.0 International","rightsIdentifier":"cc-by-4.0"}],"descriptions":[{"descriptionType":"Abstract","description":"Foundational decisions shape a project's long-term trajectory, a dynamic that becomes especially evident in the inherent complexity of game pre-production. However, academic frameworks often see limited uptake at this stage, as they do not readily map onto industry contexts, production constraints, and cross-functional workflows. To better understand how design decisions are made in practice, we conducted interviews with 15 UX leaders from the AAA (triple-A) games industry. Our findings show that early UX decisions emerge from a dynamic blend of theory, experience, and intuition. In cross-functional structures (such as strike and competency teams), UX leaders collaboratively align player needs, technical feasibility, and creative vision. These decision-making processes involve translating academic concepts into production-ready insights, codifying experiential knowledge into reusable practices, and relying on informed intuition amid uncertainty. We argue that meaningful impact requires academia to develop malleable conceptual tools that integrate with practitioners' highly adaptive design processes. We conclude by discussing how existing frameworks might be adapted to connect academic insights with AAA workflows. Rather than prescriptive directives, we offer these as starting points for discussion that support strike and competency teams through shared language, reusable design systems, and strategies for collaborative, context-sensitive decision-making."}],"geoLocations":[],"fundingReferences":[],"url":"https://arxiv.org/abs/2608.00313","contentUrl":null,"metadataVersion":0,"schemaVersion":"http://datacite.org/schema/kernel-4","source":"mds","isActive":true,"state":"findable","reason":null,"viewCount":0,"downloadCount":0,"referenceCount":0,"citationCount":0,"partCount":0,"partOfCount":0,"versionCount":0,"versionOfCount":0,"created":"2026-08-04T03:36:23Z","registered":"2026-08-04T03:36:23Z","published":null,"updated":"2026-08-04T03:36:23Z"},"relationships":{"client":{"data":{"id":"arxiv.content","type":"clients"}}}},{"id":"10.48550/arxiv.2608.00312","type":"dois","attributes":{"doi":"10.48550/arxiv.2608.00312","identifiers":[{"identifier":"2608.00312","identifierType":"arXiv"}],"creators":[{"nameType":"Personal","givenName":"Sophie A","familyName":"Lloyd","name":"Lloyd, Sophie A","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Ehsan","familyName":"Nasiri","name":"Nasiri, Ehsan","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Allaire F","familyName":"Doussan","name":"Doussan, Allaire F","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Ryan J","familyName":"Halter","name":"Halter, Ryan J","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Ethan K","familyName":"Murphy","name":"Murphy, Ethan K","affiliation":[],"nameIdentifiers":[]}],"titles":[{"title":"Fused electrical impedance tomography using an electromagnetically tracked handheld probe for oral cancer margin assessment: reconstruction methods and phantom validation"}],"publisher":"arXiv","container":{},"publicationYear":2026,"subjects":[{"subject":"Image and Video Processing (eess.IV)","lang":"en","subjectScheme":"arXiv"},{"subject":"Signal Processing (eess.SP)","lang":"en","subjectScheme":"arXiv"},{"subject":"FOS: Electrical engineering, electronic engineering, information engineering","subjectScheme":"Fields of Science and Technology (FOS)"}],"contributors":[],"dates":[{"date":"2026-07-31T21:48:09Z","dateType":"Submitted","dateInformation":"v1"},{"date":"2026-08-04T00:12:37Z","dateType":"Updated","dateInformation":"v1"},{"date":"2026-08","dateType":"Available","dateInformation":"v1"}],"language":null,"types":{"schemaOrg":"CreativeWork","resourceTypeGeneral":"Preprint","citeproc":"article","bibtex":"misc","ris":"GEN","resourceType":"Article"},"relatedIdentifiers":[],"relatedItems":[],"sizes":[],"formats":[],"version":"1","rightsList":[{"rightsUri":"http://arxiv.org/licenses/nonexclusive-distrib/1.0/","rights":"arXiv.org perpetual, non-exclusive license"}],"descriptions":[{"descriptionType":"Abstract","description":"Objective: Positive margins in oral squamous cell carcinoma (OSCC) resection are common and significantly impact patient outcomes. Electrical impedance tomography (EIT) can be used to intraoperatively distinguish cancer from healthy tissue. The objective of this study was to develop and identify a fused EIT approach to accurately reconstruct a tumor boundary using multiple impedance measurements recorded with a handheld electrical impedance probe. Approach: Simulations and noise analyses were used to investigate the best reconstruction method for fused EIT, and a measured phantom experiment was conducted to evaluate the EIT reconstructions. Main results: Fused approaches successfully and accurately recovered the conductivity boundary location from multiple probe sites, increasing boundary localization to within 0.5 mm of the true boundary for both simulated and experimental results. Simulations and noise analysis revealed that all reconstruction methods maintain strong classification accuracy with added noise on a half-plane boundary scenario and fused difference EIT is the most robust to all types of added noise, due to the high data redundancy in the reconstruction formulation. Significance: The measured multi-site probe experiments represent important steps in the development of an approach that can combine EIT from multiple locations to increase boundary localization accuracy. Overall, this result is a step towards a clinically deployable impedance imaging approach to scanning the entire tumor boundary, which could significantly help to improve surgical outcomes for OSCC."},{"descriptionType":"Other","description":"16 pages, 6 figures, submitted to Physiological Measurements journal"}],"geoLocations":[],"fundingReferences":[],"url":"https://arxiv.org/abs/2608.00312","contentUrl":null,"metadataVersion":0,"schemaVersion":"http://datacite.org/schema/kernel-4","source":"mds","isActive":true,"state":"findable","reason":null,"viewCount":0,"downloadCount":0,"referenceCount":0,"citationCount":0,"partCount":0,"partOfCount":0,"versionCount":0,"versionOfCount":0,"created":"2026-08-04T03:36:21Z","registered":"2026-08-04T03:36:22Z","published":null,"updated":"2026-08-04T03:36:22Z"},"relationships":{"client":{"data":{"id":"arxiv.content","type":"clients"}}}},{"id":"10.48550/arxiv.2608.00311","type":"dois","attributes":{"doi":"10.48550/arxiv.2608.00311","identifiers":[{"identifier":"2608.00311","identifierType":"arXiv"}],"creators":[{"nameType":"Personal","givenName":"Maryam","familyName":"Haghifam","name":"Haghifam, Maryam","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Jason","familyName":"Cong","name":"Cong, Jason","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Yizhou","familyName":"Sun","name":"Sun, Yizhou","affiliation":[],"nameIdentifiers":[]}],"titles":[{"title":"SeD