{"nameType":"Personal","givenName":"Kirtesh","familyName":"Patil","name":"Patil, Kirtesh","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Minh","familyName":"Pham","name":"Pham, Minh","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Amin","familyName":"Qassoud","name":"Qassoud, Amin","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Ashwin","familyName":"Ramachandran","name":"Ramachandran, Ashwin","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"David Ramon","familyName":"Prados","name":"Prados, David Ramon","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Pallavi","familyName":"Shurpali","name":"Shurpali, Pallavi","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Gregory R.","familyName":"Steinbrecher","name":"Steinbrecher, Gregory R.","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"John","familyName":"Sundharam","name":"Sundharam, John","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Vangelis","familyName":"Tasoulas","name":"Tasoulas, Vangelis","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Fuhou","familyName":"Tian","name":"Tian, Fuhou","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Srinivas","familyName":"Vaidyanathan","name":"Vaidyanathan, Srinivas","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Vimal","familyName":"Vasudevan","name":"Vasudevan, Vimal","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Nicolaas","familyName":"Viljoen","name":"Viljoen, Nicolaas","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Daniel","familyName":"Winkelman","name":"Winkelman, Daniel","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Yijing","familyName":"Zeng","name":"Zeng, Yijing","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Zhaoqi","familyName":"Zhu","name":"Zhu, Zhaoqi","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Stig Arne","familyName":"Olsen","name":"Olsen, Stig Arne","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Gilad","familyName":"Goldfarb","name":"Goldfarb, Gilad","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Rajiv","familyName":"Krishnamurthy","name":"Krishnamurthy, Rajiv","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Rajeev","familyName":"Nair","name":"Nair, Rajeev","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Jonas","familyName":"Olsson","name":"Olsson, Jonas","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Joseph","familyName":"Provine","name":"Provine, Joseph","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Sreeram","familyName":"Ravinoothala","name":"Ravinoothala, Sreeram","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Shivayogi","familyName":"Ugaji","name":"Ugaji, Shivayogi","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Hongyi","familyName":"Zeng","name":"Zeng, Hongyi","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Nairan","familyName":"Zhang","name":"Zhang, Nairan","affiliation":[],"nameIdentifiers":[]}],"titles":[{"title":"HCCL: Collective Communication for Meta Training and Inference Accelerators"}],"publisher":"arXiv","container":{},"publicationYear":2026,"subjects":[{"subject":"Networking and Internet Architecture (cs.NI)","lang":"en","subjectScheme":"arXiv"},{"subject":"Distributed, Parallel, and Cluster Computing (cs.DC)","lang":"en","subjectScheme":"arXiv"},{"subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"}],"contributors":[],"dates":[{"date":"2026-08-01T00:14:41Z","dateType":"Submitted","dateInformation":"v1"},{"date":"2026-08-04T00:15:03Z","dateType":"Updated","dateInformation":"v1"},{"date":"2026-08","dateType":"Available","dateInformation":"v1"}],"language":null,"types":{"schemaOrg":"CreativeWork","resourceTypeGeneral":"Preprint","citeproc":"article","bibtex":"misc","ris":"GEN","resourceType":"Article"},"relatedIdentifiers":[],"relatedItems":[],"sizes":[],"formats":[],"version":"1","rightsList":[{"rightsUri":"http://arxiv.org/licenses/nonexclusive-distrib/1.0/","rights":"arXiv.org perpetual, non-exclusive license"}],"descriptions":[{"descriptionType":"Abstract","description":"We present HCCL, a collective communication library co-designed with Meta's MTIA 300 accelerator, the first Meta chip to integrate backend networking directly on chip package. MTIA 300 includes dedicated message engines (MEs) with near-memory compute (NMC) that fully offload collective execution from the compute grid, enabling large overlap between computation and communication. HCCL uses a compiled communication model in which the host generates a complete description of each collective including dependencies. We describe the control and data path architecture, topology-aware algorithm selection across MTIA 300's asymmetric scale-up and scale-out network, and optimizations for both training and inference workloads. For training, HCCL achieves up to 940 GB/s on intra-rack collectives while introducing less than 0.5% degradation to concurrent compute throughput. For inference, we leverage one-sided communication primitives that bypass the scheduling path to minimize collective latency and describe collective designs that improve compute-communication pipelining for latency-sensitive workloads."},{"descriptionType":"Other","description":"12 pages, 17 figures, to be published in the proceedings of \"SC '26: Proceedings of the International Conference for High Performance Computing, Networking, Storage and Analysis\""}],"geoLocations":[],"fundingReferences":[],"url":"https://arxiv.org/abs/2608.00358","contentUrl":null,"metadataVersion":0,"schemaVersion":"http://datacite.org/schema/kernel-4","source":"mds","isActive":true,"state":"findable","reason":null,"viewCount":0,"downloadCount":0,"referenceCount":0,"citationCount":0,"partCount":0,"partOfCount":0,"versionCount":0,"versionOfCount":0,"created":"2026-08-04T03:37:25Z","registered":"2026-08-04T03:37:26Z","published":null,"updated":"2026-08-04T03:37:26Z"},"relationships":{"client":{"data":{"id":"arxiv.content","type":"clients"}}}},{"id":"10.48550/arxiv.2608.00357","type":"dois","attributes":{"doi":"10.48550/arxiv.2608.00357","identifiers":[{"identifier":"2608.00357","identifierType":"arXiv"}],"creators":[{"nameType":"Personal","givenName":"Kehua","familyName":"Lei","name":"Lei, Kehua","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Aidan","familyName":"Ladenburg","name":"Ladenburg, Aidan","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Zahra","familyName":"Petiwala","name":"Petiwala, Zahra","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Zili","familyName":"Wang","name":"Wang, Zili","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Dishita","familyName":"Jhawar","name":"Jhawar, Dishita","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Ipsita","familyName":"Bisht","name":"Bisht, Ipsita","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Ansh","familyName":"Kumar","name":"Kumar, Ansh","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"David T.","familyName":"Lee","name":"Lee, David T.","affiliation":[],"nameIdentifiers":[]}],"titles":[{"title":"Dynamic Surveys: Using LLMs to Blend Qualitative Depth,Quantitative Structure, and Collaborative Interaction"}],"publisher":"arXiv","container":{},"publicationYear":2026,"subjects":[{"subject":"Human-Computer Interaction (cs.HC)","lang":"en","subjectScheme":"arXiv"},{"subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"},{"subject":"H.5.2; H.5.3","lang":"en","subjectScheme":"ACM"}],"contributors":[],"dates":[{"date":"2026-08-01T00:03:18Z","dateType":"Submitted","dateInformation":"v1"},{"date":"2026-08-04T00:15:02Z","dateType":"Updated","dateInformation":"v1"},{"date":"2026-08","dateType":"Available","dateInformation":"v1"}],"language":null,"types":{"schemaOrg":"CreativeWork","resourceTypeGeneral":"Preprint","citeproc":"article","bibtex":"misc","ris":"GEN","resourceType":"Article"},"relatedIdentifiers":[{"relationType":"IsVersionOf","relatedIdentifier":"10.1145/3757586","relatedIdentifierType":"DOI"}],"relatedItems":[],"sizes":[],"formats":[],"version":"1","rightsList":[{"rightsUri":"http://arxiv.org/licenses/nonexclusive-distrib/1.0/","rights":"arXiv.org perpetual, non-exclusive license"}],"descriptions":[{"descriptionType":"Abstract","description":"Surveys are a powerful tool for collecting data and eliciting insights on social phenomena, and are critical in product design, marketing, scientific research. However, traditional open-ended and closed-ended question formats limit researchers' ability to capture data that combines both the richness of qualitative insights and the analytical rigor of quantitative data. To address these problems, we propose Dynamic Surveys, a survey platform that uses Large Language Models (LLMs) to dynamically cluster qualitative responses in real time and to elicit quantitative ratings and rankings on those clusters and qualitative reflections on how their views compare to broader respondent trends, especially helpful in early-stage or exploratory research settings. This process generates a report showing survey creators and respondents the clustered responses as well as each cluster's rank, rating distribution, and follow-up reflections. To evaluate Dynamic Surveys, we conducted two field studies with 93 participants over a 2-month period. In the first study, 52 students provided input for a career workshop, while in the second, 41 students gave feedback on gaps in their academic curriculum. Of these, 44 respondents filled out a survey on their experience using Dynamic Surveys. We also shared the generated report with 4 individuals who were interested in the insights for their work, and interviewed them to understand their perspectives on the results and any contextual risks they saw in the platform design. Our findings suggest that Dynamic Surveys not only provide richer and deeper insights into responses compared with traditional survey tools, but also increase engagement and foster a sense of community. We discuss broader implications for the design of survey platforms that blend qualitative depth with quantitative structure, facilitating richer insights and offering more collaborative interactions."},{"descriptionType":"Other","description":"27 pages, 6 figures"}],"geoLocations":[],"fundingReferences":[],"url":"https://arxiv.org/abs/2608.00357","contentUrl":null,"metadataVersion":0,"schemaVersion":"http://datacite.org/schema/kernel-4","source":"mds","isActive":true,"state":"findable","reason":null,"viewCount":0,"downloadCount":0,"referenceCount":0,"citationCount":0,"partCount":0,"partOfCount":0,"versionCount":0,"versionOfCount":1,"created":"2026-08-04T03:37:23Z","registered":"2026-08-04T03:37:24Z","published":null,"updated":"2026-08-04T03:37:24Z"},"relationships":{"client":{"data":{"id":"arxiv.content","type":"clients"}}}},{"id":"10.48550/arxiv.2608.00356","type":"dois","attributes":{"doi":"10.48550/arxiv.2608.00356","identifiers":[{"identifier":"2608.00356","identifierType":"arXiv"}],"creators":[{"nameType":"Personal","givenName":"Boyi","familyName":"Li","name":"Li, Boyi","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Yifan","familyName":"Shen","name":"Shen, Yifan","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Houze","familyName":"Yang","name":"Yang, Houze","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Xu","familyName":"Cao","name":"Cao, Xu","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Guojun","familyName":"Yun","name":"Yun, Guojun","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Li","familyName":"Gao","name":"Gao, Li","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Turong","familyName":"Chen","name":"Chen, Turong","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Long","familyName":"Xu","name":"Xu, Long","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Jianguo","familyName":"Cao","name":"Cao, Jianguo","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Meihuan","familyName":"Huang","name":"Huang, Meihuan","affiliation":[],"nameIdentifiers":[]}],"titles":[{"title":"The 1st AI Children Challenge"}],"publisher":"arXiv","container":{},"publicationYear":2026,"subjects":[{"subject":"Computer Vision and Pattern Recognition (cs.CV)","lang":"en","subjectScheme":"arXiv"},{"subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"}],"contributors":[],"dates":[{"date":"2026-08-01T00:02:21Z","dateType":"Submitted","dateInformation":"v1"},{"date":"2026-08-04T00:15:00Z","dateType":"Updated","dateInformation":"v1"},{"date":"2026-08","dateType":"Available","dateInformation":"v1"}],"language":null,"types":{"schemaOrg":"CreativeWork","resourceTypeGeneral":"Preprint","citeproc":"article","bibtex":"misc","ris":"GEN","resourceType":"Article"},"relatedIdentifiers":[],"relatedItems":[],"sizes":[],"formats":[],"version":"1","rightsList":[{"rightsIdentifierScheme":"SPDX","rightsUri":"https://creativecommons.org/licenses/by/4.0/legalcode","schemeUri":"https://spdx.org/licenses/","rights":"Creative Commons Attribution 4.0 International","rightsIdentifier":"cc-by-4.0"}],"descriptions":[{"descriptionType":"Abstract","description":"The First AI Children Challenge aims to advance real-world applications of computer vision and AI in child healthcare, child education, and pediatrics. The 2026 CV4CHL edition featured the first track in this domain: Children Gait Visual Analysis. The main goal of Children Gait Visual Analysis is the fine-grained analysis of children's gait behaviors from keypoint sequences. This is still a big challenge for human action recognition. Experienced medical doctors can distinguish these subtle nuances, but none of the people test AI models in this domain. To bridge this gap, we introduce thousands of 2D children keypoint sequences walking around videos across various age groups of children (3-16 years old). There is a significant opportunity for batch analysis of these videos to provide clinically relevant insights into medical diagnosis. The Challenge will be launched with two problem tracks: Edinburgh Visual Gait Score (EVGS) Scoring and Classification of Gait Patterns in Bilateral Spastic Cerebral Palsy. Each track is chosen in consultation with board-certified pediatricians based on the value of potential solutions. With the first available dataset for such tasks and ground truth for each track, the challenge enabled participants to evaluate their solutions. Final rankings will be revealed after the competition concludes, fostering reproducibility and mitigating overfitting."}],"geoLocations":[],"fundingReferences":[],"url":"https://arxiv.org/abs/2608.00356","contentUrl":null,"metadataVersion":0,"schemaVersion":"http://datacite.org/schema/kernel-4","source":"mds","isActive":true,"state":"findable","reason":null,"viewCount":0,"downloadCount":0,"referenceCount":0,"citationCount":0,"partCount":0,"partOfCount":0,"versionCount":0,"versionOfCount":0,"created":"2026-08-04T03:37:22Z","registered":"2026-08-04T03:37:23Z","published":null,"updated":"2026-08-04T03:37:23Z"},"relationships":{"client":{"data":{"id":"arxiv.content","type":"clients"}}}},{"id":"10.48550/arxiv.2608.00355","type":"dois","attributes":{"doi":"10.48550/arxiv.2608.00355","identifiers":[{"identifier":"2608.00355","identifierType":"arXiv"}],"creators":[{"nameType":"Personal","givenName":"Hanwen","familyName":"Xing","name":"Xing, Hanwen","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Pengyun","familyName":"Wang","name":"Wang, Pengyun","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"BingXu","familyName":"Meng","name":"Meng, BingXu","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Kumail","familyName":"Alhamoud","name":"Alhamoud, Kumail","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Xiang","familyName":"Li","name":"Li, Xiang","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Jicheng","familyName":"Wang","name":"Wang, Jicheng","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Xin","familyName":"Yu","name":"Yu, Xin","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Xinyang","familyName":"Han","name":"Han, Xinyang","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Xiaomin","familyName":"Li","name":"Li, Xiaomin","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Philip","familyName":"Torr","name":"Torr, Philip","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Yuexing","familyName":"Hao","name":"Hao, Yuexing","affiliation":[],"nameIdentifiers":[]}],"titles":[{"title":"CurveShift: Is Agent Progress Scalar? Separating Level from Shape"}],"publisher":"arXiv","container":{},"publicationYear":2026,"subjects":[{"subject":"Computation and Language (cs.CL)","lang":"en","subjectScheme":"arXiv"},{"subject":"Machine Learning (cs.LG)","lang":"en","subjectScheme":"arXiv"},{"subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"},{"subject":"I.2.7; I.2.6; G.3","lang":"en","subjectScheme":"ACM"}],"contributors":[],"dates":[{"date":"2026-07-31T23:58:25Z","dateType":"Submitted","dateInformation":"v1"},{"date":"2026-08-04T00:14:59Z","dateType":"Updated","dateInformation":"v1"},{"date":"2026-08","dateType":"Available","dateInformation":"v1"}],"language":null,"types":{"schemaOrg":"CreativeWork","resourceTypeGeneral":"Preprint","citeproc":"article","bibtex":"misc","ris":"GEN","resourceType":"Article"},"relatedIdentifiers":[],"relatedItems":[],"sizes":[],"formats":[],"version":"1","rightsList":[{"rightsIdentifierScheme":"SPDX","rightsUri":"https://creativecommons.org/licenses/by/4.0/legalcode","schemeUri":"https://spdx.org/licenses/","rights":"Creative Commons Attribution 4.0 International","rightsIdentifier":"cc-by-4.0"}],"descriptions":[{"descriptionType":"Abstract","description":"Progress in large language models is often summarized using a single scalar measure, such as a time horizon, a latent ability estimate, or an aggregate benchmark score. These summaries capture the overall performance, but they do not test whether progress is distributed differently across task difficulty. We find that most of the apparent shift in gains toward harder tasks does not reflect a change in the shape of the difficulty-response curve. On METR time-horizon data, a single Rasch model with rising ability reproduces this pattern, so it is largely explained by ceiling effects rather than a qualitative change in capability. This echoes how the choice of metric can make claimed emergent abilities look like a property of the models themselves. We then identify a smaller hard-task effect that survives this control. Isolating it is difficult on agentic benchmarks, because newer models are usually run with newer agentic harnesses, so a gain on hard tasks cannot be assigned to the model or its scaffold. We break the confound with LiveCodeBench, a public competitive programming benchmark that runs no agentic scaffold while pairing dated models with an exogenous difficulty ordering. After accounting for the rise in overall ability, models released after September 2024 still gain on the hardest problems beyond what their easy and medium performance predicts, by about +0.40 logits under our most conservative assumption, raising the hard-problem solve rate from roughly 18% to 25%. The effect is led by the strongest reasoning models and holds for hard tasks that need only short reasoning, not autonomy over long horizons. We present this as a result specific to competitive programming, since our clean identification rests on a single coding benchmark. We release the LiveCodeBench Difficulty Panel (66 dated models x 1,055 problems) and our analysis code."},{"descriptionType":"Other","description":"25 pages, 4 figures, 7 tables. Data and code: https://github.com/harvenstar/CurveShift"}],"geoLocations":[],"fundingReferences":[],"url":"https://arxiv.org/abs/2608.00355","contentUrl":null,"metadataVersion":0,"schemaVersion":"http://datacite.org/schema/kernel-4","source":"mds","isActive":true,"state":"findable","reason":null,"viewCount":0,"downloadCount":0,"referenceCount":0,"citationCount":0,"partCount":0,"partOfCount":0,"versionCount":0,"versionOfCount":0,"created":"2026-08-04T03:37:20Z","registered":"2026-08-04T03:37:21Z","published":null,"updated":"2026-08-04T03:37:21Z"},"relationships":{"client":{"data":{"id":"arxiv.content","type":"clients"}}}},{"id":"10.48550/arxiv.2608.00354","type":"dois","attributes":{"doi":"10.48550/arxiv.2608.00354","identifiers":[{"identifier":"2608.00354","identifierType":"arXiv"}],"creators":[{"nameType":"Personal","givenName":"Michael","familyName":"Bottom","name":"Bottom, Michael","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Gustav","familyName":"Pettersson","name":"Pettersson, Gustav","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Pavaman","familyName":"Bilgi","name":"Bilgi, Pavaman","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Guillaume","familyName":"Huber","name":"Huber, Guillaume","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Charles-Antoine","familyName":"Claveau","name":"Claveau, Charles-Antoine","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Nathan","familyName":"Lourie","name":"Lourie, Nathan","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Robert","familyName":"Simcoe","name":"Simcoe, Robert","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Shane","familyName":"Jacobson","name":"Jacobson, Shane","affiliation":[],"nameIdentifiers":[]}],"titles":[{"title":"Fundamental Noise Limits of Infrared Detectors in the Presence of Readout Glow"}],"publisher":"arXiv","container":{},"publicationYear":2026,"subjects":[{"subject":"Instrumentation and Methods for Astrophysics (astro-ph.IM)","lang":"en","subjectScheme":"arXiv"},{"subject":"Instrumentation and Detectors (physics.ins-det)","lang":"en","subjectScheme":"arXiv"},{"subject":"FOS: Physical sciences","subjectScheme":"Fields of Science and Technology (FOS)"}],"contributors":[],"dates":[{"date":"2026-07-31T23:49:36Z","dateType":"Submitted","dateInformation":"v1"},{"date":"2026-08-04T00:14:58Z","dateType":"Updated","dateInformation":"v1"},{"date":"2026-08","dateType":"Available","dateInformation":"v1"}],"language":null,"types":{"schemaOrg":"CreativeWork","resourceTypeGeneral":"Preprint","citeproc":"article","bibtex":"misc","ris":"GEN","resourceType":"Article"},"relatedIdentifiers":[],"relatedItems":[],"sizes":[],"formats":[],"version":"1","rightsList":[{"rightsUri":"http://arxiv.org/licenses/nonexclusive-distrib/1.0/","rights":"arXiv.org perpetual, non-exclusive license"}],"descriptions":[{"descriptionType":"Abstract","description":"Read noise in infrared sensor arrays remains a major obstacle for ground- and space-based astronomy. It has long been recognized that the upcoming extremely large telescopes cannot meet their full potential unless read noise is significantly improved, and it is also a prohibitive constraint on the Habitable Worlds Observatory, a space telescope with the goal of detection and characterization of nearby Earth-like exoplanets.\n The main strategy for lowering read noise is averaging through multiple non-destructive reads. However, this typically results in less noise reduction than the 1/$\\sqrt{N}$ scaling predicted by theory. In this work, we show the poor averaging behavior can largely be explained by readout glow, photon emission from the sensor electronics that generates photoelectrons in the pixels during readout. Because glow accumulates with reads rather than averaging, this imposes a fundamental noise floor of σ_{\\rm min} ~ 1.5 sigma_RN^(1/2)G^(1/4). This limits averaging in HxRG-like sensors to about 2-3 e- of noise, and linear-mode avalanche photodiodes (LmAPDs) to about 0.5 e-. We present laboratory data using both sensor architectures, with the LmAPD following the predicted noise value to within 0.1 e- over two decades of averaging."},{"descriptionType":"Other","description":"Proceedings of the SPIE Astronomical Telescopes + Instrumentation. 19 pages"}],"geoLocations":[],"fundingReferences":[],"url":"https://arxiv.org/abs/2608.00354","contentUrl":null,"metadataVersion":0,"schemaVersion":"http://datacite.org/schema/kernel-4","source":"mds","isActive":true,"state":"findable","reason":null,"viewCount":0,"downloadCount":0,"referenceCount":0,"citationCount":0,"partCount":0,"partOfCount":0,"versionCount":0,"versionOfCount":0,"created":"2026-08-04T03:37:19Z","registered":"2026-08-04T03:37:20Z","published":null,"updated":"2026-08-04T03:37:20Z"},"relationships":{"client":{"data":{"id":"arxiv.content","type":"clients"}}}},{"id":"10.48550/arxiv.2608.00353","type":"dois","attributes":{"doi":"10.48550/arxiv.2608.00353","identifiers":[{"identifier":"2608.00353","identifierType":"arXiv"}],"creators":[{"nameType":"Personal","givenName":"Hyunwoo","familyName":"Kang","name":"Kang, Hyunwoo","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Geonwoo","familyName":"Yu","name":"Yu, Geonwoo","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Jongwon","familyName":"Kim","name":"Kim, Jongwon","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Seungwoo","familyName":"You","name":"You, Seungwoo","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Minchan","familyName":"Gil","name":"Gil, Minchan","affiliation":[],"nameIdentifiers":[]}],"titles":[{"title":"Analyzing RV32/RV64 Trade-offs for FreeRTOS Latency on 8-Stage RISC-V Soft Processors"}],"publisher":"arXiv","container":{},"publicationYear":2026,"subjects":[{"subject":"Hardware Architecture (cs.AR)","lang":"en","subjectScheme":"arXiv"},{"subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"},{"subject":"C.1.0; B.7.1","lang":"en","subjectScheme":"ACM"}],"contributors":[],"dates":[{"date":"2026-07-31T23:48:03Z","dateType":"Submitted","dateInformation":"v1"},{"date":"2026-08-04T00:14:57Z","dateType":"Updated","dateInformation":"v1"},{"date":"2026-08","dateType":"Available","dateInformation":"v1"}],"language":null,"types":{"schemaOrg":"CreativeWork","resourceTypeGeneral":"Preprint","citeproc":"article","bibtex":"misc","ris":"GEN","resourceType":"Article"},"relatedIdentifiers":[],"relatedItems":[],"sizes":[],"formats":[],"version":"1","rightsList":[{"rightsUri":"http://arxiv.org/licenses/nonexclusive-distrib/1.0/","rights":"arXiv.org perpetual, non-exclusive license"}],"descriptions":[{"descriptionType":"Abstract","description":"Although many commercial RISC-V platforms provide real-time operating system support, practical examples that explain how to enable a preemptive RTOS on a custom bare-metal RISC-V soft processor remain limited, leaving the interaction between processor microarchitecture, interrupt handling, and RTOS context switching difficult to understand from simple hardware implementation examples. This paper presents the design and evaluation of FreeRTOS on custom 8-stage RV32/RV64 RISC-V soft processors with machine-mode CSRs, a CLINT timer, trap and exception control logic, and the required context-switch path. Using this platform, we compare RV32 and RV64 under the same microarchitectural organization and firmware structure using two Rhealstone-derived latency microbenchmarks, task switching and task preemption, measured with the mcycle counter. RV64 requires 36.6% and 17.7% more cycles for task switching and preemption, respectively. Instruction-level analysis attributes this overhead to the doubled RV64 trap frame, wider pointer-based kernel data structures, and 64-bit scheduler priority handling. The RTL, firmware, and benchmark code are released as open source."},{"descriptionType":"Other","description":"5 pages, 1 figure. Accepted for presentation at APCCAS 2026; to be presented on October 26, 2026"}],"geoLocations":[],"fundingReferences":[],"url":"https://arxiv.org/abs/2608.00353","contentUrl":null,"metadataVersion":0,"schemaVersion":"http://datacite.org/schema/kernel-4","source":"mds","isActive":true,"state":"findable","reason":null,"viewCount":0,"downloadCount":0,"referenceCount":0,"citationCount":0,"partCount":0,"partOfCount":0,"versionCount":0,"versionOfCount":0,"created":"2026-08-04T03:37:18Z","registered":"2026-08-04T03:37:18Z","published":null,"updated":"2026-08-04T03:37:18Z"},"relationships":{"client":{"data":{"id":"arxiv.content","type":"clients"}}}},{"id":"10.48550/arxiv.2608.00352","type":"dois","attributes":{"doi":"10.48550/arxiv.2608.00352","identifiers":[{"identifier":"2608.00352","identifierType":"arXiv"}],"creators":[{"nameType":"Personal","givenName":"Ruochen","familyName":"Wang","name":"Wang, Ruochen","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Xiaoli","familyName":"Bai","name":"Bai, Xiaoli","affiliation":[],"nameIdentifiers":[]}],"titles":[{"title":"A Machine-Learning-Based Global Thermospheric Density Forecasting Model"}],"publisher":"arXiv","container":{},"publicationYear":2026,"subjects":[{"subject":"Space Physics (physics.space-ph)","lang":"en","subjectScheme":"arXiv"},{"subject":"Geophysics (physics.geo-ph)","lang":"en","subjectScheme":"arXiv"},{"subject":"FOS: Physical sciences","subjectScheme":"Fields of Science and Technology (FOS)"}],"contributors":[],"dates":[{"date":"2026-07-31T23:43:50Z","dateType":"Submitted","dateInformation":"v1"},{"date":"2026-08-04T00:14:56Z","dateType":"Updated","dateInformation":"v1"},{"date":"2026-08","dateType":"Available","dateInformation":"v1"}],"language":null,"types":{"schemaOrg":"CreativeWork","resourceTypeGeneral":"Preprint","citeproc":"article","bibtex":"misc","ris":"GEN","resourceType":"Article"},"relatedIdentifiers":[{"relationType":"IsVersionOf","relatedIdentifier":"10.1029/2026sw004968","relatedIdentifierType":"DOI"}],"relatedItems":[],"sizes":[],"formats":[],"version":"1","rightsList":[{"rightsIdentifierScheme":"SPDX","rightsUri":"https://creativecommons.org/licenses/by/4.0/legalcode","schemeUri":"https://spdx.org/licenses/","rights":"Creative Commons Attribution 4.0 International","rightsIdentifier":"cc-by-4.0"}],"descriptions":[{"descriptionType":"Abstract","description":"Thermospheric mass density governs aerodynamic drag in low Earth orbit and is a primary source of uncertainty in orbit prediction and conjunction assessment, particularly during geomagnetic disturbances. We present AETHER-P3 (Accelerometer-driven Estimation of THERmospheric density-A Physics-Informed Probabilistic Prediction Platform), a machine-learning-based global thermospheric density forecasting model that provides multi-step forecasts up to 6 hr ahead using a 3-hr input window, with predictive uncertainty estimates. AETHER-P3 formulates thermospheric density forecasting as a sequence-to-sequence regression task conditioned on recent space weather evolution and a user-specified sequence of future times and locations. To enhance physical consistency and generalization, AETHER-P3 incorporates JB2008 and NRLMSISE-00 density estimates evaluated at future locations, along with solar, geomagnetic, and solar-wind drivers. The network employs dual recurrent encoders and an evidential Normal-Gamma output head to jointly estimate forecast mean and uncertainty. The model is evaluated using independent satellite test cases spanning quiet, moderate, and extreme geomagnetic conditions. During quiet periods, AETHER-P3 achieves high forecast skill (R=0.95). Under moderate activity, strong skill is retained (R=0.93), with reduced physical-domain errors than empirical baseline models. During extreme storm conditions, deterministic forecast skill degrades as expected yet remains robust (R=0.89-0.90). Predictive uncertainty remains well calibrated across all regimes. These results establish AETHER-P3 as a practical, low-latency, uncertainty-aware capability for thermospheric density forecasting that supports orbit prediction, drag-risk assessment, and operational decision-making over its validated altitude range of approximately 300-520 km, with highest confidence in the data-rich 400-520 km region."}],"geoLocations":[],"fundingReferences":[],"url":"https://arxiv.org/abs/2608.00352","contentUrl":null,"metadataVersion":0,"schemaVersion":"http://datacite.org/schema/kernel-4","source":"mds","isActive":true,"state":"findable","reason":null,"viewCount":0,"downloadCount":0,"referenceCount":0,"citationCount":0,"partCount":0,"partOfCount":0,"versionCount":0,"versionOfCount":1,"created":"2026-08-04T03:37:16Z","registered":"2026-08-04T03:37:17Z","published":null,"updated":"2026-08-04T03:37:17Z"},"relationships":{"client":{"data":{"id":"arxiv.content","type":"clients"}}}},{"id":"10.48550/arxiv.2608.00351","type":"dois","attributes":{"doi":"10.48550/arxiv.2608.00351","identifiers":[{"identifier":"2608.00351","identifierType":"arXiv"}],"creators":[{"nameType":"Personal","givenName":"Chenhao","familyName":"Chu","name":"Chu, Chenhao","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Masoud","familyName":"Pashaeifar","name":"Pashaeifar, Masoud","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Filippo","familyName":"Svelto","name":"Svelto, Filippo","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Hua","familyName":"Wang","name":"Wang, Hua","affiliation":[],"nameIdentifiers":[]}],"titles":[{"title":"VSWR-Resilient Mm-Wave and Cm-Wave PAs for Large-Scale Phased Arrays"}],"publisher":"arXiv","container":{},"publicationYear":2026,"subjects":[{"subject":"Signal Processing (eess.SP)","lang":"en","subjectScheme":"arXiv"},{"subject":"FOS: Electrical engineering, electronic engineering, information engineering","subjectScheme":"Fields of Science and Technology (FOS)"}],"contributors":[],"dates":[{"date":"2026-07-31T23:37:37Z","dateType":"Submitted","dateInformation":"v1"},{"date":"2026-08-04T00:14:44Z","dateType":"Updated","dateInformation":"v1"},{"date":"2026-08","dateType":"Available","dateInformation":"v1"}],"language":null,"types":{"schemaOrg":"CreativeWork","resourceTypeGeneral":"Preprint","citeproc":"article","bibtex":"misc","ris":"GEN","resourceType":"Article"},"relatedIdentifiers":[],"relatedItems":[],"sizes":[],"formats":[],"version":"1","rightsList":[{"rightsUri":"http://arxiv.org/licenses/nonexclusive-distrib/1.0/","rights":"arXiv.org perpetual, non-exclusive license"}],"descriptions":[{"descriptionType":"Abstract","description":"Large-scale mm-Wave and cm-Wave phased arrays have become central to wireless communication and sensing systems, including terrestrial 5G/6G links and base stations, non-terrestrial networks (NTNs), satellite communication (SATCOM), radar, and relay applications. In dense arrays, power amplifiers (PAs) and antenna array interact with each other: array radiation depends on the amplitude/phase of PA output signals, while the load impedance experienced by each PA varies with frequency, scan angle, and element position. This active antenna impedance, described as voltage standing wave ratio (VSWR) variation, arises mainly from antenna inter-element mutual coupling and is shaped by package/interconnect parasitics. Each PA can deviate from its optimum large-signal operating condition, degrading output power, power gain, power-added efficiency, AM-AM/AM-PM, and reliability margin. These variations further affect array EIRP consistency, EVM headroom, link budget, thermal density, and beamforming calibration, complicating PA design for wideband, wide-scan-angle arrays. This review introduces the origins of antenna VSWR and antenna-PA interactions connecting the antenna reflection coefficient $Γ_{\\mathrm{ant}}$ and PA output matching $S_{22}$ to delivered-power and transmitted-phase variation through the $S_{22}Γ_{\\mathrm{ant}}$ dependence. Reverse-coupled excitation and reverse intermodulation distortion (RIMD) are discussed. This motivates PA designs that achieve simultaneous output and loadline matching (SOLM), enabling a small output reflection coefficient $|S_{22}|$ without significantly compromising large-signal performance. Recent mm-Wave and cm-Wave VSWR-resilient integrated PA techniques and demonstrations are reviewed. Finally, challenges and opportunities for compact, load-insensitive, energy-efficient, high-power-density, and calibration-scalable integrated PAs are discussed."},{"descriptionType":"Other","description":"Review article. 20 pages, 28 figures"}],"geoLocations":[],"fundingReferences":[],"url":"https://arxiv.org/abs/2608.00351","contentUrl":null,"metadataVersion":0,"schemaVersion":"http://datacite.org/schema/kernel-4","source":"mds","isActive":true,"state":"findable","reason":null,"viewCount":0,"downloadCount":0,"referenceCount":0,"citationCount":0,"partCount":0,"partOfCount":0,"versionCount":0,"versionOfCount":0,"created":"2026-08-04T03:37:15Z","registered":"2026-08-04T03:37:15Z","published":null,"updated":"2026-08-04T03:37:15Z"},"relationships":{"client":{"data":{"id":"arxiv.content","type":"clients"}}}},{"id":"10.48550/arxiv.2608.00350","type":"dois","attributes":{"doi":"10.48550/arxiv.2608.00350","identifiers":[{"identifier":"2608.00350","identifierType":"arXiv"}],"creators":[{"nameType":"Personal","givenName":"Jun-ichi","familyName":"Tanaka","name":"Tanaka, Jun-ichi","affiliation":[],"nameIdentifiers":[]}],"titles":[{"title":"On Hoffman's characterization theorem of parts"}],"publisher":"arXiv","container":{},"publicationYear":2026,"subjects":[{"subject":"Complex Variables (math.CV)","lang":"en","subjectScheme":"arXiv"},{"subject":"Functional Analysis (math.FA)","lang":"en","subjectScheme":"arXiv"},{"subject":"FOS: Mathematics","subjectScheme":"Fields of Science and Technology (FOS)"},{"subject":"Primary 43A17, Secondary 46J10, 46J15, 28D10","lang":"en","subjectScheme":"MSC"}],"contributors":[],"dates":[{"date":"2026-07-31T23:37:01Z","dateType":"Submitted","dateInformation":"v1"},{"date":"2026-08-04T00:14:43Z","dateType":"Updated","dateInformation":"v1"},{"date":"2026-08","dateType":"Available","dateInformation":"v1"}],"language":null,"types":{"schemaOrg":"CreativeWork","resourceTypeGeneral":"Preprint","citeproc":"article","bibtex":"misc","ris":"GEN","resourceType":"Article"},"relatedIdentifiers":[],"relatedItems":[],"sizes":[],"formats":[],"version":"1","rightsList":[{"rightsIdentifierScheme":"SPDX","rightsUri":"https://creativecommons.org/licenses/by/4.0/legalcode","schemeUri":"https://spdx.org/licenses/","rights":"Creative Commons Attribution 4.0 International","rightsIdentifier":"cc-by-4.0"}],"descriptions":[{"descriptionType":"Abstract","description":"Let $H^\\infty(Δ)$ be the uniform algebra of bounded analytic functions on the open unit disc $Δ$, and let $\\mathfrak{M}(H^\\infty)$ be the maximal ideal space of $H^\\infty(Δ)$. Applying Wermer's embedding theorem directly, we investigate the relation between the analytic structure in $\\mathfrak{M}(H^\\infty)$ and certain separability conditions. Our method rests only on the corona theorem and certain properties of analytic discs. Among other things, without deep factorization theorems on Blaschke products, we derive the famous Hoffman theorem: Let $P(ξ)$ be the Gleason part of $ξ$ in $\\mathfrak{M}(H^\\infty)$. Then $P(ξ)$ is an analytic disc if and only if $ξ$ lies in the closure in $\\mathfrak{M}(H^\\infty)$ of an interpolating sequence in $Δ$."},{"descriptionType":"Other","description":"15 pages"}],"geoLocations":[],"fundingReferences":[],"url":"https://arxiv.org/abs/2608.00350","contentUrl":null,"metadataVersion":0,"schemaVersion":"http://datacite.org/schema/kernel-4","source":"mds","isActive":true,"state":"findable","reason":null,"viewCount":0,"downloadCount":0,"referenceCount":0,"citationCount":0,"partCount":0,"partOfCount":0,"versionCount":0,"versionOfCount":0,"created":"2026-08-04T03:37:13Z","registered":"2026-08-04T03:37:14Z","published":null,"updated":"2026-08-04T03:37:14Z"},"relationships":{"client":{"data":{"id":"arxiv.content","type":"clients"}}}},{"id":"10.48550/arxiv.2608.00348","type":"dois","attributes":{"doi":"10.48550/arxiv.2608.00348","identifiers":[{"identifier":"2608.00348","identifierType":"arXiv"}],"creators":[{"nameType":"Personal","givenName":"Yu-Sheng","familyName":"Liu","name":"Liu, Yu-Sheng","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Yu-Chen","familyName":"Tung","name":"Tung, Yu-Chen","affiliation":[],"nameIdentifiers":[]}],"titles":[{"title":"Physics-Constrained Generative Inference of Sub-Crystal Electromagnetic Shower Structure in a Segmented Calorimeter"}],"publisher":"arXiv","container":{},"publicationYear":2026,"subjects":[{"subject":"Instrumentation and Detectors (physics.ins-det)","lang":"en","subjectScheme":"arXiv"},{"subject":"High Energy Physics - Experiment (hep-ex)","lang":"en","subjectScheme":"arXiv"},{"subject":"FOS: Physical sciences","subjectScheme":"Fields of Science and Technology (FOS)"}],"contributors":[],"dates":[{"date":"2026-07-31T23:32:19Z","dateType":"Submitted","dateInformation":"v1"},{"date":"2026-08-04T00:14:35Z","dateType":"Updated","dateInformation":"v1"},{"date":"2026-08","dateType":"Available","dateInformation":"v1"}],"language":null,"types":{"schemaOrg":"CreativeWork","resourceTypeGeneral":"Preprint","citeproc":"article","bibtex":"misc","ris":"GEN","resourceType":"Article"},"relatedIdentifiers":[],"relatedItems":[],"sizes":[],"formats":[],"version":"1","rightsList":[{"rightsUri":"http://arxiv.org/licenses/nonexclusive-distrib/1.0/","rights":"arXiv.org perpetual, non-exclusive license"}],"descriptions":[{"descriptionType":"Abstract","description":"The finite transverse granularity of a segmented electromagnetic calorimeter fundamentally limits the precision with which the observables of a shower can be reconstructed, among them its position, its lateral profile, and the direction of the incident particle. We show that a substantial fraction of the information suppressed by the segmentation can be inferred under physical constraints, and that it propagates to downstream physics quantities. The reconstruction is cast as an inverse problem and solved with a generative model constrained by the low-order spatial moments of the shower, driving the solution toward physically consistent energy distributions rather than image similarity alone. Using the undoped CsI calorimeter of the KOTO experiment as a reference system, the reconstruction reduces the per-event residual of these moments with respect to the truth-level reference by roughly 40-62% in a representative 1 GeV bin. The inferred morphology also generalizes beyond the training objective: on a $K_{L}\\toπ^{0}ν\\barν$ Monte Carlo sample it improves the reconstruction of the photon incident angle, a quantity never used during training, and of the $π^{0}$ decay vertex. These results indicate that finite segmentation is better viewed as a limit on what a calorimeter measures directly than as an absolute limit on the physics information it retains, with the recoverable fraction depending on the observable and growing with the shower energy."}],"geoLocations":[],"fundingReferences":[],"url":"https://arxiv.org/abs/2608.00348","contentUrl":null,"metadataVersion":0,"schemaVersion":"http://datacite.org/schema/kernel-4","source":"mds","isActive":true,"state":"findable","reason":null,"viewCount":0,"downloadCount":0,"referenceCount":0,"citationCount":0,"partCount":0,"partOfCount":0,"versionCount":0,"versionOfCount":0,"created":"2026-08-04T03:37:11Z","registered":"2026-08-04T03:37:12Z","published":null,"updated":"2026-08-04T03:37:12Z"},"relationships":{"client":{"data":{"id":"arxiv.content","type":"clients"}}}},{"id":"10.48550/arxiv.2608.00347","type":"dois","attributes":{"doi":"10.48550/arxiv.2608.00347","identifiers":[{"identifier":"2608.00347","identifierType":"arXiv"}],"creators":[{"nameType":"Personal","givenName":"Kevin","familyName":"Calderon","name":"Calderon, Kevin","affiliation":[],"nameIdentifiers":[]}],"titles":[{"title":"Ljunggren--Jacobsthal and Bailey-Type Congruences for Rectangular Gaussian Binomial Coefficients"}],"publisher":"arXiv","container":{},"publicationYear":2026,"subjects":[{"subject":"Number Theory (math.NT)","lang":"en","subjectScheme":"arXiv"},{"subject":"FOS: Mathematics","subjectScheme":"Fields of Science and Technology (FOS)"}],"contributors":[],"dates":[{"date":"2026-07-31T23:29:17Z","dateType":"Submitted","dateInformation":"v1"},{"date":"2026-08-04T00:14:34Z","dateType":"Updated","dateInformation":"v1"},{"date":"2026-08","dateType":"Available","dateInformation":"v1"}],"language":null,"types":{"schemaOrg":"CreativeWork","resourceTypeGeneral":"Preprint","citeproc":"article","bibtex":"misc","ris":"GEN","resourceType":"Article"},"relatedIdentifiers":[],"relatedItems":[],"sizes":[],"formats":[],"version":"1","rightsList":[{"rightsIdentifierScheme":"SPDX","rightsUri":"https://creativecommons.org/licenses/by/4.0/legalcode","schemeUri":"https://spdx.org/licenses/","rights":"Creative Commons Attribution 4.0 International","rightsIdentifier":"cc-by-4.0"}],"descriptions":[{"descriptionType":"Abstract","description":"Motivated by the polynomial form of Kalinin's Gaussian analogue of Wolstenholme's theorem, following Kalinin, we study a two-dimensional factorial ratio over the Gaussian integers, which we call the rectangular Gaussian binomial coefficient. For a rational prime $p\\equiv 3\\pmod 4$, we first prove that these coefficients are $p$-integral. Our main result is a Ljunggren--Jacobsthal-type supercongruence: for $p\u0026gt;5$ and every $k\\geq 1$, simultaneous dilation of all four parameters by $p^k$ changes the coefficient by a multiple of $p^{3k}$. In particular, this proves the inert-prime case of a conjecture of Kalinin. We also establish a rectangular Bailey-type congruence modulo $p$ for parameters consisting of a large $p$-multiple and one base-$p$ digit. Its shape parallels Bailey's prime-power refinements of Lucas's theorem, but two additional ordinary binomial factors occur, reflecting the vertical and horizontal boundary strips of a rectangular block decomposition. The proofs combine reciprocal-power-sum estimates in $\\mathbb{Z}_p[i]$ with factorizations of rectangular products into complete $p^k\\times p^k$ blocks."}],"geoLocations":[],"fundingReferences":[],"url":"https://arxiv.org/abs/2608.00347","contentUrl":null,"metadataVersion":0,"schemaVersion":"http://datacite.org/schema/kernel-4","source":"mds","isActive":true,"state":"findable","reason":null,"viewCount":0,"downloadCount":0,"referenceCount":0,"citationCount":0,"partCount":0,"partOfCount":0,"versionCount":0,"versionOfCount":0,"created":"2026-08-04T03:37:10Z","registered":"2026-08-04T03:37:10Z","published":null,"updated":"2026-08-04T03:37:10Z"},"relationships":{"client":{"data":{"id":"arxiv.content","type":"clients"}}}},{"id":"10.48550/arxiv.2608.00346","type":"dois","attributes":{"doi":"10.48550/arxiv.2608.00346","identifiers":[{"identifier":"2608.00346","identifierType":"arXiv"}],"creators":[{"nameType":"Personal","givenName":"Pulock","familyName":"Das","name":"Das, Pulock","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Yina","familyName":"Hou","name":"Hou, Yina","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Md. Kamrozzaman","familyName":"Bhuiyan","name":"Bhuiyan, Md. Kamrozzaman","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Manar D.","familyName":"Samad","name":"Samad, Manar D.","affiliation":[],"nameIdentifiers":[]}],"titles":[{"title":"Ensemble of Unsupervised Deep Learning for Clustering Imbalanced Tabular Data"}],"publisher":"arXiv","container":{},"publicationYear":2026,"subjects":[{"subject":"Machine Learning (cs.LG)","lang":"en","subjectScheme":"arXiv"},{"subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"}],"contributors":[],"dates":[{"date":"2026-07-31T23:28:11Z","dateType":"Submitted","dateInformation":"v1"},{"date":"2026-08-04T00:14:33Z","dateType":"Updated","dateInformation":"v1"},{"date":"2026-08","dateType":"Available","dateInformation":"v1"}],"language":null,"types":{"schemaOrg":"CreativeWork","resourceTypeGeneral":"Preprint","citeproc":"article","bibtex":"misc","ris":"GEN","resourceType":"Article"},"relatedIdentifiers":[],"relatedItems":[],"sizes":[],"formats":[],"version":"1","rightsList":[{"rightsIdentifierScheme":"SPDX","rightsUri":"https://creativecommons.org/licenses/by-sa/4.0/legalcode","schemeUri":"https://spdx.org/licenses/","rights":"Creative Commons Attribution Share Alike 4.0 International","rightsIdentifier":"cc-by-sa-4.0"}],"descriptions":[{"descriptionType":"Abstract","description":"Data imbalance poses a major challenge in supervised classification, where the majority-class bias contributes to false negatives and overestimates classification accuracy. Unsupervised deep clustering can be immune to class imbalance because representation learning for clustering is performed without class labels. Deep clustering has been proposed for images, languages, and graphs, while its application to tabular data has only emerged recently. This paper is among the first to examine the performance of state-of-the-art deep clustering methods under varying levels of data imbalance. We introduce two novel cluster ensemble approaches: one aggregates deep clustering assignments across different embedding dimensions, and the other applies majority voting to the best-performing clustering algorithms. Experiments on 16 binary tabular datasets with varying and artificially induced levels of imbalance reveal distinct strengths of different deep clustering methods. On average, our ensemble methods outperform individual clustering methods in ACC, NMI, and ARI scores, offering greater resilience to data imbalance when identifying ground-truth classes without supervision. Therefore, in an imbalanced data scenario, deep clustering can serve as a strong alternative to supervised classification."}],"geoLocations":[],"fundingReferences":[],"url":"https://arxiv.org/abs/2608.00346","contentUrl":null,"metadataVersion":0,"schemaVersion":"http://datacite.org/schema/kernel-4","source":"mds","isActive":true,"state":"findable","reason":null,"viewCount":0,"downloadCount":0,"referenceCount":0,"citationCount":0,"partCount":0,"partOfCount":0,"versionCount":0,"versionOfCount":0,"created":"2026-08-04T03:37:08Z","registered":"2026-08-04T03:37:09Z","published":null,"updated":"2026-08-04T03:37:09Z"},"relationships":{"client":{"data":{"id":"arxiv.content","type":"clients"}}}},{"id":"10.48550/arxiv.2608.00345","type":"dois","attributes":{"doi":"10.48550/arxiv.2608.00345","identifiers":[{"identifier":"2608.00345","identifierType":"arXiv"}],"creators":[{"nameType":"Personal","givenName":"Renjie","familyName":"Liang","name":"Liang, Renjie","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Zijian","familyName":"Xu","name":"Xu, Zijian","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Jinqian","familyName":"Pan","name":"Pan, Jinqian","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Chengkun","familyName":"Sun","name":"Sun, Chengkun","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Zhengkang","familyName":"Fan","name":"Fan, Zhengkang","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Shawn","familyName":"Li","name":"Li, Shawn","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"You","familyName":"Qin","name":"Qin, You","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Mei","familyName":"Liu","name":"Liu, Mei","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Jie","familyName":"Xu","name":"Xu, Jie","affiliation":[],"nameIdentifiers":[]}],"titles":[{"title":"ORCA: ORgan-Centroid Aggregation for Training-Free 3D CT Visual Token Compression"}],"publisher":"arXiv","container":{},"publicationYear":2026,"subjects":[{"subject":"Computer Vision and Pattern Recognition (cs.CV)","lang":"en","subjectScheme":"arXiv"},{"subject":"Artificial Intelligence (cs.AI)","lang":"en","subjectScheme":"arXiv"},{"subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"}],"contributors":[],"dates":[{"date":"2026-07-31T23:27:39Z","dateType":"Submitted","dateInformation":"v1"},{"date":"2026-08-04T00:14:32Z","dateType":"Updated","dateInformation":"v1"},{"date":"2026-08","dateType":"Available","dateInformation":"v1"}],"language":null,"types":{"schemaOrg":"CreativeWork","resourceTypeGeneral":"Preprint","citeproc":"article","bibtex":"misc","ris":"GEN","resourceType":"Article"},"relatedIdentifiers":[],"relatedItems":[],"sizes":[],"formats":[],"version":"1","rightsList":[{"rightsIdentifierScheme":"SPDX","rightsUri":"https://creativecommons.org/licenses/by/4.0/legalcode","schemeUri":"https://spdx.org/licenses/","rights":"Creative Commons Attribution 4.0 International","rightsIdentifier":"cc-by-4.0"}],"descriptions":[{"descriptionType":"Abstract","description":"A 3D CT scan entering a vision-language model produces a long sequence of visual tokens, often thousands to tens of thousands per volume, and this sequence must be compressed before a language model can consume it. Token compression is well studied in general vision, but little of it targets 3D CT specifically. A common baseline is grid average, which pools regular grid cells and can blend distinct anatomy, lesion, and air into one token. We present \\textbf{ORCA} (ORgan-Centroid Aggregation), a token compressor for 3D CT. It merges adjacent tokens with organ guidance and adds a sinusoidal encoding of each region's centroid to preserve spatial layout. This preserves the anatomical information a downstream model needs. ORCA is training-free and plug-and-play, producing an adjustable token set without any model change or text query. We evaluate it across two datasets (CT-RATE and Merlin) and five encoders. The evaluation spans two task types: attribute prediction over five families (size, density, location, texture, and disease) and text generation (visual question answering and report generation). At matched token budgets, ORCA improves consistently over existing compression methods. It shrinks the visual context $64\\times$ and its KV-cache $50\\times$, and is $31\\times$ faster to process each volume. Code released at https://github.com/renjie-liang/ORCA-3DCT."}],"geoLocations":[],"fundingReferences":[],"url":"https://arxiv.org/abs/2608.00345","contentUrl":null,"metadataVersion":0,"schemaVersion":"http://datacite.org/schema/kernel-4","source":"mds","isActive":true,"state":"findable","reason":null,"viewCount":0,"downloadCount":0,"referenceCount":0,"citationCount":0,"partCount":0,"partOfCount":0,"versionCount":0,"versionOfCount":0,"created":"2026-08-04T03:37:07Z","registered":"2026-08-04T03:37:08Z","published":null,"updated":"2026-08-04T03:37:08Z"},"relationships":{"client":{"data":{"id":"arxiv.content","type":"clients"}}}},{"id":"10.48550/arxiv.2608.00344","type":"dois","attributes":{"doi":"10.48550/arxiv.2608.00344","identifiers":[{"identifier":"2608.00344","identifierType":"arXiv"}],"creators":[{"nameType":"Personal","givenName":"Debankur","familyName":"Das","name":"Das, Debankur","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Niloyendu","familyName":"Roy","name":"Roy, Niloyendu","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Niklas","familyName":"Windbacher","name":"Windbacher, Niklas","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Clemens","familyName":"Bechinger","name":"Bechinger, Clemens","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Matthias","familyName":"Krüger","name":"Krüger, Matthias","affiliation":[],"nameIdentifiers":[]}],"titles":[{"title":"Memory with Onsager-Casimir symmetry: Rotating particle in a viscoelastic fluid"}],"publisher":"arXiv","container":{},"publicationYear":2026,"subjects":[{"subject":"Statistical Mechanics (cond-mat.stat-mech)","lang":"en","subjectScheme":"arXiv"},{"subject":"Soft Condensed Matter (cond-mat.soft)","lang":"en","subjectScheme":"arXiv"},{"subject":"FOS: Physical sciences","subjectScheme":"Fields of Science and Technology (FOS)"}],"contributors":[],"dates":[{"date":"2026-07-31T23:22:26Z","dateType":"Submitted","dateInformation":"v1"},{"date":"2026-08-04T00:14:31Z","dateType":"Updated","dateInformation":"v1"},{"date":"2026-08","dateType":"Available","dateInformation":"v1"}],"language":null,"types":{"schemaOrg":"CreativeWork","resourceTypeGeneral":"Preprint","citeproc":"article","bibtex":"misc","ris":"GEN","resourceType":"Article"},"relatedIdentifiers":[],"relatedItems":[],"sizes":[],"formats":[],"version":"1","rightsList":[{"rightsIdentifierScheme":"SPDX","rightsUri":"https://creativecommons.org/publicdomain/zero/1.0/legalcode","schemeUri":"https://spdx.org/licenses/","rights":"Creative Commons Zero v1.0 Universal","rightsIdentifier":"cc0-1.0"}],"descriptions":[{"descriptionType":"Abstract","description":"We study the stochastic dynamics of a rotating Brownian particle in a non-Markovian fluid. Experimentally, we find that rotation enhances the long-time diffusivity of the particle and generates time-antisymmetric cross-correlations between orthogonal displacement components in the plane perpendicular to the rotation axis. To rationalize these observations, we introduce a minimal linear model in which a tracer is coupled to a slow bath degree of freedom and rotation enters through an advective coupling. Eliminating the bath variable yields a generalized Langevin equation with a non-reciprocal memory kernel. This kernel rotates in time, forming a logarithmic spiral, and it obeys Onsager-Casimir symmetry under reversal of the rotation vector, and the corresponding fluctuation-response relation. From the latter we obtain a geometric construction that links two-time cross-correlations to the transverse response of the particle in bulk. Unlike the ordinary Einstein relation, this relation involves the antisymmetric sector of the response. Our experiments and theory are in qualitative agreement, establishing rotating colloids in viscoelastic fluids as a minimal realization of Onsager-Casimir symmetry in time-nonlocal stochastic dynamics"},{"descriptionType":"Other","description":"10 pages 6 figures"}],"geoLocations":[],"fundingReferences":[],"url":"https://arxiv.org/abs/2608.00344","contentUrl":null,"metadataVersion":0,"schemaVersion":"http://datacite.org/schema/kernel-4","source":"mds","isActive":true,"state":"findable","reason":null,"viewCount":0,"downloadCount":0,"referenceCount":0,"citationCount":0,"partCount":0,"partOfCount":0,"versionCount":0,"versionOfCount":0,"created":"2026-08-04T03:37:06Z","registered":"2026-08-04T03:37:06Z","published":null,"updated":"2026-08-04T03:37:06Z"},"relationships":{"client":{"data":{"id":"arxiv.content","type":"clients"}}}},{"id":"10.48550/arxiv.2608.00343","type":"dois","attributes":{"doi":"10.48550/arxiv.2608.00343","identifiers":[{"identifier":"2608.00343","identifierType":"arXiv"}],"creators":[{"nameType":"Personal","givenName":"G.","familyName":"Mamatsashvili","name":"Mamatsashvili, G.","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"D.","familyName":"Kobaidze","name":"Kobaidze, D.","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"W.","familyName":"Mouhali","name":"Mouhali, W.","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"T.","familyName":"Lehner","name":"Lehner, T.","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"L.","familyName":"Burdiladze","name":"Burdiladze, L.","affiliation":[],"nameIdentifiers":[]}],"titles":[{"title":"The generation of spiral density waves by MRI in accretion discs"}],"publisher":"arXiv","container":{},"publicationYear":2026,"subjects":[{"subject":"Earth and Planetary Astrophysics (astro-ph.EP)","lang":"en","subjectScheme":"arXiv"},{"subject":"High Energy Astrophysical Phenomena (astro-ph.HE)","lang":"en","subjectScheme":"arXiv"},{"subject":"Solar and Stellar Astrophysics (astro-ph.SR)","lang":"en","subjectScheme":"arXiv"},{"subject":"FOS: Physical sciences","subjectScheme":"Fields of Science and Technology (FOS)"}],"contributors":[],"dates":[{"date":"2026-07-31T23:19:41Z","dateType":"Submitted","dateInformation":"v1"},{"date":"2026-08-04T00:14:24Z","dateType":"Updated","dateInformation":"v1"},{"date":"2026-08","dateType":"Available","dateInformation":"v1"}],"language":null,"types":{"schemaOrg":"CreativeWork","resourceTypeGeneral":"Preprint","citeproc":"article","bibtex":"misc","ris":"GEN","resourceType":"Article"},"relatedIdentifiers":[],"relatedItems":[],"sizes":[],"formats":[],"version":"1","rightsList":[{"rightsUri":"http://arxiv.org/licenses/nonexclusive-distrib/1.0/","rights":"arXiv.org perpetual, non-exclusive license"}],"descriptions":[{"descriptionType":"Abstract","description":"We investigate the linear dynamics of non-axisymmetric perturbations in Keplerian discs subject to a weak uniform vertical magnetic field in the shearing box approximation. Perturbations are decomposed into shearing waves and evolved by numerically integrating the linearized ideal MHD equations. The disc flow supports three basic perturbation modes: two incompressible modes - magnetic mode that undergoes magnetorotational instability (MRI) and inertia-magnetic waves - and compressible spiral density waves. The magnetic mode and inertia-magnetic waves have a low frequency of the order of Alfvén and orbital frequencies, respectively, while density waves have high-frequency. We introduce mode eigenfunctions and governing modal equations to analyze the dynamics of individual modes. For non-axisymmetric modes, the modal equations are coupled due to the shear of the Keplerian rotation of the disc, giving rise to a new shear-induced linear mode coupling process, which is rooted in the non-self-adjoint nature of shear flows. We focus on the generation of density waves by the dominant MRI-unstable magnetic mode. We show that initially imposed magnetic mode undergoes MRI growth and abruptly excites density waves when its radial wavenumber crosses zero. The density wave-MRI coupling is most efficient when the azimuthal and vertical wavelengths of perturbations are comparable to the disc scale height. Since density waves are compressible, whereas MRI is incompressible, this wave excitation process can also be regarded as a linear mechanism generating compressible motions via MRI-driven incompressible ones. Its implications for compressible nonzero net vertical field MRI-turbulence are also discussed."},{"descriptionType":"Other","description":"14 pages, 6 figures, accepted for publication in MNRAS"}],"geoLocations":[],"fundingReferences":[],"url":"https://arxiv.org/abs/2608.00343","contentUrl":null,"metadataVersion":0,"schemaVersion":"http://datacite.org/schema/kernel-4","source":"mds","isActive":true,"state":"findable","reason":null,"viewCount":0,"downloadCount":0,"referenceCount":0,"citationCount":0,"partCount":0,"partOfCount":0,"versionCount":0,"versionOfCount":0,"created":"2026-08-04T03:37:04Z","registered":"2026-08-04T03:37:05Z","published":null,"updated":"2026-08-04T03:37:05Z"},"relationships":{"client":{"data":{"id":"arxiv.content","type":"clients"}}}},{"id":"10.48550/arxiv.2608.00342","type":"dois","attributes":{"doi":"10.48550/arxiv.2608.00342","identifiers":[{"identifier":"2608.00342","identifierType":"arXiv"}],"creators":[{"nameType":"Personal","givenName":"Amit","familyName":"Dutta","name":"Dutta, Amit","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Marcos M.","familyName":"Vasconcelos","name":"Vasconcelos, Marcos M.","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Olugbenga M.","familyName":"Anubi","name":"Anubi, Olugbenga M.","affiliation":[],"nameIdentifiers":[]}],"titles":[{"title":"Source Reliability Weighted Observer Design for Open Client Server Networks"}],"publisher":"arXiv","container":{},"publicationYear":2026,"subjects":[{"subject":"Optimization and Control (math.OC)","lang":"en","subjectScheme":"arXiv"},{"subject":"FOS: Mathematics","subjectScheme":"Fields of Science and Technology (FOS)"}],"contributors":[],"dates":[{"date":"2026-07-31T23:14:35Z","dateType":"Submitted","dateInformation":"v1"},{"date":"2026-08-04T00:14:23Z","dateType":"Updated","dateInformation":"v1"},{"date":"2026-08","dateType":"Available","dateInformation":"v1"}],"language":null,"types":{"schemaOrg":"CreativeWork","resourceTypeGeneral":"Preprint","citeproc":"article","bibtex":"misc","ris":"GEN","resourceType":"Article"},"relatedIdentifiers":[],"relatedItems":[],"sizes":[],"formats":[],"version":"1","rightsList":[{"rightsUri":"http://arxiv.org/licenses/nonexclusive-distrib/1.0/","rights":"arXiv.org perpetual, non-exclusive license"}],"descriptions":[{"descriptionType":"Abstract","description":"State estimation in open client server networks is challenging because the set of active observation sources changes over time, and active sources need not be valid sensors of the latent state. We study a client-server estimation problem in which a fixed but unknown state-consistent sensing class measures the latent state when active, while nuisance sources may arrive in the active set and generate observations from a different signal class. The server observes active sources, but it does not know which agents observe valid state measurements. We propose a source-reliability-weighted observer. The state estimate is a standard fixed-prior weighted least-squares update, but the information assigned to each active observation is determined by a source-level reliability score learned from repeated innovation consistency. Numerical results show that the observer, when all active sources are considered, has a finite bias, while the proposed observer initially learns source reliability and then tracks the desired latent state after a finite learning period."}],"geoLocations":[],"fundingReferences":[],"url":"https://arxiv.org/abs/2608.00342","contentUrl":null,"metadataVersion":0,"schemaVersion":"http://datacite.org/schema/kernel-4","source":"mds","isActive":true,"state":"findable","reason":null,"viewCount":0,"downloadCount":0,"referenceCount":0,"citationCount":0,"partCount":0,"partOfCount":0,"versionCount":0,"versionOfCount":0,"created":"2026-08-04T03:37:03Z","registered":"2026-08-04T03:37:04Z","published":null,"updated":"2026-08-04T03:37:04Z"},"relationships":{"client":{"data":{"id":"arxiv.content","type":"clients"}}}},{"id":"10.48550/arxiv.2608.00341","type":"dois","attributes":{"doi":"10.48550/arxiv.2608.00341","identifiers":[{"identifier":"2608.00341","identifierType":"arXiv"}],"creators":[{"nameType":"Personal","givenName":"Edgar","familyName":"Guardiola-Navarrete","name":"Guardiola-Navarrete, Edgar","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Silvia","familyName":"Cardenas-Lopez","name":"Cardenas-Lopez, Silvia","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Ana","familyName":"Asenjo-Garcia","name":"Asenjo-Garcia, Ana","affiliation":[],"nameIdentifiers":[]}],"titles":[{"title":"Phase-Space Methods for Many-Body Quantum Optics"}],"publisher":"arXiv","container":{},"publicationYear":2026,"subjects":[{"subject":"Quantum Physics (quant-ph)","lang":"en","subjectScheme":"arXiv"},{"subject":"FOS: Physical sciences","subjectScheme":"Fields of Science and Technology (FOS)"}],"contributors":[],"dates":[{"date":"2026-07-31T23:05:04Z","dateType":"Submitted","dateInformation":"v1"},{"date":"2026-08-04T00:14:12Z","dateType":"Updated","dateInformation":"v1"},{"date":"2026-08","dateType":"Available","dateInformation":"v1"}],"language":null,"types":{"schemaOrg":"CreativeWork","resourceTypeGeneral":"Preprint","citeproc":"article","bibtex":"misc","ris":"GEN","resourceType":"Article"},"relatedIdentifiers":[{"relationType":"IsVersionOf","relatedIdentifier":"10.1016/bs.aamop.2025.04.003","relatedIdentifierType":"DOI"}],"relatedItems":[],"sizes":[],"formats":[],"version":"1","rightsList":[{"rightsUri":"http://arxiv.org/licenses/nonexclusive-distrib/1.0/","rights":"arXiv.org perpetual, non-exclusive license"}],"descriptions":[{"descriptionType":"Abstract","description":"Many-body quantum-optical systems, where a collection of emitters interacts through a common electromagnetic reservoir, exhibit rich out-of-equilibrium behavior and hold promise for applications in quantum technologies. However, exact numerical simulations of their dynamics quickly become unfeasible due to the exponential growth of the Hilbert space with system size. Semiclassical, phase-space approaches -- such as the Truncated Wigner approximation (TWA) -- provide computationally efficient alternatives by capturing leading-order quantum fluctuations. In this paper, we present a comprehensive overview of how to tackle problems in many-body quantum optics using phase-space methods. We derive the exact partial differential equation governing many-body dissipative evolution in any phase-space representation and discuss the approximations that yield the dissipative TWA proposed by Mink and Fleischhauer [SciPost Phys. 15, 233 (2023)]. We find that $P$ and $Q$ distributions are generally suboptimal for many-body quantum optics. Additionally, we extend the formalism to calculate multi-time correlation functions, thereby broadening the scope of phase-space simulations of open spin systems to include coherence and spectral properties, as well as directional correlations of collectively radiating emitters. These developments provide valuable tools for investigating exotic light sources driven by collective dissipation, driven-dissipative phase transitions, and a wealth of many-body phenomena arising in state-of-the-art experimental platforms."},{"descriptionType":"Other","description":"51 pages, 12 figures"}],"geoLocations":[],"fundingReferences":[],"url":"https://arxiv.org/abs/2608.00341","contentUrl":null,"metadataVersion":0,"schemaVersion":"http://datacite.org/schema/kernel-4","source":"mds","isActive":true,"state":"findable","reason":null,"viewCount":0,"downloadCount":0,"referenceCount":0,"citationCount":0,"partCount":0,"partOfCount":0,"versionCount":0,"versionOfCount":1,"created":"2026-08-04T03:37:01Z","registered":"2026-08-04T03:37:02Z","published":null,"updated":"2026-08-04T03:37:02Z"},"relationships":{"client":{"data":{"id":"arxiv.content","type":"clients"}}}},{"id":"10.48550/arxiv.2608.00340","type":"dois","attributes":{"doi":"10.48550/arxiv.2608.00340","identifiers":[{"identifier":"2608.00340","identifierType":"arXiv"}],"creators":[{"nameType":"Personal","givenName":"Manuel A.","familyName":"Espinosa-García","name":"Espinosa-García, Manuel A.","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Ana Paulina","familyName":"Figueroa","name":"Figueroa, Ana Paulina","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Julián A.","familyName":"Fresán-Figueroa","name":"Fresán-Figueroa, Julián A.","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Gerardo L.","familyName":"Maldonado","name":"Maldonado, Gerardo L.","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"L. Ariadna","familyName":"Sánchez-Solís","name":"Sánchez-Solís, L. Ariadna","affiliation":[],"nameIdentifiers":[]}],"titles":[{"title":"Extinction thresholds in a graph-based model of HIV infection dynamics"}],"publisher":"arXiv","container":{},"publicationYear":2026,"subjects":[{"subject":"Dynamical Systems (math.DS)","lang":"en","subjectScheme":"arXiv"},{"subject":"Combinatorics (math.CO)","lang":"en","subjectScheme":"arXiv"},{"subject":"Cellular Automata and Lattice Gases (nlin.CG)","lang":"en","subjectScheme":"arXiv"},{"subject":"FOS: Mathematics","subjectScheme":"Fields of Science and Technology (FOS)"},{"subject":"FOS: Physical sciences","subjectScheme":"Fields of Science and Technology (FOS)"},{"subject":"05C90, 92C42","lang":"en","subjectScheme":"MSC"}],"contributors":[],"dates":[{"date":"2026-07-31T23:04:18Z","dateType":"Submitted","dateInformation":"v1"},{"date":"2026-08-04T00:14:11Z","dateType":"Updated","dateInformation":"v1"},{"date":"2026-08","dateType":"Available","dateInformation":"v1"}],"language":null,"types":{"schemaOrg":"CreativeWork","resourceTypeGeneral":"Preprint","citeproc":"article","bibtex":"misc","ris":"GEN","resourceType":"Article"},"relatedIdentifiers":[],"relatedItems":[],"sizes":[],"formats":[],"version":"1","rightsList":[{"rightsUri":"http://arxiv.org/licenses/nonexclusive-distrib/1.0/","rights":"arXiv.org perpetual, non-exclusive license"}],"descriptions":[{"descriptionType":"Abstract","description":"We study a graph-based cellular automaton for HIV infection dynamics in lymph-node networks, originally introduced by Mukwembi. Each vertex represents a cell site that may be healthy, infected, or dead, and the evolution is controlled by a replacement parameter $R$, which determines whether a dead cell is replaced by an infected or a healthy cell according to the number of its infected neighbors. For a graph $G$, we introduce two extinction parameters. The parameter $\\mathbf{hiv}(G)$ is the smallest value of $R$ for which extinction occurs for every admissible initial configuration, whereas $\\mathbf{HIV}(G)$ is the smallest threshold such that extinction occurs for every replacement parameter greater than or equal to it. We prove the general bounds $2\\leq \\mathbf{hiv}(G)\\leq \\mathbf{HIV}(G)\\leq Δ(G)+1$ and characterize the extremal case $\\mathbf{HIV}(G)=Δ(G)+1$. We also show that the gap $\\mathbf{HIV}(G)-\\mathbf{hiv}(G)$ is unbounded and determine both parameters for some classical families of graphs. Finally, we study the dynamics of the model using the state-transition digraph of the system and the configurations whose trajectories converge to nontrivial periodic orbits. The results show that extinction depends not only on the replacement parameter but also on the structural properties of the underlying graph."},{"descriptionType":"Other","description":"16 pages"}],"geoLocations":[],"fundingReferences":[],"url":"https://arxiv.org/abs/2608.00340","contentUrl":null,"metadataVersion":0,"schemaVersion":"http://datacite.org/schema/kernel-4","source":"mds","isActive":true,"state":"findable","reason":null,"viewCount":0,"downloadCount":0,"referenceCount":0,"citationCount":0,"partCount":0,"partOfCount":0,"versionCount":0,"versionOfCount":0,"created":"2026-08-04T03:37:00Z","registered":"2026-08-04T03:37:01Z","published":null,"updated":"2026-08-04T03:37:01Z"},"relationships":{"client":{"data":{"id":"arxiv.content","type":"clients"}}}},{"id":"10.48550/arxiv.2608.00339","type":"dois","attributes":{"doi":"10.48550/arxiv.2608.00339","identifiers":[{"identifier":"2608.00339","identifierType":"arXiv"}],"creators":[{"nameType":"Personal","givenName":"Eddie","familyName":"Yang","name":"Yang, Eddie","affiliation":[],"nameIdentifiers":[]}],"titles":[{"title":"Bayesian and Motivated Reasoning in AI Agents"}],"publisher":"arXiv","container":{},"publicationYear":2026,"subjects":[{"subject":"Artificial Intelligence (cs.AI)","lang":"en","subjectScheme":"arXiv"},{"subject":"Computation and Language (cs.CL)","lang":"en","subjectScheme":"arXiv"},{"subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"}],"contributors":[],"dates":[{"date":"2026-07-31T23:02:58Z","dateType":"Submitted","dateInformation":"v1"},{"date":"2026-08-04T00:14:10Z","dateType":"Updated","dateInformation":"v1"},{"date":"2026-08","dateType":"Available","dateInformation":"v1"}],"language":null,"types":{"schemaOrg":"CreativeWork","resourceTypeGeneral":"Preprint","citeproc":"article","bibtex":"misc","ris":"GEN","resourceType":"Article"},"relatedIdentifiers":[],"relatedItems":[],"sizes":[],"formats":[],"version":"1","rightsList":[{"rightsIdentifierScheme":"SPDX","rightsUri":"https://creativecommons.org/licenses/by/4.0/legalcode","schemeUri":"https://spdx.org/licenses/","rights":"Creative Commons Attribution 4.0 International","rightsIdentifier":"cc-by-4.0"}],"descriptions":[{"descriptionType":"Abstract","description":"AI agents increasingly perform open-ended tasks in settings where their conclusions can guide consequential decisions. We provide evidence that AI agents draw different conclusions from identical numerical data when the substantive framing changes. We demonstrate this behavior in high-stakes domains in medicine, election forensics, and geopolitical forecasting by holding the evidence fixed while changing the scenario in which the evidence appears. Across twelve agent-domain comparisons, agents' conclusions are strongly influenced by their prior beliefs. They are more likely to reach an affirmative conclusion when it is framed around a proposition they already regard as likely, while the reverse holds when the framing conflicts with their prior. The framing also changes how some agents work: they search more extensively, choose different analytical specifications, and evaluate the same evidence differently. These results identify a particular risk of delegating decision-making to AI agents, as their decisions may depend on prior beliefs that are neither specified in the task nor visible in the decision record."}],"geoLocations":[],"fundingReferences":[],"url":"https://arxiv.org/abs/2608.00339","contentUrl":null,"metadataVersion":0,"schemaVersion":"http://datacite.org/schema/kernel-4","source":"mds","isActive":true,"state":"findable","reason":null,"viewCount":0,"downloadCount":0,"referenceCount":0,"citationCount":0,"partCount":0,"partOfCount":0,"versionCount":0,"versionOfCount":0,"created":"2026-08-04T03:36:59Z","registered":"2026-08-04T03:36:59Z","published":null,"updated":"2026-08-04T03:36:59Z"},"relationships":{"client":{"data":{"id":"arxiv.content","type":"clients"}}}},{"id":"10.48550/arxiv.2608.00338","type":"dois","attributes":{"doi":"10.48550/arxiv.2608.00338","identifiers":[{"identifier":"2608.00338","identifierType":"arXiv"}],"creators":[{"nameType":"Personal","givenName":"Jason G.","familyName":"Kattan","name":"Kattan, Jason G.","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"T.","familyName":"Pereg-Barnea","name":"Pereg-Barnea, T.","affiliation":[],"nameIdentifiers":[]}],"titles":[{"title":"Ferroelectric superconductivity in noncentrosymmetric metals"}],"publisher":"arXiv","container":{},"publicationYear":2026,"subjects":[{"subject":"Superconductivity (cond-mat.supr-con)","lang":"en","subjectScheme":"arXiv"},{"subject":"FOS: Physical sciences","subjectScheme":"Fields of Science and Technology (FOS)"}],"contributors":[],"dates":[{"date":"2026-07-31T23:02:33Z","dateType":"Submitted","dateInformation":"v1"},{"date":"2026-08-04T00:14:09Z","dateType":"Updated","dateInformation":"v1"},{"date":"2026-08","dateType":"Available","dateInformation":"v1"}],"language":null,"types":{"schemaOrg":"CreativeWork","resourceTypeGeneral":"Preprint","citeproc":"article","bibtex":"misc","ris":"GEN","resourceType":"Article"},"relatedIdentifiers":[],"relatedItems":[],"sizes":[],"formats":[],"version":"1","rightsList":[{"rightsUri":"http://arxiv.org/licenses/nonexclusive-distrib/1.0/","rights":"arXiv.org perpetual, non-exclusive license"}],"descriptions":[{"descriptionType":"Abstract","description":"It has recently been shown in experiments that certain materials can display both superconductivity and ferroelectricity, contrary to a long-standing conjecture that these two phenomena are incompatible, or at least unrelated. In this work we study superconductivity in ferroelectric metals, using a formalism of ionic polarization fields coupled to itinerant electrons, both of which are treated at the microscopic level. The ferroelectric order manifests as a spontaneous polarization that may be uniform or spatially modulated, and fluctuations of the polarization mediate interactions between the electrons. The polarization fluctuations give rise to attractive interactions that can lead to Cooper pairing in certain lattice configurations, analogous to the nonpolar phonons in conventional BCS theory. Working with a simplified BCS model, we derive conditions under which superconductivity can coexist with and even emerge from ferroelectricity."},{"descriptionType":"Other","description":"2 figures"}],"geoLocations":[],"fundingReferences":[],"url":"https://arxiv.org/abs/2608.00338","contentUrl":null,"metadataVersion":0,"schemaVersion":"http://datacite.org/schema/kernel-4","source":"mds","isActive":true,"state":"findable","reason":null,"viewCount":0,"downloadCount":0,"referenceCount":0,"citationCount":0,"partCount":0,"partOfCount":0,"versionCount":0,"versionOfCount":0,"created":"2026-08-04T03:36:57Z","registered":"2026-08-04T03:36:58Z","published":null,"updated":"2026-08-04T03:36:58Z"},"relationships":{"client":{"data":{"id":"arxiv.content","type":"clients"}}}},{"id":"10.48550/arxiv.2608.00337","type":"dois","attributes":{"doi":"10.48550/arxiv.2608.00337","identifiers":[{"identifier":"2608.00337","identifierType":"arXiv"}],"creators":[{"nameType":"Personal","givenName":"Rohan","familyName":"Bansal","name":"Bansal, Rohan","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"David","familyName":"He","name":"He, David","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Nadun Ranawaka","familyName":"Arachchige","name":"Arachchige, Nadun Ranawaka","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Zhenyang","familyName":"Chen","name":"Chen, Zhenyang","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Soobum","familyName":"Kim","name":"Kim, Soobum","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Kexin","familyName":"Rong","name":"Rong, Kexin","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Danfei","familyName":"Xu","name":"Xu, Danfei","affiliation":[],"nameIdentifiers":[]}],"titles":[{"title":"Action Chunk Scheduling for Batched Robot Policy Serving"}],"publisher":"arXiv","container":{},"publicationYear":2026,"subjects":[{"subject":"Robotics (cs.RO)","lang":"en","subjectScheme":"arXiv"},{"subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"}],"contributors":[],"dates":[{"date":"2026-07-31T22:58:59Z","dateType":"Submitted","dateInformation":"v1"},{"date":"2026-08-04T00:14:04Z","dateType":"Updated","dateInformation":"v1"},{"date":"2026-08","dateType":"Available","dateInformation":"v1"}],"language":null,"types":{"schemaOrg":"CreativeWork","resourceTypeGeneral":"Preprint","citeproc":"article","bibtex":"misc","ris":"GEN","resourceType":"Article"},"relatedIdentifiers":[],"relatedItems":[],"sizes":[],"formats":[],"version":"1","rightsList":[{"rightsUri":"http://arxiv.org/licenses/nonexclusive-distrib/1.0/","rights":"arXiv.org perpetual, non-exclusive license"}],"descriptions":[{"descriptionType":"Abstract","description":"Deploying robot foundation models at scale is the next step towards realizing the potential of general-purpose robots. However, Vision-Language-Action (VLA) and other foundation models are computationally demanding, and on-device compute is constrained by power and space. In this paper, we introduce the problem of serving a robot policy to multiple robots from a remote GPU and formulate it as a scheduling problem. We build Armory, a serving system validated on fleets of both simulated and real robots. Our experiments show that naive scheduling heuristics perform well when all robots are the same, but fall short when robots consume action chunks at different rates, uncovering a mismatch between conventional batching methods and the closed-loop requirements of robot policy execution. To address this, we propose a scheduling algorithm that accounts for this heterogeneity and improves overall system throughput by up to $18\\%$ in real-world experiments. Additional details are available at https://gatech-rl2.github.io/actionchunkscheduling."}],"geoLocations":[],"fundingReferences":[],"url":"https://arxiv.org/abs/2608.00337","contentUrl":null,"metadataVersion":0,"schemaVersion":"http://datacite.org/schema/kernel-4","source":"mds","isActive":true,"state":"findable","reason":null,"viewCount":0,"downloadCount":0,"referenceCount":0,"citationCount":0,"partCount":0,"partOfCount":0,"versionCount":0,"versionOfCount":0,"created":"2026-08-04T03:36:56Z","registered":"2026-08-04T03:36:57Z","published":null,"updated":"2026-08-04T03:36:57Z"},"relationships":{"client":{"data":{"id":"arxiv.content","type":"clients"}}}},{"id":"10.48550/arxiv.2608.00336","type":"dois","attributes":{"doi":"10.48550/arxiv.2608.00336","identifiers":[{"identifier":"2608.00336","identifierType":"arXiv"}],"creators":[{"nameType":"Personal","givenName":"Yann","familyName":"Bramoullé","name":"Bramoullé, Yann","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Sebastiaan","familyName":"Maes","name":"Maes, Sebastiaan","affiliation":[],"nameIdentifiers":[]}],"titles":[{"title":"Measurement Error and Peer Effects in Networks"}],"publisher":"arXiv","container":{},"publicationYear":2026,"subjects":[{"subject":"Econometrics (econ.EM)","lang":"en","subjectScheme":"arXiv"},{"subject":"FOS: Economics and business","subjectScheme":"Fields of Science and Technology (FOS)"}],"contributors":[],"dates":[{"date":"2026-07-31T22:58:43Z","dateType":"Submitted","dateInformation":"v1"},{"date":"2026-08-04T00:14:03Z","dateType":"Updated","dateInformation":"v1"},{"date":"2026-08","dateType":"Available","dateInformation":"v1"}],"language":null,"types":{"schemaOrg":"CreativeWork","resourceTypeGeneral":"Preprint","citeproc":"article","bibtex":"misc","ris":"GEN","resourceType":"Article"},"relatedIdentifiers":[],"relatedItems":[],"sizes":[],"formats":[],"version":"1","rightsList":[{"rightsUri":"http://arxiv.org/licenses/nonexclusive-distrib/1.0/","rights":"arXiv.org perpetual, non-exclusive license"}],"descriptions":[{"descriptionType":"Abstract","description":"In many practical applications, only noisy proxies for the true regressors are available, which is commonly believed to induce an attenuation bias. In the linear-in-means model, however, estimated peer effects might be inflated, potentially leading to false positives. This paper shows that the asymptotic bias depends on the interplay between individual characteristics and network links and demonstrates how the network structure can facilitate identification without the need for additional external information. Based on these identification results, we present consistent GMM and 2SLS estimators that are easily implementable. Our results are illustrated by means of a Monte Carlo simulation."}],"geoLocations":[],"fundingReferences":[],"url":"https://arxiv.org/abs/2608.00336","contentUrl":null,"metadataVersion":0,"schemaVersion":"http://datacite.org/schema/kernel-4","source":"mds","isActive":true,"state":"findable","reason":null,"viewCount":0,"downloadCount":0,"referenceCount":0,"citationCount":0,"partCount":0,"partOfCount":0,"versionCount":0,"versionOfCount":0,"created":"2026-08-04T03:36:54Z","registered":"2026-08-04T03:36:55Z","published":null,"updated":"2026-08-04T03:36:55Z"},"relationships":{"client":{"data":{"id":"arxiv.content","type":"clients"}}}},{"id":"10.48550/arxiv.2608.00335","type":"dois","attributes":{"doi":"10.48550/arxiv.2608.00335","identifiers":[{"identifier":"2608.00335","identifierType":"arXiv"}],"creators":[{"nameType":"Personal","givenName":"Chengbo","familyName":"Liu","name":"Liu, Chengbo","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Lifang","familyName":"Zhou","name":"Zhou, Lifang","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Ruijie","familyName":"Yan","name":"Yan, Ruijie","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Pei","familyName":"Tan","name":"Tan, Pei","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Ao","familyName":"Sun","name":"Sun, Ao","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Haojun","familyName":"Huang","name":"Huang, Haojun","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Guichun","familyName":"Hua","name":"Hua, Guichun","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Sining","familyName":"Wei","name":"Wei, Sining","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Yining","familyName":"Chen","name":"Chen, Yining","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Yingying","familyName":"He","name":"He, Yingying","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Yutao","familyName":"Xie","name":"Xie, Yutao","affiliation":[],"nameIdentifiers":[]}],"titles":[{"title":"RMSWeb: Reflection, Failure-Mode Mining, and Salvage-DS for Web Agent Reinforcement Learning"}],"publisher":"arXiv","container":{},"publicationYear":2026,"subjects":[{"subject":"Artificial Intelligence (cs.AI)","lang":"en","subjectScheme":"arXiv"},{"subject":"Computation and Language (cs.CL)","lang":"en","subjectScheme":"arXiv"},{"subject":"Machine Learning (cs.LG)","lang":"en","subjectScheme":"arXiv"},{"subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"}],"contributors":[],"dates":[{"date":"2026-07-31T22:57:16Z","dateType":"Submitted","dateInformation":"v1"},{"date":"2026-08-04T00:14:02Z","dateType":"Updated","dateInformation":"v1"},{"date":"2026-08","dateType":"Available","dateInformation":"v1"}],"language":null,"types":{"schemaOrg":"CreativeWork","resourceTypeGeneral":"Preprint","citeproc":"article","bibtex":"misc","ris":"GEN","resourceType":"Article"},"relatedIdentifiers":[],"relatedItems":[],"sizes":[],"formats":[],"version":"1","rightsList":[{"rightsUri":"http://arxiv.org/licenses/nonexclusive-distrib/1.0/","rights":"arXiv.org perpetual, non-exclusive license"}],"descriptions":[{"descriptionType":"Abstract","description":"Compact web agents can reduce deployment cost, but training them poses challenges in both data collection and post-SFT reinforcement learning (RL). Successful trajectories are expensive to collect and often contain inefficient detours. After supervised fine-tuning (SFT), full trajectory corpora are dominated by routine states; moreover, when group-relative RL is applied to web actions, inadequately designed action-level rewards can yield weak or misleading relative updates, while groups rejected as unsuitable for such updates receive no fallback learning signal. We present RMSWeb, a three-part recipe for Qwen3-VL-Instruct at 8B and 32B. Reflection-conditioned retries increase collection yield and shorten successful trajectories; failure-mode mining concentrates offline RL on critical states exposed by the SFT policy; and Salvage-DS combines an action-semantic polarized reward, contrast-and-competence-gated dynamic sampling, and an action-only anchor for rejected groups. Policies trained with reflection-collected data use up to 19.7% fewer action steps on solved tasks. On WebVoyager, Online-Mind2Web, and WebTailBench, RMSWeb improves over SFT by 2.4-7.0 points at 8B and 1.2-7.7 points at 32B. Our 8B model also achieves the strongest reported Online-Mind2Web result among similarly sized open-weight models in our comparison and a leading reported accuracy-cost trade-off on WebVoyager and WebTailBench, with the caveat that external evaluation protocols differ."},{"descriptionType":"Other","description":"15 pages, 9 figures, and 6 tables. Includes appendices"}],"geoLocations":[],"fundingReferences":[],"url":"https://arxiv.org/abs/2608.00335","contentUrl":null,"metadataVersion":0,"schemaVersion":"http://datacite.org/schema/kernel-4","source":"mds","isActive":true,"state":"findable","reason":null,"viewCount":0,"downloadCount":0,"referenceCount":0,"citationCount":0,"partCount":0,"partOfCount":0,"versionCount":0,"versionOfCount":0,"created":"2026-08-04T03:36:53Z","registered":"2026-08-04T03:36:54Z","published":null,"updated":"2026-08-04T03:36:54Z"},"relationships":{"client":{"data":{"id":"arxiv.content","type":"clients"}}}},{"id":"10.48550/arxiv.2608.00334","type":"dois","attributes":{"doi":"10.48550/arxiv.2608.00334","identifiers":[{"identifier":"2608.00334","identifierType":"arXiv"}],"creators":[{"nameType":"Personal","givenName":"Michael","familyName":"Ostrovsky","name":"Ostrovsky, Michael","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Andrzej","familyName":"Skrzypacz","name":"Skrzypacz, Andrzej","affiliation":[],"nameIdentifiers":[]}],"titles":[{"title":"Pure-Strategy Equilibrium in the Generalized First-Price Auction"}],"publisher":"arXiv","container":{},"publicationYear":2026,"subjects":[{"subject":"Computer Science and Game Theory (cs.GT)","lang":"en","subjectScheme":"arXiv"},{"subject":"Theoretical Economics (econ.TH)","lang":"en","subjectScheme":"arXiv"},{"subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"},{"subject":"FOS: Economics and business","subjectScheme":"Fields of Science and Technology (FOS)"}],"contributors":[],"dates":[{"date":"2026-07-31T22:56:45Z","dateType":"Submitted","dateInformation":"v1"},{"date":"2026-08-04T00:14:01Z","dateType":"Updated","dateInformation":"v1"},{"date":"2026-08","dateType":"Available","dateInformation":"v1"}],"language":null,"types":{"schemaOrg":"CreativeWork","resourceTypeGeneral":"Preprint","citeproc":"article","bibtex":"misc","ris":"GEN","resourceType":"Article"},"relatedIdentifiers":[],"relatedItems":[],"sizes":[],"formats":[],"version":"1","rightsList":[{"rightsIdentifierScheme":"SPDX","rightsUri":"https://creativecommons.org/licenses/by-nc-nd/4.0/legalcode","schemeUri":"https://spdx.org/licenses/","rights":"Creative Commons Attribution Non Commercial No Derivatives 4.0 International","rightsIdentifier":"cc-by-nc-nd-4.0"}],"descriptions":[{"descriptionType":"Abstract","description":"We revisit the classic result on the (non-)existence of pure-strategy Nash equilibria in the Generalized First-Price Auction for sponsored search advertising and show that the conclusion may be reversed when ads are ranked based on the product of stochastic quality scores and bid amounts, rather than solely on the bids or on the product of bids and deterministic quality scores. Moreover, the expected revenue in the pure strategy equilibrium of the Generalized First-Price Auction may substantially exceed that of the Generalized Second-Price Auction, although under some conditions the relation may also be reversed."}],"geoLocations":[],"fundingReferences":[],"url":"https://arxiv.org/abs/2608.00334","contentUrl":null,"metadataVersion":0,"schemaVersion":"http://datacite.org/schema/kernel-4","source":"mds","isActive":true,"state":"findable","reason":null,"viewCount":0,"downloadCount":0,"referenceCount":0,"citationCount":0,"partCount":0,"partOfCount":0,"versionCount":0,"versionOfCount":0,"created":"2026-08-04T03:36:52Z","registered":"2026-08-04T03:36:52Z","published":null,"updated":"2026-08-04T03:36:52Z"},"relationships":{"client":{"data":{"id":"arxiv.content","type":"clients"}}}},{"id":"10.48550/arxiv.2608.00332","type":"dois","attributes":{"doi":"10.48550/arxiv.2608.00332","identifiers":[{"identifier":"2608.00332","identifierType":"arXiv"}],"creators":[{"nameType":"Personal","givenName":"Vahid","familyName":"Anari","name":"Anari, Vahid","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Toktam","familyName":"Rashidi","name":"Rashidi, Toktam","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Fereshteh","familyName":"Rajabi","name":"Rajabi, Fereshteh","affiliation":[],"nameIdentifiers":[]}],"titles":[{"title":"Fast Population Leakage in Astronomical Masers: Maser Amplification and Transient Superradiance"}],"publisher":"arXiv","container":{},"publicationYear":2026,"subjects":[{"subject":"High Energy Astrophysical Phenomena (astro-ph.HE)","lang":"en","subjectScheme":"arXiv"},{"subject":"FOS: Physical sciences","subjectScheme":"Fields of Science and Technology (FOS)"}],"contributors":[],"dates":[{"date":"2026-07-31T22:51:54Z","dateType":"Submitted","dateInformation":"v1"},{"date":"2026-08-04T00:13:56Z","dateType":"Updated","dateInformation":"v1"},{"date":"2026-08","dateType":"Available","dateInformation":"v1"}],"language":null,"types":{"schemaOrg":"CreativeWork","resourceTypeGeneral":"Preprint","citeproc":"article","bibtex":"misc","ris":"GEN","resourceType":"Article"},"relatedIdentifiers":[],"relatedItems":[],"sizes":[],"formats":[],"version":"1","rightsList":[{"rightsIdentifierScheme":"SPDX","rightsUri":"https://creativecommons.org/licenses/by/4.0/legalcode","schemeUri":"https://spdx.org/licenses/","rights":"Creative Commons Attribution 4.0 International","rightsIdentifier":"cc-by-4.0"}],"descriptions":[{"descriptionType":"Abstract","description":"We use a $Λ$-type three-level Maxwell--Bloch model to test whether an inverted molecular transition in an astronomical maser source can produce maser amplification or superradiance when its upper level also decays through a second radiative pathway with a much larger spontaneous decay rate. Such shared-upper-level configurations occur in multilevel, radiatively pumped molecules, including Class II methanol masers and several OH maser transitions. The model follows the coupled evolution of level populations, molecular coherences, radiation fields, and phenomenological relaxation and dephasing, separating population leakage from coherence loss. We focus on the mixed configuration in which the observed transition is inverted while the faster pathway is non-inverted and acts as a leakage channel. We find that rapid spontaneous decay through the competing pathway does not, by itself, suppress maser amplification or superradiant emission from the inverted transition. The response is controlled by the shared upper-level population reservoir, the available initial coherence, and the relaxation and dephasing timescales. For small effective coherence in the leakage pathway, its radiative output remains weak, while the inverted transition either amplifies a seed field in the quasi-steady maser regime or develops macroscopic coherence and produces a transient superradiant burst. A larger inversion does not necessarily produce a stronger burst if it is accompanied by a weaker initial coherence seed. As a benchmark, we apply the model to the 6.7 GHz methanol flare in S255IR-NIRS3, whose upper level also decays through the 239.7 GHz transition at a spontaneous rate more than four orders of magnitude larger. The calculated flare remains compatible with a transient-superradiance interpretation when this fast leakage pathway is included explicitly."},{"descriptionType":"Other","description":"13 pages, 7 figures"}],"geoLocations":[],"fundingReferences":[],"url":"https://arxiv.org/abs/2608.00332","contentUrl":null,"metadataVersion":0,"schemaVersion":"http://datacite.org/schema/kernel-4","source":"mds","isActive":true,"state":"findable","reason":null,"viewCount":0,"downloadCount":0,"referenceCount":0,"citationCount":0,"partCount":0,"partOfCount":0,"versionCount":0,"versionOfCount":0,"created":"2026-08-04T03:36:49Z","registered":"2026-08-04T03:36:50Z","published":null,"updated":"2026-08-04T03:36:50Z"},"relationships":{"client":{"data":{"id":"arxiv.content","type":"clients"}}}},{"id":"10.48550/arxiv.2608.00331","type":"dois","attributes":{"doi":"10.48550/arxiv.2608.00331","identifiers":[{"identifier":"2608.00331","identifierType":"arXiv"}],"creators":[{"nameType":"Personal","givenName":"Guadalupe Ahumada","familyName":"Acuña","name":"Acuña, Guadalupe Ahumada","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Tomas Ferreira","familyName":"Chase","name":"Chase, Tomas Ferreira","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Diana López","familyName":"Nacir","name":"Nacir, Diana López","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Rafael C.","familyName":"Nunes","name":"Nunes, Rafael C.","affiliation":[],"nameIdentifiers":[]}],"titles":[{"title":"Spin-1 Ultralight Dark Matter under Cosmological Scrutiny: Mass Constraints from CMB and Distance Probes"}],"publisher":"arXiv","container":{},"publicationYear":2026,"subjects":[{"subject":"Cosmology and Nongalactic Astrophysics (astro-ph.CO)","lang":"en","subjectScheme":"arXiv"},{"subject":"FOS: Physical sciences","subjectScheme":"Fields of Science and Technology (FOS)"}],"contributors":[],"dates":[{"date":"2026-07-31T22:39:32Z","dateType":"Submitted","dateInformation":"v1"},{"date":"2026-08-04T00:13:48Z","dateType":"Updated","dateInformation":"v1"},{"date":"2026-08","dateType":"Available","dateInformation":"v1"}],"language":null,"types":{"schemaOrg":"CreativeWork","resourceTypeGeneral":"Preprint","citeproc":"article","bibtex":"misc","ris":"GEN","resourceType":"Article"},"relatedIdentifiers":[],"relatedItems":[],"sizes":[],"formats":[],"version":"1","rightsList":[{"rightsIdentifierScheme":"SPDX","rightsUri":"https://creativecommons.org/licenses/by/4.0/legalcode","schemeUri":"https://spdx.org/licenses/","rights":"Creative Commons Attribution 4.0 International","rightsIdentifier":"cc-by-4.0"}],"descriptions":[{"descriptionType":"Abstract","description":"We present cosmological constraints on spin-1 ultralight dark matter, described by a vector field (VFDM) with mass $m_{\\rm A}$, using Planck CMB data and geometrical probes from BAO and SNIa. A key theoretical result is the derivation of the full CMB temperature covariance matrix, including both diagonal and off-diagonal anisotropic contributions induced by the preferred direction of the background vector field. We first constrain the model using the diagonal part of the covariance, together with CMB lensing; the off-diagonal terms, which couple multipoles with $Δ\\ell\\in\\{2,4\\}$, could bias lensing reconstruction, but only at very low multipoles ($L=\\{2,4\\}$) not included in the Planck likelihood. We consider both a pure VFDM scenario and a mixed VFDM+CDM scenario, characterized by the fraction $f=Ω_{\\rm A}/(Ω_{\\rm A}+Ω_{\\rm cdm})$, obtaining $\\log_{10}(m_{\\rm A}/\\mathrm{eV})\u0026gt;-24.07$ (95\\% C.L.) in the pure case, and a clear correlation between $f$ and $m_{\\rm A}$ in the mixed case, with smaller fractions allowing lighter masses; standard cosmological parameters remain fully consistent with $Λ$CDM. For the off-diagonal contributions, we derive the corresponding Bipolar Spherical Harmonic (BipoSH) coefficients and predict their amplitude using our best-fit and bounds. While the anisotropic signal is difficult to detect in the pure VFDM scenario with current Planck data, mixed VFDM+CDM models can produce signals at, or above, Planck sensitivity over a range of multipoles, motivating dedicated searches for this characteristic signature."},{"descriptionType":"Other","description":"14 pages, 5 figures"}],"geoLocations":[],"fundingReferences":[],"url":"https://arxiv.org/abs/2608.00331","contentUrl":null,"metadataVersion":0,"schemaVersion":"http://datacite.org/schema/kernel-4","source":"mds","isActive":true,"state":"findable","reason":null,"viewCount":0,"downloadCount":0,"referenceCount":0,"citationCount":0,"partCount":0,"partOfCount":0,"versionCount":0,"versionOfCount":0,"created":"2026-08-04T03:36:48Z","registered":"2026-08-04T03:36:48Z","published":null,"updated":"2026-08-04T03:36:48Z"},"relationships":{"client":{"data":{"id":"arxiv.content","type":"clients"}}}},{"id":"10.48550/arxiv.2608.00330","type":"dois","attributes":{"doi":"10.48550/arxiv.2608.00330","identifiers":[{"identifier":"2608.00330","identifierType":"arXiv"}],"creators":[{"nameType":"Personal","givenName":"Zach","familyName":"Cutler","name":"Cutler, Zach","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Lily W.","familyName":"Ge","name":"Ge, Lily W.","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Matthew","familyName":"Kay","name":"Kay, Matthew","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Lane","familyName":"Harrison","name":"Harrison, Lane","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Andrew","familyName":"McNutt","name":"McNutt, Andrew","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Alexander","familyName":"Lex","name":"Lex, Alexander","affiliation":[],"nameIdentifiers":[]}],"titles":[{"title":"Read, Critique, or Sketch? Investigating Alternative Visualization Literacy Assessment Modalities"}],"publisher":"arXiv","container":{},"publicationYear":2026,"subjects":[{"subject":"Human-Computer Interaction (cs.HC)","lang":"en","subjectScheme":"arXiv"},{"subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"}],"contributors":[],"dates":[{"date":"2026-07-31T22:36:08Z","dateType":"Submitted","dateInformation":"v1"},{"date":"2026-08-04T00:13:44Z","dateType":"Updated","dateInformation":"v1"},{"date":"2026-08","dateType":"Available","dateInformation":"v1"}],"language":null,"types":{"schemaOrg":"CreativeWork","resourceTypeGeneral":"Preprint","citeproc":"article","bibtex":"misc","ris":"GEN","resourceType":"Article"},"relatedIdentifiers":[],"relatedItems":[],"sizes":[],"formats":[],"version":"1","rightsList":[{"rightsIdentifierScheme":"SPDX","rightsUri":"https://creativecommons.org/licenses/by/4.0/legalcode","schemeUri":"https://spdx.org/licenses/","rights":"Creative Commons Attribution 4.0 International","rightsIdentifier":"cc-by-4.0"}],"descriptions":[{"descriptionType":"Abstract","description":"Visualization literacy is a multifaceted construct encompassing skills and competencies, such as decoding data, constructing charts, and identifying design flaws. Yet, assessments of these competencies has been primarily constrained to multiple choice assessments that target lower-order skills, such as chart comprehension. As a result, they often exhibit ceiling effects (i.e., even modestly skilled individuals commonly score near the top of the scale), and do not provide enough information about an individual's higher-order skills (e.g., applying external knowledge, formulating critiques, and designing visualizations). To close these gaps, we develop and investigate two web-based qualitative assessments for testing the critique and design aspects of visualization literacy through online think-aloud critique and sketching of visualization designs based on data and a prompt. We compare performance on our assessments to two established visualization literacy assessments, CALVI and Mini-VLAT, by administering them to three groups that represent three experience levels: crowdworkers, students who have taken a relevant course, and researchers. We find that our critique and sketching assessments capture skills distinct from existing measures and that they differentiate between experienced individuals better than multiple choice-based alternatives. Although administering and grading qualitative assessments can be challenging, our findings suggest qualitative, multimodal assessments are a promising complement to existing visualization literacy assessments, in particular when high visualization skills need to be distinguished."}],"geoLocations":[],"fundingReferences":[],"url":"https://arxiv.org/abs/2608.00330","contentUrl":null,"metadataVersion":0,"schemaVersion":"http://datacite.org/schema/kernel-4","source":"mds","isActive":true,"state":"findable","reason":null,"viewCount":0,"downloadCount":0,"referenceCount":0,"citationCount":0,"partCount":0,"partOfCount":0,"versionCount":0,"versionOfCount":0,"created":"2026-08-04T03:36:46Z","registered":"2026-08-04T03:36:47Z","published":null,"updated":"2026-08-04T03:36:47Z"},"relationships":{"client":{"data":{"id":"arxiv.content","type":"clients"}}}},{"id":"10.48550/arxiv.2608.00329","type":"dois","attributes":{"doi":"10.48550/arxiv.2608.00329","identifiers":[{"identifier":"2608.00329","identifierType":"arXiv"}],"creators":[{"nameType":"Personal","givenName":"Aleš","familyName":"Drápal","name":"Drápal, Aleš","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Andrew R.","familyName":"Kozlik","name":"Kozlik, Andrew R.","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Terry S.","familyName":"Griggs","name":"Griggs, Terry S.","affiliation":[],"nameIdentifiers":[]}],"titles":[{"title":"Flexible Latin directed triple systems"}],"publisher":"arXiv","container":{},"publicationYear":2026,"subjects":[{"subject":"Combinatorics (math.CO)","lang":"en","subjectScheme":"arXiv"},{"subject":"FOS: Mathematics","subjectScheme":"Fields of Science and Technology (FOS)"},{"subject":"05B07, 20N05","lang":"en","subjectScheme":"MSC"}],"contributors":[],"dates":[{"date":"2026-07-31T22:33:34Z","dateType":"Submitted","dateInformation":"v1"},{"date":"2026-08-04T00:13:43Z","dateType":"Updated","dateInformation":"v1"},{"date":"2026-08","dateType":"Available","dateInformation":"v1"}],"language":null,"types":{"schemaOrg":"CreativeWork","resourceTypeGeneral":"Preprint","citeproc":"article","bibtex":"misc","ris":"GEN","resourceType":"Article"},"relatedIdentifiers":[],"relatedItems":[],"sizes":[],"formats":[],"version":"1","rightsList":[{"rightsUri":"http://arxiv.org/licenses/nonexclusive-distrib/1.0/","rights":"arXiv.org perpetual, non-exclusive license"}],"descriptions":[{"descriptionType":"Abstract","description":"It is well known that, given a Steiner triple system, a quasigroup can be formed by defining an operation $\\cdot$ by the identities $x \\cdot x = x$ and $x \\cdot y = z$ where $z$ is the third point in the block containing the pair $\\{x,y\\}$. The same is true for a Mendelsohn triple system where the pair $(x,y)$ is considered to be ordered. But it is not true in general for directed triple systems. However directed triple systems which form quasigroups under this operation do exist and we call these Latin directed triple systems. The quasigroups associated with Steiner and Mendelsohn triple systems satisfy the flexible law $x \\cdot (y \\cdot x) = (x \\cdot y) \\cdot x$ but those associated with Latin directed triple systems need not. In a previous paper, [Discrete Mathematics 312 (2012), 597-607], we studied non-flexible Latin directed triple systems. In this paper we turn our attention to flexible Latin directed triple systems."}],"geoLocations":[],"fundingReferences":[],"url":"https://arxiv.org/abs/2608.00329","contentUrl":null,"metadataVersion":0,"schemaVersion":"http://datacite.org/schema/kernel-4","source":"mds","isActive":true,"state":"findable","reason":null,"viewCount":0,"downloadCount":0,"referenceCount":0,"citationCount":0,"partCount":0,"partOfCount":0,"versionCount":0,"versionOfCount":0,"created":"2026-08-04T03:36:45Z","registered":"2026-08-04T03:36:46Z","published":null,"updated":"2026-08-04T03:36:46Z"},"relationships":{"client":{"data":{"id":"arxiv.content","type":"clients"}}}},{"id":"10.48550/arxiv.2608.00327","type":"dois","attributes":{"doi":"10.48550/arxiv.2608.00327","identifiers":[{"identifier":"2608.00327","identifierType":"arXiv"}],"creators":[{"nameType":"Personal","givenName":"Amit","familyName":"Dutta","name":"Dutta, Amit","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Fat-Hy Omar","familyName":"Rajab","name":"Rajab, Fat-Hy Omar","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Marcos M.","familyName":"Vasconcelos","name":"Vasconcelos, Marcos M.","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Olugbenga M.","familyName":"Anubi","name":"Anubi, Olugbenga M.","affiliation":[],"nameIdentifiers":[]}],"titles":[{"title":"Persistent Mean Tracking in Client--Server Open Networks"}],"publisher":"arXiv","container":{},"publicationYear":2026,"subjects":[{"subject":"Optimization and Control (math.OC)","lang":"en","subjectScheme":"arXiv"},{"subject":"FOS: Mathematics","subjectScheme":"Fields of Science and Technology (FOS)"}],"contributors":[],"dates":[{"date":"2026-07-31T22:26:55Z","dateType":"Submitted","dateInformation":"v1"},{"date":"2026-08-04T00:13:38Z","dateType":"Updated","dateInformation":"v1"},{"date":"2026-08","dateType":"Available","dateInformation":"v1"}],"language":null,"types":{"schemaOrg":"CreativeWork","resourceTypeGeneral":"Preprint","citeproc":"article","bibtex":"misc","ris":"GEN","resourceType":"Article"},"relatedIdentifiers":[],"relatedItems":[],"sizes":[],"formats":[],"version":"1","rightsList":[{"rightsUri":"http://arxiv.org/licenses/nonexclusive-distrib/1.0/","rights":"arXiv.org perpetual, non-exclusive license"}],"descriptions":[{"descriptionType":"Abstract","description":"We study persistent-agent identification and mean tracking in an open client-server network where agents participate intermittently. The network consists of a core of highly regular persistent agents and a subset of transient/non-persistent agents that appear only sporadically. Since the server observes only binary activity indicators and scalar updates from active agents, naive averaging cannot recover the active persistent mean because transient-agent updates contaminate the aggregate, and heterogeneous participation introduces bias. To address this, we propose a two-phase estimation framework. In Phase I, we develop a two-layer window-based identification procedure: the first layer forms single-window activity decisions, while the second aggregates these decisions across windows to create a high-probability separation between persistent and transient agents. Under heterogeneous Bernoulli participation, we derive explicit finite-window bounds that specify how many windows the server must wait for this separation to occur with high probability. In Phase II, we use the resulting structural estimate to track the active persistent mean via a smoothing filter, and show that the tracking error contracts geometrically to a neighborhood determined by the target drift and the filter gain. We provide numerical simulations to illustrate the effectiveness of our theoretical results."}],"geoLocations":[],"fundingReferences":[],"url":"https://arxiv.org/abs/2608.00327","contentUrl":null,"metadataVersion":0,"schemaVersion":"http://datacite.org/schema/kernel-4","source":"mds","isActive":true,"state":"findable","reason":null,"viewCount":0,"downloadCount":0,"referenceCount":0,"citationCount":0,"partCount":0,"partOfCount":0,"versionCount":0,"versionOfCount":0,"created":"2026-08-04T03:36:42Z","registered":"2026-08-04T03:36:43Z","published":null,"updated":"2026-08-04T03:36:43Z"},"relationships":{"client":{"data":{"id":"arxiv.content","type":"clients"}}}},{"id":"10.48550/arxiv.2608.00324","type":"dois","attributes":{"doi":"10.48550/arxiv.2608.00324","identifiers":[{"identifier":"2608.00324","identifierType":"arXiv"}],"creators":[{"nameType":"Personal","givenName":"A.","familyName":"Steiger","name":"Steiger, A.","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"The BICEP/Keck","familyName":"Collaboration","name":"Collaboration, The BICEP/Keck","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"P. A. R.","familyName":"Ade","name":"Ade, P. A. R.","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Z.","familyName":"Ahmed","name":"Ahmed, Z.","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"M.","familyName":"Amiri","name":"Amiri, M.","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"D.","familyName":"Barkats","name":"Barkats, D.","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"R. Basu","familyName":"Thakur","name":"Thakur, R. Basu","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"C. A.","familyName":"Bischoff","name":"Bischoff, C. A.","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"D.","familyName":"Beck","name":"Beck, D.","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"J. J.","familyName":"Bock","name":"Bock, J. J.","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"H.","familyName":"Boenish","name":"Boenish, H.","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"V.","familyName":"Buza","name":"Buza, V.","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"K.","familyName":"Carter","name":"Carter, K.","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal",