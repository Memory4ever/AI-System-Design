    <!-- Accepted Papers Section -->
    <section id="accepted-papers">
        <style>
            #accepted-papers {
                padding-top: 30px;
                padding-bottom: 30px;
            }

            .papers-table-wrapper {
                max-width: 1000px;
                margin: 0 auto;
            }

            .papers-table {
                width: 100%;
                border-collapse: separate;
                border-spacing: 0;
                border-radius: 12px;
                overflow: hidden;
                box-shadow: 0 4px 24px rgba(44, 82, 130, 0.10);
            }

            .papers-table thead th {
                background: linear-gradient(135deg, #2c5282, #3b7dd8);
                color: #fff;
                font-weight: 700;
                font-size: 1.1em;
                padding: 16px 24px;
                text-align: left;
                letter-spacing: 0.5px;
                text-transform: uppercase;
            }

            .papers-table thead th:first-child {
                width: 55%;
            }

            .papers-table tbody tr {
                transition: background 0.2s ease;
            }

            .papers-table tbody tr:hover {
                background-color: #e8f0fe;
            }

            .papers-table tbody tr:nth-child(even) {
                background-color: #f8fafd;
            }

            .papers-table tbody td {
                padding: 13px 24px;
                border-bottom: 1px solid #e8ecf1;
                vertical-align: top;
                line-height: 1.5;
                font-size: 1.02em;
            }

            .papers-table tbody tr:last-child td {
                border-bottom: none;
            }

            .papers-table tbody td:first-child {
                font-weight: 600;
                color: #2d3748;
            }

            .papers-table tbody td:last-child {
                color: #5a6b7f;
            }

            .papers-pagination {
                display: flex;
                justify-content: center;
                align-items: center;
                gap: 8px;
                margin-top: 24px;
                flex-wrap: wrap;
            }

            .papers-pagination button {
                background: #fff;
                border: 1.5px solid #cbd5e0;
                border-radius: 8px;
                padding: 8px 16px;
                font-size: 0.95em;
                font-weight: 600;
                color: #2c5282;
                cursor: pointer;
                transition: all 0.2s ease;
                font-family: inherit;
            }

            .papers-pagination button:hover:not(:disabled) {
                background: #e8f0fe;
                border-color: #2c5282;
            }

            .papers-pagination button:disabled {
                opacity: 0.4;
                cursor: default;
            }

            .papers-pagination button.active {
                background: #2c5282;
                color: #fff;
                border-color: #2c5282;
            }

            @media (max-width: 768px) {
                .papers-table thead th,
                .papers-table tbody td {
                    padding: 10px 14px;
                    font-size: 0.9em;
                }
            }
        </style>
        <div class="container">
            <h2 class="section-heading" style="text-align: center;">Accepted Papers</h2>
            <div class="papers-table-wrapper">
                <table class="papers-table">
                    <thead>
                        <tr>
                            <th>Title</th>
                            <th>Authors</th>
                        </tr>
                    </thead>
                    <tbody id="papers-tbody"></tbody>
                </table>
                <div class="papers-pagination" id="papers-pagination"></div>
            </div>
        </div>
        <script>
        (function() {
            var papersData = [
                {t:"UniFusion: Vision-Language Model as Unified Encoder in Image Generation and Editing",a:"Yu-Teng Li, Manuel Brack, Sudeep Katakol, Hareesh Ravi, Ajinkya Kale"},
                {t:"Depth Over Specialization in Small Multimodal Transformers",a:"Jakub Mroz, Henry Ndubuaku"},
                {t:"Unifying Autoregressive and Discrete Diffusion Language Modeling via Cross-Regressive Decoding",a:"Dmitry Abulkhanov, Daniil Strizhakov, Maxim Panov"},
                {t:"RigidBench: Evaluating Rigid-Body Physics in Video Generation Models",a:"Swarnim Jain, Shangzhe Wu"},
                {t:"Not All Features Are Created Equal: A Mechanistic Study of Vision-Language-Action Models",a:"Bryce Grant, Xijia Zhao, Peng Wang"},
                {t:"VLM-RobustBench: A Robustness Benchmark for Vision-Language Models",a:"Rohit Saxena, Alessandro Suglia, Pasquale Minervini"},
                {t:"Bridging Generative and Predictive Paradigms via Hidden-Self-Distillation",a:"Scott C. Lowe, Anthony Fuller, Sageev Oore, Evan Shelhamer, Graham W. Taylor"},
                {t:"Multimodal Language Models Cannot Spot Spatial Inconsistencies",a:"Om Khangaonkar, Hadi J. Rad, Hamed Pirsiavash"},
                {t:"Towards Mitigating Hallucinations in Large Vision-Language Models by Refining Textual Embeddings",a:"Aakriti Agrawal, Gouthaman KV, Rohith Aralikatti, Gauri Jagatap, Jiaxin Yuan, Vijay Kamarshi, Andrea Fanelli, Furong Huang"},
                {t:"You Can Learn Tokenization End-to-End with Reinforcement Learning",a:"Sam Dauncey, Roger Wattenhofer"},
                {t:"A Single Image and Multimodality Is All You Need for Novel View Synthesis",a:"Amirhosein Javadi, Chi-Shiang Gau, Konstantinos D. Polyzos, Tara Javidi"},
                {t:"Neural Signals Generate Clinical Notes in the Wild",a:"Jathurshan Pradeepkumar, Zheng Chen, Jimeng Sun"},
                {t:"CARPE: Context-Aware Image Representation Prioritization via Ensemble for Large Vision-Language Models",a:"Dong Hee Lee, Rui Cai, Zhe Zhao"},
                {t:"Visual Representation Alignment for Multimodal Large Language Models",a:"Heeji Yoon, Jaewoo Jung, Junwan Kim, Hyungyu Choi, Heeseong Shin, Sangbeom Lim, Honggyu An, Chaehyun Kim, Jisang Han, Donghyun Kim, Chanho Eom, Sunghwan Hong, Seungryong Kim"},
                {t:"Esoteric Language Models: Bridging Autoregressive and Masked Diffusion LLMs",a:"Subham Sekhar Sahoo, Zhihan Yang, Yash Akhauri, Johnna Liu, Deepansha Singh, Zhoujun Cheng, Zhengzhong Liu, Eric P. Xing, John Thickstun, Arash Vahdat"},
                {t:"AdaTS: Adaptive Token Sampling for Efficient Speech Language Models",a:"Sonal Sannigrahi, Giuseppe Attanasio, Andre Martins"},
                {t:"GRAID: Enhancing Spatial Reasoning of VLMs through High-Fidelity Data Generation",a:"Karim Elmaaroufi, Liheng Lai, Justin Svegliato, Yutong Bai, Sanjit A. Seshia, Matei Zaharia"},
                {t:"LanteRn: Latent Visual Structured Reasoning",a:"Andre G. Viveiros, Nuno Gon\u00e7alves, Matthias Lindemann, Andre Martins"},
                {t:"Seeing to Generalize: How Visual Data Corrects Binding Shortcuts",a:"Nicolas Buzeta, Felipe del Rio, Cristian Hinostroza, Denis Parra, Hans Lobel, Rodrigo Toro Icarte"},
                {t:"Growing Visual Generative Capacity for Pre-Trained MLLMs",a:"Hanyu Wang, Jiaming Han, Ziyan Yang, Qi Zhao, Shanchuan Lin, Xiangyu Yue, Abhinav Shrivastava, Zhenheng Yang, Hao Chen"},
                {t:"Visuals Lie, Consistency Speaks: Disentangling Spatial Attention from Reliability in Vision-Language Models",a:"Logan Mann, Yi Xia, Ajit Saravanan, Ishan Dave, Saadullah Ismail, Shikhar Shiromani, Emily Huang, Ruizhe Li, Kevin Zhu"},
                {t:"MapQA: A Map-Question-Answering Benchmark for Visual Language Model Reasoning",a:"Christian Michael Arnold, Andrew Alini, Jonathan Wang, Pieter M Feenstra, Conner Arnold, Jan DeWitt, Natalie C Ritsema, Jung Hyun Yae, Boris Katz, Andrei Barbu, Brian Cheung"},
                {t:"Data Provenance for Image Auto-Regressive Generation",a:"Bihe Zhao, Louis Kerner, Michel Meintz, Tameem Bakr, Franziska Boenisch, Adam Dziedzic"},
                {t:"Vid2Sid: Videos Can Help Close the Sim2Real Gap",a:"Kevin Qiu, Yu Zhang, Marek Cygan, Josie Hughes"},
                {t:"GHVL: Geometry-Grounded Hyperbolic Vision-Language Models for Hierarchical Multimodal Representation Learning",a:"Kathy Wu, Sarthak Srivastava"},
                {t:"Rethinking Visual Information Processing in Multimodal LLMs",a:"Dongwan Kim, Viresh Ranjan, Takashi Nagata, Arnab Dhua, Amit Kumar K C"},
                {t:"Can Vision Models Process Physiological Signals? Exploring Visual Tokenization as a Representation Interface",a:"Frida M. E. Westby, Li Meng, Anis Yazidi, Ali Ramezani-Kebrya"},
                {t:"Your Autoregressive Visual Model is a Natively Multi-Token Predictor: Speculative Coupled Decoding for Fast Autoregressive Visual Generation",a:"Junhyuk So, Hyunho Kook, Chaeyeon Jang, Eunhyeok Park"},
                {t:"The Efficiency Gap in Byte Modeling",a:"Celine Lee, Jing Nathan Yan, Chen Liang, Jiaxin Shi, Yin Zhang, Jeremiah Zhe Liu, Pengcheng Yin, Ed H. Chi, Fernando Pereira, Derek Zhiyuan Cheng, Alexander M Rush, Ruoxi Wang"},
                {t:"Stop Training for the Worst: Progressive Unmasking Accelerates Masked Diffusion Training",a:"Jaeyeon Kim, Jonathan Geuter, David Alvarez-Melis, Sham M. Kakade, Sitan Chen"},
                {t:"TowerVision: Understanding and Improving Multilinguality in Vision-Language Models",a:"Andre G. Viveiros, Patrick Fernandes, Saul Santos, Sonal Sannigrahi, Emmanouil Zaranis, Nuno M Guerreiro, Amin Farajian, Graham Neubig, Andre Martins"},
                {t:"Movie Facts and Fibs (MF\u00b2): A Benchmark for Long Movie Understanding",a:"Emmanouil Zaranis, Ant\u00f3nio Farinhas, Saul Santos, Beatriz Canaverde, Miguel Moura Ramos, Wafaa Mohammed, Giuseppe Attanasio, Chrysoula Zerva, Nithin Sivakumaran, Shoubin Yu, Elena Bueno-Benito, Aditya K Surikuchi, Ben Peters, Danae Sanchez Villegas, Andre G. Viveiros, Pavlo Vasylenko, Baohao Liao, Sonal Sannigrahi, Jaehong Yoon, Elias Stengel-Eskin et al."},
                {t:"Worse Together: Understanding the Brittleness of Multimodal Models on Rare Concept Pairs",a:"Helen Qu, Sang Michael Xie"},
                {t:"Fine-Tuning Masked Diffusion for Provable Self-Correction",a:"Jaeyeon Kim, Seunggeun Kim, Taekyun Lee, David Z. Pan, Hyeji Kim, Sham M. Kakade, Sitan Chen"},
                {t:"Next-Scale Autoregression on Spectrograms for Sound Generation",a:"Eleonora Ristori, Luca Bindini, Paolo Frasconi"},
                {t:"An Efficient Training Pipeline for Reasoning Graphical User Interface Agents",a:"Georgios Pantazopoulos, Eda B. Ozyigit"},
                {t:"Beyond Seeing: Evaluating Multimodal LLMs on Tool-Enabled Image Perception, Transformation, and Reasoning",a:"Xingang Guo, Utkarsh Tyagi, Advait Gosai, Paula Vergara, Jayeon Park, Ernesto Gabriel Hern\u00e1ndez Montoya, Chen Bo Calvin Zhang, Bin Hu, Yunzhong He, Bing Liu, Rakshith Sharma Srinivasa"},
                {t:"A Systematic Study of Behavioral Cloning for Scientific Data Annotation",a:"Ishaan Singh Chandok, Core Francisco Park"},
                {t:"StarFlow: Generating Structured Workflow Outputs From Sketch Images",a:"Patrice Bechard, Chao Wang, Amirhossein Abaskohi, Juan A. Rodriguez, Christopher Pal, David Vazquez, Spandana Gella, Sai Rajeswar, Perouz Taslakian"},
                {t:"DiffuMamba: High-Throughput Diffusion LMs with Mamba Backbone",a:"Vaibhav Singh, Oleksiy Ostapenko, Pierre-Andre Noel, Eugene Belilovsky, Torsten Scholak"},
                {t:"BlockGen: Flexible Blockwise Sequence Modeling with Hybrid Samplers",a:"Justin Deschenaux, Caglar Gulcehre"},
                {t:"DISCO: Document Intelligence Suite for COmparative Evaluation",a:"Kenza Benkirane, Martin Asenov, Daniel Goldwater, Aneiss Ghodsi"},
                {t:"CRAFT-GUI: Curriculum-Reinforced Agent For GUI Tasks",a:"Songqin Nong, Xiaoxuan Tang, Jingxuan Xu, Sheng Zhou, JianfengChen, Tao Jiang, Wenhao Xu"},
                {t:"Index-Preserving Lightweight Token Pruning for Efficient Document Understanding in Vision-Language Models",a:"Jaemin Son, Sujin Choi, Inyong Yun"},
                {t:"CMRAG: Co-modality-based Visual Document Retrieval and Question Answering",a:"Wang Chen, Wenhan Yu, Guanqiang QI, Weikang Li, Yang Li, Lei Sha, Deguo Xia, Jizhou Huang"},
                {t:"City Navigation in the Wild: Exploring Emergent Navigation from Web-Scale Knowledge in MLLMs",a:"Dwip Dalal, Utkarsh Mishra, Narendra Ahuja, Nebojsa Jojic"},
                {t:"ENACT: Evaluating Embodied Cognition with World Modeling of Egocentric Interaction",a:"Qineng Wang, Wenlong Huang, Yu Zhou, Hang Yin, Tianwei Bao, Jianwen Lyu, Weiyu Liu, Ruohan Zhang, Jiajun Wu, Li Fei-Fei, Manling Li"},
                {t:"Infinity and Beyond: Compositional Alignment in VAR and Diffusion T2I Models",a:"Hossein Shahabadi, Niki Sepasian, Arash Marioriyad, Ali Sharifi-Zarchi, Mahdieh Soleymani Baghshah"},
                {t:"Can Multi-Modal LLMs Provide Live Step-by-Step Task Guidance?",a:"Apratim Bhattacharyya, Bicheng Xu, Sanjay Haresh, Reza Pourreza, Litian Liu, Sunny Panchal, Pulkit Madan, Leonid Sigal, Roland Memisevic"},
                {t:"Does Semantic Noise Initialization Transfer from Images to Videos? A Paired Diagnostic Study",a:"Yixiao Jing, Chaoyu Zhang, Zixuan Zhong, Peizhou Huang"},
                {t:"Scaling Next-Brain-Token Prediction for MEG",a:"Richard Csaky"},
                {t:"DeFacto: Counterfactual Thinking with Images for Enforcing Evidence-Grounded and Faithful Reasoning",a:"Tianrun Xu, Haoda Jing, Ye Li, Yuquan Wei, Jun Feng, Guanyu Chen, Tianren Zhang, Jing Liu, Haichuan Gao, Feng Chen"},
                {t:"Is Extending Modality The Right Path Towards Omni-Modality?",a:"Tinghui Zhu, Kai Zhang, Muhao Chen, Yu Su"},
                {t:"Zoom-Zero: Reinforced Coarse-to-Fine Video Understanding via Temporal Zoom-in",a:"Xiaoqian Shen, Min-Hung Chen, Yu-Chiang Frank Wang, Mohamed Elhoseiny, Ryo Hachiuma"},
                {t:"Diagnosing the Curse: A Scale-Consistent and All-Phase Metric for Modality Bias in MLLMs",a:"Jinlin He, Chenfei Liao, Xu Zheng, Mengyu Jin, Xuming Hu"},
                {t:"Reinforce Your Layout: Online Reward-Guided Diffusion for Layout-to-Image Generation",a:"Ruijie Li, Xiaojun Shan, Zheng Ding, Zeyuan Chen, Zhuowen Tu"},
                {t:"Efficient Multimodal Generation via Redundancy-Aware Mixture-of-Experts",a:"Raman Dutt, Harleen Hanspal, Petru-Daniel Tudosiu, Alexander Black, Yongxin Yang, Steven McDonagh, Sarah Parisot"},
                {t:"VisGym: Diverse, Customizable, Scalable Environments for Multimodal Agents",a:"Zirui Wang, Junyi Zhang, Jiaxin Ge, Long Lian, Letian Fu, Lisa Dunlap, Ken Goldberg, XuDong Wang, Ion Stoica, David M. Chan, Sewon Min, Joseph E. Gonzalez"},
                {t:"SCOPE: Selective Cross-modal Orchestration of Visual Perception Experts",a:"Tianyu Zhang, Suyuchen Wang, Chao Wang, Juan A. Rodriguez, Ahmed Masry, Xiangru Jian, Yoshua Bengio, Perouz Taslakian"},
                {t:"MLLMs are Deeply Affected by Modality Bias",a:"Xu Zheng, Chenfei Liao, Yuqian Fu, Kaiyu Lei, Yuanhuiyi Lyu, Lutao Jiang, Bin Ren, Jialei Chen, Jiawen Wang, Chengxin Li, Linfeng Zhang, Danda Pani Paudel, Xuanjing Huang, Yu-Gang Jiang, Nicu Sebe, Dacheng Tao, Luc Van Gool, Xuming Hu"}
            ];

            var PER_PAGE = 10;
            var curPage = 1;
            var totalPages = Math.ceil(papersData.length / PER_PAGE);

            function render(page) {
                curPage = page;
                var start = (page - 1) * PER_PAGE;
                var end = Math.min(start + PER_PAGE, papersData.length);
                var tbody = document.getElementById('papers-tbody');
                var html = '';
                for (var i = start; i < end; i++) {
                    html += '<tr><td>' + papersData[i].t + '</td><td>' + papersData[i].a + '</td></tr>';
                }
                tbody.innerHTML = html;

                var pag = document.getElementById('papers-pagination');
                var ph = '';
                ph += '<button ' + (page === 1 ? 'disabled' : 'onclick="window._papersGo(' + (page-1) + ')"') + '>&laquo; Prev</button>';
                for (var i = 1; i <= totalPages; i++) {
                    ph += '<button onclick="window._papersGo(' + i + ')" class="' + (i === page ? 'active' : '') + '">' + i + '</button>';
                }
                ph += '<button ' + (page === totalPages ? 'disabled' : 'onclick="window._papersGo(' + (page+1) + ')"') + '>Next &raquo;</button>';
                pag.innerHTML = ph;
            }

            window._papersGo = function(page) {
                if (page < 1 || page > totalPages) return;
                render(page);
                document.getElementById('accepted-papers').scrollIntoView({ behavior: 'smooth', block: 'start' });
            };

            render(1);
        })();
        </script>
    </section>

    <!-- Speaker Section -->
    <section id="speaker">
        <style>
            #speaker .container,
            #organization .container {
                max-width: 1200px;
                margin: 0 auto;
                padding: 0 15px;
            }

            .speakers-grid {
                display: flex;
                flex-wrap: wrap;
                justify-content: center;
                gap: 30px 60px;
                width: 100%;
                padding: 0 40px;
            }

            .speakers-grid .team-member {
                width: calc(33.333% - 60px);
                min-width: 200px;
                text-align: center;
            }

            .speakers-grid .team-member.empty-slot:nth-child(4) {
