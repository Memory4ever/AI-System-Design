                text-align: center;
            }

            .organizers-first-row .team-member:first-child img,
            .organizers-first-row .team-member:nth-child(2) img {
                width: 180px;
                height: 180px;
                margin: 0 auto;
                object-fit: cover;
            }

            .organizers-first-row .team-member:nth-child(3) img {
                width: 180px;
                height: 180px;
                margin: 0 auto;
                object-fit: cover;
            }

            .organizers-grid .team-member img,
            .organizers-second-row .team-member img {
                width: 180px;
                height: 180px;
                margin: 0 auto;
                object-fit: cover;
            }

            .organizers-first-row .team-member h4,
            .organizers-second-row .team-member h4 {
                font-weight: bold;
                font-size: 1.3em;
                color: #2c5282;
                margin-top: 15px;
            }

