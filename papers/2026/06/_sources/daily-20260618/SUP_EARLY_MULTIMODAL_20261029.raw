                border-radius: 50%;
            }

            #speaker .col-sm-2 {
                width: auto;
                padding: 0;
            }
            #organization .col-sm-2 {
                width: auto;
                padding: 0;
            }

            .sponsors-block {
                text-align: center;
                max-width: 720px;
                margin: 0 auto;
            }

            .sponsors-block .sponsor-thanks {
                font-size: 1.15em;
                line-height: 1.6;
                color: #333;
                margin-bottom: 28px;
            }

            .sponsors-block .sponsor-logo {
                display: inline-block;
                background: #1a1a1a;
                padding: 22px 32px;
                border-radius: 14px;
                line-height: 0;
                box-shadow: 0 2px 8px rgba(0, 0, 0, 0.12);
            }

            .sponsors-block .sponsor-logo:hover,
            .sponsors-block .sponsor-logo:focus {
