                vertical-align: middle;
            }

            /* Mobile Responsive Styles */
            @media (max-width: 768px) {
                /* Header adjustments */
                .intro-heading {
                    font-size: 2.5em !important;
                }

                .intro-lead-in {
                    font-size: 1.3em !important;
                }

                /* Navigation */
                .navbar-nav li a {
                    font-size: 14px !important;
                }

                /* Topics grid - stack on mobile */
                .overview-section .topics-grid {
                    grid-template-columns: 1fr !important;
                    gap: 20px !important;
                }

                /* Speakers grid - 1 column on mobile */
                .speakers-grid {
                    grid-template-columns: 1fr !important;
                    gap: 30px !important;
                    padding: 0 20px !important;
                }

                .speakers-grid .team-member img {
                    width: 150px !important;
                    height: 150px !important;
                }

                .gray-circle-placeholder {
                    width: 150px !important;
                    height: 150px !important;
                }

                /* Organizers - stack on mobile */
                .organizers-first-row {
                    grid-template-columns: 1fr !important;
                    gap: 30px !important;
                    padding: 0 20px !important;
                }

                .organizers-second-row {
                    grid-template-columns: 1fr !important;
                    gap: 30px !important;
                    padding: 0 20px !important;
                }

                .organizers-first-row .team-member img,
                .organizers-second-row .team-member img {
                    width: 150px !important;
                    height: 150px !important;
                }

                /* Section padding adjustments */
                #introduction,
                #call,
                #program,
                #speaker,
                #organization {
                    padding-top: 20px !important;
                    padding-bottom: 20px !important;
                }

                /* Container padding */
                .container {
                    padding-left: 15px !important;
                    padding-right: 15px !important;
                }

                /* Text adjustments */
                .overview-section {
                    padding: 10px 15px !important;
                }

                .overview-section .intro-text {
                    font-size: 1.2em !important;
                }

                /* Call for papers headings */
                h1 {
