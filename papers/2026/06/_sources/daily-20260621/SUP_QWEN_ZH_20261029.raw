child{width:16%}.post-content .omni-source .source-realtime-table{min-width:0}.post-content .omni-source .source-realtime-table th:nth-child(3){width:18%}.post-content .omni-source .source-realtime-table th{white-space:normal}.post-content .omni-source .source-performance-table th,.post-content .omni-source .source-performance-table td{padding:6px 7px;text-align:center;vertical-align:middle}.post-content .omni-source .source-performance-table td:not(:first-child){font-size:15px;line-height:1.2}.post-content .omni-source .source-performance-table td:first-child{padding-left:16px;text-align:left}.post-content .omni-source .source-performance-table .score-target{background:rgba(10,46,254,8%)}.post-content .omni-source .source-performance-table .score-group td{padding:6px 12px;border-bottom:1px solid rgba(10,46,254,.2);color:#0a2efe;background:#d6dafc;font-size:15px;font-weight:600;text-align:left}.post-content .omni-source .source-performance-table .metric-stack{display:flex;flex-direction:column;gap:7px;padding:3px 0}.post-content .omni-source .source-performance-table .metric-label{font-size:10px;font-weight:400;line-height:1.1;color:#777}.post-content .omni-source .source-performance-table .metric-value{margin-top:2px;font-size:15px;line-height:1.15;color:#171717}.post-content .omni-source .score-benchmark{color:#171717;font-size:15px;font-weight:600;line-height:1.22;white-space:nowrap}.post-content .omni-source .score-capability{margin-top:4px;color:#777;font-size:11px;font-weight:400;line-height:1.2}.post-content .omni-source .source-score-note{margin-top:12px;margin-bottom:14px;font-size:10px;line-height:1.4;opacity:.7}.post-content .omni-source .source-footnote-ref{font-size:10px;line-height:0;vertical-align:super}.post-content .omni-source table th,.post-content .omni-source table td{padding:6px 7px;border:0;border-bottom:1px solid rgba(128,128,128,.15);background:0 0;text-align:center;vertical-align:middle;white-space:normal;font-weight:400;line-height:1.5;min-width:0}.post-content .omni-source table th{padding:6px 7px;border-bottom:2px solid #0a2efe;color:#0a2efe;font-size:14px;font-weight:500}.post-content .omni-source table th:first-child{text-align:left;font-weight:600}.post-content .omni-source table[class] td{padding:6px 7px;border-bottom:1px solid rgba(128,128,128,.15)}.post-content .omni-source table[class] td:first-child{padding-left:20px;text-align:start}body.dark .post-content .omni-source table td{color:#e8e8e8}body.dark .post-content .omni-source table th,body.dark .post-content .omni-source .source-performance-table .score-group td{color:#8da2ff!important;border-bottom-color:#8da2ff!important}body.dark .post-content .omni-source .source-performance-table .score-group td{background:rgba(10,46,254,.22)}body.dark .post-content .omni-source .score-benchmark,body.dark .post-content .omni-source .source-performance-table .metric-value{color:#e8e8e8!important}body.dark .post-content .omni-source .score-capability,body.dark .post-content .omni-source .source-performance-table .metric-label,body.dark .post-content .omni-source .source-score-note{color:#a3a3a3!important}@media(prefers-color-scheme:dark){.post-content .omni-source table td{color:#e8e8e8}.post-content .omni-source table th,.post-content .omni-source .source-performance-table .score-group td{color:#8da2ff!important;border-bottom-color:#8da2ff!important}.post-content .omni-source .source-performance-table .score-group td{background:rgba(10,46,254,.22)}.post-content .omni-source .score-benchmark,.post-content .omni-source .source-performance-table .metric-value{color:#e8e8e8!important}.post-content .omni-source .score-capability,.post-content .omni-source .source-performance-table .metric-label,.post-content .omni-source .source-score-note{color:#a3a3a3!important}}.post-content .omni-source .source-price-table th:nth-child(2),.post-content .omni-source .source-price-table td:nth-child(2){background:rgba(10,46,254,8%)}.post-content .omni-source .source-benchmark-table th,.post-content .omni-source .source-benchmark-table td,.post-content .omni-source .source-benchmark-table th:first-child,.post-content .omni-source .source-benchmark-table td:first-child{background:0 0;text-align:center}.post-content .omni-source h2,.post-content .omni-source h3{scroll-margin-top:90px}@media(max-width:600px){.post-content .omni-source .source-price-details summary{align-items:flex-start;flex-direction:column;gap:8px}.post-content .omni-source h2{font-size:25px;line-height:35px}.post-content .omni-source h3{font-size:21px;line-height:31px}}@media print{.post-content .omni-source .source-table-scroll{overflow:visible}.post-content .omni-source table{min-width:0;max-width:100%}}.post-content .omni-source :not(pre)>code{font-family:inherit;font-size:1em;font-weight:400;line-height:inherit;color:#082dff;background-color:#eaf1ff;margin:0;padding:0 4px;border:0;border-radius:4px;letter-spacing:normal}.post-content>figure.omni-banner{margin:0 0 30px}.post-content>figure.omni-banner img{display:block;width:100%;height:auto;margin:0;border-radius:5px}.post-content .omni-source h2{border-left:4px solid #615ced;padding-left:12px;letter-spacing:-.01em}.post-content .omni-source h3{color:#141414;padding-bottom:6px;border-bottom:2px solid #f0eeff;letter-spacing:-.01em}.post-content .omni-source .source-key-highlights li>strong:first-child{color:#141414}.post-content .omni-source .source-key-highlights ul{display:grid;gap:10px;padding-left:0;list-style:none}.post-content .omni-source .source-key-highlights li{position:relative;margin:0;padding:12px 14px 12px 20px;border:1px solid transparent;border-radius:8px;color:#262626;background:0 0;transition:transform .2s ease,background-color .2s ease,border-color .2s ease,box-shadow .2s ease}.post-content .omni-source .source-key-highlights li::before{content:\"\";position:absolute;top:14px;bottom:14px;left:8px;width:3px;border-radius:999px;background:#d4d2f0;transition:background-color .2s ease}.post-content .omni-source .source-key-highlights li:hover{border-color:#d4d2f0;background:#f8f7ff;box-shadow:0 4px 14px rgba(97,92,237,.1);transform:translateY(-2px)}.post-content .omni-source .source-key-highlights li:hover::before{background:#615ced}.post-content .omni-source .omni-video-gallery .example-content{padding-top:28px;padding-bottom:32px}.post-content .omni-source .omni-video-gallery .grid-layout{display:block}.post-content .omni-source .omni-video-gallery .grid-layout .role{display:none}.post-content .omni-source .omni-video-gallery .grid-layout .content{min-width:0}.post-content .omni-source .source-result-video{margin:0}.post-content .omni-source .source-result-video video,.post-content .omni-source .source-result-item video{display:block;width:100%;max-width:100%;background:#000;border-radius:6px}.post-content .omni-source .source-result-pair{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:20px;align-items:start}.post-content .omni-source .source-result-label{margin:0 0 10px;color:var(--primary);font-size:.95rem;font-weight:700;text-align:center}@media(max-width:600px){.post-content .omni-source .source-result-pair{grid-template-columns:1fr;gap:22px}}.post-content .omni-source a.source-chapter-link:not(.btn):not(.anchor){color:#141414;font-weight:700;text-decoration:underline;text-underline-offset:3px}.post-content .omni-source .source-tool-grid{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:14px;margin:18px 0 24px}.post-content .omni-source a.source-tool-card:not(.btn):not(.anchor){display:flex;min-height:175px;padding:18px;border:1.5px solid #d4d2f0;border-radius:12px;color:#262626;background:linear-gradient(135deg,#f8f7ff 0%,#fff 100%);box-shadow:none;text-decoration:none;flex-direction:column;transition:transform .2s ease,border-color .2s ease,box-shadow .2s ease}.post-content .omni-source a.source-tool-card:hover,.post-content .omni-source a.source-tool-card:focus-visible{border-color:#615ced;box-shadow:0 4px 18px rgba(97,92,237,.15);text-decoration:none;transform:translateY(-3px)}.post-content .omni-source .source-tool-tag{align-self:flex-start;margin-bottom:10px;padding:2px 12px;border-radius:999px;color:#615ced;background:#f0eeff;font-size:.82em;font-weight:600;letter-spacing:.02em}.post-content .omni-source .source-tool-title{margin-bottom:8px;color:#3a3560;font-size:1.05em;font-weight:700;line-height:1.3}.post-content .omni-source .source-tool-desc{color:#666;font-size:.82em;line-height:1.5}.post-content .omni-source .source-tool-link{margin-top:auto;padding-top:14px;color:#615ced;font-size:.82em;font-weight:600}.post-content .omni-source .source-tool-link span{display:inline-block;transition:transform .2s ease}.post-content .omni-source .source-tool-card:hover .source-tool-link span,.post-content .omni-source .source-tool-card:focus-visible .source-tool-link span{transform:translateX(4px)}@media(max-width:600px){.post-content .omni-source .source-tool-grid{grid-template-columns:1fr}.post-content .omni-source a.source-tool-card:not(.btn):not(.anchor){min-height:150px}}.post-content .omni-source .source-performance-table th,.post-content .omni-source .source-performance-table td{overflow-wrap:anywhere}.post-content .omni-source .source-performance-table .score-benchmark{white-space:normal}.post-content .omni-source table.source-performance-table th,.post-content .omni-source table.source-performance-table td{padding-left:5px;padding-right:5px}.post-content .omni-source table.source-performance-table td:first-child{padding-left:8px}.post-content .omni-source .source-language-table{min-width:0;overflow-wrap:anywhere}.post-content .omni-source table.source-agentic-understanding-table{width:100%!important;table-layout:fixed}.post-content .omni-source .source-agentic-understanding-table th:first-child{width:24%}.post-content .omni-source table.source-agentic-understanding-table th,.post-content .omni-source table.source-agentic-understanding-table td{padding:12px 8px;overflow-wrap:normal;word-break:normal}.post-content .omni-source .source-agentic-understanding-table th{vertical-align:bottom;line-height:1.35}.post-content .omni-source .source-agentic-understanding-table .score-benchmark{overflow-wrap:anywhere}.post-content .omni-source .source-agentic-understanding-table td:not(:first-child){font-variant-numeric:tabular-nums}@media(max-width:600px){.post-content .omni-source table.source-agentic-understanding-table th,.post-content .omni-source table.source-agentic-understanding-table td{padding:10px 4px;overflow-wrap:anywhere}}.post-content .omni-source table.source-language-table{width:100%!important;min-width:0;table-layout:fixed}.post-content .omni-source table.source-language-table th,.post-content .omni-source table.source-language-table td{padding:14px 16px;text-align:left;vertical-align:top;line-height:1.75;word-break:normal;overflow-wrap:normal}.post-content .omni-source table.source-language-table th{background:rgba(10,46,254,4%)}.post-content .omni-source table.source-language-table td:first-child{padding-left:16px;background:rgba(10,46,254,.025)}.post-content .omni-source .source-language-table td:not(:first-child)>strong{display:block;margin-bottom:6px}@media(max-width:600px){.post-content .omni-source table.source-language-table th,.post-content .omni-source table.source-language-table td{padding:10px 6px;overflow-wrap:anywhere}}@media(max-width:900px){.post-content .omni-source table.source-performance-table{min-width:760px!important}.post-content .omni-source table.source-language-table{min-width:780px!important}}</style><figure class=omni-banner><img src=https://qianwen-res.oss-cn-beijing.aliyuncs.com/Qwen3.8-Omni-Flash/banner-latest.png alt=Qwen3.8-Omni-Flash：耳聪目明，办事得力 width=100%></figure><div class=omni-source><nav class=source-resource-links aria-label=相关资源><a href=https://chat.qwen.ai class=\"btn external\" target=_blank>QWEN STUDIO</a>\n<a href=https://github.com/QwenLM/Qwen-Live-Harness class=\"btn external\" target=_blank>QWEN-LIVE HARNESS</a>\n<a href=https://github.com/QwenLM/Qwen-MM-Plugins class=\"btn external\" target=_blank>QWEN-MM-PLUGINS</a>\n<a href=https://help.aliyun.com/zh/model-studio/qwen-omni class=\"btn external\" target=_blank>QWEN3.8-OMNI-FLASH API</a>\n<a href=https://help.aliyun.com/zh/model-studio/realtime class=\"btn external\" target=_blank>QWEN3.8-OMNI-FLASH-REALTIME API</a></nav><h2 id=lFNA4>引言<a hidden class=anchor aria-hidden=true href=#lFNA4>#</a></h2><p>今天，新一代原生全模态模型 <strong><a href=https://help.aliyun.com/zh/model-studio/qwen-omni>Qwen3.8-Omni-Flash</a></strong> 正式上线。该模型的核心目标是提升其在真实生产力场景中的 Agent 能力，推动全模态模型从“理解全模态内容”进一步走向“规划任务、调用工具并完成创作”。在具备编程、文本知识工作和 GUI 操作等通用 Agentic 能力的基础上，Qwen3.8-Omni-Flash 进一步拓展了以音视频为核心的 Agentic 应用，在视频剪辑、音乐视频创作、影视制作与解说、音视频转图文摘要和音视频对话等需要综合处理文本、图像、音频与视频的工作流中取得了显著效果。</p><figure class=source-wide-figure><img src=https://qianwen-res.oss-cn-beijing.aliyuncs.com/Qwen3.8-Omni-Flash/production-overview-v2.png#center alt=\"Qwen3.8-Omni-Flash 与其在生产环境中的应用\" width=100%><figcaption><p>图 1：Qwen3.8-Omni-Flash 与其在生产环境中的应用</p></figcaption></figure><ul style=\"font-size:.75em;border:1px solid #c4b5fd;border-radius:7px;padding:14px 22px;margin:15px 0;list-style:disc;list-style-position:inside\"><li><strong>Qwen3.8-Omni-Flash</strong>——现已上线 <a href=https://www.qianwenai.com/ target=_blank rel=\"noopener noreferrer\">千问AI平台</a>：<ul style=margin-top:4px><li>支持文本、图像、音频和视频输入，以及 <strong>1M 长上下文</strong>。</li></ul></li></ul><p>Qwen3.8-Omni-Flash 支持 1M 长序列，在保持与同尺寸文本模型相当的文本能力的同时，全模态能力显著提升。在累计 29 项评测中<sup class=source-footnote-ref>1</sup>，相比上一代 Qwen3.5-Omni-Plus，平均得分提升超过 25%；API 每小时音频输入价格降幅超过 98%，每小时音视频输入价格降幅超过 93%<sup class=source-footnote-ref>2</sup>。在音视频 Agent、Coding 和长程任务方面，模型在 WildClawBench-MM 上大幅提升 36.5 分，在 AgenticVBench 上提升 22.3 分，并在 UniClawBench 上取得 69.6 的高分。基础能力方面，模型在长音频/音视频理解、音视频推理、音视频 Caption 和多说话人识别上均有明显提升：例如，LongAudioSpan 提升 8.3 分，OmniVideoBench 提升 9.6 分，OmniCap-IF 的 CSR / ISR 分别提升 8.5 / 14.1 分，AliMeeting 的 DER / cpWER 从 88.11 / 89.61 降至 3.35 / 17.18。通过扩展数据、上下文与 Agentic Environment，Qwen3.8-Omni-Flash 的<strong>音视频能力接近 Gemini 3.8 Flash，音频能力整体超过 Gemini 3.8 Flash</strong>。这些能力的进一步提升，也意味着音视频正在从模型的感知输入，进一步成为 Agent 理解环境、开展推理并执行任务的核心载体。</p><p class=source-score-note style=margin-top:12px;font-size:10px;line-height:1.4;opacity:.7>1. 范围包括：音频推理：AliMeeting-test、AISHELL-4、MagicData-RAMC、MLC-SLM (en)、WenetSpeech (Net | Meeting)、FLEURS-60 ASR、FLEURS-60 S2TT、SpotSoundBench、MMAU、MMAR、MMSU、MuchoMusic-RUL、HumMusQA、MusTBench、Audio-MultiChallenge、WildSpeech、VoiceBench。音视频推理：DailyOmni、WorldSense、AVUT、JointAVBench、OmniCloze、OmniCap-IF、QIVD、OmniVideoBench、StreamingBench。音视频 Agent：WildClawBench-MM、UniClawBench、OmniGAIA。<br>2. 价格计算说明：音频或音视频每小时价格按 2 分钟素材的输入成本×30 估算；音视频采用 720p、1 fps。Gemini 3.8 Flash 使用 media_resolution=high，Seed 2.0 Lite 使用 max_frame_tokens=384，其他 API 参数使用默认值。文本输入与输出价格单位为 CNY/1M tokens；Gemini 与 Muse 的人民币价格按美元换算，汇率为 1 USD = 6.7191 CNY。</p><figure><img src=\"https://qianwen-res.oss-cn-beijing.aliyuncs.com/Qwen3.8-Omni-Flash/performance-overview-v2.png?v=20260916-2204\" alt=\"Qwen3.8-Omni-Flash 价格与代表性 Benchmark 对比\" width=100%></figure><p>音视频是 Agent 走向真实生产力场景的重要载体，但也带来了一组新的系统挑战：长音视频的文件存储、网络传输与多轮推理成本高昂，现有 Agent Harness 框架缺乏对音视频的原生支持，而从全模态理解到端到端任务执行的工作范式仍处于早期阶段。解决这些问题，需要模型、Harness 工具与运行环境协同演进。</p><p>围绕这些挑战，我们在 Qwen3.8-Omni-Flash 上探索了如何贯穿素材理解、任务规划、工具执行与结果交付的完整链路，完成视频剪辑、翻译、电影解说和内容创作等端到端长程工作流，推动 Omni 从理解音视频进一步走向自主行动与任务交付。</p><p>为此，我们进一步扩展了 Qwen-MM-Plugins，为长音视频的按需感知、工具调用与工作流执行提供支持；同时开源 Qwen-Live Harness，为实时、持续的全模态交互提供原生运行环境。两者分别面向长程工作流与实时交互，并在与模型的共同迭代中持续拓展全模态 Agent 的能力边界。</p><div class=source-tool-grid><a class=source-tool-card href=#IbE99><span class=source-tool-tag>PLUGIN</span>\n<span class=source-tool-title>Qwen-MM-Plugins</span>\n<span class=source-tool-desc>音视频生产力入口——连接多模态理解、内容创作与 Agent Harness。</span>\n<span class=source-tool-link>开始使用 <span aria-hidden=true>→</span></span>\n</a><a class=source-tool-card href=#iTpXF><span class=source-tool-tag>HARNESS</span>\n<span class=source-tool-title>Qwen-Live Harness</span>\n<span class=source-tool-desc>实时交互入口——连接音视频对话、任务委托、记忆与上下文管理。</span>\n<span class=source-tool-link>开始使用 <span aria-hidden=true>→</span></span></a></div><h2 id=yejLW>长音视频理解<a hidden class=anchor aria-hidden=true href=#yejLW>#</a></h2><p>Qwen3.8-Omni-Flash 实现了长音视频理解能力的全新升级：从按需描述、Agentic 主动取证，到理解并推进会议任务，再到生成以视频为中心的深度研究报告；不只是看得更久，更能找得准、理解深、执行快。</p><h3 id=LQzOj>可控音视频 Caption<a hidden class=anchor aria-hidden=true href=#LQzOj>#</a></h3><p>视频描述不应只有一种答案，内容创作关心叙事，素材检索关心片段，资产管理关心结构。不同业务，需要不同的视频描述。在 Qwen3.8-Omni-Flash 中，我们对视频描述能力进行了全新升级：从回答“模型看到了什么”，走向理解“用户想知道什么”。描述对象、时间范围、信息粒度与输出格式均可自由指定；面对同一段视频，既能纵览全貌、定位关键片段，也能<strong>深入分析人物动作、镜头、光影与声音，并按需输出结构化结果</strong>。看什么、看多细、怎么呈现，由你定义。</p><figure><video controls src=https://qianwen-res.oss-cn-beijing.aliyuncs.com/Qwen3.8-Omni-Flash/demo-06-audio-video-caption.zh.mp4></video></figure><h3 id=ctcGg>Agentic 长音视频理解<a hidden class=anchor aria-hidden=true href=#ctcGg>#</a></h3><p>面对数小时的长视频，传统方法通常需要从头到尾处理全部内容，即使答案只存在于其中几分钟的片段内。Qwen3.8-Omni-Flash 原生 Agent 则从问题出发，<strong>自主决定该看什么、听什么，并通过由粗到细的多轮取证定位关键信息</strong>。它无需逐帧处理整部视频，即可将有限的计算与 Token 预算集中在真正相关的片段上，实现更高效的长视频理解。OmniVideoBench 实验表明，Agentic Understanding 将<strong>准确率从 63.4 提升至 67.8</strong>，同时将 Token 消耗从 145,736 降至 79,117，<strong>降幅约为 45.7%</strong>。下表对比了 Static Understanding 与 Agentic Understanding 在 OmniVideoBench 上的准确率及 Token 消耗：</p><div class=\"source-table-scroll source-wide-benchmark\" style=margin-bottom:24px role=region aria-label=\"Static Understanding 与 Agentic Understanding 对比表\" tabindex=0><table class=source-benchmark-table><caption class=source-score-note style=text-align:left;font-size:10px;line-height:1.4>注：Agentic 模式在多轮交互中保留上下文。</caption><col style=width:26.4%><col style=width:36.8%><col style=width:36.8%><thead><tr><th scope=col style=text-align:left></th><th scope=col style=text-align:center>Static Understanding</th><th scope=col style=text-align:center>Agentic Understanding</th></tr></thead><tbody><tr><td style=text-align:left>Accuracy (↑)</td><td style=text-align:center>63.4</td><td style=text-align:center>67.8</td></tr><tr><td style=text-align:left>Tokens per query (↓)</td><td style=text-align:center>145,736</td><td style=text-align:center>79,117</td></tr></tbody></table></div><figure><video controls src=\"https://qianwen-res.oss-cn-beijing.aliyuncs.com/Qwen3.8-Omni-Flash/demo-01-long-video-qa.zh.mp4?v=20260917-1116\"></video></figure><h3 id=S0bBD>长会议，从记录到执行<a hidden class=anchor aria-hidden=true href=#S0bBD>#</a></h3><p>多人会议是音视频理解中最复杂的场景之一：多人交替发言、声音相互重叠，人物身份、指代关系与讨论主题持续变化。Qwen3.8-Omni-Flash 具备<strong>多说话人音画协同识别能力</strong>，原生支持<strong>最长一小时</strong>的音视频输入，能够<strong>联合理解人物画面与语音内容，端到端完成说话人切分、内容转录与身份对应</strong>。输入完整会议视频并描述需求，模型即可梳理参会者关系、生成会议纪要与待办事项，并分析项目风险；同时借助视觉信息解决音频中的指代与实体歧义。结合 Agent 与工具调用，它还能发送邮件、整理任务，甚至依据会议需求直接开始编码。从听懂会议，进一步走向执行工作。</p><figure><video controls src=https://qianwen-res.oss-cn-beijing.aliyuncs.com/Qwen3.8-Omni-Flash/demo-07-long-meeting.zh.mp4></video></figure><h3 id=vaZFL>通过音视频开展深度研究<a hidden class=anchor aria-hidden=true href=#vaZFL>#</a></h3><p>当用户带着具体问题观看视频时，所需的答案往往不止于视频本身。Qwen3.8-Omni-Flash 能结合用户需求与视频内容，挖掘值得深入研究的问题，梳理视频重点，并检索网页、图片、视频和文档等多模态资料，生成以视频为中心、图文并茂的研究报告，帮助用户深入理解视频内容、解决实际问题。例如，用户在 Photoshop 抠发时遇到彩边问题，模型可以拆解教程步骤、研究 Multiply / Screen 混合模式的原理、对比其他边缘修复方案，帮助用户理解不同方法的适用条件，判断哪种方案更适合自己的情况。</p><iframe src=https://docs.qwenlm.ai/resources/qwen3.8-omni-flash/omnidr-demo-0813-0600.51939eff.html title=\"Qwen3.8-Omni-Flash 通过音视频开展深度研究 Demo\" width=100% height=720 style=border:none;border-radius:8px;max-width:1080px;display:block;margin:var(--content-gap)auto;overflow:hidden allowfullscreen loading=lazy></iframe><h2 id=PBrMh>音视频生产与编辑<a hidden class=anchor aria-hidden=true href=#PBrMh>#</a></h2><p>Qwen3.8-Omni-Flash 正在将音视频 Agent 推向新的阶段：<strong>从理解声音与画面，到自主规划、调用工具并交付成片</strong>，让全模态智能真正进入专业音视频内容生产流程。</p><h3 id=qIrHQ>Music2MV<a hidden class=anchor aria-hidden=true href=#qIrHQ>#</a></h3><p>以音乐视频（MV）创作为例，Qwen3.8-Omni-Flash 能够细粒度、精准地理解用户输入歌曲的结构、节奏、情绪、人声与乐器变化，为人物、场景和镜头设计提供灵感。它还能输出带时间戳的句级歌词，让歌声、字幕与画面精准配合。结合 Qwen-MM-Plugins 等创作工具，模型可贯穿音乐理解、创意规划与成片质检，展现强大的音视频理解、推理和创作能力。</p><div class=\"full-width-container example-container omni-video-gallery\"><div class=example-content><div class=title><span>工作流程</span>\n<a class=next-button>Next</a></div><div class=grid-layout><div class=role></div><div class=content><div class=source-result-video><figure><video controls src=https://qianwen-res.oss-cn-beijing.aliyuncs.com/Qwen3.8-Omni-Flash/demo-03-music2mv.zh.mp4></video></figure></div></div></div></div><div class=example-content style=display:none><div class=title><span>最终结果 1</span>\n<a class=next-button>Next</a></div><div class=grid-layout><div class=role></div><div class=content><div class=source-result-video><figure><video controls src=https://qianwen-res.oss-cn-beijing.aliyuncs.com/Qwen3.8-Omni-Flash/music2mv-result-1.mp4></video></figure></div></div></div></div><div class=example-content style=display:none><div class=title><span>最终结果 2</span>\n<a class=next-button>Next</a></div><div class=grid-layout><div class=role></div><div class=content><div class=source-result-video><figure><video controls src=https://qianwen-res.oss-cn-beijing.aliyuncs.com/Qwen3.8-Omni-Flash/music2mv-result-2.mp4></video></figure></div></div></div></div><div class=example-content style=display:none><div class=title><span>最终结果 3</span>\n<a class=next-button>Next</a></div><div class=grid-layout><div class=role></div><div class=content><div class=source-result-video><figure><video controls src=https://qianwen-res.oss-cn-beijing.aliyuncs.com/Qwen3.8-Omni-Flash/music2mv-result-3.mp4></video></figure></div></div></div></div></div><h3 id=uyAwo>短剧翻译<a hidden class=anchor aria-hidden=true href=#uyAwo>#</a></h3><p>传统视频翻译往往需要在转写、翻译、配音和剪辑平台之间反复切换，不仅 API 调用与流程衔接复杂，也难以保证多角色音色、台词时长与画面节奏的一致性。借助 Qwen3.8-Omni-Flash 构建的 Agent，用户只需一句话描述需求，即可按需完成区分角色的台词识别、口语化翻译、角色克隆配音、音轨重混与成片质检，将原本割裂的译制环节串联为完整流程，实现短剧视频出海的自动化交付。</p><div class=\"full-width-container example-container omni-video-gallery\"><div class=example-content><div class=title><span>工作流程</span>\n<a class=next-button>Next</a></div><div class=grid-layout><div class=role></div><div class=content><div class=source-result-video><figure><video controls src=https://qianwen-res.oss-cn-beijing.aliyuncs.com/Qwen3.8-Omni-Flash/demo-02-video-translation.zh.mp4></video></figure></div></div></div></div><div class=example-content style=display:none><div class=title><span>最终结果 1</span>\n<a class=next-button>Next</a></div><div class=grid-layout><div class=role></div><div class=content><div class=source-result-pair><div class=source-result-item><p class=source-result-label>原始视频</p><figure><video controls src=https://qianwen-res.oss-cn-beijing.aliyuncs.com/Qwen3.8-Omni-Flash/drama-result-1-source.mp4></video></figure></div><div class=source-result-item><p class=source-result-label>翻译结果</p><figure><video controls src=https://qianwen-res.oss-cn-beijing.aliyuncs.com/Qwen3.8-Omni-Flash/drama-result-1-translated.mp4></video></figure></div></div></div></div></div><div class=example-content style=display:none><div class=title><span>最终结果 2</span>\n<a class=next-button>Next</a></div><div class=grid-layout><div class=role></div><div class=content><div class=source-result-pair><div class=source-result-item><p class=source-result-label>原始视频</p><figure><video controls src=https://qianwen-res.oss-cn-beijing.aliyuncs.com/Qwen3.8-Omni-Flash/drama-result-2-source.mp4></video></figure></div><div class=source-result-item><p class=source-result-label>翻译结果</p><figure><video controls src=https://qianwen-res.oss-cn-beijing.aliyuncs.com/Qwen3.8-Omni-Flash/drama-result-2-translated.mp4></video></figure></div></div></div></div></div><div class=example-content style=display:none><div class=title><span>最终结果 3</span>\n<a class=next-button>Next</a></div><div class=grid-layout><div class=role></div><div class=content><div class=source-result-pair><div class=source-result-item><p class=source-result-label>原始视频</p><figure><video controls src=https://qianwen-res.oss-cn-beijing.aliyuncs.com/Qwen3.8-Omni-Flash/drama-result-3-source.mp4></video></figure></div><div class=source-result-item><p class=source-result-label>翻译结果</p><figure><video controls src=https://qianwen-res.oss-cn-beijing.aliyuncs.com/Qwen3.8-Omni-Flash/drama-result-3-translated.mp4></video></figure></div></div></div></div></div></div><h3 id=hEa0g>长电影解说<a hidden class=anchor aria-hidden=true href=#hEa0g>#</a></h3><p>面对动辄两三小时的完整影片，电影解说视频的制作往往需要人工反复观看和梳理剧情，并完成镜头筛选、文案撰写、配音配乐与剪辑包装，制作流程繁琐、耗时耗力。基于 Qwen3.8-Omni-Flash 构建的 Agent，用户只需提供影片并用一句话描述创作需求，即可完成长视频全模态理解、关键情节提炼、解说规划、配音配乐、剪辑渲染与成片质检。Agent 还能智能穿插电影原声对白与解说配音，自动调节语速和音量，让解说、原声、背景音乐与画面自然衔接，打造更具真实感、代入感与“电影质感”的解说作品。</p><div class=\"full-width-container example-container omni-video-gallery\"><div class=example-content><div class=title><span>工作流程</span>\n<a class=next-button>Next</a></div><div class=grid-layout><div class=role></div><div class=content><div class=source-result-video><figure><video controls src=https://qianwen-res.oss-cn-beijing.aliyuncs.com/Qwen3.8-Omni-Flash/demo-04-long-video-editing.zh.mp4></video></figure></div></div></div></div><div class=example-content style=display:none><div class=title><span>最终结果 1</span>\n<a class=next-button>Next</a></div><div class=grid-layout><div class=role></div><div class=content><div class=source-result-video><figure><video controls src=https://qianwen-res.oss-cn-beijing.aliyuncs.com/Qwen3.8-Omni-Flash/movie-commentary-result-1.zh.mp4></video></figure></div></div></div></div><div class=example-content style=display:none><div class=title><span>最终结果 2</span>\n<a class=next-button>Next</a></div><div class=grid-layout><div class=role></div><div class=content><div class=source-result-video><figure><video controls src=https://qianwen-res.oss-cn-beijing.aliyuncs.com/Qwen3.8-Omni-Flash/movie-commentary-result-2.zh.mp4></video></figure></div></div></div></div></div><h2 id=DK1I3>从使用模型，到优化模型<a hidden class=anchor aria-hidden=true href=#DK1I3>#</a></h2><p>真实的多模态业务往往复杂且成本敏感，模型往往需要在效果、时延、算力与部署成本之间取得平衡。</p><p>因此，面向具体场景定制小模型，是规模化业务应用的重要路径。然而，传统流程涉及数据构建、问题诊断、多轮训练与效果评测，周期长且高度依赖人工经验。这一次，我们进一步尝试将 Qwen3.8-Omni-Flash 推进到模型研发本身，探索“大模型负责研发、小模型面向业务”的新范式。</p><p>我们向 Qwen3.8-Omni-Flash 提出了一项任务：<strong>在 12 小时内提升 Qwen2.5-Omni-3B 的四川话识别能力，并交付可用模型</strong>。它自主选定 WenetSpeech-Chuan 评测集、固定评测标准并完成基线测试，随后直接听取语音样本，结合识别结果诊断问题，构建针对性的训练数据。在连续 4 轮实验中，Agent 累计构建了 3,413 条训练数据，并根据评测反馈调整方案、保留有效改进、回退无效尝试。<strong>最终，Qwen2.5-Omni-3B 在同一评测集上的字符错误率从 25.79% 降至 15.30%，相对下降约 40.7%</strong>。</p><p>这项实验展示了另一种模型演进的可能：通用多模态模型负责理解数据、规划实验与驱动迭代，小模型则沉淀面向具体业务的专用能力。Agent 不再只是调用模型，还能参与模型优化并解决实际业务问题。</p><figure><video controls src=https://qianwen-res.oss-cn-beijing.aliyuncs.com/Qwen3.8-Omni-Flash/demo-05-model-optimization.zh.mp4></video></figure><h2 id=LEJfl>音视频信息压缩<a hidden class=anchor aria-hidden=true href=#LEJfl>#</a></h2><p>音视频承载着丰富的信息，但其线性、非结构化的形态也让检索和复用变得困难。Qwen3.8-Omni-Flash 可以跨越声音、画面与时间线理解内容，并通过 Agentic 的方式完成信息提炼、结构重组与结果校验，<strong>将长视频中的核心知识与实践经验转化为信息密度更高、更易获取和复用的内容资产</strong>。</p><h3 id=Ny3wx>Video2Note<a hidden class=anchor aria-hidden=true href=#Ny3wx>#</a></h3><p>围绕视频知识的结构化沉淀，我们在 Qwen-MM-Plugins 中开源了 Video2Note。依托 Qwen3.8-Omni-Flash 对语音、画面与操作过程的联合理解，它能够自动梳理知识结构、拆解关键步骤、筛选代表性画面，并生成图文对应的 PDF 笔记；同时通过自动审阅与迭代修正，将数小时的视频内容压缩为清晰、易读、便于复习的文档资产。</p><div class=\"full-width-container example-container omni-video-gallery\"><div class=example-content><div class=title><span>工作流程</span>\n<a class=next-button>Next</a></div><div class=grid-layout><div class=role></div><div class=content><div class=source-result-video><figure><video controls src=\"https://qianwen-res.oss-cn-beijing.aliyuncs.com/Qwen3.8-Omni-Flash/demo-09-video2note.zh.mp4?v=20260916-1830\"></video></figure></div></div></div></div><div class=example-content style=display:none><div class=title><span>最终结果 1</span>\n<a class=next-button>Next</a></div><div class=grid-layout><div class=role></div><div class=content><div class=source-result-pair><div class=source-result-item><p class=source-result-label>案例视频</p><figure><video controls src=https://qianwen-res.oss-cn-beijing.aliyuncs.com/Qwen3.8-Omni-Flash/video2note/cat-claw-trimming.zh.mp4></video></figure></div><div class=source-result-item><p class=source-result-label>最终 PDF</p><div class=pdf-container style=height:360px;overflow:hidden><object data=\"https://qianwen-res.oss-cn-beijing.aliyuncs.com/Qwen3.8-Omni-Flash/video2note/cat-claw-trimming.zh.pdf#view=Fit&toolbar=1\" type=application/pdf width=100% height=100%>\nYour browser does not support PDF. <a href=https://qianwen-res.oss-cn-beijing.aliyuncs.com/Qwen3.8-Omni-Flash/video2note/cat-claw-trimming.zh.pdf>Download PDF</a></object></div></div></div></div></div></div><div class=example-content style=display:none><div class=title><span>最终结果 2</span>\n<a class=next-button>Next</a></div><div class=grid-layout><div class=role></div><div class=content><div class=source-result-pair><div class=source-result-item><p class=source-result-label>案例视频</p><figure><video controls src=https://qianwen-res.oss-cn-beijing.aliyuncs.com/Qwen3.8-Omni-Flash/video2note/newborn-bathing.zh.mp4></video></figure></div><div class=source-result-item><p class=source-result-label>最终 PDF</p><div class=pdf-container style=height:360px;overflow:hidden><object data=\"https://qianwen-res.oss-cn-beijing.aliyuncs.com/Qwen3.8-Omni-Flash/video2note/newborn-bathing.zh.pdf#view=Fit&toolbar=1\" type=application/pdf width=100% height=100%>\nYour browser does not support PDF. <a href=https://qianwen-res.oss-cn-beijing.aliyuncs.com/Qwen3.8-Omni-Flash/video2note/newborn-bathing.zh.pdf>Download PDF</a></object></div></div></div></div></div></div><div class=example-content style=display:none><div class=title><span>最终结果 3</span>\n<a class=next-button>Next</a></div><div class=grid-layout><div class=role></div><div class=content><div class=source-result-pair><div class=source-result-item><p class=source-result-label>案例视频</p><figure><video controls src=https://qianwen-res.oss-cn-beijing.aliyuncs.com/Qwen3.8-Omni-Flash/video2note/bicycle-chain-cleaning.en.mp4></video></figure></div><div class=source-result-item><p class=source-result-label>最终 PDF</p><div class=pdf-container style=height:360px;overflow:hidden><object data=\"https://qianwen-res.oss-cn-beijing.aliyuncs.com/Qwen3.8-Omni-Flash/video2note/bicycle-chain-cleaning.en.pdf#view=Fit&toolbar=1\" type=application/pdf width=100% height=100%>\nYour browser does not support PDF. <a href=https://qianwen-res.oss-cn-beijing.aliyuncs.com/Qwen3.8-Omni-Flash/video2note/bicycle-chain-cleaning.en.pdf>Download PDF</a></object></div></div></div></div></div></div><div class=example-content style=display:none><div class=title><span>最终结果 4</span>\n<a class=next-button>Next</a></div><div class=grid-layout><div class=role></div><div class=content><div class=source-result-pair><div class=source-result-item><p class=source-result-label>案例视频</p><figure><video controls src=https://qianwen-res.oss-cn-beijing.aliyuncs.com/Qwen3.8-Omni-Flash/video2note/calorimetry-experiment.en.mp4></video></figure></div><div class=source-result-item><p class=source-result-label>最终 PDF</p><div class=pdf-container style=height:360px;overflow:hidden><object data=\"https://qianwen-res.oss-cn-beijing.aliyuncs.com/Qwen3.8-Omni-Flash/video2note/calorimetry-experiment.en.pdf#view=Fit&toolbar=1\" type=application/pdf width=100% height=100%>\nYour browser does not support PDF. <a href=https://qianwen-res.oss-cn-beijing.aliyuncs.com/Qwen3.8-Omni-Flash/video2note/calorimetry-experiment.en.pdf>Download PDF</a></object></div></div></div></div></div></div></div><h3 id=PzS6X>Omni Skill Creator<a hidden class=anchor aria-hidden=true href=#PzS6X>#</a></h3><p>视频不仅记录了“怎么做”，也承载着专家在实践中积累的经验技巧。基于这一思路，我们将 Omni Skill Creator 作为 Qwen-MM-Plugins 的全新开源能力：它既可以从操作演示中提炼标准作业流程（SOP），并将其转化为可复用的自动化流程，也可以从专家教学中学习工具使用、决策依据与关键经验。一次演示教学即可转化为经过校验和评测的 Agent Skill，实现基于全模态内容构建可复用、可传播的 Agent Skill。</p><figure><video controls src=https://qianwen-res.oss-cn-beijing.aliyuncs.com/Qwen3.8-Omni-Flash/demo-08-omni-skill.zh.mp4></video></figure><h2 id=JMLHM>音视频实时交互<a hidden class=anchor aria-hidden=true href=#JMLHM>#</a></h2><p>Qwen3.8-Omni-Flash 面向完整音视频的深度理解与创作；面向持续、低延迟的交互场景，我们进一步带来 <strong>Qwen3.8-Omni-Flash-Realtime</strong>。它能够在音视频流输入的同时完成感知与响应，并结合实时上下文调用工具、执行任务，让全模态能力从“理解一段内容”走向“参与一场交互”。</p><h3 id=LDPX9>实时口语陪练<a hidden class=anchor aria-hidden=true href=#LDPX9>#</a></h3><p>口语世界没有标准输入。口音、元辅音替换与声调偏差，都会让逐字转写偏离真实语义。Qwen3.8-Omni-Flash-Realtime 联合建模发音与语义，能够理解受口音影响的非标准表达，将其对齐到正确词汇，并实时生成标准发音示范。在多轮练习中，模型根据新的语音持续更新判断：纠正影响理解的错误，同时保留自然的节奏、语气与情感。</p><figure><video controls src=https://qianwen-res.oss-cn-beijing.aliyuncs.com/Qwen3.8-Omni-Flash/demo-10-speaking-practice.zh.mp4></video></figure><h3 id=krrHD>全模态空间音频感知<a hidden class=anchor aria-hidden=true href=#krrHD>#</a></h3><p>在真实空间中，声音是视觉之外的另一条坐标轴。Qwen3.8-Omni-Flash-Realtime 融合空间声音与视觉信息，持续判断声源方向和距离，并同步感知障碍、通行区域与场景变化，是首个支持“听声辨位”的全模态大模型。</p><p>面对“过来这里”或“去看看是什么在响”等指令，模型能够从环境噪声中锁定人声与目标声音，将语义落到现场空间，并调用工具完成定位、搜索、路径规划与导航。从听见目标，到抵达目标。</p><figure><video controls src=\"https://qianwen-res.oss-cn-beijing.aliyuncs.com/Qwen3.8-Omni-Flash/demo-13-robot-navigation.zh.mp4?v=20260916-1830\"></video></figure><h3 id=sWJfF>音视频外部知识接入<a hidden class=anchor aria-hidden=true href=#sWJfF>#</a></h3><p>实时交互不仅需要低延迟，也需要随业务动态加载知识与行为。Qwen3.8-Omni-Flash-Realtime 支持通过 Skill 注入身份设定、表达风格、业务知识与交互规则，并通过工具调用将这些能力延伸到任务执行。</p><p>在智能客服等场景中，模型可以实时加载品牌话术与服务流程，理解用户的语音、画面与上下文，生成符合业务规范的回应并执行操作。同一个实时模型，由此可以拥有不同的知识、角色与行动方式。</p><figure><video controls src=https://qianwen-res.oss-cn-beijing.aliyuncs.com/Qwen3.8-Omni-Flash/demo-11-custom-interaction-restaurant.zh.mp4></video></figure><h2 id=Tj5lP>完整性能结果<a hidden class=anchor aria-hidden=true href=#Tj5lP>#</a></h2><h3 id=omni>Omni<a hidden class=anchor aria-hidden=true href=#omni>#</a></h3><div class=\"source-table-scroll source-performance-scroll\" role=region tabindex=0><table class=\"source-performance-table source-omni-table\"><thead><tr><th scope=col style=text-align:left></th><th scope=col class=score-target style=text-align:center>Qwen3.8-Omni-Flash</th><th scope=col style=text-align:center>Qwen3.5-Omni-Plus</th><th scope=col style=text-align:center>Gemini 3.8<br>Flash</th><th scope=col style=text-align:center>Seed 2.0 Lite</th><th scope=col style=text-align:center>Muse Spark 1.2</th></tr></thead><tbody><tr class=score-group><td colspan=6 style=text-align:left>Agentic Omni Intelligence</td></tr><tr><td style=text-align:left><div class=score-benchmark>WildClawBench-MM</div><div class=score-capability>Multimodal tool use</div></td><td class=score-target style=text-align:center><strong>71.0</strong></td><td style=text-align:center>34.5</td><td style=text-align:center>58.9</td><td style=text-align:center>41.9</td><td style=text-align:center>--</td></tr><tr><td style=text-align:left><div class=score-benchmark>UniClawBench</div><div class=score-capability>Multimodal tool use</div></td><td class=score-target style=text-align:center><strong>69.6</strong></td><td style=text-align:center>67.1</td><td style=text-align:center>69.0</td><td style=text-align:center>61.2</td><td style=text-align:center>--</td></tr><tr><td style=text-align:left><div class=score-benchmark>AgenticVBench</div><div class=score-capability>Multimodal tool use</div></td><td class=score-target style=text-align:center>36.8</td><td style=text-align:center>14.5</td><td style=text-align:center><strong>45.0</strong></td><td style=text-align:center>10.0</td><td style=text-align:center>--</td></tr><tr><td style=text-align:left><div class=score-benchmark>OmniGAIA</div><div class=score-capability>Web Search</div></td><td class=score-target style=text-align:center>74.0</td><td style=text-align:center>57.2</td><td style=text-align:center><strong>78.6</strong></td><td style=text-align:center>64.4</td><td style=text-align:center>--</td></tr><tr class=score-group><td colspan=6 style=text-align:left>General Audio-Visual Capabilities</td></tr><tr><td style=text-align:left><div class=score-benchmark>DailyOmni</div><div class=score-capability>Audio-Visual Understanding</div></td><td class=score-target style=text-align:center><strong>85.1</strong></td><td style=text-align:center><strong>85.1</strong></td><td style=text-align:center>84.0</td><td style=text-align:center>81.4</td><td style=text-align:center>79.6</td></tr><tr><td style=text-align:left><div class=score-benchmark>WorldSense</div><div class=score-capability>Audio-Visual Understanding</div></td><td class=score-target style=text-align:center>68.5</td><td style=text-align:center>63.9</td><td style=text-align:center><strong>69.6</strong></td><td style=text-align:center>67.3</td><td style=text-align:center>65.0</td></tr><tr><td style=text-align:left><div class=score-benchmark>AVUT</div><div class=score-capability>Audio-Visual Understanding</div></td><td class=score-target style=text-align:center>86.6</td><td style=text-align:center>85.9</td><td style=text-align:center><strong>88.0</strong></td><td style=text-align:center>81.5</td><td style=text-align:center>82.4</td></tr><tr><td style=text-align:left><div class=score-benchmark>JoinAVBench</div><div class=score-capability>Audio-Visual Understanding</div></td><td class=score-target style=text-align:center><strong>75.9</strong></td><td style=text-align:center>74.1</td><td style=text-align:center>70.4</td><td style=text-align:center>70.6</td><td style=text-align:center>71.8</td></tr><tr><td style=text-align:left><div class=score-benchmark>OmniVideoBench</div><div class=score-capability>Audio-Visual Reasoning</div></td><td class=score-target style=text-align:center>63.4</td><td style=text-align:center>53.8</td><td style=text-align:center><strong>65.2</strong></td><td style=text-align:center>58.5</td><td style=text-align:center>62.2</td></tr><tr><td style=text-align:left><div class=score-benchmark>Video-MME-v2</div><div class=score-capability>Audio-Visual Reasoning</div></td><td class=score-target style=text-align:center>65.0</td><td style=text-align:center>47.9</td><td style=text-align:center><strong>71.0</strong></td><td style=text-align:center>64.9</td><td style=text-align:center>--</td></tr><tr><td style=text-align:left><div class=score-benchmark>LVOmniBench</div><div class=score-capability>Long Video Reasoning</div></td><td class=score-target style=text-align:center>63.3</td><td style=text-align:center>53.2</td><td style=text-align:center><strong>70.7</strong></td><td style=text-align:center>--</td><td style=text-align:center>--</td></tr><tr><td style=text-align:left><div class=score-benchmark>OmniCloze</div><div class=score-capability>Audio-Visual Caption</div></td><td class=score-target style=text-align:center>63.2</td><td style=text-align:center>64.2</td><td style=text-align:center>60.9</td><td style=text-align:center>56.3</td><td style=text-align:center><strong>65.3</strong></td></tr><tr><td style=text-align:left><div class=score-benchmark>OmniCap-IF</div><div class=score-capability>Audio-Visual Caption</div></td><td class=score-target style=text-align:center><div class=metric-stack><div><div class=metric-label>CSR</div><div class=metric-value>80.6</div></div><div><div class=metric-label>ISR</div><div class=metric-value>28.2</div></div></div></td><td style=text-align:center><div class=metric-stack><div><div class=metric-label>CSR</div><div class=metric-value>72.1</div></div><div><div class=metric-label>ISR</div><div class=metric-value>14.1</div></div></div></td><td style=text-align:center><div class=metric-stack><div><div class=metric-label>CSR</div><div class=metric-value><strong>81.9</strong></div></div><div><div class=metric-label>ISR</div><div class=metric-value><strong>28.3</strong></div></div></div></td><td style=text-align:center><div class=metric-stack><div><div class=metric-label>CSR</div><div class=metric-value>74.6</div></div><div><div class=metric-label>ISR</div><div class=metric-value>18.1</div></div></div></td><td style=text-align:center><div class=metric-stack><div><div class=metric-label>CSR</div><div class=metric-value>77.9</div></div><div><div class=metric-label>ISR</div><div class=metric-value>26.8</div></div></div></td></tr><tr><td style=