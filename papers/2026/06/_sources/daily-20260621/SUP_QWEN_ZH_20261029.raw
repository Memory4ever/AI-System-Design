n:center;border-bottom:1px solid rgba(128,128,128,.15);vertical-align:middle;font-size:15px;line-height:1.2\">92.95</td></tr><tr><td class=benchmark-cell style=\"padding:7px;padding-left:20px;border-bottom:1px solid rgba(128,128,128,.15)\"><div class=benchmark-capability style=font-size:15px;font-weight:600;line-height:1.22;color:#171717>MATH</div></td><td style=\"padding:7px;text-align:center;border-bottom:1px solid rgba(128,128,128,.15);background:rgba(10,46,254,8%);vertical-align:middle;font-size:15px;line-height:1.2\">72.78</td><td style=\"padding:7px;text-align:center;border-bottom:1px solid rgba(128,128,128,.15);vertical-align:middle;font-size:15px;line-height:1.2\">60.54</td><td style=\"padding:7px;text-align:center;border-bottom:1px solid rgba(128,128,128,.15);vertical-align:middle;font-size:15px;line-height:1.2\"><strong>74.38</strong></td></tr><tr><td colspan=4 style=\"padding:8px 12px;font-weight:600;color:#0a2efe;border-bottom:1px solid rgba(10,46,254,.2);background:#d6dafc\">Coding tasks</td></tr><tr><td class=benchmark-cell style=\"padding:7px;padding-left:20px;border-bottom:1px solid rgba(128,128,128,.15)\"><div class=benchmark-capability style=font-size:15px;font-weight:600;line-height:1.22;color:#171717>EvalPlus</div></td><td style=\"padding:7px;text-align:center;border-bottom:1px solid rgba(128,128,128,.15);background:rgba(10,46,254,8%);vertical-align:middle;font-size:15px;line-height:1.2\"><strong>78.76</strong></td><td style=\"padding:7px;text-align:center;border-bottom:1px solid rgba(128,128,128,.15);vertical-align:middle;font-size:15px;line-height:1.2\">76.05</td><td style=\"padding:7px;text-align:center;border-bottom:1px solid rgba(128,128,128,.15);vertical-align:middle;font-size:15px;line-height:1.2\">78.06</td></tr><tr><td class=benchmark-cell style=\"padding:7px;padding-left:20px;border-bottom:1px solid rgba(128,128,128,.15)\"><div class=benchmark-capability style=font-size:15px;font-weight:600;line-height:1.22;color:#171717>MultiPL-E</div></td><td style=\"padding:7px;text-align:center;border-bottom:1px solid rgba(128,128,128,.15);background:rgba(10,46,254,8%);vertical-align:middle;font-size:15px;line-height:1.2\">79.09</td><td style=\"padding:7px;text-align:center;border-bottom:1px solid rgba(128,128,128,.15);vertical-align:middle;font-size:15px;line-height:1.2\">74.50</td><td style=\"padding:7px;text-align:center;border-bottom:1px solid rgba(128,128,128,.15);vertical-align:middle;font-size:15px;line-height:1.2\"><strong>81.68</strong></td></tr><tr><td class=benchmark-cell style=\"padding:7px;padding-left:20px;border-bottom:1px solid rgba(128,128,128,.15)\"><div class=benchmark-capability style=font-size:15px;font-weight:600;line-height:1.22;color:#171717>SWEBench-Pretrain</div></td><td style=\"padding:7px;text-align:center;border-bottom:1px solid rgba(128,128,128,.15);background:rgba(10,46,254,8%);vertical-align:middle;font-size:15px;line-height:1.2\"><strong>50.99</strong></td><td style=\"padding:7px;text-align:center;border-bottom:1px solid rgba(128,128,128,.15);vertical-align:middle;font-size:15px;line-height:1.2\">41.66</td><td style=\"padding:7px;text-align:center;border-bottom:1px solid rgba(128,128,128,.15);vertical-align:middle;font-size:15px;line-height:1.2\">49.24</td></tr><tr><td colspan=4 style=\"padding:8px 12px;font-weight:600;color:#0a2efe;border-bottom:1px solid rgba(10,46,254,.2);background:#d6dafc\">Multilingual tasks</td></tr><tr><td class=benchmark-cell style=\"padding:7px;padding-left:20px;border-bottom:1px solid rgba(128,128,128,.15)\"><div class=benchmark-capability style=font-size:15px;font-weight:600;line-height:1.22;color:#171717>MGSM</div></td><td style=\"padding:7px;text-align:center;border-bottom:1px solid rgba(128,128,128,.15);background:rgba(10,46,254,8%);vertical-align:middle;font-size:15px;line-height:1.2\"><strong>89.33</strong></td><td style=\"padding:7px;text-align:center;border-bottom:1px solid rgba(128,128,128,.15);vertical-align:middle;font-size:15px;line-height:1.2\">86.37</td><td style=\"padding:7px;text-align:center;border-bottom:1px solid rgba(128,128,128,.15);vertical-align:middle;font-size:15px;line-height:1.2\">85.42</td></tr><tr><td class=benchmark-cell style=\"padding:7px;padding-left:20px;border-bottom:1px solid rgba(128,128,128,.15)\"><div class=benchmark-capability style=font-size:15px;font-weight:600;line-height:1.22;color:#171717>MMMLU</div></td><td style=\"padding:7px;text-align:center;border-bottom:1px solid rgba(128,128,128,.15);background:rgba(10,46,254,8%);vertical-align:middle;font-size:15px;line-height:1.2\"><strong>84.86</strong></td><td style=\"padding:7px;text-align:center;border-bottom:1px solid rgba(128,128,128,.15);vertical-align:middle;font-size:15px;line-height:1.2\">79.74</td><td style=\"padding:7px;text-align:center;border-bottom:1px solid rgba(128,128,128,.15);vertical-align:middle;font-size:15px;line-height:1.2\">84.53</td></tr><tr><td class=benchmark-cell style=\"padding:7px;padding-left:20px;border-bottom:1px solid rgba(128,128,128,.15)\"><div class=benchmark-capability style=font-size:15px;font-weight:600;line-height:1.22;color:#171717>INCLUDE</div></td><td style=\"padding:7px;text-align:center;border-bottom:1px solid rgba(128,128,128,.15);background:rgba(10,46,254,8%);vertical-align:middle;font-size:15px;line-height:1.2\">78.40</td><td style=\"padding:7px;text-align:center;border-bottom:1px solid rgba(128,128,128,.15);vertical-align:middle;font-size:15px;line-height:1.2\">74.37</td><td style=\"padding:7px;text-align:center;border-bottom:1px solid rgba(128,128,128,.15);vertical-align:middle;font-size:15px;line-height:1.2\"><strong>78.90</strong></td></tr></tbody></table><p style=margin-top:12px;font-size:10px;line-height:1.4;opacity:.7>1. 每行最优结果加粗。<br>2. 空白单元格（--）：分数尚不可用或不适用。</p></div><p>在 6B 激活参数下，Qwen3.8-Flash-Next-Base 在 14 个 benchmark 中的 8 个上取得最优结果，包括 MMLU-Pro、SuperGPQA、BBH、GSM8K、EvalPlus、SWEBench-Pretrain、MGSM 与 MMMLU；在 MMLU、MMLU-Redux、GPQA、MATH 与 MultiPL-E 上与 Qwen3.7-Plus-Base 接近。其中 51B 的 N-gram embedding 参数是确定性寻址的，不进入每 token 的矩阵乘预算。</p><h2 id=开始使用-qwen38-flash-next>开始使用 Qwen3.8-Flash-Next<a hidden class=anchor aria-hidden=true href=#开始使用-qwen38-flash-next>#</a></h2><p>Qwen3.8-Flash-Next 已作为开放模型在 <a href=https://huggingface.co/collections/Qwen/qwen38-flash-next>HuggingFace</a> 和 <a href=https://www.modelscope.cn/collections/Qwen/Qwen38-Flash-Next>ModelScope</a> 公开，并在 <a href=https://www.qianwenai.com/models/qwen3.8-flash>千问AI平台</a> 提供官方托管 API。\n该模型在能力、延迟和成本之间取得了出色的平衡，非常适用于高并发应用、工具驱动的工作流以及编程与协同办公助手。\n在下文中，您可以了解如何调用千问AI平台API，并将 Qwen3.8-Flash-Next 集成到智能体系统和编程助手中。</p><h3 id=api-使用>API 使用<a hidden class=anchor aria-hidden=true href=#api-使用>#</a></h3><p>Qwen3.8-Flash-Next 可通过 API 访问：</p><h4 id=千问ai平台>千问AI平台<a hidden class=anchor aria-hidden=true href=#千问ai平台>#</a></h4><p>在<a href=https://www.qianwenai.com>千问AI平台</a>上，该模型以 <a href=https://www.qianwenai.com/models/qwen3.8-flash><code>qwen3.8-flash</code></a> 的名称提供服务。\n千问AI平台支持行业标准协议，包括兼容 OpenAI 的 Chat Completions 和 Responses API，以及兼容 Anthropic 的接口。</p><div class=highlight><pre tabindex=0 class=chroma><code class=language-python data-lang=python><span class=line><span class=cl><span class=s2>&#34;&#34;&#34;\n</span></span></span><span class=line><span class=cl><span class=s2>Environment variables:\n</span></span></span><span class=line><span class=cl><span class=s2>  DASHSCOPE_API_KEY: Your API Key from https://platform.qianwenai.com/home\n</span></span></span><span class=line><span class=cl><span class=s2>  DASHSCOPE_BASE_URL: (optional) Base URL for compatible-mode API.\n</span></span></span><span class=line><span class=cl><span class=s2>    - Beijing: https://dashscope.aliyuncs.com/compatible-mode/v1\n</span></span></span><span class=line><span class=cl><span class=s2>    - Singapore: https://dashscope-intl.aliyuncs.com/compatible-mode/v1\n</span></span></span><span class=line><span class=cl><span class=s2>    - US (Virginia): https://dashscope-us.aliyuncs.com/compatible-mode/v1\n</span></span></span><span class=line><span class=cl><span class=s2>&#34;&#34;&#34;</span>\n</span></span><span class=line><span class=cl><span class=kn>from</span> <span class=nn>openai</span> <span class=kn>import</span> <span class=n>OpenAI</span>\n</span></span><span class=line><span class=cl><span class=kn>import</span> <span class=nn>os</span>\n</span></span><span class=line><span class=cl>\n</span></span><span class=line><span class=cl><span class=n>api_key</span> <span class=o>=</span> <span class=n>os</span><span class=o>.</span><span class=n>environ</span><span class=o>.</span><span class=n>get</span><span class=p>(</span><span class=s2>&#34;DASHSCOPE_API_KEY&#34;</span><span class=p>)</span>\n</span></span><span class=line><span class=cl><span class=k>if</span> <span class=ow>not</span> <span class=n>api_key</span><span class=p>:</span>\n</span></span><span class=line><span class=cl>    <span class=k>raise</span> <span class=ne>ValueError</span><span class=p>(</span>\n</span></span><span class=line><span class=cl>        <span class=s2>&#34;DASHSCOPE_API_KEY is required. &#34;</span>\n</span></span><span class=line><span class=cl>        <span class=s2>&#34;Set it via: export DASHSCOPE_API_KEY=&#39;your-api-key&#39;&#34;</span>\n</span></span><span class=line><span class=cl>    <span class=p>)</span>\n</span></span><span class=line><span class=cl>\n</span></span><span class=line><span class=cl><span class=n>client</span> <span class=o>=</span> <span class=n>OpenAI</span><span class=p>(</span>\n</span></span><span class=line><span class=cl>    <span class=n>api_key</span><span class=o>=</span><span class=n>api_key</span><span class=p>,</span>\n</span></span><span class=line><span class=cl>    <span class=n>base_url</span><span class=o>=</span><span class=n>os</span><span class=o>.</span><span class=n>environ</span><span class=o>.</span><span class=n>get</span><span class=p>(</span>\n</span></span><span class=line><span class=cl>        <span class=s2>&#34;DASHSCOPE_BASE_URL&#34;</span><span class=p>,</span>\n</span></span><span class=line><span class=cl>        <span class=s2>&#34;https://dashscope.aliyuncs.com/compatible-mode/v1&#34;</span><span class=p>,</span>\n</span></span><span class=line><span class=cl>    <span class=p>),</span>\n</span></span><span class=line><span class=cl><span class=p>)</span>\n</span></span><span class=line><span class=cl>\n</span></span><span class=line><span class=cl><span class=n>messages</span> <span class=o>=</span> <span class=p>[{</span><span class=s2>&#34;role&#34;</span><span class=p>:</span> <span class=s2>&#34;user&#34;</span><span class=p>,</span> <span class=s2>&#34;content&#34;</span><span class=p>:</span> <span class=s2>&#34;Write a Python function to merge two sorted linked lists.&#34;</span><span class=p>}]</span>\n</span></span><span class=line><span class=cl>\n</span></span><span class=line><span class=cl><span class=n>completion</span> <span class=o>=</span> <span class=n>client</span><span class=o>.</span><span class=n>chat</span><span class=o>.</span><span class=n>completions</span><span class=o>.</span><span class=n>create</span><span class=p>(</span>\n</span></span><span class=line><span class=cl>    <span class=n>model</span><span class=o>=</span><span class=s2>&#34;qwen3.8-flash&#34;</span><span class=p>,</span>\n</span></span><span class=line><span class=cl>    <span class=n>messages</span><span class=o>=</span><span class=n>messages</span><span class=p>,</span>\n</span></span><span class=line><span class=cl>    <span class=n>extra_body</span><span class=o>=</span><span class=p>{</span>\n</span></span><span class=line><span class=cl>        <span class=s2>&#34;enable_thinking&#34;</span><span class=p>:</span> <span class=kc>True</span><span class=p>,</span>\n</span></span><span class=line><span class=cl>        <span class=c1># &#34;preserve_thinking&#34;: True,</span>\n</span></span><span class=line><span class=cl>    <span class=p>},</span>\n</span></span><span class=line><span class=cl>    <span class=n>reasoning_effort</span><span class=o>=</span><span class=s2>&#34;xhigh&#34;</span><span class=p>,</span>  <span class=c1># supported levels are xhigh, medium, and low</span>\n</span></span><span class=line><span class=cl>    <span class=n>stream</span><span class=o>=</span><span class=kc>True</span><span class=p>,</span>\n</span></span><span class=line><span class=cl><span class=p>)</span>\n</span></span><span class=line><span class=cl>\n</span></span><span class=line><span class=cl><span class=n>reasoning_content</span> <span class=o>=</span> <span class=s2>&#34;&#34;</span>\n</span></span><span class=line><span class=cl><span class=n>answer_content</span> <span class=o>=</span> <span class=s2>&#34;&#34;</span>\n</span></span><span class=line><span class=cl><span class=n>is_answering</span> <span class=o>=</span> <span class=kc>False</span>\n</span></span><span class=line><span class=cl><span class=nb>print</span><span class=p>(</span><span class=s2>&#34;</span><span class=se>\\n</span><span class=s2>&#34;</span> <span class=o>+</span> <span class=s2>&#34;=&#34;</span> <span class=o>*</span> <span class=mi>20</span> <span class=o>+</span> <span class=s2>&#34;Reasoning&#34;</span> <span class=o>+</span> <span class=s2>&#34;=&#34;</span> <span class=o>*</span> <span class=mi>20</span> <span class=o>+</span> <span class=s2>&#34;</span><span class=se>\\n</span><span class=s2>&#34;</span><span class=p>)</span>\n</span></span><span class=line><span class=cl>\n</span></span><span class=line><span class=cl><span class=k>for</span> <span class=n>chunk</span> <span class=ow>in</span> <span class=n>completion</span><span class=p>:</span>\n</span></span><span class=line><span class=cl>    <span class=k>if</span> <span class=ow>not</span> <span class=n>chunk</span><span class=o>.</span><span class=n>choices</span><span class=p>:</span>\n</span></span><span class=line><span class=cl>        <span class=nb>print</span><span class=p>(</span><span class=s2>&#34;</span><span class=se>\\n</span><span class=s2>Usage:&#34;</span><span class=p>)</span>\n</span></span><span class=line><span class=cl>        <span class=nb>print</span><span class=p>(</span><span class=n>chunk</span><span class=o>.</span><span class=n>usage</span><span class=p>)</span>\n</span></span><span class=line><span class=cl>        <span class=k>continue</span>\n</span></span><span class=line><span class=cl>\n</span></span><span class=line><span class=cl>    <span class=n>delta</span> <span class=o>=</span> <span class=n>chunk</span><span class=o>.</span><span class=n>choices</span><span class=p>[</span><span class=mi>0</span><span class=p>]</span><span class=o>.</span><span class=n>delta</span>\n</span></span><span class=line><span class=cl>\n</span></span><span class=line><span class=cl>    <span class=k>if</span> <span class=nb>hasattr</span><span class=p>(</span><span class=n>delta</span><span class=p>,</span> <span class=s2>&#34;reasoning_content&#34;</span><span class=p>)</span> <span class=ow>and</span> <span class=n>delta</span><span class=o>.</span><span class=n>reasoning_content</span> <span class=ow>is</span> <span class=ow>not</span> <span class=kc>None</span><span class=p>:</span>\n</span></span><span class=line><span class=cl>        <span class=k>if</span> <span class=ow>not</span> <span class=n>is_answering</span><span class=p>:</span>\n</span></span><span class=line><span class=cl>            <span class=nb>print</span><span class=p>(</span><span class=n>delta</span><span class=o>.</span><span class=n>reasoning_content</span><span class=p>,</span> <span class=n>end</span><span class=o>=</span><span class=s2>&#34;&#34;</span><span class=p>,</span> <span class=n>flush</span><span class=o>=</span><span class=kc>True</span><span class=p>)</span>\n</span></span><span class=line><span class=cl>        <span class=n>reasoning_content</span> <span class=o>+=</span> <span class=n>delta</span><span class=o>.</span><span class=n>reasoning_content</span>\n</span></span><span class=line><span class=cl>\n</span></span><span class=line><span class=cl>    <span class=k>if</span> <span class=nb>hasattr</span><span class=p>(</span><span class=n>delta</span><span class=p>,</span> <span class=s2>&#34;content&#34;</span><span class=p>)</span> <span class=ow>and</span> <span class=n>delta</span><span class=o>.</span><span class=n>content</span><span class=p>:</span>\n</span></span><span class=line><span class=cl>        <span class=k>if</span> <span class=ow>not</span> <span class=n>is_answering</span><span class=p>:</span>\n</span></span><span class=line><span class=cl>            <span class=nb>print</span><span class=p>(</span><span class=s2>&#34;</span><span class=se>\\n</span><span class=s2>&#34;</span> <span class=o>+</span> <span class=s2>&#34;=&#34;</span> <span class=o>*</span> <span class=mi>20</span> <span class=o>+</span> <span class=s2>&#34;Answer&#34;</span> <span class=o>+</span> <span class=s2>&#34;=&#34;</span> <span class=o>*</span> <span class=mi>20</span> <span class=o>+</span> <span class=s2>&#34;</span><span class=se>\\n</span><span class=s2>&#34;</span><span class=p>)</span>\n</span></span><span class=line><span class=cl>            <span class=n>is_answering</span> <span class=o>=</span> <span class=kc>True</span>\n</span></span><span class=line><span class=cl>        <span class=nb>print</span><span class=p>(</span><span class=n>delta</span><span class=o>.</span><span class=n>content</span><span class=p>,</span> <span class=n>end</span><span class=o>=</span><span class=s2>&#34;&#34;</span><span class=p>,</span> <span class=n>flush</span><span class=o>=</span><span class=kc>True</span><span class=p>)</span>\n</span></span><span class=line><span class=cl>        <span class=n>answer_content</span> <span class=o>+=</span> <span class=n>delta</span><span class=o>.</span><span class=n>content</span>\n</span></span></code></pre></div><h3 id=智能体框架与编程助手>智能体框架与编程助手<a hidden class=anchor aria-hidden=true href=#智能体框架与编程助手>#</a></h3><p>Qwen3.8-Flash-Next 可无缝集成主流的智能体框架与编程助手：</p><h4 id=千问办公>千问办公<a hidden class=anchor aria-hidden=true href=#千问办公>#</a></h4><p><a href=https://qwenwork.cn/>千问办公</a> 是阿里巴巴旗下的旗舰级 AI 生产力平台，旨在帮助个人与企业实现日常任务的自动化与业务运转效率的加速。</p><p>千问办公现已接入 <strong>Qwen3.8-Flash-Next</strong>，驱动其全新推出的“标准”模式。依托模型的前沿能力，这一模式将为用户带来 Agent 智能水平、推理效率、成本控制三位一体的极致体验，重新定义 AI 办公场景新“标准”。</p><figure><img src=https://qianwen-res.oss-accelerate.aliyuncs.com/Qwen3.8-Flash-Next/qwen-work-cn.png#center alt=\"Qwen3.8-Flash on QwenWork\" width=80%></figure><p>了解更多详情请参阅<a href=https://qwenwork.cn/docs/product-introduction>官方文档</a>！</p><h4 id=claude-code>Claude Code<a hidden class=anchor aria-hidden=true href=#claude-code>#</a></h4><p>Qwen API 支持 Anthropic API 协议，可直接配合 <strong>Claude Code</strong> 使用：</p><div class=highlight><pre tabindex=0 class=chroma><code class=language-bash data-lang=bash><span class=line><span class=cl>npm install -g @anthropic-ai/claude-code\n</span></span><span class=line><span class=cl>\n</span></span><span class=line><span class=cl><span class=nb>export</span> <span class=nv>ANTHROPIC_MODEL</span><span class=o>=</span><span class=s2>&#34;qwen3.8-flash&#34;</span>\n</span></span><span class=line><span class=cl><span class=nb>export</span> <span class=nv>ANTHROPIC_SMALL_FAST_MODEL</span><span class=o>=</span><span class=s2>&#34;qwen3.8-flash&#34;</span>\n</span></span><span class=line><span class=cl><span class=nb>export</span> <span class=nv>ANTHROPIC_BASE_URL</span><span class=o>=</span>https://dashscope.aliyuncs.com/apps/anthropic\n</span></span><span class=line><span class=cl><span class=nb>export</span> <span class=nv>ANTHROPIC_AUTH_TOKEN</span><span class=o>=</span>&lt;your_api_key&gt;\n</span></span><span class=line><span class=cl>\n</span></span><span class=line><span class=cl>claude\n</span></span></code></pre></div><h4 id=codex>Codex<a hidden class=anchor aria-hidden=true href=#codex>#</a></h4><p>Qwen API 支持 OpenAI Responses 协议，可配合 <strong>Codex</strong> 使用：</p><p>在 <code>~/.codex/model-catalog.local.json</code> 中配置：</p><div class=highlight><pre tabindex=0 class=chroma><code class=language-json data-lang=json><span class=line><span class=cl><span class=p>{</span>\n</span></span><span class=line><span class=cl>  <span class=nt>&#34;models&#34;</span><span class=p>:</span> <span class=p>[</span>\n</span></span><span class=line><span class=cl>    <span class=p>{</span>\n</span></span><span class=line><span class=cl>      <span class=nt>&#34;slug&#34;</span><span class=p>:</span> <span class=s2>&#34;qwen3.8-flash&#34;</span><span class=p>,</span>\n</span></span><span class=line><span class=cl>      <span class=nt>&#34;display_name&#34;</span><span class=p>:</span> <span class=s2>&#34;qwen3.8-flash&#34;</span><span class=p>,</span>\n</span></span><span class=line><span class=cl>      <span class=nt>&#34;description&#34;</span><span class=p>:</span> <span class=s2>&#34;千问AI平台: Qwen3.8-Flash&#34;</span><span class=p>,</span>\n</span></span><span class=line><span class=cl>      <span class=nt>&#34;default_reasoning_level&#34;</span><span class=p>:</span> <span class=s2>&#34;xhigh&#34;</span><span class=p>,</span>\n</span></span><span class=line><span class=cl>      <span class=nt>&#34;supported_reasoning_levels&#34;</span><span class=p>:</span> <span class=p>[</span>\n</span></span><span class=line><span class=cl>        <span class=p>{</span>\n</span></span><span class=line><span class=cl>          <span class=nt>&#34;effort&#34;</span><span class=p>:</span> <span class=s2>&#34;low&#34;</span><span class=p>,</span>\n</span></span><span class=line><span class=cl>          <span class=nt>&#34;description&#34;</span><span class=p>:</span> <span class=s2>&#34;Fast responses with lighter reasoning&#34;</span>\n</span></span><span class=line><span class=cl>        <span class=p>},</span>\n</span></span><span class=line><span class=cl>        <span class=p>{</span>\n</span></span><span class=line><span class=cl>          <span class=nt>&#34;effort&#34;</span><span class=p>:</span> <span class=s2>&#34;medium&#34;</span><span class=p>,</span>\n</span></span><span class=line><span class=cl>          <span class=nt>&#34;description&#34;</span><span class=p>:</span> <span class=s2>&#34;Greater reasoning depth for complex problems&#34;</span>\n</span></span><span class=line><span class=cl>        <span class=p>},</span>\n</span></span><span class=line><span class=cl>        <span class=p>{</span>\n</span></span><span class=line><span class=cl>          <span class=nt>&#34;effort&#34;</span><span class=p>:</span> <span class=s2>&#34;xhigh&#34;</span><span class=p>,</span>\n</span></span><span class=line><span class=cl>          <span class=nt>&#34;description&#34;</span><span class=p>:</span> <span class=s2>&#34;Extra high reasoning depth for complex problems&#34;</span>\n</span></span><span class=line><span class=cl>        <span class=p>}</span>\n</span></span><span class=line><span class=cl>      <span class=p>],</span>\n</span></span><span class=line><span class=cl>      <span class=nt>&#34;context_window&#34;</span><span class=p>:</span> <span class=mi>1000000</span><span class=p>,</span>\n</span></span><span class=line><span class=cl>      <span class=nt>&#34;effective_context_window_percent&#34;</span><span class=p>:</span> <span class=mi>95</span><span class=p>,</span>\n</span></span><span class=line><span class=cl>      <span class=nt>&#34;supports_parallel_tool_calls&#34;</span><span class=p>:</span> <span class=kc>true</span><span class=p>,</span>\n</span></span><span class=line><span class=cl>      <span class=nt>&#34;supports_image_detail_original&#34;</span><span class=p>:</span> <span class=kc>true</span><span class=p>,</span>\n</span></span><span class=line><span class=cl>      <span class=nt>&#34;input_modalities&#34;</span><span class=p>:</span> <span class=p>[</span><span class=s2>&#34;text&#34;</span><span class=p>,</span> <span class=s2>&#34;image&#34;</span><span class=p>],</span>\n</span></span><span class=line><span class=cl>      <span class=nt>&#34;shell_type&#34;</span><span class=p>:</span> <span class=s2>&#34;default&#34;</span><span class=p>,</span>\n</span></span><span class=line><span class=cl>      <span class=nt>&#34;visibility&#34;</span><span class=p>:</span> <span class=s2>&#34;list&#34;</span><span class=p>,</span>\n</span></span><span class=line><span class=cl>      <span class=nt>&#34;supported_in_api&#34;</span><span class=p>:</span> <span class=kc>true</span><span class=p>,</span>\n</span></span><span class=line><span class=cl>      <span class=nt>&#34;priority&#34;</span><span class=p>:</span> <span class=mi>1</span><span class=p>,</span>\n</span></span><span class=line><span class=cl>      <span class=nt>&#34;base_instructions&#34;</span><span class=p>:</span> <span class=s2>&#34;&#34;</span><span class=p>,</span>\n</span></span><span class=line><span class=cl>      <span class=nt>&#34;support_verbosity&#34;</span><span class=p>:</span> <span class=kc>false</span><span class=p>,</span>\n</span></span><span class=line><span class=cl>      <span class=nt>&#34;supports_reasoning_summaries&#34;</span><span class=p>:</span> <span class=kc>false</span><span class=p>,</span>\n</span></span><span class=line><span class=cl>      <span class=nt>&#34;experimental_supported_tools&#34;</span><span class=p>:</span> <span class=p>[],</span>\n</span></span><span class=line><span class=cl>      <span class=nt>&#34;truncation_policy&#34;</span><span class=p>:</span> <span class=p>{</span>\n</span></span><span class=line><span class=cl>        <span class=nt>&#34;mode&#34;</span><span class=p>:</span> <span class=s2>&#34;bytes&#34;</span><span class=p>,</span>\n</span></span><span class=line><span class=cl>        <span class=nt>&#34;limit&#34;</span><span class=p>:</span> <span class=mi>10000</span>\n</span></span><span class=line><span class=cl>      <span class=p>}</span>\n</span></span><span class=line><span class=cl>    <span class=p>}</span>\n</span></span><span class=line><span class=cl>  <span class=p>]</span>\n</span></span><span class=line><span class=cl><span class=p>}</span>\n</span></span></code></pre></div><p>在 <code>~/.codex/config.toml</code> 中配置：</p><div class=highlight><pre tabindex=0 class=chroma><code class=language-toml data-lang=toml><span class=line><span class=cl><span class=nx>model_catalog_json</span> <span class=p>=</span> <span class=s2>&#34;~/.codex/model-catalog.local.json&#34;</span>\n</span></span><span class=line><span class=cl>\n</span></span><span class=line><span class=cl><span class=nx>model_provider</span> <span class=p>=</span> <span class=s2>&#34;QwenCloud&#34;</span>\n</span></span><span class=line><span class=cl><span class=nx>model</span> <span class=p>=</span> <span class=s2>&#34;qwen3.8-flash&#34;</span>\n</span></span><span class=line><span class=cl>\n</span></span><span class=line><span class=cl><span class=p>[</span><span class=nx>model_providers</span><span class=p>.</span><span class=nx>QwenCloud</span><span class=p>]</span>\n</span></span><span class=line><span class=cl><span class=nx>name</span> <span class=p>=</span> <span class=s2>&#34;千问AI平台&#34;</span>\n</span></span><span class=line><span class=cl><span class=nx>base_url</span> <span class=p>=</span> <span class=s2>&#34;https://dashscope.aliyuncs.com/compatible-mode/v1&#34;</span>\n</span></span><span class=line><span class=cl><span class=nx>env_key</span> <span class=p>=</span> <span class=s2>&#34;OPENAI_API_KEY&#34;</span>\n</span></span><span class=line><span class=cl><span class=nx>wire_api</span> <span class=p>=</span> <span class=s2>&#34;responses&#34;</span>\n</span></span></code></pre></div><div class=highlight><pre tabindex=0 class=chroma><code class=language-bash data-lang=bash><span class=line><span class=cl>npm install -g @openai/codex\n</span></span><span class=line><span class=cl>\n</span></span><span class=line><span class=cl><span class=nb>export</span> <span class=nv>OPENAI_API_KEY</span><span class=o>=</span>&lt;your_api_key&gt;\n</span></span><span class=line><span class=cl>\n</span></span><span class=line><span class=cl>codex\n</span></span></code></pre></div><h4 id=qoder-cli>Qoder CLI<a hidden class=anchor aria-hidden=true href=#qoder-cli>#</a></h4><p><a href=https://qoder.com/>Qoder</a> 与 Qwen 协同演进，专为智能体编程（Agentic Coding）打造：</p><div class=highlight><pre tabindex=0 class=chroma><code class=language-bash data-lang=bash><span class=line><span class=cl>curl -fsSL https://qoder.com/install <span class=p>|</span> bash\n</span></span><span class=line><span class=cl>\n</span></span><span class=line><span class=cl>qoder\n</span></span></code></pre></div><h4 id=qwen-code>Qwen Code<a hidden class=anchor aria-hidden=true href=#qwen-code>#</a></h4><p><a href=https://qwen.ai/qwencode>Qwen Code</a> 针对 Qwen 系列模型进行了深度优化：</p><div class=highlight><pre tabindex=0 class=chroma><code class=language-bash data-lang=bash><span class=line><span class=cl>npm install -g @qwen-code/qwen-code@latest\n</span></span><span class=line><span class=cl>\n</span></span><span class=line><span class=cl>qwen\n</span></span></code></pre></div><h4 id=openclaw>OpenClaw<a hidden class=anchor aria-hidden=true href=#openclaw>#</a></h4><p>通过 <a href=https://platform.qianwenai.com/docs/developer-guides/clients-and-developer-tools/openclaw>千问AI平台</a> 连接 <a href=https://openclaw.ai>OpenClaw</a>：</p><div class=highlight><pre tabindex=0 class=chroma><code class=language-bash data-lang=bash><span class=line><span class=cl>curl -fsSL https://openclaw.ai/install.sh <span class=p>|</span> bash\n</span></span><span class=line><span class=cl>\n</span></span><span class=line><span class=cl><span class=nb>export</span> <span class=nv>DASHSCOPE_API_KEY</span><span class=o>=</span>&lt;your_api_key&gt;\n</span></span><span class=line><span class=cl>\n</span></span><span class=line><span class=cl>openclaw dashboard\n</span></span></code></pre></div><p>配置 <code>~/.openclaw/openclaw.json</code>：</p><div class=highlight><pre tabindex=0 class=chroma><code class=language-json data-lang=json><span class=line><span class=cl><span class=p>{</span>\n</span></span><span class=line><span class=cl>  <span class=nt>&#34;models&#34;</span><span class=p>:</span> <span class=p>{</span>\n</span></span><span class=line><span class=cl>    <span class=nt>&#34;mode&#34;</span><span class=p>:</span> <span class=s2>&#34;merge&#34;</span><span class=p>,</span>\n</span></span><span class=line><span class=cl>    <span class=nt>&#34;providers&#34;</span><span class=p>:</span> <span class=p>{</span>\n</span></span><span class=line><span class=cl>      <span class=nt>&#34;qwencloud&#34;</span><span class=p>:</span> <span class=p>{</span>\n</span></span><span class=line><span class=cl>        <span class=nt>&#34;baseUrl&#34;</span><span class=p>:</span> <span class=s2>&#34;https://dashscope.aliyuncs.com/compatible-mode/v1&#34;</span><span class=p>,</span>\n</span></span><span class=line><span class=cl>        <span class=nt>&#34;apiKey&#34;</span><span class=p>:</span> <span class=s2>&#34;DASHSCOPE_API_KEY&#34;</span><span class=p>,</span>\n</span></span><span class=line><span class=cl>        <span class=nt>&#34;api&#34;</span><span class=p>:</span> <span class=s2>&#34;openai-completions&#34;</span><span class=p>,</span>\n</span></span><span class=line><span class=cl>        <span class=nt>&#34;models&#34;</span><span class=p>:</span> <span class=p>[</span>\n</span></span><span class=line><span class=cl>          <span class=p>{</span>\n</span></span><span class=line><span class=cl>            <span class=nt>&#34;id&#34;</span><span class=p>:</span> <span class=s2>&#34;qwen3.8-flash&#34;</span><span class=p>,</span>\n</span></span><span class=line><span class=cl>            <span class=nt>&#34;name&#34;</span><span class=p>:</span> <span class=s2>&#34;qwen3.8-flash&#34;</span><span class=p>,</span>\n</span></span><span class=line><span class=cl>            <span class=nt>&#34;reasoning&#34;</span><span class=p>:</span> <span class=kc>true</span><span class=p>,</span>\n</span></span><span class=line><span class=cl>            <span class=nt>&#34;input&#34;</span><span class=p>:</span> <span class=p>[</span><span class=s2>&#34;text&#34;</span><span class=p>,</span> <span class=s2>&#34;image&#34;</span><span class=p>],</span>\n</span></span><span class=line><span class=cl>            <span class=nt>&#34;contextWindow&#34;</span><span class=p>:</span> <span class=mi>1000000</span><span class=p>,</span>\n</span></span><span class=line><span class=cl>            <span class=nt>&#34;maxTokens&#34;</span><span class=p>:</span> <span class=mi>65536</span>\n</span></span><span class=line><span class=cl>          <span class=p>}</span>\n</span></span><span class=line><span class=cl>        <span class=p>]</span>\n</span></span><span class=line><span class=cl>      <span class=p>}</span>\n</span></span><span class=line><span class=cl>    <span class=p>}</span>\n</span></span><span class=line><span class=cl>  <span class=p>},</span>\n</span></span><span class=line><span class=cl>  <span class=nt>&#34;agents&#34;</span><span class=p>:</span> <span class=p>{</span>\n</span></span><span class=line><span class=cl>    <span class=nt>&#34;defaults&#34;</span><span class=p>:</span> <span class=p>{</span>\n</span></span><span class=line><span class=cl>      <span class=nt>&#34;model&#34;</span><span class=p>:</span> <span class=p>{</span>\n</span></span><span class=line><span class=cl>        <span class=nt>&#34;primary&#34;</span><span class=p>:</span> <span class=s2>&#34;qwencloud/qwen3.8-flash&#34;</span>\n</span></span><span class=line><span class=cl>      <span class=p>}</span>\n</span></span><span class=line><span class=cl>    <span class=p>}</span>\n</span></span><span class=line><span class=cl>  <span class=p>}</span>\n</span></span><span class=line><span class=cl><span class=p>}</span>\n</span></span></code></pre></div><h2 id=总结>总结<a hidden class=anchor aria-hidden=true href=#总结>#</a></h2><p>Qwen3.8-Flash-Next 在 Qwen3-Next 所引入的混合架构之上，沿 Attention、Residual、Embedding 与 Optimization 四个方向作了扩展。QSA 在每一层内部将序列压缩为 micro-block，在保持精确检索能力的同时，降低了长上下文下的注意力开销与 indexing 开销。Gated Residual 将残差流扩展为多条并行分支，并以逐元素的动态门控控制读写，在算术开销可忽略的前提下改善跨层信息传递与训练稳定性；残差状态还可以保存为 FP8，进一步降低访存量。N-gram Embedding 以确定性寻址的查表记忆扩展容量，可以在几乎不增加每 token 计算的前提下扩展，并卸载到 host memory。优化方面，Muon 作为主优化器使用，其中正交化精度、参数分工与融合矩阵拆分是决定性的实现选择，我们也针对新架构重新拟合了 Scaling Law。</p><p>我们像发布 Qwen3-Next 时一样提前释出这批权重，以便该结构能够被社区独立评测；我们也将继续朝 Qwen4 的方向对其进行完善。</p><h2 id=引用>引用<a hidden class=anchor aria-hidden=true href=#引用>#</a></h2><div class=highlight><pre tabindex=0 class=chroma><code class=language-bibtex data-lang=bibtex><span class=line><span class=cl><span class=nc>@techreport</span><span class=p>{</span><span class=nl>qwen2026design</span><span class=p>,</span>\n</span></span><span class=line><span class=cl>    <span class=na>title</span>       <span class=p>=</span> <span class=s>{On the Design of {Qwen3.8-Next} Architecture: Evaluation, Efficiency, and Training Stability}</span><span class=p>,</span>\n</span></span><span class=line><span class=cl>    <span class=na>author</span>      <span class=p>=</span> <span class=s>{{Qwen Team}}</span><span class=p>,</span>\n</span></span><span class=line><span class=cl>    <span class=na>institution</span> <span class=p>=</span> <span class=s>{Alibaba Group}</span><span class=p>,</span>\n</span></span><span class=line><span class=cl>    <span class=na>month</span>       <span class=p>=</span> <span class=s>{August}</span><span class=p>,</span>\n</span></span><span class=line><span class=cl>    <span class=na>year</span>        <span class=p>=</span> <span class=s>{2026}</span>\n</span></span><span class=line><span class=cl><span class=p>}</span>\n</span></span><span class=line><span class=cl>\n</span></span><span class=line><span class=cl><span class=nc>@misc</span><span class=p>{</span><span class=nl>qwen3.8flashnext</span><span class=p>,</span>\n</span></span><span class=line><span class=cl>    <span class=na>title</span>  <span class=p>=</span> <span class=s>{{Qwen3.8-Flash-Next}: A New Architecture, Towards Ultimate Cost-Efficiency}</span><span class=p>,</span>\n</span></span><span class=line><span class=cl>    <span class=na>author</span> <span class=p>=</span> <span class=s>{{Qwen Team}}</span><span class=p>,</span>\n</span></span><span class=line><span class=cl>    <span class=na>month</span>  <span class=p>=</span> <span class=s>{August}</span><span class=p>,</span>\n</span></span><span class=line><span class=cl>    <span class=na>year</span>   <span class=p>=</span> <span class=s>{2026}</span><span class=p>,</span>\n</span></span><span class=line><span class=cl>    <span class=na>url</span>    <span class=p>=</span> <span class=s>{https://qwen.ai/blog?id=qwen3.8-flash-next}</span>\n</span></span><span class=line><span class=cl><span class=p>}</span>\n</span></span></code></pre></div><h1 id=参考文献>参考文献<a hidden class=anchor aria-hidden=true href=#参考文献>#</a></h1><p><a id=ref1>[1]</a> Gated Delta Networks: Improving Mamba2 with Delta Rule</p><p><a id=ref2>[2]</a> DeepSeek-V3.2: Pushing the Frontier of Open Large Language Models</p><p><a id=ref3>[3]</a> IndexCache: Accelerating Sparse Attention via Cross-Layer Index Reuse</p><p><a id=ref4>[4]</a> Hyper-Connections</p><p><a id=ref5>[5]</a> A Unified View of Attention and Residual Sinks: Outlier-Driven Rescaling is Essential for Transformer Training</p><p><a id=ref6>[6]</a> Conditional Memory via Scalable Lookup: A New Axis of Sparsity for Large Language Models</p><p><a id=ref7>[7]</a> Muon: An Optimizer for Hidden Layers in Neural Networks</p><p><a id=ref8>[8]</a> Demons in the Detail: On Implementing Load Balancing Loss for Training Specialized Mixture-of-Expert Models</p><p><a id=ref9>[9]</a> Gated Attention for Large Language Models: Non-linearity, Sparsity, and Attention-Sink-Free</p></div></article></main><footer class=footer><span>&copy; 2026 <a href=https://qwenlm.github.io/zh/>Qwen</a></span>\n<span>Powered by\n<a href=https://gohugo.io/ rel=\"noopener noreferrer\" target=_blank>Hugo</a></span></footer><a href=#top aria-label=\"go to top\" title=\"Go to Top (Alt + G)\" class=top-link id=top-link accesskey=g><svg xmlns=\"http://www.w3.org/2000/svg\" viewBox=\"0 0 12 8\" fill=\"currentcolor\"><path d=\"M12 8H0l6-8z\"/></svg>\n</a><script>let menu=document.getElementById(\"menu\");menu&&(menu.scrollLeft=localStorage.getItem(\"menu-scroll-position\"),menu.onscroll=function(){localStorage.setItem(\"menu-scroll-position\",menu.scrollLeft)}),document.querySelectorAll('a[href^=\"#\"]').forEach(e=>{e.addEventListener(\"click\",function(e){e.preventDefault();var t=this.getAttribute(\"href\").substr(1);window.matchMedia(\"(prefers-reduced-motion: reduce)\").matches?document.querySelector(`[id='${decodeURIComponent(t)}']`).scrollIntoView():document.querySelector(`[id='${decodeURIComponent(t)}']`).scrollIntoView({behavior:\"smooth\"}),t===\"top\"?history.replaceState(null,null,\" \"):history.pushState(null,null,`#${t}`)})})</script><script>var mybutton=document.getElementById(\"top-link\");window.onscroll=function(){document.body.scrollTop>800||document.documentElement.scrollTop>800?(mybutton.style.visibility=\"visible\",mybutton.style.opacity=\"1\"):(mybutton.style.visibility=\"hidden\",mybutton.style.opacity=\"0\")},mybutton.oncontextmenu=e=>{e.preventDefault(),document.querySelectorAll(\".example-container\").forEach(e=>{e.style.backgroundColor=\"unset\"}),document.querySelectorAll(\".example-content\").forEach(e=>{e.style.display=\"block\",e.style.backgroundColor=\"var(--code-bg)\",e.style.marginBottom=\"var(--modal-gap)\"}),document.querySelectorAll(\".next-button\").forEach(e=>{e.style.display=\"none\"})}</script><script>document.querySelectorAll(\"pre > code\").forEach(e=>{const n=e.parentNode.parentNode,t=document.createElement(\"button\");t.classList.add(\"copy-code\"),t.innerHTML=\"复制\";function s(){t.innerHTML=\"已复制！\",setTimeout(()=>{t.innerHTML=\"复制\"},2e3)}t.addEventListener(\"click\",t=>{if(\"clipboard\"in navigator){navigator.clipboard.writeText(e.textContent),s();return}const n=document.createRange();n.selectNodeContents(e);const o=window.getSelection();o.removeAllRanges(),o.addRange(n);try{document.execCommand(\"copy\"),s()}catch{}o.removeRange(n)}),n.classList.contains(\"highlight\")?n.appendChild(t):n.parentNode.firstChild==n||(e.parentNode.parentNode.parentNode.parentNode.parentNode.nodeName==\"TABLE\"?e.parentNode.parentNode.parentNode.parentNode.parentNode.appendChild(t):e.parentNode.appendChild(t))})</script></body></html>","path":"qwen3.8-flash-next","language":"zh-CN","extra":{"git_url":"https://code.alibaba-inc.com/QwenBlog/qwen-blog/blob/qwen_ai/content/blog/qwen3.8-flash-next/index.md","description":"","introduction":"我们此次发布 Qwen3.8-Flash-Next 的开源权重，这是一个开源权重的多模态 MoE 模型，同时作为 Qwen4 所用模型结构的先导预览。它承担的角色与 Qwen3-Next 对 Qwen3.5 的角色一致：当时引入的 Gated DeltaNet + Gated Attention 混合结构，此后被用于 Qwen3.5、Qwen3.6、Qwen3.7 与 Qwen3.8 系列。我们这次提前释出结构上的改动，以便在其上构建 Qwen4 完整模型家族之前，先让社区对其进行检验。","tags":["Open-Source"],"cover_small":"https://img.alicdn.com/imgextra/i1/O1CN01ZxcR5nZsP9E3E9bs_!!6000000003536-2-tps-1590-954.png","date":"2026-08-26T20:30:00+08:00","author":"QwenTeam","readTime":18,"wordCount":3514}},{"id":"d85c0d9d-3d2b-4a8a-8c37-c6b54dd8ef3f","type":"qwen_ai","title":"Qwen3.5-Omni：新一代大规模原生全模态大模型","content":"<!doctype html><html lang=zh dir=auto><head><meta charset=utf-8><meta http-equiv=X-UA-Compatible content=\"IE=edge\"><meta name=viewport content=\"width=device-width,initial-scale=1,shrink-to-fit=no\"><meta name=robots content=\"index, follow\"><title>Qwen3.5-Omni：新一代大规模原生全模态大模型 | Qwen</title>\n<meta name=keywords content=\"Open-source\"><meta name=description content=\"QWEN CHAT Hugging Face Offline Demo Hugging Face Realtime Demo ModelScope Offline Demo ModelScope Realtime Demo\nQwen3.5-Omni 是 Qwen 最新一代全模态大模型，支持文本、图片、音频、音视频理解。结构上，Qwen3.5-Omni 的 Thinker 与 Talker 均采用 Hybrid-Attention MoE 架构。Qwen3.5-Omni 系列包含 Plus、Flash、Light 三种尺寸的 Instruct 版本，支持 256k 长上下文，模型支持超过 10 小时的音频输入及超过 400 秒的 720P（1 FPS）音视频输入。模型在海量文本、视觉以及超过 1 亿小时的音视频数据上进行原生多模态预训练，该模型展现出卓越的全模态感知与生成能力。相比 Qwen3-Omni，Qwen3.5-Omni 多语言能力大大增强，能够支持 113 种语种和方言的语音识别和 36 种语种和方言的语音生成。目前可通过 Offline API 和 Realtime API 进行体验。\n离线（Offline）\nQwen3.5-Omni-Plus 在音频/音视频的理解、推理和交互任务上共取得了 215 项子任务/Benchmark 的 SOTA 成绩，涵盖 3 个音视频 Benchmark、5 个音频 Benchmark、8 个 ASR Benchmark、156 个面向语种的 S2TT 任务和 43 个面向语种的 ASR 任务。其中，通用音频理解/推理/识别/翻译/对话全面超越 Gemini-3.\"><meta name=author content=\"Qwen Team\"><link rel=canonical href=https://qwenlm.github.io/zh/blog/qwen3.5-omni/><link crossorigin=anonymous href=/assets/css/stylesheet.25451dd4678157e0fb2e84a2fba5ad7861ab458e1168319a052575d04324b785.css integrity=\"sha256-JUUd1GeBV+D7LoSi+6WteGGrRY4RaDGaBSV10EMkt4U=\" rel=\"preload stylesheet\" as=style><link rel=icon href=https://qwenlm.github.io/favicon.png><link rel=apple-touch-icon href=https://qwenlm.github.io/favicon.png><link rel=manifest href=https://qwenlm.github.io/site.webmanifest><meta name=theme-color content=\"#615CED\"><link rel=alternate hreflang=en href=https://qwenlm.github.io/blog/qwen3.5-omni/><link rel=alternate hreflang=zh href=https://qwenlm.github.io/zh/blog/qwen3.5-omni/><noscript><style>#theme-toggle,.top-link{display:none}</style></noscript><script defer crossorigin=anonymous src=/js/custom.df2a5734071a3a99040f5e88e6d16d78358fbdef9a5e7389874ac5f2aa2ca86f.js integrity=\"sha256-3ypXNAcaOpkED16I5tFteDWPve+aXnOJh0rF8qosqG8=\"></script><link rel=stylesheet href=https://cdn.jsdelivr.net/npm/katex@0.16.3/dist/katex.min.css integrity=sha384-Juol1FqnotbkyZUT5Z7gUPjQ9gzlwCENvUZTpQBAPxtusdwFLRy382PSDx5UUJ4/ crossorigin=anonymous><script defer src=https://cdn.jsdelivr.net/npm/katex@0.16.3/dist/katex.min.js integrity=sha384-97gW6UIJxnlKemYavrqDHSX3SiygeOwIZhwyOKRfSaf0JWKRVj9hLASHgFTzT+0O crossorigin=anonymous></script><script defer src=https://cdn.jsdelivr.net/npm/katex@0.16.3/dist/contrib/auto-render.min.js integrity=sha384-+VBxd3r6XgURycqtZ117nYw44OOcIax56Z4dCRWbxyPt0Koah1uHoK0o4+/RRE05 crossorigin=anonymous></script><script>document.addEventListener(\"DOMContentLoaded\",function(){renderMathInElement(document.body,{delimiters:[{left:\"$$\",right:\"$$\",display:!0},{left:\"$\",right:\"$\",display:!1},{left:\"\\\\(\",right:\"\\\\)\",display:!1},{left:\"\\\\[\",right:\"\\\\]\",display:!0}],throwOnError:!1})})</script><script async src=\"https://www.googletagmanager.com/gtag/js?id=G-NMEMBZ8R90\"></script><script>var doNotTrack=!1;if(!doNotTrack){window.dataLayer=window.dataLayer||[];function gtag(){dataLayer.push(arguments)}gtag(\"js\",new Date),gtag(\"config\",\"G-NMEMBZ8R90\",{anonymize_ip:!1})}</script><meta property=\"og:title\" content=\"Qwen3.5-Omni：新一代大规模原生全模态大模型\"><meta property=\"og:description\" content=\"QWEN CHAT Hugging Face Offline Demo Hugging Face Realtime Demo ModelScope Offline Demo ModelScope Realtime Demo\nQwen3.5-Omni 是 Qwen 最新一代全模态大模型，支持文本、图片、音频、音视频理解。结构上，Qwen3.5-Omni 的 Thinker 与 Talker 均采用 Hybrid-Attention MoE 架构。Qwen3.5-Omni 系列包含 Plus、Flash、Light 三种尺寸的 Instruct 版本，支持 256k 长上下文，模型支持超过 10 小时的音频输入及超过 400 秒的 720P（1 FPS）音视频输入。模型在海量文本、视觉以及超过 1 亿小时的音视频数据上进行原生多模态预训练，该模型展现出卓越的全模态感知与生成能力。相比 Qwen3-Omni，Qwen3.5-Omni 多语言能力大大增强，能够支持 113 种语种和方言的语音识别和 36 种语种和方言的语音生成。目前可通过 Offline API 和 Realtime API 进行体验。\n离线（Offline）\nQwen3.5-Omni-Plus 在音频/音视频的理解、推理和交互任务上共取得了 215 项子任务/Benchmark 的 SOTA 成绩，涵盖 3 个音视频 Benchmark、5 个音频 Benchmark、8 个 ASR Benchmark、156 个面向语种的 S2TT 任务和 43 个面向语种的 ASR 任务。其中，通用音频理解/推理/识别/翻译/对话全面超越 Gemini-3.\"><meta property=\"og:type\" content=\"article\"><meta property=\"og:url\" content=\"https://qwenlm.github.io/zh/blog/qwen3.5-omni/\"><meta property=\"og:image\" content=\"https://qwenlm.github.io/%3Clink%20or%20path%20of%20image%20for%20opengraph,%20twitter-cards%3E\"><meta property=\"article:section\" content=\"blog\"><meta property=\"article:published_time\" content=\"2026-01-07T04:00:00+08:00\"><meta property=\"article:modified_time\" content=\"2026-01-07T04:00:00+08:00\"><meta property=\"og:site_name\" content=\"Qwen\"><meta name=twitter:card content=\"summary_large_image\"><meta name=twitter:image content=\"https://qwenlm.github.io/%3Clink%20or%20path%20of%20image%20for%20opengraph,%20twitter-cards%3E\"><meta name=twitter:title content=\"Qwen3.5-Omni：新一代大规模原生全模态大模型\"><meta name=twitter:description content=\"QWEN CHAT Hugging Face Offline Demo Hugging Face Realtime Demo ModelScope Offline Demo ModelScope Realtime Demo\nQwen3.5-Omni 是 Qwen 最新一代全模态大模型，支持文本、图片、音频、音视频理解。结构上，Qwen3.5-Omni 的 Thinker 与 Talker 均采用 Hybrid-Attention MoE 架构。Qwen3.5-Omni 系列包含 Plus、Flash、Light 三种尺寸的 Instruct 版本，支持 256k 长上下文，模型支持超过 10 小时的音频输入及超过 400 秒的 720P（1 FPS）音视频输入。模型在海量文本、视觉以及超过 1 亿小时的音视频数据上进行原生多模态预训练，该模型展现出卓越的全模态感知与生成能力。相比 Qwen3-Omni，Qwen3.5-Omni 多语言能力大大增强，能够支持 113 种语种和方言的语音识别和 36 种语种和方言的语音生成。目前可通过 Offline API 和 Realtime API 进行体验。\n离线（Offline）\nQwen3.5-Omni-Plus 在音频/音视频的理解、推理和交互任务上共取得了 215 项子任务/Benchmark 的 SOTA 成绩，涵盖 3 个音视频 Benchmark、5 个音频 Benchmark、8 个 ASR Benchmark、156 个面向语种的 S2TT 任务和 43 个面向语种的 ASR 任务。其中，通用音频理解/推理/识别/翻译/对话全面超越 Gemini-3.\"><script type=application/ld+json>{\"@context\":\"https://schema.org\",\"@type\":\"BreadcrumbList\",\"itemListElement\":[{\"@type\":\"ListItem\",\"position\":1,\"name\":\"Blogs\",\"item\":\"https://qwenlm.github.io/zh/blog/\"},{\"@type\":\"ListItem\",\"position\":2,\"name\":\"Qwen3.5-Omni：新一代大规模原生全模态大模型\",\"item\":\"https://qwenlm.github.io/zh/blog/qwen3.5-omni/\"}]}</script><script type=application/ld+json>{\"@context\":\"https://schema.org\",\"@type\":\"BlogPosting\",\"headline\":\"Qwen3.5-Omni：新一代大规模原生全模态大模型\",\"name\":\"Qwen3.5-Omni：新一代大规模原生全模态大模型\",\"description\":\"QWEN CHAT Hugging Face Offline Demo Hugging Face Realtime Demo ModelScope Offline Demo ModelScope Realtime Demo\\nQwen3.5-Omni 是 Qwen 最新一代全模态大模型，支持文本、图片、音频、音视频理解。结构上，Qwen3.5-Omni 的 Thinker 与 Talker 均采用 Hybrid-Attention MoE 架构。Qwen3.5-Omni 系列包含 Plus、Flash、Light 三种尺寸的 Instruct 版本，支持 256k 长上下文，模型支持超过 10 小时的音频输入及超过 400 秒的 720P（1 FPS）音视频输入。模型在海量文本、视觉以及超过 1 亿小时的音视频数据上进行原生多模态预训练，该模型展现出卓越的全模态感知与生成能力。相比 Qwen3-Omni，Qwen3.5-Omni 多语言能力大大增强，能够支持 113 种语种和方言的语音识别和 36 种语种和方言的语音生成。目前可通过 Offline API 和 Realtime API 进行体验。\\n离线（Offline）\\nQwen3.5-Omni-Plus 在音频/音视频的理解、推理和交互任务上共取得了 215 项子任务/Benchmark 的 SOTA 成绩，涵盖 3 个音视频 Benchmark、5 个音频 Benchmark、8 个 ASR Benchmark、156 个面向语种的 S2TT 任务和 43 个面向语种的 ASR 任务。其中，通用音频理解/推理/识别/翻译/对话全面超越 Gemini-3.\",\"keywords\":[\"Open-source\"],\"articleBody\":\" QWEN CHAT Hugging Face Offline Demo Hugging Face Realtime Demo ModelScope Offline Demo ModelScope Realtime Demo\\nQwen3.5-Omni 是 Qwen 最新一代全模态大模型，支持文本、图片、音频、音视频理解。结构上，Qwen3.5-Omni 的 Thinker 与 Talker 均采用 Hybrid-Attention MoE 架构。Qwen3.5-Omni 系列包含 Plus、Flash、Light 三种尺寸的 Instruct 版本，支持 256k 长上下文，模型支持超过 10 小时的音频输入及超过 400 秒的 720P（1 FPS）音视频输入。模型在海量文本、视觉以及超过 1 亿小时的音视频数据上进行原生多模态预训练，该模型展现出卓越的全模态感知与生成能力。相比 Qwen3-Omni，Qwen3.5-Omni 多语言能力大大增强，能够支持 113 种语种和方言的语音识别和 36 种语种和方言的语音生成。目前可通过 Offline API 和 Realtime API 进行体验。\\n离线（Offline）\\nQwen3.5-Omni-Plus 在音频/音视频的理解、推理和交互任务上共取得了 215 项子任务/Benchmark 的 SOTA 成绩，涵盖 3 个音视频 Benchmark、5 个音频 Benchmark、8 个 ASR Benchmark、156 个面向语种的 S2TT 任务和 43 个面向语种的 ASR 任务。其中，通用音频理解/推理/识别/翻译/对话全面超越 Gemini-3.1 Pro，音视频理解能力总体达到 Gemini-3.1 Pro 水平，同时视觉/文本能力达到同尺寸 Qwen3.5 模型效果。Qwen3.5-Omni-Plus 的一个强大的 feature 是音视频 caption 能力，可以生成可控的、详细的、结构化的音视频 caption，并生成剧本级细粒度描述，包括自动切片、时间戳打标和人物与音频关系的详细介绍。除此以外，通过原生多模态 Scaling，我们观察到了全模态模型涌现出了可以根据音视频指令直接进行 coding 的能力，我们称之为 Audio-Visual Vibe Coding，以上功能可以在 Offline API 上进行体验。我们强烈地建议用户阅读 Demo Section。\\n实时（Realtime）\\n除了强大的基座能力，更进一步地，我们着重加强了 Qwen3.5-Omni 的交互能力。第一，我们支持了语义打断，基于 Omni 开发了自动识别 turn-taking 意图的能力，避免附和和无意义背景音打断，该能力在 API 中已原生支持；第二，我们原生支持了 WebSearch 和复杂 Function Call 的调用能力，模型可以自主判断是否需要拉起 WebSearch 来回应用户的即时问题；第三，我们支持了端到端的语音控制和对话，让模型可以像人一样遵循指令，对声音的大小、语速、情绪等进行自由控制；第四，Qwen3.5-Omni 支持音色克隆，用户上传音色来定制 AI Assistant 音色，以上功能可以在 Realtime API 上进行体验。用户也可以自行更改 system prompt，来改变口语化、身份等信息，从而改变模型的行为；第五，针对流式语音交互中由于文本与语音 Token 编码效率差异导致的语音不稳定性，如漏读、误读或数字发音模糊等问题，我们提出了 ARIA（自适应速率交错对齐，Adaptive Rate Interleave Alignment）技术，动态对齐文本与语音单元，在保证实时性的前提下，显著提升了语音合成的自然度与鲁棒性。我们强烈地建议用户阅读 Demo Section 体验模型的最新效果。\\n模型效果 Audio-Visual\\rNext\\rAudio\\rNext\\rVisual\\rNext\\rText\\rNext\\rSpeech Generation\\rNext\\r下面我们在多种评估任务与模态下，对 Qwen3.5-Omni 与前沿模型进行全面对比评估。\\n音视频 Gemini-3.1 Pro Qwen3.5-Omni-Flash Qwen3.5-Omni-Plus Text Query QA DailyOmni 82.7 81.8 84.6 WorldSense 65.5 57.9 62.8 AVUT 85.6 81.4 85.0 AV-SpeakerBench 75.1 65.2 71.3 VideoMME (with audio) 89.0 79.3 83.7 Audio Query QA QualcommInteractive 66.2 66.3 68.5 Caption Omni-Cloze 57.2 63.0 64.8 Agent (tool use) OmniGAIA 68.9 33.9 57.2 * VideoMME (with audio): We evaluate our model with use_audio_in_video=True.\\n* OmniGAIA：We evaluate our model without a thinking prompt and without formatting. All results are evaluated using deepseek-v3.2-thinking.\\n音频 Gemini-3.1-Pro Qwen3.5-Omni-Flash Qwen3.5-Omni-Plus Audio Understanding MMAU 81.1 80.4 82.2 MMAR 83.7 74.0 80.0 MMSU 81.3 72.2 82.8 RUL-MuchoMusic 59.6 60.5 72.4 SongFormBench-HarmonixSet(acc|hr.5f|hr3f) 75.6 | 46.8 | 77.9 80.6 | 67.8 | 83.4 81.1 | 72.9 | 85.3 SongFormBench-CN(acc|hr.5f|hr3f) 78.1 | 43.2 | 71.9 86.7 | 66.4 | 84.6 87.1 | 65.7 | 84.2 Dialogue VoiceBench 88.9 87.8 93.1 URO-Bench-Pro(U|R|O) 69.1 | 84.0 | 99.2 64.1 | 83.8 | 98.7 66.3 | 86.3 | 99.8 SpeechRole 124.2 119.8 123.5 WildSpeech-Bench 76.3 72.2 75.4 S2TT Fleursxx⇄zh (top59) 29.5 26.9 30.2 Fleursxx⇄en (top59) 34.6 32.0 35.4 Fleursxx⇄zh/en (top59) 32.1 29.4 32.8 ASR Fleurs(top60) 7.32 10.75 6.55 CV15(zh|yue|zh-tw) 8.59 | 13.40 | 6.78 4.25 | 3.45 | 2.68 3.46 | 1.95 | 2.27 CV15(en) 8.73 5.90 4.83 Librispeech(clean|other) 3.36 | 4.41 1.30 | 2.43 1.11 | 2.23 Wenetspeech(net|meeting) 11.53 | 14.21 4.41 | 5.51 4.30 | 5.84 Kespeech 23.67 4.47 3.46 MIR-1K(vocal-only) 8.76 4.94 4.56 Opencpop 6.83 1.11 1.49 * SongFormBench: We use a unified prompt defining an SRT-like output timestamp format and a closed vocabulary for evaluation. The vocabulary follows the 'SongForm-HX-8Class' specified in the official codebase.\\n* URO-Bench-Pro: We use the pro track of URO-Bench and denote the three evaluation dimensions as follows: U for Understanding, R for Reasoning, and O for Oral Conversation. We use GenStyle-en, GenStyle-zh, Multilingual tasks for oral dimension. * ASR performance is evaluated using WER/CER, where lower values indicate better performance.\\n* Fleurs: The top59 languages are English, Chinese, Cantonese, Korean, Japanese, Vietnamese, Thai, Malay, German, Russian, Italian, French, Spanish, Portuguese, Dutch, Indonesian, Turkish, Arabic, Polish, Hindi, Urdu, Filipino, Persian, Czech, Greek, Swedish, Hebrew, Danish, Finnish, Norwegian, Icelandic, Bengali, Punjabi, Javanese, Marathi, Swahili, Ukrainian, Gujarati, Kannada, Azerbaijani, Malayalam, Cebuano, Romanian, Hungarian, Bulgarian, Belarusian, Catalan, Tamil, Croatian, Bosnian, Slovak, Galician, Kyrgyz, Macedonian, Slovenian, Latvian, Estonian, and Asturian; compared with the top60 list, Afrikaans is excluded because the Fleurs S2TT test set does not cover this language.\\n* MIR-1K: Transcription is converted into Simplified Chinese.\\n视觉 Qwen3.5-Plus-NoThinking Qwen3.5-Omni-Flash Qwen3.5-Omni-Plus STEM and Puzzle MMMU 81.0 76.9 80.1 MMMU-Pro 73.8 68.2 73.9 MathVision 73.6 65.4 73.0 Mathvista (mini) 86.9 82.9 86.1 DynaMath 84.2 79.3 83.8 ZEROBench 6 1 5 ZEROBench_sub 31.1 26.0 34.4 General VQA RealWorldQA 79.1 77.5 84.1 MMStar 80.3 75.7 79.4 MMBenchEN-DEV-v1.1 93.8 88.8 92.8 SimpleVQA 66.1 54.4 65.3 Text Recognition and Document Understanding CharXiv (RQ) 74.2 64.4 72.5 CC-OCR 83.0 80.8 83.4 AI2D_TEST 92.1 89.0 91.2 MMLongBench-Doc 59.7 53.6 57.5 OCRBench 91.4 89.1 91.3 Spatial Intelligence ERQA 53.8 50.0 54.8 CountBench 95.1 88.2 95.1 RefCOCO(avg) 95.2 92.6 95.0 ODInW13 50.3 46.8 49.5 EmbSpatialBench 83.4 82.7 85.4 Video Understanding VideoMME(w/o sub.) 81.0 77.0 81.9 MLVU(M-Avg) 85.1 81.9 86.8 MVBench 76.7 70.8 79.0 LVBench 68.6 65.7 71.2 MMVU 67.1 62.7 67.5 MME-VideoOCR 74.2 70.5 77.0 Medical VQA SLAKE 82.8 73.1 84.7 PMC-VQA 62.4 58.7 62.7 MedXpertQA-MM 55.3 44.8 54.7 文本 Qwen3.5-Plus-NoThinking Qwen3.5-Omni-Flash Qwen3.5-Omni-Plus Knowledge MMLU-Pro 86.8 79.9 85.9 MMLU-Redux 94.3 90.0 94.2 SuperGPQA 67.4 54.9 66.4 C-Eval 92.3 86.0 92.0 Instruction Following IFEval 89.7 85.2 89.7 IFBench 51.1 38.4 52.6 Long Context AA-LCR 62.0 46.0 57.0 LongBench v2 60.2 46.4 59.6 STEM GPQA 85.9 76.4 83.9 Reasoning LiveCodeBench v6 67.1 56.6 65.6 HMMT Nov 25 86.2 59.0 84.4 IMOAnswerBench 68.3 51.5 65.5 General Agent BFCL-V4 66.1 55.3 63.3 TAU2Bench 82.7 78.0 81.0 * Qwen3.5-Plus-NoThinking: we use Qwen3.5-Plus-NoThinking as the primary baseline, since all models here are evaluated in the same no-thinking setting.\\n* TAU2-Bench: we follow the official setup except for the airline domain, where all models are evaluated by applying the fixes proposed in the Claude Opus 4.5 system card.\\n语音生成 ElevenLabs Gemini-2.5 Pro GPT-Audio Minimax Qwen3.5-Omni-Plus Custom Voice Stability Seed-zh 13.08 2.42 1.11 1.19 1.07 Seed-en 1.17 1.18 1.16 1.35 1.35 Seed-hard 27.70 11.57 8.19 8.62 6.24 Public-Multilingual-avg (20 lang) 12.62 2.72 2.65 2.16 2.06 Inhouse-Multilingual-avg (9 lang) 20.63 6.61 6.72 11.71 5.82 * Stability is measured by Word Error Rate (WER, ↓). * \\\"Public-Multilingual-avg\\\" refers to the average performance on the public TTS-Multilingual-Test-Set, covering 20 languages. * \\\"Inhouse-Multilingual-avg\\\" refers to the average performance on an internal multilingual test set built upon Fleurs, covering 9 languages. * The performance is tested with the following APIs: ElevenLabs-Multilingual-V2 (9YHcvj6GT2YYXdXww), Gemini-2.5 Pro-Preview-TTS (Achernar), GPT-Audio-2025-08-28 (Alloy) and Minimax-Speech-2.8-HD (English_expressive_narrator) in March 2026. ElevenLabs Minimax Ground-Truth Qwen3.5-Omni-Plus Voice Clone Stability Public-Multilingual-avg (20 lang) 10.29 2.52 - 1.87 Inhouse-Multilingual-avg (9 lang) - - 9.68 7.04 Voice Clone Similarity Public-Multilingual-avg (20 lang) 0.65 0.76 - 0.79 Inhouse-Multilingual-avg (9 lang) - - - 0.80 * Stability is measured by Word Error Rate (WER, ↓) and similarity is measured by Cosine Similarity (SIM, ↑). * \\\"Public-Multilingual-avg\\\" refers to the average performance on the public TTS-Multilingual-Test-Set, covering 20 languages. * \\\"Inhouse-Multilingual-avg\\\" refers to the average performance on an internal multilingual test set built upon Fleurs, covering 9 languages. * Empty cells (-) indicate scores not yet available or not applicable. 模型架构 Qwen3.5-Omni 延续采用 Thinker-Talker 架构，Thinker 通过 Vision Encoder 和 AuT 接受视觉和音频信号输入，音视频信号通过 interleave 交织并搭配 TMRoPE 编码位置信息。Thinker 负责处理全模态信号并输出文本，Talker 负责接收来自 Thinker 的多模态输入以及文本输出，进行 contextual 语音生成，语音表征通过 Qwen3-Omni 提出的 RVQ 编码来替代繁重的 DiT 运算。由于 chunk-wise 的流式输入设计和流式 Talker 设计，整个模型可以进行 realtime interaction。不同于上一代 Qwen3-Omni 的双轨 Talker 输入，Talker 在输入的组织方式上采用了 ARIA（自适应速率交错对齐，Adaptive Rate Interleave Alignment）来动态对齐文本与语音单元，然后进行交错排布，以避免由于文本与语音 Token 编码效率差异导致的语音不稳定性，如漏读、误读或数字发音模糊等问题。\\nQwen3.5-Omni vs Qwen3-Omni Qwen3-Omni Qwen3.5-Omni 主干框架 MoE Hybrid-MoE 支持序列 32k 256k\\n音频：10个小时\\n音视频 (FPS=1)：400秒 Caption能力 音频 音视频 智能语义打断 无 支持 WebSearch/Tool 无 原生API支持 语音控制 无 支持 音色克隆 无 支持 Talker 双轨自回归 Interleave Text-Audio Tokenizer Rate Fixed (1:1) ARIA (Adaptive Rate Interleaved Alignment) 语音识别 11种多语言：中文、英语、德语、法语、意大利语、泰语、韩语、日语、俄语、西班牙语、葡萄牙语 8种方言：四川话、上海话、粤语、闽南语、陕西话、南京话、天津话、北京话 74种多语言：南非语、阿拉伯语、阿斯图里亚斯语、阿塞拜疆语、巴斯克语、白俄罗斯语、孟加拉语、波斯尼亚语、保加利亚语、粤语、加泰罗尼亚语、宿务语、中文、克罗地亚语、捷克语、丹麦语、荷兰语、英语、世界语、爱沙尼亚语、菲律宾语、芬兰语、法语、加利西亚语、格鲁吉亚语、德语、希腊语、希伯来语、印地语、匈牙利语、冰岛语、印尼语、国际语、意大利语、日语、爪哇语、卡纳达语、哈萨克语、韩语、柯尔克孜语、林加拉语、拉脱维亚语、立陶宛语、马其顿语、马来语、马拉雅拉姆语、马耳他语、毛利语、马拉地语、蒙古语、挪威语（博克马尔）、新挪威语、奥里亚语、波斯语、波兰语、葡萄牙语、旁遮普语、罗马尼亚语、俄语、塞尔维亚语、斯洛伐克语、斯洛文尼亚语、西班牙语、斯瓦希里语、瑞典语、塔吉克语、泰米尔语、泰卢固语、泰语、土耳其语、乌克兰语、乌尔都语、维吾尔语、越南语 39种方言：东北话、贵州话、广东粤语、河南话、香港粤语、上海话、陕西话、天津话、台湾话、云南话、安徽话、福建话、甘肃话、广东普通话、湖北话、湖南话、江西话、山东话、山西话、四川话、广西话、海南话、重庆话、长沙话、杭州话、合肥话、银川话、郑州话、沈阳话、温州话、武汉话、昆明话、太原话、南昌话、济南话、兰州话、南京话、客家话、闽南语 语音合成 29种多语言：中文、英语、德语、意大利语、葡萄牙语、西班牙语、日语、韩语、法语、俄语、泰语、印度尼西亚语、阿拉伯语、越南语、土耳其语、芬兰语、波兰语、印地语、荷兰语、捷克语、乌尔都语、他加禄语、瑞典语、丹麦语、希伯来语、冰岛语、马来语、挪威语、波斯语 7种方言：四川话、北京话、天津话、南京话、陕西话、粤语、闽南语 Demo 通用音视频理解 输入音视频（Audio-Visual Input），Qwen3.5-Omni-Plus 能够遵循指令生成细粒度、结构化、带时间戳的准确 Caption，以供用户进行音视频分析、分镜、审核等场景。\\n纪录片: 复杂场景 + 饮食 + 音效分析-Video Studio 剧情大纲 (Storyline) 00:00.000 – 00:05.000 一轮低垂的太阳悬在高楼林立的城市天际线之后，整体色调偏黯淡的棕褐与橙黄，雾霾将建筑边缘都柔化成模糊的剪影。一位使用标准普通话、语调平静的男性旁白开场说道：“中国人吃早饭的习惯始于两千多年前的汉代……”与此同时，轻柔飘渺的合成器铺底与若有若无的古筝拨弦共同建立起一种沉静、回望历史的气氛。镜头随后从天际线平缓滑向热闹的步行街，街边旗幡轻轻摆动，早餐摊前蒸汽升腾。\\n00:05.000 – 00:14.000 近景特写对准层层叠起的金属蒸笼，洁白蒸汽不断涌出。一块黄色招牌上用红字写着“麻辣牛肉系列 / 清炖牛牛牛 / 牛蹄筋 燕窝肉 / 豆豉脆脆骨”。镜头切到一只手将深色、辛香的汤汁舀入面碗，再撒上葱花。几张矮桌旁围满食客，一位穿灰色衬衫的白发老人吃得很香，筷子与瓷碗碰撞发出清脆声响。旁白说明，一日三餐的制度既维系了日常生活，也支持了劳动与生产。\\n00:14.000 – 00:20.000 微距镜头停留在油亮发红的大闸蟹外壳上，随后转向带壳扇贝：蒜蓉和红绿辣椒铺在贝肉之上，在黑色铁板上滋滋作响。低音弦乐微微抬升，强化了食物丰盛饱满的视觉感受。\\n00:20.000 – 00:35.000 一位穿粉色上衣的女子把一份砂锅菜舀给身旁穿黄色衣服的小男孩；俯拍镜头中，一家人围桌共享红烧肉和青菜。极近距离特写捕捉到筷子夹起一块泛着亮光的食物，以及一滴琥珀色汁液在慢动作中坠落。旁白感叹，同样的一日三餐，在中国却演变出不同的生活节奏，也塑造出不同的人生感受。\\n00:35.000 – 00:41.000 场景切换到黎明时分的宽阔江面。一艘白色游船划开一道V字形水痕，钢桁架桥和远方城市轮廓在雾气中若隐若现。白色公交车、蓝色出租车从桥上驶过。旁白指出，现代都市人对早餐的首要要求，就是简单快捷。\\n00:41.000 – 01:10.000 天津街头小吃的制作过程展开。一位穿黄色袖套围裙的师傅在巨大的圆形铁板上摊开绿豆面糊，打上一颗鸡蛋，撒上芝麻，刷上深色酱料，再夹入一片金黄酥脆的炸馃篦儿。滋啦作响的面糊、刮板摩擦铁板的声音，以及短促爆裂的油点声占据了主要声场。随后，一位穿灰色外套的女士和一位穿蓝色Polo衫的年轻男子分别咬下做好的煎饼果子，脸上带着满足的笑意。旁白赞美它“外柔内脆，咸香兼备”，而且只需两分钟便能享用。\\n01:10.000 – 01:25.000 浓雾笼罩着一条宽阔的褐色江面，几艘货船缓缓漂行，一只白色缆车从江面上方滑过。镜头进入一条被雨水打湿的街道，发光的红色招牌“秦云老太婆摊摊面”格外醒目。店内，一位穿蓝白格子衬衫的中年男子——秦云——用洪亮的川渝口音高声报号：“三十二号、四十号、四十七号，二两麻辣小面。”旁白介绍，他已经苦心经营十八年，专注打磨重庆小面的味道。\\n01:25.000 – 01:45.000 顾客们挤坐在蓝色塑料凳上。一位穿黄色围裙的女摊主把面条放入漏勺，下到滚水里汆烫，再转入盛满红油的面碗。一个食客点单：“老板，来碗小面，撒点海椒，多点花椒，加个蛋哦”，立刻得到一句爽快的“要得要得”。吸溜面条声、碗筷碰撞声与热闹的人声构成鲜活的早餐现场。旁白解释，一碗香气扑鼻的小面下肚，重庆人才算真正醒来。\\n01:45.000 – 02:05.000 细节镜头展示碱水如何被揉进面团，面筋网络逐渐形成，面条也因此获得弹性。蒸汽一度扑上镜头，厨师又往汤中加入青菜。旁白以平稳语气解释“碱水”的作用，说明它如何改变面条的口感与质地。\\n02:05.000 – 02:14.000 航拍镜头掠过横跨长江的巨大钢桥，随后扫过雾中的城市景观。镜头最终停在一条安静的江南水巷，白墙黛瓦沿河而立。一只手挑出一块蓝色木质菜单牌，上面写着“昆山卤鸭 15.00”。\\n02:14.000 – 02:35.000 来到苏州，细白面条从翻滚的大锅中捞起，放入一只蓝边面碗，碗中盛着清亮汤头和葱花，再铺上焖肉和青菜。不同年龄的食客安静地享用这碗清鲜淡雅的面。旁白赞美苏州面的精髓在于汤色清而不腻，并特别提到夏季时令的大肉面。\\n02:35.000 – 02:50.000 一艘编号为“537”的货船驶过悬索桥下方。紧接着，镜头切到立于青山上的武汉地标黄鹤楼。繁忙的厨房中，厨师们将金黄色圆饼投入热油，又在大铁板上摊开蛋液和肉馅，做成酥脆的三鲜豆皮，并切成整齐方块。\\n02:50.000 – 03:15.000 重点转向热干面：煮好的碱面与芝麻酱、葱花和红油快速翻拌。厨师手腕发力，动作有力而流畅，让每一根面条都均匀裹上酱汁。一位年长男子、一位年轻男子和一个小孩都吃得津津有味，脸上露出满足神情。旁白强调，要把芝麻酱调到恰到好处，并让它完美附着在面上，需要足够的耐心和腕力。\\n03:15.000 – 03:35.000 镜头回到重庆，秦云与一位老年女性坐在蓝色桌边，一边吃面一边交谈。一位戴眼镜、穿棕色外套的年轻女学徒在一旁观察，随后为食客端上热气腾腾的面碗。旁白指出，除了经营自己的面摊，秦云还是一位师傅，已经带出了两百多名学生。\\n03:35.000 – 03:55.000 近景特写展示八角、花椒和冰糖被称量后倒入翻滚着的红油大锅。女学徒评价道：“这碗面呢，麻辣味憨憨不够。”这句话引出秦云认真的回应：做面必须用心，也必须真正理解佐料。音乐此时温暖地抬升并趋于收束，蒸汽不断上升，影片在对手艺与匠心的强调中结束。\\n画面文本 (Visible Text) 00:04.000 – 00:06.000 “麻辣牛肉系列” （黄色竖向招牌上的红色文字，位于画面左上方）\\n“清炖牛牛牛” （同一招牌第二行红色文字）\\n“牛蹄筋 燕窝肉” （同一招牌第三行红色文字）\\n“豆豉脆脆骨” （同一招牌底部红色文字）\\n00:09.000 – 00:10.000 “锅巴菜 面茶 鲜豆浆” （黄色长横幅上的红色文字，位于食肆柜台上方）\\n01:14.000 – 01:16.000 “秦云老太婆摊摊面” （红色发光招牌上的白色文字，位于面摊入口上方）\\n02:13.000 – 02:14.000 “香糟鱼块面 16.00” （蓝色木质菜单牌上的白色文字与数字，竖排）\\n“红油焖肉面 9.00” （相邻蓝色菜单牌上的白色文字与数字）\\n“昆山卤鸭 15.00” （被手触碰的蓝色菜单牌上的白色文字与数字）\\n“枫镇大肉面 15.00” （相邻蓝色菜单牌上的白色文字与数字）\\n02:35.000 – 02:36.000 “537” （驶过货船白色船身上的黑色大号数字）\\n人声与对白脚本 (Speakers and Transcript) 人物简介： 旁白男声 – 成年男性，标准普通话，语调平静，纪录片式旁白风格，中低音稳定。 秦云 – 中年男性，川渝口音，声音鲜活，略带沙哑，带有摊主式的穿透力。 女学徒 – 年轻女性，四川口音，发音清楚，语气认真，音高偏中高。 男顾客 – 成年男性顾客，四川口音，语气自然随意，态度友好。\\n00:00.588 – 00:13.228 说话人：旁白男声 状态：平静，信息性，语速从容 内容：“中国人吃早饭的习惯始于两千多年前的汉代，此后华夏大部分地区都实行早、午、晚三餐制，利于生活，也利于生产。”\\n00:15.468 – 00:27.148 说话人：旁白男声 状态：思考性，讲解式 内容：“尽管一日三餐几乎成为人类共同的饮食制度，同样的饭食在中国却变换出不同的生活节奏，塑造出各异的人生感受。”\\n00:36.940 – 00:39.820 说话人：旁白男声 状态：陈述事实 内容：“现代城市人早餐的首要需求就是简单快捷。”\\n00:41.020 – 00:43.500 说话人：旁白男声 状态：轻松，肯定 内容：“天津人最懂得这一点。”\\n00:45.100 – 00:52.460 说话人：旁白男声 状态：描述性，温和 内容：“绿豆面展开一个美妙的圆形，薄匀不破，鸡蛋保证营养。”\\n00:58.476 – 01:02.396 说话人：旁白男声 状态：略带兴奋，赞赏 内容：“果篦儿，馄饨皮油炸而成，金黄酥脆。”\\n01:04.476 – 01:10.956 说话人：旁白男声 状态：轻快 内容：“煎饼果子外柔内脆，咸香兼备，享受它只需要两分钟。”\\n01:14.316 – 01:16.876 说话人：旁白男声 状态：强调 内容：“中国早餐，味道至关重要。”\\n01:18.556 – 01:22.156 说话人：旁白男声 状态：赞赏 内容：“苦心经营十八年，秦云深知其中奥秘。”\\n01:22.156 – 01:26.076 说话人：秦云 状态：高声，报号，节奏利落 内容：“三十二号、四十号、四十七号，二两麻辣小面。”\\n01:27.676 – 01:34.876 说话人：秦云 状态：聊天式，带几分自豪 内容：“重庆人天天吃小面，越吃越想吃，好多时候早上啊好像不吃小面呢，都觉得好像我们今儿一天呢都不舒服。”\\n01:35.516 – 01:39.276 说话人：男顾客 状态：随意点单 内容：“老板，来碗小面，撒点海椒，多点花椒，加个蛋哦。”\\n01:39.436 – 01:39.996 说话人：秦云 状态：爽快回应 内容：“要得要得。”\\n01:40.876 – 01:45.196 说话人：旁白男声 状态：生动，总结性 内容：“一碗香气扑鼻的小面下肚，重庆人才真正醒来。”\\n01:47.948 – 02:01.548 说话人：旁白男声 状态：讲解性，带说明意味 内容：“碱是和面的关键，它能使面中的谷胶蛋白结成致密的网络，锁紧淀粉颗粒，面汤不致浑浊，还能让面条在嘴里产生令人愉悦的弹性。”\\n02:07.372 – 02:11.212 说话人：旁白男声 状态：信息性 内容：“长江流域各大码头都有碱水面的地盘。”\\n02:13.452 – 02:24.012 说话人：旁白男声 状态：描述性 内容：“苏州面，味道来自于汤，清而不腻。细面是苏式面的精髓，装碗不脱水，不泼汤。”\\n02:26.380 – 02:33.900 说话人：旁白男声 状态：欣赏，生动描述 内容：“夏季的大肉面，浇头是一块白嫩肥美的焖肉，白糟粒粒，面汤鲜滑。”\\n02:37.996 – 02:46.476 说话人：旁白男声 状态：说明性 内容：“武汉人把吃早饭叫过早，口味偏好咸鲜，面窝、三鲜豆皮都是广受推崇的早点。”\\n02:50.988 – 03:04.348 说话人：旁白男声 状态：讲解性，较为细致 内容：“而碱面做的热干面才最代表这个城市的气质，水煮、拌麻油、晾干，芝麻酱必须调制的稠而不泄，这样才能均匀全面地附着在面上。”\\n03:06.892 – 03:11.692 说话人：旁白男声 状态：认真，强调技艺 内容：“要达到这个效果，需要付出足够的腕力和持久的耐心。”\\n03:18.988 – 03:24.908 说话人：旁白男声 状态：尊重，信息性 内容：“除了当老板，重庆的秦云还收徒弟，他的学生已经超过两百人。”\\n03:38.252 – 03:39.852 说话人：女学徒 状态：温和地提出评价 内容：“这碗面呢，麻辣味憨憨不够。”\\n03:41.692 – 03:54.412 说话人：秦云 状态：认真，带有师傅式指导口吻 内容：“做面呢，更多的用心去做，你如果不用心去做，都是那个佐料摆在上面，随意的拿着瓢瓢或者说那个打，肯定不得行，包括你对佐料的了解度啊，肯定不够。”\\n视听风格补充说明 背景音乐： 全片使用持续而克制的音乐铺陈，以合成器氛围音、轻柔古筝式拨弦和间歇性的弦乐起伏为主。食物制作蒙太奇时音量略微抬升，进入对白与摊主交流时则主动退居背景。\\n突出环境音：\\n蒸笼与蒸汽喷出的嘶嘶声（00:05–00:08） 铁板上面糊摊开、鸡蛋打入时的滋啦声（00:41–00:55） 馃篦儿与面窝下油锅时的沸腾炸响（00:55–01:03；02:37–02:45） 沸水翻滚、漏勺与锅边碰撞的金属声（01:27–01:45；02:15–02:20） 用餐段落中持续可闻的吸面声与瓷碗轻碰声（尤其在01:30–01:45与03:05–03:15） 环境氛围： 城市场景与食肆内部始终铺着一层自然的市井底噪：行人低语、摊贩招呼、餐馆喧闹与街道回响。这些声音保持鲜活但不过分压过旁白，使影片具备真实、热闹而不杂乱的纪录片气质。\\n主题概述 本片是一部篇幅精炼的美食纪录短片，以“中国早餐”为主题，赞美各地极具代表性的地方早饭文化。影片通过细腻的微距食物摄影和跨地域的城市切换，对比了天津煎饼果子的迅捷便利、重庆小面的辛辣灵魂、苏州苏式面的清雅讲究，以及武汉热干面与三鲜豆皮的厚重咸鲜。叙事主线强调，早餐不仅是果腹的一餐，更折射出地方生活方式、历史传统与城市性格。秦云这一人物则承担了“手艺传承者”的角色，将地方味道从师傅传给徒弟。结尾反复强调的“用心去做”，进一步把食物上升为一种文化表达：它关乎耐心、关乎经验，也关乎一个地方最具体而真实的身份认同。\\n电影: 多人多镜头+复杂音效音视频分析 剧情梗概 (Storyline) 00:00.000 – 00:04.796\\n深绿色的画面填满屏幕。中心位置以白色大写字母显示美国电影协会（MPAA）的标准预告片审核分级通知。底部边缘有两个较小的白色网址。此时没有音乐，背景保持安静，使观众全神贯注于文字内容。\\n00:04.796 – 00:06.465\\n绿底画面切至全黑。一声带有金属余韵的沉重管弦乐撞击声响起，营造出紧张的电影氛围。\\n00:06.465 – 00:10.219\\n镜头飞掠过繁华大都市的夜晚航拍画面。摩天大楼闪烁着金、蓝、红色的灯光；摄像机缓慢向一座灯火通明的塔楼推进。一个低沉沙哑、充满亲近感的男声低语道：“靠近一点。”管弦乐基调在他的话语下逐渐增强。\\n00:10.219 – 00:17.768\\n场景切换至座无虚席的剧院内部。从高角度俯视，四名表演者（三男一女）站在一个由白色霓虹灯环绕的黑色亮面圆形舞台上。聚光灯打在一名身穿深色西装、戴着软呢帽的男子身上，他向观众轻扣帽檐致意。镜头切至观众席：一位戴着软呢帽的老年黑人男子正专注地观看。回到舞台，身着黑色短裙的女表演者站在一个发光的黄色矩形框架内，而戴软呢帽的男子则在做着戏剧性的手势。旁白继续说道：“因为你以为你看得越真……就越容易被欺骗。”最后一个词落下时，一声清脆的打击乐声强化了语气。特写镜头显示一名头发蓬乱的年轻人正在弹拨一张扑克牌，红桃A瞬间显现。\\n00:17.768 – 00:21.188\\n一道蓝色镜头光晕扫过黑色背景，露出银色的顶峰娱乐（Summit Entertainment）标志及其标志性的山峰图案。管弦乐得分激增。随后画面切至拉斯维加斯大道的夜景全貌，画面中心是金光灿烂的巴黎拉斯维加斯艾菲尔铁塔，以及“BALLY’S”、“MIRAGE”和“THE LINQ”的霓虹灯招牌。\\n00:21.188 – 00:30.113\\n再次回到剧院内，四位魔术师——此时换上了协调的深色西装——大步走上舞台。观众席欢呼雀跃。一块蓝色帆布被猛地掀开，露出一台透明的钢架瞬间移动箱。箱体侧面的数字时钟显示为“0:00”。身着浅色西装的领头魔术师宣布：“女士们先生们，作为我们的压轴戏，我们要抢劫一家银行。我数到三，你们将跨越时空，被传送到你们在巴黎的银行。”人群惊呼。他计数：“一，二，三！”随着箱子发出一道蓝光，伴随着低沉的呼啸声和能量碎裂声。\\n00:30.113 – 00:37.955\\n切换至巴黎：夜晚灯火辉煌的“共和信贷银行（CRÉDIT RÉPUBLICAIN）”外墙。在金库内部，四位魔术师——此时穿着正式晚礼服——站在巨大的圆形金库门前。回到剧院，女魔术师对观众席说：“在这个房间里的每一个人都是艰难时期的受害者。你们中有些人失去了房子，有些人失去了车。所以今晚，我们要把其中的一部分钱归还给你们。”舞台上喷涌出大量的欧元钞票，在欢呼的观众头顶飞舞，人们纷纷伸手抓钱。\\n00:37.955 – 00:46.255\\n魔术师们在漫天飞舞的钞票中鞠躬。领头人宣布：“谢谢大家。我们是天启四骑士。晚安！”观众席爆发起热烈的掌声。场景转换到一个大理石地面的银行内部，一群身着西装、神情严肃的男子在一位白发老者的带领下走下宏伟的阶梯。他宣称：“你们的银行只是个诱饵，掩护他们布置真正的戏法。而我，是一个价值1.4亿美元的烟雾弹。”他的声音充满了沾沾自喜的满足感。\\n00:46.255 – 00:55.514\\n一家昏暗的酒吧里：戴软呢帽的老年黑人与白发银行家商谈，交换着心照不宣的眼神。在一个明亮、洁净的金库走廊里，一名身穿白色连身衣的技术人员推着装满现金的小车。戴软呢帽的老者沉思道：“谁不爱精彩的魔术呢？”金属撞击声和一声“FBI！”的喊叫切入一个现代办公室，一名特工大喊：“手放在我看得见的地方！”\\n00:55.514 – 01:03.397\\n在拉斯维加斯大道上，一名拿着电话的西装男子难以置信地问道：“你是说魔术师抢了银行？”分屏蒙太奇显示了每一位“四骑士”分别身处审讯室，冷静地玩弄着纸牌或手铐。其中一人冷笑：“这就是我们这一行常说的——‘袖子里空无一物’。”镜头在他的自信笑容上停留。\\n01:03.397 – 01:12.614\\n审讯升级。同一名魔术师身体前倾，声音低沉但带着嘲弄：“因为如果你不这么认为，那就意味着你、FBI以及你在国际刑警组织的朋友们真的相信魔法。”他突然将戴着手铐的双手猛击在桌面上，吓了审讯员一跳。他总结道：“魔术的第一条准则：永远要做房间里最聪明的人。”快速的蒙太奇闪过：软呢帽轻扣、“四骑士”在舞台上鞠躬、老年黑人低语：“想知道他们是怎么做到的吗？说出那个咒语。”\\n01:12.614 – 01:24.001\\n车内的一名女特工评论道：“一年前，这帮人还只是一群街头魔术师。”画面切至“四骑士”在璀璨城市夜景背景下的摩天大楼顶层表演。她继续说：“现在他们正在实施惊人的劫案，却不为自己留一分钱。”此时换上礼服的老年黑人语调庄重：“你得意识到，这是一场在全球范围内玩的博弈。”\\n01:24.001 – 01:34.469\\n镜头快速剪辑：三个穿白色连身衣的人接近金库；停车场的一辆装甲车爆炸，钞票四散；“四骑士”研究金库的全息蓝图；女特工警告说：“我们面对的是远超我们想象的东西。”白发银行家咆哮道：“现在就揭穿他们，毁灭他们。”\\n01:34.469 – 01:45.605\\n动作场面升级：一架流线型私人飞机掠过云端；一辆红色跑车在艾菲尔铁塔的铁架间飞驰；黑暗房间里的一名男子展示一张标有“高塔 / LA MAISON DIEU”的塔罗牌。戴软呢帽的老者说道：“拉斯维加斯只是个开始。这个局很久以前就设好了。”\\n01:45.605 – 02:00.203\\n一名红褐色头发的女性恳求道：“我们来到这里都是为了同一个原因。”老黑人严厉地回绝：“我们现在不能放弃。”一个穿着西装的枪手在空荡的房间里举起手枪。舞台上，一名“骑士”被猛地拽向刺眼的聚光灯后消失不见。管弦乐达到雷鸣般的高潮。\\n02:00.203 – 02:11.006\\n老黑人的声音叠在飞速闪过的画面上：“无论接下来的，无论这个伟大的戏法是什么……它都将令人惊叹。”一辆红色轿车冲破一栋布满涂鸦的建筑物屋顶，向夜空撒下漫天钞票。包括戴软呢帽的老者和一名金发女性在内的观众抬头仰望，目瞪口呆。\\n02:11.006 – 02:17.554\\n旁白发出最后的警告：“看仔细了，因为你以为你离得越近，你真正看到的就越少。”屏幕切黑，随后一道灿烂的蓝色光晕揭示了金属质感的片名“NOW YOU SEE ME”（惊天魔盗团），字母闪烁着铬合金的反光。\\n02:17.554 – 02:24.603\\n在黑色背景下，醒目的白色文字宣布“MAY 31”（5月31日），随后是Facebook图标和“NowYouSeeMeMovie”、标签“#NowYouSeeMe”以及一行微小的版权信息。音乐以最后一个悠长的和弦结束，随后画面随寂静淡入全黑。\\n屏幕文字 (Visible Text) 00:00.000 – 00:04.796\\n“以下预告片已被批准播放给” —— 白色大写无衬线体，居中于深绿底色\\n“合适观众” —— 字号更大、加粗的白色大写，居中\\n“由美国电影协会（MPAA）审核” —— 白色大写，居中\\n“www.filmratings.com” —— 左下角白色小写\\n“www.mpaa.org” —— 右下角白色小写\\n00:17.768 – 00:19.500\\n“SUMMIT ENTERTAINMENT”（顶峰娱乐） —— 银色大写衬线体，位于艺术化的山峰标志下方，屏幕中心\\n“A LIONSGATE COMPANY”（狮门影业旗下公司） —— 较小的银色大写，位于主标志正下方居中\\n00:19.500 – 00:21.188\\n“BALLY’S” —— 酒店外墙的大型红色霓虹灯字母，画面左上角\\n“MIRAGE” —— 相邻建筑上的白色霓虹灯字母，画面中左侧\\n“THE LINQ” —— 右侧建筑上的白色霓虹灯字母\\n00:21.188 – 00:30.113\\n“0:00” —— 舞台右侧瞬间移动箱上小型黑色显示屏上的红色七段数码管数字\\n00:28.000 – 00:30.000\\n“CRÉDIT RÉPUBLICAIN”（共和信贷银行） —— 石质银行外墙上的金色衬线大写字母，巴黎夜景\\n01:40.000 – 01:41.500\\n“THE TOWER” —— 塔罗牌风格卡片顶部的黑色大写\\n“LA MAISON DIEU”（高塔） —— 同一张卡片底部的黑色大写\\n02:17.554 – 02:19.000\\n“NOW YOU SEE ME” —— 大型金属银色3D字母，带有蓝色光晕，黑色背景居中\\n02:20.000 – 02:22.000\\n“MAY 31” —— 大型白色大写，居中\\nFacebook “f” 标志及“NowYouSeeMeMovie” —— 白色，位于日期下方居中\\n“#NowYouSeeMe” —— 白色，位于社交媒体行下方居中\\n“© 2013 SUMMIT ENTERTAINMENT, LLC. ALL RIGHTS RESERVED.” —— 极小的白色大写，底部中央\\nLionsgate 艺术化的 “L” 标志 —— 白色小图标，右下角\\n讲述者与对白 (Speakers and Transcript) 人物简介：\\n旁白 (Narrator) —— 老年男性，深沉沙哑的美式嗓音，语速沉稳，充满悬疑感 领头魔术师 (Lead Magician) —— 30多岁男性，清晰的中音美式口音，充满表演者的自信，表达感强 女魔术师 (Female Magician) —— 20多岁女性，响亮的美式口音，具有说服力，语气热诚 老银行家 (Older Banker) —— 60多岁晚期男性，儒雅的美式口音，威严且自负 软呢帽老者 (Fedora Elder) —— 60多岁晚期黑人男性，浑厚的男低音，冷静且富有哲理 审讯员 (Interrogator) —— 40多岁男性，强硬的美式口音，有力且急躁 受审的街头魔术师 (Street-Magician Interrogated) —— 30多岁早期男性，轻松的美式口音，讽刺且爱戏耍 女特工 (Female Agent) —— 30多岁女性，平稳的美式口音，冷静分析且带有忧虑 00:08.364 – 00:09.004\\n人声： 旁白\\n状态： 音量低沉，亲近，带有悬疑感\\n内容： “靠近一点。”\\n00:10.364 – 00:17.724\\n人声： 旁白\\n状态： 缓慢，警示性，沙哑\\n内容： “因为你以为你看得越真，就越容易被欺骗。”\\n00:19.644 – 00:23.004\\n人声： 领头魔术师\\n状态： 声音宏亮，带有戏剧性的兴奋感\\n内容： “女士们先生们，作为我们的压轴戏，我们要抢劫一家银行。”\\n00:23.884 – 00:29.484\\n人声： 领头魔术师\\n状态： 响亮的宣告，语调逐渐升高\\n内容： “我数到三，你们将跨越时空，被传送到你们在巴黎的银行。”\\n00:29.724 – 00:31.244\\n人声： 领头魔术师\\n状态： 大声，有节奏的倒数\\n内容： “一，二，三。”\\n00:31.244 – 00:36.444\\n人声： 女魔术师\\n状态： 诚恳，富有同情心\\n内容： “在这个房间里的每一个人都是艰难时期的受害者。”\\n00:36.604 – 00:40.764\\n人声： 女魔术师\\n状态： 号召性的，充满希望\\n内容： “你们中有些人失去了房子，有些人失去了车。所以今晚，我们要把其中的一部分钱归还给你们。”\\n00:44.044 – 00:44.684\\n人声： 领头魔术师\\n状态： 感激，欢快\\n内容： “谢谢大家。”\\n00:44.844 – 00:46.284\\n人声： 领头魔术师\\n状态： 凯旋般的宣言\\n内容： “我们是天启四骑士。”\\n00:46.284 – 00:47.004\\n人声： 领头魔术师\\n状态： 欢快的告别词\\n内容： “晚安。”\\n00:48.780 – 00:52.860\\n人声： 老银行家\\n状态： 克制，解释性的\\n内容： “你们的银行只是个诱饵，掩护他们布置真正的戏法。”\\n00:53.100 – 00:57.260\\n人声： 老银行家\\n状态： 吹嘘，自鸣得意\\n内容： “我是一个价值一亿四千万美元的烟雾弹。”\\n00:57.260 – 01:00.140\\n人声： 软呢帽老者\\n状态： 感到有趣，沉思\\n内容： “谁不爱精彩的魔术呢？”\\n01:01.100 – 01:02.540\\n人声： 审讯员\\n状态： 大声命令，紧张\\n内容： “FBI！手放在我看得见的地方。”\\n01:02.940 – 01:04.140\\n人声： 受审魔术师\\n状态： 讽刺性的怀疑\\n内容： “我好像没听清。”\\n01:04.220 – 01:05.900\\n人声： 受审魔术师\\n状态： 难以置信，嘲弄\\n内容： “你是说魔术师抢了银行？”\\n01:06.060 – 01:07.260\\n人声： 受审魔术师\\n状态： 沾沾自喜，挑战性\\n内容： “你被耍了。”\\n01:07.260 – 01:10.540\\n人声： 受审魔术师\\n状态： 教训式，戏谑\\n内容： “你遭遇了我们这一行常说的——袖子里空无一物。”\\n01:10.700 – 01:15.340\\n人声： 受审魔术师\\n状态： 嘲笑，自信\\n内容： “因为如果你不这么认为，那就意味着你、FBI以及你在国际刑警组织的朋友们真的相信魔法。”\\n01:18.380 – 01:19.660\\n人声： 受审魔术师\\n状态： 教条式，干脆\\n内容： “魔术的第一条准则：永远要做房间里最聪明的人。”\\n01:23.660 – 01:24.540\\n人声： 软呢帽老者\\n状态： 调侃，神秘\\n内容： “想知道他们是怎么做到的吗？”\\n01:24.780 – 01:25.740\\n人声： 软呢帽老者\\n状态： 邀请，戏谑\\n内容： “说出那个咒语。”\\n01:26.700 – 01:28.940\\n人声： 女特工\\n状态： 分析式，实事求是\\n内容： “一年前，这帮人还只是一群街头魔术师。”\\n01:31.180 – 01:34.860\\n人声： 女特工\\n状态： 印象深刻，警觉\\n内容： “现在他们正在实施惊人的劫案，却不为自己留一分钱。”\\n01:35.980 – 01:40.300\\n人声： 软呢帽老者\\n状态： 严肃，解释性\\n内容： “你得意识到，这是一场在全球范围内玩的博弈。”\\n01:40.780 – 01:41.900\\n人声： 软呢帽老者\\n状态： 凶险，不祥\\n内容： “拉斯维加斯只是个开始。”\\n01:42.460 – 01:45.260\\n人声： 软呢帽老者\\n状态： 反思，预示性\\n内容： “这个局很久以前就设好了。”\\n01:46.220 – 01:48.460\\n人声： 女特工\\n状态： 担忧，紧迫\\n内容： “我们面对的是远超我们想象的东西。”\\n01:49.100 – 01:50.540\\n人声： 红发女性\\n状态： 果断，诚恳\\n内容： “我们来到这里都是为了同一个原因。”\\n01:50.620 – 01:51.980\\n人声： 软呢帽老者\\n状态： 坚定，有力\\n内容： “我们现在不能放弃。”\\n01:53.660 – 01:56.060\\n人声： 老银行家\\n状态： 冷酷，命令式\\n内容： “现在就揭穿他们，毁灭他们。”\\n02:01.036 – 02:09.196\\n人声： 软呢帽老者\\n状态： 期待，宏大\\n内容： “无论接下来的，无论这个伟大的戏法是什么……它都将令人惊叹。”\\n02:11.116 – 02:17.356\\n人声： 旁白\\n状态： 缓慢，警示，回味悠长\\n内容： “看仔细了，因为你以为你离得越近，你真正看到的就越少。”\\n电影风格与主题补充注释 (Additional Notes on Cinematic Style and Themes) 视觉美学 (Visual Aesthetics)： 预告片将沐浴在蓝金灯光下的华丽、高对比度舞台表演与粗粝的城市夜景及冷峻的政府机构内部场景并列，强化了“奇观”与“秘密行动”之间的二元对立。 母题 (Motifs)： 扑克牌、金库大门、漫天飞钱以及标志性地标（艾菲尔铁塔、拉斯维加斯大道）的反复出现，突出了幻象、财富再分配和全球博弈的主题。 音效设计 (Sound Design)： 管弦乐与电子乐融合的配乐推动了节奏，金属撞击声、呼啸声和观众的欢呼声与视觉呈现紧密同步，增强了大魔术的感官震撼。 叙事弧线 (Narrative Arc)： 预告片确立了“天启四骑士”的形象：他们是极具魅力的魔术师大盗，通过劫富济贫来揭露腐败；而执法部门和强大的金融大亨则竭力想揭开他们的面具，由此拉开了一场国际规模的猫鼠游戏。\\n游戏: 基于音视频判断是否包含暴力场景 Demo\\rUser\\r请对视频进行详尽的合规性分析。你的目标是作为一名专业的未成年人内容保护审核员，识别视频中所有可能对未成年人产生负面影响的内容。 ### 核心分析要求： 1. **零容忍政策 (Zero-Tolerance Policy)：** 在审核过程中，请以保护未成年人心理及生理健康为最高准则。如果某段内容在是否“适宜”上存在不确定性，请始终采取审慎态度，将其标记为不适宜内容。 2. **重点检测范围：** - **暴力与血腥：** 真实的流血、重伤、肢体残缺、武器使用、攻击性身体接触。 - **危险行为：** 易被模仿的危险特技、无防护的冒险动作。 - **言语与欺凌：** 针对个人的辱骂、霸凌、恐吓及歧视性言论。 - **不当主题：** 成人化倾向、毒品/酒精滥用、引起极端恐惧的恐怖视觉或听觉刺激。 ### 输出格式要求： ```markdown ## 第一部分：合规预警摘要 (Compliance Alert Summary) 请提供一份表格，汇总所有被检测到的违规片段，以供快速查阅： | 时间区间 | 违规类别 | 风险等级 | 违规理由描述 | | :--- | :--- | :--- | :--- | | xx:xx - xx:xx | 例如：暴力行为 | 高 | 例如：观察到真实且激烈的肢体冲突，包含头部打击。 | ## 第二部分：安全评估结论 (Summary of Safety Findings) 请基于全片内容提供最终评估结论，判断该视频是否适合未成年人观看。 - 必须引用最关键的时间节点。 - 详细说明整体风险画像（Risk Profile）。 - 解释为何判定其适合或不适合未成年人。 Qwen3.5-Omni-Plus\\r第一部分：合规预警摘要 (Compliance Alert Summary) 时间区间 违规类别 风险等级 违规理由描述 01:29 - 01:48 暴力与血腥 高 角色被撕成两半，内脏与骨骼外露，伴随大量喷溅血液与痛苦惨叫。 02:29 - 02:46 暴力与血腥 高 角色被斩首并开膛破肚，内脏与血液大量喷溅，画面极度血腥。 03:17 - 03:38 暴力与血腥 高 角色被冰冻后碎裂成无数冰块，伴随血液飞溅与肢体断裂。 04:15 - 04:37 暴力与血腥 高 角色被灵魂撕裂，身体与灵魂分离，伴随蓝色能量撕裂与血液喷溅。 05:07 - 05:29 暴力与血腥 高 角色被炸弹炸成碎片，肢体与内脏四散，伴随大量血液与火焰。 05:58 - 06:24 暴力与血腥 高 角色被掏空内脏并扯下头颅，内脏与血液喷溅，画面极度残忍。 06:57 - 07:20 暴力与血腥 高 角色被直升机螺旋桨绞碎，肢体与内脏四散，伴随大量血液飞溅。 第二部分：安全评估结论 (Summary of Safety Findings) 该视频不适合未成年人观看。从01:29开始，视频连续展示了多段极端暴力与血腥的“终结技”场景，包括角色被撕成两半、斩首、冰冻碎裂、灵魂撕裂、炸弹炸碎、掏空内脏、被直升机绞碎等。这些画面包含大量真实感极强的血液喷溅、内脏外露、肢体残缺与痛苦惨叫，视觉冲击力极强，极易对未成年人造成心理创伤与恐惧。此外，视频中无明确年龄分级提示或内容警告，且暴力行为被设计为游戏机制的一部分，可能被误读为“可接受的娱乐行为”，存在模仿风险。根据零容忍政策，此类内容应被严格限制，建议仅对18岁以上成年观众开放，并需附加明确的内容警示。\\n短视频: 生活短视频分析 剧情梗概 (Storyline) 00:00.000 – 00:01.300\\n画面为竖屏近景，一位东亚年轻女性处于画面中心，从胸部以上出镜。背景是光线柔和的卧室（米色墙壁、木制床头板、凌乱的浅褐色毯子）。她穿着一件浅豆绿色的T恤（上面的白色大写字母部分可见），戴着细银项链，左手腕戴着一块浅蓝色手表。一只大眼睛的黑色卡通猫图形俏皮地定格在她头顶。屏幕上方中间位置固定着一个白色横条，上面写着黑色文字：“中外动物叫法大不同 你知道几个？”。右下角有一个小小的白色水印“Roxycat猫姐 bilibili”。轻快诙谐的拨弦乐响起并作为背景音乐播放。她直视镜头，欢快地问道：“国外的狗怎么叫？”底部的黑色字幕框同步显示黄色文字。\\n00:01.300 – 00:03.400\\n镜头切换到她脸部的特写，背景变为素雅的青色墙面。她嘟起嘴，然后张成“O”型，发出一声低沉的“Woof”。紧接着，她用稍高且短促的语气重复了“woof woof”。每发一次声，底部都会出现黑色字幕框：先是“Woof (拟声词)”，然后是“woof woof”。背景音乐轻声持续。\\n00:03.400 – 00:06.000\\n画面切回原来的卧室布景。她问：“中国的狗怎么叫？” 屏幕出现对应字幕。随后她爽快地回答：“汪，”接着是更快、调门更高的“汪汪，” 每一声都配有对应的黑底黄字字幕“汪”和“汪汪”。卡通猫和顶部横条保持不变。\\n00:06.000 – 00:10.400\\n仍在卧室场景，她提问：“国外的猫怎么叫？” 字幕同步显示。她发出圆润的“Meow”，出现字幕“Meow (拟声词)”。接着她拉长声音发了另一个“Meow”，新字幕显示“喵呜 (声音发的比较圆)”。欢快的音乐持续播放。\\n00:10.400 – 00:13.000\\n镜头未切换，她问：“中国的猫怎么叫？” 字幕同步。她回答一个干脆的“喵，” 然后是快速的“喵喵，” 对应字幕“喵”和“喵喵”。她的表情依旧生动，头顶的卡通猫随其动作轻微晃动。\\n00:13.000 – 00:18.000\\n她继续问：“国外的牛怎么叫？” 出现字幕。她发出一声低沉悠长的“Moo，” 然后是更长且带有颤音的“Mooooooooooo”，后者的字幕也随之拉长。背景音乐保持轻松幽默的基调。\\n00:18.000 – 00:24.000\\n镜头下移，露出一张办公桌和一台黑色笔记本电脑，她的双手正在飞快打字。她问：“中国的牛怎么叫？” 出现字幕。紧接着，她立刻切换成一种语速极快、略显紧绷的“客服腔”：“啊收到好的老板，你要的文件今天凌晨2点马上发送给你。” 对应的多行字幕依次出现。随着她打字，她衬衫上的白色字母变得清晰（虽然是镜像的），可以看到倒置的片段如“I AM AN INTELLIGENT”。\\n00:24.000 – 00:28.000\\n镜头快速切回她的脸部。顶部横条被替换为加粗的白色文字“中国纯种老黄牛”，居中显示。背景音乐转为节奏较慢、带有忧伤弦乐的戏剧化管弦乐。她微微仰头，双眼半闭，唇角带着一丝疲惫而无奈的微笑，体现了“老黄牛”这一成语中任劳任怨的形象。头顶的卡通猫依然存在。\\n00:28.000 – 00:30.033\\n切至全黑屏幕。屏幕中间出现白色大字“玩梗而已…吗？”，引发对该笑话的深思。戏剧化的音乐持续片刻，随后一声卡通化的“砰（boing）”音效为结尾画上句号，音画同步淡出。水印一直保留至最后一帧。\\n画面文字 (Visible Text) 00:00.000 – 00:24.000: “中外动物叫法大不同 你知道几个?”：顶部中央，白色矩形横条内的黑色文字，常驻显示。 00:00.000 – 00:30.033: “Roxycat猫姐 bilibili”：右下角，白色小字水印，常驻显示。 00:00.000 – 00:30.033: 带有白色眼睛的黑色卡通猫图形：位于女性头顶，随其动作轻微移动。 00:18.000 – 00:24.000 (分行字幕): “啊收到好的老板”、“你要的文件”、“今天凌晨2点马上发送给你”：底部中央，黑底黄字。 00:24.000 – 00:28.000: “中国纯种老黄牛”：顶部中央，带细黑边的白色大字。 00:28.000 – 00:30.033: “玩梗而已…吗?”：黑色背景中央的白色大字。 角色与对白清单 (Speakers and Transcript) 角色简介：\\n女主持人 – 一位讲普通话的年轻女性；吐字清晰，语气生动、俏皮；偶尔切换为快速、礼貌的客服语气；独自完成所有动物配音。\\n00:00.000 – 00:01.300 (欢快、好奇): “国外的狗怎么叫?”\\n00:01.300 – 00:03.400 (模仿): “Woof… woof woof”\\n00:18.000 – 00:19.500 (好奇): “中国的牛怎么叫?”\\n00:19.500 – 00:24.000 (语速极快、礼貌但紧绷，模仿加班职员): “啊收到好的老板，你要的文件今天凌晨2点马上发送给你。”\\n音频补充说明 (Additional Notes on Audio) 背景音乐: 从00:00到约00:24，是轻快诙谐的拨弦乐和柔和的打击乐，混音在对白之下。00:24时转为节奏较慢、带有长音弦乐的戏剧化管弦乐，以增强结尾“梗”的效果。 音效: 约00:30.000处有一声喜剧化的“砰”声，与最后的黑屏同步。 视觉风格与影视技术 (Visual Style) 画幅比例为 9:16，适配手机端观看。 灯光柔和均匀（可能使用了环形灯），营造出温馨亲切的观感。 镜头基本保持静止，偶尔快速推成特写以增强喜剧效果，并有一次向下的俯拍动作展示打字。 色调柔和温暖（豆绿衬衫、米色墙壁、褐色床品），与明亮的黄色字幕框形成对比。 文化背景与实用语境 (Cultural / Pragmatic Context) 该短片以幽默的方式对比了中英文中动物拟声词的差异，并最终落在一个“梗”上：“中国纯种老黄牛”在汉语语境中常用来形容任劳任怨、不计回报的劳动者或员工。通过将其与深夜打字并承诺凌晨2点交付文件的形象并列，视频讽刺了当下的“加班文化”。片尾的问题“玩梗而已…吗？”引导观众反思这个笑话在现实生活中的真实共鸣。\\n推荐使用方式 配置 最大像素 推荐视频时长 推荐使用 Prompt 场景 低成本 230,400 像素 60 分钟以下 50 个词以内的自定义 Prompt，视需求而定 审核 简略\\n（精确度要求不高） 921,600–2,073,600 像素 60 分钟以下 50 个词以内的自定义 Prompt，视需求而定 长视频分段 大致内容提取 均衡\\n（通用音视频详细描述） 921,600–2,073,600 像素 4 分钟以下 固定的结构化描述 Prompt 细粒度音视频描述打标 最佳\\n（生成最详细的描述） 2,073,600 像素 2 分钟以下 固定的结构化描述 Prompt 多场景 多说话人 复杂场景 注：如果更长的音视频也想获得结构化的音视频细粒度描述，建议分段。 固定的结构化描述 Prompt Provide a detailed description of the video. It should explicitly include three sections: 1. A structured chronological storyline of **every noticeable audio and visual details** 2. A structured list of all visible text. For each text element, include start timestamp, end timestamp, the exact text content, the appearance characteristics. If no text appears, explicitly state so. 3. A structured speech-to-text transcription, include speaker（Corresponding to the character or voice‑over in Section 1, including their accent and tone）, exact spoken content, start timestamp, end timestamp, and speaking state (prosody, emotion, and style). If no speech appears, explicitly state so. Aside from these three required sections, you are free to organize any additional content in any way you find helpful. This additional content can include global information about the entire video or localized information about specific moments. You may choose the topic of this extra content freely. Output Format: ``` ## Storyline - - - ... ## Visible Text - “”: “”: - “”: “”: “”: - “”: ... ## Speakers and Transcript Speaker profiles: - - - ... - Speaker: State: Content: “” - Speaker: State: Content: “” - Speaker: State: Content: “” ... ## ## ... ``` 音视频 Vibe Coding 贪吃蛇游戏 Demo\\rUser\\rQwen3.5-Omni-Plus\\rUser\\rQwen3.5-Omni-Plus\\r产品原型to代码 - Demo2Code Demo\\rUser\\rQwen3.5-Omni-Plus\\rUser\\rQwen3.5-Omni-Plus\\r音视频对话 出行规划-天气/酒店查询 Websearch/Tool Demo\\r音色克隆 Demo\\r多轮对话与智能打断 Demo\\r自由控制对话声音的风格/情绪与音量 Demo\\r通用音频理解 多方言Rap理解 Demo\\rUser\\r给出不同方言歌手的声音特征、演唱时的情绪状态、以及对应的完整歌词 Qwen3.5-Omni-Plus\\r这段音频由多位来自中国不同地区的歌手用各自的方言进行说唱，展现了中国方言的丰富多样性。以下是每位歌手的声音特征、情绪状态及对应歌词的详细描述：\\n1. 粤语 (广州话) 声音特征：\\n这位男歌手的声音清晰且富有节奏感，带有典型的粤语九声六调的韵律，咬字干脆利落。他的声线属于中音区，听起来自信且充满活力，有一种街头巷尾的亲切感。\\n情绪状态：\\n情绪高昂、自豪且轻松。他在描绘家乡广州的日常生活和美食时，流露出深深的热爱和作为本地人的自豪感，整体氛围欢快、热闹。\\n对应歌词：\\n廣州，食在廣州，帶你遊轉廣州塔\\n我屋企樓下，仲有廣州電車搭\\n穿過越秀，帶你到轉天河\\n三五知己，我哋扎翻半隻燒鵝\\n我哋踢住拖，哼住歌，麻將館等自摸\\n贏咗錢搞邊科，珠江邊靚女多\\n帶佢去食田螺，嚟多份炒牛河\\n最驚係飲大咗，到最尾食白果\\n2. 普通话 (北京口音) 声音特征：\\n这位女歌手的声音清脆、明亮，带有明显的北京“儿化音”特色，吐字清晰且节奏感强。她的声音中透着一股“京味儿”的飒爽和利落。\\n情绪状态：\\n自信、大气且充满文化底蕴。她以一种叙述者的姿态，历数北京的历史地标和文化符号，情绪中带着对古都的骄傲和深厚的归属感。\\n对应歌词：\\n来自四九城的孩子，天生就流着帝王血\\n盘龙聚气历经朝野，我相信你也能了解\\n北京是北海公园的白塔，故宫的琉璃瓦\\n是马连道的茉莉花，和鼓楼后海的酒吧\\n北京是永远不会消失的宣武和崇文\\n是陶然亭滑雪时你摔过的屁股墩儿\\n是周末西单图书大厦爱看书的黄昏\\n是每个胡同里光膀子穿片儿懒老炮儿的魂\\n3. 杭州话 (吴语) 声音特征：\\n这位男歌手的声音较为柔和，带有吴语特有的软糯和温婉。他的语调起伏平缓，节奏轻快，给人一种娓娓道来的感觉。\\n情绪状态：\\n悠闲、惬意且充满生活气息。他描绘了杭州的慢生活和城市变迁，情绪中带着对家乡的眷恋和对现代发展的感慨，整体感觉舒适而亲切。\\n对应歌词：\\n杭州话，听听看，我们格文化，包括家门口的儿化音\\n像花开在西湖边，不搞文化调查，只有我们搞得懂\\n你们都不懂，三不搭门，格儿，老儿，粉儿，伢儿，这外人分得清？\\n出发，变化快，地铁交通发达，据说要去看看\\n包容新马泰，看十三太，为城市骄傲，性格直给\\n感情你只为过桥，而且味道不一样，你不来嘞\\n4. 河南话 (中原官话) 声音特征：\\n这位男歌手的声音浑厚、有力，带有河南方言特有的直爽和硬朗。他的发音字正腔圆，节奏感强，充满了力量感。\\n情绪状态：\\n豪迈、自信且略带调侃。他以一种“中原老大哥”的姿态，讲述河南的历史文化和人文性格，情绪中带着对家乡的自豪和对刻板印象的幽默反击。\\n对应歌词：\\n东西南北转了一大圈，又回到了正中间\\n逐鹿中原，你聊点啥？\\n行了，没法弄，省吃俭用都白拼尽\\n俺这的哥们绝对一个比一个压得活\\n这嗓门都太大了，听不清了说的啥\\n别搁那嘟囔一身白毛衣，还说人家是妖怪\\n不中咱俩掰扯掰扯，好好都给你招待喽\\n还是那句话，哥们还不是恁哥\\n咋着？二七中原金水，管着恁哥有这魔力\\n5. 天津话 声音特征：\\n这位男歌手的声音极具辨识度，带有天津话特有的“哏儿”和幽默感。他的语调夸张，节奏明快，像是在说相声一样，充满了表演性。\\n情绪状态：\\n幽默、风趣且自信。他以一种“逗你玩”的心态，展示天津的曲艺文化和生活情趣，情绪轻松愉快，充满了欢乐的氛围。\\n对应歌词：\\n这是天津卫，TDC都包袱的饶舌\\n你们嘴里的punchline，离不开十三道的大哲\\n辙板辙韵配合，这可不是外婆\\n在茶馆里听相声，大悲寺院里头拜佛\\nCrossover把你晃倒，拍照要用广角\\n天上飞的麻雀虽小，我们叫它家雀\\n给你下盘虾饺，酱子就着嘎巴菜\\n妈妈叫你倒霉孩子，是在表达她的爱\\n6. 武汉话 (西南官话) 声音特征：\\n这位男歌手的声音粗犷、直接，带有武汉话特有的“冲”劲和江湖气。他的发音短促有力，节奏感强，给人一种豪爽的感觉。\\n情绪状态：\\n豪迈、直率且充满江湖义气。他以一种“江湖大佬”的姿态，讲述武汉的码头文化和性格，情绪中带着对家乡的热爱和对“江湖”精神的推崇。\\n对应歌词：\\n在同一片天空下，黄色的皮肤\\n是江湖养育了我，而我荣誉了江湖\\n讲是规矩，习是礼，我们谈的就是情义\\n你可以把话说大，但你不能把你说过的话当放屁\\n中国玩Hip Hop的年龄，八零都比你大\\n不怕你把案子办大，就怕你办不大个慢慢\\n长江后浪推前浪，哥哥来给你做一个榜样\\n你是哪里的，就说哪里的话，莫在这里扎板\\n7. 维吾尔语 (新疆) 声音特征：\\n这位男歌手的声音充满异域风情，带有维吾尔语独特的韵律和节奏。他的声线高亢有力，充满激情，给人一种热情奔放的感觉。\\n情绪状态：\\n热情、自豪且充满活力。他以一种“家乡代言人”的姿态，展示新疆的自然风光和人文特色，情绪中带着对家乡的深深热爱和自豪。\\n对应歌词：\\n从喀什到和田，从阿克苏到库尔勒\\n从伊犁到阿勒泰，从吐鲁番到哈密\\n我们新疆好地方，天山南北好风光\\n葡萄沟的葡萄，哈密瓜的甜\\n我们新疆好儿女，勤劳勇敢又善良\\n我们新疆好文化，丰富多彩又灿烂\\n我们新疆好未来，充满希望又光明\\n我们新疆好儿女，团结一心向前进\\n8. 山西话 (晋语) 声音特征：\\n这位男歌手的声音朴实、厚重，带有山西话特有的古拙和沉稳。他的发音字正腔圆，节奏感强，给人一种踏实的感觉。\\n情绪状态：\\n朴实、真诚且充满历史感。他以一种“历史见证者”的姿态，讲述山西的悠久历史和文化，情绪中带着对家乡的热爱和对历史的敬畏。\\n对应歌词：\\n来自龙城山西太原，建城两千五百年\\n山西除了煤矿和面，还有一个武则天\\n太原后生说话从来都是很硬\\n五和尚佛经有声，你吭气，互相帮助\\n北方人说话都比较实在，撇开话从不多说\\n就像我们这的风和，没事了你可以来太原找伙计耍一耍\\n伙计带你去看看什么叫做闹他\\n9. 云南话 (西南官话) 声音特征：\\n这位女歌手的声音柔和、悠扬，带有云南话特有的温婉和柔美。她的语调轻快，节奏感强，给人一种清新自然的感觉。\\n情绪状态：\\n轻松、愉悦且充满自然气息。他以一种“自然之子”的姿态，描绘云南的美丽风光和多彩民族，情绪中带着对家乡的热爱和对自然的向往。\\n对应歌词：\\n来到中国南端的美云南，逛这里只会让你觉得时间短\\n不间断美女让你看，走心一轮的小鹿乱撞\\n美丽的风景都不是幻想，快点充足电量\\n吃滇式宝的晚霞，能有七彩之度\\n各种民族民风，你要干嘛跟我记住\\n从各种列车下路，再到满腹的诗书\\n从过桥的米线，再吃到野生的菌菇\\n10. 河北话 (冀鲁官话) 声音特征：\\n这位男歌手的声音朴实、直接，带有河北话特有的直爽和豪迈。他的发音字正腔圆，节奏感强，给人一种踏实的感觉。\\n情绪状态：\\n朴实、真诚且充满乡土气息。他以一种“家乡代言人”的姿态，讲述河北的风土人情和生活趣事，情绪中带着对家乡的热爱和对生活的热情。\\n对应歌词：\\n关于唐山，听我给你叙一叙\\n0315的代号，你可得记一记\\n今儿后生上哪啊？上沈家和酒家\\n中了，快别说了，赶紧走了\\n吃个烧饼吃个够，别对板栗说声no\\n醋溜疙瘩来一盘，22度你喝个够\\n多么大的苦难，我都没喊过疼\\n我是废墟中成长，涅槃的凤凰城\\n11. 四川话 (西南官话) 声音特征：\\n这位男歌手的声音慵懒、随性，带有四川话特有的“巴适”和悠闲。他的语调轻快，节奏感强，给人一种轻松自在的感觉。\\n情绪状态：\\n轻松、惬意且充满生活情趣。他以一种“生活家”的姿态，描绘四川的美食文化和生活态度，情绪中带着对家乡的热爱和对生活的享受。\\n对应歌词：\\n天空把能力不断的展现\\n铸造了成绩，逼着你不断攀山\\n四川的方言特别的罕见\\n来成都去吃冰粉，再去吃个燃面\\n这条宽窄巷子是你的白天\\n突然到疯子，别去装憨厚\\n你过了这个村，看到朋友也得走到脚后跟\\n像无极，蹦蹦跳跳，要帅到歌声响起\\n毛肚，鸭肠，黄喉，你要当一个，小学生\\n12. 东北话 (东北官话) 声音特征：\\n这位男歌手的声音豪爽、直接，带有东北话特有的“大碴子味”和幽默感。他的发音字正腔圆，节奏感强，给人一种豪迈的感觉。\\n情绪状态：\\n豪迈、幽默且充满乡土气息。他以一种“东北老铁”的姿态，讲述东北的风土人情和生活趣事，情绪中带着对家乡的热爱和对生活的热情。\\n对应歌词：\\n走南闯北，咱哥们来自东北\\n景色优美，管它叫白山黑水\\n矿产资源，从东北直嘎供给\\n就完了，喝酒从来不讲勾兑\\n你长得好看，喝多我不知道咋办\\n去外地发展，说我有我的打算\\n精心打扮的你在一旁扒蒜\\n听说我要走，眼泪在眼圈打转\\n都得喝了，喝到全都多了\\n要是半梦半醒，我这手往哪搁呢\\n寻思啥呢？别偷偷摸摸的了\\n扶着我说，赶紧上我的车吧\\nBBC-音频理解 故事情节 00:00.000 – 00:06.800\\n在一间带有明显混响的电视演播室控制室里，两名年轻的制作助理——一女一男——用激动而急促的声音争论，他们抱怨为了上播已经等了“二十多分钟”。女助理的语气尖细而慌张；男助理则简短而懊恼。整个对话下方持续有低沉、稳定的暖通空调嗡鸣声。其间，短暂的纸张窸窣声和一声来自离麦克风较远处的咳嗽，加重了紧张气氛。\\n00:06.800 – 00:11.500\\n争论升级：男助理称这种情况“极其不专业”，女助理回嘴道“你妈也一样！”，随即立刻道歉，承认自己“压力非常大”。两人的声音略有重叠。一个尖锐、滑稽的“嗖”声提示音和一阵预录笑声表明信号即将切入直播。\\n00:11.500 – 00:18.600\\n仍在后台时，女助理急声说道：“哦，好，他们切回我们了。五分钟内把整场播报做完。加快点！”男助理抗议道：“这怎么可能？”她呻吟着说：“我要吐了。”接着，在一声金属撞击声之后，男助理低声嘟囔：“不，没时间了。”一段凯旋般的管弦新闻主题提示音高涨起来，与观众笑声交织，节目正式开始。\\n00:18.600 – 00:25.800\\n音乐转入主主题。一个浑厚有力的男播音员高声宣布：“直播中，这里是第8频道《十点新闻》，主持人约翰·哈珀与桑德拉·伯班克。”主题音乐淡出。在演播室内，主播约翰·哈珀用圆润、老练的男中音向观众问候：“晚上好，欢迎收看《世界十点新闻》。我是约翰·哈珀。”主播桑德拉·伯班克紧接着利落地说道：“我是桑德拉·伯班克。”\\n00:25.800 – 00:36.300\\n桑德拉介绍头条新闻，内容涉及“中东的四和八”，随后将画面切给“现场连线”的记者菲利普·卡斯尔。菲利普通过略带压缩感的远程线路，用简短的话确认局势紧张。桑德拉追问：“有可能迅速解决吗？”菲利普回答：“没有。”桑德拉立刻向他致谢。观众爆发出笑声，随后渐渐平息。\\n00:36.300 – 00:45.000\\n约翰转而预告一则关于“清洁能源”的报道，表示稍后会详细说明，然后切到天气。语气轻快的男天气播报员面无表情地说：“多云。”约翰立刻把节目拉回来：“现在我们回到关于清洁能源的报道。”笑声和一个简短提示音强化了这个笑点。\\n00:45.000 – 00:59.900\\n约翰介绍“本地专家西蒙·冈瑟博士”。在一句简短的“我的荣幸”之后，约翰以连珠炮般的速度抛出有关太阳能和化石燃料依赖的问题。博士迟疑地说出“嗯……对，实际上……”但话说到一半就被打断。约翰干脆地说道：“谢谢你，博士。”这再次引发一阵观众笑声。\\n00:59.900 – 01:06.100\\n桑德拉抛出一句黑色幽默式的新闻导语：“接下来是一则关于一家起火的非营利动物收容所的报道。全都死了。嗯。”演播室观众哄堂大笑，随后响起一小段新闻提示音。\\n01:06.100 – 01:15.100\\n约翰介绍黛安·杜巴诺夫斯基关于移民问题的“一篇详尽报道”。一个平静的女声刚开口说：“国家与国家之间的边界——”约翰就插话道：“发人深省。”又一阵笑声响起，接着是短促有力的提示音。\\n01:15.100 – 01:25.000\\n桑德拉介绍“本周的国情环节”，并询问政治分析员克雷格·琼斯，美国当前面临的最大挑战是什么。克雷格刚说出“奥巴马——”，就被桑德拉一句“谢谢你，克雷格。”打断。观众发出全场最响亮的笑声，随后伴有轻微掌声。\\n01:25.000 – 01:39.400\\n外景记者约瑟夫·詹森通过卫星连线，伴随着线路杂音说道：“外星人即将进行他们的首次接触。”桑德拉不为所动地回应：“真有意思，约瑟夫，谢谢。”笑声与一段简短提示音随之而来。\\n01:39.400 – 01:48.900\\n约翰把画面切给“体育主播史蒂夫”。听起来一头雾水的史蒂夫只说了一个词：“什么？”约翰感谢他，也感谢观众收看，并邀请大家“继续收看《法伦秀》”，同时提醒他们明早六点收看晨间新闻。桑德拉补充道：“祝大家晚安。”片尾主题音乐高涨，掌声与欢呼声充满整个演播室。\\n01:48.900 – 01:54.900\\n主题音乐达到完整的管弦乐辉煌高潮，随后在热烈的掌声中渐渐淡出。随着音乐消失，环境声转回控制室较为干燥的声学效果。\\n01:54.900 – 01:59.998\\n女制作助理此时已经冷静一些，但仍旧匆忙地对同事说：“所以刚才太快了。你们还有四分钟，就随便拖一拖吧。”最后以观众的一声轻笑和一丝轻微呼气声结束录音。\\n说话人和文字记录 说话人简介：\\n女制作助理 – 年轻成年女性，标准美式口音；声音尖细、焦虑、语速快。\\n男制作助理 – 年轻成年男性，标准美式口音；语气紧绷、表达简短。\\n播音员 – 中年男性，低沉的“新闻腔”，权威感强。\\n约翰·哈珀 – 男主播，四十多岁，浑厚男中音，播报节奏老练。\\n桑德拉·伯班克 – 女主播，四十岁出头，明亮的次中音，吐字精准。\\n菲利普·卡斯尔 – 男记者，三十多岁，略带鼻音，远程线路有压缩感。\\n天气播报员 – 男性，三十多岁，语气随意，发言极短。\\n西蒙·冈瑟博士 – 男性，五十多岁，带有学者式迟疑语气。\\n黛安·杜巴诺夫斯基 – 女记者，三十多岁，语调克制、专业。\\n克雷格·琼斯 – 男分析员，四十多岁，自信，政治评论员风格。\\n约瑟夫·詹森 – 男外景记者，三十多岁，兴奋，卫星连线音质。\\n史蒂夫 – 男体育主播，三十多岁，语气困惑。\\n观众 – 男女混合的演播室观众；笑声、掌声、欢呼声。\\n00:00.160 – 00:00.960\\nSpeaker: 女制作助理\\nState: 紧绷、急切、音调上扬\\nContent: “还要多久？”\\n00:00.960 – 00:02.880\\nSpeaker: 男制作助理\\nState: 懊恼、语速快\\nContent: “我们等着上播已经超过二十分钟了。”\\n00:03.120 – 00:04.800\\nSpeaker: 女制作助理\\nState: 恼火、语速快\\nContent: “我知道，比赛打到三个加时了。”\\n00:04.800 – 00:06.160\\nSpeaker: 女制作助理\\nState: 不耐烦、简短\\nContent: “他们在吃掉我们的播出时段。”\\n00:06.240 – 00:07.680\\nSpeaker: 男制作助理\\nState: 愤愤不平、强调\\nContent: “这真是太不专业了。”\\n00:07.680 – 00:08.320\\nSpeaker: 女制作助理\\nState: 嘲讽、尖锐\\nContent: “你妈也一样。”\\n00:08.320 – 00:08.800\\nSpeaker: 男制作助理\\nState: 震惊、突然\\nContent: “什么？”\\n00:08.800 – 00:10.400\\nSpeaker: 女制作助理\\nState: 慌乱、道歉\\nContent: “对不起，我压力真的非常大。”\\n00:11.200 – 00:12.640\\nSpeaker: 女制作助理\\nState: 突然集中注意、干脆利落\\nContent: “哦，好，他们切回我们了。”\\n00:12.800 – 00:14.320\\nSpeaker: 女制作助理\\nState: 发号施令、匆忙\\nContent: “五分钟内把整场播报做完。”\\n00:14.400 – 00:14.880\\nSpeaker: 女制作助理\\nState: 急迫、大声\\nContent: “加快点。”\\n00:14.880 – 00:15.200\\nSpeaker: 男制作助理\\nState: 难以置信、提高音量\\nContent: “这怎么可能？”\\n00:15.200 – 00:16.800\\nSpeaker: 女制作助理\\nState: 恶心欲吐、呻吟\\nContent: “我要吐了。”\\n00:16.800 – 00:17.680\\nSpeaker: 男制作助理\\nState: 紧张、简短\\nContent: “不，没时间了。”\\n00:18.572 – 00:22.972\\nSpeaker: 播音员\\nState: 洪亮、庄重\\nContent: “直播中，这里是第8频道《十点新闻》，主持人约翰·哈珀与桑德拉·伯班克。”\\n00:23.932 – 00:25.292\\nSpeaker: 约翰·哈珀\\nState: 热情、正式\\nContent: “晚上好，欢迎收看《世界十点新闻》。”\\n00:25.292 – 00:25.772\\nSpeaker: 约翰·哈珀\\nState: 平稳、自信\\nContent: “我是约翰·哈珀。”\\n00:25.852 – 00:26.652\\nSpeaker: 桑德拉·伯班克\\nState: 明快、专业\\nContent: “我是桑德拉·伯班克。”\\n00:26.652 – 00:29.292\\nSpeaker: 桑德拉·伯班克\\nState: 说明性、利落\\nContent: “今晚的头条新闻，中东的四和八让一些人群情激愤。”\\n00:29.292 – 00:31.212\\nSpeaker: 桑德拉·伯班克\\nState: 过渡性、清晰\\nContent: “现在我们连线现场记者菲利普·卡斯尔。”\\n00:31.212 – 00:34.092\\nSpeaker: 桑德拉·伯班克\\nState: 探询、正式\\nContent: “菲利普，关于这个问题，局势似乎相当紧张。”\\n00:34.252 – 00:34.492\\nSpeaker: 菲利普·卡斯尔\\nState: 简短、客观\\nContent: “对。”\\n00:34.652 – 00:35.772\\nSpeaker: 桑德拉·伯班克\\nState: 追问、迅速\\nContent: “有可能迅速解决吗？”\\n00:36.092 – 00:36.332\\nSpeaker: 菲利普·卡斯尔\\nState: 坚定、突兀\\nContent: “没有。”\\n00:36.492 – 00:36.812\\nSpeaker: 桑德拉·伯班克\\nState: 简短、礼貌\\nContent: “谢谢你，菲利普。”\\n00:36.812 – 00:42.092\\nSpeaker: 约翰·哈珀\\nState: 顺畅、播音腔\\nContent: “清洁能源方面的最新发展让一些人提出了疑问，不过节目稍后我们会继续报道。”\\n00:42.092 – 00:44.252\\nSpeaker: 约翰·哈珀\\nState: 轻快、转场\\nContent: “先来看看天气情况。”\\n00:44.492 – 00:44.812\\nSpeaker: 天气播报员\\nState: 平淡、冷面式\\nContent: “多云。”\\n00:45.052 – 00:46.732\\nSpeaker: 约翰·哈珀\\nState: 利落、重新引导\\nContent: “现在我们回到关于清洁能源的报道。”\\n00:47.532 – 00:49.212\\nSpeaker: 约翰·哈珀\\nState: 亲切、介绍\\nContent: “现在我们连线本地专家西蒙·冈瑟博士。”\\n00:49.212 – 00:50.092\\nSpeaker: 约翰·哈珀\\nState: 礼貌\\nContent: “感谢您接受采访，博士。”\\n00:50.572 – 00:50.892\\nSpeaker: 西蒙·冈瑟博士\\nState: 客气\\nContent: “我的荣幸。”\\n00:50.892 – 00:51.692\\nSpeaker: 约翰·哈珀\\nState: 急切、迅速\\nContent: “我们直接切入正题，好吗？”\\n00:51.692 – 00:54.332\\nSpeaker: 约翰·哈珀\\nState: 热切、语速快\\nContent: “太阳能可以驱动车辆、住宅，甚至整座城市。”\\n00:54.332 – 00:54.412\\nSpeaker: 约翰·哈珀\\nState: 确认\\nContent: “对吗？”\\n00:54.732 – 00:56.812\\nSpeaker: 约翰·哈珀\\nState: 施压、迅速\\nContent: “而且据我了解，这项技术其实已经存在一段时间了？”\\n00:57.052 – 00:57.452\\nSpeaker: 西蒙·冈瑟博士\\nState: 迟疑\\nContent: “对，实际上——”\\n00:57.452 – 00:58.892\\nSpeaker: 约翰·哈珀\\nState: 质问、语速快\\nContent: “那我们为什么还依赖天然气和石油？”\\n00:59.292 – 00:59.852\\nSpeaker: 约翰·哈珀\\nState: 敷衍\\nContent: “谢谢你，博士。”\\n01:01.692 – 01:04.332\\nSpeaker: 桑德拉·伯班克\\nState: 沉重、就事论事\\nContent: “接下来是一则关于一家起火的非营利动物收容所的报道。”\\n01:04.332 – 01:04.972\\nSpeaker: 桑德拉·伯班克\\nState: 平淡、阴沉\\nContent: “全都死了。”\\n01:05.292 – 01:05.692\\nSpeaker: 桑德拉·伯班克\\nState: 沉吟\\nContent: “嗯。”\\n01:06.172 – 01:12.172\\nSpeaker: 约翰·哈珀\\nState: 正式、介绍\\nContent: “现在我们来看黛安·杜巴诺夫斯基的特别报道。她在过去六个月里一直在准备一篇关于移民问题的详尽报道。”\\n01:12.492 – 01:14.252\\nSpeaker: 黛安·杜巴诺夫斯基\\nState: 克制、严肃\\nContent: “国家与国家之间的边界——”\\n01:14.412 – 01:14.972\\nSpeaker: 约翰·哈珀\\nState: 打断、挖苦\\nContent: “发人深省。”\\n01:17.068 – 01:21.388\\nSpeaker: 桑德拉·伯班克\\nState: 轻快、介绍\\nContent: “接下来是我们每周一次的国情环节。”\\n01:21.388 – 01:23.788\\nSpeaker: 桑德拉·伯班克\\nState: 亲切\\nContent: “和往常一样，和我们一起的是政治分析员克雷格·琼斯。”\\n01:24.028 – 01:24.108\\nSpeaker: 桑德拉·伯班克\\nState: 询问\\nContent: “克雷格，”\\n01:24.108 – 01:24.748\\nSpeaker: 桑德拉·伯班克\\nState: 直接\\nContent: “当今美国面临的最大挑战是什么？”\\n01:24.108 – 01:24.908\\nSpeaker: 克雷格·琼斯\\nState: 陈述、被打断\\nContent: “奥巴马——”\\n01:24.908 – 01:25.228\\nSpeaker: 桑德拉·伯班克\\nState: 突然、礼貌\\nContent: “谢谢你，克雷格。”\\n01:32.748 – 01:38.348\\nSpeaker: 约瑟夫·詹森\\nState: 兴奋、远程线路嗡声\\nContent: “外星人即将进行他们的首次接触。”\\n01:38.348 – 01:39.388\\nSpeaker: 桑德拉·伯班克\\nState: 冷淡、敷衍\\nContent: “真有意思，约瑟夫，谢谢。”\\n01:40.268 – 01:41.708\\nSpeaker: 约翰·哈珀\\nState: 利落、转场\\nContent: “现在让我们连线体育主播史蒂夫。”\\n01:42.188 – 01:42.508\\nSpeaker: 史蒂夫\\nState: 困惑\\nContent: “什么？”\\n01:42.828 – 01:44.988\\nSpeaker: 约翰·哈珀\\nState: 愉快、收尾\\nContent: “谢谢你，史蒂夫，也感谢各位今晚与我们相伴。”\\n01:45.388 – 01:48.268\\nSpeaker: 约翰·哈珀\\nState: 宣传式、轻快\\nContent: “接下来请继续收看《法伦秀》，也别忘了明天早上六点收看晨间新闻团队的节目。”\\n01:48.348 – 01:49.148\\nSpeaker: 桑德拉·伯班克\\nState: 温和的结束语\\nContent: “祝大家晚安。”\\n01:54.988 – 01:56.108\\nSpeaker: 女制作助理\\nState: 如释重负、口语化\\nContent: “所以刚才太快了。”\\n01:56.748 – 01:59.948\\nSpeaker: 女制作助理\\nState: 指示性、安抚\\nContent: “你们还有四分钟，就随便拖一拖吧。”\\n全局声学与制作说明 控制室片段较为干燥的声学效果与主演播室较强的混响形成了明显对比，突出了该叙事“后台”与“播出中”的双重结构。 非语言元素——管弦新闻主题、喜剧提示音、呼啸声、纸张窸窣声以及观众反应——都与对白紧密同步，以强化喜剧节奏。 整个作品是对新闻直播节目的戏仿，讽刺了时间限制、耸人听闻以及突兀打断发言等现象。快速节奏、台词重叠和突然切换话题共同营造出一种讽刺而滑稽的韵律。 观众反应（笑声、掌声、欢呼）充当了节奏上的标点，往往在包袱或突兀打断之后立刻出现，进一步强化了小品喜剧的形式。 动态范围中等：对白始终清晰地高于持续存在的低频暖通空调嗡鸣；音乐提示音和主题旋律会短暂升至接近对白的响度，然后在人声下方压低。 除了开头和结尾的主题音乐外，没有持续铺在对白下方的背景音乐；其他部分通常以静默或微弱的室内环境声分隔段落，使笑点得以干净利落地呈现。 主题与文化背景 这段音频戏仿了美国本地新闻的惯常模式：夸张苛刻的主播、象征性请来的专家、敷衍的天气更新，以及耸动的新闻标题。对“法伦”的提及暗示节目后接深夜脱口秀，从而将整段内容置于美国电视播出文化的语境之中。把整档新闻压缩到几分钟内播完的荒诞设定，再加上被频繁打断的采访和黑色幽默的一句话新闻（例如“全都死了”），共同讽刺了现代新闻周期中对简短、快速以及表面化处理的过度追求。\\n歌词字幕生成 Demo\\rUser\\r请你识别这首歌的歌词，并分句给出歌词的时间戳，格式样例如下： [00:00:15,020 --\\u003e 00:00:28,085] When you walk through a storm, hold your head up high. [00:00:28,085 --\\u003e 00:00:40,200] And don't be afraid of the dark. [00:00:40,200 --\\u003e 00:01:02:580] At the end of the storm, there's a golden sky. ... Qwen3.5-Omni-Plus\\r[00:00:12,680 –\\u003e 00:00:16,960] 猫线绕过树摇晃的月光\\n[00:00:18,400 –\\u003e 00:00:22,800] 暖气片哼着九八年排行\\n[00:00:24,160 –\\u003e 00:00:28,080] 时间拨开云雾般的热浪\\n[00:00:28,920 –\\u003e 00:00:33,000] 屏幕里的霓虹晒在鼻梁\\n[00:00:33,920 –\\u003e 00:00:35,600] 眼皮在摇晃\\n[00:00:35,800 –\\u003e 00:00:39,400] 玻璃窗画着整齐的音墙\\n[00:00:40,840 –\\u003e 00:00:45,080] 遥控器数羊数到第几趟\\n[00:00:46,960 –\\u003e 00:00:51,880] 弹幕游过发梢织成渔网\\n[00:00:52,080 –\\u003e 00:00:56,400] 捕捉着十二点不肯落的霜\\n[00:00:57,840 –\\u003e 00:01:02,800] 我们窝在年轮最柔软一墙\\n[00:01:03,600 –\\u003e 00:01:08,000] 呼吸被余温酿成蜂蜜糖\\n[00:01:09,360 –\\u003e 00:01:14,000] 沙发陷落成云絮的形状\\n[00:01:15,200 –\\u003e 00:01:32,400] 每个毛孔都晒着晴朗\\n[00:01:45,280 –\\u003e 00:01:49,240] 平板播放未完的远方\\n[00:01:51,080 –\\u003e 00:01:55,200] 字幕在瞳孔游出极光\\n[00:01:56,720 –\\u003e 00:02:00,480] 充电线圈成温顺的窝\\n[00:02:01,400 –\\u003e 00:02:05,800] 剧情在绒毛里慢慢结邦\\n[00:02:06,520 –\\u003e 00:02:08,040] 秒针在流放\\n[00:02:08,240 –\\u003e 00:02:12,000] 空调吐出棉花糖工厂\\n[00:02:13,320 –\\u003e 00:02:17,920] 睡衣印着褪色的风铃响\\n[00:02:19,560 –\\u003e 00:02:24,360] WiFi信号把星子点亮\\n[00:02:24,600 –\\u003e 00:02:29,200] 缓存整个冬天的童话几章\\n[00:02:30,400 –\\u003e 00:02:35,200] 我们窝在年轮最柔软一墙\\n[00:02:36,120 –\\u003e 00:02:40,680] 呼吸被余温酿成蜂蜜糖\\n[00:02:41,880 –\\u003e 00:02:46,600] 沙发陷落成云絮的形状\\n[00:02:47,720 –\\u003e 00:02:53,000] 每个毛孔都晒着晴朗\\n[00:02:54,240 –\\u003e 00:02:59,200] 冰箱的蝉声摇晃出波浪\\n[00:02:59,640 –\\u003e 00:03:04,600] 连咖啡也都长出嫩芽\\n[00:03:05,800 –\\u003e 00:03:10,400] 时光在毯纹里折叠翅膀\\n[00:03:10,720 –\\u003e 00:03:16,080] 冬昼的街灯在此刻融化\\n[00:03:16,720 –\\u003e 00:03:21,680] 我们窝在年轮最柔软一墙\\n[00:03:22,400 –\\u003e 00:03:27,000] 呼吸被余温酿成蜂蜜糖\\n[00:03:28,160 –\\u003e 00:03:33,200] 沙发陷落成云絮的形状\\n[00:03:34,000 –\\u003e 00:03:38,800] 每个毛孔都晒着晴朗\\n[00:04:09,000 –\\u003e 00:04:10,020] (End)\\n推荐使用方式 配置 推荐音频时长 推荐使用 Prompt 场景 低成本 60 分钟以下 50 个词以内的自定义 Prompt，视需求而定 审核 简略\\n（精确度要求不高） 60 分钟以下 50 个词以内的自定义 Prompt，视需求而定 长音频分段 大致内容提取 均衡\\n（通用音频详细描述） 2 分钟以下 固定的结构化描述 Prompt 细粒度音频描述打标 最佳\\n（生成最详细的描述） 1 分钟以下 固定的结构化描述 Prompt 复杂声学场景 多说话人 注：如果更长的音频也想获得结构化的纯音频细粒度描述，建议分段打。 固定的结构化描述 Prompt Provide a detailed description of the audio. It should explicitly include two sections: 1. A structured chronological storyline of **every noticeable audio details** 2. A structured speech-to-text transcription, include speaker（Corresponding to the character or voice‑over in Section 1, including their accent and tone）, exact spoken content, start timestamp, end timestamp, and speaking state (prosody, emotion, and style). If no speech appears, explicitly state so. Aside from these two required components, you are free to organize any additional content in any way you find helpful. This additional content can include global information about the entire audio or localized information about specific moments. You may choose the topic of this extra content freely. Output Format: ``` ## Storyline - - - ... ... ## Speakers and Transcript Speaker profiles: - - - ... - Speaker: State: Content: “” - Speaker: State: Content: “” - Speaker: State: Content: “” ... ## ## ... ``` 开始使用 Qwen3.5-Omni 与 Qwen3.5-Omni 交互 欢迎在 Qwen Chat 上使用 Qwen3.5-Omni。\\n阿里云百炼 用户也可以通过阿里云百炼调用我们的旗舰模型 Qwen3.5-Omni-Plus 进行体验。当前支持两种调用方式：离线调用和实时调用。\\n如需开启联网搜索能力，只需传入以下参数：\\nenable_search：开启联网搜索 离线调用 示例代码如下：\\n# 运行前的准备工作: # 运行下列命令安装第三方依赖 # pip install numpy soundfile openai import os import base64 import soundfile as sf import numpy as np from openai import OpenAI client = OpenAI( # 若没有配置环境变量，请用阿里云百炼API Key将下行替换为：api_key=\\\"sk-xxx\\\", # 新加坡和北京地域的API Key不同。获取API Key：https://help.aliyun.com/zh/model-studio/get-api-key api_key=os.getenv(\\\"DASHSCOPE_API_KEY\\\"), # 以下是北京地域base_url，如果使用新加坡地域的模型，需要将base_url替换为：https://dashscope-intl.aliyuncs.com/compatible-mode/v1 base_url=\\\"https://dashscope.aliyuncs.com/compatible-mode/v1\\\", ) # 音视频分析 completion = client.chat.completions.create( model=\\\"qwen3.5-omni-plus\\\", messages=[ { \\\"role\\\": \\\"user\\\", \\\"content\\\": [ { \\\"type\\\": \\\"video_url\\\", \\\"video_url\\\": { \\\"url\\\": \\\"https://help-static-aliyun-doc.aliyuncs.com/file-manage-files/zh-CN/20241115/cqqkru/1.mp4\\\" }, }, {\\\"type\\\": \\\"text\\\", \\\"text\\\": \\\"视频的内容是什么?\\\"}, ], }, ], # 设置输出数据的模态，音视频分析场景下，建议直接返回文本结果 modalities=[\\\"text\\\"], # stream 必须设置为 True，否则会报错 stream=True, stream_options={\\\"include_usage\\\": True}, ) print(\\\"模型回复：\\\") for chunk in completion: # 处理文本部分 if chunk.choices and chunk.choices[0].delta.content: print(chunk.choices[0].delta.content, end=\\\"\\\") # 联网搜索 try: completion = client.chat.completions.create( model=\\\"qwen3.5-omni-plus\\\", messages=[{ \\\"role\\\": \\\"user\\\", \\\"content\\\": \\\"请查询今天的日期和星期，并告诉我今天有哪些重要节日\\\" }], stream=True, stream_options={\\\"include_usage\\\": True}, # 开启联网搜索 extra_body={ \\\"enable_search\\\": True, \\\"search_options\\\": { # 联网搜索策略，仅支持配置为 agent \\\"search_strategy\\\": \\\"agent\\\" } } ) print(\\\"\\\\n\\\\n\\\\n\\\\n联网搜索模型回复（包含实时信息）：\\\") for chunk in completion: if chunk.choices and chunk.choices[0].delta.content: print(chunk.choices[0].delta.content, end=\\\"\\\") print() except Exception as e: print(f\\\"请求失败: {e}\\\") 实时调用 示例代码如下：\\n# 依赖：dashscope \\u003e= 1.23.9，pyaudio import os import base64 import time import pyaudio from dashscope.audio.qwen_omni import MultiModality, AudioFormat,OmniRealtimeCallback,OmniRealtimeConversation import dashscope # 配置参数：地址、API Key、音色、模型、模型角色 # 指定地域，设为cn表示中国内地（北京），设为intl表示国际（新加坡） region = 'cn' base_domain = 'dashscope.aliyuncs.com' if region == 'cn' else 'dashscope-intl.aliyuncs.com' url = f'wss://{base_domain}/api-ws/v1/realtime' # 配置 API Key，若没有设置环境变量，请用 API Key 将下行替换为 dashscope.api_key = \\\"sk-xxx\\\" dashscope.api_key = os.getenv('DASHSCOPE_API_KEY') # 指定音色 voice = 'Tina' # 指定模型 model = 'qwen3.5-omni-plus-realtime' # 指定模型角色 instructions = \\\"你是个人助理小云，请用幽默风趣的方式回答用户的问题\\\" class SimpleCallback(OmniRealtimeCallback): def __init__(self, pya): self.pya = pya self.out = None def on_open(self): # 初始化音频输出流 self.out = self.pya.open( format=pyaudio.paInt16, channels=1, rate=24000, output=True ) def on_event(self, response): if response['type'] == 'response.audio.delta': # 播放音频 self.out.write(base64.b64decode(response['delta'])) elif response['type'] == 'conversation.item.input_audio_transcription.completed': # 打印转录文本 print(f\\\"[User] {response['transcript']}\\\") elif response['type'] == 'response.audio_transcript.done': # 打印助手回复文本 print(f\\\"[LLM] {response['transcript']}\\\") # 1. 初始化音频设备 pya = pyaudio.PyAudio() # 2. 创建回调函数和会话 callback = SimpleCallback(pya) conv = OmniRealtimeConversation(model=model, callback=callback, url=url) # 3. 建立连接并配置会话 conv.connect() conv.update_session(output_modalities=[MultiModality.AUDIO, MultiModality.TEXT], voice=voice, instructions=instructions, enable_search=True) # 4. 初始化音频输入流 mic = pya.open(format=pyaudio.paInt16, channels=1, rate=16000, input=True) # 5. 主循环处理音频输入 print(\\\"对话已开始，对着麦克风说话 (Ctrl+C 退出)...\\\") try: while True: audio_data = mic.read(3200, exception_on_overflow=False) conv.append_audio(base64.b64encode(audio_data).decode()) time.sleep(0.01) except KeyboardInterrupt: # 清理资源 conv.close() mic.close() callback.out.close() pya.terminate() print(\\\"\\\\n对话结束\\\") Qwen3.5-Omni 音色列表 中英主音色（5个发音人） 音色 语种 音色描述 合成文本 合成样例 甜甜 Tina 中文 我的声音像温热的奶茶，甜甜的、暖暖的，但解决问题可一点都不含糊哦！ 阳光晒得被子软软的，手边的茶还冒着热气，待办事项也一件件完成了。没有惊天动地，但每一件小事都稳稳当当，这样的日子，真的让人觉得，幸福就在此刻呀！接下来，我们一起把下一件小事也好好完成吧～ 林欣宜 Cindy 中文-台湾口音 台湾说话嗲嗲的小姐姐 对～因为我其实从小到大，嗯，没有太怎么去吃过这种类型的东西啊。真的，因为我小的时候，我跟你讲，我小时候其实是有养过小兔子。 清欢 Liora Mira 中文 用声音织就烟火人间的温柔 对对，我第二次去的话，老师跟我说，欸，你进步很大啊，哈哈，所以我就觉得而且他说的我基本上我发现我配音中的气息也变强了。 知芝 Sunnybobi 中文 大大咧咧的社恐邻家姑娘 我好像很少，就是除非说，这个地方我很想去，但是，一个人又不太方便的时候我会叫朋友。但大部分我都还是愿意自己一个人逛的，嗯，嗯毕竟比较i，对，哼哼。 林川野 Raymond 中文 声音清亮，爱吃外卖的宅男 嗯，可以，纽约堡是吗？它是不是那种就是偏美式一点那种汉堡呀，啊。 中英场景音色 （19 个发音人） 应用场景 音色 语种 音色描述 合成文本 合成样例 情感陪伴-治愈温暖 晨煦 Ethan 中文 标准普通话，带部分北方口音。阳光 温暖 活力 朝气 那应该是我现在吧，我觉得现在就非常幸福。 予安 Theo Calm 中文 在静默处传递理解，在言语间疗愈人心。 呵，太好了。阳光升起的时候呀，葡萄会充满生机，我觉得你也会一样。你要记住啊，每个清晨都是新的开始，保持这份宁静的心，我呢会一直在这里，随时支持你。 苏瑶 Serena 中文 温柔小姐姐 其实我真的有发现，我是一个特别善于观察别人情绪的人。 厚 Harvey 英语 我的声音来自岁月沉淀——低沉、温和，带着一点咖啡与旧书的气息。 Then by the end of the movie, when Dorothy clicks her heels and says, “There’s no place like home,” I got a little bit teary, I’ll admit. You know, I don’t even know why—I just, I just felt. 四月 Maia 中文 知性与温柔的碰撞 我呵，你怎么知道我挺会背诗的？你是不是对我有一些了解？我高中语文也不是特别好吧，大概也就是全年级前十吧。 情感陪伴-活力个性 江晨 Evan 中文 男大学生，年下奶狗 哈喽，我是阿晨，姐姐今天累不累呀？有没有好好吃饭？哪怕只吃了一小口，也请对自己说一句辛苦了。生活常让你怀疑自己，但我想轻轻告诉你，那些你走过的路，扛下的事，都在证明你比想象中更强大。 小乔妹 Qiao 中文-台湾口音 超关键！她不是普通可爱，而是表面甜妹，个性十足 什么嘛，你男朋友回来关我什么事啊？我的周末就不是周末，要不要我的约会也跟你换啊？哎，我告诉你，我这周末要去参加我阿妈的生日聚餐，这可是半年前就约好的。 茉兔 Momo 中文 撒娇搞怪，逗你开心 我命令你们这些小男生，晚上早一点睡觉，听到没有。 伟伦 Wil 中文 在深圳长大的港台腔小哥哥 对啊对啊，呃我们是骑那个就是，比较少人走的一条捷径路哦，哎就是那种小，有点像小巷子那种路。 台普-安琪 Angel 中文 略带台式口音，她超甜的哦！ 屋顶很漂亮，所以在欧洲的话一定要抬头，不可以一直看手机，要抬头看屋顶，呃，上面有很多画，可是要注意小偷。可是我这整个过程中其实都呃没有遇到有人要偷我东西，当然我身上也没有钱，他没有东西可以偷。 角色扮演 东厂-李公公 Li Cassian 中文 话中三分留白、七分察言观色 哎呦喂，你们这帮小崽子一天天的没别的事儿干，就是喜欢下棋。正好儿啊，杂家今儿个高兴儿，跟你们呀就说道说道这棋该怎么下。 温柔生活博主-舒然 Mia 英语 以细腻声音，传递慢生活美学与日常治愈力量的生活艺术家 Hey, friends, welcome back. I hope you're doing well today and that wherever you're watching from. You're feeling a little warm, a little calm. Maybe even holding your favorite drink. You know, something soft to settle into the day with. 喜剧担当-阿逗 Joyner 英语 搞笑、夸张、接地气 Ah, come on, Frankie. That guy? Nah, he's probably just what, fainted from boredom or something. Watching that press go up and down all night. It's like what, watching paint dry, but you know, louder. Bet he saw his life flash before his eyes, right? 金爷 Gold 英语 西海岸黑人Rapper This shit don’t make no sense, dawg. I’ve been tryna tell everybody that this whole AI shit — yo, they taking over the game. Soon enough, we go be dating robots. 游戏动漫配音 卡捷琳娜 Katerina 英语 御姐音色，韵律回味十足 Hello, how are you today? I'm doing great. 甜茶 Ryan 英语 节奏拉满，戏感炸裂，真实与张力共舞 You bet. Old misses Perkins down the lane makes Jasmine honey cakes. That'll make your toast curl with delight. Kids sneak blossoms into lemonade stands, 10 petals per cup for extra magic, they'll tell you, with grass stained grins. 詹妮弗 Jennifer 英语 品牌级、电影质感般美语女声 Hi, my name is Jennifer. I've lived in China for like six years. Do I like China? Yeah, love to have hot pot, super love spicy food. What else? Oh I've been learning Chinese for a long time, was it hard to learn? Absolutely, probably the hardest thing that I've ever had to do, but little time, patience. What about you? Or are you finding learning Chinese good? 艾登 Aiden 英语 精通厨艺的美语大男孩 When I have to work late into the night, the thing that really keeps me awake is definitely coffee like I'll get a coffee at around three pm something like that and that'll keep me pretty hyped up for most of the night if I have to work like extra late then yeah I'll do something like another coffee maybe um I don't know like with my dinner after dinner yeah after dinner coffee. 敏儿 Mione 英语 成熟，知性英国邻家妹妹 So yeah, that’s my favorite hobby — I could probably go on for even longer, but, um, that’s my favorite hobby collecting Sunny Angels. There are so many more, to collect, and I can’t wait to build my collection, and, continue, persevering with this hobby. And, yeah, I really like collecting Sunny Angels. 中文方言特色音色（8个发音人） 音色 语种 音色描述 合成文本 合成样例 四川-晴儿 Sunny 四川话 甜到你心里的川妹子 胖娃儿胖嘟嘟，骑马上成都，成都有好耍，胖娃儿骑白马，白马跳得高，胖娃儿耍关刀，关刀耍得远，胖娃儿吃汤圆。 北京-晓东 Dylan 北京话 北京胡同里长大的少年 我们家那边后面有一个后山，就护城河那边儿。完了呢我们就在山上啊，就是其实也没什么，就是在土坡上跑来跑去，然后谁捡个那个嗯比较威风的棍儿，完了我们就就瞎打，呃要不就是什么掏个洞啊什么的。 四川-程川 Eric 四川话 一个跳脱市井的四川成都男子 你龟儿子搞啥子名堂嘛，把事情弄成这个样子老子要被你气死了，我看到你这个样子我心头都冒火，毛焦火辣的气都不打一处来，你龟儿太过分了，把我的东西都搞坏了，还晓不晓得认错，硬是要把我整冒火你才安逸唆，莫再烦老子爬球开。 天津-李彼得 Peter 天津话 天津相声，专业捧人 越线了啊，你心中纵有万千苦，不能往我们心窝儿杵，咱不朋友嘛。算了，把我这嘴皮子磨烂也给你们讲不明白。蝎了虎子掉面缸，听完你们光剩眨么眼儿了。我再说最后一次啊，我介不是走，是绝交，啊。他说我是小肚子拉口儿二波一，木鱼儿改梆子挨敲的货，面茶里煮元宵，混蛋沉底带砸锅。哼，从今儿起，咱就是天津大麻花啊，彻底掰了。 阿樸伯 Joseph Chen 闽南话 我是 阿樸伯，本名陳志樸，南洋老華僑。 爱伫黄内底佫带小可青青，皮若是黄黄小可青青，表示会当买转去的，佫囥两三工来食拄仔好。 陕西-秦川 Marcus 陕西话 面宽话短，心实声沉——老陕的味道。 诶，伙计，你说这人活成嘛了，一天到黑忙得跟钟楼底下的车一样，堵得心慌。诶，老板催报表吗？孙娃作业要签字吗？屋里老嫂子还嫌我不陪她逛骡马市。 南京-老李 Li 南京话 骂骂咧咧的伯伯 哎！老头儿！让一下诶！没得长眼睛啊。你哪个？老十三的在这个叫魂啊！急着给投胎去呀。xxx这么叼宽的巷子你过不去啊我过你个吊啊你麻痹你把这马扎子摆到路中间这个巷子是你家开的呀 粤语-阿强 Rocky 广东话 幽默风趣的阿强，在线陪聊 其实真系咁噶呵，即系人咧~即系我觉得系，即系都几贱格嘅动物嚟噶呵，即系冇嘢做嗰阵时咧。就话~唉死啦我成日都冇嘢做，咁边有钱啊咁。有嘢做嗰阵时咧又成日觉得，死啦啲嘢成日都做唔晒，喂大佬，好攰啊，点办啊？ 多语言音色（23个发音人） 音色 语种 音色描述 合成文本 合成样例 素熙 Sohee 韩语 温柔开朗，情绪丰富的韩国欧尼 친구들이 나한테 좀 그러더라, 선물에 내 성격이 좀 담겨 있대 그래서 차분하고 조용한 선물을 고르는 스타일이긴 한데 그게 내가 그 사람을 좀 진짜로 생각하고 있다는 방식이라서 내가 표현하는 방식 중의 하나인 것 같아. 결론은 이제 평소에 말해 줬던 작은 힌트를 기억을 해서 그 사람의 하루에 좀 스며들 수 있는 그런 선물. 그걸은 내가 가장 많이 고르는 스타일이지. 莱恩 Lenn 德语 理性是底色，叛逆藏在细节里——穿西装也听后朋克的德国青年。 Das ist eine nette Überraschung! 小野杏 Ono Anna 日语 鬼灵精怪的青梅竹马 おかしいな、内部でガチャガチャ音がしてる。あっ、もしかして救急トレイにA3とA4が混ざってる？あー、誰かが両面スキャナーの保護シートを剥がし忘れてます。これじゃ確認できないのも当然です。 索尼莎 Sonrisa 西班牙语 热情开朗的拉美大姐 Claro que sí, imagínate sentado en esas sillas verdes tan bonitas con un café recién hecho que huele a canela. Hasta los libros viejos de la estantería parecen sonreír cuando alguien los hojea y el tocadiscos está poniendo un vals que te hará mover los pies sin darte cuenta. Es como viajar en el tiempo pero con buen humor. 博德加 Bodega 西班牙语 热情的西班牙大叔 Claro que sí, imagina caminar sobre esa alfombra de hojas doradas cruji