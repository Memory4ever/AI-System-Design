{"data":{"id":"10.48550/arxiv.2606.22283","type":"dois","attributes":{"doi":"10.48550/arxiv.2606.22283","prefix":"10.48550","suffix":"arxiv.2606.22283","identifiers":[{"identifier":"2606.22283","identifierType":"arXiv"}],"alternateIdentifiers":[{"alternateIdentifierType":"arXiv","alternateIdentifier":"2606.22283"}],"creators":[{"name":"Bryngelson, Spencer H.","nameType":"Personal","givenName":"Spencer H.","familyName":"Bryngelson","affiliation":[],"nameIdentifiers":[]}],"titles":[{"title":"Apple Neural Engine: Architecture, Programming, and Performance"}],"publisher":"arXiv","container":{},"publicationYear":2026,"subjects":[{"lang":"en","subject":"Hardware Architecture (cs.AR)","subjectScheme":"arXiv"},{"lang":"en","subject":"Operating Systems (cs.OS)","subjectScheme":"arXiv"},{"lang":"en","subject":"Performance (cs.PF)","subjectScheme":"arXiv"},{"subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"},{"lang":"en","subject":"C.1.3; C.4","subjectScheme":"ACM"}],"contributors":[],"dates":[{"date":"2026-06-21T00:17:34Z","dateType":"Submitted","dateInformation":"v1"},{"date":"2026-06-23T01:39:21Z","dateType":"Updated","dateInformation":"v1"},{"date":"2026-10-15T03:17:23Z","dateType":"Submitted","dateInformation":"v2"},{"date":"2026-10-16T00:33:53Z","dateType":"Updated","dateInformation":"v2"},{"date":"2026-06","dateType":"Available","dateInformation":"v1"}],"language":null,"types":{"ris":"GEN","bibtex":"misc","citeproc":"article","schemaOrg":"CreativeWork","resourceType":"Article","resourceTypeGeneral":"Preprint"},"relatedIdentifiers":[],"relatedItems":[],"sizes":[],"formats":[],"version":"2","rightsList":[{"rights":"Creative Commons Attribution 4.0 International","rightsUri":"https://creativecommons.org/licenses/by/4.0/legalcode","schemeUri":"https://spdx.org/licenses/","rightsIdentifier":"cc-by-4.0","rightsIdentifierScheme":"SPDX"}],"descriptions":[{"description":"The Apple Neural Engine (ANE) is Apple's fixed-function matrix accelerator. It has shipped in every Apple system-on-chip since the A11 in iPhones and iPads and the M1 in Macs. Applications reach it only through Core ML, which documents almost nothing below its own surface. This work reverse-engineers the engine. We reach it directly, below Core ML, from an ordinary user process, and that access opens the rest to measurement. We measure on Apple silicon and decompile the private runtime, compiler, kernel driver, and firmware, checking each against the other. We give the datapath and the roofline that bounds throughput and energy. Below that are the compiler and the program format it emits, the weight-compression scheme, the kernel driver, the firmware, and the command protocol. We decode compiler targets for the A11 through A18 and M1 through M5 families, with per-chip tables and an operation-by-device matrix. We measured silicon on the M1 and M5 only, and we mark every claim measured, decompile-derived, or predicted. We record how we reached the engine and what we could not measure. The route is callable from user space, but Apple does not document or support it, and it breaks across operating-system updates. It serves measurement and on-device research. Core ML remains the path for shipped software.","descriptionType":"Abstract"},{"description":"303 pages, 12 figures, 218 tables","descriptionType":"Other"}],"geoLocations":[],"fundingReferences":[],"xml":"","url":"https://arxiv.org/abs/2606.22283","contentUrl":null,"metadataVersion":1,"schemaVersion":"http://datacite.org/schema/kernel-4","source":"mds","isActive":true,"state":"findable","reason":null,"viewCount":0,"viewsOverTime":[],"downloadCount":0,"downloadsOverTime":[],"referenceCount":0,"citationCount":0,"citationsOverTime":[],"partCount":0,"partOfCount":0,"versionCount":0,"versionOfCount":0,"created":"2026-06-23T04:52:04.000Z","registered":"2026-06-23T04:52:05.000Z","published":"2026","updated":"2026-10-16T03:21:05.000Z"},"relationships":{"client":{"data":{"id":"arxiv.content","type":"clients"}},"provider":{"data":{"id":"arxiv","type":"providers"}},"media":{"data":{"id":"10.48550/arxiv.2606.22283","type":"media"}},"references":{"data":[]},"citations":{"data":[]},"parts":{"data":[]},"partOf":{"data":[]},"versions":{"data":[]},"versionOf":{"data":[]}}}}