{"data":{"id":"10.48550/arxiv.2606.05014","type":"dois","attributes":{"doi":"10.48550/arxiv.2606.05014","prefix":"10.48550","suffix":"arxiv.2606.05014","identifiers":[{"identifier":"2606.05014","identifierType":"arXiv"}],"alternateIdentifiers":[{"alternateIdentifierType":"arXiv","alternateIdentifier":"2606.05014"}],"creators":[{"name":"Zeng, Boyi","nameType":"Personal","givenName":"Boyi","familyName":"Zeng","affiliation":[],"nameIdentifiers":[]},{"name":"Hao, Yiqin","nameType":"Personal","givenName":"Yiqin","familyName":"Hao","affiliation":[],"nameIdentifiers":[]},{"name":"Wang, Zitong","nameType":"Personal","givenName":"Zitong","familyName":"Wang","affiliation":[],"nameIdentifiers":[]},{"name":"Song, Shixiang","nameType":"Personal","givenName":"Shixiang","familyName":"Song","affiliation":[],"nameIdentifiers":[]},{"name":"Li, He","nameType":"Personal","givenName":"He","familyName":"Li","affiliation":[],"nameIdentifiers":[]},{"name":"Song, Feichen","nameType":"Personal","givenName":"Feichen","familyName":"Song","affiliation":[],"nameIdentifiers":[]},{"name":"Liu, Yifan","nameType":"Personal","givenName":"Yifan","familyName":"Liu","affiliation":[],"nameIdentifiers":[]},{"name":"He, Ziwei","nameType":"Personal","givenName":"Ziwei","familyName":"He","affiliation":[],"nameIdentifiers":[]},{"name":"Wang, Xinbing","nameType":"Personal","givenName":"Xinbing","familyName":"Wang","affiliation":[],"nameIdentifiers":[]},{"name":"Lin, Zhouhan","nameType":"Personal","givenName":"Zhouhan","familyName":"Lin","affiliation":[],"nameIdentifiers":[]}],"titles":[{"title":"Depth-Attention: Cross-Layer Value Mixing for Language Models"}],"publisher":"arXiv","container":{},"publicationYear":2026,"subjects":[{"lang":"en","subject":"Computation and Language (cs.CL)","subjectScheme":"arXiv"},{"subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"},{"subject":"FOS: Computer and information sciences","schemeUri":"http://www.oecd.org/science/inno/38235147.pdf","subjectScheme":"Fields of Science and Technology (FOS)"}],"contributors":[],"dates":[{"date":"2026-06-03T15:33:45Z","dateType":"Submitted","dateInformation":"v1"},{"date":"2026-06-04T01:02:06Z","dateType":"Updated","dateInformation":"v1"},{"date":"2026-06-13T04:31:25Z","dateType":"Submitted","dateInformation":"v2"},{"date":"2026-06-16T00:21:28Z","dateType":"Updated","dateInformation":"v2"},{"date":"2026-06","dateType":"Available","dateInformation":"v1"},{"date":"2026","dateType":"Issued"}],"language":null,"types":{"ris":"GEN","bibtex":"misc","citeproc":"article","schemaOrg":"CreativeWork","resourceType":"Article","resourceTypeGeneral":"Preprint"},"relatedIdentifiers":[],"relatedItems":[],"sizes":[],"formats":[],"version":"2","rightsList":[{"rights":"Creative Commons Attribution Non Commercial Share Alike 4.0 International","rightsUri":"https://creativecommons.org/licenses/by-nc-sa/4.0/legalcode","schemeUri":"https://spdx.org/licenses/","rightsIdentifier":"cc-by-nc-sa-4.0","rightsIdentifierScheme":"SPDX"}],"descriptions":[{"description":"Self-attention selects information freely across the sequence, but across depth, Transformers merely add each layer's output to the residual stream, so later layers cannot selectively reuse earlier-layer representations. Recent cross-layer methods improve this flow but operate on hidden states outside attention, adding state beyond the key-value cache at inference--a cost that becomes increasingly salient as modern LLMs compress the cache with grouped-query and multi-head latent attention. We introduce Depth-Attention, which performs this selection inside the attention module itself: before a layer attends over the sequence, its query attends over the keys of earlier layers at the same token position and mixes their values into the value that self-attention then reads. Because Depth-Attention reuses the standard attention queries, keys, and value-cache slots, storing depth-mixed values in place of the original values, it adds no parameters and introduces no persistent inference state beyond the standard key-value cache--the same cache size as a vanilla decoder and less than hidden-state-based cross-layer methods. On Qwen3-style decoders at 1.5B and 3B parameters, Depth-Attention attains the lowest perplexity and the highest average downstream accuracy, improving over the vanilla Transformer by up to 2.3 accuracy points and surpassing strong cross-layer baselines in perplexity and average accuracy, while adding under 0.01% extra arithmetic FLOPs and no additional persistent inference state. The gains hold from 360M to 3B parameters and extend to looped Transformers.","descriptionType":"Abstract"},{"description":"21 pages, 4 figures, 9 tables","descriptionType":"Other"}],"geoLocations":[],"fundingReferences":[],"xml":"","url":"https://arxiv.org/abs/2606.05014","contentUrl":null,"metadataVersion":1,"schemaVersion":"http://datacite.org/schema/kernel-4","source":"mds","isActive":true,"state":"findable","reason":null,"viewCount":0,"viewsOverTime":[],"downloadCount":0,"downloadsOverTime":[],"referenceCount":0,"citationCount":0,"citationsOverTime":[],"partCount":0,"partOfCount":0,"versionCount":0,"versionOfCount":0,"created":"2026-06-04T02:11:11.000Z","registered":"2026-06-04T02:11:12.000Z","published":"2026","updated":"2026-06-16T04:19:06.000Z"},"relationships":{"client":{"data":{"id":"arxiv.content","type":"clients"}},"provider":{"data":{"id":"arxiv","type":"providers"}},"media":{"data":{"id":"10.48550/arxiv.2606.05014","type":"media"}},"references":{"data":[]},"citations":{"data":[]},"parts":{"data":[]},"partOf":{"data":[]},"versions":{"data":[]},"versionOf":{"data":[]}}}}