{"data":{"id":"10.48550/arxiv.2606.05158","type":"dois","attributes":{"doi":"10.48550/arxiv.2606.05158","prefix":"10.48550","suffix":"arxiv.2606.05158","identifiers":[{"identifier":"2606.05158","identifierType":"arXiv"}],"alternateIdentifiers":[{"alternateIdentifierType":"arXiv","alternateIdentifier":"2606.05158"}],"creators":[{"name":"Yang, Zhen","nameType":"Personal","givenName":"Zhen","familyName":"Yang","affiliation":[],"nameIdentifiers":[]},{"name":"Xu, Xiaogang","nameType":"Personal","givenName":"Xiaogang","familyName":"Xu","affiliation":[],"nameIdentifiers":[]},{"name":"Wang, Wen","nameType":"Personal","givenName":"Wen","familyName":"Wang","affiliation":[],"nameIdentifiers":[]},{"name":"Chen, Cong","nameType":"Personal","givenName":"Cong","familyName":"Chen","affiliation":[],"nameIdentifiers":[]},{"name":"Xu, Xander","nameType":"Personal","givenName":"Xander","familyName":"Xu","affiliation":[],"nameIdentifiers":[]},{"name":"Chen, Ying-Cong","nameType":"Personal","givenName":"Ying-Cong","familyName":"Chen","affiliation":[],"nameIdentifiers":[]}],"titles":[{"title":"Streaming Communication in Multi-Agent Reasoning"}],"publisher":"arXiv","container":{},"publicationYear":2026,"subjects":[{"lang":"en","subject":"Computation and Language (cs.CL)","subjectScheme":"arXiv"},{"lang":"en","subject":"Artificial Intelligence (cs.AI)","subjectScheme":"arXiv"},{"lang":"en","subject":"Multiagent Systems (cs.MA)","subjectScheme":"arXiv"},{"subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"}],"contributors":[],"dates":[{"date":"2026-06-03T17:57:04Z","dateType":"Submitted","dateInformation":"v1"},{"date":"2026-06-04T01:09:46Z","dateType":"Updated","dateInformation":"v1"},{"date":"2026-08-01T06:36:12Z","dateType":"Submitted","dateInformation":"v2"},{"date":"2026-08-04T00:23:33Z","dateType":"Updated","dateInformation":"v2"},{"date":"2026-06","dateType":"Available","dateInformation":"v1"}],"language":null,"types":{"ris":"GEN","bibtex":"misc","citeproc":"article","schemaOrg":"CreativeWork","resourceType":"Article","resourceTypeGeneral":"Preprint"},"relatedIdentifiers":[],"relatedItems":[],"sizes":[],"formats":[],"version":"2","rightsList":[{"rights":"arXiv.org perpetual, non-exclusive license","rightsUri":"http://arxiv.org/licenses/nonexclusive-distrib/1.0/"}],"descriptions":[{"description":"Multi-agent reasoning systems adopt a \"generate-then-transfer\" paradigm that forces end-to-end latency to scale linearly with pipeline depth. We introduce StreamMA, a multi-agent reasoning system that streams each reasoning step to downstream agents as soon as it is generated, pipelining adjacent agents and thus reducing latency. Surprisingly, this pipelining also improves effectiveness: because multi-step reasoning quality is non-uniform and early steps are more reliable than later ones, working with these reliable early steps instead of the full chain prevents error-prone late steps from misleading downstream agents. We formalize both advantages with the first closed-form joint analysis of stream, serial, and single protocols, deriving the effectiveness ordering, speedup upper bound, and cost ratio. Across eight reasoning benchmarks spanning mathematics, science, and code, two frontier LLMs (Claude Opus 4.6 and GPT-5.4), and three topologies (Chain, Tree, Graph), StreamMA outperforms both baselines (avg. +7.3 pp, max +22.4 pp on HMMT 2026; Claude Opus 4.6-high). Beyond these contributions, we discover a \"step-level scaling law\": increasing per-agent steps consistently improves both effectiveness and efficiency, a new scaling dimension orthogonal to and composable with agent-count scaling.","descriptionType":"Abstract"},{"description":"project page: https://zhenyangcs.github.io/StreamMA-website/","descriptionType":"Other"}],"geoLocations":[],"fundingReferences":[],"xml":"","url":"https://arxiv.org/abs/2606.05158","contentUrl":null,"metadataVersion":1,"schemaVersion":"http://datacite.org/schema/kernel-4","source":"mds","isActive":true,"state":"findable","reason":null,"viewCount":0,"viewsOverTime":[],"downloadCount":0,"downloadsOverTime":[],"referenceCount":0,"citationCount":0,"citationsOverTime":[],"partCount":0,"partOfCount":0,"versionCount":0,"versionOfCount":0,"created":"2026-06-04T02:14:16.000Z","registered":"2026-06-04T02:14:17.000Z","published":"2026","updated":"2026-08-04T04:46:03.000Z"},"relationships":{"client":{"data":{"id":"arxiv.content","type":"clients"}},"provider":{"data":{"id":"arxiv","type":"providers"}},"media":{"data":{"id":"10.48550/arxiv.2606.05158","type":"media"}},"references":{"data":[]},"citations":{"data":[]},"parts":{"data":[]},"partOf":{"data":[]},"versions":{"data":[]},"versionOf":{"data":[]}}}}