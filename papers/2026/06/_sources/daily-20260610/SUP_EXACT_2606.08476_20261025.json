{"data":{"id":"10.48550/arxiv.2606.08476","type":"dois","attributes":{"doi":"10.48550/arxiv.2606.08476","prefix":"10.48550","suffix":"arxiv.2606.08476","identifiers":[{"identifier":"2606.08476","identifierType":"arXiv"}],"alternateIdentifiers":[{"alternateIdentifierType":"arXiv","alternateIdentifier":"2606.08476"}],"creators":[{"name":"Wang, Zheng","nameType":"Personal","givenName":"Zheng","familyName":"Wang","affiliation":[],"nameIdentifiers":[]},{"name":"Liu, Eric","nameType":"Personal","givenName":"Eric","familyName":"Liu","affiliation":[],"nameIdentifiers":[]},{"name":"Jiang, Linan","nameType":"Personal","givenName":"Linan","familyName":"Jiang","affiliation":[],"nameIdentifiers":[]},{"name":"Yu, Zhongkai","nameType":"Personal","givenName":"Zhongkai","familyName":"Yu","affiliation":[],"nameIdentifiers":[]},{"name":"Pan, Zaifeng","nameType":"Personal","givenName":"Zaifeng","familyName":"Pan","affiliation":[],"nameIdentifiers":[]},{"name":"Guan, Yue","nameType":"Personal","givenName":"Yue","familyName":"Guan","affiliation":[],"nameIdentifiers":[]},{"name":"Wang, Yuke","nameType":"Personal","givenName":"Yuke","familyName":"Wang","affiliation":[],"nameIdentifiers":[]},{"name":"Ding, Yufei","nameType":"Personal","givenName":"Yufei","familyName":"Ding","affiliation":[],"nameIdentifiers":[]}],"titles":[{"title":"FlashCP: Load-Balanced Communication-Efficient Context Parallelism for LLM Training"}],"publisher":"arXiv","container":{},"publicationYear":2026,"subjects":[{"lang":"en","subject":"Distributed, Parallel, and Cluster Computing (cs.DC)","subjectScheme":"arXiv"},{"lang":"en","subject":"Artificial Intelligence (cs.AI)","subjectScheme":"arXiv"},{"subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"},{"subject":"FOS: Computer and information sciences","schemeUri":"http://www.oecd.org/science/inno/38235147.pdf","subjectScheme":"Fields of Science and Technology (FOS)"},{"lang":"en","subject":"I.2.11","subjectScheme":"ACM"}],"contributors":[],"dates":[{"date":"2026-06-07T06:45:15Z","dateType":"Submitted","dateInformation":"v1"},{"date":"2026-06-09T00:52:43Z","dateType":"Updated","dateInformation":"v1"},{"date":"2026-06","dateType":"Available","dateInformation":"v1"},{"date":"2026","dateType":"Issued"}],"language":null,"types":{"ris":"GEN","bibtex":"misc","citeproc":"article","schemaOrg":"CreativeWork","resourceType":"Article","resourceTypeGeneral":"Preprint"},"relatedIdentifiers":[],"relatedItems":[],"sizes":[],"formats":[],"version":"1","rightsList":[{"rights":"arXiv.org perpetual, non-exclusive license","rightsUri":"http://arxiv.org/licenses/nonexclusive-distrib/1.0/"}],"descriptions":[{"description":"Context parallelism (CP) is essential for training large-scale, long-context language models, as it partitions sequences to reduce memory overhead. However, existing CP methods suffer from workload imbalance, inefficient kernels, and redundant communication due to static sequence sharding and key-value (KV) tensor communication. We present FlashCP, a load-balanced and communication-efficient framework for CP training. FlashCP introduces a sharding-aware communication mechanism to eliminate redundant KV communication and proposes a novel Whole-Doc sharding strategy that maximizes communication savings while maintaining balanced workloads. To efficiently combine Whole-Doc and Per-Doc sharding, FlashCP further designs a heuristic algorithm to search for near-optimal sharding plans. Extensive experiments show that FlashCP achieves up to 1.63x speedup over state-of-the-art CP frameworks across diverse datasets.","descriptionType":"Abstract"},{"description":"10 pages, 6 figures","descriptionType":"Other"}],"geoLocations":[],"fundingReferences":[],"xml":"","url":"https://arxiv.org/abs/2606.08476","contentUrl":null,"metadataVersion":0,"schemaVersion":"http://datacite.org/schema/kernel-4","source":"mds","isActive":true,"state":"findable","reason":null,"viewCount":0,"viewsOverTime":[],"dow