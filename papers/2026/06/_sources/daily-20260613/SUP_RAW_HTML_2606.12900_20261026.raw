<td id="S5.T5.5.1.6.3" class="ltx_td ltx_align_center ltx_border_bb ltx_border_t"><math id="S5.T5.m24" class="ltx_Math" alttext="0.4675" display="inline" intent=":literal"><semantics><mn>0.4675</mn><annotation encoding="application/x-tex">0.4675</annotation></semantics></math></td>
