</span>
</div>
<div id="alg2.l4" class="ltx_listingline">
                  
                  
                <span id="alg2.l4.2" class="ltx_text" style="font-size:90%;">  Parse score </span><math id="alg2.l4.m1" class="ltx_Math" alttext="s_{p}^{(k)}\leftarrow s_{p}(x,Y_{k})\in\{1,\ldots,10\}" display="inline" intent=":literal"><semantics><mrow><msubsup><mi mathsize="0.900em">s</mi><mi mathsize="0.900em">p</mi><mrow><mo maxsize="0.900em" minsize="0.900em">(</mo><mi mathsize="0.900em">k</mi><mo maxsize="0.900em" minsize="0.900em">)</mo></mrow></msubsup><mo mathsize="0.900em" stretchy="false">←</mo><mrow><msub><mi mathsize="0.900em">s</mi><mi mathsize="0.900em">p</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo maxsize="0.900em" minsize="0.900em">(</mo><mi mathsize="0.900em">x</mi><mo mathsize="0.900em">,</mo><msub><mi mathsize="0.900em">Y</mi><mi mathsize="0.900em">k</mi></msub><mo maxsize="0.900em" minsize="0.900em">)</mo></mrow></mrow><mo mathsize="0.900em">∈</mo><mrow><mo stretchy="false">{</mo><mn mathsize="0.900em">1</mn><mo mathsize="0.900em">,</mo><mi mathsize="0.900em" mathvariant="normal">…</mi><mo mathsize="0.900em">,</mo><mn mathsize="0.900em">10</mn><mo stretchy="false">}</mo></mrow></mrow><annotation encoding="application/x-tex">s_{p}^{(k)}\leftarrow s_{p}(x,Y_{k})\in\{1,\ldots,10\}</annotation></semantics></math><span id="alg2.l4.3" class="ltx_text" style="font-size:90%;">;
</span>
</div>
