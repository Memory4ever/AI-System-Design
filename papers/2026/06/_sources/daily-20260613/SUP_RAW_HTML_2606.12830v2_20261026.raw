<td id="S5.T2.2.1.21.3" class="ltx_td ltx_align_center ltx_border_bb" style="padding:-0.3pt 2.0pt;"><span id="S5.T2.2.1.21.3.1" class="ltx_text" style="font-size:80%;--ltx-bg-color:#F5F5F5;">13.7</span></td>
