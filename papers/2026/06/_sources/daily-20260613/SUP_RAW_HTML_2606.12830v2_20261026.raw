<td id="A2.T4.2.1.2" class="ltx_td ltx_align_center ltx_border_tt"><span id="A2.T4.2.1.2.1" class="ltx_text ltx_font_bold" style="font-size:80%;">SFT Training</span></td></tr>
<tr id="A2.T4.2.2" class="ltx_tr">
