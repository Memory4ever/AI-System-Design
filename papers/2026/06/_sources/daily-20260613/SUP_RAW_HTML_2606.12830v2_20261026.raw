<td id="A5.T11.2.2.3" class="ltx_td ltx_align_center ltx_border_t" style="padding-left:5.0pt;padding-right:5.0pt;"><span id="A5.T11.2.2.3.1" class="ltx_text" style="font-size:90%;">–</span></td></tr>
<tr id="A5.T11.2.3" class="ltx_tr">
<td id="A5.T11.2.3.1" class="ltx_td ltx_align_left" style="padding-left:5.0pt;padding-right:5.0pt;"><span id="A5.T11.2.3.1.1" class="ltx_text" style="font-size:90%;">OR-GIGPO (<math id="A5.T11.m1" class="ltx_Math" alttext="N=4" display="inline" intent=":literal"><semantics><mrow><mi>N</mi><mo>=</mo><mn>4</mn></mrow><annotation encoding="application/x-tex">N=4</annotation></semantics></math>)</span></td>
<td id="A5.T11.2.3.2" class="ltx_td ltx_align_center" style="padding-left:5.0pt;padding-right:5.0pt;"><span id="A5.T11.2.3.2.1" class="ltx_text" style="font-size:90%;">36.9</span></td>
