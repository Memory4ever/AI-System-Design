<td id="A6.T13.2.2.4" class="ltx_td ltx_align_center ltx_border_t" style="padding-left:3.0pt;padding-right:3.0pt;"><span id="A6.T13.2.2.4.1" class="ltx_text" style="font-size:90%;">74.1</span></td>
<td id="A6.T13.2.2.5" class="ltx_td ltx_align_center ltx_border_t" style="padding-left:3.0pt;padding-right:3.0pt;"><span id="A6.T13.2.2.5.1" class="ltx_text" style="font-size:90%;">50.7</span></td></tr>
<tr id="A6.T13.2.3" class="ltx_tr">
<td id="A6.T13.2.3.1" class="ltx_td ltx_align_left" style="padding-left:3.0pt;padding-right:3.0pt;"><span id="A6.T13.2.3.1.1" class="ltx_text ltx_font_smallcaps" style="font-size:90%;">PERIA<span id="A6.T13.2.3.1.1.1" class="ltx_text ltx_font_upright">-8B, all tools</span></span></td>
