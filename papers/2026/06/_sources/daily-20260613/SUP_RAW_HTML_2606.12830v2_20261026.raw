<td id="A6.T13.2.1.2" class="ltx_td ltx_align_center ltx_border_tt" style="padding-left:3.0pt;padding-right:3.0pt;"><span id="A6.T13.2.1.2.1" class="ltx_text ltx_font_bold" style="font-size:90%;">ReasonMap-Plus</span></td>
<td id="A6.T13.2.1.3" class="ltx_td ltx_align_center ltx_border_tt" style="padding-left:3.0pt;padding-right:3.0pt;"><span id="A6.T13.2.1.3.1" class="ltx_text ltx_font_bold" style="font-size:90%;">ReasonMap</span></td>
