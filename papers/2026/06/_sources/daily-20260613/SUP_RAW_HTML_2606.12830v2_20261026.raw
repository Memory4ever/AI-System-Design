<td id="A2.T4.2.2.2" class="ltx_td ltx_align_center ltx_border_t"><span id="A2.T4.2.2.2.1" class="ltx_text" style="font-size:80%;">1.0</span></td></tr>
<tr id="A2.T4.2.3" class="ltx_tr">
<td id="A2.T4.2.3.1" class="ltx_td ltx_align_left"><span id="A2.T4.2.3.1.1" class="ltx_text" style="font-size:80%;">global batch size</span></td>
<td id="A2.T4.2.3.2" class="ltx_td ltx_align_center"><span id="A2.T4.2.3.2.1" class="ltx_text" style="font-size:80%;">32</span></td></tr>
<tr id="A2.T4.2.4" class="ltx_tr">
<td id="A2.T4.2.4.1" class="ltx_td ltx_align_left"><span id="A2.T4.2.4.1.1" class="ltx_text" style="font-size:80%;">learning rate</span></td>
<td id="A2.T4.2.4.2" class="ltx_td ltx_align_center"><math id="A2.T4.m1" class="ltx_Math" alttext="1.0\times 10^{-5}" display="inline" intent=":literal"><semantics><mrow><mn mathsize="0.800em">1.0</mn><mo lspace="0.222em" mathsize="0.800em" rspace="0.222em">×</mo><msup><mn mathsize="0.800em">10</mn><mrow><mo mathsize="0.800em">−</mo><mn mathsize="0.800em">5</mn></mrow></msup></mrow><annotation encoding="application/x-tex">1.0\times 10^{-5}</annotation></semantics></math></td></tr>
<tr id="A2.T4.2.5" class="ltx_tr">
<td id="A2.T4.2.5.1" class="ltx_td ltx_align_left"><span id="A2.T4.2.5.1.1" class="ltx_text" style="font-size:80%;">scheduler</span></td>
<td id="A2.T4.2.5.2" class="ltx_td ltx_align_center"><span id="A2.T4.2.5.2.1" class="ltx_text" style="font-size:80%;">cosine</span></td></tr>
<tr id="A2.T4.2.6" class="ltx_tr">
<td id="A2.T4.2.6.1" class="ltx_td ltx_align_left"><span id="A2.T4.2.6.1.1" class="ltx_text" style="font-size:80%;">warmup ratio</span></td>
<td id="A2.T4.2.6.2" class="ltx_td ltx_align_center"><span id="A2.T4.2.6.2.1" class="ltx_text" style="font-size:80%;">0.1</span></td></tr>
<tr id="A2.T4.2.7" class="ltx_tr">
