<tr id="A2.T5.2.18" class="ltx_tr">
<td id="A2.T5.2.18.1" class="ltx_td ltx_align_left"><span id="A2.T5.2.18.1.1" class="ltx_text" style="font-size:80%;">top_k</span></td>
<td id="A2.T5.2.18.2" class="ltx_td ltx_align_center"><span id="A2.T5.2.18.2.1" class="ltx_text" style="font-size:80%;">-1</span></td></tr>
<tr id="A2.T5.2.19" class="ltx_tr">
<td id="A2.T5.2.19.1" class="ltx_td ltx_align_left"><span id="A2.T5.2.19.1.1" class="ltx_text" style="font-size:80%;">rollout backend</span></td>
<td id="A2.T5.2.19.2" class="ltx_td ltx_align_center"><span id="A2.T5.2.19.2.1" class="ltx_text" style="font-size:80%;">vLLM</span></td></tr>
<tr id="A2.T5.2.20" class="ltx_tr">
<td id="A2.T5.2.20.1" class="ltx_td ltx_align_left"><span id="A2.T5.2.20.1.1" class="ltx_text" style="font-size:80%;">standard clipping coefficient, <math id="A2.T5.m4" class="ltx_Math" alttext="\epsilon_{\rm clip}" display="inline" intent=":literal"><semantics><msub><mi>ϵ</mi><mi>clip</mi></msub><annotation encoding="application/x-tex">\epsilon_{\rm clip}</annotation></semantics></math></span></td>
<td id="A2.T5.2.20.2" class="ltx_td ltx_align_center"><span id="A2.T5.2.20.2.1" class="ltx_text" style="font-size:80%;">0.2</span></td></tr>
<tr id="A2.T5.2.21" class="ltx_tr">
<td id="A2.T5.2.21.1" class="ltx_td ltx_align_center ltx_border_t" colspan="2"><span id="A2.T5.2.21.1.1" class="ltx_text ltx_font_italic" style="font-size:80%;">OR-GIGPO-specific parameters</span></td></tr>
<tr id="A2.T5.2.22" class="ltx_tr">
<td id="A2.T5.2.22.1" class="ltx_td ltx_align_left ltx_border_t"><span id="A2.T5.2.22.1.1" class="ltx_text" style="font-size:80%;">episode-step advantage weight, <math id="A2.T5.m5" class="ltx_Math" alttext="\omega" display="inline" intent=":literal"><semantics><mi>ω</mi><annotation encoding="application/x-tex">\omega</annotation></semantics></math></span></td>
<td id="A2.T5.2.22.2" class="ltx_td ltx_align_center ltx_border_t"><span id="A2.T5.2.22.2.1" class="ltx_text" style="font-size:80%;">1.0</span></td></tr>
<tr id="A2.T5.2.23" class="ltx_tr">
<td id="A2.T5.2.23.1" class="ltx_td ltx_align_left"><span id="A2.T5.2.23.1.1" class="ltx_text" style="font-size:80%;">discount factor, <math id="A2.T5.m6" class="ltx_Math" alttext="\gamma" display="inline" intent=":literal"><semantics><mi>γ</mi><annotation encoding="application/x-tex">\gamma</annotation></semantics></math></span></td>
<td id="A2.T5.2.23.2" class="ltx_td ltx_align_center"><span id="A2.T5.2.23.2.1" class="ltx_text" style="font-size:80%;">0.99</span></td></tr>
<tr id="A2.T5.2.24" class="ltx_tr">
<td id="A2.T5.2.24.1" class="ltx_td ltx_align_left"><span id="A2.T5.2.24.1.1" class="ltx_text" style="font-size:80%;">advantage normalization constant, <math id="A2.T5.m7" class="ltx_Math" alttext="\epsilon_{\rm adv}" display="inline" intent=":literal"><semantics><msub><mi>ϵ</mi><mi>adv</mi></msub><annotation encoding="application/x-tex">\epsilon_{\rm adv}</annotation></semantics></math></span></td>
<td id="A2.T5.2.24.2" class="ltx_td ltx_align_center"><math id="A2.T5.m8" class="ltx_Math" alttext="1.0\times 10^{-6}" display="inline" intent=":literal"><semantics><mrow><mn mathsize="0.800em">1.0</mn><mo lspace="0.222em" mathsize="0.800em" rspace="0.222em">×</mo><msup><mn mathsize="0.800em">10</mn><mrow><mo mathsize="0.800em">−</mo><mn mathsize="0.800em">6</mn></mrow></msup></mrow><annotation encoding="application/x-tex">1.0\times 10^{-6}</annotation></semantics></math></td></tr>
<tr id="A2.T5.2.25" class="ltx_tr">
<td id="A2.T5.2.25.1" class="ltx_td ltx_align_left"><span id="A2.T5.2.25.1.1" class="ltx_text" style="font-size:80%;">observation similarity threshold, <math id="A2.T5.m9" class="ltx_Math" alttext="\delta" display="inline" intent=":literal"><semantics><mi>δ</mi><annotation encoding="application/x-tex">\delta</annotation></semantics></math></span></td>
<td id="A2.T5.2.25.2" class="ltx_td ltx_align_center"><span id="A2.T5.2.25.2.1" class="ltx_text" style="font-size:80%;">0.9</span></td></tr>
<tr id="A2.T5.2.26" class="ltx_tr">
<td id="A2.T5.2.26.1" class="ltx_td ltx_align_center ltx_border_t" colspan="2"><span id="A2.T5.2.26.1.1" class="ltx_text ltx_font_italic" style="font-size:80%;">DAPO-specific parameters</span></td></tr>
<tr id="A2.T5.2.27" class="ltx_tr">
<td id="A2.T5.2.27.1" class="ltx_td ltx_align_left ltx_border_t"><span id="A2.T5.2.27.1.1" class="ltx_text" style="font-size:80%;">lower clipping coefficient, <math id="A2.T5.m10" class="ltx_Math" alttext="\epsilon_{\rm low}" display="inline" intent=":literal"><semantics><msub><mi>ϵ</mi><mi>low</mi></msub><annotation encoding="application/x-tex">\epsilon_{\rm low}</annotation></semantics></math></span></td>
<td id="A2.T5.2.27.2" class="ltx_td ltx_align_center ltx_border_t"><span id="A2.T5.2.27.2.1" class="ltx_text" style="font-size:80%;">0.2</span></td></tr>
<tr id="A2.T5.2.28" class="ltx_tr">
<td id="A2.T5.2.28.1" class="ltx_td ltx_align_left"><span id="A2.T5.2.28.1.1" class="ltx_text" style="font-size:80%;">upper clipping coefficient, <math id="A2.T5.m11" class="ltx_Math" alttext="\epsilon_{\rm high}" display="inline" intent=":literal"><semantics><msub><mi>ϵ</mi><mi>high</mi></msub><annotation encoding="application/x-tex">\epsilon_{\rm high}</annotation></semantics></math></span></td>
<td id="A2.T5.2.28.2" class="ltx_td ltx_align_center"><span id="A2.T5.2.28.2.1" class="ltx_text" style="font-size:80%;">0.28</span></td></tr>
<tr id="A2.T5.2.29" class="ltx_tr">
<td id="A2.T5.2.29.1" class="ltx_td ltx_align_left ltx_border_bb"><span id="A2.T5.2.29.1.1" class="ltx_text" style="font-size:80%;">total training steps</span></td>
<td id="A2.T5.2.29.2" class="ltx_td ltx_align_center ltx_border_bb"><span id="A2.T5.2.29.2.1" class="ltx_text" style="font-size:80%;">300</span></td></tr>
</table>
<figcaption class="ltx_caption ltx_centering" style="font-size:80%;"><span class="ltx_tag ltx_tag_table">Table 5: </span>
<span id="A2.T5.7" class="ltx_text ltx_font_bold">RL Parameters.</span>
We report the rollout configuration, optimization settings, interaction limits, and algorithm-specific parameters for OR-GIGPO and DAPO.
</figcaption>
</figure>
</section>
<section id="A2.SS1.SSS0.Px3" class="ltx_paragraph">
<h4 class="ltx_title ltx_title_paragraph">Inference parameters.</h4>

<div id="A2.SS1.SSS0.Px3.p1" class="ltx_para">
<p id="A2.SS1.SSS0.Px3.p1.1" class="ltx_p">Table <a href="#A2.T6" title="Table 6 ‣ Inference parameters. ‣ B.1 Training and Inference ‣ Appendix B Implementation Details ‣ Perceive, Interact, Reason: Building Tool-Augmented Visual Agents for Spatial Reasoning" class="ltx_ref"><span class="ltx_text ltx_ref_tag">6</span></a> summarizes the inference configuration used to evaluate <span id="A2.SS1.SSS0.Px3.p1.1.1" class="ltx_text ltx_font_smallcaps">PERIA</span>.</p>
</div>
<figure id="A2.T6" class="ltx_table">
<table id="A2.T6.2" class="ltx_tabular ltx_centering ltx_align_middle">
<tr id="A2.T6.2.1" class="ltx_tr">
<td id="A2.T6.2.1.1" class="ltx_td ltx_align_left ltx_border_tt"><span id="A2.T6.2.1.1.1" class="ltx_text ltx_font_bold" style="font-size:80%;">Parameters</span></td>
<td id="A2.T6.2.1.2" class="ltx_td ltx_align_center ltx_border_tt"><span id="A2.T6.2.1.2.1" class="ltx_text ltx_font_bold" style="font-size:80%;">Inference</span></td></tr>
<tr id="A2.T6.2.2" class="ltx_tr">
<td id="A2.T6.2.2.1" class="ltx_td ltx_align_left ltx_border_t"><span id="A2.T6.2.2.1.1" class="ltx_text" style="font-size:80%;">max response length</span></td>
<td id="A2.T6.2.2.2" class="ltx_td ltx_align_center ltx_border_t"><span id="A2.T6.2.2.2.1" class="ltx_text" style="font-size:80%;">32,768</span></td></tr>
<tr id="A2.T6.2.3" class="ltx_tr">
<td id="A2.T6.2.3.1" class="ltx_td ltx_align_left"><span id="A2.T6.2.3.1.1" class="ltx_text" style="font-size:80%;">max turns</span></td>
<td id="A2.T6.2.3.2" class="ltx_td ltx_align_center"><span id="A2.T6.2.3.2.1" class="ltx_text" style="font-size:80%;">11</span></td></tr>
<tr id="A2.T6.2.4" class="ltx_tr">
<td id="A2.T6.2.4.1" class="ltx_td ltx_align_left"><span id="A2.T6.2.4.1.1" class="ltx_text" style="font-size:80%;">temperature</span></td>
<td id="A2.T6.2.4.2" class="ltx_td ltx_align_center"><span id="A2.T6.2.4.2.1" class="ltx_text" style="font-size:80%;">0.0</span></td></tr>
<tr id="A2.T6.2.5" class="ltx_tr">
<td id="A2.T6.2.5.1" class="ltx_td ltx_align_left ltx_border_bb"><span id="A2.T6.2.5.1.1" class="ltx_text" style="font-size:80%;">inference backend</span></td>
<td id="A2.T6.2.5.2" class="ltx_td ltx_align_center ltx_border_bb"><span id="A2.T6.2.5.2.1" class="ltx_text" style="font-size:80%;">vLLM</span></td></tr>
</table>
<figcaption class="ltx_caption ltx_centering" style="font-size:80%;"><span class="ltx_tag ltx_tag_table">Table 6: </span>
