<td id="S5.T2.2.1.21.5" class="ltx_td ltx_align_center ltx_border_bb" style="padding:-0.3pt 2.0pt;"><span id="S5.T2.2.1.21.5.1" class="ltx_text" style="font-size:80%;--ltx-bg-color:#F5F5F5;">21.2</span></td>
