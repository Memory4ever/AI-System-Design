<td id="S5.T1.2.7.3" class="ltx_td ltx_align_center ltx_border_bb ltx_border_r" style="padding-left:3.0pt;padding-right:3.0pt;"><math id="S5.T1.m19" class="ltx_Math" alttext="80.0{\scriptstyle\pm 3.5}" display="inline" intent=":literal"><semantics><mrow><mn>80.0</mn><mo mathsize="0.700em">±</mo><mn mathsize="0.700em">3.5</mn></mrow><annotation encoding="application/x-tex">80.0{\scriptstyle\pm 3.5}</annotation></semantics></math></td>
