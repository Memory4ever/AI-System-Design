<td id="S5.T1.2.4.3" class="ltx_td ltx_align_center ltx_border_r" style="padding-left:3.0pt;padding-right:3.0pt;"><math id="S5.T1.m6" class="ltx_Math" alttext="95.6{\scriptstyle\pm 1.7}" display="inline" intent=":literal"><semantics><mrow><mn>95.6</mn><mo mathsize="0.700em">±</mo><mn mathsize="0.700em">1.7</mn></mrow><annotation encoding="application/x-tex">95.6{\scriptstyle\pm 1.7}</annotation></semantics></math></td>
<td id="S5.T1.2.4.4" class="ltx_td ltx_align_center" style="padding-left:3.0pt;padding-right:3.0pt;"><math id="S5.T1.m7" class="ltx_Math" alttext="26.4{\scriptstyle\pm 2.4}" display="inline" intent=":literal"><semantics><mrow><mn>26.4</mn><mo mathsize="0.700em">±</mo><mn mathsize="0.700em">2.4</mn></mrow><annotation encoding="application/x-tex">26.4{\scriptstyle\pm 2.4}</annotation></semantics></math></td>
<td id="S5.T1.2.4.5" class="ltx_td ltx_align_center" style="padding-left:3.0pt;padding-right:3.0pt;"><math id="S5.T1.m8" class="ltx_Math" alttext="21.4{\scriptstyle\pm 2.2}" display="inline" intent=":literal"><semantics><mrow><mn>21.4</mn><mo mathsize="0.700em">±</mo><mn mathsize="0.700em">2.2</mn></mrow><annotation encoding="application/x-tex">21.4{\scriptstyle\pm 2.2}</annotation></semantics></math></td></tr>
