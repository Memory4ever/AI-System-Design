<tr id="S5.T1.2.2" class="ltx_tr">
<td id="S5.T1.2.2.1" class="ltx_td ltx_align_left ltx_border_t" style="padding-left:3.0pt;padding-right:3.0pt;">B</td>
<td id="S5.T1.2.2.2" class="ltx_td ltx_align_center ltx_border_t" style="padding-left:3.0pt;padding-right:3.0pt;"><math id="S5.T1.m1" class="ltx_Math" alttext="2.4{\scriptstyle\pm 1.3}" display="inline" intent=":literal"><semantics><mrow><mn>2.4</mn><mo mathsize="0.700em">±</mo><mn mathsize="0.700em">1.3</mn></mrow><annotation encoding="application/x-tex">2.4{\scriptstyle\pm 1.3}</annotation></semantics></math></td>
<td id="S5.T1.2.2.3" class="ltx_td ltx_align_center ltx_border_r ltx_border_t" style="padding-left:3.0pt;padding-right:3.0pt;">–</td>
<td id="S5.T1.2.2.4" class="ltx_td ltx_align_center ltx_border_t" style="padding-left:3.0pt;padding-right:3.0pt;"><math id="S5.T1.m2" class="ltx_Math" alttext="1.4{\scriptstyle\pm 0.6}" display="inline" intent=":literal"><semantics><mrow><mn>1.4</mn><mo mathsize="0.700em">±</mo><mn mathsize="0.700em">0.6</mn></mrow><annotation encoding="application/x-tex">1.4{\scriptstyle\pm 0.6}</annotation></semantics></math></td>
<td id="S5.T1.2.2.5" class="ltx_td ltx_align_center ltx_border_t" style="padding-left:3.0pt;padding-right:3.0pt;">–</td></tr>
<tr id="S5.T1.2.3" class="ltx_tr">
<td id="S5.T1.2.3.1" class="ltx_td ltx_align_left" style="padding-left:3.0pt;padding-right:3.0pt;">CoT</td>
<td id="S5.T1.2.3.2" class="ltx_td ltx_align_center" style="padding-left:3.0pt;padding-right:3.0pt;"><math id="S5.T1.m3" class="ltx_Math" alttext="79.0{\scriptstyle\pm 3.6}" display="inline" intent=":literal"><semantics><mrow><mn>79.0</mn><mo mathsize="0.700em">±</mo><mn mathsize="0.700em">3.6</mn></mrow><annotation encoding="application/x-tex">79.0{\scriptstyle\pm 3.6}</annotation></semantics></math></td>
<td id="S5.T1.2.3.3" class="ltx_td ltx_align_center ltx_border_r" style="padding-left:3.0pt;padding-right:3.0pt;">–</td>
