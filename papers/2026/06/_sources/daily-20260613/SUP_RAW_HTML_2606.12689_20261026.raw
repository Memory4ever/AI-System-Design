<td id="S5.T1.2.5.5" class="ltx_td ltx_align_center" style="padding-left:3.0pt;padding-right:3.0pt;"><math id="S5.T1.m12" class="ltx_Math" alttext="7.7{\scriptstyle\pm 1.4}" display="inline" intent=":literal"><semantics><mrow><mn>7.7</mn><mo mathsize="0.700em">±</mo><mn mathsize="0.700em">1.4</mn></mrow><annotation encoding="application/x-tex">7.7{\scriptstyle\pm 1.4}</annotation></semantics></math></td></tr>
<tr id="S5.T1.2.6" class="ltx_tr">
<td id="S5.T1.2.6.1" class="ltx_td ltx_align_left" style="padding-left:3.0pt;padding-right:3.0pt;">C<sub id="S5.T1.2.6.1.1" class="ltx_sub"><span id="S5.T1.2.6.1.1.1" class="ltx_text ltx_font_italic">u</span></sub></td>
<td id="S5.T1.2.6.2" class="ltx_td ltx_align_center" style="padding-left:3.0pt;padding-right:3.0pt;"><math id="S5.T1.m14" class="ltx_Math" alttext="96.0{\scriptstyle\pm 1.7}" display="inline" intent=":literal"><semantics><mrow><mn>96.0</mn><mo mathsize="0.700em">±</mo><mn mathsize="0.700em">1.7</mn></mrow><annotation encoding="application/x-tex">96.0{\scriptstyle\pm 1.7}</annotation></semantics></math></td>
<td id="S5.T1.2.6.3" class="ltx_td ltx_align_center ltx_border_r" style="padding-left:3.0pt;padding-right:3.0pt;"><math id="S5.T1.m15" class="ltx_Math" alttext="91.8{\scriptstyle\pm 2.4}" display="inline" intent=":literal"><semantics><mrow><mn>91.8</mn><mo mathsize="0.700em">±</mo><mn mathsize="0.700em">2.4</mn></mrow><annotation encoding="application/x-tex">91.8{\scriptstyle\pm 2.4}</annotation></semantics></math></td>
