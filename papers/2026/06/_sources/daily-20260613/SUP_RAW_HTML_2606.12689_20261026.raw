<td id="S5.T1.2.5.2" class="ltx_td ltx_align_center" style="padding-left:3.0pt;padding-right:3.0pt;"><math id="S5.T1.m9" class="ltx_Math" alttext="98.0{\scriptstyle\pm 1.3}" display="inline" intent=":literal"><semantics><mrow><mn>98.0</mn><mo mathsize="0.700em">±</mo><mn mathsize="0.700em">1.3</mn></mrow><annotation encoding="application/x-tex">98.0{\scriptstyle\pm 1.3}</annotation></semantics></math></td>
<td id="S5.T1.2.5.3" class="ltx_td ltx_align_center ltx_border_r" style="padding-left:3.0pt;padding-right:3.0pt;"><math id="S5.T1.m10" class="ltx_Math" alttext="97.8{\scriptstyle\pm 1.3}" display="inline" intent=":literal"><semantics><mrow><mn>97.8</mn><mo mathsize="0.700em">±</mo><mn mathsize="0.700em">1.3</mn></mrow><annotation encoding="application/x-tex">97.8{\scriptstyle\pm 1.3}</annotation></semantics></math></td>
