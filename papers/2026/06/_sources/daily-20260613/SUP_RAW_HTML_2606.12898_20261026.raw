<section id="Ax1" class="ltx_appendix">
<h2 class="ltx_title ltx_font_smallcaps ltx_title_appendix">Appendix</h2>

<div id="Ax1.p1" class="ltx_para ltx_noindent">
<p id="Ax1.p1.1" class="ltx_p">(§<a href="#A1" title="Appendix A Full (𝑘,𝛼) Sensitivity Sweep ‣ Magnifying What Matters: Attention-Guided Adaptive Rendering for Visual Text Comprehension" class="ltx_ref"><span class="ltx_text ltx_ref_tag">A</span></a>)  <a href="#A1" title="In Magnifying What Matters: Attention-Guided Adaptive Rendering for Visual Text Comprehension" class="ltx_ref ltx_refmacro_nameref"><span class="ltx_text ltx_ref_title"><span class="ltx_tag ltx_tag_ref">Appendix A </span>Full <math class="ltx_Math" alttext="(k,\alpha)" display="inline" intent=":literal"><semantics><mrow><mo stretchy="false">(</mo><mi>k</mi><mo>,</mo><mi>α</mi><mo stretchy="false">)</mo></mrow><annotation encoding="application/x-tex">(k,\alpha)</annotation></semantics></math> Sensitivity Sweep</span></a><span id="Ax1.p1.1.1" class="ltx_text ltx_leader">.</span><a href="#A1" title="Appendix A Full (𝑘,𝛼) Sensitivity Sweep ‣ Magnifying What Matters: Attention-Guided Adaptive Rendering for Visual Text Comprehension" class="ltx_ref"><span class="ltx_text ltx_ref_tag">A</span></a></p>
</div>
<div id="Ax1.p2" class="ltx_para ltx_noindent">
