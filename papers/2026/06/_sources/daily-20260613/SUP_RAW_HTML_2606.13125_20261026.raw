<td id="S3.T1.3.5.3" class="ltx_td ltx_align_center ltx_border_bb"><span id="S3.T1.3.5.3.1" class="ltx_text ltx_font_bold">96.0</span></td>
<td id="S3.T1.3.5.4" class="ltx_td ltx_align_center ltx_border_bb">11.6</td>
