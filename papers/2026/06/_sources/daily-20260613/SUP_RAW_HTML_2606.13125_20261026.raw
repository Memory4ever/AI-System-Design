<td id="S3.T1.3.3.8" class="ltx_td ltx_align_center ltx_border_t">47.0</td>
<td id="S3.T1.3.3.9" class="ltx_td ltx_align_center ltx_border_t">27.1</td>
<td id="S3.T1.3.3.10" class="ltx_td ltx_align_center ltx_border_t">64.3</td></tr>
