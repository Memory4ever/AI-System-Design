<span id="S2.F1.p5.pic1.2" class="ltx_inline-block ltx_minipage ltx_align_bottom" style="width:15.19em;">
<span id="S2.F1.p5.pic1.2.1" class="ltx_p"><span id="S2.F1.p5.pic1.2.1.1" class="ltx_text" style="--ltx-fg-color:#000000;">Read off the inverse mapping: <math id="S2.F1.p5.pic1.m1" class="ltx_Math" alttext="\texttt{e0}=0,\texttt{e1}=1,\texttt{e9}=2,\texttt{e2}=3,\texttt{e5}=4,\texttt{e7}=5,\texttt{e3}=6,\texttt{e10}=7,\texttt{e4}=8,\texttt{e6}=9,\texttt{e8}=10" display="inline" intent=":literal"><semantics><mrow><mrow><mtext style="--ltx-fg-color:#000000;" class="ltx_mathvariant_monospace" mathcolor="#000000">e0</mtext><mo style="--ltx-fg-color:#000000;" mathcolor="#000000">=</mo><mn style="--ltx-fg-color:#000000;" mathcolor="#000000">0</mn></mrow><mo style="--ltx-fg-color:#000000;" mathcolor="#000000">,</mo><mrow><mtext style="--ltx-fg-color:#000000;" class="ltx_mathvariant_monospace" mathcolor="#000000">e1</mtext><mo style="--ltx-fg-color:#000000;" mathcolor="#000000">=</mo><mn style="--ltx-fg-color:#000000;" mathcolor="#000000">1</mn></mrow><mo style="--ltx-fg-color:#000000;" mathcolor="#000000">,</mo><mrow><mtext style="--ltx-fg-color:#000000;" class="ltx_mathvariant_monospace" mathcolor="#000000">e9</mtext><mo style="--ltx-fg-color:#000000;" mathcolor="#000000">=</mo><mn style="--ltx-fg-color:#000000;" mathcolor="#000000">2</mn></mrow><mo style="--ltx-fg-color:#000000;" mathcolor="#000000">,</mo><mrow><mtext style="--ltx-fg-color:#000000;" class="ltx_mathvariant_monospace" mathcolor="#000000">e2</mtext><mo style="--ltx-fg-color:#000000;" mathcolor="#000000">=</mo><mn style="--ltx-fg-color:#000000;" mathcolor="#000000">3</mn></mrow><mo style="--ltx-fg-color:#000000;" mathcolor="#000000">,</mo><mrow><mtext style="--ltx-fg-color:#000000;" class="ltx_mathvariant_monospace" mathcolor="#000000">e5</mtext><mo style="--ltx-fg-color:#000000;" mathcolor="#000000">=</mo><mn style="--ltx-fg-color:#000000;" mathcolor="#000000">4</mn></mrow><mo style="--ltx-fg-color:#000000;" mathcolor="#000000">,</mo><mrow><mtext style="--ltx-fg-color:#000000;" class="ltx_mathvariant_monospace" mathcolor="#000000">e7</mtext><mo style="--ltx-fg-color:#000000;" mathcolor="#000000">=</mo><mn style="--ltx-fg-color:#000000;" mathcolor="#000000">5</mn></mrow><mo style="--ltx-fg-color:#000000;" mathcolor="#000000">,</mo><mrow><mtext style="--ltx-fg-color:#000000;" class="ltx_mathvariant_monospace" mathcolor="#000000">e3</mtext><mo style="--ltx-fg-color:#000000;" mathcolor="#000000">=</mo><mn style="--ltx-fg-color:#000000;" mathcolor="#000000">6</mn></mrow><mo style="--ltx-fg-color:#000000;" mathcolor="#000000">,</mo><mrow><mtext style="--ltx-fg-color:#000000;" class="ltx_mathvariant_monospace" mathcolor="#000000">e10</mtext><mo style="--ltx-fg-color:#000000;" mathcolor="#000000">=</mo><mn style="--ltx-fg-color:#000000;" mathcolor="#000000">7</mn></mrow><mo style="--ltx-fg-color:#000000;" mathcolor="#000000">,</mo><mrow><mtext style="--ltx-fg-color:#000000;" class="ltx_mathvariant_monospace" mathcolor="#000000">e4</mtext><mo style="--ltx-fg-color:#000000;" mathcolor="#000000">=</mo><mn style="--ltx-fg-color:#000000;" mathcolor="#000000">8</mn></mrow><mo style="--ltx-fg-color:#000000;" mathcolor="#000000">,</mo><mrow><mtext style="--ltx-fg-color:#000000;" class="ltx_mathvariant_monospace" mathcolor="#000000">e6</mtext><mo style="--ltx-fg-color:#000000;" mathcolor="#000000">=</mo><mn style="--ltx-fg-color:#000000;" mathcolor="#000000">9</mn></mrow><mo style="--ltx-fg-color:#000000;" mathcolor="#000000">,</mo><mrow><mtext style="--ltx-fg-color:#000000;" class="ltx_mathvariant_monospace" mathcolor="#000000">e8</mtext><mo style="--ltx-fg-color:#000000;" mathcolor="#000000">=</mo><mn style="--ltx-fg-color:#000000;" mathcolor="#000000">10</mn></mrow></mrow><annotation encoding="application/x-tex">\texttt{e0}=0,\texttt{e1}=1,\texttt{e9}=2,\texttt{e2}=3,\texttt{e5}=4,\texttt{e7}=5,\texttt{e3}=6,\texttt{e10}=7,\texttt{e4}=8,\texttt{e6}=9,\texttt{e8}=10</annotation></semantics></math></span></span>
<span id="S2.F1.p5.pic1.2.2" class="ltx_p"><span id="S2.F1.p5.pic1.2.2.1" class="ltx_text" style="--ltx-fg-color:#000000;">Undo Step 3, Multiply by <math id="S2.F1.p5.pic1.m2" class="ltx_Math" alttext="\texttt{e5}(\texttt{e5}=4)" display="inline" intent=":literal"><semantics><mrow><mtext style="--ltx-fg-color:#000000;" class="ltx_mathvariant_monospace" mathcolor="#000000">e5</mtext><mo lspace="0em" rspace="0em">​</mo><mrow><mo style="--ltx-fg-color:#000000;" mathcolor="#000000" stretchy="false">(</mo><mrow><mtext style="--ltx-fg-color:#000000;" class="ltx_mathvariant_monospace" mathcolor="#000000">e5</mtext><mo style="--ltx-fg-color:#000000;" mathcolor="#000000">=</mo><mn style="--ltx-fg-color:#000000;" mathcolor="#000000">4</mn></mrow><mo style="--ltx-fg-color:#000000;" mathcolor="#000000" stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">\texttt{e5}(\texttt{e5}=4)</annotation></semantics></math>: <math id="S2.F1.p5.pic1.m3" class="ltx_Math" alttext="(x)*3" display="inline" intent=":literal"><semantics><mrow><mrow><mo style="--ltx-fg-color:#000000;" mathcolor="#000000" stretchy="false">(</mo><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">x</mi><mo style="--ltx-fg-color:#000000;" mathcolor="#000000" rspace="0.055em" stretchy="false">)</mo></mrow><mo style="--ltx-fg-color:#000000;" mathcolor="#000000" rspace="0.222em">∗</mo><mn style="--ltx-fg-color:#000000;" mathcolor="#000000">3</mn></mrow><annotation encoding="application/x-tex">(x)*3</annotation></semantics></math></span></span>
<span id="S2.F1.p5.pic1.2.3" class="ltx_p"><span id="S2.F1.p5.pic1.2.3.1" class="ltx_text" style="--ltx-fg-color:#000000;">Undo Step 2, Add <math id="S2.F1.p5.pic1.m4" class="ltx_Math" alttext="\texttt{e8}(\texttt{e8}=10)" display="inline" intent=":literal"><semantics><mrow><mtext style="--ltx-fg-color:#000000;" class="ltx_mathvariant_monospace" mathcolor="#000000">e8</mtext><mo lspace="0em" rspace="0em">​</mo><mrow><mo style="--ltx-fg-color:#000000;" mathcolor="#000000" stretchy="false">(</mo><mrow><mtext style="--ltx-fg-color:#000000;" class="ltx_mathvariant_monospace" mathcolor="#000000">e8</mtext><mo style="--ltx-fg-color:#000000;" mathcolor="#000000">=</mo><mn style="--ltx-fg-color:#000000;" mathcolor="#000000">10</mn></mrow><mo style="--ltx-fg-color:#000000;" mathcolor="#000000" stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">\texttt{e8}(\texttt{e8}=10)</annotation></semantics></math>: <math id="S2.F1.p5.pic1.m5" class="ltx_Math" alttext="(x)*3-10" display="inline" intent=":literal"><semantics><mrow><mrow><mrow><mo style="--ltx-fg-color:#000000;" mathcolor="#000000" stretchy="false">(</mo><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">x</mi><mo style="--ltx-fg-color:#000000;" mathcolor="#000000" rspace="0.055em" stretchy="false">)</mo></mrow><mo style="--ltx-fg-color:#000000;" mathcolor="#000000" rspace="0.222em">∗</mo><mn style="--ltx-fg-color:#000000;" mathcolor="#000000">3</mn></mrow><mo style="--ltx-fg-color:#000000;" mathcolor="#000000">−</mo><mn style="--ltx-fg-color:#000000;" mathcolor="#000000">10</mn></mrow><annotation encoding="application/x-tex">(x)*3-10</annotation></semantics></math></span></span>
<span id="S2.F1.p5.pic1.2.4" class="ltx_p"><span id="S2.F1.p5.pic1.2.4.1" class="ltx_text" style="--ltx-fg-color:#000000;">Undo Step 1, Add <math id="S2.F1.p5.pic1.m6" class="ltx_Math" alttext="\texttt{e2}(\texttt{e2}=3)" display="inline" intent=":literal"><semantics><mrow><mtext style="--ltx-fg-color:#000000;" class="ltx_mathvariant_monospace" mathcolor="#000000">e2</mtext><mo lspace="0em" rspace="0em">​</mo><mrow><mo style="--ltx-fg-color:#000000;" mathcolor="#000000" stretchy="false">(</mo><mrow><mtext style="--ltx-fg-color:#000000;" class="ltx_mathvariant_monospace" mathcolor="#000000">e2</mtext><mo style="--ltx-fg-color:#000000;" mathcolor="#000000">=</mo><mn style="--ltx-fg-color:#000000;" mathcolor="#000000">3</mn></mrow><mo style="--ltx-fg-color:#000000;" mathcolor="#000000" stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">\texttt{e2}(\texttt{e2}=3)</annotation></semantics></math>: <math id="S2.F1.p5.pic1.m7" class="ltx_Math" alttext="(x)*3-10-3" display="inline" intent=":literal"><semantics><mrow><mrow><mrow><mo style="--ltx-fg-color:#000000;" mathcolor="#000000" stretchy="false">(</mo><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">x</mi><mo style="--ltx-fg-color:#000000;" mathcolor="#000000" rspace="0.055em" stretchy="false">)</mo></mrow><mo style="--ltx-fg-color:#000000;" mathcolor="#000000" rspace="0.222em">∗</mo><mn style="--ltx-fg-color:#000000;" mathcolor="#000000">3</mn></mrow><mo style="--ltx-fg-color:#000000;" mathcolor="#000000">−</mo><mn style="--ltx-fg-color:#000000;" mathcolor="#000000">10</mn><mo style="--ltx-fg-color:#000000;" mathcolor="#000000">−</mo><mn style="--ltx-fg-color:#000000;" mathcolor="#000000">3</mn></mrow><annotation encoding="application/x-tex">(x)*3-10-3</annotation></semantics></math></span></span>
<span id="S2.F1.p5.pic1.2.5" class="ltx_p"><span id="S2.F1.p5.pic1.2.5.1" class="ltx_text" style="--ltx-fg-color:#000000;">Equation: <math id="S2.F1.p5.pic1.m8" class="ltx_Math" alttext="3*x+9\equiv 7\pmod{11}" display="inline" intent=":literal"><semantics><mrow><mrow><mrow><mn style="--ltx-fg-color:#000000;" mathcolor="#000000">3</mn><mo style="--ltx-fg-color:#000000;" lspace="0.222em" mathcolor="#000000" rspace="0.222em">∗</mo><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">x</mi></mrow><mo style="--ltx-fg-color:#000000;" mathcolor="#000000">+</mo><mn style="--ltx-fg-color:#000000;" mathcolor="#000000">9</mn></mrow><mo style="--ltx-fg-color:#000000;" mathcolor="#000000">≡</mo><mrow><mn style="--ltx-fg-color:#000000;" mathcolor="#000000">7</mn><mspace style="width:0.949em;" width="0.949em"></mspace><mrow><mo style="--ltx-fg-color:#000000;" mathcolor="#000000" stretchy="false">(</mo><mrow><mo style="--ltx-fg-color:#000000;" lspace="0em" mathcolor="#000000" rspace="0.167em">mod</mo><mn style="--ltx-fg-color:#000000;" mathcolor="#000000">11</mn></mrow><mo style="--ltx-fg-color:#000000;" mathcolor="#000000" stretchy="false">)</mo></mrow></mrow></mrow><annotation encoding="application/x-tex">3*x+9\equiv 7\pmod{11}</annotation></semantics></math></span></span>
<span id="S2.F1.p5.pic1.2.6" class="ltx_p"><math id="S2.F1.p5.pic1.m9" class="ltx_Math" alttext="3*x\equiv 9\pmod{11}" display="inline" intent=":literal"><semantics><mrow><mrow><mn style="--ltx-fg-color:#000000;" mathcolor="#000000">3</mn><mo style="--ltx-fg-color:#000000;" lspace="0.222em" mathcolor="#000000" rspace="0.222em">∗</mo><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">x</mi></mrow><mo style="--ltx-fg-color:#000000;" mathcolor="#000000">≡</mo><mrow><mn style="--ltx-fg-color:#000000;" mathcolor="#000000">9</mn><mspace style="width:0.949em;" width="0.949em"></mspace><mrow><mo style="--ltx-fg-color:#000000;" mathcolor="#000000" stretchy="false">(</mo><mrow><mo style="--ltx-fg-color:#000000;" lspace="0em" mathcolor="#000000" rspace="0.167em">mod</mo><mn style="--ltx-fg-color:#000000;" mathcolor="#000000">11</mn></mrow><mo style="--ltx-fg-color:#000000;" mathcolor="#000000" stretchy="false">)</mo></mrow></mrow></mrow><annotation encoding="application/x-tex">3*x\equiv 9\pmod{11}</annotation></semantics></math><span id="S2.F1.p5.pic1.2.6.1" class="ltx_text"></span></span>
<span id="S2.F1.p5.pic1.2.7" class="ltx_p"><math id="S2.F1.p5.pic1.m10" class="ltx_Math" alttext="x\equiv 9*4\equiv 3\pmod{11}" display="inline" intent=":literal"><semantics><mrow><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">x</mi><mo style="--ltx-fg-color:#000000;" mathcolor="#000000">≡</mo><mrow><mn style="--ltx-fg-color:#000000;" mathcolor="#000000">9</mn><mo style="--ltx-fg-color:#000000;" lspace="0.222em" mathcolor="#000000" rspace="0.222em">∗</mo><mn style="--ltx-fg-color:#000000;" mathcolor="#000000">4</mn></mrow><mo style="--ltx-fg-color:#000000;" mathcolor="#000000">≡</mo><mrow><mn style="--ltx-fg-color:#000000;" mathcolor="#000000">3</mn><mspace style="width:0.949em;" width="0.949em"></mspace><mrow><mo style="--ltx-fg-color:#000000;" mathcolor="#000000" stretchy="false">(</mo><mrow><mo style="--ltx-fg-color:#000000;" lspace="0em" mathcolor="#000000" rspace="0.167em">mod</mo><mn style="--ltx-fg-color:#000000;" mathcolor="#000000">11</mn></mrow><mo style="--ltx-fg-color:#000000;" mathcolor="#000000" stretchy="false">)</mo></mrow></mrow></mrow><annotation encoding="application/x-tex">x\equiv 9*4\equiv 3\pmod{11}</annotation></semantics></math><span id="S2.F1.p5.pic1.2.7.1" class="ltx_text"></span></span>
<span id="S2.F1.p5.pic1.2.8" class="ltx_p"><span id="S2.F1.p5.pic1.2.8.1" class="ltx_text" style="--ltx-fg-color:#000000;">Convert back: <math id="S2.F1.p5.pic1.m11" class="ltx_Math" alttext="3\to\texttt{e2}" display="inline" intent=":literal"><semantics><mrow><mn style="--ltx-fg-color:#000000;" mathcolor="#000000">3</mn><mo style="--ltx-fg-color:#000000;" mathcolor="#000000" stretchy="false">→</mo><mtext style="--ltx-fg-color:#000000;" class="ltx_mathvariant_monospace" mathcolor="#000000">e2</mtext></mrow><annotation encoding="application/x-tex">3\to\texttt{e2}</annotation></semantics></math></span></span>
<span id="S2.F1.p5.pic1.2.9" class="ltx_p"><span id="S2.F1.p5.pic1.2.9.1" class="ltx_text" style="--ltx-fg-color:#000000;">#### <span id="S2.F1.p5.pic1.2.9.1.1" class="ltx_text ltx_markedasmath ltx_font_typewriter">e2</span></span></span>
</span></span></span></foreignObject></g></g></svg></span>
</div>
          
