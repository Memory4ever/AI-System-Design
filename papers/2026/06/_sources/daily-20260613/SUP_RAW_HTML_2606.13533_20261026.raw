<td id="S4.T8.4.2.2" class="ltx_td ltx_align_center ltx_border_t"><math id="S4.T8.m5" class="ltx_Math" alttext="+0.074\%" display="inline" intent=":literal"><semantics><mrow><mo mathsize="0.800em">+</mo><mrow><mn mathsize="0.800em">0.074</mn><mo>%</mo></mrow></mrow><annotation encoding="application/x-tex">+0.074\%</annotation></semantics></math></td>
<td id="S4.T8.4.2.3" class="ltx_td ltx_align_center ltx_border_t"><math id="S4.T8.m6" class="ltx_Math" alttext="+0.450\%" display="inline" intent=":literal"><semantics><mrow><mo mathsize="0.800em">+</mo><mrow><mn mathsize="0.800em">0.450</mn><mo>%</mo></mrow></mrow><annotation encoding="application/x-tex">+0.450\%</annotation></semantics></math></td>
<td id="S4.T8.4.2.4" class="ltx_td ltx_align_center ltx_border_t"><math id="S4.T8.m7" class="ltx_math_unparsed" alttext="+0.710\%^{\dagger}" display="inline" intent=":literal"><semantics><mrow><mo mathsize="0.800em">+</mo><mn mathsize="0.800em">0.710</mn><mo>%</mo><msup><mrow></mrow><mo mathsize="0.800em">†</mo></msup></mrow><annotation encoding="application/x-tex">+0.710\%^{\dagger}</annotation></semantics></math></td></tr>
<tr id="S4.T8.4.3" class="ltx_tr">
<th id="S4.T8.4.3.1" class="ltx_td ltx_align_left ltx_th ltx_th_row ltx_border_bb"><span id="S4.T8.4.3.1.1" class="ltx_text" style="font-size:80%;">Replace nearly all</span></th>
<td id="S4.T8.4.3.2" class="ltx_td ltx_align_center ltx_border_bb"><math id="S4.T8.m8" class="ltx_math_unparsed" alttext="+0.821\%^{\dagger}" display="inline" intent=":literal"><semantics><mrow><mo mathsize="0.800em">+</mo><mn mathsize="0.800em">0.821</mn><mo>%</mo><msup><mrow></mrow><mo mathsize="0.800em">†</mo></msup></mrow><annotation encoding="application/x-tex">+0.821\%^{\dagger}</annotation></semantics></math></td>
<td id="S4.T8.4.3.3" class="ltx_td ltx_align_center ltx_border_bb"><math id="S4.T8.m9" class="ltx_Math" alttext="-0.028\%" display="inline" intent=":literal"><semantics><mrow><mo mathsize="0.800em">−</mo><mrow><mn mathsize="0.800em">0.028</mn><mo>%</mo></mrow></mrow><annotation encoding="application/x-tex">-0.028\%</annotation></semantics></math></td>
