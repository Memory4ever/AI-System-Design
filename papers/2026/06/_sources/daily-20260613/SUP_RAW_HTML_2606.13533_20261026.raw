<th id="S4.T8.4.1.2" class="ltx_td ltx_align_center ltx_th ltx_th_column ltx_border_tt"><span id="S4.T8.4.1.2.1" class="ltx_text ltx_font_bold" style="font-size:80%;">Item CTR</span></th>
<th id="S4.T8.4.1.3" class="ltx_td ltx_align_center ltx_th ltx_th_column ltx_border_tt"><span id="S4.T8.4.1.3.1" class="ltx_text ltx_font_bold" style="font-size:80%;">Buyer</span></th>
<th id="S4.T8.4.1.4" class="ltx_td ltx_align_center ltx_th ltx_th_column ltx_border_tt"><span id="S4.T8.4.1.4.1" class="ltx_text ltx_font_bold" style="font-size:80%;">Order</span></th></tr>
