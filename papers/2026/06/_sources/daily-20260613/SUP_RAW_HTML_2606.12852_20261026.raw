<td id="S4.T1.14.4.3" class="ltx_td ltx_align_center" style="padding-left:7.0pt;padding-right:7.0pt;"><span id="S4.T1.14.4.3.1" class="ltx_text" style="font-size:90%;">0.67</span></td>
<td id="S4.T1.14.4.4" class="ltx_td ltx_align_center" style="padding-left:7.0pt;padding-right:7.0pt;"><span id="S4.T1.14.4.4.1" class="ltx_text" style="font-size:90%;">0.39</span></td>
<td id="S4.T1.14.4.5" class="ltx_td ltx_align_center" style="padding-left:7.0pt;padding-right:7.0pt;"><span id="S4.T1.14.4.5.1" class="ltx_text" style="font-size:90%;">0.69</span></td></tr>
<tr id="S4.T1.14.5" class="ltx_tr">
<th id="S4.T1.14.5.1" class="ltx_td ltx_align_left ltx_th ltx_th_row" style="padding-left:7.0pt;padding-right:7.0pt;"><span id="S4.T1.14.5.1.1" class="ltx_text" style="font-size:90%;">WISE<sup id="S4.T1.14.5.1.1.1" class="ltx_sup"><span id="S4.T1.14.5.1.1.1.1" class="ltx_text ltx_font_italic">∗</span></sup>(Quadtree-Based)</span></th>
<td id="S4.T1.14.5.2" class="ltx_td ltx_align_center" style="padding-left:7.0pt;padding-right:7.0pt;"><span id="S4.T1.14.5.2.1" class="ltx_text ltx_font_bold" style="font-size:90%;">0.72</span></td>
<td id="S4.T1.14.5.3" class="ltx_td ltx_align_center" style="padding-left:7.0pt;padding-right:7.0pt;"><span id="S4.T1.14.5.3.1" class="ltx_text" style="font-size:90%;">0.75</span></td>
<td id="S4.T1.14.5.4" class="ltx_td ltx_align_center" style="padding-left:7.0pt;padding-right:7.0pt;"><span id="S4.T1.14.5.4.1" class="ltx_text ltx_font_bold" style="font-size:90%;">0.44</span></td>
<td id="S4.T1.14.5.5" class="ltx_td ltx_align_center" style="padding-left:7.0pt;padding-right:7.0pt;"><span id="S4.T1.14.5.5.1" class="ltx_text" style="font-size:90%;">0.74</span></td></tr>
