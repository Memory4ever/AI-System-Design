<td id="S4.T1.14.6.2" class="ltx_td ltx_align_center ltx_border_bb" style="padding-left:7.0pt;padding-right:7.0pt;"><span id="S4.T1.14.6.2.1" class="ltx_text" style="font-size:90%;">0.71</span></td>
<td id="S4.T1.14.6.3" class="ltx_td ltx_align_center ltx_border_bb" style="padding-left:7.0pt;padding-right:7.0pt;"><span id="S4.T1.14.6.3.1" class="ltx_text ltx_font_bold" style="font-size:90%;">0.97</span></td>
<td id="S4.T1.14.6.4" class="ltx_td ltx_align_center ltx_border_bb" style="padding-left:7.0pt;padding-right:7.0pt;"><span id="S4.T1.14.6.4.1" class="ltx_text ltx_font_bold" style="font-size:90%;">0.44</span></td>
<td id="S4.T1.14.6.5" class="ltx_td ltx_align_center ltx_border_bb" style="padding-left:7.0pt;padding-right:7.0pt;"><span id="S4.T1.14.6.5.1" class="ltx_text ltx_font_bold" style="font-size:90%;">0.83</span></td></tr>
