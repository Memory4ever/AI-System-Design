          <span id="alg1.l9.3" class="ltx_text ltx_font_bold">else</span> <span id="alg1.l9.4" class="ltx_text ltx_font_bold">if</span> <math id="alg1.l9.m1" class="ltx_Math" alttext="S(\tau_{t}+i)\neq\emptyset" display="inline" intent=":literal"><semantics><mrow><mrow><mi>S</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mrow><msub><mi>τ</mi><mi>t</mi></msub><mo>+</mo><mi>i</mi></mrow><mo stretchy="false">)</mo></mrow></mrow><mo>≠</mo><mi mathvariant="normal">∅</mi></mrow><annotation encoding="application/x-tex">S(\tau_{t}+i)\neq\emptyset</annotation></semantics></math>  <span id="alg1.l9.5" class="ltx_text ltx_font_bold">then</span>

</div>
<div id="alg1.l10" class="ltx_listingline">
