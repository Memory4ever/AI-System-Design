            Execute <math id="alg1.l12.m1" class="ltx_Math" alttext="\tau_{n}" display="inline" intent=":literal"><semantics><msub><mi>τ</mi><mi>n</mi></msub><annotation encoding="application/x-tex">\tau_{n}</annotation></semantics></math> with <math id="alg1.l12.m2" class="ltx_Math" alttext="\pi_{\text{Inst}}" display="inline" intent=":literal"><semantics><msub><mi>π</mi><mtext>Inst</mtext></msub><annotation encoding="application/x-tex">\pi_{\text{Inst}}</annotation></semantics></math>

</div>
<div id="alg1.l13" class="ltx_listingline">
            <span class="ltx_tag ltx_tag_listingline"><span id="alg1.l13.1" class="ltx_text" style="font-size:80%;">13:</span></span>
            
            
          <span id="alg1.l13.3" class="ltx_text ltx_font_bold">else</span>
</div>
<div id="alg1.l14" class="ltx_listingline">
            <span class="ltx_tag ltx_tag_listingline"><span id="alg1.l14.1" class="ltx_text" style="font-size:80%;">14:</span></span>
            
            
            Explore with <math id="alg1.l14.m1" class="ltx_Math" alttext="\pi_{H_{M}s}" display="inline" intent=":literal"><semantics><msub><mi>π</mi><mrow><msub><mi>H</mi><mi>M</mi></msub><mo lspace="0em" rspace="0em">​</mo><mi>s</mi></mrow></msub><annotation encoding="application/x-tex">\pi_{H_{M}s}</annotation></semantics></math>, <math id="alg1.l14.m2" class="ltx_Math" alttext="\pi_{L_{N}av}" display="inline" intent=":literal"><semantics><msub><mi>π</mi><mrow><msub><mi>L</mi><mi>N</mi></msub><mo lspace="0em" rspace="0em">​</mo><mi>a</mi><mo lspace="0em" rspace="0em">​</mo><mi>v</mi></mrow></msub><annotation encoding="application/x-tex">\pi_{L_{N}av}</annotation></semantics></math> 
</div>
