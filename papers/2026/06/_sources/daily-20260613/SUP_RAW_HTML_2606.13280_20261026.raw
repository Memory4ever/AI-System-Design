<td class="ltx_td ltx_align_right ltx_eqn_cell"><math id="A5.Ex281.m1" class="ltx_Math" alttext="\displaystyle\big\|\mathbf{y}_{1}-\mathbf{g}_{0}(\mathbf{x}_{4},\mathbf{x}_{1})\big\|_{\infty}\vee\left\|\mathbf{y}_{2}-\exp\big(-\mathbf{x}_{1}^{\top}\,\mathbf{g}_{0}(\mathbf{x}_{3},\mathbf{x}_{4})\big)\mathbf{x}_{2}\right\|_{\infty}\lesssim(N_{\mathrm{mlp}})^{-\frac{2\beta_{1}}{m_{1}r_{1}}}." display="inline" intent=":literal"><semantics><mrow><mrow><mrow><msub><mrow><mo maxsize="1.200em" minsize="1.200em" stretchy="true">‖</mo><mrow><msub><mi>𝐲</mi><mn>1</mn></msub><mo>−</mo><mrow><msub><mi>𝐠</mi><mn>0</mn></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mi>𝐱</mi><mn>4</mn></msub><mo>,</mo><msub><mi>𝐱</mi><mn>1</mn></msub><mo stretchy="false">)</mo></mrow></mrow></mrow><mo maxsize="1.200em" minsize="1.200em" stretchy="true">‖</mo></mrow><mi mathvariant="normal">∞</mi></msub><mo>∨</mo><msub><mrow><mo>‖</mo><mrow><msub><mi>𝐲</mi><mn>2</mn></msub><mo>−</mo><mrow><mrow><mi>exp</mi><mo>⁡</mo><mrow><mo maxsize="1.200em" minsize="1.200em">(</mo><mrow><mo>−</mo><mrow><msubsup><mi>𝐱</mi><mn>1</mn><mo>⊤</mo></msubsup><mo lspace="0em" rspace="0em">​</mo><msub><mi>𝐠</mi><mn>0</mn></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mi>𝐱</mi><mn>3</mn></msub><mo>,</mo><msub><mi>𝐱</mi><mn>4</mn></msub><mo stretchy="false">)</mo></mrow></mrow></mrow><mo maxsize="1.200em" minsize="1.200em">)</mo></mrow></mrow><mo lspace="0em" rspace="0em">​</mo><msub><mi>𝐱</mi><mn>2</mn></msub></mrow></mrow><mo>‖</mo></mrow><mi mathvariant="normal">∞</mi></msub></mrow><mo>≲</mo><msup><mrow><mo stretchy="false">(</mo><msub><mi>N</mi><mi>mlp</mi></msub><mo stretchy="false">)</mo></mrow><mrow><mo>−</mo><mfrac><mrow><mn>2</mn><mo lspace="0em" rspace="0em">​</mo><msub><mi>β</mi><mn>1</mn></msub></mrow><mrow><msub><mi>m</mi><mn>1</mn></msub><mo lspace="0em" rspace="0em">​</mo><msub><mi>r</mi><mn>1</mn></msub></mrow></mfrac></mrow></msup></mrow><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">\displaystyle\big\|\mathbf{y}_{1}-\mathbf{g}_{0}(\mathbf{x}_{4},\mathbf{x}_{1})\big\|_{\infty}\vee\left\|\mathbf{y}_{2}-\exp\big(-\mathbf{x}_{1}^{\top}\,\mathbf{g}_{0}(\mathbf{x}_{3},\mathbf{x}_{4})\big)\mathbf{x}_{2}\right\|_{\infty}\lesssim(N_{\mathrm{mlp}})^{-\frac{2\beta_{1}}{m_{1}r_{1}}}.</annotation></semantics></math></td>
