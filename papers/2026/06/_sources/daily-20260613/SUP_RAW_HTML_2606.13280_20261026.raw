<p id="A5.SS3.p1.7" class="ltx_p">with</p>
<table id="A5.Ex312" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="A5.Ex312.m1" class="ltx_Math" alttext="\mathbf{y}\coloneqq\overline{\sum}_{s\in[\log^{2}T,T-\log^{2}T]}\Big(\exp\big(\big\langle\operatorname{stack}(\mathbf{x}_{3,s},\mathbf{x}_{4,s}),\operatorname{stack}(\mathbf{x}_{4,T},\mathbf{x}_{5,T})\big\rangle-x_{6,s}x_{6,T}\big)\,;\,\mathbf{x}_{2,s}\Big)." display="block" intent=":literal"><semantics><mrow><mrow><mi>𝐲</mi><mo rspace="0.111em">≔</mo><mrow><msub><mover accent="true"><mo movablelimits="false">∑</mo><mo stretchy="true">¯</mo></mover><mrow><mi>s</mi><mo>∈</mo><mrow><mo stretchy="false">[</mo><mrow><mrow><msup><mi>log</mi><mn>2</mn></msup><mo lspace="0.167em">⁡</mo><mi>T</mi></mrow><mo>,</mo><mrow><mi>T</mi><mo>−</mo><mrow><msup><mi>log</mi><mn>2</mn></msup><mo lspace="0.167em">⁡</mo><mi>T</mi></mrow></mrow></mrow><mo stretchy="false">]</mo></mrow></mrow></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo maxsize="1.600em" minsize="1.600em">(</mo><mrow><mi>exp</mi><mo>⁡</mo><mrow><mo maxsize="1.200em" minsize="1.200em">(</mo><mrow><mrow><mo stretchy="false">⟨</mo><mrow><mrow><mi>stack</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><msub><mi>𝐱</mi><mrow><mn>3</mn><mo>,</mo><mi>s</mi></mrow></msub><mo>,</mo><msub><mi>𝐱</mi><mrow><mn>4</mn><mo>,</mo><mi>s</mi></mrow></msub><mo stretchy="false">)</mo></mrow></mrow><mo>,</mo><mrow><mi>stack</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><msub><mi>𝐱</mi><mrow><mn>4</mn><mo>,</mo><mi>T</mi></mrow></msub><mo>,</mo><msub><mi>𝐱</mi><mrow><mn>5</mn><mo>,</mo><mi>T</mi></mrow></msub><mo stretchy="false">)</mo></mrow></mrow></mrow><mo stretchy="false">⟩</mo></mrow><mo>−</mo><mrow><msub><mi>x</mi><mrow><mn>6</mn><mo>,</mo><mi>s</mi></mrow></msub><mo lspace="0em" rspace="0em">​</mo><msub><mi>x</mi><mrow><mn>6</mn><mo>,</mo><mi>T</mi></mrow></msub></mrow></mrow><mo maxsize="1.200em" minsize="1.200em" rspace="0.170em">)</mo></mrow></mrow><mo>,</mo><msub><mi>𝐱</mi><mrow><mn>2</mn><mo>,</mo><mi>s</mi></mrow></msub><mo maxsize="1.600em" minsize="1.600em">)</mo></mrow></mrow></mrow><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">\mathbf{y}\coloneqq\overline{\sum}_{s\in[\log^{2}T,T-\log^{2}T]}\Big(\exp\big(\big\langle\operatorname{stack}(\mathbf{x}_{3,s},\mathbf{x}_{4,s}),\operatorname{stack}(\mathbf{x}_{4,T},\mathbf{x}_{5,T})\big\rangle-x_{6,s}x_{6,T}\big)\,;\,\mathbf{x}_{2,s}\Big).</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="A5.SS3.p1.8" class="ltx_p">Then we have</p>
<table id="A5.EGx125" class="ltx_equationgroup ltx_eqn_align ltx_eqn_table">

<tbody id="A5.Ex313"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_align_right ltx_eqn_cell"><math id="A5.Ex313.m1" class="ltx_Math" alttext="\displaystyle\bm{\mu}_{2,0}\circ\bm{\nu}_{1,0}\circ\bm{\mu}_{1,0}\left(M\right)" display="inline" intent=":literal"><semantics><mrow><msub><mi>𝝁</mi><mrow><mn>2</mn><mo>,</mo><mn>0</mn></mrow></msub><mo lspace="0.222em" rspace="0.222em">∘</mo><msub><mi>𝝂</mi><mrow><mn>1</mn><mo>,</mo><mn>0</mn></mrow></msub><mo lspace="0.222em" rspace="0.222em">∘</mo><mrow><msub><mi>𝝁</mi><mrow><mn>1</mn><mo>,</mo><mn>0</mn></mrow></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo>(</mo><mi>M</mi><mo>)</mo></mrow></mrow></mrow><annotation encoding="application/x-tex">\displaystyle\bm{\mu}_{2,0}\circ\bm{\nu}_{1,0}\circ\bm{\mu}_{1,0}\left(M\right)</annotation></semantics></math></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A5.Ex313.m2" class="ltx_Math" alttext="\displaystyle=\left(\begin{matrix}\mathbf{g}_{0}(\mathbf{Z}_{1,t+1})\\
\bullet_{N-m_{1}-m_{2}}\\
\overline{\sum}_{s\in[\log^{2}T,T-\log^{2}T]}\Big(\exp\big(\frac{-r_{2}+\mathbf{Z}_{2,s}^{\top}\mathbf{Z}_{2,T+1}}{\lambda^{2}}\big)\,;\,\exp\big(-\mathbf{g}_{0}(\mathbf{Z}_{1,s})^{\top}\bm{\phi}_{1}(\mathbf{X}_{s})\big)\,\bm{\phi}_{2}(\mathbf{X}_{s})\Big)\end{matrix}\right)" display="inline" intent=":literal"><semantics><mrow><mphantom></mphantom><mo>=</mo><mrow><mo>(</mo><mtable rowspacing="0pt"><mtr><mtd><mrow><msub><mi>𝐠</mi><mn>0</mn></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mi>𝐙</mi><mrow><mn>1</mn><mo>,</mo><mrow><mi>t</mi><mo>+</mo><mn>1</mn></mrow></mrow></msub><mo stretchy="false">)</mo></mrow></mrow></mtd></mtr><mtr><mtd><mrow><mo>∙</mo><msub><mrow></mrow><mrow><mi>N</mi><mo>−</mo><msub><mi>m</mi><mn>1</mn></msub><mo>−</mo><msub><mi>m</mi><mn>2</mn></msub></mrow></msub></mrow></mtd></mtr><mtr><mtd><mrow><msub><mover accent="true"><mo>∑</mo><mo stretchy="true">¯</mo></mover><mrow><mi>s</mi><mo>∈</mo><mrow><mo stretchy="false">[</mo><mrow><mrow><msup><mi>log</mi><mn>2</mn></msup><mo lspace="0.167em">⁡</mo><mi>T</mi></mrow><mo>,</mo><mrow><mi>T</mi><mo>−</mo><mrow><msup><mi>log</mi><mn>2</mn></msup><mo lspace="0.167em">⁡</mo><mi>T</mi></mrow></mrow></mrow><mo stretchy="false">]</mo></mrow></mrow></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo maxsize="1.600em" minsize="1.600em">(</mo><mrow><mi>exp</mi><mo>⁡</mo><mrow><mo maxsize="1.200em" minsize="1.200em">(</mo><mfrac><mrow><mrow><mo>−</mo><msub><mi>r</mi><mn>2</mn></msub></mrow><mo>+</mo><mrow><msubsup><mi>𝐙</mi><mrow><mn>2</mn><mo>,</mo><mi>s</mi></mrow><mo>⊤</mo></msubsup><mo lspace="0em" rspace="0em">​</mo><msub><mi>𝐙</mi><mrow><mn>2</mn><mo>,</mo><mrow><mi>T</mi><mo>+</mo><mn>1</mn></mrow></mrow></msub></mrow></mrow><msup><mi>λ</mi><mn>2</mn></msup></mfrac><mo maxsize="1.200em" minsize="1.200em" rspace="0.170em">)</mo></mrow></mrow><mo mathsize="1.600em">,</mo><mrow><mrow><mi>exp</mi><mo>⁡</mo><mrow><mo maxsize="1.200em" minsize="1.200em">(</mo><mrow><mo>−</mo><mrow><msub><mi>𝐠</mi><mn>0</mn></msub><mo lspace="0em" rspace="0em">​</mo><msup><mrow><mo stretchy="false">(</mo><msub><mi>𝐙</mi><mrow><mn>1</mn><mo>,</mo><mi>s</mi></mrow></msub><mo stretchy="false">)</mo></mrow><mo>⊤</mo></msup><mo lspace="0em" rspace="0em">​</mo><msub><mi class="ltx_mathvariant_bold-italic" mathvariant="bold-italic">ϕ</mi><mn>1</mn></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mi>𝐗</mi><mi>s</mi></msub><mo stretchy="false">)</mo></mrow></mrow></mrow><mo maxsize="1.200em" minsize="1.200em">)</mo></mrow></mrow><mo lspace="0.170em" rspace="0em">​</mo><msub><mi class="ltx_mathvariant_bold-italic" mathvariant="bold-italic">ϕ</mi><mn>2</mn></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mi>𝐗</mi><mi>s</mi></msub><mo stretchy="false">)</mo></mrow></mrow><mo maxsize="1.600em" minsize="1.600em">)</mo></mrow></mrow></mtd></mtr></mtable><mo>)</mo></mrow></mrow><annotation encoding="application/x-tex">\displaystyle=\left(\begin{matrix}\mathbf{g}_{0}(\mathbf{Z}_{1,t+1})\\
\bullet_{N-m_{1}-m_{2}}\\
\overline{\sum}_{s\in[\log^{2}T,T-\log^{2}T]}\Big(\exp\big(\frac{-r_{2}+\mathbf{Z}_{2,s}^{\top}\mathbf{Z}_{2,T+1}}{\lambda^{2}}\big)\,;\,\exp\big(-\mathbf{g}_{0}(\mathbf{Z}_{1,s})^{\top}\bm{\phi}_{1}(\mathbf{X}_{s})\big)\,\bm{\phi}_{2}(\mathbf{X}_{s})\Big)\end{matrix}\right)</annotation></semantics></math></td>
