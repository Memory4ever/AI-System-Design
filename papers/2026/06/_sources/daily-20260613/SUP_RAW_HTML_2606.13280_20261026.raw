lign_left" columnalign="left"><mphantom></mphantom></mtd></mtr><mtr><mtd class="ltx_align_left" columnalign="left"><mrow><mphantom></mphantom><mo>∈</mo><msup><mrow><mo stretchy="false">[</mo><mrow><mrow><mo>−</mo><mn>1</mn></mrow><mo>,</mo><mn>1</mn></mrow><mo stretchy="false">]</mo></mrow><mrow><mi>N</mi><mo>/</mo><mn>2</mn></mrow></msup></mrow></mtd></mtr></mtable></mrow></mrow><mo lspace="0.167em">,</mo></mrow><annotation encoding="application/x-tex">(\mathbf{x}^{\prime}_{t})_{t\in[T]}\coloneqq\left(\begin{matrix}\mathbf{x}^{\prime}_{1,t}\\
\mathbf{x}^{\prime}_{2,t}\\
\mathbf{x}^{\prime}_{3,t}\\
\mathbf{x}^{\prime}_{4,t}\\
\mathbf{x}^{\prime}_{5,t}\\
\mathbf{x}^{\prime}_{6,t}\\
\bm{0}_{\tfrac{N}{2}-(r_{1}+1)m_{1}-(r_{2}+1)m_{2}}\\
\mathbf{q}_{t}\end{matrix}\right)_{t\in[T]}\begin{array}[]{l}\in[-1,1]^{m_{1}}\\
\in[-1,1]^{m_{2}}\\
\in[-1,1]^{m_{1}}\\
\in[-1,1]^{(r_{1}-1)m_{1}}\\
\in[-1,1]^{m_{2}}\\
\in[-1,1]^{(r_{2}-1)m_{2}}\\
\left.\right.\\
\in[-1,1]^{N/2}\end{array},</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="A5.SS3.p5.5" class="ltx_p"><span id="A5.SS3.p5.5.1" class="ltx_text">we have</span></p>
<table id="A5.EGx137" class="ltx_equationgroup ltx_eqn_align ltx_eqn_table">

<tbody id="A5.Ex332"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_eqn_cell"></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A5.Ex332.m1" class="ltx_Math" alttext="\displaystyle\left\|\bm{\mu}_{2,0}\circ\bm{\nu}_{1,0}\big((\mathbf{x}_{t})_{t\in[T]}\big)-\bm{\mu}_{2,0}\circ\bm{\nu}_{1,0}\big((\mathbf{x}^{\prime}_{t})_{t\in[T]}\big)\right\|_{\infty,m_{1},m_{2}}" display="inline" intent=":literal"><semantics><msub><mrow><mo>‖</mo><mrow><mrow><mrow><msub><mi>𝝁</mi><mrow><mn>2</mn><mo>,</mo><mn>0</mn></mrow></msub><mo lspace="0.222em" rspace="0.222em">∘</mo><msub><mi>𝝂</mi><mrow><mn>1</mn><mo>,</mo><mn>0</mn></mrow></msub></mrow><mo lspace="0em" rspace="0em">​</mo><mrow><mo maxsize="1.200em" minsize="1.200em">(</mo><msub><mrow><mo stretchy="false">(</mo><msub><mi>𝐱</mi><mi>t</mi></msub><mo stretchy="false">)</mo></mrow><mrow><mi>t</mi><mo>∈</mo><mrow><mo stretchy="false">[</mo><mi>T</mi><mo stretchy="false">]</mo></mrow></mrow></msub><mo maxsize="1.200em" minsize="1.200em">)</mo></mrow></mrow><mo>−</mo><mrow><mrow><msub><mi>𝝁</mi><mrow><mn>2</mn><mo>,</mo><mn>0</mn></mrow></msub><mo lspace="0.222em" rspace="0.222em">∘</mo><msub><mi>𝝂</mi><mrow><mn>1</mn><mo>,</mo><mn>0</mn></mrow></msub></mrow><mo lspace="0em" rspace="0em">​</mo><mrow><mo maxsize="1.200em" minsize="1.200em">(</mo><msub><mrow><mo stretchy="false">(</mo><msubsup><mi>𝐱</mi><mi>t</mi><mo>′</mo></msubsup><mo stretchy="false">)</mo></mrow><mrow><mi>t</mi><mo>∈</mo><mrow><mo stretchy="false">[</mo><mi>T</mi><mo stretchy="false">]</mo></mrow></mrow></msub><mo maxsize="1.200em" minsize="1.200em">)</mo></mrow></mrow></mrow><mo>‖</mo></mrow><mrow><mi mathvariant="normal">∞</mi><mo>,</mo><msub><mi>m</mi><mn>1</mn></msub><mo>,</mo><msub><mi>m</mi><mn>2</mn></msub></mrow></msub><annotation encoding="application/x-tex">\displaystyle\left\|\bm{\mu}_{2,0}\circ\bm{\nu}_{1,0}\big((\mathbf{x}_{t})_{t\in[T]}\big)-\bm{\mu}_{2,0}\circ\bm{\nu}_{1,0}\big((\mathbf{x}^{\prime}_{t})_{t\in[T]}\big)\right\|_{\infty,m_{1},m_{2}}</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
<tbody id="A5.Ex333"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_eqn_cell"></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A5.Ex333.m1" class="ltx_Math" alttext="\displaystyle=\big\|\mathbf{g}_{0}(\mathbf{x}_{4,T},\mathbf{x}_{1,T})-\mathbf{g}_{0}(\mathbf{x}^{\prime}_{4,T},\mathbf{x}^{\prime}_{1,T})\big\|_{\infty}\vee\big\|\mathbf{v}\big((\mathbf{x}_{t})_{t\in[T]}\big)-\mathbf{v}\big((\mathbf{x}^{\prime}_{t})_{t\in[T]}\big)\big\|_{\infty}" display="inline" intent=":literal"><semantics><mrow><mphantom></mphantom><mo>=</mo><mrow><msub><mrow><mo maxsize="1.200em" minsize="1.200em" stretchy="true">‖</mo><mrow><mrow><msub><mi>𝐠</mi><mn>0</mn></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mi>𝐱</mi><mrow><mn>4</mn><mo>,</mo><mi>T</mi></mrow></msub><mo>,</mo><msub><mi>𝐱</mi><mrow><mn>1</mn><mo>,</mo><mi>T</mi></mrow></msub><mo stretchy="false">)</mo></mrow></mrow><mo>−</mo><mrow><msub><mi>𝐠</mi><mn>0</mn></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msubsup><mi>𝐱</mi><mrow><mn>4</mn><mo>,</mo><mi>T</mi></mrow><mo>′</mo></msubsup><mo>,</mo><msubsup><mi>𝐱</mi><mrow><mn>1</mn><mo>,</mo><mi>T</mi></mrow><mo>′</mo></msubsup><mo stretchy="false">)</mo></mrow></mrow></mrow><mo maxsize="1.200em" minsize="1.200em" stretchy="true">‖</mo></mrow><mi mathvariant="normal">∞</mi></msub><mo>∨</mo><msub><mrow><mo maxsize="1.200em" minsize="1.200em" stretchy="true">‖</mo><mrow><mrow><mi>𝐯</mi><mo>⁡</mo><mrow><mo maxsize="1.200em" minsize="1.200em">(</mo><msub><mrow><mo stretchy="false">(</mo><msub><mi>𝐱</mi><mi>t</mi></msub><mo stretchy="false">)</mo></mrow><mrow><mi>t</mi><mo>∈</mo><mrow><mo stretchy="false">[</mo><mi>T</mi><mo stretchy="false">]</mo></mrow></mrow></msub><mo maxsize="1.200em" minsize="1.200em">)</mo></mrow></mrow><mo>−</mo><mrow><mi>𝐯</mi><mo>⁡</mo><mrow><mo maxsize="1.200em" minsize="1.200em">(</mo><msub><mrow><mo stretchy="false">(</mo><msubsup><mi>𝐱</mi><mi>t</mi><mo>′</mo></msubsup><mo stretchy="false">)</mo></mrow><mrow><mi>t</mi><mo>∈</mo><mrow><mo stretchy="false">[</mo><mi>T</mi><mo stretchy="false">]</mo></mrow></mrow></msub><mo maxsize="1.200em" minsize="1.200em">)</mo></mrow></mrow></mrow><mo maxsize="1.200em" minsize="1.200em" stretchy="true">‖</mo></mrow><mi mathvariant="normal">∞</mi></msub></mrow></mrow><annotation encoding="application/x-tex">\displaystyle=\big\|\mathbf{g}_{0}(\mathbf{x}_{4,T},\mathbf{x}_{1,T})-\mathbf{g}_{0}(\mathbf{x}^{\prime}_{4,T},\mathbf{x}^{\prime}_{1,T})\big\|_{\infty}\vee\big\|\mathbf{v}\big((\mathbf{x}_{t})_{t\in[T]}\big)-\mathbf{v}\big((\mathbf{x}^{\prime}_{t})_{t\in[T]}\big)\big\|_{\infty}</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
<tbody id="A5.Ex334"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_eqn_cell"></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A5.Ex334.m1" class="ltx_Math" alttext="\displaystyle\lesssim\big\|\operatorname{stack}(\mathbf{x}_{4,T},\mathbf{x}_{1,T})-\operatorname{stack}(\mathbf{x}_{4,T}^{\prime},\mathbf{x}_{1,T}^{\prime})\big\|_{\infty}^{\beta_{1}\land 1}" display="inline" intent=":literal"><semantics><mrow><mphantom></mphantom><mo>≲</mo><msubsup><mrow><mo maxsize="1.200em" minsize="1.200em" stretchy="true">‖</mo><mrow><mrow><mi>stack</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><msub><mi>𝐱</mi><mrow><mn>4</mn><mo>,</mo><mi>T</mi></mrow></msub><mo>,</mo><msub><mi>𝐱</mi><mrow><mn>1</mn><mo>,</mo><mi>T</mi></mrow></msub><mo stretchy="false">)</mo></mrow></mrow><mo>−</mo><mrow><mi>stack</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><msubsup><mi>𝐱</mi><mrow><mn>4</mn><mo>,</mo><mi>T</mi></mrow><mo>′</mo></msubsup><mo>,</mo><msubsup><mi>𝐱</mi><mrow><mn>1</mn><mo>,</mo><mi>T</mi></mrow><mo>′</mo></msubsup><mo stretchy="false">)</mo></mrow></mrow></mrow><mo maxsize="1.200em" minsize="1.200em" stretchy="true">‖</mo></mrow><mi mathvariant="normal">∞</mi><mrow><msub><mi>β</mi><mn>1</mn></msub><mo>∧</mo><mn>1</mn></mrow></msubsup></mrow><annotation encoding="application/x-tex">\displaystyle\lesssim\big\|\operatorname{stack}(\mathbf{x}_{4,T},\mathbf{x}_{1,T})-\operatorname{stack}(\mathbf{x}_{4,T}^{\prime},\mathbf{x}_{1,T}^{\prime})\big\|_{\infty}^{\beta_{1}\land 1}</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
<tbody id="A5.Ex335"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
