<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A5.Ex335.m1" class="ltx_Math" alttext="\displaystyle\quad+\frac{1}{\lambda^{2}}\max_{t\in[\log^{2}T,T-\log^{2}T]\cup\{T\}}\big\|\operatorname{stack}(\mathbf{x}_{2,t},\mathbf{x}_{5,t},\mathbf{x}_{6,t})-\operatorname{stack}(\mathbf{x}^{\prime}_{2,t},\mathbf{x}^{\prime}_{5,t},\mathbf{x}^{\prime}_{6,t})\big\|_{\infty}" display="inline" intent=":literal"><semantics><mrow><mo>+</mo><mrow><mstyle displaystyle="true"><mfrac><mn>1</mn><msup><mi>λ</mi><mn>2</mn></msup></mfrac></mstyle><mo lspace="0.167em" rspace="0em">​</mo><munder><mi>max</mi><mrow><mi>t</mi><mo>∈</mo><mrow><mrow><mo stretchy="false">[</mo><mrow><mrow><msup><mi>log</mi><mn>2</mn></msup><mo lspace="0.167em">⁡</mo><mi>T</mi></mrow><mo>,</mo><mrow><mi>T</mi><mo>−</mo><mrow><msup><mi>log</mi><mn>2</mn></msup><mo lspace="0.167em">⁡</mo><mi>T</mi></mrow></mrow></mrow><mo stretchy="false">]</mo></mrow><mo>∪</mo><mrow><mo stretchy="false">{</mo><mi>T</mi><mo stretchy="false">}</mo></mrow></mrow></mrow></munder><mo lspace="0em" rspace="0em">​</mo><msub><mrow><mo maxsize="1.200em" minsize="1.200em" stretchy="true">‖</mo><mrow><mrow><mi>stack</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><msub><mi>𝐱</mi><mrow><mn>2</mn><mo>,</mo><mi>t</mi></mrow></msub><mo>,</mo><msub><mi>𝐱</mi><mrow><mn>5</mn><mo>,</mo><mi>t</mi></mrow></msub><mo>,</mo><msub><mi>𝐱</mi><mrow><mn>6</mn><mo>,</mo><mi>t</mi></mrow></msub><mo stretchy="false">)</mo></mrow></mrow><mo>−</mo><mrow><mi>stack</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><msubsup><mi>𝐱</mi><mrow><mn>2</mn><mo>,</mo><mi>t</mi></mrow><mo>′</mo></msubsup><mo>,</mo><msubsup><mi>𝐱</mi><mrow><mn>5</mn><mo>,</mo><mi>t</mi></mrow><mo>′</mo></msubsup><mo>,</mo><msubsup><mi>𝐱</mi><mrow><mn>6</mn><mo>,</mo><mi>t</mi></mrow><mo>′</mo></msubsup><mo stretchy="false">)</mo></mrow></mrow></mrow><mo maxsize="1.200em" minsize="1.200em" stretchy="true">‖</mo></mrow><mi mathvariant="normal">∞</mi></msub></mrow></mrow><annotation encoding="application/x-tex">\displaystyle\quad+\frac{1}{\lambda^{2}}\max_{t\in[\log^{2}T,T-\log^{2}T]\cup\{T\}}\big\|\operatorname{stack}(\mathbf{x}_{2,t},\mathbf{x}_{5,t},\mathbf{x}_{6,t})-\operatorname{stack}(\mathbf{x}^{\prime}_{2,t},\mathbf{x}^{\prime}_{5,t},\mathbf{x}^{\prime}_{6,t})\big\|_{\infty}</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
<tbody id="A5.Ex336"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_eqn_cell"></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A5.Ex336.m1" class="ltx_Math" alttext="\displaystyle\quad+\max_{t\in[\log^{2}T,T-\log^{2}T]}\big\|\operatorname{stack}(\mathbf{x}_{1,t},\mathbf{x}_{2,t})-\operatorname{stack}(\mathbf{x}^{\prime}_{1,t},\mathbf{x}^{\prime}_{2,t})\big\|_{\infty}" display="inline" intent=":literal"><semantics><mrow><mo rspace="0.167em">+</mo><mrow><munder><mi>max</mi><mrow><mi>t</mi><mo>∈</mo><mrow><mo stretchy="false">[</mo><mrow><mrow><msup><mi>log</mi><mn>2</mn></msup><mo lspace="0.167em">⁡</mo><mi>T</mi></mrow><mo>,</mo><mrow><mi>T</mi><mo>−</mo><mrow><msup><mi>log</mi><mn>2</mn></msup><mo lspace="0.167em">⁡</mo><mi>T</mi></mrow></mrow></mrow><mo stretchy="false">]</mo></mrow></mrow></munder><mo>⁡</mo><msub><mrow><mo maxsize="1.200em" minsize="1.200em" stretchy="true">‖</mo><mrow><mrow><mi>stack</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><msub><mi>𝐱</mi><mrow><mn>1</mn><mo>,</mo><mi>t</mi></mrow></msub><mo>,</mo><msub><mi>𝐱</mi><mrow><mn>2</mn><mo>,</mo><mi>t</mi></mrow></msub><mo stretchy="false">)</mo></mrow></mrow><mo>−</mo><mrow><mi>stack</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><msubsup><mi>𝐱</mi><mrow><mn>1</mn><mo>,</mo><mi>t</mi></mrow><mo>′</mo></msubsup><mo>,</mo><msubsup><mi>𝐱</mi><mrow><mn>2</mn><mo>,</mo><mi>t</mi></mrow><mo>′</mo></msubsup><mo stretchy="false">)</mo></mrow></mrow></mrow><mo maxsize="1.200em" minsize="1.200em" stretchy="true">‖</mo></mrow><mi mathvariant="normal">∞</mi></msub></mrow></mrow><annotation encoding="application/x-tex">\displaystyle\quad+\max_{t\in[\log^{2}T,T-\log^{2}T]}\big\|\operatorname{stack}(\mathbf{x}_{1,t},\mathbf{x}_{2,t})-\operatorname{stack}(\mathbf{x}^{\prime}_{1,t},\mathbf{x}^{\prime}_{2,t})\big\|_{\infty}</annotation></semantics></math></td>
