</section>
<section id="A5.SS3" class="ltx_subsection">
<h3 class="ltx_title ltx_title_subsection"><span class="ltx_tag ltx_tag_subsection">E.3 </span>Proof of Lemma <a href="#Thmconj25" title="Lemma 5. ‣ 5 Proof Sketch of the Upper Bound for the Approximation Error ‣ Generalization Bounds for Transformer-Based Next-Token Prediction in a Language Model" class="ltx_ref"><span class="ltx_text ltx_ref_tag">5</span></a></h3>

<div id="A5.SS3.p1" class="ltx_para">
<p id="A5.SS3.p1.1" class="ltx_p">Let</p>
<table id="A5.Ex299" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="A5.Ex299.m1" class="ltx_Math" alttext="M\coloneq\left[\begin{matrix}\bm{\phi}_{1}(\mathbf{X}_{1})&amp;\bm{\phi}_{1}(\mathbf{X}_{2})&amp;\cdots&amp;\bm{\phi}_{1}(\mathbf{X}_{T})\\
\bm{\phi}_{2}(\mathbf{X}_{1})&amp;\bm{\phi}_{2}(\mathbf{X}_{2})&amp;\cdots&amp;\bm{\phi}_{2}(\mathbf{X}_{T})\\
\bm{0}_{\tfrac{N}{2}-m_{1}-m_{2}}&amp;\bm{0}_{\tfrac{N}{2}-m_{1}-m_{2}}&amp;\cdots&amp;\bm{0}_{\tfrac{N}{2}-m_{1}-m_{2}}\\
\mathbf{q}_{1}&amp;\mathbf{q}_{2}&amp;\cdots&amp;\mathbf{q}_{T}\end{matrix}\right]=\left(\begin{matrix}\bm{\phi}_{1}(\mathbf{X}_{t})\\
\bm{\phi}_{2}(\mathbf{X}_{t})\\
\bm{0}_{\tfrac{N}{2}-m_{1}-m_{2}}\\
\mathbf{q}_{t}\end{matrix}\right)_{t\in[T]}\begin{array}[]{l}\in\mathbb{R}^{m_{1}}\\
\in\mathbb{R}^{m_{2}}\\
\left.\right.\\
\in\mathbb{R}^{N/2}\end{array}" display="block" intent=":literal"><semantics><mrow><mi>M</mi><mo>≔</mo><mrow><mo>[</mo><mtable columnspacing="5pt" displaystyle="true" rowspacing="0pt"><mtr><mtd><mrow><msub><mi class="ltx_mathvariant_bold-italic" mathvariant="bold-italic">ϕ</mi><mn>1</mn></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mi>𝐗</mi><mn>1</mn></msub><mo stretchy="false">)</mo></mrow></mrow></mtd><mtd><mrow><msub><mi class="ltx_mathvariant_bold-italic" mathvariant="bold-italic">ϕ</mi><mn>1</mn></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mi>𝐗</mi><mn>2</mn></msub><mo stretchy="false">)</mo></mrow></mrow></mtd><mtd><mo>⋯</mo></mtd><mtd><mrow><msub><mi class="ltx_mathvariant_bold-italic" mathvariant="bold-italic">ϕ</mi><mn>1</mn></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mi>𝐗</mi><mi>T</mi></msub><mo stretchy="false">)</mo></mrow></mrow></mtd></mtr><mtr><mtd><mrow><msub><mi class="ltx_mathvariant_bold-italic" mathvariant="bold-italic">ϕ</mi><mn>2</mn></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mi>𝐗</mi><mn>1</mn></msub><mo stretchy="false">)</mo></mrow></mrow></mtd><mtd><mrow><msub><mi class="ltx_mathvariant_bold-italic" mathvariant="bold-italic">ϕ</mi><mn>2</mn></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mi>𝐗</mi><mn>2</mn></msub><mo stretchy="false">)</mo></mrow></mrow></mtd><mtd><mo>⋯</mo></mtd><mtd><mrow><msub><mi class="ltx_mathvariant_bold-italic" mathvariant="bold-italic">ϕ</mi><mn>2</mn></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mi>𝐗</mi><mi>T</mi></msub><mo stretchy="false">)</mo></mrow></mrow></mtd></mtr><mtr><mtd><msub><mn>𝟎</mn><mrow><mstyle scriptlevel="-1"><mfrac><mi>N</mi><mn>2</mn></mfrac></mstyle><mo>−</mo><msub><mi>m</mi><mn>1</mn></msub><mo>−</mo><msub><mi>m</mi><mn>2</mn></msub></mrow></msub></mtd><mtd><msub><mn>𝟎</mn><mrow><mstyle scriptlevel="-1"><mfrac><mi>N</mi><mn>2</mn></mfrac></mstyle><mo>−</mo><msub><mi>m</mi><mn>1</mn></msub><mo>−</mo><msub><mi>m</mi><mn>2</mn></msub></mrow></msub></mtd><mtd><mo>⋯</mo></mtd><mtd><msub><mn>𝟎</mn><mrow><mstyle scriptlevel="-1"><mfrac><mi>N</mi><mn>2</mn></mfrac></mstyle><mo>−</mo><msub><mi>m</mi><mn>1</mn></msub><mo>−</mo><msub><mi>m</mi><mn>2</mn></msub></mrow></msub></mtd></mtr><mtr><mtd><msub><mi>𝐪</mi><mn>1</mn></msub></mtd><mtd><msub><mi>𝐪</mi><mn>2</mn></msub></mtd><mtd><mo>⋯</mo></mtd><mtd><msub><mi>𝐪</mi><mi>T</mi></msub></mtd></mtr></mtable><mo>]</mo></mrow><mo>=</mo><mrow><msub><mrow><mo>(</mo><mtable displaystyle="true" rowspacing="0pt"><mtr><mtd><mrow><msub><mi class="ltx_mathvariant_bold-italic" mathvariant="bold-italic">ϕ</mi><mn>1</mn></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mi>𝐗</mi><mi>t</mi></msub><mo stretchy="false">)</mo></mrow></mrow></mtd></mtr><mtr><mtd><mrow><msub><mi class="ltx_mathvariant_bold-italic" mathvariant="bold-italic">ϕ</mi><mn>2</mn></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mi>𝐗</mi><mi>t</mi></msub><mo stretchy="false">)</mo></mrow></mrow></mtd></mtr><mtr><mtd><msub><mn>𝟎</mn><mrow><mstyle scriptlevel="-1"><mfrac><mi>N</mi><mn>2</mn></mfrac></mstyle><mo>−</mo><msub><mi>m</mi><mn>1</mn></msub><mo>−</mo><msub><mi>m</mi><mn>2</mn></msub></mrow></msub></mtd></mtr><mtr><mtd><msub><mi>𝐪</mi><mi>t</mi></msub></mtd></mtr></mtable><mo>)</mo></mrow><mrow><mi>t</mi><mo>∈</mo><mrow><mo stretchy="false">[</mo><mi>T</mi><mo stretchy="false">]</mo></mrow></mrow></msub><mo lspace="0.167em" rspace="0em">​</mo><mtable displaystyle="true" rowspacing="0pt"><mtr><mtd class="ltx_align_left" columnalign="left"><mrow><mphantom></mphantom><mo>∈</mo><msup><mi>ℝ</mi><msub><mi>m</mi><mn>1</mn></msub></msup></mrow></mtd></mtr><mtr><mtd class="ltx_align_left" columnalign="left"><mrow><mphantom></mphantom><mo>∈</mo><msup><mi>ℝ</mi><msub><mi>m</mi><mn>2</mn></msub></msup></mrow></mtd></mtr><mtr><mtd class="ltx_align_left" columnalign="left"><mphantom></mphantom></mtd></mtr><mtr><mtd class="ltx_align_left" columnalign="left"><mrow><mphantom></mphantom><mo>∈</mo><msup><mi>ℝ</mi><mrow><mi>N</mi><mo>/</mo><mn>2</mn></mrow></msup></mrow></mtd></mtr></mtable></mrow></mrow><annotation encoding="application/x-tex">M\coloneq\left[\begin{matrix}\bm{\phi}_{1}(\mathbf{X}_{1})&amp;\bm{\phi}_{1}(\mathbf{X}_{2})&amp;\cdots&amp;\bm{\phi}_{1}(\mathbf{X}_{T})\\
\bm{\phi}_{2}(\mathbf{X}_{1})&amp;\bm{\phi}_{2}(\mathbf{X}_{2})&amp;\cdots&amp;\bm{\phi}_{2}(\mathbf{X}_{T})\\
\bm{0}_{\tfrac{N}{2}-m_{1}-m_{2}}&amp;\bm{0}_{\tfrac{N}{2}-m_{1}-m_{2}}&amp;\cdots&amp;\bm{0}_{\tfrac{N}{2}-m_{1}-m_{2}}\\
\mathbf{q}_{1}&amp;\mathbf{q}_{2}&amp;\cdots&amp;\mathbf{q}_{T}\end{matrix}\right]=\left(\begin{matrix}\bm{\phi}_{1}(\mathbf{X}_{t})\\
\bm{\phi}_{2}(\mathbf{X}_{t})\\
\bm{0}_{\tfrac{N}{2}-m_{1}-m_{2}}\\
\mathbf{q}_{t}\end{matrix}\right)_{t\in[T]}\begin{array}[]{l}\in\mathbb{R}^{m_{1}}\\
\in\mathbb{R}^{m_{2}}\\
\left.\right.\\
\in\mathbb{R}^{N/2}\end{array}</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="A5.SS3.p1.2" class="ltx_p">and introduce
<math id="A5.SS3.p1.m1" class="ltx_Math" alttext="\bm{\mu}_{1,0}:\mathbb{R}^{N\times T}\rightarrow\mathbb{R}^{N\times T}" display="inline" intent=":literal"><semantics><mrow><msub><mi>𝝁</mi><mrow><mn>1</mn><mo>,</mo><mn>0</mn></mrow></msub><mo lspace="0.278em" rspace="0.278em">:</mo><mrow><msup><mi>ℝ</mi><mrow><mi>N</mi><mo lspace="0.222em" rspace="0.222em">×</mo><mi>T</mi></mrow></msup><mo stretchy="false">→</mo><msup><mi>ℝ</mi><mrow><mi>N</mi><mo lspace="0.222em" rspace="0.222em">×</mo><mi>T</mi></mrow></msup></mrow></mrow><annotation encoding="application/x-tex">\bm{\mu}_{1,0}:\mathbb{R}^{N\times T}\rightarrow\mathbb{R}^{N\times T}</annotation></semantics></math>,</p>
