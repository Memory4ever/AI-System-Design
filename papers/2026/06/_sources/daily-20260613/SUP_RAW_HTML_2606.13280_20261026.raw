<section id="A1" class="ltx_appendix">
<h2 class="ltx_title ltx_title_appendix"><span class="ltx_tag ltx_tag_appendix">Appendix A </span>Additional Notation</h2>

<div id="A1.p1" class="ltx_para">
<p id="A1.p1.1" class="ltx_p">We denote by <math id="A1.p1.m1" class="ltx_Math" alttext="O_{d_{1}\times d_{2}}" display="inline" intent=":literal"><semantics><msub><mi>O</mi><mrow><msub><mi>d</mi><mn>1</mn></msub><mo lspace="0.222em" rspace="0.222em">×</mo><msub><mi>d</mi><mn>2</mn></msub></mrow></msub><annotation encoding="application/x-tex">O_{d_{1}\times d_{2}}</annotation></semantics></math> the <math id="A1.p1.m2" class="ltx_Math" alttext="d_{1}\times d_{2}" display="inline" intent=":literal"><semantics><mrow><msub><mi>d</mi><mn>1</mn></msub><mo lspace="0.222em" rspace="0.222em">×</mo><msub><mi>d</mi><mn>2</mn></msub></mrow><annotation encoding="application/x-tex">d_{1}\times d_{2}</annotation></semantics></math> zero matrix and by
<math id="A1.p1.m3" class="ltx_Math" alttext="I_{d}" display="inline" intent=":literal"><semantics><msub><mi>I</mi><mi>d</mi></msub><annotation encoding="application/x-tex">I_{d}</annotation></semantics></math> the <math id="A1.p1.m4" class="ltx_Math" alttext="d\times d" display="inline" intent=":literal"><semantics><mrow><mi>d</mi><mo lspace="0.222em" rspace="0.222em">×</mo><mi>d</mi></mrow><annotation encoding="application/x-tex">d\times d</annotation></semantics></math> identity matrix.
We use <math id="A1.p1.m5" class="ltx_Math" alttext="x_{+}\coloneqq x\vee 0" display="inline" intent=":literal"><semantics><mrow><msub><mi>x</mi><mo>+</mo></msub><mo>≔</mo><mrow><mi>x</mi><mo>∨</mo><mn>0</mn></mrow></mrow><annotation encoding="application/x-tex">x_{+}\coloneqq x\vee 0</annotation></semantics></math>.
We denote the inner product by <math id="A1.p1.m6" class="ltx_Math" alttext="\langle\mathbf{u},\mathbf{v}\rangle\coloneqq\mathbf{u}^{\top}\mathbf{v}" display="inline" intent=":literal"><semantics><mrow><mrow><mo stretchy="false">⟨</mo><mrow><mi>𝐮</mi><mo>,</mo><mi>𝐯</mi></mrow><mo stretchy="false">⟩</mo></mrow><mo>≔</mo><mrow><msup><mi>𝐮</mi><mo>⊤</mo></msup><mo lspace="0em" rspace="0em">​</mo><mi>𝐯</mi></mrow></mrow><annotation encoding="application/x-tex">\langle\mathbf{u},\mathbf{v}\rangle\coloneqq\mathbf{u}^{\top}\mathbf{v}</annotation></semantics></math>.
For notational simplicity, given vectors <math id="A1.p1.m7" class="ltx_Math" alttext="\mathbf{v}_{1}\in\mathbb{R}^{d_{1}}" display="inline" intent=":literal"><semantics><mrow><msub><mi>𝐯</mi><mn>1</mn></msub><mo>∈</mo><msup><mi>ℝ</mi><msub><mi>d</mi><mn>1</mn></msub></msup></mrow><annotation encoding="application/x-tex">\mathbf{v}_{1}\in\mathbb{R}^{d_{1}}</annotation></semantics></math> and <math id="A1.p1.m8" class="ltx_Math" alttext="\mathbf{v}_{2}\in\mathbb{R}^{d_{2}}" display="inline" intent=":literal"><semantics><mrow><msub><mi>𝐯</mi><mn>2</mn></msub><mo>∈</mo><msup><mi>ℝ</mi><msub><mi>d</mi><mn>2</mn></msub></msup></mrow><annotation encoding="application/x-tex">\mathbf{v}_{2}\in\mathbb{R}^{d_{2}}</annotation></semantics></math> and a function <math id="A1.p1.m9" class="ltx_Math" alttext="\mathbf{f}:\mathbb{R}^{d_{1}+d_{2}}\rightarrow\mathbb{R}^{m}" display="inline" intent=":literal"><semantics><mrow><mi>𝐟</mi><mo lspace="0.278em" rspace="0.278em">:</mo><mrow><msup><mi>ℝ</mi><mrow><msub><mi>d</mi><mn>1</mn></msub><mo>+</mo><msub><mi>d</mi><mn>2</mn></msub></mrow></msup><mo stretchy="false">→</mo><msup><mi>ℝ</mi><mi>m</mi></msup></mrow></mrow><annotation encoding="application/x-tex">\mathbf{f}:\mathbb{R}^{d_{1}+d_{2}}\rightarrow\mathbb{R}^{m}</annotation></semantics></math>, we write <math id="A1.p1.m10" class="ltx_Math" alttext="\mathbf{f}(\mathbf{v}_{1},\mathbf{v}_{2})" display="inline" intent=":literal"><semantics><mrow><mi>𝐟</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><msub><mi>𝐯</mi><mn>1</mn></msub><mo>,</mo><msub><mi>𝐯</mi><mn>2</mn></msub><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">\mathbf{f}(\mathbf{v}_{1},\mathbf{v}_{2})</annotation></semantics></math> for <math id="A1.p1.m11" class="ltx_Math" alttext="\mathbf{f}(\operatorname{stack}(\mathbf{v}_{1},\mathbf{v}_{2}))" display="inline" intent=":literal"><semantics><mrow><mi>𝐟</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mrow><mi>stack</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><msub><mi>𝐯</mi><mn>1</mn></msub><mo>,</mo><msub><mi>𝐯</mi><mn>2</mn></msub><mo stretchy="false">)</mo></mrow></mrow><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">\mathbf{f}(\operatorname{stack}(\mathbf{v}_{1},\mathbf{v}_{2}))</annotation></semantics></math>.
For vectors <math id="A1.p1.m12" class="ltx_Math" alttext="\{\bm{\psi}_{j}\}_{j\in I}" display="inline" intent=":literal"><semantics><msub><mrow><mo stretchy="false">{</mo><msub><mi>𝝍</mi><mi>j</mi></msub><mo stretchy="false">}</mo></mrow><mrow><mi>j</mi><mo>∈</mo><mi>I</mi></mrow></msub><annotation encoding="application/x-tex">\{\bm{\psi}_{j}\}_{j\in I}</annotation></semantics></math> and nonnegative scalars <math id="A1.p1.m13" class="ltx_math_unparsed" alttext="\{a_{j}&gt;0\}_{j\in I}" display="inline" intent=":literal"><semantics><msub><mrow><mo stretchy="false">{</mo><msub><mi>a</mi><mi>j</mi></msub><mo>&gt;</mo><mn>0</mn><mo stretchy="false">}</mo></mrow><mrow><mi>j</mi><mo>∈</mo><mi>I</mi></mrow></msub><annotation encoding="application/x-tex">\{a_{j}&gt;0\}_{j\in I}</annotation></semantics></math>,
we introduce</p>
<table id="A1.EGx37" class="ltx_equationgroup ltx_eqn_align ltx_eqn_table">

<tbody id="A1.E29"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_align_right ltx_eqn_cell"><math id="A1.E29.m1" class="ltx_Math" alttext="\displaystyle\overline{\sum}_{j\in I}(a_{j};\bm{\psi}_{j})\coloneq\sum_{j\in I}\frac{a_{j}}{\sum_{i\in I}a_{i}}\bm{\psi}_{j}" display="inline" intent=":literal"><semantics><mrow><mrow><msub><mover accent="true"><mstyle displaystyle="true"><mo movablelimits="false">∑</mo></mstyle><mo stretchy="true">¯</mo></mover><mrow><mi>j</mi><mo>∈</mo><mi>I</mi></mrow></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mi>a</mi><mi>j</mi></msub><mo>,</mo><msub><mi>𝝍</mi><mi>j</mi></msub><mo stretchy="false">)</mo></mrow></mrow><mo>≔</mo><mrow><mstyle displaystyle="true"><munder><mo movablelimits="false">∑</mo><mrow><mi>j</mi><mo>∈</mo><mi>I</mi></mrow></munder></mstyle><mrow><mstyle displaystyle="true"><mfrac><msub><mi>a</mi><mi>j</mi></msub><mrow><msub><mo>∑</mo><mrow><mi>i</mi><mo>∈</mo><mi>I</mi></mrow></msub><msub><mi>a</mi><mi>i</mi></msub></mrow></mfrac></mstyle><mo lspace="0em" rspace="0em">​</mo><msub><mi>𝝍</mi><mi>j</mi></msub></mrow></mrow></mrow><annotation encoding="application/x-tex">\displaystyle\overline{\sum}_{j\in I}(a_{j};\bm{\psi}_{j})\coloneq\sum_{j\in I}\frac{a_{j}}{\sum_{i\in I}a_{i}}\bm{\psi}_{j}</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td>
<td rowspan="1" class="ltx_eqn_cell ltx_eqn_eqno ltx_align_middle ltx_align_right"><span class="ltx_tag ltx_tag_equation ltx_align_right">(29)</span></td></tr></tbody>
</table>
<p id="A1.p1.2" class="ltx_p">a more compact notation for the weighted average of <math id="A1.p1.m14" class="ltx_Math" alttext="\{\bm{\psi}_{j}\}_{j\in I}" display="inline" intent=":literal"><semantics><msub><mrow><mo stretchy="false">{</mo><msub><mi>𝝍</mi><mi>j</mi></msub><mo stretchy="false">}</mo></mrow><mrow><mi>j</mi><mo>∈</mo><mi>I</mi></mrow></msub><annotation encoding="application/x-tex">\{\bm{\psi}_{j}\}_{j\in I}</annotation></semantics></math> with normalized weights.</p>
</div>
</section>
<section id="A2" class="ltx_appendix">
<h2 class="ltx_title ltx_title_appendix"><span class="ltx_tag ltx_tag_appendix">Appendix B </span>Discussion about Assumption <a href="#Thmassumpt1" title="Assumption 1. ‣ 4 Risk bound ‣ Generalization Bounds for Transformer-Based Next-Token Prediction in a Language Model" class="ltx_ref"><span class="ltx_text ltx_ref_tag">1</span></a></h2>

<div id="A2.p1" class="ltx_para">
<p id="A2.p1.1" class="ltx_p">In this section, we analyze the function <math id="A2.p1.m1" class="ltx_Math" alttext="\varphi_{W}(\cdot)" display="inline" intent=":literal"><semantics><mrow><msub><mi>φ</mi><mi>W</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mo lspace="0em" rspace="0em">⋅</mo><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">\varphi_{W}(\cdot)</annotation></semantics></math> and the quantity <math id="A2.p1.m2" class="ltx_Math" alttext="\kappa_{W}" display="inline" intent=":literal"><semantics><msub><mi>κ</mi><mi>W</mi></msub><annotation encoding="application/x-tex">\kappa_{W}</annotation></semantics></math> from Definition <a href="#S4.Thmconj1" title="Definition 4.1. ‣ 4 Risk bound ‣ Generalization Bounds for Transformer-Based Next-Token Prediction in a Language Model" class="ltx_ref"><span class="ltx_text ltx_ref_tag">4.1</span></a>.
For notational simplicity, let <math id="A2.p1.m3" class="ltx_Math" alttext="m\coloneqq m_{2}\geq 3" display="inline" intent=":literal"><semantics><mrow><mi>m</mi><mo>≔</mo><msub><mi>m</mi><mn>2</mn></msub><mo>≥</mo><mn>3</mn></mrow><annotation encoding="application/x-tex">m\coloneqq m_{2}\geq 3</annotation></semantics></math> and <math id="A2.p1.m4" class="ltx_Math" alttext="\delta\coloneqq\delta_{2}&gt;0" display="inline" intent=":literal"><semantics><mrow><mi>δ</mi><mo>≔</mo><msub><mi>δ</mi><mn>2</mn></msub><mo>&gt;</mo><mn>0</mn></mrow><annotation encoding="application/x-tex">\delta\coloneqq\delta_{2}&gt;0</annotation></semantics></math>.
Suppose that <math id="A2.p1.m5" class="ltx_Math" alttext="\bm{\phi}_{2}(\mathbf{e}_{1}),\ldots,\bm{\phi}_{2}(\mathbf{e}_{W})" display="inline" intent=":literal"><semantics><mrow><mrow><msub><mi class="ltx_mathvariant_bold-italic" mathvariant="bold-italic">ϕ</mi><mn>2</mn></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mi>𝐞</mi><mn>1</mn></msub><mo stretchy="false">)</mo></mrow></mrow><mo>,</mo><mi mathvariant="normal">…</mi><mo>,</mo><mrow><msub><mi class="ltx_mathvariant_bold-italic" mathvariant="bold-italic">ϕ</mi><mn>2</mn></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mi>𝐞</mi><mi>W</mi></msub><mo stretchy="false">)</mo></mrow></mrow></mrow><annotation encoding="application/x-tex">\bm{\phi}_{2}(\mathbf{e}_{1}),\ldots,\bm{\phi}_{2}(\mathbf{e}_{W})</annotation></semantics></math> are independent and identically distributed according to the uniform distribution on <math id="A2.p1.m6" class="ltx_Math" alttext="\mathbb{S}^{m-1}" display="inline" intent=":literal"><semantics><msup><mi>𝕊</mi><mrow><mi>m</mi><mo>−</mo><mn>1</mn></mrow></msup><annotation encoding="application/x-tex">\mathbb{S}^{m-1}</annotation></semantics></math>.
Then, letting <math id="A2.p1.m7" class="ltx_Math" alttext="\mathbf{Z},\mathbf{Z}_{1},\ldots,\mathbf{Z}_{W}\in\mathbb{S}^{m-1}" display="inline" intent=":literal"><semantics><mrow><mi>𝐙</mi><mo>,</mo><msub><mi>𝐙</mi><mn>1</mn></msub><mo>,</mo><mi mathvariant="normal">…</mi><mo>,</mo><mrow><msub><mi>𝐙</mi><mi>W</mi></msub><mo>∈</mo><msup><mi>𝕊</mi><mrow><mi>m</mi><mo>−</mo><mn>1</mn></mrow></msup></mrow></mrow><annotation encoding="application/x-tex">\mathbf{Z},\mathbf{Z}_{1},\ldots,\mathbf{Z}_{W}\in\mathbb{S}^{m-1}</annotation></semantics></math> be samples from the same distribution, we can rewrite <math id="A2.p1.m8" class="ltx_Math" alttext="\varphi_{W}(\epsilon)" display="inline" intent=":literal"><semantics><mrow><msub><mi>φ</mi><mi>W</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>ϵ</mi><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">\varphi_{W}(\epsilon)</annotation></semantics></math> and <math id="A2.p1.m9" class="ltx_Math" alttext="\kappa_{W}" display="inline" intent=":literal"><semantics><msub><mi>κ</mi><mi>W</mi></msub><annotation encoding="application/x-tex">\kappa_{W}</annotation></semantics></math> as</p>
<table id="A2.Ex74" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="A2.Ex74.m1" class="ltx_Math" alttext="\varphi_{W}(\epsilon)=\inf_{w\in[W]}\frac{1}{W}\Big|\big\{{w^{\prime}}\in[W]:\|\mathbf{Z}_{w}-\mathbf{Z}_{w^{\prime}}\|_{2}\leq\epsilon\big\}\Big|" display="block" intent=":literal"><semantics><mrow><mrow><msub><mi>φ</mi><mi>W</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>ϵ</mi><mo stretchy="false">)</mo></mrow></mrow><mo rspace="0.1389em">=</mo><mrow><munder><mo lspace="0.1389em" movablelimits="false" rspace="0.167em">inf</mo><mrow><mi>w</mi><mo>∈</mo><mrow><mo stretchy="false">[</mo><mi>W</mi><mo stretchy="false">]</mo></mrow></mrow></munder><mrow><mfrac><mn>1</mn><mi>W</mi></mfrac><mo lspace="0em" rspace="0em">​</mo><mrow><mo maxsize="1.600em" minsize="1.600em" stretchy="true">|</mo><mrow><mo stretchy="false">{</mo><mrow><msup><mi>w</mi><mo>′</mo></msup><mo>∈</mo><mrow><mo stretchy="false">[</mo><mi>W</mi><mo rspace="0.278em" stretchy="false">]</mo></mrow></mrow><mo rspace="0.278em">:</mo><mrow><msub><mrow><mo stretchy="false">‖</mo><mrow><msub><mi>𝐙</mi><mi>w</mi></msub><mo>−</mo><msub><mi>𝐙</mi><msup><mi>w</mi><mo>′</mo></msup></msub></mrow><mo stretchy="false">‖</mo></mrow><mn>2</mn></msub><mo>≤</mo><mi>ϵ</mi></mrow><mo stretchy="false">}</mo></mrow><mo maxsize="1.600em" minsize="1.600em" stretchy="true">|</mo></mrow></mrow></mrow></mrow><annotation encoding="application/x-tex">\varphi_{W}(\epsilon)=\inf_{w\in[W]}\frac{1}{W}\Big|\big\{{w^{\prime}}\in[W]:\|\mathbf{Z}_{w}-\mathbf{Z}_{w^{\prime}}\|_{2}\leq\epsilon\big\}\Big|</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="A2.p1.2" class="ltx_p">and</p>
<table id="A2.Ex75" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="A2.Ex75.m1" class="ltx_Math" alttext="\kappa_{W}=\sup_{\mathbf{v}\in\delta\mathbb{S}^{m-1}}\left\|\frac{\sum_{w=1}^{W}\exp(\mathbf{v}^{\top}\mathbf{Z}_{w})\mathbf{Z}_{w}}{\sum_{w=1}^{W}\exp(\mathbf{v}^{\top}\mathbf{Z}_{w})}-\frac{\mathbb{E}\left[\exp(\mathbf{v}^{\top}\mathbf{Z})\mathbf{Z}\right]}{\mathbb{E}\left[\exp(\mathbf{v}^{\top}\mathbf{Z})\right]}\right\|_{2}." display="block" intent=":literal"><semantics><mrow><mrow><msub><mi>κ</mi><mi>W</mi></msub><mo rspace="0.1389em">=</mo><mrow><munder><mo lspace="0.1389em" movablelimits="false" rspace="0em">sup</mo><mrow><mi>𝐯</mi><mo>∈</mo><mrow><mi>δ</mi><mo lspace="0em" rspace="0em">​</mo><msup><mi>𝕊</mi><mrow><mi>m</mi><mo>−</mo><mn>1</mn></mrow></msup></mrow></mrow></munder><msub><mrow><mo>‖</mo><mrow><mfrac><mrow><msubsup><mo>∑</mo><mrow><mi>w</mi><mo>=</mo><mn>1</mn></mrow><mi>W</mi></msubsup><mrow><mrow><mi>exp</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mrow><msup><mi>𝐯</mi><mo>⊤</mo></msup><mo lspace="0em" rspace="0em">​</mo><msub><mi>𝐙</mi><mi>w</mi></msub></mrow><mo stretchy="false">)</mo></mrow></mrow><mo lspace="0em" rspace="0em">​</mo><msub><mi>𝐙</mi><mi>w</mi></msub></mrow></mrow><mrow><msubsup><mo>∑</mo><mrow><mi>w</mi><mo>=</mo><mn>1</mn></mrow><mi>W</mi></msubsup><mrow><mi>exp</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mrow><msup><mi>𝐯</mi><mo>⊤</mo></msup><mo lspace="0em" rspace="0em">​</mo><msub><mi>𝐙</mi><mi>w</mi></msub></mrow><mo stretchy="false">)</mo></mrow></mrow></mrow></mfrac><mo>−</mo><mfrac><mrow><mi>𝔼</mi><mo>⁡</mo><mrow><mo>[</mo><mrow><mrow><mi>exp</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mrow><msup><mi>𝐯</mi><mo>⊤</mo></msup><mo lspace="0em" rspace="0em">​</mo><mi>𝐙</mi></mrow><mo stretchy="false">)</mo></mrow></mrow><mo lspace="0em" rspace="0em">​</mo><mi>𝐙</mi></mrow><mo>]</mo></mrow></mrow><mrow><mi>𝔼</mi><mo>⁡</mo><mrow><mo>[</mo><mrow><mi>exp</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mrow><msup><mi>𝐯</mi><mo>⊤</mo></msup><mo lspace="0em" rspace="0em">​</mo><mi>𝐙</mi></mrow><mo stretchy="false">)</mo></mrow></mrow><mo>]</mo></mrow></mrow></mfrac></mrow><mo>‖</mo></mrow><mn>2</mn></msub></mrow></mrow><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">\kappa_{W}=\sup_{\mathbf{v}\in\delta\mathbb{S}^{m-1}}\left\|\frac{\sum_{w=1}^{W}\exp(\mathbf{v}^{\top}\mathbf{Z}_{w})\mathbf{Z}_{w}}{\sum_{w=1}^{W}\exp(\mathbf{v}^{\top}\mathbf{Z}_{w})}-\frac{\mathbb{E}\left[\exp(\mathbf{v}^{\top}\mathbf{Z})\mathbf{Z}\right]}{\mathbb{E}\left[\exp(\mathbf{v}^{\top}\mathbf{Z})\right]}\right\|_{2}.</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="A2.p1.3" class="ltx_p">It is sufficient to show that</p>
<table id="A2.EGx38" class="ltx_equationgroup ltx_eqn_align ltx_eqn_table">

<tbody id="A2.E30"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_align_right ltx_eqn_cell"><math id="A2.E30.m1" class="ltx_Math" alttext="\displaystyle\mathbb{P}\Big(\varphi_{W}(\epsilon)\geq\epsilon^{m-1}\log^{-1}(\epsilon^{-1})\Big)\xrightarrow[W\rightarrow\infty]{}1" display="inline" intent=":literal"><semantics><mrow><mrow><mi>ℙ</mi><mo>⁡</mo><mrow><mo maxsize="1.600em" minsize="1.600em">(</mo><mrow><mrow><msub><mi>φ</mi><mi>W</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>ϵ</mi><mo stretchy="false">)</mo></mrow></mrow><mo>≥</mo><mrow><msup><mi>ϵ</mi><mrow><mi>m</mi><mo>−</mo><mn>1</mn></mrow></msup><mo lspace="0.167em" rspace="0em">​</mo><mrow><msup><mi>log</mi><mrow><mo>−</mo><mn>1</mn></mrow></msup><mo>⁡</mo><mrow><mo stretchy="false">(</mo><msup><mi>ϵ</mi><mrow><mo>−</mo><mn>1</mn></mrow></msup><mo stretchy="false">)</mo></mrow></mrow></mrow></mrow><mo maxsize="1.600em" minsize="1.600em">)</mo></mrow></mrow><munderover accent="true" accentunder="true"><mo>→</mo><mrow><mi mathsize="0.700em">W</mi><mo mathsize="0.700em" stretchy="false">→</mo><mi mathsize="0.700em" mathvariant="normal">∞</mi></mrow><mphantom></mphantom></munderover><mn>1</mn></mrow><annotation encoding="application/x-tex">\displaystyle\mathbb{P}\Big(\varphi_{W}(\epsilon)\geq\epsilon^{m-1}\log^{-1}(\epsilon^{-1})\Big)\xrightarrow[W\rightarrow\infty]{}1</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td>
<td rowspan="1" class="ltx_eqn_cell ltx_eqn_eqno ltx_align_middle ltx_align_right"><span class="ltx_tag ltx_tag_equation ltx_align_right">(30)</span></td></tr></tbody>
</table>
<p id="A2.p1.4" class="ltx_p">for <math id="A2.p1.m10" class="ltx_Math" alttext="W^{-\frac{1}{m-1}}\log W\leq\epsilon\ll 1" display="inline" intent=":literal"><semantics><mrow><mrow><msup><mi>W</mi><mrow><mo>−</mo><mfrac><mn>1</mn><mrow><mi>m</mi><mo>−</mo><mn>1</mn></mrow></mfrac></mrow></msup><mo lspace="0.167em" rspace="0em">​</mo><mrow><mi>log</mi><mo lspace="0.167em">⁡</mo><mi>W</mi></mrow></mrow><mo>≤</mo><mi>ϵ</mi><mo>≪</mo><mn>1</mn></mrow><annotation encoding="application/x-tex">W^{-\frac{1}{m-1}}\log W\leq\epsilon\ll 1</annotation></semantics></math>
and</p>
<table id="A2.EGx39" class="ltx_equationgroup ltx_eqn_align ltx_eqn_table">

<tbody id="A2.E31"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_align_right ltx_eqn_cell"><math id="A2.E31.m1" class="ltx_Math" alttext="\displaystyle\mathbb{P}\Big(\kappa_{W}\leq\log W/\sqrt{W}\Big)\xrightarrow[W\rightarrow\infty]{}1." display="inline" intent=":literal"><semantics><mrow><mrow><mrow><mi>ℙ</mi><mo>⁡</mo><mrow><mo maxsize="1.600em" minsize="1.600em">(</mo><mrow><msub><mi>κ</mi><mi>W</mi></msub><mo>≤</mo><mrow><mrow><mi>log</mi><mo lspace="0.167em">⁡</mo><mi>W</mi></mrow><mo>/</mo><msqrt><mi>W</mi></msqrt></mrow></mrow><mo maxsize="1.600em" minsize="1.600em">)</mo></mrow></mrow><munderover accent="true" accentunder="true"><mo>→</mo><mrow><mi mathsize="0.700em">W</mi><mo mathsize="0.700em" stretchy="false">→</mo><mi mathsize="0.700em" mathvariant="normal">∞</mi></mrow><mphantom></mphantom></munderover><mn>1</mn></mrow><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">\displaystyle\mathbb{P}\Big(\kappa_{W}\leq\log W/\sqrt{W}\Big)\xrightarrow[W\rightarrow\infty]{}1.</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td>
<td rowspan="1" class="ltx_eqn_cell ltx_eqn_eqno ltx_align_middle ltx_align_right"><span class="ltx_tag ltx_tag_equation ltx_align_right">(31)</span></td></tr></tbody>
</table>
</div>
<div id="A2.p2" class="ltx_para">
<p id="A2.p2.1" class="ltx_p">Because of</p>
<table id="A2.EGx40" class="ltx_equationgroup ltx_eqn_align ltx_eqn_table">

<tbody id="A2.E32"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_align_right ltx_eqn_cell"><math id="A2.E32.m1" class="ltx_Math" alttext="\displaystyle\varphi_{W}(\epsilon)\geq\inf_{\mathbf{z}\in\mathbb{S}^{m-1}}\frac{1}{W}\Big|\big\{{w^{\prime}}\in[W]:\|\mathbf{z}-\mathbf{Z}_{w^{\prime}}\|_{2}\leq\epsilon\big\}\Big|." display="inline" intent=":literal"><semantics><mrow><mrow><mrow><msub><mi>φ</mi><mi>W</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>ϵ</mi><mo stretchy="false">)</mo></mrow></mrow><mo rspace="0.1389em">≥</mo><mrow><munder><mo lspace="0.1389em" movablelimits="false" rspace="0.167em">inf</mo><mrow><mi>𝐳</mi><mo>∈</mo><msup><mi>𝕊</mi><mrow><mi>m</mi><mo>−</mo><mn>1</mn></mrow></msup></mrow></munder><mrow><mstyle displaystyle="true"><mfrac><mn>1</mn><mi>W</mi></mfrac></mstyle><mo lspace="0em" rspace="0em">​</mo><mrow><mo maxsize="1.600em" minsize="1.600em" stretchy="true">|</mo><mrow><mo stretchy="false">{</mo><mrow><msup><mi>w</mi><mo>′</mo></msup><mo>∈</mo><mrow><mo stretchy="false">[</mo><mi>W</mi><mo rspace="0.278em" stretchy="false">]</mo></mrow></mrow><mo rspace="0.278em">:</mo><mrow><msub><mrow><mo stretchy="false">‖</mo><mrow><mi>𝐳</mi><mo>−</mo><msub><mi>𝐙</mi><msup><mi>w</mi><mo>′</mo></msup></msub></mrow><mo stretchy="false">‖</mo></mrow><mn>2</mn></msub><mo>≤</mo><mi>ϵ</mi></mrow><mo stretchy="false">}</mo></mrow><mo maxsize="1.600em" minsize="1.600em" stretchy="true">|</mo></mrow></mrow></mrow></mrow><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">\displaystyle\varphi_{W}(\epsilon)\geq\inf_{\mathbf{z}\in\mathbb{S}^{m-1}}\frac{1}{W}\Big|\big\{{w^{\prime}}\in[W]:\|\mathbf{z}-\mathbf{Z}_{w^{\prime}}\|_{2}\leq\epsilon\big\}\Big|.</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td>
<td rowspan="1" class="ltx_eqn_cell ltx_eqn_eqno ltx_align_middle ltx_align_right"><span class="ltx_tag ltx_tag_equation ltx_align_right">(32)</span></td></tr></tbody>
</table>
<p id="A2.p2.2" class="ltx_p">(<a href="#A2.E30" title="In Appendix B Discussion about Assumption ‣ Generalization Bounds for Transformer-Based Next-Token Prediction in a Language Model" class="ltx_ref"><span class="ltx_text ltx_ref_tag">30</span></a>) follows if we can establish</p>
<table id="A2.Ex76" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="A2.Ex76.m1" class="ltx_Math" alttext="\mathbb{P}\left(\inf_{\mathbf{z}\in\mathbb{S}^{m-1}}\Big|\big\{{w}\in[W]:\|\mathbf{Z}_{w}-\mathbf{z}\|_{2}\leq\epsilon\big\}\Big|\leq W\epsilon^{m-1}\log^{-1}(\epsilon^{-1})\right)\xrightarrow[W\rightarrow\infty]{}0." display="block" intent=":literal"><semantics><mrow><mrow><mrow><mi>ℙ</mi><mo>⁡</mo><mrow><mo>(</mo><mrow><mrow><munder><mo lspace="0em" movablelimits="false" rspace="0em">inf</mo><mrow><mi>𝐳</mi><mo>∈</mo><msup><mi>𝕊</mi><mrow><mi>m</mi><mo>−</mo><mn>1</mn></mrow></msup></mrow></munder><mrow><mo maxsize="1.600em" minsize="1.600em" stretchy="true">|</mo><mrow><mo stretchy="false">{</mo><mrow><mi>w</mi><mo>∈</mo><mrow><mo stretchy="false">[</mo><mi>W</mi><mo rspace="0.278em" stretchy="false">]</mo></mrow></mrow><mo rspace="0.278em">:</mo><mrow><msub><mrow><mo stretchy="false">‖</mo><mrow><msub><mi>𝐙</mi><mi>w</mi></msub><mo>−</mo><mi>𝐳</mi></mrow><mo stretchy="false">‖</mo></mrow><mn>2</mn></msub><mo>≤</mo><mi>ϵ</mi></mrow><mo stretchy="false">}</mo></mrow><mo maxsize="1.600em" minsize="1.600em" stretchy="true">|</mo></mrow></mrow><mo>≤</mo><mrow><mi>W</mi><mo lspace="0em" rspace="0em">​</mo><msup><mi>ϵ</mi><mrow><mi>m</mi><mo>−</mo><mn>1</mn></mrow></msup><mo lspace="0.167em" rspace="0em">​</mo><mrow><msup><mi>log</mi><mrow><mo>−</mo><mn>1</mn></mrow></msup><mo>⁡</mo><mrow><mo stretchy="false">(</mo><msup><mi>ϵ</mi><mrow><mo>−</mo><mn>1</mn></mrow></msup><mo stretchy="false">)</mo></mrow></mrow></mrow></mrow><mo>)</mo></mrow></mrow><munderover accent="true" accentunder="true"><mo>→</mo><mrow><mi mathsize="0.700em">W</mi><mo mathsize="0.700em" stretchy="false">→</mo><mi mathsize="0.700em" mathvariant="normal">∞</mi></mrow><mphantom></mphantom></munderover><mn>0</mn></mrow><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">\mathbb{P}\left(\inf_{\mathbf{z}\in\mathbb{S}^{m-1}}\Big|\big\{{w}\in[W]:\|\mathbf{Z}_{w}-\mathbf{z}\|_{2}\leq\epsilon\big\}\Big|\leq W\epsilon^{m-1}\log^{-1}(\epsilon^{-1})\right)\xrightarrow[W\rightarrow\infty]{}0.</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="A2.p2.3" class="ltx_p">Let <math id="A2.p2.m1" class="ltx_Math" alttext="c_{m}&gt;0" display="inline" intent=":literal"><semantics><mrow><msub><mi>c</mi><mi>m</mi></msub><mo>&gt;</mo><mn>0</mn></mrow><annotation encoding="application/x-tex">c_{m}&gt;0</annotation></semantics></math> be a constant that depends only on <math id="A2.p2.m2" class="ltx_Math" alttext="m" display="inline" intent=":literal"><semantics><mi>m</mi><annotation encoding="application/x-tex">m</annotation></semantics></math> such that</p>
<table id="A2.EGx41" class="ltx_equationgroup ltx_eqn_align ltx_eqn_table">

<tbody id="A2.Ex77"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_align_right ltx_eqn_cell"><math id="A2.Ex77.m1" class="ltx_Math" alttext="\displaystyle p\coloneq\mathbb{P}(\|\mathbf{Z}-\mathbf{z}\|_{2}\leq\epsilon/2)\geq c_{m}\epsilon^{m-1}" display="inline" intent=":literal"><semantics><mrow><mi>p</mi><mo>≔</mo><mrow><mi>ℙ</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mrow><msub><mrow><mo stretchy="false">‖</mo><mrow><mi>𝐙</mi><mo>−</mo><mi>𝐳</mi></mrow><mo stretchy="false">‖</mo></mrow><mn>2</mn></msub><mo>≤</mo><mrow><mi>ϵ</mi><mo>/</mo><mn>2</mn></mrow></mrow><mo stretchy="false">)</mo></mrow></mrow><mo>≥</mo><mrow><msub><mi>c</mi><mi>m</mi></msub><mo lspace="0em" rspace="0em">​</mo><msup><mi>ϵ</mi><mrow><mi>m</mi><mo>−</mo><mn>1</mn></mrow></msup></mrow></mrow><annotation encoding="application/x-tex">\displaystyle p\coloneq\mathbb{P}(\|\mathbf{Z}-\mathbf{z}\|_{2}\leq\epsilon/2)\geq c_{m}\epsilon^{m-1}</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="A2.p2.4" class="ltx_p">holds for all <math id="A2.p2.m3" class="ltx_Math" alttext="\epsilon\in[0,1]" display="inline" intent=":literal"><semantics><mrow><mi>ϵ</mi><mo>∈</mo><mrow><mo stretchy="false">[</mo><mrow><mn>0</mn><mo>,</mo><mn>1</mn></mrow><mo stretchy="false">]</mo></mrow></mrow><annotation encoding="application/x-tex">\epsilon\in[0,1]</annotation></semantics></math> and all
<math id="A2.p2.m4" class="ltx_Math" alttext="\mathbf{z}\in\mathbb{S}^{m-1}" display="inline" intent=":literal"><semantics><mrow><mi>𝐳</mi><mo>∈</mo><msup><mi>𝕊</mi><mrow><mi>m</mi><mo>−</mo><mn>1</mn></mrow></msup></mrow><annotation encoding="application/x-tex">\mathbf{z}\in\mathbb{S}^{m-1}</annotation></semantics></math>.
See Lemma <a href="#Thmconj234" title="Lemma 34. ‣ Appendix G Technical Lemmas ‣ Generalization Bounds for Transformer-Based Next-Token Prediction in a Language Model" class="ltx_ref"><span class="ltx_text ltx_ref_tag">34</span></a> for the existence of such a constant.
In addition,
let <math id="A2.p2.m5" class="ltx_Math" alttext="\mathcal{U}" display="inline" intent=":literal"><semantics><mi class="ltx_font_mathcaligraphic">𝒰</mi><annotation encoding="application/x-tex">\mathcal{U}</annotation></semantics></math> be an <math id="A2.p2.m6" class="ltx_Math" alttext="(\epsilon/2)" display="inline" intent=":literal"><semantics><mrow><mo stretchy="false">(</mo><mrow><mi>ϵ</mi><mo>/</mo><mn>2</mn></mrow><mo stretchy="false">)</mo></mrow><annotation encoding="application/x-tex">(\epsilon/2)</annotation></semantics></math>-net of <math id="A2.p2.m7" class="ltx_Math" alttext="\mathbb{S}^{m-1}" display="inline" intent=":literal"><semantics><msup><mi>𝕊</mi><mrow><mi>m</mi><mo>−</mo><mn>1</mn></mrow></msup><annotation encoding="application/x-tex">\mathbb{S}^{m-1}</annotation></semantics></math> with respect to the metric <math id="A2.p2.m8" class="ltx_math_unparsed" alttext="\|\cdot\|_{2}" display="inline" intent=":literal"><semantics><mrow><mo rspace="0em">∥</mo><mo lspace="0em" rspace="0em">⋅</mo><mo lspace="0em">∥</mo><msub><mrow></mrow><mn>2</mn></msub></mrow><annotation encoding="application/x-tex">\|\cdot\|_{2}</annotation></semantics></math>, whose cardinality satisfies
<math id="A2.p2.m9" class="ltx_Math" alttext="|\mathcal{U}|\lesssim\epsilon^{-m}." display="inline" intent=":literal"><semantics><mrow><mrow><mrow><mo stretchy="false">|</mo><mi class="ltx_font_mathcaligraphic">𝒰</mi><mo stretchy="false">|</mo></mrow><mo>≲</mo><msup><mi>ϵ</mi><mrow><mo>−</mo><mi>m</mi></mrow></msup></mrow><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">|\mathcal{U}|\lesssim\epsilon^{-m}.</annotation></semantics></math>
Then, for any <math id="A2.p2.m10" class="ltx_Math" alttext="\mathbf{z}\in\mathbb{S}^{m-1}" display="inline" intent=":literal"><semantics><mrow><mi>𝐳</mi><mo>∈</mo><msup><mi>𝕊</mi><mrow><mi>m</mi><mo>−</mo><mn>1</mn></mrow></msup></mrow><annotation encoding="application/x-tex">\mathbf{z}\in\mathbb{S}^{m-1}</annotation></semantics></math>, there exists <math id="A2.p2.m11" class="ltx_Math" alttext="\mathbf{u}\in\mathcal{U}" display="inline" intent=":literal"><semantics><mrow><mi>𝐮</mi><mo>∈</mo><mi class="ltx_font_mathcaligraphic">𝒰</mi></mrow><annotation encoding="application/x-tex">\mathbf{u}\in\mathcal{U}</annotation></semantics></math> such that <math id="A2.p2.m12" class="ltx_Math" alttext="\{{w}\in[W]:\|\mathbf{Z}_{w}-\mathbf{z}\|_{2}\leq\epsilon\}\supseteq\{{w}\in[W]:\|\mathbf{Z}_{w}-\mathbf{u}\|_{2}\leq\epsilon/2\}" display="inline" intent=":literal"><semantics><mrow><mrow><mo stretchy="false">{</mo><mrow><mi>w</mi><mo>∈</mo><mrow><mo stretchy="false">[</mo><mi>W</mi><mo rspace="0.278em" stretchy="false">]</mo></mrow></mrow><mo rspace="0.278em">:</mo><mrow><msub><mrow><mo stretchy="false">‖</mo><mrow><msub><mi>𝐙</mi><mi>w</mi></msub><mo>−</mo><mi>𝐳</mi></mrow><mo stretchy="false">‖</mo></mrow><mn>2</mn></msub><mo>≤</mo><mi>ϵ</mi></mrow><mo stretchy="false">}</mo></mrow><mo>⊇</mo><mrow><mo stretchy="false">{</mo><mrow><mi>w</mi><mo>∈</mo><mrow><mo stretchy="false">[</mo><mi>W</mi><mo rspace="0.278em" stretchy="false">]</mo></mrow></mrow><mo rspace="0.278em">:</mo><mrow><msub><mrow><mo stretchy="false">‖</mo><mrow><msub><mi>𝐙</mi><mi>w</mi></msub><mo>−</mo><mi>𝐮</mi></mrow><mo stretchy="false">‖</mo></mrow><mn>2</mn></msub><mo>≤</mo><mrow><mi>ϵ</mi><mo>/</mo><mn>2</mn></mrow></mrow><mo stretchy="false">}</mo></mrow></mrow><annotation encoding="application/x-tex">\{{w}\in[W]:\|\mathbf{Z}_{w}-\mathbf{z}\|_{2}\leq\epsilon\}\supseteq\{{w}\in[W]:\|\mathbf{Z}_{w}-\mathbf{u}\|_{2}\leq\epsilon/2\}</annotation></semantics></math>. The multiplicative form of Chernoff’s inequality for Bernoulli random variables states that if <math id="A2.p2.m13" class="ltx_Math" alttext="X\sim\operatorname{Bin}(W,\rho)" display="inline" intent=":literal"><semantics><mrow><mi>X</mi><mo>∼</mo><mrow><mi>Bin</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>W</mi><mo>,</mo><mi>ρ</mi><mo stretchy="false">)</mo></mrow></mrow></mrow><annotation encoding="application/x-tex">X\sim\operatorname{Bin}(W,\rho)</annotation></semantics></math> and <math id="A2.p2.m14" class="ltx_Math" alttext="0\leq\delta\leq 1," display="inline" intent=":literal"><semantics><mrow><mrow><mn>0</mn><mo>≤</mo><mi>δ</mi><mo>≤</mo><mn>1</mn></mrow><mo>,</mo></mrow><annotation encoding="application/x-tex">0\leq\delta\leq 1,</annotation></semantics></math> then, <math id="A2.p2.m15" class="ltx_math_unparsed" alttext="\mathbb{P}(X\leq(1-\delta)W\rho)\leq e^{-\delta^{2}W\rho/2}." display="inline" intent=":literal"><semantics><mrow><mi>ℙ</mi><mrow><mo stretchy="false">(</mo><mi>X</mi><mo>≤</mo><mrow><mo stretchy="false">(</mo><mn>1</mn><mo>−</mo><mi>δ</mi><mo stretchy="false">)</mo></mrow><mi>W</mi><mi>ρ</mi><mo stretchy="false">)</mo></mrow><mo>≤</mo><msup><mi>e</mi><mrow><mo>−</mo><mi>δ</mi><msup><mrow></mrow><mn>2</mn></msup><mi>W</mi><mi>ρ</mi><mo>/</mo><mn>2</mn></mrow></msup><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">\mathbb{P}(X\leq(1-\delta)W\rho)\leq e^{-\delta^{2}W\rho/2}.</annotation></semantics></math> It follows that</p>
<table id="A2.EGx42" class="ltx_equationgroup ltx_eqn_align ltx_eqn_table">

<tbody id="A2.Ex78"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_eqn_cell"></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A2.Ex78.m1" class="ltx_Math" alttext="\displaystyle\mathbb{P}\left(\inf_{\mathbf{z}\in\mathbb{S}^{m-1}}\Big|\big\{{w}\in[W]:\|\mathbf{Z}_{w}-\mathbf{z}\|_{2}\leq\epsilon\big\}\Big|\leq W\epsilon^{m-1}\log^{-1}(\epsilon^{-1})\right)" display="inline" intent=":literal"><semantics><mrow><mi>ℙ</mi><mo>⁡</mo><mrow><mo>(</mo><mrow><mrow><munder><mo lspace="0em" movablelimits="false" rspace="0em">inf</mo><mrow><mi>𝐳</mi><mo>∈</mo><msup><mi>𝕊</mi><mrow><mi>m</mi><mo>−</mo><mn>1</mn></mrow></msup></mrow></munder><mrow><mo maxsize="1.600em" minsize="1.600em" stretchy="true">|</mo><mrow><mo stretchy="false">{</mo><mrow><mi>w</mi><mo>∈</mo><mrow><mo stretchy="false">[</mo><mi>W</mi><mo rspace="0.278em" stretchy="false">]</mo></mrow></mrow><mo rspace="0.278em">:</mo><mrow><msub><mrow><mo stretchy="false">‖</mo><mrow><msub><mi>𝐙</mi><mi>w</mi></msub><mo>−</mo><mi>𝐳</mi></mrow><mo stretchy="false">‖</mo></mrow><mn>2</mn></msub><mo>≤</mo><mi>ϵ</mi></mrow><mo stretchy="false">}</mo></mrow><mo maxsize="1.600em" minsize="1.600em" stretchy="true">|</mo></mrow></mrow><mo>≤</mo><mrow><mi>W</mi><mo lspace="0em" rspace="0em">​</mo><msup><mi>ϵ</mi><mrow><mi>m</mi><mo>−</mo><mn>1</mn></mrow></msup><mo lspace="0.167em" rspace="0em">​</mo><mrow><msup><mi>log</mi><mrow><mo>−</mo><mn>1</mn></mrow></msup><mo>⁡</mo><mrow><mo stretchy="false">(</mo><msup><mi>ϵ</mi><mrow><mo>−</mo><mn>1</mn></mrow></msup><mo stretchy="false">)</mo></mrow></mrow></mrow></mrow><mo>)</mo></mrow></mrow><annotation encoding="application/x-tex">\displaystyle\mathbb{P}\left(\inf_{\mathbf{z}\in\mathbb{S}^{m-1}}\Big|\big\{{w}\in[W]:\|\mathbf{Z}_{w}-\mathbf{z}\|_{2}\leq\epsilon\big\}\Big|\leq W\epsilon^{m-1}\log^{-1}(\epsilon^{-1})\right)</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
<tbody id="A2.Ex79"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_eqn_cell"></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A2.Ex79.m1" class="ltx_Math" alttext="\displaystyle\leq\mathbb{P}\left(\min_{\mathbf{u}\in\mathcal{U}}\Big|\big\{{w}\in[W]:\|\mathbf{Z}_{w}-\mathbf{u}\|_{2}\leq\epsilon/2\big\}\Big|\leq Wpc_{m}^{-1}\log^{-1}(\epsilon^{-1})\right)" display="inline" intent=":literal"><semantics><mrow><mphantom></mphantom><mo>≤</mo><mrow><mi>ℙ</mi><mo>⁡</mo><mrow><mo>(</mo><mrow><mrow><munder><mi>min</mi><mrow><mi>𝐮</mi><mo>∈</mo><mi class="ltx_font_mathcaligraphic">𝒰</mi></mrow></munder><mo>⁡</mo><mrow><mo maxsize="1.600em" minsize="1.600em" stretchy="true">|</mo><mrow><mo stretchy="false">{</mo><mrow><mi>w</mi><mo>∈</mo><mrow><mo stretchy="false">[</mo><mi>W</mi><mo rspace="0.278em" stretchy="false">]</mo></mrow></mrow><mo rspace="0.278em">:</mo><mrow><msub><mrow><mo stretchy="false">‖</mo><mrow><msub><mi>𝐙</mi><mi>w</mi></msub><mo>−</mo><mi>𝐮</mi></mrow><mo stretchy="false">‖</mo></mrow><mn>2</mn></msub><mo>≤</mo><mrow><mi>ϵ</mi><mo>/</mo><mn>2</mn></mrow></mrow><mo stretchy="false">}</mo></mrow><mo maxsize="1.600em" minsize="1.600em" stretchy="true">|</mo></mrow></mrow><mo>≤</mo><mrow><mi>W</mi><mo lspace="0em" rspace="0em">​</mo><mi>p</mi><mo lspace="0em" rspace="0em">​</mo><msubsup><mi>c</mi><mi>m</mi><mrow><mo>−</mo><mn>1</mn></mrow></msubsup><mo lspace="0.167em" rspace="0em">​</mo><mrow><msup><mi>log</mi><mrow><mo>−</mo><mn>1</mn></mrow></msup><mo>⁡</mo><mrow><mo stretchy="false">(</mo><msup><mi>ϵ</mi><mrow><mo>−</mo><mn>1</mn></mrow></msup><mo stretchy="false">)</mo></mrow></mrow></mrow></mrow><mo>)</mo></mrow></mrow></mrow><annotation encoding="application/x-tex">\displaystyle\leq\mathbb{P}\left(\min_{\mathbf{u}\in\mathcal{U}}\Big|\big\{{w}\in[W]:\|\mathbf{Z}_{w}-\mathbf{u}\|_{2}\leq\epsilon/2\big\}\Big|\leq Wpc_{m}^{-1}\log^{-1}(\epsilon^{-1})\right)</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
<tbody id="A2.Ex80"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_eqn_cell"></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A2.Ex80.m1" class="ltx_Math" alttext="\displaystyle\leq\sum_{\mathbf{u}\in\mathcal{U}}\mathbb{P}\bigg(\sum_{w=1}^{W}\mathbb{I}\big(\|\mathbf{Z}_{w}-\mathbf{u}\|_{2}\leq\epsilon/2\big)\leq\Big(1-\big(\underbrace{1-c_{m}^{-1}\log^{-1}(\epsilon^{-1})}_{\eqcolon\delta}\big)\Big)Wp\bigg)" display="inline" intent=":literal"><semantics><mrow><mphantom></mphantom><mo>≤</mo><mrow><mstyle displaystyle="true"><munder><mo movablelimits="false">∑</mo><mrow><mi>𝐮</mi><mo>∈</mo><mi class="ltx_font_mathcaligraphic">𝒰</mi></mrow></munder></mstyle><mrow><mi>ℙ</mi><mo>⁡</mo><mrow><mo maxsize="2.100em" minsize="2.100em">(</mo><mrow><mrow><mstyle displaystyle="true"><munderover><mo movablelimits="false">∑</mo><mrow><mi>w</mi><mo>=</mo><mn>1</mn></mrow><mi>W</mi></munderover></mstyle><mrow><mi>𝕀</mi><mo>⁡</mo><mrow><mo maxsize="1.200em" minsize="1.200em">(</mo><mrow><msub><mrow><mo stretchy="false">‖</mo><mrow><msub><mi>𝐙</mi><mi>w</mi></msub><mo>−</mo><mi>𝐮</mi></mrow><mo stretchy="false">‖</mo></mrow><mn>2</mn></msub><mo>≤</mo><mrow><mi>ϵ</mi><mo>/</mo><mn>2</mn></mrow></mrow><mo maxsize="1.200em" minsize="1.200em">)</mo></mrow></mrow></mrow><mo>≤</mo><mrow><mrow><mo maxsize="1.600em" minsize="1.600em">(</mo><mrow><mn>1</mn><mo>−</mo><mrow><mo maxsize="1.200em" minsize="1.200em">(</mo><munder><munder accentunder="true"><mrow><mn>1</mn><mo>−</mo><mrow><msubsup><mi>c</mi><mi>m</mi><mrow><mo>−</mo><mn>1</mn></mrow></msubsup><mo lspace="0.167em" rspace="0em">​</mo><mrow><msup><mi>log</mi><mrow><mo>−</mo><mn>1</mn></mrow></msup><mo>⁡</mo><mrow><mo stretchy="false">(</mo><msup><mi>ϵ</mi><mrow><mo>−</mo><mn>1</mn></mrow></msup><mo stretchy="false">)</mo></mrow></mrow></mrow></mrow><mo stretchy="true">⏟</mo></munder><mrow><mphantom></mphantom><mo>≕</mo><mi>δ</mi></mrow></munder><mo maxsize="1.200em" minsize="1.200em">)</mo></mrow></mrow><mo maxsize="1.600em" minsize="1.600em">)</mo></mrow><mo lspace="0em" rspace="0em">​</mo><mi>W</mi><mo lspace="0em" rspace="0em">​</mo><mi>p</mi></mrow></mrow><mo maxsize="2.100em" minsize="2.100em">)</mo></mrow></mrow></mrow></mrow><annotation encoding="application/x-tex">\displaystyle\leq\sum_{\mathbf{u}\in\mathcal{U}}\mathbb{P}\bigg(\sum_{w=1}^{W}\mathbb{I}\big(\|\mathbf{Z}_{w}-\mathbf{u}\|_{2}\leq\epsilon/2\big)\leq\Big(1-\big(\underbrace{1-c_{m}^{-1}\log^{-1}(\epsilon^{-1})}_{\eqcolon\delta}\big)\Big)Wp\bigg)</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
<tbody id="A2.Ex81"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_eqn_cell"></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A2.Ex81.m1" class="ltx_math_unparsed" alttext="\displaystyle\leq|\mathcal{U}|e^{-\delta^{2}Wp/2}" display="inline" intent=":literal"><semantics><mrow><mo rspace="0em">≤</mo><mo fence="false" rspace="0.167em" stretchy="false">|</mo><mi class="ltx_font_mathcaligraphic">𝒰</mi><mo fence="false" rspace="0.167em" stretchy="false">|</mo><mi>e</mi><msup><mrow></mrow><mrow><mo>−</mo><mi>δ</mi><msup><mrow></mrow><mn>2</mn></msup><mi>W</mi><mi>p</mi><mo>/</mo><mn>2</mn></mrow></msup></mrow><annotation encoding="application/x-tex">\displaystyle\leq|\mathcal{U}|e^{-\delta^{2}Wp/2}</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
<tbody id="A2.Ex82"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_eqn_cell"></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A2.Ex82.m1" class="ltx_Math" alttext="\displaystyle\lesssim\epsilon^{-m}\exp\left(-\delta^{2}\frac{c_{m}\epsilon^{m-1}W}{2}\right)\xrightarrow[W\rightarrow\infty]{}0," display="inline" intent=":literal"><semantics><mrow><mrow><mphantom></mphantom><mo>≲</mo><mrow><msup><mi>ϵ</mi><mrow><mo>−</mo><mi>m</mi></mrow></msup><mo lspace="0.167em" rspace="0em">​</mo><mrow><mi>exp</mi><mo>⁡</mo><mrow><mo>(</mo><mrow><mo>−</mo><mrow><msup><mi>δ</mi><mn>2</mn></msup><mo lspace="0em" rspace="0em">​</mo><mstyle displaystyle="true"><mfrac><mrow><msub><mi>c</mi><mi>m</mi></msub><mo lspace="0em" rspace="0em">​</mo><msup><mi>ϵ</mi><mrow><mi>m</mi><mo>−</mo><mn>1</mn></mrow></msup><mo lspace="0em" rspace="0em">​</mo><mi>W</mi></mrow><mn>2</mn></mfrac></mstyle></mrow></mrow><mo>)</mo></mrow></mrow></mrow><munderover accent="true" accentunder="true"><mo>→</mo><mrow><mi mathsize="0.700em">W</mi><mo mathsize="0.700em" stretchy="false">→</mo><mi mathsize="0.700em" mathvariant="normal">∞</mi></mrow><mphantom></mphantom></munderover><mn>0</mn></mrow><mo>,</mo></mrow><annotation encoding="application/x-tex">\displaystyle\lesssim\epsilon^{-m}\exp\left(-\delta^{2}\frac{c_{m}\epsilon^{m-1}W}{2}\right)\xrightarrow[W\rightarrow\infty]{}0,</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="A2.p2.5" class="ltx_p">provided that <math id="A2.p2.m16" class="ltx_Math" alttext="\epsilon\ll 1" display="inline" intent=":literal"><semantics><mrow><mi>ϵ</mi><mo>≪</mo><mn>1</mn></mrow><annotation encoding="application/x-tex">\epsilon\ll 1</annotation></semantics></math>, <math id="A2.p2.m17" class="ltx_Math" alttext="\epsilon^{m-1}\geq W^{-1}\log^{m-1}W" display="inline" intent=":literal"><semantics><mrow><msup><mi>ϵ</mi><mrow><mi>m</mi><mo>−</mo><mn>1</mn></mrow></msup><mo>≥</mo><mrow><msup><mi>W</mi><mrow><mo>−</mo><mn>1</mn></mrow></msup><mo lspace="0.167em" rspace="0em">​</mo><msup><mi>log</mi><mrow><mi>m</mi><mo>−</mo><mn>1</mn></mrow></msup><mo lspace="0.167em" rspace="0em">​</mo><mi>W</mi></mrow></mrow><annotation encoding="application/x-tex">\epsilon^{m-1}\geq W^{-1}\log^{m-1}W</annotation></semantics></math> and <math id="A2.p2.m18" class="ltx_Math" alttext="m\geq 3" display="inline" intent=":literal"><semantics><mrow><mi>m</mi><mo>≥</mo><mn>3</mn></mrow><annotation encoding="application/x-tex">m\geq 3</annotation></semantics></math>. Combining this with (<a href="#A2.E32" title="In Appendix B Discussion about Assumption ‣ Generalization Bounds for Transformer-Based Next-Token Prediction in a Language Model" class="ltx_ref"><span class="ltx_text ltx_ref_tag">32</span></a>) yields (<a href="#A2.E30" title="In Appendix B Discussion about Assumption ‣ Generalization Bounds for Transformer-Based Next-Token Prediction in a Language Model" class="ltx_ref"><span class="ltx_text ltx_ref_tag">30</span></a>).</p>
</div>
<div id="A2.p3" class="ltx_para">
<p id="A2.p3.1" class="ltx_p">For the second claim,
let <math id="A2.p3.m1" class="ltx_Math" alttext="\mathcal{V}" display="inline" intent=":literal"><semantics><mi class="ltx_font_mathcaligraphic">𝒱</mi><annotation encoding="application/x-tex">\mathcal{V}</annotation></semantics></math> be an <math id="A2.p3.m2" class="ltx_math_unparsed" alttext="W^{-1/2}" display="inline" intent=":literal"><semantics><mrow><mi>W</mi><msup><mrow></mrow><mrow><mo>−</mo><mn>1</mn><mo>/</mo><mn>2</mn></mrow></msup></mrow><annotation encoding="application/x-tex">W^{-1/2}</annotation></semantics></math>-net of <math id="A2.p3.m3" class="ltx_Math" alttext="\delta\mathbb{S}^{m-1}" display="inline" intent=":literal"><semantics><mrow><mi>δ</mi><mo lspace="0em" rspace="0em">​</mo><msup><mi>𝕊</mi><mrow><mi>m</mi><mo>−</mo><mn>1</mn></mrow></msup></mrow><annotation encoding="application/x-tex">\delta\mathbb{S}^{m-1}</annotation></semantics></math> with respect to the Euclidean metric, whose cardinality satisfies
<math id="A2.p3.m4" class="ltx_Math" alttext="|\mathcal{V}|\lesssim(\delta\sqrt{W})^{m}\lesssim W^{m/2}." display="inline" intent=":literal"><semantics><mrow><mrow><mrow><mo stretchy="false">|</mo><mi class="ltx_font_mathcaligraphic">𝒱</mi><mo stretchy="false">|</mo></mrow><mo>≲</mo><msup><mrow><mo stretchy="false">(</mo><mrow><mi>δ</mi><mo lspace="0em" rspace="0em">​</mo><msqrt><mi>W</mi></msqrt></mrow><mo stretchy="false">)</mo></mrow><mi>m</mi></msup><mo>≲</mo><msup><mi>W</mi><mrow><mi>m</mi><mo>/</mo><mn>2</mn></mrow></msup></mrow><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">|\mathcal{V}|\lesssim(\delta\sqrt{W})^{m}\lesssim W^{m/2}.</annotation></semantics></math>
Observe that for any <math id="A2.p3.m5" class="ltx_Math" alttext="\mathbf{z}\in\mathbb{S}^{m-1}" display="inline" intent=":literal"><semantics><mrow><mi>𝐳</mi><mo>∈</mo><msup><mi>𝕊</mi><mrow><mi>m</mi><mo>−</mo><mn>1</mn></mrow></msup></mrow><annotation encoding="application/x-tex">\mathbf{z}\in\mathbb{S}^{m-1}</annotation></semantics></math> and <math id="A2.p3.m6" class="ltx_Math" alttext="\mathbf{v},\mathbf{u}\in\delta\mathbb{S}^{m-1}" display="inline" intent=":literal"><semantics><mrow><mrow><mi>𝐯</mi><mo>,</mo><mi>𝐮</mi></mrow><mo>∈</mo><mrow><mi>δ</mi><mo lspace="0em" rspace="0em">​</mo><msup><mi>𝕊</mi><mrow><mi>m</mi><mo>−</mo><mn>1</mn></mrow></msup></mrow></mrow><annotation encoding="application/x-tex">\mathbf{v},\mathbf{u}\in\delta\mathbb{S}^{m-1}</annotation></semantics></math>,</p>
<table id="A2.Ex83" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="A2.Ex83.m1" class="ltx_Math" alttext="\left\|\exp(\mathbf{v}^{\top}\mathbf{z})\mathbf{z}-\exp(\mathbf{u}^{\top}\mathbf{z})\mathbf{z}\right\|_{2}\leq\left|\exp(\mathbf{v}^{\top}\mathbf{z})-\exp(\mathbf{u}^{\top}\mathbf{z})\right|\leq\sup_{t\in[-\delta,\delta]}e^{t}\left|(\mathbf{v}-\mathbf{u})^{\top}\mathbf{z}\right|\leq e^{\delta}\|\mathbf{v}-\mathbf{u}\|_{2}." display="block" intent=":literal"><semantics><mrow><mrow><msub><mrow><mo>‖</mo><mrow><mrow><mrow><mi>exp</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mrow><msup><mi>𝐯</mi><mo>⊤</mo></msup><mo lspace="0em" rspace="0em">​</mo><mi>𝐳</mi></mrow><mo stretchy="false">)</mo></mrow></mrow><mo lspace="0em" rspace="0em">​</mo><mi>𝐳</mi></mrow><mo>−</mo><mrow><mrow><mi>exp</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mrow><msup><mi>𝐮</mi><mo>⊤</mo></msup><mo lspace="0em" rspace="0em">​</mo><mi>𝐳</mi></mrow><mo stretchy="false">)</mo></mrow></mrow><mo lspace="0em" rspace="0em">​</mo><mi>𝐳</mi></mrow></mrow><mo>‖</mo></mrow><mn>2</mn></msub><mo>≤</mo><mrow><mo>|</mo><mrow><mrow><mi>exp</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mrow><msup><mi>𝐯</mi><mo>⊤</mo></msup><mo lspace="0em" rspace="0em">​</mo><mi>𝐳</mi></mrow><mo stretchy="false">)</mo></mrow></mrow><mo>−</mo><mrow><mi>exp</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mrow><msup><mi>𝐮</mi><mo>⊤</mo></msup><mo lspace="0em" rspace="0em">​</mo><mi>𝐳</mi></mrow><mo stretchy="false">)</mo></mrow></mrow></mrow><mo>|</mo></mrow><mo rspace="0.1389em">≤</mo><mrow><munder><mo lspace="0.1389em" movablelimits="false" rspace="0.167em">sup</mo><mrow><mi>t</mi><mo>∈</mo><mrow><mo stretchy="false">[</mo><mrow><mrow><mo>−</mo><mi>δ</mi></mrow><mo>,</mo><mi>δ</mi></mrow><mo stretchy="false">]</mo></mrow></mrow></munder><mrow><msup><mi>e</mi><mi>t</mi></msup><mo lspace="0em" rspace="0em">​</mo><mrow><mo>|</mo><mrow><msup><mrow><mo stretchy="false">(</mo><mrow><mi>𝐯</mi><mo>−</mo><mi>𝐮</mi></mrow><mo stretchy="false">)</mo></mrow><mo>⊤</mo></msup><mo lspace="0em" rspace="0em">​</mo><mi>𝐳</mi></mrow><mo>|</mo></mrow></mrow></mrow><mo>≤</mo><mrow><msup><mi>e</mi><mi>δ</mi></msup><mo lspace="0em" rspace="0em">​</mo><msub><mrow><mo stretchy="false">‖</mo><mrow><mi>𝐯</mi><mo>−</mo><mi>𝐮</mi></mrow><mo stretchy="false">‖</mo></mrow><mn>2</mn></msub></mrow></mrow><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">\left\|\exp(\mathbf{v}^{\top}\mathbf{z})\mathbf{z}-\exp(\mathbf{u}^{\top}\mathbf{z})\mathbf{z}\right\|_{2}\leq\left|\exp(\mathbf{v}^{\top}\mathbf{z})-\exp(\mathbf{u}^{\top}\mathbf{z})\right|\leq\sup_{t\in[-\delta,\delta]}e^{t}\left|(\mathbf{v}-\mathbf{u})^{\top}\mathbf{z}\right|\leq e^{\delta}\|\mathbf{v}-\mathbf{u}\|_{2}.</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="A2.p3.2" class="ltx_p">Hence, for any <math id="A2.p3.m7" class="ltx_Math" alttext="\mathbf{v}\in\delta\mathbb{S}^{m-1}" display="inline" intent=":literal"><semantics><mrow><mi>𝐯</mi><mo>∈</mo><mrow><mi>δ</mi><mo lspace="0em" rspace="0em">​</mo><msup><mi>𝕊</mi><mrow><mi>m</mi><mo>−</mo><mn>1</mn></mrow></msup></mrow></mrow><annotation encoding="application/x-tex">\mathbf{v}\in\delta\mathbb{S}^{m-1}</annotation></semantics></math>, there exists <math id="A2.p3.m8" class="ltx_Math" alttext="\tilde{\mathbf{v}}\in\mathcal{V}" display="inline" intent=":literal"><semantics><mrow><mover accent="true"><mi>𝐯</mi><mo>~</mo></mover><mo>∈</mo><mi class="ltx_font_mathcaligraphic">𝒱</mi></mrow><annotation encoding="application/x-tex">\tilde{\mathbf{v}}\in\mathcal{V}</annotation></semantics></math> such that
<math id="A2.p3.m9" class="ltx_math_unparsed" alttext="\sup_{\mathbf{z}\in\mathbb{S}^{m-1}}|\exp(\mathbf{v}^{\top}\mathbf{z})-\exp(\tilde{\mathbf{v}}^{\top}\mathbf{z})|\leq e^{\delta}W^{-1/2}" display="inline" intent=":literal"><semantics><mrow><msub><mo>sup</mo><mrow><mi>𝐳</mi><mo>∈</mo><msup><mi>𝕊</mi><mrow><mi>m</mi><mo>−</mo><mn>1</mn></mrow></msup></mrow></msub><mo fence="false" lspace="0em" rspace="0.167em" stretchy="false">|</mo><mi>exp</mi><mrow><mo stretchy="false">(</mo><msup><mi>𝐯</mi><mo>⊤</mo></msup><mi>𝐳</mi><mo stretchy="false">)</mo></mrow><mo>−</mo><mi>exp</mi><mrow><mo stretchy="false">(</mo><msup><mover accent="true"><mi>𝐯</mi><mo>~</mo></mover><mo>⊤</mo></msup><mi>𝐳</mi><mo stretchy="false">)</mo></mrow><mo fence="false" stretchy="false">|</mo><mo lspace="0.167em">≤</mo><msup><mi>e</mi><mi>δ</mi></msup><msup><mi>W</mi><mrow><mo>−</mo><mn>1</mn><mo>/</mo><mn>2</mn></mrow></msup></mrow><annotation encoding="application/x-tex">\sup_{\mathbf{z}\in\mathbb{S}^{m-1}}|\exp(\mathbf{v}^{\top}\mathbf{z})-\exp(\tilde{\mathbf{v}}^{\top}\mathbf{z})|\leq e^{\delta}W^{-1/2}</annotation></semantics></math>
and
<math id="A2.p3.m10" class="ltx_math_unparsed" alttext="\sup_{\mathbf{z}\in\mathbb{S}^{m-1}}\|\exp(\mathbf{v}^{\top}\mathbf{z})\mathbf{z}-\exp(\tilde{\mathbf{v}}^{\top}\mathbf{z})\mathbf{z}\|_{2}\leq e^{\delta}W^{-1/2}" display="inline" intent=":literal"><semantics><mrow><msub><mo>sup</mo><mrow><mi>𝐳</mi><mo>∈</mo><msup><mi>𝕊</mi><mrow><mi>m</mi><mo>−</mo><mn>1</mn></mrow></msup></mrow></msub><mo lspace="0em" rspace="0.167em">∥</mo><mi>exp</mi><mrow><mo stretchy="false">(</mo><msup><mi>𝐯</mi><mo>⊤</mo></msup><mi>𝐳</mi><mo stretchy="false">)</mo></mrow><mi>𝐳</mi><mo>−</mo><mi>exp</mi><mrow><mo stretchy="false">(</mo><msup><mover accent="true"><mi>𝐯</mi><mo>~</mo></mover><mo>⊤</mo></msup><mi>𝐳</mi><mo stretchy="false">)</mo></mrow><mi>𝐳</mi><msub><mo lspace="0em" rspace="0.0835em">∥</mo><mn>2</mn></msub><mo lspace="0.0835em">≤</mo><msup><mi>e</mi><mi>δ</mi></msup><msup><mi>W</mi><mrow><mo>−</mo><mn>1</mn><mo>/</mo><mn>2</mn></mrow></msup></mrow><annotation encoding="application/x-tex">\sup_{\mathbf{z}\in\mathbb{S}^{m-1}}\|\exp(\mathbf{v}^{\top}\mathbf{z})\mathbf{z}-\exp(\tilde{\mathbf{v}}^{\top}\mathbf{z})\mathbf{z}\|_{2}\leq e^{\delta}W^{-1/2}</annotation></semantics></math>.
It follows that for <math id="A2.p3.m11" class="ltx_Math" alttext="t&gt;2e^{\delta}/\sqrt{W}" display="inline" intent=":literal"><semantics><mrow><mi>t</mi><mo>&gt;</mo><mrow><mrow><mn>2</mn><mo lspace="0em" rspace="0em">​</mo><msup><mi>e</mi><mi>δ</mi></msup></mrow><mo>/</mo><msqrt><mi>W</mi></msqrt></mrow></mrow><annotation encoding="application/x-tex">t&gt;2e^{\delta}/\sqrt{W}</annotation></semantics></math>,</p>
<table id="A2.EGx43" class="ltx_equationgroup ltx_eqn_align ltx_eqn_table">

<tbody id="A2.Ex84"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_eqn_cell"></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A2.Ex84.m1" class="ltx_Math" alttext="\displaystyle\mathbb{P}\left(\sup_{\mathbf{v}\in\delta\mathbb{S}^{m-1}}\left|\frac{1}{W}\sum_{w=1}^{W}\exp(\mathbf{v}^{\top}\mathbf{Z}_{w})-\mathbb{E}\left[\exp(\mathbf{v}^{\top}\mathbf{Z})\right]\right|&gt;t\right)" display="inline" intent=":literal"><semantics><mrow><mi>ℙ</mi><mo>⁡</mo><mrow><mo>(</mo><mrow><mrow><munder><mo lspace="0em" movablelimits="false" rspace="0em">sup</mo><mrow><mi>𝐯</mi><mo>∈</mo><mrow><mi>δ</mi><mo lspace="0em" rspace="0em">​</mo><msup><mi>𝕊</mi><mrow><mi>m</mi><mo>−</mo><mn>1</mn></mrow></msup></mrow></mrow></munder><mrow><mo>|</mo><mrow><mrow><mstyle displaystyle="true"><mfrac><mn>1</mn><mi>W</mi></mfrac></mstyle><mo lspace="0em" rspace="0em">​</mo><mrow><mstyle displaystyle="true"><munderover><mo movablelimits="false">∑</mo><mrow><mi>w</mi><mo>=</mo><mn>1</mn></mrow><mi>W</mi></munderover></mstyle><mrow><mi>exp</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mrow><msup><mi>𝐯</mi><mo>⊤</mo></msup><mo lspace="0em" rspace="0em">​</mo><msub><mi>𝐙</mi><mi>w</mi></msub></mrow><mo stretchy="false">)</mo></mrow></mrow></mrow></mrow><mo>−</mo><mrow><mi>𝔼</mi><mo>⁡</mo><mrow><mo>[</mo><mrow><mi>exp</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mrow><msup><mi>𝐯</mi><mo>⊤</mo></msup><mo lspace="0em" rspace="0em">​</mo><mi>𝐙</mi></mrow><mo stretchy="false">)</mo></mrow></mrow><mo>]</mo></mrow></mrow></mrow><mo>|</mo></mrow></mrow><mo>&gt;</mo><mi>t</mi></mrow><mo>)</mo></mrow></mrow><annotation encoding="application/x-tex">\displaystyle\mathbb{P}\left(\sup_{\mathbf{v}\in\delta\mathbb{S}^{m-1}}\left|\frac{1}{W}\sum_{w=1}^{W}\exp(\mathbf{v}^{\top}\mathbf{Z}_{w})-\mathbb{E}\left[\exp(\mathbf{v}^{\top}\mathbf{Z})\right]\right|&gt;t\right)</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
<tbody id="A2.Ex85"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_eqn_cell"></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A2.Ex85.m1" class="ltx_math_unparsed" alttext="\displaystyle\leq\mathbb{P}\left(\max_{\mathbf{v}\in\mathcal{V}}\left|\frac{1}{W}\sum_{w=1}^{W}\exp(\mathbf{v}^{\top}\mathbf{Z}_{w})-\mathbb{E}\left[\exp(\mathbf{v}^{\top}\mathbf{Z})\right]\right|&gt;t-2e^{\delta}W^{-1/2}\right)" display="inline" intent=":literal"><semantics><mrow><mo>≤</mo><mi>ℙ</mi><mrow><mo>(</mo><munder><mi>max</mi><mrow><mi>𝐯</mi><mo>∈</mo><mi class="ltx_font_mathcaligraphic">𝒱</mi></mrow></munder><mo fence="false" rspace="0.167em">|</mo><mstyle displaystyle="true"><mfrac><mn>1</mn><mi>W</mi></mfrac></mstyle><mstyle displaystyle="true"><munderover><mo movablelimits="false">∑</mo><mrow><mi>w</mi><mo>=</mo><mn>1</mn></mrow><mi>W</mi></munderover></mstyle><mi>exp</mi><mrow><mo stretchy="false">(</mo><msup><mi>𝐯</mi><mo>⊤</mo></msup><msub><mi>𝐙</mi><mi>w</mi></msub><mo stretchy="false">)</mo></mrow><mo>−</mo><mi>𝔼</mi><mrow><mo>[</mo><mi>exp</mi><mrow><mo stretchy="false">(</mo><msup><mi>𝐯</mi><mo>⊤</mo></msup><mi>𝐙</mi><mo stretchy="false">)</mo></mrow><mo>]</mo></mrow><mo fence="false">|</mo><mo lspace="0.167em">&gt;</mo><mi>t</mi><mo>−</mo><mn>2</mn><msup><mi>e</mi><mi>δ</mi></msup><msup><mi>W</mi><mrow><mo>−</mo><mn>1</mn><mo>/</mo><mn>2</mn></mrow></msup><mo>)</mo></mrow></mrow><annotation encoding="application/x-tex">\displaystyle\leq\mathbb{P}\left(\max_{\mathbf{v}\in\mathcal{V}}\left|\frac{1}{W}\sum_{w=1}^{W}\exp(\mathbf{v}^{\top}\mathbf{Z}_{w})-\mathbb{E}\left[\exp(\mathbf{v}^{\top}\mathbf{Z})\right]\right|&gt;t-2e^{\delta}W^{-1/2}\right)</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
<tbody id="A2.Ex86"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_eqn_cell"></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A2.Ex86.m1" class="ltx_math_unparsed" alttext="\displaystyle\leq\sum_{v\in\mathcal{V}}\mathbb{P}\left(\left|\frac{1}{W}\sum_{w=1}^{W}\exp(\mathbf{v}^{\top}\mathbf{Z}_{w})-\mathbb{E}\left[\exp(\mathbf{v}^{\top}\mathbf{Z})\right]\right|&gt;t-2e^{\delta}W^{-1/2}\right)" display="inline" intent=":literal"><semantics><mrow><mo>≤</mo><mstyle displaystyle="true"><munder><mo movablelimits="false">∑</mo><mrow><mi>v</mi><mo>∈</mo><mi class="ltx_font_mathcaligraphic">𝒱</mi></mrow></munder></mstyle><mi>ℙ</mi><mrow><mo>(</mo><mo fence="false" rspace="0.167em">|</mo><mstyle displaystyle="true"><mfrac><mn>1</mn><mi>W</mi></mfrac></mstyle><mstyle displaystyle="true"><munderover><mo movablelimits="false">∑</mo><mrow><mi>w</mi><mo>=</mo><mn>1</mn></mrow><mi>W</mi></munderover></mstyle><mi>exp</mi><mrow><mo stretchy="false">(</mo><msup><mi>𝐯</mi><mo>⊤</mo></msup><msub><mi>𝐙</mi><mi>w</mi></msub><mo stretchy="false">)</mo></mrow><mo>−</mo><mi>𝔼</mi><mrow><mo>[</mo><mi>exp</mi><mrow><mo stretchy="false">(</mo><msup><mi>𝐯</mi><mo>⊤</mo></msup><mi>𝐙</mi><mo stretchy="false">)</mo></mrow><mo>]</mo></mrow><mo fence="false">|</mo><mo lspace="0.167em">&gt;</mo><mi>t</mi><mo>−</mo><mn>2</mn><msup><mi>e</mi><mi>δ</mi></msup><msup><mi>W</mi><mrow><mo>−</mo><mn>1</mn><mo>/</mo><mn>2</mn></mrow></msup><mo>)</mo></mrow></mrow><annotation encoding="application/x-tex">\displaystyle\leq\sum_{v\in\mathcal{V}}\mathbb{P}\left(\left|\frac{1}{W}\sum_{w=1}^{W}\exp(\mathbf{v}^{\top}\mathbf{Z}_{w})-\mathbb{E}\left[\exp(\mathbf{v}^{\top}\mathbf{Z})\right]\right|&gt;t-2e^{\delta}W^{-1/2}\right)</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
<tbody id="A2.Ex87"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_eqn_cell"></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A2.Ex87.m1" class="ltx_Math" alttext="\displaystyle\leq 2|\mathcal{V}|\exp\left(-\frac{2W(t-2e^{\delta}W^{-1/2})^{2}}{e^{\delta}}\right)" display="inline" intent=":literal"><semantics><mrow><mphantom></mphantom><mo>≤</mo><mrow><mn>2</mn><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">|</mo><mi class="ltx_font_mathcaligraphic">𝒱</mi><mo stretchy="false">|</mo></mrow><mo lspace="0.167em" rspace="0em">​</mo><mrow><mi>exp</mi><mo>⁡</mo><mrow><mo>(</mo><mrow><mo>−</mo><mstyle displaystyle="true"><mfrac><mrow><mn>2</mn><mi>W</mi><mo stretchy="false">(</mo><mi>t</mi><mo>−</mo><mn>2</mn><mi>e</mi><msup><mrow></mrow><mi>δ</mi></msup><mi>W</mi><msup><mrow></mrow><mrow><mo>−</mo><mn>1</mn><mo>/</mo><mn>2</mn></mrow></msup><mo stretchy="false">)</mo><msup><mrow></mrow><mn>2</mn></msup></mrow><msup><mi>e</mi><mi>δ</mi></msup></mfrac></mstyle></mrow><mo>)</mo></mrow></mrow></mrow></mrow><annotation encoding="application/x-tex">\displaystyle\leq 2|\mathcal{V}|\exp\left(-\frac{2W(t-2e^{\delta}W^{-1/2})^{2}}{e^{\delta}}\right)</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
<tbody id="A2.Ex88"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_eqn_cell"></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A2.Ex88.m1" class="ltx_Math" alttext="\displaystyle\lesssim W^{m/2}\exp\left(-\frac{2W(t-2e^{\delta}/\sqrt{W})^{2}}{e^{\delta}}\right)." display="inline" intent=":literal"><semantics><mrow><mrow><mphantom></mphantom><mo>≲</mo><mrow><msup><mi>W</mi><mrow><mi>m</mi><mo>/</mo><mn>2</mn></mrow></msup><mo lspace="0.167em" rspace="0em">​</mo><mrow><mi>exp</mi><mo>⁡</mo><mrow><mo>(</mo><mrow><mo>−</mo><mstyle displaystyle="true"><mfrac><mrow><mn>2</mn><mo lspace="0em" rspace="0em">​</mo><mi>W</mi><mo lspace="0em" rspace="0em">​</mo><msup><mrow><mo stretchy="false">(</mo><mrow><mi>t</mi><mo>−</mo><mrow><mrow><mn>2</mn><mo lspace="0em" rspace="0em">​</mo><msup><mi>e</mi><mi>δ</mi></msup></mrow><mo>/</mo><msqrt><mi>W</mi></msqrt></mrow></mrow><mo stretchy="false">)</mo></mrow><mn>2</mn></msup></mrow><msup><mi>e</mi><mi>δ</mi></msup></mfrac></mstyle></mrow><mo>)</mo></mrow></mrow></mrow></mrow><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">\displaystyle\lesssim W^{m/2}\exp\left(-\frac{2W(t-2e^{\delta}/\sqrt{W})^{2}}{e^{\delta}}\right).</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="A2.p3.3" class="ltx_p">For the third inequality, we use Hoeffding’s inequality with
<math id="A2.p3.m12" class="ltx_Math" alttext="\exp(\mathbf{v}^{\top}\mathbf{Z}_{w})\leq e^{\delta}" display="inline" intent=":literal"><semantics><mrow><mrow><mi>exp</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mrow><msup><mi>𝐯</mi><mo>⊤</mo></msup><mo lspace="0em" rspace="0em">​</mo><msub><mi>𝐙</mi><mi>w</mi></msub></mrow><mo stretchy="false">)</mo></mrow></mrow><mo>≤</mo><msup><mi>e</mi><mi>δ</mi></msup></mrow><annotation encoding="application/x-tex">\exp(\mathbf{v}^{\top}\mathbf{Z}_{w})\leq e^{\delta}</annotation></semantics></math>.
For sufficiently large <math id="A2.p3.m13" class="ltx_Math" alttext="W" display="inline" intent=":literal"><semantics><mi>W</mi><annotation encoding="application/x-tex">W</annotation></semantics></math>, and by choosing <math id="A2.p3.m14" class="ltx_Math" alttext="t\coloneq e^{\delta}\log W/\sqrt{W}" display="inline" intent=":literal"><semantics><mrow><mi>t</mi><mo>≔</mo><mrow><mrow><msup><mi>e</mi><mi>δ</mi></msup><mo lspace="0.167em" rspace="0em">​</mo><mrow><mi>log</mi><mo lspace="0.167em">⁡</mo><mi>W</mi></mrow></mrow><mo>/</mo><msqrt><mi>W</mi></msqrt></mrow></mrow><annotation encoding="application/x-tex">t\coloneq e^{\delta}\log W/\sqrt{W}</annotation></semantics></math>, we obtain</p>
<table id="A2.EGx44" class="ltx_equationgroup ltx_eqn_align ltx_eqn_table">

<tbody id="A2.E33"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_align_right ltx_eqn_cell"><math id="A2.E33.m1" class="ltx_Math" alttext="\displaystyle\sup_{\mathbf{v}\in\delta\mathbb{S}^{m-1}}\left|\frac{1}{W}\sum_{w=1}^{W}\exp(\mathbf{v}^{\top}\mathbf{Z}_{w})-\mathbb{E}\left[\exp(\mathbf{v}^{\top}\mathbf{Z})\right]\right|=O_{p}\Big(\frac{\log W}{\sqrt{W}}\Big)." display="inline" intent=":literal"><semantics><mrow><mrow><mrow><munder><mo movablelimits="false">sup</mo><mrow><mi>𝐯</mi><mo>∈</mo><mrow><mi>δ</mi><mo lspace="0em" rspace="0em">​</mo><msup><mi>𝕊</mi><mrow><mi>m</mi><mo>−</mo><mn>1</mn></mrow></msup></mrow></mrow></munder><mrow><mo lspace="0em">|</mo><mrow><mrow><mstyle displaystyle="true"><mfrac><mn>1</mn><mi>W</mi></mfrac></mstyle><mo lspace="0em" rspace="0em">​</mo><mrow><mstyle displaystyle="true"><munderover><mo movablelimits="false">∑</mo><mrow><mi>w</mi><mo>=</mo><mn>1</mn></mrow><mi>W</mi></munderover></mstyle><mrow><mi>exp</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mrow><msup><mi>𝐯</mi><mo>⊤</mo></msup><mo lspace="0em" rspace="0em">​</mo><msub><mi>𝐙</mi><mi>w</mi></msub></mrow><mo stretchy="false">)</mo></mrow></mrow></mrow></mrow><mo>−</mo><mrow><mi>𝔼</mi><mo>⁡</mo><mrow><mo>[</mo><mrow><mi>exp</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mrow><msup><mi>𝐯</mi><mo>⊤</mo></msup><mo lspace="0em" rspace="0em">​</mo><mi>𝐙</mi></mrow><mo stretchy="false">)</mo></mrow></mrow><mo>]</mo></mrow></mrow></mrow><mo>|</mo></mrow></mrow><mo>=</mo><mrow><msub><mi>O</mi><mi>p</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo maxsize="1.600em" minsize="1.600em">(</mo><mstyle displaystyle="true"><mfrac><mrow><mi>log</mi><mo lspace="0.167em">⁡</mo><mi>W</mi></mrow><msqrt><mi>W</mi></msqrt></mfrac></mstyle><mo maxsize="1.600em" minsize="1.600em">)</mo></mrow></mrow></mrow><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">\displaystyle\sup_{\mathbf{v}\in\delta\mathbb{S}^{m-1}}\left|\frac{1}{W}\sum_{w=1}^{W}\exp(\mathbf{v}^{\top}\mathbf{Z}_{w})-\mathbb{E}\left[\exp(\mathbf{v}^{\top}\mathbf{Z})\right]\right|=O_{p}\Big(\frac{\log W}{\sqrt{W}}\Big).</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td>
<td rowspan="1" class="ltx_eqn_cell ltx_eqn_eqno ltx_align_middle ltx_align_right"><span class="ltx_tag ltx_tag_equation ltx_align_right">(33)</span></td></tr></tbody>
</table>
<p id="A2.p3.4" class="ltx_p">Similarly, we derive</p>
<table id="A2.EGx45" class="ltx_equationgroup ltx_eqn_align ltx_eqn_table">

<tbody id="A2.E34"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_align_right ltx_eqn_cell"><math id="A2.E34.m1" class="ltx_Math" alttext="\displaystyle\sup_{\mathbf{v}\in\delta\mathbb{S}^{m-1}}\left\|\frac{1}{W}\sum_{w=1}^{W}\exp(\mathbf{v}^{\top}\mathbf{Z}_{w})\mathbf{Z}_{w}-\mathbb{E}\left[\exp(\mathbf{v}^{\top}\mathbf{Z})\mathbf{Z}\right]\right\|_{2}=O_{p}\Big(\frac{\log W}{\sqrt{W}}\Big)." display="inline" intent=":literal"><semantics><mrow><mrow><mrow><munder><mo movablelimits="false">sup</mo><mrow><mi>𝐯</mi><mo>∈</mo><mrow><mi>δ</mi><mo lspace="0em" rspace="0em">​</mo><msup><mi>𝕊</mi><mrow><mi>m</mi><mo>−</mo><mn>1</mn></mrow></msup></mrow></mrow></munder><msub><mrow><mo lspace="0em">‖</mo><mrow><mrow><mstyle displaystyle="true"><mfrac><mn>1</mn><mi>W</mi></mfrac></mstyle><mo lspace="0em" rspace="0em">​</mo><mrow><mstyle displaystyle="true"><munderover><mo movablelimits="false">∑</mo><mrow><mi>w</mi><mo>=</mo><mn>1</mn></mrow><mi>W</mi></munderover></mstyle><mrow><mrow><mi>exp</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mrow><msup><mi>𝐯</mi><mo>⊤</mo></msup><mo lspace="0em" rspace="0em">​</mo><msub><mi>𝐙</mi><mi>w</mi></msub></mrow><mo stretchy="false">)</mo></mrow></mrow><mo lspace="0em" rspace="0em">​</mo><msub><mi>𝐙</mi><mi>w</mi></msub></mrow></mrow></mrow><mo>−</mo><mrow><mi>𝔼</mi><mo>⁡</mo><mrow><mo>[</mo><mrow><mrow><mi>exp</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mrow><msup><mi>𝐯</mi><mo>⊤</mo></msup><mo lspace="0em" rspace="0em">​</mo><mi>𝐙</mi></mrow><mo stretchy="false">)</mo></mrow></mrow><mo lspace="0em" rspace="0em">​</mo><mi>𝐙</mi></mrow><mo>]</mo></mrow></mrow></mrow><mo>‖</mo></mrow><mn>2</mn></msub></mrow><mo>=</mo><mrow><msub><mi>O</mi><mi>p</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo maxsize="1.600em" minsize="1.600em">(</mo><mstyle displaystyle="true"><mfrac><mrow><mi>log</mi><mo lspace="0.167em">⁡</mo><mi>W</mi></mrow><msqrt><mi>W</mi></msqrt></mfrac></mstyle><mo maxsize="1.600em" minsize="1.600em">)</mo></mrow></mrow></mrow><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">\displaystyle\sup_{\mathbf{v}\in\delta\mathbb{S}^{m-1}}\left\|\frac{1}{W}\sum_{w=1}^{W}\exp(\mathbf{v}^{\top}\mathbf{Z}_{w})\mathbf{Z}_{w}-\mathbb{E}\left[\exp(\mathbf{v}^{\top}\mathbf{Z})\mathbf{Z}\right]\right\|_{2}=O_{p}\Big(\frac{\log W}{\sqrt{W}}\Big).</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td>
<td rowspan="1" class="ltx_eqn_cell ltx_eqn_eqno ltx_align_middle ltx_align_right"><span class="ltx_tag ltx_tag_equation ltx_align_right">(34)</span></td></tr></tbody>
</table>
<p id="A2.p3.5" class="ltx_p">By Jensen’s inequality, <math id="A2.p3.m15" class="ltx_Math" alttext="\mathbb{E}[\exp(\mathbf{v}^{\top}\mathbf{Z})]\geq\exp(\mathbb{E}[\mathbf{v}^{\top}\mathbf{Z}])=1" display="inline" intent=":literal"><semantics><mrow><mrow><mi>𝔼</mi><mo>⁡</mo><mrow><mo stretchy="false">[</mo><mrow><mi>exp</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mrow><msup><mi>𝐯</mi><mo>⊤</mo></msup><mo lspace="0em" rspace="0em">​</mo><mi>𝐙</mi></mrow><mo stretchy="false">)</mo></mrow></mrow><mo stretchy="false">]</mo></mrow></mrow><mo>≥</mo><mrow><mi>exp</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mrow><mi>𝔼</mi><mo>⁡</mo><mrow><mo stretchy="false">[</mo><mrow><msup><mi>𝐯</mi><mo>⊤</mo></msup><mo lspace="0em" rspace="0em">​</mo><mi>𝐙</mi></mrow><mo stretchy="false">]</mo></mrow></mrow><mo stretchy="false">)</mo></mrow></mrow><mo>=</mo><mn>1</mn></mrow><annotation encoding="application/x-tex">\mathbb{E}[\exp(\mathbf{v}^{\top}\mathbf{Z})]\geq\exp(\mathbb{E}[\mathbf{v}^{\top}\mathbf{Z}])=1</annotation></semantics></math>.
Using (<a href="#A2.E33" title="In Appendix B Discussion about Assumption ‣ Generalization Bounds for Transformer-Based Next-Token Prediction in a Language Model" class="ltx_ref"><span class="ltx_text ltx_ref_tag">33</span></a>) and (<a href="#A2.E34" title="In Appendix B Discussion about Assumption ‣ Generalization Bounds for Transformer-Based Next-Token Prediction in a Language Model" class="ltx_ref"><span class="ltx_text ltx_ref_tag">34</span></a>), we get the desired result</p>
<table id="A2.EGx46" class="ltx_equationgroup ltx_eqn_align ltx_eqn_table">

<tbody id="A2.Ex89"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_align_right ltx_eqn_cell"><math id="A2.Ex89.m1" class="ltx_Math" alttext="\displaystyle\kappa_{W}" display="inline" intent=":literal"><semantics><msub><mi>κ</mi><mi>W</mi></msub><annotation encoding="application/x-tex">\displaystyle\kappa_{W}</annotation></semantics></math></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A2.Ex89.m2" class="ltx_Math" alttext="\displaystyle=\sup_{\mathbf{v}\in\delta\mathbb{S}^{m-1}}\left\|\frac{\sum_{w=1}^{W}\exp(\mathbf{v}^{\top}\mathbf{Z}_{w})\mathbf{Z}_{w}}{\sum_{w=1}^{W}\exp(\mathbf{v}^{\top}\mathbf{Z}_{w})}-\frac{\mathbb{E}\left[\exp(\mathbf{v}^{\top}\mathbf{Z})\mathbf{Z}\right]}{\mathbb{E}\left[\exp(\mathbf{v}^{\top}\mathbf{Z})\right]}\right\|_{2}" display="inline" intent=":literal"><semantics><mrow><mphantom></mphantom><mo rspace="0.1389em">=</mo><mrow><munder><mo lspace="0.1389em" movablelimits="false" rspace="0em">sup</mo><mrow><mi>𝐯</mi><mo>∈</mo><mrow><mi>δ</mi><mo lspace="0em" rspace="0em">​</mo><msup><mi>𝕊</mi><mrow><mi>m</mi><mo>−</mo><mn>1</mn></mrow></msup></mrow></mrow></munder><msub><mrow><mo>‖</mo><mrow><mstyle displaystyle="true"><mfrac><mrow><msubsup><mo>∑</mo><mrow><mi>w</mi><mo>=</mo><mn>1</mn></mrow><mi>W</mi></msubsup><mrow><mrow><mi>exp</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mrow><msup><mi>𝐯</mi><mo>⊤</mo></msup><mo lspace="0em" rspace="0em">​</mo><msub><mi>𝐙</mi><mi>w</mi></msub></mrow><mo stretchy="false">)</mo></mrow></mrow><mo lspace="0em" rspace="0em">​</mo><msub><mi>𝐙</mi><mi>w</mi></msub></mrow></mrow><mrow><msubsup><mo>∑</mo><mrow><mi>w</mi><mo>=</mo><mn>1</mn></mrow><mi>W</mi></msubsup><mrow><mi>exp</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mrow><msup><mi>𝐯</mi><mo>⊤</mo></msup><mo lspace="0em" rspace="0em">​</mo><msub><mi>𝐙</mi><mi>w</mi></msub></mrow><mo stretchy="false">)</mo></mrow></mrow></mrow></mfrac></mstyle><mo>−</mo><mstyle displaystyle="true"><mfrac><mrow><mi>𝔼</mi><mo>⁡</mo><mrow><mo>[</mo><mrow><mrow><mi>exp</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mrow><msup><mi>𝐯</mi><mo>⊤</mo></msup><mo lspace="0em" rspace="0em">​</mo><mi>𝐙</mi></mrow><mo stretchy="false">)</mo></mrow></mrow><mo lspace="0em" rspace="0em">​</mo><mi>𝐙</mi></mrow><mo>]</mo></mrow></mrow><mrow><mi>𝔼</mi><mo>⁡</mo><mrow><mo>[</mo><mrow><mi>exp</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mrow><msup><mi>𝐯</mi><mo>⊤</mo></msup><mo lspace="0em" rspace="0em">​</mo><mi>𝐙</mi></mrow><mo stretchy="false">)</mo></mrow></mrow><mo>]</mo></mrow></mrow></mfrac></mstyle></mrow><mo>‖</mo></mrow><mn>2</mn></msub></mrow></mrow><annotation encoding="application/x-tex">\displaystyle=\sup_{\mathbf{v}\in\delta\mathbb{S}^{m-1}}\left\|\frac{\sum_{w=1}^{W}\exp(\mathbf{v}^{\top}\mathbf{Z}_{w})\mathbf{Z}_{w}}{\sum_{w=1}^{W}\exp(\mathbf{v}^{\top}\mathbf{Z}_{w})}-\frac{\mathbb{E}\left[\exp(\mathbf{v}^{\top}\mathbf{Z})\mathbf{Z}\right]}{\mathbb{E}\left[\exp(\mathbf{v}^{\top}\mathbf{Z})\right]}\right\|_{2}</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
<tbody id="A2.Ex90"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_eqn_cell"></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A2.Ex90.m1" class="ltx_Math" alttext="\displaystyle\leq\sup_{\mathbf{v}\in\delta\mathbb{S}^{m-1}}\left\|\left(\frac{1}{\frac{1}{W}\sum_{w=1}^{W}\exp(\mathbf{v}^{\top}\mathbf{Z}_{w})}-\frac{1}{\mathbb{E}\left[\exp(\mathbf{v}^{\top}\mathbf{Z})\right]}\right)\frac{1}{W}\sum_{w=1}^{W}\exp(\mathbf{v}^{\top}\mathbf{Z}_{w})\mathbf{Z}_{w}\right\|_{2}" display="inline" intent=":literal"><semantics><mrow><mphantom></mphantom><mo rspace="0.1389em">≤</mo><mrow><munder><mo lspace="0.1389em" movablelimits="false" rspace="0em">sup</mo><mrow><mi>𝐯</mi><mo>∈</mo><mrow><mi>δ</mi><mo lspace="0em" rspace="0em">​</mo><msup><mi>𝕊</mi><mrow><mi>m</mi><mo>−</mo><mn>1</mn></mrow></msup></mrow></mrow></munder><msub><mrow><mo>‖</mo><mrow><mrow><mo>(</mo><mrow><mstyle displaystyle="true"><mfrac><mn>1</mn><mrow><mfrac><mn>1</mn><mi>W</mi></mfrac><mo lspace="0em" rspace="0em">​</mo><mrow><msubsup><mo>∑</mo><mrow><mi>w</mi><mo>=</mo><mn>1</mn></mrow><mi>W</mi></msubsup><mrow><mi>exp</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mrow><msup><mi>𝐯</mi><mo>⊤</mo></msup><mo lspace="0em" rspace="0em">​</mo><msub><mi>𝐙</mi><mi>w</mi></msub></mrow><mo stretchy="false">)</mo></mrow></mrow></mrow></mrow></mfrac></mstyle><mo>−</mo><mstyle displaystyle="true"><mfrac><mn>1</mn><mrow><mi>𝔼</mi><mo>⁡</mo><mrow><mo>[</mo><mrow><mi>exp</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mrow><msup><mi>𝐯</mi><mo>⊤</mo></msup><mo lspace="0em" rspace="0em">​</mo><mi>𝐙</mi></mrow><mo stretchy="false">)</mo></mrow></mrow><mo>]</mo></mrow></mrow></mfrac></mstyle></mrow><mo>)</mo></mrow><mo lspace="0em" rspace="0em">​</mo><mstyle displaystyle="true"><mfrac><mn>1</mn><mi>W</mi></mfrac></mstyle><mo lspace="0em" rspace="0em">​</mo><mrow><mstyle displaystyle="true"><munderover><mo movablelimits="false">∑</mo><mrow><mi>w</mi><mo>=</mo><mn>1</mn></mrow><mi>W</mi></munderover></mstyle><mrow><mrow><mi>exp</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mrow><msup><mi>𝐯</mi><mo>⊤</mo></msup><mo lspace="0em" rspace="0em">​</mo><msub><mi>𝐙</mi><mi>w</mi></msub></mrow><mo stretchy="false">)</mo></mrow></mrow><mo lspace="0em" rspace="0em">​</mo><msub><mi>𝐙</mi><mi>w</mi></msub></mrow></mrow></mrow><mo>‖</mo></mrow><mn>2</mn></msub></mrow></mrow><annotation encoding="application/x-tex">\displaystyle\leq\sup_{\mathbf{v}\in\delta\mathbb{S}^{m-1}}\left\|\left(\frac{1}{\frac{1}{W}\sum_{w=1}^{W}\exp(\mathbf{v}^{\top}\mathbf{Z}_{w})}-\frac{1}{\mathbb{E}\left[\exp(\mathbf{v}^{\top}\mathbf{Z})\right]}\right)\frac{1}{W}\sum_{w=1}^{W}\exp(\mathbf{v}^{\top}\mathbf{Z}_{w})\mathbf{Z}_{w}\right\|_{2}</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
<tbody id="A2.Ex91"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_eqn_cell"></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A2.Ex91.m1" class="ltx_math_unparsed" alttext="\displaystyle\quad+\sup_{\mathbf{v}\in\delta\mathbb{S}^{m-1}}\left\|\frac{\frac{1}{W}\sum_{w=1}^{W}\exp(\mathbf{v}^{\top}\mathbf{Z}_{w})\mathbf{Z}_{w}-\mathbb{E}\left[\exp(\mathbf{v}^{\top}\mathbf{Z})\mathbf{Z}\right]}{\mathbb{E}\left[\exp(\mathbf{v}^{\top}\mathbf{Z})\right]}\right\|_{2}" display="inline" intent=":literal"><semantics><mrow><mo>+</mo><munder><mo lspace="0em" movablelimits="false" rspace="0em">sup</mo><mrow><mi>𝐯</mi><mo>∈</mo><mrow><mi>δ</mi><mo lspace="0em" rspace="0em">​</mo><msup><mi>𝕊</mi><mrow><mi>m</mi><mo>−</mo><mn>1</mn></mrow></msup></mrow></mrow></munder><msub><mrow><mo>‖</mo><mstyle displaystyle="true"><mfrac><mrow><mrow><mfrac><mn>1</mn><mi>W</mi></mfrac><mo lspace="0em" rspace="0em">​</mo><mrow><msubsup><mo>∑</mo><mrow><mi>w</mi><mo>=</mo><mn>1</mn></mrow><mi>W</mi></msubsup><mrow><mrow><mi>exp</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mrow><msup><mi>𝐯</mi><mo>⊤</mo></msup><mo lspace="0em" rspace="0em">​</mo><msub><mi>𝐙</mi><mi>w</mi></msub></mrow><mo stretchy="false">)</mo></mrow></mrow><mo lspace="0em" rspace="0em">​</mo><msub><mi>𝐙</mi><mi>w</mi></msub></mrow></mrow></mrow><mo>−</mo><mrow><mi>𝔼</mi><mo>⁡</mo><mrow><mo>[</mo><mrow><mrow><mi>exp</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mrow><msup><mi>𝐯</mi><mo>⊤</mo></msup><mo lspace="0em" rspace="0em">​</mo><mi>𝐙</mi></mrow><mo stretchy="false">)</mo></mrow></mrow><mo lspace="0em" rspace="0em">​</mo><mi>𝐙</mi></mrow><mo>]</mo></mrow></mrow></mrow><mrow><mi>𝔼</mi><mo>⁡</mo><mrow><mo>[</mo><mrow><mi>exp</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mrow><msup><mi>𝐯</mi><mo>⊤</mo></msup><mo lspace="0em" rspace="0em">​</mo><mi>𝐙</mi></mrow><mo stretchy="false">)</mo></mrow></mrow><mo>]</mo></mrow></mrow></mfrac></mstyle><mo>‖</mo></mrow><mn>2</mn></msub></mrow><annotation encoding="application/x-tex">\displaystyle\quad+\sup_{\mathbf{v}\in\delta\mathbb{S}^{m-1}}\left\|\frac{\frac{1}{W}\sum_{w=1}^{W}\exp(\mathbf{v}^{\top}\mathbf{Z}_{w})\mathbf{Z}_{w}-\mathbb{E}\left[\exp(\mathbf{v}^{\top}\mathbf{Z})\mathbf{Z}\right]}{\mathbb{E}\left[\exp(\mathbf{v}^{\top}\mathbf{Z})\right]}\right\|_{2}</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
<tbody id="A2.Ex92"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_eqn_cell"></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A2.Ex92.m1" class="ltx_Math" alttext="\displaystyle=O_{p}\Big(\frac{\log W}{\sqrt{W}}\Big)." display="inline" intent=":literal"><semantics><mrow><mrow><mphantom></mphantom><mo>=</mo><mrow><msub><mi>O</mi><mi>p</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo maxsize="1.600em" minsize="1.600em">(</mo><mstyle displaystyle="true"><mfrac><mrow><mi>log</mi><mo lspace="0.167em">⁡</mo><mi>W</mi></mrow><msqrt><mi>W</mi></msqrt></mfrac></mstyle><mo maxsize="1.600em" minsize="1.600em">)</mo></mrow></mrow></mrow><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">\displaystyle=O_{p}\Big(\frac{\log W}{\sqrt{W}}\Big).</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
</div>
</section>
<section id="A3" class="ltx_appendix">
<h2 class="ltx_title ltx_title_appendix"><span class="ltx_tag ltx_tag_appendix">Appendix C </span>Proofs for the Stochastic Error</h2>

<div id="A3.p1" class="ltx_para">
<p id="A3.p1.1" class="ltx_p">In this section, we prove Theorem <a href="#Thmconj23" title="Theorem 3. ‣ 4.1 Proof of the risk bound ‣ 4 Risk bound ‣ Generalization Bounds for Transformer-Based Next-Token Prediction in a Language Model" class="ltx_ref"><span class="ltx_text ltx_ref_tag">3</span></a>.
We first establish some basic lemmas that allow us to derive a covering bound by controlling the variation of the model in the individual layers.
The next lemma shows that a bound on the gradient or a uniform bound on the Lipschitz constant with respect to the parameters implies a bound on the covering number. Recall that <math id="A3.p1.m1" class="ltx_Math" alttext="\|\mathbf{f}\|_{L^{\infty}(D)}\coloneq\sup_{\mathbf{x}\in D}\|\mathbf{f}(\mathbf{x})\|_{\infty}" display="inline" intent=":literal"><semantics><mrow><msub><mrow><mo stretchy="false">‖</mo><mi>𝐟</mi><mo stretchy="false">‖</mo></mrow><mrow><msup><mi>L</mi><mi mathvariant="normal">∞</mi></msup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>D</mi><mo stretchy="false">)</mo></mrow></mrow></msub><mo rspace="0.1389em">≔</mo><mrow><msub><mo lspace="0.1389em" rspace="0em">sup</mo><mrow><mi>𝐱</mi><mo>∈</mo><mi>D</mi></mrow></msub><msub><mrow><mo stretchy="false">‖</mo><mrow><mi>𝐟</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>𝐱</mi><mo stretchy="false">)</mo></mrow></mrow><mo stretchy="false">‖</mo></mrow><mi mathvariant="normal">∞</mi></msub></mrow></mrow><annotation encoding="application/x-tex">\|\mathbf{f}\|_{L^{\infty}(D)}\coloneq\sup_{\mathbf{x}\in D}\|\mathbf{f}(\mathbf{x})\|_{\infty}</annotation></semantics></math> with <math id="A3.p1.m2" class="ltx_math_unparsed" alttext="\|\cdot\|_{\infty}" display="inline" intent=":literal"><semantics><mrow><mo rspace="0em">∥</mo><mo lspace="0em" rspace="0em">⋅</mo><mo lspace="0em">∥</mo><msub><mrow></mrow><mi mathvariant="normal">∞</mi></msub></mrow><annotation encoding="application/x-tex">\|\cdot\|_{\infty}</annotation></semantics></math> the maximum entry vector/matrix norm.</p>
</div>
<div id="Thmconj27" class="ltx_theorem ltx_theorem_lemma">
<h6 class="ltx_title ltx_runin ltx_title_theorem"><span class="ltx_tag ltx_tag_theorem"><span id="Thmconj27.4" class="ltx_text ltx_font_bold">Lemma 7</span></span><span id="Thmconj27.5" class="ltx_text ltx_font_bold">.</span></h6>
<div id="Thmconj27.p1" class="ltx_para">
<p id="Thmconj27.p1.1" class="ltx_p"><span id="Thmconj27.p1.1.1" class="ltx_text ltx_font_italic">Let <math id="Thmconj27.p1.m1" class="ltx_Math" alttext="\mathbf{f}_{\bm{\theta}}=(f_{\bm{\theta}}^{(1)},\ldots,f_{\bm{\theta}}^{(q)})^{\top}:D\subset\mathbb{R}^{d}\rightarrow\mathbb{R}^{q}" display="inline" intent=":literal"><semantics><mrow><msub><mi>𝐟</mi><mi>𝛉</mi></msub><mo>=</mo><msup><mrow><mo stretchy="false">(</mo><msubsup><mi>f</mi><mi>𝛉</mi><mrow><mo stretchy="false">(</mo><mn>1</mn><mo stretchy="false">)</mo></mrow></msubsup><mo>,</mo><mi mathvariant="normal">…</mi><mo>,</mo><msubsup><mi>f</mi><mi>𝛉</mi><mrow><mo stretchy="false">(</mo><mi>q</mi><mo stretchy="false">)</mo></mrow></msubsup><mo rspace="0.278em" stretchy="false">)</mo></mrow><mo>⊤</mo></msup><mo rspace="0.278em">:</mo><mrow><mi>D</mi><mo>⊂</mo><msup><mi>ℝ</mi><mi>d</mi></msup><mo stretchy="false">→</mo><msup><mi>ℝ</mi><mi>q</mi></msup></mrow></mrow><annotation encoding="application/x-tex">\mathbf{f}_{\bm{\theta}}=(f_{\bm{\theta}}^{(1)},\ldots,f_{\bm{\theta}}^{(q)})^{\top}:D\subset\mathbb{R}^{d}\rightarrow\mathbb{R}^{q}</annotation></semantics></math> for all <math id="Thmconj27.p1.m2" class="ltx_Math" alttext="\bm{\theta}\in[-B,B]^{r}." display="inline" intent=":literal"><semantics><mrow><mrow><mi>𝛉</mi><mo>∈</mo><msup><mrow><mo stretchy="false">[</mo><mrow><mrow><mo>−</mo><mi>B</mi></mrow><mo>,</mo><mi>B</mi></mrow><mo stretchy="false">]</mo></mrow><mi>r</mi></msup></mrow><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">\bm{\theta}\in[-B,B]^{r}.</annotation></semantics></math> If</span></p>
<table id="A3.EGx47" class="ltx_equationgroup ltx_eqn_align ltx_eqn_table">

<tbody id="A3.Ex93"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_align_right ltx_eqn_cell"><math id="A3.Ex93.m1" class="ltx_Math" alttext="\displaystyle K\coloneq\sup_{\bm{\theta},\bm{\theta}^{\prime}\in[-B,B]^{r},\bm{\theta}\neq\bm{\theta}^{\prime}}\,\frac{\|\mathbf{f}_{\bm{\theta}}-\mathbf{f}_{\bm{\theta}^{\prime}}\|_{L^{\infty}(D)}}{\|\bm{\theta}-\bm{\theta}^{\prime}\|_{\infty}}" display="inline" intent=":literal"><semantics><mrow><mi>K</mi><mo rspace="0.1389em">≔</mo><mrow><munder><mo lspace="0.1389em" movablelimits="false" rspace="0.167em">sup</mo><mrow><mrow><mrow><mi>𝜽</mi><mo>,</mo><msup><mi>𝜽</mi><mo>′</mo></msup></mrow><mo>∈</mo><msup><mrow><mo stretchy="false">[</mo><mrow><mrow><mo>−</mo><mi>B</mi></mrow><mo>,</mo><mi>B</mi></mrow><mo stretchy="false">]</mo></mrow><mi>r</mi></msup></mrow><mo>,</mo><mrow><mi>𝜽</mi><mo>≠</mo><msup><mi>𝜽</mi><mo>′</mo></msup></mrow></mrow></munder><mstyle displaystyle="true"><mfrac><msub><mrow><mo stretchy="false">‖</mo><mrow><msub><mi>𝐟</mi><mi>𝜽</mi></msub><mo>−</mo><msub><mi>𝐟</mi><msup><mi>𝜽</mi><mo>′</mo></msup></msub></mrow><mo stretchy="false">‖</mo></mrow><mrow><msup><mi>L</mi><mi mathvariant="normal">∞</mi></msup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>D</mi><mo stretchy="false">)</mo></mrow></mrow></msub><msub><mrow><mo stretchy="false">‖</mo><mrow><mi>𝜽</mi><mo>−</mo><msup><mi>𝜽</mi><mo>′</mo></msup></mrow><mo stretchy="false">‖</mo></mrow><mi mathvariant="normal">∞</mi></msub></mfrac></mstyle></mrow></mrow><annotation encoding="application/x-tex">\displaystyle K\coloneq\sup_{\bm{\theta},\bm{\theta}^{\prime}\in[-B,B]^{r},\bm{\theta}\neq\bm{\theta}^{\prime}}\,\frac{\|\mathbf{f}_{\bm{\theta}}-\mathbf{f}_{\bm{\theta}^{\prime}}\|_{L^{\infty}(D)}}{\|\bm{\theta}-\bm{\theta}^{\prime}\|_{\infty}}</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="Thmconj27.p1.2" class="ltx_p"><span id="Thmconj27.p1.2.1" class="ltx_text ltx_font_italic">exists and is finite, then,</span></p>
<table id="A3.EGx48" class="ltx_equationgroup ltx_eqn_align ltx_eqn_table">

<tbody id="A3.Ex94"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_align_right ltx_eqn_cell"><math id="A3.Ex94.m1" class="ltx_math_unparsed" alttext="\displaystyle\log\mathcal{N}\Big(\delta,\big\{\mathbf{f}_{\bm{\theta}}:\bm{\theta}\in[-B,B]^{r}\big\},\|\cdot\|_{L^{\infty}(D)}\Big)\leq r\log\Big(3+\frac{KB}{\delta}\Big)." display="inline" intent=":literal"><semantics><mrow><mi>log</mi><mi class="ltx_font_mathcaligraphic">𝒩</mi><mrow><mo maxsize="1.600em" minsize="1.600em">(</mo><mi>δ</mi><mo>,</mo><mrow><mo stretchy="false">{</mo><msub><mi>𝐟</mi><mi>𝜽</mi></msub><mo lspace="0.278em" rspace="0.278em">:</mo><mi>𝜽</mi><mo>∈</mo><msup><mrow><mo stretchy="false">[</mo><mo lspace="0em">−</mo><mi>B</mi><mo>,</mo><mi>B</mi><mo stretchy="false">]</mo></mrow><mi>r</mi></msup><mo stretchy="false">}</mo></mrow><mo>,</mo><mo lspace="0em" rspace="0em">∥</mo><mo lspace="0em" rspace="0em">⋅</mo><msub><mo lspace="0em" rspace="0.167em">∥</mo><mrow><msup><mi>L</mi><mi mathvariant="normal">∞</mi></msup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>D</mi><mo stretchy="false">)</mo></mrow></mrow></msub><mo maxsize="1.600em" minsize="1.600em">)</mo></mrow><mo>≤</mo><mi>r</mi><mi>log</mi><mrow><mo maxsize="1.600em" minsize="1.600em">(</mo><mn>3</mn><mo>+</mo><mstyle displaystyle="true"><mfrac><mrow><mi>K</mi><mo lspace="0em" rspace="0em">​</mo><mi>B</mi></mrow><mi>δ</mi></mfrac></mstyle><mo maxsize="1.600em" minsize="1.600em">)</mo></mrow><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">\displaystyle\log\mathcal{N}\Big(\delta,\big\{\mathbf{f}_{\bm{\theta}}:\bm{\theta}\in[-B,B]^{r}\big\},\|\cdot\|_{L^{\infty}(D)}\Big)\leq r\log\Big(3+\frac{KB}{\delta}\Big).</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="Thmconj27.p1.3" class="ltx_p"><span id="Thmconj27.p1.3.1" class="ltx_text ltx_font_italic">Moreover, if the gradients <math id="Thmconj27.p1.m3" class="ltx_Math" alttext="\nabla_{\bm{\theta}}f_{\bm{\theta}}^{(j)}(\mathbf{x})" display="inline" intent=":literal"><semantics><mrow><mrow><msub><mo>∇</mo><mi>𝛉</mi></msub><msubsup><mi>f</mi><mi>𝛉</mi><mrow><mo stretchy="false">(</mo><mi>j</mi><mo stretchy="false">)</mo></mrow></msubsup></mrow><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>𝐱</mi><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">\nabla_{\bm{\theta}}f_{\bm{\theta}}^{(j)}(\mathbf{x})</annotation></semantics></math> of the component functions <math id="Thmconj27.p1.m4" class="ltx_Math" alttext="f_{\bm{\theta}}^{(j)}" display="inline" intent=":literal"><semantics><msubsup><mi>f</mi><mi>𝛉</mi><mrow><mo stretchy="false">(</mo><mi>j</mi><mo stretchy="false">)</mo></mrow></msubsup><annotation encoding="application/x-tex">f_{\bm{\theta}}^{(j)}</annotation></semantics></math> exist for all <math id="Thmconj27.p1.m5" class="ltx_Math" alttext="\bm{\theta}\in[-B,B]^{r},\,\mathbf{x}\in D" display="inline" intent=":literal"><semantics><mrow><mrow><mi>𝛉</mi><mo>∈</mo><msup><mrow><mo stretchy="false">[</mo><mrow><mrow><mo>−</mo><mi>B</mi></mrow><mo>,</mo><mi>B</mi></mrow><mo stretchy="false">]</mo></mrow><mi>r</mi></msup></mrow><mo rspace="0.337em">,</mo><mrow><mi>𝐱</mi><mo>∈</mo><mi>D</mi></mrow></mrow><annotation encoding="application/x-tex">\bm{\theta}\in[-B,B]^{r},\,\mathbf{x}\in D</annotation></semantics></math> and are continuous in <math id="Thmconj27.p1.m6" class="ltx_Math" alttext="\bm{\theta}," display="inline" intent=":literal"><semantics><mrow><mi>𝛉</mi><mo>,</mo></mrow><annotation encoding="application/x-tex">\bm{\theta},</annotation></semantics></math> then,</span></p>
<table id="A3.EGx49" class="ltx_equationgroup ltx_eqn_align ltx_eqn_table">

<tbody id="A3.E35"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_align_right ltx_eqn_cell"><math id="A3.E35.m1" class="ltx_Math" alttext="\displaystyle K=\sup_{\bm{\theta}\in[-B,B]^{r},\,\mathbf{x}\in D}\,\,\max_{j=1,\ldots,q}\,\big\|\nabla_{\bm{\theta}}f_{\bm{\theta}}^{(j)}(\mathbf{x})\big\|_{1}." display="inline" intent=":literal"><semantics><mrow><mrow><mi>K</mi><mo rspace="0.1389em">=</mo><mrow><munder><mo lspace="0.1389em" movablelimits="false" rspace="0.167em">sup</mo><mrow><mrow><mi>𝜽</mi><mo>∈</mo><msup><mrow><mo stretchy="false">[</mo><mrow><mrow><mo>−</mo><mi>B</mi></mrow><mo>,</mo><mi>B</mi></mrow><mo stretchy="false">]</mo></mrow><mi>r</mi></msup></mrow><mo rspace="0.337em">,</mo><mrow><mi>𝐱</mi><mo>∈</mo><mi>D</mi></mrow></mrow></munder><mrow><munder><mi>max</mi><mrow><mrow><mi>j</mi><mo>=</mo><mn>1</mn></mrow><mo>,</mo><mi mathvariant="normal">…</mi><mo>,</mo><mi>q</mi></mrow></munder><mo>⁡</mo><msub><mrow><mo maxsize="1.200em" minsize="1.200em" stretchy="true">‖</mo><mrow><mrow><msub><mo rspace="0.167em">∇</mo><mi>𝜽</mi></msub><msubsup><mi>f</mi><mi>𝜽</mi><mrow><mo stretchy="false">(</mo><mi>j</mi><mo stretchy="false">)</mo></mrow></msubsup></mrow><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>𝐱</mi><mo stretchy="false">)</mo></mrow></mrow><mo maxsize="1.200em" minsize="1.200em" stretchy="true">‖</mo></mrow><mn>1</mn></msub></mrow></mrow></mrow><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">\displaystyle K=\sup_{\bm{\theta}\in[-B,B]^{r},\,\mathbf{x}\in D}\,\,\max_{j=1,\ldots,q}\,\big\|\nabla_{\bm{\theta}}f_{\bm{\theta}}^{(j)}(\mathbf{x})\big\|_{1}.</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td>
<td rowspan="1" class="ltx_eqn_cell ltx_eqn_eqno ltx_align_middle ltx_align_right"><span class="ltx_tag ltx_tag_equation ltx_align_right">(35)</span></td></tr></tbody>
</table>
</div>
</div>
<div id="A3.2" class="ltx_proof">
<h6 class="ltx_title ltx_runin ltx_font_italic ltx_title_proof">Proof.</h6>
<div id="A3.p2" class="ltx_para">
<p id="A3.p2.1" class="ltx_p"><span id="A3.p2.1.1" class="ltx_text">Whenever <math id="A3.p2.m1" class="ltx_Math" alttext="\bm{\theta},\bm{\theta}^{\prime}\in[-B,B]^{r},\bm{\theta}\neq\bm{\theta}^{\prime}," display="inline" intent=":literal"><semantics><mrow><mrow><mrow><mrow><mi>𝜽</mi><mo>,</mo><msup><mi>𝜽</mi><mo>′</mo></msup></mrow><mo>∈</mo><msup><mrow><mo stretchy="false">[</mo><mrow><mrow><mo>−</mo><mi>B</mi></mrow><mo>,</mo><mi>B</mi></mrow><mo stretchy="false">]</mo></mrow><mi>r</mi></msup></mrow><mo>,</mo><mrow><mi>𝜽</mi><mo>≠</mo><msup><mi>𝜽</mi><mo>′</mo></msup></mrow></mrow><mo>,</mo></mrow><annotation encoding="application/x-tex">\bm{\theta},\bm{\theta}^{\prime}\in[-B,B]^{r},\bm{\theta}\neq\bm{\theta}^{\prime},</annotation></semantics></math> we have <math id="A3.p2.m2" class="ltx_Math" alttext="\|\mathbf{f}_{\bm{\theta}}-\mathbf{f}_{\bm{\theta}^{\prime}}\|_{L^{\infty}(D)}\leq K\|\bm{\theta}-\bm{\theta}^{\prime}\|_{\infty}." display="inline" intent=":literal"><semantics><mrow><mrow><msub><mrow><mo stretchy="false">‖</mo><mrow><msub><mi>𝐟</mi><mi>𝜽</mi></msub><mo>−</mo><msub><mi>𝐟</mi><msup><mi>𝜽</mi><mo>′</mo></msup></msub></mrow><mo stretchy="false">‖</mo></mrow><mrow><msup><mi>L</mi><mi mathvariant="normal">∞</mi></msup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>D</mi><mo stretchy="false">)</mo></mrow></mrow></msub><mo>≤</mo><mrow><mi>K</mi><mo lspace="0em" rspace="0em">​</mo><msub><mrow><mo stretchy="false">‖</mo><mrow><mi>𝜽</mi><mo>−</mo><msup><mi>𝜽</mi><mo>′</mo></msup></mrow><mo stretchy="false">‖</mo></mrow><mi mathvariant="normal">∞</mi></msub></mrow></mrow><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">\|\mathbf{f}_{\bm{\theta}}-\mathbf{f}_{\bm{\theta}^{\prime}}\|_{L^{\infty}(D)}\leq K\|\bm{\theta}-\bm{\theta}^{\prime}\|_{\infty}.</annotation></semantics></math> To construct a covering, take parameters in the discrete set <math id="A3.p2.m3" class="ltx_Math" alttext="\Theta\coloneq\{-B,B\}\cup\{\tfrac{2\delta}{K}\mathbb{Z}\cap(-B,B)\}^{r}." display="inline" intent=":literal"><semantics><mrow><mrow><mi mathvariant="normal">Θ</mi><mo>≔</mo><mrow><mrow><mo stretchy="false">{</mo><mrow><mrow><mo>−</mo><mi>B</mi></mrow><mo>,</mo><mi>B</mi></mrow><mo stretchy="false">}</mo></mrow><mo>∪</mo><msup><mrow><mo stretchy="false">{</mo><mrow><mrow><mfrac><mrow><mn>2</mn><mo lspace="0em" rspace="0em">​</mo><mi>δ</mi></mrow><mi>K</mi></mfrac><mo lspace="0em" rspace="0em">​</mo><mi>ℤ</mi></mrow><mo>∩</mo><mrow><mo stretchy="false">(</mo><mrow><mo>−</mo><mi>B</mi></mrow><mo>,</mo><mi>B</mi><mo stretchy="false">)</mo></mrow></mrow><mo stretchy="false">}</mo></mrow><mi>r</mi></msup></mrow></mrow><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">\Theta\coloneq\{-B,B\}\cup\{\tfrac{2\delta}{K}\mathbb{Z}\cap(-B,B)\}^{r}.</annotation></semantics></math> The length of the interval is <math id="A3.p2.m4" class="ltx_Math" alttext="2B" display="inline" intent=":literal"><semantics><mrow><mn>2</mn><mo lspace="0em" rspace="0em">​</mo><mi>B</mi></mrow><annotation encoding="application/x-tex">2B</annotation></semantics></math> and thus the cardinality of this set is <math id="A3.p2.m5" class="ltx_Math" alttext="\leq(3+KB/\delta)^{r}." display="inline" intent=":literal"><semantics><mrow><mrow><mphantom></mphantom><mo>≤</mo><msup><mrow><mo stretchy="false">(</mo><mrow><mn>3</mn><mo>+</mo><mrow><mrow><mi>K</mi><mo lspace="0em" rspace="0em">​</mo><mi>B</mi></mrow><mo>/</mo><mi>δ</mi></mrow></mrow><mo stretchy="false">)</mo></mrow><mi>r</mi></msup></mrow><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">\leq(3+KB/\delta)^{r}.</annotation></semantics></math> This set provides the centers of a <math id="A3.p2.m6" class="ltx_Math" alttext="\delta" display="inline" intent=":literal"><semantics><mi>δ</mi><annotation encoding="application/x-tex">\delta</annotation></semantics></math>-covering of the function class.</span></p>
</div>
<div id="A3.p3" class="ltx_para">
<p id="A3.p3.1" class="ltx_p"><span id="A3.p3.1.1" class="ltx_text">To prove <math id="A3.p3.m1" class="ltx_Math" alttext="\leq" display="inline" intent=":literal"><semantics><mo>≤</mo><annotation encoding="application/x-tex">\leq</annotation></semantics></math> in (<a href="#A3.E35" title="In Lemma 7. ‣ Appendix C Proofs for the Stochastic Error ‣ Generalization Bounds for Transformer-Based Next-Token Prediction in a Language Model" class="ltx_ref"><span class="ltx_text ltx_ref_tag">35</span></a>), Taylor expansion with respect to the parameter vector shows that for any <math id="A3.p3.m2" class="ltx_Math" alttext="\bm{\theta},\bm{\theta}^{\prime}\in[-B,B]^{r}," display="inline" intent=":literal"><semantics><mrow><mrow><mi>𝜽</mi><mo>,</mo><mrow><msup><mi>𝜽</mi><mo>′</mo></msup><mo>∈</mo><msup><mrow><mo stretchy="false">[</mo><mrow><mrow><mo>−</mo><mi>B</mi></mrow><mo>,</mo><mi>B</mi></mrow><mo stretchy="false">]</mo></mrow><mi>r</mi></msup></mrow></mrow><mo>,</mo></mrow><annotation encoding="application/x-tex">\bm{\theta},\bm{\theta}^{\prime}\in[-B,B]^{r},</annotation></semantics></math> there exists a <math id="A3.p3.m3" class="ltx_Math" alttext="\bm{\xi}\in[-B,B]^{r}" display="inline" intent=":literal"><semantics><mrow><mi>𝝃</mi><mo>∈</mo><msup><mrow><mo stretchy="false">[</mo><mrow><mrow><mo>−</mo><mi>B</mi></mrow><mo>,</mo><mi>B</mi></mrow><mo stretchy="false">]</mo></mrow><mi>r</mi></msup></mrow><annotation encoding="application/x-tex">\bm{\xi}\in[-B,B]^{r}</annotation></semantics></math> such that <math id="A3.p3.m4" class="ltx_Math" alttext="f_{\bm{\theta}}^{(j)}(\mathbf{x})-f_{\bm{\theta}^{\prime}}^{(j)}(\mathbf{x})=\big(\nabla_{\bm{\theta}}f_{\bm{\xi}}^{(j)}(\mathbf{x})\big)^{\top}\big(\bm{\theta}-\bm{\theta}^{\prime})" display="inline" intent=":literal"><semantics><mrow><mrow><mrow><msubsup><mi>f</mi><mi>𝜽</mi><mrow><mo stretchy="false">(</mo><mi>j</mi><mo stretchy="false">)</mo></mrow></msubsup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>𝐱</mi><mo stretchy="false">)</mo></mrow></mrow><mo>−</mo><mrow><msubsup><mi>f</mi><msup><mi>𝜽</mi><mo>′</mo></msup><mrow><mo stretchy="false">(</mo><mi>j</mi><mo stretchy="false">)</mo></mrow></msubsup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>𝐱</mi><mo stretchy="false">)</mo></mrow></mrow></mrow><mo>=</mo><mrow><msup><mrow><mo maxsize="1.200em" minsize="1.200em">(</mo><mrow><mrow><msub><mo rspace="0.167em">∇</mo><mi>𝜽</mi></msub><msubsup><mi>f</mi><mi>𝝃</mi><mrow><mo stretchy="false">(</mo><mi>j</mi><mo stretchy="false">)</mo></mrow></msubsup></mrow><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>𝐱</mi><mo stretchy="false">)</mo></mrow></mrow><mo maxsize="1.200em" minsize="1.200em">)</mo></mrow><mo>⊤</mo></msup><mo lspace="0em" rspace="0em">​</mo><mrow><mo maxsize="1.200em" minsize="1.200em">(</mo><mrow><mi>𝜽</mi><mo>−</mo><msup><mi>𝜽</mi><mo>′</mo></msup></mrow><mo stretchy="false">)</mo></mrow></mrow></mrow><annotation encoding="application/x-tex">f_{\bm{\theta}}^{(j)}(\mathbf{x})-f_{\bm{\theta}^{\prime}}^{(j)}(\mathbf{x})=\big(\nabla_{\bm{\theta}}f_{\bm{\xi}}^{(j)}(\mathbf{x})\big)^{\top}\big(\bm{\theta}-\bm{\theta}^{\prime})</annotation></semantics></math> and therefore
<math id="A3.p3.m5" class="ltx_Math" alttext="\max_{j=1,\ldots,q}\,|f_{\bm{\theta}}^{(j)}(\mathbf{x})-f_{\bm{\theta}^{\prime}}^{(j)}(\mathbf{x})|\leq\sup_{\bm{\theta}\in[-B,B]^{r}}\,\max_{j=1,\ldots,q}\,\|\nabla_{\bm{\theta}}f_{\bm{\theta}}^{(j)}(\mathbf{x})\|_{1}\|\bm{\theta}-\bm{\theta}^{\prime}\|_{\infty}." display="inline" intent=":literal"><semantics><mrow><mrow><mrow><msub><mi>max</mi><mrow><mrow><mi>j</mi><mo>=</mo><mn>1</mn></mrow><mo>,</mo><mi mathvariant="normal">…</mi><mo>,</mo><mi>q</mi></mrow></msub><mo lspace="0.170em">⁡</mo><mrow><mo stretchy="false">|</mo><mrow><mrow><msubsup><mi>f</mi><mi>𝜽</mi><mrow><mo stretchy="false">(</mo><mi>j</mi><mo stretchy="false">)</mo></mrow></msubsup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>𝐱</mi><mo stretchy="false">)</mo></mrow></mrow><mo>−</mo><mrow><msubsup><mi>f</mi><msup><mi>𝜽</mi><mo>′</mo></msup><mrow><mo stretchy="false">(</mo><mi>j</mi><mo stretchy="false">)</mo></mrow></msubsup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>𝐱</mi><mo stretchy="false">)</mo></mrow></mrow></mrow><mo stretchy="false">|</mo></mrow></mrow><mo rspace="0.1389em">≤</mo><mrow><msub><mo lspace="0.1389em" rspace="0.167em">sup</mo><mrow><mi>𝜽</mi><mo>∈</mo><msup><mrow><mo stretchy="false">[</mo><mrow><mrow><mo>−</mo><mi>B</mi></mrow><mo>,</mo><mi>B</mi></mrow><mo stretchy="false">]</mo></mrow><mi>r</mi></msup></mrow></msub><mrow><mrow><msub><mi>max</mi><mrow><mrow><mi>j</mi><mo>=</mo><mn>1</mn></mrow><mo>,</mo><mi mathvariant="normal">…</mi><mo>,</mo><mi>q</mi></mrow></msub><mo>⁡</mo><msub><mrow><mo stretchy="false">‖</mo><mrow><mrow><msub><mo rspace="0.167em">∇</mo><mi>𝜽</mi></msub><msubsup><mi>f</mi><mi>𝜽</mi><mrow><mo stretchy="false">(</mo><mi>j</mi><mo stretchy="false">)</mo></mrow></msubsup></mrow><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>𝐱</mi><mo stretchy="false">)</mo></mrow></mrow><mo stretchy="false">‖</mo></mrow><mn>1</mn></msub></mrow><mo lspace="0em" rspace="0em">​</mo><msub><mrow><mo stretchy="false">‖</mo><mrow><mi>𝜽</mi><mo>−</mo><msup><mi>𝜽</mi><mo>′</mo></msup></mrow><mo stretchy="false">‖</mo></mrow><mi mathvariant="normal">∞</mi></msub></mrow></mrow></mrow><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">\max_{j=1,\ldots,q}\,|f_{\bm{\theta}}^{(j)}(\mathbf{x})-f_{\bm{\theta}^{\prime}}^{(j)}(\mathbf{x})|\leq\sup_{\bm{\theta}\in[-B,B]^{r}}\,\max_{j=1,\ldots,q}\,\|\nabla_{\bm{\theta}}f_{\bm{\theta}}^{(j)}(\mathbf{x})\|_{1}\|\bm{\theta}-\bm{\theta}^{\prime}\|_{\infty}.</annotation></semantics></math></span></p>
</div>
<div id="A3.p4" class="ltx_para">
<p id="A3.p4.1" class="ltx_p"><span id="A3.p4.1.1" class="ltx_text">To show <math id="A3.p4.m1" class="ltx_Math" alttext="\geq" display="inline" intent=":literal"><semantics><mo>≥</mo><annotation encoding="application/x-tex">\geq</annotation></semantics></math> in (<a href="#A3.E35" title="In Lemma 7. ‣ Appendix C Proofs for the Stochastic Error ‣ Generalization Bounds for Transformer-Based Next-Token Prediction in a Language Model" class="ltx_ref"><span class="ltx_text ltx_ref_tag">35</span></a>), consider a <math id="A3.p4.m2" class="ltx_Math" alttext="\bm{\theta}\in(-B,B)^{r}." display="inline" intent=":literal"><semantics><mrow><mrow><mi>𝜽</mi><mo>∈</mo><msup><mrow><mo stretchy="false">(</mo><mrow><mo>−</mo><mi>B</mi></mrow><mo>,</mo><mi>B</mi><mo stretchy="false">)</mo></mrow><mi>r</mi></msup></mrow><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">\bm{\theta}\in(-B,B)^{r}.</annotation></semantics></math> By choosing <math id="A3.p4.m3" class="ltx_Math" alttext="\alpha&gt;0" display="inline" intent=":literal"><semantics><mrow><mi>α</mi><mo>&gt;</mo><mn>0</mn></mrow><annotation encoding="application/x-tex">\alpha&gt;0</annotation></semantics></math> small enough, we can ensure that <math id="A3.p4.m4" class="ltx_Math" alttext="\bm{\theta}_{\alpha}^{\prime}(j,\mathbf{x})\coloneq\bm{\theta}-\alpha{\;\text{sign}}(\nabla_{\bm{\theta}}f_{\bm{\theta}}^{(j)}(\mathbf{x}))\in(-B,B)^{r}," display="inline" intent=":literal"><semantics><mrow><mrow><mrow><msubsup><mi>𝜽</mi><mi>α</mi><mo>′</mo></msubsup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>j</mi><mo>,</mo><mi>𝐱</mi><mo stretchy="false">)</mo></mrow></mrow><mo>≔</mo><mrow><mi>𝜽</mi><mo>−</mo><mrow><mi>α</mi><mo lspace="0.280em" rspace="0em">​</mo><mtext>sign</mtext><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mrow><mrow><msub><mo rspace="0.167em">∇</mo><mi>𝜽</mi></msub><msubsup><mi>f</mi><mi>𝜽</mi><mrow><mo stretchy="false">(</mo><mi>j</mi><mo stretchy="false">)</mo></mrow></msubsup></mrow><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>𝐱</mi><mo stretchy="false">)</mo></mrow></mrow><mo stretchy="false">)</mo></mrow></mrow></mrow><mo>∈</mo><msup><mrow><mo stretchy="false">(</mo><mrow><mo>−</mo><mi>B</mi></mrow><mo>,</mo><mi>B</mi><mo stretchy="false">)</mo></mrow><mi>r</mi></msup></mrow><mo>,</mo></mrow><annotation encoding="application/x-tex">\bm{\theta}_{\alpha}^{\prime}(j,\mathbf{x})\coloneq\bm{\theta}-\alpha{\;\text{sign}}(\nabla_{\bm{\theta}}f_{\bm{\theta}}^{(j)}(\mathbf{x}))\in(-B,B)^{r},</annotation></semantics></math> where the sign function <math id="A3.p4.m5" class="ltx_Math" alttext="{\;\text{sign}}()" display="inline" intent=":literal"><semantics><mrow><mtext>sign</mtext><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">{\;\text{sign}}()</annotation></semantics></math> is applied componentwise. Using the definition of the gradient and <math id="A3.p4.m6" class="ltx_Math" alttext="\alpha=\|\bm{\theta}-\bm{\theta}_{\alpha}^{\prime}(j,\mathbf{x})\|_{\infty}," display="inline" intent=":literal"><semantics><mrow><mrow><mi>α</mi><mo>=</mo><msub><mrow><mo stretchy="false">‖</mo><mrow><mi>𝜽</mi><mo>−</mo><mrow><msubsup><mi>𝜽</mi><mi>α</mi><mo>′</mo></msubsup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>j</mi><mo>,</mo><mi>𝐱</mi><mo stretchy="false">)</mo></mrow></mrow></mrow><mo stretchy="false">‖</mo></mrow><mi mathvariant="normal">∞</mi></msub></mrow><mo>,</mo></mrow><annotation encoding="application/x-tex">\alpha=\|\bm{\theta}-\bm{\theta}_{\alpha}^{\prime}(j,\mathbf{x})\|_{\infty},</annotation></semantics></math> we have for <math id="A3.p4.m7" class="ltx_Math" alttext="\alpha\downarrow 0," display="inline" intent=":literal"><semantics><mrow><mrow><mi>α</mi><mo stretchy="false">↓</mo><mn>0</mn></mrow><mo>,</mo></mrow><annotation encoding="application/x-tex">\alpha\downarrow 0,</annotation></semantics></math></span></p>
<table id="A3.EGx50" class="ltx_equationgroup ltx_eqn_align ltx_eqn_table">

<tbody id="A3.Ex95"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_align_right ltx_eqn_cell"><math id="A3.Ex95.m1" class="ltx_Math" alttext="\displaystyle\big\|\nabla_{\bm{\theta}}f_{\bm{\theta}}^{(j)}(\mathbf{x})\big\|_{1}=\frac{1}{\alpha}\nabla_{\bm{\theta}}f_{\bm{\theta}}^{(j)}(\mathbf{x})^{\top}\big(\bm{\theta}-\bm{\theta}_{\alpha}^{\prime}(j,\mathbf{x})\big)=\frac{f_{\bm{\theta}}^{(j)}(\mathbf{x})-f_{\bm{\theta}_{\alpha}^{\prime}(j,\mathbf{x})}^{(j)}(\mathbf{x})}{\|\bm{\theta}-\bm{\theta}_{\alpha}^{\prime}(j,\mathbf{x})\|_{\infty}}+o(1)." display="inline" intent=":literal"><semantics><mrow><mrow><msub><mrow><mo maxsize="1.200em" minsize="1.200em" stretchy="true">‖</mo><mrow><mrow><msub><mo rspace="0.167em">∇</mo><mi>𝜽</mi></msub><msubsup><mi>f</mi><mi>𝜽</mi><mrow><mo stretchy="false">(</mo><mi>j</mi><mo stretchy="false">)</mo></mrow></msubsup></mrow><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>𝐱</mi><mo stretchy="false">)</mo></mrow></mrow><mo maxsize="1.200em" minsize="1.200em" stretchy="true">‖</mo></mrow><mn>1</mn></msub><mo>=</mo><mrow><mstyle displaystyle="true"><mfrac><mn>1</mn><mi>α</mi></mfrac></mstyle><mo lspace="0.167em" rspace="0em">​</mo><mrow><msub><mo rspace="0.167em">∇</mo><mi>𝜽</mi></msub><msubsup><mi>f</mi><mi>𝜽</mi><mrow><mo stretchy="false">(</mo><mi>j</mi><mo stretchy="false">)</mo></mrow></msubsup></mrow><mo lspace="0em" rspace="0em">​</mo><msup><mrow><mo stretchy="false">(</mo><mi>𝐱</mi><mo stretchy="false">)</mo></mrow><mo>⊤</mo></msup><mo lspace="0em" rspace="0em">​</mo><mrow><mo maxsize="1.200em" minsize="1.200em">(</mo><mrow><mi>𝜽</mi><mo>−</mo><mrow><msubsup><mi>𝜽</mi><mi>α</mi><mo>′</mo></msubsup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>j</mi><mo>,</mo><mi>𝐱</mi><mo stretchy="false">)</mo></mrow></mrow></mrow><mo maxsize="1.200em" minsize="1.200em">)</mo></mrow></mrow><mo>=</mo><mrow><mstyle displaystyle="true"><mfrac><mrow><mrow><msubsup><mi>f</mi><mi>𝜽</mi><mrow><mo stretchy="false">(</mo><mi>j</mi><mo stretchy="false">)</mo></mrow></msubsup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>𝐱</mi><mo stretchy="false">)</mo></mrow></mrow><mo>−</mo><mrow><msubsup><mi>f</mi><mrow><msubsup><mi>𝜽</mi><mi>α</mi><mo>′</mo></msubsup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>j</mi><mo>,</mo><mi>𝐱</mi><mo stretchy="false">)</mo></mrow></mrow><mrow><mo stretchy="false">(</mo><mi>j</mi><mo stretchy="false">)</mo></mrow></msubsup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>𝐱</mi><mo stretchy="false">)</mo></mrow></mrow></mrow><msub><mrow><mo stretchy="false">‖</mo><mrow><mi>𝜽</mi><mo>−</mo><mrow><msubsup><mi>𝜽</mi><mi>α</mi><mo>′</mo></msubsup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>j</mi><mo>,</mo><mi>𝐱</mi><mo stretchy="false">)</mo></mrow></mrow></mrow><mo stretchy="false">‖</mo></mrow><mi mathvariant="normal">∞</mi></msub></mfrac></mstyle><mo>+</mo><mrow><mi>o</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mn>1</mn><mo stretchy="false">)</mo></mrow></mrow></mrow></mrow><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">\displaystyle\big\|\nabla_{\bm{\theta}}f_{\bm{\theta}}^{(j)}(\mathbf{x})\big\|_{1}=\frac{1}{\alpha}\nabla_{\bm{\theta}}f_{\bm{\theta}}^{(j)}(\mathbf{x})^{\top}\big(\bm{\theta}-\bm{\theta}_{\alpha}^{\prime}(j,\mathbf{x})\big)=\frac{f_{\bm{\theta}}^{(j)}(\mathbf{x})-f_{\bm{\theta}_{\alpha}^{\prime}(j,\mathbf{x})}^{(j)}(\mathbf{x})}{\|\bm{\theta}-\bm{\theta}_{\alpha}^{\prime}(j,\mathbf{x})\|_{\infty}}+o(1).</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="A3.p4.2" class="ltx_p"><span id="A3.p4.2.1" class="ltx_text">Due to the assumed continuity of the gradients in <math id="A3.p4.m8" class="ltx_Math" alttext="\bm{\theta}," display="inline" intent=":literal"><semantics><mrow><mi>𝜽</mi><mo>,</mo></mrow><annotation encoding="application/x-tex">\bm{\theta},</annotation></semantics></math> we obtain</span></p>
<table id="A3.EGx51" class="ltx_equationgroup ltx_eqn_align ltx_eqn_table">

<tbody id="A3.Ex96"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_align_right ltx_eqn_cell"><math id="A3.Ex96.m1" class="ltx_Math" alttext="\displaystyle\sup_{\bm{\theta}\in[-B,B]^{r},\,\mathbf{x}\in D}\,\,\max_{j=1,\ldots,q}\,\big\|\nabla_{\bm{\theta}}f_{\bm{\theta}}^{(j)}(\mathbf{x})\big\|_{1}=\sup_{\bm{\theta}\in(-B,B)^{r},\,\mathbf{x}\in D}\,\,\max_{j=1,\ldots,q}\,\big\|\nabla_{\bm{\theta}}f_{\bm{\theta}}^{(j)}(\mathbf{x})\big\|_{1}\leq K." display="inline" intent=":literal"><semantics><mrow><mrow><mrow><munder><mo movablelimits="false">sup</mo><mrow><mrow><mi>𝜽</mi><mo>∈</mo><msup><mrow><mo stretchy="false">[</mo><mrow><mrow><mo>−</mo><mi>B</mi></mrow><mo>,</mo><mi>B</mi></mrow><mo stretchy="false">]</mo></mrow><mi>r</mi></msup></mrow><mo rspace="0.337em">,</mo><mrow><mi>𝐱</mi><mo>∈</mo><mi>D</mi></mrow></mrow></munder><mrow><munder><mi>max</mi><mrow><mrow><mi>j</mi><mo>=</mo><mn>1</mn></mrow><mo>,</mo><mi mathvariant="normal">…</mi><mo>,</mo><mi>q</mi></mrow></munder><mo>⁡</mo><msub><mrow><mo maxsize="1.200em" minsize="1.200em" stretchy="true">‖</mo><mrow><mrow><msub><mo rspace="0.167em">∇</mo><mi>𝜽</mi></msub><msubsup><mi>f</mi><mi>𝜽</mi><mrow><mo stretchy="false">(</mo><mi>j</mi><mo stretchy="false">)</mo></mrow></msubsup></mrow><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>𝐱</mi><mo stretchy="false">)</mo></mrow></mrow><mo maxsize="1.200em" minsize="1.200em" stretchy="true">‖</mo></mrow><mn>1</mn></msub></mrow></mrow><mo rspace="0.1389em">=</mo><mrow><munder><mo lspace="0.1389em" movablelimits="false" rspace="0.167em">sup</mo><mrow><mrow><mi>𝜽</mi><mo>∈</mo><msup><mrow><mo stretchy="false">(</mo><mrow><mo>−</mo><mi>B</mi></mrow><mo>,</mo><mi>B</mi><mo stretchy="false">)</mo></mrow><mi>r</mi></msup></mrow><mo rspace="0.337em">,</mo><mrow><mi>𝐱</mi><mo>∈</mo><mi>D</mi></mrow></mrow></munder><mrow><munder><mi>max</mi><mrow><mrow><mi>j</mi><mo>=</mo><mn>1</mn></mrow><mo>,</mo><mi mathvariant="normal">…</mi><mo>,</mo><mi>q</mi></mrow></munder><mo>⁡</mo><msub><mrow><mo maxsize="1.200em" minsize="1.200em" stretchy="true">‖</mo><mrow><mrow><msub><mo rspace="0.167em">∇</mo><mi>𝜽</mi></msub><msubsup><mi>f</mi><mi>𝜽</mi><mrow><mo stretchy="false">(</mo><mi>j</mi><mo stretchy="false">)</mo></mrow></msubsup></mrow><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>𝐱</mi><mo stretchy="false">)</mo></mrow></mrow><mo maxsize="1.200em" minsize="1.200em" stretchy="true">‖</mo></mrow><mn>1</mn></msub></mrow></mrow><mo>≤</mo><mi>K</mi></mrow><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">\displaystyle\sup_{\bm{\theta}\in[-B,B]^{r},\,\mathbf{x}\in D}\,\,\max_{j=1,\ldots,q}\,\big\|\nabla_{\bm{\theta}}f_{\bm{\theta}}^{(j)}(\mathbf{x})\big\|_{1}=\sup_{\bm{\theta}\in(-B,B)^{r},\,\mathbf{x}\in D}\,\,\max_{j=1,\ldots,q}\,\big\|\nabla_{\bm{\theta}}f_{\bm{\theta}}^{(j)}(\mathbf{x})\big\|_{1}\leq K.</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="A3.p4.3" class="ltx_p"><span id="A3.p4.3.1" class="ltx_text">As we already established the other inequality, we must have equality and (<a href="#A3.E35" title="In Lemma 7. ‣ Appendix C Proofs for the Stochastic Error ‣ Generalization Bounds for Transformer-Based Next-Token Prediction in a Language Model" class="ltx_ref"><span class="ltx_text ltx_ref_tag">35</span></a>) holds.
∎</span></p>
</div>
</div>
<div id="A3.p5" class="ltx_para">
<p id="A3.p5.1" class="ltx_p">The next lemma provides a generic tool to control the covering number of function compositions. Similarly as in the backpropagation algorithm, it shows that the overall parameter variation of a hierarchical model can be controlled by the layerwise variation with respect to the inputs and the parameters.</p>
</div>
<div id="Thmconj28" class="ltx_theorem ltx_theorem_lemma">
<h6 class="ltx_title ltx_runin ltx_title_theorem"><span class="ltx_tag ltx_tag_theorem"><span id="Thmconj28.4" class="ltx_text ltx_font_bold">Lemma 8</span></span><span id="Thmconj28.5" class="ltx_text ltx_font_bold">.</span></h6>
<div id="Thmconj28.p1" class="ltx_para">
<p id="Thmconj28.p1.1" class="ltx_p"><span id="Thmconj28.p1.1.1" class="ltx_text ltx_font_italic">For <math id="Thmconj28.p1.m1" class="ltx_Math" alttext="q" display="inline" intent=":literal"><semantics><mi>q</mi><annotation encoding="application/x-tex">q</annotation></semantics></math> a positive integer, consider dimensions <math id="Thmconj28.p1.m2" class="ltx_Math" alttext="r_{1},\ldots,r_{q}," display="inline" intent=":literal"><semantics><mrow><mrow><msub><mi>r</mi><mn>1</mn></msub><mo>,</mo><mi mathvariant="normal">…</mi><mo>,</mo><msub><mi>r</mi><mi>q</mi></msub></mrow><mo>,</mo></mrow><annotation encoding="application/x-tex">r_{1},\ldots,r_{q},</annotation></semantics></math> domains <math id="Thmconj28.p1.m3" class="ltx_Math" alttext="D_{0},\ldots,D_{q}," display="inline" intent=":literal"><semantics><mrow><mrow><msub><mi>D</mi><mn>0</mn></msub><mo>,</mo><mi mathvariant="normal">…</mi><mo>,</mo><msub><mi>D</mi><mi>q</mi></msub></mrow><mo>,</mo></mrow><annotation encoding="application/x-tex">D_{0},\ldots,D_{q},</annotation></semantics></math> and functions <math id="Thmconj28.p1.m4" class="ltx_Math" alttext="\mathbf{f}_{1,\bm{\theta}_{1}},\ldots,\mathbf{f}_{q,\bm{\theta}_{q}}" display="inline" intent=":literal"><semantics><mrow><msub><mi>𝐟</mi><mrow><mn>1</mn><mo>,</mo><msub><mi>𝛉</mi><mn>1</mn></msub></mrow></msub><mo>,</mo><mi mathvariant="normal">…</mi><mo>,</mo><msub><mi>𝐟</mi><mrow><mi>q</mi><mo>,</mo><msub><mi>𝛉</mi><mi>q</mi></msub></mrow></msub></mrow><annotation encoding="application/x-tex">\mathbf{f}_{1,\bm{\theta}_{1}},\ldots,\mathbf{f}_{q,\bm{\theta}_{q}}</annotation></semantics></math> such that for any <math id="Thmconj28.p1.m5" class="ltx_Math" alttext="\bm{\theta}_{j}\in[-B,B]^{r_{j}}," display="inline" intent=":literal"><semantics><mrow><mrow><msub><mi>𝛉</mi><mi>j</mi></msub><mo>∈</mo><msup><mrow><mo stretchy="false">[</mo><mrow><mrow><mo>−</mo><mi>B</mi></mrow><mo>,</mo><mi>B</mi></mrow><mo stretchy="false">]</mo></mrow><msub><mi>r</mi><mi>j</mi></msub></msup></mrow><mo>,</mo></mrow><annotation encoding="application/x-tex">\bm{\theta}_{j}\in[-B,B]^{r_{j}},</annotation></semantics></math> <math id="Thmconj28.p1.m6" class="ltx_Math" alttext="\mathbf{f}_{j,\bm{\theta}_{j}}:D_{j-1}\rightarrow D_{j}." display="inline" intent=":literal"><semantics><mrow><mrow><msub><mi>𝐟</mi><mrow><mi>j</mi><mo>,</mo><msub><mi>𝛉</mi><mi>j</mi></msub></mrow></msub><mo lspace="0.278em" rspace="0.278em">:</mo><mrow><msub><mi>D</mi><mrow><mi>j</mi><mo>−</mo><mn>1</mn></mrow></msub><mo stretchy="false">→</mo><msub><mi>D</mi><mi>j</mi></msub></mrow></mrow><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">\mathbf{f}_{j,\bm{\theta}_{j}}:D_{j-1}\rightarrow D_{j}.</annotation></semantics></math> Write</span></p>
<table id="A3.EGx52" class="ltx_equationgroup ltx_eqn_align ltx_eqn_table">

<tbody id="A3.Ex97"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_align_right ltx_eqn_cell"><math id="A3.Ex97.m1" class="ltx_Math" alttext="\displaystyle K_{j}\coloneq\sup_{\bm{\theta}_{j},\bm{\theta}_{j}^{\prime}\in[-B,B]^{r_{j}},\bm{\theta}_{j}\neq\bm{\theta}^{\prime}_{j}}\,\frac{\|\mathbf{f}_{j,\bm{\theta}_{j}}-\mathbf{f}_{j,\bm{\theta}^{\prime}_{j}}\|_{L^{\infty}(D_{j-1})}}{\|\bm{\theta}_{j}-\bm{\theta}^{\prime}_{j}\|_{\infty}},\quad Q_{j}\coloneq\sup_{\bm{\theta}_{j}\in[-B,B]^{r_{j}},\mathbf{x},\mathbf{x}^{\prime}\in D_{j-1},\mathbf{x}\neq\mathbf{x}^{\prime}}\,\frac{\|\mathbf{f}_{j,\bm{\theta}_{j}}(\mathbf{x})-\mathbf{f}_{j,\bm{\theta}_{j}}(\mathbf{x}^{\prime})\|_{\infty}}{\|\mathbf{x}-\mathbf{x}^{\prime}\|_{\infty}}," display="inline" intent=":literal"><semantics><mrow><mrow><mrow><msub><mi>K</mi><mi>j</mi></msub><mo rspace="0.1389em">≔</mo><mrow><munder><mo lspace="0.1389em" movablelimits="false" rspace="0.167em">sup</mo><mrow><mrow><mrow><msub><mi>𝜽</mi><mi>j</mi></msub><mo>,</mo><msubsup><mi>𝜽</mi><mi>j</mi><mo>′</mo></msubsup></mrow><mo>∈</mo><msup><mrow><mo stretchy="false">[</mo><mrow><mrow><mo>−</mo><mi>B</mi></mrow><mo>,</mo><mi>B</mi></mrow><mo stretchy="false">]</mo></mrow><msub><mi>r</mi><mi>j</mi></msub></msup></mrow><mo>,</mo><mrow><msub><mi>𝜽</mi><mi>j</mi></msub><mo>≠</mo><msubsup><mi>𝜽</mi><mi>j</mi><mo>′</mo></msubsup></mrow></mrow></munder><mstyle displaystyle="true"><mfrac><msub><mrow><mo stretchy="false">‖</mo><mrow><msub><mi>𝐟</mi><mrow><mi>j</mi><mo>,</mo><msub><mi>𝜽</mi><mi>j</mi></msub></mrow></msub><mo>−</mo><msub><mi>𝐟</mi><mrow><mi>j</mi><mo>,</mo><msubsup><mi>𝜽</mi><mi>j</mi><mo>′</mo></msubsup></mrow></msub></mrow><mo stretchy="false">‖</mo></mrow><mrow><msup><mi>L</mi><mi mathvariant="normal">∞</mi></msup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mi>D</mi><mrow><mi>j</mi><mo>−</mo><mn>1</mn></mrow></msub><mo stretchy="false">)</mo></mrow></mrow></msub><msub><mrow><mo stretchy="false">‖</mo><mrow><msub><mi>𝜽</mi><mi>j</mi></msub><mo>−</mo><msubsup><mi>𝜽</mi><mi>j</mi><mo>′</mo></msubsup></mrow><mo stretchy="false">‖</mo></mrow><mi mathvariant="normal">∞</mi></msub></mfrac></mstyle></mrow></mrow><mo rspace="1.167em">,</mo><mrow><msub><mi>Q</mi><mi>j</mi></msub><mo rspace="0.1389em">≔</mo><mrow><munder><mo lspace="0.1389em" movablelimits="false" rspace="0.167em">sup</mo><mrow><mrow><msub><mi>𝜽</mi><mi>j</mi></msub><mo>∈</mo><msup><mrow><mo stretchy="false">[</mo><mrow><mrow><mo>−</mo><mi>B</mi></mrow><mo>,</mo><mi>B</mi></mrow><mo stretchy="false">]</mo></mrow><msub><mi>r</mi><mi>j</mi></msub></msup></mrow><mo>,</mo><mi>𝐱</mi><mo>,</mo><mrow><msup><mi>𝐱</mi><mo>′</mo></msup><mo>∈</mo><msub><mi>D</mi><mrow><mi>j</mi><mo>−</mo><mn>1</mn></mrow></msub></mrow><mo>,</mo><mrow><mi>𝐱</mi><mo>≠</mo><msup><mi>𝐱</mi><mo>′</mo></msup></mrow></mrow></munder><mstyle displaystyle="true"><mfrac><msub><mrow><mo stretchy="false">‖</mo><mrow><mrow><msub><mi>𝐟</mi><mrow><mi>j</mi><mo>,</mo><msub><mi>𝜽</mi><mi>j</mi></msub></mrow></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>𝐱</mi><mo stretchy="false">)</mo></mrow></mrow><mo>−</mo><mrow><msub><mi>𝐟</mi><mrow><mi>j</mi><mo>,</mo><msub><mi>𝜽</mi><mi>j</mi></msub></mrow></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msup><mi>𝐱</mi><mo>′</mo></msup><mo stretchy="false">)</mo></mrow></mrow></mrow><mo stretchy="false">‖</mo></mrow><mi mathvariant="normal">∞</mi></msub><msub><mrow><mo stretchy="false">‖</mo><mrow><mi>𝐱</mi><mo>−</mo><msup><mi>𝐱</mi><mo>′</mo></msup></mrow><mo stretchy="false">‖</mo></mrow><mi mathvariant="normal">∞</mi></msub></mfrac></mstyle></mrow></mrow></mrow><mo>,</mo></mrow><annotation encoding="application/x-tex">\displaystyle K_{j}\coloneq\sup_{\bm{\theta}_{j},\bm{\theta}_{j}^{\prime}\in[-B,B]^{r_{j}},\bm{\theta}_{j}\neq\bm{\theta}^{\prime}_{j}}\,\frac{\|\mathbf{f}_{j,\bm{\theta}_{j}}-\mathbf{f}_{j,\bm{\theta}^{\prime}_{j}}\|_{L^{\infty}(D_{j-1})}}{\|\bm{\theta}_{j}-\bm{\theta}^{\prime}_{j}\|_{\infty}},\quad Q_{j}\coloneq\sup_{\bm{\theta}_{j}\in[-B,B]^{r_{j}},\mathbf{x},\mathbf{x}^{\prime}\in D_{j-1},\mathbf{x}\neq\mathbf{x}^{\prime}}\,\frac{\|\mathbf{f}_{j,\bm{\theta}_{j}}(\mathbf{x})-\mathbf{f}_{j,\bm{\theta}_{j}}(\mathbf{x}^{\prime})\|_{\infty}}{\|\mathbf{x}-\mathbf{x}^{\prime}\|_{\infty}},</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="Thmconj28.p1.2" class="ltx_p"><span id="Thmconj28.p1.2.1" class="ltx_text ltx_font_italic">for the Lipschitz constants of the individual functions with respect to the parameters and the inputs. Then, for <math id="Thmconj28.p1.m7" class="ltx_Math" alttext="\bm{\theta}=(\bm{\theta}_{1},\ldots,\bm{\theta}_{q})" display="inline" intent=":literal"><semantics><mrow><mi>𝛉</mi><mo>=</mo><mrow><mo stretchy="false">(</mo><msub><mi>𝛉</mi><mn>1</mn></msub><mo>,</mo><mi mathvariant="normal">…</mi><mo>,</mo><msub><mi>𝛉</mi><mi>q</mi></msub><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">\bm{\theta}=(\bm{\theta}_{1},\ldots,\bm{\theta}_{q})</annotation></semantics></math> and <math id="Thmconj28.p1.m8" class="ltx_Math" alttext="\bm{\theta}^{\prime}=(\bm{\theta}^{\prime}_{1},\ldots,\bm{\theta}^{\prime}_{q})," display="inline" intent=":literal"><semantics><mrow><mrow><msup><mi>𝛉</mi><mo>′</mo></msup><mo>=</mo><mrow><mo stretchy="false">(</mo><msubsup><mi>𝛉</mi><mn>1</mn><mo>′</mo></msubsup><mo>,</mo><mi mathvariant="normal">…</mi><mo>,</mo><msubsup><mi>𝛉</mi><mi>q</mi><mo>′</mo></msubsup><mo stretchy="false">)</mo></mrow></mrow><mo>,</mo></mrow><annotation encoding="application/x-tex">\bm{\theta}^{\prime}=(\bm{\theta}^{\prime}_{1},\ldots,\bm{\theta}^{\prime}_{q}),</annotation></semantics></math></span></p>
<table id="A3.EGx53" class="ltx_equationgroup ltx_eqn_align ltx_eqn_table">

<tbody id="A3.Ex98"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_align_right ltx_eqn_cell"><math id="A3.Ex98.m1" class="ltx_Math" alttext="\displaystyle\sup_{\bm{\theta},\bm{\theta}^{\prime}\in[-B,B]^{r_{1}+\ldots+r_{q}},\,\bm{\theta}\neq\bm{\theta}^{\prime}}\frac{\|\mathbf{f}_{q,\bm{\theta}_{q}}\circ\ldots\circ\mathbf{f}_{1,\bm{\theta}_{1}}-\mathbf{f}_{q,\bm{\theta}_{q}^{\prime}}\circ\ldots\circ\mathbf{f}_{1,\bm{\theta}_{1}^{\prime}}\|_{L^{\infty}(D_{0})}}{\|\bm{\theta}-\bm{\theta}^{\prime}\|_{\infty}}\leq K_{q}+\sum_{\ell=1}^{q-1}Q_{q}\ldots Q_{\ell+1}K_{\ell}." display="inline" intent=":literal"><semantics><mrow><mrow><mrow><munder><mo movablelimits="false">sup</mo><mrow><mrow><mrow><mi>𝜽</mi><mo>,</mo><msup><mi>𝜽</mi><mo>′</mo></msup></mrow><mo>∈</mo><msup><mrow><mo stretchy="false">[</mo><mrow><mrow><mo>−</mo><mi>B</mi></mrow><mo>,</mo><mi>B</mi></mrow><mo stretchy="false">]</mo></mrow><mrow><msub><mi>r</mi><mn>1</mn></msub><mo>+</mo><mi mathvariant="normal">…</mi><mo>+</mo><msub><mi>r</mi><mi>q</mi></msub></mrow></msup></mrow><mo rspace="0.337em">,</mo><mrow><mi>𝜽</mi><mo>≠</mo><msup><mi>𝜽</mi><mo>′</mo></msup></mrow></mrow></munder><mstyle displaystyle="true"><mfrac><msub><mrow><mo stretchy="false">‖</mo><mrow><mrow><msub><mi>𝐟</mi><mrow><mi>q</mi><mo>,</mo><msub><mi>𝜽</mi><mi>q</mi></msub></mrow></msub><mo lspace="0.222em" rspace="0.222em">∘</mo><mi mathvariant="normal">…</mi><mo lspace="0.222em" rspace="0.222em">∘</mo><msub><mi>𝐟</mi><mrow><mn>1</mn><mo>,</mo><msub><mi>𝜽</mi><mn>1</mn></msub></mrow></msub></mrow><mo>−</mo><mrow><msub><mi>𝐟</mi><mrow><mi>q</mi><mo>,</mo><msubsup><mi>𝜽</mi><mi>q</mi><mo>′</mo></msubsup></mrow></msub><mo lspace="0.222em" rspace="0.222em">∘</mo><mi mathvariant="normal">…</mi><mo lspace="0.222em" rspace="0.222em">∘</mo><msub><mi>𝐟</mi><mrow><mn>1</mn><mo>,</mo><msubsup><mi>𝜽</mi><mn>1</mn><mo>′</mo></msubsup></mrow></msub></mrow></mrow><mo stretchy="false">‖</mo></mrow><mrow><msup><mi>L</mi><mi mathvariant="normal">∞</mi></msup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mi>D</mi><mn>0</mn></msub><mo stretchy="false">)</mo></mrow></mrow></msub><msub><mrow><mo stretchy="false">‖</mo><mrow><mi>𝜽</mi><mo>−</mo><msup><mi>𝜽</mi><mo>′</mo></msup></mrow><mo stretchy="false">‖</mo></mrow><mi mathvariant="normal">∞</mi></msub></mfrac></mstyle></mrow><mo>≤</mo><mrow><msub><mi>K</mi><mi>q</mi></msub><mo>+</mo><mrow><mstyle displaystyle="true"><munderover><mo movablelimits="false">∑</mo><mrow><mi mathvariant="normal">ℓ</mi><mo>=</mo><mn>1</mn></mrow><mrow><mi>q</mi><mo>−</mo><mn>1</mn></mrow></munderover></mstyle><mrow><msub><mi>Q</mi><mi>q</mi></msub><mo lspace="0em" rspace="0em">​</mo><mi mathvariant="normal">…</mi><mo lspace="0em" rspace="0em">​</mo><msub><mi>Q</mi><mrow><mi mathvariant="normal">ℓ</mi><mo>+</mo><mn>1</mn></mrow></msub><mo lspace="0em" rspace="0em">​</mo><msub><mi>K</mi><mi mathvariant="normal">ℓ</mi></msub></mrow></mrow></mrow></mrow><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">\displaystyle\sup_{\bm{\theta},\bm{\theta}^{\prime}\in[-B,B]^{r_{1}+\ldots+r_{q}},\,\bm{\theta}\neq\bm{\theta}^{\prime}}\frac{\|\mathbf{f}_{q,\bm{\theta}_{q}}\circ\ldots\circ\mathbf{f}_{1,\bm{\theta}_{1}}-\mathbf{f}_{q,\bm{\theta}_{q}^{\prime}}\circ\ldots\circ\mathbf{f}_{1,\bm{\theta}_{1}^{\prime}}\|_{L^{\infty}(D_{0})}}{\|\bm{\theta}-\bm{\theta}^{\prime}\|_{\infty}}\leq K_{q}+\sum_{\ell=1}^{q-1}Q_{q}\ldots Q_{\ell+1}K_{\ell}.</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
</div>
</div>
<div id="A3.p6" class="ltx_para">
<p id="A3.p6.1" class="ltx_p">Combined with Lemma <a href="#Thmconj27" title="Lemma 7. ‣ Appendix C Proofs for the Stochastic Error ‣ Generalization Bounds for Transformer-Based Next-Token Prediction in a Language Model" class="ltx_ref"><span class="ltx_text ltx_ref_tag">7</span></a> this gives for any <math id="A3.p6.m1" class="ltx_Math" alttext="\delta&gt;0," display="inline" intent=":literal"><semantics><mrow><mrow><mi>δ</mi><mo>&gt;</mo><mn>0</mn></mrow><mo>,</mo></mrow><annotation encoding="application/x-tex">\delta&gt;0,</annotation></semantics></math></p>
<table id="A3.EGx54" class="ltx_equationgroup ltx_eqn_align ltx_eqn_table">

<tbody id="A3.E36"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td colspan="2" class="ltx_td ltx_align_center ltx_eqn_cell"><math id="A3.E36.m1" class="ltx_Math" alttext="\displaystyle\begin{split}&amp;\log\,\mathcal{N}\bigg(\delta,\Big\{\mathbf{f}_{q,\bm{\theta}_{q}}\circ\ldots\circ\mathbf{f}_{1,\bm{\theta}_{1}}:\bm{\theta}_{q}\in[-B,B]^{r_{q}},\ldots,\bm{\theta}_{1}\in[-B,B]^{r_{1}}\Big\},\|\cdot\|_{L^{\infty}(D_{0})}\bigg)\\
&amp;\leq\sum_{j=1}^{q}r_{j}\log\bigg(3+\frac{B}{\delta}\Big(K_{q}+\sum_{\ell=1}^{q-1}Q_{q}\ldots Q_{\ell+1}K_{\ell}\Big)\bigg).\end{split}" display="inline" intent=":literal"><semantics><mtable columnspacing="0pt" rowspacing="0pt"><mtr><mtd></mtd><mtd class="ltx_align_left" columnalign="left"><mrow><mi>log</mi><mi class="ltx_font_mathcaligraphic">𝒩</mi><mo maxsize="2.100em" minsize="2.100em">(</mo><mi>δ</mi><mo>,</mo><mo stretchy="false">{</mo><mi>𝐟</mi><msub><mrow></mrow><mrow><mi>q</mi><mo>,</mo><msub><mi>𝜽</mi><mi>q</mi></msub></mrow></msub><mo lspace="0.222em" rspace="0.222em">∘</mo><mi mathvariant="normal">…</mi><mo lspace="0.222em" rspace="0.222em">∘</mo><mi>𝐟</mi><msub><mrow></mrow><mrow><mn>1</mn><mo>,</mo><msub><mi>𝜽</mi><mn>1</mn></msub></mrow></msub><mo lspace="0.278em" rspace="0.278em">:</mo><mi>𝜽</mi><msub><mrow></mrow><mi>q</mi></msub><mo>∈</mo><mo stretchy="false">[</mo><mo lspace="0em">−</mo><mi>B</mi><mo>,</mo><mi>B</mi><mo stretchy="false">]</mo><msup><mrow></mrow><msub><mi>r</mi><mi>q</mi></msub></msup><mo>,</mo><mi mathvariant="normal">…</mi><mo>,</mo><mi>𝜽</mi><msub><mrow></mrow><mn>1</mn></msub><mo>∈</mo><mo stretchy="false">[</mo><mo lspace="0em">−</mo><mi>B</mi><mo>,</mo><mi>B</mi><mo stretchy="false">]</mo><msup><mrow></mrow><msub><mi>r</mi><mn>1</mn></msub></msup><mo stretchy="false">}</mo><mo>,</mo><mo lspace="0em" rspace="0em">∥</mo><mo lspace="0em" rspace="0em">⋅</mo><mo lspace="0em" rspace="0.167em">∥</mo><msub><mrow></mrow><mrow><msup><mi>L</mi><mi mathvariant="normal">∞</mi></msup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mi>D</mi><mn>0</mn></msub><mo stretchy="false">)</mo></mrow></mrow></msub><mo maxsize="2.100em" minsize="2.100em">)</mo></mrow></mtd></mtr><mtr><mtd></mtd><mtd class="ltx_align_left" columnalign="left"><mrow><mrow><mphantom></mphantom><mo>≤</mo><mrow><mstyle displaystyle="true"><munderover><mo movablelimits="false">∑</mo><mrow><mi>j</mi><mo>=</mo><mn>1</mn></mrow><mi>q</mi></munderover></mstyle><mrow><msub><mi>r</mi><mi>j</mi></msub><mo lspace="0.167em" rspace="0em">​</mo><mrow><mi>log</mi><mo>⁡</mo><mrow><mo maxsize="2.100em" minsize="2.100em">(</mo><mrow><mn>3</mn><mo>+</mo><mrow><mstyle displaystyle="true"><mfrac><mi>B</mi><mi>δ</mi></mfrac></mstyle><mo lspace="0em" rspace="0em">​</mo><mrow><mo maxsize="1.600em" minsize="1.600em">(</mo><mrow><msub><mi>K</mi><mi>q</mi></msub><mo>+</mo><mrow><mstyle displaystyle="true"><munderover><mo movablelimits="false">∑</mo><mrow><mi mathvariant="normal">ℓ</mi><mo>=</mo><mn>1</mn></mrow><mrow><mi>q</mi><mo>−</mo><mn>1</mn></mrow></munderover></mstyle><mrow><msub><mi>Q</mi><mi>q</mi></msub><mo lspace="0em" rspace="0em">​</mo><mi mathvariant="normal">…</mi><mo lspace="0em" rspace="0em">​</mo><msub><mi>Q</mi><mrow><mi mathvariant="normal">ℓ</mi><mo>+</mo><mn>1</mn></mrow></msub><mo lspace="0em" rspace="0em">​</mo><msub><mi>K</mi><mi mathvariant="normal">ℓ</mi></msub></mrow></mrow></mrow><mo maxsize="1.600em" minsize="1.600em">)</mo></mrow></mrow></mrow><mo maxsize="2.100em" minsize="2.100em">)</mo></mrow></mrow></mrow></mrow></mrow><mo lspace="0em">.</mo></mrow></mtd></mtr></mtable><annotation encoding="application/x-tex">\displaystyle\begin{split}&amp;\log\,\mathcal{N}\bigg(\delta,\Big\{\mathbf{f}_{q,\bm{\theta}_{q}}\circ\ldots\circ\mathbf{f}_{1,\bm{\theta}_{1}}:\bm{\theta}_{q}\in[-B,B]^{r_{q}},\ldots,\bm{\theta}_{1}\in[-B,B]^{r_{1}}\Big\},\|\cdot\|_{L^{\infty}(D_{0})}\bigg)\\
&amp;\leq\sum_{j=1}^{q}r_{j}\log\bigg(3+\frac{B}{\delta}\Big(K_{q}+\sum_{\ell=1}^{q-1}Q_{q}\ldots Q_{\ell+1}K_{\ell}\Big)\bigg).\end{split}</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td>
<td rowspan="1" class="ltx_eqn_cell ltx_eqn_eqno ltx_align_middle ltx_align_right"><span class="ltx_tag ltx_tag_equation ltx_align_right">(36)</span></td></tr></tbody>
</table>
<p id="A3.p6.2" class="ltx_p">If the gradients with respect to <math id="A3.p6.m2" class="ltx_Math" alttext="\bm{\theta}=(\bm{\theta}_{1},\ldots,\bm{\theta}_{q})" display="inline" intent=":literal"><semantics><mrow><mi>𝜽</mi><mo>=</mo><mrow><mo stretchy="false">(</mo><msub><mi>𝜽</mi><mn>1</mn></msub><mo>,</mo><mi mathvariant="normal">…</mi><mo>,</mo><msub><mi>𝜽</mi><mi>q</mi></msub><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">\bm{\theta}=(\bm{\theta}_{1},\ldots,\bm{\theta}_{q})</annotation></semantics></math> exist and are continuous, applying the second claim of Lemma <a href="#Thmconj27" title="Lemma 7. ‣ Appendix C Proofs for the Stochastic Error ‣ Generalization Bounds for Transformer-Based Next-Token Prediction in a Language Model" class="ltx_ref"><span class="ltx_text ltx_ref_tag">7</span></a> and the previous lemma provides a bound on the <math id="A3.p6.m3" class="ltx_math_unparsed" alttext="\|\cdot\|_{1}" display="inline" intent=":literal"><semantics><mrow><mo rspace="0em">∥</mo><mo lspace="0em" rspace="0em">⋅</mo><mo lspace="0em">∥</mo><msub><mrow></mrow><mn>1</mn></msub></mrow><annotation encoding="application/x-tex">\|\cdot\|_{1}</annotation></semantics></math>-norm of the gradients.</p>
</div>
<div id="A3.3" class="ltx_proof">
<h6 class="ltx_title ltx_runin ltx_font_italic ltx_title_proof">Proof.</h6>
<div id="A3.p7" class="ltx_para">
<p id="A3.p7.1" class="ltx_p"><span id="A3.p7.1.1" class="ltx_text">We prove the inequality by induction on <math id="A3.p7.m1" class="ltx_Math" alttext="q." display="inline" intent=":literal"><semantics><mrow><mi>q</mi><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">q.</annotation></semantics></math> For <math id="A3.p7.m2" class="ltx_Math" alttext="q=1," display="inline" intent=":literal"><semantics><mrow><mrow><mi>q</mi><mo>=</mo><mn>1</mn></mrow><mo>,</mo></mrow><annotation encoding="application/x-tex">q=1,</annotation></semantics></math> the inequality holds. The induction step <math id="A3.p7.m3" class="ltx_Math" alttext="(q-1)\rightarrow q" display="inline" intent=":literal"><semantics><mrow><mrow><mo stretchy="false">(</mo><mrow><mi>q</mi><mo>−</mo><mn>1</mn></mrow><mo stretchy="false">)</mo></mrow><mo stretchy="false">→</mo><mi>q</mi></mrow><annotation encoding="application/x-tex">(q-1)\rightarrow q</annotation></semantics></math> follows by applying the triangle inequality from</span></p>
<table id="A3.EGx55" class="ltx_equationgroup ltx_eqn_align ltx_eqn_table">

<tbody id="A3.Ex99"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_eqn_cell"></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A3.Ex99.m1" class="ltx_Math" alttext="\displaystyle\big\|\mathbf{f}_{q,\bm{\theta}_{q}}\circ\ldots\circ\mathbf{f}_{1,\bm{\theta}_{1}}-\mathbf{f}_{q,\bm{\theta}_{q}^{\prime}}\circ\ldots\circ\mathbf{f}_{1,\bm{\theta}_{1}^{\prime}}\big\|_{L^{\infty}(D_{0})}" display="inline" intent=":literal"><semantics><msub><mrow><mo maxsize="1.200em" minsize="1.200em" stretchy="true">‖</mo><mrow><mrow><msub><mi>𝐟</mi><mrow><mi>q</mi><mo>,</mo><msub><mi>𝜽</mi><mi>q</mi></msub></mrow></msub><mo lspace="0.222em" rspace="0.222em">∘</mo><mi mathvariant="normal">…</mi><mo lspace="0.222em" rspace="0.222em">∘</mo><msub><mi>𝐟</mi><mrow><mn>1</mn><mo>,</mo><msub><mi>𝜽</mi><mn>1</mn></msub></mrow></msub></mrow><mo>−</mo><mrow><msub><mi>𝐟</mi><mrow><mi>q</mi><mo>,</mo><msubsup><mi>𝜽</mi><mi>q</mi><mo>′</mo></msubsup></mrow></msub><mo lspace="0.222em" rspace="0.222em">∘</mo><mi mathvariant="normal">…</mi><mo lspace="0.222em" rspace="0.222em">∘</mo><msub><mi>𝐟</mi><mrow><mn>1</mn><mo>,</mo><msubsup><mi>𝜽</mi><mn>1</mn><mo>′</mo></msubsup></mrow></msub></mrow></mrow><mo maxsize="1.200em" minsize="1.200em" stretchy="true">‖</mo></mrow><mrow><msup><mi>L</mi><mi mathvariant="normal">∞</mi></msup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mi>D</mi><mn>0</mn></msub><mo stretchy="false">)</mo></mrow></mrow></msub><annotation encoding="application/x-tex">\displaystyle\big\|\mathbf{f}_{q,\bm{\theta}_{q}}\circ\ldots\circ\mathbf{f}_{1,\bm{\theta}_{1}}-\mathbf{f}_{q,\bm{\theta}_{q}^{\prime}}\circ\ldots\circ\mathbf{f}_{1,\bm{\theta}_{1}^{\prime}}\big\|_{L^{\infty}(D_{0})}</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
<tbody id="A3.Ex100"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_eqn_cell"></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A3.Ex100.m1" class="ltx_Math" alttext="\displaystyle\leq\big\|\mathbf{f}_{q,\bm{\theta}_{q}}\circ\mathbf{f}_{q-1,\bm{\theta}_{q-1}}\circ\ldots\circ\mathbf{f}_{1,\bm{\theta}_{1}}-\mathbf{f}_{q,\bm{\theta}_{q}}\circ\mathbf{f}_{q-1,\bm{\theta}_{q-1}^{\prime}}\circ\ldots\circ\mathbf{f}_{1,\bm{\theta}_{1}^{\prime}}\big\|_{L^{\infty}(D_{0})}" display="inline" intent=":literal"><semantics><mrow><mphantom></mphantom><mo>≤</mo><msub><mrow><mo maxsize="1.200em" minsize="1.200em" stretchy="true">‖</mo><mrow><mrow><msub><mi>𝐟</mi><mrow><mi>q</mi><mo>,</mo><msub><mi>𝜽</mi><mi>q</mi></msub></mrow></msub><mo lspace="0.222em" rspace="0.222em">∘</mo><msub><mi>𝐟</mi><mrow><mrow><mi>q</mi><mo>−</mo><mn>1</mn></mrow><mo>,</mo><msub><mi>𝜽</mi><mrow><mi>q</mi><mo>−</mo><mn>1</mn></mrow></msub></mrow></msub><mo lspace="0.222em" rspace="0.222em">∘</mo><mi mathvariant="normal">…</mi><mo lspace="0.222em" rspace="0.222em">∘</mo><msub><mi>𝐟</mi><mrow><mn>1</mn><mo>,</mo><msub><mi>𝜽</mi><mn>1</mn></msub></mrow></msub></mrow><mo>−</mo><mrow><msub><mi>𝐟</mi><mrow><mi>q</mi><mo>,</mo><msub><mi>𝜽</mi><mi>q</mi></msub></mrow></msub><mo lspace="0.222em" rspace="0.222em">∘</mo><msub><mi>𝐟</mi><mrow><mrow><mi>q</mi><mo>−</mo><mn>1</mn></mrow><mo>,</mo><msubsup><mi>𝜽</mi><mrow><mi>q</mi><mo>−</mo><mn>1</mn></mrow><mo>′</mo></msubsup></mrow></msub><mo lspace="0.222em" rspace="0.222em">∘</mo><mi mathvariant="normal">…</mi><mo lspace="0.222em" rspace="0.222em">∘</mo><msub><mi>𝐟</mi><mrow><mn>1</mn><mo>,</mo><msubsup><mi>𝜽</mi><mn>1</mn><mo>′</mo></msubsup></mrow></msub></mrow></mrow><mo maxsize="1.200em" minsize="1.200em" stretchy="true">‖</mo></mrow><mrow><msup><mi>L</mi><mi mathvariant="normal">∞</mi></msup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mi>D</mi><mn>0</mn></msub><mo stretchy="false">)</mo></mrow></mrow></msub></mrow><annotation encoding="application/x-tex">\displaystyle\leq\big\|\mathbf{f}_{q,\bm{\theta}_{q}}\circ\mathbf{f}_{q-1,\bm{\theta}_{q-1}}\circ\ldots\circ\mathbf{f}_{1,\bm{\theta}_{1}}-\mathbf{f}_{q,\bm{\theta}_{q}}\circ\mathbf{f}_{q-1,\bm{\theta}_{q-1}^{\prime}}\circ\ldots\circ\mathbf{f}_{1,\bm{\theta}_{1}^{\prime}}\big\|_{L^{\infty}(D_{0})}</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
<tbody id="A3.Ex101"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_eqn_cell"></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A3.Ex101.m1" class="ltx_Math" alttext="\displaystyle\quad\quad+\big\|\mathbf{f}_{q,\bm{\theta}_{q}}\circ\mathbf{f}_{q-1,\bm{\theta}_{q-1}^{\prime}}\circ\ldots\circ\mathbf{f}_{1,\bm{\theta}_{1}^{\prime}}-\mathbf{f}_{q,\bm{\theta}_{q}^{\prime}}\circ\mathbf{f}_{q-1,\bm{\theta}_{q-1}^{\prime}}\circ\ldots\circ\mathbf{f}_{1,\bm{\theta}_{1}^{\prime}}\big\|_{L^{\infty}(D_{0})}" display="inline" intent=":literal"><semantics><mrow><mo>+</mo><msub><mrow><mo maxsize="1.200em" minsize="1.200em" stretchy="true">‖</mo><mrow><mrow><msub><mi>𝐟</mi><mrow><mi>q</mi><mo>,</mo><msub><mi>𝜽</mi><mi>q</mi></msub></mrow></msub><mo lspace="0.222em" rspace="0.222em">∘</mo><msub><mi>𝐟</mi><mrow><mrow><mi>q</mi><mo>−</mo><mn>1</mn></mrow><mo>,</mo><msubsup><mi>𝜽</mi><mrow><mi>q</mi><mo>−</mo><mn>1</mn></mrow><mo>′</mo></msubsup></mrow></msub><mo lspace="0.222em" rspace="0.222em">∘</mo><mi mathvariant="normal">…</mi><mo lspace="0.222em" rspace="0.222em">∘</mo><msub><mi>𝐟</mi><mrow><mn>1</mn><mo>,</mo><msubsup><mi>𝜽</mi><mn>1</mn><mo>′</mo></msubsup></mrow></msub></mrow><mo>−</mo><mrow><msub><mi>𝐟</mi><mrow><mi>q</mi><mo>,</mo><msubsup><mi>𝜽</mi><mi>q</mi><mo>′</mo></msubsup></mrow></msub><mo lspace="0.222em" rspace="0.222em">∘</mo><msub><mi>𝐟</mi><mrow><mrow><mi>q</mi><mo>−</mo><mn>1</mn></mrow><mo>,</mo><msubsup><mi>𝜽</mi><mrow><mi>q</mi><mo>−</mo><mn>1</mn></mrow><mo>′</mo></msubsup></mrow></msub><mo lspace="0.222em" rspace="0.222em">∘</mo><mi mathvariant="normal">…</mi><mo lspace="0.222em" rspace="0.222em">∘</mo><msub><mi>𝐟</mi><mrow><mn>1</mn><mo>,</mo><msubsup><mi>𝜽</mi><mn>1</mn><mo>′</mo></msubsup></mrow></msub></mrow></mrow><mo maxsize="1.200em" minsize="1.200em" stretchy="true">‖</mo></mrow><mrow><msup><mi>L</mi><mi mathvariant="normal">∞</mi></msup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mi>D</mi><mn>0</mn></msub><mo stretchy="false">)</mo></mrow></mrow></msub></mrow><annotation encoding="application/x-tex">\displaystyle\quad\quad+\big\|\mathbf{f}_{q,\bm{\theta}_{q}}\circ\mathbf{f}_{q-1,\bm{\theta}_{q-1}^{\prime}}\circ\ldots\circ\mathbf{f}_{1,\bm{\theta}_{1}^{\prime}}-\mathbf{f}_{q,\bm{\theta}_{q}^{\prime}}\circ\mathbf{f}_{q-1,\bm{\theta}_{q-1}^{\prime}}\circ\ldots\circ\mathbf{f}_{1,\bm{\theta}_{1}^{\prime}}\big\|_{L^{\infty}(D_{0})}</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
<tbody id="A3.Ex102"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_eqn_cell"></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A3.Ex102.m1" class="ltx_Math" alttext="\displaystyle\leq Q_{q}\big\|\mathbf{f}_{q-1,\bm{\theta}_{q-1}}\circ\ldots\circ\mathbf{f}_{1,\bm{\theta}_{1}}-\mathbf{f}_{q-1,\bm{\theta}_{q-1}^{\prime}}\circ\ldots\circ\mathbf{f}_{1,\bm{\theta}_{1}^{\prime}}\big\|_{L^{\infty}(D_{0})}+\big\|\mathbf{f}_{q,\bm{\theta}_{q}}-\mathbf{f}_{q,\bm{\theta}_{q}^{\prime}}\big\|_{L^{\infty}(D_{q-1})}" display="inline" intent=":literal"><semantics><mrow><mphantom></mphantom><mo>≤</mo><mrow><mrow><msub><mi>Q</mi><mi>q</mi></msub><mo lspace="0em" rspace="0em">​</mo><msub><mrow><mo maxsize="1.200em" minsize="1.200em" stretchy="true">‖</mo><mrow><mrow><msub><mi>𝐟</mi><mrow><mrow><mi>q</mi><mo>−</mo><mn>1</mn></mrow><mo>,</mo><msub><mi>𝜽</mi><mrow><mi>q</mi><mo>−</mo><mn>1</mn></mrow></msub></mrow></msub><mo lspace="0.222em" rspace="0.222em">∘</mo><mi mathvariant="normal">…</mi><mo lspace="0.222em" rspace="0.222em">∘</mo><msub><mi>𝐟</mi><mrow><mn>1</mn><mo>,</mo><msub><mi>𝜽</mi><mn>1</mn></msub></mrow></msub></mrow><mo>−</mo><mrow><msub><mi>𝐟</mi><mrow><mrow><mi>q</mi><mo>−</mo><mn>1</mn></mrow><mo>,</mo><msubsup><mi>𝜽</mi><mrow><mi>q</mi><mo>−</mo><mn>1</mn></mrow><mo>′</mo></msubsup></mrow></msub><mo lspace="0.222em" rspace="0.222em">∘</mo><mi mathvariant="normal">…</mi><mo lspace="0.222em" rspace="0.222em">∘</mo><msub><mi>𝐟</mi><mrow><mn>1</mn><mo>,</mo><msubsup><mi>𝜽</mi><mn>1</mn><mo>′</mo></msubsup></mrow></msub></mrow></mrow><mo maxsize="1.200em" minsize="1.200em" stretchy="true">‖</mo></mrow><mrow><msup><mi>L</mi><mi mathvariant="normal">∞</mi></msup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mi>D</mi><mn>0</mn></msub><mo stretchy="false">)</mo></mrow></mrow></msub></mrow><mo>+</mo><msub><mrow><mo maxsize="1.200em" minsize="1.200em" stretchy="true">‖</mo><mrow><msub><mi>𝐟</mi><mrow><mi>q</mi><mo>,</mo><msub><mi>𝜽</mi><mi>q</mi></msub></mrow></msub><mo>−</mo><msub><mi>𝐟</mi><mrow><mi>q</mi><mo>,</mo><msubsup><mi>𝜽</mi><mi>q</mi><mo>′</mo></msubsup></mrow></msub></mrow><mo maxsize="1.200em" minsize="1.200em" stretchy="true">‖</mo></mrow><mrow><msup><mi>L</mi><mi mathvariant="normal">∞</mi></msup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mi>D</mi><mrow><mi>q</mi><mo>−</mo><mn>1</mn></mrow></msub><mo stretchy="false">)</mo></mrow></mrow></msub></mrow></mrow><annotation encoding="application/x-tex">\displaystyle\leq Q_{q}\big\|\mathbf{f}_{q-1,\bm{\theta}_{q-1}}\circ\ldots\circ\mathbf{f}_{1,\bm{\theta}_{1}}-\mathbf{f}_{q-1,\bm{\theta}_{q-1}^{\prime}}\circ\ldots\circ\mathbf{f}_{1,\bm{\theta}_{1}^{\prime}}\big\|_{L^{\infty}(D_{0})}+\big\|\mathbf{f}_{q,\bm{\theta}_{q}}-\mathbf{f}_{q,\bm{\theta}_{q}^{\prime}}\big\|_{L^{\infty}(D_{q-1})}</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="A3.p7.2" class="ltx_p"><span id="A3.p7.2.1" class="ltx_text">and the induction hypothesis.
∎</span></p>
</div>
</div>
<div id="Thmconj29" class="ltx_theorem ltx_theorem_lemma">
<h6 class="ltx_title ltx_runin ltx_title_theorem"><span class="ltx_tag ltx_tag_theorem"><span id="Thmconj29.4" class="ltx_text ltx_font_bold">Lemma 9</span></span><span id="Thmconj29.5" class="ltx_text ltx_font_bold">.</span></h6>
<div id="Thmconj29.p1" class="ltx_para">
<ul id="A3.I1" class="ltx_itemize">
<li id="A3.I1.ix1" class="ltx_item" style="list-style-type:none;"><span class="ltx_tag ltx_tag_item">(i)</span> 
<div id="A3.I1.ix1.p1" class="ltx_para">
<p id="A3.I1.ix1.p1.1" class="ltx_p"><span id="A3.I1.ix1.p1.1.1" class="ltx_text ltx_font_italic">For </span><math id="A3.I1.ix1.p1.m1" class="ltx_Math" alttext="A,B\geq 1" display="inline" intent=":literal"><semantics><mrow><mrow><mi>A</mi><mo>,</mo><mi>B</mi></mrow><mo>≥</mo><mn>1</mn></mrow><annotation encoding="application/x-tex">A,B\geq 1</annotation></semantics></math><span id="A3.I1.ix1.p1.1.2" class="ltx_text ltx_font_italic"> and </span><math id="A3.I1.ix1.p1.m2" class="ltx_Math" alttext="d,q\leq N" display="inline" intent=":literal"><semantics><mrow><mrow><mi>d</mi><mo>,</mo><mi>q</mi></mrow><mo>≤</mo><mi>N</mi></mrow><annotation encoding="application/x-tex">d,q\leq N</annotation></semantics></math><span id="A3.I1.ix1.p1.1.3" class="ltx_text ltx_font_italic">,</span></p>
<table id="A3.EGx56" class="ltx_equationgroup ltx_eqn_align ltx_eqn_table">

<tbody id="A3.E37"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_align_right ltx_eqn_cell"><math id="A3.E37.m1" class="ltx_Math" alttext="\displaystyle\sup_{\mathbf{f}_{\bm{\theta}}\in\mathcal{MLP}(d,q,L,N,B)}\,\|\mathbf{f}_{\bm{\theta}}\|_{L^{\infty}([-A,A]^{d})}" display="inline" intent=":literal"><semantics><mrow><munder><mo movablelimits="false">sup</mo><mrow><msub><mi>𝐟</mi><mi>𝜽</mi></msub><mo>∈</mo><mrow><mi class="ltx_font_mathcaligraphic">ℳ</mi><mo lspace="0em" rspace="0em">​</mo><mi class="ltx_font_mathcaligraphic">ℒ</mi><mo lspace="0em" rspace="0em">​</mo><mi class="ltx_font_mathcaligraphic">𝒫</mi><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>d</mi><mo>,</mo><mi>q</mi><mo>,</mo><mi>L</mi><mo>,</mo><mi>N</mi><mo>,</mo><mi>B</mi><mo stretchy="false">)</mo></mrow></mrow></mrow></munder><msub><mrow><mo lspace="0.170em" stretchy="false">‖</mo><msub><mi>𝐟</mi><mi>𝜽</mi></msub><mo stretchy="false">‖</mo></mrow><mrow><msup><mi>L</mi><mi mathvariant="normal">∞</mi></msup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msup><mrow><mo stretchy="false">[</mo><mrow><mrow><mo>−</mo><mi>A</mi></mrow><mo>,</mo><mi>A</mi></mrow><mo stretchy="false">]</mo></mrow><mi>d</mi></msup><mo stretchy="false">)</mo></mrow></mrow></msub></mrow><annotation encoding="application/x-tex">\displaystyle\sup_{\mathbf{f}_{\bm{\theta}}\in\mathcal{MLP}(d,q,L,N,B)}\,\|\mathbf{f}_{\bm{\theta}}\|_{L^{\infty}([-A,A]^{d})}</annotation></semantics></math></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A3.E37.m2" class="ltx_Math" alttext="\displaystyle\leq A\big(B(N+1)\big)^{L+1}," display="inline" intent=":literal"><semantics><mrow><mrow><mphantom></mphantom><mo>≤</mo><mrow><mi>A</mi><mo lspace="0em" rspace="0em">​</mo><msup><mrow><mo maxsize="1.200em" minsize="1.200em">(</mo><mrow><mi>B</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mrow><mi>N</mi><mo>+</mo><mn>1</mn></mrow><mo stretchy="false">)</mo></mrow></mrow><mo maxsize="1.200em" minsize="1.200em">)</mo></mrow><mrow><mi>L</mi><mo>+</mo><mn>1</mn></mrow></msup></mrow></mrow><mo>,</mo></mrow><annotation encoding="application/x-tex">\displaystyle\leq A\big(B(N+1)\big)^{L+1},</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td>
<td rowspan="1" class="ltx_eqn_cell ltx_eqn_eqno ltx_align_middle ltx_align_right"><span class="ltx_tag ltx_tag_equation ltx_align_right">(37)</span></td></tr></tbody>
<tbody id="A3.E38"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_align_right ltx_eqn_cell"><math id="A3.E38.m1" class="ltx_Math" alttext="\displaystyle\sup_{\mathbf{f}_{\bm{\theta}}\in\mathcal{MLP}(d,q,L,N,B),\,\mathbf{x},\mathbf{x}^{\prime}\in[-A,A]^{d},\,\mathbf{x}\neq\mathbf{x}^{\prime}}\,\frac{\|\mathbf{f}_{\bm{\theta}}(\mathbf{x})-\mathbf{f}_{\bm{\theta}}(\mathbf{x}^{\prime})\|_{\infty}}{\|\mathbf{x}-\mathbf{x}^{\prime}\|_{\infty}}" display="inline" intent=":literal"><semantics><mrow><munder><mo movablelimits="false">sup</mo><mrow><mrow><msub><mi>𝐟</mi><mi>𝜽</mi></msub><mo>∈</mo><mrow><mi class="ltx_font_mathcaligraphic">ℳ</mi><mo lspace="0em" rspace="0em">​</mo><mi class="ltx_font_mathcaligraphic">ℒ</mi><mo lspace="0em" rspace="0em">​</mo><mi class="ltx_font_mathcaligraphic">𝒫</mi><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>d</mi><mo>,</mo><mi>q</mi><mo>,</mo><mi>L</mi><mo>,</mo><mi>N</mi><mo>,</mo><mi>B</mi><mo stretchy="false">)</mo></mrow></mrow></mrow><mo rspace="0.337em">,</mo><mi>𝐱</mi><mo>,</mo><mrow><msup><mi>𝐱</mi><mo>′</mo></msup><mo>∈</mo><msup><mrow><mo stretchy="false">[</mo><mrow><mrow><mo>−</mo><mi>A</mi></mrow><mo>,</mo><mi>A</mi></mrow><mo stretchy="false">]</mo></mrow><mi>d</mi></msup></mrow><mo rspace="0.337em">,</mo><mrow><mi>𝐱</mi><mo>≠</mo><msup><mi>𝐱</mi><mo>′</mo></msup></mrow></mrow></munder><mstyle displaystyle="true"><mfrac><msub><mrow><mo stretchy="false">‖</mo><mrow><mrow><msub><mi>𝐟</mi><mi>𝜽</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>𝐱</mi><mo stretchy="false">)</mo></mrow></mrow><mo>−</mo><mrow><msub><mi>𝐟</mi><mi>𝜽</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msup><mi>𝐱</mi><mo>′</mo></msup><mo stretchy="false">)</mo></mrow></mrow></mrow><mo stretchy="false">‖</mo></mrow><mi mathvariant="normal">∞</mi></msub><msub><mrow><mo stretchy="false">‖</mo><mrow><mi>𝐱</mi><mo>−</mo><msup><mi>𝐱</mi><mo>′</mo></msup></mrow><mo stretchy="false">‖</mo></mrow><mi mathvariant="normal">∞</mi></msub></mfrac></mstyle></mrow><annotation encoding="application/x-tex">\displaystyle\sup_{\mathbf{f}_{\bm{\theta}}\in\mathcal{MLP}(d,q,L,N,B),\,\mathbf{x},\mathbf{x}^{\prime}\in[-A,A]^{d},\,\mathbf{x}\neq\mathbf{x}^{\prime}}\,\frac{\|\mathbf{f}_{\bm{\theta}}(\mathbf{x})-\mathbf{f}_{\bm{\theta}}(\mathbf{x}^{\prime})\|_{\infty}}{\|\mathbf{x}-\mathbf{x}^{\prime}\|_{\infty}}</annotation></semantics></math></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A3.E38.m2" class="ltx_Math" alttext="\displaystyle\leq(BN)^{L+1}," display="inline" intent=":literal"><semantics><mrow><mrow><mphantom></mphantom><mo>≤</mo><msup><mrow><mo stretchy="false">(</mo><mrow><mi>B</mi><mo lspace="0em" rspace="0em">​</mo><mi>N</mi></mrow><mo stretchy="false">)</mo></mrow><mrow><mi>L</mi><mo>+</mo><mn>1</mn></mrow></msup></mrow><mo>,</mo></mrow><annotation encoding="application/x-tex">\displaystyle\leq(BN)^{L+1},</annotation></semantics></math></td>
