</mtable><mo>)</mo></mrow><mo lspace="0.167em" rspace="0em">​</mo><mtable displaystyle="true" rowspacing="0pt"><mtr><mtd class="ltx_align_left" columnalign="left"><mphantom></mphantom></mtd></mtr><mtr><mtd class="ltx_align_left" columnalign="left"><mphantom></mphantom></mtd></mtr><mtr><mtd class="ltx_align_left" columnalign="left"><mphantom></mphantom></mtd></mtr><mtr><mtd class="ltx_align_left" columnalign="left"><mphantom></mphantom></mtd></mtr><mtr><mtd class="ltx_align_left" columnalign="left"><mphantom></mphantom></mtd></mtr><mtr><mtd class="ltx_align_left" columnalign="left"><mphantom></mphantom></mtd></mtr><mtr><mtd class="ltx_align_left" columnalign="left"><mphantom></mphantom></mtd></mtr><mtr><mtd class="ltx_align_left" columnalign="left"><mphantom></mphantom></mtd></mtr><mtr><mtd class="ltx_align_left" columnalign="left"><mrow><mphantom></mphantom><mo>∈</mo><msup><mi>ℝ</mi><msub><mi>m</mi><mn>2</mn></msub></msup></mrow></mtd></mtr></mtable></mrow></mrow><annotation encoding="application/x-tex">\bm{\mu}_{2,0}:\left(\begin{matrix}\mathbf{x}_{1,t}\\
