<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A6.Ex373.m2" class="ltx_Math" alttext="\displaystyle=\mathbb{E}\left[\left\|\frac{\widehat{\mathbf{m}}_{\lambda}(\mathbf{Z}_{2,T+1})}{\|\widehat{\mathbf{m}}_{\lambda}(\mathbf{Z}_{2,T+1})\|_{2}}-\bm{\alpha}\right\|^{2}_{2}\mathbb{I}(\|P_{\bm{\alpha}}\widehat{\mathbf{m}}_{\lambda}(\mathbf{Z}_{2,T+1})\|_{2}\geq c)\Big|\mathbf{h}\right]" display="inline" intent=":literal"><semantics><mrow><mphantom></mphantom><mo>=</mo><mrow><mi>𝔼</mi><mo>⁡</mo><mrow><mo>[</mo><mrow><mrow><msubsup><mrow><mo>‖</mo><mrow><mstyle displaystyle="true"><mfrac><mrow><msub><mover accent="true"><mi>𝐦</mi><mo>^</mo></mover><mi>λ</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mi>𝐙</mi><mrow><mn>2</mn><mo>,</mo><mrow><mi>T</mi><mo>+</mo><mn>1</mn></mrow></mrow></msub><mo stretchy="false">)</mo></mrow></mrow><msub><mrow><mo stretchy="false">‖</mo><mrow><msub><mover accent="true"><mi>𝐦</mi><mo>^</mo></mover><mi>λ</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mi>𝐙</mi><mrow><mn>2</mn><mo>,</mo><mrow><mi>T</mi><mo>+</mo><mn>1</mn></mrow></mrow></msub><mo stretchy="false">)</mo></mrow></mrow><mo stretchy="false">‖</mo></mrow><mn>2</mn></msub></mfrac></mstyle><mo>−</mo><mi>𝜶</mi></mrow><mo>‖</mo></mrow><mn>2</mn><mn>2</mn></msubsup><mo lspace="0em" rspace="0em">​</mo><mi>𝕀</mi><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mrow><msub><mrow><mo stretchy="false">‖</mo><mrow><msub><mi>P</mi><mi>𝜶</mi></msub><mo lspace="0em" rspace="0em">​</mo><msub><mover accent="true"><mi>𝐦</mi><mo>^</mo></mover><mi>λ</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mi>𝐙</mi><mrow><mn>2</mn><mo>,</mo><mrow><mi>T</mi><mo>+</mo><mn>1</mn></mrow></mrow></msub><mo stretchy="false">)</mo></mrow></mrow><mo stretchy="false">‖</mo></mrow><mn>2</mn></msub><mo>≥</mo><mi>c</mi></mrow><mo stretchy="false">)</mo></mrow></mrow><mo fence="fal