tretchy="false">[</mo><mi>T</mi><mo stretchy="false">]</mo></mrow></mrow></msub><mo lspace="0.167em" rspace="0em">​</mo><mtable rowspacing="0pt"><mtr><mtd class="ltx_align_left" columnalign="left"><mphantom></mphantom></mtd></mtr><mtr><mtd class="ltx_align_left" columnalign="left"><mphantom></mphantom></mtd></mtr><mtr><mtd class="ltx_align_left" columnalign="left"><mphantom></mphantom></mtd></mtr><mtr><mtd class="ltx_align_left" columnalign="left"><mphantom></mphantom></mtd></mtr><mtr><mtd class="ltx_align_left" columnalign="left"><mphantom></mphantom></mtd></mtr><mtr><mtd class="ltx_align_left" columnalign="left"><mphantom></mphantom></mtd></mtr><mtr><mtd class="ltx_align_left" columnalign="left"><mphantom></mphantom></mtd></mtr><mtr><mtd class="ltx_align_left" columnalign="left"><mphantom></mphantom></mtd></mtr><mtr><mtd class="ltx_align_left" columnalign="left"><mrow><mphantom></mphantom><mo>∈</mo><msup><mi>ℝ</mi><msub><mi>m</mi><mn>2</mn></msub></msup></mrow></mtd></mtr></mtable></mrow></mrow><annotation encoding="application/x-tex">\displaystyle\bm{\mu}_{2}:\left(\begin{matrix}\mathbf{x}_{1,t}\\
