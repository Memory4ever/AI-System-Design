stretchy="false">)</mo></mrow><mo>⊤</mo></msup><mo lspace="0em" rspace="0em">​</mo><msub><mi class="ltx_mathvariant_bold-italic" mathvariant="bold-italic">ϕ</mi><mn>1</mn></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mi>𝐗</mi><mi>s</mi></msub><mo stretchy="false">)</mo></mrow></mrow></mrow><mo maxsize="1.200em" minsize="1.200em">)</mo></mrow></mrow><mo lspace="0.170em" rspace="0em">​</mo><msub><mi class="ltx_mathvariant_bold-italic" mathvariant="bold-italic">ϕ</mi><mn>2</mn></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mi>𝐗</mi><mi>s</mi></msub><mo stretchy="false">)</mo></mrow></mrow><mo maxsize="1.600em" minsize="1.600em">)</mo></mrow></mrow></mtd></mtr></mtable><mo>)</mo></mrow></mrow><annotation encoding="application/x-tex">\displaystyle=\left(\begin{matrix}\mathbf{g}_{0}(\mathbf{Z}_{1,t+1})\\
\bullet_{N-m_{1}-m_{2}}\\
\overline{\sum}_{s\in[\log^{2}T,T-\log^{2}T]}\Big(K_{\lambda}(\mathbf{Z}_{2,s},\mathbf{Z}_{2,T+1})\,;\,\exp\big(-\mathbf{g}_{0}(\mathbf{Z}_{1,s})^{\top}\bm{\phi}_{1}(\mathbf{X}_{s})\big)\,\bm{\phi}_{2}(\mathbf{X}_{s})\Big)\end{matrix}\right)</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="A5.SS3.p1.9" class="ltx_p">with <math id="A5.SS3.p1.m8" class="ltx_math_unparsed" alttext="K_{\lambda}(\mathbf{z},\mathbf{z}^{\prime})\coloneq\exp(-\|\mathbf{z}-\mathbf{z}^{\prime}\|^{2}/(2\lambda^{2}))" display="inline" intent=":literal"><semantics><mrow><msub><mi>K</mi><mi>λ</mi></msub><mrow><mo stretchy="false">(</mo><mi>𝐳</mi><mo>,</mo><msup><mi>𝐳</mi><mo>′</mo></msup><mo stretchy="false">)</mo></mrow><mo>≔</mo><mi>exp</mi><mrow><mo stretchy="false">(</mo><mo lspace="0em" rspace="0em">−</mo><mo lspace="0em" rspace="0.167em">∥</mo><mi>𝐳</mi><mo>−</mo><msup><mi>𝐳</mi><mo>′</mo></msup><msup><mo lspace="0em" rspace="0em">∥</mo><mn>2</mn></msup><mo lspace="0em">/</mo><mrow><mo stretchy="false">(</mo><mn>2</mn><msup><mi>λ</mi><mn>2</mn></msup><mo stretchy="false">)</mo></mrow><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">K_{\lambda}(\mathbf{z},\mathbf{z}^{\prime})\coloneq\exp(-\|\mathbf{z}-\mathbf{z}^{\prime}\|^{2}/(2\lambda^{2}))</annotation></semantics></math>,
provided that <math id="A5.SS3.p1.m9" class="ltx_Math" alttext="\|\mathbf{Z}_{2,t}\|_{2}=1" display="inline" intent=":literal"><semantics><mrow><msub><mrow><mo stretchy="false">‖</mo><msub><mi>𝐙</mi><mrow><mn>2</mn><mo>,</mo><mi>t</mi></mrow></msub><mo stretchy="false">‖</mo></mrow><mn>2</mn></msub><mo>=</mo><mn>1</mn></mrow><annotation encoding="application/x-tex">\|\mathbf{Z}_{2,t}\|_{2}=1</annotation></semantics></math> for <math id="A5.SS3.p1.m10" class="ltx_Math" alttext="t\in\{r_{2}+1,\ldots,T+1\}" display="inline" intent=":literal"><semantics><mrow><mi>t</mi><mo>∈</mo><mrow><mo stretchy="false">{</mo><mrow><mrow><msub><mi>r</mi><mn>2</mn></msub><mo>+</mo><mn>1</mn></mrow><mo>,</mo><mi mathvariant="normal">…</mi><mo>,</mo><mrow><mi>T</mi><mo>+</mo><mn>1</mn></mrow></mrow><mo stretchy="false">}</mo></mrow></mrow><annotation encoding="application/x-tex">t\in\{r_{2}+1,\ldots,T+1\}</annotation></semantics></math>.
See (<a href="#A1.E29" title="In Appendix A Additional Notation ‣ Generalization Bounds for Transformer-Based Next-Token Prediction in a Language Model" class="ltx_ref"><span class="ltx_text ltx_ref_tag">29</span></a>) for the definition of <math id="A5.SS3.p1.m11" class="ltx_Math" alttext="\overline{\sum}" display="inline" intent=":literal"><semantics><mover accent="true"><mo>∑</mo><mo stretchy="true">¯</mo></mover><annotation encoding="application/x-tex">\overline{\sum}</annotation></semantics></math>.
With these new definitions, we can restate Lemma <a href="#Thmconj25" title="Lemma 5. ‣ 5 Proof Sketch of the Upper Bound for the Approximation Error ‣ Generalization Bounds for Transformer-Based Next-Token Prediction in a Language Model" class="ltx_ref"><span class="ltx_text ltx_ref_tag">5</span></a>.</p>
</div>
<div id="Thmconj226" class="ltx_theorem ltx_theorem_lemma">
<h6 class="ltx_title ltx_runin ltx_title_theorem"><span class="ltx_tag ltx_tag_theorem"><span id="Thmconj226.4" class="ltx_text ltx_font_bold">Lemma 26</span></span><span id="Thmconj226.5" class="ltx_text ltx_font_bold"> </span>(Restatement of Lemma <a href="#Thmconj25" title="Lemma 5. ‣ 5 Proof Sketch of the Upper Bound for the Approximation Error ‣ Generalization Bounds for Transformer-Based Next-Token Prediction in a Language Model" class="ltx_ref"><span class="ltx_text ltx_ref_tag">5</span></a>)<span id="Thmconj226.6" class="ltx_text ltx_font_bold">.</span></h6>
<div id="Thmconj226.p1" class="ltx_para">
<p id="Thmconj226.p1.1" class="ltx_p"><span id="Thmconj226.p1.1.1" class="ltx_text ltx_font_italic">Suppose Assumptions <a href="#Thmassumpt2" title="Assumption 2. ‣ 4 Risk bound ‣ Generalization Bounds for Transformer-Based Next-Token Prediction in a Language Model" class="ltx_ref"><span class="ltx_text ltx_ref_tag">2</span></a> and <a href="#Thmassumpt3" title="Assumption 3. ‣ 4 Risk bound ‣ Generalization Bounds for Transformer-Based Next-Token Prediction in a Language Model" class="ltx_ref"><span class="ltx_text ltx_ref_tag">3</span></a> hold.
For sufficiently large <math id="Thmconj226.p1.m1" class="ltx_Math" alttext="T" display="inline" intent=":literal"><semantics><mi>T</mi><annotation encoding="application/x-tex">T</annotation></semantics></math> and
for any <math id="Thmconj226.p1.m2" class="ltx_Math" alttext="\lambda\geq T^{-1}" display="inline" intent=":literal"><semantics><mrow><mi>λ</mi><mo>≥</mo><msup><mi>T</mi><mrow><mo>−</mo><mn>1</mn></mrow></msup></mrow><annotation encoding="application/x-tex">\lambda\geq T^{-1}</annotation></semantics></math>, there exist multi-head self-attentions <math id="Thmconj226.p1.m3" class="ltx_Math" alttext="\bm{\mu}_{1},\bm{\mu}_{2}\in\mathcal{MA}(N,H,B)" display="inline" intent=":literal"><semantics><mrow><msub><mi>𝛍</mi><mn>1</mn></msub><mo>,</mo><mrow><msub><mi>𝛍</mi><mn>2</mn></msub><mo>∈</mo><mrow><mi class="ltx_font_mathcaligraphic">ℳ</mi><mo lspace="0em" rspace="0em">​</mo><mi class="ltx_font_mathcaligraphic">𝒜</mi><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>N</mi><mo>,</mo><mi>H</mi><mo>,</mo><mi>B</mi><mo stretchy="false">)</mo></mrow></mrow></mrow></mrow><annotation encoding="application/x-tex">\bm{\mu}_{1},\bm{\mu}_{2}\in\mathcal{MA}(N,H,B)</annotation></semantics></math> and
a multilayer perceptron <math id="Thmconj226.p1.m4" class="ltx_Math" alttext="\bm{\nu}_{1}\in\mathcal{MLP}(N,L_{\mathrm{mlp}},N_{\mathrm{mlp}},B)" display="inline" intent=":literal"><semantics><mrow><msub><mi>𝛎</mi><mn>1</mn></msub><mo>∈</mo><mrow><mi class="ltx_font_mathcaligraphic">ℳ</mi><mo lspace="0em" rspace="0em">​</mo><mi class="ltx_font_mathcaligraphic">ℒ</mi><mo lspace="0em" rspace="0em">​</mo><mi class="ltx_font_mathcaligraphic">𝒫</mi><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>N</mi><mo>,</mo><msub><mi>L</mi><mi>mlp</mi></msub><mo>,</mo><msub><mi>N</mi><mi>mlp</mi></msub><mo>,</mo><mi>B</mi><mo stretchy="false">)</mo></mrow></mrow></mrow><annotation encoding="application/x-tex">\bm{\nu}_{1}\in\mathcal{MLP}(N,L_{\mathrm{mlp}},N_{\mathrm{mlp}},B)</annotation></semantics></math> such that</span></p>
<table id="A5.Ex315" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="A5.Ex315.m1" class="ltx_math_unparsed" alttext="\left\|\big(\bm{\mu}_{2}\circ\bm{\nu}_{1}\circ\bm{\mu}_{1}(M)\big)_{:,T}-\bm{\mu}_{2,0}\circ\bm{\nu}_{1,0}\circ\bm{\mu}_{1,0}(M)\right\|_{\infty,m_{1},m_{2}}\lesssim(N_{\mathrm{mlp}})^{-\frac{2\beta_{1}}{m_{1}r_{1}}}+\frac{1}{T}," display="block" intent=":literal"><semantics><mrow><msub><mrow><mo>‖</mo><msub><mrow><mo maxsize="1.200em" minsize="1.200em">(</mo><msub><mi>𝝁</mi><mn>2</mn></msub><mo lspace="0.222em" rspace="0.222em">∘</mo><msub><mi>𝝂</mi><mn>1</mn></msub><mo lspace="0.222em" rspace="0.222em">∘</mo><msub><mi>𝝁</mi><mn>1</mn></msub><mrow><mo stretchy="false">(</mo><mi>M</mi><mo stretchy="false">)</mo></mrow><mo maxsize="1.200em" minsize="1.200em">)</mo></mrow><mrow><mo rspace="0em">:</mo><mo>,</mo><mi>T</mi></mrow></msub><mo>−</mo><msub><mi>𝝁</mi><mrow><mn>2</mn><mo>,</mo><mn>0</mn></mrow></msub><mo lspace="0.222em" rspace="0.222em">∘</mo><msub><mi>𝝂</mi><mrow><mn>1</mn><mo>,</mo><mn>0</mn></mrow></msub><mo lspace="0.222em" rspace="0.222em">∘</mo><msub><mi>𝝁</mi><mrow><mn>1</mn><mo>,</mo><mn>0</mn></mrow></msub><mrow><mo stretchy="false">(</mo><mi>M</mi><mo stretchy="false">)</mo></mrow><mo>‖</mo></mrow><mrow><mi mathvariant="normal">∞</mi><mo>,</mo><msub><mi>m</mi><mn>1</mn></msub><mo>,</mo><msub><mi>m</mi><mn>2</mn></msub></mrow></msub><mo>≲</mo><msup><mrow><mo stretchy="false">(</mo><msub><mi>N</mi><mi>mlp</mi></msub><mo stretchy="false">)</mo></mrow><mrow><mo>−</mo><mfrac><mrow><mn>2</mn><mo lspace="0em" rspace="0em">​</mo><msub><mi>β</mi><mn>1</mn></msub></mrow><mrow><msub><mi>m</mi><mn>1</mn></msub><mo lspace="0em" rspace="0em">​</mo><msub><mi>r</mi><mn>1</mn></msub></mrow></mfrac></mrow></msup><mo>+</mo><mfrac><mn>1</mn><mi>T</mi></mfrac><mo>,</mo></mrow><annotation encoding="application/x-tex">\left\|\big(\bm{\mu}_{2}\circ\bm{\nu}_{1}\circ\bm{\mu}_{1}(M)\big)_{:,T}-\bm{\mu}_{2,0}\circ\bm{\nu}_{1,0}\circ\bm{\mu}_{1,0}(M)\right\|_{\infty,m_{1},m_{2}}\lesssim(N_{\mathrm{mlp}})^{-\frac{2\beta_{1}}{m_{1}r_{1}}}+\frac{1}{T},</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="Thmconj226.p1.2" class="ltx_p"><span id="Thmconj226.p1.2.1" class="ltx_text ltx_font_italic">where <math id="Thmconj226.p1.m5" class="ltx_Math" alttext="\|(x_{1},x_{2},\ldots,x_{N})^{\top}\|_{\infty,m_{1},m_{2}}\coloneqq\max_{i\in([N]\setminus\{m_{1}+1,\ldots,N-m_{2}\})}|x_{i}|" display="inline" intent=":literal"><semantics><mrow><msub><mrow><mo stretchy="false">‖</mo><msup><mrow><mo stretchy="false">(</mo><msub><mi>x</mi><mn>1</mn></msub><mo>,</mo><msub><mi>x</mi><mn>2</mn></msub><mo>,</mo><mi mathvariant="normal">…</mi><mo>,</mo><msub><mi>x</mi><mi>N</mi></msub><mo stretchy="false">)</mo></mrow><mo>⊤</mo></msup><mo stretchy="false">‖</mo></mrow><mrow><mi mathvariant="normal">∞</mi><mo>,</mo><msub><mi>m</mi><mn>1</mn></msub><mo>,</mo><msub><mi>m</mi><mn>2</mn></msub></mrow></msub><mo>≔</mo><mrow><msub><mi>max</mi><mrow><mi>i</mi><mo>∈</mo><mrow><mo stretchy="false">(</mo><mrow><mrow><mo stretchy="false">[</mo><mi>N</mi><mo stretchy="false">]</mo></mrow><mo>∖</mo><mrow><mo stretchy="false">{</mo><mrow><mrow><msub><mi>m</mi><mn>1</mn></msub><mo>+</mo><mn>1</mn></mrow><mo>,</mo><mi mathvariant="normal">…</mi><mo>,</mo><mrow><mi>N</mi><mo>−</mo><msub><mi>m</mi><mn>2</mn></msub></mrow></mrow><mo stretchy="false">}</mo></mrow></mrow><mo stretchy="false">)</mo></mrow></mrow></msub><mo>⁡</mo><mrow><mo stretchy="false">|</mo><msub><mi>x</mi><mi>i</mi></msub><mo stretchy="false">|</mo></mrow></mrow></mrow><annotation encoding="application/x-tex">\|(x_{1},x_{2},\ldots,x_{N})^{\top}\|_{\infty,m_{1},m_{2}}\coloneqq\max_{i\in([N]\setminus\{m_{1}+1,\ldots,N-m_{2}\})}|x_{i}|</annotation></semantics></math>.</span></p>
</div>
</div>
<div id="A5.SS3.p2" class="ltx_para">
<p id="A5.SS3.p2.1" class="ltx_p">The proof invokes the following lemma, whose proof is deferred to the end of this section.</p>
</div>
<div id="Thmconj227" class="ltx_theorem ltx_theorem_lemma">
<h6 class="ltx_title ltx_runin ltx_title_theorem"><span class="ltx_tag ltx_tag_theorem"><span id="Thmconj227.4" class="ltx_text ltx_font_bold">Lemma 27</span></span><span id="Thmconj227.5" class="ltx_text ltx_font_bold">.</span></h6>
<div id="Thmconj227.p1" class="ltx_para">
<p id="Thmconj227.p1.1" class="ltx_p"><span id="Thmconj227.p1.1.1" class="ltx_text ltx_font_italic">For any <math id="Thmconj227.p1.m1" class="ltx_Math" alttext="\alpha_{-}&lt;\alpha_{+}" display="inline" intent=":literal"><semantics><mrow><msub><mi>α</mi><mo>−</mo></msub><mo>&lt;</mo><msub><mi>α</mi><mo>+</mo></msub></mrow><annotation encoding="application/x-tex">\alpha_{-}&lt;\alpha_{+}</annotation></semantics></math>, <math id="Thmconj227.p1.m2" class="ltx_Math" alttext="a_{1},\ldots,a_{T}\in[\alpha_{-},\alpha_{+}]" display="inline" intent=":literal"><semantics><mrow><msub><mi>a</mi><mn>1</mn></msub><mo>,</mo><mi mathvariant="normal">…</mi><mo>,</mo><mrow><msub><mi>a</mi><mi>T</mi></msub><mo>∈</mo><mrow><mo stretchy="false">[</mo><mrow><msub><mi>α</mi><mo>−</mo></msub><mo>,</mo><msub><mi>α</mi><mo>+</mo></msub></mrow><mo stretchy="false">]</mo></mrow></mrow></mrow><annotation encoding="application/x-tex">a_{1},\ldots,a_{T}\in[\alpha_{-},\alpha_{+}]</annotation></semantics></math>, <math id="Thmconj227.p1.m3" class="ltx_Math" alttext="\beta&gt;0" display="inline" intent=":literal"><semantics><mrow><mi>β</mi><mo>&gt;</mo><mn>0</mn></mrow><annotation encoding="application/x-tex">\beta&gt;0</annotation></semantics></math>, <math id="Thmconj227.p1.m4" class="ltx_Math" alttext="\mathbf{y}_{1},\ldots,\mathbf{y}_{T}\in[-\beta,\beta]^{m_{2}}" display="inline" intent=":literal"><semantics><mrow><msub><mi>𝐲</mi><mn>1</mn></msub><mo>,</mo><mi mathvariant="normal">…</mi><mo>,</mo><mrow><msub><mi>𝐲</mi><mi>T</mi></msub><mo>∈</mo><msup><mrow><mo stretchy="false">[</mo><mrow><mrow><mo>−</mo><mi>β</mi></mrow><mo>,</mo><mi>β</mi></mrow><mo stretchy="false">]</mo></mrow><msub><mi>m</mi><mn>2</mn></msub></msup></mrow></mrow><annotation encoding="application/x-tex">\mathbf{y}_{1},\ldots,\mathbf{y}_{T}\in[-\beta,\beta]^{m_{2}}</annotation></semantics></math> and <math id="Thmconj227.p1.m5" class="ltx_Math" alttext="c&gt;0" display="inline" intent=":literal"><semantics><mrow><mi>c</mi><mo>&gt;</mo><mn>0</mn></mrow><annotation encoding="application/x-tex">c&gt;0</annotation></semantics></math>,</span></p>
<table id="A5.EGx126" class="ltx_equationgroup ltx_eqn_align ltx_eqn_table">

<tbody id="A5.Ex316"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_align_right ltx_eqn_cell"><math id="A5.Ex316.m1" class="ltx_Math" alttext="\displaystyle\left\|\overline{\sum}_{s\in[T]}\Big(\exp\big(a_{s}+c\,\mathbb{I}(s\in[\log^{2}T,T-\log^{2}T])\big)\,;\,\mathbf{y}_{s}\Big)-\overline{\sum}_{s\in[\log^{2}T,T-\log^{2}T]}\Big(\exp\big(a_{s}\big)\,;\,\mathbf{y}_{s}\Big)\right\|_{\infty}" display="inline" intent=":literal"><semantics><msub><mrow><mo>‖</mo><mrow><mrow><msub><mover accent="true"><mstyle displaystyle="true"><mo movablelimits="false">∑</mo></mstyle><mo stretchy="true">¯</mo></mover><mrow><mi>s</mi><mo>∈</mo><mrow><mo stretchy="false">[</mo><mi>T</mi><mo stretchy="false">]</mo></mrow></mrow></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo maxsize="1.600em" minsize="1.600em">(</mo><mrow><mi>exp</mi><mo>⁡</mo><mrow><mo maxsize="1.200em" minsize="1.200em">(</mo><mrow><msub><mi>a</mi><mi>s</mi></msub><mo>+</mo><mrow><mi>c</mi><mo lspace="0.170em" rspace="0em">​</mo><mi>𝕀</mi><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mrow><mi>s</mi><mo>∈</mo><mrow><mo stretchy="false">[</mo><mrow><mrow><msup><mi>log</mi><mn>2</mn></msup><mo lspace="0.167em">⁡</mo><mi>T</mi></mrow><mo>,</mo><mrow><mi>T</mi><mo>−</mo><mrow><msup><mi>log</mi><mn>2</mn></msup><mo lspace="0.167em">⁡</mo><mi>T</mi></mrow></mrow></mrow><mo stretchy="false">]</mo></mrow></mrow><mo stretchy="false">)</mo></mrow></mrow></mrow><mo maxsize="1.200em" minsize="1.200em" rspace="0.170em">)</mo></mrow></mrow><mo>,</mo><msub><mi>𝐲</mi><mi>s</mi></msub><mo maxsize="1.600em" minsize="1.600em">)</mo></mrow></mrow><mo>−</mo><mrow><msub><mover accent="true"><mstyle displaystyle="true"><mo movablelimits="false">∑</mo></mstyle><mo stretchy="true">¯</mo></mover><mrow><mi>s</mi><mo>∈</mo><mrow><mo stretchy="false">[</mo><mrow><mrow><msup><mi>log</mi><mn>2</mn></msup><mo lspace="0.167em">⁡</mo><mi>T</mi></mrow><mo>,</mo><mrow><mi>T</mi><mo>−</mo><mrow><msup><mi>log</mi><mn>2</mn></msup><mo lspace="0.167em">⁡</mo><mi>T</mi></mrow></mrow></mrow><mo stretchy="false">]</mo></mrow></mrow></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo maxsize="1.600em" minsize="1.600em">(</mo><mrow><mi>exp</mi><mo>⁡</mo><mrow><mo maxsize="1.200em" minsize="1.200em">(</mo><msub><mi>a</mi><mi>s</mi></msub><mo maxsize="1.200em" minsize="1.200em" rspace="0.170em">)</mo></mrow></mrow><mo>,</mo><msub><mi>𝐲</mi><mi>s</mi></msub><mo maxsize="1.600em" minsize="1.600em">)</mo></mrow></mrow></mrow><mo>‖</mo></mrow><mi mathvariant="normal">∞</mi></msub><annotation encoding="application/x-tex">\displaystyle\left\|\overline{\sum}_{s\in[T]}\Big(\exp\big(a_{s}+c\,\mathbb{I}(s\in[\log^{2}T,T-\log^{2}T])\big)\,;\,\mathbf{y}_{s}\Big)-\overline{\sum}_{s\in[\log^{2}T,T-\log^{2}T]}\Big(\exp\big(a_{s}\big)\,;\,\mathbf{y}_{s}\Big)\right\|_{\infty}</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
<tbody id="A5.Ex317"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_align_right ltx_eqn_cell"><math id="A5.Ex317.m1" class="ltx_Math" alttext="\displaystyle\leq\frac{8\beta\log^{2}T}{T\exp(c+\alpha_{-}-\alpha_{+})}." display="inline" intent=":literal"><semantics><mrow><mrow><mphantom></mphantom><mo>≤</mo><mstyle displaystyle="true"><mfrac><mrow><mn>8</mn><mo lspace="0em" rspace="0em">​</mo><mi>β</mi><mo lspace="0.167em" rspace="0em">​</mo><mrow><msup><mi>log</mi><mn>2</mn></msup><mo lspace="0.167em">⁡</mo><mi>T</mi></mrow></mrow><mrow><mi>T</mi><mo lspace="0.167em" rspace="0em">​</mo><mrow><mi>exp</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mrow><mrow><mi>c</mi><mo>+</mo><msub><mi>α</mi><mo>−</mo></msub></mrow><mo>−</mo><msub><mi>α</mi><mo>+</mo></msub></mrow><mo stretchy="false">)</mo></mrow></mrow></mrow></mfrac></mstyle></mrow><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">\displaystyle\leq\frac{8\beta\log^{2}T}{T\exp(c+\alpha_{-}-\alpha_{+})}.</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
</div>
</div>
<div id="A5.SS3.2" class="ltx_proof">
<h6 class="ltx_title ltx_runin ltx_font_italic ltx_title_proof">Proof of Lemma <a href="#Thmconj226" title="Lemma 26 (Restatement of Lemma ). ‣ E.3 Proof of Lemma ‣ Appendix E Construction of the Transformer ‣ Generalization Bounds for Transformer-Based Next-Token Prediction in a Language Model" class="ltx_ref"><span class="ltx_text ltx_ref_tag">26</span></a>.</h6>
<div id="A5.SS3.p3" class="ltx_para">
<p id="A5.SS3.p3.1" class="ltx_p"><span id="A5.SS3.p3.1.1" class="ltx_text">Choosing <math id="A5.SS3.p3.m1" class="ltx_Math" alttext="\bm{\mu}_{1}" display="inline" intent=":literal"><semantics><msub><mi>𝝁</mi><mn>1</mn></msub><annotation encoding="application/x-tex">\bm{\mu}_{1}</annotation></semantics></math>, <math id="A5.SS3.p3.m2" class="ltx_Math" alttext="\bm{\nu}_{1}" display="inline" intent=":literal"><semantics><msub><mi>𝝂</mi><mn>1</mn></msub><annotation encoding="application/x-tex">\bm{\nu}_{1}</annotation></semantics></math> and <math id="A5.SS3.p3.m3" class="ltx_Math" alttext="\bm{\mu}_{2}" display="inline" intent=":literal"><semantics><msub><mi>𝝁</mi><mn>2</mn></msub><annotation encoding="application/x-tex">\bm{\mu}_{2}</annotation></semantics></math> as in Lemmas <a href="#Thmconj214" title="Lemma 14. ‣ E.1 Construction of multi-head self-attention layers ‣ Appendix E Construction of the Transformer ‣ Generalization Bounds for Transformer-Based Next-Token Prediction in a Language Model" class="ltx_ref"><span class="ltx_text ltx_ref_tag">14</span></a>, <a href="#Thmconj224" title="Lemma 24. ‣ E.2 Construction of multilayer perceptron layers ‣ Appendix E Construction of the Transformer ‣ Generalization Bounds for Transformer-Based Next-Token Prediction in a Language Model" class="ltx_ref"><span class="ltx_text ltx_ref_tag">24</span></a> and <a href="#Thmconj215" title="Lemma 15. ‣ E.1 Construction of multi-head self-attention layers ‣ Appendix E Construction of the Transformer ‣ Generalization Bounds for Transformer-Based Next-Token Prediction in a Language Model" class="ltx_ref"><span class="ltx_text ltx_ref_tag">15</span></a>, the error can be decomposed via the triangle inequality into three terms,</span></p>
<table id="A5.EGx127" class="ltx_equationgroup ltx_eqn_align ltx_eqn_table">

<tbody id="A5.Ex318"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_eqn_cell"></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A5.Ex318.m1" class="ltx_math_unparsed" alttext="\displaystyle\left\|\big(\bm{\mu}_{2}\circ\bm{\nu}_{1}\circ\bm{\mu}_{1}(M)\big)_{:,T}-\bm{\mu}_{2,0}\circ\bm{\nu}_{1,0}\circ\bm{\mu}_{1,0}(M)\right\|_{\infty,m_{1},m_{2}}" display="inline" intent=":literal"><semantics><msub><mrow><mo>‖</mo><msub><mrow><mo maxsize="1.200em" minsize="1.200em">(</mo><msub><mi>𝝁</mi><mn>2</mn></msub><mo lspace="0.222em" rspace="0.222em">∘</mo><msub><mi>𝝂</mi><mn>1</mn></msub><mo lspace="0.222em" rspace="0.222em">∘</mo><msub><mi>𝝁</mi><mn>1</mn></msub><mrow><mo stretchy="false">(</mo><mi>M</mi><mo stretchy="false">)</mo></mrow><mo maxsize="1.200em" minsize="1.200em">)</mo></mrow><mrow><mo rspace="0em">:</mo><mo>,</mo><mi>T</mi></mrow></msub><mo>−</mo><msub><mi>𝝁</mi><mrow><mn>2</mn><mo>,</mo><mn>0</mn></mrow></msub><mo lspace="0.222em" rspace="0.222em">∘</mo><msub><mi>𝝂</mi><mrow><mn>1</mn><mo>,</mo><mn>0</mn></mrow></msub><mo lspace="0.222em" rspace="0.222em">∘</mo><msub><mi>𝝁</mi><mrow><mn>1</mn><mo>,</mo><mn>0</mn></mrow></msub><mrow><mo stretchy="false">(</mo><mi>M</mi><mo stretchy="false">)</mo></mrow><mo>‖</mo></mrow><mrow><mi mathvariant="normal">∞</mi><mo>,</mo><msub><mi>m</mi><mn>1</mn></msub><mo>,</mo><msub><mi>m</mi><mn>2</mn></msub></mrow></msub><annotation encoding="application/x-tex">\displaystyle\left\|\big(\bm{\mu}_{2}\circ\bm{\nu}_{1}\circ\bm{\mu}_{1}(M)\big)_{:,T}-\bm{\mu}_{2,0}\circ\bm{\nu}_{1,0}\circ\bm{\mu}_{1,0}(M)\right\|_{\infty,m_{1},m_{2}}</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
<tbody id="A5.E68"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_eqn_cell"></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A5.E68.m1" class="ltx_math_unparsed" alttext="\displaystyle\leq\left\|\big(\bm{\mu}_{2}\circ\bm{\nu}_{1}\circ\bm{\mu}_{1}(M)\big)_{:,T}-\bm{\mu}_{2,0}\circ\bm{\nu}_{1}\circ\bm{\mu}_{1}(M)\right\|_{\infty,m_{1},m_{2}}" display="inline" intent=":literal"><semantics><mrow><mo>≤</mo><msub><mrow><mo>‖</mo><msub><mrow><mo maxsize="1.200em" minsize="1.200em">(</mo><msub><mi>𝝁</mi><mn>2</mn></msub><mo lspace="0.222em" rspace="0.222em">∘</mo><msub><mi>𝝂</mi><mn>1</mn></msub><mo lspace="0.222em" rspace="0.222em">∘</mo><msub><mi>𝝁</mi><mn>1</mn></msub><mrow><mo stretchy="false">(</mo><mi>M</mi><mo stretchy="false">)</mo></mrow><mo maxsize="1.200em" minsize="1.200em">)</mo></mrow><mrow><mo rspace="0em">:</mo><mo>,</mo><mi>T</mi></mrow></msub><mo>−</mo><msub><mi>𝝁</mi><mrow><mn>2</mn><mo>,</mo><mn>0</mn></mrow></msub><mo lspace="0.222em" rspace="0.222em">∘</mo><msub><mi>𝝂</mi><mn>1</mn></msub><mo lspace="0.222em" rspace="0.222em">∘</mo><msub><mi>𝝁</mi><mn>1</mn></msub><mrow><mo stretchy="false">(</mo><mi>M</mi><mo stretchy="false">)</mo></mrow><mo>‖</mo></mrow><mrow><mi mathvariant="normal">∞</mi><mo>,</mo><msub><mi>m</mi><mn>1</mn></msub><mo>,</mo><msub><mi>m</mi><mn>2</mn></msub></mrow></msub></mrow><annotation encoding="application/x-tex">\displaystyle\leq\left\|\big(\bm{\mu}_{2}\circ\bm{\nu}_{1}\circ\bm{\mu}_{1}(M)\big)_{:,T}-\bm{\mu}_{2,0}\circ\bm{\nu}_{1}\circ\bm{\mu}_{1}(M)\right\|_{\infty,m_{1},m_{2}}</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td>
<td rowspan="1" class="ltx_eqn_cell ltx_eqn_eqno ltx_align_middle ltx_align_right"><span class="ltx_tag ltx_tag_equation ltx_align_right">(68)</span></td></tr></tbody>
<tbody id="A5.E69"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_eqn_cell"></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A5.E69.m1" class="ltx_Math" alttext="\displaystyle\quad+\left\|\bm{\mu}_{2,0}\circ\bm{\nu}_{1}\circ\bm{\mu}_{1}\left(M\right)-\bm{\mu}_{2,0}\circ\bm{\nu}_{1,0}\circ\bm{\mu}_{1}(M)\right\|_{\infty,m_{1},m_{2}}" display="inline" intent=":literal"><semantics><mrow><mo>+</mo><msub><mrow><mo>‖</mo><mrow><mrow><msub><mi>𝝁</mi><mrow><mn>2</mn><mo>,</mo><mn>0</mn></mrow></msub><mo lspace="0.222em" rspace="0.222em">∘</mo><msub><mi>𝝂</mi><mn>1</mn></msub><mo lspace="0.222em" rspace="0.222em">∘</mo><mrow><msub><mi>𝝁</mi><mn>1</mn></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo>(</mo><mi>M</mi><mo>)</mo></mrow></mrow></mrow><mo>−</mo><mrow><msub><mi>𝝁</mi><mrow><mn>2</mn><mo>,</mo><mn>0</mn></mrow></msub><mo lspace="0.222em" rspace="0.222em">∘</mo><msub><mi>𝝂</mi><mrow><mn>1</mn><mo>,</mo><mn>0</mn></mrow></msub><mo lspace="0.222em" rspace="0.222em">∘</mo><mrow><msub><mi>𝝁</mi><mn>1</mn></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>M</mi><mo stretchy="false">)</mo></mrow></mrow></mrow></mrow><mo>‖</mo></mrow><mrow><mi mathvariant="normal">∞</mi><mo>,</mo><msub><mi>m</mi><mn>1</mn></msub><mo>,</mo><msub><mi>m</mi><mn>2</mn></msub></mrow></msub></mrow><annotation encoding="application/x-tex">\displaystyle\quad+\left\|\bm{\mu}_{2,0}\circ\bm{\nu}_{1}\circ\bm{\mu}_{1}\left(M\right)-\bm{\mu}_{2,0}\circ\bm{\nu}_{1,0}\circ\bm{\mu}_{1}(M)\right\|_{\infty,m_{1},m_{2}}</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td>
<td rowspan="1" class="ltx_eqn_cell ltx_eqn_eqno ltx_align_middle ltx_align_right"><span class="ltx_tag ltx_tag_equation ltx_align_right">(69)</span></td></tr></tbody>
<tbody id="A5.E70"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_eqn_cell"></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A5.E70.m1" class="ltx_Math" alttext="\displaystyle\quad+\left\|\bm{\mu}_{2,0}\circ\bm{\nu}_{1,0}\circ\bm{\mu}_{1}(M)-\bm{\mu}_{2,0}\circ\bm{\nu}_{1,0}\circ\bm{\mu}_{1,0}(M)\right\|_{\infty,m_{1},m_{2}}." display="inline" intent=":literal"><semantics><mrow><mrow><mo>+</mo><msub><mrow><mo>‖</mo><mrow><mrow><msub><mi>𝝁</mi><mrow><mn>2</mn><mo>,</mo><mn>0</mn></mrow></msub><mo lspace="0.222em" rspace="0.222em">∘</mo><msub><mi>𝝂</mi><mrow><mn>1</mn><mo>,</mo><mn>0</mn></mrow></msub><mo lspace="0.222em" rspace="0.222em">∘</mo><mrow><msub><mi>𝝁</mi><mn>1</mn></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>M</mi><mo stretchy="false">)</mo></mrow></mrow></mrow><mo>−</mo><mrow><msub><mi>𝝁</mi><mrow><mn>2</mn><mo>,</mo><mn>0</mn></mrow></msub><mo lspace="0.222em" rspace="0.222em">∘</mo><msub><mi>𝝂</mi><mrow><mn>1</mn><mo>,</mo><mn>0</mn></mrow></msub><mo lspace="0.222em" rspace="0.222em">∘</mo><mrow><msub><mi>𝝁</mi><mrow><mn>1</mn><mo>,</mo><mn>0</mn></mrow></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>M</mi><mo stretchy="false">)</mo></mrow></mrow></mrow></mrow><mo>‖</mo></mrow><mrow><mi mathvariant="normal">∞</mi><mo>,</mo><msub><mi>m</mi><mn>1</mn></msub><mo>,</mo><msub><mi>m</mi><mn>2</mn></msub></mrow></msub></mrow><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">\displaystyle\quad+\left\|\bm{\mu}_{2,0}\circ\bm{\nu}_{1,0}\circ\bm{\mu}_{1}(M)-\bm{\mu}_{2,0}\circ\bm{\nu}_{1,0}\circ\bm{\mu}_{1,0}(M)\right\|_{\infty,m_{1},m_{2}}.</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td>
<td rowspan="1" class="ltx_eqn_cell ltx_eqn_eqno ltx_align_middle ltx_align_right"><span class="ltx_tag ltx_tag_equation ltx_align_right">(70)</span></td></tr></tbody>
</table>
<p id="A5.SS3.p3.2" class="ltx_p"><span id="A5.SS3.p3.2.1" class="ltx_text">To derive some properties of the vectors <math id="A5.SS3.p3.m4" class="ltx_Math" alttext="\bm{\mu}_{1}(M)" display="inline" intent=":literal"><semantics><mrow><msub><mi>𝝁</mi><mn>1</mn></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>M</mi><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">\bm{\mu}_{1}(M)</annotation></semantics></math> and
<math id="A5.SS3.p3.m5" class="ltx_Math" alttext="\bm{\nu}_{1}\circ\bm{\mu}_{1}(M)" display="inline" intent=":literal"><semantics><mrow><mrow><msub><mi>𝝂</mi><mn>1</mn></msub><mo lspace="0.222em" rspace="0.222em">∘</mo><msub><mi>𝝁</mi><mn>1</mn></msub></mrow><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>M</mi><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">\bm{\nu}_{1}\circ\bm{\mu}_{1}(M)</annotation></semantics></math>, set</span></p>
<table id="A5.EGx128" class="ltx_equationgroup ltx_eqn_align ltx_eqn_table">

<tbody id="A5.EGx128.1"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_align_right ltx_eqn_cell"><math id="A5.EGx128.m1" class="ltx_Math" alttext="\displaystyle\bm{\mu}_{1}(M)\eqcolon\left(\begin{matrix}\mathbf{a}_{1,t}\\
\mathbf{a}_{2,t}\\
\mathbf{a}_{3,t}\\
\mathbf{a}_{4,t}\\
\mathbf{a}_{5,t}\\
\mathbf{a}_{6,t}\\
\mathbf{a}_{7,t}\\
\end{matrix}\right)_{t\in[T]}\begin{array}[]{l}\in\mathbb{R}^{m_{1}}\\
\in\mathbb{R}^{m_{2}}\\
\in\mathbb{R}^{m_{1}}\\
\in\mathbb{R}^{(r_{1}-1)m_{1}}\\
\in\mathbb{R}^{r_{2}m_{2}}\\
\in\mathbb{R}^{N/2-(r_{1}+1)m_{1}-(r_{2}+1)m_{2}}\\
\in\mathbb{R}^{N/2}\end{array},\,\bm{\nu}_{1}\circ\bm{\mu}_{1}(M)\eqcolon\left(\begin{matrix}\mathbf{b}_{1,t}\\
\mathbf{b}_{2,t}\\
\mathbf{b}_{3,t}\\
\mathbf{b}_{4,t}\\
\mathbf{b}_{5,t}\\
b_{6,t}\\
b_{7,t}\\
\mathbf{b}_{8,t}\\
\end{matrix}\right)_{t\in[T]}\begin{array}[]{l}\in\mathbb{R}^{m_{1}}\\
\in\mathbb{R}^{m_{2}}\\
\in\mathbb{R}^{m_{2}}\\
\in\mathbb{R}^{(r_{2}-1)m_{2}}\\
\in\mathbb{R}^{m_{2}}\\
\in\mathbb{R}\\
\in\mathbb{R}\\
\in\mathbb{R}^{N-m_{1}-(r_{2}+2)m_{2}-2}\end{array}." display="inline" intent=":literal"><semantics><mrow><mrow><mrow><mrow><msub><mi>𝝁</mi><mn>1</mn></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>M</mi><mo stretchy="false">)</mo></mrow></mrow><mo>≕</mo><mrow><msub><mrow><mo>(</mo><mtable rowspacing="0pt"><mtr><mtd><msub><mi>𝐚</mi><mrow><mn>1</mn><mo>,</mo><mi>t</mi></mrow></msub></mtd></mtr><mtr><mtd><msub><mi>𝐚</mi><mrow><mn>2</mn><mo>,</mo><mi>t</mi></mrow></msub></mtd></mtr><mtr><mtd><msub><mi>𝐚</mi><mrow><mn>3</mn><mo>,</mo><mi>t</mi></mrow></msub></mtd></mtr><mtr><mtd><msub><mi>𝐚</mi><mrow><mn>4</mn><mo>,</mo><mi>t</mi></mrow></msub></mtd></mtr><mtr><mtd><msub><mi>𝐚</mi><mrow><mn>5</mn><mo>,</mo><mi>t</mi></mrow></msub></mtd></mtr><mtr><mtd><msub><mi>𝐚</mi><mrow><mn>6</mn><mo>,</mo><mi>t</mi></mrow></msub></mtd></mtr><mtr><mtd><msub><mi>𝐚</mi><mrow><mn>7</mn><mo>,</mo><mi>t</mi></mrow></msub></mtd></mtr></mtable><mo>)</mo></mrow><mrow><mi>t</mi><mo>∈</mo><mrow><mo stretchy="false">[</mo><mi>T</mi><mo stretchy="false">]</mo></mrow></mrow></msub><mo lspace="0.167em" rspace="0em">​</mo><mtable rowspacing="0pt"><mtr><mtd class="ltx_align_left" columnalign="left"><mrow><mphantom></mphantom><mo>∈</mo><msup><mi>ℝ</mi><msub><mi>m</mi><mn>1</mn></msub></msup></mrow></mtd></mtr><mtr><mtd class="ltx_align_left" columnalign="left"><mrow><mphantom></mphantom><mo>∈</mo><msup><mi>ℝ</mi><msub><mi>m</mi><mn>2</mn></msub></msup></mrow></mtd></mtr><mtr><mtd class="ltx_align_left" columnalign="left"><mrow><mphantom></mphantom><mo>∈</mo><msup><mi>ℝ</mi><msub><mi>m</mi><mn>1</mn></msub></msup></mrow></mtd></mtr><mtr><mtd class="ltx_align_left" columnalign="left"><mrow><mphantom></mphantom><mo>∈</mo><msup><mi>ℝ</mi><mrow><mrow><mo stretchy="false">(</mo><mrow><msub><mi>r</mi><mn>1</mn></msub><mo>−</mo><mn>1</mn></mrow><mo stretchy="false">)</mo></mrow><mo lspace="0em" rspace="0em">​</mo><msub><mi>m</mi><mn>1</mn></msub></mrow></msup></mrow></mtd></mtr><mtr><mtd class="ltx_align_left" columnalign="left"><mrow><mphantom></mphantom><mo>∈</mo><msup><mi>ℝ</mi><mrow><msub><mi>r</mi><mn>2</mn></msub><mo lspace="0em" rspace="0em">​</mo><msub><mi>m</mi><mn>2</mn></msub></mrow></msup></mrow></mtd></mtr><mtr><mtd class="ltx_align_left" columnalign="left"><mrow><mphantom></mphantom><mo>∈</mo><msup><mi>ℝ</mi><mrow><mrow><mi>N</mi><mo>/</mo><mn>2</mn></mrow><mo>−</mo><mrow><mrow><mo stretchy="false">(</mo><mrow><msub><mi>r</mi><mn>1</mn></msub><mo>+</mo><mn>1</mn></mrow><mo stretchy="false">)</mo></mrow><mo lspace="0em" rspace="0em">​</mo><msub><mi>m</mi><mn>1</mn></msub></mrow><mo>−</mo><mrow><mrow><mo stretchy="false">(</mo><mrow><msub><mi>r</mi><mn>2</mn></msub><mo>+</mo><mn>1</mn></mrow><mo stretchy="false">)</mo></mrow><mo lspace="0em" rspace="0em">​</mo><msub><mi>m</mi><mn>2</mn></msub></mrow></mrow></msup></mrow></mtd></mtr><mtr><mtd class="ltx_align_left" columnalign="left"><mrow><mphantom></mphantom><mo>∈</mo><msup><mi>ℝ</mi><mrow><mi>N</mi><mo>/</mo><mn>2</mn></mrow></msup></mrow></mtd></mtr></mtable></mrow></mrow><mo lspace="0.167em" rspace="0.337em">,</mo><mrow><mrow><mrow><msub><mi>𝝂</mi><mn>1</mn></msub><mo lspace="0.222em" rspace="0.222em">∘</mo><msub><mi>𝝁</mi><mn>1</mn></msub></mrow><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>M</mi><mo stretchy="false">)</mo></mrow></mrow><mo>≕</mo><mrow><msub><mrow><mo>(</mo><mtable rowspacing="0pt"><mtr><mtd><msub><mi>𝐛</mi><mrow><mn>1</mn><mo>,</mo><mi>t</mi></mrow></msub></mtd></mtr><mtr><mtd><msub><mi>𝐛</mi><mrow><mn>2</mn><mo>,</mo><mi>t</mi></mrow></msub></mtd></mtr><mtr><mtd><msub><mi>𝐛</mi><mrow><mn>3</mn><mo>,</mo><mi>t</mi></mrow></msub></mtd></mtr><mtr><mtd><msub><mi>𝐛</mi><mrow><mn>4</mn><mo>,</mo><mi>t</mi></mrow></msub></mtd></mtr><mtr><mtd><msub><mi>𝐛</mi><mrow><mn>5</mn><mo>,</mo><mi>t</mi></mrow></msub></mtd></mtr><mtr><mtd><msub><mi>b</mi><mrow><mn>6</mn><mo>,</mo><mi>t</mi></mrow></msub></mtd></mtr><mtr><mtd><msub><mi>b</mi><mrow><mn>7</mn><mo>,</mo><mi>t</mi></mrow></msub></mtd></mtr><mtr><mtd><msub><mi>𝐛</mi><mrow><mn>8</mn><mo>,</mo><mi>t</mi></mrow></msub></mtd></mtr></mtable><mo>)</mo></mrow><mrow><mi>t</mi><mo>∈</mo><mrow><mo stretchy="false">[</mo><mi>T</mi><mo stretchy="false">]</mo></mrow></mrow></msub><mo lspace="0.167em" rspace="0em">​</mo><mtable rowspacing="0pt"><mtr><mtd class="ltx_align_left" columnalign="left"><mrow><mphantom></mphantom><mo>∈</mo><msup><mi>ℝ</mi><msub><mi>m</mi><mn>1</mn></msub></msup></mrow></mtd></mtr><mtr><mtd class="ltx_align_left" columnalign="left"><mrow><mphantom></mphantom><mo>∈</mo><msup><mi>ℝ</mi><msub><mi>m</mi><mn>2</mn></msub></msup></mrow></mtd></mtr><mtr><mtd class="ltx_align_left" columnalign="left"><mrow><mphantom></mphantom><mo>∈</mo><msup><mi>ℝ</mi><msub><mi>m</mi><mn>2</mn></msub></msup></mrow></mtd></mtr><mtr><mtd class="ltx_align_left" columnalign="left"><mrow><mphantom></mphantom><mo>∈</mo><msup><mi>ℝ</mi><mrow><mrow><mo stretchy="false">(</mo><mrow><msub><mi>r</mi><mn>2</mn></msub><mo>−</mo><mn>1</mn></mrow><mo stretchy="false">)</mo></mrow><mo lspace="0em" rspace="0em">​</mo><msub><mi>m</mi><mn>2</mn></msub></mrow></msup></mrow></mtd></mtr><mtr><mtd class="ltx_align_left" columnalign="left"><mrow><mphantom></mphantom><mo>∈</mo><msup><mi>ℝ</mi><msub><mi>m</mi><mn>2</mn></msub></msup></mrow></mtd></mtr><mtr><mtd class="ltx_align_left" columnalign="left"><mrow><mphantom></mphantom><mo>∈</mo><mi>ℝ</mi></mrow></mtd></mtr><mtr><mtd class="ltx_align_left" columnalign="left"><mrow><mphantom></mphantom><mo>∈</mo><mi>ℝ</mi></mrow></mtd></mtr><mtr><mtd class="ltx_align_left" columnalign="left"><mrow><mphantom></mphantom><mo>∈</mo><msup><mi>ℝ</mi><mrow><mi>N</mi><mo>−</mo><msub><mi>m</mi><mn>1</mn></msub><mo>−</mo><mrow><mrow><mo stretchy="false">(</mo><mrow><msub><mi>r</mi><mn>2</mn></msub><mo>+</mo><mn>2</mn></mrow><mo stretchy="false">)</mo></mrow><mo lspace="0em" rspace="0em">​</mo><msub><mi>m</mi><mn>2</mn></msub></mrow><mo>−</mo><mn>2</mn></mrow></msup></mrow></mtd></mtr></mtable></mrow></mrow></mrow><mo lspace="0.167em">.</mo></mrow><annotation encoding="application/x-tex">\displaystyle\bm{\mu}_{1}(M)\eqcolon\left(\begin{matrix}\mathbf{a}_{1,t}\\
\mathbf{a}_{2,t}\\
\mathbf{a}_{3,t}\\
\mathbf{a}_{4,t}\\
\mathbf{a}_{5,t}\\
\mathbf{a}_{6,t}\\
\mathbf{a}_{7,t}\\
\end{matrix}\right)_{t\in[T]}\begin{array}[]{l}\in\mathbb{R}^{m_{1}}\\
\in\mathbb{R}^{m_{2}}\\
\in\mathbb{R}^{m_{1}}\\
\in\mathbb{R}^{(r_{1}-1)m_{1}}\\
\in\mathbb{R}^{r_{2}m_{2}}\\
\in\mathbb{R}^{N/2-(r_{1}+1)m_{1}-(r_{2}+1)m_{2}}\\
\in\mathbb{R}^{N/2}\end{array},\,\bm{\nu}_{1}\circ\bm{\mu}_{1}(M)\eqcolon\left(\begin{matrix}\mathbf{b}_{1,t}\\
\mathbf{b}_{2,t}\\
\mathbf{b}_{3,t}\\
\mathbf{b}_{4,t}\\
\mathbf{b}_{5,t}\\
b_{6,t}\\
b_{7,t}\\
\mathbf{b}_{8,t}\\
\end{matrix}\right)_{t\in[T]}\begin{array}[]{l}\in\mathbb{R}^{m_{1}}\\
\in\mathbb{R}^{m_{2}}\\
\in\mathbb{R}^{m_{2}}\\
\in\mathbb{R}^{(r_{2}-1)m_{2}}\\
\in\mathbb{R}^{m_{2}}\\
\in\mathbb{R}\\
\in\mathbb{R}\\
\in\mathbb{R}^{N-m_{1}-(r_{2}+2)m_{2}-2}\end{array}.</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="A5.SS3.p3.3" class="ltx_p"><span id="A5.SS3.p3.3.1" class="ltx_text">By Lemma <a href="#Thmconj214" title="Lemma 14. ‣ E.1 Construction of multi-head self-attention layers ‣ Appendix E Construction of the Transformer ‣ Generalization Bounds for Transformer-Based Next-Token Prediction in a Language Model" class="ltx_ref"><span class="ltx_text ltx_ref_tag">14</span></a> and the definition of <math id="A5.SS3.p3.m6" class="ltx_Math" alttext="M" display="inline" intent=":literal"><semantics><mi>M</mi><annotation encoding="application/x-tex">M</annotation></semantics></math>, we have</span></p>
<table id="A5.EGx129" class="ltx_equationgroup ltx_eqn_align ltx_eqn_table">

<tbody id="A5.E86"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_align_right ltx_eqn_cell"><math id="A5.E86.m1" class="ltx_Math" alttext="\displaystyle\|\operatorname{stack}(\mathbf{a}_{3,t},\mathbf{a}_{4,t})-\mathbf{Z}_{1,t}\|_{\infty}\lesssim T^{1-\log T},\qquad\|\mathbf{a}_{5,t}-\mathbf{Z}_{2,t}\|_{\infty}\lesssim T^{1-\log T}" display="inline" intent=":literal"><semantics><mrow><mrow><msub><mrow><mo stretchy="false">‖</mo><mrow><mrow><mi>stack</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><msub><mi>𝐚</mi><mrow><mn>3</mn><mo>,</mo><mi>t</mi></mrow></msub><mo>,</mo><msub><mi>𝐚</mi><mrow><mn>4</mn><mo>,</mo><mi>t</mi></mrow></msub><mo stretchy="false">)</mo></mrow></mrow><mo>−</mo><msub><mi>𝐙</mi><mrow><mn>1</mn><mo>,</mo><mi>t</mi></mrow></msub></mrow><mo stretchy="false">‖</mo></mrow><mi mathvariant="normal">∞</mi></msub><mo>≲</mo><msup><mi>T</mi><mrow><mn>1</mn><mo>−</mo><mrow><mi>log</mi><mo lspace="0.167em">⁡</mo><mi>T</mi></mrow></mrow></msup></mrow><mo rspace="2.167em">,</mo><mrow><msub><mrow><mo stretchy="false">‖</mo><mrow><msub><mi>𝐚</mi><mrow><mn>5</mn><mo>,</mo><mi>t</mi></mrow></msub><mo>−</mo><msub><mi>𝐙</mi><mrow><mn>2</mn><mo>,</mo><mi>t</mi></mrow></msub></mrow><mo stretchy="false">‖</mo></mrow><mi mathvariant="normal">∞</mi></msub><mo>≲</mo><msup><mi>T</mi><mrow><mn>1</mn><mo>−</mo><mrow><mi>log</mi><mo lspace="0.167em">⁡</mo><mi>T</mi></mrow></mrow></msup></mrow></mrow><annotation encoding="application/x-tex">\displaystyle\|\operatorname{stack}(\mathbf{a}_{3,t},\mathbf{a}_{4,t})-\mathbf{Z}_{1,t}\|_{\infty}\lesssim T^{1-\log T},\qquad\|\mathbf{a}_{5,t}-\mathbf{Z}_{2,t}\|_{\infty}\lesssim T^{1-\log T}</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td>
<td rowspan="1" class="ltx_eqn_cell ltx_eqn_eqno ltx_align_middle ltx_align_right"><span class="ltx_tag ltx_tag_equation ltx_align_right">(86)</span></td></tr></tbody>
</table>
<p id="A5.SS3.p3.4" class="ltx_p"><span id="A5.SS3.p3.4.1" class="ltx_text">for all <math id="A5.SS3.p3.m7" class="ltx_Math" alttext="t\in\{(r_{1}\vee r_{2})+1,\ldots,T\}" display="inline" intent=":literal"><semantics><mrow><mi>t</mi><mo>∈</mo><mrow><mo stretchy="false">{</mo><mrow><mrow><mrow><mo stretchy="false">(</mo><mrow><msub><mi>r</mi><mn>1</mn></msub><mo>∨</mo><msub><mi>r</mi><mn>2</mn></msub></mrow><mo stretchy="false">)</mo></mrow><mo>+</mo><mn>1</mn></mrow><mo>,</mo><mi mathvariant="normal">…</mi><mo>,</mo><mi>T</mi></mrow><mo stretchy="false">}</mo></mrow></mrow><annotation encoding="application/x-tex">t\in\{(r_{1}\vee r_{2})+1,\ldots,T\}</annotation></semantics></math>. Moreover, using that <math id="A5.SS3.p3.m8" class="ltx_Math" alttext="\|\mathbf{y}_{a,t}\|_{\infty}\leq 1" display="inline" intent=":literal"><semantics><mrow><msub><mrow><mo stretchy="false">‖</mo><msub><mi>𝐲</mi><mrow><mi>a</mi><mo>,</mo><mi>t</mi></mrow></msub><mo stretchy="false">‖</mo></mrow><mi mathvariant="normal">∞</mi></msub><mo>≤</mo><mn>1</mn></mrow><annotation encoding="application/x-tex">\|\mathbf{y}_{a,t}\|_{\infty}\leq 1</annotation></semantics></math> in Lemma <a href="#Thmconj214" title="Lemma 14. ‣ E.1 Construction of multi-head self-attention layers ‣ Appendix E Construction of the Transformer ‣ Generalization Bounds for Transformer-Based Next-Token Prediction in a Language Model" class="ltx_ref"><span class="ltx_text ltx_ref_tag">14</span></a>,</span></p>
<table id="A5.EGx130" class="ltx_equationgroup ltx_eqn_align ltx_eqn_table">

<tbody id="A5.E87"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_align_right ltx_eqn_cell"><math id="A5.E87.m1" class="ltx_Math" alttext="\displaystyle\mathbf{a}_{1,t}=\bm{\phi}_{1}(X_{t}),\,\mathbf{a}_{2,t}=\bm{\phi}_{2}(X_{t}),\,\|\operatorname{stack}(\mathbf{a}_{3,t},\mathbf{a}_{4,t},\mathbf{a}_{5,t})\|_{\infty}\leq 1,\,\mathbf{a}_{6,t}=\bm{0}_{\tfrac{N}{2}-(r_{1}+1)m_{1}-(r_{2}+1)m_{2}},\,\mathbf{a}_{7,t}=\mathbf{q}_{t}" display="inline" intent=":literal"><semantics><mrow><mrow><msub><mi>𝐚</mi><mrow><mn>1</mn><mo>,</mo><mi>t</mi></mrow></msub><mo>=</mo><mrow><msub><mi class="ltx_mathvariant_bold-italic" mathvariant="bold-italic">ϕ</mi><mn>1</mn></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mi>X</mi><mi>t</mi></msub><mo stretchy="false">)</mo></mrow></mrow></mrow><mo rspace="0.337em">,</mo><mrow><msub><mi>𝐚</mi><mrow><mn>2</mn><mo>,</mo><mi>t</mi></mrow></msub><mo>=</mo><mrow><msub><mi class="ltx_mathvariant_bold-italic" mathvariant="bold-italic">ϕ</mi><mn>2</mn></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mi>X</mi><mi>t</mi></msub><mo stretchy="false">)</mo></mrow></mrow></mrow><mo rspace="0.337em">,</mo><mrow><msub><mrow><mo stretchy="false">‖</mo><mrow><mi>stack</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><msub><mi>𝐚</mi><mrow><mn>3</mn><mo>,</mo><mi>t</mi></mrow></msub><mo>,</mo><msub><mi>𝐚</mi><mrow><mn>4</mn><mo>,</mo><mi>t</mi></mrow></msub><mo>,</mo><msub><mi>𝐚</mi><mrow><mn>5</mn><mo>,</mo><mi>t</mi></mrow></msub><mo stretchy="false">)</mo></mrow></mrow><mo stretchy="false">‖</mo></mrow><mi mathvariant="normal">∞</mi></msub><mo>≤</mo><mn>1</mn></mrow><mo rspace="0.337em">,</mo><mrow><msub><mi>𝐚</mi><mrow><mn>6</mn><mo>,</mo><mi>t</mi></mrow></msub><mo>=</mo><msub><mn>𝟎</mn><mrow><mstyle scriptlevel="-1"><mfrac><mi>N</mi><mn>2</mn></mfrac></mstyle><mo>−</mo><mrow><mrow><mo stretchy="false">(</mo><mrow><msub><mi>r</mi><mn>1</mn></msub><mo>+</mo><mn>1</mn></mrow><mo stretchy="false">)</mo></mrow><mo lspace="0em" rspace="0em">​</mo><msub><mi>m</mi><mn>1</mn></msub></mrow><mo>−</mo><mrow><mrow><mo stretchy="false">(</mo><mrow><msub><mi>r</mi><mn>2</mn></msub><mo>+</mo><mn>1</mn></mrow><mo stretchy="false">)</mo></mrow><mo lspace="0em" rspace="0em">​</mo><msub><mi>m</mi><mn>2</mn></msub></mrow></mrow></msub></mrow><mo rspace="0.337em">,</mo><mrow><msub><mi>𝐚</mi><mrow><mn>7</mn><mo>,</mo><mi>t</mi></mrow></msub><mo>=</mo><msub><mi>𝐪</mi><mi>t</mi></msub></mrow></mrow><annotation encoding="application/x-tex">\displaystyle\mathbf{a}_{1,t}=\bm{\phi}_{1}(X_{t}),\,\mathbf{a}_{2,t}=\bm{\phi}_{2}(X_{t}),\,\|\operatorname{stack}(\mathbf{a}_{3,t},\mathbf{a}_{4,t},\mathbf{a}_{5,t})\|_{\infty}\leq 1,\,\mathbf{a}_{6,t}=\bm{0}_{\tfrac{N}{2}-(r_{1}+1)m_{1}-(r_{2}+1)m_{2}},\,\mathbf{a}_{7,t}=\mathbf{q}_{t}</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td>
<td rowspan="1" class="ltx_eqn_cell ltx_eqn_eqno ltx_align_middle ltx_align_right"><span class="ltx_tag ltx_tag_equation ltx_align_right">(87)</span></td></tr></tbody>
</table>
<p id="A5.SS3.p3.5" class="ltx_p"><span id="A5.SS3.p3.5.1" class="ltx_text">for all <math id="A5.SS3.p3.m9" class="ltx_Math" alttext="t\in[T]" display="inline" intent=":literal"><semantics><mrow><mi>t</mi><mo>∈</mo><mrow><mo stretchy="false">[</mo><mi>T</mi><mo stretchy="false">]</mo></mrow></mrow><annotation encoding="application/x-tex">t\in[T]</annotation></semantics></math>.
It follows from Lemma <a href="#Thmconj224" title="Lemma 24. ‣ E.2 Construction of multilayer perceptron layers ‣ Appendix E Construction of the Transformer ‣ Generalization Bounds for Transformer-Based Next-Token Prediction in a Language Model" class="ltx_ref"><span class="ltx_text ltx_ref_tag">24</span></a> and <math id="A5.SS3.p3.m10" class="ltx_Math" alttext="\|\mathbf{g}_{0}\|_{\infty}\leq\delta_{1}" display="inline" intent=":literal"><semantics><mrow><msub><mrow><mo stretchy="false">‖</mo><msub><mi>𝐠</mi><mn>0</mn></msub><mo stretchy="false">‖</mo></mrow><mi mathvariant="normal">∞</mi></msub><mo>≤</mo><msub><mi>δ</mi><mn>1</mn></msub></mrow><annotation encoding="application/x-tex">\|\mathbf{g}_{0}\|_{\infty}\leq\delta_{1}</annotation></semantics></math> that for all sufficiently large <math id="A5.SS3.p3.m11" class="ltx_Math" alttext="N_{\mathrm{mlp}}" display="inline" intent=":literal"><semantics><msub><mi>N</mi><mi>mlp</mi></msub><annotation encoding="application/x-tex">N_{\mathrm{mlp}}</annotation></semantics></math> and any <math id="A5.SS3.p3.m12" class="ltx_Math" alttext="t\in[T]," display="inline" intent=":literal"><semantics><mrow><mrow><mi>t</mi><mo>∈</mo><mrow><mo stretchy="false">[</mo><mi>T</mi><mo stretchy="false">]</mo></mrow></mrow><mo>,</mo></mrow><annotation encoding="application/x-tex">t\in[T],</annotation></semantics></math></span></p>
<table id="A5.EGx131" class="ltx_equationgroup ltx_eqn_align ltx_eqn_table">

<tbody id="A5.E88"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_align_right ltx_eqn_cell"><math id="A5.E88.m1" class="ltx_Math" alttext="\displaystyle\|\mathbf{b}_{1,t}\|_{\infty}" display="inline" intent=":literal"><semantics><msub><mrow><mo stretchy="false">‖</mo><msub><mi>𝐛</mi><mrow><mn>1</mn><mo>,</mo><mi>t</mi></mrow></msub><mo stretchy="false">‖</mo></mrow><mi mathvariant="normal">∞</mi></msub><annotation encoding="application/x-tex">\displaystyle\|\mathbf{b}_{1,t}\|_{\infty}</annotation></semantics></math></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A5.E88.m2" class="ltx_Math" alttext="\displaystyle\leq 1+\delta_{1},\quad\|\mathbf{b}_{2,t}\|_{\infty}\leq 1+\exp(\delta_{1}m_{1}),\quad\|\mathbf{b}_{3,t}\|_{\infty}\leq\frac{1}{\lambda},\quad\|\mathbf{b}_{4,t}\|_{\infty}\leq\frac{1}{\lambda},\quad\|\mathbf{b}_{5,t}\|_{\infty}\leq\frac{1}{\lambda}," display="inline" intent=":literal"><semantics><mrow><mrow><mrow><mphantom></mphantom><mo>≤</mo><mrow><mn>1</mn><mo>+</mo><msub><mi>δ</mi><mn>1</mn></msub></mrow></mrow><mo rspace="1.167em">,</mo><mrow><msub><mrow><mo stretchy="false">‖</mo><msub><mi>𝐛</mi><mrow><mn>2</mn><mo>,</mo><mi>t</mi></mrow></msub><mo stretchy="false">‖</mo></mrow><mi mathvariant="normal">∞</mi></msub><mo>≤</mo><mrow><mn>1</mn><mo>+</mo><mrow><mi>exp</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mrow><msub><mi>δ</mi><mn>1</mn></msub><mo lspace="0em" rspace="0em">​</mo><msub><mi>m</mi><mn>1</mn></msub></mrow><mo stretchy="false">)</mo></mrow></mrow></mrow></mrow><mo rspace="1.167em">,</mo><mrow><msub><mrow><mo stretchy="false">‖</mo><msub><mi>𝐛</mi><mrow><mn>3</mn><mo>,</mo><mi>t</mi></mrow></msub><mo stretchy="false">‖</mo></mrow><mi mathvariant="normal">∞</mi></msub><mo>≤</mo><mstyle displaystyle="true"><mfrac><mn>1</mn><mi>λ</mi></mfrac></mstyle></mrow><mo rspace="1.167em">,</mo><mrow><msub><mrow><mo stretchy="false">‖</mo><msub><mi>𝐛</mi><mrow><mn>4</mn><mo>,</mo><mi>t</mi></mrow></msub><mo stretchy="false">‖</mo></mrow><mi mathvariant="normal">∞</mi></msub><mo>≤</mo><mstyle displaystyle="true"><mfrac><mn>1</mn><mi>λ</mi></mfrac></mstyle></mrow><mo rspace="1.167em">,</mo><mrow><msub><mrow><mo stretchy="false">‖</mo><msub><mi>𝐛</mi><mrow><mn>5</mn><mo>,</mo><mi>t</mi></mrow></msub><mo stretchy="false">‖</mo></mrow><mi mathvariant="normal">∞</mi></msub><mo>≤</mo><mstyle displaystyle="true"><mfrac><mn>1</mn><mi>λ</mi></mfrac></mstyle></mrow></mrow><mo>,</mo></mrow><annotation encoding="application/x-tex">\displaystyle\leq 1+\delta_{1},\quad\|\mathbf{b}_{2,t}\|_{\infty}\leq 1+\exp(\delta_{1}m_{1}),\quad\|\mathbf{b}_{3,t}\|_{\infty}\leq\frac{1}{\lambda},\quad\|\mathbf{b}_{4,t}\|_{\infty}\leq\frac{1}{\lambda},\quad\|\mathbf{b}_{5,t}\|_{\infty}\leq\frac{1}{\lambda},</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td>
<td rowspan="1" class="ltx_eqn_cell ltx_eqn_eqno ltx_align_middle ltx_align_right"><span class="ltx_tag ltx_tag_equation ltx_align_right">(88)</span></td></tr></tbody>
<tbody id="A5.E89"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_align_right ltx_eqn_cell"><math id="A5.E89.m1" class="ltx_Math" alttext="\displaystyle b_{6,t}" display="inline" intent=":literal"><semantics><msub><mi>b</mi><mrow><mn>6</mn><mo>,</mo><mi>t</mi></mrow></msub><annotation encoding="application/x-tex">\displaystyle b_{6,t}</annotation></semantics></math></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A5.E89.m2" class="ltx_Math" alttext="\displaystyle=\frac{\sqrt{r_{2}}}{\lambda},\quad b_{7,t}=T^{3}\,\mathbb{I}(t\in[\log^{2}T,T-\log^{2}T]),\quad\mathbf{b}_{8,t}=\bm{0}_{N-m_{1}-(r_{2}+2)m_{2}-2}." display="inline" intent=":literal"><semantics><mrow><mrow><mrow><mphantom></mphantom><mo>=</mo><mstyle displaystyle="true"><mfrac><msqrt><msub><mi>r</mi><mn>2</mn></msub></msqrt><mi>λ</mi></mfrac></mstyle></mrow><mo rspace="1.167em">,</mo><mrow><msub><mi>b</mi><mrow><mn>7</mn><mo>,</mo><mi>t</mi></mrow></msub><mo>=</mo><mrow><msup><mi>T</mi><mn>3</mn></msup><mo lspace="0em" rspace="0em">​</mo><mi>𝕀</mi><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mrow><mi>t</mi><mo>∈</mo><mrow><mo stretchy="false">[</mo><mrow><mrow><msup><mi>log</mi><mn>2</mn></msup><mo lspace="0.167em">⁡</mo><mi>T</mi></mrow><mo>,</mo><mrow><mi>T</mi><mo>−</mo><mrow><msup><mi>log</mi><mn>2</mn></msup><mo lspace="0.167em">⁡</mo><mi>T</mi></mrow></mrow></mrow><mo stretchy="false">]</mo></mrow></mrow><mo stretchy="false">)</mo></mrow></mrow></mrow><mo rspace="1.167em">,</mo><mrow><msub><mi>𝐛</mi><mrow><mn>8</mn><mo>,</mo><mi>t</mi></mrow></msub><mo>=</mo><msub><mn>𝟎</mn><mrow><mi>N</mi><mo>−</mo><msub><mi>m</mi><mn>1</mn></msub><mo>−</mo><mrow><mrow><mo stretchy="false">(</mo><mrow><msub><mi>r</mi><mn>2</mn></msub><mo>+</mo><mn>2</mn></mrow><mo stretchy="false">)</mo></mrow><mo lspace="0em" rspace="0em">​</mo><msub><mi>m</mi><mn>2</mn></msub></mrow><mo>−</mo><mn>2</mn></mrow></msub></mrow></mrow><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">\displaystyle=\frac{\sqrt{r_{2}}}{\lambda},\quad b_{7,t}=T^{3}\,\mathbb{I}(t\in[\log^{2}T,T-\log^{2}T]),\quad\mathbf{b}_{8,t}=\bm{0}_{N-m_{1}-(r_{2}+2)m_{2}-2}.</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td>
<td rowspan="1" class="ltx_eqn_cell ltx_eqn_eqno ltx_align_middle ltx_align_right"><span class="ltx_tag ltx_tag_equation ltx_align_right">(89)</span></td></tr></tbody>
</table>
</div>
<div id="A5.SS3.p4" class="ltx_para">
<p id="A5.SS3.p4.1" class="ltx_p"><span id="A5.SS3.p4.1.1" class="ltx_text">We now derive an upper bound for (<a href="#A5.E68" title="In Proof of Lemma . ‣ E.3 Proof of Lemma ‣ Appendix E Construction of the Transformer ‣ Generalization Bounds for Transformer-Based Next-Token Prediction in a Language Model" class="ltx_ref"><span class="ltx_text ltx_ref_tag">68</span></a>). The vector semi-norm <math id="A5.SS3.p4.m1" class="ltx_math_unparsed" alttext="\|\cdot\|_{\infty,m_{1},m_{2}}" display="inline" intent=":literal"><semantics><mrow><mo rspace="0em">∥</mo><mo lspace="0em" rspace="0em">⋅</mo><mo lspace="0em">∥</mo><msub><mrow></mrow><mrow><mi mathvariant="normal">∞</mi><mo>,</mo><msub><mi>m</mi><mn>1</mn></msub><mo>,</mo><msub><mi>m</mi><mn>2</mn></msub></mrow></msub></mrow><annotation encoding="application/x-tex">\|\cdot\|_{\infty,m_{1},m_{2}}</annotation></semantics></math> only depends on the first <math id="A5.SS3.p4.m2" class="ltx_Math" alttext="m_{1}" display="inline" intent=":literal"><semantics><msub><mi>m</mi><mn>1</mn></msub><annotation encoding="application/x-tex">m_{1}</annotation></semantics></math> components and on the last <math id="A5.SS3.p4.m3" class="ltx_Math" alttext="m_{2}" display="inline" intent=":literal"><semantics><msub><mi>m</mi><mn>2</mn></msub><annotation encoding="application/x-tex">m_{2}</annotation></semantics></math> components. By the definitions of <math id="A5.SS3.p4.m4" class="ltx_Math" alttext="\bm{\mu}_{2}" display="inline" intent=":literal"><semantics><msub><mi>𝝁</mi><mn>2</mn></msub><annotation encoding="application/x-tex">\bm{\mu}_{2}</annotation></semantics></math> and <math id="A5.SS3.p4.m5" class="ltx_Math" alttext="\bm{\mu}_{2,0}" display="inline" intent=":literal"><semantics><msub><mi>𝝁</mi><mrow><mn>2</mn><mo>,</mo><mn>0</mn></mrow></msub><annotation encoding="application/x-tex">\bm{\mu}_{2,0}</annotation></semantics></math>, the first <math id="A5.SS3.p4.m6" class="ltx_Math" alttext="m_{1}" display="inline" intent=":literal"><semantics><msub><mi>m</mi><mn>1</mn></msub><annotation encoding="application/x-tex">m_{1}</annotation></semantics></math> components of the last column of <math id="A5.SS3.p4.m7" class="ltx_Math" alttext="\bm{\mu}_{2}" display="inline" intent=":literal"><semantics><msub><mi>𝝁</mi><mn>2</mn></msub><annotation encoding="application/x-tex">\bm{\mu}_{2}</annotation></semantics></math> and the first <math id="A5.SS3.p4.m8" class="ltx_Math" alttext="m_{1}" display="inline" intent=":literal"><semantics><msub><mi>m</mi><mn>1</mn></msub><annotation encoding="application/x-tex">m_{1}</annotation></semantics></math> components of <math id="A5.SS3.p4.m9" class="ltx_Math" alttext="\bm{\mu}_{2,0}" display="inline" intent=":literal"><semantics><msub><mi>𝝁</mi><mrow><mn>2</mn><mo>,</mo><mn>0</mn></mrow></msub><annotation encoding="application/x-tex">\bm{\mu}_{2,0}</annotation></semantics></math> are both <math id="A5.SS3.p4.m10" class="ltx_Math" alttext="\mathbf{x}_{1,T}" display="inline" intent=":literal"><semantics><msub><mi>𝐱</mi><mrow><mn>1</mn><mo>,</mo><mi>T</mi></mrow></msub><annotation encoding="application/x-tex">\mathbf{x}_{1,T}</annotation></semantics></math> such that an error can occur only in the last <math id="A5.SS3.p4.m11" class="ltx_Math" alttext="m_{2}" display="inline" intent=":literal"><semantics><msub><mi>m</mi><mn>2</mn></msub><annotation encoding="application/x-tex">m_{2}</annotation></semantics></math> components. By (<a href="#A5.EGx128" title="Proof of Lemma . ‣ E.3 Proof of Lemma ‣ Appendix E Construction of the Transformer ‣ Generalization Bounds for Transformer-Based Next-Token Prediction in a Language Model" class="ltx_ref"><span class="ltx_text ltx_ref_tag">E.3</span></a>) and the expression for the last <math id="A5.SS3.p4.m12" class="ltx_Math" alttext="m_{s}" display="inline" intent=":literal"><semantics><msub><mi>m</mi><mi>s</mi></msub><annotation encoding="application/x-tex">m_{s}</annotation></semantics></math> components in (<a href="#A5.E54" title="In Lemma 15. ‣ E.1 Construction of multi-head self-attention layers ‣ Appendix E Construction of the Transformer ‣ Generalization Bounds for Transformer-Based Next-Token Prediction in a Language Model" class="ltx_ref"><span class="ltx_text ltx_ref_tag">54</span></a>), we find</span></p>
<table id="A5.EGx132" class="ltx_equationgroup ltx_eqn_align ltx_eqn_table">

<tbody id="A5.Ex319"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_align_right ltx_eqn_cell"><math id="A5.Ex319.m1" class="ltx_Math" alttext="\displaystyle\eqref{tmp_15}=" display="inline" intent=":literal"><semantics><mrow><mrow><mtext>(</mtext><mtext><a href="#A5.E68" title="In Proof of Lemma . ‣ E.3 Proof of Lemma ‣ Appendix E Construction of the Transformer ‣ Generalization Bounds for Transformer-Based Next-Token Prediction in a Language Model" class="ltx_ref"><span class="ltx_text ltx_ref_tag">68</span></a></mtext><mtext>)</mtext></mrow><mo>=</mo><mphantom></mphantom></mrow><annotation encoding="application/x-tex">\displaystyle\eqref{tmp_15}=</annotation></semantics></math></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A5.Ex319.m2" class="ltx_math_unparsed" alttext="\displaystyle\Bigg\|\overline{\sum}_{s\in[T]}\Big(\exp\big(\big\langle\operatorname{stack}(\mathbf{b}_{3,s},\mathbf{b}_{4,s}),\operatorname{stack}(\mathbf{b}_{4,T},\mathbf{b}_{5,T})\big\rangle-b_{6,s}b_{6,T}+\frac{\lambda}{\sqrt{r_{2}}}b_{7,s}b_{6,T}\big)\,;\,\mathbf{b}_{2,s}\Big)" display="inline" intent=":literal"><semantics><mrow><mo mathsize="2.600em" rspace="0.167em">∥</mo><msub><mover accent="true"><mstyle displaystyle="true"><mo movablelimits="false">∑</mo></mstyle><mo stretchy="true">¯</mo></mover><mrow><mi>s</mi><mo>∈</mo><mrow><mo stretchy="false">[</mo><mi>T</mi><mo stretchy="false">]</mo></mrow></mrow></msub><mrow><mo maxsize="1.600em" minsize="1.600em">(</mo><mi>exp</mi><mrow><mo maxsize="1.200em" minsize="1.200em">(</mo><mrow><mo stretchy="false">⟨</mo><mi>stack</mi><mrow><mo stretchy="false">(</mo><msub><mi>𝐛</mi><mrow><mn>3</mn><mo>,</mo><mi>s</mi></mrow></msub><mo>,</mo><msub><mi>𝐛</mi><mrow><mn>4</mn><mo>,</mo><mi>s</mi></mrow></msub><mo stretchy="false">)</mo></mrow><mo>,</mo><mi>stack</mi><mrow><mo stretchy="false">(</mo><msub><mi>𝐛</mi><mrow><mn>4</mn><mo>,</mo><mi>T</mi></mrow></msub><mo>,</mo><msub><mi>𝐛</mi><mrow><mn>5</mn><mo>,</mo><mi>T</mi></mrow></msub><mo stretchy="false">)</mo></mrow><mo stretchy="false">⟩</mo></mrow><mo>−</mo><msub><mi>b</mi><mrow><mn>6</mn><mo>,</mo><mi>s</mi></mrow></msub><msub><mi>b</mi><mrow><mn>6</mn><mo>,</mo><mi>T</mi></mrow></msub><mo>+</mo><mstyle displaystyle="true"><mfrac><mi>λ</mi><msqrt><msub><mi>r</mi><mn>2</mn></msub></msqrt></mfrac></mstyle><msub><mi>b</mi><mrow><mn>7</mn><mo>,</mo><mi>s</mi></mrow></msub><msub><mi>b</mi><mrow><mn>6</mn><mo>,</mo><mi>T</mi></mrow></msub><mo maxsize="1.200em" minsize="1.200em" rspace="0.170em">)</mo></mrow><mo rspace="0.337em">;</mo><msub><mi>𝐛</mi><mrow><mn>2</mn><mo>,</mo><mi>s</mi></mrow></msub><mo maxsize="1.600em" minsize="1.600em">)</mo></mrow></mrow><annotation encoding="application/x-tex">\displaystyle\Bigg\|\overline{\sum}_{s\in[T]}\Big(\exp\big(\big\langle\operatorname{stack}(\mathbf{b}_{3,s},\mathbf{b}_{4,s}),\operatorname{stack}(\mathbf{b}_{4,T},\mathbf{b}_{5,T})\big\rangle-b_{6,s}b_{6,T}+\frac{\lambda}{\sqrt{r_{2}}}b_{7,s}b_{6,T}\big)\,;\,\mathbf{b}_{2,s}\Big)</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
<tbody id="A5.Ex320"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_eqn_cell"></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A5.Ex320.m1" class="ltx_math_unparsed" alttext="\displaystyle\quad-\overline{\sum}_{s\in[\log^{2}T,T-\log^{2}T]}\Big(\exp\big(\big\langle\operatorname{stack}(\mathbf{b}_{3,s},\mathbf{b}_{4,s}),\operatorname{stack}(\mathbf{b}_{4,T},\mathbf{b}_{5,T})\big\rangle-b_{6,s}b_{6,T}+\frac{\lambda}{\sqrt{r_{2}}}b_{7,s}b_{6,T}\big)\,;\,\mathbf{b}_{2,s}\Big)\Bigg\|_{\infty}." display="inline" intent=":literal"><semantics><mrow><mo>−</mo><msub><mover accent="true"><mstyle displaystyle="true"><mo movablelimits="false">∑</mo></mstyle><mo stretchy="true">¯</mo></mover><mrow><mi>s</mi><mo>∈</mo><mrow><mo stretchy="false">[</mo><mrow><mrow><msup><mi>log</mi><mn>2</mn></msup><mo lspace="0.167em">⁡</mo><mi>T</mi></mrow><mo>,</mo><mrow><mi>T</mi><mo>−</mo><mrow><msup><mi>log</mi><mn>2</mn></msup><mo lspace="0.167em">⁡</mo><mi>T</mi></mrow></mrow></mrow><mo stretchy="false">]</mo></mrow></mrow></msub><mrow><mo maxsize="1.600em" minsize="1.600em">(</mo><mi>exp</mi><mrow><mo maxsize="1.200em" minsize="1.200em">(</mo><mrow><mo stretchy="false">⟨</mo><mi>stack</mi><mrow><mo stretchy="false">(</mo><msub><mi>𝐛</mi><mrow><mn>3</mn><mo>,</mo><mi>s</mi></mrow></msub><mo>,</mo><msub><mi>𝐛</mi><mrow><mn>4</mn><mo>,</mo><mi>s</mi></mrow></msub><mo stretchy="false">)</mo></mrow><mo>,</mo><mi>stack</mi><mrow><mo stretchy="false">(</mo><msub><mi>𝐛</mi><mrow><mn>4</mn><mo>,</mo><mi>T</mi></mrow></msub><mo>,</mo><msub><mi>𝐛</mi><mrow><mn>5</mn><mo>,</mo><mi>T</mi></mrow></msub><mo stretchy="false">)</mo></mrow><mo stretchy="false">⟩</mo></mrow><mo>−</mo><msub><mi>b</mi><mrow><mn>6</mn><mo>,</mo><mi>s</mi></mrow></msub><msub><mi>b</mi><mrow><mn>6</mn><mo>,</mo><mi>T</mi></mrow></msub><mo>+</mo><mstyle displaystyle="true"><mfrac><mi>λ</mi><msqrt><msub><mi>r</mi><mn>2</mn></msub></msqrt></mfrac></mstyle><msub><mi>b</mi><mrow><mn>7</mn><mo>,</mo><mi>s</mi></mrow></msub><msub><mi>b</mi><mrow><mn>6</mn><mo>,</mo><mi>T</mi></mrow></msub><mo maxsize="1.200em" minsize="1.200em" rspace="0.170em">)</mo></mrow><mo rspace="0.337em">;</mo><msub><mi>𝐛</mi><mrow><mn>2</mn><mo>,</mo><mi>s</mi></mrow></msub><mo maxsize="1.600em" minsize="1.600em">)</mo></mrow><msub><mo lspace="0em" mathsize="2.600em" rspace="0.0835em">∥</mo><mi mathvariant="normal">∞</mi></msub><mo lspace="0.0835em">.</mo></mrow><annotation encoding="application/x-tex">\displaystyle\quad-\overline{\sum}_{s\in[\log^{2}T,T-\log^{2}T]}\Big(\exp\big(\big\langle\operatorname{stack}(\mathbf{b}_{3,s},\mathbf{b}_{4,s}),\operatorname{stack}(\mathbf{b}_{4,T},\mathbf{b}_{5,T})\big\rangle-b_{6,s}b_{6,T}+\frac{\lambda}{\sqrt{r_{2}}}b_{7,s}b_{6,T}\big)\,;\,\mathbf{b}_{2,s}\Big)\Bigg\|_{\infty}.</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="A5.SS3.p4.2" class="ltx_p"><span id="A5.SS3.p4.2.1" class="ltx_text">By assumption, <math id="A5.SS3.p4.m13" class="ltx_Math" alttext="\lambda\geq T^{-1}," display="inline" intent=":literal"><semantics><mrow><mrow><mi>λ</mi><mo>≥</mo><msup><mi>T</mi><mrow><mo>−</mo><mn>1</mn></mrow></msup></mrow><mo>,</mo></mrow><annotation encoding="application/x-tex">\lambda\geq T^{-1},</annotation></semantics></math> which is equivalent to <math id="A5.SS3.p4.m14" class="ltx_math_unparsed" alttext="-T^{2}\leq-1/\lambda^{2}." display="inline" intent=":literal"><semantics><mrow><mo>−</mo><mi>T</mi><msup><mrow></mrow><mn>2</mn></msup><mo rspace="0em">≤</mo><mo lspace="0em">−</mo><mn>1</mn><mo>/</mo><mi>λ</mi><msup><mrow></mrow><mn>2</mn></msup><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">-T^{2}\leq-1/\lambda^{2}.</annotation></semantics></math> Combining this with (<a href="#A5.E88" title="In Proof of Lemma . ‣ E.3 Proof of Lemma ‣ Appendix E Construction of the Transformer ‣ Generalization Bounds for Transformer-Based Next-Token Prediction in a Language Model" class="ltx_ref"><span class="ltx_text ltx_ref_tag">88</span></a>) and (<a href="#A5.E89" title="In Proof of Lemma . ‣ E.3 Proof of Lemma ‣ Appendix E Construction of the Transformer ‣ Generalization Bounds for Transformer-Based Next-Token Prediction in a Language Model" class="ltx_ref"><span class="ltx_text ltx_ref_tag">89</span></a>), for any <math id="A5.SS3.p4.m15" class="ltx_Math" alttext="t\in[T]," display="inline" intent=":literal"><semantics><mrow><mrow><mi>t</mi><mo>∈</mo><mrow><mo stretchy="false">[</mo><mi>T</mi><mo stretchy="false">]</mo></mrow></mrow><mo>,</mo></mrow><annotation encoding="application/x-tex">t\in[T],</annotation></semantics></math></span></p>
<table id="A5.Ex321" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="A5.Ex321.m1" class="ltx_Math" alttext="-(m_{2}+1)r_{2}T^{2}\leq\frac{-r_{2}m_{2}-r_{2}}{\lambda^{2}}\leq\big\langle\operatorname{stack}(\mathbf{b}_{3,t},\mathbf{b}_{4,t}),\operatorname{stack}(\mathbf{b}_{4,T},\mathbf{b}_{5,T})\big\rangle-b_{6,t}b_{6,T}\leq\frac{r_{2}m_{2}-r_{2}}{\lambda^{2}}\leq(m_{2}-1)r_{2}T^{2}" display="block" intent=":literal"><semantics><mrow><mrow><mo>−</mo><mrow><mrow><mo stretchy="false">(</mo><mrow><msub><mi>m</mi><mn>2</mn></msub><mo>+</mo><mn>1</mn></mrow><mo stretchy="false">)</mo></mrow><mo lspace="0em" rspace="0em">​</mo><msub><mi>r</mi><mn>2</mn></msub><mo lspace="0em" rspace="0em">​</mo><msup><mi>T</mi><mn>2</mn></msup></mrow></mrow><mo>≤</mo><mfrac><mrow><mrow><mo>−</mo><mrow><msub><mi>r</mi><mn>2</mn></msub><mo lspace="0em" rspace="0em">​</mo><msub><mi>m</mi><mn>2</mn></msub></mrow></mrow><mo>−</mo><msub><mi>r</mi><mn>2</mn></msub></mrow><msup><mi>λ</mi><mn>2</mn></msup></mfrac><mo>≤</mo><mrow><mrow><mo stretchy="false">⟨</mo><mrow><mrow><mi>stack</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><msub><mi>𝐛</mi><mrow><mn>3</mn><mo>,</mo><mi>t</mi></mrow></msub><mo>,</mo><msub><mi>𝐛</mi><mrow><mn>4</mn><mo>,</mo><mi>t</mi></mrow></msub><mo stretchy="false">)</mo></mrow></mrow><mo>,</mo><mrow><mi>stack</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><msub><mi>𝐛</mi><mrow><mn>4</mn><mo>,</mo><mi>T</mi></mrow></msub><mo>,</mo><msub><mi>𝐛</mi><mrow><mn>5</mn><mo>,</mo><mi>T</mi></mrow></msub><mo stretchy="false">)</mo></mrow></mrow></mrow><mo stretchy="false">⟩</mo></mrow><mo>−</mo><mrow><msub><mi>b</mi><mrow><mn>6</mn><mo>,</mo><mi>t</mi></mrow></msub><mo lspace="0em" rspace="0em">​</mo><msub><mi>b</mi><mrow><mn>6</mn><mo>,</mo><mi>T</mi></mrow></msub></mrow></mrow><mo>≤</mo><mfrac><mrow><mrow><msub><mi>r</mi><mn>2</mn></msub><mo lspace="0em" rspace="0em">​</mo><msub><mi>m</mi><mn>2</mn></msub></mrow><mo>−</mo><msub><mi>r</mi><mn>2</mn></msub></mrow><msup><mi>λ</mi><mn>2</mn></msup></mfrac><mo>≤</mo><mrow><mrow><mo stretchy="false">(</mo><mrow><msub><mi>m</mi><mn>2</mn></msub><mo>−</mo><mn>1</mn></mrow><mo stretchy="false">)</mo></mrow><mo lspace="0em" rspace="0em">​</mo><msub><mi>r</mi><mn>2</mn></msub><mo lspace="0em" rspace="0em">​</mo><msup><mi>T</mi><mn>2</mn></msup></mrow></mrow><annotation encoding="application/x-tex">-(m_{2}+1)r_{2}T^{2}\leq\frac{-r_{2}m_{2}-r_{2}}{\lambda^{2}}\leq\big\langle\operatorname{stack}(\mathbf{b}_{3,t},\mathbf{b}_{4,t}),\operatorname{stack}(\mathbf{b}_{4,T},\mathbf{b}_{5,T})\big\rangle-b_{6,t}b_{6,T}\leq\frac{r_{2}m_{2}-r_{2}}{\lambda^{2}}\leq(m_{2}-1)r_{2}T^{2}</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="A5.SS3.p4.3" class="ltx_p"><span id="A5.SS3.p4.3.1" class="ltx_text">and <math id="A5.SS3.p4.m16" class="ltx_Math" alttext="\frac{\lambda}{\sqrt{r_{2}}}b_{7,t}b_{6,T}=T^{3}\,\mathbb{I}(t\in[\log^{2}T,T-\log^{2}T])" display="inline" intent=":literal"><semantics><mrow><mrow><mfrac><mi>λ</mi><msqrt><msub><mi>r</mi><mn>2</mn></msub></msqrt></mfrac><mo lspace="0em" rspace="0em">​</mo><msub><mi>b</mi><mrow><mn>7</mn><mo>,</mo><mi>t</mi></mrow></msub><mo lspace="0em" rspace="0em">​</mo><msub><mi>b</mi><mrow><mn>6</mn><mo>,</mo><mi>T</mi></mrow></msub></mrow><mo>=</mo><mrow><msup><mi>T</mi><mn>3</mn></msup><mo lspace="0em" rspace="0em">​</mo><mi>𝕀</mi><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mrow><mi>t</mi><mo>∈</mo><mrow><mo stretchy="false">[</mo><mrow><mrow><msup><mi>log</mi><mn>2</mn></msup><mo lspace="0.167em">⁡</mo><mi>T</mi></mrow><mo>,</mo><mrow><mi>T</mi><mo>−</mo><mrow><msup><mi>log</mi><mn>2</mn></msup><mo lspace="0.167em">⁡</mo><mi>T</mi></mrow></mrow></mrow><mo stretchy="false">]</mo></mrow></mrow><mo stretchy="false">)</mo></mrow></mrow></mrow><annotation encoding="application/x-tex">\frac{\lambda}{\sqrt{r_{2}}}b_{7,t}b_{6,T}=T^{3}\,\mathbb{I}(t\in[\log^{2}T,T-\log^{2}T])</annotation></semantics></math>.
By (<a href="#A5.E88" title="In Proof of Lemma . ‣ E.3 Proof of Lemma ‣ Appendix E Construction of the Transformer ‣ Generalization Bounds for Transformer-Based Next-Token Prediction in a Language Model" class="ltx_ref"><span class="ltx_text ltx_ref_tag">88</span></a>) and (<a href="#A5.E89" title="In Proof of Lemma . ‣ E.3 Proof of Lemma ‣ Appendix E Construction of the Transformer ‣ Generalization Bounds for Transformer-Based Next-Token Prediction in a Language Model" class="ltx_ref"><span class="ltx_text ltx_ref_tag">89</span></a>), we can apply Lemma <a href="#Thmconj227" title="Lemma 27. ‣ E.3 Proof of Lemma ‣ Appendix E Construction of the Transformer ‣ Generalization Bounds for Transformer-Based Next-Token Prediction in a Language Model" class="ltx_ref"><span class="ltx_text ltx_ref_tag">27</span></a> with <math id="A5.SS3.p4.m17" class="ltx_Math" alttext="(\alpha_{-},\alpha_{+},\beta,c)=(-(m_{2}+1)r_{2}T^{2},(m_{2}-1)r_{2}T^{2},1+\exp(\delta_{1}m_{1}),T^{3})" display="inline" intent=":literal"><semantics><mrow><mrow><mo stretchy="false">(</mo><msub><mi>α</mi><mo>−</mo></msub><mo>,</mo><msub><mi>α</mi><mo>+</mo></msub><mo>,</mo><mi>β</mi><mo>,</mo><mi>c</mi><mo stretchy="false">)</mo></mrow><mo>=</mo><mrow><mo stretchy="false">(</mo><mrow><mo>−</mo><mrow><mrow><mo stretchy="false">(</mo><mrow><msub><mi>m</mi><mn>2</mn></msub><mo>+</mo><mn>1</mn></mrow><mo stretchy="false">)</mo></mrow><mo lspace="0em" rspace="0em">​</mo><msub><mi>r</mi><mn>2</mn></msub><mo lspace="0em" rspace="0em">​</mo><msup><mi>T</mi><mn>2</mn></msup></mrow></mrow><mo>,</mo><mrow><mrow><mo stretchy="false">(</mo><mrow><msub><mi>m</mi><mn>2</mn></msub><mo>−</mo><mn>1</mn></mrow><mo stretchy="false">)</mo></mrow><mo lspace="0em" rspace="0em">​</mo><msub><mi>r</mi><mn>2</mn></msub><mo lspace="0em" rspace="0em">​</mo><msup><mi>T</mi><mn>2</mn></msup></mrow><mo>,</mo><mrow><mn>1</mn><mo>+</mo><mrow><mi>exp</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mrow><msub><mi>δ</mi><mn>1</mn></msub><mo lspace="0em" rspace="0em">​</mo><msub><mi>m</mi><mn>1</mn></msub></mrow><mo stretchy="false">)</mo></mrow></mrow></mrow><mo>,</mo><msup><mi>T</mi><mn>3</mn></msup><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">(\alpha_{-},\alpha_{+},\beta,c)=(-(m_{2}+1)r_{2}T^{2},(m_{2}-1)r_{2}T^{2},1+\exp(\delta_{1}m_{1}),T^{3})</annotation></semantics></math>, which yields</span></p>
<table id="A5.EGx133" class="ltx_equationgroup ltx_eqn_align ltx_eqn_table">

<tbody id="A5.E90"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_align_right ltx_eqn_cell"><math id="A5.E90.m1" class="ltx_Math" alttext="\displaystyle\eqref{tmp_15}\leq\frac{8\big(1+\exp(\delta_{1}m_{1})\big)\log^{2}T}{T\exp(T^{3}-2m_{2}r_{2}T^{2})}\lesssim\frac{1}{T}." display="inline" intent=":literal"><semantics><mrow><mrow><mrow><mtext>(</mtext><mtext><a href="#A5.E68" title="In Proof of Lemma . ‣ E.3 Proof of Lemma ‣ Appendix E Construction of the Transformer ‣ Generalization Bounds for Transformer-Based Next-Token Prediction in a Language Model" class="ltx_ref"><span class="ltx_text ltx_ref_tag">68</span></a></mtext><mtext>)</mtext></mrow><mo>≤</mo><mstyle displaystyle="true"><mfrac><mrow><mn>8</mn><mo lspace="0em" rspace="0em">​</mo><mrow><mo maxsize="1.200em" minsize="1.200em">(</mo><mrow><mn>1</mn><mo>+</mo><mrow><mi>exp</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mrow><msub><mi>δ</mi><mn>1</mn></msub><mo lspace="0em" rspace="0em">​</mo><msub><mi>m</mi><mn>1</mn></msub></mrow><mo stretchy="false">)</mo></mrow></mrow></mrow><mo maxsize="1.200em" minsize="1.200em">)</mo></mrow><mo lspace="0.167em" rspace="0em">​</mo><msup><mi>log</mi><mn>2</mn></msup><mo lspace="0.167em" rspace="0em">​</mo><mi>T</mi></mrow><mrow><mi>T</mi><mo lspace="0.167em" rspace="0em">​</mo><mrow><mi>exp</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mrow><msup><mi>T</mi><mn>3</mn></msup><mo>−</mo><mrow><mn>2</mn><mo lspace="0em" rspace="0em">​</mo><msub><mi>m</mi><mn>2</mn></msub><mo lspace="0em" rspace="0em">​</mo><msub><mi>r</mi><mn>2</mn></msub><mo lspace="0em" rspace="0em">​</mo><msup><mi>T</mi><mn>2</mn></msup></mrow></mrow><mo stretchy="false">)</mo></mrow></mrow></mrow></mfrac></mstyle><mo>≲</mo><mstyle displaystyle="true"><mfrac><mn>1</mn><mi>T</mi></mfrac></mstyle></mrow><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">\displaystyle\eqref{tmp_15}\leq\frac{8\big(1+\exp(\delta_{1}m_{1})\big)\log^{2}T}{T\exp(T^{3}-2m_{2}r_{2}T^{2})}\lesssim\frac{1}{T}.</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td>
<td rowspan="1" class="ltx_eqn_cell ltx_eqn_eqno ltx_align_middle ltx_align_right"><span class="ltx_tag ltx_tag_equation ltx_align_right">(90)</span></td></tr></tbody>
</table>
<p id="A5.SS3.p4.4" class="ltx_p"><span id="A5.SS3.p4.4.1" class="ltx_text">To derive now an upper bound of (<a href="#A5.E69" title="In Proof of Lemma . ‣ E.3 Proof of Lemma ‣ Appendix E Construction of the Transformer ‣ Generalization Bounds for Transformer-Based Next-Token Prediction in a Language Model" class="ltx_ref"><span class="ltx_text ltx_ref_tag">69</span></a>), we analyze <math id="A5.SS3.p4.m18" class="ltx_Math" alttext="\bm{\nu}_{1,0}\circ\bm{\mu}_{1}(M)-\bm{\nu}_{1}\circ\bm{\mu}_{1}(M)" display="inline" intent=":literal"><semantics><mrow><mrow><mrow><msub><mi>𝝂</mi><mrow><mn>1</mn><mo>,</mo><mn>0</mn></mrow></msub><mo lspace="0.222em" rspace="0.222em">∘</mo><msub><mi>𝝁</mi><mn>1</mn></msub></mrow><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>M</mi><mo stretchy="false">)</mo></mrow></mrow><mo>−</mo><mrow><mrow><msub><mi>𝝂</mi><mn>1</mn></msub><mo lspace="0.222em" rspace="0.222em">∘</mo><msub><mi>𝝁</mi><mn>1</mn></msub></mrow><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>M</mi><mo stretchy="false">)</mo></mrow></mrow></mrow><annotation encoding="application/x-tex">\bm{\nu}_{1,0}\circ\bm{\mu}_{1}(M)-\bm{\nu}_{1}\circ\bm{\mu}_{1}(M)</annotation></semantics></math>.
Set</span></p>
<table id="A5.Ex322" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="A5.Ex322.m1" class="ltx_Math" alttext="\bm{\nu}_{1,0}\circ\bm{\mu}_{1}(M)\eqcolon\left(\begin{matrix}\tilde{\mathbf{b}}_{1,t}\\
\tilde{\mathbf{b}}_{2,t}\\
\tilde{\mathbf{b}}_{3,t}\\
\tilde{\mathbf{b}}_{4,t}\\
\tilde{\mathbf{b}}_{5,t}\\
\tilde{b}_{6,t}\\
\tilde{b}_{7,t}\\
\tilde{\mathbf{b}}_{8,t}\\
\end{matrix}\right)_{t\in[T]}\begin{array}[]{l}\in\mathbb{R}^{m_{1}}\\
\in\mathbb{R}^{m_{2}}\\
\in\mathbb{R}^{m_{2}}\\
\in\mathbb{R}^{(r_{2}-1)m_{2}}\\
\in\mathbb{R}^{m_{2}}\\
\in\mathbb{R}\\
\in\mathbb{R}\\
\in\mathbb{R}^{N-m_{1}-(r_{2}+2)m_{2}-2}\end{array}." display="block" intent=":literal"><semantics><mrow><mrow><mrow><mrow><msub><mi>𝝂</mi><mrow><mn>1</mn><mo>,</mo><mn>0</mn></mrow></msub><mo lspace="0.222em" rspace="0.222em">∘</mo><msub><mi>𝝁</mi><mn>1</mn></msub></mrow><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>M</mi><mo stretchy="false">)</mo></mrow></mrow><mo>≕</mo><mrow><msub><mrow><mo>(</mo><mtable displaystyle="true" rowspacing="0pt"><mtr><mtd><msub><mover accent="true"><mi>𝐛</mi><mo>~</mo></mover><mrow><mn>1</mn><mo>,</mo><mi>t</mi></mrow></msub></mtd></mtr><mtr><mtd><msub><mover accent="true"><mi>𝐛</mi><mo>~</mo></mover><mrow><mn>2</mn><mo>,</mo><mi>t</mi></mrow></msub></mtd></mtr><mtr><mtd><msub><mover accent="true"><mi>𝐛</mi><mo>~</mo></mover><mrow><mn>3</mn><mo>,</mo><mi>t</mi></mrow></msub></mtd></mtr><mtr><mtd><msub><mover accent="true"><mi>𝐛</mi><mo>~</mo></mover><mrow><mn>4</mn><mo>,</mo><mi>t</mi></mrow></msub></mtd></mtr><mtr><mtd><msub><mover accent="true"><mi>𝐛</mi><mo>~</mo></mover><mrow><mn>5</mn><mo>,</mo><mi>t</mi></mrow></msub></mtd></mtr><mtr><mtd><msub><mover accent="true"><mi>b</mi><mo>~</mo></mover><mrow><mn>6</mn><mo>,</mo><mi>t</mi></mrow></msub></mtd></mtr><mtr><mtd><msub><mover accent="true"><mi>b</mi><mo>~</mo></mover><mrow><mn>7</mn><mo>,</mo><mi>t</mi></mrow></msub></mtd></mtr><mtr><mtd><msub><mover accent="true"><mi>𝐛</mi><mo>~</mo></mover><mrow><mn>8</mn><mo>,</mo><mi>t</mi></mrow></msub></mtd></mtr></mtable><mo>)</mo></mrow><mrow><mi>t</mi><mo>∈</mo><mrow><mo stretchy="false">[</mo><mi>T</mi><mo stretchy="false">]</mo></mrow></mrow></msub><mo lspace="0.167em" rspace="0em">​</mo><mtable displaystyle="true" rowspacing="0pt"><mtr><mtd class="ltx_align_left" columnalign="left"><mrow><mphantom></mphantom><mo>∈</mo><msup><mi>ℝ</mi><msub><mi>m</mi><mn>1</mn></msub></msup></mrow></mtd></mtr><mtr><mtd class="ltx_align_left" columnalign="left"><mrow><mphantom></mphantom><mo>∈</mo><msup><mi>ℝ</mi><msub><mi>m</mi><mn>2</mn></msub></msup></mrow></mtd></mtr><mtr><mtd class="ltx_align_left" columnalign="left"><mrow><mphantom></mphantom><mo>∈</mo><msup><mi>ℝ</mi><msub><mi>m</mi><mn>2</mn></msub></msup></mrow></mtd></mtr><mtr><mtd class="ltx_align_left" columnalign="left"><mrow><mphantom></mphantom><mo>∈</mo><msup><mi>ℝ</mi><mrow><mrow><mo stretchy="false">(</mo><mrow><msub><mi>r</mi><mn>2</mn></msub><mo>−</mo><mn>1</mn></mrow><mo stretchy="false">)</mo></mrow><mo lspace="0em" rspace="0em">​</mo><msub><mi>m</mi><mn>2</mn></msub></mrow></msup></mrow></mtd></mtr><mtr><mtd class="ltx_align_left" columnalign="left"><mrow><mphantom></mphantom><mo>∈</mo><msup><mi>ℝ</mi><msub><mi>m</mi><mn>2</mn></msub></msup></mrow></mtd></mtr><mtr><mtd class="ltx_align_left" columnalign="left"><mrow><mphantom></mphantom><mo>∈</mo><mi>ℝ</mi></mrow></mtd></mtr><mtr><mtd class="ltx_align_left" columnalign="left"><mrow><mphantom></mphantom><mo>∈</mo><mi>ℝ</mi></mrow></mtd></mtr><mtr><mtd class="ltx_align_left" columnalign="left"><mrow><mphantom></mphantom><mo>∈</mo><msup><mi>ℝ</mi><mrow><mi>N</mi><mo>−</mo><msub><mi>m</mi><mn>1</mn></msub><mo>−</mo><mrow><mrow><mo stretchy="false">(</mo><mrow><msub><mi>r</mi><mn>2</mn></msub><mo>+</mo><mn>2</mn></mrow><mo stretchy="false">)</mo></mrow><mo lspace="0em" rspace="0em">​</mo><msub><mi>m</mi><mn>2</mn></msub></mrow><mo>−</mo><mn>2</mn></mrow></msup></mrow></mtd></mtr></mtable></mrow></mrow><mo lspace="0.167em">.</mo></mrow><annotation encoding="application/x-tex">\bm{\nu}_{1,0}\circ\bm{\mu}_{1}(M)\eqcolon\left(\begin{matrix}\tilde{\mathbf{b}}_{1,t}\\
\tilde{\mathbf{b}}_{2,t}\\
\tilde{\mathbf{b}}_{3,t}\\
\tilde{\mathbf{b}}_{4,t}\\
\tilde{\mathbf{b}}_{5,t}\\
\tilde{b}_{6,t}\\
\tilde{b}_{7,t}\\
\tilde{\mathbf{b}}_{8,t}\\
\end{matrix}\right)_{t\in[T]}\begin{array}[]{l}\in\mathbb{R}^{m_{1}}\\
\in\mathbb{R}^{m_{2}}\\
\in\mathbb{R}^{m_{2}}\\
\in\mathbb{R}^{(r_{2}-1)m_{2}}\\
\in\mathbb{R}^{m_{2}}\\
\in\mathbb{R}\\
\in\mathbb{R}\\
\in\mathbb{R}^{N-m_{1}-(r_{2}+2)m_{2}-2}\end{array}.</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="A5.SS3.p4.5" class="ltx_p"><span id="A5.SS3.p4.5.1" class="ltx_text">By (<a href="#A5.E87" title="In Proof of Lemma . ‣ E.3 Proof of Lemma ‣ Appendix E Construction of the Transformer ‣ Generalization Bounds for Transformer-Based Next-Token Prediction in a Language Model" class="ltx_ref"><span class="ltx_text ltx_ref_tag">87</span></a>), every component of <math id="A5.SS3.p4.m19" class="ltx_Math" alttext="\bm{\mu}_{1}(M)" display="inline" intent=":literal"><semantics><mrow><msub><mi>𝝁</mi><mn>1</mn></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>M</mi><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">\bm{\mu}_{1}(M)</annotation></semantics></math> is bounded in absolute value by <math id="A5.SS3.p4.m20" class="ltx_Math" alttext="1" display="inline" intent=":literal"><semantics><mn>1</mn><annotation encoding="application/x-tex">1</annotation></semantics></math>.
By the definition of <math id="A5.SS3.p4.m21" class="ltx_Math" alttext="\bm{\nu}_{1,0}" display="inline" intent=":literal"><semantics><msub><mi>𝝂</mi><mrow><mn>1</mn><mo>,</mo><mn>0</mn></mrow></msub><annotation encoding="application/x-tex">\bm{\nu}_{1,0}</annotation></semantics></math> and the definition of <math id="A5.SS3.p4.m22" class="ltx_Math" alttext="\bm{\nu}_{1}" display="inline" intent=":literal"><semantics><msub><mi>𝝂</mi><mn>1</mn></msub><annotation encoding="application/x-tex">\bm{\nu}_{1}</annotation></semantics></math> in Lemma <a href="#Thmconj224" title="Lemma 24. ‣ E.2 Construction of multilayer perceptron layers ‣ Appendix E Construction of the Transformer ‣ Generalization Bounds for Transformer-Based Next-Token Prediction in a Language Model" class="ltx_ref"><span class="ltx_text ltx_ref_tag">24</span></a>, only the first <math id="A5.SS3.p4.m23" class="ltx_Math" alttext="m_{1}+m_{2}" display="inline" intent=":literal"><semantics><mrow><msub><mi>m</mi><mn>1</mn></msub><mo>+</mo><msub><mi>m</mi><mn>2</mn></msub></mrow><annotation encoding="application/x-tex">m_{1}+m_{2}</annotation></semantics></math> entries are mapped to different values and</span></p>
<table id="A5.Ex323" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="A5.Ex323.m1" class="ltx_Math" alttext="\operatorname{stack}\big(\mathbf{b}_{3,t},\mathbf{b}_{4,t},\mathbf{b}_{5,t},b_{6,t},b_{7,t},\mathbf{b}_{8,t}\big)=\operatorname{stack}\big(\tilde{\mathbf{b}}_{3,t},\tilde{\mathbf{b}}_{4,t},\tilde{\mathbf{b}}_{5,t},\tilde{b}_{6,t},\tilde{b}_{7,t},\tilde{\mathbf{b}}_{8,t}\big)." display="block" intent=":literal"><semantics><mrow><mrow><mrow><mi>stack</mi><mo>⁡</mo><mrow><mo maxsize="1.200em" minsize="1.200em">(</mo><msub><mi>𝐛</mi><mrow><mn>3</mn><mo>,</mo><mi>t</mi></mrow></msub><mo>,</mo><msub><mi>𝐛</mi><mrow><mn>4</mn><mo>,</mo><mi>t</mi></mrow></msub><mo>,</mo><msub><mi>𝐛</mi><mrow><mn>5</mn><mo>,</mo><mi>t</mi></mrow></msub><mo>,</mo><msub><mi>b</mi><mrow><mn>6</mn><mo>,</mo><mi>t</mi></mrow></msub><mo>,</mo><msub><mi>b</mi><mrow><mn>7</mn><mo>,</mo><mi>t</mi></mrow></msub><mo>,</mo><msub><mi>𝐛</mi><mrow><mn>8</mn><mo>,</mo><mi>t</mi></mrow></msub><mo maxsize="1.200em" minsize="1.200em">)</mo></mrow></mrow><mo>=</mo><mrow><mi>stack</mi><mo>⁡</mo><mrow><mo maxsize="1.200em" minsize="1.200em">(</mo><msub><mover accent="true"><mi>𝐛</mi><mo>~</mo></mover><mrow><mn>3</mn><mo>,</mo><mi>t</mi></mrow></msub><mo>,</mo><msub><mover accent="true"><mi>𝐛</mi><mo>~</mo></mover><mrow><mn>4</mn><mo>,</mo><mi>t</mi></mrow></msub><mo>,</mo><msub><mover accent="true"><mi>𝐛</mi><mo>~</mo></mover><mrow><mn>5</mn><mo>,</mo><mi>t</mi></mrow></msub><mo>,</mo><msub><mover accent="true"><mi>b</mi><mo>~</mo></mover><mrow><mn>6</mn><mo>,</mo><mi>t</mi></mrow></msub><mo>,</mo><msub><mover accent="true"><mi>b</mi><mo>~</mo></mover><mrow><mn>7</mn><mo>,</mo><mi>t</mi></mrow></msub><mo>,</mo><msub><mover accent="true"><mi>𝐛</mi><mo>~</mo></mover><mrow><mn>8</mn><mo>,</mo><mi>t</mi></mrow></msub><mo maxsize="1.200em" minsize="1.200em">)</mo></mrow></mrow></mrow><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">\operatorname{stack}\big(\mathbf{b}_{3,t},\mathbf{b}_{4,t},\mathbf{b}_{5,t},b_{6,t},b_{7,t},\mathbf{b}_{8,t}\big)=\operatorname{stack}\big(\tilde{\mathbf{b}}_{3,t},\tilde{\mathbf{b}}_{4,t},\tilde{\mathbf{b}}_{5,t},\tilde{b}_{6,t},\tilde{b}_{7,t},\tilde{\mathbf{b}}_{8,t}\big).</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="A5.SS3.p4.6" class="ltx_p"><span id="A5.SS3.p4.6.1" class="ltx_text">Moreover, Lemma <a href="#Thmconj224" title="Lemma 24. ‣ E.2 Construction of multilayer perceptron layers ‣ Appendix E Construction of the Transformer ‣ Generalization Bounds for Transformer-Based Next-Token Prediction in a Language Model" class="ltx_ref"><span class="ltx_text ltx_ref_tag">24</span></a> yields the bounds</span></p>
<table id="A5.EGx134" class="ltx_equationgroup ltx_eqn_align ltx_eqn_table">

<tbody id="A5.Ex324"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_eqn_cell"></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A5.Ex324.m1" class="ltx_Math" alttext="\displaystyle\|\mathbf{b}_{1,t}-\tilde{\mathbf{b}}_{1,t}\|_{\infty}\vee\|\mathbf{b}_{2,t}-\tilde{\mathbf{b}}_{2,t}\|_{\infty}\lesssim(N_{\mathrm{mlp}})^{-\frac{2\beta_{1}}{m_{1}r_{1}}}." display="inline" intent=":literal"><semantics><mrow><mrow><mrow><msub><mrow><mo stretchy="false">‖</mo><mrow><msub><mi>𝐛</mi><mrow><mn>1</mn><mo>,</mo><mi>t</mi></mrow></msub><mo>−</mo><msub><mover accent="true"><mi>𝐛</mi><mo>~</mo></mover><mrow><mn>1</mn><mo>,</mo><mi>t</mi></mrow></msub></mrow><mo stretchy="false">‖</mo></mrow><mi mathvariant="normal">∞</mi></msub><mo>∨</mo><msub><mrow><mo stretchy="false">‖</mo><mrow><msub><mi>𝐛</mi><mrow><mn>2</mn><mo>,</mo><mi>t</mi></mrow></msub><mo>−</mo><msub><mover accent="true"><mi>𝐛</mi><mo>~</mo></mover><mrow><mn>2</mn><mo>,</mo><mi>t</mi></mrow></msub></mrow><mo stretchy="false">‖</mo></mrow><mi mathvariant="normal">∞</mi></msub></mrow><mo>≲</mo><msup><mrow><mo stretchy="false">(</mo><msub><mi>N</mi><mi>mlp</mi></msub><mo stretchy="false">)</mo></mrow><mrow><mo>−</mo><mfrac><mrow><mn>2</mn><mo lspace="0em" rspace="0em">​</mo><msub><mi>β</mi><mn>1</mn></msub></mrow><mrow><msub><mi>m</mi><mn>1</mn></msub><mo lspace="0em" rspace="0em">​</mo><msub><mi>r</mi><mn>1</mn></msub></mrow></mfrac></mrow></msup></mrow><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">\displaystyle\|\mathbf{b}_{1,t}-\tilde{\mathbf{b}}_{1,t}\|_{\infty}\vee\|\mathbf{b}_{2,t}-\tilde{\mathbf{b}}_{2,t}\|_{\infty}\lesssim(N_{\mathrm{mlp}})^{-\frac{2\beta_{1}}{m_{1}r_{1}}}.</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="A5.SS3.p4.7" class="ltx_p"><span id="A5.SS3.p4.7.1" class="ltx_text">Hence, we get</span></p>
<table id="A5.EGx135" class="ltx_equationgroup ltx_eqn_align ltx_eqn_table">

<tbody id="A5.Ex325"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_align_right ltx_eqn_cell"><span id="A5.Ex325.1.1" class="ltx_text ltx_markedasmath">(<a href="#A5.E69" title="In Proof of Lemma . ‣ E.3 Proof of Lemma ‣ Appendix E Construction of the Transformer ‣ Generalization Bounds for Transformer-Based Next-Token Prediction in a Language Model" class="ltx_ref"><span class="ltx_text ltx_ref_tag">69</span></a>)</span></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A5.Ex325.m2" class="ltx_math_unparsed" alttext="\displaystyle=\left\|\left(\begin{matrix}\mathbf{b}_{1,T}\\
\bullet_{N-m_{1}-m_{2}}\\
\overline{\sum}_{s\in[\log^{2}T,T-\log^{2}T]}\Big(\exp\big(\big\langle\operatorname{stack}(\mathbf{b}_{3,s},\mathbf{b}_{4,s}),\operatorname{stack}(\mathbf{b}_{4,T},\mathbf{b}_{5,T})\big\rangle-b_{6,s}b_{6,T}\big)\,;\,\mathbf{b}_{2,s}\Big)\end{matrix}\right)\right.\quad\," display="inline" intent=":literal"><semantics><mrow><mo>=</mo><mrow><mo>‖</mo><mrow><mo>(</mo><mtable rowspacing="0pt"><mtr><mtd><msub><mi>𝐛</mi><mrow><mn>1</mn><mo>,</mo><mi>T</mi></mrow></msub></mtd></mtr><mtr><mtd><mrow><mo>∙</mo><msub><mrow></mrow><mrow><mi>N</mi><mo>−</mo><msub><mi>m</mi><mn>1</mn></msub><mo>−</mo><msub><mi>m</mi><mn>2</mn></msub></mrow></msub></mrow></mtd></mtr><mtr><mtd><mrow><msub><mover accent="true"><mo>∑</mo><mo stretchy="true">¯</mo></mover><mrow><mi>s</mi><mo>∈</mo><mrow><mo stretchy="false">[</mo><mrow><mrow><msup><mi>log</mi><mn>2</mn></msup><mo lspace="0.167em">⁡</mo><mi>T</mi></mrow><mo>,</mo><mrow><mi>T</mi><mo>−</mo><mrow><msup><mi>log</mi><mn>2</mn></msup><mo lspace="0.167em">⁡</mo><mi>T</mi></mrow></mrow></mrow><mo stretchy="false">]</mo></mrow></mrow></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo maxsize="1.600em" minsize="1.600em">(</mo><mrow><mi>exp</mi><mo>⁡</mo><mrow><mo maxsize="1.200em" minsize="1.200em">(</mo><mrow><mrow><mo stretchy="false">⟨</mo><mrow><mrow><mi>stack</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><msub><mi>𝐛</mi><mrow><mn>3</mn><mo>,</mo><mi>s</mi></mrow></msub><mo>,</mo><msub><mi>𝐛</mi><mrow><mn>4</mn><mo>,</mo><mi>s</mi></mrow></msub><mo stretchy="false">)</mo></mrow></mrow><mo>,</mo><mrow><mi>stack</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><msub><mi>𝐛</mi><mrow><mn>4</mn><mo>,</mo><mi>T</mi></mrow></msub><mo>,</mo><msub><mi>𝐛</mi><mrow><mn>5</mn><mo>,</mo><mi>T</mi></mrow></msub><mo stretchy="false">)</mo></mrow></mrow></mrow><mo stretchy="false">⟩</mo></mrow><mo>−</mo><mrow><msub><mi>b</mi><mrow><mn>6</mn><mo>,</mo><mi>s</mi></mrow></msub><mo lspace="0em" rspace="0em">​</mo><msub><mi>b</mi><mrow><mn>6</mn><mo>,</mo><mi>T</mi></mrow></msub></mrow></mrow><mo maxsize="1.200em" minsize="1.200em" rspace="0.170em">)</mo></mrow></mrow><mo mathsize="1.600em">,</mo><msub><mi>𝐛</mi><mrow><mn>2</mn><mo>,</mo><mi>s</mi></mrow></msub><mo maxsize="1.600em" minsize="1.600em">)</mo></mrow></mrow></mtd></mtr></mtable><mo>)</mo></mrow><mspace style="width:1.17em;" width="1.17em"></mspace></mrow></mrow><annotation encoding="application/x-tex">\displaystyle=\left\|\left(\begin{matrix}\mathbf{b}_{1,T}\\
\bullet_{N-m_{1}-m_{2}}\\
\overline{\sum}_{s\in[\log^{2}T,T-\log^{2}T]}\Big(\exp\big(\big\langle\operatorname{stack}(\mathbf{b}_{3,s},\mathbf{b}_{4,s}),\operatorname{stack}(\mathbf{b}_{4,T},\mathbf{b}_{5,T})\big\rangle-b_{6,s}b_{6,T}\big)\,;\,\mathbf{b}_{2,s}\Big)\end{matrix}\right)\right.\quad\,</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
<tbody id="A5.Ex326"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_eqn_cell"></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A5.Ex326.m1" class="ltx_math_unparsed" alttext="\displaystyle\qquad-\left.\left(\begin{matrix}\tilde{\mathbf{b}}_{1,T}\\
\bullet_{N-m_{1}-m_{2}}\\
\overline{\sum}_{s\in[\log^{2}T,T-\log^{2}T]}\Big(\exp\big(\big\langle\operatorname{stack}(\tilde{\mathbf{b}}_{3,s},\tilde{\mathbf{b}}_{4,s}),\operatorname{stack}(\tilde{\mathbf{b}}_{4,T},\tilde{\mathbf{b}}_{5,T})\big\rangle-\tilde{b}_{6,s}\tilde{b}_{6,T}\big)\,;\,\tilde{\mathbf{b}}_{2,s}\Big)\end{matrix}\right)\right\|_{\infty,m_{1},m_{2}}" display="inline" intent=":literal"><semantics><msub><mrow><mo>−</mo><mrow><mo>(</mo><mtable rowspacing="0pt"><mtr><mtd><msub><mover accent="true"><mi>𝐛</mi><mo>~</mo></mover><mrow><mn>1</mn><mo>,</mo><mi>T</mi></mrow></msub></mtd></mtr><mtr><mtd><mrow><mo>∙</mo><msub><mrow></mrow><mrow><mi>N</mi><mo>−</mo><msub><mi>m</mi><mn>1</mn></msub><mo>−</mo><msub><mi>m</mi><mn>2</mn></msub></mrow></msub></mrow></mtd></mtr><mtr><mtd><mrow><msub><mover accent="true"><mo>∑</mo><mo stretchy="true">¯</mo></mover><mrow><mi>s</mi><mo>∈</mo><mrow><mo stretchy="false">[</mo><mrow><mrow><msup><mi>log</mi><mn>2</mn></msup><mo lspace="0.167em">⁡</mo><mi>T</mi></mrow><mo>,</mo><mrow><mi>T</mi><mo>−</mo><mrow><msup><mi>log</mi><mn>2</mn></msup><mo lspace="0.167em">⁡</mo><mi>T</mi></mrow></mrow></mrow><mo stretchy="false">]</mo></mrow></mrow></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo maxsize="1.600em" minsize="1.600em">(</mo><mrow><mi>exp</mi><mo>⁡</mo><mrow><mo maxsize="1.200em" minsize="1.200em">(</mo><mrow><mrow><mo stretchy="false">⟨</mo><mrow><mrow><mi>stack</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><msub><mover accent="true"><mi>𝐛</mi><mo>~</mo></mover><mrow><mn>3</mn><mo>,</mo><mi>s</mi></mrow></msub><mo>,</mo><msub><mover accent="true"><mi>𝐛</mi><mo>~</mo></mover><mrow><mn>4</mn><mo>,</mo><mi>s</mi></mrow></msub><mo stretchy="false">)</mo></mrow></mrow><mo>,</mo><mrow><mi>stack</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><msub><mover accent="true"><mi>𝐛</mi><mo>~</mo></mover><mrow><mn>4</mn><mo>,</mo><mi>T</mi></mrow></msub><mo>,</mo><msub><mover accent="true"><mi>𝐛</mi><mo>~</mo></mover><mrow><mn>5</mn><mo>,</mo><mi>T</mi></mrow></msub><mo stretchy="false">)</mo></mrow></mrow></mrow><mo stretchy="false">⟩</mo></mrow><mo>−</mo><mrow><msub><mover accent="true"><mi>b</mi><mo>~</mo></mover><mrow><mn>6</mn><mo>,</mo><mi>s</mi></mrow></msub><mo lspace="0em" rspace="0em">​</mo><msub><mover accent="true"><mi>b</mi><mo>~</mo></mover><mrow><mn>6</mn><mo>,</mo><mi>T</mi></mrow></msub></mrow></mrow><mo maxsize="1.200em" minsize="1.200em" rspace="0.170em">)</mo></mrow></mrow><mo mathsize="1.600em">,</mo><msub><mover accent="true"><mi>𝐛</mi><mo>~</mo></mover><mrow><mn>2</mn><mo>,</mo><mi>s</mi></mrow></msub><mo maxsize="1.600em" minsize="1.600em">)</mo></mrow></mrow></mtd></mtr></mtable><mo>)</mo></mrow><mo>‖</mo></mrow><mrow><mi mathvariant="normal">∞</mi><mo>,</mo><msub><mi>m</mi><mn>1</mn></msub><mo>,</mo><msub><mi>m</mi><mn>2</mn></msub></mrow></msub><annotation encoding="application/x-tex">\displaystyle\qquad-\left.\left(\begin{matrix}\tilde{\mathbf{b}}_{1,T}\\
\bullet_{N-m_{1}-m_{2}}\\
\overline{\sum}_{s\in[\log^{2}T,T-\log^{2}T]}\Big(\exp\big(\big\langle\operatorname{stack}(\tilde{\mathbf{b}}_{3,s},\tilde{\mathbf{b}}_{4,s}),\operatorname{stack}(\tilde{\mathbf{b}}_{4,T},\tilde{\mathbf{b}}_{5,T})\big\rangle-\tilde{b}_{6,s}\tilde{b}_{6,T}\big)\,;\,\tilde{\mathbf{b}}_{2,s}\Big)\end{matrix}\right)\right\|_{\infty,m_{1},m_{2}}</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
<tbody id="A5.E91"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_eqn_cell"></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A5.E91.m1" class="ltx_Math" alttext="\displaystyle\lesssim(N_{\mathrm{mlp}})^{-\frac{2\beta_{1}}{m_{1}r_{1}}}." display="inline" intent=":literal"><semantics><mrow><mrow><mphantom></mphantom><mo>≲</mo><msup><mrow><mo stretchy="false">(</mo><msub><mi>N</mi><mi>mlp</mi></msub><mo stretchy="false">)</mo></mrow><mrow><mo>−</mo><mfrac><mrow><mn>2</mn><mo lspace="0em" rspace="0em">​</mo><msub><mi>β</mi><mn>1</mn></msub></mrow><mrow><msub><mi>m</mi><mn>1</mn></msub><mo lspace="0em" rspace="0em">​</mo><msub><mi>r</mi><mn>1</mn></msub></mrow></mfrac></mrow></msup></mrow><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">\displaystyle\lesssim(N_{\mathrm{mlp}})^{-\frac{2\beta_{1}}{m_{1}r_{1}}}.</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td>
<td rowspan="1" class="ltx_eqn_cell ltx_eqn_eqno ltx_align_middle ltx_align_right"><span class="ltx_tag ltx_tag_equation ltx_align_right">(91)</span></td></tr></tbody>
</table>
</div>
<div id="A5.SS3.p5" class="ltx_para">
<p id="A5.SS3.p5.1" class="ltx_p"><span id="A5.SS3.p5.1.1" class="ltx_text">Finally, we derive an upper bound of (<a href="#A5.E70" title="In Proof of Lemma . ‣ E.3 Proof of Lemma ‣ Appendix E Construction of the Transformer ‣ Generalization Bounds for Transformer-Based Next-Token Prediction in a Language Model" class="ltx_ref"><span class="ltx_text ltx_ref_tag">70</span></a>).
For any <math id="A5.SS3.p5.m1" class="ltx_Math" alttext="N\times T" display="inline" intent=":literal"><semantics><mrow><mi>N</mi><mo lspace="0.222em" rspace="0.222em">×</mo><mi>T</mi></mrow><annotation encoding="application/x-tex">N\times T</annotation></semantics></math> matrix of the form</span></p>
<table id="A5.Ex327" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="A5.Ex327.m1" class="ltx_Math" alttext="(\mathbf{x}_{t})_{t\in[T]}\coloneqq\left(\begin{matrix}\mathbf{x}_{1,t}\\
\mathbf{x}_{2,t}\\
\mathbf{x}_{3,t}\\
\mathbf{x}_{4,t}\\
\mathbf{x}_{5,t}\\
\mathbf{x}_{6,t}\\
\bm{0}_{\tfrac{N}{2}-(r_{1}+1)m_{1}-(r_{2}+1)m_{2}}\\
\mathbf{q}_{t}\end{matrix}\right)_{t\in[T]}\begin{array}[]{l}\in[-1,1]^{m_{1}}\\
\in[-1,1]^{m_{2}}\\
\in[-1,1]^{m_{1}}\\
\in[-1,1]^{(r_{1}-1)m_{1}}\\
\in[-1,1]^{m_{2}}\\
\in[-1,1]^{(r_{2}-1)m_{2}}\\
\left.\right.\\
\in[-1,1]^{N/2}\end{array}," display="block" intent=":literal"><semantics><mrow><mrow><msub><mrow><mo stretchy="false">(</mo><msub><mi>𝐱</mi><mi>t</mi></msub><mo stretchy="false">)</mo></mrow><mrow><mi>t</mi><mo>∈</mo><mrow><mo stretchy="false">[</mo><mi>T</mi><mo stretchy="false">]</mo></mrow></mrow></msub><mo>≔</mo><mrow><msub><mrow><mo>(</mo><mtable displaystyle="true" rowspacing="0pt"><mtr><mtd><msub><mi>𝐱</mi><mrow><mn>1</mn><mo>,</mo><mi>t</mi></mrow></msub></mtd></mtr><mtr><mtd><msub><mi>𝐱</mi><mrow><mn>2</mn><mo>,</mo><mi>t</mi></mrow></msub></mtd></mtr><mtr><mtd><msub><mi>𝐱</mi><mrow><mn>3</mn><mo>,</mo><mi>t</mi></mrow></msub></mtd></mtr><mtr><mtd><msub><mi>𝐱</mi><mrow><mn>4</mn><mo>,</mo><mi>t</mi></mrow></msub></mtd></mtr><mtr><mtd><msub><mi>𝐱</mi><mrow><mn>5</mn><mo>,</mo><mi>t</mi></mrow></msub></mtd></mtr><mtr><mtd><msub><mi>𝐱</mi><mrow><mn>6</mn><mo>,</mo><mi>t</mi></mrow></msub></mtd></mtr><mtr><mtd><msub><mn>𝟎</mn><mrow><mstyle scriptlevel="-1"><mfrac><mi>N</mi><mn>2</mn></mfrac></mstyle><mo>−</mo><mrow><mrow><mo stretchy="false">(</mo><mrow><msub><mi>r</mi><mn>1</mn></msub><mo>+</mo><mn>1</mn></mrow><mo stretchy="false">)</mo></mrow><mo lspace="0em" rspace="0em">​</mo><msub><mi>m</mi><mn>1</mn></msub></mrow><mo>−</mo><mrow><mrow><mo stretchy="false">(</mo><mrow><msub><mi>r</mi><mn>2</mn></msub><mo>+</mo><mn>1</mn></mrow><mo stretchy="false">)</mo></mrow><mo lspace="0em" rspace="0em">​</mo><msub><mi>m</mi><mn>2</mn></msub></mrow></mrow></msub></mtd></mtr><mtr><mtd><msub><mi>𝐪</mi><mi>t</mi></msub></mtd></mtr></mtable><mo>)</mo></mrow><mrow><mi>t</mi><mo>∈</mo><mrow><mo stretchy="false">[</mo><mi>T</mi><mo stretchy="false">]</mo></mrow></mrow></msub><mo lspace="0.167em" rspace="0em">​</mo><mtable displaystyle="true" rowspacing="0pt"><mtr><mtd class="ltx_align_left" columnalign="left"><mrow><mphantom></mphantom><mo>∈</mo><msup><mrow><mo stretchy="false">[</mo><mrow><mrow><mo>−</mo><mn>1</mn></mrow><mo>,</mo><mn>1</mn></mrow><mo stretchy="false">]</mo></mrow><msub><mi>m</mi><mn>1</mn></msub></msup></mrow></mtd></mtr><mtr><mtd class="ltx_align_left" columnalign="left"><mrow><mphantom></mphantom><mo>∈</mo><msup><mrow><mo stretchy="false">[</mo><mrow><mrow><mo>−</mo><mn>1</mn></mrow><mo>,</mo><mn>1</mn></mrow><mo stretchy="false">]</mo></mrow><msub><mi>m</mi><mn>2</mn></msub></msup></mrow></mtd></mtr><mtr><mtd class="ltx_align_left" columnalign="left"><mrow><mphantom></mphantom><mo>∈</mo><msup><mrow><mo stretchy="false">[</mo><mrow><mrow><mo>−</mo><mn>1</mn></mrow><mo>,</mo><mn>1</mn></mrow><mo stretchy="false">]</mo></mrow><msub><mi>m</mi><mn>1</mn></msub></msup></mrow></mtd></mtr><mtr><mtd class="ltx_align_left" columnalign="left"><mrow><mphantom></mphantom><mo>∈</mo><msup><mrow><mo stretchy="false">[</mo><mrow><mrow><mo>−</mo><mn>1</mn></mrow><mo>,</mo><mn>1</mn></mrow><mo stretchy="false">]</mo></mrow><mrow><mrow><mo stretchy="false">(</mo><mrow><msub><mi>r</mi><mn>1</mn></msub><mo>−</mo><mn>1</mn></mrow><mo stretchy="false">)</mo></mrow><mo lspace="0em" rspace="0em">​</mo><msub><mi>m</mi><mn>1</mn></msub></mrow></msup></mrow></mtd></mtr><mtr><mtd class="ltx_align_left" columnalign="left"><mrow><mphantom></mphantom><mo>∈</mo><msup><mrow><mo stretchy="false">[</mo><mrow><mrow><mo>−</mo><mn>1</mn></mrow><mo>,</mo><mn>1</mn></mrow><mo stretchy="false">]</mo></mrow><msub><mi>m</mi><mn>2</mn></msub></msup></mrow></mtd></mtr><mtr><mtd class="ltx_align_left" columnalign="left"><mrow><mphantom></mphantom><mo>∈</mo><msup><mrow><mo stretchy="false">[</mo><mrow><mrow><mo>−</mo><mn>1</mn></mrow><mo>,</mo><mn>1</mn></mrow><mo stretchy="false">]</mo></mrow><mrow><mrow><mo stretchy="false">(</mo><mrow><msub><mi>r</mi><mn>2</mn></msub><mo>−</mo><mn>1</mn></mrow><mo stretchy="false">)</mo></mrow><mo lspace="0em" rspace="0em">​</mo><msub><mi>m</mi><mn>2</mn></msub></mrow></msup></mrow></mtd></mtr><mtr><mtd class="ltx_align_left" columnalign="left"><mphantom></mphantom></mtd></mtr><mtr><mtd class="ltx_align_left" columnalign="left"><mrow><mphantom></mphantom><mo>∈</mo><msup><mrow><mo stretchy="false">[</mo><mrow><mrow><mo>−</mo><mn>1</mn></mrow><mo>,</mo><mn>1</mn></mrow><mo stretchy="false">]</mo></mrow><mrow><mi>N</mi><mo>/</mo><mn>2</mn></mrow></msup></mrow></mtd></mtr></mtable></mrow></mrow><mo lspace="0.167em">,</mo></mrow><annotation encoding="application/x-tex">(\mathbf{x}_{t})_{t\in[T]}\coloneqq\left(\begin{matrix}\mathbf{x}_{1,t}\\
\mathbf{x}_{2,t}\\
\mathbf{x}_{3,t}\\
\mathbf{x}_{4,t}\\
\mathbf{x}_{5,t}\\
\mathbf{x}_{6,t}\\
\bm{0}_{\tfrac{N}{2}-(r_{1}+1)m_{1}-(r_{2}+1)m_{2}}\\
\mathbf{q}_{t}\end{matrix}\right)_{t\in[T]}\begin{array}[]{l}\in[-1,1]^{m_{1}}\\
\in[-1,1]^{m_{2}}\\
\in[-1,1]^{m_{1}}\\
\in[-1,1]^{(r_{1}-1)m_{1}}\\
\in[-1,1]^{m_{2}}\\
\in[-1,1]^{(r_{2}-1)m_{2}}\\
\left.\right.\\
\in[-1,1]^{N/2}\end{array},</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="A5.SS3.p5.2" class="ltx_p"><span id="A5.SS3.p5.2.1" class="ltx_text">recall that</span></p>
<table id="A5.Ex328" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="A5.Ex328.m1" class="ltx_Math" alttext="\bm{\nu}_{1,0}\big((\mathbf{x}_{t})_{t\in[T]}\big)=\left(\begin{matrix}\mathbf{g}_{0}(\mathbf{x}_{4,t},\mathbf{x}_{1,t})\\
\exp\big(-\mathbf{x}_{1,t}^{\top}\mathbf{g}_{0}(\mathbf{x}_{3,t},\mathbf{x}_{4,t})\big)\mathbf{x}_{2,t}\\
\frac{1}{\lambda}\mathbf{x}_{5,t}\\
\frac{1}{\lambda}\mathbf{x}_{6,t}\\
\frac{1}{\lambda}\mathbf{x}_{2,t}\\
\frac{\sqrt{r_{2}}}{\lambda}\\
T^{3}\,\mathbb{I}(t\in[\log^{2}T,T-\log^{2}T])\\
\bm{0}_{N-m_{1}-(r_{2}+2)m_{2}-2}\end{matrix}\right)_{t\in[T]}\begin{array}[]{l}\in\mathbb{R}^{m_{1}}\\
\in\mathbb{R}^{m_{2}}\\
\in\mathbb{R}^{m_{2}}\\
