<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A5.Ex250.m1" class="ltx_Math" alttext="\displaystyle\lesssim M^{2}2^{-M}." display="inline" intent=":literal"><semantics><mrow><mrow><mphantom></mphantom><mo>≲</mo><mrow><msup><mi>M</mi><mn>2</mn></msup><mo lspace="0em" rspace="0em">​</mo><msup><mn>2</mn><mrow><mo>−</mo><mi>M</mi></mrow></msup></mrow></mrow><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">\displaystyle\lesssim M^{2}2^{-M}.</annotation></semantics></math></td>
