<tbody id="A5.E57"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_align_right ltx_eqn_cell"><math id="A5.E57.m1" class="ltx_Math" alttext="\displaystyle\big\|\bm{\Phi}_{1}(\mathbf{x}_{4},\mathbf{x}_{1})-\mathbf{g}_{0}(\mathbf{x}_{4},\mathbf{x}_{1})\big\|_{\infty}\lesssim(N_{\mathrm{mlp}})^{-\frac{2\beta_{1}}{m_{1}r_{1}}}," display="inline" intent=":literal"><semantics><mrow><mrow><msub><mrow><mo maxsize="1.200em" minsize="1.200em" stretchy="true">‖</mo><mrow><mrow><msub><mi>𝚽</mi><mn>1</mn></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mi>𝐱</mi><mn>4</mn></msub><mo>,</mo><msub><mi>𝐱</mi><mn>1</mn></msub><mo stretchy="false">)</mo></mrow></mrow><mo>−</mo><mrow><msub><mi>𝐠</mi><mn>0</mn></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mi>𝐱</mi><mn>4</mn></msub><mo>,</mo><msub><mi>𝐱</mi><mn>1</mn></msub><mo stretchy="false">)</mo></mrow></mrow></mrow><mo maxsize="1.200em" minsize="1.200em" stretchy="true">‖</mo></mrow><mi mathvariant="normal">∞</mi></msub><mo>≲</mo><msup><mrow><mo stretchy="false">(</mo><msub><mi>N</mi><mi>mlp</mi></msub><mo stretchy="false">)</mo></mrow><mrow><mo>−</mo><mfrac><mrow><mn>2</mn><mo lspace="0em" rspace="0em">​</mo><msub><mi>β</mi><mn>1</mn></msub></mrow><mrow><msub><mi>m</mi><mn>1</mn></msub><mo lspace="0em" rspace="0em">​</mo><msub><mi>r</mi><mn>1</mn></msub></mrow></mfrac></mrow></msup></mrow><mo>,</mo></mrow><annotation encoding="application/x-tex">\displaystyle\big\|\bm{\Phi}_{1}(\mathbf{x}_{4},\mathbf{x}_{1})-\mathbf{g}_{0}(\mathbf{x}_{4},\mathbf{x}_{1})\big\|_{\infty}\lesssim(N_{\mathrm{mlp}})^{-\frac{2\beta_{1}}{m_{1}r_{1}}},</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td>
<td rowspan="1" class="ltx_eqn_cell ltx_eqn_eqno ltx_align_middle ltx_align_right"><span class="ltx_tag ltx_tag_equation ltx_align_right">(57)</span></td></tr></tbody>
</table>
<p id="A5.SS2.p13.2" class="ltx_p"><span id="A5.SS2.p13.2.1" class="ltx_text">and</span></p>
<table id="A5.Ex282" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="A5.Ex282.m1" class="ltx_Math" alttext="\big\|\bm{\Phi}_{2,1}(\mathbf{x}_{3},\mathbf{x}_{4})-\mathbf{g}_{0}(\mathbf{x}_{3},\mathbf{x}_{4})\big\|_{\infty}\lesssim(N_{\mathrm{mlp}})^{-\frac{2\beta_{1}}{m_{1}r_{1}}}." display="block" intent=":literal"><semantics><mrow><mrow><msub><mrow><mo maxsize="1.200em" minsize="1.200em" stretchy="true">‖</mo><mrow><mrow><msub><mi>𝚽</mi><mrow><mn>2</mn><mo>,</mo><mn>1</mn></mrow></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mi>𝐱</mi><mn>3</mn></msub><mo>,</mo><msub><mi>𝐱</mi><mn>4</mn></msub><mo stretchy="false">)</mo></mrow></mrow><mo>−</mo><mrow><msub><mi>𝐠</mi><mn>0</mn></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mi>𝐱</mi><mn>3</mn></msub><mo>,</mo><msub><mi>𝐱</mi><mn>4</mn></msub><mo stretchy="false">)</mo></mrow></mrow></mrow><mo maxsize="1.200em" minsize="1.200em" stretchy="true">‖</mo></mrow><mi mathvariant="normal">∞</mi></msub><mo>≲</mo><msup><mrow><mo stretchy="false">(</mo><msub><mi>N</mi><mi>mlp</mi></msub><mo stretchy="false">)</mo></mrow><mrow><mo>−</mo><mfrac><mrow><mn>2</mn><mo lspace="0em" rspace="0em">​</mo><msub><mi>β</mi><mn>1</mn></msub></mrow><mrow><msub><mi>m</mi><mn>1</mn></msub><mo lspace="0em" rspace="0em">​</mo><msub><mi>r</mi><mn>1</mn></msub></mrow></mfrac></mrow></msup></mrow><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">\big\|\bm{\Phi}_{2,1}(\mathbf{x}_{3},\mathbf{x}_{4})-\mathbf{g}_{0}(\mathbf{x}_{3},\mathbf{x}_{4})\big\|_{\infty}\lesssim(N_{\mathrm{mlp}})^{-\frac{2\beta_{1}}{m_{1}r_{1}}}.</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="A5.SS2.p13.3" class="ltx_p"><span id="A5.SS2.p13.3.1" class="ltx_text">Since <math id="A5.SS2.p13.m6" class="ltx_Math" alttext="\|\mathbf{g}_{0}(\mathbf{x}_{3},\mathbf{x}_{4})\|_{\infty}\leq\delta_{1}" display="inline" intent=":literal"><semantics><mrow><msub><mrow><mo stretchy="false">‖</mo><mrow><msub><mi>𝐠</mi><mn>0</mn></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mi>𝐱</mi><mn>3</mn></msub><mo>,</mo><msub><mi>𝐱</mi><mn>4</mn></msub><mo stretchy="false">)</mo></mrow></mrow><mo stretchy="false">‖</mo></mrow><mi mathvariant="normal">∞</mi></msub><mo>≤</mo><msub><mi>δ</mi><mn>1</mn></msub></mrow><annotation encoding="application/x-tex">\|\mathbf{g}_{0}(\mathbf{x}_{3},\mathbf{x}_{4})\|_{\infty}\leq\delta_{1}</annotation></semantics></math>, we have
<math id="A5.SS2.p13.m7" class="ltx_Math" alttext="\|\bm{\Phi}_{2,1}(\mathbf{x}_{3},\mathbf{x}_{4})\|_{\infty}\leq c_{1}\coloneq 1+\delta_{1}" display="inline" intent=":literal"><semantics><mrow><msub><mrow><mo stretchy="false">‖</mo><mrow><msub><mi>𝚽</mi><mrow><mn>2</mn><mo>,</mo><mn>1</mn></mrow></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mi>𝐱</mi><mn>3</mn></msub><mo>,</mo><msub><mi>𝐱</mi><mn>4</mn></msub><mo stretchy="false">)</mo></mrow></mrow><mo stretchy="false">‖</mo></mrow><mi mathvariant="normal">∞</mi></msub><mo>≤</mo><msub><mi>c</mi><mn>1</mn></msub><mo>≔</mo><mrow><mn>1</mn><mo>+</mo><msub><mi>δ</mi><mn>1</mn></msub></mrow></mrow><annotation encoding="application/x-tex">\|\bm{\Phi}_{2,1}(\mathbf{x}_{3},\mathbf{x}_{4})\|_{\infty}\leq c_{1}\coloneq 1+\delta_{1}</annotation></semantics></math>.
By applying Lemma <a href="#Thmconj216" title="Lemma 16. ‣ E.2 Construction of multilayer perceptron layers ‣ Appendix E Construction of the Transformer ‣ Generalization Bounds for Transformer-Based Next-Token Prediction in a Language Model" class="ltx_ref"><span class="ltx_text ltx_ref_tag">16</span></a> <math id="A5.SS2.p13.m8" class="ltx_Math" alttext="m_{1}" display="inline" intent=":literal"><semantics><msub><mi>m</mi><mn>1</mn></msub><annotation encoding="application/x-tex">m_{1}</annotation></semantics></math>-times and summing the results, we construct <math id="A5.SS2.p13.m9" class="ltx_Math" alttext="\bm{\Phi}_{2,2}\in\mathcal{MLP}(2m_{1},1,\lceil\log_{2}N_{\mathrm{mlp}}\rceil^{2},7m_{1},B)" display="inline" intent=":literal"><semantics><mrow><msub><mi>𝚽</mi><mrow><mn>2</mn><mo>,</mo><mn>2</mn></mrow></msub><mo>∈</mo><mrow><mi class="ltx_font_mathcaligraphic">ℳ</mi><mo lspace="0em" rspace="0em">​</mo><mi class="ltx_font_mathcaligraphic">ℒ</mi><mo lspace="0em" rspace="0em">​</mo><mi class="ltx_font_mathcaligraphic">𝒫</mi><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mrow><mn>2</mn><mo lspace="0em" rspace="0em">​</mo><msub><mi>m</mi><mn>1</mn></msub></mrow><mo>,</mo><mn>1</mn><mo>,</mo><msup><mrow><mo stretchy="false">⌈</mo><mrow><msub><mi>log</mi><mn>2</mn></msub><mo lspace="0.167em">⁡</mo><msub><mi>N</mi><mi>mlp</mi></msub></mrow><mo stretchy="false">⌉</mo></mrow><mn>2</mn></msup><mo>,</mo><mrow><mn>7</mn><mo lspace="0em" rspace="0em">​</mo><msub><mi>m</mi><mn>1</mn></msub></mrow><mo>,</mo><mi>B</mi><mo stretchy="false">)</mo></mrow></mrow></mrow><annotation encoding="application/x-tex">\bm{\Phi}_{2,2}\in\mathcal{MLP}(2m_{1},1,\lceil\log_{2}N_{\mathrm{mlp}}\rceil^{2},7m_{1},B)</annotation></semantics></math> such that for any <math id="A5.SS2.p13.m10" class="ltx_Math" alttext="\mathbf{x}_{1}\in[-1,1]^{m_{1}}" display="inline" intent=":literal"><semantics><mrow><msub><mi>𝐱</mi><mn>1</mn></msub><mo>∈</mo><msup><mrow><mo stretchy="false">[</mo><mrow><mrow><mo>−</mo><mn>1</mn></mrow><mo>,</mo><mn>1</mn></mrow><mo stretchy="false">]</mo></mrow><msub><mi>m</mi><mn>1</mn></msub></msup></mrow><annotation encoding="application/x-tex">\mathbf{x}_{1}\in[-1,1]^{m_{1}}</annotation></semantics></math> and <math id="A5.SS2.p13.m11" class="ltx_Math" alttext="\mathbf{y}\in[-c_{1},c_{1}]^{m_{1}}" display="inline" intent=":literal"><semantics><mrow><mi>𝐲</mi><mo>∈</mo><msup><mrow><mo stretchy="false">[</mo><mrow><mrow><mo>−</mo><msub><mi>c</mi><mn>1</mn></msub></mrow><mo>,</mo><msub><mi>c</mi><mn>1</mn></msub></mrow><mo stretchy="false">]</mo></mrow><msub><mi>m</mi><mn>1</mn></msub></msup></mrow><annotation encoding="application/x-tex">\mathbf{y}\in[-c_{1},c_{1}]^{m_{1}}</annotation></semantics></math>,</span></p>
<table id="A5.Ex283" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="A5.Ex283.m1" class="ltx_Math" alttext="\big|\bm{\Phi}_{2,2}(\mathbf{x}_{1},\mathbf{y})-\mathbf{x}_{1}^{\top}\mathbf{y}\big|\lesssim(N_{\mathrm{mlp}})^{-\log_{2}N_{\mathrm{mlp}}}." display="block" intent=":literal"><semantics><mrow><mrow><mrow><mo maxsize="1.200em" minsize="1.200em" stretchy="true">|</mo><mrow><mrow><msub><mi>𝚽</mi><mrow><mn>2</mn><mo>,</mo><mn>2</mn></mrow></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mi>𝐱</mi><mn>1</mn></msub><mo>,</mo><mi>𝐲</mi><mo stretchy="false">)</mo></mrow></mrow><mo>−</mo><mrow><msubsup><mi>𝐱</mi><mn>1</mn><mo>⊤</mo></msubsup><mo lspace="0em" rspace="0em">​</mo><mi>𝐲</mi></mrow></mrow><mo maxsize="1.200em" minsize="1.200em" stretchy="true">|</mo></mrow><mo>≲</mo><msup><mrow><mo stretchy="false">(</mo><msub><mi>N</mi><mi>mlp</mi></msub><mo stretchy="false">)</mo></mrow><mrow><mo rspace="0.167em">−</mo><mrow><msub><mi>log</mi><mn>2</mn></msub><mo lspace="0.167em">⁡</mo><msub><mi>N</mi><mi>mlp</mi></msub></mrow></mrow></msup></mrow><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">\big|\bm{\Phi}_{2,2}(\mathbf{x}_{1},\mathbf{y})-\mathbf{x}_{1}^{\top}\mathbf{y}\big|\lesssim(N_{\mathrm{mlp}})^{-\log_{2}N_{\mathrm{mlp}}}.</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="A5.SS2.p13.4" class="ltx_p"><span id="A5.SS2.p13.4.1" class="ltx_text">From <math id="A5.SS2.p13.m12" class="ltx_Math" alttext="|\mathbf{x}_{1}^{\top}\mathbf{y}|\leq m_{1}c_{1}" display="inline" intent=":literal"><semantics><mrow><mrow><mo stretchy="false">|</mo><mrow><msubsup><mi>𝐱</mi><mn>1</mn><mo>⊤</mo></msubsup><mo lspace="0em" rspace="0em">​</mo><mi>𝐲</mi></mrow><mo stretchy="false">|</mo></mrow><mo>≤</mo><mrow><msub><mi>m</mi><mn>1</mn></msub><mo lspace="0em" rspace="0em">​</mo><msub><mi>c</mi><mn>1</mn></msub></mrow></mrow><annotation encoding="application/x-tex">|\mathbf{x}_{1}^{\top}\mathbf{y}|\leq m_{1}c_{1}</annotation></semantics></math>,
we have <math id="A5.SS2.p13.m13" class="ltx_Math" alttext="|\bm{\Phi}_{2,2}\big(\mathbf{x}_{1},\bm{\Phi}_{2,1}(\mathbf{x}_{3},\mathbf{x}_{4})\big)|\leq c_{2}\coloneq 1+m_{1}c_{1}" display="inline" intent=":literal"><semantics><mrow><mrow><mo stretchy="false">|</mo><mrow><msub><mi>𝚽</mi><mrow><mn>2</mn><mo>,</mo><mn>2</mn></mrow></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo maxsize="1.200em" minsize="1.200em">(</mo><msub><mi>𝐱</mi><mn>1</mn></msub><mo>,</mo><mrow><msub><mi>𝚽</mi><mrow><mn>2</mn><mo>,</mo><mn>1</mn></mrow></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mi>𝐱</mi><mn>3</mn></msub><mo>,</mo><msub><mi>𝐱</mi><mn>4</mn></msub><mo stretchy="false">)</mo></mrow></mrow><mo maxsize="1.200em" minsize="1.200em">)</mo></mrow></mrow><mo stretchy="false">|</mo></mrow><mo>≤</mo><msub><mi>c</mi><mn>2</mn></msub><mo>≔</mo><mrow><mn>1</mn><mo>+</mo><mrow><msub><mi>m</mi><mn>1</mn></msub><mo lspace="0em" rspace="0em">​</mo><msub><mi>c</mi><mn>1</mn></msub></mrow></mrow></mrow><annotation encoding="application/x-tex">|\bm{\Phi}_{2,2}\big(\mathbf{x}_{1},\bm{\Phi}_{2,1}(\mathbf{x}_{3},\mathbf{x}_{4})\big)|\leq c_{2}\coloneq 1+m_{1}c_{1}</annotation></semantics></math>.
By applying Lemma <a href="#Thmconj220" title="Lemma 20. ‣ E.2 Construction of multilayer perceptron layers ‣ Appendix E Construction of the Transformer ‣ Generalization Bounds for Transformer-Based Next-Token Prediction in a Language Model" class="ltx_ref"><span class="ltx_text ltx_ref_tag">20</span></a>,
we construct
<math id="A5.SS2.p13.m14" class="ltx_Math" alttext="\bm{\Phi}_{2,3}\in\mathcal{MLP}(1,1,\lceil 2\log_{2}N_{\mathrm{mlp}}\rceil^{2},33\lceil 2\log_{2}N_{\mathrm{mlp}}\rceil^{2},B)" display="inline" intent=":literal"><semantics><mrow><msub><mi>𝚽</mi><mrow><mn>2</mn><mo>,</mo><mn>3</mn></mrow></msub><mo>∈</mo><mrow><mi class="ltx_font_mathcaligraphic">ℳ</mi><mo lspace="0em" rspace="0em">​</mo><mi class="ltx_font_mathcaligraphic">ℒ</mi><mo lspace="0em" rspace="0em">​</mo><mi class="ltx_font_mathcaligraphic">𝒫</mi><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mn>1</mn><mo>,</mo><mn>1</mn><mo>,</mo><msup><mrow><mo stretchy="false">⌈</mo><mrow><mn>2</mn><mo lspace="0.167em" rspace="0em">​</mo><msub><mi>log</mi><mn>2</mn></msub><mo lspace="0.167em" rspace="0em">​</mo><msub><mi>N</mi><mi>mlp</mi></msub></mrow><mo stretchy="false">⌉</mo></mrow><mn>2</mn></msup><mo>,</mo><mrow><mn>33</mn><mo lspace="0em" rspace="0em">​</mo><msup><mrow><mo stretchy="false">⌈</mo><mrow><mn>2</mn><mo lspace="0.167em" rspace="0em">​</mo><msub><mi>log</mi><mn>2</mn></msub><mo lspace="0.167em" rspace="0em">​</mo><msub><mi>N</mi><mi>mlp</mi></msub></mrow><mo stretchy="false">⌉</mo></mrow><mn>2</mn></msup></mrow><mo>,</mo><mi>B</mi><mo stretchy="false">)</mo></mrow></mrow></mrow><annotation encoding="application/x-tex">\bm{\Phi}_{2,3}\in\mathcal{MLP}(1,1,\lceil 2\log_{2}N_{\mathrm{mlp}}\rceil^{2},33\lceil 2\log_{2}N_{\mathrm{mlp}}\rceil^{2},B)</annotation></semantics></math>
such that for any <math id="A5.SS2.p13.m15" class="ltx_Math" alttext="y\in[-c_{2},c_{2}]" display="inline" intent=":literal"><semantics><mrow><mi>y</mi><mo>∈</mo><mrow><mo stretchy="false">[</mo><mrow><mrow><mo>−</mo><msub><mi>c</mi><mn>2</mn></msub></mrow><mo>,</mo><msub><mi>c</mi><mn>2</mn></msub></mrow><mo stretchy="false">]</mo></mrow></mrow><annotation encoding="application/x-tex">y\in[-c_{2},c_{2}]</annotation></semantics></math>,</span></p>
<table id="A5.Ex284" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="A5.Ex284.m1" class="ltx_Math" alttext="\Big|\bm{\Phi}_{2,3}(y)-\exp(-y)\Big|\lesssim\lceil 2\log_{2}N_{\mathrm{mlp}}\rceil^{4}2^{-\lceil 2\log_{2}N_{\mathrm{mlp}}\rceil^{2}}\lesssim\lceil 2\log_{2}N_{\mathrm{mlp}}\rceil^{4}(N_{\mathrm{mlp}})^{-4\log_{2}N_{\mathrm{mlp}}}\lesssim(N_{\mathrm{mlp}})^{-\log_{2}N_{\mathrm{mlp}}}." display="block" intent=":literal"><semantics><mrow><mrow><mrow><mo maxsize="1.600em" minsize="1.600em" stretchy="true">|</mo><mrow><mrow><msub><mi>𝚽</mi><mrow><mn>2</mn><mo>,</mo><mn>3</mn></mrow></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>y</mi><mo stretchy="false">)</mo></mrow></mrow><mo>−</mo><mrow><mi>exp</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mrow><mo>−</mo><mi>y</mi></mrow><mo stretchy="false">)</mo></mrow></mrow></mrow><mo maxsize="1.600em" minsize="1.600em" stretchy="true">|</mo></mrow><mo>≲</mo><mrow><msup><mrow><mo stretchy="false">⌈</mo><mrow><mn>2</mn><mo lspace="0.167em" rspace="0em">​</mo><msub><mi>log</mi><mn>2</mn></msub><mo lspace="0.167em" rspace="0em">​</mo><msub><mi>N</mi><mi>mlp</mi></msub></mrow><mo stretchy="false">⌉</mo></mrow><mn>4</mn></msup><mo lspace="0em" rspace="0em">​</mo><msup><mn>2</mn><mrow><mo>−</mo><msup><mrow><mo stretchy="false">⌈</mo><mrow><mn>2</mn><mo lspace="0.167em" rspace="0em">​</mo><msub><mi>log</mi><mn>2</mn></msub><mo lspace="0.167em" rspace="0em">​</mo><msub><mi>N</mi><mi>mlp</mi></msub></mrow><mo stretchy="false">⌉</mo></mrow><mn>2</mn></msup></mrow></msup></mrow><mo>≲</mo><mrow><msup><mrow><mo stretchy="false">⌈</mo><mrow><mn>2</mn><mo lspace="0.167em" rspace="0em">​</mo><msub><mi>log</mi><mn>2</mn></msub><mo lspace="0.167em" rspace="0em">​</mo><msub><mi>N</mi><mi>mlp</mi></msub></mrow><mo stretchy="false">⌉</mo></mrow><mn>4</mn></msup><mo lspace="0em" rspace="0em">​</mo><msup><mrow><mo stretchy="false">(</mo><msub><mi>N</mi><mi>mlp</mi></msub><mo stretchy="false">)</mo></mrow><mrow><mo>−</mo><mrow><mn>4</mn><mo lspace="0.167em" rspace="0em">​</mo><msub><mi>log</mi><mn>2</mn></msub><mo lspace="0.167em" rspace="0em">​</mo><msub><mi>N</mi><mi>mlp</mi></msub></mrow></mrow></msup></mrow><mo>≲</mo><msup><mrow><mo stretchy="false">(</mo><msub><mi>N</mi><mi>mlp</mi></msub><mo stretchy="false">)</mo></mrow><mrow><mo rspace="0.167em">−</mo><mrow><msub><mi>log</mi><mn>2</mn></msub><mo lspace="0.167em">⁡</mo><msub><mi>N</mi><mi>mlp</mi></msub></mrow></mrow></msup></mrow><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">\Big|\bm{\Phi}_{2,3}(y)-\exp(-y)\Big|\lesssim\lceil 2\log_{2}N_{\mathrm{mlp}}\rceil^{4}2^{-\lceil 2\log_{2}N_{\mathrm{mlp}}\rceil^{2}}\lesssim\lceil 2\log_{2}N_{\mathrm{mlp}}\rceil^{4}(N_{\mathrm{mlp}})^{-4\log_{2}N_{\mathrm{mlp}}}\lesssim(N_{\mathrm{mlp}})^{-\log_{2}N_{\mathrm{mlp}}}.</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="A5.SS2.p13.5" class="ltx_p"><span id="A5.SS2.p13.5.1" class="ltx_text">We have <math id="A5.SS2.p13.m16" class="ltx_Math" alttext="|\bm{\Phi}_{2,3}\circ\bm{\Phi}_{2,2}\big(\mathbf{x}_{1},\bm{\Phi}_{2,1}(\mathbf{x}_{3},\mathbf{x}_{4})\big)|\leq c_{3}\coloneq 1+\exp(c_{2})" display="inline" intent=":literal"><semantics><mrow><mrow><mo stretchy="false">|</mo><mrow><mrow><msub><mi>𝚽</mi><mrow><mn>2</mn><mo>,</mo><mn>3</mn></mrow></msub><mo lspace="0.222em" rspace="0.222em">∘</mo><msub><mi>𝚽</mi><mrow><mn>2</mn><mo>,</mo><mn>2</mn></mrow></msub></mrow><mo lspace="0em" rspace="0em">​</mo><mrow><mo maxsize="1.200em" minsize="1.200em">(</mo><msub><mi>𝐱</mi><mn>1</mn></msub><mo>,</mo><mrow><msub><mi>𝚽</mi><mrow><mn>2</mn><mo>,</mo><mn>1</mn></mrow></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mi>𝐱</mi><mn>3</mn></msub><mo>,</mo><msub><mi>𝐱</mi><mn>4</mn></msub><mo stretchy="false">)</mo></mrow></mrow><mo maxsize="1.200em" minsize="1.200em">)</mo></mrow></mrow><mo stretchy="false">|</mo></mrow><mo>≤</mo><msub><mi>c</mi><mn>3</mn></msub><mo>≔</mo><mrow><mn>1</mn><mo>+</mo><mrow><mi>exp</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><msub><mi>c</mi><mn>2</mn></msub><mo stretchy="false">)</mo></mrow></mrow></mrow></mrow><annotation encoding="application/x-tex">|\bm{\Phi}_{2,3}\circ\bm{\Phi}_{2,2}\big(\mathbf{x}_{1},\bm{\Phi}_{2,1}(\mathbf{x}_{3},\mathbf{x}_{4})\big)|\leq c_{3}\coloneq 1+\exp(c_{2})</annotation></semantics></math>.
By applying Lemma <a href="#Thmconj216" title="Lemma 16. ‣ E.2 Construction of multilayer perceptron layers ‣ Appendix E Construction of the Transformer ‣ Generalization Bounds for Transformer-Based Next-Token Prediction in a Language Model" class="ltx_ref"><span class="ltx_text ltx_ref_tag">16</span></a> <math id="A5.SS2.p13.m17" class="ltx_Math" alttext="m_{2}" display="inline" intent=":literal"><semantics><msub><mi>m</mi><mn>2</mn></msub><annotation encoding="application/x-tex">m_{2}</annotation></semantics></math>-times and parallelizing the results,
we construct <math id="A5.SS2.p13.m18" class="ltx_Math" alttext="\bm{\Phi}_{2,4}\in\mathcal{MLP}(m_{2}+1,m_{2},\lceil\log_{2}N_{\mathrm{mlp}}\rceil^{2},7m_{2},B)" display="inline" intent=":literal"><semantics><mrow><msub><mi>𝚽</mi><mrow><mn>2</mn><mo>,</mo><mn>4</mn></mrow></msub><mo>∈</mo><mrow><mi class="ltx_font_mathcaligraphic">ℳ</mi><mo lspace="0em" rspace="0em">​</mo><mi class="ltx_font_mathcaligraphic">ℒ</mi><mo lspace="0em" rspace="0em">​</mo><mi class="ltx_font_mathcaligraphic">𝒫</mi><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mrow><msub><mi>m</mi><mn>2</mn></msub><mo>+</mo><mn>1</mn></mrow><mo>,</mo><msub><mi>m</mi><mn>2</mn></msub><mo>,</mo><msup><mrow><mo stretchy="false">⌈</mo><mrow><msub><mi>log</mi><mn>2</mn></msub><mo lspace="0.167em">⁡</mo><msub><mi>N</mi><mi>mlp</mi></msub></mrow><mo stretchy="false">⌉</mo></mrow><mn>2</mn></msup><mo>,</mo><mrow><mn>7</mn><mo lspace="0em" rspace="0em">​</mo><msub><mi>m</mi><mn>2</mn></msub></mrow><mo>,</mo><mi>B</mi><mo stretchy="false">)</mo></mrow></mrow></mrow><annotation encoding="application/x-tex">\bm{\Phi}_{2,4}\in\mathcal{MLP}(m_{2}+1,m_{2},\lceil\log_{2}N_{\mathrm{mlp}}\rceil^{2},7m_{2},B)</annotation></semantics></math> such that for any <math id="A5.SS2.p13.m19" class="ltx_Math" alttext="y\in[-c_{3},c_{3}]" display="inline" intent=":literal"><semantics><mrow><mi>y</mi><mo>∈</mo><mrow><mo stretchy="false">[</mo><mrow><mrow><mo>−</mo><msub><mi>c</mi><mn>3</mn></msub></mrow><mo>,</mo><msub><mi>c</mi><mn>3</mn></msub></mrow><mo stretchy="false">]</mo></mrow></mrow><annotation encoding="application/x-tex">y\in[-c_{3},c_{3}]</annotation></semantics></math> and <math id="A5.SS2.p13.m20" class="ltx_Math" alttext="\mathbf{x}_{2}\in[-1,1]^{m_{2}}" display="inline" intent=":literal"><semantics><mrow><msub><mi>𝐱</mi><mn>2</mn></msub><mo>∈</mo><msup><mrow><mo stretchy="false">[</mo><mrow><mrow><mo>−</mo><mn>1</mn></mrow><mo>,</mo><mn>1</mn></mrow><mo stretchy="false">]</mo></mrow><msub><mi>m</mi><mn>2</mn></msub></msup></mrow><annotation encoding="application/x-tex">\mathbf{x}_{2}\in[-1,1]^{m_{2}}</annotation></semantics></math>,</span></p>
<table id="A5.Ex285" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="A5.Ex285.m1" class="ltx_Math" alttext="\big\|\bm{\Phi}_{2,4}(y,\mathbf{x}_{2})-y\mathbf{x}_{2}\big\|_{\infty}\lesssim(N_{\mathrm{mlp}})^{-\log_{2}N_{\mathrm{mlp}}}." display="block" intent=":literal"><semantics><mrow><mrow><msub><mrow><mo maxsize="1.200em" minsize="1.200em" stretchy="true">‖</mo><mrow><mrow><msub><mi>𝚽</mi><mrow><mn>2</mn><mo>,</mo><mn>4</mn></mrow></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>y</mi><mo>,</mo><msub><mi>𝐱</mi><mn>2</mn></msub><mo stretchy="false">)</mo></mrow></mrow><mo>−</mo><mrow><mi>y</mi><mo lspace="0em" rspace="0em">​</mo><msub><mi>𝐱</mi><mn>2</mn></msub></mrow></mrow><mo maxsize="1.200em" minsize="1.200em" stretchy="true">‖</mo></mrow><mi mathvariant="normal">∞</mi></msub><mo>≲</mo><msup><mrow><mo stretchy="false">(</mo><msub><mi>N</mi><mi>mlp</mi></msub><mo stretchy="false">)</mo></mrow><mrow><mo rspace="0.167em">−</mo><mrow><msub><mi>log</mi><mn>2</mn></msub><mo lspace="0.167em">⁡</mo><msub><mi>N</mi><mi>mlp</mi></msub></mrow></mrow></msup></mrow><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">\big\|\bm{\Phi}_{2,4}(y,\mathbf{x}_{2})-y\mathbf{x}_{2}\big\|_{\infty}\lesssim(N_{\mathrm{mlp}})^{-\log_{2}N_{\mathrm{mlp}}}.</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="A5.SS2.p13.6" class="ltx_p"><span id="A5.SS2.p13.6.1" class="ltx_text">To sum up, we can construct
<math id="A5.SS2.p13.m21" class="ltx_Math" alttext="\bm{\Phi}_{2}\in\mathcal{MLP}((r_{1}+1)m_{1}+m_{2},m_{2},7\lceil\log_{2}N_{\mathrm{mlp}}\rceil^{2},\lceil N_{\mathrm{mlp}}/2\rceil,B)" display="inline" intent=":literal"><semantics><mrow><msub><mi>𝚽</mi><mn>2</mn></msub><mo>∈</mo><mrow><mi class="ltx_font_mathcaligraphic">ℳ</mi><mo lspace="0em" rspace="0em">​</mo><mi class="ltx_font_mathcaligraphic">ℒ</mi><mo lspace="0em" rspace="0em">​</mo><mi class="ltx_font_mathcaligraphic">𝒫</mi><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mrow><mrow><mrow><mo stretchy="false">(</mo><mrow><msub><mi>r</mi><mn>1</mn></msub><mo>+</mo><mn>1</mn></mrow><mo stretchy="false">)</mo></mrow><mo lspace="0em" rspace="0em">​</mo><msub><mi>m</mi><mn>1</mn></msub></mrow><mo>+</mo><msub><mi>m</mi><mn>2</mn></msub></mrow><mo>,</mo><msub><mi>m</mi><mn>2</mn></msub><mo>,</mo><mrow><mn>7</mn><mo lspace="0em" rspace="0em">​</mo><msup><mrow><mo stretchy="false">⌈</mo><mrow><msub><mi>log</mi><mn>2</mn></msub><mo lspace="0.167em">⁡</mo><msub><mi>N</mi><mi>mlp</mi></msub></mrow><mo stretchy="false">⌉</mo></mrow><mn>2</mn></msup></mrow><mo>,</mo><mrow><mo stretchy="false">⌈</mo><mrow><msub><mi>N</mi><mi>mlp</mi></msub><mo>/</mo><mn>2</mn></mrow><mo stretchy="false">⌉</mo></mrow><mo>,</mo><mi>B</mi><mo stretchy="false">)</mo></mrow></mrow></mrow><annotation encoding="application/x-tex">\bm{\Phi}_{2}\in\mathcal{MLP}((r_{1}+1)m_{1}+m_{2},m_{2},7\lceil\log_{2}N_{\mathrm{mlp}}\rceil^{2},\lceil N_{\mathrm{mlp}}/2\rceil,B)</annotation></semantics></math> with</span></p>
<table id="A5.Ex286" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="A5.Ex286.m1" class="ltx_Math" alttext="\bm{\Phi}_{2}(\mathbf{x}_{1},\mathbf{x}_{2},\mathbf{x}_{3},\mathbf{x}_{4})\coloneq\bm{\Phi}_{2,4}\Big(\bm{\Phi}_{2,3}\circ\bm{\Phi}_{2,2}\big(\mathbf{x}_{1},\bm{\Phi}_{2,1}(\mathbf{x}_{3},\mathbf{x}_{4})\big),\mathbf{x}_{2}\Big)," display="block" intent=":literal"><semantics><mrow><mrow><mrow><msub><mi>𝚽</mi><mn>2</mn></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mi>𝐱</mi><mn>1</mn></msub><mo>,</mo><msub><mi>𝐱</mi><mn>2</mn></msub><mo>,</mo><msub><mi>𝐱</mi><mn>3</mn></msub><mo>,</mo><msub><mi>𝐱</mi><mn>4</mn></msub><mo stretchy="false">)</mo></mrow></mrow><mo>≔</mo><mrow><msub><mi>𝚽</mi><mrow><mn>2</mn><mo>,</mo><mn>4</mn></mrow></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo maxsize="1.600em" minsize="1.600em">(</mo><mrow><mrow><msub><mi>𝚽</mi><mrow><mn>2</mn><mo>,</mo><mn>3</mn></mrow></msub><mo lspace="0.222em" rspace="0.222em">∘</mo><msub><mi>𝚽</mi><mrow><mn>2</mn><mo>,</mo><mn>2</mn></mrow></msub></mrow><mo lspace="0em" rspace="0em">​</mo><mrow><mo maxsize="1.200em" minsize="1.200em">(</mo><msub><mi>𝐱</mi><mn>1</mn></msub><mo>,</mo><mrow><msub><mi>𝚽</mi><mrow><mn>2</mn><mo>,</mo><mn>1</mn></mrow></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mi>𝐱</mi><mn>3</mn></msub><mo>,</mo><msub><mi>𝐱</mi><mn>4</mn></msub><mo stretchy="false">)</mo></mrow></mrow><mo maxsize="1.200em" minsize="1.200em">)</mo></mrow></mrow><mo>,</mo><msub><mi>𝐱</mi><mn>2</mn></msub><mo maxsize="1.600em" minsize="1.600em">)</mo></mrow></mrow></mrow><mo>,</mo></mrow><annotation encoding="application/x-tex">\bm{\Phi}_{2}(\mathbf{x}_{1},\mathbf{x}_{2},\mathbf{x}_{3},\mathbf{x}_{4})\coloneq\bm{\Phi}_{2,4}\Big(\bm{\Phi}_{2,3}\circ\bm{\Phi}_{2,2}\big(\mathbf{x}_{1},\bm{\Phi}_{2,1}(\mathbf{x}_{3},\mathbf{x}_{4})\big),\mathbf{x}_{2}\Big),</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="A5.SS2.p13.7" class="ltx_p"><span id="A5.SS2.p13.7.1" class="ltx_text">such that for any <math id="A5.SS2.p13.m22" class="ltx_Math" alttext="\mathbf{x}_{1},\mathbf{x}_{3}\in[-1,1]^{m_{1}}" display="inline" intent=":literal"><semantics><mrow><msub><mi>𝐱</mi><mn>1</mn></msub><mo>,</mo><mrow><msub><mi>𝐱</mi><mn>3</mn></msub><mo>∈</mo><msup><mrow><mo stretchy="false">[</mo><mrow><mrow><mo>−</mo><mn>1</mn></mrow><mo>,</mo><mn>1</mn></mrow><mo stretchy="false">]</mo></mrow><msub><mi>m</mi><mn>1</mn></msub></msup></mrow></mrow><annotation encoding="application/x-tex">\mathbf{x}_{1},\mathbf{x}_{3}\in[-1,1]^{m_{1}}</annotation></semantics></math>, <math id="A5.SS2.p13.m23" class="ltx_Math" alttext="\mathbf{x}_{2}\in[-1,1]^{m_{2}}" display="inline" intent=":literal"><semantics><mrow><msub><mi>𝐱</mi><mn>2</mn></msub><mo>∈</mo><msup><mrow><mo stretchy="false">[</mo><mrow><mrow><mo>−</mo><mn>1</mn></mrow><mo>,</mo><mn>1</mn></mrow><mo stretchy="false">]</mo></mrow><msub><mi>m</mi><mn>2</mn></msub></msup></mrow><annotation encoding="application/x-tex">\mathbf{x}_{2}\in[-1,1]^{m_{2}}</annotation></semantics></math>, and <math id="A5.SS2.p13.m24" class="ltx_Math" alttext="\mathbf{x}_{4}\in[-1,1]^{(r_{1}-1)m_{1}}" display="inline" intent=":literal"><semantics><mrow><msub><mi>𝐱</mi><mn>4</mn></msub><mo>∈</mo><msup><mrow><mo stretchy="false">[</mo><mrow><mrow><mo>−</mo><mn>1</mn></mrow><mo>,</mo><mn>1</mn></mrow><mo stretchy="false">]</mo></mrow><mrow><mrow><mo stretchy="false">(</mo><mrow><msub><mi>r</mi><mn>1</mn></msub><mo>−</mo><mn>1</mn></mrow><mo stretchy="false">)</mo></mrow><mo lspace="0em" rspace="0em">​</mo><msub><mi>m</mi><mn>1</mn></msub></mrow></msup></mrow><annotation encoding="application/x-tex">\mathbf{x}_{4}\in[-1,1]^{(r_{1}-1)m_{1}}</annotation></semantics></math>,</span></p>
<table id="A5.EGx119" class="ltx_equationgroup ltx_eqn_align ltx_eqn_table">

<tbody id="A5.E58"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_align_right ltx_eqn_cell"><math id="A5.E58.m1" class="ltx_Math" alttext="\displaystyle\Big|\bm{\Phi}_{2}(\mathbf{x}_{1},\mathbf{x}_{2},\mathbf{x}_{3},\mathbf{x}_{4})-\exp\big(-\mathbf{x}_{1}^{\top}\,\mathbf{g}_{0}(\mathbf{x}_{3},\mathbf{x}_{4})\big)\mathbf{x}_{2}\Big|\lesssim(N_{\mathrm{mlp}})^{-\frac{2\beta_{1}}{m_{1}r_{1}}}." display="inline" intent=":literal"><semantics><mrow><mrow><mrow><mo maxsize="1.600em" minsize="1.600em" stretchy="true">|</mo><mrow><mrow><msub><mi>𝚽</mi><mn>2</mn></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mi>𝐱</mi><mn>1</mn></msub><mo>,</mo><msub><mi>𝐱</mi><mn>2</mn></msub><mo>,</mo><msub><mi>𝐱</mi><mn>3</mn></msub><mo>,</mo><msub><mi>𝐱</mi><mn>4</mn></msub><mo stretchy="false">)</mo></mrow></mrow><mo>−</mo><mrow><mrow><mi>exp</mi><mo>⁡</mo><mrow><mo maxsize="1.200em" minsize="1.200em">(</mo><mrow><mo>−</mo><mrow><msubsup><mi>𝐱</mi><mn>1</mn><mo>⊤</mo></msubsup><mo lspace="0em" rspace="0em">​</mo><msub><mi>𝐠</mi><mn>0</mn></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mi>𝐱</mi><mn>3</mn></msub><mo>,</mo><msub><mi>𝐱</mi><mn>4</mn></msub><mo stretchy="false">)</mo></mrow></mrow></mrow><mo maxsize="1.200em" minsize="1.200em">)</mo></mrow></mrow><mo lspace="0em" rspace="0em">​</mo><msub><mi>𝐱</mi><mn>2</mn></msub></mrow></mrow><mo maxsize="1.600em" minsize="1.600em" stretchy="true">|</mo></mrow><mo>≲</mo><msup><mrow><mo stretchy="false">(</mo><msub><mi>N</mi><mi>mlp</mi></msub><mo stretchy="false">)</mo></mrow><mrow><mo>−</mo><mfrac><mrow><mn>2</mn><mo lspace="0em" rspace="0em">​</mo><msub><mi>β</mi><mn>1</mn></msub></mrow><mrow><msub><mi>m</mi><mn>1</mn></msub><mo lspace="0em" rspace="0em">​</mo><msub><mi>r</mi><mn>1</mn></msub></mrow></mfrac></mrow></msup></mrow><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">\displaystyle\Big|\bm{\Phi}_{2}(\mathbf{x}_{1},\mathbf{x}_{2},\mathbf{x}_{3},\mathbf{x}_{4})-\exp\big(-\mathbf{x}_{1}^{\top}\,\mathbf{g}_{0}(\mathbf{x}_{3},\mathbf{x}_{4})\big)\mathbf{x}_{2}\Big|\lesssim(N_{\mathrm{mlp}})^{-\frac{2\beta_{1}}{m_{1}r_{1}}}.</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td>
<td rowspan="1" class="ltx_eqn_cell ltx_eqn_eqno ltx_align_middle ltx_align_right"><span class="ltx_tag ltx_tag_equation ltx_align_right">(58)</span></td></tr></tbody>
</table>
</div>
<div id="A5.SS2.p14" class="ltx_para">
<p id="A5.SS2.p14.1" class="ltx_p"><span id="A5.SS2.p14.1.1" class="ltx_text">By Assumption <a href="#Thmassumpt3" title="Assumption 3. ‣ 4 Risk bound ‣ Generalization Bounds for Transformer-Based Next-Token Prediction in a Language Model" class="ltx_ref"><span class="ltx_text ltx_ref_tag">3</span></a>, we have</span></p>
<table id="A5.Ex287" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="A5.Ex287.m1" class="ltx_Math" alttext="B^{L_{\mathrm{mlp}}-1}\geq(\log^{2}T)^{\log^{3}T}\geq T\cdot T\geq\frac{\sqrt{r_{2}}}{\lambda}\geq\frac{1}{\lambda}." display="block" intent=":literal"><semantics><mrow><mrow><msup><mi>B</mi><mrow><msub><mi>L</mi><mi>mlp</mi></msub><mo>−</mo><mn>1</mn></mrow></msup><mo>≥</mo><msup><mrow><mo stretchy="false">(</mo><mrow><msup><mi>log</mi><mn>2</mn></msup><mo lspace="0.167em">⁡</mo><mi>T</mi></mrow><mo stretchy="false">)</mo></mrow><mrow><msup><mi>log</mi><mn>3</mn></msup><mo lspace="0.167em">⁡</mo><mi>T</mi></mrow></msup><mo>≥</mo><mrow><mi>T</mi><mo lspace="0.222em" rspace="0.222em">⋅</mo><mi>T</mi></mrow><mo>≥</mo><mfrac><msqrt><msub><mi>r</mi><mn>2</mn></msub></msqrt><mi>λ</mi></mfrac><mo>≥</mo><mfrac><mn>1</mn><mi>λ</mi></mfrac></mrow><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">B^{L_{\mathrm{mlp}}-1}\geq(\log^{2}T)^{\log^{3}T}\geq T\cdot T\geq\frac{\sqrt{r_{2}}}{\lambda}\geq\frac{1}{\lambda}.</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="A5.SS2.p14.2" class="ltx_p"><span id="A5.SS2.p14.2.1" class="ltx_text">Using Lemma <a href="#Thmconj222" title="Lemma 22. ‣ E.2 Construction of multilayer perceptron layers ‣ Appendix E Construction of the Transformer ‣ Generalization Bounds for Transformer-Based Next-Token Prediction in a Language Model" class="ltx_ref"><span class="ltx_text ltx_ref_tag">22</span></a>,
we can construct
<math id="A5.SS2.p14.m1" class="ltx_Math" alttext="\bm{\Phi}_{3}\in\mathcal{MLP}((r_{2}+1)m_{2}+1,(r_{2}+1)m_{2}+1,L_{\mathrm{mlp}},2(r_{2}+1)m_{2}+2,B)" display="inline" intent=":literal"><semantics><mrow><msub><mi>𝚽</mi><mn>3</mn></msub><mo>∈</mo><mrow><mi class="ltx_font_mathcaligraphic">ℳ</mi><mo lspace="0em" rspace="0em">​</mo><mi class="ltx_font_mathcaligraphic">ℒ</mi><mo lspace="0em" rspace="0em">​</mo><mi class="ltx_font_mathcaligraphic">𝒫</mi><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mrow><mrow><mrow><mo stretchy="false">(</mo><mrow><msub><mi>r</mi><mn>2</mn></msub><mo>+</mo><mn>1</mn></mrow><mo stretchy="false">)</mo></mrow><mo lspace="0em" rspace="0em">​</mo><msub><mi>m</mi><mn>2</mn></msub></mrow><mo>+</mo><mn>1</mn></mrow><mo>,</mo><mrow><mrow><mrow><mo stretchy="false">(</mo><mrow><msub><mi>r</mi><mn>2</mn></msub><mo>+</mo><mn>1</mn></mrow><mo stretchy="false">)</mo></mrow><mo lspace="0em" rspace="0em">​</mo><msub><mi>m</mi><mn>2</mn></msub></mrow><mo>+</mo><mn>1</mn></mrow><mo>,</mo><msub><mi>L</mi><mi>mlp</mi></msub><mo>,</mo><mrow><mrow><mn>2</mn><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mrow><msub><mi>r</mi><mn>2</mn></msub><mo>+</mo><mn>1</mn></mrow><mo stretchy="false">)</mo></mrow><mo lspace="0em" rspace="0em">​</mo><msub><mi>m</mi><mn>2</mn></msub></mrow><mo>+</mo><mn>2</mn></mrow><mo>,</mo><mi>B</mi><mo stretchy="false">)</mo></mrow></mrow></mrow><annotation encoding="application/x-tex">\bm{\Phi}_{3}\in\mathcal{MLP}((r_{2}+1)m_{2}+1,(r_{2}+1)m_{2}+1,L_{\mathrm{mlp}},2(r_{2}+1)m_{2}+2,B)</annotation></semantics></math>
such that</span></p>
<table id="A5.EGx120" class="ltx_equationgroup ltx_eqn_align ltx_eqn_table">

<tbody id="A5.E59"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_align_right ltx_eqn_cell"><math id="A5.E59.m1" class="ltx_Math" alttext="\displaystyle\bm{\Phi}_{3}(\mathbf{x}_{5},\mathbf{x}_{2},1)=\operatorname{stack}\Big(\frac{\mathbf{x}_{5}}{\lambda},\frac{\mathbf{x}_{2}}{\lambda},\frac{\sqrt{r_{2}}}{\lambda}\Big)." display="inline" intent=":literal"><semantics><mrow><mrow><mrow><msub><mi>𝚽</mi><mn>3</mn></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mi>𝐱</mi><mn>5</mn></msub><mo>,</mo><msub><mi>𝐱</mi><mn>2</mn></msub><mo>,</mo><mn>1</mn><mo stretchy="false">)</mo></mrow></mrow><mo>=</mo><mrow><mi>stack</mi><mo>⁡</mo><mrow><mo maxsize="1.600em" minsize="1.600em">(</mo><mstyle displaystyle="true"><mfrac><msub><mi>𝐱</mi><mn>5</mn></msub><mi>λ</mi></mfrac></mstyle><mo>,</mo><mstyle displaystyle="true"><mfrac><msub><mi>𝐱</mi><mn>2</mn></msub><mi>λ</mi></mfrac></mstyle><mo>,</mo><mstyle displaystyle="true"><mfrac><msqrt><msub><mi>r</mi><mn>2</mn></msub></msqrt><mi>λ</mi></mfrac></mstyle><mo maxsize="1.600em" minsize="1.600em">)</mo></mrow></mrow></mrow><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">\displaystyle\bm{\Phi}_{3}(\mathbf{x}_{5},\mathbf{x}_{2},1)=\operatorname{stack}\Big(\frac{\mathbf{x}_{5}}{\lambda},\frac{\mathbf{x}_{2}}{\lambda},\frac{\sqrt{r_{2}}}{\lambda}\Big).</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td>
<td rowspan="1" class="ltx_eqn_cell ltx_eqn_eqno ltx_align_middle ltx_align_right"><span class="ltx_tag ltx_tag_equation ltx_align_right">(59)</span></td></tr></tbody>
</table>
<p id="A5.SS2.p14.3" class="ltx_p"><span id="A5.SS2.p14.3.1" class="ltx_text">Similarly, notice that
<math id="A5.SS2.p14.m2" class="ltx_Math" alttext="(\lceil\tfrac{N_{\mathrm{mlp}}}{\log T}\rceil B)^{(\log N_{\mathrm{mlp}})}\geq N_{\mathrm{mlp}}^{(\log N_{\mathrm{mlp}})}\geq T^{3}" display="inline" intent=":literal"><semantics><mrow><msup><mrow><mo stretchy="false">(</mo><mrow><mrow><mo stretchy="false">⌈</mo><mfrac><msub><mi>N</mi><mi>mlp</mi></msub><mrow><mi>log</mi><mo lspace="0.167em">⁡</mo><mi>T</mi></mrow></mfrac><mo stretchy="false">⌉</mo></mrow><mo lspace="0em" rspace="0em">​</mo><mi>B</mi></mrow><mo stretchy="false">)</mo></mrow><mrow><mo stretchy="false">(</mo><mrow><mi>log</mi><mo lspace="0.167em">⁡</mo><msub><mi>N</mi><mi>mlp</mi></msub></mrow><mo stretchy="false">)</mo></mrow></msup><mo>≥</mo><msubsup><mi>N</mi><mi>mlp</mi><mrow><mo stretchy="false">(</mo><mrow><mi>log</mi><mo lspace="0.167em">⁡</mo><msub><mi>N</mi><mi>mlp</mi></msub></mrow><mo stretchy="false">)</mo></mrow></msubsup><mo>≥</mo><msup><mi>T</mi><mn>3</mn></msup></mrow><annotation encoding="application/x-tex">(\lceil\tfrac{N_{\mathrm{mlp}}}{\log T}\rceil B)^{(\log N_{\mathrm{mlp}})}\geq N_{\mathrm{mlp}}^{(\log N_{\mathrm{mlp}})}\geq T^{3}</annotation></semantics></math> since <math id="A5.SS2.p14.m3" class="ltx_Math" alttext="N_{\mathrm{mlp}}\geq T^{\alpha}" display="inline" intent=":literal"><semantics><mrow><msub><mi>N</mi><mi>mlp</mi></msub><mo>≥</mo><msup><mi>T</mi><mi>α</mi></msup></mrow><annotation encoding="application/x-tex">N_{\mathrm{mlp}}\geq T^{\alpha}</annotation></semantics></math> by Assumption <a href="#Thmassumpt3" title="Assumption 3. ‣ 4 Risk bound ‣ Generalization Bounds for Transformer-Based Next-Token Prediction in a Language Model" class="ltx_ref"><span class="ltx_text ltx_ref_tag">3</span></a>.
Using Lemma <a href="#Thmconj223" title="Lemma 23. ‣ E.2 Construction of multilayer perceptron layers ‣ Appendix E Construction of the Transformer ‣ Generalization Bounds for Transformer-Based Next-Token Prediction in a Language Model" class="ltx_ref"><span class="ltx_text ltx_ref_tag">23</span></a>,
we can construct <math id="A5.SS2.p14.m4" class="ltx_Math" alttext="\bm{\Phi}_{4}\in\mathcal{MLP}(\tfrac{N}{2},1,2+\lceil\log(N_{\mathrm{mlp}})\rceil,\lceil\tfrac{N_{\mathrm{mlp}}}{\log T}\rceil,B)" display="inline" intent=":literal"><semantics><mrow><msub><mi>𝚽</mi><mn>4</mn></msub><mo>∈</mo><mrow><mi class="ltx_font_mathcaligraphic">ℳ</mi><mo lspace="0em" rspace="0em">​</mo><mi class="ltx_font_mathcaligraphic">ℒ</mi><mo lspace="0em" rspace="0em">​</mo><mi class="ltx_font_mathcaligraphic">𝒫</mi><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mfrac><mi>N</mi><mn>2</mn></mfrac><mo>,</mo><mn>1</mn><mo>,</mo><mrow><mn>2</mn><mo>+</mo><mrow><mo stretchy="false">⌈</mo><mrow><mi>log</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><msub><mi>N</mi><mi>mlp</mi></msub><mo stretchy="false">)</mo></mrow></mrow><mo stretchy="false">⌉</mo></mrow></mrow><mo>,</mo><mrow><mo stretchy="false">⌈</mo><mfrac><msub><mi>N</mi><mi>mlp</mi></msub><mrow><mi>log</mi><mo lspace="0.167em">⁡</mo><mi>T</mi></mrow></mfrac><mo stretchy="false">⌉</mo></mrow><mo>,</mo><mi>B</mi><mo stretchy="false">)</mo></mrow></mrow></mrow><annotation encoding="application/x-tex">\bm{\Phi}_{4}\in\mathcal{MLP}(\tfrac{N}{2},1,2+\lceil\log(N_{\mathrm{mlp}})\rceil,\lceil\tfrac{N_{\mathrm{mlp}}}{\log T}\rceil,B)</annotation></semantics></math>
such that</span></p>
<table id="A5.EGx121" class="ltx_equationgroup ltx_eqn_align ltx_eqn_table">

<tbody id="A5.E60"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_align_right ltx_eqn_cell"><math id="A5.E60.m1" class="ltx_Math" alttext="\displaystyle\bm{\Phi}_{4}(\mathbf{q}_{t})=T^{3}\,\mathbb{I}\big(t\in[\log^{2}T,T-\log^{2}T]\big)." display="inline" intent=":literal"><semantics><mrow><mrow><mrow><msub><mi>𝚽</mi><mn>4</mn></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mi>𝐪</mi><mi>t</mi></msub><mo stretchy="false">)</mo></mrow></mrow><mo>=</mo><mrow><msup><mi>T</mi><mn>3</mn></msup><mo lspace="0em" rspace="0em">​</mo><mi>𝕀</mi><mo lspace="0em" rspace="0em">​</mo><mrow><mo maxsize="1.200em" minsize="1.200em">(</mo><mrow><mi>t</mi><mo>∈</mo><mrow><mo stretchy="false">[</mo><mrow><mrow><msup><mi>log</mi><mn>2</mn></msup><mo lspace="0.167em">⁡</mo><mi>T</mi></mrow><mo>,</mo><mrow><mi>T</mi><mo>−</mo><mrow><msup><mi>log</mi><mn>2</mn></msup><mo lspace="0.167em">⁡</mo><mi>T</mi></mrow></mrow></mrow><mo stretchy="false">]</mo></mrow></mrow><mo maxsize="1.200em" minsize="1.200em">)</mo></mrow></mrow></mrow><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">\displaystyle\bm{\Phi}_{4}(\mathbf{q}_{t})=T^{3}\,\mathbb{I}\big(t\in[\log^{2}T,T-\log^{2}T]\big).</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td>
<td rowspan="1" class="ltx_eqn_cell ltx_eqn_eqno ltx_align_middle ltx_align_right"><span class="ltx_tag ltx_tag_equation ltx_align_right">(60)</span></td></tr></tbody>
</table>
<p id="A5.SS2.p14.4" class="ltx_p"><span id="A5.SS2.p14.4.1" class="ltx_text">By stacking the MLPs <math id="A5.SS2.p14.m5" class="ltx_Math" alttext="(\bm{\Phi}_{1},\bm{\Phi}_{2},\bm{\Phi}_{3},\bm{\Phi}_{4})" display="inline" intent=":literal"><semantics><mrow><mo stretchy="false">(</mo><msub><mi>𝚽</mi><mn>1</mn></msub><mo>,</mo><msub><mi>𝚽</mi><mn>2</mn></msub><mo>,</mo><msub><mi>𝚽</mi><mn>3</mn></msub><mo>,</mo><msub><mi>𝚽</mi><mn>4</mn></msub><mo stretchy="false">)</mo></mrow><annotation encoding="application/x-tex">(\bm{\Phi}_{1},\bm{\Phi}_{2},\bm{\Phi}_{3},\bm{\Phi}_{4})</annotation></semantics></math> and using (<a href="#A5.E57" title="In Proof. ‣ E.2 Construction of multilayer perceptron layers ‣ Appendix E Construction of the Transformer ‣ Generalization Bounds for Transformer-Based Next-Token Prediction in a Language Model" class="ltx_ref"><span class="ltx_text ltx_ref_tag">57</span></a>), (<a href="#A5.E58" title="In Proof. ‣ E.2 Construction of multilayer perceptron layers ‣ Appendix E Construction of the Transformer ‣ Generalization Bounds for Transformer-Based Next-Token Prediction in a Language Model" class="ltx_ref"><span class="ltx_text ltx_ref_tag">58</span></a>), (<a href="#A5.E59" title="In Proof. ‣ E.2 Construction of multilayer perceptron layers ‣ Appendix E Construction of the Transformer ‣ Generalization Bounds for Transformer-Based Next-Token Prediction in a Language Model" class="ltx_ref"><span class="ltx_text ltx_ref_tag">59</span></a>) and (<a href="#A5.E60" title="In Proof. ‣ E.2 Construction of multilayer perceptron layers ‣ Appendix E Construction of the Transformer ‣ Generalization Bounds for Transformer-Based Next-Token Prediction in a Language Model" class="ltx_ref"><span class="ltx_text ltx_ref_tag">60</span></a>), we obtain the assertion.
∎</span></p>
</div>
</div>
<div id="A5.SS2.p15" class="ltx_para">
<p id="A5.SS2.p15.1" class="ltx_p">Later, we apply Lemma <a href="#Thmconj224" title="Lemma 24. ‣ E.2 Construction of multilayer perceptron layers ‣ Appendix E Construction of the Transformer ‣ Generalization Bounds for Transformer-Based Next-Token Prediction in a Language Model" class="ltx_ref"><span class="ltx_text ltx_ref_tag">24</span></a> by setting</p>
<table id="A5.Ex288" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="A5.Ex288.m1" class="ltx_Math" alttext="\mathbf{x}_{1}=\bm{\phi}_{1}(\mathbf{X}_{t}),\quad\mathbf{x}_{2}=\bm{\phi}_{2}(\mathbf{X}_{t}),\quad\mathbf{x}_{3}=\bm{\phi}_{1}(\mathbf{X}_{t-r_{1}}),\quad\mathbf{x}_{4}=\operatorname{stack}(\bm{\phi}_{1}(\mathbf{X}_{t-r_{1}+1}),\ldots,\bm{\phi}_{1}(\mathbf{X}_{t-1})),\quad\mathbf{x}_{5}=\mathbf{Z}_{2,t}." display="block" intent=":literal"><semantics><mrow><mrow><mrow><msub><mi>𝐱</mi><mn>1</mn></msub><mo>=</mo><mrow><msub><mi class="ltx_mathvariant_bold-italic" mathvariant="bold-italic">ϕ</mi><mn>1</mn></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mi>𝐗</mi><mi>t</mi></msub><mo stretchy="false">)</mo></mrow></mrow></mrow><mo rspace="1.167em">,</mo><mrow><msub><mi>𝐱</mi><mn>2</mn></msub><mo>=</mo><mrow><msub><mi class="ltx_mathvariant_bold-italic" mathvariant="bold-italic">ϕ</mi><mn>2</mn></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mi>𝐗</mi><mi>t</mi></msub><mo stretchy="false">)</mo></mrow></mrow></mrow><mo rspace="1.167em">,</mo><mrow><msub><mi>𝐱</mi><mn>3</mn></msub><mo>=</mo><mrow><msub><mi class="ltx_mathvariant_bold-italic" mathvariant="bold-italic">ϕ</mi><mn>1</mn></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mi>𝐗</mi><mrow><mi>t</mi><mo>−</mo><msub><mi>r</mi><mn>1</mn></msub></mrow></msub><mo stretchy="false">)</mo></mrow></mrow></mrow><mo rspace="1.167em">,</mo><mrow><msub><mi>𝐱</mi><mn>4</mn></msub><mo>=</mo><mrow><mi>stack</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mrow><msub><mi class="ltx_mathvariant_bold-italic" mathvariant="bold-italic">ϕ</mi><mn>1</mn></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mi>𝐗</mi><mrow><mrow><mi>t</mi><mo>−</mo><msub><mi>r</mi><mn>1</mn></msub></mrow><mo>+</mo><mn>1</mn></mrow></msub><mo stretchy="false">)</mo></mrow></mrow><mo>,</mo><mi mathvariant="normal">…</mi><mo>,</mo><mrow><msub><mi class="ltx_mathvariant_bold-italic" mathvariant="bold-italic">ϕ</mi><mn>1</mn></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mi>𝐗</mi><mrow><mi>t</mi><mo>−</mo><mn>1</mn></mrow></msub><mo stretchy="false">)</mo></mrow></mrow><mo stretchy="false">)</mo></mrow></mrow></mrow><mo rspace="1.167em">,</mo><mrow><msub><mi>𝐱</mi><mn>5</mn></msub><mo>=</mo><msub><mi>𝐙</mi><mrow><mn>2</mn><mo>,</mo><mi>t</mi></mrow></msub></mrow></mrow><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">\mathbf{x}_{1}=\bm{\phi}_{1}(\mathbf{X}_{t}),\quad\mathbf{x}_{2}=\bm{\phi}_{2}(\mathbf{X}_{t}),\quad\mathbf{x}_{3}=\bm{\phi}_{1}(\mathbf{X}_{t-r_{1}}),\quad\mathbf{x}_{4}=\operatorname{stack}(\bm{\phi}_{1}(\mathbf{X}_{t-r_{1}+1}),\ldots,\bm{\phi}_{1}(\mathbf{X}_{t-1})),\quad\mathbf{x}_{5}=\mathbf{Z}_{2,t}.</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
</div>
<div id="Thmconj225" class="ltx_theorem ltx_theorem_lemma">
<h6 class="ltx_title ltx_runin ltx_title_theorem"><span class="ltx_tag ltx_tag_theorem"><span id="Thmconj225.4" class="ltx_text ltx_font_bold">Lemma 25</span></span><span id="Thmconj225.5" class="ltx_text ltx_font_bold">.</span></h6>
<div id="Thmconj225.p1" class="ltx_para">
<p id="Thmconj225.p1.1" class="ltx_p"><span id="Thmconj225.p1.1.1" class="ltx_text ltx_font_italic">Given <math id="Thmconj225.p1.m1" class="ltx_Math" alttext="0&lt;a&lt;b" display="inline" intent=":literal"><semantics><mrow><mn>0</mn><mo>&lt;</mo><mi>a</mi><mo>&lt;</mo><mi>b</mi></mrow><annotation encoding="application/x-tex">0&lt;a&lt;b</annotation></semantics></math>, <math id="Thmconj225.p1.m2" class="ltx_Math" alttext="\delta&gt;0," display="inline" intent=":literal"><semantics><mrow><mrow><mi>δ</mi><mo>&gt;</mo><mn>0</mn></mrow><mo>,</mo></mrow><annotation encoding="application/x-tex">\delta&gt;0,</annotation></semantics></math> and input dimension <math id="Thmconj225.p1.m3" class="ltx_Math" alttext="d" display="inline" intent=":literal"><semantics><mi>d</mi><annotation encoding="application/x-tex">d</annotation></semantics></math>, there exist constants <math id="Thmconj225.p1.m4" class="ltx_Math" alttext="c=c(a,b,\delta,d)," display="inline" intent=":literal"><semantics><mrow><mrow><mi>c</mi><mo>=</mo><mrow><mi>c</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>a</mi><mo>,</mo><mi>b</mi><mo>,</mo><mi>δ</mi><mo>,</mo><mi>d</mi><mo stretchy="false">)</mo></mrow></mrow></mrow><mo>,</mo></mrow><annotation encoding="application/x-tex">c=c(a,b,\delta,d),</annotation></semantics></math> <math id="Thmconj225.p1.m5" class="ltx_Math" alttext="c^{\prime}=c^{\prime}(a,b,\delta,d)" display="inline" intent=":literal"><semantics><mrow><msup><mi>c</mi><mo>′</mo></msup><mo>=</mo><mrow><msup><mi>c</mi><mo>′</mo></msup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>a</mi><mo>,</mo><mi>b</mi><mo>,</mo><mi>δ</mi><mo>,</mo><mi>d</mi><mo stretchy="false">)</mo></mrow></mrow></mrow><annotation encoding="application/x-tex">c^{\prime}=c^{\prime}(a,b,\delta,d)</annotation></semantics></math> such that for any sufficiently large <math id="Thmconj225.p1.m6" class="ltx_Math" alttext="M" display="inline" intent=":literal"><semantics><mi>M</mi><annotation encoding="application/x-tex">M</annotation></semantics></math>, there exists a multilayer perceptron <math id="Thmconj225.p1.m7" class="ltx_Math" alttext="\mathbf{f}:\mathbb{R}^{d}\rightarrow\mathbb{R}^{d}" display="inline" intent=":literal"><semantics><mrow><mi>𝐟</mi><mo lspace="0.278em" rspace="0.278em">:</mo><mrow><msup><mi>ℝ</mi><mi>d</mi></msup><mo stretchy="false">→</mo><msup><mi>ℝ</mi><mi>d</mi></msup></mrow></mrow><annotation encoding="application/x-tex">\mathbf{f}:\mathbb{R}^{d}\rightarrow\mathbb{R}^{d}</annotation></semantics></math>
with depth <math id="Thmconj225.p1.m8" class="ltx_Math" alttext="\lceil\log_{2}(4b^{2}M/a^{2})\rceil M+2M" display="inline" intent=":literal"><semantics><mrow><mrow><mrow><mo stretchy="false">⌈</mo><mrow><msub><mi>log</mi><mn>2</mn></msub><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mrow><mrow><mn>4</mn><mo lspace="0em" rspace="0em">​</mo><msup><mi>b</mi><mn>2</mn></msup><mo lspace="0em" rspace="0em">​</mo><mi>M</mi></mrow><mo>/</mo><msup><mi>a</mi><mn>2</mn></msup></mrow><mo stretchy="false">)</mo></mrow></mrow><mo stretchy="false">⌉</mo></mrow><mo lspace="0em" rspace="0em">​</mo><mi>M</mi></mrow><mo>+</mo><mrow><mn>2</mn><mo lspace="0em" rspace="0em">​</mo><mi>M</mi></mrow></mrow><annotation encoding="application/x-tex">\lceil\log_{2}(4b^{2}M/a^{2})\rceil M+2M</annotation></semantics></math>, width <math id="Thmconj225.p1.m9" class="ltx_Math" alttext="M^{3}" display="inline" intent=":literal"><semantics><msup><mi>M</mi><mn>3</mn></msup><annotation encoding="application/x-tex">M^{3}</annotation></semantics></math>, and parameters bounded in absolute value by <math id="Thmconj225.p1.m10" class="ltx_Math" alttext="c," display="inline" intent=":literal"><semantics><mrow><mi>c</mi><mo>,</mo></mrow><annotation encoding="application/x-tex">c,</annotation></semantics></math> satisfying</span></p>
<table id="A5.Ex289" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="A5.Ex289.m1" class="ltx_math_unparsed" alttext="\sup_{\mathbf{x}\in\mathbb{R}^{d}:a\leq\|\mathbf{x}\|_{2}\leq b}\left\|\mathbf{f}(\mathbf{x})-\frac{\delta}{\|\mathbf{x}\|_{2}}\mathbf{x}\right\|_{\infty}\leq c^{\prime}M^{2}2^{-M}." display="block" intent=":literal"><semantics><mrow><munder><mo movablelimits="false">sup</mo><mrow><mi>𝐱</mi><mo>∈</mo><msup><mi>ℝ</mi><mi>d</mi></msup><mo lspace="0.278em" rspace="0.278em">:</mo><mrow><mi>a</mi><mo>≤</mo><msub><mrow><mo stretchy="false">‖</mo><mi>𝐱</mi><mo stretchy="false">‖</mo></mrow><mn>2</mn></msub><mo>≤</mo><mi>b</mi></mrow></mrow></munder><msub><mrow><mo lspace="0em">‖</mo><mi>𝐟</mi><mrow><mo stretchy="false">(</mo><mi>𝐱</mi><mo stretchy="false">)</mo></mrow><mo>−</mo><mfrac><mi>δ</mi><msub><mrow><mo stretchy="false">‖</mo><mi>𝐱</mi><mo stretchy="false">‖</mo></mrow><mn>2</mn></msub></mfrac><mi>𝐱</mi><mo>‖</mo></mrow><mi mathvariant="normal">∞</mi></msub><mo>≤</mo><msup><mi>c</mi><mo>′</mo></msup><msup><mi>M</mi><mn>2</mn></msup><msup><mn>2</mn><mrow><mo>−</mo><mi>M</mi></mrow></msup><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">\sup_{\mathbf{x}\in\mathbb{R}^{d}:a\leq\|\mathbf{x}\|_{2}\leq b}\left\|\mathbf{f}(\mathbf{x})-\frac{\delta}{\|\mathbf{x}\|_{2}}\mathbf{x}\right\|_{\infty}\leq c^{\prime}M^{2}2^{-M}.</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
</div>
</div>
<div id="A5.SS2.9" class="ltx_proof">
<h6 class="ltx_title ltx_runin ltx_font_italic ltx_title_proof">Proof.</h6>
<div id="A5.SS2.p16" class="ltx_para">
<p id="A5.SS2.p16.1" class="ltx_p"><span id="A5.SS2.p16.1.1" class="ltx_text">First, applying Lemma <a href="#Thmconj216" title="Lemma 16. ‣ E.2 Construction of multilayer perceptron layers ‣ Appendix E Construction of the Transformer ‣ Generalization Bounds for Transformer-Based Next-Token Prediction in a Language Model" class="ltx_ref"><span class="ltx_text ltx_ref_tag">16</span></a> <math id="A5.SS2.p16.m1" class="ltx_Math" alttext="d" display="inline" intent=":literal"><semantics><mi>d</mi><annotation encoding="application/x-tex">d</annotation></semantics></math> times and summing the results shows the existence of
a multilayer perceptron
<math id="A5.SS2.p16.m2" class="ltx_Math" alttext="g_{1}:\mathbb{R}^{d}\rightarrow\mathbb{R}" display="inline" intent=":literal"><semantics><mrow><msub><mi>g</mi><mn>1</mn></msub><mo lspace="0.278em" rspace="0.278em">:</mo><mrow><msup><mi>ℝ</mi><mi>d</mi></msup><mo stretchy="false">→</mo><mi>ℝ</mi></mrow></mrow><annotation encoding="application/x-tex">g_{1}:\mathbb{R}^{d}\rightarrow\mathbb{R}</annotation></semantics></math> with depth <math id="A5.SS2.p16.m3" class="ltx_Math" alttext="M" display="inline" intent=":literal"><semantics><mi>M</mi><annotation encoding="application/x-tex">M</annotation></semantics></math>, width <math id="A5.SS2.p16.m4" class="ltx_Math" alttext="7d" display="inline" intent=":literal"><semantics><mrow><mn>7</mn><mo lspace="0em" rspace="0em">​</mo><mi>d</mi></mrow><annotation encoding="application/x-tex">7d</annotation></semantics></math>, and parameters bounded in absolute value by a constant
depending only on <math id="A5.SS2.p16.m5" class="ltx_Math" alttext="b" display="inline" intent=":literal"><semantics><mi>b</mi><annotation encoding="application/x-tex">b</annotation></semantics></math> such that</span></p>
<table id="A5.Ex290" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="A5.Ex290.m1" class="ltx_Math" alttext="\sup_{\mathbf{x}\in[-b,b]^{d}}\big|g_{1}(\mathbf{x})-\|\mathbf{x}\|_{2}^{2}\big|\lesssim 2^{-M}." display="block" intent=":literal"><semantics><mrow><mrow><mrow><munder><mo movablelimits="false">sup</mo><mrow><mi>𝐱</mi><mo>∈</mo><msup><mrow><mo stretchy="false">[</mo><mrow><mrow><mo>−</mo><mi>b</mi></mrow><mo>,</mo><mi>b</mi></mrow><mo stretchy="false">]</mo></mrow><mi>d</mi></msup></mrow></munder><mrow><mo lspace="0em" maxsize="1.200em" minsize="1.200em" stretchy="true">|</mo><mrow><mrow><msub><mi>g</mi><mn>1</mn></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>𝐱</mi><mo stretchy="false">)</mo></mrow></mrow><mo>−</mo><msubsup><mrow><mo stretchy="false">‖</mo><mi>𝐱</mi><mo stretchy="false">‖</mo></mrow><mn>2</mn><mn>2</mn></msubsup></mrow><mo maxsize="1.200em" minsize="1.200em" stretchy="true">|</mo></mrow></mrow><mo>≲</mo><msup><mn>2</mn><mrow><mo>−</mo><mi>M</mi></mrow></msup></mrow><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">\sup_{\mathbf{x}\in[-b,b]^{d}}\big|g_{1}(\mathbf{x})-\|\mathbf{x}\|_{2}^{2}\big|\lesssim 2^{-M}.</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="A5.SS2.p16.2" class="ltx_p"><span id="A5.SS2.p16.2.1" class="ltx_text">Second, by Lemma <a href="#Thmconj221" title="Lemma 21. ‣ E.2 Construction of multilayer perceptron layers ‣ Appendix E Construction of the Transformer ‣ Generalization Bounds for Transformer-Based Next-Token Prediction in a Language Model" class="ltx_ref"><span class="ltx_text ltx_ref_tag">21</span></a>, there exists
a multilayer perceptron
<math id="A5.SS2.p16.m6" class="ltx_Math" alttext="g_{2}:\mathbb{R}\rightarrow\mathbb{R}" display="inline" intent=":literal"><semantics><mrow><msub><mi>g</mi><mn>2</mn></msub><mo lspace="0.278em" rspace="0.278em">:</mo><mrow><mi>ℝ</mi><mo stretchy="false">→</mo><mi>ℝ</mi></mrow></mrow><annotation encoding="application/x-tex">g_{2}:\mathbb{R}\rightarrow\mathbb{R}</annotation></semantics></math> with depth <math id="A5.SS2.p16.m7" class="ltx_Math" alttext="\lceil\log_{2}(4b^{2}M/a^{2})\rceil M" display="inline" intent=":literal"><semantics><mrow><mrow><mo stretchy="false">⌈</mo><mrow><msub><mi>log</mi><mn>2</mn></msub><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mrow><mrow><mn>4</mn><mo lspace="0em" rspace="0em">​</mo><msup><mi>b</mi><mn>2</mn></msup><mo lspace="0em" rspace="0em">​</mo><mi>M</mi></mrow><mo>/</mo><msup><mi>a</mi><mn>2</mn></msup></mrow><mo stretchy="false">)</mo></mrow></mrow><mo stretchy="false">⌉</mo></mrow><mo lspace="0em" rspace="0em">​</mo><mi>M</mi></mrow><annotation encoding="application/x-tex">\lceil\log_{2}(4b^{2}M/a^{2})\rceil M</annotation></semantics></math>, width <math id="A5.SS2.p16.m8" class="ltx_Math" alttext="7\lceil 4b^{2}M/a^{2}\rceil^{2}" display="inline" intent=":literal"><semantics><mrow><mn>7</mn><mo lspace="0em" rspace="0em">​</mo><msup><mrow><mo stretchy="false">⌈</mo><mrow><mrow><mn>4</mn><mo lspace="0em" rspace="0em">​</mo><msup><mi>b</mi><mn>2</mn></msup><mo lspace="0em" rspace="0em">​</mo><mi>M</mi></mrow><mo>/</mo><msup><mi>a</mi><mn>2</mn></msup></mrow><mo stretchy="false">⌉</mo></mrow><mn>2</mn></msup></mrow><annotation encoding="application/x-tex">7\lceil 4b^{2}M/a^{2}\rceil^{2}</annotation></semantics></math>, and parameters bounded in absolute value by a constant
depending only on <math id="A5.SS2.p16.m9" class="ltx_Math" alttext="(a,b,d)" display="inline" intent=":literal"><semantics><mrow><mo stretchy="false">(</mo><mi>a</mi><mo>,</mo><mi>b</mi><mo>,</mo><mi>d</mi><mo stretchy="false">)</mo></mrow><annotation encoding="application/x-tex">(a,b,d)</annotation></semantics></math> such that</span></p>
<table id="A5.Ex291" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="A5.Ex291.m1" class="ltx_Math" alttext="\sup_{x\in[da^{2}/2,2db^{2}]}\left|g_{2}(x)-\frac{1}{\sqrt{x}}\right|\lesssim M^{2}2^{-M}." display="block" intent=":literal"><semantics><mrow><mrow><mrow><munder><mo movablelimits="false">sup</mo><mrow><mi>x</mi><mo>∈</mo><mrow><mo stretchy="false">[</mo><mrow><mrow><mrow><mi>d</mi><mo lspace="0em" rspace="0em">​</mo><msup><mi>a</mi><mn>2</mn></msup></mrow><mo>/</mo><mn>2</mn></mrow><mo>,</mo><mrow><mn>2</mn><mo lspace="0em" rspace="0em">​</mo><mi>d</mi><mo lspace="0em" rspace="0em">​</mo><msup><mi>b</mi><mn>2</mn></msup></mrow></mrow><mo stretchy="false">]</mo></mrow></mrow></munder><mrow><mo lspace="0em">|</mo><mrow><mrow><msub><mi>g</mi><mn>2</mn></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>x</mi><mo stretchy="false">)</mo></mrow></mrow><mo>−</mo><mfrac><mn>1</mn><msqrt><mi>x</mi></msqrt></mfrac></mrow><mo>|</mo></mrow></mrow><mo>≲</mo><mrow><msup><mi>M</mi><mn>2</mn></msup><mo lspace="0em" rspace="0em">​</mo><msup><mn>2</mn><mrow><mo>−</mo><mi>M</mi></mrow></msup></mrow></mrow><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">\sup_{x\in[da^{2}/2,2db^{2}]}\left|g_{2}(x)-\frac{1}{\sqrt{x}}\right|\lesssim M^{2}2^{-M}.</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="A5.SS2.p16.3" class="ltx_p"><span id="A5.SS2.p16.3.1" class="ltx_text">Third, applying Lemma <a href="#Thmconj216" title="Lemma 16. ‣ E.2 Construction of multilayer perceptron layers ‣ Appendix E Construction of the Transformer ‣ Generalization Bounds for Transformer-Based Next-Token Prediction in a Language Model" class="ltx_ref"><span class="ltx_text ltx_ref_tag">16</span></a> <math id="A5.SS2.p16.m10" class="ltx_Math" alttext="d" display="inline" intent=":literal"><semantics><mi>d</mi><annotation encoding="application/x-tex">d</annotation></semantics></math> times, multiplying by <math id="A5.SS2.p16.m11" class="ltx_Math" alttext="\delta" display="inline" intent=":literal"><semantics><mi>δ</mi><annotation encoding="application/x-tex">\delta</annotation></semantics></math> at each step, and parallelizing the results, shows the existence of
a multilayer perceptron
<math id="A5.SS2.p16.m12" class="ltx_Math" alttext="g_{3}:\mathbb{R}^{d+1}\rightarrow\mathbb{R}^{d}" display="inline" intent=":literal"><semantics><mrow><msub><mi>g</mi><mn>3</mn></msub><mo lspace="0.278em" rspace="0.278em">:</mo><mrow><msup><mi>ℝ</mi><mrow><mi>d</mi><mo>+</mo><mn>1</mn></mrow></msup><mo stretchy="false">→</mo><msup><mi>ℝ</mi><mi>d</mi></msup></mrow></mrow><annotation encoding="application/x-tex">g_{3}:\mathbb{R}^{d+1}\rightarrow\mathbb{R}^{d}</annotation></semantics></math> with depth <math id="A5.SS2.p16.m13" class="ltx_Math" alttext="M" display="inline" intent=":literal"><semantics><mi>M</mi><annotation encoding="application/x-tex">M</annotation></semantics></math>, width <math id="A5.SS2.p16.m14" class="ltx_Math" alttext="7d" display="inline" intent=":literal"><semantics><mrow><mn>7</mn><mo lspace="0em" rspace="0em">​</mo><mi>d</mi></mrow><annotation encoding="application/x-tex">7d</annotation></semantics></math>, and parameters bounded in absolute value by a constant
depending only on <math id="A5.SS2.p16.m15" class="ltx_Math" alttext="(a,b,\delta,d)" display="inline" intent=":literal"><semantics><mrow><mo stretchy="false">(</mo><mi>a</mi><mo>,</mo><mi>b</mi><mo>,</mo><mi>δ</mi><mo>,</mo><mi>d</mi><mo stretchy="false">)</mo></mrow><annotation encoding="application/x-tex">(a,b,\delta,d)</annotation></semantics></math> such that</span></p>
<table id="A5.Ex292" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="A5.Ex292.m1" class="ltx_math_unparsed" alttext="\sup_{\mathbf{x}\in[-b,b]^{d},y\in[(3db^{2})^{-1/2},(da^{2}/3)^{-1/2}]}\big\|g_{3}(\mathbf{x},y)-(\delta y)\cdot\mathbf{x}\big\|_{\infty}\lesssim 2^{-M}." display="block" intent=":literal"><semantics><mrow><munder><mo movablelimits="false">sup</mo><mrow><mi>𝐱</mi><mo>∈</mo><mo stretchy="false">[</mo><mo lspace="0em">−</mo><mi>b</mi><mo>,</mo><mi>b</mi><mo stretchy="false">]</mo><msup><mrow></mrow><mi>d</mi></msup><mo>,</mo><mi>y</mi><mo>∈</mo><mo stretchy="false">[</mo><mo stretchy="false">(</mo><mn>3</mn><mi>d</mi><mi>b</mi><msup><mrow></mrow><mn>2</mn></msup><mo stretchy="false">)</mo><msup><mrow></mrow><mrow><mo>−</mo><mn>1</mn><mo>/</mo><mn>2</mn></mrow></msup><mo>,</mo><mo stretchy="false">(</mo><mi>d</mi><mi>a</mi><msup><mrow></mrow><mn>2</mn></msup><mo>/</mo><mn>3</mn><mo stretchy="false">)</mo><msup><mrow></mrow><mrow><mo>−</mo><mn>1</mn><mo>/</mo><mn>2</mn></mrow></msup><mo stretchy="false">]</mo></mrow></munder><mo lspace="0em" mathsize="1.200em" rspace="0.167em">∥</mo><msub><mi>g</mi><mn>3</mn></msub><mrow><mo stretchy="false">(</mo><mi>𝐱</mi><mo>,</mo><mi>y</mi><mo stretchy="false">)</mo></mrow><mo>−</mo><mrow><mo stretchy="false">(</mo><mi>δ</mi><mi>y</mi><mo rspace="0.055em" stretchy="false">)</mo></mrow><mo rspace="0.222em">⋅</mo><mi>𝐱</mi><msub><mo lspace="0em" mathsize="1.200em" rspace="0.0835em">∥</mo><mi mathvariant="normal">∞</mi></msub><mo lspace="0.0835em">≲</mo><msup><mn>2</mn><mrow><mo>−</mo><mi>M</mi></mrow></msup><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">\sup_{\mathbf{x}\in[-b,b]^{d},y\in[(3db^{2})^{-1/2},(da^{2}/3)^{-1/2}]}\big\|g_{3}(\mathbf{x},y)-(\delta y)\cdot\mathbf{x}\big\|_{\infty}\lesssim 2^{-M}.</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="A5.SS2.p16.4" class="ltx_p"><span id="A5.SS2.p16.4.1" class="ltx_text">Finally, we consider a multilayer perceptron <math id="A5.SS2.p16.m16" class="ltx_Math" alttext="\mathbf{f}:\mathbb{R}^{d}\rightarrow\mathbb{R}^{d}" display="inline" intent=":literal"><semantics><mrow><mi>𝐟</mi><mo lspace="0.278em" rspace="0.278em">:</mo><mrow><msup><mi>ℝ</mi><mi>d</mi></msup><mo stretchy="false">→</mo><msup><mi>ℝ</mi><mi>d</mi></msup></mrow></mrow><annotation encoding="application/x-tex">\mathbf{f}:\mathbb{R}^{d}\rightarrow\mathbb{R}^{d}</annotation></semantics></math> defined by</span></p>
<table id="A5.Ex293" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="A5.Ex293.m1" class="ltx_Math" alttext="\mathbf{f}(\mathbf{x})\coloneq g_{3}\big(\mathbf{x},g_{2}\circ g_{1}(\mathbf{x})\big)," display="block" intent=":literal"><semantics><mrow><mrow><mrow><mi>𝐟</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>𝐱</mi><mo stretchy="false">)</mo></mrow></mrow><mo>≔</mo><mrow><msub><mi>g</mi><mn>3</mn></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo maxsize="1.200em" minsize="1.200em">(</mo><mi>𝐱</mi><mo>,</mo><mrow><mrow><msub><mi>g</mi><mn>2</mn></msub><mo lspace="0.222em" rspace="0.222em">∘</mo><msub><mi>g</mi><mn>1</mn></msub></mrow><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>𝐱</mi><mo stretchy="false">)</mo></mrow></mrow><mo maxsize="1.200em" minsize="1.200em">)</mo></mrow></mrow></mrow><mo>,</mo></mrow><annotation encoding="application/x-tex">\mathbf{f}(\mathbf{x})\coloneq g_{3}\big(\mathbf{x},g_{2}\circ g_{1}(\mathbf{x})\big),</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="A5.SS2.p16.5" class="ltx_p"><span id="A5.SS2.p16.5.1" class="ltx_text">which has depth <math id="A5.SS2.p16.m17" class="ltx_Math" alttext="\lceil\log_{2}(4b^{2}M/a^{2})\rceil M+2M" display="inline" intent=":literal"><semantics><mrow><mrow><mrow><mo stretchy="false">⌈</mo><mrow><msub><mi>log</mi><mn>2</mn></msub><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mrow><mrow><mn>4</mn><mo lspace="0em" rspace="0em">​</mo><msup><mi>b</mi><mn>2</mn></msup><mo lspace="0em" rspace="0em">​</mo><mi>M</mi></mrow><mo>/</mo><msup><mi>a</mi><mn>2</mn></msup></mrow><mo stretchy="false">)</mo></mrow></mrow><mo stretchy="false">⌉</mo></mrow><mo lspace="0em" rspace="0em">​</mo><mi>M</mi></mrow><mo>+</mo><mrow><mn>2</mn><mo lspace="0em" rspace="0em">​</mo><mi>M</mi></mrow></mrow><annotation encoding="application/x-tex">\lceil\log_{2}(4b^{2}M/a^{2})\rceil M+2M</annotation></semantics></math>, width <math id="A5.SS2.p16.m18" class="ltx_Math" alttext="\max(7d,7\lceil 4b^{2}M/a^{2}\rceil^{2})+d\leq M^{3}" display="inline" intent=":literal"><semantics><mrow><mrow><mrow><mi>max</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mrow><mn>7</mn><mo lspace="0em" rspace="0em">​</mo><mi>d</mi></mrow><mo>,</mo><mrow><mn>7</mn><mo lspace="0em" rspace="0em">​</mo><msup><mrow><mo stretchy="false">⌈</mo><mrow><mrow><mn>4</mn><mo lspace="0em" rspace="0em">​</mo><msup><mi>b</mi><mn>2</mn></msup><mo lspace="0em" rspace="0em">​</mo><mi>M</mi></mrow><mo>/</mo><msup><mi>a</mi><mn>2</mn></msup></mrow><mo stretchy="false">⌉</mo></mrow><mn>2</mn></msup></mrow><mo stretchy="false">)</mo></mrow></mrow><mo>+</mo><mi>d</mi></mrow><mo>≤</mo><msup><mi>M</mi><mn>3</mn></msup></mrow><annotation encoding="application/x-tex">\max(7d,7\lceil 4b^{2}M/a^{2}\rceil^{2})+d\leq M^{3}</annotation></semantics></math>, and parameters bounded in absolute value by a constant
depending only on <math id="A5.SS2.p16.m19" class="ltx_Math" alttext="(a,b,\delta,d)" display="inline" intent=":literal"><semantics><mrow><mo stretchy="false">(</mo><mi>a</mi><mo>,</mo><mi>b</mi><mo>,</mo><mi>δ</mi><mo>,</mo><mi>d</mi><mo stretchy="false">)</mo></mrow><annotation encoding="application/x-tex">(a,b,\delta,d)</annotation></semantics></math>.
Here, the additional <math id="A5.SS2.p16.m20" class="ltx_Math" alttext="d" display="inline" intent=":literal"><semantics><mi>d</mi><annotation encoding="application/x-tex">d</annotation></semantics></math> neurons in each layer are used to preserve the input <math id="A5.SS2.p16.m21" class="ltx_Math" alttext="\mathbf{x}\in[-b,b]^{d}" display="inline" intent=":literal"><semantics><mrow><mi>𝐱</mi><mo>∈</mo><msup><mrow><mo stretchy="false">[</mo><mrow><mrow><mo>−</mo><mi>b</mi></mrow><mo>,</mo><mi>b</mi></mrow><mo stretchy="false">]</mo></mrow><mi>d</mi></msup></mrow><annotation encoding="application/x-tex">\mathbf{x}\in[-b,b]^{d}</annotation></semantics></math> via the equality <math id="A5.SS2.p16.m22" class="ltx_Math" alttext="(x+b)_{+}-b=x" display="inline" intent=":literal"><semantics><mrow><mrow><msub><mrow><mo stretchy="false">(</mo><mrow><mi>x</mi><mo>+</mo><mi>b</mi></mrow><mo stretchy="false">)</mo></mrow><mo>+</mo></msub><mo>−</mo><mi>b</mi></mrow><mo>=</mo><mi>x</mi></mrow><annotation encoding="application/x-tex">(x+b)_{+}-b=x</annotation></semantics></math> for <math id="A5.SS2.p16.m23" class="ltx_Math" alttext="x\in[-b,b]" display="inline" intent=":literal"><semantics><mrow><mi>x</mi><mo>∈</mo><mrow><mo stretchy="false">[</mo><mrow><mrow><mo>−</mo><mi>b</mi></mrow><mo>,</mo><mi>b</mi></mrow><mo stretchy="false">]</mo></mrow></mrow><annotation encoding="application/x-tex">x\in[-b,b]</annotation></semantics></math>.</span></p>
</div>
<div id="A5.SS2.p17" class="ltx_para">
<p id="A5.SS2.p17.1" class="ltx_p"><span id="A5.SS2.p17.1.1" class="ltx_text">For sufficiently large <math id="A5.SS2.p17.m1" class="ltx_Math" alttext="M" display="inline" intent=":literal"><semantics><mi>M</mi><annotation encoding="application/x-tex">M</annotation></semantics></math>, if <math id="A5.SS2.p17.m2" class="ltx_Math" alttext="\mathbf{x}\in\mathbb{B}^{d}(b)\setminus\mathbb{B}^{d}(a)" display="inline" intent=":literal"><semantics><mrow><mi>𝐱</mi><mo>∈</mo><mrow><mrow><msup><mi>𝔹</mi><mi>d</mi></msup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>b</mi><mo stretchy="false">)</mo></mrow></mrow><mo>∖</mo><mrow><msup><mi>𝔹</mi><mi>d</mi></msup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>a</mi><mo stretchy="false">)</mo></mrow></mrow></mrow></mrow><annotation encoding="application/x-tex">\mathbf{x}\in\mathbb{B}^{d}(b)\setminus\mathbb{B}^{d}(a)</annotation></semantics></math>, then we have <math id="A5.SS2.p17.m3" class="ltx_Math" alttext="g_{1}(\mathbf{x})\in[da^{2}/2,2db^{2}]" display="inline" intent=":literal"><semantics><mrow><mrow><msub><mi>g</mi><mn>1</mn></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>𝐱</mi><mo stretchy="false">)</mo></mrow></mrow><mo>∈</mo><mrow><mo stretchy="false">[</mo><mrow><mrow><mrow><mi>d</mi><mo lspace="0em" rspace="0em">​</mo><msup><mi>a</mi><mn>2</mn></msup></mrow><mo>/</mo><mn>2</mn></mrow><mo>,</mo><mrow><mn>2</mn><mo lspace="0em" rspace="0em">​</mo><mi>d</mi><mo lspace="0em" rspace="0em">​</mo><msup><mi>b</mi><mn>2</mn></msup></mrow></mrow><mo stretchy="false">]</mo></mrow></mrow><annotation encoding="application/x-tex">g_{1}(\mathbf{x})\in[da^{2}/2,2db^{2}]</annotation></semantics></math> and <math id="A5.SS2.p17.m4" class="ltx_math_unparsed" alttext="g_{2}\circ g_{1}(\mathbf{x})\in[(3db^{2})^{-1/2},(da^{2}/3)^{-1/2}]" display="inline" intent=":literal"><semantics><mrow><msub><mi>g</mi><mn>2</mn></msub><mo lspace="0.222em" rspace="0.222em">∘</mo><msub><mi>g</mi><mn>1</mn></msub><mrow><mo stretchy="false">(</mo><mi>𝐱</mi><mo stretchy="false">)</mo></mrow><mo>∈</mo><mrow><mo stretchy="false">[</mo><msup><mrow><mo stretchy="false">(</mo><mn>3</mn><mi>d</mi><msup><mi>b</mi><mn>2</mn></msup><mo stretchy="false">)</mo></mrow><mrow><mo>−</mo><mn>1</mn><mo>/</mo><mn>2</mn></mrow></msup><mo>,</mo><msup><mrow><mo stretchy="false">(</mo><mi>d</mi><msup><mi>a</mi><mn>2</mn></msup><mo>/</mo><mn>3</mn><mo stretchy="false">)</mo></mrow><mrow><mo>−</mo><mn>1</mn><mo>/</mo><mn>2</mn></mrow></msup><mo stretchy="false">]</mo></mrow></mrow><annotation encoding="application/x-tex">g_{2}\circ g_{1}(\mathbf{x})\in[(3db^{2})^{-1/2},(da^{2}/3)^{-1/2}]</annotation></semantics></math>.
Thus, the upper bound of the approximation error is given by</span></p>
<table id="A5.EGx122" class="ltx_equationgroup ltx_eqn_align ltx_eqn_table">

<tbody id="A5.Ex294"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_align_right ltx_eqn_cell"><math id="A5.Ex294.m1" class="ltx_Math" alttext="\displaystyle\sup_{\mathbf{x}\in\mathbb{B}^{d}(b)\setminus\mathbb{B}^{d}(a)}\left\|\mathbf{f}(\mathbf{x})-\frac{\delta}{\|\mathbf{x}\|_{2}}\mathbf{x}\right\|_{\infty}" display="inline" intent=":literal"><semantics><mrow><munder><mo movablelimits="false">sup</mo><mrow><mi>𝐱</mi><mo>∈</mo><mrow><mrow><msup><mi>𝔹</mi><mi>d</mi></msup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>b</mi><mo stretchy="false">)</mo></mrow></mrow><mo>∖</mo><mrow><msup><mi>𝔹</mi><mi>d</mi></msup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>a</mi><mo stretchy="false">)</mo></mrow></mrow></mrow></mrow></munder><msub><mrow><mo lspace="0em">‖</mo><mrow><mrow><mi>𝐟</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>𝐱</mi><mo stretchy="false">)</mo></mrow></mrow><mo>−</mo><mrow><mstyle displaystyle="true"><mfrac><mi>δ</mi><msub><mrow><mo stretchy="false">‖</mo><mi>𝐱</mi><mo stretchy="false">‖</mo></mrow><mn>2</mn></msub></mfrac></mstyle><mo lspace="0em" rspace="0em">​</mo><mi>𝐱</mi></mrow></mrow><mo>‖</mo></mrow><mi mathvariant="normal">∞</mi></msub></mrow><annotation encoding="application/x-tex">\displaystyle\sup_{\mathbf{x}\in\mathbb{B}^{d}(b)\setminus\mathbb{B}^{d}(a)}\left\|\mathbf{f}(\mathbf{x})-\frac{\delta}{\|\mathbf{x}\|_{2}}\mathbf{x}\right\|_{\infty}</annotation></semantics></math></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A5.Ex294.m2" class="ltx_Math" alttext="\displaystyle=\sup_{\mathbf{x}\in\mathbb{B}^{d}(b)\setminus\mathbb{B}^{d}(a)}\left\|\mathbf{g}_{3}\Big(\operatorname{stack}\big(\mathbf{x},g_{2}\circ g_{1}(\mathbf{x})\big)\Big)-\frac{\delta}{\|\mathbf{x}\|_{2}}\mathbf{x}\right\|_{\infty}" display="inline" intent=":literal"><semantics><mrow><mphantom></mphantom><mo rspace="0.1389em">=</mo><mrow><munder><mo lspace="0.1389em" movablelimits="false" rspace="0em">sup</mo><mrow><mi>𝐱</mi><mo>∈</mo><mrow><mrow><msup><mi>𝔹</mi><mi>d</mi></msup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>b</mi><mo stretchy="false">)</mo></mrow></mrow><mo>∖</mo><mrow><msup><mi>𝔹</mi><mi>d</mi></msup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>a</mi><mo stretchy="false">)</mo></mrow></mrow></mrow></mrow></munder><msub><mrow><mo>‖</mo><mrow><mrow><msub><mi>𝐠</mi><mn>3</mn></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo maxsize="1.600em" minsize="1.600em">(</mo><mrow><mi>stack</mi><mo>⁡</mo><mrow><mo maxsize="1.200em" minsize="1.200em">(</mo><mi>𝐱</mi><mo>,</mo><mrow><mrow><msub><mi>g</mi><mn>2</mn></msub><mo lspace="0.222em" rspace="0.222em">∘</mo><msub><mi>g</mi><mn>1</mn></msub></mrow><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>𝐱</mi><mo stretchy="false">)</mo></mrow></mrow><mo maxsize="1.200em" minsize="1.200em">)</mo></mrow></mrow><mo maxsize="1.600em" minsize="1.600em">)</mo></mrow></mrow><mo>−</mo><mrow><mstyle displaystyle="true"><mfrac><mi>δ</mi><msub><mrow><mo stretchy="false">‖</mo><mi>𝐱</mi><mo stretchy="false">‖</mo></mrow><mn>2</mn></msub></mfrac></mstyle><mo lspace="0em" rspace="0em">​</mo><mi>𝐱</mi></mrow></mrow><mo>‖</mo></mrow><mi mathvariant="normal">∞</mi></msub></mrow></mrow><annotation encoding="application/x-tex">\displaystyle=\sup_{\mathbf{x}\in\mathbb{B}^{d}(b)\setminus\mathbb{B}^{d}(a)}\left\|\mathbf{g}_{3}\Big(\operatorname{stack}\big(\mathbf{x},g_{2}\circ g_{1}(\mathbf{x})\big)\Big)-\frac{\delta}{\|\mathbf{x}\|_{2}}\mathbf{x}\right\|_{\infty}</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
<tbody id="A5.Ex295"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_eqn_cell"></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A5.Ex295.m1" class="ltx_Math" alttext="\displaystyle\leq\sup_{\mathbf{x}\in\mathbb{B}^{d}(b)\setminus\mathbb{B}^{d}(a)}\left\|\mathbf{g}_{3}\Big(\operatorname{stack}\big(\mathbf{x},g_{2}\circ g_{1}(\mathbf{x})\big)\Big)-\delta\big(g_{2}\circ g_{1}(\mathbf{x})\big)\mathbf{x}\right\|_{\infty}" display="inline" intent=":literal"><semantics><mrow><mphantom></mphantom><mo rspace="0.1389em">≤</mo><mrow><munder><mo lspace="0.1389em" movablelimits="false" rspace="0em">sup</mo><mrow><mi>𝐱</mi><mo>∈</mo><mrow><mrow><msup><mi>𝔹</mi><mi>d</mi></msup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>b</mi><mo stretchy="false">)</mo></mrow></mrow><mo>∖</mo><mrow><msup><mi>𝔹</mi><mi>d</mi></msup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>a</mi><mo stretchy="false">)</mo></mrow></mrow></mrow></mrow></munder><msub><mrow><mo>‖</mo><mrow><mrow><msub><mi>𝐠</mi><mn>3</mn></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo maxsize="1.600em" minsize="1.600em">(</mo><mrow><mi>stack</mi><mo>⁡</mo><mrow><mo maxsize="1.200em" minsize="1.200em">(</mo><mi>𝐱</mi><mo>,</mo><mrow><mrow><msub><mi>g</mi><mn>2</mn></msub><mo lspace="0.222em" rspace="0.222em">∘</mo><msub><mi>g</mi><mn>1</mn></msub></mrow><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>𝐱</mi><mo stretchy="false">)</mo></mrow></mrow><mo maxsize="1.200em" minsize="1.200em">)</mo></mrow></mrow><mo maxsize="1.600em" minsize="1.600em">)</mo></mrow></mrow><mo>−</mo><mrow><mrow><mi>δ</mi><mo>⁡</mo><mrow><mo maxsize="1.200em" minsize="1.200em">(</mo><mrow><mrow><msub><mi>g</mi><mn>2</mn></msub><mo lspace="0.222em" rspace="0.222em">∘</mo><msub><mi>g</mi><mn>1</mn></msub></mrow><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>𝐱</mi><mo stretchy="false">)</mo></mrow></mrow><mo maxsize="1.200em" minsize="1.200em">)</mo></mrow></mrow><mo lspace="0em" rspace="0em">​</mo><mi>𝐱</mi></mrow></mrow><mo>‖</mo></mrow><mi mathvariant="normal">∞</mi></msub></mrow></mrow><annotation encoding="application/x-tex">\displaystyle\leq\sup_{\mathbf{x}\in\mathbb{B}^{d}(b)\setminus\mathbb{B}^{d}(a)}\left\|\mathbf{g}_{3}\Big(\operatorname{stack}\big(\mathbf{x},g_{2}\circ g_{1}(\mathbf{x})\big)\Big)-\delta\big(g_{2}\circ g_{1}(\mathbf{x})\big)\mathbf{x}\right\|_{\infty}</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
<tbody id="A5.Ex296"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_eqn_cell"></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A5.Ex296.m1" class="ltx_math_unparsed" alttext="\displaystyle\quad+\sup_{\mathbf{x}\in\mathbb{B}^{d}(b)\setminus\mathbb{B}^{d}(a)}\left\|\delta\big(g_{2}\circ g_{1}(\mathbf{x})\big)\mathbf{x}-\delta\big(g_{1}(\mathbf{x})\big)^{-1/2}\mathbf{x}\right\|_{\infty}" display="inline" intent=":literal"><semantics><mrow><mo>+</mo><munder><mo lspace="0em" movablelimits="false" rspace="0em">sup</mo><mrow><mi>𝐱</mi><mo>∈</mo><mrow><mrow><msup><mi>𝔹</mi><mi>d</mi></msup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>b</mi><mo stretchy="false">)</mo></mrow></mrow><mo>∖</mo><mrow><msup><mi>𝔹</mi><mi>d</mi></msup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>a</mi><mo stretchy="false">)</mo></mrow></mrow></mrow></mrow></munder><msub><mrow><mo>‖</mo><mi>δ</mi><mrow><mo maxsize="1.200em" minsize="1.200em">(</mo><msub><mi>g</mi><mn>2</mn></msub><mo lspace="0.222em" rspace="0.222em">∘</mo><msub><mi>g</mi><mn>1</mn></msub><mrow><mo stretchy="false">(</mo><mi>𝐱</mi><mo stretchy="false">)</mo></mrow><mo maxsize="1.200em" minsize="1.200em">)</mo></mrow><mi>𝐱</mi><mo>−</mo><mi>δ</mi><msup><mrow><mo maxsize="1.200em" minsize="1.200em">(</mo><msub><mi>g</mi><mn>1</mn></msub><mrow><mo stretchy="false">(</mo><mi>𝐱</mi><mo stretchy="false">)</mo></mrow><mo maxsize="1.200em" minsize="1.200em">)</mo></mrow><mrow><mo>−</mo><mn>1</mn><mo>/</mo><mn>2</mn></mrow></msup><mi>𝐱</mi><mo>‖</mo></mrow><mi mathvariant="normal">∞</mi></msub></mrow><annotation encoding="application/x-tex">\displaystyle\quad+\sup_{\mathbf{x}\in\mathbb{B}^{d}(b)\setminus\mathbb{B}^{d}(a)}\left\|\delta\big(g_{2}\circ g_{1}(\mathbf{x})\big)\mathbf{x}-\delta\big(g_{1}(\mathbf{x})\big)^{-1/2}\mathbf{x}\right\|_{\infty}</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
<tbody id="A5.Ex297"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_eqn_cell"></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A5.Ex297.m1" class="ltx_math_unparsed" alttext="\displaystyle\quad+\sup_{\mathbf{x}\in\mathbb{B}^{d}(b)\setminus\mathbb{B}^{d}(a)}\left\|\delta\big(g_{1}(\mathbf{x})\big)^{-1/2}\mathbf{x}-\delta\big(\|\mathbf{x}\|_{2}^{2}\big)^{-1/2}\cdot\mathbf{x}\right\|_{\infty}" display="inline" intent=":literal"><semantics><mrow><mo>+</mo><munder><mo lspace="0em" movablelimits="false" rspace="0em">sup</mo><mrow><mi>𝐱</mi><mo>∈</mo><mrow><mrow><msup><mi>𝔹</mi><mi>d</mi></msup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>b</mi><mo stretchy="false">)</mo></mrow></mrow><mo>∖</mo><mrow><msup><mi>𝔹</mi><mi>d</mi></msup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>a</mi><mo stretchy="false">)</mo></mrow></mrow></mrow></mrow></munder><msub><mrow><mo>‖</mo><mi>δ</mi><msup><mrow><mo maxsize="1.200em" minsize="1.200em">(</mo><msub><mi>g</mi><mn>1</mn></msub><mrow><mo stretchy="false">(</mo><mi>𝐱</mi><mo stretchy="false">)</mo></mrow><mo maxsize="1.200em" minsize="1.200em">)</mo></mrow><mrow><mo>−</mo><mn>1</mn><mo>/</mo><mn>2</mn></mrow></msup><mi>𝐱</mi><mo>−</mo><mi>δ</mi><msup><mrow><mo maxsize="1.200em" minsize="1.200em">(</mo><mo lspace="0em" rspace="0.167em">∥</mo><mi>𝐱</mi><msubsup><mo lspace="0em" rspace="0.167em">∥</mo><mn>2</mn><mn>2</mn></msubsup><mo maxsize="1.200em" minsize="1.200em" rspace="0.055em">)</mo></mrow><mrow><mo>−</mo><mn>1</mn><mo>/</mo><mn>2</mn></mrow></msup><mo rspace="0.222em">⋅</mo><mi>𝐱</mi><mo>‖</mo></mrow><mi mathvariant="normal">∞</mi></msub></mrow><annotation encoding="application/x-tex">\displaystyle\quad+\sup_{\mathbf{x}\in\mathbb{B}^{d}(b)\setminus\mathbb{B}^{d}(a)}\left\|\delta\big(g_{1}(\mathbf{x})\big)^{-1/2}\mathbf{x}-\delta\big(\|\mathbf{x}\|_{2}^{2}\big)^{-1/2}\cdot\mathbf{x}\right\|_{\infty}</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
<tbody id="A5.Ex298"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_eqn_cell"></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A5.Ex298.m1" class="ltx_Math" alttext="\displaystyle\lesssim 2^{-M}+M^{2}2^{-M}+2^{-M}\lesssim M^{2}2^{-M}." display="inline" intent=":literal"><semantics><mrow><mrow><mphantom></mphantom><mo>≲</mo><mrow><msup><mn>2</mn><mrow><mo>−</mo><mi>M</mi></mrow></msup><mo>+</mo><mrow><msup><mi>M</mi><mn>2</mn></msup><mo lspace="0em" rspace="0em">​</mo><msup><mn>2</mn><mrow><mo>−</mo><mi>M</mi></mrow></msup></mrow><mo>+</mo><msup><mn>2</mn><mrow><mo>−</mo><mi>M</mi></mrow></msup></mrow><mo>≲</mo><mrow><msup><mi>M</mi><mn>2</mn></msup><mo lspace="0em" rspace="0em">​</mo><msup><mn>2</mn><mrow><mo>−</mo><mi>M</mi></mrow></msup></mrow></mrow><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">\displaystyle\lesssim 2^{-M}+M^{2}2^{-M}+2^{-M}\lesssim M^{2}2^{-M}.</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="A5.SS2.p17.2" class="ltx_p"><span id="A5.SS2.p17.2.1" class="ltx_text">∎</span></p>
</div>
