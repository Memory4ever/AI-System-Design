</msqrt><mi>λ</mi></mfrac></mtd></mtr><mtr><mtd><mrow><msup><mi>T</mi><mn>3</mn></msup><mo lspace="0.170em" rspace="0em">​</mo><mi>𝕀</mi><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mrow><mi>t</mi><mo>∈</mo><mrow><mo stretchy="false">[</mo><mrow><mrow><msup><mi>log</mi><mn>2</mn></msup><mo lspace="0.167em">⁡</mo><mi>T</mi></mrow><mo>,</mo><mrow><mi>T</mi><mo>−</mo><mrow><msup><mi>log</mi><mn>2</mn></msup><mo lspace="0.167em">⁡</mo><mi>T</mi></mrow></mrow></mrow><mo stretchy="false">]</mo></mrow></mrow><mo stretchy="false">)</mo></mrow></mrow></mtd></mtr><mtr><mtd><msub><mn>𝟎</mn><mrow><mi>N</mi><mo>−</mo><msub><mi>m</mi><mn>1</mn></msub><mo>−</mo><mrow><mrow><mo stretchy="false">(</mo><mrow><msub><mi>r</mi><mn>2</mn></msub><mo>+</mo><mn>1</mn></mrow><mo stretchy="false">)</mo></mrow><mo lspace="0em" rspace="0em">​</mo><msub><mi>m</mi><mn>2</mn></msub></mrow><mo>−</mo><mn>2</mn></mrow></msub></mtd></mtr></mtable><mo>)</mo></mrow><mrow><mi>t</mi><mo>∈</mo><mrow><mo stretchy="false">[</mo><mi>T</mi><mo stretchy="false">]</mo></mrow></mrow></msub></mrow><annotation encoding="application/x-tex">\displaystyle=\left(\begin{matrix}\mathbf{g}_{0}(\mathbf{Z}_{1,t+1})\\
