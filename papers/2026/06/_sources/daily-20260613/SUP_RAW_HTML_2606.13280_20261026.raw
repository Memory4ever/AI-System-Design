<td class="ltx_td ltx_align_right ltx_eqn_cell"><math id="A3.E39.m1" class="ltx_Math" alttext="\displaystyle\sup_{\mathbf{f}_{\bm{\theta}},\mathbf{f}_{\bm{\theta}^{\prime}}\in\mathcal{MLP}(d,q,L,N,B),\,\bm{\theta}\neq\bm{\theta}^{\prime}}\,\frac{\|\mathbf{f}_{\bm{\theta}}-\mathbf{f}_{\bm{\theta}^{\prime}}\|_{L^{\infty}([-A,A]^{d})}}{\|\bm{\theta}-\bm{\theta}^{\prime}\|_{\infty}}" display="inline" intent=":literal"><semantics><mrow><munder><mo movablelimits="false">sup</mo><mrow><mrow><mrow><msub><mi>𝐟</mi><mi>𝜽</mi></msub><mo>,</mo><msub><mi>𝐟</mi><msup><mi>𝜽</mi><mo>′</mo></msup></msub></mrow><mo>∈</mo><mrow><mi class="ltx_font_mathcaligraphic">ℳ</mi><mo lspace="0em" rspace="0em">​</mo><mi class="ltx_font_mathcaligraphic">ℒ</mi><mo lspace="0em" rspace="0em">​</mo><mi class="ltx_font_mathcaligraphic">𝒫</mi><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>d</mi><mo>,</mo><mi>q</mi><mo>,</mo><mi>L</mi><mo>,</mo><mi>N</mi><mo>,</mo><mi>B</mi><mo stretchy="false">)</mo></mrow></mrow></mrow><mo rspace="0.337em">,</mo><mrow><mi>𝜽</mi><mo>≠</mo><msup><mi>𝜽</mi><mo>′</mo></msup></mrow></mrow></munder><mstyle displaystyle="true"><mfrac><msub><mrow><mo stretchy="false">‖</mo><mrow><msub><mi>𝐟</mi><mi>𝜽</mi></msub><mo>−</mo><msub><mi>𝐟</mi><msup><mi>𝜽</mi><mo>′</mo></msup></msub></mrow><mo stretchy="false">‖</mo></mrow><mrow><msup><mi>L</mi><mi mathvariant="normal">∞</mi></msup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msup><mrow><mo stretchy="false">[</mo><mrow><mrow><mo>−</mo><mi>A</mi></mrow><mo>,</mo><mi>A</mi></mrow><mo stretchy="false">]</mo></mrow><mi>d</mi></msup><mo stretchy="false">)</mo></mrow></mrow></msub><msub><mrow><mo stretchy="false">‖</mo><mrow><mi>𝜽</mi><mo>−</mo><msup><mi>𝜽</mi><mo>′</mo></msup></mrow><mo stretchy="false">‖</mo></mrow><mi mathvariant="normal">∞</mi></msub></mfrac></mstyle></mrow><annotation encoding="application/x-tex">\displaystyle\sup_{\mathbf{f}_{\bm{\theta}},\mathbf{f}_{\bm{\theta}^{\prime}}\in\mathcal{MLP}(d,q,L,N,B),\,\bm{\theta}\neq\bm{\theta}^{\prime}}\,\frac{\|\mathbf{f}_{\bm{\theta}}-\mathbf{f}_{\bm{\theta}^{\prime}}\|_{L^{\infty}([-A,A]^{d})}}{\|\bm{\theta}-\bm{\theta}^{\prime}\|_{\infty}}</annotation></semantics></math></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A3.E39.m2" class="ltx_Math" alttext="\displaystyle\leq 6A\big(B(N+1)\big)^{2L+1}." display="inline" intent=":literal"><semantics><mrow><mrow><mphantom></mphantom><mo>≤</mo><mrow><mn>6</mn><mo lspace="0em" rspace="0em">​</mo><mi>A</mi><mo lspace="0em" rspace="0em">​</mo><msup><mrow><mo maxsize="1.200em" minsize="1.200em">(</mo><mrow><mi>B</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mrow><mi>N</mi><mo>+</mo><mn>1</mn></mrow><mo stretchy="false">)</mo></mrow></mrow><mo maxsize="1.200em" minsize="1.200em">)</mo></mrow><mrow><mrow><mn>2</mn><mo lspace="0em" rspace="0em">​</mo><mi>L</mi></mrow><mo>+</mo><mn>1</mn></mrow></msup></mrow></mrow><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">\displaystyle\leq 6A\big(B(N+1)\big)^{2L+1}.</annotation></semantics></math></td>
