<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A4.Ex158.m1" class="ltx_Math" alttext="\displaystyle=\tilde{O}\Big((N_{\mathrm{mlp}})^{-\frac{2\beta_{1}}{m_{1}r_{1}}}+\lambda^{2\beta_{2}}+\frac{1}{T\varphi_{W}(\lambda)^{r_{2}}}+\kappa_{W}^{2}\Big)." display="inline" intent=":literal"><semantics><mrow><mrow><mphantom></mphantom><mo>=</mo><mrow><mover accent="true"><mi>O</mi><mo>~</mo></mover><mo lspace="0em" rspace="0em">​</mo><mrow><mo maxsize="1.600em" minsize="1.600em">(</mo><mrow><msup><mrow><mo stretchy="false">(</mo><msub><mi>N</mi><mi>mlp</mi></msub><mo stretchy="false">)</mo></mrow><mrow><mo>−</mo><mfrac><mrow><mn>2</mn><mo lspace="0em" rspace="0em">​</mo><msub><mi>β</mi><mn>1</mn></msub></mrow><mrow><msub><mi>m</mi><mn>1</mn></msub><mo lspace="0em" rspace="0em">​</mo><msub><mi>r</mi><mn>1</mn></msub></mrow></mfrac></mrow></msup><mo>+</mo><msup><mi>λ</mi><mrow><mn>2</mn><mo lspace="0em" rspace="0em">​</mo><msub><mi>β</mi><mn>2</mn></msub></mrow></msup><mo>+</mo><mstyle displaystyle="true"><mfrac><mn>1</mn><mrow><mi>T</mi><mo lspace="0em" rspace="0em">​</mo><msub><mi>φ</mi><mi>W</mi></msub><mo lspace="0em" rspace="0em">​</mo><msup><mrow><mo stretchy="false">(</mo><mi>λ</mi><mo stretchy="false">)</mo></mrow><msub><mi>r</mi><mn>2</mn></msub></msup></mrow></mfrac></mstyle><mo>+</mo><msubsup><mi>κ</mi><mi>W</mi><mn>2</mn></msubsup></mrow><mo maxsize="1.600em" minsize="1.600em">)</mo></mrow></mrow></mrow><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">\displaystyle=\tilde{O}\Big((N_{\mathrm{mlp}})^{-\frac{2\beta_{1}}{m_{1}r_{1}}}+\lambda^{2\beta_{2}}+\frac{1}{T\varphi_{W}(\lambda)^{r_{2}}}+\kappa_{W}^{2}\Big).</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="A4.p3.7" class="ltx_p"><span id="A4.p3.7.1" class="ltx_text">By considering the decoding matrix</span></p>
<table id="A4.Ex159" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="A4.Ex159.m1" class="ltx_Math" alttext="D\coloneq\left[\begin{matrix}\bm{\phi}_{1}(\mathbf{e}_{1})&amp;\bm{\phi}_{1}(\mathbf{e}_{2})&amp;\cdots&amp;\bm{\phi}_{1}(\mathbf{e}_{W})\\
\bm{\phi}_{2}(\mathbf{e}_{1})&amp;\bm{\phi}_{2}(\mathbf{e}_{2})&amp;\cdots&amp;\bm{\phi}_{2}(\mathbf{e}_{W})\\
\bm{0}_{N-m_{1}-m_{2}}&amp;\bm{0}_{N-m_{1}-m_{2}}&amp;\cdots&amp;\bm{0}_{N-m_{1}-m_{2}}\end{matrix}\right]^{\top}=\left[\begin{matrix}\bm{\phi}_{1}(\mathbf{e}_{1})^{\top}&amp;\bm{\phi}_{2}(\mathbf{e}_{1})^{\top}&amp;\bm{0}_{N-m_{1}-m_{2}}^{\top}\\
\bm{\phi}_{1}(\mathbf{e}_{2})^{\top}&amp;\bm{\phi}_{2}(\mathbf{e}_{2})^{\top}&amp;\bm{0}_{N-m_{1}-m_{2}}^{\top}\\
\vdots&amp;\vdots&amp;\vdots\\
\bm{\phi}_{1}(\mathbf{e}_{W})^{\top}&amp;\bm{\phi}_{2}(\mathbf{e}_{W})^{\top}&amp;\bm{0}_{N-m_{1}-m_{2}}^{\top}\end{matrix}\right]" display="block" intent=":literal"><semantics><mrow><mi>D</mi><mo>≔</mo><msup><mrow><mo>[</mo><mtable columnspacing="5pt" displaystyle="true" rowspacing="0pt"><mtr><mtd><mrow><msub><mi class="ltx_mathvariant_bold-italic" mathvariant="bold-italic">ϕ</mi><mn>1</mn></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mi>𝐞</mi><mn>1</mn></msub><mo stretchy="false">)</mo></mrow></mrow></mtd><mtd><mrow><msub><mi class="ltx_mathvariant_bold-italic" mathvariant="bold-italic">ϕ</mi><mn>1</mn></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mi>𝐞</mi><mn>2</mn></msub><mo stretchy="false">)</mo></mrow></mrow></mtd><mtd><mo>⋯</mo></mtd><mtd><mrow><msub><mi class="ltx_mathvariant_bold-italic" mathvariant="bold-italic">ϕ</mi><mn>1</mn></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mi>𝐞</mi><mi>W</mi></msub><mo stretchy="false">)</mo></mrow></mrow></mtd></mtr><mtr><mtd><mrow><msub><mi class="ltx_mathvariant_bold-italic" mathvariant="bold-italic">ϕ</mi><mn>2</mn></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mi>𝐞</mi><mn>1</mn></msub><mo stretchy="false">)</mo></mrow></mrow></mtd><mtd><mrow><msub><mi class="ltx_mathvariant_bold-italic" mathvariant="bold-italic">ϕ</mi><mn>2</mn></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mi>𝐞</mi><mn>2</mn></msub><mo stretchy="false">)</mo></mrow></mrow></mtd><mtd><mo>⋯</mo></mtd><mtd><mrow><msub><mi class="ltx_mathvariant_bold-italic" mathvariant="bold-italic">ϕ</mi><mn>2</mn></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mi>𝐞</mi><mi>W</mi></msub><mo stretchy="false">)</mo></mrow></mrow></mtd></mtr><mtr><mtd><msub><mn>𝟎</mn><mrow><mi>N</mi><mo>−</mo><msub><mi>m</mi><mn>1</mn></msub><mo>−</mo><msub><mi>m</mi><mn>2</mn></msub></mrow></msub></mtd><mtd><msub><mn>𝟎</mn><mrow><mi>N</mi><mo>−</mo><msub><mi>m</mi><mn>1</mn></msub><mo>−</mo><msub><mi>m</mi><mn>2</mn></msub></mrow></msub></mtd><mtd><mo>⋯</mo></mtd><mtd><msub><mn>𝟎</mn><mrow><mi>N</mi><mo>−</mo><msub><mi>m</mi><mn>1</mn></msub><mo>−</mo><msub><mi>m</mi><mn>2</mn></msub></mrow></msub></mtd></mtr></mtable><mo>]</mo></mrow><mo>⊤</mo></msup><mo>=</mo><mrow><mo>[</mo><mtable columnspacing="5pt" displaystyle="true" rowspacing="0pt"><mtr><mtd><mrow><msub><mi class="ltx_mathvariant_bold-italic" mathvariant="bold-italic">ϕ</mi><mn>1</mn></msub><mo lspace="0em" rspace="0em">​</mo><msup><mrow><mo stretchy="false">(</mo><msub><mi>𝐞</mi><mn>1</mn></msub><mo stretchy="false">)</mo></mrow><mo>⊤</mo></msup></mrow></mtd><mtd><mrow><msub><mi class="ltx_mathvariant_bold-italic" mathvariant="bold-italic">ϕ</mi><mn>2</mn></msub><mo lspace="0em" rspace="0em">​</mo><msup><mrow><mo stretchy="false">(</mo><msub><mi>𝐞</mi><mn>1</mn></msub><mo stretchy="false">)</mo></mrow><mo>⊤</mo></msup></mrow></mtd><mtd><msubsup><mn>𝟎</mn><mrow><mi>N</mi><mo>−</mo><msub><mi>m</mi><mn>1</mn></msub><mo>−</mo><msub><mi>m</mi><mn>2</mn></msub></mrow><mo>⊤</mo></msubsup></mtd></mtr><mtr><mtd><mrow><msub><mi class="ltx_mathvariant_bold-italic" mathvariant="bold-italic">ϕ</mi><mn>1</mn></msub><mo lspace="0em" rspace="0em">​</mo><msup><mrow><mo stretchy="false">(</mo><msub><mi>𝐞</mi><mn>2</mn></msub><mo stretchy="false">)</mo></mrow><mo>⊤</mo></msup></mrow></mtd><mtd><mrow><msub><mi class="ltx_mathvariant_bold-italic" mathvariant="bold-italic">ϕ</mi><mn>2</mn></msub><mo lspace="0em" rspace="0em">​</mo><msup><mrow><mo stretchy="false">(</mo><msub><mi>𝐞</mi><mn>2</mn></msub><mo stretchy="false">)</mo></mrow><mo>⊤</mo></msup></mrow></mtd><mtd><msubsup><mn>𝟎</mn><mrow><mi>N</mi><mo>−</mo><msub><mi>m</mi><mn>1</mn></msub><mo>−</mo><msub><mi>m</mi><mn>2</mn></msub></mrow><mo>⊤</mo></msubsup></mtd></mtr><mtr><mtd></mtd><mtd></mtd><mtd></mtd></mtr><mtr><mtd><mrow><msub><mi class="ltx_mathvariant_bold-italic" mathvariant="bold-italic">ϕ</mi><mn>1</mn></msub><mo lspace="0em" rspace="0em">​</mo><msup><mrow><mo stretchy="false">(</mo><msub><mi>𝐞</mi><mi>W</mi></msub><mo stretchy="false">)</mo></mrow><mo>⊤</mo></msup></mrow></mtd><mtd><mrow><msub><mi class="ltx_mathvariant_bold-italic" mathvariant="bold-italic">ϕ</mi><mn>2</mn></msub><mo lspace="0em" rspace="0em">​</mo><msup><mrow><mo stretchy="false">(</mo><msub><mi>𝐞</mi><mi>W</mi></msub><mo stretchy="false">)</mo></mrow><mo>⊤</mo></msup></mrow></mtd><mtd><msubsup><mn>𝟎</mn><mrow><mi>N</mi><mo>−</mo><msub><mi>m</mi><mn>1</mn></msub><mo>−</mo><msub><mi>m</mi><mn>2</mn></msub></mrow><mo>⊤</mo></msubsup></mtd></mtr></mtable><mo>]</mo></mrow></mrow><annotation encoding="application/x-tex">D\coloneq\left[\begin{matrix}\bm{\phi}_{1}(\mathbf{e}_{1})&amp;\bm{\phi}_{1}(\mathbf{e}_{2})&amp;\cdots&amp;\bm{\phi}_{1}(\mathbf{e}_{W})\\
\bm{\phi}_{2}(\mathbf{e}_{1})&amp;\bm{\phi}_{2}(\mathbf{e}_{2})&amp;\cdots&amp;\bm{\phi}_{2}(\mathbf{e}_{W})\\
\bm{0}_{N-m_{1}-m_{2}}&amp;\bm{0}_{N-m_{1}-m_{2}}&amp;\cdots&amp;\bm{0}_{N-m_{1}-m_{2}}\end{matrix}\right]^{\top}=\left[\begin{matrix}\bm{\phi}_{1}(\mathbf{e}_{1})^{\top}&amp;\bm{\phi}_{2}(\mathbf{e}_{1})^{\top}&amp;\bm{0}_{N-m_{1}-m_{2}}^{\top}\\
\bm{\phi}_{1}(\mathbf{e}_{2})^{\top}&amp;\bm{\phi}_{2}(\mathbf{e}_{2})^{\top}&amp;\bm{0}_{N-m_{1}-m_{2}}^{\top}\\
\vdots&amp;\vdots&amp;\vdots\\
\bm{\phi}_{1}(\mathbf{e}_{W})^{\top}&amp;\bm{\phi}_{2}(\mathbf{e}_{W})^{\top}&amp;\bm{0}_{N-m_{1}-m_{2}}^{\top}\end{matrix}\right]</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="A4.p3.8" class="ltx_p"><span id="A4.p3.8.1" class="ltx_text">and noticing that <math id="A4.p3.m22" class="ltx_Math" alttext="M\geq\delta_{1}m_{1}+\delta_{2}\geq\max_{w\in[W]}|\mathbf{g}_{0}(\mathbf{Z}_{1,T})^{\top}\bm{\phi}_{1}(\mathbf{e}_{w})+\mathbf{h}(\mathbf{Z}_{2,T})^{\top}\bm{\phi}_{2}(\mathbf{e}_{w})|" display="inline" intent=":literal"><semantics><mrow><mi>M</mi><mo>≥</mo><mrow><mrow><msub><mi>δ</mi><mn>1</mn></msub><mo lspace="0em" rspace="0em">​</mo><msub><mi>m</mi><mn>1</mn></msub></mrow><mo>+</mo><msub><mi>δ</mi><mn>2</mn></msub></mrow><mo>≥</mo><mrow><msub><mi>max</mi><mrow><mi>w</mi><mo>∈</mo><mrow><mo stretchy="false">[</mo><mi>W</mi><mo stretchy="false">]</mo></mrow></mrow></msub><mo>⁡</mo><mrow><mo stretchy="false">|</mo><mrow><mrow><msub><mi>𝐠</mi><mn>0</mn></msub><mo lspace="0em" rspace="0em">​</mo><msup><mrow><mo stretchy="false">(</mo><msub><mi>𝐙</mi><mrow><mn>1</mn><mo>,</mo><mi>T</mi></mrow></msub><mo stretchy="false">)</mo></mrow><mo>⊤</mo></msup><mo lspace="0em" rspace="0em">​</mo><msub><mi class="ltx_mathvariant_bold-italic" mathvariant="bold-italic">ϕ</mi><mn>1</mn></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mi>𝐞</mi><mi>w</mi></msub><mo stretchy="false">)</mo></mrow></mrow><mo>+</mo><mrow><mi>𝐡</mi><mo lspace="0em" rspace="0em">​</mo><msup><mrow><mo stretchy="false">(</mo><msub><mi>𝐙</mi><mrow><mn>2</mn><mo>,</mo><mi>T</mi></mrow></msub><mo stretchy="false">)</mo></mrow><mo>⊤</mo></msup><mo lspace="0em" rspace="0em">​</mo><msub><mi class="ltx_mathvariant_bold-italic" mathvariant="bold-italic">ϕ</mi><mn>2</mn></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mi>𝐞</mi><mi>w</mi></msub><mo stretchy="false">)</mo></mrow></mrow></mrow><mo stretchy="false">|</mo></mrow></mrow></mrow><annotation encoding="application/x-tex">M\geq\delta_{1}m_{1}+\delta_{2}\geq\max_{w\in[W]}|\mathbf{g}_{0}(\mathbf{Z}_{1,T})^{\top}\bm{\phi}_{1}(\mathbf{e}_{w})+\mathbf{h}(\mathbf{Z}_{2,T})^{\top}\bm{\phi}_{2}(\mathbf{e}_{w})|</annotation></semantics></math>, we obtain the assertion of Theorem <a href="#Thmconj24" title="Theorem 4. ‣ 4.1 Proof of the risk bound ‣ 4 Risk bound ‣ Generalization Bounds for Transformer-Based Next-Token Prediction in a Language Model" class="ltx_ref"><span class="ltx_text ltx_ref_tag">4</span></a> by</span></p>
<table id="A4.EGx86" class="ltx_equationgroup ltx_eqn_align ltx_eqn_table">

<tbody id="A4.Ex160"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_eqn_cell"></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A4.Ex160.m1" class="ltx_Math" alttext="\displaystyle\mathbb{E}\Big[\|\mathbf{f}^{*}(\mathbf{X})-\mathbf{f}_{0}(\mathbf{h},\mathbf{X})\|_{\infty}^{2}\,\Big|\,\mathbf{h}\Big]" display="inline" intent=":literal"><semantics><mrow><mi>𝔼</mi><mo>⁡</mo><mrow><mo maxsize="1.600em" minsize="1.600em">[</mo><mrow><msubsup><mrow><mo stretchy="false">‖</mo><mrow><mrow><msup><mi>𝐟</mi><mo>∗</mo></msup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>𝐗</mi><mo stretchy="false">)</mo></mrow></mrow><mo>−</mo><mrow><msub><mi>𝐟</mi><mn>0</mn></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>𝐡</mi><mo>,</mo><mi>𝐗</mi><mo stretchy="false">)</mo></mrow></mrow></mrow><mo stretchy="false">‖</mo></mrow><mi mathvariant="normal">∞</mi><mn>2</mn></msubsup><mo fence="false" maxsize="1.600em" minsize="1.600em" rspace="0.337em" stretchy="true">|</mo><mi>𝐡</mi></mrow><mo maxsize="1.600em" minsize="1.600em">]</mo></mrow></mrow><annotation encoding="application/x-tex">\displaystyle\mathbb{E}\Big[\|\mathbf{f}^{*}(\mathbf{X})-\mathbf{f}_{0}(\mathbf{h},\mathbf{X})\|_{\infty}^{2}\,\Big|\,\mathbf{h}\Big]</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
<tbody id="A4.Ex161"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_eqn_cell"></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A4.Ex161.m1" class="ltx_math_unparsed" alttext="\displaystyle=\mathbb{E}\left[\left\|\operatorname{clip}_{M}\circ\,D\cdot\Big(\bm{\nu}_{2}\circ\bm{\mu}_{2}\circ\bm{\nu}_{1}\circ\bm{\mu}_{1}(P+EX)\Big)_{:,T}-\left(\begin{matrix}\mathbf{g}_{0}(\mathbf{Z}_{1,T})^{\top}\bm{\phi}_{1}(\mathbf{e}_{1})+\mathbf{h}(\mathbf{Z}_{2,T})^{\top}\bm{\phi}_{2}(\mathbf{e}_{1})\\
\mathbf{g}_{0}(\mathbf{Z}_{1,T})^{\top}\bm{\phi}_{1}(\mathbf{e}_{2})+\mathbf{h}(\mathbf{Z}_{2,T})^{\top}\bm{\phi}_{2}(\mathbf{e}_{2})\\
\vdots\\
\mathbf{g}_{0}(\mathbf{Z}_{1,T})^{\top}\bm{\phi}_{1}(\mathbf{e}_{W})+\mathbf{h}(\mathbf{Z}_{2,T})^{\top}\bm{\phi}_{2}(\mathbf{e}_{W})\end{matrix}\right)\right\|_{\infty}^{2}\,\,\middle|\,\,\mathbf{h}\right]" display="inline" intent=":literal"><semantics><mrow><mo>=</mo><mi>𝔼</mi><mrow><mo>[</mo><msubsup><mrow><mo>‖</mo><msub><mi>clip</mi><mi>M</mi></msub><mo lspace="0em" rspace="0.392em">∘</mo><mi>D</mi><mo lspace="0.222em" rspace="0.222em">⋅</mo><msub><mrow><mo maxsize="1.600em" minsize="1.600em">(</mo><msub><mi>𝝂</mi><mn>2</mn></msub><mo lspace="0.222em" rspace="0.222em">∘</mo><msub><mi>𝝁</mi><mn>2</mn></msub><mo lspace="0.222em" rspace="0.222em">∘</mo><msub><mi>𝝂</mi><mn>1</mn></msub><mo lspace="0.222em" rspace="0.222em">∘</mo><msub><mi>𝝁</mi><mn>1</mn></msub><mrow><mo stretchy="false">(</mo><mi>P</mi><mo>+</mo><mi>E</mi><mi>X</mi><mo stretchy="false">)</mo></mrow><mo maxsize="1.600em" minsize="1.600em">)</mo></mrow><mrow><mo rspace="0em">:</mo><mo>,</mo><mi>T</mi></mrow></msub><mo>−</mo><mrow><mo>(</mo><mtable rowspacing="0pt"><mtr><mtd><mrow><mrow><msub><mi>𝐠</mi><mn>0</mn></msub><mo lspace="0em" rspace="0em">​</mo><msup><mrow><mo stretchy="false">(</mo><msub><mi>𝐙</mi><mrow><mn>1</mn><mo>,</mo><mi>T</mi></mrow></msub><mo stretchy="false">)</mo></mrow><mo>⊤</mo></msup><mo lspace="0em" rspace="0em">​</mo><msub><mi class="ltx_mathvariant_bold-italic" mathvariant="bold-italic">ϕ</mi><mn>1</mn></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mi>𝐞</mi><mn>1</mn></msub><mo stretchy="false">)</mo></mrow></mrow><mo>+</mo><mrow><mi>𝐡</mi><mo lspace="0em" rspace="0em">​</mo><msup><mrow><mo stretchy="false">(</mo><msub><mi>𝐙</mi><mrow><mn>2</mn><mo>,</mo><mi>T</mi></mrow></msub><mo stretchy="false">)</mo></mrow><mo>⊤</mo></msup><mo lspace="0em" rspace="0em">​</mo><msub><mi class="ltx_mathvariant_bold-italic" mathvariant="bold-italic">ϕ</mi><mn>2</mn></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mi>𝐞</mi><mn>1</mn></msub><mo stretchy="false">)</mo></mrow></mrow></mrow></mtd></mtr><mtr><mtd><mrow><mrow><msub><mi>𝐠</mi><mn>0</mn></msub><mo lspace="0em" rspace="0em">​</mo><msup><mrow><mo stretchy="false">(</mo><msub><mi>𝐙</mi><mrow><mn>1</mn><mo>,</mo><mi>T</mi></mrow></msub><mo stretchy="false">)</mo></mrow><mo>⊤</mo></msup><mo lspace="0em" rspace="0em">​</mo><msub><mi class="ltx_mathvariant_bold-italic" mathvariant="bold-italic">ϕ</mi><mn>1</mn></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mi>𝐞</mi><mn>2</mn></msub><mo stretchy="false">)</mo></mrow></mrow><mo>+</mo><mrow><mi>𝐡</mi><mo lspace="0em" rspace="0em">​</mo><msup><mrow><mo stretchy="false">(</mo><msub><mi>𝐙</mi><mrow><mn>2</mn><mo>,</mo><mi>T</mi></mrow></msub><mo stretchy="false">)</mo></mrow><mo>⊤</mo></msup><mo lspace="0em" rspace="0em">​</mo><msub><mi class="ltx_mathvariant_bold-italic" mathvariant="bold-italic">ϕ</mi><mn>2</mn></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mi>𝐞</mi><mn>2</mn></msub><mo stretchy="false">)</mo></mrow></mrow></mrow></mtd></mtr><mtr><mtd></mtd></mtr><mtr><mtd><mrow><mrow><msub><mi>𝐠</mi><mn>0</mn></msub><mo lspace="0em" rspace="0em">​</mo><msup><mrow><mo stretchy="false">(</mo><msub><mi>𝐙</mi><mrow><mn>1</mn><mo>,</mo><mi>T</mi></mrow></msub><mo stretchy="false">)</mo></mrow><mo>⊤</mo></msup><mo lspace="0em" rspace="0em">​</mo><msub><mi class="ltx_mathvariant_bold-italic" mathvariant="bold-italic">ϕ</mi><mn>1</mn></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mi>𝐞</mi><mi>W</mi></msub><mo stretchy="false">)</mo></mrow></mrow><mo>+</mo><mrow><mi>𝐡</mi><mo lspace="0em" rspace="0em">​</mo><msup><mrow><mo stretchy="false">(</mo><msub><mi>𝐙</mi><mrow><mn>2</mn><mo>,</mo><mi>T</mi></mrow></msub><mo stretchy="false">)</mo></mrow><mo>⊤</mo></msup><mo lspace="0em" rspace="0em">​</mo><msub><mi class="ltx_mathvariant_bold-italic" mathvariant="bold-italic">ϕ</mi><mn>2</mn></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mi>𝐞</mi><mi>W</mi></msub><mo stretchy="false">)</mo></mrow></mrow></mrow></mtd></mtr></mtable><mo>)</mo></mrow><mo>‖</mo></mrow><mi mathvariant="normal">∞</mi><mn>2</mn></msubsup><mo lspace="0em" rspace="0.340em" stretchy="true">|</mo><mi>𝐡</mi><mo>]</mo></mrow></mrow><annotation encoding="application/x-tex">\displaystyle=\mathbb{E}\left[\left\|\operatorname{clip}_{M}\circ\,D\cdot\Big(\bm{\nu}_{2}\circ\bm{\mu}_{2}\circ\bm{\nu}_{1}\circ\bm{\mu}_{1}(P+EX)\Big)_{:,T}-\left(\begin{matrix}\mathbf{g}_{0}(\mathbf{Z}_{1,T})^{\top}\bm{\phi}_{1}(\mathbf{e}_{1})+\mathbf{h}(\mathbf{Z}_{2,T})^{\top}\bm{\phi}_{2}(\mathbf{e}_{1})\\
