row><mo stretchy="false">‖</mo><mrow><msub><mi>P</mi><mi>𝜶</mi></msub><mo lspace="0em" rspace="0em">​</mo><msub><mover accent="true"><mi>𝐦</mi><mo>^</mo></mover><mi>λ</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mi>𝐙</mi><mrow><mn>2</mn><mo>,</mo><mrow><mi>T</mi><mo>+</mo><mn>1</mn></mrow></mrow></msub><mo stretchy="false">)</mo></mrow></mrow><mo stretchy="false">‖</mo></mrow><mn>2</mn></msub></mfrac><mo>)</mo></mrow></mrow><mo>≤</mo><mfrac><msub><mrow><mo stretchy="false">‖</mo><mrow><msubsup><mi>P</mi><mi>𝜶</mi><mo>⟂</mo></msubsup><mo lspace="0em" rspace="0em">​</mo><msub><mover accent="true"><mi>𝐦</mi><mo>^</mo></mover><mi>λ</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mi>𝐙</mi><mrow><mn>2</mn><mo>,</mo><mrow><mi>T</mi><mo>+</mo><mn>1</mn></mrow></mrow></msub><mo stretchy="false">)</mo></mrow></mrow><mo stretchy="false">‖</mo></mrow><mn>2</mn></msub><msub><mrow><mo stretchy="false">‖</mo><mrow><msub><mi>P</mi><mi>𝜶</mi></msub><mo lspace="0em" rspace="0em">​</mo><msub><mover accent="true"><mi>𝐦</mi><mo>^</mo></mover><mi>λ</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mi>𝐙</mi><mrow><mn>2</mn><mo>,</mo><mrow><mi>T</mi><mo>+</mo><mn>1</mn></mrow></mrow></msub><mo stretchy="false">)</mo></mrow></mrow><mo stretchy="false">‖</mo></mrow><mn>2</mn></msub></mfrac></mrow><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">\left\|\frac{\widehat{\mathbf{m}}_{\lambda}(\mathbf{Z}_{2,T+1})}{\|\widehat{\mathbf{m}}_{\lambda}(\mathbf{Z}_{2,T+1})\|_{2}}-\bm{\alpha}\right\|_{2}\leq\tan^{-1}\left(\frac{\|P^{\perp}_{\bm{\alpha}}\widehat{\mathbf{m}}_{\lambda}(\mathbf{Z}_{2,T+1})\|_{2}}{\|P_{\bm{\alpha}}\widehat{\mathbf{m}}_{\lambda}(\mathbf{Z}_{2,T+1})\|_{2}}\right)\leq\frac{\|P^{\perp}_{\bm{\alpha}}\widehat{\mathbf{m}}_{\lambda}(\mathbf{Z}_{2,T+1})\|_{2}}{\|P_{\bm{\alpha}}\widehat{\mathbf{m}}_{\lambda}(\mathbf{Z}_{2,T+1})\|_{2}}.</annotation><