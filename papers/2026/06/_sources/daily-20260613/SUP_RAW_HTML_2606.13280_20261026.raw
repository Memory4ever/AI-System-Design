</div>
<div id="Thmconj221" class="ltx_theorem ltx_theorem_lemma">
<h6 class="ltx_title ltx_runin ltx_title_theorem"><span class="ltx_tag ltx_tag_theorem"><span id="Thmconj221.4" class="ltx_text ltx_font_bold">Lemma 21</span></span><span id="Thmconj221.5" class="ltx_text ltx_font_bold">.</span></h6>
<div id="Thmconj221.p1" class="ltx_para">
<p id="Thmconj221.p1.1" class="ltx_p"><span id="Thmconj221.p1.1.1" class="ltx_text ltx_font_italic">Given <math id="Thmconj221.p1.m1" class="ltx_Math" alttext="0&lt;a&lt;b" display="inline" intent=":literal"><semantics><mrow><mn>0</mn><mo>&lt;</mo><mi>a</mi><mo>&lt;</mo><mi>b</mi></mrow><annotation encoding="application/x-tex">0&lt;a&lt;b</annotation></semantics></math>, there exist constants <math id="Thmconj221.p1.m2" class="ltx_Math" alttext="c=c(a,b),c^{\prime}=c^{\prime}(a,b)," display="inline" intent=":literal"><semantics><mrow><mrow><mrow><mi>c</mi><mo>=</mo><mrow><mi>c</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>a</mi><mo>,</mo><mi>b</mi><mo stretchy="false">)</mo></mrow></mrow></mrow><mo>,</mo><mrow><msup><mi>c</mi><mo>′</mo></msup><mo>=</mo><mrow><msup><mi>c</mi><mo>′</mo></msup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>a</mi><mo>,</mo><mi>b</mi><mo stretchy="false">)</mo></mrow></mrow></mrow></mrow><mo>,</mo></mrow><annotation encoding="application/x-tex">c=c(a,b),c^{\prime}=c^{\prime}(a,b),</annotation></semantics></math> such that for any sufficiently large <math id="Thmconj221.p1.m3" class="ltx_Math" alttext="M" display="inline" intent=":literal"><semantics><mi>M</mi><annotation encoding="application/x-tex">M</annotation></semantics></math>, there exists a multilayer perceptron <math id="Thmconj221.p1.m4" class="ltx_Math" alttext="f:\mathbb{R}\rightarrow\mathbb{R}" display="inline" intent=":literal"><semantics><mrow><mi>f</mi><mo lspace="0.278em" rspace="0.278em">:</mo><mrow><mi>ℝ</mi><mo stretchy="false">→</mo><mi>ℝ</mi></mrow></mrow><annotation encoding="application/x-tex">f:\mathbb{R}\rightarrow\mathbb{R}</annotation></semantics></math>
with depth <math id="Thmconj221.p1.m5" class="ltx_Math" alttext="\lceil\log_{2}(Mb/a)\rceil M" display="inline" intent=":literal"><semantics><mrow><mrow><mo stretchy="false">⌈</mo><mrow><msub><mi>log</mi><mn>2</mn></msub><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mrow><mrow><mi>M</mi><mo lspace="0em" rspace="0em">​</mo><mi>b</mi></mrow><mo>/</mo><mi>a</mi></mrow><mo stretchy="false">)</mo></mrow></mrow><mo stretchy="false">⌉</mo></mrow><mo lspace="0em" rspace="0em">​</mo><mi>M</mi></mrow><annotation encoding="application/x-tex">\lceil\log_{2}(Mb/a)\rceil M</annotation></semantics></math>, width <math id="Thmconj221.p1.m6" class="ltx_Math" alttext="7\lceil Mb/a\rceil^{2}" display="inline" intent=":literal"><semantics><mrow><mn>7</mn><mo lspace="0em" rspace="0em">​</mo><msup><mrow><mo stretchy="false">⌈</mo><mrow><mrow><mi>M</mi><mo lspace="0em" rspace="0em">​</mo><mi>b</mi></mrow><mo>/</mo><mi>a</mi></mrow><mo stretchy="false">⌉</mo></mrow><mn>2</mn></msup></mrow><annotation encoding="application/x-tex">7\lceil Mb/a\rceil^{2}</annotation></semantics></math>, and parameters bounded in absolute value by <math id="Thmconj221.p1.m7" class="ltx_Math" alttext="c," display="inline" intent=":literal"><semantics><mrow><mi>c</mi><mo>,</mo></mrow><annotation encoding="application/x-tex">c,</annotation></semantics></math> satisfying</span></p>
<table id="A5.Ex251" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="A5.Ex251.m1" class="ltx_Math" alttext="\sup_{x\in[a,b]}\left|f(x)-\frac{1}{\sqrt{x}}\right|\leq c^{\prime}M^{2}2^{-M}." display="block" intent=":literal"><semantics><mrow><mrow><mrow><munder><mo movablelimits="false">sup</mo><mrow><mi>x</mi><mo>∈</mo><mrow><mo stretchy="false">[</mo><mrow><mi>a</mi><mo>,</mo><mi>b</mi></mrow><mo stretchy="false">]</mo></mrow></mrow></munder><mrow><mo lspace="0em">|</mo><mrow><mrow><mi>f</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>x</mi><mo stretchy="false">)</mo></mrow></mrow><mo>−</mo><mfrac><mn>1</mn><msqrt><mi>x</mi></msqrt></mfrac></mrow><mo>|</mo></mrow></mrow><mo>≤</mo><mrow><msup><mi>c</mi><mo>′</mo></msup><mo lspace="0em" rspace="0em">​</mo><msup><mi>M</mi><mn>2</mn></msup><mo lspace="0em" rspace="0em">​</mo><msup><mn>2</mn><mrow><mo>−</mo><mi>M</mi></mrow></msup></mrow></mrow><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">\sup_{x\in[a,b]}\left|f(x)-\frac{1}{\sqrt{x}}\right|\leq c^{\prime}M^{2}2^{-M}.</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
</div>
</div>
<div id="A5.SS2.5" class="ltx_proof">
<h6 class="ltx_title ltx_runin ltx_font_italic ltx_title_proof">Proof.</h6>
<div id="A5.SS2.p8" class="ltx_para">
<p id="A5.SS2.p8.1" class="ltx_p"><span id="A5.SS2.p8.1.1" class="ltx_text">We rewrite</span></p>
<table id="A5.Ex252" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="A5.Ex252.m1" class="ltx_Math" alttext="\frac{1}{\sqrt{x}}=h_{0}\circ g_{0}(x),\text{ with }g_{0}(x)\coloneq\frac{2x-a-b}{b}\text{ and }h_{0}(z)\coloneq\frac{\sqrt{2}}{\sqrt{a+b}}\,\frac{1}{\sqrt{1+\frac{z}{1+(a/b)}}}," display="block" intent=":literal"><semantics><mrow><mrow><mrow><mfrac><mn>1</mn><msqrt><mi>x</mi></msqrt></mfrac><mo>=</mo><mrow><mrow><msub><mi>h</mi><mn>0</mn></msub><mo lspace="0.222em" rspace="0.222em">∘</mo><msub><mi>g</mi><mn>0</mn></msub></mrow><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>x</mi><mo stretchy="false">)</mo></mrow></mrow></mrow><mo>,</mo><mrow><mrow><mtext> with </mtext><mo lspace="0em" rspace="0em">​</mo><msub><mi>g</mi><mn>0</mn></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>x</mi><mo stretchy="false">)</mo></mrow></mrow><mo>≔</mo><mrow><mfrac><mrow><mrow><mn>2</mn><mo lspace="0em" rspace="0em">​</mo><mi>x</mi></mrow><mo>−</mo><mi>a</mi><mo>−</mo><mi>b</mi></mrow><mi>b</mi></mfrac><mo lspace="0em" rspace="0em">​</mo><mtext> and </mtext><mo lspace="0em" rspace="0em">​</mo><msub><mi>h</mi><mn>0</mn></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>z</mi><mo stretchy="false">)</mo></mrow></mrow><mo>≔</mo><mrow><mfrac><msqrt><mn>2</mn></msqrt><msqrt><mrow><mi>a</mi><mo>+</mo><mi>b</mi></mrow></msqrt></mfrac><mo lspace="0.170em" rspace="0em">​</mo><mfrac><mn>1</mn><msqrt><mrow><mn>1</mn><mo>+</mo><mfrac><mi>z</mi><mrow><mn>1</mn><mo>+</mo><mrow><mo stretchy="false">(</mo><mrow><mi>a</mi><mo>/</mo><mi>b</mi></mrow><mo stretchy="false">)</mo></mrow></mrow></mfrac></mrow></msqrt></mfrac></mrow></mrow></mrow><mo>,</mo></mrow><annotation encoding="application/x-tex">\frac{1}{\sqrt{x}}=h_{0}\circ g_{0}(x),\text{ with }g_{0}(x)\coloneq\frac{2x-a-b}{b}\text{ and }h_{0}(z)\coloneq\frac{\sqrt{2}}{\sqrt{a+b}}\,\frac{1}{\sqrt{1+\frac{z}{1+(a/b)}}},</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="A5.SS2.p8.2" class="ltx_p"><span id="A5.SS2.p8.2.1" class="ltx_text">where <math id="A5.SS2.p8.m1" class="ltx_Math" alttext="g_{0}" display="inline" intent=":literal"><semantics><msub><mi>g</mi><mn>0</mn></msub><annotation encoding="application/x-tex">g_{0}</annotation></semantics></math> maps <math id="A5.SS2.p8.m2" class="ltx_Math" alttext="[a,b]" display="inline" intent=":literal"><semantics><mrow><mo stretchy="false">[</mo><mi>a</mi><mo>,</mo><mi>b</mi><mo stretchy="false">]</mo></mrow><annotation encoding="application/x-tex">[a,b]</annotation></semantics></math> to <math id="A5.SS2.p8.m3" class="ltx_Math" alttext="[-1+(a/b),1-(a/b)]" display="inline" intent=":literal"><semantics><mrow><mo stretchy="false">[</mo><mrow><mrow><mrow><mo>−</mo><mn>1</mn></mrow><mo>+</mo><mrow><mo stretchy="false">(</mo><mrow><mi>a</mi><mo>/</mo><mi>b</mi></mrow><mo stretchy="false">)</mo></mrow></mrow><mo>,</mo><mrow><mn>1</mn><mo>−</mo><mrow><mo stretchy="false">(</mo><mrow><mi>a</mi><mo>/</mo><mi>b</mi></mrow><mo stretchy="false">)</mo></mrow></mrow></mrow><mo stretchy="false">]</mo></mrow><annotation encoding="application/x-tex">[-1+(a/b),1-(a/b)]</annotation></semantics></math>.
By the generalized binomial theorem,</span></p>
<table id="A5.Ex253" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="A5.Ex253.m1" class="ltx_Math" alttext="h_{0}(z)=\frac{\sqrt{2}}{\sqrt{a+b}}\sum_{k\in\mathbb{N}_{0}}\binom{-\frac{1}{2}}{k}\left(\frac{z}{1+(a/b)}\right)^{k}\quad\text{for all}\ z\in\big(-1-(a/b),1+(a/b)\big)" display="block" intent=":literal"><semantics><mrow><mrow><mrow><msub><mi>h</mi><mn>0</mn></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>z</mi><mo stretchy="false">)</mo></mrow></mrow><mo>=</mo><mrow><mfrac><msqrt><mn>2</mn></msqrt><msqrt><mrow><mi>a</mi><mo>+</mo><mi>b</mi></mrow></msqrt></mfrac><mo lspace="0em" rspace="0em">​</mo><mrow><munder><mo movablelimits="false" rspace="0em">∑</mo><mrow><mi>k</mi><mo>∈</mo><msub><mi>ℕ</mi><mn>0</mn></msub></mrow></munder><mrow><mrow><mo>(</mo><mfrac linethickness="0pt"><mrow><mo>−</mo><mfrac><mn>1</mn><mn>2</mn></mfrac></mrow><mi>k</mi></mfrac><mo>)</mo></mrow><mo lspace="0em" rspace="0em">​</mo><msup><mrow><mo>(</mo><mfrac><mi>z</mi><mrow><mn>1</mn><mo>+</mo><mrow><mo stretchy="false">(</mo><mrow><mi>a</mi><mo>/</mo><mi>b</mi></mrow><mo stretchy="false">)</mo></mrow></mrow></mfrac><mo>)</mo></mrow><mi>k</mi></msup></mrow></mrow></mrow></mrow><mspace style="width:1em;" width="1em"></mspace><mrow><mrow><mtext>for all</mtext><mo lspace="0.500em" rspace="0em">​</mo><mi>z</mi></mrow><mo>∈</mo><mrow><mo maxsize="1.200em" minsize="1.200em">(</mo><mrow><mrow><mo>−</mo><mn>1</mn></mrow><mo>−</mo><mrow><mo stretchy="false">(</mo><mrow><mi>a</mi><mo>/</mo><mi>b</mi></mrow><mo stretchy="false">)</mo></mrow></mrow><mo>,</mo><mrow><mn>1</mn><mo>+</mo><mrow><mo stretchy="false">(</mo><mrow><mi>a</mi><mo>/</mo><mi>b</mi></mrow><mo stretchy="false">)</mo></mrow></mrow><mo maxsize="1.200em" minsize="1.200em">)</mo></mrow></mrow></mrow><annotation encoding="application/x-tex">h_{0}(z)=\frac{\sqrt{2}}{\sqrt{a+b}}\sum_{k\in\mathbb{N}_{0}}\binom{-\frac{1}{2}}{k}\left(\frac{z}{1+(a/b)}\right)^{k}\quad\text{for all}\ z\in\big(-1-(a/b),1+(a/b)\big)</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="A5.SS2.p8.3" class="ltx_p"><span id="A5.SS2.p8.3.1" class="ltx_text">with generalized binomial coefficients</span></p>
<table id="A5.Ex254" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="A5.Ex254.m1" class="ltx_Math" alttext="\binom{-\frac{1}{2}}{k}=\frac{(-\frac{1}{2})(-\frac{1}{2}-1)\ldots(-\frac{1}{2}-k+1)}{k!}=(-1)^{k}\frac{(2k)!}{4^{k}(k!)^{2}}." display="block" intent=":literal"><semantics><mrow><mrow><mrow><mo>(</mo><mfrac linethickness="0pt"><mrow><mo>−</mo><mfrac><mn>1</mn><mn>2</mn></mfrac></mrow><mi>k</mi></mfrac><mo>)</mo></mrow><mo>=</mo><mfrac><mrow><mrow><mo stretchy="false">(</mo><mrow><mo>−</mo><mfrac><mn>1</mn><mn>2</mn></mfrac></mrow><mo stretchy="false">)</mo></mrow><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mrow><mrow><mo>−</mo><mfrac><mn>1</mn><mn>2</mn></mfrac></mrow><mo>−</mo><mn>1</mn></mrow><mo stretchy="false">)</mo></mrow><mo lspace="0em" rspace="0em">​</mo><mi mathvariant="normal">…</mi><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mrow><mrow><mrow><mo>−</mo><mfrac><mn>1</mn><mn>2</mn></mfrac></mrow><mo>−</mo><mi>k</mi></mrow><mo>+</mo><mn>1</mn></mrow><mo stretchy="false">)</mo></mrow></mrow><mrow><mi>k</mi><mo>!</mo></mrow></mfrac><mo>=</mo><mrow><msup><mrow><mo stretchy="false">(</mo><mrow><mo>−</mo><mn>1</mn></mrow><mo stretchy="false">)</mo></mrow><mi>k</mi></msup><mo lspace="0em" rspace="0em">​</mo><mfrac><mrow><mrow><mo stretchy="false">(</mo><mrow><mn>2</mn><mo lspace="0em" rspace="0em">​</mo><mi>k</mi></mrow><mo stretchy="false">)</mo></mrow><mo>!</mo></mrow><mrow><msup><mn>4</mn><mi>k</mi></msup><mo lspace="0em" rspace="0em">​</mo><msup><mrow><mo stretchy="false">(</mo><mrow><mi>k</mi><mo>!</mo></mrow><mo stretchy="false">)</mo></mrow><mn>2</mn></msup></mrow></mfrac></mrow></mrow><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">\binom{-\frac{1}{2}}{k}=\frac{(-\frac{1}{2})(-\frac{1}{2}-1)\ldots(-\frac{1}{2}-k+1)}{k!}=(-1)^{k}\frac{(2k)!}{4^{k}(k!)^{2}}.</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="A5.SS2.p8.4" class="ltx_p"><span id="A5.SS2.p8.4.1" class="ltx_text">Observe that</span></p>
<table id="A5.EGx112" class="ltx_equationgroup ltx_eqn_align ltx_eqn_table">

<tbody id="A5.Ex255"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_align_right ltx_eqn_cell"><math id="A5.Ex255.m1" class="ltx_Math" alttext="\displaystyle\sum_{k\in\mathbb{N}_{0}}\left|\binom{-\frac{1}{2}}{k}\left(\frac{1}{1+(a/b)}\right)^{k}\right|=\sum_{k\in\mathbb{N}_{0}}\binom{-\frac{1}{2}}{k}\left(-\frac{1}{1+(a/b)}\right)^{k}=\frac{1}{\sqrt{1-\frac{1}{1+(a/b)}}}=\sqrt{1+(b/a)}." display="inline" intent=":literal"><semantics><mrow><mrow><mrow><mstyle displaystyle="true"><munder><mo movablelimits="false">∑</mo><mrow><mi>k</mi><mo>∈</mo><msub><mi>ℕ</mi><mn>0</mn></msub></mrow></munder></mstyle><mrow><mo>|</mo><mrow><mrow><mo>(</mo><mstyle displaystyle="true"><mfrac linethickness="0pt"><mrow><mo>−</mo><mfrac><mn>1</mn><mn>2</mn></mfrac></mrow><mi>k</mi></mfrac></mstyle><mo>)</mo></mrow><mo lspace="0em" rspace="0em">​</mo><msup><mrow><mo>(</mo><mstyle displaystyle="true"><mfrac><mn>1</mn><mrow><mn>1</mn><mo>+</mo><mrow><mo stretchy="false">(</mo><mrow><mi>a</mi><mo>/</mo><mi>b</mi></mrow><mo stretchy="false">)</mo></mrow></mrow></mfrac></mstyle><mo>)</mo></mrow><mi>k</mi></msup></mrow><mo>|</mo></mrow></mrow><mo>=</mo><mrow><mstyle displaystyle="true"><munder><mo movablelimits="false">∑</mo><mrow><mi>k</mi><mo>∈</mo><msub><mi>ℕ</mi><mn>0</mn></msub></mrow></munder></mstyle><mrow><mrow><mo>(</mo><mstyle displaystyle="true"><mfrac linethickness="0pt"><mrow><mo>−</mo><mfrac><mn>1</mn><mn>2</mn></mfrac></mrow><mi>k</mi></mfrac></mstyle><mo>)</mo></mrow><mo lspace="0em" rspace="0em">​</mo><msup><mrow><mo>(</mo><mrow><mo>−</mo><mstyle displaystyle="true"><mfrac><mn>1</mn><mrow><mn>1</mn><mo>+</mo><mrow><mo stretchy="false">(</mo><mrow><mi>a</mi><mo>/</mo><mi>b</mi></mrow><mo stretchy="false">)</mo></mrow></mrow></mfrac></mstyle></mrow><mo>)</mo></mrow><mi>k</mi></msup></mrow></mrow><mo>=</mo><mstyle displaystyle="true"><mfrac><mn>1</mn><msqrt><mrow><mn>1</mn><mo>−</mo><mfrac><mn>1</mn><mrow><mn>1</mn><mo>+</mo><mrow><mo stretchy="false">(</mo><mrow><mi>a</mi><mo>/</mo><mi>b</mi></mrow><mo stretchy="false">)</mo></mrow></mrow></mfrac></mrow></msqrt></mfrac></mstyle><mo>=</mo><msqrt><mrow><mn>1</mn><mo>+</mo><mrow><mo stretchy="false">(</mo><mrow><mi>b</mi><mo>/</mo><mi>a</mi></mrow><mo stretchy="false">)</mo></mrow></mrow></msqrt></mrow><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">\displaystyle\sum_{k\in\mathbb{N}_{0}}\left|\binom{-\frac{1}{2}}{k}\left(\frac{1}{1+(a/b)}\right)^{k}\right|=\sum_{k\in\mathbb{N}_{0}}\binom{-\frac{1}{2}}{k}\left(-\frac{1}{1+(a/b)}\right)^{k}=\frac{1}{\sqrt{1-\frac{1}{1+(a/b)}}}=\sqrt{1+(b/a)}.</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="A5.SS2.p8.5" class="ltx_p"><span id="A5.SS2.p8.5.1" class="ltx_text">By Lemma <a href="#Thmconj218" title="Lemma 18. ‣ E.2 Construction of multilayer perceptron layers ‣ Appendix E Construction of the Transformer ‣ Generalization Bounds for Transformer-Based Next-Token Prediction in a Language Model" class="ltx_ref"><span class="ltx_text ltx_ref_tag">18</span></a>, there exists a multilayer perceptron <math id="A5.SS2.p8.m4" class="ltx_Math" alttext="h:\mathbb{R}\rightarrow\mathbb{R}" display="inline" intent=":literal"><semantics><mrow><mi>h</mi><mo lspace="0.278em" rspace="0.278em">:</mo><mrow><mi>ℝ</mi><mo stretchy="false">→</mo><mi>ℝ</mi></mrow></mrow><annotation encoding="application/x-tex">h:\mathbb{R}\rightarrow\mathbb{R}</annotation></semantics></math> with depth
<math id="A5.SS2.p8.m5" class="ltx_Math" alttext="\lceil\log_{2}(Mb/a)\rceil M" display="inline" intent=":literal"><semantics><mrow><mrow><mo stretchy="false">⌈</mo><mrow><msub><mi>log</mi><mn>2</mn></msub><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mrow><mrow><mi>M</mi><mo lspace="0em" rspace="0em">​</mo><mi>b</mi></mrow><mo>/</mo><mi>a</mi></mrow><mo stretchy="false">)</mo></mrow></mrow><mo stretchy="false">⌉</mo></mrow><mo lspace="0em" rspace="0em">​</mo><mi>M</mi></mrow><annotation encoding="application/x-tex">\lceil\log_{2}(Mb/a)\rceil M</annotation></semantics></math>, width <math id="A5.SS2.p8.m6" class="ltx_Math" alttext="7\lceil Mb/a\rceil^{2}" display="inline" intent=":literal"><semantics><mrow><mn>7</mn><mo lspace="0em" rspace="0em">​</mo><msup><mrow><mo stretchy="false">⌈</mo><mrow><mrow><mi>M</mi><mo lspace="0em" rspace="0em">​</mo><mi>b</mi></mrow><mo>/</mo><mi>a</mi></mrow><mo stretchy="false">⌉</mo></mrow><mn>2</mn></msup></mrow><annotation encoding="application/x-tex">7\lceil Mb/a\rceil^{2}</annotation></semantics></math>, and parameters bounded in absolute value by a constant depending only on <math id="A5.SS2.p8.m7" class="ltx_Math" alttext="a" display="inline" intent=":literal"><semantics><mi>a</mi><annotation encoding="application/x-tex">a</annotation></semantics></math> and <math id="A5.SS2.p8.m8" class="ltx_Math" alttext="b" display="inline" intent=":literal"><semantics><mi>b</mi><annotation encoding="application/x-tex">b</annotation></semantics></math> such that</span></p>
<table id="A5.Ex256" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="A5.Ex256.m1" class="ltx_Math" alttext="\sup_{z\in[-1+(a/b),1-(a/b)]}|h(z)-h_{0}(z)|\lesssim M^{2}2^{-M}." display="block" intent=":literal"><semantics><mrow><mrow><mrow><munder><mo movablelimits="false">sup</mo><mrow><mi>z</mi><mo>∈</mo><mrow><mo stretchy="false">[</mo><mrow><mrow><mrow><mo>−</mo><mn>1</mn></mrow><mo>+</mo><mrow><mo stretchy="false">(</mo><mrow><mi>a</mi><mo>/</mo><mi>b</mi></mrow><mo stretchy="false">)</mo></mrow></mrow><mo>,</mo><mrow><mn>1</mn><mo>−</mo><mrow><mo stretchy="false">(</mo><mrow><mi>a</mi><mo>/</mo><mi>b</mi></mrow><mo stretchy="false">)</mo></mrow></mrow></mrow><mo stretchy="false">]</mo></mrow></mrow></munder><mrow><mo lspace="0em" stretchy="false">|</mo><mrow><mrow><mi>h</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>z</mi><mo stretchy="false">)</mo></mrow></mrow><mo>−</mo><mrow><msub><mi>h</mi><mn>0</mn></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>z</mi><mo stretchy="false">)</mo></mrow></mrow></mrow><mo stretchy="false">|</mo></mrow></mrow><mo>≲</mo><mrow><msup><mi>M</mi><mn>2</mn></msup><mo lspace="0em" rspace="0em">​</mo><msup><mn>2</mn><mrow><mo>−</mo><mi>M</mi></mrow></msup></mrow></mrow><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">\sup_{z\in[-1+(a/b),1-(a/b)]}|h(z)-h_{0}(z)|\lesssim M^{2}2^{-M}.</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="A5.SS2.p8.6" class="ltx_p"><span id="A5.SS2.p8.6.1" class="ltx_text">It follows that there exists a multilayer perceptron <math id="A5.SS2.p8.m9" class="ltx_Math" alttext="f=h\circ g_{0}:\mathbb{R}\rightarrow\mathbb{R}" display="inline" intent=":literal"><semantics><mrow><mi>f</mi><mo>=</mo><mrow><mi>h</mi><mo lspace="0.222em" rspace="0.222em">∘</mo><msub><mi>g</mi><mn>0</mn></msub></mrow><mo lspace="0.278em" rspace="0.278em">:</mo><mrow><mi>ℝ</mi><mo stretchy="false">→</mo><mi>ℝ</mi></mrow></mrow><annotation encoding="application/x-tex">f=h\circ g_{0}:\mathbb{R}\rightarrow\mathbb{R}</annotation></semantics></math> with the same architecture such that</span></p>
<table id="A5.Ex257" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="A5.Ex257.m1" class="ltx_Math" alttext="\sup_{x\in[a,b]}\left|f(x)-\frac{1}{\sqrt{x}}\right|\lesssim M^{2}2^{-M}." display="block" intent=":literal"><semantics><mrow><mrow><mrow><munder><mo movablelimits="false">sup</mo><mrow><mi>x</mi><mo>∈</mo><mrow><mo stretchy="false">[</mo><mrow><mi>a</mi><mo>,</mo><mi>b</mi></mrow><mo stretchy="false">]</mo></mrow></mrow></munder><mrow><mo lspace="0em">|</mo><mrow><mrow><mi>f</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>x</mi><mo stretchy="false">)</mo></mrow></mrow><mo>−</mo><mfrac><mn>1</mn><msqrt><mi>x</mi></msqrt></mfrac></mrow><mo>|</mo></mrow></mrow><mo>≲</mo><mrow><msup><mi>M</mi><mn>2</mn></msup><mo lspace="0em" rspace="0em">​</mo><msup><mn>2</mn><mrow><mo>−</mo><mi>M</mi></mrow></msup></mrow></mrow><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">\sup_{x\in[a,b]}\left|f(x)-\frac{1}{\sqrt{x}}\right|\lesssim M^{2}2^{-M}.</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="A5.SS2.p8.7" class="ltx_p"><span id="A5.SS2.p8.7.1" class="ltx_text">∎</span></p>
</div>
</div>
<div id="Thmconj222" class="ltx_theorem ltx_theorem_lemma">
<h6 class="ltx_title ltx_runin ltx_title_theorem"><span class="ltx_tag ltx_tag_theorem"><span id="Thmconj222.4" class="ltx_text ltx_font_bold">Lemma 22</span></span><span id="Thmconj222.5" class="ltx_text ltx_font_bold">.</span></h6>
<div id="Thmconj222.p1" class="ltx_para">
<p id="Thmconj222.p1.1" class="ltx_p"><span id="Thmconj222.p1.1.1" class="ltx_text ltx_font_italic">For any <math id="Thmconj222.p1.m1" class="ltx_Math" alttext="d,c,L,M\in\mathbb{N}" display="inline" intent=":literal"><semantics><mrow><mi>d</mi><mo>,</mo><mi>c</mi><mo>,</mo><mi>L</mi><mo>,</mo><mrow><mi>M</mi><mo>∈</mo><mi>ℕ</mi></mrow></mrow><annotation encoding="application/x-tex">d,c,L,M\in\mathbb{N}</annotation></semantics></math> with <math id="Thmconj222.p1.m2" class="ltx_Math" alttext="c\leq(MB)^{L}" display="inline" intent=":literal"><semantics><mrow><mi>c</mi><mo>≤</mo><msup><mrow><mo stretchy="false">(</mo><mrow><mi>M</mi><mo lspace="0em" rspace="0em">​</mo><mi>B</mi></mrow><mo stretchy="false">)</mo></mrow><mi>L</mi></msup></mrow><annotation encoding="application/x-tex">c\leq(MB)^{L}</annotation></semantics></math>, there exists <math id="Thmconj222.p1.m3" class="ltx_Math" alttext="\mathbf{f}\in\mathcal{MLP}(d,d,L,2dM,B)" display="inline" intent=":literal"><semantics><mrow><mi>𝐟</mi><mo>∈</mo><mrow><mi class="ltx_font_mathcaligraphic">ℳ</mi><mo lspace="0em" rspace="0em">​</mo><mi class="ltx_font_mathcaligraphic">ℒ</mi><mo lspace="0em" rspace="0em">​</mo><mi class="ltx_font_mathcaligraphic">𝒫</mi><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>d</mi><mo>,</mo><mi>d</mi><mo>,</mo><mi>L</mi><mo>,</mo><mrow><mn>2</mn><mo lspace="0em" rspace="0em">​</mo><mi>d</mi><mo lspace="0em" rspace="0em">​</mo><mi>M</mi></mrow><mo>,</mo><mi>B</mi><mo stretchy="false">)</mo></mrow></mrow></mrow><annotation encoding="application/x-tex">\mathbf{f}\in\mathcal{MLP}(d,d,L,2dM,B)</annotation></semantics></math> such that
<math id="Thmconj222.p1.m4" class="ltx_Math" alttext="\mathbf{f}(\mathbf{x})=c\mathbf{x}" display="inline" intent=":literal"><semantics><mrow><mrow><mi>𝐟</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>𝐱</mi><mo stretchy="false">)</mo></mrow></mrow><mo>=</mo><mrow><mi>c</mi><mo lspace="0em" rspace="0em">​</mo><mi>𝐱</mi></mrow></mrow><annotation encoding="application/x-tex">\mathbf{f}(\mathbf{x})=c\mathbf{x}</annotation></semantics></math>
for every <math id="Thmconj222.p1.m5" class="ltx_Math" alttext="\mathbf{x}\in\mathbb{R}^{d}" display="inline" intent=":literal"><semantics><mrow><mi>𝐱</mi><mo>∈</mo><msup><mi>ℝ</mi><mi>d</mi></msup></mrow><annotation encoding="application/x-tex">\mathbf{x}\in\mathbb{R}^{d}</annotation></semantics></math>.</span></p>
</div>
</div>
<div id="A5.SS2.6" class="ltx_proof">
<h6 class="ltx_title ltx_runin ltx_font_italic ltx_title_proof">Proof.</h6>
<div id="A5.SS2.p9" class="ltx_para">
<p id="A5.SS2.p9.1" class="ltx_p"><span id="A5.SS2.p9.1.1" class="ltx_text">It suffices to consider the case <math id="A5.SS2.p9.m1" class="ltx_Math" alttext="d=1," display="inline" intent=":literal"><semantics><mrow><mrow><mi>d</mi><mo>=</mo><mn>1</mn></mrow><mo>,</mo></mrow><annotation encoding="application/x-tex">d=1,</annotation></semantics></math> as then, for arbitrary <math id="A5.SS2.p9.m2" class="ltx_Math" alttext="d" display="inline" intent=":literal"><semantics><mi>d</mi><annotation encoding="application/x-tex">d</annotation></semantics></math>, one can construct <math id="A5.SS2.p9.m3" class="ltx_Math" alttext="d" display="inline" intent=":literal"><semantics><mi>d</mi><annotation encoding="application/x-tex">d</annotation></semantics></math> networks computing <math id="A5.SS2.p9.m4" class="ltx_Math" alttext="x\mapsto cx" display="inline" intent=":literal"><semantics><mrow><mi>x</mi><mo stretchy="false">↦</mo><mrow><mi>c</mi><mo lspace="0em" rspace="0em">​</mo><mi>x</mi></mrow></mrow><annotation encoding="application/x-tex">x\mapsto cx</annotation></semantics></math> and concatenate them into one large network computing <math id="A5.SS2.p9.m5" class="ltx_Math" alttext="\mathbf{x}\mapsto\mathbf{f}(\mathbf{x})=c\mathbf{x}" display="inline" intent=":literal"><semantics><mrow><mi>𝐱</mi><mo stretchy="false">↦</mo><mrow><mi>𝐟</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>𝐱</mi><mo stretchy="false">)</mo></mrow></mrow><mo>=</mo><mrow><mi>c</mi><mo lspace="0em" rspace="0em">​</mo><mi>𝐱</mi></mrow></mrow><annotation encoding="application/x-tex">\mathbf{x}\mapsto\mathbf{f}(\mathbf{x})=c\mathbf{x}</annotation></semantics></math>.</span></p>
</div>
<div id="A5.SS2.p10" class="ltx_para">
<p id="A5.SS2.p10.1" class="ltx_p"><span id="A5.SS2.p10.1.1" class="ltx_text">The first hidden layer consists of <math id="A5.SS2.p10.m1" class="ltx_Math" alttext="2M" display="inline" intent=":literal"><semantics><mrow><mn>2</mn><mo lspace="0em" rspace="0em">​</mo><mi>M</mi></mrow><annotation encoding="application/x-tex">2M</annotation></semantics></math> neurons, with <math id="A5.SS2.p10.m2" class="ltx_Math" alttext="M" display="inline" intent=":literal"><semantics><mi>M</mi><annotation encoding="application/x-tex">M</annotation></semantics></math> neurons computing
<math id="A5.SS2.p10.m3" class="ltx_Math" alttext="(Bx)_{+}=Bx\,\mathbb{I}(x\geq 0)" display="inline" intent=":literal"><semantics><mrow><msub><mrow><mo stretchy="false">(</mo><mrow><mi>B</mi><mo lspace="0em" rspace="0em">​</mo><mi>x</mi></mrow><mo stretchy="false">)</mo></mrow><mo>+</mo></msub><mo>=</mo><mrow><mi>B</mi><mo lspace="0em" rspace="0em">​</mo><mi>x</mi><mo lspace="0.170em" rspace="0em">​</mo><mi>𝕀</mi><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mrow><mi>x</mi><mo>≥</mo><mn>0</mn></mrow><mo stretchy="false">)</mo></mrow></mrow></mrow><annotation encoding="application/x-tex">(Bx)_{+}=Bx\,\mathbb{I}(x\geq 0)</annotation></semantics></math> and the remaining <math id="A5.SS2.p10.m4" class="ltx_Math" alttext="M" display="inline" intent=":literal"><semantics><mi>M</mi><annotation encoding="application/x-tex">M</annotation></semantics></math> neurons computing
<math id="A5.SS2.p10.m5" class="ltx_Math" alttext="(-Bx)_{+}=-Bx\,\mathbb{I}(x\leq 0)" display="inline" intent=":literal"><semantics><mrow><msub><mrow><mo stretchy="false">(</mo><mrow><mo>−</mo><mrow><mi>B</mi><mo lspace="0em" rspace="0em">​</mo><mi>x</mi></mrow></mrow><mo stretchy="false">)</mo></mrow><mo>+</mo></msub><mo>=</mo><mrow><mo>−</mo><mrow><mi>B</mi><mo lspace="0em" rspace="0em">​</mo><mi>x</mi><mo lspace="0.170em" rspace="0em">​</mo><mi>𝕀</mi><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mrow><mi>x</mi><mo>≤</mo><mn>0</mn></mrow><mo stretchy="false">)</mo></mrow></mrow></mrow></mrow><annotation encoding="application/x-tex">(-Bx)_{+}=-Bx\,\mathbb{I}(x\leq 0)</annotation></semantics></math>.
For each <math id="A5.SS2.p10.m6" class="ltx_Math" alttext="\ell\in[L-1]" display="inline" intent=":literal"><semantics><mrow><mi mathvariant="normal">ℓ</mi><mo>∈</mo><mrow><mo stretchy="false">[</mo><mrow><mi>L</mi><mo>−</mo><mn>1</mn></mrow><mo stretchy="false">]</mo></mrow></mrow><annotation encoding="application/x-tex">\ell\in[L-1]</annotation></semantics></math>, suppose that the <math id="A5.SS2.p10.m7" class="ltx_Math" alttext="\ell" display="inline" intent=":literal"><semantics><mi mathvariant="normal">ℓ</mi><annotation encoding="application/x-tex">\ell</annotation></semantics></math>-th hidden layer consists of
<math id="A5.SS2.p10.m8" class="ltx_Math" alttext="M" display="inline" intent=":literal"><semantics><mi>M</mi><annotation encoding="application/x-tex">M</annotation></semantics></math> neurons computing
<math id="A5.SS2.p10.m9" class="ltx_Math" alttext="M^{\ell-1}B^{\ell}x\,\mathbb{I}(x\geq 0)" display="inline" intent=":literal"><semantics><mrow><msup><mi>M</mi><mrow><mi mathvariant="normal">ℓ</mi><mo>−</mo><mn>1</mn></mrow></msup><mo lspace="0em" rspace="0em">​</mo><msup><mi>B</mi><mi mathvariant="normal">ℓ</mi></msup><mo lspace="0em" rspace="0em">​</mo><mi>x</mi><mo lspace="0.170em" rspace="0em">​</mo><mi>𝕀</mi><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mrow><mi>x</mi><mo>≥</mo><mn>0</mn></mrow><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">M^{\ell-1}B^{\ell}x\,\mathbb{I}(x\geq 0)</annotation></semantics></math> and the remaining <math id="A5.SS2.p10.m10" class="ltx_Math" alttext="M" display="inline" intent=":literal"><semantics><mi>M</mi><annotation encoding="application/x-tex">M</annotation></semantics></math> neurons
computing
<math id="A5.SS2.p10.m11" class="ltx_Math" alttext="-M^{\ell-1}B^{\ell}x\,\mathbb{I}(x\leq 0)" display="inline" intent=":literal"><semantics><mrow><mo>−</mo><mrow><msup><mi>M</mi><mrow><mi mathvariant="normal">ℓ</mi><mo>−</mo><mn>1</mn></mrow></msup><mo lspace="0em" rspace="0em">​</mo><msup><mi>B</mi><mi mathvariant="normal">ℓ</mi></msup><mo lspace="0em" rspace="0em">​</mo><mi>x</mi><mo lspace="0.170em" rspace="0em">​</mo><mi>𝕀</mi><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mrow><mi>x</mi><mo>≤</mo><mn>0</mn></mrow><mo stretchy="false">)</mo></mrow></mrow></mrow><annotation encoding="application/x-tex">-M^{\ell-1}B^{\ell}x\,\mathbb{I}(x\leq 0)</annotation></semantics></math>.
Then, in the <math id="A5.SS2.p10.m12" class="ltx_Math" alttext="(\ell+1)" display="inline" intent=":literal"><semantics><mrow><mo stretchy="false">(</mo><mrow><mi mathvariant="normal">ℓ</mi><mo>+</mo><mn>1</mn></mrow><mo stretchy="false">)</mo></mrow><annotation encoding="application/x-tex">(\ell+1)</annotation></semantics></math>-st hidden layer, we construct <math id="A5.SS2.p10.m13" class="ltx_Math" alttext="M" display="inline" intent=":literal"><semantics><mi>M</mi><annotation encoding="application/x-tex">M</annotation></semantics></math> neurons computing</span></p>
<table id="A5.Ex258" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="A5.Ex258.m1" class="ltx_Math" alttext="\bigl(MB\cdot M^{\ell-1}B^{\ell}x\,\mathbb{I}(x\geq 0)\bigr)_{+}=M^{\ell}B^{\ell+1}x\,\mathbb{I}(x\geq 0)," display="block" intent=":literal"><semantics><mrow><mrow><msub><mrow><mo maxsize="1.200em" minsize="1.200em">(</mo><mrow><mrow><mrow><mi>M</mi><mo lspace="0em" rspace="0em">​</mo><mi>B</mi></mrow><mo lspace="0.222em" rspace="0.222em">⋅</mo><msup><mi>M</mi><mrow><mi mathvariant="normal">ℓ</mi><mo>−</mo><mn>1</mn></mrow></msup></mrow><mo lspace="0em" rspace="0em">​</mo><msup><mi>B</mi><mi mathvariant="normal">ℓ</mi></msup><mo lspace="0em" rspace="0em">​</mo><mi>x</mi><mo lspace="0.170em" rspace="0em">​</mo><mi>𝕀</mi><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mrow><mi>x</mi><mo>≥</mo><mn>0</mn></mrow><mo stretchy="false">)</mo></mrow></mrow><mo maxsize="1.200em" minsize="1.200em">)</mo></mrow><mo>+</mo></msub><mo>=</mo><mrow><msup><mi>M</mi><mi mathvariant="normal">ℓ</mi></msup><mo lspace="0em" rspace="0em">​</mo><msup><mi>B</mi><mrow><mi mathvariant="normal">ℓ</mi><mo>+</mo><mn>1</mn></mrow></msup><mo lspace="0em" rspace="0em">​</mo><mi>x</mi><mo lspace="0.170em" rspace="0em">​</mo><mi>𝕀</mi><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mrow><mi>x</mi><mo>≥</mo><mn>0</mn></mrow><mo stretchy="false">)</mo></mrow></mrow></mrow><mo>,</mo></mrow><annotation encoding="application/x-tex">\bigl(MB\cdot M^{\ell-1}B^{\ell}x\,\mathbb{I}(x\geq 0)\bigr)_{+}=M^{\ell}B^{\ell+1}x\,\mathbb{I}(x\geq 0),</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="A5.SS2.p10.2" class="ltx_p"><span id="A5.SS2.p10.2.1" class="ltx_text">and the remaining <math id="A5.SS2.p10.m14" class="ltx_Math" alttext="M" display="inline" intent=":literal"><semantics><mi>M</mi><annotation encoding="application/x-tex">M</annotation></semantics></math> neurons computing</span></p>
<table id="A5.Ex259" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="A5.Ex259.m1" class="ltx_Math" alttext="\bigl(MB\cdot(-M^{\ell-1}B^{\ell}x\,\mathbb{I}(x\leq 0))\bigr)_{+}=-M^{\ell}B^{\ell+1}x\,\mathbb{I}(x\leq 0)." display="block" intent=":literal"><semantics><mrow><mrow><msub><mrow><mo maxsize="1.200em" minsize="1.200em">(</mo><mrow><mrow><mi>M</mi><mo lspace="0em" rspace="0em">​</mo><mi>B</mi></mrow><mo lspace="0.222em" rspace="0.222em">⋅</mo><mrow><mo stretchy="false">(</mo><mrow><mo>−</mo><mrow><msup><mi>M</mi><mrow><mi mathvariant="normal">ℓ</mi><mo>−</mo><mn>1</mn></mrow></msup><mo lspace="0em" rspace="0em">​</mo><msup><mi>B</mi><mi mathvariant="normal">ℓ</mi></msup><mo lspace="0em" rspace="0em">​</mo><mi>x</mi><mo lspace="0.170em" rspace="0em">​</mo><mi>𝕀</mi><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mrow><mi>x</mi><mo>≤</mo><mn>0</mn></mrow><mo stretchy="false">)</mo></mrow></mrow></mrow><mo stretchy="false">)</mo></mrow></mrow><mo maxsize="1.200em" minsize="1.200em">)</mo></mrow><mo>+</mo></msub><mo>=</mo><mrow><mo>−</mo><mrow><msup><mi>M</mi><mi mathvariant="normal">ℓ</mi></msup><mo lspace="0em" rspace="0em">​</mo><msup><mi>B</mi><mrow><mi mathvariant="normal">ℓ</mi><mo>+</mo><mn>1</mn></mrow></msup><mo lspace="0em" rspace="0em">​</mo><mi>x</mi><mo lspace="0.170em" rspace="0em">​</mo><mi>𝕀</mi><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mrow><mi>x</mi><mo>≤</mo><mn>0</mn></mrow><mo stretchy="false">)</mo></mrow></mrow></mrow></mrow><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">\bigl(MB\cdot(-M^{\ell-1}B^{\ell}x\,\mathbb{I}(x\leq 0))\bigr)_{+}=-M^{\ell}B^{\ell+1}x\,\mathbb{I}(x\leq 0).</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="A5.SS2.p10.3" class="ltx_p"><span id="A5.SS2.p10.3.1" class="ltx_text">By induction on <math id="A5.SS2.p10.m15" class="ltx_Math" alttext="\ell" display="inline" intent=":literal"><semantics><mi mathvariant="normal">ℓ</mi><annotation encoding="application/x-tex">\ell</annotation></semantics></math> from <math id="A5.SS2.p10.m16" class="ltx_Math" alttext="1" display="inline" intent=":literal"><semantics><mn>1</mn><annotation encoding="application/x-tex">1</annotation></semantics></math> to <math id="A5.SS2.p10.m17" class="ltx_Math" alttext="L-1" display="inline" intent=":literal"><semantics><mrow><mi>L</mi><mo>−</mo><mn>1</mn></mrow><annotation encoding="application/x-tex">L-1</annotation></semantics></math>, the last hidden layer consists of
<math id="A5.SS2.p10.m18" class="ltx_Math" alttext="2M" display="inline" intent=":literal"><semantics><mrow><mn>2</mn><mo lspace="0em" rspace="0em">​</mo><mi>M</mi></mrow><annotation encoding="application/x-tex">2M</annotation></semantics></math> neurons, with <math id="A5.SS2.p10.m19" class="ltx_Math" alttext="M" display="inline" intent=":literal"><semantics><mi>M</mi><annotation encoding="application/x-tex">M</annotation></semantics></math> neurons computing
<math id="A5.SS2.p10.m20" class="ltx_Math" alttext="M^{L-1}B^{L}x\,\mathbb{I}(x\geq 0)" display="inline" intent=":literal"><semantics><mrow><msup><mi>M</mi><mrow><mi>L</mi><mo>−</mo><mn>1</mn></mrow></msup><mo lspace="0em" rspace="0em">​</mo><msup><mi>B</mi><mi>L</mi></msup><mo lspace="0em" rspace="0em">​</mo><mi>x</mi><mo lspace="0.170em" rspace="0em">​</mo><mi>𝕀</mi><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mrow><mi>x</mi><mo>≥</mo><mn>0</mn></mrow><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">M^{L-1}B^{L}x\,\mathbb{I}(x\geq 0)</annotation></semantics></math> and the remaining <math id="A5.SS2.p10.m21" class="ltx_Math" alttext="M" display="inline" intent=":literal"><semantics><mi>M</mi><annotation encoding="application/x-tex">M</annotation></semantics></math> neurons
computing
<math id="A5.SS2.p10.m22" class="ltx_Math" alttext="-M^{L-1}B^{L}x\,\mathbb{I}(x\leq 0)" display="inline" intent=":literal"><semantics><mrow><mo>−</mo><mrow><msup><mi>M</mi><mrow><mi>L</mi><mo>−</mo><mn>1</mn></mrow></msup><mo lspace="0em" rspace="0em">​</mo><msup><mi>B</mi><mi>L</mi></msup><mo lspace="0em" rspace="0em">​</mo><mi>x</mi><mo lspace="0.170em" rspace="0em">​</mo><mi>𝕀</mi><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mrow><mi>x</mi><mo>≤</mo><mn>0</mn></mrow><mo stretchy="false">)</mo></mrow></mrow></mrow><annotation encoding="application/x-tex">-M^{L-1}B^{L}x\,\mathbb{I}(x\leq 0)</annotation></semantics></math>.
We obtain the assertion from</span></p>
<table id="A5.Ex260" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="A5.Ex260.m1" class="ltx_Math" alttext="M\cdot\frac{c}{(MB)^{L}}\cdot M^{L-1}B^{L}x\,\mathbb{I}(x\geq 0)+M\cdot\frac{-c}{(MB)^{L}}\cdot\big(-M^{L-1}B^{L}x\,\mathbb{I}(x\leq 0)\big)=cx." display="block" intent=":literal"><semantics><mrow><mrow><mrow><mrow><mi>M</mi><mo lspace="0.222em" rspace="0.222em">⋅</mo><mfrac><mi>c</mi><msup><mrow><mo stretchy="false">(</mo><mrow><mi>M</mi><mo lspace="0em" rspace="0em">​</mo><mi>B</mi></mrow><mo stretchy="false">)</mo></mrow><mi>L</mi></msup></mfrac><mo lspace="0.222em" rspace="0.222em">⋅</mo><mrow><msup><mi>M</mi><mrow><mi>L</mi><mo>−</mo><mn>1</mn></mrow></msup><mo lspace="0em" rspace="0em">​</mo><msup><mi>B</mi><mi>L</mi></msup><mo lspace="0em" rspace="0em">​</mo><mi>x</mi><mo lspace="0.170em" rspace="0em">​</mo><mi>𝕀</mi><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mrow><mi>x</mi><mo>≥</mo><mn>0</mn></mrow><mo stretchy="false">)</mo></mrow></mrow></mrow><mo>+</mo><mrow><mi>M</mi><mo lspace="0.222em" rspace="0.222em">⋅</mo><mfrac><mrow><mo>−</mo><mi>c</mi></mrow><msup><mrow><mo stretchy="false">(</mo><mrow><mi>M</mi><mo lspace="0em" rspace="0em">​</mo><mi>B</mi></mrow><mo stretchy="false">)</mo></mrow><mi>L</mi></msup></mfrac><mo lspace="0.222em" rspace="0.222em">⋅</mo><mrow><mo maxsize="1.200em" minsize="1.200em">(</mo><mrow><mo>−</mo><mrow><msup><mi>M</mi><mrow><mi>L</mi><mo>−</mo><mn>1</mn></mrow></msup><mo lspace="0em" rspace="0em">​</mo><msup><mi>B</mi><mi>L</mi></msup><mo lspace="0em" rspace="0em">​</mo><mi>x</mi><mo lspace="0.170em" rspace="0em">​</mo><mi>𝕀</mi><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mrow><mi>x</mi><mo>≤</mo><mn>0</mn></mrow><mo stretchy="false">)</mo></mrow></mrow></mrow><mo maxsize="1.200em" minsize="1.200em">)</mo></mrow></mrow></mrow><mo>=</mo><mrow><mi>c</mi><mo lspace="0em" rspace="0em">​</mo><mi>x</mi></mrow></mrow><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">M\cdot\frac{c}{(MB)^{L}}\cdot M^{L-1}B^{L}x\,\mathbb{I}(x\geq 0)+M\cdot\frac{-c}{(MB)^{L}}\cdot\big(-M^{L-1}B^{L}x\,\mathbb{I}(x\leq 0)\big)=cx.</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="A5.SS2.p10.4" class="ltx_p"><span id="A5.SS2.p10.4.1" class="ltx_text">∎</span></p>
</div>
</div>
<div id="Thmconj223" class="ltx_theorem ltx_theorem_lemma">
<h6 class="ltx_title ltx_runin ltx_title_theorem"><span class="ltx_tag ltx_tag_theorem"><span id="Thmconj223.4" class="ltx_text ltx_font_bold">Lemma 23</span></span><span id="Thmconj223.5" class="ltx_text ltx_font_bold">.</span></h6>
<div id="Thmconj223.p1" class="ltx_para">
<p id="Thmconj223.p1.1" class="ltx_p"><span id="Thmconj223.p1.1.1" class="ltx_text ltx_font_italic">Under Assumption <a href="#Thmassumpt3" title="Assumption 3. ‣ 4 Risk bound ‣ Generalization Bounds for Transformer-Based Next-Token Prediction in a Language Model" class="ltx_ref"><span class="ltx_text ltx_ref_tag">3</span></a> and any <math id="Thmconj223.p1.m1" class="ltx_Math" alttext="M\geq 1+2\log^{2}T" display="inline" intent=":literal"><semantics><mrow><mi>M</mi><mo>≥</mo><mrow><mn>1</mn><mo>+</mo><mrow><mn>2</mn><mo lspace="0.167em" rspace="0em">​</mo><msup><mi>log</mi><mn>2</mn></msup><mo lspace="0.167em" rspace="0em">​</mo><mi>T</mi></mrow></mrow></mrow><annotation encoding="application/x-tex">M\geq 1+2\log^{2}T</annotation></semantics></math>, <math id="Thmconj223.p1.m2" class="ltx_Math" alttext="J\geq 2" display="inline" intent=":literal"><semantics><mrow><mi>J</mi><mo>≥</mo><mn>2</mn></mrow><annotation encoding="application/x-tex">J\geq 2</annotation></semantics></math> and <math id="Thmconj223.p1.m3" class="ltx_Math" alttext="c\leq(MB)^{J-2}" display="inline" intent=":literal"><semantics><mrow><mi>c</mi><mo>≤</mo><msup><mrow><mo stretchy="false">(</mo><mrow><mi>M</mi><mo lspace="0em" rspace="0em">​</mo><mi>B</mi></mrow><mo stretchy="false">)</mo></mrow><mrow><mi>J</mi><mo>−</mo><mn>2</mn></mrow></msup></mrow><annotation encoding="application/x-tex">c\leq(MB)^{J-2}</annotation></semantics></math>,
there exists <math id="Thmconj223.p1.m4" class="ltx_Math" alttext="f\in\mathcal{MLP}(\tfrac{N}{2},1,J,M,B)" display="inline" intent=":literal"><semantics><mrow><mi>f</mi><mo>∈</mo><mrow><mi class="ltx_font_mathcaligraphic">ℳ</mi><mo lspace="0em" rspace="0em">​</mo><mi class="ltx_font_mathcaligraphic">ℒ</mi><mo lspace="0em" rspace="0em">​</mo><mi class="ltx_font_mathcaligraphic">𝒫</mi><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mfrac><mi>N</mi><mn>2</mn></mfrac><mo>,</mo><mn>1</mn><mo>,</mo><mi>J</mi><mo>,</mo><mi>M</mi><mo>,</mo><mi>B</mi><mo stretchy="false">)</mo></mrow></mrow></mrow><annotation encoding="application/x-tex">f\in\mathcal{MLP}(\tfrac{N}{2},1,J,M,B)</annotation></semantics></math> such that for every <math id="Thmconj223.p1.m5" class="ltx_Math" alttext="t\in[T]" display="inline" intent=":literal"><semantics><mrow><mi>t</mi><mo>∈</mo><mrow><mo stretchy="false">[</mo><mi>T</mi><mo stretchy="false">]</mo></mrow></mrow><annotation encoding="application/x-tex">t\in[T]</annotation></semantics></math>,</span></p>
<table id="A5.Ex261" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="A5.Ex261.m1" class="ltx_Math" alttext="f(\mathbf{q}_{t})=c\,\mathbb{I}\big(t\in[\log^{2}T,T-\log^{2}T]\big)." display="block" intent=":literal"><semantics><mrow><mrow><mrow><mi>f</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><msub><mi>𝐪</mi><mi>t</mi></msub><mo stretchy="false">)</mo></mrow></mrow><mo>=</mo><mrow><mi>c</mi><mo lspace="0.170em" rspace="0em">​</mo><mi>𝕀</mi><mo lspace="0em" rspace="0em">​</mo><mrow><mo maxsize="1.200em" minsize="1.200em">(</mo><mrow><mi>t</mi><mo>∈</mo><mrow><mo stretchy="false">[</mo><mrow><mrow><msup><mi>log</mi><mn>2</mn></msup><mo lspace="0.167em">⁡</mo><mi>T</mi></mrow><mo>,</mo><mrow><mi>T</mi><mo>−</mo><mrow><msup><mi>log</mi><mn>2</mn></msup><mo lspace="0.167em">⁡</mo><mi>T</mi></mrow></mrow></mrow><mo stretchy="false">]</mo></mrow></mrow><mo maxsize="1.200em" minsize="1.200em">)</mo></mrow></mrow></mrow><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">f(\mathbf{q}_{t})=c\,\mathbb{I}\big(t\in[\log^{2}T,T-\log^{2}T]\big).</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
</div>
</div>
<div id="A5.SS2.7" class="ltx_proof">
<h6 class="ltx_title ltx_runin ltx_font_italic ltx_title_proof">Proof.</h6>
<div id="A5.SS2.p11" class="ltx_para">
<p id="A5.SS2.p11.1" class="ltx_p"><span id="A5.SS2.p11.1.1" class="ltx_text">By Assumption <a href="#Thmassumpt3" title="Assumption 3. ‣ 4 Risk bound ‣ Generalization Bounds for Transformer-Based Next-Token Prediction in a Language Model" class="ltx_ref"><span class="ltx_text ltx_ref_tag">3</span></a>, we have
<math id="A5.SS2.p11.m1" class="ltx_Math" alttext="3T^{8/N}\leq 3T^{1/\log T}\leq B." display="inline" intent=":literal"><semantics><mrow><mrow><mrow><mn>3</mn><mo lspace="0em" rspace="0em">​</mo><msup><mi>T</mi><mrow><mn>8</mn><mo>/</mo><mi>N</mi></mrow></msup></mrow><mo>≤</mo><mrow><mn>3</mn><mo lspace="0em" rspace="0em">​</mo><msup><mi>T</mi><mrow><mn>1</mn><mo>/</mo><mrow><mi>log</mi><mo lspace="0.167em">⁡</mo><mi>T</mi></mrow></mrow></msup></mrow><mo>≤</mo><mi>B</mi></mrow><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">3T^{8/N}\leq 3T^{1/\log T}\leq B.</annotation></semantics></math>
By Lemma <a href="#Thmconj212" title="Lemma 12. ‣ E.1 Construction of multi-head self-attention layers ‣ Appendix E Construction of the Transformer ‣ Generalization Bounds for Transformer-Based Next-Token Prediction in a Language Model" class="ltx_ref"><span class="ltx_text ltx_ref_tag">12</span></a> with <math id="A5.SS2.p11.m2" class="ltx_Math" alttext="A=N/4" display="inline" intent=":literal"><semantics><mrow><mi>A</mi><mo>=</mo><mrow><mi>N</mi><mo>/</mo><mn>4</mn></mrow></mrow><annotation encoding="application/x-tex">A=N/4</annotation></semantics></math> as in
Definition <a href="#S3.Thmconj6" title="Definition 3.6 (Positional encoding). ‣ 3 The transformer function class ‣ Generalization Bounds for Transformer-Based Next-Token Prediction in a Language Model" class="ltx_ref"><span class="ltx_text ltx_ref_tag">3.6</span></a>, for every <math id="A5.SS2.p11.m3" class="ltx_Math" alttext="t_{1},t_{2}\in[T]" display="inline" intent=":literal"><semantics><mrow><msub><mi>t</mi><mn>1</mn></msub><mo>,</mo><mrow><msub><mi>t</mi><mn>2</mn></msub><mo>∈</mo><mrow><mo stretchy="false">[</mo><mi>T</mi><mo stretchy="false">]</mo></mrow></mrow></mrow><annotation encoding="application/x-tex">t_{1},t_{2}\in[T]</annotation></semantics></math>,</span></p>
<table id="A5.EGx113" class="ltx_equationgroup ltx_eqn_align ltx_eqn_table">

<tbody id="A5.Ex262"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_align_right ltx_eqn_cell"><math id="A5.Ex262.m1" class="ltx_Math" alttext="\displaystyle\left(\mathbf{q}_{t_{1}}^{\top}\mathbf{q}_{t_{2}}-\frac{N}{4}+\frac{1}{B}\right)_{+}=\frac{1}{B}\,\mathbb{I}(t_{1}=t_{2})," display="inline" intent=":literal"><semantics><mrow><mrow><msub><mrow><mo>(</mo><mrow><mrow><mrow><msubsup><mi>𝐪</mi><msub><mi>t</mi><mn>1</mn></msub><mo>⊤</mo></msubsup><mo lspace="0em" rspace="0em">​</mo><msub><mi>𝐪</mi><msub><mi>t</mi><mn>2</mn></msub></msub></mrow><mo>−</mo><mstyle displaystyle="true"><mfrac><mi>N</mi><mn>4</mn></mfrac></mstyle></mrow><mo>+</mo><mstyle displaystyle="true"><mfrac><mn>1</mn><mi>B</mi></mfrac></mstyle></mrow><mo>)</mo></mrow><mo>+</mo></msub><mo>=</mo><mrow><mstyle displaystyle="true"><mfrac><mn>1</mn><mi>B</mi></mfrac></mstyle><mo lspace="0.170em" rspace="0em">​</mo><mi>𝕀</mi><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mrow><msub><mi>t</mi><mn>1</mn></msub><mo>=</mo><msub><mi>t</mi><mn>2</mn></msub></mrow><mo stretchy="false">)</mo></mrow></mrow></mrow><mo>,</mo></mrow><annotation encoding="application/x-tex">\displaystyle\left(\mathbf{q}_{t_{1}}^{\top}\mathbf{q}_{t_{2}}-\frac{N}{4}+\frac{1}{B}\right)_{+}=\frac{1}{B}\,\mathbb{I}(t_{1}=t_{2}),</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="A5.SS2.p11.2" class="ltx_p"><span id="A5.SS2.p11.2.1" class="ltx_text">where we used <math id="A5.SS2.p11.m4" class="ltx_Math" alttext="(-(3T^{1/\log T})^{-1}+B^{-1})_{+}=0" display="inline" intent=":literal"><semantics><mrow><msub><mrow><mo stretchy="false">(</mo><mrow><mrow><mo>−</mo><msup><mrow><mo stretchy="false">(</mo><mrow><mn>3</mn><mo lspace="0em" rspace="0em">​</mo><msup><mi>T</mi><mrow><mn>1</mn><mo>/</mo><mrow><mi>log</mi><mo lspace="0.167em">⁡</mo><mi>T</mi></mrow></mrow></msup></mrow><mo stretchy="false">)</mo></mrow><mrow><mo>−</mo><mn>1</mn></mrow></msup></mrow><mo>+</mo><msup><mi>B</mi><mrow><mo>−</mo><mn>1</mn></mrow></msup></mrow><mo stretchy="false">)</mo></mrow><mo>+</mo></msub><mo>=</mo><mn>0</mn></mrow><annotation encoding="application/x-tex">(-(3T^{1/\log T})^{-1}+B^{-1})_{+}=0</annotation></semantics></math> when <math id="A5.SS2.p11.m5" class="ltx_Math" alttext="t_{1}\neq t_{2}" display="inline" intent=":literal"><semantics><mrow><msub><mi>t</mi><mn>1</mn></msub><mo>≠</mo><msub><mi>t</mi><mn>2</mn></msub></mrow><annotation encoding="application/x-tex">t_{1}\neq t_{2}</annotation></semantics></math>.
Summing up, we get</span></p>
<table id="A5.EGx114" class="ltx_equationgroup ltx_eqn_align ltx_eqn_table">

<tbody id="A5.Ex263"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_align_right ltx_eqn_cell"><math id="A5.Ex263.m1" class="ltx_math_unparsed" alttext="\displaystyle\sum_{s\in[1,\log^{2}T)}\left(\mathbf{q}_{s}^{\top}\mathbf{q}_{t}-\frac{N}{4}+\frac{1}{B}\right)_{+}+\sum_{s\in(T-\log^{2}T,T]}\left(\mathbf{q}_{s}^{\top}\mathbf{q}_{t}-\frac{N}{4}+\frac{1}{B}\right)_{+}=\frac{1}{B}\,\mathbb{I}(t\notin[\log^{2}T,T-\log^{2}T])." display="inline" intent=":literal"><semantics><mrow><mstyle displaystyle="true"><munder><mo movablelimits="false">∑</mo><mrow><mi>s</mi><mo>∈</mo><mrow><mo stretchy="false">[</mo><mn>1</mn><mo>,</mo><mrow><msup><mi>log</mi><mn>2</mn></msup><mo lspace="0.167em">⁡</mo><mi>T</mi></mrow><mo stretchy="false">)</mo></mrow></mrow></munder></mstyle><msub><mrow><mo>(</mo><msubsup><mi>𝐪</mi><mi>s</mi><mo>⊤</mo></msubsup><msub><mi>𝐪</mi><mi>t</mi></msub><mo>−</mo><mstyle displaystyle="true"><mfrac><mi>N</mi><mn>4</mn></mfrac></mstyle><mo>+</mo><mstyle displaystyle="true"><mfrac><mn>1</mn><mi>B</mi></mfrac></mstyle><mo>)</mo></mrow><mo>+</mo></msub><mo>+</mo><mstyle displaystyle="true"><munder><mo movablelimits="false">∑</mo><mrow><mi>s</mi><mo>∈</mo><mo stretchy="false">(</mo><mi>T</mi><mo>−</mo><mi>log</mi><msup><mrow></mrow><mn>2</mn></msup><mi>T</mi><mo>,</mo><mi>T</mi><mo stretchy="false">]</mo></mrow></munder></mstyle><msub><mrow><mo>(</mo><msubsup><mi>𝐪</mi><mi>s</mi><mo>⊤</mo></msubsup><msub><mi>𝐪</mi><mi>t</mi></msub><mo>−</mo><mstyle displaystyle="true"><mfrac><mi>N</mi><mn>4</mn></mfrac></mstyle><mo>+</mo><mstyle displaystyle="true"><mfrac><mn>1</mn><mi>B</mi></mfrac></mstyle><mo>)</mo></mrow><mo>+</mo></msub><mo>=</mo><mstyle displaystyle="true"><mfrac><mn>1</mn><mi>B</mi></mfrac></mstyle><mi>𝕀</mi><mrow><mo stretchy="false">(</mo><mi>t</mi><mo>∉</mo><mrow><mo stretchy="false">[</mo><msup><mi>log</mi><mn>2</mn></msup><mi>T</mi><mo>,</mo><mi>T</mi><mo>−</mo><msup><mi>log</mi><mn>2</mn></msup><mi>T</mi><mo stretchy="false">]</mo></mrow><mo stretchy="false">)</mo></mrow><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">\displaystyle\sum_{s\in[1,\log^{2}T)}\left(\mathbf{q}_{s}^{\top}\mathbf{q}_{t}-\frac{N}{4}+\frac{1}{B}\right)_{+}+\sum_{s\in(T-\log^{2}T,T]}\left(\mathbf{q}_{s}^{\top}\mathbf{q}_{t}-\frac{N}{4}+\frac{1}{B}\right)_{+}=\frac{1}{B}\,\mathbb{I}(t\notin[\log^{2}T,T-\log^{2}T]).</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="A5.SS2.p11.3" class="ltx_p"><span id="A5.SS2.p11.3.1" class="ltx_text">In the first hidden layer,
we construct <math id="A5.SS2.p11.m6" class="ltx_Math" alttext="\leq 1+2\log^{2}T" display="inline" intent=":literal"><semantics><mrow><mphantom></mphantom><mo>≤</mo><mrow><mn>1</mn><mo>+</mo><mrow><mn>2</mn><mo lspace="0.167em" rspace="0em">​</mo><msup><mi>log</mi><mn>2</mn></msup><mo lspace="0.167em" rspace="0em">​</mo><mi>T</mi></mrow></mrow></mrow><annotation encoding="application/x-tex">\leq 1+2\log^{2}T</annotation></semantics></math> neurons computing</span></p>
<table id="A5.Ex264" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="A5.Ex264.m1" class="ltx_Math" alttext="\mathbf{q}_{t}\mapsto\left\{\left(\mathbf{q}_{s}^{\top}\mathbf{q}_{t}-\frac{N}{4}+\frac{1}{B}\right)_{+}\right\}_{s\in[T]\setminus[\log^{2}T,T-\log^{2}T]}." display="block" intent=":literal"><semantics><mrow><mrow><msub><mi>𝐪</mi><mi>t</mi></msub><mo stretchy="false">↦</mo><msub><mrow><mo>{</mo><msub><mrow><mo>(</mo><mrow><mrow><mrow><msubsup><mi>𝐪</mi><mi>s</mi><mo>⊤</mo></msubsup><mo lspace="0em" rspace="0em">​</mo><msub><mi>𝐪</mi><mi>t</mi></msub></mrow><mo>−</mo><mfrac><mi>N</mi><mn>4</mn></mfrac></mrow><mo>+</mo><mfrac><mn>1</mn><mi>B</mi></mfrac></mrow><mo>)</mo></mrow><mo>+</mo></msub><mo>}</mo></mrow><mrow><mi>s</mi><mo>∈</mo><mrow><mrow><mo stretchy="false">[</mo><mi>T</mi><mo stretchy="false">]</mo></mrow><mo>∖</mo><mrow><mo stretchy="false">[</mo><mrow><mrow><msup><mi>log</mi><mn>2</mn></msup><mo lspace="0.167em">⁡</mo><mi>T</mi></mrow><mo>,</mo><mrow><mi>T</mi><mo>−</mo><mrow><msup><mi>log</mi><mn>2</mn></msup><mo lspace="0.167em">⁡</mo><mi>T</mi></mrow></mrow></mrow><mo stretchy="false">]</mo></mrow></mrow></mrow></msub></mrow><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">\mathbf{q}_{t}\mapsto\left\{\left(\mathbf{q}_{s}^{\top}\mathbf{q}_{t}-\frac{N}{4}+\frac{1}{B}\right)_{+}\right\}_{s\in[T]\setminus[\log^{2}T,T-\log^{2}T]}.</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="A5.SS2.p11.4" class="ltx_p"><span id="A5.SS2.p11.4.1" class="ltx_text">In the second hidden layer, we construct one neuron computing</span></p>
<table id="A5.EGx115" class="ltx_equationgroup ltx_eqn_align ltx_eqn_table">

<tbody id="A5.Ex265"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_align_right ltx_eqn_cell"><math id="A5.Ex265.m1" class="ltx_Math" alttext="\displaystyle\mathbf{q}_{t}\mapsto" display="inline" intent=":literal"><semantics><mrow><msub><mi>𝐪</mi><mi>t</mi></msub><mo stretchy="false">↦</mo><mphantom></mphantom></mrow><annotation encoding="application/x-tex">\displaystyle\mathbf{q}_{t}\mapsto</annotation></semantics></math></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A5.Ex265.m2" class="ltx_math_unparsed" alttext="\displaystyle\left(1-\sum_{s\in[1,\log^{2}T)}B\left(\mathbf{q}_{s}^{\top}\mathbf{q}_{t}-\frac{N}{4}+\frac{1}{B}\right)_{+}-\sum_{s\in(T-\log^{2}T,T]}B\left(\mathbf{q}_{s}^{\top}\mathbf{q}_{t}-\frac{N}{4}+\frac{1}{B}\right)_{+}\right)_{+}" display="inline" intent=":literal"><semantics><msub><mrow><mo>(</mo><mn>1</mn><mo>−</mo><mstyle displaystyle="true"><munder><mo movablelimits="false">∑</mo><mrow><mi>s</mi><mo>∈</mo><mrow><mo stretchy="false">[</mo><mn>1</mn><mo>,</mo><mrow><msup><mi>log</mi><mn>2</mn></msup><mo lspace="0.167em">⁡</mo><mi>T</mi></mrow><mo stretchy="false">)</mo></mrow></mrow></munder></mstyle><mi>B</mi><msub><mrow><mo>(</mo><msubsup><mi>𝐪</mi><mi>s</mi><mo>⊤</mo></msubsup><msub><mi>𝐪</mi><mi>t</mi></msub><mo>−</mo><mstyle displaystyle="true"><mfrac><mi>N</mi><mn>4</mn></mfrac></mstyle><mo>+</mo><mstyle displaystyle="true"><mfrac><mn>1</mn><mi>B</mi></mfrac></mstyle><mo>)</mo></mrow><mo>+</mo></msub><mo>−</mo><mstyle displaystyle="true"><munder><mo movablelimits="false">∑</mo><mrow><mi>s</mi><mo>∈</mo><mo stretchy="false">(</mo><mi>T</mi><mo>−</mo><mi>log</mi><msup><mrow></mrow><mn>2</mn></msup><mi>T</mi><mo>,</mo><mi>T</mi><mo stretchy="false">]</mo></mrow></munder></mstyle><mi>B</mi><msub><mrow><mo>(</mo><msubsup><mi>𝐪</mi><mi>s</mi><mo>⊤</mo></msubsup><msub><mi>𝐪</mi><mi>t</mi></msub><mo>−</mo><mstyle displaystyle="true"><mfrac><mi>N</mi><mn>4</mn></mfrac></mstyle><mo>+</mo><mstyle displaystyle="true"><mfrac><mn>1</mn><mi>B</mi></mfrac></mstyle><mo>)</mo></mrow><mo>+</mo></msub><mo>)</mo></mrow><mo>+</mo></msub><annotation encoding="application/x-tex">\displaystyle\left(1-\sum_{s\in[1,\log^{2}T)}B\left(\mathbf{q}_{s}^{\top}\mathbf{q}_{t}-\frac{N}{4}+\frac{1}{B}\right)_{+}-\sum_{s\in(T-\log^{2}T,T]}B\left(\mathbf{q}_{s}^{\top}\mathbf{q}_{t}-\frac{N}{4}+\frac{1}{B}\right)_{+}\right)_{+}</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
<tbody id="A5.Ex266"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_eqn_cell"></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A5.Ex266.m1" class="ltx_Math" alttext="\displaystyle=\mathbb{I}(t\in[\log^{2}T,T-\log^{2}T])." display="inline" intent=":literal"><semantics><mrow><mrow><mphantom></mphantom><mo>=</mo><mrow><mi>𝕀</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mrow><mi>t</mi><mo>∈</mo><mrow><mo stretchy="false">[</mo><mrow><mrow><msup><mi>log</mi><mn>2</mn></msup><mo lspace="0.167em">⁡</mo><mi>T</mi></mrow><mo>,</mo><mrow><mi>T</mi><mo>−</mo><mrow><msup><mi>log</mi><mn>2</mn></msup><mo lspace="0.167em">⁡</mo><mi>T</mi></mrow></mrow></mrow><mo stretchy="false">]</mo></mrow></mrow><mo stretchy="false">)</mo></mrow></mrow></mrow><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">\displaystyle=\mathbb{I}(t\in[\log^{2}T,T-\log^{2}T]).</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="A5.SS2.p11.5" class="ltx_p"><span id="A5.SS2.p11.5.1" class="ltx_text">By applying Lemma <a href="#Thmconj222" title="Lemma 22. ‣ E.2 Construction of multilayer perceptron layers ‣ Appendix E Construction of the Transformer ‣ Generalization Bounds for Transformer-Based Next-Token Prediction in a Language Model" class="ltx_ref"><span class="ltx_text ltx_ref_tag">22</span></a> to the remaining <math id="A5.SS2.p11.m7" class="ltx_Math" alttext="J-2" display="inline" intent=":literal"><semantics><mrow><mi>J</mi><mo>−</mo><mn>2</mn></mrow><annotation encoding="application/x-tex">J-2</annotation></semantics></math> hidden layers, we obtain the desired network output.
∎</span></p>
</div>
</div>
<div id="A5.SS2.p12" class="ltx_para">
<p id="A5.SS2.p12.1" class="ltx_p">Recall that, given vectors <math id="A5.SS2.p12.m1" class="ltx_Math" alttext="\mathbf{v}_{1}\in\mathbb{R}^{d_{1}}" display="inline" intent=":literal"><semantics><mrow><msub><mi>𝐯</mi><mn>1</mn></msub><mo>∈</mo><msup><mi>ℝ</mi><msub><mi>d</mi><mn>1</mn></msub></msup></mrow><annotation encoding="application/x-tex">\mathbf{v}_{1}\in\mathbb{R}^{d_{1}}</annotation></semantics></math> and
<math id="A5.SS2.p12.m2" class="ltx_Math" alttext="\mathbf{v}_{2}\in\mathbb{R}^{d_{2}}" display="inline" intent=":literal"><semantics><mrow><msub><mi>𝐯</mi><mn>2</mn></msub><mo>∈</mo><msup><mi>ℝ</mi><msub><mi>d</mi><mn>2</mn></msub></msup></mrow><annotation encoding="application/x-tex">\mathbf{v}_{2}\in\mathbb{R}^{d_{2}}</annotation></semantics></math> and a function
<math id="A5.SS2.p12.m3" class="ltx_Math" alttext="\mathbf{f}:\mathbb{R}^{d_{1}+d_{2}}\rightarrow\mathbb{R}^{m}" display="inline" intent=":literal"><semantics><mrow><mi>𝐟</mi><mo lspace="0.278em" rspace="0.278em">:</mo><mrow><msup><mi>ℝ</mi><mrow><msub><mi>d</mi><mn>1</mn></msub><mo>+</mo><msub><mi>d</mi><mn>2</mn></msub></mrow></msup><mo stretchy="false">→</mo><msup><mi>ℝ</mi><mi>m</mi></msup></mrow></mrow><annotation encoding="application/x-tex">\mathbf{f}:\mathbb{R}^{d_{1}+d_{2}}\rightarrow\mathbb{R}^{m}</annotation></semantics></math>, we write
<math id="A5.SS2.p12.m4" class="ltx_Math" alttext="\mathbf{f}(\mathbf{v}_{1},\mathbf{v}_{2})" display="inline" intent=":literal"><semantics><mrow><mi>𝐟</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><msub><mi>𝐯</mi><mn>1</mn></msub><mo>,</mo><msub><mi>𝐯</mi><mn>2</mn></msub><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">\mathbf{f}(\mathbf{v}_{1},\mathbf{v}_{2})</annotation></semantics></math> for <math id="A5.SS2.p12.m5" class="ltx_Math" alttext="\mathbf{f}(\operatorname{stack}(\mathbf{v}_{1},\mathbf{v}_{2}))" display="inline" intent=":literal"><semantics><mrow><mi>𝐟</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mrow><mi>stack</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><msub><mi>𝐯</mi><mn>1</mn></msub><mo>,</mo><msub><mi>𝐯</mi><mn>2</mn></msub><mo stretchy="false">)</mo></mrow></mrow><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">\mathbf{f}(\operatorname{stack}(\mathbf{v}_{1},\mathbf{v}_{2}))</annotation></semantics></math>.</p>
</div>
<div id="Thmconj224" class="ltx_theorem ltx_theorem_lemma">
<h6 class="ltx_title ltx_runin ltx_title_theorem"><span class="ltx_tag ltx_tag_theorem"><span id="Thmconj224.4" class="ltx_text ltx_font_bold">Lemma 24</span></span><span id="Thmconj224.5" class="ltx_text ltx_font_bold">.</span></h6>
<div id="Thmconj224.p1" class="ltx_para">
<p id="Thmconj224.p1.1" class="ltx_p"><span id="Thmconj224.p1.1.1" class="ltx_text ltx_font_italic">Suppose Assumption <a href="#Thmassumpt3" title="Assumption 3. ‣ 4 Risk bound ‣ Generalization Bounds for Transformer-Based Next-Token Prediction in a Language Model" class="ltx_ref"><span class="ltx_text ltx_ref_tag">3</span></a> holds.
For sufficiently large <math id="Thmconj224.p1.m1" class="ltx_Math" alttext="T" display="inline" intent=":literal"><semantics><mi>T</mi><annotation encoding="application/x-tex">T</annotation></semantics></math> and for any <math id="Thmconj224.p1.m2" class="ltx_Math" alttext="\lambda\geq T^{-1}" display="inline" intent=":literal"><semantics><mrow><mi>λ</mi><mo>≥</mo><msup><mi>T</mi><mrow><mo>−</mo><mn>1</mn></mrow></msup></mrow><annotation encoding="application/x-tex">\lambda\geq T^{-1}</annotation></semantics></math>,
there exists a multi-head self-attention <math id="Thmconj224.p1.m3" class="ltx_Math" alttext="\bm{\nu}_{1}\in\mathcal{MLP}(N,N,L_{\mathrm{mlp}},N_{\mathrm{mlp}},B)" display="inline" intent=":literal"><semantics><mrow><msub><mi>𝛎</mi><mn>1</mn></msub><mo>∈</mo><mrow><mi class="ltx_font_mathcaligraphic">ℳ</mi><mo lspace="0em" rspace="0em">​</mo><mi class="ltx_font_mathcaligraphic">ℒ</mi><mo lspace="0em" rspace="0em">​</mo><mi class="ltx_font_mathcaligraphic">𝒫</mi><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>N</mi><mo>,</mo><mi>N</mi><mo>,</mo><msub><mi>L</mi><mi>mlp</mi></msub><mo>,</mo><msub><mi>N</mi><mi>mlp</mi></msub><mo>,</mo><mi>B</mi><mo stretchy="false">)</mo></mrow></mrow></mrow><annotation encoding="application/x-tex">\bm{\nu}_{1}\in\mathcal{MLP}(N,N,L_{\mathrm{mlp}},N_{\mathrm{mlp}},B)</annotation></semantics></math> such that for any <math id="Thmconj224.p1.m4" class="ltx_Math" alttext="t\in[T]" display="inline" intent=":literal"><semantics><mrow><mi>t</mi><mo>∈</mo><mrow><mo stretchy="false">[</mo><mi>T</mi><mo stretchy="false">]</mo></mrow></mrow><annotation encoding="application/x-tex">t\in[T]</annotation></semantics></math>,</span></p>
