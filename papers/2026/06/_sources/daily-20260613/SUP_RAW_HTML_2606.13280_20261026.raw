<table id="A5.EGx100" class="ltx_equationgroup ltx_eqn_align ltx_eqn_table">

<tbody id="A5.E54"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_align_right ltx_eqn_cell"><math id="A5.E54.m1" class="ltx_Math" alttext="\displaystyle\mathbf{y}_{t}\coloneqq\overline{\sum}_{s\in[T]}\Big(\exp\big(\big\langle\operatorname{stack}(\mathbf{x}_{3,s},\mathbf{x}_{4,s}),\operatorname{stack}(\mathbf{x}_{4,t},\mathbf{x}_{5,t})\big\rangle-x_{6,s}x_{6,t}+\tfrac{\lambda}{\sqrt{r_{2}}}x_{7,s}x_{6,t}\big)\,;\,\mathbf{x}_{2,s}\Big)," display="inline" intent=":literal"><semantics><mrow><mrow><msub><mi>𝐲</mi><mi>t</mi></msub><mo>≔</mo><mrow><msub><mover accent="true"><mstyle displaystyle="true"><mo movablelimits="false">∑</mo></mstyle><mo stretchy="true">¯</mo></mover><mrow><mi>s</mi><mo>∈</mo><mrow><mo stretchy="false">[</mo><mi>T</mi><mo stretchy="false">]</mo></mrow></mrow></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo maxsize="1.600em" minsize="1.600em">(</mo><mrow><mi>exp</mi><mo>⁡</mo><mrow><mo maxsize="1.200em" minsize="1.200em">(</mo><mrow><mrow><mrow><mo stretchy="false">⟨</mo><mrow><mrow><mi>stack</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><msub><mi>𝐱</mi><mrow><mn>3</mn><mo>,</mo><mi>s</mi></mrow></msub><mo>,</mo><msub><mi>𝐱</mi><mrow><mn>4</mn><mo>,</mo><mi>s</mi></mrow></msub><mo stretchy="false">)</mo></mrow></mrow><mo>,</mo><mrow><mi>stack</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><msub><mi>𝐱</mi><mrow><mn>4</mn><mo>,</mo><mi>t</mi></mrow></msub><mo>,</mo><msub><mi>𝐱</mi><mrow><mn>5</mn><mo>,</mo><mi>t</mi></mrow></msub><mo stretchy="false">)</mo></mrow></mrow></mrow><mo stretchy="false">⟩</mo></mrow><mo>−</mo><mrow><msub><mi>x</mi><mrow><mn>6</mn><mo>,</mo><mi>s</mi></mrow></msub><mo lspace="0em" rspace="0em">​</mo><msub><mi>x</mi><mrow><mn>6</mn><mo>,</mo><mi>t</mi></mrow></msub></mrow></mrow><mo>+</mo><mrow><mfrac><mi>λ</mi><msqrt><msub><mi>r</mi><mn>2</mn></msub></msqrt></mfrac><mo lspace="0em" rspace="0em">​</mo><msub><mi>x</mi><mrow><mn>7</mn><mo>,</mo><mi>s</mi></mrow></msub><mo lspace="0em" rspace="0em">​</mo><msub><mi>x</mi><mrow><mn>6</mn><mo>,</mo><mi>t</mi></mrow></msub></mrow></mrow><mo maxsize="1.200em" minsize="1.200em" rspace="0.170em">)</mo></mrow></mrow><mo>,</mo><msub><mi>𝐱</mi><mrow><mn>2</mn><mo>,</mo><mi>s</mi></mrow></msub><mo maxsize="1.600em" minsize="1.600em">)</mo></mrow></mrow></mrow><mo>,</mo></mrow><annotation encoding="application/x-tex">\displaystyle\mathbf{y}_{t}\coloneqq\overline{\sum}_{s\in[T]}\Big(\exp\big(\big\langle\operatorname{stack}(\mathbf{x}_{3,s},\mathbf{x}_{4,s}),\operatorname{stack}(\mathbf{x}_{4,t},\mathbf{x}_{5,t})\big\rangle-x_{6,s}x_{6,t}+\tfrac{\lambda}{\sqrt{r_{2}}}x_{7,s}x_{6,t}\big)\,;\,\mathbf{x}_{2,s}\Big),</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td>
<td rowspan="1" class="ltx_eqn_cell ltx_eqn_eqno ltx_align_middle ltx_align_right"><span class="ltx_tag ltx_tag_equation ltx_align_right">(54)</span></td></tr></tbody>
</table>
<p id="Thmconj215.p1.3" class="ltx_p"><span id="Thmconj215.p1.3.1" class="ltx_text ltx_font_italic">where <math id="Thmconj215.p1.m2" class="ltx_Math" alttext="\overline{\sum}" display="inline" intent=":literal"><semantics><mover accent="true"><mo>∑</mo><mo stretchy="true">¯</mo></mover><annotation encoding="application/x-tex">\overline{\sum}</annotation></semantics></math> is defined in (<a href="#A1.E29" title="In Appendix A Additional Notation ‣ Generalization Bounds for Transformer-Based Next-Token Prediction in a Language Model" class="ltx_ref"><span class="ltx_text ltx_ref_tag">29</span></a>).</span></p>
</div>
</div>
<div id="A5.SS1.5" class="ltx_proof">
<h6 class="ltx_title ltx_runin ltx_font_italic ltx_title_proof">Proof.</h6>
<div id="A5.SS1.p10" class="ltx_para">
<p id="A5.SS1.p10.1" class="ltx_p"><span id="A5.SS1.p10.1.1" class="ltx_text">By the definition of the self-attention in (<a href="#S3.E9" title="In 3 The transformer function class ‣ Generalization Bounds for Transformer-Based Next-Token Prediction in a Language Model" class="ltx_ref"><span class="ltx_text ltx_ref_tag">9</span></a>), the <math id="A5.SS1.p10.m1" class="ltx_Math" alttext="t" display="inline" intent=":literal"><semantics><mi>t</mi><annotation encoding="application/x-tex">t</annotation></semantics></math>-th column of <math id="A5.SS1.p10.m2" class="ltx_Math" alttext="\operatorname{SA}_{U,V}\big((\mathbf{x}_{t})_{t\in[T]}\big)" display="inline" intent=":literal"><semantics><mrow><msub><mi>SA</mi><mrow><mi>U</mi><mo>,</mo><mi>V</mi></mrow></msub><mo>⁡</mo><mrow><mo maxsize="1.200em" minsize="1.200em">(</mo><msub><mrow><mo stretchy="false">(</mo><msub><mi>𝐱</mi><mi>t</mi></msub><mo stretchy="false">)</mo></mrow><mrow><mi>t</mi><mo>∈</mo><mrow><mo stretchy="false">[</mo><mi>T</mi><mo stretchy="false">]</mo></mrow></mrow></msub><mo maxsize="1.200em" minsize="1.200em">)</mo></mrow></mrow><annotation encoding="application/x-tex">\operatorname{SA}_{U,V}\big((\mathbf{x}_{t})_{t\in[T]}\big)</annotation></semantics></math> for given matrices <math id="A5.SS1.p10.m3" class="ltx_Math" alttext="U,V\in\mathbb{R}^{N\times N}" display="inline" intent=":literal"><semantics><mrow><mrow><mi>U</mi><mo>,</mo><mi>V</mi></mrow><mo>∈</mo><msup><mi>ℝ</mi><mrow><mi>N</mi><mo lspace="0.222em" rspace="0.222em">×</mo><mi>N</mi></mrow></msup></mrow><annotation encoding="application/x-tex">U,V\in\mathbb{R}^{N\times N}</annotation></semantics></math> can be written as</span></p>
<table id="A5.Ex220" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="A5.Ex220.m1" class="ltx_Math" alttext="\sum_{s=1}^{T}\frac{\exp(\mathbf{x}^{\top}_{s}U\mathbf{x}_{t})}{\sum_{i=1}^{T}\exp(\mathbf{x}^{\top}_{i}U\mathbf{x}_{t})}V\mathbf{x}_{s}=\overline{\sum}_{s\in[T]}\big(\exp(\mathbf{x}^{\top}_{s}U\mathbf{x}_{t})\,;\,V\mathbf{x}_{s}\big)." display="block" intent=":literal"><semantics><mrow><mrow><mrow><munderover><mo movablelimits="false">∑</mo><mrow><mi>s</mi><mo>=</mo><mn>1</mn></mrow><mi>T</mi></munderover><mrow><mfrac><mrow><mi>exp</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mrow><msubsup><mi>𝐱</mi><mi>s</mi><mo>⊤</mo></msubsup><mo lspace="0em" rspace="0em">​</mo><mi>U</mi><mo lspace="0em" rspace="0em">​</mo><msub><mi>𝐱</mi><mi>t</mi></msub></mrow><mo stretchy="false">)</mo></mrow></mrow><mrow><msubsup><mo>∑</mo><mrow><mi>i</mi><mo>=</mo><mn>1</mn></mrow><mi>T</mi></msubsup><mrow><mi>exp</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mrow><msubsup><mi>𝐱</mi><mi>i</mi><mo>⊤</mo></msubsup><mo lspace="0em" rspace="0em">​</mo><mi>U</mi><mo lspace="0em" rspace="0em">​</mo><msub><mi>𝐱</mi><mi>t</mi></msub></mrow><mo stretchy="false">)</mo></mrow></mrow></mrow></mfrac><mo lspace="0em" rspace="0em">​</mo><mi>V</mi><mo lspace="0em" rspace="0em">​</mo><msub><mi>𝐱</mi><mi>s</mi></msub></mrow></mrow><mo rspace="0.111em">=</mo><mrow><msub><mover accent="true"><mo movablelimits="false">∑</mo><mo stretchy="true">¯</mo></mover><mrow><mi>s</mi><mo>∈</mo><mrow><mo stretchy="false">[</mo><mi>T</mi><mo stretchy="false">]</mo></mrow></mrow></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo maxsize="1.200em" minsize="1.200em">(</mo><mrow><mi>exp</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mrow><msubsup><mi>𝐱</mi><mi>s</mi><mo>⊤</mo></msubsup><mo lspace="0em" rspace="0em">​</mo><mi>U</mi><mo lspace="0em" rspace="0em">​</mo><msub><mi>𝐱</mi><mi>t</mi></msub></mrow><mo rspace="0.170em" stretchy="false">)</mo></mrow></mrow><mo>,</mo><mrow><mi>V</mi><mo lspace="0em" rspace="0em">​</mo><msub><mi>𝐱</mi><mi>s</mi></msub></mrow><mo maxsize="1.200em" minsize="1.200em">)</mo></mrow></mrow></mrow><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">\sum_{s=1}^{T}\frac{\exp(\mathbf{x}^{\top}_{s}U\mathbf{x}_{t})}{\sum_{i=1}^{T}\exp(\mathbf{x}^{\top}_{i}U\mathbf{x}_{t})}V\mathbf{x}_{s}=\overline{\sum}_{s\in[T]}\big(\exp(\mathbf{x}^{\top}_{s}U\mathbf{x}_{t})\,;\,V\mathbf{x}_{s}\big).</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="A5.SS1.p10.2" class="ltx_p"><span id="A5.SS1.p10.2.1" class="ltx_text">Choosing matrices <math id="A5.SS1.p10.m4" class="ltx_Math" alttext="U,V\in[-B,B]^{N}" display="inline" intent=":literal"><semantics><mrow><mi>U</mi><mo>,</mo><mrow><mi>V</mi><mo>∈</mo><msup><mrow><mo stretchy="false">[</mo><mrow><mrow><mo>−</mo><mi>B</mi></mrow><mo>,</mo><mi>B</mi></mrow><mo stretchy="false">]</mo></mrow><mi>N</mi></msup></mrow></mrow><annotation encoding="application/x-tex">U,V\in[-B,B]^{N}</annotation></semantics></math> such that</span></p>
<table id="A5.Ex221" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="A5.Ex221.m1" class="ltx_Math" alttext="\mathbf{x}_{s}^{\top}U\mathbf{x}_{t}=\big\langle\operatorname{stack}(\mathbf{x}_{3,s},\mathbf{x}_{4,s}),\operatorname{stack}(\mathbf{x}_{4,t},\mathbf{x}_{5,t})\big\rangle-x_{6,s}x_{6,t}+\tfrac{\lambda}{\sqrt{r_{2}}}x_{7,s}x_{6,t},\qquad V\mathbf{x}_{s}=\left(\begin{matrix}\bm{0}_{N-m_{2}}\\
\mathbf{x}_{2,s}\end{matrix}\right)," display="block" intent=":literal"><semantics><mrow><mrow><mrow><mrow><msubsup><mi>𝐱</mi><mi>s</mi><mo>⊤</mo></msubsup><mo lspace="0em" rspace="0em">​</mo><mi>U</mi><mo lspace="0em" rspace="0em">​</mo><msub><mi>𝐱</mi><mi>t</mi></msub></mrow><mo>=</mo><mrow><mrow><mrow><mo stretchy="false">⟨</mo><mrow><mrow><mi>stack</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><msub><mi>𝐱</mi><mrow><mn>3</mn><mo>,</mo><mi>s</mi></mrow></msub><mo>,</mo><msub><mi>𝐱</mi><mrow><mn>4</mn><mo>,</mo><mi>s</mi></mrow></msub><mo stretchy="false">)</mo></mrow></mrow><mo>,</mo><mrow><mi>stack</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><msub><mi>𝐱</mi><mrow><mn>4</mn><mo>,</mo><mi>t</mi></mrow></msub><mo>,</mo><msub><mi>𝐱</mi><mrow><mn>5</mn><mo>,</mo><mi>t</mi></mrow></msub><mo stretchy="false">)</mo></mrow></mrow></mrow><mo stretchy="false">⟩</mo></mrow><mo>−</mo><mrow><msub><mi>x</mi><mrow><mn>6</mn><mo>,</mo><mi>s</mi></mrow></msub><mo lspace="0em" rspace="0em">​</mo><msub><mi>x</mi><mrow><mn>6</mn><mo>,</mo><mi>t</mi></mrow></msub></mrow></mrow><mo>+</mo><mrow><mstyle displaystyle="false"><mfrac><mi>λ</mi><msqrt><msub><mi>r</mi><mn>2</mn></msub></msqrt></mfrac></mstyle><mo lspace="0em" rspace="0em">​</mo><msub><mi>x</mi><mrow><mn>7</mn><mo>,</mo><mi>s</mi></mrow></msub><mo lspace="0em" rspace="0em">​</mo><msub><mi>x</mi><mrow><mn>6</mn><mo>,</mo><mi>t</mi></mrow></msub></mrow></mrow></mrow><mo rspace="2.167em">,</mo><mrow><mrow><mi>V</mi><mo lspace="0em" rspace="0em">​</mo><msub><mi>𝐱</mi><mi>s</mi></msub></mrow><mo>=</mo><mrow><mo>(</mo><mtable displaystyle="true" rowspacing="0pt"><mtr><mtd><msub><mn>𝟎</mn><mrow><mi>N</mi><mo>−</mo><msub><mi>m</mi><mn>2</mn></msub></mrow></msub></mtd></mtr><mtr><mtd><msub><mi>𝐱</mi><mrow><mn>2</mn><mo>,</mo><mi>s</mi></mrow></msub></mtd></mtr></mtable><mo>)</mo></mrow></mrow></mrow><mo>,</mo></mrow><annotation encoding="application/x-tex">\mathbf{x}_{s}^{\top}U\mathbf{x}_{t}=\big\langle\operatorname{stack}(\mathbf{x}_{3,s},\mathbf{x}_{4,s}),\operatorname{stack}(\mathbf{x}_{4,t},\mathbf{x}_{5,t})\big\rangle-x_{6,s}x_{6,t}+\tfrac{\lambda}{\sqrt{r_{2}}}x_{7,s}x_{6,t},\qquad V\mathbf{x}_{s}=\left(\begin{matrix}\bm{0}_{N-m_{2}}\\
\mathbf{x}_{2,s}\end{matrix}\right),</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="A5.SS1.p10.3" class="ltx_p"><span id="A5.SS1.p10.3.1" class="ltx_text">we obtain</span></p>
<table id="A5.Ex222" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="A5.Ex222.m1" class="ltx_Math" alttext="\operatorname{SA}_{U,V}\big((\mathbf{x}_{t})_{t\in[T]}\big)=\left(\begin{matrix}\bm{0}_{N-m_{2}}\\
\mathbf{y}_{t}\end{matrix}\right)_{t\in[T]}." display="block" intent=":literal"><semantics><mrow><mrow><mrow><msub><mi>SA</mi><mrow><mi>U</mi><mo>,</mo><mi>V</mi></mrow></msub><mo>⁡</mo><mrow><mo maxsize="1.200em" minsize="1.200em">(</mo><msub><mrow><mo stretchy="false">(</mo><msub><mi>𝐱</mi><mi>t</mi></msub><mo stretchy="false">)</mo></mrow><mrow><mi>t</mi><mo>∈</mo><mrow><mo stretchy="false">[</mo><mi>T</mi><mo stretchy="false">]</mo></mrow></mrow></msub><mo maxsize="1.200em" minsize="1.200em">)</mo></mrow></mrow><mo>=</mo><msub><mrow><mo>(</mo><mtable displaystyle="true" rowspacing="0pt"><mtr><mtd><msub><mn>𝟎</mn><mrow><mi>N</mi><mo>−</mo><msub><mi>m</mi><mn>2</mn></msub></mrow></msub></mtd></mtr><mtr><mtd><msub><mi>𝐲</mi><mi>t</mi></msub></mtd></mtr></mtable><mo>)</mo></mrow><mrow><mi>t</mi><mo>∈</mo><mrow><mo stretchy="false">[</mo><mi>T</mi><mo stretchy="false">]</mo></mrow></mrow></msub></mrow><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">\operatorname{SA}_{U,V}\big((\mathbf{x}_{t})_{t\in[T]}\big)=\left(\begin{matrix}\bm{0}_{N-m_{2}}\\
\mathbf{y}_{t}\end{matrix}\right)_{t\in[T]}.</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="A5.SS1.p10.4" class="ltx_p"><span id="A5.SS1.p10.4.1" class="ltx_text">By considering <math id="A5.SS1.p10.m5" class="ltx_Math" alttext="f_{O}\in\mathcal{SA}(N,B)" display="inline" intent=":literal"><semantics><mrow><msub><mi>f</mi><mi>O</mi></msub><mo>∈</mo><mrow><mi class="ltx_font_mathcaligraphic">𝒮</mi><mo lspace="0em" rspace="0em">​</mo><mi class="ltx_font_mathcaligraphic">𝒜</mi><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>N</mi><mo>,</mo><mi>B</mi><mo stretchy="false">)</mo></mrow></mrow></mrow><annotation encoding="application/x-tex">f_{O}\in\mathcal{SA}(N,B)</annotation></semantics></math> with <math id="A5.SS1.p10.m6" class="ltx_Math" alttext="f_{O}(\cdot)=O_{N\times T}" display="inline" intent=":literal"><semantics><mrow><mrow><msub><mi>f</mi><mi>O</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mo lspace="0em" rspace="0em">⋅</mo><mo stretchy="false">)</mo></mrow></mrow><mo>=</mo><msub><mi>O</mi><mrow><mi>N</mi><mo lspace="0.222em" rspace="0.222em">×</mo><mi>T</mi></mrow></msub></mrow><annotation encoding="application/x-tex">f_{O}(\cdot)=O_{N\times T}</annotation></semantics></math> and
<math id="A5.SS1.p10.m7" class="ltx_Math" alttext="\bm{\mu}_{2}\coloneqq\operatorname{MA}_{\operatorname{SA}_{U,V},f_{O},f_{O},\ldots,f_{O}}\in\mathcal{MA}(N,H,B)" display="inline" intent=":literal"><semantics><mrow><msub><mi>𝝁</mi><mn>2</mn></msub><mo>≔</mo><msub><mi>MA</mi><mrow><msub><mi>SA</mi><mrow><mi>U</mi><mo>,</mo><mi>V</mi></mrow></msub><mo>,</mo><msub><mi>f</mi><mi>O</mi></msub><mo>,</mo><msub><mi>f</mi><mi>O</mi></msub><mo>,</mo><mi mathvariant="normal">…</mi><mo>,</mo><msub><mi>f</mi><mi>O</mi></msub></mrow></msub><mo>∈</mo><mrow><mi class="ltx_font_mathcaligraphic">ℳ</mi><mo lspace="0em" rspace="0em">​</mo><mi class="ltx_font_mathcaligraphic">𝒜</mi><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>N</mi><mo>,</mo><mi>H</mi><mo>,</mo><mi>B</mi><mo stretchy="false">)</mo></mrow></mrow></mrow><annotation encoding="application/x-tex">\bm{\mu}_{2}\coloneqq\operatorname{MA}_{\operatorname{SA}_{U,V},f_{O},f_{O},\ldots,f_{O}}\in\mathcal{MA}(N,H,B)</annotation></semantics></math>,
we get the assertion by adding the identity to <math id="A5.SS1.p10.m8" class="ltx_Math" alttext="\operatorname{SA}_{U,V}" display="inline" intent=":literal"><semantics><msub><mi>SA</mi><mrow><mi>U</mi><mo>,</mo><mi>V</mi></mrow></msub><annotation encoding="application/x-tex">\operatorname{SA}_{U,V}</annotation></semantics></math>.
∎</span></p>
</div>
</div>
</section>
<section id="A5.SS2" class="ltx_subsection">
<h3 class="ltx_title ltx_title_subsection"><span class="ltx_tag ltx_tag_subsection">E.2 </span>Construction of multilayer perceptron layers</h3>

<div id="A5.SS2.p1" class="ltx_para">
<p id="A5.SS2.p1.1" class="ltx_p">Given input and output dimensions <math id="A5.SS2.p1.m1" class="ltx_Math" alttext="d_{\mathrm{in}},d_{\mathrm{out}}\in\mathbb{N}" display="inline" intent=":literal"><semantics><mrow><msub><mi>d</mi><mi>in</mi></msub><mo>,</mo><mrow><msub><mi>d</mi><mi>out</mi></msub><mo>∈</mo><mi>ℕ</mi></mrow></mrow><annotation encoding="application/x-tex">d_{\mathrm{in}},d_{\mathrm{out}}\in\mathbb{N}</annotation></semantics></math> and depth and width <math id="A5.SS2.p1.m2" class="ltx_Math" alttext="L_{\mathrm{mlp}},N_{\mathrm{mlp}}\in\mathbb{N}" display="inline" intent=":literal"><semantics><mrow><msub><mi>L</mi><mi>mlp</mi></msub><mo>,</mo><mrow><msub><mi>N</mi><mi>mlp</mi></msub><mo>∈</mo><mi>ℕ</mi></mrow></mrow><annotation encoding="application/x-tex">L_{\mathrm{mlp}},N_{\mathrm{mlp}}\in\mathbb{N}</annotation></semantics></math>, let
<math id="A5.SS2.p1.m3" class="ltx_Math" alttext="p_{0}\coloneqq d_{\mathrm{in}}" display="inline" intent=":literal"><semantics><mrow><msub><mi>p</mi><mn>0</mn></msub><mo>≔</mo><msub><mi>d</mi><mi>in</mi></msub></mrow><annotation encoding="application/x-tex">p_{0}\coloneqq d_{\mathrm{in}}</annotation></semantics></math>, <math id="A5.SS2.p1.m4" class="ltx_Math" alttext="p_{\ell}\coloneqq N_{\mathrm{mlp}}" display="inline" intent=":literal"><semantics><mrow><msub><mi>p</mi><mi mathvariant="normal">ℓ</mi></msub><mo>≔</mo><msub><mi>N</mi><mi>mlp</mi></msub></mrow><annotation encoding="application/x-tex">p_{\ell}\coloneqq N_{\mathrm{mlp}}</annotation></semantics></math> for <math id="A5.SS2.p1.m5" class="ltx_Math" alttext="\ell\in[L_{\mathrm{mlp}}]" display="inline" intent=":literal"><semantics><mrow><mi mathvariant="normal">ℓ</mi><mo>∈</mo><mrow><mo stretchy="false">[</mo><msub><mi>L</mi><mi>mlp</mi></msub><mo stretchy="false">]</mo></mrow></mrow><annotation encoding="application/x-tex">\ell\in[L_{\mathrm{mlp}}]</annotation></semantics></math> and <math id="A5.SS2.p1.m6" class="ltx_Math" alttext="p_{L_{\mathrm{mlp}}+1}\coloneqq d_{\mathrm{out}}" display="inline" intent=":literal"><semantics><mrow><msub><mi>p</mi><mrow><msub><mi>L</mi><mi>mlp</mi></msub><mo>+</mo><mn>1</mn></mrow></msub><mo>≔</mo><msub><mi>d</mi><mi>out</mi></msub></mrow><annotation encoding="application/x-tex">p_{L_{\mathrm{mlp}}+1}\coloneqq d_{\mathrm{out}}</annotation></semantics></math>.
A multilayer perceptron is parameterized by
<math id="A5.SS2.p1.m7" class="ltx_Math" alttext="\bm{\theta}\coloneqq\{W_{\ell},\bm{b}_{\ell}\}_{\ell\in\{0,1,\ldots,L_{\mathrm{mlp}}\}}" display="inline" intent=":literal"><semantics><mrow><mi>𝜽</mi><mo>≔</mo><msub><mrow><mo stretchy="false">{</mo><msub><mi>W</mi><mi mathvariant="normal">ℓ</mi></msub><mo>,</mo><msub><mi>𝒃</mi><mi mathvariant="normal">ℓ</mi></msub><mo stretchy="false">}</mo></mrow><mrow><mi mathvariant="normal">ℓ</mi><mo>∈</mo><mrow><mo stretchy="false">{</mo><mrow><mn>0</mn><mo>,</mo><mn>1</mn><mo>,</mo><mi mathvariant="normal">…</mi><mo>,</mo><msub><mi>L</mi><mi>mlp</mi></msub></mrow><mo stretchy="false">}</mo></mrow></mrow></msub></mrow><annotation encoding="application/x-tex">\bm{\theta}\coloneqq\{W_{\ell},\bm{b}_{\ell}\}_{\ell\in\{0,1,\ldots,L_{\mathrm{mlp}}\}}</annotation></semantics></math>
with the weight matrices <math id="A5.SS2.p1.m8" class="ltx_math_unparsed" alttext="\{W_{\ell}\in\mathbb{R}^{p_{\ell+1}\times p_{\ell}}\}_{\ell\in\{0,1,\ldots,L_{\mathrm{mlp}}\}}" display="inline" intent=":literal"><semantics><msub><mrow><mo stretchy="false">{</mo><msub><mi>W</mi><mi mathvariant="normal">ℓ</mi></msub><mo>∈</mo><msup><mi>ℝ</mi><mrow><msub><mi>p</mi><mrow><mi mathvariant="normal">ℓ</mi><mo>+</mo><mn>1</mn></mrow></msub><mo lspace="0.222em" rspace="0.222em">×</mo><msub><mi>p</mi><mi mathvariant="normal">ℓ</mi></msub></mrow></msup><mo stretchy="false">}</mo></mrow><mrow><mi mathvariant="normal">ℓ</mi><mo>∈</mo><mrow><mo stretchy="false">{</mo><mrow><mn>0</mn><mo>,</mo><mn>1</mn><mo>,</mo><mi mathvariant="normal">…</mi><mo>,</mo><msub><mi>L</mi><mi>mlp</mi></msub></mrow><mo stretchy="false">}</mo></mrow></mrow></msub><annotation encoding="application/x-tex">\{W_{\ell}\in\mathbb{R}^{p_{\ell+1}\times p_{\ell}}\}_{\ell\in\{0,1,\ldots,L_{\mathrm{mlp}}\}}</annotation></semantics></math> and the bias vectors <math id="A5.SS2.p1.m9" class="ltx_math_unparsed" alttext="\{\bm{b}_{\ell}\in\mathbb{R}^{p_{\ell+1}}\}_{\ell\in\{0,1,\ldots,L_{\mathrm{mlp}}\}}" display="inline" intent=":literal"><semantics><msub><mrow><mo stretchy="false">{</mo><msub><mi>𝒃</mi><mi mathvariant="normal">ℓ</mi></msub><mo>∈</mo><msup><mi>ℝ</mi><msub><mi>p</mi><mrow><mi mathvariant="normal">ℓ</mi><mo>+</mo><mn>1</mn></mrow></msub></msup><mo stretchy="false">}</mo></mrow><mrow><mi mathvariant="normal">ℓ</mi><mo>∈</mo><mrow><mo stretchy="false">{</mo><mrow><mn>0</mn><mo>,</mo><mn>1</mn><mo>,</mo><mi mathvariant="normal">…</mi><mo>,</mo><msub><mi>L</mi><mi>mlp</mi></msub></mrow><mo stretchy="false">}</mo></mrow></mrow></msub><annotation encoding="application/x-tex">\{\bm{b}_{\ell}\in\mathbb{R}^{p_{\ell+1}}\}_{\ell\in\{0,1,\ldots,L_{\mathrm{mlp}}\}}</annotation></semantics></math>.
For input <math id="A5.SS2.p1.m10" class="ltx_Math" alttext="\mathbf{x}\in\mathbb{R}^{d_{\mathrm{in}}}," display="inline" intent=":literal"><semantics><mrow><mrow><mi>𝐱</mi><mo>∈</mo><msup><mi>ℝ</mi><msub><mi>d</mi><mi>in</mi></msub></msup></mrow><mo>,</mo></mrow><annotation encoding="application/x-tex">\mathbf{x}\in\mathbb{R}^{d_{\mathrm{in}}},</annotation></semantics></math> the multilayer perceptron output <math id="A5.SS2.p1.m11" class="ltx_Math" alttext="\operatorname{MLP}_{\bm{\theta}}(\mathbf{x})" display="inline" intent=":literal"><semantics><mrow><msub><mi>MLP</mi><mi>𝜽</mi></msub><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>𝐱</mi><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">\operatorname{MLP}_{\bm{\theta}}(\mathbf{x})</annotation></semantics></math> is given by</p>
<table id="A5.EGx101" class="ltx_equationgroup ltx_eqn_align ltx_eqn_table">

<tbody id="A5.Ex223"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_align_right ltx_eqn_cell"><math id="A5.Ex223.m1" class="ltx_Math" alttext="\displaystyle\operatorname{MLP}_{\bm{\theta}}(\mathbf{x})\coloneq W_{L_{\mathrm{mlp}}}\bm{f}^{(L_{\mathrm{mlp}})}(\mathbf{x})-\bm{b}_{L_{\mathrm{mlp}}}," display="inline" intent=":literal"><semantics><mrow><mrow><mrow><msub><mi>MLP</mi><mi>𝜽</mi></msub><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>𝐱</mi><mo stretchy="false">)</mo></mrow></mrow><mo>≔</mo><mrow><mrow><msub><mi>W</mi><msub><mi>L</mi><mi>mlp</mi></msub></msub><mo lspace="0em" rspace="0em">​</mo><msup><mi>𝒇</mi><mrow><mo stretchy="false">(</mo><msub><mi>L</mi><mi>mlp</mi></msub><mo stretchy="false">)</mo></mrow></msup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>𝐱</mi><mo stretchy="false">)</mo></mrow></mrow><mo>−</mo><msub><mi>𝒃</mi><msub><mi>L</mi><mi>mlp</mi></msub></msub></mrow></mrow><mo>,</mo></mrow><annotation encoding="application/x-tex">\displaystyle\operatorname{MLP}_{\bm{\theta}}(\mathbf{x})\coloneq W_{L_{\mathrm{mlp}}}\bm{f}^{(L_{\mathrm{mlp}})}(\mathbf{x})-\bm{b}_{L_{\mathrm{mlp}}},</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="A5.SS2.p1.2" class="ltx_p">where <math id="A5.SS2.p1.m12" class="ltx_Math" alttext="\bm{f}^{(\ell)}" display="inline" intent=":literal"><semantics><msup><mi>𝒇</mi><mrow><mo stretchy="false">(</mo><mi mathvariant="normal">ℓ</mi><mo stretchy="false">)</mo></mrow></msup><annotation encoding="application/x-tex">\bm{f}^{(\ell)}</annotation></semantics></math> for <math id="A5.SS2.p1.m13" class="ltx_Math" alttext="\ell\in[L_{\mathrm{mlp}}]" display="inline" intent=":literal"><semantics><mrow><mi mathvariant="normal">ℓ</mi><mo>∈</mo><mrow><mo stretchy="false">[</mo><msub><mi>L</mi><mi>mlp</mi></msub><mo stretchy="false">]</mo></mrow></mrow><annotation encoding="application/x-tex">\ell\in[L_{\mathrm{mlp}}]</annotation></semantics></math> is recursively defined via</p>
<table id="A5.EGx102" class="ltx_equationgroup ltx_eqn_align ltx_eqn_table">

<tbody id="A5.Ex224"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_align_right ltx_eqn_cell"><math id="A5.Ex224.m1" class="ltx_Math" alttext="\displaystyle\bm{f}^{(\ell)}(\mathbf{x})\coloneq\sigma\left(W_{\ell-1}\bm{f}^{(\ell-1)}(\mathbf{x})-\bm{b}_{\ell-1}\right)," display="inline" intent=":literal"><semantics><mrow><mrow><mrow><msup><mi>𝒇</mi><mrow><mo stretchy="false">(</mo><mi mathvariant="normal">ℓ</mi><mo stretchy="false">)</mo></mrow></msup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>𝐱</mi><mo stretchy="false">)</mo></mrow></mrow><mo>≔</mo><mrow><mi>σ</mi><mo>⁡</mo><mrow><mo>(</mo><mrow><mrow><msub><mi>W</mi><mrow><mi mathvariant="normal">ℓ</mi><mo>−</mo><mn>1</mn></mrow></msub><mo lspace="0em" rspace="0em">​</mo><msup><mi>𝒇</mi><mrow><mo stretchy="false">(</mo><mrow><mi mathvariant="normal">ℓ</mi><mo>−</mo><mn>1</mn></mrow><mo stretchy="false">)</mo></mrow></msup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>𝐱</mi><mo stretchy="false">)</mo></mrow></mrow><mo>−</mo><msub><mi>𝒃</mi><mrow><mi mathvariant="normal">ℓ</mi><mo>−</mo><mn>1</mn></mrow></msub></mrow><mo>)</mo></mrow></mrow></mrow><mo>,</mo></mrow><annotation encoding="application/x-tex">\displaystyle\bm{f}^{(\ell)}(\mathbf{x})\coloneq\sigma\left(W_{\ell-1}\bm{f}^{(\ell-1)}(\mathbf{x})-\bm{b}_{\ell-1}\right),</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="A5.SS2.p1.3" class="ltx_p">and <math id="A5.SS2.p1.m14" class="ltx_Math" alttext="\bm{f}^{(0)}(\mathbf{x})\coloneq\mathbf{x}." display="inline" intent=":literal"><semantics><mrow><mrow><mrow><msup><mi>𝒇</mi><mrow><mo stretchy="false">(</mo><mn>0</mn><mo stretchy="false">)</mo></mrow></msup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>𝐱</mi><mo stretchy="false">)</mo></mrow></mrow><mo>≔</mo><mi>𝐱</mi></mrow><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">\bm{f}^{(0)}(\mathbf{x})\coloneq\mathbf{x}.</annotation></semantics></math>
Here <math id="A5.SS2.p1.m15" class="ltx_Math" alttext="\sigma" display="inline" intent=":literal"><semantics><mi>σ</mi><annotation encoding="application/x-tex">\sigma</annotation></semantics></math> denotes the componentwise application of the ReLU activation function in the sense that for any positive integer <math id="A5.SS2.p1.m16" class="ltx_Math" alttext="p," display="inline" intent=":literal"><semantics><mrow><mi>p</mi><mo>,</mo></mrow><annotation encoding="application/x-tex">p,</annotation></semantics></math></p>
<table id="A5.EGx103" class="ltx_equationgroup ltx_eqn_align ltx_eqn_table">

<tbody id="A5.Ex225"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_align_right ltx_eqn_cell"><math id="A5.Ex225.m1" class="ltx_Math" alttext="\displaystyle\sigma\left((x_{1},\dots,x_{p})^{\top}\right)=\big((x_{1})_{+},\dots,(x_{p})_{+}\big)^{\top}." display="inline" intent=":literal"><semantics><mrow><mrow><mrow><mi>σ</mi><mo>⁡</mo><mrow><mo>(</mo><msup><mrow><mo stretchy="false">(</mo><msub><mi>x</mi><mn>1</mn></msub><mo>,</mo><mi mathvariant="normal">…</mi><mo>,</mo><msub><mi>x</mi><mi>p</mi></msub><mo stretchy="false">)</mo></mrow><mo>⊤</mo></msup><mo>)</mo></mrow></mrow><mo>=</mo><msup><mrow><mo maxsize="1.200em" minsize="1.200em">(</mo><msub><mrow><mo stretchy="false">(</mo><msub><mi>x</mi><mn>1</mn></msub><mo stretchy="false">)</mo></mrow><mo>+</mo></msub><mo>,</mo><mi mathvariant="normal">…</mi><mo>,</mo><msub><mrow><mo stretchy="false">(</mo><msub><mi>x</mi><mi>p</mi></msub><mo stretchy="false">)</mo></mrow><mo>+</mo></msub><mo maxsize="1.200em" minsize="1.200em">)</mo></mrow><mo>⊤</mo></msup></mrow><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">\displaystyle\sigma\left((x_{1},\dots,x_{p})^{\top}\right)=\big((x_{1})_{+},\dots,(x_{p})_{+}\big)^{\top}.</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="A5.SS2.p1.4" class="ltx_p">It is well known that multilayer perceptrons can approximate polynomial and analytic functions at exponential rates, whereas they approximate Hölder-smooth functions at polynomial rates.
The results in this section follow from slight modifications of these known results.</p>
</div>
<div id="A5.SS2.p2" class="ltx_para">
<p id="A5.SS2.p2.1" class="ltx_p">The following two lemmas show that multilayer perceptrons can approximate
multiplication at exponential rates. Similar results can be found in the
literature <cite class="ltx_cite ltx_citemacro_cite">[<a href="#bib.bib33" title="" class="ltx_ref">43</a>, <a href="#bib.bib34" title="" class="ltx_ref">48</a>, <a href="#bib.bib36" title="" class="ltx_ref">61</a>, <a href="#bib.bib46" title="" class="ltx_ref">82</a>]</cite>.
We adapt Lemmas A.2 and A.3 of <cite class="ltx_cite ltx_citemacro_cite">[<a href="#bib.bib36" title="" class="ltx_ref">61</a>]</cite> to general bounded
domains, while keeping the network parameters bounded.</p>
</div>
<div id="Thmconj216" class="ltx_theorem ltx_theorem_lemma">
<h6 class="ltx_title ltx_runin ltx_title_theorem"><span class="ltx_tag ltx_tag_theorem"><span id="Thmconj216.4" class="ltx_text ltx_font_bold">Lemma 16</span></span><span id="Thmconj216.5" class="ltx_text ltx_font_bold">.</span></h6>
<div id="Thmconj216.p1" class="ltx_para">
<p id="Thmconj216.p1.1" class="ltx_p"><span id="Thmconj216.p1.1.1" class="ltx_text ltx_font_italic">For any <math id="Thmconj216.p1.m1" class="ltx_Math" alttext="c\geq 1" display="inline" intent=":literal"><semantics><mrow><mi>c</mi><mo>≥</mo><mn>1</mn></mrow><annotation encoding="application/x-tex">c\geq 1</annotation></semantics></math> and <math id="Thmconj216.p1.m2" class="ltx_Math" alttext="M=5,6,\ldots" display="inline" intent=":literal"><semantics><mrow><mrow><mi>M</mi><mo>=</mo><mn>5</mn></mrow><mo>,</mo><mn>6</mn><mo>,</mo><mi mathvariant="normal">…</mi></mrow><annotation encoding="application/x-tex">M=5,6,\ldots</annotation></semantics></math>, there exists a multilayer perceptron <math id="Thmconj216.p1.m3" class="ltx_Math" alttext="f:\mathbb{R}^{2}\rightarrow\mathbb{R}" display="inline" intent=":literal"><semantics><mrow><mi>f</mi><mo lspace="0.278em" rspace="0.278em">:</mo><mrow><msup><mi>ℝ</mi><mn>2</mn></msup><mo stretchy="false">→</mo><mi>ℝ</mi></mrow></mrow><annotation encoding="application/x-tex">f:\mathbb{R}^{2}\rightarrow\mathbb{R}</annotation></semantics></math> with depth <math id="Thmconj216.p1.m4" class="ltx_Math" alttext="M" display="inline" intent=":literal"><semantics><mi>M</mi><annotation encoding="application/x-tex">M</annotation></semantics></math>, width <math id="Thmconj216.p1.m5" class="ltx_Math" alttext="7" display="inline" intent=":literal"><semantics><mn>7</mn><annotation encoding="application/x-tex">7</annotation></semantics></math>, and parameters bounded in absolute value by <math id="Thmconj216.p1.m6" class="ltx_Math" alttext="4c^{2}" display="inline" intent=":literal"><semantics><mrow><mn>4</mn><mo lspace="0em" rspace="0em">​</mo><msup><mi>c</mi><mn>2</mn></msup></mrow><annotation encoding="application/x-tex">4c^{2}</annotation></semantics></math>, such that</span></p>
<table id="A5.Ex226" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="A5.Ex226.m1" class="ltx_Math" alttext="\sup_{x_{1},x_{2}\in[-c,c]}|f(x_{1},x_{2})-x_{1}x_{2}|\leq c^{2}2^{-M+6}." display="block" intent=":literal"><semantics><mrow><mrow><mrow><munder><mo movablelimits="false">sup</mo><mrow><msub><mi>x</mi><mn>1</mn></msub><mo>,</mo><mrow><msub><mi>x</mi><mn>2</mn></msub><mo>∈</mo><mrow><mo stretchy="false">[</mo><mrow><mrow><mo>−</mo><mi>c</mi></mrow><mo>,</mo><mi>c</mi></mrow><mo stretchy="false">]</mo></mrow></mrow></mrow></munder><mrow><mo lspace="0em" stretchy="false">|</mo><mrow><mrow><mi>f</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><msub><mi>x</mi><mn>1</mn></msub><mo>,</mo><msub><mi>x</mi><mn>2</mn></msub><mo stretchy="false">)</mo></mrow></mrow><mo>−</mo><mrow><msub><mi>x</mi><mn>1</mn></msub><mo lspace="0em" rspace="0em">​</mo><msub><mi>x</mi><mn>2</mn></msub></mrow></mrow><mo stretchy="false">|</mo></mrow></mrow><mo>≤</mo><mrow><msup><mi>c</mi><mn>2</mn></msup><mo lspace="0em" rspace="0em">​</mo><msup><mn>2</mn><mrow><mrow><mo>−</mo><mi>M</mi></mrow><mo>+</mo><mn>6</mn></mrow></msup></mrow></mrow><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">\sup_{x_{1},x_{2}\in[-c,c]}|f(x_{1},x_{2})-x_{1}x_{2}|\leq c^{2}2^{-M+6}.</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
</div>
</div>
<div id="A5.SS2.2" class="ltx_proof">
<h6 class="ltx_title ltx_runin ltx_font_italic ltx_title_proof">Proof.</h6>
<div id="A5.SS2.p3" class="ltx_para">
<p id="A5.SS2.p3.1" class="ltx_p"><span id="A5.SS2.p3.1.1" class="ltx_text">By Lemma A.2 of <cite class="ltx_cite ltx_citemacro_cite">[<a href="#bib.bib36" title="" class="ltx_ref">61</a>]</cite>, for any <math id="A5.SS2.p3.m1" class="ltx_Math" alttext="m\in\mathbb{N}" display="inline" intent=":literal"><semantics><mrow><mi>m</mi><mo>∈</mo><mi>ℕ</mi></mrow><annotation encoding="application/x-tex">m\in\mathbb{N}</annotation></semantics></math>, there exists a multilayer perceptron <math id="A5.SS2.p3.m2" class="ltx_Math" alttext="g:\mathbb{R}^{2}\rightarrow\mathbb{R}" display="inline" intent=":literal"><semantics><mrow><mi>g</mi><mo lspace="0.278em" rspace="0.278em">:</mo><mrow><msup><mi>ℝ</mi><mn>2</mn></msup><mo stretchy="false">→</mo><mi>ℝ</mi></mrow></mrow><annotation encoding="application/x-tex">g:\mathbb{R}^{2}\rightarrow\mathbb{R}</annotation></semantics></math> with depth <math id="A5.SS2.p3.m3" class="ltx_Math" alttext="m+4" display="inline" intent=":literal"><semantics><mrow><mi>m</mi><mo>+</mo><mn>4</mn></mrow><annotation encoding="application/x-tex">m+4</annotation></semantics></math>, width <math id="A5.SS2.p3.m4" class="ltx_Math" alttext="6" display="inline" intent=":literal"><semantics><mn>6</mn><annotation encoding="application/x-tex">6</annotation></semantics></math>, and all parameters bounded in absolute value by <math id="A5.SS2.p3.m5" class="ltx_Math" alttext="1" display="inline" intent=":literal"><semantics><mn>1</mn><annotation encoding="application/x-tex">1</annotation></semantics></math>, such that</span></p>
<table id="A5.Ex227" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="A5.Ex227.m1" class="ltx_Math" alttext="\sup_{y_{1},y_{2}\in[0,1]}|g(y_{1},y_{2})-y_{1}y_{2}|\leq 2^{-m}." display="block" intent=":literal"><semantics><mrow><mrow><mrow><munder><mo movablelimits="false">sup</mo><mrow><msub><mi>y</mi><mn>1</mn></msub><mo>,</mo><mrow><msub><mi>y</mi><mn>2</mn></msub><mo>∈</mo><mrow><mo stretchy="false">[</mo><mrow><mn>0</mn><mo>,</mo><mn>1</mn></mrow><mo stretchy="false">]</mo></mrow></mrow></mrow></munder><mrow><mo lspace="0em" stretchy="false">|</mo><mrow><mrow><mi>g</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><msub><mi>y</mi><mn>1</mn></msub><mo>,</mo><msub><mi>y</mi><mn>2</mn></msub><mo stretchy="false">)</mo></mrow></mrow><mo>−</mo><mrow><msub><mi>y</mi><mn>1</mn></msub><mo lspace="0em" rspace="0em">​</mo><msub><mi>y</mi><mn>2</mn></msub></mrow></mrow><mo stretchy="false">|</mo></mrow></mrow><mo>≤</mo><msup><mn>2</mn><mrow><mo>−</mo><mi>m</mi></mrow></msup></mrow><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">\sup_{y_{1},y_{2}\in[0,1]}|g(y_{1},y_{2})-y_{1}y_{2}|\leq 2^{-m}.</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="A5.SS2.p3.2" class="ltx_p"><span id="A5.SS2.p3.2.1" class="ltx_text">Let <math id="A5.SS2.p3.m6" class="ltx_Math" alttext="\ell:x\mapsto(x+c)/(2c)" display="inline" intent=":literal"><semantics><mrow><mi mathvariant="normal">ℓ</mi><mo lspace="0.278em" rspace="0.278em">:</mo><mrow><mi>x</mi><mo stretchy="false">↦</mo><mrow><mrow><mo stretchy="false">(</mo><mrow><mi>x</mi><mo>+</mo><mi>c</mi></mrow><mo stretchy="false">)</mo></mrow><mo>/</mo><mrow><mo stretchy="false">(</mo><mrow><mn>2</mn><mo lspace="0em" rspace="0em">​</mo><mi>c</mi></mrow><mo stretchy="false">)</mo></mrow></mrow></mrow></mrow><annotation encoding="application/x-tex">\ell:x\mapsto(x+c)/(2c)</annotation></semantics></math> and define</span></p>
<table id="A5.Ex228" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="A5.Ex228.m1" class="ltx_Math" alttext="f(x_{1},x_{2})=c^{2}\Big(4g\big(\ell(x_{1}),\ell(x_{2})\big)-2\ell(x_{1})-2\ell(x_{2})+1\Big)" display="block" intent=":literal"><semantics><mrow><mrow><mi>f</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><msub><mi>x</mi><mn>1</mn></msub><mo>,</mo><msub><mi>x</mi><mn>2</mn></msub><mo stretchy="false">)</mo></mrow></mrow><mo>=</mo><mrow><msup><mi>c</mi><mn>2</mn></msup><mo lspace="0em" rspace="0em">​</mo><mrow><mo maxsize="1.600em" minsize="1.600em">(</mo><mrow><mrow><mrow><mn>4</mn><mo lspace="0em" rspace="0em">​</mo><mi>g</mi><mo lspace="0em" rspace="0em">​</mo><mrow><mo maxsize="1.200em" minsize="1.200em">(</mo><mrow><mi mathvariant="normal">ℓ</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><msub><mi>x</mi><mn>1</mn></msub><mo stretchy="false">)</mo></mrow></mrow><mo>,</mo><mrow><mi mathvariant="normal">ℓ</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><msub><mi>x</mi><mn>2</mn></msub><mo stretchy="false">)</mo></mrow></mrow><mo maxsize="1.200em" minsize="1.200em">)</mo></mrow></mrow><mo>−</mo><mrow><mn>2</mn><mo lspace="0em" rspace="0em">​</mo><mi mathvariant="normal">ℓ</mi><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mi>x</mi><mn>1</mn></msub><mo stretchy="false">)</mo></mrow></mrow><mo>−</mo><mrow><mn>2</mn><mo lspace="0em" rspace="0em">​</mo><mi mathvariant="normal">ℓ</mi><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mi>x</mi><mn>2</mn></msub><mo stretchy="false">)</mo></mrow></mrow></mrow><mo>+</mo><mn>1</mn></mrow><mo maxsize="1.600em" minsize="1.600em">)</mo></mrow></mrow></mrow><annotation encoding="application/x-tex">f(x_{1},x_{2})=c^{2}\Big(4g\big(\ell(x_{1}),\ell(x_{2})\big)-2\ell(x_{1})-2\ell(x_{2})+1\Big)</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="A5.SS2.p3.3" class="ltx_p"><span id="A5.SS2.p3.3.1" class="ltx_text">Since <math id="A5.SS2.p3.m7" class="ltx_Math" alttext="x_{j}=2c\,\ell(x_{j})-c" display="inline" intent=":literal"><semantics><mrow><msub><mi>x</mi><mi>j</mi></msub><mo>=</mo><mrow><mrow><mn>2</mn><mo lspace="0em" rspace="0em">​</mo><mi>c</mi><mo lspace="0.170em" rspace="0em">​</mo><mi mathvariant="normal">ℓ</mi><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mi>x</mi><mi>j</mi></msub><mo stretchy="false">)</mo></mrow></mrow><mo>−</mo><mi>c</mi></mrow></mrow><annotation encoding="application/x-tex">x_{j}=2c\,\ell(x_{j})-c</annotation></semantics></math> for <math id="A5.SS2.p3.m8" class="ltx_Math" alttext="j=1,2" display="inline" intent=":literal"><semantics><mrow><mrow><mi>j</mi><mo>=</mo><mn>1</mn></mrow><mo>,</mo><mn>2</mn></mrow><annotation encoding="application/x-tex">j=1,2</annotation></semantics></math>, we have, for all <math id="A5.SS2.p3.m9" class="ltx_Math" alttext="x_{1},x_{2}\in[-c,c]" display="inline" intent=":literal"><semantics><mrow><msub><mi>x</mi><mn>1</mn></msub><mo>,</mo><mrow><msub><mi>x</mi><mn>2</mn></msub><mo>∈</mo><mrow><mo stretchy="false">[</mo><mrow><mrow><mo>−</mo><mi>c</mi></mrow><mo>,</mo><mi>c</mi></mrow><mo stretchy="false">]</mo></mrow></mrow></mrow><annotation encoding="application/x-tex">x_{1},x_{2}\in[-c,c]</annotation></semantics></math>,</span></p>
<table id="A5.EGx104" class="ltx_equationgroup ltx_eqn_align ltx_eqn_table">

<tbody id="A5.Ex229"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_align_right ltx_eqn_cell"><math id="A5.Ex229.m1" class="ltx_Math" alttext="\displaystyle|f(x_{1},x_{2})-x_{1}x_{2}|" display="inline" intent=":literal"><semantics><mrow><mo stretchy="false">|</mo><mrow><mrow><mi>f</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><msub><mi>x</mi><mn>1</mn></msub><mo>,</mo><msub><mi>x</mi><mn>2</mn></msub><mo stretchy="false">)</mo></mrow></mrow><mo>−</mo><mrow><msub><mi>x</mi><mn>1</mn></msub><mo lspace="0em" rspace="0em">​</mo><msub><mi>x</mi><mn>2</mn></msub></mrow></mrow><mo stretchy="false">|</mo></mrow><annotation encoding="application/x-tex">\displaystyle|f(x_{1},x_{2})-x_{1}x_{2}|</annotation></semantics></math></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A5.Ex229.m2" class="ltx_Math" alttext="\displaystyle=\Big|c^{2}\Big(4g\big(\ell(x_{1}),\ell(x_{2})\big)-2\ell(x_{1})-2\ell(x_{2})+1\Big)-\big(2c\ell(x_{1})-c\big)\big(2c\ell(x_{2})-c\big)\Big|" display="inline" intent=":literal"><semantics><mrow><mphantom></mphantom><mo>=</mo><mrow><mo maxsize="1.600em" minsize="1.600em" stretchy="true">|</mo><mrow><mrow><msup><mi>c</mi><mn>2</mn></msup><mo lspace="0em" rspace="0em">​</mo><mrow><mo maxsize="1.600em" minsize="1.600em">(</mo><mrow><mrow><mrow><mn>4</mn><mo lspace="0em" rspace="0em">​</mo><mi>g</mi><mo lspace="0em" rspace="0em">​</mo><mrow><mo maxsize="1.200em" minsize="1.200em">(</mo><mrow><mi mathvariant="normal">ℓ</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><msub><mi>x</mi><mn>1</mn></msub><mo stretchy="false">)</mo></mrow></mrow><mo>,</mo><mrow><mi mathvariant="normal">ℓ</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><msub><mi>x</mi><mn>2</mn></msub><mo stretchy="false">)</mo></mrow></mrow><mo maxsize="1.200em" minsize="1.200em">)</mo></mrow></mrow><mo>−</mo><mrow><mn>2</mn><mo lspace="0em" rspace="0em">​</mo><mi mathvariant="normal">ℓ</mi><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mi>x</mi><mn>1</mn></msub><mo stretchy="false">)</mo></mrow></mrow><mo>−</mo><mrow><mn>2</mn><mo lspace="0em" rspace="0em">​</mo><mi mathvariant="normal">ℓ</mi><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mi>x</mi><mn>2</mn></msub><mo stretchy="false">)</mo></mrow></mrow></mrow><mo>+</mo><mn>1</mn></mrow><mo maxsize="1.600em" minsize="1.600em">)</mo></mrow></mrow><mo>−</mo><mrow><mrow><mo maxsize="1.200em" minsize="1.200em">(</mo><mrow><mrow><mn>2</mn><mo lspace="0em" rspace="0em">​</mo><mi>c</mi><mo lspace="0em" rspace="0em">​</mo><mi mathvariant="normal">ℓ</mi><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mi>x</mi><mn>1</mn></msub><mo stretchy="false">)</mo></mrow></mrow><mo>−</mo><mi>c</mi></mrow><mo maxsize="1.200em" minsize="1.200em">)</mo></mrow><mo lspace="0em" rspace="0em">​</mo><mrow><mo maxsize="1.200em" minsize="1.200em">(</mo><mrow><mrow><mn>2</mn><mo lspace="0em" rspace="0em">​</mo><mi>c</mi><mo lspace="0em" rspace="0em">​</mo><mi mathvariant="normal">ℓ</mi><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mi>x</mi><mn>2</mn></msub><mo stretchy="false">)</mo></mrow></mrow><mo>−</mo><mi>c</mi></mrow><mo maxsize="1.200em" minsize="1.200em">)</mo></mrow></mrow></mrow><mo maxsize="1.600em" minsize="1.600em" stretchy="true">|</mo></mrow></mrow><annotation encoding="application/x-tex">\displaystyle=\Big|c^{2}\Big(4g\big(\ell(x_{1}),\ell(x_{2})\big)-2\ell(x_{1})-2\ell(x_{2})+1\Big)-\big(2c\ell(x_{1})-c\big)\big(2c\ell(x_{2})-c\big)\Big|</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
<tbody id="A5.Ex230"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_eqn_cell"></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A5.Ex230.m1" class="ltx_Math" alttext="\displaystyle=4c^{2}\big|g\big(\ell(x_{1}),\ell(x_{2})\big)-\ell(x_{1})\ell(x_{2})\big|\leq 4c^{2}2^{-m}." display="inline" intent=":literal"><semantics><mrow><mrow><mrow><mphantom></mphantom><mo>=</mo><mrow><mn>4</mn><mo lspace="0em" rspace="0em">​</mo><msup><mi>c</mi><mn>2</mn></msup></mrow></mrow><mo fence="false">|</mo><mrow><mrow><mrow><mi>g</mi><mo>⁡</mo><mrow><mo maxsize="1.200em" minsize="1.200em">(</mo><mrow><mi mathvariant="normal">ℓ</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><msub><mi>x</mi><mn>1</mn></msub><mo stretchy="false">)</mo></mrow></mrow><mo>,</mo><mrow><mi mathvariant="normal">ℓ</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><msub><mi>x</mi><mn>2</mn></msub><mo stretchy="false">)</mo></mrow></mrow><mo maxsize="1.200em" minsize="1.200em">)</mo></mrow></mrow><mo>−</mo><mrow><mrow><mi mathvariant="normal">ℓ</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><msub><mi>x</mi><mn>1</mn></msub><mo stretchy="false">)</mo></mrow></mrow><mo lspace="0em" rspace="0em">​</mo><mi mathvariant="normal">ℓ</mi><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mi>x</mi><mn>2</mn></msub><mo stretchy="false">)</mo></mrow></mrow></mrow><mo fence="false">|</mo><mrow><mphantom></mphantom><mo>≤</mo><mrow><mn>4</mn><mo lspace="0em" rspace="0em">​</mo><msup><mi>c</mi><mn>2</mn></msup><mo lspace="0em" rspace="0em">​</mo><msup><mn>2</mn><mrow><mo>−</mo><mi>m</mi></mrow></msup></mrow></mrow></mrow></mrow><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">\displaystyle=4c^{2}\big|g\big(\ell(x_{1}),\ell(x_{2})\big)-\ell(x_{1})\ell(x_{2})\big|\leq 4c^{2}2^{-m}.</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="A5.SS2.p3.4" class="ltx_p"><span id="A5.SS2.p3.4.1" class="ltx_text">Moreover, the affine transformations before and after <math id="A5.SS2.p3.m10" class="ltx_Math" alttext="g" display="inline" intent=":literal"><semantics><mi>g</mi><annotation encoding="application/x-tex">g</annotation></semantics></math> can be absorbed into
the first and last layers.
Hence <math id="A5.SS2.p3.m11" class="ltx_Math" alttext="f" display="inline" intent=":literal"><semantics><mi>f</mi><annotation encoding="application/x-tex">f</annotation></semantics></math> can be represented by a multilayer perceptron with depth <math id="A5.SS2.p3.m12" class="ltx_Math" alttext="m+4" display="inline" intent=":literal"><semantics><mrow><mi>m</mi><mo>+</mo><mn>4</mn></mrow><annotation encoding="application/x-tex">m+4</annotation></semantics></math>, width <math id="A5.SS2.p3.m13" class="ltx_Math" alttext="7" display="inline" intent=":literal"><semantics><mn>7</mn><annotation encoding="application/x-tex">7</annotation></semantics></math> and all parameters bounded in absolute value by <math id="A5.SS2.p3.m14" class="ltx_Math" alttext="4c^{2}" display="inline" intent=":literal"><semantics><mrow><mn>4</mn><mo lspace="0em" rspace="0em">​</mo><msup><mi>c</mi><mn>2</mn></msup></mrow><annotation encoding="application/x-tex">4c^{2}</annotation></semantics></math>, where one of the seven neurons is used to store <math id="A5.SS2.p3.m15" class="ltx_Math" alttext="\ell(x_{1})+\ell(x_{2})" display="inline" intent=":literal"><semantics><mrow><mrow><mi mathvariant="normal">ℓ</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><msub><mi>x</mi><mn>1</mn></msub><mo stretchy="false">)</mo></mrow></mrow><mo>+</mo><mrow><mi mathvariant="normal">ℓ</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><msub><mi>x</mi><mn>2</mn></msub><mo stretchy="false">)</mo></mrow></mrow></mrow><annotation encoding="application/x-tex">\ell(x_{1})+\ell(x_{2})</annotation></semantics></math>.
Setting <math id="A5.SS2.p3.m16" class="ltx_Math" alttext="m=M-4" display="inline" intent=":literal"><semantics><mrow><mi>m</mi><mo>=</mo><mrow><mi>M</mi><mo>−</mo><mn>4</mn></mrow></mrow><annotation encoding="application/x-tex">m=M-4</annotation></semantics></math> proves the assertion.
∎</span></p>
</div>
</div>
<div id="Thmconj217" class="ltx_theorem ltx_theorem_lemma">
<h6 class="ltx_title ltx_runin ltx_title_theorem"><span class="ltx_tag ltx_tag_theorem"><span id="Thmconj217.4" class="ltx_text ltx_font_bold">Lemma 17</span></span><span id="Thmconj217.5" class="ltx_text ltx_font_bold">.</span></h6>
<div id="Thmconj217.p1" class="ltx_para">
<p id="Thmconj217.p1.1" class="ltx_p"><span id="Thmconj217.p1.1.1" class="ltx_text ltx_font_italic">For any <math id="Thmconj217.p1.m1" class="ltx_Math" alttext="d=2,3,\ldots" display="inline" intent=":literal"><semantics><mrow><mrow><mi>d</mi><mo>=</mo><mn>2</mn></mrow><mo>,</mo><mn>3</mn><mo>,</mo><mi mathvariant="normal">…</mi></mrow><annotation encoding="application/x-tex">d=2,3,\ldots</annotation></semantics></math> and <math id="Thmconj217.p1.m2" class="ltx_Math" alttext="M=5,6,\ldots" display="inline" intent=":literal"><semantics><mrow><mrow><mi>M</mi><mo>=</mo><mn>5</mn></mrow><mo>,</mo><mn>6</mn><mo>,</mo><mi mathvariant="normal">…</mi></mrow><annotation encoding="application/x-tex">M=5,6,\ldots</annotation></semantics></math>, there exists a multilayer perceptron <math id="Thmconj217.p1.m3" class="ltx_Math" alttext="f:\mathbb{R}\rightarrow\mathbb{R}" display="inline" intent=":literal"><semantics><mrow><mi>f</mi><mo lspace="0.278em" rspace="0.278em">:</mo><mrow><mi>ℝ</mi><mo stretchy="false">→</mo><mi>ℝ</mi></mrow></mrow><annotation encoding="application/x-tex">f:\mathbb{R}\rightarrow\mathbb{R}</annotation></semantics></math> with depth <math id="Thmconj217.p1.m4" class="ltx_Math" alttext="\lceil\log_{2}d\rceil M" display="inline" intent=":literal"><semantics><mrow><mrow><mo stretchy="false">⌈</mo><mrow><msub><mi>log</mi><mn>2</mn></msub><mo lspace="0.167em">⁡</mo><mi>d</mi></mrow><mo stretchy="false">⌉</mo></mrow><mo lspace="0em" rspace="0em">​</mo><mi>M</mi></mrow><annotation encoding="application/x-tex">\lceil\log_{2}d\rceil M</annotation></semantics></math>, width <math id="Thmconj217.p1.m5" class="ltx_Math" alttext="7d" display="inline" intent=":literal"><semantics><mrow><mn>7</mn><mo lspace="0em" rspace="0em">​</mo><mi>d</mi></mrow><annotation encoding="application/x-tex">7d</annotation></semantics></math>, and universally bounded parameters such that</span></p>
<table id="A5.Ex231" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="A5.Ex231.m1" class="ltx_Math" alttext="\sup_{x\in[-1,1]}\big|f(x)-x^{d}\big|\leq d^{2}2^{-M+6}." display="block" intent=":literal"><semantics><mrow><mrow><mrow><munder><mo movablelimits="false">sup</mo><mrow><mi>x</mi><mo>∈</mo><mrow><mo stretchy="false">[</mo><mrow><mrow><mo>−</mo><mn>1</mn></mrow><mo>,</mo><mn>1</mn></mrow><mo stretchy="false">]</mo></mrow></mrow></munder><mrow><mo lspace="0em" maxsize="1.200em" minsize="1.200em" stretchy="true">|</mo><mrow><mrow><mi>f</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>x</mi><mo stretchy="false">)</mo></mrow></mrow><mo>−</mo><msup><mi>x</mi><mi>d</mi></msup></mrow><mo maxsize="1.200em" minsize="1.200em" stretchy="true">|</mo></mrow></mrow><mo>≤</mo><mrow><msup><mi>d</mi><mn>2</mn></msup><mo lspace="0em" rspace="0em">​</mo><msup><mn>2</mn><mrow><mrow><mo>−</mo><mi>M</mi></mrow><mo>+</mo><mn>6</mn></mrow></msup></mrow></mrow><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">\sup_{x\in[-1,1]}\big|f(x)-x^{d}\big|\leq d^{2}2^{-M+6}.</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
</div>
<div id="Thmconj217.6" class="ltx_proof">
<h6 class="ltx_title ltx_runin ltx_font_italic ltx_title_proof">Proof.</h6>
<div id="Thmconj217.p2" class="ltx_para">
<p id="Thmconj217.p2.1" class="ltx_p"><span id="Thmconj217.p2.1.1" class="ltx_text">Let <math id="Thmconj217.p2.m1" class="ltx_Math" alttext="\tilde{g}:\mathbb{R}^{2}\rightarrow\mathbb{R}" display="inline" intent=":literal"><semantics><mrow><mover accent="true"><mi>g</mi><mo>~</mo></mover><mo lspace="0.278em" rspace="0.278em">:</mo><mrow><msup><mi>ℝ</mi><mn>2</mn></msup><mo stretchy="false">→</mo><mi>ℝ</mi></mrow></mrow><annotation encoding="application/x-tex">\tilde{g}:\mathbb{R}^{2}\rightarrow\mathbb{R}</annotation></semantics></math> be the multilayer perceptron defined in Lemma <a href="#Thmconj216" title="Lemma 16. ‣ E.2 Construction of multilayer perceptron layers ‣ Appendix E Construction of the Transformer ‣ Generalization Bounds for Transformer-Based Next-Token Prediction in a Language Model" class="ltx_ref"><span class="ltx_text ltx_ref_tag">16</span></a> with depth <math id="Thmconj217.p2.m2" class="ltx_Math" alttext="M" display="inline" intent=":literal"><semantics><mi>M</mi><annotation encoding="application/x-tex">M</annotation></semantics></math>, width <math id="Thmconj217.p2.m3" class="ltx_Math" alttext="7" display="inline" intent=":literal"><semantics><mn>7</mn><annotation encoding="application/x-tex">7</annotation></semantics></math> and all parameters bounded in absolute value by <math id="Thmconj217.p2.m4" class="ltx_Math" alttext="4" display="inline" intent=":literal"><semantics><mn>4</mn><annotation encoding="application/x-tex">4</annotation></semantics></math>, such that <math id="Thmconj217.p2.m5" class="ltx_Math" alttext="\sup_{y_{1},y_{2}\in[-1,1]}|\tilde{g}(y_{1},y_{2})-y_{1}y_{2}|\leq 2^{-M+6}." display="inline" intent=":literal"><semantics><mrow><mrow><mrow><msub><mo>sup</mo><mrow><msub><mi>y</mi><mn>1</mn></msub><mo>,</mo><mrow><msub><mi>y</mi><mn>2</mn></msub><mo>∈</mo><mrow><mo stretchy="false">[</mo><mrow><mrow><mo>−</mo><mn>1</mn></mrow><mo>,</mo><mn>1</mn></mrow><mo stretchy="false">]</mo></mrow></mrow></mrow></msub><mrow><mo lspace="0em" stretchy="false">|</mo><mrow><mrow><mover accent="true"><mi>g</mi><mo>~</mo></mover><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mi>y</mi><mn>1</mn></msub><mo>,</mo><msub><mi>y</mi><mn>2</mn></msub><mo stretchy="false">)</mo></mrow></mrow><mo>−</mo><mrow><msub><mi>y</mi><mn>1</mn></msub><mo lspace="0em" rspace="0em">​</mo><msub><mi>y</mi><mn>2</mn></msub></mrow></mrow><mo stretchy="false">|</mo></mrow></mrow><mo>≤</mo><msup><mn>2</mn><mrow><mrow><mo>−</mo><mi>M</mi></mrow><mo>+</mo><mn>6</mn></mrow></msup></mrow><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">\sup_{y_{1},y_{2}\in[-1,1]}|\tilde{g}(y_{1},y_{2})-y_{1}y_{2}|\leq 2^{-M+6}.</annotation></semantics></math>
To ensure that the output lies in the range <math id="Thmconj217.p2.m6" class="ltx_Math" alttext="[-1,1]" display="inline" intent=":literal"><semantics><mrow><mo stretchy="false">[</mo><mrow><mrow><mo>−</mo><mn>1</mn></mrow><mo>,</mo><mn>1</mn></mrow><mo stretchy="false">]</mo></mrow><annotation encoding="application/x-tex">[-1,1]</annotation></semantics></math>, define</span></p>
<table id="A5.EGx105" class="ltx_equationgroup ltx_eqn_align ltx_eqn_table">

<tbody id="A5.Ex232"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_align_right ltx_eqn_cell"><math id="A5.Ex232.m1" class="ltx_Math" alttext="\displaystyle g(x_{1},x_{2})\coloneqq\big(\tilde{g}(x_{1},x_{2})+1\big)_{+}-\big(\tilde{g}(x_{1},x_{2})-1\big)_{+}-1=\begin{cases}-1,&amp;\quad\tilde{g}(x_{1},x_{2})&lt;-1\\
\tilde{g}(x_{1},x_{2}),&amp;\quad\tilde{g}(x_{1},x_{2})\in[-1,1]\\
1,&amp;\quad\tilde{g}(x_{1},x_{2})&gt;1.\end{cases}" display="inline" intent=":literal"><semantics><mrow><mrow><mi>g</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><msub><mi>x</mi><mn>1</mn></msub><mo>,</mo><msub><mi>x</mi><mn>2</mn></msub><mo stretchy="false">)</mo></mrow></mrow><mo>≔</mo><mrow><msub><mrow><mo maxsize="1.200em" minsize="1.200em">(</mo><mrow><mrow><mover accent="true"><mi>g</mi><mo>~</mo></mover><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mi>x</mi><mn>1</mn></msub><mo>,</mo><msub><mi>x</mi><mn>2</mn></msub><mo stretchy="false">)</mo></mrow></mrow><mo>+</mo><mn>1</mn></mrow><mo maxsize="1.200em" minsize="1.200em">)</mo></mrow><mo>+</mo></msub><mo>−</mo><msub><mrow><mo maxsize="1.200em" minsize="1.200em">(</mo><mrow><mrow><mover accent="true"><mi>g</mi><mo>~</mo></mover><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mi>x</mi><mn>1</mn></msub><mo>,</mo><msub><mi>x</mi><mn>2</mn></msub><mo stretchy="false">)</mo></mrow></mrow><mo>−</mo><mn>1</mn></mrow><mo maxsize="1.200em" minsize="1.200em">)</mo></mrow><mo>+</mo></msub><mo>−</mo><mn>1</mn></mrow><mo>=</mo><mrow><mo>{</mo><mtable columnspacing="5pt" rowspacing="0pt"><mtr><mtd class="ltx_align_left" columnalign="left"><mrow><mrow><mo>−</mo><mn>1</mn></mrow><mo>,</mo></mrow></mtd><mtd class="ltx_align_left" columnalign="left"><mrow><mrow><mover accent="true"><mi>g</mi><mo>~</mo></mover><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mi>x</mi><mn>1</mn></msub><mo>,</mo><msub><mi>x</mi><mn>2</mn></msub><mo stretchy="false">)</mo></mrow></mrow><mo>&lt;</mo><mrow><mo>−</mo><mn>1</mn></mrow></mrow></mtd></mtr><mtr><mtd class="ltx_align_left" columnalign="left"><mrow><mrow><mover accent="true"><mi>g</mi><mo>~</mo></mover><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mi>x</mi><mn>1</mn></msub><mo>,</mo><msub><mi>x</mi><mn>2</mn></msub><mo stretchy="false">)</mo></mrow></mrow><mo>,</mo></mrow></mtd><mtd class="ltx_align_left" columnalign="left"><mrow><mrow><mover accent="true"><mi>g</mi><mo>~</mo></mover><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mi>x</mi><mn>1</mn></msub><mo>,</mo><msub><mi>x</mi><mn>2</mn></msub><mo stretchy="false">)</mo></mrow></mrow><mo>∈</mo><mrow><mo stretchy="false">[</mo><mrow><mrow><mo>−</mo><mn>1</mn></mrow><mo>,</mo><mn>1</mn></mrow><mo stretchy="false">]</mo></mrow></mrow></mtd></mtr><mtr><mtd class="ltx_align_left" columnalign="left"><mrow><mn>1</mn><mo>,</mo></mrow></mtd><mtd class="ltx_align_left" columnalign="left"><mrow><mrow><mrow><mover accent="true"><mi>g</mi><mo>~</mo></mover><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mi>x</mi><mn>1</mn></msub><mo>,</mo><msub><mi>x</mi><mn>2</mn></msub><mo stretchy="false">)</mo></mrow></mrow><mo>&gt;</mo><mn>1</mn></mrow><mo lspace="0em">.</mo></mrow></mtd></mtr></mtable></mrow></mrow><annotation encoding="application/x-tex">\displaystyle g(x_{1},x_{2})\coloneqq\big(\tilde{g}(x_{1},x_{2})+1\big)_{+}-\big(\tilde{g}(x_{1},x_{2})-1\big)_{+}-1=\begin{cases}-1,&amp;\quad\tilde{g}(x_{1},x_{2})&lt;-1\\
\tilde{g}(x_{1},x_{2}),&amp;\quad\tilde{g}(x_{1},x_{2})\in[-1,1]\\
1,&amp;\quad\tilde{g}(x_{1},x_{2})&gt;1.\end{cases}</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="Thmconj217.p2.2" class="ltx_p"><span id="Thmconj217.p2.2.1" class="ltx_text">Then,
<math id="Thmconj217.p2.m7" class="ltx_Math" alttext="g:\mathbb{R}^{2}\rightarrow[-1,1]" display="inline" intent=":literal"><semantics><mrow><mi>g</mi><mo lspace="0.278em" rspace="0.278em">:</mo><mrow><msup><mi>ℝ</mi><mn>2</mn></msup><mo stretchy="false">→</mo><mrow><mo stretchy="false">[</mo><mrow><mrow><mo>−</mo><mn>1</mn></mrow><mo>,</mo><mn>1</mn></mrow><mo stretchy="false">]</mo></mrow></mrow></mrow><annotation encoding="application/x-tex">g:\mathbb{R}^{2}\rightarrow[-1,1]</annotation></semantics></math> is a multilayer perceptron with depth <math id="Thmconj217.p2.m8" class="ltx_Math" alttext="M+1" display="inline" intent=":literal"><semantics><mrow><mi>M</mi><mo>+</mo><mn>1</mn></mrow><annotation encoding="application/x-tex">M+1</annotation></semantics></math>, width <math id="Thmconj217.p2.m9" class="ltx_Math" alttext="7" display="inline" intent=":literal"><semantics><mn>7</mn><annotation encoding="application/x-tex">7</annotation></semantics></math> and all parameters bounded in absolute value by <math id="Thmconj217.p2.m10" class="ltx_Math" alttext="4" display="inline" intent=":literal"><semantics><mn>4</mn><annotation encoding="application/x-tex">4</annotation></semantics></math>, satisfying</span></p>
<table id="A5.EGx106" class="ltx_equationgroup ltx_eqn_align ltx_eqn_table">

<tbody id="A5.E55"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_align_right ltx_eqn_cell"><math id="A5.E55.m1" class="ltx_Math" alttext="\displaystyle\sup_{y_{1},y_{2}\in[-1,1]}|g(y_{1},y_{2})-y_{1}y_{2}|\leq 2^{-M+6}." display="inline" intent=":literal"><semantics><mrow><mrow><mrow><munder><mo movablelimits="false">sup</mo><mrow><msub><mi>y</mi><mn>1</mn></msub><mo>,</mo><mrow><msub><mi>y</mi><mn>2</mn></msub><mo>∈</mo><mrow><mo stretchy="false">[</mo><mrow><mrow><mo>−</mo><mn>1</mn></mrow><mo>,</mo><mn>1</mn></mrow><mo stretchy="false">]</mo></mrow></mrow></mrow></munder><mrow><mo lspace="0em" stretchy="false">|</mo><mrow><mrow><mi>g</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><msub><mi>y</mi><mn>1</mn></msub><mo>,</mo><msub><mi>y</mi><mn>2</mn></msub><mo stretchy="false">)</mo></mrow></mrow><mo>−</mo><mrow><msub><mi>y</mi><mn>1</mn></msub><mo lspace="0em" rspace="0em">​</mo><msub><mi>y</mi><mn>2</mn></msub></mrow></mrow><mo stretchy="false">|</mo></mrow></mrow><mo>≤</mo><msup><mn>2</mn><mrow><mrow><mo>−</mo><mi>M</mi></mrow><mo>+</mo><mn>6</mn></mrow></msup></mrow><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">\displaystyle\sup_{y_{1},y_{2}\in[-1,1]}|g(y_{1},y_{2})-y_{1}y_{2}|\leq 2^{-M+6}.</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td>
<td rowspan="1" class="ltx_eqn_cell ltx_eqn_eqno ltx_align_middle ltx_align_right"><span class="ltx_tag ltx_tag_equation ltx_align_right">(55)</span></td></tr></tbody>
</table>
</div>
<div id="Thmconj217.p3" class="ltx_para">
<p id="Thmconj217.p3.1" class="ltx_p"><span id="Thmconj217.p3.1.1" class="ltx_text">We construct the multilayer perceptron <math id="Thmconj217.p3.m1" class="ltx_Math" alttext="f" display="inline" intent=":literal"><semantics><mi>f</mi><annotation encoding="application/x-tex">f</annotation></semantics></math> as follows.
Let <math id="Thmconj217.p3.m2" class="ltx_Math" alttext="q\coloneqq\lceil\log_{2}d\rceil" display="inline" intent=":literal"><semantics><mrow><mi>q</mi><mo>≔</mo><mrow><mo stretchy="false">⌈</mo><mrow><msub><mi>log</mi><mn>2</mn></msub><mo lspace="0.167em">⁡</mo><mi>d</mi></mrow><mo stretchy="false">⌉</mo></mrow></mrow><annotation encoding="application/x-tex">q\coloneqq\lceil\log_{2}d\rceil</annotation></semantics></math> and define</span></p>
<table id="A5.Ex233" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="A5.Ex233.m1" class="ltx_Math" alttext="\bm{\ell}:x\mapsto(\underbrace{x,\ldots,x}_{d},\underbrace{1,\ldots,1}_{2^{q}-d})^{\top}." display="block" intent=":literal"><semantics><mrow><mrow><mi class="ltx_mathvariant_bold" mathvariant="bold">ℓ</mi><mo lspace="0.278em" rspace="0.278em">:</mo><mrow><mi>x</mi><mo stretchy="false">↦</mo><msup><mrow><mo stretchy="false">(</mo><munder><munder accentunder="true"><mrow><mi>x</mi><mo>,</mo><mi mathvariant="normal">…</mi><mo>,</mo><mi>x</mi></mrow><mo stretchy="true">⏟</mo></munder><mi>d</mi></munder><mo>,</mo><munder><munder accentunder="true"><mrow><mn>1</mn><mo>,</mo><mi mathvariant="normal">…</mi><mo>,</mo><mn>1</mn></mrow><mo stretchy="true">⏟</mo></munder><mrow><msup><mn>2</mn><mi>q</mi></msup><mo>−</mo><mi>d</mi></mrow></munder><mo stretchy="false">)</mo></mrow><mo>⊤</mo></msup></mrow></mrow><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">\bm{\ell}:x\mapsto(\underbrace{x,\ldots,x}_{d},\underbrace{1,\ldots,1}_{2^{q}-d})^{\top}.</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="Thmconj217.p3.2" class="ltx_p"><span id="Thmconj217.p3.2.1" class="ltx_text">Let <math id="Thmconj217.p3.m3" class="ltx_Math" alttext="\ell(x)=(x_{1},\ldots,x_{2^{q}})^{\top}" display="inline" intent=":literal"><semantics><mrow><mrow><mi mathvariant="normal">ℓ</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>x</mi><mo stretchy="false">)</mo></mrow></mrow><mo>=</mo><msup><mrow><mo stretchy="false">(</mo><msub><mi>x</mi><mn>1</mn></msub><mo>,</mo><mi mathvariant="normal">…</mi><mo>,</mo><msub><mi>x</mi><msup><mn>2</mn><mi>q</mi></msup></msub><mo stretchy="false">)</mo></mrow><mo>⊤</mo></msup></mrow><annotation encoding="application/x-tex">\ell(x)=(x_{1},\ldots,x_{2^{q}})^{\top}</annotation></semantics></math>.
Starting from <math id="Thmconj217.p3.m4" class="ltx_Math" alttext="(\ell(x)" display="inline" intent=":literal"><semantics><mrow><mo stretchy="false">(</mo><mrow><mi mathvariant="normal">ℓ</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>x</mi><mo stretchy="false">)</mo></mrow></mrow><mo fence="true" lspace="0em">CLOSE</mo></mrow><annotation encoding="application/x-tex">(\ell(x)</annotation></semantics></math>,
we apply <math id="Thmconj217.p3.m5" class="ltx_Math" alttext="g" display="inline" intent=":literal"><semantics><mi>g</mi><annotation encoding="application/x-tex">g</annotation></semantics></math> to the <math id="Thmconj217.p3.m6" class="ltx_Math" alttext="2^{q-1}" display="inline" intent=":literal"><semantics><msup><mn>2</mn><mrow><mi>q</mi><mo>−</mo><mn>1</mn></mrow></msup><annotation encoding="application/x-tex">2^{q-1}</annotation></semantics></math> pairs <math id="Thmconj217.p3.m7" class="ltx_Math" alttext="(x_{1},x_{2}),\ldots,(x_{2^{q}-1},x_{2^{q}})" display="inline" intent=":literal"><semantics><mrow><mrow><mo stretchy="false">(</mo><msub><mi>x</mi><mn>1</mn></msub><mo>,</mo><msub><mi>x</mi><mn>2</mn></msub><mo stretchy="false">)</mo></mrow><mo>,</mo><mi mathvariant="normal">…</mi><mo>,</mo><mrow><mo stretchy="false">(</mo><msub><mi>x</mi><mrow><msup><mn>2</mn><mi>q</mi></msup><mo>−</mo><mn>1</mn></mrow></msub><mo>,</mo><msub><mi>x</mi><msup><mn>2</mn><mi>q</mi></msup></msub><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">(x_{1},x_{2}),\ldots,(x_{2^{q}-1},x_{2^{q}})</annotation></semantics></math> to compute <math id="Thmconj217.p3.m8" class="ltx_Math" alttext="g(x_{1},x_{2}),\ldots,g(x_{2^{q}-1},x_{2^{q}})" display="inline" intent=":literal"><semantics><mrow><mrow><mi>g</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><msub><mi>x</mi><mn>1</mn></msub><mo>,</mo><msub><mi>x</mi><mn>2</mn></msub><mo stretchy="false">)</mo></mrow></mrow><mo>,</mo><mi mathvariant="normal">…</mi><mo>,</mo><mrow><mi>g</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><msub><mi>x</mi><mrow><msup><mn>2</mn><mi>q</mi></msup><mo>−</mo><mn>1</mn></mrow></msub><mo>,</mo><msub><mi>x</mi><msup><mn>2</mn><mi>q</mi></msup></msub><mo stretchy="false">)</mo></mrow></mrow></mrow><annotation encoding="application/x-tex">g(x_{1},x_{2}),\ldots,g(x_{2^{q}-1},x_{2^{q}})</annotation></semantics></math>.
Then, we pair neighboring entries and apply <math id="Thmconj217.p3.m9" class="ltx_Math" alttext="g" display="inline" intent=":literal"><semantics><mi>g</mi><annotation encoding="application/x-tex">g</annotation></semantics></math> again to the resulting <math id="Thmconj217.p3.m10" class="ltx_Math" alttext="2^{q-2}" display="inline" intent=":literal"><semantics><msup><mn>2</mn><mrow><mi>q</mi><mo>−</mo><mn>2</mn></mrow></msup><annotation encoding="application/x-tex">2^{q-2}</annotation></semantics></math> pairs.
This procedure is continued until only one entry remains.
Since affine transformations before and after a multilayer perceptron can
be absorbed into the first and last layers, the resulting network has depth
<math id="Thmconj217.p3.m11" class="ltx_Math" alttext="qM" display="inline" intent=":literal"><semantics><mrow><mi>q</mi><mo lspace="0em" rspace="0em">​</mo><mi>M</mi></mrow><annotation encoding="application/x-tex">qM</annotation></semantics></math>, width <math id="Thmconj217.p3.m12" class="ltx_Math" alttext="7\cdot 2^{q-1}\leq 7d" display="inline" intent=":literal"><semantics><mrow><mrow><mn>7</mn><mo lspace="0.222em" rspace="0.222em">⋅</mo><msup><mn>2</mn><mrow><mi>q</mi><mo>−</mo><mn>1</mn></mrow></msup></mrow><mo>≤</mo><mrow><mn>7</mn><mo lspace="0em" rspace="0em">​</mo><mi>d</mi></mrow></mrow><annotation encoding="application/x-tex">7\cdot 2^{q-1}\leq 7d</annotation></semantics></math>, and all parameters are bounded by a
constant independent of <math id="Thmconj217.p3.m13" class="ltx_Math" alttext="d" display="inline" intent=":literal"><semantics><mi>d</mi><annotation encoding="application/x-tex">d</annotation></semantics></math> and <math id="Thmconj217.p3.m14" class="ltx_Math" alttext="M" display="inline" intent=":literal"><semantics><mi>M</mi><annotation encoding="application/x-tex">M</annotation></semantics></math>.</span></p>
</div>
<div id="Thmconj217.p4" class="ltx_para">
<p id="Thmconj217.p4.1" class="ltx_p"><span id="Thmconj217.p4.1.1" class="ltx_text">If <math id="Thmconj217.p4.m1" class="ltx_Math" alttext="y_{1},y_{2},\tilde{y}_{1},\tilde{y}_{2}\in[-1,1]" display="inline" intent=":literal"><semantics><mrow><msub><mi>y</mi><mn>1</mn></msub><mo>,</mo><msub><mi>y</mi><mn>2</mn></msub><mo>,</mo><msub><mover accent="true"><mi>y</mi><mo>~</mo></mover><mn>1</mn></msub><mo>,</mo><mrow><msub><mover accent="true"><mi>y</mi><mo>~</mo></mover><mn>2</mn></msub><mo>∈</mo><mrow><mo stretchy="false">[</mo><mrow><mrow><mo>−</mo><mn>1</mn></mrow><mo>,</mo><mn>1</mn></mrow><mo stretchy="false">]</mo></mrow></mrow></mrow><annotation encoding="application/x-tex">y_{1},y_{2},\tilde{y}_{1},\tilde{y}_{2}\in[-1,1]</annotation></semantics></math>, then by (<a href="#A5.E55" title="In Proof. ‣ Lemma 17. ‣ E.2 Construction of multilayer perceptron layers ‣ Appendix E Construction of the Transformer ‣ Generalization Bounds for Transformer-Based Next-Token Prediction in a Language Model" class="ltx_ref"><span class="ltx_text ltx_ref_tag">55</span></a>)
and the triangle inequality,
<math id="Thmconj217.p4.m2" class="ltx_Math" alttext="|g(\tilde{y}_{1},\tilde{y}_{2})-y_{1}y_{2}|\leq 2^{-M+6}+|\tilde{y}_{1}-y_{1}|+|\tilde{y}_{2}-y_{2}|." display="inline" intent=":literal"><semantics><mrow><mrow><mrow><mo stretchy="false">|</mo><mrow><mrow><mi>g</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><msub><mover accent="true"><mi>y</mi><mo>~</mo></mover><mn>1</mn></msub><mo>,</mo><msub><mover accent="true"><mi>y</mi><mo>~</mo></mover><mn>2</mn></msub><mo stretchy="false">)</mo></mrow></mrow><mo>−</mo><mrow><msub><mi>y</mi><mn>1</mn></msub><mo lspace="0em" rspace="0em">​</mo><msub><mi>y</mi><mn>2</mn></msub></mrow></mrow><mo stretchy="false">|</mo></mrow><mo>≤</mo><mrow><msup><mn>2</mn><mrow><mrow><mo>−</mo><mi>M</mi></mrow><mo>+</mo><mn>6</mn></mrow></msup><mo>+</mo><mrow><mo stretchy="false">|</mo><mrow><msub><mover accent="true"><mi>y</mi><mo>~</mo></mover><mn>1</mn></msub><mo>−</mo><msub><mi>y</mi><mn>1</mn></msub></mrow><mo stretchy="false">|</mo></mrow><mo>+</mo><mrow><mo stretchy="false">|</mo><mrow><msub><mover accent="true"><mi>y</mi><mo>~</mo></mover><mn>2</mn></msub><mo>−</mo><msub><mi>y</mi><mn>2</mn></msub></mrow><mo stretchy="false">|</mo></mrow></mrow></mrow><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">|g(\tilde{y}_{1},\tilde{y}_{2})-y_{1}y_{2}|\leq 2^{-M+6}+|\tilde{y}_{1}-y_{1}|+|\tilde{y}_{2}-y_{2}|.</annotation></semantics></math>
By induction on the number of iterated multiplication steps <math id="Thmconj217.p4.m3" class="ltx_Math" alttext="q" display="inline" intent=":literal"><semantics><mi>q</mi><annotation encoding="application/x-tex">q</annotation></semantics></math>, we obtain</span></p>
<table id="A5.Ex234" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="A5.Ex234.m1" class="ltx_Math" alttext="\left|f(x)-x^{d}\right|\leq 3^{q-1}2^{-M+6}\leq 3^{\log_{2}d}2^{-M+6}\leq d^{2}2^{-M+6}" display="block" intent=":literal"><semantics><mrow><mrow><mo>|</mo><mrow><mrow><mi>f</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>x</mi><mo stretchy="false">)</mo></mrow></mrow><mo>−</mo><msup><mi>x</mi><mi>d</mi></msup></mrow><mo>|</mo></mrow><mo>≤</mo><mrow><msup><mn>3</mn><mrow><mi>q</mi><mo>−</mo><mn>1</mn></mrow></msup><mo lspace="0em" rspace="0em">​</mo><msup><mn>2</mn><mrow><mrow><mo>−</mo><mi>M</mi></mrow><mo>+</mo><mn>6</mn></mrow></msup></mrow><mo>≤</mo><mrow><msup><mn>3</mn><mrow><msub><mi>log</mi><mn>2</mn></msub><mo lspace="0.167em">⁡</mo><mi>d</mi></mrow></msup><mo lspace="0em" rspace="0em">​</mo><msup><mn>2</mn><mrow><mrow><mo>−</mo><mi>M</mi></mrow><mo>+</mo><mn>6</mn></mrow></msup></mrow><mo>≤</mo><mrow><msup><mi>d</mi><mn>2</mn></msup><mo lspace="0em" rspace="0em">​</mo><msup><mn>2</mn><mrow><mrow><mo>−</mo><mi>M</mi></mrow><mo>+</mo><mn>6</mn></mrow></msup></mrow></mrow><annotation encoding="application/x-tex">\left|f(x)-x^{d}\right|\leq 3^{q-1}2^{-M+6}\leq 3^{\log_{2}d}2^{-M+6}\leq d^{2}2^{-M+6}</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="Thmconj217.p4.2" class="ltx_p"><span id="Thmconj217.p4.2.1" class="ltx_text">for any <math id="Thmconj217.p4.m4" class="ltx_Math" alttext="x\in[-1,1]" display="inline" intent=":literal"><semantics><mrow><mi>x</mi><mo>∈</mo><mrow><mo stretchy="false">[</mo><mrow><mrow><mo>−</mo><mn>1</mn></mrow><mo>,</mo><mn>1</mn></mrow><mo stretchy="false">]</mo></mrow></mrow><annotation encoding="application/x-tex">x\in[-1,1]</annotation></semantics></math>.
∎</span></p>
</div>
</div>
</div>
<div id="A5.SS2.p4" class="ltx_para">
<p id="A5.SS2.p4.1" class="ltx_p">The next lemma states that multilayer perceptrons can approximate analytic functions at exponential rates.
We adapt Theorem 6 of <cite class="ltx_cite ltx_citemacro_cite">[<a href="#bib.bib32" title="" class="ltx_ref">77</a>]</cite> to the case of bounded parameters.
Compared with their result, our result achieves the same error rate using a more shallow but wider architecture.</p>
</div>
<div id="Thmconj218" class="ltx_theorem ltx_theorem_lemma">
<h6 class="ltx_title ltx_runin ltx_title_theorem"><span class="ltx_tag ltx_tag_theorem"><span id="Thmconj218.4" class="ltx_text ltx_font_bold">Lemma 18</span></span><span id="Thmconj218.5" class="ltx_text ltx_font_bold">.</span></h6>
<div id="Thmconj218.p1" class="ltx_para">
<p id="Thmconj218.p1.1" class="ltx_p"><span id="Thmconj218.p1.1.1" class="ltx_text ltx_font_italic">Assume that the power series <math id="Thmconj218.p1.m1" class="ltx_Math" alttext="f_{0}(x)=\sum_{k=0}^{\infty}a_{k}x^{k}" display="inline" intent=":literal"><semantics><mrow><mrow><msub><mi>f</mi><mn>0</mn></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>x</mi><mo stretchy="false">)</mo></mrow></mrow><mo rspace="0.111em">=</mo><mrow><msubsup><mo>∑</mo><mrow><mi>k</mi><mo>=</mo><mn>0</mn></mrow><mi mathvariant="normal">∞</mi></msubsup><mrow><msub><mi>a</mi><mi>k</mi></msub><mo lspace="0em" rspace="0em">​</mo><msup><mi>x</mi><mi>k</mi></msup></mrow></mrow></mrow><annotation encoding="application/x-tex">f_{0}(x)=\sum_{k=0}^{\infty}a_{k}x^{k}</annotation></semantics></math> is absolutely convergent in <math id="Thmconj218.p1.m2" class="ltx_Math" alttext="[-1,1]" display="inline" intent=":literal"><semantics><mrow><mo stretchy="false">[</mo><mrow><mrow><mo>−</mo><mn>1</mn></mrow><mo>,</mo><mn>1</mn></mrow><mo stretchy="false">]</mo></mrow><annotation encoding="application/x-tex">[-1,1]</annotation></semantics></math> and <math id="Thmconj218.p1.m3" class="ltx_Math" alttext="A\coloneqq\sum_{k=0}^{\infty}|a_{k}|&lt;\infty" display="inline" intent=":literal"><semantics><mrow><mi>A</mi><mo rspace="0.111em">≔</mo><mrow><msubsup><mo rspace="0em">∑</mo><mrow><mi>k</mi><mo>=</mo><mn>0</mn></mrow><mi mathvariant="normal">∞</mi></msubsup><mrow><mo stretchy="false">|</mo><msub><mi>a</mi><mi>k</mi></msub><mo stretchy="false">|</mo></mrow></mrow><mo>&lt;</mo><mi mathvariant="normal">∞</mi></mrow><annotation encoding="application/x-tex">A\coloneqq\sum_{k=0}^{\infty}|a_{k}|&lt;\infty</annotation></semantics></math>.
Given fixed <math id="Thmconj218.p1.m4" class="ltx_Math" alttext="\delta\in(0,1)" display="inline" intent=":literal"><semantics><mrow><mi>δ</mi><mo>∈</mo><mrow><mo stretchy="false">(</mo><mn>0</mn><mo>,</mo><mn>1</mn><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">\delta\in(0,1)</annotation></semantics></math>, for any sufficiently large <math id="Thmconj218.p1.m5" class="ltx_Math" alttext="M\in\mathbb{N}" display="inline" intent=":literal"><semantics><mrow><mi>M</mi><mo>∈</mo><mi>ℕ</mi></mrow><annotation encoding="application/x-tex">M\in\mathbb{N}</annotation></semantics></math>, there exists a multilayer perceptron <math id="Thmconj218.p1.m6" class="ltx_Math" alttext="f:\mathbb{R}\rightarrow\mathbb{R}" display="inline" intent=":literal"><semantics><mrow><mi>f</mi><mo lspace="0.278em" rspace="0.278em">:</mo><mrow><mi>ℝ</mi><mo stretchy="false">→</mo><mi>ℝ</mi></mrow></mrow><annotation encoding="application/x-tex">f:\mathbb{R}\rightarrow\mathbb{R}</annotation></semantics></math> with depth <math id="Thmconj218.p1.m7" class="ltx_Math" alttext="\lceil\log_{2}(M/\delta)\rceil M" display="inline" intent=":literal"><semantics><mrow><mrow><mo stretchy="false">⌈</mo><mrow><msub><mi>log</mi><mn>2</mn></msub><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mrow><mi>M</mi><mo>/</mo><mi>δ</mi></mrow><mo stretchy="false">)</mo></mrow></mrow><mo stretchy="false">⌉</mo></mrow><mo lspace="0em" rspace="0em">​</mo><mi>M</mi></mrow><annotation encoding="application/x-tex">\lceil\log_{2}(M/\delta)\rceil M</annotation></semantics></math>, width <math id="Thmconj218.p1.m8" class="ltx_Math" alttext="7\lceil M/\delta\rceil^{2}" display="inline" intent=":literal"><semantics><mrow><mn>7</mn><mo lspace="0em" rspace="0em">​</mo><msup><mrow><mo stretchy="false">⌈</mo><mrow><mi>M</mi><mo>/</mo><mi>δ</mi></mrow><mo stretchy="false">⌉</mo></mrow><mn>2</mn></msup></mrow><annotation encoding="application/x-tex">7\lceil M/\delta\rceil^{2}</annotation></semantics></math>, and parameters bounded in absolute value by a constant depending only on <math id="Thmconj218.p1.m9" class="ltx_Math" alttext="A" display="inline" intent=":literal"><semantics><mi>A</mi><annotation encoding="application/x-tex">A</annotation></semantics></math>, such that</span></p>
<table id="A5.Ex235" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="A5.Ex235.m1" class="ltx_Math" alttext="\sup_{x\in[-1+\delta,1-\delta]}\,\big|f(x)-f_{0}(x)\big|\leq\frac{A(M+1)^{2}2^{-M+6}}{\delta^{2}}." display="block" intent=":literal"><semantics><mrow><mrow><mrow><munder><mo movablelimits="false">sup</mo><mrow><mi>x</mi><mo>∈</mo><mrow><mo stretchy="false">[</mo><mrow><mrow><mrow><mo>−</mo><mn>1</mn></mrow><mo>+</mo><mi>δ</mi></mrow><mo>,</mo><mrow><mn>1</mn><mo>−</mo><mi>δ</mi></mrow></mrow><mo stretchy="false">]</mo></mrow></mrow></munder><mrow><mo lspace="0.170em" maxsize="1.200em" minsize="1.200em" stretchy="true">|</mo><mrow><mrow><mi>f</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>x</mi><mo stretchy="false">)</mo></mrow></mrow><mo>−</mo><mrow><msub><mi>f</mi><mn>0</mn></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>x</mi><mo stretchy="false">)</mo></mrow></mrow></mrow><mo maxsize="1.200em" minsize="1.200em" stretchy="true">|</mo></mrow></mrow><mo>≤</mo><mfrac><mrow><mi>A</mi><mo lspace="0em" rspace="0em">​</mo><msup><mrow><mo stretchy="false">(</mo><mrow><mi>M</mi><mo>+</mo><mn>1</mn></mrow><mo stretchy="false">)</mo></mrow><mn>2</mn></msup><mo lspace="0em" rspace="0em">​</mo><msup><mn>2</mn><mrow><mrow><mo>−</mo><mi>M</mi></mrow><mo>+</mo><mn>6</mn></mrow></msup></mrow><msup><mi>δ</mi><mn>2</mn></msup></mfrac></mrow><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">\sup_{x\in[-1+\delta,1-\delta]}\,\big|f(x)-f_{0}(x)\big|\leq\frac{A(M+1)^{2}2^{-M+6}}{\delta^{2}}.</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
</div>
</div>
<div id="A5.SS2.3" class="ltx_proof">
<h6 class="ltx_title ltx_runin ltx_font_italic ltx_title_proof">Proof.</h6>
<div id="A5.SS2.p5" class="ltx_para">
<p id="A5.SS2.p5.1" class="ltx_p"><span id="A5.SS2.p5.1.1" class="ltx_text">For given <math id="A5.SS2.p5.m1" class="ltx_Math" alttext="q\in\mathbb{N}" display="inline" intent=":literal"><semantics><mrow><mi>q</mi><mo>∈</mo><mi>ℕ</mi></mrow><annotation encoding="application/x-tex">q\in\mathbb{N}</annotation></semantics></math>, define</span></p>
<table id="A5.Ex236" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="A5.Ex236.m1" class="ltx_Math" alttext="P_{q}(x)\coloneqq\sum_{k=0}^{q-1}a_{k}x^{k},\quad R_{q}(x)\coloneqq\sum_{k=q}^{\infty}a_{k}x^{k}." display="block" intent=":literal"><semantics><mrow><mrow><mrow><mrow><msub><mi>P</mi><mi>q</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>x</mi><mo stretchy="false">)</mo></mrow></mrow><mo rspace="0.111em">≔</mo><mrow><munderover><mo movablelimits="false">∑</mo><mrow><mi>k</mi><mo>=</mo><mn>0</mn></mrow><mrow><mi>q</mi><mo>−</mo><mn>1</mn></mrow></munderover><mrow><msub><mi>a</mi><mi>k</mi></msub><mo lspace="0em" rspace="0em">​</mo><msup><mi>x</mi><mi>k</mi></msup></mrow></mrow></mrow><mo rspace="1.167em">,</mo><mrow><mrow><msub><mi>R</mi><mi>q</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>x</mi><mo stretchy="false">)</mo></mrow></mrow><mo rspace="0.111em">≔</mo><mrow><munderover><mo movablelimits="false">∑</mo><mrow><mi>k</mi><mo>=</mo><mi>q</mi></mrow><mi mathvariant="normal">∞</mi></munderover><mrow><msub><mi>a</mi><mi>k</mi></msub><mo lspace="0em" rspace="0em">​</mo><msup><mi>x</mi><mi>k</mi></msup></mrow></mrow></mrow></mrow><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">P_{q}(x)\coloneqq\sum_{k=0}^{q-1}a_{k}x^{k},\quad R_{q}(x)\coloneqq\sum_{k=q}^{\infty}a_{k}x^{k}.</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="A5.SS2.p5.2" class="ltx_p"><span id="A5.SS2.p5.2.1" class="ltx_text">For <math id="A5.SS2.p5.m2" class="ltx_Math" alttext="x\in[-1+\delta,1-\delta]" display="inline" intent=":literal"><semantics><mrow><mi>x</mi><mo>∈</mo><mrow><mo stretchy="false">[</mo><mrow><mrow><mrow><mo>−</mo><mn>1</mn></mrow><mo>+</mo><mi>δ</mi></mrow><mo>,</mo><mrow><mn>1</mn><mo>−</mo><mi>δ</mi></mrow></mrow><mo stretchy="false">]</mo></mrow></mrow><annotation encoding="application/x-tex">x\in[-1+\delta,1-\delta]</annotation></semantics></math>, we have
<math id="A5.SS2.p5.m3" class="ltx_Math" alttext="|R_{q}(x)|\leq(1-\delta)^{q}\sum_{k=q}^{\infty}|a_{k}|\leq A(1-\delta)^{q}" display="inline" intent=":literal"><semantics><mrow><mrow><mo stretchy="false">|</mo><mrow><msub><mi>R</mi><mi>q</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>x</mi><mo stretchy="false">)</mo></mrow></mrow><mo stretchy="false">|</mo></mrow><mo>≤</mo><mrow><msup><mrow><mo stretchy="false">(</mo><mrow><mn>1</mn><mo>−</mo><mi>δ</mi></mrow><mo stretchy="false">)</mo></mrow><mi>q</mi></msup><mo lspace="0em" rspace="0em">​</mo><mrow><msubsup><mo rspace="0em">∑</mo><mrow><mi>k</mi><mo>=</mo><mi>q</mi></mrow><mi mathvariant="normal">∞</mi></msubsup><mrow><mo stretchy="false">|</mo><msub><mi>a</mi><mi>k</mi></msub><mo stretchy="false">|</mo></mrow></mrow></mrow><mo>≤</mo><mrow><mi>A</mi><mo lspace="0em" rspace="0em">​</mo><msup><mrow><mo stretchy="false">(</mo><mrow><mn>1</mn><mo>−</mo><mi>δ</mi></mrow><mo stretchy="false">)</mo></mrow><mi>q</mi></msup></mrow></mrow><annotation encoding="application/x-tex">|R_{q}(x)|\leq(1-\delta)^{q}\sum_{k=q}^{\infty}|a_{k}|\leq A(1-\delta)^{q}</annotation></semantics></math> and hence</span></p>
<table id="A5.EGx107" class="ltx_equationgroup ltx_eqn_align ltx_eqn_table">

<tbody id="A5.E56"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_align_right ltx_eqn_cell"><math id="A5.E56.m1" class="ltx_Math" alttext="\displaystyle\sup_{x\in[-1+\delta,1-\delta]}|P_{q}(x)-f_{0}(x)|\leq A(1-\delta)^{q}." display="inline" intent=":literal"><semantics><mrow><mrow><mrow><munder><mo movablelimits="false">sup</mo><mrow><mi>x</mi><mo>∈</mo><mrow><mo stretchy="false">[</mo><mrow><mrow><mrow><mo>−</mo><mn>1</mn></mrow><mo>+</mo><mi>δ</mi></mrow><mo>,</mo><mrow><mn>1</mn><mo>−</mo><mi>δ</mi></mrow></mrow><mo stretchy="false">]</mo></mrow></mrow></munder><mrow><mo lspace="0em" stretchy="false">|</mo><mrow><mrow><msub><mi>P</mi><mi>q</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>x</mi><mo stretchy="false">)</mo></mrow></mrow><mo>−</mo><mrow><msub><mi>f</mi><mn>0</mn></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>x</mi><mo stretchy="false">)</mo></mrow></mrow></mrow><mo stretchy="false">|</mo></mrow></mrow><mo>≤</mo><mrow><mi>A</mi><mo lspace="0em" rspace="0em">​</mo><msup><mrow><mo stretchy="false">(</mo><mrow><mn>1</mn><mo>−</mo><mi>δ</mi></mrow><mo stretchy="false">)</mo></mrow><mi>q</mi></msup></mrow></mrow><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">\displaystyle\sup_{x\in[-1+\delta,1-\delta]}|P_{q}(x)-f_{0}(x)|\leq A(1-\delta)^{q}.</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td>
<td rowspan="1" class="ltx_eqn_cell ltx_eqn_eqno ltx_align_middle ltx_align_right"><span class="ltx_tag ltx_tag_equation ltx_align_right">(56)</span></td></tr></tbody>
</table>
<p id="A5.SS2.p5.3" class="ltx_p"><span id="A5.SS2.p5.3.1" class="ltx_text">In the following proof, we approximate <math id="A5.SS2.p5.m4" class="ltx_Math" alttext="P_{q}(x)" display="inline" intent=":literal"><semantics><mrow><msub><mi>P</mi><mi>q</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>x</mi><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">P_{q}(x)</annotation></semantics></math>, with <math id="A5.SS2.p5.m5" class="ltx_Math" alttext="q" display="inline" intent=":literal"><semantics><mi>q</mi><annotation encoding="application/x-tex">q</annotation></semantics></math> to be chosen later.</span></p>
</div>
<div id="A5.SS2.p6" class="ltx_para">
<p id="A5.SS2.p6.1" class="ltx_p"><span id="A5.SS2.p6.1.1" class="ltx_text">For each <math id="A5.SS2.p6.m1" class="ltx_Math" alttext="d=2,\ldots,q-1" display="inline" intent=":literal"><semantics><mrow><mrow><mi>d</mi><mo>=</mo><mn>2</mn></mrow><mo>,</mo><mi mathvariant="normal">…</mi><mo>,</mo><mrow><mi>q</mi><mo>−</mo><mn>1</mn></mrow></mrow><annotation encoding="application/x-tex">d=2,\ldots,q-1</annotation></semantics></math>, we apply Lemma <a href="#Thmconj217" title="Lemma 17. ‣ E.2 Construction of multilayer perceptron layers ‣ Appendix E Construction of the Transformer ‣ Generalization Bounds for Transformer-Based Next-Token Prediction in a Language Model" class="ltx_ref"><span class="ltx_text ltx_ref_tag">17</span></a>
to approximate <math id="A5.SS2.p6.m2" class="ltx_Math" alttext="x^{d}" display="inline" intent=":literal"><semantics><msup><mi>x</mi><mi>d</mi></msup><annotation encoding="application/x-tex">x^{d}</annotation></semantics></math>.
By running these subnetworks in parallel, together with the outputs <math id="A5.SS2.p6.m3" class="ltx_Math" alttext="1" display="inline" intent=":literal"><semantics><mn>1</mn><annotation encoding="application/x-tex">1</annotation></semantics></math> and <math id="A5.SS2.p6.m4" class="ltx_Math" alttext="x" display="inline" intent=":literal"><semantics><mi>x</mi><annotation encoding="application/x-tex">x</annotation></semantics></math>,
we construct a multilayer perceptron <math id="A5.SS2.p6.m5" class="ltx_Math" alttext="\mathbf{g}:\mathbb{R}\rightarrow\mathbb{R}^{q}" display="inline" intent=":literal"><semantics><mrow><mi>𝐠</mi><mo lspace="0.278em" rspace="0.278em">:</mo><mrow><mi>ℝ</mi><mo stretchy="false">→</mo><msup><mi>ℝ</mi><mi>q</mi></msup></mrow></mrow><annotation encoding="application/x-tex">\mathbf{g}:\mathbb{R}\rightarrow\mathbb{R}^{q}</annotation></semantics></math> with depth <math id="A5.SS2.p6.m6" class="ltx_Math" alttext="\lceil\log_{2}(q-1)\rceil M" display="inline" intent=":literal"><semantics><mrow><mrow><mo stretchy="false">⌈</mo><mrow><msub><mi>log</mi><mn>2</mn></msub><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mrow><mi>q</mi><mo>−</mo><mn>1</mn></mrow><mo stretchy="false">)</mo></mrow></mrow><mo stretchy="false">⌉</mo></mrow><mo lspace="0em" rspace="0em">​</mo><mi>M</mi></mrow><annotation encoding="application/x-tex">\lceil\log_{2}(q-1)\rceil M</annotation></semantics></math>, width <math id="A5.SS2.p6.m7" class="ltx_Math" alttext="1+\sum_{d=2}^{q-1}7d\leq 7q^{2}" display="inline" intent=":literal"><semantics><mrow><mrow><mn>1</mn><mo rspace="0.055em">+</mo><mrow><msubsup><mo>∑</mo><mrow><mi>d</mi><mo>=</mo><mn>2</mn></mrow><mrow><mi>q</mi><mo>−</mo><mn>1</mn></mrow></msubsup><mrow><mn>7</mn><mo lspace="0em" rspace="0em">​</mo><mi>d</mi></mrow></mrow></mrow><mo>≤</mo><mrow><mn>7</mn><mo lspace="0em" rspace="0em">​</mo><msup><mi>q</mi><mn>2</mn></msup></mrow></mrow><annotation encoding="application/x-tex">1+\sum_{d=2}^{q-1}7d\leq 7q^{2}</annotation></semantics></math> and bounded parameters such that</span></p>
<table id="A5.Ex237" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="A5.Ex237.m1" class="ltx_Math" alttext="\sup_{x\in[-1,1]}\Big\|\mathbf{g}(x)-(x^{\alpha})_{\alpha\in\{0,1,\ldots,q-1\}}\Big\|_{\infty}\leq(q-1)^{2}2^{-M+6}." display="block" intent=":literal"><semantics><mrow><mrow><mrow><munder><mo movablelimits="false">sup</mo><mrow><mi>x</mi><mo>∈</mo><mrow><mo stretchy="false">[</mo><mrow><mrow><mo>−</mo><mn>1</mn></mrow><mo>,</mo><mn>1</mn></mrow><mo stretchy="false">]</mo></mrow></mrow></munder><msub><mrow><mo lspace="0em" maxsize="1.600em" minsize="1.600em" stretchy="true">‖</mo><mrow><mrow><mi>𝐠</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>x</mi><mo stretchy="false">)</mo></mrow></mrow><mo>−</mo><msub><mrow><mo stretchy="false">(</mo><msup><mi>x</mi><mi>α</mi></msup><mo stretchy="false">)</mo></mrow><mrow><mi>α</mi><mo>∈</mo><mrow><mo stretchy="false">{</mo><mrow><mn>0</mn><mo>,</mo><mn>1</mn><mo>,</mo><mi mathvariant="normal">…</mi><mo>,</mo><mrow><mi>q</mi><mo>−</mo><mn>1</mn></mrow></mrow><mo stretchy="false">}</mo></mrow></mrow></msub></mrow><mo maxsize="1.600em" minsize="1.600em" stretchy="true">‖</mo></mrow><mi mathvariant="normal">∞</mi></msub></mrow><mo>≤</mo><mrow><msup><mrow><mo stretchy="false">(</mo><mrow><mi>q</mi><mo>−</mo><mn>1</mn></mrow><mo stretchy="false">)</mo></mrow><mn>2</mn></msup><mo lspace="0em" rspace="0em">​</mo><msup><mn>2</mn><mrow><mrow><mo>−</mo><mi>M</mi></mrow><mo>+</mo><mn>6</mn></mrow></msup></mrow></mrow><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">\sup_{x\in[-1,1]}\Big\|\mathbf{g}(x)-(x^{\alpha})_{\alpha\in\{0,1,\ldots,q-1\}}\Big\|_{\infty}\leq(q-1)^{2}2^{-M+6}.</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="A5.SS2.p6.2" class="ltx_p"><span id="A5.SS2.p6.2.1" class="ltx_text">Define <math id="A5.SS2.p6.m8" class="ltx_Math" alttext="f:\mathbb{R}\rightarrow\mathbb{R}" display="inline" intent=":literal"><semantics><mrow><mi>f</mi><mo lspace="0.278em" rspace="0.278em">:</mo><mrow><mi>ℝ</mi><mo stretchy="false">→</mo><mi>ℝ</mi></mrow></mrow><annotation encoding="application/x-tex">f:\mathbb{R}\rightarrow\mathbb{R}</annotation></semantics></math> by</span></p>
<table id="A5.EGx108" class="ltx_equationgroup ltx_eqn_align ltx_eqn_table">

<tbody id="A5.Ex238"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_align_right ltx_eqn_cell"><math id="A5.Ex238.m1" class="ltx_Math" alttext="\displaystyle f(x)\coloneqq\big\langle(a_{0},a_{1},\ldots,a_{q-1})^{\top},\mathbf{g}(x)\big\rangle." display="inline" intent=":literal"><semantics><mrow><mrow><mrow><mi>f</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>x</mi><mo stretchy="false">)</mo></mrow></mrow><mo>≔</mo><mrow><mo stretchy="false">⟨</mo><mrow><msup><mrow><mo stretchy="false">(</mo><msub><mi>a</mi><mn>0</mn></msub><mo>,</mo><msub><mi>a</mi><mn>1</mn></msub><mo>,</mo><mi mathvariant="normal">…</mi><mo>,</mo><msub><mi>a</mi><mrow><mi>q</mi><mo>−</mo><mn>1</mn></mrow></msub><mo stretchy="false">)</mo></mrow><mo>⊤</mo></msup><mo>,</mo><mrow><mi>𝐠</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>x</mi><mo stretchy="false">)</mo></mrow></mrow></mrow><mo stretchy="false">⟩</mo></mrow></mrow><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">\displaystyle f(x)\coloneqq\big\langle(a_{0},a_{1},\ldots,a_{q-1})^{\top},\mathbf{g}(x)\big\rangle.</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="A5.SS2.p6.3" class="ltx_p"><span id="A5.SS2.p6.3.1" class="ltx_text">Then <math id="A5.SS2.p6.m9" class="ltx_Math" alttext="f" display="inline" intent=":literal"><semantics><mi>f</mi><annotation encoding="application/x-tex">f</annotation></semantics></math> can be represented by a multilayer perceptron with depth <math id="A5.SS2.p6.m10" class="ltx_Math" alttext="\lceil\log_{2}(q-1)\rceil M" display="inline" intent=":literal"><semantics><mrow><mrow><mo stretchy="false">⌈</mo><mrow><msub><mi>log</mi><mn>2</mn></msub><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mrow><mi>q</mi><mo>−</mo><mn>1</mn></mrow><mo stretchy="false">)</mo></mrow></mrow><mo stretchy="false">⌉</mo></mrow><mo lspace="0em" rspace="0em">​</mo><mi>M</mi></mrow><annotation encoding="application/x-tex">\lceil\log_{2}(q-1)\rceil M</annotation></semantics></math>, width <math id="A5.SS2.p6.m11" class="ltx_Math" alttext="7q^{2}" display="inline" intent=":literal"><semantics><mrow><mn>7</mn><mo lspace="0em" rspace="0em">​</mo><msup><mi>q</mi><mn>2</mn></msup></mrow><annotation encoding="application/x-tex">7q^{2}</annotation></semantics></math> and parameters bounded in absolute value by a constant depending only on <math id="A5.SS2.p6.m12" class="ltx_Math" alttext="A" display="inline" intent=":literal"><semantics><mi>A</mi><annotation encoding="application/x-tex">A</annotation></semantics></math>.
Moreover, for any <math id="A5.SS2.p6.m13" class="ltx_Math" alttext="x\in[-1,1]" display="inline" intent=":literal"><semantics><mrow><mi>x</mi><mo>∈</mo><mrow><mo stretchy="false">[</mo><mrow><mrow><mo>−</mo><mn>1</mn></mrow><mo>,</mo><mn>1</mn></mrow><mo stretchy="false">]</mo></mrow></mrow><annotation encoding="application/x-tex">x\in[-1,1]</annotation></semantics></math>,</span></p>
<table id="A5.EGx109" class="ltx_equationgroup ltx_eqn_align ltx_eqn_table">

<tbody id="A5.Ex239"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_align_right ltx_eqn_cell"><math id="A5.Ex239.m1" class="ltx_Math" alttext="\displaystyle\big|f(x)-P_{q}(x)\big|\leq\sum_{k=0}^{q-1}|a_{k}|\big|\big(\mathbf{g}\circ\bm{\ell}(x)\big)_{(k+1)}-x^{k}\big|\leq A(q-1)^{2}2^{-M+6}." display="inline" intent=":literal"><semantics><mrow><mrow><mrow><mo maxsize="1.200em" minsize="1.200em" stretchy="true">|</mo><mrow><mrow><mi>f</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>x</mi><mo stretchy="false">)</mo></mrow></mrow><mo>−</mo><mrow><msub><mi>P</mi><mi>q</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>x</mi><mo stretchy="false">)</mo></mrow></mrow></mrow><mo maxsize="1.200em" minsize="1.200em" stretchy="true">|</mo></mrow><mo>≤</mo><mrow><mstyle displaystyle="true"><munderover><mo movablelimits="false">∑</mo><mrow><mi>k</mi><mo>=</mo><mn>0</mn></mrow><mrow><mi>q</mi><mo>−</mo><mn>1</mn></mrow></munderover></mstyle><mrow><mrow><mo stretchy="false">|</mo><msub><mi>a</mi><mi>k</mi></msub><mo stretchy="false">|</mo></mrow><mo lspace="0em" rspace="0em">​</mo><mrow><mo maxsize="1.200em" minsize="1.200em" stretchy="true">|</mo><mrow><msub><mrow><mo maxsize="1.200em" minsize="1.200em">(</mo><mrow><mi>𝐠</mi><mo lspace="0.222em" rspace="0.222em">∘</mo><mrow><mi class="ltx_mathvariant_bold" mathvariant="bold">ℓ</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>x</mi><mo stretchy="false">)</mo></mrow></mrow></mrow><mo maxsize="1.200em" minsize="1.200em">)</mo></mrow><mrow><mo stretchy="false">(</mo><mrow><mi>k</mi><mo>+</mo><mn>1</mn></mrow><mo stretchy="false">)</mo></mrow></msub><mo>−</mo><msup><mi>x</mi><mi>k</mi></msup></mrow><mo maxsize="1.200em" minsize="1.200em" stretchy="true">|</mo></mrow></mrow></mrow><mo>≤</mo><mrow><mi>A</mi><mo lspace="0em" rspace="0em">​</mo><msup><mrow><mo stretchy="false">(</mo><mrow><mi>q</mi><mo>−</mo><mn>1</mn></mrow><mo stretchy="false">)</mo></mrow><mn>2</mn></msup><mo lspace="0em" rspace="0em">​</mo><msup><mn>2</mn><mrow><mrow><mo>−</mo><mi>M</mi></mrow><mo>+</mo><mn>6</mn></mrow></msup></mrow></mrow><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">\displaystyle\big|f(x)-P_{q}(x)\big|\leq\sum_{k=0}^{q-1}|a_{k}|\big|\big(\mathbf{g}\circ\bm{\ell}(x)\big)_{(k+1)}-x^{k}\big|\leq A(q-1)^{2}2^{-M+6}.</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="A5.SS2.p6.4" class="ltx_p"><span id="A5.SS2.p6.4.1" class="ltx_text">Combining with (<a href="#A5.E56" title="In Proof. ‣ E.2 Construction of multilayer perceptron layers ‣ Appendix E Construction of the Transformer ‣ Generalization Bounds for Transformer-Based Next-Token Prediction in a Language Model" class="ltx_ref"><span class="ltx_text ltx_ref_tag">56</span></a>), we have</span></p>
<table id="A5.EGx110" class="ltx_equationgroup ltx_eqn_align ltx_eqn_table">

<tbody id="A5.Ex240"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_align_right ltx_eqn_cell"><math id="A5.Ex240.m1" class="ltx_Math" alttext="\displaystyle\sup_{x\in[-1+\delta,1-\delta]}\,\big|f(x)-f_{0}(x)\big|\leq A(1-\delta)^{q}+A(q-1)^{2}2^{-M+6}." display="inline" intent=":literal"><semantics><mrow><mrow><mrow><munder><mo movablelimits="false">sup</mo><mrow><mi>x</mi><mo>∈</mo><mrow><mo stretchy="false">[</mo><mrow><mrow><mrow><mo>−</mo><mn>1</mn></mrow><mo>+</mo><mi>δ</mi></mrow><mo>,</mo><mrow><mn>1</mn><mo>−</mo><mi>δ</mi></mrow></mrow><mo stretchy="false">]</mo></mrow></mrow></munder><mrow><mo lspace="0.170em" maxsize="1.200em" minsize="1.200em" stretchy="true">|</mo><mrow><mrow><mi>f</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>x</mi><mo stretchy="false">)</mo></mrow></mrow><mo>−</mo><mrow><msub><mi>f</mi><mn>0</mn></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>x</mi><mo stretchy="false">)</mo></mrow></mrow></mrow><mo maxsize="1.200em" minsize="1.200em" stretchy="true">|</mo></mrow></mrow><mo>≤</mo><mrow><mrow><mi>A</mi><mo lspace="0em" rspace="0em">​</mo><msup><mrow><mo stretchy="false">(</mo><mrow><mn>1</mn><mo>−</mo><mi>δ</mi></mrow><mo stretchy="false">)</mo></mrow><mi>q</mi></msup></mrow><mo>+</mo><mrow><mi>A</mi><mo lspace="0em" rspace="0em">​</mo><msup><mrow><mo stretchy="false">(</mo><mrow><mi>q</mi><mo>−</mo><mn>1</mn></mrow><mo stretchy="false">)</mo></mrow><mn>2</mn></msup><mo lspace="0em" rspace="0em">​</mo><msup><mn>2</mn><mrow><mrow><mo>−</mo><mi>M</mi></mrow><mo>+</mo><mn>6</mn></mrow></msup></mrow></mrow></mrow><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">\displaystyle\sup_{x\in[-1+\delta,1-\delta]}\,\big|f(x)-f_{0}(x)\big|\leq A(1-\delta)^{q}+A(q-1)^{2}2^{-M+6}.</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="A5.SS2.p6.5" class="ltx_p"><span id="A5.SS2.p6.5.1" class="ltx_text">Choosing <math id="A5.SS2.p6.m14" class="ltx_Math" alttext="q=\lceil M/\delta\rceil" display="inline" intent=":literal"><semantics><mrow><mi>q</mi><mo>=</mo><mrow><mo stretchy="false">⌈</mo><mrow><mi>M</mi><mo>/</mo><mi>δ</mi></mrow><mo stretchy="false">⌉</mo></mrow></mrow><annotation encoding="application/x-tex">q=\lceil M/\delta\rceil</annotation></semantics></math>,
we obtain</span></p>
<table id="A5.Ex241" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="A5.Ex241.m1" class="ltx_Math" alttext="A(1-\delta)^{q}+A(q-1)^{2}2^{-M+6}\leq Ae^{-M}+\frac{AM^{2}2^{-M+6}}{\delta^{2}}\leq\frac{A(M+1)^{2}2^{-M+6}}{\delta^{2}}." display="block" intent=":literal"><semantics><mrow><mrow><mrow><mrow><mi>A</mi><mo lspace="0em" rspace="0em">​</mo><msup><mrow><mo stretchy="false">(</mo><mrow><mn>1</mn><mo>−</mo><mi>δ</mi></mrow><mo stretchy="false">)</mo></mrow><mi>q</mi></msup></mrow><mo>+</mo><mrow><mi>A</mi><mo lspace="0em" rspace="0em">​</mo><msup><mrow><mo stretchy="false">(</mo><mrow><mi>q</mi><mo>−</mo><mn>1</mn></mrow><mo stretchy="false">)</mo></mrow><mn>2</mn></msup><mo lspace="0em" rspace="0em">​</mo><msup><mn>2</mn><mrow><mrow><mo>−</mo><mi>M</mi></mrow><mo>+</mo><mn>6</mn></mrow></msup></mrow></mrow><mo>≤</mo><mrow><mrow><mi>A</mi><mo lspace="0em" rspace="0em">​</mo><msup><mi>e</mi><mrow><mo>−</mo><mi>M</mi></mrow></msup></mrow><mo>+</mo><mfrac><mrow><mi>A</mi><mo lspace="0em" rspace="0em">​</mo><msup><mi>M</mi><mn>2</mn></msup><mo lspace="0em" rspace="0em">​</mo><msup><mn>2</mn><mrow><mrow><mo>−</mo><mi>M</mi></mrow><mo>+</mo><mn>6</mn></mrow></msup></mrow><msup><mi>δ</mi><mn>2</mn></msup></mfrac></mrow><mo>≤</mo><mfrac><mrow><mi>A</mi><mo lspace="0em" rspace="0em">​</mo><msup><mrow><mo stretchy="false">(</mo><mrow><mi>M</mi><mo>+</mo><mn>1</mn></mrow><mo stretchy="false">)</mo></mrow><mn>2</mn></msup><mo lspace="0em" rspace="0em">​</mo><msup><mn>2</mn><mrow><mrow><mo>−</mo><mi>M</mi></mrow><mo>+</mo><mn>6</mn></mrow></msup></mrow><msup><mi>δ</mi><mn>2</mn></msup></mfrac></mrow><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">A(1-\delta)^{q}+A(q-1)^{2}2^{-M+6}\leq Ae^{-M}+\frac{AM^{2}2^{-M+6}}{\delta^{2}}\leq\frac{A(M+1)^{2}2^{-M+6}}{\delta^{2}}.</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="A5.SS2.p6.6" class="ltx_p"><span id="A5.SS2.p6.6.1" class="ltx_text">This proves the assertion.
∎</span></p>
</div>
</div>
<div id="Thmconj219" class="ltx_theorem ltx_theorem_lemma">
<h6 class="ltx_title ltx_runin ltx_title_theorem"><span class="ltx_tag ltx_tag_theorem"><span id="Thmconj219.4" class="ltx_text ltx_font_bold">Lemma 19</span></span><span id="Thmconj219.5" class="ltx_text ltx_font_bold"> </span>(Theorem 1 of <cite class="ltx_cite ltx_citemacro_cite">[<a href="#bib.bib35" title="" class="ltx_ref">45</a>]</cite>)<span id="Thmconj219.6" class="ltx_text ltx_font_bold">.</span></h6>
<div id="Thmconj219.p1" class="ltx_para">
<p id="Thmconj219.p1.1" class="ltx_p"><span id="Thmconj219.p1.1.1" class="ltx_text ltx_font_italic">Given a <math id="Thmconj219.p1.m1" class="ltx_Math" alttext="\beta" display="inline" intent=":literal"><semantics><mi>β</mi><annotation encoding="application/x-tex">\beta</annotation></semantics></math>-Hölder smooth function <math id="Thmconj219.p1.m2" class="ltx_Math" alttext="\mathbf{f}_{0}:[-c,c]^{d_{1}}\rightarrow\mathbb{R}^{d_{2}}" display="inline" intent=":literal"><semantics><mrow><msub><mi>𝐟</mi><mn>0</mn></msub><mo lspace="0.278em" rspace="0.278em">:</mo><mrow><msup><mrow><mo stretchy="false">[</mo><mrow><mrow><mo>−</mo><mi>c</mi></mrow><mo>,</mo><mi>c</mi></mrow><mo stretchy="false">]</mo></mrow><msub><mi>d</mi><mn>1</mn></msub></msup><mo stretchy="false">→</mo><msup><mi>ℝ</mi><msub><mi>d</mi><mn>2</mn></msub></msup></mrow></mrow><annotation encoding="application/x-tex">\mathbf{f}_{0}:[-c,c]^{d_{1}}\rightarrow\mathbb{R}^{d_{2}}</annotation></semantics></math>, for any sufficiently large <math id="Thmconj219.p1.m3" class="ltx_Math" alttext="M\in\mathbb{N}" display="inline" intent=":literal"><semantics><mrow><mi>M</mi><mo>∈</mo><mi>ℕ</mi></mrow><annotation encoding="application/x-tex">M\in\mathbb{N}</annotation></semantics></math>, there exists a multilayer perceptron <math id="Thmconj219.p1.m4" class="ltx_Math" alttext="\mathbf{f}:\mathbb{R}^{d_{1}}\rightarrow\mathbb{R}^{d_{2}}" display="inline" intent=":literal"><semantics><mrow><mi>𝐟</mi><mo lspace="0.278em" rspace="0.278em">:</mo><mrow><msup><mi>ℝ</mi><msub><mi>d</mi><mn>1</mn></msub></msup><mo stretchy="false">→</mo><msup><mi>ℝ</mi><msub><mi>d</mi><mn>2</mn></msub></msup></mrow></mrow><annotation encoding="application/x-tex">\mathbf{f}:\mathbb{R}^{d_{1}}\rightarrow\mathbb{R}^{d_{2}}</annotation></semantics></math>
with depth <math id="Thmconj219.p1.m5" class="ltx_Math" alttext="\lceil\log_{2}M\rceil^{2}" display="inline" intent=":literal"><semantics><msup><mrow><mo stretchy="false">⌈</mo><mrow><msub><mi>log</mi><mn>2</mn></msub><mo lspace="0.167em">⁡</mo><mi>M</mi></mrow><mo stretchy="false">⌉</mo></mrow><mn>2</mn></msup><annotation encoding="application/x-tex">\lceil\log_{2}M\rceil^{2}</annotation></semantics></math>, width <math id="Thmconj219.p1.m6" class="ltx_Math" alttext="M" display="inline" intent=":literal"><semantics><mi>M</mi><annotation encoding="application/x-tex">M</annotation></semantics></math>, and parameters bounded in absolute value by a constant depending only on <math id="Thmconj219.p1.m7" class="ltx_Math" alttext="(c,d_{1},\beta,\|\mathbf{f}_{0}\|_{\mathcal{C}^{\beta}})" display="inline" intent=":literal"><semantics><mrow><mo stretchy="false">(</mo><mi>c</mi><mo>,</mo><msub><mi>d</mi><mn>1</mn></msub><mo>,</mo><mi>β</mi><mo>,</mo><msub><mrow><mo stretchy="false">‖</mo><msub><mi>𝐟</mi><mn>0</mn></msub><mo stretchy="false">‖</mo></mrow><msup><mi class="ltx_font_mathcaligraphic">𝒞</mi><mi>β</mi></msup></msub><mo stretchy="false">)</mo></mrow><annotation encoding="application/x-tex">(c,d_{1},\beta,\|\mathbf{f}_{0}\|_{\mathcal{C}^{\beta}})</annotation></semantics></math> such that</span></p>
<table id="A5.Ex242" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="A5.Ex242.m1" class="ltx_Math" alttext="\sup_{\mathbf{x}\in[-c,c]^{d}}\|\mathbf{f}(\mathbf{x})-\mathbf{f}_{0}(\mathbf{x})\|_{\infty}\lesssim M^{-\frac{2\beta}{d_{1}}}," display="block" intent=":literal"><semantics><mrow><mrow><mrow><munder><mo movablelimits="false">sup</mo><mrow><mi>𝐱</mi><mo>∈</mo><msup><mrow><mo stretchy="false">[</mo><mrow><mrow><mo>−</mo><mi>c</mi></mrow><mo>,</mo><mi>c</mi></mrow><mo stretchy="false">]</mo></mrow><mi>d</mi></msup></mrow></munder><msub><mrow><mo lspace="0em" stretchy="false">‖</mo><mrow><mrow><mi>𝐟</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>𝐱</mi><mo stretchy="false">)</mo></mrow></mrow><mo>−</mo><mrow><msub><mi>𝐟</mi><mn>0</mn></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>𝐱</mi><mo stretchy="false">)</mo></mrow></mrow></mrow><mo stretchy="false">‖</mo></mrow><mi mathvariant="normal">∞</mi></msub></mrow><mo>≲</mo><msup><mi>M</mi><mrow><mo>−</mo><mfrac><mrow><mn>2</mn><mo lspace="0em" rspace="0em">​</mo><mi>β</mi></mrow><msub><mi>d</mi><mn>1</mn></msub></mfrac></mrow></msup></mrow><mo>,</mo></mrow><annotation encoding="application/x-tex">\sup_{\mathbf{x}\in[-c,c]^{d}}\|\mathbf{f}(\mathbf{x})-\mathbf{f}_{0}(\mathbf{x})\|_{\infty}\lesssim M^{-\frac{2\beta}{d_{1}}},</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="Thmconj219.p1.2" class="ltx_p"><span id="Thmconj219.p1.2.1" class="ltx_text ltx_font_italic">where the implicit constant depends only on <math id="Thmconj219.p1.m8" class="ltx_Math" alttext="(c,d_{1},\beta,\|\mathbf{f}_{0}\|_{\mathcal{C}^{\beta}})" display="inline" intent=":literal"><semantics><mrow><mo stretchy="false">(</mo><mi>c</mi><mo>,</mo><msub><mi>d</mi><mn>1</mn></msub><mo>,</mo><mi>β</mi><mo>,</mo><msub><mrow><mo stretchy="false">‖</mo><msub><mi>𝐟</mi><mn>0</mn></msub><mo stretchy="false">‖</mo></mrow><msup><mi class="ltx_font_mathcaligraphic">𝒞</mi><mi>β</mi></msup></msub><mo stretchy="false">)</mo></mrow><annotation encoding="application/x-tex">(c,d_{1},\beta,\|\mathbf{f}_{0}\|_{\mathcal{C}^{\beta}})</annotation></semantics></math>.</span></p>
</div>
</div>
<div id="Thmconj220" class="ltx_theorem ltx_theorem_lemma">
<h6 class="ltx_title ltx_runin ltx_title_theorem"><span class="ltx_tag ltx_tag_theorem"><span id="Thmconj220.4" class="ltx_text ltx_font_bold">Lemma 20</span></span><span id="Thmconj220.5" class="ltx_text ltx_font_bold">.</span></h6>
<div id="Thmconj220.p1" class="ltx_para">
<p id="Thmconj220.p1.1" class="ltx_p"><span id="Thmconj220.p1.1.1" class="ltx_text ltx_font_italic">Given a fixed <math id="Thmconj220.p1.m1" class="ltx_Math" alttext="c&gt;0" display="inline" intent=":literal"><semantics><mrow><mi>c</mi><mo>&gt;</mo><mn>0</mn></mrow><annotation encoding="application/x-tex">c&gt;0</annotation></semantics></math>, for any sufficiently large <math id="Thmconj220.p1.m2" class="ltx_Math" alttext="M" display="inline" intent=":literal"><semantics><mi>M</mi><annotation encoding="application/x-tex">M</annotation></semantics></math>, there exists a multilayer perceptron <math id="Thmconj220.p1.m3" class="ltx_Math" alttext="f:\mathbb{R}\rightarrow\mathbb{R}" display="inline" intent=":literal"><semantics><mrow><mi>f</mi><mo lspace="0.278em" rspace="0.278em">:</mo><mrow><mi>ℝ</mi><mo stretchy="false">→</mo><mi>ℝ</mi></mrow></mrow><annotation encoding="application/x-tex">f:\mathbb{R}\rightarrow\mathbb{R}</annotation></semantics></math>
with depth <math id="Thmconj220.p1.m4" class="ltx_Math" alttext="M^{2}" display="inline" intent=":literal"><semantics><msup><mi>M</mi><mn>2</mn></msup><annotation encoding="application/x-tex">M^{2}</annotation></semantics></math>, width <math id="Thmconj220.p1.m5" class="ltx_Math" alttext="33M^{2}" display="inline" intent=":literal"><semantics><mrow><mn>33</mn><mo lspace="0em" rspace="0em">​</mo><msup><mi>M</mi><mn>2</mn></msup></mrow><annotation encoding="application/x-tex">33M^{2}</annotation></semantics></math>, and parameters bounded in absolute value by a constant
depending only on <math id="Thmconj220.p1.m6" class="ltx_Math" alttext="c" display="inline" intent=":literal"><semantics><mi>c</mi><annotation encoding="application/x-tex">c</annotation></semantics></math> such that</span></p>
<table id="A5.Ex243" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="A5.Ex243.m1" class="ltx_Math" alttext="\sup_{x\in[-c,c]}|f(x)-\exp(x)|\lesssim M^{2}2^{-M}," display="block" intent=":literal"><semantics><mrow><mrow><mrow><munder><mo movablelimits="false">sup</mo><mrow><mi>x</mi><mo>∈</mo><mrow><mo stretchy="false">[</mo><mrow><mrow><mo>−</mo><mi>c</mi></mrow><mo>,</mo><mi>c</mi></mrow><mo stretchy="false">]</mo></mrow></mrow></munder><mrow><mo lspace="0em" stretchy="false">|</mo><mrow><mrow><mi>f</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>x</mi><mo stretchy="false">)</mo></mrow></mrow><mo>−</mo><mrow><mi>exp</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>x</mi><mo stretchy="false">)</mo></mrow></mrow></mrow><mo stretchy="false">|</mo></mrow></mrow><mo>≲</mo><mrow><msup><mi>M</mi><mn>2</mn></msup><mo lspace="0em" rspace="0em">​</mo><msup><mn>2</mn><mrow><mo>−</mo><mi>M</mi></mrow></msup></mrow></mrow><mo>,</mo></mrow><annotation encoding="application/x-tex">\sup_{x\in[-c,c]}|f(x)-\exp(x)|\lesssim M^{2}2^{-M},</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="Thmconj220.p1.2" class="ltx_p"><span id="Thmconj220.p1.2.1" class="ltx_text ltx_font_italic">where the implicit constant depends only on <math id="Thmconj220.p1.m7" class="ltx_Math" alttext="c" display="inline" intent=":literal"><semantics><mi>c</mi><annotation encoding="application/x-tex">c</annotation></semantics></math>.</span></p>
</div>
</div>
<div id="A5.SS2.4" class="ltx_proof">
<h6 class="ltx_title ltx_runin ltx_font_italic ltx_title_proof">Proof.</h6>
<div id="A5.SS2.p7" class="ltx_para">
<p id="A5.SS2.p7.1" class="ltx_p"><span id="A5.SS2.p7.1.1" class="ltx_text">Without loss of generality, assume that <math id="A5.SS2.p7.m1" class="ltx_Math" alttext="c\in\mathbb{N}" display="inline" intent=":literal"><semantics><mrow><mi>c</mi><mo>∈</mo><mi>ℕ</mi></mrow><annotation encoding="application/x-tex">c\in\mathbb{N}</annotation></semantics></math>. Otherwise, we replace <math id="A5.SS2.p7.m2" class="ltx_Math" alttext="c" display="inline" intent=":literal"><semantics><mi>c</mi><annotation encoding="application/x-tex">c</annotation></semantics></math> by <math id="A5.SS2.p7.m3" class="ltx_Math" alttext="\lceil c\rceil" display="inline" intent=":literal"><semantics><mrow><mo stretchy="false">⌈</mo><mi>c</mi><mo stretchy="false">⌉</mo></mrow><annotation encoding="application/x-tex">\lceil c\rceil</annotation></semantics></math> and apply the same argument.
Define</span></p>
<table id="A5.Ex244" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="A5.Ex244.m1" class="ltx_Math" alttext="f_{1}:x\mapsto\frac{x}{2c}." display="block" intent=":literal"><semantics><mrow><mrow><msub><mi>f</mi><mn>1</mn></msub><mo lspace="0.278em" rspace="0.278em">:</mo><mrow><mi>x</mi><mo stretchy="false">↦</mo><mfrac><mi>x</mi><mrow><mn>2</mn><mo lspace="0em" rspace="0em">​</mo><mi>c</mi></mrow></mfrac></mrow></mrow><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">f_{1}:x\mapsto\frac{x}{2c}.</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="A5.SS2.p7.2" class="ltx_p"><span id="A5.SS2.p7.2.1" class="ltx_text">By Lemma <a href="#Thmconj218" title="Lemma 18. ‣ E.2 Construction of multilayer perceptron layers ‣ Appendix E Construction of the Transformer ‣ Generalization Bounds for Transformer-Based Next-Token Prediction in a Language Model" class="ltx_ref"><span class="ltx_text ltx_ref_tag">18</span></a>, there exists a multilayer perceptron <math id="A5.SS2.p7.m4" class="ltx_Math" alttext="f_{2}:\mathbb{R}\rightarrow\mathbb{R}" display="inline" intent=":literal"><semantics><mrow><msub><mi>f</mi><mn>2</mn></msub><mo lspace="0.278em" rspace="0.278em">:</mo><mrow><mi>ℝ</mi><mo stretchy="false">→</mo><mi>ℝ</mi></mrow></mrow><annotation encoding="application/x-tex">f_{2}:\mathbb{R}\rightarrow\mathbb{R}</annotation></semantics></math> with depth <math id="A5.SS2.p7.m5" class="ltx_Math" alttext="\lceil\log_{2}(2M)\rceil M" display="inline" intent=":literal"><semantics><mrow><mrow><mo stretchy="false">⌈</mo><mrow><msub><mi>log</mi><mn>2</mn></msub><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mrow><mn>2</mn><mo lspace="0em" rspace="0em">​</mo><mi>M</mi></mrow><mo stretchy="false">)</mo></mrow></mrow><mo stretchy="false">⌉</mo></mrow><mo lspace="0em" rspace="0em">​</mo><mi>M</mi></mrow><annotation encoding="application/x-tex">\lceil\log_{2}(2M)\rceil M</annotation></semantics></math>, width <math id="A5.SS2.p7.m6" class="ltx_Math" alttext="32M^{2}" display="inline" intent=":literal"><semantics><mrow><mn>32</mn><mo lspace="0em" rspace="0em">​</mo><msup><mi>M</mi><mn>2</mn></msup></mrow><annotation encoding="application/x-tex">32M^{2}</annotation></semantics></math>, and bounded parameters such that</span></p>
<table id="A5.Ex245" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="A5.Ex245.m1" class="ltx_math_unparsed" alttext="\sup_{x\in[-1/2,1/2]}|f_{2}(x)-\exp(x)|\lesssim M^{2}2^{-M}." display="block" intent=":literal"><semantics><mrow><munder><mo movablelimits="false">sup</mo><mrow><mi>x</mi><mo>∈</mo><mo stretchy="false">[</mo><mo lspace="0em">−</mo><mn>1</mn><mo>/</mo><mn>2</mn><mo>,</mo><mn>1</mn><mo>/</mo><mn>2</mn><mo stretchy="false">]</mo></mrow></munder><mo fence="false" lspace="0em" rspace="0.167em" stretchy="false">|</mo><msub><mi>f</mi><mn>2</mn></msub><mrow><mo stretchy="false">(</mo><mi>x</mi><mo stretchy="false">)</mo></mrow><mo>−</mo><mi>exp</mi><mrow><mo stretchy="false">(</mo><mi>x</mi><mo stretchy="false">)</mo></mrow><mo fence="false" stretchy="false">|</mo><mo lspace="0.167em">≲</mo><msup><mi>M</mi><mn>2</mn></msup><msup><mn>2</mn><mrow><mo>−</mo><mi>M</mi></mrow></msup><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">\sup_{x\in[-1/2,1/2]}|f_{2}(x)-\exp(x)|\lesssim M^{2}2^{-M}.</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="A5.SS2.p7.3" class="ltx_p"><span id="A5.SS2.p7.3.1" class="ltx_text">Also, by Lemma <a href="#Thmconj217" title="Lemma 17. ‣ E.2 Construction of multilayer perceptron layers ‣ Appendix E Construction of the Transformer ‣ Generalization Bounds for Transformer-Based Next-Token Prediction in a Language Model" class="ltx_ref"><span class="ltx_text ltx_ref_tag">17</span></a>, there exists a multilayer perceptron <math id="A5.SS2.p7.m7" class="ltx_Math" alttext="f_{3}:\mathbb{R}\rightarrow\mathbb{R}" display="inline" intent=":literal"><semantics><mrow><msub><mi>f</mi><mn>3</mn></msub><mo lspace="0.278em" rspace="0.278em">:</mo><mrow><mi>ℝ</mi><mo stretchy="false">→</mo><mi>ℝ</mi></mrow></mrow><annotation encoding="application/x-tex">f_{3}:\mathbb{R}\rightarrow\mathbb{R}</annotation></semantics></math> with depth <math id="A5.SS2.p7.m8" class="ltx_Math" alttext="\lceil\log_{2}(2c)\rceil M" display="inline" intent=":literal"><semantics><mrow><mrow><mo stretchy="false">⌈</mo><mrow><msub><mi>log</mi><mn>2</mn></msub><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mrow><mn>2</mn><mo lspace="0em" rspace="0em">​</mo><mi>c</mi></mrow><mo stretchy="false">)</mo></mrow></mrow><mo stretchy="false">⌉</mo></mrow><mo lspace="0em" rspace="0em">​</mo><mi>M</mi></mrow><annotation encoding="application/x-tex">\lceil\log_{2}(2c)\rceil M</annotation></semantics></math>, width <math id="A5.SS2.p7.m9" class="ltx_Math" alttext="16c" display="inline" intent=":literal"><semantics><mrow><mn>16</mn><mo lspace="0em" rspace="0em">​</mo><mi>c</mi></mrow><annotation encoding="application/x-tex">16c</annotation></semantics></math> and bounded parameters such that</span></p>
<table id="A5.Ex246" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="A5.Ex246.m1" class="ltx_Math" alttext="\sup_{x\in[0,1]}|f_{3}(x)-x^{2c}|\lesssim 2^{-M}." display="block" intent=":literal"><semantics><mrow><mrow><mrow><munder><mo movablelimits="false">sup</mo><mrow><mi>x</mi><mo>∈</mo><mrow><mo stretchy="false">[</mo><mrow><mn>0</mn><mo>,</mo><mn>1</mn></mrow><mo stretchy="false">]</mo></mrow></mrow></munder><mrow><mo lspace="0em" stretchy="false">|</mo><mrow><mrow><msub><mi>f</mi><mn>3</mn></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>x</mi><mo stretchy="false">)</mo></mrow></mrow><mo>−</mo><msup><mi>x</mi><mrow><mn>2</mn><mo lspace="0em" rspace="0em">​</mo><mi>c</mi></mrow></msup></mrow><mo stretchy="false">|</mo></mrow></mrow><mo>≲</mo><msup><mn>2</mn><mrow><mo>−</mo><mi>M</mi></mrow></msup></mrow><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">\sup_{x\in[0,1]}|f_{3}(x)-x^{2c}|\lesssim 2^{-M}.</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="A5.SS2.p7.4" class="ltx_p"><span id="A5.SS2.p7.4.1" class="ltx_text">We obtain the assertion from the fact that</span></p>
<table id="A5.Ex247" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="A5.Ex247.m1" class="ltx_Math" alttext="f(x)\coloneq e^{2c}\,f_{3}\Big(\frac{f_{2}\circ f_{1}(x)}{e}\Big)" display="block" intent=":literal"><semantics><mrow><mrow><mi>f</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>x</mi><mo stretchy="false">)</mo></mrow></mrow><mo>≔</mo><mrow><msup><mi>e</mi><mrow><mn>2</mn><mo lspace="0em" rspace="0em">​</mo><mi>c</mi></mrow></msup><mo lspace="0em" rspace="0em">​</mo><msub><mi>f</mi><mn>3</mn></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo maxsize="1.600em" minsize="1.600em">(</mo><mfrac><mrow><mrow><msub><mi>f</mi><mn>2</mn></msub><mo lspace="0.222em" rspace="0.222em">∘</mo><msub><mi>f</mi><mn>1</mn></msub></mrow><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>x</mi><mo stretchy="false">)</mo></mrow></mrow><mi>e</mi></mfrac><mo maxsize="1.600em" minsize="1.600em">)</mo></mrow></mrow></mrow><annotation encoding="application/x-tex">f(x)\coloneq e^{2c}\,f_{3}\Big(\frac{f_{2}\circ f_{1}(x)}{e}\Big)</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="A5.SS2.p7.5" class="ltx_p"><span id="A5.SS2.p7.5.1" class="ltx_text">can be represented as a multilayer perceptron with depth <math id="A5.SS2.p7.m10" class="ltx_Math" alttext="\lceil\log_{2}(2M)\rceil M+\lceil\log_{2}(2c)\rceil M\leq M^{2}" display="inline" intent=":literal"><semantics><mrow><mrow><mrow><mrow><mo stretchy="false">⌈</mo><mrow><msub><mi>log</mi><mn>2</mn></msub><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mrow><mn>2</mn><mo lspace="0em" rspace="0em">​</mo><mi>M</mi></mrow><mo stretchy="false">)</mo></mrow></mrow><mo stretchy="false">⌉</mo></mrow><mo lspace="0em" rspace="0em">​</mo><mi>M</mi></mrow><mo>+</mo><mrow><mrow><mo stretchy="false">⌈</mo><mrow><msub><mi>log</mi><mn>2</mn></msub><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mrow><mn>2</mn><mo lspace="0em" rspace="0em">​</mo><mi>c</mi></mrow><mo stretchy="false">)</mo></mrow></mrow><mo stretchy="false">⌉</mo></mrow><mo lspace="0em" rspace="0em">​</mo><mi>M</mi></mrow></mrow><mo>≤</mo><msup><mi>M</mi><mn>2</mn></msup></mrow><annotation encoding="application/x-tex">\lceil\log_{2}(2M)\rceil M+\lceil\log_{2}(2c)\rceil M\leq M^{2}</annotation></semantics></math>, width <math id="A5.SS2.p7.m11" class="ltx_Math" alttext="32M^{2}+16c\leq 33M^{2}" display="inline" intent=":literal"><semantics><mrow><mrow><mrow><mn>32</mn><mo lspace="0em" rspace="0em">​</mo><msup><mi>M</mi><mn>2</mn></msup></mrow><mo>+</mo><mrow><mn>16</mn><mo lspace="0em" rspace="0em">​</mo><mi>c</mi></mrow></mrow><mo>≤</mo><mrow><mn>33</mn><mo lspace="0em" rspace="0em">​</mo><msup><mi>M</mi><mn>2</mn></msup></mrow></mrow><annotation encoding="application/x-tex">32M^{2}+16c\leq 33M^{2}</annotation></semantics></math>, and parameters bounded in absolute value by a constant depending only on <math id="A5.SS2.p7.m12" class="ltx_Math" alttext="c" display="inline" intent=":literal"><semantics><mi>c</mi><annotation encoding="application/x-tex">c</annotation></semantics></math>, and</span></p>
<table id="A5.EGx111" class="ltx_equationgroup ltx_eqn_align ltx_eqn_table">

<tbody id="A5.Ex248"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_align_right ltx_eqn_cell"><math id="A5.Ex248.m1" class="ltx_Math" alttext="\displaystyle\sup_{x\in[-c,c]}\big|f(x)-\exp(x)\big|" display="inline" intent=":literal"><semantics><mrow><munder><mo movablelimits="false">sup</mo><mrow><mi>x</mi><mo>∈</mo><mrow><mo stretchy="false">[</mo><mrow><mrow><mo>−</mo><mi>c</mi></mrow><mo>,</mo><mi>c</mi></mrow><mo stretchy="false">]</mo></mrow></mrow></munder><mrow><mo lspace="0em" maxsize="1.200em" minsize="1.200em" stretchy="true">|</mo><mrow><mrow><mi>f</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>x</mi><mo stretchy="false">)</mo></mrow></mrow><mo>−</mo><mrow><mi>exp</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>x</mi><mo stretchy="false">)</mo></mrow></mrow></mrow><mo maxsize="1.200em" minsize="1.200em" stretchy="true">|</mo></mrow></mrow><annotation encoding="application/x-tex">\displaystyle\sup_{x\in[-c,c]}\big|f(x)-\exp(x)\big|</annotation></semantics></math></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A5.Ex248.m2" class="ltx_math_unparsed" alttext="\displaystyle=\sup_{x\in[-1/2,1/2]}\Big|e^{2c}\,f_{3}\Big(\frac{f_{2}(x)}{e}\Big)-\exp(x)^{2c}\Big|" display="inline" intent=":literal"><semantics><mrow><mo rspace="0.1389em">=</mo><munder><mo lspace="0.1389em" movablelimits="false" rspace="0em">sup</mo><mrow><mi>x</mi><mo>∈</mo><mo stretchy="false">[</mo><mo lspace="0em">−</mo><mn>1</mn><mo>/</mo><mn>2</mn><mo>,</mo><mn>1</mn><mo>/</mo><mn>2</mn><mo stretchy="false">]</mo></mrow></munder><mo fence="false" maxsize="1.600em" minsize="1.600em" rspace="0.167em" stretchy="true">|</mo><msup><mi>e</mi><mrow><mn>2</mn><mo lspace="0em" rspace="0em">​</mo><mi>c</mi></mrow></msup><msub><mi>f</mi><mn>3</mn></msub><mrow><mo maxsize="1.600em" minsize="1.600em">(</mo><mstyle displaystyle="true"><mfrac><mrow><msub><mi>f</mi><mn>2</mn></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>x</mi><mo stretchy="false">)</mo></mrow></mrow><mi>e</mi></mfrac></mstyle><mo maxsize="1.600em" minsize="1.600em">)</mo></mrow><mo>−</mo><mi>exp</mi><msup><mrow><mo stretchy="false">(</mo><mi>x</mi><mo stretchy="false">)</mo></mrow><mrow><mn>2</mn><mo lspace="0em" rspace="0em">​</mo><mi>c</mi></mrow></msup><mo fence="false" maxsize="1.600em" minsize="1.600em" stretchy="true">|</mo></mrow><annotation encoding="application/x-tex">\displaystyle=\sup_{x\in[-1/2,1/2]}\Big|e^{2c}\,f_{3}\Big(\frac{f_{2}(x)}{e}\Big)-\exp(x)^{2c}\Big|</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
<tbody id="A5.Ex249"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_eqn_cell"></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A5.Ex249.m1" class="ltx_math_unparsed" alttext="\displaystyle\leq e^{2c}\sup_{x\in[-1/2,1/2]}\Big|f_{3}\Big(\frac{f_{2}(x)}{e}\Big)-\Big(\frac{f_{2}(x)}{e}\Big)^{2c}\Big|+\sup_{x\in[-1/2,1/2]}\big|f_{2}(x)^{2c}-\exp(x)^{2c}\big|" display="inline" intent=":literal"><semantics><mrow><mo>≤</mo><msup><mi>e</mi><mrow><mn>2</mn><mo lspace="0em" rspace="0em">​</mo><mi>c</mi></mrow></msup><munder><mo lspace="0.167em" movablelimits="false" rspace="0em">sup</mo><mrow><mi>x</mi><mo>∈</mo><mo stretchy="false">[</mo><mo lspace="0em">−</mo><mn>1</mn><mo>/</mo><mn>2</mn><mo>,</mo><mn>1</mn><mo>/</mo><mn>2</mn><mo stretchy="false">]</mo></mrow></munder><mo fence="false" maxsize="1.600em" minsize="1.600em" rspace="0.167em" stretchy="true">|</mo><msub><mi>f</mi><mn>3</mn></msub><mrow><mo maxsize="1.600em" minsize="1.600em">(</mo><mstyle displaystyle="true"><mfrac><mrow><msub><mi>f</mi><mn>2</mn></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>x</mi><mo stretchy="false">)</mo></mrow></mrow><mi>e</mi></mfrac></mstyle><mo maxsize="1.600em" minsize="1.600em">)</mo></mrow><mo>−</mo><msup><mrow><mo maxsize="1.600em" minsize="1.600em">(</mo><mstyle displaystyle="true"><mfrac><mrow><msub><mi>f</mi><mn>2</mn></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>x</mi><mo stretchy="false">)</mo></mrow></mrow><mi>e</mi></mfrac></mstyle><mo maxsize="1.600em" minsize="1.600em">)</mo></mrow><mrow><mn>2</mn><mo lspace="0em" rspace="0em">​</mo><mi>c</mi></mrow></msup><mo fence="false" maxsize="1.600em" minsize="1.600em" stretchy="true">|</mo><mo lspace="0em">+</mo><munder><mo lspace="0em" movablelimits="false" rspace="0em">sup</mo><mrow><mi>x</mi><mo>∈</mo><mo stretchy="false">[</mo><mo lspace="0em">−</mo><mn>1</mn><mo>/</mo><mn>2</mn><mo>,</mo><mn>1</mn><mo>/</mo><mn>2</mn><mo stretchy="false">]</mo></mrow></munder><mo fence="false" maxsize="1.200em" minsize="1.200em" rspace="0.167em" stretchy="true">|</mo><msub><mi>f</mi><mn>2</mn></msub><msup><mrow><mo stretchy="false">(</mo><mi>x</mi><mo stretchy="false">)</mo></mrow><mrow><mn>2</mn><mo lspace="0em" rspace="0em">​</mo><mi>c</mi></mrow></msup><mo>−</mo><mi>exp</mi><msup><mrow><mo stretchy="false">(</mo><mi>x</mi><mo stretchy="false">)</mo></mrow><mrow><mn>2</mn><mo lspace="0em" rspace="0em">​</mo><mi>c</mi></mrow></msup><mo fence="false" maxsize="1.200em" minsize="1.200em" stretchy="true">|</mo></mrow><annotation encoding="application/x-tex">\displaystyle\leq e^{2c}\sup_{x\in[-1/2,1/2]}\Big|f_{3}\Big(\frac{f_{2}(x)}{e}\Big)-\Big(\frac{f_{2}(x)}{e}\Big)^{2c}\Big|+\sup_{x\in[-1/2,1/2]}\big|f_{2}(x)^{2c}-\exp(x)^{2c}\big|</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
