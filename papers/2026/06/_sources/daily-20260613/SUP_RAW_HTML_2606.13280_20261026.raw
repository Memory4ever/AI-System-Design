<tbody id="A3.E43"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_align_right ltx_eqn_cell"><math id="A3.E43.m1" class="ltx_math_unparsed" alttext="\displaystyle\sup_{\mathbf{f}_{\bm{\theta}}\in\mathcal{TB}(N,H,L_{\mathrm{mlp}},N_{\mathrm{mlp}},B)}\,\|\mathbf{f}_{\bm{\theta}}\|_{L^{\infty}([-A,A]^{N\times T}])}" display="inline" intent=":literal"><semantics><mrow><mo movablelimits="false" rspace="0em">sup</mo><msub><mrow></mrow><mrow><msub><mi>𝐟</mi><mi>𝜽</mi></msub><mo>∈</mo><mrow><mi class="ltx_font_mathcaligraphic">𝒯</mi><mo lspace="0em" rspace="0em">​</mo><mi class="ltx_font_mathcaligraphic">ℬ</mi><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>N</mi><mo>,</mo><mi>H</mi><mo>,</mo><msub><mi>L</mi><mi>mlp</mi></msub><mo>,</mo><msub><mi>N</mi><mi>mlp</mi></msub><mo>,</mo><mi>B</mi><mo stretchy="false">)</mo></mrow></mrow></mrow></msub><mo lspace="0em" rspace="0.167em">∥</mo><mi>𝐟</mi><msub><mrow></mrow><mi>𝜽</mi></msub><mo lspace="0em">∥</mo><msub><mrow></mrow><mrow><mi>L</mi><msup><mrow></mrow><mi mathvariant="normal">∞</mi></msup><mo stretchy="false">(</mo><mo stretchy="false">[</mo><mo lspace="0em">−</mo><mi>A</mi><mo>,</mo><mi>A</mi><mo stretchy="false">]</mo><msup><mrow></mrow><mrow><mi>N</mi><mo lspace="0.222em" rspace="0.222em">×</mo><mi>T</mi></mrow></msup><mo stretchy="false">]</mo><mo stretchy="false">)</mo></mrow></msub></mrow><annotation encoding="application/x-tex">\displaystyle\sup_{\mathbf{f}_{\bm{\theta}}\in\mathcal{TB}(N,H,L_{\mathrm{mlp}},N_{\mathrm{mlp}},B)}\,\|\mathbf{f}_{\bm{\theta}}\|_{L^{\infty}([-A,A]^{N\times T}])}</annotation></semantics></math></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A3.E43.m2" class="ltx_Math" alttext="\displaystyle\leq 2HA\big(B(N_{\mathrm{mlp}}+1)\big)^{L_{\mathrm{mlp}}+2}," display="inline" intent=":literal"><semantics><mrow><mrow><mphantom></mphantom><mo>≤</mo><mrow><mn>2</mn><mo lspace="0em" rspace="0em">​</mo><mi>H</mi><mo lspace="0em" rspace="0em">​</mo><mi>A</mi><mo lspace="0em" rspace="0em">​</mo><msup><mrow><mo maxsize="1.200em" minsize="1.200em">(</mo><mrow><mi>B</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mrow><msub><mi>N</mi><mi>mlp</mi></msub><mo>+</mo><mn>1</mn></mrow><mo stretchy="false">)</mo></mrow></mrow><mo maxsize="1.200em" minsize="1.200em">)</mo></mrow><mrow><msub><mi>L</mi><mi>mlp</mi></msub><mo>+</mo><mn>2</mn></mrow></msup></mrow></mrow><mo>,</mo></mrow><annotation encoding="application/x-tex">\displaystyle\leq 2HA\big(B(N_{\mathrm{mlp}}+1)\big)^{L_{\mathrm{mlp}}+2},</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td>
<td rowspan="1" class="ltx_eqn_cell ltx_eqn_eqno ltx_align_middle ltx_align_right"><span class="ltx_tag ltx_tag_equation ltx_align_right">(43)</span></td></tr></tbody>
<tbody id="A3.E44"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_align_right ltx_eqn_cell"><math id="A3.E44.m1" class="ltx_Math" alttext="\displaystyle\sup_{\mathbf{f}_{\bm{\theta}}\in\mathcal{TB}(N,H,L_{\mathrm{mlp}},N_{\mathrm{mlp}},B),\,\mathbf{x},\mathbf{x}^{\prime}\in[-A,A]^{N\times T},\,\mathbf{x}\neq\mathbf{x}^{\prime}}\,\frac{\|\mathbf{f}_{\bm{\theta}}(\mathbf{x})-\mathbf{f}_{\bm{\theta}}(\mathbf{x}^{\prime})\|_{\infty}}{\|\mathbf{x}-\mathbf{x}^{\prime}\|_{\infty}}" display="inline" intent=":literal"><semantics><mrow><munder><mo movablelimits="false">sup</mo><mrow><mrow><msub><mi>𝐟</mi><mi>𝜽</mi></msub><mo>∈</mo><mrow><mi class="ltx_font_mathcaligraphic">𝒯</mi><mo lspace="0em" rspace="0em">​</mo><mi class="ltx_font_mathcaligraphic">ℬ</mi><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>N</mi><mo>,</mo><mi>H</mi><mo>,</mo><msub><mi>L</mi><mi>mlp</mi></msub><mo>,</mo><msub><mi>N</mi><mi>mlp</mi></msub><mo>,</mo><mi>B</mi><mo stretchy="false">)</mo></mrow></mrow></mrow><mo rspace="0.337em">,</mo><mi>𝐱</mi><mo>,</mo><mrow><msup><mi>𝐱</mi><mo>′</mo></msup><mo>∈</mo><msup><mrow><mo stretchy="false">[</mo><mrow><mrow><mo>−</mo><mi>A</mi></mrow><mo>,</mo><mi>A</mi></mrow><mo stretchy="false">]</mo></mrow><mrow><mi>N</mi><mo lspace="0.222em" rspace="0.222em">×</mo><mi>T</mi></mrow></msup></mrow><mo rspace="0.337em">,</mo><mrow><mi>𝐱</mi><mo>≠</mo><msup><mi>𝐱</mi><mo>′</mo></msup></mrow></mrow></munder><mstyle displaystyle="true"><mfrac><msub><mrow><mo stretchy="false">‖</mo><mrow><mrow><msub><mi>𝐟</mi><mi>𝜽</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>𝐱</mi><mo stretchy="false">)</mo></mrow></mrow><mo>−</mo><mrow><msub><mi>𝐟</mi><mi>𝜽</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msup><mi>𝐱</mi><mo>′</mo></msup><mo stretchy="false">)</mo></mrow></mrow></mrow><mo stretchy="false">‖</mo></mrow><mi mathvariant="normal">∞</mi></msub><msub><mrow><mo stretchy="false">‖</mo><mrow><mi>𝐱</mi><mo>−</mo><msup><mi>𝐱</mi><mo>′</mo></msup></mrow><mo stretchy="false">‖</mo></mrow><mi mathvariant="normal">∞</mi></msub></mfrac></mstyle></mrow><annotation encoding="application/x-tex">\displaystyle\sup_{\mathbf{f}_{\bm{\theta}}\in\mathcal{TB}(N,H,L_{\mathrm{mlp}},N_{\mathrm{mlp}},B),\,\mathbf{x},\mathbf{x}^{\prime}\in[-A,A]^{N\times T},\,\mathbf{x}\neq\mathbf{x}^{\prime}}\,\frac{\|\mathbf{f}_{\bm{\theta}}(\mathbf{x})-\mathbf{f}_{\bm{\theta}}(\mathbf{x}^{\prime})\|_{\infty}}{\|\mathbf{x}-\mathbf{x}^{\prime}\|_{\infty}}</annotation></semantics></math></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A3.E44.m2" class="ltx_Math" alttext="\displaystyle\leq 6HA^{2}\big(BN_{\mathrm{mlp}}\big)^{L_{\mathrm{mlp}}+3}," display="inline" intent=":literal"><semantics><mrow><mrow><mphantom></mphantom><mo>≤</mo><mrow><mn>6</mn><mo lspace="0em" rspace="0em">​</mo><mi>H</mi><mo lspace="0em" rspace="0em">​</mo><msup><mi>A</mi><mn>2</mn></msup><mo lspace="0em" rspace="0em">​</mo><msup><mrow><mo maxsize="1.200em" minsize="1.200em">(</mo><mrow><mi>B</mi><mo lspace="0em" rspace="0em">​</mo><msub><mi>N</mi><mi>mlp</mi></msub></mrow><mo maxsize="1.200em" minsize="1.200em">)</mo></mrow><mrow><msub><mi>L</mi><mi>mlp</mi></msub><mo>+</mo><mn>3</mn></mrow></msup></mrow></mrow><mo>,</mo></mrow><annotation encoding="application/x-tex">\displaystyle\leq 6HA^{2}\big(BN_{\mathrm{mlp}}\big)^{L_{\mathrm{mlp}}+3},</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td>
<td rowspan="1" class="ltx_eqn_cell ltx_eqn_eqno ltx_align_middle ltx_align_right"><span class="ltx_tag ltx_tag_equation ltx_align_right">(44)</span></td></tr></tbody>
<tbody id="A3.E45"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_align_right ltx_eqn_cell"><math id="A3.E45.m1" class="ltx_Math" alttext="\displaystyle\sup_{\mathbf{f}_{\bm{\theta}},\mathbf{f}_{\bm{\theta}^{\prime}}\in\mathcal{TB}(N,H,L_{\mathrm{mlp}},N_{\mathrm{mlp}},B),\,\bm{\theta}\neq\bm{\theta}^{\prime}}\,\frac{\|\mathbf{f}_{\bm{\theta}}-\mathbf{f}_{\bm{\theta}^{\prime}}\|_{L^{\infty}([-A,A]^{N\times T}])}}{\|\bm{\theta}-\bm{\theta}^{\prime}\|_{\infty}}" display="inline" intent=":literal"><semantics><mrow><munder><mo movablelimits="false">sup</mo><mrow><mrow><mrow><msub><mi>𝐟</mi><mi>𝜽</mi></msub><mo>,</mo><msub><mi>𝐟</mi><msup><mi>𝜽</mi><mo>′</mo></msup></msub></mrow><mo>∈</mo><mrow><mi class="ltx_font_mathcaligraphic">𝒯</mi><mo lspace="0em" rspace="0em">​</mo><mi class="ltx_font_mathcaligraphic">ℬ</mi><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>N</mi><mo>,</mo><mi>H</mi><mo>,</mo><msub><mi>L</mi><mi>mlp</mi></msub><mo>,</mo><msub><mi>N</mi><mi>mlp</mi></msub><mo>,</mo><mi>B</mi><mo stretchy="false">)</mo></mrow></mrow></mrow><mo rspace="0.337em">,</mo><mrow><mi>𝜽</mi><mo>≠</mo><msup><mi>𝜽</mi><mo>′</mo></msup></mrow></mrow></munder><mstyle displaystyle="true"><mfrac><mrow><mo rspace="0.167em">∥</mo><mi>𝐟</mi><msub><mrow></mrow><mi>𝜽</mi></msub><mo>−</mo><mi>𝐟</mi><msub><mrow></mrow><msup><mi>𝜽</mi><mo>′</mo></msup></msub><mo lspace="0em">∥</mo><msub><mrow></mrow><mrow><mi>L</mi><msup><mrow></mrow><mi mathvariant="normal">∞</mi></msup><mo stretchy="false">(</mo><mo stretchy="false">[</mo><mo lspace="0em">−</mo><mi>A</mi><mo>,</mo><mi>A</mi><mo stretchy="false">]</mo><msup><mrow></mrow><mrow><mi>N</mi><mo lspace="0.222em" rspace="0.222em">×</mo><mi>T</mi></mrow></msup><mo stretchy="false">]</mo><mo stretchy="false">)</mo></mrow></msub></mrow><msub><mrow><mo stretchy="false">‖</mo><mrow><mi>𝜽</mi><mo>−</mo><msup><mi>𝜽</mi><mo>′</mo></msup></mrow><mo stretchy="false">‖</mo></mrow><mi mathvariant="normal">∞</mi></msub></mfrac></mstyle></mrow><annotation encoding="application/x-tex">\displaystyle\sup_{\mathbf{f}_{\bm{\theta}},\mathbf{f}_{\bm{\theta}^{\prime}}\in\mathcal{TB}(N,H,L_{\mathrm{mlp}},N_{\mathrm{mlp}},B),\,\bm{\theta}\neq\bm{\theta}^{\prime}}\,\frac{\|\mathbf{f}_{\bm{\theta}}-\mathbf{f}_{\bm{\theta}^{\prime}}\|_{L^{\infty}([-A,A]^{N\times T}])}}{\|\bm{\theta}-\bm{\theta}^{\prime}\|_{\infty}}</annotation></semantics></math></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A3.E45.m2" class="ltx_Math" alttext="\displaystyle\leq 30H^{2}A^{5}\big(B(N_{\mathrm{mlp}}+1)\big)^{2L_{\mathrm{mlp}}+4}." display="inline" intent=":literal"><semantics><mrow><mrow><mphantom></mphantom><mo>≤</mo><mrow><mn>30</mn><mo lspace="0em" rspace="0em">​</mo><msup><mi>H</mi><mn>2</mn></msup><mo lspace="0em" rspace="0em">​</mo><msup><mi>A</mi><mn>5</mn></msup><mo lspace="0em" rspace="0em">​</mo><msup><mrow><mo maxsize="1.200em" minsize="1.200em">(</mo><mrow><mi>B</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mrow><msub><mi>N</mi><mi>mlp</mi></msub><mo>+</mo><mn>1</mn></mrow><mo stretchy="false">)</mo></mrow></mrow><mo maxsize="1.200em" minsize="1.200em">)</mo></mrow><mrow><mrow><mn>2</mn><mo lspace="0em" rspace="0em">​</mo><msub><mi>L</mi><mi>mlp</mi></msub></mrow><mo>+</mo><mn>4</mn></mrow></msup></mrow></mrow><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">\displaystyle\leq 30H^{2}A^{5}\big(B(N_{\mathrm{mlp}}+1)\big)^{2L_{\mathrm{mlp}}+4}.</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td>
<td rowspan="1" class="ltx_eqn_cell ltx_eqn_eqno ltx_align_middle ltx_align_right"><span class="ltx_tag ltx_tag_equation ltx_align_right">(45)</span></td></tr></tbody>
</table>
</div></li>
</ul>
</div>
</div>
<div id="A3.4" class="ltx_proof">
<h6 class="ltx_title ltx_runin ltx_font_italic ltx_title_proof">Proof.</h6>
<div id="A3.p8" class="ltx_para">
<p id="A3.p8.1" class="ltx_p"><span id="A3.p8.1.1" class="ltx_text ltx_font_italic">(i):</span><span id="A3.p8.1.2" class="ltx_text"> We apply Lemma <a href="#Thmconj28" title="Lemma 8. ‣ Appendix C Proofs for the Stochastic Error ‣ Generalization Bounds for Transformer-Based Next-Token Prediction in a Language Model" class="ltx_ref"><span class="ltx_text ltx_ref_tag">8</span></a>. Let <math id="A3.p8.m1" class="ltx_Math" alttext="\bm{\theta}_{1}\coloneq W_{0}\in[-B,B]^{N\times d}," display="inline" intent=":literal"><semantics><mrow><mrow><msub><mi>𝜽</mi><mn>1</mn></msub><mo>≔</mo><msub><mi>W</mi><mn>0</mn></msub><mo>∈</mo><msup><mrow><mo stretchy="false">[</mo><mrow><mrow><mo>−</mo><mi>B</mi></mrow><mo>,</mo><mi>B</mi></mrow><mo stretchy="false">]</mo></mrow><mrow><mi>N</mi><mo lspace="0.222em" rspace="0.222em">×</mo><mi>d</mi></mrow></msup></mrow><mo>,</mo></mrow><annotation encoding="application/x-tex">\bm{\theta}_{1}\coloneq W_{0}\in[-B,B]^{N\times d},</annotation></semantics></math> <math id="A3.p8.m2" class="ltx_Math" alttext="\mathbf{f}_{1,\bm{\theta}_{1}}(\mathbf{x})\coloneq W_{0}\mathbf{x}," display="inline" intent=":literal"><semantics><mrow><mrow><mrow><msub><mi>𝐟</mi><mrow><mn>1</mn><mo>,</mo><msub><mi>𝜽</mi><mn>1</mn></msub></mrow></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>𝐱</mi><mo stretchy="false">)</mo></mrow></mrow><mo>≔</mo><mrow><msub><mi>W</mi><mn>0</mn></msub><mo lspace="0em" rspace="0em">​</mo><mi>𝐱</mi></mrow></mrow><mo>,</mo></mrow><annotation encoding="application/x-tex">\mathbf{f}_{1,\bm{\theta}_{1}}(\mathbf{x})\coloneq W_{0}\mathbf{x},</annotation></semantics></math> for <math id="A3.p8.m3" class="ltx_Math" alttext="j=2,\ldots,L," display="inline" intent=":literal"><semantics><mrow><mrow><mrow><mi>j</mi><mo>=</mo><mn>2</mn></mrow><mo>,</mo><mi mathvariant="normal">…</mi><mo>,</mo><mi>L</mi></mrow><mo>,</mo></mrow><annotation encoding="application/x-tex">j=2,\ldots,L,</annotation></semantics></math> <math id="A3.p8.m4" class="ltx_Math" alttext="\bm{\theta}_{j}\coloneq(W_{j-1},\mathbf{v}_{j-1})\in[-B,B]^{N\times(N+1)}," display="inline" intent=":literal"><semantics><mrow><mrow><msub><mi>𝜽</mi><mi>j</mi></msub><mo>≔</mo><mrow><mo stretchy="false">(</mo><msub><mi>W</mi><mrow><mi>j</mi><mo>−</mo><mn>1</mn></mrow></msub><mo>,</mo><msub><mi>𝐯</mi><mrow><mi>j</mi><mo>−</mo><mn>1</mn></mrow></msub><mo stretchy="false">)</mo></mrow><mo>∈</mo><msup><mrow><mo stretchy="false">[</mo><mrow><mrow><mo>−</mo><mi>B</mi></mrow><mo>,</mo><mi>B</mi></mrow><mo stretchy="false">]</mo></mrow><mrow><mi>N</mi><mo lspace="0.222em" rspace="0.222em">×</mo><mrow><mo stretchy="false">(</mo><mrow><mi>N</mi><mo>+</mo><mn>1</mn></mrow><mo stretchy="false">)</mo></mrow></mrow></msup></mrow><mo>,</mo></mrow><annotation encoding="application/x-tex">\bm{\theta}_{j}\coloneq(W_{j-1},\mathbf{v}_{j-1})\in[-B,B]^{N\times(N+1)},</annotation></semantics></math> <math id="A3.p8.m5" class="ltx_Math" alttext="f_{j,\bm{\theta}_{j}}(\mathbf{x})\coloneq W_{j-1}\sigma(\mathbf{x}-\mathbf{v}_{j-1})," display="inline" intent=":literal"><semantics><mrow><mrow><mrow><msub><mi>f</mi><mrow><mi>j</mi><mo>,</mo><msub><mi>𝜽</mi><mi>j</mi></msub></mrow></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>𝐱</mi><mo stretchy="false">)</mo></mrow></mrow><mo>≔</mo><mrow><msub><mi>W</mi><mrow><mi>j</mi><mo>−</mo><mn>1</mn></mrow></msub><mo lspace="0em" rspace="0em">​</mo><mi>σ</mi><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mrow><mi>𝐱</mi><mo>−</mo><msub><mi>𝐯</mi><mrow><mi>j</mi><mo>−</mo><mn>1</mn></mrow></msub></mrow><mo stretchy="false">)</mo></mrow></mrow></mrow><mo>,</mo></mrow><annotation encoding="application/x-tex">f_{j,\bm{\theta}_{j}}(\mathbf{x})\coloneq W_{j-1}\sigma(\mathbf{x}-\mathbf{v}_{j-1}),</annotation></semantics></math> <math id="A3.p8.m6" class="ltx_Math" alttext="\bm{\theta}_{L+1}=(W_{L},\mathbf{v}_{L})\in[-B,B]^{q\times N+N}," display="inline" intent=":literal"><semantics><mrow><mrow><msub><mi>𝜽</mi><mrow><mi>L</mi><mo>+</mo><mn>1</mn></mrow></msub><mo>=</mo><mrow><mo stretchy="false">(</mo><msub><mi>W</mi><mi>L</mi></msub><mo>,</mo><msub><mi>𝐯</mi><mi>L</mi></msub><mo stretchy="false">)</mo></mrow><mo>∈</mo><msup><mrow><mo stretchy="false">[</mo><mrow><mrow><mo>−</mo><mi>B</mi></mrow><mo>,</mo><mi>B</mi></mrow><mo stretchy="false">]</mo></mrow><mrow><mrow><mi>q</mi><mo lspace="0.222em" rspace="0.222em">×</mo><mi>N</mi></mrow><mo>+</mo><mi>N</mi></mrow></msup></mrow><mo>,</mo></mrow><annotation encoding="application/x-tex">\bm{\theta}_{L+1}=(W_{L},\mathbf{v}_{L})\in[-B,B]^{q\times N+N},</annotation></semantics></math> and <math id="A3.p8.m7" class="ltx_Math" alttext="f_{L+1,\bm{\theta}_{L+1}}(\mathbf{x})\coloneq W_{L}\sigma(\mathbf{x}-\mathbf{v}_{L})." display="inline" intent=":literal"><semantics><mrow><mrow><mrow><msub><mi>f</mi><mrow><mrow><mi>L</mi><mo>+</mo><mn>1</mn></mrow><mo>,</mo><msub><mi>𝜽</mi><mrow><mi>L</mi><mo>+</mo><mn>1</mn></mrow></msub></mrow></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>𝐱</mi><mo stretchy="false">)</mo></mrow></mrow><mo>≔</mo><mrow><msub><mi>W</mi><mi>L</mi></msub><mo lspace="0em" rspace="0em">​</mo><mi>σ</mi><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mrow><mi>𝐱</mi><mo>−</mo><msub><mi>𝐯</mi><mi>L</mi></msub></mrow><mo stretchy="false">)</mo></mrow></mrow></mrow><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">f_{L+1,\bm{\theta}_{L+1}}(\mathbf{x})\coloneq W_{L}\sigma(\mathbf{x}-\mathbf{v}_{L}).</annotation></semantics></math></span></p>
</div>
<div id="A3.p9" class="ltx_para">
<p id="A3.p9.1" class="ltx_p"><span id="A3.p9.1.1" class="ltx_text">If <math id="A3.p9.m1" class="ltx_Math" alttext="D_{0}=[-A,A]," display="inline" intent=":literal"><semantics><mrow><mrow><msub><mi>D</mi><mn>0</mn></msub><mo>=</mo><mrow><mo stretchy="false">[</mo><mrow><mrow><mo>−</mo><mi>A</mi></mrow><mo>,</mo><mi>A</mi></mrow><mo stretchy="false">]</mo></mrow></mrow><mo>,</mo></mrow><annotation encoding="application/x-tex">D_{0}=[-A,A],</annotation></semantics></math> we show that to apply Lemma <a href="#Thmconj28" title="Lemma 8. ‣ Appendix C Proofs for the Stochastic Error ‣ Generalization Bounds for Transformer-Based Next-Token Prediction in a Language Model" class="ltx_ref"><span class="ltx_text ltx_ref_tag">8</span></a>, one can take as domains <math id="A3.p9.m2" class="ltx_Math" alttext="D_{j}=[-AB^{j}(N+1)^{j-1}N,AB^{j}(N+1)^{j-1}N]" display="inline" intent=":literal"><semantics><mrow><msub><mi>D</mi><mi>j</mi></msub><mo>=</mo><mrow><mo stretchy="false">[</mo><mrow><mrow><mo>−</mo><mrow><mi>A</mi><mo lspace="0em" rspace="0em">​</mo><msup><mi>B</mi><mi>j</mi></msup><mo lspace="0em" rspace="0em">​</mo><msup><mrow><mo stretchy="false">(</mo><mrow><mi>N</mi><mo>+</mo><mn>1</mn></mrow><mo stretchy="false">)</mo></mrow><mrow><mi>j</mi><mo>−</mo><mn>1</mn></mrow></msup><mo lspace="0em" rspace="0em">​</mo><mi>N</mi></mrow></mrow><mo>,</mo><mrow><mi>A</mi><mo lspace="0em" rspace="0em">​</mo><msup><mi>B</mi><mi>j</mi></msup><mo lspace="0em" rspace="0em">​</mo><msup><mrow><mo stretchy="false">(</mo><mrow><mi>N</mi><mo>+</mo><mn>1</mn></mrow><mo stretchy="false">)</mo></mrow><mrow><mi>j</mi><mo>−</mo><mn>1</mn></mrow></msup><mo lspace="0em" rspace="0em">​</mo><mi>N</mi></mrow></mrow><mo stretchy="false">]</mo></mrow></mrow><annotation encoding="application/x-tex">D_{j}=[-AB^{j}(N+1)^{j-1}N,AB^{j}(N+1)^{j-1}N]</annotation></semantics></math> for <math id="A3.p9.m3" class="ltx_Math" alttext="j=1,\ldots,L+1." display="inline" intent=":literal"><semantics><mrow><mrow><mrow><mi>j</mi><mo>=</mo><mn>1</mn></mrow><mo>,</mo><mi mathvariant="normal">…</mi><mo>,</mo><mrow><mi>L</mi><mo>+</mo><mn>1</mn></mrow></mrow><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">j=1,\ldots,L+1.</annotation></semantics></math></span></p>
</div>
<div id="A3.p10" class="ltx_para">
<p id="A3.p10.1" class="ltx_p"><span id="A3.p10.1.1" class="ltx_text">Since for any <math id="A3.p10.m1" class="ltx_Math" alttext="\mathbf{x}\in[-A,A]^{d}" display="inline" intent=":literal"><semantics><mrow><mi>𝐱</mi><mo>∈</mo><msup><mrow><mo stretchy="false">[</mo><mrow><mrow><mo>−</mo><mi>A</mi></mrow><mo>,</mo><mi>A</mi></mrow><mo stretchy="false">]</mo></mrow><mi>d</mi></msup></mrow><annotation encoding="application/x-tex">\mathbf{x}\in[-A,A]^{d}</annotation></semantics></math> and <math id="A3.p10.m2" class="ltx_Math" alttext="W_{0}\in[-B,B]^{N\times d}," display="inline" intent=":literal"><semantics><mrow><mrow><msub><mi>W</mi><mn>0</mn></msub><mo>∈</mo><msup><mrow><mo stretchy="false">[</mo><mrow><mrow><mo>−</mo><mi>B</mi></mrow><mo>,</mo><mi>B</mi></mrow><mo stretchy="false">]</mo></mrow><mrow><mi>N</mi><mo lspace="0.222em" rspace="0.222em">×</mo><mi>d</mi></mrow></msup></mrow><mo>,</mo></mrow><annotation encoding="application/x-tex">W_{0}\in[-B,B]^{N\times d},</annotation></semantics></math> one has <math id="A3.p10.m3" class="ltx_Math" alttext="\|\mathbf{f}_{1,\bm{\theta}_{1}}(\mathbf{x})\|_{\infty}=\|W_{0}\mathbf{x}\|_{\infty}\leq ABd," display="inline" intent=":literal"><semantics><mrow><mrow><msub><mrow><mo stretchy="false">‖</mo><mrow><msub><mi>𝐟</mi><mrow><mn>1</mn><mo>,</mo><msub><mi>𝜽</mi><mn>1</mn></msub></mrow></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>𝐱</mi><mo stretchy="false">)</mo></mrow></mrow><mo stretchy="false">‖</mo></mrow><mi mathvariant="normal">∞</mi></msub><mo>=</mo><msub><mrow><mo stretchy="false">‖</mo><mrow><msub><mi>W</mi><mn>0</mn></msub><mo lspace="0em" rspace="0em">​</mo><mi>𝐱</mi></mrow><mo stretchy="false">‖</mo></mrow><mi mathvariant="normal">∞</mi></msub><mo>≤</mo><mrow><mi>A</mi><mo lspace="0em" rspace="0em">​</mo><mi>B</mi><mo lspace="0em" rspace="0em">​</mo><mi>d</mi></mrow></mrow><mo>,</mo></mrow><annotation encoding="application/x-tex">\|\mathbf{f}_{1,\bm{\theta}_{1}}(\mathbf{x})\|_{\infty}=\|W_{0}\mathbf{x}\|_{\infty}\leq ABd,</annotation></semantics></math> the formula holds for <math id="A3.p10.m4" class="ltx_Math" alttext="j=1." display="inline" intent=":literal"><semantics><mrow><mrow><mi>j</mi><mo>=</mo><mn>1</mn></mrow><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">j=1.</annotation></semantics></math> We now show the induction step from <math id="A3.p10.m5" class="ltx_Math" alttext="(j-1)" display="inline" intent=":literal"><semantics><mrow><mo stretchy="false">(</mo><mrow><mi>j</mi><mo>−</mo><mn>1</mn></mrow><mo stretchy="false">)</mo></mrow><annotation encoding="application/x-tex">(j-1)</annotation></semantics></math> to <math id="A3.p10.m6" class="ltx_Math" alttext="j." display="inline" intent=":literal"><semantics><mrow><mi>j</mi><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">j.</annotation></semantics></math> Suppose that <math id="A3.p10.m7" class="ltx_Math" alttext="D_{j-1}=[-AB^{j-1}(N+1)^{j-2}N,AB^{j-1}(N+1)^{j-2}N]." display="inline" intent=":literal"><semantics><mrow><mrow><msub><mi>D</mi><mrow><mi>j</mi><mo>−</mo><mn>1</mn></mrow></msub><mo>=</mo><mrow><mo stretchy="false">[</mo><mrow><mrow><mo>−</mo><mrow><mi>A</mi><mo lspace="0em" rspace="0em">​</mo><msup><mi>B</mi><mrow><mi>j</mi><mo>−</mo><mn>1</mn></mrow></msup><mo lspace="0em" rspace="0em">​</mo><msup><mrow><mo stretchy="false">(</mo><mrow><mi>N</mi><mo>+</mo><mn>1</mn></mrow><mo stretchy="false">)</mo></mrow><mrow><mi>j</mi><mo>−</mo><mn>2</mn></mrow></msup><mo lspace="0em" rspace="0em">​</mo><mi>N</mi></mrow></mrow><mo>,</mo><mrow><mi>A</mi><mo lspace="0em" rspace="0em">​</mo><msup><mi>B</mi><mrow><mi>j</mi><mo>−</mo><mn>1</mn></mrow></msup><mo lspace="0em" rspace="0em">​</mo><msup><mrow><mo stretchy="false">(</mo><mrow><mi>N</mi><mo>+</mo><mn>1</mn></mrow><mo stretchy="false">)</mo></mrow><mrow><mi>j</mi><mo>−</mo><mn>2</mn></mrow></msup><mo lspace="0em" rspace="0em">​</mo><mi>N</mi></mrow></mrow><mo stretchy="false">]</mo></mrow></mrow><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">D_{j-1}=[-AB^{j-1}(N+1)^{j-2}N,AB^{j-1}(N+1)^{j-2}N].</annotation></semantics></math> Using that for <math id="A3.p10.m8" class="ltx_Math" alttext="j\geq 2," display="inline" intent=":literal"><semantics><mrow><mrow><mi>j</mi><mo>≥</mo><mn>2</mn></mrow><mo>,</mo></mrow><annotation encoding="application/x-tex">j\geq 2,</annotation></semantics></math> we find</span></p>
<table id="A3.EGx59" class="ltx_equationgroup ltx_eqn_align ltx_eqn_table">

<tbody id="A3.Ex103"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_align_right ltx_eqn_cell"><math id="A3.Ex103.m1" class="ltx_Math" alttext="\displaystyle\|\mathbf{f}_{j,\bm{\theta}_{j}}(\mathbf{x})\|_{\infty}=\big\|W_{j-1}\sigma(\mathbf{x}-\mathbf{v}_{j-1})\big\|_{\infty}\leq BN\big\|\sigma(\mathbf{x}-\mathbf{v}_{j-1})\big\|_{\infty}\leq BN\big(\|\mathbf{x}\|_{\infty}+B\big)." display="inline" intent=":literal"><semantics><mrow><mrow><msub><mrow><mo stretchy="false">‖</mo><mrow><msub><mi>𝐟</mi><mrow><mi>j</mi><mo>,</mo><msub><mi>𝜽</mi><mi>j</mi></msub></mrow></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>𝐱</mi><mo stretchy="false">)</mo></mrow></mrow><mo stretchy="false">‖</mo></mrow><mi mathvariant="normal">∞</mi></msub><mo>=</mo><msub><mrow><mo maxsize="1.200em" minsize="1.200em" stretchy="true">‖</mo><mrow><msub><mi>W</mi><mrow><mi>j</mi><mo>−</mo><mn>1</mn></mrow></msub><mo lspace="0em" rspace="0em">​</mo><mi>σ</mi><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mrow><mi>𝐱</mi><mo>−</mo><msub><mi>𝐯</mi><mrow><mi>j</mi><mo>−</mo><mn>1</mn></mrow></msub></mrow><mo stretchy="false">)</mo></mrow></mrow><mo maxsize="1.200em" minsize="1.200em" stretchy="true">‖</mo></mrow><mi mathvariant="normal">∞</mi></msub><mo>≤</mo><mrow><mi>B</mi><mo lspace="0em" rspace="0em">​</mo><mi>N</mi><mo lspace="0em" rspace="0em">​</mo><msub><mrow><mo maxsize="1.200em" minsize="1.200em" stretchy="true">‖</mo><mrow><mi>σ</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mrow><mi>𝐱</mi><mo>−</mo><msub><mi>𝐯</mi><mrow><mi>j</mi><mo>−</mo><mn>1</mn></mrow></msub></mrow><mo stretchy="false">)</mo></mrow></mrow><mo maxsize="1.200em" minsize="1.200em" stretchy="true">‖</mo></mrow><mi mathvariant="normal">∞</mi></msub></mrow><mo>≤</mo><mrow><mi>B</mi><mo lspace="0em" rspace="0em">​</mo><mi>N</mi><mo lspace="0em" rspace="0em">​</mo><mrow><mo maxsize="1.200em" minsize="1.200em">(</mo><mrow><msub><mrow><mo stretchy="false">‖</mo><mi>𝐱</mi><mo stretchy="false">‖</mo></mrow><mi mathvariant="normal">∞</mi></msub><mo>+</mo><mi>B</mi></mrow><mo maxsize="1.200em" minsize="1.200em">)</mo></mrow></mrow></mrow><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">\displaystyle\|\mathbf{f}_{j,\bm{\theta}_{j}}(\mathbf{x})\|_{\infty}=\big\|W_{j-1}\sigma(\mathbf{x}-\mathbf{v}_{j-1})\big\|_{\infty}\leq BN\big\|\sigma(\mathbf{x}-\mathbf{v}_{j-1})\big\|_{\infty}\leq BN\big(\|\mathbf{x}\|_{\infty}+B\big).</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="A3.p10.2" class="ltx_p"><span id="A3.p10.2.1" class="ltx_text">Whenever <math id="A3.p10.m9" class="ltx_Math" alttext="\|\mathbf{x}\|_{\infty}\leq AB^{j-1}(N+1)^{j-2}N," display="inline" intent=":literal"><semantics><mrow><mrow><msub><mrow><mo stretchy="false">‖</mo><mi>𝐱</mi><mo stretchy="false">‖</mo></mrow><mi mathvariant="normal">∞</mi></msub><mo>≤</mo><mrow><mi>A</mi><mo lspace="0em" rspace="0em">​</mo><msup><mi>B</mi><mrow><mi>j</mi><mo>−</mo><mn>1</mn></mrow></msup><mo lspace="0em" rspace="0em">​</mo><msup><mrow><mo stretchy="false">(</mo><mrow><mi>N</mi><mo>+</mo><mn>1</mn></mrow><mo stretchy="false">)</mo></mrow><mrow><mi>j</mi><mo>−</mo><mn>2</mn></mrow></msup><mo lspace="0em" rspace="0em">​</mo><mi>N</mi></mrow></mrow><mo>,</mo></mrow><annotation encoding="application/x-tex">\|\mathbf{x}\|_{\infty}\leq AB^{j-1}(N+1)^{j-2}N,</annotation></semantics></math> using <math id="A3.p10.m10" class="ltx_Math" alttext="A,B,N\geq 1," display="inline" intent=":literal"><semantics><mrow><mrow><mi>A</mi><mo>,</mo><mi>B</mi><mo>,</mo><mrow><mi>N</mi><mo>≥</mo><mn>1</mn></mrow></mrow><mo>,</mo></mrow><annotation encoding="application/x-tex">A,B,N\geq 1,</annotation></semantics></math> we therefore have</span></p>
<table id="A3.Ex104" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="A3.Ex104.m1" class="ltx_Math" alttext="\big\|\mathbf{f}_{j,\bm{\theta}_{j}}(\mathbf{x})\big\|_{\infty}\leq BN\big(AB^{j-1}(N+1)^{j-2}N+B\big)\leq AB^{j}N\big((N+1)^{j-2}N+B\big)\leq AB^{j}(N+1)^{j-1}N," display="block" intent=":literal"><semantics><mrow><mrow><msub><mrow><mo maxsize="1.200em" minsize="1.200em" stretchy="true">‖</mo><mrow><msub><mi>𝐟</mi><mrow><mi>j</mi><mo>,</mo><msub><mi>𝜽</mi><mi>j</mi></msub></mrow></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>𝐱</mi><mo stretchy="false">)</mo></mrow></mrow><mo maxsize="1.200em" minsize="1.200em" stretchy="true">‖</mo></mrow><mi mathvariant="normal">∞</mi></msub><mo>≤</mo><mrow><mi>B</mi><mo lspace="0em" rspace="0em">​</mo><mi>N</mi><mo lspace="0em" rspace="0em">​</mo><mrow><mo maxsize="1.200em" minsize="1.200em">(</mo><mrow><mrow><mi>A</mi><mo lspace="0em" rspace="0em">​</mo><msup><mi>B</mi><mrow><mi>j</mi><mo>−</mo><mn>1</mn></mrow></msup><mo lspace="0em" rspace="0em">​</mo><msup><mrow><mo stretchy="false">(</mo><mrow><mi>N</mi><mo>+</mo><mn>1</mn></mrow><mo stretchy="false">)</mo></mrow><mrow><mi>j</mi><mo>−</mo><mn>2</mn></mrow></msup><mo lspace="0em" rspace="0em">​</mo><mi>N</mi></mrow><mo>+</mo><mi>B</mi></mrow><mo maxsize="1.200em" minsize="1.200em">)</mo></mrow></mrow><mo>≤</mo><mrow><mi>A</mi><mo lspace="0em" rspace="0em">​</mo><msup><mi>B</mi><mi>j</mi></msup><mo lspace="0em" rspace="0em">​</mo><mi>N</mi><mo lspace="0em" rspace="0em">​</mo><mrow><mo maxsize="1.200em" minsize="1.200em">(</mo><mrow><mrow><msup><mrow><mo stretchy="false">(</mo><mrow><mi>N</mi><mo>+</mo><mn>1</mn></mrow><mo stretchy="false">)</mo></mrow><mrow><mi>j</mi><mo>−</mo><mn>2</mn></mrow></msup><mo lspace="0em" rspace="0em">​</mo><mi>N</mi></mrow><mo>+</mo><mi>B</mi></mrow><mo maxsize="1.200em" minsize="1.200em">)</mo></mrow></mrow><mo>≤</mo><mrow><mi>A</mi><mo lspace="0em" rspace="0em">​</mo><msup><mi>B</mi><mi>j</mi></msup><mo lspace="0em" rspace="0em">​</mo><msup><mrow><mo stretchy="false">(</mo><mrow><mi>N</mi><mo>+</mo><mn>1</mn></mrow><mo stretchy="false">)</mo></mrow><mrow><mi>j</mi><mo>−</mo><mn>1</mn></mrow></msup><mo lspace="0em" rspace="0em">​</mo><mi>N</mi></mrow></mrow><mo>,</mo></mrow><annotation encoding="application/x-tex">\big\|\mathbf{f}_{j,\bm{\theta}_{j}}(\mathbf{x})\big\|_{\infty}\leq BN\big(AB^{j-1}(N+1)^{j-2}N+B\big)\leq AB^{j}N\big((N+1)^{j-2}N+B\big)\leq AB^{j}(N+1)^{j-1}N,</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="A3.p10.3" class="ltx_p"><span id="A3.p10.3.1" class="ltx_text">that is, <math id="A3.p10.m11" class="ltx_Math" alttext="\mathbf{f}_{j,\bm{\theta}_{j}}(\mathbf{x})\in D_{j}." display="inline" intent=":literal"><semantics><mrow><mrow><mrow><msub><mi>𝐟</mi><mrow><mi>j</mi><mo>,</mo><msub><mi>𝜽</mi><mi>j</mi></msub></mrow></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>𝐱</mi><mo stretchy="false">)</mo></mrow></mrow><mo>∈</mo><msub><mi>D</mi><mi>j</mi></msub></mrow><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">\mathbf{f}_{j,\bm{\theta}_{j}}(\mathbf{x})\in D_{j}.</annotation></semantics></math> This establishes the induction step and proves (<a href="#A3.E37" title="In item (i) ‣ Lemma 9. ‣ Appendix C Proofs for the Stochastic Error ‣ Generalization Bounds for Transformer-Based Next-Token Prediction in a Language Model" class="ltx_ref"><span class="ltx_text ltx_ref_tag">37</span></a>).</span></p>
</div>
<div id="A3.p11" class="ltx_para">
<p id="A3.p11.1" class="ltx_p"><span id="A3.p11.1.1" class="ltx_text">To show that the Lipschitz constants of each layer function with respect to the inputs are bounded by <math id="A3.p11.m1" class="ltx_Math" alttext="BN" display="inline" intent=":literal"><semantics><mrow><mi>B</mi><mo lspace="0em" rspace="0em">​</mo><mi>N</mi></mrow><annotation encoding="application/x-tex">BN</annotation></semantics></math>, observe that whenever <math id="A3.p11.m2" class="ltx_Math" alttext="W_{0}\in[-B,B]^{N\times d}," display="inline" intent=":literal"><semantics><mrow><mrow><msub><mi>W</mi><mn>0</mn></msub><mo>∈</mo><msup><mrow><mo stretchy="false">[</mo><mrow><mrow><mo>−</mo><mi>B</mi></mrow><mo>,</mo><mi>B</mi></mrow><mo stretchy="false">]</mo></mrow><mrow><mi>N</mi><mo lspace="0.222em" rspace="0.222em">×</mo><mi>d</mi></mrow></msup></mrow><mo>,</mo></mrow><annotation encoding="application/x-tex">W_{0}\in[-B,B]^{N\times d},</annotation></semantics></math> <math id="A3.p11.m3" class="ltx_Math" alttext="\|\mathbf{f}_{1,\bm{\theta}_{1}}(\mathbf{x})-\mathbf{f}_{1,\bm{\theta}_{1}}(\mathbf{x}^{\prime})\|_{\infty}\leq\|W_{0}(\mathbf{x}-\mathbf{x}^{\prime})\|_{\infty}\leq Bd\|\mathbf{x}-\mathbf{x}^{\prime}\|_{\infty}." display="inline" intent=":literal"><semantics><mrow><mrow><msub><mrow><mo stretchy="false">‖</mo><mrow><mrow><msub><mi>𝐟</mi><mrow><mn>1</mn><mo>,</mo><msub><mi>𝜽</mi><mn>1</mn></msub></mrow></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>𝐱</mi><mo stretchy="false">)</mo></mrow></mrow><mo>−</mo><mrow><msub><mi>𝐟</mi><mrow><mn>1</mn><mo>,</mo><msub><mi>𝜽</mi><mn>1</mn></msub></mrow></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msup><mi>𝐱</mi><mo>′</mo></msup><mo stretchy="false">)</mo></mrow></mrow></mrow><mo stretchy="false">‖</mo></mrow><mi mathvariant="normal">∞</mi></msub><mo>≤</mo><msub><mrow><mo stretchy="false">‖</mo><mrow><msub><mi>W</mi><mn>0</mn></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mrow><mi>𝐱</mi><mo>−</mo><msup><mi>𝐱</mi><mo>′</mo></msup></mrow><mo stretchy="false">)</mo></mrow></mrow><mo stretchy="false">‖</mo></mrow><mi mathvariant="normal">∞</mi></msub><mo>≤</mo><mrow><mi>B</mi><mo lspace="0em" rspace="0em">​</mo><mi>d</mi><mo lspace="0em" rspace="0em">​</mo><msub><mrow><mo stretchy="false">‖</mo><mrow><mi>𝐱</mi><mo>−</mo><msup><mi>𝐱</mi><mo>′</mo></msup></mrow><mo stretchy="false">‖</mo></mrow><mi mathvariant="normal">∞</mi></msub></mrow></mrow><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">\|\mathbf{f}_{1,\bm{\theta}_{1}}(\mathbf{x})-\mathbf{f}_{1,\bm{\theta}_{1}}(\mathbf{x}^{\prime})\|_{\infty}\leq\|W_{0}(\mathbf{x}-\mathbf{x}^{\prime})\|_{\infty}\leq Bd\|\mathbf{x}-\mathbf{x}^{\prime}\|_{\infty}.</annotation></semantics></math> Similarly, if all parameters are bounded by <math id="A3.p11.m4" class="ltx_Math" alttext="B," display="inline" intent=":literal"><semantics><mrow><mi>B</mi><mo>,</mo></mrow><annotation encoding="application/x-tex">B,</annotation></semantics></math> for any <math id="A3.p11.m5" class="ltx_Math" alttext="j=2,\ldots,L+1," display="inline" intent=":literal"><semantics><mrow><mrow><mrow><mi>j</mi><mo>=</mo><mn>2</mn></mrow><mo>,</mo><mi mathvariant="normal">…</mi><mo>,</mo><mrow><mi>L</mi><mo>+</mo><mn>1</mn></mrow></mrow><mo>,</mo></mrow><annotation encoding="application/x-tex">j=2,\ldots,L+1,</annotation></semantics></math></span></p>
<table id="A3.EGx60" class="ltx_equationgroup ltx_eqn_align ltx_eqn_table">

<tbody id="A3.Ex105"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_align_right ltx_eqn_cell"><math id="A3.Ex105.m1" class="ltx_Math" alttext="\displaystyle\big\|\mathbf{f}_{j,\bm{\theta}_{j}}(\mathbf{x})-\mathbf{f}_{j,\bm{\theta}_{j}}(\mathbf{x}^{\prime})\big\|_{\infty}\leq\big\|W_{j-1}\big(\sigma(\mathbf{x}-\mathbf{v}_{j})-\sigma(\mathbf{x}^{\prime}-\mathbf{v}_{j})\big)\big\|_{\infty}\leq BN\big\|\sigma(\mathbf{x}-\mathbf{v}_{j})-\sigma(\mathbf{x}^{\prime}-\mathbf{v}_{j})\big\|_{\infty}" display="inline" intent=":literal"><semantics><mrow><msub><mrow><mo maxsize="1.200em" minsize="1.200em" stretchy="true">‖</mo><mrow><mrow><msub><mi>𝐟</mi><mrow><mi>j</mi><mo>,</mo><msub><mi>𝜽</mi><mi>j</mi></msub></mrow></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>𝐱</mi><mo stretchy="false">)</mo></mrow></mrow><mo>−</mo><mrow><msub><mi>𝐟</mi><mrow><mi>j</mi><mo>,</mo><msub><mi>𝜽</mi><mi>j</mi></msub></mrow></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msup><mi>𝐱</mi><mo>′</mo></msup><mo stretchy="false">)</mo></mrow></mrow></mrow><mo maxsize="1.200em" minsize="1.200em" stretchy="true">‖</mo></mrow><mi mathvariant="normal">∞</mi></msub><mo>≤</mo><msub><mrow><mo maxsize="1.200em" minsize="1.200em" stretchy="true">‖</mo><mrow><msub><mi>W</mi><mrow><mi>j</mi><mo>−</mo><mn>1</mn></mrow></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo maxsize="1.200em" minsize="1.200em">(</mo><mrow><mrow><mi>σ</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mrow><mi>𝐱</mi><mo>−</mo><msub><mi>𝐯</mi><mi>j</mi></msub></mrow><mo stretchy="false">)</mo></mrow></mrow><mo>−</mo><mrow><mi>σ</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mrow><msup><mi>𝐱</mi><mo>′</mo></msup><mo>−</mo><msub><mi>𝐯</mi><mi>j</mi></msub></mrow><mo stretchy="false">)</mo></mrow></mrow></mrow><mo maxsize="1.200em" minsize="1.200em">)</mo></mrow></mrow><mo maxsize="1.200em" minsize="1.200em" stretchy="true">‖</mo></mrow><mi mathvariant="normal">∞</mi></msub><mo>≤</mo><mrow><mi>B</mi><mo lspace="0em" rspace="0em">​</mo><mi>N</mi><mo lspace="0em" rspace="0em">​</mo><msub><mrow><mo maxsize="1.200em" minsize="1.200em" stretchy="true">‖</mo><mrow><mrow><mi>σ</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mrow><mi>𝐱</mi><mo>−</mo><msub><mi>𝐯</mi><mi>j</mi></msub></mrow><mo stretchy="false">)</mo></mrow></mrow><mo>−</mo><mrow><mi>σ</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mrow><msup><mi>𝐱</mi><mo>′</mo></msup><mo>−</mo><msub><mi>𝐯</mi><mi>j</mi></msub></mrow><mo stretchy="false">)</mo></mrow></mrow></mrow><mo maxsize="1.200em" minsize="1.200em" stretchy="true">‖</mo></mrow><mi mathvariant="normal">∞</mi></msub></mrow></mrow><annotation encoding="application/x-tex">\displaystyle\big\|\mathbf{f}_{j,\bm{\theta}_{j}}(\mathbf{x})-\mathbf{f}_{j,\bm{\theta}_{j}}(\mathbf{x}^{\prime})\big\|_{\infty}\leq\big\|W_{j-1}\big(\sigma(\mathbf{x}-\mathbf{v}_{j})-\sigma(\mathbf{x}^{\prime}-\mathbf{v}_{j})\big)\big\|_{\infty}\leq BN\big\|\sigma(\mathbf{x}-\mathbf{v}_{j})-\sigma(\mathbf{x}^{\prime}-\mathbf{v}_{j})\big\|_{\infty}</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
<tbody id="A3.E46"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_align_right ltx_eqn_cell"><math id="A3.E46.m1" class="ltx_Math" alttext="\displaystyle\leq BN\|\mathbf{x}-\mathbf{x}^{\prime}\|_{\infty}." display="inline" intent=":literal"><semantics><mrow><mrow><mphantom></mphantom><mo>≤</mo><mrow><mi>B</mi><mo lspace="0em" rspace="0em">​</mo><mi>N</mi><mo lspace="0em" rspace="0em">​</mo><msub><mrow><mo stretchy="false">‖</mo><mrow><mi>𝐱</mi><mo>−</mo><msup><mi>𝐱</mi><mo>′</mo></msup></mrow><mo stretchy="false">‖</mo></mrow><mi mathvariant="normal">∞</mi></msub></mrow></mrow><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">\displaystyle\leq BN\|\mathbf{x}-\mathbf{x}^{\prime}\|_{\infty}.</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td>
<td rowspan="1" class="ltx_eqn_cell ltx_eqn_eqno ltx_align_middle ltx_align_right"><span class="ltx_tag ltx_tag_equation ltx_align_right">(46)</span></td></tr></tbody>
</table>
<p id="A3.p11.2" class="ltx_p"><span id="A3.p11.2.1" class="ltx_text">This shows that the Lipschitz constant of the composed function is bounded by the product of the layerwise Lipschitz constants, thus, <math id="A3.p11.m6" class="ltx_Math" alttext="\leq(BN)^{L+1}," display="inline" intent=":literal"><semantics><mrow><mrow><mphantom></mphantom><mo>≤</mo><msup><mrow><mo stretchy="false">(</mo><mrow><mi>B</mi><mo lspace="0em" rspace="0em">​</mo><mi>N</mi></mrow><mo stretchy="false">)</mo></mrow><mrow><mi>L</mi><mo>+</mo><mn>1</mn></mrow></msup></mrow><mo>,</mo></mrow><annotation encoding="application/x-tex">\leq(BN)^{L+1},</annotation></semantics></math> proving (<a href="#A3.E38" title="In item (i) ‣ Lemma 9. ‣ Appendix C Proofs for the Stochastic Error ‣ Generalization Bounds for Transformer-Based Next-Token Prediction in a Language Model" class="ltx_ref"><span class="ltx_text ltx_ref_tag">38</span></a>).</span></p>
</div>
<div id="A3.p12" class="ltx_para">
<p id="A3.p12.1" class="ltx_p"><span id="A3.p12.1.1" class="ltx_text">We finally derive a bound for the Lipschitz constants of the functions <math id="A3.p12.m1" class="ltx_Math" alttext="f_{1,\bm{\theta}_{1}},\ldots,f_{L+1,\bm{\theta}_{L+1}}" display="inline" intent=":literal"><semantics><mrow><msub><mi>f</mi><mrow><mn>1</mn><mo>,</mo><msub><mi>𝜽</mi><mn>1</mn></msub></mrow></msub><mo>,</mo><mi mathvariant="normal">…</mi><mo>,</mo><msub><mi>f</mi><mrow><mrow><mi>L</mi><mo>+</mo><mn>1</mn></mrow><mo>,</mo><msub><mi>𝜽</mi><mrow><mi>L</mi><mo>+</mo><mn>1</mn></mrow></msub></mrow></msub></mrow><annotation encoding="application/x-tex">f_{1,\bm{\theta}_{1}},\ldots,f_{L+1,\bm{\theta}_{L+1}}</annotation></semantics></math> with respect to the parameters. Since for matrices <math id="A3.p12.m2" class="ltx_Math" alttext="W,W^{\prime}\in[-B,B]^{n\times m}" display="inline" intent=":literal"><semantics><mrow><mi>W</mi><mo>,</mo><mrow><msup><mi>W</mi><mo>′</mo></msup><mo>∈</mo><msup><mrow><mo stretchy="false">[</mo><mrow><mrow><mo>−</mo><mi>B</mi></mrow><mo>,</mo><mi>B</mi></mrow><mo stretchy="false">]</mo></mrow><mrow><mi>n</mi><mo lspace="0.222em" rspace="0.222em">×</mo><mi>m</mi></mrow></msup></mrow></mrow><annotation encoding="application/x-tex">W,W^{\prime}\in[-B,B]^{n\times m}</annotation></semantics></math> and <math id="A3.p12.m3" class="ltx_Math" alttext="\mathbf{v},\mathbf{v}^{\prime}\in[-B,B]^{m}," display="inline" intent=":literal"><semantics><mrow><mrow><mi>𝐯</mi><mo>,</mo><mrow><msup><mi>𝐯</mi><mo>′</mo></msup><mo>∈</mo><msup><mrow><mo stretchy="false">[</mo><mrow><mrow><mo>−</mo><mi>B</mi></mrow><mo>,</mo><mi>B</mi></mrow><mo stretchy="false">]</mo></mrow><mi>m</mi></msup></mrow></mrow><mo>,</mo></mrow><annotation encoding="application/x-tex">\mathbf{v},\mathbf{v}^{\prime}\in[-B,B]^{m},</annotation></semantics></math> we have (for matrices <math id="A3.p12.m4" class="ltx_math_unparsed" alttext="\|\cdot\|_{\infty}" display="inline" intent=":literal"><semantics><mrow><mo rspace="0em">∥</mo><mo lspace="0em" rspace="0em">⋅</mo><mo lspace="0em">∥</mo><msub><mrow></mrow><mi mathvariant="normal">∞</mi></msub></mrow><annotation encoding="application/x-tex">\|\cdot\|_{\infty}</annotation></semantics></math> is the entrywise maximum norm)</span></p>
<table id="A3.EGx61" class="ltx_equationgroup ltx_eqn_align ltx_eqn_table">

<tbody id="A3.Ex106"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_align_right ltx_eqn_cell"><math id="A3.Ex106.m1" class="ltx_Math" alttext="\displaystyle\big\|W\sigma(\mathbf{x}-\mathbf{v})-W^{\prime}\sigma(\mathbf{x}-\mathbf{v}^{\prime})\|_{\infty}" display="inline" intent=":literal"><semantics><msub><mrow><mo maxsize="1.200em" minsize="1.200em" stretchy="true">‖</mo><mrow><mrow><mi>W</mi><mo lspace="0em" rspace="0em">​</mo><mi>σ</mi><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mrow><mi>𝐱</mi><mo>−</mo><mi>𝐯</mi></mrow><mo stretchy="false">)</mo></mrow></mrow><mo>−</mo><mrow><msup><mi>W</mi><mo>′</mo></msup><mo lspace="0em" rspace="0em">​</mo><mi>σ</mi><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mrow><mi>𝐱</mi><mo>−</mo><msup><mi>𝐯</mi><mo>′</mo></msup></mrow><mo stretchy="false">)</mo></mrow></mrow></mrow><mo stretchy="false">‖</mo></mrow><mi mathvariant="normal">∞</mi></msub><annotation encoding="application/x-tex">\displaystyle\big\|W\sigma(\mathbf{x}-\mathbf{v})-W^{\prime}\sigma(\mathbf{x}-\mathbf{v}^{\prime})\|_{\infty}</annotation></semantics></math></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A3.Ex106.m2" class="ltx_Math" alttext="\displaystyle\leq\big\|(W-W^{\prime})\sigma(\mathbf{x}-\mathbf{v})\big\|_{\infty}+\big\|W^{\prime}\big(\sigma(\mathbf{x}-\mathbf{v})-\sigma(\mathbf{x}-\mathbf{v}^{\prime})\big)\big\|_{\infty}" display="inline" intent=":literal"><semantics><mrow><mphantom></mphantom><mo>≤</mo><mrow><msub><mrow><mo maxsize="1.200em" minsize="1.200em" stretchy="true">‖</mo><mrow><mrow><mo stretchy="false">(</mo><mrow><mi>W</mi><mo>−</mo><msup><mi>W</mi><mo>′</mo></msup></mrow><mo stretchy="false">)</mo></mrow><mo lspace="0em" rspace="0em">​</mo><mi>σ</mi><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mrow><mi>𝐱</mi><mo>−</mo><mi>𝐯</mi></mrow><mo stretchy="false">)</mo></mrow></mrow><mo maxsize="1.200em" minsize="1.200em" stretchy="true">‖</mo></mrow><mi mathvariant="normal">∞</mi></msub><mo>+</mo><msub><mrow><mo maxsize="1.200em" minsize="1.200em" stretchy="true">‖</mo><mrow><msup><mi>W</mi><mo>′</mo></msup><mo lspace="0em" rspace="0em">​</mo><mrow><mo maxsize="1.200em" minsize="1.200em">(</mo><mrow><mrow><mi>σ</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mrow><mi>𝐱</mi><mo>−</mo><mi>𝐯</mi></mrow><mo stretchy="false">)</mo></mrow></mrow><mo>−</mo><mrow><mi>σ</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mrow><mi>𝐱</mi><mo>−</mo><msup><mi>𝐯</mi><mo>′</mo></msup></mrow><mo stretchy="false">)</mo></mrow></mrow></mrow><mo maxsize="1.200em" minsize="1.200em">)</mo></mrow></mrow><mo maxsize="1.200em" minsize="1.200em" stretchy="true">‖</mo></mrow><mi mathvariant="normal">∞</mi></msub></mrow></mrow><annotation encoding="application/x-tex">\displaystyle\leq\big\|(W-W^{\prime})\sigma(\mathbf{x}-\mathbf{v})\big\|_{\infty}+\big\|W^{\prime}\big(\sigma(\mathbf{x}-\mathbf{v})-\sigma(\mathbf{x}-\mathbf{v}^{\prime})\big)\big\|_{\infty}</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
<tbody id="A3.Ex107"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_eqn_cell"></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A3.Ex107.m1" class="ltx_Math" alttext="\displaystyle\leq m\|W-W^{\prime}\|_{\infty}\big(\|\mathbf{x}\|_{\infty}+B\big)+mB\big\|\sigma(\mathbf{x}-\mathbf{v})-\sigma(\mathbf{x}-\mathbf{v}^{\prime})\big\|_{\infty}" display="inline" intent=":literal"><semantics><mrow><mphantom></mphantom><mo>≤</mo><mrow><mrow><mi>m</mi><mo lspace="0em" rspace="0em">​</mo><msub><mrow><mo stretchy="false">‖</mo><mrow><mi>W</mi><mo>−</mo><msup><mi>W</mi><mo>′</mo></msup></mrow><mo stretchy="false">‖</mo></mrow><mi mathvariant="normal">∞</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo maxsize="1.200em" minsize="1.200em">(</mo><mrow><msub><mrow><mo stretchy="false">‖</mo><mi>𝐱</mi><mo stretchy="false">‖</mo></mrow><mi mathvariant="normal">∞</mi></msub><mo>+</mo><mi>B</mi></mrow><mo maxsize="1.200em" minsize="1.200em">)</mo></mrow></mrow><mo>+</mo><mrow><mi>m</mi><mo lspace="0em" rspace="0em">​</mo><mi>B</mi><mo lspace="0em" rspace="0em">​</mo><msub><mrow><mo maxsize="1.200em" minsize="1.200em" stretchy="true">‖</mo><mrow><mrow><mi>σ</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mrow><mi>𝐱</mi><mo>−</mo><mi>𝐯</mi></mrow><mo stretchy="false">)</mo></mrow></mrow><mo>−</mo><mrow><mi>σ</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mrow><mi>𝐱</mi><mo>−</mo><msup><mi>𝐯</mi><mo>′</mo></msup></mrow><mo stretchy="false">)</mo></mrow></mrow></mrow><mo maxsize="1.200em" minsize="1.200em" stretchy="true">‖</mo></mrow><mi mathvariant="normal">∞</mi></msub></mrow></mrow></mrow><annotation encoding="application/x-tex">\displaystyle\leq m\|W-W^{\prime}\|_{\infty}\big(\|\mathbf{x}\|_{\infty}+B\big)+mB\big\|\sigma(\mathbf{x}-\mathbf{v})-\sigma(\mathbf{x}-\mathbf{v}^{\prime})\big\|_{\infty}</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
<tbody id="A3.Ex108"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_eqn_cell"></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A3.Ex108.m1" class="ltx_Math" alttext="\displaystyle\leq m\|W-W^{\prime}\|_{\infty}\big(\|\mathbf{x}\|_{\infty}+B\big)+mB\big\|\mathbf{v}-\mathbf{v}^{\prime}\big\|_{\infty}." display="inline" intent=":literal"><semantics><mrow><mrow><mphantom></mphantom><mo>≤</mo><mrow><mrow><mi>m</mi><mo lspace="0em" rspace="0em">​</mo><msub><mrow><mo stretchy="false">‖</mo><mrow><mi>W</mi><mo>−</mo><msup><mi>W</mi><mo>′</mo></msup></mrow><mo stretchy="false">‖</mo></mrow><mi mathvariant="normal">∞</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo maxsize="1.200em" minsize="1.200em">(</mo><mrow><msub><mrow><mo stretchy="false">‖</mo><mi>𝐱</mi><mo stretchy="false">‖</mo></mrow><mi mathvariant="normal">∞</mi></msub><mo>+</mo><mi>B</mi></mrow><mo maxsize="1.200em" minsize="1.200em">)</mo></mrow></mrow><mo>+</mo><mrow><mi>m</mi><mo lspace="0em" rspace="0em">​</mo><mi>B</mi><mo lspace="0em" rspace="0em">​</mo><msub><mrow><mo maxsize="1.200em" minsize="1.200em" stretchy="true">‖</mo><mrow><mi>𝐯</mi><mo>−</mo><msup><mi>𝐯</mi><mo>′</mo></msup></mrow><mo maxsize="1.200em" minsize="1.200em" stretchy="true">‖</mo></mrow><mi mathvariant="normal">∞</mi></msub></mrow></mrow></mrow><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">\displaystyle\leq m\|W-W^{\prime}\|_{\infty}\big(\|\mathbf{x}\|_{\infty}+B\big)+mB\big\|\mathbf{v}-\mathbf{v}^{\prime}\big\|_{\infty}.</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="A3.p12.2" class="ltx_p"><span id="A3.p12.2.1" class="ltx_text">Hence, we obtain for any <math id="A3.p12.m5" class="ltx_Math" alttext="j=1,\ldots,L+1" display="inline" intent=":literal"><semantics><mrow><mrow><mi>j</mi><mo>=</mo><mn>1</mn></mrow><mo>,</mo><mi mathvariant="normal">…</mi><mo>,</mo><mrow><mi>L</mi><mo>+</mo><mn>1</mn></mrow></mrow><annotation encoding="application/x-tex">j=1,\ldots,L+1</annotation></semantics></math> and any <math id="A3.p12.m6" class="ltx_Math" alttext="\mathbf{x}\in[-AB^{j-1}(N+1)^{j-1},AB^{j-1}(N+1)^{j-1}]," display="inline" intent=":literal"><semantics><mrow><mrow><mi>𝐱</mi><mo>∈</mo><mrow><mo stretchy="false">[</mo><mrow><mrow><mo>−</mo><mrow><mi>A</mi><mo lspace="0em" rspace="0em">​</mo><msup><mi>B</mi><mrow><mi>j</mi><mo>−</mo><mn>1</mn></mrow></msup><mo lspace="0em" rspace="0em">​</mo><msup><mrow><mo stretchy="false">(</mo><mrow><mi>N</mi><mo>+</mo><mn>1</mn></mrow><mo stretchy="false">)</mo></mrow><mrow><mi>j</mi><mo>−</mo><mn>1</mn></mrow></msup></mrow></mrow><mo>,</mo><mrow><mi>A</mi><mo lspace="0em" rspace="0em">​</mo><msup><mi>B</mi><mrow><mi>j</mi><mo>−</mo><mn>1</mn></mrow></msup><mo lspace="0em" rspace="0em">​</mo><msup><mrow><mo stretchy="false">(</mo><mrow><mi>N</mi><mo>+</mo><mn>1</mn></mrow><mo stretchy="false">)</mo></mrow><mrow><mi>j</mi><mo>−</mo><mn>1</mn></mrow></msup></mrow></mrow><mo stretchy="false">]</mo></mrow></mrow><mo>,</mo></mrow><annotation encoding="application/x-tex">\mathbf{x}\in[-AB^{j-1}(N+1)^{j-1},AB^{j-1}(N+1)^{j-1}],</annotation></semantics></math></span></p>
<table id="A3.EGx62" class="ltx_equationgroup ltx_eqn_align ltx_eqn_table">

<tbody id="A3.Ex109"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_align_right ltx_eqn_cell"><math id="A3.Ex109.m1" class="ltx_Math" alttext="\displaystyle\big\|\mathbf{f}_{j,\bm{\theta}_{j}}(\mathbf{x})-\mathbf{f}_{j,\bm{\theta}_{j}}(\mathbf{x}^{\prime})\big\|_{\infty}" display="inline" intent=":literal"><semantics><msub><mrow><mo maxsize="1.200em" minsize="1.200em" stretchy="true">‖</mo><mrow><mrow><msub><mi>𝐟</mi><mrow><mi>j</mi><mo>,</mo><msub><mi>𝜽</mi><mi>j</mi></msub></mrow></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>𝐱</mi><mo stretchy="false">)</mo></mrow></mrow><mo>−</mo><mrow><msub><mi>𝐟</mi><mrow><mi>j</mi><mo>,</mo><msub><mi>𝜽</mi><mi>j</mi></msub></mrow></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msup><mi>𝐱</mi><mo>′</mo></msup><mo stretchy="false">)</mo></mrow></mrow></mrow><mo maxsize="1.200em" minsize="1.200em" stretchy="true">‖</mo></mrow><mi mathvariant="normal">∞</mi></msub><annotation encoding="application/x-tex">\displaystyle\big\|\mathbf{f}_{j,\bm{\theta}_{j}}(\mathbf{x})-\mathbf{f}_{j,\bm{\theta}_{j}}(\mathbf{x}^{\prime})\big\|_{\infty}</annotation></semantics></math></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A3.Ex109.m2" class="ltx_Math" alttext="\displaystyle\leq\Big(N\big(AB^{j-1}(N+1)^{j-1}+B\big)+NB\Big)\big\|\bm{\theta}_{j}-\bm{\theta}^{\prime}_{j}\big\|_{\infty}" display="inline" intent=":literal"><semantics><mrow><mphantom></mphantom><mo>≤</mo><mrow><mrow><mo maxsize="1.600em" minsize="1.600em">(</mo><mrow><mrow><mi>N</mi><mo>⁡</mo><mrow><mo maxsize="1.200em" minsize="1.200em">(</mo><mrow><mrow><mi>A</mi><mo lspace="0em" rspace="0em">​</mo><msup><mi>B</mi><mrow><mi>j</mi><mo>−</mo><mn>1</mn></mrow></msup><mo lspace="0em" rspace="0em">​</mo><msup><mrow><mo stretchy="false">(</mo><mrow><mi>N</mi><mo>+</mo><mn>1</mn></mrow><mo stretchy="false">)</mo></mrow><mrow><mi>j</mi><mo>−</mo><mn>1</mn></mrow></msup></mrow><mo>+</mo><mi>B</mi></mrow><mo maxsize="1.200em" minsize="1.200em">)</mo></mrow></mrow><mo>+</mo><mrow><mi>N</mi><mo lspace="0em" rspace="0em">​</mo><mi>B</mi></mrow></mrow><mo maxsize="1.600em" minsize="1.600em">)</mo></mrow><mo lspace="0em" rspace="0em">​</mo><msub><mrow><mo maxsize="1.200em" minsize="1.200em" stretchy="true">‖</mo><mrow><msub><mi>𝜽</mi><mi>j</mi></msub><mo>−</mo><msubsup><mi>𝜽</mi><mi>j</mi><mo>′</mo></msubsup></mrow><mo maxsize="1.200em" minsize="1.200em" stretchy="true">‖</mo></mrow><mi mathvariant="normal">∞</mi></msub></mrow></mrow><annotation encoding="application/x-tex">\displaystyle\leq\Big(N\big(AB^{j-1}(N+1)^{j-1}+B\big)+NB\Big)\big\|\bm{\theta}_{j}-\bm{\theta}^{\prime}_{j}\big\|_{\infty}</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
<tbody id="A3.Ex110"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_eqn_cell"></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A3.Ex110.m1" class="ltx_Math" alttext="\displaystyle\leq 3AB^{j}(N+1)^{j}\big\|\bm{\theta}_{j}-\bm{\theta}^{\prime}_{j}\big\|_{\infty}" display="inline" intent=":literal"><semantics><mrow><mphantom></mphantom><mo>≤</mo><mrow><mn>3</mn><mo lspace="0em" rspace="0em">​</mo><mi>A</mi><mo lspace="0em" rspace="0em">​</mo><msup><mi>B</mi><mi>j</mi></msup><mo lspace="0em" rspace="0em">​</mo><msup><mrow><mo stretchy="false">(</mo><mrow><mi>N</mi><mo>+</mo><mn>1</mn></mrow><mo stretchy="false">)</mo></mrow><mi>j</mi></msup><mo lspace="0em" rspace="0em">​</mo><msub><mrow><mo maxsize="1.200em" minsize="1.200em" stretchy="true">‖</mo><mrow><msub><mi>𝜽</mi><mi>j</mi></msub><mo>−</mo><msubsup><mi>𝜽</mi><mi>j</mi><mo>′</mo></msubsup></mrow><mo maxsize="1.200em" minsize="1.200em" stretchy="true">‖</mo></mrow><mi mathvariant="normal">∞</mi></msub></mrow></mrow><annotation encoding="application/x-tex">\displaystyle\leq 3AB^{j}(N+1)^{j}\big\|\bm{\theta}_{j}-\bm{\theta}^{\prime}_{j}\big\|_{\infty}</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
<tbody id="A3.Ex111"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_eqn_cell"></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A3.Ex111.m1" class="ltx_Math" alttext="\displaystyle\leq 3AB^{L+1}(N+1)^{L+1}\big\|\bm{\theta}_{j}-\bm{\theta}^{\prime}_{j}\big\|_{\infty}." display="inline" intent=":literal"><semantics><mrow><mrow><mphantom></mphantom><mo>≤</mo><mrow><mn>3</mn><mo lspace="0em" rspace="0em">​</mo><mi>A</mi><mo lspace="0em" rspace="0em">​</mo><msup><mi>B</mi><mrow><mi>L</mi><mo>+</mo><mn>1</mn></mrow></msup><mo lspace="0em" rspace="0em">​</mo><msup><mrow><mo stretchy="false">(</mo><mrow><mi>N</mi><mo>+</mo><mn>1</mn></mrow><mo stretchy="false">)</mo></mrow><mrow><mi>L</mi><mo>+</mo><mn>1</mn></mrow></msup><mo lspace="0em" rspace="0em">​</mo><msub><mrow><mo maxsize="1.200em" minsize="1.200em" stretchy="true">‖</mo><mrow><msub><mi>𝜽</mi><mi>j</mi></msub><mo>−</mo><msubsup><mi>𝜽</mi><mi>j</mi><mo>′</mo></msubsup></mrow><mo maxsize="1.200em" minsize="1.200em" stretchy="true">‖</mo></mrow><mi mathvariant="normal">∞</mi></msub></mrow></mrow><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">\displaystyle\leq 3AB^{L+1}(N+1)^{L+1}\big\|\bm{\theta}_{j}-\bm{\theta}^{\prime}_{j}\big\|_{\infty}.</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="A3.p12.3" class="ltx_p"><span id="A3.p12.3.1" class="ltx_text">We now apply Lemma <a href="#Thmconj28" title="Lemma 8. ‣ Appendix C Proofs for the Stochastic Error ‣ Generalization Bounds for Transformer-Based Next-Token Prediction in a Language Model" class="ltx_ref"><span class="ltx_text ltx_ref_tag">8</span></a> with <math id="A3.p12.m7" class="ltx_Math" alttext="q=L+1" display="inline" intent=":literal"><semantics><mrow><mi>q</mi><mo>=</mo><mrow><mi>L</mi><mo>+</mo><mn>1</mn></mrow></mrow><annotation encoding="application/x-tex">q=L+1</annotation></semantics></math>. (<a href="#A3.E46" title="In Proof. ‣ Appendix C Proofs for the Stochastic Error ‣ Generalization Bounds for Transformer-Based Next-Token Prediction in a Language Model" class="ltx_ref"><span class="ltx_text ltx_ref_tag">46</span></a>) shows that one can take <math id="A3.p12.m8" class="ltx_Math" alttext="Q_{1},\ldots,Q_{L+1}\leq BN\leq B(N+1)" display="inline" intent=":literal"><semantics><mrow><msub><mi>Q</mi><mn>1</mn></msub><mo>,</mo><mi mathvariant="normal">…</mi><mo>,</mo><mrow><msub><mi>Q</mi><mrow><mi>L</mi><mo>+</mo><mn>1</mn></mrow></msub><mo>≤</mo><mrow><mi>B</mi><mo lspace="0em" rspace="0em">​</mo><mi>N</mi></mrow><mo>≤</mo><mrow><mi>B</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mrow><mi>N</mi><mo>+</mo><mn>1</mn></mrow><mo stretchy="false">)</mo></mrow></mrow></mrow></mrow><annotation encoding="application/x-tex">Q_{1},\ldots,Q_{L+1}\leq BN\leq B(N+1)</annotation></semantics></math> to apply Lemma <a href="#Thmconj28" title="Lemma 8. ‣ Appendix C Proofs for the Stochastic Error ‣ Generalization Bounds for Transformer-Based Next-Token Prediction in a Language Model" class="ltx_ref"><span class="ltx_text ltx_ref_tag">8</span></a>. For any <math id="A3.p12.m9" class="ltx_Math" alttext="y\geq 2," display="inline" intent=":literal"><semantics><mrow><mrow><mi>y</mi><mo>≥</mo><mn>2</mn></mrow><mo>,</mo></mrow><annotation encoding="application/x-tex">y\geq 2,</annotation></semantics></math> <math id="A3.p12.m10" class="ltx_Math" alttext="\sum_{r=0}^{L}y^{r}\leq 2y^{L}." display="inline" intent=":literal"><semantics><mrow><mrow><mrow><msubsup><mo>∑</mo><mrow><mi>r</mi><mo>=</mo><mn>0</mn></mrow><mi>L</mi></msubsup><msup><mi>y</mi><mi>r</mi></msup></mrow><mo>≤</mo><mrow><mn>2</mn><mo lspace="0em" rspace="0em">​</mo><msup><mi>y</mi><mi>L</mi></msup></mrow></mrow><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">\sum_{r=0}^{L}y^{r}\leq 2y^{L}.</annotation></semantics></math> Since <math id="A3.p12.m11" class="ltx_Math" alttext="B(N+1)\geq 2," display="inline" intent=":literal"><semantics><mrow><mrow><mrow><mi>B</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mrow><mi>N</mi><mo>+</mo><mn>1</mn></mrow><mo stretchy="false">)</mo></mrow></mrow><mo>≥</mo><mn>2</mn></mrow><mo>,</mo></mrow><annotation encoding="application/x-tex">B(N+1)\geq 2,</annotation></semantics></math> this proves</span></p>
<table id="A3.EGx63" class="ltx_equationgroup ltx_eqn_align ltx_eqn_table">

<tbody id="A3.Ex112"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_align_right ltx_eqn_cell"><math id="A3.Ex112.m1" class="ltx_Math" alttext="\displaystyle\sup_{\mathbf{f}_{\bm{\theta}},\mathbf{f}_{\bm{\theta}^{\prime}}\in\mathcal{MLP}(d,q,L,N,B),\,\bm{\theta}\neq\bm{\theta}^{\prime}}\,\frac{\|\mathbf{f}_{\bm{\theta}}-\mathbf{f}_{\bm{\theta}^{\prime}}\|_{L^{\infty}([-A,A]^{d})}}{\|\bm{\theta}-\bm{\theta}^{\prime}\|_{\infty}}" display="inline" intent=":literal"><semantics><mrow><munder><mo movablelimits="false">sup</mo><mrow><mrow><mrow><msub><mi>𝐟</mi><mi>𝜽</mi></msub><mo>,</mo><msub><mi>𝐟</mi><msup><mi>𝜽</mi><mo>′</mo></msup></msub></mrow><mo>∈</mo><mrow><mi class="ltx_font_mathcaligraphic">ℳ</mi><mo lspace="0em" rspace="0em">​</mo><mi class="ltx_font_mathcaligraphic">ℒ</mi><mo lspace="0em" rspace="0em">​</mo><mi class="ltx_font_mathcaligraphic">𝒫</mi><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>d</mi><mo>,</mo><mi>q</mi><mo>,</mo><mi>L</mi><mo>,</mo><mi>N</mi><mo>,</mo><mi>B</mi><mo stretchy="false">)</mo></mrow></mrow></mrow><mo rspace="0.337em">,</mo><mrow><mi>𝜽</mi><mo>≠</mo><msup><mi>𝜽</mi><mo>′</mo></msup></mrow></mrow></munder><mstyle displaystyle="true"><mfrac><msub><mrow><mo stretchy="false">‖</mo><mrow><msub><mi>𝐟</mi><mi>𝜽</mi></msub><mo>−</mo><msub><mi>𝐟</mi><msup><mi>𝜽</mi><mo>′</mo></msup></msub></mrow><mo stretchy="false">‖</mo></mrow><mrow><msup><mi>L</mi><mi mathvariant="normal">∞</mi></msup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msup><mrow><mo stretchy="false">[</mo><mrow><mrow><mo>−</mo><mi>A</mi></mrow><mo>,</mo><mi>A</mi></mrow><mo stretchy="false">]</mo></mrow><mi>d</mi></msup><mo stretchy="false">)</mo></mrow></mrow></msub><msub><mrow><mo stretchy="false">‖</mo><mrow><mi>𝜽</mi><mo>−</mo><msup><mi>𝜽</mi><mo>′</mo></msup></mrow><mo stretchy="false">‖</mo></mrow><mi mathvariant="normal">∞</mi></msub></mfrac></mstyle></mrow><annotation encoding="application/x-tex">\displaystyle\sup_{\mathbf{f}_{\bm{\theta}},\mathbf{f}_{\bm{\theta}^{\prime}}\in\mathcal{MLP}(d,q,L,N,B),\,\bm{\theta}\neq\bm{\theta}^{\prime}}\,\frac{\|\mathbf{f}_{\bm{\theta}}-\mathbf{f}_{\bm{\theta}^{\prime}}\|_{L^{\infty}([-A,A]^{d})}}{\|\bm{\theta}-\bm{\theta}^{\prime}\|_{\infty}}</annotation></semantics></math></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A3.Ex112.m2" class="ltx_Math" alttext="\displaystyle\leq 6A\big(B(N+1)\big)^{2L+1}," display="inline" intent=":literal"><semantics><mrow><mrow><mphantom></mphantom><mo>≤</mo><mrow><mn>6</mn><mo lspace="0em" rspace="0em">​</mo><mi>A</mi><mo lspace="0em" rspace="0em">​</mo><msup><mrow><mo maxsize="1.200em" minsize="1.200em">(</mo><mrow><mi>B</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mrow><mi>N</mi><mo>+</mo><mn>1</mn></mrow><mo stretchy="false">)</mo></mrow></mrow><mo maxsize="1.200em" minsize="1.200em">)</mo></mrow><mrow><mrow><mn>2</mn><mo lspace="0em" rspace="0em">​</mo><mi>L</mi></mrow><mo>+</mo><mn>1</mn></mrow></msup></mrow></mrow><mo>,</mo></mrow><annotation encoding="application/x-tex">\displaystyle\leq 6A\big(B(N+1)\big)^{2L+1},</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="A3.p12.4" class="ltx_p"><span id="A3.p12.4.1" class="ltx_text">establishing (<a href="#A3.E39" title="In item (i) ‣ Lemma 9. ‣ Appendix C Proofs for the Stochastic Error ‣ Generalization Bounds for Transformer-Based Next-Token Prediction in a Language Model" class="ltx_ref"><span class="ltx_text ltx_ref_tag">39</span></a>).</span></p>
</div>
<div id="A3.p13" class="ltx_para">
<p id="A3.p13.1" class="ltx_p"><span id="A3.p13.1.1" class="ltx_text ltx_font_italic">(ii):</span><span id="A3.p13.1.2" class="ltx_text">
Consider</span></p>
<table id="A3.EGx64" class="ltx_equationgroup ltx_eqn_align ltx_eqn_table">

<tbody id="A3.Ex113"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_align_right ltx_eqn_cell"><math id="A3.Ex113.m1" class="ltx_math_unparsed" alttext="\displaystyle\operatorname{SA}_{U,V}^{(t)}(X)\coloneqq\operatorname{SA}_{U,V}\big(\mathbf{x}_{1},\ldots,\mathbf{x}_{T}\big)_{:,t}=\sum_{s=1}^{T}\frac{\exp(\mathbf{x}^{\top}_{s}U\mathbf{x}_{t})}{\sum_{r=1}^{T}\exp(\mathbf{x}^{\top}_{r}U\mathbf{x}_{t})}V\mathbf{x}_{s}" display="inline" intent=":literal"><semantics><mrow><msubsup><mi>SA</mi><mrow><mi>U</mi><mo>,</mo><mi>V</mi></mrow><mrow><mo stretchy="false">(</mo><mi>t</mi><mo stretchy="false">)</mo></mrow></msubsup><mrow><mo stretchy="false">(</mo><mi>X</mi><mo stretchy="false">)</mo></mrow><mo>≔</mo><msub><mi>SA</mi><mrow><mi>U</mi><mo>,</mo><mi>V</mi></mrow></msub><msub><mrow><mo maxsize="1.200em" minsize="1.200em">(</mo><msub><mi>𝐱</mi><mn>1</mn></msub><mo>,</mo><mi mathvariant="normal">…</mi><mo>,</mo><msub><mi>𝐱</mi><mi>T</mi></msub><mo maxsize="1.200em" minsize="1.200em">)</mo></mrow><mrow><mo rspace="0em">:</mo><mo>,</mo><mi>t</mi></mrow></msub><mo>=</mo><mstyle displaystyle="true"><munderover><mo movablelimits="false">∑</mo><mrow><mi>s</mi><mo>=</mo><mn>1</mn></mrow><mi>T</mi></munderover></mstyle><mstyle displaystyle="true"><mfrac><mrow><mi>exp</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mrow><msubsup><mi>𝐱</mi><mi>s</mi><mo>⊤</mo></msubsup><mo lspace="0em" rspace="0em">​</mo><mi>U</mi><mo lspace="0em" rspace="0em">​</mo><msub><mi>𝐱</mi><mi>t</mi></msub></mrow><mo stretchy="false">)</mo></mrow></mrow><mrow><msubsup><mo>∑</mo><mrow><mi>r</mi><mo>=</mo><mn>1</mn></mrow><mi>T</mi></msubsup><mrow><mi>exp</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mrow><msubsup><mi>𝐱</mi><mi>r</mi><mo>⊤</mo></msubsup><mo lspace="0em" rspace="0em">​</mo><mi>U</mi><mo lspace="0em" rspace="0em">​</mo><msub><mi>𝐱</mi><mi>t</mi></msub></mrow><mo stretchy="false">)</mo></mrow></mrow></mrow></mfrac></mstyle><mi>V</mi><msub><mi>𝐱</mi><mi>s</mi></msub></mrow><annotation encoding="application/x-tex">\displaystyle\operatorname{SA}_{U,V}^{(t)}(X)\coloneqq\operatorname{SA}_{U,V}\big(\mathbf{x}_{1},\ldots,\mathbf{x}_{T}\big)_{:,t}=\sum_{s=1}^{T}\frac{\exp(\mathbf{x}^{\top}_{s}U\mathbf{x}_{t})}{\sum_{r=1}^{T}\exp(\mathbf{x}^{\top}_{r}U\mathbf{x}_{t})}V\mathbf{x}_{s}</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="A3.p13.2" class="ltx_p"><span id="A3.p13.2.1" class="ltx_text">as a map <math id="A3.p13.m1" class="ltx_Math" alttext="D=[-A,A]^{N\times T}\rightarrow\mathbb{R}^{N}." display="inline" intent=":literal"><semantics><mrow><mrow><mi>D</mi><mo>=</mo><msup><mrow><mo stretchy="false">[</mo><mrow><mrow><mo>−</mo><mi>A</mi></mrow><mo>,</mo><mi>A</mi></mrow><mo stretchy="false">]</mo></mrow><mrow><mi>N</mi><mo lspace="0.222em" rspace="0.222em">×</mo><mi>T</mi></mrow></msup><mo stretchy="false">→</mo><msup><mi>ℝ</mi><mi>N</mi></msup></mrow><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">D=[-A,A]^{N\times T}\rightarrow\mathbb{R}^{N}.</annotation></semantics></math></span></p>
</div>
<div id="A3.p14" class="ltx_para">
<p id="A3.p14.1" class="ltx_p"><span id="A3.p14.1.1" class="ltx_text">Since <math id="A3.p14.m1" class="ltx_Math" alttext="\|V\mathbf{x}_{s}\|_{\infty}\leq NB\|\mathbf{x}_{s}\|_{\infty}\leq ABN," display="inline" intent=":literal"><semantics><mrow><mrow><msub><mrow><mo stretchy="false">‖</mo><mrow><mi>V</mi><mo lspace="0em" rspace="0em">​</mo><msub><mi>𝐱</mi><mi>s</mi></msub></mrow><mo stretchy="false">‖</mo></mrow><mi mathvariant="normal">∞</mi></msub><mo>≤</mo><mrow><mi>N</mi><mo lspace="0em" rspace="0em">​</mo><mi>B</mi><mo lspace="0em" rspace="0em">​</mo><msub><mrow><mo stretchy="false">‖</mo><msub><mi>𝐱</mi><mi>s</mi></msub><mo stretchy="false">‖</mo></mrow><mi mathvariant="normal">∞</mi></msub></mrow><mo>≤</mo><mrow><mi>A</mi><mo lspace="0em" rspace="0em">​</mo><mi>B</mi><mo lspace="0em" rspace="0em">​</mo><mi>N</mi></mrow></mrow><mo>,</mo></mrow><annotation encoding="application/x-tex">\|V\mathbf{x}_{s}\|_{\infty}\leq NB\|\mathbf{x}_{s}\|_{\infty}\leq ABN,</annotation></semantics></math> we obtain <math id="A3.p14.m2" class="ltx_Math" alttext="\|\operatorname{SA}_{U,V}^{(t)}\|_{\infty}\leq ABN." display="inline" intent=":literal"><semantics><mrow><mrow><msub><mrow><mo stretchy="false">‖</mo><msubsup><mi>SA</mi><mrow><mi>U</mi><mo>,</mo><mi>V</mi></mrow><mrow><mo stretchy="false">(</mo><mi>t</mi><mo stretchy="false">)</mo></mrow></msubsup><mo stretchy="false">‖</mo></mrow><mi mathvariant="normal">∞</mi></msub><mo>≤</mo><mrow><mi>A</mi><mo lspace="0em" rspace="0em">​</mo><mi>B</mi><mo lspace="0em" rspace="0em">​</mo><mi>N</mi></mrow></mrow><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">\|\operatorname{SA}_{U,V}^{(t)}\|_{\infty}\leq ABN.</annotation></semantics></math> This shows that any multi-head self-attention function <math id="A3.p14.m3" class="ltx_Math" alttext="\operatorname{MA}_{f_{1},\ldots,f_{H}}(X)=X+\sum_{h=1}^{H}f_{h}(X)" display="inline" intent=":literal"><semantics><mrow><mrow><msub><mi>MA</mi><mrow><msub><mi>f</mi><mn>1</mn></msub><mo>,</mo><mi mathvariant="normal">…</mi><mo>,</mo><msub><mi>f</mi><mi>H</mi></msub></mrow></msub><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>X</mi><mo stretchy="false">)</mo></mrow></mrow><mo>=</mo><mrow><mi>X</mi><mo rspace="0.055em">+</mo><mrow><msubsup><mo>∑</mo><mrow><mi>h</mi><mo>=</mo><mn>1</mn></mrow><mi>H</mi></msubsup><mrow><msub><mi>f</mi><mi>h</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>X</mi><mo stretchy="false">)</mo></mrow></mrow></mrow></mrow></mrow><annotation encoding="application/x-tex">\operatorname{MA}_{f_{1},\ldots,f_{H}}(X)=X+\sum_{h=1}^{H}f_{h}(X)</annotation></semantics></math> in the class is bounded by <math id="A3.p14.m4" class="ltx_Math" alttext="A+HABN," display="inline" intent=":literal"><semantics><mrow><mrow><mi>A</mi><mo>+</mo><mrow><mi>H</mi><mo lspace="0em" rspace="0em">​</mo><mi>A</mi><mo lspace="0em" rspace="0em">​</mo><mi>B</mi><mo lspace="0em" rspace="0em">​</mo><mi>N</mi></mrow></mrow><mo>,</mo></mrow><annotation encoding="application/x-tex">A+HABN,</annotation></semantics></math> establishing
(<a href="#A3.E40" title="In item (ii) ‣ Lemma 9. ‣ Appendix C Proofs for the Stochastic Error ‣ Generalization Bounds for Transformer-Based Next-Token Prediction in a Language Model" class="ltx_ref"><span class="ltx_text ltx_ref_tag">40</span></a>).</span></p>
</div>
<div id="A3.p15" class="ltx_para">
<p id="A3.p15.1" class="ltx_p"><span id="A3.p15.1.1" class="ltx_text">We now derive (<a href="#A3.E41" title="In item (ii) ‣ Lemma 9. ‣ Appendix C Proofs for the Stochastic Error ‣ Generalization Bounds for Transformer-Based Next-Token Prediction in a Language Model" class="ltx_ref"><span class="ltx_text ltx_ref_tag">41</span></a>).
For <math id="A3.p15.m1" class="ltx_Math" alttext="X=(\mathbf{x}_{t})_{t\in[T]}\in[-A,A]^{N\times T}" display="inline" intent=":literal"><semantics><mrow><mi>X</mi><mo>=</mo><msub><mrow><mo stretchy="false">(</mo><msub><mi>𝐱</mi><mi>t</mi></msub><mo stretchy="false">)</mo></mrow><mrow><mi>t</mi><mo>∈</mo><mrow><mo stretchy="false">[</mo><mi>T</mi><mo stretchy="false">]</mo></mrow></mrow></msub><mo>∈</mo><msup><mrow><mo stretchy="false">[</mo><mrow><mrow><mo>−</mo><mi>A</mi></mrow><mo>,</mo><mi>A</mi></mrow><mo stretchy="false">]</mo></mrow><mrow><mi>N</mi><mo lspace="0.222em" rspace="0.222em">×</mo><mi>T</mi></mrow></msup></mrow><annotation encoding="application/x-tex">X=(\mathbf{x}_{t})_{t\in[T]}\in[-A,A]^{N\times T}</annotation></semantics></math> and
<math id="A3.p15.m2" class="ltx_Math" alttext="X^{\prime}=(\mathbf{x}^{\prime}_{t})_{t\in[T]}\in[-A,A]^{N\times T}" display="inline" intent=":literal"><semantics><mrow><msup><mi>X</mi><mo>′</mo></msup><mo>=</mo><msub><mrow><mo stretchy="false">(</mo><msubsup><mi>𝐱</mi><mi>t</mi><mo>′</mo></msubsup><mo stretchy="false">)</mo></mrow><mrow><mi>t</mi><mo>∈</mo><mrow><mo stretchy="false">[</mo><mi>T</mi><mo stretchy="false">]</mo></mrow></mrow></msub><mo>∈</mo><msup><mrow><mo stretchy="false">[</mo><mrow><mrow><mo>−</mo><mi>A</mi></mrow><mo>,</mo><mi>A</mi></mrow><mo stretchy="false">]</mo></mrow><mrow><mi>N</mi><mo lspace="0.222em" rspace="0.222em">×</mo><mi>T</mi></mrow></msup></mrow><annotation encoding="application/x-tex">X^{\prime}=(\mathbf{x}^{\prime}_{t})_{t\in[T]}\in[-A,A]^{N\times T}</annotation></semantics></math>, we have</span></p>
<table id="A3.EGx65" class="ltx_equationgroup ltx_eqn_align ltx_eqn_table">

<tbody id="A3.Ex114"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_align_right ltx_eqn_cell"><math id="A3.Ex114.m1" class="ltx_Math" alttext="\displaystyle\big\|\operatorname{SA}_{U,V}^{(t)}(X)-\operatorname{SA}_{U,V}^{(t)}(X^{\prime})\big\|_{\infty}" display="inline" intent=":literal"><semantics><msub><mrow><mo maxsize="1.200em" minsize="1.200em" stretchy="true">‖</mo><mrow><mrow><msubsup><mi>SA</mi><mrow><mi>U</mi><mo>,</mo><mi>V</mi></mrow><mrow><mo stretchy="false">(</mo><mi>t</mi><mo stretchy="false">)</mo></mrow></msubsup><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>X</mi><mo stretchy="false">)</mo></mrow></mrow><mo>−</mo><mrow><msubsup><mi>SA</mi><mrow><mi>U</mi><mo>,</mo><mi>V</mi></mrow><mrow><mo stretchy="false">(</mo><mi>t</mi><mo stretchy="false">)</mo></mrow></msubsup><mo>⁡</mo><mrow><mo stretchy="false">(</mo><msup><mi>X</mi><mo>′</mo></msup><mo stretchy="false">)</mo></mrow></mrow></mrow><mo maxsize="1.200em" minsize="1.200em" stretchy="true">‖</mo></mrow><mi mathvariant="normal">∞</mi></msub><annotation encoding="application/x-tex">\displaystyle\big\|\operatorname{SA}_{U,V}^{(t)}(X)-\operatorname{SA}_{U,V}^{(t)}(X^{\prime})\big\|_{\infty}</annotation></semantics></math></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A3.Ex114.m2" class="ltx_Math" alttext="\displaystyle\leq\Big\|\sum_{s=1}^{T}\frac{\exp(\mathbf{x}^{\top}_{s}U\mathbf{x}_{t})}{\sum_{r=1}^{T}\exp(\mathbf{x}^{\top}_{r}U\mathbf{x}_{t})}V\mathbf{x}_{s}-\sum_{s=1}^{T}\frac{\exp(\mathbf{x}^{\top}_{s}U\mathbf{x}_{t})}{\sum_{r=1}^{T}\exp(\mathbf{x}^{\top}_{r}U\mathbf{x}_{t})}V\mathbf{x}^{\prime}_{s}\Big\|_{\infty}" display="inline" intent=":literal"><semantics><mrow><mphantom></mphantom><mo>≤</mo><msub><mrow><mo maxsize="1.600em" minsize="1.600em" stretchy="true">‖</mo><mrow><mrow><mstyle displaystyle="true"><munderover><mo movablelimits="false">∑</mo><mrow><mi>s</mi><mo>=</mo><mn>1</mn></mrow><mi>T</mi></munderover></mstyle><mrow><mstyle displaystyle="true"><mfrac><mrow><mi>exp</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mrow><msubsup><mi>𝐱</mi><mi>s</mi><mo>⊤</mo></msubsup><mo lspace="0em" rspace="0em">​</mo><mi>U</mi><mo lspace="0em" rspace="0em">​</mo><msub><mi>𝐱</mi><mi>t</mi></msub></mrow><mo stretchy="false">)</mo></mrow></mrow><mrow><msubsup><mo>∑</mo><mrow><mi>r</mi><mo>=</mo><mn>1</mn></mrow><mi>T</mi></msubsup><mrow><mi>exp</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mrow><msubsup><mi>𝐱</mi><mi>r</mi><mo>⊤</mo></msubsup><mo lspace="0em" rspace="0em">​</mo><mi>U</mi><mo lspace="0em" rspace="0em">​</mo><msub><mi>𝐱</mi><mi>t</mi></msub></mrow><mo stretchy="false">)</mo></mrow></mrow></mrow></mfrac></mstyle><mo lspace="0em" rspace="0em">​</mo><mi>V</mi><mo lspace="0em" rspace="0em">​</mo><msub><mi>𝐱</mi><mi>s</mi></msub></mrow></mrow><mo>−</mo><mrow><mstyle displaystyle="true"><munderover><mo movablelimits="false">∑</mo><mrow><mi>s</mi><mo>=</mo><mn>1</mn></mrow><mi>T</mi></munderover></mstyle><mrow><mstyle displaystyle="true"><mfrac><mrow><mi>exp</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mrow><msubsup><mi>𝐱</mi><mi>s</mi><mo>⊤</mo></msubsup><mo lspace="0em" rspace="0em">​</mo><mi>U</mi><mo lspace="0em" rspace="0em">​</mo><msub><mi>𝐱</mi><mi>t</mi></msub></mrow><mo stretchy="false">)</mo></mrow></mrow><mrow><msubsup><mo>∑</mo><mrow><mi>r</mi><mo>=</mo><mn>1</mn></mrow><mi>T</mi></msubsup><mrow><mi>exp</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mrow><msubsup><mi>𝐱</mi><mi>r</mi><mo>⊤</mo></msubsup><mo lspace="0em" rspace="0em">​</mo><mi>U</mi><mo lspace="0em" rspace="0em">​</mo><msub><mi>𝐱</mi><mi>t</mi></msub></mrow><mo stretchy="false">)</mo></mrow></mrow></mrow></mfrac></mstyle><mo lspace="0em" rspace="0em">​</mo><mi>V</mi><mo lspace="0em" rspace="0em">​</mo><msubsup><mi>𝐱</mi><mi>s</mi><mo>′</mo></msubsup></mrow></mrow></mrow><mo maxsize="1.600em" minsize="1.600em" stretchy="true">‖</mo></mrow><mi mathvariant="normal">∞</mi></msub></mrow><annotation encoding="application/x-tex">\displaystyle\leq\Big\|\sum_{s=1}^{T}\frac{\exp(\mathbf{x}^{\top}_{s}U\mathbf{x}_{t})}{\sum_{r=1}^{T}\exp(\mathbf{x}^{\top}_{r}U\mathbf{x}_{t})}V\mathbf{x}_{s}-\sum_{s=1}^{T}\frac{\exp(\mathbf{x}^{\top}_{s}U\mathbf{x}_{t})}{\sum_{r=1}^{T}\exp(\mathbf{x}^{\top}_{r}U\mathbf{x}_{t})}V\mathbf{x}^{\prime}_{s}\Big\|_{\infty}</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
<tbody id="A3.Ex115"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_eqn_cell"></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A3.Ex115.m1" class="ltx_Math" alttext="\displaystyle\quad+\Big\|\sum_{s=1}^{T}\frac{\exp(\mathbf{x}^{\top}_{s}U\mathbf{x}_{t})}{\sum_{r=1}^{T}\exp(\mathbf{x}^{\top}_{r}U\mathbf{x}_{t})}V\mathbf{x}^{\prime}_{s}-\sum_{s=1}^{T}\frac{\exp(\mathbf{x}^{\prime\top}_{s}U\mathbf{x}^{\prime}_{t})}{\sum_{r=1}^{T}\exp(\mathbf{x}^{\prime\top}_{r}U\mathbf{x}^{\prime}_{t})}V\mathbf{x}^{\prime}_{s}\Big\|_{\infty}" display="inline" intent=":literal"><semantics><mrow><mo>+</mo><msub><mrow><mo maxsize="1.600em" minsize="1.600em" stretchy="true">‖</mo><mrow><mrow><mstyle displaystyle="true"><munderover><mo movablelimits="false">∑</mo><mrow><mi>s</mi><mo>=</mo><mn>1</mn></mrow><mi>T</mi></munderover></mstyle><mrow><mstyle displaystyle="true"><mfrac><mrow><mi>exp</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mrow><msubsup><mi>𝐱</mi><mi>s</mi><mo>⊤</mo></msubsup><mo lspace="0em" rspace="0em">​</mo><mi>U</mi><mo lspace="0em" rspace="0em">​</mo><msub><mi>𝐱</mi><mi>t</mi></msub></mrow><mo stretchy="false">)</mo></mrow></mrow><mrow><msubsup><mo>∑</mo><mrow><mi>r</mi><mo>=</mo><mn>1</mn></mrow><mi>T</mi></msubsup><mrow><mi>exp</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mrow><msubsup><mi>𝐱</mi><mi>r</mi><mo>⊤</mo></msubsup><mo lspace="0em" rspace="0em">​</mo><mi>U</mi><mo lspace="0em" rspace="0em">​</mo><msub><mi>𝐱</mi><mi>t</mi></msub></mrow><mo stretchy="false">)</mo></mrow></mrow></mrow></mfrac></mstyle><mo lspace="0em" rspace="0em">​</mo><mi>V</mi><mo lspace="0em" rspace="0em">​</mo><msubsup><mi>𝐱</mi><mi>s</mi><mo>′</mo></msubsup></mrow></mrow><mo>−</mo><mrow><mstyle displaystyle="true"><munderover><mo movablelimits="false">∑</mo><mrow><mi>s</mi><mo>=</mo><mn>1</mn></mrow><mi>T</mi></munderover></mstyle><mrow><mstyle displaystyle="true"><mfrac><mrow><mi>exp</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mrow><msubsup><mi>𝐱</mi><mi>s</mi><mrow><mo>′</mo><mo lspace="0.222em">⁣</mo><mo>⊤</mo></mrow></msubsup><mo lspace="0em" rspace="0em">​</mo><mi>U</mi><mo lspace="0em" rspace="0em">​</mo><msubsup><mi>𝐱</mi><mi>t</mi><mo>′</mo></msubsup></mrow><mo stretchy="false">)</mo></mrow></mrow><mrow><msubsup><mo>∑</mo><mrow><mi>r</mi><mo>=</mo><mn>1</mn></mrow><mi>T</mi></msubsup><mrow><mi>exp</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mrow><msubsup><mi>𝐱</mi><mi>r</mi><mrow><mo>′</mo><mo lspace="0.222em">⁣</mo><mo>⊤</mo></mrow></msubsup><mo lspace="0em" rspace="0em">​</mo><mi>U</mi><mo lspace="0em" rspace="0em">​</mo><msubsup><mi>𝐱</mi><mi>t</mi><mo>′</mo></msubsup></mrow><mo stretchy="false">)</mo></mrow></mrow></mrow></mfrac></mstyle><mo lspace="0em" rspace="0em">​</mo><mi>V</mi><mo lspace="0em" rspace="0em">​</mo><msubsup><mi>𝐱</mi><mi>s</mi><mo>′</mo></msubsup></mrow></mrow></mrow><mo maxsize="1.600em" minsize="1.600em" stretchy="true">‖</mo></mrow><mi mathvariant="normal">∞</mi></msub></mrow><annotation encoding="application/x-tex">\displaystyle\quad+\Big\|\sum_{s=1}^{T}\frac{\exp(\mathbf{x}^{\top}_{s}U\mathbf{x}_{t})}{\sum_{r=1}^{T}\exp(\mathbf{x}^{\top}_{r}U\mathbf{x}_{t})}V\mathbf{x}^{\prime}_{s}-\sum_{s=1}^{T}\frac{\exp(\mathbf{x}^{\prime\top}_{s}U\mathbf{x}^{\prime}_{t})}{\sum_{r=1}^{T}\exp(\mathbf{x}^{\prime\top}_{r}U\mathbf{x}^{\prime}_{t})}V\mathbf{x}^{\prime}_{s}\Big\|_{\infty}</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
<tbody id="A3.Ex116"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_eqn_cell"></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A3.Ex116.m1" class="ltx_Math" alttext="\displaystyle\leq\max_{s\in[T]}\big\|V\mathbf{x}_{s}-V\mathbf{x}^{\prime}_{s}\big\|_{\infty}" display="inline" intent=":literal"><semantics><mrow><mphantom></mphantom><mo>≤</mo><mrow><munder><mi>max</mi><mrow><mi>s</mi><mo>∈</mo><mrow><mo stretchy="false">[</mo><mi>T</mi><mo stretchy="false">]</mo></mrow></mrow></munder><mo>⁡</mo><msub><mrow><mo maxsize="1.200em" minsize="1.200em" stretchy="true">‖</mo><mrow><mrow><mi>V</mi><mo lspace="0em" rspace="0em">​</mo><msub><mi>𝐱</mi><mi>s</mi></msub></mrow><mo>−</mo><mrow><mi>V</mi><mo lspace="0em" rspace="0em">​</mo><msubsup><mi>𝐱</mi><mi>s</mi><mo>′</mo></msubsup></mrow></mrow><mo maxsize="1.200em" minsize="1.200em" stretchy="true">‖</mo></mrow><mi mathvariant="normal">∞</mi></msub></mrow></mrow><annotation encoding="application/x-tex">\displaystyle\leq\max_{s\in[T]}\big\|V\mathbf{x}_{s}-V\mathbf{x}^{\prime}_{s}\big\|_{\infty}</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
<tbody id="A3.Ex117"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_eqn_cell"></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A3.Ex117.m1" class="ltx_math_unparsed" alttext="\displaystyle\quad+\sum_{s=1}^{T}\bigg|\frac{\exp(\mathbf{x}^{\top}_{s}U\mathbf{x}_{t})}{\sum_{r=1}^{T}\exp(\mathbf{x}^{\top}_{r}U\mathbf{x}_{t})}-\frac{\exp(\mathbf{x}^{\prime\top}_{s}U\mathbf{x}^{\prime}_{t})}{\sum_{r=1}^{T}\exp(\mathbf{x}^{\prime\top}_{r}U\mathbf{x}^{\prime}_{t})}\bigg|\,\max_{s\in[T]}\big\|V\mathbf{x}^{\prime}_{s}\big\|_{\infty}." display="inline" intent=":literal"><semantics><mrow><mo>+</mo><mstyle displaystyle="true"><mo movablelimits="false">∑</mo></mstyle><msub><mrow></mrow><mrow><mi>s</mi><mo>=</mo><mn>1</mn></mrow></msub><msup><mrow></mrow><mi>T</mi></msup><mo fence="false" maxsize="2.100em" minsize="2.100em" rspace="0.167em" stretchy="true">|</mo><mstyle displaystyle="true"><mfrac><mrow><mi>exp</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mrow><msubsup><mi>𝐱</mi><mi>s</mi><mo>⊤</mo></msubsup><mo lspace="0em" rspace="0em">​</mo><mi>U</mi><mo lspace="0em" rspace="0em">​</mo><msub><mi>𝐱</mi><mi>t</mi></msub></mrow><mo stretchy="false">)</mo></mrow></mrow><mrow><msubsup><mo>∑</mo><mrow><mi>r</mi><mo>=</mo><mn>1</mn></mrow><mi>T</mi></msubsup><mrow><mi>exp</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mrow><msubsup><mi>𝐱</mi><mi>r</mi><mo>⊤</mo></msubsup><mo lspace="0em" rspace="0em">​</mo><mi>U</mi><mo lspace="0em" rspace="0em">​</mo><msub><mi>𝐱</mi><mi>t</mi></msub></mrow><mo stretchy="false">)</mo></mrow></mrow></mrow></mfrac></mstyle><mo>−</mo><mstyle displaystyle="true"><mfrac><mrow><mi>exp</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mrow><msubsup><mi>𝐱</mi><mi>s</mi><mrow><mo>′</mo><mo lspace="0.222em">⁣</mo><mo>⊤</mo></mrow></msubsup><mo lspace="0em" rspace="0em">​</mo><mi>U</mi><mo lspace="0em" rspace="0em">​</mo><msubsup><mi>𝐱</mi><mi>t</mi><mo>′</mo></msubsup></mrow><mo stretchy="false">)</mo></mrow></mrow><mrow><msubsup><mo>∑</mo><mrow><mi>r</mi><mo>=</mo><mn>1</mn></mrow><mi>T</mi></msubsup><mrow><mi>exp</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mrow><msubsup><mi>𝐱</mi><mi>r</mi><mrow><mo>′</mo><mo lspace="0.222em">⁣</mo><mo>⊤</mo></mrow></msubsup><mo lspace="0em" rspace="0em">​</mo><mi>U</mi><mo lspace="0em" rspace="0em">​</mo><msubsup><mi>𝐱</mi><mi>t</mi><mo>′</mo></msubsup></mrow><mo stretchy="false">)</mo></mrow></mrow></mrow></mfrac></mstyle><mo fence="false" maxsize="2.100em" minsize="2.100em" rspace="0.337em" stretchy="true">|</mo><mi>max</mi><msub><mrow></mrow><mrow><mi>s</mi><mo>∈</mo><mrow><mo stretchy="false">[</mo><mi>T</mi><mo stretchy="false">]</mo></mrow></mrow></msub><mo lspace="0em" mathsize="1.200em" rspace="0.167em">∥</mo><mi>V</mi><mi>𝐱</mi><msup><mrow></mrow><mo>′</mo></msup><msub><mrow></mrow><mi>s</mi></msub><mo lspace="0em" mathsize="1.200em" rspace="0.0835em">∥</mo><msub><mrow></mrow><mi mathvariant="normal">∞</mi></msub><mo lspace="0.0835em">.</mo></mrow><annotation encoding="application/x-tex">\displaystyle\quad+\sum_{s=1}^{T}\bigg|\frac{\exp(\mathbf{x}^{\top}_{s}U\mathbf{x}_{t})}{\sum_{r=1}^{T}\exp(\mathbf{x}^{\top}_{r}U\mathbf{x}_{t})}-\frac{\exp(\mathbf{x}^{\prime\top}_{s}U\mathbf{x}^{\prime}_{t})}{\sum_{r=1}^{T}\exp(\mathbf{x}^{\prime\top}_{r}U\mathbf{x}^{\prime}_{t})}\bigg|\,\max_{s\in[T]}\big\|V\mathbf{x}^{\prime}_{s}\big\|_{\infty}.</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="A3.p15.2" class="ltx_p"><span id="A3.p15.2.1" class="ltx_text">Assume that <math id="A3.p15.m3" class="ltx_Math" alttext="U,V\in[-B,B]^{N\times N}" display="inline" intent=":literal"><semantics><mrow><mi>U</mi><mo>,</mo><mrow><mi>V</mi><mo>∈</mo><msup><mrow><mo stretchy="false">[</mo><mrow><mrow><mo>−</mo><mi>B</mi></mrow><mo>,</mo><mi>B</mi></mrow><mo stretchy="false">]</mo></mrow><mrow><mi>N</mi><mo lspace="0.222em" rspace="0.222em">×</mo><mi>N</mi></mrow></msup></mrow></mrow><annotation encoding="application/x-tex">U,V\in[-B,B]^{N\times N}</annotation></semantics></math> and <math id="A3.p15.m4" class="ltx_Math" alttext="A,B\geq 1" display="inline" intent=":literal"><semantics><mrow><mrow><mi>A</mi><mo>,</mo><mi>B</mi></mrow><mo>≥</mo><mn>1</mn></mrow><annotation encoding="application/x-tex">A,B\geq 1</annotation></semantics></math>. Using
the Lipschitz property
<math id="A3.p15.m5" class="ltx_Math" alttext="\|\operatorname{softmax}(\mathbf{z})-\operatorname{softmax}(\mathbf{z}^{\prime})\|_{1}\leq 2\|\mathbf{z}-\mathbf{z}^{\prime}\|_{\infty}" display="inline" intent=":literal"><semantics><mrow><msub><mrow><mo stretchy="false">‖</mo><mrow><mrow><mi>softmax</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>𝐳</mi><mo stretchy="false">)</mo></mrow></mrow><mo>−</mo><mrow><mi>softmax</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><msup><mi>𝐳</mi><mo>′</mo></msup><mo stretchy="false">)</mo></mrow></mrow></mrow><mo stretchy="false">‖</mo></mrow><mn>1</mn></msub><mo>≤</mo><mrow><mn>2</mn><mo lspace="0em" rspace="0em">​</mo><msub><mrow><mo stretchy="false">‖</mo><mrow><mi>𝐳</mi><mo>−</mo><msup><mi>𝐳</mi><mo>′</mo></msup></mrow><mo stretchy="false">‖</mo></mrow><mi mathvariant="normal">∞</mi></msub></mrow></mrow><annotation encoding="application/x-tex">\|\operatorname{softmax}(\mathbf{z})-\operatorname{softmax}(\mathbf{z}^{\prime})\|_{1}\leq 2\|\mathbf{z}-\mathbf{z}^{\prime}\|_{\infty}</annotation></semantics></math> that holds for any real-valued vectors <math id="A3.p15.m6" class="ltx_Math" alttext="\mathbf{z}" display="inline" intent=":literal"><semantics><mi>𝐳</mi><annotation encoding="application/x-tex">\mathbf{z}</annotation></semantics></math> and <math id="A3.p15.m7" class="ltx_Math" alttext="\mathbf{z}^{\prime}" display="inline" intent=":literal"><semantics><msup><mi>𝐳</mi><mo>′</mo></msup><annotation encoding="application/x-tex">\mathbf{z}^{\prime}</annotation></semantics></math> of the same dimension (see Lemma <a href="#Thmconj231" title="Lemma 31 (Corollary A.7 of []). ‣ Appendix G Technical Lemmas ‣ Generalization Bounds for Transformer-Based Next-Token Prediction in a Language Model" class="ltx_ref"><span class="ltx_text ltx_ref_tag">31</span></a>), we obtain</span></p>
<table id="A3.EGx66" class="ltx_equationgroup ltx_eqn_align ltx_eqn_table">

<tbody id="A3.Ex118"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_align_right ltx_eqn_cell"><math id="A3.Ex118.m1" class="ltx_Math" alttext="\displaystyle\big\|\operatorname{SA}_{U,V}^{(t)}(X)-\operatorname{SA}_{U,V}^{(t)}(X^{\prime})\big\|_{\infty}" display="inline" intent=":literal"><semantics><msub><mrow><mo maxsize="1.200em" minsize="1.200em" stretchy="true">‖</mo><mrow><mrow><msubsup><mi>SA</mi><mrow><mi>U</mi><mo>,</mo><mi>V</mi></mrow><mrow><mo stretchy="false">(</mo><mi>t</mi><mo stretchy="false">)</mo></mrow></msubsup><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>X</mi><mo stretchy="false">)</mo></mrow></mrow><mo>−</mo><mrow><msubsup><mi>SA</mi><mrow><mi>U</mi><mo>,</mo><mi>V</mi></mrow><mrow><mo stretchy="false">(</mo><mi>t</mi><mo stretchy="false">)</mo></mrow></msubsup><mo>⁡</mo><mrow><mo stretchy="false">(</mo><msup><mi>X</mi><mo>′</mo></msup><mo stretchy="false">)</mo></mrow></mrow></mrow><mo maxsize="1.200em" minsize="1.200em" stretchy="true">‖</mo></mrow><mi mathvariant="normal">∞</mi></msub><annotation encoding="application/x-tex">\displaystyle\big\|\operatorname{SA}_{U,V}^{(t)}(X)-\operatorname{SA}_{U,V}^{(t)}(X^{\prime})\big\|_{\infty}</annotation></semantics></math></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A3.Ex118.m2" class="ltx_Math" alttext="\displaystyle\leq BN\big\|X-X^{\prime}\big\|_{\infty}+2ABN\max_{s\in[T]}\big|\mathbf{x}^{\top}_{s}U\mathbf{x}_{t}-\mathbf{x}^{\prime\top}_{s}U\mathbf{x}^{\prime}_{t}\big|" display="inline" intent=":literal"><semantics><mrow><mphantom></mphantom><mo>≤</mo><mrow><mrow><mi>B</mi><mo lspace="0em" rspace="0em">​</mo><mi>N</mi><mo lspace="0em" rspace="0em">​</mo><msub><mrow><mo maxsize="1.200em" minsize="1.200em" stretchy="true">‖</mo><mrow><mi>X</mi><mo>−</mo><msup><mi>X</mi><mo>′</mo></msup></mrow><mo maxsize="1.200em" minsize="1.200em" stretchy="true">‖</mo></mrow><mi mathvariant="normal">∞</mi></msub></mrow><mo>+</mo><mrow><mn>2</mn><mo lspace="0em" rspace="0em">​</mo><mi>A</mi><mo lspace="0em" rspace="0em">​</mo><mi>B</mi><mo lspace="0em" rspace="0em">​</mo><mi>N</mi><mo lspace="0.167em" rspace="0em">​</mo><munder><mi>max</mi><mrow><mi>s</mi><mo>∈</mo><mrow><mo stretchy="false">[</mo><mi>T</mi><mo stretchy="false">]</mo></mrow></mrow></munder><mo lspace="0em" rspace="0em">​</mo><mrow><mo maxsize="1.200em" minsize="1.200em" stretchy="true">|</mo><mrow><mrow><msubsup><mi>𝐱</mi><mi>s</mi><mo>⊤</mo></msubsup><mo lspace="0em" rspace="0em">​</mo><mi>U</mi><mo lspace="0em" rspace="0em">​</mo><msub><mi>𝐱</mi><mi>t</mi></msub></mrow><mo>−</mo><mrow><msubsup><mi>𝐱</mi><mi>s</mi><mrow><mo>′</mo><mo lspace="0.222em">⁣</mo><mo>⊤</mo></mrow></msubsup><mo lspace="0em" rspace="0em">​</mo><mi>U</mi><mo lspace="0em" rspace="0em">​</mo><msubsup><mi>𝐱</mi><mi>t</mi><mo>′</mo></msubsup></mrow></mrow><mo maxsize="1.200em" minsize="1.200em" stretchy="true">|</mo></mrow></mrow></mrow></mrow><annotation encoding="application/x-tex">\displaystyle\leq BN\big\|X-X^{\prime}\big\|_{\infty}+2ABN\max_{s\in[T]}\big|\mathbf{x}^{\top}_{s}U\mathbf{x}_{t}-\mathbf{x}^{\prime\top}_{s}U\mathbf{x}^{\prime}_{t}\big|</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
<tbody id="A3.Ex119"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_eqn_cell"></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A3.Ex119.m1" class="ltx_Math" alttext="\displaystyle\leq BN\big\|X-X^{\prime}\big\|_{\infty}+2ABN\max_{s\in[T]}\Big(\big|\mathbf{x}^{\top}_{s}U\mathbf{x}_{t}-\mathbf{x}^{\prime\top}_{s}U\mathbf{x}_{t}\big|+\big|\mathbf{x}^{\prime\top}_{s}U\mathbf{x}_{t}-\mathbf{x}^{\prime\top}_{s}U\mathbf{x}^{\prime}_{t}\big|\Big)" display="inline" intent=":literal"><semantics><mrow><mphantom></mphantom><mo>≤</mo><mrow><mrow><mi>B</mi><mo lspace="0em" rspace="0em">​</mo><mi>N</mi><mo lspace="0em" rspace="0em">​</mo><msub><mrow><mo maxsize="1.200em" minsize="1.200em" stretchy="true">‖</mo><mrow><mi>X</mi><mo>−</mo><msup><mi>X</mi><mo>′</mo></msup></mrow><mo maxsize="1.200em" minsize="1.200em" stretchy="true">‖</mo></mrow><mi mathvariant="normal">∞</mi></msub></mrow><mo>+</mo><mrow><mn>2</mn><mo lspace="0em" rspace="0em">​</mo><mi>A</mi><mo lspace="0em" rspace="0em">​</mo><mi>B</mi><mo lspace="0em" rspace="0em">​</mo><mi>N</mi><mo lspace="0.167em" rspace="0em">​</mo><mrow><munder><mi>max</mi><mrow><mi>s</mi><mo>∈</mo><mrow><mo stretchy="false">[</mo><mi>T</mi><mo stretchy="false">]</mo></mrow></mrow></munder><mo>⁡</mo><mrow><mo maxsize="1.600em" minsize="1.600em">(</mo><mrow><mrow><mo maxsize="1.200em" minsize="1.200em" stretchy="true">|</mo><mrow><mrow><msubsup><mi>𝐱</mi><mi>s</mi><mo>⊤</mo></msubsup><mo lspace="0em" rspace="0em">​</mo><mi>U</mi><mo lspace="0em" rspace="0em">​</mo><msub><mi>𝐱</mi><mi>t</mi></msub></mrow><mo>−</mo><mrow><msubsup><mi>𝐱</mi><mi>s</mi><mrow><mo>′</mo><mo lspace="0.222em">⁣</mo><mo>⊤</mo></mrow></msubsup><mo lspace="0em" rspace="0em">​</mo><mi>U</mi><mo lspace="0em" rspace="0em">​</mo><msub><mi>𝐱</mi><mi>t</mi></msub></mrow></mrow><mo maxsize="1.200em" minsize="1.200em" stretchy="true">|</mo></mrow><mo>+</mo><mrow><mo maxsize="1.200em" minsize="1.200em" stretchy="true">|</mo><mrow><mrow><msubsup><mi>𝐱</mi><mi>s</mi><mrow><mo>′</mo><mo lspace="0.222em">⁣</mo><mo>⊤</mo></mrow></msubsup><mo lspace="0em" rspace="0em">​</mo><mi>U</mi><mo lspace="0em" rspace="0em">​</mo><msub><mi>𝐱</mi><mi>t</mi></msub></mrow><mo>−</mo><mrow><msubsup><mi>𝐱</mi><mi>s</mi><mrow><mo>′</mo><mo lspace="0.222em">⁣</mo><mo>⊤</mo></mrow></msubsup><mo lspace="0em" rspace="0em">​</mo><mi>U</mi><mo lspace="0em" rspace="0em">​</mo><msubsup><mi>𝐱</mi><mi>t</mi><mo>′</mo></msubsup></mrow></mrow><mo maxsize="1.200em" minsize="1.200em" stretchy="true">|</mo></mrow></mrow><mo maxsize="1.600em" minsize="1.600em">)</mo></mrow></mrow></mrow></mrow></mrow><annotation encoding="application/x-tex">\displaystyle\leq BN\big\|X-X^{\prime}\big\|_{\infty}+2ABN\max_{s\in[T]}\Big(\big|\mathbf{x}^{\top}_{s}U\mathbf{x}_{t}-\mathbf{x}^{\prime\top}_{s}U\mathbf{x}_{t}\big|+\big|\mathbf{x}^{\prime\top}_{s}U\mathbf{x}_{t}-\mathbf{x}^{\prime\top}_{s}U\mathbf{x}^{\prime}_{t}\big|\Big)</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
<tbody id="A3.Ex120"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_eqn_cell"></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A3.Ex120.m1" class="ltx_Math" alttext="\displaystyle\leq BN\big\|X-X^{\prime}\big\|_{\infty}+4ABN\big(ABN\max_{s\in[T]}\|\mathbf{x}_{s}-\mathbf{x}_{s}^{\prime}\|_{1}\big)" display="inline" intent=":literal"><semantics><mrow><mphantom></mphantom><mo>≤</mo><mrow><mrow><mi>B</mi><mo lspace="0em" rspace="0em">​</mo><mi>N</mi><mo lspace="0em" rspace="0em">​</mo><msub><mrow><mo maxsize="1.200em" minsize="1.200em" stretchy="true">‖</mo><mrow><mi>X</mi><mo>−</mo><msup><mi>X</mi><mo>′</mo></msup></mrow><mo maxsize="1.200em" minsize="1.200em" stretchy="true">‖</mo></mrow><mi mathvariant="normal">∞</mi></msub></mrow><mo>+</mo><mrow><mn>4</mn><mo lspace="0em" rspace="0em">​</mo><mi>A</mi><mo lspace="0em" rspace="0em">​</mo><mi>B</mi><mo lspace="0em" rspace="0em">​</mo><mi>N</mi><mo lspace="0em" rspace="0em">​</mo><mrow><mo maxsize="1.200em" minsize="1.200em">(</mo><mrow><mi>A</mi><mo lspace="0em" rspace="0em">​</mo><mi>B</mi><mo lspace="0em" rspace="0em">​</mo><mi>N</mi><mo lspace="0.167em" rspace="0em">​</mo><munder><mi>max</mi><mrow><mi>s</mi><mo>∈</mo><mrow><mo stretchy="false">[</mo><mi>T</mi><mo stretchy="false">]</mo></mrow></mrow></munder><mo lspace="0em" rspace="0em">​</mo><msub><mrow><mo stretchy="false">‖</mo><mrow><msub><mi>𝐱</mi><mi>s</mi></msub><mo>−</mo><msubsup><mi>𝐱</mi><mi>s</mi><mo>′</mo></msubsup></mrow><mo stretchy="false">‖</mo></mrow><mn>1</mn></msub></mrow><mo maxsize="1.200em" minsize="1.200em">)</mo></mrow></mrow></mrow></mrow><annotation encoding="application/x-tex">\displaystyle\leq BN\big\|X-X^{\prime}\big\|_{\infty}+4ABN\big(ABN\max_{s\in[T]}\|\mathbf{x}_{s}-\mathbf{x}_{s}^{\prime}\|_{1}\big)</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
<tbody id="A3.Ex121"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_eqn_cell"></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A3.Ex121.m1" class="ltx_Math" alttext="\displaystyle\leq 5A^{2}B^{2}N^{3}\big\|X-X^{\prime}\big\|_{\infty}." display="inline" intent=":literal"><semantics><mrow><mrow><mphantom></mphantom><mo>≤</mo><mrow><mn>5</mn><mo lspace="0em" rspace="0em">​</mo><msup><mi>A</mi><mn>2</mn></msup><mo lspace="0em" rspace="0em">​</mo><msup><mi>B</mi><mn>2</mn></msup><mo lspace="0em" rspace="0em">​</mo><msup><mi>N</mi><mn>3</mn></msup><mo lspace="0em" rspace="0em">​</mo><msub><mrow><mo maxsize="1.200em" minsize="1.200em" stretchy="true">‖</mo><mrow><mi>X</mi><mo>−</mo><msup><mi>X</mi><mo>′</mo></msup></mrow><mo maxsize="1.200em" minsize="1.200em" stretchy="true">‖</mo></mrow><mi mathvariant="normal">∞</mi></msub></mrow></mrow><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">\displaystyle\leq 5A^{2}B^{2}N^{3}\big\|X-X^{\prime}\big\|_{\infty}.</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="A3.p15.3" class="ltx_p"><span id="A3.p15.3.1" class="ltx_text">This shows that each of the <math id="A3.p15.m8" class="ltx_Math" alttext="H" display="inline" intent=":literal"><semantics><mi>H</mi><annotation encoding="application/x-tex">H</annotation></semantics></math> self-attention functions has Lipschitz constant bounded by <math id="A3.p15.m9" class="ltx_Math" alttext="5A^{2}B^{2}N^{3}." display="inline" intent=":literal"><semantics><mrow><mrow><mn>5</mn><mo lspace="0em" rspace="0em">​</mo><msup><mi>A</mi><mn>2</mn></msup><mo lspace="0em" rspace="0em">​</mo><msup><mi>B</mi><mn>2</mn></msup><mo lspace="0em" rspace="0em">​</mo><msup><mi>N</mi><mn>3</mn></msup></mrow><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">5A^{2}B^{2}N^{3}.</annotation></semantics></math>
Since <math id="A3.p15.m10" class="ltx_Math" alttext="X" display="inline" intent=":literal"><semantics><mi>X</mi><annotation encoding="application/x-tex">X</annotation></semantics></math> has Lipschitz constant <math id="A3.p15.m11" class="ltx_Math" alttext="1" display="inline" intent=":literal"><semantics><mn>1</mn><annotation encoding="application/x-tex">1</annotation></semantics></math> and by assumption <math id="A3.p15.m12" class="ltx_Math" alttext="A,B\geq 1" display="inline" intent=":literal"><semantics><mrow><mrow><mi>A</mi><mo>,</mo><mi>B</mi></mrow><mo>≥</mo><mn>1</mn></mrow><annotation encoding="application/x-tex">A,B\geq 1</annotation></semantics></math>, this shows that any multi-head self-attention function <math id="A3.p15.m13" class="ltx_Math" alttext="\operatorname{MA}_{f_{1},\ldots,f_{H}}(X)=X+\sum_{h=1}^{H}f_{h}(X)" display="inline" intent=":literal"><semantics><mrow><mrow><msub><mi>MA</mi><mrow><msub><mi>f</mi><mn>1</mn></msub><mo>,</mo><mi mathvariant="normal">…</mi><mo>,</mo><msub><mi>f</mi><mi>H</mi></msub></mrow></msub><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>X</mi><mo stretchy="false">)</mo></mrow></mrow><mo>=</mo><mrow><mi>X</mi><mo rspace="0.055em">+</mo><mrow><msubsup><mo>∑</mo><mrow><mi>h</mi><mo>=</mo><mn>1</mn></mrow><mi>H</mi></msubsup><mrow><msub><mi>f</mi><mi>h</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>X</mi><mo stretchy="false">)</mo></mrow></mrow></mrow></mrow></mrow><annotation encoding="application/x-tex">\operatorname{MA}_{f_{1},\ldots,f_{H}}(X)=X+\sum_{h=1}^{H}f_{h}(X)</annotation></semantics></math> in the class has Lipschitz constant bounded by <math id="A3.p15.m14" class="ltx_Math" alttext="6HA^{2}B^{2}N^{3}," display="inline" intent=":literal"><semantics><mrow><mrow><mn>6</mn><mo lspace="0em" rspace="0em">​</mo><mi>H</mi><mo lspace="0em" rspace="0em">​</mo><msup><mi>A</mi><mn>2</mn></msup><mo lspace="0em" rspace="0em">​</mo><msup><mi>B</mi><mn>2</mn></msup><mo lspace="0em" rspace="0em">​</mo><msup><mi>N</mi><mn>3</mn></msup></mrow><mo>,</mo></mrow><annotation encoding="application/x-tex">6HA^{2}B^{2}N^{3},</annotation></semantics></math> proving (<a href="#A3.E41" title="In item (ii) ‣ Lemma 9. ‣ Appendix C Proofs for the Stochastic Error ‣ Generalization Bounds for Transformer-Based Next-Token Prediction in a Language Model" class="ltx_ref"><span class="ltx_text ltx_ref_tag">41</span></a>).</span></p>
</div>
<div id="A3.p16" class="ltx_para">
<p id="A3.p16.1" class="ltx_p"><span id="A3.p16.1.1" class="ltx_text">We now show (<a href="#A3.E42" title="In item (ii) ‣ Lemma 9. ‣ Appendix C Proofs for the Stochastic Error ‣ Generalization Bounds for Transformer-Based Next-Token Prediction in a Language Model" class="ltx_ref"><span class="ltx_text ltx_ref_tag">42</span></a>). We have</span></p>
<table id="A3.EGx67" class="ltx_equationgroup ltx_eqn_align ltx_eqn_table">

<tbody id="A3.Ex122"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_align_right ltx_eqn_cell"><math id="A3.Ex122.m1" class="ltx_Math" alttext="\displaystyle\partial_{V_{ij}}\operatorname{SA}_{U,V}^{(t)}(X)=\sum_{s=1}^{T}\frac{\exp(\mathbf{x}^{\top}_{s}U\mathbf{x}_{t})}{\sum_{r=1}^{T}\exp(\mathbf{x}^{\top}_{r}U\mathbf{x}_{t})}\mathbf{e}_{i}\mathbf{e}_{j}^{\top}\mathbf{x}_{s}," display="inline" intent=":literal"><semantics><mrow><mrow><mrow><msub><mo>∂</mo><msub><mi>V</mi><mrow><mi>i</mi><mo lspace="0em" rspace="0em">​</mo><mi>j</mi></mrow></msub></msub><mrow><msubsup><mi>SA</mi><mrow><mi>U</mi><mo>,</mo><mi>V</mi></mrow><mrow><mo stretchy="false">(</mo><mi>t</mi><mo stretchy="false">)</mo></mrow></msubsup><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>X</mi><mo stretchy="false">)</mo></mrow></mrow></mrow><mo>=</mo><mrow><mstyle displaystyle="true"><munderover><mo movablelimits="false">∑</mo><mrow><mi>s</mi><mo>=</mo><mn>1</mn></mrow><mi>T</mi></munderover></mstyle><mrow><mstyle displaystyle="true"><mfrac><mrow><mi>exp</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mrow><msubsup><mi>𝐱</mi><mi>s</mi><mo>⊤</mo></msubsup><mo lspace="0em" rspace="0em">​</mo><mi>U</mi><mo lspace="0em" rspace="0em">​</mo><msub><mi>𝐱</mi><mi>t</mi></msub></mrow><mo stretchy="false">)</mo></mrow></mrow><mrow><msubsup><mo>∑</mo><mrow><mi>r</mi><mo>=</mo><mn>1</mn></mrow><mi>T</mi></msubsup><mrow><mi>exp</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mrow><msubsup><mi>𝐱</mi><mi>r</mi><mo>⊤</mo></msubsup><mo lspace="0em" rspace="0em">​</mo><mi>U</mi><mo lspace="0em" rspace="0em">​</mo><msub><mi>𝐱</mi><mi>t</mi></msub></mrow><mo stretchy="false">)</mo></mrow></mrow></mrow></mfrac></mstyle><mo lspace="0em" rspace="0em">​</mo><msub><mi>𝐞</mi><mi>i</mi></msub><mo lspace="0em" rspace="0em">​</mo><msubsup><mi>𝐞</mi><mi>j</mi><mo>⊤</mo></msubsup><mo lspace="0em" rspace="0em">​</mo><msub><mi>𝐱</mi><mi>s</mi></msub></mrow></mrow></mrow><mo>,</mo></mrow><annotation encoding="application/x-tex">\displaystyle\partial_{V_{ij}}\operatorname{SA}_{U,V}^{(t)}(X)=\sum_{s=1}^{T}\frac{\exp(\mathbf{x}^{\top}_{s}U\mathbf{x}_{t})}{\sum_{r=1}^{T}\exp(\mathbf{x}^{\top}_{r}U\mathbf{x}_{t})}\mathbf{e}_{i}\mathbf{e}_{j}^{\top}\mathbf{x}_{s},</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="A3.p16.2" class="ltx_p"><span id="A3.p16.2.1" class="ltx_text">and thus on <math id="A3.p16.m1" class="ltx_Math" alttext="X\in[-A,A]^{N\times T}," display="inline" intent=":literal"><semantics><mrow><mrow><mi>X</mi><mo>∈</mo><msup><mrow><mo stretchy="false">[</mo><mrow><mrow><mo>−</mo><mi>A</mi></mrow><mo>,</mo><mi>A</mi></mrow><mo stretchy="false">]</mo></mrow><mrow><mi>N</mi><mo lspace="0.222em" rspace="0.222em">×</mo><mi>T</mi></mrow></msup></mrow><mo>,</mo></mrow><annotation encoding="application/x-tex">X\in[-A,A]^{N\times T},</annotation></semantics></math> <math id="A3.p16.m2" class="ltx_Math" alttext="\|\partial_{V_{ij}}\operatorname{SA}_{U,V}(X)\|_{\infty}\leq A." display="inline" intent=":literal"><semantics><mrow><mrow><msub><mrow><mo stretchy="false">‖</mo><mrow><msub><mo lspace="0em" rspace="0.167em">∂</mo><msub><mi>V</mi><mrow><mi>i</mi><mo lspace="0em" rspace="0em">​</mo><mi>j</mi></mrow></msub></msub><mrow><msub><mi>SA</mi><mrow><mi>U</mi><mo>,</mo><mi>V</mi></mrow></msub><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>X</mi><mo stretchy="false">)</mo></mrow></mrow></mrow><mo stretchy="false">‖</mo></mrow><mi mathvariant="normal">∞</mi></msub><mo>≤</mo><mi>A</mi></mrow><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">\|\partial_{V_{ij}}\operatorname{SA}_{U,V}(X)\|_{\infty}\leq A.</annotation></semantics></math> Moreover,</span></p>
<table id="A3.EGx68" class="ltx_equationgroup ltx_eqn_align ltx_eqn_table">

<tbody id="A3.Ex123"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_align_right ltx_eqn_cell"><math id="A3.Ex123.m1" class="ltx_Math" alttext="\displaystyle\partial_{U_{ij}}\operatorname{SA}_{U,V}^{(t)}(X)=\sum_{s=1}^{T}\bigg[\frac{\mathbf{x}^{\top}_{s}\mathbf{e}_{i}\mathbf{e}_{j}^{\top}\mathbf{x}_{t}\exp(\mathbf{x}^{\top}_{s}U\mathbf{x}_{t})}{\sum_{r=1}^{T}\exp(\mathbf{x}^{\top}_{r}U\mathbf{x}_{t})}-\frac{\exp(\mathbf{x}^{\top}_{s}U\mathbf{x}_{t})\sum_{r=1}^{T}\mathbf{x}^{\top}_{r}\mathbf{e}_{i}\mathbf{e}_{j}^{\top}\mathbf{x}_{t}\exp(\mathbf{x}^{\top}_{r}U\mathbf{x}_{t})}{\big(\sum_{r=1}^{T}\exp(\mathbf{x}^{\top}_{r}U\mathbf{x}_{t})\big)^{2}}\bigg]V\mathbf{x}_{s}." display="inline" intent=":literal"><semantics><mrow><mrow><mrow><msub><mo>∂</mo><msub><mi>U</mi><mrow><mi>i</mi><mo lspace="0em" rspace="0em">​</mo><mi>j</mi></mrow></msub></msub><mrow><msubsup><mi>SA</mi><mrow><mi>U</mi><mo>,</mo><mi>V</mi></mrow><mrow><mo stretchy="false">(</mo><mi>t</mi><mo stretchy="false">)</mo></mrow></msubsup><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>X</mi><mo stretchy="false">)</mo></mrow></mrow></mrow><mo>=</mo><mrow><mstyle displaystyle="true"><munderover><mo movablelimits="false">∑</mo><mrow><mi>s</mi><mo>=</mo><mn>1</mn></mrow><mi>T</mi></munderover></mstyle><mrow><mrow><mo maxsize="2.100em" minsize="2.100em">[</mo><mrow><mstyle displaystyle="true"><mfrac><mrow><msubsup><mi>𝐱</mi><mi>s</mi><mo>⊤</mo></msubsup><mo lspace="0em" rspace="0em">​</mo><msub><mi>𝐞</mi><mi>i</mi></msub><mo lspace="0em" rspace="0em">​</mo><msubsup><mi>𝐞</mi><mi>j</mi><mo>⊤</mo></msubsup><mo lspace="0em" rspace="0em">​</mo><msub><mi>𝐱</mi><mi>t</mi></msub><mo lspace="0.167em" rspace="0em">​</mo><mrow><mi>exp</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mrow><msubsup><mi>𝐱</mi><mi>s</mi><mo>⊤</mo></msubsup><mo lspace="0em" rspace="0em">​</mo><mi>U</mi><mo lspace="0em" rspace="0em">​</mo><msub><mi>𝐱</mi><mi>t</mi></msub></mrow><mo stretchy="false">)</mo></mrow></mrow></mrow><mrow><msubsup><mo>∑</mo><mrow><mi>r</mi><mo>=</mo><mn>1</mn></mrow><mi>T</mi></msubsup><mrow><mi>exp</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mrow><msubsup><mi>𝐱</mi><mi>r</mi><mo>⊤</mo></msubsup><mo lspace="0em" rspace="0em">​</mo><mi>U</mi><mo lspace="0em" rspace="0em">​</mo><msub><mi>𝐱</mi><mi>t</mi></msub></mrow><mo stretchy="false">)</mo></mrow></mrow></mrow></mfrac></mstyle><mo>−</mo><mstyle displaystyle="true"><mfrac><mrow><mrow><mi>exp</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mrow><msubsup><mi>𝐱</mi><mi>s</mi><mo>⊤</mo></msubsup><mo lspace="0em" rspace="0em">​</mo><mi>U</mi><mo lspace="0em" rspace="0em">​</mo><msub><mi>𝐱</mi><mi>t</mi></msub></mrow><mo stretchy="false">)</mo></mrow></mrow><mo lspace="0em" rspace="0em">​</mo><mrow><msubsup><mo>∑</mo><mrow><mi>r</mi><mo>=</mo><mn>1</mn></mrow><mi>T</mi></msubsup><mrow><msubsup><mi>𝐱</mi><mi>r</mi><mo>⊤</mo></msubsup><mo lspace="0em" rspace="0em">​</mo><msub><mi>𝐞</mi><mi>i</mi></msub><mo lspace="0em" rspace="0em">​</mo><msubsup><mi>𝐞</mi><mi>j</mi><mo>⊤</mo></msubsup><mo lspace="0em" rspace="0em">​</mo><msub><mi>𝐱</mi><mi>t</mi></msub><mo lspace="0.167em" rspace="0em">​</mo><mrow><mi>exp</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mrow><msubsup><mi>𝐱</mi><mi>r</mi><mo>⊤</mo></msubsup><mo lspace="0em" rspace="0em">​</mo><mi>U</mi><mo lspace="0em" rspace="0em">​</mo><msub><mi>𝐱</mi><mi>t</mi></msub></mrow><mo stretchy="false">)</mo></mrow></mrow></mrow></mrow></mrow><msup><mrow><mo maxsize="1.200em" minsize="1.200em">(</mo><mrow><msubsup><mo lspace="0em">∑</mo><mrow><mi>r</mi><mo>=</mo><mn>1</mn></mrow><mi>T</mi></msubsup><mrow><mi>exp</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mrow><msubsup><mi>𝐱</mi><mi>r</mi><mo>⊤</mo></msubsup><mo lspace="0em" rspace="0em">​</mo><mi>U</mi><mo lspace="0em" rspace="0em">​</mo><msub><mi>𝐱</mi><mi>t</mi></msub></mrow><mo stretchy="false">)</mo></mrow></mrow></mrow><mo maxsize="1.200em" minsize="1.200em">)</mo></mrow><mn>2</mn></msup></mfrac></mstyle></mrow><mo maxsize="2.100em" minsize="2.100em">]</mo></mrow><mo lspace="0em" rspace="0em">​</mo><mi>V</mi><mo lspace="0em" rspace="0em">​</mo><msub><mi>𝐱</mi><mi>s</mi></msub></mrow></mrow></mrow><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">\displaystyle\partial_{U_{ij}}\operatorname{SA}_{U,V}^{(t)}(X)=\sum_{s=1}^{T}\bigg[\frac{\mathbf{x}^{\top}_{s}\mathbf{e}_{i}\mathbf{e}_{j}^{\top}\mathbf{x}_{t}\exp(\mathbf{x}^{\top}_{s}U\mathbf{x}_{t})}{\sum_{r=1}^{T}\exp(\mathbf{x}^{\top}_{r}U\mathbf{x}_{t})}-\frac{\exp(\mathbf{x}^{\top}_{s}U\mathbf{x}_{t})\sum_{r=1}^{T}\mathbf{x}^{\top}_{r}\mathbf{e}_{i}\mathbf{e}_{j}^{\top}\mathbf{x}_{t}\exp(\mathbf{x}^{\top}_{r}U\mathbf{x}_{t})}{\big(\sum_{r=1}^{T}\exp(\mathbf{x}^{\top}_{r}U\mathbf{x}_{t})\big)^{2}}\bigg]V\mathbf{x}_{s}.</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="A3.p16.3" class="ltx_p"><span id="A3.p16.3.1" class="ltx_text">Using that every entry of <math id="A3.p16.m3" class="ltx_Math" alttext="X" display="inline" intent=":literal"><semantics><mi>X</mi><annotation encoding="application/x-tex">X</annotation></semantics></math> is bounded in absolute value by <math id="A3.p16.m4" class="ltx_Math" alttext="A" display="inline" intent=":literal"><semantics><mi>A</mi><annotation encoding="application/x-tex">A</annotation></semantics></math> and any entry of <math id="A3.p16.m5" class="ltx_Math" alttext="V" display="inline" intent=":literal"><semantics><mi>V</mi><annotation encoding="application/x-tex">V</annotation></semantics></math> is bounded in absolute value by <math id="A3.p16.m6" class="ltx_Math" alttext="B," display="inline" intent=":literal"><semantics><mrow><mi>B</mi><mo>,</mo></mrow><annotation encoding="application/x-tex">B,</annotation></semantics></math> we find</span></p>
<table id="A3.EGx69" class="ltx_equationgroup ltx_eqn_align ltx_eqn_table">

<tbody id="A3.Ex124"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_align_right ltx_eqn_cell"><math id="A3.Ex124.m1" class="ltx_Math" alttext="\displaystyle\big\|\partial_{U_{ij}}\operatorname{SA}_{U,V}(X)\big\|_{\infty}\leq 2A^{2}\max_{s=1,\ldots,T}\big\|V\mathbf{x}_{s}\big\|_{\infty}\leq 2A^{2}NBA=2A^{3}NB." display="inline" intent=":literal"><semantics><mrow><mrow><msub><mrow><mo maxsize="1.200em" minsize="1.200em" stretchy="true">‖</mo><mrow><msub><mo lspace="0em" rspace="0.167em">∂</mo><msub><mi>U</mi><mrow><mi>i</mi><mo lspace="0em" rspace="0em">​</mo><mi>j</mi></mrow></msub></msub><mrow><msub><mi>SA</mi><mrow><mi>U</mi><mo>,</mo><mi>V</mi></mrow></msub><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>X</mi><mo stretchy="false">)</mo></mrow></mrow></mrow><mo maxsize="1.200em" minsize="1.200em" stretchy="true">‖</mo></mrow><mi mathvariant="normal">∞</mi></msub><mo>≤</mo><mrow><mn>2</mn><mo lspace="0em" rspace="0em">​</mo><msup><mi>A</mi><mn>2</mn></msup><mo lspace="0.167em" rspace="0em">​</mo><munder><mi>max</mi><mrow><mrow><mi>s</mi><mo>=</mo><mn>1</mn></mrow><mo>,</mo><mi mathvariant="normal">…</mi><mo>,</mo><mi>T</mi></mrow></munder><mo lspace="0em" rspace="0em">​</mo><msub><mrow><mo maxsize="1.200em" minsize="1.200em" stretchy="true">‖</mo><mrow><mi>V</mi><mo lspace="0em" rspace="0em">​</mo><msub><mi>𝐱</mi><mi>s</mi></msub></mrow><mo maxsize="1.200em" minsize="1.200em" stretchy="true">‖</mo></mrow><mi mathvariant="normal">∞</mi></msub></mrow><mo>≤</mo><mrow><mn>2</mn><mo lspace="0em" rspace="0em">​</mo><msup><mi>A</mi><mn>2</mn></msup><mo lspace="0em" rspace="0em">​</mo><mi>N</mi><mo lspace="0em" rspace="0em">​</mo><mi>B</mi><mo lspace="0em" rspace="0em">​</mo><mi>A</mi></mrow><mo>=</mo><mrow><mn>2</mn><mo lspace="0em" rspace="0em">​</mo><msup><mi>A</mi><mn>3</mn></msup><mo lspace="0em" rspace="0em">​</mo><mi>N</mi><mo lspace="0em" rspace="0em">​</mo><mi>B</mi></mrow></mrow><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">\displaystyle\big\|\partial_{U_{ij}}\operatorname{SA}_{U,V}(X)\big\|_{\infty}\leq 2A^{2}\max_{s=1,\ldots,T}\big\|V\mathbf{x}_{s}\big\|_{\infty}\leq 2A^{2}NBA=2A^{3}NB.</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
</div>
<div id="A3.p17" class="ltx_para">
<p id="A3.p17.1" class="ltx_p"><span id="A3.p17.1.1" class="ltx_text">The multi-head self-attention class consists of functions of the form <math id="A3.p17.m1" class="ltx_Math" alttext="\operatorname{MA}_{f_{1},\ldots,f_{H}}(X)=X+\sum_{h=1}^{H}f_{h}(X)\in\mathbb{R}^{N\times T}" display="inline" intent=":literal"><semantics><mrow><mrow><msub><mi>MA</mi><mrow><msub><mi>f</mi><mn>1</mn></msub><mo>,</mo><mi mathvariant="normal">…</mi><mo>,</mo><msub><mi>f</mi><mi>H</mi></msub></mrow></msub><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>X</mi><mo stretchy="false">)</mo></mrow></mrow><mo>=</mo><mrow><mi>X</mi><mo rspace="0.055em">+</mo><mrow><msubsup><mo>∑</mo><mrow><mi>h</mi><mo>=</mo><mn>1</mn></mrow><mi>H</mi></msubsup><mrow><msub><mi>f</mi><mi>h</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>X</mi><mo stretchy="false">)</mo></mrow></mrow></mrow></mrow><mo>∈</mo><msup><mi>ℝ</mi><mrow><mi>N</mi><mo lspace="0.222em" rspace="0.222em">×</mo><mi>T</mi></mrow></msup></mrow><annotation encoding="application/x-tex">\operatorname{MA}_{f_{1},\ldots,f_{H}}(X)=X+\sum_{h=1}^{H}f_{h}(X)\in\mathbb{R}^{N\times T}</annotation></semantics></math> with self-attention layers <math id="A3.p17.m2" class="ltx_Math" alttext="f_{1},\ldots,f_{H}" display="inline" intent=":literal"><semantics><mrow><msub><mi>f</mi><mn>1</mn></msub><mo>,</mo><mi mathvariant="normal">…</mi><mo>,</mo><msub><mi>f</mi><mi>H</mi></msub></mrow><annotation encoding="application/x-tex">f_{1},\ldots,f_{H}</annotation></semantics></math>.
Let <math id="A3.p17.m3" class="ltx_Math" alttext="\bm{\theta}=(V_{1},U_{1},\ldots,V_{H},U_{H})" display="inline" intent=":literal"><semantics><mrow><mi>𝜽</mi><mo>=</mo><mrow><mo stretchy="false">(</mo><msub><mi>V</mi><mn>1</mn></msub><mo>,</mo><msub><mi>U</mi><mn>1</mn></msub><mo>,</mo><mi mathvariant="normal">…</mi><mo>,</mo><msub><mi>V</mi><mi>H</mi></msub><mo>,</mo><msub><mi>U</mi><mi>H</mi></msub><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">\bm{\theta}=(V_{1},U_{1},\ldots,V_{H},U_{H})</annotation></semantics></math> and denote the <math id="A3.p17.m4" class="ltx_Math" alttext="(n,t)" display="inline" intent=":literal"><semantics><mrow><mo stretchy="false">(</mo><mi>n</mi><mo>,</mo><mi>t</mi><mo stretchy="false">)</mo></mrow><annotation encoding="application/x-tex">(n,t)</annotation></semantics></math>-th entry of <math id="A3.p17.m5" class="ltx_Math" alttext="\operatorname{MA}_{f_{1},\ldots,f_{H}}(X)" display="inline" intent=":literal"><semantics><mrow><msub><mi>MA</mi><mrow><msub><mi>f</mi><mn>1</mn></msub><mo>,</mo><mi mathvariant="normal">…</mi><mo>,</mo><msub><mi>f</mi><mi>H</mi></msub></mrow></msub><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>X</mi><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">\operatorname{MA}_{f_{1},\ldots,f_{H}}(X)</annotation></semantics></math> by <math id="A3.p17.m6" class="ltx_Math" alttext="\operatorname{MA}_{f_{1},\ldots,f_{H}}(X)_{n,t}." display="inline" intent=":literal"><semantics><mrow><mrow><msub><mi>MA</mi><mrow><msub><mi>f</mi><mn>1</mn></msub><mo>,</mo><mi mathvariant="normal">…</mi><mo>,</mo><msub><mi>f</mi><mi>H</mi></msub></mrow></msub><mo>⁡</mo><msub><mrow><mo stretchy="false">(</mo><mi>X</mi><mo stretchy="false">)</mo></mrow><mrow><mi>n</mi><mo>,</mo><mi>t</mi></mrow></msub></mrow><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">\operatorname{MA}_{f_{1},\ldots,f_{H}}(X)_{n,t}.</annotation></semantics></math> Then, for any <math id="A3.p17.m7" class="ltx_Math" alttext="X\in[A,A]^{N\times T}," display="inline" intent=":literal"><semantics><mrow><mrow><mi>X</mi><mo>∈</mo><msup><mrow><mo stretchy="false">[</mo><mrow><mi>A</mi><mo>,</mo><mi>A</mi></mrow><mo stretchy="false">]</mo></mrow><mrow><mi>N</mi><mo lspace="0.222em" rspace="0.222em">×</mo><mi>T</mi></mrow></msup></mrow><mo>,</mo></mrow><annotation encoding="application/x-tex">X\in[A,A]^{N\times T},</annotation></semantics></math></span></p>
<table id="A3.EGx70" class="ltx_equationgroup ltx_eqn_align ltx_eqn_table">

<tbody id="A3.Ex125"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_align_right ltx_eqn_cell"><math id="A3.Ex125.m1" class="ltx_Math" alttext="\displaystyle\big\|\nabla_{\bm{\theta}}\operatorname{MA}_{W,f_{1},\ldots,f_{H}}(X)_{n,t}\big\|_{1}\leq\underbrace{HN^{2}A}_{\text{due to }V_{1},\ldots,V_{H}}+\underbrace{HN^{2}(2A^{3}NB)}_{\text{due to }U_{1},\ldots,U_{H}}\leq 3HA^{3}N^{3}B," display="inline" intent=":literal"><semantics><mrow><mrow><msub><mrow><mo maxsize="1.200em" minsize="1.200em" stretchy="true">‖</mo><mrow><mrow><msub><mo rspace="0.167em">∇</mo><mi>𝜽</mi></msub><msub><mi>MA</mi><mrow><mi>W</mi><mo>,</mo><msub><mi>f</mi><mn>1</mn></msub><mo>,</mo><mi mathvariant="normal">…</mi><mo>,</mo><msub><mi>f</mi><mi>H</mi></msub></mrow></msub></mrow><mo lspace="0em" rspace="0em">​</mo><msub><mrow><mo stretchy="false">(</mo><mi>X</mi><mo stretchy="false">)</mo></mrow><mrow><mi>n</mi><mo>,</mo><mi>t</mi></mrow></msub></mrow><mo maxsize="1.200em" minsize="1.200em" stretchy="true">‖</mo></mrow><mn>1</mn></msub><mo>≤</mo><mrow><munder><munder accentunder="true"><mrow><mi>H</mi><mo lspace="0em" rspace="0em">​</mo><msup><mi>N</mi><mn>2</mn></msup><mo lspace="0em" rspace="0em">​</mo><mi>A</mi></mrow><mo stretchy="true">⏟</mo></munder><mrow><mrow><mtext>due to </mtext><mo lspace="0em" rspace="0em">​</mo><msub><mi>V</mi><mn>1</mn></msub></mrow><mo>,</mo><mi mathvariant="normal">…</mi><mo>,</mo><msub><mi>V</mi><mi>H</mi></msub></mrow></munder><mo>+</mo><munder><munder accentunder="true"><mrow><mi>H</mi><mo lspace="0em" rspace="0em">​</mo><msup><mi>N</mi><mn>2</mn></msup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mrow><mn>2</mn><mo lspace="0em" rspace="0em">​</mo><msup><mi>A</mi><mn>3</mn></msup><mo lspace="0em" rspace="0em">​</mo><mi>N</mi><mo lspace="0em" rspace="0em">​</mo><mi>B</mi></mrow><mo stretchy="false">)</mo></mrow></mrow><mo stretchy="true">⏟</mo></munder><mrow><mrow><mtext>due to </mtext><mo lspace="0em" rspace="0em">​</mo><msub><mi>U</mi><mn>1</mn></msub></mrow><mo>,</mo><mi mathvariant="normal">…</mi><mo>,</mo><msub><mi>U</mi><mi>H</mi></msub></mrow></munder></mrow><mo>≤</mo><mrow><mn>3</mn><mo lspace="0em" rspace="0em">​</mo><mi>H</mi><mo lspace="0em" rspace="0em">​</mo><msup><mi>A</mi><mn>3</mn></msup><mo lspace="0em" rspace="0em">​</mo><msup><mi>N</mi><mn>3</mn></msup><mo lspace="0em" rspace="0em">​</mo><mi>B</mi></mrow></mrow><mo>,</mo></mrow><annotation encoding="application/x-tex">\displaystyle\big\|\nabla_{\bm{\theta}}\operatorname{MA}_{W,f_{1},\ldots,f_{H}}(X)_{n,t}\big\|_{1}\leq\underbrace{HN^{2}A}_{\text{due to }V_{1},\ldots,V_{H}}+\underbrace{HN^{2}(2A^{3}NB)}_{\text{due to }U_{1},\ldots,U_{H}}\leq 3HA^{3}N^{3}B,</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="A3.p17.2" class="ltx_p"><span id="A3.p17.2.1" class="ltx_text">proving (<a href="#A3.E42" title="In item (ii) ‣ Lemma 9. ‣ Appendix C Proofs for the Stochastic Error ‣ Generalization Bounds for Transformer-Based Next-Token Prediction in a Language Model" class="ltx_ref"><span class="ltx_text ltx_ref_tag">42</span></a>).</span></p>
</div>
<div id="A3.p18" class="ltx_para">
<p id="A3.p18.1" class="ltx_p"><span id="A3.p18.1.1" class="ltx_text ltx_font_italic">(iii):</span><span id="A3.p18.1.2" class="ltx_text"> Recall that <math id="A3.p18.m1" class="ltx_math_unparsed" alttext="\mathcal{TB}(N,H,L_{\mathrm{mlp}},N_{\mathrm{mlp}},B)=\{\mathbf{h}_{\bm{\theta}^{\prime}}\circ\mathbf{g}_{\bm{\theta}}:\mathbf{g}_{\bm{\theta}}\in\mathcal{MA}(N,H,B),\,\mathbf{h}_{\bm{\theta}^{\prime}}\in\mathcal{MLP}(N,N,L_{\mathrm{mlp}},N_{\mathrm{mlp}},B)\}." display="inline" intent=":literal"><semantics><mrow><mi class="ltx_font_mathcaligraphic">𝒯</mi><mi class="ltx_font_mathcaligraphic">ℬ</mi><mrow><mo stretchy="false">(</mo><mi>N</mi><mo>,</mo><mi>H</mi><mo>,</mo><msub><mi>L</mi><mi>mlp</mi></msub><mo>,</mo><msub><mi>N</mi><mi>mlp</mi></msub><mo>,</mo><mi>B</mi><mo stretchy="false">)</mo></mrow><mo>=</mo><mrow><mo stretchy="false">{</mo><msub><mi>𝐡</mi><msup><mi>𝜽</mi><mo>′</mo></msup></msub><mo lspace="0.222em" rspace="0.222em">∘</mo><msub><mi>𝐠</mi><mi>𝜽</mi></msub><mo lspace="0.278em" rspace="0.278em">:</mo><msub><mi>𝐠</mi><mi>𝜽</mi></msub><mo>∈</mo><mi class="ltx_font_mathcaligraphic">ℳ</mi><mi class="ltx_font_mathcaligraphic">𝒜</mi><mrow><mo stretchy="false">(</mo><mi>N</mi><mo>,</mo><mi>H</mi><mo>,</mo><mi>B</mi><mo stretchy="false">)</mo></mrow><mo rspace="0.337em">,</mo><msub><mi>𝐡</mi><msup><mi>𝜽</mi><mo>′</mo></msup></msub><mo>∈</mo><mi class="ltx_font_mathcaligraphic">ℳ</mi><mi class="ltx_font_mathcaligraphic">ℒ</mi><mi class="ltx_font_mathcaligraphic">𝒫</mi><mrow><mo stretchy="false">(</mo><mi>N</mi><mo>,</mo><mi>N</mi><mo>,</mo><msub><mi>L</mi><mi>mlp</mi></msub><mo>,</mo><msub><mi>N</mi><mi>mlp</mi></msub><mo>,</mo><mi>B</mi><mo stretchy="false">)</mo></mrow><mo stretchy="false">}</mo></mrow><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">\mathcal{TB}(N,H,L_{\mathrm{mlp}},N_{\mathrm{mlp}},B)=\{\mathbf{h}_{\bm{\theta}^{\prime}}\circ\mathbf{g}_{\bm{\theta}}:\mathbf{g}_{\bm{\theta}}\in\mathcal{MA}(N,H,B),\,\mathbf{h}_{\bm{\theta}^{\prime}}\in\mathcal{MLP}(N,N,L_{\mathrm{mlp}},N_{\mathrm{mlp}},B)\}.</annotation></semantics></math>
By (<a href="#A3.E40" title="In item (ii) ‣ Lemma 9. ‣ Appendix C Proofs for the Stochastic Error ‣ Generalization Bounds for Transformer-Based Next-Token Prediction in a Language Model" class="ltx_ref"><span class="ltx_text ltx_ref_tag">40</span></a>), we find</span></p>
<table id="A3.Ex126" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="A3.Ex126.m1" class="ltx_Math" alttext="\sup_{\mathbf{g}_{\bm{\theta}}\in\mathcal{MA}(N,H,B)}\,\|\mathbf{g}_{\bm{\theta}}\|_{L^{\infty}([-A,A]^{N\times T})}\leq 2HABN\eqcolon\overline{A}." display="block" intent=":literal"><semantics><mrow><mrow><mrow><munder><mo movablelimits="false">sup</mo><mrow><msub><mi>𝐠</mi><mi>𝜽</mi></msub><mo>∈</mo><mrow><mi class="ltx_font_mathcaligraphic">ℳ</mi><mo lspace="0em" rspace="0em">​</mo><mi class="ltx_font_mathcaligraphic">𝒜</mi><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>N</mi><mo>,</mo><mi>H</mi><mo>,</mo><mi>B</mi><mo stretchy="false">)</mo></mrow></mrow></mrow></munder><msub><mrow><mo lspace="0.170em" stretchy="false">‖</mo><msub><mi>𝐠</mi><mi>𝜽</mi></msub><mo stretchy="false">‖</mo></mrow><mrow><msup><mi>L</mi><mi mathvariant="normal">∞</mi></msup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msup><mrow><mo stretchy="false">[</mo><mrow><mrow><mo>−</mo><mi>A</mi></mrow><mo>,</mo><mi>A</mi></mrow><mo stretchy="false">]</mo></mrow><mrow><mi>N</mi><mo lspace="0.222em" rspace="0.222em">×</mo><mi>T</mi></mrow></msup><mo stretchy="false">)</mo></mrow></mrow></msub></mrow><mo>≤</mo><mrow><mn>2</mn><mo lspace="0em" rspace="0em">​</mo><mi>H</mi><mo lspace="0em" rspace="0em">​</mo><mi>A</mi><mo lspace="0em" rspace="0em">​</mo><mi>B</mi><mo lspace="0em" rspace="0em">​</mo><mi>N</mi></mrow><mo>≕</mo><mover accent="true"><mi>A</mi><mo stretchy="true">¯</mo></mover></mrow><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">\sup_{\mathbf{g}_{\bm{\theta}}\in\mathcal{MA}(N,H,B)}\,\|\mathbf{g}_{\bm{\theta}}\|_{L^{\infty}([-A,A]^{N\times T})}\leq 2HABN\eqcolon\overline{A}.</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="A3.p18.2" class="ltx_p"><span id="A3.p18.2.1" class="ltx_text">By (<a href="#A3.E37" title="In item (i) ‣ Lemma 9. ‣ Appendix C Proofs for the Stochastic Error ‣ Generalization Bounds for Transformer-Based Next-Token Prediction in a Language Model" class="ltx_ref"><span class="ltx_text ltx_ref_tag">37</span></a>) and using <math id="A3.p18.m2" class="ltx_Math" alttext="N\leq N_{\mathrm{mlp}}," display="inline" intent=":literal"><semantics><mrow><mrow><mi>N</mi><mo>≤</mo><msub><mi>N</mi><mi>mlp</mi></msub></mrow><mo>,</mo></mrow><annotation encoding="application/x-tex">N\leq N_{\mathrm{mlp}},</annotation></semantics></math></span></p>
<table id="A3.Ex127" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="A3.Ex127.m1" class="ltx_math_unparsed" alttext="\sup_{\mathbf{h}_{\bm{\theta}^{\prime}}\in\mathcal{MLP}(N,N,L_{\mathrm{mlp}},N_{\mathrm{mlp}},B)}\,\|\mathbf{h}_{\bm{\theta}^{\prime}}\|_{L^{\infty}([-\overline{A},\overline{A}]^{N}])}\leq\overline{A}\big(B(N_{\mathrm{mlp}}+1)\big)^{L_{\mathrm{mlp}}+1}\leq 2HA\big(B(N_{\mathrm{mlp}}+1)\big)^{L_{\mathrm{mlp}}+2}," display="block" intent=":literal"><semantics><mrow><munder><mo movablelimits="false">sup</mo><mrow><msub><mi>𝐡</mi><msup><mi>𝜽</mi><mo>′</mo></msup></msub><mo>∈</mo><mrow><mi class="ltx_font_mathcaligraphic">ℳ</mi><mo lspace="0em" rspace="0em">​</mo><mi class="ltx_font_mathcaligraphic">ℒ</mi><mo lspace="0em" rspace="0em">​</mo><mi class="ltx_font_mathcaligraphic">𝒫</mi><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>N</mi><mo>,</mo><mi>N</mi><mo>,</mo><msub><mi>L</mi><mi>mlp</mi></msub><mo>,</mo><msub><mi>N</mi><mi>mlp</mi></msub><mo>,</mo><mi>B</mi><mo stretchy="false">)</mo></mrow></mrow></mrow></munder><mo lspace="0.170em" rspace="0.167em">∥</mo><msub><mi>𝐡</mi><msup><mi>𝜽</mi><mo>′</mo></msup></msub><msub><mo lspace="0em" rspace="0.0835em">∥</mo><mrow><mi>L</mi><msup><mrow></mrow><mi mathvariant="normal">∞</mi></msup><mo stretchy="false">(</mo><mo stretchy="false">[</mo><mo lspace="0em">−</mo><mover accent="true"><mi>A</mi><mo stretchy="true">¯</mo></mover><mo>,</mo><mover accent="true"><mi>A</mi><mo stretchy="true">¯</mo></mover><mo stretchy="false">]</mo><msup><mrow></mrow><mi>N</mi></msup><mo stretchy="false">]</mo><mo stretchy="false">)</mo></mrow></msub><mo lspace="0.0835em">≤</mo><mover accent="true"><mi>A</mi><mo stretchy="true">¯</mo></mover><msup><mrow><mo maxsize="1.200em" minsize="1.200em">(</mo><mi>B</mi><mrow><mo stretchy="false">(</mo><msub><mi>N</mi><mi>mlp</mi></msub><mo>+</mo><mn>1</mn><mo stretchy="false">)</mo></mrow><mo maxsize="1.200em" minsize="1.200em">)</mo></mrow><mrow><msub><mi>L</mi><mi>mlp</mi></msub><mo>+</mo><mn>1</mn></mrow></msup><mo>≤</mo><mn>2</mn><mi>H</mi><mi>A</mi><msup><mrow><mo maxsize="1.200em" minsize="1.200em">(</mo><mi>B</mi><mrow><mo stretchy="false">(</mo><msub><mi>N</mi><mi>mlp</mi></msub><mo>+</mo><mn>1</mn><mo stretchy="false">)</mo></mrow><mo maxsize="1.200em" minsize="1.200em">)</mo></mrow><mrow><msub><mi>L</mi><mi>mlp</mi></msub><mo>+</mo><mn>2</mn></mrow></msup><mo>,</mo></mrow><annotation encoding="application/x-tex">\sup_{\mathbf{h}_{\bm{\theta}^{\prime}}\in\mathcal{MLP}(N,N,L_{\mathrm{mlp}},N_{\mathrm{mlp}},B)}\,\|\mathbf{h}_{\bm{\theta}^{\prime}}\|_{L^{\infty}([-\overline{A},\overline{A}]^{N}])}\leq\overline{A}\big(B(N_{\mathrm{mlp}}+1)\big)^{L_{\mathrm{mlp}}+1}\leq 2HA\big(B(N_{\mathrm{mlp}}+1)\big)^{L_{\mathrm{mlp}}+2},</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="A3.p18.3" class="ltx_p"><span id="A3.p18.3.1" class="ltx_text">establishing (<a href="#A3.E43" title="In item (iii) ‣ Lemma 9. ‣ Appendix C Proofs for the Stochastic Error ‣ Generalization Bounds for Transformer-Based Next-Token Prediction in a Language Model" class="ltx_ref"><span class="ltx_text ltx_ref_tag">43</span></a>).</span></p>
</div>
<div id="A3.p19" class="ltx_para">
<p id="A3.p19.1" class="ltx_p"><span id="A3.p19.1.1" class="ltx_text">We now prove (<a href="#A3.E44" title="In item (iii) ‣ Lemma 9. ‣ Appendix C Proofs for the Stochastic Error ‣ Generalization Bounds for Transformer-Based Next-Token Prediction in a Language Model" class="ltx_ref"><span class="ltx_text ltx_ref_tag">44</span></a>). The Lipschitz constant with respect to the input of the composition is the product of the Lipschitz constants with respect to the inputs of the inner function <math id="A3.p19.m1" class="ltx_Math" alttext="\mathbf{g}_{\bm{\theta}}" display="inline" intent=":literal"><semantics><msub><mi>𝐠</mi><mi>𝜽</mi></msub><annotation encoding="application/x-tex">\mathbf{g}_{\bm{\theta}}</annotation></semantics></math> and the outer function <math id="A3.p19.m2" class="ltx_Math" alttext="\mathbf{h}_{\bm{\theta}^{\prime}}" display="inline" intent=":literal"><semantics><msub><mi>𝐡</mi><msup><mi>𝜽</mi><mo>′</mo></msup></msub><annotation encoding="application/x-tex">\mathbf{h}_{\bm{\theta}^{\prime}}</annotation></semantics></math>. By (<a href="#A3.E41" title="In item (ii) ‣ Lemma 9. ‣ Appendix C Proofs for the Stochastic Error ‣ Generalization Bounds for Transformer-Based Next-Token Prediction in a Language Model" class="ltx_ref"><span class="ltx_text ltx_ref_tag">41</span></a>), the Lipschitz constant of the inner function is <math id="A3.p19.m3" class="ltx_Math" alttext="6HA^{2}B^{2}N^{3}" display="inline" intent=":literal"><semantics><mrow><mn>6</mn><mo lspace="0em" rspace="0em">​</mo><mi>H</mi><mo lspace="0em" rspace="0em">​</mo><msup><mi>A</mi><mn>2</mn></msup><mo lspace="0em" rspace="0em">​</mo><msup><mi>B</mi><mn>2</mn></msup><mo lspace="0em" rspace="0em">​</mo><msup><mi>N</mi><mn>3</mn></msup></mrow><annotation encoding="application/x-tex">6HA^{2}B^{2}N^{3}</annotation></semantics></math> and by (<a href="#A3.E38" title="In item (i) ‣ Lemma 9. ‣ Appendix C Proofs for the Stochastic Error ‣ Generalization Bounds for Transformer-Based Next-Token Prediction in a Language Model" class="ltx_ref"><span class="ltx_text ltx_ref_tag">38</span></a>), the Lipschitz of the outer function is <math id="A3.p19.m4" class="ltx_Math" alttext="(BN_{\mathrm{mlp}})^{L_{\mathrm{mlp}}}." display="inline" intent=":literal"><semantics><mrow><msup><mrow><mo stretchy="false">(</mo><mrow><mi>B</mi><mo lspace="0em" rspace="0em">​</mo><msub><mi>N</mi><mi>mlp</mi></msub></mrow><mo stretchy="false">)</mo></mrow><msub><mi>L</mi><mi>mlp</mi></msub></msup><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">(BN_{\mathrm{mlp}})^{L_{\mathrm{mlp}}}.</annotation></semantics></math> The product is the upper bound in (<a href="#A3.E44" title="In item (iii) ‣ Lemma 9. ‣ Appendix C Proofs for the Stochastic Error ‣ Generalization Bounds for Transformer-Based Next-Token Prediction in a Language Model" class="ltx_ref"><span class="ltx_text ltx_ref_tag">44</span></a>).</span></p>
</div>
<div id="A3.p20" class="ltx_para">
<p id="A3.p20.1" class="ltx_p"><span id="A3.p20.1.1" class="ltx_text">To derive (<a href="#A3.E45" title="In item (iii) ‣ Lemma 9. ‣ Appendix C Proofs for the Stochastic Error ‣ Generalization Bounds for Transformer-Based Next-Token Prediction in a Language Model" class="ltx_ref"><span class="ltx_text ltx_ref_tag">45</span></a>), we apply Lemma <a href="#Thmconj28" title="Lemma 8. ‣ Appendix C Proofs for the Stochastic Error ‣ Generalization Bounds for Transformer-Based Next-Token Prediction in a Language Model" class="ltx_ref"><span class="ltx_text ltx_ref_tag">8</span></a> with <math id="A3.p20.m1" class="ltx_Math" alttext="q=2," display="inline" intent=":literal"><semantics><mrow><mrow><mi>q</mi><mo>=</mo><mn>2</mn></mrow><mo>,</mo></mrow><annotation encoding="application/x-tex">q=2,</annotation></semantics></math> <math id="A3.p20.m2" class="ltx_Math" alttext="K_{1}\leq 3HA^{3}BN^{3}" display="inline" intent=":literal"><semantics><mrow><msub><mi>K</mi><mn>1</mn></msub><mo>≤</mo><mrow><mn>3</mn><mo lspace="0em" rspace="0em">​</mo><mi>H</mi><mo lspace="0em" rspace="0em">​</mo><msup><mi>A</mi><mn>3</mn></msup><mo lspace="0em" rspace="0em">​</mo><mi>B</mi><mo lspace="0em" rspace="0em">​</mo><msup><mi>N</mi><mn>3</mn></msup></mrow></mrow><annotation encoding="application/x-tex">K_{1}\leq 3HA^{3}BN^{3}</annotation></semantics></math> (by (<a href="#A3.E42" title="In item (ii) ‣ Lemma 9. ‣ Appendix C Proofs for the Stochastic Error ‣ Generalization Bounds for Transformer-Based Next-Token Prediction in a Language Model" class="ltx_ref"><span class="ltx_text ltx_ref_tag">42</span></a>)),</span></p>
<table id="A3.Ex128" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="A3.Ex128.m1" class="ltx_Math" alttext="K_{2}\leq 6\overline{A}\big(B(N_{\mathrm{mlp}}+1)\big)^{2L_{\mathrm{mlp}}+1}\leq 12HA\big(B(N_{\mathrm{mlp}}+1)\big)^{2L_{\mathrm{mlp}}+2}" display="block" intent=":literal"><semantics><mrow><msub><mi>K</mi><mn>2</mn></msub><mo>≤</mo><mrow><mn>6</mn><mo lspace="0em" rspace="0em">​</mo><mover accent="true"><mi>A</mi><mo stretchy="true">¯</mo></mover><mo lspace="0em" rspace="0em">​</mo><msup><mrow><mo maxsize="1.200em" minsize="1.200em">(</mo><mrow><mi>B</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mrow><msub><mi>N</mi><mi>mlp</mi></msub><mo>+</mo><mn>1</mn></mrow><mo stretchy="false">)</mo></mrow></mrow><mo maxsize="1.200em" minsize="1.200em">)</mo></mrow><mrow><mrow><mn>2</mn><mo lspace="0em" rspace="0em">​</mo><msub><mi>L</mi><mi>mlp</mi></msub></mrow><mo>+</mo><mn>1</mn></mrow></msup></mrow><mo>≤</mo><mrow><mn>12</mn><mo lspace="0em" rspace="0em">​</mo><mi>H</mi><mo lspace="0em" rspace="0em">​</mo><mi>A</mi><mo lspace="0em" rspace="0em">​</mo><msup><mrow><mo maxsize="1.200em" minsize="1.200em">(</mo><mrow><mi>B</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mrow><msub><mi>N</mi><mi>mlp</mi></msub><mo>+</mo><mn>1</mn></mrow><mo stretchy="false">)</mo></mrow></mrow><mo maxsize="1.200em" minsize="1.200em">)</mo></mrow><mrow><mrow><mn>2</mn><mo lspace="0em" rspace="0em">​</mo><msub><mi>L</mi><mi>mlp</mi></msub></mrow><mo>+</mo><mn>2</mn></mrow></msup></mrow></mrow><annotation encoding="application/x-tex">K_{2}\leq 6\overline{A}\big(B(N_{\mathrm{mlp}}+1)\big)^{2L_{\mathrm{mlp}}+1}\leq 12HA\big(B(N_{\mathrm{mlp}}+1)\big)^{2L_{\mathrm{mlp}}+2}</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="A3.p20.2" class="ltx_p"><span id="A3.p20.2.1" class="ltx_text">(using that by assumption <math id="A3.p20.m3" class="ltx_Math" alttext="N\leq N_{\mathrm{mlp}}" display="inline" intent=":literal"><semantics><mrow><mi>N</mi><mo>≤</mo><msub><mi>N</mi><mi>mlp</mi></msub></mrow><annotation encoding="application/x-tex">N\leq N_{\mathrm{mlp}}</annotation></semantics></math>), and <math id="A3.p20.m4" class="ltx_Math" alttext="Q_{1}\leq 6HA^{2}B^{2}N^{3}" display="inline" intent=":literal"><semantics><mrow><msub><mi>Q</mi><mn>1</mn></msub><mo>≤</mo><mrow><mn>6</mn><mo lspace="0em" rspace="0em">​</mo><mi>H</mi><mo lspace="0em" rspace="0em">​</mo><msup><mi>A</mi><mn>2</mn></msup><mo lspace="0em" rspace="0em">​</mo><msup><mi>B</mi><mn>2</mn></msup><mo lspace="0em" rspace="0em">​</mo><msup><mi>N</mi><mn>3</mn></msup></mrow></mrow><annotation encoding="application/x-tex">Q_{1}\leq 6HA^{2}B^{2}N^{3}</annotation></semantics></math> (by (<a href="#A3.E41" title="In item (ii) ‣ Lemma 9. ‣ Appendix C Proofs for the Stochastic Error ‣ Generalization Bounds for Transformer-Based Next-Token Prediction in a Language Model" class="ltx_ref"><span class="ltx_text ltx_ref_tag">41</span></a>)). Because of <math id="A3.p20.m5" class="ltx_Math" alttext="L_{\mathrm{mlp}}\geq 1," display="inline" intent=":literal"><semantics><mrow><mrow><msub><mi>L</mi><mi>mlp</mi></msub><mo>≥</mo><mn>1</mn></mrow><mo>,</mo></mrow><annotation encoding="application/x-tex">L_{\mathrm{mlp}}\geq 1,</annotation></semantics></math> the bound (<a href="#A3.E45" title="In item (iii) ‣ Lemma 9. ‣ Appendix C Proofs for the Stochastic Error ‣ Generalization Bounds for Transformer-Based Next-Token Prediction in a Language Model" class="ltx_ref"><span class="ltx_text ltx_ref_tag">45</span></a>) follows now from</span></p>
<table id="A3.EGx71" class="ltx_equationgroup ltx_eqn_align ltx_eqn_table">

<tbody id="A3.Ex129"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_align_right ltx_eqn_cell"><math id="A3.Ex129.m1" class="ltx_Math" alttext="\displaystyle K_{2}+Q_{1}K_{1}" display="inline" intent=":literal"><semantics><mrow><msub><mi>K</mi><mn>2</mn></msub><mo>+</mo><mrow><msub><mi>Q</mi><mn>1</mn></msub><mo lspace="0em" rspace="0em">​</mo><msub><mi>K</mi><mn>1</mn></msub></mrow></mrow><annotation encoding="application/x-tex">\displaystyle K_{2}+Q_{1}K_{1}</annotation></semantics></math></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A3.Ex129.m2" class="ltx_Math" alttext="\displaystyle\leq 12HA\big(B(N_{\mathrm{mlp}}+1)\big)^{2L_{\mathrm{mlp}}+2}+(6HA^{2}B^{2}N^{3})(3HA^{3}BN^{3})" display="inline" intent=":literal"><semantics><mrow><mphantom></mphantom><mo>≤</mo><mrow><mrow><mn>12</mn><mo lspace="0em" rspace="0em">​</mo><mi>H</mi><mo lspace="0em" rspace="0em">​</mo><mi>A</mi><mo lspace="0em" rspace="0em">​</mo><msup><mrow><mo maxsize="1.200em" minsize="1.200em">(</mo><mrow><mi>B</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mrow><msub><mi>N</mi><mi>mlp</mi></msub><mo>+</mo><mn>1</mn></mrow><mo stretchy="false">)</mo></mrow></mrow><mo maxsize="1.200em" minsize="1.200em">)</mo></mrow><mrow><mrow><mn>2</mn><mo lspace="0em" rspace="0em">​</mo><msub><mi>L</mi><mi>mlp</mi></msub></mrow><mo>+</mo><mn>2</mn></mrow></msup></mrow><mo>+</mo><mrow><mrow><mo stretchy="false">(</mo><mrow><mn>6</mn><mo lspace="0em" rspace="0em">​</mo><mi>H</mi><mo lspace="0em" rspace="0em">​</mo><msup><mi>A</mi><mn>2</mn></msup><mo lspace="0em" rspace="0em">​</mo><msup><mi>B</mi><mn>2</mn></msup><mo lspace="0em" rspace="0em">​</mo><msup><mi>N</mi><mn>3</mn></msup></mrow><mo stretchy="false">)</mo></mrow><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mrow><mn>3</mn><mo lspace="0em" rspace="0em">​</mo><mi>H</mi><mo lspace="0em" rspace="0em">​</mo><msup><mi>A</mi><mn>3</mn></msup><mo lspace="0em" rspace="0em">​</mo><mi>B</mi><mo lspace="0em" rspace="0em">​</mo><msup><mi>N</mi><mn>3</mn></msup></mrow><mo stretchy="false">)</mo></mrow></mrow></mrow></mrow><annotation encoding="application/x-tex">\displaystyle\leq 12HA\big(B(N_{\mathrm{mlp}}+1)\big)^{2L_{\mathrm{mlp}}+2}+(6HA^{2}B^{2}N^{3})(3HA^{3}BN^{3})</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
<tbody id="A3.Ex130"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_eqn_cell"></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A3.Ex130.m1" class="ltx_Math" alttext="\displaystyle\leq 30H^{2}A^{5}\big(B(N_{\mathrm{mlp}}+1)\big)^{2L_{\mathrm{mlp}}+4}." display="inline" intent=":literal"><semantics><mrow><mrow><mphantom></mphantom><mo>≤</mo><mrow><mn>30</mn><mo lspace="0em" rspace="0em">​</mo><msup><mi>H</mi><mn>2</mn></msup><mo lspace="0em" rspace="0em">​</mo><msup><mi>A</mi><mn>5</mn></msup><mo lspace="0em" rspace="0em">​</mo><msup><mrow><mo maxsize="1.200em" minsize="1.200em">(</mo><mrow><mi>B</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mrow><msub><mi>N</mi><mi>mlp</mi></msub><mo>+</mo><mn>1</mn></mrow><mo stretchy="false">)</mo></mrow></mrow><mo maxsize="1.200em" minsize="1.200em">)</mo></mrow><mrow><mrow><mn>2</mn><mo lspace="0em" rspace="0em">​</mo><msub><mi>L</mi><mi>mlp</mi></msub></mrow><mo>+</mo><mn>4</mn></mrow></msup></mrow></mrow><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">\displaystyle\leq 30H^{2}A^{5}\big(B(N_{\mathrm{mlp}}+1)\big)^{2L_{\mathrm{mlp}}+4}.</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
</div>
<div id="A3.p21" class="ltx_para">
<p id="A3.p21.1" class="ltx_p"><span id="A3.p21.1.1" class="ltx_text">∎</span></p>
</div>
</div>
<div id="A3.p22" class="ltx_para">
<p id="A3.p22.1" class="ltx_p">The class of all maps <math id="A3.p22.m1" class="ltx_Math" alttext="\mathcal{F}_{0}\coloneq\{\mathbf{f}:(\mathcal{E}_{W})^{T}\rightarrow\Delta^{W-1}\}" display="inline" intent=":literal"><semantics><mrow><msub><mi class="ltx_font_mathcaligraphic">ℱ</mi><mn>0</mn></msub><mo>≔</mo><mrow><mo stretchy="false">{</mo><mi>𝐟</mi><mo lspace="0.278em" rspace="0.278em">:</mo><mrow><msup><mrow><mo stretchy="false">(</mo><msub><mi class="ltx_font_mathcaligraphic">ℰ</mi><mi>W</mi></msub><mo stretchy="false">)</mo></mrow><mi>T</mi></msup><mo stretchy="false">→</mo><msup><mi mathvariant="normal">Δ</mi><mrow><mi>W</mi><mo>−</mo><mn>1</mn></mrow></msup></mrow><mo stretchy="false">}</mo></mrow></mrow><annotation encoding="application/x-tex">\mathcal{F}_{0}\coloneq\{\mathbf{f}:(\mathcal{E}_{W})^{T}\rightarrow\Delta^{W-1}\}</annotation></semantics></math> has <math id="A3.p22.m2" class="ltx_Math" alttext="W^{T}" display="inline" intent=":literal"><semantics><msup><mi>W</mi><mi>T</mi></msup><annotation encoding="application/x-tex">W^{T}</annotation></semantics></math> possible inputs and maps inputs to a <math id="A3.p22.m3" class="ltx_Math" alttext="W" display="inline" intent=":literal"><semantics><mi>W</mi><annotation encoding="application/x-tex">W</annotation></semantics></math>-dimensional probability vector. If <math id="A3.p22.m4" class="ltx_Math" alttext="\mathcal{N}(\delta)" display="inline" intent=":literal"><semantics><mrow><mi class="ltx_font_mathcaligraphic">𝒩</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>δ</mi><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">\mathcal{N}(\delta)</annotation></semantics></math> denotes the covering number of <math id="A3.p22.m5" class="ltx_Math" alttext="\Delta^{W-1}" display="inline" intent=":literal"><semantics><msup><mi mathvariant="normal">Δ</mi><mrow><mi>W</mi><mo>−</mo><mn>1</mn></mrow></msup><annotation encoding="application/x-tex">\Delta^{W-1}</annotation></semantics></math> with sup-norm balls of radius <math id="A3.p22.m6" class="ltx_Math" alttext="\delta," display="inline" intent=":literal"><semantics><mrow><mi>δ</mi><mo>,</mo></mrow><annotation encoding="application/x-tex">\delta,</annotation></semantics></math> we have that <math id="A3.p22.m7" class="ltx_math_unparsed" alttext="\mathcal{N}(\delta,\mathcal{F}_{0},\|\cdot\|_{L^{\infty}((\mathcal{E}_{W})^{T})})=\mathcal{N}(\delta)^{W^{T}}" display="inline" intent=":literal"><semantics><mrow><mi class="ltx_font_mathcaligraphic">𝒩</mi><mrow><mo stretchy="false">(</mo><mi>δ</mi><mo>,</mo><msub><mi class="ltx_font_mathcaligraphic">ℱ</mi><mn>0</mn></msub><mo>,</mo><mo lspace="0em" rspace="0em">∥</mo><mo lspace="0em" rspace="0em">⋅</mo><msub><mo lspace="0em" rspace="0.167em">∥</mo><mrow><msup><mi>L</mi><mi mathvariant="normal">∞</mi></msup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msup><mrow><mo stretchy="false">(</mo><msub><mi class="ltx_font_mathcaligraphic">ℰ</mi><mi>W</mi></msub><mo stretchy="false">)</mo></mrow><mi>T</mi></msup><mo stretchy="false">)</mo></mrow></mrow></msub><mo stretchy="false">)</mo></mrow><mo>=</mo><mi class="ltx_font_mathcaligraphic">𝒩</mi><msup><mrow><mo stretchy="false">(</mo><mi>δ</mi><mo stretchy="false">)</mo></mrow><msup><mi>W</mi><mi>T</mi></msup></msup></mrow><annotation encoding="application/x-tex">\mathcal{N}(\delta,\mathcal{F}_{0},\|\cdot\|_{L^{\infty}((\mathcal{E}_{W})^{T})})=\mathcal{N}(\delta)^{W^{T}}</annotation></semantics></math> and <math id="A3.p22.m8" class="ltx_math_unparsed" alttext="\log\mathcal{N}(\delta,\mathcal{F}_{0},\|\cdot\|_{L^{\infty}((\mathcal{E}_{W})^{T})})=W^{T}\log\mathcal{N}(\delta)." display="inline" intent=":literal"><semantics><mrow><mi>log</mi><mi class="ltx_font_mathcaligraphic">𝒩</mi><mrow><mo stretchy="false">(</mo><mi>δ</mi><mo>,</mo><msub><mi class="ltx_font_mathcaligraphic">ℱ</mi><mn>0</mn></msub><mo>,</mo><mo lspace="0em" rspace="0em">∥</mo><mo lspace="0em" rspace="0em">⋅</mo><msub><mo lspace="0em" rspace="0.167em">∥</mo><mrow><msup><mi>L</mi><mi mathvariant="normal">∞</mi></msup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msup><mrow><mo stretchy="false">(</mo><msub><mi class="ltx_font_mathcaligraphic">ℰ</mi><mi>W</mi></msub><mo stretchy="false">)</mo></mrow><mi>T</mi></msup><mo stretchy="false">)</mo></mrow></mrow></msub><mo stretchy="false">)</mo></mrow><mo>=</mo><msup><mi>W</mi><mi>T</mi></msup><mi>log</mi><mi class="ltx_font_mathcaligraphic">𝒩</mi><mrow><mo stretchy="false">(</mo><mi>δ</mi><mo stretchy="false">)</mo></mrow><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">\log\mathcal{N}(\delta,\mathcal{F}_{0},\|\cdot\|_{L^{\infty}((\mathcal{E}_{W})^{T})})=W^{T}\log\mathcal{N}(\delta).</annotation></semantics></math></p>
</div>
<div id="A3.p23" class="ltx_para">
<p id="A3.p23.1" class="ltx_p">Compared to this bound, the following log covering bound for the transformer class depends only linearly on the vocabulary size <math id="A3.p23.m1" class="ltx_Math" alttext="W" display="inline" intent=":literal"><semantics><mi>W</mi><annotation encoding="application/x-tex">W</annotation></semantics></math> and is independent of the
document length <math id="A3.p23.m2" class="ltx_Math" alttext="T" display="inline" intent=":literal"><semantics><mi>T</mi><annotation encoding="application/x-tex">T</annotation></semantics></math>.
While transformers are still a flexible class, the comparison shows that they are a small subset within all possible maps from the <math id="A3.p23.m3" class="ltx_Math" alttext="T" display="inline" intent=":literal"><semantics><mi>T</mi><annotation encoding="application/x-tex">T</annotation></semantics></math> tokens to probability vectors.</p>
</div>
<div id="Thmconj210" class="ltx_theorem ltx_theorem_thm">
<h6 class="ltx_title ltx_runin ltx_title_theorem"><span class="ltx_tag ltx_tag_theorem"><span id="Thmconj210.4" class="ltx_text ltx_font_bold">Theorem 10</span></span><span id="Thmconj210.5" class="ltx_text ltx_font_bold"> </span>(Theorem <a href="#Thmconj23" title="Theorem 3. ‣ 4.1 Proof of the risk bound ‣ 4 Risk bound ‣ Generalization Bounds for Transformer-Based Next-Token Prediction in a Language Model" class="ltx_ref"><span class="ltx_text ltx_ref_tag">3</span></a>)<span id="Thmconj210.6" class="ltx_text ltx_font_bold">.</span></h6>
<div id="Thmconj210.p1" class="ltx_para">
<p id="Thmconj210.p1.1" class="ltx_p"><span id="Thmconj210.p1.1.1" class="ltx_text ltx_font_italic">Let <math id="Thmconj210.p1.m1" class="ltx_Math" alttext="A,B,L,L_{\mathrm{mlp}}\geq 1" display="inline" intent=":literal"><semantics><mrow><mi>A</mi><mo>,</mo><mi>B</mi><mo>,</mo><mi>L</mi><mo>,</mo><mrow><msub><mi>L</mi><mi>mlp</mi></msub><mo>≥</mo><mn>1</mn></mrow></mrow><annotation encoding="application/x-tex">A,B,L,L_{\mathrm{mlp}}\geq 1</annotation></semantics></math> and <math id="Thmconj210.p1.m2" class="ltx_Math" alttext="N\leq N_{\mathrm{mlp}}" display="inline" intent=":literal"><semantics><mrow><mi>N</mi><mo>≤</mo><msub><mi>N</mi><mi>mlp</mi></msub></mrow><annotation encoding="application/x-tex">N\leq N_{\mathrm{mlp}}</annotation></semantics></math>. For the transformer class introduced in Definition <a href="#S3.Thmconj7" title="Definition 3.7 (Transformer function class). ‣ 3 The transformer function class ‣ Generalization Bounds for Transformer-Based Next-Token Prediction in a Language Model" class="ltx_ref"><span class="ltx_text ltx_ref_tag">3.7</span></a> and any <math id="Thmconj210.p1.m3" class="ltx_Math" alttext="\delta&gt;0," display="inline" intent=":literal"><semantics><mrow><mrow><mi>δ</mi><mo>&gt;</mo><mn>0</mn></mrow><mo>,</mo></mrow><annotation encoding="application/x-tex">\delta&gt;0,</annotation></semantics></math></span></p>
<table id="A3.EGx72" class="ltx_equationgroup ltx_eqn_align ltx_eqn_table">

<tbody id="A3.Ex131"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_eqn_cell"></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A3.Ex131.m1" class="ltx_math_unparsed" alttext="\displaystyle\log\,\mathcal{N}\Big(\delta,\mathcal{T}\big(W,T,L,N,H,L_{\mathrm{mlp}},N_{\mathrm{mlp}},B\big),\|\cdot\|_{L^{\infty}((\mathcal{E}_{W})^{T})}\Big)" display="inline" intent=":literal"><semantics><mrow><mi>log</mi><mi class="ltx_font_mathcaligraphic">𝒩</mi><mrow><mo maxsize="1.600em" minsize="1.600em">(</mo><mi>δ</mi><mo>,</mo><mi class="ltx_font_mathcaligraphic">𝒯</mi><mrow><mo maxsize="1.200em" minsize="1.200em">(</mo><mi>W</mi><mo>,</mo><mi>T</mi><mo>,</mo><mi>L</mi><mo>,</mo><mi>N</mi><mo>,</mo><mi>H</mi><mo>,</mo><msub><mi>L</mi><mi>mlp</mi></msub><mo>,</mo><msub><mi>N</mi><mi>mlp</mi></msub><mo>,</mo><mi>B</mi><mo maxsize="1.200em" minsize="1.200em">)</mo></mrow><mo>,</mo><mo lspace="0em" rspace="0em">∥</mo><mo lspace="0em" rspace="0em">⋅</mo><msub><mo lspace="0em" rspace="0.167em">∥</mo><mrow><msup><mi>L</mi><mi mathvariant="normal">∞</mi></msup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msup><mrow><mo stretchy="false">(</mo><msub><mi class="ltx_font_mathcaligraphic">ℰ</mi><mi>W</mi></msub><mo stretchy="false">)</mo></mrow><mi>T</mi></msup><mo stretchy="false">)</mo></mrow></mrow></msub><mo maxsize="1.600em" minsize="1.600em">)</mo></mrow></mrow><annotation encoding="application/x-tex">\displaystyle\log\,\mathcal{N}\Big(\delta,\mathcal{T}\big(W,T,L,N,H,L_{\mathrm{mlp}},N_{\mathrm{mlp}},B\big),\|\cdot\|_{L^{\infty}((\mathcal{E}_{W})^{T})}\Big)</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
<tbody id="A3.Ex132"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_eqn_cell"></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A3.Ex132.m1" class="ltx_Math" alttext="\displaystyle\leq\Big(2WN+4HLN^{2}+3LL_{\mathrm{mlp}}N_{\mathrm{mlp}}^{2}\Big)\log\bigg(3+\frac{(6H)^{10L^{2}}\big(B(N_{\mathrm{mlp}}+1)\big)^{38L^{2}L_{\mathrm{mlp}}}B}{\delta}\bigg)." display="inline" intent=":literal"><semantics><mrow><mrow><mphantom></mphantom><mo>≤</mo><mrow><mrow><mo maxsize="1.600em" minsize="1.600em">(</mo><mrow><mrow><mn>2</mn><mo lspace="0em" rspace="0em">​</mo><mi>W</mi><mo lspace="0em" rspace="0em">​</mo><mi>N</mi></mrow><mo>+</mo><mrow><mn>4</mn><mo lspace="0em" rspace="0em">​</mo><mi>H</mi><mo lspace="0em" rspace="0em">​</mo><mi>L</mi><mo lspace="0em" rspace="0em">​</mo><msup><mi>N</mi><mn>2</mn></msup></mrow><mo>+</mo><mrow><mn>3</mn><mo lspace="0em" rspace="0em">​</mo><mi>L</mi><mo lspace="0em" rspace="0em">​</mo><msub><mi>L</mi><mi>mlp</mi></msub><mo lspace="0em" rspace="0em">​</mo><msubsup><mi>N</mi><mi>mlp</mi><mn>2</mn></msubsup></mrow></mrow><mo maxsize="1.600em" minsize="1.600em">)</mo></mrow><mo lspace="0.167em" rspace="0em">​</mo><mrow><mi>log</mi><mo>⁡</mo><mrow><mo maxsize="2.100em" minsize="2.100em">(</mo><mrow><mn>3</mn><mo>+</mo><mstyle displaystyle="true"><mfrac><mrow><msup><mrow><mo stretchy="false">(</mo><mrow><mn>6</mn><mo lspace="0em" rspace="0em">​</mo><mi>H</mi></mrow><mo stretchy="false">)</mo></mrow><mrow><mn>10</mn><mo lspace="0em" rspace="0em">​</mo><msup><mi>L</mi><mn>2</mn></msup></mrow></msup><mo lspace="0em" rspace="0em">​</mo><msup><mrow><mo maxsize="1.200em" minsize="1.200em">(</mo><mrow><mi>B</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mrow><msub><mi>N</mi><mi>mlp</mi></msub><mo>+</mo><mn>1</mn></mrow><mo stretchy="false">)</mo></mrow></mrow><mo maxsize="1.200em" minsize="1.200em">)</mo></mrow><mrow><mn>38</mn><mo lspace="0em" rspace="0em">​</mo><msup><mi>L</mi><mn>2</mn></msup><mo lspace="0em" rspace="0em">​</mo><msub><mi>L</mi><mi>mlp</mi></msub></mrow></msup><mo lspace="0em" rspace="0em">​</mo><mi>B</mi></mrow><mi>δ</mi></mfrac></mstyle></mrow><mo maxsize="2.100em" minsize="2.100em">)</mo></mrow></mrow></mrow></mrow><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">\displaystyle\leq\Big(2WN+4HLN^{2}+3LL_{\mathrm{mlp}}N_{\mathrm{mlp}}^{2}\Big)\log\bigg(3+\frac{(6H)^{10L^{2}}\big(B(N_{\mathrm{mlp}}+1)\big)^{38L^{2}L_{\mathrm{mlp}}}B}{\delta}\bigg).</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
</div>
</div>
<div id="A3.5" class="ltx_proof">
<h6 class="ltx_title ltx_runin ltx_font_italic ltx_title_proof">Proof.</h6>
<div id="A3.p24" class="ltx_para">
<p id="A3.p24.1" class="ltx_p"><span id="A3.p24.1.1" class="ltx_text">We aim to apply Lemma <a href="#Thmconj28" title="Lemma 8. ‣ Appendix C Proofs for the Stochastic Error ‣ Generalization Bounds for Transformer-Based Next-Token Prediction in a Language Model" class="ltx_ref"><span class="ltx_text ltx_ref_tag">8</span></a>. Recall that any element in this class is of the form</span></p>
<table id="A3.EGx73" class="ltx_equationgroup ltx_eqn_align ltx_eqn_table">

<tbody id="A3.Ex133"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_align_right ltx_eqn_cell"><math id="A3.Ex133.m1" class="ltx_math_unparsed" alttext="\displaystyle\mathbf{f}(X)=\Big(D\cdot\operatorname{TB}_{L}\circ\cdots\circ\operatorname{TB}_{1}(P+EX)\Big)_{:,T}" display="inline" intent=":literal"><semantics><mrow><mi>𝐟</mi><mrow><mo stretchy="false">(</mo><mi>X</mi><mo stretchy="false">)</mo></mrow><mo>=</mo><msub><mrow><mo maxsize="1.600em" minsize="1.600em">(</mo><mi>D</mi><mo lspace="0.222em" rspace="0.222em">⋅</mo><msub><mi>TB</mi><mi>L</mi></msub><mo lspace="0em">∘</mo><mo lspace="0.055em" rspace="0.055em">⋯</mo><mo rspace="0.222em">∘</mo><msub><mi>TB</mi><mn>1</mn></msub><mrow><mo stretchy="false">(</mo><mi>P</mi><mo>+</mo><mi>E</mi><mi>X</mi><mo stretchy="false">)</mo></mrow><mo maxsize="1.600em" minsize="1.600em">)</mo></mrow><mrow><mo rspace="0em">:</mo><mo>,</mo><mi>T</mi></mrow></msub></mrow><annotation encoding="application/x-tex">\displaystyle\mathbf{f}(X)=\Big(D\cdot\operatorname{TB}_{L}\circ\cdots\circ\operatorname{TB}_{1}(P+EX)\Big)_{:,T}</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="A3.p24.2" class="ltx_p"><span id="A3.p24.2.1" class="ltx_text">with parameter matrices <math id="A3.p24.m1" class="ltx_Math" alttext="E,D^{\top}\in[-B,B]^{N\times W}," display="inline" intent=":literal"><semantics><mrow><mrow><mi>E</mi><mo>,</mo><mrow><msup><mi>D</mi><mo>⊤</mo></msup><mo>∈</mo><msup><mrow><mo stretchy="false">[</mo><mrow><mrow><mo>−</mo><mi>B</mi></mrow><mo>,</mo><mi>B</mi></mrow><mo stretchy="false">]</mo></mrow><mrow><mi>N</mi><mo lspace="0.222em" rspace="0.222em">×</mo><mi>W</mi></mrow></msup></mrow></mrow><mo>,</mo></mrow><annotation encoding="application/x-tex">E,D^{\top}\in[-B,B]^{N\times W},</annotation></semantics></math>
<math id="A3.p24.m2" class="ltx_Math" alttext="P\in[-1,1]^{N\times T}" display="inline" intent=":literal"><semantics><mrow><mi>P</mi><mo>∈</mo><msup><mrow><mo stretchy="false">[</mo><mrow><mrow><mo>−</mo><mn>1</mn></mrow><mo>,</mo><mn>1</mn></mrow><mo stretchy="false">]</mo></mrow><mrow><mi>N</mi><mo lspace="0.222em" rspace="0.222em">×</mo><mi>T</mi></mrow></msup></mrow><annotation encoding="application/x-tex">P\in[-1,1]^{N\times T}</annotation></semantics></math> a fixed matrix introduced in Definition <a href="#S3.Thmconj6" title="Definition 3.6 (Positional encoding). ‣ 3 The transformer function class ‣ Generalization Bounds for Transformer-Based Next-Token Prediction in a Language Model" class="ltx_ref"><span class="ltx_text ltx_ref_tag">3.6</span></a>, and for each <math id="A3.p24.m3" class="ltx_Math" alttext="\ell=1,\ldots,L," display="inline" intent=":literal"><semantics><mrow><mrow><mrow><mi mathvariant="normal">ℓ</mi><mo>=</mo><mn>1</mn></mrow><mo>,</mo><mi mathvariant="normal">…</mi><mo>,</mo><mi>L</mi></mrow><mo>,</mo></mrow><annotation encoding="application/x-tex">\ell=1,\ldots,L,</annotation></semantics></math>
<math id="A3.p24.m4" class="ltx_Math" alttext="\operatorname{TB}_{\ell}\in\mathcal{TB}(N,H,L_{\mathrm{mlp}},N_{\mathrm{mlp}},B)." display="inline" intent=":literal"><semantics><mrow><mrow><msub><mi>TB</mi><mi mathvariant="normal">ℓ</mi></msub><mo>∈</mo><mrow><mi class="ltx_font_mathcaligraphic">𝒯</mi><mo lspace="0em" rspace="0em">​</mo><mi class="ltx_font_mathcaligraphic">ℬ</mi><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>N</mi><mo>,</mo><mi>H</mi><mo>,</mo><msub><mi>L</mi><mi>mlp</mi></msub><mo>,</mo><msub><mi>N</mi><mi>mlp</mi></msub><mo>,</mo><mi>B</mi><mo stretchy="false">)</mo></mrow></mrow></mrow><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">\operatorname{TB}_{\ell}\in\mathcal{TB}(N,H,L_{\mathrm{mlp}},N_{\mathrm{mlp}},B).</annotation></semantics></math>
We apply Lemma <a href="#Thmconj28" title="Lemma 8. ‣ Appendix C Proofs for the Stochastic Error ‣ Generalization Bounds for Transformer-Based Next-Token Prediction in a Language Model" class="ltx_ref"><span class="ltx_text ltx_ref_tag">8</span></a> with <math id="A3.p24.m5" class="ltx_Math" alttext="q=L+2," display="inline" intent=":literal"><semantics><mrow><mrow><mi>q</mi><mo>=</mo><mrow><mi>L</mi><mo>+</mo><mn>2</mn></mrow></mrow><mo>,</mo></mrow><annotation encoding="application/x-tex">q=L+2,</annotation></semantics></math> by interpreting the structure as a composition of <math id="A3.p24.m6" class="ltx_Math" alttext="L+2" display="inline" intent=":literal"><semantics><mrow><mi>L</mi><mo>+</mo><mn>2</mn></mrow><annotation encoding="application/x-tex">L+2</annotation></semantics></math> functions, namely <math id="A3.p24.m7" class="ltx_Math" alttext="P+EX,\operatorname{TB}_{1},\ldots,\operatorname{TB}_{L},D." display="inline" intent=":literal"><semantics><mrow><mrow><mrow><mi>P</mi><mo>+</mo><mrow><mi>E</mi><mo lspace="0em" rspace="0em">​</mo><mi>X</mi></mrow></mrow><mo>,</mo><msub><mi>TB</mi><mn>1</mn></msub><mo>,</mo><mi mathvariant="normal">…</mi><mo>,</mo><msub><mi>TB</mi><mi>L</mi></msub><mo>,</mo><mi>D</mi></mrow><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">P+EX,\operatorname{TB}_{1},\ldots,\operatorname{TB}_{L},D.</annotation></semantics></math>
We ignore the <math id="A3.p24.m8" class="ltx_math_unparsed" alttext="(\,\cdot\,)_{:,T}" display="inline" intent=":literal"><semantics><msub><mrow><mo stretchy="false">(</mo><mo>⋅</mo><mo stretchy="false">)</mo></mrow><mrow><mo rspace="0em">:</mo><mo>,</mo><mi>T</mi></mrow></msub><annotation encoding="application/x-tex">(\,\cdot\,)_{:,T}</annotation></semantics></math> operator, as it does not increase the covering number.
For all of these layers, we need to bound the Lipschitz constant with respect to the parameters. This will then provide us with bounds for the quantities <math id="A3.p24.m9" class="ltx_Math" alttext="K_{1},\ldots,K_{L+2}" display="inline" intent=":literal"><semantics><mrow><msub><mi>K</mi><mn>1</mn></msub><mo>,</mo><mi mathvariant="normal">…</mi><mo>,</mo><msub><mi>K</mi><mrow><mi>L</mi><mo>+</mo><mn>2</mn></mrow></msub></mrow><annotation encoding="application/x-tex">K_{1},\ldots,K_{L+2}</annotation></semantics></math> defined in Lemma <a href="#Thmconj28" title="Lemma 8. ‣ Appendix C Proofs for the Stochastic Error ‣ Generalization Bounds for Transformer-Based Next-Token Prediction in a Language Model" class="ltx_ref"><span class="ltx_text ltx_ref_tag">8</span></a>. For all layers except for the first layer, we also need to bound the Lipschitz constant with respect to the inputs. This will then provide us with bounds for the quantities <math id="A3.p24.m10" class="ltx_Math" alttext="Q_{2},\ldots,Q_{L+2}" display="inline" intent=":literal"><semantics><mrow><msub><mi>Q</mi><mn>2</mn></msub><mo>,</mo><mi mathvariant="normal">…</mi><mo>,</mo><msub><mi>Q</mi><mrow><mi>L</mi><mo>+</mo><mn>2</mn></mrow></msub></mrow><annotation encoding="application/x-tex">Q_{2},\ldots,Q_{L+2}</annotation></semantics></math> defined in Lemma <a href="#Thmconj28" title="Lemma 8. ‣ Appendix C Proofs for the Stochastic Error ‣ Generalization Bounds for Transformer-Based Next-Token Prediction in a Language Model" class="ltx_ref"><span class="ltx_text ltx_ref_tag">8</span></a>. The result follows then by applying (<a href="#A3.E36" title="In Appendix C Proofs for the Stochastic Error ‣ Generalization Bounds for Transformer-Based Next-Token Prediction in a Language Model" class="ltx_ref"><span class="ltx_text ltx_ref_tag">36</span></a>).</span></p>
</div>
<div id="A3.p25" class="ltx_para">
<p id="A3.p25.1" class="ltx_p"><span id="A3.p25.1.1" class="ltx_text">Let <math id="A3.p25.m1" class="ltx_Math" alttext="X\in(\mathcal{E}_{W})^{T}\subset[0,1]^{W\times T}." display="inline" intent=":literal"><semantics><mrow><mrow><mi>X</mi><mo>∈</mo><msup><mrow><mo stretchy="false">(</mo><msub><mi class="ltx_font_mathcaligraphic">ℰ</mi><mi>W</mi></msub><mo stretchy="false">)</mo></mrow><mi>T</mi></msup><mo>⊂</mo><msup><mrow><mo stretchy="false">[</mo><mrow><mn>0</mn><mo>,</mo><mn>1</mn></mrow><mo stretchy="false">]</mo></mrow><mrow><mi>W</mi><mo lspace="0.222em" rspace="0.222em">×</mo><mi>T</mi></mrow></msup></mrow><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">X\in(\mathcal{E}_{W})^{T}\subset[0,1]^{W\times T}.</annotation></semantics></math> Then, <math id="A3.p25.m2" class="ltx_Math" alttext="P+EX\in[-B-1,B+1]^{N\times T}" display="inline" intent=":literal"><semantics><mrow><mrow><mi>P</mi><mo>+</mo><mrow><mi>E</mi><mo lspace="0em" rspace="0em">​</mo><mi>X</mi></mrow></mrow><mo>∈</mo><msup><mrow><mo stretchy="false">[</mo><mrow><mrow><mrow><mo>−</mo><mi>B</mi></mrow><mo>−</mo><mn>1</mn></mrow><mo>,</mo><mrow><mi>B</mi><mo>+</mo><mn>1</mn></mrow></mrow><mo stretchy="false">]</mo></mrow><mrow><mi>N</mi><mo lspace="0.222em" rspace="0.222em">×</mo><mi>T</mi></mrow></msup></mrow><annotation encoding="application/x-tex">P+EX\in[-B-1,B+1]^{N\times T}</annotation></semantics></math> and by using (<a href="#A3.E43" title="In item (iii) ‣ Lemma 9. ‣ Appendix C Proofs for the Stochastic Error ‣ Generalization Bounds for Transformer-Based Next-Token Prediction in a Language Model" class="ltx_ref"><span class="ltx_text ltx_ref_tag">43</span></a>), for any <math id="A3.p25.m3" class="ltx_Math" alttext="\ell=1,\ldots,L" display="inline" intent=":literal"><semantics><mrow><mrow><mi mathvariant="normal">ℓ</mi><mo>=</mo><mn>1</mn></mrow><mo>,</mo><mi mathvariant="normal">…</mi><mo>,</mo><mi>L</mi></mrow><annotation encoding="application/x-tex">\ell=1,\ldots,L</annotation></semantics></math></span></p>
<table id="A3.EGx74" class="ltx_equationgroup ltx_eqn_align ltx_eqn_table">

<tbody id="A3.Ex134"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_align_right ltx_eqn_cell"><math id="A3.Ex134.m1" class="ltx_math_unparsed" alttext="\displaystyle\operatorname{TB}_{\ell}\circ\cdots\circ\operatorname{TB}_{1}(P+EX):(\mathcal{E}_{W})^{T}\rightarrow[-A_{\ell+1},A_{\ell+1}]^{N\times T}" display="inline" intent=":literal"><semantics><mrow><msub><mi>TB</mi><mi mathvariant="normal">ℓ</mi></msub><mo lspace="0em">∘</mo><mo lspace="0.055em" rspace="0.055em">⋯</mo><mo rspace="0.222em">∘</mo><msub><mi>TB</mi><mn>1</mn></msub><mrow><mo stretchy="false">(</mo><mi>P</mi><mo>+</mo><mi>E</mi><mi>X</mi><mo rspace="0.278em" stretchy="false">)</mo></mrow><mo rspace="0.278em">:</mo><msup><mrow><mo stretchy="false">(</mo><msub><mi class="ltx_font_mathcaligraphic">ℰ</mi><mi>W</mi></msub><mo stretchy="false">)</mo></mrow><mi>T</mi></msup><mo stretchy="false">→</mo><msup><mrow><mo stretchy="false">[</mo><mo lspace="0em">−</mo><msub><mi>A</mi><mrow><mi mathvariant="normal">ℓ</mi><mo>+</mo><mn>1</mn></mrow></msub><mo>,</mo><msub><mi>A</mi><mrow><mi mathvariant="normal">ℓ</mi><mo>+</mo><mn>1</mn></mrow></msub><mo stretchy="false">]</mo></mrow><mrow><mi>N</mi><mo lspace="0.222em" rspace="0.222em">×</mo><mi>T</mi></mrow></msup></mrow><annotation encoding="application/x-tex">\displaystyle\operatorname{TB}_{\ell}\circ\cdots\circ\operatorname{TB}_{1}(P+EX):(\mathcal{E}_{W})^{T}\rightarrow[-A_{\ell+1},A_{\ell+1}]^{N\times T}</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="A3.p25.2" class="ltx_p"><span id="A3.p25.2.1" class="ltx_text">with</span></p>
<table id="A3.EGx75" class="ltx_equationgroup ltx_eqn_align ltx_eqn_table">

<tbody id="A3.E47"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_align_right ltx_eqn_cell"><math id="A3.E47.m1" class="ltx_Math" alttext="\displaystyle A_{\ell+1}\coloneq(B+1)\Big(2H\big(B(N_{\mathrm{mlp}}+1)\big)^{L_{\mathrm{mlp}}+2}\Big)^{\ell}." display="inline" intent=":literal"><semantics><mrow><mrow><msub><mi>A</mi><mrow><mi mathvariant="normal">ℓ</mi><mo>+</mo><mn>1</mn></mrow></msub><mo>≔</mo><mrow><mrow><mo stretchy="false">(</mo><mrow><mi>B</mi><mo>+</mo><mn>1</mn></mrow><mo stretchy="false">)</mo></mrow><mo lspace="0em" rspace="0em">​</mo><msup><mrow><mo maxsize="1.600em" minsize="1.600em">(</mo><mrow><mn>2</mn><mo lspace="0em" rspace="0em">​</mo><mi>H</mi><mo lspace="0em" rspace="0em">​</mo><msup><mrow><mo maxsize="1.200em" minsize="1.200em">(</mo><mrow><mi>B</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mrow><msub><mi>N</mi><mi>mlp</mi></msub><mo>+</mo><mn>1</mn></mrow><mo stretchy="false">)</mo></mrow></mrow><mo maxsize="1.200em" minsize="1.200em">)</mo></mrow><mrow><msub><mi>L</mi><mi>mlp</mi></msub><mo>+</mo><mn>2</mn></mrow></msup></mrow><mo maxsize="1.600em" minsize="1.600em">)</mo></mrow><mi mathvariant="normal">ℓ</mi></msup></mrow></mrow><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">\displaystyle A_{\ell+1}\coloneq(B+1)\Big(2H\big(B(N_{\mathrm{mlp}}+1)\big)^{L_{\mathrm{mlp}}+2}\Big)^{\ell}.</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td>
<td rowspan="1" class="ltx_eqn_cell ltx_eqn_eqno ltx_align_middle ltx_align_right"><span class="ltx_tag ltx_tag_equation ltx_align_right">(47)</span></td></tr></tbody>
</table>
</div>
<div id="A3.p26" class="ltx_para">
<p id="A3.p26.1" class="ltx_p"><span id="A3.p26.1.1" class="ltx_text">For any <math id="A3.p26.m1" class="ltx_Math" alttext="X\in(\mathcal{E}_{W})^{T}," display="inline" intent=":literal"><semantics><mrow><mrow><mi>X</mi><mo>∈</mo><msup><mrow><mo stretchy="false">(</mo><msub><mi class="ltx_font_mathcaligraphic">ℰ</mi><mi>W</mi></msub><mo stretchy="false">)</mo></mrow><mi>T</mi></msup></mrow><mo>,</mo></mrow><annotation encoding="application/x-tex">X\in(\mathcal{E}_{W})^{T},</annotation></semantics></math> and any matrices <math id="A3.p26.m2" class="ltx_Math" alttext="E,E^{\prime}\in[-B,B]^{N\times W}," display="inline" intent=":literal"><semantics><mrow><mrow><mi>E</mi><mo>,</mo><mrow><msup><mi>E</mi><mo>′</mo></msup><mo>∈</mo><msup><mrow><mo stretchy="false">[</mo><mrow><mrow><mo>−</mo><mi>B</mi></mrow><mo>,</mo><mi>B</mi></mrow><mo stretchy="false">]</mo></mrow><mrow><mi>N</mi><mo lspace="0.222em" rspace="0.222em">×</mo><mi>W</mi></mrow></msup></mrow></mrow><mo>,</mo></mrow><annotation encoding="application/x-tex">E,E^{\prime}\in[-B,B]^{N\times W},</annotation></semantics></math> we have <math id="A3.p26.m3" class="ltx_Math" alttext="\|P+EX-(P+E^{\prime}X)\|_{\infty}\leq\|E-E^{\prime}\|_{\infty}." display="inline" intent=":literal"><semantics><mrow><mrow><msub><mrow><mo stretchy="false">‖</mo><mrow><mrow><mi>P</mi><mo>+</mo><mrow><mi>E</mi><mo lspace="0em" rspace="0em">​</mo><mi>X</mi></mrow></mrow><mo>−</mo><mrow><mo stretchy="false">(</mo><mrow><mi>P</mi><mo>+</mo><mrow><msup><mi>E</mi><mo>′</mo></msup><mo lspace="0em" rspace="0em">​</mo><mi>X</mi></mrow></mrow><mo stretchy="false">)</mo></mrow></mrow><mo stretchy="false">‖</mo></mrow><mi mathvariant="normal">∞</mi></msub><mo>≤</mo><msub><mrow><mo stretchy="false">‖</mo><mrow><mi>E</mi><mo>−</mo><msup><mi>E</mi><mo>′</mo></msup></mrow><mo stretchy="false">‖</mo></mrow><mi mathvariant="normal">∞</mi></msub></mrow><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">\|P+EX-(P+E^{\prime}X)\|_{\infty}\leq\|E-E^{\prime}\|_{\infty}.</annotation></semantics></math> Thus, <math id="A3.p26.m4" class="ltx_Math" alttext="K_{1}\leq 1." display="inline" intent=":literal"><semantics><mrow><mrow><msub><mi>K</mi><mn>1</mn></msub><mo>≤</mo><mn>1</mn></mrow><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">K_{1}\leq 1.</annotation></semantics></math></span></p>
</div>
<div id="A3.p27" class="ltx_para">
<p id="A3.p27.1" class="ltx_p"><span id="A3.p27.1.1" class="ltx_text">Replacing <math id="A3.p27.m1" class="ltx_Math" alttext="A" display="inline" intent=":literal"><semantics><mi>A</mi><annotation encoding="application/x-tex">A</annotation></semantics></math> in (<a href="#A3.E45" title="In item (iii) ‣ Lemma 9. ‣ Appendix C Proofs for the Stochastic Error ‣ Generalization Bounds for Transformer-Based Next-Token Prediction in a Language Model" class="ltx_ref"><span class="ltx_text ltx_ref_tag">45</span></a>) by <math id="A3.p27.m2" class="ltx_Math" alttext="A_{\ell-1}," display="inline" intent=":literal"><semantics><mrow><msub><mi>A</mi><mrow><mi mathvariant="normal">ℓ</mi><mo>−</mo><mn>1</mn></mrow></msub><mo>,</mo></mrow><annotation encoding="application/x-tex">A_{\ell-1},</annotation></semantics></math> we obtain that</span></p>
<table id="A3.EGx76" class="ltx_equationgroup ltx_eqn_align ltx_eqn_table">

<tbody id="A3.Ex135"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_align_right ltx_eqn_cell"><math id="A3.Ex135.m1" class="ltx_math_unparsed" alttext="\displaystyle K_{\ell}\leq 30H^{2}A_{L+1}^{5}\big(B(N_{\mathrm{mlp}}+1)\big)^{6L_{\mathrm{mlp}}},\quad\ell=2,\ldots,L+1," display="inline" intent=":literal"><semantics><mrow><msub><mi>K</mi><mi mathvariant="normal">ℓ</mi></msub><mo>≤</mo><mn>30</mn><msup><mi>H</mi><mn>2</mn></msup><msubsup><mi>A</mi><mrow><mi>L</mi><mo>+</mo><mn>1</mn></mrow><mn>5</mn></msubsup><msup><mrow><mo maxsize="1.200em" minsize="1.200em">(</mo><mi>B</mi><mrow><mo stretchy="false">(</mo><msub><mi>N</mi><mi>mlp</mi></msub><mo>+</mo><mn>1</mn><mo stretchy="false">)</mo></mrow><mo maxsize="1.200em" minsize="1.200em">)</mo></mrow><mrow><mn>6</mn><mo lspace="0em" rspace="0em">​</mo><msub><mi>L</mi><mi>mlp</mi></msub></mrow></msup><mo rspace="1.167em">,</mo><mi mathvariant="normal">ℓ</mi><mo>=</mo><mn>2</mn><mo>,</mo><mi mathvariant="normal">…</mi><mo>,</mo><mi>L</mi><mo>+</mo><mn>1</mn><mo>,</mo></mrow><annotation encoding="application/x-tex">\displaystyle K_{\ell}\leq 30H^{2}A_{L+1}^{5}\big(B(N_{\mathrm{mlp}}+1)\big)^{6L_{\mathrm{mlp}}},\quad\ell=2,\ldots,L+1,</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="A3.p27.2" class="ltx_p"><span id="A3.p27.2.1" class="ltx_text">and by (<a href="#A3.E44" title="In item (iii) ‣ Lemma 9. ‣ Appendix C Proofs for the Stochastic Error ‣ Generalization Bounds for Transformer-Based Next-Token Prediction in a Language Model" class="ltx_ref"><span class="ltx_text ltx_ref_tag">44</span></a>),</span></p>
<table id="A3.EGx77" class="ltx_equationgroup ltx_eqn_align ltx_eqn_table">

<tbody id="A3.Ex136"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_align_right ltx_eqn_cell"><math id="A3.Ex136.m1" class="ltx_math_unparsed" alttext="\displaystyle Q_{\ell}\leq 6HA_{L+1}^{2}\big(BN_{\mathrm{mlp}}\big)^{4L_{\mathrm{mlp}}},\quad\ell=2,\ldots,L+1." display="inline" intent=":literal"><semantics><mrow><msub><mi>Q</mi><mi mathvariant="normal">ℓ</mi></msub><mo>≤</mo><mn>6</mn><mi>H</mi><msubsup><mi>A</mi><mrow><mi>L</mi><mo>+</mo><mn>1</mn></mrow><mn>2</mn></msubsup><msup><mrow><mo maxsize="1.200em" minsize="1.200em">(</mo><mi>B</mi><msub><mi>N</mi><mi>mlp</mi></msub><mo maxsize="1.200em" minsize="1.200em">)</mo></mrow><mrow><mn>4</mn><mo lspace="0em" rspace="0em">​</mo><msub><mi>L</mi><mi>mlp</mi></msub></mrow></msup><mo rspace="1.167em">,</mo><mi mathvariant="normal">ℓ</mi><mo>=</mo><mn>2</mn><mo>,</mo><mi mathvariant="normal">…</mi><mo>,</mo><mi>L</mi><mo>+</mo><mn>1</mn><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">\displaystyle Q_{\ell}\leq 6HA_{L+1}^{2}\big(BN_{\mathrm{mlp}}\big)^{4L_{\mathrm{mlp}}},\quad\ell=2,\ldots,L+1.</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="A3.p27.3" class="ltx_p"><span id="A3.p27.3.1" class="ltx_text">Whenever <math id="A3.p27.m3" class="ltx_Math" alttext="D,D^{\prime}\in[-B,B]^{W\times N}" display="inline" intent=":literal"><semantics><mrow><mi>D</mi><mo>,</mo><mrow><msup><mi>D</mi><mo>′</mo></msup><mo>∈</mo><msup><mrow><mo stretchy="false">[</mo><mrow><mrow><mo>−</mo><mi>B</mi></mrow><mo>,</mo><mi>B</mi></mrow><mo stretchy="false">]</mo></mrow><mrow><mi>W</mi><mo lspace="0.222em" rspace="0.222em">×</mo><mi>N</mi></mrow></msup></mrow></mrow><annotation encoding="application/x-tex">D,D^{\prime}\in[-B,B]^{W\times N}</annotation></semantics></math> and <math id="A3.p27.m4" class="ltx_Math" alttext="U\in\mathbb{R}^{N\times T}," display="inline" intent=":literal"><semantics><mrow><mrow><mi>U</mi><mo>∈</mo><msup><mi>ℝ</mi><mrow><mi>N</mi><mo lspace="0.222em" rspace="0.222em">×</mo><mi>T</mi></mrow></msup></mrow><mo>,</mo></mrow><annotation encoding="application/x-tex">U\in\mathbb{R}^{N\times T},</annotation></semantics></math> we obtain <math id="A3.p27.m5" class="ltx_Math" alttext="\|DU-D^{\prime}U\|_{\infty}\leq N\|U\|_{\infty}\|D-D^{\prime}\|_{\infty}." display="inline" intent=":literal"><semantics><mrow><mrow><msub><mrow><mo stretchy="false">‖</mo><mrow><mrow><mi>D</mi><mo lspace="0em" rspace="0em">​</mo><mi>U</mi></mrow><mo>−</mo><mrow><msup><mi>D</mi><mo>′</mo></msup><mo lspace="0em" rspace="0em">​</mo><mi>U</mi></mrow></mrow><mo stretchy="false">‖</mo></mrow><mi mathvariant="normal">∞</mi></msub><mo>≤</mo><mrow><mi>N</mi><mo lspace="0em" rspace="0em">​</mo><msub><mrow><mo stretchy="false">‖</mo><mi>U</mi><mo stretchy="false">‖</mo></mrow><mi mathvariant="normal">∞</mi></msub><mo lspace="0em" rspace="0em">​</mo><msub><mrow><mo stretchy="false">‖</mo><mrow><mi>D</mi><mo>−</mo><msup><mi>D</mi><mo>′</mo></msup></mrow><mo stretchy="false">‖</mo></mrow><mi mathvariant="normal">∞</mi></msub></mrow></mrow><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">\|DU-D^{\prime}U\|_{\infty}\leq N\|U\|_{\infty}\|D-D^{\prime}\|_{\infty}.</annotation></semantics></math> Thus, <math id="A3.p27.m6" class="ltx_Math" alttext="K_{L+2}\leq NA_{L+1}\leq N_{\mathrm{mlp}}A_{L+1}." display="inline" intent=":literal"><semantics><mrow><mrow><msub><mi>K</mi><mrow><mi>L</mi><mo>+</mo><mn>2</mn></mrow></msub><mo>≤</mo><mrow><mi>N</mi><mo lspace="0em" rspace="0em">​</mo><msub><mi>A</mi><mrow><mi>L</mi><mo>+</mo><mn>1</mn></mrow></msub></mrow><mo>≤</mo><mrow><msub><mi>N</mi><mi>mlp</mi></msub><mo lspace="0em" rspace="0em">​</mo><msub><mi>A</mi><mrow><mi>L</mi><mo>+</mo><mn>1</mn></mrow></msub></mrow></mrow><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">K_{L+2}\leq NA_{L+1}\leq N_{\mathrm{mlp}}A_{L+1}.</annotation></semantics></math></span></p>
</div>
<div id="A3.p28" class="ltx_para">
<p id="A3.p28.1" class="ltx_p"><span id="A3.p28.1.1" class="ltx_text">For the Lipschitz constant of the output layer with respect to the inputs, observe that for <math id="A3.p28.m1" class="ltx_Math" alttext="D\in[-B,B]^{W\times N}" display="inline" intent=":literal"><semantics><mrow><mi>D</mi><mo>∈</mo><msup><mrow><mo stretchy="false">[</mo><mrow><mrow><mo>−</mo><mi>B</mi></mrow><mo>,</mo><mi>B</mi></mrow><mo stretchy="false">]</mo></mrow><mrow><mi>W</mi><mo lspace="0.222em" rspace="0.222em">×</mo><mi>N</mi></mrow></msup></mrow><annotation encoding="application/x-tex">D\in[-B,B]^{W\times N}</annotation></semantics></math> and <math id="A3.p28.m2" class="ltx_Math" alttext="U,U^{\prime}\in\mathbb{R}^{N\times T}," display="inline" intent=":literal"><semantics><mrow><mrow><mi>U</mi><mo>,</mo><mrow><msup><mi>U</mi><mo>′</mo></msup><mo>∈</mo><msup><mi>ℝ</mi><mrow><mi>N</mi><mo lspace="0.222em" rspace="0.222em">×</mo><mi>T</mi></mrow></msup></mrow></mrow><mo>,</mo></mrow><annotation encoding="application/x-tex">U,U^{\prime}\in\mathbb{R}^{N\times T},</annotation></semantics></math> <math id="A3.p28.m3" class="ltx_Math" alttext="\|DU-DU^{\prime}\|_{\infty}\leq N\|D\|_{\infty}\|U-U^{\prime}\|_{\infty}\leq NB\|U-U^{\prime}\|_{\infty}." display="inline" intent=":literal"><semantics><mrow><mrow><msub><mrow><mo stretchy="false">‖</mo><mrow><mrow><mi>D</mi><mo lspace="0em" rspace="0em">​</mo><mi>U</mi></mrow><mo>−</mo><mrow><mi>D</mi><mo lspace="0em" rspace="0em">​</mo><msup><mi>U</mi><mo>′</mo></msup></mrow></mrow><mo stretchy="false">‖</mo></mrow><mi mathvariant="normal">∞</mi></msub><mo>≤</mo><mrow><mi>N</mi><mo lspace="0em" rspace="0em">​</mo><msub><mrow><mo stretchy="false">‖</mo><mi>D</mi><mo stretchy="false">‖</mo></mrow><mi mathvariant="normal">∞</mi></msub><mo lspace="0em" rspace="0em">​</mo><msub><mrow><mo stretchy="false">‖</mo><mrow><mi>U</mi><mo>−</mo><msup><mi>U</mi><mo>′</mo></msup></mrow><mo stretchy="false">‖</mo></mrow><mi mathvariant="normal">∞</mi></msub></mrow><mo>≤</mo><mrow><mi>N</mi><mo lspace="0em" rspace="0em">​</mo><mi>B</mi><mo lspace="0em" rspace="0em">​</mo><msub><mrow><mo stretchy="false">‖</mo><mrow><mi>U</mi><mo>−</mo><msup><mi>U</mi><mo>′</mo></msup></mrow><mo stretchy="false">‖</mo></mrow><mi mathvariant="normal">∞</mi></msub></mrow></mrow><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">\|DU-DU^{\prime}\|_{\infty}\leq N\|D\|_{\infty}\|U-U^{\prime}\|_{\infty}\leq NB\|U-U^{\prime}\|_{\infty}.</annotation></semantics></math> Hence <math id="A3.p28.m4" class="ltx_Math" alttext="Q_{L+2}\leq BN\leq BN_{\mathrm{mlp}}." display="inline" intent=":literal"><semantics><mrow><mrow><msub><mi>Q</mi><mrow><mi>L</mi><mo>+</mo><mn>2</mn></mrow></msub><mo>≤</mo><mrow><mi>B</mi><mo lspace="0em" rspace="0em">​</mo><mi>N</mi></mrow><mo>≤</mo><mrow><mi>B</mi><mo lspace="0em" rspace="0em">​</mo><msub><mi>N</mi><mi>mlp</mi></msub></mrow></mrow><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">Q_{L+2}\leq BN\leq BN_{\mathrm{mlp}}.</annotation></semantics></math></span></p>
</div>
<div id="A3.p29" class="ltx_para">
<p id="A3.p29.1" class="ltx_p"><span id="A3.p29.1.1" class="ltx_text">Using that for any <math id="A3.p29.m1" class="ltx_Math" alttext="y\geq 2," display="inline" intent=":literal"><semantics><mrow><mrow><mi>y</mi><mo>≥</mo><mn>2</mn></mrow><mo>,</mo></mrow><annotation encoding="application/x-tex">y\geq 2,</annotation></semantics></math> <math id="A3.p29.m2" class="ltx_Math" alttext="\sum_{r=0}^{L}y^{r}\leq 2y^{L}," display="inline" intent=":literal"><semantics><mrow><mrow><mrow><msubsup><mo>∑</mo><mrow><mi>r</mi><mo>=</mo><mn>0</mn></mrow><mi>L</mi></msubsup><msup><mi>y</mi><mi>r</mi></msup></mrow><mo>≤</mo><mrow><mn>2</mn><mo lspace="0em" rspace="0em">​</mo><msup><mi>y</mi><mi>L</mi></msup></mrow></mrow><mo>,</mo></mrow><annotation encoding="application/x-tex">\sum_{r=0}^{L}y^{r}\leq 2y^{L},</annotation></semantics></math> <math id="A3.p29.m3" class="ltx_Math" alttext="A_{L+1}=(B+1)(2H(B(N_{\mathrm{mlp}}+1))^{L_{\mathrm{mlp}}+2})^{L}," display="inline" intent=":literal"><semantics><mrow><mrow><msub><mi>A</mi><mrow><mi>L</mi><mo>+</mo><mn>1</mn></mrow></msub><mo>=</mo><mrow><mrow><mo stretchy="false">(</mo><mrow><mi>B</mi><mo>+</mo><mn>1</mn></mrow><mo stretchy="false">)</mo></mrow><mo lspace="0em" rspace="0em">​</mo><msup><mrow><mo stretchy="false">(</mo><mrow><mn>2</mn><mo lspace="0em" rspace="0em">​</mo><mi>H</mi><mo lspace="0em" rspace="0em">​</mo><msup><mrow><mo stretchy="false">(</mo><mrow><mi>B</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mrow><msub><mi>N</mi><mi>mlp</mi></msub><mo>+</mo><mn>1</mn></mrow><mo stretchy="false">)</mo></mrow></mrow><mo stretchy="false">)</mo></mrow><mrow><msub><mi>L</mi><mi>mlp</mi></msub><mo>+</mo><mn>2</mn></mrow></msup></mrow><mo stretchy="false">)</mo></mrow><mi>L</mi></msup></mrow></mrow><mo>,</mo></mrow><annotation encoding="application/x-tex">A_{L+1}=(B+1)(2H(B(N_{\mathrm{mlp}}+1))^{L_{\mathrm{mlp}}+2})^{L},</annotation></semantics></math> and <math id="A3.p29.m4" class="ltx_Math" alttext="L,L_{\mathrm{mlp}}\geq 1," display="inline" intent=":literal"><semantics><mrow><mrow><mrow><mi>L</mi><mo>,</mo><msub><mi>L</mi><mi>mlp</mi></msub></mrow><mo>≥</mo><mn>1</mn></mrow><mo>,</mo></mrow><annotation encoding="application/x-tex">L,L_{\mathrm{mlp}}\geq 1,</annotation></semantics></math></span></p>
<table id="A3.EGx78" class="ltx_equationgroup ltx_eqn_align ltx_eqn_table">

<tbody id="A3.Ex137"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_eqn_cell"></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A3.Ex137.m1" class="ltx_Math" alttext="\displaystyle K_{L+2}+\sum_{\ell=1}^{L+1}Q_{L+2}\ldots Q_{\ell+1}K_{\ell}" display="inline" intent=":literal"><semantics><mrow><msub><mi>K</mi><mrow><mi>L</mi><mo>+</mo><mn>2</mn></mrow></msub><mo>+</mo><mrow><mstyle displaystyle="true"><munderover><mo movablelimits="false">∑</mo><mrow><mi mathvariant="normal">ℓ</mi><mo>=</mo><mn>1</mn></mrow><mrow><mi>L</mi><mo>+</mo><mn>1</mn></mrow></munderover></mstyle><mrow><msub><mi>Q</mi><mrow><mi>L</mi><mo>+</mo><mn>2</mn></mrow></msub><mo lspace="0em" rspace="0em">​</mo><mi mathvariant="normal">…</mi><mo lspace="0em" rspace="0em">​</mo><msub><mi>Q</mi><mrow><mi mathvariant="normal">ℓ</mi><mo>+</mo><mn>1</mn></mrow></msub><mo lspace="0em" rspace="0em">​</mo><msub><mi>K</mi><mi mathvariant="normal">ℓ</mi></msub></mrow></mrow></mrow><annotation encoding="application/x-tex">\displaystyle K_{L+2}+\sum_{\ell=1}^{L+1}Q_{L+2}\ldots Q_{\ell+1}K_{\ell}</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
<tbody id="A3.Ex138"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_eqn_cell"></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A3.Ex138.m1" class="ltx_Math" alttext="\displaystyle\leq 2\Big(6HA_{L+1}^{2}\big(BN_{\mathrm{mlp}}\big)^{4L_{\mathrm{mlp}}}\Big)^{L}30H^{2}A_{L+1}^{5}\big(B(N_{\mathrm{mlp}}+1)\big)^{6L_{\mathrm{mlp}}}" display="inline" intent=":literal"><semantics><mrow><mphantom></mphantom><mo>≤</mo><mrow><mn>2</mn><mo lspace="0em" rspace="0em">​</mo><msup><mrow><mo maxsize="1.600em" minsize="1.600em">(</mo><mrow><mn>6</mn><mo lspace="0em" rspace="0em">​</mo><mi>H</mi><mo lspace="0em" rspace="0em">​</mo><msubsup><mi>A</mi><mrow><mi>L</mi><mo>+</mo><mn>1</mn></mrow><mn>2</mn></msubsup><mo lspace="0em" rspace="0em">​</mo><msup><mrow><mo maxsize="1.200em" minsize="1.200em">(</mo><mrow><mi>B</mi><mo lspace="0em" rspace="0em">​</mo><msub><mi>N</mi><mi>mlp</mi></msub></mrow><mo maxsize="1.200em" minsize="1.200em">)</mo></mrow><mrow><mn>4</mn><mo lspace="0em" rspace="0em">​</mo><msub><mi>L</mi><mi>mlp</mi></msub></mrow></msup></mrow><mo maxsize="1.600em" minsize="1.600em">)</mo></mrow><mi>L</mi></msup><mo lspace="0em" rspace="0em">​</mo><mn>30</mn><mo lspace="0em" rspace="0em">​</mo><msup><mi>H</mi><mn>2</mn></msup><mo lspace="0em" rspace="0em">​</mo><msubsup><mi>A</mi><mrow><mi>L</mi><mo>+</mo><mn>1</mn></mrow><mn>5</mn></msubsup><mo lspace="0em" rspace="0em">​</mo><msup><mrow><mo maxsize="1.200em" minsize="1.200em">(</mo><mrow><mi>B</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mrow><msub><mi>N</mi><mi>mlp</mi></msub><mo>+</mo><mn>1</mn></mrow><mo stretchy="false">)</mo></mrow></mrow><mo maxsize="1.200em" minsize="1.200em">)</mo></mrow><mrow><mn>6</mn><mo lspace="0em" rspace="0em">​</mo><msub><mi>L</mi><mi>mlp</mi></msub></mrow></msup></mrow></mrow><annotation encoding="application/x-tex">\displaystyle\leq 2\Big(6HA_{L+1}^{2}\big(BN_{\mathrm{mlp}}\big)^{4L_{\mathrm{mlp}}}\Big)^{L}30H^{2}A_{L+1}^{5}\big(B(N_{\mathrm{mlp}}+1)\big)^{6L_{\mathrm{mlp}}}</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
<tbody id="A3.Ex139"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_eqn_cell"></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A3.Ex139.m1" class="ltx_Math" alttext="\displaystyle\leq 2(6H)^{L+2}\big(B(N_{\mathrm{mlp}}+1)\big)^{10L_{\mathrm{mlp}}L}A_{L+1}^{7L}" display="inline" intent=":literal"><semantics><mrow><mphantom></mphantom><mo>≤</mo><mrow><mn>2</mn><mo lspace="0em" rspace="0em">​</mo><msup><mrow><mo stretchy="false">(</mo><mrow><mn>6</mn><mo lspace="0em" rspace="0em">​</mo><mi>H</mi></mrow><mo stretchy="false">)</mo></mrow><mrow><mi>L</mi><mo>+</mo><mn>2</mn></mrow></msup><mo lspace="0em" rspace="0em">​</mo><msup><mrow><mo maxsize="1.200em" minsize="1.200em">(</mo><mrow><mi>B</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mrow><msub><mi>N</mi><mi>mlp</mi></msub><mo>+</mo><mn>1</mn></mrow><mo stretchy="false">)</mo></mrow></mrow><mo maxsize="1.200em" minsize="1.200em">)</mo></mrow><mrow><mn>10</mn><mo lspace="0em" rspace="0em">​</mo><msub><mi>L</mi><mi>mlp</mi></msub><mo lspace="0em" rspace="0em">​</mo><mi>L</mi></mrow></msup><mo lspace="0em" rspace="0em">​</mo><msubsup><mi>A</mi><mrow><mi>L</mi><mo>+</mo><mn>1</mn></mrow><mrow><mn>7</mn><mo lspace="0em" rspace="0em">​</mo><mi>L</mi></mrow></msubsup></mrow></mrow><annotation encoding="application/x-tex">\displaystyle\leq 2(6H)^{L+2}\big(B(N_{\mathrm{mlp}}+1)\big)^{10L_{\mathrm{mlp}}L}A_{L+1}^{7L}</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
<tbody id="A3.Ex140"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_eqn_cell"></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A3.Ex140.m1" class="ltx_Math" alttext="\displaystyle\leq(6H)^{10L^{2}}\big(B(N_{\mathrm{mlp}}+1)\big)^{38L^{2}L_{\mathrm{mlp}}}." display="inline" intent=":literal"><semantics><mrow><mrow><mphantom></mphantom><mo>≤</mo><mrow><msup><mrow><mo stretchy="false">(</mo><mrow><mn>6</mn><mo lspace="0em" rspace="0em">​</mo><mi>H</mi></mrow><mo stretchy="false">)</mo></mrow><mrow><mn>10</mn><mo lspace="0em" rspace="0em">​</mo><msup><mi>L</mi><mn>2</mn></msup></mrow></msup><mo lspace="0em" rspace="0em">​</mo><msup><mrow><mo maxsize="1.200em" minsize="1.200em">(</mo><mrow><mi>B</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mrow><msub><mi>N</mi><mi>mlp</mi></msub><mo>+</mo><mn>1</mn></mrow><mo stretchy="false">)</mo></mrow></mrow><mo maxsize="1.200em" minsize="1.200em">)</mo></mrow><mrow><mn>38</mn><mo lspace="0em" rspace="0em">​</mo><msup><mi>L</mi><mn>2</mn></msup><mo lspace="0em" rspace="0em">​</mo><msub><mi>L</mi><mi>mlp</mi></msub></mrow></msup></mrow></mrow><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">\displaystyle\leq(6H)^{10L^{2}}\big(B(N_{\mathrm{mlp}}+1)\big)^{38L^{2}L_{\mathrm{mlp}}}.</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="A3.p29.2" class="ltx_p"><span id="A3.p29.2.1" class="ltx_text">This is an upper bound for the Lipschitz constant with respect to the parameters. To apply Lemma <a href="#Thmconj27" title="Lemma 7. ‣ Appendix C Proofs for the Stochastic Error ‣ Generalization Bounds for Transformer-Based Next-Token Prediction in a Language Model" class="ltx_ref"><span class="ltx_text ltx_ref_tag">7</span></a>, the number of learnable parameters in the transformer class is shown in (<a href="#S3.E12" title="In 3 The transformer function class ‣ Generalization Bounds for Transformer-Based Next-Token Prediction in a Language Model" class="ltx_ref"><span class="ltx_text ltx_ref_tag">12</span></a>) to be</span></p>
<table id="A3.EGx79" class="ltx_equationgroup ltx_eqn_align ltx_eqn_table">

<tbody id="A3.Ex141"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_align_right ltx_eqn_cell"><math id="A3.Ex141.m1" class="ltx_Math" alttext="\displaystyle 2WN+L\Big((2H+1)N^{2}+2NN_{\mathrm{mlp}}+(L_{\mathrm{mlp}}-1)N_{\mathrm{mlp}}^{2}+L_{\mathrm{mlp}}N_{\mathrm{mlp}}+N\Big)." display="inline" intent=":literal"><semantics><mrow><mrow><mrow><mn>2</mn><mo lspace="0em" rspace="0em">​</mo><mi>W</mi><mo lspace="0em" rspace="0em">​</mo><mi>N</mi></mrow><mo>+</mo><mrow><mi>L</mi><mo>⁡</mo><mrow><mo maxsize="1.600em" minsize="1.600em">(</mo><mrow><mrow><mrow><mo stretchy="false">(</mo><mrow><mrow><mn>2</mn><mo lspace="0em" rspace="0em">​</mo><mi>H</mi></mrow><mo>+</mo><mn>1</mn></mrow><mo stretchy="false">)</mo></mrow><mo lspace="0em" rspace="0em">​</mo><msup><mi>N</mi><mn>2</mn></msup></mrow><mo>+</mo><mrow><mn>2</mn><mo lspace="0em" rspace="0em">​</mo><mi>N</mi><mo lspace="0em" rspace="0em">​</mo><msub><mi>N</mi><mi>mlp</mi></msub></mrow><mo>+</mo><mrow><mrow><mo stretchy="false">(</mo><mrow><msub><mi>L</mi><mi>mlp</mi></msub><mo>−</mo><mn>1</mn></mrow><mo stretchy="false">)</mo></mrow><mo lspace="0em" rspace="0em">​</mo><msubsup><mi>N</mi><mi>mlp</mi><mn>2</mn></msubsup></mrow><mo>+</mo><mrow><msub><mi>L</mi><mi>mlp</mi></msub><mo lspace="0em" rspace="0em">​</mo><msub><mi>N</mi><mi>mlp</mi></msub></mrow><mo>+</mo><mi>N</mi></mrow><mo maxsize="1.600em" minsize="1.600em">)</mo></mrow></mrow></mrow><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">\displaystyle 2WN+L\Big((2H+1)N^{2}+2NN_{\mathrm{mlp}}+(L_{\mathrm{mlp}}-1)N_{\mathrm{mlp}}^{2}+L_{\mathrm{mlp}}N_{\mathrm{mlp}}+N\Big).</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="A3.p29.3" class="ltx_p"><span id="A3.p29.3.1" class="ltx_text">Using that by assumption <math id="A3.p29.m5" class="ltx_Math" alttext="N\leq N_{\mathrm{mlp}}," display="inline" intent=":literal"><semantics><mrow><mrow><mi>N</mi><mo>≤</mo><msub><mi>N</mi><mi>mlp</mi></msub></mrow><mo>,</mo></mrow><annotation encoding="application/x-tex">N\leq N_{\mathrm{mlp}},</annotation></semantics></math> the number of parameters can be bounded by</span></p>
<table id="A3.EGx80" class="ltx_equationgroup ltx_eqn_align ltx_eqn_table">

<tbody id="A3.Ex142"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_align_right ltx_eqn_cell"><math id="A3.Ex142.m1" class="ltx_Math" alttext="\displaystyle\leq 2WN+4HLN^{2}+3LL_{\mathrm{mlp}}N_{\mathrm{mlp}}^{2}." display="inline" intent=":literal"><semantics><mrow><mrow><mphantom></mphantom><mo>≤</mo><mrow><mrow><mn>2</mn><mo lspace="0em" rspace="0em">​</mo><mi>W</mi><mo lspace="0em" rspace="0em">​</mo><mi>N</mi></mrow><mo>+</mo><mrow><mn>4</mn><mo lspace="0em" rspace="0em">​</mo><mi>H</mi><mo lspace="0em" rspace="0em">​</mo><mi>L</mi><mo lspace="0em" rspace="0em">​</mo><msup><mi>N</mi><mn>2</mn></msup></mrow><mo>+</mo><mrow><mn>3</mn><mo lspace="0em" rspace="0em">​</mo><mi>L</mi><mo lspace="0em" rspace="0em">​</mo><msub><mi>L</mi><mi>mlp</mi></msub><mo lspace="0em" rspace="0em">​</mo><msubsup><mi>N</mi><mi>mlp</mi><mn>2</mn></msubsup></mrow></mrow></mrow><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">\displaystyle\leq 2WN+4HLN^{2}+3LL_{\mathrm{mlp}}N_{\mathrm{mlp}}^{2}.</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="A3.p29.4" class="ltx_p"><span id="A3.p29.4.1" class="ltx_text">Applying now Lemma <a href="#Thmconj27" title="Lemma 7. ‣ Appendix C Proofs for the Stochastic Error ‣ Generalization Bounds for Transformer-Based Next-Token Prediction in a Language Model" class="ltx_ref"><span class="ltx_text ltx_ref_tag">7</span></a> yields the claimed bound for the metric entropy.
∎</span></p>
</div>
</div>
</section>
<section id="A4" class="ltx_appendix">
<h2 class="ltx_title ltx_title_appendix"><span class="ltx_tag ltx_tag_appendix">Appendix D </span>Proofs for the Approximation Error</h2>

<div id="A4.p1" class="ltx_para">
<p id="A4.p1.1" class="ltx_p">We now prove Theorem <a href="#Thmconj24" title="Theorem 4. ‣ 4.1 Proof of the risk bound ‣ 4 Risk bound ‣ Generalization Bounds for Transformer-Based Next-Token Prediction in a Language Model" class="ltx_ref"><span class="ltx_text ltx_ref_tag">4</span></a>.
Unless otherwise specified, the implicit constants in the notation <math id="A4.p1.m1" class="ltx_Math" alttext="\lesssim" display="inline" intent=":literal"><semantics><mo>≲</mo><annotation encoding="application/x-tex">\lesssim</annotation></semantics></math> and <math id="A4.p1.m2" class="ltx_Math" alttext="\tilde{O}" display="inline" intent=":literal"><semantics><mover accent="true"><mi>O</mi><mo>~</mo></mover><annotation encoding="application/x-tex">\tilde{O}</annotation></semantics></math> depend only on <math id="A4.p1.m3" class="ltx_Math" alttext="(m_{1},m_{2},r_{1},r_{2},\delta_{1},\delta_{2},\beta_{1},\beta_{2},\|\mathbf{g}_{0}\|_{\mathcal{C}^{\beta_{1}}},\sup_{\mathbf{h}\in\mathcal{H}}\|\mathbf{h}\|_{\mathcal{C}^{\beta_{2}}})" display="inline" intent=":literal"><semantics><mrow><mo stretchy="false">(</mo><msub><mi>m</mi><mn>1</mn></msub><mo>,</mo><msub><mi>m</mi><mn>2</mn></msub><mo>,</mo><msub><mi>r</mi><mn>1</mn></msub><mo>,</mo><msub><mi>r</mi><mn>2</mn></msub><mo>,</mo><msub><mi>δ</mi><mn>1</mn></msub><mo>,</mo><msub><mi>δ</mi><mn>2</mn></msub><mo>,</mo><msub><mi>β</mi><mn>1</mn></msub><mo>,</mo><msub><mi>β</mi><mn>2</mn></msub><mo>,</mo><msub><mrow><mo stretchy="false">‖</mo><msub><mi>𝐠</mi><mn>0</mn></msub><mo stretchy="false">‖</mo></mrow><msup><mi class="ltx_font_mathcaligraphic">𝒞</mi><msub><mi>β</mi><mn>1</mn></msub></msup></msub><mo>,</mo><mrow><msub><mo lspace="0em" rspace="0em">sup</mo><mrow><mi>𝐡</mi><mo>∈</mo><mi class="ltx_font_mathcaligraphic">ℋ</mi></mrow></msub><msub><mrow><mo stretchy="false">‖</mo><mi>𝐡</mi><mo stretchy="false">‖</mo></mrow><msup><mi class="ltx_font_mathcaligraphic">𝒞</mi><msub><mi>β</mi><mn>2</mn></msub></msup></msub></mrow><mo stretchy="false">)</mo></mrow><annotation encoding="application/x-tex">(m_{1},m_{2},r_{1},r_{2},\delta_{1},\delta_{2},\beta_{1},\beta_{2},\|\mathbf{g}_{0}\|_{\mathcal{C}^{\beta_{1}}},\sup_{\mathbf{h}\in\mathcal{H}}\|\mathbf{h}\|_{\mathcal{C}^{\beta_{2}}})</annotation></semantics></math>.
We recall Theorem <a href="#Thmconj24" title="Theorem 4. ‣ 4.1 Proof of the risk bound ‣ 4 Risk bound ‣ Generalization Bounds for Transformer-Based Next-Token Prediction in a Language Model" class="ltx_ref"><span class="ltx_text ltx_ref_tag">4</span></a> here.</p>
</div>
<div id="Thmconj211" class="ltx_theorem ltx_theorem_thm">
<h6 class="ltx_title ltx_runin ltx_title_theorem"><span class="ltx_tag ltx_tag_theorem"><span id="Thmconj211.4" class="ltx_text ltx_font_bold">Theorem 11</span></span><span id="Thmconj211.5" class="ltx_text ltx_font_bold"> </span>(Theorem <a href="#Thmconj24" title="Theorem 4. ‣ 4.1 Proof of the risk bound ‣ 4 Risk bound ‣ Generalization Bounds for Transformer-Based Next-Token Prediction in a Language Model" class="ltx_ref"><span class="ltx_text ltx_ref_tag">4</span></a>)<span id="Thmconj211.6" class="ltx_text ltx_font_bold">.</span></h6>
<div id="Thmconj211.p1" class="ltx_para">
<p id="Thmconj211.p1.1" class="ltx_p"><span id="Thmconj211.p1.1.1" class="ltx_text ltx_font_italic">Suppose Assumptions <a href="#Thmassumpt2" title="Assumption 2. ‣ 4 Risk bound ‣ Generalization Bounds for Transformer-Based Next-Token Prediction in a Language Model" class="ltx_ref"><span class="ltx_text ltx_ref_tag">2</span></a> and <a href="#Thmassumpt3" title="Assumption 3. ‣ 4 Risk bound ‣ Generalization Bounds for Transformer-Based Next-Token Prediction in a Language Model" class="ltx_ref"><span class="ltx_text ltx_ref_tag">3</span></a> hold. For sufficiently large <math id="Thmconj211.p1.m1" class="ltx_Math" alttext="W" display="inline" intent=":literal"><semantics><mi>W</mi><annotation encoding="application/x-tex">W</annotation></semantics></math> and <math id="Thmconj211.p1.m2" class="ltx_Math" alttext="T" display="inline" intent=":literal"><semantics><mi>T</mi><annotation encoding="application/x-tex">T</annotation></semantics></math> and for any <math id="Thmconj211.p1.m3" class="ltx_Math" alttext="\lambda\in[T^{-1},\log^{-1}(W\land T)]" display="inline" intent=":literal"><semantics><mrow><mi>λ</mi><mo>∈</mo><mrow><mo stretchy="false">[</mo><mrow><msup><mi>T</mi><mrow><mo>−</mo><mn>1</mn></mrow></msup><mo>,</mo><mrow><msup><mi>log</mi><mrow><mo>−</mo><mn>1</mn></mrow></msup><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mrow><mi>W</mi><mo>∧</mo><mi>T</mi></mrow><mo stretchy="false">)</mo></mrow></mrow></mrow><mo stretchy="false">]</mo></mrow></mrow><annotation encoding="application/x-tex">\lambda\in[T^{-1},\log^{-1}(W\land T)]</annotation></semantics></math>, there exists a transformer <math id="Thmconj211.p1.m4" class="ltx_Math" alttext="\mathbf{f}^{*}\in\mathcal{T}_{M}(W,T,L,N,H,L_{\mathrm{mlp}},N_{\mathrm{mlp}},B)" display="inline" intent=":literal"><semantics><mrow><msup><mi>𝐟</mi><mo>∗</mo></msup><mo>∈</mo><mrow><msub><mi class="ltx_font_mathcaligraphic">𝒯</mi><mi>M</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>W</mi><mo>,</mo><mi>T</mi><mo>,</mo><mi>L</mi><mo>,</mo><mi>N</mi><mo>,</mo><mi>H</mi><mo>,</mo><msub><mi>L</mi><mi>mlp</mi></msub><mo>,</mo><msub><mi>N</mi><mi>mlp</mi></msub><mo>,</mo><mi>B</mi><mo stretchy="false">)</mo></mrow></mrow></mrow><annotation encoding="application/x-tex">\mathbf{f}^{*}\in\mathcal{T}_{M}(W,T,L,N,H,L_{\mathrm{mlp}},N_{\mathrm{mlp}},B)</annotation></semantics></math> such that</span></p>
<table id="A4.Ex143" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="A4.Ex143.m1" class="ltx_Math" alttext="\sup_{\mathbf{h}\in\mathcal{H}}\mathbb{E}\Big[\|\mathbf{f}^{*}(\mathbf{X}_{1},\ldots,\mathbf{X}_{T})-\mathbf{f}_{0}(\mathbf{h},\mathbf{X}_{1},\ldots,\mathbf{X}_{T})\|_{\infty}^{2}\,\Big|\,\mathbf{h}\Big]=\tilde{O}\bigg(N_{\mathrm{mlp}}^{-\frac{4\beta_{1}}{m_{1}r_{1}}}+\lambda^{2\beta_{2}}+\frac{M^{2}}{T\varphi_{W}(\lambda)^{r_{2}}}+\kappa_{W}^{2}\bigg)." display="block" intent=":literal"><semantics><mrow><mrow><mrow><munder><mo movablelimits="false">sup</mo><mrow><mi>𝐡</mi><mo>∈</mo><mi class="ltx_font_mathcaligraphic">ℋ</mi></mrow></munder><mrow><mi>𝔼</mi><mo>⁡</mo><mrow><mo maxsize="1.600em" minsize="1.600em">[</mo><mrow><msubsup><mrow><mo stretchy="false">‖</mo><mrow><mrow><msup><mi>𝐟</mi><mo>∗</mo></msup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mi>𝐗</mi><mn>1</mn></msub><mo>,</mo><mi mathvariant="normal">…</mi><mo>,</mo><msub><mi>𝐗</mi><mi>T</mi></msub><mo stretchy="false">)</mo></mrow></mrow><mo>−</mo><mrow><msub><mi>𝐟</mi><mn>0</mn></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>𝐡</mi><mo>,</mo><msub><mi>𝐗</mi><mn>1</mn></msub><mo>,</mo><mi mathvariant="normal">…</mi><mo>,</mo><msub><mi>𝐗</mi><mi>T</mi></msub><mo stretchy="false">)</mo></mrow></mrow></mrow><mo stretchy="false">‖</mo></mrow><mi mathvariant="normal">∞</mi><mn>2</mn></msubsup><mo fence="false" maxsize="1.600em" minsize="1.600em" rspace="0.337em" stretchy="true">|</mo><mi>𝐡</mi></mrow><mo maxsize="1.600em" minsize="1.600em">]</mo></mrow></mrow></mrow><mo>=</mo><mrow><mover accent="true"><mi>O</mi><mo>~</mo></mover><mo lspace="0em" rspace="0em">​</mo><mrow><mo maxsize="2.100em" minsize="2.100em">(</mo><mrow><msubsup><mi>N</mi><mi>mlp</mi><mrow><mo>−</mo><mfrac><mrow><mn>4</mn><mo lspace="0em" rspace="0em">​</mo><msub><mi>β</mi><mn>1</mn></msub></mrow><mrow><msub><mi>m</mi><mn>1</mn></msub><mo lspace="0em" rspace="0em">​</mo><msub><mi>r</mi><mn>1</mn></msub></mrow></mfrac></mrow></msubsup><mo>+</mo><msup><mi>λ</mi><mrow><mn>2</mn><mo lspace="0em" rspace="0em">​</mo><msub><mi>β</mi><mn>2</mn></msub></mrow></msup><mo>+</mo><mfrac><msup><mi>M</mi><mn>2</mn></msup><mrow><mi>T</mi><mo lspace="0em" rspace="0em">​</mo><msub><mi>φ</mi><mi>W</mi></msub><mo lspace="0em" rspace="0em">​</mo><msup><mrow><mo stretchy="false">(</mo><mi>λ</mi><mo stretchy="false">)</mo></mrow><msub><mi>r</mi><mn>2</mn></msub></msup></mrow></mfrac><mo>+</mo><msubsup><mi>κ</mi><mi>W</mi><mn>2</mn></msubsup></mrow><mo maxsize="2.100em" minsize="2.100em">)</mo></mrow></mrow></mrow><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">\sup_{\mathbf{h}\in\mathcal{H}}\mathbb{E}\Big[\|\mathbf{f}^{*}(\mathbf{X}_{1},\ldots,\mathbf{X}_{T})-\mathbf{f}_{0}(\mathbf{h},\mathbf{X}_{1},\ldots,\mathbf{X}_{T})\|_{\infty}^{2}\,\Big|\,\mathbf{h}\Big]=\tilde{O}\bigg(N_{\mathrm{mlp}}^{-\frac{4\beta_{1}}{m_{1}r_{1}}}+\lambda^{2\beta_{2}}+\frac{M^{2}}{T\varphi_{W}(\lambda)^{r_{2}}}+\kappa_{W}^{2}\bigg).</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
</div>
</div>
<div id="A4.p2" class="ltx_para">
<p id="A4.p2.1" class="ltx_p">As prerequisites of the proof, we recall definitions and key lemmas from Section <a href="#S5" title="5 Proof Sketch of the Upper Bound for the Approximation Error ‣ Generalization Bounds for Transformer-Based Next-Token Prediction in a Language Model" class="ltx_ref"><span class="ltx_text ltx_ref_tag">5</span></a>. The random vectors <math id="A4.p2.m1" class="ltx_Math" alttext="\mathbf{Z}_{1,t}\in\mathbb{R}^{r_{1}m_{1}}" display="inline" intent=":literal"><semantics><mrow><msub><mi>𝐙</mi><mrow><mn>1</mn><mo>,</mo><mi>t</mi></mrow></msub><mo>∈</mo><msup><mi>ℝ</mi><mrow><msub><mi>r</mi><mn>1</mn></msub><mo lspace="0em" rspace="0em">​</mo><msub><mi>m</mi><mn>1</mn></msub></mrow></msup></mrow><annotation encoding="application/x-tex">\mathbf{Z}_{1,t}\in\mathbb{R}^{r_{1}m_{1}}</annotation></semantics></math>,
<math id="A4.p2.m2" class="ltx_Math" alttext="\mathbf{Z}_{2,t}\in\mathbb{R}^{r_{2}m_{2}}" display="inline" intent=":literal"><semantics><mrow><msub><mi>𝐙</mi><mrow><mn>2</mn><mo>,</mo><mi>t</mi></mrow></msub><mo>∈</mo><msup><mi>ℝ</mi><mrow><msub><mi>r</mi><mn>2</mn></msub><mo lspace="0em" rspace="0em">​</mo><msub><mi>m</mi><mn>2</mn></msub></mrow></msup></mrow><annotation encoding="application/x-tex">\mathbf{Z}_{2,t}\in\mathbb{R}^{r_{2}m_{2}}</annotation></semantics></math> and
<math id="A4.p2.m3" class="ltx_Math" alttext="\mathbf{Y}_{t}\in\mathbb{R}^{m_{2}}" display="inline" intent=":literal"><semantics><mrow><msub><mi>𝐘</mi><mi>t</mi></msub><mo>∈</mo><msup><mi>ℝ</mi><msub><mi>m</mi><mn>2</mn></msub></msup></mrow><annotation encoding="application/x-tex">\mathbf{Y}_{t}\in\mathbb{R}^{m_{2}}</annotation></semantics></math> are defined by</p>
<table id="A4.Ex144" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="A4.Ex144.m1" class="ltx_Math" alttext="\mathbf{Z}_{1,t}=\begin{pmatrix}\bm{\phi}_{1}(\mathbf{X}_{t-r_{1}})\\
\bm{\phi}_{1}(\mathbf{X}_{t-r_{1}+1})\\
\vdots\\
\bm{\phi}_{1}(\mathbf{X}_{t-1})\end{pmatrix},\qquad\mathbf{Z}_{2,t}=\begin{pmatrix}\bm{\phi}_{2}(\mathbf{X}_{t-r_{2}})\\
\bm{\phi}_{2}(\mathbf{X}_{t-r_{2}+1})\\
\vdots\\
\bm{\phi}_{2}(\mathbf{X}_{t-1})\end{pmatrix},\qquad\mathbf{Y}_{t}\coloneqq\frac{\bm{\phi}_{2}(\mathbf{X}_{t})}{\exp[\mathbf{g}_{0}(\mathbf{Z}_{1,t})^{\top}\bm{\phi}_{1}(\mathbf{X}_{t})]}." display="block" intent=":literal"><semantics><mrow><mrow><mrow><msub><mi>𝐙</mi><mrow><mn>1</mn><mo>,</mo><mi>t</mi></mrow></msub><mo>=</mo><mrow><mo>(</mo><mtable displaystyle="true" rowspacing="0pt"><mtr><mtd><mrow><msub><mi class="ltx_mathvariant_bold-italic" mathvariant="bold-italic">ϕ</mi><mn>1</mn></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mi>𝐗</mi><mrow><mi>t</mi><mo>−</mo><msub><mi>r</mi><mn>1</mn></msub></mrow></msub><mo stretchy="false">)</mo></mrow></mrow></mtd></mtr><mtr><mtd><mrow><msub><mi class="ltx_mathvariant_bold-italic" mathvariant="bold-italic">ϕ</mi><mn>1</mn></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mi>𝐗</mi><mrow><mrow><mi>t</mi><mo>−</mo><msub><mi>r</mi><mn>1</mn></msub></mrow><mo>+</mo><mn>1</mn></mrow></msub><mo stretchy="false">)</mo></mrow></mrow></mtd></mtr><mtr><mtd></mtd></mtr><mtr><mtd><mrow><msub><mi class="ltx_mathvariant_bold-italic" mathvariant="bold-italic">ϕ</mi><mn>1</mn></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mi>𝐗</mi><mrow><mi>t</mi><mo>−</mo><mn>1</mn></mrow></msub><mo stretchy="false">)</mo></mrow></mrow></mtd></mtr></mtable><mo>)</mo></mrow></mrow><mo rspace="2.167em">,</mo><mrow><msub><mi>𝐙</mi><mrow><mn>2</mn><mo>,</mo><mi>t</mi></mrow></msub><mo>=</mo><mrow><mo>(</mo><mtable displaystyle="true" rowspacing="0pt"><mtr><mtd><mrow><msub><mi class="ltx_mathvariant_bold-italic" mathvariant="bold-italic">ϕ</mi><mn>2</mn></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mi>𝐗</mi><mrow><mi>t</mi><mo>−</mo><msub><mi>r</mi><mn>2</mn></msub></mrow></msub><mo stretchy="false">)</mo></mrow></mrow></mtd></mtr><mtr><mtd><mrow><msub><mi class="ltx_mathvariant_bold-italic" mathvariant="bold-italic">ϕ</mi><mn>2</mn></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mi>𝐗</mi><mrow><mrow><mi>t</mi><mo>−</mo><msub><mi>r</mi><mn>2</mn></msub></mrow><mo>+</mo><mn>1</mn></mrow></msub><mo stretchy="false">)</mo></mrow></mrow></mtd></mtr><mtr><mtd></mtd></mtr><mtr><mtd><mrow><msub><mi class="ltx_mathvariant_bold-italic" mathvariant="bold-italic">ϕ</mi><mn>2</mn></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mi>𝐗</mi><mrow><mi>t</mi><mo>−</mo><mn>1</mn></mrow></msub><mo stretchy="false">)</mo></mrow></mrow></mtd></mtr></mtable><mo>)</mo></mrow></mrow><mo rspace="2.167em">,</mo><mrow><msub><mi>𝐘</mi><mi>t</mi></msub><mo>≔</mo><mfrac><mrow><msub><mi class="ltx_mathvariant_bold-italic" mathvariant="bold-italic">ϕ</mi><mn>2</mn></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mi>𝐗</mi><mi>t</mi></msub><mo stretchy="false">)</mo></mrow></mrow><mrow><mi>exp</mi><mo>⁡</mo><mrow><mo stretchy="false">[</mo><mrow><msub><mi>𝐠</mi><mn>0</mn></msub><mo lspace="0em" rspace="0em">​</mo><msup><mrow><mo stretchy="false">(</mo><msub><mi>𝐙</mi><mrow><mn>1</mn><mo>,</mo><mi>t</mi></mrow></msub><mo stretchy="false">)</mo></mrow><mo>⊤</mo></msup><mo lspace="0em" rspace="0em">​</mo><msub><mi class="ltx_mathvariant_bold-italic" mathvariant="bold-italic">ϕ</mi><mn>1</mn></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mi>𝐗</mi><mi>t</mi></msub><mo stretchy="false">)</mo></mrow></mrow><mo stretchy="false">]</mo></mrow></mrow></mfrac></mrow></mrow><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">\mathbf{Z}_{1,t}=\begin{pmatrix}\bm{\phi}_{1}(\mathbf{X}_{t-r_{1}})\\
\bm{\phi}_{1}(\mathbf{X}_{t-r_{1}+1})\\
\vdots\\
\bm{\phi}_{1}(\mathbf{X}_{t-1})\end{pmatrix},\qquad\mathbf{Z}_{2,t}=\begin{pmatrix}\bm{\phi}_{2}(\mathbf{X}_{t-r_{2}})\\
\bm{\phi}_{2}(\mathbf{X}_{t-r_{2}+1})\\
\vdots\\
\bm{\phi}_{2}(\mathbf{X}_{t-1})\end{pmatrix},\qquad\mathbf{Y}_{t}\coloneqq\frac{\bm{\phi}_{2}(\mathbf{X}_{t})}{\exp[\mathbf{g}_{0}(\mathbf{Z}_{1,t})^{\top}\bm{\phi}_{1}(\mathbf{X}_{t})]}.</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="A4.p2.2" class="ltx_p">In addition,
recall that for <math id="A4.p2.m4" class="ltx_Math" alttext="\mathbf{z}\in\mathbb{R}^{r_{2}m_{2}}" display="inline" intent=":literal"><semantics><mrow><mi>𝐳</mi><mo>∈</mo><msup><mi>ℝ</mi><mrow><msub><mi>r</mi><mn>2</mn></msub><mo lspace="0em" rspace="0em">​</mo><msub><mi>m</mi><mn>2</mn></msub></mrow></msup></mrow><annotation encoding="application/x-tex">\mathbf{z}\in\mathbb{R}^{r_{2}m_{2}}</annotation></semantics></math> and <math id="A4.p2.m5" class="ltx_math_unparsed" alttext="K_{\lambda}(\mathbf{z},\mathbf{z}^{\prime})\coloneq\exp(-\|\mathbf{z}-\mathbf{z}^{\prime}\|^{2}/(2\lambda^{2}))" display="inline" intent=":literal"><semantics><mrow><msub><mi>K</mi><mi>λ</mi></msub><mrow><mo stretchy="false">(</mo><mi>𝐳</mi><mo>,</mo><msup><mi>𝐳</mi><mo>′</mo></msup><mo stretchy="false">)</mo></mrow><mo>≔</mo><mi>exp</mi><mrow><mo stretchy="false">(</mo><mo lspace="0em" rspace="0em">−</mo><mo lspace="0em" rspace="0.167em">∥</mo><mi>𝐳</mi><mo>−</mo><msup><mi>𝐳</mi><mo>′</mo></msup><msup><mo lspace="0em" rspace="0em">∥</mo><mn>2</mn></msup><mo lspace="0em">/</mo><mrow><mo stretchy="false">(</mo><mn>2</mn><msup><mi>λ</mi><mn>2</mn></msup><mo stretchy="false">)</mo></mrow><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">K_{\lambda}(\mathbf{z},\mathbf{z}^{\prime})\coloneq\exp(-\|\mathbf{z}-\mathbf{z}^{\prime}\|^{2}/(2\lambda^{2}))</annotation></semantics></math>,</p>
<table id="A4.EGx81" class="ltx_equationgroup ltx_eqn_align ltx_eqn_table">

<tbody id="A4.Ex145"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_align_right ltx_eqn_cell"><math id="A4.Ex145.m1" class="ltx_Math" alttext="\displaystyle\widehat{\mathbf{m}}_{\lambda}(\mathbf{z})\coloneqq\sum_{s\in[\log^{2}T,T-\log^{2}T]}\frac{K_{\lambda}\big(\mathbf{Z}_{2,s},\mathbf{z}\big)}{\sum_{i\in[\log^{2}T,T-\log^{2}T]}K_{\lambda}\big(\mathbf{Z}_{2,i},\mathbf{z}\big)}\mathbf{Y}_{s}." display="inline" intent=":literal"><semantics><mrow><mrow><mrow><msub><mover accent="true"><mi>𝐦</mi><mo>^</mo></mover><mi>λ</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>𝐳</mi><mo stretchy="false">)</mo></mrow></mrow><mo>≔</mo><mrow><mstyle displaystyle="true"><munder><mo movablelimits="false">∑</mo><mrow><mi>s</mi><mo>∈</mo><mrow><mo stretchy="false">[</mo><mrow><mrow><msup><mi>log</mi><mn>2</mn></msup><mo lspace="0.167em">⁡</mo><mi>T</mi></mrow><mo>,</mo><mrow><mi>T</mi><mo>−</mo><mrow><msup><mi>log</mi><mn>2</mn></msup><mo lspace="0.167em">⁡</mo><mi>T</mi></mrow></mrow></mrow><mo stretchy="false">]</mo></mrow></mrow></munder></mstyle><mrow><mstyle displaystyle="true"><mfrac><mrow><msub><mi>K</mi><mi>λ</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo maxsize="1.200em" minsize="1.200em">(</mo><msub><mi>𝐙</mi><mrow><mn>2</mn><mo>,</mo><mi>s</mi></mrow></msub><mo>,</mo><mi>𝐳</mi><mo maxsize="1.200em" minsize="1.200em">)</mo></mrow></mrow><mrow><msub><mo>∑</mo><mrow><mi>i</mi><mo>∈</mo><mrow><mo stretchy="false">[</mo><mrow><mrow><msup><mi>log</mi><mn>2</mn></msup><mo lspace="0.167em">⁡</mo><mi>T</mi></mrow><mo>,</mo><mrow><mi>T</mi><mo>−</mo><mrow><msup><mi>log</mi><mn>2</mn></msup><mo lspace="0.167em">⁡</mo><mi>T</mi></mrow></mrow></mrow><mo stretchy="false">]</mo></mrow></mrow></msub><mrow><msub><mi>K</mi><mi>λ</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo maxsize="1.200em" minsize="1.200em">(</mo><msub><mi>𝐙</mi><mrow><mn>2</mn><mo>,</mo><mi>i</mi></mrow></msub><mo>,</mo><mi>𝐳</mi><mo maxsize="1.200em" minsize="1.200em">)</mo></mrow></mrow></mrow></mfrac></mstyle><mo lspace="0em" rspace="0em">​</mo><msub><mi>𝐘</mi><mi>s</mi></msub></mrow></mrow></mrow><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">\displaystyle\widehat{\mathbf{m}}_{\lambda}(\mathbf{z})\coloneqq\sum_{s\in[\log^{2}T,T-\log^{2}T]}\frac{K_{\lambda}\big(\mathbf{Z}_{2,s},\mathbf{z}\big)}{\sum_{i\in[\log^{2}T,T-\log^{2}T]}K_{\lambda}\big(\mathbf{Z}_{2,i},\mathbf{z}\big)}\mathbf{Y}_{s}.</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="A4.p2.3" class="ltx_p">Lemma <a href="#Thmconj26" title="Lemma 6. ‣ 5 Proof Sketch of the Upper Bound for the Approximation Error ‣ Generalization Bounds for Transformer-Based Next-Token Prediction in a Language Model" class="ltx_ref"><span class="ltx_text ltx_ref_tag">6</span></a> states that</p>
<table id="A4.EGx82" class="ltx_equationgroup ltx_eqn_align ltx_eqn_table">

<tbody id="A4.E48"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_align_right ltx_eqn_cell"><math id="A4.E48.m1" class="ltx_Math" alttext="\displaystyle\mathbb{E}\left[\left\|\frac{\delta_{2}}{\|\widehat{\mathbf{m}}_{\lambda}(\mathbf{Z}_{2,T+1})\|_{2}}\widehat{\mathbf{m}}_{\lambda}(\mathbf{Z}_{2,T+1})-\mathbf{h}(\mathbf{Z}_{2,T})\right\|^{2}_{2}\,\bigg|\,\mathbf{h}\right]=\tilde{O}\Big(\lambda^{2\beta_{2}}+\frac{1}{T\varphi_{W}(\lambda)^{r_{2}}}+\kappa_{W}^{2}\Big)," display="inline" intent=":literal"><semantics><mrow><mrow><mrow><mi>𝔼</mi><mo>⁡</mo><mrow><mo>[</mo><mrow><msubsup><mrow><mo>‖</mo><mrow><mrow><mstyle displaystyle="true"><mfrac><msub><mi>δ</mi><mn>2</mn></msub><msub><mrow><mo stretchy="false">‖</mo><mrow><msub><mover accent="true"><mi>𝐦</mi><mo>^</mo></mover><mi>λ</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mi>𝐙</mi><mrow><mn>2</mn><mo>,</mo><mrow><mi>T</mi><mo>+</mo><mn>1</mn></mrow></mrow></msub><mo stretchy="false">)</mo></mrow></mrow><mo stretchy="false">‖</mo></mrow><mn>2</mn></msub></mfrac></mstyle><mo lspace="0em" rspace="0em">​</mo><msub><mover accent="true"><mi>𝐦</mi><mo>^</mo></mover><mi>λ</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mi>𝐙</mi><mrow><mn>2</mn><mo>,</mo><mrow><mi>T</mi><mo>+</mo><mn>1</mn></mrow></mrow></msub><mo stretchy="false">)</mo></mrow></mrow><mo>−</mo><mrow><mi>𝐡</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><msub><mi>𝐙</mi><mrow><mn>2</mn><mo>,</mo><mi>T</mi></mrow></msub><mo stretchy="false">)</mo></mrow></mrow></mrow><mo>‖</mo></mrow><mn>2</mn><mn>2</mn></msubsup><mo fence="false" maxsize="2.100em" minsize="2.100em" rspace="0.337em" stretchy="true">|</mo><mi>𝐡</mi></mrow><mo>]</mo></mrow></mrow><mo>=</mo><mrow><mover accent="true"><mi>O</mi><mo>~</mo></mover><mo lspace="0em" rspace="0em">​</mo><mrow><mo maxsize="1.600em" minsize="1.600em">(</mo><mrow><msup><mi>λ</mi><mrow><mn>2</mn><mo lspace="0em" rspace="0em">​</mo><msub><mi>β</mi><mn>2</mn></msub></mrow></msup><mo>+</mo><mstyle displaystyle="true"><mfrac><mn>1</mn><mrow><mi>T</mi><mo lspace="0em" rspace="0em">​</mo><msub><mi>φ</mi><mi>W</mi></msub><mo lspace="0em" rspace="0em">​</mo><msup><mrow><mo stretchy="false">(</mo><mi>λ</mi><mo stretchy="false">)</mo></mrow><msub><mi>r</mi><mn>2</mn></msub></msup></mrow></mfrac></mstyle><mo>+</mo><msubsup><mi>κ</mi><mi>W</mi><mn>2</mn></msubsup></mrow><mo maxsize="1.600em" minsize="1.600em">)</mo></mrow></mrow></mrow><mo>,</mo></mrow><annotation encoding="application/x-tex">\displaystyle\mathbb{E}\left[\left\|\frac{\delta_{2}}{\|\widehat{\mathbf{m}}_{\lambda}(\mathbf{Z}_{2,T+1})\|_{2}}\widehat{\mathbf{m}}_{\lambda}(\mathbf{Z}_{2,T+1})-\mathbf{h}(\mathbf{Z}_{2,T})\right\|^{2}_{2}\,\bigg|\,\mathbf{h}\right]=\tilde{O}\Big(\lambda^{2\beta_{2}}+\frac{1}{T\varphi_{W}(\lambda)^{r_{2}}}+\kappa_{W}^{2}\Big),</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td>
<td rowspan="1" class="ltx_eqn_cell ltx_eqn_eqno ltx_align_middle ltx_align_right"><span class="ltx_tag ltx_tag_equation ltx_align_right">(48)</span></td></tr></tbody>
</table>
<p id="A4.p2.4" class="ltx_p">and that there exists a constant <math id="A4.p2.m6" class="ltx_Math" alttext="c&gt;0" display="inline" intent=":literal"><semantics><mrow><mi>c</mi><mo>&gt;</mo><mn>0</mn></mrow><annotation encoding="application/x-tex">c&gt;0</annotation></semantics></math> such that <math id="A4.p2.m7" class="ltx_Math" alttext="\mathbb{P}\big(\|\widehat{\mathbf{m}}_{\lambda}(\mathbf{Z}_{2,T+1})\|_{2}&lt;c\,\big|\,\mathbf{h}\big)\lesssim 1/(T\varphi_{W}(\lambda)^{r_{2}})." display="inline" intent=":literal"><semantics><mrow><mrow><mrow><mi>ℙ</mi><mo>⁡</mo><mrow><mo maxsize="1.200em" minsize="1.200em">(</mo><mrow><msub><mrow><mo stretchy="false">‖</mo><mrow><msub><mover accent="true"><mi>𝐦</mi><mo>^</mo></mover><mi>λ</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mi>𝐙</mi><mrow><mn>2</mn><mo>,</mo><mrow><mi>T</mi><mo>+</mo><mn>1</mn></mrow></mrow></msub><mo stretchy="false">)</mo></mrow></mrow><mo stretchy="false">‖</mo></mrow><mn>2</mn></msub><mo>&lt;</mo><mi>c</mi></mrow><mo lspace="0.170em" mathsize="1.200em" rspace="0.170em">|</mo><mi>𝐡</mi><mo maxsize="1.200em" minsize="1.200em">)</mo></mrow></mrow><mo>≲</mo><mrow><mn>1</mn><mo>/</mo><mrow><mo stretchy="false">(</mo><mrow><mi>T</mi><mo lspace="0em" rspace="0em">​</mo><msub><mi>φ</mi><mi>W</mi></msub><mo lspace="0em" rspace="0em">​</mo><msup><mrow><mo stretchy="false">(</mo><mi>λ</mi><mo stretchy="false">)</mo></mrow><msub><mi>r</mi><mn>2</mn></msub></msup></mrow><mo stretchy="false">)</mo></mrow></mrow></mrow><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">\mathbb{P}\big(\|\widehat{\mathbf{m}}_{\lambda}(\mathbf{Z}_{2,T+1})\|_{2}&lt;c\,\big|\,\mathbf{h}\big)\lesssim 1/(T\varphi_{W}(\lambda)^{r_{2}}).</annotation></semantics></math> All implicit constants and the constant <math id="A4.p2.m8" class="ltx_Math" alttext="c" display="inline" intent=":literal"><semantics><mi>c</mi><annotation encoding="application/x-tex">c</annotation></semantics></math> depend only on <math id="A4.p2.m9" class="ltx_Math" alttext="(m_{1},m_{2},r_{1},r_{2},\delta_{1},\delta_{2},\beta_{1},\beta_{2},\|\mathbf{g}_{0}\|_{\mathcal{C}^{\beta_{1}}},\sup_{\mathbf{h}\in\mathcal{H}}\|\mathbf{h}\|_{\mathcal{C}^{\beta_{2}}})" display="inline" intent=":literal"><semantics><mrow><mo stretchy="false">(</mo><msub><mi>m</mi><mn>1</mn></msub><mo>,</mo><msub><mi>m</mi><mn>2</mn></msub><mo>,</mo><msub><mi>r</mi><mn>1</mn></msub><mo>,</mo><msub><mi>r</mi><mn>2</mn></msub><mo>,</mo><msub><mi>δ</mi><mn>1</mn></msub><mo>,</mo><msub><mi>δ</mi><mn>2</mn></msub><mo>,</mo><msub><mi>β</mi><mn>1</mn></msub><mo>,</mo><msub><mi>β</mi><mn>2</mn></msub><mo>,</mo><msub><mrow><mo stretchy="false">‖</mo><msub><mi>𝐠</mi><mn>0</mn></msub><mo stretchy="false">‖</mo></mrow><msup><mi class="ltx_font_mathcaligraphic">𝒞</mi><msub><mi>β</mi><mn>1</mn></msub></msup></msub><mo>,</mo><mrow><msub><mo lspace="0em" rspace="0em">sup</mo><mrow><mi>𝐡</mi><mo>∈</mo><mi class="ltx_font_mathcaligraphic">ℋ</mi></mrow></msub><msub><mrow><mo stretchy="false">‖</mo><mi>𝐡</mi><mo stretchy="false">‖</mo></mrow><msup><mi class="ltx_font_mathcaligraphic">𝒞</mi><msub><mi>β</mi><mn>2</mn></msub></msup></msub></mrow><mo stretchy="false">)</mo></mrow><annotation encoding="application/x-tex">(m_{1},m_{2},r_{1},r_{2},\delta_{1},\delta_{2},\beta_{1},\beta_{2},\|\mathbf{g}_{0}\|_{\mathcal{C}^{\beta_{1}}},\sup_{\mathbf{h}\in\mathcal{H}}\|\mathbf{h}\|_{\mathcal{C}^{\beta_{2}}})</annotation></semantics></math>.</p>
</div>
<div id="A4.2" class="ltx_proof">
<h6 class="ltx_title ltx_runin ltx_font_italic ltx_title_proof">Proof of Theorem <a href="#Thmconj24" title="Theorem 4. ‣ 4.1 Proof of the risk bound ‣ 4 Risk bound ‣ Generalization Bounds for Transformer-Based Next-Token Prediction in a Language Model" class="ltx_ref"><span class="ltx_text ltx_ref_tag">4</span></a>.</h6>
<div id="A4.p3" class="ltx_para">
<p id="A4.p3.1" class="ltx_p"><span id="A4.p3.1.1" class="ltx_text">We construct a transformer
<math id="A4.p3.m1" class="ltx_Math" alttext="\mathbf{f}^{*}\in\mathcal{T}_{M}(W,T,L,N,H,L_{\mathrm{mlp}},N_{\mathrm{mlp}},B)" display="inline" intent=":literal"><semantics><mrow><msup><mi>𝐟</mi><mo>∗</mo></msup><mo>∈</mo><mrow><msub><mi class="ltx_font_mathcaligraphic">𝒯</mi><mi>M</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>W</mi><mo>,</mo><mi>T</mi><mo>,</mo><mi>L</mi><mo>,</mo><mi>N</mi><mo>,</mo><mi>H</mi><mo>,</mo><msub><mi>L</mi><mi>mlp</mi></msub><mo>,</mo><msub><mi>N</mi><mi>mlp</mi></msub><mo>,</mo><mi>B</mi><mo stretchy="false">)</mo></mrow></mrow></mrow><annotation encoding="application/x-tex">\mathbf{f}^{*}\in\mathcal{T}_{M}(W,T,L,N,H,L_{\mathrm{mlp}},N_{\mathrm{mlp}},B)</annotation></semantics></math> defined by</span></p>
<table id="A4.Ex146" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="A4.Ex146.m1" class="ltx_math_unparsed" alttext="\mathbf{f}^{*}(X)=\operatorname{clip}_{M}\circ\,\Big(D\cdot\bm{\nu}_{2}\circ\bm{\mu}_{2}\circ\bm{\nu}_{1}\circ\bm{\mu}_{1}(P+EX)\Big)_{:,T}," display="block" intent=":literal"><semantics><mrow><msup><mi>𝐟</mi><mo>∗</mo></msup><mrow><mo stretchy="false">(</mo><mi>X</mi><mo stretchy="false">)</mo></mrow><mo>=</mo><msub><mi>clip</mi><mi>M</mi></msub><mo lspace="0em" rspace="0.392em">∘</mo><msub><mrow><mo maxsize="1.600em" minsize="1.600em">(</mo><mi>D</mi><mo lspace="0.222em" rspace="0.222em">⋅</mo><msub><mi>𝝂</mi><mn>2</mn></msub><mo lspace="0.222em" rspace="0.222em">∘</mo><msub><mi>𝝁</mi><mn>2</mn></msub><mo lspace="0.222em" rspace="0.222em">∘</mo><msub><mi>𝝂</mi><mn>1</mn></msub><mo lspace="0.222em" rspace="0.222em">∘</mo><msub><mi>𝝁</mi><mn>1</mn></msub><mrow><mo stretchy="false">(</mo><mi>P</mi><mo>+</mo><mi>E</mi><mi>X</mi><mo stretchy="false">)</mo></mrow><mo maxsize="1.600em" minsize="1.600em">)</mo></mrow><mrow><mo rspace="0em">:</mo><mo>,</mo><mi>T</mi></mrow></msub><mo>,</mo></mrow><annotation encoding="application/x-tex">\mathbf{f}^{*}(X)=\operatorname{clip}_{M}\circ\,\Big(D\cdot\bm{\nu}_{2}\circ\bm{\mu}_{2}\circ\bm{\nu}_{1}\circ\bm{\mu}_{1}(P+EX)\Big)_{:,T},</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="A4.p3.2" class="ltx_p"><span id="A4.p3.2.1" class="ltx_text">where <math id="A4.p3.m2" class="ltx_Math" alttext="E,D^{\top}\in\mathbb{R}^{N\times W}" display="inline" intent=":literal"><semantics><mrow><mi>E</mi><mo>,</mo><mrow><msup><mi>D</mi><mo>⊤</mo></msup><mo>∈</mo><msup><mi>ℝ</mi><mrow><mi>N</mi><mo lspace="0.222em" rspace="0.222em">×</mo><mi>W</mi></mrow></msup></mrow></mrow><annotation encoding="application/x-tex">E,D^{\top}\in\mathbb{R}^{N\times W}</annotation></semantics></math>, <math id="A4.p3.m3" class="ltx_Math" alttext="\bm{\mu}_{1},\bm{\mu}_{2}\in\mathcal{MA}(N,H,B)" display="inline" intent=":literal"><semantics><mrow><msub><mi>𝝁</mi><mn>1</mn></msub><mo>,</mo><mrow><msub><mi>𝝁</mi><mn>2</mn></msub><mo>∈</mo><mrow><mi class="ltx_font_mathcaligraphic">ℳ</mi><mo lspace="0em" rspace="0em">​</mo><mi class="ltx_font_mathcaligraphic">𝒜</mi><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>N</mi><mo>,</mo><mi>H</mi><mo>,</mo><mi>B</mi><mo stretchy="false">)</mo></mrow></mrow></mrow></mrow><annotation encoding="application/x-tex">\bm{\mu}_{1},\bm{\mu}_{2}\in\mathcal{MA}(N,H,B)</annotation></semantics></math> and <math id="A4.p3.m4" class="ltx_Math" alttext="\bm{\nu}_{1},\bm{\nu}_{2}\in\mathcal{MLP}(N,L_{\mathrm{mlp}},N_{\mathrm{mlp}},B)" display="inline" intent=":literal"><semantics><mrow><msub><mi>𝝂</mi><mn>1</mn></msub><mo>,</mo><mrow><msub><mi>𝝂</mi><mn>2</mn></msub><mo>∈</mo><mrow><mi class="ltx_font_mathcaligraphic">ℳ</mi><mo lspace="0em" rspace="0em">​</mo><mi class="ltx_font_mathcaligraphic">ℒ</mi><mo lspace="0em" rspace="0em">​</mo><mi class="ltx_font_mathcaligraphic">𝒫</mi><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>N</mi><mo>,</mo><msub><mi>L</mi><mi>mlp</mi></msub><mo>,</mo><msub><mi>N</mi><mi>mlp</mi></msub><mo>,</mo><mi>B</mi><mo stretchy="false">)</mo></mrow></mrow></mrow></mrow><annotation encoding="application/x-tex">\bm{\nu}_{1},\bm{\nu}_{2}\in\mathcal{MLP}(N,L_{\mathrm{mlp}},N_{\mathrm{mlp}},B)</annotation></semantics></math>.
For the encoding matrix
<math id="A4.p3.m5" class="ltx_Math" alttext="E" display="inline" intent=":literal"><semantics><mi>E</mi><annotation encoding="application/x-tex">E</annotation></semantics></math>,
we use</span></p>
<table id="A4.Ex147" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="A4.Ex147.m1" class="ltx_Math" alttext="E\coloneq\left[\begin{matrix}\bm{\phi}_{1}(\mathbf{e}_{1})&amp;\bm{\phi}_{1}(\mathbf{e}_{2})&amp;\cdots&amp;\bm{\phi}_{1}(\mathbf{e}_{W})\\
\bm{\phi}_{2}(\mathbf{e}_{1})&amp;\bm{\phi}_{2}(\mathbf{e}_{2})&amp;\cdots&amp;\bm{\phi}_{2}(\mathbf{e}_{W})\\
\bm{0}_{N-m_{1}-m_{2}}&amp;\bm{0}_{N-m_{1}-m_{2}}&amp;\cdots&amp;\bm{0}_{N-m_{1}-m_{2}}\end{matrix}\right],\quad D\coloneq E^{\top}." display="block" intent=":literal"><semantics><mrow><mrow><mrow><mi>E</mi><mo>≔</mo><mrow><mo>[</mo><mtable columnspacing="5pt" displaystyle="true" rowspacing="0pt"><mtr><mtd><mrow><msub><mi class="ltx_mathvariant_bold-italic" mathvariant="bold-italic">ϕ</mi><mn>1</mn></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mi>𝐞</mi><mn>1</mn></msub><mo stretchy="false">)</mo></mrow></mrow></mtd><mtd><mrow><msub><mi class="ltx_mathvariant_bold-italic" mathvariant="bold-italic">ϕ</mi><mn>1</mn></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mi>𝐞</mi><mn>2</mn></msub><mo stretchy="false">)</mo></mrow></mrow></mtd><mtd><mo>⋯</mo></mtd><mtd><mrow><msub><mi class="ltx_mathvariant_bold-italic" mathvariant="bold-italic">ϕ</mi><mn>1</mn></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mi>𝐞</mi><mi>W</mi></msub><mo stretchy="false">)</mo></mrow></mrow></mtd></mtr><mtr><mtd><mrow><msub><mi class="ltx_mathvariant_bold-italic" mathvariant="bold-italic">ϕ</mi><mn>2</mn></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mi>𝐞</mi><mn>1</mn></msub><mo stretchy="false">)</mo></mrow></mrow></mtd><mtd><mrow><msub><mi class="ltx_mathvariant_bold-italic" mathvariant="bold-italic">ϕ</mi><mn>2</mn></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mi>𝐞</mi><mn>2</mn></msub><mo stretchy="false">)</mo></mrow></mrow></mtd><mtd><mo>⋯</mo></mtd><mtd><mrow><msub><mi class="ltx_mathvariant_bold-italic" mathvariant="bold-italic">ϕ</mi><mn>2</mn></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mi>𝐞</mi><mi>W</mi></msub><mo stretchy="false">)</mo></mrow></mrow></mtd></mtr><mtr><mtd><msub><mn>𝟎</mn><mrow><mi>N</mi><mo>−</mo><msub><mi>m</mi><mn>1</mn></msub><mo>−</mo><msub><mi>m</mi><mn>2</mn></msub></mrow></msub></mtd><mtd><msub><mn>𝟎</mn><mrow><mi>N</mi><mo>−</mo><msub><mi>m</mi><mn>1</mn></msub><mo>−</mo><msub><mi>m</mi><mn>2</mn></msub></mrow></msub></mtd><mtd><mo>⋯</mo></mtd><mtd><msub><mn>𝟎</mn><mrow><mi>N</mi><mo>−</mo><msub><mi>m</mi><mn>1</mn></msub><mo>−</mo><msub><mi>m</mi><mn>2</mn></msub></mrow></msub></mtd></mtr></mtable><mo>]</mo></mrow></mrow><mo rspace="1.167em">,</mo><mrow><mi>D</mi><mo>≔</mo><msup><mi>E</mi><mo>⊤</mo></msup></mrow></mrow><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">E\coloneq\left[\begin{matrix}\bm{\phi}_{1}(\mathbf{e}_{1})&amp;\bm{\phi}_{1}(\mathbf{e}_{2})&amp;\cdots&amp;\bm{\phi}_{1}(\mathbf{e}_{W})\\
\bm{\phi}_{2}(\mathbf{e}_{1})&amp;\bm{\phi}_{2}(\mathbf{e}_{2})&amp;\cdots&amp;\bm{\phi}_{2}(\mathbf{e}_{W})\\
\bm{0}_{N-m_{1}-m_{2}}&amp;\bm{0}_{N-m_{1}-m_{2}}&amp;\cdots&amp;\bm{0}_{N-m_{1}-m_{2}}\end{matrix}\right],\quad D\coloneq E^{\top}.</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="A4.p3.3" class="ltx_p"><span id="A4.p3.3.1" class="ltx_text">Also, we use <math id="A4.p3.m6" class="ltx_Math" alttext="\bm{\mu}_{1},\bm{\mu}_{2}\in\mathcal{MA}(N,H,B)" display="inline" intent=":literal"><semantics><mrow><msub><mi>𝝁</mi><mn>1</mn></msub><mo>,</mo><mrow><msub><mi>𝝁</mi><mn>2</mn></msub><mo>∈</mo><mrow><mi class="ltx_font_mathcaligraphic">ℳ</mi><mo lspace="0em" rspace="0em">​</mo><mi class="ltx_font_mathcaligraphic">𝒜</mi><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>N</mi><mo>,</mo><mi>H</mi><mo>,</mo><mi>B</mi><mo stretchy="false">)</mo></mrow></mrow></mrow></mrow><annotation encoding="application/x-tex">\bm{\mu}_{1},\bm{\mu}_{2}\in\mathcal{MA}(N,H,B)</annotation></semantics></math> and
<math id="A4.p3.m7" class="ltx_Math" alttext="\bm{\nu}_{1}\in\mathcal{MLP}(N,L_{\mathrm{mlp}},N_{\mathrm{mlp}},B)" display="inline" intent=":literal"><semantics><mrow><msub><mi>𝝂</mi><mn>1</mn></msub><mo>∈</mo><mrow><mi class="ltx_font_mathcaligraphic">ℳ</mi><mo lspace="0em" rspace="0em">​</mo><mi class="ltx_font_mathcaligraphic">ℒ</mi><mo lspace="0em" rspace="0em">​</mo><mi class="ltx_font_mathcaligraphic">𝒫</mi><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>N</mi><mo>,</mo><msub><mi>L</mi><mi>mlp</mi></msub><mo>,</mo><msub><mi>N</mi><mi>mlp</mi></msub><mo>,</mo><mi>B</mi><mo stretchy="false">)</mo></mrow></mrow></mrow><annotation encoding="application/x-tex">\bm{\nu}_{1}\in\mathcal{MLP}(N,L_{\mathrm{mlp}},N_{\mathrm{mlp}},B)</annotation></semantics></math> defined in Lemma <a href="#Thmconj25" title="Lemma 5. ‣ 5 Proof Sketch of the Upper Bound for the Approximation Error ‣ Generalization Bounds for Transformer-Based Next-Token Prediction in a Language Model" class="ltx_ref"><span class="ltx_text ltx_ref_tag">5</span></a>, such that</span></p>
<table id="A4.EGx83" class="ltx_equationgroup ltx_eqn_align ltx_eqn_table">

<tbody id="A4.EGx83.1"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_align_right ltx_eqn_cell"><math id="A4.EGx83.m1" class="ltx_math_unparsed" alttext="\displaystyle\Big(\bm{\mu}_{2}\circ\bm{\nu}_{1}\circ\bm{\mu}_{1}\big(P+EX\big)\Big)_{:,T}=\left(\begin{matrix}\mathbf{k}_{1}\\
\bullet_{N-m_{1}-m_{2}}\\
\mathbf{k}_{2}\end{matrix}\right)\begin{array}[]{l}\in\mathbb{R}^{m_{1}}\\
\left.\right.\\
\in\mathbb{R}^{m_{2}}\end{array}" display="inline" intent=":literal"><semantics><mrow><msub><mrow><mo maxsize="1.600em" minsize="1.600em">(</mo><msub><mi>𝝁</mi><mn>2</mn></msub><mo lspace="0.222em" rspace="0.222em">∘</mo><msub><mi>𝝂</mi><mn>1</mn></msub><mo lspace="0.222em" rspace="0.222em">∘</mo><msub><mi>𝝁</mi><mn>1</mn></msub><mrow><mo maxsize="1.200em" minsize="1.200em">(</mo><mi>P</mi><mo>+</mo><mi>E</mi><mi>X</mi><mo maxsize="1.200em" minsize="1.200em">)</mo></mrow><mo maxsize="1.600em" minsize="1.600em">)</mo></mrow><mrow><mo rspace="0em">:</mo><mo>,</mo><mi>T</mi></mrow></msub><mo>=</mo><mrow><mo>(</mo><mtable rowspacing="0pt"><mtr><mtd><msub><mi>𝐤</mi><mn>1</mn></msub></mtd></mtr><mtr><mtd><mrow><mo>∙</mo><msub><mrow></mrow><mrow><mi>N</mi><mo>−</mo><msub><mi>m</mi><mn>1</mn></msub><mo>−</mo><msub><mi>m</mi><mn>2</mn></msub></mrow></msub></mrow></mtd></mtr><mtr><mtd><msub><mi>𝐤</mi><mn>2</mn></msub></mtd></mtr></mtable><mo rspace="0.167em">)</mo></mrow><mtable rowspacing="0pt"><mtr><mtd class="ltx_align_left" columnalign="left"><mrow><mphantom></mphantom><mo>∈</mo><msup><mi>ℝ</mi><msub><mi>m</mi><mn>1</mn></msub></msup></mrow></mtd></mtr><mtr><mtd class="ltx_align_left" columnalign="left"><mphantom></mphantom></mtd></mtr><mtr><mtd class="ltx_align_left" columnalign="left"><mrow><mphantom></mphantom><mo>∈</mo><msup><mi>ℝ</mi><msub><mi>m</mi><mn>2</mn></msub></msup></mrow></mtd></mtr></mtable></mrow><annotation encoding="application/x-tex">\displaystyle\Big(\bm{\mu}_{2}\circ\bm{\nu}_{1}\circ\bm{\mu}_{1}\big(P+EX\big)\Big)_{:,T}=\left(\begin{matrix}\mathbf{k}_{1}\\
\bullet_{N-m_{1}-m_{2}}\\
\mathbf{k}_{2}\end{matrix}\right)\begin{array}[]{l}\in\mathbb{R}^{m_{1}}\\
\left.\right.\\
\in\mathbb{R}^{m_{2}}\end{array}</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="A4.p3.4" class="ltx_p"><span id="A4.p3.4.1" class="ltx_text">with</span></p>
<table id="A4.EGx84" class="ltx_equationgroup ltx_eqn_align ltx_eqn_table">

<tbody id="A4.Ex151"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_align_right ltx_eqn_cell"><math id="A4.Ex151.m1" class="ltx_Math" alttext="\displaystyle\big\|\mathbf{k}_{1}-\mathbf{g}_{0}(\mathbf{Z}_{1,T+1})\big\|_{\infty}\vee\,\left\|\mathbf{k}_{2}-\widehat{\mathbf{m}}_{\lambda}(\mathbf{Z}_{2,T+1})\right\|_{\infty}\lesssim(N_{\mathrm{mlp}})^{-\frac{2\beta_{1}}{m_{1}r_{1}}}+\frac{1}{T}." display="inline" intent=":literal"><semantics><mrow><mrow><mrow><msub><mrow><mo maxsize="1.200em" minsize="1.200em" stretchy="true">‖</mo><mrow><msub><mi>𝐤</mi><mn>1</mn></msub><mo>−</mo><mrow><msub><mi>𝐠</mi><mn>0</mn></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mi>𝐙</mi><mrow><mn>1</mn><mo>,</mo><mrow><mi>T</mi><mo>+</mo><mn>1</mn></mrow></mrow></msub><mo stretchy="false">)</mo></mrow></mrow></mrow><mo maxsize="1.200em" minsize="1.200em" stretchy="true">‖</mo></mrow><mi mathvariant="normal">∞</mi></msub><mo rspace="0.392em">∨</mo><msub><mrow><mo>‖</mo><mrow><msub><mi>𝐤</mi><mn>2</mn></msub><mo>−</mo><mrow><msub><mover accent="true"><mi>𝐦</mi><mo>^</mo></mover><mi>λ</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mi>𝐙</mi><mrow><mn>2</mn><mo>,</mo><mrow><mi>T</mi><mo>+</mo><mn>1</mn></mrow></mrow></msub><mo stretchy="false">)</mo></mrow></mrow></mrow><mo>‖</mo></mrow><mi mathvariant="normal">∞</mi></msub></mrow><mo>≲</mo><mrow><msup><mrow><mo stretchy="false">(</mo><msub><mi>N</mi><mi>mlp</mi></msub><mo stretchy="false">)</mo></mrow><mrow><mo>−</mo><mfrac><mrow><mn>2</mn><mo lspace="0em" rspace="0em">​</mo><msub><mi>β</mi><mn>1</mn></msub></mrow><mrow><msub><mi>m</mi><mn>1</mn></msub><mo lspace="0em" rspace="0em">​</mo><msub><mi>r</mi><mn>1</mn></msub></mrow></mfrac></mrow></msup><mo>+</mo><mstyle displaystyle="true"><mfrac><mn>1</mn><mi>T</mi></mfrac></mstyle></mrow></mrow><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">\displaystyle\big\|\mathbf{k}_{1}-\mathbf{g}_{0}(\mathbf{Z}_{1,T+1})\big\|_{\infty}\vee\,\left\|\mathbf{k}_{2}-\widehat{\mathbf{m}}_{\lambda}(\mathbf{Z}_{2,T+1})\right\|_{\infty}\lesssim(N_{\mathrm{mlp}})^{-\frac{2\beta_{1}}{m_{1}r_{1}}}+\frac{1}{T}.</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="A4.p3.5" class="ltx_p"><span id="A4.p3.5.1" class="ltx_text">Applying Lemma <a href="#Thmconj225" title="Lemma 25. ‣ E.2 Construction of multilayer perceptron layers ‣ Appendix E Construction of the Transformer ‣ Generalization Bounds for Transformer-Based Next-Token Prediction in a Language Model" class="ltx_ref"><span class="ltx_text ltx_ref_tag">25</span></a> with <math id="A4.p3.m8" class="ltx_Math" alttext="M=\lceil\log_{2}T\rceil^{2}" display="inline" intent=":literal"><semantics><mrow><mi>M</mi><mo>=</mo><msup><mrow><mo stretchy="false">⌈</mo><mrow><msub><mi>log</mi><mn>2</mn></msub><mo lspace="0.167em">⁡</mo><mi>T</mi></mrow><mo stretchy="false">⌉</mo></mrow><mn>2</mn></msup></mrow><annotation encoding="application/x-tex">M=\lceil\log_{2}T\rceil^{2}</annotation></semantics></math>, there exists a multilayer perceptron <math id="A4.p3.m9" class="ltx_Math" alttext="\bm{\nu}_{2}\in\mathcal{MLP}(N,L_{\mathrm{mlp}},N_{\mathrm{mlp}},B)" display="inline" intent=":literal"><semantics><mrow><msub><mi>𝝂</mi><mn>2</mn></msub><mo>∈</mo><mrow><mi class="ltx_font_mathcaligraphic">ℳ</mi><mo lspace="0em" rspace="0em">​</mo><mi class="ltx_font_mathcaligraphic">ℒ</mi><mo lspace="0em" rspace="0em">​</mo><mi class="ltx_font_mathcaligraphic">𝒫</mi><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>N</mi><mo>,</mo><msub><mi>L</mi><mi>mlp</mi></msub><mo>,</mo><msub><mi>N</mi><mi>mlp</mi></msub><mo>,</mo><mi>B</mi><mo stretchy="false">)</mo></mrow></mrow></mrow><annotation encoding="application/x-tex">\bm{\nu}_{2}\in\mathcal{MLP}(N,L_{\mathrm{mlp}},N_{\mathrm{mlp}},B)</annotation></semantics></math>
satisfying</span></p>
<table id="A4.Ex152" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="A4.Ex152.m1" class="ltx_Math" alttext="\left\|\bm{\nu}_{2}\left(\begin{matrix}\mathbf{a}_{1}\\
\mathbf{a}_{2}\\
\mathbf{a}_{3}\end{matrix}\right)-\left(\begin{matrix}\mathbf{a}_{1}\\
\delta_{2}\mathbf{a}_{3}/\|\mathbf{a}_{3}\|_{2}\\
\bm{0}_{N-m_{1}-m_{2}}\end{matrix}\right)\right\|_{\infty}\lesssim\frac{1}{T}," display="block" intent=":literal"><semantics><mrow><mrow><msub><mrow><mo>‖</mo><mrow><mrow><msub><mi>𝝂</mi><mn>2</mn></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo>(</mo><mtable displaystyle="true" rowspacing="0pt"><mtr><mtd><msub><mi>𝐚</mi><mn>1</mn></msub></mtd></mtr><mtr><mtd><msub><mi>𝐚</mi><mn>2</mn></msub></mtd></mtr><mtr><mtd><msub><mi>𝐚</mi><mn>3</mn></msub></mtd></mtr></mtable><mo>)</mo></mrow></mrow><mo>−</mo><mrow><mo>(</mo><mtable displaystyle="true" rowspacing="0pt"><mtr><mtd><msub><mi>𝐚</mi><mn>1</mn></msub></mtd></mtr><mtr><mtd><mrow><mrow><msub><mi>δ</mi><mn>2</mn></msub><mo lspace="0em" rspace="0em">​</mo><msub><mi>𝐚</mi><mn>3</mn></msub></mrow><mo>/</mo><msub><mrow><mo stretchy="false">‖</mo><msub><mi>𝐚</mi><mn>3</mn></msub><mo stretchy="false">‖</mo></mrow><mn>2</mn></msub></mrow></mtd></mtr><mtr><mtd><msub><mn>𝟎</mn><mrow><mi>N</mi><mo>−</mo><msub><mi>m</mi><mn>1</mn></msub><mo>−</mo><msub><mi>m</mi><mn>2</mn></msub></mrow></msub></mtd></mtr></mtable><mo>)</mo></mrow></mrow><mo>‖</mo></mrow><mi mathvariant="normal">∞</mi></msub><mo>≲</mo><mfrac><mn>1</mn><mi>T</mi></mfrac></mrow><mo>,</mo></mrow><annotation encoding="application/x-tex">\left\|\bm{\nu}_{2}\left(\begin{matrix}\mathbf{a}_{1}\\
\mathbf{a}_{2}\\
\mathbf{a}_{3}\end{matrix}\right)-\left(\begin{matrix}\mathbf{a}_{1}\\
\delta_{2}\mathbf{a}_{3}/\|\mathbf{a}_{3}\|_{2}\\
\bm{0}_{N-m_{1}-m_{2}}\end{matrix}\right)\right\|_{\infty}\lesssim\frac{1}{T},</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="A4.p3.6" class="ltx_p"><span id="A4.p3.6.1" class="ltx_text">for all <math id="A4.p3.m10" class="ltx_Math" alttext="\mathbf{a}_{1}\in\mathbb{R}^{m_{1}},\mathbf{a}_{2}\in\mathbb{R}^{N-m_{1}-m_{2}}" display="inline" intent=":literal"><semantics><mrow><mrow><msub><mi>𝐚</mi><mn>1</mn></msub><mo>∈</mo><msup><mi>ℝ</mi><msub><mi>m</mi><mn>1</mn></msub></msup></mrow><mo>,</mo><mrow><msub><mi>𝐚</mi><mn>2</mn></msub><mo>∈</mo><msup><mi>ℝ</mi><mrow><mi>N</mi><mo>−</mo><msub><mi>m</mi><mn>1</mn></msub><mo>−</mo><msub><mi>m</mi><mn>2</mn></msub></mrow></msup></mrow></mrow><annotation encoding="application/x-tex">\mathbf{a}_{1}\in\mathbb{R}^{m_{1}},\mathbf{a}_{2}\in\mathbb{R}^{N-m_{1}-m_{2}}</annotation></semantics></math>, and <math id="A4.p3.m11" class="ltx_Math" alttext="\mathbf{a}_{3}\in\mathbb{R}^{m_{2}}" display="inline" intent=":literal"><semantics><mrow><msub><mi>𝐚</mi><mn>3</mn></msub><mo>∈</mo><msup><mi>ℝ</mi><msub><mi>m</mi><mn>2</mn></msub></msup></mrow><annotation encoding="application/x-tex">\mathbf{a}_{3}\in\mathbb{R}^{m_{2}}</annotation></semantics></math> with <math id="A4.p3.m12" class="ltx_Math" alttext="c/2\leq\|\mathbf{a}_{3}\|_{2}\leq\exp(\delta_{1}m_{1})+2" display="inline" intent=":literal"><semantics><mrow><mrow><mi>c</mi><mo>/</mo><mn>2</mn></mrow><mo>≤</mo><msub><mrow><mo stretchy="false">‖</mo><msub><mi>𝐚</mi><mn>3</mn></msub><mo stretchy="false">‖</mo></mrow><mn>2</mn></msub><mo>≤</mo><mrow><mrow><mi>exp</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mrow><msub><mi>δ</mi><mn>1</mn></msub><mo lspace="0em" rspace="0em">​</mo><msub><mi>m</mi><mn>1</mn></msub></mrow><mo stretchy="false">)</mo></mrow></mrow><mo>+</mo><mn>2</mn></mrow></mrow><annotation encoding="application/x-tex">c/2\leq\|\mathbf{a}_{3}\|_{2}\leq\exp(\delta_{1}m_{1})+2</annotation></semantics></math>.
Since <math id="A4.p3.m13" class="ltx_Math" alttext="\|\mathbf{Y}_{t}\|_{2}\leq\exp(\delta_{1}m_{1})" display="inline" intent=":literal"><semantics><mrow><msub><mrow><mo stretchy="false">‖</mo><msub><mi>𝐘</mi><mi>t</mi></msub><mo stretchy="false">‖</mo></mrow><mn>2</mn></msub><mo>≤</mo><mrow><mi>exp</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mrow><msub><mi>δ</mi><mn>1</mn></msub><mo lspace="0em" rspace="0em">​</mo><msub><mi>m</mi><mn>1</mn></msub></mrow><mo stretchy="false">)</mo></mrow></mrow></mrow><annotation encoding="application/x-tex">\|\mathbf{Y}_{t}\|_{2}\leq\exp(\delta_{1}m_{1})</annotation></semantics></math> for every <math id="A4.p3.m14" class="ltx_Math" alttext="t\in[T]" display="inline" intent=":literal"><semantics><mrow><mi>t</mi><mo>∈</mo><mrow><mo stretchy="false">[</mo><mi>T</mi><mo stretchy="false">]</mo></mrow></mrow><annotation encoding="application/x-tex">t\in[T]</annotation></semantics></math>, we have
<math id="A4.p3.m15" class="ltx_Math" alttext="\|\widehat{\mathbf{m}}_{\lambda}(\mathbf{Z}_{2,T+1})\|_{2}\leq\exp(\delta_{1}m_{1})" display="inline" intent=":literal"><semantics><mrow><msub><mrow><mo stretchy="false">‖</mo><mrow><msub><mover accent="true"><mi>𝐦</mi><mo>^</mo></mover><mi>λ</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mi>𝐙</mi><mrow><mn>2</mn><mo>,</mo><mrow><mi>T</mi><mo>+</mo><mn>1</mn></mrow></mrow></msub><mo stretchy="false">)</mo></mrow></mrow><mo stretchy="false">‖</mo></mrow><mn>2</mn></msub><mo>≤</mo><mrow><mi>exp</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mrow><msub><mi>δ</mi><mn>1</mn></msub><mo lspace="0em" rspace="0em">​</mo><msub><mi>m</mi><mn>1</mn></msub></mrow><mo stretchy="false">)</mo></mrow></mrow></mrow><annotation encoding="application/x-tex">\|\widehat{\mathbf{m}}_{\lambda}(\mathbf{Z}_{2,T+1})\|_{2}\leq\exp(\delta_{1}m_{1})</annotation></semantics></math> and hence
<math id="A4.p3.m16" class="ltx_Math" alttext="\|\mathbf{k}_{2}\|_{2}\leq\exp(\delta_{1}m_{1})+2" display="inline" intent=":literal"><semantics><mrow><msub><mrow><mo stretchy="false">‖</mo><msub><mi>𝐤</mi><mn>2</mn></msub><mo stretchy="false">‖</mo></mrow><mn>2</mn></msub><mo>≤</mo><mrow><mrow><mi>exp</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mrow><msub><mi>δ</mi><mn>1</mn></msub><mo lspace="0em" rspace="0em">​</mo><msub><mi>m</mi><mn>1</mn></msub></mrow><mo stretchy="false">)</mo></mrow></mrow><mo>+</mo><mn>2</mn></mrow></mrow><annotation encoding="application/x-tex">\|\mathbf{k}_{2}\|_{2}\leq\exp(\delta_{1}m_{1})+2</annotation></semantics></math>, provided that <math id="A4.p3.m17" class="ltx_Math" alttext="N_{mlp}" display="inline" intent=":literal"><semantics><msub><mi>N</mi><mrow><mi>m</mi><mo lspace="0em" rspace="0em">​</mo><mi>l</mi><mo lspace="0em" rspace="0em">​</mo><mi>p</mi></mrow></msub><annotation encoding="application/x-tex">N_{mlp}</annotation></semantics></math> and <math id="A4.p3.m18" class="ltx_Math" alttext="T" display="inline" intent=":literal"><semantics><mi>T</mi><annotation encoding="application/x-tex">T</annotation></semantics></math> are sufficiently large. Combining these inequalities with (<a href="#A4.E48" title="In Appendix D Proofs for the Approximation Error ‣ Generalization Bounds for Transformer-Based Next-Token Prediction in a Language Model" class="ltx_ref"><span class="ltx_text ltx_ref_tag">48</span></a>) and <math id="A4.p3.m19" class="ltx_Math" alttext="\varphi_{W}(\lambda)\leq 1" display="inline" intent=":literal"><semantics><mrow><mrow><msub><mi>φ</mi><mi>W</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>λ</mi><mo stretchy="false">)</mo></mrow></mrow><mo>≤</mo><mn>1</mn></mrow><annotation encoding="application/x-tex">\varphi_{W}(\lambda)\leq 1</annotation></semantics></math>, we obtain for sufficiently large <math id="A4.p3.m20" class="ltx_Math" alttext="N_{\mathrm{mlp}}" display="inline" intent=":literal"><semantics><msub><mi>N</mi><mi>mlp</mi></msub><annotation encoding="application/x-tex">N_{\mathrm{mlp}}</annotation></semantics></math> and <math id="A4.p3.m21" class="ltx_Math" alttext="T" display="inline" intent=":literal"><semantics><mi>T</mi><annotation encoding="application/x-tex">T</annotation></semantics></math></span></p>
<table id="A4.EGx85" class="ltx_equationgroup ltx_eqn_align ltx_eqn_table">

<tbody id="A4.Ex153"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_eqn_cell"></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A4.Ex153.m1" class="ltx_math_unparsed" alttext="\displaystyle\mathbb{E}\left[\left\|\Big(\bm{\nu}_{2}\circ\bm{\mu}_{2}\circ\bm{\nu}_{1}\circ\bm{\mu}_{1}\big(P+EX\big)\Big)_{:,T}-\left(\begin{matrix}\mathbf{g}_{0}(\mathbf{Z}_{1,T+1})\\
\mathbf{h}(\mathbf{Z}_{2,T+1})\\
\bm{0}_{N-m_{1}-m_{2}}\\
