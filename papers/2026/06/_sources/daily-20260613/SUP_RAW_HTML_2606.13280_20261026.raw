<p id="A3.I1.ix3.p1.1" class="ltx_p"><span id="A3.I1.ix3.p1.1.1" class="ltx_text ltx_font_italic">For </span><math id="A3.I1.ix3.p1.m1" class="ltx_Math" alttext="A,B,L_{\mathrm{mlp}}\geq 1" display="inline" intent=":literal"><semantics><mrow><mi>A</mi><mo>,</mo><mi>B</mi><mo>,</mo><mrow><msub><mi>L</mi><mi>mlp</mi></msub><mo>≥</mo><mn>1</mn></mrow></mrow><annotation encoding="application/x-tex">A,B,L_{\mathrm{mlp}}\geq 1</annotation></semantics></math><span id="A3.I1.ix3.p1.1.2" class="ltx_text ltx_font_italic"> and </span><math id="A3.I1.ix3.p1.m2" class="ltx_Math" alttext="N\leq N_{\mathrm{mlp}}" display="inline" intent=":literal"><semantics><mrow><mi>N</mi><mo>≤</mo><msub><mi>N</mi><mi>mlp</mi></msub></mrow><annotation encoding="application/x-tex">N\leq N_{\mathrm{mlp}}</annotation></semantics></math><span id="A3.I1.ix3.p1.1.3" class="ltx_text ltx_font_italic">,</span></p>
