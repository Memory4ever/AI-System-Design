">​</mo><mrow><mo stretchy="false">(</mo><msub><mi>𝐞</mi><mi>w</mi></msub><mo stretchy="false">)</mo></mrow></mrow></mrow><mo maxsize="1.200em" minsize="1.200em">)</mo></mrow></mrow></mrow></mfrac></mstyle><mo lspace="0em" rspace="0em" stretchy="true">|</mo><mi>𝐡</mi><mo>,</mo><msub><mi>𝐙</mi><mrow><mn>2</mn><mo>,</mo><mrow><mi>T</mi><mo>+</mo><mn>1</mn></mrow></mrow></msub><mo>=</mo><mi>𝐳</mi><mo>]</mo></mrow></mrow><annotation encoding="application/x-tex">\displaystyle=\mathbb{E}\left[\frac{\sum_{w=1}^{W}\exp\big(\mathbf{g}_{0}(\mathbf{Z}_{1,T+1})^{\top}\bm{\phi}_{1}(\mathbf{e}_{w})+\mathbf{h}(\mathbf{z})^{\top}\bm{\phi}_{2}(\mathbf{e}_{w})\big)\frac{\bm{\phi}_{2}(\mathbf{e}_{w})}{\exp\big(\mathbf{g}_{0}(\mathbf{Z}_{1,T+1})^{\top}\bm{\phi}_{1}(\mathbf{e}_{w})\big)}}{\sum_{w=1}^{W}\exp\big(\mathbf{g}_{0}(\mathbf{Z}_{1,T+1})^{\top}\bm{\phi}_{1}(\mathbf{e}_{w})+\mathbf{h}(\mathbf{z})^{\top}\bm{\phi}_{2}(\mathbf{e}_{w})\big)}\middle|\mathbf{h},\mathbf{Z}_{2,T+1}=\mathbf{z}\right]</annotation></semantics></math></td>
