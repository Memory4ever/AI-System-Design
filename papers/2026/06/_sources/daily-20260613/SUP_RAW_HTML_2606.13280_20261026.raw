<td class="ltx_td ltx_align_right ltx_eqn_cell"><math id="A3.E41.m1" class="ltx_Math" alttext="\displaystyle\sup_{\mathbf{f}_{\bm{\theta}}\in\mathcal{MA}(N,H,B),\,X,X^{\prime}\in[-A,A]^{N\times T},\,X\neq X^{\prime}}\,\frac{\|\mathbf{f}_{\bm{\theta}}(X)-\mathbf{f}_{\bm{\theta}}(X^{\prime})\|_{\infty}}{\|X-X^{\prime}\|_{\infty}}" display="inline" intent=":literal"><semantics><mrow><munder><mo movablelimits="false">sup</mo><mrow><mrow><msub><mi>𝐟</mi><mi>𝜽</mi></msub><mo>∈</mo><mrow><mi class="ltx_font_mathcaligraphic">ℳ</mi><mo lspace="0em" rspace="0em">​</mo><mi class="ltx_font_mathcaligraphic">𝒜</mi><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>N</mi><mo>,</mo><mi>H</mi><mo>,</mo><mi>B</mi><mo stretchy="false">)</mo></mrow></mrow></mrow><mo rspace="0.337em">,</mo><mi>X</mi><mo>,</mo><mrow><msup><mi>X</mi><mo>′</mo></msup><mo>∈</mo><msup><mrow><mo stretchy="false">[</mo><mrow><mrow><mo>−</mo><mi>A</mi></mrow><mo>,</mo><mi>A</mi></mrow><mo stretchy="false">]</mo></mrow><mrow><mi>N</mi><mo lspace="0.222em" rspace="0.222em">×</mo><mi>T</mi></mrow></msup></mrow><mo rspace="0.337em">,</mo><mrow><mi>X</mi><mo>≠</mo><msup><mi>X</mi><mo>′</mo></msup></mrow></mrow></munder><mstyle displaystyle="true"><mfrac><msub><mrow><mo stretchy="false">‖</mo><mrow><mrow><msub><mi>𝐟</mi><mi>𝜽</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>X</mi><mo stretchy="false">)</mo></mrow></mrow><mo>−</mo><mrow><msub><mi>𝐟</mi><mi>𝜽</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msup><mi>X</mi><mo>′</mo></msup><mo stretchy="false">)</mo></mrow></mrow></mrow><mo stretchy="false">‖</mo></mrow><mi mathvariant="normal">∞</mi></msub><msub><mrow><mo stretchy="false">‖</mo><mrow><mi>X</mi><mo>−</mo><msup><mi>X</mi><mo>′</mo></msup></mrow><mo stretchy="false">‖</mo></mrow><mi mathvariant="normal">∞</mi></msub></mfrac></mstyle></mrow><annotation encoding="application/x-tex">\displaystyle\sup_{\mathbf{f}_{\bm{\theta}}\in\mathcal{MA}(N,H,B),\,X,X^{\prime}\in[-A,A]^{N\times T},\,X\neq X^{\prime}}\,\frac{\|\mathbf{f}_{\bm{\theta}}(X)-\mathbf{f}_{\bm{\theta}}(X^{\prime})\|_{\infty}}{\|X-X^{\prime}\|_{\infty}}</annotation></semantics></math></td>
