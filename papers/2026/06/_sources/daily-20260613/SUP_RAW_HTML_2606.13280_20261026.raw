<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_eqn_cell"></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A6.Ex377.m1" class="ltx_Math" alttext="\displaystyle\lesssim\mathbb{E}\big[\|P^{\perp}_{\bm{\alpha}}\widehat{\mathbf{m}}_{\lambda}(\mathbf{Z}_{2,T+1})\|^{2}_{2}\big|\mathbf{h}\big]+\mathbb{P}\big[\|P_{\bm{\alpha}}\widehat{\mathbf{m}}_{\lambda}(\mathbf{Z}_{2,T+1})\|_{2}&lt;c\big|\mathbf{h}\big]" display="inline" intent=":literal"><semantics><mrow><mphantom></mphantom><mo>≲</mo><mrow><mrow><mi>𝔼</mi><mo>⁡</mo><mrow><mo maxsize="1.200em" minsize="1.200em">[</mo><mrow><msubsup><mrow><mo stretchy="false">‖</mo><mrow><msubsup><mi>P</mi><mi>𝜶</mi><mo>⟂</mo></msubsup><mo lspace="0em" rspace="0em">​</mo><msub><mover accent="true"><mi>𝐦</mi><mo>^</mo></mover><mi>λ</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mi>𝐙</mi><mrow><mn>2</mn><mo>,</mo><mrow><mi>T</mi><mo>+</mo><mn>1</mn></mrow></mrow></msub><mo stretchy="false">)</mo></mrow></mrow><mo stretchy="false">‖</mo></mrow><mn>2</mn><mn>2</mn></msubsup><mo fence="false" maxsize="1.200em" minsize="1.200em" rspace="0.167em" stretchy="true">|</mo><mi>𝐡</mi></mrow><mo maxsize="1.200em" minsize="1.200em">]</mo></mrow></mrow><mo>+</mo><mrow><mi>ℙ</mi><mo>⁡</mo><mrow><mo maxsize="1.200em" minsize="1.200em">[</mo><mrow><mrow><msub><mrow><mo stretchy="false">‖</mo><mrow><msub><mi>P</mi><mi>𝜶</mi></msub><mo lspace="0em" rspace="0em">​</mo><msub><mover accent="true"><mi>𝐦</mi><mo>^</mo></mover><mi>λ</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mi>𝐙</mi><mrow><mn>2</mn><mo>,</mo><mrow><mi>T</mi><mo>+</mo><mn>1</mn></mrow></mrow></msub><mo stretchy="false">)</mo></mrow></mrow><mo stretchy="false">‖</mo></mrow><mn>2</mn></msub><mo>&lt;</mo><mi>c</mi></mrow><mo fence="false" maxsize="1.200em" minsize="1.200em" rspace="0.167em" stretchy="true">|</mo><mi>𝐡</mi></mrow><mo maxsize="1.200em" minsize="1.200em">]</mo></mrow></mrow></mrow></mrow><annotation encoding="application/x-tex">\displaystyle\lesssim\mathbb{E}\big[\|P^{\perp}_{\bm{\alpha}}\widehat{\mathbf{m}}_{\lambda}(\mathbf{Z}_{2,T+1})\|^{2}_{2}\big|\mathbf{h}\big]+\mathbb{P}\big[\|P_{\bm{\alpha}}\widehat{\mathbf{m}}_{\lambda}(\mathbf{Z}_{2,T+1})\|_{2}&lt;c\big|\mathbf{h}\big]</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
<tbody id="A6.E101"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_eqn_cell"></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A6.E101.m1" class="ltx_Math" alttext="\displaystyle=\tilde{O}\Big(\lambda^{2\beta_{2}}+\frac{1}{T\varphi_{W}(\lambda)^{r_{2}}}\Big)." display="inline" intent=":literal"><semantics><mrow><mrow><mphantom></mphantom><mo>=</mo><mrow><mover accent="true"><mi>O</mi><mo>~</mo></mover><mo lspace="0em" rspace="0em">​</mo><mrow><mo maxsize="1.600em" minsize="1.600em">(</mo><mrow><msup><mi>λ</mi><mrow><mn>2</mn><mo lspace="0em" rspace="0em">​</mo><msub><mi>β</mi><mn>2</mn></msub></mrow></msup><mo>+</mo><mstyle displaystyle="true"><mfrac><mn>1</mn><mrow><mi>T</mi><mo lspace="0em" rspace="0em">​</mo><msub><mi>φ</mi><mi>W</mi></msub><mo lspace="0em" rspace="0em">​</mo><msup><mrow><mo stretchy="false">(</mo><mi>λ</mi><mo stretchy="false">)</mo></mrow><msub><mi>r</mi><mn>2</mn></msub></msup></mrow></mfrac></mstyle></mrow><mo maxsize="1.600em" minsize="1.600em">)</mo></mrow></mrow></mrow><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">\displaystyle=\tilde{O}\Big(\lambda^{2\beta_{2}}+\frac{1}{T\varphi_{W}(\lambda)^{r_{2}}}\Big).</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td>
<td rowspan="1" class="ltx_eqn_cell ltx_eqn_eqno ltx_align_middle ltx_align_right"><span class="ltx_tag ltx_tag_equation ltx_align_right">(101)</span></td></tr></tbody>
</table>
<p id="A6.SS1.p5.8" class="ltx_p"><span id="A6.SS1.p5.8.1" class="ltx_text">In addition, by the definition of <math id="A6.SS1.p5.m12" class="ltx_Math" alttext="\kappa_{W}" display="inline" intent=":literal"><semantics><msub><mi>κ</mi><mi>W</mi></msub><annotation encoding="application/x-tex">\kappa_{W}</annotation></semantics></math> (Definition <a href="#S4.Thmconj1" title="Definition 4.1. ‣ 4 Risk bound ‣ Generalization Bounds for Transformer-Based Next-Token Prediction in a Language Model" class="ltx_ref"><span class="ltx_text ltx_ref_tag">4.1</span></a>),</span></p>
<table id="A6.Ex378" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="A6.Ex378.m1" class="ltx_Math" alttext="\bigg\|\underbrace{\overline{\sum}_{w\in[W]}\Big(\exp\big(\mathbf{h}(\mathbf{Z}_{2,T})^{\top}\bm{\phi}_{2}(\mathbf{e}_{w})\big)\,;\,\bm{\phi}_{2}(\mathbf{e}_{w})\Big)}_{\eqcolon\bm{\chi}_{1}}-\underbrace{\frac{\int_{\mathbf{u}\in\mathbb{S}^{m_{2}-1}}\exp(\mathbf{h}(\mathbf{Z}_{2,T})^{\top}\mathbf{u})\mathbf{u}\,d\mathbf{u}}{\int_{\mathbf{u}\in\mathbb{S}^{m_{2}-1}}\exp(\mathbf{h}(\mathbf{Z}_{2,T})^{\top}\mathbf{u})\,d\mathbf{u}}}_{\eqcolon\bm{\chi}_{2}}\bigg\|_{2}\leq\kappa_{W}." display="block" intent=":literal"><semantics><mrow><mrow><msub><mrow><mo maxsize="2.100em" minsize="2.100em" stretchy="true">‖</mo><mrow><munder><munder accentunder="true"><mrow><msub><mover accent="true"><mo lspace="0em" movablelimits="false">∑</mo><mo stretchy="true">¯</mo></mover><mrow><mi>w</mi><mo>∈</mo><mrow><mo stretchy="false">[</mo><mi>W</mi><mo stretchy="false">]</mo></mrow></mrow></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo maxsize="1.600em" minsize="1.600em">(</mo><mrow><mi>exp</mi><mo>⁡</mo><mrow><mo maxsize="1.200em" minsize="1.200em">(</mo><mrow><mi>𝐡</mi><mo lspace="0em" rspace="0em">​</mo><msup><mrow><mo stretchy="false">(</mo><msub><mi>𝐙</mi><mrow><mn>2</mn><mo>,</mo><mi>T</mi></mrow></msub><mo stretchy="false">)</mo></mrow><mo>⊤</mo></msup><mo lspace="0em" rspace="0em">​</mo><msub><mi class="ltx_mathvariant_bold-italic" mathvariant="bold-italic">ϕ</mi><mn>2</mn></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mi>𝐞</mi><mi>w</mi></msub><mo stretchy="false">)</mo></mrow></mrow><mo maxsize="1.200em" minsize="1.200em" rspace="0.170em">)</mo></mrow></mrow><mo>,</mo><mrow><msub><mi class="ltx_mathvariant_bold-italic" mathvariant="bold-italic">ϕ</mi><mn>2</mn></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mi>𝐞</mi><mi>w</mi></msub><mo stretchy="false">)</mo></mrow></mrow><mo maxsize="1.600em" minsize="1.600em">)</mo></mrow></mrow><mo stretchy="true">⏟</mo></munder><mrow><mphantom></mphantom><mo>≕</mo><msub><mi>𝝌</mi><mn>1</mn></msub></mrow></munder><mo>−</mo><munder><munder accentunder="true"><mfrac><mrow><msub><mo>∫</mo><mrow><mi>𝐮</mi><mo>∈</mo><msup><mi>𝕊</mi><mrow><msub><mi>m</mi><mn>2</mn></msub><mo>−</mo><mn>1</mn></mrow></msup></mrow></msub><mrow><mrow><mi>exp</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mrow><mi>𝐡</mi><mo lspace="0em" rspace="0em">​</mo><msup><mrow><mo stretchy="false">(</mo><msub><mi>𝐙</mi><mrow><mn>2</mn><mo>,</mo><mi>T</mi></mrow></msub><mo stretchy="false">)</mo></mrow><mo>⊤</mo></msup><mo lspace="0em" rspace="0em">​</mo><mi>𝐮</mi></mrow><mo stretchy="false">)</mo></mrow></mrow><mo lspace="0em" rspace="0em">​</mo><mi>𝐮</mi><mo lspace="0.170em" rspace="0em">​</mo><mrow><mo rspace="0em">𝑑</mo><mi>𝐮</mi></mrow></mrow></mrow><mrow><msub><mo>∫</mo><mrow><mi>𝐮</mi><mo>∈</mo><msup><mi>𝕊</mi><mrow><msub><mi>m</mi><mn>2</mn></msub><mo>−</mo><mn>1</mn></mrow></msup></mrow></msub><mrow><mrow><mi>exp</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mrow><mi>𝐡</mi><mo lspace="0em" rspace="0em">​</mo><msup><mrow><mo stretchy="false">(</mo><msub><mi>𝐙</mi><mrow><mn>2</mn><mo>,</mo><mi>T</mi></mrow></msub><mo stretchy="false">)</mo></mrow><mo>⊤</mo></msup><mo lspace="0em" rspace="0em">​</mo><mi>𝐮</mi></mrow><mo stretchy="false">)</mo></mrow></mrow><mo lspace="0.170em" rspace="0em">​</mo><mrow><mo rspace="0em">𝑑</mo><mi>𝐮</mi></mrow></mrow></mrow></mfrac><mo stretchy="true">⏟</mo></munder><mrow><mphantom></mphantom><mo>≕</mo><msub><mi>𝝌</mi><mn>2</mn></msub></mrow></munder></mrow><mo maxsize="2.100em" minsize="2.100em" stretchy="true">‖</mo></mrow><mn>2</mn></msub><mo>≤</mo><msub><mi>κ</mi><mi>W</mi></msub></mrow><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">\bigg\|\underbrace{\overline{\sum}_{w\in[W]}\Big(\exp\big(\mathbf{h}(\mathbf{Z}_{2,T})^{\top}\bm{\phi}_{2}(\mathbf{e}_{w})\big)\,;\,\bm{\phi}_{2}(\mathbf{e}_{w})\Big)}_{\eqcolon\bm{\chi}_{1}}-\underbrace{\frac{\int_{\mathbf{u}\in\mathbb{S}^{m_{2}-1}}\exp(\mathbf{h}(\mathbf{Z}_{2,T})^{\top}\mathbf{u})\mathbf{u}\,d\mathbf{u}}{\int_{\mathbf{u}\in\mathbb{S}^{m_{2}-1}}\exp(\mathbf{h}(\mathbf{Z}_{2,T})^{\top}\mathbf{u})\,d\mathbf{u}}}_{\eqcolon\bm{\chi}_{2}}\bigg\|_{2}\leq\kappa_{W}.</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="A6.SS1.p5.9" class="ltx_p"><span id="A6.SS1.p5.9.1" class="ltx_text">Moreover, we have
<math id="A6.SS1.p5.m13" class="ltx_Math" alttext="\bm{\chi}_{1}/\|\bm{\chi}_{1}\|_{2}=\bm{\alpha}" display="inline" intent=":literal"><semantics><mrow><mrow><msub><mi>𝝌</mi><mn>1</mn></msub><mo>/</mo><msub><mrow><mo stretchy="false">‖</mo><msub><mi>𝝌</mi><mn>1</mn></msub><mo stretchy="false">‖</mo></mrow><mn>2</mn></msub></mrow><mo>=</mo><mi>𝜶</mi></mrow><annotation encoding="application/x-tex">\bm{\chi}_{1}/\|\bm{\chi}_{1}\|_{2}=\bm{\alpha}</annotation></semantics></math>
by (i) of Lemma <a href="#Thmconj230" title="Lemma 30. ‣ Proof of Lemma . ‣ F.1 Proof of Lemma ‣ Appendix F Directional Convergence of the Nadaraya–Watson Estimator ‣ Generalization Bounds for Transformer-Based Next-Token Prediction in a Language Model" class="ltx_ref"><span class="ltx_text ltx_ref_tag">30</span></a> and
<math id="A6.SS1.p5.m14" class="ltx_Math" alttext="\bm{\chi}_{2}/\|\bm{\chi}_{2}\|_{2}=\mathbf{h}(\mathbf{Z}_{2,T})/\delta_{2}" display="inline" intent=":literal"><semantics><mrow><mrow><msub><mi>𝝌</mi><mn>2</mn></msub><mo>/</mo><msub><mrow><mo stretchy="false">‖</mo><msub><mi>𝝌</mi><mn>2</mn></msub><mo stretchy="false">‖</mo></mrow><mn>2</mn></msub></mrow><mo>=</mo><mrow><mrow><mi>𝐡</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><msub><mi>𝐙</mi><mrow><mn>2</mn><mo>,</mo><mi>T</mi></mrow></msub><mo stretchy="false">)</mo></mrow></mrow><mo>/</mo><msub><mi>δ</mi><mn>2</mn></msub></mrow></mrow><annotation encoding="application/x-tex">\bm{\chi}_{2}/\|\bm{\chi}_{2}\|_{2}=\mathbf{h}(\mathbf{Z}_{2,T})/\delta_{2}</annotation></semantics></math>
by the first argument of Lemma <a href="#Thmconj235" title="Lemma 35. ‣ Appendix G Technical Lemmas ‣ Generalization Bounds for Transformer-Based Next-Token Prediction in a Language Model" class="ltx_ref"><span class="ltx_text ltx_ref_tag">35</span></a>.
Hence,</span></p>
<table id="A6.EGx159" class="ltx_equationgroup ltx_eqn_align ltx_eqn_table">

<tbody id="A6.Ex379"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_align_right ltx_eqn_cell"><math id="A6.Ex379.m1" class="ltx_Math" alttext="\displaystyle\left\|\bm{\alpha}-\frac{\mathbf{h}(\mathbf{Z}_{2,T})}{\delta_{2}}\right\|_{2}=\left\|\frac{\bm{\chi}_{1}}{\|\bm{\chi}_{1}\|_{2}}-\frac{\bm{\chi}_{2}}{\|\bm{\chi}_{2}\|_{2}}\right\|_{2}\leq\left\|\frac{\bm{\chi}_{1}-\bm{\chi}_{2}}{\|\bm{\chi}_{2}\|_{2}}\right\|_{2}+\left\|\left(\frac{1}{\|\bm{\chi}_{1}\|_{2}}-\frac{1}{\|\bm{\chi}_{2}\|_{2}}\right)\bm{\chi}_{1}\right\|_{2}\lesssim\kappa_{W}," display="inline" intent=":literal"><semantics><mrow><mrow><msub><mrow><mo>‖</mo><mrow><mi>𝜶</mi><mo>−</mo><mstyle displaystyle="true"><mfrac><mrow><mi>𝐡</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><msub><mi>𝐙</mi><mrow><mn>2</mn><mo>,</mo><mi>T</mi></mrow></msub><mo stretchy="false">)</mo></mrow></mrow><msub><mi>δ</mi><mn>2</mn></msub></mfrac></mstyle></mrow><mo>‖</mo></mrow><mn>2</mn></msub><mo>=</mo><msub><mrow><mo>‖</mo><mrow><mstyle displaystyle="true"><mfrac><msub><mi>𝝌</mi><mn>1</mn></msub><msub><mrow><mo stretchy="false">‖</mo><msub><mi>𝝌</mi><mn>1</mn></msub><mo stretchy="false">‖</mo></mrow><mn>2</mn></msub></mfrac></mstyle><mo>−</mo><mstyle displaystyle="true"><mfrac><msub><mi>𝝌</mi><mn>2</mn></msub><msub><mrow><mo stretchy="false">‖</mo><msub><mi>𝝌</mi><mn>2</mn></msub><mo stretchy="false">‖</mo></mrow><mn>2</mn></msub></mfrac></mstyle></mrow><mo>‖</mo></mrow><mn>2</mn></msub><mo>≤</mo><mrow><msub><mrow><mo>‖</mo><mstyle displaystyle="true"><mfrac><mrow><msub><mi>𝝌</mi><mn>1</mn></msub><mo>−</mo><msub><mi>𝝌</mi><mn>2</mn></msub></mrow><msub><mrow><mo stretchy="false">‖</mo><msub><mi>𝝌</mi><mn>2</mn></msub><mo stretchy="false">‖</mo></mrow><mn>2</mn></msub></mfrac></mstyle><mo>‖</mo></mrow><mn>2</mn></msub><mo>+</mo><msub><mrow><mo>‖</mo><mrow><mrow><mo>(</mo><mrow><mstyle displaystyle="true"><mfrac><mn>1</mn><msub><mrow><mo stretchy="false">‖</mo><msub><mi>𝝌</mi><mn>1</mn></msub><mo stretchy="false">‖</mo></mrow><mn>2</mn></msub></mfrac></mstyle><mo>−</mo><mstyle displaystyle="true"><mfrac><mn>1</mn><msub><mrow><mo stretchy="false">‖</mo><msub><mi>𝝌</mi><mn>2</mn></msub><mo stretchy="false">‖</mo></mrow><mn>2</mn></msub></mfrac></mstyle></mrow><mo>)</mo></mrow><mo lspace="0em" rspace="0em">​</mo><msub><mi>𝝌</mi><mn>1</mn></msub></mrow><mo>‖</mo></mrow><mn>2</mn></msub></mrow><mo>≲</mo><msub><mi>κ</mi><mi>W</mi></msub></mrow><mo>,</mo></mrow><annotation encoding="application/x-tex">\displaystyle\left\|\bm{\alpha}-\frac{\mathbf{h}(\mathbf{Z}_{2,T})}{\delta_{2}}\right\|_{2}=\left\|\frac{\bm{\chi}_{1}}{\|\bm{\chi}_{1}\|_{2}}-\frac{\bm{\chi}_{2}}{\|\bm{\chi}_{2}\|_{2}}\right\|_{2}\leq\left\|\frac{\bm{\chi}_{1}-\bm{\chi}_{2}}{\|\bm{\chi}_{2}\|_{2}}\right\|_{2}+\left\|\left(\frac{1}{\|\bm{\chi}_{1}\|_{2}}-\frac{1}{\|\bm{\chi}_{2}\|_{2}}\right)\bm{\chi}_{1}\right\|_{2}\lesssim\kappa_{W},</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="A6.SS1.p5.10" class="ltx_p"><span id="A6.SS1.p5.10.1" class="ltx_text">where we use the second argument of Lemma <a href="#Thmconj235" title="Lemma 35. ‣ Appendix G Technical Lemmas ‣ Generalization Bounds for Transformer-Based Next-Token Prediction in a Language Model" class="ltx_ref"><span class="ltx_text ltx_ref_tag">35</span></a> for the last inequality.
Combining with (<a href="#A6.E101" title="In Proof of Lemma . ‣ F.1 Proof of Lemma ‣ Appendix F Directional Convergence of the Nadaraya–Watson Estimator ‣ Generalization Bounds for Transformer-Based Next-Token Prediction in a Language Model" class="ltx_ref"><span class="ltx_text ltx_ref_tag">101</span></a>), we obtain</span></p>
<table id="A6.EGx160" class="ltx_equationgroup ltx_eqn_align ltx_eqn_table">

<tbody id="A6.E102"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_align_right ltx_eqn_cell"><math id="A6.E102.m1" class="ltx_Math" alttext="\displaystyle\mathbb{E}\left[\left\|\frac{\delta_{2}\widehat{\mathbf{m}}_{\lambda}(\mathbf{Z}_{2,T+1})}{\|\widehat{\mathbf{m}}_{\lambda}(\mathbf{Z}_{2,T+1})\|_{2}}-\mathbf{h}(\mathbf{Z}_{2,T})\right\|^{2}_{2}\Big|\mathbf{h}\right]=\tilde{O}\Big(\lambda^{2\beta_{2}}+\frac{1}{T\varphi_{W}(\lambda)^{r_{2}}}+\kappa_{W}^{2}\Big)." display="inline" intent=":literal"><semantics><mrow><mrow><mrow><mi>𝔼</mi><mo>⁡</mo><mrow><mo>[</mo><mrow><msubsup><mrow><mo>‖</mo><mrow><mstyle displaystyle="true"><mfrac><mrow><msub><mi>δ</mi><mn>2</mn></msub><mo lspace="0em" rspace="0em">​</mo><msub><mover accent="true"><mi>𝐦</mi><mo>^</mo></mover><mi>λ</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mi>𝐙</mi><mrow><mn>2</mn><mo>,</mo><mrow><mi>T</mi><mo>+</mo><mn>1</mn></mrow></mrow></msub><mo stretchy="false">)</mo></mrow></mrow><msub><mrow><mo stretchy="false">‖</mo><mrow><msub><mover accent="true"><mi>𝐦</mi><mo>^</mo></mover><mi>λ</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mi>𝐙</mi><mrow><mn>2</mn><mo>,</mo><mrow><mi>T</mi><mo>+</mo><mn>1</mn></mrow></mrow></msub><mo stretchy="false">)</mo></mrow></mrow><mo stretchy="false">‖</mo></mrow><mn>2</mn></msub></mfrac></mstyle><mo>−</mo><mrow><mi>𝐡</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><msub><mi>𝐙</mi><mrow><mn>2</mn><mo>,</mo><mi>T</mi></mrow></msub><mo stretchy="false">)</mo></mrow></mrow></mrow><mo>‖</mo></mrow><mn>2</mn><mn>2</mn></msubsup><mo fence="false" maxsize="1.600em" minsize="1.600em" rspace="0.167em" stretchy="true">|</mo><mi>𝐡</mi></mrow><mo>]</mo></mrow></mrow><mo>=</mo><mrow><mover accent="true"><mi>O</mi><mo>~</mo></mover><mo lspace="0em" rspace="0em">​</mo><mrow><mo maxsize="1.600em" minsize="1.600em">(</mo><mrow><msup><mi>λ</mi><mrow><mn>2</mn><mo lspace="0em" rspace="0em">​</mo><msub><mi>β</mi><mn>2</mn></msub></mrow></msup><mo>+</mo><mstyle displaystyle="true"><mfrac><mn>1</mn><mrow><mi>T</mi><mo lspace="0em" rspace="0em">​</mo><msub><mi>φ</mi><mi>W</mi></msub><mo lspace="0em" rspace="0em">​</mo><msup><mrow><mo stretchy="false">(</mo><mi>λ</mi><mo stretchy="false">)</mo></mrow><msub><mi>r</mi><mn>2</mn></msub></msup></mrow></mfrac></mstyle><mo>+</mo><msubsup><mi>κ</mi><mi>W</mi><mn>2</mn></msubsup></mrow><mo maxsize="1.600em" minsize="1.600em">)</mo></mrow></mrow></mrow><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">\displaystyle\mathbb{E}\left[\left\|\frac{\delta_{2}\widehat{\mathbf{m}}_{\lambda}(\mathbf{Z}_{2,T+1})}{\|\widehat{\mathbf{m}}_{\lambda}(\mathbf{Z}_{2,T+1})\|_{2}}-\mathbf{h}(\mathbf{Z}_{2,T})\right\|^{2}_{2}\Big|\mathbf{h}\right]=\tilde{O}\Big(\lambda^{2\beta_{2}}+\frac{1}{T\varphi_{W}(\lambda)^{r_{2}}}+\kappa_{W}^{2}\Big).</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td>
<td rowspan="1" class="ltx_eqn_cell ltx_eqn_eqno ltx_align_middle ltx_align_right"><span class="ltx_tag ltx_tag_equation ltx_align_right">(102)</span></td></tr></tbody>
</table>
</div>
<div id="A6.SS1.p6" class="ltx_para">
<p id="A6.SS1.p6.1" class="ltx_p"><span id="A6.SS1.p6.1.1" class="ltx_text">∎</span></p>
</div>
</div>
</section>
<section id="A6.SS2" class="ltx_subsection">
<h3 class="ltx_title ltx_title_subsection"><span class="ltx_tag ltx_tag_subsection">F.2 </span>Proof of Lemma <a href="#Thmconj228" title="Lemma 28. ‣ F.1 Proof of Lemma ‣ Appendix F Directional Convergence of the Nadaraya–Watson Estimator ‣ Generalization Bounds for Transformer-Based Next-Token Prediction in a Language Model" class="ltx_ref"><span class="ltx_text ltx_ref_tag">28</span></a></h3>

<div id="A6.SS2.2" class="ltx_proof">
<h6 class="ltx_title ltx_runin ltx_font_italic ltx_title_proof">Proof.</h6>
<div id="A6.SS2.p1" class="ltx_para">
<p id="A6.SS2.p1.1" class="ltx_p"><span id="A6.SS2.p1.1.1" class="ltx_text">The normalization function <math id="A6.SS2.p1.m1" class="ltx_Math" alttext="c(\mathbf{x})" display="inline" intent=":literal"><semantics><mrow><mi>c</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>𝐱</mi><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">c(\mathbf{x})</annotation></semantics></math> satisfies for any <math id="A6.SS2.p1.m2" class="ltx_Math" alttext="\mathbf{x}\in\mathcal{E}_{W}^{r}," display="inline" intent=":literal"><semantics><mrow><mrow><mi>𝐱</mi><mo>∈</mo><msubsup><mi class="ltx_font_mathcaligraphic">ℰ</mi><mi>W</mi><mi>r</mi></msubsup></mrow><mo>,</mo></mrow><annotation encoding="application/x-tex">\mathbf{x}\in\mathcal{E}_{W}^{r},</annotation></semantics></math></span></p>
<table id="A6.Ex380" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="A6.Ex380.m1" class="ltx_Math" alttext="c(\mathbf{x})\coloneq\left(\sum_{\mathbf{z}\in\mathcal{E}_{W}^{r}}\exp(g(\mathbf{x},\mathbf{z}))\prod_{i=1}^{r-1}\mathbb{I}(\mathbf{z}_{i}=\mathbf{x}_{i+1})\right)^{-1}\in\bigg[\frac{\exp(-\|g\|_{\infty})}{W},\frac{\exp(\|g\|_{\infty})}{W}\bigg]." display="block" intent=":literal"><semantics><mrow><mrow><mrow><mi>c</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>𝐱</mi><mo stretchy="false">)</mo></mrow></mrow><mo>≔</mo><msup><mrow><mo>(</mo><mrow><munder><mo lspace="0em" movablelimits="false">∑</mo><mrow><mi>𝐳</mi><mo>∈</mo><msubsup><mi class="ltx_font_mathcaligraphic">ℰ</mi><mi>W</mi><mi>r</mi></msubsup></mrow></munder><mrow><mrow><mi>exp</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mrow><mi>g</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>𝐱</mi><mo>,</mo><mi>𝐳</mi><mo stretchy="false">)</mo></mrow></mrow><mo stretchy="false">)</mo></mrow></mrow><mo lspace="0em" rspace="0em">​</mo><mrow><munderover><mo movablelimits="false">∏</mo><mrow><mi>i</mi><mo>=</mo><mn>1</mn></mrow><mrow><mi>r</mi><mo>−</mo><mn>1</mn></mrow></munderover><mrow><mi>𝕀</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mrow><msub><mi>𝐳</mi><mi>i</mi></msub><mo>=</mo><msub><mi>𝐱</mi><mrow><mi>i</mi><mo>+</mo><mn>1</mn></mrow></msub></mrow><mo stretchy="false">)</mo></mrow></mrow></mrow></mrow></mrow><mo>)</mo></mrow><mrow><mo>−</mo><mn>1</mn></mrow></msup><mo>∈</mo><mrow><mo maxsize="2.100em" minsize="2.100em">[</mo><mrow><mfrac><mrow><mi>exp</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mrow><mo>−</mo><msub><mrow><mo stretchy="false">‖</mo><mi>g</mi><mo stretchy="false">‖</mo></mrow><mi mathvariant="normal">∞</mi></msub></mrow><mo stretchy="false">)</mo></mrow></mrow><mi>W</mi></mfrac><mo>,</mo><mfrac><mrow><mi>exp</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><msub><mrow><mo stretchy="false">‖</mo><mi>g</mi><mo stretchy="false">‖</mo></mrow><mi mathvariant="normal">∞</mi></msub><mo stretchy="false">)</mo></mrow></mrow><mi>W</mi></mfrac></mrow><mo maxsize="2.100em" minsize="2.100em">]</mo></mrow></mrow><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">c(\mathbf{x})\coloneq\left(\sum_{\mathbf{z}\in\mathcal{E}_{W}^{r}}\exp(g(\mathbf{x},\mathbf{z}))\prod_{i=1}^{r-1}\mathbb{I}(\mathbf{z}_{i}=\mathbf{x}_{i+1})\right)^{-1}\in\bigg[\frac{\exp(-\|g\|_{\infty})}{W},\frac{\exp(\|g\|_{\infty})}{W}\bigg].</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="A6.SS2.p1.2" class="ltx_p"><span id="A6.SS2.p1.2.1" class="ltx_text">Additionally, the Chapman–Kolmogorov equation gives for the <math id="A6.SS2.p1.m3" class="ltx_Math" alttext="r" display="inline" intent=":literal"><semantics><mi>r</mi><annotation encoding="application/x-tex">r</annotation></semantics></math>-step transition probability</span></p>
<table id="A6.EGx161" class="ltx_equationgroup ltx_eqn_align ltx_eqn_table">

<tbody id="A6.Ex381"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_align_right ltx_eqn_cell"><math id="A6.Ex381.m1" class="ltx_Math" alttext="\displaystyle P^{r}\big((\mathbf{x}_{1},\ldots,\mathbf{x}_{r}),(\mathbf{z}_{1},\ldots,\mathbf{z}_{r})\big)" display="inline" intent=":literal"><semantics><mrow><msup><mi>P</mi><mi>r</mi></msup><mo lspace="0em" rspace="0em">​</mo><mrow><mo maxsize="1.200em" minsize="1.200em">(</mo><mrow><mo stretchy="false">(</mo><msub><mi>𝐱</mi><mn>1</mn></msub><mo>,</mo><mi mathvariant="normal">…</mi><mo>,</mo><msub><mi>𝐱</mi><mi>r</mi></msub><mo stretchy="false">)</mo></mrow><mo>,</mo><mrow><mo stretchy="false">(</mo><msub><mi>𝐳</mi><mn>1</mn></msub><mo>,</mo><mi mathvariant="normal">…</mi><mo>,</mo><msub><mi>𝐳</mi><mi>r</mi></msub><mo stretchy="false">)</mo></mrow><mo maxsize="1.200em" minsize="1.200em">)</mo></mrow></mrow><annotation encoding="application/x-tex">\displaystyle P^{r}\big((\mathbf{x}_{1},\ldots,\mathbf{x}_{r}),(\mathbf{z}_{1},\ldots,\mathbf{z}_{r})\big)</annotation></semantics></math></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A6.Ex381.m2" class="ltx_Math" alttext="\displaystyle\geq\prod_{t=1}^{r}c\big((\mathbf{x}_{t},\ldots,\mathbf{x}_{r},\mathbf{z}_{1},\ldots,\mathbf{z}_{t-1})\big)\exp(-\|g\|_{\infty})" display="inline" intent=":literal"><semantics><mrow><mphantom></mphantom><mo>≥</mo><mrow><mstyle displaystyle="true"><munderover><mo movablelimits="false">∏</mo><mrow><mi>t</mi><mo>=</mo><mn>1</mn></mrow><mi>r</mi></munderover></mstyle><mrow><mrow><mi>c</mi><mo>⁡</mo><mrow><mo maxsize="1.200em" minsize="1.200em">(</mo><mo stretchy="false">(</mo><mo>,</mo><mo>,</mo><mo>,</mo><mo>,</mo><mo>,</mo><mo>,</mo><mo>,</mo><mo>,</mo><mo>,</mo><mo>,</mo><mo>,</mo><mo stretchy="false">)</mo><mo maxsize="1.200em" minsize="1.200em">)</mo></mrow></mrow><mo lspace="0.167em" rspace="0em">​</mo><mrow><mi>exp</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mrow><mo>−</mo><msub><mrow><mo stretchy="false">‖</mo><mi>g</mi><mo stretchy="false">‖</mo></mrow><mi mathvariant="normal">∞</mi></msub></mrow><mo stretchy="false">)</mo></mrow></mrow></mrow></mrow></mrow><annotation encoding="application/x-tex">\displaystyle\geq\prod_{t=1}^{r}c\big((\mathbf{x}_{t},\ldots,\mathbf{x}_{r},\mathbf{z}_{1},\ldots,\mathbf{z}_{t-1})\big)\exp(-\|g\|_{\infty})</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
<tbody id="A6.E103"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_eqn_cell"></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A6.E103.m1" class="ltx_Math" alttext="\displaystyle\geq(e^{2\|g\|_{\infty}}W)^{-r}." display="inline" intent=":literal"><semantics><mrow><mrow><mphantom></mphantom><mo>≥</mo><msup><mrow><mo stretchy="false">(</mo><mrow><msup><mi>e</mi><mrow><mn>2</mn><mo lspace="0em" rspace="0em">​</mo><msub><mrow><mo stretchy="false">‖</mo><mi>g</mi><mo stretchy="false">‖</mo></mrow><mi mathvariant="normal">∞</mi></msub></mrow></msup><mo lspace="0em" rspace="0em">​</mo><mi>W</mi></mrow><mo stretchy="false">)</mo></mrow><mrow><mo>−</mo><mi>r</mi></mrow></msup></mrow><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">\displaystyle\geq(e^{2\|g\|_{\infty}}W)^{-r}.</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td>
<td rowspan="1" class="ltx_eqn_cell ltx_eqn_eqno ltx_align_middle ltx_align_right"><span class="ltx_tag ltx_tag_equation ltx_align_right">(103)</span></td></tr></tbody>
</table>
<p id="A6.SS2.p1.3" class="ltx_p"><span id="A6.SS2.p1.3.1" class="ltx_text">Thus by Theorem 16.0.2 in <cite class="ltx_cite ltx_citemacro_cite">[<a href="#bib.bib14" title="" class="ltx_ref">53</a>]</cite> there exists a stationary distribution <math id="A6.SS2.p1.m4" class="ltx_Math" alttext="\rho" display="inline" intent=":literal"><semantics><mi>ρ</mi><annotation encoding="application/x-tex">\rho</annotation></semantics></math> and <math id="A6.SS2.p1.m5" class="ltx_Math" alttext="\mathbf{Y}" display="inline" intent=":literal"><semantics><mi>𝐘</mi><annotation encoding="application/x-tex">\mathbf{Y}</annotation></semantics></math> is uniformly ergodic. Now applying (<a href="#A6.E103" title="In Proof. ‣ F.2 Proof of Lemma ‣ Appendix F Directional Convergence of the Nadaraya–Watson Estimator ‣ Generalization Bounds for Transformer-Based Next-Token Prediction in a Language Model" class="ltx_ref"><span class="ltx_text ltx_ref_tag">103</span></a>) together with Theorem 16.2.4 in <cite class="ltx_cite ltx_citemacro_cite">[<a href="#bib.bib14" title="" class="ltx_ref">53</a>]</cite> gives</span></p>
<table id="A6.EGx162" class="ltx_equationgroup ltx_eqn_align ltx_eqn_table">

<tbody id="A6.Ex382"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_align_right ltx_eqn_cell"><math id="A6.Ex382.m1" class="ltx_Math" alttext="\displaystyle\sup_{\mathbf{x}\in\mathcal{E}_{W}^{r}}\|P^{n}(\mathbf{x},\cdot)-\rho\|_{\operatorname{TV}}" display="inline" intent=":literal"><semantics><mrow><munder><mo movablelimits="false">sup</mo><mrow><mi>𝐱</mi><mo>∈</mo><msubsup><mi class="ltx_font_mathcaligraphic">ℰ</mi><mi>W</mi><mi>r</mi></msubsup></mrow></munder><msub><mrow><mo lspace="0em" stretchy="false">‖</mo><mrow><mrow><msup><mi>P</mi><mi>n</mi></msup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>𝐱</mi><mo rspace="0em">,</mo><mo lspace="0em" rspace="0em">⋅</mo><mo stretchy="false">)</mo></mrow></mrow><mo>−</mo><mi>ρ</mi></mrow><mo stretchy="false">‖</mo></mrow><mi>TV</mi></msub></mrow><annotation encoding="application/x-tex">\displaystyle\sup_{\mathbf{x}\in\mathcal{E}_{W}^{r}}\|P^{n}(\mathbf{x},\cdot)-\rho\|_{\operatorname{TV}}</annotation></semantics></math></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A6.Ex382.m2" class="ltx_Math" alttext="\displaystyle\leq\Big(1-e^{-2\|g\|_{\infty}r}\Big)^{n/r}." display="inline" intent=":literal"><semantics><mrow><mrow><mphantom></mphantom><mo>≤</mo><msup><mrow><mo maxsize="1.600em" minsize="1.600em">(</mo><mrow><mn>1</mn><mo>−</mo><msup><mi>e</mi><mrow><mo>−</mo><mrow><mn>2</mn><mo lspace="0em" rspace="0em">​</mo><msub><mrow><mo stretchy="false">‖</mo><mi>g</mi><mo stretchy="false">‖</mo></mrow><mi mathvariant="normal">∞</mi></msub><mo lspace="0em" rspace="0em">​</mo><mi>r</mi></mrow></mrow></msup></mrow><mo maxsize="1.600em" minsize="1.600em">)</mo></mrow><mrow><mi>n</mi><mo>/</mo><mi>r</mi></mrow></msup></mrow><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">\displaystyle\leq\Big(1-e^{-2\|g\|_{\infty}r}\Big)^{n/r}.</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="A6.SS2.p1.4" class="ltx_p"><span id="A6.SS2.p1.4.1" class="ltx_text">Lastly, arguing similarly as in (<a href="#A6.E103" title="In Proof. ‣ F.2 Proof of Lemma ‣ Appendix F Directional Convergence of the Nadaraya–Watson Estimator ‣ Generalization Bounds for Transformer-Based Next-Token Prediction in a Language Model" class="ltx_ref"><span class="ltx_text ltx_ref_tag">103</span></a>) gives</span></p>
<table id="A6.Ex383" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="A6.Ex383.m1" class="ltx_Math" alttext="P^{r}\big((\mathbf{x}_{1},\ldots,\mathbf{x}_{r}),(\mathbf{z}_{1},\ldots,\mathbf{z}_{r})\big)\leq(e^{-2\|g\|_{\infty}}W)^{-r}," display="block" intent=":literal"><semantics><mrow><mrow><mrow><msup><mi>P</mi><mi>r</mi></msup><mo lspace="0em" rspace="0em">​</mo><mrow><mo maxsize="1.200em" minsize="1.200em">(</mo><mrow><mo stretchy="false">(</mo><msub><mi>𝐱</mi><mn>1</mn></msub><mo>,</mo><mi mathvariant="normal">…</mi><mo>,</mo><msub><mi>𝐱</mi><mi>r</mi></msub><mo stretchy="false">)</mo></mrow><mo>,</mo><mrow><mo stretchy="false">(</mo><msub><mi>𝐳</mi><mn>1</mn></msub><mo>,</mo><mi mathvariant="normal">…</mi><mo>,</mo><msub><mi>𝐳</mi><mi>r</mi></msub><mo stretchy="false">)</mo></mrow><mo maxsize="1.200em" minsize="1.200em">)</mo></mrow></mrow><mo>≤</mo><msup><mrow><mo stretchy="false">(</mo><mrow><msup><mi>e</mi><mrow><mo>−</mo><mrow><mn>2</mn><mo lspace="0em" rspace="0em">​</mo><msub><mrow><mo stretchy="false">‖</mo><mi>g</mi><mo stretchy="false">‖</mo></mrow><mi mathvariant="normal">∞</mi></msub></mrow></mrow></msup><mo lspace="0em" rspace="0em">​</mo><mi>W</mi></mrow><mo stretchy="false">)</mo></mrow><mrow><mo>−</mo><mi>r</mi></mrow></msup></mrow><mo>,</mo></mrow><annotation encoding="application/x-tex">P^{r}\big((\mathbf{x}_{1},\ldots,\mathbf{x}_{r}),(\mathbf{z}_{1},\ldots,\mathbf{z}_{r})\big)\leq(e^{-2\|g\|_{\infty}}W)^{-r},</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="A6.SS2.p1.5" class="ltx_p"><span id="A6.SS2.p1.5.1" class="ltx_text">and since</span></p>
<table id="A6.EGx163" class="ltx_equationgroup ltx_eqn_align ltx_eqn_table">

<tbody id="A6.Ex384"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_align_right ltx_eqn_cell"><math id="A6.Ex384.m1" class="ltx_Math" alttext="\displaystyle\rho\big((\mathbf{z}_{1},\ldots,\mathbf{z}_{r})\big)" display="inline" intent=":literal"><semantics><mrow><mi>ρ</mi><mo>⁡</mo><mrow><mo maxsize="1.200em" minsize="1.200em">(</mo><mo stretchy="false">(</mo><mo>,</mo><mo>,</mo><mo>,</mo><mo>,</mo><mo>,</mo><mo stretchy="false">)</mo><mo maxsize="1.200em" minsize="1.200em">)</mo></mrow></mrow><annotation encoding="application/x-tex">\displaystyle\rho\big((\mathbf{z}_{1},\ldots,\mathbf{z}_{r})\big)</annotation></semantics></math></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A6.Ex384.m2" class="ltx_Math" alttext="\displaystyle=\sum P^{r}\big((\mathbf{x}_{1},\ldots,\mathbf{x}_{r}),(\mathbf{z}_{1},\ldots,\mathbf{z}_{r})\big)\rho\big((\mathbf{x}_{1},\ldots,\mathbf{x}_{r})\big)" display="inline" intent=":literal"><semantics><mrow><mphantom></mphantom><mo>=</mo><mstyle displaystyle="true"><mrow><mo movablelimits="false">∑</mo><mrow><msup><mi>P</mi><mi>r</mi></msup><mo lspace="0em" rspace="0em">​</mo><mrow><mo maxsize="1.200em" minsize="1.200em">(</mo><mrow><mo stretchy="false">(</mo><msub><mi>𝐱</mi><mn>1</mn></msub><mo>,</mo><mi mathvariant="normal">…</mi><mo>,</mo><msub><mi>𝐱</mi><mi>r</mi></msub><mo stretchy="false">)</mo></mrow><mo>,</mo><mrow><mo stretchy="false">(</mo><msub><mi>𝐳</mi><mn>1</mn></msub><mo>,</mo><mi mathvariant="normal">…</mi><mo>,</mo><msub><mi>𝐳</mi><mi>r</mi></msub><mo stretchy="false">)</mo></mrow><mo maxsize="1.200em" minsize="1.200em">)</mo></mrow><mo lspace="0em" rspace="0em">​</mo><mi>ρ</mi><mo lspace="0em" rspace="0em">​</mo><mrow><mo maxsize="1.200em" minsize="1.200em">(</mo><mo stretchy="false">(</mo><mo>,</mo><mo>,</mo><mo>,</mo><mo>,</mo><mo>,</mo><mo stretchy="false">)</mo><mo maxsize="1.200em" minsize="1.200em">)</mo></mrow></mrow></mrow></mstyle></mrow><annotation encoding="application/x-tex">\displaystyle=\sum P^{r}\big((\mathbf{x}_{1},\ldots,\mathbf{x}_{r}),(\mathbf{z}_{1},\ldots,\mathbf{z}_{r})\big)\rho\big((\mathbf{x}_{1},\ldots,\mathbf{x}_{r})\big)</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="A6.SS2.p1.6" class="ltx_p"><span id="A6.SS2.p1.6.1" class="ltx_text">this implies together with (<a href="#A6.E103" title="In Proof. ‣ F.2 Proof of Lemma ‣ Appendix F Directional Convergence of the Nadaraya–Watson Estimator ‣ Generalization Bounds for Transformer-Based Next-Token Prediction in a Language Model" class="ltx_ref"><span class="ltx_text ltx_ref_tag">103</span></a>)</span></p>
<table id="A6.EGx164" class="ltx_equationgroup ltx_eqn_align ltx_eqn_table">

<tbody id="A6.Ex385"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_align_right ltx_eqn_cell"><math id="A6.Ex385.m1" class="ltx_Math" alttext="\displaystyle(e^{2\|g\|_{\infty}}W)^{-r}\leq\rho(\mathbf{z})\leq(e^{-2\|g\|_{\infty}}W)^{-r}." display="inline" intent=":literal"><semantics><mrow><mrow><msup><mrow><mo stretchy="false">(</mo><mrow><msup><mi>e</mi><mrow><mn>2</mn><mo lspace="0em" rspace="0em">​</mo><msub><mrow><mo stretchy="false">‖</mo><mi>g</mi><mo stretchy="false">‖</mo></mrow><mi mathvariant="normal">∞</mi></msub></mrow></msup><mo lspace="0em" rspace="0em">​</mo><mi>W</mi></mrow><mo stretchy="false">)</mo></mrow><mrow><mo>−</mo><mi>r</mi></mrow></msup><mo>≤</mo><mrow><mi>ρ</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>𝐳</mi><mo stretchy="false">)</mo></mrow></mrow><mo>≤</mo><msup><mrow><mo stretchy="false">(</mo><mrow><msup><mi>e</mi><mrow><mo>−</mo><mrow><mn>2</mn><mo lspace="0em" rspace="0em">​</mo><msub><mrow><mo stretchy="false">‖</mo><mi>g</mi><mo stretchy="false">‖</mo></mrow><mi mathvariant="normal">∞</mi></msub></mrow></mrow></msup><mo lspace="0em" rspace="0em">​</mo><mi>W</mi></mrow><mo stretchy="false">)</mo></mrow><mrow><mo>−</mo><mi>r</mi></mrow></msup></mrow><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">\displaystyle(e^{2\|g\|_{\infty}}W)^{-r}\leq\rho(\mathbf{z})\leq(e^{-2\|g\|_{\infty}}W)^{-r}.</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="A6.SS2.p1.7" class="ltx_p"><span id="A6.SS2.p1.7.1" class="ltx_text">∎</span></p>
</div>
</div>
</section>
<section id="A6.SS3" class="ltx_subsection">
<h3 class="ltx_title ltx_title_subsection"><span class="ltx_tag ltx_tag_subsection">F.3 </span>Proof of Lemma <a href="#Thmconj229" title="Lemma 29. ‣ F.1 Proof of Lemma ‣ Appendix F Directional Convergence of the Nadaraya–Watson Estimator ‣ Generalization Bounds for Transformer-Based Next-Token Prediction in a Language Model" class="ltx_ref"><span class="ltx_text ltx_ref_tag">29</span></a></h3>

<div id="A6.SS3.2" class="ltx_proof">
<h6 class="ltx_title ltx_runin ltx_font_italic ltx_title_proof">Proof.</h6>
<div id="A6.SS3.p1" class="ltx_para">
<p id="A6.SS3.p1.1" class="ltx_p"><span id="A6.SS3.p1.1.1" class="ltx_text">For simplicity we write <math id="A6.SS3.p1.m1" class="ltx_Math" alttext="\mathbb{P}=\mathbb{P}_{\rho}" display="inline" intent=":literal"><semantics><mrow><mi>ℙ</mi><mo>=</mo><msub><mi>ℙ</mi><mi>ρ</mi></msub></mrow><annotation encoding="application/x-tex">\mathbb{P}=\mathbb{P}_{\rho}</annotation></semantics></math> and <math id="A6.SS3.p1.m2" class="ltx_Math" alttext="\mathbb{E}=\mathbb{E}_{\rho}" display="inline" intent=":literal"><semantics><mrow><mi>𝔼</mi><mo>=</mo><msub><mi>𝔼</mi><mi>ρ</mi></msub></mrow><annotation encoding="application/x-tex">\mathbb{E}=\mathbb{E}_{\rho}</annotation></semantics></math>.
Furthermore, for <math id="A6.SS3.p1.m3" class="ltx_Math" alttext="T\in\mathbb{N}" display="inline" intent=":literal"><semantics><mrow><mi>T</mi><mo>∈</mo><mi>ℕ</mi></mrow><annotation encoding="application/x-tex">T\in\mathbb{N}</annotation></semantics></math>, we introduce</span></p>
<table id="A6.Ex386" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="A6.Ex386.m1" class="ltx_Math" alttext="\mathcal{T}=\mathcal{T}(T)\coloneq\{n\in\mathbb{N}_{0}\colon\log^{2}T\leq n\leq T-\log^{2}T\},\quad T^{*}\coloneq|\mathcal{T}|+T-\max(\mathcal{T})." display="block" intent=":literal"><semantics><mrow><mrow><mrow><mi class="ltx_font_mathcaligraphic">𝒯</mi><mo>=</mo><mrow><mi class="ltx_font_mathcaligraphic">𝒯</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>T</mi><mo stretchy="false">)</mo></mrow></mrow><mo>≔</mo><mrow><mo stretchy="false">{</mo><mrow><mi>n</mi><mo>∈</mo><msub><mi>ℕ</mi><mn>0</mn></msub></mrow><mo lspace="0.278em" rspace="0.278em">:</mo><mrow><mrow><msup><mi>log</mi><mn>2</mn></msup><mo lspace="0.167em">⁡</mo><mi>T</mi></mrow><mo>≤</mo><mi>n</mi><mo>≤</mo><mrow><mi>T</mi><mo>−</mo><mrow><msup><mi>log</mi><mn>2</mn></msup><mo lspace="0.167em">⁡</mo><mi>T</mi></mrow></mrow></mrow><mo stretchy="false">}</mo></mrow></mrow><mo rspace="1.167em">,</mo><mrow><msup><mi>T</mi><mo>∗</mo></msup><mo>≔</mo><mrow><mrow><mrow><mo stretchy="false">|</mo><mi class="ltx_font_mathcaligraphic">𝒯</mi><mo stretchy="false">|</mo></mrow><mo>+</mo><mi>T</mi></mrow><mo>−</mo><mrow><mi>max</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi class="ltx_font_mathcaligraphic">𝒯</mi><mo stretchy="false">)</mo></mrow></mrow></mrow></mrow></mrow><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">\mathcal{T}=\mathcal{T}(T)\coloneq\{n\in\mathbb{N}_{0}\colon\log^{2}T\leq n\leq T-\log^{2}T\},\quad T^{*}\coloneq|\mathcal{T}|+T-\max(\mathcal{T}).</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="A6.SS3.p1.2" class="ltx_p"><span id="A6.SS3.p1.2.1" class="ltx_text">We then obtain that for any <math id="A6.SS3.p1.m4" class="ltx_Math" alttext="\mathbf{x}\in\mathcal{D}" display="inline" intent=":literal"><semantics><mrow><mi>𝐱</mi><mo>∈</mo><mi class="ltx_font_mathcaligraphic">𝒟</mi></mrow><annotation encoding="application/x-tex">\mathbf{x}\in\mathcal{D}</annotation></semantics></math>,</span></p>
<table id="A6.EGx165" class="ltx_equationgroup ltx_eqn_align ltx_eqn_table">

<tbody id="A6.Ex387"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_eqn_cell"></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A6.Ex387.m1" class="ltx_Math" alttext="\displaystyle\Bigg|\mathbb{E}^{\mathbf{x}}\left[\|P^{\perp}_{\bm{\theta}(\bm{\xi}_{T})}\widehat{\mathbf{m}}_{\lambda}(\bm{\xi}_{T})\|^{2}_{2}\right]-\mathbb{E}\left[\|P^{\perp}_{\bm{\theta}(\bm{\xi}_{T})}\widehat{\mathbf{m}}_{\lambda}(\bm{\xi}_{T})\|^{2}_{2}\right]\Bigg|" display="inline" intent=":literal"><semantics><mrow><mo maxsize="2.600em" minsize="2.600em" stretchy="true">|</mo><mrow><mrow><msup><mi>𝔼</mi><mi>𝐱</mi></msup><mo lspace="0em" rspace="0em">​</mo><mrow><mo>[</mo><msubsup><mrow><mo stretchy="false">‖</mo><mrow><msubsup><mi>P</mi><mrow><mi>𝜽</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><msub><mi>𝝃</mi><mi>T</mi></msub><mo stretchy="false">)</mo></mrow></mrow><mo>⟂</mo></msubsup><mo lspace="0em" rspace="0em">​</mo><msub><mover accent="true"><mi>𝐦</mi><mo>^</mo></mover><mi>λ</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mi>𝝃</mi><mi>T</mi></msub><mo stretchy="false">)</mo></mrow></mrow><mo stretchy="false">‖</mo></mrow><mn>2</mn><mn>2</mn></msubsup><mo>]</mo></mrow></mrow><mo>−</mo><mrow><mi>𝔼</mi><mo>⁡</mo><mrow><mo>[</mo><msubsup><mrow><mo stretchy="false">‖</mo><mrow><msubsup><mi>P</mi><mrow><mi>𝜽</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><msub><mi>𝝃</mi><mi>T</mi></msub><mo stretchy="false">)</mo></mrow></mrow><mo>⟂</mo></msubsup><mo lspace="0em" rspace="0em">​</mo><msub><mover accent="true"><mi>𝐦</mi><mo>^</mo></mover><mi>λ</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mi>𝝃</mi><mi>T</mi></msub><mo stretchy="false">)</mo></mrow></mrow><mo stretchy="false">‖</mo></mrow><mn>2</mn><mn>2</mn></msubsup><mo>]</mo></mrow></mrow></mrow><mo maxsize="2.600em" minsize="2.600em" stretchy="true">|</mo></mrow><annotation encoding="application/x-tex">\displaystyle\Bigg|\mathbb{E}^{\mathbf{x}}\left[\|P^{\perp}_{\bm{\theta}(\bm{\xi}_{T})}\widehat{\mathbf{m}}_{\lambda}(\bm{\xi}_{T})\|^{2}_{2}\right]-\mathbb{E}\left[\|P^{\perp}_{\bm{\theta}(\bm{\xi}_{T})}\widehat{\mathbf{m}}_{\lambda}(\bm{\xi}_{T})\|^{2}_{2}\right]\Bigg|</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
<tbody id="A6.Ex388"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_eqn_cell"></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A6.Ex388.m1" class="ltx_Math" alttext="\displaystyle=\Bigg|\mathbb{E}^{\mathbf{x}}\left[\Big\|P^{\perp}_{\bm{\theta}(\bm{\xi}_{T})}\overline{\sum}_{t\in\mathcal{T}}\Big(K_{\lambda}\big(\mathbf{s}(\bm{\xi}_{t}),\mathbf{s}(\bm{\xi}_{T})\big)\,;\,\mathbf{f}(\bm{\xi}_{t+1})\Big)\Big\|^{2}_{2}\right]" display="inline" intent=":literal"><semantics><mrow><mo rspace="0em">=</mo><mo fence="false" lspace="0em">|</mo><mrow><msup><mi>𝔼</mi><mi>𝐱</mi></msup><mo lspace="0em" rspace="0em">​</mo><mrow><mo>[</mo><msubsup><mrow><mo maxsize="1.600em" minsize="1.600em" stretchy="true">‖</mo><mrow><msubsup><mi>P</mi><mrow><mi>𝜽</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><msub><mi>𝝃</mi><mi>T</mi></msub><mo stretchy="false">)</mo></mrow></mrow><mo>⟂</mo></msubsup><mo lspace="0.167em" rspace="0em">​</mo><msub><mover accent="true"><mstyle displaystyle="true"><mo movablelimits="false">∑</mo></mstyle><mo stretchy="true">¯</mo></mover><mrow><mi>t</mi><mo>∈</mo><mi class="ltx_font_mathcaligraphic">𝒯</mi></mrow></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo maxsize="1.600em" minsize="1.600em">(</mo><mrow><msub><mi>K</mi><mi>λ</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo maxsize="1.200em" minsize="1.200em">(</mo><mrow><mi>𝐬</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><msub><mi>𝝃</mi><mi>t</mi></msub><mo stretchy="false">)</mo></mrow></mrow><mo>,</mo><mrow><mi>𝐬</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><msub><mi>𝝃</mi><mi>T</mi></msub><mo stretchy="false">)</mo></mrow></mrow><mo maxsize="1.200em" minsize="1.200em" rspace="0.170em">)</mo></mrow></mrow><mo>,</mo><mrow><mi>𝐟</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><msub><mi>𝝃</mi><mrow><mi>t</mi><mo>+</mo><mn>1</mn></mrow></msub><mo stretchy="false">)</mo></mrow></mrow><mo maxsize="1.600em" minsize="1.600em">)</mo></mrow></mrow><mo maxsize="1.600em" minsize="1.600em" stretchy="true">‖</mo></mrow><mn>2</mn><mn>2</mn></msubsup><mo>]</mo></mrow></mrow></mrow><annotation encoding="application/x-tex">\displaystyle=\Bigg|\mathbb{E}^{\mathbf{x}}\left[\Big\|P^{\perp}_{\bm{\theta}(\bm{\xi}_{T})}\overline{\sum}_{t\in\mathcal{T}}\Big(K_{\lambda}\big(\mathbf{s}(\bm{\xi}_{t}),\mathbf{s}(\bm{\xi}_{T})\big)\,;\,\mathbf{f}(\bm{\xi}_{t+1})\Big)\Big\|^{2}_{2}\right]</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
<tbody id="A6.Ex389"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_eqn_cell"></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A6.Ex389.m1" class="ltx_math_unparsed" alttext="\displaystyle\qquad-\mathbb{E}\left[\Big\|P^{\perp}_{\bm{\theta}(\bm{\xi}_{T})}\overline{\sum}_{t\in\mathcal{T}}\Big(K_{\lambda}\big(\mathbf{s}(\bm{\xi}_{t}),\mathbf{s}(\bm{\xi}_{T})\big)\,;\,\mathbf{f}(\bm{\xi}_{t+1})\Big)\Big\|^{2}_{2}\right]\Bigg|" display="inline" intent=":literal"><semantics><mrow><mo>−</mo><mi>𝔼</mi><mrow><mo>[</mo><mo lspace="0em" mathsize="1.600em" rspace="0.167em">∥</mo><msubsup><mi>P</mi><mrow><mi>𝜽</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><msub><mi>𝝃</mi><mi>T</mi></msub><mo stretchy="false">)</mo></mrow></mrow><mo>⟂</mo></msubsup><msub><mover accent="true"><mstyle displaystyle="true"><mo movablelimits="false">∑</mo></mstyle><mo stretchy="true">¯</mo></mover><mrow><mi>t</mi><mo>∈</mo><mi class="ltx_font_mathcaligraphic">𝒯</mi></mrow></msub><mrow><mo maxsize="1.600em" minsize="1.600em">(</mo><msub><mi>K</mi><mi>λ</mi></msub><mrow><mo maxsize="1.200em" minsize="1.200em">(</mo><mi>𝐬</mi><mrow><mo stretchy="false">(</mo><msub><mi>𝝃</mi><mi>t</mi></msub><mo stretchy="false">)</mo></mrow><mo>,</mo><mi>𝐬</mi><mrow><mo stretchy="false">(</mo><msub><mi>𝝃</mi><mi>T</mi></msub><mo stretchy="false">)</mo></mrow><mo maxsize="1.200em" minsize="1.200em" rspace="0.170em">)</mo></mrow><mo rspace="0.337em">;</mo><mi>𝐟</mi><mrow><mo stretchy="false">(</mo><msub><mi>𝝃</mi><mrow><mi>t</mi><mo>+</mo><mn>1</mn></mrow></msub><mo stretchy="false">)</mo></mrow><mo maxsize="1.600em" minsize="1.600em">)</mo></mrow><msubsup><mo lspace="0em" mathsize="1.600em" rspace="0.167em">∥</mo><mn>2</mn><mn>2</mn></msubsup><mo>]</mo></mrow><mo fence="false" maxsize="2.600em" minsize="2.600em" stretchy="true">|</mo></mrow><annotation encoding="application/x-tex">\displaystyle\qquad-\mathbb{E}\left[\Big\|P^{\perp}_{\bm{\theta}(\bm{\xi}_{T})}\overline{\sum}_{t\in\mathcal{T}}\Big(K_{\lambda}\big(\mathbf{s}(\bm{\xi}_{t}),\mathbf{s}(\bm{\xi}_{T})\big)\,;\,\mathbf{f}(\bm{\xi}_{t+1})\Big)\Big\|^{2}_{2}\right]\Bigg|</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
<tbody id="A6.Ex390"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_eqn_cell"></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A6.Ex390.m1" class="ltx_Math" alttext="\displaystyle=\Bigg|\mathbb{E}^{\mathbf{x}}\left[\mathbb{E}^{\bm{\xi}_{\min(\mathcal{T})}}\left[\Big\|P^{\perp}_{\bm{\theta}(\bm{\xi}_{T^{*}})}\overline{\sum}_{t\in\{0,1,\ldots,|\mathcal{T}|-1\}}\Big(K_{\lambda}\big(\mathbf{s}(\bm{\xi}_{t}),\mathbf{s}(\bm{\xi}_{T^{*}})\big)\,;\,\mathbf{f}(\bm{\xi}_{t+1})\Big)\Big\|^{2}_{2}\right]\right]" display="inline" intent=":literal"><semantics><mrow><mo rspace="0em">=</mo><mo fence="false" lspace="0em">|</mo><mrow><msup><mi>𝔼</mi><mi>𝐱</mi></msup><mo lspace="0em" rspace="0em">​</mo><mrow><mo>[</mo><mrow><msup><mi>𝔼</mi><msub><mi>𝝃</mi><mrow><mi>min</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi class="ltx_font_mathcaligraphic">𝒯</mi><mo stretchy="false">)</mo></mrow></mrow></msub></msup><mo lspace="0em" rspace="0em">​</mo><mrow><mo>[</mo><msubsup><mrow><mo maxsize="1.600em" minsize="1.600em" stretchy="true">‖</mo><mrow><msubsup><mi>P</mi><mrow><mi>𝜽</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><msub><mi>𝝃</mi><msup><mi>T</mi><mo>∗</mo></msup></msub><mo stretchy="false">)</mo></mrow></mrow><mo>⟂</mo></msubsup><mo lspace="0.167em" rspace="0em">​</mo><msub><mover accent="true"><mstyle displaystyle="true"><mo movablelimits="false">∑</mo></mstyle><mo stretchy="true">¯</mo></mover><mrow><mi>t</mi><mo>∈</mo><mrow><mo stretchy="false">{</mo><mrow><mn>0</mn><mo>,</mo><mn>1</mn><mo>,</mo><mi mathvariant="normal">…</mi><mo>,</mo><mrow><mrow><mo stretchy="false">|</mo><mi class="ltx_font_mathcaligraphic">𝒯</mi><mo stretchy="false">|</mo></mrow><mo>−</mo><mn>1</mn></mrow></mrow><mo stretchy="false">}</mo></mrow></mrow></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo maxsize="1.600em" minsize="1.600em">(</mo><mrow><msub><mi>K</mi><mi>λ</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo maxsize="1.200em" minsize="1.200em">(</mo><mrow><mi>𝐬</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><msub><mi>𝝃</mi><mi>t</mi></msub><mo stretchy="false">)</mo></mrow></mrow><mo>,</mo><mrow><mi>𝐬</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><msub><mi>𝝃</mi><msup><mi>T</mi><mo>∗</mo></msup></msub><mo stretchy="false">)</mo></mrow></mrow><mo maxsize="1.200em" minsize="1.200em" rspace="0.170em">)</mo></mrow></mrow><mo>,</mo><mrow><mi>𝐟</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><msub><mi>𝝃</mi><mrow><mi>t</mi><mo>+</mo><mn>1</mn></mrow></msub><mo stretchy="false">)</mo></mrow></mrow><mo maxsize="1.600em" minsize="1.600em">)</mo></mrow></mrow><mo maxsize="1.600em" minsize="1.600em" stretchy="true">‖</mo></mrow><mn>2</mn><mn>2</mn></msubsup><mo>]</mo></mrow></mrow><mo>]</mo></mrow></mrow></mrow><annotation encoding="application/x-tex">\displaystyle=\Bigg|\mathbb{E}^{\mathbf{x}}\left[\mathbb{E}^{\bm{\xi}_{\min(\mathcal{T})}}\left[\Big\|P^{\perp}_{\bm{\theta}(\bm{\xi}_{T^{*}})}\overline{\sum}_{t\in\{0,1,\ldots,|\mathcal{T}|-1\}}\Big(K_{\lambda}\big(\mathbf{s}(\bm{\xi}_{t}),\mathbf{s}(\bm{\xi}_{T^{*}})\big)\,;\,\mathbf{f}(\bm{\xi}_{t+1})\Big)\Big\|^{2}_{2}\right]\right]</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
<tbody id="A6.Ex391"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_eqn_cell"></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A6.Ex391.m1" class="ltx_math_unparsed" alttext="\displaystyle\qquad-\mathbb{E}\left[\mathbb{E}^{\bm{\xi}_{\min(\mathcal{T})}}\left[\Big\|P^{\perp}_{\bm{\theta}(\bm{\xi}_{T^{*}})}\overline{\sum}_{t\in\{0,1,\ldots,|\mathcal{T}|-1\}}\Big(K_{\lambda}\big(\mathbf{s}(\bm{\xi}_{t}),\mathbf{s}(\bm{\xi}_{T^{*}})\big)\,;\,\mathbf{f}(\bm{\xi}_{t+1})\Big)\Big\|^{2}_{2}\right]\right]\Bigg|" display="inline" intent=":literal"><semantics><mrow><mo>−</mo><mi>𝔼</mi><mrow><mo>[</mo><msup><mi>𝔼</mi><msub><mi>𝝃</mi><mrow><mi>min</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi class="ltx_font_mathcaligraphic">𝒯</mi><mo stretchy="false">)</mo></mrow></mrow></msub></msup><mrow><mo>[</mo><mo lspace="0em" mathsize="1.600em" rspace="0.167em">∥</mo><msubsup><mi>P</mi><mrow><mi>𝜽</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><msub><mi>𝝃</mi><msup><mi>T</mi><mo>∗</mo></msup></msub><mo stretchy="false">)</mo></mrow></mrow><mo>⟂</mo></msubsup><msub><mover accent="true"><mstyle displaystyle="true"><mo movablelimits="false">∑</mo></mstyle><mo stretchy="true">¯</mo></mover><mrow><mi>t</mi><mo>∈</mo><mrow><mo stretchy="false">{</mo><mrow><mn>0</mn><mo>,</mo><mn>1</mn><mo>,</mo><mi mathvariant="normal">…</mi><mo>,</mo><mrow><mrow><mo stretchy="false">|</mo><mi class="ltx_font_mathcaligraphic">𝒯</mi><mo stretchy="false">|</mo></mrow><mo>−</mo><mn>1</mn></mrow></mrow><mo stretchy="false">}</mo></mrow></mrow></msub><mrow><mo maxsize="1.600em" minsize="1.600em">(</mo><msub><mi>K</mi><mi>λ</mi></msub><mrow><mo maxsize="1.200em" minsize="1.200em">(</mo><mi>𝐬</mi><mrow><mo stretchy="false">(</mo><msub><mi>𝝃</mi><mi>t</mi></msub><mo stretchy="false">)</mo></mrow><mo>,</mo><mi>𝐬</mi><mrow><mo stretchy="false">(</mo><msub><mi>𝝃</mi><msup><mi>T</mi><mo>∗</mo></msup></msub><mo stretchy="false">)</mo></mrow><mo maxsize="1.200em" minsize="1.200em" rspace="0.170em">)</mo></mrow><mo rspace="0.337em">;</mo><mi>𝐟</mi><mrow><mo stretchy="false">(</mo><msub><mi>𝝃</mi><mrow><mi>t</mi><mo>+</mo><mn>1</mn></mrow></msub><mo stretchy="false">)</mo></mrow><mo maxsize="1.600em" minsize="1.600em">)</mo></mrow><msubsup><mo lspace="0em" mathsize="1.600em" rspace="0.167em">∥</mo><mn>2</mn><mn>2</mn></msubsup><mo>]</mo></mrow><mo>]</mo></mrow><mo fence="false" maxsize="2.600em" minsize="2.600em" stretchy="true">|</mo></mrow><annotation encoding="application/x-tex">\displaystyle\qquad-\mathbb{E}\left[\mathbb{E}^{\bm{\xi}_{\min(\mathcal{T})}}\left[\Big\|P^{\perp}_{\bm{\theta}(\bm{\xi}_{T^{*}})}\overline{\sum}_{t\in\{0,1,\ldots,|\mathcal{T}|-1\}}\Big(K_{\lambda}\big(\mathbf{s}(\bm{\xi}_{t}),\mathbf{s}(\bm{\xi}_{T^{*}})\big)\,;\,\mathbf{f}(\bm{\xi}_{t+1})\Big)\Big\|^{2}_{2}\right]\right]\Bigg|</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
<tbody id="A6.Ex392"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_eqn_cell"></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A6.Ex392.m1" class="ltx_Math" alttext="\displaystyle\leq\|\mathbf{f}\|_{\infty}^{2}\sup_{\mathbf{x}\in\mathcal{D}}\|P^{\min(\mathcal{T})}(\mathbf{x},\cdot)-\rho\|_{\operatorname{TV}}" display="inline" intent=":literal"><semantics><mrow><mphantom></mphantom><mo>≤</mo><mrow><msubsup><mrow><mo stretchy="false">‖</mo><mi>𝐟</mi><mo stretchy="false">‖</mo></mrow><mi mathvariant="normal">∞</mi><mn>2</mn></msubsup><mo lspace="0.167em" rspace="0em">​</mo><mrow><munder><mo movablelimits="false" rspace="0em">sup</mo><mrow><mi>𝐱</mi><mo>∈</mo><mi class="ltx_font_mathcaligraphic">𝒟</mi></mrow></munder><msub><mrow><mo stretchy="false">‖</mo><mrow><mrow><msup><mi>P</mi><mrow><mi>min</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi class="ltx_font_mathcaligraphic">𝒯</mi><mo stretchy="false">)</mo></mrow></mrow></msup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>𝐱</mi><mo rspace="0em">,</mo><mo lspace="0em" rspace="0em">⋅</mo><mo stretchy="false">)</mo></mrow></mrow><mo>−</mo><mi>ρ</mi></mrow><mo stretchy="false">‖</mo></mrow><mi>TV</mi></msub></mrow></mrow></mrow><annotation encoding="application/x-tex">\displaystyle\leq\|\mathbf{f}\|_{\infty}^{2}\sup_{\mathbf{x}\in\mathcal{D}}\|P^{\min(\mathcal{T})}(\mathbf{x},\cdot)-\rho\|_{\operatorname{TV}}</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
<tbody id="A6.E104"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_eqn_cell"></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A6.E104.m1" class="ltx_Math" alttext="\displaystyle\leq\|\mathbf{f}\|_{\infty}^{2}c_{\mathbf{M}}^{\min(\mathcal{T})}," display="inline" intent=":literal"><semantics><mrow><mrow><mphantom></mphantom><mo>≤</mo><mrow><msubsup><mrow><mo stretchy="false">‖</mo><mi>𝐟</mi><mo stretchy="false">‖</mo></mrow><mi mathvariant="normal">∞</mi><mn>2</mn></msubsup><mo lspace="0em" rspace="0em">​</mo><msubsup><mi>c</mi><mi>𝐌</mi><mrow><mi>min</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi class="ltx_font_mathcaligraphic">𝒯</mi><mo stretchy="false">)</mo></mrow></mrow></msubsup></mrow></mrow><mo>,</mo></mrow><annotation encoding="application/x-tex">\displaystyle\leq\|\mathbf{f}\|_{\infty}^{2}c_{\mathbf{M}}^{\min(\mathcal{T})},</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td>
<td rowspan="1" class="ltx_eqn_cell ltx_eqn_eqno ltx_align_middle ltx_align_right"><span class="ltx_tag ltx_tag_equation ltx_align_right">(104)</span></td></tr></tbody>
</table>
<p id="A6.SS3.p1.3" class="ltx_p"><span id="A6.SS3.p1.3.1" class="ltx_text">where we applied the Markov property in the second equality. In the first inequality we used that</span></p>
<table id="A6.Ex393" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="A6.Ex393.m1" class="ltx_Math" alttext="\mathbb{E}^{\bm{\xi}_{\min(\mathcal{T})}}\left[\Big\|P^{\perp}_{\bm{\theta}(\bm{\xi}_{T^{*}})}\overline{\sum}_{t\in\{0,1,\ldots,|\mathcal{T}|-1\}}\Big(K_{\lambda}\big(\mathbf{s}(\bm{\xi}_{t}),\mathbf{s}(\bm{\xi}_{T^{*}})\big)\,;\,\mathbf{f}(\bm{\xi}_{t+1})\Big)\Big\|^{2}_{2}\right]" display="block" intent=":literal"><semantics><mrow><msup><mi>𝔼</mi><msub><mi>𝝃</mi><mrow><mi>min</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi class="ltx_font_mathcaligraphic">𝒯</mi><mo stretchy="false">)</mo></mrow></mrow></msub></msup><mo lspace="0em" rspace="0em">​</mo><mrow><mo>[</mo><msubsup><mrow><mo maxsize="1.600em" minsize="1.600em" stretchy="true">‖</mo><mrow><msubsup><mi>P</mi><mrow><mi>𝜽</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><msub><mi>𝝃</mi><msup><mi>T</mi><mo>∗</mo></msup></msub><mo stretchy="false">)</mo></mrow></mrow><mo>⟂</mo></msubsup><mo lspace="0em" rspace="0em">​</mo><msub><mover accent="true"><mo movablelimits="false">∑</mo><mo stretchy="true">¯</mo></mover><mrow><mi>t</mi><mo>∈</mo><mrow><mo stretchy="false">{</mo><mrow><mn>0</mn><mo>,</mo><mn>1</mn><mo>,</mo><mi mathvariant="normal">…</mi><mo>,</mo><mrow><mrow><mo stretchy="false">|</mo><mi class="ltx_font_mathcaligraphic">𝒯</mi><mo stretchy="false">|</mo></mrow><mo>−</mo><mn>1</mn></mrow></mrow><mo stretchy="false">}</mo></mrow></mrow></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo maxsize="1.600em" minsize="1.600em">(</mo><mrow><msub><mi>K</mi><mi>λ</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo maxsize="1.200em" minsize="1.200em">(</mo><mrow><mi>𝐬</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><msub><mi>𝝃</mi><mi>t</mi></msub><mo stretchy="false">)</mo></mrow></mrow><mo>,</mo><mrow><mi>𝐬</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><msub><mi>𝝃</mi><msup><mi>T</mi><mo>∗</mo></msup></msub><mo stretchy="false">)</mo></mrow></mrow><mo maxsize="1.200em" minsize="1.200em" rspace="0.170em">)</mo></mrow></mrow><mo>,</mo><mrow><mi>𝐟</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><msub><mi>𝝃</mi><mrow><mi>t</mi><mo>+</mo><mn>1</mn></mrow></msub><mo stretchy="false">)</mo></mrow></mrow><mo maxsize="1.600em" minsize="1.600em">)</mo></mrow></mrow><mo maxsize="1.600em" minsize="1.600em" stretchy="true">‖</mo></mrow><mn>2</mn><mn>2</mn></msubsup><mo>]</mo></mrow></mrow><annotation encoding="application/x-tex">\mathbb{E}^{\bm{\xi}_{\min(\mathcal{T})}}\left[\Big\|P^{\perp}_{\bm{\theta}(\bm{\xi}_{T^{*}})}\overline{\sum}_{t\in\{0,1,\ldots,|\mathcal{T}|-1\}}\Big(K_{\lambda}\big(\mathbf{s}(\bm{\xi}_{t}),\mathbf{s}(\bm{\xi}_{T^{*}})\big)\,;\,\mathbf{f}(\bm{\xi}_{t+1})\Big)\Big\|^{2}_{2}\right]</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="A6.SS3.p1.4" class="ltx_p"><span id="A6.SS3.p1.4.1" class="ltx_text">is a measurable function of <math id="A6.SS3.p1.m5" class="ltx_Math" alttext="\bm{\xi}_{\min(\mathcal{T})}," display="inline" intent=":literal"><semantics><mrow><msub><mi>𝝃</mi><mrow><mi>min</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi class="ltx_font_mathcaligraphic">𝒯</mi><mo stretchy="false">)</mo></mrow></mrow></msub><mo>,</mo></mrow><annotation encoding="application/x-tex">\bm{\xi}_{\min(\mathcal{T})},</annotation></semantics></math> which is bounded by <math id="A6.SS3.p1.m6" class="ltx_Math" alttext="\|\mathbf{f}\|_{\infty}^{2}" display="inline" intent=":literal"><semantics><msubsup><mrow><mo stretchy="false">‖</mo><mi>𝐟</mi><mo stretchy="false">‖</mo></mrow><mi mathvariant="normal">∞</mi><mn>2</mn></msubsup><annotation encoding="application/x-tex">\|\mathbf{f}\|_{\infty}^{2}</annotation></semantics></math> together with the fact that <math id="A6.SS3.p1.m7" class="ltx_Math" alttext="\bm{\xi}_{\min(\mathcal{T})}\sim P^{\min(\mathcal{T})}" display="inline" intent=":literal"><semantics><mrow><msub><mi>𝝃</mi><mrow><mi>min</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi class="ltx_font_mathcaligraphic">𝒯</mi><mo stretchy="false">)</mo></mrow></mrow></msub><mo>∼</mo><msup><mi>P</mi><mrow><mi>min</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi class="ltx_font_mathcaligraphic">𝒯</mi><mo stretchy="false">)</mo></mrow></mrow></msup></mrow><annotation encoding="application/x-tex">\bm{\xi}_{\min(\mathcal{T})}\sim P^{\min(\mathcal{T})}</annotation></semantics></math> under <math id="A6.SS3.p1.m8" class="ltx_Math" alttext="\mathbb{P}^{\mathbf{x}}" display="inline" intent=":literal"><semantics><msup><mi>ℙ</mi><mi>𝐱</mi></msup><annotation encoding="application/x-tex">\mathbb{P}^{\mathbf{x}}</annotation></semantics></math> and <math id="A6.SS3.p1.m9" class="ltx_Math" alttext="\bm{\xi}_{\min(\mathcal{T})}\sim\rho" display="inline" intent=":literal"><semantics><mrow><msub><mi>𝝃</mi><mrow><mi>min</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi class="ltx_font_mathcaligraphic">𝒯</mi><mo stretchy="false">)</mo></mrow></mrow></msub><mo>∼</mo><mi>ρ</mi></mrow><annotation encoding="application/x-tex">\bm{\xi}_{\min(\mathcal{T})}\sim\rho</annotation></semantics></math> under <math id="A6.SS3.p1.m10" class="ltx_Math" alttext="\mathbb{P}" display="inline" intent=":literal"><semantics><mi>ℙ</mi><annotation encoding="application/x-tex">\mathbb{P}</annotation></semantics></math>. We now apply Berbee’s coupling lemma, see Lemma 5.1 in <cite class="ltx_cite ltx_citemacro_cite">[<a href="#bib.bib11" title="" class="ltx_ref">74</a>]</cite> and <cite class="ltx_cite ltx_citemacro_cite">[<a href="#bib.bib12" title="" class="ltx_ref">7</a>]</cite>. This states for two random variables <math id="A6.SS3.p1.m11" class="ltx_Math" alttext="X,Y," display="inline" intent=":literal"><semantics><mrow><mrow><mi>X</mi><mo>,</mo><mi>Y</mi></mrow><mo>,</mo></mrow><annotation encoding="application/x-tex">X,Y,</annotation></semantics></math> that there exists a random variable <math id="A6.SS3.p1.m12" class="ltx_Math" alttext="Y^{*}," display="inline" intent=":literal"><semantics><mrow><msup><mi>Y</mi><mo>∗</mo></msup><mo>,</mo></mrow><annotation encoding="application/x-tex">Y^{*},</annotation></semantics></math> which is independent of <math id="A6.SS3.p1.m13" class="ltx_Math" alttext="X," display="inline" intent=":literal"><semantics><mrow><mi>X</mi><mo>,</mo></mrow><annotation encoding="application/x-tex">X,</annotation></semantics></math> identically distributed as <math id="A6.SS3.p1.m14" class="ltx_Math" alttext="Y," display="inline" intent=":literal"><semantics><mrow><mi>Y</mi><mo>,</mo></mrow><annotation encoding="application/x-tex">Y,</annotation></semantics></math> and satisfies</span></p>
<table id="A6.Ex394" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="A6.Ex394.m1" class="ltx_Math" alttext="\mathbb{P}(Y\neq Y^{*})=\beta(X,Y)," display="block" intent=":literal"><semantics><mrow><mrow><mrow><mi>ℙ</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mrow><mi>Y</mi><mo>≠</mo><msup><mi>Y</mi><mo>∗</mo></msup></mrow><mo stretchy="false">)</mo></mrow></mrow><mo>=</mo><mrow><mi>β</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>X</mi><mo>,</mo><mi>Y</mi><mo stretchy="false">)</mo></mrow></mrow></mrow><mo>,</mo></mrow><annotation encoding="application/x-tex">\mathbb{P}(Y\neq Y^{*})=\beta(X,Y),</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="A6.SS3.p1.5" class="ltx_p"><span id="A6.SS3.p1.5.1" class="ltx_text">where <math id="A6.SS3.p1.m15" class="ltx_Math" alttext="\beta(X,Y)" display="inline" intent=":literal"><semantics><mrow><mi>β</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>X</mi><mo>,</mo><mi>Y</mi><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">\beta(X,Y)</annotation></semantics></math> is the <math id="A6.SS3.p1.m16" class="ltx_Math" alttext="\beta" display="inline" intent=":literal"><semantics><mi>β</mi><annotation encoding="application/x-tex">\beta</annotation></semantics></math>-mixing coefficient of <math id="A6.SS3.p1.m17" class="ltx_Math" alttext="X" display="inline" intent=":literal"><semantics><mi>X</mi><annotation encoding="application/x-tex">X</annotation></semantics></math> and <math id="A6.SS3.p1.m18" class="ltx_Math" alttext="Y" display="inline" intent=":literal"><semantics><mi>Y</mi><annotation encoding="application/x-tex">Y</annotation></semantics></math>.
Since the investigated Markov chain is stationary under <math id="A6.SS3.p1.m19" class="ltx_Math" alttext="\mathbb{P}," display="inline" intent=":literal"><semantics><mrow><mi>ℙ</mi><mo>,</mo></mrow><annotation encoding="application/x-tex">\mathbb{P},</annotation></semantics></math> and uniformly ergodic, we can argue as in the proof of Theorem 3.1 in <cite class="ltx_cite ltx_citemacro_cite">[<a href="#bib.bib10" title="" class="ltx_ref">16</a>]</cite> to obtain</span></p>
<table id="A6.EGx166" class="ltx_equationgroup ltx_eqn_align ltx_eqn_table">

<tbody id="A6.Ex395"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_align_right ltx_eqn_cell"><math id="A6.Ex395.m1" class="ltx_Math" alttext="\displaystyle\beta\Big(\big(\bm{\xi}_{\min(\mathcal{T})},\bm{\xi}_{\min(\mathcal{T})+1},\ldots,\bm{\xi}_{\max(\mathcal{T})}\big),\,\bm{\xi}_{T}\Big)" display="inline" intent=":literal"><semantics><mrow><mi>β</mi><mo>⁡</mo><mrow><mo maxsize="1.600em" minsize="1.600em">(</mo><mrow><mo maxsize="1.200em" minsize="1.200em">(</mo><msub><mi>𝝃</mi><mrow><mi>min</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi class="ltx_font_mathcaligraphic">𝒯</mi><mo stretchy="false">)</mo></mrow></mrow></msub><mo>,</mo><msub><mi>𝝃</mi><mrow><mrow><mi>min</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi class="ltx_font_mathcaligraphic">𝒯</mi><mo stretchy="false">)</mo></mrow></mrow><mo>+</mo><mn>1</mn></mrow></msub><mo>,</mo><mi mathvariant="normal">…</mi><mo>,</mo><msub><mi>𝝃</mi><mrow><mi>max</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi class="ltx_font_mathcaligraphic">𝒯</mi><mo stretchy="false">)</mo></mrow></mrow></msub><mo maxsize="1.200em" minsize="1.200em">)</mo></mrow><mo>,</mo><msub><mi>𝝃</mi><mi>T</mi></msub><mo maxsize="1.600em" minsize="1.600em">)</mo></mrow></mrow><annotation encoding="application/x-tex">\displaystyle\beta\Big(\big(\bm{\xi}_{\min(\mathcal{T})},\bm{\xi}_{\min(\mathcal{T})+1},\ldots,\bm{\xi}_{\max(\mathcal{T})}\big),\,\bm{\xi}_{T}\Big)</annotation></semantics></math></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A6.Ex395.m2" class="ltx_Math" alttext="\displaystyle\leq c_{\mathbf{M}}^{T-\max(\mathcal{T})}." display="inline" intent=":literal"><semantics><mrow><mrow><mphantom></mphantom><mo>≤</mo><msubsup><mi>c</mi><mi>𝐌</mi><mrow><mi>T</mi><mo>−</mo><mrow><mi>max</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi class="ltx_font_mathcaligraphic">𝒯</mi><mo stretchy="false">)</mo></mrow></mrow></mrow></msubsup></mrow><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">\displaystyle\leq c_{\mathbf{M}}^{T-\max(\mathcal{T})}.</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="A6.SS3.p1.6" class="ltx_p"><span id="A6.SS3.p1.6.1" class="ltx_text">Hence, there exists a random variable <math id="A6.SS3.p1.m20" class="ltx_Math" alttext="\tilde{\bm{\xi}}" display="inline" intent=":literal"><semantics><mover accent="true"><mi>𝝃</mi><mo>~</mo></mover><annotation encoding="application/x-tex">\tilde{\bm{\xi}}</annotation></semantics></math> which is independent of <math id="A6.SS3.p1.m21" class="ltx_Math" alttext="(\bm{\xi}_{\min(\mathcal{T})},\bm{\xi}_{\min(\mathcal{T})+1},\ldots,\bm{\xi}_{\max(\mathcal{T})})," display="inline" intent=":literal"><semantics><mrow><mrow><mo stretchy="false">(</mo><msub><mi>𝝃</mi><mrow><mi>min</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi class="ltx_font_mathcaligraphic">𝒯</mi><mo stretchy="false">)</mo></mrow></mrow></msub><mo>,</mo><msub><mi>𝝃</mi><mrow><mrow><mi>min</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi class="ltx_font_mathcaligraphic">𝒯</mi><mo stretchy="false">)</mo></mrow></mrow><mo>+</mo><mn>1</mn></mrow></msub><mo>,</mo><mi mathvariant="normal">…</mi><mo>,</mo><msub><mi>𝝃</mi><mrow><mi>max</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi class="ltx_font_mathcaligraphic">𝒯</mi><mo stretchy="false">)</mo></mrow></mrow></msub><mo stretchy="false">)</mo></mrow><mo>,</mo></mrow><annotation encoding="application/x-tex">(\bm{\xi}_{\min(\mathcal{T})},\bm{\xi}_{\min(\mathcal{T})+1},\ldots,\bm{\xi}_{\max(\mathcal{T})}),</annotation></semantics></math> such that</span></p>
<table id="A6.EGx167" class="ltx_equationgroup ltx_eqn_align ltx_eqn_table">

<tbody id="A6.Ex396"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_eqn_cell"></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A6.Ex396.m1" class="ltx_Math" alttext="\displaystyle\Bigg|\mathbb{E}\left[\Big\|P^{\perp}_{\bm{\theta}(\bm{\xi}_{T})}\overline{\sum}_{t\in\mathcal{T}}\Big(K_{\lambda}\big(\mathbf{s}(\bm{\xi}_{t}),\mathbf{s}(\bm{\xi}_{T})\big)\,;\,\mathbf{f}(\bm{\xi}_{t+1})\Big)\Big\|^{2}_{2}\right]-\mathbb{E}\left[\Big\|P^{\perp}_{\bm{\theta}(\tilde{\bm{\xi}})}\overline{\sum}_{t\in\mathcal{T}}\Big(K_{\lambda}\big(\mathbf{s}(\bm{\xi}_{t}),\mathbf{s}(\tilde{\bm{\xi}})\big)\,;\,\mathbf{f}(\bm{\xi}_{t+1})\Big)\Big\|^{2}_{2}\right]\Bigg|" display="inline" intent=":literal"><semantics><mrow><mo maxsize="2.600em" minsize="2.600em" stretchy="true">|</mo><mrow><mrow><mi>𝔼</mi><mo>⁡</mo><mrow><mo>[</mo><msubsup><mrow><mo maxsize="1.600em" minsize="1.600em" stretchy="true">‖</mo><mrow><msubsup><mi>P</mi><mrow><mi>𝜽</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><msub><mi>𝝃</mi><mi>T</mi></msub><mo stretchy="false">)</mo></mrow></mrow><mo>⟂</mo></msubsup><mo lspace="0.167em" rspace="0em">​</mo><msub><mover accent="true"><mstyle displaystyle="true"><mo movablelimits="false">∑</mo></mstyle><mo stretchy="true">¯</mo></mover><mrow><mi>t</mi><mo>∈</mo><mi class="ltx_font_mathcaligraphic">𝒯</mi></mrow></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo maxsize="1.600em" minsize="1.600em">(</mo><mrow><msub><mi>K</mi><mi>λ</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo maxsize="1.200em" minsize="1.200em">(</mo><mrow><mi>𝐬</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><msub><mi>𝝃</mi><mi>t</mi></msub><mo stretchy="false">)</mo></mrow></mrow><mo>,</mo><mrow><mi>𝐬</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><msub><mi>𝝃</mi><mi>T</mi></msub><mo stretchy="false">)</mo></mrow></mrow><mo maxsize="1.200em" minsize="1.200em" rspace="0.170em">)</mo></mrow></mrow><mo>,</mo><mrow><mi>𝐟</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><msub><mi>𝝃</mi><mrow><mi>t</mi><mo>+</mo><mn>1</mn></mrow></msub><mo stretchy="false">)</mo></mrow></mrow><mo maxsize="1.600em" minsize="1.600em">)</mo></mrow></mrow><mo maxsize="1.600em" minsize="1.600em" stretchy="true">‖</mo></mrow><mn>2</mn><mn>2</mn></msubsup><mo>]</mo></mrow></mrow><mo>−</mo><mrow><mi>𝔼</mi><mo>⁡</mo><mrow><mo>[</mo><msubsup><mrow><mo maxsize="1.600em" minsize="1.600em" stretchy="true">‖</mo><mrow><msubsup><mi>P</mi><mrow><mi>𝜽</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mover accent="true"><mi>𝝃</mi><mo>~</mo></mover><mo stretchy="false">)</mo></mrow></mrow><mo>⟂</mo></msubsup><mo lspace="0.167em" rspace="0em">​</mo><msub><mover accent="true"><mstyle displaystyle="true"><mo movablelimits="false">∑</mo></mstyle><mo stretchy="true">¯</mo></mover><mrow><mi>t</mi><mo>∈</mo><mi class="ltx_font_mathcaligraphic">𝒯</mi></mrow></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo maxsize="1.600em" minsize="1.600em">(</mo><mrow><msub><mi>K</mi><mi>λ</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo maxsize="1.200em" minsize="1.200em">(</mo><mrow><mi>𝐬</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><msub><mi>𝝃</mi><mi>t</mi></msub><mo stretchy="false">)</mo></mrow></mrow><mo>,</mo><mrow><mi>𝐬</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mover accent="true"><mi>𝝃</mi><mo>~</mo></mover><mo stretchy="false">)</mo></mrow></mrow><mo maxsize="1.200em" minsize="1.200em" rspace="0.170em">)</mo></mrow></mrow><mo>,</mo><mrow><mi>𝐟</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><msub><mi>𝝃</mi><mrow><mi>t</mi><mo>+</mo><mn>1</mn></mrow></msub><mo stretchy="false">)</mo></mrow></mrow><mo maxsize="1.600em" minsize="1.600em">)</mo></mrow></mrow><mo maxsize="1.600em" minsize="1.600em" stretchy="true">‖</mo></mrow><mn>2</mn><mn>2</mn></msubsup><mo>]</mo></mrow></mrow></mrow><mo maxsize="2.600em" minsize="2.600em" stretchy="true">|</mo></mrow><annotation encoding="application/x-tex">\displaystyle\Bigg|\mathbb{E}\left[\Big\|P^{\perp}_{\bm{\theta}(\bm{\xi}_{T})}\overline{\sum}_{t\in\mathcal{T}}\Big(K_{\lambda}\big(\mathbf{s}(\bm{\xi}_{t}),\mathbf{s}(\bm{\xi}_{T})\big)\,;\,\mathbf{f}(\bm{\xi}_{t+1})\Big)\Big\|^{2}_{2}\right]-\mathbb{E}\left[\Big\|P^{\perp}_{\bm{\theta}(\tilde{\bm{\xi}})}\overline{\sum}_{t\in\mathcal{T}}\Big(K_{\lambda}\big(\mathbf{s}(\bm{\xi}_{t}),\mathbf{s}(\tilde{\bm{\xi}})\big)\,;\,\mathbf{f}(\bm{\xi}_{t+1})\Big)\Big\|^{2}_{2}\right]\Bigg|</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
<tbody id="A6.Ex397"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_eqn_cell"></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A6.Ex397.m1" class="ltx_Math" alttext="\displaystyle\leq 2\|\mathbf{f}\|^{2}_{\infty}\mathbb{P}(\bm{\xi}_{T}\neq\tilde{\bm{\xi}})" display="inline" intent=":literal"><semantics><mrow><mphantom></mphantom><mo>≤</mo><mrow><mn>2</mn><mo lspace="0em" rspace="0em">​</mo><msubsup><mrow><mo stretchy="false">‖</mo><mi>𝐟</mi><mo stretchy="false">‖</mo></mrow><mi mathvariant="normal">∞</mi><mn>2</mn></msubsup><mo lspace="0em" rspace="0em">​</mo><mi>ℙ</mi><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mrow><msub><mi>𝝃</mi><mi>T</mi></msub><mo>≠</mo><mover accent="true"><mi>𝝃</mi><mo>~</mo></mover></mrow><mo stretchy="false">)</mo></mrow></mrow></mrow><annotation encoding="application/x-tex">\displaystyle\leq 2\|\mathbf{f}\|^{2}_{\infty}\mathbb{P}(\bm{\xi}_{T}\neq\tilde{\bm{\xi}})</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
<tbody id="A6.E105"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_eqn_cell"></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A6.E105.m1" class="ltx_Math" alttext="\displaystyle\leq 2\|\mathbf{f}\|_{\infty}^{2}c_{\mathbf{M}}^{T-\max(\mathcal{T})}," display="inline" intent=":literal"><semantics><mrow><mrow><mphantom></mphantom><mo>≤</mo><mrow><mn>2</mn><mo lspace="0em" rspace="0em">​</mo><msubsup><mrow><mo stretchy="false">‖</mo><mi>𝐟</mi><mo stretchy="false">‖</mo></mrow><mi mathvariant="normal">∞</mi><mn>2</mn></msubsup><mo lspace="0em" rspace="0em">​</mo><msubsup><mi>c</mi><mi>𝐌</mi><mrow><mi>T</mi><mo>−</mo><mrow><mi>max</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi class="ltx_font_mathcaligraphic">𝒯</mi><mo stretchy="false">)</mo></mrow></mrow></mrow></msubsup></mrow></mrow><mo>,</mo></mrow><annotation encoding="application/x-tex">\displaystyle\leq 2\|\mathbf{f}\|_{\infty}^{2}c_{\mathbf{M}}^{T-\max(\mathcal{T})},</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td>
<td rowspan="1" class="ltx_eqn_cell ltx_eqn_eqno ltx_align_middle ltx_align_right"><span class="ltx_tag ltx_tag_equation ltx_align_right">(105)</span></td></tr></tbody>
</table>
<p id="A6.SS3.p1.7" class="ltx_p"><span id="A6.SS3.p1.7.1" class="ltx_text">where we again used that the weighted sum is bounded by <math id="A6.SS3.p1.m22" class="ltx_Math" alttext="\|\mathbf{f}\|_{\infty}" display="inline" intent=":literal"><semantics><msub><mrow><mo stretchy="false">‖</mo><mi>𝐟</mi><mo stretchy="false">‖</mo></mrow><mi mathvariant="normal">∞</mi></msub><annotation encoding="application/x-tex">\|\mathbf{f}\|_{\infty}</annotation></semantics></math>.
By construction, <math id="A6.SS3.p1.m23" class="ltx_Math" alttext="\tilde{\bm{\xi}}" display="inline" intent=":literal"><semantics><mover accent="true"><mi>𝝃</mi><mo>~</mo></mover><annotation encoding="application/x-tex">\tilde{\bm{\xi}}</annotation></semantics></math> is identically distributed as <math id="A6.SS3.p1.m24" class="ltx_Math" alttext="\bm{\xi}_{T}\sim\rho" display="inline" intent=":literal"><semantics><mrow><msub><mi>𝝃</mi><mi>T</mi></msub><mo>∼</mo><mi>ρ</mi></mrow><annotation encoding="application/x-tex">\bm{\xi}_{T}\sim\rho</annotation></semantics></math> under <math id="A6.SS3.p1.m25" class="ltx_Math" alttext="\mathbb{P}," display="inline" intent=":literal"><semantics><mrow><mi>ℙ</mi><mo>,</mo></mrow><annotation encoding="application/x-tex">\mathbb{P},</annotation></semantics></math> which implies</span></p>
<table id="A6.EGx168" class="ltx_equationgroup ltx_eqn_align ltx_eqn_table">

<tbody id="A6.E106"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_align_right ltx_eqn_cell"><math id="A6.E106.m1" class="ltx_Math" alttext="\displaystyle\mathbb{E}\left[\Big\|P^{\perp}_{\bm{\theta}(\tilde{\bm{\xi}})}\overline{\sum}_{t\in\mathcal{T}}\Big(K_{\lambda}\big(\mathbf{s}(\bm{\xi}_{t}),\mathbf{s}(\tilde{\bm{\xi}})\big)\,;\,\mathbf{f}(\bm{\xi}_{t+1})\Big)\Big\|^{2}_{2}\right]=\sum_{\mathbf{x}\in\mathcal{D}}\mathbb{E}\left[\Big\|P^{\perp}_{\bm{\theta}(\mathbf{x})}\overline{\sum}_{t\in\mathcal{T}}\Big(K_{\lambda}\big(\mathbf{s}(\bm{\xi}_{t}),\mathbf{s}(\mathbf{x})\big)\,;\,\mathbf{f}(\bm{\xi}_{t+1})\Big)\Big\|^{2}_{2}\right]\rho(\mathbf{x})." display="inline" intent=":literal"><semantics><mrow><mrow><mrow><mi>𝔼</mi><mo>⁡</mo><mrow><mo>[</mo><msubsup><mrow><mo maxsize="1.600em" minsize="1.600em" stretchy="true">‖</mo><mrow><msubsup><mi>P</mi><mrow><mi>𝜽</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mover accent="true"><mi>𝝃</mi><mo>~</mo></mover><mo stretchy="false">)</mo></mrow></mrow><mo>⟂</mo></msubsup><mo lspace="0.167em" rspace="0em">​</mo><msub><mover accent="true"><mstyle displaystyle="true"><mo movablelimits="false">∑</mo></mstyle><mo stretchy="true">¯</mo></mover><mrow><mi>t</mi><mo>∈</mo><mi class="ltx_font_mathcaligraphic">𝒯</mi></mrow></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo maxsize="1.600em" minsize="1.600em">(</mo><mrow><msub><mi>K</mi><mi>λ</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo maxsize="1.200em" minsize="1.200em">(</mo><mrow><mi>𝐬</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><msub><mi>𝝃</mi><mi>t</mi></msub><mo stretchy="false">)</mo></mrow></mrow><mo>,</mo><mrow><mi>𝐬</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mover accent="true"><mi>𝝃</mi><mo>~</mo></mover><mo stretchy="false">)</mo></mrow></mrow><mo maxsize="1.200em" minsize="1.200em" rspace="0.170em">)</mo></mrow></mrow><mo>,</mo><mrow><mi>𝐟</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><msub><mi>𝝃</mi><mrow><mi>t</mi><mo>+</mo><mn>1</mn></mrow></msub><mo stretchy="false">)</mo></mrow></mrow><mo maxsize="1.600em" minsize="1.600em">)</mo></mrow></mrow><mo maxsize="1.600em" minsize="1.600em" stretchy="true">‖</mo></mrow><mn>2</mn><mn>2</mn></msubsup><mo>]</mo></mrow></mrow><mo>=</mo><mrow><mstyle displaystyle="true"><munder><mo movablelimits="false">∑</mo><mrow><mi>𝐱</mi><mo>∈</mo><mi class="ltx_font_mathcaligraphic">𝒟</mi></mrow></munder></mstyle><mrow><mrow><mi>𝔼</mi><mo>⁡</mo><mrow><mo>[</mo><msubsup><mrow><mo maxsize="1.600em" minsize="1.600em" stretchy="true">‖</mo><mrow><msubsup><mi>P</mi><mrow><mi>𝜽</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>𝐱</mi><mo stretchy="false">)</mo></mrow></mrow><mo>⟂</mo></msubsup><mo lspace="0.167em" rspace="0em">​</mo><msub><mover accent="true"><mstyle displaystyle="true"><mo movablelimits="false">∑</mo></mstyle><mo stretchy="true">¯</mo></mover><mrow><mi>t</mi><mo>∈</mo><mi class="ltx_font_mathcaligraphic">𝒯</mi></mrow></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo maxsize="1.600em" minsize="1.600em">(</mo><mrow><msub><mi>K</mi><mi>λ</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo maxsize="1.200em" minsize="1.200em">(</mo><mrow><mi>𝐬</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><msub><mi>𝝃</mi><mi>t</mi></msub><mo stretchy="false">)</mo></mrow></mrow><mo>,</mo><mrow><mi>𝐬</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>𝐱</mi><mo stretchy="false">)</mo></mrow></mrow><mo maxsize="1.200em" minsize="1.200em" rspace="0.170em">)</mo></mrow></mrow><mo>,</mo><mrow><mi>𝐟</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><msub><mi>𝝃</mi><mrow><mi>t</mi><mo>+</mo><mn>1</mn></mrow></msub><mo stretchy="false">)</mo></mrow></mrow><mo maxsize="1.600em" minsize="1.600em">)</mo></mrow></mrow><mo maxsize="1.600em" minsize="1.600em" stretchy="true">‖</mo></mrow><mn>2</mn><mn>2</mn></msubsup><mo>]</mo></mrow></mrow><mo lspace="0em" rspace="0em">​</mo><mi>ρ</mi><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>𝐱</mi><mo stretchy="false">)</mo></mrow></mrow></mrow></mrow><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">\displaystyle\mathbb{E}\left[\Big\|P^{\perp}_{\bm{\theta}(\tilde{\bm{\xi}})}\overline{\sum}_{t\in\mathcal{T}}\Big(K_{\lambda}\big(\mathbf{s}(\bm{\xi}_{t}),\mathbf{s}(\tilde{\bm{\xi}})\big)\,;\,\mathbf{f}(\bm{\xi}_{t+1})\Big)\Big\|^{2}_{2}\right]=\sum_{\mathbf{x}\in\mathcal{D}}\mathbb{E}\left[\Big\|P^{\perp}_{\bm{\theta}(\mathbf{x})}\overline{\sum}_{t\in\mathcal{T}}\Big(K_{\lambda}\big(\mathbf{s}(\bm{\xi}_{t}),\mathbf{s}(\mathbf{x})\big)\,;\,\mathbf{f}(\bm{\xi}_{t+1})\Big)\Big\|^{2}_{2}\right]\rho(\mathbf{x}).</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td>
<td rowspan="1" class="ltx_eqn_cell ltx_eqn_eqno ltx_align_middle ltx_align_right"><span class="ltx_tag ltx_tag_equation ltx_align_right">(106)</span></td></tr></tbody>
</table>
<p id="A6.SS3.p1.8" class="ltx_p"><span id="A6.SS3.p1.8.1" class="ltx_text">To simplify notation we introduce</span></p>
<table id="A6.Ex398" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="A6.Ex398.m1" class="ltx_Math" alttext="U_{t}(\mathbf{x})\coloneq K_{\lambda}(\mathbf{s}(\bm{\xi}_{t}),\mathbf{s}(\mathbf{x}))." display="block" intent=":literal"><semantics><mrow><mrow><mrow><msub><mi>U</mi><mi>t</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>𝐱</mi><mo stretchy="false">)</mo></mrow></mrow><mo>≔</mo><mrow><msub><mi>K</mi><mi>λ</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mrow><mi>𝐬</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><msub><mi>𝝃</mi><mi>t</mi></msub><mo stretchy="false">)</mo></mrow></mrow><mo>,</mo><mrow><mi>𝐬</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>𝐱</mi><mo stretchy="false">)</mo></mrow></mrow><mo stretchy="false">)</mo></mrow></mrow></mrow><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">U_{t}(\mathbf{x})\coloneq K_{\lambda}(\mathbf{s}(\bm{\xi}_{t}),\mathbf{s}(\mathbf{x})).</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="A6.SS3.p1.9" class="ltx_p"><span id="A6.SS3.p1.9.1" class="ltx_text">For any <math id="A6.SS3.p1.m26" class="ltx_Math" alttext="\mathbf{x}\in\mathcal{D}" display="inline" intent=":literal"><semantics><mrow><mi>𝐱</mi><mo>∈</mo><mi class="ltx_font_mathcaligraphic">𝒟</mi></mrow><annotation encoding="application/x-tex">\mathbf{x}\in\mathcal{D}</annotation></semantics></math>, it now holds</span></p>
<table id="A6.EGx169" class="ltx_equationgroup ltx_eqn_align ltx_eqn_table">

<tbody id="A6.Ex399"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_eqn_cell"></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A6.Ex399.m1" class="ltx_Math" alttext="\displaystyle\mathbb{E}\left[\Big\|P^{\perp}_{\bm{\theta}(\mathbf{x})}\overline{\sum}_{t\in\mathcal{T}}\Big(U_{t}(\mathbf{x})\,;\,\mathbf{f}(\bm{\xi}_{t+1})\Big)\Big\|^{2}_{2}\right]" display="inline" intent=":literal"><semantics><mrow><mi>𝔼</mi><mo>⁡</mo><mrow><mo>[</mo><msubsup><mrow><mo maxsize="1.600em" minsize="1.600em" stretchy="true">‖</mo><mrow><msubsup><mi>P</mi><mrow><mi>𝜽</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>𝐱</mi><mo stretchy="false">)</mo></mrow></mrow><mo>⟂</mo></msubsup><mo lspace="0.167em" rspace="0em">​</mo><msub><mover accent="true"><mstyle displaystyle="true"><mo movablelimits="false">∑</mo></mstyle><mo stretchy="true">¯</mo></mover><mrow><mi>t</mi><mo>∈</mo><mi class="ltx_font_mathcaligraphic">𝒯</mi></mrow></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo maxsize="1.600em" minsize="1.600em">(</mo><mrow><msub><mi>U</mi><mi>t</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>𝐱</mi><mo rspace="0.170em" stretchy="false">)</mo></mrow></mrow><mo>,</mo><mrow><mi>𝐟</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><msub><mi>𝝃</mi><mrow><mi>t</mi><mo>+</mo><mn>1</mn></mrow></msub><mo stretchy="false">)</mo></mrow></mrow><mo maxsize="1.600em" minsize="1.600em">)</mo></mrow></mrow><mo maxsize="1.600em" minsize="1.600em" stretchy="true">‖</mo></mrow><mn>2</mn><mn>2</mn></msubsup><mo>]</mo></mrow></mrow><annotation encoding="application/x-tex">\displaystyle\mathbb{E}\left[\Big\|P^{\perp}_{\bm{\theta}(\mathbf{x})}\overline{\sum}_{t\in\mathcal{T}}\Big(U_{t}(\mathbf{x})\,;\,\mathbf{f}(\bm{\xi}_{t+1})\Big)\Big\|^{2}_{2}\right]</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
<tbody id="A6.Ex400"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_eqn_cell"></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A6.Ex400.m1" class="ltx_Math" alttext="\displaystyle\leq\mathbb{E}\left[\bigg\|P^{\perp}_{\bm{\theta}(\mathbf{x})}\frac{\sum_{t\in\mathcal{T}}U_{t}(\mathbf{x})\mathbf{f}(\bm{\xi}_{t+1})}{\sum_{t\in\mathcal{T}}U_{t}(\mathbf{x})}\bigg\|^{2}_{2}\mathbb{I}\Big(\sum_{t\in\mathcal{T}}U_{t}(\mathbf{x})\geq\frac{|\mathcal{T}|}{2}\mathbb{E}\big[U_{0}(\mathbf{x})\big]\Big)\right]+\|\mathbf{f}\|_{\infty}^{2}\mathbb{P}\Big(\sum_{t\in\mathcal{T}}U_{t}(\mathbf{x})&lt;\frac{|\mathcal{T}|}{2}\mathbb{E}\big[U_{0}(\mathbf{x})\big]\Big)" display="inline" intent=":literal"><semantics><mrow><mphantom></mphantom><mo>≤</mo><mrow><mrow><mi>𝔼</mi><mo>⁡</mo><mrow><mo>[</mo><mrow><msubsup><mrow><mo maxsize="2.100em" minsize="2.100em" stretchy="true">‖</mo><mrow><msubsup><mi>P</mi><mrow><mi>𝜽</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>𝐱</mi><mo stretchy="false">)</mo></mrow></mrow><mo>⟂</mo></msubsup><mo lspace="0em" rspace="0em">​</mo><mstyle displaystyle="true"><mfrac><mrow><msub><mo>∑</mo><mrow><mi>t</mi><mo>∈</mo><mi class="ltx_font_mathcaligraphic">𝒯</mi></mrow></msub><mrow><msub><mi>U</mi><mi>t</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>𝐱</mi><mo stretchy="false">)</mo></mrow><mo lspace="0em" rspace="0em">​</mo><mi>𝐟</mi><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mi>𝝃</mi><mrow><mi>t</mi><mo>+</mo><mn>1</mn></mrow></msub><mo stretchy="false">)</mo></mrow></mrow></mrow><mrow><msub><mo>∑</mo><mrow><mi>t</mi><mo>∈</mo><mi class="ltx_font_mathcaligraphic">𝒯</mi></mrow></msub><mrow><msub><mi>U</mi><mi>t</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>𝐱</mi><mo stretchy="false">)</mo></mrow></mrow></mrow></mfrac></mstyle></mrow><mo maxsize="2.100em" minsize="2.100em" stretchy="true">‖</mo></mrow><mn>2</mn><mn>2</mn></msubsup><mo lspace="0em" rspace="0em">​</mo><mi>𝕀</mi><mo lspace="0em" rspace="0em">​</mo><mrow><mo maxsize="1.600em" minsize="1.600em">(</mo><mrow><mrow><mstyle displaystyle="true"><munder><mo movablelimits="false">∑</mo><mrow><mi>t</mi><mo>∈</mo><mi class="ltx_font_mathcaligraphic">𝒯</mi></mrow></munder></mstyle><mrow><msub><mi>U</mi><mi>t</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>𝐱</mi><mo stretchy="false">)</mo></mrow></mrow></mrow><mo>≥</mo><mrow><mstyle displaystyle="true"><mfrac><mrow><mo stretchy="false">|</mo><mi class="ltx_font_mathcaligraphic">𝒯</mi><mo stretchy="false">|</mo></mrow><mn>2</mn></mfrac></mstyle><mo lspace="0em" rspace="0em">​</mo><mi>𝔼</mi><mo lspace="0em" rspace="0em">​</mo><mrow><mo maxsize="1.200em" minsize="1.200em">[</mo><mrow><msub><mi>U</mi><mn>0</mn></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>𝐱</mi><mo stretchy="false">)</mo></mrow></mrow><mo maxsize="1.200em" minsize="1.200em">]</mo></mrow></mrow></mrow><mo maxsize="1.600em" minsize="1.600em">)</mo></mrow></mrow><mo>]</mo></mrow></mrow><mo>+</mo><mrow><msubsup><mrow><mo stretchy="false">‖</mo><mi>𝐟</mi><mo stretchy="false">‖</mo></mrow><mi mathvariant="normal">∞</mi><mn>2</mn></msubsup><mo lspace="0em" rspace="0em">​</mo><mi>ℙ</mi><mo lspace="0em" rspace="0em">​</mo><mrow><mo maxsize="1.600em" minsize="1.600em">(</mo><mrow><mrow><mstyle displaystyle="true"><munder><mo movablelimits="false">∑</mo><mrow><mi>t</mi><mo>∈</mo><mi class="ltx_font_mathcaligraphic">𝒯</mi></mrow></munder></mstyle><mrow><msub><mi>U</mi><mi>t</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>𝐱</mi><mo stretchy="false">)</mo></mrow></mrow></mrow><mo>&lt;</mo><mrow><mstyle displaystyle="true"><mfrac><mrow><mo stretchy="false">|</mo><mi class="ltx_font_mathcaligraphic">𝒯</mi><mo stretchy="false">|</mo></mrow><mn>2</mn></mfrac></mstyle><mo lspace="0em" rspace="0em">​</mo><mi>𝔼</mi><mo lspace="0em" rspace="0em">​</mo><mrow><mo maxsize="1.200em" minsize="1.200em">[</mo><mrow><msub><mi>U</mi><mn>0</mn></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>𝐱</mi><mo stretchy="false">)</mo></mrow></mrow><mo maxsize="1.200em" minsize="1.200em">]</mo></mrow></mrow></mrow><mo maxsize="1.600em" minsize="1.600em">)</mo></mrow></mrow></mrow></mrow><annotation encoding="application/x-tex">\displaystyle\leq\mathbb{E}\left[\bigg\|P^{\perp}_{\bm{\theta}(\mathbf{x})}\frac{\sum_{t\in\mathcal{T}}U_{t}(\mathbf{x})\mathbf{f}(\bm{\xi}_{t+1})}{\sum_{t\in\mathcal{T}}U_{t}(\mathbf{x})}\bigg\|^{2}_{2}\mathbb{I}\Big(\sum_{t\in\mathcal{T}}U_{t}(\mathbf{x})\geq\frac{|\mathcal{T}|}{2}\mathbb{E}\big[U_{0}(\mathbf{x})\big]\Big)\right]+\|\mathbf{f}\|_{\infty}^{2}\mathbb{P}\Big(\sum_{t\in\mathcal{T}}U_{t}(\mathbf{x})&lt;\frac{|\mathcal{T}|}{2}\mathbb{E}\big[U_{0}(\mathbf{x})\big]\Big)</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
<tbody id="A6.E107"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_eqn_cell"></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A6.E107.m1" class="ltx_Math" alttext="\displaystyle\leq\frac{4}{|\mathcal{T}|^{2}\mathbb{E}\big[U_{0}(\mathbf{x})\big]^{2}}\mathbb{E}\left[\Big\|P^{\perp}_{\bm{\theta}(\mathbf{x})}\sum_{t\in\mathcal{T}}U_{t}(\mathbf{x})\mathbf{f}(\bm{\xi}_{t+1})\Big\|^{2}_{2}\right]+\|\mathbf{f}\|_{\infty}^{2}\mathbb{P}\Big(\Big|\sum_{t\in\mathcal{T}}\big(U_{t}(\mathbf{x})-\mathbb{E}\big[U_{0}(\mathbf{x})\big]\big)\Big|&gt;\frac{|\mathcal{T}|}{2}\mathbb{E}\big[U_{0}(\mathbf{x})\big]\Big)." display="inline" intent=":literal"><semantics><mrow><mrow><mphantom></mphantom><mo>≤</mo><mrow><mrow><mstyle displaystyle="true"><mfrac><mn>4</mn><mrow><msup><mrow><mo stretchy="false">|</mo><mi class="ltx_font_mathcaligraphic">𝒯</mi><mo stretchy="false">|</mo></mrow><mn>2</mn></msup><mo lspace="0em" rspace="0em">​</mo><mi>𝔼</mi><mo lspace="0em" rspace="0em">​</mo><msup><mrow><mo maxsize="1.200em" minsize="1.200em">[</mo><mrow><msub><mi>U</mi><mn>0</mn></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>𝐱</mi><mo stretchy="false">)</mo></mrow></mrow><mo maxsize="1.200em" minsize="1.200em">]</mo></mrow><mn>2</mn></msup></mrow></mfrac></mstyle><mo lspace="0em" rspace="0em">​</mo><mi>𝔼</mi><mo lspace="0em" rspace="0em">​</mo><mrow><mo>[</mo><msubsup><mrow><mo maxsize="1.600em" minsize="1.600em" stretchy="true">‖</mo><mrow><msubsup><mi>P</mi><mrow><mi>𝜽</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>𝐱</mi><mo stretchy="false">)</mo></mrow></mrow><mo>⟂</mo></msubsup><mo lspace="0em" rspace="0em">​</mo><mrow><mstyle displaystyle="true"><munder><mo movablelimits="false">∑</mo><mrow><mi>t</mi><mo>∈</mo><mi class="ltx_font_mathcaligraphic">𝒯</mi></mrow></munder></mstyle><mrow><msub><mi>U</mi><mi>t</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>𝐱</mi><mo stretchy="false">)</mo></mrow><mo lspace="0em" rspace="0em">​</mo><mi>𝐟</mi><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mi>𝝃</mi><mrow><mi>t</mi><mo>+</mo><mn>1</mn></mrow></msub><mo stretchy="false">)</mo></mrow></mrow></mrow></mrow><mo maxsize="1.600em" minsize="1.600em" stretchy="true">‖</mo></mrow><mn>2</mn><mn>2</mn></msubsup><mo>]</mo></mrow></mrow><mo>+</mo><mrow><msubsup><mrow><mo stretchy="false">‖</mo><mi>𝐟</mi><mo stretchy="false">‖</mo></mrow><mi mathvariant="normal">∞</mi><mn>2</mn></msubsup><mo lspace="0em" rspace="0em">​</mo><mi>ℙ</mi><mo lspace="0em" rspace="0em">​</mo><mrow><mo maxsize="1.600em" minsize="1.600em">(</mo><mrow><mrow><mo maxsize="1.600em" minsize="1.600em" stretchy="true">|</mo><mrow><mstyle displaystyle="true"><munder><mo movablelimits="false">∑</mo><mrow><mi>t</mi><mo>∈</mo><mi class="ltx_font_mathcaligraphic">𝒯</mi></mrow></munder></mstyle><mrow><mo maxsize="1.200em" minsize="1.200em">(</mo><mrow><mrow><msub><mi>U</mi><mi>t</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>𝐱</mi><mo stretchy="false">)</mo></mrow></mrow><mo>−</mo><mrow><mi>𝔼</mi><mo>⁡</mo><mrow><mo maxsize="1.200em" minsize="1.200em">[</mo><mrow><msub><mi>U</mi><mn>0</mn></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>𝐱</mi><mo stretchy="false">)</mo></mrow></mrow><mo maxsize="1.200em" minsize="1.200em">]</mo></mrow></mrow></mrow><mo maxsize="1.200em" minsize="1.200em">)</mo></mrow></mrow><mo maxsize="1.600em" minsize="1.600em" stretchy="true">|</mo></mrow><mo>&gt;</mo><mrow><mstyle displaystyle="true"><mfrac><mrow><mo stretchy="false">|</mo><mi class="ltx_font_mathcaligraphic">𝒯</mi><mo stretchy="false">|</mo></mrow><mn>2</mn></mfrac></mstyle><mo lspace="0em" rspace="0em">​</mo><mi>𝔼</mi><mo lspace="0em" rspace="0em">​</mo><mrow><mo maxsize="1.200em" minsize="1.200em">[</mo><mrow><msub><mi>U</mi><mn>0</mn></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>𝐱</mi><mo stretchy="false">)</mo></mrow></mrow><mo maxsize="1.200em" minsize="1.200em">]</mo></mrow></mrow></mrow><mo maxsize="1.600em" minsize="1.600em">)</mo></mrow></mrow></mrow></mrow><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">\displaystyle\leq\frac{4}{|\mathcal{T}|^{2}\mathbb{E}\big[U_{0}(\mathbf{x})\big]^{2}}\mathbb{E}\left[\Big\|P^{\perp}_{\bm{\theta}(\mathbf{x})}\sum_{t\in\mathcal{T}}U_{t}(\mathbf{x})\mathbf{f}(\bm{\xi}_{t+1})\Big\|^{2}_{2}\right]+\|\mathbf{f}\|_{\infty}^{2}\mathbb{P}\Big(\Big|\sum_{t\in\mathcal{T}}\big(U_{t}(\mathbf{x})-\mathbb{E}\big[U_{0}(\mathbf{x})\big]\big)\Big|&gt;\frac{|\mathcal{T}|}{2}\mathbb{E}\big[U_{0}(\mathbf{x})\big]\Big).</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td>
<td rowspan="1" class="ltx_eqn_cell ltx_eqn_eqno ltx_align_middle ltx_align_right"><span class="ltx_tag ltx_tag_equation ltx_align_right">(107)</span></td></tr></tbody>
</table>
<p id="A6.SS3.p1.10" class="ltx_p"><span id="A6.SS3.p1.10.1" class="ltx_text">We bound the probability using Markov’s inequality together with Theorem 3.2 in <cite class="ltx_cite ltx_citemacro_cite">[<a href="#bib.bib13" title="" class="ltx_ref">58</a>]</cite>. This result provides a similar variance bound for stationary Markov chains as for sums of independent random variables. For a random variable <math id="A6.SS3.p1.m27" class="ltx_Math" alttext="U" display="inline" intent=":literal"><semantics><mi>U</mi><annotation encoding="application/x-tex">U</annotation></semantics></math> with <math id="A6.SS3.p1.m28" class="ltx_Math" alttext="|U|\leq 1" display="inline" intent=":literal"><semantics><mrow><mrow><mo stretchy="false">|</mo><mi>U</mi><mo stretchy="false">|</mo></mrow><mo>≤</mo><mn>1</mn></mrow><annotation encoding="application/x-tex">|U|\leq 1</annotation></semantics></math> a.s., one has <math id="A6.SS3.p1.m29" class="ltx_Math" alttext="{\mathbb{V}\text{ar}}(U)=\mathbb{E}[U^{2}]-\mathbb{E}^{2}[U]\leq\mathbb{E}[U^{2}]\leq\mathbb{E}[U]." display="inline" intent=":literal"><semantics><mrow><mrow><mrow><mi>𝕍</mi><mo lspace="0em" rspace="0em">​</mo><mtext>ar</mtext><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>U</mi><mo stretchy="false">)</mo></mrow></mrow><mo>=</mo><mrow><mrow><mi>𝔼</mi><mo>⁡</mo><mrow><mo stretchy="false">[</mo><msup><mi>U</mi><mn>2</mn></msup><mo stretchy="false">]</mo></mrow></mrow><mo>−</mo><mrow><msup><mi>𝔼</mi><mn>2</mn></msup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">[</mo><mi>U</mi><mo stretchy="false">]</mo></mrow></mrow></mrow><mo>≤</mo><mrow><mi>𝔼</mi><mo>⁡</mo><mrow><mo stretchy="false">[</mo><msup><mi>U</mi><mn>2</mn></msup><mo stretchy="false">]</mo></mrow></mrow><mo>≤</mo><mrow><mi>𝔼</mi><mo>⁡</mo><mrow><mo stretchy="false">[</mo><mi>U</mi><mo stretchy="false">]</mo></mrow></mrow></mrow><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">{\mathbb{V}\text{ar}}(U)=\mathbb{E}[U^{2}]-\mathbb{E}^{2}[U]\leq\mathbb{E}[U^{2}]\leq\mathbb{E}[U].</annotation></semantics></math> Using that <math id="A6.SS3.p1.m30" class="ltx_Math" alttext="\|K_{\lambda}\|_{\infty}" display="inline" intent=":literal"><semantics><msub><mrow><mo stretchy="false">‖</mo><msub><mi>K</mi><mi>λ</mi></msub><mo stretchy="false">‖</mo></mrow><mi mathvariant="normal">∞</mi></msub><annotation encoding="application/x-tex">\|K_{\lambda}\|_{\infty}</annotation></semantics></math> maps to <math id="A6.SS3.p1.m31" class="ltx_Math" alttext="[0,1]" display="inline" intent=":literal"><semantics><mrow><mo stretchy="false">[</mo><mn>0</mn><mo>,</mo><mn>1</mn><mo stretchy="false">]</mo></mrow><annotation encoding="application/x-tex">[0,1]</annotation></semantics></math> and applying the previous inequality to <math id="A6.SS3.p1.m32" class="ltx_Math" alttext="U_{0}(\mathbf{x})=K_{\lambda}\big(\mathbf{s}(\bm{\xi}_{0}),\mathbf{s}(\mathbf{x})\big)," display="inline" intent=":literal"><semantics><mrow><mrow><mrow><msub><mi>U</mi><mn>0</mn></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>𝐱</mi><mo stretchy="false">)</mo></mrow></mrow><mo>=</mo><mrow><msub><mi>K</mi><mi>λ</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo maxsize="1.200em" minsize="1.200em">(</mo><mrow><mi>𝐬</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><msub><mi>𝝃</mi><mn>0</mn></msub><mo stretchy="false">)</mo></mrow></mrow><mo>,</mo><mrow><mi>𝐬</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>𝐱</mi><mo stretchy="false">)</mo></mrow></mrow><mo maxsize="1.200em" minsize="1.200em">)</mo></mrow></mrow></mrow><mo>,</mo></mrow><annotation encoding="application/x-tex">U_{0}(\mathbf{x})=K_{\lambda}\big(\mathbf{s}(\bm{\xi}_{0}),\mathbf{s}(\mathbf{x})\big),</annotation></semantics></math> then gives</span></p>
<table id="A6.EGx170" class="ltx_equationgroup ltx_eqn_align ltx_eqn_table">

<tbody id="A6.Ex401"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_align_right ltx_eqn_cell"><math id="A6.Ex401.m1" class="ltx_Math" alttext="\displaystyle\mathbb{P}\Big(\Big|\sum_{t\in\mathcal{T}}U_{t}(\mathbf{x})-\mathbb{E}\big[U_{0}(\mathbf{x})\big]\Big|&gt;\frac{|\mathcal{T}|}{2}\mathbb{E}\big[U_{0}(\mathbf{x})\big]\Big)" display="inline" intent=":literal"><semantics><mrow><mi>ℙ</mi><mo>⁡</mo><mrow><mo maxsize="1.600em" minsize="1.600em">(</mo><mrow><mrow><mo maxsize="1.600em" minsize="1.600em" stretchy="true">|</mo><mrow><mrow><mstyle displaystyle="true"><munder><mo movablelimits="false">∑</mo><mrow><mi>t</mi><mo>∈</mo><mi class="ltx_font_mathcaligraphic">𝒯</mi></mrow></munder></mstyle><mrow><msub><mi>U</mi><mi>t</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>𝐱</mi><mo stretchy="false">)</mo></mrow></mrow></mrow><mo>−</mo><mrow><mi>𝔼</mi><mo>⁡</mo><mrow><mo maxsize="1.200em" minsize="1.200em">[</mo><mrow><msub><mi>U</mi><mn>0</mn></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>𝐱</mi><mo stretchy="false">)</mo></mrow></mrow><mo maxsize="1.200em" minsize="1.200em">]</mo></mrow></mrow></mrow><mo maxsize="1.600em" minsize="1.600em" stretchy="true">|</mo></mrow><mo>&gt;</mo><mrow><mstyle displaystyle="true"><mfrac><mrow><mo stretchy="false">|</mo><mi class="ltx_font_mathcaligraphic">𝒯</mi><mo stretchy="false">|</mo></mrow><mn>2</mn></mfrac></mstyle><mo lspace="0em" rspace="0em">​</mo><mi>𝔼</mi><mo lspace="0em" rspace="0em">​</mo><mrow><mo maxsize="1.200em" minsize="1.200em">[</mo><mrow><msub><mi>U</mi><mn>0</mn></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>𝐱</mi><mo stretchy="false">)</mo></mrow></mrow><mo maxsize="1.200em" minsize="1.200em">]</mo></mrow></mrow></mrow><mo maxsize="1.600em" minsize="1.600em">)</mo></mrow></mrow><annotation encoding="application/x-tex">\displaystyle\mathbb{P}\Big(\Big|\sum_{t\in\mathcal{T}}U_{t}(\mathbf{x})-\mathbb{E}\big[U_{0}(\mathbf{x})\big]\Big|&gt;\frac{|\mathcal{T}|}{2}\mathbb{E}\big[U_{0}(\mathbf{x})\big]\Big)</annotation></semantics></math></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A6.Ex401.m2" class="ltx_Math" alttext="\displaystyle\leq\frac{16}{\gamma_{\mathrm{ps}}(\mathbf{M})|\mathcal{T}|\mathbb{E}\big[U_{0}(\mathbf{x})\big]^{2}}\mathbb{E}\Big[\big|U_{0}(\mathbf{x})-\mathbb{E}\big[U_{0}(\mathbf{x})\big]\big|^{2}\Big]" display="inline" intent=":literal"><semantics><mrow><mphantom></mphantom><mo>≤</mo><mrow><mstyle displaystyle="true"><mfrac><mn>16</mn><mrow><msub><mi>γ</mi><mi>ps</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>𝐌</mi><mo stretchy="false">)</mo></mrow><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">|</mo><mi class="ltx_font_mathcaligraphic">𝒯</mi><mo stretchy="false">|</mo></mrow><mo lspace="0em" rspace="0em">​</mo><mi>𝔼</mi><mo lspace="0em" rspace="0em">​</mo><msup><mrow><mo maxsize="1.200em" minsize="1.200em">[</mo><mrow><msub><mi>U</mi><mn>0</mn></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>𝐱</mi><mo stretchy="false">)</mo></mrow></mrow><mo maxsize="1.200em" minsize="1.200em">]</mo></mrow><mn>2</mn></msup></mrow></mfrac></mstyle><mo lspace="0em" rspace="0em">​</mo><mi>𝔼</mi><mo lspace="0em" rspace="0em">​</mo><mrow><mo maxsize="1.600em" minsize="1.600em">[</mo><msup><mrow><mo maxsize="1.200em" minsize="1.200em" stretchy="true">|</mo><mrow><mrow><msub><mi>U</mi><mn>0</mn></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>𝐱</mi><mo stretchy="false">)</mo></mrow></mrow><mo>−</mo><mrow><mi>𝔼</mi><mo>⁡</mo><mrow><mo maxsize="1.200em" minsize="1.200em">[</mo><mrow><msub><mi>U</mi><mn>0</mn></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>𝐱</mi><mo stretchy="false">)</mo></mrow></mrow><mo maxsize="1.200em" minsize="1.200em">]</mo></mrow></mrow></mrow><mo maxsize="1.200em" minsize="1.200em" stretchy="true">|</mo></mrow><mn>2</mn></msup><mo maxsize="1.600em" minsize="1.600em">]</mo></mrow></mrow></mrow><annotation encoding="application/x-tex">\displaystyle\leq\frac{16}{\gamma_{\mathrm{ps}}(\mathbf{M})|\mathcal{T}|\mathbb{E}\big[U_{0}(\mathbf{x})\big]^{2}}\mathbb{E}\Big[\big|U_{0}(\mathbf{x})-\mathbb{E}\big[U_{0}(\mathbf{x})\big]\big|^{2}\Big]</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
<tbody id="A6.E108"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_eqn_cell"></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A6.E108.m1" class="ltx_Math" alttext="\displaystyle\leq\frac{16}{\gamma_{\mathrm{ps}}(\mathbf{M})|\mathcal{T}|\mathbb{E}\big[U_{0}(\mathbf{x})\big]}," display="inline" intent=":literal"><semantics><mrow><mrow><mphantom></mphantom><mo>≤</mo><mstyle displaystyle="true"><mfrac><mn>16</mn><mrow><msub><mi>γ</mi><mi>ps</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>𝐌</mi><mo stretchy="false">)</mo></mrow><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">|</mo><mi class="ltx_font_mathcaligraphic">𝒯</mi><mo stretchy="false">|</mo></mrow><mo lspace="0em" rspace="0em">​</mo><mi>𝔼</mi><mo lspace="0em" rspace="0em">​</mo><mrow><mo maxsize="1.200em" minsize="1.200em">[</mo><mrow><msub><mi>U</mi><mn>0</mn></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>𝐱</mi><mo stretchy="false">)</mo></mrow></mrow><mo maxsize="1.200em" minsize="1.200em">]</mo></mrow></mrow></mfrac></mstyle></mrow><mo>,</mo></mrow><annotation encoding="application/x-tex">\displaystyle\leq\frac{16}{\gamma_{\mathrm{ps}}(\mathbf{M})|\mathcal{T}|\mathbb{E}\big[U_{0}(\mathbf{x})\big]},</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td>
<td rowspan="1" class="ltx_eqn_cell ltx_eqn_eqno ltx_align_middle ltx_align_right"><span class="ltx_tag ltx_tag_equation ltx_align_right">(108)</span></td></tr></tbody>
</table>
<p id="A6.SS3.p1.11" class="ltx_p"><span id="A6.SS3.p1.11.1" class="ltx_text">where <math id="A6.SS3.p1.m33" class="ltx_Math" alttext="\gamma_{\mathrm{ps}}(\mathbf{M})" display="inline" intent=":literal"><semantics><mrow><msub><mi>γ</mi><mi>ps</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>𝐌</mi><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">\gamma_{\mathrm{ps}}(\mathbf{M})</annotation></semantics></math> denotes the pseudo spectral gap of <math id="A6.SS3.p1.m34" class="ltx_Math" alttext="\mathbf{M}," display="inline" intent=":literal"><semantics><mrow><mi>𝐌</mi><mo>,</mo></mrow><annotation encoding="application/x-tex">\mathbf{M},</annotation></semantics></math> which depends only on <math id="A6.SS3.p1.m35" class="ltx_Math" alttext="c_{\mathbf{M}}" display="inline" intent=":literal"><semantics><msub><mi>c</mi><mi>𝐌</mi></msub><annotation encoding="application/x-tex">c_{\mathbf{M}}</annotation></semantics></math> (see Definition 1.3 and Proposition 3.4 in <cite class="ltx_cite ltx_citemacro_cite">[<a href="#bib.bib13" title="" class="ltx_ref">58</a>]</cite>). Now, applying the bias-variance decomposition yields</span></p>
<table id="A6.EGx171" class="ltx_equationgroup ltx_eqn_align ltx_eqn_table">

<tbody id="A6.Ex402"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_align_right ltx_eqn_cell"><math id="A6.Ex402.m1" class="ltx_Math" alttext="\displaystyle\mathbb{E}\left[\Big\|P^{\perp}_{\bm{\theta}(\mathbf{x})}\sum_{t\in\mathcal{T}}U_{t}(\mathbf{x})\mathbf{f}(\bm{\xi}_{t+1})\Big\|^{2}_{2}\right]" display="inline" intent=":literal"><semantics><mrow><mi>𝔼</mi><mo>⁡</mo><mrow><mo>[</mo><msubsup><mrow><mo maxsize="1.600em" minsize="1.600em" stretchy="true">‖</mo><mrow><msubsup><mi>P</mi><mrow><mi>𝜽</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>𝐱</mi><mo stretchy="false">)</mo></mrow></mrow><mo>⟂</mo></msubsup><mo lspace="0em" rspace="0em">​</mo><mrow><mstyle displaystyle="true"><munder><mo movablelimits="false">∑</mo><mrow><mi>t</mi><mo>∈</mo><mi class="ltx_font_mathcaligraphic">𝒯</mi></mrow></munder></mstyle><mrow><msub><mi>U</mi><mi>t</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>𝐱</mi><mo stretchy="false">)</mo></mrow><mo lspace="0em" rspace="0em">​</mo><mi>𝐟</mi><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mi>𝝃</mi><mrow><mi>t</mi><mo>+</mo><mn>1</mn></mrow></msub><mo stretchy="false">)</mo></mrow></mrow></mrow></mrow><mo maxsize="1.600em" minsize="1.600em" stretchy="true">‖</mo></mrow><mn>2</mn><mn>2</mn></msubsup><mo>]</mo></mrow></mrow><annotation encoding="application/x-tex">\displaystyle\mathbb{E}\left[\Big\|P^{\perp}_{\bm{\theta}(\mathbf{x})}\sum_{t\in\mathcal{T}}U_{t}(\mathbf{x})\mathbf{f}(\bm{\xi}_{t+1})\Big\|^{2}_{2}\right]</annotation></semantics></math></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A6.Ex402.m2" class="ltx_Math" alttext="\displaystyle=\underbrace{\mathbb{E}\left[\Big\|P^{\perp}_{\bm{\theta}(\mathbf{x})}\sum_{t\in\mathcal{T}}U_{t}(\mathbf{x})\mathbf{f}(\bm{\xi}_{t+1})-|\mathcal{T}|\mathbb{E}\Big[P^{\perp}_{\bm{\theta}(\mathbf{x})}U_{0}(\mathbf{x})\mathbf{f}(\bm{\xi}_{1})\Big]\Big\|^{2}_{2}\right]}_{\text{variance}}" display="inline" intent=":literal"><semantics><mrow><mphantom></mphantom><mo>=</mo><munder><munder accentunder="true"><mrow><mi>𝔼</mi><mo>⁡</mo><mrow><mo>[</mo><msubsup><mrow><mo maxsize="1.600em" minsize="1.600em" stretchy="true">‖</mo><mrow><mrow><msubsup><mi>P</mi><mrow><mi>𝜽</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>𝐱</mi><mo stretchy="false">)</mo></mrow></mrow><mo>⟂</mo></msubsup><mo lspace="0em" rspace="0em">​</mo><mrow><mstyle displaystyle="true"><munder><mo movablelimits="false">∑</mo><mrow><mi>t</mi><mo>∈</mo><mi class="ltx_font_mathcaligraphic">𝒯</mi></mrow></munder></mstyle><mrow><msub><mi>U</mi><mi>t</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>𝐱</mi><mo stretchy="false">)</mo></mrow><mo lspace="0em" rspace="0em">​</mo><mi>𝐟</mi><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mi>𝝃</mi><mrow><mi>t</mi><mo>+</mo><mn>1</mn></mrow></msub><mo stretchy="false">)</mo></mrow></mrow></mrow></mrow><mo>−</mo><mrow><mrow><mo stretchy="false">|</mo><mi class="ltx_font_mathcaligraphic">𝒯</mi><mo stretchy="false">|</mo></mrow><mo lspace="0em" rspace="0em">​</mo><mi>𝔼</mi><mo lspace="0em" rspace="0em">​</mo><mrow><mo maxsize="1.600em" minsize="1.600em">[</mo><mrow><msubsup><mi>P</mi><mrow><mi>𝜽</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>𝐱</mi><mo stretchy="false">)</mo></mrow></mrow><mo>⟂</mo></msubsup><mo lspace="0em" rspace="0em">​</mo><msub><mi>U</mi><mn>0</mn></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>𝐱</mi><mo stretchy="false">)</mo></mrow><mo lspace="0em" rspace="0em">​</mo><mi>𝐟</mi><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mi>𝝃</mi><mn>1</mn></msub><mo stretchy="false">)</mo></mrow></mrow><mo maxsize="1.600em" minsize="1.600em">]</mo></mrow></mrow></mrow><mo maxsize="1.600em" minsize="1.600em" stretchy="true">‖</mo></mrow><mn>2</mn><mn>2</mn></msubsup><mo>]</mo></mrow></mrow><mo stretchy="true">⏟</mo></munder><mtext>variance</mtext></munder></mrow><annotation encoding="application/x-tex">\displaystyle=\underbrace{\mathbb{E}\left[\Big\|P^{\perp}_{\bm{\theta}(\mathbf{x})}\sum_{t\in\mathcal{T}}U_{t}(\mathbf{x})\mathbf{f}(\bm{\xi}_{t+1})-|\mathcal{T}|\mathbb{E}\Big[P^{\perp}_{\bm{\theta}(\mathbf{x})}U_{0}(\mathbf{x})\mathbf{f}(\bm{\xi}_{1})\Big]\Big\|^{2}_{2}\right]}_{\text{variance}}</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
<tbody id="A6.Ex403"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_eqn_cell"></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A6.Ex403.m1" class="ltx_Math" alttext="\displaystyle\quad+\underbrace{|\mathcal{T}|^{2}\Big\|\mathbb{E}\Big[P^{\perp}_{\bm{\theta}(\mathbf{x})}U_{0}(\mathbf{x})\mathbf{f}(\bm{\xi}_{1})\Big]\Big\|^{2}_{2}}_{\text{squared bias}}," display="inline" intent=":literal"><semantics><mrow><mrow><mo>+</mo><munder><munder accentunder="true"><mrow><msup><mrow><mo stretchy="false">|</mo><mi class="ltx_font_mathcaligraphic">𝒯</mi><mo stretchy="false">|</mo></mrow><mn>2</mn></msup><mo lspace="0em" rspace="0em">​</mo><msubsup><mrow><mo maxsize="1.600em" minsize="1.600em" stretchy="true">‖</mo><mrow><mi>𝔼</mi><mo>⁡</mo><mrow><mo maxsize="1.600em" minsize="1.600em">[</mo><mrow><msubsup><mi>P</mi><mrow><mi>𝜽</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>𝐱</mi><mo stretchy="false">)</mo></mrow></mrow><mo>⟂</mo></msubsup><mo lspace="0em" rspace="0em">​</mo><msub><mi>U</mi><mn>0</mn></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>𝐱</mi><mo stretchy="false">)</mo></mrow><mo lspace="0em" rspace="0em">​</mo><mi>𝐟</mi><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mi>𝝃</mi><mn>1</mn></msub><mo stretchy="false">)</mo></mrow></mrow><mo maxsize="1.600em" minsize="1.600em">]</mo></mrow></mrow><mo maxsize="1.600em" minsize="1.600em" stretchy="true">‖</mo></mrow><mn>2</mn><mn>2</mn></msubsup></mrow><mo stretchy="true">⏟</mo></munder><mtext>squared bias</mtext></munder></mrow><mo>,</mo></mrow><annotation encoding="application/x-tex">\displaystyle\quad+\underbrace{|\mathcal{T}|^{2}\Big\|\mathbb{E}\Big[P^{\perp}_{\bm{\theta}(\mathbf{x})}U_{0}(\mathbf{x})\mathbf{f}(\bm{\xi}_{1})\Big]\Big\|^{2}_{2}}_{\text{squared bias}},</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="A6.SS3.p1.12" class="ltx_p"><span id="A6.SS3.p1.12.1" class="ltx_text">where we again used <math id="A6.SS3.p1.m36" class="ltx_Math" alttext="\|K_{\lambda}\|_{\infty}\leq 1" display="inline" intent=":literal"><semantics><mrow><msub><mrow><mo stretchy="false">‖</mo><msub><mi>K</mi><mi>λ</mi></msub><mo stretchy="false">‖</mo></mrow><mi mathvariant="normal">∞</mi></msub><mo>≤</mo><mn>1</mn></mrow><annotation encoding="application/x-tex">\|K_{\lambda}\|_{\infty}\leq 1</annotation></semantics></math> in the last step.
For the variance term we again apply the variance bound for Markov chains provided in Theorem 3.2 in <cite class="ltx_cite ltx_citemacro_cite">[<a href="#bib.bib13" title="" class="ltx_ref">58</a>]</cite> componentwise and obtain</span></p>
<table id="A6.EGx172" class="ltx_equationgroup ltx_eqn_align ltx_eqn_table">

<tbody id="A6.Ex404"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_align_right ltx_eqn_cell"><math id="A6.Ex404.m1" class="ltx_Math" alttext="\displaystyle\mathbb{E}\left[\Big\|P^{\perp}_{\bm{\theta}(\mathbf{x})}\sum_{t\in\mathcal{T}}U_{t}(\mathbf{x})\mathbf{f}(\bm{\xi}_{t+1})-|\mathcal{T}|\mathbb{E}\Big[P^{\perp}_{\bm{\theta}(\mathbf{x})}U_{0}(\mathbf{x})\mathbf{f}(\bm{\xi}_{1})\Big]\Big\|^{2}_{2}\right]" display="inline" intent=":literal"><semantics><mrow><mi>𝔼</mi><mo>⁡</mo><mrow><mo>[</mo><msubsup><mrow><mo maxsize="1.600em" minsize="1.600em" stretchy="true">‖</mo><mrow><mrow><msubsup><mi>P</mi><mrow><mi>𝜽</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>𝐱</mi><mo stretchy="false">)</mo></mrow></mrow><mo>⟂</mo></msubsup><mo lspace="0em" rspace="0em">​</mo><mrow><mstyle displaystyle="true"><munder><mo movablelimits="false">∑</mo><mrow><mi>t</mi><mo>∈</mo><mi class="ltx_font_mathcaligraphic">𝒯</mi></mrow></munder></mstyle><mrow><msub><mi>U</mi><mi>t</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>𝐱</mi><mo stretchy="false">)</mo></mrow><mo lspace="0em" rspace="0em">​</mo><mi>𝐟</mi><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mi>𝝃</mi><mrow><mi>t</mi><mo>+</mo><mn>1</mn></mrow></msub><mo stretchy="false">)</mo></mrow></mrow></mrow></mrow><mo>−</mo><mrow><mrow><mo stretchy="false">|</mo><mi class="ltx_font_mathcaligraphic">𝒯</mi><mo stretchy="false">|</mo></mrow><mo lspace="0em" rspace="0em">​</mo><mi>𝔼</mi><mo lspace="0em" rspace="0em">​</mo><mrow><mo maxsize="1.600em" minsize="1.600em">[</mo><mrow><msubsup><mi>P</mi><mrow><mi>𝜽</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>𝐱</mi><mo stretchy="false">)</mo></mrow></mrow><mo>⟂</mo></msubsup><mo lspace="0em" rspace="0em">​</mo><msub><mi>U</mi><mn>0</mn></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>𝐱</mi><mo stretchy="false">)</mo></mrow><mo lspace="0em" rspace="0em">​</mo><mi>𝐟</mi><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mi>𝝃</mi><mn>1</mn></msub><mo stretchy="false">)</mo></mrow></mrow><mo maxsize="1.600em" minsize="1.600em">]</mo></mrow></mrow></mrow><mo maxsize="1.600em" minsize="1.600em" stretchy="true">‖</mo></mrow><mn>2</mn><mn>2</mn></msubsup><mo>]</mo></mrow></mrow><annotation encoding="application/x-tex">\displaystyle\mathbb{E}\left[\Big\|P^{\perp}_{\bm{\theta}(\mathbf{x})}\sum_{t\in\mathcal{T}}U_{t}(\mathbf{x})\mathbf{f}(\bm{\xi}_{t+1})-|\mathcal{T}|\mathbb{E}\Big[P^{\perp}_{\bm{\theta}(\mathbf{x})}U_{0}(\mathbf{x})\mathbf{f}(\bm{\xi}_{1})\Big]\Big\|^{2}_{2}\right]</annotation></semantics></math></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A6.Ex404.m2" class="ltx_Math" alttext="\displaystyle\leq\mathbb{E}\left[\Big\|\sum_{t\in\mathcal{T}}U_{t}(\mathbf{x})\mathbf{f}(\bm{\xi}_{t+1})-|\mathcal{T}|\mathbb{E}\Big[U_{0}(\mathbf{x})\mathbf{f}(\bm{\xi}_{1})\Big]\Big\|^{2}_{2}\right]" display="inline" intent=":literal"><semantics><mrow><mphantom></mphantom><mo>≤</mo><mrow><mi>𝔼</mi><mo>⁡</mo><mrow><mo>[</mo><msubsup><mrow><mo maxsize="1.600em" minsize="1.600em" stretchy="true">‖</mo><mrow><mrow><mstyle displaystyle="true"><munder><mo movablelimits="false">∑</mo><mrow><mi>t</mi><mo>∈</mo><mi class="ltx_font_mathcaligraphic">𝒯</mi></mrow></munder></mstyle><mrow><msub><mi>U</mi><mi>t</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>𝐱</mi><mo stretchy="false">)</mo></mrow><mo lspace="0em" rspace="0em">​</mo><mi>𝐟</mi><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mi>𝝃</mi><mrow><mi>t</mi><mo>+</mo><mn>1</mn></mrow></msub><mo stretchy="false">)</mo></mrow></mrow></mrow><mo>−</mo><mrow><mrow><mo stretchy="false">|</mo><mi class="ltx_font_mathcaligraphic">𝒯</mi><mo stretchy="false">|</mo></mrow><mo lspace="0em" rspace="0em">​</mo><mi>𝔼</mi><mo lspace="0em" rspace="0em">​</mo><mrow><mo maxsize="1.600em" minsize="1.600em">[</mo><mrow><msub><mi>U</mi><mn>0</mn></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>𝐱</mi><mo stretchy="false">)</mo></mrow><mo lspace="0em" rspace="0em">​</mo><mi>𝐟</mi><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mi>𝝃</mi><mn>1</mn></msub><mo stretchy="false">)</mo></mrow></mrow><mo maxsize="1.600em" minsize="1.600em">]</mo></mrow></mrow></mrow><mo maxsize="1.600em" minsize="1.600em" stretchy="true">‖</mo></mrow><mn>2</mn><mn>2</mn></msubsup><mo>]</mo></mrow></mrow></mrow><annotation encoding="application/x-tex">\displaystyle\leq\mathbb{E}\left[\Big\|\sum_{t\in\mathcal{T}}U_{t}(\mathbf{x})\mathbf{f}(\bm{\xi}_{t+1})-|\mathcal{T}|\mathbb{E}\Big[U_{0}(\mathbf{x})\mathbf{f}(\bm{\xi}_{1})\Big]\Big\|^{2}_{2}\right]</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
<tbody id="A6.Ex405"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_eqn_cell"></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A6.Ex405.m1" class="ltx_Math" alttext="\displaystyle\leq\frac{4|\mathcal{T}|}{\gamma_{\mathrm{ps}}(\mathbf{M})}\mathbb{E}\left[\Big\|U_{0}(\mathbf{x})\mathbf{f}(\bm{\xi}_{1})-\mathbb{E}\Big[U_{0}(\mathbf{x})\mathbf{f}(\bm{\xi}_{1})\Big]\Big\|^{2}_{2}\right]" display="inline" intent=":literal"><semantics><mrow><mphantom></mphantom><mo>≤</mo><mrow><mstyle displaystyle="true"><mfrac><mrow><mn>4</mn><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">|</mo><mi class="ltx_font_mathcaligraphic">𝒯</mi><mo stretchy="false">|</mo></mrow></mrow><mrow><msub><mi>γ</mi><mi>ps</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>𝐌</mi><mo stretchy="false">)</mo></mrow></mrow></mfrac></mstyle><mo lspace="0em" rspace="0em">​</mo><mi>𝔼</mi><mo lspace="0em" rspace="0em">​</mo><mrow><mo>[</mo><msubsup><mrow><mo maxsize="1.600em" minsize="1.600em" stretchy="true">‖</mo><mrow><mrow><msub><mi>U</mi><mn>0</mn></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>𝐱</mi><mo stretchy="false">)</mo></mrow><mo lspace="0em" rspace="0em">​</mo><mi>𝐟</mi><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mi>𝝃</mi><mn>1</mn></msub><mo stretchy="false">)</mo></mrow></mrow><mo>−</mo><mrow><mi>𝔼</mi><mo>⁡</mo><mrow><mo maxsize="1.600em" minsize="1.600em">[</mo><mrow><msub><mi>U</mi><mn>0</mn></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>𝐱</mi><mo stretchy="false">)</mo></mrow><mo lspace="0em" rspace="0em">​</mo><mi>𝐟</mi><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mi>𝝃</mi><mn>1</mn></msub><mo stretchy="false">)</mo></mrow></mrow><mo maxsize="1.600em" minsize="1.600em">]</mo></mrow></mrow></mrow><mo maxsize="1.600em" minsize="1.600em" stretchy="true">‖</mo></mrow><mn>2</mn><mn>2</mn></msubsup><mo>]</mo></mrow></mrow></mrow><annotation encoding="application/x-tex">\displaystyle\leq\frac{4|\mathcal{T}|}{\gamma_{\mathrm{ps}}(\mathbf{M})}\mathbb{E}\left[\Big\|U_{0}(\mathbf{x})\mathbf{f}(\bm{\xi}_{1})-\mathbb{E}\Big[U_{0}(\mathbf{x})\mathbf{f}(\bm{\xi}_{1})\Big]\Big\|^{2}_{2}\right]</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
<tbody id="A6.E109"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_eqn_cell"></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A6.E109.m1" class="ltx_Math" alttext="\displaystyle\leq\frac{4\|\mathbf{f}\|_{\infty}^{2}|\mathcal{T}|}{\gamma_{\mathrm{ps}}(\mathbf{M})}\mathbb{E}\left[U_{0}(\mathbf{x})\right]." display="inline" intent=":literal"><semantics><mrow><mrow><mphantom></mphantom><mo>≤</mo><mrow><mstyle displaystyle="true"><mfrac><mrow><mn>4</mn><mo lspace="0em" rspace="0em">​</mo><msubsup><mrow><mo stretchy="false">‖</mo><mi>𝐟</mi><mo stretchy="false">‖</mo></mrow><mi mathvariant="normal">∞</mi><mn>2</mn></msubsup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">|</mo><mi class="ltx_font_mathcaligraphic">𝒯</mi><mo stretchy="false">|</mo></mrow></mrow><mrow><msub><mi>γ</mi><mi>ps</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>𝐌</mi><mo stretchy="false">)</mo></mrow></mrow></mfrac></mstyle><mo lspace="0em" rspace="0em">​</mo><mi>𝔼</mi><mo lspace="0em" rspace="0em">​</mo><mrow><mo>[</mo><mrow><msub><mi>U</mi><mn>0</mn></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>𝐱</mi><mo stretchy="false">)</mo></mrow></mrow><mo>]</mo></mrow></mrow></mrow><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">\displaystyle\leq\frac{4\|\mathbf{f}\|_{\infty}^{2}|\mathcal{T}|}{\gamma_{\mathrm{ps}}(\mathbf{M})}\mathbb{E}\left[U_{0}(\mathbf{x})\right].</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td>
<td rowspan="1" class="ltx_eqn_cell ltx_eqn_eqno ltx_align_middle ltx_align_right"><span class="ltx_tag ltx_tag_equation ltx_align_right">(109)</span></td></tr></tbody>
</table>
<p id="A6.SS3.p1.13" class="ltx_p"><span id="A6.SS3.p1.13.1" class="ltx_text">For the bias term we deduce by conditioning on <math id="A6.SS3.p1.m37" class="ltx_Math" alttext="\bm{\xi}_{0}" display="inline" intent=":literal"><semantics><msub><mi>𝝃</mi><mn>0</mn></msub><annotation encoding="application/x-tex">\bm{\xi}_{0}</annotation></semantics></math> and by applying the definitions of <math id="A6.SS3.p1.m38" class="ltx_Math" alttext="\mathbf{m}" display="inline" intent=":literal"><semantics><mi>𝐦</mi><annotation encoding="application/x-tex">\mathbf{m}</annotation></semantics></math> and <math id="A6.SS3.p1.m39" class="ltx_Math" alttext="\bm{\theta}," display="inline" intent=":literal"><semantics><mrow><mi>𝜽</mi><mo>,</mo></mrow><annotation encoding="application/x-tex">\bm{\theta},</annotation></semantics></math></span></p>
<table id="A6.EGx173" class="ltx_equationgroup ltx_eqn_align ltx_eqn_table">

<tbody id="A6.Ex406"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_align_right ltx_eqn_cell"><math id="A6.Ex406.m1" class="ltx_Math" alttext="\displaystyle|\mathcal{T}|^{2}\Big\|\mathbb{E}\Big[P^{\perp}_{\bm{\theta}(\mathbf{x})}U_{0}(\mathbf{x})\mathbf{f}(\bm{\xi}_{1})\Big]\Big\|^{2}_{2}" display="inline" intent=":literal"><semantics><mrow><msup><mrow><mo stretchy="false">|</mo><mi class="ltx_font_mathcaligraphic">𝒯</mi><mo stretchy="false">|</mo></mrow><mn>2</mn></msup><mo lspace="0em" rspace="0em">​</mo><msubsup><mrow><mo maxsize="1.600em" minsize="1.600em" stretchy="true">‖</mo><mrow><mi>𝔼</mi><mo>⁡</mo><mrow><mo maxsize="1.600em" minsize="1.600em">[</mo><mrow><msubsup><mi>P</mi><mrow><mi>𝜽</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>𝐱</mi><mo stretchy="false">)</mo></mrow></mrow><mo>⟂</mo></msubsup><mo lspace="0em" rspace="0em">​</mo><msub><mi>U</mi><mn>0</mn></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>𝐱</mi><mo stretchy="false">)</mo></mrow><mo lspace="0em" rspace="0em">​</mo><mi>𝐟</mi><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mi>𝝃</mi><mn>1</mn></msub><mo stretchy="false">)</mo></mrow></mrow><mo maxsize="1.600em" minsize="1.600em">]</mo></mrow></mrow><mo maxsize="1.600em" minsize="1.600em" stretchy="true">‖</mo></mrow><mn>2</mn><mn>2</mn></msubsup></mrow><annotation encoding="application/x-tex">\displaystyle|\mathcal{T}|^{2}\Big\|\mathbb{E}\Big[P^{\perp}_{\bm{\theta}(\mathbf{x})}U_{0}(\mathbf{x})\mathbf{f}(\bm{\xi}_{1})\Big]\Big\|^{2}_{2}</annotation></semantics></math></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A6.Ex406.m2" class="ltx_Math" alttext="\displaystyle=|\mathcal{T}|^{2}\Big\|\mathbb{E}\Big[U_{0}(\mathbf{x})P^{\perp}_{\bm{\theta}(\mathbf{x})}\mathbf{m}(\bm{\xi}_{0})\Big]\Big\|^{2}_{2}" display="inline" intent=":literal"><semantics><mrow><mphantom></mphantom><mo>=</mo><mrow><msup><mrow><mo stretchy="false">|</mo><mi class="ltx_font_mathcaligraphic">𝒯</mi><mo stretchy="false">|</mo></mrow><mn>2</mn></msup><mo lspace="0em" rspace="0em">​</mo><msubsup><mrow><mo maxsize="1.600em" minsize="1.600em" stretchy="true">‖</mo><mrow><mi>𝔼</mi><mo>⁡</mo><mrow><mo maxsize="1.600em" minsize="1.600em">[</mo><mrow><msub><mi>U</mi><mn>0</mn></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>𝐱</mi><mo stretchy="false">)</mo></mrow><mo lspace="0em" rspace="0em">​</mo><msubsup><mi>P</mi><mrow><mi>𝜽</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>𝐱</mi><mo stretchy="false">)</mo></mrow></mrow><mo>⟂</mo></msubsup><mo lspace="0em" rspace="0em">​</mo><mi>𝐦</mi><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mi>𝝃</mi><mn>0</mn></msub><mo stretchy="false">)</mo></mrow></mrow><mo maxsize="1.600em" minsize="1.600em">]</mo></mrow></mrow><mo maxsize="1.600em" minsize="1.600em" stretchy="true">‖</mo></mrow><mn>2</mn><mn>2</mn></msubsup></mrow></mrow><annotation encoding="application/x-tex">\displaystyle=|\mathcal{T}|^{2}\Big\|\mathbb{E}\Big[U_{0}(\mathbf{x})P^{\perp}_{\bm{\theta}(\mathbf{x})}\mathbf{m}(\bm{\xi}_{0})\Big]\Big\|^{2}_{2}</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
<tbody id="A6.Ex407"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_eqn_cell"></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A6.Ex407.m1" class="ltx_Math" alttext="\displaystyle=|\mathcal{T}|^{2}\Big\|\mathbb{E}\Big[\|\mathbf{m}(\bm{\xi}_{0})\|_{2}U_{0}(\mathbf{x})P^{\perp}_{\bm{\theta}(\mathbf{x})}\bm{\theta}(\bm{\xi}_{0})\Big]\Big\|^{2}_{2}" display="inline" intent=":literal"><semantics><mrow><mphantom></mphantom><mo>=</mo><mrow><msup><mrow><mo stretchy="false">|</mo><mi class="ltx_font_mathcaligraphic">𝒯</mi><mo stretchy="false">|</mo></mrow><mn>2</mn></msup><mo lspace="0em" rspace="0em">​</mo><msubsup><mrow><mo maxsize="1.600em" minsize="1.600em" stretchy="true">‖</mo><mrow><mi>𝔼</mi><mo>⁡</mo><mrow><mo maxsize="1.600em" minsize="1.600em">[</mo><mrow><msub><mrow><mo stretchy="false">‖</mo><mrow><mi>𝐦</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><msub><mi>𝝃</mi><mn>0</mn></msub><mo stretchy="false">)</mo></mrow></mrow><mo stretchy="false">‖</mo></mrow><mn>2</mn></msub><mo lspace="0em" rspace="0em">​</mo><msub><mi>U</mi><mn>0</mn></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>𝐱</mi><mo stretchy="false">)</mo></mrow><mo lspace="0em" rspace="0em">​</mo><msubsup><mi>P</mi><mrow><mi>𝜽</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>𝐱</mi><mo stretchy="false">)</mo></mrow></mrow><mo>⟂</mo></msubsup><mo lspace="0em" rspace="0em">​</mo><mi>𝜽</mi><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mi>𝝃</mi><mn>0</mn></msub><mo stretchy="false">)</mo></mrow></mrow><mo maxsize="1.600em" minsize="1.600em">]</mo></mrow></mrow><mo maxsize="1.600em" minsize="1.600em" stretchy="true">‖</mo></mrow><mn>2</mn><mn>2</mn></msubsup></mrow></mrow><annotation encoding="application/x-tex">\displaystyle=|\mathcal{T}|^{2}\Big\|\mathbb{E}\Big[\|\mathbf{m}(\bm{\xi}_{0})\|_{2}U_{0}(\mathbf{x})P^{\perp}_{\bm{\theta}(\mathbf{x})}\bm{\theta}(\bm{\xi}_{0})\Big]\Big\|^{2}_{2}</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
<tbody id="A6.Ex408"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_eqn_cell"></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A6.Ex408.m1" class="ltx_Math" alttext="\displaystyle=|\mathcal{T}|^{2}\Big\|\mathbb{E}\Big[\|\mathbf{m}(\bm{\xi}_{0})\|_{2}U_{0}(\mathbf{x})P^{\perp}_{\bm{\theta}(\mathbf{x})}(\bm{\theta}(\bm{\xi}_{0})-\bm{\theta}(\mathbf{x}))\Big]\Big\|^{2}_{2}" display="inline" intent=":literal"><semantics><mrow><mphantom></mphantom><mo>=</mo><mrow><msup><mrow><mo stretchy="false">|</mo><mi class="ltx_font_mathcaligraphic">𝒯</mi><mo stretchy="false">|</mo></mrow><mn>2</mn></msup><mo lspace="0em" rspace="0em">​</mo><msubsup><mrow><mo maxsize="1.600em" minsize="1.600em" stretchy="true">‖</mo><mrow><mi>𝔼</mi><mo>⁡</mo><mrow><mo maxsize="1.600em" minsize="1.600em">[</mo><mrow><msub><mrow><mo stretchy="false">‖</mo><mrow><mi>𝐦</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><msub><mi>𝝃</mi><mn>0</mn></msub><mo stretchy="false">)</mo></mrow></mrow><mo stretchy="false">‖</mo></mrow><mn>2</mn></msub><mo lspace="0em" rspace="0em">​</mo><msub><mi>U</mi><mn>0</mn></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>𝐱</mi><mo stretchy="false">)</mo></mrow><mo lspace="0em" rspace="0em">​</mo><msubsup><mi>P</mi><mrow><mi>𝜽</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>𝐱</mi><mo stretchy="false">)</mo></mrow></mrow><mo>⟂</mo></msubsup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mrow><mrow><mi>𝜽</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><msub><mi>𝝃</mi><mn>0</mn></msub><mo stretchy="false">)</mo></mrow></mrow><mo>−</mo><mrow><mi>𝜽</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>𝐱</mi><mo stretchy="false">)</mo></mrow></mrow></mrow><mo stretchy="false">)</mo></mrow></mrow><mo maxsize="1.600em" minsize="1.600em">]</mo></mrow></mrow><mo maxsize="1.600em" minsize="1.600em" stretchy="true">‖</mo></mrow><mn>2</mn><mn>2</mn></msubsup></mrow></mrow><annotation encoding="application/x-tex">\displaystyle=|\mathcal{T}|^{2}\Big\|\mathbb{E}\Big[\|\mathbf{m}(\bm{\xi}_{0})\|_{2}U_{0}(\mathbf{x})P^{\perp}_{\bm{\theta}(\mathbf{x})}(\bm{\theta}(\bm{\xi}_{0})-\bm{\theta}(\mathbf{x}))\Big]\Big\|^{2}_{2}</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
<tbody id="A6.E110"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_eqn_cell"></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A6.E110.m1" class="ltx_Math" alttext="\displaystyle\leq|\mathcal{T}|^{2}\|\mathbf{f}\|_{\infty}^{2}\mathbb{E}\Big[U_{0}(\mathbf{x})\|\bm{\theta}(\bm{\xi}_{0})-\bm{\theta}(\mathbf{x})\|_{2}\Big]^{2}," display="inline" intent=":literal"><semantics><mrow><mrow><mphantom></mphantom><mo>≤</mo><mrow><msup><mrow><mo stretchy="false">|</mo><mi class="ltx_font_mathcaligraphic">𝒯</mi><mo stretchy="false">|</mo></mrow><mn>2</mn></msup><mo lspace="0em" rspace="0em">​</mo><msubsup><mrow><mo stretchy="false">‖</mo><mi>𝐟</mi><mo stretchy="false">‖</mo></mrow><mi mathvariant="normal">∞</mi><mn>2</mn></msubsup><mo lspace="0em" rspace="0em">​</mo><mi>𝔼</mi><mo lspace="0em" rspace="0em">​</mo><msup><mrow><mo maxsize="1.600em" minsize="1.600em">[</mo><mrow><msub><mi>U</mi><mn>0</mn></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>𝐱</mi><mo stretchy="false">)</mo></mrow><mo lspace="0em" rspace="0em">​</mo><msub><mrow><mo stretchy="false">‖</mo><mrow><mrow><mi>𝜽</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><msub><mi>𝝃</mi><mn>0</mn></msub><mo stretchy="false">)</mo></mrow></mrow><mo>−</mo><mrow><mi>𝜽</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>𝐱</mi><mo stretchy="false">)</mo></mrow></mrow></mrow><mo stretchy="false">‖</mo></mrow><mn>2</mn></msub></mrow><mo maxsize="1.600em" minsize="1.600em">]</mo></mrow><mn>2</mn></msup></mrow></mrow><mo>,</mo></mrow><annotation encoding="application/x-tex">\displaystyle\leq|\mathcal{T}|^{2}\|\mathbf{f}\|_{\infty}^{2}\mathbb{E}\Big[U_{0}(\mathbf{x})\|\bm{\theta}(\bm{\xi}_{0})-\bm{\theta}(\mathbf{x})\|_{2}\Big]^{2},</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td>
<td rowspan="1" class="ltx_eqn_cell ltx_eqn_eqno ltx_align_middle ltx_align_right"><span class="ltx_tag ltx_tag_equation ltx_align_right">(110)</span></td></tr></tbody>
</table>
<p id="A6.SS3.p1.14" class="ltx_p"><span id="A6.SS3.p1.14.1" class="ltx_text">where we use <math id="A6.SS3.p1.m40" class="ltx_Math" alttext="P^{\perp}_{\bm{\theta}(\mathbf{x})}\bm{\theta}(\mathbf{x})=\bm{0}_{d}" display="inline" intent=":literal"><semantics><mrow><mrow><msubsup><mi>P</mi><mrow><mi>𝜽</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>𝐱</mi><mo stretchy="false">)</mo></mrow></mrow><mo>⟂</mo></msubsup><mo lspace="0em" rspace="0em">​</mo><mi>𝜽</mi><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>𝐱</mi><mo stretchy="false">)</mo></mrow></mrow><mo>=</mo><msub><mn>𝟎</mn><mi>d</mi></msub></mrow><annotation encoding="application/x-tex">P^{\perp}_{\bm{\theta}(\mathbf{x})}\bm{\theta}(\mathbf{x})=\bm{0}_{d}</annotation></semantics></math> for the last equality.
Furthermore, by the Hölder continuity of <math id="A6.SS3.p1.m41" class="ltx_Math" alttext="\bm{\theta}," display="inline" intent=":literal"><semantics><mrow><mi>𝜽</mi><mo>,</mo></mrow><annotation encoding="application/x-tex">\bm{\theta},</annotation></semantics></math> we deduce for any <math id="A6.SS3.p1.m42" class="ltx_Math" alttext="\epsilon&gt;0," display="inline" intent=":literal"><semantics><mrow><mrow><mi>ϵ</mi><mo>&gt;</mo><mn>0</mn></mrow><mo>,</mo></mrow><annotation encoding="application/x-tex">\epsilon&gt;0,</annotation></semantics></math></span></p>
<table id="A6.EGx174" class="ltx_equationgroup ltx_eqn_align ltx_eqn_table">

<tbody id="A6.Ex409"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_align_right ltx_eqn_cell"><math id="A6.Ex409.m1" class="ltx_Math" alttext="\displaystyle\mathbb{E}\Big[U_{0}(\mathbf{x})\|\bm{\theta}(\bm{\xi}_{0})-\bm{\theta}(\mathbf{x})\|_{2}\Big]" display="inline" intent=":literal"><semantics><mrow><mi>𝔼</mi><mo>⁡</mo><mrow><mo maxsize="1.600em" minsize="1.600em">[</mo><mrow><msub><mi>U</mi><mn>0</mn></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>𝐱</mi><mo stretchy="false">)</mo></mrow><mo lspace="0em" rspace="0em">​</mo><msub><mrow><mo stretchy="false">‖</mo><mrow><mrow><mi>𝜽</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><msub><mi>𝝃</mi><mn>0</mn></msub><mo stretchy="false">)</mo></mrow></mrow><mo>−</mo><mrow><mi>𝜽</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>𝐱</mi><mo stretchy="false">)</mo></mrow></mrow></mrow><mo stretchy="false">‖</mo></mrow><mn>2</mn></msub></mrow><mo maxsize="1.600em" minsize="1.600em">]</mo></mrow></mrow><annotation encoding="application/x-tex">\displaystyle\mathbb{E}\Big[U_{0}(\mathbf{x})\|\bm{\theta}(\bm{\xi}_{0})-\bm{\theta}(\mathbf{x})\|_{2}\Big]</annotation></semantics></math></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A6.Ex409.m2" class="ltx_Math" alttext="\displaystyle=\sum_{\mathbf{x}^{\prime}\in\mathcal{D}}K_{\lambda}\big(\mathbf{s}(\mathbf{x}^{\prime}),\mathbf{s}(\mathbf{x})\big)\|\bm{\theta}(\mathbf{x}^{\prime})-\bm{\theta}(\mathbf{x})\|_{2}\rho(\mathbf{x}^{\prime})" display="inline" intent=":literal"><semantics><mrow><mphantom></mphantom><mo>=</mo><mrow><mstyle displaystyle="true"><munder><mo movablelimits="false">∑</mo><mrow><msup><mi>𝐱</mi><mo>′</mo></msup><mo>∈</mo><mi class="ltx_font_mathcaligraphic">𝒟</mi></mrow></munder></mstyle><mrow><msub><mi>K</mi><mi>λ</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo maxsize="1.200em" minsize="1.200em">(</mo><mrow><mi>𝐬</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><msup><mi>𝐱</mi><mo>′</mo></msup><mo stretchy="false">)</mo></mrow></mrow><mo>,</mo><mrow><mi>𝐬</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>𝐱</mi><mo stretchy="false">)</mo></mrow></mrow><mo maxsize="1.200em" minsize="1.200em">)</mo></mrow><mo lspace="0em" rspace="0em">​</mo><msub><mrow><mo stretchy="false">‖</mo><mrow><mrow><mi>𝜽</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><msup><mi>𝐱</mi><mo>′</mo></msup><mo stretchy="false">)</mo></mrow></mrow><mo>−</mo><mrow><mi>𝜽</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>𝐱</mi><mo stretchy="false">)</mo></mrow></mrow></mrow><mo stretchy="false">‖</mo></mrow><mn>2</mn></msub><mo lspace="0em" rspace="0em">​</mo><mi>ρ</mi><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msup><mi>𝐱</mi><mo>′</mo></msup><mo stretchy="false">)</mo></mrow></mrow></mrow></mrow><annotation encoding="application/x-tex">\displaystyle=\sum_{\mathbf{x}^{\prime}\in\mathcal{D}}K_{\lambda}\big(\mathbf{s}(\mathbf{x}^{\prime}),\mathbf{s}(\mathbf{x})\big)\|\bm{\theta}(\mathbf{x}^{\prime})-\bm{\theta}(\mathbf{x})\|_{2}\rho(\mathbf{x}^{\prime})</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
<tbody id="A6.Ex410"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_eqn_cell"></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A6.Ex410.m1" class="ltx_Math" alttext="\displaystyle\leq c_{\bm{\theta}}\sum_{\mathbf{x}^{\prime}\in\mathcal{D}}K_{\lambda}\big(\mathbf{s}(\mathbf{x}^{\prime}),\mathbf{s}(\mathbf{x})\big)\|\mathbf{s}(\mathbf{x}^{\prime})-\mathbf{s}(\mathbf{x})\|^{\beta}_{2}\rho(\mathbf{x}^{\prime})" display="inline" intent=":literal"><semantics><mrow><mphantom></mphantom><mo>≤</mo><mrow><msub><mi>c</mi><mi>𝜽</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mstyle displaystyle="true"><munder><mo movablelimits="false">∑</mo><mrow><msup><mi>𝐱</mi><mo>′</mo></msup><mo>∈</mo><mi class="ltx_font_mathcaligraphic">𝒟</mi></mrow></munder></mstyle><mrow><msub><mi>K</mi><mi>λ</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo maxsize="1.200em" minsize="1.200em">(</mo><mrow><mi>𝐬</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><msup><mi>𝐱</mi><mo>′</mo></msup><mo stretchy="false">)</mo></mrow></mrow><mo>,</mo><mrow><mi>𝐬</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>𝐱</mi><mo stretchy="false">)</mo></mrow></mrow><mo maxsize="1.200em" minsize="1.200em">)</mo></mrow><mo lspace="0em" rspace="0em">​</mo><msubsup><mrow><mo stretchy="false">‖</mo><mrow><mrow><mi>𝐬</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><msup><mi>𝐱</mi><mo>′</mo></msup><mo stretchy="false">)</mo></mrow></mrow><mo>−</mo><mrow><mi>𝐬</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>𝐱</mi><mo stretchy="false">)</mo></mrow></mrow></mrow><mo stretchy="false">‖</mo></mrow><mn>2</mn><mi>β</mi></msubsup><mo lspace="0em" rspace="0em">​</mo><mi>ρ</mi><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msup><mi>𝐱</mi><mo>′</mo></msup><mo stretchy="false">)</mo></mrow></mrow></mrow></mrow></mrow><annotation encoding="application/x-tex">\displaystyle\leq c_{\bm{\theta}}\sum_{\mathbf{x}^{\prime}\in\mathcal{D}}K_{\lambda}\big(\mathbf{s}(\mathbf{x}^{\prime}),\mathbf{s}(\mathbf{x})\big)\|\mathbf{s}(\mathbf{x}^{\prime})-\mathbf{s}(\mathbf{x})\|^{\beta}_{2}\rho(\mathbf{x}^{\prime})</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
<tbody id="A6.Ex411"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_eqn_cell"></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A6.Ex411.m1" class="ltx_math_unparsed" alttext="\displaystyle\leq c_{\bm{\theta}}\bigg(\epsilon^{\beta}\sum_{\mathbf{x}^{\prime}\in\mathcal{D}:\|\mathbf{s}(\mathbf{x}^{\prime})-\mathbf{s}(\mathbf{x})\|_{2}\leq\epsilon}\exp\Big(-\frac{\|\mathbf{s}(\mathbf{x}^{\prime})-\mathbf{s}(\mathbf{x})\|_{2}^{2}}{2\lambda^{2}}\Big)\rho(\mathbf{x}^{\prime})" display="inline" intent=":literal"><semantics><mrow><mo>≤</mo><msub><mi>c</mi><mi>𝜽</mi></msub><mrow><mo maxsize="2.100em" minsize="2.100em">(</mo><msup><mi>ϵ</mi><mi>β</mi></msup><mstyle displaystyle="true"><munder><mo movablelimits="false">∑</mo><mrow><msup><mi>𝐱</mi><mo>′</mo></msup><mo>∈</mo><mi class="ltx_font_mathcaligraphic">𝒟</mi><mo lspace="0.278em" rspace="0.278em">:</mo><mrow><msub><mrow><mo stretchy="false">‖</mo><mrow><mrow><mi>𝐬</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><msup><mi>𝐱</mi><mo>′</mo></msup><mo stretchy="false">)</mo></mrow></mrow><mo>−</mo><mrow><mi>𝐬</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>𝐱</mi><mo stretchy="false">)</mo></mrow></mrow></mrow><mo stretchy="false">‖</mo></mrow><mn>2</mn></msub><mo>≤</mo><mi>ϵ</mi></mrow></mrow></munder></mstyle><mi>exp</mi><mrow><mo maxsize="1.600em" minsize="1.600em">(</mo><mo lspace="0em">−</mo><mstyle displaystyle="true"><mfrac><msubsup><mrow><mo stretchy="false">‖</mo><mrow><mrow><mi>𝐬</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><msup><mi>𝐱</mi><mo>′</mo></msup><mo stretchy="false">)</mo></mrow></mrow><mo>−</mo><mrow><mi>𝐬</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>𝐱</mi><mo stretchy="false">)</mo></mrow></mrow></mrow><mo stretchy="false">‖</mo></mrow><mn>2</mn><mn>2</mn></msubsup><mrow><mn>2</mn><mo lspace="0em" rspace="0em">​</mo><msup><mi>λ</mi><mn>2</mn></msup></mrow></mfrac></mstyle><mo maxsize="1.600em" minsize="1.600em">)</mo></mrow><mi>ρ</mi><mrow><mo stretchy="false">(</mo><msup><mi>𝐱</mi><mo>′</mo></msup><mo stretchy="false">)</mo></mrow></mrow></mrow><annotation encoding="application/x-tex">\displaystyle\leq c_{\bm{\theta}}\bigg(\epsilon^{\beta}\sum_{\mathbf{x}^{\prime}\in\mathcal{D}:\|\mathbf{s}(\mathbf{x}^{\prime})-\mathbf{s}(\mathbf{x})\|_{2}\leq\epsilon}\exp\Big(-\frac{\|\mathbf{s}(\mathbf{x}^{\prime})-\mathbf{s}(\mathbf{x})\|_{2}^{2}}{2\lambda^{2}}\Big)\rho(\mathbf{x}^{\prime})</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
<tbody id="A6.Ex412"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_eqn_cell"></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A6.Ex412.m1" class="ltx_math_unparsed" alttext="\displaystyle\qquad\quad+\exp\Big(-\frac{\epsilon^{2}}{2\lambda^{2}}\Big)\sum_{\mathbf{x}^{\prime}\in\mathcal{D}:\|\mathbf{s}(\mathbf{x}^{\prime})-\mathbf{s}(\mathbf{x})\|_{2}&gt;\epsilon}\|\mathbf{s}(\mathbf{x}^{\prime})-\mathbf{s}(\mathbf{x})\|^{\beta}_{2}\rho(\mathbf{x}^{\prime})\bigg)" display="inline" intent=":literal"><semantics><mrow><mo>+</mo><mi>exp</mi><mrow><mo maxsize="1.600em" minsize="1.600em">(</mo><mo lspace="0em">−</mo><mstyle displaystyle="true"><mfrac><msup><mi>ϵ</mi><mn>2</mn></msup><mrow><mn>2</mn><mo lspace="0em" rspace="0em">​</mo><msup><mi>λ</mi><mn>2</mn></msup></mrow></mfrac></mstyle><mo maxsize="1.600em" minsize="1.600em">)</mo></mrow><mstyle displaystyle="true"><munder><mo movablelimits="false">∑</mo><mrow><msup><mi>𝐱</mi><mo>′</mo></msup><mo>∈</mo><mi class="ltx_font_mathcaligraphic">𝒟</mi><mo lspace="0.278em" rspace="0.278em">:</mo><mrow><msub><mrow><mo stretchy="false">‖</mo><mrow><mrow><mi>𝐬</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><msup><mi>𝐱</mi><mo>′</mo></msup><mo stretchy="false">)</mo></mrow></mrow><mo>−</mo><mrow><mi>𝐬</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>𝐱</mi><mo stretchy="false">)</mo></mrow></mrow></mrow><mo stretchy="false">‖</mo></mrow><mn>2</mn></msub><mo>&gt;</mo><mi>ϵ</mi></mrow></mrow></munder></mstyle><mo lspace="0em" rspace="0.167em">∥</mo><mi>𝐬</mi><mrow><mo stretchy="false">(</mo><msup><mi>𝐱</mi><mo>′</mo></msup><mo stretchy="false">)</mo></mrow><mo>−</mo><mi>𝐬</mi><mrow><mo stretchy="false">(</mo><mi>𝐱</mi><mo stretchy="false">)</mo></mrow><msubsup><mo lspace="0em" rspace="0.167em">∥</mo><mn>2</mn><mi>β</mi></msubsup><mi>ρ</mi><mrow><mo stretchy="false">(</mo><msup><mi>𝐱</mi><mo>′</mo></msup><mo stretchy="false">)</mo></mrow><mo maxsize="2.100em" minsize="2.100em">)</mo></mrow><annotation encoding="application/x-tex">\displaystyle\qquad\quad+\exp\Big(-\frac{\epsilon^{2}}{2\lambda^{2}}\Big)\sum_{\mathbf{x}^{\prime}\in\mathcal{D}:\|\mathbf{s}(\mathbf{x}^{\prime})-\mathbf{s}(\mathbf{x})\|_{2}&gt;\epsilon}\|\mathbf{s}(\mathbf{x}^{\prime})-\mathbf{s}(\mathbf{x})\|^{\beta}_{2}\rho(\mathbf{x}^{\prime})\bigg)</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
<tbody id="A6.Ex413"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_eqn_cell"></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A6.Ex413.m1" class="ltx_Math" alttext="\displaystyle\leq c_{\bm{\theta}}\bigg(\epsilon^{\beta}\mathbb{E}\big[U_{0}(\mathbf{x})\big]+2^{\beta}\|\mathbf{s}\|_{\infty}^{\beta}\exp\Big(-\frac{\epsilon^{2}}{2\lambda^{2}}\Big)\bigg)," display="inline" intent=":literal"><semantics><mrow><mrow><mphantom></mphantom><mo>≤</mo><mrow><msub><mi>c</mi><mi>𝜽</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo maxsize="2.100em" minsize="2.100em">(</mo><mrow><mrow><msup><mi>ϵ</mi><mi>β</mi></msup><mo lspace="0em" rspace="0em">​</mo><mi>𝔼</mi><mo lspace="0em" rspace="0em">​</mo><mrow><mo maxsize="1.200em" minsize="1.200em">[</mo><mrow><msub><mi>U</mi><mn>0</mn></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>𝐱</mi><mo stretchy="false">)</mo></mrow></mrow><mo maxsize="1.200em" minsize="1.200em">]</mo></mrow></mrow><mo>+</mo><mrow><msup><mn>2</mn><mi>β</mi></msup><mo lspace="0em" rspace="0em">​</mo><msubsup><mrow><mo stretchy="false">‖</mo><mi>𝐬</mi><mo stretchy="false">‖</mo></mrow><mi mathvariant="normal">∞</mi><mi>β</mi></msubsup><mo lspace="0.167em" rspace="0em">​</mo><mrow><mi>exp</mi><mo>⁡</mo><mrow><mo maxsize="1.600em" minsize="1.600em">(</mo><mrow><mo>−</mo><mstyle displaystyle="true"><mfrac><msup><mi>ϵ</mi><mn>2</mn></msup><mrow><mn>2</mn><mo lspace="0em" rspace="0em">​</mo><msup><mi>λ</mi><mn>2</mn></msup></mrow></mfrac></mstyle></mrow><mo maxsize="1.600em" minsize="1.600em">)</mo></mrow></mrow></mrow></mrow><mo maxsize="2.100em" minsize="2.100em">)</mo></mrow></mrow></mrow><mo>,</mo></mrow><annotation encoding="application/x-tex">\displaystyle\leq c_{\bm{\theta}}\bigg(\epsilon^{\beta}\mathbb{E}\big[U_{0}(\mathbf{x})\big]+2^{\beta}\|\mathbf{s}\|_{\infty}^{\beta}\exp\Big(-\frac{\epsilon^{2}}{2\lambda^{2}}\Big)\bigg),</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="A6.SS3.p1.15" class="ltx_p"><span id="A6.SS3.p1.15.1" class="ltx_text">where we used that <math id="A6.SS3.p1.m43" class="ltx_Math" alttext="K_{\lambda}" display="inline" intent=":literal"><semantics><msub><mi>K</mi><mi>λ</mi></msub><annotation encoding="application/x-tex">K_{\lambda}</annotation></semantics></math> is nonnegative in the last bound.
Choosing</span></p>
<table id="A6.Ex414" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="A6.Ex414.m1" class="ltx_Math" alttext="\epsilon=\lambda\sqrt{2\log\Big((\mathbb{E}[U_{0}(\mathbf{x})]\lambda^{\beta})^{-1}\Big)}," display="block" intent=":literal"><semantics><mrow><mrow><mi>ϵ</mi><mo>=</mo><mrow><mi>λ</mi><mo lspace="0em" rspace="0em">​</mo><msqrt><mrow><mn>2</mn><mo lspace="0.167em" rspace="0em">​</mo><mrow><mi>log</mi><mo>⁡</mo><mrow><mo maxsize="1.600em" minsize="1.600em">(</mo><msup><mrow><mo stretchy="false">(</mo><mrow><mrow><mi>𝔼</mi><mo>⁡</mo><mrow><mo stretchy="false">[</mo><mrow><msub><mi>U</mi><mn>0</mn></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>𝐱</mi><mo stretchy="false">)</mo></mrow></mrow><mo stretchy="false">]</mo></mrow></mrow><mo lspace="0em" rspace="0em">​</mo><msup><mi>λ</mi><mi>β</mi></msup></mrow><mo stretchy="false">)</mo></mrow><mrow><mo>−</mo><mn>1</mn></mrow></msup><mo maxsize="1.600em" minsize="1.600em">)</mo></mrow></mrow></mrow></msqrt></mrow></mrow><mo>,</mo></mrow><annotation encoding="application/x-tex">\epsilon=\lambda\sqrt{2\log\Big((\mathbb{E}[U_{0}(\mathbf{x})]\lambda^{\beta})^{-1}\Big)},</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="A6.SS3.p1.16" class="ltx_p"><span id="A6.SS3.p1.16.1" class="ltx_text">we get</span></p>
<table id="A6.EGx175" class="ltx_equationgroup ltx_eqn_align ltx_eqn_table">

<tbody id="A6.E111"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_eqn_cell"></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A6.E111.m1" class="ltx_Math" alttext="\displaystyle\mathbb{E}\Big[U_{0}(\mathbf{x})\|\bm{\theta}(\bm{\xi}_{0})-\bm{\theta}(\mathbf{x})\|_{2}\Big]\leq c_{\bm{\theta}}\lambda^{\beta}\mathbb{E}[U_{0}(\mathbf{x})]\bigg(\Big(2\log\big((\mathbb{E}[U_{0}(\mathbf{x})]\lambda^{\beta})^{-1}\big)\Big)^{\beta/2}+2^{\beta}\|\mathbf{s}\|_{\infty}^{\beta}\bigg)." display="inline" intent=":literal"><semantics><mrow><mrow><mrow><mi>𝔼</mi><mo>⁡</mo><mrow><mo maxsize="1.600em" minsize="1.600em">[</mo><mrow><msub><mi>U</mi><mn>0</mn></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>𝐱</mi><mo stretchy="false">)</mo></mrow><mo lspace="0em" rspace="0em">​</mo><msub><mrow><mo stretchy="false">‖</mo><mrow><mrow><mi>𝜽</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><msub><mi>𝝃</mi><mn>0</mn></msub><mo stretchy="false">)</mo></mrow></mrow><mo>−</mo><mrow><mi>𝜽</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>𝐱</mi><mo stretchy="false">)</mo></mrow></mrow></mrow><mo stretchy="false">‖</mo></mrow><mn>2</mn></msub></mrow><mo maxsize="1.600em" minsize="1.600em">]</mo></mrow></mrow><mo>≤</mo><mrow><msub><mi>c</mi><mi>𝜽</mi></msub><mo lspace="0em" rspace="0em">​</mo><msup><mi>λ</mi><mi>β</mi></msup><mo lspace="0em" rspace="0em">​</mo><mi>𝔼</mi><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">[</mo><mrow><msub><mi>U</mi><mn>0</mn></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>𝐱</mi><mo stretchy="false">)</mo></mrow></mrow><mo stretchy="false">]</mo></mrow><mo lspace="0em" rspace="0em">​</mo><mrow><mo maxsize="2.100em" minsize="2.100em">(</mo><mrow><msup><mrow><mo maxsize="1.600em" minsize="1.600em">(</mo><mrow><mn>2</mn><mo lspace="0.167em" rspace="0em">​</mo><mrow><mi>log</mi><mo>⁡</mo><mrow><mo maxsize="1.200em" minsize="1.200em">(</mo><msup><mrow><mo stretchy="false">(</mo><mrow><mrow><mi>𝔼</mi><mo>⁡</mo><mrow><mo stretchy="false">[</mo><mrow><msub><mi>U</mi><mn>0</mn></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>𝐱</mi><mo stretchy="false">)</mo></mrow></mrow><mo stretchy="false">]</mo></mrow></mrow><mo lspace="0em" rspace="0em">​</mo><msup><mi>λ</mi><mi>β</mi></msup></mrow><mo stretchy="false">)</mo></mrow><mrow><mo>−</mo><mn>1</mn></mrow></msup><mo maxsize="1.200em" minsize="1.200em">)</mo></mrow></mrow></mrow><mo maxsize="1.600em" minsize="1.600em">)</mo></mrow><mrow><mi>β</mi><mo>/</mo><mn>2</mn></mrow></msup><mo>+</mo><mrow><msup><mn>2</mn><mi>β</mi></msup><mo lspace="0em" rspace="0em">​</mo><msubsup><mrow><mo stretchy="false">‖</mo><mi>𝐬</mi><mo stretchy="false">‖</mo></mrow><mi mathvariant="normal">∞</mi><mi>β</mi></msubsup></mrow></mrow><mo maxsize="2.100em" minsize="2.100em">)</mo></mrow></mrow></mrow><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">\displaystyle\mathbb{E}\Big[U_{0}(\mathbf{x})\|\bm{\theta}(\bm{\xi}_{0})-\bm{\theta}(\mathbf{x})\|_{2}\Big]\leq c_{\bm{\theta}}\lambda^{\beta}\mathbb{E}[U_{0}(\mathbf{x})]\bigg(\Big(2\log\big((\mathbb{E}[U_{0}(\mathbf{x})]\lambda^{\beta})^{-1}\big)\Big)^{\beta/2}+2^{\beta}\|\mathbf{s}\|_{\infty}^{\beta}\bigg).</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td>
<td rowspan="1" class="ltx_eqn_cell ltx_eqn_eqno ltx_align_middle ltx_align_right"><span class="ltx_tag ltx_tag_equation ltx_align_right">(111)</span></td></tr></tbody>
</table>
<p id="A6.SS3.p1.17" class="ltx_p"><span id="A6.SS3.p1.17.1" class="ltx_text">Combining this inequality with (<a href="#A6.E104" title="In Proof. ‣ F.3 Proof of Lemma ‣ Appendix F Directional Convergence of the Nadaraya–Watson Estimator ‣ Generalization Bounds for Transformer-Based Next-Token Prediction in a Language Model" class="ltx_ref"><span class="ltx_text ltx_ref_tag">104</span></a>), (<a href="#A6.E105" title="In Proof. ‣ F.3 Proof of Lemma ‣ Appendix F Directional Convergence of the Nadaraya–Watson Estimator ‣ Generalization Bounds for Transformer-Based Next-Token Prediction in a Language Model" class="ltx_ref"><span class="ltx_text ltx_ref_tag">105</span></a>), (<a href="#A6.E106" title="In Proof. ‣ F.3 Proof of Lemma ‣ Appendix F Directional Convergence of the Nadaraya–Watson Estimator ‣ Generalization Bounds for Transformer-Based Next-Token Prediction in a Language Model" class="ltx_ref"><span class="ltx_text ltx_ref_tag">106</span></a>), (<a href="#A6.E107" title="In Proof. ‣ F.3 Proof of Lemma ‣ Appendix F Directional Convergence of the Nadaraya–Watson Estimator ‣ Generalization Bounds for Transformer-Based Next-Token Prediction in a Language Model" class="ltx_ref"><span class="ltx_text ltx_ref_tag">107</span></a>), (<a href="#A6.E108" title="In Proof. ‣ F.3 Proof of Lemma ‣ Appendix F Directional Convergence of the Nadaraya–Watson Estimator ‣ Generalization Bounds for Transformer-Based Next-Token Prediction in a Language Model" class="ltx_ref"><span class="ltx_text ltx_ref_tag">108</span></a>),
(<a href="#A6.E109" title="In Proof. ‣ F.3 Proof of Lemma ‣ Appendix F Directional Convergence of the Nadaraya–Watson Estimator ‣ Generalization Bounds for Transformer-Based Next-Token Prediction in a Language Model" class="ltx_ref"><span class="ltx_text ltx_ref_tag">109</span></a>) and (<a href="#A6.E110" title="In Proof. ‣ F.3 Proof of Lemma ‣ Appendix F Directional Convergence of the Nadaraya–Watson Estimator ‣ Generalization Bounds for Transformer-Based Next-Token Prediction in a Language Model" class="ltx_ref"><span class="ltx_text ltx_ref_tag">110</span></a>) yields, for any <math id="A6.SS3.p1.m44" class="ltx_Math" alttext="\mathbf{x}\in\mathcal{D}" display="inline" intent=":literal"><semantics><mrow><mi>𝐱</mi><mo>∈</mo><mi class="ltx_font_mathcaligraphic">𝒟</mi></mrow><annotation encoding="application/x-tex">\mathbf{x}\in\mathcal{D}</annotation></semantics></math></span></p>
<table id="A6.EGx176" class="ltx_equationgroup ltx_eqn_align ltx_eqn_table">

<tbody id="A6.Ex415"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_align_right ltx_eqn_cell"><math id="A6.Ex415.m1" class="ltx_Math" alttext="\displaystyle\mathbb{E}^{\mathbf{x}}\left[\|P^{\perp}_{\bm{\theta}(\bm{\xi}_{T})}\widehat{\mathbf{m}}_{\lambda}(\bm{\xi}_{T})\|^{2}_{2}\right]" display="inline" intent=":literal"><semantics><mrow><msup><mi>𝔼</mi><mi>𝐱</mi></msup><mo lspace="0em" rspace="0em">​</mo><mrow><mo>[</mo><msubsup><mrow><mo stretchy="false">‖</mo><mrow><msubsup><mi>P</mi><mrow><mi>𝜽</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><msub><mi>𝝃</mi><mi>T</mi></msub><mo stretchy="false">)</mo></mrow></mrow><mo>⟂</mo></msubsup><mo lspace="0em" rspace="0em">​</mo><msub><mover accent="true"><mi>𝐦</mi><mo>^</mo></mover><mi>λ</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mi>𝝃</mi><mi>T</mi></msub><mo stretchy="false">)</mo></mrow></mrow><mo stretchy="false">‖</mo></mrow><mn>2</mn><mn>2</mn></msubsup><mo>]</mo></mrow></mrow><annotation encoding="application/x-tex">\displaystyle\mathbb{E}^{\mathbf{x}}\left[\|P^{\perp}_{\bm{\theta}(\bm{\xi}_{T})}\widehat{\mathbf{m}}_{\lambda}(\bm{\xi}_{T})\|^{2}_{2}\right]</annotation></semantics></math></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A6.Ex415.m2" class="ltx_Math" alttext="\displaystyle\leq 3\|\mathbf{f}\|_{\infty}^{2}c_{\mathbf{M}}^{\log^{2}T-1}+\frac{32\|\mathbf{f}\|_{\infty}^{2}}{\gamma_{\mathrm{ps}}(\mathbf{M})|\mathcal{T}|\inf_{\mathbf{x}\in\mathcal{D}}\mathbb{E}\big[U_{0}(\mathbf{x})\big]}" display="inline" intent=":literal"><semantics><mrow><mphantom></mphantom><mo>≤</mo><mrow><mrow><mn>3</mn><mo lspace="0em" rspace="0em">​</mo><msubsup><mrow><mo stretchy="false">‖</mo><mi>𝐟</mi><mo stretchy="false">‖</mo></mrow><mi mathvariant="normal">∞</mi><mn>2</mn></msubsup><mo lspace="0em" rspace="0em">​</mo><msubsup><mi>c</mi><mi>𝐌</mi><mrow><mrow><msup><mi>log</mi><mn>2</mn></msup><mo lspace="0.167em">⁡</mo><mi>T</mi></mrow><mo>−</mo><mn>1</mn></mrow></msubsup></mrow><mo>+</mo><mstyle displaystyle="true"><mfrac><mrow><mn>32</mn><mo lspace="0em" rspace="0em">​</mo><msubsup><mrow><mo stretchy="false">‖</mo><mi>𝐟</mi><mo stretchy="false">‖</mo></mrow><mi mathvariant="normal">∞</mi><mn>2</mn></msubsup></mrow><mrow><msub><mi>γ</mi><mi>ps</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>𝐌</mi><mo stretchy="false">)</mo></mrow><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">|</mo><mi class="ltx_font_mathcaligraphic">𝒯</mi><mo stretchy="false">|</mo></mrow><mo lspace="0.167em" rspace="0em">​</mo><mrow><msub><mo rspace="0.167em">inf</mo><mrow><mi>𝐱</mi><mo>∈</mo><mi class="ltx_font_mathcaligraphic">𝒟</mi></mrow></msub><mrow><mi>𝔼</mi><mo>⁡</mo><mrow><mo maxsize="1.200em" minsize="1.200em">[</mo><mrow><msub><mi>U</mi><mn>0</mn></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>𝐱</mi><mo stretchy="false">)</mo></mrow></mrow><mo maxsize="1.200em" minsize="1.200em">]</mo></mrow></mrow></mrow></mrow></mfrac></mstyle></mrow></mrow><annotation encoding="application/x-tex">\displaystyle\leq 3\|\mathbf{f}\|_{\infty}^{2}c_{\mathbf{M}}^{\log^{2}T-1}+\frac{32\|\mathbf{f}\|_{\infty}^{2}}{\gamma_{\mathrm{ps}}(\mathbf{M})|\mathcal{T}|\inf_{\mathbf{x}\in\mathcal{D}}\mathbb{E}\big[U_{0}(\mathbf{x})\big]}</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
<tbody id="A6.Ex416"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_eqn_cell"></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A6.Ex416.m1" class="ltx_Math" alttext="\displaystyle\quad+4\|\mathbf{f}\|_{\infty}^{2}c^{2}_{\bm{\theta}}\lambda^{2\beta}\Big(\Big(2\log\Big((\inf_{\mathbf{x}\in\mathcal{D}}\mathbb{E}[U_{0}(\mathbf{x})]\lambda^{\beta})^{-1}\Big)\Big)^{\beta/2}+2^{\beta}\|\mathbf{s}\|_{\infty}^{\beta}\Big)^{2}," display="inline" intent=":literal"><semantics><mrow><mrow><mo>+</mo><mrow><mn>4</mn><mo lspace="0em" rspace="0em">​</mo><msubsup><mrow><mo stretchy="false">‖</mo><mi>𝐟</mi><mo stretchy="false">‖</mo></mrow><mi mathvariant="normal">∞</mi><mn>2</mn></msubsup><mo lspace="0em" rspace="0em">​</mo><msubsup><mi>c</mi><mi>𝜽</mi><mn>2</mn></msubsup><mo lspace="0em" rspace="0em">​</mo><msup><mi>λ</mi><mrow><mn>2</mn><mo lspace="0em" rspace="0em">​</mo><mi>β</mi></mrow></msup><mo lspace="0em" rspace="0em">​</mo><msup><mrow><mo maxsize="1.600em" minsize="1.600em">(</mo><mrow><msup><mrow><mo maxsize="1.600em" minsize="1.600em">(</mo><mrow><mn>2</mn><mo lspace="0.167em" rspace="0em">​</mo><mrow><mi>log</mi><mo>⁡</mo><mrow><mo maxsize="1.600em" minsize="1.600em">(</mo><msup><mrow><mo stretchy="false">(</mo><mrow><munder><mo lspace="0em" movablelimits="false" rspace="0.167em">inf</mo><mrow><mi>𝐱</mi><mo>∈</mo><mi class="ltx_font_mathcaligraphic">𝒟</mi></mrow></munder><mrow><mrow><mi>𝔼</mi><mo>⁡</mo><mrow><mo stretchy="false">[</mo><mrow><msub><mi>U</mi><mn>0</mn></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>𝐱</mi><mo stretchy="false">)</mo></mrow></mrow><mo stretchy="false">]</mo></mrow></mrow><mo lspace="0em" rspace="0em">​</mo><msup><mi>λ</mi><mi>β</mi></msup></mrow></mrow><mo stretchy="false">)</mo></mrow><mrow><mo>−</mo><mn>1</mn></mrow></msup><mo maxsize="1.600em" minsize="1.600em">)</mo></mrow></mrow></mrow><mo maxsize="1.600em" minsize="1.600em">)</mo></mrow><mrow><mi>β</mi><mo>/</mo><mn>2</mn></mrow></msup><mo>+</mo><mrow><msup><mn>2</mn><mi>β</mi></msup><mo lspace="0em" rspace="0em">​</mo><msubsup><mrow><mo stretchy="false">‖</mo><mi>𝐬</mi><mo stretchy="false">‖</mo></mrow><mi mathvariant="normal">∞</mi><mi>β</mi></msubsup></mrow></mrow><mo maxsize="1.600em" minsize="1.600em">)</mo></mrow><mn>2</mn></msup></mrow></mrow><mo>,</mo></mrow><annotation encoding="application/x-tex">\displaystyle\quad+4\|\mathbf{f}\|_{\infty}^{2}c^{2}_{\bm{\theta}}\lambda^{2\beta}\Big(\Big(2\log\Big((\inf_{\mathbf{x}\in\mathcal{D}}\mathbb{E}[U_{0}(\mathbf{x})]\lambda^{\beta})^{-1}\Big)\Big)^{\beta/2}+2^{\beta}\|\mathbf{s}\|_{\infty}^{\beta}\Big)^{2},</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="A6.SS3.p1.18" class="ltx_p"><span id="A6.SS3.p1.18.1" class="ltx_text">which together with the assumption <math id="A6.SS3.p1.m45" class="ltx_Math" alttext="\lambda\geq T^{-1}" display="inline" intent=":literal"><semantics><mrow><mi>λ</mi><mo>≥</mo><msup><mi>T</mi><mrow><mo>−</mo><mn>1</mn></mrow></msup></mrow><annotation encoding="application/x-tex">\lambda\geq T^{-1}</annotation></semantics></math> and <math id="A6.SS3.p1.m46" class="ltx_Math" alttext="c_{\mathbf{M}}^{\log^{2}T-1}=O(T^{-2\beta})=O(\lambda^{2\beta})" display="inline" intent=":literal"><semantics><mrow><msubsup><mi>c</mi><mi>𝐌</mi><mrow><mrow><msup><mi>log</mi><mn>2</mn></msup><mo lspace="0.167em">⁡</mo><mi>T</mi></mrow><mo>−</mo><mn>1</mn></mrow></msubsup><mo>=</mo><mrow><mi>O</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><msup><mi>T</mi><mrow><mo>−</mo><mrow><mn>2</mn><mo lspace="0em" rspace="0em">​</mo><mi>β</mi></mrow></mrow></msup><mo stretchy="false">)</mo></mrow></mrow><mo>=</mo><mrow><mi>O</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><msup><mi>λ</mi><mrow><mn>2</mn><mo lspace="0em" rspace="0em">​</mo><mi>β</mi></mrow></msup><mo stretchy="false">)</mo></mrow></mrow></mrow><annotation encoding="application/x-tex">c_{\mathbf{M}}^{\log^{2}T-1}=O(T^{-2\beta})=O(\lambda^{2\beta})</annotation></semantics></math> proves the first assertion (<a href="#A6.E96" title="In Lemma 29. ‣ F.1 Proof of Lemma ‣ Appendix F Directional Convergence of the Nadaraya–Watson Estimator ‣ Generalization Bounds for Transformer-Based Next-Token Prediction in a Language Model" class="ltx_ref"><span class="ltx_text ltx_ref_tag">96</span></a>).</span></p>
</div>
<div id="A6.SS3.p2" class="ltx_para">
<p id="A6.SS3.p2.1" class="ltx_p"><span id="A6.SS3.p2.1.1" class="ltx_text">To prove the second assertion, define</span></p>
<table id="A6.Ex417" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="A6.Ex417.m1" class="ltx_Math" alttext="\nu(\lambda,\rho,\mathbf{m})\coloneqq\inf_{\mathbf{x}\in\mathcal{D}}\frac{\big\|\mathbb{E}\left[U_{0}(\mathbf{x})P_{\bm{\theta}(\mathbf{x})}\mathbf{m}(\bm{\xi}_{0})\right]\big\|_{2}}{\mathbb{E}\big[U_{0}(\mathbf{x})\big]}." display="block" intent=":literal"><semantics><mrow><mrow><mrow><mi>ν</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>λ</mi><mo>,</mo><mi>ρ</mi><mo>,</mo><mi>𝐦</mi><mo stretchy="false">)</mo></mrow></mrow><mo rspace="0.1389em">≔</mo><mrow><munder><mo lspace="0.1389em" movablelimits="false" rspace="0.167em">inf</mo><mrow><mi>𝐱</mi><mo>∈</mo><mi class="ltx_font_mathcaligraphic">𝒟</mi></mrow></munder><mfrac><msub><mrow><mo maxsize="1.200em" minsize="1.200em" stretchy="true">‖</mo><mrow><mi>𝔼</mi><mo>⁡</mo><mrow><mo>[</mo><mrow><msub><mi>U</mi><mn>0</mn></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>𝐱</mi><mo stretchy="false">)</mo></mrow><mo lspace="0em" rspace="0em">​</mo><msub><mi>P</mi><mrow><mi>𝜽</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>𝐱</mi><mo stretchy="false">)</mo></mrow></mrow></msub><mo lspace="0em" rspace="0em">​</mo><mi>𝐦</mi><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mi>𝝃</mi><mn>0</mn></msub><mo stretchy="false">)</mo></mrow></mrow><mo>]</mo></mrow></mrow><mo maxsize="1.200em" minsize="1.200em" stretchy="true">‖</mo></mrow><mn>2</mn></msub><mrow><mi>𝔼</mi><mo lspace="0em" rspace="0em">​</mo><mrow><mo maxsize="1.200em" minsize="1.200em">[</mo><mrow><msub><mi>U</mi><mn>0</mn></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>𝐱</mi><mo stretchy="false">)</mo></mrow></mrow><mo maxsize="1.200em" minsize="1.200em">]</mo></mrow></mrow></mfrac></mrow></mrow><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">\nu(\lambda,\rho,\mathbf{m})\coloneqq\inf_{\mathbf{x}\in\mathcal{D}}\frac{\big\|\mathbb{E}\left[U_{0}(\mathbf{x})P_{\bm{\theta}(\mathbf{x})}\mathbf{m}(\bm{\xi}_{0})\right]\big\|_{2}}{\mathbb{E}\big[U_{0}(\mathbf{x})\big]}.</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="A6.SS3.p2.2" class="ltx_p"><span id="A6.SS3.p2.2.1" class="ltx_text">Consider the event</span></p>
<table id="A6.Ex418" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="A6.Ex418.m1" class="ltx_math_unparsed" alttext="A(\mathbf{u}):=\bigg\{\big\|P_{\bm{\theta}(\mathbf{u})}\widehat{\mathbf{m}}_{\lambda}(\mathbf{u})\big\|_{2}&lt;\frac{\nu(\lambda,\rho,\mathbf{m})}{4}\bigg\}." display="block" intent=":literal"><semantics><mrow><mi>A</mi><mrow><mo stretchy="false">(</mo><mi>𝐮</mi><mo stretchy="false">)</mo></mrow><mo>:=</mo><mrow><mo stretchy="false">{</mo><mo lspace="0em" mathsize="1.200em" rspace="0.167em">∥</mo><msub><mi>P</mi><mrow><mi>𝜽</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>𝐮</mi><mo stretchy="false">)</mo></mrow></mrow></msub><msub><mover accent="true"><mi>𝐦</mi><mo>^</mo></mover><mi>λ</mi></msub><mrow><mo stretchy="false">(</mo><mi>𝐮</mi><mo stretchy="false">)</mo></mrow><msub><mo lspace="0em" mathsize="1.200em" rspace="0.0835em">∥</mo><mn>2</mn></msub><mo lspace="0.0835em">&lt;</mo><mfrac><mrow><mi>ν</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>λ</mi><mo>,</mo><mi>ρ</mi><mo>,</mo><mi>𝐦</mi><mo stretchy="false">)</mo></mrow></mrow><mn>4</mn></mfrac><mo stretchy="false">}</mo></mrow><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">A(\mathbf{u}):=\bigg\{\big\|P_{\bm{\theta}(\mathbf{u})}\widehat{\mathbf{m}}_{\lambda}(\mathbf{u})\big\|_{2}&lt;\frac{\nu(\lambda,\rho,\mathbf{m})}{4}\bigg\}.</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="A6.SS3.p2.3" class="ltx_p"><span id="A6.SS3.p2.3.1" class="ltx_text">Using the closeness to the invariant distribution <math id="A6.SS3.p2.m1" class="ltx_Math" alttext="\mathbb{P}" display="inline" intent=":literal"><semantics><mi>ℙ</mi><annotation encoding="application/x-tex">\mathbb{P}</annotation></semantics></math> and arguing similarly as in (<a href="#A6.E104" title="In Proof. ‣ F.3 Proof of Lemma ‣ Appendix F Directional Convergence of the Nadaraya–Watson Estimator ‣ Generalization Bounds for Transformer-Based Next-Token Prediction in a Language Model" class="ltx_ref"><span class="ltx_text ltx_ref_tag">104</span></a>), (<a href="#A6.E105" title="In Proof. ‣ F.3 Proof of Lemma ‣ Appendix F Directional Convergence of the Nadaraya–Watson Estimator ‣ Generalization Bounds for Transformer-Based Next-Token Prediction in a Language Model" class="ltx_ref"><span class="ltx_text ltx_ref_tag">105</span></a>), and (<a href="#A6.E106" title="In Proof. ‣ F.3 Proof of Lemma ‣ Appendix F Directional Convergence of the Nadaraya–Watson Estimator ‣ Generalization Bounds for Transformer-Based Next-Token Prediction in a Language Model" class="ltx_ref"><span class="ltx_text ltx_ref_tag">106</span></a>), we obtain for <math id="A6.SS3.p2.m2" class="ltx_Math" alttext="\tilde{\bm{\xi}}" display="inline" intent=":literal"><semantics><mover accent="true"><mi>𝝃</mi><mo>~</mo></mover><annotation encoding="application/x-tex">\tilde{\bm{\xi}}</annotation></semantics></math> as in (<a href="#A6.E105" title="In Proof. ‣ F.3 Proof of Lemma ‣ Appendix F Directional Convergence of the Nadaraya–Watson Estimator ‣ Generalization Bounds for Transformer-Based Next-Token Prediction in a Language Model" class="ltx_ref"><span class="ltx_text ltx_ref_tag">105</span></a>) and any <math id="A6.SS3.p2.m3" class="ltx_Math" alttext="\mathbf{x}\in\mathcal{D}" display="inline" intent=":literal"><semantics><mrow><mi>𝐱</mi><mo>∈</mo><mi class="ltx_font_mathcaligraphic">𝒟</mi></mrow><annotation encoding="application/x-tex">\mathbf{x}\in\mathcal{D}</annotation></semantics></math>,</span></p>
<table id="A6.EGx177" class="ltx_equationgroup ltx_eqn_align ltx_eqn_table">

<tbody id="A6.Ex419"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_align_right ltx_eqn_cell"><math id="A6.Ex419.m1" class="ltx_Math" alttext="\displaystyle\mathbb{P}^{\mathbf{x}}\big(A(\bm{\xi}_{T})\big)" display="inline" intent=":literal"><semantics><mrow><msup><mi>ℙ</mi><mi>𝐱</mi></msup><mo lspace="0em" rspace="0em">​</mo><mrow><mo maxsize="1.200em" minsize="1.200em">(</mo><mrow><mi>A</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><msub><mi>𝝃</mi><mi>T</mi></msub><mo stretchy="false">)</mo></mrow></mrow><mo maxsize="1.200em" minsize="1.200em">)</mo></mrow></mrow><annotation encoding="application/x-tex">\displaystyle\mathbb{P}^{\mathbf{x}}\big(A(\bm{\xi}_{T})\big)</annotation></semantics></math></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A6.Ex419.m2" class="ltx_Math" alttext="\displaystyle\leq\|P^{\min(\mathcal{T})}(x,\cdot)-\rho\|_{\operatorname{TV}}+\mathbb{P}\big(A(\bm{\xi}_{T})\big)" display="inline" intent=":literal"><semantics><mrow><mphantom></mphantom><mo>≤</mo><mrow><msub><mrow><mo stretchy="false">‖</mo><mrow><mrow><msup><mi>P</mi><mrow><mi>min</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi class="ltx_font_mathcaligraphic">𝒯</mi><mo stretchy="false">)</mo></mrow></mrow></msup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>x</mi><mo rspace="0em">,</mo><mo lspace="0em" rspace="0em">⋅</mo><mo stretchy="false">)</mo></mrow></mrow><mo>−</mo><mi>ρ</mi></mrow><mo stretchy="false">‖</mo></mrow><mi>TV</mi></msub><mo>+</mo><mrow><mi>ℙ</mi><mo>⁡</mo><mrow><mo maxsize="1.200em" minsize="1.200em">(</mo><mrow><mi>A</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><msub><mi>𝝃</mi><mi>T</mi></msub><mo stretchy="false">)</mo></mrow></mrow><mo maxsize="1.200em" minsize="1.200em">)</mo></mrow></mrow></mrow></mrow><annotation encoding="application/x-tex">\displaystyle\leq\|P^{\min(\mathcal{T})}(x,\cdot)-\rho\|_{\operatorname{TV}}+\mathbb{P}\big(A(\bm{\xi}_{T})\big)</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
<tbody id="A6.Ex420"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_eqn_cell"></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A6.Ex420.m1" class="ltx_Math" alttext="\displaystyle\leq c_{\mathbf{M}}^{\min(\mathcal{T})}+\mathbb{P}(\bm{\xi}_{T}\neq\tilde{\bm{\xi}})+\mathbb{P}\big(A(\tilde{\bm{\xi}})\big)" display="inline" intent=":literal"><semantics><mrow><mphantom></mphantom><mo>≤</mo><mrow><msubsup><mi>c</mi><mi>𝐌</mi><mrow><mi>min</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi class="ltx_font_mathcaligraphic">𝒯</mi><mo stretchy="false">)</mo></mrow></mrow></msubsup><mo>+</mo><mrow><mi>ℙ</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mrow><msub><mi>𝝃</mi><mi>T</mi></msub><mo>≠</mo><mover accent="true"><mi>𝝃</mi><mo>~</mo></mover></mrow><mo stretchy="false">)</mo></mrow></mrow><mo>+</mo><mrow><mi>ℙ</mi><mo>⁡</mo><mrow><mo maxsize="1.200em" minsize="1.200em">(</mo><mrow><mi>A</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mover accent="true"><mi>𝝃</mi><mo>~</mo></mover><mo stretchy="false">)</mo></mrow></mrow><mo maxsize="1.200em" minsize="1.200em">)</mo></mrow></mrow></mrow></mrow><annotation encoding="application/x-tex">\displaystyle\leq c_{\mathbf{M}}^{\min(\mathcal{T})}+\mathbb{P}(\bm{\xi}_{T}\neq\tilde{\bm{\xi}})+\mathbb{P}\big(A(\tilde{\bm{\xi}})\big)</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
<tbody id="A6.E112"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_eqn_cell"></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A6.E112.m1" class="ltx_Math" alttext="\displaystyle\leq c_{\mathbf{M}}^{\min(\mathcal{T})}+2c_{\mathbf{M}}^{T-\max(\mathcal{T})}+\sum_{\mathbf{x}\in\mathcal{D}}\mathbb{P}\big(A(\mathbf{x})\big)\rho(\mathbf{x})." display="inline" intent=":literal"><semantics><mrow><mrow><mphantom></mphantom><mo>≤</mo><mrow><msubsup><mi>c</mi><mi>𝐌</mi><mrow><mi>min</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi class="ltx_font_mathcaligraphic">𝒯</mi><mo stretchy="false">)</mo></mrow></mrow></msubsup><mo>+</mo><mrow><mn>2</mn><mo lspace="0em" rspace="0em">​</mo><msubsup><mi>c</mi><mi>𝐌</mi><mrow><mi>T</mi><mo>−</mo><mrow><mi>max</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi class="ltx_font_mathcaligraphic">𝒯</mi><mo stretchy="false">)</mo></mrow></mrow></mrow></msubsup></mrow><mo>+</mo><mrow><mstyle displaystyle="true"><munder><mo movablelimits="false">∑</mo><mrow><mi>𝐱</mi><mo>∈</mo><mi class="ltx_font_mathcaligraphic">𝒟</mi></mrow></munder></mstyle><mrow><mrow><mi>ℙ</mi><mo>⁡</mo><mrow><mo maxsize="1.200em" minsize="1.200em">(</mo><mrow><mi>A</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>𝐱</mi><mo stretchy="false">)</mo></mrow></mrow><mo maxsize="1.200em" minsize="1.200em">)</mo></mrow></mrow><mo lspace="0em" rspace="0em">​</mo><mi>ρ</mi><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>𝐱</mi><mo stretchy="false">)</mo></mrow></mrow></mrow></mrow></mrow><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">\displaystyle\leq c_{\mathbf{M}}^{\min(\mathcal{T})}+2c_{\mathbf{M}}^{T-\max(\mathcal{T})}+\sum_{\mathbf{x}\in\mathcal{D}}\mathbb{P}\big(A(\mathbf{x})\big)\rho(\mathbf{x}).</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td>
<td rowspan="1" class="ltx_eqn_cell ltx_eqn_eqno ltx_align_middle ltx_align_right"><span class="ltx_tag ltx_tag_equation ltx_align_right">(112)</span></td></tr></tbody>
</table>
<p id="A6.SS3.p2.4" class="ltx_p"><span id="A6.SS3.p2.4.1" class="ltx_text">Moreover,</span></p>
<table id="A6.EGx178" class="ltx_equationgroup ltx_eqn_align ltx_eqn_table">

<tbody id="A6.E113"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_align_right ltx_eqn_cell"><math id="A6.E113.m1" class="ltx_Math" alttext="\displaystyle c_{\mathbf{M}}^{\min(\mathcal{T})}+2c_{\mathbf{M}}^{T-\max(\mathcal{T})}\leq 3c_{\mathbf{M}}^{\log^{2}T}\lesssim\frac{1}{T}." display="inline" intent=":literal"><semantics><mrow><mrow><mrow><msubsup><mi>c</mi><mi>𝐌</mi><mrow><mi>min</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi class="ltx_font_mathcaligraphic">𝒯</mi><mo stretchy="false">)</mo></mrow></mrow></msubsup><mo>+</mo><mrow><mn>2</mn><mo lspace="0em" rspace="0em">​</mo><msubsup><mi>c</mi><mi>𝐌</mi><mrow><mi>T</mi><mo>−</mo><mrow><mi>max</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi class="ltx_font_mathcaligraphic">𝒯</mi><mo stretchy="false">)</mo></mrow></mrow></mrow></msubsup></mrow></mrow><mo>≤</mo><mrow><mn>3</mn><mo lspace="0em" rspace="0em">​</mo><msubsup><mi>c</mi><mi>𝐌</mi><mrow><msup><mi>log</mi><mn>2</mn></msup><mo lspace="0.167em">⁡</mo><mi>T</mi></mrow></msubsup></mrow><mo>≲</mo><mstyle displaystyle="true"><mfrac><mn>1</mn><mi>T</mi></mfrac></mstyle></mrow><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">\displaystyle c_{\mathbf{M}}^{\min(\mathcal{T})}+2c_{\mathbf{M}}^{T-\max(\mathcal{T})}\leq 3c_{\mathbf{M}}^{\log^{2}T}\lesssim\frac{1}{T}.</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td>
<td rowspan="1" class="ltx_eqn_cell ltx_eqn_eqno ltx_align_middle ltx_align_right"><span class="ltx_tag ltx_tag_equation ltx_align_right">(113)</span></td></tr></tbody>
</table>
<p id="A6.SS3.p2.5" class="ltx_p"><span id="A6.SS3.p2.5.1" class="ltx_text">It therefore suffices to investigate the stationary case.
Additionally it holds for any <math id="A6.SS3.p2.m4" class="ltx_Math" alttext="\mathbf{x}\in\mathcal{D}" display="inline" intent=":literal"><semantics><mrow><mi>𝐱</mi><mo>∈</mo><mi class="ltx_font_mathcaligraphic">𝒟</mi></mrow><annotation encoding="application/x-tex">\mathbf{x}\in\mathcal{D}</annotation></semantics></math>,</span></p>
<table id="A6.EGx179" class="ltx_equationgroup ltx_eqn_align ltx_eqn_table">

<tbody id="A6.Ex421"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_align_right ltx_eqn_cell"><math id="A6.Ex421.m1" class="ltx_Math" alttext="\displaystyle\mathbb{P}\big(A(\mathbf{x})\big)" display="inline" intent=":literal"><semantics><mrow><mi>ℙ</mi><mo>⁡</mo><mrow><mo maxsize="1.200em" minsize="1.200em">(</mo><mrow><mi>A</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>𝐱</mi><mo stretchy="false">)</mo></mrow></mrow><mo maxsize="1.200em" minsize="1.200em">)</mo></mrow></mrow><annotation encoding="application/x-tex">\displaystyle\mathbb{P}\big(A(\mathbf{x})\big)</annotation></semantics></math></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A6.Ex421.m2" class="ltx_Math" alttext="\displaystyle=\mathbb{P}\left(\frac{\|\sum_{t\in\mathcal{T}}U_{t}(\mathbf{x})P_{\bm{\theta}(\mathbf{x})}\mathbf{f}(\bm{\xi}_{t+1})\|_{2}}{\sum_{t\in\mathcal{T}}U_{t}(\mathbf{x})}&lt;\frac{\nu(\lambda,\rho,\mathbf{m})}{4}\right)" display="inline" intent=":literal"><semantics><mrow><mphantom></mphantom><mo>=</mo><mrow><mi>ℙ</mi><mo>⁡</mo><mrow><mo>(</mo><mrow><mstyle displaystyle="true"><mfrac><msub><mrow><mo stretchy="false">‖</mo><mrow><msub><mo lspace="0em">∑</mo><mrow><mi>t</mi><mo>∈</mo><mi class="ltx_font_mathcaligraphic">𝒯</mi></mrow></msub><mrow><msub><mi>U</mi><mi>t</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>𝐱</mi><mo stretchy="false">)</mo></mrow><mo lspace="0em" rspace="0em">​</mo><msub><mi>P</mi><mrow><mi>𝜽</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>𝐱</mi><mo stretchy="false">)</mo></mrow></mrow></msub><mo lspace="0em" rspace="0em">​</mo><mi>𝐟</mi><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mi>𝝃</mi><mrow><mi>t</mi><mo>+</mo><mn>1</mn></mrow></msub><mo stretchy="false">)</mo></mrow></mrow></mrow><mo stretchy="false">‖</mo></mrow><mn>2</mn></msub><mrow><msub><mo>∑</mo><mrow><mi>t</mi><mo>∈</mo><mi class="ltx_font_mathcaligraphic">𝒯</mi></mrow></msub><mrow><msub><mi>U</mi><mi>t</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>𝐱</mi><mo stretchy="false">)</mo></mrow></mrow></mrow></mfrac></mstyle><mo>&lt;</mo><mstyle displaystyle="true"><mfrac><mrow><mi>ν</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>λ</mi><mo>,</mo><mi>ρ</mi><mo>,</mo><mi>𝐦</mi><mo stretchy="false">)</mo></mrow></mrow><mn>4</mn></mfrac></mstyle></mrow><mo>)</mo></mrow></mrow></mrow><annotation encoding="application/x-tex">\displaystyle=\mathbb{P}\left(\frac{\|\sum_{t\in\mathcal{T}}U_{t}(\mathbf{x})P_{\bm{\theta}(\mathbf{x})}\mathbf{f}(\bm{\xi}_{t+1})\|_{2}}{\sum_{t\in\mathcal{T}}U_{t}(\mathbf{x})}&lt;\frac{\nu(\lambda,\rho,\mathbf{m})}{4}\right)</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
<tbody id="A6.Ex422"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_eqn_cell"></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A6.Ex422.m1" class="ltx_Math" alttext="\displaystyle\leq\mathbb{P}\left(\frac{1}{|\mathcal{T}|}\sum_{t\in\mathcal{T}}U_{t}(\mathbf{x})\geq 2\mathbb{E}\big[U_{0}(\mathbf{x})\big]\right)+\mathbb{P}\left(\frac{1}{|\mathcal{T}|}\Big\|\sum_{t\in\mathcal{T}}U_{t}(\mathbf{x})P_{\bm{\theta}(\mathbf{x})}\mathbf{f}(\bm{\xi}_{t+1})\Big\|_{2}&lt;\frac{\nu(\lambda,\rho,\mathbf{m})}{2}\mathbb{E}\big[U_{0}(\mathbf{x})\big]\right)" display="inline" intent=":literal"><semantics><mrow><mphantom></mphantom><mo>≤</mo><mrow><mrow><mi>ℙ</mi><mo>⁡</mo><mrow><mo>(</mo><mrow><mrow><mstyle displaystyle="true"><mfrac><mn>1</mn><mrow><mo stretchy="false">|</mo><mi class="ltx_font_mathcaligraphic">𝒯</mi><mo stretchy="false">|</mo></mrow></mfrac></mstyle><mo lspace="0em" rspace="0em">​</mo><mrow><mstyle displaystyle="true"><munder><mo movablelimits="false">∑</mo><mrow><mi>t</mi><mo>∈</mo><mi class="ltx_font_mathcaligraphic">𝒯</mi></mrow></munder></mstyle><mrow><msub><mi>U</mi><mi>t</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>𝐱</mi><mo stretchy="false">)</mo></mrow></mrow></mrow></mrow><mo>≥</mo><mrow><mn>2</mn><mo lspace="0em" rspace="0em">​</mo><mi>𝔼</mi><mo lspace="0em" rspace="0em">​</mo><mrow><mo maxsize="1.200em" minsize="1.200em">[</mo><mrow><msub><mi>U</mi><mn>0</mn></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>𝐱</mi><mo stretchy="false">)</mo></mrow></mrow><mo maxsize="1.200em" minsize="1.200em">]</mo></mrow></mrow></mrow><mo>)</mo></mrow></mrow><mo>+</mo><mrow><mi>ℙ</mi><mo>⁡</mo><mrow><mo>(</mo><mrow><mrow><mstyle displaystyle="true"><mfrac><mn>1</mn><mrow><mo stretchy="false">|</mo><mi class="ltx_font_mathcaligraphic">𝒯</mi><mo stretchy="false">|</mo></mrow></mfrac></mstyle><mo lspace="0em" rspace="0em">​</mo><msub><mrow><mo maxsize="1.600em" minsize="1.600em" stretchy="true">‖</mo><mrow><mstyle displaystyle="true"><munder><mo movablelimits="false">∑</mo><mrow><mi>t</mi><mo>∈</mo><mi class="ltx_font_mathcaligraphic">𝒯</mi></mrow></munder></mstyle><mrow><msub><mi>U</mi><mi>t</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>𝐱</mi><mo stretchy="false">)</mo></mrow><mo lspace="0em" rspace="0em">​</mo><msub><mi>P</mi><mrow><mi>𝜽</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>𝐱</mi><mo stretchy="false">)</mo></mrow></mrow></msub><mo lspace="0em" rspace="0em">​</mo><mi>𝐟</mi><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mi>𝝃</mi><mrow><mi>t</mi><mo>+</mo><mn>1</mn></mrow></msub><mo stretchy="false">)</mo></mrow></mrow></mrow><mo maxsize="1.600em" minsize="1.600em" stretchy="true">‖</mo></mrow><mn>2</mn></msub></mrow><mo>&lt;</mo><mrow><mstyle displaystyle="true"><mfrac><mrow><mi>ν</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>λ</mi><mo>,</mo><mi>ρ</mi><mo>,</mo><mi>𝐦</mi><mo stretchy="false">)</mo></mrow></mrow><mn>2</mn></mfrac></mstyle><mo lspace="0em" rspace="0em">​</mo><mi>𝔼</mi><mo lspace="0em" rspace="0em">​</mo><mrow><mo maxsize="1.200em" minsize="1.200em">[</mo><mrow><msub><mi>U</mi><mn>0</mn></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>𝐱</mi><mo stretchy="false">)</mo></mrow></mrow><mo maxsize="1.200em" minsize="1.200em">]</mo></mrow></mrow></mrow><mo>)</mo></mrow></mrow></mrow></mrow><annotation encoding="application/x-tex">\displaystyle\leq\mathbb{P}\left(\frac{1}{|\mathcal{T}|}\sum_{t\in\mathcal{T}}U_{t}(\mathbf{x})\geq 2\mathbb{E}\big[U_{0}(\mathbf{x})\big]\right)+\mathbb{P}\left(\frac{1}{|\mathcal{T}|}\Big\|\sum_{t\in\mathcal{T}}U_{t}(\mathbf{x})P_{\bm{\theta}(\mathbf{x})}\mathbf{f}(\bm{\xi}_{t+1})\Big\|_{2}&lt;\frac{\nu(\lambda,\rho,\mathbf{m})}{2}\mathbb{E}\big[U_{0}(\mathbf{x})\big]\right)</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
<tbody id="A6.Ex423"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_eqn_cell"></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A6.Ex423.m1" class="ltx_Math" alttext="\displaystyle\leq\mathbb{P}\left(\frac{1}{|\mathcal{T}|}\sum_{t\in\mathcal{T}}U_{t}(\mathbf{x})\geq 2\mathbb{E}\big[U_{0}(\mathbf{x})\big]\right)" display="inline" intent=":literal"><semantics><mrow><mphantom></mphantom><mo>≤</mo><mrow><mi>ℙ</mi><mo>⁡</mo><mrow><mo>(</mo><mrow><mrow><mstyle displaystyle="true"><mfrac><mn>1</mn><mrow><mo stretchy="false">|</mo><mi class="ltx_font_mathcaligraphic">𝒯</mi><mo stretchy="false">|</mo></mrow></mfrac></mstyle><mo lspace="0em" rspace="0em">​</mo><mrow><mstyle displaystyle="true"><munder><mo movablelimits="false">∑</mo><mrow><mi>t</mi><mo>∈</mo><mi class="ltx_font_mathcaligraphic">𝒯</mi></mrow></munder></mstyle><mrow><msub><mi>U</mi><mi>t</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>𝐱</mi><mo stretchy="false">)</mo></mrow></mrow></mrow></mrow><mo>≥</mo><mrow><mn>2</mn><mo lspace="0em" rspace="0em">​</mo><mi>𝔼</mi><mo lspace="0em" rspace="0em">​</mo><mrow><mo maxsize="1.200em" minsize="1.200em">[</mo><mrow><msub><mi>U</mi><mn>0</mn></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>𝐱</mi><mo stretchy="false">)</mo></mrow></mrow><mo maxsize="1.200em" minsize="1.200em">]</mo></mrow></mrow></mrow><mo>)</mo></mrow></mrow></mrow><annotation encoding="application/x-tex">\displaystyle\leq\mathbb{P}\left(\frac{1}{|\mathcal{T}|}\sum_{t\in\mathcal{T}}U_{t}(\mathbf{x})\geq 2\mathbb{E}\big[U_{0}(\mathbf{x})\big]\right)</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
<tbody id="A6.E114"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_eqn_cell"></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A6.E114.m1" class="ltx_Math" alttext="\displaystyle\quad+\mathbb{P}\left(\frac{1}{|\mathcal{T}|}\Big\|\sum_{t\in\mathcal{T}}U_{t}(\mathbf{x})P_{\bm{\theta}(\mathbf{x})}\mathbf{f}(\bm{\xi}_{t+1})\Big\|_{2}&lt;\frac{1}{2}\Big\|\mathbb{E}\left[U_{0}(\mathbf{x})P_{\bm{\theta}(\mathbf{x})}\mathbf{m}(\bm{\xi}_{0})\right]\Big\|_{2}\right)," display="inline" intent=":literal"><semantics><mrow><mrow><mo>+</mo><mrow><mi>ℙ</mi><mo>⁡</mo><mrow><mo>(</mo><mrow><mrow><mstyle displaystyle="true"><mfrac><mn>1</mn><mrow><mo stretchy="false">|</mo><mi class="ltx_font_mathcaligraphic">𝒯</mi><mo stretchy="false">|</mo></mrow></mfrac></mstyle><mo lspace="0em" rspace="0em">​</mo><msub><mrow><mo maxsize="1.600em" minsize="1.600em" stretchy="true">‖</mo><mrow><mstyle displaystyle="true"><munder><mo movablelimits="false">∑</mo><mrow><mi>t</mi><mo>∈</mo><mi class="ltx_font_mathcaligraphic">𝒯</mi></mrow></munder></mstyle><mrow><msub><mi>U</mi><mi>t</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>𝐱</mi><mo stretchy="false">)</mo></mrow><mo lspace="0em" rspace="0em">​</mo><msub><mi>P</mi><mrow><mi>𝜽</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>𝐱</mi><mo stretchy="false">)</mo></mrow></mrow></msub><mo lspace="0em" rspace="0em">​</mo><mi>𝐟</mi><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mi>𝝃</mi><mrow><mi>t</mi><mo>+</mo><mn>1</mn></mrow></msub><mo stretchy="false">)</mo></mrow></mrow></mrow><mo maxsize="1.600em" minsize="1.600em" stretchy="true">‖</mo></mrow><mn>2</mn></msub></mrow><mo>&lt;</mo><mrow><mstyle displaystyle="true"><mfrac><mn>1</mn><mn>2</mn></mfrac></mstyle><mo lspace="0em" rspace="0em">​</mo><msub><mrow><mo maxsize="1.600em" minsize="1.600em" stretchy="true">‖</mo><mrow><mi>𝔼</mi><mo>⁡</mo><mrow><mo>[</mo><mrow><msub><mi>U</mi><mn>0</mn></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>𝐱</mi><mo stretchy="false">)</mo></mrow><mo lspace="0em" rspace="0em">​</mo><msub><mi>P</mi><mrow><mi>𝜽</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>𝐱</mi><mo stretchy="false">)</mo></mrow></mrow></msub><mo lspace="0em" rspace="0em">​</mo><mi>𝐦</mi><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mi>𝝃</mi><mn>0</mn></msub><mo stretchy="false">)</mo></mrow></mrow><mo>]</mo></mrow></mrow><mo maxsize="1.600em" minsize="1.600em" stretchy="true">‖</mo></mrow><mn>2</mn></msub></mrow></mrow><mo>)</mo></mrow></mrow></mrow><mo>,</mo></mrow><annotation encoding="application/x-tex">\displaystyle\quad+\mathbb{P}\left(\frac{1}{|\mathcal{T}|}\Big\|\sum_{t\in\mathcal{T}}U_{t}(\mathbf{x})P_{\bm{\theta}(\mathbf{x})}\mathbf{f}(\bm{\xi}_{t+1})\Big\|_{2}&lt;\frac{1}{2}\Big\|\mathbb{E}\left[U_{0}(\mathbf{x})P_{\bm{\theta}(\mathbf{x})}\mathbf{m}(\bm{\xi}_{0})\right]\Big\|_{2}\right),</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td>
<td rowspan="1" class="ltx_eqn_cell ltx_eqn_eqno ltx_align_middle ltx_align_right"><span class="ltx_tag ltx_tag_equation ltx_align_right">(114)</span></td></tr></tbody>
</table>
<p id="A6.SS3.p2.6" class="ltx_p"><span id="A6.SS3.p2.6.1" class="ltx_text">where we used the definition of <math id="A6.SS3.p2.m5" class="ltx_Math" alttext="\nu(\lambda,\rho,\mathbf{m})" display="inline" intent=":literal"><semantics><mrow><mi>ν</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>λ</mi><mo>,</mo><mi>ρ</mi><mo>,</mo><mi>𝐦</mi><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">\nu(\lambda,\rho,\mathbf{m})</annotation></semantics></math> in the last step.
The first term can be bounded similarly to (<a href="#A6.E108" title="In Proof. ‣ F.3 Proof of Lemma ‣ Appendix F Directional Convergence of the Nadaraya–Watson Estimator ‣ Generalization Bounds for Transformer-Based Next-Token Prediction in a Language Model" class="ltx_ref"><span class="ltx_text ltx_ref_tag">108</span></a>) by</span></p>
<table id="A6.EGx180" class="ltx_equationgroup ltx_eqn_align ltx_eqn_table">

<tbody id="A6.E115"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_align_right ltx_eqn_cell"><math id="A6.E115.m1" class="ltx_Math" alttext="\displaystyle\mathbb{P}\left(\frac{1}{|\mathcal{T}|}\sum_{t\in\mathcal{T}}U_{t}(\mathbf{x})\geq 2\mathbb{E}\big[U_{0}(\mathbf{x})\big]\right)\leq\frac{4}{\gamma_{\mathrm{ps}}(\mathbf{M})|\mathcal{T}|\mathbb{E}\big[U_{0}(\mathbf{x})\big]}." display="inline" intent=":literal"><semantics><mrow><mrow><mrow><mi>ℙ</mi><mo>⁡</mo><mrow><mo>(</mo><mrow><mrow><mstyle displaystyle="true"><mfrac><mn>1</mn><mrow><mo stretchy="false">|</mo><mi class="ltx_font_mathcaligraphic">𝒯</mi><mo stretchy="false">|</mo></mrow></mfrac></mstyle><mo lspace="0em" rspace="0em">​</mo><mrow><mstyle displaystyle="true"><munder><mo movablelimits="false">∑</mo><mrow><mi>t</mi><mo>∈</mo><mi class="ltx_font_mathcaligraphic">𝒯</mi></mrow></munder></mstyle><mrow><msub><mi>U</mi><mi>t</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>𝐱</mi><mo stretchy="false">)</mo></mrow></mrow></mrow></mrow><mo>≥</mo><mrow><mn>2</mn><mo lspace="0em" rspace="0em">​</mo><mi>𝔼</mi><mo lspace="0em" rspace="0em">​</mo><mrow><mo maxsize="1.200em" minsize="1.200em">[</mo><mrow><msub><mi>U</mi><mn>0</mn></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>𝐱</mi><mo stretchy="false">)</mo></mrow></mrow><mo maxsize="1.200em" minsize="1.200em">]</mo></mrow></mrow></mrow><mo>)</mo></mrow></mrow><mo>≤</mo><mstyle displaystyle="true"><mfrac><mn>4</mn><mrow><msub><mi>γ</mi><mi>ps</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>𝐌</mi><mo stretchy="false">)</mo></mrow><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">|</mo><mi class="ltx_font_mathcaligraphic">𝒯</mi><mo stretchy="false">|</mo></mrow><mo lspace="0em" rspace="0em">​</mo><mi>𝔼</mi><mo lspace="0em" rspace="0em">​</mo><mrow><mo maxsize="1.200em" minsize="1.200em">[</mo><mrow><msub><mi>U</mi><mn>0</mn></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>𝐱</mi><mo stretchy="false">)</mo></mrow></mrow><mo maxsize="1.200em" minsize="1.200em">]</mo></mrow></mrow></mfrac></mstyle></mrow><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">\displaystyle\mathbb{P}\left(\frac{1}{|\mathcal{T}|}\sum_{t\in\mathcal{T}}U_{t}(\mathbf{x})\geq 2\mathbb{E}\big[U_{0}(\mathbf{x})\big]\right)\leq\frac{4}{\gamma_{\mathrm{ps}}(\mathbf{M})|\mathcal{T}|\mathbb{E}\big[U_{0}(\mathbf{x})\big]}.</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td>
<td rowspan="1" class="ltx_eqn_cell ltx_eqn_eqno ltx_align_middle ltx_align_right"><span class="ltx_tag ltx_tag_equation ltx_align_right">(115)</span></td></tr></tbody>
</table>
<p id="A6.SS3.p2.7" class="ltx_p"><span id="A6.SS3.p2.7.1" class="ltx_text">Furthermore, since <math id="A6.SS3.p2.m6" class="ltx_Math" alttext="\|\mathbf{u}\|_{2}&lt;\tfrac{1}{2}\|\mathbf{v}\|_{2}" display="inline" intent=":literal"><semantics><mrow><msub><mrow><mo stretchy="false">‖</mo><mi>𝐮</mi><mo stretchy="false">‖</mo></mrow><mn>2</mn></msub><mo>&lt;</mo><mrow><mfrac><mn>1</mn><mn>2</mn></mfrac><mo lspace="0em" rspace="0em">​</mo><msub><mrow><mo stretchy="false">‖</mo><mi>𝐯</mi><mo stretchy="false">‖</mo></mrow><mn>2</mn></msub></mrow></mrow><annotation encoding="application/x-tex">\|\mathbf{u}\|_{2}&lt;\tfrac{1}{2}\|\mathbf{v}\|_{2}</annotation></semantics></math> implies that <math id="A6.SS3.p2.m7" class="ltx_Math" alttext="\|\mathbf{u}-\mathbf{v}\|_{2}&gt;\tfrac{1}{2}\|\mathbf{v}\|_{2}" display="inline" intent=":literal"><semantics><mrow><msub><mrow><mo stretchy="false">‖</mo><mrow><mi>𝐮</mi><mo>−</mo><mi>𝐯</mi></mrow><mo stretchy="false">‖</mo></mrow><mn>2</mn></msub><mo>&gt;</mo><mrow><mfrac><mn>1</mn><mn>2</mn></mfrac><mo lspace="0em" rspace="0em">​</mo><msub><mrow><mo stretchy="false">‖</mo><mi>𝐯</mi><mo stretchy="false">‖</mo></mrow><mn>2</mn></msub></mrow></mrow><annotation encoding="application/x-tex">\|\mathbf{u}-\mathbf{v}\|_{2}&gt;\tfrac{1}{2}\|\mathbf{v}\|_{2}</annotation></semantics></math>, we obtain for the second term</span></p>
<table id="A6.EGx181" class="ltx_equationgroup ltx_eqn_align ltx_eqn_table">

<tbody id="A6.Ex424"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_eqn_cell"></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A6.Ex424.m1" class="ltx_Math" alttext="\displaystyle\mathbb{P}\bigg(\frac{1}{|\mathcal{T}|}\Big\|\sum_{t\in\mathcal{T}}U_{t}(\mathbf{x})P_{\bm{\theta}(\mathbf{x})}\mathbf{f}(\bm{\xi}_{t+1})\Big\|_{2}&lt;\frac{1}{2}\Big\|\mathbb{E}\left[U_{0}(\mathbf{x})P_{\bm{\theta}(\mathbf{x})}\mathbf{m}(\bm{\xi}_{0})\right]\Big\|_{2}\bigg)" display="inline" intent=":literal"><semantics><mrow><mi>ℙ</mi><mo>⁡</mo><mrow><mo maxsize="2.100em" minsize="2.100em">(</mo><mrow><mrow><mstyle displaystyle="true"><mfrac><mn>1</mn><mrow><mo stretchy="false">|</mo><mi class="ltx_font_mathcaligraphic">𝒯</mi><mo stretchy="false">|</mo></mrow></mfrac></mstyle><mo lspace="0em" rspace="0em">​</mo><msub><mrow><mo maxsize="1.600em" minsize="1.600em" stretchy="true">‖</mo><mrow><mstyle displaystyle="true"><munder><mo movablelimits="false">∑</mo><mrow><mi>t</mi><mo>∈</mo><mi class="ltx_font_mathcaligraphic">𝒯</mi></mrow></munder></mstyle><mrow><msub><mi>U</mi><mi>t</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>𝐱</mi><mo stretchy="false">)</mo></mrow><mo lspace="0em" rspace="0em">​</mo><msub><mi>P</mi><mrow><mi>𝜽</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>𝐱</mi><mo stretchy="false">)</mo></mrow></mrow></msub><mo lspace="0em" rspace="0em">​</mo><mi>𝐟</mi><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mi>𝝃</mi><mrow><mi>t</mi><mo>+</mo><mn>1</mn></mrow></msub><mo stretchy="false">)</mo></mrow></mrow></mrow><mo maxsize="1.600em" minsize="1.600em" stretchy="true">‖</mo></mrow><mn>2</mn></msub></mrow><mo>&lt;</mo><mrow><mstyle displaystyle="true"><mfrac><mn>1</mn><mn>2</mn></mfrac></mstyle><mo lspace="0em" rspace="0em">​</mo><msub><mrow><mo maxsize="1.600em" minsize="1.600em" stretchy="true">‖</mo><mrow><mi>𝔼</mi><mo>⁡</mo><mrow><mo>[</mo><mrow><msub><mi>U</mi><mn>0</mn></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>𝐱</mi><mo stretchy="false">)</mo></mrow><mo lspace="0em" rspace="0em">​</mo><msub><mi>P</mi><mrow><mi>𝜽</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>𝐱</mi><mo stretchy="false">)</mo></mrow></mrow></msub><mo lspace="0em" rspace="0em">​</mo><mi>𝐦</mi><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mi>𝝃</mi><mn>0</mn></msub><mo stretchy="false">)</mo></mrow></mrow><mo>]</mo></mrow></mrow><mo maxsize="1.600em" minsize="1.600em" stretchy="true">‖</mo></mrow><mn>2</mn></msub></mrow></mrow><mo maxsize="2.100em" minsize="2.100em">)</mo></mrow></mrow><annotation encoding="application/x-tex">\displaystyle\mathbb{P}\bigg(\frac{1}{|\mathcal{T}|}\Big\|\sum_{t\in\mathcal{T}}U_{t}(\mathbf{x})P_{\bm{\theta}(\mathbf{x})}\mathbf{f}(\bm{\xi}_{t+1})\Big\|_{2}&lt;\frac{1}{2}\Big\|\mathbb{E}\left[U_{0}(\mathbf{x})P_{\bm{\theta}(\mathbf{x})}\mathbf{m}(\bm{\xi}_{0})\right]\Big\|_{2}\bigg)</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
<tbody id="A6.Ex425"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_eqn_cell"></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A6.Ex425.m1" class="ltx_Math" alttext="\displaystyle\leq\mathbb{P}\bigg(\bigg\|\sum_{t\in\mathcal{T}}U_{t}(\mathbf{x})P_{\bm{\theta}(\mathbf{x})}\mathbf{f}(\bm{\xi}_{t+1})-|\mathcal{T}|\mathbb{E}\left[U_{0}(\mathbf{x})P_{\bm{\theta}(\mathbf{x})}\mathbf{m}(\bm{\xi}_{0})\right]\bigg\|_{2}&gt;\frac{|\mathcal{T}|}{2}\Big\|\mathbb{E}\left[U_{0}(\mathbf{x})P_{\bm{\theta}(\mathbf{x})}\mathbf{m}(\bm{\xi}_{0})\right]\Big\|_{2}\bigg)" display="inline" intent=":literal"><semantics><mrow><mphantom></mphantom><mo>≤</mo><mrow><mi>ℙ</mi><mo>⁡</mo><mrow><mo maxsize="2.100em" minsize="2.100em">(</mo><mrow><msub><mrow><mo maxsize="2.100em" minsize="2.100em" stretchy="true">‖</mo><mrow><mrow><mstyle displaystyle="true"><munder><mo movablelimits="false">∑</mo><mrow><mi>t</mi><mo>∈</mo><mi class="ltx_font_mathcaligraphic">𝒯</mi></mrow></munder></mstyle><mrow><msub><mi>U</mi><mi>t</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>𝐱</mi><mo stretchy="false">)</mo></mrow><mo lspace="0em" rspace="0em">​</mo><msub><mi>P</mi><mrow><mi>𝜽</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>𝐱</mi><mo stretchy="false">)</mo></mrow></mrow></msub><mo lspace="0em" rspace="0em">​</mo><mi>𝐟</mi><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mi>𝝃</mi><mrow><mi>t</mi><mo>+</mo><mn>1</mn></mrow></msub><mo stretchy="false">)</mo></mrow></mrow></mrow><mo>−</mo><mrow><mrow><mo stretchy="false">|</mo><mi class="ltx_font_mathcaligraphic">𝒯</mi><mo stretchy="false">|</mo></mrow><mo lspace="0em" rspace="0em">​</mo><mi>𝔼</mi><mo lspace="0em" rspace="0em">​</mo><mrow><mo>[</mo><mrow><msub><mi>U</mi><mn>0</mn></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>𝐱</mi><mo stretchy="false">)</mo></mrow><mo lspace="0em" rspace="0em">​</mo><msub><mi>P</mi><mrow><mi>𝜽</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>𝐱</mi><mo stretchy="false">)</mo></mrow></mrow></msub><mo lspace="0em" rspace="0em">​</mo><mi>𝐦</mi><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mi>𝝃</mi><mn>0</mn></msub><mo stretchy="false">)</mo></mrow></mrow><mo>]</mo></mrow></mrow></mrow><mo maxsize="2.100em" minsize="2.100em" stretchy="true">‖</mo></mrow><mn>2</mn></msub><mo>&gt;</mo><mrow><mstyle displaystyle="true"><mfrac><mrow><mo stretchy="false">|</mo><mi class="ltx_font_mathcaligraphic">𝒯</mi><mo stretchy="false">|</mo></mrow><mn>2</mn></mfrac></mstyle><mo lspace="0em" rspace="0em">​</mo><msub><mrow><mo maxsize="1.600em" minsize="1.600em" stretchy="true">‖</mo><mrow><mi>𝔼</mi><mo>⁡</mo><mrow><mo>[</mo><mrow><msub><mi>U</mi><mn>0</mn></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>𝐱</mi><mo stretchy="false">)</mo></mrow><mo lspace="0em" rspace="0em">​</mo><msub><mi>P</mi><mrow><mi>𝜽</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>𝐱</mi><mo stretchy="false">)</mo></mrow></mrow></msub><mo lspace="0em" rspace="0em">​</mo><mi>𝐦</mi><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mi>𝝃</mi><mn>0</mn></msub><mo stretchy="false">)</mo></mrow></mrow><mo>]</mo></mrow></mrow><mo maxsize="1.600em" minsize="1.600em" stretchy="true">‖</mo></mrow><mn>2</mn></msub></mrow></mrow><mo maxsize="2.100em" minsize="2.100em">)</mo></mrow></mrow></mrow><annotation encoding="application/x-tex">\displaystyle\leq\mathbb{P}\bigg(\bigg\|\sum_{t\in\mathcal{T}}U_{t}(\mathbf{x})P_{\bm{\theta}(\mathbf{x})}\mathbf{f}(\bm{\xi}_{t+1})-|\mathcal{T}|\mathbb{E}\left[U_{0}(\mathbf{x})P_{\bm{\theta}(\mathbf{x})}\mathbf{m}(\bm{\xi}_{0})\right]\bigg\|_{2}&gt;\frac{|\mathcal{T}|}{2}\Big\|\mathbb{E}\left[U_{0}(\mathbf{x})P_{\bm{\theta}(\mathbf{x})}\mathbf{m}(\bm{\xi}_{0})\right]\Big\|_{2}\bigg)</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
<tbody id="A6.Ex426"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_eqn_cell"></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A6.Ex426.m1" class="ltx_Math" alttext="\displaystyle\leq\frac{4}{\big\|\mathbb{E}\left[U_{0}(\mathbf{x})P_{\bm{\theta}(\mathbf{x})}\mathbf{m}(\bm{\xi}_{0})\right]\big\|_{2}^{2}|\mathcal{T}|^{2}}\mathbb{E}\left[\Big\|\sum_{t\in\mathcal{T}}U_{t}(\mathbf{x})\mathbf{f}(\bm{\xi}_{t+1})-|\mathcal{T}|\mathbb{E}\left[U_{0}(\mathbf{x})\mathbf{f}(\bm{\xi}_{1})\right]\bigg\|_{2}^{2}\right]" display="inline" intent=":literal"><semantics><mrow><mphantom></mphantom><mo>≤</mo><mrow><mstyle displaystyle="true"><mfrac><mn>4</mn><mrow><msubsup><mrow><mo maxsize="1.200em" minsize="1.200em" stretchy="true">‖</mo><mrow><mi>𝔼</mi><mo>⁡</mo><mrow><mo>[</mo><mrow><msub><mi>U</mi><mn>0</mn></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>𝐱</mi><mo stretchy="false">)</mo></mrow><mo lspace="0em" rspace="0em">​</mo><msub><mi>P</mi><mrow><mi>𝜽</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>𝐱</mi><mo stretchy="false">)</mo></mrow></mrow></msub><mo lspace="0em" rspace="0em">​</mo><mi>𝐦</mi><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mi>𝝃</mi><mn>0</mn></msub><mo stretchy="false">)</mo></mrow></mrow><mo>]</mo></mrow></mrow><mo maxsize="1.200em" minsize="1.200em" stretchy="true">‖</mo></mrow><mn>2</mn><mn>2</mn></msubsup><mo lspace="0em" rspace="0em">​</mo><msup><mrow><mo stretchy="false">|</mo><mi class="ltx_font_mathcaligraphic">𝒯</mi><mo stretchy="false">|</mo></mrow><mn>2</mn></msup></mrow></mfrac></mstyle><mo lspace="0em" rspace="0em">​</mo><mi>𝔼</mi><mo lspace="0em" rspace="0em">​</mo><mrow><mo>[</mo><msubsup><mrow><mo maxsize="1.600em" minsize="1.600em" stretchy="true">‖</mo><mrow><mrow><mstyle displaystyle="true"><munder><mo movablelimits="false">∑</mo><mrow><mi>t</mi><mo>∈</mo><mi class="ltx_font_mathcaligraphic">𝒯</mi></mrow></munder></mstyle><mrow><msub><mi>U</mi><mi>t</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>𝐱</mi><mo stretchy="false">)</mo></mrow><mo lspace="0em" rspace="0em">​</mo><mi>𝐟</mi><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mi>𝝃</mi><mrow><mi>t</mi><mo>+</mo><mn>1</mn></mrow></msub><mo stretchy="false">)</mo></mrow></mrow></mrow><mo>−</mo><mrow><mrow><mo stretchy="false">|</mo><mi class="ltx_font_mathcaligraphic">𝒯</mi><mo stretchy="false">|</mo></mrow><mo lspace="0em" rspace="0em">​</mo><mi>𝔼</mi><mo lspace="0em" rspace="0em">​</mo><mrow><mo>[</mo><mrow><msub><mi>U</mi><mn>0</mn></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>𝐱</mi><mo stretchy="false">)</mo></mrow><mo lspace="0em" rspace="0em">​</mo><mi>𝐟</mi><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mi>𝝃</mi><mn>1</mn></msub><mo stretchy="false">)</mo></mrow></mrow><mo>]</mo></mrow></mrow></mrow><mo maxsize="2.100em" minsize="2.100em" stretchy="true">‖</mo></mrow><mn>2</mn><mn>2</mn></msubsup><mo>]</mo></mrow></mrow></mrow><annotation encoding="application/x-tex">\displaystyle\leq\frac{4}{\big\|\mathbb{E}\left[U_{0}(\mathbf{x})P_{\bm{\theta}(\mathbf{x})}\mathbf{m}(\bm{\xi}_{0})\right]\big\|_{2}^{2}|\mathcal{T}|^{2}}\mathbb{E}\left[\Big\|\sum_{t\in\mathcal{T}}U_{t}(\mathbf{x})\mathbf{f}(\bm{\xi}_{t+1})-|\mathcal{T}|\mathbb{E}\left[U_{0}(\mathbf{x})\mathbf{f}(\bm{\xi}_{1})\right]\bigg\|_{2}^{2}\right]</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
<tbody id="A6.Ex427"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_eqn_cell"></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A6.Ex427.m1" class="ltx_Math" alttext="\displaystyle\leq\frac{4}{\big\|\mathbb{E}\left[U_{0}(\mathbf{x})P_{\bm{\theta}(\mathbf{x})}\mathbf{m}(\bm{\xi}_{0})\right]\big\|_{2}^{2}|\mathcal{T}|^{2}}\,\frac{4\|\mathbf{f}\|_{\infty}^{2}|\mathcal{T}|}{\gamma_{\mathrm{ps}}(\mathbf{M})}\mathbb{E}\left[U_{0}(\mathbf{x})\right]" display="inline" intent=":literal"><semantics><mrow><mphantom></mphantom><mo>≤</mo><mrow><mstyle displaystyle="true"><mfrac><mn>4</mn><mrow><msubsup><mrow><mo maxsize="1.200em" minsize="1.200em" stretchy="true">‖</mo><mrow><mi>𝔼</mi><mo>⁡</mo><mrow><mo>[</mo><mrow><msub><mi>U</mi><mn>0</mn></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>𝐱</mi><mo stretchy="false">)</mo></mrow><mo lspace="0em" rspace="0em">​</mo><msub><mi>P</mi><mrow><mi>𝜽</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>𝐱</mi><mo stretchy="false">)</mo></mrow></mrow></msub><mo lspace="0em" rspace="0em">​</mo><mi>𝐦</mi><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mi>𝝃</mi><mn>0</mn></msub><mo stretchy="false">)</mo></mrow></mrow><mo>]</mo></mrow></mrow><mo maxsize="1.200em" minsize="1.200em" stretchy="true">‖</mo></mrow><mn>2</mn><mn>2</mn></msubsup><mo lspace="0em" rspace="0em">​</mo><msup><mrow><mo stretchy="false">|</mo><mi class="ltx_font_mathcaligraphic">𝒯</mi><mo stretchy="false">|</mo></mrow><mn>2</mn></msup></mrow></mfrac></mstyle><mo lspace="0.170em" rspace="0em">​</mo><mstyle displaystyle="true"><mfrac><mrow><mn>4</mn><mo lspace="0em" rspace="0em">​</mo><msubsup><mrow><mo stretchy="false">‖</mo><mi>𝐟</mi><mo stretchy="false">‖</mo></mrow><mi mathvariant="normal">∞</mi><mn>2</mn></msubsup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">|</mo><mi class="ltx_font_mathcaligraphic">𝒯</mi><mo stretchy="false">|</mo></mrow></mrow><mrow><msub><mi>γ</mi><mi>ps</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>𝐌</mi><mo stretchy="false">)</mo></mrow></mrow></mfrac></mstyle><mo lspace="0em" rspace="0em">​</mo><mi>𝔼</mi><mo lspace="0em" rspace="0em">​</mo><mrow><mo>[</mo><mrow><msub><mi>U</mi><mn>0</mn></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>𝐱</mi><mo stretchy="false">)</mo></mrow></mrow><mo>]</mo></mrow></mrow></mrow><annotation encoding="application/x-tex">\displaystyle\leq\frac{4}{\big\|\mathbb{E}\left[U_{0}(\mathbf{x})P_{\bm{\theta}(\mathbf{x})}\mathbf{m}(\bm{\xi}_{0})\right]\big\|_{2}^{2}|\mathcal{T}|^{2}}\,\frac{4\|\mathbf{f}\|_{\infty}^{2}|\mathcal{T}|}{\gamma_{\mathrm{ps}}(\mathbf{M})}\mathbb{E}\left[U_{0}(\mathbf{x})\right]</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
<tbody id="A6.Ex428"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_eqn_cell"></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A6.Ex428.m1" class="ltx_Math" alttext="\displaystyle=\frac{16\|\mathbf{f}\|_{\infty}^{2}}{\gamma_{\mathrm{ps}}(\mathbf{M})|\mathcal{T}|}\,\frac{\mathbb{E}\big[U_{0}(\mathbf{x})\big]}{\big\|\mathbb{E}\left[U_{0}(\mathbf{x})P_{\bm{\theta}(\mathbf{x})}\mathbf{m}(\bm{\xi}_{0})\right]\big\|_{2}^{2}}" display="inline" intent=":literal"><semantics><mrow><mphantom></mphantom><mo>=</mo><mrow><mstyle displaystyle="true"><mfrac><mrow><mn>16</mn><mo lspace="0em" rspace="0em">​</mo><msubsup><mrow><mo stretchy="false">‖</mo><mi>𝐟</mi><mo stretchy="false">‖</mo></mrow><mi mathvariant="normal">∞</mi><mn>2</mn></msubsup></mrow><mrow><msub><mi>γ</mi><mi>ps</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>𝐌</mi><mo stretchy="false">)</mo></mrow><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">|</mo><mi class="ltx_font_mathcaligraphic">𝒯</mi><mo stretchy="false">|</mo></mrow></mrow></mfrac></mstyle><mo lspace="0.170em" rspace="0em">​</mo><mstyle displaystyle="true"><mfrac><mrow><mi>𝔼</mi><mo lspace="0em" rspace="0em">​</mo><mrow><mo maxsize="1.200em" minsize="1.200em">[</mo><mrow><msub><mi>U</mi><mn>0</mn></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>𝐱</mi><mo stretchy="false">)</mo></mrow></mrow><mo maxsize="1.200em" minsize="1.200em">]</mo></mrow></mrow><msubsup><mrow><mo maxsize="1.200em" minsize="1.200em" stretchy="true">‖</mo><mrow><mi>𝔼</mi><mo>⁡</mo><mrow><mo>[</mo><mrow><msub><mi>U</mi><mn>0</mn></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>𝐱</mi><mo stretchy="false">)</mo></mrow><mo lspace="0em" rspace="0em">​</mo><msub><mi>P</mi><mrow><mi>𝜽</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>𝐱</mi><mo stretchy="false">)</mo></mrow></mrow></msub><mo lspace="0em" rspace="0em">​</mo><mi>𝐦</mi><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mi>𝝃</mi><mn>0</mn></msub><mo stretchy="false">)</mo></mrow></mrow><mo>]</mo></mrow></mrow><mo maxsize="1.200em" minsize="1.200em" stretchy="true">‖</mo></mrow><mn>2</mn><mn>2</mn></msubsup></mfrac></mstyle></mrow></mrow><annotation encoding="application/x-tex">\displaystyle=\frac{16\|\mathbf{f}\|_{\infty}^{2}}{\gamma_{\mathrm{ps}}(\mathbf{M})|\mathcal{T}|}\,\frac{\mathbb{E}\big[U_{0}(\mathbf{x})\big]}{\big\|\mathbb{E}\left[U_{0}(\mathbf{x})P_{\bm{\theta}(\mathbf{x})}\mathbf{m}(\bm{\xi}_{0})\right]\big\|_{2}^{2}}</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="A6.SS3.p2.8" class="ltx_p"><span id="A6.SS3.p2.8.1" class="ltx_text">where we use (<a href="#A6.E109" title="In Proof. ‣ F.3 Proof of Lemma ‣ Appendix F Directional Convergence of the Nadaraya–Watson Estimator ‣ Generalization Bounds for Transformer-Based Next-Token Prediction in a Language Model" class="ltx_ref"><span class="ltx_text ltx_ref_tag">109</span></a>) for the last inequality.
Combining this inequality with (<a href="#A6.E112" title="In Proof. ‣ F.3 Proof of Lemma ‣ Appendix F Directional Convergence of the Nadaraya–Watson Estimator ‣ Generalization Bounds for Transformer-Based Next-Token Prediction in a Language Model" class="ltx_ref"><span class="ltx_text ltx_ref_tag">112</span></a>), (<a href="#A6.E113" title="In Proof. ‣ F.3 Proof of Lemma ‣ Appendix F Directional Convergence of the Nadaraya–Watson Estimator ‣ Generalization Bounds for Transformer-Based Next-Token Prediction in a Language Model" class="ltx_ref"><span class="ltx_text ltx_ref_tag">113</span></a>), (<a href="#A6.E114" title="In Proof. ‣ F.3 Proof of Lemma ‣ Appendix F Directional Convergence of the Nadaraya–Watson Estimator ‣ Generalization Bounds for Transformer-Based Next-Token Prediction in a Language Model" class="ltx_ref"><span class="ltx_text ltx_ref_tag">114</span></a>), and (<a href="#A6.E115" title="In Proof. ‣ F.3 Proof of Lemma ‣ Appendix F Directional Convergence of the Nadaraya–Watson Estimator ‣ Generalization Bounds for Transformer-Based Next-Token Prediction in a Language Model" class="ltx_ref"><span class="ltx_text ltx_ref_tag">115</span></a>) yields the second assertion (<a href="#A6.E97" title="In Lemma 29. ‣ F.1 Proof of Lemma ‣ Appendix F Directional Convergence of the Nadaraya–Watson Estimator ‣ Generalization Bounds for Transformer-Based Next-Token Prediction in a Language Model" class="ltx_ref"><span class="ltx_text ltx_ref_tag">97</span></a>).
∎</span></p>
</div>
</div>
</section>
<section id="A6.SS4" class="ltx_subsection">
<h3 class="ltx_title ltx_title_subsection"><span class="ltx_tag ltx_tag_subsection">F.4 </span>Proof of Lemma <a href="#Thmconj230" title="Lemma 30. ‣ Proof of Lemma . ‣ F.1 Proof of Lemma ‣ Appendix F Directional Convergence of the Nadaraya–Watson Estimator ‣ Generalization Bounds for Transformer-Based Next-Token Prediction in a Language Model" class="ltx_ref"><span class="ltx_text ltx_ref_tag">30</span></a></h3>

<div id="A6.SS4.2" class="ltx_proof">
<h6 class="ltx_title ltx_runin ltx_font_italic ltx_title_proof">Proof.</h6>
<div id="A6.SS4.p1" class="ltx_para">
<p id="A6.SS4.p1.1" class="ltx_p"><span id="A6.SS4.p1.1.1" class="ltx_text ltx_font_bold">(i)<span id="A6.SS4.p1.1.1.1" class="ltx_text ltx_font_medium">
Recall that for any <math id="A6.SS4.p1.m1" class="ltx_Math" alttext="\mathbf{x}=(\mathbf{x}_{1},\ldots,\mathbf{x}_{r})\in\mathcal{E}_{W}^{r}" display="inline" intent=":literal"><semantics><mrow><mi>𝐱</mi><mo>=</mo><mrow><mo stretchy="false">(</mo><msub><mi>𝐱</mi><mn>1</mn></msub><mo>,</mo><mi mathvariant="normal">…</mi><mo>,</mo><msub><mi>𝐱</mi><mi>r</mi></msub><mo stretchy="false">)</mo></mrow><mo>∈</mo><msubsup><mi class="ltx_font_mathcaligraphic">ℰ</mi><mi>W</mi><mi>r</mi></msubsup></mrow><annotation encoding="application/x-tex">\mathbf{x}=(\mathbf{x}_{1},\ldots,\mathbf{x}_{r})\in\mathcal{E}_{W}^{r}</annotation></semantics></math>, <math id="A6.SS4.p1.m2" class="ltx_Math" alttext="\mathbf{z}_{1}\coloneqq\operatorname{stack}(\bm{\phi}_{1}(\mathbf{x}_{r-r_{1}+1}),\ldots,\bm{\phi}_{1}(\mathbf{x}_{r}))\in\mathbb{R}^{m_{1}r_{1}}" display="inline" intent=":literal"><semantics><mrow><msub><mi>𝐳</mi><mn>1</mn></msub><mo>≔</mo><mrow><mi>stack</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mrow><msub><mi class="ltx_mathvariant_bold-italic" mathvariant="bold-italic">ϕ</mi><mn>1</mn></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mi>𝐱</mi><mrow><mrow><mi>r</mi><mo>−</mo><msub><mi>r</mi><mn>1</mn></msub></mrow><mo>+</mo><mn>1</mn></mrow></msub><mo stretchy="false">)</mo></mrow></mrow><mo>,</mo><mi mathvariant="normal">…</mi><mo>,</mo><mrow><msub><mi class="ltx_mathvariant_bold-italic" mathvariant="bold-italic">ϕ</mi><mn>1</mn></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mi>𝐱</mi><mi>r</mi></msub><mo stretchy="false">)</mo></mrow></mrow><mo stretchy="false">)</mo></mrow></mrow><mo>∈</mo><msup><mi>ℝ</mi><mrow><msub><mi>m</mi><mn>1</mn></msub><mo lspace="0em" rspace="0em">​</mo><msub><mi>r</mi><mn>1</mn></msub></mrow></msup></mrow><annotation encoding="application/x-tex">\mathbf{z}_{1}\coloneqq\operatorname{stack}(\bm{\phi}_{1}(\mathbf{x}_{r-r_{1}+1}),\ldots,\bm{\phi}_{1}(\mathbf{x}_{r}))\in\mathbb{R}^{m_{1}r_{1}}</annotation></semantics></math> and
<math id="A6.SS4.p1.m3" class="ltx_Math" alttext="\mathbf{z}_{2}\coloneqq\operatorname{stack}(\bm{\phi}_{2}(\mathbf{x}_{r-r_{2}+1}),\ldots,\bm{\phi}_{2}(\mathbf{x}_{r}))\in\mathbb{R}^{m_{2}r_{2}}" display="inline" intent=":literal"><semantics><mrow><msub><mi>𝐳</mi><mn>2</mn></msub><mo>≔</mo><mrow><mi>stack</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mrow><msub><mi class="ltx_mathvariant_bold-italic" mathvariant="bold-italic">ϕ</mi><mn>2</mn></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mi>𝐱</mi><mrow><mrow><mi>r</mi><mo>−</mo><msub><mi>r</mi><mn>2</mn></msub></mrow><mo>+</mo><mn>1</mn></mrow></msub><mo stretchy="false">)</mo></mrow></mrow><mo>,</mo><mi mathvariant="normal">…</mi><mo>,</mo><mrow><msub><mi class="ltx_mathvariant_bold-italic" mathvariant="bold-italic">ϕ</mi><mn>2</mn></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mi>𝐱</mi><mi>r</mi></msub><mo stretchy="false">)</mo></mrow></mrow><mo stretchy="false">)</mo></mrow></mrow><mo>∈</mo><msup><mi>ℝ</mi><mrow><msub><mi>m</mi><mn>2</mn></msub><mo lspace="0em" rspace="0em">​</mo><msub><mi>r</mi><mn>2</mn></msub></mrow></msup></mrow><annotation encoding="application/x-tex">\mathbf{z}_{2}\coloneqq\operatorname{stack}(\bm{\phi}_{2}(\mathbf{x}_{r-r_{2}+1}),\ldots,\bm{\phi}_{2}(\mathbf{x}_{r}))\in\mathbb{R}^{m_{2}r_{2}}</annotation></semantics></math>,</span></span></p>
<table id="A6.EGx182" class="ltx_equationgroup ltx_eqn_align ltx_eqn_table">

<tbody id="A6.Ex429"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_align_right ltx_eqn_cell"><math id="A6.Ex429.m1" class="ltx_Math" alttext="\displaystyle\mathbb{P}\big(\mathbf{X}_{r+1}=\mathbf{e}_{w}\big|\mathbf{h},(\mathbf{X}_{1},\ldots,\mathbf{X}_{r})=(\mathbf{x}_{1},\ldots,\mathbf{x}_{r})\big)\propto\exp\Big(\mathbf{g}_{0}(\mathbf{z}_{1})^{\top}\bm{\phi}_{1}(\mathbf{e}_{w})+\mathbf{h}(\mathbf{z}_{2})^{\top}\bm{\phi}_{2}(\mathbf{e}_{w})\Big),\quad w\in[W]." display="inline" intent=":literal"><semantics><mrow><mrow><mrow><mrow><mi>ℙ</mi><mo>⁡</mo><mrow><mo maxsize="1.200em" minsize="1.200em">(</mo><mrow><msub><mi>𝐗</mi><mrow><mi>r</mi><mo>+</mo><mn>1</mn></mrow></msub><mo>=</mo><msub><mi>𝐞</mi><mi>w</mi></msub></mrow><mo lspace="0em" mathsize="1.200em" rspace="0em">|</mo><mrow><mi>𝐡</mi><mo>,</mo><mrow><mrow><mo stretchy="false">(</mo><msub><mi>𝐗</mi><mn>1</mn></msub><mo>,</mo><mi mathvariant="normal">…</mi><mo>,</mo><msub><mi>𝐗</mi><mi>r</mi></msub><mo stretchy="false">)</mo></mrow><mo>=</mo><mrow><mo stretchy="false">(</mo><msub><mi>𝐱</mi><mn>1</mn></msub><mo>,</mo><mi mathvariant="normal">…</mi><mo>,</mo><msub><mi>𝐱</mi><mi>r</mi></msub><mo stretchy="false">)</mo></mrow></mrow></mrow><mo maxsize="1.200em" minsize="1.200em">)</mo></mrow></mrow><mo>∝</mo><mrow><mi>exp</mi><mo>⁡</mo><mrow><mo maxsize="1.600em" minsize="1.600em">(</mo><mrow><mrow><msub><mi>𝐠</mi><mn>0</mn></msub><mo lspace="0em" rspace="0em">​</mo><msup><mrow><mo stretchy="false">(</mo><msub><mi>𝐳</mi><mn>1</mn></msub><mo stretchy="false">)</mo></mrow><mo>⊤</mo></msup><mo lspace="0em" rspace="0em">​</mo><msub><mi class="ltx_mathvariant_bold-italic" mathvariant="bold-italic">ϕ</mi><mn>1</mn></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mi>𝐞</mi><mi>w</mi></msub><mo stretchy="false">)</mo></mrow></mrow><mo>+</mo><mrow><mi>𝐡</mi><mo lspace="0em" rspace="0em">​</mo><msup><mrow><mo stretchy="false">(</mo><msub><mi>𝐳</mi><mn>2</mn></msub><mo stretchy="false">)</mo></mrow><mo>⊤</mo></msup><mo lspace="0em" rspace="0em">​</mo><msub><mi class="ltx_mathvariant_bold-italic" mathvariant="bold-italic">ϕ</mi><mn>2</mn></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mi>𝐞</mi><mi>w</mi></msub><mo stretchy="false">)</mo></mrow></mrow></mrow><mo maxsize="1.600em" minsize="1.600em">)</mo></mrow></mrow></mrow><mo rspace="1.167em">,</mo><mrow><mi>w</mi><mo>∈</mo><mrow><mo stretchy="false">[</mo><mi>W</mi><mo stretchy="false">]</mo></mrow></mrow></mrow><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">\displaystyle\mathbb{P}\big(\mathbf{X}_{r+1}=\mathbf{e}_{w}\big|\mathbf{h},(\mathbf{X}_{1},\ldots,\mathbf{X}_{r})=(\mathbf{x}_{1},\ldots,\mathbf{x}_{r})\big)\propto\exp\Big(\mathbf{g}_{0}(\mathbf{z}_{1})^{\top}\bm{\phi}_{1}(\mathbf{e}_{w})+\mathbf{h}(\mathbf{z}_{2})^{\top}\bm{\phi}_{2}(\mathbf{e}_{w})\Big),\quad w\in[W].</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="A6.SS4.p1.2" class="ltx_p"><span id="A6.SS4.p1.2.1" class="ltx_text">Hence,</span></p>
<table id="A6.EGx183" class="ltx_equationgroup ltx_eqn_align ltx_eqn_table">

<tbody id="A6.Ex430"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_align_right ltx_eqn_cell"><math id="A6.Ex430.m1" class="ltx_Math" alttext="\displaystyle\mathbf{m}(\mathbf{x})" display="inline" intent=":literal"><semantics><mrow><mi>𝐦</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>𝐱</mi><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">\displaystyle\mathbf{m}(\mathbf{x})</annotation></semantics></math></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A6.Ex430.m2" class="ltx_math_unparsed" alttext="\displaystyle=\mathbb{E}\left[\frac{\bm{\phi}_{2}(\mathbf{X}_{r+1})}{\exp\big(\mathbf{g}_{0}(\mathbf{z}_{1})^{\top}\bm{\phi}_{1}(\mathbf{X}_{r+1})\big)}\middle|\mathbf{h},(\mathbf{X}_{1},\ldots,\mathbf{X}_{r})=(\mathbf{x}_{1},\ldots,\mathbf{x}_{r})\right]\quad" display="inline" intent=":literal"><semantics><mrow><mo>=</mo><mi>𝔼</mi><mrow><mo>[</mo><mstyle displaystyle="true"><mfrac><mrow><msub><mi class="ltx_mathvariant_bold-italic" mathvariant="bold-italic">ϕ</mi><mn>2</mn></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mi>𝐗</mi><mrow><mi>r</mi><mo>+</mo><mn>1</mn></mrow></msub><mo stretchy="false">)</mo></mrow></mrow><mrow><mi>exp</mi><mo>⁡</mo><mrow><mo maxsize="1.200em" minsize="1.200em">(</mo><mrow><msub><mi>𝐠</mi><mn>0</mn></msub><mo lspace="0em" rspace="0em">​</mo><msup><mrow><mo stretchy="false">(</mo><msub><mi>𝐳</mi><mn>1</mn></msub><mo stretchy="false">)</mo></mrow><mo>⊤</mo></msup><mo lspace="0em" rspace="0em">​</mo><msub><mi class="ltx_mathvariant_bold-italic" mathvariant="bold-italic">ϕ</mi><mn>1</mn></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mi>𝐗</mi><mrow><mi>r</mi><mo>+</mo><mn>1</mn></mrow></msub><mo stretchy="false">)</mo></mrow></mrow><mo maxsize="1.200em" minsize="1.200em">)</mo></mrow></mrow></mfrac></mstyle><mo lspace="0em" rspace="0em" stretchy="true">|</mo><mi>𝐡</mi><mo>,</mo><mrow><mo stretchy="false">(</mo><msub><mi>𝐗</mi><mn>1</mn></msub><mo>,</mo><mi mathvariant="normal">…</mi><mo>,</mo><msub><mi>𝐗</mi><mi>r</mi></msub><mo stretchy="false">)</mo></mrow><mo>=</mo><mrow><mo stretchy="false">(</mo><msub><mi>𝐱</mi><mn>1</mn></msub><mo>,</mo><mi mathvariant="normal">…</mi><mo>,</mo><msub><mi>𝐱</mi><mi>r</mi></msub><mo stretchy="false">)</mo></mrow><mo>]</mo></mrow><mspace style="width:1em;" width="1em"></mspace></mrow><annotation encoding="application/x-tex">\displaystyle=\mathbb{E}\left[\frac{\bm{\phi}_{2}(\mathbf{X}_{r+1})}{\exp\big(\mathbf{g}_{0}(\mathbf{z}_{1})^{\top}\bm{\phi}_{1}(\mathbf{X}_{r+1})\big)}\middle|\mathbf{h},(\mathbf{X}_{1},\ldots,\mathbf{X}_{r})=(\mathbf{x}_{1},\ldots,\mathbf{x}_{r})\right]\quad</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
<tbody id="A6.Ex431"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_eqn_cell"></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A6.Ex431.m1" class="ltx_Math" alttext="\displaystyle=\frac{\sum_{w=1}^{W}\exp\Big(\mathbf{g}_{0}(\mathbf{z}_{1})^{\top}\bm{\phi}_{1}(\mathbf{e}_{w})+\mathbf{h}(\mathbf{z}_{2})^{\top}\bm{\phi}_{2}(\mathbf{e}_{w})\Big)\frac{\bm{\phi}_{2}(\mathbf{e}_{w})}{\exp\big(\mathbf{g}_{0}(\mathbf{z}_{1})^{\top}\bm{\phi}_{1}(\mathbf{e}_{w})\big)}}{\sum_{w=1}^{W}\exp\Big(\mathbf{g}_{0}(\mathbf{z}_{1})^{\top}\bm{\phi}_{1}(\mathbf{e}_{w})+\mathbf{h}(\mathbf{z}_{2})^{\top}\bm{\phi}_{2}(\mathbf{e}_{w})\Big)}" display="inline" intent=":literal"><semantics><mrow><mphantom></mphantom><mo>=</mo><mstyle displaystyle="true"><mfrac><mrow><msubsup><mo>∑</mo><mrow><mi>w</mi><mo>=</mo><mn>1</mn></mrow><mi>W</mi></msubsup><mrow><mrow><mi>exp</mi><mo>⁡</mo><mrow><mo maxsize="1.600em" minsize="1.600em">(</mo><mrow><mrow><msub><mi>𝐠</mi><mn>0</mn></msub><mo lspace="0em" rspace="0em">​</mo><msup><mrow><mo stretchy="false">(</mo><msub><mi>𝐳</mi><mn>1</mn></msub><mo stretchy="false">)</mo></mrow><mo>⊤</mo></msup><mo lspace="0em" rspace="0em">​</mo><msub><mi class="ltx_mathvariant_bold-italic" mathvariant="bold-italic">ϕ</mi><mn>1</mn></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mi>𝐞</mi><mi>w</mi></msub><mo stretchy="false">)</mo></mrow></mrow><mo>+</mo><mrow><mi>𝐡</mi><mo lspace="0em" rspace="0em">​</mo><msup><mrow><mo stretchy="false">(</mo><msub><mi>𝐳</mi><mn>2</mn></msub><mo stretchy="false">)</mo></mrow><mo>⊤</mo></msup><mo lspace="0em" rspace="0em">​</mo><msub><mi class="ltx_mathvariant_bold-italic" mathvariant="bold-italic">ϕ</mi><mn>2</mn></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mi>𝐞</mi><mi>w</mi></msub><mo stretchy="false">)</mo></mrow></mrow></mrow><mo maxsize="1.600em" minsize="1.600em">)</mo></mrow></mrow><mo lspace="0em" rspace="0em">​</mo><mfrac><mrow><msub><mi class="ltx_mathvariant_bold-italic" mathvariant="bold-italic">ϕ</mi><mn>2</mn></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mi>𝐞</mi><mi>w</mi></msub><mo stretchy="false">)</mo></mrow></mrow><mrow><mi>exp</mi><mo>⁡</mo><mrow><mo maxsize="1.710em" minsize="1.710em">(</mo><mrow><msub><mi>𝐠</mi><mn>0</mn></msub><mo lspace="0em" rspace="0em">​</mo><msup><mrow><mo stretchy="false">(</mo><msub><mi>𝐳</mi><mn>1</mn></msub><mo stretchy="false">)</mo></mrow><mo>⊤</mo></msup><mo lspace="0em" rspace="0em">​</mo><msub><mi class="ltx_mathvariant_bold-italic" mathvariant="bold-italic">ϕ</mi><mn>1</mn></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mi>𝐞</mi><mi>w</mi></msub><mo stretchy="false">)</mo></mrow></mrow><mo maxsize="1.710em" minsize="1.710em">)</mo></mrow></mrow></mfrac></mrow></mrow><mrow><msubsup><mo>∑</mo><mrow><mi>w</mi><mo>=</mo><mn>1</mn></mrow><mi>W</mi></msubsup><mrow><mi>exp</mi><mo>⁡</mo><mrow><mo maxsize="1.600em" minsize="1.600em">(</mo><mrow><mrow><msub><mi>𝐠</mi><mn>0</mn></msub><mo lspace="0em" rspace="0em">​</mo><msup><mrow><mo stretchy="false">(</mo><msub><mi>𝐳</mi><mn>1</mn></msub><mo stretchy="false">)</mo></mrow><mo>⊤</mo></msup><mo lspace="0em" rspace="0em">​</mo><msub><mi class="ltx_mathvariant_bold-italic" mathvariant="bold-italic">ϕ</mi><mn>1</mn></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mi>𝐞</mi><mi>w</mi></msub><mo stretchy="false">)</mo></mrow></mrow><mo>+</mo><mrow><mi>𝐡</mi><mo lspace="0em" rspace="0em">​</mo><msup><mrow><mo stretchy="false">(</mo><msub><mi>𝐳</mi><mn>2</mn></msub><mo stretchy="false">)</mo></mrow><mo>⊤</mo></msup><mo lspace="0em" rspace="0em">​</mo><msub><mi class="ltx_mathvariant_bold-italic" mathvariant="bold-italic">ϕ</mi><mn>2</mn></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mi>𝐞</mi><mi>w</mi></msub><mo stretchy="false">)</mo></mrow></mrow></mrow><mo maxsize="1.600em" minsize="1.600em">)</mo></mrow></mrow></mrow></mfrac></mstyle></mrow><annotation encoding="application/x-tex">\displaystyle=\frac{\sum_{w=1}^{W}\exp\Big(\mathbf{g}_{0}(\mathbf{z}_{1})^{\top}\bm{\phi}_{1}(\mathbf{e}_{w})+\mathbf{h}(\mathbf{z}_{2})^{\top}\bm{\phi}_{2}(\mathbf{e}_{w})\Big)\frac{\bm{\phi}_{2}(\mathbf{e}_{w})}{\exp\big(\mathbf{g}_{0}(\mathbf{z}_{1})^{\top}\bm{\phi}_{1}(\mathbf{e}_{w})\big)}}{\sum_{w=1}^{W}\exp\Big(\mathbf{g}_{0}(\mathbf{z}_{1})^{\top}\bm{\phi}_{1}(\mathbf{e}_{w})+\mathbf{h}(\mathbf{z}_{2})^{\top}\bm{\phi}_{2}(\mathbf{e}_{w})\Big)}</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
<tbody id="A6.Ex432"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_eqn_cell"></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A6.Ex432.m1" class="ltx_Math" alttext="\displaystyle=\frac{\sum_{w=1}^{W}\exp\Big(\mathbf{h}(\mathbf{z}_{2})^{\top}\bm{\phi}_{2}(\mathbf{e}_{w})\Big)\bm{\phi}_{2}(\mathbf{e}_{w})}{\sum_{w=1}^{W}\exp\Big(\mathbf{g}_{0}(\mathbf{z}_{1})^{\top}\bm{\phi}_{1}(\mathbf{e}_{w})+\mathbf{h}(\mathbf{z}_{2})^{\top}\bm{\phi}_{2}(\mathbf{e}_{w})\Big)}" display="inline" intent=":literal"><semantics><mrow><mphantom></mphantom><mo>=</mo><mstyle displaystyle="true"><mfrac><mrow><msubsup><mo>∑</mo><mrow><mi>w</mi><mo>=</mo><mn>1</mn></mrow><mi>W</mi></msubsup><mrow><mrow><mi>exp</mi><mo>⁡</mo><mrow><mo maxsize="1.600em" minsize="1.600em">(</mo><mrow><mi>𝐡</mi><mo lspace="0em" rspace="0em">​</mo><msup><mrow><mo stretchy="false">(</mo><msub><mi>𝐳</mi><mn>2</mn></msub><mo stretchy="false">)</mo></mrow><mo>⊤</mo></msup><mo lspace="0em" rspace="0em">​</mo><msub><mi class="ltx_mathvariant_bold-italic" mathvariant="bold-italic">ϕ</mi><mn>2</mn></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mi>𝐞</mi><mi>w</mi></msub><mo stretchy="false">)</mo></mrow></mrow><mo maxsize="1.600em" minsize="1.600em">)</mo></mrow></mrow><mo lspace="0em" rspace="0em">​</mo><msub><mi class="ltx_mathvariant_bold-italic" mathvariant="bold-italic">ϕ</mi><mn>2</mn></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mi>𝐞</mi><mi>w</mi></msub><mo stretchy="false">)</mo></mrow></mrow></mrow><mrow><msubsup><mo>∑</mo><mrow><mi>w</mi><mo>=</mo><mn>1</mn></mrow><mi>W</mi></msubsup><mrow><mi>exp</mi><mo>⁡</mo><mrow><mo maxsize="1.600em" minsize="1.600em">(</mo><mrow><mrow><msub><mi>𝐠</mi><mn>0</mn></msub><mo lspace="0em" rspace="0em">​</mo><msup><mrow><mo stretchy="false">(</mo><msub><mi>𝐳</mi><mn>1</mn></msub><mo stretchy="false">)</mo></mrow><mo>⊤</mo></msup><mo lspace="0em" rspace="0em">​</mo><msub><mi class="ltx_mathvariant_bold-italic" mathvariant="bold-italic">ϕ</mi><mn>1</mn></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mi>𝐞</mi><mi>w</mi></msub><mo stretchy="false">)</mo></mrow></mrow><mo>+</mo><mrow><mi>𝐡</mi><mo lspace="0em" rspace="0em">​</mo><msup><mrow><mo stretchy="false">(</mo><msub><mi>𝐳</mi><mn>2</mn></msub><mo stretchy="false">)</mo></mrow><mo>⊤</mo></msup><mo lspace="0em" rspace="0em">​</mo><msub><mi class="ltx_mathvariant_bold-italic" mathvariant="bold-italic">ϕ</mi><mn>2</mn></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mi>𝐞</mi><mi>w</mi></msub><mo stretchy="false">)</mo></mrow></mrow></mrow><mo maxsize="1.600em" minsize="1.600em">)</mo></mrow></mrow></mrow></mfrac></mstyle></mrow><annotation encoding="application/x-tex">\displaystyle=\frac{\sum_{w=1}^{W}\exp\Big(\mathbf{h}(\mathbf{z}_{2})^{\top}\bm{\phi}_{2}(\mathbf{e}_{w})\Big)\bm{\phi}_{2}(\mathbf{e}_{w})}{\sum_{w=1}^{W}\exp\Big(\mathbf{g}_{0}(\mathbf{z}_{1})^{\top}\bm{\phi}_{1}(\mathbf{e}_{w})+\mathbf{h}(\mathbf{z}_{2})^{\top}\bm{\phi}_{2}(\mathbf{e}_{w})\Big)}</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
<tbody id="A6.E116"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_eqn_cell"></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A6.E116.m1" class="ltx_Math" alttext="\displaystyle=\underbrace{\frac{\sum_{w=1}^{W}\exp\big(\mathbf{h}(\mathbf{z}_{2})^{\top}\bm{\phi}_{2}(\mathbf{e}_{w})\big)\bm{\phi}_{2}(\mathbf{e}_{w})}{\sum_{w=1}^{W}\exp\big(\mathbf{h}(\mathbf{z}_{2})^{\top}\bm{\phi}_{2}(\mathbf{e}_{w})\big)}}_{\displaystyle\eqcolon\,\tilde{\bm{\theta}}(\mathbf{z}_{2})\,\in\,\mathbb{R}^{m_{2}}}\,\underbrace{\frac{\sum_{w=1}^{W}\exp\big(\mathbf{h}(\mathbf{z}_{2})^{\top}\bm{\phi}_{2}(\mathbf{e}_{w})\big)}{\sum_{w=1}^{W}\exp\big(\mathbf{g}_{0}(\mathbf{z}_{1})^{\top}\bm{\phi}_{1}(\mathbf{e}_{w})+\mathbf{h}(\mathbf{z}_{2})^{\top}\bm{\phi}_{2}(\mathbf{e}_{w})\big)}}_{\displaystyle\in\,\mathbb{R}}," display="inline" intent=":literal"><semantics><mrow><mrow><mphantom></mphantom><mo>=</mo><mrow><munder><munder accentunder="true"><mstyle displaystyle="true"><mfrac><mrow><msubsup><mo>∑</mo><mrow><mi>w</mi><mo>=</mo><mn>1</mn></mrow><mi>W</mi></msubsup><mrow><mrow><mi>exp</mi><mo>⁡</mo><mrow><mo maxsize="1.200em" minsize="1.200em">(</mo><mrow><mi>𝐡</mi><mo lspace="0em" rspace="0em">​</mo><msup><mrow><mo stretchy="false">(</mo><msub><mi>𝐳</mi><mn>2</mn></msub><mo stretchy="false">)</mo></mrow><mo>⊤</mo></msup><mo lspace="0em" rspace="0em">​</mo><msub><mi class="ltx_mathvariant_bold-italic" mathvariant="bold-italic">ϕ</mi><mn>2</mn></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mi>𝐞</mi><mi>w</mi></msub><mo stretchy="false">)</mo></mrow></mrow><mo maxsize="1.200em" minsize="1.200em">)</mo></mrow></mrow><mo lspace="0em" rspace="0em">​</mo><msub><mi class="ltx_mathvariant_bold-italic" mathvariant="bold-italic">ϕ</mi><mn>2</mn></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mi>𝐞</mi><mi>w</mi></msub><mo stretchy="false">)</mo></mrow></mrow></mrow><mrow><msubsup><mo>∑</mo><mrow><mi>w</mi><mo>=</mo><mn>1</mn></mrow><mi>W</mi></msubsup><mrow><mi>exp</mi><mo>⁡</mo><mrow><mo maxsize="1.200em" minsize="1.200em">(</mo><mrow><mi>𝐡</mi><mo lspace="0em" rspace="0em">​</mo><msup><mrow><mo stretchy="false">(</mo><msub><mi>𝐳</mi><mn>2</mn></msub><mo stretchy="false">)</mo></mrow><mo>⊤</mo></msup><mo lspace="0em" rspace="0em">​</mo><msub><mi class="ltx_mathvariant_bold-italic" mathvariant="bold-italic">ϕ</mi><mn>2</mn></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mi>𝐞</mi><mi>w</mi></msub><mo stretchy="false">)</mo></mrow></mrow><mo maxsize="1.200em" minsize="1.200em">)</mo></mrow></mrow></mrow></mfrac></mstyle><mo stretchy="true">⏟</mo></munder><mrow><mphantom></mphantom><mo rspace="0.448em">≕</mo><mrow><mover accent="true"><mi>𝜽</mi><mo>~</mo></mover><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mi>𝐳</mi><mn mathsize="1.400em">2</mn></msub><mo rspace="0.170em" stretchy="false">)</mo></mrow></mrow><mo rspace="0.448em">∈</mo><msup><mi>ℝ</mi><msub><mi mathsize="1.400em">m</mi><mn>2</mn></msub></msup></mrow></munder><mo lspace="0em" rspace="0em">​</mo><munder><munder accentunder="true"><mstyle displaystyle="true"><mfrac><mrow><msubsup><mo>∑</mo><mrow><mi>w</mi><mo>=</mo><mn>1</mn></mrow><mi>W</mi></msubsup><mrow><mi>exp</mi><mo>⁡</mo><mrow><mo maxsize="1.200em" minsize="1.200em">(</mo><mrow><mi>𝐡</mi><mo lspace="0em" rspace="0em">​</mo><msup><mrow><mo stretchy="false">(</mo><msub><mi>𝐳</mi><mn>2</mn></msub><mo stretchy="false">)</mo></mrow><mo>⊤</mo></msup><mo lspace="0em" rspace="0em">​</mo><msub><mi class="ltx_mathvariant_bold-italic" mathvariant="bold-italic">ϕ</mi><mn>2</mn></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mi>𝐞</mi><mi>w</mi></msub><mo stretchy="false">)</mo></mrow></mrow><mo maxsize="1.200em" minsize="1.200em">)</mo></mrow></mrow></mrow><mrow><msubsup><mo>∑</mo><mrow><mi>w</mi><mo>=</mo><mn>1</mn></mrow><mi>W</mi></msubsup><mrow><mi>exp</mi><mo>⁡</mo><mrow><mo maxsize="1.200em" minsize="1.200em">(</mo><mrow><mrow><msub><mi>𝐠</mi><mn>0</mn></msub><mo lspace="0em" rspace="0em">​</mo><msup><mrow><mo stretchy="false">(</mo><msub><mi>𝐳</mi><mn>1</mn></msub><mo stretchy="false">)</mo></mrow><mo>⊤</mo></msup><mo lspace="0em" rspace="0em">​</mo><msub><mi class="ltx_mathvariant_bold-italic" mathvariant="bold-italic">ϕ</mi><mn>1</mn></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mi>𝐞</mi><mi>w</mi></msub><mo stretchy="false">)</mo></mrow></mrow><mo>+</mo><mrow><mi>𝐡</mi><mo lspace="0em" rspace="0em">​</mo><msup><mrow><mo stretchy="false">(</mo><msub><mi>𝐳</mi><mn>2</mn></msub><mo stretchy="false">)</mo></mrow><mo>⊤</mo></msup><mo lspace="0em" rspace="0em">​</mo><msub><mi class="ltx_mathvariant_bold-italic" mathvariant="bold-italic">ϕ</mi><mn>2</mn></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mi>𝐞</mi><mi>w</mi></msub><mo stretchy="false">)</mo></mrow></mrow></mrow><mo maxsize="1.200em" minsize="1.200em">)</mo></mrow></mrow></mrow></mfrac></mstyle><mo stretchy="true">⏟</mo></munder><mrow><mphantom></mphantom><mo rspace="0.448em">∈</mo><mi>ℝ</mi></mrow></munder></mrow></mrow><mo>,</mo></mrow><annotation encoding="application/x-tex">\displaystyle=\underbrace{\frac{\sum_{w=1}^{W}\exp\big(\mathbf{h}(\mathbf{z}_{2})^{\top}\bm{\phi}_{2}(\mathbf{e}_{w})\big)\bm{\phi}_{2}(\mathbf{e}_{w})}{\sum_{w=1}^{W}\exp\big(\mathbf{h}(\mathbf{z}_{2})^{\top}\bm{\phi}_{2}(\mathbf{e}_{w})\big)}}_{\displaystyle\eqcolon\,\tilde{\bm{\theta}}(\mathbf{z}_{2})\,\in\,\mathbb{R}^{m_{2}}}\,\underbrace{\frac{\sum_{w=1}^{W}\exp\big(\mathbf{h}(\mathbf{z}_{2})^{\top}\bm{\phi}_{2}(\mathbf{e}_{w})\big)}{\sum_{w=1}^{W}\exp\big(\mathbf{g}_{0}(\mathbf{z}_{1})^{\top}\bm{\phi}_{1}(\mathbf{e}_{w})+\mathbf{h}(\mathbf{z}_{2})^{\top}\bm{\phi}_{2}(\mathbf{e}_{w})\big)}}_{\displaystyle\in\,\mathbb{R}},</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td>
<td rowspan="1" class="ltx_eqn_cell ltx_eqn_eqno ltx_align_middle ltx_align_right"><span class="ltx_tag ltx_tag_equation ltx_align_right">(116)</span></td></tr></tbody>
</table>
<p id="A6.SS4.p1.3" class="ltx_p"><span id="A6.SS4.p1.3.1" class="ltx_text">which gives us the assertion.</span></p>
</div>
<div id="A6.SS4.p2" class="ltx_para">
<p id="A6.SS4.p2.1" class="ltx_p"><span id="A6.SS4.p2.1.1" class="ltx_text ltx_font_bold">(ii)<span id="A6.SS4.p2.1.1.1" class="ltx_text ltx_font_medium">
Applying the reverse triangle inequality, the second argument of Lemma <a href="#Thmconj235" title="Lemma 35. ‣ Appendix G Technical Lemmas ‣ Generalization Bounds for Transformer-Based Next-Token Prediction in a Language Model" class="ltx_ref"><span class="ltx_text ltx_ref_tag">35</span></a>, the definition of <math id="A6.SS4.p2.m1" class="ltx_Math" alttext="\kappa_{W}" display="inline" intent=":literal"><semantics><msub><mi>κ</mi><mi>W</mi></msub><annotation encoding="application/x-tex">\kappa_{W}</annotation></semantics></math> (Definition <a href="#S4.Thmconj1" title="Definition 4.1. ‣ 4 Risk bound ‣ Generalization Bounds for Transformer-Based Next-Token Prediction in a Language Model" class="ltx_ref"><span class="ltx_text ltx_ref_tag">4.1</span></a>), and the assumption
<math id="A6.SS4.p2.m2" class="ltx_Math" alttext="\kappa_{W}\leq(1+m_{2}/\delta_{2})^{-1}/2" display="inline" intent=":literal"><semantics><mrow><msub><mi>κ</mi><mi>W</mi></msub><mo>≤</mo><mrow><msup><mrow><mo stretchy="false">(</mo><mrow><mn>1</mn><mo>+</mo><mrow><msub><mi>m</mi><mn>2</mn></msub><mo>/</mo><msub><mi>δ</mi><mn>2</mn></msub></mrow></mrow><mo stretchy="false">)</mo></mrow><mrow><mo>−</mo><mn>1</mn></mrow></msup><mo>/</mo><mn>2</mn></mrow></mrow><annotation encoding="application/x-tex">\kappa_{W}\leq(1+m_{2}/\delta_{2})^{-1}/2</annotation></semantics></math>,</span></span></p>
<table id="A6.EGx184" class="ltx_equationgroup ltx_eqn_align ltx_eqn_table">

<tbody id="A6.Ex433"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_align_right ltx_eqn_cell"><math id="A6.Ex433.m1" class="ltx_Math" alttext="\displaystyle\big\|\tilde{\bm{\theta}}(\mathbf{z}_{2})\big\|_{2}" display="inline" intent=":literal"><semantics><msub><mrow><mo maxsize="1.200em" minsize="1.200em" stretchy="true">‖</mo><mrow><mover accent="true"><mi>𝜽</mi><mo>~</mo></mover><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mi>𝐳</mi><mn>2</mn></msub><mo stretchy="false">)</mo></mrow></mrow><mo maxsize="1.200em" minsize="1.200em" stretchy="true">‖</mo></mrow><mn>2</mn></msub><annotation encoding="application/x-tex">\displaystyle\big\|\tilde{\bm{\theta}}(\mathbf{z}_{2})\big\|_{2}</annotation></semantics></math></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A6.Ex433.m2" class="ltx_Math" alttext="\displaystyle\geq\left\|\frac{\int_{\mathbf{u}\in\mathbb{S}^{m_{2}-1}}\exp(\mathbf{h}(\mathbf{z}_{2})^{\top}\mathbf{u})\mathbf{u}d\mathbf{u}}{\int_{\mathbf{u}\in\mathbb{S}^{m_{2}-1}}\exp(\mathbf{h}(\mathbf{z}_{2})^{\top}\mathbf{u})d\mathbf{u}}\right\|_{2}-\left\|\tilde{\bm{\theta}}(\mathbf{z}_{2})-\frac{\int_{\mathbf{u}\in\mathbb{S}^{m_{2}-1}}\exp(\mathbf{h}(\mathbf{z}_{2})^{\top}\mathbf{u})\mathbf{u}d\mathbf{u}}{\int_{\mathbf{u}\in\mathbb{S}^{m_{2}-1}}\exp(\mathbf{h}(\mathbf{z}_{2})^{\top}\mathbf{u})d\mathbf{u}}\right\|_{2}" display="inline" intent=":literal"><semantics><mrow><mphantom></mphantom><mo>≥</mo><mrow><msub><mrow><mo>‖</mo><mstyle displaystyle="true"><mfrac><mrow><msub><mo>∫</mo><mrow><mi>𝐮</mi><mo>∈</mo><msup><mi>𝕊</mi><mrow><msub><mi>m</mi><mn>2</mn></msub><mo>−</mo><mn>1</mn></mrow></msup></mrow></msub><mrow><mrow><mi>exp</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mrow><mi>𝐡</mi><mo lspace="0em" rspace="0em">​</mo><msup><mrow><mo stretchy="false">(</mo><msub><mi>𝐳</mi><mn>2</mn></msub><mo stretchy="false">)</mo></mrow><mo>⊤</mo></msup><mo lspace="0em" rspace="0em">​</mo><mi>𝐮</mi></mrow><mo stretchy="false">)</mo></mrow></mrow><mo lspace="0em" rspace="0em">​</mo><mi>𝐮</mi><mo lspace="0em" rspace="0em">​</mo><mrow><mo rspace="0em">𝑑</mo><mi>𝐮</mi></mrow></mrow></mrow><mrow><msub><mo>∫</mo><mrow><mi>𝐮</mi><mo>∈</mo><msup><mi>𝕊</mi><mrow><msub><mi>m</mi><mn>2</mn></msub><mo>−</mo><mn>1</mn></mrow></msup></mrow></msub><mrow><mrow><mi>exp</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mrow><mi>𝐡</mi><mo lspace="0em" rspace="0em">​</mo><msup><mrow><mo stretchy="false">(</mo><msub><mi>𝐳</mi><mn>2</mn></msub><mo stretchy="false">)</mo></mrow><mo>⊤</mo></msup><mo lspace="0em" rspace="0em">​</mo><mi>𝐮</mi></mrow><mo stretchy="false">)</mo></mrow></mrow><mo lspace="0em" rspace="0em">​</mo><mrow><mo rspace="0em">𝑑</mo><mi>𝐮</mi></mrow></mrow></mrow></mfrac></mstyle><mo>‖</mo></mrow><mn>2</mn></msub><mo>−</mo><msub><mrow><mo>‖</mo><mrow><mrow><mover accent="true"><mi>𝜽</mi><mo>~</mo></mover><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mi>𝐳</mi><mn>2</mn></msub><mo stretchy="false">)</mo></mrow></mrow><mo>−</mo><mstyle displaystyle="true"><mfrac><mrow><msub><mo>∫</mo><mrow><mi>𝐮</mi><mo>∈</mo><msup><mi>𝕊</mi><mrow><msub><mi>m</mi><mn>2</mn></msub><mo>−</mo><mn>1</mn></mrow></msup></mrow></msub><mrow><mrow><mi>exp</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mrow><mi>𝐡</mi><mo lspace="0em" rspace="0em">​</mo><msup><mrow><mo stretchy="false">(</mo><msub><mi>𝐳</mi><mn>2</mn></msub><mo stretchy="false">)</mo></mrow><mo>⊤</mo></msup><mo lspace="0em" rspace="0em">​</mo><mi>𝐮</mi></mrow><mo stretchy="false">)</mo></mrow></mrow><mo lspace="0em" rspace="0em">​</mo><mi>𝐮</mi><mo lspace="0em" rspace="0em">​</mo><mrow><mo rspace="0em">𝑑</mo><mi>𝐮</mi></mrow></mrow></mrow><mrow><msub><mo>∫</mo><mrow><mi>𝐮</mi><mo>∈</mo><msup><mi>𝕊</mi><mrow><msub><mi>m</mi><mn>2</mn></msub><mo>−</mo><mn>1</mn></mrow></msup></mrow></msub><mrow><mrow><mi>exp</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mrow><mi>𝐡</mi><mo lspace="0em" rspace="0em">​</mo><msup><mrow><mo stretchy="false">(</mo><msub><mi>𝐳</mi><mn>2</mn></msub><mo stretchy="false">)</mo></mrow><mo>⊤</mo></msup><mo lspace="0em" rspace="0em">​</mo><mi>𝐮</mi></mrow><mo stretchy="false">)</mo></mrow></mrow><mo lspace="0em" rspace="0em">​</mo><mrow><mo rspace="0em">𝑑</mo><mi>𝐮</mi></mrow></mrow></mrow></mfrac></mstyle></mrow><mo>‖</mo></mrow><mn>2</mn></msub></mrow></mrow><annotation encoding="application/x-tex">\displaystyle\geq\left\|\frac{\int_{\mathbf{u}\in\mathbb{S}^{m_{2}-1}}\exp(\mathbf{h}(\mathbf{z}_{2})^{\top}\mathbf{u})\mathbf{u}d\mathbf{u}}{\int_{\mathbf{u}\in\mathbb{S}^{m_{2}-1}}\exp(\mathbf{h}(\mathbf{z}_{2})^{\top}\mathbf{u})d\mathbf{u}}\right\|_{2}-\left\|\tilde{\bm{\theta}}(\mathbf{z}_{2})-\frac{\int_{\mathbf{u}\in\mathbb{S}^{m_{2}-1}}\exp(\mathbf{h}(\mathbf{z}_{2})^{\top}\mathbf{u})\mathbf{u}d\mathbf{u}}{\int_{\mathbf{u}\in\mathbb{S}^{m_{2}-1}}\exp(\mathbf{h}(\mathbf{z}_{2})^{\top}\mathbf{u})d\mathbf{u}}\right\|_{2}</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
<tbody id="A6.E117"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_eqn_cell"></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A6.E117.m1" class="ltx_Math" alttext="\displaystyle\geq\frac{1}{1+m_{2}/\delta_{2}}-\kappa_{W}\geq\frac{1}{2+2m_{2}/\delta_{2}}\coloneqq\varrho&gt;0." display="inline" intent=":literal"><semantics><mrow><mrow><mphantom></mphantom><mo>≥</mo><mrow><mstyle displaystyle="true"><mfrac><mn>1</mn><mrow><mn>1</mn><mo>+</mo><mrow><msub><mi>m</mi><mn>2</mn></msub><mo>/</mo><msub><mi>δ</mi><mn>2</mn></msub></mrow></mrow></mfrac></mstyle><mo>−</mo><msub><mi>κ</mi><mi>W</mi></msub></mrow><mo>≥</mo><mstyle displaystyle="true"><mfrac><mn>1</mn><mrow><mn>2</mn><mo>+</mo><mrow><mrow><mn>2</mn><mo lspace="0em" rspace="0em">​</mo><msub><mi>m</mi><mn>2</mn></msub></mrow><mo>/</mo><msub><mi>δ</mi><mn>2</mn></msub></mrow></mrow></mfrac></mstyle><mo>≔</mo><mi>ϱ</mi><mo>&gt;</mo><mn>0</mn></mrow><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">\displaystyle\geq\frac{1}{1+m_{2}/\delta_{2}}-\kappa_{W}\geq\frac{1}{2+2m_{2}/\delta_{2}}\coloneqq\varrho&gt;0.</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td>
<td rowspan="1" class="ltx_eqn_cell ltx_eqn_eqno ltx_align_middle ltx_align_right"><span class="ltx_tag ltx_tag_equation ltx_align_right">(117)</span></td></tr></tbody>
</table>
<p id="A6.SS4.p2.2" class="ltx_p"><span id="A6.SS4.p2.2.1" class="ltx_text">On the other hand, we have</span></p>
<table id="A6.Ex434" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="A6.Ex434.m1" class="ltx_Math" alttext="\frac{\sum_{w=1}^{W}\exp\big(\mathbf{h}(\mathbf{z}_{2})^{\top}\bm{\phi}_{2}(\mathbf{e}_{w})\big)}{\sum_{w=1}^{W}\exp\big(\mathbf{g}_{0}(\mathbf{z}_{1})^{\top}\bm{\phi}_{1}(\mathbf{e}_{w})+\mathbf{h}(\mathbf{z}_{2})^{\top}\bm{\phi}_{2}(\mathbf{e}_{w})\big)}\geq\frac{W\exp(-\delta_{2})}{W\exp(\delta_{1}m_{1}+\delta_{2})}=\exp(-\delta_{1}m_{1}-2\delta_{2})." display="block" intent=":literal"><semantics><mrow><mrow><mfrac><mrow><msubsup><mo>∑</mo><mrow><mi>w</mi><mo>=</mo><mn>1</mn></mrow><mi>W</mi></msubsup><mrow><mi>exp</mi><mo>⁡</mo><mrow><mo maxsize="1.200em" minsize="1.200em">(</mo><mrow><mi>𝐡</mi><mo lspace="0em" rspace="0em">​</mo><msup><mrow><mo stretchy="false">(</mo><msub><mi>𝐳</mi><mn>2</mn></msub><mo stretchy="false">)</mo></mrow><mo>⊤</mo></msup><mo lspace="0em" rspace="0em">​</mo><msub><mi class="ltx_mathvariant_bold-italic" mathvariant="bold-italic">ϕ</mi><mn>2</mn></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mi>𝐞</mi><mi>w</mi></msub><mo stretchy="false">)</mo></mrow></mrow><mo maxsize="1.200em" minsize="1.200em">)</mo></mrow></mrow></mrow><mrow><msubsup><mo>∑</mo><mrow><mi>w</mi><mo>=</mo><mn>1</mn></mrow><mi>W</mi></msubsup><mrow><mi>exp</mi><mo>⁡</mo><mrow><mo maxsize="1.200em" minsize="1.200em">(</mo><mrow><mrow><msub><mi>𝐠</mi><mn>0</mn></msub><mo lspace="0em" rspace="0em">​</mo><msup><mrow><mo stretchy="false">(</mo><msub><mi>𝐳</mi><mn>1</mn></msub><mo stretchy="false">)</mo></mrow><mo>⊤</mo></msup><mo lspace="0em" rspace="0em">​</mo><msub><mi class="ltx_mathvariant_bold-italic" mathvariant="bold-italic">ϕ</mi><mn>1</mn></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mi>𝐞</mi><mi>w</mi></msub><mo stretchy="false">)</mo></mrow></mrow><mo>+</mo><mrow><mi>𝐡</mi><mo lspace="0em" rspace="0em">​</mo><msup><mrow><mo stretchy="false">(</mo><msub><mi>𝐳</mi><mn>2</mn></msub><mo stretchy="false">)</mo></mrow><mo>⊤</mo></msup><mo lspace="0em" rspace="0em">​</mo><msub><mi class="ltx_mathvariant_bold-italic" mathvariant="bold-italic">ϕ</mi><mn>2</mn></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mi>𝐞</mi><mi>w</mi></msub><mo stretchy="false">)</mo></mrow></mrow></mrow><mo maxsize="1.200em" minsize="1.200em">)</mo></mrow></mrow></mrow></mfrac><mo>≥</mo><mfrac><mrow><mi>W</mi><mo lspace="0.167em" rspace="0em">​</mo><mrow><mi>exp</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mrow><mo>−</mo><msub><mi>δ</mi><mn>2</mn></msub></mrow><mo stretchy="false">)</mo></mrow></mrow></mrow><mrow><mi>W</mi><mo lspace="0.167em" rspace="0em">​</mo><mrow><mi>exp</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mrow><mrow><msub><mi>δ</mi><mn>1</mn></msub><mo lspace="0em" rspace="0em">​</mo><msub><mi>m</mi><mn>1</mn></msub></mrow><mo>+</mo><msub><mi>δ</mi><mn>2</mn></msub></mrow><mo stretchy="false">)</mo></mrow></mrow></mrow></mfrac><mo>=</mo><mrow><mi>exp</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mrow><mrow><mo>−</mo><mrow><msub><mi>δ</mi><mn>1</mn></msub><mo lspace="0em" rspace="0em">​</mo><msub><mi>m</mi><mn>1</mn></msub></mrow></mrow><mo>−</mo><mrow><mn>2</mn><mo lspace="0em" rspace="0em">​</mo><msub><mi>δ</mi><mn>2</mn></msub></mrow></mrow><mo stretchy="false">)</mo></mrow></mrow></mrow><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">\frac{\sum_{w=1}^{W}\exp\big(\mathbf{h}(\mathbf{z}_{2})^{\top}\bm{\phi}_{2}(\mathbf{e}_{w})\big)}{\sum_{w=1}^{W}\exp\big(\mathbf{g}_{0}(\mathbf{z}_{1})^{\top}\bm{\phi}_{1}(\mathbf{e}_{w})+\mathbf{h}(\mathbf{z}_{2})^{\top}\bm{\phi}_{2}(\mathbf{e}_{w})\big)}\geq\frac{W\exp(-\delta_{2})}{W\exp(\delta_{1}m_{1}+\delta_{2})}=\exp(-\delta_{1}m_{1}-2\delta_{2}).</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="A6.SS4.p2.3" class="ltx_p"><span id="A6.SS4.p2.3.1" class="ltx_text">Combining these inequalities with <span id="A6.SS4.p2.3.1.1" class="ltx_text ltx_markedasmath">(<a href="#A6.E116" title="In Proof. ‣ F.4 Proof of Lemma ‣ Appendix F Directional Convergence of the Nadaraya–Watson Estimator ‣ Generalization Bounds for Transformer-Based Next-Token Prediction in a Language Model" class="ltx_ref"><span class="ltx_text ltx_ref_tag">116</span></a>)</span> gives us the assertion.</span></p>
</div>
<div id="A6.SS4.p3" class="ltx_para">
<p id="A6.SS4.p3.1" class="ltx_p"><span id="A6.SS4.p3.1.1" class="ltx_text ltx_font_bold">(iii)<span id="A6.SS4.p3.1.1.1" class="ltx_text ltx_font_medium">
By Lemma <a href="#Thmconj233" title="Lemma 33. ‣ Appendix G Technical Lemmas ‣ Generalization Bounds for Transformer-Based Next-Token Prediction in a Language Model" class="ltx_ref"><span class="ltx_text ltx_ref_tag">33</span></a> and the smoothness of <math id="A6.SS4.p3.m1" class="ltx_Math" alttext="\mathbf{h}" display="inline" intent=":literal"><semantics><mi>𝐡</mi><annotation encoding="application/x-tex">\mathbf{h}</annotation></semantics></math>,</span></span></p>
<table id="A6.EGx185" class="ltx_equationgroup ltx_eqn_align ltx_eqn_table">

<tbody id="A6.Ex435"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_align_right ltx_eqn_cell"><math id="A6.Ex435.m1" class="ltx_Math" alttext="\displaystyle\big\|\tilde{\bm{\theta}}\big(\mathbf{s}(\mathbf{x})\big)-\tilde{\bm{\theta}}\big(\mathbf{s}(\mathbf{x}^{\prime})\big)\big\|_{\infty}\leq 2\big\|\mathbf{h}\big(\mathbf{s}(\mathbf{x})\big)-\mathbf{h}\big(\mathbf{s}(\mathbf{x}^{\prime})\big)\big\|_{2}" display="inline" intent=":literal"><semantics><mrow><msub><mrow><mo maxsize="1.200em" minsize="1.200em" stretchy="true">‖</mo><mrow><mrow><mover accent="true"><mi>𝜽</mi><mo>~</mo></mover><mo lspace="0em" rspace="0em">​</mo><mrow><mo maxsize="1.200em" minsize="1.200em">(</mo><mrow><mi>𝐬</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>𝐱</mi><mo stretchy="false">)</mo></mrow></mrow><mo maxsize="1.200em" minsize="1.200em">)</mo></mrow></mrow><mo>−</mo><mrow><mover accent="true"><mi>𝜽</mi><mo>~</mo></mover><mo lspace="0em" rspace="0em">​</mo><mrow><mo maxsize="1.200em" minsize="1.200em">(</mo><mrow><mi>𝐬</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><msup><mi>𝐱</mi><mo>′</mo></msup><mo stretchy="false">)</mo></mrow></mrow><mo maxsize="1.200em" minsize="1.200em">)</mo></mrow></mrow></mrow><mo maxsize="1.200em" minsize="1.200em" stretchy="true">‖</mo></mrow><mi mathvariant="normal">∞</mi></msub><mo>≤</mo><mrow><mn>2</mn><mo lspace="0em" rspace="0em">​</mo><msub><mrow><mo maxsize="1.200em" minsize="1.200em" stretchy="true">‖</mo><mrow><mrow><mi>𝐡</mi><mo>⁡</mo><mrow><mo maxsize="1.200em" minsize="1.200em">(</mo><mrow><mi>𝐬</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>𝐱</mi><mo stretchy="false">)</mo></mrow></mrow><mo maxsize="1.200em" minsize="1.200em">)</mo></mrow></mrow><mo>−</mo><mrow><mi>𝐡</mi><mo>⁡</mo><mrow><mo maxsize="1.200em" minsize="1.200em">(</mo><mrow><mi>𝐬</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><msup><mi>𝐱</mi><mo>′</mo></msup><mo stretchy="false">)</mo></mrow></mrow><mo maxsize="1.200em" minsize="1.200em">)</mo></mrow></mrow></mrow><mo maxsize="1.200em" minsize="1.200em" stretchy="true">‖</mo></mrow><mn>2</mn></msub></mrow></mrow><annotation encoding="application/x-tex">\displaystyle\big\|\tilde{\bm{\theta}}\big(\mathbf{s}(\mathbf{x})\big)-\tilde{\bm{\theta}}\big(\mathbf{s}(\mathbf{x}^{\prime})\big)\big\|_{\infty}\leq 2\big\|\mathbf{h}\big(\mathbf{s}(\mathbf{x})\big)-\mathbf{h}\big(\mathbf{s}(\mathbf{x}^{\prime})\big)\big\|_{2}</annotation></semantics></math></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A6.Ex435.m2" class="ltx_Math" alttext="\displaystyle\leq 2\sqrt{m_{2}}\big\|\mathbf{h}\big(\mathbf{s}(\mathbf{x})\big)-\mathbf{h}\big(\mathbf{s}(\mathbf{x}^{\prime})\big)\big\|_{\infty}" display="inline" intent=":literal"><semantics><mrow><mphantom></mphantom><mo>≤</mo><mrow><mn>2</mn><mo lspace="0em" rspace="0em">​</mo><msqrt><msub><mi>m</mi><mn>2</mn></msub></msqrt><mo lspace="0em" rspace="0em">​</mo><msub><mrow><mo maxsize="1.200em" minsize="1.200em" stretchy="true">‖</mo><mrow><mrow><mi>𝐡</mi><mo>⁡</mo><mrow><mo maxsize="1.200em" minsize="1.200em">(</mo><mrow><mi>𝐬</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>𝐱</mi><mo stretchy="false">)</mo></mrow></mrow><mo maxsize="1.200em" minsize="1.200em">)</mo></mrow></mrow><mo>−</mo><mrow><mi>𝐡</mi><mo>⁡</mo><mrow><mo maxsize="1.200em" minsize="1.200em">(</mo><mrow><mi>𝐬</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><msup><mi>𝐱</mi><mo>′</mo></msup><mo stretchy="false">)</mo></mrow></mrow><mo maxsize="1.200em" minsize="1.200em">)</mo></mrow></mrow></mrow><mo maxsize="1.200em" minsize="1.200em" stretchy="true">‖</mo></mrow><mi mathvariant="normal">∞</mi></msub></mrow></mrow><annotation encoding="application/x-tex">\displaystyle\leq 2\sqrt{m_{2}}\big\|\mathbf{h}\big(\mathbf{s}(\mathbf{x})\big)-\mathbf{h}\big(\mathbf{s}(\mathbf{x}^{\prime})\big)\big\|_{\infty}</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
<tbody id="A6.Ex436"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_eqn_cell"></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A6.Ex436.m1" class="ltx_Math" alttext="\displaystyle\leq 2\sqrt{m_{2}}\big\|\mathbf{h}\|_{\mathcal{C}^{\beta_{2}}}\|\mathbf{s}(\mathbf{x})-\mathbf{s}(\mathbf{x}^{\prime})\big\|_{\infty}^{\beta_{2}}." display="inline" intent=":literal"><semantics><mrow><mrow><mphantom></mphantom><mo>≤</mo><mrow><mn>2</mn><mo lspace="0em" rspace="0em">​</mo><msqrt><msub><mi>m</mi><mn>2</mn></msub></msqrt><mo lspace="0em" rspace="0em">​</mo><msub><mrow><mo maxsize="1.200em" minsize="1.200em" stretchy="true">‖</mo><mi>𝐡</mi><mo stretchy="false">‖</mo></mrow><msup><mi class="ltx_font_mathcaligraphic">𝒞</mi><msub><mi>β</mi><mn>2</mn></msub></msup></msub><mo lspace="0em" rspace="0em">​</mo><msubsup><mrow><mo stretchy="false">‖</mo><mrow><mrow><mi>𝐬</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>𝐱</mi><mo stretchy="false">)</mo></mrow></mrow><mo>−</mo><mrow><mi>𝐬</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><msup><mi>𝐱</mi><mo>′</mo></msup><mo stretchy="false">)</mo></mrow></mrow></mrow><mo maxsize="1.200em" minsize="1.200em" stretchy="true">‖</mo></mrow><mi mathvariant="normal">∞</mi><msub><mi>β</mi><mn>2</mn></msub></msubsup></mrow></mrow><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">\displaystyle\leq 2\sqrt{m_{2}}\big\|\mathbf{h}\|_{\mathcal{C}^{\beta_{2}}}\|\mathbf{s}(\mathbf{x})-\mathbf{s}(\mathbf{x}^{\prime})\big\|_{\infty}^{\beta_{2}}.</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="A6.SS4.p3.2" class="ltx_p"><span id="A6.SS4.p3.2.1" class="ltx_text">Using <math id="A6.SS4.p3.m2" class="ltx_Math" alttext="\bm{\theta}(\mathbf{x})=\mathbf{m}(\mathbf{x})/\|\mathbf{m}(\mathbf{x})\|_{2}=\tilde{\bm{\theta}}(\mathbf{s}(\mathbf{x}))/\|\tilde{\bm{\theta}}(\mathbf{s}(\mathbf{x}))\|_{2}" display="inline" intent=":literal"><semantics><mrow><mrow><mi>𝜽</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>𝐱</mi><mo stretchy="false">)</mo></mrow></mrow><mo>=</mo><mrow><mrow><mi>𝐦</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>𝐱</mi><mo stretchy="false">)</mo></mrow></mrow><mo>/</mo><msub><mrow><mo stretchy="false">‖</mo><mrow><mi>𝐦</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>𝐱</mi><mo stretchy="false">)</mo></mrow></mrow><mo stretchy="false">‖</mo></mrow><mn>2</mn></msub></mrow><mo>=</mo><mrow><mrow><mover accent="true"><mi>𝜽</mi><mo>~</mo></mover><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mrow><mi>𝐬</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>𝐱</mi><mo stretchy="false">)</mo></mrow></mrow><mo stretchy="false">)</mo></mrow></mrow><mo>/</mo><msub><mrow><mo stretchy="false">‖</mo><mrow><mover accent="true"><mi>𝜽</mi><mo>~</mo></mover><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mrow><mi>𝐬</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>𝐱</mi><mo stretchy="false">)</mo></mrow></mrow><mo stretchy="false">)</mo></mrow></mrow><mo stretchy="false">‖</mo></mrow><mn>2</mn></msub></mrow></mrow><annotation encoding="application/x-tex">\bm{\theta}(\mathbf{x})=\mathbf{m}(\mathbf{x})/\|\mathbf{m}(\mathbf{x})\|_{2}=\tilde{\bm{\theta}}(\mathbf{s}(\mathbf{x}))/\|\tilde{\bm{\theta}}(\mathbf{s}(\mathbf{x}))\|_{2}</annotation></semantics></math> and (<a href="#A6.E117" title="In Proof. ‣ F.4 Proof of Lemma ‣ Appendix F Directional Convergence of the Nadaraya–Watson Estimator ‣ Generalization Bounds for Transformer-Based Next-Token Prediction in a Language Model" class="ltx_ref"><span class="ltx_text ltx_ref_tag">117</span></a>), we get the assertion by</span></p>
<table id="A6.EGx186" class="ltx_equationgroup ltx_eqn_align ltx_eqn_table">

<tbody id="A6.Ex437"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_align_right ltx_eqn_cell"><math id="A6.Ex437.m1" class="ltx_Math" alttext="\displaystyle\|\bm{\theta}(\mathbf{x})-\bm{\theta}(\mathbf{x}^{\prime})\|_{2}" display="inline" intent=":literal"><semantics><msub><mrow><mo stretchy="false">‖</mo><mrow><mrow><mi>𝜽</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>𝐱</mi><mo stretchy="false">)</mo></mrow></mrow><mo>−</mo><mrow><mi>𝜽</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><msup><mi>𝐱</mi><mo>′</mo></msup><mo stretchy="false">)</mo></mrow></mrow></mrow><mo stretchy="false">‖</mo></mrow><mn>2</mn></msub><annotation encoding="application/x-tex">\displaystyle\|\bm{\theta}(\mathbf{x})-\bm{\theta}(\mathbf{x}^{\prime})\|_{2}</annotation></semantics></math></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A6.Ex437.m2" class="ltx_Math" alttext="\displaystyle=\left\|\frac{\tilde{\bm{\theta}}\big(\mathbf{s}(\mathbf{x})\big)}{\|\tilde{\bm{\theta}}\big(\mathbf{s}(\mathbf{x})\big)\|_{2}}-\frac{\tilde{\bm{\theta}}\big(\mathbf{s}(\mathbf{x}^{\prime})\big)}{\|\tilde{\bm{\theta}}\big(\mathbf{s}(\mathbf{x}^{\prime})\big)\|_{2}}\right\|_{2}" display="inline" intent=":literal"><semantics><mrow><mphantom></mphantom><mo>=</mo><msub><mrow><mo>‖</mo><mrow><mstyle displaystyle="true"><mfrac><mrow><mover accent="true"><mi>𝜽</mi><mo>~</mo></mover><mo lspace="0em" rspace="0em">​</mo><mrow><mo maxsize="1.200em" minsize="1.200em">(</mo><mrow><mi>𝐬</mi><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>𝐱</mi><mo stretchy="false">)</mo></mrow></mrow><mo maxsize="1.200em" minsize="1.200em">)</mo></mrow></mrow><msub><mrow><mo stretchy="false">‖</mo><mrow><mover accent="true"><mi>𝜽</mi><mo>~</mo></mover><mo lspace="0em" rspace="0em">​</mo><mrow><mo maxsize="1.200em" minsize="1.200em">(</mo><mrow><mi>𝐬</mi><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>𝐱</mi><mo stretchy="false">)</mo></mrow></mrow><mo maxsize="1.200em" minsize="1.200em">)</mo></mrow></mrow><mo stretchy="false">‖</mo></mrow><mn>2</mn></msub></mfrac></mstyle><mo>−</mo><mstyle displaystyle="true"><mfrac><mrow><mover accent="true"><mi>𝜽</mi><mo>~</mo></mover><mo lspace="0em" rspace="0em">​</mo><mrow><mo maxsize="1.200em" minsize="1.200em">(</mo><mrow><mi>𝐬</mi><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msup><mi>𝐱</mi><mo>′</mo></msup><mo stretchy="false">)</mo></mrow></mrow><mo maxsize="1.200em" minsize="1.200em">)</mo></mrow></mrow><msub><mrow><mo stretchy="false">‖</mo><mrow><mover accent="true"><mi>𝜽</mi><mo>~</mo></mover><mo lspace="0em" rspace="0em">​</mo><mrow><mo maxsize="1.200em" minsize="1.200em">(</mo><mrow><mi>𝐬</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><msup><mi>𝐱</mi><mo>′</mo></msup><mo stretchy="false">)</mo></mrow></mrow><mo maxsize="1.200em" minsize="1.200em">)</mo></mrow></mrow><mo stretchy="false">‖</mo></mrow><mn>2</mn></msub></mfrac></mstyle></mrow><mo>‖</mo></mrow><mn>2</mn></msub></mrow><annotation encoding="application/x-tex">\displaystyle=\left\|\frac{\tilde{\bm{\theta}}\big(\mathbf{s}(\mathbf{x})\big)}{\|\tilde{\bm{\theta}}\big(\mathbf{s}(\mathbf{x})\big)\|_{2}}-\frac{\tilde{\bm{\theta}}\big(\mathbf{s}(\mathbf{x}^{\prime})\big)}{\|\tilde{\bm{\theta}}\big(\mathbf{s}(\mathbf{x}^{\prime})\big)\|_{2}}\right\|_{2}</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
<tbody id="A6.Ex438"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_eqn_cell"></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A6.Ex438.m1" class="ltx_Math" alttext="\displaystyle\leq\left\|\frac{\tilde{\bm{\theta}}\big(\mathbf{s}(\mathbf{x})\big)-\tilde{\bm{\theta}}\big(\mathbf{s}(\mathbf{x}^{\prime})\big)}{\|\tilde{\bm{\theta}}\big(\mathbf{s}(\mathbf{x})\big)\|_{2}}\right\|_{2}+\left\|\left(\frac{1}{\|\tilde{\bm{\theta}}\big(\mathbf{s}(\mathbf{x})\big)\|_{2}}-\frac{1}{\|\tilde{\bm{\theta}}\big(\mathbf{s}(\mathbf{x}^{\prime})\big)\|_{2}}\right)\tilde{\bm{\theta}}\big(\mathbf{s}(\mathbf{x}^{\prime})\big)\right\|_{2}" display="inline" intent=":literal"><semantics><mrow><mphantom></mphantom><mo>≤</mo><mrow><msub><mrow><mo>‖</mo><mstyle displaystyle="true"><mfrac><mrow><mrow><mover accent="true"><mi>𝜽</mi><mo>~</mo></mover><mo lspace="0em" rspace="0em">​</mo><mrow><mo maxsize="1.200em" minsize="1.200em">(</mo><mrow><mi>𝐬</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>𝐱</mi><mo stretchy="false">)</mo></mrow></mrow><mo maxsize="1.200em" minsize="1.200em">)</mo></mrow></mrow><mo>−</mo><mrow><mover accent="true"><mi>𝜽</mi><mo>~</mo></mover><mo lspace="0em" rspace="0em">​</mo><mrow><mo maxsize="1.200em" minsize="1.200em">(</mo><mrow><mi>𝐬</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><msup><mi>𝐱</mi><mo>′</mo></msup><mo stretchy="false">)</mo></mrow></mrow><mo maxsize="1.200em" minsize="1.200em">)</mo></mrow></mrow></mrow><msub><mrow><mo stretchy="false">‖</mo><mrow><mover accent="true"><mi>𝜽</mi><mo>~</mo></mover><mo lspace="0em" rspace="0em">​</mo><mrow><mo maxsize="1.200em" minsize="1.200em">(</mo><mrow><mi>𝐬</mi><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>𝐱</mi><mo stretchy="false">)</mo></mrow></mrow><mo maxsize="1.200em" minsize="1.200em">)</mo></mrow></mrow><mo stretchy="false">‖</mo></mrow><mn>2</mn></msub></mfrac></mstyle><mo>‖</mo></mrow><mn>2</mn></msub><mo>+</mo><msub><mrow><mo>‖</mo><mrow><mrow><mo>(</mo><mrow><mstyle displaystyle="true"><mfrac><mn>1</mn><msub><mrow><mo stretchy="false">‖</mo><mrow><mover accent="true"><mi>𝜽</mi><mo>~</mo></mover><mo lspace="0em" rspace="0em">​</mo><mrow><mo maxsize="1.200em" minsize="1.200em">(</mo><mrow><mi>𝐬</mi><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>𝐱</mi><mo stretchy="false">)</mo></mrow></mrow><mo maxsize="1.200em" minsize="1.200em">)</mo></mrow></mrow><mo stretchy="false">‖</mo></mrow><mn>2</mn></msub></mfrac></mstyle><mo>−</mo><mstyle displaystyle="true"><mfrac><mn>1</mn><msub><mrow><mo stretchy="false">‖</mo><mrow><mover accent="true"><mi>𝜽</mi><mo>~</mo></mover><mo lspace="0em" rspace="0em">​</mo><mrow><mo maxsize="1.200em" minsize="1.200em">(</mo><mrow><mi>𝐬</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><msup><mi>𝐱</mi><mo>′</mo></msup><mo stretchy="false">)</mo></mrow></mrow><mo maxsize="1.200em" minsize="1.200em">)</mo></mrow></mrow><mo stretchy="false">‖</mo></mrow><mn>2</mn></msub></mfrac></mstyle></mrow><mo>)</mo></mrow><mo lspace="0em" rspace="0em">​</mo><mover accent="true"><mi>𝜽</mi><mo>~</mo></mover><mo lspace="0em" rspace="0em">​</mo><mrow><mo maxsize="1.200em" minsize="1.200em">(</mo><mrow><mi>𝐬</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><msup><mi>𝐱</mi><mo>′</mo></msup><mo stretchy="false">)</mo></mrow></mrow><mo maxsize="1.200em" minsize="1.200em">)</mo></mrow></mrow><mo>‖</mo></mrow><mn>2</mn></msub></mrow></mrow><annotation encoding="application/x-tex">\displaystyle\leq\left\|\frac{\tilde{\bm{\theta}}\big(\mathbf{s}(\mathbf{x})\big)-\tilde{\bm{\theta}}\big(\mathbf{s}(\mathbf{x}^{\prime})\big)}{\|\tilde{\bm{\theta}}\big(\mathbf{s}(\mathbf{x})\big)\|_{2}}\right\|_{2}+\left\|\left(\frac{1}{\|\tilde{\bm{\theta}}\big(\mathbf{s}(\mathbf{x})\big)\|_{2}}-\frac{1}{\|\tilde{\bm{\theta}}\big(\mathbf{s}(\mathbf{x}^{\prime})\big)\|_{2}}\right)\tilde{\bm{\theta}}\big(\mathbf{s}(\mathbf{x}^{\prime})\big)\right\|_{2}</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
<tbody id="A6.Ex439"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_eqn_cell"></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A6.Ex439.m1" class="ltx_Math" alttext="\displaystyle\leq\frac{4m_{2}\|\mathbf{h}\|_{\mathcal{C}^{\beta_{2}}}}{\varrho}\|\mathbf{s}(\mathbf{x})-\mathbf{s}(\mathbf{x}^{\prime})\|_{\infty}^{\beta_{2}}." display="inline" intent=":literal"><semantics><mrow><mrow><mphantom></mphantom><mo>≤</mo><mrow><mstyle displaystyle="true"><mfrac><mrow><mn>4</mn><mo lspace="0em" rspace="0em">​</mo><msub><mi>m</mi><mn>2</mn></msub><mo lspace="0em" rspace="0em">​</mo><msub><mrow><mo stretchy="false">‖</mo><mi>𝐡</mi><mo stretchy="false">‖</mo></mrow><msup><mi class="ltx_font_mathcaligraphic">𝒞</mi><msub><mi>β</mi><mn>2</mn></msub></msup></msub></mrow><mi>ϱ</mi></mfrac></mstyle><mo lspace="0em" rspace="0em">​</mo><msubsup><mrow><mo stretchy="false">‖</mo><mrow><mrow><mi>𝐬</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>𝐱</mi><mo stretchy="false">)</mo></mrow></mrow><mo>−</mo><mrow><mi>𝐬</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><msup><mi>𝐱</mi><mo>′</mo></msup><mo stretchy="false">)</mo></mrow></mrow></mrow><mo stretchy="false">‖</mo></mrow><mi mathvariant="normal">∞</mi><msub><mi>β</mi><mn>2</mn></msub></msubsup></mrow></mrow><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">\displaystyle\leq\frac{4m_{2}\|\mathbf{h}\|_{\mathcal{C}^{\beta_{2}}}}{\varrho}\|\mathbf{s}(\mathbf{x})-\mathbf{s}(\mathbf{x}^{\prime})\|_{\infty}^{\beta_{2}}.</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
</div>
<div id="A6.SS4.p4" class="ltx_para">
<p id="A6.SS4.p4.1" class="ltx_p"><span id="A6.SS4.p4.1.1" class="ltx_text ltx_font_bold">(iv)<span id="A6.SS4.p4.1.1.1" class="ltx_text ltx_font_medium">
By (<a href="#A6.E98" title="In Proof of Lemma . ‣ F.1 Proof of Lemma ‣ Appendix F Directional Convergence of the Nadaraya–Watson Estimator ‣ Generalization Bounds for Transformer-Based Next-Token Prediction in a Language Model" class="ltx_ref"><span class="ltx_text ltx_ref_tag">98</span></a>),
<math id="A6.SS4.p4.m1" class="ltx_Math" alttext="\max_{\mathbf{x}\in\mathcal{E}_{W}^{r}}\rho(\mathbf{x})\big/\min_{\mathbf{x}\in\mathcal{E}_{W}^{r}}\rho(\mathbf{x})" display="inline" intent=":literal"><semantics><mrow><mrow><msub><mi>max</mi><mrow><mi>𝐱</mi><mo>∈</mo><msubsup><mi class="ltx_font_mathcaligraphic">ℰ</mi><mi>W</mi><mi>r</mi></msubsup></mrow></msub><mo lspace="0.167em">⁡</mo><mrow><mi>ρ</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>𝐱</mi><mo stretchy="false">)</mo></mrow></mrow></mrow><mo maxsize="1.200em" minsize="1.200em" stretchy="true" symmetric="true">/</mo><mrow><msub><mi>min</mi><mrow><mi>𝐱</mi><mo>∈</mo><msubsup><mi class="ltx_font_mathcaligraphic">ℰ</mi><mi>W</mi><mi>r</mi></msubsup></mrow></msub><mo lspace="0.167em">⁡</mo><mrow><mi>ρ</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>𝐱</mi><mo stretchy="false">)</mo></mrow></mrow></mrow></mrow><annotation encoding="application/x-tex">\max_{\mathbf{x}\in\mathcal{E}_{W}^{r}}\rho(\mathbf{x})\big/\min_{\mathbf{x}\in\mathcal{E}_{W}^{r}}\rho(\mathbf{x})</annotation></semantics></math> is bounded above by a constant that depends only on <math id="A6.SS4.p4.m2" class="ltx_Math" alttext="(m_{1},\delta_{1},\delta_{2})" display="inline" intent=":literal"><semantics><mrow><mo stretchy="false">(</mo><msub><mi>m</mi><mn>1</mn></msub><mo>,</mo><msub><mi>δ</mi><mn>1</mn></msub><mo>,</mo><msub><mi>δ</mi><mn>2</mn></msub><mo stretchy="false">)</mo></mrow><annotation encoding="application/x-tex">(m_{1},\delta_{1},\delta_{2})</annotation></semantics></math>.
For any <math id="A6.SS4.p4.m3" class="ltx_Math" alttext="\mathbf{x}\in\mathcal{E}_{W}^{r}" display="inline" intent=":literal"><semantics><mrow><mi>𝐱</mi><mo>∈</mo><msubsup><mi class="ltx_font_mathcaligraphic">ℰ</mi><mi>W</mi><mi>r</mi></msubsup></mrow><annotation encoding="application/x-tex">\mathbf{x}\in\mathcal{E}_{W}^{r}</annotation></semantics></math>,
it follows using the definition <math id="A6.SS4.p4.m4" class="ltx_math_unparsed" alttext="K_{\lambda}(\mathbf{z},\mathbf{z}^{\prime})=\exp(-\|\mathbf{z}-\mathbf{z}^{\prime}\|^{2}/(2\lambda^{2}))," display="inline" intent=":literal"><semantics><mrow><msub><mi>K</mi><mi>λ</mi></msub><mrow><mo stretchy="false">(</mo><mi>𝐳</mi><mo>,</mo><msup><mi>𝐳</mi><mo>′</mo></msup><mo stretchy="false">)</mo></mrow><mo>=</mo><mi>exp</mi><mrow><mo stretchy="false">(</mo><mo lspace="0em" rspace="0em">−</mo><mo lspace="0em" rspace="0.167em">∥</mo><mi>𝐳</mi><mo>−</mo><msup><mi>𝐳</mi><mo>′</mo></msup><msup><mo lspace="0em" rspace="0em">∥</mo><mn>2</mn></msup><mo lspace="0em">/</mo><mrow><mo stretchy="false">(</mo><mn>2</mn><msup><mi>λ</mi><mn>2</mn></msup><mo stretchy="false">)</mo></mrow><mo stretchy="false">)</mo></mrow><mo>,</mo></mrow><annotation encoding="application/x-tex">K_{\lambda}(\mathbf{z},\mathbf{z}^{\prime})=\exp(-\|\mathbf{z}-\mathbf{z}^{\prime}\|^{2}/(2\lambda^{2})),</annotation></semantics></math></span></span></p>
<table id="A6.EGx187" class="ltx_equationgroup ltx_eqn_align ltx_eqn_table">

<tbody id="A6.Ex440"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_align_right ltx_eqn_cell"><math id="A6.Ex440.m1" class="ltx_Math" alttext="\displaystyle\mathbb{E}_{\rho}\big[K_{\lambda}\big(\mathbf{s}(\bm{\xi}),\mathbf{s}(\mathbf{x})\big)\big]" display="inline" intent=":literal"><semantics><mrow><msub><mi>𝔼</mi><mi>ρ</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo maxsize="1.200em" minsize="1.200em">[</mo><mrow><msub><mi>K</mi><mi>λ</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo maxsize="1.200em" minsize="1.200em">(</mo><mrow><mi>𝐬</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>𝝃</mi><mo stretchy="false">)</mo></mrow></mrow><mo>,</mo><mrow><mi>𝐬</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>𝐱</mi><mo stretchy="false">)</mo></mrow></mrow><mo maxsize="1.200em" minsize="1.200em">)</mo></mrow></mrow><mo maxsize="1.200em" minsize="1.200em">]</mo></mrow></mrow><annotation encoding="application/x-tex">\displaystyle\mathbb{E}_{\rho}\big[K_{\lambda}\big(\mathbf{s}(\bm{\xi}),\mathbf{s}(\mathbf{x})\big)\big]</annotation></semantics></math></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A6.Ex440.m2" class="ltx_Math" alttext="\displaystyle\geq\mathbb{E}_{\rho}\big[K_{\lambda}\big(\mathbf{s}(\bm{\xi}),\mathbf{s}(\mathbf{x})\big)\mathbb{I}\big(\|\mathbf{s}(\bm{\xi})-\mathbf{s}(\mathbf{x})\|_{2}\leq\sqrt{r_{2}}\lambda\big)\big]" display="inline" intent=":literal"><semantics><mrow><mphantom></mphantom><mo>≥</mo><mrow><msub><mi>𝔼</mi><mi>ρ</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo maxsize="1.200em" minsize="1.200em">[</mo><mrow><msub><mi>K</mi><mi>λ</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo maxsize="1.200em" minsize="1.200em">(</mo><mrow><mi>𝐬</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>𝝃</mi><mo stretchy="false">)</mo></mrow></mrow><mo>,</mo><mrow><mi>𝐬</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>𝐱</mi><mo stretchy="false">)</mo></mrow></mrow><mo maxsize="1.200em" minsize="1.200em">)</mo></mrow><mo lspace="0em" rspace="0em">​</mo><mi>𝕀</mi><mo lspace="0em" rspace="0em">​</mo><mrow><mo maxsize="1.200em" minsize="1.200em">(</mo><mrow><msub><mrow><mo stretchy="false">‖</mo><mrow><mrow><mi>𝐬</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>𝝃</mi><mo stretchy="false">)</mo></mrow></mrow><mo>−</mo><mrow><mi>𝐬</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>𝐱</mi><mo stretchy="false">)</mo></mrow></mrow></mrow><mo stretchy="false">‖</mo></mrow><mn>2</mn></msub><mo>≤</mo><mrow><msqrt><msub><mi>r</mi><mn>2</mn></msub></msqrt><mo lspace="0em" rspace="0em">​</mo><mi>λ</mi></mrow></mrow><mo maxsize="1.200em" minsize="1.200em">)</mo></mrow></mrow><mo maxsize="1.200em" minsize="1.200em">]</mo></mrow></mrow></mrow><annotation encoding="application/x-tex">\displaystyle\geq\mathbb{E}_{\rho}\big[K_{\lambda}\big(\mathbf{s}(\bm{\xi}),\mathbf{s}(\mathbf{x})\big)\mathbb{I}\big(\|\mathbf{s}(\bm{\xi})-\mathbf{s}(\mathbf{x})\|_{2}\leq\sqrt{r_{2}}\lambda\big)\big]</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
<tbody id="A6.Ex441"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_eqn_cell"></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A6.Ex441.m1" class="ltx_math_unparsed" alttext="\displaystyle\geq\exp(-r_{2}/2)\rho\big(\bm{\xi}:\|\mathbf{s}(\bm{\xi})-\mathbf{s}(\mathbf{x})\|_{2}\leq\sqrt{r_{2}}\lambda\big)" display="inline" intent=":literal"><semantics><mrow><mo>≥</mo><mi>exp</mi><mrow><mo stretchy="false">(</mo><mo lspace="0em">−</mo><msub><mi>r</mi><mn>2</mn></msub><mo>/</mo><mn>2</mn><mo stretchy="false">)</mo></mrow><mi>ρ</mi><mrow><mo maxsize="1.200em" minsize="1.200em">(</mo><mi>𝝃</mi><mo lspace="0.278em" rspace="0em">:</mo><mo lspace="0em" rspace="0.167em">∥</mo><mi>𝐬</mi><mrow><mo stretchy="false">(</mo><mi>𝝃</mi><mo stretchy="false">)</mo></mrow><mo>−</mo><mi>𝐬</mi><mrow><mo stretchy="false">(</mo><mi>𝐱</mi><mo stretchy="false">)</mo></mrow><msub><mo lspace="0em" rspace="0.0835em">∥</mo><mn>2</mn></msub><mo lspace="0.0835em">≤</mo><msqrt><msub><mi>r</mi><mn>2</mn></msub></msqrt><mi>λ</mi><mo maxsize="1.200em" minsize="1.200em">)</mo></mrow></mrow><annotation encoding="application/x-tex">\displaystyle\geq\exp(-r_{2}/2)\rho\big(\bm{\xi}:\|\mathbf{s}(\bm{\xi})-\mathbf{s}(\mathbf{x})\|_{2}\leq\sqrt{r_{2}}\lambda\big)</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
<tbody id="A6.Ex442"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_eqn_cell"></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A6.Ex442.m1" class="ltx_Math" alttext="\displaystyle\gtrsim\frac{1}{W^{r}}\Big|\Big\{(\mathbf{x}^{\prime}_{1},\ldots,\mathbf{x}^{\prime}_{r})\in\mathcal{E}_{W}^{r}:\max_{1\leq i\leq r_{2}}\|\bm{\phi}_{2}(\mathbf{x}^{\prime}_{i})-\bm{\phi}_{2}(\mathbf{x}_{i})\|_{2}\leq\lambda\Big\}\Big|" display="inline" intent=":literal"><semantics><mrow><mphantom></mphantom><mo>≳</mo><mrow><mstyle displaystyle="true"><mfrac><mn>1</mn><msup><mi>W</mi><mi>r</mi></msup></mfrac></mstyle><mo lspace="0em" rspace="0em">​</mo><mrow><mo maxsize="1.600em" minsize="1.600em" stretchy="true">|</mo><mrow><mo stretchy="false">{</mo><mrow><mrow><mo stretchy="false">(</mo><msubsup><mi>𝐱</mi><mn>1</mn><mo>′</mo></msubsup><mo>,</mo><mi mathvariant="normal">…</mi><mo>,</mo><msubsup><mi>𝐱</mi><mi>r</mi><mo>′</mo></msubsup><mo stretchy="false">)</mo></mrow><mo>∈</mo><msubsup><mi class="ltx_font_mathcaligraphic">ℰ</mi><mi>W</mi><mi>r</mi></msubsup></mrow><mo lspace="0.278em" rspace="0.278em">:</mo><mrow><mrow><munder><mi>max</mi><mrow><mn>1</mn><mo>≤</mo><mi>i</mi><mo>≤</mo><msub><mi>r</mi><mn>2</mn></msub></mrow></munder><mo>⁡</mo><msub><mrow><mo stretchy="false">‖</mo><mrow><mrow><msub><mi class="ltx_mathvariant_bold-italic" mathvariant="bold-italic">ϕ</mi><mn>2</mn></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msubsup><mi>𝐱</mi><mi>i</mi><mo>′</mo></msubsup><mo stretchy="false">)</mo></mrow></mrow><mo>−</mo><mrow><msub><mi class="ltx_mathvariant_bold-italic" mathvariant="bold-italic">ϕ</mi><mn>2</mn></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mi>𝐱</mi><mi>i</mi></msub><mo stretchy="false">)</mo></mrow></mrow></mrow><mo stretchy="false">‖</mo></mrow><mn>2</mn></msub></mrow><mo>≤</mo><mi>λ</mi></mrow><mo stretchy="false">}</mo></mrow><mo maxsize="1.600em" minsize="1.600em" stretchy="true">|</mo></mrow></mrow></mrow><annotation encoding="application/x-tex">\displaystyle\gtrsim\frac{1}{W^{r}}\Big|\Big\{(\mathbf{x}^{\prime}_{1},\ldots,\mathbf{x}^{\prime}_{r})\in\mathcal{E}_{W}^{r}:\max_{1\leq i\leq r_{2}}\|\bm{\phi}_{2}(\mathbf{x}^{\prime}_{i})-\bm{\phi}_{2}(\mathbf{x}_{i})\|_{2}\leq\lambda\Big\}\Big|</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
<tbody id="A6.Ex443"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_eqn_cell"></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A6.Ex443.m1" class="ltx_Math" alttext="\displaystyle=\frac{1}{W^{r_{2}}}\Big|\Big\{(\mathbf{x}^{\prime}_{1},\ldots,\mathbf{x}^{\prime}_{r_{2}})\in\mathcal{E}_{W}^{r_{2}}:\max_{1\leq i\leq r_{2}}\|\bm{\phi}_{2}(\mathbf{x}^{\prime}_{i})-\bm{\phi}_{2}(\mathbf{x}_{i})\|_{2}\leq\lambda\Big\}\Big|" display="inline" intent=":literal"><semantics><mrow><mphantom></mphantom><mo>=</mo><mrow><mstyle displaystyle="true"><mfrac><mn>1</mn><msup><mi>W</mi><msub><mi>r</mi><mn>2</mn></msub></msup></mfrac></mstyle><mo lspace="0em" rspace="0em">​</mo><mrow><mo maxsize="1.600em" minsize="1.600em" stretchy="true">|</mo><mrow><mo stretchy="false">{</mo><mrow><mrow><mo stretchy="false">(</mo><msubsup><mi>𝐱</mi><mn>1</mn><mo>′</mo></msubsup><mo>,</mo><mi mathvariant="normal">…</mi><mo>,</mo><msubsup><mi>𝐱</mi><msub><mi>r</mi><mn>2</mn></msub><mo>′</mo></msubsup><mo stretchy="false">)</mo></mrow><mo>∈</mo><msubsup><mi class="ltx_font_mathcaligraphic">ℰ</mi><mi>W</mi><msub><mi>r</mi><mn>2</mn></msub></msubsup></mrow><mo lspace="0.278em" rspace="0.278em">:</mo><mrow><mrow><munder><mi>max</mi><mrow><mn>1</mn><mo>≤</mo><mi>i</mi><mo>≤</mo><msub><mi>r</mi><mn>2</mn></msub></mrow></munder><mo>⁡</mo><msub><mrow><mo stretchy="false">‖</mo><mrow><mrow><msub><mi class="ltx_mathvariant_bold-italic" mathvariant="bold-italic">ϕ</mi><mn>2</mn></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msubsup><mi>𝐱</mi><mi>i</mi><mo>′</mo></msubsup><mo stretchy="false">)</mo></mrow></mrow><mo>−</mo><mrow><msub><mi class="ltx_mathvariant_bold-italic" mathvariant="bold-italic">ϕ</mi><mn>2</mn></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mi>𝐱</mi><mi>i</mi></msub><mo stretchy="false">)</mo></mrow></mrow></mrow><mo stretchy="false">‖</mo></mrow><mn>2</mn></msub></mrow><mo>≤</mo><mi>λ</mi></mrow><mo stretchy="false">}</mo></mrow><mo maxsize="1.600em" minsize="1.600em" stretchy="true">|</mo></mrow></mrow></mrow><annotation encoding="application/x-tex">\displaystyle=\frac{1}{W^{r_{2}}}\Big|\Big\{(\mathbf{x}^{\prime}_{1},\ldots,\mathbf{x}^{\prime}_{r_{2}})\in\mathcal{E}_{W}^{r_{2}}:\max_{1\leq i\leq r_{2}}\|\bm{\phi}_{2}(\mathbf{x}^{\prime}_{i})-\bm{\phi}_{2}(\mathbf{x}_{i})\|_{2}\leq\lambda\Big\}\Big|</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
<tbody id="A6.Ex444"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_eqn_cell"></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A6.Ex444.m1" class="ltx_Math" alttext="\displaystyle\geq\left(\inf_{\mathbf{x}\in\mathcal{E}_{W}}\frac{1}{W}\Big|\Big\{\mathbf{x}^{\prime}\in\mathcal{E}_{W}:\|\bm{\phi}_{2}(\mathbf{x}^{\prime})-\bm{\phi}_{2}(\mathbf{x})\|_{2}\leq\lambda\Big\}\Big|\right)^{r_{2}}" display="inline" intent=":literal"><semantics><mrow><mphantom></mphantom><mo>≥</mo><msup><mrow><mo>(</mo><mrow><munder><mo lspace="0em" movablelimits="false" rspace="0.167em">inf</mo><mrow><mi>𝐱</mi><mo>∈</mo><msub><mi class="ltx_font_mathcaligraphic">ℰ</mi><mi>W</mi></msub></mrow></munder><mrow><mstyle displaystyle="true"><mfrac><mn>1</mn><mi>W</mi></mfrac></mstyle><mo lspace="0em" rspace="0em">​</mo><mrow><mo maxsize="1.600em" minsize="1.600em" stretchy="true">|</mo><mrow><mo stretchy="false">{</mo><mrow><msup><mi>𝐱</mi><mo>′</mo></msup><mo>∈</mo><msub><mi class="ltx_font_mathcaligraphic">ℰ</mi><mi>W</mi></msub></mrow><mo lspace="0.278em" rspace="0.278em">:</mo><mrow><msub><mrow><mo stretchy="false">‖</mo><mrow><mrow><msub><mi class="ltx_mathvariant_bold-italic" mathvariant="bold-italic">ϕ</mi><mn>2</mn></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msup><mi>𝐱</mi><mo>′</mo></msup><mo stretchy="false">)</mo></mrow></mrow><mo>−</mo><mrow><msub><mi class="ltx_mathvariant_bold-italic" mathvariant="bold-italic">ϕ</mi><mn>2</mn></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>𝐱</mi><mo stretchy="false">)</mo></mrow></mrow></mrow><mo stretchy="false">‖</mo></mrow><mn>2</mn></msub><mo>≤</mo><mi>λ</mi></mrow><mo stretchy="false">}</mo></mrow><mo maxsize="1.600em" minsize="1.600em" stretchy="true">|</mo></mrow></mrow></mrow><mo>)</mo></mrow><msub><mi>r</mi><mn>2</mn></msub></msup></mrow><annotation encoding="application/x-tex">\displaystyle\geq\left(\inf_{\mathbf{x}\in\mathcal{E}_{W}}\frac{1}{W}\Big|\Big\{\mathbf{x}^{\prime}\in\mathcal{E}_{W}:\|\bm{\phi}_{2}(\mathbf{x}^{\prime})-\bm{\phi}_{2}(\mathbf{x})\|_{2}\leq\lambda\Big\}\Big|\right)^{r_{2}}</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
<tbody id="A6.Ex445"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_eqn_cell"></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A6.Ex445.m1" class="ltx_Math" alttext="\displaystyle=\varphi_{W}(\lambda)^{r_{2}}," display="inline" intent=":literal"><semantics><mrow><mrow><mphantom></mphantom><mo>=</mo><mrow><msub><mi>φ</mi><mi>W</mi></msub><mo lspace="0em" rspace="0em">​</mo><msup><mrow><mo stretchy="false">(</mo><mi>λ</mi><mo stretchy="false">)</mo></mrow><msub><mi>r</mi><mn>2</mn></msub></msup></mrow></mrow><mo>,</mo></mrow><annotation encoding="application/x-tex">\displaystyle=\varphi_{W}(\lambda)^{r_{2}},</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="A6.SS4.p4.2" class="ltx_p"><span id="A6.SS4.p4.2.1" class="ltx_text">where the implicit constant of <math id="A6.SS4.p4.m5" class="ltx_Math" alttext="\gtrsim" display="inline" intent=":literal"><semantics><mo>≳</mo><annotation encoding="application/x-tex">\gtrsim</annotation></semantics></math> depends only on <math id="A6.SS4.p4.m6" class="ltx_Math" alttext="(m_{1},\delta_{1},\delta_{2},r_{2})" display="inline" intent=":literal"><semantics><mrow><mo stretchy="false">(</mo><msub><mi>m</mi><mn>1</mn></msub><mo>,</mo><msub><mi>δ</mi><mn>1</mn></msub><mo>,</mo><msub><mi>δ</mi><mn>2</mn></msub><mo>,</mo><msub><mi>r</mi><mn>2</mn></msub><mo stretchy="false">)</mo></mrow><annotation encoding="application/x-tex">(m_{1},\delta_{1},\delta_{2},r_{2})</annotation></semantics></math>.</span></p>
</div>
<div id="A6.SS4.p5" class="ltx_para">
<p id="A6.SS4.p5.1" class="ltx_p"><span id="A6.SS4.p5.1.1" class="ltx_text ltx_font_bold">(v)<span id="A6.SS4.p5.1.1.1" class="ltx_text ltx_font_medium">
By definition, <math id="A6.SS4.p5.m1" class="ltx_Math" alttext="P_{\bm{\theta}(\mathbf{x})}\mathbf{v}=\langle\bm{\theta}(\mathbf{x}),\mathbf{v}\rangle\bm{\theta}(\mathbf{x})" display="inline" intent=":literal"><semantics><mrow><mrow><msub><mi>P</mi><mrow><mi>𝜽</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>𝐱</mi><mo stretchy="false">)</mo></mrow></mrow></msub><mo lspace="0em" rspace="0em">​</mo><mi>𝐯</mi></mrow><mo>=</mo><mrow><mrow><mo stretchy="false">⟨</mo><mrow><mrow><mi>𝜽</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>𝐱</mi><mo stretchy="false">)</mo></mrow></mrow><mo>,</mo><mi>𝐯</mi></mrow><mo stretchy="false">⟩</mo></mrow><mo lspace="0em" rspace="0em">​</mo><mi>𝜽</mi><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>𝐱</mi><mo stretchy="false">)</mo></mrow></mrow></mrow><annotation encoding="application/x-tex">P_{\bm{\theta}(\mathbf{x})}\mathbf{v}=\langle\bm{\theta}(\mathbf{x}),\mathbf{v}\rangle\bm{\theta}(\mathbf{x})</annotation></semantics></math> for any <math id="A6.SS4.p5.m2" class="ltx_Math" alttext="\mathbf{v}\in\mathbb{R}^{m}" display="inline" intent=":literal"><semantics><mrow><mi>𝐯</mi><mo>∈</mo><msup><mi>ℝ</mi><mi>m</mi></msup></mrow><annotation encoding="application/x-tex">\mathbf{v}\in\mathbb{R}^{m}</annotation></semantics></math>. Hence for any <math id="A6.SS4.p5.m3" class="ltx_Math" alttext="\mathbf{x}\in\mathcal{E}_{W}^{r}" display="inline" intent=":literal"><semantics><mrow><mi>𝐱</mi><mo>∈</mo><msubsup><mi class="ltx_font_mathcaligraphic">ℰ</mi><mi>W</mi><mi>r</mi></msubsup></mrow><annotation encoding="application/x-tex">\mathbf{x}\in\mathcal{E}_{W}^{r}</annotation></semantics></math>,</span></span></p>
<table id="A6.EGx188" class="ltx_equationgroup ltx_eqn_align ltx_eqn_table">

<tbody id="A6.Ex446"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_align_right ltx_eqn_cell"><math id="A6.Ex446.m1" class="ltx_Math" alttext="\displaystyle\Big\|\mathbb{E}_{\rho}\big[K_{\lambda}\big(\mathbf{s}(\bm{\xi}),\mathbf{s}(\mathbf{x})\big)P_{\bm{\theta}(\mathbf{x})}\mathbf{m}(\bm{\xi})\big]\Big\|_{2}" display="inline" intent=":literal"><semantics><msub><mrow><mo maxsize="1.600em" minsize="1.600em" stretchy="true">‖</mo><mrow><msub><mi>𝔼</mi><mi>ρ</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo maxsize="1.200em" minsize="1.200em">[</mo><mrow><msub><mi>K</mi><mi>λ</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo maxsize="1.200em" minsize="1.200em">(</mo><mrow><mi>𝐬</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>𝝃</mi><mo stretchy="false">)</mo></mrow></mrow><mo>,</mo><mrow><mi>𝐬</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>𝐱</mi><mo stretchy="false">)</mo></mrow></mrow><mo maxsize="1.200em" minsize="1.200em">)</mo></mrow><mo lspace="0em" rspace="0em">​</mo><msub><mi>P</mi><mrow><mi>𝜽</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>𝐱</mi><mo stretchy="false">)</mo></mrow></mrow></msub><mo lspace="0em" rspace="0em">​</mo><mi>𝐦</mi><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>𝝃</mi><mo stretchy="false">)</mo></mrow></mrow><mo maxsize="1.200em" minsize="1.200em">]</mo></mrow></mrow><mo maxsize="1.600em" minsize="1.600em" stretchy="true">‖</mo></mrow><mn>2</mn></msub><annotation encoding="application/x-tex">\displaystyle\Big\|\mathbb{E}_{\rho}\big[K_{\lambda}\big(\mathbf{s}(\bm{\xi}),\mathbf{s}(\mathbf{x})\big)P_{\bm{\theta}(\mathbf{x})}\mathbf{m}(\bm{\xi})\big]\Big\|_{2}</annotation></semantics></math></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A6.Ex446.m2" class="ltx_Math" alttext="\displaystyle=\Big|\sum_{\mathbf{x}^{\prime}\in\mathcal{D}}K_{\lambda}(\mathbf{s}\big(\mathbf{x}^{\prime}),\mathbf{s}(\mathbf{x})\big)\rho(\mathbf{x}^{\prime})\langle\bm{\theta}(\mathbf{x}),\mathbf{m}(\mathbf{x}^{\prime})\rangle\Big|" display="inline" intent=":literal"><semantics><mrow><mphantom></mphantom><mo>=</mo><mrow><mo maxsize="1.600em" minsize="1.600em" stretchy="true">|</mo><mrow><mstyle displaystyle="true"><munder><mo movablelimits="false">∑</mo><mrow><msup><mi>𝐱</mi><mo>′</mo></msup><mo>∈</mo><mi class="ltx_font_mathcaligraphic">𝒟</mi></mrow></munder></mstyle><mrow><msub><mi>K</mi><mi>λ</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mrow><mi>𝐬</mi><mo>⁡</mo><mrow><mo maxsize="1.200em" minsize="1.200em">(</mo><msup><mi>𝐱</mi><mo>′</mo></msup><mo stretchy="false">)</mo></mrow></mrow><mo>,</mo><mrow><mi>𝐬</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>𝐱</mi><mo stretchy="false">)</mo></mrow></mrow><mo maxsize="1.200em" minsize="1.200em">)</mo></mrow><mo lspace="0em" rspace="0em">​</mo><mi>ρ</mi><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msup><mi>𝐱</mi><mo>′</mo></msup><mo stretchy="false">)</mo></mrow><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">⟨</mo><mrow><mrow><mi>𝜽</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>𝐱</mi><mo stretchy="false">)</mo></mrow></mrow><mo>,</mo><mrow><mi>𝐦</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><msup><mi>𝐱</mi><mo>′</mo></msup><mo stretchy="false">)</mo></mrow></mrow></mrow><mo stretchy="false">⟩</mo></mrow></mrow></mrow><mo maxsize="1.600em" minsize="1.600em" stretchy="true">|</mo></mrow></mrow><annotation encoding="application/x-tex">\displaystyle=\Big|\sum_{\mathbf{x}^{\prime}\in\mathcal{D}}K_{\lambda}(\mathbf{s}\big(\mathbf{x}^{\prime}),\mathbf{s}(\mathbf{x})\big)\rho(\mathbf{x}^{\prime})\langle\bm{\theta}(\mathbf{x}),\mathbf{m}(\mathbf{x}^{\prime})\rangle\Big|</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
<tbody id="A6.Ex447"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_eqn_cell"></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A6.Ex447.m1" class="ltx_Math" alttext="\displaystyle\geq\sum_{\mathbf{x}^{\prime}\in\mathcal{D}}K_{\lambda}(\mathbf{s}\big(\mathbf{x}^{\prime}),\mathbf{s}(\mathbf{x})\big)\rho(\mathbf{x}^{\prime})\langle\bm{\theta}(\mathbf{x}),\mathbf{m}(\mathbf{x}^{\prime})\rangle" display="inline" intent=":literal"><semantics><mrow><mphantom></mphantom><mo>≥</mo><mrow><mstyle displaystyle="true"><munder><mo movablelimits="false">∑</mo><mrow><msup><mi>𝐱</mi><mo>′</mo></msup><mo>∈</mo><mi class="ltx_font_mathcaligraphic">𝒟</mi></mrow></munder></mstyle><mrow><msub><mi>K</mi><mi>λ</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mrow><mi>𝐬</mi><mo>⁡</mo><mrow><mo maxsize="1.200em" minsize="1.200em">(</mo><msup><mi>𝐱</mi><mo>′</mo></msup><mo stretchy="false">)</mo></mrow></mrow><mo>,</mo><mrow><mi>𝐬</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>𝐱</mi><mo stretchy="false">)</mo></mrow></mrow><mo maxsize="1.200em" minsize="1.200em">)</mo></mrow><mo lspace="0em" rspace="0em">​</mo><mi>ρ</mi><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msup><mi>𝐱</mi><mo>′</mo></msup><mo stretchy="false">)</mo></mrow><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">⟨</mo><mrow><mrow><mi>𝜽</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>𝐱</mi><mo stretchy="false">)</mo></mrow></mrow><mo>,</mo><mrow><mi>𝐦</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><msup><mi>𝐱</mi><mo>′</mo></msup><mo stretchy="false">)</mo></mrow></mrow></mrow><mo stretchy="false">⟩</mo></mrow></mrow></mrow></mrow><annotation encoding="application/x-tex">\displaystyle\geq\sum_{\mathbf{x}^{\prime}\in\mathcal{D}}K_{\lambda}(\mathbf{s}\big(\mathbf{x}^{\prime}),\mathbf{s}(\mathbf{x})\big)\rho(\mathbf{x}^{\prime})\langle\bm{\theta}(\mathbf{x}),\mathbf{m}(\mathbf{x}^{\prime})\rangle</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
<tbody id="A6.Ex448"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_eqn_cell"></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A6.Ex448.m1" class="ltx_Math" alttext="\displaystyle=\sum_{\mathbf{x}^{\prime}\in\mathcal{D}}K_{\lambda}(\mathbf{s}\big(\mathbf{x}^{\prime}),\mathbf{s}(\mathbf{x})\big)\rho(\mathbf{x}^{\prime})\big|\langle\bm{\theta}(\mathbf{x}),\mathbf{m}(\mathbf{x}^{\prime})\rangle\big|" display="inline" intent=":literal"><semantics><mrow><mphantom></mphantom><mo>=</mo><mrow><mstyle displaystyle="true"><munder><mo movablelimits="false">∑</mo><mrow><msup><mi>𝐱</mi><mo>′</mo></msup><mo>∈</mo><mi class="ltx_font_mathcaligraphic">𝒟</mi></mrow></munder></mstyle><mrow><msub><mi>K</mi><mi>λ</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mrow><mi>𝐬</mi><mo>⁡</mo><mrow><mo maxsize="1.200em" minsize="1.200em">(</mo><msup><mi>𝐱</mi><mo>′</mo></msup><mo stretchy="false">)</mo></mrow></mrow><mo>,</mo><mrow><mi>𝐬</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>𝐱</mi><mo stretchy="false">)</mo></mrow></mrow><mo maxsize="1.200em" minsize="1.200em">)</mo></mrow><mo lspace="0em" rspace="0em">​</mo><mi>ρ</mi><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msup><mi>𝐱</mi><mo>′</mo></msup><mo stretchy="false">)</mo></mrow><mo lspace="0em" rspace="0em">​</mo><mrow><mo maxsize="1.200em" minsize="1.200em" stretchy="true">|</mo><mrow><mo stretchy="false">⟨</mo><mrow><mrow><mi>𝜽</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>𝐱</mi><mo stretchy="false">)</mo></mrow></mrow><mo>,</mo><mrow><mi>𝐦</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><msup><mi>𝐱</mi><mo>′</mo></msup><mo stretchy="false">)</mo></mrow></mrow></mrow><mo stretchy="false">⟩</mo></mrow><mo maxsize="1.200em" minsize="1.200em" stretchy="true">|</mo></mrow></mrow></mrow></mrow><annotation encoding="application/x-tex">\displaystyle=\sum_{\mathbf{x}^{\prime}\in\mathcal{D}}K_{\lambda}(\mathbf{s}\big(\mathbf{x}^{\prime}),\mathbf{s}(\mathbf{x})\big)\rho(\mathbf{x}^{\prime})\big|\langle\bm{\theta}(\mathbf{x}),\mathbf{m}(\mathbf{x}^{\prime})\rangle\big|</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
<tbody id="A6.E118"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_eqn_cell"></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A6.E118.m1" class="ltx_math_unparsed" alttext="\displaystyle\quad-2\sum_{\mathbf{x}^{\prime}\in\mathcal{D}:\langle\bm{\theta}(\mathbf{x}),\bm{\theta}(\mathbf{x}^{\prime})\rangle&lt;0}K_{\lambda}(\mathbf{s}\big(\mathbf{x}^{\prime}),\mathbf{s}(\mathbf{x})\big)\rho(\mathbf{x}^{\prime})\big|\langle\bm{\theta}(\mathbf{x}),\mathbf{m}(\mathbf{x}^{\prime})\rangle\big|." display="inline" intent=":literal"><semantics><mrow><mo>−</mo><mn>2</mn><mstyle displaystyle="true"><munder><mo movablelimits="false">∑</mo><mrow><msup><mi>𝐱</mi><mo>′</mo></msup><mo>∈</mo><mi class="ltx_font_mathcaligraphic">𝒟</mi><mo lspace="0.278em" rspace="0.278em">:</mo><mrow><mrow><mo stretchy="false">⟨</mo><mrow><mrow><mi>𝜽</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>𝐱</mi><mo stretchy="false">)</mo></mrow></mrow><mo>,</mo><mrow><mi>𝜽</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><msup><mi>𝐱</mi><mo>′</mo></msup><mo stretchy="false">)</mo></mrow></mrow></mrow><mo stretchy="false">⟩</mo></mrow><mo>&lt;</mo><mn>0</mn></mrow></mrow></munder></mstyle><msub><mi>K</mi><mi>λ</mi></msub><mrow><mo stretchy="false">(</mo><mi>𝐬</mi><mrow><mo maxsize="1.200em" minsize="1.200em">(</mo><msup><mi>𝐱</mi><mo>′</mo></msup><mo stretchy="false">)</mo></mrow><mo>,</mo><mi>𝐬</mi><mrow><mo stretchy="false">(</mo><mi>𝐱</mi><mo stretchy="false">)</mo></mrow><mo maxsize="1.200em" minsize="1.200em">)</mo></mrow><mi>ρ</mi><mrow><mo stretchy="false">(</mo><msup><mi>𝐱</mi><mo>′</mo></msup><mo stretchy="false">)</mo></mrow><mo fence="false" maxsize="1.200em" minsize="1.200em" rspace="0.167em" stretchy="true">|</mo><mrow><mo stretchy="false">⟨</mo><mi>𝜽</mi><mrow><mo stretchy="false">(</mo><mi>𝐱</mi><mo stretchy="false">)</mo></mrow><mo>,</mo><mi>𝐦</mi><mrow><mo stretchy="false">(</mo><msup><mi>𝐱</mi><mo>′</mo></msup><mo stretchy="false">)</mo></mrow><mo stretchy="false">⟩</mo></mrow><mo fence="false" maxsize="1.200em" minsize="1.200em" stretchy="true">|</mo><mo lspace="0.167em">.</mo></mrow><annotation encoding="application/x-tex">\displaystyle\quad-2\sum_{\mathbf{x}^{\prime}\in\mathcal{D}:\langle\bm{\theta}(\mathbf{x}),\bm{\theta}(\mathbf{x}^{\prime})\rangle&lt;0}K_{\lambda}(\mathbf{s}\big(\mathbf{x}^{\prime}),\mathbf{s}(\mathbf{x})\big)\rho(\mathbf{x}^{\prime})\big|\langle\bm{\theta}(\mathbf{x}),\mathbf{m}(\mathbf{x}^{\prime})\rangle\big|.</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td>
<td rowspan="1" class="ltx_eqn_cell ltx_eqn_eqno ltx_align_middle ltx_align_right"><span class="ltx_tag ltx_tag_equation ltx_align_right">(118)</span></td></tr></tbody>
</table>
<p id="A6.SS4.p5.2" class="ltx_p"><span id="A6.SS4.p5.2.1" class="ltx_text">Since <math id="A6.SS4.p5.m4" class="ltx_Math" alttext="\bm{\theta}(\mathbf{x})=\mathbf{m}(\mathbf{x})/\|\mathbf{m}(\mathbf{x})\|_{2}" display="inline" intent=":literal"><semantics><mrow><mrow><mi>𝜽</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>𝐱</mi><mo stretchy="false">)</mo></mrow></mrow><mo>=</mo><mrow><mrow><mi>𝐦</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>𝐱</mi><mo stretchy="false">)</mo></mrow></mrow><mo>/</mo><msub><mrow><mo stretchy="false">‖</mo><mrow><mi>𝐦</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>𝐱</mi><mo stretchy="false">)</mo></mrow></mrow><mo stretchy="false">‖</mo></mrow><mn>2</mn></msub></mrow></mrow><annotation encoding="application/x-tex">\bm{\theta}(\mathbf{x})=\mathbf{m}(\mathbf{x})/\|\mathbf{m}(\mathbf{x})\|_{2}</annotation></semantics></math> for any <math id="A6.SS4.p5.m5" class="ltx_Math" alttext="\mathbf{x}\in\mathcal{D}" display="inline" intent=":literal"><semantics><mrow><mi>𝐱</mi><mo>∈</mo><mi class="ltx_font_mathcaligraphic">𝒟</mi></mrow><annotation encoding="application/x-tex">\mathbf{x}\in\mathcal{D}</annotation></semantics></math> it follows for any <math id="A6.SS4.p5.m6" class="ltx_Math" alttext="\mathbf{x}^{\prime}\in\mathcal{D}" display="inline" intent=":literal"><semantics><mrow><msup><mi>𝐱</mi><mo>′</mo></msup><mo>∈</mo><mi class="ltx_font_mathcaligraphic">𝒟</mi></mrow><annotation encoding="application/x-tex">\mathbf{x}^{\prime}\in\mathcal{D}</annotation></semantics></math>, that <math id="A6.SS4.p5.m7" class="ltx_Math" alttext="|\langle\bm{\theta}(\mathbf{x}),\mathbf{m}(\mathbf{x}^{\prime})\rangle|\geq c_{1}\langle\bm{\theta}(\mathbf{x}),\bm{\theta}(\mathbf{x}^{\prime})\rangle=\tfrac{c_{1}}{2}(2-\|\bm{\theta}(\mathbf{x})-\bm{\theta}(\mathbf{x}^{\prime})\|_{2}^{2})" display="inline" intent=":literal"><semantics><mrow><mrow><mo stretchy="false">|</mo><mrow><mo stretchy="false">⟨</mo><mrow><mrow><mi>𝜽</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>𝐱</mi><mo stretchy="false">)</mo></mrow></mrow><mo>,</mo><mrow><mi>𝐦</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><msup><mi>𝐱</mi><mo>′</mo></msup><mo stretchy="false">)</mo></mrow></mrow></mrow><mo stretchy="false">⟩</mo></mrow><mo stretchy="false">|</mo></mrow><mo>≥</mo><mrow><msub><mi>c</mi><mn>1</mn></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">⟨</mo><mrow><mrow><mi>𝜽</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>𝐱</mi><mo stretchy="false">)</mo></mrow></mrow><mo>,</mo><mrow><mi>𝜽</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><msup><mi>𝐱</mi><mo>′</mo></msup><mo stretchy="false">)</mo></mrow></mrow></mrow><mo stretchy="false">⟩</mo></mrow></mrow><mo>=</mo><mrow><mfrac><msub><mi>c</mi><mn>1</mn></msub><mn>2</mn></mfrac><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mrow><mn>2</mn><mo>−</mo><msubsup><mrow><mo stretchy="false">‖</mo><mrow><mrow><mi>𝜽</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>𝐱</mi><mo stretchy="false">)</mo></mrow></mrow><mo>−</mo><mrow><mi>𝜽</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><msup><mi>𝐱</mi><mo>′</mo></msup><mo stretchy="false">)</mo></mrow></mrow></mrow><mo stretchy="false">‖</mo></mrow><mn>2</mn><mn>2</mn></msubsup></mrow><mo stretchy="false">)</mo></mrow></mrow></mrow><annotation encoding="application/x-tex">|\langle\bm{\theta}(\mathbf{x}),\mathbf{m}(\mathbf{x}^{\prime})\rangle|\geq c_{1}\langle\bm{\theta}(\mathbf{x}),\bm{\theta}(\mathbf{x}^{\prime})\rangle=\tfrac{c_{1}}{2}(2-\|\bm{\theta}(\mathbf{x})-\bm{\theta}(\mathbf{x}^{\prime})\|_{2}^{2})</annotation></semantics></math>.
Hence,</span></p>
<table id="A6.EGx189" class="ltx_equationgroup ltx_eqn_align ltx_eqn_table">

<tbody id="A6.Ex449"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_align_right ltx_eqn_cell"><math id="A6.Ex449.m1" class="ltx_Math" alttext="\displaystyle\sum_{\mathbf{x}^{\prime}\in\mathcal{D}}K_{\lambda}(\mathbf{s}\big(\mathbf{x}^{\prime}),\mathbf{s}(\mathbf{x})\big)\rho(\mathbf{x}^{\prime})\big|\langle\bm{\theta}(\mathbf{x}),\mathbf{m}(\mathbf{x}^{\prime})\rangle\big|" display="inline" intent=":literal"><semantics><mrow><mstyle displaystyle="true"><munder><mo movablelimits="false">∑</mo><mrow><msup><mi>𝐱</mi><mo>′</mo></msup><mo>∈</mo><mi class="ltx_font_mathcaligraphic">𝒟</mi></mrow></munder></mstyle><mrow><msub><mi>K</mi><mi>λ</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mrow><mi>𝐬</mi><mo>⁡</mo><mrow><mo maxsize="1.200em" minsize="1.200em">(</mo><msup><mi>𝐱</mi><mo>′</mo></msup><mo stretchy="false">)</mo></mrow></mrow><mo>,</mo><mrow><mi>𝐬</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>𝐱</mi><mo stretchy="false">)</mo></mrow></mrow><mo maxsize="1.200em" minsize="1.200em">)</mo></mrow><mo lspace="0em" rspace="0em">​</mo><mi>ρ</mi><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msup><mi>𝐱</mi><mo>′</mo></msup><mo stretchy="false">)</mo></mrow><mo lspace="0em" rspace="0em">​</mo><mrow><mo maxsize="1.200em" minsize="1.200em" stretchy="true">|</mo><mrow><mo stretchy="false">⟨</mo><mrow><mrow><mi>𝜽</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>𝐱</mi><mo stretchy="false">)</mo></mrow></mrow><mo>,</mo><mrow><mi>𝐦</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><msup><mi>𝐱</mi><mo>′</mo></msup><mo stretchy="false">)</mo></mrow></mrow></mrow><mo stretchy="false">⟩</mo></mrow><mo maxsize="1.200em" minsize="1.200em" stretchy="true">|</mo></mrow></mrow></mrow><annotation encoding="application/x-tex">\displaystyle\sum_{\mathbf{x}^{\prime}\in\mathcal{D}}K_{\lambda}(\mathbf{s}\big(\mathbf{x}^{\prime}),\mathbf{s}(\mathbf{x})\big)\rho(\mathbf{x}^{\prime})\big|\langle\bm{\theta}(\mathbf{x}),\mathbf{m}(\mathbf{x}^{\prime})\rangle\big|</annotation></semantics></math></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A6.Ex449.m2" class="ltx_Math" alttext="\displaystyle\geq\frac{c_{1}}{2}\sum_{\mathbf{x}^{\prime}\in\mathcal{D}}K_{\lambda}(\mathbf{s}\big(\mathbf{x}^{\prime}),\mathbf{s}(\mathbf{x})\big)\rho(\mathbf{x}^{\prime})\big(2-\|\bm{\theta}(\mathbf{x})-\bm{\theta}(\mathbf{x}^{\prime})\|_{2}^{2}\big)" display="inline" intent=":literal"><semantics><mrow><mphantom></mphantom><mo>≥</mo><mrow><mstyle displaystyle="true"><mfrac><msub><mi>c</mi><mn>1</mn></msub><mn>2</mn></mfrac></mstyle><mo lspace="0em" rspace="0em">​</mo><mrow><mstyle displaystyle="true"><munder><mo movablelimits="false">∑</mo><mrow><msup><mi>𝐱</mi><mo>′</mo></msup><mo>∈</mo><mi class="ltx_font_mathcaligraphic">𝒟</mi></mrow></munder></mstyle><mrow><msub><mi>K</mi><mi>λ</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mrow><mi>𝐬</mi><mo>⁡</mo><mrow><mo maxsize="1.200em" minsize="1.200em">(</mo><msup><mi>𝐱</mi><mo>′</mo></msup><mo stretchy="false">)</mo></mrow></mrow><mo>,</mo><mrow><mi>𝐬</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>𝐱</mi><mo stretchy="false">)</mo></mrow></mrow><mo maxsize="1.200em" minsize="1.200em">)</mo></mrow><mo lspace="0em" rspace="0em">​</mo><mi>ρ</mi><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msup><mi>𝐱</mi><mo>′</mo></msup><mo stretchy="false">)</mo></mrow><mo lspace="0em" rspace="0em">​</mo><mrow><mo maxsize="1.200em" minsize="1.200em">(</mo><mrow><mn>2</mn><mo>−</mo><msubsup><mrow><mo stretchy="false">‖</mo><mrow><mrow><mi>𝜽</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>𝐱</mi><mo stretchy="false">)</mo></mrow></mrow><mo>−</mo><mrow><mi>𝜽</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><msup><mi>𝐱</mi><mo>′</mo></msup><mo stretchy="false">)</mo></mrow></mrow></mrow><mo stretchy="false">‖</mo></mrow><mn>2</mn><mn>2</mn></msubsup></mrow><mo maxsize="1.200em" minsize="1.200em">)</mo></mrow></mrow></mrow></mrow></mrow><annotation encoding="application/x-tex">\displaystyle\geq\frac{c_{1}}{2}\sum_{\mathbf{x}^{\prime}\in\mathcal{D}}K_{\lambda}(\mathbf{s}\big(\mathbf{x}^{\prime}),\mathbf{s}(\mathbf{x})\big)\rho(\mathbf{x}^{\prime})\big(2-\|\bm{\theta}(\mathbf{x})-\bm{\theta}(\mathbf{x}^{\prime})\|_{2}^{2}\big)</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
<tbody id="A6.Ex450"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_eqn_cell"></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A6.Ex450.m1" class="ltx_Math" alttext="\displaystyle=c_{1}\mathbb{E}_{\rho}\big[K_{\lambda}\big(\mathbf{s}(\bm{\xi}),\mathbf{s}(\mathbf{x})\big)\big]-\frac{c_{1}}{2}\mathbb{E}_{\rho}\big[K_{\lambda}\big(\mathbf{s}(\bm{\xi}),\mathbf{s}(\mathbf{x})\big)\|\bm{\theta}(\bm{\xi})-\bm{\theta}(\mathbf{x})\|_{2}\big]" display="inline" intent=":literal"><semantics><mrow><mphantom></mphantom><mo>=</mo><mrow><mrow><msub><mi>c</mi><mn>1</mn></msub><mo lspace="0em" rspace="0em">​</mo><msub><mi>𝔼</mi><mi>ρ</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo maxsize="1.200em" minsize="1.200em">[</mo><mrow><msub><mi>K</mi><mi>λ</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo maxsize="1.200em" minsize="1.200em">(</mo><mrow><mi>𝐬</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>𝝃</mi><mo stretchy="false">)</mo></mrow></mrow><mo>,</mo><mrow><mi>𝐬</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>𝐱</mi><mo stretchy="false">)</mo></mrow></mrow><mo maxsize="1.200em" minsize="1.200em">)</mo></mrow></mrow><mo maxsize="1.200em" minsize="1.200em">]</mo></mrow></mrow><mo>−</mo><mrow><mstyle displaystyle="true"><mfrac><msub><mi>c</mi><mn>1</mn></msub><mn>2</mn></mfrac></mstyle><mo lspace="0em" rspace="0em">​</mo><msub><mi>𝔼</mi><mi>ρ</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo maxsize="1.200em" minsize="1.200em">[</mo><mrow><msub><mi>K</mi><mi>λ</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo maxsize="1.200em" minsize="1.200em">(</mo><mrow><mi>𝐬</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>𝝃</mi><mo stretchy="false">)</mo></mrow></mrow><mo>,</mo><mrow><mi>𝐬</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>𝐱</mi><mo stretchy="false">)</mo></mrow></mrow><mo maxsize="1.200em" minsize="1.200em">)</mo></mrow><mo lspace="0em" rspace="0em">​</mo><msub><mrow><mo stretchy="false">‖</mo><mrow><mrow><mi>𝜽</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>𝝃</mi><mo stretchy="false">)</mo></mrow></mrow><mo>−</mo><mrow><mi>𝜽</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>𝐱</mi><mo stretchy="false">)</mo></mrow></mrow></mrow><mo stretchy="false">‖</mo></mrow><mn>2</mn></msub></mrow><mo maxsize="1.200em" minsize="1.200em">]</mo></mrow></mrow></mrow></mrow><annotation encoding="application/x-tex">\displaystyle=c_{1}\mathbb{E}_{\rho}\big[K_{\lambda}\big(\mathbf{s}(\bm{\xi}),\mathbf{s}(\mathbf{x})\big)\big]-\frac{c_{1}}{2}\mathbb{E}_{\rho}\big[K_{\lambda}\big(\mathbf{s}(\bm{\xi}),\mathbf{s}(\mathbf{x})\big)\|\bm{\theta}(\bm{\xi})-\bm{\theta}(\mathbf{x})\|_{2}\big]</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
<tbody id="A6.E119"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_eqn_cell"></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A6.E119.m1" class="ltx_Math" alttext="\displaystyle\geq c_{1}\mathbb{E}_{\rho}\big[K_{\lambda}\big(\mathbf{s}(\bm{\xi}),\mathbf{s}(\mathbf{x})\big)\big]," display="inline" intent=":literal"><semantics><mrow><mrow><mphantom></mphantom><mo>≥</mo><mrow><msub><mi>c</mi><mn>1</mn></msub><mo lspace="0em" rspace="0em">​</mo><msub><mi>𝔼</mi><mi>ρ</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo maxsize="1.200em" minsize="1.200em">[</mo><mrow><msub><mi>K</mi><mi>λ</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo maxsize="1.200em" minsize="1.200em">(</mo><mrow><mi>𝐬</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>𝝃</mi><mo stretchy="false">)</mo></mrow></mrow><mo>,</mo><mrow><mi>𝐬</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>𝐱</mi><mo stretchy="false">)</mo></mrow></mrow><mo maxsize="1.200em" minsize="1.200em">)</mo></mrow></mrow><mo maxsize="1.200em" minsize="1.200em">]</mo></mrow></mrow></mrow><mo>,</mo></mrow><annotation encoding="application/x-tex">\displaystyle\geq c_{1}\mathbb{E}_{\rho}\big[K_{\lambda}\big(\mathbf{s}(\bm{\xi}),\mathbf{s}(\mathbf{x})\big)\big],</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td>
<td rowspan="1" class="ltx_eqn_cell ltx_eqn_eqno ltx_align_middle ltx_align_right"><span class="ltx_tag ltx_tag_equation ltx_align_right">(119)</span></td></tr></tbody>
</table>
<p id="A6.SS4.p5.3" class="ltx_p"><span id="A6.SS4.p5.3.1" class="ltx_text">where the second inequality follows from <math id="A6.SS4.p5.m8" class="ltx_Math" alttext="\|\bm{\theta}(\mathbf{x})-\bm{\theta}(\mathbf{x}^{\prime})\|_{2}^{2}\leq 2\|\bm{\theta}(\mathbf{x})-\bm{\theta}(\mathbf{x}^{\prime})\|_{2}" display="inline" intent=":literal"><semantics><mrow><msubsup><mrow><mo stretchy="false">‖</mo><mrow><mrow><mi>𝜽</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>𝐱</mi><mo stretchy="false">)</mo></mrow></mrow><mo>−</mo><mrow><mi>𝜽</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><msup><mi>𝐱</mi><mo>′</mo></msup><mo stretchy="false">)</mo></mrow></mrow></mrow><mo stretchy="false">‖</mo></mrow><mn>2</mn><mn>2</mn></msubsup><mo>≤</mo><mrow><mn>2</mn><mo lspace="0em" rspace="0em">​</mo><msub><mrow><mo stretchy="false">‖</mo><mrow><mrow><mi>𝜽</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>𝐱</mi><mo stretchy="false">)</mo></mrow></mrow><mo>−</mo><mrow><mi>𝜽</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><msup><mi>𝐱</mi><mo>′</mo></msup><mo stretchy="false">)</mo></mrow></mrow></mrow><mo stretchy="false">‖</mo></mrow><mn>2</mn></msub></mrow></mrow><annotation encoding="application/x-tex">\|\bm{\theta}(\mathbf{x})-\bm{\theta}(\mathbf{x}^{\prime})\|_{2}^{2}\leq 2\|\bm{\theta}(\mathbf{x})-\bm{\theta}(\mathbf{x}^{\prime})\|_{2}</annotation></semantics></math>, and the last inequality follows from (<a href="#A6.E111" title="In Proof. ‣ F.3 Proof of Lemma ‣ Appendix F Directional Convergence of the Nadaraya–Watson Estimator ‣ Generalization Bounds for Transformer-Based Next-Token Prediction in a Language Model" class="ltx_ref"><span class="ltx_text ltx_ref_tag">111</span></a>) by taking <math id="A6.SS4.p5.m9" class="ltx_Math" alttext="\lambda" display="inline" intent=":literal"><semantics><mi>λ</mi><annotation encoding="application/x-tex">\lambda</annotation></semantics></math> sufficiently small.
On the other hand, since <math id="A6.SS4.p5.m10" class="ltx_Math" alttext="\langle\bm{\theta}(\mathbf{x}),\bm{\theta}(\mathbf{x}^{\prime})\rangle&lt;0" display="inline" intent=":literal"><semantics><mrow><mrow><mo stretchy="false">⟨</mo><mrow><mrow><mi>𝜽</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>𝐱</mi><mo stretchy="false">)</mo></mrow></mrow><mo>,</mo><mrow><mi>𝜽</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><msup><mi>𝐱</mi><mo>′</mo></msup><mo stretchy="false">)</mo></mrow></mrow></mrow><mo stretchy="false">⟩</mo></mrow><mo>&lt;</mo><mn>0</mn></mrow><annotation encoding="application/x-tex">\langle\bm{\theta}(\mathbf{x}),\bm{\theta}(\mathbf{x}^{\prime})\rangle&lt;0</annotation></semantics></math> implies <math id="A6.SS4.p5.m11" class="ltx_Math" alttext="\|\bm{\theta}(\mathbf{x})-\bm{\theta}(\mathbf{x}^{\prime})\|_{2}\geq\sqrt{2}" display="inline" intent=":literal"><semantics><mrow><msub><mrow><mo stretchy="false">‖</mo><mrow><mrow><mi>𝜽</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>𝐱</mi><mo stretchy="false">)</mo></mrow></mrow><mo>−</mo><mrow><mi>𝜽</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><msup><mi>𝐱</mi><mo>′</mo></msup><mo stretchy="false">)</mo></mrow></mrow></mrow><mo stretchy="false">‖</mo></mrow><mn>2</mn></msub><mo>≥</mo><msqrt><mn>2</mn></msqrt></mrow><annotation encoding="application/x-tex">\|\bm{\theta}(\mathbf{x})-\bm{\theta}(\mathbf{x}^{\prime})\|_{2}\geq\sqrt{2}</annotation></semantics></math> and hence <math id="A6.SS4.p5.m12" class="ltx_Math" alttext="\|\mathbf{s}(\mathbf{x})-\mathbf{s}(\mathbf{x}^{\prime})\|_{2}\geq(\sqrt{2}/c_{\bm{\theta}})^{1/\beta_{2}}" display="inline" intent=":literal"><semantics><mrow><msub><mrow><mo stretchy="false">‖</mo><mrow><mrow><mi>𝐬</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>𝐱</mi><mo stretchy="false">)</mo></mrow></mrow><mo>−</mo><mrow><mi>𝐬</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><msup><mi>𝐱</mi><mo>′</mo></msup><mo stretchy="false">)</mo></mrow></mrow></mrow><mo stretchy="false">‖</mo></mrow><mn>2</mn></msub><mo>≥</mo><msup><mrow><mo stretchy="false">(</mo><mrow><msqrt><mn>2</mn></msqrt><mo>/</mo><msub><mi>c</mi><mi>𝜽</mi></msub></mrow><mo stretchy="false">)</mo></mrow><mrow><mn>1</mn><mo>/</mo><msub><mi>β</mi><mn>2</mn></msub></mrow></msup></mrow><annotation encoding="application/x-tex">\|\mathbf{s}(\mathbf{x})-\mathbf{s}(\mathbf{x}^{\prime})\|_{2}\geq(\sqrt{2}/c_{\bm{\theta}})^{1/\beta_{2}}</annotation></semantics></math>, we have by the definition of <math id="A6.SS4.p5.m13" class="ltx_Math" alttext="K_{\lambda}" display="inline" intent=":literal"><semantics><msub><mi>K</mi><mi>λ</mi></msub><annotation encoding="application/x-tex">K_{\lambda}</annotation></semantics></math> and the Cauchy–Schwarz inequality</span></p>
<table id="A6.EGx190" class="ltx_equationgroup ltx_eqn_align ltx_eqn_table">

<tbody id="A6.Ex451"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_align_right ltx_eqn_cell"><math id="A6.Ex451.m1" class="ltx_math_unparsed" alttext="\displaystyle\sum_{\mathbf{x}^{\prime}\in\mathcal{D}:\langle\bm{\theta}(\mathbf{x}),\bm{\theta}(\mathbf{x}^{\prime})\rangle&lt;0}K_{\lambda}(\mathbf{s}\big(\mathbf{x}^{\prime}),\mathbf{s}(\mathbf{x})\big)\rho(\mathbf{x}^{\prime})\big|\langle\bm{\theta}(\mathbf{x}),\mathbf{m}(\mathbf{x}^{\prime})\rangle\big|" display="inline" intent=":literal"><semantics><mrow><mstyle displaystyle="true"><munder><mo movablelimits="false">∑</mo><mrow><msup><mi>𝐱</mi><mo>′</mo></msup><mo>∈</mo><mi class="ltx_font_mathcaligraphic">𝒟</mi><mo lspace="0.278em" rspace="0.278em">:</mo><mrow><mrow><mo stretchy="false">⟨</mo><mrow><mrow><mi>𝜽</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>𝐱</mi><mo stretchy="false">)</mo></mrow></mrow><mo>,</mo><mrow><mi>𝜽</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><msup><mi>𝐱</mi><mo>′</mo></msup><mo stretchy="false">)</mo></mrow></mrow></mrow><mo stretchy="false">⟩</mo></mrow><mo>&lt;</mo><mn>0</mn></mrow></mrow></munder></mstyle><msub><mi>K</mi><mi>λ</mi></msub><mrow><mo stretchy="false">(</mo><mi>𝐬</mi><mrow><mo maxsize="1.200em" minsize="1.200em">(</mo><msup><mi>𝐱</mi><mo>′</mo></msup><mo stretchy="false">)</mo></mrow><mo>,</mo><mi>𝐬</mi><mrow><mo stretchy="false">(</mo><mi>𝐱</mi><mo stretchy="false">)</mo></mrow><mo maxsize="1.200em" minsize="1.200em">)</mo></mrow><mi>ρ</mi><mrow><mo stretchy="false">(</mo><msup><mi>𝐱</mi><mo>′</mo></msup><mo stretchy="false">)</mo></mrow><mo fence="false" maxsize="1.200em" minsize="1.200em" rspace="0.167em" stretchy="true">|</mo><mrow><mo stretchy="false">⟨</mo><mi>𝜽</mi><mrow><mo stretchy="false">(</mo><mi>𝐱</mi><mo stretchy="false">)</mo></mrow><mo>,</mo><mi>𝐦</mi><mrow><mo stretchy="false">(</mo><msup><mi>𝐱</mi><mo>′</mo></msup><mo stretchy="false">)</mo></mrow><mo stretchy="false">⟩</mo></mrow><mo fence="false" maxsize="1.200em" minsize="1.200em" stretchy="true">|</mo></mrow><annotation encoding="application/x-tex">\displaystyle\sum_{\mathbf{x}^{\prime}\in\mathcal{D}:\langle\bm{\theta}(\mathbf{x}),\bm{\theta}(\mathbf{x}^{\prime})\rangle&lt;0}K_{\lambda}(\mathbf{s}\big(\mathbf{x}^{\prime}),\mathbf{s}(\mathbf{x})\big)\rho(\mathbf{x}^{\prime})\big|\langle\bm{\theta}(\mathbf{x}),\mathbf{m}(\mathbf{x}^{\prime})\rangle\big|</annotation></semantics></math></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A6.Ex451.m2" class="ltx_Math" alttext="\displaystyle\leq\exp\Big(-\frac{(\sqrt{2}/c_{\bm{\theta}})^{2/\beta_{2}}}{2\lambda^{2}}\Big)\sup_{\mathbf{x}^{\prime}\in\mathcal{E}_{W}^{r}}\|\mathbf{m}(\mathbf{x}^{\prime})\|_{2}" display="inline" intent=":literal"><semantics><mrow><mphantom></mphantom><mo>≤</mo><mrow><mrow><mi>exp</mi><mo>⁡</mo><mrow><mo maxsize="1.600em" minsize="1.600em">(</mo><mrow><mo>−</mo><mstyle displaystyle="true"><mfrac><msup><mrow><mo stretchy="false">(</mo><mrow><msqrt><mn>2</mn></msqrt><mo>/</mo><msub><mi>c</mi><mi>𝜽</mi></msub></mrow><mo stretchy="false">)</mo></mrow><mrow><mn>2</mn><mo>/</mo><msub><mi>β</mi><mn>2</mn></msub></mrow></msup><mrow><mn>2</mn><mo lspace="0em" rspace="0em">​</mo><msup><mi>λ</mi><mn>2</mn></msup></mrow></mfrac></mstyle></mrow><mo maxsize="1.600em" minsize="1.600em">)</mo></mrow></mrow><mo lspace="0.167em" rspace="0em">​</mo><mrow><munder><mo movablelimits="false" rspace="0em">sup</mo><mrow><msup><mi>𝐱</mi><mo>′</mo></msup><mo>∈</mo><msubsup><mi class="ltx_font_mathcaligraphic">ℰ</mi><mi>W</mi><mi>r</mi></msubsup></mrow></munder><msub><mrow><mo stretchy="false">‖</mo><mrow><mi>𝐦</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><msup><mi>𝐱</mi><mo>′</mo></msup><mo stretchy="false">)</mo></mrow></mrow><mo stretchy="false">‖</mo></mrow><mn>2</mn></msub></mrow></mrow></mrow><annotation encoding="application/x-tex">\displaystyle\leq\exp\Big(-\frac{(\sqrt{2}/c_{\bm{\theta}})^{2/\beta_{2}}}{2\lambda^{2}}\Big)\sup_{\mathbf{x}^{\prime}\in\mathcal{E}_{W}^{r}}\|\mathbf{m}(\mathbf{x}^{\prime})\|_{2}</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
<tbody id="A6.Ex452"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_eqn_cell"></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A6.Ex452.m1" class="ltx_Math" alttext="\displaystyle\leq\exp\Big(-\frac{(\sqrt{2}/c_{\bm{\theta}})^{2/\beta_{2}}}{2\lambda^{2}}+\delta_{1}m_{1}\Big)." display="inline" intent=":literal"><semantics><mrow><mrow><mphantom></mphantom><mo>≤</mo><mrow><mi>exp</mi><mo>⁡</mo><mrow><mo maxsize="1.600em" minsize="1.600em">(</mo><mrow><mrow><mo>−</mo><mstyle displaystyle="true"><mfrac><msup><mrow><mo stretchy="false">(</mo><mrow><msqrt><mn>2</mn></msqrt><mo>/</mo><msub><mi>c</mi><mi>𝜽</mi></msub></mrow><mo stretchy="false">)</mo></mrow><mrow><mn>2</mn><mo>/</mo><msub><mi>β</mi><mn>2</mn></msub></mrow></msup><mrow><mn>2</mn><mo lspace="0em" rspace="0em">​</mo><msup><mi>λ</mi><mn>2</mn></msup></mrow></mfrac></mstyle></mrow><mo>+</mo><mrow><msub><mi>δ</mi><mn>1</mn></msub><mo lspace="0em" rspace="0em">​</mo><msub><mi>m</mi><mn>1</mn></msub></mrow></mrow><mo maxsize="1.600em" minsize="1.600em">)</mo></mrow></mrow></mrow><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">\displaystyle\leq\exp\Big(-\frac{(\sqrt{2}/c_{\bm{\theta}})^{2/\beta_{2}}}{2\lambda^{2}}+\delta_{1}m_{1}\Big).</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="A6.SS4.p5.4" class="ltx_p"><span id="A6.SS4.p5.4.1" class="ltx_text">Combining this inequality with (<a href="#A6.E118" title="In Proof. ‣ F.4 Proof of Lemma ‣ Appendix F Directional Convergence of the Nadaraya–Watson Estimator ‣ Generalization Bounds for Transformer-Based Next-Token Prediction in a Language Model" class="ltx_ref"><span class="ltx_text ltx_ref_tag">118</span></a>), (<a href="#A6.E119" title="In Proof. ‣ F.4 Proof of Lemma ‣ Appendix F Directional Convergence of the Nadaraya–Watson Estimator ‣ Generalization Bounds for Transformer-Based Next-Token Prediction in a Language Model" class="ltx_ref"><span class="ltx_text ltx_ref_tag">119</span></a>), and (iv), we obtain</span></p>
<table id="A6.EGx191" class="ltx_equationgroup ltx_eqn_align ltx_eqn_table">

<tbody id="A6.Ex453"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_align_right ltx_eqn_cell"><math id="A6.Ex453.m1" class="ltx_Math" alttext="\displaystyle\frac{\big\|\mathbb{E}_{\rho}\left[K_{\lambda}\big(\mathbf{s}(\bm{\xi}),\mathbf{s}(\mathbf{x})\big)P_{\bm{\theta}(\mathbf{x})}\mathbf{m}(\bm{\xi})\right]\big\|_{2}}{\mathbb{E}_{\rho}\big[K_{\lambda}\big(\mathbf{s}(\bm{\xi}),\mathbf{s}(\mathbf{x})\big)\big]}" display="inline" intent=":literal"><semantics><mstyle displaystyle="true"><mfrac><msub><mrow><mo maxsize="1.200em" minsize="1.200em" stretchy="true">‖</mo><mrow><msub><mi>𝔼</mi><mi>ρ</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo>[</mo><mrow><msub><mi>K</mi><mi>λ</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo maxsize="1.200em" minsize="1.200em">(</mo><mrow><mi>𝐬</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>𝝃</mi><mo stretchy="false">)</mo></mrow></mrow><mo>,</mo><mrow><mi>𝐬</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>𝐱</mi><mo stretchy="false">)</mo></mrow></mrow><mo maxsize="1.200em" minsize="1.200em">)</mo></mrow><mo lspace="0em" rspace="0em">​</mo><msub><mi>P</mi><mrow><mi>𝜽</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>𝐱</mi><mo stretchy="false">)</mo></mrow></mrow></msub><mo lspace="0em" rspace="0em">​</mo><mi>𝐦</mi><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>𝝃</mi><mo stretchy="false">)</mo></mrow></mrow><mo>]</mo></mrow></mrow><mo maxsize="1.200em" minsize="1.200em" stretchy="true">‖</mo></mrow><mn>2</mn></msub><mrow><msub><mi>𝔼</mi><mi>ρ</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo maxsize="1.200em" minsize="1.200em">[</mo><mrow><msub><mi>K</mi><mi>λ</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo maxsize="1.200em" minsize="1.200em">(</mo><mrow><mi>𝐬</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>𝝃</mi><mo stretchy="false">)</mo></mrow></mrow><mo>,</mo><mrow><mi>𝐬</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>𝐱</mi><mo stretchy="false">)</mo></mrow></mrow><mo maxsize="1.200em" minsize="1.200em">)</mo></mrow></mrow><mo maxsize="1.200em" minsize="1.200em">]</mo></mrow></mrow></mfrac></mstyle><annotation encoding="application/x-tex">\displaystyle\frac{\big\|\mathbb{E}_{\rho}\left[K_{\lambda}\big(\mathbf{s}(\bm{\xi}),\mathbf{s}(\mathbf{x})\big)P_{\bm{\theta}(\mathbf{x})}\mathbf{m}(\bm{\xi})\right]\big\|_{2}}{\mathbb{E}_{\rho}\big[K_{\lambda}\big(\mathbf{s}(\bm{\xi}),\mathbf{s}(\mathbf{x})\big)\big]}</annotation></semantics></math></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A6.Ex453.m2" class="ltx_Math" alttext="\displaystyle\geq\frac{c_{1}}{2}-2\frac{\exp\big(-\frac{(\sqrt{2}/c_{\bm{\theta}})^{2/\beta}}{2\lambda^{2}}+\delta_{1}m_{1}\big)}{\mathbb{E}\big[U_{0}(\mathbf{x})\big]}" display="inline" intent=":literal"><semantics><mrow><mphantom></mphantom><mo>≥</mo><mrow><mstyle displaystyle="true"><mfrac><msub><mi>c</mi><mn>1</mn></msub><mn>2</mn></mfrac></mstyle><mo>−</mo><mrow><mn>2</mn><mo lspace="0em" rspace="0em">​</mo><mstyle displaystyle="true"><mfrac><mrow><mi>exp</mi><mo>⁡</mo><mrow><mo maxsize="1.200em" minsize="1.200em">(</mo><mrow><mrow><mo>−</mo><mfrac><msup><mrow><mo stretchy="false">(</mo><mrow><msqrt><mn>2</mn></msqrt><mo>/</mo><msub><mi>c</mi><mi>𝜽</mi></msub></mrow><mo stretchy="false">)</mo></mrow><mrow><mn>2</mn><mo>/</mo><mi>β</mi></mrow></msup><mrow><mn>2</mn><mo lspace="0em" rspace="0em">​</mo><msup><mi>λ</mi><mn>2</mn></msup></mrow></mfrac></mrow><mo>+</mo><mrow><msub><mi>δ</mi><mn>1</mn></msub><mo lspace="0em" rspace="0em">​</mo><msub><mi>m</mi><mn>1</mn></msub></mrow></mrow><mo maxsize="1.200em" minsize="1.200em">)</mo></mrow></mrow><mrow><mi>𝔼</mi><mo lspace="0em" rspace="0em">​</mo><mrow><mo maxsize="1.200em" minsize="1.200em">[</mo><mrow><msub><mi>U</mi><mn>0</mn></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>𝐱</mi><mo stretchy="false">)</mo></mrow></mrow><mo maxsize="1.200em" minsize="1.200em">]</mo></mrow></mrow></mfrac></mstyle></mrow></mrow></mrow><annotation encoding="application/x-tex">\displaystyle\geq\frac{c_{1}}{2}-2\frac{\exp\big(-\frac{(\sqrt{2}/c_{\bm{\theta}})^{2/\beta}}{2\lambda^{2}}+\delta_{1}m_{1}\big)}{\mathbb{E}\big[U_{0}(\mathbf{x})\big]}</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
<tbody id="A6.Ex454"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_eqn_cell"></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A6.Ex454.m1" class="ltx_Math" alttext="\displaystyle\geq\frac{c_{1}}{2}-2\frac{\exp\big(-\frac{(\sqrt{2}/c_{\bm{\theta}})^{2/\beta}}{2\lambda^{2}}+\delta_{1}m_{1}\big)}{\varphi_{W}(\lambda)^{r_{2}}}" display="inline" intent=":literal"><semantics><mrow><mphantom></mphantom><mo>≥</mo><mrow><mstyle displaystyle="true"><mfrac><msub><mi>c</mi><mn>1</mn></msub><mn>2</mn></mfrac></mstyle><mo>−</mo><mrow><mn>2</mn><mo lspace="0em" rspace="0em">​</mo><mstyle displaystyle="true"><mfrac><mrow><mi>exp</mi><mo>⁡</mo><mrow><mo maxsize="1.200em" minsize="1.200em">(</mo><mrow><mrow><mo>−</mo><mfrac><msup><mrow><mo stretchy="false">(</mo><mrow><msqrt><mn>2</mn></msqrt><mo>/</mo><msub><mi>c</mi><mi>𝜽</mi></msub></mrow><mo stretchy="false">)</mo></mrow><mrow><mn>2</mn><mo>/</mo><mi>β</mi></mrow></msup><mrow><mn>2</mn><mo lspace="0em" rspace="0em">​</mo><msup><mi>λ</mi><mn>2</mn></msup></mrow></mfrac></mrow><mo>+</mo><mrow><msub><mi>δ</mi><mn>1</mn></msub><mo lspace="0em" rspace="0em">​</mo><msub><mi>m</mi><mn>1</mn></msub></mrow></mrow><mo maxsize="1.200em" minsize="1.200em">)</mo></mrow></mrow><mrow><msub><mi>φ</mi><mi>W</mi></msub><mo lspace="0em" rspace="0em">​</mo><msup><mrow><mo stretchy="false">(</mo><mi>λ</mi><mo stretchy="false">)</mo></mrow><msub><mi>r</mi><mn>2</mn></msub></msup></mrow></mfrac></mstyle></mrow></mrow></mrow><annotation encoding="application/x-tex">\displaystyle\geq\frac{c_{1}}{2}-2\frac{\exp\big(-\frac{(\sqrt{2}/c_{\bm{\theta}})^{2/\beta}}{2\lambda^{2}}+\delta_{1}m_{1}\big)}{\varphi_{W}(\lambda)^{r_{2}}}</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
<tbody id="A6.Ex455"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_eqn_cell"></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A6.Ex455.m1" class="ltx_Math" alttext="\displaystyle\geq\frac{c_{1}}{2}-2W^{r_{2}}\exp\bigg(-\frac{(\sqrt{2}/c_{\bm{\theta}})^{2/\beta}\log^{2}W}{2}+\delta_{1}m_{1}\bigg)" display="inline" intent=":literal"><semantics><mrow><mphantom></mphantom><mo>≥</mo><mrow><mstyle displaystyle="true"><mfrac><msub><mi>c</mi><mn>1</mn></msub><mn>2</mn></mfrac></mstyle><mo>−</mo><mrow><mn>2</mn><mo lspace="0em" rspace="0em">​</mo><msup><mi>W</mi><msub><mi>r</mi><mn>2</mn></msub></msup><mo lspace="0.167em" rspace="0em">​</mo><mrow><mi>exp</mi><mo>⁡</mo><mrow><mo maxsize="2.100em" minsize="2.100em">(</mo><mrow><mrow><mo>−</mo><mstyle displaystyle="true"><mfrac><mrow><msup><mrow><mo stretchy="false">(</mo><mrow><msqrt><mn>2</mn></msqrt><mo>/</mo><msub><mi>c</mi><mi>𝜽</mi></msub></mrow><mo stretchy="false">)</mo></mrow><mrow><mn>2</mn><mo>/</mo><mi>β</mi></mrow></msup><mo lspace="0.167em" rspace="0em">​</mo><msup><mi>log</mi><mn>2</mn></msup><mo lspace="0.167em" rspace="0em">​</mo><mi>W</mi></mrow><mn>2</mn></mfrac></mstyle></mrow><mo>+</mo><mrow><msub><mi>δ</mi><mn>1</mn></msub><mo lspace="0em" rspace="0em">​</mo><msub><mi>m</mi><mn>1</mn></msub></mrow></mrow><mo maxsize="2.100em" minsize="2.100em">)</mo></mrow></mrow></mrow></mrow></mrow><annotation encoding="application/x-tex">\displaystyle\geq\frac{c_{1}}{2}-2W^{r_{2}}\exp\bigg(-\frac{(\sqrt{2}/c_{\bm{\theta}})^{2/\beta}\log^{2}W}{2}+\delta_{1}m_{1}\bigg)</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
<tbody id="A6.Ex456"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_eqn_cell"></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A6.Ex456.m1" class="ltx_Math" alttext="\displaystyle\geq\frac{c_{1}}{4}," display="inline" intent=":literal"><semantics><mrow><mrow><mphantom></mphantom><mo>≥</mo><mstyle displaystyle="true"><mfrac><msub><mi>c</mi><mn>1</mn></msub><mn>4</mn></mfrac></mstyle></mrow><mo>,</mo></mrow><annotation encoding="application/x-tex">\displaystyle\geq\frac{c_{1}}{4},</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="A6.SS4.p5.5" class="ltx_p"><span id="A6.SS4.p5.5.1" class="ltx_text">provided that <math id="A6.SS4.p5.m14" class="ltx_Math" alttext="W" display="inline" intent=":literal"><semantics><mi>W</mi><annotation encoding="application/x-tex">W</annotation></semantics></math> is sufficiently large.
We used that by definition, <math id="A6.SS4.p5.m15" class="ltx_Math" alttext="\varphi_{W}(\lambda)\geq 1/W" display="inline" intent=":literal"><semantics><mrow><mrow><msub><mi>φ</mi><mi>W</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>λ</mi><mo stretchy="false">)</mo></mrow></mrow><mo>≥</mo><mrow><mn>1</mn><mo>/</mo><mi>W</mi></mrow></mrow><annotation encoding="application/x-tex">\varphi_{W}(\lambda)\geq 1/W</annotation></semantics></math> for the third inequality.
∎</span></p>
</div>
</div>
</section>
</section>
<section id="A7" class="ltx_appendix">
<h2 class="ltx_title ltx_title_appendix"><span class="ltx_tag ltx_tag_appendix">Appendix G </span>Technical Lemmas</h2>

<div id="Thmconj231" class="ltx_theorem ltx_theorem_lemma">
<h6 class="ltx_title ltx_runin ltx_title_theorem"><span class="ltx_tag ltx_tag_theorem"><span id="Thmconj231.4" class="ltx_text ltx_font_bold">Lemma 31</span></span><span id="Thmconj231.5" class="ltx_text ltx_font_bold"> </span>(Corollary A.7 of <cite class="ltx_cite ltx_citemacro_cite">[<a href="#bib.bib15" title="" class="ltx_ref">19</a>]</cite>)<span id="Thmconj231.6" class="ltx_text ltx_font_bold">.</span></h6>
<div id="Thmconj231.p1" class="ltx_para">
<p id="Thmconj231.p1.1" class="ltx_p"><span id="Thmconj231.p1.1.1" class="ltx_text ltx_font_italic">For any real-valued vectors <math id="Thmconj231.p1.m1" class="ltx_Math" alttext="\mathbf{x}" display="inline" intent=":literal"><semantics><mi>𝐱</mi><annotation encoding="application/x-tex">\mathbf{x}</annotation></semantics></math> and <math id="Thmconj231.p1.m2" class="ltx_Math" alttext="\mathbf{x}^{\prime}" display="inline" intent=":literal"><semantics><msup><mi>𝐱</mi><mo>′</mo></msup><annotation encoding="application/x-tex">\mathbf{x}^{\prime}</annotation></semantics></math> of the same dimension,</span></p>
<table id="A7.Ex457" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="A7.Ex457.m1" class="ltx_Math" alttext="\|\operatorname{softmax}(\mathbf{x})-\operatorname{softmax}(\mathbf{x}^{\prime})\|_{\infty}\leq\|\operatorname{softmax}(\mathbf{x})-\operatorname{softmax}(\mathbf{x}^{\prime})\|_{1}\leq 2\|\mathbf{x}-\mathbf{x}^{\prime}\|_{\infty}." display="block" intent=":literal"><semantics><mrow><mrow><msub><mrow><mo stretchy="false">‖</mo><mrow><mrow><mi>softmax</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>𝐱</mi><mo stretchy="false">)</mo></mrow></mrow><mo>−</mo><mrow><mi>softmax</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><msup><mi>𝐱</mi><mo>′</mo></msup><mo stretchy="false">)</mo></mrow></mrow></mrow><mo stretchy="false">‖</mo></mrow><mi mathvariant="normal">∞</mi></msub><mo>≤</mo><msub><mrow><mo stretchy="false">‖</mo><mrow><mrow><mi>softmax</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>𝐱</mi><mo stretchy="false">)</mo></mrow></mrow><mo>−</mo><mrow><mi>softmax</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><msup><mi>𝐱</mi><mo>′</mo></msup><mo stretchy="false">)</mo></mrow></mrow></mrow><mo stretchy="false">‖</mo></mrow><mn>1</mn></msub><mo>≤</mo><mrow><mn>2</mn><mo lspace="0em" rspace="0em">​</mo><msub><mrow><mo stretchy="false">‖</mo><mrow><mi>𝐱</mi><mo>−</mo><msup><mi>𝐱</mi><mo>′</mo></msup></mrow><mo stretchy="false">‖</mo></mrow><mi mathvariant="normal">∞</mi></msub></mrow></mrow><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">\|\operatorname{softmax}(\mathbf{x})-\operatorname{softmax}(\mathbf{x}^{\prime})\|_{\infty}\leq\|\operatorname{softmax}(\mathbf{x})-\operatorname{softmax}(\mathbf{x}^{\prime})\|_{1}\leq 2\|\mathbf{x}-\mathbf{x}^{\prime}\|_{\infty}.</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
</div>
</div>
<div id="Thmconj232" class="ltx_theorem ltx_theorem_lemma">
<h6 class="ltx_title ltx_runin ltx_title_theorem"><span class="ltx_tag ltx_tag_theorem"><span id="Thmconj232.4" class="ltx_text ltx_font_bold">Lemma 32</span></span><span id="Thmconj232.5" class="ltx_text ltx_font_bold">.</span></h6>
<div id="Thmconj232.p1" class="ltx_para">
<p id="Thmconj232.p1.1" class="ltx_p"><span id="Thmconj232.p1.1.1" class="ltx_text ltx_font_italic">If <math id="Thmconj232.p1.m1" class="ltx_Math" alttext="u_{1},\ldots,u_{m},v_{1},\ldots,v_{m}" display="inline" intent=":literal"><semantics><mrow><msub><mi>u</mi><mn>1</mn></msub><mo>,</mo><mi mathvariant="normal">…</mi><mo>,</mo><msub><mi>u</mi><mi>m</mi></msub><mo>,</mo><msub><mi>v</mi><mn>1</mn></msub><mo>,</mo><mi mathvariant="normal">…</mi><mo>,</mo><msub><mi>v</mi><mi>m</mi></msub></mrow><annotation encoding="application/x-tex">u_{1},\ldots,u_{m},v_{1},\ldots,v_{m}</annotation></semantics></math> are real numbers, <math id="Thmconj232.p1.m2" class="ltx_Math" alttext="U\coloneq\sum_{k=1}^{m}e^{u_{k}}" display="inline" intent=":literal"><semantics><mrow><mi>U</mi><mo rspace="0.111em">≔</mo><mrow><msubsup><mo>∑</mo><mrow><mi>k</mi><mo>=</mo><mn>1</mn></mrow><mi>m</mi></msubsup><msup><mi>e</mi><msub><mi>u</mi><mi>k</mi></msub></msup></mrow></mrow><annotation encoding="application/x-tex">U\coloneq\sum_{k=1}^{m}e^{u_{k}}</annotation></semantics></math>, and <math id="Thmconj232.p1.m3" class="ltx_Math" alttext="V\coloneq\sum_{k=1}^{m}e^{v_{k}}," display="inline" intent=":literal"><semantics><mrow><mrow><mi>V</mi><mo rspace="0.111em">≔</mo><mrow><msubsup><mo>∑</mo><mrow><mi>k</mi><mo>=</mo><mn>1</mn></mrow><mi>m</mi></msubsup><msup><mi>e</mi><msub><mi>v</mi><mi>k</mi></msub></msup></mrow></mrow><mo>,</mo></mrow><annotation encoding="application/x-tex">V\coloneq\sum_{k=1}^{m}e^{v_{k}},</annotation></semantics></math> then,</span></p>
<table id="A7.Ex458" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="A7.Ex458.m1" class="ltx_Math" alttext="\sum_{j=1}^{m}\frac{e^{u_{j}}}{U}\log\Big(e^{u_{j}-v_{j}}\frac{V}{U}\Big)\leq 4\max_{j}|u_{j}-v_{j}|^{2}." display="block" intent=":literal"><semantics><mrow><mrow><mrow><munderover><mo movablelimits="false">∑</mo><mrow><mi>j</mi><mo>=</mo><mn>1</mn></mrow><mi>m</mi></munderover><mrow><mfrac><msup><mi>e</mi><msub><mi>u</mi><mi>j</mi></msub></msup><mi>U</mi></mfrac><mo lspace="0.167em" rspace="0em">​</mo><mrow><mi>log</mi><mo>⁡</mo><mrow><mo maxsize="1.600em" minsize="1.600em">(</mo><mrow><msup><mi>e</mi><mrow><msub><mi>u</mi><mi>j</mi></msub><mo>−</mo><msub><mi>v</mi><mi>j</mi></msub></mrow></msup><mo lspace="0em" rspace="0em">​</mo><mfrac><mi>V</mi><mi>U</mi></mfrac></mrow><mo maxsize="1.600em" minsize="1.600em">)</mo></mrow></mrow></mrow></mrow><mo>≤</mo><mrow><mn>4</mn><mo lspace="0.167em" rspace="0em">​</mo><munder><mi>max</mi><mi>j</mi></munder><mo lspace="0em" rspace="0em">​</mo><msup><mrow><mo stretchy="false">|</mo><mrow><msub><mi>u</mi><mi>j</mi></msub><mo>−</mo><msub><mi>v</mi><mi>j</mi></msub></mrow><mo stretchy="false">|</mo></mrow><mn>2</mn></msup></mrow></mrow><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">\sum_{j=1}^{m}\frac{e^{u_{j}}}{U}\log\Big(e^{u_{j}-v_{j}}\frac{V}{U}\Big)\leq 4\max_{j}|u_{j}-v_{j}|^{2}.</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
</div>
</div>
<div id="A7.2" class="ltx_proof">
<h6 class="ltx_title ltx_runin ltx_font_italic ltx_title_proof">Proof.</h6>
<div id="A7.p1" class="ltx_para">
<p id="A7.p1.1" class="ltx_p"><span id="A7.p1.1.1" class="ltx_text">Let <math id="A7.p1.m1" class="ltx_Math" alttext="\Delta\coloneq\max_{j}|u_{j}-v_{j}|." display="inline" intent=":literal"><semantics><mrow><mrow><mi mathvariant="normal">Δ</mi><mo>≔</mo><mrow><msub><mi>max</mi><mi>j</mi></msub><mo>⁡</mo><mrow><mo stretchy="false">|</mo><mrow><msub><mi>u</mi><mi>j</mi></msub><mo>−</mo><msub><mi>v</mi><mi>j</mi></msub></mrow><mo stretchy="false">|</mo></mrow></mrow></mrow><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">\Delta\coloneq\max_{j}|u_{j}-v_{j}|.</annotation></semantics></math> Using the log sum inequality to bound <math id="A7.p1.m2" class="ltx_Math" alttext="\log(V/U)" display="inline" intent=":literal"><semantics><mrow><mi>log</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mrow><mi>V</mi><mo>/</mo><mi>U</mi></mrow><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">\log(V/U)</annotation></semantics></math>,</span></p>
<table id="A7.Ex459" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="A7.Ex459.m1" class="ltx_Math" alttext="\sum_{j=1}^{m}\frac{e^{u_{j}}}{U}\log\Big(e^{u_{j}-v_{j}}\frac{V}{U}\Big)=\sum_{j=1}^{m}\frac{e^{u_{j}}}{U}\big(u_{j}-v_{j}\big)+\log\Big(\frac{V}{U}\Big)\leq\sum_{j=1}^{m}\frac{e^{u_{j}}}{U}\big(u_{j}-v_{j}\big)+\frac{e^{v_{j}}}{V}\big(v_{j}-u_{j}\big)." display="block" intent=":literal"><semantics><mrow><mrow><mrow><munderover><mo movablelimits="false">∑</mo><mrow><mi>j</mi><mo>=</mo><mn>1</mn></mrow><mi>m</mi></munderover><mrow><mfrac><msup><mi>e</mi><msub><mi>u</mi><mi>j</mi></msub></msup><mi>U</mi></mfrac><mo lspace="0.167em" rspace="0em">​</mo><mrow><mi>log</mi><mo>⁡</mo><mrow><mo maxsize="1.600em" minsize="1.600em">(</mo><mrow><msup><mi>e</mi><mrow><msub><mi>u</mi><mi>j</mi></msub><mo>−</mo><msub><mi>v</mi><mi>j</mi></msub></mrow></msup><mo lspace="0em" rspace="0em">​</mo><mfrac><mi>V</mi><mi>U</mi></mfrac></mrow><mo maxsize="1.600em" minsize="1.600em">)</mo></mrow></mrow></mrow></mrow><mo rspace="0.111em">=</mo><mrow><mrow><munderover><mo movablelimits="false">∑</mo><mrow><mi>j</mi><mo>=</mo><mn>1</mn></mrow><mi>m</mi></munderover><mrow><mfrac><msup><mi>e</mi><msub><mi>u</mi><mi>j</mi></msub></msup><mi>U</mi></mfrac><mo lspace="0em" rspace="0em">​</mo><mrow><mo maxsize="1.200em" minsize="1.200em">(</mo><mrow><msub><mi>u</mi><mi>j</mi></msub><mo>−</mo><msub><mi>v</mi><mi>j</mi></msub></mrow><mo maxsize="1.200em" minsize="1.200em">)</mo></mrow></mrow></mrow><mo>+</mo><mrow><mi>log</mi><mo>⁡</mo><mrow><mo maxsize="1.600em" minsize="1.600em">(</mo><mfrac><mi>V</mi><mi>U</mi></mfrac><mo maxsize="1.600em" minsize="1.600em">)</mo></mrow></mrow></mrow><mo rspace="0.111em">≤</mo><mrow><mrow><munderover><mo movablelimits="false">∑</mo><mrow><mi>j</mi><mo>=</mo><mn>1</mn></mrow><mi>m</mi></munderover><mrow><mfrac><msup><mi>e</mi><msub><mi>u</mi><mi>j</mi></msub></msup><mi>U</mi></mfrac><mo lspace="0em" rspace="0em">​</mo><mrow><mo maxsize="1.200em" minsize="1.200em">(</mo><mrow><msub><mi>u</mi><mi>j</mi></msub><mo>−</mo><msub><mi>v</mi><mi>j</mi></msub></mrow><mo maxsize="1.200em" minsize="1.200em">)</mo></mrow></mrow></mrow><mo>+</mo><mrow><mfrac><msup><mi>e</mi><msub><mi>v</mi><mi>j</mi></msub></msup><mi>V</mi></mfrac><mo lspace="0em" rspace="0em">​</mo><mrow><mo maxsize="1.200em" minsize="1.200em">(</mo><mrow><msub><mi>v</mi><mi>j</mi></msub><mo>−</mo><msub><mi>u</mi><mi>j</mi></msub></mrow><mo maxsize="1.200em" minsize="1.200em">)</mo></mrow></mrow></mrow></mrow><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">\sum_{j=1}^{m}\frac{e^{u_{j}}}{U}\log\Big(e^{u_{j}-v_{j}}\frac{V}{U}\Big)=\sum_{j=1}^{m}\frac{e^{u_{j}}}{U}\big(u_{j}-v_{j}\big)+\log\Big(\frac{V}{U}\Big)\leq\sum_{j=1}^{m}\frac{e^{u_{j}}}{U}\big(u_{j}-v_{j}\big)+\frac{e^{v_{j}}}{V}\big(v_{j}-u_{j}\big).</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="A7.p1.2" class="ltx_p"><span id="A7.p1.2.1" class="ltx_text">The right hand side can be upper bounded by <math id="A7.p1.m3" class="ltx_Math" alttext="\leq 2\Delta." display="inline" intent=":literal"><semantics><mrow><mrow><mphantom></mphantom><mo>≤</mo><mrow><mn>2</mn><mo lspace="0em" rspace="0em">​</mo><mi mathvariant="normal">Δ</mi></mrow></mrow><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">\leq 2\Delta.</annotation></semantics></math> The right hand side can also be upper bounded by</span></p>
<table id="A7.EGx192" class="ltx_equationgroup ltx_eqn_align ltx_eqn_table">

<tbody id="A7.Ex460"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_align_right ltx_eqn_cell"><math id="A7.Ex460.m1" class="ltx_Math" alttext="\displaystyle\sum_{j=1}^{m}\big(u_{j}-v_{j}\big)\Big(\frac{e^{u_{j}}}{U}-\frac{e^{v_{j}}}{V}\Big)" display="inline" intent=":literal"><semantics><mrow><mstyle displaystyle="true"><munderover><mo movablelimits="false">∑</mo><mrow><mi>j</mi><mo>=</mo><mn>1</mn></mrow><mi>m</mi></munderover></mstyle><mrow><mrow><mo maxsize="1.200em" minsize="1.200em">(</mo><mrow><msub><mi>u</mi><mi>j</mi></msub><mo>−</mo><msub><mi>v</mi><mi>j</mi></msub></mrow><mo maxsize="1.200em" minsize="1.200em">)</mo></mrow><mo lspace="0em" rspace="0em">​</mo><mrow><mo maxsize="1.600em" minsize="1.600em">(</mo><mrow><mstyle displaystyle="true"><mfrac><msup><mi>e</mi><msub><mi>u</mi><mi>j</mi></msub></msup><mi>U</mi></mfrac></mstyle><mo>−</mo><mstyle displaystyle="true"><mfrac><msup><mi>e</mi><msub><mi>v</mi><mi>j</mi></msub></msup><mi>V</mi></mfrac></mstyle></mrow><mo maxsize="1.600em" minsize="1.600em">)</mo></mrow></mrow></mrow><annotation encoding="application/x-tex">\displaystyle\sum_{j=1}^{m}\big(u_{j}-v_{j}\big)\Big(\frac{e^{u_{j}}}{U}-\frac{e^{v_{j}}}{V}\Big)</annotation></semantics></math></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A7.Ex460.m2" class="ltx_Math" alttext="\displaystyle=\sum_{j=1}^{m}\big(u_{j}-v_{j}\big)\Big(\frac{e^{u_{j}}-e^{v_{j}}}{U}+\frac{e^{v_{j}}}{V}\cdot\frac{V-U}{U}\Big)" display="inline" intent=":literal"><semantics><mrow><mphantom></mphantom><mo>=</mo><mrow><mstyle displaystyle="true"><munderover><mo movablelimits="false">∑</mo><mrow><mi>j</mi><mo>=</mo><mn>1</mn></mrow><mi>m</mi></munderover></mstyle><mrow><mrow><mo maxsize="1.200em" minsize="1.200em">(</mo><mrow><msub><mi>u</mi><mi>j</mi></msub><mo>−</mo><msub><mi>v</mi><mi>j</mi></msub></mrow><mo maxsize="1.200em" minsize="1.200em">)</mo></mrow><mo lspace="0em" rspace="0em">​</mo><mrow><mo maxsize="1.600em" minsize="1.600em">(</mo><mrow><mstyle displaystyle="true"><mfrac><mrow><msup><mi>e</mi><msub><mi>u</mi><mi>j</mi></msub></msup><mo>−</mo><msup><mi>e</mi><msub><mi>v</mi><mi>j</mi></msub></msup></mrow><mi>U</mi></mfrac></mstyle><mo>+</mo><mrow><mstyle displaystyle="true"><mfrac><msup><mi>e</mi><msub><mi>v</mi><mi>j</mi></msub></msup><mi>V</mi></mfrac></mstyle><mo lspace="0.222em" rspace="0.222em">⋅</mo><mstyle displaystyle="true"><mfrac><mrow><mi>V</mi><mo>−</mo><mi>U</mi></mrow><mi>U</mi></mfrac></mstyle></mrow></mrow><mo maxsize="1.600em" minsize="1.600em">)</mo></mrow></mrow></mrow></mrow><annotation encoding="application/x-tex">\displaystyle=\sum_{j=1}^{m}\big(u_{j}-v_{j}\big)\Big(\frac{e^{u_{j}}-e^{v_{j}}}{U}+\frac{e^{v_{j}}}{V}\cdot\frac{V-U}{U}\Big)</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
<tbody id="A7.Ex461"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_eqn_cell"></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A7.Ex461.m1" class="ltx_Math" alttext="\displaystyle\leq\Delta\big(e^{\Delta}-1\big)+\Delta\frac{|V-U|}{U}" display="inline" intent=":literal"><semantics><mrow><mphantom></mphantom><mo>≤</mo><mrow><mrow><mi mathvariant="normal">Δ</mi><mo>⁡</mo><mrow><mo maxsize="1.200em" minsize="1.200em">(</mo><mrow><msup><mi>e</mi><mi mathvariant="normal">Δ</mi></msup><mo>−</mo><mn>1</mn></mrow><mo maxsize="1.200em" minsize="1.200em">)</mo></mrow></mrow><mo>+</mo><mrow><mi mathvariant="normal">Δ</mi><mo lspace="0em" rspace="0em">​</mo><mstyle displaystyle="true"><mfrac><mrow><mo stretchy="false">|</mo><mrow><mi>V</mi><mo>−</mo><mi>U</mi></mrow><mo stretchy="false">|</mo></mrow><mi>U</mi></mfrac></mstyle></mrow></mrow></mrow><annotation encoding="application/x-tex">\displaystyle\leq\Delta\big(e^{\Delta}-1\big)+\Delta\frac{|V-U|}{U}</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
<tbody id="A7.Ex462"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_eqn_cell"></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A7.Ex462.m1" class="ltx_Math" alttext="\displaystyle\leq 2\Delta\big(e^{\Delta}-1\big)," display="inline" intent=":literal"><semantics><mrow><mrow><mphantom></mphantom><mo>≤</mo><mrow><mn>2</mn><mo lspace="0em" rspace="0em">​</mo><mi mathvariant="normal">Δ</mi><mo lspace="0em" rspace="0em">​</mo><mrow><mo maxsize="1.200em" minsize="1.200em">(</mo><mrow><msup><mi>e</mi><mi mathvariant="normal">Δ</mi></msup><mo>−</mo><mn>1</mn></mrow><mo maxsize="1.200em" minsize="1.200em">)</mo></mrow></mrow></mrow><mo>,</mo></mrow><annotation encoding="application/x-tex">\displaystyle\leq 2\Delta\big(e^{\Delta}-1\big),</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="A7.p1.3" class="ltx_p"><span id="A7.p1.3.1" class="ltx_text">using that for any two real numbers <math id="A7.p1.m4" class="ltx_Math" alttext="u,v," display="inline" intent=":literal"><semantics><mrow><mrow><mi>u</mi><mo>,</mo><mi>v</mi></mrow><mo>,</mo></mrow><annotation encoding="application/x-tex">u,v,</annotation></semantics></math> <math id="A7.p1.m5" class="ltx_Math" alttext="|e^{u}-e^{v}|\leq(e^{|u-v|}-1)e^{u}." display="inline" intent=":literal"><semantics><mrow><mrow><mrow><mo stretchy="false">|</mo><mrow><msup><mi>e</mi><mi>u</mi></msup><mo>−</mo><msup><mi>e</mi><mi>v</mi></msup></mrow><mo stretchy="false">|</mo></mrow><mo>≤</mo><mrow><mrow><mo stretchy="false">(</mo><mrow><msup><mi>e</mi><mrow><mo stretchy="false">|</mo><mrow><mi>u</mi><mo>−</mo><mi>v</mi></mrow><mo stretchy="false">|</mo></mrow></msup><mo>−</mo><mn>1</mn></mrow><mo stretchy="false">)</mo></mrow><mo lspace="0em" rspace="0em">​</mo><msup><mi>e</mi><mi>u</mi></msup></mrow></mrow><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">|e^{u}-e^{v}|\leq(e^{|u-v|}-1)e^{u}.</annotation></semantics></math> Combining both upper bounds and using that for any <math id="A7.p1.m6" class="ltx_Math" alttext="x\leq\log(2)," display="inline" intent=":literal"><semantics><mrow><mrow><mi>x</mi><mo>≤</mo><mrow><mi>log</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mn>2</mn><mo stretchy="false">)</mo></mrow></mrow></mrow><mo>,</mo></mrow><annotation encoding="application/x-tex">x\leq\log(2),</annotation></semantics></math> <math id="A7.p1.m7" class="ltx_Math" alttext="e^{x}-1=x+\sum_{k=2}^{\infty}x^{k}/k!\leq x+\tfrac{1}{2}x\sum_{\ell=1}^{\infty}x^{\ell}/\ell!\leq x+\tfrac{1}{2}xe^{x}\leq 2x" display="inline" intent=":literal"><semantics><mrow><mrow><msup><mi>e</mi><mi>x</mi></msup><mo>−</mo><mn>1</mn></mrow><mo>=</mo><mrow><mi>x</mi><mo rspace="0.055em">+</mo><mrow><mrow><msubsup><mo>∑</mo><mrow><mi>k</mi><mo>=</mo><mn>2</mn></mrow><mi mathvariant="normal">∞</mi></msubsup><msup><mi>x</mi><mi>k</mi></msup></mrow><mo>/</mo><mrow><mi>k</mi><mo>!</mo></mrow></mrow></mrow><mo>≤</mo><mrow><mi>x</mi><mo>+</mo><mrow><mrow><mfrac><mn>1</mn><mn>2</mn></mfrac><mo lspace="0em" rspace="0em">​</mo><mi>x</mi><mo lspace="0em" rspace="0em">​</mo><mrow><msubsup><mo>∑</mo><mrow><mi mathvariant="normal">ℓ</mi><mo>=</mo><mn>1</mn></mrow><mi mathvariant="normal">∞</mi></msubsup><msup><mi>x</mi><mi mathvariant="normal">ℓ</mi></msup></mrow></mrow><mo>/</mo><mrow><mi mathvariant="normal">ℓ</mi><mo>!</mo></mrow></mrow></mrow><mo>≤</mo><mrow><mi>x</mi><mo>+</mo><mrow><mfrac><mn>1</mn><mn>2</mn></mfrac><mo lspace="0em" rspace="0em">​</mo><mi>x</mi><mo lspace="0em" rspace="0em">​</mo><msup><mi>e</mi><mi>x</mi></msup></mrow></mrow><mo>≤</mo><mrow><mn>2</mn><mo lspace="0em" rspace="0em">​</mo><mi>x</mi></mrow></mrow><annotation encoding="application/x-tex">e^{x}-1=x+\sum_{k=2}^{\infty}x^{k}/k!\leq x+\tfrac{1}{2}x\sum_{\ell=1}^{\infty}x^{\ell}/\ell!\leq x+\tfrac{1}{2}xe^{x}\leq 2x</annotation></semantics></math> yields the upper bound</span></p>
<table id="A7.Ex463" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="A7.Ex463.m1" class="ltx_Math" alttext="\leq 2\Delta\min\Big(1,e^{\Delta}-1\Big)\leq 2\Delta\min(1,2\Delta)\leq 4\Delta^{2}." display="block" intent=":literal"><semantics><mrow><mrow><mphantom></mphantom><mo>≤</mo><mrow><mn>2</mn><mo lspace="0em" rspace="0em">​</mo><mi mathvariant="normal">Δ</mi><mo lspace="0.167em" rspace="0em">​</mo><mrow><mi>min</mi><mo>⁡</mo><mrow><mo maxsize="1.600em" minsize="1.600em">(</mo><mn>1</mn><mo>,</mo><mrow><msup><mi>e</mi><mi mathvariant="normal">Δ</mi></msup><mo>−</mo><mn>1</mn></mrow><mo maxsize="1.600em" minsize="1.600em">)</mo></mrow></mrow></mrow><mo>≤</mo><mrow><mn>2</mn><mo lspace="0em" rspace="0em">​</mo><mi mathvariant="normal">Δ</mi><mo lspace="0.167em" rspace="0em">​</mo><mrow><mi>min</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mn>1</mn><mo>,</mo><mrow><mn>2</mn><mo lspace="0em" rspace="0em">​</mo><mi mathvariant="normal">Δ</mi></mrow><mo stretchy="false">)</mo></mrow></mrow></mrow><mo>≤</mo><mrow><mn>4</mn><mo lspace="0em" rspace="0em">​</mo><msup><mi mathvariant="normal">Δ</mi><mn>2</mn></msup></mrow></mrow><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">\leq 2\Delta\min\Big(1,e^{\Delta}-1\Big)\leq 2\Delta\min(1,2\Delta)\leq 4\Delta^{2}.</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="A7.p1.4" class="ltx_p"><span id="A7.p1.4.1" class="ltx_text">∎</span></p>
</div>
</div>
<div id="Thmconj233" class="ltx_theorem ltx_theorem_lemma">
<h6 class="ltx_title ltx_runin ltx_title_theorem"><span class="ltx_tag ltx_tag_theorem"><span id="Thmconj233.4" class="ltx_text ltx_font_bold">Lemma 33</span></span><span id="Thmconj233.5" class="ltx_text ltx_font_bold">.</span></h6>
<div id="Thmconj233.p1" class="ltx_para">
<p id="Thmconj233.p1.1" class="ltx_p"><span id="Thmconj233.p1.1.1" class="ltx_text ltx_font_italic">For any <math id="Thmconj233.p1.m1" class="ltx_Math" alttext="\delta&gt;0," display="inline" intent=":literal"><semantics><mrow><mrow><mi>δ</mi><mo>&gt;</mo><mn>0</mn></mrow><mo>,</mo></mrow><annotation encoding="application/x-tex">\delta&gt;0,</annotation></semantics></math> any <math id="Thmconj233.p1.m2" class="ltx_Math" alttext="\mathbf{v}_{1},\mathbf{v}_{2}\in\delta\mathbb{S}^{m-1}," display="inline" intent=":literal"><semantics><mrow><mrow><msub><mi>𝐯</mi><mn>1</mn></msub><mo>,</mo><mrow><msub><mi>𝐯</mi><mn>2</mn></msub><mo>∈</mo><mrow><mi>δ</mi><mo lspace="0em" rspace="0em">​</mo><msup><mi>𝕊</mi><mrow><mi>m</mi><mo>−</mo><mn>1</mn></mrow></msup></mrow></mrow></mrow><mo>,</mo></mrow><annotation encoding="application/x-tex">\mathbf{v}_{1},\mathbf{v}_{2}\in\delta\mathbb{S}^{m-1},</annotation></semantics></math> and any <math id="Thmconj233.p1.m3" class="ltx_Math" alttext="\mathbf{u}_{1},\ldots,\mathbf{u}_{W}\in\mathbb{S}^{m-1}" display="inline" intent=":literal"><semantics><mrow><msub><mi>𝐮</mi><mn>1</mn></msub><mo>,</mo><mi mathvariant="normal">…</mi><mo>,</mo><mrow><msub><mi>𝐮</mi><mi>W</mi></msub><mo>∈</mo><msup><mi>𝕊</mi><mrow><mi>m</mi><mo>−</mo><mn>1</mn></mrow></msup></mrow></mrow><annotation encoding="application/x-tex">\mathbf{u}_{1},\ldots,\mathbf{u}_{W}\in\mathbb{S}^{m-1}</annotation></semantics></math>,</span></p>
<table id="A7.Ex464" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="A7.Ex464.m1" class="ltx_Math" alttext="\left\|\frac{\sum_{w=1}^{W}\exp\big(\mathbf{v}_{1}^{\top}\mathbf{u}_{w}\big)\mathbf{u}_{w}}{\sum_{w=1}^{W}\exp\big(\mathbf{v}_{1}^{\top}\mathbf{u}_{w}\big)}-\frac{\sum_{w=1}^{W}\exp\big(\mathbf{v}_{2}^{\top}\mathbf{u}_{w}\big)\mathbf{u}_{w}}{\sum_{w=1}^{W}\exp\big(\mathbf{v}_{2}^{\top}\mathbf{u}_{w}\big)}\right\|_{\infty}\leq 2\|\mathbf{v}_{1}-\mathbf{v}_{2}\|_{2}." display="block" intent=":literal"><semantics><mrow><mrow><msub><mrow><mo>‖</mo><mrow><mfrac><mrow><msubsup><mo>∑</mo><mrow><mi>w</mi><mo>=</mo><mn>1</mn></mrow><mi>W</mi></msubsup><mrow><mrow><mi>exp</mi><mo>⁡</mo><mrow><mo maxsize="1.200em" minsize="1.200em">(</mo><mrow><msubsup><mi>𝐯</mi><mn>1</mn><mo>⊤</mo></msubsup><mo lspace="0em" rspace="0em">​</mo><msub><mi>𝐮</mi><mi>w</mi></msub></mrow><mo maxsize="1.200em" minsize="1.200em">)</mo></mrow></mrow><mo lspace="0em" rspace="0em">​</mo><msub><mi>𝐮</mi><mi>w</mi></msub></mrow></mrow><mrow><msubsup><mo>∑</mo><mrow><mi>w</mi><mo>=</mo><mn>1</mn></mrow><mi>W</mi></msubsup><mrow><mi>exp</mi><mo>⁡</mo><mrow><mo maxsize="1.200em" minsize="1.200em">(</mo><mrow><msubsup><mi>𝐯</mi><mn>1</mn><mo>⊤</mo></msubsup><mo lspace="0em" rspace="0em">​</mo><msub><mi>𝐮</mi><mi>w</mi></msub></mrow><mo maxsize="1.200em" minsize="1.200em">)</mo></mrow></mrow></mrow></mfrac><mo>−</mo><mfrac><mrow><msubsup><mo>∑</mo><mrow><mi>w</mi><mo>=</mo><mn>1</mn></mrow><mi>W</mi></msubsup><mrow><mrow><mi>exp</mi><mo>⁡</mo><mrow><mo maxsize="1.200em" minsize="1.200em">(</mo><mrow><msubsup><mi>𝐯</mi><mn>2</mn><mo>⊤</mo></msubsup><mo lspace="0em" rspace="0em">​</mo><msub><mi>𝐮</mi><mi>w</mi></msub></mrow><mo maxsize="1.200em" minsize="1.200em">)</mo></mrow></mrow><mo lspace="0em" rspace="0em">​</mo><msub><mi>𝐮</mi><mi>w</mi></msub></mrow></mrow><mrow><msubsup><mo>∑</mo><mrow><mi>w</mi><mo>=</mo><mn>1</mn></mrow><mi>W</mi></msubsup><mrow><mi>exp</mi><mo>⁡</mo><mrow><mo maxsize="1.200em" minsize="1.200em">(</mo><mrow><msubsup><mi>𝐯</mi><mn>2</mn><mo>⊤</mo></msubsup><mo lspace="0em" rspace="0em">​</mo><msub><mi>𝐮</mi><mi>w</mi></msub></mrow><mo maxsize="1.200em" minsize="1.200em">)</mo></mrow></mrow></mrow></mfrac></mrow><mo>‖</mo></mrow><mi mathvariant="normal">∞</mi></msub><mo>≤</mo><mrow><mn>2</mn><mo lspace="0em" rspace="0em">​</mo><msub><mrow><mo stretchy="false">‖</mo><mrow><msub><mi>𝐯</mi><mn>1</mn></msub><mo>−</mo><msub><mi>𝐯</mi><mn>2</mn></msub></mrow><mo stretchy="false">‖</mo></mrow><mn>2</mn></msub></mrow></mrow><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">\left\|\frac{\sum_{w=1}^{W}\exp\big(\mathbf{v}_{1}^{\top}\mathbf{u}_{w}\big)\mathbf{u}_{w}}{\sum_{w=1}^{W}\exp\big(\mathbf{v}_{1}^{\top}\mathbf{u}_{w}\big)}-\frac{\sum_{w=1}^{W}\exp\big(\mathbf{v}_{2}^{\top}\mathbf{u}_{w}\big)\mathbf{u}_{w}}{\sum_{w=1}^{W}\exp\big(\mathbf{v}_{2}^{\top}\mathbf{u}_{w}\big)}\right\|_{\infty}\leq 2\|\mathbf{v}_{1}-\mathbf{v}_{2}\|_{2}.</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
</div>
</div>
<div id="A7.3" class="ltx_proof">
<h6 class="ltx_title ltx_runin ltx_font_italic ltx_title_proof">Proof.</h6>
<div id="A7.p2" class="ltx_para">
<p id="A7.p2.1" class="ltx_p"><span id="A7.p2.1.1" class="ltx_text">Define for <math id="A7.p2.m1" class="ltx_Math" alttext="\mathbf{v}\in\delta\mathbb{S}^{m-1}" display="inline" intent=":literal"><semantics><mrow><mi>𝐯</mi><mo>∈</mo><mrow><mi>δ</mi><mo lspace="0em" rspace="0em">​</mo><msup><mi>𝕊</mi><mrow><mi>m</mi><mo>−</mo><mn>1</mn></mrow></msup></mrow></mrow><annotation encoding="application/x-tex">\mathbf{v}\in\delta\mathbb{S}^{m-1}</annotation></semantics></math></span></p>
<table id="A7.Ex465" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="A7.Ex465.m1" class="ltx_Math" alttext="\mathbf{p}(\mathbf{v})\coloneqq\Big(\frac{\exp\big(\mathbf{v}^{\top}\mathbf{u}_{w}\big)}{\sum_{i=1}^{W}\exp\big(\mathbf{v}^{\top}\mathbf{u}_{i}\big)}\Big)_{w\in[W]}=\operatorname{softmax}\big(\mathbf{y}(\mathbf{v})\big),\qquad\mathbf{y}(\mathbf{v})\coloneqq(\mathbf{v}^{\top}\mathbf{u}_{1},\ldots,\mathbf{v}^{\top}\mathbf{u}_{W})^{\top}." display="block" intent=":literal"><semantics><mrow><mrow><mrow><mrow><mi>𝐩</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>𝐯</mi><mo stretchy="false">)</mo></mrow></mrow><mo>≔</mo><msub><mrow><mo maxsize="1.600em" minsize="1.600em">(</mo><mfrac><mrow><mi>exp</mi><mo>⁡</mo><mrow><mo maxsize="1.200em" minsize="1.200em">(</mo><mrow><msup><mi>𝐯</mi><mo>⊤</mo></msup><mo lspace="0em" rspace="0em">​</mo><msub><mi>𝐮</mi><mi>w</mi></msub></mrow><mo maxsize="1.200em" minsize="1.200em">)</mo></mrow></mrow><mrow><msubsup><mo>∑</mo><mrow><mi>i</mi><mo>=</mo><mn>1</mn></mrow><mi>W</mi></msubsup><mrow><mi>exp</mi><mo>⁡</mo><mrow><mo maxsize="1.200em" minsize="1.200em">(</mo><mrow><msup><mi>𝐯</mi><mo>⊤</mo></msup><mo lspace="0em" rspace="0em">​</mo><msub><mi>𝐮</mi><mi>i</mi></msub></mrow><mo maxsize="1.200em" minsize="1.200em">)</mo></mrow></mrow></mrow></mfrac><mo maxsize="1.600em" minsize="1.600em">)</mo></mrow><mrow><mi>w</mi><mo>∈</mo><mrow><mo stretchy="false">[</mo><mi>W</mi><mo stretchy="false">]</mo></mrow></mrow></msub><mo>=</mo><mrow><mi>softmax</mi><mo>⁡</mo><mrow><mo maxsize="1.200em" minsize="1.200em">(</mo><mrow><mi>𝐲</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>𝐯</mi><mo stretchy="false">)</mo></mrow></mrow><mo maxsize="1.200em" minsize="1.200em">)</mo></mrow></mrow></mrow><mo rspace="2.167em">,</mo><mrow><mrow><mi>𝐲</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>𝐯</mi><mo stretchy="false">)</mo></mrow></mrow><mo>≔</mo><msup><mrow><mo stretchy="false">(</mo><mrow><msup><mi>𝐯</mi><mo>⊤</mo></msup><mo lspace="0em" rspace="0em">​</mo><msub><mi>𝐮</mi><mn>1</mn></msub></mrow><mo>,</mo><mi mathvariant="normal">…</mi><mo>,</mo><mrow><msup><mi>𝐯</mi><mo>⊤</mo></msup><mo lspace="0em" rspace="0em">​</mo><msub><mi>𝐮</mi><mi>W</mi></msub></mrow><mo stretchy="false">)</mo></mrow><mo>⊤</mo></msup></mrow></mrow><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">\mathbf{p}(\mathbf{v})\coloneqq\Big(\frac{\exp\big(\mathbf{v}^{\top}\mathbf{u}_{w}\big)}{\sum_{i=1}^{W}\exp\big(\mathbf{v}^{\top}\mathbf{u}_{i}\big)}\Big)_{w\in[W]}=\operatorname{softmax}\big(\mathbf{y}(\mathbf{v})\big),\qquad\mathbf{y}(\mathbf{v})\coloneqq(\mathbf{v}^{\top}\mathbf{u}_{1},\ldots,\mathbf{v}^{\top}\mathbf{u}_{W})^{\top}.</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="A7.p2.2" class="ltx_p"><span id="A7.p2.2.1" class="ltx_text">Since for each coordinate <math id="A7.p2.m2" class="ltx_Math" alttext="j\in[m]" display="inline" intent=":literal"><semantics><mrow><mi>j</mi><mo>∈</mo><mrow><mo stretchy="false">[</mo><mi>m</mi><mo stretchy="false">]</mo></mrow></mrow><annotation encoding="application/x-tex">j\in[m]</annotation></semantics></math>,</span></p>
<table id="A7.EGx193" class="ltx_equationgroup ltx_eqn_align ltx_eqn_table">

<tbody id="A7.Ex466"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_eqn_cell"></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A7.Ex466.m1" class="ltx_Math" alttext="\displaystyle\left|\frac{\sum_{w=1}^{W}\exp\big(\mathbf{v}_{1}^{\top}\mathbf{u}_{w}\big)(\mathbf{u}_{w})_{(j)}}{\sum_{w=1}^{W}\exp\big(\mathbf{v}_{1}^{\top}\mathbf{u}_{w}\big)}-\frac{\sum_{w=1}^{W}\exp\big(\mathbf{v}_{2}^{\top}\mathbf{u}_{w}\big)(\mathbf{u}_{w})_{(j)}}{\sum_{w=1}^{W}\exp\big(\mathbf{v}_{2}^{\top}\mathbf{u}_{w}\big)}\right|" display="inline" intent=":literal"><semantics><mrow><mo>|</mo><mrow><mstyle displaystyle="true"><mfrac><mrow><msubsup><mo>∑</mo><mrow><mi>w</mi><mo>=</mo><mn>1</mn></mrow><mi>W</mi></msubsup><mrow><mrow><mi>exp</mi><mo>⁡</mo><mrow><mo maxsize="1.200em" minsize="1.200em">(</mo><mrow><msubsup><mi>𝐯</mi><mn>1</mn><mo>⊤</mo></msubsup><mo lspace="0em" rspace="0em">​</mo><msub><mi>𝐮</mi><mi>w</mi></msub></mrow><mo maxsize="1.200em" minsize="1.200em">)</mo></mrow></mrow><mo lspace="0em" rspace="0em">​</mo><msub><mrow><mo stretchy="false">(</mo><msub><mi>𝐮</mi><mi>w</mi></msub><mo stretchy="false">)</mo></mrow><mrow><mo stretchy="false">(</mo><mi>j</mi><mo stretchy="false">)</mo></mrow></msub></mrow></mrow><mrow><msubsup><mo>∑</mo><mrow><mi>w</mi><mo>=</mo><mn>1</mn></mrow><mi>W</mi></msubsup><mrow><mi>exp</mi><mo>⁡</mo><mrow><mo maxsize="1.200em" minsize="1.200em">(</mo><mrow><msubsup><mi>𝐯</mi><mn>1</mn><mo>⊤</mo></msubsup><mo lspace="0em" rspace="0em">​</mo><msub><mi>𝐮</mi><mi>w</mi></msub></mrow><mo maxsize="1.200em" minsize="1.200em">)</mo></mrow></mrow></mrow></mfrac></mstyle><mo>−</mo><mstyle displaystyle="true"><mfrac><mrow><msubsup><mo>∑</mo><mrow><mi>w</mi><mo>=</mo><mn>1</mn></mrow><mi>W</mi></msubsup><mrow><mrow><mi>exp</mi><mo>⁡</mo><mrow><mo maxsize="1.200em" minsize="1.200em">(</mo><mrow><msubsup><mi>𝐯</mi><mn>2</mn><mo>⊤</mo></msubsup><mo lspace="0em" rspace="0em">​</mo><msub><mi>𝐮</mi><mi>w</mi></msub></mrow><mo maxsize="1.200em" minsize="1.200em">)</mo></mrow></mrow><mo lspace="0em" rspace="0em">​</mo><msub><mrow><mo stretchy="false">(</mo><msub><mi>𝐮</mi><mi>w</mi></msub><mo stretchy="false">)</mo></mrow><mrow><mo stretchy="false">(</mo><mi>j</mi><mo stretchy="false">)</mo></mrow></msub></mrow></mrow><mrow><msubsup><mo>∑</mo><mrow><mi>w</mi><mo>=</mo><mn>1</mn></mrow><mi>W</mi></msubsup><mrow><mi>exp</mi><mo>⁡</mo><mrow><mo maxsize="1.200em" minsize="1.200em">(</mo><mrow><msubsup><mi>𝐯</mi><mn>2</mn><mo>⊤</mo></msubsup><mo lspace="0em" rspace="0em">​</mo><msub><mi>𝐮</mi><mi>w</mi></msub></mrow><mo maxsize="1.200em" minsize="1.200em">)</mo></mrow></mrow></mrow></mfrac></mstyle></mrow><mo>|</mo></mrow><annotation encoding="application/x-tex">\displaystyle\left|\frac{\sum_{w=1}^{W}\exp\big(\mathbf{v}_{1}^{\top}\mathbf{u}_{w}\big)(\mathbf{u}_{w})_{(j)}}{\sum_{w=1}^{W}\exp\big(\mathbf{v}_{1}^{\top}\mathbf{u}_{w}\big)}-\frac{\sum_{w=1}^{W}\exp\big(\mathbf{v}_{2}^{\top}\mathbf{u}_{w}\big)(\mathbf{u}_{w})_{(j)}}{\sum_{w=1}^{W}\exp\big(\mathbf{v}_{2}^{\top}\mathbf{u}_{w}\big)}\right|</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
<tbody id="A7.Ex467"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_eqn_cell"></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A7.Ex467.m1" class="ltx_Math" alttext="\displaystyle=\left|\sum_{w=1}^{W}\mathbf{p}(\mathbf{v}_{1})_{(w)}(\mathbf{u}_{w})_{(j)}-\sum_{w=1}^{W}\mathbf{p}(\mathbf{v}_{2})_{(w)}(\mathbf{u}_{w})_{(j)}\right|" display="inline" intent=":literal"><semantics><mrow><mphantom></mphantom><mo>=</mo><mrow><mo>|</mo><mrow><mrow><mstyle displaystyle="true"><munderover><mo movablelimits="false">∑</mo><mrow><mi>w</mi><mo>=</mo><mn>1</mn></mrow><mi>W</mi></munderover></mstyle><mrow><mi>𝐩</mi><mo lspace="0em" rspace="0em">​</mo><msub><mrow><mo stretchy="false">(</mo><msub><mi>𝐯</mi><mn>1</mn></msub><mo stretchy="false">)</mo></mrow><mrow><mo stretchy="false">(</mo><mi>w</mi><mo stretchy="false">)</mo></mrow></msub><mo lspace="0em" rspace="0em">​</mo><msub><mrow><mo stretchy="false">(</mo><msub><mi>𝐮</mi><mi>w</mi></msub><mo stretchy="false">)</mo></mrow><mrow><mo stretchy="false">(</mo><mi>j</mi><mo stretchy="false">)</mo></mrow></msub></mrow></mrow><mo>−</mo><mrow><mstyle displaystyle="true"><munderover><mo movablelimits="false">∑</mo><mrow><mi>w</mi><mo>=</mo><mn>1</mn></mrow><mi>W</mi></munderover></mstyle><mrow><mi>𝐩</mi><mo lspace="0em" rspace="0em">​</mo><msub><mrow><mo stretchy="false">(</mo><msub><mi>𝐯</mi><mn>2</mn></msub><mo stretchy="false">)</mo></mrow><mrow><mo stretchy="false">(</mo><mi>w</mi><mo stretchy="false">)</mo></mrow></msub><mo lspace="0em" rspace="0em">​</mo><msub><mrow><mo stretchy="false">(</mo><msub><mi>𝐮</mi><mi>w</mi></msub><mo stretchy="false">)</mo></mrow><mrow><mo stretchy="false">(</mo><mi>j</mi><mo stretchy="false">)</mo></mrow></msub></mrow></mrow></mrow><mo>|</mo></mrow></mrow><annotation encoding="application/x-tex">\displaystyle=\left|\sum_{w=1}^{W}\mathbf{p}(\mathbf{v}_{1})_{(w)}(\mathbf{u}_{w})_{(j)}-\sum_{w=1}^{W}\mathbf{p}(\mathbf{v}_{2})_{(w)}(\mathbf{u}_{w})_{(j)}\right|</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
<tbody id="A7.Ex468"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_eqn_cell"></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A7.Ex468.m1" class="ltx_Math" alttext="\displaystyle\leq\sum_{w=1}^{W}\big|\mathbf{p}(\mathbf{v}_{1})_{(w)}-\mathbf{p}(\mathbf{v}_{2})_{(w)}\big|\big|(\mathbf{u}_{w})_{(j)}\big|" display="inline" intent=":literal"><semantics><mrow><mphantom></mphantom><mo>≤</mo><mrow><mstyle displaystyle="true"><munderover><mo movablelimits="false">∑</mo><mrow><mi>w</mi><mo>=</mo><mn>1</mn></mrow><mi>W</mi></munderover></mstyle><mrow><mrow><mo maxsize="1.200em" minsize="1.200em" stretchy="true">|</mo><mrow><mrow><mi>𝐩</mi><mo lspace="0em" rspace="0em">​</mo><msub><mrow><mo stretchy="false">(</mo><msub><mi>𝐯</mi><mn>1</mn></msub><mo stretchy="false">)</mo></mrow><mrow><mo stretchy="false">(</mo><mi>w</mi><mo stretchy="false">)</mo></mrow></msub></mrow><mo>−</mo><mrow><mi>𝐩</mi><mo lspace="0em" rspace="0em">​</mo><msub><mrow><mo stretchy="false">(</mo><msub><mi>𝐯</mi><mn>2</mn></msub><mo stretchy="false">)</mo></mrow><mrow><mo stretchy="false">(</mo><mi>w</mi><mo stretchy="false">)</mo></mrow></msub></mrow></mrow><mo maxsize="1.200em" minsize="1.200em" stretchy="true">|</mo></mrow><mo lspace="0em" rspace="0em">​</mo><mrow><mo maxsize="1.200em" minsize="1.200em" stretchy="true">|</mo><msub><mrow><mo stretchy="false">(</mo><msub><mi>𝐮</mi><mi>w</mi></msub><mo stretchy="false">)</mo></mrow><mrow><mo stretchy="false">(</mo><mi>j</mi><mo stretchy="false">)</mo></mrow></msub><mo maxsize="1.200em" minsize="1.200em" stretchy="true">|</mo></mrow></mrow></mrow></mrow><annotation encoding="application/x-tex">\displaystyle\leq\sum_{w=1}^{W}\big|\mathbf{p}(\mathbf{v}_{1})_{(w)}-\mathbf{p}(\mathbf{v}_{2})_{(w)}\big|\big|(\mathbf{u}_{w})_{(j)}\big|</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
<tbody id="A7.Ex469"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_eqn_cell"></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A7.Ex469.m1" class="ltx_Math" alttext="\displaystyle\leq\big\|\mathbf{p}(\mathbf{v}_{1})-\mathbf{p}(\mathbf{v}_{2})\big\|_{1}" display="inline" intent=":literal"><semantics><mrow><mphantom></mphantom><mo>≤</mo><msub><mrow><mo maxsize="1.200em" minsize="1.200em" stretchy="true">‖</mo><mrow><mrow><mi>𝐩</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><msub><mi>𝐯</mi><mn>1</mn></msub><mo stretchy="false">)</mo></mrow></mrow><mo>−</mo><mrow><mi>𝐩</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><msub><mi>𝐯</mi><mn>2</mn></msub><mo stretchy="false">)</mo></mrow></mrow></mrow><mo maxsize="1.200em" minsize="1.200em" stretchy="true">‖</mo></mrow><mn>1</mn></msub></mrow><annotation encoding="application/x-tex">\displaystyle\leq\big\|\mathbf{p}(\mathbf{v}_{1})-\mathbf{p}(\mathbf{v}_{2})\big\|_{1}</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="A7.p2.3" class="ltx_p"><span id="A7.p2.3.1" class="ltx_text">and <math id="A7.p2.m3" class="ltx_Math" alttext="\|\operatorname{softmax}(\mathbf{x})-\operatorname{softmax}(\mathbf{x}^{\prime})\|_{1}\leq 2\|\mathbf{x}-\mathbf{x}^{\prime}\|_{\infty}" display="inline" intent=":literal"><semantics><mrow><msub><mrow><mo stretchy="false">‖</mo><mrow><mrow><mi>softmax</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>𝐱</mi><mo stretchy="false">)</mo></mrow></mrow><mo>−</mo><mrow><mi>softmax</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><msup><mi>𝐱</mi><mo>′</mo></msup><mo stretchy="false">)</mo></mrow></mrow></mrow><mo stretchy="false">‖</mo></mrow><mn>1</mn></msub><mo>≤</mo><mrow><mn>2</mn><mo lspace="0em" rspace="0em">​</mo><msub><mrow><mo stretchy="false">‖</mo><mrow><mi>𝐱</mi><mo>−</mo><msup><mi>𝐱</mi><mo>′</mo></msup></mrow><mo stretchy="false">‖</mo></mrow><mi mathvariant="normal">∞</mi></msub></mrow></mrow><annotation encoding="application/x-tex">\|\operatorname{softmax}(\mathbf{x})-\operatorname{softmax}(\mathbf{x}^{\prime})\|_{1}\leq 2\|\mathbf{x}-\mathbf{x}^{\prime}\|_{\infty}</annotation></semantics></math> (see Lemma <a href="#Thmconj231" title="Lemma 31 (Corollary A.7 of []). ‣ Appendix G Technical Lemmas ‣ Generalization Bounds for Transformer-Based Next-Token Prediction in a Language Model" class="ltx_ref"><span class="ltx_text ltx_ref_tag">31</span></a>), we get the assertion by</span></p>
<table id="A7.EGx194" class="ltx_equationgroup ltx_eqn_align ltx_eqn_table">

<tbody id="A7.Ex470"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_align_right ltx_eqn_cell"><math id="A7.Ex470.m1" class="ltx_Math" alttext="\displaystyle\left\|\frac{\sum_{w=1}^{W}\exp\big(\mathbf{v}_{1}^{\top}\mathbf{u}_{w}\big)\mathbf{u}_{w}}{\sum_{w=1}^{W}\exp\big(\mathbf{v}_{1}^{\top}\mathbf{u}_{w}\big)}-\frac{\sum_{w=1}^{W}\exp\big(\mathbf{v}_{2}^{\top}\mathbf{u}_{w}\big)\mathbf{u}_{w}}{\sum_{w=1}^{W}\exp\big(\mathbf{v}_{2}^{\top}\mathbf{u}_{w}\big)}\right\|_{\infty}" display="inline" intent=":literal"><semantics><msub><mrow><mo>‖</mo><mrow><mstyle displaystyle="true"><mfrac><mrow><msubsup><mo>∑</mo><mrow><mi>w</mi><mo>=</mo><mn>1</mn></mrow><mi>W</mi></msubsup><mrow><mrow><mi>exp</mi><mo>⁡</mo><mrow><mo maxsize="1.200em" minsize="1.200em">(</mo><mrow><msubsup><mi>𝐯</mi><mn>1</mn><mo>⊤</mo></msubsup><mo lspace="0em" rspace="0em">​</mo><msub><mi>𝐮</mi><mi>w</mi></msub></mrow><mo maxsize="1.200em" minsize="1.200em">)</mo></mrow></mrow><mo lspace="0em" rspace="0em">​</mo><msub><mi>𝐮</mi><mi>w</mi></msub></mrow></mrow><mrow><msubsup><mo>∑</mo><mrow><mi>w</mi><mo>=</mo><mn>1</mn></mrow><mi>W</mi></msubsup><mrow><mi>exp</mi><mo>⁡</mo><mrow><mo maxsize="1.200em" minsize="1.200em">(</mo><mrow><msubsup><mi>𝐯</mi><mn>1</mn><mo>⊤</mo></msubsup><mo lspace="0em" rspace="0em">​</mo><msub><mi>𝐮</mi><mi>w</mi></msub></mrow><mo maxsize="1.200em" minsize="1.200em">)</mo></mrow></mrow></mrow></mfrac></mstyle><mo>−</mo><mstyle displaystyle="true"><mfrac><mrow><msubsup><mo>∑</mo><mrow><mi>w</mi><mo>=</mo><mn>1</mn></mrow><mi>W</mi></msubsup><mrow><mrow><mi>exp</mi><mo>⁡</mo><mrow><mo maxsize="1.200em" minsize="1.200em">(</mo><mrow><msubsup><mi>𝐯</mi><mn>2</mn><mo>⊤</mo></msubsup><mo lspace="0em" rspace="0em">​</mo><msub><mi>𝐮</mi><mi>w</mi></msub></mrow><mo maxsize="1.200em" minsize="1.200em">)</mo></mrow></mrow><mo lspace="0em" rspace="0em">​</mo><msub><mi>𝐮</mi><mi>w</mi></msub></mrow></mrow><mrow><msubsup><mo>∑</mo><mrow><mi>w</mi><mo>=</mo><mn>1</mn></mrow><mi>W</mi></msubsup><mrow><mi>exp</mi><mo>⁡</mo><mrow><mo maxsize="1.200em" minsize="1.200em">(</mo><mrow><msubsup><mi>𝐯</mi><mn>2</mn><mo>⊤</mo></msubsup><mo lspace="0em" rspace="0em">​</mo><msub><mi>𝐮</mi><mi>w</mi></msub></mrow><mo maxsize="1.200em" minsize="1.200em">)</mo></mrow></mrow></mrow></mfrac></mstyle></mrow><mo>‖</mo></mrow><mi mathvariant="normal">∞</mi></msub><annotation encoding="application/x-tex">\displaystyle\left\|\frac{\sum_{w=1}^{W}\exp\big(\mathbf{v}_{1}^{\top}\mathbf{u}_{w}\big)\mathbf{u}_{w}}{\sum_{w=1}^{W}\exp\big(\mathbf{v}_{1}^{\top}\mathbf{u}_{w}\big)}-\frac{\sum_{w=1}^{W}\exp\big(\mathbf{v}_{2}^{\top}\mathbf{u}_{w}\big)\mathbf{u}_{w}}{\sum_{w=1}^{W}\exp\big(\mathbf{v}_{2}^{\top}\mathbf{u}_{w}\big)}\right\|_{\infty}</annotation></semantics></math></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A7.Ex470.m2" class="ltx_Math" alttext="\displaystyle\leq\|\mathbf{p}(\mathbf{v}_{1})-\mathbf{p}(\mathbf{v}_{2})\|_{1}" display="inline" intent=":literal"><semantics><mrow><mphantom></mphantom><mo>≤</mo><msub><mrow><mo stretchy="false">‖</mo><mrow><mrow><mi>𝐩</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><msub><mi>𝐯</mi><mn>1</mn></msub><mo stretchy="false">)</mo></mrow></mrow><mo>−</mo><mrow><mi>𝐩</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><msub><mi>𝐯</mi><mn>2</mn></msub><mo stretchy="false">)</mo></mrow></mrow></mrow><mo stretchy="false">‖</mo></mrow><mn>1</mn></msub></mrow><annotation encoding="application/x-tex">\displaystyle\leq\|\mathbf{p}(\mathbf{v}_{1})-\mathbf{p}(\mathbf{v}_{2})\|_{1}</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
<tbody id="A7.Ex471"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_eqn_cell"></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A7.Ex471.m1" class="ltx_Math" alttext="\displaystyle\leq 2\|\mathbf{y}(\mathbf{v}_{1})-\mathbf{y}(\mathbf{v}_{2})\|_{\infty}" display="inline" intent=":literal"><semantics><mrow><mphantom></mphantom><mo>≤</mo><mrow><mn>2</mn><mo lspace="0em" rspace="0em">​</mo><msub><mrow><mo stretchy="false">‖</mo><mrow><mrow><mi>𝐲</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><msub><mi>𝐯</mi><mn>1</mn></msub><mo stretchy="false">)</mo></mrow></mrow><mo>−</mo><mrow><mi>𝐲</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><msub><mi>𝐯</mi><mn>2</mn></msub><mo stretchy="false">)</mo></mrow></mrow></mrow><mo stretchy="false">‖</mo></mrow><mi mathvariant="normal">∞</mi></msub></mrow></mrow><annotation encoding="application/x-tex">\displaystyle\leq 2\|\mathbf{y}(\mathbf{v}_{1})-\mathbf{y}(\mathbf{v}_{2})\|_{\infty}</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
<tbody id="A7.Ex472"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_eqn_cell"></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A7.Ex472.m1" class="ltx_Math" alttext="\displaystyle=2\max_{w\in[W]}\big|(\mathbf{v}_{1}-\mathbf{v}_{2})^{\top}\mathbf{u}_{w}\big|" display="inline" intent=":literal"><semantics><mrow><mphantom></mphantom><mo>=</mo><mrow><mn>2</mn><mo lspace="0.167em" rspace="0em">​</mo><munder><mi>max</mi><mrow><mi>w</mi><mo>∈</mo><mrow><mo stretchy="false">[</mo><mi>W</mi><mo stretchy="false">]</mo></mrow></mrow></munder><mo lspace="0em" rspace="0em">​</mo><mrow><mo maxsize="1.200em" minsize="1.200em" stretchy="true">|</mo><mrow><msup><mrow><mo stretchy="false">(</mo><mrow><msub><mi>𝐯</mi><mn>1</mn></msub><mo>−</mo><msub><mi>𝐯</mi><mn>2</mn></msub></mrow><mo stretchy="false">)</mo></mrow><mo>⊤</mo></msup><mo lspace="0em" rspace="0em">​</mo><msub><mi>𝐮</mi><mi>w</mi></msub></mrow><mo maxsize="1.200em" minsize="1.200em" stretchy="true">|</mo></mrow></mrow></mrow><annotation encoding="application/x-tex">\displaystyle=2\max_{w\in[W]}\big|(\mathbf{v}_{1}-\mathbf{v}_{2})^{\top}\mathbf{u}_{w}\big|</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
<tbody id="A7.Ex473"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_eqn_cell"></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A7.Ex473.m1" class="ltx_Math" alttext="\displaystyle\leq 2\|\mathbf{v}_{1}-\mathbf{v}_{2}\|_{2}." display="inline" intent=":literal"><semantics><mrow><mrow><mphantom></mphantom><mo>≤</mo><mrow><mn>2</mn><mo lspace="0em" rspace="0em">​</mo><msub><mrow><mo stretchy="false">‖</mo><mrow><msub><mi>𝐯</mi><mn>1</mn></msub><mo>−</mo><msub><mi>𝐯</mi><mn>2</mn></msub></mrow><mo stretchy="false">‖</mo></mrow><mn>2</mn></msub></mrow></mrow><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">\displaystyle\leq 2\|\mathbf{v}_{1}-\mathbf{v}_{2}\|_{2}.</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="A7.p2.4" class="ltx_p"><span id="A7.p2.4.1" class="ltx_text">∎</span></p>
</div>
</div>
<div id="Thmconj234" class="ltx_theorem ltx_theorem_lemma">
<h6 class="ltx_title ltx_runin ltx_title_theorem"><span class="ltx_tag ltx_tag_theorem"><span id="Thmconj234.4" class="ltx_text ltx_font_bold">Lemma 34</span></span><span id="Thmconj234.5" class="ltx_text ltx_font_bold">.</span></h6>
<div id="Thmconj234.p1" class="ltx_para">
<p id="Thmconj234.p1.1" class="ltx_p"><span id="Thmconj234.p1.1.1" class="ltx_text ltx_font_italic">Let <math id="Thmconj234.p1.m1" class="ltx_Math" alttext="\mathbf{Z}" display="inline" intent=":literal"><semantics><mi>𝐙</mi><annotation encoding="application/x-tex">\mathbf{Z}</annotation></semantics></math> be uniformly distributed on <math id="Thmconj234.p1.m2" class="ltx_Math" alttext="\mathbb{S}^{m-1}" display="inline" intent=":literal"><semantics><msup><mi>𝕊</mi><mrow><mi>m</mi><mo>−</mo><mn>1</mn></mrow></msup><annotation encoding="application/x-tex">\mathbb{S}^{m-1}</annotation></semantics></math>.
Then there exists a constant <math id="Thmconj234.p1.m3" class="ltx_Math" alttext="c_{m}&gt;0" display="inline" intent=":literal"><semantics><mrow><msub><mi>c</mi><mi>m</mi></msub><mo>&gt;</mo><mn>0</mn></mrow><annotation encoding="application/x-tex">c_{m}&gt;0</annotation></semantics></math>, depending only on <math id="Thmconj234.p1.m4" class="ltx_Math" alttext="m" display="inline" intent=":literal"><semantics><mi>m</mi><annotation encoding="application/x-tex">m</annotation></semantics></math>, such that for any <math id="Thmconj234.p1.m5" class="ltx_Math" alttext="\epsilon\in[0,1]" display="inline" intent=":literal"><semantics><mrow><mi>ϵ</mi><mo>∈</mo><mrow><mo stretchy="false">[</mo><mrow><mn>0</mn><mo>,</mo><mn>1</mn></mrow><mo stretchy="false">]</mo></mrow></mrow><annotation encoding="application/x-tex">\epsilon\in[0,1]</annotation></semantics></math> and any
<math id="Thmconj234.p1.m6" class="ltx_Math" alttext="\mathbf{z}\in\mathbb{S}^{m-1}" display="inline" intent=":literal"><semantics><mrow><mi>𝐳</mi><mo>∈</mo><msup><mi>𝕊</mi><mrow><mi>m</mi><mo>−</mo><mn>1</mn></mrow></msup></mrow><annotation encoding="application/x-tex">\mathbf{z}\in\mathbb{S}^{m-1}</annotation></semantics></math>,</span></p>
<table id="A7.EGx195" class="ltx_equationgroup ltx_eqn_align ltx_eqn_table">

<tbody id="A7.Ex474"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_align_right ltx_eqn_cell"><math id="A7.Ex474.m1" class="ltx_Math" alttext="\displaystyle\mathbb{P}(\|\mathbf{Z}-\mathbf{z}\|_{2}\leq\epsilon/2)\geq c_{m}\epsilon^{m-1}." display="inline" intent=":literal"><semantics><mrow><mrow><mrow><mi>ℙ</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mrow><msub><mrow><mo stretchy="false">‖</mo><mrow><mi>𝐙</mi><mo>−</mo><mi>𝐳</mi></mrow><mo stretchy="false">‖</mo></mrow><mn>2</mn></msub><mo>≤</mo><mrow><mi>ϵ</mi><mo>/</mo><mn>2</mn></mrow></mrow><mo stretchy="false">)</mo></mrow></mrow><mo>≥</mo><mrow><msub><mi>c</mi><mi>m</mi></msub><mo lspace="0em" rspace="0em">​</mo><msup><mi>ϵ</mi><mrow><mi>m</mi><mo>−</mo><mn>1</mn></mrow></msup></mrow></mrow><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">\displaystyle\mathbb{P}(\|\mathbf{Z}-\mathbf{z}\|_{2}\leq\epsilon/2)\geq c_{m}\epsilon^{m-1}.</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
</div>
</div>
<div id="A7.4" class="ltx_proof">
<h6 class="ltx_title ltx_runin ltx_font_italic ltx_title_proof">Proof.</h6>
<div id="A7.p3" class="ltx_para">
<p id="A7.p3.1" class="ltx_p"><span id="A7.p3.1.1" class="ltx_text">By the uniformity, it is sufficient to consider <math id="A7.p3.m1" class="ltx_Math" alttext="\mathbf{z}=\mathbf{e}_{1}=(1,0,\ldots,0)^{\top}\in\mathbb{R}^{m}" display="inline" intent=":literal"><semantics><mrow><mi>𝐳</mi><mo>=</mo><msub><mi>𝐞</mi><mn>1</mn></msub><mo>=</mo><msup><mrow><mo stretchy="false">(</mo><mn>1</mn><mo>,</mo><mn>0</mn><mo>,</mo><mi mathvariant="normal">…</mi><mo>,</mo><mn>0</mn><mo stretchy="false">)</mo></mrow><mo>⊤</mo></msup><mo>∈</mo><msup><mi>ℝ</mi><mi>m</mi></msup></mrow><annotation encoding="application/x-tex">\mathbf{z}=\mathbf{e}_{1}=(1,0,\ldots,0)^{\top}\in\mathbb{R}^{m}</annotation></semantics></math>. Write <math id="A7.p3.m2" class="ltx_Math" alttext="\mathbf{Z}=(Z_{1},\ldots,Z_{m})^{\top}\eqcolon(Z_{1},\mathbf{Z}_{(-1)})^{\top}\in\mathbb{R}\times\mathbb{R}^{m-1}." display="inline" intent=":literal"><semantics><mrow><mrow><mi>𝐙</mi><mo>=</mo><msup><mrow><mo stretchy="false">(</mo><msub><mi>Z</mi><mn>1</mn></msub><mo>,</mo><mi mathvariant="normal">…</mi><mo>,</mo><msub><mi>Z</mi><mi>m</mi></msub><mo stretchy="false">)</mo></mrow><mo>⊤</mo></msup><mo>≕</mo><msup><mrow><mo stretchy="false">(</mo><msub><mi>Z</mi><mn>1</mn></msub><mo>,</mo><msub><mi>𝐙</mi><mrow><mo stretchy="false">(</mo><mrow><mo>−</mo><mn>1</mn></mrow><mo stretchy="false">)</mo></mrow></msub><mo stretchy="false">)</mo></mrow><mo>⊤</mo></msup><mo>∈</mo><mrow><mi>ℝ</mi><mo lspace="0.222em" rspace="0.222em">×</mo><msup><mi>ℝ</mi><mrow><mi>m</mi><mo>−</mo><mn>1</mn></mrow></msup></mrow></mrow><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">\mathbf{Z}=(Z_{1},\ldots,Z_{m})^{\top}\eqcolon(Z_{1},\mathbf{Z}_{(-1)})^{\top}\in\mathbb{R}\times\mathbb{R}^{m-1}.</annotation></semantics></math> On the event <math id="A7.p3.m3" class="ltx_Math" alttext="Z_{1}\geq 0" display="inline" intent=":literal"><semantics><mrow><msub><mi>Z</mi><mn>1</mn></msub><mo>≥</mo><mn>0</mn></mrow><annotation encoding="application/x-tex">Z_{1}\geq 0</annotation></semantics></math>, triangle inequality, <math id="A7.p3.m4" class="ltx_Math" alttext="\|\mathbf{Z}\|_{2}=1" display="inline" intent=":literal"><semantics><mrow><msub><mrow><mo stretchy="false">‖</mo><mi>𝐙</mi><mo stretchy="false">‖</mo></mrow><mn>2</mn></msub><mo>=</mo><mn>1</mn></mrow><annotation encoding="application/x-tex">\|\mathbf{Z}\|_{2}=1</annotation></semantics></math>, and the formula <math id="A7.p3.m5" class="ltx_Math" alttext="\sqrt{a}-\sqrt{b}=(a-b)/(\sqrt{a}+\sqrt{b})" display="inline" intent=":literal"><semantics><mrow><mrow><msqrt><mi>a</mi></msqrt><mo>−</mo><msqrt><mi>b</mi></msqrt></mrow><mo>=</mo><mrow><mrow><mo stretchy="false">(</mo><mrow><mi>a</mi><mo>−</mo><mi>b</mi></mrow><mo stretchy="false">)</mo></mrow><mo>/</mo><mrow><mo stretchy="false">(</mo><mrow><msqrt><mi>a</mi></msqrt><mo>+</mo><msqrt><mi>b</mi></msqrt></mrow><mo stretchy="false">)</mo></mrow></mrow></mrow><annotation encoding="application/x-tex">\sqrt{a}-\sqrt{b}=(a-b)/(\sqrt{a}+\sqrt{b})</annotation></semantics></math> that holds for all positive <math id="A7.p3.m6" class="ltx_Math" alttext="a,b," display="inline" intent=":literal"><semantics><mrow><mrow><mi>a</mi><mo>,</mo><mi>b</mi></mrow><mo>,</mo></mrow><annotation encoding="application/x-tex">a,b,</annotation></semantics></math> yield</span></p>
<table id="A7.Ex475" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="A7.Ex475.m1" class="ltx_Math" alttext="\|\mathbf{Z}-\mathbf{e}_{1}\|_{2}\leq|Z_{1}-1|+\|\mathbf{Z}_{(-1)}\|_{2}=\Big|1-\sqrt{1-\|\mathbf{Z}_{(-1)}\|_{2}^{2}}\Big|+\|\mathbf{Z}_{(-1)}\|_{2}\leq\|\mathbf{Z}_{(-1)}\|_{2}^{2}+\|\mathbf{Z}_{(-1)}\|_{2}." display="block" intent=":literal"><semantics><mrow><mrow><msub><mrow><mo stretchy="false">‖</mo><mrow><mi>𝐙</mi><mo>−</mo><msub><mi>𝐞</mi><mn>1</mn></msub></mrow><mo stretchy="false">‖</mo></mrow><mn>2</mn></msub><mo>≤</mo><mrow><mrow><mo stretchy="false">|</mo><mrow><msub><mi>Z</mi><mn>1</mn></msub><mo>−</mo><mn>1</mn></mrow><mo stretchy="false">|</mo></mrow><mo>+</mo><msub><mrow><mo stretchy="false">‖</mo><msub><mi>𝐙</mi><mrow><mo stretchy="false">(</mo><mrow><mo>−</mo><mn>1</mn></mrow><mo stretchy="false">)</mo></mrow></msub><mo stretchy="false">‖</mo></mrow><mn>2</mn></msub></mrow><mo>=</mo><mrow><mrow><mo maxsize="1.600em" minsize="1.600em" stretchy="true">|</mo><mrow><mn>1</mn><mo>−</mo><msqrt><mrow><mn>1</mn><mo>−</mo><msubsup><mrow><mo stretchy="false">‖</mo><msub><mi>𝐙</mi><mrow><mo stretchy="false">(</mo><mrow><mo>−</mo><mn>1</mn></mrow><mo stretchy="false">)</mo></mrow></msub><mo stretchy="false">‖</mo></mrow><mn>2</mn><mn>2</mn></msubsup></mrow></msqrt></mrow><mo maxsize="1.600em" minsize="1.600em" stretchy="true">|</mo></mrow><mo>+</mo><msub><mrow><mo stretchy="false">‖</mo><msub><mi>𝐙</mi><mrow><mo stretchy="false">(</mo><mrow><mo>−</mo><mn>1</mn></mrow><mo stretchy="false">)</mo></mrow></msub><mo stretchy="false">‖</mo></mrow><mn>2</mn></msub></mrow><mo>≤</mo><mrow><msubsup><mrow><mo stretchy="false">‖</mo><msub><mi>𝐙</mi><mrow><mo stretchy="false">(</mo><mrow><mo>−</mo><mn>1</mn></mrow><mo stretchy="false">)</mo></mrow></msub><mo stretchy="false">‖</mo></mrow><mn>2</mn><mn>2</mn></msubsup><mo>+</mo><msub><mrow><mo stretchy="false">‖</mo><msub><mi>𝐙</mi><mrow><mo stretchy="false">(</mo><mrow><mo>−</mo><mn>1</mn></mrow><mo stretchy="false">)</mo></mrow></msub><mo stretchy="false">‖</mo></mrow><mn>2</mn></msub></mrow></mrow><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">\|\mathbf{Z}-\mathbf{e}_{1}\|_{2}\leq|Z_{1}-1|+\|\mathbf{Z}_{(-1)}\|_{2}=\Big|1-\sqrt{1-\|\mathbf{Z}_{(-1)}\|_{2}^{2}}\Big|+\|\mathbf{Z}_{(-1)}\|_{2}\leq\|\mathbf{Z}_{(-1)}\|_{2}^{2}+\|\mathbf{Z}_{(-1)}\|_{2}.</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="A7.p3.2" class="ltx_p"><span id="A7.p3.2.1" class="ltx_text">Hence,</span></p>
<table id="A7.EGx196" class="ltx_equationgroup ltx_eqn_align ltx_eqn_table">

<tbody id="A7.Ex476"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_align_right ltx_eqn_cell"><math id="A7.Ex476.m1" class="ltx_Math" alttext="\displaystyle\mathbb{P}(\|\mathbf{Z}-\mathbf{z}\|_{2}\leq\epsilon/2)=\mathbb{P}(\|\mathbf{Z}-\mathbf{e}_{1}\|_{2}\leq\epsilon/2)" display="inline" intent=":literal"><semantics><mrow><mrow><mi>ℙ</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mrow><msub><mrow><mo stretchy="false">‖</mo><mrow><mi>𝐙</mi><mo>−</mo><mi>𝐳</mi></mrow><mo stretchy="false">‖</mo></mrow><mn>2</mn></msub><mo>≤</mo><mrow><mi>ϵ</mi><mo>/</mo><mn>2</mn></mrow></mrow><mo stretchy="false">)</mo></mrow></mrow><mo>=</mo><mrow><mi>ℙ</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mrow><msub><mrow><mo stretchy="false">‖</mo><mrow><mi>𝐙</mi><mo>−</mo><msub><mi>𝐞</mi><mn>1</mn></msub></mrow><mo stretchy="false">‖</mo></mrow><mn>2</mn></msub><mo>≤</mo><mrow><mi>ϵ</mi><mo>/</mo><mn>2</mn></mrow></mrow><mo stretchy="false">)</mo></mrow></mrow></mrow><annotation encoding="application/x-tex">\displaystyle\mathbb{P}(\|\mathbf{Z}-\mathbf{z}\|_{2}\leq\epsilon/2)=\mathbb{P}(\|\mathbf{Z}-\mathbf{e}_{1}\|_{2}\leq\epsilon/2)</annotation></semantics></math></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A7.Ex476.m2" class="ltx_Math" alttext="\displaystyle\geq\mathbb{P}(Z_{1}&gt;0,\,\|\mathbf{Z}_{(-1)}\|_{2}\leq\epsilon/4)" display="inline" intent=":literal"><semantics><mrow><mphantom></mphantom><mo>≥</mo><mrow><mi>ℙ</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mrow><msub><mi>Z</mi><mn>1</mn></msub><mo>&gt;</mo><mn>0</mn></mrow><mo>,</mo><mrow><msub><mrow><mo stretchy="false">‖</mo><msub><mi>𝐙</mi><mrow><mo stretchy="false">(</mo><mrow><mo>−</mo><mn>1</mn></mrow><mo stretchy="false">)</mo></mrow></msub><mo stretchy="false">‖</mo></mrow><mn>2</mn></msub><mo>≤</mo><mrow><mi>ϵ</mi><mo>/</mo><mn>4</mn></mrow></mrow><mo stretchy="false">)</mo></mrow></mrow></mrow><annotation encoding="application/x-tex">\displaystyle\geq\mathbb{P}(Z_{1}&gt;0,\,\|\mathbf{Z}_{(-1)}\|_{2}\leq\epsilon/4)</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
<tbody id="A7.Ex477"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_eqn_cell"></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A7.Ex477.m1" class="ltx_Math" alttext="\displaystyle=\frac{1}{2}\mathbb{P}(\|\mathbf{Z}_{(-1)}\|_{2}\leq\epsilon/4)=C_{m}(\epsilon/4)^{m-1}" display="inline" intent=":literal"><semantics><mrow><mphantom></mphantom><mo>=</mo><mrow><mstyle displaystyle="true"><mfrac><mn>1</mn><mn>2</mn></mfrac></mstyle><mo lspace="0em" rspace="0em">​</mo><mi>ℙ</mi><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mrow><msub><mrow><mo stretchy="false">‖</mo><msub><mi>𝐙</mi><mrow><mo stretchy="false">(</mo><mrow><mo>−</mo><mn>1</mn></mrow><mo stretchy="false">)</mo></mrow></msub><mo stretchy="false">‖</mo></mrow><mn>2</mn></msub><mo>≤</mo><mrow><mi>ϵ</mi><mo>/</mo><mn>4</mn></mrow></mrow><mo stretchy="false">)</mo></mrow></mrow><mo>=</mo><mrow><msub><mi>C</mi><mi>m</mi></msub><mo lspace="0em" rspace="0em">​</mo><msup><mrow><mo stretchy="false">(</mo><mrow><mi>ϵ</mi><mo>/</mo><mn>4</mn></mrow><mo stretchy="false">)</mo></mrow><mrow><mi>m</mi><mo>−</mo><mn>1</mn></mrow></msup></mrow></mrow><annotation encoding="application/x-tex">\displaystyle=\frac{1}{2}\mathbb{P}(\|\mathbf{Z}_{(-1)}\|_{2}\leq\epsilon/4)=C_{m}(\epsilon/4)^{m-1}</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="A7.p3.3" class="ltx_p"><span id="A7.p3.3.1" class="ltx_text">for some constant <math id="A7.p3.m7" class="ltx_Math" alttext="C_{m}&gt;0" display="inline" intent=":literal"><semantics><mrow><msub><mi>C</mi><mi>m</mi></msub><mo>&gt;</mo><mn>0</mn></mrow><annotation encoding="application/x-tex">C_{m}&gt;0</annotation></semantics></math> depending only on <math id="A7.p3.m8" class="ltx_Math" alttext="m" display="inline" intent=":literal"><semantics><mi>m</mi><annotation encoding="application/x-tex">m</annotation></semantics></math>,
where the last equality follows from the volume formula of an <math id="A7.p3.m9" class="ltx_Math" alttext="(m-1)" display="inline" intent=":literal"><semantics><mrow><mo stretchy="false">(</mo><mrow><mi>m</mi><mo>−</mo><mn>1</mn></mrow><mo stretchy="false">)</mo></mrow><annotation encoding="application/x-tex">(m-1)</annotation></semantics></math>-dimensional Euclidean ball with radius <math id="A7.p3.m10" class="ltx_Math" alttext="\epsilon/4." display="inline" intent=":literal"><semantics><mrow><mrow><mi>ϵ</mi><mo>/</mo><mn>4</mn></mrow><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">\epsilon/4.</annotation></semantics></math>
∎</span></p>
</div>
</div>
<div id="Thmconj235" class="ltx_theorem ltx_theorem_lemma">
<h6 class="ltx_title ltx_runin ltx_title_theorem"><span class="ltx_tag ltx_tag_theorem"><span id="Thmconj235.4" class="ltx_text ltx_font_bold">Lemma 35</span></span><span id="Thmconj235.5" class="ltx_text ltx_font_bold">.</span></h6>
<div id="Thmconj235.p1" class="ltx_para">
<p id="Thmconj235.p1.1" class="ltx_p"><span id="Thmconj235.p1.1.1" class="ltx_text ltx_font_italic">For any <math id="Thmconj235.p1.m1" class="ltx_Math" alttext="m=2,3,\ldots" display="inline" intent=":literal"><semantics><mrow><mrow><mi>m</mi><mo>=</mo><mn>2</mn></mrow><mo>,</mo><mn>3</mn><mo>,</mo><mi mathvariant="normal">…</mi></mrow><annotation encoding="application/x-tex">m=2,3,\ldots</annotation></semantics></math> and <math id="Thmconj235.p1.m2" class="ltx_Math" alttext="\mathbf{v}\in\mathbb{R}^{m}" display="inline" intent=":literal"><semantics><mrow><mi>𝐯</mi><mo>∈</mo><msup><mi>ℝ</mi><mi>m</mi></msup></mrow><annotation encoding="application/x-tex">\mathbf{v}\in\mathbb{R}^{m}</annotation></semantics></math>, define</span></p>
<table id="A7.Ex478" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="A7.Ex478.m1" class="ltx_Math" alttext="\mathbf{f}(\mathbf{v})\coloneqq\frac{\int_{\mathbf{z}\in\mathbb{S}^{m-1}}\exp(\mathbf{v}^{\top}\mathbf{z})\mathbf{z}\,d\mathbf{z}}{\int_{\mathbf{z}\in\mathbb{S}^{m-1}}\exp(\mathbf{v}^{\top}\mathbf{z})\,d\mathbf{z}}." display="block" intent=":literal"><semantics><mrow><mrow><mrow><mi>𝐟</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>𝐯</mi><mo stretchy="false">)</mo></mrow></mrow><mo>≔</mo><mfrac><mrow><msub><mo>∫</mo><mrow><mi>𝐳</mi><mo>∈</mo><msup><mi>𝕊</mi><mrow><mi>m</mi><mo>−</mo><mn>1</mn></mrow></msup></mrow></msub><mrow><mrow><mi>exp</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mrow><msup><mi>𝐯</mi><mo>⊤</mo></msup><mo lspace="0em" rspace="0em">​</mo><mi>𝐳</mi></mrow><mo stretchy="false">)</mo></mrow></mrow><mo lspace="0em" rspace="0em">​</mo><mi>𝐳</mi><mo lspace="0.170em" rspace="0em">​</mo><mrow><mo rspace="0em">𝑑</mo><mi>𝐳</mi></mrow></mrow></mrow><mrow><msub><mo>∫</mo><mrow><mi>𝐳</mi><mo>∈</mo><msup><mi>𝕊</mi><mrow><mi>m</mi><mo>−</mo><mn>1</mn></mrow></msup></mrow></msub><mrow><mrow><mi>exp</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mrow><msup><mi>𝐯</mi><mo>⊤</mo></msup><mo lspace="0em" rspace="0em">​</mo><mi>𝐳</mi></mrow><mo stretchy="false">)</mo></mrow></mrow><mo lspace="0.170em" rspace="0em">​</mo><mrow><mo rspace="0em">𝑑</mo><mi>𝐳</mi></mrow></mrow></mrow></mfrac></mrow><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">\mathbf{f}(\mathbf{v})\coloneqq\frac{\int_{\mathbf{z}\in\mathbb{S}^{m-1}}\exp(\mathbf{v}^{\top}\mathbf{z})\mathbf{z}\,d\mathbf{z}}{\int_{\mathbf{z}\in\mathbb{S}^{m-1}}\exp(\mathbf{v}^{\top}\mathbf{z})\,d\mathbf{z}}.</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="Thmconj235.p1.2" class="ltx_p"><span id="Thmconj235.p1.2.1" class="ltx_text ltx_font_italic">Then,</span></p>
<table id="A7.Ex479" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="A7.Ex479.m1" class="ltx_Math" alttext="\frac{\mathbf{f}(\mathbf{v})}{\|\mathbf{f}(\mathbf{v})\|_{2}}=\frac{\mathbf{v}}{\|\mathbf{v}\|_{2}}\quad\text{ and }\quad\|\mathbf{f}(\mathbf{v})\|_{2}&gt;\frac{1}{1+m/\|\mathbf{v}\|_{2}}" display="block" intent=":literal"><semantics><mrow><mrow><mfrac><mrow><mi>𝐟</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>𝐯</mi><mo stretchy="false">)</mo></mrow></mrow><msub><mrow><mo stretchy="false">‖</mo><mrow><mi>𝐟</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>𝐯</mi><mo stretchy="false">)</mo></mrow></mrow><mo stretchy="false">‖</mo></mrow><mn>2</mn></msub></mfrac><mo>=</mo><mfrac><mi>𝐯</mi><msub><mrow><mo stretchy="false">‖</mo><mi>𝐯</mi><mo stretchy="false">‖</mo></mrow><mn>2</mn></msub></mfrac></mrow><mspace style="width:1em;" width="1em"></mspace><mtext class="ltx_mathvariant_italic"> and </mtext><mspace style="width:1em;" width="1em"></mspace><mrow><msub><mrow><mo stretchy="false">‖</mo><mrow><mi>𝐟</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>𝐯</mi><mo stretchy="false">)</mo></mrow></mrow><mo stretchy="false">‖</mo></mrow><mn>2</mn></msub><mo>&gt;</mo><mfrac><mn>1</mn><mrow><mn>1</mn><mo>+</mo><mrow><mi>m</mi><mo>/</mo><msub><mrow><mo stretchy="false">‖</mo><mi>𝐯</mi><mo stretchy="false">‖</mo></mrow><mn>2</mn></msub></mrow></mrow></mfrac></mrow></mrow><annotation encoding="application/x-tex">\frac{\mathbf{f}(\mathbf{v})}{\|\mathbf{f}(\mathbf{v})\|_{2}}=\frac{\mathbf{v}}{\|\mathbf{v}\|_{2}}\quad\text{ and }\quad\|\mathbf{f}(\mathbf{v})\|_{2}&gt;\frac{1}{1+m/\|\mathbf{v}\|_{2}}</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
</div>
</div>
<div id="A7.5" class="ltx_proof">
<h6 class="ltx_title ltx_runin ltx_font_italic ltx_title_proof">Proof.</h6>
<div id="A7.p4" class="ltx_para">
<p id="A7.p4.1" class="ltx_p"><span id="A7.p4.1.1" class="ltx_text">We denote by <math id="A7.p4.m1" class="ltx_Math" alttext="\operatorname{vMF}_{\mathbf{v}}" display="inline" intent=":literal"><semantics><msub><mi>vMF</mi><mi>𝐯</mi></msub><annotation encoding="application/x-tex">\operatorname{vMF}_{\mathbf{v}}</annotation></semantics></math> the von Mises–Fisher
distribution on <math id="A7.p4.m2" class="ltx_Math" alttext="\mathbb{S}^{m-1}" display="inline" intent=":literal"><semantics><msup><mi>𝕊</mi><mrow><mi>m</mi><mo>−</mo><mn>1</mn></mrow></msup><annotation encoding="application/x-tex">\mathbb{S}^{m-1}</annotation></semantics></math> with mean direction <math id="A7.p4.m3" class="ltx_Math" alttext="\mathbf{v}/\|\mathbf{v}\|_{2}" display="inline" intent=":literal"><semantics><mrow><mi>𝐯</mi><mo>/</mo><msub><mrow><mo stretchy="false">‖</mo><mi>𝐯</mi><mo stretchy="false">‖</mo></mrow><mn>2</mn></msub></mrow><annotation encoding="application/x-tex">\mathbf{v}/\|\mathbf{v}\|_{2}</annotation></semantics></math> and concentration parameter
<math id="A7.p4.m4" class="ltx_Math" alttext="\|\mathbf{v}\|_{2}" display="inline" intent=":literal"><semantics><msub><mrow><mo stretchy="false">‖</mo><mi>𝐯</mi><mo stretchy="false">‖</mo></mrow><mn>2</mn></msub><annotation encoding="application/x-tex">\|\mathbf{v}\|_{2}</annotation></semantics></math>, whose probability density function is given by</span></p>
<table id="A7.Ex480" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="A7.Ex480.m1" class="ltx_Math" alttext="\mathbf{z}\mapsto c_{\mathbf{v}}\exp(\mathbf{v}^{\top}\mathbf{z}),\quad\mathbf{z}\in\mathbb{S}^{m-1}," display="block" intent=":literal"><semantics><mrow><mrow><mrow><mi>𝐳</mi><mo stretchy="false">↦</mo><mrow><msub><mi>c</mi><mi>𝐯</mi></msub><mo lspace="0.167em" rspace="0em">​</mo><mrow><mi>exp</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mrow><msup><mi>𝐯</mi><mo>⊤</mo></msup><mo lspace="0em" rspace="0em">​</mo><mi>𝐳</mi></mrow><mo stretchy="false">)</mo></mrow></mrow></mrow></mrow><mo rspace="1.167em">,</mo><mrow><mi>𝐳</mi><mo>∈</mo><msup><mi>𝕊</mi><mrow><mi>m</mi><mo>−</mo><mn>1</mn></mrow></msup></mrow></mrow><mo>,</mo></mrow><annotation encoding="application/x-tex">\mathbf{z}\mapsto c_{\mathbf{v}}\exp(\mathbf{v}^{\top}\mathbf{z}),\quad\mathbf{z}\in\mathbb{S}^{m-1},</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="A7.p4.2" class="ltx_p"><span id="A7.p4.2.1" class="ltx_text">with <math id="A7.p4.m5" class="ltx_Math" alttext="c_{\mathbf{v}}" display="inline" intent=":literal"><semantics><msub><mi>c</mi><mi>𝐯</mi></msub><annotation encoding="application/x-tex">c_{\mathbf{v}}</annotation></semantics></math> the normalizing constant. The expectation is given by</span></p>
<table id="A7.EGx197" class="ltx_equationgroup ltx_eqn_align ltx_eqn_table">

<tbody id="A7.Ex481"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_align_right ltx_eqn_cell"><math id="A7.Ex481.m1" class="ltx_Math" alttext="\displaystyle\mathbb{E}_{\mathbf{Z}\sim\operatorname{vMF}(\mathbf{v})}[\mathbf{Z}]=\mathbf{f}(\mathbf{v})=\frac{I_{m/2}(\|\mathbf{v}\|_{2})}{I_{m/2-1}(\|\mathbf{v}\|_{2})}\frac{\mathbf{v}}{\|\mathbf{v}\|_{2}}," display="inline" intent=":literal"><semantics><mrow><mrow><mrow><msub><mi>𝔼</mi><mrow><mi>𝐙</mi><mo>∼</mo><mrow><mi>vMF</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>𝐯</mi><mo stretchy="false">)</mo></mrow></mrow></mrow></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">[</mo><mi>𝐙</mi><mo stretchy="false">]</mo></mrow></mrow><mo>=</mo><mrow><mi>𝐟</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>𝐯</mi><mo stretchy="false">)</mo></mrow></mrow><mo>=</mo><mrow><mstyle displaystyle="true"><mfrac><mrow><msub><mi>I</mi><mrow><mi>m</mi><mo>/</mo><mn>2</mn></mrow></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mrow><mo stretchy="false">‖</mo><mi>𝐯</mi><mo stretchy="false">‖</mo></mrow><mn>2</mn></msub><mo stretchy="false">)</mo></mrow></mrow><mrow><msub><mi>I</mi><mrow><mrow><mi>m</mi><mo>/</mo><mn>2</mn></mrow><mo>−</mo><mn>1</mn></mrow></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mrow><mo stretchy="false">‖</mo><mi>𝐯</mi><mo stretchy="false">‖</mo></mrow><mn>2</mn></msub><mo stretchy="false">)</mo></mrow></mrow></mfrac></mstyle><mo lspace="0em" rspace="0em">​</mo><mstyle displaystyle="true"><mfrac><mi>𝐯</mi><msub><mrow><mo stretchy="false">‖</mo><mi>𝐯</mi><mo stretchy="false">‖</mo></mrow><mn>2</mn></msub></mfrac></mstyle></mrow></mrow><mo>,</mo></mrow><annotation encoding="application/x-tex">\displaystyle\mathbb{E}_{\mathbf{Z}\sim\operatorname{vMF}(\mathbf{v})}[\mathbf{Z}]=\mathbf{f}(\mathbf{v})=\frac{I_{m/2}(\|\mathbf{v}\|_{2})}{I_{m/2-1}(\|\mathbf{v}\|_{2})}\frac{\mathbf{v}}{\|\mathbf{v}\|_{2}},</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="A7.p4.3" class="ltx_p"><span id="A7.p4.3.1" class="ltx_text">with <math id="A7.p4.m6" class="ltx_Math" alttext="I_{v}" display="inline" intent=":literal"><semantics><msub><mi>I</mi><mi>v</mi></msub><annotation encoding="application/x-tex">I_{v}</annotation></semantics></math> the modified Bessel function of the first kind (see e.g. <cite class="ltx_cite ltx_citemacro_cite">[<a href="#bib.bib47" title="" class="ltx_ref">51</a>]</cite>, Equation (9.3.8)). This establishes the first assertion.</span></p>
</div>
<div id="A7.p5" class="ltx_para">
<p id="A7.p5.1" class="ltx_p"><span id="A7.p5.1.1" class="ltx_text">Moreover, classical Amos-type bounds for Bessel function ratios (e.g., see Theorem 3 of <cite class="ltx_cite ltx_citemacro_cite">[<a href="#bib.bib39" title="" class="ltx_ref">27</a>]</cite>) yield that</span></p>
<table id="A7.EGx198" class="ltx_equationgroup ltx_eqn_align ltx_eqn_table">

<tbody id="A7.Ex482"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_align_right ltx_eqn_cell"><math id="A7.Ex482.m1" class="ltx_Math" alttext="\displaystyle\frac{I_{m/2}(\|\mathbf{v}\|_{2})}{I_{m/2-1}(\|\mathbf{v}\|_{2})}\geq\frac{\|\mathbf{v}\|_{2}}{\frac{m-1}{2}+\sqrt{(\frac{m+1}{2})^{2}+\|\mathbf{v}\|_{2}^{2}}}." display="inline" intent=":literal"><semantics><mrow><mrow><mstyle displaystyle="true"><mfrac><mrow><msub><mi>I</mi><mrow><mi>m</mi><mo>/</mo><mn>2</mn></mrow></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mrow><mo stretchy="false">‖</mo><mi>𝐯</mi><mo stretchy="false">‖</mo></mrow><mn>2</mn></msub><mo stretchy="false">)</mo></mrow></mrow><mrow><msub><mi>I</mi><mrow><mrow><mi>m</mi><mo>/</mo><mn>2</mn></mrow><mo>−</mo><mn>1</mn></mrow></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mrow><mo stretchy="false">‖</mo><mi>𝐯</mi><mo stretchy="false">‖</mo></mrow><mn>2</mn></msub><mo stretchy="false">)</mo></mrow></mrow></mfrac></mstyle><mo>≥</mo><mstyle displaystyle="true"><mfrac><msub><mrow><mo stretchy="false">‖</mo><mi>𝐯</mi><mo stretchy="false">‖</mo></mrow><mn>2</mn></msub><mrow><mfrac><mrow><mi>m</mi><mo>−</mo><mn>1</mn></mrow><mn>2</mn></mfrac><mo>+</mo><msqrt><mrow><msup><mrow><mo stretchy="false">(</mo><mfrac><mrow><mi>m</mi><mo>+</mo><mn>1</mn></mrow><mn>2</mn></mfrac><mo stretchy="false">)</mo></mrow><mn>2</mn></msup><mo>+</mo><msubsup><mrow><mo stretchy="false">‖</mo><mi>𝐯</mi><mo stretchy="false">‖</mo></mrow><mn>2</mn><mn>2</mn></msubsup></mrow></msqrt></mrow></mfrac></mstyle></mrow><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">\displaystyle\frac{I_{m/2}(\|\mathbf{v}\|_{2})}{I_{m/2-1}(\|\mathbf{v}\|_{2})}\geq\frac{\|\mathbf{v}\|_{2}}{\frac{m-1}{2}+\sqrt{(\frac{m+1}{2})^{2}+\|\mathbf{v}\|_{2}^{2}}}.</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="A7.p5.2" class="ltx_p"><span id="A7.p5.2.1" class="ltx_text">We obtain the second assertion by using that <math id="A7.p5.m1" class="ltx_Math" alttext="\sqrt{a^{2}+b^{2}}&lt;a+b" display="inline" intent=":literal"><semantics><mrow><msqrt><mrow><msup><mi>a</mi><mn>2</mn></msup><mo>+</mo><msup><mi>b</mi><mn>2</mn></msup></mrow></msqrt><mo>&lt;</mo><mrow><mi>a</mi><mo>+</mo><mi>b</mi></mrow></mrow><annotation encoding="application/x-tex">\sqrt{a^{2}+b^{2}}&lt;a+b</annotation></semantics></math> for positive <math id="A7.p5.m2" class="ltx_Math" alttext="a,b," display="inline" intent=":literal"><semantics><mrow><mrow><mi>a</mi><mo>,</mo><mi>b</mi></mrow><mo>,</mo></mrow><annotation encoding="application/x-tex">a,b,</annotation></semantics></math> and therefore</span></p>
<table id="A7.EGx199" class="ltx_equationgroup ltx_eqn_align ltx_eqn_table">

<tbody id="A7.Ex483"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_align_right ltx_eqn_cell"><math id="A7.Ex483.m1" class="ltx_Math" alttext="\displaystyle\frac{\|\mathbf{v}\|_{2}}{\frac{m-1}{2}+\sqrt{(\frac{m+1}{2})^{2}+\|\mathbf{v}\|_{2}^{2}}}&gt;\frac{\|\mathbf{v}\|_{2}}{\frac{m-1}{2}+\frac{m+1}{2}+\|\mathbf{v}\|_{2}}=\frac{1}{1+m/\|\mathbf{v}\|_{2}}." display="inline" intent=":literal"><semantics><mrow><mrow><mstyle displaystyle="true"><mfrac><msub><mrow><mo stretchy="false">‖</mo><mi>𝐯</mi><mo stretchy="false">‖</mo></mrow><mn>2</mn></msub><mrow><mfrac><mrow><mi>m</mi><mo>−</mo><mn>1</mn></mrow><mn>2</mn></mfrac><mo>+</mo><msqrt><mrow><msup><mrow><mo stretchy="false">(</mo><mfrac><mrow><mi>m</mi><mo>+</mo><mn>1</mn></mrow><mn>2</mn></mfrac><mo stretchy="false">)</mo></mrow><mn>2</mn></msup><mo>+</mo><msubsup><mrow><mo stretchy="false">‖</mo><mi>𝐯</mi><mo stretchy="false">‖</mo></mrow><mn>2</mn><mn>2</mn></msubsup></mrow></msqrt></mrow></mfrac></mstyle><mo>&gt;</mo><mstyle displaystyle="true"><mfrac><msub><mrow><mo stretchy="false">‖</mo><mi>𝐯</mi><mo stretchy="false">‖</mo></mrow><mn>2</mn></msub><mrow><mfrac><mrow><mi>m</mi><mo>−</mo><mn>1</mn></mrow><mn>2</mn></mfrac><mo>+</mo><mfrac><mrow><mi>m</mi><mo>+</mo><mn>1</mn></mrow><mn>2</mn></mfrac><mo>+</mo><msub><mrow><mo stretchy="false">‖</mo><mi>𝐯</mi><mo stretchy="false">‖</mo></mrow><mn>2</mn></msub></mrow></mfrac></mstyle><mo>=</mo><mstyle displaystyle="true"><mfrac><mn>1</mn><mrow><mn>1</mn><mo>+</mo><mrow><mi>m</mi><mo>/</mo><msub><mrow><mo stretchy="false">‖</mo><mi>𝐯</mi><mo stretchy="false">‖</mo></mrow><mn>2</mn></msub></mrow></mrow></mfrac></mstyle></mrow><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">\displaystyle\frac{\|\mathbf{v}\|_{2}}{\frac{m-1}{2}+\sqrt{(\frac{m+1}{2})^{2}+\|\mathbf{v}\|_{2}^{2}}}&gt;\frac{\|\mathbf{v}\|_{2}}{\frac{m-1}{2}+\frac{m+1}{2}+\|\mathbf{v}\|_{2}}=\frac{1}{1+m/\|\mathbf{v}\|_{2}}.</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="A7.p5.3" class="ltx_p"><span id="A7.p5.3.1" class="ltx_text">∎</span></p>
</div>
