<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="S5.Ex62.m1" class="ltx_math_unparsed" alttext="\displaystyle=\mathbb{E}\left[\frac{\sum_{w=1}^{W}\exp\big(\mathbf{g}_{0}(\mathbf{Z}_{1,T+1})^{\top}\bm{\phi}_{1}(\mathbf{e}_{w})+\mathbf{h}(\mathbf{z})^{\top}\bm{\phi}_{2}(\mathbf{e}_{w})\big)\frac{\bm{\phi}_{2}(\mathbf{e}_{w})}{\exp\big(\mathbf{g}_{0}(\mathbf{Z}_{1,T+1})^{\top}\bm{\phi}_{1}(\mathbf{e}_{w})\big)}}{\sum_{w=1}^{W}\exp\big(\mathbf{g}_{0}(\mathbf{Z}_{1,T+1})^{\top}\bm{\phi}_{1}(\mathbf{e}_{w})+\mathbf{h}(\mathbf{z})^{\top}\bm{\phi}_{2}(\mathbf{e}_{w})\big)}\middle|\mathbf{h},\mathbf{Z}_{2,T+1}=\mathbf{z}\right]" display="inline" intent=":literal"><semantics><mrow><mo>=</mo><mi>𝔼</mi><mrow><mo>[</mo><mstyle displaystyle="true"><mfrac><mrow><msubsup><mo>∑</mo><mrow><mi>w</mi><mo>=</mo><mn>1</mn></mrow><mi>W</mi></msubsup><mrow><mrow><mi>exp</mi><mo>⁡</mo><mrow><mo maxsize="1.200em" minsize="1.200em">(</mo><mrow><mrow><msub><mi>𝐠</mi><mn>0</mn></msub><mo lspace="0em" rspace="0em">​</mo><msup><mrow><mo stretchy="false">(</mo><msub><mi>𝐙</mi><mrow><mn>1</mn><mo>,</mo><mrow><mi>T</mi><mo>+</mo><mn>1</mn></mrow></mrow></msub><mo stretchy="false">)</mo></mrow><mo>⊤</mo></msup><mo lspace="0em" rspace="0em">​</mo><msub><mi class="ltx_mathvariant_bold-italic" mathvariant="bold-italic">ϕ</mi><mn>1</mn></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mi>𝐞</mi><mi>w</mi></msub><mo stretchy="false">)</mo></mrow></mrow><mo>+</mo><mrow><mi>𝐡</mi><mo lspace="0em" rspace="0em">​</mo><msup><mrow><mo stretchy="false">(</mo><mi>𝐳</mi><mo stretchy="false">)</mo></mrow><mo>⊤</mo></msup><mo lspace="0em" rspace="0em">​</mo><msub><mi class="ltx_mathvariant_bold-italic" mathvariant="bold-italic">ϕ</mi><mn>2</mn></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mi>𝐞</mi><mi>w</mi></msub><mo stretchy="false">)</mo></mrow></mrow></mrow><mo maxsize="1.200em" minsize="1.200em">)</mo></mrow></mrow><mo lspace="0em" rsp