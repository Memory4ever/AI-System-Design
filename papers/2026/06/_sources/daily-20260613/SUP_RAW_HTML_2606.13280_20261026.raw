\mathbf{h}(\mathbf{Z}_{2,T+1})\\
\bm{0}_{N-m_{1}-m_{2}}\\
\end{matrix}\right)\right)\right\|_{2}^{2}\mathbb{I}\big(\|\widehat{\mathbf{m}}_{\lambda}(\mathbf{Z}_{2,T+1})\|_{2}\geq c\big)\,\,\middle|\,\,\mathbf{h}\right]" display="inline" intent=":literal"><semantics><mrow><mo>≤</mo><mrow><mo stretchy="false">(</mo><msub><mi>m</mi><mn>2</mn></msub><mo>+</mo><mn>1</mn><mo stretchy="false">)</mo></mrow><mi>𝔼</mi><mrow><mo>[</mo><msubsup><mrow><mo>‖</mo><mrow><mo>(</mo><msub><mrow><mo maxsize="1.600em" minsize="1.600em">(</mo><msub><mi>𝝂</mi><mn>2</mn></msub><mo lspace="0.222em" rspace="0.222em">∘</mo><msub><mi>𝝁</mi><mn>2</mn></msub><mo lspace="0.222em" rspace="0.222em">∘</mo><msub><mi>𝝂</mi><mn>1</mn></msub><mo lspace="0.222em" rspace="0.222em">∘</mo><msub><mi>𝝁</mi><mn>1</mn></msub><mrow><mo stretchy="false">(</mo><mi>P</mi><mo>+</mo><mi>E</mi><mi>X</mi><mo stretchy="false">)</mo></mrow><mo maxsize="1.600em" minsize="1.600em">)</mo></mrow><mrow><mo rspace="0em">:</mo><mo>,</mo><mi>T</mi></mrow></msub><mo>−</mo><mrow><mo>(</mo><mtable rowspacing="0pt"><mtr><mtd><mrow><msub><mi>𝐠</mi><mn>0</mn></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mi>𝐙</mi><mrow><mn>1</mn><mo>,</mo><mrow><mi>T</mi><mo>+</mo><mn>1</mn></mrow></mrow></msub><mo stretchy="false">)</mo></mrow></mrow></mtd></mtr><mtr><mtd><mrow><mi>𝐡</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><msub><mi>𝐙</mi><mrow><mn>2</mn><mo>,</mo><mrow><mi>T</mi><mo>+</mo><mn>1</mn></mrow></mrow></msub><mo stretchy="false">)</mo></mrow></mrow></mtd></mtr><mtr><mtd><msub><mn>𝟎</mn><mrow><mi>N</mi><mo>−</mo><msub><mi>m</mi><mn>1</mn></msub><mo>−</mo><msub><mi>m</mi><mn>2</mn></msub></mrow></msub></mtd></mtr></mtable><mo>)</mo></mrow><mo>)</mo></mrow><mo>‖</mo></mrow><mn>2</mn><mn>2</mn></msubsup><mi>𝕀</mi><mrow><mo maxsize="1.200em" minsize="1.200em">(</mo><mo lspace="0em" rspace="0.167em">∥</mo><msub><mover accent="true"><mi>𝐦</mi><mo>^</mo></mover><mi>λ</mi></msub><mrow><mo stretchy="false">(</mo><msub><mi>𝐙</mi><mrow><mn>2</mn><mo>,</mo><mrow><mi>T</mi><mo>+</mo><mn>1</mn></mrow></mrow></msub><mo stretchy="false">)</mo></mrow><msub><mo lspace="0em" rspace="0.0835em">∥</mo><mn>2</mn></msub><mo lspace="0.0835em">≥</mo><mi>c</mi><mo maxsize="1.200em" minsize="1.200em" rspace="0.062em">)</mo></mrow><mo rspace="0.340em" stretchy="true">|</mo><mi>𝐡</mi><mo>]</mo></mrow></mrow><annotation encoding="application/x-tex">\displaystyle\leq(m_{2}+1)\mathbb{E}\left[\left\|\left(\Big(\bm{\nu}_{2}\circ\bm{\mu}_{2}\circ\bm{\nu}_{1}\circ\bm{\mu}_{1}(P+EX)\Big)_{:,T}-\left(\begin{matrix}\mathbf{g}_{0}(\mathbf{Z}_{1,T+1})\\
\mathbf{h}(\mathbf{Z}_{2,T+1})\\
\bm{0}_{N-m_{1}-m_{2}}\\
\end{matrix}\right)\right)\right\|_{2}^{2}\mathbb{I}\big(\|\widehat{\mathbf{m}}_{\lambda}(\mathbf{Z}_{2,T+1})\|_{2}\geq c\big)\,\,\middle|\,\,\mathbf{h}\right]</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
<tbody id="A4.Ex168"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_eqn_cell"></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A4.Ex168.m1" class="ltx_Math" alttext="\displaystyle\quad+M^{2}\mathbb{P}\big(\|\widehat{\mathbf{m}}_{\lambda}(\mathbf{Z}_{2,T+1})\|_{2}&lt;c\,\big|\,\mathbf{h}\big)" display="inline" intent=":literal"><semantics><mrow><mo>+</mo><mrow><msup><mi>M</mi><mn>2</mn></msup><mo lspace="0em" rspace="0em">​</mo><mi>ℙ</mi><mo lspace="0em" rspace="0em">​</mo><mrow><mo maxsize="1.200em" minsize="1.200em">(</mo><mrow><msub><mrow><mo stretchy="false">‖</mo><mrow><msub><mover accent="true"><mi>𝐦</mi><mo>^</mo></mover><mi>λ</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mi>𝐙</mi><mrow><mn>2</mn><mo>,</mo><mrow><mi>T</mi><mo>+</mo><mn>1</mn></mrow></mrow></msub><mo stretchy="false">)</mo></mrow></mrow><mo stretchy="false">‖</mo></mrow><mn>2</mn></msub><mo>&lt;</mo><mi>c</mi></mrow><mo lspace="0.170em" mathsize="1.200em" rspace="0.170em">|</mo><mi>𝐡</mi><mo maxsize="1.200em" minsize="1.200em">)</mo></mrow></mrow></mrow><annotation encoding="application/x-tex">\displaystyle\quad+M^{2}\mathbb{P}\big(\|\widehat{\mathbf{m}}_{\lambda}(\mathbf{Z}_{2,T+1})\|_{2}&lt;c\,\big|\,\mathbf{h}\big)</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
<tbody id="A4.Ex169"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_eqn_cell"></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A4.Ex169.m1" class="ltx_Math" alttext="\displaystyle=\tilde{O}\Big((N_{\mathrm{mlp}})^{-\frac{2\beta_{1}}{m_{1}r_{1}}}+\lambda^{2\beta_{2}}+\frac{M^{2}}{T\varphi_{W}(\lambda)^{r_{2}}}+\kappa_{W}^{2}\Big)." display="inline" intent=":literal"><semantics><mrow><mrow><mphantom></mphantom><mo>=</mo><mrow><mover accent="true"><mi>O</mi><mo>~</mo></mover><mo lspace="0em" rspace="0em">​</mo><mrow><mo maxsize="1.600em" minsize="1.600em">(</mo><mrow><msup><mrow><mo stretchy="false">(</mo><msub><mi>N</mi><mi>mlp</mi></msub><mo stretchy="false">)</mo></mrow><mrow><mo>−</mo><mfrac><mrow><mn>2</mn><mo lspace="0em" rspace="0em">​</mo><msub><mi>β</mi><mn>1</mn></msub></mrow><mrow><msub><mi>m</mi><mn>1</mn></msub><mo lspace="0em" rspace="0em">​</mo><msub><mi>r</mi><mn>1</mn></msub></mrow></mfrac></mrow></msup><mo>+</mo><msup><mi>λ</mi><mrow><mn>2</mn><mo lspace="0em" rspace="0em">​</mo><msub><mi>β</mi><mn>2</mn></msub></mrow></msup><mo>+</mo><mstyle displaystyle="true"><mfrac><msup><mi>M</mi><mn>2</mn></msup><mrow><mi>T</mi><mo lspace="0em" rspace="0em">​</mo><msub><mi>φ</mi><mi>W</mi></msub><mo lspace="0em" rspace="0em">​</mo><msup><mrow><mo stretchy="false">(</mo><mi>λ</mi><mo stretchy="false">)</mo></mrow><msub><mi>r</mi><mn>2</mn></msub></msup></mrow></mfrac></mstyle><mo>+</mo><msubsup><mi>κ</mi><mi>W</mi><mn>2</mn></msubsup></mrow><mo maxsize="1.600em" minsize="1.600em">)</mo></mrow></mrow></mrow><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">\displaystyle=\tilde{O}\Big((N_{\mathrm{mlp}})^{-\frac{2\beta_{1}}{m_{1}r_{1}}}+\lambda^{2\beta_{2}}+\frac{M^{2}}{T\varphi_{W}(\lambda)^{r_{2}}}+\kappa_{W}^{2}\Big).</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="A4.p3.9" class="ltx_p"><span id="A4.p3.9.1" class="ltx_text">∎</span></p>
</div>
</div>
</section>
<section id="A5" class="ltx_appendix">
<h2 class="ltx_title ltx_title_appendix"><span class="ltx_tag ltx_tag_appendix">Appendix E </span>Construction of the Transformer</h2>

<div id="A5.p1" class="ltx_para">
<p id="A5.p1.1" class="ltx_p">In this section, we construct <math id="A5.p1.m1" class="ltx_Math" alttext="\bm{\mu}_{1},\bm{\mu}_{2}\in\mathcal{MA}(N,H,B)" display="inline" intent=":literal"><semantics><mrow><msub><mi>𝝁</mi><mn>1</mn></msub><mo>,</mo><mrow><msub><mi>𝝁</mi><mn>2</mn></msub><mo>∈</mo><mrow><mi class="ltx_font_mathcaligraphic">ℳ</mi><mo lspace="0em" rspace="0em">​</mo><mi class="ltx_font_mathcaligraphic">𝒜</mi><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>N</mi><mo>,</mo><mi>H</mi><mo>,</mo><mi>B</mi><mo stretchy="false">)</mo></mrow></mrow></mrow></mrow><annotation encoding="application/x-tex">\bm{\mu}_{1},\bm{\mu}_{2}\in\mathcal{MA}(N,H,B)</annotation></semantics></math> and <math id="A5.p1.m2" class="ltx_Math" alttext="\bm{\nu}_{1},\bm{\nu}_{2}\in\mathcal{MLP}(N,L_{\mathrm{mlp}},N_{\mathrm{mlp}},B)" display="inline" intent=":literal"><semantics><mrow><msub><mi>𝝂</mi><mn>1</mn></msub><mo>,</mo><mrow><msub><mi>𝝂</mi><mn>2</mn></msub><mo>∈</mo><mrow><mi class="ltx_font_mathcaligraphic">ℳ</mi><mo lspace="0em" rspace="0em">​</mo><mi class="ltx_font_mathcaligraphic">ℒ</mi><mo lspace="0em" rspace="0em">​</mo><mi class="ltx_font_mathcaligraphic">𝒫</mi><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>N</mi><mo>,</mo><msub><mi>L</mi><mi>mlp</mi></msub><mo>,</mo><msub><mi>N</mi><mi>mlp</mi></msub><mo>,</mo><mi>B</mi><mo stretchy="false">)</mo></mrow></mrow></mrow></mrow><annotation encoding="application/x-tex">\bm{\nu}_{1},\bm{\nu}_{2}\in\mathcal{MLP}(N,L_{\mathrm{mlp}},N_{\mathrm{mlp}},B)</annotation></semantics></math>, which are used in the proof of Theorem <a href="#Thmconj24" title="Theorem 4. ‣ 4.1 Proof of the risk bound ‣ 4 Risk bound ‣ Generalization Bounds for Transformer-Based Next-Token Prediction in a Language Model" class="ltx_ref"><span class="ltx_text ltx_ref_tag">4</span></a>.
We construct multi-head self-attention layers in Appendix <a href="#A5.SS1" title="E.1 Construction of multi-head self-attention layers ‣ Appendix E Construction of the Transformer ‣ Generalization Bounds for Transformer-Based Next-Token Prediction in a Language Model" class="ltx_ref"><span class="ltx_text ltx_ref_tag">E.1</span></a>, and multilayer perceptron layers in Appendix <a href="#A5.SS2" title="E.2 Construction of multilayer perceptron layers ‣ Appendix E Construction of the Transformer ‣ Generalization Bounds for Transformer-Based Next-Token Prediction in a Language Model" class="ltx_ref"><span class="ltx_text ltx_ref_tag">E.2</span></a>.
Using these results, we provide a formal proof of Lemma <a href="#Thmconj25" title="Lemma 5. ‣ 5 Proof Sketch of the Upper Bound for the Approximation Error ‣ Generalization Bounds for Transformer-Based Next-Token Prediction in a Language Model" class="ltx_ref"><span class="ltx_text ltx_ref_tag">5</span></a> in Appendix <a href="#A5.SS3" title="E.3 Proof of Lemma ‣ Appendix E Construction of the Transformer ‣ Generalization Bounds for Transformer-Based Next-Token Prediction in a Language Model" class="ltx_ref"><span class="ltx_text ltx_ref_tag">E.3</span></a>.
Unless otherwise specified, the implicit constants in the notation <math id="A5.p1.m3" class="ltx_Math" alttext="\lesssim" display="inline" intent=":literal"><semantics><mo>≲</mo><annotation encoding="application/x-tex">\lesssim</annotation></semantics></math> depend only on <math id="A5.p1.m4" class="ltx_Math" alttext="(m_{1},m_{2},r_{1},r_{2},\delta_{1},\delta_{2},\beta_{1},\|\mathbf{g}_{0}\|_{\mathcal{C}^{\beta_{1}}})" display="inline" intent=":literal"><semantics><mrow><mo stretchy="false">(</mo><msub><mi>m</mi><mn>1</mn></msub><mo>,</mo><msub><mi>m</mi><mn>2</mn></msub><mo>,</mo><msub><mi>r</mi><mn>1</mn></msub><mo>,</mo><msub><mi>r</mi><mn>2</mn></msub><mo>,</mo><msub><mi>δ</mi><mn>1</mn></msub><mo>,</mo><msub><mi>δ</mi><mn>2</mn></msub><mo>,</mo><msub><mi>β</mi><mn>1</mn></msub><mo>,</mo><msub><mrow><mo stretchy="false">‖</mo><msub><mi>𝐠</mi><mn>0</mn></msub><mo stretchy="false">‖</mo></mrow><msup><mi class="ltx_font_mathcaligraphic">𝒞</mi><msub><mi>β</mi><mn>1</mn></msub></msup></msub><mo stretchy="false">)</mo></mrow><annotation encoding="application/x-tex">(m_{1},m_{2},r_{1},r_{2},\delta_{1},\delta_{2},\beta_{1},\|\mathbf{g}_{0}\|_{\mathcal{C}^{\beta_{1}}})</annotation></semantics></math>.</p>
</div>
<section id="A5.SS1" class="ltx_subsection">
<h3 class="ltx_title ltx_title_subsection"><span class="ltx_tag ltx_tag_subsection">E.1 </span>Construction of multi-head self-attention layers</h3>

<div id="A5.SS1.p1" class="ltx_para">
<p id="A5.SS1.p1.1" class="ltx_p">Recall that for <math id="A5.SS1.p1.m1" class="ltx_Math" alttext="A\coloneqq N/4" display="inline" intent=":literal"><semantics><mrow><mi>A</mi><mo>≔</mo><mrow><mi>N</mi><mo>/</mo><mn>4</mn></mrow></mrow><annotation encoding="application/x-tex">A\coloneqq N/4</annotation></semantics></math>, the positional encoding matrix <math id="A5.SS1.p1.m2" class="ltx_Math" alttext="P\in\mathbb{R}^{N\times T}" display="inline" intent=":literal"><semantics><mrow><mi>P</mi><mo>∈</mo><msup><mi>ℝ</mi><mrow><mi>N</mi><mo lspace="0.222em" rspace="0.222em">×</mo><mi>T</mi></mrow></msup></mrow><annotation encoding="application/x-tex">P\in\mathbb{R}^{N\times T}</annotation></semantics></math> is defined as</p>
<table id="A5.Ex170" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="A5.Ex170.m1" class="ltx_Math" alttext="P\coloneq\left[\begin{matrix}\bm{0}_{N-2A}&amp;\ldots&amp;\bm{0}_{N-2A}\\
\mathbf{q}_{1}&amp;\ldots&amp;\mathbf{q}_{T}\end{matrix}\right],\quad\mathbf{q}_{t}\coloneq\begin{pmatrix}\mathbf{q}_{1,t}\\
\mathbf{q}_{2,t}\\
\vdots\\
\mathbf{q}_{A,t}\end{pmatrix},\quad\mathbf{q}_{a,t}\coloneq\left(\begin{matrix}\sin\left(\frac{t}{T^{a/A}}\right)\\
\cos\left(\frac{t}{T^{a/A}}\right)\end{matrix}\right)." display="block" intent=":literal"><semantics><mrow><mrow><mrow><mi>P</mi><mo>≔</mo><mrow><mo>[</mo><mtable columnspacing="5pt" displaystyle="true" rowspacing="0pt"><mtr><mtd><msub><mn>𝟎</mn><mrow><mi>N</mi><mo>−</mo><mrow><mn>2</mn><mo lspace="0em" rspace="0em">​</mo><mi>A</mi></mrow></mrow></msub></mtd><mtd><mi mathvariant="normal">…</mi></mtd><mtd><msub><mn>𝟎</mn><mrow><mi>N</mi><mo>−</mo><mrow><mn>2</mn><mo lspace="0em" rspace="0em">​</mo><mi>A</mi></mrow></mrow></msub></mtd></mtr><mtr><mtd><msub><mi>𝐪</mi><mn>1</mn></msub></mtd><mtd><mi mathvariant="normal">…</mi></mtd><mtd><msub><mi>𝐪</mi><mi>T</mi></msub></mtd></mtr></mtable><mo>]</mo></mrow></mrow><mo rspace="1.167em">,</mo><mrow><msub><mi>𝐪</mi><mi>t</mi></msub><mo>≔</mo><mrow><mo>(</mo><mtable displaystyle="true" rowspacing="0pt"><mtr><mtd><msub><mi>𝐪</mi><mrow><mn>1</mn><mo>,</mo><mi>t</mi></mrow></msub></mtd></mtr><mtr><mtd><msub><mi>𝐪</mi><mrow><mn>2</mn><mo>,</mo><mi>t</mi></mrow></msub></mtd></mtr><mtr><mtd></mtd></mtr><mtr><mtd><msub><mi>𝐪</mi><mrow><mi>A</mi><mo>,</mo><mi>t</mi></mrow></msub></mtd></mtr></mtable><mo>)</mo></mrow></mrow><mo rspace="1.167em">,</mo><mrow><msub><mi>𝐪</mi><mrow><mi>a</mi><mo>,</mo><mi>t</mi></mrow></msub><mo>≔</mo><mrow><mo>(</mo><mtable displaystyle="true" rowspacing="0pt"><mtr><mtd><mrow><mi>sin</mi><mo>⁡</mo><mrow><mo>(</mo><mstyle displaystyle="false"><mfrac><mi>t</mi><msup><mi>T</mi><mrow><mi>a</mi><mo>/</mo><mi>A</mi></mrow></msup></mfrac></mstyle><mo>)</mo></mrow></mrow></mtd></mtr><mtr><mtd><mrow><mi>cos</mi><mo>⁡</mo><mrow><mo>(</mo><mstyle displaystyle="false"><mfrac><mi>t</mi><msup><mi>T</mi><mrow><mi>a</mi><mo>/</mo><mi>A</mi></mrow></msup></mfrac></mstyle><mo>)</mo></mrow></mrow></mtd></mtr></mtable><mo>)</mo></mrow></mrow></mrow><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">P\coloneq\left[\begin{matrix}\bm{0}_{N-2A}&amp;\ldots&amp;\bm{0}_{N-2A}\\
\mathbf{q}_{1}&amp;\ldots&amp;\mathbf{q}_{T}\end{matrix}\right],\quad\mathbf{q}_{t}\coloneq\begin{pmatrix}\mathbf{q}_{1,t}\\
\mathbf{q}_{2,t}\\
\vdots\\
\mathbf{q}_{A,t}\end{pmatrix},\quad\mathbf{q}_{a,t}\coloneq\left(\begin{matrix}\sin\left(\frac{t}{T^{a/A}}\right)\\
\cos\left(\frac{t}{T^{a/A}}\right)\end{matrix}\right).</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="A5.SS1.p1.2" class="ltx_p">The following lemma is key to the use of multi-scale sinusoidal positional encoding.
Although it seems likely that this result has appeared before, we were unable to find it in the literature.</p>
</div>
<div id="Thmconj212" class="ltx_theorem ltx_theorem_lemma">
<h6 class="ltx_title ltx_runin ltx_title_theorem"><span class="ltx_tag ltx_tag_theorem"><span id="Thmconj212.4" class="ltx_text ltx_font_bold">Lemma 12</span></span><span id="Thmconj212.5" class="ltx_text ltx_font_bold">.</span></h6>
<div id="Thmconj212.p1" class="ltx_para">
<p id="Thmconj212.p1.1" class="ltx_p"><span id="Thmconj212.p1.1.1" class="ltx_text ltx_font_italic">For any <math id="Thmconj212.p1.m1" class="ltx_Math" alttext="t_{1},t_{2}\in[T]" display="inline" intent=":literal"><semantics><mrow><msub><mi>t</mi><mn>1</mn></msub><mo>,</mo><mrow><msub><mi>t</mi><mn>2</mn></msub><mo>∈</mo><mrow><mo stretchy="false">[</mo><mi>T</mi><mo stretchy="false">]</mo></mrow></mrow></mrow><annotation encoding="application/x-tex">t_{1},t_{2}\in[T]</annotation></semantics></math>,</span></p>
<ol id="A5.I1" class="ltx_enumerate">
<li id="A5.I1.ix1" class="ltx_item" style="list-style-type:none;"><span class="ltx_tag ltx_tag_item">(i)</span> 
<div id="A5.I1.ix1.p1" class="ltx_para">
<p id="A5.I1.ix1.p1.1" class="ltx_p"><span id="A5.I1.ix1.p1.1.1" class="ltx_text ltx_font_italic">If </span><math id="A5.I1.ix1.p1.m1" class="ltx_Math" alttext="t_{1}=t_{2}" display="inline" intent=":literal"><semantics><mrow><msub><mi>t</mi><mn>1</mn></msub><mo>=</mo><msub><mi>t</mi><mn>2</mn></msub></mrow><annotation encoding="application/x-tex">t_{1}=t_{2}</annotation></semantics></math><span id="A5.I1.ix1.p1.1.2" class="ltx_text ltx_font_italic">, then </span><math id="A5.I1.ix1.p1.m2" class="ltx_Math" alttext="\mathbf{q}_{t_{1}}^{\top}\mathbf{q}_{t_{2}}=\sum_{a=1}^{A}\mathbf{q}_{a,t_{1}}^{\top}\mathbf{q}_{a,t_{2}}=A" display="inline" intent=":literal"><semantics><mrow><mrow><msubsup><mi>𝐪</mi><msub><mi>t</mi><mn>1</mn></msub><mo>⊤</mo></msubsup><mo lspace="0em" rspace="0em">​</mo><msub><mi>𝐪</mi><msub><mi>t</mi><mn>2</mn></msub></msub></mrow><mo rspace="0.111em">=</mo><mrow><msubsup><mo>∑</mo><mrow><mi>a</mi><mo>=</mo><mn>1</mn></mrow><mi>A</mi></msubsup><mrow><msubsup><mi>𝐪</mi><mrow><mi>a</mi><mo>,</mo><msub><mi>t</mi><mn>1</mn></msub></mrow><mo>⊤</mo></msubsup><mo lspace="0em" rspace="0em">​</mo><msub><mi>𝐪</mi><mrow><mi>a</mi><mo>,</mo><msub><mi>t</mi><mn>2</mn></msub></mrow></msub></mrow></mrow><mo>=</mo><mi>A</mi></mrow><annotation encoding="application/x-tex">\mathbf{q}_{t_{1}}^{\top}\mathbf{q}_{t_{2}}=\sum_{a=1}^{A}\mathbf{q}_{a,t_{1}}^{\top}\mathbf{q}_{a,t_{2}}=A</annotation></semantics></math><span id="A5.I1.ix1.p1.1.3" class="ltx_text ltx_font_italic">.</span></p>
</div></li>
<li id="A5.I1.ix2" class="ltx_item" style="list-style-type:none;"><span class="ltx_tag ltx_tag_item">(ii)</span> 
<div id="A5.I1.ix2.p1" class="ltx_para">
<p id="A5.I1.ix2.p1.1" class="ltx_p"><span id="A5.I1.ix2.p1.1.1" class="ltx_text ltx_font_italic">If </span><math id="A5.I1.ix2.p1.m1" class="ltx_Math" alttext="t_{1}\neq t_{2}" display="inline" intent=":literal"><semantics><mrow><msub><mi>t</mi><mn>1</mn></msub><mo>≠</mo><msub><mi>t</mi><mn>2</mn></msub></mrow><annotation encoding="application/x-tex">t_{1}\neq t_{2}</annotation></semantics></math><span id="A5.I1.ix2.p1.1.2" class="ltx_text ltx_font_italic">, then </span><math id="A5.I1.ix2.p1.m2" class="ltx_Math" alttext="\mathbf{q}_{t_{1}}^{\top}\mathbf{q}_{t_{2}}=\sum_{a=1}^{A}\mathbf{q}_{a,t_{1}}^{\top}\mathbf{q}_{a,t_{2}}\leq A-\frac{1}{3T^{2/A}}" display="inline" intent=":literal"><semantics><mrow><mrow><msubsup><mi>𝐪</mi><msub><mi>t</mi><mn>1</mn></msub><mo>⊤</mo></msubsup><mo lspace="0em" rspace="0em">​</mo><msub><mi>𝐪</mi><msub><mi>t</mi><mn>2</mn></msub></msub></mrow><mo rspace="0.111em">=</mo><mrow><msubsup><mo>∑</mo><mrow><mi>a</mi><mo>=</mo><mn>1</mn></mrow><mi>A</mi></msubsup><mrow><msubsup><mi>𝐪</mi><mrow><mi>a</mi><mo>,</mo><msub><mi>t</mi><mn>1</mn></msub></mrow><mo>⊤</mo></msubsup><mo lspace="0em" rspace="0em">​</mo><msub><mi>𝐪</mi><mrow><mi>a</mi><mo>,</mo><msub><mi>t</mi><mn>2</mn></msub></mrow></msub></mrow></mrow><mo>≤</mo><mrow><mi>A</mi><mo>−</mo><mfrac><mn>1</mn><mrow><mn>3</mn><mo lspace="0em" rspace="0em">​</mo><msup><mi>T</mi><mrow><mn>2</mn><mo>/</mo><mi>A</mi></mrow></msup></mrow></mfrac></mrow></mrow><annotation encoding="application/x-tex">\mathbf{q}_{t_{1}}^{\top}\mathbf{q}_{t_{2}}=\sum_{a=1}^{A}\mathbf{q}_{a,t_{1}}^{\top}\mathbf{q}_{a,t_{2}}\leq A-\frac{1}{3T^{2/A}}</annotation></semantics></math><span id="A5.I1.ix2.p1.1.3" class="ltx_text ltx_font_italic">.</span></p>
</div></li>
</ol>
</div>
</div>
<div id="A5.SS1.2" class="ltx_proof">
<h6 class="ltx_title ltx_runin ltx_font_italic ltx_title_proof">Proof of Lemma <a href="#Thmconj212" title="Lemma 12. ‣ E.1 Construction of multi-head self-attention layers ‣ Appendix E Construction of the Transformer ‣ Generalization Bounds for Transformer-Based Next-Token Prediction in a Language Model" class="ltx_ref"><span class="ltx_text ltx_ref_tag">12</span></a>.</h6>
<div id="A5.SS1.p2" class="ltx_para">
<p id="A5.SS1.p2.1" class="ltx_p"><span id="A5.SS1.p2.1.1" class="ltx_text">Claim (i) follows from <math id="A5.SS1.p2.m1" class="ltx_Math" alttext="\|\mathbf{q}_{a,t}\|_{2}=1" display="inline" intent=":literal"><semantics><mrow><msub><mrow><mo stretchy="false">‖</mo><msub><mi>𝐪</mi><mrow><mi>a</mi><mo>,</mo><mi>t</mi></mrow></msub><mo stretchy="false">‖</mo></mrow><mn>2</mn></msub><mo>=</mo><mn>1</mn></mrow><annotation encoding="application/x-tex">\|\mathbf{q}_{a,t}\|_{2}=1</annotation></semantics></math> for any <math id="A5.SS1.p2.m2" class="ltx_Math" alttext="a\in[A]" display="inline" intent=":literal"><semantics><mrow><mi>a</mi><mo>∈</mo><mrow><mo stretchy="false">[</mo><mi>A</mi><mo stretchy="false">]</mo></mrow></mrow><annotation encoding="application/x-tex">a\in[A]</annotation></semantics></math> and <math id="A5.SS1.p2.m3" class="ltx_Math" alttext="t\in[T]" display="inline" intent=":literal"><semantics><mrow><mi>t</mi><mo>∈</mo><mrow><mo stretchy="false">[</mo><mi>T</mi><mo stretchy="false">]</mo></mrow></mrow><annotation encoding="application/x-tex">t\in[T]</annotation></semantics></math>.</span></p>
</div>
<div id="A5.SS1.p3" class="ltx_para">
<p id="A5.SS1.p3.1" class="ltx_p"><span id="A5.SS1.p3.1.1" class="ltx_text">To prove (ii), the addition theorem and the fact that <math id="A5.SS1.p3.m1" class="ltx_Math" alttext="\cos(\cdot)" display="inline" intent=":literal"><semantics><mrow><mi>cos</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mo lspace="0em" rspace="0em">⋅</mo><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">\cos(\cdot)</annotation></semantics></math> is <math id="A5.SS1.p3.m2" class="ltx_Math" alttext="2\pi" display="inline" intent=":literal"><semantics><mrow><mn>2</mn><mo lspace="0em" rspace="0em">​</mo><mi>π</mi></mrow><annotation encoding="application/x-tex">2\pi</annotation></semantics></math>-periodic and an even function gives</span></p>
<table id="A5.EGx87" class="ltx_equationgroup ltx_eqn_align ltx_eqn_table">

<tbody id="A5.Ex171"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_align_right ltx_eqn_cell"><math id="A5.Ex171.m1" class="ltx_Math" alttext="\displaystyle\sum_{a=1}^{A}\mathbf{q}_{a,t_{1}}^{\top}\mathbf{q}_{a,t_{2}}=\sum_{a=1}^{A}\cos\left(\frac{t_{1}-t_{2}}{T^{a/A}}\right)=\sum_{a=1}^{A}\cos\left(s_{a}\right)" display="inline" intent=":literal"><semantics><mrow><mrow><mstyle displaystyle="true"><munderover><mo movablelimits="false">∑</mo><mrow><mi>a</mi><mo>=</mo><mn>1</mn></mrow><mi>A</mi></munderover></mstyle><mrow><msubsup><mi>𝐪</mi><mrow><mi>a</mi><mo>,</mo><msub><mi>t</mi><mn>1</mn></msub></mrow><mo>⊤</mo></msubsup><mo lspace="0em" rspace="0em">​</mo><msub><mi>𝐪</mi><mrow><mi>a</mi><mo>,</mo><msub><mi>t</mi><mn>2</mn></msub></mrow></msub></mrow></mrow><mo>=</mo><mrow><mstyle displaystyle="true"><munderover><mo movablelimits="false">∑</mo><mrow><mi>a</mi><mo>=</mo><mn>1</mn></mrow><mi>A</mi></munderover></mstyle><mrow><mi>cos</mi><mo>⁡</mo><mrow><mo>(</mo><mstyle displaystyle="true"><mfrac><mrow><msub><mi>t</mi><mn>1</mn></msub><mo>−</mo><msub><mi>t</mi><mn>2</mn></msub></mrow><msup><mi>T</mi><mrow><mi>a</mi><mo>/</mo><mi>A</mi></mrow></msup></mfrac></mstyle><mo>)</mo></mrow></mrow></mrow><mo>=</mo><mrow><mstyle displaystyle="true"><munderover><mo movablelimits="false">∑</mo><mrow><mi>a</mi><mo>=</mo><mn>1</mn></mrow><mi>A</mi></munderover></mstyle><mrow><mi>cos</mi><mo>⁡</mo><mrow><mo>(</mo><msub><mi>s</mi><mi>a</mi></msub><mo>)</mo></mrow></mrow></mrow></mrow><annotation encoding="application/x-tex">\displaystyle\sum_{a=1}^{A}\mathbf{q}_{a,t_{1}}^{\top}\mathbf{q}_{a,t_{2}}=\sum_{a=1}^{A}\cos\left(\frac{t_{1}-t_{2}}{T^{a/A}}\right)=\sum_{a=1}^{A}\cos\left(s_{a}\right)</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="A5.SS1.p3.2" class="ltx_p"><span id="A5.SS1.p3.2.1" class="ltx_text">with</span></p>
<table id="A5.Ex172" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="A5.Ex172.m1" class="ltx_Math" alttext="s_{a}\coloneq\left(\frac{|t_{1}-t_{2}|}{T^{a/A}}\right)-2\pi\left\lfloor\frac{1}{2\pi}\left(\frac{|t_{1}-t_{2}|}{T^{a/A}}\right)\right\rfloor\in[0,2\pi),\quad a\in[A]." display="block" intent=":literal"><semantics><mrow><mrow><mrow><msub><mi>s</mi><mi>a</mi></msub><mo>≔</mo><mrow><mrow><mo>(</mo><mfrac><mrow><mo stretchy="false">|</mo><mrow><msub><mi>t</mi><mn>1</mn></msub><mo>−</mo><msub><mi>t</mi><mn>2</mn></msub></mrow><mo stretchy="false">|</mo></mrow><msup><mi>T</mi><mrow><mi>a</mi><mo>/</mo><mi>A</mi></mrow></msup></mfrac><mo>)</mo></mrow><mo>−</mo><mrow><mn>2</mn><mo lspace="0em" rspace="0em">​</mo><mi>π</mi><mo lspace="0em" rspace="0em">​</mo><mrow><mo>⌊</mo><mrow><mfrac><mn>1</mn><mrow><mn>2</mn><mo lspace="0em" rspace="0em">​</mo><mi>π</mi></mrow></mfrac><mo lspace="0em" rspace="0em">​</mo><mrow><mo>(</mo><mfrac><mrow><mo stretchy="false">|</mo><mrow><msub><mi>t</mi><mn>1</mn></msub><mo>−</mo><msub><mi>t</mi><mn>2</mn></msub></mrow><mo stretchy="false">|</mo></mrow><msup><mi>T</mi><mrow><mi>a</mi><mo>/</mo><mi>A</mi></mrow></msup></mfrac><mo>)</mo></mrow></mrow><mo>⌋</mo></mrow></mrow></mrow><mo>∈</mo><mrow><mo stretchy="false">[</mo><mn>0</mn><mo>,</mo><mrow><mn>2</mn><mo lspace="0em" rspace="0em">​</mo><mi>π</mi></mrow><mo stretchy="false">)</mo></mrow></mrow><mo rspace="1.167em">,</mo><mrow><mi>a</mi><mo>∈</mo><mrow><mo stretchy="false">[</mo><mi>A</mi><mo stretchy="false">]</mo></mrow></mrow></mrow><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">s_{a}\coloneq\left(\frac{|t_{1}-t_{2}|}{T^{a/A}}\right)-2\pi\left\lfloor\frac{1}{2\pi}\left(\frac{|t_{1}-t_{2}|}{T^{a/A}}\right)\right\rfloor\in[0,2\pi),\quad a\in[A].</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="A5.SS1.p3.3" class="ltx_p"><span id="A5.SS1.p3.3.1" class="ltx_text">It remains to show that there exists some <math id="A5.SS1.p3.m3" class="ltx_Math" alttext="a^{\prime}\in[A]" display="inline" intent=":literal"><semantics><mrow><msup><mi>a</mi><mo>′</mo></msup><mo>∈</mo><mrow><mo stretchy="false">[</mo><mi>A</mi><mo stretchy="false">]</mo></mrow></mrow><annotation encoding="application/x-tex">a^{\prime}\in[A]</annotation></semantics></math> such that <math id="A5.SS1.p3.m4" class="ltx_math_unparsed" alttext="T^{-1/A}\leq s_{a^{\prime}}\leq 2\pi-T^{-1/A}" display="inline" intent=":literal"><semantics><mrow><mi>T</mi><msup><mrow></mrow><mrow><mo>−</mo><mn>1</mn><mo>/</mo><mi>A</mi></mrow></msup><mo>≤</mo><mi>s</mi><msub><mrow></mrow><msup><mi>a</mi><mo>′</mo></msup></msub><mo>≤</mo><mn>2</mn><mi>π</mi><mo>−</mo><mi>T</mi><msup><mrow></mrow><mrow><mo>−</mo><mn>1</mn><mo>/</mo><mi>A</mi></mrow></msup></mrow><annotation encoding="application/x-tex">T^{-1/A}\leq s_{a^{\prime}}\leq 2\pi-T^{-1/A}</annotation></semantics></math>.
Combining this with the inequality
<math id="A5.SS1.p3.m5" class="ltx_Math" alttext="\cos(x)\leq 1-x^{2}/2+x^{4}/24\leq 1-x^{2}/3" display="inline" intent=":literal"><semantics><mrow><mrow><mi>cos</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>x</mi><mo stretchy="false">)</mo></mrow></mrow><mo>≤</mo><mrow><mrow><mn>1</mn><mo>−</mo><mrow><msup><mi>x</mi><mn>2</mn></msup><mo>/</mo><mn>2</mn></mrow></mrow><mo>+</mo><mrow><msup><mi>x</mi><mn>4</mn></msup><mo>/</mo><mn>24</mn></mrow></mrow><mo>≤</mo><mrow><mn>1</mn><mo>−</mo><mrow><msup><mi>x</mi><mn>2</mn></msup><mo>/</mo><mn>3</mn></mrow></mrow></mrow><annotation encoding="application/x-tex">\cos(x)\leq 1-x^{2}/2+x^{4}/24\leq 1-x^{2}/3</annotation></semantics></math> for <math id="A5.SS1.p3.m6" class="ltx_Math" alttext="0\leq x\leq 1" display="inline" intent=":literal"><semantics><mrow><mn>0</mn><mo>≤</mo><mi>x</mi><mo>≤</mo><mn>1</mn></mrow><annotation encoding="application/x-tex">0\leq x\leq 1</annotation></semantics></math>,
we obtain <math id="A5.SS1.p3.m7" class="ltx_math_unparsed" alttext="\cos(s_{a^{\prime}})\leq\cos(T^{-1/A})\leq 1-1/(3T^{2/A})" display="inline" intent=":literal"><semantics><mrow><mi>cos</mi><mrow><mo stretchy="false">(</mo><msub><mi>s</mi><msup><mi>a</mi><mo>′</mo></msup></msub><mo stretchy="false">)</mo></mrow><mo>≤</mo><mi>cos</mi><mrow><mo stretchy="false">(</mo><msup><mi>T</mi><mrow><mo>−</mo><mn>1</mn><mo>/</mo><mi>A</mi></mrow></msup><mo stretchy="false">)</mo></mrow><mo>≤</mo><mn>1</mn><mo>−</mo><mn>1</mn><mo>/</mo><mrow><mo stretchy="false">(</mo><mn>3</mn><msup><mi>T</mi><mrow><mn>2</mn><mo>/</mo><mi>A</mi></mrow></msup><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">\cos(s_{a^{\prime}})\leq\cos(T^{-1/A})\leq 1-1/(3T^{2/A})</annotation></semantics></math>, thereby completing the proof from
<math id="A5.SS1.p3.m8" class="ltx_Math" alttext="\sum_{a=1}^{A}\cos\left(s_{a}\right)\leq(A-1)+\cos(s_{a^{\prime}})\leq A-1/(3T^{2/A})" display="inline" intent=":literal"><semantics><mrow><mrow><msubsup><mo>∑</mo><mrow><mi>a</mi><mo>=</mo><mn>1</mn></mrow><mi>A</mi></msubsup><mrow><mi>cos</mi><mo>⁡</mo><mrow><mo>(</mo><msub><mi>s</mi><mi>a</mi></msub><mo>)</mo></mrow></mrow></mrow><mo>≤</mo><mrow><mrow><mo stretchy="false">(</mo><mrow><mi>A</mi><mo>−</mo><mn>1</mn></mrow><mo stretchy="false">)</mo></mrow><mo>+</mo><mrow><mi>cos</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><msub><mi>s</mi><msup><mi>a</mi><mo>′</mo></msup></msub><mo stretchy="false">)</mo></mrow></mrow></mrow><mo>≤</mo><mrow><mi>A</mi><mo>−</mo><mrow><mn>1</mn><mo>/</mo><mrow><mo stretchy="false">(</mo><mrow><mn>3</mn><mo lspace="0em" rspace="0em">​</mo><msup><mi>T</mi><mrow><mn>2</mn><mo>/</mo><mi>A</mi></mrow></msup></mrow><mo stretchy="false">)</mo></mrow></mrow></mrow></mrow><annotation encoding="application/x-tex">\sum_{a=1}^{A}\cos\left(s_{a}\right)\leq(A-1)+\cos(s_{a^{\prime}})\leq A-1/(3T^{2/A})</annotation></semantics></math>.</span></p>
</div>
<div id="A5.SS1.p4" class="ltx_para">
<p id="A5.SS1.p4.1" class="ltx_p"><span id="A5.SS1.p4.1.1" class="ltx_text">To derive a contradiction, assume that either <math id="A5.SS1.p4.m1" class="ltx_math_unparsed" alttext="s_{a}&lt;T^{-1/A}" display="inline" intent=":literal"><semantics><mrow><mi>s</mi><msub><mrow></mrow><mi>a</mi></msub><mo>&lt;</mo><mi>T</mi><msup><mrow></mrow><mrow><mo>−</mo><mn>1</mn><mo>/</mo><mi>A</mi></mrow></msup></mrow><annotation encoding="application/x-tex">s_{a}&lt;T^{-1/A}</annotation></semantics></math> or <math id="A5.SS1.p4.m2" class="ltx_math_unparsed" alttext="s_{a}&gt;2\pi-T^{-1/A}" display="inline" intent=":literal"><semantics><mrow><mi>s</mi><msub><mrow></mrow><mi>a</mi></msub><mo>&gt;</mo><mn>2</mn><mi>π</mi><mo>−</mo><mi>T</mi><msup><mrow></mrow><mrow><mo>−</mo><mn>1</mn><mo>/</mo><mi>A</mi></mrow></msup></mrow><annotation encoding="application/x-tex">s_{a}&gt;2\pi-T^{-1/A}</annotation></semantics></math> for all <math id="A5.SS1.p4.m3" class="ltx_Math" alttext="a\in[A]" display="inline" intent=":literal"><semantics><mrow><mi>a</mi><mo>∈</mo><mrow><mo stretchy="false">[</mo><mi>A</mi><mo stretchy="false">]</mo></mrow></mrow><annotation encoding="application/x-tex">a\in[A]</annotation></semantics></math>. From <math id="A5.SS1.p4.m4" class="ltx_Math" alttext="|t_{1}-t_{2}|&lt;T" display="inline" intent=":literal"><semantics><mrow><mrow><mo stretchy="false">|</mo><mrow><msub><mi>t</mi><mn>1</mn></msub><mo>−</mo><msub><mi>t</mi><mn>2</mn></msub></mrow><mo stretchy="false">|</mo></mrow><mo>&lt;</mo><mi>T</mi></mrow><annotation encoding="application/x-tex">|t_{1}-t_{2}|&lt;T</annotation></semantics></math>, we have</span></p>
<table id="A5.Ex173" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="A5.Ex173.m1" class="ltx_Math" alttext="s_{A}=\frac{|t_{1}-t_{2}|}{T}-2\pi\left\lfloor\frac{1}{2\pi}\left(\frac{|t_{1}-t_{2}|}{T}\right)\right\rfloor=\frac{|t_{1}-t_{2}|}{T}\in(0,1)." display="block" intent=":literal"><semantics><mrow><mrow><msub><mi>s</mi><mi>A</mi></msub><mo>=</mo><mrow><mfrac><mrow><mo stretchy="false">|</mo><mrow><msub><mi>t</mi><mn>1</mn></msub><mo>−</mo><msub><mi>t</mi><mn>2</mn></msub></mrow><mo stretchy="false">|</mo></mrow><mi>T</mi></mfrac><mo>−</mo><mrow><mn>2</mn><mo lspace="0em" rspace="0em">​</mo><mi>π</mi><mo lspace="0em" rspace="0em">​</mo><mrow><mo>⌊</mo><mrow><mfrac><mn>1</mn><mrow><mn>2</mn><mo lspace="0em" rspace="0em">​</mo><mi>π</mi></mrow></mfrac><mo lspace="0em" rspace="0em">​</mo><mrow><mo>(</mo><mfrac><mrow><mo stretchy="false">|</mo><mrow><msub><mi>t</mi><mn>1</mn></msub><mo>−</mo><msub><mi>t</mi><mn>2</mn></msub></mrow><mo stretchy="false">|</mo></mrow><mi>T</mi></mfrac><mo>)</mo></mrow></mrow><mo>⌋</mo></mrow></mrow></mrow><mo>=</mo><mfrac><mrow><mo stretchy="false">|</mo><mrow><msub><mi>t</mi><mn>1</mn></msub><mo>−</mo><msub><mi>t</mi><mn>2</mn></msub></mrow><mo stretchy="false">|</mo></mrow><mi>T</mi></mfrac><mo>∈</mo><mrow><mo stretchy="false">(</mo><mn>0</mn><mo>,</mo><mn>1</mn><mo stretchy="false">)</mo></mrow></mrow><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">s_{A}=\frac{|t_{1}-t_{2}|}{T}-2\pi\left\lfloor\frac{1}{2\pi}\left(\frac{|t_{1}-t_{2}|}{T}\right)\right\rfloor=\frac{|t_{1}-t_{2}|}{T}\in(0,1).</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="A5.SS1.p4.2" class="ltx_p"><span id="A5.SS1.p4.2.1" class="ltx_text">This excludes the possibility that <math id="A5.SS1.p4.m5" class="ltx_math_unparsed" alttext="s_{A}&gt;2\pi-T^{-1/A}" display="inline" intent=":literal"><semantics><mrow><mi>s</mi><msub><mrow></mrow><mi>A</mi></msub><mo>&gt;</mo><mn>2</mn><mi>π</mi><mo>−</mo><mi>T</mi><msup><mrow></mrow><mrow><mo>−</mo><mn>1</mn><mo>/</mo><mi>A</mi></mrow></msup></mrow><annotation encoding="application/x-tex">s_{A}&gt;2\pi-T^{-1/A}</annotation></semantics></math> and by assumption, we must have <math id="A5.SS1.p4.m6" class="ltx_math_unparsed" alttext="s_{A}&lt;T^{-1/A}." display="inline" intent=":literal"><semantics><mrow><mi>s</mi><msub><mrow></mrow><mi>A</mi></msub><mo>&lt;</mo><mi>T</mi><msup><mrow></mrow><mrow><mo>−</mo><mn>1</mn><mo>/</mo><mi>A</mi></mrow></msup><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">s_{A}&lt;T^{-1/A}.</annotation></semantics></math>
Now, assume that</span></p>
<table id="A5.Ex174" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="A5.Ex174.m1" class="ltx_math_unparsed" alttext="s_{a+1}=\frac{|t_{1}-t_{2}|}{T^{(a+1)/A}}&lt;T^{-1/A},\quad\text{for some}\ a\in\{A-1,A-2,\ldots,1\}." display="block" intent=":literal"><semantics><mrow><msub><mi>s</mi><mrow><mi>a</mi><mo>+</mo><mn>1</mn></mrow></msub><mo>=</mo><mfrac><mrow><mo stretchy="false">|</mo><mrow><msub><mi>t</mi><mn>1</mn></msub><mo>−</mo><msub><mi>t</mi><mn>2</mn></msub></mrow><mo stretchy="false">|</mo></mrow><msup><mi>T</mi><mrow><mrow><mo stretchy="false">(</mo><mrow><mi>a</mi><mo>+</mo><mn>1</mn></mrow><mo stretchy="false">)</mo></mrow><mo>/</mo><mi>A</mi></mrow></msup></mfrac><mo>&lt;</mo><msup><mi>T</mi><mrow><mo>−</mo><mn>1</mn><mo>/</mo><mi>A</mi></mrow></msup><mo rspace="1.167em">,</mo><mtext>for some</mtext><mi>a</mi><mo>∈</mo><mrow><mo stretchy="false">{</mo><mi>A</mi><mo>−</mo><mn>1</mn><mo>,</mo><mi>A</mi><mo>−</mo><mn>2</mn><mo>,</mo><mi mathvariant="normal">…</mi><mo>,</mo><mn>1</mn><mo stretchy="false">}</mo></mrow><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">s_{a+1}=\frac{|t_{1}-t_{2}|}{T^{(a+1)/A}}&lt;T^{-1/A},\quad\text{for some}\ a\in\{A-1,A-2,\ldots,1\}.</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="A5.SS1.p4.3" class="ltx_p"><span id="A5.SS1.p4.3.1" class="ltx_text">It follows</span></p>
<table id="A5.Ex175" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="A5.Ex175.m1" class="ltx_Math" alttext="\frac{|t_{1}-t_{2}|}{T^{a/A}}&lt;1&lt;2\pi," display="block" intent=":literal"><semantics><mrow><mrow><mfrac><mrow><mo stretchy="false">|</mo><mrow><msub><mi>t</mi><mn>1</mn></msub><mo>−</mo><msub><mi>t</mi><mn>2</mn></msub></mrow><mo stretchy="false">|</mo></mrow><msup><mi>T</mi><mrow><mi>a</mi><mo>/</mo><mi>A</mi></mrow></msup></mfrac><mo>&lt;</mo><mn>1</mn><mo>&lt;</mo><mrow><mn>2</mn><mo lspace="0em" rspace="0em">​</mo><mi>π</mi></mrow></mrow><mo>,</mo></mrow><annotation encoding="application/x-tex">\frac{|t_{1}-t_{2}|}{T^{a/A}}&lt;1&lt;2\pi,</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="A5.SS1.p4.4" class="ltx_p"><span id="A5.SS1.p4.4.1" class="ltx_text">and hence</span></p>
<table id="A5.EGx88" class="ltx_equationgroup ltx_eqn_align ltx_eqn_table">

<tbody id="A5.Ex176"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_align_right ltx_eqn_cell"><math id="A5.Ex176.m1" class="ltx_Math" alttext="\displaystyle s_{a}" display="inline" intent=":literal"><semantics><msub><mi>s</mi><mi>a</mi></msub><annotation encoding="application/x-tex">\displaystyle s_{a}</annotation></semantics></math></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A5.Ex176.m2" class="ltx_Math" alttext="\displaystyle=\frac{|t_{1}-t_{2}|}{T^{a/A}}-2\pi\left\lfloor\frac{1}{2\pi}\left(\frac{|t_{1}-t_{2}|}{T^{a/A}}\right)\right\rfloor=\frac{|t_{1}-t_{2}|}{T^{a/A}}&lt;1." display="inline" intent=":literal"><semantics><mrow><mrow><mphantom></mphantom><mo>=</mo><mrow><mstyle displaystyle="true"><mfrac><mrow><mo stretchy="false">|</mo><mrow><msub><mi>t</mi><mn>1</mn></msub><mo>−</mo><msub><mi>t</mi><mn>2</mn></msub></mrow><mo stretchy="false">|</mo></mrow><msup><mi>T</mi><mrow><mi>a</mi><mo>/</mo><mi>A</mi></mrow></msup></mfrac></mstyle><mo>−</mo><mrow><mn>2</mn><mo lspace="0em" rspace="0em">​</mo><mi>π</mi><mo lspace="0em" rspace="0em">​</mo><mrow><mo>⌊</mo><mrow><mstyle displaystyle="true"><mfrac><mn>1</mn><mrow><mn>2</mn><mo lspace="0em" rspace="0em">​</mo><mi>π</mi></mrow></mfrac></mstyle><mo lspace="0em" rspace="0em">​</mo><mrow><mo>(</mo><mstyle displaystyle="true"><mfrac><mrow><mo stretchy="false">|</mo><mrow><msub><mi>t</mi><mn>1</mn></msub><mo>−</mo><msub><mi>t</mi><mn>2</mn></msub></mrow><mo stretchy="false">|</mo></mrow><msup><mi>T</mi><mrow><mi>a</mi><mo>/</mo><mi>A</mi></mrow></msup></mfrac></mstyle><mo>)</mo></mrow></mrow><mo>⌋</mo></mrow></mrow></mrow><mo>=</mo><mstyle displaystyle="true"><mfrac><mrow><mo stretchy="false">|</mo><mrow><msub><mi>t</mi><mn>1</mn></msub><mo>−</mo><msub><mi>t</mi><mn>2</mn></msub></mrow><mo stretchy="false">|</mo></mrow><msup><mi>T</mi><mrow><mi>a</mi><mo>/</mo><mi>A</mi></mrow></msup></mfrac></mstyle><mo>&lt;</mo><mn>1</mn></mrow><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">\displaystyle=\frac{|t_{1}-t_{2}|}{T^{a/A}}-2\pi\left\lfloor\frac{1}{2\pi}\left(\frac{|t_{1}-t_{2}|}{T^{a/A}}\right)\right\rfloor=\frac{|t_{1}-t_{2}|}{T^{a/A}}&lt;1.</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="A5.SS1.p4.5" class="ltx_p"><span id="A5.SS1.p4.5.1" class="ltx_text">From the assumption, it follows that <math id="A5.SS1.p4.m7" class="ltx_math_unparsed" alttext="s_{a}&lt;T^{-1/A}" display="inline" intent=":literal"><semantics><mrow><mi>s</mi><msub><mrow></mrow><mi>a</mi></msub><mo>&lt;</mo><mi>T</mi><msup><mrow></mrow><mrow><mo>−</mo><mn>1</mn><mo>/</mo><mi>A</mi></mrow></msup></mrow><annotation encoding="application/x-tex">s_{a}&lt;T^{-1/A}</annotation></semantics></math>.
By backwards induction on <math id="A5.SS1.p4.m8" class="ltx_Math" alttext="a" display="inline" intent=":literal"><semantics><mi>a</mi><annotation encoding="application/x-tex">a</annotation></semantics></math> from <math id="A5.SS1.p4.m9" class="ltx_Math" alttext="A-1" display="inline" intent=":literal"><semantics><mrow><mi>A</mi><mo>−</mo><mn>1</mn></mrow><annotation encoding="application/x-tex">A-1</annotation></semantics></math> down to <math id="A5.SS1.p4.m10" class="ltx_Math" alttext="1" display="inline" intent=":literal"><semantics><mn>1</mn><annotation encoding="application/x-tex">1</annotation></semantics></math>,
we obtain</span></p>
<table id="A5.Ex177" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="A5.Ex177.m1" class="ltx_math_unparsed" alttext="s_{a}=\frac{|t_{1}-t_{2}|}{T^{a/A}}&lt;T^{-1/A}" display="block" intent=":literal"><semantics><mrow><mi>s</mi><msub><mrow></mrow><mi>a</mi></msub><mo>=</mo><mfrac><mrow><mo stretchy="false">|</mo><mrow><msub><mi>t</mi><mn>1</mn></msub><mo>−</mo><msub><mi>t</mi><mn>2</mn></msub></mrow><mo stretchy="false">|</mo></mrow><msup><mi>T</mi><mrow><mi>a</mi><mo>/</mo><mi>A</mi></mrow></msup></mfrac><mo>&lt;</mo><mi>T</mi><msup><mrow></mrow><mrow><mo>−</mo><mn>1</mn><mo>/</mo><mi>A</mi></mrow></msup></mrow><annotation encoding="application/x-tex">s_{a}=\frac{|t_{1}-t_{2}|}{T^{a/A}}&lt;T^{-1/A}</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="A5.SS1.p4.6" class="ltx_p"><span id="A5.SS1.p4.6.1" class="ltx_text">for every <math id="A5.SS1.p4.m11" class="ltx_Math" alttext="a\in[A]" display="inline" intent=":literal"><semantics><mrow><mi>a</mi><mo>∈</mo><mrow><mo stretchy="false">[</mo><mi>A</mi><mo stretchy="false">]</mo></mrow></mrow><annotation encoding="application/x-tex">a\in[A]</annotation></semantics></math>. For <math id="A5.SS1.p4.m12" class="ltx_Math" alttext="a=1," display="inline" intent=":literal"><semantics><mrow><mrow><mi>a</mi><mo>=</mo><mn>1</mn></mrow><mo>,</mo></mrow><annotation encoding="application/x-tex">a=1,</annotation></semantics></math></span></p>
<table id="A5.Ex178" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="A5.Ex178.m1" class="ltx_math_unparsed" alttext="T^{-1/A}\leq\frac{|t_{1}-t_{2}|}{T^{1/A}}=s_{1}&lt;T^{-1/A}," display="block" intent=":literal"><semantics><mrow><mi>T</mi><msup><mrow></mrow><mrow><mo>−</mo><mn>1</mn><mo>/</mo><mi>A</mi></mrow></msup><mo>≤</mo><mfrac><mrow><mo stretchy="false">|</mo><mrow><msub><mi>t</mi><mn>1</mn></msub><mo>−</mo><msub><mi>t</mi><mn>2</mn></msub></mrow><mo stretchy="false">|</mo></mrow><msup><mi>T</mi><mrow><mn>1</mn><mo>/</mo><mi>A</mi></mrow></msup></mfrac><mo>=</mo><mi>s</mi><msub><mrow></mrow><mn>1</mn></msub><mo>&lt;</mo><mi>T</mi><msup><mrow></mrow><mrow><mo>−</mo><mn>1</mn><mo>/</mo><mi>A</mi></mrow></msup><mo>,</mo></mrow><annotation encoding="application/x-tex">T^{-1/A}\leq\frac{|t_{1}-t_{2}|}{T^{1/A}}=s_{1}&lt;T^{-1/A},</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="A5.SS1.p4.7" class="ltx_p"><span id="A5.SS1.p4.7.1" class="ltx_text">we arrive at a contradiction. Therefore, the claimed result follows.
∎</span></p>
</div>
</div>
<div id="Thmrem2" class="ltx_theorem ltx_theorem_rem">
<h6 class="ltx_title ltx_runin ltx_title_theorem"><span class="ltx_tag ltx_tag_theorem"><span id="Thmrem2.4" class="ltx_text ltx_font_bold">Remark 2</span></span><span id="Thmrem2.5" class="ltx_text ltx_font_bold">.</span></h6>
<div id="Thmrem2.p1" class="ltx_para">
<p id="Thmrem2.p1.1" class="ltx_p"><span id="Thmrem2.p1.1.1" class="ltx_text ltx_font_italic">There is a clear benefit in choosing <math id="Thmrem2.p1.m1" class="ltx_Math" alttext="A\gg 1." display="inline" intent=":literal"><semantics><mrow><mrow><mi>A</mi><mo>≫</mo><mn>1</mn></mrow><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">A\gg 1.</annotation></semantics></math> For single-scale sinusoidal positional encoding (i.e., <math id="Thmrem2.p1.m2" class="ltx_Math" alttext="A=1" display="inline" intent=":literal"><semantics><mrow><mi>A</mi><mo>=</mo><mn>1</mn></mrow><annotation encoding="application/x-tex">A=1</annotation></semantics></math>), the difference between two adjacent positional encoding vectors, <math id="Thmrem2.p1.m3" class="ltx_Math" alttext="\mathbf{q}_{t}" display="inline" intent=":literal"><semantics><msub><mi>𝐪</mi><mi>t</mi></msub><annotation encoding="application/x-tex">\mathbf{q}_{t}</annotation></semantics></math> and <math id="Thmrem2.p1.m4" class="ltx_Math" alttext="\mathbf{q}_{t+1}" display="inline" intent=":literal"><semantics><msub><mi>𝐪</mi><mrow><mi>t</mi><mo>+</mo><mn>1</mn></mrow></msub><annotation encoding="application/x-tex">\mathbf{q}_{t+1}</annotation></semantics></math>, scales with <math id="Thmrem2.p1.m5" class="ltx_Math" alttext="O(1/T)" display="inline" intent=":literal"><semantics><mrow><mi>O</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mrow><mn>1</mn><mo>/</mo><mi>T</mi></mrow><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">O(1/T)</annotation></semantics></math>.
If the self-attention layer is defined using the hardmax function, that is,</span></p>
<table id="A5.Ex179" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="A5.Ex179.m1" class="ltx_math_unparsed" alttext="\Big(VX\operatorname{hardmax}\big(X^{\top}UX\big)\Big)_{:,t}=V\mathbf{x}_{s^{*}}\ \text{ with }\ s^{*}\coloneqq\argmax_{s\in[T]}\big(\mathbf{x}^{\top}_{s}U\mathbf{x}_{t}\big)," display="block" intent=":literal"><semantics><mrow><msub><mrow><mo maxsize="1.600em" minsize="1.600em">(</mo><mi>V</mi><mi>X</mi><mi>hardmax</mi><mrow><mo maxsize="1.200em" minsize="1.200em">(</mo><msup><mi>X</mi><mo>⊤</mo></msup><mi>U</mi><mi>X</mi><mo maxsize="1.200em" minsize="1.200em">)</mo></mrow><mo maxsize="1.600em" minsize="1.600em">)</mo></mrow><mrow><mo rspace="0em">:</mo><mo>,</mo><mi>t</mi></mrow></msub><mo>=</mo><mi>V</mi><msub><mi>𝐱</mi><msup><mi>s</mi><mo>∗</mo></msup></msub><mtext class="ltx_mathvariant_italic"> with </mtext><msup><mi>s</mi><mo>∗</mo></msup><mo rspace="0.1389em">≔</mo><msub><mo lspace="0.1389em" rspace="0em">argmax</mo><mrow><mi>s</mi><mo>∈</mo><mrow><mo stretchy="false">[</mo><mi>T</mi><mo stretchy="false">]</mo></mrow></mrow></msub><mrow><mo maxsize="1.200em" minsize="1.200em">(</mo><msubsup><mi>𝐱</mi><mi>s</mi><mo>⊤</mo></msubsup><mi>U</mi><msub><mi>𝐱</mi><mi>t</mi></msub><mo maxsize="1.200em" minsize="1.200em">)</mo></mrow><mo>,</mo></mrow><annotation encoding="application/x-tex">\Big(VX\operatorname{hardmax}\big(X^{\top}UX\big)\Big)_{:,t}=V\mathbf{x}_{s^{*}}\ \text{ with }\ s^{*}\coloneqq\argmax_{s\in[T]}\big(\mathbf{x}^{\top}_{s}U\mathbf{x}_{t}\big),</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="Thmrem2.p1.2" class="ltx_p"><span id="Thmrem2.p1.2.1" class="ltx_text ltx_font_italic">this small difference is sufficient to distinguish the two columns.
However, when using the softmax function, this difference needs to be multiplied by extremely large values to become non-negligible.
In contrast, in Theorem <a href="#Thmconj24" title="Theorem 4. ‣ 4.1 Proof of the risk bound ‣ 4 Risk bound ‣ Generalization Bounds for Transformer-Based Next-Token Prediction in a Language Model" class="ltx_ref"><span class="ltx_text ltx_ref_tag">4</span></a>, we employ the multi-scale sinusoidal positional encoding with <math id="Thmrem2.p1.m6" class="ltx_Math" alttext="A=N/4\gtrsim\log T" display="inline" intent=":literal"><semantics><mrow><mi>A</mi><mo>=</mo><mrow><mi>N</mi><mo>/</mo><mn>4</mn></mrow><mo>≳</mo><mrow><mi>log</mi><mo lspace="0.167em">⁡</mo><mi>T</mi></mrow></mrow><annotation encoding="application/x-tex">A=N/4\gtrsim\log T</annotation></semantics></math>, which gives <math id="Thmrem2.p1.m7" class="ltx_Math" alttext="(3T^{2/A})^{-1}\gtrsim 1" display="inline" intent=":literal"><semantics><mrow><msup><mrow><mo stretchy="false">(</mo><mrow><mn>3</mn><mo lspace="0em" rspace="0em">​</mo><msup><mi>T</mi><mrow><mn>2</mn><mo>/</mo><mi>A</mi></mrow></msup></mrow><mo stretchy="false">)</mo></mrow><mrow><mo>−</mo><mn>1</mn></mrow></msup><mo>≳</mo><mn>1</mn></mrow><annotation encoding="application/x-tex">(3T^{2/A})^{-1}\gtrsim 1</annotation></semantics></math>.
By applying Lemma <a href="#Thmconj212" title="Lemma 12. ‣ E.1 Construction of multi-head self-attention layers ‣ Appendix E Construction of the Transformer ‣ Generalization Bounds for Transformer-Based Next-Token Prediction in a Language Model" class="ltx_ref"><span class="ltx_text ltx_ref_tag">12</span></a>, we therefore do not need to use such large parameters.</span></p>
</div>
</div>
<div id="A5.SS1.p5" class="ltx_para">
<p id="A5.SS1.p5.1" class="ltx_p">For fixed <math id="A5.SS1.p5.m1" class="ltx_Math" alttext="r" display="inline" intent=":literal"><semantics><mi>r</mi><annotation encoding="application/x-tex">r</annotation></semantics></math> and each <math id="A5.SS1.p5.m2" class="ltx_Math" alttext="a\in[A]" display="inline" intent=":literal"><semantics><mrow><mi>a</mi><mo>∈</mo><mrow><mo stretchy="false">[</mo><mi>A</mi><mo stretchy="false">]</mo></mrow></mrow><annotation encoding="application/x-tex">a\in[A]</annotation></semantics></math>, introducing the <math id="A5.SS1.p5.m3" class="ltx_Math" alttext="2\times 2" display="inline" intent=":literal"><semantics><mrow><mn>2</mn><mo lspace="0.222em" rspace="0.222em">×</mo><mn>2</mn></mrow><annotation encoding="application/x-tex">2\times 2</annotation></semantics></math> rotation matrix</p>
<table id="A5.EGx89" class="ltx_equationgroup ltx_eqn_align ltx_eqn_table">

<tbody id="A5.E49"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_align_right ltx_eqn_cell"><math id="A5.E49.m1" class="ltx_Math" alttext="\displaystyle M_{a}\coloneq\left[\begin{matrix}\cos\left(\frac{r}{T^{a/A}}\right)&amp;-\sin\left(\frac{r}{T^{a/A}}\right)\\
\sin\left(\frac{r}{T^{a/A}}\right)&amp;\cos\left(\frac{r}{T^{a/A}}\right)\end{matrix}\right]," display="inline" intent=":literal"><semantics><mrow><mrow><msub><mi>M</mi><mi>a</mi></msub><mo>≔</mo><mrow><mo>[</mo><mtable columnspacing="5pt" rowspacing="0pt"><mtr><mtd><mrow><mi>cos</mi><mo>⁡</mo><mrow><mo>(</mo><mfrac><mi>r</mi><msup><mi>T</mi><mrow><mi>a</mi><mo>/</mo><mi>A</mi></mrow></msup></mfrac><mo>)</mo></mrow></mrow></mtd><mtd><mrow><mo rspace="0.167em">−</mo><mrow><mi>sin</mi><mo>⁡</mo><mrow><mo>(</mo><mfrac><mi>r</mi><msup><mi>T</mi><mrow><mi>a</mi><mo>/</mo><mi>A</mi></mrow></msup></mfrac><mo>)</mo></mrow></mrow></mrow></mtd></mtr><mtr><mtd><mrow><mi>sin</mi><mo>⁡</mo><mrow><mo>(</mo><mfrac><mi>r</mi><msup><mi>T</mi><mrow><mi>a</mi><mo>/</mo><mi>A</mi></mrow></msup></mfrac><mo>)</mo></mrow></mrow></mtd><mtd><mrow><mi>cos</mi><mo>⁡</mo><mrow><mo>(</mo><mfrac><mi>r</mi><msup><mi>T</mi><mrow><mi>a</mi><mo>/</mo><mi>A</mi></mrow></msup></mfrac><mo>)</mo></mrow></mrow></mtd></mtr></mtable><mo>]</mo></mrow></mrow><mo>,</mo></mrow><annotation encoding="application/x-tex">\displaystyle M_{a}\coloneq\left[\begin{matrix}\cos\left(\frac{r}{T^{a/A}}\right)&amp;-\sin\left(\frac{r}{T^{a/A}}\right)\\
\sin\left(\frac{r}{T^{a/A}}\right)&amp;\cos\left(\frac{r}{T^{a/A}}\right)\end{matrix}\right],</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td>
<td rowspan="1" class="ltx_eqn_cell ltx_eqn_eqno ltx_align_middle ltx_align_right"><span class="ltx_tag ltx_tag_equation ltx_align_right">(49)</span></td></tr></tbody>
</table>
<p id="A5.SS1.p5.2" class="ltx_p">and applying the addition theorem yields</p>
<table id="A5.EGx90" class="ltx_equationgroup ltx_eqn_align ltx_eqn_table">

<tbody id="A5.E50"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_align_right ltx_eqn_cell"><math id="A5.E50.m1" class="ltx_Math" alttext="\displaystyle M_{a}\mathbf{q}_{a,t}=\left[\begin{matrix}\cos\left(\frac{r}{T^{a/A}}\right)&amp;-\sin\left(\frac{r}{T^{a/A}}\right)\\
\sin\left(\frac{r}{T^{a/A}}\right)&amp;\cos\left(\frac{r}{T^{a/A}}\right)\end{matrix}\right]\left(\begin{matrix}\sin\Big(\frac{t}{T^{a/A}}\Big)\\
\cos\Big(\frac{t}{T^{a/A}}\Big)\end{matrix}\right)=\left(\begin{matrix}\sin\Big(\frac{t-r}{T^{a/A}}\Big)\\
\cos\Big(\frac{t-r}{T^{a/A}}\Big)\end{matrix}\right)=\mathbf{q}_{a,t-r}." display="inline" intent=":literal"><semantics><mrow><mrow><mrow><msub><mi>M</mi><mi>a</mi></msub><mo lspace="0em" rspace="0em">​</mo><msub><mi>𝐪</mi><mrow><mi>a</mi><mo>,</mo><mi>t</mi></mrow></msub></mrow><mo>=</mo><mrow><mrow><mo>[</mo><mtable columnspacing="5pt" rowspacing="0pt"><mtr><mtd><mrow><mi>cos</mi><mo>⁡</mo><mrow><mo>(</mo><mfrac><mi>r</mi><msup><mi>T</mi><mrow><mi>a</mi><mo>/</mo><mi>A</mi></mrow></msup></mfrac><mo>)</mo></mrow></mrow></mtd><mtd><mrow><mo rspace="0.167em">−</mo><mrow><mi>sin</mi><mo>⁡</mo><mrow><mo>(</mo><mfrac><mi>r</mi><msup><mi>T</mi><mrow><mi>a</mi><mo>/</mo><mi>A</mi></mrow></msup></mfrac><mo>)</mo></mrow></mrow></mrow></mtd></mtr><mtr><mtd><mrow><mi>sin</mi><mo>⁡</mo><mrow><mo>(</mo><mfrac><mi>r</mi><msup><mi>T</mi><mrow><mi>a</mi><mo>/</mo><mi>A</mi></mrow></msup></mfrac><mo>)</mo></mrow></mrow></mtd><mtd><mrow><mi>cos</mi><mo>⁡</mo><mrow><mo>(</mo><mfrac><mi>r</mi><msup><mi>T</mi><mrow><mi>a</mi><mo>/</mo><mi>A</mi></mrow></msup></mfrac><mo>)</mo></mrow></mrow></mtd></mtr></mtable><mo>]</mo></mrow><mo lspace="0em" rspace="0em">​</mo><mrow><mo>(</mo><mtable rowspacing="0pt"><mtr><mtd><mrow><mi>sin</mi><mo>⁡</mo><mrow><mo maxsize="1.600em" minsize="1.600em">(</mo><mfrac><mi>t</mi><msup><mi>T</mi><mrow><mi>a</mi><mo>/</mo><mi>A</mi></mrow></msup></mfrac><mo maxsize="1.600em" minsize="1.600em">)</mo></mrow></mrow></mtd></mtr><mtr><mtd><mrow><mi>cos</mi><mo>⁡</mo><mrow><mo maxsize="1.600em" minsize="1.600em">(</mo><mfrac><mi>t</mi><msup><mi>T</mi><mrow><mi>a</mi><mo>/</mo><mi>A</mi></mrow></msup></mfrac><mo maxsize="1.600em" minsize="1.600em">)</mo></mrow></mrow></mtd></mtr></mtable><mo>)</mo></mrow></mrow><mo>=</mo><mrow><mo>(</mo><mtable rowspacing="0pt"><mtr><mtd><mrow><mi>sin</mi><mo>⁡</mo><mrow><mo maxsize="1.600em" minsize="1.600em">(</mo><mfrac><mrow><mi>t</mi><mo>−</mo><mi>r</mi></mrow><msup><mi>T</mi><mrow><mi>a</mi><mo>/</mo><mi>A</mi></mrow></msup></mfrac><mo maxsize="1.600em" minsize="1.600em">)</mo></mrow></mrow></mtd></mtr><mtr><mtd><mrow><mi>cos</mi><mo>⁡</mo><mrow><mo maxsize="1.600em" minsize="1.600em">(</mo><mfrac><mrow><mi>t</mi><mo>−</mo><mi>r</mi></mrow><msup><mi>T</mi><mrow><mi>a</mi><mo>/</mo><mi>A</mi></mrow></msup></mfrac><mo maxsize="1.600em" minsize="1.600em">)</mo></mrow></mrow></mtd></mtr></mtable><mo>)</mo></mrow><mo>=</mo><msub><mi>𝐪</mi><mrow><mi>a</mi><mo>,</mo><mrow><mi>t</mi><mo>−</mo><mi>r</mi></mrow></mrow></msub></mrow><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">\displaystyle M_{a}\mathbf{q}_{a,t}=\left[\begin{matrix}\cos\left(\frac{r}{T^{a/A}}\right)&amp;-\sin\left(\frac{r}{T^{a/A}}\right)\\
\sin\left(\frac{r}{T^{a/A}}\right)&amp;\cos\left(\frac{r}{T^{a/A}}\right)\end{matrix}\right]\left(\begin{matrix}\sin\Big(\frac{t}{T^{a/A}}\Big)\\
\cos\Big(\frac{t}{T^{a/A}}\Big)\end{matrix}\right)=\left(\begin{matrix}\sin\Big(\frac{t-r}{T^{a/A}}\Big)\\
\cos\Big(\frac{t-r}{T^{a/A}}\Big)\end{matrix}\right)=\mathbf{q}_{a,t-r}.</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td>
<td rowspan="1" class="ltx_eqn_cell ltx_eqn_eqno ltx_align_middle ltx_align_right"><span class="ltx_tag ltx_tag_equation ltx_align_right">(50)</span></td></tr></tbody>
</table>
<p id="A5.SS1.p5.3" class="ltx_p">This is the key argument in the next lemma showing how the self-attention layer can approximately implement a delay operation with respect to its sequential input.</p>
</div>
<div id="Thmconj213" class="ltx_theorem ltx_theorem_lemma">
<h6 class="ltx_title ltx_runin ltx_title_theorem"><span class="ltx_tag ltx_tag_theorem"><span id="Thmconj213.4" class="ltx_text ltx_font_bold">Lemma 13</span></span><span id="Thmconj213.5" class="ltx_text ltx_font_bold">.</span></h6>
<div id="Thmconj213.p1" class="ltx_para">
<p id="Thmconj213.p1.1" class="ltx_p"><span id="Thmconj213.p1.1.1" class="ltx_text ltx_font_italic">Under Assumption <a href="#Thmassumpt3" title="Assumption 3. ‣ 4 Risk bound ‣ Generalization Bounds for Transformer-Based Next-Token Prediction in a Language Model" class="ltx_ref"><span class="ltx_text ltx_ref_tag">3</span></a>, and for any <math id="Thmconj213.p1.m1" class="ltx_Math" alttext="d_{1},d_{2},d_{3},d_{4}\in\mathbb{N}_{0}" display="inline" intent=":literal"><semantics><mrow><msub><mi>d</mi><mn>1</mn></msub><mo>,</mo><msub><mi>d</mi><mn>2</mn></msub><mo>,</mo><msub><mi>d</mi><mn>3</mn></msub><mo>,</mo><mrow><msub><mi>d</mi><mn>4</mn></msub><mo>∈</mo><msub><mi>ℕ</mi><mn>0</mn></msub></mrow></mrow><annotation encoding="application/x-tex">d_{1},d_{2},d_{3},d_{4}\in\mathbb{N}_{0}</annotation></semantics></math> with <math id="Thmconj213.p1.m2" class="ltx_Math" alttext="d_{1}+d_{2}+d_{3}=N/2" display="inline" intent=":literal"><semantics><mrow><mrow><msub><mi>d</mi><mn>1</mn></msub><mo>+</mo><msub><mi>d</mi><mn>2</mn></msub><mo>+</mo><msub><mi>d</mi><mn>3</mn></msub></mrow><mo>=</mo><mrow><mi>N</mi><mo>/</mo><mn>2</mn></mrow></mrow><annotation encoding="application/x-tex">d_{1}+d_{2}+d_{3}=N/2</annotation></semantics></math> and <math id="Thmconj213.p1.m3" class="ltx_Math" alttext="d_{2}+d_{4}\leq N" display="inline" intent=":literal"><semantics><mrow><mrow><msub><mi>d</mi><mn>2</mn></msub><mo>+</mo><msub><mi>d</mi><mn>4</mn></msub></mrow><mo>≤</mo><mi>N</mi></mrow><annotation encoding="application/x-tex">d_{2}+d_{4}\leq N</annotation></semantics></math>, and for any <math id="Thmconj213.p1.m4" class="ltx_Math" alttext="r\in\{0,1,\ldots,T-1\}" display="inline" intent=":literal"><semantics><mrow><mi>r</mi><mo>∈</mo><mrow><mo stretchy="false">{</mo><mrow><mn>0</mn><mo>,</mo><mn>1</mn><mo>,</mo><mi mathvariant="normal">…</mi><mo>,</mo><mrow><mi>T</mi><mo>−</mo><mn>1</mn></mrow></mrow><mo stretchy="false">}</mo></mrow></mrow><annotation encoding="application/x-tex">r\in\{0,1,\ldots,T-1\}</annotation></semantics></math>,
there exists a self-attention <math id="Thmconj213.p1.m5" class="ltx_Math" alttext="\operatorname{SA}_{U,V}\in\mathcal{SA}(N,B)" display="inline" intent=":literal"><semantics><mrow><msub><mi>SA</mi><mrow><mi>U</mi><mo>,</mo><mi>V</mi></mrow></msub><mo>∈</mo><mrow><mi class="ltx_font_mathcaligraphic">𝒮</mi><mo lspace="0em" rspace="0em">​</mo><mi class="ltx_font_mathcaligraphic">𝒜</mi><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>N</mi><mo>,</mo><mi>B</mi><mo stretchy="false">)</mo></mrow></mrow></mrow><annotation encoding="application/x-tex">\operatorname{SA}_{U,V}\in\mathcal{SA}(N,B)</annotation></semantics></math> such that</span></p>
<table id="A5.Ex180" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="A5.Ex180.m1" class="ltx_Math" alttext="\operatorname{SA}_{U,V}:\left(\begin{matrix}\mathbf{x}_{1,t}\\
\mathbf{x}_{2,t}\\
\mathbf{x}_{3,t}\\
\mathbf{q}_{t}\end{matrix}\right)_{t\in[T]}\begin{array}[]{l}\in[-1,1]^{d_{1}}\\
\in[-1,1]^{d_{2}}\\
\in[-1,1]^{d_{3}}\\
\in[-1,1]^{N/2}\end{array}\longmapsto\quad\left(\begin{matrix}\bm{0}_{d_{4}}\\
\mathbf{y}_{t}\\
\bm{0}_{N-d_{2}-d_{4}}\end{matrix}\right)_{t\in[T]}" display="block" intent=":literal"><semantics><mrow><mrow><msub><mi>SA</mi><mrow><mi>U</mi><mo>,</mo><mi>V</mi></mrow></msub><mo lspace="0.278em" rspace="0.278em">:</mo><mrow><mrow><msub><mrow><mo>(</mo><mtable displaystyle="true" rowspacing="0pt"><mtr><mtd><msub><mi>𝐱</mi><mrow><mn>1</mn><mo>,</mo><mi>t</mi></mrow></msub></mtd></mtr><mtr><mtd><msub><mi>𝐱</mi><mrow><mn>2</mn><mo>,</mo><mi>t</mi></mrow></msub></mtd></mtr><mtr><mtd><msub><mi>𝐱</mi><mrow><mn>3</mn><mo>,</mo><mi>t</mi></mrow></msub></mtd></mtr><mtr><mtd><msub><mi>𝐪</mi><mi>t</mi></msub></mtd></mtr></mtable><mo>)</mo></mrow><mrow><mi>t</mi><mo>∈</mo><mrow><mo stretchy="false">[</mo><mi>T</mi><mo stretchy="false">]</mo></mrow></mrow></msub><mo lspace="0.167em" rspace="0em">​</mo><mtable displaystyle="true" rowspacing="0pt"><mtr><mtd class="ltx_align_left" columnalign="left"><mrow><mphantom></mphantom><mo>∈</mo><msup><mrow><mo stretchy="false">[</mo><mrow><mrow><mo>−</mo><mn>1</mn></mrow><mo>,</mo><mn>1</mn></mrow><mo stretchy="false">]</mo></mrow><msub><mi>d</mi><mn>1</mn></msub></msup></mrow></mtd></mtr><mtr><mtd class="ltx_align_left" columnalign="left"><mrow><mphantom></mphantom><mo>∈</mo><msup><mrow><mo stretchy="false">[</mo><mrow><mrow><mo>−</mo><mn>1</mn></mrow><mo>,</mo><mn>1</mn></mrow><mo stretchy="false">]</mo></mrow><msub><mi>d</mi><mn>2</mn></msub></msup></mrow></mtd></mtr><mtr><mtd class="ltx_align_left" columnalign="left"><mrow><mphantom></mphantom><mo>∈</mo><msup><mrow><mo stretchy="false">[</mo><mrow><mrow><mo>−</mo><mn>1</mn></mrow><mo>,</mo><mn>1</mn></mrow><mo stretchy="false">]</mo></mrow><msub><mi>d</mi><mn>3</mn></msub></msup></mrow></mtd></mtr><mtr><mtd class="ltx_align_left" columnalign="left"><mrow><mphantom></mphantom><mo>∈</mo><msup><mrow><mo stretchy="false">[</mo><mrow><mrow><mo>−</mo><mn>1</mn></mrow><mo>,</mo><mn>1</mn></mrow><mo stretchy="false">]</mo></mrow><mrow><mi>N</mi><mo>/</mo><mn>2</mn></mrow></msup></mrow></mtd></mtr></mtable></mrow><mo stretchy="false">⟼</mo><mphantom></mphantom></mrow></mrow><mspace style="width:1em;" width="1em"></mspace><msub><mrow><mo>(</mo><mtable displaystyle="true" rowspacing="0pt"><mtr><mtd><msub><mn>𝟎</mn><msub><mi>d</mi><mn>4</mn></msub></msub></mtd></mtr><mtr><mtd><msub><mi>𝐲</mi><mi>t</mi></msub></mtd></mtr><mtr><mtd><msub><mn>𝟎</mn><mrow><mi>N</mi><mo>−</mo><msub><mi>d</mi><mn>2</mn></msub><mo>−</mo><msub><mi>d</mi><mn>4</mn></msub></mrow></msub></mtd></mtr></mtable><mo>)</mo></mrow><mrow><mi>t</mi><mo>∈</mo><mrow><mo stretchy="false">[</mo><mi>T</mi><mo stretchy="false">]</mo></mrow></mrow></msub></mrow><annotation encoding="application/x-tex">\operatorname{SA}_{U,V}:\left(\begin{matrix}\mathbf{x}_{1,t}\\
\mathbf{x}_{2,t}\\
\mathbf{x}_{3,t}\\
\mathbf{q}_{t}\end{matrix}\right)_{t\in[T]}\begin{array}[]{l}\in[-1,1]^{d_{1}}\\
\in[-1,1]^{d_{2}}\\
\in[-1,1]^{d_{3}}\\
\in[-1,1]^{N/2}\end{array}\longmapsto\quad\left(\begin{matrix}\bm{0}_{d_{4}}\\
\mathbf{y}_{t}\\
\bm{0}_{N-d_{2}-d_{4}}\end{matrix}\right)_{t\in[T]}</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="Thmconj213.p1.2" class="ltx_p"><span id="Thmconj213.p1.2.1" class="ltx_text ltx_font_italic">with <math id="Thmconj213.p1.m6" class="ltx_Math" alttext="\mathbf{y}_{t}\in\mathbb{R}^{d_{2}}" display="inline" intent=":literal"><semantics><mrow><msub><mi>𝐲</mi><mi>t</mi></msub><mo>∈</mo><msup><mi>ℝ</mi><msub><mi>d</mi><mn>2</mn></msub></msup></mrow><annotation encoding="application/x-tex">\mathbf{y}_{t}\in\mathbb{R}^{d_{2}}</annotation></semantics></math>
satisfying</span></p>
<table id="A5.EGx91" class="ltx_equationgroup ltx_eqn_align ltx_eqn_table">

<tbody id="A5.E51"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_align_right ltx_eqn_cell"><math id="A5.E51.m1" class="ltx_Math" alttext="\displaystyle\big\|\mathbf{y}_{t}-\mathbf{x}_{2,t-r}\big\|_{\infty}\leq 2T^{1-\log T}\quad\text{ for }t\in\{r+1,\ldots,T\},\qquad\|\mathbf{y}_{t}\|_{\infty}\leq 1\quad\text{ for }t\in[T]." display="inline" intent=":literal"><semantics><mrow><mrow><mrow><msub><mrow><mo maxsize="1.200em" minsize="1.200em" stretchy="true">‖</mo><mrow><msub><mi>𝐲</mi><mi>t</mi></msub><mo>−</mo><msub><mi>𝐱</mi><mrow><mn>2</mn><mo>,</mo><mrow><mi>t</mi><mo>−</mo><mi>r</mi></mrow></mrow></msub></mrow><mo maxsize="1.200em" minsize="1.200em" stretchy="true">‖</mo></mrow><mi mathvariant="normal">∞</mi></msub><mo>≤</mo><mrow><mn>2</mn><mo lspace="0em" rspace="0em">​</mo><msup><mi>T</mi><mrow><mn>1</mn><mo>−</mo><mrow><mi>log</mi><mo lspace="0.167em">⁡</mo><mi>T</mi></mrow></mrow></msup></mrow></mrow><mspace style="width:1em;" width="1em"></mspace><mrow><mrow><mtext class="ltx_mathvariant_italic"> for </mtext><mo lspace="0em" rspace="0em">​</mo><mi>t</mi></mrow><mo>∈</mo><mrow><mo stretchy="false">{</mo><mrow><mrow><mi>r</mi><mo>+</mo><mn>1</mn></mrow><mo>,</mo><mi mathvariant="normal">…</mi><mo>,</mo><mi>T</mi></mrow><mo stretchy="false">}</mo></mrow></mrow><mo rspace="2.167em">,</mo><mrow><msub><mrow><mo stretchy="false">‖</mo><msub><mi>𝐲</mi><mi>t</mi></msub><mo stretchy="false">‖</mo></mrow><mi mathvariant="normal">∞</mi></msub><mo>≤</mo><mn>1</mn></mrow><mspace style="width:1em;" width="1em"></mspace><mrow><mrow><mtext class="ltx_mathvariant_italic"> for </mtext><mo lspace="0em" rspace="0em">​</mo><mi>t</mi></mrow><mo>∈</mo><mrow><mo stretchy="false">[</mo><mi>T</mi><mo stretchy="false">]</mo></mrow></mrow></mrow><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">\displaystyle\big\|\mathbf{y}_{t}-\mathbf{x}_{2,t-r}\big\|_{\infty}\leq 2T^{1-\log T}\quad\text{ for }t\in\{r+1,\ldots,T\},\qquad\|\mathbf{y}_{t}\|_{\infty}\leq 1\quad\text{ for }t\in[T].</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td>
<td rowspan="1" class="ltx_eqn_cell ltx_eqn_eqno ltx_align_middle ltx_align_right"><span class="ltx_tag ltx_tag_equation ltx_align_right">(51)</span></td></tr></tbody>
</table>
</div>
</div>
<div id="A5.SS1.3" class="ltx_proof">
<h6 class="ltx_title ltx_runin ltx_font_italic ltx_title_proof">Proof.</h6>
<div id="A5.SS1.p6" class="ltx_para">
<p id="A5.SS1.p6.1" class="ltx_p"><span id="A5.SS1.p6.1.1" class="ltx_text">For <math id="A5.SS1.p6.m1" class="ltx_Math" alttext="t\in[T]" display="inline" intent=":literal"><semantics><mrow><mi>t</mi><mo>∈</mo><mrow><mo stretchy="false">[</mo><mi>T</mi><mo stretchy="false">]</mo></mrow></mrow><annotation encoding="application/x-tex">t\in[T]</annotation></semantics></math>, we write <math id="A5.SS1.p6.m2" class="ltx_Math" alttext="\mathbf{x}_{t}\coloneq\operatorname{stack}(\mathbf{x}_{1,t},\mathbf{x}_{2,t},\mathbf{x}_{3,t},\mathbf{q}_{t})" display="inline" intent=":literal"><semantics><mrow><msub><mi>𝐱</mi><mi>t</mi></msub><mo>≔</mo><mrow><mi>stack</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><msub><mi>𝐱</mi><mrow><mn>1</mn><mo>,</mo><mi>t</mi></mrow></msub><mo>,</mo><msub><mi>𝐱</mi><mrow><mn>2</mn><mo>,</mo><mi>t</mi></mrow></msub><mo>,</mo><msub><mi>𝐱</mi><mrow><mn>3</mn><mo>,</mo><mi>t</mi></mrow></msub><mo>,</mo><msub><mi>𝐪</mi><mi>t</mi></msub><mo stretchy="false">)</mo></mrow></mrow></mrow><annotation encoding="application/x-tex">\mathbf{x}_{t}\coloneq\operatorname{stack}(\mathbf{x}_{1,t},\mathbf{x}_{2,t},\mathbf{x}_{3,t},\mathbf{q}_{t})</annotation></semantics></math>.
It is enough to show that there exist matrices <math id="A5.SS1.p6.m3" class="ltx_Math" alttext="U,V\in[-B,B]^{N\times N}" display="inline" intent=":literal"><semantics><mrow><mi>U</mi><mo>,</mo><mrow><mi>V</mi><mo>∈</mo><msup><mrow><mo stretchy="false">[</mo><mrow><mrow><mo>−</mo><mi>B</mi></mrow><mo>,</mo><mi>B</mi></mrow><mo stretchy="false">]</mo></mrow><mrow><mi>N</mi><mo lspace="0.222em" rspace="0.222em">×</mo><mi>N</mi></mrow></msup></mrow></mrow><annotation encoding="application/x-tex">U,V\in[-B,B]^{N\times N}</annotation></semantics></math> such that for any <math id="A5.SS1.p6.m4" class="ltx_Math" alttext="t\in[T]" display="inline" intent=":literal"><semantics><mrow><mi>t</mi><mo>∈</mo><mrow><mo stretchy="false">[</mo><mi>T</mi><mo stretchy="false">]</mo></mrow></mrow><annotation encoding="application/x-tex">t\in[T]</annotation></semantics></math>,</span></p>
<table id="A5.Ex181" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="A5.Ex181.m1" class="ltx_Math" alttext="\sum_{s=1}^{T}\frac{\exp(\mathbf{x}^{\top}_{s}U\mathbf{x}_{t})}{\sum_{j=1}^{T}\exp(\mathbf{x}^{\top}_{j}U\mathbf{x}_{t})}V\mathbf{x}_{s}=\left(\begin{matrix}\bm{0}_{d_{4}}\\
\mathbf{y}_{t}\\
\bm{0}_{N-d_{2}-d_{4}},\end{matrix}\right)" display="block" intent=":literal"><semantics><mrow><mrow><munderover><mo movablelimits="false">∑</mo><mrow><mi>s</mi><mo>=</mo><mn>1</mn></mrow><mi>T</mi></munderover><mrow><mfrac><mrow><mi>exp</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mrow><msubsup><mi>𝐱</mi><mi>s</mi><mo>⊤</mo></msubsup><mo lspace="0em" rspace="0em">​</mo><mi>U</mi><mo lspace="0em" rspace="0em">​</mo><msub><mi>𝐱</mi><mi>t</mi></msub></mrow><mo stretchy="false">)</mo></mrow></mrow><mrow><msubsup><mo>∑</mo><mrow><mi>j</mi><mo>=</mo><mn>1</mn></mrow><mi>T</mi></msubsup><mrow><mi>exp</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mrow><msubsup><mi>𝐱</mi><mi>j</mi><mo>⊤</mo></msubsup><mo lspace="0em" rspace="0em">​</mo><mi>U</mi><mo lspace="0em" rspace="0em">​</mo><msub><mi>𝐱</mi><mi>t</mi></msub></mrow><mo stretchy="false">)</mo></mrow></mrow></mrow></mfrac><mo lspace="0em" rspace="0em">​</mo><mi>V</mi><mo lspace="0em" rspace="0em">​</mo><msub><mi>𝐱</mi><mi>s</mi></msub></mrow></mrow><mo>=</mo><mrow><mo>(</mo><mtable displaystyle="true" rowspacing="0pt"><mtr><mtd><msub><mn>𝟎</mn><msub><mi>d</mi><mn>4</mn></msub></msub></mtd></mtr><mtr><mtd><msub><mi>𝐲</mi><mi>t</mi></msub></mtd></mtr><mtr><mtd><mrow><msub><mn>𝟎</mn><mrow><mi>N</mi><mo>−</mo><msub><mi>d</mi><mn>2</mn></msub><mo>−</mo><msub><mi>d</mi><mn>4</mn></msub></mrow></msub><mo>,</mo></mrow></mtd></mtr></mtable><mo>)</mo></mrow></mrow><annotation encoding="application/x-tex">\sum_{s=1}^{T}\frac{\exp(\mathbf{x}^{\top}_{s}U\mathbf{x}_{t})}{\sum_{j=1}^{T}\exp(\mathbf{x}^{\top}_{j}U\mathbf{x}_{t})}V\mathbf{x}_{s}=\left(\begin{matrix}\bm{0}_{d_{4}}\\
\mathbf{y}_{t}\\
\bm{0}_{N-d_{2}-d_{4}},\end{matrix}\right)</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="A5.SS1.p6.2" class="ltx_p"><span id="A5.SS1.p6.2.1" class="ltx_text">and (<a href="#A5.E51" title="In Lemma 13. ‣ E.1 Construction of multi-head self-attention layers ‣ Appendix E Construction of the Transformer ‣ Generalization Bounds for Transformer-Based Next-Token Prediction in a Language Model" class="ltx_ref"><span class="ltx_text ltx_ref_tag">51</span></a>) holds.
Recall that <math id="A5.SS1.p6.m5" class="ltx_Math" alttext="A\coloneq N/4" display="inline" intent=":literal"><semantics><mrow><mi>A</mi><mo>≔</mo><mrow><mi>N</mi><mo>/</mo><mn>4</mn></mrow></mrow><annotation encoding="application/x-tex">A\coloneq N/4</annotation></semantics></math> and that <math id="A5.SS1.p6.m6" class="ltx_Math" alttext="M_{a}" display="inline" intent=":literal"><semantics><msub><mi>M</mi><mi>a</mi></msub><annotation encoding="application/x-tex">M_{a}</annotation></semantics></math> is defined in (<a href="#A5.E49" title="In E.1 Construction of multi-head self-attention layers ‣ Appendix E Construction of the Transformer ‣ Generalization Bounds for Transformer-Based Next-Token Prediction in a Language Model" class="ltx_ref"><span class="ltx_text ltx_ref_tag">49</span></a>). For the matrix <math id="A5.SS1.p6.m7" class="ltx_Math" alttext="U\in\mathbb{R}^{N\times N}" display="inline" intent=":literal"><semantics><mrow><mi>U</mi><mo>∈</mo><msup><mi>ℝ</mi><mrow><mi>N</mi><mo lspace="0.222em" rspace="0.222em">×</mo><mi>N</mi></mrow></msup></mrow><annotation encoding="application/x-tex">U\in\mathbb{R}^{N\times N}</annotation></semantics></math>, we choose</span></p>
<table id="A5.Ex182" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="A5.Ex182.m1" class="ltx_Math" alttext="U\coloneq B\cdot\left[\begin{matrix}O_{2A\times 2A}&amp;O_{2A\times 2A}\\[10.00002pt]
O_{2A\times 2A}&amp;\left[\begin{matrix}M_{1}&amp;0&amp;\cdots&amp;0\\
0&amp;M_{2}&amp;\cdots&amp;0\\
\vdots&amp;\vdots&amp;\ddots&amp;\vdots\\
0&amp;0&amp;\cdots&amp;M_{A}\end{matrix}\right]\end{matrix}\right]\,," display="block" intent=":literal"><semantics><mrow><mrow><mi>U</mi><mo>≔</mo><mrow><mi>B</mi><mo lspace="0.222em" rspace="0.222em">⋅</mo><mrow><mo>[</mo><mtable columnspacing="5pt" displaystyle="true" rowspacing="0pt"><mtr><mtd><msub><mi>O</mi><mrow><mrow><mrow><mn>2</mn><mo lspace="0em" rspace="0em">​</mo><mi>A</mi></mrow><mo lspace="0.222em" rspace="0.222em">×</mo><mn>2</mn></mrow><mo lspace="0em" rspace="0em">​</mo><mi>A</mi></mrow></msub></mtd><mtd><msub><mi>O</mi><mrow><mrow><mrow><mn>2</mn><mo lspace="0em" rspace="0em">​</mo><mi>A</mi></mrow><mo lspace="0.222em" rspace="0.222em">×</mo><mn>2</mn></mrow><mo lspace="0em" rspace="0em">​</mo><mi>A</mi></mrow></msub></mtd></mtr><mtr><mtd><msub><mi>O</mi><mrow><mrow><mrow><mn>2</mn><mo lspace="0em" rspace="0em">​</mo><mi>A</mi></mrow><mo lspace="0.222em" rspace="0.222em">×</mo><mn>2</mn></mrow><mo lspace="0em" rspace="0em">​</mo><mi>A</mi></mrow></msub></mtd><mtd><mrow><mo>[</mo><mtable columnspacing="5pt" displaystyle="true" rowspacing="0pt"><mtr><mtd><msub><mi>M</mi><mn>1</mn></msub></mtd><mtd><mn>0</mn></mtd><mtd><mo>⋯</mo></mtd><mtd><mn>0</mn></mtd></mtr><mtr><mtd><mn>0</mn></mtd><mtd><msub><mi>M</mi><mn>2</mn></msub></mtd><mtd><mo>⋯</mo></mtd><mtd><mn>0</mn></mtd></mtr><mtr><mtd></mtd><mtd></mtd><mtd><mi mathvariant="normal">⋱</mi></mtd><mtd></mtd></mtr><mtr><mtd><mn>0</mn></mtd><mtd><mn>0</mn></mtd><mtd><mo>⋯</mo></mtd><mtd><msub><mi>M</mi><mi>A</mi></msub></mtd></mtr></mtable><mo>]</mo></mrow></mtd></mtr></mtable><mo rspace="0.170em">]</mo></mrow></mrow></mrow><mo>,</mo></mrow><annotation encoding="application/x-tex">U\coloneq B\cdot\left[\begin{matrix}O_{2A\times 2A}&amp;O_{2A\times 2A}\\[10.00002pt]
O_{2A\times 2A}&amp;\left[\begin{matrix}M_{1}&amp;0&amp;\cdots&amp;0\\
0&amp;M_{2}&amp;\cdots&amp;0\\
\vdots&amp;\vdots&amp;\ddots&amp;\vdots\\
0&amp;0&amp;\cdots&amp;M_{A}\end{matrix}\right]\end{matrix}\right]\,,</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="A5.SS1.p6.3" class="ltx_p"><span id="A5.SS1.p6.3.1" class="ltx_text">recalling that <math id="A5.SS1.p6.m8" class="ltx_Math" alttext="O_{p\times q}" display="inline" intent=":literal"><semantics><msub><mi>O</mi><mrow><mi>p</mi><mo lspace="0.222em" rspace="0.222em">×</mo><mi>q</mi></mrow></msub><annotation encoding="application/x-tex">O_{p\times q}</annotation></semantics></math> denotes the <math id="A5.SS1.p6.m9" class="ltx_Math" alttext="p\times q" display="inline" intent=":literal"><semantics><mrow><mi>p</mi><mo lspace="0.222em" rspace="0.222em">×</mo><mi>q</mi></mrow><annotation encoding="application/x-tex">p\times q</annotation></semantics></math> zero-matrix. By (<a href="#A5.E50" title="In E.1 Construction of multi-head self-attention layers ‣ Appendix E Construction of the Transformer ‣ Generalization Bounds for Transformer-Based Next-Token Prediction in a Language Model" class="ltx_ref"><span class="ltx_text ltx_ref_tag">50</span></a>), we have</span></p>
<table id="A5.Ex183" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="A5.Ex183.m1" class="ltx_Math" alttext="\mathbf{x}_{s}^{\top}U\mathbf{x}_{t}=B\mathbf{x}_{s}^{\top}\left(\begin{matrix}\bm{0}_{2A}\\
M_{1}\mathbf{q}_{1,t}\\
M_{2}\mathbf{q}_{2,t}\\
\vdots\\
M_{A}\mathbf{q}_{A,t}\end{matrix}\right)=B\mathbf{x}_{s}^{\top}\left(\begin{matrix}\bm{0}_{2A}\\
\mathbf{q}_{1,t-r}\\
\mathbf{q}_{2,t-r}\\
\vdots\\
\mathbf{q}_{A,t-r}\end{matrix}\right)=B\sum_{a=1}^{A}\mathbf{q}_{a,s}^{\top}\mathbf{q}_{a,t-r}" display="block" intent=":literal"><semantics><mrow><mrow><msubsup><mi>𝐱</mi><mi>s</mi><mo>⊤</mo></msubsup><mo lspace="0em" rspace="0em">​</mo><mi>U</mi><mo lspace="0em" rspace="0em">​</mo><msub><mi>𝐱</mi><mi>t</mi></msub></mrow><mo>=</mo><mrow><mi>B</mi><mo lspace="0em" rspace="0em">​</mo><msubsup><mi>𝐱</mi><mi>s</mi><mo>⊤</mo></msubsup><mo lspace="0em" rspace="0em">​</mo><mrow><mo>(</mo><mtable displaystyle="true" rowspacing="0pt"><mtr><mtd><msub><mn>𝟎</mn><mrow><mn>2</mn><mo lspace="0em" rspace="0em">​</mo><mi>A</mi></mrow></msub></mtd></mtr><mtr><mtd><mrow><msub><mi>M</mi><mn>1</mn></msub><mo lspace="0em" rspace="0em">​</mo><msub><mi>𝐪</mi><mrow><mn>1</mn><mo>,</mo><mi>t</mi></mrow></msub></mrow></mtd></mtr><mtr><mtd><mrow><msub><mi>M</mi><mn>2</mn></msub><mo lspace="0em" rspace="0em">​</mo><msub><mi>𝐪</mi><mrow><mn>2</mn><mo>,</mo><mi>t</mi></mrow></msub></mrow></mtd></mtr><mtr><mtd></mtd></mtr><mtr><mtd><mrow><msub><mi>M</mi><mi>A</mi></msub><mo lspace="0em" rspace="0em">​</mo><msub><mi>𝐪</mi><mrow><mi>A</mi><mo>,</mo><mi>t</mi></mrow></msub></mrow></mtd></mtr></mtable><mo>)</mo></mrow></mrow><mo>=</mo><mrow><mi>B</mi><mo lspace="0em" rspace="0em">​</mo><msubsup><mi>𝐱</mi><mi>s</mi><mo>⊤</mo></msubsup><mo lspace="0em" rspace="0em">​</mo><mrow><mo>(</mo><mtable displaystyle="true" rowspacing="0pt"><mtr><mtd><msub><mn>𝟎</mn><mrow><mn>2</mn><mo lspace="0em" rspace="0em">​</mo><mi>A</mi></mrow></msub></mtd></mtr><mtr><mtd><msub><mi>𝐪</mi><mrow><mn>1</mn><mo>,</mo><mrow><mi>t</mi><mo>−</mo><mi>r</mi></mrow></mrow></msub></mtd></mtr><mtr><mtd><msub><mi>𝐪</mi><mrow><mn>2</mn><mo>,</mo><mrow><mi>t</mi><mo>−</mo><mi>r</mi></mrow></mrow></msub></mtd></mtr><mtr><mtd></mtd></mtr><mtr><mtd><msub><mi>𝐪</mi><mrow><mi>A</mi><mo>,</mo><mrow><mi>t</mi><mo>−</mo><mi>r</mi></mrow></mrow></msub></mtd></mtr></mtable><mo>)</mo></mrow></mrow><mo>=</mo><mrow><mi>B</mi><mo lspace="0em" rspace="0em">​</mo><mrow><munderover><mo movablelimits="false">∑</mo><mrow><mi>a</mi><mo>=</mo><mn>1</mn></mrow><mi>A</mi></munderover><mrow><msubsup><mi>𝐪</mi><mrow><mi>a</mi><mo>,</mo><mi>s</mi></mrow><mo>⊤</mo></msubsup><mo lspace="0em" rspace="0em">​</mo><msub><mi>𝐪</mi><mrow><mi>a</mi><mo>,</mo><mrow><mi>t</mi><mo>−</mo><mi>r</mi></mrow></mrow></msub></mrow></mrow></mrow></mrow><annotation encoding="application/x-tex">\mathbf{x}_{s}^{\top}U\mathbf{x}_{t}=B\mathbf{x}_{s}^{\top}\left(\begin{matrix}\bm{0}_{2A}\\
M_{1}\mathbf{q}_{1,t}\\
M_{2}\mathbf{q}_{2,t}\\
\vdots\\
M_{A}\mathbf{q}_{A,t}\end{matrix}\right)=B\mathbf{x}_{s}^{\top}\left(\begin{matrix}\bm{0}_{2A}\\
\mathbf{q}_{1,t-r}\\
\mathbf{q}_{2,t-r}\\
\vdots\\
\mathbf{q}_{A,t-r}\end{matrix}\right)=B\sum_{a=1}^{A}\mathbf{q}_{a,s}^{\top}\mathbf{q}_{a,t-r}</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="A5.SS1.p6.4" class="ltx_p"><span id="A5.SS1.p6.4.1" class="ltx_text">for all <math id="A5.SS1.p6.m10" class="ltx_Math" alttext="t,s\in[T]" display="inline" intent=":literal"><semantics><mrow><mrow><mi>t</mi><mo>,</mo><mi>s</mi></mrow><mo>∈</mo><mrow><mo stretchy="false">[</mo><mi>T</mi><mo stretchy="false">]</mo></mrow></mrow><annotation encoding="application/x-tex">t,s\in[T]</annotation></semantics></math>.
For the matrix <math id="A5.SS1.p6.m11" class="ltx_Math" alttext="V\in\mathbb{R}^{N\times N}" display="inline" intent=":literal"><semantics><mrow><mi>V</mi><mo>∈</mo><msup><mi>ℝ</mi><mrow><mi>N</mi><mo lspace="0.222em" rspace="0.222em">×</mo><mi>N</mi></mrow></msup></mrow><annotation encoding="application/x-tex">V\in\mathbb{R}^{N\times N}</annotation></semantics></math>, we choose</span></p>
<table id="A5.Ex184" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="A5.Ex184.m1" class="ltx_Math" alttext="V\coloneq\left[\begin{matrix}O_{d_{4}\times d_{1}}&amp;O_{d_{4}\times d_{2}}&amp;O_{d_{4}\times(N-d_{1}-d_{2})}\\
O_{d_{2}\times d_{1}}&amp;I_{d_{2}}&amp;O_{d_{2}\times(N-d_{1}-d_{2})}\\
O_{(N-d_{2}-d_{4})\times d_{1}}&amp;O_{(N-d_{2}-d_{4})\times d_{2}}&amp;O_{(N-d_{2}-d_{4})\times(N-d_{1}-d_{2})}\end{matrix}\right]," display="block" intent=":literal"><semantics><mrow><mrow><mi>V</mi><mo>≔</mo><mrow><mo>[</mo><mtable columnspacing="5pt" displaystyle="true" rowspacing="0pt"><mtr><mtd><msub><mi>O</mi><mrow><msub><mi>d</mi><mn>4</mn></msub><mo lspace="0.222em" rspace="0.222em">×</mo><msub><mi>d</mi><mn>1</mn></msub></mrow></msub></mtd><mtd><msub><mi>O</mi><mrow><msub><mi>d</mi><mn>4</mn></msub><mo lspace="0.222em" rspace="0.222em">×</mo><msub><mi>d</mi><mn>2</mn></msub></mrow></msub></mtd><mtd><msub><mi>O</mi><mrow><msub><mi>d</mi><mn>4</mn></msub><mo lspace="0.222em" rspace="0.222em">×</mo><mrow><mo stretchy="false">(</mo><mrow><mi>N</mi><mo>−</mo><msub><mi>d</mi><mn>1</mn></msub><mo>−</mo><msub><mi>d</mi><mn>2</mn></msub></mrow><mo stretchy="false">)</mo></mrow></mrow></msub></mtd></mtr><mtr><mtd><msub><mi>O</mi><mrow><msub><mi>d</mi><mn>2</mn></msub><mo lspace="0.222em" rspace="0.222em">×</mo><msub><mi>d</mi><mn>1</mn></msub></mrow></msub></mtd><mtd><msub><mi>I</mi><msub><mi>d</mi><mn>2</mn></msub></msub></mtd><mtd><msub><mi>O</mi><mrow><msub><mi>d</mi><mn>2</mn></msub><mo lspace="0.222em" rspace="0.222em">×</mo><mrow><mo stretchy="false">(</mo><mrow><mi>N</mi><mo>−</mo><msub><mi>d</mi><mn>1</mn></msub><mo>−</mo><msub><mi>d</mi><mn>2</mn></msub></mrow><mo stretchy="false">)</mo></mrow></mrow></msub></mtd></mtr><mtr><mtd><msub><mi>O</mi><mrow><mrow><mo stretchy="false">(</mo><mrow><mi>N</mi><mo>−</mo><msub><mi>d</mi><mn>2</mn></msub><mo>−</mo><msub><mi>d</mi><mn>4</mn></msub></mrow><mo rspace="0.055em" stretchy="false">)</mo></mrow><mo rspace="0.222em">×</mo><msub><mi>d</mi><mn>1</mn></msub></mrow></msub></mtd><mtd><msub><mi>O</mi><mrow><mrow><mo stretchy="false">(</mo><mrow><mi>N</mi><mo>−</mo><msub><mi>d</mi><mn>2</mn></msub><mo>−</mo><msub><mi>d</mi><mn>4</mn></msub></mrow><mo rspace="0.055em" stretchy="false">)</mo></mrow><mo rspace="0.222em">×</mo><msub><mi>d</mi><mn>2</mn></msub></mrow></msub></mtd><mtd><msub><mi>O</mi><mrow><mrow><mo stretchy="false">(</mo><mrow><mi>N</mi><mo>−</mo><msub><mi>d</mi><mn>2</mn></msub><mo>−</mo><msub><mi>d</mi><mn>4</mn></msub></mrow><mo rspace="0.055em" stretchy="false">)</mo></mrow><mo rspace="0.222em">×</mo><mrow><mo stretchy="false">(</mo><mrow><mi>N</mi><mo>−</mo><msub><mi>d</mi><mn>1</mn></msub><mo>−</mo><msub><mi>d</mi><mn>2</mn></msub></mrow><mo stretchy="false">)</mo></mrow></mrow></msub></mtd></mtr></mtable><mo>]</mo></mrow></mrow><mo>,</mo></mrow><annotation encoding="application/x-tex">V\coloneq\left[\begin{matrix}O_{d_{4}\times d_{1}}&amp;O_{d_{4}\times d_{2}}&amp;O_{d_{4}\times(N-d_{1}-d_{2})}\\
O_{d_{2}\times d_{1}}&amp;I_{d_{2}}&amp;O_{d_{2}\times(N-d_{1}-d_{2})}\\
O_{(N-d_{2}-d_{4})\times d_{1}}&amp;O_{(N-d_{2}-d_{4})\times d_{2}}&amp;O_{(N-d_{2}-d_{4})\times(N-d_{1}-d_{2})}\end{matrix}\right],</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="A5.SS1.p6.5" class="ltx_p"><span id="A5.SS1.p6.5.1" class="ltx_text">which yields</span></p>
<table id="A5.Ex185" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="A5.Ex185.m1" class="ltx_Math" alttext="V\mathbf{x}_{s}=\left(\begin{matrix}\bm{0}_{d_{4}}\\
\mathbf{x}_{2,s}\\
\bm{0}_{N-d_{2}-d_{4}}\end{matrix}\right)." display="block" intent=":literal"><semantics><mrow><mrow><mrow><mi>V</mi><mo lspace="0em" rspace="0em">​</mo><msub><mi>𝐱</mi><mi>s</mi></msub></mrow><mo>=</mo><mrow><mo>(</mo><mtable displaystyle="true" rowspacing="0pt"><mtr><mtd><msub><mn>𝟎</mn><msub><mi>d</mi><mn>4</mn></msub></msub></mtd></mtr><mtr><mtd><msub><mi>𝐱</mi><mrow><mn>2</mn><mo>,</mo><mi>s</mi></mrow></msub></mtd></mtr><mtr><mtd><msub><mn>𝟎</mn><mrow><mi>N</mi><mo>−</mo><msub><mi>d</mi><mn>2</mn></msub><mo>−</mo><msub><mi>d</mi><mn>4</mn></msub></mrow></msub></mtd></mtr></mtable><mo>)</mo></mrow></mrow><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">V\mathbf{x}_{s}=\left(\begin{matrix}\bm{0}_{d_{4}}\\
\mathbf{x}_{2,s}\\
\bm{0}_{N-d_{2}-d_{4}}\end{matrix}\right).</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="A5.SS1.p6.6" class="ltx_p"><span id="A5.SS1.p6.6.1" class="ltx_text">First, observe that</span></p>
<table id="A5.EGx92" class="ltx_equationgroup ltx_eqn_align ltx_eqn_table">

<tbody id="A5.Ex186"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_align_right ltx_eqn_cell"><math id="A5.Ex186.m1" class="ltx_Math" alttext="\displaystyle\sum_{s=1}^{T}\frac{\exp(\mathbf{x}^{\top}_{s}U\mathbf{x}_{t})}{\sum_{j=1}^{T}\exp(\mathbf{x}^{\top}_{j}U\mathbf{x}_{t})}V\mathbf{x}_{s}=\sum_{s=1}^{T}\frac{\exp(\mathbf{x}^{\top}_{s}U\mathbf{x}_{t})}{\sum_{j=1}^{T}\exp(\mathbf{x}^{\top}_{j}U\mathbf{x}_{t})}\left(\begin{matrix}\bm{0}_{d_{4}}\\
\mathbf{x}_{2,s}\\
\bm{0}_{N-d_{2}-d_{4}}\end{matrix}\right)=\left(\begin{matrix}\bm{0}_{d_{4}}\\
\sum_{s=1}^{T}\frac{\exp(\mathbf{x}^{\top}_{s}U\mathbf{x}_{t})}{\sum_{j=1}^{T}\exp(\mathbf{x}^{\top}_{j}U\mathbf{x}_{t})}\mathbf{x}_{2,s}\\
\bm{0}_{N-d_{2}-d_{4}}\end{matrix}\right)." display="inline" intent=":literal"><semantics><mrow><mrow><mrow><mstyle displaystyle="true"><munderover><mo movablelimits="false">∑</mo><mrow><mi>s</mi><mo>=</mo><mn>1</mn></mrow><mi>T</mi></munderover></mstyle><mrow><mstyle displaystyle="true"><mfrac><mrow><mi>exp</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mrow><msubsup><mi>𝐱</mi><mi>s</mi><mo>⊤</mo></msubsup><mo lspace="0em" rspace="0em">​</mo><mi>U</mi><mo lspace="0em" rspace="0em">​</mo><msub><mi>𝐱</mi><mi>t</mi></msub></mrow><mo stretchy="false">)</mo></mrow></mrow><mrow><msubsup><mo>∑</mo><mrow><mi>j</mi><mo>=</mo><mn>1</mn></mrow><mi>T</mi></msubsup><mrow><mi>exp</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mrow><msubsup><mi>𝐱</mi><mi>j</mi><mo>⊤</mo></msubsup><mo lspace="0em" rspace="0em">​</mo><mi>U</mi><mo lspace="0em" rspace="0em">​</mo><msub><mi>𝐱</mi><mi>t</mi></msub></mrow><mo stretchy="false">)</mo></mrow></mrow></mrow></mfrac></mstyle><mo lspace="0em" rspace="0em">​</mo><mi>V</mi><mo lspace="0em" rspace="0em">​</mo><msub><mi>𝐱</mi><mi>s</mi></msub></mrow></mrow><mo>=</mo><mrow><mstyle displaystyle="true"><munderover><mo movablelimits="false">∑</mo><mrow><mi>s</mi><mo>=</mo><mn>1</mn></mrow><mi>T</mi></munderover></mstyle><mrow><mstyle displaystyle="true"><mfrac><mrow><mi>exp</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mrow><msubsup><mi>𝐱</mi><mi>s</mi><mo>⊤</mo></msubsup><mo lspace="0em" rspace="0em">​</mo><mi>U</mi><mo lspace="0em" rspace="0em">​</mo><msub><mi>𝐱</mi><mi>t</mi></msub></mrow><mo stretchy="false">)</mo></mrow></mrow><mrow><msubsup><mo>∑</mo><mrow><mi>j</mi><mo>=</mo><mn>1</mn></mrow><mi>T</mi></msubsup><mrow><mi>exp</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mrow><msubsup><mi>𝐱</mi><mi>j</mi><mo>⊤</mo></msubsup><mo lspace="0em" rspace="0em">​</mo><mi>U</mi><mo lspace="0em" rspace="0em">​</mo><msub><mi>𝐱</mi><mi>t</mi></msub></mrow><mo stretchy="false">)</mo></mrow></mrow></mrow></mfrac></mstyle><mo lspace="0em" rspace="0em">​</mo><mrow><mo>(</mo><mtable rowspacing="0pt"><mtr><mtd><msub><mn>𝟎</mn><msub><mi>d</mi><mn>4</mn></msub></msub></mtd></mtr><mtr><mtd><msub><mi>𝐱</mi><mrow><mn>2</mn><mo>,</mo><mi>s</mi></mrow></msub></mtd></mtr><mtr><mtd><msub><mn>𝟎</mn><mrow><mi>N</mi><mo>−</mo><msub><mi>d</mi><mn>2</mn></msub><mo>−</mo><msub><mi>d</mi><mn>4</mn></msub></mrow></msub></mtd></mtr></mtable><mo>)</mo></mrow></mrow></mrow><mo>=</mo><mrow><mo>(</mo><mtable rowspacing="0pt"><mtr><mtd><msub><mn>𝟎</mn><msub><mi>d</mi><mn>4</mn></msub></msub></mtd></mtr><mtr><mtd><mrow><msubsup><mo>∑</mo><mrow><mi>s</mi><mo>=</mo><mn>1</mn></mrow><mi>T</mi></msubsup><mrow><mfrac><mrow><mi>exp</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mrow><msubsup><mi>𝐱</mi><mi>s</mi><mo>⊤</mo></msubsup><mo lspace="0em" rspace="0em">​</mo><mi>U</mi><mo lspace="0em" rspace="0em">​</mo><msub><mi>𝐱</mi><mi>t</mi></msub></mrow><mo stretchy="false">)</mo></mrow></mrow><mrow><mstyle displaystyle="false"><msubsup><mo maxsize="0.700em" minsize="0.700em" stretchy="true">∑</mo><mrow><mi>j</mi><mo>=</mo><mn>1</mn></mrow><mi>T</mi></msubsup></mstyle><mrow><mi>exp</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mrow><msubsup><mi>𝐱</mi><mi>j</mi><mo>⊤</mo></msubsup><mo lspace="0em" rspace="0em">​</mo><mi>U</mi><mo lspace="0em" rspace="0em">​</mo><msub><mi>𝐱</mi><mi>t</mi></msub></mrow><mo stretchy="false">)</mo></mrow></mrow></mrow></mfrac><mo lspace="0em" rspace="0em">​</mo><msub><mi>𝐱</mi><mrow><mn>2</mn><mo>,</mo><mi>s</mi></mrow></msub></mrow></mrow></mtd></mtr><mtr><mtd><msub><mn>𝟎</mn><mrow><mi>N</mi><mo>−</mo><msub><mi>d</mi><mn>2</mn></msub><mo>−</mo><msub><mi>d</mi><mn>4</mn></msub></mrow></msub></mtd></mtr></mtable><mo>)</mo></mrow></mrow><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">\displaystyle\sum_{s=1}^{T}\frac{\exp(\mathbf{x}^{\top}_{s}U\mathbf{x}_{t})}{\sum_{j=1}^{T}\exp(\mathbf{x}^{\top}_{j}U\mathbf{x}_{t})}V\mathbf{x}_{s}=\sum_{s=1}^{T}\frac{\exp(\mathbf{x}^{\top}_{s}U\mathbf{x}_{t})}{\sum_{j=1}^{T}\exp(\mathbf{x}^{\top}_{j}U\mathbf{x}_{t})}\left(\begin{matrix}\bm{0}_{d_{4}}\\
\mathbf{x}_{2,s}\\
\bm{0}_{N-d_{2}-d_{4}}\end{matrix}\right)=\left(\begin{matrix}\bm{0}_{d_{4}}\\
\sum_{s=1}^{T}\frac{\exp(\mathbf{x}^{\top}_{s}U\mathbf{x}_{t})}{\sum_{j=1}^{T}\exp(\mathbf{x}^{\top}_{j}U\mathbf{x}_{t})}\mathbf{x}_{2,s}\\
\bm{0}_{N-d_{2}-d_{4}}\end{matrix}\right).</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="A5.SS1.p6.7" class="ltx_p"><span id="A5.SS1.p6.7.1" class="ltx_text">For every <math id="A5.SS1.p6.m12" class="ltx_Math" alttext="t\in[T]" display="inline" intent=":literal"><semantics><mrow><mi>t</mi><mo>∈</mo><mrow><mo stretchy="false">[</mo><mi>T</mi><mo stretchy="false">]</mo></mrow></mrow><annotation encoding="application/x-tex">t\in[T]</annotation></semantics></math>, we have</span></p>
<table id="A5.EGx93" class="ltx_equationgroup ltx_eqn_align ltx_eqn_table">

<tbody id="A5.Ex187"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_align_right ltx_eqn_cell"><math id="A5.Ex187.m1" class="ltx_Math" alttext="\displaystyle\left\|\sum_{s=1}^{T}\frac{\exp(\mathbf{x}^{\top}_{s}U\mathbf{x}_{t})}{\sum_{j=1}^{T}\exp(\mathbf{x}^{\top}_{j}U\mathbf{x}_{t})}\mathbf{x}_{2,s}\right\|_{\infty}\leq\sum_{s=1}^{T}\frac{\exp(\mathbf{x}^{\top}_{s}U\mathbf{x}_{t})}{\sum_{j=1}^{T}\exp(\mathbf{x}^{\top}_{j}U\mathbf{x}_{t})}\|\mathbf{x}_{2,s}\|_{\infty}\leq 1," display="inline" intent=":literal"><semantics><mrow><mrow><msub><mrow><mo>‖</mo><mrow><mstyle displaystyle="true"><munderover><mo movablelimits="false">∑</mo><mrow><mi>s</mi><mo>=</mo><mn>1</mn></mrow><mi>T</mi></munderover></mstyle><mrow><mstyle displaystyle="true"><mfrac><mrow><mi>exp</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mrow><msubsup><mi>𝐱</mi><mi>s</mi><mo>⊤</mo></msubsup><mo lspace="0em" rspace="0em">​</mo><mi>U</mi><mo lspace="0em" rspace="0em">​</mo><msub><mi>𝐱</mi><mi>t</mi></msub></mrow><mo stretchy="false">)</mo></mrow></mrow><mrow><msubsup><mo>∑</mo><mrow><mi>j</mi><mo>=</mo><mn>1</mn></mrow><mi>T</mi></msubsup><mrow><mi>exp</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mrow><msubsup><mi>𝐱</mi><mi>j</mi><mo>⊤</mo></msubsup><mo lspace="0em" rspace="0em">​</mo><mi>U</mi><mo lspace="0em" rspace="0em">​</mo><msub><mi>𝐱</mi><mi>t</mi></msub></mrow><mo stretchy="false">)</mo></mrow></mrow></mrow></mfrac></mstyle><mo lspace="0em" rspace="0em">​</mo><msub><mi>𝐱</mi><mrow><mn>2</mn><mo>,</mo><mi>s</mi></mrow></msub></mrow></mrow><mo>‖</mo></mrow><mi mathvariant="normal">∞</mi></msub><mo>≤</mo><mrow><mstyle displaystyle="true"><munderover><mo movablelimits="false">∑</mo><mrow><mi>s</mi><mo>=</mo><mn>1</mn></mrow><mi>T</mi></munderover></mstyle><mrow><mstyle displaystyle="true"><mfrac><mrow><mi>exp</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mrow><msubsup><mi>𝐱</mi><mi>s</mi><mo>⊤</mo></msubsup><mo lspace="0em" rspace="0em">​</mo><mi>U</mi><mo lspace="0em" rspace="0em">​</mo><msub><mi>𝐱</mi><mi>t</mi></msub></mrow><mo stretchy="false">)</mo></mrow></mrow><mrow><msubsup><mo>∑</mo><mrow><mi>j</mi><mo>=</mo><mn>1</mn></mrow><mi>T</mi></msubsup><mrow><mi>exp</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mrow><msubsup><mi>𝐱</mi><mi>j</mi><mo>⊤</mo></msubsup><mo lspace="0em" rspace="0em">​</mo><mi>U</mi><mo lspace="0em" rspace="0em">​</mo><msub><mi>𝐱</mi><mi>t</mi></msub></mrow><mo stretchy="false">)</mo></mrow></mrow></mrow></mfrac></mstyle><mo lspace="0em" rspace="0em">​</mo><msub><mrow><mo stretchy="false">‖</mo><msub><mi>𝐱</mi><mrow><mn>2</mn><mo>,</mo><mi>s</mi></mrow></msub><mo stretchy="false">‖</mo></mrow><mi mathvariant="normal">∞</mi></msub></mrow></mrow><mo>≤</mo><mn>1</mn></mrow><mo>,</mo></mrow><annotation encoding="application/x-tex">\displaystyle\left\|\sum_{s=1}^{T}\frac{\exp(\mathbf{x}^{\top}_{s}U\mathbf{x}_{t})}{\sum_{j=1}^{T}\exp(\mathbf{x}^{\top}_{j}U\mathbf{x}_{t})}\mathbf{x}_{2,s}\right\|_{\infty}\leq\sum_{s=1}^{T}\frac{\exp(\mathbf{x}^{\top}_{s}U\mathbf{x}_{t})}{\sum_{j=1}^{T}\exp(\mathbf{x}^{\top}_{j}U\mathbf{x}_{t})}\|\mathbf{x}_{2,s}\|_{\infty}\leq 1,</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="A5.SS1.p6.8" class="ltx_p"><span id="A5.SS1.p6.8.1" class="ltx_text">which yields the second assertion.
Now we assume <math id="A5.SS1.p6.m13" class="ltx_Math" alttext="t\in\{r+1,\ldots,T\}" display="inline" intent=":literal"><semantics><mrow><mi>t</mi><mo>∈</mo><mrow><mo stretchy="false">{</mo><mrow><mrow><mi>r</mi><mo>+</mo><mn>1</mn></mrow><mo>,</mo><mi mathvariant="normal">…</mi><mo>,</mo><mi>T</mi></mrow><mo stretchy="false">}</mo></mrow></mrow><annotation encoding="application/x-tex">t\in\{r+1,\ldots,T\}</annotation></semantics></math> and derive the first assertion.
If <math id="A5.SS1.p6.m14" class="ltx_Math" alttext="s=t-r" display="inline" intent=":literal"><semantics><mrow><mi>s</mi><mo>=</mo><mrow><mi>t</mi><mo>−</mo><mi>r</mi></mrow></mrow><annotation encoding="application/x-tex">s=t-r</annotation></semantics></math>, we have by Lemma <a href="#Thmconj212" title="Lemma 12. ‣ E.1 Construction of multi-head self-attention layers ‣ Appendix E Construction of the Transformer ‣ Generalization Bounds for Transformer-Based Next-Token Prediction in a Language Model" class="ltx_ref"><span class="ltx_text ltx_ref_tag">12</span></a>,</span></p>
<table id="A5.EGx94" class="ltx_equationgroup ltx_eqn_align ltx_eqn_table">

<tbody id="A5.Ex188"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_align_right ltx_eqn_cell"><math id="A5.Ex188.m1" class="ltx_Math" alttext="\displaystyle\frac{\exp(\mathbf{x}^{\top}_{s}U\mathbf{x}_{t})}{\sum_{j=1}^{T}\exp(\mathbf{x}^{\top}_{j}U\mathbf{x}_{t})}" display="inline" intent=":literal"><semantics><mstyle displaystyle="true"><mfrac><mrow><mi>exp</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mrow><msubsup><mi>𝐱</mi><mi>s</mi><mo>⊤</mo></msubsup><mo lspace="0em" rspace="0em">​</mo><mi>U</mi><mo lspace="0em" rspace="0em">​</mo><msub><mi>𝐱</mi><mi>t</mi></msub></mrow><mo stretchy="false">)</mo></mrow></mrow><mrow><msubsup><mo>∑</mo><mrow><mi>j</mi><mo>=</mo><mn>1</mn></mrow><mi>T</mi></msubsup><mrow><mi>exp</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mrow><msubsup><mi>𝐱</mi><mi>j</mi><mo>⊤</mo></msubsup><mo lspace="0em" rspace="0em">​</mo><mi>U</mi><mo lspace="0em" rspace="0em">​</mo><msub><mi>𝐱</mi><mi>t</mi></msub></mrow><mo stretchy="false">)</mo></mrow></mrow></mrow></mfrac></mstyle><annotation encoding="application/x-tex">\displaystyle\frac{\exp(\mathbf{x}^{\top}_{s}U\mathbf{x}_{t})}{\sum_{j=1}^{T}\exp(\mathbf{x}^{\top}_{j}U\mathbf{x}_{t})}</annotation></semantics></math></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A5.Ex188.m2" class="ltx_Math" alttext="\displaystyle=\frac{\exp\big(B\sum_{a=1}^{A}\mathbf{q}_{a,s}^{\top}\mathbf{q}_{a,t-r}\big)}{\sum_{j=1}^{T}\exp\big(B\sum_{a=1}^{A}\mathbf{q}_{a,j}^{\top}\mathbf{q}_{a,t-r}\big)}" display="inline" intent=":literal"><semantics><mrow><mphantom></mphantom><mo>=</mo><mstyle displaystyle="true"><mfrac><mrow><mi>exp</mi><mo>⁡</mo><mrow><mo maxsize="1.200em" minsize="1.200em">(</mo><mrow><mi>B</mi><mo lspace="0em" rspace="0em">​</mo><mrow><msubsup><mo>∑</mo><mrow><mi>a</mi><mo>=</mo><mn>1</mn></mrow><mi>A</mi></msubsup><mrow><msubsup><mi>𝐪</mi><mrow><mi>a</mi><mo>,</mo><mi>s</mi></mrow><mo>⊤</mo></msubsup><mo lspace="0em" rspace="0em">​</mo><msub><mi>𝐪</mi><mrow><mi>a</mi><mo>,</mo><mrow><mi>t</mi><mo>−</mo><mi>r</mi></mrow></mrow></msub></mrow></mrow></mrow><mo maxsize="1.200em" minsize="1.200em">)</mo></mrow></mrow><mrow><msubsup><mo>∑</mo><mrow><mi>j</mi><mo>=</mo><mn>1</mn></mrow><mi>T</mi></msubsup><mrow><mi>exp</mi><mo>⁡</mo><mrow><mo maxsize="1.200em" minsize="1.200em">(</mo><mrow><mi>B</mi><mo lspace="0em" rspace="0em">​</mo><mrow><msubsup><mo>∑</mo><mrow><mi>a</mi><mo>=</mo><mn>1</mn></mrow><mi>A</mi></msubsup><mrow><msubsup><mi>𝐪</mi><mrow><mi>a</mi><mo>,</mo><mi>j</mi></mrow><mo>⊤</mo></msubsup><mo lspace="0em" rspace="0em">​</mo><msub><mi>𝐪</mi><mrow><mi>a</mi><mo>,</mo><mrow><mi>t</mi><mo>−</mo><mi>r</mi></mrow></mrow></msub></mrow></mrow></mrow><mo maxsize="1.200em" minsize="1.200em">)</mo></mrow></mrow></mrow></mfrac></mstyle></mrow><annotation encoding="application/x-tex">\displaystyle=\frac{\exp\big(B\sum_{a=1}^{A}\mathbf{q}_{a,s}^{\top}\mathbf{q}_{a,t-r}\big)}{\sum_{j=1}^{T}\exp\big(B\sum_{a=1}^{A}\mathbf{q}_{a,j}^{\top}\mathbf{q}_{a,t-r}\big)}</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
<tbody id="A5.Ex189"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_eqn_cell"></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A5.Ex189.m1" class="ltx_Math" alttext="\displaystyle\geq\frac{\exp\big(BA\big)}{\exp\big(BA\big)+(T-1)\exp\Big(B\big(A-\frac{1}{3T^{2/A}}\big)\Big)}" display="inline" intent=":literal"><semantics><mrow><mphantom></mphantom><mo>≥</mo><mstyle displaystyle="true"><mfrac><mrow><mi>exp</mi><mo>⁡</mo><mrow><mo maxsize="1.200em" minsize="1.200em">(</mo><mrow><mi>B</mi><mo lspace="0em" rspace="0em">​</mo><mi>A</mi></mrow><mo maxsize="1.200em" minsize="1.200em">)</mo></mrow></mrow><mrow><mrow><mi>exp</mi><mo>⁡</mo><mrow><mo maxsize="1.200em" minsize="1.200em">(</mo><mrow><mi>B</mi><mo lspace="0em" rspace="0em">​</mo><mi>A</mi></mrow><mo maxsize="1.200em" minsize="1.200em">)</mo></mrow></mrow><mo>+</mo><mrow><mrow><mo stretchy="false">(</mo><mrow><mi>T</mi><mo>−</mo><mn>1</mn></mrow><mo stretchy="false">)</mo></mrow><mo lspace="0.167em" rspace="0em">​</mo><mrow><mi>exp</mi><mo>⁡</mo><mrow><mo maxsize="1.600em" minsize="1.600em">(</mo><mrow><mi>B</mi><mo>⁡</mo><mrow><mo maxsize="1.200em" minsize="1.200em">(</mo><mrow><mi>A</mi><mo>−</mo><mfrac><mn>1</mn><mrow><mn>3</mn><mo lspace="0em" rspace="0em">​</mo><msup><mi>T</mi><mrow><mn>2</mn><mo>/</mo><mi>A</mi></mrow></msup></mrow></mfrac></mrow><mo maxsize="1.200em" minsize="1.200em">)</mo></mrow></mrow><mo maxsize="1.600em" minsize="1.600em">)</mo></mrow></mrow></mrow></mrow></mfrac></mstyle></mrow><annotation encoding="application/x-tex">\displaystyle\geq\frac{\exp\big(BA\big)}{\exp\big(BA\big)+(T-1)\exp\Big(B\big(A-\frac{1}{3T^{2/A}}\big)\Big)}</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
<tbody id="A5.Ex190"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_eqn_cell"></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A5.Ex190.m1" class="ltx_Math" alttext="\displaystyle\geq\frac{1}{1+T\exp\big(-B/(3T^{2/A})\big)}" display="inline" intent=":literal"><semantics><mrow><mphantom></mphantom><mo>≥</mo><mstyle displaystyle="true"><mfrac><mn>1</mn><mrow><mn>1</mn><mo>+</mo><mi>T</mi><mi>exp</mi><mo maxsize="1.200em" minsize="1.200em">(</mo><mo lspace="0em">−</mo><mi>B</mi><mo>/</mo><mo stretchy="false">(</mo><mn>3</mn><mi>T</mi><msup><mrow></mrow><mrow><mn>2</mn><mo>/</mo><mi>A</mi></mrow></msup><mo stretchy="false">)</mo><mo maxsize="1.200em" minsize="1.200em">)</mo></mrow></mfrac></mstyle></mrow><annotation encoding="application/x-tex">\displaystyle\geq\frac{1}{1+T\exp\big(-B/(3T^{2/A})\big)}</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
<tbody id="A5.Ex191"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_eqn_cell"></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A5.Ex191.m1" class="ltx_Math" alttext="\displaystyle\geq 1-T\exp\Big(-\frac{B}{3T^{2/A}}\Big)" display="inline" intent=":literal"><semantics><mrow><mphantom></mphantom><mo>≥</mo><mrow><mn>1</mn><mo>−</mo><mrow><mi>T</mi><mo lspace="0.167em" rspace="0em">​</mo><mrow><mi>exp</mi><mo>⁡</mo><mrow><mo maxsize="1.600em" minsize="1.600em">(</mo><mrow><mo>−</mo><mstyle displaystyle="true"><mfrac><mi>B</mi><mrow><mn>3</mn><mo lspace="0em" rspace="0em">​</mo><msup><mi>T</mi><mrow><mn>2</mn><mo>/</mo><mi>A</mi></mrow></msup></mrow></mfrac></mstyle></mrow><mo maxsize="1.600em" minsize="1.600em">)</mo></mrow></mrow></mrow></mrow></mrow><annotation encoding="application/x-tex">\displaystyle\geq 1-T\exp\Big(-\frac{B}{3T^{2/A}}\Big)</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
<tbody id="A5.Ex192"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_eqn_cell"></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A5.Ex192.m1" class="ltx_Math" alttext="\displaystyle\geq 1-T\exp\left(-\frac{B}{3T^{1/\log T}}\right)" display="inline" intent=":literal"><semantics><mrow><mphantom></mphantom><mo>≥</mo><mrow><mn>1</mn><mo>−</mo><mrow><mi>T</mi><mo lspace="0.167em" rspace="0em">​</mo><mrow><mi>exp</mi><mo>⁡</mo><mrow><mo>(</mo><mrow><mo>−</mo><mstyle displaystyle="true"><mfrac><mi>B</mi><mrow><mn>3</mn><mo lspace="0em" rspace="0em">​</mo><msup><mi>T</mi><mrow><mn>1</mn><mo>/</mo><mrow><mi>log</mi><mo lspace="0.167em">⁡</mo><mi>T</mi></mrow></mrow></msup></mrow></mfrac></mstyle></mrow><mo>)</mo></mrow></mrow></mrow></mrow></mrow><annotation encoding="application/x-tex">\displaystyle\geq 1-T\exp\left(-\frac{B}{3T^{1/\log T}}\right)</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
<tbody id="A5.Ex193"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_eqn_cell"></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A5.Ex193.m1" class="ltx_Math" alttext="\displaystyle=1-T\exp\left(-\frac{B}{3e}\right)" display="inline" intent=":literal"><semantics><mrow><mphantom></mphantom><mo>=</mo><mrow><mn>1</mn><mo>−</mo><mrow><mi>T</mi><mo lspace="0.167em" rspace="0em">​</mo><mrow><mi>exp</mi><mo>⁡</mo><mrow><mo>(</mo><mrow><mo>−</mo><mstyle displaystyle="true"><mfrac><mi>B</mi><mrow><mn>3</mn><mo lspace="0em" rspace="0em">​</mo><mi>e</mi></mrow></mfrac></mstyle></mrow><mo>)</mo></mrow></mrow></mrow></mrow></mrow><annotation encoding="application/x-tex">\displaystyle=1-T\exp\left(-\frac{B}{3e}\right)</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
<tbody id="A5.Ex194"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_eqn_cell"></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A5.Ex194.m1" class="ltx_Math" alttext="\displaystyle\geq 1-T\exp\left(-\log^{2}T\right)" display="inline" intent=":literal"><semantics><mrow><mphantom></mphantom><mo>≥</mo><mrow><mn>1</mn><mo>−</mo><mrow><mi>T</mi><mo lspace="0.167em" rspace="0em">​</mo><mrow><mi>exp</mi><mo>⁡</mo><mrow><mo>(</mo><mrow><mo rspace="0.167em">−</mo><mrow><msup><mi>log</mi><mn>2</mn></msup><mo lspace="0.167em">⁡</mo><mi>T</mi></mrow></mrow><mo>)</mo></mrow></mrow></mrow></mrow></mrow><annotation encoding="application/x-tex">\displaystyle\geq 1-T\exp\left(-\log^{2}T\right)</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
<tbody id="A5.E52"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_eqn_cell"></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A5.E52.m1" class="ltx_Math" alttext="\displaystyle=1-T^{1-\log T}," display="inline" intent=":literal"><semantics><mrow><mrow><mphantom></mphantom><mo>=</mo><mrow><mn>1</mn><mo>−</mo><msup><mi>T</mi><mrow><mn>1</mn><mo>−</mo><mrow><mi>log</mi><mo lspace="0.167em">⁡</mo><mi>T</mi></mrow></mrow></msup></mrow></mrow><mo>,</mo></mrow><annotation encoding="application/x-tex">\displaystyle=1-T^{1-\log T},</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td>
<td rowspan="1" class="ltx_eqn_cell ltx_eqn_eqno ltx_align_middle ltx_align_right"><span class="ltx_tag ltx_tag_equation ltx_align_right">(52)</span></td></tr></tbody>
</table>
<p id="A5.SS1.p6.9" class="ltx_p"><span id="A5.SS1.p6.9.1" class="ltx_text">provided that <math id="A5.SS1.p6.m15" class="ltx_Math" alttext="A=N/4\geq 2\log T" display="inline" intent=":literal"><semantics><mrow><mi>A</mi><mo>=</mo><mrow><mi>N</mi><mo>/</mo><mn>4</mn></mrow><mo>≥</mo><mrow><mn>2</mn><mo lspace="0.167em" rspace="0em">​</mo><mrow><mi>log</mi><mo lspace="0.167em">⁡</mo><mi>T</mi></mrow></mrow></mrow><annotation encoding="application/x-tex">A=N/4\geq 2\log T</annotation></semantics></math> and <math id="A5.SS1.p6.m16" class="ltx_Math" alttext="B\geq 9\log^{2}T&gt;3e\log^{2}T" display="inline" intent=":literal"><semantics><mrow><mi>B</mi><mo>≥</mo><mrow><mn>9</mn><mo lspace="0.167em" rspace="0em">​</mo><msup><mi>log</mi><mn>2</mn></msup><mo lspace="0.167em" rspace="0em">​</mo><mi>T</mi></mrow><mo>&gt;</mo><mrow><mn>3</mn><mo lspace="0em" rspace="0em">​</mo><mi>e</mi><mo lspace="0.167em" rspace="0em">​</mo><msup><mi>log</mi><mn>2</mn></msup><mo lspace="0.167em" rspace="0em">​</mo><mi>T</mi></mrow></mrow><annotation encoding="application/x-tex">B\geq 9\log^{2}T&gt;3e\log^{2}T</annotation></semantics></math>. Similarly, if <math id="A5.SS1.p6.m17" class="ltx_Math" alttext="s\neq t-r" display="inline" intent=":literal"><semantics><mrow><mi>s</mi><mo>≠</mo><mrow><mi>t</mi><mo>−</mo><mi>r</mi></mrow></mrow><annotation encoding="application/x-tex">s\neq t-r</annotation></semantics></math>, we have</span></p>
<table id="A5.EGx95" class="ltx_equationgroup ltx_eqn_align ltx_eqn_table">

<tbody id="A5.E53"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_align_right ltx_eqn_cell"><math id="A5.E53.m1" class="ltx_Math" alttext="\displaystyle\frac{\exp(\mathbf{x}^{\top}_{s}U\mathbf{x}_{t})}{\sum_{j=1}^{T}\exp(\mathbf{x}^{\top}_{j}U\mathbf{x}_{t})}=\frac{\exp\big(B\sum_{a=1}^{A}\mathbf{q}_{a,s}^{\top}\mathbf{q}_{a,t-r}\big)}{\sum_{j=1}^{T}\exp\big(B\sum_{a=1}^{A}\mathbf{q}_{a,j}^{\top}\mathbf{q}_{a,t-r}\big)}\leq\frac{\exp\Big(B\big(A-\frac{1}{3T^{2/A}}\big)\Big)}{\exp(BA)}\leq T^{-\log T}." display="inline" intent=":literal"><semantics><mrow><mrow><mstyle displaystyle="true"><mfrac><mrow><mi>exp</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mrow><msubsup><mi>𝐱</mi><mi>s</mi><mo>⊤</mo></msubsup><mo lspace="0em" rspace="0em">​</mo><mi>U</mi><mo lspace="0em" rspace="0em">​</mo><msub><mi>𝐱</mi><mi>t</mi></msub></mrow><mo stretchy="false">)</mo></mrow></mrow><mrow><msubsup><mo>∑</mo><mrow><mi>j</mi><mo>=</mo><mn>1</mn></mrow><mi>T</mi></msubsup><mrow><mi>exp</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mrow><msubsup><mi>𝐱</mi><mi>j</mi><mo>⊤</mo></msubsup><mo lspace="0em" rspace="0em">​</mo><mi>U</mi><mo lspace="0em" rspace="0em">​</mo><msub><mi>𝐱</mi><mi>t</mi></msub></mrow><mo stretchy="false">)</mo></mrow></mrow></mrow></mfrac></mstyle><mo>=</mo><mstyle displaystyle="true"><mfrac><mrow><mi>exp</mi><mo>⁡</mo><mrow><mo maxsize="1.200em" minsize="1.200em">(</mo><mrow><mi>B</mi><mo lspace="0em" rspace="0em">​</mo><mrow><msubsup><mo>∑</mo><mrow><mi>a</mi><mo>=</mo><mn>1</mn></mrow><mi>A</mi></msubsup><mrow><msubsup><mi>𝐪</mi><mrow><mi>a</mi><mo>,</mo><mi>s</mi></mrow><mo>⊤</mo></msubsup><mo lspace="0em" rspace="0em">​</mo><msub><mi>𝐪</mi><mrow><mi>a</mi><mo>,</mo><mrow><mi>t</mi><mo>−</mo><mi>r</mi></mrow></mrow></msub></mrow></mrow></mrow><mo maxsize="1.200em" minsize="1.200em">)</mo></mrow></mrow><mrow><msubsup><mo>∑</mo><mrow><mi>j</mi><mo>=</mo><mn>1</mn></mrow><mi>T</mi></msubsup><mrow><mi>exp</mi><mo>⁡</mo><mrow><mo maxsize="1.200em" minsize="1.200em">(</mo><mrow><mi>B</mi><mo lspace="0em" rspace="0em">​</mo><mrow><msubsup><mo>∑</mo><mrow><mi>a</mi><mo>=</mo><mn>1</mn></mrow><mi>A</mi></msubsup><mrow><msubsup><mi>𝐪</mi><mrow><mi>a</mi><mo>,</mo><mi>j</mi></mrow><mo>⊤</mo></msubsup><mo lspace="0em" rspace="0em">​</mo><msub><mi>𝐪</mi><mrow><mi>a</mi><mo>,</mo><mrow><mi>t</mi><mo>−</mo><mi>r</mi></mrow></mrow></msub></mrow></mrow></mrow><mo maxsize="1.200em" minsize="1.200em">)</mo></mrow></mrow></mrow></mfrac></mstyle><mo>≤</mo><mstyle displaystyle="true"><mfrac><mrow><mi>exp</mi><mo>⁡</mo><mrow><mo maxsize="1.600em" minsize="1.600em">(</mo><mrow><mi>B</mi><mo>⁡</mo><mrow><mo maxsize="1.200em" minsize="1.200em">(</mo><mrow><mi>A</mi><mo>−</mo><mfrac><mn>1</mn><mrow><mn>3</mn><mo lspace="0em" rspace="0em">​</mo><msup><mi>T</mi><mrow><mn>2</mn><mo>/</mo><mi>A</mi></mrow></msup></mrow></mfrac></mrow><mo maxsize="1.200em" minsize="1.200em">)</mo></mrow></mrow><mo maxsize="1.600em" minsize="1.600em">)</mo></mrow></mrow><mrow><mi>exp</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mrow><mi>B</mi><mo lspace="0em" rspace="0em">​</mo><mi>A</mi></mrow><mo stretchy="false">)</mo></mrow></mrow></mfrac></mstyle><mo>≤</mo><msup><mi>T</mi><mrow><mo rspace="0.167em">−</mo><mrow><mi>log</mi><mo lspace="0.167em">⁡</mo><mi>T</mi></mrow></mrow></msup></mrow><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">\displaystyle\frac{\exp(\mathbf{x}^{\top}_{s}U\mathbf{x}_{t})}{\sum_{j=1}^{T}\exp(\mathbf{x}^{\top}_{j}U\mathbf{x}_{t})}=\frac{\exp\big(B\sum_{a=1}^{A}\mathbf{q}_{a,s}^{\top}\mathbf{q}_{a,t-r}\big)}{\sum_{j=1}^{T}\exp\big(B\sum_{a=1}^{A}\mathbf{q}_{a,j}^{\top}\mathbf{q}_{a,t-r}\big)}\leq\frac{\exp\Big(B\big(A-\frac{1}{3T^{2/A}}\big)\Big)}{\exp(BA)}\leq T^{-\log T}.</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td>
<td rowspan="1" class="ltx_eqn_cell ltx_eqn_eqno ltx_align_middle ltx_align_right"><span class="ltx_tag ltx_tag_equation ltx_align_right">(53)</span></td></tr></tbody>
</table>
<p id="A5.SS1.p6.10" class="ltx_p"><span id="A5.SS1.p6.10.1" class="ltx_text">Together, (<a href="#A5.E52" title="In Proof. ‣ E.1 Construction of multi-head self-attention layers ‣ Appendix E Construction of the Transformer ‣ Generalization Bounds for Transformer-Based Next-Token Prediction in a Language Model" class="ltx_ref"><span class="ltx_text ltx_ref_tag">52</span></a>) and (<a href="#A5.E53" title="In Proof. ‣ E.1 Construction of multi-head self-attention layers ‣ Appendix E Construction of the Transformer ‣ Generalization Bounds for Transformer-Based Next-Token Prediction in a Language Model" class="ltx_ref"><span class="ltx_text ltx_ref_tag">53</span></a>) yield</span></p>
<table id="A5.EGx96" class="ltx_equationgroup ltx_eqn_align ltx_eqn_table">

<tbody id="A5.Ex195"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_align_right ltx_eqn_cell"><math id="A5.Ex195.m1" class="ltx_Math" alttext="\displaystyle\big\|\mathbf{y}_{t}-\mathbf{x}_{2,t-r}\big\|_{\infty}" display="inline" intent=":literal"><semantics><msub><mrow><mo maxsize="1.200em" minsize="1.200em" stretchy="true">‖</mo><mrow><msub><mi>𝐲</mi><mi>t</mi></msub><mo>−</mo><msub><mi>𝐱</mi><mrow><mn>2</mn><mo>,</mo><mrow><mi>t</mi><mo>−</mo><mi>r</mi></mrow></mrow></msub></mrow><mo maxsize="1.200em" minsize="1.200em" stretchy="true">‖</mo></mrow><mi mathvariant="normal">∞</mi></msub><annotation encoding="application/x-tex">\displaystyle\big\|\mathbf{y}_{t}-\mathbf{x}_{2,t-r}\big\|_{\infty}</annotation></semantics></math></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A5.Ex195.m2" class="ltx_Math" alttext="\displaystyle=\left\|\sum_{s=1}^{T}\frac{\exp(\mathbf{x}^{\top}_{s}U\mathbf{x}_{t})}{\sum_{j=1}^{T}\exp(\mathbf{x}^{\top}_{j}U\mathbf{x}_{t})}\mathbf{x}_{2,s}\,-\,\mathbf{x}_{2,t-r}\right\|_{\infty}" display="inline" intent=":literal"><semantics><mrow><mphantom></mphantom><mo>=</mo><msub><mrow><mo>‖</mo><mrow><mrow><mstyle displaystyle="true"><munderover><mo movablelimits="false">∑</mo><mrow><mi>s</mi><mo>=</mo><mn>1</mn></mrow><mi>T</mi></munderover></mstyle><mrow><mstyle displaystyle="true"><mfrac><mrow><mi>exp</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mrow><msubsup><mi>𝐱</mi><mi>s</mi><mo>⊤</mo></msubsup><mo lspace="0em" rspace="0em">​</mo><mi>U</mi><mo lspace="0em" rspace="0em">​</mo><msub><mi>𝐱</mi><mi>t</mi></msub></mrow><mo stretchy="false">)</mo></mrow></mrow><mrow><msubsup><mo>∑</mo><mrow><mi>j</mi><mo>=</mo><mn>1</mn></mrow><mi>T</mi></msubsup><mrow><mi>exp</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mrow><msubsup><mi>𝐱</mi><mi>j</mi><mo>⊤</mo></msubsup><mo lspace="0em" rspace="0em">​</mo><mi>U</mi><mo lspace="0em" rspace="0em">​</mo><msub><mi>𝐱</mi><mi>t</mi></msub></mrow><mo stretchy="false">)</mo></mrow></mrow></mrow></mfrac></mstyle><mo lspace="0em" rspace="0em">​</mo><msub><mi>𝐱</mi><mrow><mn>2</mn><mo>,</mo><mi>s</mi></mrow></msub></mrow></mrow><mo rspace="0.392em">−</mo><msub><mi>𝐱</mi><mrow><mn>2</mn><mo>,</mo><mrow><mi>t</mi><mo>−</mo><mi>r</mi></mrow></mrow></msub></mrow><mo>‖</mo></mrow><mi mathvariant="normal">∞</mi></msub></mrow><annotation encoding="application/x-tex">\displaystyle=\left\|\sum_{s=1}^{T}\frac{\exp(\mathbf{x}^{\top}_{s}U\mathbf{x}_{t})}{\sum_{j=1}^{T}\exp(\mathbf{x}^{\top}_{j}U\mathbf{x}_{t})}\mathbf{x}_{2,s}\,-\,\mathbf{x}_{2,t-r}\right\|_{\infty}</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
<tbody id="A5.Ex196"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_eqn_cell"></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A5.Ex196.m1" class="ltx_Math" alttext="\displaystyle=\left\|\frac{\exp(\mathbf{x}^{\top}_{t-r}U\mathbf{x}_{t})}{\sum_{j=1}^{T}\exp(\mathbf{x}^{\top}_{j}U\mathbf{x}_{t})}\mathbf{x}_{2,t-r}\,+\,\sum_{s\neq t-r}\frac{\exp(\mathbf{x}^{\top}_{s}U\mathbf{x}_{t})}{\sum_{j=1}^{T}\exp(\mathbf{x}^{\top}_{j}U\mathbf{x}_{t})}\mathbf{x}_{2,s}\,-\,\mathbf{x}_{2,t-r}\right\|_{\infty}" display="inline" intent=":literal"><semantics><mrow><mphantom></mphantom><mo>=</mo><msub><mrow><mo>‖</mo><mrow><mrow><mrow><mstyle displaystyle="true"><mfrac><mrow><mi>exp</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mrow><msubsup><mi>𝐱</mi><mrow><mi>t</mi><mo>−</mo><mi>r</mi></mrow><mo>⊤</mo></msubsup><mo lspace="0em" rspace="0em">​</mo><mi>U</mi><mo lspace="0em" rspace="0em">​</mo><msub><mi>𝐱</mi><mi>t</mi></msub></mrow><mo stretchy="false">)</mo></mrow></mrow><mrow><msubsup><mo>∑</mo><mrow><mi>j</mi><mo>=</mo><mn>1</mn></mrow><mi>T</mi></msubsup><mrow><mi>exp</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mrow><msubsup><mi>𝐱</mi><mi>j</mi><mo>⊤</mo></msubsup><mo lspace="0em" rspace="0em">​</mo><mi>U</mi><mo lspace="0em" rspace="0em">​</mo><msub><mi>𝐱</mi><mi>t</mi></msub></mrow><mo stretchy="false">)</mo></mrow></mrow></mrow></mfrac></mstyle><mo lspace="0em" rspace="0em">​</mo><msub><mi>𝐱</mi><mrow><mn>2</mn><mo>,</mo><mrow><mi>t</mi><mo>−</mo><mi>r</mi></mrow></mrow></msub></mrow><mo rspace="0.392em">+</mo><mrow><mstyle displaystyle="true"><munder><mo movablelimits="false">∑</mo><mrow><mi>s</mi><mo>≠</mo><mrow><mi>t</mi><mo>−</mo><mi>r</mi></mrow></mrow></munder></mstyle><mrow><mstyle displaystyle="true"><mfrac><mrow><mi>exp</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mrow><msubsup><mi>𝐱</mi><mi>s</mi><mo>⊤</mo></msubsup><mo lspace="0em" rspace="0em">​</mo><mi>U</mi><mo lspace="0em" rspace="0em">​</mo><msub><mi>𝐱</mi><mi>t</mi></msub></mrow><mo stretchy="false">)</mo></mrow></mrow><mrow><msubsup><mo>∑</mo><mrow><mi>j</mi><mo>=</mo><mn>1</mn></mrow><mi>T</mi></msubsup><mrow><mi>exp</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mrow><msubsup><mi>𝐱</mi><mi>j</mi><mo>⊤</mo></msubsup><mo lspace="0em" rspace="0em">​</mo><mi>U</mi><mo lspace="0em" rspace="0em">​</mo><msub><mi>𝐱</mi><mi>t</mi></msub></mrow><mo stretchy="false">)</mo></mrow></mrow></mrow></mfrac></mstyle><mo lspace="0em" rspace="0em">​</mo><msub><mi>𝐱</mi><mrow><mn>2</mn><mo>,</mo><mi>s</mi></mrow></msub></mrow></mrow></mrow><mo rspace="0.392em">−</mo><msub><mi>𝐱</mi><mrow><mn>2</mn><mo>,</mo><mrow><mi>t</mi><mo>−</mo><mi>r</mi></mrow></mrow></msub></mrow><mo>‖</mo></mrow><mi mathvariant="normal">∞</mi></msub></mrow><annotation encoding="application/x-tex">\displaystyle=\left\|\frac{\exp(\mathbf{x}^{\top}_{t-r}U\mathbf{x}_{t})}{\sum_{j=1}^{T}\exp(\mathbf{x}^{\top}_{j}U\mathbf{x}_{t})}\mathbf{x}_{2,t-r}\,+\,\sum_{s\neq t-r}\frac{\exp(\mathbf{x}^{\top}_{s}U\mathbf{x}_{t})}{\sum_{j=1}^{T}\exp(\mathbf{x}^{\top}_{j}U\mathbf{x}_{t})}\mathbf{x}_{2,s}\,-\,\mathbf{x}_{2,t-r}\right\|_{\infty}</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
<tbody id="A5.Ex197"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_eqn_cell"></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A5.Ex197.m1" class="ltx_Math" alttext="\displaystyle=\left\|\left(\frac{\exp(\mathbf{x}^{\top}_{t-r}U\mathbf{x}_{t})}{\sum_{j=1}^{T}\exp(\mathbf{x}^{\top}_{j}U\mathbf{x}_{t})}-1\right)\mathbf{x}_{2,t-r}\right\|_{\infty}+\sum_{s\neq t-r}\left\|\frac{\exp(\mathbf{x}^{\top}_{s}U\mathbf{x}_{t})}{\sum_{j=1}^{T}\exp(\mathbf{x}^{\top}_{j}U\mathbf{x}_{t})}\mathbf{x}_{2,s}\right\|_{\infty}" display="inline" intent=":literal"><semantics><mrow><mphantom></mphantom><mo>=</mo><mrow><msub><mrow><mo>‖</mo><mrow><mrow><mo>(</mo><mrow><mstyle displaystyle="true"><mfrac><mrow><mi>exp</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mrow><msubsup><mi>𝐱</mi><mrow><mi>t</mi><mo>−</mo><mi>r</mi></mrow><mo>⊤</mo></msubsup><mo lspace="0em" rspace="0em">​</mo><mi>U</mi><mo lspace="0em" rspace="0em">​</mo><msub><mi>𝐱</mi><mi>t</mi></msub></mrow><mo stretchy="false">)</mo></mrow></mrow><mrow><msubsup><mo>∑</mo><mrow><mi>j</mi><mo>=</mo><mn>1</mn></mrow><mi>T</mi></msubsup><mrow><mi>exp</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mrow><msubsup><mi>𝐱</mi><mi>j</mi><mo>⊤</mo></msubsup><mo lspace="0em" rspace="0em">​</mo><mi>U</mi><mo lspace="0em" rspace="0em">​</mo><msub><mi>𝐱</mi><mi>t</mi></msub></mrow><mo stretchy="false">)</mo></mrow></mrow></mrow></mfrac></mstyle><mo>−</mo><mn>1</mn></mrow><mo>)</mo></mrow><mo lspace="0em" rspace="0em">​</mo><msub><mi>𝐱</mi><mrow><mn>2</mn><mo>,</mo><mrow><mi>t</mi><mo>−</mo><mi>r</mi></mrow></mrow></msub></mrow><mo>‖</mo></mrow><mi mathvariant="normal">∞</mi></msub><mo>+</mo><mrow><mstyle displaystyle="true"><munder><mo movablelimits="false">∑</mo><mrow><mi>s</mi><mo>≠</mo><mrow><mi>t</mi><mo>−</mo><mi>r</mi></mrow></mrow></munder></mstyle><msub><mrow><mo>‖</mo><mrow><mstyle displaystyle="true"><mfrac><mrow><mi>exp</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mrow><msubsup><mi>𝐱</mi><mi>s</mi><mo>⊤</mo></msubsup><mo lspace="0em" rspace="0em">​</mo><mi>U</mi><mo lspace="0em" rspace="0em">​</mo><msub><mi>𝐱</mi><mi>t</mi></msub></mrow><mo stretchy="false">)</mo></mrow></mrow><mrow><msubsup><mo>∑</mo><mrow><mi>j</mi><mo>=</mo><mn>1</mn></mrow><mi>T</mi></msubsup><mrow><mi>exp</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mrow><msubsup><mi>𝐱</mi><mi>j</mi><mo>⊤</mo></msubsup><mo lspace="0em" rspace="0em">​</mo><mi>U</mi><mo lspace="0em" rspace="0em">​</mo><msub><mi>𝐱</mi><mi>t</mi></msub></mrow><mo stretchy="false">)</mo></mrow></mrow></mrow></mfrac></mstyle><mo lspace="0em" rspace="0em">​</mo><msub><mi>𝐱</mi><mrow><mn>2</mn><mo>,</mo><mi>s</mi></mrow></msub></mrow><mo>‖</mo></mrow><mi mathvariant="normal">∞</mi></msub></mrow></mrow></mrow><annotation encoding="application/x-tex">\displaystyle=\left\|\left(\frac{\exp(\mathbf{x}^{\top}_{t-r}U\mathbf{x}_{t})}{\sum_{j=1}^{T}\exp(\mathbf{x}^{\top}_{j}U\mathbf{x}_{t})}-1\right)\mathbf{x}_{2,t-r}\right\|_{\infty}+\sum_{s\neq t-r}\left\|\frac{\exp(\mathbf{x}^{\top}_{s}U\mathbf{x}_{t})}{\sum_{j=1}^{T}\exp(\mathbf{x}^{\top}_{j}U\mathbf{x}_{t})}\mathbf{x}_{2,s}\right\|_{\infty}</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
<tbody id="A5.Ex198"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_eqn_cell"></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A5.Ex198.m1" class="ltx_Math" alttext="\displaystyle\leq 2T^{1-\log T}." display="inline" intent=":literal"><semantics><mrow><mrow><mphantom></mphantom><mo>≤</mo><mrow><mn>2</mn><mo lspace="0em" rspace="0em">​</mo><msup><mi>T</mi><mrow><mn>1</mn><mo>−</mo><mrow><mi>log</mi><mo lspace="0.167em">⁡</mo><mi>T</mi></mrow></mrow></msup></mrow></mrow><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">\displaystyle\leq 2T^{1-\log T}.</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="A5.SS1.p6.11" class="ltx_p"><span id="A5.SS1.p6.11.1" class="ltx_text">The bound <math id="A5.SS1.p6.m18" class="ltx_Math" alttext="\|\mathbf{y}_{t}\|_{\infty}\leq 1" display="inline" intent=":literal"><semantics><mrow><msub><mrow><mo stretchy="false">‖</mo><msub><mi>𝐲</mi><mi>t</mi></msub><mo stretchy="false">‖</mo></mrow><mi mathvariant="normal">∞</mi></msub><mo>≤</mo><mn>1</mn></mrow><annotation encoding="application/x-tex">\|\mathbf{y}_{t}\|_{\infty}\leq 1</annotation></semantics></math> for <math id="A5.SS1.p6.m19" class="ltx_Math" alttext="t\in[T]" display="inline" intent=":literal"><semantics><mrow><mi>t</mi><mo>∈</mo><mrow><mo stretchy="false">[</mo><mi>T</mi><mo stretchy="false">]</mo></mrow></mrow><annotation encoding="application/x-tex">t\in[T]</annotation></semantics></math> follows since <math id="A5.SS1.p6.m20" class="ltx_Math" alttext="\mathbf{y}_{t}" display="inline" intent=":literal"><semantics><msub><mi>𝐲</mi><mi>t</mi></msub><annotation encoding="application/x-tex">\mathbf{y}_{t}</annotation></semantics></math> is a weighted
average of <math id="A5.SS1.p6.m21" class="ltx_Math" alttext="\{\mathbf{x}_{2,s}\}_{s\in[T]}" display="inline" intent=":literal"><semantics><msub><mrow><mo stretchy="false">{</mo><msub><mi>𝐱</mi><mrow><mn>2</mn><mo>,</mo><mi>s</mi></mrow></msub><mo stretchy="false">}</mo></mrow><mrow><mi>s</mi><mo>∈</mo><mrow><mo stretchy="false">[</mo><mi>T</mi><mo stretchy="false">]</mo></mrow></mrow></msub><annotation encoding="application/x-tex">\{\mathbf{x}_{2,s}\}_{s\in[T]}</annotation></semantics></math>.
∎</span></p>
</div>
</div>
<div id="A5.SS1.p7" class="ltx_para">
<p id="A5.SS1.p7.1" class="ltx_p">Based on Lemma <a href="#Thmconj213" title="Lemma 13. ‣ E.1 Construction of multi-head self-attention layers ‣ Appendix E Construction of the Transformer ‣ Generalization Bounds for Transformer-Based Next-Token Prediction in a Language Model" class="ltx_ref"><span class="ltx_text ltx_ref_tag">13</span></a>, we can construct a multi-head self-attention that approximately implements a delay operation. We apply this lemma by setting
<math id="A5.SS1.p7.m1" class="ltx_Math" alttext="\mathbf{x}_{1,t}=\bm{\phi}_{1}(\mathbf{X}_{t})" display="inline" intent=":literal"><semantics><mrow><msub><mi>𝐱</mi><mrow><mn>1</mn><mo>,</mo><mi>t</mi></mrow></msub><mo>=</mo><mrow><msub><mi class="ltx_mathvariant_bold-italic" mathvariant="bold-italic">ϕ</mi><mn>1</mn></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mi>𝐗</mi><mi>t</mi></msub><mo stretchy="false">)</mo></mrow></mrow></mrow><annotation encoding="application/x-tex">\mathbf{x}_{1,t}=\bm{\phi}_{1}(\mathbf{X}_{t})</annotation></semantics></math> and <math id="A5.SS1.p7.m2" class="ltx_Math" alttext="\mathbf{x}_{2,t}=\bm{\phi}_{2}(\mathbf{X}_{t})" display="inline" intent=":literal"><semantics><mrow><msub><mi>𝐱</mi><mrow><mn>2</mn><mo>,</mo><mi>t</mi></mrow></msub><mo>=</mo><mrow><msub><mi class="ltx_mathvariant_bold-italic" mathvariant="bold-italic">ϕ</mi><mn>2</mn></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mi>𝐗</mi><mi>t</mi></msub><mo stretchy="false">)</mo></mrow></mrow></mrow><annotation encoding="application/x-tex">\mathbf{x}_{2,t}=\bm{\phi}_{2}(\mathbf{X}_{t})</annotation></semantics></math>.</p>
</div>
<div id="Thmconj214" class="ltx_theorem ltx_theorem_lemma">
<h6 class="ltx_title ltx_runin ltx_title_theorem"><span class="ltx_tag ltx_tag_theorem"><span id="Thmconj214.4" class="ltx_text ltx_font_bold">Lemma 14</span></span><span id="Thmconj214.5" class="ltx_text ltx_font_bold">.</span></h6>
<div id="Thmconj214.p1" class="ltx_para">
<p id="Thmconj214.p1.1" class="ltx_p"><span id="Thmconj214.p1.1.1" class="ltx_text ltx_font_italic">Under Assumption <a href="#Thmassumpt3" title="Assumption 3. ‣ 4 Risk bound ‣ Generalization Bounds for Transformer-Based Next-Token Prediction in a Language Model" class="ltx_ref"><span class="ltx_text ltx_ref_tag">3</span></a>, there exists <math id="Thmconj214.p1.m1" class="ltx_Math" alttext="\bm{\mu}_{1}\in\mathcal{MA}(N,H,B)" display="inline" intent=":literal"><semantics><mrow><msub><mi>𝛍</mi><mn>1</mn></msub><mo>∈</mo><mrow><mi class="ltx_font_mathcaligraphic">ℳ</mi><mo lspace="0em" rspace="0em">​</mo><mi class="ltx_font_mathcaligraphic">𝒜</mi><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>N</mi><mo>,</mo><mi>H</mi><mo>,</mo><mi>B</mi><mo stretchy="false">)</mo></mrow></mrow></mrow><annotation encoding="application/x-tex">\bm{\mu}_{1}\in\mathcal{MA}(N,H,B)</annotation></semantics></math> such that</span></p>
<table id="A5.Ex199" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="A5.Ex199.m1" class="ltx_Math" alttext="\bm{\mu}_{1}:\left(\begin{matrix}\mathbf{x}_{1,t}\\
\mathbf{x}_{2,t}\\
\bm{0}_{\tfrac{N}{2}-m_{1}-m_{2}}\\
\mathbf{q}_{t}\end{matrix}\right)_{t\in[T]}\begin{array}[]{l}\in[-1,1]^{m_{1}}\\
\in[-1,1]^{m_{2}}\\
\left.\right.\\
\in[-1,1]^{N/2}\end{array}\longmapsto\quad\left(\begin{matrix}\mathbf{x}_{1,t}\\
\mathbf{x}_{2,t}\\
\mathbf{y}_{1,t}\\
\mathbf{y}_{2,t}\\
\bm{0}_{\tfrac{N}{2}-(r_{1}+1)m_{1}-(r_{2}+1)m_{2}}\\
\mathbf{q}_{t}\end{matrix}\right)_{t\in[T]}\begin{array}[]{l}\left.\right.\\
\left.\right.\\
\in\mathbb{R}^{r_{1}m_{1}}\\
\in\mathbb{R}^{r_{2}m_{2}}\\
\left.\right.\\
\left.\right.\end{array}" display="block" intent=":literal"><semantics><mrow><mrow><msub><mi>𝝁</mi><mn>1</mn></msub><mo lspace="0.278em" rspace="0.278em">:</mo><mrow><mrow><msub><mrow><mo>(</mo><mtable displaystyle="true" rowspacing="0pt"><mtr><mtd><msub><mi>𝐱</mi><mrow><mn>1</mn><mo>,</mo><mi>t</mi></mrow></msub></mtd></mtr><mtr><mtd><msub><mi>𝐱</mi><mrow><mn>2</mn><mo>,</mo><mi>t</mi></mrow></msub></mtd></mtr><mtr><mtd><msub><mn>𝟎</mn><mrow><mstyle scriptlevel="-1"><mfrac><mi>N</mi><mn>2</mn></mfrac></mstyle><mo>−</mo><msub><mi>m</mi><mn>1</mn></msub><mo>−</mo><msub><mi>m</mi><mn>2</mn></msub></mrow></msub></mtd></mtr><mtr><mtd><msub><mi>𝐪</mi><mi>t</mi></msub></mtd></mtr></mtable><mo>)</mo></mrow><mrow><mi>t</mi><mo>∈</mo><mrow><mo stretchy="false">[</mo><mi>T</mi><mo stretchy="false">]</mo></mrow></mrow></msub><mo lspace="0.167em" rspace="0em">​</mo><mtable displaystyle="true" rowspacing="0pt"><mtr><mtd class="ltx_align_left" columnalign="left"><mrow><mphantom></mphantom><mo>∈</mo><msup><mrow><mo stretchy="false">[</mo><mrow><mrow><mo>−</mo><mn>1</mn></mrow><mo>,</mo><mn>1</mn></mrow><mo stretchy="false">]</mo></mrow><msub><mi>m</mi><mn>1</mn></msub></msup></mrow></mtd></mtr><mtr><mtd class="ltx_align_left" columnalign="left"><mrow><mphantom></mphantom><mo>∈</mo><msup><mrow><mo stretchy="false">[</mo><mrow><mrow><mo>−</mo><mn>1</mn></mrow><mo>,</mo><mn>1</mn></mrow><mo stretchy="false">]</mo></mrow><msub><mi>m</mi><mn>2</mn></msub></msup></mrow></mtd></mtr><mtr><mtd class="ltx_align_left" columnalign="left"><mphantom></mphantom></mtd></mtr><mtr><mtd class="ltx_align_left" columnalign="left"><mrow><mphantom></mphantom><mo>∈</mo><msup><mrow><mo stretchy="false">[</mo><mrow><mrow><mo>−</mo><mn>1</mn></mrow><mo>,</mo><mn>1</mn></mrow><mo stretchy="false">]</mo></mrow><mrow><mi>N</mi><mo>/</mo><mn>2</mn></mrow></msup></mrow></mtd></mtr></mtable></mrow><mo stretchy="false">⟼</mo><mphantom></mphantom></mrow></mrow><mspace style="width:1em;" width="1em"></mspace><mrow><msub><mrow><mo>(</mo><mtable displaystyle="true" rowspacing="0pt"><mtr><mtd><msub><mi>𝐱</mi><mrow><mn>1</mn><mo>,</mo><mi>t</mi></mrow></msub></mtd></mtr><mtr><mtd><msub><mi>𝐱</mi><mrow><mn>2</mn><mo>,</mo><mi>t</mi></mrow></msub></mtd></mtr><mtr><mtd><msub><mi>𝐲</mi><mrow><mn>1</mn><mo>,</mo><mi>t</mi></mrow></msub></mtd></mtr><mtr><mtd><msub><mi>𝐲</mi><mrow><mn>2</mn><mo>,</mo><mi>t</mi></mrow></msub></mtd></mtr><mtr><mtd><msub><mn>𝟎</mn><mrow><mstyle scriptlevel="-1"><mfrac><mi>N</mi><mn>2</mn></mfrac></mstyle><mo>−</mo><mrow><mrow><mo stretchy="false">(</mo><mrow><msub><mi>r</mi><mn>1</mn></msub><mo>+</mo><mn>1</mn></mrow><mo stretchy="false">)</mo></mrow><mo lspace="0em" rspace="0em">​</mo><msub><mi>m</mi><mn>1</mn></msub></mrow><mo>−</mo><mrow><mrow><mo stretchy="false">(</mo><mrow><msub><mi>r</mi><mn>2</mn></msub><mo>+</mo><mn>1</mn></mrow><mo stretchy="false">)</mo></mrow><mo lspace="0em" rspace="0em">​</mo><msub><mi>m</mi><mn>2</mn></msub></mrow></mrow></msub></mtd></mtr><mtr><mtd><msub><mi>𝐪</mi><mi>t</mi></msub></mtd></mtr></mtable><mo>)</mo></mrow><mrow><mi>t</mi><mo>∈</mo><mrow><mo stretchy="false">[</mo><mi>T</mi><mo stretchy="false">]</mo></mrow></mrow></msub><mo lspace="0.167em" rspace="0em">​</mo><mtable displaystyle="true" rowspacing="0pt"><mtr><mtd class="ltx_align_left" columnalign="left"><mphantom></mphantom></mtd></mtr><mtr><mtd class="ltx_align_left" columnalign="left"><mphantom></mphantom></mtd></mtr><mtr><mtd class="ltx_align_left" columnalign="left"><mrow><mphantom></mphantom><mo>∈</mo><msup><mi>ℝ</mi><mrow><msub><mi>r</mi><mn>1</mn></msub><mo lspace="0em" rspace="0em">​</mo><msub><mi>m</mi><mn>1</mn></msub></mrow></msup></mrow></mtd></mtr><mtr><mtd class="ltx_align_left" columnalign="left"><mrow><mphantom></mphantom><mo>∈</mo><msup><mi>ℝ</mi><mrow><msub><mi>r</mi><mn>2</mn></msub><mo lspace="0em" rspace="0em">​</mo><msub><mi>m</mi><mn>2</mn></msub></mrow></msup></mrow></mtd></mtr><mtr><mtd class="ltx_align_left" columnalign="left"><mphantom></mphantom></mtd></mtr><mtr><mtd class="ltx_align_left" columnalign="left"><mphantom></mphantom></mtd></mtr></mtable></mrow></mrow><annotation encoding="application/x-tex">\bm{\mu}_{1}:\left(\begin{matrix}\mathbf{x}_{1,t}\\
\mathbf{x}_{2,t}\\
\bm{0}_{\tfrac{N}{2}-m_{1}-m_{2}}\\
\mathbf{q}_{t}\end{matrix}\right)_{t\in[T]}\begin{array}[]{l}\in[-1,1]^{m_{1}}\\
\in[-1,1]^{m_{2}}\\
\left.\right.\\
\in[-1,1]^{N/2}\end{array}\longmapsto\quad\left(\begin{matrix}\mathbf{x}_{1,t}\\
\mathbf{x}_{2,t}\\
\mathbf{y}_{1,t}\\
\mathbf{y}_{2,t}\\
\bm{0}_{\tfrac{N}{2}-(r_{1}+1)m_{1}-(r_{2}+1)m_{2}}\\
\mathbf{q}_{t}\end{matrix}\right)_{t\in[T]}\begin{array}[]{l}\left.\right.\\
\left.\right.\\
\in\mathbb{R}^{r_{1}m_{1}}\\
\in\mathbb{R}^{r_{2}m_{2}}\\
\left.\right.\\
\left.\right.\end{array}</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="Thmconj214.p1.2" class="ltx_p"><span id="Thmconj214.p1.2.1" class="ltx_text ltx_font_italic">where for <math id="Thmconj214.p1.m2" class="ltx_Math" alttext="a=1,2," display="inline" intent=":literal"><semantics><mrow><mrow><mrow><mi>a</mi><mo>=</mo><mn>1</mn></mrow><mo>,</mo><mn>2</mn></mrow><mo>,</mo></mrow><annotation encoding="application/x-tex">a=1,2,</annotation></semantics></math></span></p>
<table id="A5.EGx97" class="ltx_equationgroup ltx_eqn_align ltx_eqn_table">

<tbody id="A5.Ex200"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_eqn_cell"></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A5.Ex200.m1" class="ltx_math_unparsed" alttext="\displaystyle\left\|\mathbf{y}_{a,t}-\begin{pmatrix}\mathbf{x}_{a,t-r_{a}}\\
\mathbf{x}_{a,t-r_{a}+1}\\
\vdots\\
\mathbf{x}_{a,t-1}\end{pmatrix}\right\|_{\infty}\lesssim T^{1-\log T},\ \text{ for all }t\in\{r_{a}+1,\ldots,T\},\ \text{and}\ \ \|\mathbf{y}_{a,t}\|_{\infty}\leq 1,\ \text{ for all }t\in[T]." display="inline" intent=":literal"><semantics><mrow><msub><mrow><mo>‖</mo><msub><mi>𝐲</mi><mrow><mi>a</mi><mo>,</mo><mi>t</mi></mrow></msub><mo>−</mo><mrow><mo>(</mo><mtable rowspacing="0pt"><mtr><mtd><msub><mi>𝐱</mi><mrow><mi>a</mi><mo>,</mo><mrow><mi>t</mi><mo>−</mo><msub><mi>r</mi><mi>a</mi></msub></mrow></mrow></msub></mtd></mtr><mtr><mtd><msub><mi>𝐱</mi><mrow><mi>a</mi><mo>,</mo><mrow><mrow><mi>t</mi><mo>−</mo><msub><mi>r</mi><mi>a</mi></msub></mrow><mo>+</mo><mn>1</mn></mrow></mrow></msub></mtd></mtr><mtr><mtd></mtd></mtr><mtr><mtd><msub><mi>𝐱</mi><mrow><mi>a</mi><mo>,</mo><mrow><mi>t</mi><mo>−</mo><mn>1</mn></mrow></mrow></msub></mtd></mtr></mtable><mo>)</mo></mrow><mo>‖</mo></mrow><mi mathvariant="normal">∞</mi></msub><mo>≲</mo><msup><mi>T</mi><mrow><mn>1</mn><mo>−</mo><mrow><mi>log</mi><mo lspace="0.167em">⁡</mo><mi>T</mi></mrow></mrow></msup><mo rspace="0.667em">,</mo><mtext class="ltx_mathvariant_italic"> for all </mtext><mi>t</mi><mo>∈</mo><mrow><mo stretchy="false">{</mo><msub><mi>r</mi><mi>a</mi></msub><mo>+</mo><mn>1</mn><mo>,</mo><mi mathvariant="normal">…</mi><mo>,</mo><mi>T</mi><mo stretchy="false">}</mo></mrow><mo rspace="0.667em">,</mo><mtext class="ltx_mathvariant_italic">and</mtext><mo lspace="0em" rspace="0.167em">∥</mo><msub><mi>𝐲</mi><mrow><mi>a</mi><mo>,</mo><mi>t</mi></mrow></msub><msub><mo lspace="0em" rspace="0.0835em">∥</mo><mi mathvariant="normal">∞</mi></msub><mo lspace="0.0835em">≤</mo><mn>1</mn><mo rspace="0.667em">,</mo><mtext class="ltx_mathvariant_italic"> for all </mtext><mi>t</mi><mo>∈</mo><mrow><mo stretchy="false">[</mo><mi>T</mi><mo stretchy="false">]</mo></mrow><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">\displaystyle\left\|\mathbf{y}_{a,t}-\begin{pmatrix}\mathbf{x}_{a,t-r_{a}}\\
\mathbf{x}_{a,t-r_{a}+1}\\
\vdots\\
\mathbf{x}_{a,t-1}\end{pmatrix}\right\|_{\infty}\lesssim T^{1-\log T},\ \text{ for all }t\in\{r_{a}+1,\ldots,T\},\ \text{and}\ \ \|\mathbf{y}_{a,t}\|_{\infty}\leq 1,\ \text{ for all }t\in[T].</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
</div>
</div>
<div id="A5.SS1.4" class="ltx_proof">
<h6 class="ltx_title ltx_runin ltx_font_italic ltx_title_proof">Proof.</h6>
<div id="A5.SS1.p8" class="ltx_para">
<p id="A5.SS1.p8.1" class="ltx_p"><span id="A5.SS1.p8.1.1" class="ltx_text">By applying Lemma <a href="#Thmconj213" title="Lemma 13. ‣ E.1 Construction of multi-head self-attention layers ‣ Appendix E Construction of the Transformer ‣ Generalization Bounds for Transformer-Based Next-Token Prediction in a Language Model" class="ltx_ref"><span class="ltx_text ltx_ref_tag">13</span></a> <math id="A5.SS1.p8.m1" class="ltx_Math" alttext="(r_{1}+r_{2})" display="inline" intent=":literal"><semantics><mrow><mo stretchy="false">(</mo><mrow><msub><mi>r</mi><mn>1</mn></msub><mo>+</mo><msub><mi>r</mi><mn>2</mn></msub></mrow><mo stretchy="false">)</mo></mrow><annotation encoding="application/x-tex">(r_{1}+r_{2})</annotation></semantics></math>-times and adding the identity, we obtain the assertion.
∎</span></p>
</div>
</div>
<div id="A5.SS1.p9" class="ltx_para">
<p id="A5.SS1.p9.1" class="ltx_p">The construction of the next multi-head self-attention layer follows from the definition of the self-attention. Later, we will set</p>
<table id="A5.EGx98" class="ltx_equationgroup ltx_eqn_align ltx_eqn_table">

<tbody id="A5.Ex201"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_eqn_cell"></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A5.Ex201.m1" class="ltx_Math" alttext="\displaystyle\mathbf{x}_{1,t}=\mathbf{g}_{0}(\mathbf{Z}_{1,t+1}),\quad\mathbf{x}_{2,t}=\mathbf{Y}_{t},\quad\mathbf{x}_{3,t}=\frac{1}{\lambda}\bm{\phi}_{2}(\mathbf{X}_{t-r_{2}}),\quad\mathbf{x}_{4,t}=\frac{1}{\lambda}\operatorname{stack}\big(\bm{\phi}_{2}(\mathbf{X}_{t-r_{2}+1}),\ldots,\bm{\phi}_{2}(\mathbf{X}_{t-1})\big)," display="inline" intent=":literal"><semantics><mrow><mrow><mrow><msub><mi>𝐱</mi><mrow><mn>1</mn><mo>,</mo><mi>t</mi></mrow></msub><mo>=</mo><mrow><msub><mi>𝐠</mi><mn>0</mn></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mi>𝐙</mi><mrow><mn>1</mn><mo>,</mo><mrow><mi>t</mi><mo>+</mo><mn>1</mn></mrow></mrow></msub><mo stretchy="false">)</mo></mrow></mrow></mrow><mo rspace="1.167em">,</mo><mrow><msub><mi>𝐱</mi><mrow><mn>2</mn><mo>,</mo><mi>t</mi></mrow></msub><mo>=</mo><msub><mi>𝐘</mi><mi>t</mi></msub></mrow><mo rspace="1.167em">,</mo><mrow><msub><mi>𝐱</mi><mrow><mn>3</mn><mo>,</mo><mi>t</mi></mrow></msub><mo>=</mo><mrow><mstyle displaystyle="true"><mfrac><mn>1</mn><mi>λ</mi></mfrac></mstyle><mo lspace="0em" rspace="0em">​</mo><msub><mi class="ltx_mathvariant_bold-italic" mathvariant="bold-italic">ϕ</mi><mn>2</mn></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mi>𝐗</mi><mrow><mi>t</mi><mo>−</mo><msub><mi>r</mi><mn>2</mn></msub></mrow></msub><mo stretchy="false">)</mo></mrow></mrow></mrow><mo rspace="1.167em">,</mo><mrow><msub><mi>𝐱</mi><mrow><mn>4</mn><mo>,</mo><mi>t</mi></mrow></msub><mo>=</mo><mrow><mstyle displaystyle="true"><mfrac><mn>1</mn><mi>λ</mi></mfrac></mstyle><mo lspace="0.167em" rspace="0em">​</mo><mrow><mi>stack</mi><mo>⁡</mo><mrow><mo maxsize="1.200em" minsize="1.200em">(</mo><mrow><msub><mi class="ltx_mathvariant_bold-italic" mathvariant="bold-italic">ϕ</mi><mn>2</mn></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mi>𝐗</mi><mrow><mrow><mi>t</mi><mo>−</mo><msub><mi>r</mi><mn>2</mn></msub></mrow><mo>+</mo><mn>1</mn></mrow></msub><mo stretchy="false">)</mo></mrow></mrow><mo>,</mo><mi mathvariant="normal">…</mi><mo>,</mo><mrow><msub><mi class="ltx_mathvariant_bold-italic" mathvariant="bold-italic">ϕ</mi><mn>2</mn></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mi>𝐗</mi><mrow><mi>t</mi><mo>−</mo><mn>1</mn></mrow></msub><mo stretchy="false">)</mo></mrow></mrow><mo maxsize="1.200em" minsize="1.200em">)</mo></mrow></mrow></mrow></mrow></mrow><mo>,</mo></mrow><annotation encoding="application/x-tex">\displaystyle\mathbf{x}_{1,t}=\mathbf{g}_{0}(\mathbf{Z}_{1,t+1}),\quad\mathbf{x}_{2,t}=\mathbf{Y}_{t},\quad\mathbf{x}_{3,t}=\frac{1}{\lambda}\bm{\phi}_{2}(\mathbf{X}_{t-r_{2}}),\quad\mathbf{x}_{4,t}=\frac{1}{\lambda}\operatorname{stack}\big(\bm{\phi}_{2}(\mathbf{X}_{t-r_{2}+1}),\ldots,\bm{\phi}_{2}(\mathbf{X}_{t-1})\big),</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
<tbody id="A5.Ex202"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_eqn_cell"></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A5.Ex202.m1" class="ltx_Math" alttext="\displaystyle\mathbf{x}_{5,t}=\frac{1}{\lambda}\bm{\phi}_{2}(\mathbf{X}_{t}),\quad x_{6,t}=\frac{\sqrt{r_{2}}}{\lambda}\quad\quad x_{7,t}=T^{3}\,\mathbb{I}(t\in[\log^{2}T,T-\log^{2}T])." display="inline" intent=":literal"><semantics><mrow><mrow><mrow><msub><mi>𝐱</mi><mrow><mn>5</mn><mo>,</mo><mi>t</mi></mrow></msub><mo>=</mo><mrow><mstyle displaystyle="true"><mfrac><mn>1</mn><mi>λ</mi></mfrac></mstyle><mo lspace="0em" rspace="0em">​</mo><msub><mi class="ltx_mathvariant_bold-italic" mathvariant="bold-italic">ϕ</mi><mn>2</mn></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mi>𝐗</mi><mi>t</mi></msub><mo stretchy="false">)</mo></mrow></mrow></mrow><mo rspace="1.167em">,</mo><mrow><msub><mi>x</mi><mrow><mn>6</mn><mo>,</mo><mi>t</mi></mrow></msub><mo>=</mo><mstyle displaystyle="true"><mfrac><msqrt><msub><mi>r</mi><mn>2</mn></msub></msqrt><mi>λ</mi></mfrac></mstyle></mrow><mspace style="width:2em;" width="2em"></mspace><mrow><msub><mi>x</mi><mrow><mn>7</mn><mo>,</mo><mi>t</mi></mrow></msub><mo>=</mo><mrow><msup><mi>T</mi><mn>3</mn></msup><mo lspace="0em" rspace="0em">​</mo><mi>𝕀</mi><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mrow><mi>t</mi><mo>∈</mo><mrow><mo stretchy="false">[</mo><mrow><mrow><msup><mi>log</mi><mn>2</mn></msup><mo lspace="0.167em">⁡</mo><mi>T</mi></mrow><mo>,</mo><mrow><mi>T</mi><mo>−</mo><mrow><msup><mi>log</mi><mn>2</mn></msup><mo lspace="0.167em">⁡</mo><mi>T</mi></mrow></mrow></mrow><mo stretchy="false">]</mo></mrow></mrow><mo stretchy="false">)</mo></mrow></mrow></mrow></mrow><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">\displaystyle\mathbf{x}_{5,t}=\frac{1}{\lambda}\bm{\phi}_{2}(\mathbf{X}_{t}),\quad x_{6,t}=\frac{\sqrt{r_{2}}}{\lambda}\quad\quad x_{7,t}=T^{3}\,\mathbb{I}(t\in[\log^{2}T,T-\log^{2}T]).</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
</div>
<div id="Thmconj215" class="ltx_theorem ltx_theorem_lemma">
<h6 class="ltx_title ltx_runin ltx_title_theorem"><span class="ltx_tag ltx_tag_theorem"><span id="Thmconj215.4" class="ltx_text ltx_font_bold">Lemma 15</span></span><span id="Thmconj215.5" class="ltx_text ltx_font_bold">.</span></h6>
