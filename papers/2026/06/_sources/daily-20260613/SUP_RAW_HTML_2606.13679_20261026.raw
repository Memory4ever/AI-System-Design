<tr id="S4.T3.6.2" class="ltx_tr" style="--ltx-bg-color:#F2F2F2;">
<td id="S4.T3.6.2.1" class="ltx_td ltx_align_center ltx_border_t" style="padding-left:3.0pt;padding-right:3.0pt;" colspan="8"><span id="S4.T3.6.2.1.1" class="ltx_text ltx_font_bold ltx_font_italic">Proprietary Frontier Models</span></td></tr>
