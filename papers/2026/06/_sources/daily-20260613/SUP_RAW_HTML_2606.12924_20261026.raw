<th id="S5.T3.2.1.1.2" class="ltx_td ltx_align_right ltx_th ltx_th_column ltx_border_tt"><span id="S5.T3.2.1.1.2.1" class="ltx_text ltx_font_bold">Gemini (%)</span></th>
