<td id="S5.T4.2.5.3" class="ltx_td ltx_align_right ltx_border_bb ltx_border_t" style="padding-left:4.5pt;padding-right:4.5pt;"><math id="S5.T4.m14" class="ltx_Math" alttext="+" display="inline" intent=":literal"><semantics><mo>+</mo><annotation encoding="application/x-tex">+</annotation></semantics></math><span id="S5.T4.2.5.3.1" class="ltx_text ltx_font_bold">1.8</span></td></tr>
