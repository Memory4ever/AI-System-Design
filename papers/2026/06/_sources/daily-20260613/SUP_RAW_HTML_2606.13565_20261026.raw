<tbody id="S9.E83"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_eqn_cell"></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="S9.E83.m1" class="ltx_math_unparsed" alttext="\displaystyle+\mathbb{E}_{\bm{X}_{0:1}\sim\mathbb{P}^{\prime}}\left[\sum_{t_{i}:\bm{X}_{t_{i}}\neq\bm{X}_{t_{i}-}}\log\frac{\bm{R}^{\prime}_{t_{i}}(\bm{X}_{t_{i}-},\bm{X}_{t_{i}})}{\bm{R}_{t_{i}}(\bm{X}_{t_{i}-},\bm{X}_{t_{i}})}+\int_{0}^{1}\sum_{y\neq\bm{X}_{t}}(\bm{R}_{t}-\bm{R}^{\prime}_{t})(\bm{X}_{t},z)dt\right]" display="inline" intent=":literal"><semantics><mrow><mo mathsize="0.900em">+</mo><msub><mi mathsize="0.900em">𝔼</mi><mrow><mi mathsize="0.900em">𝑿</mi><msub><mrow></mrow><mrow><mn mathsize="0.900em">0</mn><mo lspace="0.278em" mathsize="0.900em" rspace="0.278em">:</mo><mn mathsize="0.900em">1</mn></mrow></msub><mo mathsize="0.900em">∼</mo><mi mathsize="0.900em">ℙ</mi><msup><mrow></mrow><mo mathsize="0.900em">′</mo></msup></mrow></msub><mrow><mo>[</mo><mstyle displaystyle="true"><munder><mo maxsize="0.900em" minsize="0.900em" movablelimits="false" stretchy="true">∑</mo><mrow><msub><mi mathsize="0.900em">t</mi><mi mathsize="0.900em">i</mi></msub><mo lspace="0.278em" mathsize="0.900em" rspace="0.278em">:</mo><mrow><msub><mi mathsize="0.900em">𝑿</mi><msub><mi mathsize="0.900em">t</mi><mi mathsize="0.900em">i</mi></msub></msub><mo mathsize="0.900em">≠</mo><msub><mi mathsize="0.900em">𝑿</mi><mrow><msub><mi mathsize="0.900em">t</mi><mi mathsize="0.900em">i</mi></msub><mo mathsize="0.900em">−</mo></mrow></msub></mrow></mrow></munder></mstyle><mi mathsize="0.900em">log</mi><mstyle displaystyle="true"><mfrac><mrow><msubsup><mi mathsize="0.900em">𝑹</mi><msub><mi mathsize="0.900em">t</mi><mi mathsize="0.900em">i</mi></msub><mo mathsize="0.900em">′</mo></msubsup><mo lspace="0em" rspace="0em">​</mo><mrow><mo maxsize="0.900em" minsize="0.900em">(</mo><msub><mi mathsize="0.900em">𝑿</mi><mrow><msub><mi mathsize="0.900em">t</mi><mi mathsize="0.900em">i</mi></msub><mo mathsize="0.900em">−</mo></mrow></msub><mo mathsize="0.900em">,</mo><msub><mi mathsize="0.900em">𝑿</mi><msub><mi mathsize="0.900em">t</mi><mi mathsize="0.900em">i</mi></msub></msub><mo maxsize="0.900em" minsize="0.900em">)</mo></mrow></mrow><mrow><msub><mi mathsize="0.900em">𝑹</mi><msub><mi mathsize="0.900em">t</mi><mi mathsize="0.900em">i</mi></msub></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo maxsize="0.900em" minsize="0.900em">(</mo><msub><mi mathsize="0.900em">𝑿</mi><mrow><msub><mi mathsize="0.900em">t</mi><mi mathsize="0.900em">i</mi></msub><mo mathsize="0.900em">−</mo></mrow></msub><mo mathsize="0.900em">,</mo><msub><mi mathsize="0.900em">𝑿</mi><msub><mi mathsize="0.900em">t</mi><mi mathsize="0.900em">i</mi></msub></msub><mo maxsize="0.900em" minsize="0.900em">)</mo></mrow></mrow></mfrac></mstyle><mo mathsize="0.900em">+</mo><mstyle displaystyle="true"><msubsup><mo maxsize="0.900em" minsize="0.900em" stretchy="true">∫</mo><mn mathsize="0.900em">0</mn><mn mathsize="0.900em">1</mn></msubsup></mstyle><mstyle displaystyle="true"><munder><mo maxsize="0.900em" minsize="0.900em" movablelimits="false" stretchy="true">∑</mo><mrow><mi mathsize="0.900em">y</mi><mo mathsize="0.900em">≠</mo><msub><mi mathsize="0.900em">𝑿</mi><mi mathsize="0.900em">t</mi></msub></mrow></munder></mstyle><mrow><mo maxsize="0.900em" minsize="0.900em">(</mo><msub><mi mathsize="0.900em">𝑹</mi><mi mathsize="0.900em">t</mi></msub><mo mathsize="0.900em">−</mo><msubsup><mi mathsize="0.900em">𝑹</mi><mi mathsize="0.900em">t</mi><mo mathsize="0.900em">′</mo></msubsup><mo maxsize="0.900em" minsize="0.900em">)</mo></mrow><mrow><mo maxsize="0.900em" minsize="0.900em">(</mo><msub><mi mathsize="0.900em">𝑿</mi><mi mathsize="0.900em">t</mi></msub><mo mathsize="0.900em">,</mo><mi mathsize="0.900em">z</mi><mo maxsize="0.900em" minsize="0.900em">)</mo></mrow><mi mathsize="0.900em">d</mi><mi mathsize="0.900em">t</mi><mo>]</mo></mrow></mrow><annotation encoding="application/x-tex">\displaystyle+\mathbb{E}_{\bm{X}_{0:1}\sim\mathbb{P}^{\prime}}\left[\sum_{t_{i}:\bm{X}_{t_{i}}\neq\bm{X}_{t_{i}-}}\log\frac{\bm{R}^{\prime}_{t_{i}}(\bm{X}_{t_{i}-},\bm{X}_{t_{i}})}{\bm{R}_{t_{i}}(\bm{X}_{t_{i}-},\bm{X}_{t_{i}})}+\int_{0}^{1}\sum_{y\neq\bm{X}_{t}}(\bm{R}_{t}-\bm{R}^{\prime}_{t})(\bm{X}_{t},z)dt\right]</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td>
<td rowspan="1" class="ltx_eqn_cell ltx_eqn_eqno ltx_align_middle ltx_align_right"><span class="ltx_tag ltx_tag_equation ltx_align_right">(83)</span></td></tr></tbody>
</table>
<p id="S9.SS7.p2.2" class="ltx_p">We can decompose the first term as:</p>
<table id="S9.EGx81" class="ltx_equationgroup ltx_eqn_align ltx_eqn_table">

<tbody id="S9.E84"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_align_right ltx_eqn_cell"><math id="S9.E84.m1" class="ltx_math_unparsed" alttext="\displaystyle\mathbb{E}_{\bm{X}_{0:1}\sim\mathbb{P}^{\prime}}\bigg[\log\frac{\mathrm{d}\pi_{0}^{\prime}}{\mathrm{d}\pi_{0}}(\bm{X}_{0})\bigg]" display="inline" intent=":literal"><semantics><mrow><msub><mi>𝔼</mi><mrow><mi>𝑿</mi><msub><mrow></mrow><mrow><mn>0</mn><mo lspace="0.278em" rspace="0.278em">:</mo><mn>1</mn></mrow></msub><mo>∼</mo><mi>ℙ</mi><msup><mrow></mrow><mo>′</mo></msup></mrow></msub><mrow><mo maxsize="2.100em" minsize="2.100em">[</mo><mi>log</mi><mstyle displaystyle="true"><mfrac><mrow><mi>d</mi><mo lspace="0em" rspace="0em">​</mo><msubsup><mi>π</mi><mn>0</mn><mo>′</mo></msubsup></mrow><mrow><mi>d</mi><mo lspace="0em" rspace="0em">​</mo><msub><mi>π</mi><mn>0</mn></msub></mrow></mfrac></mstyle><mrow><mo stretchy="false">(</mo><msub><mi>𝑿</mi><mn>0</mn></msub><mo stretchy="false">)</mo></mrow><mo maxsize="2.100em" minsize="2.100em">]</mo></mrow></mrow><annotation encoding="application/x-tex">\displaystyle\mathbb{E}_{\bm{X}_{0:1}\sim\mathbb{P}^{\prime}}\bigg[\log\frac{\mathrm{d}\pi_{0}^{\prime}}{\mathrm{d}\pi_{0}}(\bm{X}_{0})\bigg]</annotation></semantics></math></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="S9.E84.m2" class="ltx_math_unparsed" alttext="\displaystyle=\mathbb{E}_{\bm{X}_{0}\sim\pi_{0}^{\prime}}\bigg[\log\frac{\mathrm{d}\pi_{0}^{\prime}}{\mathrm{d}\pi_{0}}(\bm{X}_{0})\bigg]=D_{\text{KL}}(\pi^{\prime}_{0}\|\pi_{0})" display="inline" intent=":literal"><semantics><mrow><mo>=</mo><msub><mi>𝔼</mi><mrow><msub><mi>𝑿</mi><mn>0</mn></msub><mo>∼</mo><msubsup><mi>π</mi><mn>0</mn><mo>′</mo></msubsup></mrow></msub><mrow><mo maxsize="2.100em" minsize="2.100em">[</mo><mi>log</mi><mstyle displaystyle="true"><mfrac><mrow><mi>d</mi><mo lspace="0em" rspace="0em">​</mo><msubsup><mi>π</mi><mn>0</mn><mo>′</mo></msubsup></mrow><mrow><mi>d</mi><mo lspace="0em" rspace="0em">​</mo><msub><mi>π</mi><mn>0</mn></msub></mrow></mfrac></mstyle><mrow><mo stretchy="false">(</mo><msub><mi>𝑿</mi><mn>0</mn></msub><mo stretchy="false">)</mo></mrow><mo maxsize="2.100em" minsize="2.100em">]</mo></mrow><mo>=</mo><msub><mi>D</mi><mtext>KL</mtext></msub><mrow><mo stretchy="false">(</mo><msubsup><mi>π</mi><mn>0</mn><mo>′</mo></msubsup><mo lspace="0em" rspace="0.167em">∥</mo><msub><mi>π</mi><mn>0</mn></msub><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">\displaystyle=\mathbb{E}_{\bm{X}_{0}\sim\pi_{0}^{\prime}}\bigg[\log\frac{\mathrm{d}\pi_{0}^{\prime}}{\mathrm{d}\pi_{0}}(\bm{X}_{0})\bigg]=D_{\text{KL}}(\pi^{\prime}_{0}\|\pi_{0})</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td>
<td rowspan="1" class="ltx_eqn_cell ltx_eqn_eqno ltx_align_middle ltx_align_right"><span class="ltx_tag ltx_tag_equation ltx_align_right">(84)</span></td></tr></tbody>
</table>
</div>
<div id="S9.SS7.p3" class="ltx_para ltx_noindent">
<p id="S9.SS7.p3.1" class="ltx_p">The second term can be decomposed as:
<span id="S9.SS7.p3.1.1" class="ltx_text"></span></p>
<table id="S9.EGx82" class="ltx_equationgroup ltx_eqn_align ltx_eqn_table">

<tbody id="S9.E85"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_eqn_cell"></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="S9.E85.m1" class="ltx_math_unparsed" alttext="\displaystyle\mathbb{E}_{\bm{X}_{0:1}\sim\mathbb{P}^{\prime}}\left[\sum_{t_{u}:\bm{X}_{t_{u}}\neq\bm{X}_{t_{u}-}}\log\frac{\bm{Q}^{\prime}_{t_{u}}(\bm{X}_{t_{u}-},\bm{X}_{t_{u}})}{\bm{Q}_{t_{u}}(\bm{X}_{t_{u}-},\bm{X}_{t_{u}})}+\int_{0}^{1}\sum_{z\neq\bm{X}_{t}}(\bm{Q}_{t}-\bm{Q}^{\prime}_{t})(\bm{X}_{t},z)dt\right]" display="inline" intent=":literal"><semantics><mrow><msub><mi mathsize="0.900em">𝔼</mi><mrow><mi mathsize="0.900em">𝑿</mi><msub><mrow></mrow><mrow><mn mathsize="0.900em">0</mn><mo lspace="0.278em" mathsize="0.900em" rspace="0.278em">:</mo><mn mathsize="0.900em">1</mn></mrow></msub><mo mathsize="0.900em">∼</mo><mi mathsize="0.900em">ℙ</mi><msup><mrow></mrow><mo mathsize="0.900em">′</mo></msup></mrow></msub><mrow><mo>[</mo><mstyle displaystyle="true"><munder><mo maxsize="0.900em" minsize="0.900em" movablelimits="false" stretchy="true">∑</mo><mrow><msub><mi mathsize="0.900em">t</mi><mi mathsize="0.900em">u</mi></msub><mo lspace="0.278em" mathsize="0.900em" rspace="0.278em">:</mo><mrow><msub><mi mathsize="0.900em">𝑿</mi><msub><mi mathsize="0.900em">t</mi><mi mathsize="0.900em">u</mi></msub></msub><mo mathsize="0.900em">≠</mo><msub><mi mathsize="0.900em">𝑿</mi><mrow><msub><mi mathsize="0.900em">t</mi><mi mathsize="0.900em">u</mi></msub><mo mathsize="0.900em">−</mo></mrow></msub></mrow></mrow></munder></mstyle><mi mathsize="0.900em">log</mi><mstyle displaystyle="true"><mfrac><mrow><msubsup><mi mathsize="0.900em">𝑸</mi><msub><mi mathsize="0.900em">t</mi><mi mathsize="0.900em">u</mi></msub><mo mathsize="0.900em">′</mo></msubsup><mo lspace="0em" rspace="0em">​</mo><mrow><mo maxsize="0.900em" minsize="0.900em">(</mo><msub><mi mathsize="0.900em">𝑿</mi><mrow><msub><mi mathsize="0.900em">t</mi><mi mathsize="0.900em">u</mi></msub><mo mathsize="0.900em">−</mo></mrow></msub><mo mathsize="0.900em">,</mo><msub><mi mathsize="0.900em">𝑿</mi><msub><mi mathsize="0.900em">t</mi><mi mathsize="0.900em">u</mi></msub></msub><mo maxsize="0.900em" minsize="0.900em">)</mo></mrow></mrow><mrow><msub><mi mathsize="0.900em">𝑸</mi><msub><mi mathsize="0.900em">t</mi><mi mathsize="0.900em">u</mi></msub></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo maxsize="0.900em" minsize="0.900em">(</mo><msub><mi mathsize="0.900em">𝑿</mi><mrow><msub><mi mathsize="0.900em">t</mi><mi mathsize="0.900em">u</mi></msub><mo mathsize="0.900em">−</mo></mrow></msub><mo mathsize="0.900em">,</mo><msub><mi mathsize="0.900em">𝑿</mi><msub><mi mathsize="0.900em">t</mi><mi mathsize="0.900em">u</mi></msub></msub><mo maxsize="0.900em" minsize="0.900em">)</mo></mrow></mrow></mfrac></mstyle><mo mathsize="0.900em">+</mo><mstyle displaystyle="true"><msubsup><mo maxsize="0.900em" minsize="0.900em" stretchy="true">∫</mo><mn mathsize="0.900em">0</mn><mn mathsize="0.900em">1</mn></msubsup></mstyle><mstyle displaystyle="true"><munder><mo maxsize="0.900em" minsize="0.900em" movablelimits="false" stretchy="true">∑</mo><mrow><mi mathsize="0.900em">z</mi><mo mathsize="0.900em">≠</mo><msub><mi mathsize="0.900em">𝑿</mi><mi mathsize="0.900em">t</mi></msub></mrow></munder></mstyle><mrow><mo maxsize="0.900em" minsize="0.900em">(</mo><msub><mi mathsize="0.900em">𝑸</mi><mi mathsize="0.900em">t</mi></msub><mo mathsize="0.900em">−</mo><msubsup><mi mathsize="0.900em">𝑸</mi><mi mathsize="0.900em">t</mi><mo mathsize="0.900em">′</mo></msubsup><mo maxsize="0.900em" minsize="0.900em">)</mo></mrow><mrow><mo maxsize="0.900em" minsize="0.900em">(</mo><msub><mi mathsize="0.900em">𝑿</mi><mi mathsize="0.900em">t</mi></msub><mo mathsize="0.900em">,</mo><mi mathsize="0.900em">z</mi><mo maxsize="0.900em" minsize="0.900em">)</mo></mrow><mi mathsize="0.900em">d</mi><mi mathsize="0.900em">t</mi><mo>]</mo></mrow></mrow><annotation encoding="application/x-tex">\displaystyle\mathbb{E}_{\bm{X}_{0:1}\sim\mathbb{P}^{\prime}}\left[\sum_{t_{u}:\bm{X}_{t_{u}}\neq\bm{X}_{t_{u}-}}\log\frac{\bm{Q}^{\prime}_{t_{u}}(\bm{X}_{t_{u}-},\bm{X}_{t_{u}})}{\bm{Q}_{t_{u}}(\bm{X}_{t_{u}-},\bm{X}_{t_{u}})}+\int_{0}^{1}\sum_{z\neq\bm{X}_{t}}(\bm{Q}_{t}-\bm{Q}^{\prime}_{t})(\bm{X}_{t},z)dt\right]</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td>
<td rowspan="1" class="ltx_eqn_cell ltx_eqn_eqno ltx_align_middle ltx_align_right"><span class="ltx_tag ltx_tag_equation ltx_align_right">(85)</span></td></tr></tbody>
<tbody id="S9.E86"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_eqn_cell"></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="S9.E86.m1" class="ltx_math_unparsed" alttext="\displaystyle=\mathbb{E}_{\bm{X}_{0:1}\sim\mathbb{P}^{\prime}}\left[\sum_{t_{u}:\bm{X}_{t_{u}}\neq\bm{X}_{t_{u}-}}\log\frac{\bm{Q}^{\prime}_{t_{u}}(\bm{X}_{t_{u}-},\bm{X}_{t_{u}})}{\bm{Q}_{t_{u}}(\bm{X}_{t_{u}-},\bm{X}_{t_{u}})}\right]+\mathbb{E}_{\bm{X}_{0:1}\sim\mathbb{P}^{\prime}}\left[\int_{0}^{1}\sum_{z\neq\bm{X}_{t}}(\bm{Q}_{t}-\bm{Q}^{\prime}_{t})(\bm{X}_{t},z)dt\right]" display="inline" intent=":literal"><semantics><mrow><mo mathsize="0.900em">=</mo><msub><mi mathsize="0.900em">𝔼</mi><mrow><mi mathsize="0.900em">𝑿</mi><msub><mrow></mrow><mrow><mn mathsize="0.900em">0</mn><mo lspace="0.278em" mathsize="0.900em" rspace="0.278em">:</mo><mn mathsize="0.900em">1</mn></mrow></msub><mo mathsize="0.900em">∼</mo><mi mathsize="0.900em">ℙ</mi><msup><mrow></mrow><mo mathsize="0.900em">′</mo></msup></mrow></msub><mrow><mo>[</mo><mstyle displaystyle="true"><munder><mo maxsize="0.900em" minsize="0.900em" movablelimits="false" stretchy="true">∑</mo><mrow><msub><mi mathsize="0.900em">t</mi><mi mathsize="0.900em">u</mi></msub><mo lspace="0.278em" mathsize="0.900em" rspace="0.278em">:</mo><mrow><msub><mi mathsize="0.900em">𝑿</mi><msub><mi mathsize="0.900em">t</mi><mi mathsize="0.900em">u</mi></msub></msub><mo mathsize="0.900em">≠</mo><msub><mi mathsize="0.900em">𝑿</mi><mrow><msub><mi mathsize="0.900em">t</mi><mi mathsize="0.900em">u</mi></msub><mo mathsize="0.900em">−</mo></mrow></msub></mrow></mrow></munder></mstyle><mi mathsize="0.900em">log</mi><mstyle displaystyle="true"><mfrac><mrow><msubsup><mi mathsize="0.900em">𝑸</mi><msub><mi mathsize="0.900em">t</mi><mi mathsize="0.900em">u</mi></msub><mo mathsize="0.900em">′</mo></msubsup><mo lspace="0em" rspace="0em">​</mo><mrow><mo maxsize="0.900em" minsize="0.900em">(</mo><msub><mi mathsize="0.900em">𝑿</mi><mrow><msub><mi mathsize="0.900em">t</mi><mi mathsize="0.900em">u</mi></msub><mo mathsize="0.900em">−</mo></mrow></msub><mo mathsize="0.900em">,</mo><msub><mi mathsize="0.900em">𝑿</mi><msub><mi mathsize="0.900em">t</mi><mi mathsize="0.900em">u</mi></msub></msub><mo maxsize="0.900em" minsize="0.900em">)</mo></mrow></mrow><mrow><msub><mi mathsize="0.900em">𝑸</mi><msub><mi mathsize="0.900em">t</mi><mi mathsize="0.900em">u</mi></msub></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo maxsize="0.900em" minsize="0.900em">(</mo><msub><mi mathsize="0.900em">𝑿</mi><mrow><msub><mi mathsize="0.900em">t</mi><mi mathsize="0.900em">u</mi></msub><mo mathsize="0.900em">−</mo></mrow></msub><mo mathsize="0.900em">,</mo><msub><mi mathsize="0.900em">𝑿</mi><msub><mi mathsize="0.900em">t</mi><mi mathsize="0.900em">u</mi></msub></msub><mo maxsize="0.900em" minsize="0.900em">)</mo></mrow></mrow></mfrac></mstyle><mo>]</mo></mrow><mo mathsize="0.900em">+</mo><msub><mi mathsize="0.900em">𝔼</mi><mrow><mi mathsize="0.900em">𝑿</mi><msub><mrow></mrow><mrow><mn mathsize="0.900em">0</mn><mo lspace="0.278em" mathsize="0.900em" rspace="0.278em">:</mo><mn mathsize="0.900em">1</mn></mrow></msub><mo mathsize="0.900em">∼</mo><mi mathsize="0.900em">ℙ</mi><msup><mrow></mrow><mo mathsize="0.900em">′</mo></msup></mrow></msub><mrow><mo>[</mo><mstyle displaystyle="true"><msubsup><mo maxsize="0.900em" minsize="0.900em" stretchy="true">∫</mo><mn mathsize="0.900em">0</mn><mn mathsize="0.900em">1</mn></msubsup></mstyle><mstyle displaystyle="true"><munder><mo maxsize="0.900em" minsize="0.900em" movablelimits="false" stretchy="true">∑</mo><mrow><mi mathsize="0.900em">z</mi><mo mathsize="0.900em">≠</mo><msub><mi mathsize="0.900em">𝑿</mi><mi mathsize="0.900em">t</mi></msub></mrow></munder></mstyle><mrow><mo maxsize="0.900em" minsize="0.900em">(</mo><msub><mi mathsize="0.900em">𝑸</mi><mi mathsize="0.900em">t</mi></msub><mo mathsize="0.900em">−</mo><msubsup><mi mathsize="0.900em">𝑸</mi><mi mathsize="0.900em">t</mi><mo mathsize="0.900em">′</mo></msubsup><mo maxsize="0.900em" minsize="0.900em">)</mo></mrow><mrow><mo maxsize="0.900em" minsize="0.900em">(</mo><msub><mi mathsize="0.900em">𝑿</mi><mi mathsize="0.900em">t</mi></msub><mo mathsize="0.900em">,</mo><mi mathsize="0.900em">z</mi><mo maxsize="0.900em" minsize="0.900em">)</mo></mrow><mi mathsize="0.900em">d</mi><mi mathsize="0.900em">t</mi><mo>]</mo></mrow></mrow><annotation encoding="application/x-tex">\displaystyle=\mathbb{E}_{\bm{X}_{0:1}\sim\mathbb{P}^{\prime}}\left[\sum_{t_{u}:\bm{X}_{t_{u}}\neq\bm{X}_{t_{u}-}}\log\frac{\bm{Q}^{\prime}_{t_{u}}(\bm{X}_{t_{u}-},\bm{X}_{t_{u}})}{\bm{Q}_{t_{u}}(\bm{X}_{t_{u}-},\bm{X}_{t_{u}})}\right]+\mathbb{E}_{\bm{X}_{0:1}\sim\mathbb{P}^{\prime}}\left[\int_{0}^{1}\sum_{z\neq\bm{X}_{t}}(\bm{Q}_{t}-\bm{Q}^{\prime}_{t})(\bm{X}_{t},z)dt\right]</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td>
<td rowspan="1" class="ltx_eqn_cell ltx_eqn_eqno ltx_align_middle ltx_align_right"><span class="ltx_tag ltx_tag_equation ltx_align_right">(86)</span></td></tr></tbody>
</table>
<p id="S9.SS7.p3.2" class="ltx_p">For the first component, we can consider the time discretization and take the limit for <math id="S9.SS7.p3.m1" class="ltx_Math" alttext="\Delta t\to 0" display="inline" intent=":literal"><semantics><mrow><mrow><mi mathvariant="normal">Δ</mi><mo lspace="0em" rspace="0em">​</mo><mi>t</mi></mrow><mo stretchy="false">→</mo><mn>0</mn></mrow><annotation encoding="application/x-tex">\Delta t\to 0</annotation></semantics></math> to get:</p>
<table id="S9.EGx83" class="ltx_equationgroup ltx_eqn_align ltx_eqn_table">

<tbody id="S9.Ex31"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_align_right ltx_eqn_cell"><math id="S9.Ex31.m1" class="ltx_math_unparsed" alttext="\displaystyle\mathbb{E}_{\bm{X}_{0:1}\sim\mathbb{P}^{\prime}}" display="inline" intent=":literal"><semantics><mrow><mi>𝔼</mi><msub><mrow></mrow><mrow><mi>𝑿</mi><msub><mrow></mrow><mrow><mn>0</mn><mo lspace="0.278em" rspace="0.278em">:</mo><mn>1</mn></mrow></msub><mo>∼</mo><mi>ℙ</mi><msup><mrow></mrow><mo>′</mo></msup></mrow></msub></mrow><annotation encoding="application/x-tex">\displaystyle\mathbb{E}_{\bm{X}_{0:1}\sim\mathbb{P}^{\prime}}</annotation></semantics></math></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="S9.Ex31.m2" class="ltx_math_unparsed" alttext="\displaystyle\bigg[\sum_{k=0}^{K-1}\bm{1}[\bm{X}_{t_{k+1}}\neq\bm{X}_{t_{k}}]\log\frac{\bm{Q}^{\prime}_{t_{u}}(\bm{X}_{t_{k}},\bm{X}_{t_{k+1}})}{\bm{Q}_{t_{u}}(\bm{X}_{t_{k}},\bm{X}_{t_{k+1}})}\bigg]" display="inline" intent=":literal"><semantics><mrow><mo maxsize="2.100em" minsize="2.100em">[</mo><mstyle displaystyle="true"><munderover><mo movablelimits="false">∑</mo><mrow><mi>k</mi><mo>=</mo><mn>0</mn></mrow><mrow><mi>K</mi><mo>−</mo><mn>1</mn></mrow></munderover></mstyle><mn>𝟏</mn><mrow><mo stretchy="false">[</mo><msub><mi>𝑿</mi><msub><mi>t</mi><mrow><mi>k</mi><mo>+</mo><mn>1</mn></mrow></msub></msub><mo>≠</mo><msub><mi>𝑿</mi><msub><mi>t</mi><mi>k</mi></msub></msub><mo rspace="0.167em" stretchy="false">]</mo></mrow><mi>log</mi><mstyle displaystyle="true"><mfrac><mrow><msubsup><mi>𝑸</mi><msub><mi>t</mi><mi>u</mi></msub><mo>′</mo></msubsup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mi>𝑿</mi><msub><mi>t</mi><mi>k</mi></msub></msub><mo>,</mo><msub><mi>𝑿</mi><msub><mi>t</mi><mrow><mi>k</mi><mo>+</mo><mn>1</mn></mrow></msub></msub><mo stretchy="false">)</mo></mrow></mrow><mrow><msub><mi>𝑸</mi><msub><mi>t</mi><mi>u</mi></msub></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mi>𝑿</mi><msub><mi>t</mi><mi>k</mi></msub></msub><mo>,</mo><msub><mi>𝑿</mi><msub><mi>t</mi><mrow><mi>k</mi><mo>+</mo><mn>1</mn></mrow></msub></msub><mo stretchy="false">)</mo></mrow></mrow></mfrac></mstyle><mo maxsize="2.100em" minsize="2.100em">]</mo></mrow><annotation encoding="application/x-tex">\displaystyle\bigg[\sum_{k=0}^{K-1}\bm{1}[\bm{X}_{t_{k+1}}\neq\bm{X}_{t_{k}}]\log\frac{\bm{Q}^{\prime}_{t_{u}}(\bm{X}_{t_{k}},\bm{X}_{t_{k+1}})}{\bm{Q}_{t_{u}}(\bm{X}_{t_{k}},\bm{X}_{t_{k+1}})}\bigg]</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
<tbody id="S9.Ex32"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_eqn_cell"></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="S9.Ex32.m1" class="ltx_math_unparsed" alttext="\displaystyle=\sum_{k=0}^{K-1}\mathbb{E}_{\mathbb{P}^{\prime}(\bm{X}_{t_{k}}),\mathbb{P}^{\prime}(\bm{X}_{t_{k+1}}|\bm{X}_{t_{k}})}\bigg[\bm{1}[\bm{X}_{t_{k+1}}\neq\bm{X}_{t_{k}}]\log\frac{\bm{Q}^{\prime}_{t_{u}}(\bm{X}_{t_{k}},\bm{X}_{t_{k+1}})}{\bm{Q}_{t_{u}}(\bm{X}_{t_{k}},\bm{X}_{t_{k+1}})}\bigg]" display="inline" intent=":literal"><semantics><mrow><mo>=</mo><mstyle displaystyle="true"><munderover><mo movablelimits="false">∑</mo><mrow><mi>k</mi><mo>=</mo><mn>0</mn></mrow><mrow><mi>K</mi><mo>−</mo><mn>1</mn></mrow></munderover></mstyle><msub><mi>𝔼</mi><mrow><mrow><msup><mi>ℙ</mi><mo>′</mo></msup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mi>𝑿</mi><msub><mi>t</mi><mi>k</mi></msub></msub><mo stretchy="false">)</mo></mrow></mrow><mo>,</mo><mrow><msup><mi>ℙ</mi><mo>′</mo></msup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mi>𝑿</mi><msub><mi>t</mi><mrow><mi>k</mi><mo>+</mo><mn>1</mn></mrow></msub></msub><mo lspace="0em" rspace="0em">|</mo><msub><mi>𝑿</mi><msub><mi>t</mi><mi>k</mi></msub></msub><mo stretchy="false">)</mo></mrow></mrow></mrow></msub><mrow><mo maxsize="2.100em" minsize="2.100em">[</mo><mn>𝟏</mn><mrow><mo stretchy="false">[</mo><msub><mi>𝑿</mi><msub><mi>t</mi><mrow><mi>k</mi><mo>+</mo><mn>1</mn></mrow></msub></msub><mo>≠</mo><msub><mi>𝑿</mi><msub><mi>t</mi><mi>k</mi></msub></msub><mo rspace="0.167em" stretchy="false">]</mo></mrow><mi>log</mi><mstyle displaystyle="true"><mfrac><mrow><msubsup><mi>𝑸</mi><msub><mi>t</mi><mi>u</mi></msub><mo>′</mo></msubsup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mi>𝑿</mi><msub><mi>t</mi><mi>k</mi></msub></msub><mo>,</mo><msub><mi>𝑿</mi><msub><mi>t</mi><mrow><mi>k</mi><mo>+</mo><mn>1</mn></mrow></msub></msub><mo stretchy="false">)</mo></mrow></mrow><mrow><msub><mi>𝑸</mi><msub><mi>t</mi><mi>u</mi></msub></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mi>𝑿</mi><msub><mi>t</mi><mi>k</mi></msub></msub><mo>,</mo><msub><mi>𝑿</mi><msub><mi>t</mi><mrow><mi>k</mi><mo>+</mo><mn>1</mn></mrow></msub></msub><mo stretchy="false">)</mo></mrow></mrow></mfrac></mstyle><mo maxsize="2.100em" minsize="2.100em">]</mo></mrow></mrow><annotation encoding="application/x-tex">\displaystyle=\sum_{k=0}^{K-1}\mathbb{E}_{\mathbb{P}^{\prime}(\bm{X}_{t_{k}}),\mathbb{P}^{\prime}(\bm{X}_{t_{k+1}}|\bm{X}_{t_{k}})}\bigg[\bm{1}[\bm{X}_{t_{k+1}}\neq\bm{X}_{t_{k}}]\log\frac{\bm{Q}^{\prime}_{t_{u}}(\bm{X}_{t_{k}},\bm{X}_{t_{k+1}})}{\bm{Q}_{t_{u}}(\bm{X}_{t_{k}},\bm{X}_{t_{k+1}})}\bigg]</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
<tbody id="S9.Ex33"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_eqn_cell"></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="S9.Ex33.m1" class="ltx_Math" alttext="\displaystyle=\sum_{k=0}^{K-1}\mathbb{E}_{\mathbb{P}^{\prime}(\bm{X}_{t_{k}})}\sum_{z\neq\bm{X}_{t_{k}}}\left[\mathbb{P}^{\prime}(z|\bm{X}_{t_{k}})\log\frac{\bm{Q}^{\prime}_{t_{u}}(\bm{X}_{t_{k}},z)}{\bm{Q}_{t_{u}}(\bm{X}_{t_{k}},z)}\right]" display="inline" intent=":literal"><semantics><mrow><mphantom></mphantom><mo>=</mo><mrow><mstyle displaystyle="true"><munderover><mo movablelimits="false">∑</mo><mrow><mi>k</mi><mo>=</mo><mn>0</mn></mrow><mrow><mi>K</mi><mo>−</mo><mn>1</mn></mrow></munderover></mstyle><mrow><msub><mi>𝔼</mi><mrow><msup><mi>ℙ</mi><mo>′</mo></msup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mi>𝑿</mi><msub><mi>t</mi><mi>k</mi></msub></msub><mo stretchy="false">)</mo></mrow></mrow></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mstyle displaystyle="true"><munder><mo movablelimits="false">∑</mo><mrow><mi>z</mi><mo>≠</mo><msub><mi>𝑿</mi><msub><mi>t</mi><mi>k</mi></msub></msub></mrow></munder></mstyle><mrow><mo>[</mo><mrow><msup><mi>ℙ</mi><mo>′</mo></msup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>z</mi><mo lspace="0em" rspace="0em">|</mo><msub><mi>𝑿</mi><msub><mi>t</mi><mi>k</mi></msub></msub><mo stretchy="false">)</mo></mrow><mo lspace="0.167em" rspace="0em">​</mo><mrow><mi>log</mi><mo lspace="0.167em">⁡</mo><mstyle displaystyle="true"><mfrac><mrow><msubsup><mi>𝑸</mi><msub><mi>t</mi><mi>u</mi></msub><mo>′</mo></msubsup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mi>𝑿</mi><msub><mi>t</mi><mi>k</mi></msub></msub><mo>,</mo><mi>z</mi><mo stretchy="false">)</mo></mrow></mrow><mrow><msub><mi>𝑸</mi><msub><mi>t</mi><mi>u</mi></msub></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mi>𝑿</mi><msub><mi>t</mi><mi>k</mi></msub></msub><mo>,</mo><mi>z</mi><mo stretchy="false">)</mo></mrow></mrow></mfrac></mstyle></mrow></mrow><mo>]</mo></mrow></mrow></mrow></mrow></mrow><annotation encoding="application/x-tex">\displaystyle=\sum_{k=0}^{K-1}\mathbb{E}_{\mathbb{P}^{\prime}(\bm{X}_{t_{k}})}\sum_{z\neq\bm{X}_{t_{k}}}\left[\mathbb{P}^{\prime}(z|\bm{X}_{t_{k}})\log\frac{\bm{Q}^{\prime}_{t_{u}}(\bm{X}_{t_{k}},z)}{\bm{Q}_{t_{u}}(\bm{X}_{t_{k}},z)}\right]</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
<tbody id="S9.Ex34"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_eqn_cell"></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="S9.Ex34.m1" class="ltx_Math" alttext="\displaystyle=\sum_{k=0}^{K-1}\mathbb{E}_{\mathbb{P}^{\prime}(\bm{X}_{t_{k}})}\sum_{z\neq\bm{X}_{t_{k}}}\left[\Delta t\bm{Q}_{t_{k}}^{\prime}(\bm{X}_{t_{k}},z)\log\frac{\bm{Q}^{\prime}_{t_{k}}(\bm{X}_{t_{k}},z)}{\bm{Q}_{t_{k}}(\bm{X}_{t_{k}},z)}+\mathcal{O}(\Delta t^{2})\right]" display="inline" intent=":literal"><semantics><mrow><mphantom></mphantom><mo>=</mo><mrow><mstyle displaystyle="true"><munderover><mo movablelimits="false">∑</mo><mrow><mi>k</mi><mo>=</mo><mn>0</mn></mrow><mrow><mi>K</mi><mo>−</mo><mn>1</mn></mrow></munderover></mstyle><mrow><msub><mi>𝔼</mi><mrow><msup><mi>ℙ</mi><mo>′</mo></msup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mi>𝑿</mi><msub><mi>t</mi><mi>k</mi></msub></msub><mo stretchy="false">)</mo></mrow></mrow></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mstyle displaystyle="true"><munder><mo movablelimits="false">∑</mo><mrow><mi>z</mi><mo>≠</mo><msub><mi>𝑿</mi><msub><mi>t</mi><mi>k</mi></msub></msub></mrow></munder></mstyle><mrow><mo>[</mo><mrow><mrow><mi mathvariant="normal">Δ</mi><mo lspace="0em" rspace="0em">​</mo><mi>t</mi><mo lspace="0em" rspace="0em">​</mo><msubsup><mi>𝑸</mi><msub><mi>t</mi><mi>k</mi></msub><mo>′</mo></msubsup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mi>𝑿</mi><msub><mi>t</mi><mi>k</mi></msub></msub><mo>,</mo><mi>z</mi><mo stretchy="false">)</mo></mrow><mo lspace="0.167em" rspace="0em">​</mo><mrow><mi>log</mi><mo lspace="0.167em">⁡</mo><mstyle displaystyle="true"><mfrac><mrow><msubsup><mi>𝑸</mi><msub><mi>t</mi><mi>k</mi></msub><mo>′</mo></msubsup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mi>𝑿</mi><msub><mi>t</mi><mi>k</mi></msub></msub><mo>,</mo><mi>z</mi><mo stretchy="false">)</mo></mrow></mrow><mrow><msub><mi>𝑸</mi><msub><mi>t</mi><mi>k</mi></msub></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mi>𝑿</mi><msub><mi>t</mi><mi>k</mi></msub></msub><mo>,</mo><mi>z</mi><mo stretchy="false">)</mo></mrow></mrow></mfrac></mstyle></mrow></mrow><mo>+</mo><mrow><mi class="ltx_font_mathcaligraphic">𝒪</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mrow><mi mathvariant="normal">Δ</mi><mo lspace="0em" rspace="0em">​</mo><msup><mi>t</mi><mn>2</mn></msup></mrow><mo stretchy="false">)</mo></mrow></mrow></mrow><mo>]</mo></mrow></mrow></mrow></mrow></mrow><annotation encoding="application/x-tex">\displaystyle=\sum_{k=0}^{K-1}\mathbb{E}_{\mathbb{P}^{\prime}(\bm{X}_{t_{k}})}\sum_{z\neq\bm{X}_{t_{k}}}\left[\Delta t\bm{Q}_{t_{k}}^{\prime}(\bm{X}_{t_{k}},z)\log\frac{\bm{Q}^{\prime}_{t_{k}}(\bm{X}_{t_{k}},z)}{\bm{Q}_{t_{k}}(\bm{X}_{t_{k}},z)}+\mathcal{O}(\Delta t^{2})\right]</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
<tbody id="S9.E87"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_eqn_cell"></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="S9.E87.m1" class="ltx_math_unparsed" alttext="\displaystyle\underset{\Delta t\to 0}{=}\mathbb{E}_{\bm{X}_{0:1}\sim\mathbb{P}^{\prime}}\left[\int_{0}^{1}\sum_{z\neq\bm{X}_{t}}\bm{Q}^{\prime}_{t}\log\frac{\bm{Q}^{\prime}_{t}}{\bm{Q}_{t}}(\bm{X}_{t},z)dt\right]" display="inline" intent=":literal"><semantics><mrow><munder accentunder="true"><mo>=</mo><mrow><mrow><mi mathsize="0.700em" mathvariant="normal">Δ</mi><mo lspace="0em" rspace="0em">​</mo><mi mathsize="0.700em">t</mi></mrow><mo mathsize="0.700em" stretchy="false">→</mo><mn mathsize="0.700em">0</mn></mrow></munder><msub><mi>𝔼</mi><mrow><mi>𝑿</mi><msub><mrow></mrow><mrow><mn>0</mn><mo lspace="0.278em" rspace="0.278em">:</mo><mn>1</mn></mrow></msub><mo>∼</mo><mi>ℙ</mi><msup><mrow></mrow><mo>′</mo></msup></mrow></msub><mrow><mo>[</mo><mstyle displaystyle="true"><msubsup><mo>∫</mo><mn>0</mn><mn>1</mn></msubsup></mstyle><mstyle displaystyle="true"><munder><mo movablelimits="false">∑</mo><mrow><mi>z</mi><mo>≠</mo><msub><mi>𝑿</mi><mi>t</mi></msub></mrow></munder></mstyle><msubsup><mi>𝑸</mi><mi>t</mi><mo>′</mo></msubsup><mi>log</mi><mstyle displaystyle="true"><mfrac><msubsup><mi>𝑸</mi><mi>t</mi><mo>′</mo></msubsup><msub><mi>𝑸</mi><mi>t</mi></msub></mfrac></mstyle><mrow><mo stretchy="false">(</mo><msub><mi>𝑿</mi><mi>t</mi></msub><mo>,</mo><mi>z</mi><mo stretchy="false">)</mo></mrow><mi>d</mi><mi>t</mi><mo>]</mo></mrow></mrow><annotation encoding="application/x-tex">\displaystyle\underset{\Delta t\to 0}{=}\mathbb{E}_{\bm{X}_{0:1}\sim\mathbb{P}^{\prime}}\left[\int_{0}^{1}\sum_{z\neq\bm{X}_{t}}\bm{Q}^{\prime}_{t}\log\frac{\bm{Q}^{\prime}_{t}}{\bm{Q}_{t}}(\bm{X}_{t},z)dt\right]</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td>
<td rowspan="1" class="ltx_eqn_cell ltx_eqn_eqno ltx_align_middle ltx_align_right"><span class="ltx_tag ltx_tag_equation ltx_align_right">(87)</span></td></tr></tbody>
</table>
<p id="S9.SS7.p3.3" class="ltx_p">Then, summing with the second integral, we get:</p>
<table id="S9.EGx84" class="ltx_equationgroup ltx_eqn_align ltx_eqn_table">

<tbody id="S9.Ex35"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_align_right ltx_eqn_cell"><math id="S9.Ex35.m1" class="ltx_math_unparsed" alttext="\displaystyle\mathbb{E}_{\bm{X}_{0:1}\sim\mathbb{P}^{\prime}}" display="inline" intent=":literal"><semantics><mrow><mi>𝔼</mi><msub><mrow></mrow><mrow><mi>𝑿</mi><msub><mrow></mrow><mrow><mn>0</mn><mo lspace="0.278em" rspace="0.278em">:</mo><mn>1</mn></mrow></msub><mo>∼</mo><mi>ℙ</mi><msup><mrow></mrow><mo>′</mo></msup></mrow></msub></mrow><annotation encoding="application/x-tex">\displaystyle\mathbb{E}_{\bm{X}_{0:1}\sim\mathbb{P}^{\prime}}</annotation></semantics></math></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="S9.Ex35.m2" class="ltx_math_unparsed" alttext="\displaystyle\left[\int_{0}^{1}\sum_{z\neq\bm{X}_{t}}\bm{Q}^{\prime}_{t}\log\frac{\bm{Q}^{\prime}_{t}}{\bm{Q}_{t}}(\bm{X}_{t},z)dt\right]+\mathbb{E}_{\bm{X}_{0:1}\sim\mathbb{P}^{\prime}}\bigg[\int_{0}^{1}\sum_{z\neq\bm{X}_{t}}(\bm{Q}_{t}-\bm{Q}^{\prime}_{t})(\bm{X}_{t},z)dt\bigg]" display="inline" intent=":literal"><semantics><mrow><mrow><mo>[</mo><mstyle displaystyle="true"><msubsup><mo>∫</mo><mn>0</mn><mn>1</mn></msubsup></mstyle><mstyle displaystyle="true"><munder><mo movablelimits="false">∑</mo><mrow><mi>z</mi><mo>≠</mo><msub><mi>𝑿</mi><mi>t</mi></msub></mrow></munder></mstyle><msubsup><mi>𝑸</mi><mi>t</mi><mo>′</mo></msubsup><mi>log</mi><mstyle displaystyle="true"><mfrac><msubsup><mi>𝑸</mi><mi>t</mi><mo>′</mo></msubsup><msub><mi>𝑸</mi><mi>t</mi></msub></mfrac></mstyle><mrow><mo stretchy="false">(</mo><msub><mi>𝑿</mi><mi>t</mi></msub><mo>,</mo><mi>z</mi><mo stretchy="false">)</mo></mrow><mi>d</mi><mi>t</mi><mo>]</mo></mrow><mo>+</mo><msub><mi>𝔼</mi><mrow><mi>𝑿</mi><msub><mrow></mrow><mrow><mn>0</mn><mo lspace="0.278em" rspace="0.278em">:</mo><mn>1</mn></mrow></msub><mo>∼</mo><mi>ℙ</mi><msup><mrow></mrow><mo>′</mo></msup></mrow></msub><mrow><mo maxsize="2.100em" minsize="2.100em">[</mo><mstyle displaystyle="true"><msubsup><mo>∫</mo><mn>0</mn><mn>1</mn></msubsup></mstyle><mstyle displaystyle="true"><munder><mo movablelimits="false">∑</mo><mrow><mi>z</mi><mo>≠</mo><msub><mi>𝑿</mi><mi>t</mi></msub></mrow></munder></mstyle><mrow><mo stretchy="false">(</mo><msub><mi>𝑸</mi><mi>t</mi></msub><mo>−</mo><msubsup><mi>𝑸</mi><mi>t</mi><mo>′</mo></msubsup><mo stretchy="false">)</mo></mrow><mrow><mo stretchy="false">(</mo><msub><mi>𝑿</mi><mi>t</mi></msub><mo>,</mo><mi>z</mi><mo stretchy="false">)</mo></mrow><mi>d</mi><mi>t</mi><mo maxsize="2.100em" minsize="2.100em">]</mo></mrow></mrow><annotation encoding="application/x-tex">\displaystyle\left[\int_{0}^{1}\sum_{z\neq\bm{X}_{t}}\bm{Q}^{\prime}_{t}\log\frac{\bm{Q}^{\prime}_{t}}{\bm{Q}_{t}}(\bm{X}_{t},z)dt\right]+\mathbb{E}_{\bm{X}_{0:1}\sim\mathbb{P}^{\prime}}\bigg[\int_{0}^{1}\sum_{z\neq\bm{X}_{t}}(\bm{Q}_{t}-\bm{Q}^{\prime}_{t})(\bm{X}_{t},z)dt\bigg]</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
<tbody id="S9.E88"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_eqn_cell"></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="S9.E88.m1" class="ltx_math_unparsed" alttext="\displaystyle=\mathbb{E}_{\bm{X}_{0:1}\sim\mathbb{P}^{\prime}}\int_{0}^{1}\sum_{z\neq\bm{X}_{t}}\bigg[\left(\bm{Q}^{\prime}_{t}\log\frac{\bm{Q}^{\prime}_{t}}{\bm{Q}_{t}}+\bm{Q}_{t}-\bm{Q}^{\prime}_{t}\right)(\bm{X}_{t},z)\bigg]dt" display="inline" intent=":literal"><semantics><mrow><mo>=</mo><msub><mi>𝔼</mi><mrow><mi>𝑿</mi><msub><mrow></mrow><mrow><mn>0</mn><mo lspace="0.278em" rspace="0.278em">:</mo><mn>1</mn></mrow></msub><mo>∼</mo><mi>ℙ</mi><msup><mrow></mrow><mo>′</mo></msup></mrow></msub><mstyle displaystyle="true"><msubsup><mo>∫</mo><mn>0</mn><mn>1</mn></msubsup></mstyle><mstyle displaystyle="true"><munder><mo movablelimits="false">∑</mo><mrow><mi>z</mi><mo>≠</mo><msub><mi>𝑿</mi><mi>t</mi></msub></mrow></munder></mstyle><mrow><mo maxsize="2.100em" minsize="2.100em">[</mo><mrow><mo>(</mo><msubsup><mi>𝑸</mi><mi>t</mi><mo>′</mo></msubsup><mi>log</mi><mstyle displaystyle="true"><mfrac><msubsup><mi>𝑸</mi><mi>t</mi><mo>′</mo></msubsup><msub><mi>𝑸</mi><mi>t</mi></msub></mfrac></mstyle><mo>+</mo><msub><mi>𝑸</mi><mi>t</mi></msub><mo>−</mo><msubsup><mi>𝑸</mi><mi>t</mi><mo>′</mo></msubsup><mo>)</mo></mrow><mrow><mo stretchy="false">(</mo><msub><mi>𝑿</mi><mi>t</mi></msub><mo>,</mo><mi>z</mi><mo stretchy="false">)</mo></mrow><mo maxsize="2.100em" minsize="2.100em">]</mo></mrow><mi>d</mi><mi>t</mi></mrow><annotation encoding="application/x-tex">\displaystyle=\mathbb{E}_{\bm{X}_{0:1}\sim\mathbb{P}^{\prime}}\int_{0}^{1}\sum_{z\neq\bm{X}_{t}}\bigg[\left(\bm{Q}^{\prime}_{t}\log\frac{\bm{Q}^{\prime}_{t}}{\bm{Q}_{t}}+\bm{Q}_{t}-\bm{Q}^{\prime}_{t}\right)(\bm{X}_{t},z)\bigg]dt</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td>
<td rowspan="1" class="ltx_eqn_cell ltx_eqn_eqno ltx_align_middle ltx_align_right"><span class="ltx_tag ltx_tag_equation ltx_align_right">(88)</span></td></tr></tbody>
</table>
<p id="S9.SS7.p3.4" class="ltx_p">Applying the same procedure from lines (<a href="#S9.E85" title="Equation 85 ‣ 9.7 Radon-Nikodym Derivative Between Joint CTMCs ‣ 9 Theoretical Proofs ‣ A2D2: Fine-Tuning Any-Length Discrete Diffusion for Adaptive Decoding" class="ltx_ref"><span class="ltx_text ltx_ref_tag">85</span></a>) to (<a href="#S9.E88" title="Equation 88 ‣ 9.7 Radon-Nikodym Derivative Between Joint CTMCs ‣ 9 Theoretical Proofs ‣ A2D2: Fine-Tuning Any-Length Discrete Diffusion for Adaptive Decoding" class="ltx_ref"><span class="ltx_text ltx_ref_tag">88</span></a>) to the insertion rates, we get:</p>
<table id="S9.EGx85" class="ltx_equationgroup ltx_eqn_align ltx_eqn_table">

<tbody id="S9.Ex36"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_align_right ltx_eqn_cell"><math id="S9.Ex36.m1" class="ltx_math_unparsed" alttext="\displaystyle\mathbb{E}_{\bm{X}_{0:1}\sim\mathbb{P}^{\prime}}" display="inline" intent=":literal"><semantics><mrow><mi>𝔼</mi><msub><mrow></mrow><mrow><mi>𝑿</mi><msub><mrow></mrow><mrow><mn>0</mn><mo lspace="0.278em" rspace="0.278em">:</mo><mn>1</mn></mrow></msub><mo>∼</mo><mi>ℙ</mi><msup><mrow></mrow><mo>′</mo></msup></mrow></msub></mrow><annotation encoding="application/x-tex">\displaystyle\mathbb{E}_{\bm{X}_{0:1}\sim\mathbb{P}^{\prime}}</annotation></semantics></math></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="S9.Ex36.m2" class="ltx_math_unparsed" alttext="\displaystyle\left[\sum_{t_{i}:\bm{X}_{t_{i}}\neq\bm{X}_{t_{i}-}}\log\frac{\bm{R}^{\prime}_{t_{i}}(\bm{X}_{t_{i}-},\bm{X}_{t_{i}})}{\bm{R}_{t_{i}}(\bm{X}_{t_{i}-},\bm{X}_{t_{i}})}+\int_{0}^{1}\sum_{y\neq\bm{X}_{t}}(\bm{R}_{t}-\bm{R}^{\prime}_{t})(\bm{X}_{t},z)dt\right]" display="inline" intent=":literal"><semantics><mrow><mo>[</mo><mstyle displaystyle="true"><munder><mo movablelimits="false">∑</mo><mrow><msub><mi>t</mi><mi>i</mi></msub><mo lspace="0.278em" rspace="0.278em">:</mo><mrow><msub><mi>𝑿</mi><msub><mi>t</mi><mi>i</mi></msub></msub><mo>≠</mo><msub><mi>𝑿</mi><mrow><msub><mi>t</mi><mi>i</mi></msub><mo>−</mo></mrow></msub></mrow></mrow></munder></mstyle><mi>log</mi><mstyle displaystyle="true"><mfrac><mrow><msubsup><mi>𝑹</mi><msub><mi>t</mi><mi>i</mi></msub><mo>′</mo></msubsup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mi>𝑿</mi><mrow><msub><mi>t</mi><mi>i</mi></msub><mo>−</mo></mrow></msub><mo>,</mo><msub><mi>𝑿</mi><msub><mi>t</mi><mi>i</mi></msub></msub><mo stretchy="false">)</mo></mrow></mrow><mrow><msub><mi>𝑹</mi><msub><mi>t</mi><mi>i</mi></msub></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mi>𝑿</mi><mrow><msub><mi>t</mi><mi>i</mi></msub><mo>−</mo></mrow></msub><mo>,</mo><msub><mi>𝑿</mi><msub><mi>t</mi><mi>i</mi></msub></msub><mo stretchy="false">)</mo></mrow></mrow></mfrac></mstyle><mo>+</mo><mstyle displaystyle="true"><msubsup><mo>∫</mo><mn>0</mn><mn>1</mn></msubsup></mstyle><mstyle displaystyle="true"><munder><mo movablelimits="false">∑</mo><mrow><mi>y</mi><mo>≠</mo><msub><mi>𝑿</mi><mi>t</mi></msub></mrow></munder></mstyle><mrow><mo stretchy="false">(</mo><msub><mi>𝑹</mi><mi>t</mi></msub><mo>−</mo><msubsup><mi>𝑹</mi><mi>t</mi><mo>′</mo></msubsup><mo stretchy="false">)</mo></mrow><mrow><mo stretchy="false">(</mo><msub><mi>𝑿</mi><mi>t</mi></msub><mo>,</mo><mi>z</mi><mo stretchy="false">)</mo></mrow><mi>d</mi><mi>t</mi><mo>]</mo></mrow><annotation encoding="application/x-tex">\displaystyle\left[\sum_{t_{i}:\bm{X}_{t_{i}}\neq\bm{X}_{t_{i}-}}\log\frac{\bm{R}^{\prime}_{t_{i}}(\bm{X}_{t_{i}-},\bm{X}_{t_{i}})}{\bm{R}_{t_{i}}(\bm{X}_{t_{i}-},\bm{X}_{t_{i}})}+\int_{0}^{1}\sum_{y\neq\bm{X}_{t}}(\bm{R}_{t}-\bm{R}^{\prime}_{t})(\bm{X}_{t},z)dt\right]</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
<tbody id="S9.E89"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_eqn_cell"></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="S9.E89.m1" class="ltx_math_unparsed" alttext="\displaystyle=\mathbb{E}_{\bm{X}_{0:1}\sim\mathbb{P}^{\prime}}\int_{0}^{1}\sum_{z\neq\bm{X}_{t}}\left[\left(\bm{R}^{\prime}_{t}\log\frac{\bm{R}^{\prime}_{t}}{\bm{R}_{t}}+\bm{R}_{t}-\bm{R}^{\prime}_{t}\right)(\bm{X}_{t},z)\right]dt" display="inline" intent=":literal"><semantics><mrow><mo>=</mo><msub><mi>𝔼</mi><mrow><mi>𝑿</mi><msub><mrow></mrow><mrow><mn>0</mn><mo lspace="0.278em" rspace="0.278em">:</mo><mn>1</mn></mrow></msub><mo>∼</mo><mi>ℙ</mi><msup><mrow></mrow><mo>′</mo></msup></mrow></msub><mstyle displaystyle="true"><msubsup><mo>∫</mo><mn>0</mn><mn>1</mn></msubsup></mstyle><mstyle displaystyle="true"><munder><mo movablelimits="false">∑</mo><mrow><mi>z</mi><mo>≠</mo><msub><mi>𝑿</mi><mi>t</mi></msub></mrow></munder></mstyle><mrow><mo>[</mo><mrow><mo>(</mo><msubsup><mi>𝑹</mi><mi>t</mi><mo>′</mo></msubsup><mi>log</mi><mstyle displaystyle="true"><mfrac><msubsup><mi>𝑹</mi><mi>t</mi><mo>′</mo></msubsup><msub><mi>𝑹</mi><mi>t</mi></msub></mfrac></mstyle><mo>+</mo><msub><mi>𝑹</mi><mi>t</mi></msub><mo>−</mo><msubsup><mi>𝑹</mi><mi>t</mi><mo>′</mo></msubsup><mo>)</mo></mrow><mrow><mo stretchy="false">(</mo><msub><mi>𝑿</mi><mi>t</mi></msub><mo>,</mo><mi>z</mi><mo stretchy="false">)</mo></mrow><mo>]</mo></mrow><mi>d</mi><mi>t</mi></mrow><annotation encoding="application/x-tex">\displaystyle=\mathbb{E}_{\bm{X}_{0:1}\sim\mathbb{P}^{\prime}}\int_{0}^{1}\sum_{z\neq\bm{X}_{t}}\left[\left(\bm{R}^{\prime}_{t}\log\frac{\bm{R}^{\prime}_{t}}{\bm{R}_{t}}+\bm{R}_{t}-\bm{R}^{\prime}_{t}\right)(\bm{X}_{t},z)\right]dt</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td>
<td rowspan="1" class="ltx_eqn_cell ltx_eqn_eqno ltx_align_middle ltx_align_right"><span class="ltx_tag ltx_tag_equation ltx_align_right">(89)</span></td></tr></tbody>
</table>
<p id="S9.SS7.p3.5" class="ltx_p">Putting these terms together, we get that the KL divergence between the joint CTMCs <math id="S9.SS7.p3.m2" class="ltx_Math" alttext="\mathbb{P}" display="inline" intent=":literal"><semantics><mi>ℙ</mi><annotation encoding="application/x-tex">\mathbb{P}</annotation></semantics></math> and <math id="S9.SS7.p3.m3" class="ltx_Math" alttext="\mathbb{P}^{\prime}" display="inline" intent=":literal"><semantics><msup><mi>ℙ</mi><mo>′</mo></msup><annotation encoding="application/x-tex">\mathbb{P}^{\prime}</annotation></semantics></math> is given by:
<span id="S9.SS7.p3.5.1" class="ltx_text"></span></p>
<table id="S9.EGx86" class="ltx_equationgroup ltx_eqn_align ltx_eqn_table">

<tbody id="S9.Ex37"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_align_right ltx_eqn_cell"><math id="S9.Ex37.m1" class="ltx_math_unparsed" alttext="\displaystyle D_{\text{KL}}(\mathbb{P}^{\prime}\|\mathbb{P})" display="inline" intent=":literal"><semantics><mrow><msub><mi mathsize="0.900em">D</mi><mtext mathsize="0.900em">KL</mtext></msub><mrow><mo maxsize="0.900em" minsize="0.900em">(</mo><msup><mi mathsize="0.900em">ℙ</mi><mo mathsize="0.900em">′</mo></msup><mo lspace="0em" mathsize="0.900em" rspace="0.167em">∥</mo><mi mathsize="0.900em">ℙ</mi><mo maxsize="0.900em" minsize="0.900em">)</mo></mrow></mrow><annotation encoding="application/x-tex">\displaystyle D_{\text{KL}}(\mathbb{P}^{\prime}\|\mathbb{P})</annotation></semantics></math></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="S9.Ex37.m2" class="ltx_math_unparsed" alttext="\displaystyle=D_{\text{KL}}(\mathbb{P}_{0}^{\prime}\|\mathbb{P}_{0})" display="inline" intent=":literal"><semantics><mrow><mo mathsize="0.900em">=</mo><msub><mi mathsize="0.900em">D</mi><mtext mathsize="0.900em">KL</mtext></msub><mrow><mo maxsize="0.900em" minsize="0.900em">(</mo><msubsup><mi mathsize="0.900em">ℙ</mi><mn mathsize="0.900em">0</mn><mo mathsize="0.900em">′</mo></msubsup><mo lspace="0em" mathsize="0.900em" rspace="0.167em">∥</mo><msub><mi mathsize="0.900em">ℙ</mi><mn mathsize="0.900em">0</mn></msub><mo maxsize="0.900em" minsize="0.900em">)</mo></mrow></mrow><annotation encoding="application/x-tex">\displaystyle=D_{\text{KL}}(\mathbb{P}_{0}^{\prime}\|\mathbb{P}_{0})</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
<tbody id="S9.Ex38"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_eqn_cell"></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="S9.Ex38.m1" class="ltx_math_unparsed" alttext="\displaystyle+\mathbb{E}_{\bm{X}_{0:1}\sim\mathbb{P}^{\prime}}\bigg[\sum_{t_{u}:\bm{X}_{t_{u}}\neq\bm{X}_{t_{u}-}}\log\frac{\bm{Q}^{\prime}_{t_{u}}(\bm{X}_{t_{u}^{-}},\bm{X}_{t_{u}})}{\bm{Q}_{t_{u}}(\bm{X}_{t_{u}^{-}},\bm{X}_{t_{u}})}+\int_{0}^{1}\sum_{z\neq\bm{X}_{t}}(\bm{Q}_{t}-\bm{Q}^{\prime}_{t})(\bm{X}_{t},z)dt" display="inline" intent=":literal"><semantics><mrow><mo mathsize="0.900em">+</mo><msub><mi mathsize="0.900em">𝔼</mi><mrow><mi mathsize="0.900em">𝑿</mi><msub><mrow></mrow><mrow><mn mathsize="0.900em">0</mn><mo lspace="0.278em" mathsize="0.900em" rspace="0.278em">:</mo><mn mathsize="0.900em">1</mn></mrow></msub><mo mathsize="0.900em">∼</mo><mi mathsize="0.900em">ℙ</mi><msup><mrow></mrow><mo mathsize="0.900em">′</mo></msup></mrow></msub><mrow><mo maxsize="2.100em" minsize="2.100em">[</mo><mstyle displaystyle="true"><munder><mo maxsize="0.900em" minsize="0.900em" movablelimits="false" stretchy="true">∑</mo><mrow><msub><mi mathsize="0.900em">t</mi><mi mathsize="0.900em">u</mi></msub><mo lspace="0.278em" mathsize="0.900em" rspace="0.278em">:</mo><mrow><msub><mi mathsize="0.900em">𝑿</mi><msub><mi mathsize="0.900em">t</mi><mi mathsize="0.900em">u</mi></msub></msub><mo mathsize="0.900em">≠</mo><msub><mi mathsize="0.900em">𝑿</mi><mrow><msub><mi mathsize="0.900em">t</mi><mi mathsize="0.900em">u</mi></msub><mo mathsize="0.900em">−</mo></mrow></msub></mrow></mrow></munder></mstyle><mi mathsize="0.900em">log</mi><mstyle displaystyle="true"><mfrac><mrow><msubsup><mi mathsize="0.900em">𝑸</mi><msub><mi mathsize="0.900em">t</mi><mi mathsize="0.900em">u</mi></msub><mo mathsize="0.900em">′</mo></msubsup><mo lspace="0em" rspace="0em">​</mo><mrow><mo maxsize="0.900em" minsize="0.900em">(</mo><msub><mi mathsize="0.900em">𝑿</mi><msubsup><mi mathsize="0.900em">t</mi><mi mathsize="0.900em">u</mi><mo mathsize="0.900em">−</mo></msubsup></msub><mo mathsize="0.900em">,</mo><msub><mi mathsize="0.900em">𝑿</mi><msub><mi mathsize="0.900em">t</mi><mi mathsize="0.900em">u</mi></msub></msub><mo maxsize="0.900em" minsize="0.900em">)</mo></mrow></mrow><mrow><msub><mi mathsize="0.900em">𝑸</mi><msub><mi mathsize="0.900em">t</mi><mi mathsize="0.900em">u</mi></msub></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo maxsize="0.900em" minsize="0.900em">(</mo><msub><mi mathsize="0.900em">𝑿</mi><msubsup><mi mathsize="0.900em">t</mi><mi mathsize="0.900em">u</mi><mo mathsize="0.900em">−</mo></msubsup></msub><mo mathsize="0.900em">,</mo><msub><mi mathsize="0.900em">𝑿</mi><msub><mi mathsize="0.900em">t</mi><mi mathsize="0.900em">u</mi></msub></msub><mo maxsize="0.900em" minsize="0.900em">)</mo></mrow></mrow></mfrac></mstyle><mo mathsize="0.900em">+</mo><mstyle displaystyle="true"><msubsup><mo maxsize="0.900em" minsize="0.900em" stretchy="true">∫</mo><mn mathsize="0.900em">0</mn><mn mathsize="0.900em">1</mn></msubsup></mstyle><mstyle displaystyle="true"><munder><mo maxsize="0.900em" minsize="0.900em" movablelimits="false" stretchy="true">∑</mo><mrow><mi mathsize="0.900em">z</mi><mo mathsize="0.900em">≠</mo><msub><mi mathsize="0.900em">𝑿</mi><mi mathsize="0.900em">t</mi></msub></mrow></munder></mstyle><mrow><mo maxsize="0.900em" minsize="0.900em">(</mo><msub><mi mathsize="0.900em">𝑸</mi><mi mathsize="0.900em">t</mi></msub><mo mathsize="0.900em">−</mo><msubsup><mi mathsize="0.900em">𝑸</mi><mi mathsize="0.900em">t</mi><mo mathsize="0.900em">′</mo></msubsup><mo maxsize="0.900em" minsize="0.900em">)</mo></mrow><mrow><mo maxsize="0.900em" minsize="0.900em">(</mo><msub><mi mathsize="0.900em">𝑿</mi><mi mathsize="0.900em">t</mi></msub><mo mathsize="0.900em">,</mo><mi mathsize="0.900em">z</mi><mo maxsize="0.900em" minsize="0.900em">)</mo></mrow><mi mathsize="0.900em">d</mi><mi mathsize="0.900em">t</mi></mrow></mrow><annotation encoding="application/x-tex">\displaystyle+\mathbb{E}_{\bm{X}_{0:1}\sim\mathbb{P}^{\prime}}\bigg[\sum_{t_{u}:\bm{X}_{t_{u}}\neq\bm{X}_{t_{u}-}}\log\frac{\bm{Q}^{\prime}_{t_{u}}(\bm{X}_{t_{u}^{-}},\bm{X}_{t_{u}})}{\bm{Q}_{t_{u}}(\bm{X}_{t_{u}^{-}},\bm{X}_{t_{u}})}+\int_{0}^{1}\sum_{z\neq\bm{X}_{t}}(\bm{Q}_{t}-\bm{Q}^{\prime}_{t})(\bm{X}_{t},z)dt</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
<tbody id="S9.E90"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_eqn_cell"></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="S9.E90.m1" class="ltx_math_unparsed" alttext="\displaystyle+\sum_{t_{i}:\bm{X}_{t_{i}}\neq\bm{X}_{t_{i}-}}\log\frac{\bm{R}^{\prime}_{t_{i}}(\bm{X}_{t_{i}^{-}},\bm{X}_{t_{i}})}{\bm{R}_{t_{i}}(\bm{X}_{t_{i}^{-}},\bm{X}_{t_{i}})}+\int_{0}^{1}\sum_{y\neq\bm{X}_{t}}(\bm{R}_{t}-\bm{R}^{\prime}_{t})(\bm{X}_{t},y)dt\bigg]" display="inline" intent=":literal"><semantics><mrow><mo mathsize="0.900em">+</mo><mstyle displaystyle="true"><munder><mo maxsize="0.900em" minsize="0.900em" movablelimits="false" stretchy="true">∑</mo><mrow><msub><mi mathsize="0.900em">t</mi><mi mathsize="0.900em">i</mi></msub><mo lspace="0.278em" mathsize="0.900em" rspace="0.278em">:</mo><mrow><msub><mi mathsize="0.900em">𝑿</mi><msub><mi mathsize="0.900em">t</mi><mi mathsize="0.900em">i</mi></msub></msub><mo mathsize="0.900em">≠</mo><msub><mi mathsize="0.900em">𝑿</mi><mrow><msub><mi mathsize="0.900em">t</mi><mi mathsize="0.900em">i</mi></msub><mo mathsize="0.900em">−</mo></mrow></msub></mrow></mrow></munder></mstyle><mi mathsize="0.900em">log</mi><mstyle displaystyle="true"><mfrac><mrow><msubsup><mi mathsize="0.900em">𝑹</mi><msub><mi mathsize="0.900em">t</mi><mi mathsize="0.900em">i</mi></msub><mo mathsize="0.900em">′</mo></msubsup><mo lspace="0em" rspace="0em">​</mo><mrow><mo maxsize="0.900em" minsize="0.900em">(</mo><msub><mi mathsize="0.900em">𝑿</mi><msubsup><mi mathsize="0.900em">t</mi><mi mathsize="0.900em">i</mi><mo mathsize="0.900em">−</mo></msubsup></msub><mo mathsize="0.900em">,</mo><msub><mi mathsize="0.900em">𝑿</mi><msub><mi mathsize="0.900em">t</mi><mi mathsize="0.900em">i</mi></msub></msub><mo maxsize="0.900em" minsize="0.900em">)</mo></mrow></mrow><mrow><msub><mi mathsize="0.900em">𝑹</mi><msub><mi mathsize="0.900em">t</mi><mi mathsize="0.900em">i</mi></msub></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo maxsize="0.900em" minsize="0.900em">(</mo><msub><mi mathsize="0.900em">𝑿</mi><msubsup><mi mathsize="0.900em">t</mi><mi mathsize="0.900em">i</mi><mo mathsize="0.900em">−</mo></msubsup></msub><mo mathsize="0.900em">,</mo><msub><mi mathsize="0.900em">𝑿</mi><msub><mi mathsize="0.900em">t</mi><mi mathsize="0.900em">i</mi></msub></msub><mo maxsize="0.900em" minsize="0.900em">)</mo></mrow></mrow></mfrac></mstyle><mo mathsize="0.900em">+</mo><mstyle displaystyle="true"><msubsup><mo maxsize="0.900em" minsize="0.900em" stretchy="true">∫</mo><mn mathsize="0.900em">0</mn><mn mathsize="0.900em">1</mn></msubsup></mstyle><mstyle displaystyle="true"><munder><mo maxsize="0.900em" minsize="0.900em" movablelimits="false" stretchy="true">∑</mo><mrow><mi mathsize="0.900em">y</mi><mo mathsize="0.900em">≠</mo><msub><mi mathsize="0.900em">𝑿</mi><mi mathsize="0.900em">t</mi></msub></mrow></munder></mstyle><mrow><mo maxsize="0.900em" minsize="0.900em">(</mo><msub><mi mathsize="0.900em">𝑹</mi><mi mathsize="0.900em">t</mi></msub><mo mathsize="0.900em">−</mo><msubsup><mi mathsize="0.900em">𝑹</mi><mi mathsize="0.900em">t</mi><mo mathsize="0.900em">′</mo></msubsup><mo maxsize="0.900em" minsize="0.900em">)</mo></mrow><mrow><mo maxsize="0.900em" minsize="0.900em">(</mo><msub><mi mathsize="0.900em">𝑿</mi><mi mathsize="0.900em">t</mi></msub><mo mathsize="0.900em">,</mo><mi mathsize="0.900em">y</mi><mo maxsize="0.900em" minsize="0.900em">)</mo></mrow><mi mathsize="0.900em">d</mi><mi mathsize="0.900em">t</mi><mo maxsize="2.100em" minsize="2.100em">]</mo></mrow><annotation encoding="application/x-tex">\displaystyle+\sum_{t_{i}:\bm{X}_{t_{i}}\neq\bm{X}_{t_{i}-}}\log\frac{\bm{R}^{\prime}_{t_{i}}(\bm{X}_{t_{i}^{-}},\bm{X}_{t_{i}})}{\bm{R}_{t_{i}}(\bm{X}_{t_{i}^{-}},\bm{X}_{t_{i}})}+\int_{0}^{1}\sum_{y\neq\bm{X}_{t}}(\bm{R}_{t}-\bm{R}^{\prime}_{t})(\bm{X}_{t},y)dt\bigg]</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td>
<td rowspan="1" class="ltx_eqn_cell ltx_eqn_eqno ltx_align_middle ltx_align_right"><span class="ltx_tag ltx_tag_equation ltx_align_right">(90)</span></td></tr></tbody>
</table>
<p id="S9.SS7.p3.6" class="ltx_p">which concludes our proof.  <math id="S9.SS7.p3.m4" class="ltx_Math" alttext="\square" display="inline" intent=":literal"><semantics><mi mathvariant="normal">□</mi><annotation encoding="application/x-tex">\square</annotation></semantics></math></p>
</div>
</section>
<section id="S9.SS8" class="ltx_subsection">
<h3 class="ltx_title ltx_title_subsection"><span class="ltx_tag ltx_tag_subsection">9.8 </span>Adaptive Joint Decoding Loss</h3>

<div id="S9.SS8.p1" class="ltx_para ltx_noindent">
<p id="S9.SS8.p1.1" class="ltx_p">In this section, we provide theoretical justifications for our <span id="S9.SS8.p1.1.1" class="ltx_text ltx_font_bold">Adaptive Joint Decoding (AJD)</span> loss, which can be used to jointly fine-tune the insertion and unmasking policies, as well as an adaptive inference schedule, to optimize sampling from the reward-tilted distribution. Throughout the proofs, we denote the full any-length generator as <math id="S9.SS8.p1.m1" class="ltx_Math" alttext="\bm{A}_{t}:=\bm{Q}_{t}+\bm{R}_{t}" display="inline" intent=":literal"><semantics><mrow><msub><mi>𝑨</mi><mi>t</mi></msub><mo>:=</mo><mrow><msub><mi>𝑸</mi><mi>t</mi></msub><mo>+</mo><msub><mi>𝑹</mi><mi>t</mi></msub></mrow></mrow><annotation encoding="application/x-tex">\bm{A}_{t}:=\bm{Q}_{t}+\bm{R}_{t}</annotation></semantics></math> where <math id="S9.SS8.p1.m2" class="ltx_Math" alttext="\bm{Q}_{t}" display="inline" intent=":literal"><semantics><msub><mi>𝑸</mi><mi>t</mi></msub><annotation encoding="application/x-tex">\bm{Q}_{t}</annotation></semantics></math> denotes the unmasking rate and <math id="S9.SS8.p1.m3" class="ltx_Math" alttext="\bm{R}_{t}" display="inline" intent=":literal"><semantics><msub><mi>𝑹</mi><mi>t</mi></msub><annotation encoding="application/x-tex">\bm{R}_{t}</annotation></semantics></math> denotes the insertion rate.</p>
</div>
<div id="S9.SS8.p2" class="ltx_para ltx_noindent">
<p id="S9.SS8.p2.1" class="ltx_p">We first derive the form of the optimal any-length generator <math id="S9.SS8.p2.m1" class="ltx_Math" alttext="\bm{A}^{\star}" display="inline" intent=":literal"><semantics><msup><mi>𝑨</mi><mo>⋆</mo></msup><annotation encoding="application/x-tex">\bm{A}^{\star}</annotation></semantics></math>, which follows seamlessly from the theory of fixed-length MDM generators <cite class="ltx_cite ltx_citemacro_citep">(<a href="#bib.bib17" title="" class="ltx_ref">Zhu et al., 2025</a>; <a href="#bib.bib3" title="" class="ltx_ref">Tang et al., 2025b</a>)</cite> but is defined on a larger state space of any-length sequences <math id="S9.SS8.p2.m2" class="ltx_Math" alttext="\bm{x}\in\mathcal{X}" display="inline" intent=":literal"><semantics><mrow><mi>𝒙</mi><mo>∈</mo><mi class="ltx_font_mathcaligraphic">𝒳</mi></mrow><annotation encoding="application/x-tex">\bm{x}\in\mathcal{X}</annotation></semantics></math>. Then, we show that our Adaptive Joint Decoding loss provably converges to the optimal generator.</p>
</div>
<div id="S9.SS8.p3" class="ltx_para ltx_noindent">
<p id="S9.SS8.p3.1" class="ltx_p">For an intermediate state <math id="S9.SS8.p3.m1" class="ltx_Math" alttext="\bm{x}\in\mathcal{X}" display="inline" intent=":literal"><semantics><mrow><mi>𝒙</mi><mo>∈</mo><mi class="ltx_font_mathcaligraphic">𝒳</mi></mrow><annotation encoding="application/x-tex">\bm{x}\in\mathcal{X}</annotation></semantics></math>, we define the <span id="S9.SS8.p3.1.1" class="ltx_text ltx_font_italic">total cost</span> <math id="S9.SS8.p3.m2" class="ltx_Math" alttext="J_{t}(\bm{x},v)" display="inline" intent=":literal"><semantics><mrow><msub><mi>J</mi><mi>t</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>𝒙</mi><mo>,</mo><mi>v</mi><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">J_{t}(\bm{x},v)</annotation></semantics></math> of insertions and unmasking steps required to reach a final state <math id="S9.SS8.p3.m3" class="ltx_Math" alttext="\bm{X}_{1}" display="inline" intent=":literal"><semantics><msub><mi>𝑿</mi><mn>1</mn></msub><annotation encoding="application/x-tex">\bm{X}_{1}</annotation></semantics></math> under a tilted path measure <math id="S9.SS8.p3.m4" class="ltx_Math" alttext="\mathbb{P}^{v}" display="inline" intent=":literal"><semantics><msup><mi>ℙ</mi><mi>v</mi></msup><annotation encoding="application/x-tex">\mathbb{P}^{v}</annotation></semantics></math>. Given a terminal reward <math id="S9.SS8.p3.m5" class="ltx_Math" alttext="r(\bm{X}_{1})" display="inline" intent=":literal"><semantics><mrow><mi>r</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><msub><mi>𝑿</mi><mn>1</mn></msub><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">r(\bm{X}_{1})</annotation></semantics></math>, we define the cost-minimization objective as:</p>
<table id="S9.EGx87" class="ltx_equationgroup ltx_eqn_align ltx_eqn_table">

<tbody id="S9.E91"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_align_right ltx_eqn_cell"><math id="S9.E91.m1" class="ltx_math_unparsed" alttext="\displaystyle J_{t}(\bm{x},v)=\underset{\bm{X}_{0:1}\sim\mathbb{P}^{v}}{\mathbb{E}}\left[\int_{0}^{1}\sum_{y\neq\bm{X}_{s}}C_{s}(\bm{X}_{s},y)ds-r(\bm{X}_{1})\bigg|\bm{X}_{t}=\bm{x}\right]" display="inline" intent=":literal"><semantics><mrow><msub><mi>J</mi><mi>t</mi></msub><mrow><mo stretchy="false">(</mo><mi>𝒙</mi><mo>,</mo><mi>v</mi><mo stretchy="false">)</mo></mrow><mo>=</mo><munder accentunder="true"><mi>𝔼</mi><mrow><mi mathsize="0.700em">𝑿</mi><msub><mrow></mrow><mrow><mn mathsize="0.710em">0</mn><mo lspace="0.278em" mathsize="0.710em" rspace="0.278em">:</mo><mn mathsize="0.710em">1</mn></mrow></msub><mo mathsize="0.700em">∼</mo><mi mathsize="0.700em">ℙ</mi><msup><mrow></mrow><mi mathsize="0.710em">v</mi></msup></mrow></munder><mrow><mo>[</mo><mstyle displaystyle="true"><msubsup><mo>∫</mo><mn>0</mn><mn>1</mn></msubsup></mstyle><mstyle displaystyle="true"><munder><mo movablelimits="false">∑</mo><mrow><mi>y</mi><mo>≠</mo><msub><mi>𝑿</mi><mi>s</mi></msub></mrow></munder></mstyle><msub><mi>C</mi><mi>s</mi></msub><mrow><mo stretchy="false">(</mo><msub><mi>𝑿</mi><mi>s</mi></msub><mo>,</mo><mi>y</mi><mo stretchy="false">)</mo></mrow><mi>d</mi><mi>s</mi><mo>−</mo><mi>r</mi><mrow><mo stretchy="false">(</mo><msub><mi>𝑿</mi><mn>1</mn></msub><mo stretchy="false">)</mo></mrow><mo fence="false" maxsize="2.100em" minsize="2.100em" rspace="0.167em" stretchy="true">|</mo><msub><mi>𝑿</mi><mi>t</mi></msub><mo>=</mo><mi>𝒙</mi><mo>]</mo></mrow></mrow><annotation encoding="application/x-tex">\displaystyle J_{t}(\bm{x},v)=\underset{\bm{X}_{0:1}\sim\mathbb{P}^{v}}{\mathbb{E}}\left[\int_{0}^{1}\sum_{y\neq\bm{X}_{s}}C_{s}(\bm{X}_{s},y)ds-r(\bm{X}_{1})\bigg|\bm{X}_{t}=\bm{x}\right]</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td>
<td rowspan="1" class="ltx_eqn_cell ltx_eqn_eqno ltx_align_middle ltx_align_right"><span class="ltx_tag ltx_tag_equation ltx_align_right">(91)</span></td></tr></tbody>
</table>
<p id="S9.SS8.p3.2" class="ltx_p">where the cost is defined as the KL divergence between generators derived in (<a href="#S9.Thmcorollary1" title="Corollary 9.1 (KL Divergence Between Any-Length Joint CTMCs). ‣ 9.7 Radon-Nikodym Derivative Between Joint CTMCs ‣ 9 Theoretical Proofs ‣ A2D2: Fine-Tuning Any-Length Discrete Diffusion for Adaptive Decoding" class="ltx_ref"><span class="ltx_text ltx_ref_tag">9.1</span></a>) as <math id="S9.SS8.p3.m6" class="ltx_Math" alttext="C_{s}(x,y):=\left(\bm{A}^{v}_{t}\log\frac{\bm{A}^{v}}{\bm{A}^{0}}-\bm{A}^{v}+\bm{A}^{0}\right)(x,y)" display="inline" intent=":literal"><semantics><mrow><mrow><msub><mi>C</mi><mi>s</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>x</mi><mo>,</mo><mi>y</mi><mo stretchy="false">)</mo></mrow></mrow><mo>:=</mo><mrow><mrow><mo>(</mo><mrow><mrow><mrow><msubsup><mi>𝑨</mi><mi>t</mi><mi>v</mi></msubsup><mo lspace="0.167em" rspace="0em">​</mo><mrow><mi>log</mi><mo lspace="0.167em">⁡</mo><mfrac><msup><mi>𝑨</mi><mi>v</mi></msup><msup><mi>𝑨</mi><mn>0</mn></msup></mfrac></mrow></mrow><mo>−</mo><msup><mi>𝑨</mi><mi>v</mi></msup></mrow><mo>+</mo><msup><mi>𝑨</mi><mn>0</mn></msup></mrow><mo>)</mo></mrow><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>x</mi><mo>,</mo><mi>y</mi><mo stretchy="false">)</mo></mrow></mrow></mrow><annotation encoding="application/x-tex">C_{s}(x,y):=\left(\bm{A}^{v}_{t}\log\frac{\bm{A}^{v}}{\bm{A}^{0}}-\bm{A}^{v}+\bm{A}^{0}\right)(x,y)</annotation></semantics></math>. We can minimize <math id="S9.SS8.p3.m7" class="ltx_Math" alttext="J_{t}(\bm{x},v)" display="inline" intent=":literal"><semantics><mrow><msub><mi>J</mi><mi>t</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>𝒙</mi><mo>,</mo><mi>v</mi><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">J_{t}(\bm{x},v)</annotation></semantics></math> by maximizing a <span id="S9.SS8.p3.2.1" class="ltx_text ltx_font_bold">value function</span> defined as the <span id="S9.SS8.p3.2.2" class="ltx_text ltx_font_italic">negative optimal cost-to-go</span> <math id="S9.SS8.p3.m8" class="ltx_math_unparsed" alttext="V_{t}(\bm{x}):=-J^{\star}_{t}(\bm{x})=-\inf_{v}J_{t}(\bm{x},v)" display="inline" intent=":literal"><semantics><mrow><msub><mi>V</mi><mi>t</mi></msub><mrow><mo stretchy="false">(</mo><mi>𝒙</mi><mo stretchy="false">)</mo></mrow><mo rspace="0em">:=</mo><mo lspace="0em">−</mo><msubsup><mi>J</mi><mi>t</mi><mo>⋆</mo></msubsup><mrow><mo stretchy="false">(</mo><mi>𝒙</mi><mo stretchy="false">)</mo></mrow><mo rspace="0em">=</mo><mo lspace="0em">−</mo><msub><mo lspace="0em" rspace="0.167em">inf</mo><mi>v</mi></msub><msub><mi>J</mi><mi>t</mi></msub><mrow><mo stretchy="false">(</mo><mi>𝒙</mi><mo>,</mo><mi>v</mi><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">V_{t}(\bm{x}):=-J^{\star}_{t}(\bm{x})=-\inf_{v}J_{t}(\bm{x},v)</annotation></semantics></math>. Using the recursive nature of the cost-to-go, where the total cost is equal to the immediate and future cost, we can decompose the value function using Bellman’s principle as:
<span id="S9.SS8.p3.2.3" class="ltx_text"></span></p>
<table id="S9.EGx88" class="ltx_equationgroup ltx_eqn_align ltx_eqn_table">

<tbody id="S9.Ex39"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_align_right ltx_eqn_cell"><math id="S9.Ex39.m1" class="ltx_Math" alttext="\displaystyle-V_{t}(\bm{x})=J^{\star}_{t}(\bm{x})" display="inline" intent=":literal"><semantics><mrow><mrow><mo mathsize="0.900em">−</mo><mrow><msub><mi mathsize="0.900em">V</mi><mi mathsize="0.900em">t</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo maxsize="0.900em" minsize="0.900em">(</mo><mi mathsize="0.900em">𝒙</mi><mo maxsize="0.900em" minsize="0.900em">)</mo></mrow></mrow></mrow><mo mathsize="0.900em">=</mo><mrow><msubsup><mi mathsize="0.900em">J</mi><mi mathsize="0.900em">t</mi><mo mathsize="0.900em">⋆</mo></msubsup><mo lspace="0em" rspace="0em">​</mo><mrow><mo maxsize="0.900em" minsize="0.900em">(</mo><mi mathsize="0.900em">𝒙</mi><mo maxsize="0.900em" minsize="0.900em">)</mo></mrow></mrow></mrow><annotation encoding="application/x-tex">\displaystyle-V_{t}(\bm{x})=J^{\star}_{t}(\bm{x})</annotation></semantics></math></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="S9.Ex39.m2" class="ltx_math_unparsed" alttext="\displaystyle=\inf_{v}\underset{\bm{X}_{0:1}\sim\mathbb{P}^{v}}{\mathbb{E}}\left[\left(\int_{t}^{t+\Delta t}+\int_{t+\Delta t}^{1}\right)\sum_{y\neq\bm{X}_{s}}C_{s}(\bm{X}_{s},y)ds-r(\bm{X}_{1})\bigg|\bm{X}_{t}=\bm{x}\right]" display="inline" intent=":literal"><semantics><mrow><mo mathsize="0.900em" rspace="0.1389em">=</mo><munder><mo lspace="0.1389em" mathsize="0.900em" movablelimits="false" rspace="0.167em">inf</mo><mi mathsize="0.900em">v</mi></munder><munder accentunder="true"><mi mathsize="0.900em">𝔼</mi><mrow><mi mathsize="0.630em">𝑿</mi><msub><mrow></mrow><mrow><mn mathsize="0.640em">0</mn><mo lspace="0.278em" mathsize="0.640em" rspace="0.278em">:</mo><mn mathsize="0.640em">1</mn></mrow></msub><mo mathsize="0.630em">∼</mo><mi mathsize="0.630em">ℙ</mi><msup><mrow></mrow><mi mathsize="0.640em">v</mi></msup></mrow></munder><mrow><mo>[</mo><mrow><mo>(</mo><mstyle displaystyle="true"><msubsup><mo maxsize="0.900em" minsize="0.900em" stretchy="true">∫</mo><mi mathsize="0.900em">t</mi><mrow><mi mathsize="0.900em">t</mi><mo mathsize="0.900em">+</mo><mrow><mi mathsize="0.900em" mathvariant="normal">Δ</mi><mo lspace="0em" rspace="0em">​</mo><mi mathsize="0.900em">t</mi></mrow></mrow></msubsup></mstyle><mo mathsize="0.900em">+</mo><mstyle displaystyle="true"><msubsup><mo maxsize="0.900em" minsize="0.900em" stretchy="true">∫</mo><mrow><mi mathsize="0.900em">t</mi><mo mathsize="0.900em">+</mo><mrow><mi mathsize="0.900em" mathvariant="normal">Δ</mi><mo lspace="0em" rspace="0em">​</mo><mi mathsize="0.900em">t</mi></mrow></mrow><mn mathsize="0.900em">1</mn></msubsup></mstyle><mo>)</mo></mrow><mstyle displaystyle="true"><munder><mo maxsize="0.900em" minsize="0.900em" movablelimits="false" stretchy="true">∑</mo><mrow><mi mathsize="0.900em">y</mi><mo mathsize="0.900em">≠</mo><msub><mi mathsize="0.900em">𝑿</mi><mi mathsize="0.900em">s</mi></msub></mrow></munder></mstyle><msub><mi mathsize="0.900em">C</mi><mi mathsize="0.900em">s</mi></msub><mrow><mo maxsize="0.900em" minsize="0.900em">(</mo><msub><mi mathsize="0.900em">𝑿</mi><mi mathsize="0.900em">s</mi></msub><mo mathsize="0.900em">,</mo><mi mathsize="0.900em">y</mi><mo maxsize="0.900em" minsize="0.900em">)</mo></mrow><mi mathsize="0.900em">d</mi><mi mathsize="0.900em">s</mi><mo mathsize="0.900em">−</mo><mi mathsize="0.900em">r</mi><mrow><mo maxsize="0.900em" minsize="0.900em">(</mo><msub><mi mathsize="0.900em">𝑿</mi><mn mathsize="0.900em">1</mn></msub><mo maxsize="0.900em" minsize="0.900em">)</mo></mrow><mo fence="false" maxsize="2.100em" minsize="2.100em" rspace="0.167em" stretchy="true">|</mo><msub><mi mathsize="0.900em">𝑿</mi><mi mathsize="0.900em">t</mi></msub><mo mathsize="0.900em">=</mo><mi mathsize="0.900em">𝒙</mi><mo>]</mo></mrow></mrow><annotation encoding="application/x-tex">\displaystyle=\inf_{v}\underset{\bm{X}_{0:1}\sim\mathbb{P}^{v}}{\mathbb{E}}\left[\left(\int_{t}^{t+\Delta t}+\int_{t+\Delta t}^{1}\right)\sum_{y\neq\bm{X}_{s}}C_{s}(\bm{X}_{s},y)ds-r(\bm{X}_{1})\bigg|\bm{X}_{t}=\bm{x}\right]</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
<tbody id="S9.E92"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_eqn_cell"></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="S9.E92.m1" class="ltx_math_unparsed" alttext="\displaystyle=\left[\Delta t\inf_{v}\sum_{y\neq x}C_{s}(\bm{x},\bm{y})+\mathcal{O}(\Delta t^{2})\right]+\inf_{v}\underset{\bm{X}_{0:1}\sim\mathbb{P}^{v}}{\mathbb{E}}[-V_{t+\Delta t}(\bm{X}_{t+\Delta t})|\bm{X}_{t}=\bm{x}]" display="inline" intent=":literal"><semantics><mrow><mo mathsize="0.900em">=</mo><mrow><mo>[</mo><mi mathsize="0.900em" mathvariant="normal">Δ</mi><mi mathsize="0.900em">t</mi><munder><mo lspace="0.167em" mathsize="0.900em" movablelimits="false" rspace="0.167em">inf</mo><mi mathsize="0.900em">v</mi></munder><mstyle displaystyle="true"><munder><mo maxsize="0.900em" minsize="0.900em" movablelimits="false" stretchy="true">∑</mo><mrow><mi mathsize="0.900em">y</mi><mo mathsize="0.900em">≠</mo><mi mathsize="0.900em">x</mi></mrow></munder></mstyle><msub><mi mathsize="0.900em">C</mi><mi mathsize="0.900em">s</mi></msub><mrow><mo maxsize="0.900em" minsize="0.900em">(</mo><mi mathsize="0.900em">𝒙</mi><mo mathsize="0.900em">,</mo><mi mathsize="0.900em">𝒚</mi><mo maxsize="0.900em" minsize="0.900em">)</mo></mrow><mo mathsize="0.900em">+</mo><mi class="ltx_font_mathcaligraphic" mathsize="0.900em">𝒪</mi><mrow><mo maxsize="0.900em" minsize="0.900em">(</mo><mi mathsize="0.900em" mathvariant="normal">Δ</mi><msup><mi mathsize="0.900em">t</mi><mn mathsize="0.900em">2</mn></msup><mo maxsize="0.900em" minsize="0.900em">)</mo></mrow><mo>]</mo></mrow><mo mathsize="0.900em">+</mo><munder><mo lspace="0em" mathsize="0.900em" movablelimits="false" rspace="0.167em">inf</mo><mi mathsize="0.900em">v</mi></munder><munder accentunder="true"><mi mathsize="0.900em">𝔼</mi><mrow><mi mathsize="0.630em">𝑿</mi><msub><mrow></mrow><mrow><mn mathsize="0.640em">0</mn><mo lspace="0.278em" mathsize="0.640em" rspace="0.278em">:</mo><mn mathsize="0.640em">1</mn></mrow></msub><mo mathsize="0.630em">∼</mo><mi mathsize="0.630em">ℙ</mi><msup><mrow></mrow><mi mathsize="0.640em">v</mi></msup></mrow></munder><mrow><mo maxsize="0.900em" minsize="0.900em">[</mo><mo lspace="0em" mathsize="0.900em">−</mo><msub><mi mathsize="0.900em">V</mi><mrow><mi mathsize="0.900em">t</mi><mo mathsize="0.900em">+</mo><mrow><mi mathsize="0.900em" mathvariant="normal">Δ</mi><mo lspace="0em" rspace="0em">​</mo><mi mathsize="0.900em">t</mi></mrow></mrow></msub><mrow><mo maxsize="0.900em" minsize="0.900em">(</mo><msub><mi mathsize="0.900em">𝑿</mi><mrow><mi mathsize="0.900em">t</mi><mo mathsize="0.900em">+</mo><mrow><mi mathsize="0.900em" mathvariant="normal">Δ</mi><mo lspace="0em" rspace="0em">​</mo><mi mathsize="0.900em">t</mi></mrow></mrow></msub><mo maxsize="0.900em" minsize="0.900em">)</mo></mrow><mo fence="false" maxsize="0.900em" minsize="0.900em" rspace="0.167em" stretchy="true">|</mo><msub><mi mathsize="0.900em">𝑿</mi><mi mathsize="0.900em">t</mi></msub><mo mathsize="0.900em">=</mo><mi mathsize="0.900em">𝒙</mi><mo maxsize="0.900em" minsize="0.900em">]</mo></mrow></mrow><annotation encoding="application/x-tex">\displaystyle=\left[\Delta t\inf_{v}\sum_{y\neq x}C_{s}(\bm{x},\bm{y})+\mathcal{O}(\Delta t^{2})\right]+\inf_{v}\underset{\bm{X}_{0:1}\sim\mathbb{P}^{v}}{\mathbb{E}}[-V_{t+\Delta t}(\bm{X}_{t+\Delta t})|\bm{X}_{t}=\bm{x}]</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td>
<td rowspan="1" class="ltx_eqn_cell ltx_eqn_eqno ltx_align_middle ltx_align_right"><span class="ltx_tag ltx_tag_equation ltx_align_right">(92)</span></td></tr></tbody>
</table>
<p id="S9.SS8.p3.3" class="ltx_p">Now, we derive the full form of the optimal any-length generator <math id="S9.SS8.p3.m9" class="ltx_Math" alttext="\bm{A}^{\star}" display="inline" intent=":literal"><semantics><msup><mi>𝑨</mi><mo>⋆</mo></msup><annotation encoding="application/x-tex">\bm{A}^{\star}</annotation></semantics></math> using our definition of the value function.</p>
</div>
<div id="S9.Thmlemma2" class="ltx_theorem ltx_theorem_lemma">
<h6 class="ltx_title ltx_runin ltx_title_theorem"><span class="ltx_tag ltx_tag_theorem"><span id="S9.Thmlemma2.2" class="ltx_text ltx_font_bold">Lemma 9.2</span></span><span id="S9.Thmlemma2.3" class="ltx_text ltx_font_bold"> </span>(Optimal Generator)<span id="S9.Thmlemma2.4" class="ltx_text ltx_font_bold">.</span></h6>
<div id="S9.Thmlemma2.p1" class="ltx_para">
<p id="S9.Thmlemma2.p1.1" class="ltx_p"><span id="S9.Thmlemma2.p1.1.1" class="ltx_text ltx_font_italic">Given a reference any-length generator <math id="S9.Thmlemma2.p1.m1" class="ltx_Math" alttext="\bm{A}^{0}:=\bm{Q}^{0}+\bm{R}^{0}" display="inline" intent=":literal"><semantics><mrow><msup><mi>𝐀</mi><mn>0</mn></msup><mo>:=</mo><mrow><msup><mi>𝐐</mi><mn>0</mn></msup><mo>+</mo><msup><mi>𝐑</mi><mn>0</mn></msup></mrow></mrow><annotation encoding="application/x-tex">\bm{A}^{0}:=\bm{Q}^{0}+\bm{R}^{0}</annotation></semantics></math> a value function <math id="S9.Thmlemma2.p1.m2" class="ltx_Math" alttext="V_{t}" display="inline" intent=":literal"><semantics><msub><mi>V</mi><mi>t</mi></msub><annotation encoding="application/x-tex">V_{t}</annotation></semantics></math>, the optimal generator takes the form:</span></p>
<table id="S9.EGx89" class="ltx_equationgroup ltx_eqn_align ltx_eqn_table">

<tbody id="S9.Ex40"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_align_right ltx_eqn_cell"><math id="S9.Ex40.m1" class="ltx_Math" alttext="\displaystyle\bm{A}^{\star}_{t}(\bm{x},\bm{y})" display="inline" intent=":literal"><semantics><mrow><msubsup><mi>𝑨</mi><mi>t</mi><mo>⋆</mo></msubsup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>𝒙</mi><mo>,</mo><mi>𝒚</mi><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">\displaystyle\bm{A}^{\star}_{t}(\bm{x},\bm{y})</annotation></semantics></math></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="S9.Ex40.m2" class="ltx_Math" alttext="\displaystyle=\bm{A}^{0}_{t}(\bm{x},\bm{y})\exp(V_{t}(\bm{y})-V_{t}(\bm{x}))" display="inline" intent=":literal"><semantics><mrow><mphantom></mphantom><mo>=</mo><mrow><msubsup><mi>𝑨</mi><mi>t</mi><mn>0</mn></msubsup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>𝒙</mi><mo>,</mo><mi>𝒚</mi><mo stretchy="false">)</mo></mrow><mo lspace="0.167em" rspace="0em">​</mo><mrow><mi>exp</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mrow><mrow><msub><mi>V</mi><mi>t</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>𝒚</mi><mo stretchy="false">)</mo></mrow></mrow><mo>−</mo><mrow><msub><mi>V</mi><mi>t</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>𝒙</mi><mo stretchy="false">)</mo></mrow></mrow></mrow><mo stretchy="false">)</mo></mrow></mrow></mrow></mrow><annotation encoding="application/x-tex">\displaystyle=\bm{A}^{0}_{t}(\bm{x},\bm{y})\exp(V_{t}(\bm{y})-V_{t}(\bm{x}))</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
<tbody id="S9.E93"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_eqn_cell"></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="S9.E93.m1" class="ltx_Math" alttext="\displaystyle=\bm{Q}^{0}_{t}(\bm{x},\bm{y}_{u})\exp(V_{t}(\bm{y}_{u})-V_{t}(\bm{x}))+\bm{R}^{0}_{t}(\bm{x},\bm{y}^{i})\exp(V_{t}(\bm{y}^{i})-V_{t}(\bm{x}))" display="inline" intent=":literal"><semantics><mrow><mphantom></mphantom><mo>=</mo><mrow><mrow><msubsup><mi>𝑸</mi><mi>t</mi><mn>0</mn></msubsup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>𝒙</mi><mo>,</mo><msub><mi>𝒚</mi><mi>u</mi></msub><mo stretchy="false">)</mo></mrow><mo lspace="0.167em" rspace="0em">​</mo><mrow><mi>exp</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mrow><mrow><msub><mi>V</mi><mi>t</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mi>𝒚</mi><mi>u</mi></msub><mo stretchy="false">)</mo></mrow></mrow><mo>−</mo><mrow><msub><mi>V</mi><mi>t</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>𝒙</mi><mo stretchy="false">)</mo></mrow></mrow></mrow><mo stretchy="false">)</mo></mrow></mrow></mrow><mo>+</mo><mrow><msubsup><mi>𝑹</mi><mi>t</mi><mn>0</mn></msubsup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>𝒙</mi><mo>,</mo><msup><mi>𝒚</mi><mi>i</mi></msup><mo stretchy="false">)</mo></mrow><mo lspace="0.167em" rspace="0em">​</mo><mrow><mi>exp</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mrow><mrow><msub><mi>V</mi><mi>t</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msup><mi>𝒚</mi><mi>i</mi></msup><mo stretchy="false">)</mo></mrow></mrow><mo>−</mo><mrow><msub><mi>V</mi><mi>t</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>𝒙</mi><mo stretchy="false">)</mo></mrow></mrow></mrow><mo stretchy="false">)</mo></mrow></mrow></mrow></mrow></mrow><annotation encoding="application/x-tex">\displaystyle=\bm{Q}^{0}_{t}(\bm{x},\bm{y}_{u})\exp(V_{t}(\bm{y}_{u})-V_{t}(\bm{x}))+\bm{R}^{0}_{t}(\bm{x},\bm{y}^{i})\exp(V_{t}(\bm{y}^{i})-V_{t}(\bm{x}))</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td>
<td rowspan="1" class="ltx_eqn_cell ltx_eqn_eqno ltx_align_middle ltx_align_right"><span class="ltx_tag ltx_tag_equation ltx_align_right">(93)</span></td></tr></tbody>
</table>
<p id="S9.Thmlemma2.p1.2" class="ltx_p"><span id="S9.Thmlemma2.p1.2.1" class="ltx_text ltx_font_italic">where <math id="S9.Thmlemma2.p1.m3" class="ltx_Math" alttext="\bm{y}_{u}" display="inline" intent=":literal"><semantics><msub><mi>𝐲</mi><mi>u</mi></msub><annotation encoding="application/x-tex">\bm{y}_{u}</annotation></semantics></math> denotes the state after an unmasking transition and <math id="S9.Thmlemma2.p1.m4" class="ltx_Math" alttext="\bm{y}_{i}" display="inline" intent=":literal"><semantics><msub><mi>𝐲</mi><mi>i</mi></msub><annotation encoding="application/x-tex">\bm{y}_{i}</annotation></semantics></math> denotes the state after an insertion transition</span></p>
</div>
</div>
<div id="S9.SS8.p4" class="ltx_para ltx_noindent">
<p id="S9.SS8.p4.1" class="ltx_p"><span id="S9.SS8.p4.1.1" class="ltx_text ltx_font_italic">Proof.</span> Starting with the expanded value function in (<a href="#S9.E92" title="Equation 92 ‣ 9.8 Adaptive Joint Decoding Loss ‣ 9 Theoretical Proofs ‣ A2D2: Fine-Tuning Any-Length Discrete Diffusion for Adaptive Decoding" class="ltx_ref"><span class="ltx_text ltx_ref_tag">92</span></a>), we expand the recursive term by defining the next state <math id="S9.SS8.p4.m1" class="ltx_Math" alttext="\bm{X}_{t+\Delta t}:=\bm{y}" display="inline" intent=":literal"><semantics><mrow><msub><mi>𝑿</mi><mrow><mi>t</mi><mo>+</mo><mrow><mi mathvariant="normal">Δ</mi><mo lspace="0em" rspace="0em">​</mo><mi>t</mi></mrow></mrow></msub><mo>:=</mo><mi>𝒚</mi></mrow><annotation encoding="application/x-tex">\bm{X}_{t+\Delta t}:=\bm{y}</annotation></semantics></math> and applying the CTMC transition probability as:</p>
<table id="S9.EGx90" class="ltx_equationgroup ltx_eqn_align ltx_eqn_table">

<tbody id="S9.Ex41"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_align_right ltx_eqn_cell"><math id="S9.Ex41.m1" class="ltx_Math" alttext="\displaystyle\inf_{v}" display="inline" intent=":literal"><semantics><munder><mo movablelimits="false">inf</mo><mi>v</mi></munder><annotation encoding="application/x-tex">\displaystyle\inf_{v}</annotation></semantics></math></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="S9.Ex41.m2" class="ltx_math_unparsed" alttext="\displaystyle\underset{\bm{X}_{0:1}\sim\mathbb{P}^{v}}{\mathbb{E}}[-V_{t+\Delta t}(\bm{X}_{t+\Delta t})|\bm{X}_{t}=\bm{x}]" display="inline" intent=":literal"><semantics><mrow><munder accentunder="true"><mi>𝔼</mi><mrow><mi mathsize="0.700em">𝑿</mi><msub><mrow></mrow><mrow><mn mathsize="0.710em">0</mn><mo lspace="0.278em" mathsize="0.710em" rspace="0.278em">:</mo><mn mathsize="0.710em">1</mn></mrow></msub><mo mathsize="0.700em">∼</mo><mi mathsize="0.700em">ℙ</mi><msup><mrow></mrow><mi mathsize="0.710em">v</mi></msup></mrow></munder><mrow><mo stretchy="false">[</mo><mo lspace="0em">−</mo><msub><mi>V</mi><mrow><mi>t</mi><mo>+</mo><mrow><mi mathvariant="normal">Δ</mi><mo lspace="0em" rspace="0em">​</mo><mi>t</mi></mrow></mrow></msub><mrow><mo stretchy="false">(</mo><msub><mi>𝑿</mi><mrow><mi>t</mi><mo>+</mo><mrow><mi mathvariant="normal">Δ</mi><mo lspace="0em" rspace="0em">​</mo><mi>t</mi></mrow></mrow></msub><mo stretchy="false">)</mo></mrow><mo fence="false" rspace="0.167em" stretchy="false">|</mo><msub><mi>𝑿</mi><mi>t</mi></msub><mo>=</mo><mi>𝒙</mi><mo stretchy="false">]</mo></mrow></mrow><annotation encoding="application/x-tex">\displaystyle\underset{\bm{X}_{0:1}\sim\mathbb{P}^{v}}{\mathbb{E}}[-V_{t+\Delta t}(\bm{X}_{t+\Delta t})|\bm{X}_{t}=\bm{x}]</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
<tbody id="S9.Ex42"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_eqn_cell"></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="S9.Ex42.m1" class="ltx_math_unparsed" alttext="\displaystyle=\inf_{v}\left[-\sum_{\bm{y}}V_{t+\Delta t}(\bm{y})\left(\bm{1}_{x=y}+\Delta t\bm{A}^{v}_{t}(\bm{x},\bm{y})+\mathcal{O}(\Delta t^{2})\right)\right]" display="inline" intent=":literal"><semantics><mrow><mo rspace="0.1389em">=</mo><munder><mo lspace="0.1389em" movablelimits="false" rspace="0em">inf</mo><mi>v</mi></munder><mrow><mo>[</mo><mo lspace="0em">−</mo><mstyle displaystyle="true"><munder><mo movablelimits="false">∑</mo><mi>𝒚</mi></munder></mstyle><msub><mi>V</mi><mrow><mi>t</mi><mo>+</mo><mrow><mi mathvariant="normal">Δ</mi><mo lspace="0em" rspace="0em">​</mo><mi>t</mi></mrow></mrow></msub><mrow><mo stretchy="false">(</mo><mi>𝒚</mi><mo stretchy="false">)</mo></mrow><mrow><mo>(</mo><msub><mn>𝟏</mn><mrow><mi>x</mi><mo>=</mo><mi>y</mi></mrow></msub><mo>+</mo><mi mathvariant="normal">Δ</mi><mi>t</mi><msubsup><mi>𝑨</mi><mi>t</mi><mi>v</mi></msubsup><mrow><mo stretchy="false">(</mo><mi>𝒙</mi><mo>,</mo><mi>𝒚</mi><mo stretchy="false">)</mo></mrow><mo>+</mo><mi class="ltx_font_mathcaligraphic">𝒪</mi><mrow><mo stretchy="false">(</mo><mi mathvariant="normal">Δ</mi><msup><mi>t</mi><mn>2</mn></msup><mo stretchy="false">)</mo></mrow><mo>)</mo></mrow><mo>]</mo></mrow></mrow><annotation encoding="application/x-tex">\displaystyle=\inf_{v}\left[-\sum_{\bm{y}}V_{t+\Delta t}(\bm{y})\left(\bm{1}_{x=y}+\Delta t\bm{A}^{v}_{t}(\bm{x},\bm{y})+\mathcal{O}(\Delta t^{2})\right)\right]</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
<tbody id="S9.Ex43"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_eqn_cell"></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="S9.Ex43.m1" class="ltx_Math" alttext="\displaystyle=\inf_{v}\left[-V_{t+\Delta t}(\bm{x})-\Delta t\sum_{x\neq y}V_{t+\Delta t}(\bm{y})\bm{A}^{v}_{t}(\bm{x},\bm{y})+\Delta t\sum_{x\neq y}V_{t+\Delta t}(\bm{x})\bm{A}^{v}_{t}(\bm{x},\bm{y})+\mathcal{O}(\Delta t^{2})\right]" display="inline" intent=":literal"><semantics><mrow><mphantom></mphantom><mo rspace="0.1389em">=</mo><mrow><munder><mo lspace="0.1389em" movablelimits="false" rspace="0em">inf</mo><mi>v</mi></munder><mrow><mo>[</mo><mrow><mrow><mrow><mo>−</mo><mrow><msub><mi>V</mi><mrow><mi>t</mi><mo>+</mo><mrow><mi mathvariant="normal">Δ</mi><mo lspace="0em" rspace="0em">​</mo><mi>t</mi></mrow></mrow></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>𝒙</mi><mo stretchy="false">)</mo></mrow></mrow></mrow><mo>−</mo><mrow><mi mathvariant="normal">Δ</mi><mo lspace="0em" rspace="0em">​</mo><mi>t</mi><mo lspace="0em" rspace="0em">​</mo><mrow><mstyle displaystyle="true"><munder><mo movablelimits="false">∑</mo><mrow><mi>x</mi><mo>≠</mo><mi>y</mi></mrow></munder></mstyle><mrow><msub><mi>V</mi><mrow><mi>t</mi><mo>+</mo><mrow><mi mathvariant="normal">Δ</mi><mo lspace="0em" rspace="0em">​</mo><mi>t</mi></mrow></mrow></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>𝒚</mi><mo stretchy="false">)</mo></mrow><mo lspace="0em" rspace="0em">​</mo><msubsup><mi>𝑨</mi><mi>t</mi><mi>v</mi></msubsup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>𝒙</mi><mo>,</mo><mi>𝒚</mi><mo stretchy="false">)</mo></mrow></mrow></mrow></mrow></mrow><mo>+</mo><mrow><mi mathvariant="normal">Δ</mi><mo lspace="0em" rspace="0em">​</mo><mi>t</mi><mo lspace="0em" rspace="0em">​</mo><mrow><mstyle displaystyle="true"><munder><mo movablelimits="false">∑</mo><mrow><mi>x</mi><mo>≠</mo><mi>y</mi></mrow></munder></mstyle><mrow><msub><mi>V</mi><mrow><mi>t</mi><mo>+</mo><mrow><mi mathvariant="normal">Δ</mi><mo lspace="0em" rspace="0em">​</mo><mi>t</mi></mrow></mrow></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>𝒙</mi><mo stretchy="false">)</mo></mrow><mo lspace="0em" rspace="0em">​</mo><msubsup><mi>𝑨</mi><mi>t</mi><mi>v</mi></msubsup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>𝒙</mi><mo>,</mo><mi>𝒚</mi><mo stretchy="false">)</mo></mrow></mrow></mrow></mrow><mo>+</mo><mrow><mi class="ltx_font_mathcaligraphic">𝒪</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mrow><mi mathvariant="normal">Δ</mi><mo lspace="0em" rspace="0em">​</mo><msup><mi>t</mi><mn>2</mn></msup></mrow><mo stretchy="false">)</mo></mrow></mrow></mrow><mo>]</mo></mrow></mrow></mrow><annotation encoding="application/x-tex">\displaystyle=\inf_{v}\left[-V_{t+\Delta t}(\bm{x})-\Delta t\sum_{x\neq y}V_{t+\Delta t}(\bm{y})\bm{A}^{v}_{t}(\bm{x},\bm{y})+\Delta t\sum_{x\neq y}V_{t+\Delta t}(\bm{x})\bm{A}^{v}_{t}(\bm{x},\bm{y})+\mathcal{O}(\Delta t^{2})\right]</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
<tbody id="S9.E94"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_eqn_cell"></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="S9.E94.m1" class="ltx_math_unparsed" alttext="\displaystyle=-V_{t+\Delta t}(\bm{x})+\Delta t\inf_{u}\left[\sum_{x\neq y}\bm{A}^{v}_{t}(\bm{x},\bm{y})\left(V_{t+\Delta t}(\bm{x})-V_{t+\Delta t}(\bm{y})\right)\right]+\mathcal{O}(\Delta t^{2})]" display="inline" intent=":literal"><semantics><mrow><mo rspace="0em">=</mo><mo lspace="0em">−</mo><msub><mi>V</mi><mrow><mi>t</mi><mo>+</mo><mrow><mi mathvariant="normal">Δ</mi><mo lspace="0em" rspace="0em">​</mo><mi>t</mi></mrow></mrow></msub><mrow><mo stretchy="false">(</mo><mi>𝒙</mi><mo stretchy="false">)</mo></mrow><mo>+</mo><mi mathvariant="normal">Δ</mi><mi>t</mi><munder><mo lspace="0.167em" movablelimits="false" rspace="0em">inf</mo><mi>u</mi></munder><mrow><mo>[</mo><mstyle displaystyle="true"><munder><mo movablelimits="false">∑</mo><mrow><mi>x</mi><mo>≠</mo><mi>y</mi></mrow></munder></mstyle><msubsup><mi>𝑨</mi><mi>t</mi><mi>v</mi></msubsup><mrow><mo stretchy="false">(</mo><mi>𝒙</mi><mo>,</mo><mi>𝒚</mi><mo stretchy="false">)</mo></mrow><mrow><mo>(</mo><msub><mi>V</mi><mrow><mi>t</mi><mo>+</mo><mrow><mi mathvariant="normal">Δ</mi><mo lspace="0em" rspace="0em">​</mo><mi>t</mi></mrow></mrow></msub><mrow><mo stretchy="false">(</mo><mi>𝒙</mi><mo stretchy="false">)</mo></mrow><mo>−</mo><msub><mi>V</mi><mrow><mi>t</mi><mo>+</mo><mrow><mi mathvariant="normal">Δ</mi><mo lspace="0em" rspace="0em">​</mo><mi>t</mi></mrow></mrow></msub><mrow><mo stretchy="false">(</mo><mi>𝒚</mi><mo stretchy="false">)</mo></mrow><mo>)</mo></mrow><mo>]</mo></mrow><mo>+</mo><mi class="ltx_font_mathcaligraphic">𝒪</mi><mrow><mo stretchy="false">(</mo><mi mathvariant="normal">Δ</mi><msup><mi>t</mi><mn>2</mn></msup><mo stretchy="false">)</mo></mrow><mo stretchy="false">]</mo></mrow><annotation encoding="application/x-tex">\displaystyle=-V_{t+\Delta t}(\bm{x})+\Delta t\inf_{u}\left[\sum_{x\neq y}\bm{A}^{v}_{t}(\bm{x},\bm{y})\left(V_{t+\Delta t}(\bm{x})-V_{t+\Delta t}(\bm{y})\right)\right]+\mathcal{O}(\Delta t^{2})]</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td>
<td rowspan="1" class="ltx_eqn_cell ltx_eqn_eqno ltx_align_middle ltx_align_right"><span class="ltx_tag ltx_tag_equation ltx_align_right">(94)</span></td></tr></tbody>
</table>
<p id="S9.SS8.p4.2" class="ltx_p">Substituting (<a href="#S9.E94" title="Equation 94 ‣ 9.8 Adaptive Joint Decoding Loss ‣ 9 Theoretical Proofs ‣ A2D2: Fine-Tuning Any-Length Discrete Diffusion for Adaptive Decoding" class="ltx_ref"><span class="ltx_text ltx_ref_tag">94</span></a>) back into the Bellman recursion in (<a href="#S9.E92" title="Equation 92 ‣ 9.8 Adaptive Joint Decoding Loss ‣ 9 Theoretical Proofs ‣ A2D2: Fine-Tuning Any-Length Discrete Diffusion for Adaptive Decoding" class="ltx_ref"><span class="ltx_text ltx_ref_tag">92</span></a>), we get:
<span id="S9.SS8.p4.2.1" class="ltx_text"></span></p>
<table id="S9.EGx91" class="ltx_equationgroup ltx_eqn_align ltx_eqn_table">

<tbody id="S9.Ex44"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_align_right ltx_eqn_cell"><math id="S9.Ex44.m1" class="ltx_Math" alttext="\displaystyle-V_{t}(\bm{x})" display="inline" intent=":literal"><semantics><mrow><mo mathsize="0.900em">−</mo><mrow><msub><mi mathsize="0.900em">V</mi><mi mathsize="0.900em">t</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo maxsize="0.900em" minsize="0.900em">(</mo><mi mathsize="0.900em">𝒙</mi><mo maxsize="0.900em" minsize="0.900em">)</mo></mrow></mrow></mrow><annotation encoding="application/x-tex">\displaystyle-V_{t}(\bm{x})</annotation></semantics></math></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="S9.Ex44.m2" class="ltx_Math" alttext="\displaystyle=\left[\Delta t\inf_{v}\sum_{y\neq x}C_{s}(\bm{x},\bm{y})+\mathcal{O}(\Delta t^{2})\right]" display="inline" intent=":literal"><semantics><mrow><mphantom></mphantom><mo mathsize="0.900em">=</mo><mrow><mo>[</mo><mrow><mrow><mi mathsize="0.900em" mathvariant="normal">Δ</mi><mo lspace="0em" rspace="0em">​</mo><mi mathsize="0.900em">t</mi><mo lspace="0.167em" rspace="0em">​</mo><mrow><munder><mo mathsize="0.900em" movablelimits="false" rspace="0.167em">inf</mo><mi mathsize="0.900em">v</mi></munder><mrow><mstyle displaystyle="true"><munder><mo maxsize="0.900em" minsize="0.900em" movablelimits="false" stretchy="true">∑</mo><mrow><mi mathsize="0.900em">y</mi><mo mathsize="0.900em">≠</mo><mi mathsize="0.900em">x</mi></mrow></munder></mstyle><mrow><msub><mi mathsize="0.900em">C</mi><mi mathsize="0.900em">s</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo maxsize="0.900em" minsize="0.900em">(</mo><mi mathsize="0.900em">𝒙</mi><mo mathsize="0.900em">,</mo><mi mathsize="0.900em">𝒚</mi><mo maxsize="0.900em" minsize="0.900em">)</mo></mrow></mrow></mrow></mrow></mrow><mo mathsize="0.900em">+</mo><mrow><mi class="ltx_font_mathcaligraphic" mathsize="0.900em">𝒪</mi><mo>⁡</mo><mrow><mo maxsize="0.900em" minsize="0.900em">(</mo><mrow><mi mathsize="0.900em" mathvariant="normal">Δ</mi><mo lspace="0em" rspace="0em">​</mo><msup><mi mathsize="0.900em">t</mi><mn mathsize="0.900em">2</mn></msup></mrow><mo maxsize="0.900em" minsize="0.900em">)</mo></mrow></mrow></mrow><mo>]</mo></mrow></mrow><annotation encoding="application/x-tex">\displaystyle=\left[\Delta t\inf_{v}\sum_{y\neq x}C_{s}(\bm{x},\bm{y})+\mathcal{O}(\Delta t^{2})\right]</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
<tbody id="S9.Ex45"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_eqn_cell"></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="S9.Ex45.m1" class="ltx_Math" alttext="\displaystyle-V_{t+\Delta t}(\bm{x})+\Delta t\inf_{u}\left[\sum_{x\neq y}\bm{A}^{v}_{t}(\bm{x},\bm{y})\left(V_{t+\Delta t}(\bm{x})-V_{t+\Delta t}(\bm{y})\right)\right]+\mathcal{O}(\Delta t^{2})" display="inline" intent=":literal"><semantics><mrow><mrow><mo mathsize="0.900em">−</mo><mrow><msub><mi mathsize="0.900em">V</mi><mrow><mi mathsize="0.900em">t</mi><mo mathsize="0.900em">+</mo><mrow><mi mathsize="0.900em" mathvariant="normal">Δ</mi><mo lspace="0em" rspace="0em">​</mo><mi mathsize="0.900em">t</mi></mrow></mrow></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo maxsize="0.900em" minsize="0.900em">(</mo><mi mathsize="0.900em">𝒙</mi><mo maxsize="0.900em" minsize="0.900em">)</mo></mrow></mrow></mrow><mo mathsize="0.900em">+</mo><mrow><mi mathsize="0.900em" mathvariant="normal">Δ</mi><mo lspace="0em" rspace="0em">​</mo><mi mathsize="0.900em">t</mi><mo lspace="0.167em" rspace="0em">​</mo><mrow><munder><mo mathsize="0.900em" movablelimits="false" rspace="0em">inf</mo><mi mathsize="0.900em">u</mi></munder><mrow><mo>[</mo><mrow><mstyle displaystyle="true"><munder><mo maxsize="0.900em" minsize="0.900em" movablelimits="false" stretchy="true">∑</mo><mrow><mi mathsize="0.900em">x</mi><mo mathsize="0.900em">≠</mo><mi mathsize="0.900em">y</mi></mrow></munder></mstyle><mrow><msubsup><mi mathsize="0.900em">𝑨</mi><mi mathsize="0.900em">t</mi><mi mathsize="0.900em">v</mi></msubsup><mo lspace="0em" rspace="0em">​</mo><mrow><mo maxsize="0.900em" minsize="0.900em">(</mo><mi mathsize="0.900em">𝒙</mi><mo mathsize="0.900em">,</mo><mi mathsize="0.900em">𝒚</mi><mo maxsize="0.900em" minsize="0.900em">)</mo></mrow><mo lspace="0em" rspace="0em">​</mo><mrow><mo>(</mo><mrow><mrow><msub><mi mathsize="0.900em">V</mi><mrow><mi mathsize="0.900em">t</mi><mo mathsize="0.900em">+</mo><mrow><mi mathsize="0.900em" mathvariant="normal">Δ</mi><mo lspace="0em" rspace="0em">​</mo><mi mathsize="0.900em">t</mi></mrow></mrow></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo maxsize="0.900em" minsize="0.900em">(</mo><mi mathsize="0.900em">𝒙</mi><mo maxsize="0.900em" minsize="0.900em">)</mo></mrow></mrow><mo mathsize="0.900em">−</mo><mrow><msub><mi mathsize="0.900em">V</mi><mrow><mi mathsize="0.900em">t</mi><mo mathsize="0.900em">+</mo><mrow><mi mathsize="0.900em" mathvariant="normal">Δ</mi><mo lspace="0em" rspace="0em">​</mo><mi mathsize="0.900em">t</mi></mrow></mrow></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo maxsize="0.900em" minsize="0.900em">(</mo><mi mathsize="0.900em">𝒚</mi><mo maxsize="0.900em" minsize="0.900em">)</mo></mrow></mrow></mrow><mo>)</mo></mrow></mrow></mrow><mo>]</mo></mrow></mrow></mrow><mo mathsize="0.900em">+</mo><mrow><mi class="ltx_font_mathcaligraphic" mathsize="0.900em">𝒪</mi><mo>⁡</mo><mrow><mo maxsize="0.900em" minsize="0.900em">(</mo><mrow><mi mathsize="0.900em" mathvariant="normal">Δ</mi><mo lspace="0em" rspace="0em">​</mo><msup><mi mathsize="0.900em">t</mi><mn mathsize="0.900em">2</mn></msup></mrow><mo maxsize="0.900em" minsize="0.900em">)</mo></mrow></mrow></mrow><annotation encoding="application/x-tex">\displaystyle-V_{t+\Delta t}(\bm{x})+\Delta t\inf_{u}\left[\sum_{x\neq y}\bm{A}^{v}_{t}(\bm{x},\bm{y})\left(V_{t+\Delta t}(\bm{x})-V_{t+\Delta t}(\bm{y})\right)\right]+\mathcal{O}(\Delta t^{2})</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
<tbody id="S9.E95"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_align_right ltx_eqn_cell"><math id="S9.E95.m1" class="ltx_Math" alttext="\displaystyle V_{t+\Delta t}(\bm{x})-V_{t}(\bm{x})" display="inline" intent=":literal"><semantics><mrow><mrow><msub><mi mathsize="0.900em">V</mi><mrow><mi mathsize="0.900em">t</mi><mo mathsize="0.900em">+</mo><mrow><mi mathsize="0.900em" mathvariant="normal">Δ</mi><mo lspace="0em" rspace="0em">​</mo><mi mathsize="0.900em">t</mi></mrow></mrow></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo maxsize="0.900em" minsize="0.900em">(</mo><mi mathsize="0.900em">𝒙</mi><mo maxsize="0.900em" minsize="0.900em">)</mo></mrow></mrow><mo mathsize="0.900em">−</mo><mrow><msub><mi mathsize="0.900em">V</mi><mi mathsize="0.900em">t</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo maxsize="0.900em" minsize="0.900em">(</mo><mi mathsize="0.900em">𝒙</mi><mo maxsize="0.900em" minsize="0.900em">)</mo></mrow></mrow></mrow><annotation encoding="application/x-tex">\displaystyle V_{t+\Delta t}(\bm{x})-V_{t}(\bm{x})</annotation></semantics></math></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="S9.E95.m2" class="ltx_Math" alttext="\displaystyle=\Delta t\inf_{v}\sum_{y\neq x}\left[C_{s}(\bm{x},\bm{y})+\bm{A}^{v}_{t}(\bm{x},\bm{y})\left(V_{t+\Delta t}(\bm{x})-V_{t+\Delta t}(\bm{y})\right)\right]" display="inline" intent=":literal"><semantics><mrow><mphantom></mphantom><mo mathsize="0.900em">=</mo><mrow><mi mathsize="0.900em" mathvariant="normal">Δ</mi><mo lspace="0em" rspace="0em">​</mo><mi mathsize="0.900em">t</mi><mo lspace="0.167em" rspace="0em">​</mo><mrow><munder><mo mathsize="0.900em" movablelimits="false" rspace="0.167em">inf</mo><mi mathsize="0.900em">v</mi></munder><mrow><mstyle displaystyle="true"><munder><mo maxsize="0.900em" minsize="0.900em" movablelimits="false" stretchy="true">∑</mo><mrow><mi mathsize="0.900em">y</mi><mo mathsize="0.900em">≠</mo><mi mathsize="0.900em">x</mi></mrow></munder></mstyle><mrow><mo>[</mo><mrow><mrow><msub><mi mathsize="0.900em">C</mi><mi mathsize="0.900em">s</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo maxsize="0.900em" minsize="0.900em">(</mo><mi mathsize="0.900em">𝒙</mi><mo mathsize="0.900em">,</mo><mi mathsize="0.900em">𝒚</mi><mo maxsize="0.900em" minsize="0.900em">)</mo></mrow></mrow><mo mathsize="0.900em">+</mo><mrow><msubsup><mi mathsize="0.900em">𝑨</mi><mi mathsize="0.900em">t</mi><mi mathsize="0.900em">v</mi></msubsup><mo lspace="0em" rspace="0em">​</mo><mrow><mo maxsize="0.900em" minsize="0.900em">(</mo><mi mathsize="0.900em">𝒙</mi><mo mathsize="0.900em">,</mo><mi mathsize="0.900em">𝒚</mi><mo maxsize="0.900em" minsize="0.900em">)</mo></mrow><mo lspace="0em" rspace="0em">​</mo><mrow><mo>(</mo><mrow><mrow><msub><mi mathsize="0.900em">V</mi><mrow><mi mathsize="0.900em">t</mi><mo mathsize="0.900em">+</mo><mrow><mi mathsize="0.900em" mathvariant="normal">Δ</mi><mo lspace="0em" rspace="0em">​</mo><mi mathsize="0.900em">t</mi></mrow></mrow></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo maxsize="0.900em" minsize="0.900em">(</mo><mi mathsize="0.900em">𝒙</mi><mo maxsize="0.900em" minsize="0.900em">)</mo></mrow></mrow><mo mathsize="0.900em">−</mo><mrow><msub><mi mathsize="0.900em">V</mi><mrow><mi mathsize="0.900em">t</mi><mo mathsize="0.900em">+</mo><mrow><mi mathsize="0.900em" mathvariant="normal">Δ</mi><mo lspace="0em" rspace="0em">​</mo><mi mathsize="0.900em">t</mi></mrow></mrow></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo maxsize="0.900em" minsize="0.900em">(</mo><mi mathsize="0.900em">𝒚</mi><mo maxsize="0.900em" minsize="0.900em">)</mo></mrow></mrow></mrow><mo>)</mo></mrow></mrow></mrow><mo>]</mo></mrow></mrow></mrow></mrow></mrow><annotation encoding="application/x-tex">\displaystyle=\Delta t\inf_{v}\sum_{y\neq x}\left[C_{s}(\bm{x},\bm{y})+\bm{A}^{v}_{t}(\bm{x},\bm{y})\left(V_{t+\Delta t}(\bm{x})-V_{t+\Delta t}(\bm{y})\right)\right]</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td>
<td rowspan="1" class="ltx_eqn_cell ltx_eqn_eqno ltx_align_middle ltx_align_right"><span class="ltx_tag ltx_tag_equation ltx_align_right">(95)</span></td></tr></tbody>
</table>
<p id="S9.SS8.p4.3" class="ltx_p">Then, dividing by <math id="S9.SS8.p4.m2" class="ltx_Math" alttext="\Delta t" display="inline" intent=":literal"><semantics><mrow><mi mathvariant="normal">Δ</mi><mo lspace="0em" rspace="0em">​</mo><mi>t</mi></mrow><annotation encoding="application/x-tex">\Delta t</annotation></semantics></math>, taking the limit <math id="S9.SS8.p4.m3" class="ltx_Math" alttext="\Delta t\to 0" display="inline" intent=":literal"><semantics><mrow><mrow><mi mathvariant="normal">Δ</mi><mo lspace="0em" rspace="0em">​</mo><mi>t</mi></mrow><mo stretchy="false">→</mo><mn>0</mn></mrow><annotation encoding="application/x-tex">\Delta t\to 0</annotation></semantics></math>, and substituting <math id="S9.SS8.p4.m4" class="ltx_Math" alttext="C_{s}(x,y)=\left(\bm{A}^{v}_{t}\log\frac{\bm{A}^{v}}{\bm{A}^{0}}-\bm{A}^{v}+\bm{A}^{0}\right)(x,y)" display="inline" intent=":literal"><semantics><mrow><mrow><msub><mi>C</mi><mi>s</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>x</mi><mo>,</mo><mi>y</mi><mo stretchy="false">)</mo></mrow></mrow><mo>=</mo><mrow><mrow><mo>(</mo><mrow><mrow><mrow><msubsup><mi>𝑨</mi><mi>t</mi><mi>v</mi></msubsup><mo lspace="0.167em" rspace="0em">​</mo><mrow><mi>log</mi><mo lspace="0.167em">⁡</mo><mfrac><msup><mi>𝑨</mi><mi>v</mi></msup><msup><mi>𝑨</mi><mn>0</mn></msup></mfrac></mrow></mrow><mo>−</mo><msup><mi>𝑨</mi><mi>v</mi></msup></mrow><mo>+</mo><msup><mi>𝑨</mi><mn>0</mn></msup></mrow><mo>)</mo></mrow><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>x</mi><mo>,</mo><mi>y</mi><mo stretchy="false">)</mo></mrow></mrow></mrow><annotation encoding="application/x-tex">C_{s}(x,y)=\left(\bm{A}^{v}_{t}\log\frac{\bm{A}^{v}}{\bm{A}^{0}}-\bm{A}^{v}+\bm{A}^{0}\right)(x,y)</annotation></semantics></math>, we get:</p>
<table id="S9.EGx92" class="ltx_equationgroup ltx_eqn_align ltx_eqn_table">

<tbody id="S9.E96"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_align_right ltx_eqn_cell"><math id="S9.E96.m1" class="ltx_Math" alttext="\displaystyle\partial_{t}V_{t}(\bm{x})" display="inline" intent=":literal"><semantics><mrow><msub><mo>∂</mo><mi>t</mi></msub><mrow><msub><mi>V</mi><mi>t</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>𝒙</mi><mo stretchy="false">)</mo></mrow></mrow></mrow><annotation encoding="application/x-tex">\displaystyle\partial_{t}V_{t}(\bm{x})</annotation></semantics></math></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="S9.E96.m2" class="ltx_Math" alttext="\displaystyle=\lim_{\Delta t\to 0}\frac{V_{t+\Delta t}(\bm{x})-V_{t}(\bm{x})}{\Delta t}=\inf_{v}\sum_{y\neq x}\left[C_{s}(\bm{x},\bm{y})+\bm{A}^{v}_{t}(\bm{x},\bm{y})\left(V_{t}(\bm{x})-V_{t}(\bm{y})\right)\right]" display="inline" intent=":literal"><semantics><mrow><mphantom></mphantom><mo rspace="0.1389em">=</mo><mrow><munder><mo lspace="0.1389em" movablelimits="false" rspace="0.167em">lim</mo><mrow><mrow><mi mathvariant="normal">Δ</mi><mo lspace="0em" rspace="0em">​</mo><mi>t</mi></mrow><mo stretchy="false">→</mo><mn>0</mn></mrow></munder><mstyle displaystyle="true"><mfrac><mrow><mrow><msub><mi>V</mi><mrow><mi>t</mi><mo>+</mo><mrow><mi mathvariant="normal">Δ</mi><mo lspace="0em" rspace="0em">​</mo><mi>t</mi></mrow></mrow></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>𝒙</mi><mo stretchy="false">)</mo></mrow></mrow><mo>−</mo><mrow><msub><mi>V</mi><mi>t</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>𝒙</mi><mo stretchy="false">)</mo></mrow></mrow></mrow><mrow><mi mathvariant="normal">Δ</mi><mo lspace="0em" rspace="0em">​</mo><mi>t</mi></mrow></mfrac></mstyle></mrow><mo rspace="0.1389em">=</mo><mrow><munder><mo lspace="0.1389em" movablelimits="false" rspace="0.167em">inf</mo><mi>v</mi></munder><mrow><mstyle displaystyle="true"><munder><mo movablelimits="false">∑</mo><mrow><mi>y</mi><mo>≠</mo><mi>x</mi></mrow></munder></mstyle><mrow><mo>[</mo><mrow><mrow><msub><mi>C</mi><mi>s</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>𝒙</mi><mo>,</mo><mi>𝒚</mi><mo stretchy="false">)</mo></mrow></mrow><mo>+</mo><mrow><msubsup><mi>𝑨</mi><mi>t</mi><mi>v</mi></msubsup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>𝒙</mi><mo>,</mo><mi>𝒚</mi><mo stretchy="false">)</mo></mrow><mo lspace="0em" rspace="0em">​</mo><mrow><mo>(</mo><mrow><mrow><msub><mi>V</mi><mi>t</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>𝒙</mi><mo stretchy="false">)</mo></mrow></mrow><mo>−</mo><mrow><msub><mi>V</mi><mi>t</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>𝒚</mi><mo stretchy="false">)</mo></mrow></mrow></mrow><mo>)</mo></mrow></mrow></mrow><mo>]</mo></mrow></mrow></mrow></mrow><annotation encoding="application/x-tex">\displaystyle=\lim_{\Delta t\to 0}\frac{V_{t+\Delta t}(\bm{x})-V_{t}(\bm{x})}{\Delta t}=\inf_{v}\sum_{y\neq x}\left[C_{s}(\bm{x},\bm{y})+\bm{A}^{v}_{t}(\bm{x},\bm{y})\left(V_{t}(\bm{x})-V_{t}(\bm{y})\right)\right]</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td>
<td rowspan="1" class="ltx_eqn_cell ltx_eqn_eqno ltx_align_middle ltx_align_right"><span class="ltx_tag ltx_tag_equation ltx_align_right">(96)</span></td></tr></tbody>
<tbody id="S9.E97"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_eqn_cell"></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="S9.E97.m1" class="ltx_Math" alttext="\displaystyle=\inf_{v}\sum_{y\neq x}\left[\left(\bm{A}^{v}_{t}\log\frac{\bm{A}^{v}}{\bm{A}^{0}}-\bm{A}^{v}+\bm{A}^{0}\right)(\bm{x},\bm{y})+\bm{A}^{v}_{t}(\bm{x},\bm{y})\left(V_{t}(\bm{x})-V_{t}(\bm{y})\right)\right]" display="inline" intent=":literal"><semantics><mrow><mphantom></mphantom><mo rspace="0.1389em">=</mo><mrow><munder><mo lspace="0.1389em" movablelimits="false" rspace="0.167em">inf</mo><mi>v</mi></munder><mrow><mstyle displaystyle="true"><munder><mo movablelimits="false">∑</mo><mrow><mi>y</mi><mo>≠</mo><mi>x</mi></mrow></munder></mstyle><mrow><mo>[</mo><mrow><mrow><mrow><mo>(</mo><mrow><mrow><mrow><msubsup><mi>𝑨</mi><mi>t</mi><mi>v</mi></msubsup><mo lspace="0.167em" rspace="0em">​</mo><mrow><mi>log</mi><mo lspace="0.167em">⁡</mo><mstyle displaystyle="true"><mfrac><msup><mi>𝑨</mi><mi>v</mi></msup><msup><mi>𝑨</mi><mn>0</mn></msup></mfrac></mstyle></mrow></mrow><mo>−</mo><msup><mi>𝑨</mi><mi>v</mi></msup></mrow><mo>+</mo><msup><mi>𝑨</mi><mn>0</mn></msup></mrow><mo>)</mo></mrow><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>𝒙</mi><mo>,</mo><mi>𝒚</mi><mo stretchy="false">)</mo></mrow></mrow><mo>+</mo><mrow><msubsup><mi>𝑨</mi><mi>t</mi><mi>v</mi></msubsup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>𝒙</mi><mo>,</mo><mi>𝒚</mi><mo stretchy="false">)</mo></mrow><mo lspace="0em" rspace="0em">​</mo><mrow><mo>(</mo><mrow><mrow><msub><mi>V</mi><mi>t</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>𝒙</mi><mo stretchy="false">)</mo></mrow></mrow><mo>−</mo><mrow><msub><mi>V</mi><mi>t</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>𝒚</mi><mo stretchy="false">)</mo></mrow></mrow></mrow><mo>)</mo></mrow></mrow></mrow><mo>]</mo></mrow></mrow></mrow></mrow><annotation encoding="application/x-tex">\displaystyle=\inf_{v}\sum_{y\neq x}\left[\left(\bm{A}^{v}_{t}\log\frac{\bm{A}^{v}}{\bm{A}^{0}}-\bm{A}^{v}+\bm{A}^{0}\right)(\bm{x},\bm{y})+\bm{A}^{v}_{t}(\bm{x},\bm{y})\left(V_{t}(\bm{x})-V_{t}(\bm{y})\right)\right]</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td>
<td rowspan="1" class="ltx_eqn_cell ltx_eqn_eqno ltx_align_middle ltx_align_right"><span class="ltx_tag ltx_tag_equation ltx_align_right">(97)</span></td></tr></tbody>
</table>
<p id="S9.SS8.p4.4" class="ltx_p">The infimum is achieved by minimizing the following for every pair <math id="S9.SS8.p4.m5" class="ltx_Math" alttext="(\bm{x},\bm{y})" display="inline" intent=":literal"><semantics><mrow><mo stretchy="false">(</mo><mi>𝒙</mi><mo>,</mo><mi>𝒚</mi><mo stretchy="false">)</mo></mrow><annotation encoding="application/x-tex">(\bm{x},\bm{y})</annotation></semantics></math>:</p>
<table id="S9.EGx93" class="ltx_equationgroup ltx_eqn_align ltx_eqn_table">

<tbody id="S9.E98"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_align_right ltx_eqn_cell"><math id="S9.E98.m1" class="ltx_Math" alttext="\displaystyle f(\bm{A}^{v})" display="inline" intent=":literal"><semantics><mrow><mi>f</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><msup><mi>𝑨</mi><mi>v</mi></msup><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">\displaystyle f(\bm{A}^{v})</annotation></semantics></math></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="S9.E98.m2" class="ltx_Math" alttext="\displaystyle=\bm{A}^{v}_{t}\log\frac{\bm{A}^{v}}{\bm{A}^{0}}-\bm{A}^{v}+\bm{A}^{0}+\bm{A}^{v}_{t}\left(V_{t}(\bm{x})-V_{t}(\bm{y})\right)" display="inline" intent=":literal"><semantics><mrow><mphantom></mphantom><mo>=</mo><mrow><mrow><mrow><msubsup><mi>𝑨</mi><mi>t</mi><mi>v</mi></msubsup><mo lspace="0.167em" rspace="0em">​</mo><mrow><mi>log</mi><mo lspace="0.167em">⁡</mo><mstyle displaystyle="true"><mfrac><msup><mi>𝑨</mi><mi>v</mi></msup><msup><mi>𝑨</mi><mn>0</mn></msup></mfrac></mstyle></mrow></mrow><mo>−</mo><msup><mi>𝑨</mi><mi>v</mi></msup></mrow><mo>+</mo><msup><mi>𝑨</mi><mn>0</mn></msup><mo>+</mo><mrow><msubsup><mi>𝑨</mi><mi>t</mi><mi>v</mi></msubsup><mo lspace="0em" rspace="0em">​</mo><mrow><mo>(</mo><mrow><mrow><msub><mi>V</mi><mi>t</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>𝒙</mi><mo stretchy="false">)</mo></mrow></mrow><mo>−</mo><mrow><msub><mi>V</mi><mi>t</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>𝒚</mi><mo stretchy="false">)</mo></mrow></mrow></mrow><mo>)</mo></mrow></mrow></mrow></mrow><annotation encoding="application/x-tex">\displaystyle=\bm{A}^{v}_{t}\log\frac{\bm{A}^{v}}{\bm{A}^{0}}-\bm{A}^{v}+\bm{A}^{0}+\bm{A}^{v}_{t}\left(V_{t}(\bm{x})-V_{t}(\bm{y})\right)</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td>
<td rowspan="1" class="ltx_eqn_cell ltx_eqn_eqno ltx_align_middle ltx_align_right"><span class="ltx_tag ltx_tag_equation ltx_align_right">(98)</span></td></tr></tbody>
<tbody id="S9.E99"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_align_right ltx_eqn_cell"><math id="S9.E99.m1" class="ltx_Math" alttext="\displaystyle f^{\prime}(\bm{A}^{v})" display="inline" intent=":literal"><semantics><mrow><msup><mi>f</mi><mo>′</mo></msup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msup><mi>𝑨</mi><mi>v</mi></msup><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">\displaystyle f^{\prime}(\bm{A}^{v})</annotation></semantics></math></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="S9.E99.m2" class="ltx_Math" alttext="\displaystyle=\log\frac{\bm{A}^{v}}{\bm{A}^{0}}+\left(V_{t}(\bm{x})-V_{t}(\bm{y})\right)" display="inline" intent=":literal"><semantics><mrow><mphantom></mphantom><mo>=</mo><mrow><mrow><mi>log</mi><mo lspace="0.167em">⁡</mo><mstyle displaystyle="true"><mfrac><msup><mi>𝑨</mi><mi>v</mi></msup><msup><mi>𝑨</mi><mn>0</mn></msup></mfrac></mstyle></mrow><mo>+</mo><mrow><mo>(</mo><mrow><mrow><msub><mi>V</mi><mi>t</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>𝒙</mi><mo stretchy="false">)</mo></mrow></mrow><mo>−</mo><mrow><msub><mi>V</mi><mi>t</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>𝒚</mi><mo stretchy="false">)</mo></mrow></mrow></mrow><mo>)</mo></mrow></mrow></mrow><annotation encoding="application/x-tex">\displaystyle=\log\frac{\bm{A}^{v}}{\bm{A}^{0}}+\left(V_{t}(\bm{x})-V_{t}(\bm{y})\right)</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td>
<td rowspan="1" class="ltx_eqn_cell ltx_eqn_eqno ltx_align_middle ltx_align_right"><span class="ltx_tag ltx_tag_equation ltx_align_right">(99)</span></td></tr></tbody>
</table>
<p id="S9.SS8.p4.5" class="ltx_p">The minimizer <math id="S9.SS8.p4.m6" class="ltx_Math" alttext="\bm{A}^{\star}" display="inline" intent=":literal"><semantics><msup><mi>𝑨</mi><mo>⋆</mo></msup><annotation encoding="application/x-tex">\bm{A}^{\star}</annotation></semantics></math> satisfying <math id="S9.SS8.p4.m7" class="ltx_Math" alttext="f^{\prime}(\bm{A}^{v})=0" display="inline" intent=":literal"><semantics><mrow><mrow><msup><mi>f</mi><mo>′</mo></msup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msup><mi>𝑨</mi><mi>v</mi></msup><mo stretchy="false">)</mo></mrow></mrow><mo>=</mo><mn>0</mn></mrow><annotation encoding="application/x-tex">f^{\prime}(\bm{A}^{v})=0</annotation></semantics></math> is defined as:</p>
<table id="S9.EGx94" class="ltx_equationgroup ltx_eqn_align ltx_eqn_table">

<tbody id="S9.E100"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_align_right ltx_eqn_cell"><math id="S9.E100.m1" class="ltx_Math" alttext="\displaystyle\log\frac{\bm{A}^{\star}}{\bm{A}^{0}}=V_{t}(\bm{y})-V_{t}(\bm{x})\implies\bm{A}^{\star}_{t}(\bm{x},\bm{y})=\bm{A}^{0}_{t}(\bm{x},\bm{y})\exp\left(V_{t}(\bm{y})-V_{t}(\bm{x})\right)" display="inline" intent=":literal"><semantics><mrow><mrow><mi>log</mi><mo lspace="0.167em">⁡</mo><mstyle displaystyle="true"><mfrac><msup><mi>𝑨</mi><mo>⋆</mo></msup><msup><mi>𝑨</mi><mn>0</mn></msup></mfrac></mstyle></mrow><mo>=</mo><mrow><mrow><msub><mi>V</mi><mi>t</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>𝒚</mi><mo stretchy="false">)</mo></mrow></mrow><mo>−</mo><mrow><msub><mi>V</mi><mi>t</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>𝒙</mi><mo stretchy="false">)</mo></mrow></mrow></mrow><mo stretchy="false">⟹</mo><mrow><msubsup><mi>𝑨</mi><mi>t</mi><mo>⋆</mo></msubsup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>𝒙</mi><mo>,</mo><mi>𝒚</mi><mo stretchy="false">)</mo></mrow></mrow><mo>=</mo><mrow><msubsup><mi>𝑨</mi><mi>t</mi><mn>0</mn></msubsup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>𝒙</mi><mo>,</mo><mi>𝒚</mi><mo stretchy="false">)</mo></mrow><mo lspace="0.167em" rspace="0em">​</mo><mrow><mi>exp</mi><mo>⁡</mo><mrow><mo>(</mo><mrow><mrow><msub><mi>V</mi><mi>t</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>𝒚</mi><mo stretchy="false">)</mo></mrow></mrow><mo>−</mo><mrow><msub><mi>V</mi><mi>t</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>𝒙</mi><mo stretchy="false">)</mo></mrow></mrow></mrow><mo>)</mo></mrow></mrow></mrow></mrow><annotation encoding="application/x-tex">\displaystyle\log\frac{\bm{A}^{\star}}{\bm{A}^{0}}=V_{t}(\bm{y})-V_{t}(\bm{x})\implies\bm{A}^{\star}_{t}(\bm{x},\bm{y})=\bm{A}^{0}_{t}(\bm{x},\bm{y})\exp\left(V_{t}(\bm{y})-V_{t}(\bm{x})\right)</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td>
<td rowspan="1" class="ltx_eqn_cell ltx_eqn_eqno ltx_align_middle ltx_align_right"><span class="ltx_tag ltx_tag_equation ltx_align_right">(100)</span></td></tr></tbody>
</table>
<p id="S9.SS8.p4.6" class="ltx_p">Since the total generator factorizes into the sum of insertion and unmasking rates, and rates do not overlap as defined in App <a href="#S9.SS1" title="9.1 Observations ‣ 9 Theoretical Proofs ‣ A2D2: Fine-Tuning Any-Length Discrete Diffusion for Adaptive Decoding" class="ltx_ref"><span class="ltx_text ltx_ref_tag">9.1</span></a>, we have:
<span id="S9.SS8.p4.6.1" class="ltx_text"></span></p>
<table id="S9.EGx95" class="ltx_equationgroup ltx_eqn_align ltx_eqn_table">

<tbody id="S9.E101"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_align_right ltx_eqn_cell"><math id="S9.E101.m1" class="ltx_Math" alttext="\displaystyle\bm{A}^{\star}_{t}(\bm{x},\bm{y})" display="inline" intent=":literal"><semantics><mrow><msubsup><mi mathsize="0.900em">𝑨</mi><mi mathsize="0.900em">t</mi><mo mathsize="0.900em">⋆</mo></msubsup><mo lspace="0em" rspace="0em">​</mo><mrow><mo maxsize="0.900em" minsize="0.900em">(</mo><mi mathsize="0.900em">𝒙</mi><mo mathsize="0.900em">,</mo><mi mathsize="0.900em">𝒚</mi><mo maxsize="0.900em" minsize="0.900em">)</mo></mrow></mrow><annotation encoding="application/x-tex">\displaystyle\bm{A}^{\star}_{t}(\bm{x},\bm{y})</annotation></semantics></math></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="S9.E101.m2" class="ltx_Math" alttext="\displaystyle=\bm{Q}^{\star}_{t}(\bm{x},\bm{y})+\bm{R}^{\star}_{t}(\bm{x},\bm{y})\hskip 9.24994pt\text{s.t.}\hskip 9.24994pt\begin{cases}\bm{Q}^{\star}_{t}(\bm{x},\bm{y})=\bm{Q}^{0}_{t}(\bm{x},\bm{y})\exp\left(V_{t}(\bm{y})-V_{t}(\bm{x})\right)\\
\bm{R}^{\star}_{t}(\bm{x},\bm{y})=\bm{R}^{0}_{t}(\bm{x},\bm{y})\exp\left(V_{t}(\bm{y})-V_{t}(\bm{x})\right)\end{cases}" display="inline" intent=":literal"><semantics><mrow><mphantom></mphantom><mo mathsize="0.900em">=</mo><mrow><mrow><msubsup><mi mathsize="0.900em">𝑸</mi><mi mathsize="0.900em">t</mi><mo mathsize="0.900em">⋆</mo></msubsup><mo lspace="0em" rspace="0em">​</mo><mrow><mo maxsize="0.900em" minsize="0.900em">(</mo><mi mathsize="0.900em">𝒙</mi><mo mathsize="0.900em">,</mo><mi mathsize="0.900em">𝒚</mi><mo maxsize="0.900em" minsize="0.900em">)</mo></mrow></mrow><mo mathsize="0.900em">+</mo><mrow><msubsup><mi mathsize="0.900em">𝑹</mi><mi mathsize="0.900em">t</mi><mo mathsize="0.900em">⋆</mo></msubsup><mo lspace="0em" rspace="0em">​</mo><mrow><mo maxsize="0.900em" minsize="0.900em">(</mo><mi mathsize="0.900em">𝒙</mi><mo mathsize="0.900em">,</mo><mi mathsize="0.900em">𝒚</mi><mo maxsize="0.900em" minsize="0.900em">)</mo></mrow><mo lspace="0.930em" rspace="0em">​</mo><mtext mathsize="0.900em">s.t.</mtext><mo lspace="0.930em" rspace="0em">​</mo><mrow><mo>{</mo><mtable columnspacing="5pt" rowspacing="0pt"><mtr><mtd class="ltx_align_left" columnalign="left"><mrow><mrow><msubsup><mi mathsize="0.900em">𝑸</mi><mi mathsize="0.900em">t</mi><mo mathsize="0.900em">⋆</mo></msubsup><mo lspace="0em" rspace="0em">​</mo><mrow><mo maxsize="0.900em" minsize="0.900em">(</mo><mi mathsize="0.900em">𝒙</mi><mo mathsize="0.900em">,</mo><mi mathsize="0.900em">𝒚</mi><mo maxsize="0.900em" minsize="0.900em">)</mo></mrow></mrow><mo mathsize="0.900em">=</mo><mrow><msubsup><mi mathsize="0.900em">𝑸</mi><mi mathsize="0.900em">t</mi><mn mathsize="0.900em">0</mn></msubsup><mo lspace="0em" rspace="0em">​</mo><mrow><mo maxsize="0.900em" minsize="0.900em">(</mo><mi mathsize="0.900em">𝒙</mi><mo mathsize="0.900em">,</mo><mi mathsize="0.900em">𝒚</mi><mo maxsize="0.900em" minsize="0.900em">)</mo></mrow><mo lspace="0.167em" rspace="0em">​</mo><mrow><mi mathsize="0.900em">exp</mi><mo>⁡</mo><mrow><mo>(</mo><mrow><mrow><msub><mi mathsize="0.900em">V</mi><mi mathsize="0.900em">t</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo maxsize="0.900em" minsize="0.900em">(</mo><mi mathsize="0.900em">𝒚</mi><mo maxsize="0.900em" minsize="0.900em">)</mo></mrow></mrow><mo mathsize="0.900em">−</mo><mrow><msub><mi mathsize="0.900em">V</mi><mi mathsize="0.900em">t</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo maxsize="0.900em" minsize="0.900em">(</mo><mi mathsize="0.900em">𝒙</mi><mo maxsize="0.900em" minsize="0.900em">)</mo></mrow></mrow></mrow><mo>)</mo></mrow></mrow></mrow></mrow></mtd><mtd></mtd></mtr><mtr><mtd class="ltx_align_left" columnalign="left"><mrow><mrow><msubsup><mi mathsize="0.900em">𝑹</mi><mi mathsize="0.900em">t</mi><mo mathsize="0.900em">⋆</mo></msubsup><mo lspace="0em" rspace="0em">​</mo><mrow><mo maxsize="0.900em" minsize="0.900em">(</mo><mi mathsize="0.900em">𝒙</mi><mo mathsize="0.900em">,</mo><mi mathsize="0.900em">𝒚</mi><mo maxsize="0.900em" minsize="0.900em">)</mo></mrow></mrow><mo mathsize="0.900em">=</mo><mrow><msubsup><mi mathsize="0.900em">𝑹</mi><mi mathsize="0.900em">t</mi><mn mathsize="0.900em">0</mn></msubsup><mo lspace="0em" rspace="0em">​</mo><mrow><mo maxsize="0.900em" minsize="0.900em">(</mo><mi mathsize="0.900em">𝒙</mi><mo mathsize="0.900em">,</mo><mi mathsize="0.900em">𝒚</mi><mo maxsize="0.900em" minsize="0.900em">)</mo></mrow><mo lspace="0.167em" rspace="0em">​</mo><mrow><mi mathsize="0.900em">exp</mi><mo>⁡</mo><mrow><mo>(</mo><mrow><mrow><msub><mi mathsize="0.900em">V</mi><mi mathsize="0.900em">t</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo maxsize="0.900em" minsize="0.900em">(</mo><mi mathsize="0.900em">𝒚</mi><mo maxsize="0.900em" minsize="0.900em">)</mo></mrow></mrow><mo mathsize="0.900em">−</mo><mrow><msub><mi mathsize="0.900em">V</mi><mi mathsize="0.900em">t</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo maxsize="0.900em" minsize="0.900em">(</mo><mi mathsize="0.900em">𝒙</mi><mo maxsize="0.900em" minsize="0.900em">)</mo></mrow></mrow></mrow><mo>)</mo></mrow></mrow></mrow></mrow></mtd><mtd></mtd></mtr></mtable></mrow></mrow></mrow></mrow><annotation encoding="application/x-tex">\displaystyle=\bm{Q}^{\star}_{t}(\bm{x},\bm{y})+\bm{R}^{\star}_{t}(\bm{x},\bm{y})\hskip 9.24994pt\text{s.t.}\hskip 9.24994pt\begin{cases}\bm{Q}^{\star}_{t}(\bm{x},\bm{y})=\bm{Q}^{0}_{t}(\bm{x},\bm{y})\exp\left(V_{t}(\bm{y})-V_{t}(\bm{x})\right)\\
\bm{R}^{\star}_{t}(\bm{x},\bm{y})=\bm{R}^{0}_{t}(\bm{x},\bm{y})\exp\left(V_{t}(\bm{y})-V_{t}(\bm{x})\right)\end{cases}</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td>
<td rowspan="1" class="ltx_eqn_cell ltx_eqn_eqno ltx_align_middle ltx_align_right"><span class="ltx_tag ltx_tag_equation ltx_align_right">(101)</span></td></tr></tbody>
</table>
<p id="S9.SS8.p4.7" class="ltx_p">which proves our result.  <math id="S9.SS8.p4.m8" class="ltx_Math" alttext="\square" display="inline" intent=":literal"><semantics><mi mathvariant="normal">□</mi><annotation encoding="application/x-tex">\square</annotation></semantics></math></p>
</div>
<div id="S9.SS8.p5" class="ltx_para ltx_noindent">
<p id="S9.SS8.p5.1" class="ltx_p">Now, we will derive the form of the optimal path measure <math id="S9.SS8.p5.m1" class="ltx_Math" alttext="\mathbb{P}^{\star}" display="inline" intent=":literal"><semantics><msup><mi>ℙ</mi><mo>⋆</mo></msup><annotation encoding="application/x-tex">\mathbb{P}^{\star}</annotation></semantics></math> corresponding to the optimal generator <math id="S9.SS8.p5.m2" class="ltx_Math" alttext="\bm{A}^{\star}" display="inline" intent=":literal"><semantics><msup><mi>𝑨</mi><mo>⋆</mo></msup><annotation encoding="application/x-tex">\bm{A}^{\star}</annotation></semantics></math>.</p>
</div>
<div id="S9.Thmlemma3" class="ltx_theorem ltx_theorem_lemma">
<h6 class="ltx_title ltx_runin ltx_title_theorem"><span class="ltx_tag ltx_tag_theorem"><span id="S9.Thmlemma3.2" class="ltx_text ltx_font_bold">Lemma 9.3</span></span><span id="S9.Thmlemma3.3" class="ltx_text ltx_font_bold"> </span>(Optimal Path Measure)<span id="S9.Thmlemma3.4" class="ltx_text ltx_font_bold">.</span></h6>
<div id="S9.Thmlemma3.p1" class="ltx_para">
<p id="S9.Thmlemma3.p1.1" class="ltx_p"><span id="S9.Thmlemma3.p1.1.1" class="ltx_text ltx_font_italic">The optimal path measure <math id="S9.Thmlemma3.p1.m1" class="ltx_Math" alttext="\mathbb{P}^{\star}" display="inline" intent=":literal"><semantics><msup><mi>ℙ</mi><mo>⋆</mo></msup><annotation encoding="application/x-tex">\mathbb{P}^{\star}</annotation></semantics></math> corresponding to the value function <math id="S9.Thmlemma3.p1.m2" class="ltx_Math" alttext="V_{t}(\bm{x})" display="inline" intent=":literal"><semantics><mrow><msub><mi>V</mi><mi>t</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>𝐱</mi><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">V_{t}(\bm{x})</annotation></semantics></math> is defined as:</span></p>
<table id="S9.EGx96" class="ltx_equationgroup ltx_eqn_align ltx_eqn_table">

<tbody id="S9.E102"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_align_right ltx_eqn_cell"><math id="S9.E102.m1" class="ltx_Math" alttext="\displaystyle\mathbb{P}^{\star}_{t}(\bm{x})=\frac{1}{Z}\mathbb{P}^{0}_{t}(\bm{x})\mathrm{e}^{V_{t}(\bm{x})},\quad Z:=\mathbb{E}_{\bm{x}\sim\mathbb{P}^{0}_{1}}\left[\mathrm{e}^{r(\bm{x})/\alpha}\right]" display="inline" intent=":literal"><semantics><mrow><mrow><mrow><msubsup><mi>ℙ</mi><mi>t</mi><mo>⋆</mo></msubsup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>𝒙</mi><mo stretchy="false">)</mo></mrow></mrow><mo>=</mo><mrow><mstyle displaystyle="true"><mfrac><mn>1</mn><mi>Z</mi></mfrac></mstyle><mo lspace="0em" rspace="0em">​</mo><msubsup><mi>ℙ</mi><mi>t</mi><mn>0</mn></msubsup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>𝒙</mi><mo stretchy="false">)</mo></mrow><mo lspace="0em" rspace="0em">​</mo><msup><mi>e</mi><mrow><msub><mi>V</mi><mi>t</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>𝒙</mi><mo stretchy="false">)</mo></mrow></mrow></msup></mrow></mrow><mo rspace="1.167em">,</mo><mrow><mi>Z</mi><mo>:=</mo><mrow><msub><mi>𝔼</mi><mrow><mi>𝒙</mi><mo>∼</mo><msubsup><mi>ℙ</mi><mn>1</mn><mn>0</mn></msubsup></mrow></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo>[</mo><msup><mi>e</mi><mrow><mrow><mi>r</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>𝒙</mi><mo stretchy="false">)</mo></mrow></mrow><mo>/</mo><mi>α</mi></mrow></msup><mo>]</mo></mrow></mrow></mrow></mrow><annotation encoding="application/x-tex">\displaystyle\mathbb{P}^{\star}_{t}(\bm{x})=\frac{1}{Z}\mathbb{P}^{0}_{t}(\bm{x})\mathrm{e}^{V_{t}(\bm{x})},\quad Z:=\mathbb{E}_{\bm{x}\sim\mathbb{P}^{0}_{1}}\left[\mathrm{e}^{r(\bm{x})/\alpha}\right]</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td>
<td rowspan="1" class="ltx_eqn_cell ltx_eqn_eqno ltx_align_middle ltx_align_right"><span class="ltx_tag ltx_tag_equation ltx_align_right">(102)</span></td></tr></tbody>
</table>
<p id="S9.Thmlemma3.p1.2" class="ltx_p"><span id="S9.Thmlemma3.p1.2.1" class="ltx_text ltx_font_italic">for continuous <math id="S9.Thmlemma3.p1.m3" class="ltx_Math" alttext="t\mapsto\bm{A}^{0}_{t}" display="inline" intent=":literal"><semantics><mrow><mi>t</mi><mo stretchy="false">↦</mo><msubsup><mi>𝐀</mi><mi>t</mi><mn>0</mn></msubsup></mrow><annotation encoding="application/x-tex">t\mapsto\bm{A}^{0}_{t}</annotation></semantics></math>.</span></p>
</div>
</div>
<div id="S9.SS8.p6" class="ltx_para ltx_noindent">
<p id="S9.SS8.p6.1" class="ltx_p"><span id="S9.SS8.p6.1.1" class="ltx_text ltx_font_italic">Proof.</span> We define <math id="S9.SS8.p6.m1" class="ltx_Math" alttext="h_{t}(\bm{x}):=\frac{1}{Z}\mathbb{P}^{0}_{t}(\bm{x})\mathrm{e}^{V_{t}(\bm{x})}" display="inline" intent=":literal"><semantics><mrow><mrow><msub><mi>h</mi><mi>t</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>𝒙</mi><mo stretchy="false">)</mo></mrow></mrow><mo>:=</mo><mrow><mfrac><mn>1</mn><mi>Z</mi></mfrac><mo lspace="0em" rspace="0em">​</mo><msubsup><mi>ℙ</mi><mi>t</mi><mn>0</mn></msubsup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>𝒙</mi><mo stretchy="false">)</mo></mrow><mo lspace="0em" rspace="0em">​</mo><msup><mi>e</mi><mrow><msub><mi>V</mi><mi>t</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>𝒙</mi><mo stretchy="false">)</mo></mrow></mrow></msup></mrow></mrow><annotation encoding="application/x-tex">h_{t}(\bm{x}):=\frac{1}{Z}\mathbb{P}^{0}_{t}(\bm{x})\mathrm{e}^{V_{t}(\bm{x})}</annotation></semantics></math>, which satisfies <math id="S9.SS8.p6.m2" class="ltx_Math" alttext="h_{1}=\mathbb{P}^{\star}_{1}" display="inline" intent=":literal"><semantics><mrow><msub><mi>h</mi><mn>1</mn></msub><mo>=</mo><msubsup><mi>ℙ</mi><mn>1</mn><mo>⋆</mo></msubsup></mrow><annotation encoding="application/x-tex">h_{1}=\mathbb{P}^{\star}_{1}</annotation></semantics></math> by definition. To show that <math id="S9.SS8.p6.m3" class="ltx_Math" alttext="\mathbb{P}^{\star}" display="inline" intent=":literal"><semantics><msup><mi>ℙ</mi><mo>⋆</mo></msup><annotation encoding="application/x-tex">\mathbb{P}^{\star}</annotation></semantics></math> is the path measure generated by <math id="S9.SS8.p6.m4" class="ltx_Math" alttext="\bm{A}^{\star}" display="inline" intent=":literal"><semantics><msup><mi>𝑨</mi><mo>⋆</mo></msup><annotation encoding="application/x-tex">\bm{A}^{\star}</annotation></semantics></math>, it suffices to show that <math id="S9.SS8.p6.m5" class="ltx_Math" alttext="h_{t}(\bm{x})" display="inline" intent=":literal"><semantics><mrow><msub><mi>h</mi><mi>t</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>𝒙</mi><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">h_{t}(\bm{x})</annotation></semantics></math> satisfies the Kolmogorov forward equation for <math id="S9.SS8.p6.m6" class="ltx_Math" alttext="\bm{A}^{\star}_{t}" display="inline" intent=":literal"><semantics><msubsup><mi>𝑨</mi><mi>t</mi><mo>⋆</mo></msubsup><annotation encoding="application/x-tex">\bm{A}^{\star}_{t}</annotation></semantics></math>. First, the Kolmogorov forward equation for the reference generator <math id="S9.SS8.p6.m7" class="ltx_Math" alttext="\bm{A}^{0}_{t}" display="inline" intent=":literal"><semantics><msubsup><mi>𝑨</mi><mi>t</mi><mn>0</mn></msubsup><annotation encoding="application/x-tex">\bm{A}^{0}_{t}</annotation></semantics></math> is given by:</p>
<table id="S9.EGx97" class="ltx_equationgroup ltx_eqn_align ltx_eqn_table">

<tbody id="S9.E103"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_align_right ltx_eqn_cell"><math id="S9.E103.m1" class="ltx_Math" alttext="\displaystyle\partial_{t}\mathbb{P}^{0}_{t}(\bm{x})=\sum_{y\neq x}\left(\bm{A}^{0}_{t}(\bm{y},\bm{x})\mathbb{P}^{0}_{t}(\bm{y})-\bm{A}^{0}_{t}(\bm{x},\bm{y})\mathbb{P}^{0}_{t}(\bm{x})\right)" display="inline" intent=":literal"><semantics><mrow><mrow><msub><mo>∂</mo><mi>t</mi></msub><mrow><msubsup><mi>ℙ</mi><mi>t</mi><mn>0</mn></msubsup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>𝒙</mi><mo stretchy="false">)</mo></mrow></mrow></mrow><mo>=</mo><mrow><mstyle displaystyle="true"><munder><mo movablelimits="false">∑</mo><mrow><mi>y</mi><mo>≠</mo><mi>x</mi></mrow></munder></mstyle><mrow><mo>(</mo><mrow><mrow><msubsup><mi>𝑨</mi><mi>t</mi><mn>0</mn></msubsup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>𝒚</mi><mo>,</mo><mi>𝒙</mi><mo stretchy="false">)</mo></mrow><mo lspace="0em" rspace="0em">​</mo><msubsup><mi>ℙ</mi><mi>t</mi><mn>0</mn></msubsup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>𝒚</mi><mo stretchy="false">)</mo></mrow></mrow><mo>−</mo><mrow><msubsup><mi>𝑨</mi><mi>t</mi><mn>0</mn></msubsup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>𝒙</mi><mo>,</mo><mi>𝒚</mi><mo stretchy="false">)</mo></mrow><mo lspace="0em" rspace="0em">​</mo><msubsup><mi>ℙ</mi><mi>t</mi><mn>0</mn></msubsup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>𝒙</mi><mo stretchy="false">)</mo></mrow></mrow></mrow><mo>)</mo></mrow></mrow></mrow><annotation encoding="application/x-tex">\displaystyle\partial_{t}\mathbb{P}^{0}_{t}(\bm{x})=\sum_{y\neq x}\left(\bm{A}^{0}_{t}(\bm{y},\bm{x})\mathbb{P}^{0}_{t}(\bm{y})-\bm{A}^{0}_{t}(\bm{x},\bm{y})\mathbb{P}^{0}_{t}(\bm{x})\right)</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td>
<td rowspan="1" class="ltx_eqn_cell ltx_eqn_eqno ltx_align_middle ltx_align_right"><span class="ltx_tag ltx_tag_equation ltx_align_right">(103)</span></td></tr></tbody>
</table>
<p id="S9.SS8.p6.2" class="ltx_p">Then, from Lemma <a href="#S9.Thmlemma2" title="Lemma 9.2 (Optimal Generator). ‣ 9.8 Adaptive Joint Decoding Loss ‣ 9 Theoretical Proofs ‣ A2D2: Fine-Tuning Any-Length Discrete Diffusion for Adaptive Decoding" class="ltx_ref"><span class="ltx_text ltx_ref_tag">9.2</span></a>, we have <math id="S9.SS8.p6.m8" class="ltx_Math" alttext="\bm{A}^{\star}_{t}(\bm{x},\bm{y})=\bm{A}^{0}_{t}(\bm{x},\bm{y})\mathrm{e}^{V_{t}(\bm{y})-V_{t}(\bm{x})}" display="inline" intent=":literal"><semantics><mrow><mrow><msubsup><mi>𝑨</mi><mi>t</mi><mo>⋆</mo></msubsup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>𝒙</mi><mo>,</mo><mi>𝒚</mi><mo stretchy="false">)</mo></mrow></mrow><mo>=</mo><mrow><msubsup><mi>𝑨</mi><mi>t</mi><mn>0</mn></msubsup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>𝒙</mi><mo>,</mo><mi>𝒚</mi><mo stretchy="false">)</mo></mrow><mo lspace="0em" rspace="0em">​</mo><msup><mi>e</mi><mrow><mrow><msub><mi>V</mi><mi>t</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>𝒚</mi><mo stretchy="false">)</mo></mrow></mrow><mo>−</mo><mrow><msub><mi>V</mi><mi>t</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>𝒙</mi><mo stretchy="false">)</mo></mrow></mrow></mrow></msup></mrow></mrow><annotation encoding="application/x-tex">\bm{A}^{\star}_{t}(\bm{x},\bm{y})=\bm{A}^{0}_{t}(\bm{x},\bm{y})\mathrm{e}^{V_{t}(\bm{y})-V_{t}(\bm{x})}</annotation></semantics></math> which can be substituted into (<a href="#S9.E97" title="Equation 97 ‣ 9.8 Adaptive Joint Decoding Loss ‣ 9 Theoretical Proofs ‣ A2D2: Fine-Tuning Any-Length Discrete Diffusion for Adaptive Decoding" class="ltx_ref"><span class="ltx_text ltx_ref_tag">97</span></a>) to get:</p>
<table id="S9.EGx98" class="ltx_equationgroup ltx_eqn_align ltx_eqn_table">

<tbody id="S9.E104"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_align_right ltx_eqn_cell"><math id="S9.E104.m1" class="ltx_Math" alttext="\displaystyle\partial_{t}V_{t}(\bm{x})" display="inline" intent=":literal"><semantics><mrow><msub><mo>∂</mo><mi>t</mi></msub><mrow><msub><mi>V</mi><mi>t</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>𝒙</mi><mo stretchy="false">)</mo></mrow></mrow></mrow><annotation encoding="application/x-tex">\displaystyle\partial_{t}V_{t}(\bm{x})</annotation></semantics></math></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="S9.E104.m2" class="ltx_Math" alttext="\displaystyle=\sum_{y\neq x}\bm{A}^{0}_{t}(\bm{x},\bm{y})\left(\mathrm{e}^{V_{t}(\bm{x})}-\mathrm{e}^{V_{t}(\bm{y})}\right)" display="inline" intent=":literal"><semantics><mrow><mphantom></mphantom><mo>=</mo><mrow><mstyle displaystyle="true"><munder><mo movablelimits="false">∑</mo><mrow><mi>y</mi><mo>≠</mo><mi>x</mi></mrow></munder></mstyle><mrow><msubsup><mi>𝑨</mi><mi>t</mi><mn>0</mn></msubsup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>𝒙</mi><mo>,</mo><mi>𝒚</mi><mo stretchy="false">)</mo></mrow><mo lspace="0em" rspace="0em">​</mo><mrow><mo>(</mo><mrow><msup><mi>e</mi><mrow><msub><mi>V</mi><mi>t</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>𝒙</mi><mo stretchy="false">)</mo></mrow></mrow></msup><mo>−</mo><msup><mi>e</mi><mrow><msub><mi>V</mi><mi>t</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>𝒚</mi><mo stretchy="false">)</mo></mrow></mrow></msup></mrow><mo>)</mo></mrow></mrow></mrow></mrow><annotation encoding="application/x-tex">\displaystyle=\sum_{y\neq x}\bm{A}^{0}_{t}(\bm{x},\bm{y})\left(\mathrm{e}^{V_{t}(\bm{x})}-\mathrm{e}^{V_{t}(\bm{y})}\right)</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td>
<td rowspan="1" class="ltx_eqn_cell ltx_eqn_eqno ltx_align_middle ltx_align_right"><span class="ltx_tag ltx_tag_equation ltx_align_right">(104)</span></td></tr></tbody>
</table>
<p id="S9.SS8.p6.3" class="ltx_p">Taking the partial derivative of <math id="S9.SS8.p6.m9" class="ltx_Math" alttext="h_{t}(\bm{x})" display="inline" intent=":literal"><semantics><mrow><msub><mi>h</mi><mi>t</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>𝒙</mi><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">h_{t}(\bm{x})</annotation></semantics></math> and substituting (<a href="#S9.E104" title="Equation 104 ‣ 9.8 Adaptive Joint Decoding Loss ‣ 9 Theoretical Proofs ‣ A2D2: Fine-Tuning Any-Length Discrete Diffusion for Adaptive Decoding" class="ltx_ref"><span class="ltx_text ltx_ref_tag">104</span></a>), we get:</p>
<table id="S9.EGx99" class="ltx_equationgroup ltx_eqn_align ltx_eqn_table">

<tbody id="S9.Ex46"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_eqn_cell"></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="S9.Ex46.m1" class="ltx_Math" alttext="\displaystyle\partial_{t}h_{t}(\bm{x})=\frac{1}{Z}\left[\partial_{t}\mathbb{P}^{0}_{t}(\bm{x})\mathrm{e}^{V_{t}(\bm{x})}+\mathbb{P}^{0}_{t}\partial_{t}\mathrm{e}^{V_{t}(\bm{x})}\right]" display="inline" intent=":literal"><semantics><mrow><mrow><msub><mo>∂</mo><mi>t</mi></msub><mrow><msub><mi>h</mi><mi>t</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>𝒙</mi><mo stretchy="false">)</mo></mrow></mrow></mrow><mo>=</mo><mrow><mstyle displaystyle="true"><mfrac><mn>1</mn><mi>Z</mi></mfrac></mstyle><mo lspace="0em" rspace="0em">​</mo><mrow><mo>[</mo><mrow><mrow><msub><mo lspace="0em">∂</mo><mi>t</mi></msub><mrow><msubsup><mi>ℙ</mi><mi>t</mi><mn>0</mn></msubsup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>𝒙</mi><mo stretchy="false">)</mo></mrow><mo lspace="0em" rspace="0em">​</mo><msup><mi>e</mi><mrow><msub><mi>V</mi><mi>t</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>𝒙</mi><mo stretchy="false">)</mo></mrow></mrow></msup></mrow></mrow><mo>+</mo><mrow><msubsup><mi>ℙ</mi><mi>t</mi><mn>0</mn></msubsup><mo lspace="0em" rspace="0em">​</mo><mrow><msub><mo>∂</mo><mi>t</mi></msub><msup><mi>e</mi><mrow><msub><mi>V</mi><mi>t</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>𝒙</mi><mo stretchy="false">)</mo></mrow></mrow></msup></mrow></mrow></mrow><mo>]</mo></mrow></mrow></mrow><annotation encoding="application/x-tex">\displaystyle\partial_{t}h_{t}(\bm{x})=\frac{1}{Z}\left[\partial_{t}\mathbb{P}^{0}_{t}(\bm{x})\mathrm{e}^{V_{t}(\bm{x})}+\mathbb{P}^{0}_{t}\partial_{t}\mathrm{e}^{V_{t}(\bm{x})}\right]</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
<tbody id="S9.Ex47"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_eqn_cell"></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="S9.Ex47.m1" class="ltx_Math" alttext="\displaystyle=\frac{1}{Z}\left[\mathrm{e}^{V_{t}(\bm{x})}\sum_{y\neq x}\left(\bm{A}^{0}_{t}(\bm{y},\bm{x})\mathbb{P}^{0}_{t}(y)-\bm{A}^{0}_{t}(\bm{x},y)\mathbb{P}^{0}_{t}(\bm{x})\right)+\mathbb{P}^{0}_{t}(\bm{x})\sum_{y\neq x}\bm{A}^{0}_{t}(\bm{x},\bm{y})\left(\mathrm{e}^{V_{t}(\bm{x})}-\mathrm{e}^{V_{t}(\bm{y})}\right)\right]" display="inline" intent=":literal"><semantics><mrow><mphantom></mphantom><mo>=</mo><mrow><mstyle displaystyle="true"><mfrac><mn>1</mn><mi>Z</mi></mfrac></mstyle><mo lspace="0em" rspace="0em">​</mo><mrow><mo>[</mo><mrow><mrow><msup><mi>e</mi><mrow><msub><mi>V</mi><mi>t</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>𝒙</mi><mo stretchy="false">)</mo></mrow></mrow></msup><mo lspace="0em" rspace="0em">​</mo><mrow><mstyle displaystyle="true"><munder><mo movablelimits="false">∑</mo><mrow><mi>y</mi><mo>≠</mo><mi>x</mi></mrow></munder></mstyle><mrow><mo>(</mo><mrow><mrow><msubsup><mi>𝑨</mi><mi>t</mi><mn>0</mn></msubsup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>𝒚</mi><mo>,</mo><mi>𝒙</mi><mo stretchy="false">)</mo></mrow><mo lspace="0em" rspace="0em">​</mo><msubsup><mi>ℙ</mi><mi>t</mi><mn>0</mn></msubsup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>y</mi><mo stretchy="false">)</mo></mrow></mrow><mo>−</mo><mrow><msubsup><mi>𝑨</mi><mi>t</mi><mn>0</mn></msubsup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>𝒙</mi><mo>,</mo><mi>y</mi><mo stretchy="false">)</mo></mrow><mo lspace="0em" rspace="0em">​</mo><msubsup><mi>ℙ</mi><mi>t</mi><mn>0</mn></msubsup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>𝒙</mi><mo stretchy="false">)</mo></mrow></mrow></mrow><mo>)</mo></mrow></mrow></mrow><mo>+</mo><mrow><msubsup><mi>ℙ</mi><mi>t</mi><mn>0</mn></msubsup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>𝒙</mi><mo stretchy="false">)</mo></mrow><mo lspace="0em" rspace="0em">​</mo><mrow><mstyle displaystyle="true"><munder><mo movablelimits="false">∑</mo><mrow><mi>y</mi><mo>≠</mo><mi>x</mi></mrow></munder></mstyle><mrow><msubsup><mi>𝑨</mi><mi>t</mi><mn>0</mn></msubsup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>𝒙</mi><mo>,</mo><mi>𝒚</mi><mo stretchy="false">)</mo></mrow><mo lspace="0em" rspace="0em">​</mo><mrow><mo>(</mo><mrow><msup><mi>e</mi><mrow><msub><mi>V</mi><mi>t</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>𝒙</mi><mo stretchy="false">)</mo></mrow></mrow></msup><mo>−</mo><msup><mi>e</mi><mrow><msub><mi>V</mi><mi>t</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>𝒚</mi><mo stretchy="false">)</mo></mrow></mrow></msup></mrow><mo>)</mo></mrow></mrow></mrow></mrow></mrow><mo>]</mo></mrow></mrow></mrow><annotation encoding="application/x-tex">\displaystyle=\frac{1}{Z}\left[\mathrm{e}^{V_{t}(\bm{x})}\sum_{y\neq x}\left(\bm{A}^{0}_{t}(\bm{y},\bm{x})\mathbb{P}^{0}_{t}(y)-\bm{A}^{0}_{t}(\bm{x},y)\mathbb{P}^{0}_{t}(\bm{x})\right)+\mathbb{P}^{0}_{t}(\bm{x})\sum_{y\neq x}\bm{A}^{0}_{t}(\bm{x},\bm{y})\left(\mathrm{e}^{V_{t}(\bm{x})}-\mathrm{e}^{V_{t}(\bm{y})}\right)\right]</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
<tbody id="S9.Ex48"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_eqn_cell"></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="S9.Ex48.m1" class="ltx_Math" alttext="\displaystyle=\sum_{y\neq x}\left(\bm{A}^{0}_{t}(\bm{y},\bm{x})\frac{1}{Z}\mathbb{P}^{0}_{t}(\bm{y})\mathrm{e}^{V_{t}(\bm{x})}-\bm{A}^{0}_{t}(\bm{x},\bm{y})\frac{1}{Z}\mathbb{P}^{0}_{t}(\bm{x})\mathrm{e}^{V_{t}(\bm{y})}\right)" display="inline" intent=":literal"><semantics><mrow><mphantom></mphantom><mo>=</mo><mrow><mstyle displaystyle="true"><munder><mo movablelimits="false">∑</mo><mrow><mi>y</mi><mo>≠</mo><mi>x</mi></mrow></munder></mstyle><mrow><mo>(</mo><mrow><mrow><msubsup><mi>𝑨</mi><mi>t</mi><mn>0</mn></msubsup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>𝒚</mi><mo>,</mo><mi>𝒙</mi><mo stretchy="false">)</mo></mrow><mo lspace="0em" rspace="0em">​</mo><mstyle displaystyle="true"><mfrac><mn>1</mn><mi>Z</mi></mfrac></mstyle><mo lspace="0em" rspace="0em">​</mo><msubsup><mi>ℙ</mi><mi>t</mi><mn>0</mn></msubsup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>𝒚</mi><mo stretchy="false">)</mo></mrow><mo lspace="0em" rspace="0em">​</mo><msup><mi>e</mi><mrow><msub><mi>V</mi><mi>t</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>𝒙</mi><mo stretchy="false">)</mo></mrow></mrow></msup></mrow><mo>−</mo><mrow><msubsup><mi>𝑨</mi><mi>t</mi><mn>0</mn></msubsup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>𝒙</mi><mo>,</mo><mi>𝒚</mi><mo stretchy="false">)</mo></mrow><mo lspace="0em" rspace="0em">​</mo><mstyle displaystyle="true"><mfrac><mn>1</mn><mi>Z</mi></mfrac></mstyle><mo lspace="0em" rspace="0em">​</mo><msubsup><mi>ℙ</mi><mi>t</mi><mn>0</mn></msubsup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>𝒙</mi><mo stretchy="false">)</mo></mrow><mo lspace="0em" rspace="0em">​</mo><msup><mi>e</mi><mrow><msub><mi>V</mi><mi>t</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>𝒚</mi><mo stretchy="false">)</mo></mrow></mrow></msup></mrow></mrow><mo>)</mo></mrow></mrow></mrow><annotation encoding="application/x-tex">\displaystyle=\sum_{y\neq x}\left(\bm{A}^{0}_{t}(\bm{y},\bm{x})\frac{1}{Z}\mathbb{P}^{0}_{t}(\bm{y})\mathrm{e}^{V_{t}(\bm{x})}-\bm{A}^{0}_{t}(\bm{x},\bm{y})\frac{1}{Z}\mathbb{P}^{0}_{t}(\bm{x})\mathrm{e}^{V_{t}(\bm{y})}\right)</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
<tbody id="S9.Ex49"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_eqn_cell"></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="S9.Ex49.m1" class="ltx_Math" alttext="\displaystyle=\sum_{y\neq x}\left(\bm{A}^{0}_{t}(\bm{y},\bm{x})\mathrm{e}^{V_{t}(\bm{x})-V_{t}(\bm{y})}h_{t}(\bm{y})-\bm{A}^{0}_{t}(\bm{x},\bm{y})\mathrm{e}^{V_{t}(\bm{x})-V_{t}(\bm{y})}h_{t}(\bm{x})\right)" display="inline" intent=":literal"><semantics><mrow><mphantom></mphantom><mo>=</mo><mrow><mstyle displaystyle="true"><munder><mo movablelimits="false">∑</mo><mrow><mi>y</mi><mo>≠</mo><mi>x</mi></mrow></munder></mstyle><mrow><mo>(</mo><mrow><mrow><msubsup><mi>𝑨</mi><mi>t</mi><mn>0</mn></msubsup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>𝒚</mi><mo>,</mo><mi>𝒙</mi><mo stretchy="false">)</mo></mrow><mo lspace="0em" rspace="0em">​</mo><msup><mi>e</mi><mrow><mrow><msub><mi>V</mi><mi>t</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>𝒙</mi><mo stretchy="false">)</mo></mrow></mrow><mo>−</mo><mrow><msub><mi>V</mi><mi>t</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>𝒚</mi><mo stretchy="false">)</mo></mrow></mrow></mrow></msup><mo lspace="0em" rspace="0em">​</mo><msub><mi>h</mi><mi>t</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>𝒚</mi><mo stretchy="false">)</mo></mrow></mrow><mo>−</mo><mrow><msubsup><mi>𝑨</mi><mi>t</mi><mn>0</mn></msubsup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>𝒙</mi><mo>,</mo><mi>𝒚</mi><mo stretchy="false">)</mo></mrow><mo lspace="0em" rspace="0em">​</mo><msup><mi>e</mi><mrow><mrow><msub><mi>V</mi><mi>t</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>𝒙</mi><mo stretchy="false">)</mo></mrow></mrow><mo>−</mo><mrow><msub><mi>V</mi><mi>t</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>𝒚</mi><mo stretchy="false">)</mo></mrow></mrow></mrow></msup><mo lspace="0em" rspace="0em">​</mo><msub><mi>h</mi><mi>t</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>𝒙</mi><mo stretchy="false">)</mo></mrow></mrow></mrow><mo>)</mo></mrow></mrow></mrow><annotation encoding="application/x-tex">\displaystyle=\sum_{y\neq x}\left(\bm{A}^{0}_{t}(\bm{y},\bm{x})\mathrm{e}^{V_{t}(\bm{x})-V_{t}(\bm{y})}h_{t}(\bm{y})-\bm{A}^{0}_{t}(\bm{x},\bm{y})\mathrm{e}^{V_{t}(\bm{x})-V_{t}(\bm{y})}h_{t}(\bm{x})\right)</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
<tbody id="S9.Ex50"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_eqn_cell"></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="S9.Ex50.m1" class="ltx_Math" alttext="\displaystyle\overset{(\ref{eq:hjb})}{=}\sum_{y\neq x}\left(\bm{A}^{\star}_{t}(\bm{y},\bm{x})h_{t}(\bm{y})-\bm{A}^{\star}_{t}(\bm{x},\bm{y})h_{t}(\bm{x})\right)" display="inline" intent=":literal"><semantics><mrow><mover accent="true"><mo>=</mo><mrow><mo maxsize="0.700em" minsize="0.700em">(</mo><mtext class="ltx_mathvariant_italic" mathsize="0.700em"><a href="#S9.E104" title="Equation 104 ‣ 9.8 Adaptive Joint Decoding Loss ‣ 9 Theoretical Proofs ‣ A2D2: Fine-Tuning Any-Length Discrete Diffusion for Adaptive Decoding" class="ltx_ref ltx_font_italic" style="font-size:70%;"><span class="ltx_text ltx_ref_tag">104</span></a></mtext><mo maxsize="0.700em" minsize="0.700em">)</mo></mrow></mover><mo lspace="0em" rspace="0em">​</mo><mrow><mstyle displaystyle="true"><munder><mo movablelimits="false">∑</mo><mrow><mi>y</mi><mo>≠</mo><mi>x</mi></mrow></munder></mstyle><mrow><mo>(</mo><mrow><mrow><msubsup><mi>𝑨</mi><mi>t</mi><mo>⋆</mo></msubsup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>𝒚</mi><mo>,</mo><mi>𝒙</mi><mo stretchy="false">)</mo></mrow><mo lspace="0em" rspace="0em">​</mo><msub><mi>h</mi><mi>t</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>𝒚</mi><mo stretchy="false">)</mo></mrow></mrow><mo>−</mo><mrow><msubsup><mi>𝑨</mi><mi>t</mi><mo>⋆</mo></msubsup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>𝒙</mi><mo>,</mo><mi>𝒚</mi><mo stretchy="false">)</mo></mrow><mo lspace="0em" rspace="0em">​</mo><msub><mi>h</mi><mi>t</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>𝒙</mi><mo stretchy="false">)</mo></mrow></mrow></mrow><mo>)</mo></mrow></mrow></mrow><annotation encoding="application/x-tex">\displaystyle\overset{(\ref{eq:hjb})}{=}\sum_{y\neq x}\left(\bm{A}^{\star}_{t}(\bm{y},\bm{x})h_{t}(\bm{y})-\bm{A}^{\star}_{t}(\bm{x},\bm{y})h_{t}(\bm{x})\right)</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
</div>
<div id="S9.SS8.p7" class="ltx_para ltx_noindent">
<p id="S9.SS8.p7.1" class="ltx_p">The final equality is exactly the Kolmogorov forward equation of the optimal any-length generator <math id="S9.SS8.p7.m1" class="ltx_Math" alttext="\bm{A}^{\star}_{t}" display="inline" intent=":literal"><semantics><msubsup><mi>𝑨</mi><mi>t</mi><mo>⋆</mo></msubsup><annotation encoding="application/x-tex">\bm{A}^{\star}_{t}</annotation></semantics></math> for the tilted path measure <math id="S9.SS8.p7.m2" class="ltx_Math" alttext="\mathbb{P}^{\star}" display="inline" intent=":literal"><semantics><msup><mi>ℙ</mi><mo>⋆</mo></msup><annotation encoding="application/x-tex">\mathbb{P}^{\star}</annotation></semantics></math>. Since the Kolmogorov forward equation yields a unique solution for all <math id="S9.SS8.p7.m3" class="ltx_Math" alttext="t" display="inline" intent=":literal"><semantics><mi>t</mi><annotation encoding="application/x-tex">t</annotation></semantics></math>, we have shown that <math id="S9.SS8.p7.m4" class="ltx_Math" alttext="\mathbb{P}_{t}^{\star}=\frac{1}{Z}\mathbb{P}^{0}_{t}(\bm{x})\mathrm{e}^{V_{t}(\bm{x})}" display="inline" intent=":literal"><semantics><mrow><msubsup><mi>ℙ</mi><mi>t</mi><mo>⋆</mo></msubsup><mo>=</mo><mrow><mfrac><mn>1</mn><mi>Z</mi></mfrac><mo lspace="0em" rspace="0em">​</mo><msubsup><mi>ℙ</mi><mi>t</mi><mn>0</mn></msubsup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>𝒙</mi><mo stretchy="false">)</mo></mrow><mo lspace="0em" rspace="0em">​</mo><msup><mi>e</mi><mrow><msub><mi>V</mi><mi>t</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>𝒙</mi><mo stretchy="false">)</mo></mrow></mrow></msup></mrow></mrow><annotation encoding="application/x-tex">\mathbb{P}_{t}^{\star}=\frac{1}{Z}\mathbb{P}^{0}_{t}(\bm{x})\mathrm{e}^{V_{t}(\bm{x})}</annotation></semantics></math>.  <math id="S9.SS8.p7.m5" class="ltx_Math" alttext="\square" display="inline" intent=":literal"><semantics><mi mathvariant="normal">□</mi><annotation encoding="application/x-tex">\square</annotation></semantics></math></p>
</div>
<div id="S9.SS8.p8" class="ltx_para ltx_noindent">
<p id="S9.SS8.p8.1" class="ltx_p">Finally, we can derive the RND between the optimal any-length path measure <math id="S9.SS8.p8.m1" class="ltx_Math" alttext="\mathbb{P}^{\star}" display="inline" intent=":literal"><semantics><msup><mi>ℙ</mi><mo>⋆</mo></msup><annotation encoding="application/x-tex">\mathbb{P}^{\star}</annotation></semantics></math> with respect to the base measure <math id="S9.SS8.p8.m2" class="ltx_Math" alttext="\mathbb{P}^{0}" display="inline" intent=":literal"><semantics><msup><mi>ℙ</mi><mn>0</mn></msup><annotation encoding="application/x-tex">\mathbb{P}^{0}</annotation></semantics></math> in the following Lemma.</p>
</div>
<div id="S9.Thmlemma4" class="ltx_theorem ltx_theorem_lemma">
<h6 class="ltx_title ltx_runin ltx_title_theorem"><span class="ltx_tag ltx_tag_theorem"><span id="S9.Thmlemma4.2" class="ltx_text ltx_font_bold">Lemma 9.4</span></span><span id="S9.Thmlemma4.3" class="ltx_text ltx_font_bold"> </span>(Radon-Nikodym Derivative Between Optimal and Base Path Measures)<span id="S9.Thmlemma4.4" class="ltx_text ltx_font_bold">.</span></h6>
<div id="S9.Thmlemma4.p1" class="ltx_para">
<p id="S9.Thmlemma4.p1.1" class="ltx_p"><span id="S9.Thmlemma4.p1.1.1" class="ltx_text ltx_font_italic">The RND between the optimal path measure <math id="S9.Thmlemma4.p1.m1" class="ltx_Math" alttext="\mathbb{P}^{\star}" display="inline" intent=":literal"><semantics><msup><mi>ℙ</mi><mo>⋆</mo></msup><annotation encoding="application/x-tex">\mathbb{P}^{\star}</annotation></semantics></math> and its generator <math id="S9.Thmlemma4.p1.m2" class="ltx_Math" alttext="\bm{Q}^{\star}" display="inline" intent=":literal"><semantics><msup><mi>𝐐</mi><mo>⋆</mo></msup><annotation encoding="application/x-tex">\bm{Q}^{\star}</annotation></semantics></math> and the reference path measure <math id="S9.Thmlemma4.p1.m3" class="ltx_Math" alttext="\mathbb{P}^{0}" display="inline" intent=":literal"><semantics><msup><mi>ℙ</mi><mn>0</mn></msup><annotation encoding="application/x-tex">\mathbb{P}^{0}</annotation></semantics></math> and generator <math id="S9.Thmlemma4.p1.m4" class="ltx_Math" alttext="\bm{Q}^{0}" display="inline" intent=":literal"><semantics><msup><mi>𝐐</mi><mn>0</mn></msup><annotation encoding="application/x-tex">\bm{Q}^{0}</annotation></semantics></math> over any trajectory <math id="S9.Thmlemma4.p1.m5" class="ltx_math_unparsed" alttext="\bm{X}_{0:1}" display="inline" intent=":literal"><semantics><mrow><mi>𝐗</mi><msub><mrow></mrow><mrow><mn>0</mn><mo lspace="0.278em" rspace="0.278em">:</mo><mn>1</mn></mrow></msub></mrow><annotation encoding="application/x-tex">\bm{X}_{0:1}</annotation></semantics></math> can be expressed as:</span></p>
<table id="S9.EGx100" class="ltx_equationgroup ltx_eqn_align ltx_eqn_table">

<tbody id="S9.E105"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_align_right ltx_eqn_cell"><math id="S9.E105.m1" class="ltx_math_unparsed" alttext="\displaystyle\frac{\mathrm{d}\mathbb{P}^{\star}}{\mathrm{d}\mathbb{P}^{0}}(\bm{X}_{0:1})=\frac{1}{Z}e^{r(\bm{X}_{1})/\alpha},\quad\text{where}\quad Z:=\mathbb{E}_{\bm{X}_{1}\sim\mathbb{P}^{0}_{1}}[e^{r(\bm{X}_{1})/\alpha}]" display="inline" intent=":literal"><semantics><mrow><mstyle displaystyle="true"><mfrac><mrow><mi>d</mi><mo lspace="0em" rspace="0em">​</mo><msup><mi>ℙ</mi><mo>⋆</mo></msup></mrow><mrow><mi>d</mi><mo lspace="0em" rspace="0em">​</mo><msup><mi>ℙ</mi><mn>0</mn></msup></mrow></mfrac></mstyle><mrow><mo stretchy="false">(</mo><msub><mi>𝑿</mi><mrow><mn>0</mn><mo lspace="0.278em" rspace="0.278em">:</mo><mn>1</mn></mrow></msub><mo stretchy="false">)</mo></mrow><mo>=</mo><mstyle displaystyle="true"><mfrac><mn>1</mn><mi>Z</mi></mfrac></mstyle><msup><mi>e</mi><mrow><mrow><mi>r</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><msub><mi>𝑿</mi><mn>1</mn></msub><mo stretchy="false">)</mo></mrow></mrow><mo>/</mo><mi>α</mi></mrow></msup><mo rspace="1.167em">,</mo><mtext class="ltx_mathvariant_italic">where</mtext><mi>Z</mi><mo>:=</mo><msub><mi>𝔼</mi><mrow><msub><mi>𝑿</mi><mn>1</mn></msub><mo>∼</mo><msubsup><mi>ℙ</mi><mn>1</mn><mn>0</mn></msubsup></mrow></msub><mrow><mo stretchy="false">[</mo><msup><mi>e</mi><mrow><mrow><mi>r</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><msub><mi>𝑿</mi><mn>1</mn></msub><mo stretchy="false">)</mo></mrow></mrow><mo>/</mo><mi>α</mi></mrow></msup><mo stretchy="false">]</mo></mrow></mrow><annotation encoding="application/x-tex">\displaystyle\frac{\mathrm{d}\mathbb{P}^{\star}}{\mathrm{d}\mathbb{P}^{0}}(\bm{X}_{0:1})=\frac{1}{Z}e^{r(\bm{X}_{1})/\alpha},\quad\text{where}\quad Z:=\mathbb{E}_{\bm{X}_{1}\sim\mathbb{P}^{0}_{1}}[e^{r(\bm{X}_{1})/\alpha}]</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td>
<td rowspan="1" class="ltx_eqn_cell ltx_eqn_eqno ltx_align_middle ltx_align_right"><span class="ltx_tag ltx_tag_equation ltx_align_right">(105)</span></td></tr></tbody>
</table>
</div>
</div>
<div id="S9.SS8.p9" class="ltx_para ltx_noindent">
<p id="S9.SS8.p9.1" class="ltx_p"><span id="S9.SS8.p9.1.1" class="ltx_text ltx_font_italic">Proof.</span> From Prop <a href="#S9.Thmproposition3" title="Proposition 9.3 (Radon-Nikodym Derivative of Joint Any-Length CTMCs). ‣ 9.7 Radon-Nikodym Derivative Between Joint CTMCs ‣ 9 Theoretical Proofs ‣ A2D2: Fine-Tuning Any-Length Discrete Diffusion for Adaptive Decoding" class="ltx_ref"><span class="ltx_text ltx_ref_tag">9.3</span></a>, the RND between the path measures is defined as:
<span id="S9.SS8.p9.1.2" class="ltx_text"></span></p>
<table id="S9.EGx101" class="ltx_equationgroup ltx_eqn_align ltx_eqn_table">

<tbody id="S9.Ex51"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_align_right ltx_eqn_cell"><math id="S9.Ex51.m1" class="ltx_math_unparsed" alttext="\displaystyle\log\frac{\mathrm{d}\mathbb{P}^{\star}}{\mathrm{d}\mathbb{P}^{0}}(\bm{X}_{0:1})" display="inline" intent=":literal"><semantics><mrow><mi mathsize="0.900em">log</mi><mstyle displaystyle="true"><mfrac><mrow><mi mathsize="0.900em">d</mi><mo lspace="0em" rspace="0em">​</mo><msup><mi mathsize="0.900em">ℙ</mi><mo mathsize="0.900em">⋆</mo></msup></mrow><mrow><mi mathsize="0.900em">d</mi><mo lspace="0em" rspace="0em">​</mo><msup><mi mathsize="0.900em">ℙ</mi><mn mathsize="0.900em">0</mn></msup></mrow></mfrac></mstyle><mrow><mo maxsize="0.900em" minsize="0.900em">(</mo><msub><mi mathsize="0.900em">𝑿</mi><mrow><mn mathsize="0.900em">0</mn><mo lspace="0.278em" mathsize="0.900em" rspace="0.278em">:</mo><mn mathsize="0.900em">1</mn></mrow></msub><mo maxsize="0.900em" minsize="0.900em">)</mo></mrow></mrow><annotation encoding="application/x-tex">\displaystyle\log\frac{\mathrm{d}\mathbb{P}^{\star}}{\mathrm{d}\mathbb{P}^{0}}(\bm{X}_{0:1})</annotation></semantics></math></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="S9.Ex51.m2" class="ltx_math_unparsed" alttext="\displaystyle=\log\frac{\mathrm{d}\mathbb{P}_{0}^{\star}}{\mathrm{d}\mathbb{P}^{0}_{0}}(\bm{X}_{0})+\sum_{t:\bm{X}_{t}\neq\bm{X}_{t-}}\log\frac{\bm{A}^{\star}_{t}(\bm{X}_{t_{u}-},\bm{X}_{t})}{\bm{A}^{0}_{t}(\bm{X}_{t^{-}},\bm{X}_{t})}+\int_{0}^{1}\sum_{z\neq\bm{X}_{t}}(\bm{A}^{0}_{t}-\bm{A}^{\star}_{t})(\bm{X}_{t},z)dt" display="inline" intent=":literal"><semantics><mrow><mo mathsize="0.900em">=</mo><mi mathsize="0.900em">log</mi><mstyle displaystyle="true"><mfrac><mrow><mi mathsize="0.900em">d</mi><mo lspace="0em" rspace="0em">​</mo><msubsup><mi mathsize="0.900em">ℙ</mi><mn mathsize="0.900em">0</mn><mo mathsize="0.900em">⋆</mo></msubsup></mrow><mrow><mi mathsize="0.900em">d</mi><mo lspace="0em" rspace="0em">​</mo><msubsup><mi mathsize="0.900em">ℙ</mi><mn mathsize="0.900em">0</mn><mn mathsize="0.900em">0</mn></msubsup></mrow></mfrac></mstyle><mrow><mo maxsize="0.900em" minsize="0.900em">(</mo><msub><mi mathsize="0.900em">𝑿</mi><mn mathsize="0.900em">0</mn></msub><mo maxsize="0.900em" minsize="0.900em">)</mo></mrow><mo mathsize="0.900em">+</mo><mstyle displaystyle="true"><munder><mo maxsize="0.900em" minsize="0.900em" movablelimits="false" stretchy="true">∑</mo><mrow><mi mathsize="0.900em">t</mi><mo lspace="0.278em" mathsize="0.900em" rspace="0.278em">:</mo><mrow><msub><mi mathsize="0.900em">𝑿</mi><mi mathsize="0.900em">t</mi></msub><mo mathsize="0.900em">≠</mo><msub><mi mathsize="0.900em">𝑿</mi><mrow><mi mathsize="0.900em">t</mi><mo mathsize="0.900em">−</mo></mrow></msub></mrow></mrow></munder></mstyle><mi mathsize="0.900em">log</mi><mstyle displaystyle="true"><mfrac><mrow><msubsup><mi mathsize="0.900em">𝑨</mi><mi mathsize="0.900em">t</mi><mo mathsize="0.900em">⋆</mo></msubsup><mo lspace="0em" rspace="0em">​</mo><mrow><mo maxsize="0.900em" minsize="0.900em">(</mo><msub><mi mathsize="0.900em">𝑿</mi><mrow><msub><mi mathsize="0.900em">t</mi><mi mathsize="0.900em">u</mi></msub><mo mathsize="0.900em">−</mo></mrow></msub><mo mathsize="0.900em">,</mo><msub><mi mathsize="0.900em">𝑿</mi><mi mathsize="0.900em">t</mi></msub><mo maxsize="0.900em" minsize="0.900em">)</mo></mrow></mrow><mrow><msubsup><mi mathsize="0.900em">𝑨</mi><mi mathsize="0.900em">t</mi><mn mathsize="0.900em">0</mn></msubsup><mo lspace="0em" rspace="0em">​</mo><mrow><mo maxsize="0.900em" minsize="0.900em">(</mo><msub><mi mathsize="0.900em">𝑿</mi><msup><mi mathsize="0.900em">t</mi><mo mathsize="0.900em">−</mo></msup></msub><mo mathsize="0.900em">,</mo><msub><mi mathsize="0.900em">𝑿</mi><mi mathsize="0.900em">t</mi></msub><mo maxsize="0.900em" minsize="0.900em">)</mo></mrow></mrow></mfrac></mstyle><mo mathsize="0.900em">+</mo><mstyle displaystyle="true"><msubsup><mo maxsize="0.900em" minsize="0.900em" stretchy="true">∫</mo><mn mathsize="0.900em">0</mn><mn mathsize="0.900em">1</mn></msubsup></mstyle><mstyle displaystyle="true"><munder><mo maxsize="0.900em" minsize="0.900em" movablelimits="false" stretchy="true">∑</mo><mrow><mi mathsize="0.900em">z</mi><mo mathsize="0.900em">≠</mo><msub><mi mathsize="0.900em">𝑿</mi><mi mathsize="0.900em">t</mi></msub></mrow></munder></mstyle><mrow><mo maxsize="0.900em" minsize="0.900em">(</mo><msubsup><mi mathsize="0.900em">𝑨</mi><mi mathsize="0.900em">t</mi><mn mathsize="0.900em">0</mn></msubsup><mo mathsize="0.900em">−</mo><msubsup><mi mathsize="0.900em">𝑨</mi><mi mathsize="0.900em">t</mi><mo mathsize="0.900em">⋆</mo></msubsup><mo maxsize="0.900em" minsize="0.900em">)</mo></mrow><mrow><mo maxsize="0.900em" minsize="0.900em">(</mo><msub><mi mathsize="0.900em">𝑿</mi><mi mathsize="0.900em">t</mi></msub><mo mathsize="0.900em">,</mo><mi mathsize="0.900em">z</mi><mo maxsize="0.900em" minsize="0.900em">)</mo></mrow><mi mathsize="0.900em">d</mi><mi mathsize="0.900em">t</mi></mrow><annotation encoding="application/x-tex">\displaystyle=\log\frac{\mathrm{d}\mathbb{P}_{0}^{\star}}{\mathrm{d}\mathbb{P}^{0}_{0}}(\bm{X}_{0})+\sum_{t:\bm{X}_{t}\neq\bm{X}_{t-}}\log\frac{\bm{A}^{\star}_{t}(\bm{X}_{t_{u}-},\bm{X}_{t})}{\bm{A}^{0}_{t}(\bm{X}_{t^{-}},\bm{X}_{t})}+\int_{0}^{1}\sum_{z\neq\bm{X}_{t}}(\bm{A}^{0}_{t}-\bm{A}^{\star}_{t})(\bm{X}_{t},z)dt</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="S9.SS8.p9.2" class="ltx_p">Then, applying Lemmas <a href="#S9.Thmlemma2" title="Lemma 9.2 (Optimal Generator). ‣ 9.8 Adaptive Joint Decoding Loss ‣ 9 Theoretical Proofs ‣ A2D2: Fine-Tuning Any-Length Discrete Diffusion for Adaptive Decoding" class="ltx_ref"><span class="ltx_text ltx_ref_tag">9.2</span></a> and <a href="#S9.Thmlemma3" title="Lemma 9.3 (Optimal Path Measure). ‣ 9.8 Adaptive Joint Decoding Loss ‣ 9 Theoretical Proofs ‣ A2D2: Fine-Tuning Any-Length Discrete Diffusion for Adaptive Decoding" class="ltx_ref"><span class="ltx_text ltx_ref_tag">9.3</span></a>, we get:
<span id="S9.SS8.p9.2.1" class="ltx_text"></span></p>
<table id="S9.EGx102" class="ltx_equationgroup ltx_eqn_align ltx_eqn_table">

<tbody id="S9.Ex52"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_align_right ltx_eqn_cell"><math id="S9.Ex52.m1" class="ltx_math_unparsed" alttext="\displaystyle\log\frac{\mathrm{d}\mathbb{P}^{\star}}{\mathrm{d}\mathbb{P}^{0}}(\bm{X}_{0:1})=" display="inline" intent=":literal"><semantics><mrow><mi mathsize="0.900em">log</mi><mstyle displaystyle="true"><mfrac><mrow><mi mathsize="0.900em">d</mi><mo lspace="0em" rspace="0em">​</mo><msup><mi mathsize="0.900em">ℙ</mi><mo mathsize="0.900em">⋆</mo></msup></mrow><mrow><mi mathsize="0.900em">d</mi><mo lspace="0em" rspace="0em">​</mo><msup><mi mathsize="0.900em">ℙ</mi><mn mathsize="0.900em">0</mn></msup></mrow></mfrac></mstyle><mrow><mo maxsize="0.900em" minsize="0.900em">(</mo><msub><mi mathsize="0.900em">𝑿</mi><mrow><mn mathsize="0.900em">0</mn><mo lspace="0.278em" mathsize="0.900em" rspace="0.278em">:</mo><mn mathsize="0.900em">1</mn></mrow></msub><mo maxsize="0.900em" minsize="0.900em">)</mo></mrow><mo mathsize="0.900em">=</mo></mrow><annotation encoding="application/x-tex">\displaystyle\log\frac{\mathrm{d}\mathbb{P}^{\star}}{\mathrm{d}\mathbb{P}^{0}}(\bm{X}_{0:1})=</annotation></semantics></math></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="S9.Ex52.m2" class="ltx_math_unparsed" alttext="\displaystyle V_{0}(\bm{X}_{0})-\log Z+\sum_{t:\bm{X}_{t}\neq\bm{X}_{t-}}(V_{t}(\bm{X}_{t})-V_{t}(\bm{X}_{t^{-}}))" display="inline" intent=":literal"><semantics><mrow><msub><mi mathsize="0.900em">V</mi><mn mathsize="0.900em">0</mn></msub><mrow><mo maxsize="0.900em" minsize="0.900em">(</mo><msub><mi mathsize="0.900em">𝑿</mi><mn mathsize="0.900em">0</mn></msub><mo maxsize="0.900em" minsize="0.900em">)</mo></mrow><mo mathsize="0.900em">−</mo><mi mathsize="0.900em">log</mi><mi mathsize="0.900em">Z</mi><mo mathsize="0.900em">+</mo><mstyle displaystyle="true"><munder><mo maxsize="0.900em" minsize="0.900em" movablelimits="false" stretchy="true">∑</mo><mrow><mi mathsize="0.900em">t</mi><mo lspace="0.278em" mathsize="0.900em" rspace="0.278em">:</mo><mrow><msub><mi mathsize="0.900em">𝑿</mi><mi mathsize="0.900em">t</mi></msub><mo mathsize="0.900em">≠</mo><msub><mi mathsize="0.900em">𝑿</mi><mrow><mi mathsize="0.900em">t</mi><mo mathsize="0.900em">−</mo></mrow></msub></mrow></mrow></munder></mstyle><mrow><mo maxsize="0.900em" minsize="0.900em">(</mo><msub><mi mathsize="0.900em">V</mi><mi mathsize="0.900em">t</mi></msub><mrow><mo maxsize="0.900em" minsize="0.900em">(</mo><msub><mi mathsize="0.900em">𝑿</mi><mi mathsize="0.900em">t</mi></msub><mo maxsize="0.900em" minsize="0.900em">)</mo></mrow><mo mathsize="0.900em">−</mo><msub><mi mathsize="0.900em">V</mi><mi mathsize="0.900em">t</mi></msub><mrow><mo maxsize="0.900em" minsize="0.900em">(</mo><msub><mi mathsize="0.900em">𝑿</mi><msup><mi mathsize="0.900em">t</mi><mo mathsize="0.900em">−</mo></msup></msub><mo maxsize="0.900em" minsize="0.900em">)</mo></mrow><mo maxsize="0.900em" minsize="0.900em">)</mo></mrow></mrow><annotation encoding="application/x-tex">\displaystyle V_{0}(\bm{X}_{0})-\log Z+\sum_{t:\bm{X}_{t}\neq\bm{X}_{t-}}(V_{t}(\bm{X}_{t})-V_{t}(\bm{X}_{t^{-}}))</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
<tbody id="S9.E106"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_eqn_cell"></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="S9.E106.m1" class="ltx_math_unparsed" alttext="\displaystyle+\int_{0}^{1}\sum_{y\neq\bm{X}_{t}}\bm{A}_{t}^{0}(\bm{X}_{t},y)\left(1-\mathrm{e}^{V_{t}(\bm{y})-V_{t}(\bm{X}_{t})}\right)dt" display="inline" intent=":literal"><semantics><mrow><mo mathsize="0.900em">+</mo><mstyle displaystyle="true"><msubsup><mo maxsize="0.900em" minsize="0.900em" stretchy="true">∫</mo><mn mathsize="0.900em">0</mn><mn mathsize="0.900em">1</mn></msubsup></mstyle><mstyle displaystyle="true"><munder><mo maxsize="0.900em" minsize="0.900em" movablelimits="false" stretchy="true">∑</mo><mrow><mi mathsize="0.900em">y</mi><mo mathsize="0.900em">≠</mo><msub><mi mathsize="0.900em">𝑿</mi><mi mathsize="0.900em">t</mi></msub></mrow></munder></mstyle><msubsup><mi mathsize="0.900em">𝑨</mi><mi mathsize="0.900em">t</mi><mn mathsize="0.900em">0</mn></msubsup><mrow><mo maxsize="0.900em" minsize="0.900em">(</mo><msub><mi mathsize="0.900em">𝑿</mi><mi mathsize="0.900em">t</mi></msub><mo mathsize="0.900em">,</mo><mi mathsize="0.900em">y</mi><mo maxsize="0.900em" minsize="0.900em">)</mo></mrow><mrow><mo>(</mo><mn mathsize="0.900em">1</mn><mo mathsize="0.900em">−</mo><msup><mi mathsize="0.900em">e</mi><mrow><mrow><msub><mi mathsize="0.900em">V</mi><mi mathsize="0.900em">t</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo maxsize="0.900em" minsize="0.900em">(</mo><mi mathsize="0.900em">𝒚</mi><mo maxsize="0.900em" minsize="0.900em">)</mo></mrow></mrow><mo mathsize="0.900em">−</mo><mrow><msub><mi mathsize="0.900em">V</mi><mi mathsize="0.900em">t</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo maxsize="0.900em" minsize="0.900em">(</mo><msub><mi mathsize="0.900em">𝑿</mi><mi mathsize="0.900em">t</mi></msub><mo maxsize="0.900em" minsize="0.900em">)</mo></mrow></mrow></mrow></msup><mo>)</mo></mrow><mi mathsize="0.900em">d</mi><mi mathsize="0.900em">t</mi></mrow><annotation encoding="application/x-tex">\displaystyle+\int_{0}^{1}\sum_{y\neq\bm{X}_{t}}\bm{A}_{t}^{0}(\bm{X}_{t},y)\left(1-\mathrm{e}^{V_{t}(\bm{y})-V_{t}(\bm{X}_{t})}\right)dt</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td>
<td rowspan="1" class="ltx_eqn_cell ltx_eqn_eqno ltx_align_middle ltx_align_right"><span class="ltx_tag ltx_tag_equation ltx_align_right">(106)</span></td></tr></tbody>
</table>
<p id="S9.SS8.p9.3" class="ltx_p">Now, we derive an expression for <math id="S9.SS8.p9.m1" class="ltx_Math" alttext="V_{0}(\bm{X}_{0})" display="inline" intent=":literal"><semantics><mrow><msub><mi>V</mi><mn>0</mn></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mi>𝑿</mi><mn>0</mn></msub><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">V_{0}(\bm{X}_{0})</annotation></semantics></math> with respect to <math id="S9.SS8.p9.m2" class="ltx_Math" alttext="V_{1}(\bm{X}_{1})=r(\bm{X}_{1})" display="inline" intent=":literal"><semantics><mrow><mrow><msub><mi>V</mi><mn>1</mn></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mi>𝑿</mi><mn>1</mn></msub><mo stretchy="false">)</mo></mrow></mrow><mo>=</mo><mrow><mi>r</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><msub><mi>𝑿</mi><mn>1</mn></msub><mo stretchy="false">)</mo></mrow></mrow></mrow><annotation encoding="application/x-tex">V_{1}(\bm{X}_{1})=r(\bm{X}_{1})</annotation></semantics></math> by recognizing that the CTMC is a piecewise càdlàg function where each discrete step <math id="S9.SS8.p9.m3" class="ltx_Math" alttext="t_{k}\to t_{k+1}" display="inline" intent=":literal"><semantics><mrow><msub><mi>t</mi><mi>k</mi></msub><mo stretchy="false">→</mo><msub><mi>t</mi><mrow><mi>k</mi><mo>+</mo><mn>1</mn></mrow></msub></mrow><annotation encoding="application/x-tex">t_{k}\to t_{k+1}</annotation></semantics></math> can be categorized as a time evolution at a fixed state <math id="S9.SS8.p9.m4" class="ltx_Math" alttext="\bm{X}_{t_{k}}" display="inline" intent=":literal"><semantics><msub><mi>𝑿</mi><msub><mi>t</mi><mi>k</mi></msub></msub><annotation encoding="application/x-tex">\bm{X}_{t_{k}}</annotation></semantics></math> or a jump from state <math id="S9.SS8.p9.m5" class="ltx_Math" alttext="\bm{X}_{t_{k}}" display="inline" intent=":literal"><semantics><msub><mi>𝑿</mi><msub><mi>t</mi><mi>k</mi></msub></msub><annotation encoding="application/x-tex">\bm{X}_{t_{k}}</annotation></semantics></math> to <math id="S9.SS8.p9.m6" class="ltx_Math" alttext="\bm{X}_{t_{k}^{-}}\neq\bm{X}_{t_{k}}" display="inline" intent=":literal"><semantics><mrow><msub><mi>𝑿</mi><msubsup><mi>t</mi><mi>k</mi><mo>−</mo></msubsup></msub><mo>≠</mo><msub><mi>𝑿</mi><msub><mi>t</mi><mi>k</mi></msub></msub></mrow><annotation encoding="application/x-tex">\bm{X}_{t_{k}^{-}}\neq\bm{X}_{t_{k}}</annotation></semantics></math>. Given this, we decompose the value difference as:
<span id="S9.SS8.p9.3.1" class="ltx_text"></span></p>
<table id="S9.EGx103" class="ltx_equationgroup ltx_eqn_align ltx_eqn_table">

<tbody id="S9.Ex53"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_align_right ltx_eqn_cell"><math id="S9.Ex53.m1" class="ltx_Math" alttext="\displaystyle V_{1}(\bm{X}_{1})-V_{0}(\bm{X}_{0})" display="inline" intent=":literal"><semantics><mrow><mrow><msub><mi mathsize="0.900em">V</mi><mn mathsize="0.900em">1</mn></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo maxsize="0.900em" minsize="0.900em">(</mo><msub><mi mathsize="0.900em">𝑿</mi><mn mathsize="0.900em">1</mn></msub><mo maxsize="0.900em" minsize="0.900em">)</mo></mrow></mrow><mo mathsize="0.900em">−</mo><mrow><msub><mi mathsize="0.900em">V</mi><mn mathsize="0.900em">0</mn></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo maxsize="0.900em" minsize="0.900em">(</mo><msub><mi mathsize="0.900em">𝑿</mi><mn mathsize="0.900em">0</mn></msub><mo maxsize="0.900em" minsize="0.900em">)</mo></mrow></mrow></mrow><annotation encoding="application/x-tex">\displaystyle V_{1}(\bm{X}_{1})-V_{0}(\bm{X}_{0})</annotation></semantics></math></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="S9.Ex53.m2" class="ltx_Math" alttext="\displaystyle=\sum_{k=0}^{K-1}(V_{t_{k+1}}(\bm{X}_{t_{k}})-V_{t_{k}}(\bm{X}_{t_{k}}))+\sum_{k=1}^{K-1}(V_{t_{k}}(\bm{X}_{t_{k}})-V_{t_{k}}(\bm{X}_{t_{k-1}}))" display="inline" intent=":literal"><semantics><mrow><mphantom></mphantom><mo mathsize="0.900em">=</mo><mrow><mrow><mstyle displaystyle="true"><munderover><mo maxsize="0.900em" minsize="0.900em" movablelimits="false" stretchy="true">∑</mo><mrow><mi mathsize="0.900em">k</mi><mo mathsize="0.900em">=</mo><mn mathsize="0.900em">0</mn></mrow><mrow><mi mathsize="0.900em">K</mi><mo mathsize="0.900em">−</mo><mn mathsize="0.900em">1</mn></mrow></munderover></mstyle><mrow><mo maxsize="0.900em" minsize="0.900em">(</mo><mrow><mrow><msub><mi mathsize="0.900em">V</mi><msub><mi mathsize="0.900em">t</mi><mrow><mi mathsize="0.900em">k</mi><mo mathsize="0.900em">+</mo><mn mathsize="0.900em">1</mn></mrow></msub></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo maxsize="0.900em" minsize="0.900em">(</mo><msub><mi mathsize="0.900em">𝑿</mi><msub><mi mathsize="0.900em">t</mi><mi mathsize="0.900em">k</mi></msub></msub><mo maxsize="0.900em" minsize="0.900em">)</mo></mrow></mrow><mo mathsize="0.900em">−</mo><mrow><msub><mi mathsize="0.900em">V</mi><msub><mi mathsize="0.900em">t</mi><mi mathsize="0.900em">k</mi></msub></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo maxsize="0.900em" minsize="0.900em">(</mo><msub><mi mathsize="0.900em">𝑿</mi><msub><mi mathsize="0.900em">t</mi><mi mathsize="0.900em">k</mi></msub></msub><mo maxsize="0.900em" minsize="0.900em">)</mo></mrow></mrow></mrow><mo maxsize="0.900em" minsize="0.900em">)</mo></mrow></mrow><mo mathsize="0.900em">+</mo><mrow><mstyle displaystyle="true"><munderover><mo maxsize="0.900em" minsize="0.900em" movablelimits="false" stretchy="true">∑</mo><mrow><mi mathsize="0.900em">k</mi><mo mathsize="0.900em">=</mo><mn mathsize="0.900em">1</mn></mrow><mrow><mi mathsize="0.900em">K</mi><mo mathsize="0.900em">−</mo><mn mathsize="0.900em">1</mn></mrow></munderover></mstyle><mrow><mo maxsize="0.900em" minsize="0.900em">(</mo><mrow><mrow><msub><mi mathsize="0.900em">V</mi><msub><mi mathsize="0.900em">t</mi><mi mathsize="0.900em">k</mi></msub></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo maxsize="0.900em" minsize="0.900em">(</mo><msub><mi mathsize="0.900em">𝑿</mi><msub><mi mathsize="0.900em">t</mi><mi mathsize="0.900em">k</mi></msub></msub><mo maxsize="0.900em" minsize="0.900em">)</mo></mrow></mrow><mo mathsize="0.900em">−</mo><mrow><msub><mi mathsize="0.900em">V</mi><msub><mi mathsize="0.900em">t</mi><mi mathsize="0.900em">k</mi></msub></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo maxsize="0.900em" minsize="0.900em">(</mo><msub><mi mathsize="0.900em">𝑿</mi><msub><mi mathsize="0.900em">t</mi><mrow><mi mathsize="0.900em">k</mi><mo mathsize="0.900em">−</mo><mn mathsize="0.900em">1</mn></mrow></msub></msub><mo maxsize="0.900em" minsize="0.900em">)</mo></mrow></mrow></mrow><mo maxsize="0.900em" minsize="0.900em">)</mo></mrow></mrow></mrow></mrow><annotation encoding="application/x-tex">\displaystyle=\sum_{k=0}^{K-1}(V_{t_{k+1}}(\bm{X}_{t_{k}})-V_{t_{k}}(\bm{X}_{t_{k}}))+\sum_{k=1}^{K-1}(V_{t_{k}}(\bm{X}_{t_{k}})-V_{t_{k}}(\bm{X}_{t_{k-1}}))</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
<tbody id="S9.Ex54"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_eqn_cell"></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="S9.Ex54.m1" class="ltx_math_unparsed" alttext="\displaystyle=\sum_{k=0}^{K-1}\int_{t_{k}}^{t_{k+1}}\partial_{t}V_{t}(\bm{X}_{t_{k}})dt+\sum_{t:\bm{X}_{t}\neq\bm{X}_{t-}}(V_{t}(\bm{X}_{t})-V_{t}(\bm{X}_{t^{-}}))" display="inline" intent=":literal"><semantics><mrow><mo mathsize="0.900em">=</mo><mstyle displaystyle="true"><munderover><mo maxsize="0.900em" minsize="0.900em" movablelimits="false" stretchy="true">∑</mo><mrow><mi mathsize="0.900em">k</mi><mo mathsize="0.900em">=</mo><mn mathsize="0.900em">0</mn></mrow><mrow><mi mathsize="0.900em">K</mi><mo mathsize="0.900em">−</mo><mn mathsize="0.900em">1</mn></mrow></munderover></mstyle><mstyle displaystyle="true"><msubsup><mo maxsize="0.900em" minsize="0.900em" stretchy="true">∫</mo><msub><mi mathsize="0.900em">t</mi><mi mathsize="0.900em">k</mi></msub><msub><mi mathsize="0.900em">t</mi><mrow><mi mathsize="0.900em">k</mi><mo mathsize="0.900em">+</mo><mn mathsize="0.900em">1</mn></mrow></msub></msubsup></mstyle><msub><mo lspace="0em" mathsize="0.900em">∂</mo><mi mathsize="0.900em">t</mi></msub><msub><mi mathsize="0.900em">V</mi><mi mathsize="0.900em">t</mi></msub><mrow><mo maxsize="0.900em" minsize="0.900em">(</mo><msub><mi mathsize="0.900em">𝑿</mi><msub><mi mathsize="0.900em">t</mi><mi mathsize="0.900em">k</mi></msub></msub><mo maxsize="0.900em" minsize="0.900em">)</mo></mrow><mi mathsize="0.900em">d</mi><mi mathsize="0.900em">t</mi><mo mathsize="0.900em">+</mo><mstyle displaystyle="true"><munder><mo maxsize="0.900em" minsize="0.900em" movablelimits="false" stretchy="true">∑</mo><mrow><mi mathsize="0.900em">t</mi><mo lspace="0.278em" mathsize="0.900em" rspace="0.278em">:</mo><mrow><msub><mi mathsize="0.900em">𝑿</mi><mi mathsize="0.900em">t</mi></msub><mo mathsize="0.900em">≠</mo><msub><mi mathsize="0.900em">𝑿</mi><mrow><mi mathsize="0.900em">t</mi><mo mathsize="0.900em">−</mo></mrow></msub></mrow></mrow></munder></mstyle><mrow><mo maxsize="0.900em" minsize="0.900em">(</mo><msub><mi mathsize="0.900em">V</mi><mi mathsize="0.900em">t</mi></msub><mrow><mo maxsize="0.900em" minsize="0.900em">(</mo><msub><mi mathsize="0.900em">𝑿</mi><mi mathsize="0.900em">t</mi></msub><mo maxsize="0.900em" minsize="0.900em">)</mo></mrow><mo mathsize="0.900em">−</mo><msub><mi mathsize="0.900em">V</mi><mi mathsize="0.900em">t</mi></msub><mrow><mo maxsize="0.900em" minsize="0.900em">(</mo><msub><mi mathsize="0.900em">𝑿</mi><msup><mi mathsize="0.900em">t</mi><mo mathsize="0.900em">−</mo></msup></msub><mo maxsize="0.900em" minsize="0.900em">)</mo></mrow><mo maxsize="0.900em" minsize="0.900em">)</mo></mrow></mrow><annotation encoding="application/x-tex">\displaystyle=\sum_{k=0}^{K-1}\int_{t_{k}}^{t_{k+1}}\partial_{t}V_{t}(\bm{X}_{t_{k}})dt+\sum_{t:\bm{X}_{t}\neq\bm{X}_{t-}}(V_{t}(\bm{X}_{t})-V_{t}(\bm{X}_{t^{-}}))</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
<tbody id="S9.E107"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_eqn_cell"></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="S9.E107.m1" class="ltx_math_unparsed" alttext="\displaystyle=\int_{0}^{1}\partial_{t}V_{t}(\bm{X}_{t})dt+\sum_{t:\bm{X}_{t}\neq\bm{X}_{t-}}(V_{t}(\bm{X}_{t})-V_{t}(\bm{X}_{t^{-}}))" display="inline" intent=":literal"><semantics><mrow><mo mathsize="0.900em">=</mo><mstyle displaystyle="true"><msubsup><mo maxsize="0.900em" minsize="0.900em" stretchy="true">∫</mo><mn mathsize="0.900em">0</mn><mn mathsize="0.900em">1</mn></msubsup></mstyle><msub><mo lspace="0em" mathsize="0.900em">∂</mo><mi mathsize="0.900em">t</mi></msub><msub><mi mathsize="0.900em">V</mi><mi mathsize="0.900em">t</mi></msub><mrow><mo maxsize="0.900em" minsize="0.900em">(</mo><msub><mi mathsize="0.900em">𝑿</mi><mi mathsize="0.900em">t</mi></msub><mo maxsize="0.900em" minsize="0.900em">)</mo></mrow><mi mathsize="0.900em">d</mi><mi mathsize="0.900em">t</mi><mo mathsize="0.900em">+</mo><mstyle displaystyle="true"><munder><mo maxsize="0.900em" minsize="0.900em" movablelimits="false" stretchy="true">∑</mo><mrow><mi mathsize="0.900em">t</mi><mo lspace="0.278em" mathsize="0.900em" rspace="0.278em">:</mo><mrow><msub><mi mathsize="0.900em">𝑿</mi><mi mathsize="0.900em">t</mi></msub><mo mathsize="0.900em">≠</mo><msub><mi mathsize="0.900em">𝑿</mi><mrow><mi mathsize="0.900em">t</mi><mo mathsize="0.900em">−</mo></mrow></msub></mrow></mrow></munder></mstyle><mrow><mo maxsize="0.900em" minsize="0.900em">(</mo><msub><mi mathsize="0.900em">V</mi><mi mathsize="0.900em">t</mi></msub><mrow><mo maxsize="0.900em" minsize="0.900em">(</mo><msub><mi mathsize="0.900em">𝑿</mi><mi mathsize="0.900em">t</mi></msub><mo maxsize="0.900em" minsize="0.900em">)</mo></mrow><mo mathsize="0.900em">−</mo><msub><mi mathsize="0.900em">V</mi><mi mathsize="0.900em">t</mi></msub><mrow><mo maxsize="0.900em" minsize="0.900em">(</mo><msub><mi mathsize="0.900em">𝑿</mi><msup><mi mathsize="0.900em">t</mi><mo mathsize="0.900em">−</mo></msup></msub><mo maxsize="0.900em" minsize="0.900em">)</mo></mrow><mo maxsize="0.900em" minsize="0.900em">)</mo></mrow></mrow><annotation encoding="application/x-tex">\displaystyle=\int_{0}^{1}\partial_{t}V_{t}(\bm{X}_{t})dt+\sum_{t:\bm{X}_{t}\neq\bm{X}_{t-}}(V_{t}(\bm{X}_{t})-V_{t}(\bm{X}_{t^{-}}))</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td>
<td rowspan="1" class="ltx_eqn_cell ltx_eqn_eqno ltx_align_middle ltx_align_right"><span class="ltx_tag ltx_tag_equation ltx_align_right">(107)</span></td></tr></tbody>
<tbody id="S9.Ex55"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_align_right ltx_eqn_cell"><math id="S9.Ex55.m1" class="ltx_Math" alttext="\displaystyle V_{0}(\bm{X}_{0})=V_{1}(\bm{X}_{1})" display="inline" intent=":literal"><semantics><mrow><mrow><msub><mi mathsize="0.900em">V</mi><mn mathsize="0.900em">0</mn></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo maxsize="0.900em" minsize="0.900em">(</mo><msub><mi mathsize="0.900em">𝑿</mi><mn mathsize="0.900em">0</mn></msub><mo maxsize="0.900em" minsize="0.900em">)</mo></mrow></mrow><mo mathsize="0.900em">=</mo><mrow><msub><mi mathsize="0.900em">V</mi><mn mathsize="0.900em">1</mn></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo maxsize="0.900em" minsize="0.900em">(</mo><msub><mi mathsize="0.900em">𝑿</mi><mn mathsize="0.900em">1</mn></msub><mo maxsize="0.900em" minsize="0.900em">)</mo></mrow></mrow></mrow><annotation encoding="application/x-tex">\displaystyle V_{0}(\bm{X}_{0})=V_{1}(\bm{X}_{1})</annotation></semantics></math></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="S9.Ex55.m2" class="ltx_math_unparsed" alttext="\displaystyle-\int_{0}^{1}\partial_{t}V_{t}(\bm{X}_{t})dt-\sum_{t:\bm{X}_{t}\neq\bm{X}_{t-}}(V_{t}(\bm{X}_{t})-V_{t}(\bm{X}_{t^{-}}))" display="inline" intent=":literal"><semantics><mrow><mo mathsize="0.900em">−</mo><mstyle displaystyle="true"><msubsup><mo maxsize="0.900em" minsize="0.900em" stretchy="true">∫</mo><mn mathsize="0.900em">0</mn><mn mathsize="0.900em">1</mn></msubsup></mstyle><msub><mo lspace="0em" mathsize="0.900em">∂</mo><mi mathsize="0.900em">t</mi></msub><msub><mi mathsize="0.900em">V</mi><mi mathsize="0.900em">t</mi></msub><mrow><mo maxsize="0.900em" minsize="0.900em">(</mo><msub><mi mathsize="0.900em">𝑿</mi><mi mathsize="0.900em">t</mi></msub><mo maxsize="0.900em" minsize="0.900em">)</mo></mrow><mi mathsize="0.900em">d</mi><mi mathsize="0.900em">t</mi><mo mathsize="0.900em">−</mo><mstyle displaystyle="true"><munder><mo maxsize="0.900em" minsize="0.900em" movablelimits="false" stretchy="true">∑</mo><mrow><mi mathsize="0.900em">t</mi><mo lspace="0.278em" mathsize="0.900em" rspace="0.278em">:</mo><mrow><msub><mi mathsize="0.900em">𝑿</mi><mi mathsize="0.900em">t</mi></msub><mo mathsize="0.900em">≠</mo><msub><mi mathsize="0.900em">𝑿</mi><mrow><mi mathsize="0.900em">t</mi><mo mathsize="0.900em">−</mo></mrow></msub></mrow></mrow></munder></mstyle><mrow><mo maxsize="0.900em" minsize="0.900em">(</mo><msub><mi mathsize="0.900em">V</mi><mi mathsize="0.900em">t</mi></msub><mrow><mo maxsize="0.900em" minsize="0.900em">(</mo><msub><mi mathsize="0.900em">𝑿</mi><mi mathsize="0.900em">t</mi></msub><mo maxsize="0.900em" minsize="0.900em">)</mo></mrow><mo mathsize="0.900em">−</mo><msub><mi mathsize="0.900em">V</mi><mi mathsize="0.900em">t</mi></msub><mrow><mo maxsize="0.900em" minsize="0.900em">(</mo><msub><mi mathsize="0.900em">𝑿</mi><msup><mi mathsize="0.900em">t</mi><mo mathsize="0.900em">−</mo></msup></msub><mo maxsize="0.900em" minsize="0.900em">)</mo></mrow><mo maxsize="0.900em" minsize="0.900em">)</mo></mrow></mrow><annotation encoding="application/x-tex">\displaystyle-\int_{0}^{1}\partial_{t}V_{t}(\bm{X}_{t})dt-\sum_{t:\bm{X}_{t}\neq\bm{X}_{t-}}(V_{t}(\bm{X}_{t})-V_{t}(\bm{X}_{t^{-}}))</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
<tbody id="S9.E108"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_align_right ltx_eqn_cell"><math id="S9.E108.m1" class="ltx_Math" alttext="\displaystyle\overset{(\ref{lemma:optimal-generator})}{=}V_{1}(\bm{X}_{1})" display="inline" intent=":literal"><semantics><mrow><mover accent="true"><mo mathsize="0.900em">=</mo><mrow><mo maxsize="0.630em" minsize="0.630em">(</mo><mtext class="ltx_mathvariant_italic" mathsize="0.630em"><a href="#S9.Thmlemma2" title="Lemma 9.2 (Optimal Generator). ‣ 9.8 Adaptive Joint Decoding Loss ‣ 9 Theoretical Proofs ‣ A2D2: Fine-Tuning Any-Length Discrete Diffusion for Adaptive Decoding" class="ltx_ref ltx_font_italic" style="font-size:63%;"><span class="ltx_text ltx_ref_tag">9.2</span></a></mtext><mo maxsize="0.630em" minsize="0.630em">)</mo></mrow></mover><mo lspace="0em" rspace="0em">​</mo><msub><mi mathsize="0.900em">V</mi><mn mathsize="0.900em">1</mn></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo maxsize="0.900em" minsize="0.900em">(</mo><msub><mi mathsize="0.900em">𝑿</mi><mn mathsize="0.900em">1</mn></msub><mo maxsize="0.900em" minsize="0.900em">)</mo></mrow></mrow><annotation encoding="application/x-tex">\displaystyle\overset{(\ref{lemma:optimal-generator})}{=}V_{1}(\bm{X}_{1})</annotation></semantics></math></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="S9.E108.m2" class="ltx_math_unparsed" alttext="\displaystyle-\int_{0}^{1}\sum_{y\neq\bm{X}_{t}}\bm{A}^{0}_{t}(\bm{X}_{t},\bm{y})\left(1-\mathrm{e}^{V_{t}(\bm{y})-V_{t}(\bm{X}_{t})}\right)dt-\sum_{t:\bm{X}_{t}\neq\bm{X}_{t-}}(V_{t}(\bm{X}_{t})-V_{t}(\bm{X}_{t^{-}}))" display="inline" intent=":literal"><semantics><mrow><mo mathsize="0.900em">−</mo><mstyle displaystyle="true"><msubsup><mo maxsize="0.900em" minsize="0.900em" stretchy="true">∫</mo><mn mathsize="0.900em">0</mn><mn mathsize="0.900em">1</mn></msubsup></mstyle><mstyle displaystyle="true"><munder><mo maxsize="0.900em" minsize="0.900em" movablelimits="false" stretchy="true">∑</mo><mrow><mi mathsize="0.900em">y</mi><mo mathsize="0.900em">≠</mo><msub><mi mathsize="0.900em">𝑿</mi><mi mathsize="0.900em">t</mi></msub></mrow></munder></mstyle><msubsup><mi mathsize="0.900em">𝑨</mi><mi mathsize="0.900em">t</mi><mn mathsize="0.900em">0</mn></msubsup><mrow><mo maxsize="0.900em" minsize="0.900em">(</mo><msub><mi mathsize="0.900em">𝑿</mi><mi mathsize="0.900em">t</mi></msub><mo mathsize="0.900em">,</mo><mi mathsize="0.900em">𝒚</mi><mo maxsize="0.900em" minsize="0.900em">)</mo></mrow><mrow><mo>(</mo><mn mathsize="0.900em">1</mn><mo mathsize="0.900em">−</mo><msup><mi mathsize="0.900em">e</mi><mrow><mrow><msub><mi mathsize="0.900em">V</mi><mi mathsize="0.900em">t</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo maxsize="0.900em" minsize="0.900em">(</mo><mi mathsize="0.900em">𝒚</mi><mo maxsize="0.900em" minsize="0.900em">)</mo></mrow></mrow><mo mathsize="0.900em">−</mo><mrow><msub><mi mathsize="0.900em">V</mi><mi mathsize="0.900em">t</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo maxsize="0.900em" minsize="0.900em">(</mo><msub><mi mathsize="0.900em">𝑿</mi><mi mathsize="0.900em">t</mi></msub><mo maxsize="0.900em" minsize="0.900em">)</mo></mrow></mrow></mrow></msup><mo>)</mo></mrow><mi mathsize="0.900em">d</mi><mi mathsize="0.900em">t</mi><mo mathsize="0.900em">−</mo><mstyle displaystyle="true"><munder><mo maxsize="0.900em" minsize="0.900em" movablelimits="false" stretchy="true">∑</mo><mrow><mi mathsize="0.900em">t</mi><mo lspace="0.278em" mathsize="0.900em" rspace="0.278em">:</mo><mrow><msub><mi mathsize="0.900em">𝑿</mi><mi mathsize="0.900em">t</mi></msub><mo mathsize="0.900em">≠</mo><msub><mi mathsize="0.900em">𝑿</mi><mrow><mi mathsize="0.900em">t</mi><mo mathsize="0.900em">−</mo></mrow></msub></mrow></mrow></munder></mstyle><mrow><mo maxsize="0.900em" minsize="0.900em">(</mo><msub><mi mathsize="0.900em">V</mi><mi mathsize="0.900em">t</mi></msub><mrow><mo maxsize="0.900em" minsize="0.900em">(</mo><msub><mi mathsize="0.900em">𝑿</mi><mi mathsize="0.900em">t</mi></msub><mo maxsize="0.900em" minsize="0.900em">)</mo></mrow><mo mathsize="0.900em">−</mo><msub><mi mathsize="0.900em">V</mi><mi mathsize="0.900em">t</mi></msub><mrow><mo maxsize="0.900em" minsize="0.900em">(</mo><msub><mi mathsize="0.900em">𝑿</mi><msup><mi mathsize="0.900em">t</mi><mo mathsize="0.900em">−</mo></msup></msub><mo maxsize="0.900em" minsize="0.900em">)</mo></mrow><mo maxsize="0.900em" minsize="0.900em">)</mo></mrow></mrow><annotation encoding="application/x-tex">\displaystyle-\int_{0}^{1}\sum_{y\neq\bm{X}_{t}}\bm{A}^{0}_{t}(\bm{X}_{t},\bm{y})\left(1-\mathrm{e}^{V_{t}(\bm{y})-V_{t}(\bm{X}_{t})}\right)dt-\sum_{t:\bm{X}_{t}\neq\bm{X}_{t-}}(V_{t}(\bm{X}_{t})-V_{t}(\bm{X}_{t^{-}}))</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td>
<td rowspan="1" class="ltx_eqn_cell ltx_eqn_eqno ltx_align_middle ltx_align_right"><span class="ltx_tag ltx_tag_equation ltx_align_right">(108)</span></td></tr></tbody>
</table>
<p id="S9.SS8.p9.4" class="ltx_p">where the final equality follows from Lemma <a href="#S9.Thmlemma2" title="Lemma 9.2 (Optimal Generator). ‣ 9.8 Adaptive Joint Decoding Loss ‣ 9 Theoretical Proofs ‣ A2D2: Fine-Tuning Any-Length Discrete Diffusion for Adaptive Decoding" class="ltx_ref"><span class="ltx_text ltx_ref_tag">9.2</span></a>. Substituting this expression for <math id="S9.SS8.p9.m7" class="ltx_Math" alttext="V_{0}(\bm{X}_{0})" display="inline" intent=":literal"><semantics><mrow><msub><mi>V</mi><mn>0</mn></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mi>𝑿</mi><mn>0</mn></msub><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">V_{0}(\bm{X}_{0})</annotation></semantics></math> into (<a href="#S9.E106" title="Equation 106 ‣ 9.8 Adaptive Joint Decoding Loss ‣ 9 Theoretical Proofs ‣ A2D2: Fine-Tuning Any-Length Discrete Diffusion for Adaptive Decoding" class="ltx_ref"><span class="ltx_text ltx_ref_tag">106</span></a>), terms cancel and the RND reduces to:</p>
<table id="S9.EGx104" class="ltx_equationgroup ltx_eqn_align ltx_eqn_table">

<tbody id="S9.E109"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_align_right ltx_eqn_cell"><math id="S9.E109.m1" class="ltx_math_unparsed" alttext="\displaystyle\log\frac{\mathrm{d}\mathbb{P}^{\star}}{\mathrm{d}\mathbb{P}^{0}}(\bm{X}_{0:1})=V_{1}(\bm{X}_{1})-\log Z\implies\frac{\mathrm{d}\mathbb{P}^{\star}}{\mathrm{d}\mathbb{P}^{0}}(\bm{X}_{0:1})=\frac{1}{Z}\mathrm{e}^{V_{1}(\bm{X}_{1})}" display="inline" intent=":literal"><semantics><mrow><mi>log</mi><mstyle displaystyle="true"><mfrac><mrow><mi>d</mi><mo lspace="0em" rspace="0em">​</mo><msup><mi>ℙ</mi><mo>⋆</mo></msup></mrow><mrow><mi>d</mi><mo lspace="0em" rspace="0em">​</mo><msup><mi>ℙ</mi><mn>0</mn></msup></mrow></mfrac></mstyle><mrow><mo stretchy="false">(</mo><msub><mi>𝑿</mi><mrow><mn>0</mn><mo lspace="0.278em" rspace="0.278em">:</mo><mn>1</mn></mrow></msub><mo stretchy="false">)</mo></mrow><mo>=</mo><msub><mi>V</mi><mn>1</mn></msub><mrow><mo stretchy="false">(</mo><msub><mi>𝑿</mi><mn>1</mn></msub><mo stretchy="false">)</mo></mrow><mo>−</mo><mi>log</mi><mi>Z</mi><mo stretchy="false">⟹</mo><mstyle displaystyle="true"><mfrac><mrow><mi>d</mi><mo lspace="0em" rspace="0em">​</mo><msup><mi>ℙ</mi><mo>⋆</mo></msup></mrow><mrow><mi>d</mi><mo lspace="0em" rspace="0em">​</mo><msup><mi>ℙ</mi><mn>0</mn></msup></mrow></mfrac></mstyle><mrow><mo stretchy="false">(</mo><msub><mi>𝑿</mi><mrow><mn>0</mn><mo lspace="0.278em" rspace="0.278em">:</mo><mn>1</mn></mrow></msub><mo stretchy="false">)</mo></mrow><mo>=</mo><mstyle displaystyle="true"><mfrac><mn>1</mn><mi>Z</mi></mfrac></mstyle><msup><mi>e</mi><mrow><msub><mi>V</mi><mn>1</mn></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mi>𝑿</mi><mn>1</mn></msub><mo stretchy="false">)</mo></mrow></mrow></msup></mrow><annotation encoding="application/x-tex">\displaystyle\log\frac{\mathrm{d}\mathbb{P}^{\star}}{\mathrm{d}\mathbb{P}^{0}}(\bm{X}_{0:1})=V_{1}(\bm{X}_{1})-\log Z\implies\frac{\mathrm{d}\mathbb{P}^{\star}}{\mathrm{d}\mathbb{P}^{0}}(\bm{X}_{0:1})=\frac{1}{Z}\mathrm{e}^{V_{1}(\bm{X}_{1})}</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td>
<td rowspan="1" class="ltx_eqn_cell ltx_eqn_eqno ltx_align_middle ltx_align_right"><span class="ltx_tag ltx_tag_equation ltx_align_right">(109)</span></td></tr></tbody>
</table>
<p id="S9.SS8.p9.5" class="ltx_p">where <math id="S9.SS8.p9.m8" class="ltx_Math" alttext="V_{1}(\bm{X}_{1})=r(\bm{X}_{1})/\alpha" display="inline" intent=":literal"><semantics><mrow><mrow><msub><mi>V</mi><mn>1</mn></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mi>𝑿</mi><mn>1</mn></msub><mo stretchy="false">)</mo></mrow></mrow><mo>=</mo><mrow><mrow><mi>r</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><msub><mi>𝑿</mi><mn>1</mn></msub><mo stretchy="false">)</mo></mrow></mrow><mo>/</mo><mi>α</mi></mrow></mrow><annotation encoding="application/x-tex">V_{1}(\bm{X}_{1})=r(\bm{X}_{1})/\alpha</annotation></semantics></math>, we conclude our proof.  <math id="S9.SS8.p9.m9" class="ltx_Math" alttext="\square" display="inline" intent=":literal"><semantics><mi mathvariant="normal">□</mi><annotation encoding="application/x-tex">\square</annotation></semantics></math></p>
</div>
<div id="S9.SS8.p10" class="ltx_para ltx_noindent">
<p id="S9.SS8.p10.1" class="ltx_p">Finally, we are ready to derive the RND between the optimal path measure and the parameterized path measure.</p>
</div>
<div id="S9.SS8.p11" class="ltx_para ltx_noindent"><span class="ltx_inline-block"><svg id="S9.SS8.p11.pic1" class="ltx_picture" height="37.46" overflow="visible" version="1.1" viewBox="0 0 676.77 37.46" width="676.77"><g style="--ltx-stroke-color:#000000;--ltx-fill-color:#000000;" fill="#000000" stroke="#000000" stroke-width="0.4pt" transform="translate(0,37.46) matrix(1 0 0 -1 0 0)"><g style="--ltx-fill-color:#404040;" fill="#404040" fill-opacity="1.0"><path style="stroke:none" d="M 0 0 L 0 37.46 L 676.77 37.46 L 676.77 0 Z"></path></g><g style="--ltx-fill-color:#EAE9FF;" fill="#EAE9FF" fill-opacity="1.0"><path style="stroke:none" d="M 0 0 L 0 37.46 L 676.77 37.46 L 676.77 0 Z"></path></g><g fill-opacity="1.0" transform="matrix(1.0 0.0 0.0 1.0 19.68 15.27)"><foreignObject style="--ltx-fo-width:46.07em;--ltx-fo-height:0.75em;--ltx-fo-depth:0.25em;font-size:10pt;" height="13.84" overflow="visible" transform="matrix(1 0 0 -1 0 10.38)" width="637.48"><span class="ltx_foreignobject_container"><span class="ltx_foreignobject_content">
<span id="S9.SS8.p11.pic1.1" class="ltx_inline-block ltx_minipage ltx_align_bottom" style="width:46.07em;">
<span id="S9.SS8.p11.pic1.1.1" class="ltx_p"><span id="S9.SS8.p11.pic1.1.1.1" class="ltx_text" style="--ltx-fg-color:#000000;">See <a href="#S4.Thmproposition1" title="Proposition 4.1 (Radon-Nikodym Derivative of Parameterized Rates). ‣ Weighted Cross-Entropy Objective ‣ 4.1 Adaptive Joint Decoding Loss ‣ 4 A2D2: Fine-Tuning Any-Length Discrete Diffusion for Adaptive Decoding ‣ A2D2: Fine-Tuning Any-Length Discrete Diffusion for Adaptive Decoding" class="ltx_ref"><span class="ltx_text ltx_ref_tag">4.1</span></a></span></span>
</span></span></span></foreignObject></g></g></svg></span>
</div>
<div id="S9.SS8.p12" class="ltx_para ltx_noindent">
<p id="S9.SS8.p12.1" class="ltx_p"><span id="S9.SS8.p12.1.1" class="ltx_text ltx_font_italic">Proof.</span> First, we decompose the RND as:</p>
<table id="S9.EGx105" class="ltx_equationgroup ltx_eqn_align ltx_eqn_table">

<tbody id="S9.E110"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_align_right ltx_eqn_cell"><math id="S9.E110.m1" class="ltx_math_unparsed" alttext="\displaystyle\log\frac{\mathrm{d}\mathbb{P}^{\star}}{\mathrm{d}\mathbb{P}^{v}}(\bm{X}_{0:1})" display="inline" intent=":literal"><semantics><mrow><mi>log</mi><mstyle displaystyle="true"><mfrac><mrow><mi>d</mi><mo lspace="0em" rspace="0em">​</mo><msup><mi>ℙ</mi><mo>⋆</mo></msup></mrow><mrow><mi>d</mi><mo lspace="0em" rspace="0em">​</mo><msup><mi>ℙ</mi><mi>v</mi></msup></mrow></mfrac></mstyle><mrow><mo stretchy="false">(</mo><msub><mi>𝑿</mi><mrow><mn>0</mn><mo lspace="0.278em" rspace="0.278em">:</mo><mn>1</mn></mrow></msub><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">\displaystyle\log\frac{\mathrm{d}\mathbb{P}^{\star}}{\mathrm{d}\mathbb{P}^{v}}(\bm{X}_{0:1})</annotation></semantics></math></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="S9.E110.m2" class="ltx_math_unparsed" alttext="\displaystyle=\log\frac{\mathrm{d}\mathbb{P}^{\star}}{\mathrm{d}\mathbb{P}^{0}}\frac{\mathrm{d}\mathbb{P}^{0}}{\mathrm{d}\mathbb{P}^{v}}(\bm{X}_{0:1})=\log\frac{\mathrm{d}\mathbb{P}^{\star}}{\mathrm{d}\mathbb{P}^{0}}(\bm{X}_{0:1})+\log\frac{\mathrm{d}\mathbb{P}^{0}}{\mathrm{d}\mathbb{P}^{v}}(\bm{X}_{0:1})" display="inline" intent=":literal"><semantics><mrow><mo>=</mo><mi>log</mi><mstyle displaystyle="true"><mfrac><mrow><mi>d</mi><mo lspace="0em" rspace="0em">​</mo><msup><mi>ℙ</mi><mo>⋆</mo></msup></mrow><mrow><mi>d</mi><mo lspace="0em" rspace="0em">​</mo><msup><mi>ℙ</mi><mn>0</mn></msup></mrow></mfrac></mstyle><mstyle displaystyle="true"><mfrac><mrow><mi>d</mi><mo lspace="0em" rspace="0em">​</mo><msup><mi>ℙ</mi><mn>0</mn></msup></mrow><mrow><mi>d</mi><mo lspace="0em" rspace="0em">​</mo><msup><mi>ℙ</mi><mi>v</mi></msup></mrow></mfrac></mstyle><mrow><mo stretchy="false">(</mo><msub><mi>𝑿</mi><mrow><mn>0</mn><mo lspace="0.278em" rspace="0.278em">:</mo><mn>1</mn></mrow></msub><mo stretchy="false">)</mo></mrow><mo>=</mo><mi>log</mi><mstyle displaystyle="true"><mfrac><mrow><mi>d</mi><mo lspace="0em" rspace="0em">​</mo><msup><mi>ℙ</mi><mo>⋆</mo></msup></mrow><mrow><mi>d</mi><mo lspace="0em" rspace="0em">​</mo><msup><mi>ℙ</mi><mn>0</mn></msup></mrow></mfrac></mstyle><mrow><mo stretchy="false">(</mo><msub><mi>𝑿</mi><mrow><mn>0</mn><mo lspace="0.278em" rspace="0.278em">:</mo><mn>1</mn></mrow></msub><mo stretchy="false">)</mo></mrow><mo>+</mo><mi>log</mi><mstyle displaystyle="true"><mfrac><mrow><mi>d</mi><mo lspace="0em" rspace="0em">​</mo><msup><mi>ℙ</mi><mn>0</mn></msup></mrow><mrow><mi>d</mi><mo lspace="0em" rspace="0em">​</mo><msup><mi>ℙ</mi><mi>v</mi></msup></mrow></mfrac></mstyle><mrow><mo stretchy="false">(</mo><msub><mi>𝑿</mi><mrow><mn>0</mn><mo lspace="0.278em" rspace="0.278em">:</mo><mn>1</mn></mrow></msub><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">\displaystyle=\log\frac{\mathrm{d}\mathbb{P}^{\star}}{\mathrm{d}\mathbb{P}^{0}}\frac{\mathrm{d}\mathbb{P}^{0}}{\mathrm{d}\mathbb{P}^{v}}(\bm{X}_{0:1})=\log\frac{\mathrm{d}\mathbb{P}^{\star}}{\mathrm{d}\mathbb{P}^{0}}(\bm{X}_{0:1})+\log\frac{\mathrm{d}\mathbb{P}^{0}}{\mathrm{d}\mathbb{P}^{v}}(\bm{X}_{0:1})</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td>
<td rowspan="1" class="ltx_eqn_cell ltx_eqn_eqno ltx_align_middle ltx_align_right"><span class="ltx_tag ltx_tag_equation ltx_align_right">(110)</span></td></tr></tbody>
</table>
</div>
<div id="S9.SS8.p13" class="ltx_para ltx_noindent">
<p id="S9.SS8.p13.1" class="ltx_p">First, we derive the <math id="S9.SS8.p13.m1" class="ltx_math_unparsed" alttext="\log\frac{\mathrm{d}\mathbb{P}^{0}}{\mathrm{d}\mathbb{P}^{v}}(\bm{X}_{0:1})" display="inline" intent=":literal"><semantics><mrow><mi>log</mi><mfrac><mrow><mi>d</mi><mo lspace="0em" rspace="0em">​</mo><msup><mi>ℙ</mi><mn>0</mn></msup></mrow><mrow><mi>d</mi><mo lspace="0em" rspace="0em">​</mo><msup><mi>ℙ</mi><mi>v</mi></msup></mrow></mfrac><mrow><mo stretchy="false">(</mo><msub><mi>𝑿</mi><mrow><mn>0</mn><mo lspace="0.278em" rspace="0.278em">:</mo><mn>1</mn></mrow></msub><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">\log\frac{\mathrm{d}\mathbb{P}^{0}}{\mathrm{d}\mathbb{P}^{v}}(\bm{X}_{0:1})</annotation></semantics></math> where <math id="S9.SS8.p13.m2" class="ltx_Math" alttext="\mathbb{P}^{0}" display="inline" intent=":literal"><semantics><msup><mi>ℙ</mi><mn>0</mn></msup><annotation encoding="application/x-tex">\mathbb{P}^{0}</annotation></semantics></math> is the path measure of the pretrained model <math id="S9.SS8.p13.m3" class="ltx_Math" alttext="(f^{\text{pre}},g^{\text{pre}})" display="inline" intent=":literal"><semantics><mrow><mo stretchy="false">(</mo><msup><mi>f</mi><mtext>pre</mtext></msup><mo>,</mo><msup><mi>g</mi><mtext>pre</mtext></msup><mo stretchy="false">)</mo></mrow><annotation encoding="application/x-tex">(f^{\text{pre}},g^{\text{pre}})</annotation></semantics></math> and <math id="S9.SS8.p13.m4" class="ltx_Math" alttext="\mathbb{P}^{v}" display="inline" intent=":literal"><semantics><msup><mi>ℙ</mi><mi>v</mi></msup><annotation encoding="application/x-tex">\mathbb{P}^{v}</annotation></semantics></math> is the path measure generated from the tilted models <math id="S9.SS8.p13.m5" class="ltx_Math" alttext="(f^{v},g^{v})" display="inline" intent=":literal"><semantics><mrow><mo stretchy="false">(</mo><msup><mi>f</mi><mi>v</mi></msup><mo>,</mo><msup><mi>g</mi><mi>v</mi></msup><mo stretchy="false">)</mo></mrow><annotation encoding="application/x-tex">(f^{v},g^{v})</annotation></semantics></math>. Let <math id="S9.SS8.p13.m6" class="ltx_Math" alttext="t_{i}" display="inline" intent=":literal"><semantics><msub><mi>t</mi><mi>i</mi></msub><annotation encoding="application/x-tex">t_{i}</annotation></semantics></math> denote the times of insertion events and <math id="S9.SS8.p13.m7" class="ltx_Math" alttext="t_{u}" display="inline" intent=":literal"><semantics><msub><mi>t</mi><mi>u</mi></msub><annotation encoding="application/x-tex">t_{u}</annotation></semantics></math> denote the times of unmasking events. Then, the log RND decomposes into:
<span id="S9.SS8.p13.1.1" class="ltx_text"></span></p>
<table id="S9.EGx106" class="ltx_equationgroup ltx_eqn_align ltx_eqn_table">

<tbody id="S9.Ex56"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_align_right ltx_eqn_cell"><math id="S9.Ex56.m1" class="ltx_math_unparsed" alttext="\displaystyle\log\frac{\mathrm{d}\mathbb{P}^{0}}{\mathrm{d}\mathbb{P}^{v}}(\bm{X}_{0:1})" display="inline" intent=":literal"><semantics><mrow><mi mathsize="0.900em">log</mi><mstyle displaystyle="true"><mfrac><mrow><mi mathsize="0.900em">d</mi><mo lspace="0em" rspace="0em">​</mo><msup><mi mathsize="0.900em">ℙ</mi><mn mathsize="0.900em">0</mn></msup></mrow><mrow><mi mathsize="0.900em">d</mi><mo lspace="0em" rspace="0em">​</mo><msup><mi mathsize="0.900em">ℙ</mi><mi mathsize="0.900em">v</mi></msup></mrow></mfrac></mstyle><mrow><mo maxsize="0.900em" minsize="0.900em">(</mo><msub><mi mathsize="0.900em">𝑿</mi><mrow><mn mathsize="0.900em">0</mn><mo lspace="0.278em" mathsize="0.900em" rspace="0.278em">:</mo><mn mathsize="0.900em">1</mn></mrow></msub><mo maxsize="0.900em" minsize="0.900em">)</mo></mrow></mrow><annotation encoding="application/x-tex">\displaystyle\log\frac{\mathrm{d}\mathbb{P}^{0}}{\mathrm{d}\mathbb{P}^{v}}(\bm{X}_{0:1})</annotation></semantics></math></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="S9.Ex56.m2" class="ltx_math_unparsed" alttext="\displaystyle=\log\frac{\mathrm{d}\mathbb{P}_{0}^{0}}{\mathrm{d}\mathbb{P}_{0}^{v}}(\bm{X}_{0})+\sum_{t_{u}:\bm{X}_{t_{u}}\neq\bm{X}_{t_{u}-}}\log\frac{\bm{Q}^{0}_{t_{u}}(\bm{X}_{t_{u}-},\bm{X}_{t_{u}})}{\bm{Q}^{v}_{t_{u}}(\bm{X}_{t_{u}-},\bm{X}_{t_{u}})}+\int_{0}^{1}\sum_{\bm{z}\neq\bm{X}_{t}}(\bm{Q}^{v}_{t}-\bm{Q}^{0}_{t})(\bm{X}_{t},\bm{z})dt" display="inline" intent=":literal"><semantics><mrow><mo mathsize="0.900em">=</mo><mi mathsize="0.900em">log</mi><mstyle displaystyle="true"><mfrac><mrow><mi mathsize="0.900em">d</mi><mo lspace="0em" rspace="0em">​</mo><msubsup><mi mathsize="0.900em">ℙ</mi><mn mathsize="0.900em">0</mn><mn mathsize="0.900em">0</mn></msubsup></mrow><mrow><mi mathsize="0.900em">d</mi><mo lspace="0em" rspace="0em">​</mo><msubsup><mi mathsize="0.900em">ℙ</mi><mn mathsize="0.900em">0</mn><mi mathsize="0.900em">v</mi></msubsup></mrow></mfrac></mstyle><mrow><mo maxsize="0.900em" minsize="0.900em">(</mo><msub><mi mathsize="0.900em">𝑿</mi><mn mathsize="0.900em">0</mn></msub><mo maxsize="0.900em" minsize="0.900em">)</mo></mrow><mo mathsize="0.900em">+</mo><mstyle displaystyle="true"><munder><mo maxsize="0.900em" minsize="0.900em" movablelimits="false" stretchy="true">∑</mo><mrow><msub><mi mathsize="0.900em">t</mi><mi mathsize="0.900em">u</mi></msub><mo lspace="0.278em" mathsize="0.900em" rspace="0.278em">:</mo><mrow><msub><mi mathsize="0.900em">𝑿</mi><msub><mi mathsize="0.900em">t</mi><mi mathsize="0.900em">u</mi></msub></msub><mo mathsize="0.900em">≠</mo><msub><mi mathsize="0.900em">𝑿</mi><mrow><msub><mi mathsize="0.900em">t</mi><mi mathsize="0.900em">u</mi></msub><mo mathsize="0.900em">−</mo></mrow></msub></mrow></mrow></munder></mstyle><mi mathsize="0.900em">log</mi><mstyle displaystyle="true"><mfrac><mrow><msubsup><mi mathsize="0.900em">𝑸</mi><msub><mi mathsize="0.900em">t</mi><mi mathsize="0.900em">u</mi></msub><mn mathsize="0.900em">0</mn></msubsup><mo lspace="0em" rspace="0em">​</mo><mrow><mo maxsize="0.900em" minsize="0.900em">(</mo><msub><mi mathsize="0.900em">𝑿</mi><mrow><msub><mi mathsize="0.900em">t</mi><mi mathsize="0.900em">u</mi></msub><mo mathsize="0.900em">−</mo></mrow></msub><mo mathsize="0.900em">,</mo><msub><mi mathsize="0.900em">𝑿</mi><msub><mi mathsize="0.900em">t</mi><mi mathsize="0.900em">u</mi></msub></msub><mo maxsize="0.900em" minsize="0.900em">)</mo></mrow></mrow><mrow><msubsup><mi mathsize="0.900em">𝑸</mi><msub><mi mathsize="0.900em">t</mi><mi mathsize="0.900em">u</mi></msub><mi mathsize="0.900em">v</mi></msubsup><mo lspace="0em" rspace="0em">​</mo><mrow><mo maxsize="0.900em" minsize="0.900em">(</mo><msub><mi mathsize="0.900em">𝑿</mi><mrow><msub><mi mathsize="0.900em">t</mi><mi mathsize="0.900em">u</mi></msub><mo mathsize="0.900em">−</mo></mrow></msub><mo mathsize="0.900em">,</mo><msub><mi mathsize="0.900em">𝑿</mi><msub><mi mathsize="0.900em">t</mi><mi mathsize="0.900em">u</mi></msub></msub><mo maxsize="0.900em" minsize="0.900em">)</mo></mrow></mrow></mfrac></mstyle><mo mathsize="0.900em">+</mo><mstyle displaystyle="true"><msubsup><mo maxsize="0.900em" minsize="0.900em" stretchy="true">∫</mo><mn mathsize="0.900em">0</mn><mn mathsize="0.900em">1</mn></msubsup></mstyle><mstyle displaystyle="true"><munder><mo maxsize="0.900em" minsize="0.900em" movablelimits="false" stretchy="true">∑</mo><mrow><mi mathsize="0.900em">𝒛</mi><mo mathsize="0.900em">≠</mo><msub><mi mathsize="0.900em">𝑿</mi><mi mathsize="0.900em">t</mi></msub></mrow></munder></mstyle><mrow><mo maxsize="0.900em" minsize="0.900em">(</mo><msubsup><mi mathsize="0.900em">𝑸</mi><mi mathsize="0.900em">t</mi><mi mathsize="0.900em">v</mi></msubsup><mo mathsize="0.900em">−</mo><msubsup><mi mathsize="0.900em">𝑸</mi><mi mathsize="0.900em">t</mi><mn mathsize="0.900em">0</mn></msubsup><mo maxsize="0.900em" minsize="0.900em">)</mo></mrow><mrow><mo maxsize="0.900em" minsize="0.900em">(</mo><msub><mi mathsize="0.900em">𝑿</mi><mi mathsize="0.900em">t</mi></msub><mo mathsize="0.900em">,</mo><mi mathsize="0.900em">𝒛</mi><mo maxsize="0.900em" minsize="0.900em">)</mo></mrow><mi mathsize="0.900em">d</mi><mi mathsize="0.900em">t</mi></mrow><annotation encoding="application/x-tex">\displaystyle=\log\frac{\mathrm{d}\mathbb{P}_{0}^{0}}{\mathrm{d}\mathbb{P}_{0}^{v}}(\bm{X}_{0})+\sum_{t_{u}:\bm{X}_{t_{u}}\neq\bm{X}_{t_{u}-}}\log\frac{\bm{Q}^{0}_{t_{u}}(\bm{X}_{t_{u}-},\bm{X}_{t_{u}})}{\bm{Q}^{v}_{t_{u}}(\bm{X}_{t_{u}-},\bm{X}_{t_{u}})}+\int_{0}^{1}\sum_{\bm{z}\neq\bm{X}_{t}}(\bm{Q}^{v}_{t}-\bm{Q}^{0}_{t})(\bm{X}_{t},\bm{z})dt</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
<tbody id="S9.E111"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_eqn_cell"></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="S9.E111.m1" class="ltx_math_unparsed" alttext="\displaystyle+\sum_{t_{i}:\bm{X}_{t_{i}}\neq\bm{X}_{t_{i}-}}\log\frac{\bm{R}^{0}_{t_{i}}(\bm{X}_{t_{i}-},\bm{X}_{t_{i}})}{\bm{R}^{v}_{t_{i}}(\bm{X}_{t_{i}-},\bm{X}_{t_{i}})}+\int_{0}^{1}\sum_{\bm{y}\neq\bm{X}_{t}}(\bm{R}^{v}_{t}-\bm{R}^{0}_{t})(\bm{X}_{t},\bm{y})dt" display="inline" intent=":literal"><semantics><mrow><mo mathsize="0.900em">+</mo><mstyle displaystyle="true"><munder><mo maxsize="0.900em" minsize="0.900em" movablelimits="false" stretchy="true">∑</mo><mrow><msub><mi mathsize="0.900em">t</mi><mi mathsize="0.900em">i</mi></msub><mo lspace="0.278em" mathsize="0.900em" rspace="0.278em">:</mo><mrow><msub><mi mathsize="0.900em">𝑿</mi><msub><mi mathsize="0.900em">t</mi><mi mathsize="0.900em">i</mi></msub></msub><mo mathsize="0.900em">≠</mo><msub><mi mathsize="0.900em">𝑿</mi><mrow><msub><mi mathsize="0.900em">t</mi><mi mathsize="0.900em">i</mi></msub><mo mathsize="0.900em">−</mo></mrow></msub></mrow></mrow></munder></mstyle><mi mathsize="0.900em">log</mi><mstyle displaystyle="true"><mfrac><mrow><msubsup><mi mathsize="0.900em">𝑹</mi><msub><mi mathsize="0.900em">t</mi><mi mathsize="0.900em">i</mi></msub><mn mathsize="0.900em">0</mn></msubsup><mo lspace="0em" rspace="0em">​</mo><mrow><mo maxsize="0.900em" minsize="0.900em">(</mo><msub><mi mathsize="0.900em">𝑿</mi><mrow><msub><mi mathsize="0.900em">t</mi><mi mathsize="0.900em">i</mi></msub><mo mathsize="0.900em">−</mo></mrow></msub><mo mathsize="0.900em">,</mo><msub><mi mathsize="0.900em">𝑿</mi><msub><mi mathsize="0.900em">t</mi><mi mathsize="0.900em">i</mi></msub></msub><mo maxsize="0.900em" minsize="0.900em">)</mo></mrow></mrow><mrow><msubsup><mi mathsize="0.900em">𝑹</mi><msub><mi mathsize="0.900em">t</mi><mi mathsize="0.900em">i</mi></msub><mi mathsize="0.900em">v</mi></msubsup><mo lspace="0em" rspace="0em">​</mo><mrow><mo maxsize="0.900em" minsize="0.900em">(</mo><msub><mi mathsize="0.900em">𝑿</mi><mrow><msub><mi mathsize="0.900em">t</mi><mi mathsize="0.900em">i</mi></msub><mo mathsize="0.900em">−</mo></mrow></msub><mo mathsize="0.900em">,</mo><msub><mi mathsize="0.900em">𝑿</mi><msub><mi mathsize="0.900em">t</mi><mi mathsize="0.900em">i</mi></msub></msub><mo maxsize="0.900em" minsize="0.900em">)</mo></mrow></mrow></mfrac></mstyle><mo mathsize="0.900em">+</mo><mstyle displaystyle="true"><msubsup><mo maxsize="0.900em" minsize="0.900em" stretchy="true">∫</mo><mn mathsize="0.900em">0</mn><mn mathsize="0.900em">1</mn></msubsup></mstyle><mstyle displaystyle="true"><munder><mo maxsize="0.900em" minsize="0.900em" movablelimits="false" stretchy="true">∑</mo><mrow><mi mathsize="0.900em">𝒚</mi><mo mathsize="0.900em">≠</mo><msub><mi mathsize="0.900em">𝑿</mi><mi mathsize="0.900em">t</mi></msub></mrow></munder></mstyle><mrow><mo maxsize="0.900em" minsize="0.900em">(</mo><msubsup><mi mathsize="0.900em">𝑹</mi><mi mathsize="0.900em">t</mi><mi mathsize="0.900em">v</mi></msubsup><mo mathsize="0.900em">−</mo><msubsup><mi mathsize="0.900em">𝑹</mi><mi mathsize="0.900em">t</mi><mn mathsize="0.900em">0</mn></msubsup><mo maxsize="0.900em" minsize="0.900em">)</mo></mrow><mrow><mo maxsize="0.900em" minsize="0.900em">(</mo><msub><mi mathsize="0.900em">𝑿</mi><mi mathsize="0.900em">t</mi></msub><mo mathsize="0.900em">,</mo><mi mathsize="0.900em">𝒚</mi><mo maxsize="0.900em" minsize="0.900em">)</mo></mrow><mi mathsize="0.900em">d</mi><mi mathsize="0.900em">t</mi></mrow><annotation encoding="application/x-tex">\displaystyle+\sum_{t_{i}:\bm{X}_{t_{i}}\neq\bm{X}_{t_{i}-}}\log\frac{\bm{R}^{0}_{t_{i}}(\bm{X}_{t_{i}-},\bm{X}_{t_{i}})}{\bm{R}^{v}_{t_{i}}(\bm{X}_{t_{i}-},\bm{X}_{t_{i}})}+\int_{0}^{1}\sum_{\bm{y}\neq\bm{X}_{t}}(\bm{R}^{v}_{t}-\bm{R}^{0}_{t})(\bm{X}_{t},\bm{y})dt</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td>
<td rowspan="1" class="ltx_eqn_cell ltx_eqn_eqno ltx_align_middle ltx_align_right"><span class="ltx_tag ltx_tag_equation ltx_align_right">(111)</span></td></tr></tbody>
</table>
</div>
<div id="S9.SS8.p14" class="ltx_para ltx_noindent">
<p id="S9.SS8.p14.1" class="ltx_p">Now, we recall the form of the any-length MDM unmasking rate:</p>
<table id="S9.EGx107" class="ltx_equationgroup ltx_eqn_align ltx_eqn_table">

<tbody id="S9.E112"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_align_right ltx_eqn_cell"><math id="S9.E112.m1" class="ltx_Math" alttext="\displaystyle\bm{Q}^{v}_{t}(\bm{x},\bm{x}^{\ell\leftarrow\bm{v}})" display="inline" intent=":literal"><semantics><mrow><msubsup><mi>𝑸</mi><mi>t</mi><mi>v</mi></msubsup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>𝒙</mi><mo>,</mo><msup><mi>𝒙</mi><mrow><mi mathvariant="normal">ℓ</mi><mo stretchy="false">←</mo><mi>𝒗</mi></mrow></msup><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">\displaystyle\bm{Q}^{v}_{t}(\bm{x},\bm{x}^{\ell\leftarrow\bm{v}})</annotation></semantics></math></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="S9.E112.m2" class="ltx_Math" alttext="\displaystyle=\frac{\dot{\beta}_{t}}{1-\beta_{t}}\cdot\mathbb{P}(\bm{x}_{1}^{s_{t}[i]}=\bm{v}|\bm{x}_{t}=\bm{x}),\quad\bm{v}\in\mathcal{V},\bm{x}^{i}=\bm{M}" display="inline" intent=":literal"><semantics><mrow><mrow><mphantom></mphantom><mo>=</mo><mrow><mstyle displaystyle="true"><mfrac><msub><mover accent="true"><mi>β</mi><mo>˙</mo></mover><mi>t</mi></msub><mrow><mn>1</mn><mo>−</mo><msub><mi>β</mi><mi>t</mi></msub></mrow></mfrac></mstyle><mo lspace="0.222em" rspace="0.222em">⋅</mo><mrow><mi>ℙ</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mrow><msubsup><mi>𝒙</mi><mn>1</mn><mrow><msub><mi>s</mi><mi>t</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">[</mo><mi>i</mi><mo stretchy="false">]</mo></mrow></mrow></msubsup><mo>=</mo><mi>𝒗</mi></mrow><mo lspace="0em" rspace="0em">|</mo><mrow><msub><mi>𝒙</mi><mi>t</mi></msub><mo>=</mo><mi>𝒙</mi></mrow><mo stretchy="false">)</mo></mrow></mrow></mrow></mrow><mo rspace="1.167em">,</mo><mrow><mi>𝒗</mi><mo>∈</mo><mi class="ltx_font_mathcaligraphic">𝒱</mi></mrow><mo>,</mo><mrow><msup><mi>𝒙</mi><mi>i</mi></msup><mo>=</mo><mi>𝑴</mi></mrow></mrow><annotation encoding="application/x-tex">\displaystyle=\frac{\dot{\beta}_{t}}{1-\beta_{t}}\cdot\mathbb{P}(\bm{x}_{1}^{s_{t}[i]}=\bm{v}|\bm{x}_{t}=\bm{x}),\quad\bm{v}\in\mathcal{V},\bm{x}^{i}=\bm{M}</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td>
<td rowspan="1" class="ltx_eqn_cell ltx_eqn_eqno ltx_align_middle ltx_align_right"><span class="ltx_tag ltx_tag_equation ltx_align_right">(112)</span></td></tr></tbody>
<tbody id="S9.E113"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_eqn_cell"></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="S9.E113.m1" class="ltx_Math" alttext="\displaystyle=\frac{\dot{\beta}_{t}}{1-\beta_{t}}\cdot f^{v}(\bm{x},t)[i,\bm{v}]" display="inline" intent=":literal"><semantics><mrow><mphantom></mphantom><mo>=</mo><mrow><mrow><mstyle displaystyle="true"><mfrac><msub><mover accent="true"><mi>β</mi><mo>˙</mo></mover><mi>t</mi></msub><mrow><mn>1</mn><mo>−</mo><msub><mi>β</mi><mi>t</mi></msub></mrow></mfrac></mstyle><mo lspace="0.222em" rspace="0.222em">⋅</mo><msup><mi>f</mi><mi>v</mi></msup></mrow><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>𝒙</mi><mo>,</mo><mi>t</mi><mo stretchy="false">)</mo></mrow><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">[</mo><mrow><mi>i</mi><mo>,</mo><mi>𝒗</mi></mrow><mo stretchy="false">]</mo></mrow></mrow></mrow><annotation encoding="application/x-tex">\displaystyle=\frac{\dot{\beta}_{t}}{1-\beta_{t}}\cdot f^{v}(\bm{x},t)[i,\bm{v}]</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td>
<td rowspan="1" class="ltx_eqn_cell ltx_eqn_eqno ltx_align_middle ltx_align_right"><span class="ltx_tag ltx_tag_equation ltx_align_right">(113)</span></td></tr></tbody>
</table>
<p id="S9.SS8.p14.2" class="ltx_p">where the sum over the vocabulary <math id="S9.SS8.p14.m1" class="ltx_Math" alttext="\sum_{d\in\mathcal{V}}f_{\theta}(\bm{x},t)[i,\bm{v}]=1" display="inline" intent=":literal"><semantics><mrow><mrow><msub><mo>∑</mo><mrow><mi>d</mi><mo>∈</mo><mi class="ltx_font_mathcaligraphic">𝒱</mi></mrow></msub><mrow><msub><mi>f</mi><mi>θ</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>𝒙</mi><mo>,</mo><mi>t</mi><mo stretchy="false">)</mo></mrow><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">[</mo><mrow><mi>i</mi><mo>,</mo><mi>𝒗</mi></mrow><mo stretchy="false">]</mo></mrow></mrow></mrow><mo>=</mo><mn>1</mn></mrow><annotation encoding="application/x-tex">\sum_{d\in\mathcal{V}}f_{\theta}(\bm{x},t)[i,\bm{v}]=1</annotation></semantics></math>. For a state <math id="S9.SS8.p14.m2" class="ltx_Math" alttext="\bm{x}" display="inline" intent=":literal"><semantics><mi>𝒙</mi><annotation encoding="application/x-tex">\bm{x}</annotation></semantics></math> with <math id="S9.SS8.p14.m3" class="ltx_Math" alttext="|\{\ell:\bm{x}^{\ell}=\bm{M}\}|" display="inline" intent=":literal"><semantics><mrow><mo stretchy="false">|</mo><mrow><mo stretchy="false">{</mo><mi mathvariant="normal">ℓ</mi><mo lspace="0.278em" rspace="0.278em">:</mo><mrow><msup><mi>𝒙</mi><mi mathvariant="normal">ℓ</mi></msup><mo>=</mo><mi>𝑴</mi></mrow><mo stretchy="false">}</mo></mrow><mo stretchy="false">|</mo></mrow><annotation encoding="application/x-tex">|\{\ell:\bm{x}^{\ell}=\bm{M}\}|</annotation></semantics></math> masked positions, we have that the <span id="S9.SS8.p14.2.1" class="ltx_text ltx_font_bold">exit rate</span> from state <math id="S9.SS8.p14.m4" class="ltx_Math" alttext="\bm{x}" display="inline" intent=":literal"><semantics><mi>𝒙</mi><annotation encoding="application/x-tex">\bm{x}</annotation></semantics></math> reduces to:</p>
<table id="S9.EGx108" class="ltx_equationgroup ltx_eqn_align ltx_eqn_table">

<tbody id="S9.E114"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_align_right ltx_eqn_cell"><math id="S9.E114.m1" class="ltx_math_unparsed" alttext="\displaystyle\sum_{\bm{y}\neq\bm{x}}\bm{Q}_{t}^{v}(\bm{x},\bm{y})=\sum_{\ell:\bm{x}^{\ell}=\bm{M}}\sum_{d}\bm{Q}_{t}^{v}(\bm{x},\bm{x}^{\ell\leftarrow\bm{v}})=\frac{\dot{\beta}_{t}}{1-\beta_{t}}\sum_{\ell:\bm{x}^{\ell}=\bm{M}}1=\frac{\dot{\beta}_{t}}{1-\beta_{t}}\big|\{\ell:\bm{x}^{\ell}=\bm{M}\}\big|" display="inline" intent=":literal"><semantics><mrow><mstyle displaystyle="true"><munder><mo movablelimits="false">∑</mo><mrow><mi>𝒚</mi><mo>≠</mo><mi>𝒙</mi></mrow></munder></mstyle><msubsup><mi>𝑸</mi><mi>t</mi><mi>v</mi></msubsup><mrow><mo stretchy="false">(</mo><mi>𝒙</mi><mo>,</mo><mi>𝒚</mi><mo stretchy="false">)</mo></mrow><mo>=</mo><mstyle displaystyle="true"><munder><mo movablelimits="false">∑</mo><mrow><mi mathvariant="normal">ℓ</mi><mo lspace="0.278em" rspace="0.278em">:</mo><mrow><msup><mi>𝒙</mi><mi mathvariant="normal">ℓ</mi></msup><mo>=</mo><mi>𝑴</mi></mrow></mrow></munder></mstyle><mstyle displaystyle="true"><munder><mo movablelimits="false">∑</mo><mi>d</mi></munder></mstyle><msubsup><mi>𝑸</mi><mi>t</mi><mi>v</mi></msubsup><mrow><mo stretchy="false">(</mo><mi>𝒙</mi><mo>,</mo><msup><mi>𝒙</mi><mrow><mi mathvariant="normal">ℓ</mi><mo stretchy="false">←</mo><mi>𝒗</mi></mrow></msup><mo stretchy="false">)</mo></mrow><mo>=</mo><mstyle displaystyle="true"><mfrac><msub><mover accent="true"><mi>β</mi><mo>˙</mo></mover><mi>t</mi></msub><mrow><mn>1</mn><mo>−</mo><msub><mi>β</mi><mi>t</mi></msub></mrow></mfrac></mstyle><mstyle displaystyle="true"><munder><mo movablelimits="false">∑</mo><mrow><mi mathvariant="normal">ℓ</mi><mo lspace="0.278em" rspace="0.278em">:</mo><mrow><msup><mi>𝒙</mi><mi mathvariant="normal">ℓ</mi></msup><mo>=</mo><mi>𝑴</mi></mrow></mrow></munder></mstyle><mn>1</mn><mo>=</mo><mstyle displaystyle="true"><mfrac><msub><mover accent="true"><mi>β</mi><mo>˙</mo></mover><mi>t</mi></msub><mrow><mn>1</mn><mo>−</mo><msub><mi>β</mi><mi>t</mi></msub></mrow></mfrac></mstyle><mo fence="false" maxsize="1.200em" minsize="1.200em" rspace="0.167em" stretchy="true">|</mo><mrow><mo stretchy="false">{</mo><mi mathvariant="normal">ℓ</mi><mo lspace="0.278em" rspace="0.278em">:</mo><msup><mi>𝒙</mi><mi mathvariant="normal">ℓ</mi></msup><mo>=</mo><mi>𝑴</mi><mo stretchy="false">}</mo></mrow><mo fence="false" maxsize="1.200em" minsize="1.200em" stretchy="true">|</mo></mrow><annotation encoding="application/x-tex">\displaystyle\sum_{\bm{y}\neq\bm{x}}\bm{Q}_{t}^{v}(\bm{x},\bm{y})=\sum_{\ell:\bm{x}^{\ell}=\bm{M}}\sum_{d}\bm{Q}_{t}^{v}(\bm{x},\bm{x}^{\ell\leftarrow\bm{v}})=\frac{\dot{\beta}_{t}}{1-\beta_{t}}\sum_{\ell:\bm{x}^{\ell}=\bm{M}}1=\frac{\dot{\beta}_{t}}{1-\beta_{t}}\big|\{\ell:\bm{x}^{\ell}=\bm{M}\}\big|</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td>
<td rowspan="1" class="ltx_eqn_cell ltx_eqn_eqno ltx_align_middle ltx_align_right"><span class="ltx_tag ltx_tag_equation ltx_align_right">(114)</span></td></tr></tbody>
</table>
<p id="S9.SS8.p14.3" class="ltx_p">Given the noise schedule <math id="S9.SS8.p14.m5" class="ltx_Math" alttext="\beta_{t}" display="inline" intent=":literal"><semantics><msub><mi>β</mi><mi>t</mi></msub><annotation encoding="application/x-tex">\beta_{t}</annotation></semantics></math> is equal for both the pretrained and fine-tuned models, the number of masked positions along the interpolant is equal. So we can write:</p>
<table id="S9.EGx109" class="ltx_equationgroup ltx_eqn_align ltx_eqn_table">

<tbody id="S9.E115"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_align_right ltx_eqn_cell"><math id="S9.E115.m1" class="ltx_Math" alttext="\displaystyle\sum_{\bm{y}\neq\bm{x}}\bm{Q}_{t}^{0}(\bm{x},\bm{y})=\frac{\dot{\beta}_{t}}{1-\beta_{t}}\big|\{\ell:\bm{x}^{\ell}=\bm{M}\}\big|" display="inline" intent=":literal"><semantics><mrow><mrow><mstyle displaystyle="true"><munder><mo movablelimits="false">∑</mo><mrow><mi>𝒚</mi><mo>≠</mo><mi>𝒙</mi></mrow></munder></mstyle><mrow><msubsup><mi>𝑸</mi><mi>t</mi><mn>0</mn></msubsup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>𝒙</mi><mo>,</mo><mi>𝒚</mi><mo stretchy="false">)</mo></mrow></mrow></mrow><mo>=</mo><mrow><mstyle displaystyle="true"><mfrac><msub><mover accent="true"><mi>β</mi><mo>˙</mo></mover><mi>t</mi></msub><mrow><mn>1</mn><mo>−</mo><msub><mi>β</mi><mi>t</mi></msub></mrow></mfrac></mstyle><mo lspace="0em" rspace="0em">​</mo><mrow><mo maxsize="1.200em" minsize="1.200em" stretchy="true">|</mo><mrow><mo stretchy="false">{</mo><mi mathvariant="normal">ℓ</mi><mo lspace="0.278em" rspace="0.278em">:</mo><mrow><msup><mi>𝒙</mi><mi mathvariant="normal">ℓ</mi></msup><mo>=</mo><mi>𝑴</mi></mrow><mo stretchy="false">}</mo></mrow><mo maxsize="1.200em" minsize="1.200em" stretchy="true">|</mo></mrow></mrow></mrow><annotation encoding="application/x-tex">\displaystyle\sum_{\bm{y}\neq\bm{x}}\bm{Q}_{t}^{0}(\bm{x},\bm{y})=\frac{\dot{\beta}_{t}}{1-\beta_{t}}\big|\{\ell:\bm{x}^{\ell}=\bm{M}\}\big|</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td>
<td rowspan="1" class="ltx_eqn_cell ltx_eqn_eqno ltx_align_middle ltx_align_right"><span class="ltx_tag ltx_tag_equation ltx_align_right">(115)</span></td></tr></tbody>
</table>
<p id="S9.SS8.p14.4" class="ltx_p">and the exit term vanishes:</p>
<table id="S9.EGx110" class="ltx_equationgroup ltx_eqn_align ltx_eqn_table">

<tbody id="S9.E116"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_align_right ltx_eqn_cell"><math id="S9.E116.m1" class="ltx_Math" alttext="\displaystyle\int_{0}^{1}\sum_{y\neq\bm{X}_{t_{u}}}(\bm{Q}_{t_{u}}^{v}-\bm{Q}^{0}_{t_{u}})(\bm{X}_{t_{u}},y)\mathrm{d}t=0" display="inline" intent=":literal"><semantics><mrow><mrow><mstyle displaystyle="true"><msubsup><mo>∫</mo><mn>0</mn><mn>1</mn></msubsup></mstyle><mrow><mstyle displaystyle="true"><munder><mo movablelimits="false">∑</mo><mrow><mi>y</mi><mo>≠</mo><msub><mi>𝑿</mi><msub><mi>t</mi><mi>u</mi></msub></msub></mrow></munder></mstyle><mrow><mrow><mo stretchy="false">(</mo><mrow><msubsup><mi>𝑸</mi><msub><mi>t</mi><mi>u</mi></msub><mi>v</mi></msubsup><mo>−</mo><msubsup><mi>𝑸</mi><msub><mi>t</mi><mi>u</mi></msub><mn>0</mn></msubsup></mrow><mo stretchy="false">)</mo></mrow><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mi>𝑿</mi><msub><mi>t</mi><mi>u</mi></msub></msub><mo>,</mo><mi>y</mi><mo stretchy="false">)</mo></mrow><mo lspace="0em" rspace="0em">​</mo><mrow><mo rspace="0em">𝑑</mo><mi>t</mi></mrow></mrow></mrow></mrow><mo>=</mo><mn>0</mn></mrow><annotation encoding="application/x-tex">\displaystyle\int_{0}^{1}\sum_{y\neq\bm{X}_{t_{u}}}(\bm{Q}_{t_{u}}^{v}-\bm{Q}^{0}_{t_{u}})(\bm{X}_{t_{u}},y)\mathrm{d}t=0</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td>
<td rowspan="1" class="ltx_eqn_cell ltx_eqn_eqno ltx_align_middle ltx_align_right"><span class="ltx_tag ltx_tag_equation ltx_align_right">(116)</span></td></tr></tbody>
</table>
</div>
<div id="S9.SS8.p15" class="ltx_para ltx_noindent">
<p id="S9.SS8.p15.1" class="ltx_p">The insertion rate is defined as:</p>
<table id="S9.EGx111" class="ltx_equationgroup ltx_eqn_align ltx_eqn_table">

<tbody id="S9.E117"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_align_right ltx_eqn_cell"><math id="S9.E117.m1" class="ltx_math_unparsed" alttext="\displaystyle\bm{R}^{v}_{t}(\bm{x},\bm{x}^{\triangleleft_{\ell}\bm{M}})" display="inline" intent=":literal"><semantics><mrow><msubsup><mi>𝑹</mi><mi>t</mi><mi>v</mi></msubsup><mrow><mo stretchy="false">(</mo><mi>𝒙</mi><mo>,</mo><msup><mi>𝒙</mi><mrow><mo rspace="0.222em">⊲</mo><msub><mrow></mrow><mi mathvariant="normal">ℓ</mi></msub><mi>𝑴</mi></mrow></msup><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">\displaystyle\bm{R}^{v}_{t}(\bm{x},\bm{x}^{\triangleleft_{\ell}\bm{M}})</annotation></semantics></math></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="S9.E117.m2" class="ltx_Math" alttext="\displaystyle=\frac{\dot{\alpha}_{t}}{1-\alpha_{t}}\cdot\mathbb{E}[s_{t}[\ell]-s_{t}[\ell-1]-1|\bm{x}_{t}=\bm{x}]" display="inline" intent=":literal"><semantics><mrow><mphantom></mphantom><mo>=</mo><mrow><mstyle displaystyle="true"><mfrac><msub><mover accent="true"><mi>α</mi><mo>˙</mo></mover><mi>t</mi></msub><mrow><mn>1</mn><mo>−</mo><msub><mi>α</mi><mi>t</mi></msub></mrow></mfrac></mstyle><mo lspace="0.222em" rspace="0.222em">⋅</mo><mrow><mi>𝔼</mi><mo>⁡</mo><mrow><mo stretchy="false">[</mo><mrow><mrow><mrow><msub><mi>s</mi><mi>t</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">[</mo><mi mathvariant="normal">ℓ</mi><mo stretchy="false">]</mo></mrow></mrow><mo>−</mo><mrow><msub><mi>s</mi><mi>t</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">[</mo><mrow><mi mathvariant="normal">ℓ</mi><mo>−</mo><mn>1</mn></mrow><mo stretchy="false">]</mo></mrow></mrow><mo>−</mo><mn>1</mn></mrow><mo fence="false" rspace="0.167em" stretchy="false">|</mo><mrow><msub><mi>𝒙</mi><mi>t</mi></msub><mo>=</mo><mi>𝒙</mi></mrow></mrow><mo stretchy="false">]</mo></mrow></mrow></mrow></mrow><annotation encoding="application/x-tex">\displaystyle=\frac{\dot{\alpha}_{t}}{1-\alpha_{t}}\cdot\mathbb{E}[s_{t}[\ell]-s_{t}[\ell-1]-1|\bm{x}_{t}=\bm{x}]</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td>
<td rowspan="1" class="ltx_eqn_cell ltx_eqn_eqno ltx_align_middle ltx_align_right"><span class="ltx_tag ltx_tag_equation ltx_align_right">(117)</span></td></tr></tbody>
<tbody id="S9.E118"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_eqn_cell"></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="S9.E118.m1" class="ltx_Math" alttext="\displaystyle=\frac{\dot{\alpha}_{t}}{1-\alpha_{t}}g^{v}(\bm{x},t)[\ell]" display="inline" intent=":literal"><semantics><mrow><mphantom></mphantom><mo>=</mo><mrow><mstyle displaystyle="true"><mfrac><msub><mover accent="true"><mi>α</mi><mo>˙</mo></mover><mi>t</mi></msub><mrow><mn>1</mn><mo>−</mo><msub><mi>α</mi><mi>t</mi></msub></mrow></mfrac></mstyle><mo lspace="0em" rspace="0em">​</mo><msup><mi>g</mi><mi>v</mi></msup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>𝒙</mi><mo>,</mo><mi>t</mi><mo stretchy="false">)</mo></mrow><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">[</mo><mi mathvariant="normal">ℓ</mi><mo stretchy="false">]</mo></mrow></mrow></mrow><annotation encoding="application/x-tex">\displaystyle=\frac{\dot{\alpha}_{t}}{1-\alpha_{t}}g^{v}(\bm{x},t)[\ell]</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td>
<td rowspan="1" class="ltx_eqn_cell ltx_eqn_eqno ltx_align_middle ltx_align_right"><span class="ltx_tag ltx_tag_equation ltx_align_right">(118)</span></td></tr></tbody>
</table>
<p id="S9.SS8.p15.2" class="ltx_p">Since the insertion rate depends on the model outputs, we have that <math id="S9.SS8.p15.m1" class="ltx_math_unparsed" alttext="\bm{R}^{0}_{t}(\bm{x},\bm{x}^{\triangleleft_{\ell}\bm{M}})\neq\bm{R}^{v}_{t}(\bm{x},\bm{x}^{\triangleleft_{\ell}\bm{M}})" display="inline" intent=":literal"><semantics><mrow><msubsup><mi>𝑹</mi><mi>t</mi><mn>0</mn></msubsup><mrow><mo stretchy="false">(</mo><mi>𝒙</mi><mo>,</mo><msup><mi>𝒙</mi><mrow><mo rspace="0.222em">⊲</mo><msub><mrow></mrow><mi mathvariant="normal">ℓ</mi></msub><mi>𝑴</mi></mrow></msup><mo stretchy="false">)</mo></mrow><mo>≠</mo><msubsup><mi>𝑹</mi><mi>t</mi><mi>v</mi></msubsup><mrow><mo stretchy="false">(</mo><mi>𝒙</mi><mo>,</mo><msup><mi>𝒙</mi><mrow><mo rspace="0.222em">⊲</mo><msub><mrow></mrow><mi mathvariant="normal">ℓ</mi></msub><mi>𝑴</mi></mrow></msup><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">\bm{R}^{0}_{t}(\bm{x},\bm{x}^{\triangleleft_{\ell}\bm{M}})\neq\bm{R}^{v}_{t}(\bm{x},\bm{x}^{\triangleleft_{\ell}\bm{M}})</annotation></semantics></math>. In this case, the exit term is defined as:
<span id="S9.SS8.p15.2.1" class="ltx_text"></span></p>
<table id="S9.EGx112" class="ltx_equationgroup ltx_eqn_align ltx_eqn_table">

<tbody id="S9.E119"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_align_right ltx_eqn_cell"><math id="S9.E119.m1" class="ltx_Math" alttext="\displaystyle\int_{0}^{1}\sum_{y\neq\bm{X}_{t_{u}}}(\bm{R}_{t}^{v}-\bm{R}^{0}_{t})(\bm{X}_{t},y)dt=\int_{0}^{1}\frac{\dot{\alpha}_{t}}{1-\alpha_{t}}\left(\sum_{\ell}g^{v}(\bm{X}_{t},t)[\ell]-\sum_{\ell}g_{\theta}^{\text{pre}}(\bm{X}_{t},t)[\ell]\right)dt" display="inline" intent=":literal"><semantics><mrow><mrow><mstyle displaystyle="true"><msubsup><mo maxsize="0.900em" minsize="0.900em" stretchy="true">∫</mo><mn mathsize="0.900em">0</mn><mn mathsize="0.900em">1</mn></msubsup></mstyle><mrow><mstyle displaystyle="true"><munder><mo maxsize="0.900em" minsize="0.900em" movablelimits="false" stretchy="true">∑</mo><mrow><mi mathsize="0.900em">y</mi><mo mathsize="0.900em">≠</mo><msub><mi mathsize="0.900em">𝑿</mi><msub><mi mathsize="0.900em">t</mi><mi mathsize="0.900em">u</mi></msub></msub></mrow></munder></mstyle><mrow><mrow><mo maxsize="0.900em" minsize="0.900em">(</mo><mrow><msubsup><mi mathsize="0.900em">𝑹</mi><mi mathsize="0.900em">t</mi><mi mathsize="0.900em">v</mi></msubsup><mo mathsize="0.900em">−</mo><msubsup><mi mathsize="0.900em">𝑹</mi><mi mathsize="0.900em">t</mi><mn mathsize="0.900em">0</mn></msubsup></mrow><mo maxsize="0.900em" minsize="0.900em">)</mo></mrow><mo lspace="0em" rspace="0em">​</mo><mrow><mo maxsize="0.900em" minsize="0.900em">(</mo><msub><mi mathsize="0.900em">𝑿</mi><mi mathsize="0.900em">t</mi></msub><mo mathsize="0.900em">,</mo><mi mathsize="0.900em">y</mi><mo maxsize="0.900em" minsize="0.900em">)</mo></mrow><mo lspace="0em" rspace="0em">​</mo><mrow><mo mathsize="0.900em" rspace="0em">𝑑</mo><mi mathsize="0.900em">t</mi></mrow></mrow></mrow></mrow><mo mathsize="0.900em">=</mo><mrow><mstyle displaystyle="true"><msubsup><mo maxsize="0.900em" minsize="0.900em" stretchy="true">∫</mo><mn mathsize="0.900em">0</mn><mn mathsize="0.900em">1</mn></msubsup></mstyle><mrow><mstyle displaystyle="true"><mfrac><msub><mover accent="true"><mi mathsize="0.900em">α</mi><mo>˙</mo></mover><mi mathsize="0.900em">t</mi></msub><mrow><mn mathsize="0.900em">1</mn><mo mathsize="0.900em">−</mo><msub><mi mathsize="0.900em">α</mi><mi mathsize="0.900em">t</mi></msub></mrow></mfrac></mstyle><mo lspace="0em" rspace="0em">​</mo><mrow><mo>(</mo><mrow><mrow><mstyle displaystyle="true"><munder><mo maxsize="0.900em" minsize="0.900em" movablelimits="false" stretchy="true">∑</mo><mi mathsize="0.900em" mathvariant="normal">ℓ</mi></munder></mstyle><mrow><msup><mi mathsize="0.900em">g</mi><mi mathsize="0.900em">v</mi></msup><mo lspace="0em" rspace="0em">​</mo><mrow><mo maxsize="0.900em" minsize="0.900em">(</mo><msub><mi mathsize="0.900em">𝑿</mi><mi mathsize="0.900em">t</mi></msub><mo mathsize="0.900em">,</mo><mi mathsize="0.900em">t</mi><mo maxsize="0.900em" minsize="0.900em">)</mo></mrow><mo lspace="0em" rspace="0em">​</mo><mrow><mo maxsize="0.900em" minsize="0.900em">[</mo><mi mathsize="0.900em" mathvariant="normal">ℓ</mi><mo maxsize="0.900em" minsize="0.900em">]</mo></mrow></mrow></mrow><mo mathsize="0.900em">−</mo><mrow><mstyle displaystyle="true"><munder><mo maxsize="0.900em" minsize="0.900em" movablelimits="false" stretchy="true">∑</mo><mi mathsize="0.900em" mathvariant="normal">ℓ</mi></munder></mstyle><mrow><msubsup><mi mathsize="0.900em">g</mi><mi mathsize="0.900em">θ</mi><mtext mathsize="0.900em">pre</mtext></msubsup><mo lspace="0em" rspace="0em">​</mo><mrow><mo maxsize="0.900em" minsize="0.900em">(</mo><msub><mi mathsize="0.900em">𝑿</mi><mi mathsize="0.900em">t</mi></msub><mo mathsize="0.900em">,</mo><mi mathsize="0.900em">t</mi><mo maxsize="0.900em" minsize="0.900em">)</mo></mrow><mo lspace="0em" rspace="0em">​</mo><mrow><mo maxsize="0.900em" minsize="0.900em">[</mo><mi mathsize="0.900em" mathvariant="normal">ℓ</mi><mo maxsize="0.900em" minsize="0.900em">]</mo></mrow></mrow></mrow></mrow><mo>)</mo></mrow><mo lspace="0em" rspace="0em">​</mo><mrow><mo mathsize="0.900em" rspace="0em">𝑑</mo><mi mathsize="0.900em">t</mi></mrow></mrow></mrow></mrow><annotation encoding="application/x-tex">\displaystyle\int_{0}^{1}\sum_{y\neq\bm{X}_{t_{u}}}(\bm{R}_{t}^{v}-\bm{R}^{0}_{t})(\bm{X}_{t},y)dt=\int_{0}^{1}\frac{\dot{\alpha}_{t}}{1-\alpha_{t}}\left(\sum_{\ell}g^{v}(\bm{X}_{t},t)[\ell]-\sum_{\ell}g_{\theta}^{\text{pre}}(\bm{X}_{t},t)[\ell]\right)dt</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td>
<td rowspan="1" class="ltx_eqn_cell ltx_eqn_eqno ltx_align_middle ltx_align_right"><span class="ltx_tag ltx_tag_equation ltx_align_right">(119)</span></td></tr></tbody>
</table>
</div>
<div id="S9.SS8.p16" class="ltx_para ltx_noindent">
<p id="S9.SS8.p16.1" class="ltx_p">Putting these terms together, we get the final form of the log RND between any-length path measures:
<span id="S9.SS8.p16.1.1" class="ltx_text"></span></p>
<table id="S9.EGx113" class="ltx_equationgroup ltx_eqn_align ltx_eqn_table">

<tbody id="S9.Ex57"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_eqn_cell"></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="S9.Ex57.m1" class="ltx_math_unparsed" alttext="\displaystyle\log\frac{\mathrm{d}\mathbb{P}^{0}}{\mathrm{d}\mathbb{P}^{v}}(\bm{X}_{0:1})=\sum_{t_{u}:\bm{X}_{t_{u}}\neq\bm{X}_{t_{u}-}}\sum_{\ell:\bm{X}^{\ell}_{t_{u}-}\neq\bm{X}^{\ell}_{t_{u}}}\log\frac{f^{\text{pre}}(\bm{X}_{t_{u}},t)[\ell,\bm{v}]}{f^{v}(\bm{X}_{t_{u}},t)[\ell,\bm{v}]}" display="inline" intent=":literal"><semantics><mrow><mi mathsize="0.900em">log</mi><mstyle displaystyle="true"><mfrac><mrow><mi mathsize="0.900em">d</mi><mo lspace="0em" rspace="0em">​</mo><msup><mi mathsize="0.900em">ℙ</mi><mn mathsize="0.900em">0</mn></msup></mrow><mrow><mi mathsize="0.900em">d</mi><mo lspace="0em" rspace="0em">​</mo><msup><mi mathsize="0.900em">ℙ</mi><mi mathsize="0.900em">v</mi></msup></mrow></mfrac></mstyle><mrow><mo maxsize="0.900em" minsize="0.900em">(</mo><msub><mi mathsize="0.900em">𝑿</mi><mrow><mn mathsize="0.900em">0</mn><mo lspace="0.278em" mathsize="0.900em" rspace="0.278em">:</mo><mn mathsize="0.900em">1</mn></mrow></msub><mo maxsize="0.900em" minsize="0.900em">)</mo></mrow><mo mathsize="0.900em">=</mo><mstyle displaystyle="true"><munder><mo maxsize="0.900em" minsize="0.900em" movablelimits="false" stretchy="true">∑</mo><mrow><msub><mi mathsize="0.900em">t</mi><mi mathsize="0.900em">u</mi></msub><mo lspace="0.278em" mathsize="0.900em" rspace="0.278em">:</mo><mrow><msub><mi mathsize="0.900em">𝑿</mi><msub><mi mathsize="0.900em">t</mi><mi mathsize="0.900em">u</mi></msub></msub><mo mathsize="0.900em">≠</mo><msub><mi mathsize="0.900em">𝑿</mi><mrow><msub><mi mathsize="0.900em">t</mi><mi mathsize="0.900em">u</mi></msub><mo mathsize="0.900em">−</mo></mrow></msub></mrow></mrow></munder></mstyle><mstyle displaystyle="true"><munder><mo maxsize="0.900em" minsize="0.900em" movablelimits="false" stretchy="true">∑</mo><mrow><mi mathsize="0.900em" mathvariant="normal">ℓ</mi><mo lspace="0.278em" mathsize="0.900em" rspace="0.278em">:</mo><mrow><msubsup><mi mathsize="0.900em">𝑿</mi><mrow><msub><mi mathsize="0.900em">t</mi><mi mathsize="0.900em">u</mi></msub><mo mathsize="0.900em">−</mo></mrow><mi mathsize="0.900em" mathvariant="normal">ℓ</mi></msubsup><mo mathsize="0.900em">≠</mo><msubsup><mi mathsize="0.900em">𝑿</mi><msub><mi mathsize="0.900em">t</mi><mi mathsize="0.900em">u</mi></msub><mi mathsize="0.900em" mathvariant="normal">ℓ</mi></msubsup></mrow></mrow></munder></mstyle><mi mathsize="0.900em">log</mi><mstyle displaystyle="true"><mfrac><mrow><msup><mi mathsize="0.900em">f</mi><mtext mathsize="0.900em">pre</mtext></msup><mo lspace="0em" rspace="0em">​</mo><mrow><mo maxsize="0.900em" minsize="0.900em">(</mo><msub><mi mathsize="0.900em">𝑿</mi><msub><mi mathsize="0.900em">t</mi><mi mathsize="0.900em">u</mi></msub></msub><mo mathsize="0.900em">,</mo><mi mathsize="0.900em">t</mi><mo maxsize="0.900em" minsize="0.900em">)</mo></mrow><mo lspace="0em" rspace="0em">​</mo><mrow><mo maxsize="0.900em" minsize="0.900em">[</mo><mrow><mi mathsize="0.900em" mathvariant="normal">ℓ</mi><mo mathsize="0.900em">,</mo><mi mathsize="0.900em">𝒗</mi></mrow><mo maxsize="0.900em" minsize="0.900em">]</mo></mrow></mrow><mrow><msup><mi mathsize="0.900em">f</mi><mi mathsize="0.900em">v</mi></msup><mo lspace="0em" rspace="0em">​</mo><mrow><mo maxsize="0.900em" minsize="0.900em">(</mo><msub><mi mathsize="0.900em">𝑿</mi><msub><mi mathsize="0.900em">t</mi><mi mathsize="0.900em">u</mi></msub></msub><mo mathsize="0.900em">,</mo><mi mathsize="0.900em">t</mi><mo maxsize="0.900em" minsize="0.900em">)</mo></mrow><mo lspace="0em" rspace="0em">​</mo><mrow><mo maxsize="0.900em" minsize="0.900em">[</mo><mrow><mi mathsize="0.900em" mathvariant="normal">ℓ</mi><mo mathsize="0.900em">,</mo><mi mathsize="0.900em">𝒗</mi></mrow><mo maxsize="0.900em" minsize="0.900em">]</mo></mrow></mrow></mfrac></mstyle></mrow><annotation encoding="application/x-tex">\displaystyle\log\frac{\mathrm{d}\mathbb{P}^{0}}{\mathrm{d}\mathbb{P}^{v}}(\bm{X}_{0:1})=\sum_{t_{u}:\bm{X}_{t_{u}}\neq\bm{X}_{t_{u}-}}\sum_{\ell:\bm{X}^{\ell}_{t_{u}-}\neq\bm{X}^{\ell}_{t_{u}}}\log\frac{f^{\text{pre}}(\bm{X}_{t_{u}},t)[\ell,\bm{v}]}{f^{v}(\bm{X}_{t_{u}},t)[\ell,\bm{v}]}</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
<tbody id="S9.E120"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_eqn_cell"></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="S9.E120.m1" class="ltx_math_unparsed" alttext="\displaystyle+\sum_{t_{i}:\bm{X}_{t_{i}}\neq\bm{X}_{t_{i}-}}\sum_{\ell:\bm{X}_{t_{i}}=\bm{X}^{\triangleleft_{\ell}\bm{M}}_{t_{i}^{-}}}\log\frac{g_{\theta}^{\text{pre}}(\bm{X}_{t_{i}},t_{i})[\ell]}{g^{v}(\bm{X}_{t_{i}},t_{i})[\ell]}+\int_{0}^{1}\frac{\dot{\alpha}_{t}}{1-\alpha_{t}}\left(\sum_{\ell}g^{v}(\bm{X}_{t},t)[\ell]-\sum_{\ell}g^{\text{pre}}(\bm{X}_{t},t)[\ell]\right)dt" display="inline" intent=":literal"><semantics><mrow><mo mathsize="0.900em">+</mo><mstyle displaystyle="true"><munder><mo maxsize="0.900em" minsize="0.900em" movablelimits="false" stretchy="true">∑</mo><mrow><msub><mi mathsize="0.900em">t</mi><mi mathsize="0.900em">i</mi></msub><mo lspace="0.278em" mathsize="0.900em" rspace="0.278em">:</mo><mrow><msub><mi mathsize="0.900em">𝑿</mi><msub><mi mathsize="0.900em">t</mi><mi mathsize="0.900em">i</mi></msub></msub><mo mathsize="0.900em">≠</mo><msub><mi mathsize="0.900em">𝑿</mi><mrow><msub><mi mathsize="0.900em">t</mi><mi mathsize="0.900em">i</mi></msub><mo mathsize="0.900em">−</mo></mrow></msub></mrow></mrow></munder></mstyle><mstyle displaystyle="true"><munder><mo maxsize="0.900em" minsize="0.900em" movablelimits="false" stretchy="true">∑</mo><mrow><mi mathsize="0.900em" mathvariant="normal">ℓ</mi><mo lspace="0.278em" mathsize="0.900em" rspace="0.278em">:</mo><mi mathsize="0.900em">𝑿</mi><msub><mrow></mrow><msub><mi mathsize="0.900em">t</mi><mi mathsize="0.900em">i</mi></msub></msub><mo mathsize="0.900em">=</mo><mi mathsize="0.900em">𝑿</mi><msup><mrow></mrow><mrow><mo mathsize="0.900em" rspace="0.222em">⊲</mo><msub><mrow></mrow><mi mathsize="0.900em" mathvariant="normal">ℓ</mi></msub><mi mathsize="0.900em">𝑴</mi></mrow></msup><msub><mrow></mrow><msubsup><mi mathsize="0.900em">t</mi><mi mathsize="0.900em">i</mi><mo mathsize="0.900em">−</mo></msubsup></msub></mrow></munder></mstyle><mi mathsize="0.900em">log</mi><mstyle displaystyle="true"><mfrac><mrow><msubsup><mi mathsize="0.900em">g</mi><mi mathsize="0.900em">θ</mi><mtext mathsize="0.900em">pre</mtext></msubsup><mo lspace="0em" rspace="0em">​</mo><mrow><mo maxsize="0.900em" minsize="0.900em">(</mo><msub><mi mathsize="0.900em">𝑿</mi><msub><mi mathsize="0.900em">t</mi><mi mathsize="0.900em">i</mi></msub></msub><mo mathsize="0.900em">,</mo><msub><mi mathsize="0.900em">t</mi><mi mathsize="0.900em">i</mi></msub><mo maxsize="0.900em" minsize="0.900em">)</mo></mrow><mo lspace="0em" rspace="0em">​</mo><mrow><mo maxsize="0.900em" minsize="0.900em">[</mo><mi mathsize="0.900em" mathvariant="normal">ℓ</mi><mo maxsize="0.900em" minsize="0.900em">]</mo></mrow></mrow><mrow><msup><mi mathsize="0.900em">g</mi><mi mathsize="0.900em">v</mi></msup><mo lspace="0em" rspace="0em">​</mo><mrow><mo maxsize="0.900em" minsize="0.900em">(</mo><msub><mi mathsize="0.900em">𝑿</mi><msub><mi mathsize="0.900em">t</mi><mi mathsize="0.900em">i</mi></msub></msub><mo mathsize="0.900em">,</mo><msub><mi mathsize="0.900em">t</mi><mi mathsize="0.900em">i</mi></msub><mo maxsize="0.900em" minsize="0.900em">)</mo></mrow><mo lspace="0em" rspace="0em">​</mo><mrow><mo maxsize="0.900em" minsize="0.900em">[</mo><mi mathsize="0.900em" mathvariant="normal">ℓ</mi><mo maxsize="0.900em" minsize="0.900em">]</mo></mrow></mrow></mfrac></mstyle><mo mathsize="0.900em">+</mo><mstyle displaystyle="true"><msubsup><mo maxsize="0.900em" minsize="0.900em" stretchy="true">∫</mo><mn mathsize="0.900em">0</mn><mn mathsize="0.900em">1</mn></msubsup></mstyle><mstyle displaystyle="true"><mfrac><msub><mover accent="true"><mi mathsize="0.900em">α</mi><mo>˙</mo></mover><mi mathsize="0.900em">t</mi></msub><mrow><mn mathsize="0.900em">1</mn><mo mathsize="0.900em">−</mo><msub><mi mathsize="0.900em">α</mi><mi mathsize="0.900em">t</mi></msub></mrow></mfrac></mstyle><mrow><mo>(</mo><mstyle displaystyle="true"><munder><mo maxsize="0.900em" minsize="0.900em" movablelimits="false" stretchy="true">∑</mo><mi mathsize="0.900em" mathvariant="normal">ℓ</mi></munder></mstyle><msup><mi mathsize="0.900em">g</mi><mi mathsize="0.900em">v</mi></msup><mrow><mo maxsize="0.900em" minsize="0.900em">(</mo><msub><mi mathsize="0.900em">𝑿</mi><mi mathsize="0.900em">t</mi></msub><mo mathsize="0.900em">,</mo><mi mathsize="0.900em">t</mi><mo maxsize="0.900em" minsize="0.900em">)</mo></mrow><mrow><mo maxsize="0.900em" minsize="0.900em">[</mo><mi mathsize="0.900em" mathvariant="normal">ℓ</mi><mo maxsize="0.900em" minsize="0.900em">]</mo></mrow><mo mathsize="0.900em">−</mo><mstyle displaystyle="true"><munder><mo maxsize="0.900em" minsize="0.900em" movablelimits="false" stretchy="true">∑</mo><mi mathsize="0.900em" mathvariant="normal">ℓ</mi></munder></mstyle><msup><mi mathsize="0.900em">g</mi><mtext mathsize="0.900em">pre</mtext></msup><mrow><mo maxsize="0.900em" minsize="0.900em">(</mo><msub><mi mathsize="0.900em">𝑿</mi><mi mathsize="0.900em">t</mi></msub><mo mathsize="0.900em">,</mo><mi mathsize="0.900em">t</mi><mo maxsize="0.900em" minsize="0.900em">)</mo></mrow><mrow><mo maxsize="0.900em" minsize="0.900em">[</mo><mi mathsize="0.900em" mathvariant="normal">ℓ</mi><mo maxsize="0.900em" minsize="0.900em">]</mo></mrow><mo>)</mo></mrow><mi mathsize="0.900em">d</mi><mi mathsize="0.900em">t</mi></mrow><annotation encoding="application/x-tex">\displaystyle+\sum_{t_{i}:\bm{X}_{t_{i}}\neq\bm{X}_{t_{i}-}}\sum_{\ell:\bm{X}_{t_{i}}=\bm{X}^{\triangleleft_{\ell}\bm{M}}_{t_{i}^{-}}}\log\frac{g_{\theta}^{\text{pre}}(\bm{X}_{t_{i}},t_{i})[\ell]}{g^{v}(\bm{X}_{t_{i}},t_{i})[\ell]}+\int_{0}^{1}\frac{\dot{\alpha}_{t}}{1-\alpha_{t}}\left(\sum_{\ell}g^{v}(\bm{X}_{t},t)[\ell]-\sum_{\ell}g^{\text{pre}}(\bm{X}_{t},t)[\ell]\right)dt</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td>
<td rowspan="1" class="ltx_eqn_cell ltx_eqn_eqno ltx_align_middle ltx_align_right"><span class="ltx_tag ltx_tag_equation ltx_align_right">(120)</span></td></tr></tbody>
</table>
<p id="S9.SS8.p16.2" class="ltx_p">Finally, substituting the result from Lemma <a href="#S9.Thmlemma4" title="Lemma 9.4 (Radon-Nikodym Derivative Between Optimal and Base Path Measures). ‣ 9.8 Adaptive Joint Decoding Loss ‣ 9 Theoretical Proofs ‣ A2D2: Fine-Tuning Any-Length Discrete Diffusion for Adaptive Decoding" class="ltx_ref"><span class="ltx_text ltx_ref_tag">9.4</span></a> and (<a href="#S9.E120" title="Equation 120 ‣ 9.8 Adaptive Joint Decoding Loss ‣ 9 Theoretical Proofs ‣ A2D2: Fine-Tuning Any-Length Discrete Diffusion for Adaptive Decoding" class="ltx_ref"><span class="ltx_text ltx_ref_tag">120</span></a>) into (<a href="#S9.E110" title="Equation 110 ‣ 9.8 Adaptive Joint Decoding Loss ‣ 9 Theoretical Proofs ‣ A2D2: Fine-Tuning Any-Length Discrete Diffusion for Adaptive Decoding" class="ltx_ref"><span class="ltx_text ltx_ref_tag">110</span></a>), we get:
<span id="S9.SS8.p16.2.1" class="ltx_text"></span></p>
<table id="S9.EGx114" class="ltx_equationgroup ltx_eqn_align ltx_eqn_table">

<tbody id="S9.Ex58"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_align_right ltx_eqn_cell"><math id="S9.Ex58.m1" class="ltx_math_unparsed" alttext="\displaystyle\log\frac{\mathrm{d}\mathbb{P}^{\star}}{\mathrm{d}\mathbb{P}^{v}}(\bm{X}_{0:1})" display="inline" intent=":literal"><semantics><mrow><mi mathsize="0.900em">log</mi><mstyle displaystyle="true"><mfrac><mrow><mi mathsize="0.900em">d</mi><mo lspace="0em" rspace="0em">​</mo><msup><mi mathsize="0.900em">ℙ</mi><mo mathsize="0.900em">⋆</mo></msup></mrow><mrow><mi mathsize="0.900em">d</mi><mo lspace="0em" rspace="0em">​</mo><msup><mi mathsize="0.900em">ℙ</mi><mi mathsize="0.900em">v</mi></msup></mrow></mfrac></mstyle><mrow><mo maxsize="0.900em" minsize="0.900em">(</mo><msub><mi mathsize="0.900em">𝑿</mi><mrow><mn mathsize="0.900em">0</mn><mo lspace="0.278em" mathsize="0.900em" rspace="0.278em">:</mo><mn mathsize="0.900em">1</mn></mrow></msub><mo maxsize="0.900em" minsize="0.900em">)</mo></mrow></mrow><annotation encoding="application/x-tex">\displaystyle\log\frac{\mathrm{d}\mathbb{P}^{\star}}{\mathrm{d}\mathbb{P}^{v}}(\bm{X}_{0:1})</annotation></semantics></math></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="S9.Ex58.m2" class="ltx_math_unparsed" alttext="\displaystyle=\log\frac{\mathrm{d}\mathbb{P}^{\star}}{\mathrm{d}\mathbb{P}^{0}}(\bm{X}_{0:1})+\log\frac{\mathrm{d}\mathbb{P}^{0}}{\mathrm{d}\mathbb{P}^{v}}(\bm{X}_{0:1})" display="inline" intent=":literal"><semantics><mrow><mo mathsize="0.900em">=</mo><mi mathsize="0.900em">log</mi><mstyle displaystyle="true"><mfrac><mrow><mi mathsize="0.900em">d</mi><mo lspace="0em" rspace="0em">​</mo><msup><mi mathsize="0.900em">ℙ</mi><mo mathsize="0.900em">⋆</mo></msup></mrow><mrow><mi mathsize="0.900em">d</mi><mo lspace="0em" rspace="0em">​</mo><msup><mi mathsize="0.900em">ℙ</mi><mn mathsize="0.900em">0</mn></msup></mrow></mfrac></mstyle><mrow><mo maxsize="0.900em" minsize="0.900em">(</mo><msub><mi mathsize="0.900em">𝑿</mi><mrow><mn mathsize="0.900em">0</mn><mo lspace="0.278em" mathsize="0.900em" rspace="0.278em">:</mo><mn mathsize="0.900em">1</mn></mrow></msub><mo maxsize="0.900em" minsize="0.900em">)</mo></mrow><mo mathsize="0.900em">+</mo><mi mathsize="0.900em">log</mi><mstyle displaystyle="true"><mfrac><mrow><mi mathsize="0.900em">d</mi><mo lspace="0em" rspace="0em">​</mo><msup><mi mathsize="0.900em">ℙ</mi><mn mathsize="0.900em">0</mn></msup></mrow><mrow><mi mathsize="0.900em">d</mi><mo lspace="0em" rspace="0em">​</mo><msup><mi mathsize="0.900em">ℙ</mi><mi mathsize="0.900em">v</mi></msup></mrow></mfrac></mstyle><mrow><mo maxsize="0.900em" minsize="0.900em">(</mo><msub><mi mathsize="0.900em">𝑿</mi><mrow><mn mathsize="0.900em">0</mn><mo lspace="0.278em" mathsize="0.900em" rspace="0.278em">:</mo><mn mathsize="0.900em">1</mn></mrow></msub><mo maxsize="0.900em" minsize="0.900em">)</mo></mrow></mrow><annotation encoding="application/x-tex">\displaystyle=\log\frac{\mathrm{d}\mathbb{P}^{\star}}{\mathrm{d}\mathbb{P}^{0}}(\bm{X}_{0:1})+\log\frac{\mathrm{d}\mathbb{P}^{0}}{\mathrm{d}\mathbb{P}^{v}}(\bm{X}_{0:1})</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
<tbody id="S9.Ex59"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_eqn_cell"></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="S9.Ex59.m1" class="ltx_math_unparsed" alttext="\displaystyle=\frac{r(\bm{X}_{1})}{\alpha}-\log Z+\sum_{t_{u}:\bm{X}_{t_{u}}\neq\bm{X}_{t_{u}-}}\sum_{\ell:\bm{X}^{\ell}_{t_{u}}\neq\bm{X}^{\ell}_{t_{u}^{-}}}\log\frac{f^{\text{pre}}(\bm{X}_{t_{u}},t)[\ell,\bm{v}]}{f^{v}(\bm{X}_{t_{u}},t)[\ell,\bm{v}]}" display="inline" intent=":literal"><semantics><mrow><mo mathsize="0.900em">=</mo><mstyle displaystyle="true"><mfrac><mrow><mi mathsize="0.900em">r</mi><mo>⁡</mo><mrow><mo maxsize="0.900em" minsize="0.900em">(</mo><msub><mi mathsize="0.900em">𝑿</mi><mn mathsize="0.900em">1</mn></msub><mo maxsize="0.900em" minsize="0.900em">)</mo></mrow></mrow><mi mathsize="0.900em">α</mi></mfrac></mstyle><mo mathsize="0.900em">−</mo><mi mathsize="0.900em">log</mi><mi mathsize="0.900em">Z</mi><mo mathsize="0.900em">+</mo><mstyle displaystyle="true"><mo maxsize="0.900em" minsize="0.900em" movablelimits="false" stretchy="true">∑</mo></mstyle><msub><mrow></mrow><mrow><msub><mi mathsize="0.900em">t</mi><mi mathsize="0.900em">u</mi></msub><mo lspace="0.278em" mathsize="0.900em" rspace="0.278em">:</mo><mrow><msub><mi mathsize="0.900em">𝑿</mi><msub><mi mathsize="0.900em">t</mi><mi mathsize="0.900em">u</mi></msub></msub><mo mathsize="0.900em">≠</mo><msub><mi mathsize="0.900em">𝑿</mi><mrow><msub><mi mathsize="0.900em">t</mi><mi mathsize="0.900em">u</mi></msub><mo mathsize="0.900em">−</mo></mrow></msub></mrow></mrow></msub><mstyle displaystyle="true"><mo maxsize="0.900em" minsize="0.900em" movablelimits="false" stretchy="true">∑</mo></mstyle><msub><mrow></mrow><mrow><mi mathsize="0.900em" mathvariant="normal">ℓ</mi><mo lspace="0.278em" mathsize="0.900em" rspace="0.278em">:</mo><mrow><msubsup><mi mathsize="0.900em">𝑿</mi><msub><mi mathsize="0.900em">t</mi><mi mathsize="0.900em">u</mi></msub><mi mathsize="0.900em" mathvariant="normal">ℓ</mi></msubsup><mo mathsize="0.900em">≠</mo><msubsup><mi mathsize="0.900em">𝑿</mi><msubsup><mi mathsize="0.900em">t</mi><mi mathsize="0.900em">u</mi><mo mathsize="0.900em">−</mo></msubsup><mi mathsize="0.900em" mathvariant="normal">ℓ</mi></msubsup></mrow></mrow></msub><mi mathsize="0.900em">log</mi><mstyle displaystyle="true"><mfrac><mrow><msup><mi mathsize="0.900em">f</mi><mtext mathsize="0.900em">pre</mtext></msup><mo lspace="0em" rspace="0em">​</mo><mrow><mo maxsize="0.900em" minsize="0.900em">(</mo><msub><mi mathsize="0.900em">𝑿</mi><msub><mi mathsize="0.900em">t</mi><mi mathsize="0.900em">u</mi></msub></msub><mo mathsize="0.900em">,</mo><mi mathsize="0.900em">t</mi><mo maxsize="0.900em" minsize="0.900em">)</mo></mrow><mo lspace="0em" rspace="0em">​</mo><mrow><mo maxsize="0.900em" minsize="0.900em">[</mo><mrow><mi mathsize="0.900em" mathvariant="normal">ℓ</mi><mo mathsize="0.900em">,</mo><mi mathsize="0.900em">𝒗</mi></mrow><mo maxsize="0.900em" minsize="0.900em">]</mo></mrow></mrow><mrow><msup><mi mathsize="0.900em">f</mi><mi mathsize="0.900em">v</mi></msup><mo lspace="0em" rspace="0em">​</mo><mrow><mo maxsize="0.900em" minsize="0.900em">(</mo><msub><mi mathsize="0.900em">𝑿</mi><msub><mi mathsize="0.900em">t</mi><mi mathsize="0.900em">u</mi></msub></msub><mo mathsize="0.900em">,</mo><mi mathsize="0.900em">t</mi><mo maxsize="0.900em" minsize="0.900em">)</mo></mrow><mo lspace="0em" rspace="0em">​</mo><mrow><mo maxsize="0.900em" minsize="0.900em">[</mo><mrow><mi mathsize="0.900em" mathvariant="normal">ℓ</mi><mo mathsize="0.900em">,</mo><mi mathsize="0.900em">𝒗</mi></mrow><mo maxsize="0.900em" minsize="0.900em">]</mo></mrow></mrow></mfrac></mstyle></mrow><annotation encoding="application/x-tex">\displaystyle=\frac{r(\bm{X}_{1})}{\alpha}-\log Z+\sum_{t_{u}:\bm{X}_{t_{u}}\neq\bm{X}_{t_{u}-}}\sum_{\ell:\bm{X}^{\ell}_{t_{u}}\neq\bm{X}^{\ell}_{t_{u}^{-}}}\log\frac{f^{\text{pre}}(\bm{X}_{t_{u}},t)[\ell,\bm{v}]}{f^{v}(\bm{X}_{t_{u}},t)[\ell,\bm{v}]}</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
<tbody id="S9.Ex60"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
