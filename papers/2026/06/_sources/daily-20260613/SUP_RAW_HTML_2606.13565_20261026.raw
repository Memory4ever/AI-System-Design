<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="S9.Ex60.m1" class="ltx_math_unparsed" alttext="\displaystyle+\sum_{t_{i}:\bm{X}_{t_{i}}\neq\bm{X}_{t_{i}-}}\sum_{\ell:\bm{X}_{t_{i}}=\bm{X}^{\triangleleft_{\ell}\bm{M}}_{t_{i}^{-}}}\log\frac{g_{\theta}^{\text{pre}}(\bm{X}_{t_{i}},t_{i})[\ell]}{g^{v}(\bm{X}_{t_{i}},t_{i})[\ell]}" display="inline" intent=":literal"><semantics><mrow><mo mathsize="0.900em">+</mo><mstyle displaystyle="true"><mo maxsize="0.900em" minsize="0.900em" movablelimits="false" stretchy="true">∑</mo></mstyle><msub><mrow></mrow><mrow><msub><mi mathsize="0.900em">t</mi><mi mathsize="0.900em">i</mi></msub><mo lspace="0.278em" mathsize="0.900em" rspace="0.278em">:</mo><mrow><msub><mi mathsize="0.900em">𝑿</mi><msub><mi mathsize="0.900em">t</mi><mi mathsize="0.900em">i</mi></msub></msub><mo mathsize="0.900em">≠</mo><msub><mi mathsize="0.900em">𝑿</mi><mrow><msub><mi mathsize="0.900em">t</mi><mi mathsize="0.900em">i</mi></msub><mo mathsize="0.900em">−</mo></mrow></msub></mrow></mrow></msub><mstyle displaystyle="true"><mo maxsize="0.900em" minsize="0.900em" movablelimits="false" stretchy="true">∑</mo></mstyle><msub><mrow></mrow><mrow><mi mathsize="0.900em" mathvariant="normal">ℓ</mi><mo lspace="0.278em" mathsize="0.900em" rspace="0.278em">:</mo><mi mathsize="0.900em">𝑿</mi><msub><mrow></mrow><msub><mi mathsize="0.900em">t</mi><mi mathsize="0.900em">i</mi></msub></msub><mo mathsize="0.900em">=</mo><mi mathsize="0.900em">𝑿</mi><msup><mrow></mrow><mrow><mo mathsize="0.900em" rspace="0.222em">⊲</mo><msub><mrow></mrow><mi mathsize="0.900em" mathvariant="normal">ℓ</mi></msub><mi mathsize="0.900em">𝑴</mi></mrow></msup><msub><mrow></mrow><msubsup><mi mathsize="0.900em">t</mi><mi mathsize="0.900em">i</mi><mo mathsize="0.900em">−</mo></msubsup></msub></mrow></msub><mi mathsize="0.900em">log</mi><mstyle displaystyle="true"><mfrac><mrow><msubsup><mi mathsize="0.900em">g</mi><mi mathsize="0.900em">θ</mi><mtext mathsize="0.900em">pre</mtext></msubsup><mo lspace="0em" rspace="0em">​</mo><mrow><mo maxsize="0.900em" minsize="0.900em">(</mo><msub><mi mathsize="0.900em">𝑿</mi><msub><mi mathsize="0.900em">t</mi><mi mathsize="0.900em">i</mi></msub></msub><mo mathsize="0.900em">,</mo><msub><mi mathsize="0.900em">t</mi><mi mathsize="0.900em">i</mi></msub><mo maxsize="0.900em" minsize="0.900em">)</mo></mrow><mo lspace="0em" rspace="0em">​</mo><mrow><mo maxsize="0.900em" minsize="0.900em">[</mo><mi mathsize="0.900em" mathvariant="normal">ℓ</mi><mo maxsize="0.900em" minsize="0.900em">]</mo></mrow></mrow><mrow><msup><mi mathsize="0.900em">g</mi><mi mathsize="0.900em">v</mi></msup><mo lspace="0em" rspace="0em">​</mo><mrow><mo maxsize="0.900em" minsize="0.900em">(</mo><msub><mi mathsize="0.900em">𝑿</mi><msub><mi mathsize="0.900em">t</mi><mi mathsize="0.900em">i</mi></msub></msub><mo mathsize="0.900em">,</mo><msub><mi mathsize="0.900em">t</mi><mi mathsize="0.900em">i</mi></msub><mo maxsize="0.900em" minsize="0.900em">)</mo></mrow><mo lspace="0em" rspace="0em">​</mo><mrow><mo maxsize="0.900em" minsize="0.900em">[</mo><mi mathsize="0.900em" mathvariant="normal">ℓ</mi><mo maxsize="0.900em" minsize="0.900em">]</mo></mrow></mrow></mfrac></mstyle></mrow><annotation encoding="application/x-tex">\displaystyle+\sum_{t_{i}:\bm{X}_{t_{i}}\neq\bm{X}_{t_{i}-}}\sum_{\ell:\bm{X}_{t_{i}}=\bm{X}^{\triangleleft_{\ell}\bm{M}}_{t_{i}^{-}}}\log\frac{g_{\theta}^{\text{pre}}(\bm{X}_{t_{i}},t_{i})[\ell]}{g^{v}(\bm{X}_{t_{i}},t_{i})[\ell]}</annotation></semantics></math></td>
