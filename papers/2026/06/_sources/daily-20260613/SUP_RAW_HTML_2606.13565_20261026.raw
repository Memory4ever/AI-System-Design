<span id="alg4.l6.3.1" class="ltx_p"><math id="alg4.l6.m1" class="ltx_Math" alttext="\texttt{remask\_scores}[\ell]\leftarrow-\mu_{\phi}^{\ell}(\tilde{\bm{x}}_{s})" display="inline" intent=":literal"><semantics><mrow><mrow><mtext class="ltx_mathvariant_monospace">remask_scores</mtext><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">[</mo><mi mathvariant="normal">ℓ</mi><mo stretchy="false">]</mo></mrow></mrow><mo stretchy="false">←</mo><mrow><mo>−</mo><mrow><msubsup><mi>μ</mi><mi>ϕ</mi><mi mathvariant="normal">ℓ</mi></msubsup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mover accent="true"><mi>𝒙</mi><mo>~</mo></mover><mi>s</mi></msub><mo stretchy="false">)</mo></mrow></mrow></mrow></mrow><annotation encoding="application/x-tex">\texttt{remask\_scores}[\ell]\leftarrow-\mu_{\phi}^{\ell}(\tilde{\bm{x}}_{s})</annotation></semantics></math><span id="alg4.l6.3.1.1" class="ltx_text" style="float:right; float:right;"><math id="alg4.l6.m2" class="ltx_Math" alttext="\triangleright" display="inline" intent=":literal"><semantics><mo style="--ltx-fg-color:#808080;" mathcolor="#808080">⊳</mo><annotation encoding="application/x-tex">\triangleright</annotation></semantics></math><span id="alg4.l6.3.1.1.1" class="ltx_text ltx_font_italic" style="--ltx-fg-color:#808080;"> lower confidence has higher probability of remask</span></span></span>
