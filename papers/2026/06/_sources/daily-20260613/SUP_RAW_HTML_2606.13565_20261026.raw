<span id="alg1.l24.3.1" class="ltx_p"><math id="alg1.l24.m1" class="ltx_Math" alttext="\mathcal{L}_{\text{AJD}}(\phi)\leftarrow\frac{1}{BR}\sum_{(\tilde{\bm{x}}_{t,i},W^{\bar{\theta},\bar{\phi}}_{i})\sim\mathcal{B}}\left[e^{W^{\bar{\theta},\bar{\phi}}}(\mathcal{L}_{\text{IQL}}(\phi;\tilde{\bm{x}}^{\text{insert}}_{s,i})+\mathcal{L}_{\text{UQL}}(\phi;\tilde{\bm{x}}_{s,i}^{\text{unmask}}))\right]" display="inline" intent=":literal"><semantics><mrow><mrow><msub><mi class="ltx_font_mathcaligraphic">ℒ</mi><mtext>AJD</mtext></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>ϕ</mi><mo stretchy="false">)</mo></mrow></mrow><mo stretchy="false">←</mo><mrow><mfrac><mn>1</mn><mrow><mi>B</mi><mo lspace="0em" rspace="0em">​</mo><mi>R</mi></mrow></mfrac><mo lspace="0em" rspace="0em">​</mo><mrow><msub><mo rspace="0em">∑</mo><mrow><mrow><mo stretchy="false">(</mo><msub><mover accent="true"><mi>𝒙</mi><mo>~</mo></mover><mrow><mi>t</mi><mo>,</mo><mi>i</mi></mrow></msub><mo>,</mo><msubsup><mi>W</mi><mi>i</mi><mrow><mover accent="true"><mi>θ</mi><mo>¯</mo></mover><mo>,</mo><mover accent="true"><mi>ϕ</mi><mo>¯</mo></mover></mrow></msubsup><mo stretchy="false">)</mo></mrow><mo>∼</mo><mi class="ltx_font_mathcaligraphic">ℬ</mi></mrow></msub><mrow><mo>[</mo><mrow><msup><mi>e</mi><msup><mi>W</mi><mrow><mover accent="true"><mi>θ</mi><mo>¯</mo></mover><mo>,</mo><mover accent="true"><mi>ϕ</mi><mo>¯</mo></mover></mrow></msup></msup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mrow><mrow><msub><mi class="ltx_font_mathcaligraphic">ℒ</mi><mtext>IQL</mtext></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>ϕ</mi><mo>,</mo><msubsup><mover accent="true"><mi>𝒙</mi><mo>~</mo></mover><mrow><mi>s</mi><mo>,</mo><mi>i</mi></mrow><mtext>insert</mtext></msubsup><mo stretchy="false">)</mo></mrow></mrow><mo>+</mo><mrow><msub><mi class="ltx_font_mathcaligraphic">ℒ</mi><mtext>UQL</mtext></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>ϕ</mi><mo>,</mo><msubsup><mover accent="true"><mi>𝒙</mi><mo>~</mo></mover><mrow><mi>s</mi><mo>,</mo><mi>i</mi></mrow><mtext>unmask</mtext></msubsup><mo stretchy="false">)</mo></mrow></mrow></mrow><mo stretchy="false">)</mo></mrow></mrow><mo>]</mo></mrow></mrow></mrow></mrow><annotation encoding="application/x-tex">\mathcal{L}_{\text{AJD}}(\phi)\leftarrow\frac{1}{BR}\sum_{(\tilde{\bm{x}}_{t,i},W^{\bar{\theta},\bar{\phi}}_{i})\sim\mathcal{B}}\left[e^{W^{\bar{\theta},\bar{\phi}}}(\mathcal{L}_{\text{IQL}}(\phi;\tilde{\bm{x}}^{\text{insert}}_{s,i})+\mathcal{L}_{\text{UQL}}(\phi;\tilde{\bm{x}}_{s,i}^{\text{unmask}}))\right]</annotation></semantics></math></span>
