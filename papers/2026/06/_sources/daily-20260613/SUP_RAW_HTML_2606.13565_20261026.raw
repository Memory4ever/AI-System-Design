<td id="S12.T6.6.1.2.2" class="ltx_td ltx_align_center ltx_border_t"><math id="S12.T6.m1" class="ltx_Math" alttext="12" display="inline" intent=":literal"><semantics><mn mathsize="0.900em">12</mn><annotation encoding="application/x-tex">12</annotation></semantics></math></td>
<td id="S12.T6.6.1.2.3" class="ltx_td ltx_nopad_r ltx_align_center ltx_border_t"><math id="S12.T6.m2" class="ltx_Math" alttext="12" display="inline" intent=":literal"><semantics><mn mathsize="0.900em">12</mn><annotation encoding="application/x-tex">12</annotation></semantics></math></td></tr>
<tr id="S12.T6.6.1.3" class="ltx_tr">
<td id="S12.T6.6.1.3.1" class="ltx_td ltx_align_left"><span id="S12.T6.6.1.3.1.1" class="ltx_text" style="font-size:90%;">Iterations Between Buffer Generation </span><math id="S12.T6.m3" class="ltx_Math" alttext="N_{\text{resample}}" display="inline" intent=":literal"><semantics><msub><mi mathsize="0.900em">N</mi><mtext mathsize="0.900em">resample</mtext></msub><annotation encoding="application/x-tex">N_{\text{resample}}</annotation></semantics></math></td>
<td id="S12.T6.6.1.3.2" class="ltx_td ltx_align_center"><math id="S12.T6.m4" class="ltx_Math" alttext="12" display="inline" intent=":literal"><semantics><mn mathsize="0.900em">12</mn><annotation encoding="application/x-tex">12</annotation></semantics></math></td>
<td id="S12.T6.6.1.3.3" class="ltx_td ltx_nopad_r ltx_align_center"><math id="S12.T6.m5" class="ltx_Math" alttext="12" display="inline" intent=":literal"><semantics><mn mathsize="0.900em">12</mn><annotation encoding="application/x-tex">12</annotation></semantics></math></td></tr>
<tr id="S12.T6.6.1.4" class="ltx_tr">
<td id="S12.T6.6.1.4.1" class="ltx_td ltx_align_left"><span id="S12.T6.6.1.4.1.1" class="ltx_text" style="font-size:90%;">Gradient Steps Per Iteration </span><math id="S12.T6.m6" class="ltx_Math" alttext="N_{\text{update}}" display="inline" intent=":literal"><semantics><msub><mi mathsize="0.900em">N</mi><mtext mathsize="0.900em">update</mtext></msub><annotation encoding="application/x-tex">N_{\text{update}}</annotation></semantics></math></td>
