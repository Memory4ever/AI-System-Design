<span id="alg3.l1.3.1" class="ltx_p"><span id="alg3.l1.3.1.1" class="ltx_text ltx_font_bold">Input:</span> Batch of clean sequences <math id="alg3.l1.m1" class="ltx_Math" alttext="\{\bm{x}_{T,i},W^{\bar{\theta},\bar{\phi}}\}_{i=1}^{B}" display="inline" intent=":literal"><semantics><msubsup><mrow><mo stretchy="false">{</mo><msub><mi>𝒙</mi><mrow><mi>T</mi><mo>,</mo><mi>i</mi></mrow></msub><mo>,</mo><msup><mi>W</mi><mrow><mover accent="true"><mi>θ</mi><mo>¯</mo></mover><mo>,</mo><mover accent="true"><mi>ϕ</mi><mo>¯</mo></mover></mrow></msup><mo stretchy="false">}</mo></mrow><mrow><mi>i</mi><mo>=</mo><mn>1</mn></mrow><mi>B</mi></msubsup><annotation encoding="application/x-tex">\{\bm{x}_{T,i},W^{\bar{\theta},\bar{\phi}}\}_{i=1}^{B}</annotation></semantics></math>, number of replicates <math id="alg3.l1.m2" class="ltx_Math" alttext="R" display="inline" intent=":literal"><semantics><mi>R</mi><annotation encoding="application/x-tex">R</annotation></semantics></math></span>
</span>
</div>
