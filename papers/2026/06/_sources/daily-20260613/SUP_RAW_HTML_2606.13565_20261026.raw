<th id="S10.T4.6.1.5.1" class="ltx_td ltx_align_left ltx_th ltx_th_row"><span id="S10.T4.6.1.5.1.1" class="ltx_text" style="font-size:90%;">Timestep conditioning dimension</span></th>
<td id="S10.T4.6.1.5.2" class="ltx_td ltx_align_center"><math id="S10.T4.m7" class="ltx_Math" alttext="128" display="inline" intent=":literal"><semantics><mn mathsize="0.900em">128</mn><annotation encoding="application/x-tex">128</annotation></semantics></math></td>
<td id="S10.T4.6.1.5.3" class="ltx_td ltx_nopad_r ltx_align_center"><math id="S10.T4.m8" class="ltx_Math" alttext="128" display="inline" intent=":literal"><semantics><mn mathsize="0.900em">128</mn><annotation encoding="application/x-tex">128</annotation></semantics></math></td></tr>
<tr id="S10.T4.6.1.6" class="ltx_tr">
<th id="S10.T4.6.1.6.1" class="ltx_td ltx_align_left ltx_th ltx_th_row"><span id="S10.T4.6.1.6.1.1" class="ltx_text" style="font-size:90%;">MLP expansion ratio</span></th>
<td id="S10.T4.6.1.6.2" class="ltx_td ltx_align_center"><math id="S10.T4.m9" class="ltx_Math" alttext="4" display="inline" intent=":literal"><semantics><mn mathsize="0.900em">4</mn><annotation encoding="application/x-tex">4</annotation></semantics></math></td>
<td id="S10.T4.6.1.6.3" class="ltx_td ltx_nopad_r ltx_align_center"><math id="S10.T4.m10" class="ltx_Math" alttext="4" display="inline" intent=":literal"><semantics><mn mathsize="0.900em">4</mn><annotation encoding="application/x-tex">4</annotation></semantics></math></td></tr>
<tr id="S10.T4.6.1.7" class="ltx_tr">
<th id="S10.T4.6.1.7.1" class="ltx_td ltx_align_left ltx_th ltx_th_row"><span id="S10.T4.6.1.7.1.1" class="ltx_text" style="font-size:90%;">Dropout</span></th>
<td id="S10.T4.6.1.7.2" class="ltx_td ltx_align_center"><math id="S10.T4.m11" class="ltx_Math" alttext="0.05" display="inline" intent=":literal"><semantics><mn mathsize="0.900em">0.05</mn><annotation encoding="application/x-tex">0.05</annotation></semantics></math></td>
<td id="S10.T4.6.1.7.3" class="ltx_td ltx_nopad_r ltx_align_center"><math id="S10.T4.m12" class="ltx_Math" alttext="0.05" display="inline" intent=":literal"><semantics><mn mathsize="0.900em">0.05</mn><annotation encoding="application/x-tex">0.05</annotation></semantics></math></td></tr>
