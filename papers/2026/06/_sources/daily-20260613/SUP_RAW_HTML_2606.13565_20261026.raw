<span id="alg2.l1.3.1" class="ltx_p"><span id="alg2.l1.3.1.1" class="ltx_text ltx_font_bold">Input:</span> Pretrained model <math id="alg2.l1.m1" class="ltx_Math" alttext="f^{\text{pre}}(\bm{x}_{t},t),g^{\text{pre}}(\bm{x}_{t},t)" display="inline" intent=":literal"><semantics><mrow><mrow><msup><mi>f</mi><mtext>pre</mtext></msup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mi>𝒙</mi><mi>t</mi></msub><mo>,</mo><mi>t</mi><mo stretchy="false">)</mo></mrow></mrow><mo>,</mo><mrow><msup><mi>g</mi><mtext>pre</mtext></msup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mi>𝒙</mi><mi>t</mi></msub><mo>,</mo><mi>t</mi><mo stretchy="false">)</mo></mrow></mrow></mrow><annotation encoding="application/x-tex">f^{\text{pre}}(\bm{x}_{t},t),g^{\text{pre}}(\bm{x}_{t},t)</annotation></semantics></math>, fine-tuned model <math id="alg2.l1.m2" class="ltx_Math" alttext="f_{\theta}(\bm{x}_{t},t),g_{\theta}(\bm{x}_{t},t)" display="inline" intent=":literal"><semantics><mrow><mrow><msub><mi>f</mi><mi>θ</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mi>𝒙</mi><mi>t</mi></msub><mo>,</mo><mi>t</mi><mo stretchy="false">)</mo></mrow></mrow><mo>,</mo><mrow><msub><mi>g</mi><mi>θ</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mi>𝒙</mi><mi>t</mi></msub><mo>,</mo><mi>t</mi><mo stretchy="false">)</mo></mrow></mrow></mrow><annotation encoding="application/x-tex">f_{\theta}(\bm{x}_{t},t),g_{\theta}(\bm{x}_{t},t)</annotation></semantics></math>, reward model <math id="alg2.l1.m3" class="ltx_Math" alttext="r:\mathcal{X}\to\mathbb{R}" display="inline" intent=":literal"><semantics><mrow><mi>r</mi><mo lspace="0.278em" rspace="0.278em">:</mo><mrow><mi class="ltx_font_mathcaligraphic">𝒳</mi><mo stretchy="false">→</mo><mi>ℝ</mi></mrow></mrow><annotation encoding="application/x-tex">r:\mathcal{X}\to\mathbb{R}</annotation></semantics></math>, reward scaling <math id="alg2.l1.m4" class="ltx_Math" alttext="\alpha" display="inline" intent=":literal"><semantics><mi>α</mi><annotation encoding="application/x-tex">\alpha</annotation></semantics></math>, sampling steps <math id="alg2.l1.m5" class="ltx_Math" alttext="N_{\text{steps}}" display="inline" intent=":literal"><semantics><msub><mi>N</mi><mtext>steps</mtext></msub><annotation encoding="application/x-tex">N_{\text{steps}}</annotation></semantics></math>, max length <math id="alg2.l1.m6" class="ltx_Math" alttext="L" display="inline" intent=":literal"><semantics><mi>L</mi><annotation encoding="application/x-tex">L</annotation></semantics></math>, tokens to remask <math id="alg2.l1.m7" class="ltx_Math" alttext="N_{\text{remask}}" display="inline" intent=":literal"><semantics><msub><mi>N</mi><mtext>remask</mtext></msub><annotation encoding="application/x-tex">N_{\text{remask}}</annotation></semantics></math></span>
