<th id="S12.T6.6.1.1.2" class="ltx_td ltx_align_center ltx_th ltx_th_column ltx_border_tt"><span id="S12.T6.6.1.1.2.1" class="ltx_text ltx_font_bold" style="font-size:90%;">GSM8K</span></th>
<th id="S12.T6.6.1.1.3" class="ltx_td ltx_nopad_r ltx_align_center ltx_th ltx_th_column ltx_border_tt"><span id="S12.T6.6.1.1.3.1" class="ltx_text ltx_font_bold" style="font-size:90%;">HumanEval-infill</span></th></tr>
