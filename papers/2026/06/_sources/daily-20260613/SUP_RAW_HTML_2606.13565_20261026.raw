<span id="alg2.l5.3.1" class="ltx_p"><math id="alg2.l5.m1" class="ltx_Math" alttext="\bm{R}^{\theta}_{t}(\bm{x}_{t},\bm{x}_{s})\leftarrow\frac{\dot{\alpha}_{t}}{1-\alpha_{t}}\cdot g_{\theta}(\bm{x}_{t},t)" display="inline" intent=":literal"><semantics><mrow><mrow><msubsup><mi>𝑹</mi><mi>t</mi><mi>θ</mi></msubsup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mi>𝒙</mi><mi>t</mi></msub><mo>,</mo><msub><mi>𝒙</mi><mi>s</mi></msub><mo stretchy="false">)</mo></mrow></mrow><mo stretchy="false">←</mo><mrow><mrow><mfrac><msub><mover accent="true"><mi>α</mi><mo>˙</mo></mover><mi>t</mi></msub><mrow><mn>1</mn><mo>−</mo><msub><mi>α</mi><mi>t</mi></msub></mrow></mfrac><mo lspace="0.222em" rspace="0.222em">⋅</mo><msub><mi>g</mi><mi>θ</mi></msub></mrow><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mi>𝒙</mi><mi>t</mi></msub><mo>,</mo><mi>t</mi><mo stretchy="false">)</mo></mrow></mrow></mrow><annotation encoding="application/x-tex">\bm{R}^{\theta}_{t}(\bm{x}_{t},\bm{x}_{s})\leftarrow\frac{\dot{\alpha}_{t}}{1-\alpha_{t}}\cdot g_{\theta}(\bm{x}_{t},t)</annotation></semantics></math><span id="alg2.l5.3.1.1" class="ltx_text" style="float:right; float:right;"><math id="alg2.l5.m2" class="ltx_Math" alttext="\triangleright" display="inline" intent=":literal"><semantics><mo style="--ltx-fg-color:#808080;" mathcolor="#808080">⊳</mo><annotation encoding="application/x-tex">\triangleright</annotation></semantics></math><span id="alg2.l5.3.1.1.1" class="ltx_text ltx_font_italic" style="--ltx-fg-color:#808080;"> Predict insertion expectation</span></span></span>
