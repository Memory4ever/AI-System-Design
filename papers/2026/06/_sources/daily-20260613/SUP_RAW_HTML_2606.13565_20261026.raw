<figure id="alg4" class="ltx_float ltx_float_algorithm ltx_framed ltx_framed_top">
<figcaption class="ltx_caption"><span class="ltx_tag ltx_tag_float"><span id="alg4.4" class="ltx_text ltx_font_bold">Algorithm 4</span> </span> <span id="alg4.5" class="ltx_text ltx_font_typewriter">ScheduleAwareRemasking</span>: Ensure the number of masked tokens after remasking matches the expected mask count by remasking low-quality tokens.</figcaption>
<div id="alg4.6" class="ltx_listing ltx_framed ltx_framed_topbottom ltx_listing">
<div id="alg4.l1" class="ltx_listingline">
            <span class="ltx_tag ltx_tag_listingline"><span id="alg4.l1.1" class="ltx_text" style="font-size:80%;">1:</span></span>
            
            
          
<span id="alg4.l1.3" class="ltx_inline-block ltx_minipage ltx_align_top" style="width:345.0pt;">
<span id="alg4.l1.3.1" class="ltx_p"><span id="alg4.l1.3.1.1" class="ltx_text ltx_font_bold">Input:</span> Draft sequence after unmasking <math id="alg4.l1.m1" class="ltx_Math" alttext="\tilde{\bm{x}}_{s}" display="inline" intent=":literal"><semantics><msub><mover accent="true"><mi>𝒙</mi><mo>~</mo></mover><mi>s</mi></msub><annotation encoding="application/x-tex">\tilde{\bm{x}}_{s}</annotation></semantics></math>, time <math id="alg4.l1.m2" class="ltx_Math" alttext="s" display="inline" intent=":literal"><semantics><mi>s</mi><annotation encoding="application/x-tex">s</annotation></semantics></math>, unmasking quality model <math id="alg4.l1.m3" class="ltx_Math" alttext="\mu_{\phi}" display="inline" intent=":literal"><semantics><msub><mi>μ</mi><mi>ϕ</mi></msub><annotation encoding="application/x-tex">\mu_{\phi}</annotation></semantics></math>, unmasked indices <math id="alg4.l1.m4" class="ltx_Math" alttext="\mathcal{M}_{t}" display="inline" intent=":literal"><semantics><msub><mi class="ltx_font_mathcaligraphic">ℳ</mi><mi>t</mi></msub><annotation encoding="application/x-tex">\mathcal{M}_{t}</annotation></semantics></math></span>
</span>
</div>
<div id="alg4.l2" class="ltx_listingline">
            <span class="ltx_tag ltx_tag_listingline"><span id="alg4.l2.1" class="ltx_text" style="font-size:80%;">2:</span></span>
            
            
          
<span id="alg4.l2.3" class="ltx_inline-block ltx_minipage ltx_align_top" style="width:345.0pt;">
<span id="alg4.l2.3.1" class="ltx_p"><math id="alg4.l2.m1" class="ltx_Math" alttext="\texttt{exp\_num\_mask}\leftarrow\texttt{interpolant.exp\_mask\_fraction}(\tilde{\bm{x}}_{s},s)" display="inline" intent=":literal"><semantics><mrow><mtext class="ltx_mathvariant_monospace">exp_num_mask</mtext><mo stretchy="false">←</mo><mrow><mtext class="ltx_mathvariant_monospace">interpolant.exp_mask_fraction</mtext><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mover accent="true"><mi>𝒙</mi><mo>~</mo></mover><mi>s</mi></msub><mo>,</mo><mi>s</mi><mo stretchy="false">)</mo></mrow></mrow></mrow><annotation encoding="application/x-tex">\texttt{exp\_num\_mask}\leftarrow\texttt{interpolant.exp\_mask\_fraction}(\tilde{\bm{x}}_{s},s)</annotation></semantics></math></span>
</span>
</div>
<div id="alg4.l3" class="ltx_listingline">
            <span class="ltx_tag ltx_tag_listingline"><span id="alg4.l3.1" class="ltx_text" style="font-size:80%;">3:</span></span>
            
            
          
<span id="alg4.l3.3" class="ltx_inline-block ltx_minipage ltx_align_top" style="width:345.0pt;">
<span id="alg4.l3.3.1" class="ltx_p"><math id="alg4.l3.m1" class="ltx_Math" alttext="\texttt{num\_mask}\leftarrow|\{\ell:\tilde{\bm{x}}^{\ell}_{s}=\bm{M}\}|" display="inline" intent=":literal"><semantics><mrow><mtext class="ltx_mathvariant_monospace">num_mask</mtext><mo stretchy="false">←</mo><mrow><mo stretchy="false">|</mo><mrow><mo stretchy="false">{</mo><mi mathvariant="normal">ℓ</mi><mo lspace="0.278em" rspace="0.278em">:</mo><mrow><msubsup><mover accent="true"><mi>𝒙</mi><mo>~</mo></mover><mi>s</mi><mi mathvariant="normal">ℓ</mi></msubsup><mo>=</mo><mi>𝑴</mi></mrow><mo stretchy="false">}</mo></mrow><mo stretchy="false">|</mo></mrow></mrow><annotation encoding="application/x-tex">\texttt{num\_mask}\leftarrow|\{\ell:\tilde{\bm{x}}^{\ell}_{s}=\bm{M}\}|</annotation></semantics></math></span>
</span>
</div>
<div id="alg4.l4" class="ltx_listingline">
            <span class="ltx_tag ltx_tag_listingline"><span id="alg4.l4.1" class="ltx_text" style="font-size:80%;">4:</span></span>
            
            
          
<span id="alg4.l4.3" class="ltx_inline-block ltx_minipage ltx_align_top" style="width:345.0pt;">
<span id="alg4.l4.3.1" class="ltx_p"><math id="alg4.l4.m1" class="ltx_Math" alttext="\texttt{mask\_to\_add}\leftarrow\max(0,\texttt{exp\_num\_mask}-\texttt{num\_mask})" display="inline" intent=":literal"><semantics><mrow><mtext class="ltx_mathvariant_monospace">mask_to_add</mtext><mo stretchy="false">←</mo><mrow><mi>max</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mn>0</mn><mo>,</mo><mrow><mtext class="ltx_mathvariant_monospace">exp_num_mask</mtext><mo>−</mo><mtext class="ltx_mathvariant_monospace">num_mask</mtext></mrow><mo stretchy="false">)</mo></mrow></mrow></mrow><annotation encoding="application/x-tex">\texttt{mask\_to\_add}\leftarrow\max(0,\texttt{exp\_num\_mask}-\texttt{num\_mask})</annotation></semantics></math></span>
</span>
</div>
<div id="alg4.l5" class="ltx_listingline">
