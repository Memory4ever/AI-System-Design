          <span id="alg1.l45.2" class="ltx_text ltx_font_bold">// Per-chunk winning configuration: keep each chunk’s highest-scoring tag</span>

</div>
<div id="alg1.l46" class="ltx_listingline">
            <span class="ltx_tag ltx_tag_listingline">46:</span>
            
            
          <span id="alg1.l46.2" class="ltx_text ltx_font_bold">for</span> each chunk <math id="alg1.l46.m1" class="ltx_Math" alttext="v" display="inline" intent=":literal"><semantics><mi>v</mi><annotation encoding="application/x-tex">v</annotation></semantics></math> appearing in <math id="alg1.l46.m2" class="ltx_Math" alttext="\mathcal{P}(q)" display="inline" intent=":literal"><semantics><mrow><mi class="ltx_font_mathcaligraphic">𝒫</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>q</mi><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">\mathcal{P}(q)</annotation></semantics></math> <span id="alg1.l46.3" class="ltx_text ltx_font_bold">do</span>

</div>
