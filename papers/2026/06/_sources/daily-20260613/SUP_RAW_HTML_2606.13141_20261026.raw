            <span class="ltx_tag ltx_tag_listingline">35:</span>
            
            
          <span id="alg1.l35.2" class="ltx_text ltx_font_bold">for</span> each <math id="alg1.l35.m1" class="ltx_Math" alttext="(m,g)\in\{\mathrm{vis},\mathrm{text}\}\times\{\mathrm{frame},\mathrm{clip}\}" display="inline" intent=":literal"><semantics><mrow><mrow><mo stretchy="false">(</mo><mi>m</mi><mo>,</mo><mi>g</mi><mo stretchy="false">)</mo></mrow><mo>∈</mo><mrow><mrow><mo stretchy="false">{</mo><mi>vis</mi><mo>,</mo><mi>text</mi><mo rspace="0.055em" stretchy="false">}</mo></mrow><mo rspace="0.222em">×</mo><mrow><mo stretchy="false">{</mo><mi>frame</mi><mo>,</mo><mi>clip</mi><mo stretchy="false">}</mo></mrow></mrow></mrow><annotation encoding="application/x-tex">(m,g)\in\{\mathrm{vis},\mathrm{text}\}\times\{\mathrm{frame},\mathrm{clip}\}</annotation></semantics></math> <span id="alg1.l35.3" class="ltx_text ltx_font_bold">do</span>

</div>
