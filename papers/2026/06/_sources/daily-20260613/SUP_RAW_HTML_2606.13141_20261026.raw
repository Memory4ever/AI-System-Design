<div id="alg1.l32" class="ltx_listingline">
            <span class="ltx_tag ltx_tag_listingline">32:</span>
            
            
          <span id="alg1.l32.2" class="ltx_text ltx_font_bold">// Stage 1: Parallel candidate pooling — one query embedding, four index shards</span>

</div>
<div id="alg1.l33" class="ltx_listingline">
            <span class="ltx_tag ltx_tag_listingline">33:</span>
            
            
          Compute <math id="alg1.l33.m1" class="ltx_Math" alttext="f(q)" display="inline" intent=":literal"><semantics><mrow><mi>f</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>q</mi><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">f(q)</annotation></semantics></math> once

</div>
<div id="alg1.l34" class="ltx_listingline">
            <span class="ltx_tag ltx_tag_listingline">34:</span>
            
            
          <math id="alg1.l34.m1" class="ltx_Math" alttext="\mathcal{P}(q)\leftarrow\emptyset" display="inline" intent=":literal"><semantics><mrow><mrow><mi class="ltx_font_mathcaligraphic">𝒫</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>q</mi><mo stretchy="false">)</mo></mrow></mrow><mo stretchy="false">←</mo><mi mathvariant="normal">∅</mi></mrow><annotation encoding="application/x-tex">\mathcal{P}(q)\leftarrow\emptyset</annotation></semantics></math> <span id="alg1.l34.2" class="ltx_text" style="float:right;"><math id="alg1.l34.m2" class="ltx_Math" alttext="\triangleright" display="inline" intent=":literal"><semantics><mo>⊳</mo><annotation encoding="application/x-tex">\triangleright</annotation></semantics></math> configuration-tagged candidate pool
</span>
</div>
