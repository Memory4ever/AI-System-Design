          <span id="alg1.l40.2" class="ltx_text ltx_font_bold">// Stage 2: Chunk-adaptive reranking — score each candidate under the tag that surfaced it</span>

</div>
<div id="alg1.l41" class="ltx_listingline">
            <span class="ltx_tag ltx_tag_listingline">41:</span>
            
            
          <span id="alg1.l41.2" class="ltx_text ltx_font_bold">for</span> each <math id="alg1.l41.m1" class="ltx_Math" alttext="(v,\,(m,g))\in\mathcal{P}(q)" display="inline" intent=":literal"><semantics><mrow><mrow><mo stretchy="false">(</mo><mi>v</mi><mo>,</mo><mrow><mo stretchy="false">(</mo><mi>m</mi><mo>,</mo><mi>g</mi><mo stretchy="false">)</mo></mrow><mo stretchy="false">)</mo></mrow><mo>∈</mo><mrow><mi class="ltx_font_mathcaligraphic">𝒫</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>q</mi><mo stretchy="false">)</mo></mrow></mrow></mrow><annotation encoding="application/x-tex">(v,\,(m,g))\in\mathcal{P}(q)</annotation></semantics></math> <span id="alg1.l41.3" class="ltx_text ltx_font_bold">do</span>

</div>
<div id="alg1.l42" class="ltx_listingline">
            <span class="ltx_tag ltx_tag_listingline">42:</span>
            
            
            <math id="alg1.l42.m1" class="ltx_Math" alttext="\tilde{s}\big(q;\,(v,(m,g))\big)\leftarrow\mathrm{CE}\!\left(q,\,\phi_{m,g}(v)\right)" display="inline" intent=":literal"><semantics><mrow><mrow><mover accent="true"><mi>s</mi><mo>~</mo></mover><mo lspace="0em" rspace="0em">​</mo><mrow><mo maxsize="1.200em" minsize="1.200em">(</mo><mi>q</mi><mo>,</mo><mrow><mo stretchy="false">(</mo><mi>v</mi><mo>,</mo><mrow><mo stretchy="false">(</mo><mi>m</mi><mo>,</mo><mi>g</mi><mo stretchy="false">)</mo></mrow><mo stretchy="false">)</mo></mrow><mo maxsize="1.200em" minsize="1.200em">)</mo></mrow></mrow><mo stretchy="false">←</mo><mrow><mpadded style="width:1.412em;" width="1.412em"><mi>CE</mi></mpadded><mo>⁡</mo><mrow><mo>(</mo><mi>q</mi><mo>,</mo><mrow><msub><mi>ϕ</mi><mrow><mi>m</mi><mo>,</mo><mi>g</mi></mrow></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>v</mi><mo stretchy="false">)</mo></mrow></mrow><mo>)</mo></mrow></mrow></mrow><annotation encoding="application/x-tex">\tilde{s}\big(q;\,(v,(m,g))\big)\leftarrow\mathrm{CE}\!\left(q,\,\phi_{m,g}(v)\right)</annotation></semantics></math>
