            <math id="alg1.l37.m1" class="ltx_Math" alttext="\mathcal{P}(q)\leftarrow\mathcal{P}(q)\cup\big\{\,(v,\,(m,g)):v\in C_{(m,g)}(q)\,\big\}" display="inline" intent=":literal"><semantics><mrow><mrow><mi class="ltx_font_mathcaligraphic">𝒫</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>q</mi><mo stretchy="false">)</mo></mrow></mrow><mo stretchy="false">←</mo><mrow><mrow><mi class="ltx_font_mathcaligraphic">𝒫</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>q</mi><mo stretchy="false">)</mo></mrow></mrow><mo>∪</mo><mrow><mo rspace="0.170em" stretchy="false">{</mo><mrow><mo stretchy="false">(</mo><mi>v</mi><mo rspace="0.337em">,</mo><mrow><mo stretchy="false">(</mo><mi>m</mi><mo>,</mo><mi>g</mi><mo stretchy="false">)</mo></mrow><mo rspace="0.278em" stretchy="false">)</mo></mrow><mo rspace="0.278em">:</mo><mrow><mi>v</mi><mo>∈</mo><mrow><msub><mi>C</mi><mrow><mo stretchy="false">(</mo><mi>m</mi><mo>,</mo><mi>g</mi><mo stretchy="false">)</mo></mrow></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>q</mi><mo rspace="0.170em" stretchy="false">)</mo></mrow></mrow></mrow><mo stretchy="false">}</mo></mrow></mrow></mrow><annotation encoding="application/x-tex">\mathcal{P}(q)\leftarrow\mathcal{P}(q)\cup\big\{\,(v,\,(m,g)):v\in C_{(m,g)}(q)\,\big\}</annotation></semantics></math>
<span id="alg1.l37.2" class="ltx_text" style="float:right;"><math id="alg1.l37.m2" class="ltx_Math" alttext="\triangleright" display="inline" intent=":literal"><semantics><mo>⊳</mo><annotation encoding="application/x-tex">\triangleright</annotation></semantics></math> cf. Eq. (<a href="#S5.E3" title="In 5 CARVE: Chunk-Aware Reranking for Video Evidence ‣ Rethinking RAG in Long Videos: What to Retrieve and How to Use It?" class="ltx_ref"><span class="ltx_text ltx_ref_tag">3</span></a>)
