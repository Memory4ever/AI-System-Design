<div id="A3.T10.2" class="ltx_inline-block ltx_align_center ltx_transformed_outer" style="width:345.0pt;height:65.5pt;vertical-align:-30.1pt;"><span class="ltx_transformed_inner" style="transform:translate(11.4pt,-2.2pt) scale(1.07073308632351,1.07073308632351) ;">
