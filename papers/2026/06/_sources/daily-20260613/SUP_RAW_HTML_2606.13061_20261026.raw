<td id="A2.T8.2.1.3.4" class="ltx_td ltx_align_center" style="padding:0.5pt 10.0pt;"><span id="A2.T8.2.1.3.4.1" class="ltx_text ltx_font_bold" style="--ltx-bg-color:#FFF0EB;">72.1</span></td>
<td id="A2.T8.2.1.3.5" class="ltx_td ltx_align_center" style="padding:0.5pt 10.0pt;"><span id="A2.T8.2.1.3.5.1" class="ltx_text ltx_font_bold" style="--ltx-bg-color:#FFF0EB;">64.4</span></td></tr>
<tr id="A2.T8.2.1.4" class="ltx_tr">
