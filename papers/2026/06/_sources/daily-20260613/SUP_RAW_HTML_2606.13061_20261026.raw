<td id="A2.T8.2.1.4.2" class="ltx_td ltx_align_center" style="padding:0.5pt 10.0pt;">68.4</td>
<td id="A2.T8.2.1.4.3" class="ltx_td ltx_align_center" style="padding:0.5pt 10.0pt;">43.5</td>
<td id="A2.T8.2.1.4.4" class="ltx_td ltx_align_center" style="padding:0.5pt 10.0pt;">71.4</td>
<td id="A2.T8.2.1.4.5" class="ltx_td ltx_align_center" style="padding:0.5pt 10.0pt;">63.7</td></tr>
