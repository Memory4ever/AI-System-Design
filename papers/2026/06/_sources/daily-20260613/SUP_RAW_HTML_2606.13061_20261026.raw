<th id="A2.T8.2.1.5.1" class="ltx_td ltx_align_left ltx_th ltx_th_row ltx_border_bb" style="padding:0.5pt 10.0pt;">Chain-of-Thought</th>
<td id="A2.T8.2.1.5.2" class="ltx_td ltx_align_center ltx_border_bb" style="padding:0.5pt 10.0pt;">68.4</td>
<td id="A2.T8.2.1.5.3" class="ltx_td ltx_align_center ltx_border_bb" style="padding:0.5pt 10.0pt;">44.1</td>
<td id="A2.T8.2.1.5.4" class="ltx_td ltx_align_center ltx_border_bb" style="padding:0.5pt 10.0pt;">71.4</td>
