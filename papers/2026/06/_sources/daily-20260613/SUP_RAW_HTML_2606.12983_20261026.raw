<article class="ltx_document ltx_authors_1line ltx_leqno">
<h1 class="ltx_title ltx_title_document">Structured Testbench Generation for LLM-Driven HDL Design and Verification-Oriented Data Curation</h1>
<span class="ltx_pubnotes ltx_pubnotes_meta"><span class="ltx_pubnotes_content"><span class="ltx_pubnote ltx_role_doi"><span class="ltx_note_name">DOI: </span><a href="https://doi.org/XXXXXXX.XXXXXXX">XXXXXXX.XXXXXXX</a></span><span class="ltx_pubnote ltx_role_isbn"><span class="ltx_note_name">ISBN: </span>XXX-X-XXXX-XXXX-X/2026/07</span></span></span>
<div class="ltx_authors">
<span class="ltx_creator ltx_role_author">
<span class="ltx_personname">En-Ming Huang<sup id="id1" class="ltx_sup"><span id="id1.1" class="ltx_text ltx_font_italic">1</span></sup>, Yu-Hung Kao<sup id="id2" class="ltx_sup"><span id="id2.1" class="ltx_text ltx_font_italic">1</span></sup>, Ren-Hao Deng<sup id="id3" class="ltx_sup"><span id="id3.1" class="ltx_text ltx_font_italic">1</span></sup>, Wei-Po Hsin<sup id="id4" class="ltx_sup"><span id="id4.1" class="ltx_text ltx_font_italic">1</span></sup>,
Yao-Ting Hsieh<sup id="id5" class="ltx_sup"><span id="id5.1" class="ltx_text ltx_font_italic">2</span></sup>, Cheng Liang<sup id="id6" class="ltx_sup"><span id="id6.1" class="ltx_text ltx_font_italic">1</span></sup>, Hsiang-Yu Tsou<sup id="id7" class="ltx_sup"><span id="id7.1" class="ltx_text ltx_font_italic">1</span></sup>, Mu-Chi Chen<sup id="id8" class="ltx_sup"><span id="id8.1" class="ltx_text ltx_font_italic">1</span></sup>,
Yu-Kai Hung<sup id="id9" class="ltx_sup"><span id="id9.1" class="ltx_text ltx_font_italic">1</span></sup>, Shao-Chun Ho<sup id="id10" class="ltx_sup"><span id="id10.1" class="ltx_text ltx_font_italic">1</span></sup>, Po-Hsuang Huang<sup id="id11" class="ltx_sup"><span id="id11.1" class="ltx_text ltx_font_italic">1</span></sup>, Shih-Hao Hung<sup id="id12" class="ltx_sup"><span id="id12.1" class="ltx_text ltx_font_italic">1</span></sup>,
H.T. Kung<sup id="id13" class="ltx_sup"><span id="id13.1" class="ltx_text ltx_font_italic">3</span></sup>
