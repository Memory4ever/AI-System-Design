<tr id="A1.T5.2.4" class="ltx_tr">
<td id="A1.T5.2.4.1" class="ltx_td ltx_align_left">AdamW</td>
<td id="A1.T5.2.4.2" class="ltx_td ltx_align_left">Weight decay (2D params)</td>
<td id="A1.T5.2.4.3" class="ltx_td ltx_align_left"><math id="A1.T5.m3" class="ltx_Math" alttext="0.1" display="inline" intent=":literal"><semantics><mn>0.1</mn><annotation encoding="application/x-tex">0.1</annotation></semantics></math></td></tr>
<tr id="A1.T5.2.5" class="ltx_tr">
<td id="A1.T5.2.5.1" class="ltx_td ltx_align_left">AdamW</td>
<td id="A1.T5.2.5.2" class="ltx_td ltx_align_left">Weight decay (1D params)</td>
<td id="A1.T5.2.5.3" class="ltx_td ltx_align_left"><math id="A1.T5.m4" class="ltx_Math" alttext="0" display="inline" intent=":literal"><semantics><mn>0</mn><annotation encoding="application/x-tex">0</annotation></semantics></math></td></tr>
<tr id="A1.T5.2.6" class="ltx_tr">
<td id="A1.T5.2.6.1" class="ltx_td ltx_align_left">Muon (unconstrained)</td>
<td id="A1.T5.2.6.2" class="ltx_td ltx_align_left">Weight decay</td>
<td id="A1.T5.2.6.3" class="ltx_td ltx_align_left"><math id="A1.T5.m5" class="ltx_Math" alttext="0.1" display="inline" intent=":literal"><semantics><mn>0.1</mn><annotation encoding="application/x-tex">0.1</annotation></semantics></math></td></tr>
<tr id="A1.T5.2.7" class="ltx_tr">
<td id="A1.T5.2.7.1" class="ltx_td ltx_align_left">Manifold Muon</td>
<td id="A1.T5.2.7.2" class="ltx_td ltx_align_left">Weight decay</td>
<td id="A1.T5.2.7.3" class="ltx_td ltx_align_left">Not applied to manifold-managed weights</td></tr>
<tr id="A1.T5.2.8" class="ltx_tr">
<td id="A1.T5.2.8.1" class="ltx_td ltx_align_left">Muon / Manifold Muon</td>
<td id="A1.T5.2.8.2" class="ltx_td ltx_align_left">Peak learning rate</td>
<td id="A1.T5.2.8.3" class="ltx_td ltx_align_left"><math id="A1.T5.m6" class="ltx_Math" alttext="0.02" display="inline" intent=":literal"><semantics><mn>0.02</mn><annotation encoding="application/x-tex">0.02</annotation></semantics></math></td></tr>
<tr id="A1.T5.2.9" class="ltx_tr">
<td id="A1.T5.2.9.1" class="ltx_td ltx_align_left">Muon / Manifold Muon</td>
