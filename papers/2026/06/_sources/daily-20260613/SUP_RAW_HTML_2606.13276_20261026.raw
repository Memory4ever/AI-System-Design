<td id="A1.T4.2.4.1" class="ltx_td ltx_align_left">Other 2D parameters</td>
<td id="A1.T4.2.4.2" class="ltx_td ltx_align_left">Embeddings, LM head, etc.</td>
<td id="A1.T4.2.4.3" class="ltx_td ltx_align_left">AdamW with weight decay</td></tr>
<tr id="A1.T4.2.5" class="ltx_tr">
<td id="A1.T4.2.5.1" class="ltx_td ltx_align_left ltx_border_bb">1D parameters</td>
<td id="A1.T4.2.5.2" class="ltx_td ltx_align_left ltx_border_bb">LayerNorm, scales, etc.</td>
<td id="A1.T4.2.5.3" class="ltx_td ltx_align_left ltx_border_bb">AdamW without weight decay</td></tr>
