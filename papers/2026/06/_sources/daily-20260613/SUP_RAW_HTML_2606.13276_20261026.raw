</thead>
<tbody class="ltx_tbody">
<tr id="A1.T5.2.2" class="ltx_tr">
<td id="A1.T5.2.2.1" class="ltx_td ltx_align_left ltx_border_t">AdamW</td>
<td id="A1.T5.2.2.2" class="ltx_td ltx_align_left ltx_border_t">Peak learning rate</td>
<td id="A1.T5.2.2.3" class="ltx_td ltx_align_left ltx_border_t"><math id="A1.T5.m1" class="ltx_Math" alttext="6\times 10^{-4}" display="inline" intent=":literal"><semantics><mrow><mn>6</mn><mo lspace="0.222em" rspace="0.222em">×</mo><msup><mn>10</mn><mrow><mo>−</mo><mn>4</mn></mrow></msup></mrow><annotation encoding="application/x-tex">6\times 10^{-4}</annotation></semantics></math></td></tr>
