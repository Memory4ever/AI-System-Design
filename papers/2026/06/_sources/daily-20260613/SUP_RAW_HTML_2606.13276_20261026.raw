<td id="A1.T3.2.1.2" class="ltx_td ltx_align_left ltx_border_tt">Value</td></tr>
<tr id="A1.T3.2.2" class="ltx_tr">
<th id="A1.T3.2.2.1" class="ltx_td ltx_align_left ltx_th ltx_th_row ltx_border_t">Training iterations</th>
<td id="A1.T3.2.2.2" class="ltx_td ltx_align_left ltx_border_t">50,000</td></tr>
<tr id="A1.T3.2.3" class="ltx_tr">
<th id="A1.T3.2.3.1" class="ltx_td ltx_align_left ltx_th ltx_th_row">Batch size</th>
<td id="A1.T3.2.3.2" class="ltx_td ltx_align_left">64</td></tr>
<tr id="A1.T3.2.4" class="ltx_tr">
<th id="A1.T3.2.4.1" class="ltx_td ltx_align_left ltx_th ltx_th_row">Gradient accumulation steps</th>
<td id="A1.T3.2.4.2" class="ltx_td ltx_align_left">1</td></tr>
<tr id="A1.T3.2.5" class="ltx_tr">
<th id="A1.T3.2.5.1" class="ltx_td ltx_align_left ltx_th ltx_th_row">Tokens per optimization step</th>
<td id="A1.T3.2.5.2" class="ltx_td ltx_align_left">65,536</td></tr>
<tr id="A1.T3.2.6" class="ltx_tr">
<th id="A1.T3.2.6.1" class="ltx_td ltx_align_left ltx_th ltx_th_row">Evaluation interval</th>
