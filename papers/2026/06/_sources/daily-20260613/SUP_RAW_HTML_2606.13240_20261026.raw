</figure></div><div class="ltx_flex_cell ltx_flex_size_2">
<figure id="A4.F13.sf2" class="ltx_figure ltx_figure_panel ltx_align_center"><img src="2606.13240v1/correlation_many_iterations.png" id="A4.F13.sf2.g1" class="ltx_graphics ltx_centering ltx_img_square" style="aspect-ratio:476/476;" width="476" height="476" alt="Refer to caption">
