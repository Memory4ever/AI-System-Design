</figure></div><div class="ltx_flex_break"></div><div class="ltx_flex_cell ltx_flex_size_1"><span class="ltx_inline-block"><svg id="A6.F12.pic5" class="ltx_picture ltx_centering ltx_figure_panel" height="21.52" overflow="visible" version="1.1" viewBox="0 0 364.43 21.52" width="364.43"><g style="--ltx-stroke-color:#000000;--ltx-fill-color:#000000;" fill="#000000" stroke="#000000" stroke-width="0.4pt" transform="translate(0,21.52) matrix(1 0 0 -1 0 0) translate(0.28,0) translate(0,5.59)"><g style="--ltx-stroke-color:#B3B3FF;--ltx-fill-color:#B3B3FF;--ltx-fg-color:#B3B3FF;" color="#B3B3FF" fill="#B3B3FF" stroke="#B3B3FF"><path style="stroke:none" d="M 0 0 M 0 0 L 0 10.33 L 14.76 10.33 L 14.76 0 Z M 14.76 10.33"></path></g><g style="--ltx-stroke-color:#6666FF;--ltx-fill-color:#6666FF;--ltx-fg-color:#6666FF;" color="#6666FF" fill="#6666FF" stroke="#6666FF"><path style="fill:none" d="M 0 0 M 0 0 L 0 10.33 L 14.76 10.33 L 14.76 0 Z M 14.76 10.33"></path></g><g style="--ltx-stroke-color:#000000;--ltx-fill-color:#000000;" fill="#000000" stroke="#000000" transform="matrix(1.0 0.0 0.0 1.0 22.61 0.44)"><foreignObject style="--ltx-fo-width:2.07em;--ltx-fo-height:0.68em;--ltx-fo-depth:0em;font-size:10pt;" height="9.46" overflow="visible" transform="matrix(1 0 0 -1 0 9.46)" width="28.64"><span class="ltx_foreignobject_container"><span class="ltx_foreignobject_content"><span id="A6.F12.pic5.1" class="ltx_text">Rate</span></span></span></foreignObject></g><g style="--ltx-stroke-color:#CCFFCC;--ltx-fill-color:#CCFFCC;--ltx-fg-color:#CCFFCC;" color="#CCFFCC" fill="#CCFFCC" stroke="#CCFFCC"><path style="stroke:none" d="M 59.06 0 M 59.06 0 L 59.06 10.33 L 73.82 10.33 L 73.82 0 Z M 73.82 10.33"></path></g><g style="--ltx-stroke-color:#009900;--ltx-fill-color:#009900;--ltx-fg-color:#009900;" color="#009900" fill="#009900" stroke="#009900"><path style="fill:none" d="M 59.06 0 M 59.06 0 L 59.06 10.33 L 73.82 10.33 L 73.82 0 Z M 73.82 10.33"></path></g><g style="--ltx-stroke-color:#000000;--ltx-fill-color:#000000;" fill="#000000" stroke="#000000" transform="matrix(1.0 0.0 0.0 1.0 81.66 1.79)"><foreignObject style="--ltx-fo-width:4.77em;--ltx-fo-height:0.68em;--ltx-fo-depth:0em;font-size:10pt;" height="9.46" overflow="visible" transform="matrix(1 0 0 -1 0 9.46)" width="66.03"><span class="ltx_foreignobject_container"><span class="ltx_foreignobject_content"><span id="A6.F12.pic5.2" class="ltx_text">Distortion <math id="A6.F12.pic5.m1" class="ltx_Math" alttext="D_{i}{=}\mu" display="inline" intent=":literal"><semantics><mrow><msub><mi>D</mi><mi>i</mi></msub><mo>=</mo><mi>μ</mi></mrow><annotation encoding="application/x-tex">D_{i}{=}\mu</annotation></semantics></math></span></span></span></foreignObject></g><g style="--ltx-stroke-color:#FFFFFF;--ltx-fill-color:#FFFFFF;--ltx-fg-color:#FFFFFF;" color="#FFFFFF" fill="#FFFFFF" stroke="#FFFFFF"><path style="stroke:none" d="M 162.4 0 M 162.4 0 L 162.4 10.33 L 177.17 10.33 L 177.17 0 Z M 177.17 10.33"></path></g><defs><pattern id="pgfupat28" href="#pgfpat3"><g style="--ltx-stroke-color:#008000;--ltx-fill-color:#008000;" fill="#008000" stroke="#008000"><use href="#pgfsym3"></use></g></pattern></defs><g style="--ltx-fill-color:#000000;" fill="#000000"><path style="stroke:none" d="M 162.4 0 M 162.4 0 L 162.4 10.33 L 177.17 10.33 L 177.17 0 Z M 177.17 10.33"></path></g><g style="--ltx-stroke-color:#009900;--ltx-fill-color:#009900;--ltx-fg-color:#009900;" color="#009900" fill="#009900" stroke="#009900"><path style="fill:none" d="M 162.4 0 M 162.4 0 L 162.4 10.33 L 177.17 10.33 L 177.17 0 Z M 177.17 10.33"></path></g><g style="--ltx-stroke-color:#000000;--ltx-fill-color:#000000;" fill="#000000" stroke="#000000" transform="matrix(1.0 0.0 0.0 1.0 185.01 1.4)"><foreignObject style="--ltx-fo-width:3.83em;--ltx-fo-height:0.68em;--ltx-fo-depth:0em;font-size:10pt;" height="9.46" overflow="visible" transform="matrix(1 0 0 -1 0 9.46)" width="53.04"><span class="ltx_foreignobject_container"><span class="ltx_foreignobject_content"><span id="A6.F12.pic5.3" class="ltx_text">Inactive <math id="A6.F12.pic5.m2" class="ltx_Math" alttext="D_{i}{=}\lambda_{i}" display="inline" intent=":literal"><semantics><mrow><msub><mi>D</mi><mi>i</mi></msub><mo>=</mo><msub><mi>λ</mi><mi>i</mi></msub></mrow><annotation encoding="application/x-tex">D_{i}{=}\lambda_{i}</annotation></semantics></math></span></span></span></foreignObject></g><g style="--ltx-stroke-color:#B30000;--ltx-fill-color:#B30000;--ltx-fg-color:#B30000;" color="#B30000" fill="#B30000" stroke="#B30000" stroke-dasharray="3.0pt,3.0pt" stroke-dashoffset="0.0pt" stroke-width="0.4pt"><path style="fill:none" d="M 265.75 5.17 L 280.51 5.17"></path></g><g style="--ltx-stroke-color:#B30000;--ltx-fill-color:#B30000;--ltx-fg-color:#B30000;" color="#B30000" fill="#B30000" stroke="#B30000" transform="matrix(1.0 0.0 0.0 1.0 286.88 1.71)"><foreignObject style="--ltx-fg-color:#000000;--ltx-fo-width:5.25em;--ltx-fo-height:0.69em;--ltx-fo-depth:0.19em;font-size:10pt;" color="#000000" height="12.3" overflow="visible" transform="matrix(1 0 0 -1 0 9.61)" width="72.66"><span class="ltx_foreignobject_container"><span class="ltx_foreignobject_content"><math id="A6.F12.pic5.m3" class="ltx_Math" alttext="\mu_{1}" display="inline" intent=":literal"><semantics><msub><mi style="--ltx-fg-color:#B30000;" mathcolor="#B30000">μ</mi><mn style="--ltx-fg-color:#B30000;" mathcolor="#B30000">1</mn></msub><annotation encoding="application/x-tex">\mu_{1}</annotation></semantics></math><span id="A6.F12.pic5.4" class="ltx_text" style="--ltx-fg-color:#B30000;"> reference</span></span></span></foreignObject></g></g></svg></span></div></div>
<figcaption class="ltx_caption ltx_centering"><span class="ltx_tag ltx_tag_figure">Figure 12: </span>Successive refinement under reverse water-filling: case (b) and case (c)</figcaption>
</figure>
<div id="A6.SS2.p8" class="ltx_para ltx_noindent">
<p id="A6.SS2.p8.1" class="ltx_p"><span id="A6.SS2.p8.1.1" class="ltx_text ltx_font_bold">Step 2: Lifting to <math id="A6.SS2.p8.m1" class="ltx_Math" alttext="\bm{\mathsf{W}}" display="inline" intent=":literal"><semantics><mi>𝖶</mi><annotation encoding="application/x-tex">\bm{\mathsf{W}}</annotation></semantics></math> under
<math id="A6.SS2.p8.m2" class="ltx_Math" alttext="d_{\mathrm{WMSE}}" display="inline" intent=":literal"><semantics><msub><mi>d</mi><mi>WMSE</mi></msub><annotation encoding="application/x-tex">d_{\mathrm{WMSE}}</annotation></semantics></math>.</span>
By Theorem <a href="#Thmtheorem3" title="Theorem 3 (WMSE Rate-Distortion Equivalence). ‣ F.1 Rate-Distortion Under Weighted MSE ‣ Appendix F Proofs of Auxiliary Results ‣ Multi-Bitwidth Quantization for LLMs Using Additive Codebooks" class="ltx_ref"><span class="ltx_text ltx_ref_tag">3</span></a>, for each <math id="A6.SS2.p8.m3" class="ltx_Math" alttext="k" display="inline" intent=":literal"><semantics><mi>k</mi><annotation encoding="application/x-tex">k</annotation></semantics></math> the distortion
equivalence</p>
<table id="A6.Ex72" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="A6.Ex72.m1" class="ltx_Math" alttext="d_{\mathrm{WMSE}}(\bm{\mathsf{W}},\widehat{\bm{\mathsf{W}}}^{(k)})\;=\;\mathbb{E}\!\left[\|\bm{\mathsf{Y}}-\widehat{\bm{\mathsf{Y}}}^{(k)}\|_{F}^{2}\right]" display="block" intent=":literal"><semantics><mrow><mrow><msub><mi>d</mi><mi>WMSE</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>𝗪</mi><mo>,</mo><msup><mover accent="true"><mi>𝗪</mi><mo>^</mo></mover><mrow><mo stretchy="false">(</mo><mi>k</mi><mo stretchy="false">)</mo></mrow></msup><mo rspace="0.280em" stretchy="false">)</mo></mrow></mrow><mo rspace="0.558em">=</mo><mrow><mpadded style="width:0.497em;" width="0.497em"><mi>𝔼</mi></mpadded><mo>⁡</mo><mrow><mo>[</mo><msubsup><mrow><mo stretchy="false">‖</mo><mrow><mi>𝗬</mi><mo>−</mo><msup><mover accent="true"><mi>𝗬</mi><mo>^</mo></mover><mrow><mo stretchy="false">(</mo><mi>k</mi><mo stretchy="false">)</mo></mrow></msup></mrow><mo stretchy="false">‖</mo></mrow><mi>F</mi><mn>2</mn></msubsup><mo>]</mo></mrow></mrow></mrow><annotation encoding="application/x-tex">d_{\mathrm{WMSE}}(\bm{\mathsf{W}},\widehat{\bm{\mathsf{W}}}^{(k)})\;=\;\mathbb{E}\!\left[\|\bm{\mathsf{Y}}-\widehat{\bm{\mathsf{Y}}}^{(k)}\|_{F}^{2}\right]</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="A6.SS2.p8.2" class="ltx_p">holds, and the optimal <math id="A6.SS2.p8.m4" class="ltx_Math" alttext="\widehat{\bm{\mathsf{W}}}^{(k)}" display="inline" intent=":literal"><semantics><msup><mover accent="true"><mi>𝗪</mi><mo>^</mo></mover><mrow><mo stretchy="false">(</mo><mi>k</mi><mo stretchy="false">)</mo></mrow></msup><annotation encoding="application/x-tex">\widehat{\bm{\mathsf{W}}}^{(k)}</annotation></semantics></math> is
recovered from <math id="A6.SS2.p8.m5" class="ltx_Math" alttext="\widehat{\bm{\mathsf{Y}}}^{(k)}" display="inline" intent=":literal"><semantics><msup><mover accent="true"><mi>𝗬</mi><mo>^</mo></mover><mrow><mo stretchy="false">(</mo><mi>k</mi><mo stretchy="false">)</mo></mrow></msup><annotation encoding="application/x-tex">\widehat{\bm{\mathsf{Y}}}^{(k)}</annotation></semantics></math> by inverting
<math id="A6.SS2.p8.m6" class="ltx_Math" alttext="\bm{\mathsf{Y}}=\bm{\mathsf{W}}\bm{X}" display="inline" intent=":literal"><semantics><mrow><mi>𝗬</mi><mo>=</mo><mrow><mi>𝗪</mi><mo lspace="0em" rspace="0em">​</mo><mi>𝑿</mi></mrow></mrow><annotation encoding="application/x-tex">\bm{\mathsf{Y}}=\bm{\mathsf{W}}\bm{X}</annotation></semantics></math>
as detailed in the three cases of Theorem <a href="#Thmtheorem3" title="Theorem 3 (WMSE Rate-Distortion Equivalence). ‣ F.1 Rate-Distortion Under Weighted MSE ‣ Appendix F Proofs of Auxiliary Results ‣ Multi-Bitwidth Quantization for LLMs Using Additive Codebooks" class="ltx_ref"><span class="ltx_text ltx_ref_tag">3</span></a>. Since
<math id="A6.SS2.p8.m7" class="ltx_Math" alttext="\bm{X}" display="inline" intent=":literal"><semantics><mi>𝑿</mi><annotation encoding="application/x-tex">\bm{X}</annotation></semantics></math> is fixed, both the forward map
<math id="A6.SS2.p8.m8" class="ltx_Math" alttext="\bm{\mathsf{W}}\mapsto\bm{\mathsf{Y}}" display="inline" intent=":literal"><semantics><mrow><mi>𝗪</mi><mo stretchy="false">↦</mo><mi>𝗬</mi></mrow><annotation encoding="application/x-tex">\bm{\mathsf{W}}\mapsto\bm{\mathsf{Y}}</annotation></semantics></math> and the
inversion map <math id="A6.SS2.p8.m9" class="ltx_Math" alttext="\widehat{\bm{\mathsf{Y}}}^{(k)}\mapsto\widehat{\bm{\mathsf{W}}}^{(k)}" display="inline" intent=":literal"><semantics><mrow><msup><mover accent="true"><mi>𝗬</mi><mo>^</mo></mover><mrow><mo stretchy="false">(</mo><mi>k</mi><mo stretchy="false">)</mo></mrow></msup><mo stretchy="false">↦</mo><msup><mover accent="true"><mi>𝗪</mi><mo>^</mo></mover><mrow><mo stretchy="false">(</mo><mi>k</mi><mo stretchy="false">)</mo></mrow></msup></mrow><annotation encoding="application/x-tex">\widehat{\bm{\mathsf{Y}}}^{(k)}\mapsto\widehat{\bm{\mathsf{W}}}^{(k)}</annotation></semantics></math> are independent of <math id="A6.SS2.p8.m10" class="ltx_Math" alttext="k" display="inline" intent=":literal"><semantics><mi>k</mi><annotation encoding="application/x-tex">k</annotation></semantics></math>. The
Markov chain established in Step 1 therefore carries over directly:</p>
<table id="A6.Ex73" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="A6.Ex73.m1" class="ltx_Math" alttext="\widehat{\bm{\mathsf{W}}}^{(1)}\;\to\;\widehat{\bm{\mathsf{W}}}^{(2)}\;\to\;\cdots\;\to\;\widehat{\bm{\mathsf{W}}}^{(K)}\;\to\;\bm{\mathsf{W}}." display="block" intent=":literal"><semantics><mrow><mrow><msup><mover accent="true"><mi>𝗪</mi><mo>^</mo></mover><mrow><mo stretchy="false">(</mo><mn>1</mn><mo stretchy="false">)</mo></mrow></msup><mo lspace="0.558em" rspace="0.558em" stretchy="false">→</mo><msup><mover accent="true"><mi>𝗪</mi><mo>^</mo></mover><mrow><mo stretchy="false">(</mo><mn>2</mn><mo stretchy="false">)</mo></mrow></msup><mo stretchy="false">→</mo><mo>⋯</mo><mo rspace="0.558em" stretchy="false">→</mo><msup><mover accent="true"><mi>𝗪</mi><mo>^</mo></mover><mrow><mo stretchy="false">(</mo><mi>K</mi><mo stretchy="false">)</mo></mrow></msup><mo rspace="0.558em" stretchy="false">→</mo><mi>𝗪</mi></mrow><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">\widehat{\bm{\mathsf{W}}}^{(1)}\;\to\;\widehat{\bm{\mathsf{W}}}^{(2)}\;\to\;\cdots\;\to\;\widehat{\bm{\mathsf{W}}}^{(K)}\;\to\;\bm{\mathsf{W}}.</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="A6.SS2.p8.3" class="ltx_p">Hence the embedded bitstream achieving <math id="A6.SS2.p8.m11" class="ltx_Math" alttext="(R(D_{k}),D_{k})" display="inline" intent=":literal"><semantics><mrow><mo stretchy="false">(</mo><mrow><mi>R</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><msub><mi>D</mi><mi>k</mi></msub><mo stretchy="false">)</mo></mrow></mrow><mo>,</mo><msub><mi>D</mi><mi>k</mi></msub><mo stretchy="false">)</mo></mrow><annotation encoding="application/x-tex">(R(D_{k}),D_{k})</annotation></semantics></math> for
<math id="A6.SS2.p8.m12" class="ltx_Math" alttext="\bm{\mathsf{y}}" display="inline" intent=":literal"><semantics><mi>𝘆</mi><annotation encoding="application/x-tex">\bm{\mathsf{y}}</annotation></semantics></math> under MSE induces, via the inversion map,
an embedded bitstream achieving <math id="A6.SS2.p8.m13" class="ltx_Math" alttext="(R(D_{k}),D_{k})" display="inline" intent=":literal"><semantics><mrow><mo stretchy="false">(</mo><mrow><mi>R</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><msub><mi>D</mi><mi>k</mi></msub><mo stretchy="false">)</mo></mrow></mrow><mo>,</mo><msub><mi>D</mi><mi>k</mi></msub><mo stretchy="false">)</mo></mrow><annotation encoding="application/x-tex">(R(D_{k}),D_{k})</annotation></semantics></math> for
<math id="A6.SS2.p8.m14" class="ltx_Math" alttext="\bm{\mathsf{W}}" display="inline" intent=":literal"><semantics><mi>𝗪</mi><annotation encoding="application/x-tex">\bm{\mathsf{W}}</annotation></semantics></math> under <math id="A6.SS2.p8.m15" class="ltx_Math" alttext="d_{\mathrm{WMSE}}" display="inline" intent=":literal"><semantics><msub><mi>d</mi><mi>WMSE</mi></msub><annotation encoding="application/x-tex">d_{\mathrm{WMSE}}</annotation></semantics></math> simultaneously
for all <math id="A6.SS2.p8.m16" class="ltx_Math" alttext="k" display="inline" intent=":literal"><semantics><mi>k</mi><annotation encoding="application/x-tex">k</annotation></semantics></math>, with no rate penalty.
∎</p>
</div>
</div>
<div class="ltx_pagination ltx_role_newpage"></div>
</section>
</section>
<section id="A7" class="ltx_appendix">
<h2 class="ltx_title ltx_title_appendix"><span class="ltx_tag ltx_tag_appendix">Appendix G </span>Algorithm 1</h2>

<section id="A7.SS0.SSS0.Px1" class="ltx_paragraph">
<h4 class="ltx_title ltx_title_paragraph">Drop-by-Drop Quantization for Resource-Constrained Inference</h4>

<div id="A7.SS0.SSS0.Px1.p1" class="ltx_para ltx_noindent">
<div id="A7.SS0.SSS0.Px1.p1.1" class="ltx_listing ltx_listing">
<div id="algx1.l1" class="ltx_listingline">
              <span class="ltx_tag ltx_tag_listingline">1:</span>
              
              
            model, data

</div>
<div id="algx1.l2" class="ltx_listingline">
              <span class="ltx_tag ltx_tag_listingline">2:</span>
              
              
            <math id="algx1.l2.m1" class="ltx_Math" alttext="X_{\text{block}}:=" display="inline" intent=":literal"><semantics><mrow><msub><mi>X</mi><mtext>block</mtext></msub><mo>:=</mo><mphantom></mphantom></mrow><annotation encoding="application/x-tex">X_{\text{block}}:=</annotation></semantics></math> model.input_embeddings(data)

</div>
<div id="algx1.l3" class="ltx_listingline">
              <span class="ltx_tag ltx_tag_listingline">3:</span>
              
              
            <span id="algx1.l3.2" class="ltx_text ltx_font_bold">for</span> <math id="algx1.l3.m1" class="ltx_Math" alttext="i=1,\dotsc,\texttt{model.num\_layers}" display="inline" intent=":literal"><semantics><mrow><mrow><mi>i</mi><mo>=</mo><mn>1</mn></mrow><mo>,</mo><mi mathvariant="normal">…</mi><mo>,</mo><mtext class="ltx_mathvariant_monospace">model.num_layers</mtext></mrow><annotation encoding="application/x-tex">i=1,\dotsc,\texttt{model.num\_layers}</annotation></semantics></math> <span id="algx1.l3.3" class="ltx_text ltx_font_bold">do</span>

</div>
<div id="algx1.l4" class="ltx_listingline">
              <span class="ltx_tag ltx_tag_listingline">4:</span>
              
              
              block := model.get_block(<math id="algx1.l4.m1" class="ltx_Math" alttext="i" display="inline" intent=":literal"><semantics><mi>i</mi><annotation encoding="application/x-tex">i</annotation></semantics></math>)

</div>
<div id="algx1.l5" class="ltx_listingline">
              <span class="ltx_tag ltx_tag_listingline">5:</span>
              
              
              <math id="algx1.l5.m1" class="ltx_Math" alttext="Y_{\text{block}}:=" display="inline" intent=":literal"><semantics><mrow><msub><mi>Y</mi><mtext>block</mtext></msub><mo>:=</mo><mphantom></mphantom></mrow><annotation encoding="application/x-tex">Y_{\text{block}}:=</annotation></semantics></math> block(<math id="algx1.l5.m2" class="ltx_Math" alttext="X_{\text{block}}" display="inline" intent=":literal"><semantics><msub><mi>X</mi><mtext>block</mtext></msub><annotation encoding="application/x-tex">X_{\text{block}}</annotation></semantics></math>)

</div>
<div id="algx1.l6" class="ltx_listingline">
              <span class="ltx_tag ltx_tag_listingline">6:</span>
              
              
              <span id="algx1.l6.2" class="ltx_text ltx_font_bold">for</span> layer <math id="algx1.l6.m1" class="ltx_Math" alttext="\in" display="inline" intent=":literal"><semantics><mo>∈</mo><annotation encoding="application/x-tex">\in</annotation></semantics></math> linear_layers(block) <span id="algx1.l6.3" class="ltx_text ltx_font_bold">do</span>

</div>
<div id="algx1.l7" class="ltx_listingline">
              <span class="ltx_tag ltx_tag_listingline">7:</span>
              
              
               <math id="algx1.l7.m1" class="ltx_Math" alttext="W:=" display="inline" intent=":literal"><semantics><mrow><mi>W</mi><mo>:=</mo><mphantom></mphantom></mrow><annotation encoding="application/x-tex">W:=</annotation></semantics></math> layer.weight

</div>
<div id="algx1.l8" class="ltx_listingline">
              <span class="ltx_tag ltx_tag_listingline">8:</span>
              
              
