plication/x-tex">10</annotation></semantics></math></span></span></foreignObject></g><g style="--ltx-stroke-color:#000000;--ltx-fill-color:#000000;" fill="#000000" stroke="#000000" transform="matrix(1.0 0.0 0.0 1.0 -25.02 14.42)"><foreignObject style="--ltx-fo-width:1em;--ltx-fo-height:0.64em;--ltx-fo-depth:0em;font-size:10pt;" height="8.92" overflow="visible" transform="matrix(1 0 0 -1 0 8.92)" width="13.84"><span class="ltx_foreignobject_container"><span class="ltx_foreignobject_content"><math id="S6.F6.pic1.m2" class="ltx_Math" alttext="15" display="inline" intent=":literal"><semantics><mn>15</mn><annotation encoding="application/x-tex">15</annotation></semantics></math></span></span></foreignObject></g><g style="--ltx-stroke-color:#000000;--ltx-fill-color:#000000;" fill="#000000" stroke="#000000" transform="matrix(1.0 0.0 0.0 1.0 -25.02 33.31)"><foreignObject style="--ltx-fo-width:1em;--ltx-fo-height:0.64em;--ltx-fo-depth:0em;font-size:10pt;" height="8.92" overflow="visible" transform="matrix(1 0 0 -1 0 8.92)" width="13.84"><span class="ltx_foreignobject_container"><span class="ltx_foreignobject_content"><math id="S6.F6.pic1.m3" class="ltx_Math" alttext="20" display="inline" intent=":literal"><semantics><mn>20</mn><annotation encoding="application/x-tex">20</annotation></semantics></math></span></span></foreignObject></g><g style="--ltx-stroke-color:#000000;--ltx-fill-color:#000000;" fill="#000000" stroke="#000000" transform="matrix(1.0 0.0 0.0 1.0 -25.02 52.19)"><foreignObject style="--ltx-fo-width:1em;--ltx-fo-height:0.64em;--ltx-fo-depth:0em;font-size:10pt;" height="8.92" overflow="visible" transform="matrix(1 0 0 -1 0 8.92)" width="13.84"><span class="ltx_foreignobject_container"><span class="ltx_foreignobject_content"><math id="S6.F6.pic1.m4" class="ltx_Math" alttext="25" display="inline" intent=":literal"><semantics><mn>25</mn><annotation encoding="application/x-tex">25</annotation></semantics></math></span></span></foreignObject></g><g style="--ltx-stroke-color:#000000;--ltx-fill-color:#000000;" fill="#000000" stroke="#000000" transform="matrix(1.0 0.0 0.0 1.0 -25.02 71.07)"><foreignObject style="--ltx-fo-width:1em;--ltx-fo-height:0.64em;--ltx-fo-depth:0em;font-size:10pt;" height="8.92" overflow="visible" transform="matrix(1 0 0 -1 0 8.92)" width="13.84"><span class="ltx_foreignobject_container"><span class="ltx_foreignobject_content"><math id="S6.F6.pic1.m5" class="ltx_Math" alttext="30" display="inline" intent=":literal"><semantics><mn>30</mn><annotation encoding="application/x-tex">30</annotation></semantics></math></span></span></foreignObject></g><clipPath id="pgfcp1"><path d="M -6.29 0 L 69.23 0 L 69.23 75.53 L -6.29 75.53 Z"></path></clipPath><g clip-path="url(#pgfcp1)"><g stroke-width="0.8pt"><path style="fill:none" d="M 0 7.93 L 31.47 4.19 L 62.94 2.87"></path></g><g></g><g stroke-width="0.8pt"><path style="fill:none" d="M 0 64.95 L 31.47 11.56 L 62.94 2.87"></path></g><g></g><g stroke-width="0.8pt"><path style="fill:none" d="M 0 23.79 L 31.47 9.74 L 62.94 3.74"></path></g><g></g><g stroke-width="0.8pt"><path style="fill:none" d="M 0 16.01 L 31.47 7.59 L 62.94 3.02"></path></g><g></g></g><g stroke-width="0.8pt"><path d="M -2.08 5.85 h 4.15 v 4.15 h -4.15 Z"></path><path d="M 29.39 2.12 h 4.15 v 4.15 h -4.15 Z"></path><path d="M 60.86 0.79 h 4.15 v 4.15 h -4.15 Z"></path></g><g stroke-width="0.8pt"><path style="fill:none" d="M -2.08 62.88 h 4.15 v 4.15 h -4.15 Z"></path><path style="fill:none" d="M 29.39 9.48 h 4.15 v 4.15 h -4.15 Z"></path><path style="fill:none" d="M 60.86 0.79 h 4.15 v 4.15 h -4.15 Z"></path></g><g stroke-width="0.8pt"><path style="fill:none" d="M 2.08 23.79 C 2.08 24.94 1.15 25.87 0 25.87 C -1.15 25.87 -2.08 24.94 -2.08 23.79 C -2.08 22.64 -1.15 21.72 0 21.72 C 1.15 21.72 2.08 22.64 2.08 23.79 Z M 0 23.79"></path><path style="fill:none" d="M 33.55 9.74 C 33.55 10.89 32.62 11.82 31.47 11.82 C 30.32 11.82 29.39 10.89 29.39 9.74 C 29.39 8.6 30.32 7.67 31.47 7.67 C 32.62 7.67 33.55 8.6 33.55