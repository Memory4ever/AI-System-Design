F2F2;--ltx-fill-color:#E6F2F2;--ltx-fg-color:#E6F2F2;" color="#E6F2F2" fill="#E6F2F2" stroke="#E6F2F2"><path style="stroke:none" d="M 73.7 0 M 73.7 0 L 73.7 28.66 L 98.27 28.66 L 98.27 0 Z M 98.27 28.66"></path></g><g style="--ltx-stroke-color:#004D4D;--ltx-fill-color:#004D4D;--ltx-fg-color:#004D4D;" color="#004D4D" fill="#004D4D" stroke="#004D4D" stroke-width="0.8pt"><path style="fill:none" d="M 73.7 0 M 73.7 0 L 73.7 147.4 L 98.27 147.4 L 98.27 0 Z M 98.27 147.4"></path></g><g style="--ltx-stroke-color:#000000;--ltx-fill-color:#000000;" fill="#000000" stroke="#000000" transform="matrix(1.0 0.0 0.0 1.0 82.53 -13.81)"><foreignObject style="--ltx-fo-width:0.5em;--ltx-fo-height:0.64em;--ltx-fo-depth:0em;font-size:10pt;" height="8.92" overflow="visible" transform="matrix(1 0 0 -1 0 8.92)" width="6.92"><span class="ltx_foreignobject_container"><span class="ltx_foreignobject_content"><math id="S4.F4.pic2.m5" class="ltx_Math" alttext="3" display="inline" intent=":literal"><semantics><mn>3</mn><annotation encoding="application/x-tex">3</annotation></semantics></math></span></span></foreignObject></g><g style="--ltx-stroke-color:#004D4D;--ltx-fill-color:#004D4D;--ltx-fg-color:#004D4D;" color="#004D4D" fill="#004D4D" stroke="#004D4D" transform="matrix(1.0 0.0 0.0 1.0 78.85 154.37)"><foreignObject style="--ltx-fg-color:#000000;--ltx-fo-width:1.03em;--ltx-fo-height:0.69em;--ltx-fo-depth:0.15em;font-size:10pt;" color="#000000" height="11.68" overflow="visible" transform="matrix(1 0 0 -1 0 9.61)" width="14.28"><span class="ltx_foreignobject_container"><span class="ltx_foreignobject_content"><math id="S4.F4.pic2.m6" class="ltx_Math" alttext="\lambda_{3}" display="inline" intent=":literal"><semantics><msub><mi style="--ltx-fg-color:#004D4D;" mathcolor="#004D4D">λ</mi><mn style="--ltx-fg-color:#004D4D;" mathcolor="#004D4D">3</mn></msub><annotation encoding="application/x-tex">\lambda_{3}</annotation></semantics></math></span></span></foreignObject></g><g style="--ltx-stroke-color:#