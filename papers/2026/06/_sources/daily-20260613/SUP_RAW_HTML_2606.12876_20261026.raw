<p id="A4.F9.2.5" class="ltx_p ltx_align_center">Layer 0: <span id="A4.F9.2.5.1" class="ltx_text ltx_font_typewriter">0.0</span></p><img src="2606.12876v1/imgs/plots/March_1_FITTED_scaled_weight_hist_layer_5_Linear.png" id="A4.F9.g6" class="ltx_graphics ltx_centering ltx_img_landscape" style="aspect-ratio:141/79;" width="141" height="79" alt="Refer to caption">
<p id="A4.F9.2.6" class="ltx_p ltx_align_center">Layer 0: <span id="A4.F9.2.6.1" class="ltx_text ltx_font_typewriter">0.0</span></p><img src="2606.12876v1/imgs/plots/March_1_FITTED_scaled_weight_hist_layer_6_Linear.png" id="A4.F9.g7" class="ltx_graphics ltx_centering ltx_img_landscape" style="aspect-ratio:141/79;" width="141" height="79" alt="Refer to caption">
<p id="A4.F9.2.7" class="ltx_p ltx_align_center">Layer 0: <span id="A4.F9.2.7.1" class="ltx_text ltx_font_typewriter">0.0</span></p>
</div></div><div class="ltx_flex_cell ltx_flex_size_3">
<div id="A4.F9.3" class="ltx_block ltx_figure_panel ltx_minipage ltx_align_center ltx_align_top" style="width:127.2pt;"><img src="2606.12876v1/imgs/plots/March_1_FITTED_scaled_weight_hist_layer_7_Linear.png" id="A4.F9.g8" class="ltx_graphics ltx_centering ltx_img_landscape" style="aspect-ratio:141/79;" width="141" height="79" alt="Refer to caption">
