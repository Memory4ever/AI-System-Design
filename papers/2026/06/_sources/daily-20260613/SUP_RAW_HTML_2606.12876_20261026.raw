olor:#000000;" fill="#000000" stroke="#000000" transform="matrix(1.0 0.0 0.0 1.0 -7.85 85.74)"><foreignObject style="--ltx-fo-width:4.94em;--ltx-fo-height:0.6em;--ltx-fo-depth:0em;font-size:11.5pt;" height="9.49" overflow="visible" transform="matrix(1 0 0 -1 0 9.49)" width="78.64"><span class="ltx_foreignobject_container"><span class="ltx_foreignobject_content"><span id="S6.F7.pic1.5" class="ltx_text ltx_font_bold">Gemma 2B</span></span></span></foreignObject></g></g></g></g><g transform="matrix(1.0 0.0 0.0 1.0 83.69 -18.42)"><g class="ltx_nestedsvg" transform="matrix(1 0 0 1 0 0) translate(29.63,0) translate(0,18.42)"><g style="--ltx-stroke-color:#BFBFBF;--ltx-fill-color:#BFBFBF;--ltx-fg-color:#BFBFBF;" color="#BFBFBF" fill="#BFBFBF" stroke="#BFBFBF" stroke-dasharray="3.0pt,3.0pt" stroke-dashoffset="0.0pt" stroke-width="0.4pt"><path style="fill:none" d="M -6.29 0 L 69.23 0 M -6.29 21.58 L 69.23 21.58 M -6.29 43.16 L 69.23 43.16 M -6.29 64.74 L 69.23 64.74"></path></g><g style="--ltx-stroke-color:#808080;--ltx-fill-color:#808080;--ltx-fg-color:#808080;" color="#808080" fill="#808080" stroke="#808080" stroke-width="0.2pt"><path style="fill:none" d="M 0 0 L 0 5.91 M 31.47 0 L 31.47 5.91 M 62.94 0 L 62.94 5.91 M 0 75.53 L 0 69.63 M 31.47 75.53 L 31.47 69.63 M 62.94 75.53 L 62.94 69.63"></path></g><g style="--ltx-stroke-color:#808080;--ltx-fill-color:#808080;--ltx-fg-color:#808080;" color="#808080" fill="#808080" stroke="#808080" stroke-width="0.2pt"><path style="fill:none" d="M -6.29 0 L -0.39 0 M -6.29 21.58 L -0.39 21.58 M -6.29 43.16 L -0.39 43.16 M -6.29 64.74 L -0.39 64.74 M 69.23 0 L 63.33 0 M 69.23 21.58 L 63.33 21.58 M 69.23 43.16 L 63.33 43.16 M 69.23 64.74 L 63.33 64.74"></path></g><g style="--ltx-stroke-color:#000000;--ltx-fill-color:#000000;" fill="#000000" stroke="#000000" stroke-width="0.4pt"><path style="fill:none" d="M -6.29 0 L -6.29 75.53 L 69.23 75.53 L 69.23 0 L -6.29 0 Z"></path><g style="--ltx-stroke-color:#000000;--ltx-fill-color:#000000;" fill="