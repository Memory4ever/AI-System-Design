><msub><mi>λ</mi><mi>i</mi></msub><annotation encoding="application/x-tex">\lambda_{i}</annotation></semantics></math></span></span></foreignObject></g></g><g stroke-width="0.8pt"><path style="fill:none" d="M -10.24 0 L 107.52 0"></path><g stroke-dasharray="none" stroke-dashoffset="0.0pt" stroke-linecap="round" stroke-linejoin="round" stroke-width="0.64pt" transform="matrix(1.0 0.0 0.0 1.0 107.52 0)"><path style="fill:none" d="M -2.16 2.88 C -1.98 1.8 0 0.18 0.54 0 C 0 -0.18 -1.98 -1.8 -2.16 -2.88"></path></g><g style="--ltx-stroke-color:#000000;--ltx-fill-color:#000000;" fill="#000000" stroke="#000000" transform="matrix(1.0 0.0 0.0 1.0 113.67 -4.56)"><foreignObject style="--ltx-fo-width:0.34em;--ltx-fo-height:0.66em;--ltx-fo-depth:0em;font-size:10pt;" height="9.13" overflow="visible" transform="matrix(1 0 0 -1 0 9.13)" width="4.77"><span class="ltx_foreignobject_container"><span class="ltx_foreignobject_content"><math id="S4.F4.pic2.m9" class="ltx_Math" alttext="i" display="inline" intent=":literal"><semantics><mi>i</mi><annotation encoding="application/x-tex">i</annotation></semantics></math></span></span></foreignObject></g></g><g style="--ltx-stroke-color:#000000;--ltx-fill-color:#000000;" fill="#000000" stroke="#000000" transform="matrix(1.0 0.0 0.0 1.0 22.18 -30.88)"><foreignObject style="--ltx-fo-width:4.78em;--ltx-fo-height:0.69em;--ltx-fo-depth:0.19em;font-size:10pt;" height="12.3" overflow="visible" transform="matrix(1 0 0 -1 0 9.61)" width="66.19"><span class="ltx_foreignobject_container"><span class="ltx_foreignobject_content"><span id="S4.F4.pic2.1" class="ltx_text">Single-shot</span></span></span></foreignObject></g></g></svg></span>
</figure></div><div class="ltx_flex_break"></div><div class="ltx_flex_cell ltx_flex_size_1"><span class="ltx_inline-block"><svg id="S4.F4.pic3" class="ltx_picture ltx_centering ltx_figure_panel" height="18.68" overflow="visible" version="1.1" viewBox="0 0 151.45 18.68" width="151.45"><g style="--ltx-stroke-color:#000000;--ltx-fill-color:#000000;" fill="#000000" stroke="#000000" stroke-width="0.4pt" transform="translate(0,18.68) matrix(1 0 0 -1 0 0) translate(-107.99,0) translate(0,5.55)"><g style="--ltx-stroke-color:#B3B3FF;--ltx-fill-color:#B3B3FF;--ltx-fg-color:#B3B3FF;" color="#B3B3FF" fill="#B3B3FF" stroke="#B3B3FF"><path style="stroke:none" d="M 108.27 0 M 108.27 0 L 108.27 7.58 L 119.1 7.58 L 119.1 0 Z M 119.1 7.58"></path></g><g style="--ltx-stroke-color:#6666FF;--ltx-fill-color:#6666FF;--ltx-fg-color:#6666FF;" color="#6666FF" fill="#6666FF" stroke="#6666FF"><path style="fill:none" d="M 108.27 0 M 108.27 0 L 108.27 7.58 L 119.1 7.58 L 119.1 0 Z M 119.1 7.58"></path></g><g style="--ltx-stroke-color:#A6D2D2;--ltx-fill-color:#A6D2D2;--ltx-fg-color:#A6D2D2;" color="#A6D2D2" fill="#A6D2D2" stroke="#A6D2D2"><path style="stroke:none" d="M 121.26 0 M 121.26 0 L 121.26 7.58 L 132.09 7.58 L 132.09 0 Z M 132.09 7.58"></path></g><g style="--ltx-stroke-color:#004D4D;--ltx-fill-color:#004D4D;--ltx-fg-color:#004D4D;" color="#004D4D" fill="#004D4D" stroke="#004D4D"><path style="fill:none" d="M 121.26 0 M 121.26 0 L 121.26 7.58 L 132.09 7.58 L 132.09 0 Z M 132.09 7.58"></path></g><g style="--ltx-stroke-color:#000000;--ltx-fill-color:#000000;" fill="#000000" stroke="#000000" transform="matrix(1.0 0.0 0.0 1.0 131.84 -0.94)"><foreignObject style="--ltx-fo-width:2.07em;--ltx-fo-height:0.68em;--ltx-fo-depth:0em;font-size:10pt;" height="9.46" overflow="visible" transform="matrix(1 0 0 -1 0 9.46)" width="28.64"><span class="ltx_foreignobject_container"><span class="ltx_foreignobject_content"><span id="S4.F4.pic3.1" class="ltx_text">Rate</span></span></span></foreignObject></g><g style="--ltx-stroke-color:#E6E6FF;--ltx-fill-color:#E6E6FF;--ltx-fg-color:#E6E6FF;" color="#E6E6FF" fill="#E6E6FF" stroke="#E6E6FF"><path style="stroke:none" d="M 173.23 0 M 173.23 0 L 173.23 7.58 L 184.06 7.58 L 184.06 0 Z M 184.06 7.58"></path></g><g style="--ltx-stroke-color:#6666FF;--ltx-fill-color:#6666FF;--ltx-fg-color:#6666FF;" color="#6666FF" fill="#6666FF" stroke="#6666FF"><path style="fill:none" d="M 173.23 0 M 173.23 0 L 173.23 7.58 L 184.06 7.58 L 184.06 0 Z M 184.06 7.58"></path></g><g style="--ltx-stroke-color:#E6F2F2;--ltx-fill-color:#E6F2F2;--ltx-fg-color:#E6F2F2;" color="#E6F2F2" fill="#E6F2F2" stroke="#E6F2F2"><path style="stroke:none" d="M 186.22 0 M 186.22 0 L 186.22 7.58 L 197.05 7.58 L 197.05 0 Z M 197.05 7.58"></path></g><g style="--ltx-stroke-color:#004D4D;--ltx-fill-color:#004D4D;--ltx-fg-color:#004D4D;" color="#004D4D" fill="#004D4D" stroke="#004D4D"><path style="fill:none" d="M 186.22 0 M 186.22 0 L 186.22 7.58 L 197.05 7.58 L 197.05 0 Z M 197.05 7.58"></path></g><g style="--ltx-stroke-color:#000000;--ltx-fill-color:#000000;" fill="#000000" stroke="#000000" transform="matrix(1.0 0.0 0.0 1.0 193.41 -0.94)"><foreignObject style="--ltx-fo-width:4.44em;--ltx-fo-height:0.68em;--ltx-fo-depth:0em;font-size:10pt;" height="9.46" overflow="visible" transform="matrix(1 0 0 -1 0 9.46)" width="61.42"><span class="ltx_foreignobject_container"><span class="ltx_foreignobject_content"><span id="S4.F4.pic3.2" class="ltx_text">Distortion</span></span></span></foreignObject></g></g></svg></span></div></div>
<figcaption class="ltx_caption ltx_centering"><span class="ltx_tag ltx_tag_figure">Figure 4: </span>Rate-distortion equivalence</figcaption>
</figure>
<div id="Thmtheorem1" class="ltx_theorem ltx_theorem_theorem">
<h6 class="ltx_title ltx_runin ltx_title_theorem"><span class="ltx_tag ltx_tag_theorem"><span id="Thmtheorem1.2" class="ltx_text ltx_font_bold">Theorem 1</span></span><span id="Thmtheorem1.3" class="ltx_text ltx_font_bold">.</span></h6>
<div id="Thmtheorem1.p1" class="ltx_para">
<p id="Thmtheorem1.p1.1" class="ltx_p"><span id="Thmtheorem1.p1.1.1" class="ltx_text ltx_font_italic">Let <math id="Thmtheorem1.p1.m1" class="ltx_Math" alttext="\bm{\mathsf{W}}" display="inline" intent=":literal"><semantics><mi>𝗪</mi><annotation encoding="application/x-tex">\bm{\mathsf{W}}</annotation></semantics></math> be a zero-mean Gaussian random matrix with i.i.d. (independent and identically distributed) entries, and consider the weighted mean squared error distortion with a fixed matrix <math id="Thmtheorem1.p1.m2" class="ltx_Math" alttext="\bm{X}" display="inline" intent=":literal"><semantics><mi>𝐗</mi><annotation encoding="application/x-tex">\bm{X}</annotation></semantics></math>, <math id="Thmtheorem1.p1.m3" class="ltx_Math" alttext="d_{\mathrm{WMSE}}(\bm{\mathsf{W}},\widehat{\bm{\mathsf{W}}})=\mathbb{E}\!\left[\|(\bm{\mathsf{W}}-\widehat{\bm{\mathsf{W}}})\bm{X}\|_{F}^{2}\right]" display="inline" intent=":literal"><semantics><mrow><mrow><msub><mi>d</mi><mi>WMSE</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>𝗪</mi><mo>,</mo><mover accent="true"><mi>𝗪</mi><mo>^</mo></mover><mo stretchy="false">)</mo></mrow></mrow><mo>=</mo><mrow><mpadded style="width:0.497em;" width="0.497em"><mi>𝔼</mi></mpadded><mo>⁡</mo><mrow><mo>[</mo><msubsup><mrow><mo stretchy="false">‖</mo><mrow><mrow><mo stretchy="false">(</mo><mrow><mi>𝗪</mi><mo>−</mo><mover accent="true"><mi>𝗪</mi><mo>^</mo></mover></mrow><mo stretchy="false">)</mo></mrow><mo lspace="0em" rspace="0em">​</mo><mi>𝐗</mi></mrow><mo stretchy="false">‖</mo></mrow><mi>F</mi><mn>2</mn></msubsup><mo>]</mo></mrow></mrow></mrow><annotation encoding="application/x-tex">d_{\mathrm{WMSE}}(\bm{\mathsf{W}},\widehat{\bm{\mathsf{W}}})=\mathbb{E}\!\left[\|(\bm{\mathsf{W}}-\widehat{\bm{\mathsf{W}}})\bm{X}\|_{F}^{2}\right]</annotation></semantics></math>. Then, the source <math id="Thmtheorem1.p1.m4" class="ltx_Math" alttext="(\bm{\mathsf{W}},d_{\mathrm{WMSE}})" display="inline" intent=":literal"><semantics><mrow><mo stretchy="false">(</mo><mi>𝗪</mi><mo>,</mo><msub><mi>d</mi><mi>WMSE</mi></msub><mo stretchy="false">)</mo></mrow><annotation encoding="application/x-tex">(\bm{\mathsf{W}},d_{\mathrm{WMSE}})</annotation></semantics></math> is successively refinable.</span></p>
</div>
</div>
<div id="S4.p2" class="ltx_para">
<p id="S4.p2.1" class="ltx_p">The central challenge is that the WMSE distortion couples all entries of
<math id="S4.p2.m1" class="ltx_Math" alttext="\bm{\mathsf{W}}" display="inline" intent=":literal"><semantics><mi>𝗪</mi><annotation encoding="application/x-tex">\bm{\mathsf{W}}</annotation></semantics></math> through the fixed data matrix <math id="S4.p2.m2" class="ltx_Math" alttext="\bm{X}" display="inline" intent=":literal"><semantics><mi>𝑿</mi><annotation encoding="application/x-tex">\bm{X}</annotation></semantics></math>,
making it non-obvious that successive refinement is achievable without a
rate penalty. The proof resolves this by reducing to a standard Gaussian MSE problem, then revealing the nested structure of reverse water-filling. The reverse water-filling method is an optimization technique used in information theory and communication systems which allocates more bits (rate) to <span id="S4.p2.1.1" class="ltx_text ltx_font_italic">worse</span> channels to minimize total distortion under a rate constraint. Full proofs and visuals are in Appendix <a href="#A6" title="Appendix F Proofs of Auxiliary Results ‣ Multi-Bitwidth Quantization for LLMs Using Additive Codebooks" class="ltx_ref"><span class="ltx_text ltx_ref_tag">F</span></a>.</p>
</div>
<div id="S4.2" class="ltx_proof">
<h6 class="ltx_title ltx_runin ltx_font_italic ltx_title_proof">Proof Sketch.</h6>
<div id="S4.p3" class="ltx_para ltx_noindent">
<p id="S4.p3.1" class="ltx_p"><span id="S4.p3.1.1" class="ltx_text">Introduce the transformed source <math id="S4.p3.m1" class="ltx_Math" alttext="\bm{\mathsf{Y}}=\bm{\mathsf{W}}\bm{X}" display="inline" intent=":literal"><semantics><mrow><mi>𝗬</mi><mo>=</mo><mrow><mi>𝗪</mi><mo lspace="0em" rspace="0em">​</mo><mi>𝑿</mi></mrow></mrow><annotation encoding="application/x-tex">\bm{\mathsf{Y}}=\bm{\mathsf{W}}\bm{X}</annotation></semantics></math>. The rate-distortion function for <math id="S4.p3.m2" class="ltx_Math" alttext="\bm{\mathsf{W}}" display="inline" intent=":literal"><semantics><mi>𝗪</mi><annotation encoding="application/x-tex">\bm{\mathsf{W}}</annotation></semantics></math> under
<math id="S4.p3.m3" class="ltx_Math" alttext="d_{\mathrm{WMSE}}" display="inline" intent=":literal"><semantics><msub><mi>d</mi><mi>WMSE</mi></msub><annotation encoding="application/x-tex">d_{\mathrm{WMSE}}</annotation></semantics></math> equals the standard Gaussian MSE rate-distortion
function for <math id="S4.p3.m4" class="ltx_Math" alttext="\bm{\mathsf{Y}}" display="inline" intent=":literal"><semantics><mi>𝗬</mi><annotation encoding="application/x-tex">\bm{\mathsf{Y}}</annotation></semantics></math>, with a one-to-one correspondence
between their optimal codebooks at every distortion level <math id="S4.p3.m5" class="ltx_Math" alttext="D" display="inline" intent=":literal"><semantics><mi>D</mi><annotation encoding="application/x-tex">D</annotation></semantics></math>. This follows
from the distortion equivalence: the optimal <math id="S4.p3.m6" class="ltx_Math" alttext="\widehat{\bm{\mathsf{W}}}" display="inline" intent=":literal"><semantics><mover accent="true"><mi>𝗪</mi><mo>^</mo></mover><annotation encoding="application/x-tex">\widehat{\bm{\mathsf{W}}}</annotation></semantics></math>
is recovered by inverting <math id="S4.p3.m7" class="ltx_Math" alttext="\bm{\mathsf{Y}}=\bm{\mathsf{W}}\bm{X}" display="inline" intent=":literal"><semantics><mrow><mi>𝗬</mi><mo>=</mo><mrow><mi>𝗪</mi><mo lspace="0em" rspace="0em">​</mo><mi>𝑿</mi></mrow></mrow><annotation encoding="application/x-tex">\bm{\mathsf{Y}}=\bm{\mathsf{W}}\bm{X}</annotation></semantics></math>, and satisfies
<math id="S4.p3.m8" class="ltx_Math" alttext="d_{\mathrm{WMSE}}(\bm{\mathsf{W}},\widehat{\bm{\mathsf{W}}})\;=\;\mathbb{E}\!\left[\bigl\|(\bm{\mathsf{W}}-\widehat{\bm{\mathsf{W}}})\bm{X}\bigr\|_{F}^{2}\right]\;=\;\mathbb{E}\!\left[\bigl\|\bm{\mathsf{Y}}-\widehat{\bm{\mathsf{Y}}}\bigr\|_{F}^{2}\right]," display="inline" intent=":literal"><semantics><mrow><mrow><mrow><msub><mi>d</mi><mi>WMSE</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>𝗪</mi><mo>,</mo><mover accent="true"><mi>𝗪</mi><mo>^</mo></mover><mo rspace="0.280em" stretchy="false">)</mo></mrow></mrow><mo rspace="0.558em">=</mo><mrow><mpadded style="width:0.497em;" width="0.497em"><mi>𝔼</mi></mpadded><mo>⁡</mo><mrow><mo>[</mo><msubsup><mrow><mo maxsize="1.200em" minsize="1.200em" stretchy="true">‖</mo><mrow><mrow><mo stretchy="false">(</mo><mrow><mi>𝗪</mi><mo>−</mo><mover accent="true"><mi>𝗪</mi><mo>^</mo></mover></mrow><mo stretchy="false">)</mo></mrow><mo lspace="0em" rspace="0em">​</mo><mi>𝑿</mi></mrow><mo maxsize="1.200em" minsize="1.200em" stretchy="true">‖</mo></mrow><mi>F</mi><mn>2</mn></msubsup><mo rspace="0.280em">]</mo></mrow></mrow><mo rspace="0.558em">=</mo><mrow><mpadded style="width:0.497em;" width="0.497em"><mi>𝔼</mi></mpadded><mo>⁡</mo><mrow><mo>[</mo><msubsup><mrow><mo maxsize="1.200em" minsize="1.200em" stretchy="true">‖</mo><mrow><mi>𝗬</mi><mo>−</mo><mover accent="true"><mi>𝗬</mi><mo>^</mo></mover></mrow><mo maxsize="1.200em" minsize="1.200em" stretchy="true">‖</mo></mrow><mi>F</mi><mn>2</mn></msubsup><mo>]</mo></mrow></mrow></mrow><mo>,</mo></mrow><annotation encoding="application/x-tex">d_{\mathrm{WMSE}}(\bm{\mathsf{W}},\widehat{\bm{\mathsf{W}}})\;=\;\mathbb{E}\!\left[\bigl\|(\bm{\mathsf{W}}-\widehat{\bm{\mathsf{W}}})\bm{X}\bigr\|_{F}^{2}\right]\;=\;\mathbb{E}\!\left[\bigl\|\bm{\mathsf{Y}}-\widehat{\bm{\mathsf{Y}}}\bigr\|_{F}^{2}\right],</annotation></semantics></math> by Theorem <a href="#Thmtheorem3" title="Theorem 3 (WMSE Rate-Distortion Equivalence). ‣ F.1 Rate-Distortion Under Weighted MSE ‣ Appendix F Proofs of Auxiliary Results ‣ Multi-Bitwidth Quantization for LLMs Using Additive Codebooks" class="ltx_ref"><span class="ltx_text ltx_ref_tag">3</span></a>.</span></p>
</div>
<div id="S4.p4" class="ltx_para ltx_noindent">
<p id="S4.p4.1" class="ltx_p"><span id="S4.p4.1.1" class="ltx_text">It therefore suffices to solve the standard MSE rate-distortion problem
for <math id="S4.p4.m1" class="ltx_Math" alttext="\bm{\mathsf{Y}}" display="inline" intent=":literal"><semantics><mi>𝗬</mi><annotation encoding="application/x-tex">\bm{\mathsf{Y}}</annotation></semantics></math>. To do so, we vectorize
<math id="S4.p4.m2" class="ltx_Math" alttext="\bm{\mathsf{y}}\coloneqq\operatorname{vec}(\bm{\mathsf{Y}})" display="inline" intent=":literal"><semantics><mrow><mi>𝘆</mi><mo>≔</mo><mrow><mi>vec</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>𝗬</mi><mo stretchy="false">)</mo></mrow></mrow></mrow><annotation encoding="application/x-tex">\bm{\mathsf{y}}\coloneqq\operatorname{vec}(\bm{\mathsf{Y}})</annotation></semantics></math>
and compute that <math id="S4.p4.m3" class="ltx_Math" alttext="\bm{\mathsf{y}}" display="inline" intent=":literal"><semantics><mi>𝘆</mi><annotation encoding="application/x-tex">\bm{\mathsf{y}}</annotation></semantics></math> is a
zero-mean coloured Gaussian with covariance
<math id="S4.p4.m4" class="ltx_Math" alttext="\bm{\Sigma}_{\mathsf{y}}\;=\;\bigl(\sigma_{w}^{2}\,\bm{X}^{\top}\bm{X}\bigr)\otimes\bm{I}_{d_{\mathrm{out}}}," display="inline" intent=":literal"><semantics><mrow><mrow><msub><mi>𝚺</mi><mi>𝗒</mi></msub><mo lspace="0.558em" rspace="0.558em">=</mo><mrow><mrow><mo maxsize="1.200em" minsize="1.200em">(</mo><mrow><msubsup><mi>σ</mi><mi>w</mi><mn>2</mn></msubsup><mo lspace="0em" rspace="0em">​</mo><msup><mi>𝑿</mi><mo>⊤</mo></msup><mo lspace="0em" rspace="0em">​</mo><mi>𝑿</mi></mrow><mo maxsize="1.200em" minsize="1.200em" rspace="0.055em">)</mo></mrow><mo rspace="0.222em">⊗</mo><msub><mi>𝑰</mi><msub><mi>d</mi><mi>out</mi></msub></msub></mrow></mrow><mo>,</mo></mrow><annotation encoding="application/x-tex">\bm{\Sigma}_{\mathsf{y}}\;=\;\bigl(\sigma_{w}^{2}\,\bm{X}^{\top}\bm{X}\bigr)\otimes\bm{I}_{d_{\mathrm{out}}},</annotation></semantics></math>
where <math id="S4.p4.m5" class="ltx_Math" alttext="\otimes" display="inline" intent=":literal"><semantics><mo>⊗</mo><annotation encoding="application/x-tex">\otimes</annotation></semantics></math> denotes the Kronecker product. Since <math id="S4.p4.m6" class="ltx_Math" alttext="\bm{\mathsf{y}}" display="inline" intent=":literal"><semantics><mi>𝘆</mi><annotation encoding="application/x-tex">\bm{\mathsf{y}}</annotation></semantics></math>
is correlated, reverse water-filling cannot be applied directly.
Diagonalizing via eigen-decomposition <math id="S4.p4.m7" class="ltx_Math" alttext="\bm{\Sigma}_{\mathsf{y}}=\bm{U}\,\mathrm{diag}(\lambda_{1},\lambda_{2},\ldots)\,\bm{U}^{\top}" display="inline" intent=":literal"><semantics><mrow><msub><mi>𝚺</mi><mi>𝗒</mi></msub><mo>=</mo><mrow><mi>𝑼</mi><mo lspace="0.170em" rspace="0em">​</mo><mi>diag</mi><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mi>λ</mi><mn>1</mn></msub><mo>,</mo><msub><mi>λ</mi><mn>2</mn></msub><mo>,</mo><mi mathvariant="normal">…</mi><mo stretchy="false">)</mo></mrow><mo lspace="0.170em" rspace="0em">​</mo><msup><mi>𝑼</mi><mo>⊤</mo></msup></mrow></mrow><annotation encoding="application/x-tex">\bm{\Sigma}_{\mathsf{y}}=\bm{U}\,\mathrm{diag}(\lambda_{1},\lambda_{2},\ldots)\,\bm{U}^{\top}</annotation></semantics></math>
yields independent scalar Gaussian components <math id="S4.p4.m8" class="ltx_Math" alttext="\mathsf{y}_{i}\sim\mathcal{N}(0,\lambda_{i})" display="inline" intent=":literal"><semantics><mrow><msub><mi>𝗒</mi><mi>i</mi></msub><mo>∼</mo><mrow><mi class="ltx_font_mathcaligraphic">𝒩</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mn>0</mn><mo>,</mo><msub><mi>λ</mi><mi>i</mi></msub><mo stretchy="false">)</mo></mrow></mrow></mrow><annotation encoding="application/x-tex">\mathsf{y}_{i}\sim\mathcal{N}(0,\lambda_{i})</annotation></semantics></math>, to which reverse water-filling applies. The
optimal rate-distortion tradeoff for <math id="S4.p4.m9" class="ltx_Math" alttext="\bm{\mathsf{y}}" display="inline" intent=":literal"><semantics><mi>𝘆</mi><annotation encoding="application/x-tex">\bm{\mathsf{y}}</annotation></semantics></math> under
MSE is therefore achieved by assigning per-component
distortion <math id="S4.p4.m10" class="ltx_Math" alttext="D_{i}=\min(\mu,\lambda_{i})" display="inline" intent=":literal"><semantics><mrow><msub><mi>D</mi><mi>i</mi></msub><mo>=</mo><mrow><mi>min</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>μ</mi><mo>,</mo><msub><mi>λ</mi><mi>i</mi></msub><mo stretchy="false">)</mo></mrow></mrow></mrow><annotation encoding="application/x-tex">D_{i}=\min(\mu,\lambda_{i})</annotation></semantics></math>, where the ”water level” <math id="S4.p4.m11" class="ltx_Math" alttext="\mu" display="inline" intent=":literal"><semantics><mi>μ</mi><annotation encoding="application/x-tex">\mu</annotation></semantics></math> is
chosen so that <math id="S4.p4.m12" class="ltx_Math" alttext="\sum_{i}D_{i}=D" display="inline" intent=":literal"><semantics><mrow><mrow><msub><mo>∑</mo><mi>i</mi></msub><msub><mi>D</mi><mi>i</mi></msub></mrow><mo>=</mo><mi>D</mi></mrow><annotation encoding="application/x-tex">\sum_{i}D_{i}=D</annotation></semantics></math> (Theorem <a href="#Thmtheorem3" title="Theorem 3 (WMSE Rate-Distortion Equivalence). ‣ F.1 Rate-Distortion Under Weighted MSE ‣ Appendix F Proofs of Auxiliary Results ‣ Multi-Bitwidth Quantization for LLMs Using Additive Codebooks" class="ltx_ref"><span class="ltx_text ltx_ref_tag">3</span></a>). The water level <math id="S4.p4.m13" class="ltx_Math" alttext="\mu" display="inline" intent=":literal"><semantics><mi>μ</mi><annotation encoding="application/x-tex">\mu</annotation></semantics></math> partitions each component into a distortion portion (<math id="S4.p4.m14" class="ltx_Math" alttext="\lambda_{i}&lt;\mu" display="inline" intent=":literal"><semantics><mrow><msub><mi>λ</mi><mi>i</mi></msub><mo>&lt;</mo><mi>μ</mi></mrow><annotation encoding="application/x-tex">\lambda_{i}&lt;\mu</annotation></semantics></math>) and a rate portion (<math id="S4.p4.m15" class="ltx_Math" alttext="\lambda_{i}&gt;\mu" display="inline" intent=":literal"><semantics><mrow><msub><mi>λ</mi><mi>i</mi></msub><mo>&gt;</mo><mi>μ</mi></mrow><annotation encoding="application/x-tex">\lambda_{i}&gt;\mu</annotation></semantics></math>).</span></p>
</div>
<div id="S4.p5" class="ltx_para ltx_noindent">
<p id="S4.p5.1" class="ltx_p"><span id="S4.p5.1.1" class="ltx_text">To establish successive refinability, we use superscripts <math id="S4.p5.m1" class="ltx_Math" alttext="k" display="inline" intent=":literal"><semantics><mi>k</mi><annotation encoding="application/x-tex">k</annotation></semantics></math> to index
refinement stages and subscripts <math id="S4.p5.m2" class="ltx_Math" alttext="i" display="inline" intent=":literal"><semantics><mi>i</mi><annotation encoding="application/x-tex">i</annotation></semantics></math> to index scalar components. For nested
overall distortion levels <math id="S4.p5.m3" class="ltx_Math" alttext="D^{(1)}&gt;\cdots&gt;D^{(K)}" display="inline" intent=":literal"><semantics><mrow><msup><mi>D</mi><mrow><mo stretchy="false">(</mo><mn>1</mn><mo stretchy="false">)</mo></mrow></msup><mo rspace="0.1389em">&gt;</mo><mo lspace="0.1389em" rspace="0.1389em">⋯</mo><mo lspace="0.1389em">&gt;</mo><msup><mi>D</mi><mrow><mo stretchy="false">(</mo><mi>K</mi><mo stretchy="false">)</mo></mrow></msup></mrow><annotation encoding="application/x-tex">D^{(1)}&gt;\cdots&gt;D^{(K)}</annotation></semantics></math>, reverse water-filling
assigns per-component distortions <math id="S4.p5.m4" class="ltx_Math" alttext="D_{i}^{(k)}=\min(\mu_{k},\lambda_{i})" display="inline" intent=":literal"><semantics><mrow><msubsup><mi>D</mi><mi>i</mi><mrow><mo stretchy="false">(</mo><mi>k</mi><mo stretchy="false">)</mo></mrow></msubsup><mo>=</mo><mrow><mi>min</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><msub><mi>μ</mi><mi>k</mi></msub><mo>,</mo><msub><mi>λ</mi><mi>i</mi></msub><mo stretchy="false">)</mo></mrow></mrow></mrow><annotation encoding="application/x-tex">D_{i}^{(k)}=\min(\mu_{k},\lambda_{i})</annotation></semantics></math>, corresponding to a
strictly decreasing sequence of water levels <math id="S4.p5.m5" class="ltx_Math" alttext="\mu_{1}&gt;\cdots&gt;\mu_{K}" display="inline" intent=":literal"><semantics><mrow><msub><mi>μ</mi><mn>1</mn></msub><mo rspace="0.1389em">&gt;</mo><mo lspace="0.1389em" rspace="0.1389em">⋯</mo><mo lspace="0.1389em">&gt;</mo><msub><mi>μ</mi><mi>K</mi></msub></mrow><annotation encoding="application/x-tex">\mu_{1}&gt;\cdots&gt;\mu_{K}</annotation></semantics></math>. For
each component <math id="S4.p5.m6" class="ltx_Math" alttext="\mathsf{y}_{i}" display="inline" intent=":literal"><semantics><msub><mi>𝗒</mi><mi>i</mi></msub><annotation encoding="application/x-tex">\mathsf{y}_{i}</annotation></semantics></math>, define mutually independent Gaussian increments</span></p>
<table id="S4.Ex3" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="S4.Ex3.m1" class="ltx_Math" alttext="\mathsf{z}_{i}^{(k)}\;\sim\;\mathcal{N}\!\left(0,\,D_{i}^{(k-1)}-D_{i}^{(k)}\right),\qquad D_{i}^{(0)}\coloneqq\lambda_{i}," display="block" intent=":literal"><semantics><mrow><mrow><mrow><msubsup><mi>𝗓</mi><mi>i</mi><mrow><mo stretchy="false">(</mo><mi>k</mi><mo stretchy="false">)</mo></mrow></msubsup><mo lspace="0.558em" rspace="0.558em">∼</mo><mrow><mpadded style="width:0.798em;" width="0.798em"><mi class="ltx_font_mathcaligraphic">𝒩</mi></mpadded><mo>⁡</mo><mrow><mo>(</mo><mn>0</mn><mo>,</mo><mrow><msubsup><mi>D</mi><mi>i</mi><mrow><mo stretchy="false">(</mo><mrow><mi>k</mi><mo>−</mo><mn>1</mn></mrow><mo stretchy="false">)</mo></mrow></msubsup><mo>−</mo><msubsup><mi>D</mi><mi>i</mi><mrow><mo stretchy="false">(</mo><mi>k</mi><mo stretchy="false">)</mo></mrow></msubsup></mrow><mo>)</mo></mrow></mrow></mrow><mo rspace="2.167em">,</mo><mrow><msubsup><mi>D</mi><mi>i</mi><mrow><mo stretchy="false">(</mo><mn>0</mn><mo stretchy="false">)</mo></mrow></msubsup><mo>≔</mo><msub><mi>λ</mi><mi>i</mi></msub></mrow></mrow><mo>,</mo></mrow><annotation encoding="application/x-tex">\mathsf{z}_{i}^{(k)}\;\sim\;\mathcal{N}\!\left(0,\,D_{i}^{(k-1)}-D_{i}^{(k)}\right),\qquad D_{i}^{(0)}\coloneqq\lambda_{i},</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="S4.p5.2" class="ltx_p"><span id="S4.p5.2.1" class="ltx_text">and construct successive reconstructions via
<math id="S4.p5.m7" class="ltx_Math" alttext="\widehat{\mathsf{y}}_{i}^{(0)}=0," display="inline" intent=":literal"><semantics><mrow><mrow><msubsup><mover accent="true"><mi>𝗒</mi><mo>^</mo></mover><mi>i</mi><mrow><mo stretchy="false">(</mo><mn>0</mn><mo stretchy="false">)</mo></mrow></msubsup><mo>=</mo><mn>0</mn></mrow><mo>,</mo></mrow><annotation encoding="application/x-tex">\widehat{\mathsf{y}}_{i}^{(0)}=0,</annotation></semantics></math> <math id="S4.p5.m8" class="ltx_Math" alttext="\widehat{\mathsf{y}}_{i}^{(k)}=\widehat{\mathsf{y}}_{i}^{(k-1)}+\mathsf{z}_{i}^{(k)}." display="inline" intent=":literal"><semantics><mrow><mrow><msubsup><mover accent="true"><mi>𝗒</mi><mo>^</mo></mover><mi>i</mi><mrow><mo stretchy="false">(</mo><mi>k</mi><mo stretchy="false">)</mo></mrow></msubsup><mo>=</mo><mrow><msubsup><mover accent="true"><mi>𝗒</mi><mo>^</mo></mover><mi>i</mi><mrow><mo stretchy="false">(</mo><mrow><mi>k</mi><mo>−</mo><mn>1</mn></mrow><mo stretchy="false">)</mo></mrow></msubsup><mo>+</mo><msubsup><mi>𝗓</mi><mi>i</mi><mrow><mo stretchy="false">(</mo><mi>k</mi><mo stretchy="false">)</mo></mrow></msubsup></mrow></mrow><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">\widehat{\mathsf{y}}_{i}^{(k)}=\widehat{\mathsf{y}}_{i}^{(k-1)}+\mathsf{z}_{i}^{(k)}.</annotation></semantics></math>
Each increment <math id="S4.p5.m9" class="ltx_Math" alttext="\mathsf{z}_{i}^{(k)}" display="inline" intent=":literal"><semantics><msubsup><mi>𝗓</mi><mi>i</mi><mrow><mo stretchy="false">(</mo><mi>k</mi><mo stretchy="false">)</mo></mrow></msubsup><annotation encoding="application/x-tex">\mathsf{z}_{i}^{(k)}</annotation></semantics></math> carries exactly the new information
needed to improve the reconstruction of <math id="S4.p5.m10" class="ltx_Math" alttext="\mathsf{y}_{i}" display="inline" intent=":literal"><semantics><msub><mi>𝗒</mi><mi>i</mi></msub><annotation encoding="application/x-tex">\mathsf{y}_{i}</annotation></semantics></math> from distortion
<math id="S4.p5.m11" class="ltx_Math" alttext="D_{i}^{(k-1)}" display="inline" intent=":literal"><semantics><msubsup><mi>D</mi><mi>i</mi><mrow><mo stretchy="false">(</mo><mrow><mi>k</mi><mo>−</mo><mn>1</mn></mrow><mo stretchy="false">)</mo></mrow></msubsup><annotation encoding="application/x-tex">D_{i}^{(k-1)}</annotation></semantics></math> to the finer distortion <math id="S4.p5.m12" class="ltx_Math" alttext="D_{i}^{(k)}" display="inline" intent=":literal"><semantics><msubsup><mi>D</mi><mi>i</mi><mrow><mo stretchy="false">(</mo><mi>k</mi><mo stretchy="false">)</mo></mrow></msubsup><annotation encoding="application/x-tex">D_{i}^{(k)}</annotation></semantics></math>; it is independent of
all previous increments and of the current reconstruction
<math id="S4.p5.m13" class="ltx_Math" alttext="\widehat{\mathsf{y}}_{i}^{(k-1)}" display="inline" intent=":literal"><semantics><msubsup><mover accent="true"><mi>𝗒</mi><mo>^</mo></mover><mi>i</mi><mrow><mo stretchy="false">(</mo><mrow><mi>k</mi><mo>−</mo><mn>1</mn></mrow><mo stretchy="false">)</mo></mrow></msubsup><annotation encoding="application/x-tex">\widehat{\mathsf{y}}_{i}^{(k-1)}</annotation></semantics></math>. The incremental rate <math id="S4.p5.m14" class="ltx_Math" alttext="\Delta R_{i}^{(k)}" display="inline" intent=":literal"><semantics><mrow><mi mathvariant="normal">Δ</mi><mo lspace="0em" rspace="0em">​</mo><msubsup><mi>R</mi><mi>i</mi><mrow><mo stretchy="false">(</mo><mi>k</mi><mo stretchy="false">)</mo></mrow></msubsup></mrow><annotation encoding="application/x-tex">\Delta R_{i}^{(k)}</annotation></semantics></math>
is therefore the number of bits required to describe <math id="S4.p5.m15" class="ltx_Math" alttext="\mathsf{z}_{i}^{(k)}" display="inline" intent=":literal"><semantics><msubsup><mi>𝗓</mi><mi>i</mi><mrow><mo stretchy="false">(</mo><mi>k</mi><mo stretchy="false">)</mo></mrow></msubsup><annotation encoding="application/x-tex">\mathsf{z}_{i}^{(k)}</annotation></semantics></math>,
i.e. the mutual information between <math id="S4.p5.m16" class="ltx_Math" alttext="\mathsf{y}_{i}" display="inline" intent=":literal"><semantics><msub><mi>𝗒</mi><mi>i</mi></msub><annotation encoding="application/x-tex">\mathsf{y}_{i}</annotation></semantics></math> and the refined
reconstruction <math id="S4.p5.m17" class="ltx_Math" alttext="\widehat{\mathsf{y}}_{i}^{(k)}" display="inline" intent=":literal"><semantics><msubsup><mover accent="true"><mi>𝗒</mi><mo>^</mo></mover><mi>i</mi><mrow><mo stretchy="false">(</mo><mi>k</mi><mo stretchy="false">)</mo></mrow></msubsup><annotation encoding="application/x-tex">\widehat{\mathsf{y}}_{i}^{(k)}</annotation></semantics></math> given the previous one:
<math id="S4.p5.m18" class="ltx_math_unparsed" alttext="\Delta R_{i}^{(k)}\;=\;I\!\left(\mathsf{y}_{i};\,\widehat{\mathsf{y}}_{i}^{(k)}\,\middle|\,\widehat{\mathsf{y}}_{i}^{(k-1)}\right)\;=\;\frac{1}{2}\log\frac{D_{i}^{(k-1)}}{D_{i}^{(k)}}." display="inline" intent=":literal"><semantics><mrow><mi mathvariant="normal">Δ</mi><msubsup><mi>R</mi><mi>i</mi><mrow><mo stretchy="false">(</mo><mi>k</mi><mo stretchy="false">)</mo></mrow></msubsup><mo rspace="0.558em">=</mo><mpadded style="width:0.348em;" width="0.348em"><mi>I</mi></mpadded><mrow><mo>(</mo><msub><mi>𝗒</mi><mi>i</mi></msub><mo rspace="0.337em">;</mo><msubsup><mover accent="true"><mi>𝗒</mi><mo>^</mo></mover><mi>i</mi><mrow><mo stretchy="false">(</mo><mi>k</mi><mo stretchy="false">)</mo></mrow></msubsup><mo lspace="0em" rspace="0.170em" stretchy="true">|</mo><msubsup><mover accent="true"><mi>𝗒</mi><mo>^</mo></mover><mi>i</mi><mrow><mo stretchy="false">(</mo><mrow><mi>k</mi><mo>−</mo><mn>1</mn></mrow><mo stretchy="false">)</mo></mrow></msubsup><mo rspace="0.280em">)</mo></mrow><mo rspace="0.558em">=</mo><mfrac><mn>1</mn><mn>2</mn></mfrac><mi>log</mi><mfrac><msubsup><mi>D</mi><mi>i</mi><mrow><mo stretchy="false">(</mo><mrow><mi>k</mi><mo>−</mo><mn>1</mn></mrow><mo stretchy="false">)</mo></mrow></msubsup><msubsup><mi>D</mi><mi>i</mi><mrow><mo stretchy="false">(</mo><mi>k</mi><mo stretchy="false">)</mo></mrow></msubsup></mfrac><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">\Delta R_{i}^{(k)}\;=\;I\!\left(\mathsf{y}_{i};\,\widehat{\mathsf{y}}_{i}^{(k)}\,\middle|\,\widehat{\mathsf{y}}_{i}^{(k-1)}\right)\;=\;\frac{1}{2}\log\frac{D_{i}^{(k-1)}}{D_{i}^{(k)}}.</annotation></semantics></math>
By construction, <math id="S4.p5.m19" class="ltx_Math" alttext="\mathbb{E}[(\mathsf{y}_{i}-\widehat{\mathsf{y}}_{i}^{(k)})^{2}]=D_{i}^{(k)}" display="inline" intent=":literal"><semantics><mrow><mrow><mi>𝔼</mi><mo>⁡</mo><mrow><mo stretchy="false">[</mo><msup><mrow><mo stretchy="false">(</mo><mrow><msub><mi>𝗒</mi><mi>i</mi></msub><mo>−</mo><msubsup><mover accent="true"><mi>𝗒</mi><mo>^</mo></mover><mi>i</mi><mrow><mo stretchy="false">(</mo><mi>k</mi><mo stretchy="false">)</mo></mrow></msubsup></mrow><mo stretchy="false">)</mo></mrow><mn>2</mn></msup><mo stretchy="false">]</mo></mrow></mrow><mo>=</mo><msubsup><mi>D</mi><mi>i</mi><mrow><mo stretchy="false">(</mo><mi>k</mi><mo stretchy="false">)</mo></mrow></msubsup></mrow><annotation encoding="application/x-tex">\mathbb{E}[(\mathsf{y}_{i}-\widehat{\mathsf{y}}_{i}^{(k)})^{2}]=D_{i}^{(k)}</annotation></semantics></math> at every stage, and since
each increment is independent of all previous ones, the Markov chain
<math id="S4.p5.m20" class="ltx_Math" alttext="\widehat{\mathsf{y}}_{i}^{(1)}\to\cdots\to\widehat{\mathsf{y}}_{i}^{(K)}\to\mathsf{y}_{i}" display="inline" intent=":literal"><semantics><mrow><msubsup><mover accent="true"><mi>𝗒</mi><mo>^</mo></mover><mi>i</mi><mrow><mo stretchy="false">(</mo><mn>1</mn><mo stretchy="false">)</mo></mrow></msubsup><mo rspace="0.1389em" stretchy="false">→</mo><mo lspace="0.1389em" rspace="0.1389em">⋯</mo><mo lspace="0.1389em" stretchy="false">→</mo><msubsup><mover accent="true"><mi>𝗒</mi><mo>^</mo></mover><mi>i</mi><mrow><mo stretchy="false">(</mo><mi>K</mi><mo stretchy="false">)</mo></mrow></msubsup><mo stretchy="false">→</mo><msub><mi>𝗒</mi><mi>i</mi></msub></mrow><annotation encoding="application/x-tex">\widehat{\mathsf{y}}_{i}^{(1)}\to\cdots\to\widehat{\mathsf{y}}_{i}^{(K)}\to\mathsf{y}_{i}</annotation></semantics></math> holds (Theorem <a href="#Thmtheorem4" title="Theorem 4 (Correlated Gaussian under MSE is successively refinable). ‣ F.2 Successive Refinability under WMSE ‣ Appendix F Proofs of Auxiliary Results ‣ Multi-Bitwidth Quantization for LLMs Using Additive Codebooks" class="ltx_ref"><span class="ltx_text ltx_ref_tag">4</span></a>).
The below sum then confirms there is no rate penalty:</span></p>
<table id="S4.Ex4" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="S4.Ex4.m1" class="ltx_Math" alttext="\sum_{k=1}^{K}\Delta R_{i}^{(k)}\;=\;\frac{1}{2}\log\frac{\lambda_{i}}{D_{i}^{(1)}}+\frac{1}{2}\log\frac{D_{i}^{(1)}}{D_{i}^{(2)}}+\cdots+\frac{1}{2}\log\frac{D_{i}^{(K-1)}}{D_{i}^{(K)}}\;=\;\frac{1}{2}\log\frac{\lambda_{i}}{D_{i}^{(K)}}," display="block" intent=":literal"><semantics><mrow><mrow><mrow><munderover><mo movablelimits="false">∑</mo><mrow><mi>k</mi><mo>=</mo><mn>1</mn></mrow><mi>K</mi></munderover><mrow><mi mathvariant="normal">Δ</mi><mo lspace="0em" rspace="0em">​</mo><msubsup><mi>R</mi><mi>i</mi><mrow><mo stretchy="false">(</mo><mi>k</mi><mo stretchy="false">)</mo></mrow></msubsup></mrow></mrow><mo rspace="0.558em">=</mo><mrow><mrow><mfrac><mn>1</mn><mn>2</mn></mfrac><mo lspace="0.167em" rspace="0em">​</mo><mi>log</mi><mo lspace="0.167em" rspace="0em">​</mo><mfrac><msub><mi>λ</mi><mi>i</mi></msub><msubsup><mi>D</mi><mi>i</mi><mrow><mo stretchy="false">(</mo><mn>1</mn><mo stretchy="false">)</mo></mrow></msubsup></mfrac></mrow><mo>+</mo><mrow><mfrac><mn>1</mn><mn>2</mn></mfrac><mo lspace="0.167em" rspace="0em">​</mo><mi>log</mi><mo lspace="0.167em" rspace="0em">​</mo><mfrac><msubsup><mi>D</mi><mi>i</mi><mrow><mo stretchy="false">(</mo><mn>1</mn><mo stretchy="false">)</mo></mrow></msubsup><msubsup><mi>D</mi><mi>i</mi><mrow><mo stretchy="false">(</mo><mn>2</mn><mo stretchy="false">)</mo></mrow></msubsup></mfrac></mrow><mo>+</mo><mo lspace="0em" rspace="0em">⋯</mo><mo>+</mo><mrow><mfrac><mn>1</mn><mn>2</mn></mfrac><mo lspace="0.167em" rspace="0em">​</mo><mi>log</mi><mo lspace="0.167em" rspace="0em">​</mo><mfrac><msubsup><mi>D</mi><mi>i</mi><mrow><mo stretchy="false">(</mo><mrow><mi>K</mi><mo>−</mo><mn>1</mn></mrow><mo stretchy="false">)</mo></mrow></msubsup><msubsup><mi>D</mi><mi>i</mi><mrow><mo stretchy="false">(</mo><mi>K</mi><mo stretchy="false">)</mo></mrow></msubsup></mfrac></mrow></mrow><mo lspace="0.558em" rspace="0.558em">=</mo><mrow><mfrac><mn>1</mn><mn>2</mn></mfrac><mo lspace="0.167em" rspace="0em">​</mo><mi>log</mi><mo lspace="0.167em" rspace="0em">​</mo><mfrac><msub><mi>λ</mi><mi>i</mi></msub><msubsup><mi>D</mi><mi>i</mi><mrow><mo stretchy="false">(</mo><mi>K</mi><mo stretchy="false">)</mo></mrow></msubsup></mfrac></mrow></mrow><mo>,</mo></mrow><annotation encoding="application/x-tex">\sum_{k=1}^{K}\Delta R_{i}^{(k)}\;=\;\frac{1}{2}\log\frac{\lambda_{i}}{D_{i}^{(1)}}+\frac{1}{2}\log\frac{D_{i}^{(1)}}{D_{i}^{(2)}}+\cdots+\frac{1}{2}\log\frac{D_{i}^{(K-1)}}{D_{i}^{(K)}}\;=\;\frac{1}{2}\log\frac{\lambda_{i}}{D_{i}^{(K)}},</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="S4.p5.3" class="ltx_p"><span id="S4.p5.3.1" class="ltx_text">which equals exactly the single-shot rate at <math id="S4.p5.m21" class="ltx_Math" alttext="D_{i}^{(K)}" display="inline" intent=":literal"><semantics><msubsup><mi>D</mi><mi>i</mi><mrow><mo stretchy="false">(</mo><mi>K</mi><mo stretchy="false">)</mo></mrow></msubsup><annotation encoding="application/x-tex">D_{i}^{(K)}</annotation></semantics></math>. As illustrated
in Figure <a href="#S4.F4" title="Figure 4 ‣ 4 Our Theoretical Contribution ‣ Multi-Bitwidth Quantization for LLMs Using Additive Codebooks" class="ltx_ref"><span class="ltx_text ltx_ref_tag">4</span></a>, the <math id="S4.p5.m22" class="ltx_Math" alttext="\Delta R^{(k)}" display="inline" intent=":literal"><semantics><mrow><mi mathvariant="normal">Δ</mi><mo lspace="0em" rspace="0em">​</mo><msup><mi>R</mi><mrow><mo stretchy="false">(</mo><mi>k</mi><mo stretchy="false">)</mo></mrow></msup></mrow><annotation encoding="application/x-tex">\Delta R^{(k)}</annotation></semantics></math> brackets
partition the total rate between refinement stages identically
to single-shot coding at <math id="S4.p5.m23" class="ltx_Math" alttext="D_{K}" display="inline" intent=":literal"><semantics><msub><mi>D</mi><mi>K</mi></msub><annotation encoding="application/x-tex">D_{K}</annotation></semantics></math>, confirming that refinement incurs no rate
overhead. Finally, at each stage <math id="S4.p5.m24" class="ltx_Math" alttext="k" display="inline" intent=":literal"><semantics><mi>k</mi><annotation encoding="application/x-tex">k</annotation></semantics></math>, the reconstruction
<math id="S4.p5.m25" class="ltx_Math" alttext="\widehat{\bm{\mathsf{W}}}^{(k)}" display="inline" intent=":literal"><semantics><msup><mover accent="true"><mi>𝗪</mi><mo>^</mo></mover><mrow><mo stretchy="false">(</mo><mi>k</mi><mo stretchy="false">)</mo></mrow></msup><annotation encoding="application/x-tex">\widehat{\bm{\mathsf{W}}}^{(k)}</annotation></semantics></math> is recovered from
<math id="S4.p5.m26" class="ltx_Math" alttext="\widehat{\bm{\mathsf{Y}}}^{(k)}" display="inline" intent=":literal"><semantics><msup><mover accent="true"><mi>𝗬</mi><mo>^</mo></mover><mrow><mo stretchy="false">(</mo><mi>k</mi><mo stretchy="false">)</mo></mrow></msup><annotation encoding="application/x-tex">\widehat{\bm{\mathsf{Y}}}^{(k)}</annotation></semantics></math>
by inverting <math id="S4.p5.m27" class="ltx_Math" alttext="\bm{\mathsf{Y}}=\bm{\mathsf{W}}\bm{X}" display="inline" intent=":literal"><semantics><mrow><mi>𝗬</mi><mo>=</mo><mrow><mi>𝗪</mi><mo lspace="0em" rspace="0em">​</mo><mi>𝑿</mi></mrow></mrow><annotation encoding="application/x-tex">\bm{\mathsf{Y}}=\bm{\mathsf{W}}\bm{X}</annotation></semantics></math> (depending on the
shape of <math id="S4.p5.m28" class="ltx_Math" alttext="\bm{X}" display="inline" intent=":literal"><semantics><mi>𝑿</mi><annotation encoding="application/x-tex">\bm{X}</annotation></semantics></math>, see Theorem <a href="#Thmtheorem3" title="Theorem 3 (WMSE Rate-Distortion Equivalence). ‣ F.1 Rate-Distortion Under Weighted MSE ‣ Appendix F Proofs of Auxiliary Results ‣ Multi-Bitwidth Quantization for LLMs Using Additive Codebooks" class="ltx_ref"><span class="ltx_text ltx_ref_tag">3</span></a>). Since this inversion map is identical at every
stage <math id="S4.p5.m29" class="ltx_Math" alttext="k" display="inline" intent=":literal"><semantics><mi>k</mi><annotation encoding="application/x-tex">k</annotation></semantics></math>, the Markov chain on <math id="S4.p5.m30" class="ltx_Math" alttext="\bm{\mathsf{y}}" display="inline" intent=":literal"><semantics><mi>𝘆</mi><annotation encoding="application/x-tex">\bm{\mathsf{y}}</annotation></semantics></math> carries over to <math id="S4.p5.m31" class="ltx_Math" alttext="\bm{\mathsf{W}}" display="inline" intent=":literal"><semantics><mi>𝗪</mi><annotation encoding="application/x-tex">\bm{\mathsf{W}}</annotation></semantics></math>,
<math id="S4.p5.m32" class="ltx_Math" alttext="\widehat{\bm{\mathsf{W}}}^{(1)}\;\to\;\cdots\;\to\;\widehat{\bm{\mathsf{W}}}^{(K)}\;\to\;\bm{\mathsf{W}}," display="inline" intent=":literal"><semantics><mrow><mrow><msup><mover accent="true"><mi>𝗪</mi><mo>^</mo></mover><mrow><mo stretchy="false">(</mo><mn>1</mn><mo stretchy="false">)</mo></mrow></msup><mo lspace="0.558em" stretchy="false">→</mo><mo>⋯</mo><mo rspace="0.558em" stretchy="false">→</mo><msup><mover accent="true"><mi>𝗪</mi><mo>^</mo></mover><mrow><mo stretchy="false">(</mo><mi>K</mi><mo stretchy="false">)</mo></mrow></msup><mo rspace="0.558em" stretchy="false">→</mo><mi>𝗪</mi></mrow><mo>,</mo></mrow><annotation encoding="application/x-tex">\widehat{\bm{\mathsf{W}}}^{(1)}\;\to\;\cdots\;\to\;\widehat{\bm{\mathsf{W}}}^{(K)}\;\to\;\bm{\mathsf{W}},</annotation></semantics></math> and the distortion equivalence gives
<math id="S4.p5.m33" class="ltx_Math" alttext="d_{\mathrm{WMSE}}(\bm{\mathsf{W}},\widehat{\bm{\mathsf{W}}}^{(k)})=D_{k}" display="inline" intent=":literal"><semantics><mrow><mrow><msub><mi>d</mi><mi>WMSE</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>𝗪</mi><mo>,</mo><msup><mover accent="true"><mi>𝗪</mi><mo>^</mo></mover><mrow><mo stretchy="false">(</mo><mi>k</mi><mo stretchy="false">)</mo></mrow></msup><mo stretchy="false">)</mo></mrow></mrow><mo>=</mo><msub><mi>D</mi><mi>k</mi></msub></mrow><annotation encoding="application/x-tex">d_{\mathrm{WMSE}}(\bm{\mathsf{W}},\widehat{\bm{\mathsf{W}}}^{(k)})=D_{k}</annotation></semantics></math> at each stage,
establishing successive refinability of
<math id="S4.p5.m34" class="ltx_Math" alttext="(\bm{\mathsf{W}},d_{\mathrm{WMSE}})" display="inline" intent=":literal"><semantics><mrow><mo stretchy="false">(</mo><mi>𝗪</mi><mo>,</mo><msub><mi>d</mi><mi>WMSE</mi></msub><mo stretchy="false">)</mo></mrow><annotation encoding="application/x-tex">(\bm{\mathsf{W}},d_{\mathrm{WMSE}})</annotation></semantics></math>.
∎</span></p>
</div>
</div>
</section>
<section id="S5" class="ltx_section">
<h2 class="ltx_title ltx_title_section"><span class="ltx_tag ltx_tag_section">5 </span>Our Application: Drop-by-Drop (DbyD)</h2>

<div id="S5.p1" class="ltx_para ltx_noindent">
<p id="S5.p1.1" class="ltx_p">This theory of successive refinability suggests a practical objective: a single compressed model should support multiple rate–distortion operating points without retraining. Motivated by our information-theoretic procedure, we now focus on a practical quantization scheme that can achieve such multi-rate operation under the same distortion measure <math id="S5.p1.m1" class="ltx_Math" alttext="(\bm{\mathsf{W}},d_{\mathrm{WMSE}})" display="inline" intent=":literal"><semantics><mrow><mo stretchy="false">(</mo><mi>𝗪</mi><mo>,</mo><msub><mi>d</mi><mi>WMSE</mi></msub><mo stretchy="false">)</mo></mrow><annotation encoding="application/x-tex">(\bm{\mathsf{W}},d_{\mathrm{WMSE}})</annotation></semantics></math> used during quantization. AQLM naturally instantiates this structure: each additive codebook can correspond to a refinement layer.</p>
</div>
<figure id="S5.F5" class="ltx_figure ltx_align_floatright" style="width:32%;"><object type="image/svg+xml" data="2606.12876v1/loops.svg" id="S5.F5.g1" class="ltx_graphics ltx_centering ltx_img_landscape" style="aspect-ratio:176/112;" width="176" height="112"></object>
<figcaption class="ltx_caption ltx_centering"><span class="ltx_tag ltx_tag_figure">Figure 5: </span>Visual of <math id="S5.F5.m2" class="ltx_Math" alttext="\mathcal{L}_{\mathrm{DbyD}}" display="inline" intent=":literal"><semantics><msub><mi class="ltx_font_mathcaligraphic">ℒ</mi><mi>DbyD</mi></msub><annotation encoding="application/x-tex">\mathcal{L}_{\mathrm{DbyD}}</annotation></semantics></math></figcaption>
</figure>
<div id="S5.p2" class="ltx_para ltx_noindent">
<p id="S5.p2.1" class="ltx_p">However, it is our Drop-by-Drop loss that ensures this <em id="S5.p2.1.1" class="ltx_emph ltx_font_italic">droppable</em> property holds in practice, where codebooks can be dropped at inference to provide a smooth tradeoff between compression rate and reconstruction quality.</p>
</div>
<div id="S5.p3" class="ltx_para ltx_noindent">
<p id="S5.p3.1" class="ltx_p">We introduce a novel training objective, the <span id="S5.p3.1.1" class="ltx_text ltx_font_bold">Drop-by-Drop loss</span>, that enables a single quantized model to be evaluated using different numbers of codebooks, without retraining or finetuning. This is inspired by Matryoshka Representation Learning. This modifies the codebook update phase of the AQLM pipeline in Appendix <a href="#A3" title="Appendix C AQLM’s Optimization Process ‣ Multi-Bitwidth Quantization for LLMs Using Additive Codebooks" class="ltx_ref"><span class="ltx_text ltx_ref_tag">C</span></a>. The objective is to enforce a hierarchical organization where early codebooks capture coarse but fundamental weight features and subsequent ones provide progressively finer refinements. As illustrated by the nested ellipsoids in Figure <a href="#S5.F5" title="Figure 5 ‣ 5 Our Application: Drop-by-Drop (DbyD) ‣ Multi-Bitwidth Quantization for LLMs Using Additive Codebooks" class="ltx_ref"><span class="ltx_text ltx_ref_tag">5</span></a>, each stage <math id="S5.p3.m1" class="ltx_Math" alttext="k" display="inline" intent=":literal"><semantics><mi>k</mi><annotation encoding="application/x-tex">k</annotation></semantics></math> corresponds to a cumulative sum of codebooks. The innermost contribution (<math id="S5.p3.m2" class="ltx_Math" alttext="C_{1}" display="inline" intent=":literal"><semantics><msub><mi>C</mi><mn>1</mn></msub><annotation encoding="application/x-tex">C_{1}</annotation></semantics></math>) is preserved across all levels, emphasizing the incremental nature of the representation. To achieve this hierarchical organization, given a fixed total of <math id="S5.p3.m3" class="ltx_Math" alttext="M" display="inline" intent=":literal"><semantics><mi>M</mi><annotation encoding="application/x-tex">M</annotation></semantics></math> codebooks, we explicitly simulate different quantization granularities during training by forming <span id="S5.p3.1.2" class="ltx_text ltx_font_italic">partial reconstructions</span>. For each stage <math id="S5.p3.m4" class="ltx_Math" alttext="k=1,\dotsc,M" display="inline" intent=":literal"><semantics><mrow><mrow><mi>k</mi><mo>=</mo><mn>1</mn></mrow><mo>,</mo><mi mathvariant="normal">…</mi><mo>,</mo><mi>M</mi></mrow><annotation encoding="application/x-tex">k=1,\dotsc,M</annotation></semantics></math>, we reconstruct the weights using only the first <math id="S5.p3.m5" class="ltx_Math" alttext="k" display="inline" intent=":literal"><semantics><mi>k</mi><annotation encoding="application/x-tex">k</annotation></semantics></math> codebooks where <math id="S5.p3.m6" class="ltx_Math" alttext="C_{m}\in\mathbb{R}^{g\times 2^{B}}" display="inline" intent=":literal"><semantics><mrow><msub><mi>C</mi><mi>m</mi></msub><mo>∈</mo><msup><mi>ℝ</mi><mrow><mi>g</mi><mo lspace="0.222em" rspace="0.222em">×</mo><msup><mn>2</mn><mi>B</mi></msup></mrow></msup></mrow><annotation encoding="application/x-tex">C_{m}\in\mathbb{R}^{g\times 2^{B}}</annotation></semantics></math> is the <math id="S5.p3.m7" class="ltx_Math" alttext="m" display="inline" intent=":literal"><semantics><mi>m</mi><annotation encoding="application/x-tex">m</annotation></semantics></math>-th codebook and <math id="S5.p3.m8" class="ltx_Math" alttext="b_{ijm}\in\{0,1\}^{2^{B}}" display="inline" intent=":literal"><semantics><mrow><msub><mi>b</mi><mrow><mi>i</mi><mo lspace="0em" rspace="0em">​</mo><mi>j</mi><mo lspace="0em" rspace="0em">​</mo><mi>m</mi></mrow></msub><mo>∈</mo><msup><mrow><mo stretchy="false">{</mo><mn>0</mn><mo>,</mo><mn>1</mn><mo stretchy="false">}</mo></mrow><msup><mn>2</mn><mi>B</mi></msup></msup></mrow><annotation encoding="application/x-tex">b_{ijm}\in\{0,1\}^{2^{B}}</annotation></semantics></math>
is a one-hot vector indicating the selected codeword:</p>
<table id="S5.Ex5" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="S5.Ex5.m1" class="ltx_Math" alttext="\widehat{\bm{\mathsf{W}}}_{i}^{(k)}=\sum_{m=1}^{k}C_{m}b_{i,1,m}\oplus\cdots\oplus\sum_{m=1}^{k}C_{m}b_{i,d_{\mathrm{in}}/g,m}" display="block" intent=":literal"><semantics><mrow><msubsup><mover accent="true"><mi>𝗪</mi><mo>^</mo></mover><mi>i</mi><mrow><mo stretchy="false">(</mo><mi>k</mi><mo stretchy="false">)</mo></mrow></msubsup><mo rspace="0.111em">=</mo><mrow><mrow><munderover><mo movablelimits="false">∑</mo><mrow><mi>m</mi><mo>=</mo><mn>1</mn></mrow><mi>k</mi></munderover><mrow><msub><mi>C</mi><mi>m</mi></msub><mo lspace="0em" rspace="0em">​</mo><msub><mi>b</mi><mrow><mi>i</mi><mo>,</mo><mn>1</mn><mo>,</mo><mi>m</mi></mrow></msub></mrow></mrow><mo>⊕</mo><mo lspace="0em" rspace="0em">⋯</mo><mo rspace="0.055em">⊕</mo><mrow><munderover><mo movablelimits="false">∑</mo><mrow><mi>m</mi><mo>=</mo><mn>1</mn></mrow><mi>k</mi></munderover><mrow><msub><mi>C</mi><mi>m</mi></msub><mo lspace="0em" rspace="0em">​</mo><msub><mi>b</mi><mrow><mi>i</mi><mo>,</mo><mrow><msub><mi>d</mi><mi>in</mi></msub><mo>/</mo><mi>g</mi></mrow><mo>,</mo><mi>m</mi></mrow></msub></mrow></mrow></mrow></mrow><annotation encoding="application/x-tex">\widehat{\bm{\mathsf{W}}}_{i}^{(k)}=\sum_{m=1}^{k}C_{m}b_{i,1,m}\oplus\cdots\oplus\sum_{m=1}^{k}C_{m}b_{i,d_{\mathrm{in}}/g,m}</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
</div>
<div id="S5.p4" class="ltx_para ltx_noindent">
<p id="S5.p4.1" class="ltx_p">This yields an intermediate approximation
<math id="S5.p4.m1" class="ltx_Math" alttext="\widehat{\bm{\mathsf{W}}}^{(k)}" display="inline" intent=":literal"><semantics><msup><mover accent="true"><mi>𝗪</mi><mo>^</mo></mover><mrow><mo stretchy="false">(</mo><mi>k</mi><mo stretchy="false">)</mo></mrow></msup><annotation encoding="application/x-tex">\widehat{\bm{\mathsf{W}}}^{(k)}</annotation></semantics></math>, exposing the model during training to all
deployment-time precision levels. For each partial reconstruction, we measure distortion using a task-weighted MSE:</p>
</div>
<div id="S5.p5" class="ltx_para ltx_noindent">
<table id="S5.Ex6" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="S5.Ex6.m1" class="ltx_Math" alttext="D^{(k)}=\frac{1}{d_{\text{out}}\,n}\left\|(\bm{\mathsf{W}}-\bm{\widehat{\mathsf{W}}}^{(k)})\,\bm{X}\right\|_{F}^{2}=\frac{1}{d_{\text{out}}}\operatorname{tr}\!\left[(\bm{\mathsf{W}}-\bm{\widehat{\mathsf{W}}}^{(k)})\frac{1}{n}\bm{X}\bm{X}^{\!\top}(\bm{\mathsf{W}}-\bm{\widehat{\mathsf{W}}}^{(k)})^{\!\top}\right]." display="block" intent=":literal"><semantics><mrow><mrow><msup><mi>D</mi><mrow><mo stretchy="false">(</mo><mi>k</mi><mo stretchy="false">)</mo></mrow></msup><mo>=</mo><mrow><mfrac><mn>1</mn><mrow><msub><mi>d</mi><mtext>out</mtext></msub><mo lspace="0.170em" rspace="0em">​</mo><mi>n</mi></mrow></mfrac><mo lspace="0em" rspace="0em">​</mo><msubsup><mrow><mo>‖</mo><mrow><mrow><mo stretchy="false">(</mo><mrow><mi>𝗪</mi><mo>−</mo><msup><mover accent="true"><mi>𝗪</mi><mo>^</mo></mover><mrow><mo stretchy="false">(</mo><mi>k</mi><mo stretchy="false">)</mo></mrow></msup></mrow><mo stretchy="false">)</mo></mrow><mo lspace="0.170em" rspace="0em">​</mo><mi>𝑿</mi></mrow><mo>‖</mo></mrow><mi>F</mi><mn>2</mn></msubsup></mrow><mo>=</mo><mrow><mfrac><mn>1</mn><msub><mi>d</mi><mtext>out</mtext></msub></mfrac><mo lspace="0.167em" rspace="0em">​</mo><mrow><mpadded style="width:0.670em;" width="0.670em"><mi>tr</mi></mpadded><mo>⁡</mo><mrow><mo>[</mo><mrow><mrow><mo stretchy="false">(</mo><mrow><mi>𝗪</mi><mo>−</mo><msup><mover accent="true"><mi>𝗪</mi><mo>^</mo></mover><mrow><mo stretchy="false">(</mo><mi>k</mi><mo stretchy="false">)</mo></mrow></msup></mrow><mo stretchy="false">)</mo></mrow><mo lspace="0em" rspace="0em">​</mo><mfrac><mn>1</mn><mi>n</mi></mfrac><mo lspace="0em" rspace="0em">​</mo><mi>𝑿</mi><mo lspace="0em" rspace="0em">​</mo><msup><mi>𝑿</mi><mo>⊤</mo></msup><mo lspace="0em" rspace="0em">​</mo><msup><mrow><mo stretchy="false">(</mo><mrow><mi>𝗪</mi><mo>−</mo><msup><mover accent="true"><mi>𝗪</mi><mo>^</mo></mover><mrow><mo stretchy="false">(</mo><mi>k</mi><mo stretchy="false">)</mo></mrow></msup></mrow><mo stretchy="false">)</mo></mrow><mo>⊤</mo></msup></mrow><mo>]</mo></mrow></mrow></mrow></mrow><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">D^{(k)}=\frac{1}{d_{\text{out}}\,n}\left\|(\bm{\mathsf{W}}-\bm{\widehat{\mathsf{W}}}^{(k)})\,\bm{X}\right\|_{F}^{2}=\frac{1}{d_{\text{out}}}\operatorname{tr}\!\left[(\bm{\mathsf{W}}-\bm{\widehat{\mathsf{W}}}^{(k)})\frac{1}{n}\bm{X}\bm{X}^{\!\top}(\bm{\mathsf{W}}-\bm{\widehat{\mathsf{W}}}^{(k)})^{\!\top}\right].</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
</div>
<div id="S5.p6" class="ltx_para ltx_noindent">
<p id="S5.p6.1" class="ltx_p">The overall Drop-by-Drop objective aggregates these distortions across refinement stages: <math id="S5.p6.m1" class="ltx_Math" alttext="\mathcal{L}_{\mathrm{DbyD}}=\sum_{k=1}^{K}\lambda_{k}\,D^{(k)}," display="inline" intent=":literal"><semantics><mrow><mrow><msub><mi class="ltx_font_mathcaligraphic">ℒ</mi><mi>DbyD</mi></msub><mo rspace="0.111em">=</mo><mrow><msubsup><mo>∑</mo><mrow><mi>k</mi><mo>=</mo><mn>1</mn></mrow><mi>K</mi></msubsup><mrow><msub><mi>λ</mi><mi>k</mi></msub><mo lspace="0em" rspace="0em">​</mo><msup><mi>D</mi><mrow><mo stretchy="false">(</mo><mi>k</mi><mo stretchy="false">)</mo></mrow></msup></mrow></mrow></mrow><mo>,</mo></mrow><annotation encoding="application/x-tex">\mathcal{L}_{\mathrm{DbyD}}=\sum_{k=1}^{K}\lambda_{k}\,D^{(k)},</annotation></semantics></math> where <math id="S5.p6.m2" class="ltx_Math" alttext="K\leq M" display="inline" intent=":literal"><semantics><mrow><mi>K</mi><mo>≤</mo><mi>M</mi></mrow><annotation encoding="application/x-tex">K\leq M</annotation></semantics></math> is the number of supervised refinement stages and <math id="S5.p6.m3" class="ltx_Math" alttext="\lambda_{k}\geq 0" display="inline" intent=":literal"><semantics><mrow><msub><mi>λ</mi><mi>k</mi></msub><mo>≥</mo><mn>0</mn></mrow><annotation encoding="application/x-tex">\lambda_{k}\geq 0</annotation></semantics></math> are weighting coefficients that control the relative importance of coarse versus fine reconstructions. This training logic is summarized in Algorithm <a href="#alg1" title="Algorithm 1 ‣ 5 Our Application: Drop-by-Drop (DbyD) ‣ Multi-Bitwidth Quantization for LLMs Using Additive Codebooks" class="ltx_ref"><span class="ltx_text ltx_ref_tag">1</span></a>, and the full algorithm can be found in Appendix <a href="#A7.SS0.SSS0.Px1" title="Drop-by-Drop Quantization for Resource-Constrained Inference ‣ Appendix G Algorithm 1 ‣ Multi-Bitwidth Quantization for LLMs Using Additive Codebooks" class="ltx_ref"><span class="ltx_text ltx_ref_tag">G</span></a> where blue text shows the changes made to AQLM.</p>
</div>
<figure id="alg1" class="ltx_float ltx_float_algorithm ltx_framed ltx_framed_top">
<figcaption class="ltx_caption"><span class="ltx_tag ltx_tag_float"><span id="alg1.3" class="ltx_text ltx_font_bold">Algorithm 1</span> </span> Drop-by-Drop Quantization for Resource-Constrained Inference</figcaption>
<div id="alg1.4" class="ltx_listing ltx_framed ltx_framed_topbottom ltx_listing">
<div id="alg1.l1" class="ltx_listingline">
            <span class="ltx_tag ltx_tag_listingline">1:</span>
            
            
          model, data

</div>
<div id="alg1.l2" class="ltx_listingline">
            <span class="ltx_tag ltx_tag_listingline">2:</span>
            
            
          <math id="alg1.l2.m1" class="ltx_Math" alttext="X_{\text{block}}:=" display="inline" intent=":literal"><semantics><mrow><msub><mi>X</mi><mtext>block</mtext></msub><mo>:=</mo><mphantom></mphantom></mrow><annotation encoding="application/x-tex">X_{\text{block}}:=</annotation></semantics></math> model.input_embeddings(data)

</div>
<div id="alg1.l3" class="ltx_listingline">
            <span class="ltx_tag ltx_tag_listingline">3:</span>
            
            
          <span id="alg1.l3.2" class="ltx_text ltx_font_bold">for</span> layer <math id="alg1.l3.m1" class="ltx_Math" alttext="\in" display="inline" intent=":literal"><semantics><mo>∈</mo><annotation encoding="application/x-tex">\in</annotation></semantics></math> linear_layers(block) <span id="alg1.l3.3" class="ltx_text ltx_font_bold">do</span>

</div>
<div id="alg1.l4" class="ltx_listingline">
            <span class="ltx_tag ltx_tag_listingline">4:</span>
            
            
            <math id="alg1.l4.m1" class="ltx_Math" alttext="W:=" display="inline" intent=":literal"><semantics><mrow><mi>W</mi><mo>:=</mo><mphantom></mphantom></mrow><annotation encoding="application/x-tex">W:=</annotation></semantics></math> layer.weight

</div>
<div id="alg1.l5" class="ltx_listingline">
            <span class="ltx_tag ltx_tag_listingline">5:</span>
            
            
            <math id="alg1.l5.m1" class="ltx_Math" alttext="X:=" display="inline" intent=":literal"><semantics><mrow><mi>X</mi><mo>:=</mo><mphantom></mphantom></mrow><annotation encoding="application/x-tex">X:=</annotation></semantics></math> layer_inputs(layer, <math id="alg1.l5.m2" class="ltx_Math" alttext="X_{\text{block}}" display="inline" intent=":literal"><semantics><msub><mi>X</mi><mtext>block</mtext></msub><annotation encoding="application/x-tex">X_{\text{block}}</annotation></semantics></math>)

</div>
<div id="alg1.l6" class="ltx_listingline">
            <span class="ltx_tag ltx_tag_listingline">6:</span>
            
            
            <math id="alg1.l6.m1" class="ltx_Math" alttext="C,b,s:=" display="inline" intent=":literal"><semantics><mrow><mi>C</mi><mo>,</mo><mi>b</mi><mo>,</mo><mrow><mi>s</mi><mo>:=</mo><mphantom></mphantom></mrow></mrow><annotation encoding="application/x-tex">C,b,s:=</annotation></semantics></math> k_means_initialize(<math id="alg1.l6.m2" class="ltx_Math" alttext="W" display="inline" intent=":literal"><semantics><mi>W</mi><annotation encoding="application/x-tex">W</annotation></semantics></math>)

</div>
<div id="alg1.l7" class="ltx_listingline">
            <span class="ltx_tag ltx_tag_listingline">7:</span>
            
            
            <span id="alg1.l7.2" class="ltx_text ltx_font_bold">while</span> loss improves by at least <math id="alg1.l7.m1" class="ltx_Math" alttext="\tau" display="inline" intent=":literal"><semantics><mi>τ</mi><annotation encoding="application/x-tex">\tau</annotation></semantics></math> <span id="alg1.l7.3" class="ltx_text ltx_font_bold">do</span>

</div>
<div id="alg1.l8" class="ltx_listingline">
            <span class="ltx_tag ltx_tag_listingline">8:</span>
            
            
             <span id="alg1.l8.2" class="ltx_text ltx_font_bold">for</span> <math id="alg1.l8.m1" class="ltx_Math" alttext="k=1,\dotsc,M" display="inline" intent=":literal"><semantics><mrow><mrow><mi style="--ltx-fg-color:#0000FF;" mathcolor="#0000FF">k</mi><mo style="--ltx-fg-color:#0000FF;" mathcolor="#0000FF">=</mo><mn style="--ltx-fg-color:#0000FF;" mathcolor="#0000FF">1</mn></mrow><mo style="--ltx-fg-color:#0000FF;" mathcolor="#0000FF">,</mo><mi mathvariant="normal">…</mi><mo style="--ltx-fg-color:#0000FF;" mathcolor="#0000FF">,</mo><mi style="--ltx-fg-color:#0000FF;" mathcolor="#0000FF">M</mi></mrow><annotation encoding="application/x-tex">k=1,\dotsc,M</annotation></semantics></math> <span id="alg1.l8.3" class="ltx_text ltx_font_bold">do</span>

</div>
<div id="alg1.l9" class="ltx_listingline">
            <span class="ltx_tag ltx_tag_listingline">9:</span>
            
            
               <math id="alg1.l9.m1" class="ltx_Math" alttext="\widehat{W}^{(k)}\leftarrow" display="inline" intent=":literal"><semantics><mrow><msup><mover accent="true"><mi style="--ltx-fg-color:#0000FF;" mathcolor="#0000FF">W</mi><mo style="--ltx-fg-color:#000000;" mathcolor="#000000">^</mo></mover><mrow><mo style="--ltx-fg-color:#0000FF;" mathcolor="#0000FF" stretchy="false">(</mo><mi style="--ltx-fg-color:#0000FF;" mathcolor="#0000FF">k</mi><mo style="--ltx-fg-color:#0000FF;" mathcolor="#0000FF" stretchy="false">)</mo></mrow></msup><mo style="--ltx-fg-color:#0000FF;" mathcolor="#0000FF" stretchy="false">←</mo><mphantom></mphantom></mrow><annotation encoding="application/x-tex">\widehat{W}^{(k)}\leftarrow</annotation></semantics></math><span id="alg1.l9.2" class="ltx_text" style="--ltx-fg-color:#0000FF;"> partial reconstruction using the first <math id="alg1.l9.m2" class="ltx_Math" alttext="k" display="inline" intent=":literal"><semantics><mi style="--ltx-fg-color:#0000FF;" mathcolor="#0000FF">k</mi><annotation encoding="application/x-tex">k</annotation></semantics></math> codebooks</span>

</div>
<div id="alg1.l10" class="ltx_listingline">
            <span class="ltx_tag ltx_tag_listingline">10:</span>
            
            
               <math id="alg1.l10.m1" class="ltx_Math" alttext="\mathcal{L}^{(k)}\leftarrow\lambda_{k}\cdot\frac{1}{d_{\text{out}}}\operatorname{tr}\!\left[(W-\widehat{W}^{(k)})\left(\frac{1}{n}XX^{\top}\right)(W-\widehat{W}^{(k)})^{\top}\right]" display="inline" intent=":literal"><semantics><mrow><msup><mi style="--ltx-fg-color:#0000FF;" class="ltx_font_mathcaligraphic" mathcolor="#0000FF">ℒ</mi><mrow><mo style="--ltx-fg-color:#0000FF;" mathcolor="#0000FF" stretchy="false">(</mo><mi style="--ltx-fg-color:#0000FF;" mathcolor="#0000FF">k</mi><mo style="--ltx-fg-color:#0000FF;" mathcolor="#0000FF" stretchy="false">)</mo></mrow></msup><mo style="--ltx-fg-color:#0000FF;" mathcolor="#0000FF" stretchy="false">←</mo><mrow><mrow><msub><mi style="--ltx-fg-color:#0000FF;" mathcolor="#0000FF">λ</mi><mi style="--ltx-fg-color:#0000FF;" mathcolor="#0000FF">k</mi></msub><mo style="--ltx-fg-color:#0000FF;" lspace="0.222em" mathcolor="#0000FF" rspace="0.222em">⋅</mo><mfrac style="--ltx-fg-color:#0000FF;" mathcolor="#0000FF"><mn style="--ltx-fg-color:#0000FF;" mathcolor="#0000FF">1</mn><msub><mi style="--ltx-fg-color:#0000FF;" mathcolor="#0000FF">d</mi><mtext style="--ltx-fg-color:#0000FF;" mathcolor="#0000FF">out</mtext></msub></mfrac></mrow><mo lspace="0.167em" rspace="0em">​</mo><mrow><mpadded style="width:0.670em;" width="0.670em"><mi style="--ltx-fg-color:#0000FF;" mathcolor="#0000FF">tr</mi></mpadded><mo>⁡</mo><mrow><mo style="--ltx-fg-color:#0000FF;" mathcolor="#0000FF">[</mo><mrow><mrow><mo style="--ltx-fg-color:#0000FF;" mathcolor="#0000FF" stretchy="false">(</mo><mrow><mi style="--ltx-fg-color:#0000FF;" mathcolor="#0000FF">W</mi><mo style="--ltx-fg-color:#0000FF;" mathcolor="#0000FF">−</mo><msup><mover accent="true"><mi style="--ltx-fg-color:#0000FF;" mathcolor="#0000FF">W</mi><mo style="--ltx-fg-color:#000000;" mathcolor="#000000">^</mo></mover><mrow><mo style="--ltx-fg-color:#0000FF;" mathcolor="#0000FF" stretchy="false">(</mo><mi style="--ltx-fg-color:#0000FF;" mathcolor="#0000FF">k</mi><mo style="--ltx-fg-color:#0000FF;" mathcolor="#0000FF" stretchy="false">)</mo></mrow></msup></mrow><mo style="--ltx-fg-color:#0000FF;" mathcolor="#0000FF" stretchy="false">)</mo></mrow><mo lspace="0em" rspace="0em">​</mo><mrow><mo style="--ltx-fg-color:#0000FF;" mathcolor="#0000FF">(</mo><mrow><mfrac style="--ltx-fg-color:#0000FF;" mathcolor="#0000FF"><mn style="--ltx-fg-color:#0000FF;" mathcolor="#0000FF">1</mn><mi style="--ltx-fg-color:#0000FF;" mathcolor="#0000FF">n</mi></mfrac><mo lspace="0em" rspace="0em">​</mo><mi style="--ltx-fg-color:#0000FF;" mathcolor="#0000FF">X</mi><mo lspace="0em" rspace="0em">​</mo><msup><mi style="--ltx-fg-color:#0000FF;" mathcolor="#0000FF">X</mi><mo style="--ltx-fg-color:#0000FF;" mathcolor="#0000FF">⊤</mo></msup></mrow><mo style="--ltx-fg-color:#0000FF;" mathcolor="#0000FF">)</mo></mrow><mo lspace="0em" rspace="0em">​</mo><msup><mrow><mo style="--ltx-fg-color:#0000FF;" mathcolor="#0000FF" stretchy="false">(</mo><mrow><mi style="--ltx-fg-color:#0000FF;" mathcolor="#0000FF">W</mi><mo style="--ltx-fg-color:#0000FF;" mathcolor="#0000FF">−</mo><msup><mover accent="true"><mi style="--ltx-fg-color:#0000FF;" mathcolor="#0000FF">W</mi><mo style="--ltx-fg-color:#000000;" mathcolor="#000000">^</mo></mover><mrow><mo style="--ltx-fg-color:#0000FF;" mathcolor="#0000FF" stretchy="false">(</mo><mi style="--ltx-fg-color:#0000FF;" mathcolor="#0000FF">k</mi><mo style="--ltx-fg-color:#0000FF;" mathcolor="#0000FF" stretchy="false">)</mo></mrow></msup></mrow><mo style="--ltx-fg-color:#0000FF;" mathcolor="#0000FF" stretchy="false">)</mo></mrow><mo style="--ltx-fg-color:#0000FF;" mathcolor="#0000FF">⊤</mo></msup></mrow><mo style="--ltx-fg-color:#0000FF;" mathcolor="#0000FF">]</mo></mrow></mrow></mrow></mrow><annotation encoding="application/x-tex">\mathcal{L}^{(k)}\leftarrow\lambda_{k}\cdot\frac{1}{d_{\text{out}}}\operatorname{tr}\!\left[(W-\widehat{W}^{(k)})\left(\frac{1}{n}XX^{\top}\right)(W-\widehat{W}^{(k)})^{\top}\right]</annotation></semantics></math>

</div>
<div id="alg1.l11" class="ltx_listingline">
            <span class="ltx_tag ltx_tag_listingline">11:</span>
            
            
             <span id="alg1.l11.2" class="ltx_text ltx_font_bold">end</span> <span id="alg1.l11.3" class="ltx_text ltx_font_bold">for</span>
</div>
<div id="alg1.l12" class="ltx_listingline">
            <span class="ltx_tag ltx_tag_listingline">12:</span>
            
            
             <span id="alg1.l12.2" class="ltx_text" style="--ltx-fg-color:#0000FF;">Total loss: <math id="alg1.l12.m1" class="ltx_Math" alttext="\mathcal{L}=\sum_{k}\mathcal{L}^{(k)}" display="inline" intent=":literal"><semantics><mrow><mi style="--ltx-fg-color:#0000FF;" class="ltx_font_mathcaligraphic" mathcolor="#0000FF">ℒ</mi><mo style="--ltx-fg-color:#0000FF;" mathcolor="#0000FF" rspace="0.111em">=</mo><mrow><msub><mo style="--ltx-fg-color:#0000FF;" mathcolor="#0000FF">∑</mo><mi style="--ltx-fg-color:#0000FF;" mathcolor="#0000FF">k</mi></msub><msup><mi style="--ltx-fg-color:#0000FF;" class="ltx_font_mathcaligraphic" mathcolor="#0000FF">ℒ</mi><mrow><mo style="--ltx-fg-color:#0000FF;" mathcolor="#0000FF" stretchy="false">(</mo><mi style="--ltx-fg-color:#0000FF;" mathcolor="#0000FF">k</mi><mo style="--ltx-fg-color:#0000FF;" mathcolor="#0000FF" stretchy="false">)</mo></mrow></msup></mrow></mrow><annotation encoding="application/x-tex">\mathcal{L}=\sum_{k}\mathcal{L}^{(k)}</annotation></semantics></math></span>

</div>
<div id="alg1.l13" class="ltx_listingline">
            <span class="ltx_tag ltx_tag_listingline">13:</span>
            
            
             Update codebooks <math id="alg1.l13.m1" class="ltx_Math" alttext="C" display="inline" intent=":literal"><semantics><mi>C</mi><annotation encoding="application/x-tex">C</annotation></semantics></math> using gradient descent

</div>
<div id="alg1.l14" class="ltx_listingline">
            <span class="ltx_tag ltx_tag_listingline">14:</span>
            
            
             Update assignments <math id="alg1.l14.m1" class="ltx_Math" alttext="b" display="inline" intent=":literal"><semantics><mi>b</mi><annotation encoding="application/x-tex">b</annotation></semantics></math> using beam search

</div>
<div id="alg1.l15" class="ltx_listingline">
            <span class="ltx_tag ltx_tag_listingline">15:</span>
            
            
            <span id="alg1.l15.2" class="ltx_text ltx_font_bold">end</span> <span id="alg1.l15.3" class="ltx_text ltx_font_bold">while</span>
</div>
<div id="alg1.l16" class="ltx_listingline">
            <span class="ltx_tag ltx_tag_listingline">16:</span>
            
            
            layer.weight := AQLMFormat(<math id="alg1.l16.m1" class="ltx_Math" alttext="C,b,s" display="inline" intent=":literal"><semantics><mrow><mi>C</mi><mo>,</mo><mi>b</mi><mo>,</mo><mi>s</mi></mrow><annotation encoding="application/x-tex">C,b,s</annotation></semantics></math>)

</div>
<div id="alg1.l17" class="ltx_listingline">
            <span class="ltx_tag ltx_tag_listingline">17:</span>
            
            
          <span id="alg1.l17.2" class="ltx_text ltx_font_bold">end</span> <span id="alg1.l17.3" class="ltx_text ltx_font_bold">for</span>
</div>
</div>
</figure>
<div id="S5.p7" class="ltx_para ltx_noindent">
<p id="S5.p7.1" class="ltx_p">At inference time, we leverage the hierarchical structure of Drop-by-Drop to adapt quantization fidelity to specific resource constraints without retraining. A single model is deployed, and depending on the target device’s budget, we reconstruct the weights using a prefix of the first <math id="S5.p7.m1" class="ltx_Math" alttext="k" display="inline" intent=":literal"><semantics><mi>k</mi><annotation encoding="application/x-tex">k</annotation></semantics></math> codebooks (<math id="S5.p7.m2" class="ltx_Math" alttext="k\leq M" display="inline" intent=":literal"><semantics><mrow><mi>k</mi><mo>≤</mo><mi>M</mi></mrow><annotation encoding="application/x-tex">k\leq M</annotation></semantics></math>). In practice, we maintain a minimum quality floor by setting <math id="S5.p7.m3" class="ltx_Math" alttext="k\geq 3" display="inline" intent=":literal"><semantics><mrow><mi>k</mi><mo>≥</mo><mn>3</mn></mrow><annotation encoding="application/x-tex">k\geq 3</annotation></semantics></math>. The number of active codebooks <math id="S5.p7.m4" class="ltx_Math" alttext="k" display="inline" intent=":literal"><semantics><mi>k</mi><annotation encoding="application/x-tex">k</annotation></semantics></math> serves like a deployment parameter.</p>
</div>
</section>
<section id="S6" class="ltx_section">
<h2 class="ltx_title ltx_title_section"><span class="ltx_tag ltx_tag_section">6 </span>Experiments</h2>

<section id="S6.SS0.SSS0.Px1" class="ltx_paragraph">
<h4 class="ltx_title ltx_title_paragraph">Experimental Setup &amp; Hyperparameters.</h4>

<div id="S6.SS0.SSS0.Px1.p1" class="ltx_para ltx_noindent">
<p id="S6.SS0.SSS0.Px1.p1.1" class="ltx_p">Our experiments were conducted on multi-GPU systems equipped with NVIDIA A40, RTX 6000, or L40 GPUs. We mostly used 4 GPUs with CUDA support. We perform quantization using <math id="S6.SS0.SSS0.Px1.p1.m1" class="ltx_Math" alttext="M\in\{3,4,5\}" display="inline" intent=":literal"><semantics><mrow><mi>M</mi><mo>∈</mo><mrow><mo stretchy="false">{</mo><mrow><mn>3</mn><mo>,</mo><mn>4</mn><mo>,</mo><mn>5</mn></mrow><mo stretchy="false">}</mo></mrow></mrow><annotation encoding="application/x-tex">M\in\{3,4,5\}</annotation></semantics></math> codebooks, each with a bitwidth of 8 and a group size of 8. We used 1024 calibration samples with a validation split of 32 samples, optimizing a relative MSE objective with a tolerance of <math id="S6.SS0.SSS0.Px1.p1.m2" class="ltx_Math" alttext="0.01" display="inline" intent=":literal"><semantics><mn>0.01</mn><annotation encoding="application/x-tex">0.01</annotation></semantics></math>. All quantized models are evaluated against the original FP16 base model using a batch size of 8.</p>
</div>
</section>
<section id="S6.SS0.SSS0.Px2" class="ltx_paragraph">
<h4 class="ltx_title ltx_title_paragraph">Method Definitions.</h4>

<div id="S6.SS0.SSS0.Px2.p1" class="ltx_para ltx_noindent">
<p id="S6.SS0.SSS0.Px2.p1.1" class="ltx_p">We follow AQLM and group weights at 8-bit granularity, applying additive quantization over these groups. Selecting <math id="S6.SS0.SSS0.Px2.p1.m1" class="ltx_Math" alttext="K" display="inline" intent=":literal"><semantics><mi>K</mi><annotation encoding="application/x-tex">K</annotation></semantics></math> codebooks per group therefore yields an effective rate of <math id="S6.SS0.SSS0.Px2.p1.m2" class="ltx_Math" alttext="K" display="inline" intent=":literal"><semantics><mi>K</mi><annotation encoding="application/x-tex">K</annotation></semantics></math> bits per weight. Hence, the <math id="S6.SS0.SSS0.Px2.p1.m3" class="ltx_Math" alttext="3\times 8" display="inline" intent=":literal"><semantics><mrow><mn>3</mn><mo lspace="0.222em" rspace="0.222em">×</mo><mn>8</mn></mrow><annotation encoding="application/x-tex">3\times 8</annotation></semantics></math>, <math id="S6.SS0.SSS0.Px2.p1.m4" class="ltx_Math" alttext="4\times 8" display="inline" intent=":literal"><semantics><mrow><mn>4</mn><mo lspace="0.222em" rspace="0.222em">×</mo><mn>8</mn></mrow><annotation encoding="application/x-tex">4\times 8</annotation></semantics></math>, and <math id="S6.SS0.SSS0.Px2.p1.m5" class="ltx_Math" alttext="5\times 8" display="inline" intent=":literal"><semantics><mrow><mn>5</mn><mo lspace="0.222em" rspace="0.222em">×</mo><mn>8</mn></mrow><annotation encoding="application/x-tex">5\times 8</annotation></semantics></math> settings, where the first number denotes the number of codebooks and the second the bit-width of each, correspond to 3-, 4-, and 5-bit configurations, respectively. For clarity, we define the compared methods:</p>
</div>
<div id="S6.SS0.SSS0.Px2.p2" class="ltx_para ltx_noindent">
<p id="S6.SS0.SSS0.Px2.p2.1" class="ltx_p">1. <span id="S6.SS0.SSS0.Px2.p2.1.1" class="ltx_text ltx_font_italic">AQLM (Individual)</span>: Separate AQLM models trained and tuned independently for each target codebook configuration (e.g., <math id="S6.SS0.SSS0.Px2.p2.m1" class="ltx_Math" alttext="5\times 8" display="inline" intent=":literal"><semantics><mrow><mn>5</mn><mo lspace="0.222em" rspace="0.222em">×</mo><mn>8</mn></mrow><annotation encoding="application/x-tex">5\times 8</annotation></semantics></math>, <math id="S6.SS0.SSS0.Px2.p2.m2" class="ltx_Math" alttext="4\times 8" display="inline" intent=":literal"><semantics><mrow><mn>4</mn><mo lspace="0.222em" rspace="0.222em">×</mo><mn>8</mn></mrow><annotation encoding="application/x-tex">4\times 8</annotation></semantics></math>). This represents an ideal performance but requires storing and training <math id="S6.SS0.SSS0.Px2.p2.m3" class="ltx_Math" alttext="N" display="inline" intent=":literal"><semantics><mi>N</mi><annotation encoding="application/x-tex">N</annotation></semantics></math> distinct models for <math id="S6.SS0.SSS0.Px2.p2.m4" class="ltx_Math" alttext="N" display="inline" intent=":literal"><semantics><mi>N</mi><annotation encoding="application/x-tex">N</annotation></semantics></math> quantization levels.</p>
</div>
<div id="S6.SS0.SSS0.Px2.p3" class="ltx_para ltx_noindent">
<p id="S6.SS0.SSS0.Px2.p3.1" class="ltx_p">2. <span id="S6.SS0.SSS0.Px2.p3.1.1" class="ltx_text ltx_font_italic">AQLM (Drop)</span>: An AQLM model trained at maximum quantization (e.g., <math id="S6.SS0.SSS0.Px2.p3.m1" class="ltx_Math" alttext="5\times 8" display="inline" intent=":literal"><semantics><mrow><mn>5</mn><mo lspace="0.222em" rspace="0.222em">×</mo><mn>8</mn></mrow><annotation encoding="application/x-tex">5\times 8</annotation></semantics></math>), with codebooks dropped at inference time to simulate lower quantization levels.</p>
</div>
<div id="S6.SS0.SSS0.Px2.p4" class="ltx_para ltx_noindent">
<p id="S6.SS0.SSS0.Px2.p4.1" class="ltx_p">3. <span id="S6.SS0.SSS0.Px2.p4.1.1" class="ltx_text ltx_font_italic">Drop-by-Drop (Uniform)</span>: A single model trained once at maximum quantization using the proposed Drop-by-Drop method, designed to support codebook reduction at inference time. Uniform Matryoshka loss weights are used, <span id="S6.SS0.SSS0.Px2.p4.1.2" class="ltx_text ltx_font_bold">Uni</span>: <math id="S6.SS0.SSS0.Px2.p4.m1" class="ltx_Math" alttext="\lambda_{1}=\lambda_{2}=\lambda_{3}=\lambda_{4}=\lambda_{5}=0.2." display="inline" intent=":literal"><semantics><mrow><mrow><msub><mi>λ</mi><mn>1</mn></msub><mo>=</mo><msub><mi>λ</mi><mn>2</mn></msub><mo>=</mo><msub><mi>λ</mi><mn>3</mn></msub><mo>=</mo><msub><mi>λ</mi><mn>4</mn></msub><mo>=</mo><msub><mi>λ</mi><mn>5</mn></msub><mo>=</mo><mn>0.2</mn></mrow><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">\lambda_{1}=\lambda_{2}=\lambda_{3}=\lambda_{4}=\lambda_{5}=0.2.</annotation></semantics></math></p>
</div>
<div id="S6.SS0.SSS0.Px2.p5" class="ltx_para ltx_noindent">
<p id="S6.SS0.SSS0.Px2.p5.1" class="ltx_p">4. <span id="S6.SS0.SSS0.Px2.p5.1.1" class="ltx_text ltx_font_italic">Drop-by-Drop (Weighted)</span>: Variants of DbyD using non-uniform Matryoshka loss weights to better approximate the performance of individually tuned AQLM models. Based on our ablation studies in Appendix <a href="#A8" title="Appendix H Ablation Study ‣ Multi-Bitwidth Quantization for LLMs Using Additive Codebooks" class="ltx_ref"><span class="ltx_text ltx_ref_tag">H</span></a>, we report <span id="S6.SS0.SSS0.Px2.p5.1.2" class="ltx_text ltx_font_bold">35W</span>: <math id="S6.SS0.SSS0.Px2.p5.m1" class="ltx_Math" alttext="\lambda_{3}=0.5" display="inline" intent=":literal"><semantics><mrow><msub><mi>λ</mi><mn>3</mn></msub><mo>=</mo><mn>0.5</mn></mrow><annotation encoding="application/x-tex">\lambda_{3}=0.5</annotation></semantics></math>, <math id="S6.SS0.SSS0.Px2.p5.m2" class="ltx_Math" alttext="\lambda_{5}=0.5" display="inline" intent=":literal"><semantics><mrow><msub><mi>λ</mi><mn>5</mn></msub><mo>=</mo><mn>0.5</mn></mrow><annotation encoding="application/x-tex">\lambda_{5}=0.5</annotation></semantics></math>, all other <math id="S6.SS0.SSS0.Px2.p5.m3" class="ltx_Math" alttext="\lambda" display="inline" intent=":literal"><semantics><mi>λ</mi><annotation encoding="application/x-tex">\lambda</annotation></semantics></math> are zero.</p>
</div>
<figure id="S6.F6" class="ltx_figure"><span class="ltx_inline-block"><svg id="S6.F6.pic1" class="ltx_picture ltx_centering" height="288.02" overflow="visible" version="1.1" viewBox="0 0 450.63 288.02" width="450.63"><g style="--ltx-stroke-color:#000000;--ltx-fill-color:#000000;" fill="#000000" stroke="#000000" stroke-width="0.4pt" transform="translate(0,288.02) matrix(1 0 0 -1 0 0) translate(45.14,0) translate(0,185.49)"><g transform="matrix(1.0 0.0 0.0 1.0 -45.14 -18.42)"><g class="ltx_nestedsvg" transform="matrix(1 0 0 1 0 0) translate(51.43,0) translate(0,18.42)"><g style="--ltx-stroke-color:#BFBFBF;--ltx-fill-color:#BFBFBF;--ltx-fg-color:#BFBFBF;" color="#BFBFBF" fill="#BFBFBF" stroke="#BFBFBF" stroke-dasharray="3.0pt,3.0pt" stroke-dashoffset="0.0pt" stroke-width="0.4pt"><path style="fill:none" d="M -6.29 0 L 69.23 0 M -6.29 18.88 L 69.23 18.88 M -6.29 37.76 L 69.23 37.76 M -6.29 56.65 L 69.23 56.65 M -6.29 75.53 L 69.23 75.53"></path></g><g style="--ltx-stroke-color:#808080;--ltx-fill-color:#808080;--ltx-fg-color:#808080;" color="#808080" fill="#808080" stroke="#808080" stroke-width="0.2pt"><path style="fill:none" d="M 0 0 L 0 5.91 M 31.47 0 L 31.47 5.91 M 62.94 0 L 62.94 5.91 M 0 75.53 L 0 69.62 M 31.47 75.53 L 31.47 69.62 M 62.94 75.53 L 62.94 69.62"></path></g><g style="--ltx-stroke-color:#808080;--ltx-fill-color:#808080;--ltx-fg-color:#808080;" color="#808080" fill="#808080" stroke="#808080" stroke-width="0.2pt"><path style="fill:none" d="M -6.29 0 L -0.39 0 M -6.29 18.88 L -0.39 18.88 M -6.29 37.76 L -0.39 37.76 M -6.29 56.65 L -0.39 56.65 M -6.29 75.53 L -0.39 75.53 M 69.23 0 L 63.33 0 M 69.23 18.88 L 63.33 18.88 M 69.23 37.76 L 63.33 37.76 M 69.23 56.65 L 63.33 56.65 M 69.23 75.53 L 63.33 75.53"></path></g><g style="--ltx-stroke-color:#000000;--ltx-fill-color:#000000;" fill="#000000" stroke="#000000" stroke-width="0.4pt"><path style="fill:none" d="M -6.29 0 L -6.29 75.53 L 69.23 75.53 L 69.23 0 L -6.29 0 Z"></path><g style="--ltx-stroke-color:#000000;--l