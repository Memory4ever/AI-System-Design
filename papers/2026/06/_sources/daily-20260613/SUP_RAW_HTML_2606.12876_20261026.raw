olor="#0000FF">k</mi><mo style="--ltx-fg-color:#0000FF;" mathcolor="#0000FF" stretchy="false">)</mo></mrow></msup></mrow><mo style="--ltx-fg-color:#0000FF;" mathcolor="#0000FF" stretchy="false">)</mo></mrow><mo lspace="0em" rspace="0em">​</mo><mrow><mo style="--ltx-fg-color:#0000FF;" mathcolor="#0000FF">(</mo><mrow><mfrac style="--ltx-fg-color:#0000FF;" mathcolor="#0000FF"><mn style="--ltx-fg-color:#0000FF;" mathcolor="#0000FF">1</mn><mi style="--ltx-fg-color:#0000FF;" mathcolor="#0000FF">n</mi></mfrac><mo lspace="0em" rspace="0em">​</mo><mi style="--ltx-fg-color:#0000FF;" mathcolor="#0000FF">X</mi><mo lspace="0em" rspace="0em">​</mo><msup><mi style="--ltx-fg-color:#0000FF;" mathcolor="#0000FF">X</mi><mo style="--ltx-fg-color:#0000FF;" mathcolor="#0000FF">⊤</mo></msup></mrow><mo style="--ltx-fg-color:#0000FF;" mathcolor="#0000FF">)</mo></mrow><mo lspace="0em" rspace="0em">​</mo><msup><mrow><mo style="--ltx-fg-color:#0000FF;" mathcolor="#0000FF" stretchy="false">(</mo><mrow><mi style="--ltx-fg-color:#0000FF;" mathcolor="#0000FF">W</mi><mo style="--ltx-fg-color:#0000FF;" mathcolor="#0000FF">−</mo><msup><mover accent="true"><mi style="--ltx-fg-color:#0000FF;" mathcolor="#0000FF">W</mi><mo style="--ltx-fg-color:#000000;" mathcolor="#000000">^</mo></mover><mrow><mo style="--ltx-fg-color:#0000FF;" mathcolor="#0000FF" stretchy="false">(</mo><mi style="--ltx-fg-color:#0000FF;" mathcolor="#0000FF">k</mi><mo style="--ltx-fg-color:#0000FF;" mathcolor="#0000FF" stretchy="false">)</mo></mrow></msup></mrow><mo style="--ltx-fg-color:#0000FF;" mathcolor="#0000FF" stretchy="false">)</mo></mrow><mo style="--ltx-fg-color:#0000FF;" mathcolor="#0000FF">⊤</mo></msup></mrow><mo style="--ltx-fg-color:#0000FF;" mathcolor="#0000FF">]</mo></mrow></mrow></mrow></mrow><annotation encoding="application/x-tex">\mathcal{L}^{(k)}\leftarrow\lambda_{k}\cdot\frac{1}{d_{\text{out}}}\operatorname{tr}\!\left[(W-\widehat{W}^{(k)})\left(\frac{1}{n}XX^{\top}\right)(W-\widehat{W}^{(k)})^{\top}\right]</annota