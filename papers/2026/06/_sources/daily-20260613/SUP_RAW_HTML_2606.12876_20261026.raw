</div></div><div class="ltx_flex_cell ltx_flex_size_3">
<div id="A4.F9.4" class="ltx_block ltx_figure_panel ltx_minipage ltx_align_center ltx_align_top" style="width:127.2pt;"><img src="2606.12876v1/imgs/plots/March_1_FITTED_scaled_weight_hist_layer_14_Linear.png" id="A4.F9.g15" class="ltx_graphics ltx_centering ltx_img_landscape" style="aspect-ratio:141/79;" width="141" height="79" alt="Refer to caption">
