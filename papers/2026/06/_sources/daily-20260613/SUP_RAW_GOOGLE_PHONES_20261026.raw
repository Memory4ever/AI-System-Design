      --
      
        --flex
        --center
      
    "
    data-gt-id="dynamic_media"
    data-gt-component-name=""
    >

    




    <div class="
      glue-grid
      
        --remove-gap
        --small
      
    ">
      
        <div class="
          dynamic_media__item
          glue-grid__col
          glue-grid__col--span-4-sm
          
            glue-grid__col--span-12-md
          
          
            glue-grid__col--span-12-lg
          
        ">
          <div class="">
            



  
    





    <!-- Determine the appropriate width based on image_width -->
    
        
    


<!-- For mobile images, use a default width -->


<picture class="media__image media__image">
    
    
        <source media="(min-width: 768px)" srcset="https://storage.googleapis.com/gweb-research2023-media/images/PhoneClusterComputing1_SPEC.width-1250.png" alt="PhoneClusterComputing1_SPEC" />
    
    <img src="https://storage.googleapis.com/gweb-research2023-media/images/PhoneClusterComputing1_SPEC.width-1250.png" alt="PhoneClusterComputing1_SPEC" loading="lazy" />
    
</picture>
  


          </div>
        </div>
      

      
        <div class="
          glue-grid__col
          glue-grid__col--span-4-sm
          glue-grid__col--span-12-md
          caption
          --center
        ">
          <p data-block-key="sb0u3"><i>Single-threaded performance of a modern smartphone (</i><a href="https://blog.google/products-and-platforms/devices/pixel/google-pixel-fold/" target="_blank" rel="noopener noreferrer"><i>2023 Pixel Fold</i></a><i>) compared to a server (</i><a href="https://servers.asus.com/products/Servers/Rack-Servers/RS720A-E11-RS24U/" target="_blank" rel="noopener noreferrer"><i>ASUS RS720A-E11</i></a><i>) using the</i> <a href="https://www.spec.org/cpu2017/" target="_blank" rel="noopener noreferrer"><i>SPEC benchmarking suite</i></a><i>. The blue bars represent the per-core performance of the Pixel Fold’s performance cores. On most benchmarks they beat the per-core performance of the baseline data center server.</i></p>
        </div>
      
    </div>
  </div>



    </div>
</section>

                    
                    
    


