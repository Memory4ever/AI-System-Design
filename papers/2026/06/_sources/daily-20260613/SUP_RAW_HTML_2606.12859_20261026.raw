<th id="S4.T1.14.1.2.4" class="ltx_td ltx_nopad_l ltx_nopad_r ltx_align_center ltx_th ltx_th_column ltx_border_t" style="padding:0.5pt 1.5pt;">Task</th>
<th id="S4.T1.14.1.2.5" class="ltx_td ltx_nopad_l ltx_nopad_r ltx_align_center ltx_th ltx_th_column ltx_border_t" style="padding:0.5pt 1.5pt;"><span id="S4.T1.14.1.2.5.1" class="ltx_text ltx_font_bold">Tot</span></th>
<th id="S4.T1.14.1.2.6" class="ltx_td ltx_nopad_l ltx_nopad_r ltx_align_center ltx_th ltx_th_column ltx_border_t" style="padding:0.5pt 1.5pt;">Pos</th>
<th id="S4.T1.14.1.2.7" class="ltx_td ltx_nopad_l ltx_nopad_r ltx_align_center ltx_th ltx_th_column ltx_border_t" style="padding:0.5pt 1.5pt;">Arm</th>
<th id="S4.T1.14.1.2.8" class="ltx_td ltx_nopad_l ltx_nopad_r ltx_align_center ltx_th ltx_th_column ltx_border_t" style="padding:0.5pt 1.5pt;">Safe</th>
<th id="S4.T1.14.1.2.9" class="ltx_td ltx_nopad_l ltx_nopad_r ltx_align_center ltx_th ltx_th_column ltx_border_t" style="padding:0.5pt 1.5pt;">Task</th>
<th id="S4.T1.14.1.2.10" class="ltx_td ltx_nopad_l ltx_nopad_r ltx_align_center ltx_th ltx_th_column ltx_border_t" style="padding:0.5pt 1.5pt;"><span id="S4.T1.14.1.2.10.1" class="ltx_text ltx_font_bold">Tot</span></th>
