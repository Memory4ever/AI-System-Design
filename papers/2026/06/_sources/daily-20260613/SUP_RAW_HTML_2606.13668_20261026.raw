<td id="A1.T5.2.1.2" class="ltx_td ltx_align_right ltx_border_tt"><span id="A1.T5.2.1.2.1" class="ltx_text ltx_font_bold">Value</span></td></tr>
<tr id="A1.T5.2.2" class="ltx_tr">
