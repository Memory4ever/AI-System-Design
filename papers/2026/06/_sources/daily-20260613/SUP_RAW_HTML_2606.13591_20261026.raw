<td id="S5.T1.2.1.14.2" class="ltx_td ltx_align_center ltx_border_bb" style="--ltx-bg-color:#D8FAD9;"><math id="S5.T1.m101" class="ltx_Math" style="--ltx-bg-color:#D8FAD9;" alttext="+1.01_{(4/6)}" display="inline" intent=":literal"><semantics><mrow><mo style="--ltx-bg-color:#D8FAD9;" mathbackground="#D8FAD9">+</mo><msub><mn style="--ltx-bg-color:#D8FAD9;" mathbackground="#D8FAD9">1.01</mn><mrow><mo style="--ltx-bg-color:#D8FAD9;" mathbackground="#D8FAD9" stretchy="false">(</mo><mrow><mn style="--ltx-bg-color:#D8FAD9;" mathbackground="#D8FAD9">4</mn><mo style="--ltx-bg-color:#D8FAD9;" mathbackground="#D8FAD9">/</mo><mn style="--ltx-bg-color:#D8FAD9;" mathbackground="#D8FAD9">6</mn></mrow><mo style="--ltx-bg-color:#D8FAD9;" mathbackground="#D8FAD9" stretchy="false">)</mo></mrow></msub></mrow><annotation encoding="application/x-tex">+1.01_{(4/6)}</annotation></semantics></math></td>
