            <span id="alg1.l6.3" class="ltx_text" style="font-size:80%;">    </span><math id="alg1.l6.m1" class="ltx_Math" alttext="\mathcal{\hat{Q}}\leftarrow\mathrm{ParseQ}(a_{t})" display="inline" intent=":literal"><semantics><mrow><mover accent="true"><mi class="ltx_font_mathcaligraphic" mathsize="0.800em">𝒬</mi><mo>^</mo></mover><mo mathsize="0.800em" stretchy="false">←</mo><mrow><mi mathsize="0.800em">ParseQ</mi><mo>⁡</mo><mrow><mo maxsize="0.800em" minsize="0.800em">(</mo><msub><mi mathsize="0.800em">a</mi><mi mathsize="0.800em">t</mi></msub><mo maxsize="0.800em" minsize="0.800em">)</mo></mrow></mrow></mrow><annotation encoding="application/x-tex">\mathcal{\hat{Q}}\leftarrow\mathrm{ParseQ}(a_{t})</annotation></semantics></math><span id="alg1.l6.4" class="ltx_text" style="font-size:80%;">
</span>
</div>
<div id="alg1.l7" class="ltx_listingline">
              <span class="ltx_tag ltx_tag_listingline"><span id="alg1.l7.1" class="ltx_text" style="font-size:80%;">7:</span></span>
              
              
            <span id="alg1.l7.3" class="ltx_text" style="font-size:80%;">    </span><math id="alg1.l7.m1" class="ltx_Math" alttext="r_{t}\leftarrow r^{q}(s_{t},\mathcal{\hat{Q}};\mathcal{Q^{*}})" display="inline" intent=":literal"><semantics><mrow><msub><mi mathsize="0.800em">r</mi><mi mathsize="0.800em">t</mi></msub><mo mathsize="0.800em" stretchy="false">←</mo><mrow><msup><mi mathsize="0.800em">r</mi><mi mathsize="0.800em">q</mi></msup><mo lspace="0em" rspace="0em">​</mo><mrow><mo maxsize="0.800em" minsize="0.800em">(</mo><msub><mi mathsize="0.800em">s</mi><mi mathsize="0.800em">t</mi></msub><mo mathsize="0.800em">,</mo><mover accent="true"><mi class="ltx_font_mathcaligraphic" mathsize="0.800em">𝒬</mi><mo>^</mo></mover><mo mathsize="0.800em">,</mo><msup><mi class="ltx_font_mathcaligraphic" mathsize="0.800em">𝒬</mi><mo mathsize="0.800em">∗</mo></msup><mo maxsize="0.800em" minsize="0.800em">)</mo></mrow></mrow></mrow><annotation encoding="application/x-tex">r_{t}\leftarrow r^{q}(s_{t},\mathcal{\hat{Q}};\mathcal{Q^{*}})</annotation></semantics></math><span id="alg1.l7.4" class="ltx_text" style="font-size:80%;">
</span>
</div>
