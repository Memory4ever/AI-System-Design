    <style>
      .vp-doc .custom-block.details {
        background-color: #ffffff;
        border: 1px solid #e5e5e5;
        border-radius: 8px;
        margin-bottom: 6px;
      }
      html.dark .vp-doc .custom-block.details {
        background-color: var(--vp-c-bg-soft);
        border-color: var(--vp-c-divider);
      }
      .vp-doc .custom-block.details .custom-block-title {
        font-size: 18px;
        font-weight: 600;
      }
      .vp-doc .step-num {
        display: inline-flex;
        align-items: center;
        justify-content: center;
        width: 1.45em;
        height: 1.45em;
        border-radius: 50%;
        background: #f4f5f7;
        color: #8a919c;
        font-size: 0.85em;
        font-weight: 500;
        line-height: 1;
        margin-right: 0.6em;
        vertical-align: 0.1em;
      }
      .vp-doc .step {
        position: relative;
        border-left: 2px solid #f0f2f5;
        padding-left: 1.4em;
        margin-left: 0.75em;
        padding-bottom: 0.6em;
      }
      .vp-doc .step:last-of-type {
        border-left-color: transparent;
      }
      .vp-doc .step .step-num {
        position: absolute;
        left: -0.78em;
        top: 0.15em;
        margin-right: 0;
      }
      .model-spec-table {
        overflow-x: auto;
        display: block;
      }
      .model-spec-table table {
        table-layout: fixed;
        width: 100%;
        min-width: 1400px;
      }
      .model-spec-table th,
      .model-spec-table td {
        word-wrap: break-word;
        vertical-align: top;
        padding: 8px 12px;
        line-height: 24px;
      }
      .model-spec-table th:first-child,
      .model-spec-table td:first-child {
        width: 12%;
        min-width: 100px;
      }
      .model-spec-table th:not(:first-child),
      .model-spec-table td:not(:first-child) {
        width: 22%;
      }
      .model-spec-table td code {
        white-space: nowrap;
      }
      .model-spec-table tbody tr:nth-child(4) td {
        white-space: nowrap;
      }
      .feature-compare-table table {
        table-layout: fixed;
        width: 100%;
      }
      .feature-compare-table th:nth-child(1),
      .feature-compare-table td:nth-child(1) {
        width: 8em;
        white-space: nowrap;
      }
      .feature-compare-table th:nth-child(2),
      .feature-compare-table td:nth-child(2),
      .feature-compare-table th:nth-child(3),
      .feature-compare-table td:nth-child(3) {
        width: 4.5em;
        text-align: center;
      }
      .vp-doc .desktop-cards {
        display: grid;
        grid-template-columns: repeat(2, minmax(0, 1fr));
        gap: 16px;
        margin: 1.5rem 0;
      }
      .vp-doc .desktop-card {
        display: flex;
        flex-direction: column;
        gap: 8px;
        min-width: 0;
        padding: 18px 20px;
        border: 1px solid var(--vp-c-divider);
        border-radius: 12px;
        background: var(--vp-c-bg-soft);
        color: var(--vp-c-text-1);
        text-decoration: none;
        transition: border-color 0.2s, background-color 0.2s, transform 0.2s;
      }
      .vp-doc .desktop-card:hover {
        border-color: var(--vp-c-brand-1);
        background: var(--vp-c-brand-soft);
        color: var(--vp-c-text-1);
        transform: translateY(-2px);
      }
      .vp-doc .desktop-card:focus-visible {
        outline: 2px solid var(--vp-c-brand-1);
        outline-offset: 2px;
      }
      .vp-doc .desktop-card-tag {
        align-self: flex-start;
        padding: 3px 8px;
        border-radius: 999px;
        background: var(--vp-c-brand-soft);
        color: var(--vp-c-brand-1);
        font-size: 12px;
        font-weight: 600;
        line-height: 1.4;
      }
      .vp-doc .desktop-card-title {
        color: var(--vp-c-text-1);
        font-size: 18px;
        font-weight: 600;
        line-height: 1.4;
      }
      .vp-doc .desktop-card-description {
        color: var(--vp-c-text-2);
        font-size: 14px;
        line-height: 1.6;
      }
      .vp-doc .desktop-download-cards {
        display: grid;
        grid-template-columns: repeat(3, minmax(0, 1fr));
        gap: 16px;
        max-width: 900px;
        margin: 1.5rem 0;
      }
      .vp-doc .desktop-download-card {
        display: grid;
        grid-template-columns: 30px minmax(0, 1fr) 30px;
        align-items: center;
        gap: 8px;
        min-width: 0;
        padding: 22px 14px;
        border: 1px solid var(--vp-c-divider);
        border-radius: 10px;
        background: var(--vp-c-bg);
        color: var(--vp-c-text-1);
        text-decoration: none;
        transition: border-color 150ms ease, background-color 150ms ease, transform 150ms ease;
      }
      .vp-doc .desktop-download-card:hover {
        border-color: var(--vp-c-brand-1);
        background: var(--vp-c-brand-soft);
        transform: translateY(-1px);
      }
      .vp-doc .desktop-download-card:focus-visible {
        outline: 2px solid var(--vp-c-brand-1);
        outline-offset: 2px;
      }
      .vp-doc .desktop-download-icon,
      .vp-doc .desktop-download-action {
        display: inline-flex;
        align-items: center;
        justify-content: center;
        width: 30px;
        height: 30px;
        border-radius: 8px;
      }
      .vp-doc .desktop-download-icon {
        background: var(--vp-c-bg-soft);
        color: var(--vp-c-text-1);
      }
      .vp-doc .desktop-download-action {
        align-self: end;
        border: 1px solid var(--vp-c-divider);
        background: var(--vp-c-bg-soft);
        color: var(--vp-c-text-2);
        transition: border-color 150ms ease, color 150ms ease;
      }
      .vp-doc .desktop-download-card:hover .desktop-download-action {
        border-color: var(--vp-c-brand-1);
        color: var(--vp-c-brand-1);
      }
      .vp-doc .desktop-download-icon svg,
      .vp-doc .desktop-download-action svg {
        display: block;
      }
      .vp-doc .desktop-download-text {
        display: flex;
        min-width: 0;
        align-self: start;
        flex-direction: column;
        gap: 2px;
      }
      .vp-doc .desktop-download-title,
      .vp-doc .desktop-download-description {
        min-width: 0;
        overflow-wrap: anywhere;
      }
      .vp-doc .desktop-download-title {
        color: var(--vp-c-text-1);
        font-size: 14px;
        font-weight: 600;
        line-height: 1.3;
        white-space: nowrap;
        word-break: keep-all;
        overflow-wrap: normal;
      }
      .vp-doc .desktop-download-description {
        color: var(--vp-c-text-2);
        font-size: 12px;
        line-height: 1.3;
      }
      @media (max-width: 800px) {
        .vp-doc .desktop-download-cards {
          grid-template-columns: 1fr;
        }
      }
      .vp-doc figure.desktop-shot {
        max-width: 100%;
        margin: 2rem 0;
      }
      .vp-doc figure.desktop-shot img {
        width: 100%;
        border: 1px solid var(--vp-c-divider);
        border-radius: 12px;
      }
      .vp-doc figure.desktop-shot figcaption {
        margin-top: 8px;
        color: var(--vp-c-text-2);
        font-size: 14px;
        line-height: 1.6;
      }
      .vp-doc figure.desktop-shot.shot-narrow img {
        width: auto;
        max-width: 420px;
        display: block;
        margin: 0 auto;
      }
      .vp-doc table {
        display: block;
        width: auto;
        max-width: 100%;
        margin: 20px auto;
        overflow-x: auto;
      }
      .vp-doc li,
      .vp-doc th,
      .vp-doc td {
        line-height: 28px;
      }
      .vp-doc table.data-locations {
        table-layout: fixed;
        width: 100%;
      }
      .vp-doc table.data-locations th:first-child,
      .vp-doc table.data-locations td:first-child {
        width: 34%;
      }
      .vp-doc table.data-locations td:first-child {
        white-space: normal;
        overflow-wrap: anywhere;
      }
      .vp-doc table.data-locations td code {
        white-space: normal;
        overflow-wrap: anywhere;
        word-break: break-all;
      }
      @media (max-width: 768px) {
        .vp-doc table {
          display: block;
          width: auto;
          margin: 20px 0;
        }
      }
      @media (max-width: 768px) {
        .vp-doc .desktop-cards {
          grid-template-columns: 1fr;
        }
        .model-spec-table {
          overflow-x: auto;
          display: block;
        }
        .model-spec-table table {
          min-width: 1400px;
          table-layout: fixed;
        }
        .model-spec-table th,
        .model-spec-table td {
          padding: 4px 8px;
          line-height: 20px;
        }
      }
      .vp-code-group > .blocks > div[class] {
        display: none;
      }
      .vp-code-group:has(>.tabs input:nth-of-type(1):checked) > .blocks > :nth-child(1) {
        display: block;
      }
      .vp-code-group:has(>.tabs input:nth-of-type(2):checked) > .blocks > :nth-child(2) {
        display: block;
      }
      .vp-code-group:has(>.tabs input:nth-of-type(3):checked) > .blocks > :nth-child(3) {
        display: block;
      }
      .vp-code-group:has(>.tabs input:nth-of-type(4):checked) > .blocks > :nth-child(4) {
        display: block;
      }
      .vp-code-group:has(>.tabs input:nth-of-type(5):checked) > .blocks > :nth-child(5) {
        display: block;
      }
      .vp-code-group:has(>.tabs input:nth-of-type(6):checked) > .blocks > :nth-child(6) {
        display: block;
      }
      .vp-code-group:has(>.tabs input:nth-of-type(7):checked) > .blocks > :nth-child(7) {
        display: block;
      }
      .vp-code-group:has(>.tabs input:nth-of-type(8):checked) > .blocks > :nth-child(8) {
        display: block;
      }
      .vp-code-group:has(>.tabs input:nth-of-type(9):checked) > .blocks > :nth-child(9) {
        display: block;
      }
      .vp-code-group:has(>.tabs input:nth-of-type(10):checked) > .blocks > :nth-child(10) {
        display: block;
      }
      .vp-code-group:has(>.tabs input:nth-of-type(11):checked) > .blocks > :nth-child(11) {
        display: block;
      }
      .vp-code-group:has(>.tabs input:nth-of-type(12):checked) > .blocks > :nth-child(12) {
        display: block;
      }
    </style>
    <script id="check-dark-mode">(()=>{const e=localStorage.getItem("vitepress-theme-appearance")||"auto",a=window.matchMedia("(prefers-color-scheme: dark)").matches;(!e||e==="auto"?a:e==="dark")&&document.documentElement.classList.add("dark")})();</script>
