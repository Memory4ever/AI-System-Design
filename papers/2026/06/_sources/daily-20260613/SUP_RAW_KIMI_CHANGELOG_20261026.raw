ss="item" data-v-6b36a2fd><div class="indicator" data-v-6b36a2fd></div><a class="VPLink link link" href="/code/docs/en/kimi-code-cli/customization/agents.html" data-v-6b36a2fd><!--[--><p class="text" data-v-6b36a2fd>Agents and Sub-Agents</p><!--]--></a><!----></div><!----></div><div class="VPSidebarItem level-2 is-link" data-v-6b36a2fd data-v-6b36a2fd><div class="item" data-v-6b36a2fd><div class="indicator" data-v-6b36a2fd></div><a class="VPLink link link" href="/code/docs/en/kimi-code-cli/customization/hooks.html" data-v-6b36a2fd><!--[--><p class="text" data-v-6b36a2fd>Hooks</p><!--]--></a><!----></div><!----></div><div class="VPSidebarItem level-2 is-link" data-v-6b36a2fd data-v-6b36a2fd><div class="item" data-v-6b36a2fd><div class="indicator" data-v-6b36a2fd></div><a class="VPLink link link" href="/code/docs/en/kimi-code-cli/customization/datasource.html" data-v-6b36a2fd><!--[--><p class="text" data-v-6b36a2fd>Kimi Datasource</p><!--]--></a><!----></div><!----></div><div class="VPSidebarItem level-2 is-link" data-v-6b36a2fd data-v-6b36a2fd><div class="item" data-v-6b36a2fd><div class="indicator" data-v-6b36a2fd></div><a class="VPLink link link" href="/code/docs/en/kimi-code-cli/customization/themes.html" data-v-6b36a2fd><!--[--><p class="text" data-v-6b36a2fd>Custom Themes</p><!--]--></a><!----></div><!----></div><!--]--></div></section><section class="VPSidebarItem level-1 collapsible collapsed" data-v-6b36a2fd data-v-6b36a2fd><div class="item" role="button" tabindex="0" data-v-6b36a2fd><div class="indicator" data-v-6b36a2fd></div><h3 class="text" data-v-6b36a2fd>Reference</h3><div class="caret" role="button" aria-label="toggle section" tabindex="0" data-v-6b36a2fd><span class="vpi-chevron-right caret-icon" data-v-6b36a2fd></span></div></div><div class="items" data-v-6b36a2fd><!--[--><div class="VPSidebarItem level-2 is-link" data-v-6b36a2fd data-v-6b36a2fd><div class="item" data-v-6b36a2fd><div class="indicator" data-v-6b36a2fd></div><a class="VPLink link link"