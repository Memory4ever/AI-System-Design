2.js\",\"/_next/static/chunks/2w1qwney-fyfm.js\",\"/_next/static/chunks/09se46dzbir7i.js\",\"/_next/static/chunks/0wl6gcdg50i26.js\",\"/_next/static/chunks/0eati3i8kytmk.js\",\"/_next/static/chunks/1yaf59hpszc-j.js\",\"/_next/static/chunks/06nf8jq8f7o_g.js\",\"/_next/static/chunks/3ivs8n8bmmln4.js\",\"/_next/static/chunks/0aas_yjbi8uhf.js\",\"/_next/static/chunks/275t9t-0ozupi.js\",\"/_next/static/chunks/42d_j2uu2fkig.js\"],\"default\"]\n6:[[\"$\",\"script\",null,{\"type\":\"application/ld+json\",\"children\":\"{\\\"@context\\\":\\\"https://schema.org\\\",\\\"@type\\\":\\\"Article\\\",\\\"headline\\\":\\\"Results from the first Anthropic Public Record\\\",\\\"description\\\":\\\"Anthropic Public Record is a national survey of attitudes and opinions towards AI.\\\",\\\"image\\\":[\\\"https://www-cdn.anthropic.com/images/4zrzovbb/website/44cb011476c84f7a91e0815d6bd65afc910accd4-1200x630.jpg\\\"],\\\"datePublished\\\":\\\"2026-06-12T00:00:00.000Z\\\",\\\"dateModified\\\":\\\"2026-10-23T20:56:17.000Z\\\",\\\"author\\\":{\\\"@type\\\":\\\"Organization\\\",\\\"name\\\":\\\"Anthropic\\\",\\\"url\\\":\\\"https://www.anthropic.com\\\"},\\\"publisher\\\":{\\\"@type\\\":\\\"Organization\\\",\\\"name\\\":\\\"Anthropic\\\",\\\"url\\\":\\\"https://www.anthropic.com\\\"},\\\"mainEntityOfPage\\\":\\\"https://www.anthropic.com/research/anthropic-public-record\\\",\\\"url\\\":\\\"https://www.anthropic.com/research/anthropic-public-record\\\"}\"}],[\"$\",\"$L4a\",null,{\"children\":[\"$\",\"$L4b\",null,{\"article\":{\"_createdAt\":\"2026-09-28T01:32:36Z\",\"_id\":\"article-2ea40712-b90c-41d4-9e9b-71a96f23fc71\",\"_rev\":\"60cbe71f-f35a-48ea-a28f-d8fdbe135da9\",\"_system\":{\"base\":{\"id\":\"article-2ea40712-b90c-41d4-9e9b-71a96f23fc71\",\"rev\":\"uK70w4pPjDN4CsmcUDi2Me\"}},\"_type\":\"article\",\"_updatedAt\":\"2026-10-23T20:56:17Z\",\"acknowledgments\":null,\"articleType\":\"research\",\"authors\":[],\"body\":[{\"_key\":\"69cbc11c187f\",\"_type\":\"block\",\"children\":[{\"_key\":\"9dec1379db7f\",\"_type\":\"span\",\"marks\":[],\"text\":\"We’re conducting a new survey series, Anthropic Public Record, to understand how the public thinks and feels about AI, and presenting a snapshot of the results from the first wave, fielded in November and December of 2025 with nearly 52,000 Americans.\"}],\"markDefs\":[],\"style\":\"normal\"},{\"_key\":\"a24df46d8524\",\"_type\":\"block\",\"children\":[{\"_key\":\"d67abb8490c0\",\"_type\":\"span\",\"marks\":[\"strong\"],\"text\":\"We found:\"}],\"markDefs\":[],\"style\":\"normal\"},{\"_key\":\"c38f89ac73ff\",\"_type\":\"block\",\"children\":[{\"_key\":\"d50311dbf420\",\"_type\":\"span\",\"marks\":[],\"text\":\"Nearly half (48%) of Americans ranked curing diseases like cancer or Alzheimer’s as one of their top three hopes for AI, followed by helping people with disabilities (36%), then making technological progress and making life easier in general (tied at 23%).\"}],\"level\":1,\"listItem\":\"bullet\",\"markDefs\":[],\"style\":\"normal\"},{\"_key\":\"32ae2c912094\",\"_type\":\"block\",\"children\":[{\"_key\":\"0b23adfbedd8\",\"_type\":\"span\",\"marks\":[],\"text\":\"AI-induced job loss was the most common fear in every state, held by 64% of Americans. The second most prominent fear was cognitive dependency (56%), followed by misinformation (52%).\"}],\"level\":1,\"listItem\":\"bullet\",\"markDefs\":[],\"style\":\"normal\"},{\"_key\":\"ee65389b3c3d\",\"_type\":\"block\",\"children\":[{\"_key\":\"f1e97adbbb4e\",\"_type\":\"span\",\"marks\":[],\"text\":\"Support for government intervention in AI was high: over 70% of the Americans we surveyed believe the government should play a role in regulating AI, and this support was bipartisan. People were most eager to see the government take action on AI in the areas of privacy (56%), child safety (52%), and liability for harm (49%).\"}],\"level\":1,\"listItem\":\"bullet\",\"markDefs\":[],\"style\":\"normal\"},{\"_key\":\"b2fae59ce7f3\",\"_type\":\"block\",\"children\":[{\"_key\":\"c4c3628f7238\",\"_type\":\"span\",\"marks\":[],\"text\":\"When asked what would best ensure AI is of benefit to humanity, Americans ranked holding AI companies legally liable for harm (47%) and prioritizing safety over growth (44%) as the highest-leverage actions.\"}],\"level\":1,\"listItem\":\"bullet\",\"markDefs\":[],\"style\":\"normal\"},{\"_key\":\"89e857597901\",\"_type\":\"block\",\"children\":[{\"_key\":\"78a89543c2a2\",\"_type\":\"span\",\"marks\":[],\"text\":\"Only 15% of Americans said they trust AI companies to make decisions about how AI is developed and used.\"}],\"level\":1,\"listItem\":\"bullet\",\"markDefs\":[],\"style\":\"normal\"},{\"_key\":\"ad3433b7f5a5\",\"_type\":\"mediaCarousel\",\"items\":[{\"media\":{\"image\":{\"_type\":\"imageWithCaption\",\"asset\":{\"_ref\":\"image-723f3519ffdbeb2184e516e3ba2323d75acd22c5-2528x2840-png\",\"_type\":\"reference\"},\"caption\":null,\"columnWidth\":\"inline-width\",\"height\":2840,\"mimeType\":\"image/png\",\"url\":\"https://cdn.sanity.io/images/4zrzovbb/website/723f3519ffdbeb2184e516e3ba2323d75acd22c5-2528x2840.png\",\"width\":2528},\"mediaType\":\"image\",\"video\":{\"_type\":\"video\",\"autoplay\":false,\"columnWidth\":\"full-width\",\"loop\":false,\"muted\":true,\"showControls\":true,\"thumbnail\":null,\"url\":null}},\"tabTitle\":\"Job-loss worry \"},{\"media\":{\"image\":{\"_type\":\"imageWithCaption\",\"asset\":{\"_ref\":\"image-507cad62820d33f5a2503f84759445032c22530e-2528x2844-png\",\"_type\":\"reference\"},\"caption\":null,\"columnWidth\":\"inline-width\",\"height\":2844,\"mimeType\":\"image/png\",\"url\":\"https://cdn.sanity.io/images/4zrzovbb/website/507cad62820d33f5a2503f84759445032c22530e-2528x2844.png\",\"width\":2528},\"mediaType\":\"image\",\"video\":{\"_type\":\"video\",\"autoplay\":false,\"columnWidth\":\"full-width\",\"loop\":false,\"muted\":true,\"showControls\":true,\"thumbnail\":null,\"url\":null}},\"tabTitle\":\"Integrated users\"},{\"media\":{\"image\":{\"_type\":\"imageWithCaption\",\"asset\":{\"_ref\":\"image-07db5342ec9e5fdfc971b37fced7d4dfcb6af6ee-2528x2844-png\",\"_type\":\"reference\"},\"caption\":null,\"columnWidth\":\"inline-width\",\"height\":2844,\"mimeType\":\"image/png\",\"url\":\"https://cdn.sanity.io/images/4zrzovbb/website/07db5342ec9e5fdfc971b37fced7d4dfcb6af6ee-2528x2844.png\",\"width\":2528},\"mediaType\":\"image\",\"video\":{\"_type\":\"video\",\"autoplay\":false,\"columnWidth\":\"full-width\",\"loop\":false,\"muted\":true,\"showControls\":true,\"thumbnail\":null,\"url\":null}},\"tabTitle\":\"Support for gov involvement \"}],\"markDefs\":null},{\"_key\":\"ac2d8923aca4\",\"_type\":\"block\",\"children\":[{\"_key\":\"389db65b21ca\",\"_type\":\"span\",\"marks\":[],\"text\":\"Strikingly, on most questions, AI did not heavily divide Americans along typical partisan, geographic, or educational lines. In general, there was broad consensus across topics: Americans are eager to realize AI’s promised benefits but fear the disruption it may bring, and they want accountability from the companies building it. To the extent we saw disagreement, it was largely only in the intensity of people's views.\"}],\"markDefs\":[],\"style\":\"normal\"},{\"_key\":\"1358203ae91d\",\"_type\":\"block\",\"children\":[{\"_key\":\"db290d4fa5cb\",\"_type\":\"span\",\"marks\":[],\"text\":\"This research builds on other work underway at Anthropic to understand how people use Claude and think about AI development. We recently conducted a global \"},{\"_key\":\"d914ec718fd6\",\"_type\":\"span\",\"marks\":[\"59c16e8914ef\"],\"text\":\"qualitative study of 81,000 Claude users\"},{\"_key\":\"3230d4b56e8c\",\"_type\":\"span\",\"marks\":[],\"text\":\" through \"},{\"_key\":\"95861d1b2ce1\",\"_type\":\"span\",\"marks\":[\"cbd524d58294\"],\"text\":\"Anthropic Interviewer\"},{\"_key\":\"2eec10574559\",\"_type\":\"span\",\"marks\":[],\"text\":\", our tool for conducting in-depth interviews at scale. We also regularly release data from the \"},{\"_key\":\"36657758b632\",\"_type\":\"span\",\"marks\":[\"7098ced9595e\"],\"text\":\"Anthropic Economic Index\"},{\"_key\":\"ff1df86d1e00\",\"_type\":\"span\",\"marks\":[],\"text\":\", which draws on anonymized Claude usage data to show how people around the world are employing AI. The Anthropic Public Record survey marks the first time we’ve spoken to the general public, allowing us to reach non-users of AI and better understand how attitudes differ across demographic lines.\"}],\"markDefs\":[{\"_key\":\"59c16e8914ef\",\"_type\":\"link\",\"blank\":true,\"href\":\"https://www.anthropic.com/features/81k-interviews\"},{\"_key\":\"7098ced9595e\",\"_type\":\"link\",\"blank\":true,\"href\":\"https://www.anthropic.com/economic-index\"},{\"_key\":\"cbd524d58294\",\"_type\":\"link\",\"blank\":true,\"href\":\"https://www.anthropic.com/news/anthropic-interviewer\"}],\"style\":\"normal\"},{\"_key\":\"0f8fe23e6ed1\",\"_type\":\"block\",\"children\":[{\"_key\":\"bc4ab7d4bc2e\",\"_type\":\"span\",\"marks\":[],\"text\":\"The Anthropic Public Record will be repeated regularly, evolving in scope as new topics become more salient, and allowing us to track how the public’s attitudes towards AI change as model capabilities advance and adoption deepens. In the future, we plan to expand outside the US. \"}],\"markDefs\":[],\"style\":\"normal\"},{\"_key\":\"d42dbe15daa1\",\"_type\":\"block\",\"children\":[{\"_key\":\"833b960d263d\",\"_type\":\"span\",\"marks\":[],\"text\":\"Method in brief\"}],\"markDefs\":[],\"style\":\"h2\"},{\"_key\":\"25722ad50297\",\"_type\":\"block\",\"children\":[{\"_key\":\"d2c4871d7400\",\"_type\":\"span\",\"marks\":[],\"text\":\"We conducted a nationally representative online survey in November and December of 2025 of 51,993 Americans, sourced from YouGov and weighted to US Census benchmarks. State samples range from n=232 (Alaska) to n=1,902 (New York), with state-level margins of error between ±2.6 and ±9.1 percentage points. More details on the methodology are available in the Appendix.\"}],\"markDefs\":[],\"style\":\"normal\"},{\"_key\":\"533b9c815055\",\"_type\":\"block\",\"children\":[{\"_key\":\"34c24c98414a\",\"_type\":\"span\",\"marks\":[],\"text\":\"What Americans hope AI will deliver\"}],\"markDefs\":[],\"style\":\"h2\"},{\"_key\":\"f38a93a94d27\",\"_type\":\"block\",\"children\":[{\"_key\":\"ea19d759bd24\",\"_type\":\"span\",\"marks\":[],\"text\":\"We asked Americans to choose their top three hopes for AI from a list of 17. Curing disease topped the list, with 48% of respondents putting it in their top three, 12 percentage points ahead of the second most commonly selected item, helping people with disabilities, at 36%. Items like therapy and reducing loneliness—or hopes that AI might substitute for human contact—were the lowest ranked of the options presented.\"}],\"markDefs\":[],\"style\":\"normal\"},{\"_key\":\"39ee940dd1fc\",\"_type\":\"image\",\"asset\":{\"_ref\":\"image-e8e083125487dcbc09340e15130901e2172c6754-2528x2372-png\",\"_type\":\"reference\"},\"caption\":null,\"columnWidth\":\"inline-width\",\"height\":2372,\"markDefs\":null,\"mimeType\":\"image/png\",\"url\":\"https://cdn.sanity.io/images/4zrzovbb/website/e8e083125487dcbc09340e15130901e2172c6754-2528x2372.png\",\"width\":2528},{\"_key\":\"d17310f0359f\",\"_type\":\"block\",\"children\":[{\"_key\":\"3edb838727d6\",\"_type\":\"span\",\"marks\":[],\"text\":\"What Americans fear\"}],\"markDefs\":[],\"style\":\"h2\"},{\"_key\":\"27032da2201b\",\"_type\":\"block\",\"children\":[{\"_key\":\"9ad0588825f0\",\"_type\":\"span\",\"marks\":[],\"text\":\"We gave respondents a list of 20 possible harms from AI, asked them to flag each one they felt personally concerned by and then to rate each on a five-point scale of how worried they were. We considered any response of 2 (somewhat worried) or higher as worried. (This methodology differs from the question above, in which we asked participants to rank \"},{\"_key\":\"f41dfbf14568\",\"_type\":\"span\",\"marks\":[\"em\"],\"text\":\"only \"},{\"_key\":\"ba76b41d2edc\",\"_type\":\"span\",\"marks\":[],\"text\":\"their three hopes; the numbers aren’t comparable.)\"}],\"markDefs\":[],\"style\":\"normal\"},{\"_key\":\"11c4b89f6780\",\"_type\":\"block\",\"children\":[{\"_key\":\"54cf12451a17\",\"_type\":\"span\",\"marks\":[],\"text\":\"Job loss was by far the most common concern, held by nearly two-thirds (64%) of Americans. This was followed by cognitive dependency—in which AI integration leaves people unable to think for themselves—at 56%, and misinformation at 52%. Job loss and cognitive dependency were also among the top fears in our \"},{\"_key\":\"8225eebf1d64\",\"_type\":\"span\",\"marks\":[\"2389f30b6666\"],\"text\":\"qualitative study of 81,000 people using Claude.\"}],\"markDefs\":[{\"_key\":\"2389f30b6666\",\"_type\":\"link\",\"blank\":true,\"href\":\"https://www.anthropic.com/features/81k-interviews\"}],\"style\":\"normal\"},{\"_key\":\"7f0cae4bcfdb\",\"_type\":\"block\",\"children\":[{\"_key\":\"3fcb16ce40ca\",\"_type\":\"span\",\"marks\":[],\"text\":\"The most common harms tended to be near-term and concrete: job loss, cognitive dependency, misinformation, criminal use, and surveillance. Each of these fears also predates AI, having precedent in an earlier technology—for example, automation causing job loss, smartphones fostering dependency, and social media spreading misinformation. In general, Americans tended to be more concerned with the misuse of AI than AI misalignment, citing criminal use, surveillance, and terrorism more frequently than, for example, AI “going rogue”.\"}],\"markDefs\":[],\"style\":\"normal\"},{\"_key\":\"d90dd3ec915d\",\"_type\":\"block\",\"children\":[{\"_key\":\"67bc36cff088\",\"_type\":\"span\",\"marks\":[],\"text\":\"For all but three of the harms we mentioned, a majority of respondents described themselves as “not worried,” but there was no potential harm about which less than 1/4 of Americans had at least some concern.\"}],\"markDefs\":[],\"style\":\"normal\"},{\"_key\":\"4a51beb0d87d\",\"_type\":\"image\",\"asset\":{\"_ref\":\"image-ef7aabafd7abdaae2892f9286877c788a52c9982-2528x2780-png\",\"_type\":\"reference\"},\"caption\":null,\"columnWidth\":\"inline-width\",\"height\":2780,\"markDefs\":null,\"mimeType\":\"image/png\",\"url\":\"https://cdn.sanity.io/images/4zrzovbb/website/ef7aabafd7abdaae2892f9286877c788a52c9982-2528x2780.png\",\"width\":2528},{\"_key\":\"2155ca2f1815\",\"_type\":\"block\",\"children\":[{\"_key\":\"2d594bc8b20a\",\"_type\":\"span\",\"marks\":[],\"text\":\"Patterns with job loss\"}],\"markDefs\":[],\"style\":\"h2\"},{\"_key\":\"e258c0b6a0f4\",\"_type\":\"block\",\"children\":[{\"_key\":\"64c56b1fe2c5\",\"_type\":\"span\",\"marks\":[],\"text\":\"Sixty-four percent of Americans are worried that AI will displace jobs. The concern is remarkably evenly distributed. It is the top-ranked fear among Democrats (67%) and Republicans (62%), in households with children (59%) and without (66%), and in every state from Iowa at the high end (71%) to Mississippi at the low end (57%).\"}],\"markDefs\":[],\"style\":\"normal\"},{\"_key\":\"960d62daab57\",\"_type\":\"image\",\"asset\":{\"_ref\":\"image-4653d27a2bfe64ecb26951b95083b1919753d67a-2528x2144-png\",\"_type\":\"reference\"},\"caption\":null,\"columnWidth\":\"inline-width\",\"height\":2144,\"markDefs\":null,\"mimeType\":\"image/png\",\"url\":\"https://cdn.sanity.io/images/4zrzovbb/website/4653d27a2bfe64ecb26951b95083b1919753d67a-2528x2144.png\",\"width\":2528},{\"_key\":\"00daf6d719d6\",\"_type\":\"block\",\"children\":[{\"_key\":\"02709f47077b\",\"_type\":\"span\",\"marks\":[],\"text\":\"Job loss concerns are higher among Americans with more education\"}],\"markDefs\":[],\"style\":\"h3\"},{\"_key\":\"bb65f1b1ef1c\",\"_type\":\"block\",\"children\":[{\"_key\":\"58b707ea38e3\",\"_type\":\"span\",\"marks\":[],\"text\":\"Concerns over job displacement rise with a respondent’s education level. Americans with postgraduate degrees are nearly 10 percentage points more worried about job loss than those with a high school education or less. The workers most worried about displacement, in other words, are the ones whose work already overlaps more closely with what AI is being asked to do—a finding \"},{\"_key\":\"9285a6d5fed1\",\"_type\":\"span\",\"marks\":[\"b23027fc2b46\"],\"text\":\"reflected \"},{\"_key\":\"d4ab5ff6614d\",\"_type\":\"span\",\"marks\":[],\"text\":\"in our economic research team’s analysis of our global Anthropic Interviewer study.\"}],\"markDefs\":[{\"_key\":\"b23027fc2b46\",\"_type\":\"link\",\"href\":\"https://www.anthropic.com/research/81k-economics\"}],\"style\":\"normal\"},{\"_key\":\"19ec7dc68604\",\"_type\":\"image\",\"asset\":{\"_ref\":\"image-a6adecdb6dcd4a10e8c131745de60b3423f07d9f-2528x1312-png\",\"_type\":\"reference\"},\"caption\":null,\"columnWidth\":\"inline-width\",\"height\":1312,\"markDefs\":null,\"mimeType\":\"image/png\",\"url\":\"https://cdn.sanity.io/images/4zrzovbb/website/a6adecdb6dcd4a10e8c131745de60b3423f07d9f-2528x1312.png\",\"width\":2528},{\"_key\":\"c7d48ae12606\",\"_type\":\"block\",\"children\":[{\"_key\":\"e516150bdd9a\",\"_type\":\"span\",\"marks\":[],\"text\":\"Fear of job loss is heightened among those who use AI least\"}],\"markDefs\":[],\"style\":\"h3\"},{\"_key\":\"4d33c9b70648\",\"_type\":\"block\",\"children\":[{\"_key\":\"b9036e729682\",\"_type\":\"span\",\"marks\":[],\"text\":\"At the same time, people who use AI at work every day are notably \"},{\"_key\":\"737d39ba96c5\",\"_type\":\"span\",\"marks\":[\"em\"],\"text\":\"less\"},{\"_key\":\"38880995a8c4\",\"_type\":\"span\",\"marks\":[],\"text\":\" worried about job loss than people who don’t use AI at all: 54% versus 70%.\"}],\"markDefs\":[],\"style\":\"normal\"},{\"_key\":\"19a98ea5e2c3\",\"_type\":\"image\",\"asset\":{\"_ref\":\"image-47710f04a3c93648488effd4b2d4d20d03656d74-2528x1596-png\",\"_type\":\"reference\"},\"caption\":null,\"columnWidth\":\"inline-width\",\"height\":1596,\"markDefs\":null,\"mimeType\":\"image/png\",\"url\":\"https://cdn.sanity.io/images/4zrzovbb/website/47710f04a3c93648488effd4b2d4d20d03656d74-2528x1596.png\",\"width\":2528},{\"_key\":\"93f29e5f4552\",\"_type\":\"block\",\"children\":[{\"_key\":\"767e405cec91\",\"_type\":\"span\",\"marks\":[],\"text\":\"There are many possible explanations for this trend. Hands-on experience with AI may help people develop skills and fluency that allow them to augment rather than automate parts of their job, making job loss seem like less of a looming threat. Hands-on experience may also reveal AI's limitations. Likely it’s a combination of these and other factors.\"}],\"markDefs\":[],\"style\":\"normal\"},{\"_key\":\"970b3ed4e94e\",\"_type\":\"block\",\"children\":[{\"_key\":\"236fe70e6398\",\"_type\":\"span\",\"marks\":[],\"text\":\"Perceived capabilities and acceptance of AI at work\"}],\"markDefs\":[],\"style\":\"h3\"},{\"_key\":\"c49c84c667ac\",\"_type\":\"block\",\"children\":[{\"_key\":\"ebbbdbe46272\",\"_type\":\"span\",\"marks\":[],\"text\":\"We gave respondents a list of 14 workplace tasks and for each asked two questions: “How well do you think an AI tool or application could perform this task today?” and “Thinking about your own job, how much AI involvement would you prefer for each of the following work tasks/purposes?”\"}],\"markDefs\":[],\"style\":\"normal\"},{\"_key\":\"f794baac1ab2\",\"_type\":\"block\",\"children\":[{\"_key\":\"4185cd5b67a1\",\"_type\":\"span\",\"marks\":[],\"text\":\"Overall assessment of AI capabilities was fairly high. At the high end, 75% of Americans said AI was as good or better than humans on research. At the low end, 44% said AI was as good or better in service and support.\"}],\"markDefs\":[],\"style\":\"normal\"},{\"_key\":\"fc9c0998c86d\",\"_type\":\"block\",\"children\":[{\"_key\":\"efbedc5db3ff\",\"_type\":\"span\",\"marks\":[],\"text\":\"On most tasks, a majority of Americans did not want AI involved\"},{\"_key\":\"d6caac74928d\",\"_type\":\"span\",\"marks\":[\"em\"],\"text\":\" \"},{\"_key\":\"442d5be3a06a\",\"_type\":\"span\",\"marks\":[],\"text\":\"in their jobs, and even on the tasks they rated AI most capable—such as research and data analysis—nearly half of respondents said they want no AI involvement in their own work. However, acceptance of AI involvement within the workplace seems to move in lockstep with perceived capabilities: the more competent AI is perceived to be in a given domain, the more likely people are to be willing to use it.\"}],\"markDefs\":[],\"style\":\"normal\"},{\"_key\":\"60dc4110e187\",\"_type\":\"image\",\"asset\":{\"_ref\":\"image-50c5fe81fc536fb4cfb27022811ba8d841f2ca8d-2528x2432-png\",\"_type\":\"reference\"},\"caption\":null,\"columnWidth\":\"inline-width\",\"height\":2432,\"markDefs\":null,\"mimeType\":\"image/png\",\"url\":\"https://cdn.sanity.io/images/4zrzovbb/website/50c5fe81fc536fb4cfb27022811ba8d841f2ca8d-2528x2432.png\",\"width\":2528},{\"_key\":\"65d29a8f32c6\",\"_type\":\"block\",\"children\":[{\"_key\":\"db02f88e429b\",\"_type\":\"span\",\"marks\":[],\"text\":\"Cognitive dependency is an anticipatory fear\"}],\"markDefs\":[],\"style\":\"h3\"},{\"_key\":\"bd2deb694be0\",\"_type\":\"block\",\"children\":[{\"_key\":\"dce194c27d61\",\"_type\":\"span\",\"marks\":[],\"text\":\"The second most common fear in our survey was cognitive dependency on AI. To better understand whether people might actually be experiencing dependency, we asked respondents how much disruption they would feel if AI became unavailable tomorrow, then compared the answers of those worried about dependency with those unconcerned by it.\"}],\"markDefs\":[],\"style\":\"normal\"},{\"_key\":\"7947f9366616\",\"_type\":\"block\",\"children\":[{\"_key\":\"b7835cfd7041\",\"_type\":\"span\",\"marks\":[],\"text\":\"So far, cognitive dependency appears to be a mostly anticipatory fear: of the 56% of Americans who expressed some worry over dependence, only roughly 1/5 would feel significant disruption if AI became unavailable. Conversely, among the 44% who don’t worry about dependency, a higher percentage—roughly 1/3—\"},{\"_key\":\"d6ab756364ec\",\"_type\":\"span\",\"marks\":[\"em\"],\"text\":\"would \"},{\"_key\":\"f91fb6ece232\",\"_type\":\"span\",\"marks\":[],\"text\":\"feel significant disruption.\"}],\"markDefs\":[],\"style\":\"normal\"},{\"_key\":\"e8c308450c33\",\"_type\":\"image\",\"asset\":{\"_ref\":\"image-28b1b9c63672d465d5f4a02a2b384ce693b27dca-2528x2516-png\",\"_type\":\"reference\"},\"caption\":null,\"columnWidth\":\"inline-width\",\"height\":2516,\"markDefs\":null,\"mimeType\":\"image/png\",\"url\":\"https://cdn.sanity.io/images/4zrzovbb/website/28b1b9c63672d465d5f4a02a2b384ce693b27dca-2528x2516.png\",\"width\":2528},{\"_key\":\"4dbd304c46a2\",\"_type\":\"block\",\"children\":[{\"_key\":\"77a939e1e379\",\"_type\":\"span\",\"marks\":[],\"text\":\"Our qualitative research among \"},{\"_key\":\"f871865ea376\",\"_type\":\"span\",\"marks\":[\"925ab3ab2280\"],\"text\":\"81,000 Claude users\"},{\"_key\":\"96b85002296c\",\"_type\":\"span\",\"marks\":[],\"text\":\" found that educators were 2.5 to 3 times more likely than average to report having witnessed cognitive atrophy firsthand, presumably in their students. In Anthropic Public Record, educators are likewise among the occupations most worried about dependency, second only to people working in arts and design.\"}],\"markDefs\":[{\"_key\":\"925ab3ab2280\",\"_type\":\"link\",\"href\":\"https://www.anthropic.com/features/81k-interviews\"}],\"style\":\"normal\"},{\"_key\":\"066d10b91b7e\",\"_type\":\"image\",\"asset\":{\"_ref\":\"image-3dd48f5843dd41ada5a6fc5abe3a26dced56d810-2528x1916-png\",\"_type\":\"reference\"},\"caption\":null,\"columnWidth\":\"inline-width\",\"height\":1916,\"markDefs\":null,\"mimeType\":\"image/png\",\"url\":\"https://cdn.sanity.io/images/4zrzovbb/website/3dd48f5843dd41ada5a6fc5abe3a26dced56d810-2528x1916.png\",\"width\":2528},{\"_key\":\"f10e8fcd667b\",\"_type\":\"block\",\"children\":[{\"_key\":\"81ca3f449a52\",\"_type\":\"span\",\"marks\":[],\"text\":\"As with job loss, the dependency fear falls steadily with usage. Americans who use AI daily at work are 16 points less worried about dependency (46%) than those who never do (62%).\"}],\"markDefs\":[],\"style\":\"normal\"},{\"_key\":\"ce411f939498\",\"_type\":\"block\",\"children\":[{\"_key\":\"db26f0f8d364\",\"_type\":\"span\",\"marks\":[],\"text\":\"What the heaviest AI users tell us\"}],\"markDefs\":[],\"style\":\"h2\"},{\"_key\":\"08bbca8852bb\",\"_type\":\"block\",\"children\":[{\"_key\":\"49835f97aacf\",\"_type\":\"span\",\"marks\":[],\"text\":\"As of late 2025, about 6% of Americans used AI every day for both\"},{\"_key\":\"cf97826e97cd\",\"_type\":\"span\",\"marks\":[\"em\"],\"text\":\" \"},{\"_key\":\"c8378032278d\",\"_type\":\"span\",\"marks\":[],\"text\":\"work and personal life. These \"},{\"_key\":\"41e491411658\",\"_type\":\"span\",\"marks\":[\"em\"],\"text\":\"integrated users \"},{\"_key\":\"c345d57263b5\",\"_type\":\"span\",\"marks\":[],\"text\":\"are a preview of what more intensive adoption of AI looks like, and possibly of where mainstream opinion is headed as adoption grows.\"}],\"markDefs\":[],\"style\":\"normal\"},{\"_key\":\"78744ac23b5e\",\"_type\":\"block\",\"children\":[{\"_key\":\"cbea64742003\",\"_type\":\"span\",\"marks\":[],\"text\":\"Integrated users skew young, male, urban, employed, and college-educated. Nearly two-thirds describe themselves as people who experiment with new technology before most others or adopt it early once they see its potential, compared to 30% in the general public.\"}],\"markDefs\":[],\"style\":\"normal\"},{\"_key\":\"7126d0b0e858\",\"_type\":\"image\",\"asset\":{\"_ref\":\"image-1e09703a3cc891672624602963e9d63e5559ec4b-2528x3456-png\",\"_type\":\"reference\"},\"caption\":null,\"columnWidth\":\"inline-width\",\"height\":3456,\"markDefs\":null,\"mimeType\":\"image/png\",\"url\":\"https://cdn.sanity.io/images/4zrzovbb/website/1e09703a3cc891672624602963e9d63e5559ec4b-2528x3456.png\",\"width\":2528},{\"_key\":\"626614092a69\",\"_type\":\"block\",\"children\":[{\"_key\":\"d3b301a379b6\",\"_type\":\"span\",\"marks\":[],\"text\":\"Integrated users are less worried than the general public across each of the harms we listed, though this probably reflects differences in the outlook of early adopters.\"}],\"markDefs\":[],\"style\":\"normal\"},{\"_key\":\"0a2974d9c4e9\",\"_type\":\"image\",\"asset\":{\"_ref\":\"image-2a4141655ac5dcbaff410f46fd9d13b9ecdbedc8-2528x1456-png\",\"_type\":\"reference\"},\"caption\":null,\"columnWidth\":\"inline-width\",\"height\":1456,\"markDefs\":null,\"mimeType\":\"image/png\",\"url\":\"https://cdn.sanity.io/images/4zrzovbb/website/2a4141655ac5dcbaff410f46fd9d13b9ecdbedc8-2528x1456.png\",\"width\":2528},{\"_key\":\"042d543b51b7\",\"_type\":\"block\",\"children\":[{\"_key\":\"ee00ce75490a\",\"_type\":\"span\",\"marks\":[],\"text\":\"What Americans want from AI governance\"}],\"markDefs\":[],\"style\":\"h2\"},{\"_key\":\"7be0b88c7b64\",\"_type\":\"block\",\"children\":[{\"_key\":\"e483e6167778\",\"_type\":\"span\",\"marks\":[],\"text\":\"71% of Americans say the government should be involved in the development and regulation of AI. The figure is 79% among Democrats, 68% among Republicans, and 69% among Independents—a bipartisan supermajority. A majority in every state and territory we surveyed supports government involvement in AI, from 81% in the District of Columbia to 63% in Hawaii.\"}],\"markDefs\":[],\"style\":\"normal\"},{\"_key\":\"3b69831e1e13\",\"_type\":\"image\",\"asset\":{\"_ref\":\"image-f3e56b04f92bcb5ad89ae415ef23652f60f3057f-2528x2596-png\",\"_type\":\"reference\"},\"caption\":null,\"columnWidth\":\"inline-width\",\"height\":2596,\"markDefs\":null,\"mimeType\":\"image/png\",\"url\":\"https://cdn.sanity.io/images/4zrzovbb/website/f3e56b04f92bcb5ad89ae415ef23652f60f3057f-2528x2596.png\",\"width\":2528},{\"_key\":\"6ea7a0a1e1f1\",\"_type\":\"block\",\"children\":[{\"_key\":\"410f12500a53\",\"_type\":\"span\",\"marks\":[],\"text\":\"Where Americans want government to act\"}],\"markDefs\":[],\"style\":\"h3\"},{\"_key\":\"ed424cdacfeb\",\"_type\":\"block\",\"children\":[{\"_key\":\"79bf42cd1f71\",\"_type\":\"span\",\"marks\":[],\"text\":\"We then asked about eight specific domains, and how heavily the government should be involved in each. Only two—privacy and child safety—draw outright majority support for more than a minimal role. National security, meanwhile, has the narrowest partisan gap of any domain, just three points between Democrats and Republicans.\"}],\"markDefs\":[],\"style\":\"normal\"},{\"_key\":\"7a91f0dbb5cf\",\"_type\":\"image\",\"asset\":{\"_ref\":\"image-b59aa2814c89f05f0fdcc01aca5bd86d7080b5d1-2528x2136-png\",\"_type\":\"reference\"},\"caption\":null,\"columnWidth\":\"inline-width\",\"height\":2136,\"markDefs\":null,\"mimeType\":\"image/png\",\"url\":\"https://cdn.sanity.io/images/4zrzovbb/website/b59aa2814c89f05f0fdcc01aca5bd86d7080b5d1-2528x2136.png\",\"width\":2528},{\"_key\":\"0621171879c7\",\"_type\":\"block\",\"children\":[{\"_key\":\"879105b8d65d\",\"_type\":\"span\",\"marks\":[],\"text\":\"What Americans want from the industry\"}],\"markDefs\":[],\"style\":\"h3\"},{\"_key\":\"81c0bfef4b9e\",\"_type\":\"block\",\"children\":[{\"_key\":\"0ce7546b789f\",\"_type\":\"span\",\"marks\":[],\"text\":\"When we asked what should happen to ensure AI is developed in humanity's interest, Americans converged on two answers: hold AI companies legally liable for harm (47% chose it among their top three) and prioritize safety over growth (44%). Independent watchdogs with real power (29%) and slowing AI development for safety (27%) followed.\"}],\"markDefs\":[],\"style\":\"normal\"},{\"_key\":\"d94a6439aee0\",\"_type\":\"image\",\"asset\":{\"_ref\":\"image-add14f5405fd185ef6e0e523d1212fb46215c5a1-2528x2172-png\",\"_type\":\"reference\"},\"caption\":null,\"columnWidth\":\"inline-width\",\"height\":2172,\"markDefs\":null,\"mimeType\":\"image/png\",\"url\":\"https://cdn.sanity.io/images/4zrzovbb/website/add14f5405fd185ef6e0e523d1212fb46215c5a1-2528x2172.png\",\"width\":2528},{\"_key\":\"fba0b74e18ec\",\"_type\":\"block\",\"children\":[{\"_key\":\"fc0d9ccabc04\",\"_type\":\"span\",\"marks\":[],\"text\":\"The trust deficit\"}],\"markDefs\":[],\"style\":\"h3\"},{\"_key\":\"c83838eab836\",\"_type\":\"block\",\"children\":[{\"_key\":\"6adde89343eb\",\"_type\":\"span\",\"marks\":[],\"text\":\"Only 15% of Americans said they trust AI companies to make decisions about how the technology is developed and used. That was the lowest figure for any institution we tested, below the federal government (20%), state and local government (19%), and international bodies (20%), and far below independent experts (43%).\"}],\"markDefs\":[],\"style\":\"normal\"},{\"_key\":\"ba4c1c47434c\",\"_type\":\"image\",\"asset\":{\"_ref\":\"image-90be42bbfd5671adf2a1f621669d5f688df0abbc-2528x1536-png\",\"_type\":\"reference\"},\"caption\":null,\"columnWidth\":\"inline-width\",\"height\":1536,\"markDefs\":null,\"mimeType\":\"image/png\",\"url\":\"https://cdn.sanity.io/images/4zrzovbb/website/90be42bbfd5671adf2a1f621669d5f688df0abbc-2528x1536.png\",\"width\":2528},{\"_key\":\"911a48f0f05a\",\"_type\":\"block\",\"children\":[{\"_key\":\"4123dcf5783f\",\"_type\":\"span\",\"marks\":[],\"text\":\"Integrated users have the same appetite for regulation and oversight\"}],\"markDefs\":[],\"style\":\"h3\"},{\"_key\":\"5c9908afac1d\",\"_type\":\"block\",\"children\":[{\"_key\":\"01319528f5f0\",\"_type\":\"span\",\"marks\":[],\"text\":\"Integrated users were more trusting of every institution we asked about, including AI companies—and were markedly less inclined to say AI development should be slowed or stopped. However, they also support government involvement on AI at essentially the national rate (74% versus 71%), and across the eight specific governance domains we tested, their preferences are nearly indistinguishable from the public's.\"}],\"markDefs\":[],\"style\":\"normal\"},{\"_key\":\"2a7d49484bf6\",\"_type\":\"block\",\"children\":[{\"_key\":\"82df593cec4e\",\"_type\":\"span\",\"marks\":[],\"text\":\"Anthropic initiatives and what comes next\"}],\"markDefs\":[],\"style\":\"h2\"},{\"_key\":\"d9951b6cda19\",\"_type\":\"block\",\"children\":[{\"_key\":\"5b6268d2f156\",\"_type\":\"span\",\"marks\":[],\"text\":\"Public input is critical to ensuring that powerful AI serves humanity’s interests. Anthropic Public Record, Anthropic Interviewer, the Anthropic Economic Index, and many of our other research projects are all efforts to gain greater understanding and input from the public about how to make the AI transition go well.\"}],\"markDefs\":[],\"style\":\"normal\"},{\"_key\":\"5ee86ae95aa7\",\"_type\":\"block\",\"children\":[{\"_key\":\"dbe8ef6887c8\",\"_type\":\"span\",\"marks\":[],\"text\":\"We recently announced several \"},{\"_key\":\"556f5cfd8d50\",\"_type\":\"span\",\"marks\":[\"16b86f166ead\"],\"text\":\"policy frameworks\"},{\"_key\":\"532cf95899bb\",\"_type\":\"span\",\"marks\":[],\"text\":\" relevant to these findings. Our Advanced AI Framework proposes mandatory independent safety testing for frontier models, transparency requirements, and government authority to block or recall dangerous AI deployments. Our Economic Policy Framework lays out how governments can prepare for AI's economic impacts—minimizing job displacement where possible, and supporting workers so that AI's benefits are broadly shared.\"}],\"markDefs\":[{\"_key\":\"16b86f166ead\",\"_type\":\"link\",\"blank\":true,\"href\":\"https://www.anthropic.com/policy-on-the-ai-exponential\"}],\"style\":\"normal\"},{\"_key\":\"63be55d718fe\",\"_type\":\"block\",\"children\":[{\"_key\":\"9d0d1bc742eb\",\"_type\":\"span\",\"marks\":[],\"text\":\"The direction AI takes should not be set only by the companies building it. The more clearly the public’s hopes and concerns are measured, the better we—and other companies—can meet them.\"}],\"markDefs\":[],\"style\":\"normal\"},{\"_key\":\"45d278ca1711\",\"_type\":\"block\",\"children\":[{\"_key\":\"05ff7bb4d8bb\",\"_type\":\"span\",\"marks\":[],\"text\":\"Appendix: Methodology\"}],\"markDefs\":[],\"style\":\"h2\"},{\"_key\":\"80654e55f0c3\",\"_type\":\"block\",\"children\":[{\"_key\":\"fb0325b6c259\",\"_type\":\"span\",\"marks\":[\"strong\"],\"text\":\"Population and mode: \"},{\"_key\":\"ff78d60065f9\",\"_type\":\"span\",\"marks\":[],\"text\":\"Anthropic Public Record is an online survey of the US late-teen and adult internet population, age 16 and over, resident in the 50 states, the District of Columbia, or Puerto Rico. Fieldwork was conducted by YouGov from its online panel between November 1 and December 11, 2025.\"}],\"markDefs\":[],\"style\":\"normal\"},{\"_key\":\"fdc8688bf67c\",\"_type\":\"block\",\"children\":[{\"_key\":\"e467e939a481\",\"_type\":\"span\",\"marks\":[\"strong\"],\"text\":\"Sample design: \"},{\"_key\":\"c2d5053dddc8\",\"_type\":\"span\",\"marks\":[],\"text\":\"The study was designed as 52 parallel state and territory samples with a target of approximately 1,000 completes per state (approximately 500 in Montana, North Dakota, South Dakota, Wyoming, Vermont, and Puerto Rico). Quotas were set within each state on age, gender, education, and race/ethnicity. The achieved sample is 51,993 completes, with state sample sizes ranging from 232 (Alaska) to 1,902 (New York).\"}],\"markDefs\":[],\"style\":\"normal\"},{\"_key\":\"fb5518589513\",\"_type\":\"block\",\"children\":[{\"_key\":\"70f8290a0538\",\"_type\":\"span\",\"marks\":[\"strong\"],\"text\":\"Weighting: \"},{\"_key\":\"2a99842b6e64\",\"_type\":\"span\",\"marks\":[],\"text\":\"Data are weighted to be representative of the US resident population age 16 and over on state, age, gender, education, and race/ethnicity. Weights are normalized to the achieved sample size (mean 1.00, sum 51,993).\"}],\"markDefs\":[],\"style\":\"normal\"},{\"_key\":\"4ec3a50a398e\",\"_type\":\"block\",\"children\":[{\"_key\":\"c76e64ed5c12\",\"_type\":\"span\",\"marks\":[\"strong\"],\"text\":\"Margin of error: \"},{\"_key\":\"e2576aa75bd8\",\"_type\":\"span\",\"marks\":[],\"text\":\"The national margin of sampling error is ±0.6 percentage points at the 95% confidence level for a proportion of 50%. State-level margins of error range from ±2.6 points (California, New York, Texas) to ±9.1 points (Wyoming). Margins of error for subgroups are larger.\"}],\"markDefs\":[],\"style\":\"normal\"},{\"_key\":\"2255fc671b3e\",\"_type\":\"block\",\"children\":[{\"_key\":\"5165845536b5\",\"_type\":\"span\",\"marks\":[\"strong\"],\"text\":\"Reporting conventions: \"},{\"_key\":\"a853f28364e5\",\"_type\":\"span\",\"marks\":[],\"text\":\"All percentages in this report are weighted. Unless noted otherwise, percentages use the full segment as the denominator (respondents who answered \\\"don't know\\\" or skipped remain in the base). \\\"Worried\\\" on the fears battery is the top four boxes of a five-point worry scale. \\\"As good or better\\\" on the capability battery is the top three boxes of a five-point performance scale. \\\"Integrated users\\\" are respondents who report using AI one or more times daily for work and one or more times daily for personal purposes (unweighted n=2,717). Party affiliation groups include leaners. \"}],\"markDefs\":[],\"style\":\"normal\"},{\"_key\":\"a6103d0f732e\",\"_type\":\"block\",\"children\":[{\"_key\":\"d4f13fdde9dc\",\"_type\":\"span\",\"marks\":[\"strong\"],\"text\":\"Limitations: \"},{\"_key\":\"09ded26e51f8\",\"_type\":\"span\",\"marks\":[],\"text\":\"Anthropic Public Record captures what Americans believed about AI in late 2025. We are treating it as a baseline. \"}],\"markDefs\":[],\"style\":\"normal\"}],\"cardImage\":{\"_type\":\"image\",\"asset\":{\"_ref\":\"image-e2db332cd2a52cea00ca71c17f761e36b412077b-1280x1280-jpg\",\"_type\":\"reference\"},\"height\":1280,\"mimeType\":\"image/jpeg\",\"url\":\"https://cdn.sanity.io/images/4zrzovbb/website/e2db332cd2a52cea00ca71c17f761e36b412077b-1280x1280.jpg\",\"width\":1280},\"collections\":[\"institute\"],\"cta\":null,\"footnotesBody\":null,\"hero\":{\"_type\":\"image\",\"asset\":{\"_ref\":\"image-d5a7bcc25c2d829930625aa836441383924d22a7-2000x1125-jpg\",\"_type\":\"reference\"},\"caption\":null,\"height\":1125,\"mimeType\":\"image/jpeg\",\"url\":\"https://cdn.sanity.io/images/4zrzovbb/website/d5a7bcc25c2d829930625aa836441383924d22a7-2000x1125.jpg\",\"width\":2000},\"heroVideo\":null,\"hideHero\":null,\"importedFrom\":{\"importedAt\":\"2026-09-28T03:21:25.453Z\",\"postId\":\"2ea40712-b90c-41d4-9e9b-71a96f23fc71\",\"postRev\":\"GRtmxBnPT0vg9u3idmvdEM\"},\"linkedUrl\":null,\"meta\":{\"robotsIndexable\":true,\"sanityDocument\":{\"_id\":\"article-2ea40712-b90c-41d4-9e9b-71a96f23fc71\",\"_type\":\"article\"},\"seoDescription\":\"Anthropic Public Record is a national survey of attitudes and opinions towards AI.\",\"seoTitle\":\"Results from first Anthropic Public Record\",\"socialImage\":{\"_type\":\"image\",\"asset\":{\"_createdAt\":\"2026-10-15T04:15:52Z\",\"_id\":\"image-44cb011476c84f7a91e0815d6bd65afc910accd4-1200x630-jpg\",\"_rev\":\"XEXbdYY4y2bXr7SSMVX429\",\"_type\":\"sanity.imageAsset\",\"_updatedAt\":\"2026-10-15T04:15:52Z\",\"assetId\":\"44cb011476c84f7a91e0815d6bd65afc910accd4\",\"extension\":\"jpg\",\"metadata\":{\"_type\":\"sanity.imageMetadata\",\"blurHash\":\"MRG*mJ00xu-oRj^-9ER-xut6kDa|t6R+WC\",\"dimensions\":{\"_type\":\"sanity.imageDimensions\",\"aspectRatio\":1.9047619047619047,\"height\":630,\"width\":1200},\"hasAlpha\":false,\"isOpaque\":true,\"lqip\":\"data:image/jpeg;base64,\",\"palette\":{\"_type\":\"sanity.imagePalette\",\"darkMuted\":{\"_type\":\"sanity.imagePaletteSwatch\",\"background\":\"#544c24\",\"foreground\":\"#fff\",\"population\":0,\"title\":\"#fff\"},\"darkVibrant\":{\"_type\":\"sanity.imagePaletteSwatch\",\"background\":\"#84440c\",\"foreground\":\"#fff\",\"population\":0,\"title\":\"#fff\"},\"dominant\":{\"_type\":\"sanity.imagePaletteSwatch\",\"background\":\"#c18b45\",\"foreground\":\"#fff\",\"population\":8.67,\"title\":\"#fff\"},\"lightMuted\":{\"_type\":\"sanity.imagePaletteSwatch\",\"background\":\"#d4b7b1\",\"foreground\":\"#000\",\"population\":0.09,\"title\":\"#fff\"},\"lightVibrant\":{\"_type\":\"sanity.imagePaletteSwatch\",\"background\":\"#e4a464\",\"foreground\":\"#000\",\"population\":0.01,\"title\":\"#fff\"},\"muted\":{\"_type\":\"sanity.imagePaletteSwatch\",\"background\":\"#9a7442\",\"foreground\":\"#fff\",\"population\":5.66,\"title\":\"#fff\"},\"vibrant\":{\"_type\":\"sanity.imagePaletteSwatch\",\"background\":\"#c18b45\",\"foreground\":\"#fff\",\"population\":8.67,\"title\":\"#fff\"}},\"thumbHash\":\"mhgOHIagWYU7l3mHeIaAwQdoeQ==\"},\"mimeType\":\"image/jpeg\",\"originalFilename\":\"results-public-record_og.jpg\",\"path\":\"images/4zrzovbb/website/44cb011476c84f7a91e0815d6bd65afc910accd4-1200x630.jpg\",\"sha1hash\":\"44cb011476c84f7a91e0815d6bd65afc910accd4\",\"size\":119169,\"uploadId\":\"63f2513500e7e65a28417cb2c75b09a8b8834a97\",\"url\":\"https://cdn.sanity.io/images/4zrzovbb/website/44cb011476c84f7a91e0815d6bd65afc910accd4-1200x630.jpg\"}}},\"publishedOn\":\"2026-06-12\",\"showShareMeta\":null,\"slug\":{\"_type\":\"slug\",\"current\":\"anthropic-public-record\"},\"tags\":[{\"name\":\"How people use AI\",\"topic\":\"economy-and-society\"},{\"name\":\"Labor market\",\"topic\":\"economy-and-society\"},{\"name\":\"Legal guardrails\",\"topic\":\"policy\"},{\"name\":\"Transparency\",\"topic\":\"safety\"},{\"name\":\"Research programs\",\"topic\":\"anthropic\"}],\"teams\":[{\"_id\":\"e33642db-8fbe-4eeb-9d23-145b140a3f91\",\"mark\":{\"lightImage\":{\"_type\":\"image\",\"asset\":{\"_ref\":\"image-9b12016886c809d29294db1898f3ca818240e203-41x41-svg\",\"_type\":\"reference\"},\"height\":41,\"mimeType\":\"image/svg+xml\",\"url\":\"https://cdn.sanity.io/images/4zrzovbb/website/9b12016886c809d29294db1898f3ca818240e203-41x41.svg\",\"width\":41}},\"slug\":{\"_type\":\"slug\",\"current\":\"soc