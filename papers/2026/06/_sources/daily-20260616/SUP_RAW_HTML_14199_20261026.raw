<td id="A5.T10.12.1.2" class="ltx_td ltx_align_center ltx_border_tt" style="padding-left:4.0pt;padding-right:4.0pt;"><span id="A5.T10.12.1.2.1" class="ltx_text ltx_font_bold">Cap.</span></td>
<td id="A5.T10.12.1.3" class="ltx_td ltx_nopad_l ltx_align_left ltx_border_tt" style="padding-left:4.0pt;padding-right:4.0pt;"><span id="A5.T10.12.1.3.1" class="ltx_text ltx_font_bold">Dataset</span></td>
<td id="A5.T10.12.1.4" class="ltx_td ltx_align_center ltx_border_tt" style="padding-left:4.0pt;padding-right:4.0pt;"><span id="A5.T10.12.1.4.1" class="ltx_text ltx_font_bold">Cap.</span></td>
<td id="A5.T10.12.1.5" class="ltx_td ltx_nopad_l ltx_align_left ltx_border_tt" style="padding-left:4.0pt;padding-right:4.0pt;"><span id="A5.T10.12.1.5.1" class="ltx_text ltx_font_bold">Dataset</span></td>
<td id="A5.T10.12.1.6" class="ltx_td ltx_nopad_r ltx_align_center ltx_border_tt" style="padding-left:4.0pt;padding-right:4.0pt;"><span id="A5.T10.12.1.6.1" class="ltx_text ltx_font_bold">Cap.</span></td></tr>
<tr id="A5.T10.12.2" class="ltx_tr">
<td id="A5.T10.12.2.1" class="ltx_td ltx_align_left ltx_border_t" style="padding-left:4.0pt;padding-right:4.0pt;"><span id="A5.T10.12.2.1.1" class="ltx_text ltx_font_typewriter">alignx_v2</span></td>
<td id="A5.T10.12.2.2" class="ltx_td ltx_align_center ltx_border_t" style="padding-left:4.0pt;padding-right:4.0pt;"><span id="A5.T10.12.2.2.1" class="ltx_text ltx_font_typewriter">ROLE</span></td>
