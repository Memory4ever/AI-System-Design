<td id="S3.T1.8.1.13.12" class="ltx_td ltx_align_center" style="padding:0.25pt 5.0pt;">5.28</td>
<td id="S3.T1.8.1.13.13" class="ltx_td ltx_align_center" style="padding:0.25pt 5.0pt;">26.08</td></tr>
