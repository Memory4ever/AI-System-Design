<td id="A5.T11.8.8.1" class="ltx_td ltx_align_left" style="padding:0.25pt 4.0pt;">Hitom</td>
<td id="A5.T11.8.8.2" class="ltx_td ltx_align_left" style="padding:0.25pt 4.0pt;"><span id="A5.T11.8.8.2.1" class="ltx_text ltx_font_typewriter">tom_hitom</span> train split</td>
<td id="A5.T11.8.8.3" class="ltx_td ltx_align_left" style="padding:0.25pt 4.0pt;">Direct</td>
<td id="A5.T11.8.8.4" class="ltx_td ltx_align_right" style="padding:0.25pt 4.0pt;">899</td></tr>
<tr id="A5.T11.8.9" class="ltx_tr">
<td id="A5.T11.8.9.1" class="ltx_td ltx_align_left" style="padding:0.25pt 4.0pt;">Paratomi</td>
<td id="A5.T11.8.9.2" class="ltx_td ltx_align_left" style="padding:0.25pt 4.0pt;"><span id="A5.T11.8.9.2.1" class="ltx_text ltx_font_typewriter">tom_paratomi</span> train split</td>
<td id="A5.T11.8.9.3" class="ltx_td ltx_align_left" style="padding:0.25pt 4.0pt;">Direct</td>
<td id="A5.T11.8.9.4" class="ltx_td ltx_align_right" style="padding:0.25pt 4.0pt;">—</td></tr>
<tr id="A5.T11.8.10" class="ltx_tr">
