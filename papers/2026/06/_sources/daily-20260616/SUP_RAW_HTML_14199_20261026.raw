<span id="S5.T2.10.1.4.2.1.2.1" class="ltx_td ltx_nopad_r ltx_align_center" style="padding-left:3.0pt;padding-right:3.0pt;"><span id="S5.T2.10.1.4.2.1.2.1.1" class="ltx_text ltx_font_bold">3.1 Pro</span></span></span>
</span></span><span id="S5.T2.10.1.4.3" class="ltx_text"></span></td>
<td id="S5.T2.10.1.5" class="ltx_td ltx_align_center ltx_border_tt" style="padding-left:3.0pt;padding-right:3.0pt;"><span id="S5.T2.10.1.5.1" class="ltx_text"></span> <span id="S5.T2.10.1.5.2" class="ltx_text">
<span id="S5.T2.10.1.5.2.1" class="ltx_tabular ltx_align_middle">
<span id="S5.T2.10.1.5.2.1.1" class="ltx_tr">
<span id="S5.T2.10.1.5.2.1.1.1" class="ltx_td ltx_nopad_r ltx_align_center" style="padding-left:3.0pt;padding-right:3.0pt;"><span id="S5.T2.10.1.5.2.1.1.1.1" class="ltx_text ltx_font_bold">Claude</span></span></span>
<span id="S5.T2.10.1.5.2.1.2" class="ltx_tr">
<span id="S5.T2.10.1.5.2.1.2.1" class="ltx_td ltx_nopad_r ltx_align_center" style="padding-left:3.0pt;padding-right:3.0pt;"><span id="S5.T2.10.1.5.2.1.2.1.1" class="ltx_text ltx_font_bold">Opus 4.7</span></span></span>
</span></span><span id="S5.T2.10.1.5.3" class="ltx_text"></span></td>
<td id="S5.T2.10.1.6" class="ltx_td ltx_align_center ltx_border_tt" style="padding-left:3.0pt;padding-right:3.0pt;"><span id="S5.T2.10.1.6.1" class="ltx_text"></span> <span id="S5.T2.10.1.6.2" class="ltx_text">
<span id="S5.T2.10.1.6.2.1" class="ltx_tabular ltx_align_middle">
<span id="S5.T2.10.1.6.2.1.1" class="ltx_tr">
<span id="S5.T2.10.1.6.2.1.1.1" class="ltx_td ltx_nopad_r ltx_align_center" style="padding-left:3.0pt;padding-right:3.0pt;"><span id="S5.T2.10.1.6.2.1.1.1.1" class="ltx_text ltx_font_bold">Qwen</span></span></span>
