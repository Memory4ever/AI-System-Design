<td id="A8.T10.2.1.2.2" class="ltx_td ltx_align_center ltx_border_t">.315/.080/.395</td>
<td id="A8.T10.2.1.2.3" class="ltx_td ltx_align_center ltx_border_t"><span id="A8.T10.2.1.2.3.1" class="ltx_text ltx_font_bold" style="--ltx-fg-color:#8FB4DC;">.325</span>/<span id="A8.T10.2.1.2.3.2" class="ltx_text ltx_font_bold" style="--ltx-fg-color:#F5AA61;">.105</span>/<span id="A8.T10.2.1.2.3.3" class="ltx_text ltx_font_bold" style="--ltx-fg-color:#70CDBE;">.760</span></td>
