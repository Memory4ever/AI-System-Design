<td id="A8.T10.2.1.3.3" class="ltx_td ltx_align_center">.180/<span id="A8.T10.2.1.3.3.1" class="ltx_text ltx_font_bold" style="--ltx-fg-color:#F5AA61;">.910</span>/<span id="A8.T10.2.1.3.3.2" class="ltx_text ltx_font_bold" style="--ltx-fg-color:#70CDBE;">1.000</span></td>
<td id="A8.T10.2.1.3.4" class="ltx_td ltx_align_center">.240/.600/.242</td></tr>
