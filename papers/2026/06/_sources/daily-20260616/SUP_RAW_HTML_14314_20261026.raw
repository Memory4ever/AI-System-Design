<td id="A8.T9.2.1.4.3" class="ltx_td ltx_align_center">1.165/<span id="A8.T9.2.1.4.3.1" class="ltx_text ltx_font_bold" style="--ltx-fg-color:#F5AA61;">.280</span>/<span id="A8.T9.2.1.4.3.2" class="ltx_text ltx_font_bold" style="--ltx-fg-color:#70CDBE;">.930</span></td>
