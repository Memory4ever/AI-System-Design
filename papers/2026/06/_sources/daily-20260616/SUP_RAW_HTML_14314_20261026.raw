<th id="S6.T3.2.1.1.5" class="ltx_td ltx_align_center ltx_th ltx_th_column ltx_border_tt"><span id="S6.T3.2.1.1.5.1" class="ltx_text ltx_font_bold">ask_q</span></th></tr>
</thead>
<tbody class="ltx_tbody">
<tr id="S6.T3.2.1.2" class="ltx_tr">
<td id="S6.T3.2.1.2.1" class="ltx_td"></td>
<th id="S6.T3.2.1.2.2" class="ltx_td ltx_th ltx_th_column"></th>
