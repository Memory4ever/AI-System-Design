<th id="A8.T9.2.1.1.2" class="ltx_td ltx_align_center ltx_th ltx_th_column ltx_border_tt"><math id="A8.T9.m1" class="ltx_Math" alttext="M_{\text{text}}" display="inline" intent=":literal"><semantics><msub><mi>M</mi><mtext class="ltx_mathvariant_bold">text</mtext></msub><annotation encoding="application/x-tex">M_{\text{text}}</annotation></semantics></math></th>
