<td id="A8.T9.2.1.3.2" class="ltx_td ltx_align_center"><span id="A8.T9.2.1.3.2.1" class="ltx_text ltx_font_bold" style="--ltx-fg-color:#8FB4DC;">.270</span>/.860/.667</td>
