<td id="A8.T9.2.1.2.2" class="ltx_td ltx_align_center ltx_border_t"><span id="A8.T9.2.1.2.2.1" class="ltx_text ltx_font_bold" style="--ltx-fg-color:#8FB4DC;">.320</span>/.060/.385</td>
<td id="A8.T9.2.1.2.3" class="ltx_td ltx_align_center ltx_border_t">.255/<span id="A8.T9.2.1.2.3.1" class="ltx_text ltx_font_bold" style="--ltx-fg-color:#F5AA61;">.065</span>/<span id="A8.T9.2.1.2.3.2" class="ltx_text ltx_font_bold" style="--ltx-fg-color:#70CDBE;">.545</span></td>
<td id="A8.T9.2.1.2.4" class="ltx_td ltx_align_center ltx_border_t">.250/.035/.394</td></tr>
<tr id="A8.T9.2.1.3" class="ltx_tr">
