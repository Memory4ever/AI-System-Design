<td id="A8.T7.2.1.3.4" class="ltx_td ltx_align_center"><span id="A8.T7.2.1.3.4.1" class="ltx_text ltx_font_bold" style="--ltx-fg-color:#8FB4DC;">.320</span>/.000/1.00</td></tr>
