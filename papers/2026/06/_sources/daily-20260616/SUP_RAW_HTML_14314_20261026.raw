<td id="S5.T1.2.1.14.2" class="ltx_td ltx_align_left ltx_border_t">DeepSeek-V3.2</td>
<td id="S5.T1.2.1.14.3" class="ltx_td ltx_align_left ltx_border_t">GPT-4o</td>
<td id="S5.T1.2.1.14.4" class="ltx_td ltx_align_center ltx_border_t"><span id="S5.T1.2.1.14.4.1" class="ltx_text ltx_font_bold" style="--ltx-fg-color:#8FB4DC;">.205</span>/.628/<span id="S5.T1.2.1.14.4.2" class="ltx_text ltx_font_bold" style="--ltx-fg-color:#70CDBE;">.865</span></td>
<td id="S5.T1.2.1.14.5" class="ltx_td ltx_align_center ltx_border_t">.180/<span id="S5.T1.2.1.14.5.1" class="ltx_text ltx_font_bold" style="--ltx-fg-color:#F5AA61;">.810</span>/.673</td>
<td id="S5.T1.2.1.14.6" class="ltx_td ltx_align_center ltx_border_t">.195/.695/.766</td></tr>
