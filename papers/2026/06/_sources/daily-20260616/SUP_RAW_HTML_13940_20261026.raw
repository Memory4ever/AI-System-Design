<td id="S5.T2.14.1.26.7" class="ltx_td ltx_align_center ltx_border_bb" style="padding:-0.25pt 0.0pt;"><span id="S5.T2.14.1.26.7.1" class="ltx_text ltx_underline">70.1</span></td>
