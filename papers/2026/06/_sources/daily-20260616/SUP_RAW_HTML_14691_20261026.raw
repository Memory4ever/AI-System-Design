</span></th>
<td id="A3.T7.2.3.2" class="ltx_td ltx_align_center" style="padding-left:3.0pt;padding-right:3.0pt;">7.36%</td>
<td id="A3.T7.2.3.3" class="ltx_td ltx_align_center" style="padding-left:3.0pt;padding-right:3.0pt;">5.95%</td>
<td id="A3.T7.2.3.4" class="ltx_td ltx_nopad_r ltx_align_center" style="padding-left:3.0pt;padding-right:3.0pt;">+1.41</td></tr>
<tr id="A3.T7.2.4" class="ltx_tr">
<th id="A3.T7.2.4.1" class="ltx_td ltx_align_left ltx_th ltx_th_row ltx_border_bb ltx_border_t" style="padding-left:3.0pt;padding-right:3.0pt;" rowspan="4"><span id="A3.T7.2.4.1.1" class="ltx_text">Detailed analysis</span></th>
<th id="A3.T7.2.4.2" class="ltx_td ltx_align_left ltx_th ltx_th_row ltx_border_t" style="padding-left:3.0pt;padding-right:3.0pt;">
<span id="A3.T7.2.4.2.1" class="ltx_inline-block ltx_align_top">
<span id="A3.T7.2.4.2.1.1" class="ltx_p">CC: consistent and correct <math id="A3.T7.m4" class="ltx_Math" alttext="\uparrow" display="inline" intent=":literal"><semantics><mo stretchy="false">↑</mo><annotation encoding="application/x-tex">\uparrow</annotation></semantics></math></span>
</span></th>
<td id="A3.T7.2.4.3" class="ltx_td ltx_align_center ltx_border_t" style="padding-left:3.0pt;padding-right:3.0pt;">72.25%</td>
<td id="A3.T7.2.4.4" class="ltx_td ltx_align_center ltx_border_t" style="padding-left:3.0pt;padding-right:3.0pt;">71.38%</td>
