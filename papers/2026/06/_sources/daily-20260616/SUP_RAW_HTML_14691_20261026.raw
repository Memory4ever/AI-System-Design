<span id="A3.T7.2.5.1.1.1" class="ltx_p">CW: consistent but wrong <math id="A3.T7.m5" class="ltx_Math" alttext="\downarrow" display="inline" intent=":literal"><semantics><mo stretchy="false">↓</mo><annotation encoding="application/x-tex">\downarrow</annotation></semantics></math></span>
</span></th>
<td id="A3.T7.2.5.2" class="ltx_td ltx_align_center" style="padding-left:3.0pt;padding-right:3.0pt;">18.95%</td>
<td id="A3.T7.2.5.3" class="ltx_td ltx_align_center" style="padding-left:3.0pt;padding-right:3.0pt;">22.14%</td>
<td id="A3.T7.2.5.4" class="ltx_td ltx_nopad_r ltx_align_center" style="padding-left:3.0pt;padding-right:3.0pt;">-3.18</td></tr>
<tr id="A3.T7.2.6" class="ltx_tr">
<th id="A3.T7.2.6.1" class="ltx_td ltx_align_left ltx_th ltx_th_row" style="padding-left:3.0pt;padding-right:3.0pt;">
