<th id="S3.T1.2.1.2.6" class="ltx_td ltx_align_center ltx_th ltx_th_column ltx_border_r ltx_border_t" style="padding:0.25pt 5.0pt;">IR<math id="S3.T1.m6" class="ltx_Math" alttext="\downarrow" display="inline" intent=":literal"><semantics><mo stretchy="false">↓</mo><annotation encoding="application/x-tex">\downarrow</annotation></semantics></math></th>
<th id="S3.T1.2.1.2.7" class="ltx_td ltx_align_center ltx_th ltx_th_column ltx_border_t" style="padding:0.25pt 5.0pt;">Acc<math id="S3.T1.m7" class="ltx_Math" alttext="\uparrow" display="inline" intent=":literal"><semantics><mo stretchy="false">↑</mo><annotation encoding="application/x-tex">\uparrow</annotation></semantics></math></th>
<th id="S3.T1.2.1.2.8" class="ltx_td ltx_align_center ltx_th ltx_th_column ltx_border_r ltx_border_t" style="padding:0.25pt 5.0pt;">IR<math id="S3.T1.m8" class="ltx_Math" alttext="\downarrow" display="inline" intent=":literal"><semantics><mo stretchy="false">↓</mo><annotation encoding="application/x-tex">\downarrow</annotation></semantics></math></th>
<th id="S3.T1.2.1.2.9" class="ltx_td ltx_align_center ltx_th ltx_th_column ltx_border_t" style="padding:0.25pt 5.0pt;">Acc<math id="S3.T1.m9" class="ltx_Math" alttext="\uparrow" display="inline" intent=":literal"><semantics><mo stretchy="false">↑</mo><annotation encoding="application/x-tex">\uparrow</annotation></semantics></math></th>
<th id="S3.T1.2.1.2.10" class="ltx_td ltx_align_center ltx_th ltx_th_column ltx_border_t" style="padding:0.25pt 5.0pt;">IR<math id="S3.T1.m10" class="ltx_Math" alttext="\downarrow" display="inline" intent=":literal"><semantics><mo stretchy="false">↓</mo><annotation encoding="application/x-tex">\downarrow</annotation></semantics></math></th></tr>
</thead>
<tbody class="ltx_tbody">
<tr id="S3.T1.2.1.3" class="ltx_tr">
<th id="S3.T1.2.1.3.1" class="ltx_td ltx_align_left ltx_th ltx_th_row ltx_border_r ltx_border_t" style="padding:0.25pt 5.0pt;" rowspan="2"><span id="S3.T1.2.1.3.1.1" class="ltx_text">Qwen2-VL-2B</span></th>
<th id="S3.T1.2.1.3.2" class="ltx_td ltx_align_left ltx_th ltx_th_row ltx_border_r ltx_border_t" style="padding:0.25pt 5.0pt;">Baseline</th>
<td id="S3.T1.2.1.3.3" class="ltx_td ltx_align_center ltx_border_t" style="padding:0.25pt 5.0pt;">68.12</td>
