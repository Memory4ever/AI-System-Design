</figure></div><div class="ltx_flex_cell ltx_flex_size_3">
<figure id="A6.F6.sf5" class="ltx_figure ltx_figure_panel ltx_align_center"><object type="image/svg+xml" data="2606.13795v1/run1_mean_reward.svg" id="A6.F6.sf5.g1" class="ltx_graphics ltx_centering ltx_img_landscape" style="aspect-ratio:476/376;" width="476" height="376"></object>
<figcaption class="ltx_caption ltx_centering"><span class="ltx_tag ltx_tag_figure">(e) </span><em id="A6.F6.sf5.3" class="ltx_emph ltx_font_italic">run_1_subject_2</em></figcaption>
