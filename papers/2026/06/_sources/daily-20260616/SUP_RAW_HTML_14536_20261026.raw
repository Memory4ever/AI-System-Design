<span id="A7.T11.2.1.5.1.1.1" class="ltx_inline-block ltx_transformed_outer" style="width:6.1pt;height:15.8pt;vertical-align:-0.0pt;"><span class="ltx_transformed_inner" style="width:15.8pt;transform:translate(-4.8pt,-4.8pt) rotate(-90deg) ;">
<span id="A7.T11.2.1.5.1.1.1.1" class="ltx_p"><span id="A7.T11.2.1.5.1.1.1.1.1" class="ltx_text ltx_font_typewriter">Con</span></span>
