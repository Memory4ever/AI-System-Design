<td id="A5.T7.2.1.2.2" class="ltx_td ltx_align_center ltx_border_t"><math id="A5.T7.m9" class="ltx_Math" alttext="\delta" display="inline" intent=":literal"><semantics><mi>δ</mi><annotation encoding="application/x-tex">\delta</annotation></semantics></math>-mean</td>
