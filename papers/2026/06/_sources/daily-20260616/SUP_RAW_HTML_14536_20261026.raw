<td id="A7.T12.8.1.5.1" class="ltx_td ltx_align_left ltx_border_bb ltx_border_t"><span id="A7.T12.8.1.5.1.1" class="ltx_text ltx_font_bold" style="--ltx-fg-color:#003B67;">PS2<sub id="A7.T12.8.1.5.1.1.1" class="ltx_sub"><span id="A7.T12.8.1.5.1.1.1.1" class="ltx_text ltx_font_italic">SA</span></sub></span></td>
