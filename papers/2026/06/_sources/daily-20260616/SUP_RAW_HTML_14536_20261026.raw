</figure>
<figure id="A6.T9" class="ltx_table">
<figcaption class="ltx_caption ltx_centering"><span class="ltx_tag ltx_tag_table">Table 9: </span>PS2-RL Phase II (PS2 policy) hyperparameters.</figcaption>
<table id="A6.T9.2" class="ltx_tabular ltx_centering ltx_align_middle">
<tr id="A6.T9.2.1" class="ltx_tr">
