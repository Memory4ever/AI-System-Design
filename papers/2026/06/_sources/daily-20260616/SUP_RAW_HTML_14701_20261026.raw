<th id="S4.T5.2.1.3" class="ltx_td ltx_align_center ltx_th ltx_th_column" style="padding:0.45pt 3.0pt;" colspan="5"><span id="S4.T5.2.1.3.1" class="ltx_text" style="font-size:80%;">ARI <math id="S4.T5.m2" class="ltx_Math" alttext="\uparrow" display="inline" intent=":literal"><semantics><mo stretchy="false">↑</mo><annotation encoding="application/x-tex">\uparrow</annotation></semantics></math></span></th></tr>
