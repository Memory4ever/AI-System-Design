<td id="A3.T10.3.2.5" class="ltx_td ltx_align_center ltx_border_t">82.10</td>
<td id="A3.T10.3.2.6" class="ltx_td ltx_align_center ltx_border_t">82.72</td>
<td id="A3.T10.3.2.7" class="ltx_td ltx_align_center ltx_border_t">82.83</td></tr>
