<th id="S4.T1.3.1.1.2" class="ltx_td ltx_align_center ltx_th ltx_th_column ltx_border_r ltx_border_t" style="padding-top:0.5pt;padding-bottom:0.5pt;"><math id="S4.T1.m1" class="ltx_Math" alttext="-\mathbb{E}_{q_{\phi}}[\log p_{\mathrm{tar}}]" display="inline" intent=":literal"><semantics><mrow><mo>−</mo><mrow><msub><mi>𝔼</mi><msub><mi>q</mi><mi>ϕ</mi></msub></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">[</mo><mrow><mi>log</mi><mo lspace="0.167em">⁡</mo><msub><mi>p</mi><mi>tar</mi></msub></mrow><mo stretchy="false">]</mo></mrow></mrow></mrow><annotation encoding="application/x-tex">-\mathbb{E}_{q_{\phi}}[\log p_{\mathrm{tar}}]</annotation></semantics></math></th>
