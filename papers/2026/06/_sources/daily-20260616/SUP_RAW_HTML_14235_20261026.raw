<td id="S4.T5.3.1.17.2.1.3.1" class="ltx_td ltx_align_left" style="padding:0.5pt 4.0pt;"><math id="S4.T5.m26" class="ltx_Math" alttext="78.01" display="inline" intent=":literal"><semantics><mn>78.01</mn><annotation encoding="application/x-tex">78.01</annotation></semantics></math></td></tr>
<tr id="S4.T5.3.1.17.2.1.4" class="ltx_tr">
<td id="S4.T5.3.1.17.2.1.4.1" class="ltx_td ltx_align_left" style="padding:0.5pt 4.0pt;"><math id="S4.T5.m27" class="ltx_Math" alttext="{\textbf{{\color[rgb]{1,0,0}76.93}}}^{\star}" display="inline" intent=":literal"><semantics><msup><mtext style="--ltx-fg-color:#FF0000;" class="ltx_mathvariant_bold" mathcolor="#FF0000">76.93</mtext><mo>⋆</mo></msup><annotation encoding="application/x-tex">{\textbf{{\color[rgb]{1,0,0}76.93}}}^{\star}</annotation></semantics></math></td></tr>
