<td id="A3.T11.3.5.2" class="ltx_td ltx_align_center ltx_border_bb"><span id="A3.T11.3.5.2.1" class="ltx_text ltx_font_bold">6.2992 / 3.1451</span></td>
<td id="A3.T11.3.5.3" class="ltx_td ltx_align_center ltx_border_bb"><span id="A3.T11.3.5.3.1" class="ltx_text ltx_font_bold">6.7390 / 3.2773</span></td></tr>
