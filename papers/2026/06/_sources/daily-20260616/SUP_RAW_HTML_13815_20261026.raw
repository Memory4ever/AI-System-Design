<td id="S3.T1.9.9.1" class="ltx_td ltx_align_left" style="padding:-0.2pt 3.0pt;"><math id="S3.T1.m12" class="ltx_Math" alttext="M_{8}" display="inline" intent=":literal"><semantics><msub><mi mathsize="0.800em">M</mi><mn mathsize="0.800em">8</mn></msub><annotation encoding="application/x-tex">M_{8}</annotation></semantics></math></td>
