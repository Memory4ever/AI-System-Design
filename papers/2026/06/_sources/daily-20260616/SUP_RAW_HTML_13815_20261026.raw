<td id="A4.SS1.p4.1.4.8" class="ltx_td ltx_align_right"><span id="A4.SS1.p4.1.4.8.1" class="ltx_text" style="font-size:90%;">0.55</span></td></tr>
<tr id="A4.SS1.p4.1.5" class="ltx_tr">
<th id="A4.SS1.p4.1.5.1" class="ltx_td ltx_align_left ltx_th ltx_th_row"><span id="A4.SS1.p4.1.5.1.1" class="ltx_text" style="font-size:90%;">4bet</span></th>
