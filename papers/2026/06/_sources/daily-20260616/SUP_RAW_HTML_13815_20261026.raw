</div>
<div id="lstnumberx135" class="ltx_listingline"><span id="lstnumberx135.1" class="ltx_text" style="font-size:90%;">-</span><span id="lstnumberx135.2" class="ltx_text ltx_lst_space" style="font-size:90%;"> </span><span id="lstnumberx135.3" class="ltx_text ltx_lst_identifier" style="font-size:90%;">Range</span><span id="lstnumberx135.4" class="ltx_text ltx_lst_space" style="font-size:90%;"> </span><span id="lstnumberx135.5" class="ltx_text ltx_lst_identifier" style="font-size:90%;">tendencies</span><span id="lstnumberx135.6" class="ltx_text" style="font-size:90%;">,</span><span id="lstnumberx135.7" class="ltx_text ltx_lst_space" style="font-size:90%;"> </span><span id="lstnumberx135.8" class="ltx_text ltx_lst_identifier" style="font-size:90%;">multi</span><span id="lstnumberx135.9" class="ltx_text" style="font-size:90%;">-</span><span id="lstnumberx135.10" class="ltx_text ltx_lst_identifier" style="font-size:90%;">street</span><span id="lstnumberx135.11" class="ltx_text ltx_lst_space" style="font-size:90%;"> </span><span id="lstnumberx135.12" class="ltx_text ltx_lst_identifier" style="font-size:90%;">patterns</span>
