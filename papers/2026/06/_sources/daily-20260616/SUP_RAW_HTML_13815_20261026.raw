<td id="A8.T9.5.10.2" class="ltx_td ltx_align_left ltx_border_bb"><span id="A8.T9.5.10.2.1" class="ltx_text" style="font-size:90%;">Grok</span></td>
<td id="A8.T9.5.10.3" class="ltx_td ltx_align_left ltx_border_bb"><span id="A8.T9.5.10.3.1" class="ltx_text" style="font-size:90%;">fold</span></td>
