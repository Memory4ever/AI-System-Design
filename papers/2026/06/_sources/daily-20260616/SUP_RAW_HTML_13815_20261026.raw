<td id="A7.T5.7.1.2" class="ltx_td ltx_align_right ltx_border_tt" style="padding:-0.4pt 3.0pt;"><span id="A7.T5.7.1.2.1" class="ltx_text" style="font-size:70%;">Claude</span></td>
<td id="A7.T5.7.1.3" class="ltx_td ltx_align_right ltx_border_tt" style="padding:-0.4pt 3.0pt;"><span id="A7.T5.7.1.3.1" class="ltx_text" style="font-size:70%;">GPT</span></td>
<td id="A7.T5.7.1.4" class="ltx_td ltx_align_right ltx_border_tt" style="padding:-0.4pt 3.0pt;"><span id="A7.T5.7.1.4.1" class="ltx_text" style="font-size:70%;">Gemini</span></td>
<td id="A7.T5.7.1.5" class="ltx_td ltx_align_right ltx_border_tt" style="padding:-0.4pt 3.0pt;"><span id="A7.T5.7.1.5.1" class="ltx_text" style="font-size:70%;">Grok</span></td>
<td id="A7.T5.7.1.6" class="ltx_td ltx_align_right ltx_border_tt" style="padding:-0.4pt 3.0pt;"><span id="A7.T5.7.1.6.1" class="ltx_text" style="font-size:70%;">DeepSeek</span></td>
<td id="A7.T5.7.1.7" class="ltx_td ltx_align_right ltx_border_tt" style="padding:-0.4pt 3.0pt;"><span id="A7.T5.7.1.7.1" class="ltx_text" style="font-size:70%;">Qwen</span></td>
<td id="A7.T5.7.1.8" class="ltx_td ltx_align_right ltx_border_tt" style="padding:-0.4pt 3.0pt;"><span id="A7.T5.7.1.8.1" class="ltx_text" style="font-size:70%;">Kimi</span></td></tr>
<tr id="A7.T5.7.2" class="ltx_tr">
<th id="A7.T5.7.2.1" class="ltx_td ltx_align_right ltx_th ltx_th_row ltx_border_r ltx_border_t" style="padding:-0.4pt 3.0pt;"><span id="A7.T5.7.2.1.1" class="ltx_text" style="font-size:70%;">1</span></th>
