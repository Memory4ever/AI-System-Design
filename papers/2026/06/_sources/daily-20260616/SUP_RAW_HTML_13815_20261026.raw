</div>
<div id="lstnumberx3" class="ltx_listingline"><span id="lstnumberx3.1" class="ltx_text ltx_lst_identifier" style="font-size:90%;">HAND</span><span id="lstnumberx3.2" class="ltx_text ltx_lst_space" style="font-size:90%;"> </span><span id="lstnumberx3.3" class="ltx_text ltx_lst_identifier" style="font-size:90%;">STATE</span><span id="lstnumberx3.4" class="ltx_text ltx_lst_space" style="font-size:90%;"> </span><span id="lstnumberx3.5" class="ltx_text ltx_lst_identifier" style="font-size:90%;">AT</span><span id="lstnumberx3.6" class="ltx_text ltx_lst_space" style="font-size:90%;"> </span><span id="lstnumberx3.7" class="ltx_text ltx_lst_identifier" style="font-size:90%;">MOMENT</span><span id="lstnumberx3.8" class="ltx_text ltx_lst_space" style="font-size:90%;"> </span><span id="lstnumberx3.9" class="ltx_text ltx_lst_identifier" style="font-size:90%;">OF</span><span id="lstnumberx3.10" class="ltx_text ltx_lst_space" style="font-size:90%;"> </span><span id="lstnumberx3.11" class="ltx_text ltx_lst_identifier" style="font-size:90%;">ACTION</span><span id="lstnumberx3.12" class="ltx_text" style="font-size:90%;">:</span>
