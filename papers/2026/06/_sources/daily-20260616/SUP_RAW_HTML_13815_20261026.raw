<td id="A7.SS4.p3.1.7.3" class="ltx_td ltx_align_right"><math id="A7.SS4.m12" class="ltx_Math" alttext="+2{,}701" display="inline" intent=":literal"><semantics><mrow><mo>+</mo><mn>2,701</mn></mrow><annotation encoding="application/x-tex">+2{,}701</annotation></semantics></math></td></tr>
