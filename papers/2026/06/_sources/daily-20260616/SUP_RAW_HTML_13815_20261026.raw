<th id="A7.SS4.p3.1.1.2" class="ltx_td ltx_align_right ltx_th ltx_th_column ltx_border_tt">Lower</th>
<th id="A7.SS4.p3.1.1.3" class="ltx_td ltx_align_right ltx_th ltx_th_column ltx_border_tt">Upper</th></tr>
</thead>
<tbody class="ltx_tbody">
