<figure id="S6.F5.sf4" class="ltx_figure ltx_figure_panel ltx_align_center"><img src="2606.14693v1/figures/momaland/escort/mr.png" id="S6.F5.sf4.g1" class="ltx_graphics ltx_centering ltx_img_landscape" style="aspect-ratio:476/304;" width="476" height="304" alt="Refer to caption">
<figcaption class="ltx_caption ltx_centering"><span class="ltx_tag ltx_tag_figure"><span id="S6.F5.sf4.3" class="ltx_text" style="font-size:90%;">(d)</span> </span><span id="S6.F5.sf4.4" class="ltx_text" style="font-size:90%;">Escort</span></figcaption>
</figure></div><div class="ltx_flex_break"></div><div class="ltx_flex_cell ltx_flex_size_4">
<figure id="S6.F5.sf5" class="ltx_figure ltx_figure_panel ltx_align_center"><img src="2606.14693v1/figures/momaland/walker/forward_distance.png" id="S6.F5.sf5.g1" class="ltx_graphics ltx_centering ltx_img_landscape" style="aspect-ratio:476/302;" width="476" height="302" alt="Refer to caption">
