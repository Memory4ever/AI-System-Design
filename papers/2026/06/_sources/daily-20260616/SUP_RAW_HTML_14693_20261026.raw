<td id="A2.T4.5.8.2" class="ltx_td ltx_align_left"><math id="A2.T4.m8" class="ltx_Math" alttext="4" display="inline" intent=":literal"><semantics><mn>4</mn><annotation encoding="application/x-tex">4</annotation></semantics></math></td></tr>
<tr id="A2.T4.5.9" class="ltx_tr">
<th id="A2.T4.5.9.1" class="ltx_td ltx_align_left ltx_th ltx_th_row">Minibatches per update</th>
<td id="A2.T4.5.9.2" class="ltx_td ltx_align_left"><math id="A2.T4.m9" class="ltx_Math" alttext="4" display="inline" intent=":literal"><semantics><mn>4</mn><annotation encoding="application/x-tex">4</annotation></semantics></math></td></tr>
<tr id="A2.T4.5.10" class="ltx_tr">
<th id="A2.T4.5.10.1" class="ltx_td ltx_align_left ltx_th ltx_th_row">PPO clipping coefficient <math id="A2.T4.m10" class="ltx_Math" alttext="\epsilon" display="inline" intent=":literal"><semantics><mi>ϵ</mi><annotation encoding="application/x-tex">\epsilon</annotation></semantics></math></th>
<td id="A2.T4.5.10.2" class="ltx_td ltx_align_left"><math id="A2.T4.m11" class="ltx_Math" alttext="0.2" display="inline" intent=":literal"><semantics><mn>0.2</mn><annotation encoding="application/x-tex">0.2</annotation></semantics></math></td></tr>
<tr id="A2.T4.5.11" class="ltx_tr">
<th id="A2.T4.5.11.1" class="ltx_td ltx_align_left ltx_th ltx_th_row">Value loss coefficient</th>
<td id="A2.T4.5.11.2" class="ltx_td ltx_align_left"><math id="A2.T4.m12" class="ltx_Math" alttext="0.5" display="inline" intent=":literal"><semantics><mn>0.5</mn><annotation encoding="application/x-tex">0.5</annotation></semantics></math></td></tr>
<tr id="A2.T4.5.12" class="ltx_tr">
<th id="A2.T4.5.12.1" class="ltx_td ltx_align_left ltx_th ltx_th_row">Entropy coefficient</th>
<td id="A2.T4.5.12.2" class="ltx_td ltx_align_left"><math id="A2.T4.m13" class="ltx_Math" alttext="0.01" display="inline" intent=":literal"><semantics><mn>0.01</mn><annotation encoding="application/x-tex">0.01</annotation></semantics></math></td></tr>
<tr id="A2.T4.5.13" class="ltx_tr">
<th id="A2.T4.5.13.1" class="ltx_td ltx_align_left ltx_th ltx_th_row">Max gradient norm</th>
<td id="A2.T4.5.13.2" class="ltx_td ltx_align_left"><math id="A2.T4.m14" class="ltx_Math" alttext="0.5" display="inline" intent=":literal"><semantics><mn>0.5</mn><annotation encoding="application/x-tex">0.5</annotation></semantics></math></td></tr>
