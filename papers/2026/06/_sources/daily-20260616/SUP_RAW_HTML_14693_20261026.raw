<figcaption class="ltx_caption ltx_centering"><span class="ltx_tag ltx_tag_figure"><span id="S6.F5.sf8.3" class="ltx_text" style="font-size:90%;">(h)</span> </span><span id="S6.F5.sf8.4" class="ltx_text" style="font-size:90%;">SMAC 8m</span></figcaption>
