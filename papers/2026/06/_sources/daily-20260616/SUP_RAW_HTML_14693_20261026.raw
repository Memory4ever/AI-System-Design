<td id="A2.T4.5.7.2" class="ltx_td ltx_align_left"><math id="A2.T4.m7" class="ltx_Math" alttext="256" display="inline" intent=":literal"><semantics><mn>256</mn><annotation encoding="application/x-tex">256</annotation></semantics></math></td></tr>
<tr id="A2.T4.5.8" class="ltx_tr">
