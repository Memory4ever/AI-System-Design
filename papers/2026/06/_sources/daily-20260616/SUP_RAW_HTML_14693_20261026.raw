                   Sample action

<table id="A2.Ex51" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="A2.Ex51.m1" class="ltx_math_unparsed" alttext="a_{i,t}\sim\pi_{\theta}(\cdot\mid o_{i,t},\mathbf{p}_{i,t})" display="block" intent=":literal"><semantics><mrow><msub><mi>a</mi><mrow><mi>i</mi><mo>,</mo><mi>t</mi></mrow></msub><mo>∼</mo><msub><mi>π</mi><mi>θ</mi></msub><mrow><mo stretchy="false">(</mo><mo lspace="0em" rspace="0em">⋅</mo><mo lspace="0em" rspace="0.167em">∣</mo><msub><mi>o</mi><mrow><mi>i</mi><mo>,</mo><mi>t</mi></mrow></msub><mo>,</mo><msub><mi>𝐩</mi><mrow><mi>i</mi><mo>,</mo><mi>t</mi></mrow></msub><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">a_{i,t}\sim\pi_{\theta}(\cdot\mid o_{i,t},\mathbf{p}_{i,t})</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
</div>
<div id="alg2.l9" class="ltx_listingline">
                <span class="ltx_tag ltx_tag_listingline"><span id="alg2.l9.1" class="ltx_text" style="font-size:80%;">9:</span></span>
                
                
                 <span id="alg2.l9.3" class="ltx_text ltx_font_bold">end</span> <span id="alg2.l9.4" class="ltx_text ltx_font_bold">for</span>
</div>
<div id="alg2.l10" class="ltx_listingline">
                <span class="ltx_tag ltx_tag_listingline"><span id="alg2.l10.1" class="ltx_text" style="font-size:80%;">10:</span></span>
                
                
                 Execute joint action
<math id="alg2.l10.m1" class="ltx_Math" alttext="\mathbf{a}_{t}=(a_{1,t},\ldots,a_{N,t})" display="inline" intent=":literal"><semantics><mrow><msub><mi>𝐚</mi><mi>t</mi></msub><mo>=</mo><mrow><mo stretchy="false">(</mo><msub><mi>a</mi><mrow><mn>1</mn><mo>,</mo><mi>t</mi></mrow></msub><mo>,</mo><mi mathvariant="normal">…</mi><mo>,</mo><msub><mi>a</mi><mrow><mi>N</mi><mo>,</mo><mi>t</mi></mrow></msub><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">\mathbf{a}_{t}=(a_{1,t},\ldots,a_{N,t})</annotation></semantics></math>

</div>
<div id="alg2.l11" class="ltx_listingline">
                <span class="ltx_tag ltx_tag_listingline"><span id="alg2.l11.1" class="ltx_text" style="font-size:80%;">11:</span></span>
                
                
                 Store

<table id="A2.Ex52" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="A2.Ex52.m1" class="ltx_Math" alttext="(\mathbf{o}_{t},\bar{\mathbf{p}},\{\mathbf{p}_{i,t}\}_{i=1}^{N},\mathbf{a}_{t},\log\pi_{\theta_{\mathrm{old}}},\mathbf{r}_{t}^{\mathrm{team}},\{\mathbf{r}_{i,t}^{\mathrm{ind}}\}_{i=1}^{N},\mathbf{o}_{t+1})" display="block" intent=":literal"><semantics><mrow><mo stretchy="false">(</mo><msub><mi>𝐨</mi><mi>t</mi></msub><mo>,</mo><mover accent="true"><mi>𝐩</mi><mo>¯</mo></mover><mo>,</mo><msubsup><mrow><mo stretchy="false">{</mo><msub><mi>𝐩</mi><mrow><mi>i</mi><mo>,</mo><mi>t</mi></mrow></msub><mo stretchy="false">}</mo></mrow><mrow><mi>i</mi><mo>=</mo><mn>1</mn></mrow><mi>N</mi></msubsup><mo>,</mo><msub><mi>𝐚</mi><mi>t</mi></msub><mo>,</mo><mrow><mi>log</mi><mo lspace="0.167em">⁡</mo><msub><mi>π</mi><msub><mi>θ</mi><mi>old</mi></msub></msub></mrow><mo>,</mo><msubsup><mi>𝐫</mi><mi>t</mi><mi>team</mi></msubsup><mo>,</mo><msubsup><mrow><mo stretchy="false">{</mo><msubsup><mi>𝐫</mi><mrow><mi>i</mi><mo>,</mo><mi>t</mi></mrow><mi>ind</mi></msubsup><mo stretchy="false">}</mo></mrow><mrow><mi>i</mi><mo>=</mo><mn>1</mn></mrow><mi>N</mi></msubsup><mo>,</mo><msub><mi>𝐨</mi><mrow><mi>t</mi><mo>+</mo><mn>1</mn></mrow></msub><mo stretchy="false">)</mo></mrow><annotation encoding="application/x-tex">(\mathbf{o}_{t},\bar{\mathbf{p}},\{\mathbf{p}_{i,t}\}_{i=1}^{N},\mathbf{a}_{t},\log\pi_{\theta_{\mathrm{old}}},\mathbf{r}_{t}^{\mathrm{team}},\{\mathbf{r}_{i,t}^{\mathrm{ind}}\}_{i=1}^{N},\mathbf{o}_{t+1})</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
</div>
<div id="alg2.l12" class="ltx_listingline">
                <span class="ltx_tag ltx_tag_listingline"><span id="alg2.l12.1" class="ltx_text" style="font-size:80%;">12:</span></span>
                
                
                <span id="alg2.l12.3" class="ltx_text ltx_font_bold">end</span> <span id="alg2.l12.4" class="ltx_text ltx_font_bold">for</span>
</div>
<div id="alg2.l13" class="ltx_listingline">
                <span class="ltx_tag ltx_tag_listingline"><span id="alg2.l13.1" class="ltx_text" style="font-size:80%;">13:</span></span>
                
                
                Estimate team vector returns
<math id="alg2.l13.m1" class="ltx_Math" alttext="\hat{\mathbf{R}}^{\mathrm{team}}" display="inline" intent=":literal"><semantics><msup><mover accent="true"><mi>𝐑</mi><mo>^</mo></mover><mi>team</mi></msup><annotation encoding="application/x-tex">\hat{\mathbf{R}}^{\mathrm{team}}</annotation></semantics></math> and team advantages
<math id="alg2.l13.m2" class="ltx_Math" alttext="\mathbf{A}^{\mathrm{team}}" display="inline" intent=":literal"><semantics><msup><mi>𝐀</mi><mi>team</mi></msup><annotation encoding="application/x-tex">\mathbf{A}^{\mathrm{team}}</annotation></semantics></math> with GAE

</div>
<div id="alg2.l14" class="ltx_listingline">
                <span class="ltx_tag ltx_tag_listingline"><span id="alg2.l14.1" class="ltx_text" style="font-size:80%;">14:</span></span>
                
                
                Estimate individual vector returns
<math id="alg2.l14.m1" class="ltx_Math" alttext="\hat{\mathbf{R}}_{i}^{\mathrm{ind}}" display="inline" intent=":literal"><semantics><msubsup><mover accent="true"><mi>𝐑</mi><mo>^</mo></mover><mi>i</mi><mi>ind</mi></msubsup><annotation encoding="application/x-tex">\hat{\mathbf{R}}_{i}^{\mathrm{ind}}</annotation></semantics></math> and advantages
<math id="alg2.l14.m2" class="ltx_Math" alttext="\mathbf{A}_{i}^{\mathrm{ind}}" display="inline" intent=":literal"><semantics><msubsup><mi>𝐀</mi><mi>i</mi><mi>ind</mi></msubsup><annotation encoding="application/x-tex">\mathbf{A}_{i}^{\mathrm{ind}}</annotation></semantics></math> with GAE

</div>
<div id="alg2.l15" class="ltx_listingline">
                <span class="ltx_tag ltx_tag_listingline"><span id="alg2.l15.1" class="ltx_text" style="font-size:80%;">15:</span></span>
                
                
                Scalarize the team advantage:

<table id="A2.Ex53" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="A2.Ex53.m1" class="ltx_Math" alttext="A^{\mathrm{team}}=\bar{\mathbf{p}}^{\top}\mathbf{A}^{\mathrm{team}}" display="block" intent=":literal"><semantics><mrow><msup><mi>A</mi><mi>team</mi></msup><mo>=</mo><mrow><msup><mover accent="true"><mi>𝐩</mi><mo>¯</mo></mover><mo>⊤</mo></msup><mo lspace="0em" rspace="0em">​</mo><msup><mi>𝐀</mi><mi>team</mi></msup></mrow></mrow><annotation encoding="application/x-tex">A^{\mathrm{team}}=\bar{\mathbf{p}}^{\top}\mathbf{A}^{\mathrm{team}}</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
</div>
<div id="alg2.l16" class="ltx_listingline">
                <span class="ltx_tag ltx_tag_listingline"><span id="alg2.l16.1" class="ltx_text" style="font-size:80%;">16:</span></span>
                
                
                Compute each agent’s individual utility advantage:

<table id="A2.Ex54" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="A2.Ex54.m1" class="ltx_Math" alttext="A_{U_{i}}=\mathbf{p}_{i}^{\top}\mathbf{A}_{i}^{\mathrm{ind}}" display="block" intent=":literal"><semantics><mrow><msub><mi>A</mi><msub><mi>U</mi><mi>i</mi></msub></msub><mo>=</mo><mrow><msubsup><mi>𝐩</mi><mi>i</mi><mo>⊤</mo></msubsup><mo lspace="0em" rspace="0em">​</mo><msubsup><mi>𝐀</mi><mi>i</mi><mi>ind</mi></msubsup></mrow></mrow><annotation encoding="application/x-tex">A_{U_{i}}=\mathbf{p}_{i}^{\top}\mathbf{A}_{i}^{\mathrm{ind}}</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
</div>
<div id="alg2.l17" class="ltx_listingline">
                <span class="ltx_tag ltx_tag_listingline"><span id="alg2.l17.1" class="ltx_text" style="font-size:80%;">17:</span></span>
                
                
                Form the actor advantage:

<table id="A2.Ex55" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="A2.Ex55.m1" class="ltx_Math" alttext="A_{i}=A^{\mathrm{team}}+\lambda_{\mathrm{ind}}A_{U_{i}}" display="block" intent=":literal"><semantics><mrow><msub><mi>A</mi><mi>i</mi></msub><mo>=</mo><mrow><msup><mi>A</mi><mi>team</mi></msup><mo>+</mo><mrow><msub><mi>λ</mi><mi>ind</mi></msub><mo lspace="0em" rspace="0em">​</mo><msub><mi>A</mi><msub><mi>U</mi><mi>i</mi></msub></msub></mrow></mrow></mrow><annotation encoding="application/x-tex">A_{i}=A^{\mathrm{team}}+\lambda_{\mathrm{ind}}A_{U_{i}}</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
</div>
<div id="alg2.l18" class="ltx_listingline">
                <span class="ltx_tag ltx_tag_listingline"><span id="alg2.l18.1" class="ltx_text" style="font-size:80%;">18:</span></span>
                
                
                <span id="alg2.l18.3" class="ltx_text ltx_font_bold">for</span> PPO epoch <math id="alg2.l18.m1" class="ltx_Math" alttext="=1,\ldots,K" display="inline" intent=":literal"><semantics><mrow><mrow><mphantom></mphantom><mo>=</mo><mn>1</mn></mrow><mo>,</mo><mi mathvariant="normal">…</mi><mo>,</mo><mi>K</mi></mrow><annotation encoding="application/x-tex">=1,\ldots,K</annotation></semantics></math> <span id="alg2.l18.4" class="ltx_text ltx_font_bold">do</span>

</div>
<div id="alg2.l19" class="ltx_listingline">
                <span class="ltx_tag ltx_tag_listingline"><span id="alg2.l19.1" class="ltx_text" style="font-size:80%;">19:</span></span>
                
                
                 <span id="alg2.l19.3" class="ltx_text ltx_font_bold">for</span> minibatch <math id="alg2.l19.m1" class="ltx_Math" alttext="\mathcal{B}" display="inline" intent=":literal"><semantics><mi class="ltx_font_mathcaligraphic">ℬ</mi><annotation encoding="application/x-tex">\mathcal{B}</annotation></semantics></math> <span id="alg2.l19.4" class="ltx_text ltx_font_bold">do</span>

</div>
<div id="alg2.l20" class="ltx_listingline">
                <span class="ltx_tag ltx_tag_listingline"><span id="alg2.l20.1" class="ltx_text" style="font-size:80%;">20:</span></span>
                
                
                   Update critics by minimizing

<table id="A2.Ex56" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="A2.Ex56.m1" class="ltx_Math" alttext="\mathcal{L}_{\mathrm{critic}}=\mathcal{L}_{\mathrm{team}}+\mathcal{L}_{\mathrm{ind}}." display="block" intent=":literal"><semantics><mrow><mrow><msub><mi class="ltx_font_mathcaligraphic">ℒ</mi><mi>critic</mi></msub><mo>=</mo><mrow><msub><mi class="ltx_font_mathcaligraphic">ℒ</mi><mi>team</mi></msub><mo>+</mo><msub><mi class="ltx_font_mathcaligraphic">ℒ</mi><mi>ind</mi></msub></mrow></mrow><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">\mathcal{L}_{\mathrm{critic}}=\mathcal{L}_{\mathrm{team}}+\mathcal{L}_{\mathrm{ind}}.</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
</div>
<div id="alg2.l21" class="ltx_listingline">
                <span class="ltx_tag ltx_tag_listingline"><span id="alg2.l21.1" class="ltx_text" style="font-size:80%;">21:</span></span>
                
                
                   Compute PPO ratio

<table id="A2.Ex57" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="A2.Ex57.m1" class="ltx_Math" alttext="\rho_{i}=\frac{\pi_{\theta}(a_{i}\mid o_{i},\mathbf{p}_{i})}{\pi_{\theta_{\mathrm{old}}}(a_{i}\mid o_{i},\mathbf{p}_{i})}." display="block" intent=":literal"><semantics><mrow><mrow><msub><mi>ρ</mi><mi>i</mi></msub><mo>=</mo><mfrac><mrow><msub><mi>π</mi><mi>θ</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mi>a</mi><mi>i</mi></msub><mo fence="true" lspace="0em" rspace="0em">∣</mo><mrow><msub><mi>o</mi><mi>i</mi></msub><mo>,</mo><msub><mi>𝐩</mi><mi>i</mi></msub></mrow><mo stretchy="false">)</mo></mrow></mrow><mrow><msub><mi>π</mi><msub><mi>θ</mi><mi>old</mi></msub></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mi>a</mi><mi>i</mi></msub><mo fence="true" lspace="0em" rspace="0em">∣</mo><mrow><msub><mi>o</mi><mi>i</mi></msub><mo>,</mo><msub><mi>𝐩</mi><mi>i</mi></msub></mrow><mo stretchy="false">)</mo></mrow></mrow></mfrac></mrow><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">\rho_{i}=\frac{\pi_{\theta}(a_{i}\mid o_{i},\mathbf{p}_{i})}{\pi_{\theta_{\mathrm{old}}}(a_{i}\mid o_{i},\mathbf{p}_{i})}.</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
</div>
<div id="alg2.l22" class="ltx_listingline">
                <span class="ltx_tag ltx_tag_listingline"><span id="alg2.l22.1" class="ltx_text" style="font-size:80%;">22:</span></span>
                
                
                   Update actor with clipped PPO objective:

<table id="A2.Ex58" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="A2.Ex58.m1" class="ltx_Math" alttext="\mathcal{L}_{\mathrm{actor}}=-\mathbb{E}_{\mathcal{B}}\left[\min\left(\rho_{i}A_{i},\mathrm{clip}(\rho_{i},1-\epsilon,1+\epsilon)A_{i}\right)\right]-\beta_{\mathrm{ent}}\mathcal{H}(\pi_{\theta})." display="block" intent=":literal"><semantics><mrow><mrow><msub><mi class="ltx_font_mathcaligraphic">ℒ</mi><mi>actor</mi></msub><mo>=</mo><mrow><mrow><mo>−</mo><mrow><msub><mi>𝔼</mi><mi class="ltx_font_mathcaligraphic">ℬ</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo>[</mo><mrow><mi>min</mi><mo>⁡</mo><mrow><mo>(</mo><mrow><msub><mi>ρ</mi><mi>i</mi></msub><mo lspace="0em" rspace="0em">​</mo><msub><mi>A</mi><mi>i</mi></msub></mrow><mo>,</mo><mrow><mrow><mi>clip</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><msub><mi>ρ</mi><mi>i</mi></msub><mo>,</mo><mrow><mn>1</mn><mo>−</mo><mi>ϵ</mi></mrow><mo>,</mo><mrow><mn>1</mn><mo>+</mo><mi>ϵ</mi></mrow><mo stretchy="false">)</mo></mrow></mrow><mo lspace="0em" rspace="0em">​</mo><msub><mi>A</mi><mi>i</mi></msub></mrow><mo>)</mo></mrow></mrow><mo>]</mo></mrow></mrow></mrow><mo>−</mo><mrow><msub><mi>β</mi><mi>ent</mi></msub><mo lspace="0em" rspace="0em">​</mo><mi class="ltx_font_mathcaligraphic">ℋ</mi><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mi>π</mi><mi>θ</mi></msub><mo stretchy="false">)</mo></mrow></mrow></mrow></mrow><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">\mathcal{L}_{\mathrm{actor}}=-\mathbb{E}_{\mathcal{B}}\left[\min\left(\rho_{i}A_{i},\mathrm{clip}(\rho_{i},1-\epsilon,1+\epsilon)A_{i}\right)\right]-\beta_{\mathrm{ent}}\mathcal{H}(\pi_{\theta}).</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
</div>
<div id="alg2.l23" class="ltx_listingline">
                <span class="ltx_tag ltx_tag_listingline"><span id="alg2.l23.1" class="ltx_text" style="font-size:80%;">23:</span></span>
                
                
                   Compute preference diversity regularizer
<math id="alg2.l23.m1" class="ltx_Math" alttext="\mathcal{D}_{\alpha}(\{\mathbf{p}_{i}\}_{i=1}^{N})" display="inline" intent=":literal"><semantics><mrow><msub><mi class="ltx_font_mathcaligraphic">𝒟</mi><mi>α</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msubsup><mrow><mo stretchy="false">{</mo><msub><mi>𝐩</mi><mi>i</mi></msub><mo stretchy="false">}</mo></mrow><mrow><mi>i</mi><mo>=</mo><mn>1</mn></mrow><mi>N</mi></msubsup><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">\mathcal{D}_{\alpha}(\{\mathbf{p}_{i}\}_{i=1}^{N})</annotation></semantics></math>

</div>
<div id="alg2.l24" class="ltx_listingline">
                <span class="ltx_tag ltx_tag_listingline"><span id="alg2.l24.1" class="ltx_text" style="font-size:80%;">24:</span></span>
                
                
                   Update planner with
<math id="alg2.l24.m1" class="ltx_Math" alttext="\mathcal{L}_{\mathrm{plan}}." display="inline" intent=":literal"><semantics><mrow><msub><mi class="ltx_font_mathcaligraphic">ℒ</mi><mi>plan</mi></msub><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">\mathcal{L}_{\mathrm{plan}}.</annotation></semantics></math>

</div>
<div id="alg2.l25" class="ltx_listingline">
                <span class="ltx_tag ltx_tag_listingline"><span id="alg2.l25.1" class="ltx_text" style="font-size:80%;">25:</span></span>
                
                
                 <span id="alg2.l25.3" class="ltx_text ltx_font_bold">end</span> <span id="alg2.l25.4" class="ltx_text ltx_font_bold">for</span>
</div>
<div id="alg2.l26" class="ltx_listingline">
                <span class="ltx_tag ltx_tag_listingline"><span id="alg2.l26.1" class="ltx_text" style="font-size:80%;">26:</span></span>
                
                
                <span id="alg2.l26.3" class="ltx_text ltx_font_bold">end</span> <span id="alg2.l26.4" class="ltx_text ltx_font_bold">for</span>
</div>
<div id="alg2.l27" class="ltx_listingline">
                <span class="ltx_tag ltx_tag_listingline"><span id="alg2.l27.1" class="ltx_text" style="font-size:80%;">27:</span></span>
                
                
              <span id="alg2.l27.3" class="ltx_text ltx_font_bold">end</span> <span id="alg2.l27.4" class="ltx_text ltx_font_bold">for</span>
</div>
</div>
</figure>
<figure id="A2.T4" class="ltx_table">
<figcaption class="ltx_caption ltx_centering"><span class="ltx_tag ltx_tag_table"><span id="A2.T4.3" class="ltx_text" style="font-size:90%;">Table 4</span>: </span><span id="A2.T4.4" class="ltx_text" style="font-size:90%;">Common training setup.</span></figcaption>
<table id="A2.T4.5" class="ltx_tabular ltx_centering ltx_guessed_headers ltx_align_middle">
<tbody class="ltx_tbody">
<tr id="A2.T4.5.1" class="ltx_tr">
<th id="A2.T4.5.1.1" class="ltx_td ltx_align_left ltx_th ltx_th_row ltx_border_tt">Hyperparameter</th>
<td id="A2.T4.5.1.2" class="ltx_td ltx_align_left ltx_border_tt">Value</td></tr>
<tr id="A2.T4.5.2" class="ltx_tr">
<th id="A2.T4.5.2.1" class="ltx_td ltx_align_left ltx_th ltx_th_row ltx_border_t">Optimizer</th>
<td id="A2.T4.5.2.2" class="ltx_td ltx_align_left ltx_border_t">Adam</td></tr>
<tr id="A2.T4.5.3" class="ltx_tr">
<th id="A2.T4.5.3.1" class="ltx_td ltx_align_left ltx_th ltx_th_row">Actor learning rate</th>
<td id="A2.T4.5.3.2" class="ltx_td ltx_align_left"><math id="A2.T4.m1" class="ltx_Math" alttext="3\times 10^{-4}" display="inline" intent=":literal"><semantics><mrow><mn>3</mn><mo lspace="0.222em" rspace="0.222em">×</mo><msup><mn>10</mn><mrow><mo>−</mo><mn>4</mn></mrow></msup></mrow><annotation encoding="application/x-tex">3\times 10^{-4}</annotation></semantics></math></td></tr>
<tr id="A2.T4.5.4" class="ltx_tr">
<th id="A2.T4.5.4.1" class="ltx_td ltx_align_left ltx_th ltx_th_row">Critic learning rate</th>
<td id="A2.T4.5.4.2" class="ltx_td ltx_align_left"><math id="A2.T4.m2" class="ltx_Math" alttext="3\times 10^{-4}" display="inline" intent=":literal"><semantics><mrow><mn>3</mn><mo lspace="0.222em" rspace="0.222em">×</mo><msup><mn>10</mn><mrow><mo>−</mo><mn>4</mn></mrow></msup></mrow><annotation encoding="application/x-tex">3\times 10^{-4}</annotation></semantics></math></td></tr>
<tr id="A2.T4.5.5" class="ltx_tr">
<th id="A2.T4.5.5.1" class="ltx_td ltx_align_left ltx_th ltx_th_row">Discount factor <math id="A2.T4.m3" class="ltx_Math" alttext="\gamma" display="inline" intent=":literal"><semantics><mi>γ</mi><annotation encoding="application/x-tex">\gamma</annotation></semantics></math></th>
