<td id="S5.T1.3.4.4" class="ltx_td ltx_align_center" style="padding-left:3.5pt;padding-right:3.5pt;"><span id="S5.T1.3.4.4.1" class="ltx_text" style="font-size:90%;">5.03</span></td>
<td id="S5.T1.3.4.5" class="ltx_td ltx_align_center" style="padding-left:3.5pt;padding-right:3.5pt;"><span id="S5.T1.3.4.5.1" class="ltx_text" style="font-size:90%;">4.73</span></td>
