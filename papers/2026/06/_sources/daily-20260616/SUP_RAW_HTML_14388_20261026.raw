<th id="A8.T7.5.1.2" class="ltx_td ltx_align_center ltx_th ltx_th_row ltx_border_r ltx_border_tt"><math id="A8.T7.m1" class="ltx_Math" alttext="n" display="inline" intent=":literal"><semantics><mi mathsize="0.900em">n</mi><annotation encoding="application/x-tex">n</annotation></semantics></math></th>
<td id="A8.T7.5.1.3" class="ltx_td ltx_align_center ltx_border_tt"><span id="A8.T7.5.1.3.1" class="ltx_text" style="font-size:90%;">Pearson <math id="A8.T7.m2" class="ltx_Math" alttext="r" display="inline" intent=":literal"><semantics><mi>r</mi><annotation encoding="application/x-tex">r</annotation></semantics></math></span></td>
<td id="A8.T7.5.1.4" class="ltx_td ltx_align_center ltx_border_r ltx_border_tt"><span id="A8.T7.5.1.4.1" class="ltx_text" style="font-size:90%;">95% CI</span></td>
<td id="A8.T7.5.1.5" class="ltx_td ltx_align_center ltx_border_tt"><span id="A8.T7.5.1.5.1" class="ltx_text" style="font-size:90%;">Spearman <math id="A8.T7.m3" class="ltx_Math" alttext="\rho" display="inline" intent=":literal"><semantics><mi>ρ</mi><annotation encoding="application/x-tex">\rho</annotation></semantics></math></span></td>
<td id="A8.T7.5.1.6" class="ltx_td ltx_align_center ltx_border_tt"><span id="A8.T7.5.1.6.1" class="ltx_text" style="font-size:90%;">95% CI</span></td></tr>
<tr id="A8.T7.5.2" class="ltx_tr">
<th id="A8.T7.5.2.1" class="ltx_td ltx_align_left ltx_th ltx_th_row ltx_border_r ltx_border_t"><span id="A8.T7.5.2.1.1" class="ltx_text" style="font-size:90%;">Llama-3-8B</span></th>
