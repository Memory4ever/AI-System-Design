<figcaption class="ltx_caption ltx_centering"><span class="ltx_tag ltx_tag_figure"><span id="A9.F19.sf2.3" class="ltx_text" style="font-size:90%;">(b)</span> </span><span id="A9.F19.sf2.4" class="ltx_text" style="font-size:90%;">Llama-3-8B-Instruct</span></figcaption>
