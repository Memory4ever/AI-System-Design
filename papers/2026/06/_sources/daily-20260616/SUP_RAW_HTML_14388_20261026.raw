<td id="A5.T3.3.1.3" class="ltx_td ltx_align_center ltx_border_tt" style="padding-left:4.0pt;padding-right:4.0pt;" colspan="4"><span id="A5.T3.3.1.3.1" class="ltx_text" style="font-size:90%;">Pearson <math id="A5.T3.m1" class="ltx_Math" alttext="r" display="inline" intent=":literal"><semantics><mi>r</mi><annotation encoding="application/x-tex">r</annotation></semantics></math> (overlap, <math id="A5.T3.m2" class="ltx_Math" alttext="|\Delta M|" display="inline" intent=":literal"><semantics><mrow><mo stretchy="false">|</mo><mrow><mi mathvariant="normal">Δ</mi><mo lspace="0em" rspace="0em">​</mo><mi>M</mi></mrow><mo stretchy="false">|</mo></mrow><annotation encoding="application/x-tex">|\Delta M|</annotation></semantics></math>)</span></td></tr>
<tr id="A5.T3.3.2" class="ltx_tr">
<th id="A5.T3.3.2.1" class="ltx_td ltx_align_left ltx_th ltx_th_row ltx_border_r" style="padding-left:4.0pt;padding-right:4.0pt;"><math id="A5.T3.m3" class="ltx_Math" alttext="k_{dec}" display="inline" intent=":literal"><semantics><msub><mi mathsize="0.900em">k</mi><mrow><mi mathsize="0.900em">d</mi><mo lspace="0em" rspace="0em">​</mo><mi mathsize="0.900em">e</mi><mo lspace="0em" rspace="0em">​</mo><mi mathsize="0.900em">c</mi></mrow></msub><annotation encoding="application/x-tex">k_{dec}</annotation></semantics></math></th>
<td id="A5.T3.3.2.2" class="ltx_td ltx_align_center" style="padding-left:4.0pt;padding-right:4.0pt;"><math id="A5.T3.m4" class="ltx_Math" alttext="1" display="inline" intent=":literal"><semantics><mn mathsize="0.900em">1</mn><annotation encoding="application/x-tex">1</annotation></semantics></math></td>
<td id="A5.T3.3.2.3" class="ltx_td ltx_align_center" style="padding-left:4.0pt;padding-right:4.0pt;"><math id="A5.T3.m5" class="ltx_Math" alttext="2" display="inline" intent=":literal"><semantics><mn mathsize="0.900em">2</mn><annotation encoding="application/x-tex">2</annotation></semantics></math></td>
<td id="A5.T3.3.2.4" class="ltx_td ltx_align_center" style="padding-left:4.0pt;padding-right:4.0pt;"><math id="A5.T3.m6" class="ltx_Math" alttext="3" display="inline" intent=":literal"><semantics><mn mathsize="0.900em">3</mn><annotation encoding="application/x-tex">3</annotation></semantics></math></td>
<td id="A5.T3.3.2.5" class="ltx_td ltx_align_center ltx_border_r" style="padding-left:4.0pt;padding-right:4.0pt;"><math id="A5.T3.m7" class="ltx_Math" alttext="4" display="inline" intent=":literal"><semantics><mn mathsize="0.900em">4</mn><annotation encoding="application/x-tex">4</annotation></semantics></math></td>
<td id="A5.T3.3.2.6" class="ltx_td ltx_align_center" style="padding-left:4.0pt;padding-right:4.0pt;"><math id="A5.T3.m8" class="ltx_Math" alttext="1" display="inline" intent=":literal"><semantics><mn mathsize="0.900em">1</mn><annotation encoding="application/x-tex">1</annotation></semantics></math></td>
