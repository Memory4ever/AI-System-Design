</span></span><span id="S5.T2.2.1.4.3" class="ltx_text"></span></th></tr>
<tr id="S5.T2.2.2" class="ltx_tr">
<td id="S5.T2.2.2.1" class="ltx_td ltx_align_left ltx_border_t">Ours (ego-path)</td>
<td id="S5.T2.2.2.2" class="ltx_td ltx_align_center ltx_border_t"><math id="S5.T2.m4" class="ltx_Math" alttext="5.027\pm 0.871" display="inline" intent=":literal"><semantics><mrow><mn>5.027</mn><mo>±</mo><mn>0.871</mn></mrow><annotation encoding="application/x-tex">5.027\pm 0.871</annotation></semantics></math></td>
<td id="S5.T2.2.2.3" class="ltx_td ltx_align_center ltx_border_t"><math id="S5.T2.m5" class="ltx_Math" alttext="0.590\pm 0.082" display="inline" intent=":literal"><semantics><mrow><mn>0.590</mn><mo>±</mo><mn>0.082</mn></mrow><annotation encoding="application/x-tex">0.590\pm 0.082</annotation></semantics></math></td>
<td id="S5.T2.2.2.4" class="ltx_td ltx_align_center ltx_border_t"><math id="S5.T2.m6" class="ltx_Math" alttext="0.710\pm 0.317" display="inline" intent=":literal"><semantics><mrow><mn>0.710</mn><mo>±</mo><mn>0.317</mn></mrow><annotation encoding="application/x-tex">0.710\pm 0.317</annotation></semantics></math></td></tr>
<tr id="S5.T2.2.3" class="ltx_tr">
<td id="S5.T2.2.3.1" class="ltx_td ltx_align_left">Ours (delta-path)</td>
<td id="S5.T2.2.3.2" class="ltx_td ltx_align_center"><math id="S5.T2.m7" class="ltx_Math" alttext="4.724\pm 0.431" display="inline" intent=":literal"><semantics><mrow><mn>4.724</mn><mo>±</mo><mn>0.431</mn></mrow><annotation encoding="application/x-tex">4.724\pm 0.431</annotation></semantics></math></td>
<td id="S5.T2.2.3.3" class="ltx_td ltx_align_center"><math id="S5.T2.m8" class="ltx_Math" alttext="0.288\pm 0.105" display="inline" intent=":literal"><semantics><mrow><mn>0.288</mn><mo>±</mo><mn>0.105</mn></mrow><annotation encoding="application/x-tex">0.288\pm 0.105</annotation></semantics></math></td>
<td id="S5.T2.2.3.4" class="ltx_td ltx_align_center"><math id="S5.T2.m9" class="ltx_Math" alttext="1.959\pm 0.472" display="inline" intent=":literal"><semantics><mrow><mn>1.959</mn><mo>±</mo><mn>0.472</mn></mrow><annotation encoding="application/x-tex">1.959\pm 0.472</annotation></semantics></math></td></tr>
<tr id="S5.T2.2.4" class="ltx_tr">
<td id="S5.T2.2.4.1" class="ltx_td ltx_align_left ltx_border_t"><span id="S5.T2.2.4.1.1" class="ltx_text"></span><span id="S5.T2.2.4.1.2" class="ltx_text">
<span id="S5.T2.2.4.1.2.1" class="ltx_tabular ltx_align_middle">
<span id="S5.T2.2.4.1.2.1.1" class="ltx_tr">
<span id="S5.T2.2.4.1.2.1.1.1" class="ltx_td ltx_nopad_r ltx_align_left">Ours (ego-path)</span></span>
<span id="S5.T2.2.4.1.2.1.2" class="ltx_tr">
<span id="S5.T2.2.4.1.2.1.2.1" class="ltx_td ltx_nopad_r ltx_align_left">w/o Reliability</span></span>
</span></span><span id="S5.T2.2.4.1.3" class="ltx_text"></span></td>
<td id="S5.T2.2.4.2" class="ltx_td ltx_align_center ltx_border_t"><math id="S5.T2.m10" class="ltx_Math" alttext="5.180\pm 0.917" display="inline" intent=":literal"><semantics><mrow><mn>5.180</mn><mo>±</mo><mn>0.917</mn></mrow><annotation encoding="application/x-tex">5.180\pm 0.917</annotation></semantics></math></td>
<td id="S5.T2.2.4.3" class="ltx_td ltx_align_center ltx_border_t"><math id="S5.T2.m11" class="ltx_Math" alttext="0.564\pm 0.079" display="inline" intent=":literal"><semantics><mrow><mn>0.564</mn><mo>±</mo><mn>0.079</mn></mrow><annotation encoding="application/x-tex">0.564\pm 0.079</annotation></semantics></math></td>
<td id="S5.T2.2.4.4" class="ltx_td ltx_align_center ltx_border_t"><math id="S5.T2.m12" class="ltx_Math" alttext="0.523\pm 0.245" display="inline" intent=":literal"><semantics><mrow><mn>0.523</mn><mo>±</mo><mn>0.245</mn></mrow><annotation encoding="application/x-tex">0.523\pm 0.245</annotation></semantics></math></td></tr>
<tr id="S5.T2.2.5" class="ltx_tr">
<td id="S5.T2.2.5.1" class="ltx_td ltx_align_left"><span id="S5.T2.2.5.1.1" class="ltx_text"></span><span id="S5.T2.2.5.1.2" class="ltx_text">
<span id="S5.T2.2.5.1.2.1" class="ltx_tabular ltx_align_middle">
<span id="S5.T2.2.5.1.2.1.1" class="ltx_tr">
<span id="S5.T2.2.5.1.2.1.1.1" class="ltx_td ltx_nopad_r ltx_align_left">Ours (delta-path)</span></span>
