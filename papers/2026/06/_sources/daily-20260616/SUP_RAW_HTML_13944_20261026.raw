<td id="A1.T11.7.2.2" class="ltx_td ltx_align_center ltx_border_r ltx_border_t" style="padding-left:10.0pt;padding-right:10.0pt;"><span id="A1.T11.7.2.2.1" class="ltx_text" style="font-size:80%;">9985</span></td>
