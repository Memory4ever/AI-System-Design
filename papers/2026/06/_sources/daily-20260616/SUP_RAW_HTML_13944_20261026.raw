<td id="A1.T48.7.7.4" class="ltx_td ltx_align_right ltx_border_r" style="padding-top:0.45pt;padding-bottom:0.45pt;"><math id="A1.T48.m27" class="ltx_Math" alttext="+0.33" display="inline" intent=":literal"><semantics><mrow><mo mathsize="0.800em">+</mo><mn mathsize="0.800em">0.33</mn></mrow><annotation encoding="application/x-tex">+0.33</annotation></semantics></math></td>
<td id="A1.T48.7.7.5" class="ltx_td ltx_align_right" style="padding-top:0.45pt;padding-bottom:0.45pt;"><math id="A1.T48.m28" class="ltx_Math" alttext="7.50" display="inline" intent=":literal"><semantics><mn mathsize="0.800em">7.50</mn><annotation encoding="application/x-tex">7.50</annotation></semantics></math></td>
<td id="A1.T48.7.7.6" class="ltx_td ltx_align_right" style="padding-top:0.45pt;padding-bottom:0.45pt;"><math id="A1.T48.m29" class="ltx_Math" alttext="7.50" display="inline" intent=":literal"><semantics><mn mathsize="0.800em">7.50</mn><annotation encoding="application/x-tex">7.50</annotation></semantics></math></td>
