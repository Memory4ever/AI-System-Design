<td id="A1.T48.7.6.6" class="ltx_td ltx_align_right" style="padding-top:0.45pt;padding-bottom:0.45pt;"><math id="A1.T48.m23" class="ltx_Math" alttext="7.37" display="inline" intent=":literal"><semantics><mn mathsize="0.800em">7.37</mn><annotation encoding="application/x-tex">7.37</annotation></semantics></math></td>
<td id="A1.T48.7.6.7" class="ltx_td ltx_align_right" style="padding-top:0.45pt;padding-bottom:0.45pt;"><math id="A1.T48.m24" class="ltx_Math" alttext="-0.13" display="inline" intent=":literal"><semantics><mrow><mo mathsize="0.800em">−</mo><mn mathsize="0.800em">0.13</mn></mrow><annotation encoding="application/x-tex">-0.13</annotation></semantics></math></td></tr>
<tr id="A1.T48.7.7" class="ltx_tr">
<td id="A1.T48.7.7.1" class="ltx_td ltx_align_left ltx_border_r" style="padding-top:0.45pt;padding-bottom:0.45pt;"><span id="A1.T48.7.7.1.1" class="ltx_text" style="font-size:80%;">vlog</span></td>
<td id="A1.T48.7.7.2" class="ltx_td ltx_align_right" style="padding-top:0.45pt;padding-bottom:0.45pt;"><math id="A1.T48.m25" class="ltx_Math" alttext="0.67" display="inline" intent=":literal"><semantics><mn mathsize="0.800em">0.67</mn><annotation encoding="application/x-tex">0.67</annotation></semantics></math></td>
