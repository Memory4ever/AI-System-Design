<tr id="A1.T49.5.4" class="ltx_tr">
<td id="A1.T49.5.4.1" class="ltx_td ltx_align_left ltx_border_r"><span id="A1.T49.5.4.1.1" class="ltx_text" style="font-size:90%;">cool_people (subj)</span></td>
<td id="A1.T49.5.4.2" class="ltx_td ltx_align_center"><span id="A1.T49.5.4.2.1" class="ltx_text" style="font-size:90%;">7/10</span></td>
<td id="A1.T49.5.4.3" class="ltx_td ltx_align_center"><span id="A1.T49.5.4.3.1" class="ltx_text" style="font-size:90%;">7/10</span></td></tr>
<tr id="A1.T49.5.5" class="ltx_tr">
<td id="A1.T49.5.5.1" class="ltx_td ltx_align_left ltx_border_r"><span id="A1.T49.5.5.1.1" class="ltx_text" style="font-size:90%;">interesting_culture (subj)</span></td>
<td id="A1.T49.5.5.2" class="ltx_td ltx_align_center"><span id="A1.T49.5.5.2.1" class="ltx_text" style="font-size:90%;">2/10</span></td>
<td id="A1.T49.5.5.3" class="ltx_td ltx_align_center"><span id="A1.T49.5.5.3.1" class="ltx_text ltx_font_bold" style="font-size:90%;">5/10</span></td></tr>
<tr id="A1.T49.5.6" class="ltx_tr">
<td id="A1.T49.5.6.1" class="ltx_td ltx_align_left ltx_border_r ltx_border_t"><span id="A1.T49.5.6.1.1" class="ltx_text" style="font-size:90%;">democratic (obj)</span></td>
<td id="A1.T49.5.6.2" class="ltx_td ltx_align_center ltx_border_t"><span id="A1.T49.5.6.2.1" class="ltx_text" style="font-size:90%;">3/10</span></td>
<td id="A1.T49.5.6.3" class="ltx_td ltx_align_center ltx_border_t"><span id="A1.T49.5.6.3.1" class="ltx_text ltx_font_bold" style="font-size:90%;">5/10</span></td></tr>
