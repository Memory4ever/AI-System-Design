</figure></div><div class="ltx_flex_cell ltx_flex_size_2">
<figure id="S5.T4.fig2" class="ltx_figure ltx_figure_panel ltx_minipage ltx_align_center ltx_align_top" style="width:138.0pt;">
<figcaption class="ltx_caption"><span class="ltx_tag ltx_tag_figure"><span id="S5.T4.fig2.1" class="ltx_text" style="font-size:90%;">Table 4</span>: </span><span id="S5.T4.fig2.2" class="ltx_text" style="font-size:90%;">Per-model BH-FDR-significant rank disagreement (<math id="S5.T4.m6" class="ltx_Math" alttext="N{=}1000" display="inline" intent=":literal"><semantics><mrow><mi>N</mi><mo>=</mo><mn>1000</mn></mrow><annotation encoding="application/x-tex">N{=}1000</annotation></semantics></math>, <math id="S5.T4.m7" class="ltx_Math" alttext="\alpha{=}0.05" display="inline" intent=":literal"><semantics><mrow><mi>α</mi><mo>=</mo><mn>0.05</mn></mrow><annotation encoding="application/x-tex">\alpha{=}0.05</annotation></semantics></math>).</span></figcaption>
<table id="S5.T4.fig2.3" class="ltx_tabular ltx_centering ltx_align_middle">
<tr id="S5.T4.fig2.3.1" class="ltx_tr">
