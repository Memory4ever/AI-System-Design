<td id="S5.T7.5.2.2" class="ltx_td ltx_nopad_l ltx_nopad_r ltx_align_center ltx_border_r ltx_border_t" style="--ltx-bg-color:#F2CFA8;padding:0.65pt 1.9pt;"><span id="S5.T7.5.2.2.1" class="ltx_text" style="font-size:80%;--ltx-bg-color:#F2CFA8;">3.0 <span id="S5.T7.5.2.2.1.1" class="ltx_text" style="font-size:63%;">(24%)</span></span></td>
<td id="S5.T7.5.2.3" class="ltx_td ltx_nopad_l ltx_nopad_r ltx_align_center ltx_border_r ltx_border_t" style="--ltx-bg-color:#E9A185;padding:0.65pt 1.9pt;"><span id="S5.T7.5.2.3.1" class="ltx_text ltx_font_bold" style="font-size:80%;--ltx-bg-color:#E9A185;">3.9<span id="S5.T7.5.2.3.1.1" class="ltx_text ltx_font_medium"> <span id="S5.T7.5.2.3.1.1.1" class="ltx_text" style="font-size:63%;">(37%)</span></span></span></td>
