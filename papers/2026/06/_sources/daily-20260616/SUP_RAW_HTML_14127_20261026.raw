<section id="A4" class="ltx_appendix">
<h2 class="ltx_title ltx_title_appendix"><span class="ltx_tag ltx_tag_appendix">Appendix D </span>Algorithm: Semi-Online MPO Reward Finetuning</h2>

<figure id="alg1" class="ltx_float ltx_float_algorithm ltx_framed ltx_framed_top">
<figcaption class="ltx_caption"><span class="ltx_tag ltx_tag_float"><span id="alg1.3" class="ltx_text ltx_font_bold">Algorithm 1</span> </span> Semi-Online MPO Reward Finetuning</figcaption>
<div id="alg1.4" class="ltx_listing ltx_framed ltx_framed_topbottom ltx_listing">
<div id="alg1.l1" class="ltx_listingline">
            <span class="ltx_tag ltx_tag_listingline"><span id="alg1.l1.1" class="ltx_text" style="font-size:80%;">1:</span></span>
            
            
          Initial policy <math id="alg1.l1.m1" class="ltx_Math" alttext="\pi_{\theta_{0}}" display="inline" intent=":literal"><semantics><msub><mi>π</mi><msub><mi>θ</mi><mn>0</mn></msub></msub><annotation encoding="application/x-tex">\pi_{\theta_{0}}</annotation></semantics></math>, training set <math id="alg1.l1.m2" class="ltx_Math" alttext="\mathcal{T}" display="inline" intent=":literal"><semantics><mi class="ltx_font_mathcaligraphic">𝒯</mi><annotation encoding="application/x-tex">\mathcal{T}</annotation></semantics></math>, reward <math id="alg1.l1.m3" class="ltx_Math" alttext="r" display="inline" intent=":literal"><semantics><mi>r</mi><annotation encoding="application/x-tex">r</annotation></semantics></math>, phase count <math id="alg1.l1.m4" class="ltx_Math" alttext="P" display="inline" intent=":literal"><semantics><mi>P</mi><annotation encoding="application/x-tex">P</annotation></semantics></math>

</div>
<div id="alg1.l2" class="ltx_listingline">
            <span class="ltx_tag ltx_tag_listingline"><span id="alg1.l2.1" class="ltx_text" style="font-size:80%;">2:</span></span>
            
            
          <span id="alg1.l2.3" class="ltx_text ltx_font_bold">for</span> <math id="alg1.l2.m1" class="ltx_Math" alttext="p=1,\dots,P" display="inline" intent=":literal"><semantics><mrow><mrow><mi>p</mi><mo>=</mo><mn>1</mn></mrow><mo>,</mo><mi mathvariant="normal">…</mi><mo>,</mo><mi>P</mi></mrow><annotation encoding="application/x-tex">p=1,\dots,P</annotation></semantics></math> <span id="alg1.l2.4" class="ltx_text ltx_font_bold">do</span>

</div>
<div id="alg1.l3" class="ltx_listingline">
            <span class="ltx_tag ltx_tag_listingline"><span id="alg1.l3.1" class="ltx_text" style="font-size:80%;">3:</span></span>
            
            
            <math id="alg1.l3.m1" class="ltx_Math" alttext="\mathcal{R}_{p}\leftarrow\emptyset" display="inline" intent=":literal"><semantics><mrow><msub><mi class="ltx_font_mathcaligraphic">ℛ</mi><mi>p</mi></msub><mo stretchy="false">←</mo><mi mathvariant="normal">∅</mi></mrow><annotation encoding="application/x-tex">\mathcal{R}_{p}\leftarrow\emptyset</annotation></semantics></math>

</div>
<div id="alg1.l4" class="ltx_listingline">
            <span class="ltx_tag ltx_tag_listingline"><span id="alg1.l4.1" class="ltx_text" style="font-size:80%;">4:</span></span>
            
            
            <span id="alg1.l4.3" class="ltx_text ltx_font_bold">for</span> each <math id="alg1.l4.m1" class="ltx_Math" alttext="(q,d_{\text{last}},\mathcal{D}^{+},\mathcal{D}^{-})\in\mathcal{T}" display="inline" intent=":literal"><semantics><mrow><mrow><mo stretchy="false">(</mo><mi>q</mi><mo>,</mo><msub><mi>d</mi><mtext>last</mtext></msub><mo>,</mo><msup><mi class="ltx_font_mathcaligraphic">𝒟</mi><mo>+</mo></msup><mo>,</mo><msup><mi class="ltx_font_mathcaligraphic">𝒟</mi><mo>−</mo></msup><mo stretchy="false">)</mo></mrow><mo>∈</mo><mi class="ltx_font_mathcaligraphic">𝒯</mi></mrow><annotation encoding="application/x-tex">(q,d_{\text{last}},\mathcal{D}^{+},\mathcal{D}^{-})\in\mathcal{T}</annotation></semantics></math> <span id="alg1.l4.4" class="ltx_text ltx_font_bold">do</span>

</div>
<div id="alg1.l5" class="ltx_listingline">
            <span class="ltx_tag ltx_tag_listingline"><span id="alg1.l5.1" class="ltx_text" style="font-size:80%;">5:</span></span>
            
            
             Sample <math id="alg1.l5.m1" class="ltx_math_unparsed" alttext="\{\tilde{q}^{(1)},\dots,\tilde{q}^{(N)}\}\sim\pi_{\theta_{p-1}}(\cdot\mid q,d_{\text{last}})" display="inline" intent=":literal"><semantics><mrow><mrow><mo stretchy="false">{</mo><msup><mover accent="true"><mi>q</mi><mo>~</mo></mover><mrow><mo stretchy="false">(</mo><mn>1</mn><mo stretchy="false">)</mo></mrow></msup><mo>,</mo><mi mathvariant="normal">…</mi><mo>,</mo><msup><mover accent="true"><mi>q</mi><mo>~</mo></mover><mrow><mo stretchy="false">(</mo><mi>N</mi><mo stretchy="false">)</mo></mrow></msup><mo stretchy="false">}</mo></mrow><mo>∼</mo><msub><mi>π</mi><msub><mi>θ</mi><mrow><mi>p</mi><mo>−</mo><mn>1</mn></mrow></msub></msub><mrow><mo stretchy="false">(</mo><mo lspace="0em" rspace="0em">⋅</mo><mo lspace="0em" rspace="0.167em">∣</mo><mi>q</mi><mo>,</mo><msub><mi>d</mi><mtext>last</mtext></msub><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">\{\tilde{q}^{(1)},\dots,\tilde{q}^{(N)}\}\sim\pi_{\theta_{p-1}}(\cdot\mid q,d_{\text{last}})</annotation></semantics></math>

</div>
<div id="alg1.l6" class="ltx_listingline">
            <span class="ltx_tag ltx_tag_listingline"><span id="alg1.l6.1" class="ltx_text" style="font-size:80%;">6:</span></span>
            
            
