<th id="S5.T2.4.1.1" class="ltx_td ltx_align_left ltx_th ltx_th_column ltx_th_row ltx_border_tt"><span id="S5.T2.4.1.1.1" class="ltx_text" style="font-size:90%;">Method</span></th>
<th id="S5.T2.4.1.2" class="ltx_td ltx_align_center ltx_th ltx_th_column ltx_border_tt"><span id="S5.T2.4.1.2.1" class="ltx_text" style="font-size:90%;">Shared Part</span></th>
<th id="S5.T2.4.1.3" class="ltx_td ltx_align_center ltx_th ltx_th_column ltx_border_tt"><span id="S5.T2.4.1.3.1" class="ltx_text" style="font-size:90%;">Personalized Part</span></th></tr>
