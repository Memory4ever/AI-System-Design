<td id="S5.T2.4.2.3" class="ltx_td ltx_align_center ltx_border_t"><span id="S5.T2.4.2.3.1" class="ltx_text" style="font-size:90%;">Head</span></td></tr>
<tr id="S5.T2.4.3" class="ltx_tr">
<th id="S5.T2.4.3.1" class="ltx_td ltx_align_left ltx_th ltx_th_row"><span id="S5.T2.4.3.1.1" class="ltx_text" style="font-size:90%;">FedRep <cite class="ltx_cite ltx_citemacro_cite"><a href="#bib.bib4" title="" class="ltx_ref">Collins et al. (2021)</a></cite></span></th>
<td id="S5.T2.4.3.2" class="ltx_td ltx_align_center"><span id="S5.T2.4.3.2.1" class="ltx_text" style="font-size:90%;">Body</span></td>
<td id="S5.T2.4.3.3" class="ltx_td ltx_align_center"><span id="S5.T2.4.3.3.1" class="ltx_text" style="font-size:90%;">Head</span></td></tr>
