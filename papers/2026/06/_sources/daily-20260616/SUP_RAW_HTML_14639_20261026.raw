<td id="S5.T4.6.1.5.3" class="ltx_td ltx_align_center"><span id="S5.T4.6.1.5.3.1" class="ltx_text ltx_number ltx_underline">14.13</span></td></tr>
<tr id="S5.T4.6.1.6" class="ltx_tr">
