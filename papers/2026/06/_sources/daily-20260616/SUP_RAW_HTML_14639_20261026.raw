 13.64 -76.34 12.11 L -76.34 -115.72 C -76.34 -117.25 -75.1 -118.49 -73.57 -118.49 L 91.47 -118.49 C 93 -118.49 94.24 -117.25 94.24 -115.72 L 94.24 12.11 C 94.24 13.64 93 14.88 91.47 14.88 Z M -76.34 -118.49"></path></g><g style="--ltx-stroke-color:#000000;--ltx-fill-color:#000000;" fill="#000000" stroke="#000000" stroke-dasharray="3.0pt,3.0pt" stroke-dashoffset="0.0pt" stroke-width="0.9pt" transform="matrix(1.0 0.0 0.0 1.0 -71.62 -51.8)"><foreignObject style="--ltx-fo-width:11.65em;--ltx-fo-height:0em;--ltx-fo-depth:0em;font-size:10pt;" height="0" overflow="visible" transform="matrix(1 0 0 -1 0 0)" width="161.2"><span class="ltx_foreignobject_container"><span class="ltx_foreignobject_content">
<span id="S3.F2.sf2.pic1.2" class="ltx_inline-block ltx_minipage ltx_align_top" style="width:11.65em;">
<span id="S3.F2.sf2.pic1.2.1" class="ltx_p"></span>
</span></span></span></foreignObject></g><g style="--ltx-fill-color:#FFFFFF;" fill="#FFFFFF" stroke-width="0.7pt"><path d="M -51.56 -82.69 C -51.56 -80.41 -53.41 -78.57 -55.68 -78.57 C -57.96 -78.57 -59.8 -80.41 -59.8 -82.69 C -59.8 -84.96 -57.96 -86.81 -55.68 -86.81 C -53.41 -86.81 -51.56 -84.96 -51.56 -82.69 Z M -55.68 -82.69"></path></g><g style="--ltx-stroke-color:#000000;--ltx-fill-color:#000000;" fill="#000000" stroke="#000000" stroke-width="0.7pt" transform="matrix(0.5 0.0 0.0 0.5 -58.37 -84.42)"><foreignObject style="--ltx-fo-width:0.78em;--ltx-fo-height:0.58em;--ltx-fo-depth:0.08em;font-size:10pt;" height="9.22" overflow="visible" transform="matrix(1 0 0 -1 0 8.07)" width="10.76"><span class="ltx_foreignobject_container"><span class="ltx_foreignobject_content"><math id="S3.F2.sf2.pic1.m1" class="ltx_Math" alttext="\times" display="inline" intent=":literal"><semantics><mo>×</mo><annotation encoding="application/x-tex">\times</annotation></semantics></math></span></span></foreignObject></g><g style="--ltx-fill-color:#FFFFFF;" fill="#FFFFFF" stroke-width="0.7pt"><path d="M -15.75 -82.69 C -15.75 -80.41 -17.6 -78.57 -19.87 -78.57 C -22.15 -78.57 -23.99 -80.41 -23.99 -82.69 C -23.99 -84.96 -22.15 -86.81 -19.87 -86.81 C -17.6 -86.81 -15.75 -84.96 -15.75 -82.69 Z M -19.87 -82.69"></path></g><g style="--ltx-stroke-color:#000000;--ltx-fill-color:#000000;" fill="#000000" stroke="#000000" stroke-width="0.7pt" transform="matrix(0.5 0.0 0.0 0.5 -22.56 -84.42)"><foreignObject style="--ltx-fo-width:0.78em;--ltx-fo-height:0.58em;--ltx-fo-depth:0.08em;font-size:10pt;" height="9.22" overflow="visible" transform="matrix(1 0 0 -1 0 8.07)" width="10.76"><span class="ltx_foreignobject_container"><span class="ltx_foreignobject_content"><math id="S3.F2.sf2.pic1.m2" class="ltx_Math" alttext="\times" display="inline" intent=":literal"><semantics><mo>×</mo><annotation encoding="application/x-tex">\times</annotation></semantics></math></span></span></foreignObject></g><g style="--ltx-fill-color:#FFFFFF;" fill="#FFFFFF" stroke-width="0.7pt"><path d="M 32.73 -82.69 C 32.73 -80.41 30.89 -78.57 28.61 -78.57 C 26.34 -78.57 24.49 -80.41 24.49 -82.69 C 24.49 -84.96 26.34 -86.81 28.61 -86.81 C 30.89 -86.81 32.73 -84.96 32.73 -82.69 Z M 28.61 -82.69"></path></g><g style="--ltx-stroke-color:#000000;--ltx-fill-color:#000000;" fill="#000000" stroke="#000000" stroke-width="0.7pt" transform="matrix(0.5 0.0 0.0 0.5 25.92 -84.42)"><foreignObject style="--ltx-fo-width:0.78em;--ltx-fo-height:0.58em;--ltx-fo-depth:0.08em;font-size:10pt;" height="9.22" overflow="visible" transform="matrix(1 0 0 -1 0 8.07)" width="10.76"><span class="ltx_foreignobject_container"><span class="ltx_foreignobject_content"><math id="S3.F2.sf2.pic1.m3" class="ltx_Math" alttext="\times" display="inline" intent=":literal"><semantics><mo>×</mo><annotation encoding="application/x-tex">\times</annotation></semantics></math></span></span></foreignObject></g><g stroke-width="0.6pt"><path style="fill:none" d="M 0 25.9 L 0 15.64"></path><g stroke-dasharray="none" stroke-dashoffset="0.0pt" stroke-linejoin="miter" transform="matrix(0.0 -1.0 1.0 0.0 0 15.64)"><path d="M 3.93 0 C 3.45 0.13 1.33 0.84 0 1.61 L 0 -1.61 C 1.33 -0.84 3.45 -0.13 3.93 0 Z"></path></g></g><g stroke-width="0.6pt"><path style="fill:none" d="M 0 -10.15 L 0 -12.54"></path><g stroke-dasharray="none" stroke-dashoffset="0.0pt" stroke-linejoin="miter" transform="matrix(0.0 -1.0 1.0 0.0 0 -12.54)"><path d="M 3.93 0 C 3.45 0.13 1.33 0.84 0 1.61 L 0 -1.61 C 1.33 -0.84 3.45 -0.13 3.93 0 Z"></path></g></g><g stroke-width="0.6pt"><path style="fill:none" d="M -18.16 -38.34 L -38.01 -49.44"></path><g stroke-dasharray="none" stroke-dashoffset="0.0pt" stroke-linejoin="miter" transform="matrix(-0.87286 -0.48796 0.48796 -0.87286 -38.01 -49.44)"><path d="M 3.93 0 C 3.45 0.13 1.33 0.84 0 1.61 L 0 -1.61 C 1.33 -0.84 3.45 -0.13 3.93 0 Z"></path></g></g><g stroke-width="0.6pt"><path style="fill:none" d="M -6.48 -38.34 L -12.32 -47.49"></path><g stroke-dasharray="none" stroke-dashoffset="0.0pt" stroke-linejoin="miter" transform="matrix(-0.53812 -0.84286 0.84286 -0.53812 -12.32 -47.49)"><path d="M 3.93 0 C 3.45 0.13 1.33 0.84 0 1.61 L 0 -1.61 C 1.33 -0.84 3.45 -0.13 3.93 0 Z"></path></g></g><g stroke-width="0.6pt"><path style="fill:none" d="M 9.33 -38.34 L 18.28 -48.07"></path><g stroke-dasharray="none" stroke-dashoffset="0.0pt" stroke-linejoin="miter" transform="matrix(0.67673 -0.73624 0.73624 0.67673 18.28 -48.07)"><path d="M 3.93 0 C 3.45 0.13 1.33 0.84 0 1.61 L 0 -1.61 C 1.33 -0.84 3.45 -0.13 3.93 0 Z"></path></g></g><g stroke-width="0.6pt"><path style="fill:none" d="M -55.68 -66.52 L -55.68 -72.84"></path><g stroke-dasharray="none" stroke-dashoffset="0.0pt" stroke-linejoin="miter" transform="matrix(0.0 -1.0 1.0 0.0 -55.68 -72.84)"><path d="M 3.93 0 C 3.45 0.13 1.33 0.84 0 1.61 L 0 -1.61 C 1.33 -0.84 3.45 -0.13 3.93 0 Z"></path></g></g><g stroke-width="0.6pt"><path style="fill:none" d="M -19.87 -66.52 L -19.87 -72.84"></path><g stroke-dasharray="none" stroke-dashoffset="0.0pt" stroke-linejoin="miter" transform="matrix(0.0 -1.0 1.0 0.0 -19.87 -72.84)"><path d="M 3.93 0 C 3.45 0.13 1.33 0.84 0 1.61 L 0 -1.61 C 1.33 -0.84 3.45 -0.13 3.93 0 Z"></path></g></g><g stroke-width="0.6pt"><path style="fill:none" d="M 28.61 -66.52 L 28.61 -72.84"></path><g stroke-dasharray="none" stroke-dashoffset="0.0pt" stroke-linejoin="miter" transform="matrix(0.0 -1.0 1.0 0.0 28.61 -72.84)"><path d="M 3.93 0 C 3.45 0.13 1.33 0.84 0 1.61 L 0 -1.61 C 1.33 -0.84 3.45 -0.13 3.93 0 Z"></path></g></g><g stroke-width="0.6pt"><path style="fill:none" d="M -51.6 -84.22 L -32.16 -91.52"></path><g stroke-dasharray="none" stroke-dashoffset="0.0pt" stroke-linejoin="miter" transform="matrix(0.93616 -0.3516 0.3516 0.93616 -32.16 -91.52)"><path d="M 3.93 0 C 3.45 0.13 1.33 0.84 0 1.61 L 0 -1.61 C 1.33 -0.84 3.45 -0.13 3.93 0 Z"></path></g></g><g stroke-width="0.6pt"><path style="fill:none" d="M -16.87 -85.85 L -13.43 -89.47"></path><g stroke-dasharray="none" stroke-dashoffset="0.0pt" stroke-linejoin="miter" transform="matrix(0.68886 -0.7249 0.7249 0.68886 -13.43 -89.47)"><path d="M 3.93 0 C 3.45 0.13 1.33 0.84 0 1.61 L 0 -1.61 C 1.33 -0.84 3.45 -0.13 3.93 0 Z"></path></g></g><g stroke-width="0.6pt"><path style="fill:none" d="M 25.09 -85.26 L 18.32 -90.21"></path><g stroke-dasharray="none" stroke-dashoffset="0.0pt" stroke-linejoin="miter" transform="matrix(-0.80734 -0.59009 0.59009 -0.80734 18.32 -90.21)"><path d="M 3.93 0 C 3.45 0.13 1.33 0.84 0 1.61 L 0 -1.61 C 1.33 -0.84 3.45 -0.13 3.93 0 Z"></path></g></g><g stroke-width="0.6pt"><path style="fill:none" d="M 0 -113.76 L 0 -122.05"></path><g stroke-dasharray="none" stroke-dashoffset="0.0pt" stroke-linejoin="miter" transform="matrix(0.0 -1.0 1.0 0.0 0 -122.05)"><path d="M 3.93 0 C 3.45 0.13 1.33 0.84 0 1.61 L 0 -1.61 C 1.33 -0.84 3.45 -0.13 3.93 0 Z"></path></g></g><g stroke-width="0.6pt"><path style="fill:none" d="M 37.71 -28.18 L 62.34 -36.3"></path><g stroke-dasharray="none" stroke-dashoffset="0.0pt" stroke-linejoin="miter" transform="matrix(0.94968 -0.31325 0.31325 0.94968 62.34 -36.3)"><path d="M 3.93 0 C 3.45 0.13 1.33 0.84 0 1.61 L 0 -1.61 C 1.33 -0.84 3.45 -0.13 3.93 0 Z"></path></g></g></g></svg></span>
<figcaption class="ltx_caption ltx_centering"><span class="ltx_tag ltx_tag_figure"><span id="S3.F2.sf2.3" class="ltx_text" style="font-size:90%;">(b)</span> </span><span id="S3.F2.sf2.4" class="ltx_text" style="font-size:90%;">Mixture-of-Experts Transformer layer</span></figcaption>
</figure></div></div>
<figcaption class="ltx_caption ltx_centering"><span class="ltx_tag ltx_tag_figure"><span id="S3.F2.3" class="ltx_text" style="font-size:90%;">Figure 2</span>: </span><span id="S3.F2.4" class="ltx_text" style="font-size:90%;">Comparison between (a) a standard SSL model Transformer layer and (b) a Mixture-of-Experts Transformer layer. In (b), the feed-forward network (FFN) is replaced by <math id="S3.F2.m3" class="ltx_Math" alttext="N" display="inline" intent=":literal"><semantics><mi>N</mi><annotation encoding="application/x-tex">N</annotation></semantics></math> parallel FFNs, each considered as an expert; a gating module computes a routing distribution and selects the Top-<math id="S3.F2.m4" class="ltx_Math" alttext="K" display="inline" intent=":literal"><semantics><mi>K</mi><annotation encoding="application/x-tex">K</annotation></semantics></math> experts, whose outputs are combined through a weighted sum.</span></figcaption>
</figure>
</section>
<section id="S3.SS2" class="ltx_subsection">
<h3 class="ltx_title ltx_title_subsection"><span class="ltx_tag ltx_tag_subsection">3.2 </span>Gating network</h3>

<div id="S3.SS2.p1" class="ltx_para">
<p id="S3.SS2.p1.1" class="ltx_p">The gating network assigns routing probabilities to the <math id="S3.SS2.p1.m1" class="ltx_Math" alttext="E" display="inline" intent=":literal"><semantics><mi>E</mi><annotation encoding="application/x-tex">E</annotation></semantics></math> experts and selects the <math id="S3.SS2.p1.m2" class="ltx_Math" alttext="k" display="inline" intent=":literal"><semantics><mi>k</mi><annotation encoding="application/x-tex">k</annotation></semantics></math> most relevant ones according to a top-<math id="S3.SS2.p1.m3" class="ltx_Math" alttext="k" display="inline" intent=":literal"><semantics><mi>k</mi><annotation encoding="application/x-tex">k</annotation></semantics></math> routing strategy.
To compute these routing probabilities, the frame-level representations produced by the transformer layer must first be aggregated into an utterance-level embedding.</p>
</div>
<div id="S3.SS2.p2" class="ltx_para">
<p id="S3.SS2.p2.1" class="ltx_p">Let <math id="S3.SS2.p2.m1" class="ltx_Math" alttext="[\mathbf{h}_{1},\dots,\mathbf{h}_{T}]\in\mathbb{R}^{T\times F}" display="inline" intent=":literal"><semantics><mrow><mrow><mo stretchy="false">[</mo><mrow><msub><mi>𝐡</mi><mn>1</mn></msub><mo>,</mo><mi mathvariant="normal">…</mi><mo>,</mo><msub><mi>𝐡</mi><mi>T</mi></msub></mrow><mo stretchy="false">]</mo></mrow><mo>∈</mo><msup><mi>ℝ</mi><mrow><mi>T</mi><mo lspace="0.222em" rspace="0.222em">×</mo><mi>F</mi></mrow></msup></mrow><annotation encoding="application/x-tex">[\mathbf{h}_{1},\dots,\mathbf{h}_{T}]\in\mathbb{R}^{T\times F}</annotation></semantics></math> denote the sequence of frame-level representations after the MHA module at layer <math id="S3.SS2.p2.m2" class="ltx_Math" alttext="l" display="inline" intent=":literal"><semantics><mi>l</mi><annotation encoding="application/x-tex">l</annotation></semantics></math>.
An utterance-level representation <math id="S3.SS2.p2.m3" class="ltx_Math" alttext="\mathbf{g}" display="inline" intent=":literal"><semantics><mi>𝐠</mi><annotation encoding="application/x-tex">\mathbf{g}</annotation></semantics></math> is obtained by applying a pooling operation along the temporal dimension. We investigate several pooling strategies such as mean, max, statistical and attentive pooling.</p>
</div>
<div id="S3.SS2.p3" class="ltx_para">
<p id="S3.SS2.p3.1" class="ltx_p">Given the pooled representation <math id="S3.SS2.p3.m1" class="ltx_Math" alttext="\mathbf{g}" display="inline" intent=":literal"><semantics><mi>𝐠</mi><annotation encoding="application/x-tex">\mathbf{g}</annotation></semantics></math>, the gating network produces routing probabilities for each expert:</p>
<table id="S3.E3" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="S3.E3.m1" class="ltx_Math" alttext="\mathbf{p}=\operatorname{Softmax}(\mathbf{W}_{g}\mathbf{g})," display="block" intent=":literal"><semantics><mrow><mrow><mi>𝐩</mi><mo>=</mo><mrow><mi>Softmax</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mrow><msub><mi>𝐖</mi><mi>g</mi></msub><mo lspace="0em" rspace="0em">​</mo><mi>𝐠</mi></mrow><mo stretchy="false">)</mo></mrow></mrow></mrow><mo>,</mo></mrow><annotation encoding="application/x-tex">\mathbf{p}=\operatorname{Softmax}(\mathbf{W}_{g}\mathbf{g}),</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td>
<td rowspan="1" class="ltx_eqn_cell ltx_eqn_eqno ltx_align_middle ltx_align_right"><span class="ltx_tag ltx_tag_equation ltx_align_right">(3)</span></td></tr></tbody>
</table>
<p id="S3.SS2.p3.2" class="ltx_p">where <math id="S3.SS2.p3.m2" class="ltx_Math" alttext="\mathbf{p}\in\mathbb{R}^{E}" display="inline" intent=":literal"><semantics><mrow><mi>𝐩</mi><mo>∈</mo><msup><mi>ℝ</mi><mi>E</mi></msup></mrow><annotation encoding="application/x-tex">\mathbf{p}\in\mathbb{R}^{E}</annotation></semantics></math> denotes the probability of selecting each expert.
Following the top-<math id="S3.SS2.p3.m3" class="ltx_Math" alttext="k" display="inline" intent=":literal"><semantics><mi>k</mi><annotation encoding="application/x-tex">k</annotation></semantics></math> routing strategy, only the <math id="S3.SS2.p3.m4" class="ltx_Math" alttext="k" display="inline" intent=":literal"><semantics><mi>k</mi><annotation encoding="application/x-tex">k</annotation></semantics></math> experts with the highest probabilities are activated:</p>
<table id="S3.E4" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="S3.E4.m1" class="ltx_Math" alttext="\mathcal{K}=\operatorname{TopK}(\mathbf{p},k)." display="block" intent=":literal"><semantics><mrow><mrow><mi class="ltx_font_mathcaligraphic">𝒦</mi><mo>=</mo><mrow><mi>TopK</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>𝐩</mi><mo>,</mo><mi>k</mi><mo stretchy="false">)</mo></mrow></mrow></mrow><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">\mathcal{K}=\operatorname{TopK}(\mathbf{p},k).</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td>
<td rowspan="1" class="ltx_eqn_cell ltx_eqn_eqno ltx_align_middle ltx_align_right"><span class="ltx_tag ltx_tag_equation ltx_align_right">(4)</span></td></tr></tbody>
</table>
</div>
<div id="S3.SS2.p4" class="ltx_para ltx_noindent">
<p id="S3.SS2.p4.1" class="ltx_p">The corresponding probabilities are then re-normalized as</p>
<table id="S3.E5" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="S3.E5.m1" class="ltx_Math" alttext="\tilde{p}_{i}=\frac{p_{i}}{\sum_{j\in\mathcal{K}}p_{j}}." display="block" intent=":literal"><semantics><mrow><mrow><msub><mover accent="true"><mi>p</mi><mo>~</mo></mover><mi>i</mi></msub><mo>=</mo><mfrac><msub><mi>p</mi><mi>i</mi></msub><mrow><msub><mo>∑</mo><mrow><mi>j</mi><mo>∈</mo><mi class="ltx_font_mathcaligraphic">𝒦</mi></mrow></msub><msub><mi>p</mi><mi>j</mi></msub></mrow></mfrac></mrow><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">\tilde{p}_{i}=\frac{p_{i}}{\sum_{j\in\mathcal{K}}p_{j}}.</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td>
<td rowspan="1" class="ltx_eqn_cell ltx_eqn_eqno ltx_align_middle ltx_align_right"><span class="ltx_tag ltx_tag_equation ltx_align_right">(5)</span></td></tr></tbody>
</table>
<p id="S3.SS2.p4.2" class="ltx_p">and used as the combination weights of the selected experts.
The non-differentiable top-<math id="S3.SS2.p4.m1" class="ltx_Math" alttext="k" display="inline" intent=":literal"><semantics><mi>k</mi><annotation encoding="application/x-tex">k</annotation></semantics></math> selection does not prevent training as gradients still flow through the renormalized softmax weights back to the gating module.</p>
</div>
</section>
<section id="S3.SS3" class="ltx_subsection">
<h3 class="ltx_title ltx_title_subsection"><span class="ltx_tag ltx_tag_subsection">3.3 </span>Auxiliary loss</h3>

<div id="S3.SS3.p1" class="ltx_para">
<p id="S3.SS3.p1.1" class="ltx_p">To encourage a balanced utilization of experts and prevent expert collapse, we employ an auxiliary load-balancing loss following <cite class="ltx_cite ltx_citemacro_cite">[<a href="#bib.bib19" title="" class="ltx_ref">27</a>]</cite>.</p>
</div>
<div id="S3.SS3.p2" class="ltx_para">
<p id="S3.SS3.p2.1" class="ltx_p">Let <math id="S3.SS3.p2.m1" class="ltx_Math" alttext="E" display="inline" intent=":literal"><semantics><mi>E</mi><annotation encoding="application/x-tex">E</annotation></semantics></math> denote the number of experts.
We define <math id="S3.SS3.p2.m2" class="ltx_Math" alttext="p_{i}" display="inline" intent=":literal"><semantics><msub><mi>p</mi><mi>i</mi></msub><annotation encoding="application/x-tex">p_{i}</annotation></semantics></math> as the mean routing probability assigned to expert <math id="S3.SS3.p2.m3" class="ltx_Math" alttext="i" display="inline" intent=":literal"><semantics><mi>i</mi><annotation encoding="application/x-tex">i</annotation></semantics></math>,
and <math id="S3.SS3.p2.m4" class="ltx_Math" alttext="f_{i}" display="inline" intent=":literal"><semantics><msub><mi>f</mi><mi>i</mi></msub><annotation encoding="application/x-tex">f_{i}</annotation></semantics></math> as the fraction of utterances routed to expert <math id="S3.SS3.p2.m5" class="ltx_Math" alttext="i" display="inline" intent=":literal"><semantics><mi>i</mi><annotation encoding="application/x-tex">i</annotation></semantics></math>.</p>
</div>
<div id="S3.SS3.p3" class="ltx_para">
<p id="S3.SS3.p3.1" class="ltx_p">The auxiliary loss is defined as:</p>
<table id="S3.E6" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="S3.E6.m1" class="ltx_Math" alttext="\mathcal{L}_{aux}=E\sum_{i=1}^{E}p_{i}f_{i}." display="block" intent=":literal"><semantics><mrow><mrow><msub><mi class="ltx_font_mathcaligraphic">ℒ</mi><mrow><mi>a</mi><mo lspace="0em" rspace="0em">​</mo><mi>u</mi><mo lspace="0em" rspace="0em">​</mo><mi>x</mi></mrow></msub><mo>=</mo><mrow><mi>E</mi><mo lspace="0em" rspace="0em">​</mo><mrow><munderover><mo movablelimits="false">∑</mo><mrow><mi>i</mi><mo>=</mo><mn>1</mn></mrow><mi>E</mi></munderover><mrow><msub><mi>p</mi><mi>i</mi></msub><mo lspace="0em" rspace="0em">​</mo><msub><mi>f</mi><mi>i</mi></msub></mrow></mrow></mrow></mrow><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">\mathcal{L}_{aux}=E\sum_{i=1}^{E}p_{i}f_{i}.</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td>
<td rowspan="1" class="ltx_eqn_cell ltx_eqn_eqno ltx_align_middle ltx_align_right"><span class="ltx_tag ltx_tag_equation ltx_align_right">(6)</span></td></tr></tbody>
</table>
</div>
<div id="S3.SS3.p4" class="ltx_para ltx_noindent">
<p id="S3.SS3.p4.1" class="ltx_p">Let <math id="S3.SS3.p4.m1" class="ltx_Math" alttext="\mathcal{L}_{\text{BCE}}" display="inline" intent=":literal"><semantics><msub><mi class="ltx_font_mathcaligraphic">ℒ</mi><mtext>BCE</mtext></msub><annotation encoding="application/x-tex">\mathcal{L}_{\text{BCE}}</annotation></semantics></math> denote the binary cross-entropy classification loss. The final training objective is defined as</p>
<table id="S3.E7" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="S3.E7.m1" class="ltx_Math" alttext="\mathcal{L}_{\text{total}}=\mathcal{L}_{\text{BCE}}+\lambda\mathcal{L}_{aux}." display="block" intent=":literal"><semantics><mrow><mrow><msub><mi class="ltx_font_mathcaligraphic">ℒ</mi><mtext>total</mtext></msub><mo>=</mo><mrow><msub><mi class="ltx_font_mathcaligraphic">ℒ</mi><mtext>BCE</mtext></msub><mo>+</mo><mrow><mi>λ</mi><mo lspace="0em" rspace="0em">​</mo><msub><mi class="ltx_font_mathcaligraphic">ℒ</mi><mrow><mi>a</mi><mo lspace="0em" rspace="0em">​</mo><mi>u</mi><mo lspace="0em" rspace="0em">​</mo><mi>x</mi></mrow></msub></mrow></mrow></mrow><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">\mathcal{L}_{\text{total}}=\mathcal{L}_{\text{BCE}}+\lambda\mathcal{L}_{aux}.</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td>
<td rowspan="1" class="ltx_eqn_cell ltx_eqn_eqno ltx_align_middle ltx_align_right"><span class="ltx_tag ltx_tag_equation ltx_align_right">(7)</span></td></tr></tbody>
</table>
</div>
</section>
</section>
<section id="S4" class="ltx_section">
<h2 class="ltx_title ltx_title_section"><span class="ltx_tag ltx_tag_section">4 </span>Experimental setup</h2>

<div id="S4.p1" class="ltx_para">
<p id="S4.p1.1" class="ltx_p">This section describes the experimental protocol used to train and evaluate the proposed approach.</p>
</div>
<section id="S4.SS1" class="ltx_subsection">
<h3 class="ltx_title ltx_title_subsection"><span class="ltx_tag ltx_tag_subsection">4.1 </span>Datasets and metrics</h3>

<div id="S4.SS1.p1" class="ltx_para ltx_noindent">
<p id="S4.SS1.p1.1" class="ltx_p"><span id="S4.SS1.p1.1.1" class="ltx_text ltx_font_bold">Training datasets:</span> We train our model using the 6 spoofing corpora
ASVspoof5 <cite class="ltx_cite ltx_citemacro_cite">[<a href="#bib.bib39" title="" class="ltx_ref">28</a>]</cite>, ASVspoof2019 LA <cite class="ltx_cite ltx_citemacro_cite">[<a href="#bib.bib37" title="" class="ltx_ref">29</a>]</cite>, ADD22 <cite class="ltx_cite ltx_citemacro_cite">[<a href="#bib.bib32" title="" class="ltx_ref">30</a>]</cite>, FakeOrReal  <cite class="ltx_cite ltx_citemacro_cite">[<a href="#bib.bib31" title="" class="ltx_ref">31</a>]</cite>, Codecfake <cite class="ltx_cite ltx_citemacro_cite">[<a href="#bib.bib34" title="" class="ltx_ref">32</a>]</cite>, and MLADD <cite class="ltx_cite ltx_citemacro_cite">[<a href="#bib.bib35" title="" class="ltx_ref">33</a>]</cite>.
These datasets cover a wide range of spoofing conditions, synthesis methods, languages, and recording conditions, enabling the model to learn robust and generalizable representations. The distribution of spoof and bonafide samples in these corpora is reported below (Table <a href="#S4.T1" title="Table 1 ‣ 4.1 Datasets and metrics ‣ 4 Experimental setup ‣ From Self-Supervised Speech Models to Mixture-of-Experts for Robust Anti-Spoofing" class="ltx_ref"><span class="ltx_text ltx_ref_tag">1</span></a>).</p>
</div>
<figure id="S4.T1" class="ltx_table">
<figcaption class="ltx_caption ltx_centering"><span class="ltx_tag ltx_tag_table"><span id="S4.T1.3" class="ltx_text" style="font-size:90%;">Table 1</span>: </span><span id="S4.T1.4" class="ltx_text" style="font-size:90%;">Distribution of spoof and bonafide samples across the training corpora.</span></figcaption>
