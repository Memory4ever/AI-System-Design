<th id="S4.T1.2.1.2" class="ltx_td ltx_align_left ltx_th ltx_th_column ltx_border_tt"># cultures</th>
<th id="S4.T1.2.1.3" class="ltx_td ltx_align_left ltx_th ltx_th_column ltx_border_tt">Example cultural markers</th></tr>
</thead>
<tbody class="ltx_tbody">
