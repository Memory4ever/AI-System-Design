<td id="A3.T4.2.7.4" class="ltx_td ltx_align_center ltx_border_t">10.0</td></tr>
<tr id="A3.T4.2.8" class="ltx_tr">
<th id="A3.T4.2.8.1" class="ltx_td ltx_align_left ltx_th ltx_th_row">gpt-3-5-turbo</th>
