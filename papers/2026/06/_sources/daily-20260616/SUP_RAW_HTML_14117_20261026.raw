<td id="S3.T1.2.5.1" class="ltx_td ltx_align_left">Gemini 2.5 Pro</td>
<td id="S3.T1.2.5.2" class="ltx_td ltx_align_left">Gender–Science</td>
<td id="S3.T1.2.5.3" class="ltx_td ltx_align_left">0.002</td>
<td id="S3.T1.2.5.4" class="ltx_td ltx_align_left">[-0.002, 0.011]</td></tr>
