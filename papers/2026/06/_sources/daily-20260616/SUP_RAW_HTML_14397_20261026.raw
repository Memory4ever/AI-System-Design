<tr id="A1.T6.6.3" class="ltx_tr">
<td id="A1.T6.6.3.1" class="ltx_td ltx_align_left">Workflow Builder</td>
<td id="A1.T6.6.3.2" class="ltx_td ltx_align_left"><a href="https://www.youtube.com/watch?v=8yWhj0ivqPY" title="" class="ltx_ref ltx_url ltx_font_typewriter">https://www.youtube.com/watch?v=8yWhj0ivqPY</a></td></tr>
<tr id="A1.T6.6.4" class="ltx_tr">
<td id="A1.T6.6.4.1" class="ltx_td ltx_align_left">3D Modeller</td>
<td id="A1.T6.6.4.2" class="ltx_td ltx_align_left"><a href="https://www.youtube.com/watch?v=Yr1hH7tWp28" title="" class="ltx_ref ltx_url ltx_font_typewriter">https://www.youtube.com/watch?v=Yr1hH7tWp28</a></td></tr>
<tr id="A1.T6.6.5" class="ltx_tr">
<td id="A1.T6.6.5.1" class="ltx_td ltx_align_left">Flight Analyser</td>
<td id="A1.T6.6.5.2" class="ltx_td ltx_align_left"><a href="https://www.youtube.com/watch?v=CQsKjizsID4" title="" class="ltx_ref ltx_url ltx_font_typewriter">https://www.youtube.com/watch?v=CQsKjizsID4</a></td></tr>
<tr id="A1.T6.6.6" class="ltx_tr">
<td id="A1.T6.6.6.1" class="ltx_td ltx_align_left ltx_border_bb">Circuit Designer</td>
<td id="A1.T6.6.6.2" class="ltx_td ltx_align_left ltx_border_bb"><a href="https://www.youtube.com/watch?v=bU5zztXSnjk" title="" class="ltx_ref ltx_url ltx_font_typewriter">https://www.youtube.com/watch?v=bU5zztXSnjk</a></td></tr>
</table>
</figure>
<figure id="A1.fig1" class="ltx_figure">
<div class="ltx_flex_figure">
<div class="ltx_flex_cell ltx_flex_size_1">
<figure id="A1.F7.sf1" class="ltx_figure ltx_figure_panel ltx_align_center"><img src="2606.14397v1/images/app_full_screens/video.png" id="A1.F7.sf1.g1" class="ltx_graphics ltx_centering ltx_img_landscape" style="aspect-ratio:429/234;" width="429" height="234" alt="Refer to caption">
<figcaption class="ltx_caption ltx_centering"><span class="ltx_tag ltx_tag_figure"><span id="A1.F7.sf1.3" class="ltx_text" style="font-size:90%;">(a)</span> </span><span id="A1.F7.sf1.4" class="ltx_text" style="font-size:90%;">Video Editor</span></figcaption>
</figure></div><div class="ltx_flex_break"></div><div class="ltx_flex_cell ltx_flex_size_1">
