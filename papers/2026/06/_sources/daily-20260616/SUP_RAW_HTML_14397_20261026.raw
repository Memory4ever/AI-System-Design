<td id="A7.T12.3.61.2" class="ltx_td ltx_align_left ltx_align_top ltx_border_bb ltx_border_r ltx_border_t" style="padding-top:0.7pt;padding-bottom:0.7pt;">
<span id="A7.T12.3.61.2.1" class="ltx_inline-block ltx_align_top" style="width:300.2pt;"><img src="2606.14397v1/images/graph_gt_pngs/tc_graph_008.png" id="A7.T12.g20" class="ltx_graphics ltx_align_left ltx_img_landscape" style="aspect-ratio:476/187;" width="476" height="187" alt="[Uncaptioned image]">
