<td id="A7.T11.3.13.1" class="ltx_td ltx_align_left ltx_align_top ltx_border_l ltx_border_r" style="--ltx-bg-color:#FFECD9;padding-top:0.7pt;padding-bottom:0.7pt;"></td>
<td id="A7.T11.3.13.2" class="ltx_td ltx_align_left ltx_align_top ltx_border_r ltx_border_t" style="padding-top:0.7pt;padding-bottom:0.7pt;">
