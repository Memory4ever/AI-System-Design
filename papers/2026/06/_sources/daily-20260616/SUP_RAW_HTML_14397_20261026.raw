<tr id="A7.T13.3.73" class="ltx_tr">
<td id="A7.T13.3.73.1" class="ltx_td ltx_align_left ltx_align_top ltx_border_l ltx_border_r" style="--ltx-bg-color:#FFD9D9;padding-top:0.7pt;padding-bottom:0.7pt;"></td>
<td id="A7.T13.3.73.2" class="ltx_td ltx_align_left ltx_align_top ltx_border_r ltx_border_t" style="padding-top:0.7pt;padding-bottom:0.7pt;">
<span id="A7.T13.3.73.2.1" class="ltx_inline-block ltx_align_top" style="width:300.2pt;"><img src="2606.14397v1/images/3d_editor_gt_jpegs/tc_3d_editor_011.jpg" id="A7.T13.g28" class="ltx_graphics ltx_align_left ltx_img_landscape" style="aspect-ratio:476/238;" width="476" height="238" alt="[Uncaptioned image]">
