{"data":[{"id":"10.48550/arxiv.2606.15735","type":"dois","attributes":{"doi":"10.48550/arxiv.2606.15735","identifiers":[{"identifier":"2606.15735","identifierType":"arXiv"}],"creators":[{"nameType":"Personal","givenName":"Jiyoun","familyName":"Kim","name":"Kim, Jiyoun","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Muhan","familyName":"Yeo","name":"Yeo, Muhan","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Eunhye","familyName":"Jang","name":"Jang, Eunhye","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Jeewon","familyName":"Yang","name":"Yang, Jeewon","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Hangyul","familyName":"Yoon","name":"Yoon, Hangyul","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Su Ji","familyName":"Lee","name":"Lee, Su Ji","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Hee Jo","familyName":"Han","name":"Han, Hee Jo","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Hee-Jae","familyName":"Jung","name":"Jung, Hee-Jae","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Doyun","familyName":"Kwon","name":"Kwon, Doyun","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Jun young","familyName":"Lee","name":"Lee, Jun young","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Jaehun","familyName":"Lee","name":"Lee, Jaehun","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Jung-Oh","familyName":"Lee","name":"Lee, Jung-Oh","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Sunjun","familyName":"Kweon","name":"Kweon, Sunjun","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Jong Hak","familyName":"Moon","name":"Moon, Jong Hak","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Daseul","familyName":"Kim","name":"Kim, Daseul","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Minjae","familyName":"Cho","name":"Cho, Minjae","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Edward","familyName":"Choi","name":"Choi, Edward","affiliation":[],"nameIdentifiers":[]}],"titles":[{"title":"EHRNote-ChatQA: A Benchmark for Evidence-Grounded Multi-Turn Clinical Question Answering over Longitudinal Discharge Summaries"}],"publisher":"arXiv","container":{},"publicationYear":2026,"subjects":[{"subject":"Computation and Language (cs.CL)","lang":"en","subjectScheme":"arXiv"},{"subject":"Artificial Intelligence (cs.AI)","lang":"en","subjectScheme":"arXiv"},{"subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"}],"contributors":[],"dates":[{"date":"2026-06-14T10:35:19Z","dateType":"Submitted","dateInformation":"v1"},{"date":"2026-06-16T00:55:40Z","dateType":"Updated","dateInformation":"v1"},{"date":"2026-06-16T10:33:24Z","dateType":"Submitted","dateInformation":"v2"},{"date":"2026-06-17T00:44:49Z","dateType":"Updated","dateInformation":"v2"},{"date":"2026-10-21T15:46:36Z","dateType":"Submitted","dateInformation":"v3"},{"date":"2026-10-22T01:18:57Z","dateType":"Updated","dateInformation":"v3"},{"date":"2026-06","dateType":"Available","dateInformation":"v1"}],"language":null,"types":{"schemaOrg":"CreativeWork","resourceTypeGeneral":"Preprint","citeproc":"article","bibtex":"misc","ris":"GEN","resourceType":"Article"},"relatedIdentifiers":[],"relatedItems":[],"sizes":[],"formats":[],"version":"3","rightsList":[{"rightsIdentifierScheme":"SPDX","rightsUri":"https://creativecommons.org/licenses/by/4.0/legalcode","schemeUri":"https://spdx.org/licenses/","rights":"Creative Commons Attribution 4.0 International","rightsIdentifier":"cc-by-4.0"}],"descriptions":[{"descriptionType":"Abstract","description":"Discharge summaries are crucial clinical documents containing the context of a patient's overall hospital stay, and are routinely reviewed by medical experts for patient readmission, ongoing care, and diagnostic decision-making. When reviewing them, medical experts often must iteratively synthesize information across multiple discharge summaries while verifying the evidence supporting each answer. Although large language models (LLMs) are increasingly explored for clinical question answering, existing benchmarks do not sufficiently reflect this setting: they often evaluate exam-style medical knowledge or focus on single-turn question answering with limited evidence-grounding evaluation. We introduce EHRNote-ChatQA, the first benchmark for evidence-grounded multi-turn clinical question answering over patients' multiple discharge summaries. Built from de-identified MIMIC-IV discharge summaries, EHRNote-ChatQA contains 967 patient-level multi-turn samples spanning one to five notes and 16,072 medical-expert-verified QA pairs (8,036 content questions, each paired with an evidence-grounding question) across eight clinical categories. The benchmark is constructed through an expert-informed pipeline combining discharge-summary structuring schema, expert-curated multi-turn QA templates, and LLM-based generation, followed by review and revision of every single QA sample by 12 medical experts (11 physicians and 1 nurse). Benchmarking 24 proprietary and open-weight LLMs reveals several challenges, including that LLMs struggle more with evidence grounding than content answering, multi-turn errors compound across turns, and single-turn clinical QA performance does not reliably transfer to this setting. These findings establish EHRNote-ChatQA as a rigorous and practical benchmark for evaluating clinical QA systems."}],"geoLocations":[],"fundingReferences":[],"url":"https://arxiv.org/abs/2606.15735","contentUrl":null,"metadataVersion":2,"schemaVersion":"http://datacite.org/schema/kernel-4","source":"mds","isActive":true,"state":"findable","reason":null,"viewCount":0,"downloadCount":0,"referenceCount":0,"citationCount":0,"partCount":0,"partOfCount":0,"versionCount":0,"versionOfCount":0,"created":"2026-06-16T03:30:11Z","registered":"2026-06-16T03:30:12Z","published":null,"updated":"2026-10-22T03:04:45Z"},"relationships":{"client":{"data":{"id":"arxiv.content","type":"clients"}}}},{"id":"10.48550/arxiv.2606.15569","type":"dois","attributes":{"doi":"10.48550/arxiv.2606.15569","identifiers":[{"identifier":"2606.15569","identifierType":"arXiv"}],"creators":[{"nameType":"Personal","givenName":"Tomoya","familyName":"Wakayama","name":"Wakayama, Tomoya","affiliation":[],"nameIdentifiers":[]}],"titles":[{"title":"A Decision-Theoretic View of Test-Time Training: When, How Far, and Which Directions to Adapt"}],"publisher":"arXiv","container":{},"publicationYear":2026,"subjects":[{"subject":"Machine Learning (cs.LG)","lang":"en","subjectScheme":"arXiv"},{"subject":"Statistics Theory (math.ST)","lang":"en","subjectScheme":"arXiv"},{"subject":"Machine Learning (stat.ML)","lang":"en","subjectScheme":"arXiv"},{"subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"},{"subject":"FOS: Mathematics","subjectScheme":"Fields of Science and Technology (FOS)"}],"contributors":[],"dates":[{"date":"2026-06-14T03:16:40Z","dateType":"Submitted","dateInformation":"v1"},{"date":"2026-10-14T02:08:02Z","dateType":"Updated","dateInformation":"v1"},{"date":"2026-10-19T14:54:48Z","dateType":"Submitted","dateInformation":"v2"},{"date":"2026-10-20T02:31:13Z","dateType":"Updated","dateInformation":"v2"},{"date":"2026-06","dateType":"Available","dateInformation":"v1"}],"language":null,"types":{"schemaOrg":"CreativeWork","resourceTypeGeneral":"Preprint","citeproc":"article","bibtex":"misc","ris":"GEN","resourceType":"Article"},"relatedIdentifiers":[],"relatedItems":[],"sizes":[],"formats":[],"version":"2","rightsList":[{"rightsIdentifierScheme":"SPDX","rightsUri":"https://creativecommons.org/licenses/by/4.0/legalcode","schemeUri":"https://spdx.org/licenses/","rights":"Creative Commons Attribution 4.0 International","rightsIdentifier":"cc-by-4.0"}],"descriptions":[{"descriptionType":"Abstract","description":"Test-time training (TTT) adapts a pretrained model to each prompt via parameter updates, improving accuracy under pretraining-to-test distribution shifts. Yet, its performance often suffers from instability and sensitivity to hyperparameters such as update steps and subspace. We explain this behavior through a decision-theoretic lens, treating TTT as implicit Bayesian inference in the kernel regime. Under a Gaussian process benchmark, we show that TTT reduces prediction error when updates are spectrally matched to the prompt's signal-to-noise ratio and aligned with query-relevant eigen-directions. This perspective underpins the following results: (1) we show when fixed update steps and subspaces fail under distribution shifts, motivating adaptive strategies; (2) we prove that selecting update steps via prompt evidence admits a PAC-Bayes guarantee against overfitting; and (3) we characterize the Bayes-optimal update subspace under a linear-Gaussian correction model, yielding a scoring rule for selecting Transformer blocks and heads. Our theory helps explain the empirical instability of TTT, taking a step toward principled guidance for when, how far, and which directions to adapt."}],"geoLocations":[],"fundingReferences":[],"url":"https://arxiv.org/abs/2606.15569","contentUrl":null,"metadataVersion":2,"schemaVersion":"http://datacite.org/schema/kernel-4","source":"mds","isActive":true,"state":"findable","reason":null,"viewCount":0,"downloadCount":0,"referenceCount":0,"citationCount":0,"partCount":0,"partOfCount":0,"versionCount":0,"versionOfCount":0,"created":"2026-06-16T03:26:39Z","registered":"2026-06-16T03:26:39Z","published":null,"updated":"2026-10-20T05:25:00Z"},"relationships":{"client":{"data":{"id":"arxiv.content","type":"clients"}}}},{"id":"10.48550/arxiv.2606.15734","type":"dois","attributes":{"doi":"10.48550/arxiv.2606.15734","identifiers":[{"identifier":"2606.15734","identifierType":"arXiv"}],"creators":[{"nameType":"Personal","givenName":"Weihang","familyName":"Su","name":"Su, Weihang","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Jiacheng","familyName":"Kang","name":"Kang, Jiacheng","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Jingyan","familyName":"Xu","name":"Xu, Jingyan","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Qingyao","familyName":"Ai","name":"Ai, Qingyao","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Jianming","familyName":"Long","name":"Long, Jianming","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Hanwen","familyName":"Zhang","name":"Zhang, Hanwen","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Bangde","familyName":"Du","name":"Du, Bangde","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Xinyuan","familyName":"Cao","name":"Cao, Xinyuan","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Min","familyName":"Zhang","name":"Zhang, Min","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Yiqun","familyName":"Liu","name":"Liu, Yiqun","affiliation":[],"nameIdentifiers":[]}],"titles":[{"title":"Retrievable Gradients: Continual Post-Training Without Cumulative Weight Drift"}],"publisher":"arXiv","container":{},"publicationYear":2026,"subjects":[{"subject":"Computation and Language (cs.CL)","lang":"en","subjectScheme":"arXiv"},{"subject":"Artificial Intelligence (cs.AI)","lang":"en","subjectScheme":"arXiv"},{"subject":"Information Retrieval (cs.IR)","lang":"en","subjectScheme":"arXiv"},{"subject":"Machine Learning (cs.LG)","lang":"en","subjectScheme":"arXiv"},{"subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"}],"contributors":[],"dates":[{"date":"2026-06-14T10:31:36Z","dateType":"Submitted","dateInformation":"v1"},{"date":"2026-06-16T00:55:39Z","dateType":"Updated","dateInformation":"v1"},{"date":"2026-10-11T15:04:13Z","dateType":"Submitted","dateInformation":"v2"},{"date":"2026-10-14T01:31:57Z","dateType":"Updated","dateInformation":"v2"},{"date":"2026-06","dateType":"Available","dateInformation":"v1"}],"language":null,"types":{"schemaOrg":"CreativeWork","resourceTypeGeneral":"Preprint","citeproc":"article","bibtex":"misc","ris":"GEN","resourceType":"Article"},"relatedIdentifiers":[],"relatedItems":[],"sizes":[],"formats":[],"version":"2","rightsList":[{"rightsIdentifierScheme":"SPDX","rightsUri":"https://creativecommons.org/licenses/by-sa/4.0/legalcode","schemeUri":"https://spdx.org/licenses/","rights":"Creative Commons Attribution Share Alike 4.0 International","rightsIdentifier":"cc-by-sa-4.0"}],"descriptions":[{"descriptionType":"Abstract","description":"Continual post-training enables models to absorb emerging knowledge after deployment, but repeatedly updating shared parameters can accumulate weight drift, potentially causing catastrophic forgetting and degrading general capabilities. Retrieval-augmented generation avoids such parameter drift, yet often lacks the depth of parametric knowledge integration. In this paper, we propose ReGrad (Retrievable Gradients), a new paradigm that treats gradients as retrievable units of knowledge. ReGrad pre-computes document-specific gradients offline, stores them in an indexed Gradient Bank, and retrieves only query-relevant gradients at inference time for temporary weight adaptation. However, raw language-modeling gradients are optimized for token-level document reconstruction rather than for query-driven knowledge use. We therefore introduce a bi-level meta-learning objective that reshapes document-derived gradients into generalizable adaptation signals for downstream tasks. Experiments across general and domain-specific settings show that \\textsc{ReGrad} outperforms CPT and RAG baselines, enabling scalable and reversible parametric knowledge injection without accumulating weight drift."}],"geoLocations":[],"fundingReferences":[],"url":"https://arxiv.org/abs/2606.15734","contentUrl":null,"metadataVersion":1,"schemaVersion":"http://datacite.org/schema/kernel-4","source":"mds","isActive":true,"state":"findable","reason":null,"viewCount":0,"downloadCount":0,"referenceCount":0,"citationCount":0,"partCount":0,"partOfCount":0,"versionCount":0,"versionOfCount":0,"created":"2026-06-16T03:30:10Z","registered":"2026-06-16T03:30:10Z","published":null,"updated":"2026-10-14T08:37:15Z"},"relationships":{"client":{"data":{"id":"arxiv.content","type":"clients"}}}},{"id":"10.48550/arxiv.2606.15610","type":"dois","attributes":{"doi":"10.48550/arxiv.2606.15610","identifiers":[{"identifier":"2606.15610","identifierType":"arXiv"}],"creators":[{"nameType":"Personal","givenName":"Hiroyasu","familyName":"Usami","name":"Usami, Hiroyasu","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Keisuke","familyName":"Hara","name":"Hara, Keisuke","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Ayato","familyName":"Tsuboi","name":"Tsuboi, Ayato","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Naohiko","familyName":"Matsuda","name":"Matsuda, Naohiko","affiliation":[],"nameIdentifiers":[]}],"titles":[{"title":"LLM Judges Have Dark Current: Stratified Null and Utility Tests for LLM Judge Reliability"}],"publisher":"arXiv","container":{},"publicationYear":2026,"subjects":[{"subject":"Computation and Language (cs.CL)","lang":"en","subjectScheme":"arXiv"},{"subject":"Instrumentation and Methods for Astrophysics (astro-ph.IM)","lang":"en","subjectScheme":"arXiv"},{"subject":"Artificial Intelligence (cs.AI)","lang":"en","subjectScheme":"arXiv"},{"subject":"Machine Learning (cs.LG)","lang":"en","subjectScheme":"arXiv"},{"subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"},{"subject":"FOS: Physical sciences","subjectScheme":"Fields of Science and Technology (FOS)"}],"contributors":[],"dates":[{"date":"2026-06-14T05:34:17Z","dateType":"Submitted","dateInformation":"v1"},{"date":"2026-06-16T00:50:12Z","dateType":"Updated","dateInformation":"v1"},{"date":"2026-10-12T20:24:02Z","dateType":"Submitted","dateInformation":"v2"},{"date":"2026-10-14T02:58:47Z","dateType":"Updated","dateInformation":"v2"},{"date":"2026-06","dateType":"Available","dateInformation":"v1"}],"language":null,"types":{"schemaOrg":"CreativeWork","resourceTypeGeneral":"Preprint","citeproc":"article","bibtex":"misc","ris":"GEN","resourceType":"Article"},"relatedIdentifiers":[],"relatedItems":[],"sizes":[],"formats":[],"version":"2","rightsList":[{"rightsIdentifierScheme":"SPDX","rightsUri":"https://creativecommons.org/licenses/by/4.0/legalcode","schemeUri":"https://spdx.org/licenses/","rights":"Creative Commons Attribution 4.0 International","rightsIdentifier":"cc-by-4.0"}],"descriptions":[{"descriptionType":"Abstract","description":"Passing an exact-clone null gate does not entail passing a matched target-selection utility gate. We call a non-tie preference between exact duplicates dark current. On 102 prespecified fresh RewardBench 2 rows, all four configuration--criterion cells report 0/102 clone preferences. Both neutral utility arms pass, but strict utility lower bounds of .539 and .745 miss the .75 working threshold. Conversely, re-evaluation of the same rows on two additional configurations yields a neutral gpt-oss utility pass with 2/102 clone preferences, leaving low-null behavior uncertified. A separately frozen 485-row extension passes both aggregate working gates under both criteria on one local raw-text configuration, yet strict Precise Instruction Following (Precise IF) alignment is 58/154 (.377). Thus matched null and utility results can diverge, and aggregate passage can coexist with weak subset alignment. Interpretation is conditional on the declared configurations, fixed source mixtures, source-label targets, and study-specific working models. The bounds are marginal, the subset rate is descriptive, and non-certification does not prove a defect."},{"descriptionType":"Other","description":"21 pages, 4 figures, 9 tables. Substantially revised: input-stratified null and target-selection utility audits, additional fixed-configuration studies, and an operational audit protocol. Supersedes v1, originally titled \"LLM Judges Have Dark Current: A Psychometric Datasheet for LLM-as-a-Judge Evaluation.\""}],"geoLocations":[],"fundingReferences":[],"url":"https://arxiv.org/abs/2606.15610","contentUrl":null,"metadataVersion":1,"schemaVersion":"http://datacite.org/schema/kernel-4","source":"mds","isActive":true,"state":"findable","reason":null,"viewCount":0,"downloadCount":0,"referenceCount":0,"citationCount":0,"partCount":0,"partOfCount":0,"versionCount":0,"versionOfCount":0,"created":"2026-06-16T03:27:32Z","registered":"2026-06-16T03:27:32Z","published":null,"updated":"2026-10-14T08:37:14Z"},"relationships":{"client":{"data":{"id":"arxiv.content","type":"clients"}}}},{"id":"10.48550/arxiv.2606.15517","type":"dois","attributes":{"doi":"10.48550/arxiv.2606.15517","identifiers":[{"identifier":"2606.15517","identifierType":"arXiv"}],"creators":[{"nameType":"Personal","givenName":"Viswonathan","familyName":"Manoranjan","name":"Manoranjan, Viswonathan","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Amogh","familyName":"Gupta","name":"Gupta, Amogh","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Anvesh Rao","familyName":"Vijjini","name":"Vijjini, Anvesh Rao","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Thomas","familyName":"Hofweber","name":"Hofweber, Thomas","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Snigdha","familyName":"Chaturvedi","name":"Chaturvedi, Snigdha","affiliation":[],"nameIdentifiers":[]}],"titles":[{"title":"SHARD: Safe and Helpful Alignment via Self-Reframing Distillation"}],"publisher":"arXiv","container":{},"publicationYear":2026,"subjects":[{"subject":"Computation and Language (cs.CL)","lang":"en","subjectScheme":"arXiv"},{"subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"}],"contributors":[],"dates":[{"date":"2026-06-14T00:12:53Z","dateType":"Submitted","dateInformation":"v1"},{"date":"2026-06-16T00:45:14Z","dateType":"Updated","dateInformation":"v1"},{"date":"2026-09-02T15:50:25Z","dateType":"Submitted","dateInformation":"v2"},{"date":"2026-09-03T01:07:05Z","dateType":"Updated","dateInformation":"v2"},{"date":"2026-06","dateType":"Available","dateInformation":"v1"}],"language":null,"types":{"schemaOrg":"CreativeWork","resourceTypeGeneral":"Preprint","citeproc":"article","bibtex":"misc","ris":"GEN","resourceType":"Article"},"relatedIdentifiers":[],"relatedItems":[],"sizes":[],"formats":[],"version":"2","rightsList":[{"rightsIdentifierScheme":"SPDX","rightsUri":"https://creativecommons.org/licenses/by/4.0/legalcode","schemeUri":"https://spdx.org/licenses/","rights":"Creative Commons Attribution 4.0 International","rightsIdentifier":"cc-by-4.0"}],"descriptions":[{"descriptionType":"Abstract","description":"Large language models often struggle with sensitive prompts. They may refuse outright, provide generic safety boilerplate, or fail to address the user's legitimate informational needs that can be answered safely. We introduce SHARD, a self-reframing distillation method to improve safe-helpfulness. It first rewrites sensitive prompts to surface benign intent using philosophical guidelines, then reframes its original responses into safe, more helpful ones, and finally fine-tunes the model on its self-reframed responses. Across DNA and the English subset of LINGUASAFE, SHARD improves helpfulness for most model families while preserving safety. It also remains competitive with distillation from a larger teacher model, suggesting that models can internalize safe and helpful behavior elicited from their own. Warning: This paper contains content that may be offensive or harmful."},{"descriptionType":"Other","description":"EMNLP 2026"}],"geoLocations":[],"fundingReferences":[],"url":"https://arxiv.org/abs/2606.15517","contentUrl":null,"metadataVersion":1,"schemaVersion":"http://datacite.org/schema/kernel-4","source":"mds","isActive":true,"state":"findable","reason":null,"viewCount":0,"downloadCount":0,"referenceCount":0,"citationCount":0,"partCount":0,"partOfCount":0,"versionCount":0,"versionOfCount":0,"created":"2026-06-16T03:25:31Z","registered":"2026-06-16T03:25:32Z","published":null,"updated":"2026-09-03T02:41:46Z"},"relationships":{"client":{"data":{"id":"arxiv.content","type":"clients"}}}},{"id":"10.48550/arxiv.2606.15615","type":"dois","attributes":{"doi":"10.48550/arxiv.2606.15615","identifiers":[{"identifier":"2606.15615","identifierType":"arXiv"}],"creators":[{"nameType":"Personal","givenName":"Maoliang","familyName":"Li","name":"Li, Maoliang","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Haojing","familyName":"Chen","name":"Chen, Haojing","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Jiayu","familyName":"Chen","name":"Chen, Jiayu","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Zihao","familyName":"Zheng","name":"Zheng, Zihao","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Xinhao","familyName":"Sun","name":"Sun, Xinhao","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Hailong","familyName":"Zou","name":"Zou, Hailong","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Xiang","familyName":"Chen","name":"Chen, Xiang","affiliation":[],"nameIdentifiers":[]}],"titles":[{"title":"MoECa: Aligning Feature Reuse with Expert Decomposition in Diffusion Transformers"}],"publisher":"arXiv","container":{},"publicationYear":2026,"subjects":[{"subject":"Machine Learning (cs.LG)","lang":"en","subjectScheme":"arXiv"},{"subject":"Computer Vision and Pattern Recognition (cs.CV)","lang":"en","subjectScheme":"arXiv"},{"subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"}],"contributors":[],"dates":[{"date":"2026-06-14T05:54:36Z","dateType":"Submitted","dateInformation":"v1"},{"date":"2026-06-16T00:50:25Z","dateType":"Updated","dateInformation":"v1"},{"date":"2026-08-04T03:28:04Z","dateType":"Submitted","dateInformation":"v2"},{"date":"2026-08-05T00:22:55Z","dateType":"Updated","dateInformation":"v2"},{"date":"2026-06","dateType":"Available","dateInformation":"v1"}],"language":null,"types":{"schemaOrg":"CreativeWork","resourceTypeGeneral":"Preprint","citeproc":"article","bibtex":"misc","ris":"GEN","resourceType":"Article"},"relatedIdentifiers":[],"relatedItems":[],"sizes":[],"formats":[],"version":"2","rightsList":[{"rightsIdentifierScheme":"SPDX","rightsUri":"https://creativecommons.org/licenses/by/4.0/legalcode","schemeUri":"https://spdx.org/licenses/","rights":"Creative Commons Attribution 4.0 International","rightsIdentifier":"cc-by-4.0"}],"descriptions":[{"descriptionType":"Abstract","description":"Diffusion Transformers with Mixture-of-Experts (DiT-MoE) improve model capacity under sparse activation, but diffusion inference is still bottlenecked by redundant computation across timesteps. Existing caching methods mainly operate at the token level, which becomes suboptimal in DiT-MoE because each token update is internally decomposed into multiple routed expert branches. Our analysis shows that cross-timestep redundancy in DiT-MoE is better characterized at the expert-branch level than at the whole-token level. Based on this observation, we propose MoECa, a fine-grained caching framework that performs branch-level feature reuse across timesteps. MoECa further introduces expert-aware adaptive control and synchronized cache updates across MoE and attention paths to maintain stable intermediate states. Experiments on multiple DiT-MoE models show a favorable speed--quality trade-off, with up to 2.93$\\times$ speedups while preserving generation quality."},{"descriptionType":"Other","description":"Will appear in ACM MM'2026"}],"geoLocations":[],"fundingReferences":[],"url":"https://arxiv.org/abs/2606.15615","contentUrl":null,"metadataVersion":1,"schemaVersion":"http://datacite.org/schema/kernel-4","source":"mds","isActive":true,"state":"findable","reason":null,"viewCount":0,"downloadCount":0,"referenceCount":0,"citationCount":0,"partCount":0,"partOfCount":0,"versionCount":0,"versionOfCount":0,"created":"2026-06-16T03:27:38Z","registered":"2026-06-16T03:27:39Z","published":null,"updated":"2026-08-05T02:34:36Z"},"relationships":{"client":{"data":{"id":"arxiv.content","type":"clients"}}}},{"id":"10.48550/arxiv.2606.15553","type":"dois","attributes":{"doi":"10.48550/arxiv.2606.15553","identifiers":[{"identifier":"2606.15553","identifierType":"arXiv"}],"creators":[{"nameType":"Personal","givenName":"Jiawei","familyName":"Zhang","name":"Zhang, Jiawei","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Mengfei","familyName":"Xia","name":"Xia, Mengfei","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Gen","familyName":"Li","name":"Li, Gen","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Yuantao","familyName":"Gu","name":"Gu, Yuantao","affiliation":[],"nameIdentifiers":[]}],"titles":[{"title":"Distilling Drifting Transformers with Representation Autoencoders"}],"publisher":"arXiv","container":{},"publicationYear":2026,"subjects":[{"subject":"Machine Learning (cs.LG)","lang":"en","subjectScheme":"arXiv"},{"subject":"Artificial Intelligence (cs.AI)","lang":"en","subjectScheme":"arXiv"},{"subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"}],"contributors":[],"dates":[{"date":"2026-06-14T02:46:50Z","dateType":"Submitted","dateInformation":"v1"},{"date":"2026-06-16T00:47:23Z","dateType":"Updated","dateInformation":"v1"},{"date":"2026-08-03T16:23:10Z","dateType":"Submitted","dateInformation":"v2"},{"date":"2026-08-04T02:09:57Z","dateType":"Updated","dateInformation":"v2"},{"date":"2026-06","dateType":"Available","dateInformation":"v1"}],"language":null,"types":{"schemaOrg":"CreativeWork","resourceTypeGeneral":"Preprint","citeproc":"article","bibtex":"misc","ris":"GEN","resourceType":"Article"},"relatedIdentifiers":[],"relatedItems":[],"sizes":[],"formats":[],"version":"2","rightsList":[{"rightsIdentifierScheme":"SPDX","rightsUri":"https://creativecommons.org/licenses/by/4.0/legalcode","schemeUri":"https://spdx.org/licenses/","rights":"Creative Commons Attribution 4.0 International","rightsIdentifier":"cc-by-4.0"}],"descriptions":[{"descriptionType":"Abstract","description":"Despite the significant training acceleration and promising performance, Representation Autoencoders (RAEs) are mainly criticized for poor distillation effectiveness. In this work, we argue that RAE is competent at high-quality one-step generation. We achieve 1.48 FID with only 16-epoch distillation on ImageNet 256 dataset, surpassing various state-of-the-art methods. To achieve this, we quantitatively study the geometrical behavior of different underlying data spaces. We conclude that conventional distillation methods heavily rely on priors of plain teacher denoising trajectories, while RAE incurs much more complex trajectories with poor properties due to ill anisotropical latent space. We introduce the recently proposed drifting field as the distillation methodology, which makes use of semantically rich RAE latents and provides direct supervision involving no dependency. Bridging our Drift-RAE with previous generative paradigms, we propose several insightful modifications, including the first extrapolation-based guided sampling pipeline for one-step generation with barely no cost. The code will be made publicly available."}],"geoLocations":[],"fundingReferences":[],"url":"https://arxiv.org/abs/2606.15553","contentUrl":null,"metadataVersion":1,"schemaVersion":"http://datacite.org/schema/kernel-4","source":"mds","isActive":true,"state":"findable","reason":null,"viewCount":0,"downloadCount":0,"referenceCount":0,"citationCount":0,"partCount":0,"partOfCount":0,"versionCount":0,"versionOfCount":0,"created":"2026-06-16T03:26:19Z","registered":"2026-06-16T03:26:19Z","published":null,"updated":"2026-08-04T04:46:41Z"},"relationships":{"client":{"data":{"id":"arxiv.content","type":"clients"}}}},{"id":"10.48550/arxiv.2606.15510","type":"dois","attributes":{"doi":"10.48550/arxiv.2606.15510","identifiers":[{"identifier":"2606.15510","identifierType":"arXiv"}],"creators":[{"nameType":"Personal","givenName":"Nikolaos","familyName":"Lavidas","name":"Lavidas, Nikolaos","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Kiki","familyName":"Nikiforidou","name":"Nikiforidou, Kiki","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Dag","familyName":"Haug","name":"Haug, Dag","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Leonid","familyName":"Kulikov","name":"Kulikov, Leonid","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Vassiliki","familyName":"Geka","name":"Geka, Vassiliki","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Vassileios","familyName":"Symeonidis","name":"Symeonidis, Vassileios","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Theodoros","familyName":"Michalareas","name":"Michalareas, Theodoros","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Sofia","familyName":"Chionidi","name":"Chionidi, Sofia","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Anastasia","familyName":"Tsiropina","name":"Tsiropina, Anastasia","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Eleni","familyName":"Plakoutsi","name":"Plakoutsi, Eleni","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Evangelos","familyName":"Argyropoulos","name":"Argyropoulos, Evangelos","affiliation":[],"nameIdentifiers":[]}],"titles":[{"title":"AthDGC: An Open Diachronic Greek Treebank with Indo-European Parallels"}],"publisher":"arXiv","container":{},"publicationYear":2026,"subjects":[{"subject":"Computation and Language (cs.CL)","lang":"en","subjectScheme":"arXiv"},{"subject":"Digital Libraries (cs.DL)","lang":"en","subjectScheme":"arXiv"},{"subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"},{"subject":"I.2.7","lang":"en","subjectScheme":"ACM"},{"subject":"primary cs.CL, cross-list cs.DL","lang":"en","subjectScheme":"MSC"}],"contributors":[],"dates":[{"date":"2026-06-13T23:38:39Z","dateType":"Submitted","dateInformation":"v1"},{"date":"2026-06-16T00:45:00Z","dateType":"Updated","dateInformation":"v1"},{"date":"2026-07-01T23:17:33Z","dateType":"Submitted","dateInformation":"v2"},{"date":"2026-07-03T00:13:54Z","dateType":"Updated","dateInformation":"v2"},{"date":"2026-06","dateType":"Available","dateInformation":"v1"}],"language":null,"types":{"schemaOrg":"CreativeWork","resourceTypeGeneral":"Preprint","citeproc":"article","bibtex":"misc","ris":"GEN","resourceType":"Article"},"relatedIdentifiers":[{"relationType":"IsVersionOf","relatedIdentifier":"10.5281/zenodo.20439182","relatedIdentifierType":"DOI"}],"relatedItems":[],"sizes":[],"formats":[],"version":"2","rightsList":[{"rightsIdentifierScheme":"SPDX","rightsUri":"https://creativecommons.org/licenses/by/4.0/legalcode","schemeUri":"https://spdx.org/licenses/","rights":"Creative Commons Attribution 4.0 International","rightsIdentifier":"cc-by-4.0"}],"descriptions":[{"descriptionType":"Abstract","description":"AthDGC (\"Athens-PROIEL\") is an open, end-to-end workflow and dataset. It is, to the best of our knowledge, the first openly licensed dependency-parsed treebank of Greek that spans eight diachronic periods, namely Archaic, Classical, Koine, Late Antique, Byzantine, Late Byzantine, Early Modern, and Modern Greek, under a single PROIEL XML 2.0 schema, with verse-level cross-alignment of the New Testament to Latin (Vulgate), Gothic (Wulfila), Old Church Slavonic (Marianus), and Classical Armenian. AthDGC builds on the PROIEL Treebank Family (Haug and Johndal 2008; Eckhoff et al. 2018), which established the schema and the Koine-Greek reference set for the project. Annotation uses the Stanford Stanza PROIEL-trained workflow; sentence-level alignment uses LaBSE, a multilingual sentence-embedding model; word-level alignment uses multilingual-BERT attention through the AwesomeAlign procedure. The v0.4 release provides curated samples and the open-source toolkit; the full annotated corpus partitions remain under v0.5 audit on the Greek national HPC. Quantitative scale, per-witness verse counts, and per-period annotated-row counts are reported in the v0.5 release notes, after the audit pass completes. Concept DOI: 10.5281/zenodo.20439182."},{"descriptionType":"Other","description":"v2: textual cleanup of v1, plus extended contemporary Modern Greek coverage by adding the openly licensed plenary proceedings of the Hellenic Parliament (Vouli ton Ellinon, hellenicparliament.gr, 2015 to 2026) as a public-domain source in the per-period source map. Per-period counts remain deferred to the v0.5 release.Concept DOI: 10.5281/zenodo.20439182. Companion site: https://athdgc.github.io"}],"geoLocations":[],"fundingReferences":[],"url":"https://arxiv.org/abs/2606.15510","contentUrl":null,"metadataVersion":1,"schemaVersion":"http://datacite.org/schema/kernel-4","source":"mds","isActive":true,"state":"findable","reason":null,"viewCount":0,"downloadCount":0,"referenceCount":0,"citationCount":0,"partCount":0,"partOfCount":0,"versionCount":0,"versionOfCount":1,"created":"2026-06-16T03:25:22Z","registered":"2026-06-16T03:25:23Z","published":null,"updated":"2026-07-03T02:18:45Z"},"relationships":{"client":{"data":{"id":"arxiv.content","type":"clients"}}}},{"id":"10.48550/arxiv.2606.15623","type":"dois","attributes":{"doi":"10.48550/arxiv.2606.15623","identifiers":[{"identifier":"2606.15623","identifierType":"arXiv"}],"creators":[{"nameType":"Personal","givenName":"Yujin","familyName":"Park","name":"Park, Yujin","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Haejun","familyName":"Chung","name":"Chung, Haejun","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Ikbeom","familyName":"Jang","name":"Jang, Ikbeom","affiliation":[],"nameIdentifiers":[]}],"titles":[{"title":"Surprise-Guided MergeSort: Budget-Efficient Human-in-the-Loop Ranking via Adaptive Comparison Scheduling"}],"publisher":"arXiv","container":{},"publicationYear":2026,"subjects":[{"subject":"Machine Learning (cs.LG)","lang":"en","subjectScheme":"arXiv"},{"subject":"Artificial Intelligence (cs.AI)","lang":"en","subjectScheme":"arXiv"},{"subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"}],"contributors":[],"dates":[{"date":"2026-06-14T06:11:42Z","dateType":"Submitted","dateInformation":"v1"},{"date":"2026-06-16T00:50:37Z","dateType":"Updated","dateInformation":"v1"},{"date":"2026-06-22T14:27:44Z","dateType":"Submitted","dateInformation":"v2"},{"date":"2026-06-23T02:44:00Z","dateType":"Updated","dateInformation":"v2"},{"date":"2026-06-23T04:34:02Z","dateType":"Submitted","dateInformation":"v3"},{"date":"2026-06-24T00:26:15Z","dateType":"Updated","dateInformation":"v3"},{"date":"2026-06-29T10:36:22Z","dateType":"Submitted","dateInformation":"v4"},{"date":"2026-06-30T01:45:40Z","dateType":"Updated","dateInformation":"v4"},{"date":"2026-06","dateType":"Available","dateInformation":"v1"}],"language":null,"types":{"schemaOrg":"CreativeWork","resourceTypeGeneral":"Preprint","citeproc":"article","bibtex":"misc","ris":"GEN","resourceType":"Article"},"relatedIdentifiers":[],"relatedItems":[],"sizes":[],"formats":[],"version":"4","rightsList":[{"rightsIdentifierScheme":"SPDX","rightsUri":"https://creativecommons.org/licenses/by-nc-sa/4.0/legalcode","schemeUri":"https://spdx.org/licenses/","rights":"Creative Commons Attribution Non Commercial Share Alike 4.0 International","rightsIdentifier":"cc-by-nc-sa-4.0"}],"descriptions":[{"descriptionType":"Abstract","description":"Pairwise comparison is the gold standard for subjective ranking tasks; however, exhaustive annotation requires a massive number of human comparisons ($O(n^2)$). While sorting-based methods have reduced this burden to $O(n\\log n)$, they still require expensive human judgment for every single comparison. To further improve annotation efficiency, we propose leveraging a Vision-Language Model (VLM) not as an annotator replacement, but as a \\emph{question prioritizer} to identify which comparisons genuinely require human judgment. The proposed \\textbf{Surprise-Guided MergeSort (SGS)} framework achieves this through three integrated components: (1) a bottom-up MergeSort scheduler that structures comparisons and exploits transitivity, (2) a composite Surprise Scorer -- combining position-bias-cancelled VLM confidence, Elo gap, and vote entropy -- to quantify comparison ambiguity, and (3) an adaptive budget allocator that routes high-surprise pairs to humans while automating low-surprise pairs via transitivity inference. Validation was conducted on six diverse benchmarks spanning text similarity (STS-B, BIOSSES, SICKR-STS) and image quality assessment (KonIQ-10k, TID2013, LIVE Challenge). SGS effectively identified and skipped up to 535 non-informative comparisons per session. Consequently, it achieved Kendall's $τ{\\times}100$ improvements of $+6$ to $+12$ over Active Elo under the same total budget. These results demonstrate that combining VLM-guided surprise metrics with algorithmic sorting provides a generally consistent accuracy-efficiency trade-off across diverse domains."},{"descriptionType":"Other","description":"After submission, we discovered significant issues in the reference and citation information used in the manuscript. Because these issues affect the integrity of the scholarly record and require substantial revision and verification, we request withdrawal of the current submission. A corrected version may be submitted in the future after a comprehensive review"}],"geoLocations":[],"fundingReferences":[],"url":"https://arxiv.org/abs/2606.15623","contentUrl":null,"metadataVersion":3,"schemaVersion":"http://datacite.org/schema/kernel-4","source":"mds","isActive":true,"state":"findable","reason":null,"viewCount":0,"downloadCount":0,"referenceCount":0,"citationCount":0,"partCount":0,"partOfCount":0,"versionCount":0,"versionOfCount":0,"created":"2026-06-16T03:27:48Z","registered":"2026-06-16T03:27:49Z","published":null,"updated":"2026-06-30T04:16:34Z"},"relationships":{"client":{"data":{"id":"arxiv.content","type":"clients"}}}},{"id":"10.48550/arxiv.2606.15678","type":"dois","attributes":{"doi":"10.48550/arxiv.2606.15678","identifiers":[{"identifier":"2606.15678","identifierType":"arXiv"}],"creators":[{"nameType":"Personal","givenName":"Emma","familyName":"Leonhart","name":"Leonhart, Emma","affiliation":[],"nameIdentifiers":[]}],"titles":[{"title":"The Reservoir Attention Network: Cross-Pass State in Pretrained Transformers via Content-Addressable Reservoir Injection"}],"publisher":"arXiv","container":{},"publicationYear":2026,"subjects":[{"subject":"Machine Learning (cs.LG)","lang":"en","subjectScheme":"arXiv"},{"subject":"Artificial Intelligence (cs.AI)","lang":"en","subjectScheme":"arXiv"},{"subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"},{"schemeUri":"http://www.oecd.org/science/inno/38235147.pdf","subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"}],"contributors":[],"dates":[{"date":"2026-06-14T08:55:47Z","dateType":"Submitted","dateInformation":"v1"},{"date":"2026-06-16T00:53:44Z","dateType":"Updated","dateInformation":"v1"},{"date":"2026-06-21T22:53:03Z","dateType":"Submitted","dateInformation":"v2"},{"date":"2026-06-23T02:05:56Z","dateType":"Updated","dateInformation":"v2"},{"date":"2026-06","dateType":"Available","dateInformation":"v1"},{"date":"2026","dateType":"Issued"}],"language":null,"types":{"schemaOrg":"CreativeWork","resourceTypeGeneral":"Preprint","citeproc":"article","bibtex":"misc","ris":"GEN","resourceType":"Article"},"relatedIdentifiers":[],"relatedItems":[],"sizes":[],"formats":[],"version":"2","rightsList":[{"rightsIdentifierScheme":"SPDX","rightsUri":"https://creativecommons.org/licenses/by/4.0/legalcode","schemeUri":"https://spdx.org/licenses/","rights":"Creative Commons Attribution 4.0 International","rightsIdentifier":"cc-by-4.0"}],"descriptions":[{"descriptionType":"Abstract","description":"A feasibility and dynamics study of the Reservoir Attention Network (RAN), an architecture that injects a fixed, randomly-initialized reservoir into the mid-layer attention of a pretrained transformer to carry state across forward passes. Experiments span GPT-2 (124M, 355M) to Qwen2.5 (0.5B, 1.5B) on a single consumer GPU. The tasks are minimal probes chosen to isolate individual mechanisms; the broader always-alive agent vision is treated throughout as compute-limited future work, not a claim of this paper. The reservoir is left untrained (fixed random) by design: this isolates whether untrained recurrent dynamics alone suffice to carry usable cross-pass state, leaving trained recurrence as a complementary, more expensive direction."},{"descriptionType":"Other","description":"29 pages, 14 figures"}],"geoLocations":[],"fundingReferences":[],"url":"https://arxiv.org/abs/2606.15678","contentUrl":null,"metadataVersion":1,"schemaVersion":"http://datacite.org/schema/kernel-4","source":"mds","isActive":true,"state":"findable","reason":null,"viewCount":0,"downloadCount":0,"referenceCount":0,"citationCount":0,"partCount":0,"partOfCount":0,"versionCount":0,"versionOfCount":0,"created":"2026-06-16T03:28:57Z","registered":"2026-06-16T03:28:58Z","published":null,"updated":"2026-06-23T05:50:59Z"},"relationships":{"client":{"data":{"id":"arxiv.content","type":"clients"}}}},{"id":"10.48550/arxiv.2606.15633","type":"dois","attributes":{"doi":"10.48550/arxiv.2606.15633","identifiers":[{"identifier":"2606.15633","identifierType":"arXiv"}],"creators":[{"nameType":"Personal","givenName":"Donald","familyName":"Loveland","name":"Loveland, Donald","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Puja","familyName":"Trivedi","name":"Trivedi, Puja","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Ari","familyName":"Weinstein","name":"Weinstein, Ari","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Edward W","familyName":"Huang","name":"Huang, Edward W","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Danai","familyName":"Koutra","name":"Koutra, Danai","affiliation":[],"nameIdentifiers":[]}],"titles":[{"title":"Formalizing and Mitigating Structural Distortion in LLM Attention for Graph Reasoning"}],"publisher":"arXiv","container":{},"publicationYear":2026,"subjects":[{"subject":"Machine Learning (cs.LG)","lang":"en","subjectScheme":"arXiv"},{"subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"},{"schemeUri":"http://www.oecd.org/science/inno/38235147.pdf","subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"}],"contributors":[],"dates":[{"date":"2026-06-14T06:50:28Z","dateType":"Submitted","dateInformation":"v1"},{"date":"2026-06-16T00:51:14Z","dateType":"Updated","dateInformation":"v1"},{"date":"2026-06-17T05:23:30Z","dateType":"Submitted","dateInformation":"v2"},{"date":"2026-06-18T00:27:32Z","dateType":"Updated","dateInformation":"v2"},{"date":"2026-06","dateType":"Available","dateInformation":"v1"},{"date":"2026","dateType":"Issued"}],"language":null,"types":{"schemaOrg":"CreativeWork","resourceTypeGeneral":"Preprint","citeproc":"article","bibtex":"misc","ris":"GEN","resourceType":"Article"},"relatedIdentifiers":[],"relatedItems":[],"sizes":[],"formats":[],"version":"2","rightsList":[{"rightsIdentifierScheme":"SPDX","rightsUri":"https://creativecommons.org/licenses/by/4.0/legalcode","schemeUri":"https://spdx.org/licenses/","rights":"Creative Commons Attribution 4.0 International","rightsIdentifier":"cc-by-4.0"}],"descriptions":[{"descriptionType":"Abstract","description":"Large Language Models (LLMs) have shown promise for reasoning over Text-Attributed Graphs (TAGs). However, applying LLMs to graphs requires linearizing their structure into sequences, introducing distortion rooted in the graph bandwidth problem. While this distortion has been shown to degrade performance, it is often attributed to prompt design or model scale, leaving the underlying mechanism unclear. In this work, we show \\textit{how} rotary positional embeddings turn graph linearization into bandwidth-dependent attention decay, suppressing attention between graph-adjacent nodes that are forced far apart in the serialized sequence. This shifts the focus of LLM-based graph reasoning from prompt engineering and scaling toward correcting attention misalignment. Motivated by this analysis, we propose \\textbf{G}raph-\\textbf{a}ligned \\textbf{L}anguage \\textbf{A}ttention (\\textbf{GaLA}), a lightweight, inference-time modification for LLMs. GaLA biases attention toward graph-adjacent nodes while preserving the LLM's sequential inductive biases. Across TAG benchmarks, GaLA improves performance with negligible overhead, demonstrating that distortion is a correctable bottleneck in LLM-based graph reasoning."},{"descriptionType":"Other","description":"Accepted to KDD 2026"}],"geoLocations":[],"fundingReferences":[],"url":"https://arxiv.org/abs/2606.15633","contentUrl":null,"metadataVersion":1,"schemaVersion":"http://datacite.org/schema/kernel-4","source":"mds","isActive":true,"state":"findable","reason":null,"viewCount":0,"downloadCount":0,"referenceCount":0,"citationCount":0,"partCount":0,"partOfCount":0,"versionCount":0,"versionOfCount":0,"created":"2026-06-16T03:28:01Z","registered":"2026-06-16T03:28:02Z","published":null,"updated":"2026-06-18T02:26:51Z"},"relationships":{"client":{"data":{"id":"arxiv.content","type":"clients"}}}},{"id":"10.48550/arxiv.2606.15531","type":"dois","attributes":{"doi":"10.48550/arxiv.2606.15531","identifiers":[{"identifier":"2606.15531","identifierType":"arXiv"}],"creators":[{"nameType":"Personal","givenName":"Bohdan","familyName":"Turbal","name":"Turbal, Bohdan","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Blossom","familyName":"Metevier","name":"Metevier, Blossom","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Max","familyName":"Springer","name":"Springer, Max","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Aleksandra","familyName":"Korolova","name":"Korolova, Aleksandra","affiliation":[],"nameIdentifiers":[]}],"titles":[{"title":"Greedy Coordinate Diffusion: Effective and Semantically Coherent Adversarial Attacks via Diffusion Guidance"}],"publisher":"arXiv","container":{},"publicationYear":2026,"subjects":[{"subject":"Machine Learning (cs.LG)","lang":"en","subjectScheme":"arXiv"},{"subject":"Cryptography and Security (cs.CR)","lang":"en","subjectScheme":"arXiv"},{"subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"},{"schemeUri":"http://www.oecd.org/science/inno/38235147.pdf","subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"}],"contributors":[],"dates":[{"date":"2026-06-14T01:18:53Z","dateType":"Submitted","dateInformation":"v1"},{"date":"2026-06-16T00:46:18Z","dateType":"Updated","dateInformation":"v1"},{"date":"2026-06-16T14:29:31Z","dateType":"Submitted","dateInformation":"v2"},{"date":"2026-06-17T00:57:57Z","dateType":"Updated","dateInformation":"v2"},{"date":"2026-06","dateType":"Available","dateInformation":"v1"},{"date":"2026","dateType":"Issued"}],"language":null,"types":{"schemaOrg":"CreativeWork","resourceTypeGeneral":"Preprint","citeproc":"article","bibtex":"misc","ris":"GEN","resourceType":"Article"},"relatedIdentifiers":[],"relatedItems":[],"sizes":[],"formats":[],"version":"2","rightsList":[{"rightsIdentifierScheme":"SPDX","rightsUri":"https://creativecommons.org/licenses/by/4.0/legalcode","schemeUri":"https://spdx.org/licenses/","rights":"Creative Commons Attribution 4.0 International","rightsIdentifier":"cc-by-4.0"}],"descriptions":[{"descriptionType":"Abstract","description":"Adversarial attacks on large language models have limited practical impact despite extensive research. Optimization-based attacks such as Greedy Coordinate Gradient (GCG) (Zou et al., 2023) produce high-perplexity, incoherent suffixes that existing defenses easily detect (Bengio et al., 2024).\n Moreover, attempting to enforce coherence constraints during optimization often prevents the attack from successfully eliciting the specific targeted response, resulting in low success rates against robust models. Conversely, attacks that maintain coherence often alter the semantic intent of queries; when the model complies with these altered queries, responses fail to address the adversary's original goal. In this work, we introduce Greedy Coordinate Diffusion (GCD), a novel framework that efficiently generates adversarial attacks against safety-aligned models while maintaining low perplexity and high semantic adherence to the adversary's original intent. GCD leverages the generative priors of discrete diffusion language models to guide the search for adversarial suffixes that achieve semantic coherence and adherence.\n Unlike GCG, GCD does not require direct gradient access, allowing it to operate in a gray-box setting. We show GCD achieves highest ASR while remaining competitive on response-quality scores, and that the constructed adversarial prompts are detected at lower rates than other methods by perplexity-based and guard-model filters."}],"geoLocations":[],"fundingReferences":[],"url":"https://arxiv.org/abs/2606.15531","contentUrl":null,"metadataVersion":1,"schemaVersion":"http://datacite.org/schema/kernel-4","source":"mds","isActive":true,"state":"findable","reason":null,"viewCount":0,"downloadCount":0,"referenceCount":0,"citationCount":0,"partCount":0,"partOfCount":0,"versionCount":0,"versionOfCount":0,"created":"2026-06-16T03:25:50Z","registered":"2026-06-16T03:25:51Z","published":null,"updated":"2026-06-17T02:28:44Z"},"relationships":{"client":{"data":{"id":"arxiv.content","type":"clients"}}}},{"id":"10.48550/arxiv.2606.15741","type":"dois","attributes":{"doi":"10.48550/arxiv.2606.15741","identifiers":[{"identifier":"2606.15741","identifierType":"arXiv"}],"creators":[{"nameType":"Personal","givenName":"Molham","familyName":"Mohamed","name":"Mohamed, Molham","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Ali","familyName":"Hamdi","name":"Hamdi, Ali","affiliation":[],"nameIdentifiers":[]}],"titles":[{"title":"A Self Consistency Based Reranking for Narrative Question Answering"}],"publisher":"arXiv","container":{},"publicationYear":2026,"subjects":[{"subject":"Computation and Language (cs.CL)","lang":"en","subjectScheme":"arXiv"},{"subject":"Artificial Intelligence (cs.AI)","lang":"en","subjectScheme":"arXiv"},{"subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"},{"schemeUri":"http://www.oecd.org/science/inno/38235147.pdf","subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"}],"contributors":[],"dates":[{"date":"2026-06-14T10:52:05Z","dateType":"Submitted","dateInformation":"v1"},{"date":"2026-06-16T00:55:53Z","dateType":"Updated","dateInformation":"v1"},{"date":"2026-06","dateType":"Available","dateInformation":"v1"},{"date":"2026","dateType":"Issued"}],"language":null,"types":{"schemaOrg":"CreativeWork","resourceTypeGeneral":"Preprint","citeproc":"article","bibtex":"misc","ris":"GEN","resourceType":"Article"},"relatedIdentifiers":[],"relatedItems":[],"sizes":[],"formats":[],"version":"1","rightsList":[{"rightsUri":"http://arxiv.org/licenses/nonexclusive-distrib/1.0/","rights":"arXiv.org perpetual, non-exclusive license"}],"descriptions":[{"descriptionType":"Abstract","description":"Narrative question answering (NQA) is a challenging task in natural language processing that requires models to understand long textual contexts, capture relationships across events, and generate coherent responses. Despite recent advances in pretrained language models, most existing approaches rely on a single decoding output during inference, making them sensitive to generation variability and often resulting in incomplete or inconsistent answers .To address this limitation, we propose a self-ensemble Self-Consistency-Based reranking framework for narrative question answering. The proposed method generates multiple candidate answers for each story-question pair and selects the final answer based on semantic agreement among the generated responses. This allows the model to explore diverse answer formulations while improving robustness through consensus-based selection without requiring modifications to the underlying architecture .The framework combines pretrained and fine-tuned language generation with multi-answer inference and similarity-based reranking. We evaluate the proposed approach on the NarrativeQA dataset using multiple models, including FLAN-T5 (Base and Small) and Pegasus-Large, under both baseline and fine-tuned settings .Experimental results demonstrate that the proposed method consistently improves performance across all models. In particular, FLAN-T5-Base achieves the best overall performance, improving from 82.32% to 86.66% (+4.34%) when combined with self-ensemble inference. Additionally, the largest improvement is observed with Pegasus-Large, which increases from 72.50% to 87.07% (+14.57%), highlighting the effectiveness of the proposed strategy."}],"geoLocations":[],"fundingReferences":[],"url":"https://arxiv.org/abs/2606.15741","contentUrl":null,"metadataVersion":0,"schemaVersion":"http://datacite.org/schema/kernel-4","source":"mds","isActive":true,"state":"findable","reason":null,"viewCount":0,"downloadCount":0,"referenceCount":0,"citationCount":0,"partCount":0,"partOfCount":0,"versionCount":0,"versionOfCount":0,"created":"2026-06-16T03:30:19Z","registered":"2026-06-16T03:30:19Z","published":null,"updated":"2026-06-16T03:30:19Z"},"relationships":{"client":{"data":{"id":"arxiv.content","type":"clients"}}}},{"id":"10.48550/arxiv.2606.15733","type":"dois","attributes":{"doi":"10.48550/arxiv.2606.15733","identifiers":[{"identifier":"2606.15733","identifierType":"arXiv"}],"creators":[{"nameType":"Personal","givenName":"Zhenyu","familyName":"Yu","name":"Yu, Zhenyu","affiliation":[],"nameIdentifiers":[]}],"titles":[{"title":"Vernier: Probing Representational Misalignment Behind Lexical Gaps in Causal Reasoning"}],"publisher":"arXiv","container":{},"publicationYear":2026,"subjects":[{"subject":"Computation and Language (cs.CL)","lang":"en","subjectScheme":"arXiv"},{"subject":"Artificial Intelligence (cs.AI)","lang":"en","subjectScheme":"arXiv"},{"subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"},{"schemeUri":"http://www.oecd.org/science/inno/38235147.pdf","subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"}],"contributors":[],"dates":[{"date":"2026-06-14T10:29:37Z","dateType":"Submitted","dateInformation":"v1"},{"date":"2026-06-16T00:55:38Z","dateType":"Updated","dateInformation":"v1"},{"date":"2026-06","dateType":"Available","dateInformation":"v1"},{"date":"2026","dateType":"Issued"}],"language":null,"types":{"schemaOrg":"CreativeWork","resourceTypeGeneral":"Preprint","citeproc":"article","bibtex":"misc","ris":"GEN","resourceType":"Article"},"relatedIdentifiers":[],"relatedItems":[],"sizes":[],"formats":[],"version":"1","rightsList":[{"rightsUri":"http://arxiv.org/licenses/nonexclusive-distrib/1.0/","rights":"arXiv.org perpetual, non-exclusive license"}],"descriptions":[{"descriptionType":"Abstract","description":"Instruction-tuned language models can answer the same causal-reasoning question differently after its English variable names are replaced by type-preserving placeholders, although the structural causal model and the gold answer are unchanged. We ask whether this lexical gap reflects information loss in the placeholder view or a misaligned read-out from a representation that still carries answer-relevant content. Vernier uses a paired-view weight update as an instrument and then inspects the mechanism left after the gap closes. In the working regimes, the evidence favours representational misalignment. A variable-name probe becomes more accurate on the placeholder view, and activation patching on Qwen-7B, Qwen-14B, and Llama-3.1-8B shows that the decision-token representation can transfer answer identity between views. The update that realigns the views is counterfactual augmentation over original and placeholder prompts, while the answer-subspace KL mainly sharpens intermediate answer-belief agreement. Success is bounded by model family, scale, and task. CRASS transfer is reliable across Qwen scales and Llama, e-CARE remains weak, and preliminary non-causal rename tasks show a similar qualitative pattern."}],"geoLocations":[],"fundingReferences":[],"url":"https://arxiv.org/abs/2606.15733","contentUrl":null,"metadataVersion":0,"schemaVersion":"http://datacite.org/schema/kernel-4","source":"mds","isActive":true,"state":"findable","reason":null,"viewCount":0,"downloadCount":0,"referenceCount":0,"citationCount":0,"partCount":0,"partOfCount":0,"versionCount":0,"versionOfCount":0,"created":"2026-06-16T03:30:08Z","registered":"2026-06-16T03:30:09Z","published":null,"updated":"2026-06-16T03:30:09Z"},"relationships":{"client":{"data":{"id":"arxiv.content","type":"clients"}}}},{"id":"10.48550/arxiv.2606.15716","type":"dois","attributes":{"doi":"10.48550/arxiv.2606.15716","identifiers":[{"identifier":"2606.15716","identifierType":"arXiv"}],"creators":[{"nameType":"Personal","givenName":"Zongfang","familyName":"Liu","name":"Liu, Zongfang","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Jinghui","familyName":"Zhang","name":"Zhang, Jinghui","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Zijian","familyName":"Ma","name":"Ma, Zijian","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Guangyi","familyName":"Chen","name":"Chen, Guangyi","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Xin","familyName":"Yuan","name":"Yuan, Xin","affiliation":[],"nameIdentifiers":[]}],"titles":[{"title":"How to Score Experts for One-Shot MoE Expert Pruning: A Unified Formulation and Selection Principle"}],"publisher":"arXiv","container":{},"publicationYear":2026,"subjects":[{"subject":"Machine Learning (cs.LG)","lang":"en","subjectScheme":"arXiv"},{"subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"},{"schemeUri":"http://www.oecd.org/science/inno/38235147.pdf","subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"}],"contributors":[],"dates":[{"date":"2026-06-14T10:07:49Z","dateType":"Submitted","dateInformation":"v1"},{"date":"2026-06-16T00:55:13Z","dateType":"Updated","dateInformation":"v1"},{"date":"2026-06","dateType":"Available","dateInformation":"v1"},{"date":"2026","dateType":"Issued"}],"language":null,"types":{"schemaOrg":"CreativeWork","resourceTypeGeneral":"Preprint","citeproc":"article","bibtex":"misc","ris":"GEN","resourceType":"Article"},"relatedIdentifiers":[],"relatedItems":[],"sizes":[],"formats":[],"version":"1","rightsList":[{"rightsUri":"http://arxiv.org/licenses/nonexclusive-distrib/1.0/","rights":"arXiv.org perpetual, non-exclusive license"}],"descriptions":[{"descriptionType":"Abstract","description":"Mixture-of-Experts (MoE) language models reduce per-token computation through sparse expert activation, yet deployment still requires storing the full expert pool, making one-shot expert pruning a practical approach for reducing memory usage. Although effective, existing criteria are largely heuristic, and no single criterion is universally optimal. Thus, establishing a principle for selecting pruning criteria suited to different deployment objectives remains an important yet largely underexplored problem in one-shot expert pruning. To this end, we introduce a unified formulation for one-shot MoE expert pruning organized around three factors: routing frequency, gate weighting, and activation strength. The formulation yields a criteria selection principle: task-agnostic pruning should favor routed-token-averaged, gate-free activation-based criteria, whereas task-specific pruning can benefit from retaining routing-frequency and gate-weight information. Beyond this principle, the formulation also provides a systematic view of existing heuristic criteria and gives rise to two new task-agnostic criteria, Mean Activation Norm (MAN) and Mean Squared Activation Norm (MSAN). Across four representative MoE models and 16 diverse benchmarks, MAN and MSAN are consistently strong in the task-agnostic setting, obtain the top-two average ranks, and improve average performance by up to 8.8 points over the strongest baseline."}],"geoLocations":[],"fundingReferences":[],"url":"https://arxiv.org/abs/2606.15716","contentUrl":null,"metadataVersion":0,"schemaVersion":"http://datacite.org/schema/kernel-4","source":"mds","isActive":true,"state":"findable","reason":null,"viewCount":0,"downloadCount":0,"referenceCount":0,"citationCount":0,"partCount":0,"partOfCount":0,"versionCount":0,"versionOfCount":0,"created":"2026-06-16T03:29:46Z","registered":"2026-06-16T03:29:47Z","published":null,"updated":"2026-06-16T03:29:47Z"},"relationships":{"client":{"data":{"id":"arxiv.content","type":"clients"}}}},{"id":"10.48550/arxiv.2606.15714","type":"dois","attributes":{"doi":"10.48550/arxiv.2606.15714","identifiers":[{"identifier":"2606.15714","identifierType":"arXiv"}],"creators":[{"nameType":"Personal","givenName":"Hanyang","familyName":"Chen","name":"Chen, Hanyang","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Hongliang","familyName":"Li","name":"Li, Hongliang","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Jiarui","familyName":"Cao","name":"Cao, Jiarui","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Yang","familyName":"Li","name":"Li, Yang","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Yang","familyName":"Jiang","name":"Jiang, Yang","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Haonan","familyName":"Wen","name":"Wen, Haonan","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Kaiyu","familyName":"Huang","name":"Huang, Kaiyu","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Shengnan","familyName":"Guo","name":"Guo, Shengnan","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Huaiyu","familyName":"Wan","name":"Wan, Huaiyu","affiliation":[],"nameIdentifiers":[]}],"titles":[{"title":"Beyond English: Uncovering the Multilingual Gap in Vision-Language-Action Models"}],"publisher":"arXiv","container":{},"publicationYear":2026,"subjects":[{"subject":"Computation and Language (cs.CL)","lang":"en","subjectScheme":"arXiv"},{"subject":"Robotics (cs.RO)","lang":"en","subjectScheme":"arXiv"},{"subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"},{"schemeUri":"http://www.oecd.org/science/inno/38235147.pdf","subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"}],"contributors":[],"dates":[{"date":"2026-06-14T10:04:08Z","dateType":"Submitted","dateInformation":"v1"},{"date":"2026-06-16T00:55:07Z","dateType":"Updated","dateInformation":"v1"},{"date":"2026-06","dateType":"Available","dateInformation":"v1"},{"date":"2026","dateType":"Issued"}],"language":null,"types":{"schemaOrg":"CreativeWork","resourceTypeGeneral":"Preprint","citeproc":"article","bibtex":"misc","ris":"GEN","resourceType":"Article"},"relatedIdentifiers":[],"relatedItems":[],"sizes":[],"formats":[],"version":"1","rightsList":[{"rightsIdentifierScheme":"SPDX","rightsUri":"https://creativecommons.org/licenses/by/4.0/legalcode","schemeUri":"https://spdx.org/licenses/","rights":"Creative Commons Attribution 4.0 International","rightsIdentifier":"cc-by-4.0"}],"descriptions":[{"descriptionType":"Abstract","description":"Vision-Language-Action models have recently demonstrated promising capabilities in learning generalist robot policies from large-scale multimodal data. However, most existing VLA systems are trained and evaluated primarily with English instructions, leaving their ability to understand and execute instructions in other languages largely unexplored. While the underlying large language models often possess multilingual capabilities, it remains unclear whether these multilingual capabilities transfer to VLAs during training. In this work, we present the first systematic study of multilingual instruction following in VLA models. We first construct multilingual instructions by extending existing benchmarks with translations of their instructions. Using these instructions, we evaluate several representative VLA models across a range of tasks in simulation settings. Our experiments reveal a significant multilingual gap: models trained primarily on English instructions exhibit substantial performance degradation when evaluated on other languages, even when the underlying language backbone is multilingual. We provide several findings and analyses to understand the multilingual gap. Cross-lingual transfer behavior analysis shows that performance drops correlate with both instruction understanding and action execution. Representation analyses suggest that multilingual instruction-caused representation shifts may contribute to the multilingual gap. Motivated by these findings, we further explore strategies to improve multilingual performance in VLAs. We propose a simple yet effective multilingual fine-tuning approach, Multilingual Principal Component Alignment, which leverages Principal Component Analysis to get the principal component subspace and align projected multilingual representations, effectively reducing the multilingual performance gap."}],"geoLocations":[],"fundingReferences":[],"url":"https://arxiv.org/abs/2606.15714","contentUrl":null,"metadataVersion":0,"schemaVersion":"http://datacite.org/schema/kernel-4","source":"mds","isActive":true,"state":"findable","reason":null,"viewCount":0,"downloadCount":0,"referenceCount":0,"citationCount":0,"partCount":0,"partOfCount":0,"versionCount":0,"versionOfCount":0,"created":"2026-06-16T03:29:44Z","registered":"2026-06-16T03:29:44Z","published":null,"updated":"2026-06-16T03:29:44Z"},"relationships":{"client":{"data":{"id":"arxiv.content","type":"clients"}}}},{"id":"10.48550/arxiv.2606.15701","type":"dois","attributes":{"doi":"10.48550/arxiv.2606.15701","identifiers":[{"identifier":"2606.15701","identifierType":"arXiv"}],"creators":[{"nameType":"Personal","givenName":"Tien Thanh","familyName":"Thach","name":"Thach, Tien Thanh","affiliation":[],"nameIdentifiers":[]}],"titles":[{"title":"Robust Transformer-Based One-Step Stock Index Forecasting via Shifted Data Augmentation"}],"publisher":"arXiv","container":{},"publicationYear":2026,"subjects":[{"subject":"Machine Learning (cs.LG)","lang":"en","subjectScheme":"arXiv"},{"subject":"Statistical Finance (q-fin.ST)","lang":"en","subjectScheme":"arXiv"},{"subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"},{"schemeUri":"http://www.oecd.org/science/inno/38235147.pdf","subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"},{"subject":"FOS: Economics and business","subjectScheme":"Fields of Science and Technology (FOS)"},{"schemeUri":"http://www.oecd.org/science/inno/38235147.pdf","subject":"FOS: Economics and business","subjectScheme":"Fields of Science and Technology (FOS)"}],"contributors":[],"dates":[{"date":"2026-06-14T09:30:41Z","dateType":"Submitted","dateInformation":"v1"},{"date":"2026-06-16T00:54:34Z","dateType":"Updated","dateInformation":"v1"},{"date":"2026-06","dateType":"Available","dateInformation":"v1"},{"date":"2026","dateType":"Issued"}],"language":null,"types":{"schemaOrg":"CreativeWork","resourceTypeGeneral":"Preprint","citeproc":"article","bibtex":"misc","ris":"GEN","resourceType":"Article"},"relatedIdentifiers":[],"relatedItems":[],"sizes":[],"formats":[],"version":"1","rightsList":[{"rightsUri":"http://arxiv.org/licenses/nonexclusive-distrib/1.0/","rights":"arXiv.org perpetual, non-exclusive license"}],"descriptions":[{"descriptionType":"Abstract","description":"Transformers have shown remarkable success in sequence modeling, yet their direct application to financial time series remains challenging due to noisy signals, short-memory dynamics, and distributional shifts. This paper proposes a modified Transformer architecture for one-step stock index forecasting, combined with advanced learning-rate scheduling and a novel Shifted Data Augmentation (SDA) technique. We evaluate the proposed framework on two benchmark stock index datasets, VN30 and S\u0026amp;P 500. Experimental results demonstrate that cosine annealing with warmup consistently improves forecasting accuracy over the generalized inverse-power scheduler. Furthermore, SDA substantially reduces forecasting errors and run-to-run variability while improving robustness to hyperparameter selection. The combination of cosine annealing scheduling and SDA achieved the best performance on both datasets, indicating that data augmentation can play a more important role than increasing model complexity in Transformer-based financial forecasting. These findings provide a practical and computationally efficient approach for robust stock index forecasting in noisy financial environments."}],"geoLocations":[],"fundingReferences":[],"url":"https://arxiv.org/abs/2606.15701","contentUrl":null,"metadataVersion":0,"schemaVersion":"http://datacite.org/schema/kernel-4","source":"mds","isActive":true,"state":"findable","reason":null,"viewCount":0,"downloadCount":0,"referenceCount":0,"citationCount":0,"partCount":0,"partOfCount":0,"versionCount":0,"versionOfCount":0,"created":"2026-06-16T03:29:27Z","registered":"2026-06-16T03:29:27Z","published":null,"updated":"2026-06-16T03:29:27Z"},"relationships":{"client":{"data":{"id":"arxiv.content","type":"clients"}}}},{"id":"10.48550/arxiv.2606.15695","type":"dois","attributes":{"doi":"10.48550/arxiv.2606.15695","identifiers":[{"identifier":"2606.15695","identifierType":"arXiv"}],"creators":[{"nameType":"Personal","givenName":"Thinh T. H.","familyName":"Nguyen","name":"Nguyen, Thinh T. H.","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Khoa D.","familyName":"Doan","name":"Doan, Khoa D.","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Binh T.","familyName":"Nguyen","name":"Nguyen, Binh T.","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Danh","familyName":"Le-Phuoc","name":"Le-Phuoc, Danh","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Kok-Seng","familyName":"Wong","name":"Wong, Kok-Seng","affiliation":[],"nameIdentifiers":[]}],"titles":[{"title":"When Generator Replay Degrades: Projected Rehearsal Orchestration for Heterogeneous Federated Class-Incremental Learning"}],"publisher":"arXiv","container":{},"publicationYear":2026,"subjects":[{"subject":"Machine Learning (cs.LG)","lang":"en","subjectScheme":"arXiv"},{"subject":"Artificial Intelligence (cs.AI)","lang":"en","subjectScheme":"arXiv"},{"subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"},{"schemeUri":"http://www.oecd.org/science/inno/38235147.pdf","subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"},{"subject":"I.2.6; I.2.11; C.2.4","lang":"en","subjectScheme":"ACM"},{"subject":"68T05 (Primary), 68T07, 68M14 (Secondary)","lang":"en","subjectScheme":"MSC"}],"contributors":[],"dates":[{"date":"2026-06-14T09:17:52Z","dateType":"Submitted","dateInformation":"v1"},{"date":"2026-06-16T00:54:22Z","dateType":"Updated","dateInformation":"v1"},{"date":"2026-06","dateType":"Available","dateInformation":"v1"},{"date":"2026","dateType":"Issued"}],"language":null,"types":{"schemaOrg":"CreativeWork","resourceTypeGeneral":"Preprint","citeproc":"article","bibtex":"misc","ris":"GEN","resourceType":"Article"},"relatedIdentifiers":[],"relatedItems":[],"sizes":[],"formats":[],"version":"1","rightsList":[{"rightsIdentifierScheme":"SPDX","rightsUri":"https://creativecommons.org/licenses/by/4.0/legalcode","schemeUri":"https://spdx.org/licenses/","rights":"Creative Commons Attribution 4.0 International","rightsIdentifier":"cc-by-4.0"}],"descriptions":[{"descriptionType":"Abstract","description":"Federated class-incremental learning (FCIL) becomes substantially harder when clients observe different label subsets, progress through tasks at different stages, and provide uneven supervision for the same semantic concepts. Existing FCIL methods often preserve old knowledge through input-space synthesis, but they can be fragile under heterogeneous task streams and difficult to transfer across modalities. To alleviate such issues, we propose PRO, a framework that replaces synthetic input replay with projected rehearsal orchestration. To remove external pretraining, we evaluate all methods under the same warmup. After this, PRO maintains compact class-level projected memories on the server and allows clients perform balanced pseudo multi-task training over current examples and old projected memories. To handle stronger representation drift, we further introduce PRO-MAX, which augments PRO with neighborhood-weighted memory alignment while preserving the same server-light principle that the server only aggregates model updates and memory statistics. Across image, text, and graph benchmarks, PRO and PRO-MAX improve retention and final utility under heterogeneous streams while remaining competitive in homogeneous FCIL. Even when baselines are given expanded replay budgets, they degrade under supervision imbalance and stage misalignment, indicating that replay quantity alone does not resolve replay-quality failures. Additional weak-task diagnostics further show that larger replay mismatch is associated with larger downstream degradation, while our method keeps projected memories better aligned with the evolving representation."},{"descriptionType":"Other","description":"46 pages"}],"geoLocations":[],"fundingReferences":[],"url":"https://arxiv.org/abs/2606.15695","contentUrl":null,"metadataVersion":0,"schemaVersion":"http://datacite.org/schema/kernel-4","source":"mds","isActive":true,"state":"findable","reason":null,"viewCount":0,"downloadCount":0,"referenceCount":0,"citationCount":0,"partCount":0,"partOfCount":0,"versionCount":0,"versionOfCount":0,"created":"2026-06-16T03:29:19Z","registered":"2026-06-16T03:29:20Z","published":null,"updated":"2026-06-16T03:29:20Z"},"relationships":{"client":{"data":{"id":"arxiv.content","type":"clients"}}}},{"id":"10.48550/arxiv.2606.15690","type":"dois","attributes":{"doi":"10.48550/arxiv.2606.15690","identifiers":[{"identifier":"2606.15690","identifierType":"arXiv"}],"creators":[{"nameType":"Personal","givenName":"Filippo","familyName":"Zacchei","name":"Zacchei, Filippo","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Ana","familyName":"Larrañaga","name":"Larrañaga, Ana","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Attilio","familyName":"Frangi","name":"Frangi, Attilio","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Andrea","familyName":"Manzoni","name":"Manzoni, Andrea","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Steven L.","familyName":"Brunton","name":"Brunton, Steven L.","affiliation":[],"nameIdentifiers":[]}],"titles":[{"title":"Multi-Fidelity SINDy: Sparse Discovery of Nonlinear Dynamical Systems with Fidelity-Weighted Measurements"}],"publisher":"arXiv","container":{},"publicationYear":2026,"subjects":[{"subject":"Machine Learning (cs.LG)","lang":"en","subjectScheme":"arXiv"},{"subject":"Dynamical Systems (math.DS)","lang":"en","subjectScheme":"arXiv"},{"subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"},{"schemeUri":"http://www.oecd.org/science/inno/38235147.pdf","subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"},{"subject":"FOS: Mathematics","subjectScheme":"Fields of Science and Technology (FOS)"},{"schemeUri":"http://www.oecd.org/science/inno/38235147.pdf","subject":"FOS: Mathematics","subjectScheme":"Fields of Science and Technology (FOS)"}],"contributors":[],"dates":[{"date":"2026-06-14T09:10:00Z","dateType":"Submitted","dateInformation":"v1"},{"date":"2026-06-16T00:54:09Z","dateType":"Updated","dateInformation":"v1"},{"date":"2026-06","dateType":"Available","dateInformation":"v1"},{"date":"2026","dateType":"Issued"}],"language":null,"types":{"schemaOrg":"CreativeWork","resourceTypeGeneral":"Preprint","citeproc":"article","bibtex":"misc","ris":"GEN","resourceType":"Article"},"relatedIdentifiers":[],"relatedItems":[],"sizes":[],"formats":[],"version":"1","rightsList":[{"rightsUri":"http://arxiv.org/licenses/nonexclusive-distrib/1.0/","rights":"arXiv.org perpetual, non-exclusive license"}],"descriptions":[{"descriptionType":"Abstract","description":"Data from simulations and experiments are rarely noise-free and often exhibit heterogeneous levels of fidelity. Measurement uncertainty may vary across repeated observations, sensing devices, or even within a single experiment. This work addresses the problem of discovering nonlinear dynamical systems from such inhomogeneous data. We extend the Sparse Identification of Nonlinear Dynamical Systems (SINDy) framework to account for variable noise levels by combining Ensemble SINDy and Weak SINDy within a weighted regression formulation derived from generalized least squares. A statistical justification for the weighting strategy is also provided. The methodology is validated on several benchmark systems, including ordinary and partial differential equations. In addition, we show the benefit of multi-fidelity integration for forecasting the dynamics of a double pendulum system. The results confirm that the proposed approach mitigates the adverse effects of heteroscedastic noise and that repeated, low-cost, low-quality measurements can improve model recovery, in some cases matching or outperforming reconstructions obtained using only high-fidelity data."},{"descriptionType":"Other","description":"27 pages, 6 figures, 2 tables"}],"geoLocations":[],"fundingReferences":[],"url":"https://arxiv.org/abs/2606.15690","contentUrl":null,"metadataVersion":0,"schemaVersion":"http://datacite.org/schema/kernel-4","source":"mds","isActive":true,"state":"findable","reason":null,"viewCount":0,"downloadCount":0,"referenceCount":0,"citationCount":0,"partCount":0,"partOfCount":0,"versionCount":0,"versionOfCount":0,"created":"2026-06-16T03:29:13Z","registered":"2026-06-16T03:29:14Z","published":null,"updated":"2026-06-16T03:29:14Z"},"relationships":{"client":{"data":{"id":"arxiv.content","type":"clients"}}}},{"id":"10.48550/arxiv.2606.15682","type":"dois","attributes":{"doi":"10.48550/arxiv.2606.15682","identifiers":[{"identifier":"2606.15682","identifierType":"arXiv"}],"creators":[{"nameType":"Personal","givenName":"Janghwan","familyName":"Lee","name":"Lee, Janghwan","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Sihwa","familyName":"Lee","name":"Lee, Sihwa","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Jinseok","familyName":"Kim","name":"Kim, Jinseok","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Yongjik","familyName":"Kim","name":"Kim, Yongjik","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Jieun","familyName":"Lim","name":"Lim, Jieun","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Jinwook","familyName":"Oh","name":"Oh, Jinwook","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Jungwook","familyName":"Choi","name":"Choi, Jungwook","affiliation":[],"nameIdentifiers":[]}],"titles":[{"title":"ReQAT: Achieving Full-Precision Reasoning Accuracy with 4-bit Floating-Point Quantization-Aware Training"}],"publisher":"arXiv","container":{},"publicationYear":2026,"subjects":[{"subject":"Machine Learning (cs.LG)","lang":"en","subjectScheme":"arXiv"},{"subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"},{"schemeUri":"http://www.oecd.org/science/inno/38235147.pdf","subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"}],"contributors":[],"dates":[{"date":"2026-06-14T09:00:06Z","dateType":"Submitted","dateInformation":"v1"},{"date":"2026-06-16T00:53:51Z","dateType":"Updated","dateInformation":"v1"},{"date":"2026-06","dateType":"Available","dateInformation":"v1"},{"date":"2026","dateType":"Issued"}],"language":null,"types":{"schemaOrg":"CreativeWork","resourceTypeGeneral":"Preprint","citeproc":"article","bibtex":"misc","ris":"GEN","resourceType":"Article"},"relatedIdentifiers":[],"relatedItems":[],"sizes":[],"formats":[],"version":"1","rightsList":[{"rightsUri":"http://arxiv.org/licenses/nonexclusive-distrib/1.0/","rights":"arXiv.org perpetual, non-exclusive license"}],"descriptions":[{"descriptionType":"Abstract","description":"Large Reasoning Models (LRMs) achieve strong problem-solving through long chain-of-thought, but their deployment is constrained by the high cost of full-precision inference and growing KV cache footprints. Microscaled FP4 formats enable efficient FP4 deployment; however, fully quantizing weights, activations, and KV caches (W4A4KV4) causes severe reasoning degradation that existing PTQ and QAT fail to recover. We identify that FP4 failures concentrate on low-entropy tokens--precise symbolic commitments such as digits and operators--where quantization noise inflates sampling errors that cascade through reasoning traces. Based on this insight, we propose ReQAT, a reasoning-centric FP4 training framework with three components: (i) Trace-Aligned QAT (TAQ), which revisits identical reasoning traces to focus updates on critical low-entropy decisions; (ii) Selective Entropy Minimization (SEM), which reinforces confidence at low-entropy positions; and (iii) Q-FIT, a quantization-friendly initialization that jointly calibrates RoPE-consistent KV cache transformations to stabilize QAT. Under the same training budget, ReQAT not only recovers but surpasses BF16 fine-tuning accuracy, while delivering up to 3.9x throughput speedup on NVIDIA DGX Spark and 3.1x on B200."},{"descriptionType":"Other","description":"ICML 2026"}],"geoLocations":[],"fundingReferences":[],"url":"https://arxiv.org/abs/2606.15682","contentUrl":null,"metadataVersion":0,"schemaVersion":"http://datacite.org/schema/kernel-4","source":"mds","isActive":true,"state":"findable","reason":null,"viewCount":0,"downloadCount":0,"referenceCount":0,"citationCount":0,"partCount":0,"partOfCount":0,"versionCount":0,"versionOfCount":0,"created":"2026-06-16T03:29:03Z","registered":"2026-06-16T03:29:03Z","published":null,"updated":"2026-06-16T03:29:03Z"},"relationships":{"client":{"data":{"id":"arxiv.content","type":"clients"}}}},{"id":"10.48550/arxiv.2606.15669","type":"dois","attributes":{"doi":"10.48550/arxiv.2606.15669","identifiers":[{"identifier":"2606.15669","identifierType":"arXiv"}],"creators":[{"nameType":"Personal","givenName":"Sungwoo","familyName":"Goo","name":"Goo, Sungwoo","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Hwi-yeol","familyName":"Yun","name":"Yun, Hwi-yeol","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Sangkeun","familyName":"Jung","name":"Jung, Sangkeun","affiliation":[],"nameIdentifiers":[]}],"titles":[{"title":"Z-Plane Neural Networks: Bounded Geometric Activation Replaces ReLU and LayerNorm"}],"publisher":"arXiv","container":{},"publicationYear":2026,"subjects":[{"subject":"Machine Learning (cs.LG)","lang":"en","subjectScheme":"arXiv"},{"subject":"Artificial Intelligence (cs.AI)","lang":"en","subjectScheme":"arXiv"},{"subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"},{"schemeUri":"http://www.oecd.org/science/inno/38235147.pdf","subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"}],"contributors":[],"dates":[{"date":"2026-06-14T08:22:28Z","dateType":"Submitted","dateInformation":"v1"},{"date":"2026-06-16T00:52:54Z","dateType":"Updated","dateInformation":"v1"},{"date":"2026-06","dateType":"Available","dateInformation":"v1"},{"date":"2026","dateType":"Issued"}],"language":null,"types":{"schemaOrg":"CreativeWork","resourceTypeGeneral":"Preprint","citeproc":"article","bibtex":"misc","ris":"GEN","resourceType":"Article"},"relatedIdentifiers":[],"relatedItems":[],"sizes":[],"formats":[],"version":"1","rightsList":[{"rightsIdentifierScheme":"SPDX","rightsUri":"https://creativecommons.org/licenses/by/4.0/legalcode","schemeUri":"https://spdx.org/licenses/","rights":"Creative Commons Attribution 4.0 International","rightsIdentifier":"cc-by-4.0"}],"descriptions":[{"descriptionType":"Abstract","description":"Modern deep neural networks rely on Euclidean scalar activations (e.g., ReLU) and global normalization techniques (e.g., LayerNorm) to prevent gradient instability in deep architectures. However, these mechanisms inherently cause dead neurons, discard critical directional information, and destroy the orthogonality of feature representations. Inspired by the frequency-modulation transmission of biological axons, we propose the Z-Plane Neural Network, which maps hidden states into 2D phasor bundles on a hypersphere. We introduce a novel geometric activation function, Radial Bounding($\\mathbf{x} / \\max(1, \\|\\mathbf{x}\\|_2)$), which limits the energy magnitude while preserving the phase (direction). We demonstrate mathematically that this isotropic activation maintains 1-Lipschitz continuity and prevents gradient vanishing by preserving tangential gradients. Empirically, a 100-layer Z-Plane Multi-Layer Perceptron (MLP)-entirely devoid of ReLU and LayerNorm-successfully converges on the MNIST dataset with 98.34% accuracy and absolute numerical stability, proving that bounded geometric activation alone is sufficient for stable deep learning."}],"geoLocations":[],"fundingReferences":[],"url":"https://arxiv.org/abs/2606.15669","contentUrl":null,"metadataVersion":0,"schemaVersion":"http://datacite.org/schema/kernel-4","source":"mds","isActive":true,"state":"findable","reason":null,"viewCount":0,"downloadCount":0,"referenceCount":0,"citationCount":0,"partCount":0,"partOfCount":0,"versionCount":0,"versionOfCount":0,"created":"2026-06-16T03:28:46Z","registered":"2026-06-16T03:28:47Z","published":null,"updated":"2026-06-16T03:28:47Z"},"relationships":{"client":{"data":{"id":"arxiv.content","type":"clients"}}}},{"id":"10.48550/arxiv.2606.15652","type":"dois","attributes":{"doi":"10.48550/arxiv.2606.15652","identifiers":[{"identifier":"2606.15652","identifierType":"arXiv"}],"creators":[{"nameType":"Personal","givenName":"Yangjia","familyName":"Hu","name":"Hu, Yangjia","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Haodong","familyName":"Wang","name":"Wang, Haodong","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Zicong","familyName":"Hong","name":"Hong, Zicong","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Qianli","familyName":"Liu","name":"Liu, Qianli","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Quanxin","familyName":"Shou","name":"Shou, Quanxin","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Jian","familyName":"Lin","name":"Lin, Jian","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Song","familyName":"Guo","name":"Guo, Song","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Xiaowei","familyName":"Shen","name":"Shen, Xiaowei","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Xiangjun","familyName":"Huang","name":"Huang, Xiangjun","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Dian","familyName":"Wang","name":"Wang, Dian","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Jian","familyName":"Yang","name":"Yang, Jian","affiliation":[],"nameIdentifiers":[]}],"titles":[{"title":"MosaicQuant: Inlier-Outlier Disaggregation for Unified 4-Bit LLM Quantization"}],"publisher":"arXiv","container":{},"publicationYear":2026,"subjects":[{"subject":"Machine Learning (cs.LG)","lang":"en","subjectScheme":"arXiv"},{"subject":"Computation and Language (cs.CL)","lang":"en","subjectScheme":"arXiv"},{"subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"},{"schemeUri":"http://www.oecd.org/science/inno/38235147.pdf","subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"}],"contributors":[],"dates":[{"date":"2026-06-14T07:43:43Z","dateType":"Submitted","dateInformation":"v1"},{"date":"2026-06-16T00:52:10Z","dateType":"Updated","dateInformation":"v1"},{"date":"2026-06","dateType":"Available","dateInformation":"v1"},{"date":"2026","dateType":"Issued"}],"language":null,"types":{"schemaOrg":"CreativeWork","resourceTypeGeneral":"Preprint","citeproc":"article","bibtex":"misc","ris":"GEN","resourceType":"Article"},"relatedIdentifiers":[],"relatedItems":[],"sizes":[],"formats":[],"version":"1","rightsList":[{"rightsIdentifierScheme":"SPDX","rightsUri":"https://creativecommons.org/licenses/by/4.0/legalcode","schemeUri":"https://spdx.org/licenses/","rights":"Creative Commons Attribution 4.0 International","rightsIdentifier":"cc-by-4.0"}],"descriptions":[{"descriptionType":"Abstract","description":"4-bit quantization significantly reduces the memory footprint and accelerates the inference of large language models (LLMs). However, its limited bit-width representation struggles to faithfully capture both dense common values (\\emph{inliers}) and rare large-magnitude values (\\emph{outliers}), causing substantial accuracy degradation. Existing mixed-precision methods mitigate this by retaining outliers in high precision, but at the cost of breaking the uniformity of low-bit execution, introducing precision conversion and extra data movement that undermine practical speedup. We propose \\textbf{MosaicQuant}, a unified 4-bit LLM quantization paradigm built on a novel principle of \\emph{inlier--outlier disaggregation}. Rather than elevating outlier precision, MosaicQuant quantizes the full weight matrix into a dense 4-bit base component, where inliers are captured faithfully while outlier are inevitably quantized. A sparse 4-bit residual component is then introduced to compensate for these quantization errors, selectively targeting the most error-critical weight blocks where output distortion is shown to be concentrated. However, a unified representation alone is insufficient, as naïvely executing the sparse residual as a separate kernel still breaks the unified low-bit inference pipeline. To bridge this gap, we introduce \\textbf{ZipperEngine}, which fuses sparse block computation into the dense 4-bit GEMM kernel via an overlapped pipeline, unifying not only the representation but also the execution into a single coherent low-bit inference pipeline. Extensive experiments on LLaMA3 and Qwen3 demonstrate that MosaicQuant preserves near-FP16 accuracy while achieving up to $1.24\\times$ speedup over the W16A16 baseline."},{"descriptionType":"Other","description":"17 pages"}],"geoLocations":[],"fundingReferences":[],"url":"https://arxiv.org/abs/2606.15652","contentUrl":null,"metadataVersion":0,"schemaVersion":"http://datacite.org/schema/kernel-4","source":"mds","isActive":true,"state":"findable","reason":null,"viewCount":0,"downloadCount":0,"referenceCount":0,"citationCount":0,"partCount":0,"partOfCount":0,"versionCount":0,"versionOfCount":0,"created":"2026-06-16T03:28:25Z","registered":"2026-06-16T03:28:26Z","published":null,"updated":"2026-06-16T03:28:26Z"},"relationships":{"client":{"data":{"id":"arxiv.content","type":"clients"}}}},{"id":"10.48550/arxiv.2606.15643","type":"dois","attributes":{"doi":"10.48550/arxiv.2606.15643","identifiers":[{"identifier":"2606.15643","identifierType":"arXiv"}],"creators":[{"nameType":"Personal","givenName":"Gili","familyName":"Lior","name":"Lior, Gili","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Tzviel","familyName":"Frostig","name":"Frostig, Tzviel","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Gabriel","familyName":"Stanovsky","name":"Stanovsky, Gabriel","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Matan","familyName":"Eyal","name":"Eyal, Matan","affiliation":[],"nameIdentifiers":[]}],"titles":[{"title":"Extending Item Response Theory for Efficient and Meaningful Multilingual Evaluation"}],"publisher":"arXiv","container":{},"publicationYear":2026,"subjects":[{"subject":"Computation and Language (cs.CL)","lang":"en","subjectScheme":"arXiv"},{"subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"},{"schemeUri":"http://www.oecd.org/science/inno/38235147.pdf","subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"}],"contributors":[],"dates":[{"date":"2026-06-14T07:16:03Z","dateType":"Submitted","dateInformation":"v1"},{"date":"2026-06-16T00:51:37Z","dateType":"Updated","dateInformation":"v1"},{"date":"2026-06","dateType":"Available","dateInformation":"v1"},{"date":"2026","dateType":"Issued"}],"language":null,"types":{"schemaOrg":"CreativeWork","resourceTypeGeneral":"Preprint","citeproc":"article","bibtex":"misc","ris":"GEN","resourceType":"Article"},"relatedIdentifiers":[],"relatedItems":[],"sizes":[],"formats":[],"version":"1","rightsList":[{"rightsIdentifierScheme":"SPDX","rightsUri":"https://creativecommons.org/licenses/by-nc-sa/4.0/legalcode","schemeUri":"https://spdx.org/licenses/","rights":"Creative Commons Attribution Non Commercial Share Alike 4.0 International","rightsIdentifier":"cc-by-nc-sa-4.0"}],"descriptions":[{"descriptionType":"Abstract","description":"Multilingual benchmarks are central to evaluating large language models (LLMs) across languages, but they suffer from three issues: exhaustive evaluation scales linearly with the number of languages, automatic translation introduces errors that are easily missed at scale, and some items conflate general and culture-specific knowledge. We address all three with a unified statistical framework, Multilingual-IRT, which extends Item Response Theory with per-language difficulty deviations, split discriminability separating content from language effects, and per-language ability residuals. Fitting Multilingual-IRT on 25 LLMs across 29 languages of MMLU-Pro-X, we show that its fitted parameters support three practical applications: predicting unobserved (item, LLM, language) instances with 11-16% lower binary cross-entropy than the strongest accuracy-based baseline, surfacing candidate translation errors distributed across all 28 non-English languages, whereas accuracy-based baselines concentrate detections in a few languages, and recovering culture-specific items that accuracy-based baselines miss."}],"geoLocations":[],"fundingReferences":[],"url":"https://arxiv.org/abs/2606.15643","contentUrl":null,"metadataVersion":0,"schemaVersion":"http://datacite.org/schema/kernel-4","source":"mds","isActive":true,"state":"findable","reason":null,"viewCount":0,"downloadCount":0,"referenceCount":0,"citationCount":0,"partCount":0,"partOfCount":0,"versionCount":0,"versionOfCount":0,"created":"2026-06-16T03:28:14Z","registered":"2026-06-16T03:28:14Z","published":null,"updated":"2026-06-16T03:28:14Z"},"relationships":{"client":{"data":{"id":"arxiv.content","type":"clients"}}}},{"id":"10.48550/arxiv.2606.15642","type":"dois","attributes":{"doi":"10.48550/arxiv.2606.15642","identifiers":[{"identifier":"2606.15642","identifierType":"arXiv"}],"creators":[{"nameType":"Personal","givenName":"Abdul Joseph","familyName":"Fofanah","name":"Fofanah, Abdul Joseph","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Lian","familyName":"Wen","name":"Wen, Lian","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"David","familyName":"Chen","name":"Chen, David","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Shaoyang","familyName":"Zhang","name":"Zhang, Shaoyang","affiliation":[],"nameIdentifiers":[]}],"titles":[{"title":"CIWI-CKT: Chaos-Informed Wave Interference Feature Fusion and Cross-City Knowledge Transfer for Traffic Flow Forecasting"}],"publisher":"arXiv","container":{},"publicationYear":2026,"subjects":[{"subject":"Machine Learning (cs.LG)","lang":"en","subjectScheme":"arXiv"},{"subject":"Artificial Intelligence (cs.AI)","lang":"en","subjectScheme":"arXiv"},{"subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"},{"schemeUri":"http://www.oecd.org/science/inno/38235147.pdf","subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"}],"contributors":[],"dates":[{"date":"2026-06-14T07:08:24Z","dateType":"Submitted","dateInformation":"v1"},{"date":"2026-06-16T00:51:34Z","dateType":"Updated","dateInformation":"v1"},{"date":"2026-06","dateType":"Available","dateInformation":"v1"},{"date":"2026","dateType":"Issued"}],"language":null,"types":{"schemaOrg":"CreativeWork","resourceTypeGeneral":"Preprint","citeproc":"article","bibtex":"misc","ris":"GEN","resourceType":"Article"},"relatedIdentifiers":[],"relatedItems":[],"sizes":[],"formats":[],"version":"1","rightsList":[{"rightsUri":"http://arxiv.org/licenses/nonexclusive-distrib/1.0/","rights":"arXiv.org perpetual, non-exclusive license"}],"descriptions":[{"descriptionType":"Abstract","description":"Accurate traffic flow prediction remains challenging in cross-city, data-scarce scenarios where limited historical data hinders model generalisation. The chaotic nature of traffic dynamics, complex spatio-temporal dependencies, and heterogeneous urban networks complicate few-shot learning across cities. Existing deep learning approaches either treat traffic as purely deterministic or lack mechanisms to model wave-like interference patterns essential for cross-regime traffic dynamics. To address these limitations, this paper proposes CIWI-CKT, a novel Chaos-Informed Wave Interference Feature Fusion framework with Cross-City Knowledge Transfer. Our framework introduces three core innovations: chaos-informed wave generation that extracts measurable chaos invariants and models traffic as adaptive wave components; meta-interference processing that captures wave interactions between support and query regimes while producing a predictability score for confidence estimation; and chaos-aware meta-learning that enables efficient cross-city knowledge transfer while preserving chaotic characteristics. We establish theoretical guarantees including chaos-to-wave stability, wave-induced dimension reduction, and meta-learning generalisation bounds. Extensive experiments on four real-world traffic datasets demonstrate that CIWI-CKT significantly outperforms state-of-the-art spatio-temporal graph learning, transfer learning, prompt-based, and few-shot methods, improving prediction accuracy while substantially reducing required training data."}],"geoLocations":[],"fundingReferences":[],"url":"https://arxiv.org/abs/2606.15642","contentUrl":null,"metadataVersion":0,"schemaVersion":"http://datacite.org/schema/kernel-4","source":"mds","isActive":true,"state":"findable","reason":null,"viewCount":0,"downloadCount":0,"referenceCount":0,"citationCount":0,"partCount":0,"partOfCount":0,"versionCount":0,"versionOfCount":0,"created":"2026-06-16T03:28:12Z","registered":"2026-06-16T03:28:13Z","published":null,"updated":"2026-06-16T03:28:13Z"},"relationships":{"client":{"data":{"id":"arxiv.content","type":"clients"}}}},{"id":"10.48550/arxiv.2606.15641","type":"dois","attributes":{"doi":"10.48550/arxiv.2606.15641","identifiers":[{"identifier":"2606.15641","identifierType":"arXiv"}],"creators":[{"nameType":"Personal","givenName":"Guy","familyName":"Rotman","name":"Rotman, Guy","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Adi","familyName":"Kopilov","name":"Kopilov, Adi","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Danit Berger","familyName":"Zalmanson","name":"Zalmanson, Danit Berger","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Omri","familyName":"Allouche","name":"Allouche, Omri","affiliation":[],"nameIdentifiers":[]}],"titles":[{"title":"Distilling Examples into Task Instructions: Enhanced In-Context Learning for Real-World B2B Conversations"}],"publisher":"arXiv","container":{},"publicationYear":2026,"subjects":[{"subject":"Computation and Language (cs.CL)","lang":"en","subjectScheme":"arXiv"},{"subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"},{"schemeUri":"http://www.oecd.org/science/inno/38235147.pdf","subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"}],"contributors":[],"dates":[{"date":"2026-06-14T07:07:52Z","dateType":"Submitted","dateInformation":"v1"},{"date":"2026-06-16T00:51:33Z","dateType":"Updated","dateInformation":"v1"},{"date":"2026-06","dateType":"Available","dateInformation":"v1"},{"date":"2026","dateType":"Issued"}],"language":null,"types":{"schemaOrg":"CreativeWork","resourceTypeGeneral":"Preprint","citeproc":"article","bibtex":"misc","ris":"GEN","resourceType":"Article"},"relatedIdentifiers":[],"relatedItems":[],"sizes":[],"formats":[],"version":"1","rightsList":[{"rightsIdentifierScheme":"SPDX","rightsUri":"https://creativecommons.org/licenses/by/4.0/legalcode","schemeUri":"https://spdx.org/licenses/","rights":"Creative Commons Attribution 4.0 International","rightsIdentifier":"cc-by-4.0"}],"descriptions":[{"descriptionType":"Abstract","description":"In-context learning (ICL) is the standard method for low-resource classification, yet its efficacy in specialized domains remains largely unexplored. We address the challenge of classifying semantically complex, multi-party B2B conversations, where traditional ICL encounters significant limitations, especially as context length increases due to the concatenation of multiple few-shot examples. We introduce the \\texttt{Call Playbook} dataset, featuring five classification tasks derived from real-world B2B conversations targeting core sales concepts. To bridge the gap between performance and practical utility, we propose novel knowledge extraction methods that distill verbose examples into compact, interpretable representations of structured classification criteria and precise task descriptions. Our approach achieves a 99\\% reduction in token usage and improves macro-averaged AUC by up to 7\\% over traditional ICL. Notably, it remains robust as context grows, unlike advanced token compression baselines which degrade by over 9 F1 points. Importantly, our framework enables direct refinement of classification logic, addressing critical needs for transparency, efficiency, and user interaction in real-world NLP applications."},{"descriptionType":"Other","description":"Accepted for publication in Findings of the Association for Computational Linguistics 2026"}],"geoLocations":[],"fundingReferences":[],"url":"https://arxiv.org/abs/2606.15641","contentUrl":null,"metadataVersion":0,"schemaVersion":"http://datacite.org/schema/kernel-4","source":"mds","isActive":true,"state":"findable","reason":null,"viewCount":0,"downloadCount":0,"referenceCount":0,"citationCount":0,"partCount":0,"partOfCount":0,"versionCount":0,"versionOfCount":0,"created":"2026-06-16T03:28:11Z","registered":"2026-06-16T03:28:12Z","published":null,"updated":"2026-06-16T03:28:12Z"},"relationships":{"client":{"data":{"id":"arxiv.content","type":"clients"}}}},{"id":"10.48550/arxiv.2606.15640","type":"dois","attributes":{"doi":"10.48550/arxiv.2606.15640","identifiers":[{"identifier":"2606.15640","identifierType":"arXiv"}],"creators":[{"nameType":"Personal","givenName":"Yuhan","familyName":"Wang","name":"Wang, Yuhan","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Manqing","familyName":"Wang","name":"Wang, Manqing","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Yixuan","familyName":"Lu","name":"Lu, Yixuan","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Zhaoyue","familyName":"Peng","name":"Peng, Zhaoyue","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Shengda","familyName":"Lin","name":"Lin, Shengda","affiliation":[],"nameIdentifiers":[]}],"titles":[{"title":"Multi-Agent Framework for Audit Risk Assessment with Explicit Uncertainty and Evidence Conflict Modeling"}],"publisher":"arXiv","container":{},"publicationYear":2026,"subjects":[{"subject":"Machine Learning (cs.LG)","lang":"en","subjectScheme":"arXiv"},{"subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"},{"schemeUri":"http://www.oecd.org/science/inno/38235147.pdf","subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"}],"contributors":[],"dates":[{"date":"2026-06-14T07:06:03Z","dateType":"Submitted","dateInformation":"v1"},{"date":"2026-06-16T00:51:29Z","dateType":"Updated","dateInformation":"v1"},{"date":"2026-06","dateType":"Available","dateInformation":"v1"},{"date":"2026","dateType":"Issued"}],"language":null,"types":{"schemaOrg":"CreativeWork","resourceTypeGeneral":"Preprint","citeproc":"article","bibtex":"misc","ris":"GEN","resourceType":"Article"},"relatedIdentifiers":[],"relatedItems":[],"sizes":[],"formats":[],"version":"1","rightsList":[{"rightsUri":"http://arxiv.org/licenses/nonexclusive-distrib/1.0/","rights":"arXiv.org perpetual, non-exclusive license"}],"descriptions":[{"descriptionType":"Abstract","description":"Audit risk assessment increasingly benefits from combining heterogeneous evidence sources, yet existing approaches typically produce point predictions without quantifying how well different evidence streams agree. We propose UMAR (Uncertainty-Aware Multi-Agent Risk Assessment), a framework that employs three specialized agents: an MD\u0026amp;A Text Agent, a Financial Ratio Agent, and a CAM Agent, each producing independent risk scores with calibrated uncertainty estimates. An Uncertainty Aggregator based on Dempster-Shafer evidence theory fuses these scores while explicitly measuring inter-agent conflict. We evaluate UMAR on a U.S. dataset of 3,200 firm-year observations from SEC 10-K filings (2019-2023), with financial restatement as the target label. Experimental results show that UMAR achieves an AUROC of 0.782 and a PR-AUC of 0.341, outperforming logistic regression, XGBoost, FinBERT, and single-agent and dual-agent LLM baselines. UMAR attains the lowest expected calibration error (ECE = 0.052) among all methods and identifies evidence-conflict patterns that correlate with actual restatement risk, offering auditors potentially actionable and interpretable risk signals."}],"geoLocations":[],"fundingReferences":[],"url":"https://arxiv.org/abs/2606.15640","contentUrl":null,"metadataVersion":0,"schemaVersion":"http://datacite.org/schema/kernel-4","source":"mds","isActive":true,"state":"findable","reason":null,"viewCount":0,"downloadCount":0,"referenceCount":0,"citationCount":0,"partCount":0,"partOfCount":0,"versionCount":0,"versionOfCount":0,"created":"2026-06-16T03:28:10Z","registered":"2026-06-16T03:28:10Z","published":null,"updated":"2026-06-16T03:28:10Z"},"relationships":{"client":{"data":{"id":"arxiv.content","type":"clients"}}}},{"id":"10.48550/arxiv.2606.15637","type":"dois","attributes":{"doi":"10.48550/arxiv.2606.15637","identifiers":[{"identifier":"2606.15637","identifierType":"arXiv"}],"creators":[{"nameType":"Personal","givenName":"Sumeet","familyName":"Vadhavkar","name":"Vadhavkar, Sumeet","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Xiajun","familyName":"Jiang","name":"Jiang, Xiajun","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Yubo","familyName":"Ye","name":"Ye, Yubo","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Maryam","familyName":"Toloubidokhti","name":"Toloubidokhti, Maryam","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Linwei","familyName":"Wang","name":"Wang, Linwei","affiliation":[],"nameIdentifiers":[]}],"titles":[{"title":"HAPI-EP: Towards Hybrid, Adaptive, and Predictive Digital Twins of Cardiac Electrophysiology"}],"publisher":"arXiv","container":{},"publicationYear":2026,"subjects":[{"subject":"Machine Learning (cs.LG)","lang":"en","subjectScheme":"arXiv"},{"subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"},{"schemeUri":"http://www.oecd.org/science/inno/38235147.pdf","subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"}],"contributors":[],"dates":[{"date":"2026-06-14T06:59:55Z","dateType":"Submitted","dateInformation":"v1"},{"date":"2026-06-16T00:51:18Z","dateType":"Updated","dateInformation":"v1"},{"date":"2026-06","dateType":"Available","dateInformation":"v1"},{"date":"2026","dateType":"Issued"}],"language":null,"types":{"schemaOrg":"CreativeWork","resourceTypeGeneral":"Preprint","citeproc":"article","bibtex":"misc","ris":"GEN","resourceType":"Article"},"relatedIdentifiers":[],"relatedItems":[],"sizes":[],"formats":[],"version":"1","rightsList":[{"rightsIdentifierScheme":"SPDX","rightsUri":"https://creativecommons.org/licenses/by-sa/4.0/legalcode","schemeUri":"https://spdx.org/licenses/","rights":"Creative Commons Attribution Share Alike 4.0 International","rightsIdentifier":"cc-by-sa-4.0"}],"descriptions":[{"descriptionType":"Abstract","description":"A digital twin (DT) of a patient-specific heart offers significant potential in personalized medicine. However, its rapid and dynamic adaptation to an individual's live data and its predictive capability after adaptation remains central challenges. We examine this challenge from its two building blocks: DT formulation where mechanistic and data-driven models show competing merits and limitations, and DT optimization strategies that are largely driven by a reconstruction objective leading to un-identifiable models. We address both bottlenecks via HAPI -- an AI framework for building hybrid, adaptive, and predictive DTs with three key enablers. First, HAPI constructs a physics-integrated gray-box model in which an interpretable mechanistic backbone is augmented by a neural component that models its residual to the observed data. Second, rather than attempting to pre-encode all possible variations in a static hybrid model, HAPI enables rapid on-the-fly adaptation of the hybrid model to few-shot live data, achieved by feedforward meta-learners realizing amortized inference of both mechanistic and neural parameters of the hybrid model trained with predictive objectives. Finally, we show that this adaptivity corresponds to the construction of a conditional generative model (i.e., the hybrid DT) that endows it with theoretical identifiability and thus strong performance in predictive scenarios. We demonstrate the proof-of-concept of HAPI in cardiac electrophysiology using a hybrid monodomain model with mechanistic reaction kinetics and neural graph diffusion. Across synthetic and real-data studies, we show that HAPI's mechanistic-neural hybridization and predictive adaptation are critical for obtaining identifiable DTs with strong predictive and out-of-distribution capabilities."}],"geoLocations":[],"fundingReferences":[],"url":"https://arxiv.org/abs/2606.15637","contentUrl":null,"metadataVersion":0,"schemaVersion":"http://datacite.org/schema/kernel-4","source":"mds","isActive":true,"state":"findable","reason":null,"viewCount":0,"downloadCount":0,"referenceCount":0,"citationCount":0,"partCount":0,"partOfCount":0,"versionCount":0,"versionOfCount":0,"created":"2026-06-16T03:28:06Z","registered":"2026-06-16T03:28:07Z","published":null,"updated":"2026-06-16T03:28:07Z"},"relationships":{"client":{"data":{"id":"arxiv.content","type":"clients"}}}},{"id":"10.48550/arxiv.2606.15625","type":"dois","attributes":{"doi":"10.48550/arxiv.2606.15625","identifiers":[{"identifier":"2606.15625","identifierType":"arXiv"}],"creators":[{"nameType":"Personal","givenName":"Yijun","familyName":"Lu","name":"Lu, Yijun","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Zihan","familyName":"Fang","name":"Fang, Zihan","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Pengpeng","familyName":"Qiao","name":"Qiao, Pengpeng","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Zheng","familyName":"Lin","name":"Lin, Zheng","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Jing","familyName":"Yang","name":"Yang, Jing","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Yuxin","familyName":"Zhang","name":"Zhang, Yuxin","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Por Lip","familyName":"Yee","name":"Yee, Por Lip","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Zhe","familyName":"Chen","name":"Chen, Zhe","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Jun","familyName":"Luo","name":"Luo, Jun","affiliation":[],"nameIdentifiers":[]}],"titles":[{"title":"Conflict-Aware Federated Fine-Tuning of Large Language Models with Mixture-of-Experts"}],"publisher":"arXiv","container":{},"publicationYear":2026,"subjects":[{"subject":"Machine Learning (cs.LG)","lang":"en","subjectScheme":"arXiv"},{"subject":"Networking and Internet Architecture (cs.NI)","lang":"en","subjectScheme":"arXiv"},{"subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"},{"schemeUri":"http://www.oecd.org/science/inno/38235147.pdf","subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"}],"contributors":[],"dates":[{"date":"2026-06-14T06:22:09Z","dateType":"Submitted","dateInformation":"v1"},{"date":"2026-06-16T00:50:41Z","dateType":"Updated","dateInformation":"v1"},{"date":"2026-06","dateType":"Available","dateInformation":"v1"},{"date":"2026","dateType":"Issued"}],"language":null,"types":{"schemaOrg":"CreativeWork","resourceTypeGeneral":"Preprint","citeproc":"article","bibtex":"misc","ris":"GEN","resourceType":"Article"},"relatedIdentifiers":[],"relatedItems":[],"sizes":[],"formats":[],"version":"1","rightsList":[{"rightsUri":"http://arxiv.org/licenses/nonexclusive-distrib/1.0/","rights":"arXiv.org perpetual, non-exclusive license"}],"descriptions":[{"descriptionType":"Abstract","description":"The continuous scaling of large language models (LLMs) incurs prohibitive computational costs, making Mixture-of-Experts (MoE) a scalable alternative for efficient fine-tuning via sparse activation. While federated learning (FL) emerges as the paradigm for privacy-preserving collaborative optimization, integrating MoE into FL under data heterogeneity may trigger conflicting expert optimizations. Client-specific data distributions force same-indexed experts to optimize under inconsistent or even conflicting feature-label correlations. This mismatch induces destructive interference during aggregation, thus destabilizing the optimization trajectory and degrading model performance. To address this issue, we propose FC-MoE, a federated conflict-aware framework for MoE fine-tuning. It employs an importance aware weighting scheme to prioritize reliable local updates and utilizes gradient consensus projection to suppress conflicting updates, ensuring a stable global optimization path. Moreover, a local knowledge retention mechanism further preserves specialized client expertise by re-anchoring domain-specific residuals. Extensive experiments demonstrate that FC-MoE accelerates convergence and enhances both global and local model performance in non-IID federated environments."},{"descriptionType":"Other","description":"6 pages, 4 figures"}],"geoLocations":[],"fundingReferences":[],"url":"https://arxiv.org/abs/2606.15625","contentUrl":null,"metadataVersion":0,"schemaVersion":"http://datacite.org/schema/kernel-4","source":"mds","isActive":true,"state":"findable","reason":null,"viewCount":0,"downloadCount":0,"referenceCount":0,"citationCount":0,"partCount":0,"partOfCount":0,"versionCount":0,"versionOfCount":0,"created":"2026-06-16T03:27:51Z","registered":"2026-06-16T03:27:52Z","published":null,"updated":"2026-06-16T03:27:52Z"},"relationships":{"client":{"data":{"id":"arxiv.content","type":"clients"}}}},{"id":"10.48550/arxiv.2606.15621","type":"dois","attributes":{"doi":"10.48550/arxiv.2606.15621","identifiers":[{"identifier":"2606.15621","identifierType":"arXiv"}],"creators":[{"nameType":"Personal","givenName":"Nils","familyName":"Matteson","name":"Matteson, Nils","affiliation":[],"nameIdentifiers":[]}],"titles":[{"title":"Re-feeding Is Not Replaying: Measuring Replay Noise in Counterfactual Token-Credit Estimation"}],"publisher":"arXiv","container":{},"publicationYear":2026,"subjects":[{"subject":"Machine Learning (cs.LG)","lang":"en","subjectScheme":"arXiv"},{"subject":"Computation and Language (cs.CL)","lang":"en","subjectScheme":"arXiv"},{"subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"},{"schemeUri":"http://www.oecd.org/science/inno/38235147.pdf","subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"}],"contributors":[],"dates":[{"date":"2026-06-14T06:09:16Z","dateType":"Submitted","dateInformation":"v1"},{"date":"2026-06-16T00:50:33Z","dateType":"Updated","dateInformation":"v1"},{"date":"2026-06","dateType":"Available","dateInformation":"v1"},{"date":"2026","dateType":"Issued"}],"language":null,"types":{"schemaOrg":"CreativeWork","resourceTypeGeneral":"Preprint","citeproc":"article","bibtex":"misc","ris":"GEN","resourceType":"Article"},"relatedIdentifiers":[],"relatedItems":[],"sizes":[],"formats":[],"version":"1","rightsList":[{"rightsUri":"http://arxiv.org/licenses/nonexclusive-distrib/1.0/","rights":"arXiv.org perpetual, non-exclusive license"}],"descriptions":[{"descriptionType":"Abstract","description":"Per-token counterfactual credit estimation asks which token in a language-model rollout caused the final answer to be right or wrong: cut the transcript at a pivot, substitute an alternative token, replay continuations, and compare outcomes. Published methods re-feed the transcript prefix as a fresh prompt, assuming this reproduces the state the model passed through during generation. We measure what that assumption costs on a stock inference engine, with a three-pass design: continuations resumed from the verified decode-time KV state, an identical second exact pass (a replica noise floor), and a re-feed pass. Across six configurations and three models (including a GRPO-trained checkpoint), at low-margin decision tokens, re-feeding changes the credit estimate at rates 14-28 percentage points above the replica floor (7-21pp under a treatment-independent conditioning; problem-clustered t = 2.9-6.4). Most changes are zero-boundary crossings of the quantized estimator rather than polarity reversals, and the perturbation is consistent with mean-zero, so averaged quantities are largely safe; but selection is not: a critical-token set chosen by thresholding $|\\hat{A}_t|$ under re-feed overlaps the exact-resume selection at Jaccard 0.34-0.90, versus a 0.63-0.96 replica ceiling. A causal confirmation closes the loop: under vLLM's batch-invariant kernels all three passes are identical on every measured channel, with both disagreement rates exactly zero. Replica passes themselves disagree on 9-23% of eligible estimates: single-sample credit measurements at decision tokens are unreliable under any replay. Settings were fixed in advance; exact-pass cache hits in the second campaign are instrumented (100% hit rate, 3,434 pivots); total compute was under 10 USD. We recommend that counterfactual credit studies resume decoder state or use batch-invariant kernels, and report a replica floor."},{"descriptionType":"Other","description":"10 pages, 3 figures. Code, per-pivot data, logs, and registration: https://github.com/thaw-ai/thaw (benchmarks/, paper/refeed-drift/)"}],"geoLocations":[],"fundingReferences":[],"url":"https://arxiv.org/abs/2606.15621","contentUrl":null,"metadataVersion":0,"schemaVersion":"http://datacite.org/schema/kernel-4","source":"mds","isActive":true,"state":"findable","reason":null,"viewCount":0,"downloadCount":0,"referenceCount":0,"citationCount":0,"partCount":0,"partOfCount":0,"versionCount":0,"versionOfCount":0,"created":"2026-06-16T03:27:46Z","registered":"2026-06-16T03:27:47Z","published":null,"updated":"2026-06-16T03:27:47Z"},"relationships":{"client":{"data":{"id":"arxiv.content","type":"clients"}}}},{"id":"10.48550/arxiv.2606.15589","type":"dois","attributes":{"doi":"10.48550/arxiv.2606.15589","identifiers":[{"identifier":"2606.15589","identifierType":"arXiv"}],"creators":[{"nameType":"Personal","givenName":"Terry","familyName":"Tong","name":"Tong, Terry","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Yu","familyName":"Feng","name":"Feng, Yu","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Surbhi","familyName":"Goel","name":"Goel, Surbhi","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Dan","familyName":"Roth","name":"Roth, Dan","affiliation":[],"nameIdentifiers":[]}],"titles":[{"title":"Is Code Better Than Language for Algorithmic Reasoning"}],"publisher":"arXiv","container":{},"publicationYear":2026,"subjects":[{"subject":"Machine Learning (cs.LG)","lang":"en","subjectScheme":"arXiv"},{"subject":"Artificial Intelligence (cs.AI)","lang":"en","subjectScheme":"arXiv"},{"subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"},{"schemeUri":"http://www.oecd.org/science/inno/38235147.pdf","subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"}],"contributors":[],"dates":[{"date":"2026-06-14T04:17:21Z","dateType":"Submitted","dateInformation":"v1"},{"date":"2026-06-16T00:49:10Z","dateType":"Updated","dateInformation":"v1"},{"date":"2026-06","dateType":"Available","dateInformation":"v1"},{"date":"2026","dateType":"Issued"}],"language":null,"types":{"schemaOrg":"CreativeWork","resourceTypeGeneral":"Preprint","citeproc":"article","bibtex":"misc","ris":"GEN","resourceType":"Article"},"relatedIdentifiers":[],"relatedItems":[],"sizes":[],"formats":[],"version":"1","rightsList":[{"rightsIdentifierScheme":"SPDX","rightsUri":"https://creativecommons.org/licenses/by/4.0/legalcode","schemeUri":"https://spdx.org/licenses/","rights":"Creative Commons Attribution 4.0 International","rightsIdentifier":"cc-by-4.0"}],"descriptions":[{"descriptionType":"Abstract","description":"For tool-augmented language models, comparing natural-language reasoning with code-execution pipelines is difficult because the comparison changes both the intermediate representation and the execution mechanism. We separate these factors with an intermediate intervention: the model expresses its reasoning as executable code, and the language model simulates that code in context to produce an answer. On a 40-task verifiable algorithmic benchmark, deterministic code execution outperforms natural-language reasoning by +31.6pp. We observe that the intermediate intervention is not meaningfully different from natural-language reasoning (+0.15pp). These results suggest that, in our evaluated setting, changing the intermediate representation alone does not explain the tool-use advantage, providing evidence for the performance gains requiring reliable external execution. We formalize this intuition with a simple statistical decision-theoretic model that characterizes when execution dominates end-to-end risk in our disentangled trace-generation/execution regime. We validate our theory using a reconstruction intervention that leverages a proxy language model to infer natural-language reasoning traces from code representations, recovering performance comparable to the original natural-language reasoning pipeline. All experiments are at https://github.com/TerryTong-Git/ToolProj."},{"descriptionType":"Other","description":"ICML 2026"}],"geoLocations":[],"fundingReferences":[],"url":"https://arxiv.org/abs/2606.15589","contentUrl":null,"metadataVersion":0,"schemaVersion":"http://datacite.org/schema/kernel-4","source":"mds","isActive":true,"state":"findable","reason":null,"viewCount":0,"downloadCount":0,"referenceCount":0,"citationCount":0,"partCount":0,"partOfCount":0,"versionCount":0,"versionOfCount":0,"created":"2026-06-16T03:27:05Z","registered":"2026-06-16T03:27:06Z","published":null,"updated":"2026-06-16T03:27:06Z"},"relationships":{"client":{"data":{"id":"arxiv.content","type":"clients"}}}},{"id":"10.48550/arxiv.2606.15576","type":"dois","attributes":{"doi":"10.48550/arxiv.2606.15576","identifiers":[{"identifier":"2606.15576","identifierType":"arXiv"}],"creators":[{"nameType":"Personal","givenName":"Yu","familyName":"Li","name":"Li, Yu","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Shu","familyName":"Hong","name":"Hong, Shu","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Tian","familyName":"Lan","name":"Lan, Tian","affiliation":[],"nameIdentifiers":[]}],"titles":[{"title":"Localizing Credit at the Divergence: Path-Conditioned Self-Distillation for LLM Reasoning"}],"publisher":"arXiv","container":{},"publicationYear":2026,"subjects":[{"subject":"Machine Learning (cs.LG)","lang":"en","subjectScheme":"arXiv"},{"subject":"Artificial Intelligence (cs.AI)","lang":"en","subjectScheme":"arXiv"},{"subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"},{"schemeUri":"http://www.oecd.org/science/inno/38235147.pdf","subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"}],"contributors":[],"dates":[{"date":"2026-06-14T03:37:27Z","dateType":"Submitted","dateInformation":"v1"},{"date":"2026-06-16T00:48:20Z","dateType":"Updated","dateInformation":"v1"},{"date":"2026-06","dateType":"Available","dateInformation":"v1"},{"date":"2026","dateType":"Issued"}],"language":null,"types":{"schemaOrg":"CreativeWork","resourceTypeGeneral":"Preprint","citeproc":"article","bibtex":"misc","ris":"GEN","resourceType":"Article"},"relatedIdentifiers":[],"relatedItems":[],"sizes":[],"formats":[],"version":"1","rightsList":[{"rightsIdentifierScheme":"SPDX","rightsUri":"https://creativecommons.org/licenses/by/4.0/legalcode","schemeUri":"https://spdx.org/licenses/","rights":"Creative Commons Attribution 4.0 International","rightsIdentifier":"cc-by-4.0"}],"descriptions":[{"descriptionType":"Abstract","description":"Reinforcement learning from verifiable rewards assigns a single scalar to each rollout, leaving token-level credit assignment underspecified in long reasoning traces. On-policy self-distillation addresses this by letting the same model act as a teacher conditioned on privileged information, producing a dense per-token signal. But the common choice of a ground-truth answer is only an endpoint cue: on terse-answer tasks, the teacher falls silent at the intermediate positions where path-level guidance matters most. We propose Hindsight Self-Distillation (HSD), which conditions the teacher on a successful peer rollout drawn from the current training group. Such a peer is an exact sample from the success-conditioned policy, requiring no additional sampled rollouts. By providing a full successful continuation rather than only the final answer, the resulting credit signal concentrates at the divergence position between a failed rollout and a successful peer. Across Qwen3-8B and Qwen3-32B on math and code benchmarks, HSD obtains the best result against GRPO variants and on-policy distillation baselines, with the largest gains on terse-answer tasks such as AIME."}],"geoLocations":[],"fundingReferences":[],"url":"https://arxiv.org/abs/2606.15576","contentUrl":null,"metadataVersion":0,"schemaVersion":"http://datacite.org/schema/kernel-4","source":"mds","isActive":true,"state":"findable","reason":null,"viewCount":0,"downloadCount":0,"referenceCount":0,"citationCount":0,"partCount":0,"partOfCount":0,"versionCount":0,"versionOfCount":0,"created":"2026-06-16T03:26:48Z","registered":"2026-06-16T03:26:49Z","published":null,"updated":"2026-06-16T03:26:49Z"},"relationships":{"client":{"data":{"id":"arxiv.content","type":"clients"}}}},{"id":"10.48550/arxiv.2606.15566","type":"dois","attributes":{"doi":"10.48550/arxiv.2606.15566","identifiers":[{"identifier":"2606.15566","identifierType":"arXiv"}],"creators":[{"nameType":"Personal","givenName":"Eyup Engin","familyName":"Kucuk","name":"Kucuk, Eyup Engin","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Tarik","familyName":"Kelestemur","name":"Kelestemur, Tarik","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Ömer Dağlar","familyName":"Tanrikulu","name":"Tanrikulu, Ömer Dağlar","affiliation":[],"nameIdentifiers":[]}],"titles":[{"title":"LLM-Assisted Stance Detection in Scientific Discourse: A Test Case in Bayesian Cognitive Science"}],"publisher":"arXiv","container":{},"publicationYear":2026,"subjects":[{"subject":"Computation and Language (cs.CL)","lang":"en","subjectScheme":"arXiv"},{"subject":"Artificial Intelligence (cs.AI)","lang":"en","subjectScheme":"arXiv"},{"subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"},{"schemeUri":"http://www.oecd.org/science/inno/38235147.pdf","subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"}],"contributors":[],"dates":[{"date":"2026-06-14T03:03:40Z","dateType":"Submitted","dateInformation":"v1"},{"date":"2026-06-16T00:47:48Z","dateType":"Updated","dateInformation":"v1"},{"date":"2026-06","dateType":"Available","dateInformation":"v1"},{"date":"2026","dateType":"Issued"}],"language":null,"types":{"schemaOrg":"CreativeWork","resourceTypeGeneral":"Preprint","citeproc":"article","bibtex":"misc","ris":"GEN","resourceType":"Article"},"relatedIdentifiers":[],"relatedItems":[],"sizes":[],"formats":[],"version":"1","rightsList":[{"rightsIdentifierScheme":"SPDX","rightsUri":"https://creativecommons.org/licenses/by/4.0/legalcode","schemeUri":"https://spdx.org/licenses/","rights":"Creative Commons Attribution 4.0 International","rightsIdentifier":"cc-by-4.0"}],"descriptions":[{"descriptionType":"Abstract","description":"Qualitative coding is central to social science, but expert annotation is difficult to scale. LLMs offer a possible extension, yet require careful validation when the target construct is interpretive, theoretically loaded, and only indirectly expressed. We study this problem in a difficult case: detecting whether authors treat Bayesian models as descriptions of mental and neural mechanisms (realism) or as useful mathematical tools (instrumentalism). Our method combines a theory-driven codebook, expert-coded reference annotations, a diagnostic-gated prompt-optimization search yielding a shared zero-shot prompt for three frontier LLMs (GPT-5.1, Claude Sonnet 4.6, Gemini 3 Pro Preview), and multi-rater reliability analysis. The final prompt achieved a held-out combined reliability score of 0.76 (harmonic mean of ICC = 0.79 and $α$ = 0.74), with all diagnostics satisfied. Deployed on 6,858 quotes from 210 articles, the three LLMs reached substantial quote-level agreement (ICC = 0.80; $α$ = 0.76; combined = 0.78) and near-perfect article-level rank stability ($r$ = 0.96-0.97 across rater pairs). The corpus was predominantly weakly realist, but article-level stances were rarely uniform: only 1.4% of articles used a single band, while 59.5% spanned four or more. Low-level perception/motor articles scored 8.8 Realism points higher than high-level cognition articles ($p \u0026lt; .001$, $d = 0.60$), quantifying a long-held qualitative intuition. We present this as an expert-led case study; the framework is intended to generalize to similar theoretically demanding tasks, not to all qualitative analysis."},{"descriptionType":"Other","description":"9 pages, 4 figures; Code and data: https://github.com/EyupEK/autoresearch_bayes"}],"geoLocations":[],"fundingReferences":[],"url":"https://arxiv.org/abs/2606.15566","contentUrl":null,"metadataVersion":0,"schemaVersion":"http://datacite.org/schema/kernel-4","source":"mds","isActive":true,"state":"findable","reason":null,"viewCount":0,"downloadCount":0,"referenceCount":0,"citationCount":0,"partCount":0,"partOfCount":0,"versionCount":0,"versionOfCount":0,"created":"2026-06-16T03:26:35Z","registered":"2026-06-16T03:26:36Z","published":null,"updated":"2026-06-16T03:26:36Z"},"relationships":{"client":{"data":{"id":"arxiv.content","type":"clients"}}}},{"id":"10.48550/arxiv.2606.15551","type":"dois","attributes":{"doi":"10.48550/arxiv.2606.15551","identifiers":[{"identifier":"2606.15551","identifierType":"arXiv"}],"creators":[{"nameType":"Personal","givenName":"Eric","familyName":"Gan","name":"Gan, Eric","affiliation":[],"nameIdentifiers":[]}],"titles":[{"title":"A Bifurcation Theory Framework for Gradient Descent on the Edge of Stability"}],"publisher":"arXiv","container":{},"publicationYear":2026,"subjects":[{"subject":"Machine Learning (cs.LG)","lang":"en","subjectScheme":"arXiv"},{"subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"},{"schemeUri":"http://www.oecd.org/science/inno/38235147.pdf","subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"}],"contributors":[],"dates":[{"date":"2026-06-14T02:39:54Z","dateType":"Submitted","dateInformation":"v1"},{"date":"2026-06-16T00:47:15Z","dateType":"Updated","dateInformation":"v1"},{"date":"2026-06","dateType":"Available","dateInformation":"v1"},{"date":"2026","dateType":"Issued"}],"language":null,"types":{"schemaOrg":"CreativeWork","resourceTypeGeneral":"Preprint","citeproc":"article","bibtex":"misc","ris":"GEN","resourceType":"Article"},"relatedIdentifiers":[],"relatedItems":[],"sizes":[],"formats":[],"version":"1","rightsList":[{"rightsIdentifierScheme":"SPDX","rightsUri":"https://creativecommons.org/licenses/by/4.0/legalcode","schemeUri":"https://spdx.org/licenses/","rights":"Creative Commons Attribution 4.0 International","rightsIdentifier":"cc-by-4.0"}],"descriptions":[{"descriptionType":"Abstract","description":"The Edge of Stability (EoS) phenomenon, where gradient descent operates with sharpness exceeding the classical convergence threshold yet the loss decreases over long timescales, is ubiquitous in modern deep learning but remains poorly understood in realistic settings. Prior rigorous analyses have been largely confined to scalar or low-dimensional losses with specific structural forms. In this work, we develop a bifurcation theory framework for gradient descent on the edge of stability that applies directly to overparameterized neural networks. By decomposing the training dynamics into components normal and tangent to the manifold of minimizers, we show that stable EoS training arises from a flip bifurcation in the normal direction, governed by the sign of the first Lyapunov coefficient, while the tangent dynamics drift toward regions of decreasing sharpness. Under mild spectral and geometric assumptions on the loss landscape, we prove convergence to the minimizing manifold when training at the EoS threshold. As a corollary, we recover and unify prior results: we show that the product-stability condition of Gan (2026) is an instance of our framework."}],"geoLocations":[],"fundingReferences":[],"url":"https://arxiv.org/abs/2606.15551","contentUrl":null,"metadataVersion":0,"schemaVersion":"http://datacite.org/schema/kernel-4","source":"mds","isActive":true,"state":"findable","reason":null,"viewCount":0,"downloadCount":0,"referenceCount":0,"citationCount":0,"partCount":0,"partOfCount":0,"versionCount":0,"versionOfCount":0,"created":"2026-06-16T03:26:16Z","registered":"2026-06-16T03:26:17Z","published":null,"updated":"2026-06-16T03:26:17Z"},"relationships":{"client":{"data":{"id":"arxiv.content","type":"clients"}}}},{"id":"10.48550/arxiv.2606.15532","type":"dois","attributes":{"doi":"10.48550/arxiv.2606.15532","identifiers":[{"identifier":"2606.15532","identifierType":"arXiv"}],"creators":[{"nameType":"Personal","givenName":"Rongzhi","familyName":"Zhu","name":"Zhu, Rongzhi","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Xiang","familyName":"Huang","name":"Huang, Xiang","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Yuchuan","familyName":"Wu","name":"Wu, Yuchuan","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Rui","familyName":"Wang","name":"Wang, Rui","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Zequn","familyName":"Sun","name":"Sun, Zequn","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Tao","familyName":"Ren","name":"Ren, Tao","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Weiyao","familyName":"Luo","name":"Luo, Weiyao","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Bingxue","familyName":"Qiu","name":"Qiu, Bingxue","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Jieping","familyName":"Ye","name":"Ye, Jieping","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Yongbin","familyName":"Li","name":"Li, Yongbin","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Wei","familyName":"Hu","name":"Hu, Wei","affiliation":[],"nameIdentifiers":[]}],"titles":[{"title":"EIBench: A Simulator-Based Benchmark and Turn-Credit RL for Emotion Management"}],"publisher":"arXiv","container":{},"publicationYear":2026,"subjects":[{"subject":"Computation and Language (cs.CL)","lang":"en","subjectScheme":"arXiv"},{"subject":"Machine Learning (cs.LG)","lang":"en","subjectScheme":"arXiv"},{"subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"},{"schemeUri":"http://www.oecd.org/science/inno/38235147.pdf","subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"}],"contributors":[],"dates":[{"date":"2026-06-14T01:22:03Z","dateType":"Submitted","dateInformation":"v1"},{"date":"2026-06-16T00:46:22Z","dateType":"Updated","dateInformation":"v1"},{"date":"2026-06","dateType":"Available","dateInformation":"v1"},{"date":"2026","dateType":"Issued"}],"language":null,"types":{"schemaOrg":"CreativeWork","resourceTypeGeneral":"Preprint","citeproc":"article","bibtex":"misc","ris":"GEN","resourceType":"Article"},"relatedIdentifiers":[],"relatedItems":[],"sizes":[],"formats":[],"version":"1","rightsList":[{"rightsIdentifierScheme":"SPDX","rightsUri":"https://creativecommons.org/licenses/by/4.0/legalcode","schemeUri":"https://spdx.org/licenses/","rights":"Creative Commons Attribution 4.0 International","rightsIdentifier":"cc-by-4.0"}],"descriptions":[{"descriptionType":"Abstract","description":"Emotional intelligence (EI) in Large Language Models (LLMs) is often evaluated through static understanding tasks or single-response dialogue generation. However, emotion management is interactive: a good model should not only recognize a user's emotion, but also improve the user's emotional and relational state over several turns. We introduce EIBench, a simulator-based benchmark for interactive emotion management. EIBench contains 2,222 scenarios, with 2,009 for training and 213 for held-out testing. The scenarios are organized by a 2x2 taxonomy covering Support, Defense, Repair, and Charm, which together capture different forms of support, boundary maintenance, trust repair, and rapport building. In each scenario, an LLM simulator plays the user, updates an emotion-relation state after each turn, and maps the final state to an anchor-based score. This design makes EIBench both an evaluation benchmark and a training environment: the final state gives the outcome reward, while the per-turn state updates provide dense feedback for RL. We evaluate 15 open- and closed-source LLMs. Current models perform well on support and rapport-building scenes, but struggle with boundary maintenance under user pressure. To improve the EI ability of LLMs, we propose Centered Turn-Credit GRPO (CTC-GRPO), a GRPO extension that reuses the simulator's per-turn state updates as dense turn-level feedback while preserving the final outcome reward. CTC-GRPO improves Qwen3-8B from -22.4 to +22.4 on EIBench and also improves on out-of-distribution evaluations including SAGE (+12.4) and EQBench3 (+20.9%). Our results show that simulator-tracked user states can support both evaluation and training for multi-turn emotion management."}],"geoLocations":[],"fundingReferences":[],"url":"https://arxiv.org/abs/2606.15532","contentUrl":null,"metadataVersion":0,"schemaVersion":"http://datacite.org/schema/kernel-4","source":"mds","isActive":true,"state":"findable","reason":null,"viewCount":0,"downloadCount":0,"referenceCount":0,"citationCount":0,"partCount":0,"partOfCount":0,"versionCount":0,"versionOfCount":0,"created":"2026-06-16T03:25:51Z","registered":"2026-06-16T03:25:52Z","published":null,"updated":"2026-06-16T03:25:52Z"},"relationships":{"client":{"data":{"id":"arxiv.content","type":"clients"}}}},{"id":"10.48550/arxiv.2606.15521","type":"dois","attributes":{"doi":"10.48550/arxiv.2606.15521","identifiers":[{"identifier":"2606.15521","identifierType":"arXiv"}],"creators":[{"nameType":"Personal","givenName":"Kanishk","familyName":"Jain","name":"Jain, Kanishk","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Matthew","familyName":"Day","name":"Day, Matthew","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Tankut","familyName":"Can","name":"Can, Tankut","affiliation":[],"nameIdentifiers":[]}],"titles":[{"title":"Emergent retokenization symmetry in large language models: phenomenology and applications"}],"publisher":"arXiv","container":{},"publicationYear":2026,"subjects":[{"subject":"Computation and Language (cs.CL)","lang":"en","subjectScheme":"arXiv"},{"subject":"Machine Learning (cs.LG)","lang":"en","subjectScheme":"arXiv"},{"subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"},{"schemeUri":"http://www.oecd.org/science/inno/38235147.pdf","subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"}],"contributors":[],"dates":[{"date":"2026-06-14T00:38:50Z","dateType":"Submitted","dateInformation":"v1"},{"date":"2026-06-16T00:45:50Z","dateType":"Updated","dateInformation":"v1"},{"date":"2026-06","dateType":"Available","dateInformation":"v1"},{"date":"2026","dateType":"Issued"}],"language":null,"types":{"schemaOrg":"CreativeWork","resourceTypeGeneral":"Preprint","citeproc":"article","bibtex":"misc","ris":"GEN","resourceType":"Article"},"relatedIdentifiers":[],"relatedItems":[],"sizes":[],"formats":[],"version":"1","rightsList":[{"rightsIdentifierScheme":"SPDX","rightsUri":"https://creativecommons.org/licenses/by/4.0/legalcode","schemeUri":"https://spdx.org/licenses/","rights":"Creative Commons Attribution 4.0 International","rightsIdentifier":"cc-by-4.0"}],"descriptions":[{"descriptionType":"Abstract","description":"Tokenization introduces representational redundancy: under a fixed token vocabulary, every byte string admits many valid token encodings, or segmentations, that decode to the same surface string. However, given a prompt, most language model tokenizers break this representational symmetry by returning a canonical segmentation. Training only on canonical segmentations should influence inference behavior, and there is little reason to expect models to respect segmentation symmetry on downstream tasks. We find that this symmetry partially emerges during training. Here, we probe this emergent symmetry through experiments testing token compositional understanding, representation diversity, and task focused benchmark performance. We primarily use \\textbf{retokenization} -- replacing a prompt's canonical tokenization with an alternative segmentation while preserving its bytes exactly. Relative to other prompt perturbations, retokenization is unusually clean because it isolates segmentation effects without changing syntax, semantics or surface form. We use retokenization to study sensitivity and robustness to semantically identical input representations across pretraining and post-training. Moreover, this partial retokenization symmetry suggests a distinct inference-time sampling axis. While temperature sampling generates diverse outputs from the model using its next-token probability distribution, retokenization generates diversity from the model's internal computations through semantically equivalent input representations. We find that while this retokenization sampling strategy can hurt performance on easy problems, it can also recover solutions that conventional sampling does not find. Overall, our work presents retokenization as a simple yet powerful probe of large language models, shedding light on compositional understanding and prompt sensitivity, and offering a novel sampling strategy."}],"geoLocations":[],"fundingReferences":[],"url":"https://arxiv.org/abs/2606.15521","contentUrl":null,"metadataVersion":0,"schemaVersion":"http://datacite.org/schema/kernel-4","source":"mds","isActive":true,"state":"findable","reason":null,"viewCount":0,"downloadCount":0,"referenceCount":0,"citationCount":0,"partCount":0,"partOfCount":0,"versionCount":0,"versionOfCount":0,"created":"2026-06-16T03:25:37Z","registered":"2026-06-16T03:25:38Z","published":null,"updated":"2026-06-16T03:25:38Z"},"relationships":{"client":{"data":{"id":"arxiv.content","type":"clients"}}}},{"id":"10.48550/arxiv.2606.15512","type":"dois","attributes":{"doi":"10.48550/arxiv.2606.15512","identifiers":[{"identifier":"2606.15512","identifierType":"arXiv"}],"creators":[{"nameType":"Personal","givenName":"Jay Phil","familyName":"Yoo","name":"Yoo, Jay Phil","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"William","familyName":"Howes","name":"Howes, William","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Yashika","familyName":"Ghai","name":"Ghai, Yashika","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Kazuma","familyName":"Kobayashi","name":"Kobayashi, Kazuma","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Souvik","familyName":"Chakraborty","name":"Chakraborty, Souvik","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Syed Bahauddin","familyName":"Alam","name":"Alam, Syed Bahauddin","affiliation":[],"nameIdentifiers":[]}],"titles":[{"title":"Towards Data-Efficient Cross-Device Generalization of Grad-Shafranov Equilibria via Transfer Learning Neural Operator"}],"publisher":"arXiv","container":{},"publicationYear":2026,"subjects":[{"subject":"Machine Learning (cs.LG)","lang":"en","subjectScheme":"arXiv"},{"subject":"Plasma Physics (physics.plasm-ph)","lang":"en","subjectScheme":"arXiv"},{"subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"},{"schemeUri":"http://www.oecd.org/science/inno/38235147.pdf","subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"},{"subject":"FOS: Physical sciences","subjectScheme":"Fields of Science and Technology (FOS)"},{"schemeUri":"http://www.oecd.org/science/inno/38235147.pdf","subject":"FOS: Physical sciences","subjectScheme":"Fields of Science and Technology (FOS)"}],"contributors":[],"dates":[{"date":"2026-06-13T23:47:19Z","dateType":"Submitted","dateInformation":"v1"},{"date":"2026-06-16T00:45:05Z","dateType":"Updated","dateInformation":"v1"},{"date":"2026-06","dateType":"Available","dateInformation":"v1"},{"date":"2026","dateType":"Issued"}],"language":null,"types":{"schemaOrg":"CreativeWork","resourceTypeGeneral":"Preprint","citeproc":"article","bibtex":"misc","ris":"GEN","resourceType":"Article"},"relatedIdentifiers":[],"relatedItems":[],"sizes":[],"formats":[],"version":"1","rightsList":[{"rightsUri":"http://arxiv.org/licenses/nonexclusive-distrib/1.0/","rights":"arXiv.org perpetual, non-exclusive license"}],"descriptions":[{"descriptionType":"Abstract","description":"Real-time reconstruction of magnetohydrodynamic equilibria is essential for plasma shaping, stability assessment and feedback control in magnetic confinement fusion. However, Grad-Shafranov equilibrium calculations remain largely device-specific and iterative, limiting their use in latency-constrained control settings. Existing neural approaches can accelerate individual equilibrium predictions, but they do not generally provide reusable models across changing plasma boundaries or tokamak geometries. Here we show that equilibrium reconstruction can be recast as a cross-device operator learning problem. We develop a domain-specific neural operator framework that maps geometry and profile parameters directly to the poloidal flux field, replacing repeated solve-on-demand computation with amortized operator inference. Using the analytically tractable Solov'ev family as a controlled Grad-Shafranov testbed, we generate equilibria across eight geometrically distinct tokamak-like configurations and benchmark five neural operator architectures under four transfer-learning strategies. Single-geometry pretraining gives poor transfer to unseen devices, whereas multi-geometry pretraining enables data-efficient adaptation. The Wavelet Neural Operator gives the strongest cross-geometry performance, reaching mean relative L2 errors below 4% with 100 labelled target equilibria and below 2% with full fine-tuning. The predicted magnetic fields satisfy the divergence-free constraint to numerical precision, and four architectures achieve millisecond or sub-millisecond inference. These results identify neural operator pretraining as a route towards reusable, real-time equilibrium inference across fusion device configurations."}],"geoLocations":[],"fundingReferences":[],"url":"https://arxiv.org/abs/2606.15512","contentUrl":null,"metadataVersion":0,"schemaVersion":"http://datacite.org/schema/kernel-4","source":"mds","isActive":true,"state":"findable","reason":null,"viewCount":0,"downloadCount":0,"referenceCount":0,"citationCount":0,"partCount":0,"partOfCount":0,"versionCount":0,"versionOfCount":0,"created":"2026-06-16T03:25:25Z","registered":"2026-06-16T03:25:26Z","published":null,"updated":"2026-06-16T03:25:26Z"},"relationships":{"client":{"data":{"id":"arxiv.content","type":"clients"}}}},{"id":"10.48550/arxiv.2606.15493","type":"dois","attributes":{"doi":"10.48550/arxiv.2606.15493","identifiers":[{"identifier":"2606.15493","identifierType":"arXiv"}],"creators":[{"nameType":"Personal","givenName":"Eliott","familyName":"Baltz","name":"Baltz, Eliott","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Satoshi","familyName":"Hara","name":"Hara, Satoshi","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Ulrich","familyName":"Aïvodji","name":"Aïvodji, Ulrich","affiliation":[],"nameIdentifiers":[]}],"titles":[{"title":"Model Stealing Through the Lens of Model Multiplicity"}],"publisher":"arXiv","container":{},"publicationYear":2026,"subjects":[{"subject":"Machine Learning (cs.LG)","lang":"en","subjectScheme":"arXiv"},{"subject":"Cryptography and Security (cs.CR)","lang":"en","subjectScheme":"arXiv"},{"subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"},{"schemeUri":"http://www.oecd.org/science/inno/38235147.pdf","subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"}],"contributors":[],"dates":[{"date":"2026-06-13T22:35:29Z","dateType":"Submitted","dateInformation":"v1"},{"date":"2026-06-16T00:44:28Z","dateType":"Updated","dateInformation":"v1"},{"date":"2026-06","dateType":"Available","dateInformation":"v1"},{"date":"2026","dateType":"Issued"}],"language":null,"types":{"schemaOrg":"CreativeWork","resourceTypeGeneral":"Preprint","citeproc":"article","bibtex":"misc","ris":"GEN","resourceType":"Article"},"relatedIdentifiers":[],"relatedItems":[],"sizes":[],"formats":[],"version":"1","rightsList":[{"rightsIdentifierScheme":"SPDX","rightsUri":"https://creativecommons.org/licenses/by/4.0/legalcode","schemeUri":"https://spdx.org/licenses/","rights":"Creative Commons Attribution 4.0 International","rightsIdentifier":"cc-by-4.0"}],"descriptions":[{"descriptionType":"Abstract","description":"Model stealing attacks, where adversaries create high-fidelity surrogate models, are a significant threat to the intellectual property of machine learning services. Conventional wisdom suggests these surrogates could provide adversaries with economic leverage comparable to the original service providers. This paper challenges this assumption by evaluating model stealing attacks beyond mere fidelity to the target model. Because query-based extraction provides only partial supervision of the target's input-output behavior, the surrogate is not uniquely identified: many near-optimal surrogates can achieve comparable fidelity while differing in deployment-relevant properties. Instead of performing a classic learning-based model stealing attack, we compute the Rashomon Set (i.e., the set of almost-equally-accurate models) of surrogate models, and evaluate its diversity using multiplicity metrics (ambiguity, discrepancy, and Rashomon Capacity) and group fairness metrics. Across tabular, medical imaging, and NLP tasks, our experiments on real-world datasets reveal that despite exhibiting similar fidelity to the target model, surrogate models can display significant variances in other critical performance metrics. These findings cast doubt on the presumed equivalence between high-fidelity surrogates and the target model in practical deployment scenarios."},{"descriptionType":"Other","description":"14 pages, 15 figures"}],"geoLocations":[],"fundingReferences":[],"url":"https://arxiv.org/abs/2606.15493","contentUrl":null,"metadataVersion":0,"schemaVersion":"http://datacite.org/schema/kernel-4","source":"mds","isActive":true,"state":"findable","reason":null,"viewCount":0,"downloadCount":0,"referenceCount":0,"citationCount":0,"partCount":0,"partOfCount":0,"versionCount":0,"versionOfCount":0,"created":"2026-06-16T03:24:58Z","registered":"2026-06-16T03:24:59Z","published":null,"updated":"2026-06-16T03:24:59Z"},"relationships":{"client":{"data":{"id":"arxiv.content","type":"clients"}}}},{"id":"10.48550/arxiv.2606.15483","type":"dois","attributes":{"doi":"10.48550/arxiv.2606.15483","identifiers":[{"identifier":"2606.15483","identifierType":"arXiv"}],"creators":[{"nameType":"Personal","givenName":"Gokhan","familyName":"Dogru","name":"Dogru, Gokhan","affiliation":[],"nameIdentifiers":[]}],"titles":[{"title":"Evaluative Judgement in Teaching AI-based Translation: A Class-room Case Study of AI-Mediated Translation and Post-Editing"}],"publisher":"arXiv","container":{},"publicationYear":2026,"subjects":[{"subject":"Computation and Language (cs.CL)","lang":"en","subjectScheme":"arXiv"},{"subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"},{"schemeUri":"http://www.oecd.org/science/inno/38235147.pdf","subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"}],"contributors":[],"dates":[{"date":"2026-06-13T21:34:50Z","dateType":"Submitted","dateInformation":"v1"},{"date":"2026-06-16T00:43:28Z","dateType":"Updated","dateInformation":"v1"},{"date":"2026-06","dateType":"Available","dateInformation":"v1"},{"date":"2026","dateType":"Issued"}],"language":null,"types":{"schemaOrg":"CreativeWork","resourceTypeGeneral":"Preprint","citeproc":"article","bibtex":"misc","ris":"GEN","resourceType":"Article"},"relatedIdentifiers":[],"relatedItems":[],"sizes":[],"formats":[],"version":"1","rightsList":[{"rightsIdentifierScheme":"SPDX","rightsUri":"https://creativecommons.org/licenses/by/4.0/legalcode","schemeUri":"https://spdx.org/licenses/","rights":"Creative Commons Attribution 4.0 International","rightsIdentifier":"cc-by-4.0"}],"descriptions":[{"descriptionType":"Abstract","description":"Drawing on 23 anonymized student pro-jects from a fourth-year Machine Transla-tion and Post-editing course in a BA-level translation programme, this paper exam-ines how structured comparison of gen-eral-purpose LLMs and online MT sys-tems can elicit evaluative judgement in AI-mediated translation. Students translat-ed short specialised English Wikipedia texts into Catalan or Spanish, generated four system outputs, evaluated them using automatic metrics and human adequa-cy/fluency assessment, selected one output for post-editing, and justified their deci-sion in written reports. Descriptive counts are reported for all 23 projects, while qualitative interpretation is based on the 22 cases accompanied by written reports. Results show that students did not treat automatic metrics as final authority: final post-editing selections often diverged from metric rankings and were justified through adequacy, fluency, terminology, naturalness, and expected post-editing ef-fort. The study therefore does not bench-mark systems under controlled conditions; it analyses how students justified system choice within an authentic classroom as-signment."},{"descriptionType":"Other","description":"Workshop on Teaching AI-based Translation and Technologies (TAITT 2026) - EAMT 2026"}],"geoLocations":[],"fundingReferences":[],"url":"https://arxiv.org/abs/2606.15483","contentUrl":null,"metadataVersion":0,"schemaVersion":"http://datacite.org/schema/kernel-4","source":"mds","isActive":true,"state":"findable","reason":null,"viewCount":0,"downloadCount":0,"referenceCount":0,"citationCount":0,"partCount":0,"partOfCount":0,"versionCount":0,"versionOfCount":0,"created":"2026-06-16T03:24:46Z","registered":"2026-06-16T03:24:46Z","published":null,"updated":"2026-06-16T03:24:46Z"},"relationships":{"client":{"data":{"id":"arxiv.content","type":"clients"}}}},{"id":"10.48550/arxiv.2606.15479","type":"dois","attributes":{"doi":"10.48550/arxiv.2606.15479","identifiers":[{"identifier":"2606.15479","identifierType":"arXiv"}],"creators":[{"nameType":"Personal","givenName":"Abhishek","familyName":"Keripale","name":"Keripale, Abhishek","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Ponkrshnan","familyName":"Thiagarajan","name":"Thiagarajan, Ponkrshnan","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Susanta","familyName":"Ghosh","name":"Ghosh, Susanta","affiliation":[],"nameIdentifiers":[]}],"titles":[{"title":"Bayesian 3D Steerable CNNs: Enabling Equivariance and Uncertainty Quantification Simultaneously"}],"publisher":"arXiv","container":{},"publicationYear":2026,"subjects":[{"subject":"Machine Learning (cs.LG)","lang":"en","subjectScheme":"arXiv"},{"subject":"Artificial Intelligence (cs.AI)","lang":"en","subjectScheme":"arXiv"},{"subject":"Probability (math.PR)","lang":"en","subjectScheme":"arXiv"},{"subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"},{"schemeUri":"http://www.oecd.org/science/inno/38235147.pdf","subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"},{"subject":"FOS: Mathematics","subjectScheme":"Fields of Science and Technology (FOS)"},{"schemeUri":"http://www.oecd.org/science/inno/38235147.pdf","subject":"FOS: Mathematics","subjectScheme":"Fields of Science and Technology (FOS)"}],"contributors":[],"dates":[{"date":"2026-06-13T21:28:04Z","dateType":"Submitted","dateInformation":"v1"},{"date":"2026-06-16T00:43:15Z","dateType":"Updated","dateInformation":"v1"},{"date":"2026-06","dateType":"Available","dateInformation":"v1"},{"date":"2026","dateType":"Issued"}],"language":null,"types":{"schemaOrg":"CreativeWork","resourceTypeGeneral":"Preprint","citeproc":"article","bibtex":"misc","ris":"GEN","resourceType":"Article"},"relatedIdentifiers":[],"relatedItems":[],"sizes":[],"formats":[],"version":"1","rightsList":[{"rightsIdentifierScheme":"SPDX","rightsUri":"https://creativecommons.org/licenses/by/4.0/legalcode","schemeUri":"https://spdx.org/licenses/","rights":"Creative Commons Attribution 4.0 International","rightsIdentifier":"cc-by-4.0"}],"descriptions":[{"descriptionType":"Abstract","description":"Steerable convolutional neural networks (Steerable-CNNs) guarantee SE(3)-equivariance by parameterizing kernels as linear combinations of steerable basis functions, but their deterministic nature precludes uncertainty quantification - limiting their use in settings where confidence estimates are essential. We propose a Bayesian Steerable-CNN that places posterior distributions over the basis coefficients, yielding stochastic kernels while preserving equivariance exactly. The loss function of the model is obtained via variational inference and minimized by Bayes-by-Backpropagation. The framework admits a decomposition of predictive uncertainty into epistemic and aleatoric components. Empirically, the model attains competitive classification accuracy alongside an expected calibration error of 0.0263 and outperforms its deterministic counterpart by up to 6.17% under distributional shift induced by additive Gaussian noise. Furthermore, we leverage the model's uncertainty estimates to enhance its performance significantly, achieving a notable gain - approximately 4% higher accuracy across 84% of the test dataset. A statistically significant negative correlation between epistemic uncertainty and prediction error confirms that the learned posterior variance is semantically meaningful. The framework unifies Bayesian uncertainty quantification with the inductive bias of equivariant CNNs."}],"geoLocations":[],"fundingReferences":[],"url":"https://arxiv.org/abs/2606.15479","contentUrl":null,"metadataVersion":0,"schemaVersion":"http://datacite.org/schema/kernel-4","source":"mds","isActive":true,"state":"findable","reason":null,"viewCount":0,"downloadCount":0,"referenceCount":0,"citationCount":0,"partCount":0,"partOfCount":0,"versionCount":0,"versionOfCount":0,"created":"2026-06-16T03:24:41Z","registered":"2026-06-16T03:24:41Z","published":null,"updated":"2026-06-16T03:24:41Z"},"relationships":{"client":{"data":{"id":"arxiv.content","type":"clients"}}}},{"id":"10.48550/arxiv.2606.15461","type":"dois","attributes":{"doi":"10.48550/arxiv.2606.15461","identifiers":[{"identifier":"2606.15461","identifierType":"arXiv"}],"creators":[{"nameType":"Personal","givenName":"Pierre","familyName":"Dantas","name":"Dantas, Pierre","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Lucas","familyName":"Cordeiro","name":"Cordeiro, Lucas","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Waldir","familyName":"Junior","name":"Junior, Waldir","affiliation":[],"nameIdentifiers":[]}],"titles":[{"title":"ESBMC-PLC: Formal Verification of IEC 61131-3 Ladder Diagram Programs Using SMT-Based Model Checking"}],"publisher":"arXiv","container":{},"publicationYear":2026,"subjects":[{"subject":"Computation and Language (cs.CL)","lang":"en","subjectScheme":"arXiv"},{"subject":"Hardware Architecture (cs.AR)","lang":"en","subjectScheme":"arXiv"},{"subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"},{"schemeUri":"http://www.oecd.org/science/inno/38235147.pdf","subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"}],"contributors":[],"dates":[{"date":"2026-06-13T20:39:49Z","dateType":"Submitted","dateInformation":"v1"},{"date":"2026-06-16T00:42:24Z","dateType":"Updated","dateInformation":"v1"},{"date":"2026-06","dateType":"Available","dateInformation":"v1"},{"date":"2026","dateType":"Issued"}],"language":null,"types":{"schemaOrg":"CreativeWork","resourceTypeGeneral":"Preprint","citeproc":"article","bibtex":"misc","ris":"GEN","resourceType":"Article"},"relatedIdentifiers":[],"relatedItems":[],"sizes":[],"formats":[],"version":"1","rightsList":[{"rightsIdentifierScheme":"SPDX","rightsUri":"https://creativecommons.org/licenses/by/4.0/legalcode","schemeUri":"https://spdx.org/licenses/","rights":"Creative Commons Attribution 4.0 International","rightsIdentifier":"cc-by-4.0"}],"descriptions":[{"descriptionType":"Abstract","description":"PLCs execute safety-critical programs across industrial sectors. The dominant PLC notation, ladder diagram (LD) per IEC 61131-3, remains absent from formal verification: SMT-based model checkers cannot process LD's rung-and-coil graphics. This paper presents ESBMC-PLC, the first open-source formal verifier with native LD support (PLCopen XML format), implemented as a new ESBMC frontend. ESBMC-PLC translates LD rungs to GOTO IR, models the PLC scan cycle as a while(true) loop with nondeterministic inputs, and checks safety properties via SMT-based bounded model checking or k-induction. A five-property YAML language (mutual_exclusion, invariant, absence, response, reachability) avoids temporal logic. A survey of 22 studies (2020-2026) identifies four research gaps; ESBMC-PLC closes two of them. Evaluation on 13 benchmarks (6 domains, 3 sources - including deployed CONTROLLINO PLCs and MathWorks Simulink PLC Coder) shows correct classification across 61 properties: all 9 author-constructed programs (Categories A/B) as expected, all 4 vendor programs (Category C) correctly unlabeled, with 8 bugs found (actionable counterexamples), 7 unbounded k-induction proofs, all runs under 60ms on Apple Silicon. Feature comparison with PLCverif shows that ESBMC-PLC is the only open-source tool that combines native LD, k-induction, and SMT bit-vector semantics."},{"descriptionType":"Other","description":"24 pages"}],"geoLocations":[],"fundingReferences":[],"url":"https://arxiv.org/abs/2606.15461","contentUrl":null,"metadataVersion":0,"schemaVersion":"http://datacite.org/schema/kernel-4","source":"mds","isActive":true,"state":"findable","reason":null,"viewCount":0,"downloadCount":0,"referenceCount":0,"citationCount":0,"partCount":0,"partOfCount":0,"versionCount":0,"versionOfCount":0,"created":"2026-06-16T03:24:18Z","registered":"2026-06-16T03:24:18Z","published":null,"updated":"2026-06-16T03:24:18Z"},"relationships":{"client":{"data":{"id":"arxiv.content","type":"clients"}}}},{"id":"10.48550/arxiv.2606.15455","type":"dois","attributes":{"doi":"10.48550/arxiv.2606.15455","identifiers":[{"identifier":"2606.15455","identifierType":"arXiv"}],"creators":[{"nameType":"Personal","givenName":"Suqin","familyName":"Yuan","name":"Yuan, Suqin","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Jinkun","familyName":"Chen","name":"Chen, Jinkun","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Jiyang","familyName":"Zheng","name":"Zheng, Jiyang","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Muyang","familyName":"Li","name":"Li, Muyang","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Lei","familyName":"Feng","name":"Feng, Lei","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Dadong","familyName":"Wang","name":"Wang, Dadong","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Tao","familyName":"Xiang","name":"Xiang, Tao","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Tongliang","familyName":"Liu","name":"Liu, Tongliang","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Bo","familyName":"An","name":"An, Bo","affiliation":[],"nameIdentifiers":[]}],"titles":[{"title":"Understanding Diversity Collapse in RLVR via the Lens of Overtraining"}],"publisher":"arXiv","container":{},"publicationYear":2026,"subjects":[{"subject":"Machine Learning (cs.LG)","lang":"en","subjectScheme":"arXiv"},{"subject":"Artificial Intelligence (cs.AI)","lang":"en","subjectScheme":"arXiv"},{"subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"},{"schemeUri":"http://www.oecd.org/science/inno/38235147.pdf","subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"}],"contributors":[],"dates":[{"date":"2026-06-13T20:13:37Z","dateType":"Submitted","dateInformation":"v1"},{"date":"2026-06-16T00:41:55Z","dateType":"Updated","dateInformation":"v1"},{"date":"2026-06","dateType":"Available","dateInformation":"v1"},{"date":"2026","dateType":"Issued"}],"language":null,"types":{"schemaOrg":"CreativeWork","resourceTypeGeneral":"Preprint","citeproc":"article","bibtex":"misc","ris":"GEN","resourceType":"Article"},"relatedIdentifiers":[],"relatedItems":[],"sizes":[],"formats":[],"version":"1","rightsList":[{"rightsIdentifierScheme":"SPDX","rightsUri":"https://creativecommons.org/licenses/by/4.0/legalcode","schemeUri":"https://spdx.org/licenses/","rights":"Creative Commons Attribution 4.0 International","rightsIdentifier":"cc-by-4.0"}],"descriptions":[{"descriptionType":"Abstract","description":"Reinforcement learning with verifiable rewards (RLVR) has become a key approach for enhancing the reasoning abilities of large language models. However, RLVR often suffers from \\emph{diversity collapse}: Pass@$1$ improves while high-$k$ Pass@$k$ degrades, which is viewed as a narrowing of the model's reasoning boundary. We formalize this diversity collapse through the lens of \\emph{overtraining}: once a problem's contribution to the reference metric has effectively saturated, further updates no longer expand what the model can solve but still concentrate probability mass on the trajectories favored by on-policy sampling. Under a standard setup with few rollouts per problem, even a single observed success places a problem in a nearly saturated regime for high-$k$ Pass@$k$, so most updates in standard RLVR are overtraining from the boundary perspective. This perspective also suggests a reading of whether RLVR can expand the model's reasoning abilities beyond the base model: since RLVR is structurally biased against high-$k$ Pass@$k$, its aggregate decline does not by itself mean that no new reasoning gains occurred. Interventionally, restricting updates to problems with zero observed success lifts Pass@$256$ above the base model on difficult benchmarks; observationally, a non-trivial fraction of initially unsolvable problems become solvable during standard RLVR training. Building on these findings, we propose \\emph{Bayesian Boundary Gating} (BBG), which redirects optimization away from overtraining by estimating each problem's marginal contribution to the reasoning boundary. Across multiple reasoning benchmarks, BBG improves average Pass@$k$ across a wide range of $k$."}],"geoLocations":[],"fundingReferences":[],"url":"https://arxiv.org/abs/2606.15455","contentUrl":null,"metadataVersion":0,"schemaVersion":"http://datacite.org/schema/kernel-4","source":"mds","isActive":true,"state":"findable","reason":null,"viewCount":0,"downloadCount":0,"referenceCount":0,"citationCount":0,"partCount":0,"partOfCount":0,"versionCount":0,"versionOfCount":0,"created":"2026-06-16T03:24:10Z","registered":"2026-06-16T03:24:11Z","published":null,"updated":"2026-06-16T03:24:11Z"},"relationships":{"client":{"data":{"id":"arxiv.content","type":"clients"}}}},{"id":"10.48550/arxiv.2606.15452","type":"dois","attributes":{"doi":"10.48550/arxiv.2606.15452","identifiers":[{"identifier":"2606.15452","identifierType":"arXiv"}],"creators":[{"nameType":"Personal","givenName":"Emre","familyName":"Yusuf","name":"Yusuf, Emre","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Ren","familyName":"Takahashi","name":"Takahashi, Ren","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Jayabrata","familyName":"Bhaduri","name":"Bhaduri, Jayabrata","affiliation":[],"nameIdentifiers":[]}],"titles":[{"title":"PHINN: Persistent Homology Inspired Neural Network for Rare-Event Time Series Generation"}],"publisher":"arXiv","container":{},"publicationYear":2026,"subjects":[{"subject":"Machine Learning (cs.LG)","lang":"en","subjectScheme":"arXiv"},{"subject":"Algebraic Topology (math.AT)","lang":"en","subjectScheme":"arXiv"},{"subject":"Risk Management (q-fin.RM)","lang":"en","subjectScheme":"arXiv"},{"subject":"Machine Learning (stat.ML)","lang":"en","subjectScheme":"arXiv"},{"subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"},{"schemeUri":"http://www.oecd.org/science/inno/38235147.pdf","subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"},{"subject":"FOS: Mathematics","subjectScheme":"Fields of Science and Technology (FOS)"},{"schemeUri":"http://www.oecd.org/science/inno/38235147.pdf","subject":"FOS: Mathematics","subjectScheme":"Fields of Science and Technology (FOS)"},{"subject":"FOS: Economics and business","subjectScheme":"Fields of Science and Technology (FOS)"},{"schemeUri":"http://www.oecd.org/science/inno/38235147.pdf","subject":"FOS: Economics and business","subjectScheme":"Fields of Science and Technology (FOS)"}],"contributors":[],"dates":[{"date":"2026-06-13T19:56:57Z","dateType":"Submitted","dateInformation":"v1"},{"date":"2026-06-16T00:41:42Z","dateType":"Updated","dateInformation":"v1"},{"date":"2026-06","dateType":"Available","dateInformation":"v1"},{"date":"2026","dateType":"Issued"}],"language":null,"types":{"schemaOrg":"CreativeWork","resourceTypeGeneral":"Preprint","citeproc":"article","bibtex":"misc","ris":"GEN","resourceType":"Article"},"relatedIdentifiers":[],"relatedItems":[],"sizes":[],"formats":[],"version":"1","rightsList":[{"rightsIdentifierScheme":"SPDX","rightsUri":"https://creativecommons.org/publicdomain/zero/1.0/legalcode","schemeUri":"https://spdx.org/licenses/","rights":"Creative Commons Zero v1.0 Universal","rightsIdentifier":"cc0-1.0"}],"descriptions":[{"descriptionType":"Abstract","description":"Rare events in time series are critical to model but hard to learn due to data scarcity. Current generative models struggle with extreme values. We observe that rare events leave distinct topological fingerprints - transitions in Betti numbers from point-cloud embeddings - that are more stable and discriminative than statistical moments.\n We introduce PHINN, a flow-matching framework using dynamic Betti curves as conditioning signals and a persistence landscape loss for homology consistency. It scales to multivariate data, includes a natural-language interface to set Betti targets, supports cross-domain meta-learning and few-shot generation, and provides certified adversarial robustness.\n On financial, epidemiological, and multi-modal benchmarks, PHINN outperforms statistical and diffusion baselines in topological fidelity (beta-RMSE down 41-63%, transition accuracy up 84%) and matches jump-diffusion models in tail coverage while exceeding them in shape fidelity. All results have 95% confidence intervals."},{"descriptionType":"Other","description":"15 pages, 4 figures"}],"geoLocations":[],"fundingReferences":[],"url":"https://arxiv.org/abs/2606.15452","contentUrl":null,"metadataVersion":0,"schemaVersion":"http://datacite.org/schema/kernel-4","source":"mds","isActive":true,"state":"findable","reason":null,"viewCount":0,"downloadCount":0,"referenceCount":0,"citationCount":0,"partCount":0,"partOfCount":0,"versionCount":0,"versionOfCount":0,"created":"2026-06-16T03:24:06Z","registered":"2026-06-16T03:24:07Z","published":null,"updated":"2026-06-16T03:24:07Z"},"relationships":{"client":{"data":{"id":"arxiv.content","type":"clients"}}}},{"id":"10.48550/arxiv.2606.15449","type":"dois","attributes":{"doi":"10.48550/arxiv.2606.15449","identifiers":[{"identifier":"2606.15449","identifierType":"arXiv"}],"creators":[{"nameType":"Personal","givenName":"Maxim","familyName":"Gorshkov","name":"Gorshkov, Maxim","affiliation":[],"nameIdentifiers":[]}],"titles":[{"title":"Transfer Learning for FHIR Questionnaire Terminology Binding"}],"publisher":"arXiv","container":{},"publicationYear":2026,"subjects":[{"subject":"Computation and Language (cs.CL)","lang":"en","subjectScheme":"arXiv"},{"subject":"Information Retrieval (cs.IR)","lang":"en","subjectScheme":"arXiv"},{"subject":"Machine Learning (cs.LG)","lang":"en","subjectScheme":"arXiv"},{"subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"},{"schemeUri":"http://www.oecd.org/science/inno/38235147.pdf","subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"}],"contributors":[],"dates":[{"date":"2026-06-13T19:46:44Z","dateType":"Submitted","dateInformation":"v1"},{"date":"2026-06-16T00:41:37Z","dateType":"Updated","dateInformation":"v1"},{"date":"2026-06","dateType":"Available","dateInformation":"v1"},{"date":"2026","dateType":"Issued"}],"language":null,"types":{"schemaOrg":"CreativeWork","resourceTypeGeneral":"Preprint","citeproc":"article","bibtex":"misc","ris":"GEN","resourceType":"Article"},"relatedIdentifiers":[],"relatedItems":[],"sizes":[],"formats":[],"version":"1","rightsList":[{"rightsUri":"http://arxiv.org/licenses/nonexclusive-distrib/1.0/","rights":"arXiv.org perpetual, non-exclusive license"}],"descriptions":[{"descriptionType":"Abstract","description":"Electronic prior authorization workflows require FHIR Questionnaire items to carry LOINC codes, yet most items in the HL7 Da Vinci CDS-Library lack these bindings. We treat this as a retrieval problem: given a Questionnaire item's text, find the correct LOINC code in a pool of 97,314 active codes. We compare six methods (TF-IDF, frozen MiniLM, BioBERT, BioLORD, contrastively fine-tuned MiniLM, and a TF-IDF+GPT reranker) on a 54-item evaluation set spanning three query styles (natural question, medium, and terse). No single method wins on every metric. BioLORD, a frozen encoder pre-trained on biomedical ontology definitions, has the best top-rank accuracy (R@1 = 0.185, MRR = 0.246) despite seeing no task-specific data, while a contrastive fine-tune on raw LHC-Forms pairs takes R@5 (0.389) and R@10 (0.426). A distribution-shift ablation shows why the fine-tune in our main table is not the strongest one: adding GPT-generated paraphrases to the raw pairs drops R@5 from 0.389 to 0.296, so the augmented union underperforms raw-only training on every metric except R@1. Performance peaks at 5k training pairs. Error analysis on BioLORD's R@1 failures shows that wrong-specificity and ambiguous-text cases together account for 59% of errors."}],"geoLocations":[],"fundingReferences":[],"url":"https://arxiv.org/abs/2606.15449","contentUrl":null,"metadataVersion":0,"schemaVersion":"http://datacite.org/schema/kernel-4","source":"mds","isActive":true,"state":"findable","reason":null,"viewCount":0,"downloadCount":0,"referenceCount":0,"citationCount":0,"partCount":0,"partOfCount":0,"versionCount":0,"versionOfCount":0,"created":"2026-06-16T03:24:02Z","registered":"2026-06-16T03:24:03Z","published":null,"updated":"2026-06-16T03:24:03Z"},"relationships":{"client":{"data":{"id":"arxiv.content","type":"clients"}}}},{"id":"10.48550/arxiv.2606.15436","type":"dois","attributes":{"doi":"10.48550/arxiv.2606.15436","identifiers":[{"identifier":"2606.15436","identifierType":"arXiv"}],"creators":[{"nameType":"Personal","givenName":"Mayur","familyName":"Sanap","name":"Sanap, Mayur","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Prasanna","familyName":"Desikan","name":"Desikan, Prasanna","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Edgar","familyName":"Lobaton","name":"Lobaton, Edgar","affiliation":[],"nameIdentifiers":[]}],"titles":[{"title":"Beyond Classification: A Cough Regression Benchmark for Respiratory Acoustic Foundation Models"}],"publisher":"arXiv","container":{},"publicationYear":2026,"subjects":[{"subject":"Machine Learning (cs.LG)","lang":"en","subjectScheme":"arXiv"},{"subject":"Artificial Intelligence (cs.AI)","lang":"en","subjectScheme":"arXiv"},{"subject":"Audio and Speech Processing (eess.AS)","lang":"en","subjectScheme":"arXiv"},{"subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"},{"schemeUri":"http://www.oecd.org/science/inno/38235147.pdf","subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"},{"subject":"FOS: Electrical engineering, electronic engineering, information engineering","subjectScheme":"Fields of Science and Technology (FOS)"},{"schemeUri":"http://www.oecd.org/science/inno/38235147.pdf","subject":"FOS: Electrical engineering, electronic engineering, information engineering","subjectScheme":"Fields of Science and Technology (FOS)"}],"contributors":[],"dates":[{"date":"2026-06-13T18:58:42Z","dateType":"Submitted","dateInformation":"v1"},{"date":"2026-06-16T00:41:01Z","dateType":"Updated","dateInformation":"v1"},{"date":"2026-06","dateType":"Available","dateInformation":"v1"},{"date":"2026","dateType":"Issued"}],"language":null,"types":{"schemaOrg":"CreativeWork","resourceTypeGeneral":"Preprint","citeproc":"article","bibtex":"misc","ris":"GEN","resourceType":"Article"},"relatedIdentifiers":[],"relatedItems":[],"sizes":[],"formats":[],"version":"1","rightsList":[{"rightsIdentifierScheme":"SPDX","rightsUri":"https://creativecommons.org/licenses/by/4.0/legalcode","schemeUri":"https://spdx.org/licenses/","rights":"Creative Commons Attribution 4.0 International","rightsIdentifier":"cc-by-4.0"}],"descriptions":[{"descriptionType":"Abstract","description":"Respiratory acoustic foundation models (FMs) excel at cough classification, yet their ability to predict continuous health quantities from cough audio remains largely unexplored, despite the clinical value of passive age, BMI, and disease probability estimation in settings where physical measurements are unavailable. We introduce the multi-model, multi-target cough regression benchmark evaluating five FMs (OPERA-CT, OPERA-CE, OPERA-GT, HeAR, M2D+Resp) across six targets on three datasets under subject-disjoint protocols, comparing linear, MLP-small, and full MLP regression heads. MLP-small beats the mean-predictor baseline on all tasks and linear probing in 23 of 30 model x task cases, with full MLP overfitting on small clinical data but recovering on larger sets, revealing a dataset size x head-capacity trade-off. HeAR leads within-dataset age regression on Coswara (9.12 yr MAE); its CIDRZ result is excluded from headline claims owing to possible HeAR-CIDRZ pretraining overlap. OPERA-GT is favored over OPERA-CT on age in all three datasets, with the CIDRZ margin within seed variance, extending a generative-pretraining advantage from breath to cough. HeAR and M2D+Resp reach near-full performance at N = 50 samples while OPERA models require N = 400. Cross-dataset transfer is strongly asymmetric as large diverse data generalises to small clinical populations (CoughVID to CIDRZ: -0.17 yr) but not vice versa (CIDRZ to Coswara: +2.43 yr, +26.6%)."},{"descriptionType":"Other","description":"Accepted at the ICML 2026 Workshop on Structured Data for Health"}],"geoLocations":[],"fundingReferences":[],"url":"https://arxiv.org/abs/2606.15436","contentUrl":null,"metadataVersion":0,"schemaVersion":"http://datacite.org/schema/kernel-4","source":"mds","isActive":true,"state":"findable","reason":null,"viewCount":0,"downloadCount":0,"referenceCount":0,"citationCount":0,"partCount":0,"partOfCount":0,"versionCount":0,"versionOfCount":0,"created":"2026-06-16T03:23:45Z","registered":"2026-06-16T03:23:46Z","published":null,"updated":"2026-06-16T03:23:46Z"},"relationships":{"client":{"data":{"id":"arxiv.content","type":"clients"}}}}],"meta":{"total":44,"totalPages":1,"page":1},"links":{"self":"https://api.datacite.org/dois?client-id=arxiv.content\u0026query=doi%3A%2810.48550%2Farxiv.2606.15436+OR+10.48550%2Farxiv.2606.15449+OR+10.48550%2Farxiv.2606.15452+OR+10.48550%2Farxiv.2606.15455+OR+10.48550%2Farxiv.2606.15461+OR+10.48550%2Farxiv.2606.15479+OR+10.48550%2Farxiv.2606.15483+OR+10.48550%2Farxiv.2606.15493+OR+10.48550%2Farxiv.2606.15510+OR+10.48550%2Farxiv.2606.15512+OR+10.48550%2Farxiv.2606.15517+OR+10.48550%2Farxiv.2606.15521+OR+10.48550%2Farxiv.2606.15531+OR+10.48550%2Farxiv.2606.15532+OR+10.48550%2Farxiv.2606.15551+OR+10.48550%2Farxiv.2606.15553+OR+10.48550%2Farxiv.2606.15566+OR+10.48550%2Farxiv.2606.15569+OR+10.48550%2Farxiv.2606.15576+OR+10.48550%2Farxiv.2606.15589+OR+10.48550%2Farxiv.2606.15610+OR+10.48550%2Farxiv.2606.15615+OR+10.48550%2Farxiv.2606.15621+OR+10.48550%2Farxiv.2606.15623+OR+10.48550%2Farxiv.2606.15625+OR+10.48550%2Farxiv.2606.15633+OR+10.48550%2Farxiv.2606.15637+OR+10.48550%2Farxiv.2606.15640+OR+10.48550%2Farxiv.2606.15641+OR+10.48550%2Farxiv.2606.15642+OR+10.48550%2Farxiv.2606.15643+OR+10.48550%2Farxiv.2606.15652+OR+10.48550%2Farxiv.2606.15669+OR+10.48550%2Farxiv.2606.15678+OR+10.48550%2Farxiv.2606.15682+OR+10.48550%2Farxiv.2606.15690+OR+10.48550%2Farxiv.2606.15695+OR+10.48550%2Farxiv.2606.15701+OR+10.