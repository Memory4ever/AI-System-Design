</figure></div><div class="ltx_flex_cell ltx_flex_size_3">
<figure id="S5.F2.sf2" class="ltx_figure ltx_figure_panel ltx_align_center"><img src="2606.14398v1/balance_relation20_experts7_heatmap.png" id="S5.F2.sf2.g1" class="ltx_graphics ltx_centering ltx_img_square" style="aspect-ratio:476/395;" width="476" height="395" alt="Refer to caption">
<figcaption class="ltx_caption ltx_centering"><span class="ltx_tag ltx_tag_figure">(b) </span>CE + Load Balancing loss</figcaption>
