<div id="lstnumberx41" class="ltx_listingline"><span id="lstnumberx41.1" class="ltx_text ltx_lst_identifier">You</span><span id="lstnumberx41.2" class="ltx_text ltx_lst_space"> </span><span id="lstnumberx41.3" class="ltx_text ltx_lst_identifier">are</span><span id="lstnumberx41.4" class="ltx_text ltx_lst_space"> </span><span id="lstnumberx41.5" class="ltx_text ltx_lst_identifier">a</span><span id="lstnumberx41.6" class="ltx_text ltx_lst_space"> </span><span id="lstnumberx41.7" class="ltx_text ltx_lst_identifier">specialist</span><span id="lstnumberx41.8" class="ltx_text ltx_lst_space"> </span><span id="lstnumberx41.9" class="ltx_text ltx_lst_identifier">in</span><span id="lstnumberx41.10" class="ltx_text ltx_lst_space"> </span><span id="lstnumberx41.11" class="ltx_text ltx_lst_identifier">the</span><span id="lstnumberx41.12" class="ltx_text ltx_lst_space"> </span><span id="lstnumberx41.13" class="ltx_text ltx_lst_identifier">field</span><span id="lstnumberx41.14" class="ltx_text ltx_lst_space"> </span><span id="lstnumberx41.15" class="ltx_text ltx_lst_identifier">of</span><span id="lstnumberx41.16" class="ltx_text ltx_lst_space"> </span><span id="lstnumberx41.17" class="ltx_text ltx_lst_identifier">rare</span><span id="lstnumberx41.18" class="ltx_text ltx_lst_space"> </span><span id="lstnumberx41.19" class="ltx_text ltx_lst_identifier">diseases</span>.
</div>
</div>
</div>
<div id="A3.SS6.p12" class="ltx_para">
<div id="A3.SS6.p12.1" class="ltx_listing ltx_lstlisting ltx_listing"><div class="ltx_listing_data"><a href="data:text/plain;base64," download="">⬇</a></div>
<div id="lstnumberx42" class="ltx_listingline"><span id="lstnumberx42.1" class="ltx_text ltx_lst_identifier">You</span><span id="lstnumberx42.2" class="ltx_text ltx_lst_space"> </span><span id="lstnumberx42.3" class="ltx_text ltx_lst_identifier">will</span><span id="lstnumberx42.4" class="ltx_text ltx_lst_space"> </span><span id="lstnumberx42.5" class="ltx_text ltx_lst_identifier">be</span><span id="lstnumberx42.6" class="ltx_text ltx_lst_space"> </span><span id="lstnumberx42.7" class="ltx_text ltx_lst_identifier">given</span><span id="lstnumberx42.8" class="ltx_text ltx_lst_space"> </span><span id="lstnumberx42.9" class="ltx_text ltx_lst_identifier">one</span><span id="lstnumberx42.10" class="ltx_text ltx_lst_space"> </span><span id="lstnumberx42.11" class="ltx_text ltx_lst_identifier">predicted</span><span id="lstnumberx42.12" class="ltx_text ltx_lst_space"> </span><span id="lstnumberx42.13" class="ltx_text ltx_lst_identifier">disease</span><span id="lstnumberx42.14" class="ltx_text ltx_lst_space"> </span><span id="lstnumberx42.15" class="ltx_text ltx_lst_identifier">and</span><span id="lstnumberx42.16" class="ltx_text ltx_lst_space"> </span><span id="lstnumberx42.17" class="ltx_text ltx_lst_identifier">one</span><span id="lstnumberx42.18" class="ltx_text ltx_lst_space"> </span><span id="lstnumberx42.19" class="ltx_text ltx_lst_identifier">standard</span><span id="lstnumberx42.20" class="ltx_text ltx_lst_space"> </span><span id="lstnumberx42.21" class="ltx_text ltx_lst_identifier">diagnosis</span>.<span id="lstnumberx42.22" class="ltx_text ltx_lst_space"> </span><span id="lstnumberx42.23" class="ltx_text ltx_lst_identifier">Decide</span><span id="lstnumberx42.24" class="ltx_text ltx_lst_space"> </span><span id="lstnumberx42.25" class="ltx_text ltx_lst_identifier">whether</span><span id="lstnumberx42.26" class="ltx_text ltx_lst_space"> </span><span id="lstnumberx42.27" class="ltx_text ltx_lst_identifier">they</span><span id="lstnumberx42.28" class="ltx_text ltx_lst_space"> </span><span id="lstnumberx42.29" class="ltx_text ltx_lst_identifier">refer</span><span id="lstnumberx42.30" class="ltx_text ltx_lst_space"> </span><span id="lstnumberx42.31" class="ltx_text ltx_lst_identifier">to</span><span id="lstnumberx42.32" class="ltx_text ltx_lst_space"> </span><span id="lstnumberx42.33" class="ltx_text ltx_lst_identifier">the</span><span id="lstnumberx42.34" class="ltx_text ltx_lst_space"> </span><span id="lstnumberx42.35" class="ltx_text ltx_lst_identifier">same</span><span id="lstnumberx42.36" class="ltx_text ltx_lst_space"> </span><span id="lstnumberx42.37" class="ltx_text ltx_lst_identifier">disease</span><span id="lstnumberx42.38" class="ltx_text ltx_lst_space"> </span><span id="lstnumberx42.39" class="ltx_text ltx_lst_identifier">or</span><span id="lstnumberx42.40" class="ltx_text ltx_lst_space"> </span><span id="lstnumberx42.41" class="ltx_text ltx_lst_identifier">an</span><span id="lstnumberx42.42" class="ltx_text ltx_lst_space"> </span><span id="lstnumberx42.43" class="ltx_text ltx_lst_identifier">equivalent</span><span id="lstnumberx42.44" class="ltx_text ltx_lst_space"> </span><span id="lstnumberx42.45" class="ltx_text ltx_lst_identifier">alias</span>.<span id="lstnumberx42.46" class="ltx_text ltx_lst_space"> </span><span id="lstnumberx42.47" class="ltx_text ltx_lst_identifier">Output</span><span id="lstnumberx42.48" class="ltx_text ltx_lst_space"> </span><span id="lstnumberx42.49" class="ltx_text ltx_lst_identifier">only</span><span id="lstnumberx42.50" class="ltx_text ltx_lst_space"> </span>"<span id="lstnumberx42.51" class="ltx_text ltx_lst_identifier">Yes</span>"<span id="lstnumberx42.52" class="ltx_text ltx_lst_space"> </span><span id="lstnumberx42.53" class="ltx_text ltx_lst_identifier">or</span><span id="lstnumberx42.54" class="ltx_text ltx_lst_space"> </span>"<span id="lstnumberx42.55" class="ltx_text ltx_lst_identifier">No</span>".
</div>
<div id="lstnumberx43" class="ltx_listingline"><span id="lstnumberx43.1" class="ltx_text ltx_lst_identifier">Predicted</span><span id="lstnumberx43.2" class="ltx_text ltx_lst_space"> </span><span id="lstnumberx43.3" class="ltx_text ltx_lst_identifier">disease</span>:<span id="lstnumberx43.4" class="ltx_text ltx_lst_space"> </span>{<span id="lstnumberx43.5" class="ltx_text ltx_lst_identifier">prediction</span>}
</div>
