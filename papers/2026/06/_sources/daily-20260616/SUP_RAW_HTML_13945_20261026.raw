t ltx_lst_space"> </span><span id="lstnumberx45.29" class="ltx_text ltx_lst_identifier">text</span><span id="lstnumberx45.30" class="ltx_text ltx_lst_space"> </span><span id="lstnumberx45.31" class="ltx_text ltx_lst_identifier">exactly</span><span id="lstnumberx45.32" class="ltx_text ltx_lst_space"> </span><span id="lstnumberx45.33" class="ltx_text ltx_lst_identifier">as</span><span id="lstnumberx45.34" class="ltx_text ltx_lst_space"> </span><span id="lstnumberx45.35" class="ltx_text ltx_lst_identifier">stated</span>.<span id="lstnumberx45.36" class="ltx_text ltx_lst_space"> </span><span id="lstnumberx45.37" class="ltx_text ltx_lst_identifier">Output</span><span id="lstnumberx45.38" class="ltx_text ltx_lst_space"> </span><span id="lstnumberx45.39" class="ltx_text ltx_lst_identifier">only</span><span id="lstnumberx45.40" class="ltx_text ltx_lst_space"> </span><span id="lstnumberx45.41" class="ltx_text ltx_lst_identifier">that</span><span id="lstnumberx45.42" class="ltx_text ltx_lst_space"> </span><span id="lstnumberx45.43" class="ltx_text ltx_lst_identifier">prior</span><span id="lstnumberx45.44" class="ltx_text ltx_lst_space"> </span><span id="lstnumberx45.45" class="ltx_text ltx_lst_identifier">hospital</span><span id="lstnumberx45.46" class="ltx_text ltx_lst_space"> </span><span id="lstnumberx45.47" class="ltx_text ltx_lst_identifier">case</span><span id="lstnumberx45.48" class="ltx_text ltx_lst_space"> </span><span id="lstnumberx45.49" class="ltx_text ltx_lst_identifier">content</span><span id="lstnumberx45.50" class="ltx_text ltx_lst_space"> </span><span id="lstnumberx45.51" class="ltx_text ltx_lst_identifier">and</span><span id="lstnumberx45.52" class="ltx_text ltx_lst_space"> </span><span id="lstnumberx45.53" class="ltx_text ltx_lst_identifier">nothing</span><span id="lstnumberx45.54" class="ltx_text ltx_lst_space"> </span><span id="lstnumberx45.55" class="ltx_text ltx_lst_identifier">else</span>.
