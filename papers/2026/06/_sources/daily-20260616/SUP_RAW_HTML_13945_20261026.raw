<td id="A4.T9.2.7.2" class="ltx_td ltx_align_left">5</td></tr>
<tr id="A4.T9.2.8" class="ltx_tr">
<th id="A4.T9.2.8.1" class="ltx_td ltx_align_left ltx_th ltx_th_row">Batch size</th>
