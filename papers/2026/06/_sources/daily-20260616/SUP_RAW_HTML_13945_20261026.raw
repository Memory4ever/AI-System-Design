<td id="S3.T1.16.1.26.4" class="ltx_td ltx_align_center ltx_border_bb ltx_border_r" style="--ltx-bg-color:#FFF1F5;padding-top:0.25pt;padding-bottom:0.25pt;"><span id="S3.T1.16.1.26.4.1" class="ltx_text ltx_font_bold" style="--ltx-bg-color:#FFF1F5;">0.77</span></td>
