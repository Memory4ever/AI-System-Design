<td id="A1.T5.2.1.5.4" class="ltx_td ltx_align_right">9.7</td></tr>
<tr id="A1.T5.2.1.6" class="ltx_tr">
<th id="A1.T5.2.1.6.1" class="ltx_td ltx_align_left ltx_th ltx_th_row"><math id="A1.T5.m5" class="ltx_Math" alttext="H_{5}" display="inline" intent=":literal"><semantics><msub><mi>H</mi><mn>5</mn></msub><annotation encoding="application/x-tex">H_{5}</annotation></semantics></math></th>
<td id="A1.T5.2.1.6.2" class="ltx_td ltx_align_right">1,444</td>
