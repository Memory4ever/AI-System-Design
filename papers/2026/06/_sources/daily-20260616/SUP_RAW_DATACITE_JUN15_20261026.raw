lyName":"Raino","name":"Raino, S.","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"R.","familyName":"Rando","name":"Rando, R.","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"A.","familyName":"Reimer","name":"Reimer, A.","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"O.","familyName":"Reimer","name":"Reimer, O.","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"M.","familyName":"Sanchez-Conde","name":"Sanchez-Conde, M.","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"P. M. Saz","familyName":"Parkinson","name":"Parkinson, P. M. Saz","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"D.","familyName":"Serini","name":"Serini, D.","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"C.","familyName":"Sgro","name":"Sgro, C.","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"E. J.","familyName":"Siskind","name":"Siskind, E. J.","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"D. A.","familyName":"Smith","name":"Smith, D. A.","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"G.","familyName":"Spandre","name":"Spandre, G.","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"P.","familyName":"Spinelli","name":"Spinelli, P.","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"A. W.","familyName":"Strong","name":"Strong, A. W.","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"D. J.","familyName":"Suson","name":"Suson, D. J.","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"H.","familyName":"Tajima","name":"Tajima, H.","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"J. B.","familyName":"Thayer","name":"Thayer, J. B.","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"D. J.","familyName":"Thompson","name":"Thompson, D. J.","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"L.","familyName":"Tibaldo","name":"Tibaldo, L.","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"D. F.","familyName":"Torres","name":"Torres, D. F.","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"J.","familyName":"Valverde","name":"Valverde, J.","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"K.","familyName":"Wood","name":"Wood, K.","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Q.","familyName":"Yu","name":"Yu, Q.","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"G.","familyName":"Zaharijas","name":"Zaharijas, G.","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"W.","familyName":"Zhang","name":"Zhang, W.","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"the","familyName":"Fermi-Collaboration","name":"Fermi-Collaboration, the","affiliation":[],"nameIdentifiers":[]}],"titles":[{"title":"Exploring the nature of Galactic unassociated sources detected by the Fermi-LAT"}],"publisher":"arXiv","container":{},"publicationYear":2026,"subjects":[{"subject":"High Energy Astrophysical Phenomena (astro-ph.HE)","lang":"en","subjectScheme":"arXiv"},{"subject":"FOS: Physical sciences","subjectScheme":"Fields of Science and Technology (FOS)"}],"contributors":[],"dates":[{"date":"2026-06-12T08:21:29Z","dateType":"Submitted","dateInformation":"v1"},{"date":"2026-07-29T01:06:49Z","dateType":"Updated","dateInformation":"v1"},{"date":"2026-06","dateType":"Available","dateInformation":"v1"}],"language":null,"types":{"schemaOrg":"CreativeWork","resourceTypeGeneral":"Preprint","citeproc":"article","bibtex":"misc","ris":"GEN","resourceType":"Article"},"relatedIdentifiers":[{"relationType":"IsVersionOf","relatedIdentifier":"10.3847/1538-4357/ae74d3","relatedIdentifierType":"DOI"}],"relatedItems":[],"sizes":[],"formats":[],"version":"1","rightsList":[{"rightsUri":"http://arxiv.org/licenses/nonexclusive-distrib/1.0/","rights":"arXiv.org perpetual, non-exclusive license"}],"descriptions":[{"descriptionType":"Abstract","description":"We investigate the nature of the unassociated sources detected by the Fermi-LAT close (|b|\u0026lt;10°) to the Galactic plane, representing 16% of all sources in the 4FGL-DR4 catalog. The bulk of these sources (referred to as soft Galactic unassociated sources, SGUs) exhibit properties not found in known classes of gamma-ray emitters, as confirmed by a machine-learning classification approach. In particular, these properties include a steep, curved spectrum peaking below 1 GeV and a specific Galactic-latitude distribution with both a narrow and a broad component (dubbed the spike and the shoulder, respectively). Some source clusters are highlighted. New plausible source classes are explored, but only star-forming regions are found to account for a significant fraction (at most 10%) of the unassociated population. A thorough search for counterparts to the 175 brightest sources brings out a number of plausible counterparts but does not reveal clues about the nature of the whole population. We investigate the possibility that SGUs originate from mismodeled clumps of diffuse emission. Using Monte Carlo simulations, the SGU spectra can be reproduced in this scenario under an ad hoc condition concerning the clump spatial extension. The possible connection between the SGUs and gas not accounted for by the 12CO tracer is explored using the 13CO MOPRA data but leads to inconclusive results. The origin of SGUs being related to diffuse emission remains plausible. However, a scenario whereby SGUs represent a new class of gamma-ray emitters cannot be fully excluded."},{"descriptionType":"Other","description":"Accepted for publication in the Astrophysical Journal Supplement. Data posted at https://zenodo.org/records/20342245"}],"geoLocations":[],"fundingReferences":[],"url":"https://arxiv.org/abs/2606.14244","contentUrl":null,"metadataVersion":1,"schemaVersion":"http://datacite.org/schema/kernel-4","source":"mds","isActive":true,"state":"findable","reason":null,"viewCount":0,"downloadCount":0,"referenceCount":0,"citationCount":0,"partCount":0,"partOfCount":0,"versionCount":0,"versionOfCount":1,"created":"2026-06-15T01:50:34Z","registered":"2026-06-15T01:50:35Z","published":null,"updated":"2026-07-29T02:32:10Z"},"relationships":{"client":{"data":{"id":"arxiv.content","type":"clients"}}}},{"id":"10.48550/arxiv.2606.13983","type":"dois","attributes":{"doi":"10.48550/arxiv.2606.13983","identifiers":[{"identifier":"2606.13983","identifierType":"arXiv"}],"creators":[{"nameType":"Personal","givenName":"Adriano","familyName":"Cherchiglia","name":"Cherchiglia, Adriano","affiliation":[],"nameIdentifiers":[]}],"titles":[{"title":"From DUNE Sensitivities to UV Models: Implications of Flavour Constraints"}],"publisher":"arXiv","container":{},"publicationYear":2026,"subjects":[{"subject":"High Energy Physics - Phenomenology (hep-ph)","lang":"en","subjectScheme":"arXiv"},{"subject":"FOS: Physical sciences","subjectScheme":"Fields of Science and Technology (FOS)"}],"contributors":[],"dates":[{"date":"2026-06-12T00:02:41Z","dateType":"Submitted","dateInformation":"v1"},{"date":"2026-06-15T00:16:32Z","dateType":"Updated","dateInformation":"v1"},{"date":"2026-07-24T03:32:49Z","dateType":"Submitted","dateInformation":"v2"},{"date":"2026-07-28T00:04:14Z","dateType":"Updated","dateInformation":"v2"},{"date":"2026-06","dateType":"Available","dateInformation":"v1"}],"language":null,"types":{"schemaOrg":"CreativeWork","resourceTypeGeneral":"Preprint","citeproc":"article","bibtex":"misc","ris":"GEN","resourceType":"Article"},"relatedIdentifiers":[],"relatedItems":[],"sizes":[],"formats":[],"version":"2","rightsList":[{"rightsIdentifierScheme":"SPDX","rightsUri":"https://creativecommons.org/licenses/by/4.0/legalcode","schemeUri":"https://spdx.org/licenses/","rights":"Creative Commons Attribution 4.0 International","rightsIdentifier":"cc-by-4.0"}],"descriptions":[{"descriptionType":"Abstract","description":"Future neutrino experiments, in particular DUNE, are expected to probe signals of new physics. These effects can be conveniently parametrized in terms of Wilson coefficients in the LEFT, with direct connection to non-standard interactions at production, propagation and detection in the QFT formalism. We revisit the apparent sensitivity of DUNE to semileptonic electron--tau interactions within the Standard Model Effective Field Theory. We show that the vector combination controlling the $ε_{eτ}$ NSI is precisely the combination entering $τ\\to eω$. Therefore, within the dimension-six vector subspace considered in this work, an operator cancellation that suppresses the tau-decay amplitude also suppresses the corresponding NSI. As a concrete example, we focus on the lepton-flavour-violating semileptonic coefficient $(C^{(1)}_{\\ell q,1311})$. We find the bound $8.1\\times10^{-3}\\,{\\rm TeV}^{-2}$ at $90\\%$ confidence level, which is one order of magnitude stronger than the DUNE's expected sensitivity. In view of this scenario, we further study one illustrative minimal UV completion, showing that it faces even stronger constraints from other sources, making it very challenging to build UV scenarios with heavy mediators that could produce flavour-changing NSIs observable at DUNE."},{"descriptionType":"Other","description":"Revised version including new LFV tau-decay constraints"}],"geoLocations":[],"fundingReferences":[],"url":"https://arxiv.org/abs/2606.13983","contentUrl":null,"metadataVersion":1,"schemaVersion":"http://datacite.org/schema/kernel-4","source":"mds","isActive":true,"state":"findable","reason":null,"viewCount":0,"downloadCount":0,"referenceCount":0,"citationCount":0,"partCount":0,"partOfCount":0,"versionCount":0,"versionOfCount":0,"created":"2026-06-15T01:45:02Z","registered":"2026-06-15T01:45:03Z","published":null,"updated":"2026-07-28T04:01:02Z"},"relationships":{"client":{"data":{"id":"arxiv.content","type":"clients"}}}},{"id":"10.48550/arxiv.2606.13811","type":"dois","attributes":{"doi":"10.48550/arxiv.2606.13811","identifiers":[{"identifier":"2606.13811","identifierType":"arXiv"}],"creators":[{"nameType":"Personal","givenName":"Rogerio","familyName":"Feris","name":"Feris, Rogerio","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Yunchao","familyName":"Liu","name":"Liu, Yunchao","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Pengyuan","familyName":"Li","name":"Li, Pengyuan","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Hang","familyName":"Hua","name":"Hua, Hang","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"David","familyName":"Kremer","name":"Kremer, David","affiliation":[],"nameIdentifiers":[]}],"titles":[{"title":"Aligning Quantum Operators with Large Language Models"}],"publisher":"arXiv","container":{},"publicationYear":2026,"subjects":[{"subject":"Quantum Physics (quant-ph)","lang":"en","subjectScheme":"arXiv"},{"subject":"Artificial Intelligence (cs.AI)","lang":"en","subjectScheme":"arXiv"},{"subject":"FOS: Physical sciences","subjectScheme":"Fields of Science and Technology (FOS)"},{"subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"}],"contributors":[],"dates":[{"date":"2026-06-11T18:27:27Z","dateType":"Submitted","dateInformation":"v1"},{"date":"2026-06-15T00:06:38Z","dateType":"Updated","dateInformation":"v1"},{"date":"2026-07-26T23:52:47Z","dateType":"Submitted","dateInformation":"v2"},{"date":"2026-07-28T01:06:37Z","dateType":"Updated","dateInformation":"v2"},{"date":"2026-06","dateType":"Available","dateInformation":"v1"}],"language":null,"types":{"schemaOrg":"CreativeWork","resourceTypeGeneral":"Preprint","citeproc":"article","bibtex":"misc","ris":"GEN","resourceType":"Article"},"relatedIdentifiers":[],"relatedItems":[],"sizes":[],"formats":[],"version":"2","rightsList":[{"rightsIdentifierScheme":"SPDX","rightsUri":"https://creativecommons.org/licenses/by/4.0/legalcode","schemeUri":"https://spdx.org/licenses/","rights":"Creative Commons Attribution 4.0 International","rightsIdentifier":"cc-by-4.0"}],"descriptions":[{"descriptionType":"Abstract","description":"Can Large Language Models (LLMs) understand and reason about quantum operators? Despite their remarkable capabilities in mathematics and symbolic reasoning, LLMs remain inherently blind to quantum representations such as unitary matrices. In this work, we take a step toward bridging this gap by introducing an approach that maps unitary operators into the latent space of an LLM, enabling unified modeling over quantum and linguistic inputs. We instantiate this idea on Clifford+T circuit synthesis over a Pauli rotation gate set, where our model achieves results competitive with state-of-the-art methods and scales consistently with training data, with no signs of saturation. Our approach further enables language-conditioned synthesis, allowing gate constraints unseen during training to be specified directly in natural language. This work suggests a path toward quantum--aware foundation models that can natively interpret and reason about quantum operations, which could have broader implications reaching across quantum compilation and algorithm discovery."}],"geoLocations":[],"fundingReferences":[],"url":"https://arxiv.org/abs/2606.13811","contentUrl":null,"metadataVersion":1,"schemaVersion":"http://datacite.org/schema/kernel-4","source":"mds","isActive":true,"state":"findable","reason":null,"viewCount":0,"downloadCount":0,"referenceCount":0,"citationCount":0,"partCount":0,"partOfCount":0,"versionCount":0,"versionOfCount":0,"created":"2026-06-15T01:41:22Z","registered":"2026-06-15T01:41:22Z","published":null,"updated":"2026-07-28T04:01:01Z"},"relationships":{"client":{"data":{"id":"arxiv.content","type":"clients"}}}},{"id":"10.48550/arxiv.2606.13751","type":"dois","attributes":{"doi":"10.48550/arxiv.2606.13751","identifiers":[{"identifier":"2606.13751","identifierType":"arXiv"}],"creators":[{"nameType":"Personal","givenName":"Mohammed Amine","familyName":"Mouhoub","name":"Mouhoub, Mohammed Amine","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Chahinez","familyName":"Bouchekif","name":"Bouchekif, Chahinez","affiliation":[],"nameIdentifiers":[]}],"titles":[{"title":"Which Models Perform Better in Inheritance Reasoning?"}],"publisher":"arXiv","container":{},"publicationYear":2026,"subjects":[{"subject":"Computation and Language (cs.CL)","lang":"en","subjectScheme":"arXiv"},{"subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"}],"contributors":[],"dates":[{"date":"2026-06-11T15:23:32Z","dateType":"Submitted","dateInformation":"v1"},{"date":"2026-06-15T00:03:28Z","dateType":"Updated","dateInformation":"v1"},{"date":"2026-06-15T08:04:24Z","dateType":"Submitted","dateInformation":"v2"},{"date":"2026-06-16T01:28:47Z","dateType":"Updated","dateInformation":"v2"},{"date":"2026-06-19T21:19:45Z","dateType":"Submitted","dateInformation":"v3"},{"date":"2026-06-23T01:08:48Z","dateType":"Updated","dateInformation":"v3"},{"date":"2026-07-27T17:39:24Z","dateType":"Submitted","dateInformation":"v4"},{"date":"2026-07-28T01:51:15Z","dateType":"Updated","dateInformation":"v4"},{"date":"2026-06","dateType":"Available","dateInformation":"v1"}],"language":null,"types":{"schemaOrg":"CreativeWork","resourceTypeGeneral":"Preprint","citeproc":"article","bibtex":"misc","ris":"GEN","resourceType":"Article"},"relatedIdentifiers":[],"relatedItems":[],"sizes":[],"formats":[],"version":"4","rightsList":[{"rightsIdentifierScheme":"SPDX","rightsUri":"https://creativecommons.org/licenses/by-nc-nd/4.0/legalcode","schemeUri":"https://spdx.org/licenses/","rights":"Creative Commons Attribution Non Commercial No Derivatives 4.0 International","rightsIdentifier":"cc-by-nc-nd-4.0"}],"descriptions":[{"descriptionType":"Abstract","description":"This paper presents the participation of team PSL in the QIAS 2026 Shared Task on Arabic Islamic inheritance reasoning. The task evaluates the ability of large language models to solve inheritance cases that require legal interpretation, multi-step reasoning, and precise numerical computation. We compare \\textit{commercial} and \\textit{open-source} models under a unified prompting strategy to assess their effectiveness in structured legal reasoning with minimal task-specific adaptation. \\\\ Our results show a clear gap in reliability between the two model families. Commercial models demonstrate stronger performance in identifying eligible heirs, applying exclusion rules, and maintaining consistency across reasoning steps. In contrast, open-source models exhibit greater instability, particularly in cases involving dependent legal decisions and fractional share adjustments. The best performance is achieved by \\textit{Gemini 2.5 Flash}, with an MRE of $0.989$."}],"geoLocations":[],"fundingReferences":[],"url":"https://arxiv.org/abs/2606.13751","contentUrl":null,"metadataVersion":3,"schemaVersion":"http://datacite.org/schema/kernel-4","source":"mds","isActive":true,"state":"findable","reason":null,"viewCount":0,"downloadCount":0,"referenceCount":0,"citationCount":0,"partCount":0,"partOfCount":0,"versionCount":0,"versionOfCount":0,"created":"2026-06-15T01:40:04Z","registered":"2026-06-15T01:40:05Z","published":null,"updated":"2026-07-28T04:01:00Z"},"relationships":{"client":{"data":{"id":"arxiv.content","type":"clients"}}}},{"id":"10.48550/arxiv.2606.13842","type":"dois","attributes":{"doi":"10.48550/arxiv.2606.13842","identifiers":[{"identifier":"2606.13842","identifierType":"arXiv"}],"creators":[{"nameType":"Personal","givenName":"Hongyu","familyName":"Zhou","name":"Zhou, Hongyu","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Mingtian","familyName":"Tan","name":"Tan, Mingtian","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Vasileios","familyName":"Tzoumas","name":"Tzoumas, Vasileios","affiliation":[],"nameIdentifiers":[]}],"titles":[{"title":"Efficient Domain-Adaptive Policy Learning via Kernel Representation with Application to Quadrotor Control under Non-Stationary Disturbances"}],"publisher":"arXiv","container":{},"publicationYear":2026,"subjects":[{"subject":"Robotics (cs.RO)","lang":"en","subjectScheme":"arXiv"},{"subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"}],"contributors":[],"dates":[{"date":"2026-06-11T19:16:02Z","dateType":"Submitted","dateInformation":"v1"},{"date":"2026-06-15T00:08:40Z","dateType":"Updated","dateInformation":"v1"},{"date":"2026-07-24T14:43:18Z","dateType":"Submitted","dateInformation":"v2"},{"date":"2026-07-27T00:43:38Z","dateType":"Updated","dateInformation":"v2"},{"date":"2026-06","dateType":"Available","dateInformation":"v1"}],"language":null,"types":{"schemaOrg":"CreativeWork","resourceTypeGeneral":"Preprint","citeproc":"article","bibtex":"misc","ris":"GEN","resourceType":"Article"},"relatedIdentifiers":[],"relatedItems":[],"sizes":[],"formats":[],"version":"2","rightsList":[{"rightsUri":"http://arxiv.org/licenses/nonexclusive-distrib/1.0/","rights":"arXiv.org perpetual, non-exclusive license"}],"descriptions":[{"descriptionType":"Abstract","description":"We present an algorithm for efficient domain-adaptive policy learning via kernel representations. Learning domain-adaptive policies is challenging since it requires an environment representation that is both sufficiently expressive to model complex sim-to-real gaps during offline training, and computationally efficient enough to support rapid online adaptation during deployment. For instance, a quadrotor may encounter time-varying, non-stationary disturbances, such as sudden gusts of wind, payload shifts, or transitions between distinct flight regimes with and without ground effects. To address these challenges, we model unknown disturbances using a differentiable kernel approximation based on random Fourier features. During the offline training phase, we randomly sample kernel coefficients and bandwidth parameters to generate a rich diversity of disturbance profiles. We then optimize the control policy via differentiable simulation with analytical gradients, a process that takes only 50 seconds of training time on an RTX 4090 GPU. During hardware deployment, the policy adapts to non-stationary environments in real time by updating both the kernel coefficients and bandwidth through online least-squares estimation. We evaluate our method on quadrotor trajectory tracking tasks across high-fidelity numerical simulations and hardware experiments using Crazyflie, subjected to various disturbances, including complex aerodynamic effects, wind, ground effects, and payload fluctuations."}],"geoLocations":[],"fundingReferences":[],"url":"https://arxiv.org/abs/2606.13842","contentUrl":null,"metadataVersion":1,"schemaVersion":"http://datacite.org/schema/kernel-4","source":"mds","isActive":true,"state":"findable","reason":null,"viewCount":0,"downloadCount":0,"referenceCount":0,"citationCount":0,"partCount":0,"partOfCount":0,"versionCount":0,"versionOfCount":0,"created":"2026-06-15T01:42:01Z","registered":"2026-06-15T01:42:02Z","published":null,"updated":"2026-07-27T01:55:40Z"},"relationships":{"client":{"data":{"id":"arxiv.content","type":"clients"}}}},{"id":"10.48550/arxiv.2606.14652","type":"dois","attributes":{"doi":"10.48550/arxiv.2606.14652","identifiers":[{"identifier":"2606.14652","identifierType":"arXiv"}],"creators":[{"nameType":"Personal","givenName":"Éléonore","familyName":"Mangel","name":"Mangel, Éléonore","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Paul-André","familyName":"Melliès","name":"Melliès, Paul-André","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Guillaume","familyName":"Munch-Maccagnoni","name":"Munch-Maccagnoni, Guillaume","affiliation":[],"nameIdentifiers":[]}],"titles":[{"title":"Syntax and semantics of focalisation with relative monads and comonads"}],"publisher":"arXiv","container":{},"publicationYear":2026,"subjects":[{"subject":"Logic in Computer Science (cs.LO)","lang":"en","subjectScheme":"arXiv"},{"subject":"Programming Languages (cs.PL)","lang":"en","subjectScheme":"arXiv"},{"subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"}],"contributors":[],"dates":[{"date":"2026-06-12T17:13:52Z","dateType":"Submitted","dateInformation":"v1"},{"date":"2026-06-15T01:00:53Z","dateType":"Updated","dateInformation":"v1"},{"date":"2026-07-23T17:57:22Z","dateType":"Submitted","dateInformation":"v2"},{"date":"2026-07-24T01:02:38Z","dateType":"Updated","dateInformation":"v2"},{"date":"2026-06","dateType":"Available","dateInformation":"v1"}],"language":null,"types":{"schemaOrg":"CreativeWork","resourceTypeGeneral":"Preprint","citeproc":"article","bibtex":"misc","ris":"GEN","resourceType":"Article"},"relatedIdentifiers":[],"relatedItems":[],"sizes":[],"formats":[],"version":"2","rightsList":[{"rightsIdentifierScheme":"SPDX","rightsUri":"https://creativecommons.org/licenses/by-nc-nd/4.0/legalcode","schemeUri":"https://spdx.org/licenses/","rights":"Creative Commons Attribution Non Commercial No Derivatives 4.0 International","rightsIdentifier":"cc-by-nc-nd-4.0"}],"descriptions":[{"descriptionType":"Abstract","description":"The logical principles of focalisation and polarisation can be used to design well-behaved term syntaxes for sequent calculus, which play a role as meta-languages for describing effectful computation. On the semantics side, this corresponds to an axiomatic and polarised notion of model of computation stated in terms of adjunctions over non-associative categories.\n In this paper, we study the special and delicate cases of resource and effect modalities in a general intuitionistic and linear setting: an exponential comonad $!$ (refining $\\square$) and a strong monad $\\lozenge$. The starting point of our contribution is noticing that the completeness for a polarised syntax for $!$ and $\\lozenge$ with respect to (co)monads in linear call-by-push-value models can be achieved if we move to relative (co)monads: more precisely, comonads relative to $\\downarrow$ (the positive shift functor) for $!$ and monads relative to $\\uparrow$ (the negative shift functor) for $\\lozenge$.\n These specialisations of the concept of relative (co)monad to call-by-push-value adjunctions recently appeared. Yet the syntax we present arose from proof-theoretic consideration, without the link with relative (co)monads being noticed at the time. Our first remark is thus that (co)monads relative to a call-by-push-value adjunction have been motivated previously from a proof-theoretic perspective in the context of focalisation, which also provides a meta-language for these concepts in an effectful setting.\n We carry out the study of these modalities from the axiomatic, non-associative point of view. We recall the notion of adjunction over non-associative categories, and establish correspondence results between this notion of adjunction and that of relative adjunction. This correspondence is then extended to linear-non-linear and strong versions of adjunctions as needed to model $!$ and $\\lozenge$."},{"descriptionType":"Other","description":"Presented at the Sixth International Workshop on Structures and Deduction 2026 (SD 2026)"}],"geoLocations":[],"fundingReferences":[],"url":"https://arxiv.org/abs/2606.14652","contentUrl":null,"metadataVersion":1,"schemaVersion":"http://datacite.org/schema/kernel-4","source":"mds","isActive":true,"state":"findable","reason":null,"viewCount":0,"downloadCount":0,"referenceCount":0,"citationCount":0,"partCount":0,"partOfCount":0,"versionCount":0,"versionOfCount":0,"created":"2026-06-15T01:59:11Z","registered":"2026-06-15T01:59:12Z","published":null,"updated":"2026-07-24T02:16:25Z"},"relationships":{"client":{"data":{"id":"arxiv.content","type":"clients"}}}},{"id":"10.48550/arxiv.2606.14502","type":"dois","attributes":{"doi":"10.48550/arxiv.2606.14502","identifiers":[{"identifier":"2606.14502","identifierType":"arXiv"}],"creators":[{"nameType":"Personal","givenName":"Yongheng","familyName":"Zhang","name":"Zhang, Yongheng","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Ziang","familyName":"Liu","name":"Liu, Ziang","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Jiaxuan","familyName":"Zhu","name":"Zhu, Jiaxuan","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Shuai","familyName":"Wang","name":"Wang, Shuai","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Xiangqi","familyName":"Chen","name":"Chen, Xiangqi","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Haojing","familyName":"Huang","name":"Huang, Haojing","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Jiayi","familyName":"Kuang","name":"Kuang, Jiayi","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Siyu","familyName":"Chen","name":"Chen, Siyu","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Ao","familyName":"Shen","name":"Shen, Ao","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Hao","familyName":"Wu","name":"Wu, Hao","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Qiufeng","familyName":"Wang","name":"Wang, Qiufeng","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Qian-Wen","familyName":"Zhang","name":"Zhang, Qian-Wen","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Junnan","familyName":"Dong","name":"Dong, Junnan","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Wenhao","familyName":"Jiang","name":"Jiang, Wenhao","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Ying","familyName":"Shen","name":"Shen, Ying","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Hai-Tao","familyName":"Zheng","name":"Zheng, Hai-Tao","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Yinghui","familyName":"Li","name":"Li, Yinghui","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Di","familyName":"Yin","name":"Yin, Di","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Xing","familyName":"Sun","name":"Sun, Xing","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Philip S.","familyName":"Yu","name":"Yu, Philip S.","affiliation":[],"nameIdentifiers":[]}],"titles":[{"title":"From Chatbot to Digital Colleague: The Paradigm Shift Toward Persistent Autonomous AI"}],"publisher":"arXiv","container":{},"publicationYear":2026,"subjects":[{"subject":"Artificial Intelligence (cs.AI)","lang":"en","subjectScheme":"arXiv"},{"subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"}],"contributors":[],"dates":[{"date":"2026-06-12T14:33:55Z","dateType":"Submitted","dateInformation":"v1"},{"date":"2026-06-15T00:52:08Z","dateType":"Updated","dateInformation":"v1"},{"date":"2026-07-23T02:50:21Z","dateType":"Submitted","dateInformation":"v2"},{"date":"2026-07-24T00:20:37Z","dateType":"Updated","dateInformation":"v2"},{"date":"2026-06","dateType":"Available","dateInformation":"v1"}],"language":null,"types":{"schemaOrg":"CreativeWork","resourceTypeGeneral":"Preprint","citeproc":"article","bibtex":"misc","ris":"GEN","resourceType":"Article"},"relatedIdentifiers":[],"relatedItems":[],"sizes":[],"formats":[],"version":"2","rightsList":[{"rightsIdentifierScheme":"SPDX","rightsUri":"https://creativecommons.org/licenses/by-sa/4.0/legalcode","schemeUri":"https://spdx.org/licenses/","rights":"Creative Commons Attribution Share Alike 4.0 International","rightsIdentifier":"cc-by-sa-4.0"}],"descriptions":[{"descriptionType":"Abstract","description":"Large Language Models (LLMs) are undergoing a fundamental transformation from conversational generators into integrated AI systems capable of reasoning, action, memory, and self-improvement. We conceptualize this transition as a shift from Chatbot to Digital Colleague: from conversational answers to persistent work. We organize this transition along two tightly coupled dimensions. First, at the cognitive core level, LLMs are advancing from Chatbot-era \"fast thinking\" systems driven by next-token prediction toward Thinking LLMs that leverage inference-time computation, Chain-of-Thought reasoning, reflection, process supervision, and reinforcement learning to support more deliberate and reliable cognition. Second, at the tool-augmented task execution level, LLMs are progressing from tool-calling Agents that invoke external resources in an ad hoc manner toward OpenClaw-style workstation systems (OpenClaw) equipped with persistent Workspaces, skills, verification loops, and governance. The \"Workspace + Skill\" paradigm makes episodic tool use colleague-like via state persistence, reusable procedures, task closure, and experience reuse. We examine data construction shifts from instruction-response pairs to State-Action-Observation trajectories and evaluation from static benchmarks to sandboxed, auditable, self-evolving AI ecosystems."},{"descriptionType":"Other","description":"The paper is available on the project website: https://from-chatbot-to-digital-colleague.github.io/"}],"geoLocations":[],"fundingReferences":[],"url":"https://arxiv.org/abs/2606.14502","contentUrl":null,"metadataVersion":1,"schemaVersion":"http://datacite.org/schema/kernel-4","source":"mds","isActive":true,"state":"findable","reason":null,"viewCount":0,"downloadCount":0,"referenceCount":0,"citationCount":0,"partCount":0,"partOfCount":0,"versionCount":0,"versionOfCount":0,"created":"2026-06-15T01:56:03Z","registered":"2026-06-15T01:56:04Z","published":null,"updated":"2026-07-24T02:16:24Z"},"relationships":{"client":{"data":{"id":"arxiv.content","type":"clients"}}}},{"id":"10.48550/arxiv.2606.14249","type":"dois","attributes":{"doi":"10.48550/arxiv.2606.14249","identifiers":[{"identifier":"2606.14249","identifierType":"arXiv"}],"creators":[{"nameType":"Personal","givenName":"Tingyang","familyName":"Chen","name":"Chen, Tingyang","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Shuo","familyName":"Lu","name":"Lu, Shuo","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Kang","familyName":"Zhao","name":"Zhao, Kang","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Weicheng","familyName":"Meng","name":"Meng, Weicheng","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Hanlin","familyName":"Teng","name":"Teng, Hanlin","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Tianhao","familyName":"Li","name":"Li, Tianhao","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Chao","familyName":"Li","name":"Li, Chao","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Xule","familyName":"Liu","name":"Liu, Xule","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Jian","familyName":"Liang","name":"Liang, Jian","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Zhizhong","familyName":"Zhang","name":"Zhang, Zhizhong","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Yuan","familyName":"Xie","name":"Xie, Yuan","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Heng","familyName":"Qu","name":"Qu, Heng","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Kun","familyName":"Shao","name":"Shao, Kun","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Jian","familyName":"Luan","name":"Luan, Jian","affiliation":[],"nameIdentifiers":[]}],"titles":[{"title":"HarnessX: A Composable, Adaptive, and Evolvable Agent Harness Foundry"}],"publisher":"arXiv","container":{},"publicationYear":2026,"subjects":[{"subject":"Artificial Intelligence (cs.AI)","lang":"en","subjectScheme":"arXiv"},{"subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"}],"contributors":[],"dates":[{"date":"2026-06-12T08:27:11Z","dateType":"Submitted","dateInformation":"v1"},{"date":"2026-06-15T00:35:40Z","dateType":"Updated","dateInformation":"v1"},{"date":"2026-07-02T03:16:03Z","dateType":"Submitted","dateInformation":"v2"},{"date":"2026-07-03T00:22:13Z","dateType":"Updated","dateInformation":"v2"},{"date":"2026-07-23T03:12:37Z","dateType":"Submitted","dateInformation":"v3"},{"date":"2026-07-24T00:21:12Z","dateType":"Updated","dateInformation":"v3"},{"date":"2026-06","dateType":"Available","dateInformation":"v1"}],"language":null,"types":{"schemaOrg":"CreativeWork","resourceTypeGeneral":"Preprint","citeproc":"article","bibtex":"misc","ris":"GEN","resourceType":"Article"},"relatedIdentifiers":[],"relatedItems":[],"sizes":[],"formats":[],"version":"3","rightsList":[{"rightsIdentifierScheme":"SPDX","rightsUri":"https://creativecommons.org/licenses/by/4.0/legalcode","schemeUri":"https://spdx.org/licenses/","rights":"Creative Commons Attribution 4.0 International","rightsIdentifier":"cc-by-4.0"}],"descriptions":[{"descriptionType":"Abstract","description":"AI agent performance depends critically on the runtime harness, comprising the prompts, tools, memory, and control flow that mediate how a model observes, reasons, and acts. Yet today's harnesses remain largely hand-crafted and static: each new model or task still demands bespoke scaffolding, and the rich traces produced during execution are rarely distilled back into systematic improvement. We introduce HarnessX, a foundry for composable, adaptive, and evolvable agent harnesses. HarnessX assembles typed harness primitives via a substitution algebra, adapts them through AEGIS, a trace-driven multi-agent evolution engine grounded in an operational mirror between symbolic adaptation and reinforcement learning, and closes the harness-model loop by turning trajectories into both harness updates and model training signal. Across five benchmarks (ALFWorld, GAIA, WebShop, tau^3-Bench, and SWE-bench Verified), HarnessX yields an average gain of +14.5% (up to +44.0%), with gains largest where baselines are lowest. These results suggest that agent progress need not come from model scaling alone: composing and evolving runtime interfaces from execution feedback is an actionable and complementary lever. Project homepage: https://darwin-agent.github.io/HarnessX/."}],"geoLocations":[],"fundingReferences":[],"url":"https://arxiv.org/abs/2606.14249","contentUrl":null,"metadataVersion":2,"schemaVersion":"http://datacite.org/schema/kernel-4","source":"mds","isActive":true,"state":"findable","reason":null,"viewCount":0,"downloadCount":0,"referenceCount":0,"citationCount":0,"partCount":0,"partOfCount":0,"versionCount":0,"versionOfCount":0,"created":"2026-06-15T01:50:40Z","registered":"2026-06-15T01:50:41Z","published":null,"updated":"2026-07-24T02:16:24Z"},"relationships":{"client":{"data":{"id":"arxiv.content","type":"clients"}}}},{"id":"10.48550/arxiv.2606.13863","type":"dois","attributes":{"doi":"10.48550/arxiv.2606.13863","identifiers":[{"identifier":"2606.13863","identifierType":"arXiv"}],"creators":[{"nameType":"Personal","givenName":"Max","familyName":"Schwegele","name":"Schwegele, Max","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Kletus","familyName":"Stern","name":"Stern, Kletus","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Stefan","familyName":"Wewers","name":"Wewers, Stefan","affiliation":[],"nameIdentifiers":[]}],"titles":[{"title":"Semistable reduction of smooth quartics"}],"publisher":"arXiv","container":{},"publicationYear":2026,"subjects":[{"subject":"Algebraic Geometry (math.AG)","lang":"en","subjectScheme":"arXiv"},{"subject":"Number Theory (math.NT)","lang":"en","subjectScheme":"arXiv"},{"subject":"FOS: Mathematics","subjectScheme":"Fields of Science and Technology (FOS)"},{"subject":"Primary 14G20, Secondary 11G20, 14H25, 14H50, 14L24, 14Q25","lang":"en","subjectScheme":"MSC"}],"contributors":[],"dates":[{"date":"2026-06-11T19:43:52Z","dateType":"Submitted","dateInformation":"v1"},{"date":"2026-06-15T00:09:39Z","dateType":"Updated","dateInformation":"v1"},{"date":"2026-07-22T19:07:29Z","dateType":"Submitted","dateInformation":"v2"},{"date":"2026-07-24T00:07:16Z","dateType":"Updated","dateInformation":"v2"},{"date":"2026-06","dateType":"Available","dateInformation":"v1"}],"language":null,"types":{"schemaOrg":"CreativeWork","resourceTypeGeneral":"Preprint","citeproc":"article","bibtex":"misc","ris":"GEN","resourceType":"Article"},"relatedIdentifiers":[],"relatedItems":[],"sizes":[],"formats":[],"version":"2","rightsList":[{"rightsUri":"http://arxiv.org/licenses/nonexclusive-distrib/1.0/","rights":"arXiv.org perpetual, non-exclusive license"}],"descriptions":[{"descriptionType":"Abstract","description":"We develop a method for computing stable reduction of smooth plane quartics over discretely valued fields, including residue characteristic p=2. The method uses the GIT-semistable plane models constructed in an earlier part of this project, together with an intrinsic description of hyperelliptic stable curves, to characterize when the stable model is obtained from a GIT-stable plane model by resolving its cusps. More precisely, for a smooth non-hyperelliptic curve of genus 3 with semistable reduction, we show that it admits a GIT-stable plane model if and only if its stable reduction is non-hyperelliptic. In that case, the stable model is obtained from the GIT-stable plane model by replacing each cusp by a 1-tail. Together with the companion paper on explicit local stable resolution of cusps, this gives an effective approach to computing stable reduction of smooth plane quartics. The resulting algorithms are implemented in the SageMath package \"StabilityFunction\"."},{"descriptionType":"Other","description":"31 pages, 1 figure, 3 tables. Main results unchanged; hyperelliptic stable curves now cited via arXiv:2606.29016; minor corrections and expository changes"}],"geoLocations":[],"fundingReferences":[],"url":"https://arxiv.org/abs/2606.13863","contentUrl":null,"metadataVersion":1,"schemaVersion":"http://datacite.org/schema/kernel-4","source":"mds","isActive":true,"state":"findable","reason":null,"viewCount":0,"downloadCount":0,"referenceCount":0,"citationCount":0,"partCount":0,"partOfCount":0,"versionCount":0,"versionOfCount":0,"created":"2026-06-15T01:42:31Z","registered":"2026-06-15T01:42:31Z","published":null,"updated":"2026-07-24T02:16:23Z"},"relationships":{"client":{"data":{"id":"arxiv.content","type":"clients"}}}},{"id":"10.48550/arxiv.2606.14237","type":"dois","attributes":{"doi":"10.48550/arxiv.2606.14237","identifiers":[{"identifier":"2606.14237","identifierType":"arXiv"}],"creators":[{"nameType":"Personal","givenName":"Yinqiang","familyName":"Zhang","name":"Zhang, Yinqiang","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Liang","familyName":"Lu","name":"Lu, Liang","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Yipeng","familyName":"Pan","name":"Pan, Yipeng","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Maolin","familyName":"Lei","name":"Lei, Maolin","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Yuhan","familyName":"Xie","name":"Xie, Yuhan","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Zhanteng","familyName":"Xie","name":"Xie, Zhanteng","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Xiaowei","familyName":"Luo","name":"Luo, Xiaowei","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Jia","familyName":"Pan","name":"Pan, Jia","affiliation":[],"nameIdentifiers":[]}],"titles":[{"title":"BIM-Loc: BIM-Integrated Discrepancy-Aware LiDAR-based Indoor Localization"}],"publisher":"arXiv","container":{},"publicationYear":2026,"subjects":[{"subject":"Robotics (cs.RO)","lang":"en","subjectScheme":"arXiv"},{"subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"}],"contributors":[],"dates":[{"date":"2026-06-12T08:20:02Z","dateType":"Submitted","dateInformation":"v1"},{"date":"2026-07-23T00:09:12Z","dateType":"Updated","dateInformation":"v1"},{"date":"2026-06","dateType":"Available","dateInformation":"v1"}],"language":null,"types":{"schemaOrg":"CreativeWork","resourceTypeGeneral":"Preprint","citeproc":"article","bibtex":"misc","ris":"GEN","resourceType":"Article"},"relatedIdentifiers":[{"relationType":"IsVersionOf","relatedIdentifier":"10.1177/02783649261462593","relatedIdentifierType":"DOI"}],"relatedItems":[],"sizes":[],"formats":[],"version":"1","rightsList":[{"rightsIdentifierScheme":"SPDX","rightsUri":"https://creativecommons.org/licenses/by-nc-nd/4.0/legalcode","schemeUri":"https://spdx.org/licenses/","rights":"Creative Commons Attribution Non Commercial No Derivatives 4.0 International","rightsIdentifier":"cc-by-nc-nd-4.0"}],"descriptions":[{"descriptionType":"Abstract","description":"Accurate and robust localization is a fundamental requirement for service and inspection robots, particularly in feature-sparse indoor environments where traditional systems struggle due to a lack of distinct landmarks. While prior maps can enhance robustness, precise and compact maps capturing real-world details are often unavailable for new or frequently changing environments. This paper presents BIM-Loc, a novel discrepancy-aware LiDAR-based localization method that directly integrates Building Information Models (BIM) from the design phase. BIM-Loc simultaneously estimates trajectories aligned with the BIM coordinate system and identifies discrepancies between real-world observations and the as-designed BIM in an online fashion. Our core contributions include: (1) a novel multi-hit ray casting strategy for efficient BIM-point data association and projection of 3D observations into 2D texture space; (2) a pose graph optimization framework with BIM-integrated factors that enforces consistency among odometry, sequential scans, and BIM structures; and (3) a hierarchical Bayesian inference module that incrementally updates a continuous 2D surface representation for discrepancy detection, propagating updates from the pixel to the structure level. Extensive evaluations in both simulation and real-world applications demonstrate that BIM-Loc significantly outperforms state-of-the-art map-based methods in localization accuracy and robustness."},{"descriptionType":"Other","description":"24 pages, 21 figures, accepted by International Journal of Robotics Research (IJRR), to be published"}],"geoLocations":[],"fundingReferences":[],"url":"https://arxiv.org/abs/2606.14237","contentUrl":null,"metadataVersion":1,"schemaVersion":"http://datacite.org/schema/kernel-4","source":"mds","isActive":true,"state":"findable","reason":null,"viewCount":0,"downloadCount":0,"referenceCount":0,"citationCount":0,"partCount":0,"partOfCount":0,"versionCount":0,"versionOfCount":1,"created":"2026-06-15T01:50:25Z","registered":"2026-06-15T01:50:25Z","published":null,"updated":"2026-07-23T02:12:29Z"},"relationships":{"client":{"data":{"id":"arxiv.content","type":"clients"}}}},{"id":"10.48550/arxiv.2606.13908","type":"dois","attributes":{"doi":"10.48550/arxiv.2606.13908","identifiers":[{"identifier":"2606.13908","identifierType":"arXiv"}],"creators":[{"nameType":"Personal","givenName":"Ismail","familyName":"Zahed","name":"Zahed, Ismail","affiliation":[],"nameIdentifiers":[]}],"titles":[{"title":"Anomalies, Topology, and Hadron Structure in QCD"}],"publisher":"arXiv","container":{},"publicationYear":2026,"subjects":[{"subject":"High Energy Physics - Phenomenology (hep-ph)","lang":"en","subjectScheme":"arXiv"},{"subject":"High Energy Physics - Theory (hep-th)","lang":"en","subjectScheme":"arXiv"},{"subject":"Nuclear Theory (nucl-th)","lang":"en","subjectScheme":"arXiv"},{"subject":"FOS: Physical sciences","subjectScheme":"Fields of Science and Technology (FOS)"}],"contributors":[],"dates":[{"date":"2026-06-11T21:01:40Z","dateType":"Submitted","dateInformation":"v1"},{"date":"2026-06-15T00:11:54Z","dateType":"Updated","dateInformation":"v1"},{"date":"2026-07-22T16:50:01Z","dateType":"Submitted","dateInformation":"v2"},{"date":"2026-07-23T00:58:10Z","dateType":"Updated","dateInformation":"v2"},{"date":"2026-06","dateType":"Available","dateInformation":"v1"}],"language":null,"types":{"schemaOrg":"CreativeWork","resourceTypeGeneral":"Preprint","citeproc":"article","bibtex":"misc","ris":"GEN","resourceType":"Article"},"relatedIdentifiers":[],"relatedItems":[],"sizes":[],"formats":[],"version":"2","rightsList":[{"rightsIdentifierScheme":"SPDX","rightsUri":"https://creativecommons.org/licenses/by/4.0/legalcode","schemeUri":"https://spdx.org/licenses/","rights":"Creative Commons Attribution 4.0 International","rightsIdentifier":"cc-by-4.0"}],"descriptions":[{"descriptionType":"Abstract","description":"Quantum Chromodynamics (QCD) provides a remarkable realization of how quantum effects reshape the symmetries of a classical field theory. The axial anomaly links chirality to gauge-field topology and underlies the resolution of the $U(1)_A$ problem, while the trace anomaly generates the intrinsic QCD scale through dimensional transmutation and accounts for most of the mass of hadrons and hence visible matter. Together, these quantum effects reveal the central role of gluonic dynamics and vacuum structure in strong-interaction physics. In this review, we discuss the theoretical foundations and physical consequences of anomalous symmetry breaking in QCD. We examine anomalous Ward identities, the topological structure of gauge fields, instantons, topological susceptibility, and the realization of chiral and scale symmetries in the QCD vacuum. We review their role in the generation of hadron masses, the $η'$ mass, and the resolution of the $U(1)_A$ problem, and discuss their manifestations in polarized deep inelastic scattering, nucleon spin structure, and modern studies of hadron structure. Particular emphasis is placed on recent developments connecting vacuum topology, the flavor-singlet axial charge, topological screening, and the proton spin problem. Our aim is to provide a unified perspective on how quantum anomalies connect vacuum structure, hadron properties, and partonic observables, bridging nonperturbative dynamics and perturbative QCD."},{"descriptionType":"Other","description":"38 pages, 2 figures"}],"geoLocations":[],"fundingReferences":[],"url":"https://arxiv.org/abs/2606.13908","contentUrl":null,"metadataVersion":1,"schemaVersion":"http://datacite.org/schema/kernel-4","source":"mds","isActive":true,"state":"findable","reason":null,"viewCount":0,"downloadCount":0,"referenceCount":0,"citationCount":0,"partCount":0,"partOfCount":0,"versionCount":0,"versionOfCount":0,"created":"2026-06-15T01:43:28Z","registered":"2026-06-15T01:43:29Z","published":null,"updated":"2026-07-23T02:12:28Z"},"relationships":{"client":{"data":{"id":"arxiv.content","type":"clients"}}}},{"id":"10.48550/arxiv.2606.14021","type":"dois","attributes":{"doi":"10.48550/arxiv.2606.14021","identifiers":[{"identifier":"2606.14021","identifierType":"arXiv"}],"creators":[{"nameType":"Personal","givenName":"Yueheng","familyName":"Bao","name":"Bao, Yueheng","affiliation":[],"nameIdentifiers":[]}],"titles":[{"title":"Some Foundational Results for Free Boundary Brakke Flows"}],"publisher":"arXiv","container":{},"publicationYear":2026,"subjects":[{"subject":"Differential Geometry (math.DG)","lang":"en","subjectScheme":"arXiv"},{"subject":"Analysis of PDEs (math.AP)","lang":"en","subjectScheme":"arXiv"},{"subject":"FOS: Mathematics","subjectScheme":"Fields of Science and Technology (FOS)"}],"contributors":[],"dates":[{"date":"2026-06-12T01:43:39Z","dateType":"Submitted","dateInformation":"v1"},{"date":"2026-06-15T00:18:52Z","dateType":"Updated","dateInformation":"v1"},{"date":"2026-07-21T02:28:39Z","dateType":"Submitted","dateInformation":"v2"},{"date":"2026-07-22T00:19:36Z","dateType":"Updated","dateInformation":"v2"},{"date":"2026-06","dateType":"Available","dateInformation":"v1"}],"language":null,"types":{"schemaOrg":"CreativeWork","resourceTypeGeneral":"Preprint","citeproc":"article","bibtex":"misc","ris":"GEN","resourceType":"Article"},"relatedIdentifiers":[],"relatedItems":[],"sizes":[],"formats":[],"version":"2","rightsList":[{"rightsUri":"http://arxiv.org/licenses/nonexclusive-distrib/1.0/","rights":"arXiv.org perpetual, non-exclusive license"}],"descriptions":[{"descriptionType":"Abstract","description":"In this paper, we establish some geometric and analytic foundations for free boundary Brakke flows. Specifically, we (i) introduce unit-regular and cyclic free boundary flows and show that they are preserved under reflections and weak limits, (ii) prove that the support of free boundary Brakke flows satisfies an avoidance principle, and (iii) introduce free boundary inner and outer flows and prove the existence of matching free boundary Brakke flows. These results serve as general tools to analyze free boundary flows through singularities, and in particular will be applied in forthcoming work with Haslhofer, where we address the mean-convex neighborhood conjecture and uniqueness conjecture for free boundary flows through (half) cylindrical singularities."},{"descriptionType":"Other","description":"add convexity to some theorem statements"}],"geoLocations":[],"fundingReferences":[],"url":"https://arxiv.org/abs/2606.14021","contentUrl":null,"metadataVersion":1,"schemaVersion":"http://datacite.org/schema/kernel-4","source":"mds","isActive":true,"state":"findable","reason":null,"viewCount":0,"downloadCount":0,"referenceCount":0,"citationCount":0,"partCount":0,"partOfCount":0,"versionCount":0,"versionOfCount":0,"created":"2026-06-15T01:45:52Z","registered":"2026-06-15T01:45:52Z","published":null,"updated":"2026-07-22T02:24:13Z"},"relationships":{"client":{"data":{"id":"arxiv.content","type":"clients"}}}},{"id":"10.48550/arxiv.2606.14640","type":"dois","attributes":{"doi":"10.48550/arxiv.2606.14640","identifiers":[{"identifier":"2606.14640","identifierType":"arXiv"}],"creators":[{"nameType":"Personal","givenName":"Simone","familyName":"Di Gregorio","name":"Di Gregorio, Simone","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Anupam","familyName":"Gupta","name":"Gupta, Anupam","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Stefano","familyName":"Leonardi","name":"Leonardi, Stefano","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Matteo","familyName":"Russo","name":"Russo, Matteo","affiliation":[],"nameIdentifiers":[]}],"titles":[{"title":"Online Convex Optimization with Sublinear Noisy Probes"}],"publisher":"arXiv","container":{},"publicationYear":2026,"subjects":[{"subject":"Machine Learning (cs.LG)","lang":"en","subjectScheme":"arXiv"},{"subject":"Data Structures and Algorithms (cs.DS)","lang":"en","subjectScheme":"arXiv"},{"subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"}],"contributors":[],"dates":[{"date":"2026-06-12T17:05:08Z","dateType":"Submitted","dateInformation":"v1"},{"date":"2026-07-21T01:28:14Z","dateType":"Updated","dateInformation":"v1"},{"date":"2026-06","dateType":"Available","dateInformation":"v1"}],"language":null,"types":{"schemaOrg":"CreativeWork","resourceTypeGeneral":"Preprint","citeproc":"article","bibtex":"misc","ris":"GEN","resourceType":"Article"},"relatedIdentifiers":[],"relatedItems":[],"sizes":[],"formats":[],"version":"1","rightsList":[{"rightsIdentifierScheme":"SPDX","rightsUri":"https://creativecommons.org/licenses/by/4.0/legalcode","schemeUri":"https://spdx.org/licenses/","rights":"Creative Commons Attribution 4.0 International","rightsIdentifier":"cc-by-4.0"}],"descriptions":[{"descriptionType":"Abstract","description":"We study Online Convex Optimization (OCO) over a convex set $K\\subseteq \\mathbb R^d$, where in each round $t$ the learner selects $x_t\\in K$ and then observes a convex loss $f_t:K\\to[0,1]$, with the goal of minimizing regret to the best fixed decision in hindsight. We introduce a unified probing model that generalizes two recent lines of work: sublinear best-expert queries in the experts setting, and pairwise (comparison-based) feedback available every round in OCO. In our framework, the learner has a budget of $k\\le T$ pairwise probes; on a probed round it may query two points and learn which one has smaller loss.\n Our main result shows that even a sublinear and noisy probe budget can provably improve worst-case regret in the full feedback OCO regime. With $k$ $δ$-noisy pairwise probes, we obtain: $ \\text{Reg}_T \\le O\\left(\\min\\left\\{\\sqrt{dT\\ln T},\\; \\frac{dT\\ln T}{k|1-2δ|}\\right\\}\\right) $, which is tight (up to logarithmic factors in $T$) across $T$, $k$ and $δ$. Specifically regarding the noise parameter $δ\\in [0,1]$, the regret guarantee smoothly degrades as the oracle response approaches a coin flip, i.e., $δ$ is close to $\\frac{1}{2}$. When applying the same techniques to a finite $K$ for the prediction with $d$ experts setting, the resulting rates are instead completely tight in all parameters, including $d$.\n Our analysis gives a streamlined treatment of pairwise probing in OCO by quantifying the benefit of probing via a variance reduction effect, combined with a second-order (variance-based) analysis of Continuous Exponential Weights."},{"descriptionType":"Other","description":"Accepted at COLT '26"}],"geoLocations":[],"fundingReferences":[],"url":"https://arxiv.org/abs/2606.14640","contentUrl":null,"metadataVersion":1,"schemaVersion":"http://datacite.org/schema/kernel-4","source":"mds","isActive":true,"state":"findable","reason":null,"viewCount":0,"downloadCount":0,"referenceCount":0,"citationCount":0,"partCount":0,"partOfCount":0,"versionCount":0,"versionOfCount":0,"created":"2026-06-15T01:58:56Z","registered":"2026-06-15T01:58:57Z","published":null,"updated":"2026-07-21T03:52:19Z"},"relationships":{"client":{"data":{"id":"arxiv.content","type":"clients"}}}},{"id":"10.48550/arxiv.2606.14599","type":"dois","attributes":{"doi":"10.48550/arxiv.2606.14599","identifiers":[{"identifier":"2606.14599","identifierType":"arXiv"}],"creators":[{"nameType":"Personal","givenName":"Kieu Gia Thinh","familyName":"Phat","name":"Phat, Kieu Gia Thinh","affiliation":[],"nameIdentifiers":[]}],"titles":[{"title":"The Antipodal Defect of a Convex Polyhedron"}],"publisher":"arXiv","container":{},"publicationYear":2026,"subjects":[{"subject":"Metric Geometry (math.MG)","lang":"en","subjectScheme":"arXiv"},{"subject":"Combinatorics (math.CO)","lang":"en","subjectScheme":"arXiv"},{"subject":"FOS: Mathematics","subjectScheme":"Fields of Science and Technology (FOS)"},{"subject":"52B10 (Primary), 52B05, 55N10, 05B35 (Secondary)","lang":"en","subjectScheme":"MSC"}],"contributors":[],"dates":[{"date":"2026-06-12T16:21:39Z","dateType":"Submitted","dateInformation":"v1"},{"date":"2026-06-15T00:57:55Z","dateType":"Updated","dateInformation":"v1"},{"date":"2026-07-20T15:49:15Z","dateType":"Submitted","dateInformation":"v2"},{"date":"2026-07-21T01:44:57Z","dateType":"Updated","dateInformation":"v2"},{"date":"2026-06","dateType":"Available","dateInformation":"v1"}],"language":null,"types":{"schemaOrg":"CreativeWork","resourceTypeGeneral":"Preprint","citeproc":"article","bibtex":"misc","ris":"GEN","resourceType":"Article"},"relatedIdentifiers":[],"relatedItems":[],"sizes":[],"formats":[],"version":"2","rightsList":[{"rightsUri":"http://arxiv.org/licenses/nonexclusive-distrib/1.0/","rights":"arXiv.org perpetual, non-exclusive license"}],"descriptions":[{"descriptionType":"Abstract","description":"Problem C7 from the 2006 IMO Shortlist gives \\(A(P)-B(P)=V(P)-1\\) for a generic convex polyhedron, where \\(A(P)\\) counts antipodal vertex pairs and \\(B(P)\\) counts antipodal edge-midpoint pairs. For an arbitrary convex polyhedron \\(P\\subset\\mathbb{R}^3\\), define \\(δ(P)=V(P)-1-A(P)+B(P)\\). We construct a two-dimensional antipodal square complex \\(X(P)\\) and prove \\(H_0(X(P);\\mathbb{Z})\\cong\\mathbb{Z}\\), \\(H_1(X(P);\\mathbb{Z})\\cong\\mathbb{Z}/2\\), and \\(H_2(X(P);\\mathbb{Z})\\cong\\mathbb{Z}^{δ(P)}\\). Consequently, \\(δ(P)\\geq 0\\), extending the generic identity to the inequality \\(A(P)-B(P)\\leq V(P)-1\\). The proof uses a directed double cover, a polyhedral support blow-up over the normal sphere, and the Vietoris--Begle mapping theorem. Independently, Euler integration on the projective normal fan gives an exact local formula for the defect; in three dimensions, only exact edge--facet and facet--facet opposite pairs contribute. We also determine the integral image of the square-boundary map: it is the even-cycle lattice of the antipodal graph, with nonzero Smith invariant factors \\(1,\\ldots,1,2\\). Applications include a zero-defect criterion, centrally symmetric and extremal formulas, and an explicit description of defects and primitive belts for pyramids over polygons."},{"descriptionType":"Other","description":"33 pages, 5 figures. Substantially revised and reorganized. The support blow-up and integral homology proofs have been strengthened, the exact local and integral lattice results have been streamlined, and the polygonal wall-crossing and all-dimensional representation-space material has been separated for future work"}],"geoLocations":[],"fundingReferences":[],"url":"https://arxiv.org/abs/2606.14599","contentUrl":null,"metadataVersion":1,"schemaVersion":"http://datacite.org/schema/kernel-4","source":"mds","isActive":true,"state":"findable","reason":null,"viewCount":0,"downloadCount":0,"referenceCount":0,"citationCount":0,"partCount":0,"partOfCount":0,"versionCount":0,"versionOfCount":0,"created":"2026-06-15T01:58:05Z","registered":"2026-06-15T01:58:06Z","published":null,"updated":"2026-07-21T03:52:18Z"},"relationships":{"client":{"data":{"id":"arxiv.content","type":"clients"}}}},{"id":"10.48550/arxiv.2606.14409","type":"dois","attributes":{"doi":"10.48550/arxiv.2606.14409","identifiers":[{"identifier":"2606.14409","identifierType":"arXiv"}],"creators":[{"nameType":"Personal","givenName":"He","familyName":"Zhang","name":"Zhang, He","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Lingzhu","familyName":"Xiang","name":"Xiang, Lingzhu","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Haitao","familyName":"Lin","name":"Lin, Haitao","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Zeyu","familyName":"Huang","name":"Huang, Zeyu","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Minghui","familyName":"Wang","name":"Wang, Minghui","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Dingyan","familyName":"Zhong","name":"Zhong, Dingyan","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Yubo","familyName":"Dong","name":"Dong, Yubo","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Yihao","familyName":"Wu","name":"Wu, Yihao","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Yongming","familyName":"Rao","name":"Rao, Yongming","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Dongsheng","familyName":"Zhang","name":"Zhang, Dongsheng","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Wanjia","familyName":"He","name":"He, Wanjia","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Ling","familyName":"Chen","name":"Chen, Ling","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Kai","familyName":"Huang","name":"Huang, Kai","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Jiahao","familyName":"Chen","name":"Chen, Jiahao","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Sichang","familyName":"Su","name":"Su, Sichang","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Xumin","familyName":"Yu","name":"Yu, Xumin","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Ziyi","familyName":"Wang","name":"Wang, Ziyi","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Chengwei","familyName":"Zhu","name":"Zhu, Chengwei","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Xiao","familyName":"Teng","name":"Teng, Xiao","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Yuchun","familyName":"Guo","name":"Guo, Yuchun","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Yufeng","familyName":"Zhang","name":"Zhang, Yufeng","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Yuandong","familyName":"Liu","name":"Liu, Yuandong","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Rui","familyName":"Wang","name":"Wang, Rui","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Zisheng","familyName":"Lu","name":"Lu, Zisheng","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Han","familyName":"Hu","name":"Hu, Han","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Zhengyou","familyName":"Zhang","name":"Zhang, Zhengyou","affiliation":[],"nameIdentifiers":[]}],"titles":[{"title":"Hy-Embodied-0.5-VLA: From Vision-Language-Action Models to a Real-World Robot Learning Stack"}],"publisher":"arXiv","container":{},"publicationYear":2026,"subjects":[{"subject":"Robotics (cs.RO)","lang":"en","subjectScheme":"arXiv"},{"subject":"Artificial Intelligence (cs.AI)","lang":"en","subjectScheme":"arXiv"},{"subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"}],"contributors":[],"dates":[{"date":"2026-06-12T12:45:18Z","dateType":"Submitted","dateInformation":"v1"},{"date":"2026-06-15T00:47:10Z","dateType":"Updated","dateInformation":"v1"},{"date":"2026-07-20T07:32:26Z","dateType":"Submitted","dateInformation":"v2"},{"date":"2026-07-21T01:20:04Z","dateType":"Updated","dateInformation":"v2"},{"date":"2026-06","dateType":"Available","dateInformation":"v1"}],"language":null,"types":{"schemaOrg":"CreativeWork","resourceTypeGeneral":"Preprint","citeproc":"article","bibtex":"misc","ris":"GEN","resourceType":"Article"},"relatedIdentifiers":[],"relatedItems":[],"sizes":[],"formats":[],"version":"2","rightsList":[{"rightsUri":"http://arxiv.org/licenses/nonexclusive-distrib/1.0/","rights":"arXiv.org perpetual, non-exclusive license"}],"descriptions":[{"descriptionType":"Abstract","description":"In this report, we present Hy-Embodied-0.5-VLA, abbreviated as HyVLA-0.5, an end-to-end system that spans the full robot learning stack: data collection, model design, continued pre-training and supervised fine-tuning, RL post-training, and real-world deployment. Each component serves a distinct role in this stack."}],"geoLocations":[],"fundingReferences":[],"url":"https://arxiv.org/abs/2606.14409","contentUrl":null,"metadataVersion":1,"schemaVersion":"http://datacite.org/schema/kernel-4","source":"mds","isActive":true,"state":"findable","reason":null,"viewCount":0,"downloadCount":0,"referenceCount":0,"citationCount":0,"partCount":0,"partOfCount":0,"versionCount":0,"versionOfCount":0,"created":"2026-06-15T01:54:04Z","registered":"2026-06-15T01:54:05Z","published":null,"updated":"2026-07-21T03:52:17Z"},"relationships":{"client":{"data":{"id":"arxiv.content","type":"clients"}}}},{"id":"10.48550/arxiv.2606.13770","type":"dois","attributes":{"doi":"10.48550/arxiv.2606.13770","identifiers":[{"identifier":"2606.13770","identifierType":"arXiv"}],"creators":[{"nameType":"Personal","givenName":"Mariana Carrillo","familyName":"González","name":"González, Mariana Carrillo","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Théo","familyName":"Keseman","name":"Keseman, Théo","affiliation":[],"nameIdentifiers":[]}],"titles":[{"title":"4d CFT Correlators from Ambitwistors"}],"publisher":"arXiv","container":{},"publicationYear":2026,"subjects":[{"subject":"High Energy Physics - Theory (hep-th)","lang":"en","subjectScheme":"arXiv"},{"subject":"General Relativity and Quantum Cosmology (gr-qc)","lang":"en","subjectScheme":"arXiv"},{"subject":"FOS: Physical sciences","subjectScheme":"Fields of Science and Technology (FOS)"}],"contributors":[],"dates":[{"date":"2026-06-11T18:00:00Z","dateType":"Submitted","dateInformation":"v1"},{"date":"2026-06-15T00:04:22Z","dateType":"Updated","dateInformation":"v1"},{"date":"2026-07-20T09:33:02Z","dateType":"Submitted","dateInformation":"v2"},{"date":"2026-07-21T01:25:46Z","dateType":"Updated","dateInformation":"v2"},{"date":"2026-06","dateType":"Available","dateInformation":"v1"}],"language":null,"types":{"schemaOrg":"CreativeWork","resourceTypeGeneral":"Preprint","citeproc":"article","bibtex":"misc","ris":"GEN","resourceType":"Article"},"relatedIdentifiers":[],"relatedItems":[],"sizes":[],"formats":[],"version":"2","rightsList":[{"rightsUri":"http://arxiv.org/licenses/nonexclusive-distrib/1.0/","rights":"arXiv.org perpetual, non-exclusive license"}],"descriptions":[{"descriptionType":"Abstract","description":"We develop an ambitwistor-space formulation of conserved spinning correlators in four-dimensional CFTs. We show that conformal symmetry and conservation are trivialised by the ambitwistor Penrose transform, and construct the two- and three-point ambitwistor correlators explicitly. We further propose a simple formula for projecting onto parity-even and parity-odd sectors, and verify it in several non-trivial examples. The resulting correlators furnish a natural basis compatible with a boundary double copy for arbitrary spin. At three points, we show that they localise on degree-three curves in a two-twistor representation. We also explain how the formalism incorporates boundary propagators for unitary operators of integer conformal dimension, and extend it to conformally coupled scalars."},{"descriptionType":"Other","description":"30 pages + appendices; 1 figure; v2: references added"}],"geoLocations":[],"fundingReferences":[],"url":"https://arxiv.org/abs/2606.13770","contentUrl":null,"metadataVersion":1,"schemaVersion":"http://datacite.org/schema/kernel-4","source":"mds","isActive":true,"state":"findable","reason":null,"viewCount":0,"downloadCount":0,"referenceCount":0,"citationCount":0,"partCount":0,"partOfCount":0,"versionCount":0,"versionOfCount":0,"created":"2026-06-15T01:40:30Z","registered":"2026-06-15T01:40:30Z","published":null,"updated":"2026-07-21T03:52:17Z"},"relationships":{"client":{"data":{"id":"arxiv.content","type":"clients"}}}},{"id":"10.48550/arxiv.2606.14682","type":"dois","attributes":{"doi":"10.48550/arxiv.2606.14682","identifiers":[{"identifier":"2606.14682","identifierType":"arXiv"}],"creators":[{"nameType":"Personal","givenName":"Sambit K.","familyName":"Giri","name":"Giri, Sambit K.","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Florent","familyName":"Mertens","name":"Mertens, Florent","affiliation":[],"nameIdentifiers":[]}],"titles":[{"title":"Impact of 21-cm foreground mitigation strategies on reionization power spectrum constraints"}],"publisher":"arXiv","container":{},"publicationYear":2026,"subjects":[{"subject":"Cosmology and Nongalactic Astrophysics (astro-ph.CO)","lang":"en","subjectScheme":"arXiv"},{"subject":"Astrophysics of Galaxies (astro-ph.GA)","lang":"en","subjectScheme":"arXiv"},{"subject":"Instrumentation and Methods for Astrophysics (astro-ph.IM)","lang":"en","subjectScheme":"arXiv"},{"subject":"FOS: Physical sciences","subjectScheme":"Fields of Science and Technology (FOS)"}],"contributors":[],"dates":[{"date":"2026-06-12T17:47:06Z","dateType":"Submitted","dateInformation":"v1"},{"date":"2026-07-15T13:34:13Z","dateType":"Updated","dateInformation":"v1"},{"date":"2026-07-17T07:53:26Z","dateType":"Submitted","dateInformation":"v2"},{"date":"2026-07-20T00:27:06Z","dateType":"Updated","dateInformation":"v2"},{"date":"2026-06","dateType":"Available","dateInformation":"v1"}],"language":null,"types":{"schemaOrg":"CreativeWork","resourceTypeGeneral":"Preprint","citeproc":"article","bibtex":"misc","ris":"GEN","resourceType":"Article"},"relatedIdentifiers":[{"relationType":"IsVersionOf","relatedIdentifier":"10.1093/mnras/stag1258","relatedIdentifierType":"DOI"}],"relatedItems":[],"sizes":[],"formats":[],"version":"2","rightsList":[{"rightsIdentifierScheme":"SPDX","rightsUri":"https://creativecommons.org/licenses/by/4.0/legalcode","schemeUri":"https://spdx.org/licenses/","rights":"Creative Commons Attribution 4.0 International","rightsIdentifier":"cc-by-4.0"}],"descriptions":[{"descriptionType":"Abstract","description":"The 21-cm signal probes the intergalactic medium during the Epoch of Reionization (EoR) but is overwhelmed by astrophysical foregrounds orders of magnitude stronger than the cosmological signal. We evaluate two mitigation strategies: (i) Foreground Avoidance, restricting analysis to the EoR window in Fourier space, and (ii) Foreground Removal via Gaussian Process Regression, which exploits spectral smoothness to statistically separate contaminants and reclaim modes within the contaminated wedge. Both introduce systematic biases of up to $\\approx$1$σ$ in astrophysical parameters such as the minimum star-forming halo mass and ionising escape fraction, with avoidance posteriors consistently broader than removal owing to its restricted visibility coverage. The global reionization history is recovered within the 95% credible interval, though the neutral fraction at late reionization epochs shows a persistent bias reflecting the difficulty of its inference from the power spectrum alone. Multi-redshift inference is susceptible to contamination from poorly mitigated bins. Excluding such bins significantly reduces parameter biases, but identifying them requires independent quality metrics. When restricted to identical length scales, both strategies recover similar power spectra, yielding posteriors in similar regions."},{"descriptionType":"Other","description":"5 pages, 2 figures. Published in MNRAS"}],"geoLocations":[],"fundingReferences":[],"url":"https://arxiv.org/abs/2606.14682","contentUrl":null,"metadataVersion":2,"schemaVersion":"http://datacite.org/schema/kernel-4","source":"mds","isActive":true,"state":"findable","reason":null,"viewCount":0,"downloadCount":0,"referenceCount":0,"citationCount":0,"partCount":0,"partOfCount":0,"versionCount":0,"versionOfCount":1,"created":"2026-06-15T01:59:49Z","registered":"2026-06-15T01:59:50Z","published":null,"updated":"2026-07-20T02:26:56Z"},"relationships":{"client":{"data":{"id":"arxiv.content","type":"clients"}}}},{"id":"10.48550/arxiv.2606.14440","type":"dois","attributes":{"doi":"10.48550/arxiv.2606.14440","identifiers":[{"identifier":"2606.14440","identifierType":"arXiv"}],"creators":[{"nameType":"Personal","givenName":"Yian","familyName":"Yu","name":"Yu, Yian","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Yang","familyName":"Chen","name":"Chen, Yang","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Lulu","familyName":"Zhao","name":"Zhao, Lulu","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Kathryn","familyName":"Whitman","name":"Whitman, Kathryn","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Ward","familyName":"Manchester","name":"Manchester, Ward","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Tamas","familyName":"Gombosi","name":"Gombosi, Tamas","affiliation":[],"nameIdentifiers":[]}],"titles":[{"title":"Realtime forecasting of solar energetic particle event and proton flux using multi-source solar observations and multi-task deep learning"}],"publisher":"arXiv","container":{},"publicationYear":2026,"subjects":[{"subject":"Solar and Stellar Astrophysics (astro-ph.SR)","lang":"en","subjectScheme":"arXiv"},{"subject":"Space Physics (physics.space-ph)","lang":"en","subjectScheme":"arXiv"},{"subject":"FOS: Physical sciences","subjectScheme":"Fields of Science and Technology (FOS)"}],"contributors":[],"dates":[{"date":"2026-06-12T13:21:07Z","dateType":"Submitted","dateInformation":"v1"},{"date":"2026-06-15T00:48:55Z","dateType":"Updated","dateInformation":"v1"},{"date":"2026-07-17T17:50:59Z","dateType":"Submitted","dateInformation":"v2"},{"date":"2026-07-20T00:54:27Z","dateType":"Updated","dateInformation":"v2"},{"date":"2026-06","dateType":"Available","dateInformation":"v1"}],"language":null,"types":{"schemaOrg":"CreativeWork","resourceTypeGeneral":"Preprint","citeproc":"article","bibtex":"misc","ris":"GEN","resourceType":"Article"},"relatedIdentifiers":[],"relatedItems":[],"sizes":[],"formats":[],"version":"2","rightsList":[{"rightsUri":"http://arxiv.org/licenses/nonexclusive-distrib/1.0/","rights":"arXiv.org perpetual, non-exclusive license"}],"descriptions":[{"descriptionType":"Abstract","description":"Solar energetic particle (SEP) events, defined by proton flux exceeding 10 pfu in the \u0026gt; 10 MeV channel, pose major risks to spacecraft operations, astronaut safety, and high-latitude aviation. Due to the complexity and rarity of SEP events, reliable operational SEP forecasting remains an important challenge in space weather. Here we present a novel 24-hour-ahead realtime forecasting framework, SEPNET-PRISM, based on a multi-task learning structure and a thoroughly constructed list of features from multiple sources spanning multiple solar cycles, that jointly predicts SEP event occurrence and future proton and soft X-ray fluxes. SEPNET-PRISM extends the earlier-introduced SEPNET-based models by integrating a broader range of solar observations, including active-region magnetic parameters from SHARP and SMARP, solar-flare information, coronal mass ejections, soft X-ray flux, and historical \u0026gt; 10 MeV proton flux. As compared with SEPNET, the inclusion of SMARP data expands the temporal coverage of magnetic-field predictors to earlier solar cycles, while flux-based inputs provide additional precursor information. Evaluation on the CLEAR SEP benchmark dataset shows improved classification performance over the earlier SEPNET-O (operational version of SEPNET) on the newly aligned dataset. The best operational model is obtained when magnetic, radiative, and proton-flux predictors are combined, highlighting the value of expanded historical coverage and complementary precursor information for improving realtime SEP forecasting."}],"geoLocations":[],"fundingReferences":[],"url":"https://arxiv.org/abs/2606.14440","contentUrl":null,"metadataVersion":1,"schemaVersion":"http://datacite.org/schema/kernel-4","source":"mds","isActive":true,"state":"findable","reason":null,"viewCount":0,"downloadCount":0,"referenceCount":0,"citationCount":0,"partCount":0,"partOfCount":0,"versionCount":0,"versionOfCount":0,"created":"2026-06-15T01:54:43Z","registered":"2026-06-15T01:54:44Z","published":null,"updated":"2026-07-20T02:26:55Z"},"relationships":{"client":{"data":{"id":"arxiv.content","type":"clients"}}}},{"id":"10.48550/arxiv.2606.14565","type":"dois","attributes":{"doi":"10.48550/arxiv.2606.14565","identifiers":[{"identifier":"2606.14565","identifierType":"arXiv"}],"creators":[{"nameType":"Personal","givenName":"Benjamin","familyName":"Alheit","name":"Alheit, Benjamin","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Siddhant","familyName":"Kumar","name":"Kumar, Siddhant","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Mathias","familyName":"Peirlinck","name":"Peirlinck, Mathias","affiliation":[],"nameIdentifiers":[]}],"titles":[{"title":"CANN-EUCLID: unsupervised constitutive artificial neural network model discovery from full-field data"}],"publisher":"arXiv","container":{},"publicationYear":2026,"subjects":[{"subject":"Computational Engineering, Finance, and Science (cs.CE)","lang":"en","subjectScheme":"arXiv"},{"subject":"Machine Learning (cs.LG)","lang":"en","subjectScheme":"arXiv"},{"subject":"Computational Physics (physics.comp-ph)","lang":"en","subjectScheme":"arXiv"},{"subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"},{"subject":"FOS: Physical sciences","subjectScheme":"Fields of Science and Technology (FOS)"}],"contributors":[],"dates":[{"date":"2026-06-12T15:44:06Z","dateType":"Submitted","dateInformation":"v1"},{"date":"2026-06-15T00:56:17Z","dateType":"Updated","dateInformation":"v1"},{"date":"2026-07-16T10:49:35Z","dateType":"Submitted","dateInformation":"v2"},{"date":"2026-07-17T00:40:00Z","dateType":"Updated","dateInformation":"v2"},{"date":"2026-06","dateType":"Available","dateInformation":"v1"}],"language":null,"types":{"schemaOrg":"CreativeWork","resourceTypeGeneral":"Preprint","citeproc":"article","bibtex":"misc","ris":"GEN","resourceType":"Article"},"relatedIdentifiers":[],"relatedItems":[],"sizes":[],"formats":[],"version":"2","rightsList":[{"rightsUri":"http://arxiv.org/licenses/nonexclusive-distrib/1.0/","rights":"arXiv.org perpetual, non-exclusive license"}],"descriptions":[{"descriptionType":"Abstract","description":"Constitutive artificial neural networks (CANNs) provide interpretable material model discovery, but have so far been used in stress-supervised settings based on apparent stress-strain data from homogeneous tests. Because each test samples only a narrow loading path and provides homogenized rather than local stress information, robust discovery typically requires multiple loading modes to constrain the multidimensional response. This is challenging for soft biological tissues, where repeated testing, damage, and sample variability limit reliable information from a single specimen. Here, we combine CANNs with the stress-unsupervised full-field discovery framework EUCLID to identify sparse hyperelastic laws directly from displacement fields and reaction forces in one heterogeneity-inducing loading case. CANN-EUCLID minimizes equilibrium imbalance with sparsity-promoting regularization selecting compact active terms, without local stress measurements or a prescribed law. We evaluate the approach on isotropic and anisotropic benchmarks with prescribed ground-truth laws. When the ground truth is representable by the chosen CANN basis, our method recovers the correct terms with near-exact accuracy, including exponential terms with embedded parameters. When it is not contained in the basis, the method retains shared terms and approximates missing contributions using available basis functions. Generalization depends strongly on sampled deformation states: exponential strain-stiffening terms can be recovered accurately when sufficiently probed, but can produce large extrapolation errors when the stiffening regime lies outside the sampled domain. Forward FE validation simulations show that the discovered behavior accurately replicates the ground truth. These results establish stress-unsupervised CANN discovery as a promising framework for interpretable full-field constitutive model identification."}],"geoLocations":[],"fundingReferences":[],"url":"https://arxiv.org/abs/2606.14565","contentUrl":null,"metadataVersion":1,"schemaVersion":"http://datacite.org/schema/kernel-4","source":"mds","isActive":true,"state":"findable","reason":null,"viewCount":0,"downloadCount":0,"referenceCount":0,"citationCount":0,"partCount":0,"partOfCount":0,"versionCount":0,"versionOfCount":0,"created":"2026-06-15T01:57:23Z","registered":"2026-06-15T01:57:23Z","published":null,"updated":"2026-07-17T02:38:44Z"},"relationships":{"client":{"data":{"id":"arxiv.content","type":"clients"}}}},{"id":"10.48550/arxiv.2606.14530","type":"dois","attributes":{"doi":"10.48550/arxiv.2606.14530","identifiers":[{"identifier":"2606.14530","identifierType":"arXiv"}],"creators":[{"nameType":"Personal","givenName":"Carlo","familyName":"Di Cicco","name":"Di Cicco, Carlo","affiliation":[],"nameIdentifiers":[]}],"titles":[{"title":"Code Correctness Is Linearly Decodable from LLM Hidden States Before Generation"}],"publisher":"arXiv","container":{},"publicationYear":2026,"subjects":[{"subject":"Machine Learning (cs.LG)","lang":"en","subjectScheme":"arXiv"},{"subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"}],"contributors":[],"dates":[{"date":"2026-06-12T15:06:15Z","dateType":"Submitted","dateInformation":"v1"},{"date":"2026-06-15T00:53:57Z","dateType":"Updated","dateInformation":"v1"},{"date":"2026-07-10T10:43:50Z","dateType":"Submitted","dateInformation":"v2"},{"date":"2026-07-13T00:29:58Z","dateType":"Updated","dateInformation":"v2"},{"date":"2026-07-16T10:01:41Z","dateType":"Submitted","dateInformation":"v3"},{"date":"2026-07-17T00:37:19Z","dateType":"Updated","dateInformation":"v3"},{"date":"2026-06","dateType":"Available","dateInformation":"v1"}],"language":null,"types":{"schemaOrg":"CreativeWork","resourceTypeGeneral":"Preprint","citeproc":"article","bibtex":"misc","ris":"GEN","resourceType":"Article"},"relatedIdentifiers":[],"relatedItems":[],"sizes":[],"formats":[],"version":"3","rightsList":[{"rightsIdentifierScheme":"SPDX","rightsUri":"https://creativecommons.org/licenses/by/4.0/legalcode","schemeUri":"https://spdx.org/licenses/","rights":"Creative Commons Attribution 4.0 International","rightsIdentifier":"cc-by-4.0"}],"descriptions":[{"descriptionType":"Abstract","description":"Large language models encode rich information in their hidden states. This work asks whether the correctness of code that Qwen3-4B-Instruct-2507 has not yet generated is already legible in its hidden states, evaluated on a set of 444 tasks from LiveCodeBench. The correctness of the model's first-attempt code is linearly decodable from the hidden state at the final prompt token, captured before any output token is generated, with a leakage-free held-out AUC of 0.881 +/- 0.008 across 50 outer splits. To assess whether this signal is explained by prompt length, each hidden state dimension is residualized with respect to its linear effect. The probe still achieves an AUC of 0.842 +/- 0.010, substantially above a logistic prompt-length baseline of 0.657 +/- 0.014, and none of the nonlinear models tested improves upon it. A companion question about whether self-repair leaves a geometric signature in the model's hidden states could not be answered, because successful repairs following a failed first attempt are too rare in this setting to support the analysis. The contribution is both empirical and methodological, providing evidence that pre-generation hidden states contain a robust signal of eventual code correctness, together with a confound-control diagnostic that quantifies how much of that signal survives adjustment for prompt length."},{"descriptionType":"Other","description":"7 pages, 4 tables. Code, data, and analysis scripts available at https://github.com/CarloDiCicco/ReasoningLab"}],"geoLocations":[],"fundingReferences":[],"url":"https://arxiv.org/abs/2606.14530","contentUrl":null,"metadataVersion":2,"schemaVersion":"http://datacite.org/schema/kernel-4","source":"mds","isActive":true,"state":"findable","reason":null,"viewCount":0,"downloadCount":0,"referenceCount":0,"citationCount":0,"partCount":0,"partOfCount":0,"versionCount":0,"versionOfCount":0,"created":"2026-06-15T01:56:38Z","registered":"2026-06-15T01:56:39Z","published":null,"updated":"2026-07-17T02:38:43Z"},"relationships":{"client":{"data":{"id":"arxiv.content","type":"clients"}}}},{"id":"10.48550/arxiv.2606.14318","type":"dois","attributes":{"doi":"10.48550/arxiv.2606.14318","identifiers":[{"identifier":"2606.14318","identifierType":"arXiv"}],"creators":[{"nameType":"Personal","givenName":"Karl-Theodor","familyName":"Sturm","name":"Sturm, Karl-Theodor","affiliation":[],"nameIdentifiers":[]}],"titles":[{"title":"Sectional Curvature for Kantorovich-Wasserstein and Hellinger-Kantorovich Geometries"}],"publisher":"arXiv","container":{},"publicationYear":2026,"subjects":[{"subject":"Differential Geometry (math.DG)","lang":"en","subjectScheme":"arXiv"},{"subject":"Functional Analysis (math.FA)","lang":"en","subjectScheme":"arXiv"},{"subject":"Metric Geometry (math.MG)","lang":"en","subjectScheme":"arXiv"},{"subject":"Probability (math.PR)","lang":"en","subjectScheme":"arXiv"},{"subject":"FOS: Mathematics","subjectScheme":"Fields of Science and Technology (FOS)"}],"contributors":[],"dates":[{"date":"2026-06-12T09:58:00Z","dateType":"Submitted","dateInformation":"v1"},{"date":"2026-06-15T00:40:53Z","dateType":"Updated","dateInformation":"v1"},{"date":"2026-07-16T16:26:35Z","dateType":"Submitted","dateInformation":"v2"},{"date":"2026-07-17T00:58:21Z","dateType":"Updated","dateInformation":"v2"},{"date":"2026-06","dateType":"Available","dateInformation":"v1"}],"language":null,"types":{"schemaOrg":"CreativeWork","resourceTypeGeneral":"Preprint","citeproc":"article","bibtex":"misc","ris":"GEN","resourceType":"Article"},"relatedIdentifiers":[],"relatedItems":[],"sizes":[],"formats":[],"version":"2","rightsList":[{"rightsIdentifierScheme":"SPDX","rightsUri":"https://creativecommons.org/licenses/by/4.0/legalcode","schemeUri":"https://spdx.org/licenses/","rights":"Creative Commons Attribution 4.0 International","rightsIdentifier":"cc-by-4.0"}],"descriptions":[{"descriptionType":"Abstract","description":"We derive an explicit formula for the sectional curvature of the space ${\\cal M}(M)$ of finite measures on a Riemannian manifold M. The space ${\\cal M}(M)$ is equipped with the Hellinger-Kantorovich metric $HK$. Even in the case M=R^n, the curvature is comprised of two parts: the `lifted part' is negative, and the `twisted part' is positive. It will be analyzed in detail for the multidimensional torus.\n Our general approach to sectional curvature in geodesic spaces also leads to new insights into the curvature of the space $P_2(M)$ of probability measures on M equipped with the Kantorovich-Wasserstein metric $W_2$."}],"geoLocations":[],"fundingReferences":[],"url":"https://arxiv.org/abs/2606.14318","contentUrl":null,"metadataVersion":1,"schemaVersion":"http://datacite.org/schema/kernel-4","source":"mds","isActive":true,"state":"findable","reason":null,"viewCount":0,"downloadCount":0,"referenceCount":0,"citationCount":0,"partCount":0,"partOfCount":0,"versionCount":0,"versionOfCount":0,"created":"2026-06-15T01:52:09Z","registered":"2026-06-15T01:52:09Z","published":null,"updated":"2026-07-17T02:38:42Z"},"relationships":{"client":{"data":{"id":"arxiv.content","type":"clients"}}}},{"id":"10.48550/arxiv.2606.14234","type":"dois","attributes":{"doi":"10.48550/arxiv.2606.14234","identifiers":[{"identifier":"2606.14234","identifierType":"arXiv"}],"creators":[{"nameType":"Personal","givenName":"Kirill","familyName":"Selin","name":"Selin, Kirill","affiliation":[],"nameIdentifiers":[]}],"titles":[{"title":"Automorphism groups of non-normal affine toric surfaces"}],"publisher":"arXiv","container":{},"publicationYear":2026,"subjects":[{"subject":"Algebraic Geometry (math.AG)","lang":"en","subjectScheme":"arXiv"},{"subject":"FOS: Mathematics","subjectScheme":"Fields of Science and Technology (FOS)"}],"contributors":[],"dates":[{"date":"2026-06-12T08:14:56Z","dateType":"Submitted","dateInformation":"v1"},{"date":"2026-06-15T00:34:51Z","dateType":"Updated","dateInformation":"v1"},{"date":"2026-07-16T11:01:59Z","dateType":"Submitted","dateInformation":"v2"},{"date":"2026-07-17T00:40:26Z","dateType":"Updated","dateInformation":"v2"},{"date":"2026-06","dateType":"Available","dateInformation":"v1"}],"language":null,"types":{"schemaOrg":"CreativeWork","resourceTypeGeneral":"Preprint","citeproc":"article","bibtex":"misc","ris":"GEN","resourceType":"Article"},"relatedIdentifiers":[],"relatedItems":[],"sizes":[],"formats":[],"version":"2","rightsList":[{"rightsUri":"http://arxiv.org/licenses/nonexclusive-distrib/1.0/","rights":"arXiv.org perpetual, non-exclusive license"}],"descriptions":[{"descriptionType":"Abstract","description":"We investigate the automorphism group of a non-normal affine toric surface. It is known that for a normal affine toric surface the connected component of the automorphism group is generated by the acting torus and root subgroups. While this fact is also true for some classes of non-normal affine toric surfaces, it fails in general. We give an example of a non-normal affine toric surface, whose singular locus is a point and the connected component of the automorphism group is not generated by the acting torus and root subgroups."},{"descriptionType":"Other","description":"16 pages, 4 figures"}],"geoLocations":[],"fundingReferences":[],"url":"https://arxiv.org/abs/2606.14234","contentUrl":null,"metadataVersion":1,"schemaVersion":"http://datacite.org/schema/kernel-4","source":"mds","isActive":true,"state":"findable","reason":null,"viewCount":0,"downloadCount":0,"referenceCount":0,"citationCount":0,"partCount":0,"partOfCount":0,"versionCount":0,"versionOfCount":0,"created":"2026-06-15T01:50:21Z","registered":"2026-06-15T01:50:21Z","published":null,"updated":"2026-07-17T02:38:42Z"},"relationships":{"client":{"data":{"id":"arxiv.content","type":"clients"}}}},{"id":"10.48550/arxiv.2606.13965","type":"dois","attributes":{"doi":"10.48550/arxiv.2606.13965","identifiers":[{"identifier":"2606.13965","identifierType":"arXiv"}],"creators":[{"nameType":"Personal","givenName":"Maxim","familyName":"Derevyagin","name":"Derevyagin, Maxim","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Max","familyName":"Meynig","name":"Meynig, Max","affiliation":[],"nameIdentifiers":[]}],"titles":[{"title":"A remark on Chebyshev rational functions, multipoint Padé approximants and Noise"}],"publisher":"arXiv","container":{},"publicationYear":2026,"subjects":[{"subject":"Classical Analysis and ODEs (math.CA)","lang":"en","subjectScheme":"arXiv"},{"subject":"High Energy Physics - Theory (hep-th)","lang":"en","subjectScheme":"arXiv"},{"subject":"Mathematical Physics (math-ph)","lang":"en","subjectScheme":"arXiv"},{"subject":"Complex Variables (math.CV)","lang":"en","subjectScheme":"arXiv"},{"subject":"FOS: Mathematics","subjectScheme":"Fields of Science and Technology (FOS)"},{"subject":"FOS: Physical sciences","subjectScheme":"Fields of Science and Technology (FOS)"},{"subject":"30E05, 33C47 (Primary) 42C05, 30B70, 33F05 (Secondary)","lang":"en","subjectScheme":"MSC"}],"contributors":[],"dates":[{"date":"2026-06-11T23:03:29Z","dateType":"Submitted","dateInformation":"v1"},{"date":"2026-06-15T00:15:04Z","dateType":"Updated","dateInformation":"v1"},{"date":"2026-07-15T14:28:39Z","dateType":"Submitted","dateInformation":"v2"},{"date":"2026-07-16T00:50:46Z","dateType":"Updated","dateInformation":"v2"},{"date":"2026-06","dateType":"Available","dateInformation":"v1"}],"language":null,"types":{"schemaOrg":"CreativeWork","resourceTypeGeneral":"Preprint","citeproc":"article","bibtex":"misc","ris":"GEN","resourceType":"Article"},"relatedIdentifiers":[],"relatedItems":[],"sizes":[],"formats":[],"version":"2","rightsList":[{"rightsUri":"http://arxiv.org/licenses/nonexclusive-distrib/1.0/","rights":"arXiv.org perpetual, non-exclusive license"}],"descriptions":[{"descriptionType":"Abstract","description":"Motivated by the recent interest in multipoint Padé approximants in the physics community, we discuss Chebyshev rational functions and show how they give rise to multipoint Padé approximants in exactly the same way that Chebyshev polynomials produce Padé approximants. We present recurrence relations for Chebyshev rational functions, as well as the underlying continued fraction of Thiele type (also known as $R_{II}$ type). Finally, we provide numerical evidence illustrating the effects of noise on this interpolation scheme and show that a phenomenon similar to that recently observed by Costin, Dunne, and Meynig for Padé approximants also occurs in the multipoint setting."},{"descriptionType":"Other","description":"21 pages, 5 figures"}],"geoLocations":[],"fundingReferences":[],"url":"https://arxiv.org/abs/2606.13965","contentUrl":null,"metadataVersion":1,"schemaVersion":"http://datacite.org/schema/kernel-4","source":"mds","isActive":true,"state":"findable","reason":null,"viewCount":0,"downloadCount":0,"referenceCount":0,"citationCount":0,"partCount":0,"partOfCount":0,"versionCount":0,"versionOfCount":0,"created":"2026-06-15T01:44:40Z","registered":"2026-06-15T01:44:41Z","published":null,"updated":"2026-07-16T02:39:41Z"},"relationships":{"client":{"data":{"id":"arxiv.content","type":"clients"}}}},{"id":"10.48550/arxiv.2606.14264","type":"dois","attributes":{"doi":"10.48550/arxiv.2606.14264","identifiers":[{"identifier":"2606.14264","identifierType":"arXiv"}],"creators":[{"nameType":"Personal","givenName":"Ziyang","familyName":"Ye","name":"Ye, Ziyang","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Xiaoqun","familyName":"Wang","name":"Wang, Xiaoqun","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Zexin","familyName":"Pan","name":"Pan, Zexin","affiliation":[],"nameIdentifiers":[]}],"titles":[{"title":"Universal $L^2$-approximation using median digital-net algorithms"}],"publisher":"arXiv","container":{},"publicationYear":2026,"subjects":[{"subject":"Numerical Analysis (math.NA)","lang":"en","subjectScheme":"arXiv"},{"subject":"FOS: Mathematics","subjectScheme":"Fields of Science and Technology (FOS)"},{"subject":"65D15, 41A63, 42C10, 41A25, 65Y20","lang":"en","subjectScheme":"MSC"}],"contributors":[],"dates":[{"date":"2026-06-12T08:48:11Z","dateType":"Submitted","dateInformation":"v1"},{"date":"2026-06-15T00:36:50Z","dateType":"Updated","dateInformation":"v1"},{"date":"2026-07-14T13:25:41Z","dateType":"Submitted","dateInformation":"v2"},{"date":"2026-07-15T00:51:03Z","dateType":"Updated","dateInformation":"v2"},{"date":"2026-06","dateType":"Available","dateInformation":"v1"}],"language":null,"types":{"schemaOrg":"CreativeWork","resourceTypeGeneral":"Preprint","citeproc":"article","bibtex":"misc","ris":"GEN","resourceType":"Article"},"relatedIdentifiers":[],"relatedItems":[],"sizes":[],"formats":[],"version":"2","rightsList":[{"rightsIdentifierScheme":"SPDX","rightsUri":"https://creativecommons.org/licenses/by/4.0/legalcode","schemeUri":"https://spdx.org/licenses/","rights":"Creative Commons Attribution 4.0 International","rightsIdentifier":"cc-by-4.0"}],"descriptions":[{"descriptionType":"Abstract","description":"We propose a median digital-net algorithm for $L^2$-approximation of non-periodic functions over $[0,1]^s$, inspired by the recently developed median lattice algorithms for the periodic setting. The algorithm requires no smoothness or weight parameters but only a sufficiently large candidate Walsh index set $K$. It proceeds in three stages: generating multiple estimates of the Walsh coefficients in $K$ using independent randomized digital-net samples; taking the respective median of both the estimates and their absolute values; then, based on these median values, identifying the dominant coefficients and constructing a truncated Walsh series as the final approximation. We prove that if the target function has dominating mixed partial derivatives up to order $α$, all having finite Vitali variation of fractional order $λ$, then the algorithm achieves an $L^2$-error of $\\mathcal{O}(M^{-α-λ+η})$ with high probability, where $M$ is the total number of function evaluations and $η\u0026gt;0$ is arbitrarily small. Furthermore, the implied constant grows at most polynomially in the dimension $s$ under suitable decay conditions on the ANOVA components of the target function. On the implementation side, we provide both parameter-dependent and -independent constructions of the index set $K$, and employ the fast Walsh--Hadamard transform and Gray code ordering to accelerate the algorithm. Numerical experiments support the theoretical analysis and demonstrate that the proposed algorithm remains effective in high-dimensional settings."}],"geoLocations":[],"fundingReferences":[],"url":"https://arxiv.org/abs/2606.14264","contentUrl":null,"metadataVersion":1,"schemaVersion":"http://datacite.org/schema/kernel-4","source":"mds","isActive":true,"state":"findable","reason":null,"viewCount":0,"downloadCount":0,"referenceCount":0,"citationCount":0,"partCount":0,"partOfCount":0,"versionCount":0,"versionOfCount":0,"created":"2026-06-15T01:50:59Z","registered":"2026-06-15T01:51:00Z","published":null,"updated":"2026-07-15T02:20:26Z"},"relationships":{"client":{"data":{"id":"arxiv.content","type":"clients"}}}},{"id":"10.48550/arxiv.2606.13843","type":"dois","attributes":{"doi":"10.48550/arxiv.2606.13843","identifiers":[{"identifier":"2606.13843","identifierType":"arXiv"}],"creators":[{"nameType":"Personal","givenName":"Xiang 'Anthony'","familyName":"Chen","name":"Chen, Xiang 'Anthony'","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Savvas Dimitrios","familyName":"Petridis","name":"Petridis, Savvas Dimitrios","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Tian","familyName":"Deng","name":"Deng, Tian","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Humad","familyName":"Bari","name":"Bari, Humad","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Ruofei","familyName":"Du","name":"Du, Ruofei","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Yang","familyName":"Li","name":"Li, Yang","affiliation":[],"nameIdentifiers":[]}],"titles":[{"title":"Rethinking the UI of GenUI: A Tale of Two Designs"}],"publisher":"arXiv","container":{},"publicationYear":2026,"subjects":[{"subject":"Human-Computer Interaction (cs.HC)","lang":"en","subjectScheme":"arXiv"},{"subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"}],"contributors":[],"dates":[{"date":"2026-06-11T19:17:40Z","dateType":"Submitted","dateInformation":"v1"},{"date":"2026-06-15T00:08:43Z","dateType":"Updated","dateInformation":"v1"},{"date":"2026-07-11T05:05:25Z","dateType":"Submitted","dateInformation":"v2"},{"date":"2026-07-14T00:19:19Z","dateType":"Updated","dateInformation":"v2"},{"date":"2026-06","dateType":"Available","dateInformation":"v1"}],"language":null,"types":{"schemaOrg":"CreativeWork","resourceTypeGeneral":"Preprint","citeproc":"article","bibtex":"misc","ris":"GEN","resourceType":"Article"},"relatedIdentifiers":[],"relatedItems":[],"sizes":[],"formats":[],"version":"2","rightsList":[{"rightsIdentifierScheme":"SPDX","rightsUri":"https://creativecommons.org/licenses/by/4.0/legalcode","schemeUri":"https://spdx.org/licenses/","rights":"Creative Commons Attribution 4.0 International","rightsIdentifier":"cc-by-4.0"}],"descriptions":[{"descriptionType":"Abstract","description":"GenUI is an emergent class of AI tools that use large models to generate UI mock-ups based on users' high-level descriptions, promising to democratize UX design exploration for a broader audience. Most GenUI designs to date tend to inherit the conventions of conversational large models, such as ChatGPT and Gemini, where a user describes their design needs primarily via an unstructured prompt, and the tool then takes a depth-first approach, delving into the design right away and producing a high-fidelity prototype. In this research, we rethink how well this unstructured, depth-first, and high-fidelity GenUI design can support early-stage, 0-to-1 design exploration. To probe this question, we propose a contrastive design with structured input, breadth-first exploration, and low-fidelity generation. We then conducted a comparison study with 24 UX designers and product managers who conducted mini design exploration exercises using an existing GenUI tool and our contrastive GenUI tool. Findings reveal participants' perceived benefits and trade-offs of the two GenUI designs: structured input surfaces key facets but requires more work, raising entry barriers to start exploration; breadth-first workflow reveals more possibilities, but previewing UX ideas spanning many screens remains hard; and though low fidelity has value, professionals favor high fidelity because it fits practice and GenAI heightens fidelity expectations. We conclude with design implications for GenUI and similar AI-powered creativity support tools."}],"geoLocations":[],"fundingReferences":[],"url":"https://arxiv.org/abs/2606.13843","contentUrl":null,"metadataVersion":1,"schemaVersion":"http://datacite.org/schema/kernel-4","source":"mds","isActive":true,"state":"findable","reason":null,"viewCount":0,"downloadCount":0,"referenceCount":0,"citationCount":0,"partCount":0,"partOfCount":0,"versionCount":0,"versionOfCount":0,"created":"2026-06-15T01:42:03Z","registered":"2026-06-15T01:42:03Z","published":null,"updated":"2026-07-14T04:06:21Z"},"relationships":{"client":{"data":{"id":"arxiv.content","type":"clients"}}}},{"id":"10.48550/arxiv.2606.14232","type":"dois","attributes":{"doi":"10.48550/arxiv.2606.14232","identifiers":[{"identifier":"2606.14232","identifierType":"arXiv"}],"creators":[{"nameType":"Personal","givenName":"Shahin","familyName":"Jafarzadeh","name":"Jafarzadeh, Shahin","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"David B.","familyName":"Jess","name":"Jess, David B.","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Marco","familyName":"Stangalini","name":"Stangalini, Marco","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Peter H.","familyName":"Keys","name":"Keys, Peter H.","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Samuel D. T.","familyName":"Grant","name":"Grant, Samuel D. T.","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Timothy J.","familyName":"Duckenfield","name":"Duckenfield, Timothy J.","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Glen","familyName":"Chambers","name":"Chambers, Glen","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Sami K.","familyName":"Solanki","name":"Solanki, Sami K.","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"H. N.","familyName":"Smitha","name":"Smitha, H. N.","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Andreas","familyName":"Lagg","name":"Lagg, Andreas","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Achim","familyName":"Gandorfer","name":"Gandorfer, Achim","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Alex","familyName":"Feller","name":"Feller, Alex","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Francisco A.","familyName":"Iglesias","name":"Iglesias, Francisco A.","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Tino L.","familyName":"Riethmüller","name":"Riethmüller, Tino L.","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Bianca","familyName":"Grauf","name":"Grauf, Bianca","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Johannes","familyName":"Hoelken","name":"Hoelken, Johannes","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Yukio","familyName":"Katsukawa","name":"Katsukawa, Yukio","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Pietro","familyName":"Bernasconi","name":"Bernasconi, Pietro","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Thomas","familyName":"Berkefeld","name":"Berkefeld, Thomas","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Alberto","familyName":"Álvarez-Herrero","name":"Álvarez-Herrero, Alberto","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Masahito","familyName":"Kubo","name":"Kubo, Masahito","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"David Orozco","familyName":"Suárez","name":"Suárez, David Orozco","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Michael","familyName":"Carpenter","name":"Carpenter, Michael","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Alexander","familyName":"Bell","name":"Bell, Alexander","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Valentín Martínez","familyName":"Pillet","name":"Pillet, Valentín Martínez","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Francisco Javier","familyName":"Bailén","name":"Bailén, Francisco Javier","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Julian Blanco","familyName":"Rodríguez","name":"Rodríguez, Julian Blanco","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Juan Sebastián Castellanos","familyName":"Durán","name":"Durán, Juan Sebastián Castellanos","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Edvarda","familyName":"Harnes","name":"Harnes, Edvarda","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Ryohtaroh T.","familyName":"Ishikawa","name":"Ishikawa, Ryohtaroh T.","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Yusuke","familyName":"Kawabata","name":"Kawabata, Yusuke","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Takuma","familyName":"Matsumoto","name":"Matsumoto, Takuma","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Takayoshi","familyName":"Oba","name":"Oba, Takayoshi","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Azaymi L.","familyName":"Siu-Tapia","name":"Siu-Tapia, Azaymi L.","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Hanna","familyName":"Strecker","name":"Strecker, Hanna","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Dušan","familyName":"Vukadinović","name":"Vukadinović, Dušan","affiliation":[],"nameIdentifiers":[]}],"titles":[{"title":"Magnetically Structured Oscillatory Power Along an Active-Region Transect in Near-UV Sunrise-III/SUSI Spectroscopy"}],"publisher":"arXiv","container":{},"publicationYear":2026,"subjects":[{"subject":"Solar and Stellar Astrophysics (astro-ph.SR)","lang":"en","subjectScheme":"arXiv"},{"subject":"FOS: Physical sciences","subjectScheme":"Fields of Science and Technology (FOS)"}],"contributors":[],"dates":[{"date":"2026-06-12T08:14:18Z","dateType":"Submitted","dateInformation":"v1"},{"date":"2026-07-13T00:28:52Z","dateType":"Updated","dateInformation":"v1"},{"date":"2026-06","dateType":"Available","dateInformation":"v1"}],"language":null,"types":{"schemaOrg":"CreativeWork","resourceTypeGeneral":"Preprint","citeproc":"article","bibtex":"misc","ris":"GEN","resourceType":"Article"},"relatedIdentifiers":[{"relationType":"IsVersionOf","relatedIdentifier":"10.3847/2041-8213/ae7072","relatedIdentifierType":"DOI"}],"relatedItems":[],"sizes":[],"formats":[],"version":"1","rightsList":[{"rightsUri":"http://arxiv.org/licenses/nonexclusive-distrib/1.0/","rights":"arXiv.org perpetual, non-exclusive license"}],"descriptions":[{"descriptionType":"Abstract","description":"We present a multi-line characterisation of how oscillatory power is organised across distinct magnetic environments in an active region using seeing-free, stratospheric near-ultraviolet spectroscopy from the Sunrise-III UV Spectropolarimeter and Imager (SUSI). A two-hour time series of short raster scans in the line-rich 327-329 nm window samples along a single transect that contains the following regions: weak magnetic-field surroundings, a plage, a sunspot, and a pore. From a set of 30 selected, relatively unblended absorption lines, we extract line-core Doppler-velocity time series and compute Morlet-wavelet refined global spectra from which we form band-integrated power maps for three frequency bands (2-4, 4-6, and 6-12 mHz). The stacked, line-resolved maps reveal a clear environment-dependent redistribution of power: 2-4 mHz power is strongest in the weak-field/plage segments but is commonly suppressed in the umbra and pore cores, while 4-6 mHz and 6-12 mHz power becomes relatively enhanced in the strongest-field regions, with line-dependent behaviour in the penumbra and plage. Across the line ensemble, this broad frequency structuring is coherent, but the detailed spatial distribution and relative band ranking are not identical from line to line - even among spectral lines with comparable effective formation depths - demonstrating clear line dependence. This novel result implies that single-line measurements may miss secondary components of the local wave spectrum because different lines weight co-existing perturbations and modes differently; therefore, the SUSI near-UV window provides a uniquely diagnostic-rich mapping of oscillations, offering leverage that is difficult to obtain with traditional one- or two-line approaches."},{"descriptionType":"Other","description":"Accepted for publication in The Astrophysical Journal Letters"}],"geoLocations":[],"fundingReferences":[],"url":"https://arxiv.org/abs/2606.14232","contentUrl":null,"metadataVersion":1,"schemaVersion":"http://datacite.org/schema/kernel-4","source":"mds","isActive":true,"state":"findable","reason":null,"viewCount":0,"downloadCount":0,"referenceCount":0,"citationCount":0,"partCount":0,"partOfCount":0,"versionCount":0,"versionOfCount":1,"created":"2026-06-15T01:50:18Z","registered":"2026-06-15T01:50:19Z","published":null,"updated":"2026-07-13T01:52:52Z"},"relationships":{"client":{"data":{"id":"arxiv.content","type":"clients"}}}},{"id":"10.48550/arxiv.2606.14184","type":"dois","attributes":{"doi":"10.48550/arxiv.2606.14184","identifiers":[{"identifier":"2606.14184","identifierType":"arXiv"}],"creators":[{"nameType":"Personal","givenName":"Shahin","familyName":"Jafarzadeh","name":"Jafarzadeh, Shahin","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"David B.","familyName":"Jess","name":"Jess, David B.","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Marco","familyName":"Stangalini","name":"Stangalini, Marco","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Richard J.","familyName":"Morton","name":"Morton, Richard J.","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Tobias","familyName":"Felipe","name":"Felipe, Tobias","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Michele","familyName":"Berretti","name":"Berretti, Michele","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Sami K.","familyName":"Solanki","name":"Solanki, Sami K.","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"H. N.","familyName":"Smitha","name":"Smitha, H. N.","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Andreas","familyName":"Lagg","name":"Lagg, Andreas","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Achim","familyName":"Gandorfer","name":"Gandorfer, Achim","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Alex","familyName":"Feller","name":"Feller, Alex","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Francisco A.","familyName":"Iglesias","name":"Iglesias, Francisco A.","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Tino L.","familyName":"Riethmüller","name":"Riethmüller, Tino L.","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Bianca","familyName":"Grauf","name":"Grauf, Bianca","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Johannes","familyName":"Hoelken","name":"Hoelken, Johannes","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Yukio","familyName":"Katsukawa","name":"Katsukawa, Yukio","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Pietro","familyName":"Bernasconi","name":"Bernasconi, Pietro","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Thomas","familyName":"Berkefeld","name":"Berkefeld, Thomas","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Alberto","familyName":"Álvarez-Herrero","name":"Álvarez-Herrero, Alberto","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Masahito","familyName":"Kubo","name":"Kubo, Masahito","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"David Orozco","familyName":"Suárez","name":"Suárez, David Orozco","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Michael","familyName":"Carpenter","name":"Carpenter, Michael","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Alexander","familyName":"Bell","name":"Bell, Alexander","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Valentín Martínez","familyName":"Pillet","name":"Pillet, Valentín Martínez","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Francisco Javier","familyName":"Bailén","name":"Bailén, Francisco Javier","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Julian Blanco","familyName":"Rodríguez","name":"Rodríguez, Julian Blanco","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Juan Sebastián Castellanos","familyName":"Durán","name":"Durán, Juan Sebastián Castellanos","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Edvarda","familyName":"Harnes","name":"Harnes, Edvarda","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Ryohtaroh T.","familyName":"Ishikawa","name":"Ishikawa, Ryohtaroh T.","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Yusuke","familyName":"Kawabata","name":"Kawabata, Yusuke","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Takuma","familyName":"Matsumoto","name":"Matsumoto, Takuma","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Takayoshi","familyName":"Oba","name":"Oba, Takayoshi","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Azaymi L.","familyName":"Siu-Tapia","name":"Siu-Tapia, Azaymi L.","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Hanna","familyName":"Strecker","name":"Strecker, Hanna","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Dusan","familyName":"Vukadinović","name":"Vukadinović, Dusan","affiliation":[],"nameIdentifiers":[]}],"titles":[{"title":"Multi-line Wave Signatures in a Sunspot from Near-UV Sunrise III/SUSI Observations"}],"publisher":"arXiv","container":{},"publicationYear":2026,"subjects":[{"subject":"Solar and Stellar Astrophysics (astro-ph.SR)","lang":"en","subjectScheme":"arXiv"},{"subject":"FOS: Physical sciences","subjectScheme":"Fields of Science and Technology (FOS)"}],"contributors":[],"dates":[{"date":"2026-06-12T07:05:58Z","dateType":"Submitted","dateInformation":"v1"},{"date":"2026-07-13T00:28:50Z","dateType":"Updated","dateInformation":"v1"},{"date":"2026-06","dateType":"Available","dateInformation":"v1"}],"language":null,"types":{"schemaOrg":"CreativeWork","resourceTypeGeneral":"Preprint","citeproc":"article","bibtex":"misc","ris":"GEN","resourceType":"Article"},"relatedIdentifiers":[{"relationType":"IsVersionOf","relatedIdentifier":"10.3847/2041-8213/ae63d0","relatedIdentifierType":"DOI"}],"relatedItems":[],"sizes":[],"formats":[],"version":"1","rightsList":[{"rightsUri":"http://arxiv.org/licenses/nonexclusive-distrib/1.0/","rights":"arXiv.org perpetual, non-exclusive license"}],"descriptions":[{"descriptionType":"Abstract","description":"Magnetohydrodynamic waves redistribute energy in magnetic structures of the lower solar atmosphere, yet constraints on how wave power and dominant frequencies are organised above sunspots remain limited because most studies use only a few well-separated diagnostics. Here we present multiline wave signatures in a sunspot from near-UV spectroscopy with the Sunrise-III UV Spectropolarimeter and Imager (SUSI). We analyse a two-hour time series of repeated raster scans of a sunspot near disc centre in the 327-329 nm spectral window (\u0026gt; 100 lines). From these, we select 44 lines that radiative-transfer calculations suggest sample effective formation heights within the umbral core from deep photosphere toward the low chromosphere. For each line, we extract line-core intensity and line-of-sight velocity time series using a dedicated multi-line fitting routine and compute Morlet-wavelet power spectra. The refined global wavelet spectra show that most lines (in both intensity and velocity) are genuinely multi-frequency, with a dominant peak and substantial statistically significant power up to 12 mHz. Unsupervised clustering of the normalised spectra groups lines into families with similar spectral shapes and reveals a progression of dominant frequencies from ~2 to ~10 mHz across the ensemble, for both intensity and velocity (not necessarily in the same lines). This behaviour is not reproduced by a simple formation-height ranking, suggesting that uncertainties in the formation-height estimates and line-dependent diagnostic response together shape the ordering. These Sunrise-III/SUSI observations open a new regime for near-UV multi-line wave studies and provide the first systematic characterisation of frequency-structured sunspot wave behaviour in this spectral region."},{"descriptionType":"Other","description":"Accepted for publication in The Astrophysical Journal Letters"}],"geoLocations":[],"fundingReferences":[],"url":"https://arxiv.org/abs/2606.14184","contentUrl":null,"metadataVersion":1,"schemaVersion":"http://datacite.org/schema/kernel-4","source":"mds","isActive":true,"state":"findable","reason":null,"viewCount":0,"downloadCount":0,"referenceCount":0,"citationCount":0,"partCount":0,"partOfCount":0,"versionCount":0,"versionOfCount":1,"created":"2026-06-15T01:49:16Z","registered":"2026-06-15T01:49:17Z","published":null,"updated":"2026-07-13T01:52:51Z"},"relationships":{"client":{"data":{"id":"arxiv.content","type":"clients"}}}},{"id":"10.48550/arxiv.2606.14130","type":"dois","attributes":{"doi":"10.48550/arxiv.2606.14130","identifiers":[{"identifier":"2606.14130","identifierType":"arXiv"}],"creators":[{"nameType":"Personal","givenName":"Omar","familyName":"Adalat","name":"Adalat, Omar","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Edwin Hamel-De le","familyName":"Court","name":"Court, Edwin Hamel-De le","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Francesco","familyName":"Belardinelli","name":"Belardinelli, Francesco","affiliation":[],"nameIdentifiers":[]}],"titles":[{"title":"Contract-Based Compositional Shielding for Safe Multi-Agent Reinforcement Learning"}],"publisher":"arXiv","container":{},"publicationYear":2026,"subjects":[{"subject":"Machine Learning (cs.LG)","lang":"en","subjectScheme":"arXiv"},{"subject":"Multiagent Systems (cs.MA)","lang":"en","subjectScheme":"arXiv"},{"subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"}],"contributors":[],"dates":[{"date":"2026-06-12T05:30:53Z","dateType":"Submitted","dateInformation":"v1"},{"date":"2026-06-15T00:28:14Z","dateType":"Updated","dateInformation":"v1"},{"date":"2026-07-09T21:57:35Z","dateType":"Submitted","dateInformation":"v2"},{"date":"2026-07-13T00:08:04Z","dateType":"Updated","dateInformation":"v2"},{"date":"2026-06","dateType":"Available","dateInformation":"v1"}],"language":null,"types":{"schemaOrg":"CreativeWork","resourceTypeGeneral":"Preprint","citeproc":"article","bibtex":"misc","ris":"GEN","resourceType":"Article"},"relatedIdentifiers":[],"relatedItems":[],"sizes":[],"formats":[],"version":"2","rightsList":[{"rightsIdentifierScheme":"SPDX","rightsUri":"https://creativecommons.org/licenses/by/4.0/legalcode","schemeUri":"https://spdx.org/licenses/","rights":"Creative Commons Attribution 4.0 International","rightsIdentifier":"cc-by-4.0"}],"descriptions":[{"descriptionType":"Abstract","description":"Safe coordination problems surface in multi-agent reinforcement learning when global safety cannot be enforced by any agent unilaterally: the admissibility of one agent's action may depend on the dynamics of other agents. Decentralised shields can enforce safety at runtime, but purely factorised permissions often exclude optimal team behaviour that is safe only through coordination. We study deterministic safety guarantees for agents trained and deployed under decentralised execution, recovering team-optimal safe behaviour without centralised runtime control. Agents have a shared global specification $ϕ$ in the safety fragment of Linear Temporal Logic ($\\mathsf{LTL}_{\\mathsf{safe}}$ ), and select among tuples of local $\\mathsf{LTL}_{\\mathsf{safe}}$ obligations whose conjunction implies the global specification $ϕ$. Each agent may rely on the other agents' local obligations as assumptions because the whole contract tuple is certified simultaneously and allows projection into local action masks. At learning time, a non-stationary multi-armed bandit chooses among a library of local $\\mathsf{LTL}_{\\mathsf{safe}}$ obligations to select the tuple that optimises team reward, all without forgoing end-to-end safety. We evaluate the approach across 6 environments and 15 algorithmic variants."},{"descriptionType":"Other","description":"Accepted to EUMAS 2026, the 23rd European Conference on Multi-Agent Systems"}],"geoLocations":[],"fundingReferences":[],"url":"https://arxiv.org/abs/2606.14130","contentUrl":null,"metadataVersion":1,"schemaVersion":"http://datacite.org/schema/kernel-4","source":"mds","isActive":true,"state":"findable","reason":null,"viewCount":0,"downloadCount":0,"referenceCount":0,"citationCount":0,"partCount":0,"partOfCount":0,"versionCount":0,"versionOfCount":0,"created":"2026-06-15T01:48:09Z","registered":"2026-06-15T01:48:10Z","published":null,"updated":"2026-07-13T01:52:50Z"},"relationships":{"client":{"data":{"id":"arxiv.content","type":"clients"}}}},{"id":"10.48550/arxiv.2606.14567","type":"dois","attributes":{"doi":"10.48550/arxiv.2606.14567","identifiers":[{"identifier":"2606.14567","identifierType":"arXiv"}],"creators":[{"nameType":"Personal","givenName":"Rameez","familyName":"Iqbal","name":"Iqbal, Rameez","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Gautier","familyName":"Rouaze","name":"Rouaze, Gautier","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Gio","familyName":"Bellone","name":"Bellone, Gio","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Francesco","familyName":"Minola","name":"Minola, Francesco","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Lenan","familyName":"Zhang","name":"Zhang, Lenan","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Zhengmao","familyName":"Lu","name":"Lu, Zhengmao","affiliation":[],"nameIdentifiers":[]}],"titles":[{"title":"Scale-Separated Collective Bubble Nucleation and Departure"}],"publisher":"arXiv","container":{},"publicationYear":2026,"subjects":[{"subject":"Fluid Dynamics (physics.flu-dyn)","lang":"en","subjectScheme":"arXiv"},{"subject":"FOS: Physical sciences","subjectScheme":"Fields of Science and Technology (FOS)"}],"contributors":[],"dates":[{"date":"2026-06-12T15:44:58Z","dateType":"Submitted","dateInformation":"v1"},{"date":"2026-06-15T00:56:19Z","dateType":"Updated","dateInformation":"v1"},{"date":"2026-07-09T09:01:24Z","dateType":"Submitted","dateInformation":"v2"},{"date":"2026-07-10T00:29:57Z","dateType":"Updated","dateInformation":"v2"},{"date":"2026-06","dateType":"Available","dateInformation":"v1"}],"language":null,"types":{"schemaOrg":"CreativeWork","resourceTypeGeneral":"Preprint","citeproc":"article","bibtex":"misc","ris":"GEN","resourceType":"Article"},"relatedIdentifiers":[],"relatedItems":[],"sizes":[],"formats":[],"version":"2","rightsList":[{"rightsUri":"http://arxiv.org/licenses/nonexclusive-distrib/1.0/","rights":"arXiv.org perpetual, non-exclusive license"}],"descriptions":[{"descriptionType":"Abstract","description":"Nucleation is classically treated as a local process, yet whether coupling between neighboring sites governs activation and stability remains unexplored. Here we show bubble nucleation is fundamentally collective: sites separated by the hydrodynamic-boundary-layer scale activate more readily and resist deactivation under changing thermal loads, consistent with a non-local hydrodynamic shielding mechanism, whereby neighboring bubbles slow the intervening flow, suppress convective heat removal, and stabilize vapor embryos. Using surfaces with two independently tunable length scales, we isolate this near-wall coupling from a second collective process, coalescence between departing bubble clusters, which transitions through isolated, promotive, and excessive regimes as the departure diameter grows with heat flux. The dominant length scale thus shifts with operating conditions, from boundary-layer coupling near activation to departure-scale coupling once nucleation is established. These results establish a scale-dependent framework for collective nucleation and departure, broadly related to phase change processes on structured surfaces."}],"geoLocations":[],"fundingReferences":[],"url":"https://arxiv.org/abs/2606.14567","contentUrl":null,"metadataVersion":1,"schemaVersion":"http://datacite.org/schema/kernel-4","source":"mds","isActive":true,"state":"findable","reason":null,"viewCount":0,"downloadCount":0,"referenceCount":0,"citationCount":0,"partCount":0,"partOfCount":0,"versionCount":0,"versionOfCount":0,"created":"2026-06-15T01:57:25Z","registered":"2026-06-15T01:57:26Z","published":null,"updated":"2026-07-10T01:59:08Z"},"relationships":{"client":{"data":{"id":"arxiv.content","type":"clients"}}}},{"id":"10.48550/arxiv.2606.13806","type":"dois","attributes":{"doi":"10.48550/arxiv.2606.13806","identifiers":[{"identifier":"2606.13806","identifierType":"arXiv"}],"creators":[{"nameType":"Personal","givenName":"A. J.","familyName":"Cooper","name":"Cooper, A. J.","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"A. P.","familyName":"Scott","name":"Scott, A. P.","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"L.","familyName":"Rhodes","name":"Rhodes, L.","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"F.","familyName":"Carotenuto","name":"Carotenuto, F.","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"A. K.","familyName":"Hughes","name":"Hughes, A. K.","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"J. H.","familyName":"Matthews","name":"Matthews, J. H.","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"K.","familyName":"Savard","name":"Savard, K.","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"F. J.","familyName":"Cowie","name":"Cowie, F. J.","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"E. L.","familyName":"Elley","name":"Elley, E. L.","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"C.","familyName":"Lilje","name":"Lilje, C.","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"R.","familyName":"Fender","name":"Fender, R.","affiliation":[],"nameIdentifiers":[]}],"titles":[{"title":"Observational Biases and Improved Modelling of Off-axis Relativistic Jets"}],"publisher":"arXiv","container":{},"publicationYear":2026,"subjects":[{"subject":"High Energy Astrophysical Phenomena (astro-ph.HE)","lang":"en","subjectScheme":"arXiv"},{"subject":"Instrumentation and Methods for Astrophysics (astro-ph.IM)","lang":"en","subjectScheme":"arXiv"},{"subject":"FOS: Physical sciences","subjectScheme":"Fields of Science and Technology (FOS)"}],"contributors":[],"dates":[{"date":"2026-06-11T18:20:56Z","dateType":"Submitted","dateInformation":"v1"},{"date":"2026-07-08T13:33:32Z","dateType":"Updated","dateInformation":"v1"},{"date":"2026-06","dateType":"Available","dateInformation":"v1"}],"language":null,"types":{"schemaOrg":"CreativeWork","resourceTypeGeneral":"Preprint","citeproc":"article","bibtex":"misc","ris":"GEN","resourceType":"Article"},"relatedIdentifiers":[{"relationType":"IsVersionOf","relatedIdentifier":"10.1093/mnras/stag1187","relatedIdentifierType":"DOI"}],"relatedItems":[],"sizes":[],"formats":[],"version":"1","rightsList":[{"rightsUri":"http://arxiv.org/licenses/nonexclusive-distrib/1.0/","rights":"arXiv.org perpetual, non-exclusive license"}],"descriptions":[{"descriptionType":"Abstract","description":"Relativistic Doppler boosting significantly affects the observed emission of astrophysical jets resulting in observational biases. In this work we investigate the observational biases and modelling opportunities which arise due to relativistic boosting using two X-ray binary case studies. Using the one-sided jet ejecta from MAXI J1535-571, we demonstrate that incorporating non-detections of the receding jet ejecta into kinematic modelling can significantly improve parameter estimation, reducing posterior uncertainties by over 40%. For the bipolar jets of MAXI J1820+070, we recover the intrinsic jet rest-frame emission of both approaching and receding jet components, demonstrating that they follow a common powerlaw evolution. Using this rest-frame emission profile as a base model, we show that current observational strategies strongly bias against detecting ejecta with high initial Lorentz factors \u0026gt;5 and receding ejecta components across a broad region of parameter space. These results highlight the importance of observational strategy selection, particularly early-time and late-time observations, and leveraging non-detections in the modelling of relativistic jets. More generally, quantifying observational biases and maximising modelling capabilities by incorporating the non-detection of receding jets can be employed to enhance interpretation of future gravitational-wave/optically-triggered observations of off-axis, extragalactic jetted transients."},{"descriptionType":"Other","description":"Accepted for publication, comments welcome before final submission"}],"geoLocations":[],"fundingReferences":[],"url":"https://arxiv.org/abs/2606.13806","contentUrl":null,"metadataVersion":1,"schemaVersion":"http://datacite.org/schema/kernel-4","source":"mds","isActive":true,"state":"findable","reason":null,"viewCount":0,"downloadCount":0,"referenceCount":0,"citationCount":0,"partCount":0,"partOfCount":0,"versionCount":0,"versionOfCount":1,"created":"2026-06-15T01:41:15Z","registered":"2026-06-15T01:41:16Z","published":null,"updated":"2026-07-09T02:07:11Z"},"relationships":{"client":{"data":{"id":"arxiv.content","type":"clients"}}}},{"id":"10.48550/arxiv.2606.14371","type":"dois","attributes":{"doi":"10.48550/arxiv.2606.14371","identifiers":[{"identifier":"2606.14371","identifierType":"arXiv"}],"creators":[{"nameType":"Personal","givenName":"Irene","familyName":"Mariblanca-Escalona","name":"Mariblanca-Escalona, Irene","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Pedro J.","familyName":"Gutiérrez","name":"Gutiérrez, Pedro J.","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Fernando","familyName":"Moreno","name":"Moreno, Fernando","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Luisa M.","familyName":"Lara","name":"Lara, Luisa M.","affiliation":[],"nameIdentifiers":[]}],"titles":[{"title":"Dust and coma radicals in C/2024 E1 (Wierzchos): evolution of the activity"}],"publisher":"arXiv","container":{},"publicationYear":2026,"subjects":[{"subject":"Earth and Planetary Astrophysics (astro-ph.EP)","lang":"en","subjectScheme":"arXiv"},{"subject":"FOS: Physical sciences","subjectScheme":"Fields of Science and Technology (FOS)"}],"contributors":[],"dates":[{"date":"2026-06-12T12:01:23Z","dateType":"Submitted","dateInformation":"v1"},{"date":"2026-07-08T13:33:30Z","dateType":"Updated","dateInformation":"v1"},{"date":"2026-06","dateType":"Available","dateInformation":"v1"}],"language":null,"types":{"schemaOrg":"CreativeWork","resourceTypeGeneral":"Preprint","citeproc":"article","bibtex":"misc","ris":"GEN","resourceType":"Article"},"relatedIdentifiers":[{"relationType":"IsVersionOf","relatedIdentifier":"10.1093/mnras/stag1143","relatedIdentifierType":"DOI"}],"relatedItems":[],"sizes":[],"formats":[],"version":"1","rightsList":[{"rightsIdentifierScheme":"SPDX","rightsUri":"https://creativecommons.org/licenses/by/4.0/legalcode","schemeUri":"https://spdx.org/licenses/","rights":"Creative Commons Attribution 4.0 International","rightsIdentifier":"cc-by-4.0"}],"descriptions":[{"descriptionType":"Abstract","description":"We present multi-epoch R-band imaging and long-slit spectroscopy of the dynamically new comet C/2024 E1 (Wierzchos) during its pre-perihelion phase, spanning heliocentric distances from 4.5 to 2.3 au. The most prominent fluorescence emissions in the visible wavelength range are detected. We measure production rates of CN, C$_2$, and C$_3$, while no significant NH$_2$ signal is identified. In our dataset, CN became detectable at 3.48 au, and C$_3$ and C$_2$ at 2.80 au. The mean ratios $\\log\\mathrm{C}_2/\\mathrm{CN} = 0.00 \\pm 0.07$ and $\\log\\mathrm{C}_3/\\mathrm{CN} = -1.03 \\pm 0.09$ place the comet in an intermediate taxonomic regime between typical and carbon-depleted populations. Dust production rates, ejection velocities, and particle size distributions are constrained using a Monte Carlo dust tail model that reproduces the observed coma morphology. The dust population is characterized by a power-law size distribution with an exponent of $\\sim -3.5$, and particle sizes ranging from 1~$μ$m to 4~mm. The inferred initial ejection velocities span from $\\sim$20$ m $s$^{-1}$ to $\\sim$100$ m $s$^{-1}$. We use the empirical relation between CN and OH to estimate the water production rate and derive the dust-to-gas mass ratio for heliocentric distances $r_{\\rm{h}} \\lesssim 3$ au, where water sublimation is expected to dominate the activity regime. The dust-to-gas mass ratio remains consistently above unity, ranging from $\\sim$1 to 3 depending on the choice of scale lengths and the CN--OH conversion factor. This result characterizes C/2024 E1 as a ``dust-rich'' comet, where the mass loss is dominated by the refractory component rather than volatiles."},{"descriptionType":"Other","description":"13 pages, 10 figures, (accepted for publication in MNRAS)"}],"geoLocations":[],"fundingReferences":[],"url":"https://arxiv.org/abs/2606.14371","contentUrl":null,"metadataVersion":1,"schemaVersion":"http://datacite.org/schema/kernel-4","source":"mds","isActive":true,"state":"findable","reason":null,"viewCount":0,"downloadCount":0,"referenceCount":0,"citationCount":0,"partCount":0,"partOfCount":0,"versionCount":0,"versionOfCount":1,"created":"2026-06-15T01:53:16Z","registered":"2026-06-15T01:53:17Z","published":null,"updated":"2026-07-09T02:07:11Z"},"relationships":{"client":{"data":{"id":"arxiv.content","type":"clients"}}}},{"id":"10.48550/arxiv.2606.14048","type":"dois","attributes":{"doi":"10.48550/arxiv.2606.14048","identifiers":[{"identifier":"2606.14048","identifierType":"arXiv"}],"creators":[{"nameType":"Personal","givenName":"Ying","familyName":"Li","name":"Li, Ying","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Xiaobao","familyName":"Wei","name":"Wei, Xiaobao","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Jiajun","familyName":"Cao","name":"Cao, Jiajun","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Hao","familyName":"Wang","name":"Wang, Hao","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Xiaowei","familyName":"Chi","name":"Chi, Xiaowei","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Chengyu","familyName":"Bai","name":"Bai, Chengyu","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Qianpu","familyName":"Sun","name":"Sun, Qianpu","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Jiajun","familyName":"Li","name":"Li, Jiajun","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Xiaojie","familyName":"Zhang","name":"Zhang, Xiaojie","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Peidong","familyName":"Jia","name":"Jia, Peidong","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Jian","familyName":"Tang","name":"Tang, Jian","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Sirui","familyName":"Han","name":"Han, Sirui","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Shanghang","familyName":"Zhang","name":"Zhang, Shanghang","affiliation":[],"nameIdentifiers":[]}],"titles":[{"title":"WAM4D: Fast 4D World Action Model via Spatial Register Tokens"}],"publisher":"arXiv","container":{},"publicationYear":2026,"subjects":[{"subject":"Computer Vision and Pattern Recognition (cs.CV)","lang":"en","subjectScheme":"arXiv"},{"subject":"Robotics (cs.RO)","lang":"en","subjectScheme":"arXiv"},{"subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"}],"contributors":[],"dates":[{"date":"2026-06-12T02:49:34Z","dateType":"Submitted","dateInformation":"v1"},{"date":"2026-06-15T00:22:23Z","dateType":"Updated","dateInformation":"v1"},{"date":"2026-07-05T11:32:51Z","dateType":"Submitted","dateInformation":"v2"},{"date":"2026-07-07T01:36:56Z","dateType":"Updated","dateInformation":"v2"},{"date":"2026-07-07T05:53:33Z","dateType":"Submitted","dateInformation":"v3"},{"date":"2026-07-08T00:25:28Z","dateType":"Updated","dateInformation":"v3"},{"date":"2026-06","dateType":"Available","dateInformation":"v1"}],"language":null,"types":{"schemaOrg":"CreativeWork","resourceTypeGeneral":"Preprint","citeproc":"article","bibtex":"misc","ris":"GEN","resourceType":"Article"},"relatedIdentifiers":[],"relatedItems":[],"sizes":[],"formats":[],"version":"3","rightsList":[{"rightsIdentifierScheme":"SPDX","rightsUri":"https://creativecommons.org/licenses/by/4.0/legalcode","schemeUri":"https://spdx.org/licenses/","rights":"Creative Commons Attribution 4.0 International","rightsIdentifier":"cc-by-4.0"}],"descriptions":[{"descriptionType":"Abstract","description":"World action models (WAMs) have recently shown promise in jointly modeling future observations and executable robot actions. However, most existing WAMs still operate in 2D video or latent spaces, where visually plausible rollouts miss the 3D spatial constraints and occluded contact geometry required for precise manipulation. While geometric foundation models offer strong priors for recovering dense 3D structure and motion from visual observations, forcing WAMs to predict the dense 4D representation introduces costly geometric decoding and slows down causal action generation. To address the trade-off, we present WAM4D, a fast 4D world action model that uses lightweight spatial register tokens as training-time future-depth readouts to transfer pretrained geometric priors into a causal video-action transformer, then removes the register branch for lightweight action inference. To prevent non-causal shortcuts, we further design causal mixture attention for the Mixture-of-Transformers (MoT) WAM backbone, defining modality-specific visibility among video, action, and geometry tokens. Comprehensive experiments on RoboTwin 2.0 and challenging real-world manipulation tasks show that WAM4D improves spatial consistency and achieves competitive action prediction while maintaining efficient inference."},{"descriptionType":"Other","description":"15 pages, 7figures, 9tables"}],"geoLocations":[],"fundingReferences":[],"url":"https://arxiv.org/abs/2606.14048","contentUrl":null,"metadataVersion":2,"schemaVersion":"http://datacite.org/schema/kernel-4","source":"mds","isActive":true,"state":"findable","reason":null,"viewCount":0,"downloadCount":0,"referenceCount":0,"citationCount":0,"partCount":0,"partOfCount":0,"versionCount":0,"versionOfCount":0,"created":"2026-06-15T01:46:26Z","registered":"2026-06-15T01:46:27Z","published":null,"updated":"2026-07-08T02:14:18Z"},"relationships":{"client":{"data":{"id":"arxiv.content","type":"clients"}}}},{"id":"10.48550/arxiv.2606.13757","type":"dois","attributes":{"doi":"10.48550/arxiv.2606.13757","identifiers":[{"identifier":"2606.13757","identifierType":"arXiv"}],"creators":[{"nameType":"Personal","givenName":"Rui","familyName":"Melo","name":"Melo, Rui","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Riccardo","familyName":"Fogliato","name":"Fogliato, Riccardo","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Sean","familyName":"Zhou","name":"Zhou, Sean","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Pratiksha","familyName":"Thaker","name":"Thaker, Pratiksha","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Zhiwei Steven","familyName":"Wu","name":"Wu, Zhiwei Steven","affiliation":[],"nameIdentifiers":[]}],"titles":[{"title":"SEVRA-BENCH: Social Engineering of Vulnerabilities in Review Agents"}],"publisher":"arXiv","container":{},"publicationYear":2026,"subjects":[{"subject":"Cryptography and Security (cs.CR)","lang":"en","subjectScheme":"arXiv"},{"subject":"Artificial Intelligence (cs.AI)","lang":"en","subjectScheme":"arXiv"},{"subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"}],"contributors":[],"dates":[{"date":"2026-06-11T16:35:56Z","dateType":"Submitted","dateInformation":"v1"},{"date":"2026-06-15T00:03:51Z","dateType":"Updated","dateInformation":"v1"},{"date":"2026-07-06T18:27:31Z","dateType":"Submitted","dateInformation":"v2"},{"date":"2026-07-08T00:03:38Z","dateType":"Updated","dateInformation":"v2"},{"date":"2026-06","dateType":"Available","dateInformation":"v1"}],"language":null,"types":{"schemaOrg":"CreativeWork","resourceTypeGeneral":"Preprint","citeproc":"article","bibtex":"misc","ris":"GEN","resourceType":"Article"},"relatedIdentifiers":[],"relatedItems":[],"sizes":[],"formats":[],"version":"2","rightsList":[{"rightsUri":"http://arxiv.org/licenses/nonexclusive-distrib/1.0/","rights":"arXiv.org perpetual, non-exclusive license"}],"descriptions":[{"descriptionType":"Abstract","description":"Large language models (LLMs) are increasingly deployed in automated code-review systems, where their approvals can determine which code is merged into shared repositories. However, it is unclear whether review agents can detect vulnerability-introducing code when an attacker controls both the code change and the persuasive Pull Request (PR) narrative designed to mask it. We introduce SEVRA-BENCH (Social Engineering of Vulnerabilities in Review Agents), a benchmark that measures how often a review agent approves such adversarial PR s. Each PR in SEVRA-BENCH is built from a historical commit that fixed a vulnerability. We automatically reverse that fix to extract the original vulnerable code, and submit the resulting code change as a PR wrapped in one of 15 social-engineering framings. To test review-agent resilience to narrative manipulation, these framings vary dimensions such as supporting evidence, conveyed urgency, signals of prior approval, and appeals to authority. SEVRA-BENCH evaluates a retained challenge split of roughly 1000 adversarial PRs drawn from publicly disclosed vulnerability fixes across the top 10 entries of the MITRE's 2025 most dangerous software weaknesses. Evaluating 8 review agents against this benchmark, we reveal that review agents are susceptible to narrative manipulation, exposing a significant gap in security capabilities."}],"geoLocations":[],"fundingReferences":[],"url":"https://arxiv.org/abs/2606.13757","contentUrl":null,"metadataVersion":1,"schemaVersion":"http://datacite.org/schema/kernel-4","source":"mds","isActive":true,"state":"findable","reason":null,"viewCount":0,"downloadCount":0,"referenceCount":0,"citationCount":0,"partCount":0,"partOfCount":0,"versionCount":0,"versionOfCount":0,"created":"2026-06-15T01:40:12Z","registered":"2026-06-15T01:40:13Z","published":null,"updated":"2026-07-08T02:14:18Z"},"relationships":{"client":{"data":{"id":"arxiv.content","type":"clients"}}}},{"id":"10.48550/arxiv.2606.14469","type":"dois","attributes":{"doi":"10.48550/arxiv.2606.14469","identifiers":[{"identifier":"2606.14469","identifierType":"arXiv"}],"creators":[{"nameType":"Personal","givenName":"Álvaro","familyName":"Arboleya","name":"Arboleya, Álvaro","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Adolfo","familyName":"Guarino","name":"Guarino, Adolfo","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Clara","familyName":"Roldán-Domínguez","name":"Roldán-Domínguez, Clara","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Giuseppe","familyName":"Sudano","name":"Sudano, Giuseppe","affiliation":[],"nameIdentifiers":[]}],"titles":[{"title":"On the branes behind scale-separated AdS$_{3}$ flux vacua"}],"publisher":"arXiv","container":{},"publicationYear":2026,"subjects":[{"subject":"High Energy Physics - Theory (hep-th)","lang":"en","subjectScheme":"arXiv"},{"subject":"FOS: Physical sciences","subjectScheme":"Fields of Science and Technology (FOS)"}],"contributors":[],"dates":[{"date":"2026-06-12T14:00:11Z","dateType":"Submitted","dateInformation":"v1"},{"date":"2026-06-15T00:50:29Z","dateType":"Updated","dateInformation":"v1"},{"date":"2026-07-06T15:31:27Z","dateType":"Submitted","dateInformation":"v2"},{"date":"2026-07-07T02:26:52Z","dateType":"Updated","dateInformation":"v2"},{"date":"2026-06","dateType":"Available","dateInformation":"v1"}],"language":null,"types":{"schemaOrg":"CreativeWork","resourceTypeGeneral":"Preprint","citeproc":"article","bibtex":"misc","ris":"GEN","resourceType":"Article"},"relatedIdentifiers":[],"relatedItems":[],"sizes":[],"formats":[],"version":"2","rightsList":[{"rightsIdentifierScheme":"SPDX","rightsUri":"https://creativecommons.org/licenses/by/4.0/legalcode","schemeUri":"https://spdx.org/licenses/","rights":"Creative Commons Attribution 4.0 International","rightsIdentifier":"cc-by-4.0"}],"descriptions":[{"descriptionType":"Abstract","description":"We investigate the brane origin of supersymmetric and scale-separated AdS$_3$ flux vacua arising in a class of type IIB orientifold reductions with G$_2$-structure. First, using the effective three-dimensional supergravity together with explicit uplift formulae, we trace back the $F_{(7)}$ and $F_{(3)}$ fluxes responsible for scale separation and identify the type IIB background that is probed by the corresponding D1- and D5-branes. Second, by restoring such D1- and D5-branes, we obtain a type IIB solution that interpolates between the previous background in the asymptotic region and the scale-separated AdS$_3$ flux vacua in the near-horizon region. Third, by working directly in ten dimensions, we construct a codimension-one D1-D5-KK5 intersection whose near-horizon region realises the scale-separated AdS$_3$ flux vacua. Our results provide a higher-dimensional interpretation of these flux vacua in terms of (smeared) brane configurations."},{"descriptionType":"Other","description":"37 pages, 2 figures, 3 tables. v2: Minor corrections, discussion improvements, and references added"}],"geoLocations":[],"fundingReferences":[],"url":"https://arxiv.org/abs/2606.14469","contentUrl":null,"metadataVersion":1,"schemaVersion":"http://datacite.org/schema/kernel-4","source":"mds","isActive":true,"state":"findable","reason":null,"viewCount":0,"downloadCount":0,"referenceCount":0,"citationCount":0,"partCount":0,"partOfCount":0,"versionCount":0,"versionOfCount":0,"created":"2026-06-15T01:55:20Z","registered":"2026-06-15T01:55:20Z","published":null,"updated":"2026-07-07T05:11:01Z"},"relationships":{"client":{"data":{"id":"arxiv.content","type":"clients"}}}},{"id":"10.48550/arxiv.2606.14429","type":"dois","attributes":{"doi":"10.48550/arxiv.2606.14429","identifiers":[{"identifier":"2606.14429","identifierType":"arXiv"}],"creators":[{"nameType":"Personal","givenName":"Rodion","familyName":"Déev","name":"Déev, Rodion","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Vasily","familyName":"Rogov","name":"Rogov, Vasily","affiliation":[],"nameIdentifiers":[]}],"titles":[{"title":"Holomorphic families of knots"}],"publisher":"arXiv","container":{},"publicationYear":2026,"subjects":[{"subject":"Differential Geometry (math.DG)","lang":"en","subjectScheme":"arXiv"},{"subject":"Complex Variables (math.CV)","lang":"en","subjectScheme":"arXiv"},{"subject":"FOS: Mathematics","subjectScheme":"Fields of Science and Technology (FOS)"},{"subject":"57K35, 53C28, 32L25, 32J15","lang":"en","subjectScheme":"MSC"}],"contributors":[],"dates":[{"date":"2026-06-12T13:11:37Z","dateType":"Submitted","dateInformation":"v1"},{"date":"2026-06-15T00:48:08Z","dateType":"Updated","dateInformation":"v1"},{"date":"2026-07-06T15:27:01Z","dateType":"Submitted","dateInformation":"v2"},{"date":"2026-07-07T02:26:37Z","dateType":"Updated","dateInformation":"v2"},{"date":"2026-06","dateType":"Available","dateInformation":"v1"}],"language":null,"types":{"schemaOrg":"CreativeWork","resourceTypeGeneral":"Preprint","citeproc":"article","bibtex":"misc","ris":"GEN","resourceType":"Article"},"relatedIdentifiers":[],"relatedItems":[],"sizes":[],"formats":[],"version":"2","rightsList":[{"rightsIdentifierScheme":"SPDX","rightsUri":"https://creativecommons.org/licenses/by-sa/4.0/legalcode","schemeUri":"https://spdx.org/licenses/","rights":"Creative Commons Attribution Share Alike 4.0 International","rightsIdentifier":"cc-by-sa-4.0"}],"descriptions":[{"descriptionType":"Abstract","description":"Let $(M, [g])$ be a $3$-dimensional conformal manifold. The space of knots $\\operatorname{Kn}(M)$ in $M$ is an infinite-dimensional manifold that is known to carry an almost complex structure. This structure is formally integrable by a result of Brylinski. We study finite dimensional holomorphic submanifolds in $\\operatorname{Kn}(M)$. We define an holomorphic family of knots in $(M, [g])$ parametrised by a finite-dimensional complex manifold $(X, I_X)$, and construct several series of examples. We show that the base $(X, I_X)$ is Kähler, and if $X$ is compact, it is a projective variety of complex dimension at most $2$. In this case the conformal structure $[g]$ uniquely determines the complex structure $I_X$ and vice versa. We prove that if an holomorphic family of knots in $(M, [g])$ over a compact base $(X, I_X)$ defines a foliation on $\\mathbf{S}(TM)$, then $(X, I_X) \\simeq \\mathbb{C}\\mathbf{P}^1 \\times \\mathbb{C}\\mathbf{P}^1$, the manifold $(M, [g])$ is conformally equivalent to either $S^3$ or $\\mathbb{R}\\mathbf{P}^3$ with round metric, and all knots are geodesic in some round metric in the class."},{"descriptionType":"Other","description":"27 pages; subsection 5.4 is added"}],"geoLocations":[],"fundingReferences":[],"url":"https://arxiv.org/abs/2606.14429","contentUrl":null,"metadataVersion":1,"schemaVersion":"http://datacite.org/schema/kernel-4","source":"mds","isActive":true,"state":"findable","reason":null,"viewCount":0,"downloadCount":0,"referenceCount":0,"citationCount":0,"partCount":0,"partOfCount":0,"versionCount":0,"versionOfCount":0,"created":"2026-06-15T01:54:29Z","registered":"2026-06-15T01:54:30Z","published":null,"updated":"2026-07-07T05:11:00Z"},"relationships":{"client":{"data":{"id":"arxiv.content","type":"clients"}}}},{"id":"10.48550/arxiv.2606.14427","type":"dois","attributes":{"doi":"10.48550/arxiv.2606.14427","identifiers":[{"identifier":"2606.14427","identifierType":"arXiv"}],"creators":[{"nameType":"Personal","givenName":"Jacob","familyName":"Huckelberry","name":"Huckelberry, Jacob","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Andrea Mattia","familyName":"Garavagno","name":"Garavagno, Andrea Mattia","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Yuke","familyName":"Zhang","name":"Zhang, Yuke","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Peter A.","familyName":"Beerel","name":"Beerel, Peter A.","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"James","familyName":"Mickens","name":"Mickens, James","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Vijay Janapa","familyName":"Reddi","name":"Reddi, Vijay Janapa","affiliation":[],"nameIdentifiers":[]}],"titles":[{"title":"Breaking TinyML: Why Quantized Neural Networks Need Domain-Specific Security Analysis"}],"publisher":"arXiv","container":{},"publicationYear":2026,"subjects":[{"subject":"Cryptography and Security (cs.CR)","lang":"en","subjectScheme":"arXiv"},{"subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"}],"contributors":[],"dates":[{"date":"2026-06-12T13:05:34Z","dateType":"Submitted","dateInformation":"v1"},{"date":"2026-07-07T00:38:59Z","dateType":"Updated","dateInformation":"v1"},{"date":"2026-06","dateType":"Available","dateInformation":"v1"}],"language":null,"types":{"schemaOrg":"CreativeWork","resourceTypeGeneral":"Preprint","citeproc":"article","bibtex":"misc","ris":"GEN","resourceType":"Article"},"relatedIdentifiers":[{"relationType":"IsVersionOf","relatedIdentifier":"10.1109/mm.2026.3666128","relatedIdentifierType":"DOI"}],"relatedItems":[],"sizes":[],"formats":[],"version":"1","rightsList":[{"rightsUri":"http://arxiv.org/licenses/nonexclusive-distrib/1.0/","rights":"arXiv.org perpetual, non-exclusive license"}],"descriptions":[{"descriptionType":"Abstract","description":"Most TinyML hardware accelerators focus on supporting Quantized Neural Networks (QNNs) to meet stringent constraints on power consumption and size. Despite this, the security aspects of quantization within TinyML hardware remain largely unexplored. Although previous studies indicate that QNNs demonstrate similar or enhanced robustness when compared to full-precision Deep Neural Networks (DNNs) against typical evasion attacks, no attack strategies tailored specifically for TinyML hardware have been proposed yet. This paper addresses this shortfall by demonstrating how a two-step attack pipeline can surpass the current state-of-the-art in the QNN context and shows the need for more hardware-aware security research."}],"geoLocations":[],"fundingReferences":[],"url":"https://arxiv.org/abs/2606.14427","contentUrl":null,"metadataVersion":1,"schemaVersion":"http://datacite.org/schema/kernel-4","source":"mds","isActive":true,"state":"findable","reason":null,"viewCount":0,"downloadCount":0,"referenceCount":0,"citationCount":0,"partCount":0,"partOfCount":0,"versionCount":0,"versionOfCount":1,"created":"2026-06-15T01:54:27Z","registered":"2026-06-15T01:54:27Z","published":null,"updated":"2026-07-07T05:11:00Z"},"relationships":{"client":{"data":{"id":"arxiv.content","type":"clients"}}}},{"id":"10.48550/arxiv.2606.14405","type":"dois","attributes":{"doi":"10.48550/arxiv.2606.14405","identifiers":[{"identifier":"2606.14405","identifierType":"arXiv"}],"creators":[{"nameType":"Personal","givenName":"M. V. S.","familyName":"Saketh","name":"Saketh, M. V. S.","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Suprovo","familyName":"Ghosh","name":"Ghosh, Suprovo","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Nils","familyName":"Andersson","name":"Andersson, Nils","affiliation":[],"nameIdentifiers":[]}],"titles":[{"title":"Dynamical tidal response of neutron stars via scattering amplitudes"}],"publisher":"arXiv","container":{},"publicationYear":2026,"subjects":[{"subject":"General Relativity and Quantum Cosmology (gr-qc)","lang":"en","subjectScheme":"arXiv"},{"subject":"High Energy Astrophysical Phenomena (astro-ph.HE)","lang":"en","subjectScheme":"arXiv"},{"subject":"High Energy Physics - Theory (hep-th)","lang":"en","subjectScheme":"arXiv"},{"subject":"FOS: Physical sciences","subjectScheme":"Fields of Science and Technology (FOS)"}],"contributors":[],"dates":[{"date":"2026-06-12T12:42:22Z","dateType":"Submitted","dateInformation":"v1"},{"date":"2026-06-15T00:47:04Z","dateType":"Updated","dateInformation":"v1"},{"date":"2026-06-25T16:20:18Z","dateType":"Submitted","dateInformation":"v2"},{"date":"2026-06-26T01:00:20Z","dateType":"Updated","dateInformation":"v2"},{"date":"2026-07-04T07:57:36Z","dateType":"Submitted","dateInformation":"v3"},{"date":"2026-07-07T01:09:20Z","dateType":"Updated","dateInformation":"v3"},{"date":"2026-06","dateType":"Available","dateInformation":"v1"}],"language":null,"types":{"schemaOrg":"CreativeWork","resourceTypeGeneral":"Preprint","citeproc":"article","bibtex":"misc","ris":"GEN","resourceType":"Article"},"relatedIdentifiers":[],"relatedItems":[],"sizes":[],"formats":[],"version":"3","rightsList":[{"rightsIdentifierScheme":"SPDX","rightsUri":"https://creativecommons.org/licenses/by/4.0/legalcode","schemeUri":"https://spdx.org/licenses/","rights":"Creative Commons Attribution 4.0 International","rightsIdentifier":"cc-by-4.0"}],"descriptions":[{"descriptionType":"Abstract","description":"A key challenge of gravitational-wave physics is distinguishing the nature of compact objects in binary coalescences, in particular whether they are black holes or neutron stars. Neutron stars are set apart by a stronger tidal response, whose static and dynamical aspects are directly linked to their rich internal physics. Measurements of this response through gravitational-wave observations constrain the neutron-star equation of state and provide insight into the physics of high-density matter. However, defining the tidal response in general relativity is difficult due to coordinate ambiguities and the complexity of connecting the star's response to the binary dynamics and the associated waveforms. In this paper, we show how the dynamical tidal response of a neutron star can be systematically defined within the worldline effective field theory (EFT) framework, and relate it to the gauge-invariant amplitude for gravitational-wave scattering off an isolated star. We compute this amplitude both within the EFT, using standard quantum field-theory techniques, and within stellar perturbation theory (the corresponding ultraviolet theory), solving the coupled metric and matter perturbation equations numerically in the stellar interior and matching to the analytical Mano-Suzuki-Takasugi (MST) solutions in the vacuum exterior. Matching the amplitude between the two theories fixes the dynamical tidal response. The result is consistent with known expectations, including the static limit and the behaviour near the star's resonant modes, and it recovers the imaginary part of the dominant oscillation mode induced by gravitational-wave dissipation. We conclude with a discussion of potential improvements within both the EFT and perturbation theory."},{"descriptionType":"Other","description":"18 pages, 10 figures, V3"}],"geoLocations":[],"fundingReferences":[],"url":"https://arxiv.org/abs/2606.14405","contentUrl":null,"metadataVersion":2,"schemaVersion":"http://datacite.org/schema/kernel-4","source":"mds","isActive":true,"state":"findable","reason":null,"viewCount":0,"downloadCount":0,"referenceCount":0,"citationCount":0,"partCount":0,"partOfCount":0,"versionCount":0,"versionOfCount":0,"created":"2026-06-15T01:53:59Z","registered":"2026-06-15T01:54:00Z","published":null,"updated":"2026-07-07T05:10:59Z"},"relationships":{"client":{"data":{"id":"arxiv.content","type":"clients"}}}},{"id":"10.48550/arxiv.2606.14216","type":"dois","attributes":{"doi":"10.48550/arxiv.2606.14216","identifiers":[{"identifier":"2606.14216","identifierType":"arXiv"}],"creators":[{"nameType":"Personal","givenName":"Aron J.","familyName":"Aertssen","name":"Aertssen, Aron J.","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Lars A. T. H.","familyName":"van Alen","name":"van Alen, Lars A. T. H.","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Igo J. M.","familyName":"Besselink","name":"Besselink, Igo J. M.","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Rudolf G. M.","familyName":"Huisman","name":"Huisman, Rudolf G. M.","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"René M. J. G.","familyName":"van de Molengraft","name":"van de Molengraft, René M. J. G.","affiliation":[],"nameIdentifiers":[]}],"titles":[{"title":"Short-Horizon Position Accuracy of Single-Track Models: Implications for Motion Planning of Autonomous Vehicles"}],"publisher":"arXiv","container":{},"publicationYear":2026,"subjects":[{"subject":"Robotics (cs.RO)","lang":"en","subjectScheme":"arXiv"},{"subject":"Systems and Control (eess.SY)","lang":"en","subjectScheme":"arXiv"},{"subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"},{"subject":"FOS: Electrical engineering, electronic engineering, information engineering","subjectScheme":"Fields of Science and Technology (FOS)"}],"contributors":[],"dates":[{"date":"2026-06-12T07:53:23Z","dateType":"Submitted","dateInformation":"v1"},{"date":"2026-06-15T00:34:02Z","dateType":"Updated","dateInformation":"v1"},{"date":"2026-07-06T11:37:24Z","dateType":"Submitted","dateInformation":"v2"},{"date":"2026-07-07T02:14:21Z","dateType":"Updated","dateInformation":"v2"},{"date":"2026-06","dateType":"Available","dateInformation":"v1"}],"language":null,"types":{"schemaOrg":"CreativeWork","resourceTypeGeneral":"Preprint","citeproc":"article","bibtex":"misc","ris":"GEN","resourceType":"Article"},"relatedIdentifiers":[],"relatedItems":[],"sizes":[],"formats":[],"version":"2","rightsList":[{"rightsIdentifierScheme":"SPDX","rightsUri":"https://creativecommons.org/licenses/by/4.0/legalcode","schemeUri":"https://spdx.org/licenses/","rights":"Creative Commons Attribution 4.0 International","rightsIdentifier":"cc-by-4.0"}],"descriptions":[{"descriptionType":"Abstract","description":"Accurate and computationally efficient vehicle models are essential for motion planning of autonomous vehicles, where positional accuracy directly affects trajectory feasibility and safety. However, the positional accuracy has not been systematically evaluated against real measurements. Therefore, this paper compares the short-horizon positional accuracy of three single-track vehicle models against vehicle measurements across various driving maneuvers. Model parameters are identified through dedicated experiments with the instrumented test vehicle. Rather than identifying a single best model, this work aims to provide insight into the trade-offs between model complexity, parameterization quality, and positional accuracy for informed model selection in Model Predictive Control applications."},{"descriptionType":"Other","description":"Submitted to The International Journal of Automotive Engineering, Official Journal of the Society of Automotive Engineers of Japan, Inc. (JSAE)"}],"geoLocations":[],"fundingReferences":[],"url":"https://arxiv.org/abs/2606.14216","contentUrl":null,"metadataVersion":1,"schemaVersion":"http://datacite.org/schema/kernel-4","source":"mds","isActive":true,"state":"findable","reason":null,"viewCount":0,"downloadCount":0,"referenceCount":0,"citationCount":0,"partCount":0,"partOfCount":0,"versionCount":0,"versionOfCount":0,"created":"2026-06-15T01:49:57Z","registered":"2026-06-15T01:49:57Z","published":null,"updated":"2026-07-07T05:10:58Z"},"relationships":{"client":{"data":{"id":"arxiv.content","type":"clients"}}}},{"id":"10.48550/arxiv.2606.14500","type":"dois","attributes":{"doi":"10.48550/arxiv.2606.14500","identifiers":[{"identifier":"2606.14500","identifierType":"arXiv"}],"creators":[{"nameType":"Personal","givenName":"Jérémy Le","familyName":"Borgne","name":"Borgne, Jérémy Le","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Frédéric","familyName":"Marbach","name":"Marbach, Frédéric","affiliation":[],"nameIdentifiers":[]}],"titles":[{"title":"Local convergence of Sussmann's infinite product for analytic vector fields"}],"publisher":"arXiv","container":{},"publicationYear":2026,"subjects":[{"subject":"Classical Analysis and ODEs (math.CA)","lang":"en","subjectScheme":"arXiv"},{"subject":"Optimization and Control (math.OC)","lang":"en","subjectScheme":"arXiv"},{"subject":"FOS: Mathematics","subjectScheme":"Fields of Science and Technology (FOS)"},{"subject":"34A25, 93C10, 17B01, 17B66","lang":"en","subjectScheme":"MSC"}],"contributors":[],"dates":[{"date":"2026-06-12T14:32:41Z","dateType":"Submitted","dateInformation":"v1"},{"date":"2026-06-15T00:52:05Z","dateType":"Updated","dateInformation":"v1"},{"date":"2026-07-02T17:54:21Z","dateType":"Submitted","dateInformation":"v2"},{"date":"2026-07-03T01:07:26Z","dateType":"Updated","dateInformation":"v2"},{"date":"2026-06","dateType":"Available","dateInformation":"v1"}],"language":null,"types":{"schemaOrg":"CreativeWork","resourceTypeGeneral":"Preprint","citeproc":"article","bibtex":"misc","ris":"GEN","resourceType":"Article"},"relatedIdentifiers":[],"relatedItems":[],"sizes":[],"formats":[],"version":"2","rightsList":[{"rightsIdentifierScheme":"SPDX","rightsUri":"https://creativecommons.org/licenses/by-sa/4.0/legalcode","schemeUri":"https://spdx.org/licenses/","rights":"Creative Commons Attribution Share Alike 4.0 International","rightsIdentifier":"cc-by-sa-4.0"}],"descriptions":[{"descriptionType":"Abstract","description":"In 1986, Sussmann proposed an expansion of the Chen series as an infinite product of exponentials of Hall basis elements multiplied by coefficients defined through a simple induction. He proved that this product converges locally in time for bilinear control systems associated with matrices or bounded operators.\n In this note, we prove that Sussmann's product also converges locally in time for control-affine systems driven by analytic vector fields. The difficulty is that one must keep track of the structure of the involved Lie brackets, as the natural decay of the explicit coefficients is not enough to counterbalance the natural growth of the iterated Lie brackets."}],"geoLocations":[],"fundingReferences":[],"url":"https://arxiv.org/abs/2606.14500","contentUrl":null,"metadataVersion":1,"schemaVersion":"http://datacite.org/schema/kernel-4","source":"mds","isActive":true,"state":"findable","reason":null,"viewCount":0,"downloadCount":0,"referenceCount":0,"citationCount":0,"partCount":0,"partOfCount":0,"versionCount":0,"versionOfCount":0,"created":"2026-06-15T01:56:00Z","registered":"2026-06-15T01:56:01Z","published":null,"updated":"2026-07-03T02:18:43Z"},"relationships":{"client":{"data":{"id":"arxiv.content","type":"clients"}}}},{"id":"10.48550/arxiv.2606.13732","type":"dois","attributes":{"doi":"10.48550/arxiv.2606.13732","identifiers":[{"identifier":"2606.13732","identifierType":"arXiv"}],"creators":[{"nameType":"Personal","givenName":"Xinbao","familyName":"Qiao","name":"Qiao, Xinbao","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Xianglong","familyName":"Du","name":"Du, Xianglong","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Wei","familyName":"Liu","name":"Liu, Wei","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Jingqi","familyName":"Zhang","name":"Zhang, Jingqi","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Peihua","familyName":"Mai","name":"Mai, Peihua","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Meng","familyName":"Zhang","name":"Zhang, Meng","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Yan","familyName":"Pang","name":"Pang, Yan","affiliation":[],"nameIdentifiers":[]}],"titles":[{"title":"When Sample Selection Bias Precipitates Model Collapse"}],"publisher":"arXiv","container":{},"publicationYear":2026,"subjects":[{"subject":"Artificial Intelligence (cs.AI)","lang":"en","subjectScheme":"arXiv"},{"subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"}],"contributors":[],"dates":[{"date":"2026-06-11T11:49:39Z","dateType":"Submitted","dateInformation":"v1"},{"date":"2026-06-15T00:02:40Z","dateType":"Updated","dateInformation":"v1"},{"date":"2026-07-02T11:07:34Z","dateType":"Submitted","dateInformation":"v2"},{"date":"2026-07-03T00:44:18Z","dateType":"Updated","dateInformation":"v2"},{"date":"2026-06","dateType":"Available","dateInformation":"v1"}],"language":null,"types":{"schemaOrg":"CreativeWork","resourceTypeGeneral":"Preprint","citeproc":"article","bibtex":"misc","ris":"GEN","resourceType":"Article"},"relatedIdentifiers":[],"relatedItems":[],"sizes":[],"formats":[],"version":"2","rightsList":[{"rightsIdentifierScheme":"SPDX","rightsUri":"https://creativecommons.org/licenses/by/4.0/legalcode","schemeUri":"https://spdx.org/licenses/","rights":"Creative Commons Attribution 4.0 International","rightsIdentifier":"cc-by-4.0"}],"descriptions":[{"descriptionType":"Abstract","description":"The proliferation of recursive training on synthetic data can alleviate data scarcity but risks model collapse, where repeated training erodes distributional tails and homogenizes outputs. Data selection is widely viewed as a remedy, yet its reliability depends critically on the reference distribution used by the verifier. We show that in low-resource verification regimes, where each verifier observes only a small, fragmented, and biased slice of the target manifold, selection itself becomes biased. This situation naturally arises in low-resource data silos such as healthcare consortia or proprietary financial institutions, where raw data cannot be pooled and local references are inherently incomplete. As a result, selection preferentially retains samples aligned with the local manifold while pruning globally relevant tail modes, turning from a safeguard against collapse into a mechanism that precipitates it. We theoretically prove that such siloed selection accelerates collapse and induces power-law diversity decay. As an initial mitigation, we construct Wasserstein proxy references from multiple silos without sharing raw data. Empirical results confirm that local-reference selection fails on skewed distributions, whereas collaborative proxy references mitigate diversity degradation, suggesting that recursive synthetic-data pipelines require particular caution when real-data coverage is fragmented or scarce."},{"descriptionType":"Other","description":"Accepted at the 43rd International Conference on Machine Learning (ICML 2026)"}],"geoLocations":[],"fundingReferences":[],"url":"https://arxiv.org/abs/2606.13732","contentUrl":null,"metadataVersion":1,"schemaVersion":"http://datacite.org/schema/kernel-4","source":"mds","isActive":true,"state":"findable","reason":null,"viewCount":0,"downloadCount":0,"referenceCount":0,"citationCount":0,"partCount":0,"partOfCount":0,"versionCount":0,"versionOfCount":0,"created":"2026-06-15T01:39:40Z","registered":"2026-06-15T01:39:41Z","published":null,"updated":"2026-07-03T02:18:42Z"},"relationships":{"client":{"data":{"id":"arxiv.content","type":"clients"}}}},{"id":"10.48550/arxiv.2606.13723","type":"dois","attributes":{"doi":"10.48550/arxiv.2606.13723","identifiers":[{"identifier":"2606.13723","identifierType":"arXiv"}],"creators":[{"nameType":"Personal","givenName":"Pengfei","familyName":"Liu","name":"Liu, Pengfei","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Yuhan","familyName":"Guo","name":"Guo, Yuhan","affiliation":[],"nameIdentifiers":[]}],"titles":[{"title":"Morphology-Aware Sample Assignment: Overcoming IoU Insensitivity for Surface Defect Detection"}],"publisher":"arXiv","container":{},"publicationYear":2026,"subjects":[{"subject":"Computer Vision and Pattern Recognition (cs.CV)","lang":"en","subjectScheme":"arXiv"},{"subject":"Artificial Intelligence (cs.AI)","lang":"en","subjectScheme":"arXiv"},{"subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"}],"contributors":[],"dates":[{"date":"2026-06-11T08:32:57Z","dateType":"Submitted","dateInformation":"v1"},{"date":"2026-06-15T00:01:55Z","dateType":"Updated","dateInformation":"v1"},{"date":"2026-07-02T03:35:18Z","dateType":"Submitted","dateInformation":"v2"},{"date":"2026-07-03T00:23:11Z","dateType":"Updated","dateInformation":"v2"},{"date":"2026-06","dateType":"Available","dateInformation":"v1"}],"language":null,"types":{"schemaOrg":"CreativeWork","resourceTypeGeneral":"Preprint","citeproc":"article","bibtex":"misc","ris":"GEN","resourceType":"Article"},"relatedIdentifiers":[],"relatedItems":[],"sizes":[],"formats":[],"version":"2","rightsList":[{"rightsIdentifierScheme":"SPDX","rightsUri":"https://creativecommons.org/publicdomain/zero/1.0/legalcode","schemeUri":"https://spdx.org/licenses/","rights":"Creative Commons Zero v1.0 Universal","rightsIdentifier":"cc0-1.0"}],"descriptions":[{"descriptionType":"Abstract","description":"Intersection-over-Union (IoU), as a pivotal metric for evaluating the spatial alignment between candidate proposals and ground-truth annotations, directly determines the quality of positive sample sets and the training efficacy of visual detection models. Through theoretical modeling and analysis, we uncover a non-sensitive region on the IoU response curve, within which samples yield nearly identical IoU scores despite distinct geometric overlaps. To overcome this limitation, we introduce a set of morphological similarity metrics covering area, shape, and aspect ratio, to refine the positive sample assignment process, thereby ensuring more discriminative and reliable matching. A supplementary matching score is derived via mean-based aggregation of these multidimensional similarities, compensating for the intrinsic limitation of IoU in representing structural correspondence. Theoretically, incorporating morphological similarity reshapes the response distribution of the matching function, yielding both effective directional gradients and polygon-like iso-response contours, which tightly confine high-response regions around each ground-truth instance and substantially enhance the precision of positive sample selection. Experiments based on the YOLOv9 framework demonstrate consistent performance gains on both NEUDET and GC10- DET datasets. Notably, the proposed approach is fully plug-and-play and incurs zero additional inference overhead, thereby ensuring deployment efficiency for industrial visual inspection."}],"geoLocations":[],"fundingReferences":[],"url":"https://arxiv.org/abs/2606.13723","contentUrl":null,"metadataVersion":1,"schemaVersion":"http://datacite.org/schema/kernel-4","source":"mds","isActive":true,"state":"findable","reason":null,"viewCount":0,"downloadCount":0,"referenceCount":0,"citationCount":0,"partCount":0,"partOfCount":0,"versionCount":0,"versionOfCount":0,"created":"2026-06-15T01:39:29Z","registered":"2026-06-15T01:39:30Z","published":null,"updated":"2026-07-03T02:18:41Z"},"relationships":{"client":{"data":{"id":"arxiv.content","type":"clients"}}}},{"id":"10.48550/arxiv.2606.14642","type":"dois","attributes":{"doi":"10.48550/arxiv.2606.14642","identifiers":[{"identifier":"2606.14642","identifierType":"arXiv"}],"creators":[{"nameType":"Personal","givenName":"Anas","familyName":"Saleh","name":"Saleh, Anas","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Michael","familyName":"Hite","name":"Hite, Michael","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Diego","familyName":"Floor","name":"Floor, Diego","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Yannick","familyName":"Meurice","name":"Meurice, Yannick","affiliation":[],"nameIdentifiers":[]}],"titles":[{"title":"Zeros of the partition function for 12 flavor QCD"}],"publisher":"arXiv","container":{},"publicationYear":2026,"subjects":[{"subject":"High Energy Physics - Lattice (hep-lat)","lang":"en","subjectScheme":"arXiv"},{"subject":"FOS: Physical sciences","subjectScheme":"Fields of Science and Technology (FOS)"}],"contributors":[],"dates":[{"date":"2026-06-12T17:05:55Z","dateType":"Submitted","dateInformation":"v1"},{"date":"2026-06-15T01:00:33Z","dateType":"Updated","dateInformation":"v1"},{"date":"2026-06-22T16:08:27Z","dateType":"Submitted","dateInformation":"v2"},{"date":"2026-06-23T02:51:13Z","dateType":"Updated","dateInformation":"v2"},{"date":"2026-07-01T16:16:48Z","dateType":"Submitted","dateInformation":"v3"},{"date":"2026-07-02T01:01:36Z","dateType":"Updated","dateInformation":"v3"},{"date":"2026-06","dateType":"Available","dateInformation":"v1"}],"language":null,"types":{"schemaOrg":"CreativeWork","resourceTypeGeneral":"Preprint","citeproc":"article","bibtex":"misc","ris":"GEN","resourceType":"Article"},"relatedIdentifiers":[],"relatedItems":[],"sizes":[],"formats":[],"version":"3","rightsList":[{"rightsIdentifierScheme":"SPDX","rightsUri":"https://creativecommons.org/licenses/by/4.0/legalcode","schemeUri":"https://spdx.org/licenses/","rights":"Creative Commons Attribution 4.0 International","rightsIdentifier":"cc-by-4.0"}],"descriptions":[{"descriptionType":"Abstract","description":"We consider a four dimensional $SU(3)$ lattice gauge theory with 12 staggered fermions having identical masses and an unimproved action. Using sets of plaquette distributions for various inverse bare couplings $β$, we reconstruct the density of states with the Ferrenberg -Swendsen method and calculate the zeros of the partition in the complex $β$ plane with bare quark masses $m_q$ = 0.02, 0.06, 0.08 and 0.1 for hypercubes of linear size $L$= 4, 6, 8, 10, and 12. Our hypothesis is that there is a line of first order transitions in the $(m_q,β)$ plane ending at a second order phase transition. We expect this transition to be in the 4D Ising, mean field, universality class. We fit the $L$ dependence of the zeros with the lowest imaginary part using two ($y = bL^{-d}$) and three ($y = a + bL^{-d}$) parameter fits. For $m_q$ = 0.02 the results provide strong support for a first order phase transition ($d=3.98(6)$, and $a$ statistically compatible with 0). The results also indicate, with less statistical significance for $m_q=0.06$, that the three other masses are above the critical value $m_q^c$. In addition, we suggest that the infinite volume gap for the lowest zero $a$, can be represented as $a\\simeq A(m_q-m_q^c)^{B}$ with $m_q^c\\sim 0.05$ and $B\\sim 1$. Given that there are only three data points with significant error bars, it is difficult to rule out the mean field value $B=3/2$. Combining this result with spectroscopic results by Jin and Mawhinney, indicates that the gap with real axis (Lee-Yang edge) scales roughly like $m_σ^2$, where $m_σ$ is the mass of the $0^{++}$ scalar which is also the lowest excitation."}],"geoLocations":[],"fundingReferences":[],"url":"https://arxiv.org/abs/2606.14642","contentUrl":null,"metadataVersion":2,"schemaVersion":"http://datacite.org/schema/kernel-4","source":"mds","isActive":true,"state":"findable","reason":null,"viewCount":0,"downloadCount":0,"referenceCount":0,"citationCount":0,"partCount":0,"partOfCount":0,"versionCount":0,"versionOfCount":0,"created":"2026-06-15T01:58:59Z","registered":"2026-06-15T01:58:59Z","published":null,"updated":"2026-07-02T02:16:35Z"},"relationships":{"client":{"data":{"id":"arxiv.content","type":"clients"}}}},{"id":"10.48550/arxiv.2606.14641","type":"dois","attributes":{"doi":"10.48550/arxiv.2606.14641","identifiers":[{"identifier":"2606.14641","identifierType":"arXiv"}],"creators":[{"nameType":"Personal","givenName":"C. A.","familyName":"da Silva","name":"da Silva, C. A.","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"L. A.","familyName":"Ferreira","name":"Ferreira, L. A.","affiliation":[],"nameIdentifiers":[]}],"titles":[{"title":"On the gauge-invariant dynamical charges and densities of the 1-instanton solution"}],"publisher":"arXiv","container":{},"publicationYear":2026,"subjects":[{"subject":"High Energy Physics - Theory (hep-th)","lang":"en","subjectScheme":"arXiv"},{"subject":"Mathematical Physics (math-ph)","lang":"en","subjectScheme":"arXiv"},{"subject":"Exactly Solvable and Integrable Systems (nlin.SI)","lang":"en","subjectScheme":"arXiv"},{"subject":"FOS: Physical sciences","subjectScheme":"Fields of Science and Technology (FOS)"}],"contributors":[],"dates":[{"date":"2026-06-12T17:05:39Z","dateType":"Submitted","dateInformation":"v1"},{"date":"2026-06-15T01:00:32Z","dateType":"Updated","dateInformation":"v1"},{"date":"2026-06-25T15:25:25Z","dateType":"Submitted","dateInformation":"v2"},{"date":"2026-07-01T13:33:04Z","dateType":"Updated","dateInformation":"v2"},{"date":"2026-06","dateType":"Available","dateInformation":"v1"}],"language":null,"types":{"schemaOrg":"CreativeWork","resourceTypeGeneral":"Preprint","citeproc":"article","bibtex":"misc","ris":"GEN","resourceType":"Article"},"relatedIdentifiers":[{"relationType":"IsVersionOf","relatedIdentifier":"10.46298/ocnmp.18516","relatedIdentifierType":"DOI"}],"relatedItems":[],"sizes":[],"formats":[],"version":"2","rightsList":[{"rightsUri":"http://arxiv.org/licenses/nonexclusive-distrib/1.0/","rights":"arXiv.org perpetual, non-exclusive license"}],"descriptions":[{"descriptionType":"Abstract","description":"We study the gauge-invariant dynamically conserved charges, and their corresponding densities, for instanton solutions of Yang-Mills theories in four dimensional Euclidean space, for the gauge group $SU(2)$. Those charges were constructed in [1,2] through the integral equations of Yang-Mills theory, using techniques on generalized loop spaces. We use the integral non-Abelian Gauss law to evaluate the gauge-invariant flux of the magnetic and electric non-Abelian fields through spherical surfaces centered at the origin of the instanton solution. From such a flux, we define gauge-invariant charge densities by considering the charge within an infinitesimal spherical shell of radius $r\\equiv\\sqrt{x_i \\, x^i}/λ$, with $λ$ being the parameter of the instanton solution, defining its size, and $x_i \\, x^i = (x^1)^2 + (x^{2})^2 + (x^{3})^2$. We discuss the issue of the reparameterization invariance of the charges and densities, and show that the magnetic and electric fluxes for the instanton and anti-instanton, at $r=1$ and $x^4 = 0$, $x^4$ being the Euclidean time, are non-zero and observable. Our results give an interesting picture of the internal structure of the instanton, and may be important for the properties of the Yang-Mills $θ$-vacuum."},{"descriptionType":"Other","description":"43 pages, 6 figures, Version published in Open Communications in Nonlinear Mathematical Physics, Special Issue Hietarinta 2026, ocnmp:18516, pp 141-183"}],"geoLocations":[],"fundingReferences":[],"url":"https://arxiv.org/abs/2606.14641","contentUrl":null,"metadataVersion":2,"schemaVersion":"http://datacite.org/schema/kernel-4","source":"mds","isActive":true,"state":"findable","reason":null,"viewCount":0,"downloadCount":0,"referenceCount":0,"citationCount":0,"partCount":0,"partOfCount":0,"versionCount":0,"versionOfCount":1,"created":"2026-06-15T01:58:57Z","registered":"2026-06-15T01:58:58Z","published":null,"updated":"2026-07-02T02:16:34Z"},"relationships":{"client":{"data":{"id":"arxiv.content","type":"clients"}}}},{"id":"10.48550/arxiv.2606.14611","type":"dois","attributes":{"doi":"10.48550/arxiv.2606.14611","identifiers":[{"identifier":"2606.14611","identifierType":"arXiv"}],"creators":[{"nameType":"Personal","givenName":"Diksha","familyName":"Gupta","name":"Gupta, Diksha","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Madhav","familyName":"Marathe","name":"Marathe, Madhav","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Anil","familyName":"Vullikanti","name":"Vullikanti, Anil","affiliation":[],"nameIdentifiers":[]}],"titles":[{"title":"Robust Network Flow Interdiction Problems with Applications to Counter-Narcotics"}],"publisher":"arXiv","container":{},"publicationYear":2026,"subjects":[{"subject":"Computational Engineering, Finance, and Science (cs.CE)","lang":"en","subjectScheme":"arXiv"},{"subject":"Social and Information Networks (cs.SI)","lang":"en","subjectScheme":"arXiv"},{"subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"}],"contributors":[],"dates":[{"date":"2026-06-12T16:34:24Z","dateType":"Submitted","dateInformation":"v1"},{"date":"2026-06-15T00:58:32Z","dateType":"Updated","dateInformation":"v1"},{"date":"2026-06-30T21:19:09Z","dateType":"Submitted","dateInformation":"v2"},{"date":"2026-07-02T00:07:15Z","dateType":"Updated","dateInformation":"v2"},{"date":"2026-06","dateType":"Available","dateInformation":"v1"}],"language":null,"types":{"schemaOrg":"CreativeWork","resourceTypeGeneral":"Preprint","citeproc":"article","bibtex":"misc","ris":"GEN","resourceType":"Article"},"relatedIdentifiers":[],"relatedItems":[],"sizes":[],"formats":[],"version":"2","rightsList":[{"rightsIdentifierScheme":"SPDX","rightsUri":"https://creativecommons.org/licenses/by/4.0/legalcode","schemeUri":"https://spdx.org/licenses/","rights":"Creative Commons Attribution 4.0 International","rightsIdentifier":"cc-by-4.0"}],"descriptions":[{"descriptionType":"Abstract","description":"Interdiction problems arise in a number of application areas, including global security, supply chains, and critical infrastructure protection - the goal is inhibit the movement of goods, people or information. An area of particular interest is counter-narcotics, where nodes or edges in a network are placed under surveillance or blocked to minimize the flow of illicit drugs from source to the destination. A fundamental challenge in this narco-traffic interdiction is data scarcity: available datasets are limited by the very nature of the problem and provide only partial and uncertain views of trafficking networks. Thus, developing robust interdiction methods that take this inherent lack of information is critical. In this paper we initiate the study of network flow interdiction problems under network uncertainty. First, using a limited real-world dataset, we generate an ensemble of plausible network realizations representing alternative trafficking scenarios. The method combines simulations with mathematical programming techniques to generate network ensembles that are consistent with the observed data. Second, we formulate the robust network flow interdiction problem and develop an integer linear program to solve the problem. We evaluate the optimal interdiction strategy and obtain the residual flows over the scenarios. Our analysis reveals that even modest budgets can yield significant flow reductions. However, optimal solutions vary substantially across scenarios, motivating the need for robust solutions. We show that the robust strategy achieves near-optimal performance across all near-real world realizations while remaining stable under structural uncertainty. This simulation-driven approach provides a principled basis for policy analysis and supports maximizing the return on interdiction investments in uncertain, data-limited environments."},{"descriptionType":"Other","description":"18 pages, 15 Figures, To appear at Winter Simulation Conference 2026"}],"geoLocations":[],"fundingReferences":[],"url":"https://arxiv.org/abs/2606.14611","contentUrl":null,"metadataVersion":1,"schemaVersion":"http://datacite.org/schema/kernel-4","source":"mds","isActive":true,"state":"findable","reason":null,"viewCount":0,"downloadCount":0,"referenceCount":0,"citationCount":0,"partCount":0,"partOfCount":0,"versionCount":0,"versionOfCount":0,"created":"2026-06-15T01:58:20Z","registered":"2026-06-15T01:58:20Z","published":null,"updated":"2026-07-02T02:16:34Z"},"relationships":{"client":{"data":{"id":"arxiv.content","type":"clients"}}}},{"id":"10.48550/arxiv.2606.14513","type":"dois","attributes":{"doi":"10.48550/arxiv.2606.14513","identifiers":[{"identifier":"2606.14513","identifierType":"arXiv"}],"creators":[{"nameType":"Personal","givenName":"Giovanni","familyName":"Catino","name":"Catino, Giovanni","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Dario Daniele","familyName":"Monticelli","name":"Monticelli, Dario Daniele","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Alberto","familyName":"Roncoroni","name":"Roncoroni, Alberto","affiliation":[],"nameIdentifiers":[]}],"titles":[{"title":"Quasilinear Liouville equation on manifolds with nonnegative Ricci curvature"}],"publisher":"arXiv","container":{},"publicationYear":2026,"subjects":[{"subject":"Analysis of PDEs (math.AP)","lang":"en","subjectScheme":"arXiv"},{"subject":"Differential Geometry (math.DG)","lang":"en","subjectScheme":"arXiv"},{"subject":"FOS: Mathematics","subjectScheme":"Fields of Science and Technology (FOS)"}],"contributors":[],"dates":[{"date":"2026-06-12T14:44:44Z","dateType":"Submitted","dateInformation":"v1"},{"date":"2026-06-15T00:52:50Z","dateType":"Updated","dateInformation":"v1"},{"date":"2026-07-01T07:41:33Z","dateType":"Submitted","dateInformation":"v2"},{"date":"2026-07-02T00:32:01Z","dateType":"Updated","dateInformation":"v2"},{"date":"2026-06","dateType":"Available","dateInformation":"v1"}],"language":null,"types":{"schemaOrg":"CreativeWork","resourceTypeGeneral":"Preprint","citeproc":"article","bibtex":"misc","ris":"GEN","resourceType":"Article"},"relatedIdentifiers":[],"relatedItems":[],"sizes":[],"formats":[],"version":"2","rightsList":[{"rightsUri":"http://arxiv.org/licenses/nonexclusive-distrib/1.0/","rights":"arXiv.org perpetual, non-exclusive license"}],"descriptions":[{"descriptionType":"Abstract","description":"We prove rigidity and classification results for the quasilinear Liouville equation associated with the $n$-Laplacian on complete noncompact Riemannian manifolds with nonnegative Ricci curvature. Our first result shows that, under a sharp logarithmic lower bound, the ambient manifold must be isometric to the Euclidean space and the solution must be one of the standard bubbles. We also prove a finite-mass rigidity theorem under the corresponding sharp asymptotic lower bound. We show that any logarithmic lower bound forces positive asymptotic volume ratio and one-endedness of the manifold. Finally, we construct solutions on nonflat manifolds with nonnegative Ricci curvature showing the sharpness of our hypotheses."}],"geoLocations":[],"fundingReferences":[],"url":"https://arxiv.org/abs/2606.14513","contentUrl":null,"metadataVersion":1,"schemaVersion":"http://datacite.org/schema/kernel-4","source":"mds","isActive":true,"state":"findable","reason":null,"viewCount":0,"downloadCount":0,"referenceCount":0,"citationCount":0,"partCount":0,"partOfCount":0,"versionCount":0,"versionOfCount":0,"created":"2026-06-15T01:56:17Z","registered":"2026-06-15T01:56:18Z","published":null,"updated":"2026-07-02T02:16:33Z"},"relationships":{"client":{"data":{"id":"arxiv.content","type":"clients"}}}},{"id":"10.48550/arxiv.2606.13773","type":"dois","attributes":{"doi":"10.48550/arxiv.2606.13773","identifiers":[{"identifier":"2606.13773","identifierType":"arXiv"}],"creators":[{"nameType":"Personal","givenName":"Ana","familyName":"Bokulić","name":"Bokulić, Ana","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Tajron","familyName":"Jurić","name":"Jurić, Tajron","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Luka Kanai","familyName":"Pejić","name":"Pejić, Luka Kanai","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Filip","familyName":"Požar","name":"Požar, Filip","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Ivica","familyName":"Smolić","name":"Smolić, Ivica","affiliation":[],"nameIdentifiers":[]}],"titles":[{"title":"Constraints on regular black holes with nonminimally coupled electromagnetic fields"}],"publisher":"arXiv","container":{},"publicationYear":2026,"subjects":[{"subject":"General Relativity and Quantum Cosmology (gr-qc)","lang":"en","subjectScheme":"arXiv"},{"subject":"High Energy Physics - Theory (hep-th)","lang":"en","subjectScheme":"arXiv"},{"subject":"Mathematical Physics (math-ph)","lang":"en","subjectScheme":"arXiv"},{"subject":"FOS: Physical sciences","subjectScheme":"Fields of Science and Technology (FOS)"}],"contributors":[],"dates":[{"date":"2026-06-11T18:00:00Z","dateType":"Submitted","dateInformation":"v1"},{"date":"2026-06-15T00:04:26Z","dateType":"Updated","dateInformation":"v1"},{"date":"2026-07-01T13:37:18Z","dateType":"Submitted","dateInformation":"v2"},{"date":"2026-07-02T00:51:47Z","dateType":"Updated","dateInformation":"v2"},{"date":"2026-06","dateType":"Available","dateInformation":"v1"}],"language":null,"types":{"schemaOrg":"CreativeWork","resourceTypeGeneral":"Preprint","citeproc":"article","bibtex":"misc","ris":"GEN","resourceType":"Article"},"relatedIdentifiers":[],"relatedItems":[],"sizes":[],"formats":[],"version":"2","rightsList":[{"rightsUri":"http://arxiv.org/licenses/nonexclusive-distrib/1.0/","rights":"arXiv.org perpetual, non-exclusive license"}],"descriptions":[{"descriptionType":"Abstract","description":"Construction of physically realistic theories admitting regular black hole solutions remains an important open problem in gravitational physics. While theories with electromagnetic fields minimally coupled to gravity have been extensively studied over the past two decades, theories with nonminimal couplings remain comparatively unexplored. We investigate theories containing the interaction terms $R F_{ab}F^{ab}$, $R_{ab} F^a_{\\ \\, c} \\, F^{bc}$ and $R_{abcd} F^{ab} F^{cd}$, which generically arise in low-energy effective Lagrangians. We prove that magnetically charged regular black holes are excluded, except possibly for finely tuned choices of coupling constants, and argue that a similar conclusion applies to electrically charged regular black holes. We further show that similar conclusions hold for Lagrangian terms of the form $f(R,F_{ab}{\\star F}^{ab})$."},{"descriptionType":"Other","description":"19 pages (ver. 2: minor edit, several references added)"}],"geoLocations":[],"fundingReferences":[],"url":"https://arxiv.org/abs/2606.13773","contentUrl":null,"metadataVersion":1,"schemaVersion":"http://datacite.org/schema/kernel-4","source":"mds","isActive":true,"state":"findable","reason":null,"viewCount":0,"downloadCount":0,"referenceCount":0,"citationCount":0,"partCount":0,"partOfCount":0,"versionCount":0,"versionOfCount":0,"created":"2026-06-15T01:40:33Z","registered":"2026-06-15T01:40:34Z","published":null,"updated":"2026-07-02T02:16:31Z"},"relationships":{"client":{"data":{"id":"arxiv.content","type":"clients"}}}},{"id":"10.48550/arxiv.2606.13695","type":"dois","attributes":{"doi":"10.48550/arxiv.2606.13695","identifiers":[{"identifier":"2606.13695","identifierType":"arXiv"}],"creators":[{"nameType":"Personal","givenName":"Boris","familyName":"Kriuk","name":"Kriuk, Boris","affiliation":[],"nameIdentifiers":[]}],"titles":[{"title":"Korzhinskii-Net: Physics-Informed Neural Network for Sub-Surface Mineral Prospectivity Modelling"}],"publisher":"arXiv","container":{},"publicationYear":2026,"subjects":[{"subject":"Geophysics (physics.geo-ph)","lang":"en","subjectScheme":"arXiv"},{"subject":"Artificial Intelligence (cs.AI)","lang":"en","subjectScheme":"arXiv"},{"subject":"Machine Learning (cs.LG)","lang":"en","subjectScheme":"arXiv"},{"subject":"FOS: Physical sciences","subjectScheme":"Fields of Science and Technology (FOS)"},{"subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"}],"contributors":[],"dates":[{"date":"2026-05-31T06:50:20Z","dateType":"Submitted","dateInformation":"v1"},{"date":"2026-06-15T00:00:25Z","dateType":"Updated","dateInformation":"v1"},{"date":"2026-07-01T08:57:25Z","dateType":"Submitted","dateInformation":"v2"},{"date":"2026-07-02T00:37:09Z","dateType":"Updated","dateInformation":"v2"},{"date":"2026-06","dateType":"Available","dateInformation":"v1"}],"language":null,"types":{"schemaOrg":"CreativeWork","resourceTypeGeneral":"Preprint","citeproc":"article","bibtex":"misc","ris":"GEN","resourceType":"Article"},"relatedIdentifiers":[],"relatedItems":[],"sizes":[],"formats":[],"version":"2","rightsList":[{"rightsUri":"http://arxiv.org/licenses/nonexclusive-distrib/1.0/","rights":"arXiv.org perpetual, non-exclusive license"}],"descriptions":[{"descriptionType":"Abstract","description":"Mineral prospectivity modelling (MPM) underpins exploration economics, yet most operational pipelines reduce to data-driven classifiers trained on shallow surface proxies. Such models are blind to the subsurface physics that actually localises ore: heat advection, fluid flow, and lithology-dependent precipitation. We present Korzhinskii-Net, a 2-D radial physics-informed neural network (PINN) that couples Darcy flow, advective-diffusive heat transport, and a softplus-saturated reaction rate into a single differentiable forward model, weakly supervised by surface and remote-sensing proxies. The network is named after Dmitri S. Korzhinskii (1899-1985), whose theory of infiltration metasomatism provides the physical scaffold. We evaluate Korzhinskii-Net on six ore provinces spanning three commodity classes - Udokan (sandstone-hosted Cu), Sukhoi Log, Olimpiada, and Berezovskoye (orogenic Au), Vorontsovskoye (Carlin-type Au), and Dalnegorsk (skarn polymetallic) - under a fair, leakage-controlled 5-fold cross-validation protocol with hard ring-shaped negatives and baseline proxy features disabled. Korzhinskii-Net attains a mean PR-AUC of 0.708 versus 0.235 for the strongest classical baseline (support vector machine), and a mean fractional rank of 0.036 versus 0.475. The improvement is consistent across all six provinces and three commodity systems, suggesting that physics-informed differentiable simulators, even when constrained only by global open-data proxies, can recover localisation patterns that pure feature-based learners systematically miss. We release the full pipeline and evaluation harness as open source."},{"descriptionType":"Other","description":"14 pages, 10 figures, 3 tables"}],"geoLocations":[],"fundingReferences":[],"url":"https://arxiv.org/abs/2606.13695","contentUrl":null,"metadataVersion":1,"schemaVersion":"http://datacite.org/schema/kernel-4","source":"mds","isActive":true,"state":"findable","reason":null,"viewCount":0,"downloadCount":0,"referenceCount":0,"citationCount":0,"partCount":0,"partOfCount":0,"versionCount":0,"versionOfCount":0,"created":"2026-06-15T01:38:55Z","registered":"2026-06-15T01:38:55Z","published":null,"updated":"2026-07-02T02:16:30Z"},"relationships":{"client":{"data":{"id":"arxiv.content","type":"clients"}}}},{"id":"10.48550/arxiv.2606.13715","type":"dois","attributes":{"doi":"10.48550/arxiv.2606.13715","identifiers":[{"identifier":"2606.13715","identifierType":"arXiv"}],"creators":[{"nameType":"Personal","givenName":"Olly","familyName":"Styles","name":"Styles, Olly","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Sam","familyName":"Miller","name":"Miller, Sam","affiliation":[],"nameIdentifiers":[]}],"titles":[{"title":"WorkBench Revisited: Workplace Agents Two Years On"}],"publisher":"arXiv","container":{},"publicationYear":2026,"subjects":[{"subject":"Artificial Intelligence (cs.AI)","lang":"en","subjectScheme":"arXiv"},{"subject":"Computation and Language (cs.CL)","lang":"en","subjectScheme":"arXiv"},{"subject":"Multiagent Systems (cs.MA)","lang":"en","subjectScheme":"arXiv"},{"subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"}],"contributors":[],"dates":[{"date":"2026-06-10T21:21:35Z","dateType":"Submitted","dateInformation":"v1"},{"date":"2026-06-15T00:00:58Z","dateType":"Updated","dateInformation":"v1"},{"date":"2026-07-01T14:36:06Z","dateType":"Submitted","dateInformation":"v2"},{"date":"2026-07-02T00:55:03Z","dateType":"Updated","dateInformation":"v2"},{"date":"2026-06","dateType":"Available","dateInformation":"v1"}],"language":null,"types":{"schemaOrg":"CreativeWork","resourceTypeGeneral":"Preprint","citeproc":"article","bibtex":"misc","ris":"GEN","resourceType":"Article"},"relatedIdentifiers":[],"relatedItems":[],"sizes":[],"formats":[],"version":"2","rightsList":[{"rightsIdentifierScheme":"SPDX","rightsUri":"https://creativecommons.org/licenses/by/4.0/legalcode","schemeUri":"https://spdx.org/licenses/","rights":"Creative Commons Attribution 4.0 International","rightsIdentifier":"cc-by-4.0"}],"descriptions":[{"descriptionType":"Abstract","description":"The best agent on WorkBench in March 2024, GPT-4, completed just 43% of tasks. We revisit the benchmark in June 2026 and find that the best agent to date, Claude Fable 5, now completes 98%. Beyond this considerable progress in frontier agent performance, three things stand out. First, unintended harmful actions, such as emailing the wrong person, fell from 26% of tasks for GPT-4 to 1.9% for Claude Fable 5; capability and safety go together on WorkBench rather than trade off, so the models that finish the most tasks also do the least unintended damage. Second, the rise of open-weight models has drastically lowered costs for a performance level that was only accessible to proprietary models, while frontier costs have stayed stable. Third, while several classes of error have been eliminated, frontier models still make some basic mistakes that occasionally result in irreversible harm. We release an updated version of the benchmark with data and code quality improvements, new model scores, and analysis of agent progress on WorkBench since 2024."},{"descriptionType":"Other","description":"8 pages, 3 figures. Follow-up to arXiv:2405.00823"}],"geoLocations":[],"fundingReferences":[],"url":"https://arxiv.org/abs/2606.13715","contentUrl":null,"metadataVersion":1,"schemaVersion":"http://datacite.org/schema/kernel-4","source":"mds","isActive":true,"state":"findable","reason":null,"viewCount":0,"downloadCount":0,"referenceCount":0,"citationCount":0,"partCount":0,"partOfCount":0,"versionCount":0,"versionOfCount":0,"created":"2026-06-15T01:39:20Z","registered":"2026-06-15T01:39:20Z","published":null,"updated":"2026-07-02T02:16:30Z"},"relationships":{"client":{"data":{"id":"arxiv.content","type":"clients"}}}},{"id":"10.48550/arxiv.2606.14066","type":"dois","attributes":{"doi":"10.48550/arxiv.2606.14066","identifiers":[{"identifier":"2606.14066","identifierType":"arXiv"}],"creators":[{"nameType":"Personal","givenName":"Shaoqiu","familyName":"Zhang","name":"Zhang, Shaoqiu","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Maoquan","familyName":"Wang","name":"Wang, Maoquan","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Yuling","familyName":"Shi","name":"Shi, Yuling","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Yuhang","familyName":"Wang","name":"Wang, Yuhang","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Xiaodong","familyName":"Gu","name":"Gu, Xiaodong","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Yongqiang","familyName":"Yao","name":"Yao, Yongqiang","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Tori","familyName":"Gong","name":"Gong, Tori","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Sheng","familyName":"Chen","name":"Chen, Sheng","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Rao","familyName":"Fu","name":"Fu, Rao","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Anisha","familyName":"Agarwal","name":"Agarwal, Anisha","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Spandan","familyName":"Grag","name":"Grag, Spandan","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Gabriel","familyName":"Ryan","name":"Ryan, Gabriel","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Colin","familyName":"Merkel","name":"Merkel, Colin","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Yufan","familyName":"Huang","name":"Huang, Yufan","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Shengyu","familyName":"Fu","name":"Fu, Shengyu","affiliation":[],"nameIdentifiers":[]}],"titles":[{"title":"FastContext: Training Efficient Repository Explorer for Coding Agents"}],"publisher":"arXiv","container":{},"publicationYear":2026,"subjects":[{"subject":"Software Engineering (cs.SE)","lang":"en","subjectScheme":"arXiv"},{"subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"}],"contributors":[],"dates":[{"date":"2026-06-12T03:23:59Z","dateType":"Submitted","dateInformation":"v1"},{"date":"2026-06-15T00:23:18Z","dateType":"Updated","dateInformation":"v1"},{"date":"2026-06-17T05:05:05Z","dateType":"Submitted","dateInformation":"v2"},{"date":"2026-06-18T00:26:45Z","dateType":"Updated","dateInformation":"v2"},{"date":"2026-06-18T06:02:58Z","dateType":"Submitted","dateInformation":"v3"},{"date":"2026-06-19T00:26:49Z","dateType":"Updated","dateInformation":"v3"},{"date":"2026-06-30T01:15:16Z","dateType":"Withdrawn","dateInformation":"v4; The current article involves some product IP issues and needs to be withdrawn and re-approved"},{"date":"2026-07-01T00:17:06Z","dateType":"Updated","dateInformation":"v4"},{"date":"2026-06","dateType":"Available","dateInformation":"v1"}],"language":null,"types":{"schemaOrg":"CreativeWork","resourceTypeGeneral":"Preprint","citeproc":"article","bibtex":"misc","ris":"GEN","resourceType":"Article"},"relatedIdentifiers":[],"relatedItems":[],"sizes":[],"formats":[],"version":"4","rightsList":[{"rightsIdentifierScheme":"SPDX","rightsUri":"https://creativecommons.org/licenses/by-nc-nd/4.0/legalcode","schemeUri":"https://spdx.org/licenses/","rights":"Creative Commons Attribution Non Commercial No Derivatives 4.0 International","rightsIdentifier":"cc-by-nc-nd-4.0"}],"descriptions":[{"descriptionType":"Abstract","description":"Large Language Model (LLM) coding agents have achieved strong results on software engineering tasks, yet repository exploration remains a major bottleneck: locating relevant code consumes substantial token budget and pollutes the agent's context with irrelevant snippets. In most agents, the same model explores the repository and solves the task, leaving exploratory reads and searches in the solver's history. We present FastContext, a dedicated exploration subagent that separates repository exploration from solving. Invoked on demand, FastContext issues parallel tool calls and returns concise file paths and line ranges as focused context. FastContext is powered by specialized exploration models spanning 4B--30B parameters. We bootstrap them from strong reference-model trajectories and refine them with task-grounded rewards for broad first-turn search, multi-turn evidence gathering, and precise citation generation. Across SWE-bench Multilingual, SWE-bench Pro, and SWE-QA, integrating FastContext into Mini-SWE-Agent improves end-to-end resolution rates up to 5.5% while reducing coding-agent token consumption up to 60%, with marginal overhead. These results show that repository exploration can be separated from solving and handled effectively by specialized models. Code and data: https://github.com/microsoft/fastcontext"},{"descriptionType":"Other","description":"The current article involves some product IP issues and needs to be withdrawn and re-approved"}],"geoLocations":[],"fundingReferences":[],"url":"https://arxiv.org/abs/2606.14066","contentUrl":null,"metadataVersion":3,"schemaVersion":"http://datacite.org/schema/kernel-4","source":"mds","isActive":true,"state":"findable","reason":null,"viewCount":0,"downloadCount":0,"referenceCount":0,"citationCount":0,"partCount":0,"partOfCount":0,"versionCount":0,"versionOfCount":0,"created":"2026-06-15T01:46:48Z","registered":"2026-06-15T01:46:49Z","published":null,"updated":"2026-07-01T02:32:55Z"},"relationships":{"client":{"data":{"id":"arxiv.content","type":"clients"}}}},{"id":"10.48550/arxiv.2606.14027","type":"dois","attributes":{"doi":"10.48550/arxiv.2606.14027","identifiers":[{"identifier":"2606.14027","identifierType":"arXiv"}],"creators":[{"nameType":"Personal","givenName":"Xilong","familyName":"Wang","name":"Wang, Xilong","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Xiaoxing","familyName":"Chen","name":"Chen, Xiaoxing","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Patrick","familyName":"Li","name":"Li, Patrick","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Dawn","familyName":"Song","name":"Song, Dawn","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Neil","familyName":"Gong","name":"Gong, Neil","affiliation":[],"nameIdentifiers":[]}],"titles":[{"title":"Same-Origin Policy for Agentic Browsers"}],"publisher":"arXiv","container":{},"publicationYear":2026,"subjects":[{"subject":"Cryptography and Security (cs.CR)","lang":"en","subjectScheme":"arXiv"},{"subject":"Artificial Intelligence (cs.AI)","lang":"en","subjectScheme":"arXiv"},{"subject":"Computation and Language (cs.CL)","lang":"en","subjectScheme":"arXiv"},{"subject":"Systems and Control (eess.SY)","lang":"en","subjectScheme":"arXiv"},{"subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"},{"subject":"FOS: Electrical engineering, electronic engineering, information engineering","subjectScheme":"Fields of Science and Technology (FOS)"}],"contributors":[],"dates":[{"date":"2026-06-12T02:01:38Z","dateType":"Submitted","dateInformation":"v1"},{"date":"2026-06-15T00:19:29Z","dateType":"Updated","dateInformation":"v1"},{"date":"2026-06-15T12:32:41Z","dateType":"Submitted","dateInformation":"v2"},{"date":"2026-06-16T01:43:27Z","dateType":"Updated","dateInformation":"v2"},{"date":"2026-06-30T01:10:08Z","dateType":"Submitted","dateInformation":"v3"},{"date":"2026-07-01T00:16:49Z","dateType":"Updated","dateInformation":"v3"},{"date":"2026-06","dateType":"Available","dateInformation"