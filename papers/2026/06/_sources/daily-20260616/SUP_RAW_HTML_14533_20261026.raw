<span id="Sx1.T1.2.13.1.1.1" class="ltx_p"><math id="Sx1.T1.m17" class="ltx_Math" alttext="\Theta_{r}" display="inline" intent=":literal"><semantics><msub><mi mathvariant="normal">Θ</mi><mi>r</mi></msub><annotation encoding="application/x-tex">\Theta_{r}</annotation></semantics></math></span>
</span></td>
<td id="Sx1.T1.2.13.2" class="ltx_td ltx_align_left ltx_align_top ltx_border_r">
<span id="Sx1.T1.2.13.2.1" class="ltx_inline-block ltx_align_top" style="width:142.3pt;">
<span id="Sx1.T1.2.13.2.1.1" class="ltx_p">Risk Shadow regime (zero mutual information, high nominal accuracy)</span>
</span></td></tr>
<tr id="Sx1.T1.2.14" class="ltx_tr">
<td id="Sx1.T1.2.14.1" class="ltx_td ltx_align_left ltx_align_top ltx_border_l ltx_border_r">
<span id="Sx1.T1.2.14.1.1" class="ltx_inline-block ltx_align_top" style="width:85.4pt;">
<span id="Sx1.T1.2.14.1.1.1" class="ltx_p"><math id="Sx1.T1.m18" class="ltx_math_unparsed" alttext="\ell_{\tau}(u)=|\tau-\mathbf{1}_{\{u&lt;0\}}|u^{2}" display="inline" intent=":literal"><semantics><mrow><msub><mi mathvariant="normal">ℓ</mi><mi>τ</mi></msub><mrow><mo stretchy="false">(</mo><mi>u</mi><mo stretchy="false">)</mo></mrow><mo rspace="0em">=</mo><mo fence="false" rspace="0.167em" stretchy="false">|</mo><mi>τ</mi><mo>−</mo><msub><mn>𝟏</mn><mrow><mo stretchy="false">{</mo><mi>u</mi><mo>&lt;</mo><mn>0</mn><mo stretchy="false">}</mo></mrow></msub><mo fence="false" rspace="0.167em" stretchy="false">|</mo><msup><mi>u</mi><mn>2</mn></msup></mrow><annotation encoding="application/x-tex">\ell_{\tau}(u)=|\tau-\mathbf{1}_{\{u&lt;0\}}|u^{2}</annotation></semantics></math></span>
</span></td>
<td id="Sx1.T1.2.14.2" class="ltx_td ltx_align_left ltx_align_top ltx_border_r">
<span id="Sx1.T1.2.14.2.1" class="ltx_inline-block ltx_align_top" style="width:142.3pt;">
<span id="Sx1.T1.2.14.2.1.1" class="ltx_p">Expectile loss function</span>
</span></td></tr>
<tr id="Sx1.T1.2.15" class="ltx_tr">
<td id="Sx1.T1.2.15.1" class="ltx_td ltx_align_left ltx_align_top ltx_border_l ltx_border_r">
