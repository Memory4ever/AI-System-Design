<td id="S4.T2.2.3.4" class="ltx_td ltx_align_right ltx_border_bb"><math id="S4.T2.m11" class="ltx_Math" alttext="66.8919" display="inline" intent=":literal"><semantics><mn>66.8919</mn><annotation encoding="application/x-tex">66.8919</annotation></semantics></math></td>
