<th id="S5.T3.2.1.3" class="ltx_td ltx_align_center ltx_th ltx_th_column ltx_border_tt"><span id="S5.T3.2.1.3.1" class="ltx_text ltx_font_bold">TP-PCA</span> (<math id="S5.T3.m5" class="ltx_Math" alttext="\alpha=99" display="inline" intent=":literal"><semantics><mrow><mi>α</mi><mo>=</mo><mn>99</mn></mrow><annotation encoding="application/x-tex">\alpha=99</annotation></semantics></math>)</th>
<th id="S5.T3.2.1.4" class="ltx_td ltx_align_center ltx_th ltx_th_column ltx_border_tt"><span id="S5.T3.2.1.4.1" class="ltx_text ltx_font_bold">exPCA</span> (<math id="S5.T3.m6" class="ltx_Math" alttext="\tau=0.99" display="inline" intent=":literal"><semantics><mrow><mi>τ</mi><mo>=</mo><mn>0.99</mn></mrow><annotation encoding="application/x-tex">\tau=0.99</annotation></semantics></math>)</th>
