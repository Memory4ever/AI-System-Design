<span id="Sx1.T1.2.15.1.1.1" class="ltx_p"><math id="Sx1.T1.m19" class="ltx_Math" alttext="e_{\tau}(L_{f})" display="inline" intent=":literal"><semantics><mrow><msub><mi>e</mi><mi>τ</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mi>L</mi><mi>f</mi></msub><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">e_{\tau}(L_{f})</annotation></semantics></math></span>
</span></td>
<td id="Sx1.T1.2.15.2" class="ltx_td ltx_align_left ltx_align_top ltx_border_r">
