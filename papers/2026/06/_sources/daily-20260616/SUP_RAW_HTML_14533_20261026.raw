<span id="S1.F1.pic1.11.4" class="ltx_p"><span id="S1.F1.pic1.11.4.1" class="ltx_text ltx_font_sansserif" style="font-size:90%;--ltx-fg-color:#008000;">Minimize <math id="S1.F1.pic1.m10" class="ltx_Math" alttext="e_{\tau}(C_{h(P^{\top}X),Y})" display="inline" intent=":literal"><semantics><mrow><msub><mi style="--ltx-fg-color:#008000;" mathcolor="#008000">e</mi><mi style="--ltx-fg-color:#008000;" mathcolor="#008000">τ</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo style="--ltx-fg-color:#008000;" mathcolor="#008000" stretchy="false">(</mo><msub><mi style="--ltx-fg-color:#008000;" mathcolor="#008000">C</mi><mrow><mrow><mi style="--ltx-fg-color:#008000;" mathcolor="#008000">h</mi><mo>⁡</mo><mrow><mo style="--ltx-fg-color:#008000;" mathcolor="#008000" stretchy="false">(</mo><mrow><msup><mi style="--ltx-fg-color:#008000;" mathcolor="#008000">P</mi><mo style="--ltx-fg-color:#008000;" mathcolor="#008000">⊤</mo></msup><mo lspace="0em" rspace="0em">​</mo><mi style="--ltx-fg-color:#008000;" mathcolor="#008000">X</mi></mrow><mo style="--ltx-fg-color:#008000;" mathcolor="#008000" stretchy="false">)</mo></mrow></mrow><mo style="--ltx-fg-color:#008000;" mathcolor="#008000">,</mo><mi style="--ltx-fg-color:#008000;" mathcolor="#008000">Y</mi></mrow></msub><mo style="--ltx-fg-color:#008000;" mathcolor="#008000" stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">e_{\tau}(C_{h(P^{\top}X),Y})</annotation></semantics></math></span></span>
