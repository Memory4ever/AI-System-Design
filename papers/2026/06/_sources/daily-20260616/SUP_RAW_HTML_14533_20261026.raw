<tr id="S4.T2.2.3" class="ltx_tr">
<th id="S4.T2.2.3.1" class="ltx_td ltx_align_left ltx_th ltx_th_row ltx_border_bb">Example 2: Discrete Point Mass</th>
<td id="S4.T2.2.3.2" class="ltx_td ltx_align_right ltx_border_bb"><math id="S4.T2.m9" class="ltx_Math" alttext="66.8919" display="inline" intent=":literal"><semantics><mn>66.8919</mn><annotation encoding="application/x-tex">66.8919</annotation></semantics></math></td>
