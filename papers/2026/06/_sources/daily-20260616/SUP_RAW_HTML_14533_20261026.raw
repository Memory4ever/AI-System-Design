</span></td>
<td id="Sx1.T1.2.10.2" class="ltx_td ltx_align_left ltx_align_top ltx_border_r">
<span id="Sx1.T1.2.10.2.1" class="ltx_inline-block ltx_align_top" style="width:142.3pt;">
<span id="Sx1.T1.2.10.2.1.1" class="ltx_p">Compressed representation after PCA</span>
</span></td></tr>
<tr id="Sx1.T1.2.11" class="ltx_tr">
<td id="Sx1.T1.2.11.1" class="ltx_td ltx_align_left ltx_align_top ltx_border_l ltx_border_r">
<span id="Sx1.T1.2.11.1.1" class="ltx_inline-block ltx_align_top" style="width:85.4pt;">
<span id="Sx1.T1.2.11.1.1.1" class="ltx_p"><math id="Sx1.T1.m14" class="ltx_Math" alttext="z_{j}" display="inline" intent=":literal"><semantics><msub><mi>z</mi><mi>j</mi></msub><annotation encoding="application/x-tex">z_{j}</annotation></semantics></math></span>
</span></td>
<td id="Sx1.T1.2.11.2" class="ltx_td ltx_align_left ltx_align_top ltx_border_r">
<span id="Sx1.T1.2.11.2.1" class="ltx_inline-block ltx_align_top" style="width:142.3pt;">
<span id="Sx1.T1.2.11.2.1.1" class="ltx_p">Latent coordinate along <math id="Sx1.T1.m15" class="ltx_Math" alttext="v_{j}" display="inline" intent=":literal"><semantics><msub><mi>v</mi><mi>j</mi></msub><annotation encoding="application/x-tex">v_{j}</annotation></semantics></math></span>
</span></td></tr>
<tr id="Sx1.T1.2.12" class="ltx_tr">
<td id="Sx1.T1.2.12.1" class="ltx_td ltx_align_left ltx_align_top ltx_border_l ltx_border_r">
<span id="Sx1.T1.2.12.1.1" class="ltx_inline-block ltx_align_top" style="width:85.4pt;">
<span id="Sx1.T1.2.12.1.1.1" class="ltx_p"><math id="Sx1.T1.m16" class="ltx_Math" alttext="I(\cdot;\cdot)" display="inline" intent=":literal"><semantics><mrow><mi>I</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mo lspace="0em" rspace="0em">⋅</mo><mo rspace="0em">,</mo><mo lspace="0em" rspace="0em">⋅</mo><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">I(\cdot;\cdot)</annotation></semantics></math></span>
</span></td>
<td id="Sx1.T1.2.12.2" class="ltx_td ltx_align_left ltx_align_top ltx_border_r">
<span id="Sx1.T1.2.12.2.1" class="ltx_inline-block ltx_align_top" style="width:142.3pt;">
