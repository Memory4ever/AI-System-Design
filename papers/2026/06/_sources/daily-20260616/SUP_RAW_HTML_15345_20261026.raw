<td id="A1.p1.p1.1.14.3" class="ltx_td ltx_align_right ltx_border_bb ltx_border_t"><span id="A1.p1.p1.1.14.3.1" class="ltx_text ltx_font_bold">5,040</span></td></tr>
</tbody>
</table>
</div>
        
<figure id="A1.T8" class="ltx_table ltx_align_center">
