<th id="S4.T4.2.1.3.1" class="ltx_td ltx_align_left ltx_th ltx_th_row" style="padding-left:3.5pt;padding-right:3.5pt;">Multi.</th>
<td id="S4.T4.2.1.3.2" class="ltx_td ltx_align_right" style="padding-left:3.5pt;padding-right:3.5pt;">12.05</td>
