<path d="M17 2L50 34.9999L17 68" stroke="white" stroke-width="2"/>
</svg></div></div></div><div aria-hidden="true" class="button_main_text u-text-style-main">About</div><div class="button_main_icon u-hide-if-empty"></div><div class="button_main_line w-variant-625d5df4-ad91-f7dc-9e2f-2e69f3fd7400"></div></div></div><div data-wf--author-card--variant="large" class="author_card_wrap w-variant-7d1d2425-b987-af80-745e-2a36307bf6d5"><img loading="lazy" src="https://cdn.prod.website-files.com/plugins/Basic/assets/placeholder.60f9b1840c.svg" alt="" class="author_card_image w-variant-7d1d2425-b987-af80-745e-2a36307bf6d5"/><div class="author_card_content u-margin-trim"><h1 class="author_card_name u-text-style-h6 w-variant-7d1d2425-b987-af80-745e-2a36307bf6d5">Jai Bhagat</h1><p class="author_card_role u-text-style-small"></p><p class="author_card_role u-text-style-small"></p></div></div><div data-number="-1" data-wf--typography-paragraph--variant="inherit" class="u-text u-rich-text w-richtext"></div><div role="list" class="social_wrap"></div></div></div></div></div><div data-wf--spacer--variant="main" class="u-section-spacer w-variant-60a7ad7d-02b0-6682-95a5-2218e6fd1490 u-ignore-trim"></div></section><section data-wf--section--variant="inherit" class="u-section u-hide-if-empty-cms"><div data-wf--spacer--variant="main" class="u-section-spacer w-variant-60a7ad7d-02b0-6682-95a5-2218e6fd1490 u-ignore-trim"></div><div class="u-container u-container-small"><div data-wf--layout--variant="stack" class="u-layout-wrapper"><div class="u-layout"><div class="u-layout-column-1  "><div data-number="20" data-wf--typography-heading--variant="h2" class="u-heading w-variant-433d40c6-c261-f13f-c899-61d2cadf150f w-richtext"><h2>Publications</h2></div></div><div class="u-layout-column-2  "><div data-wf--grid--settings-variant="default" STYLE="" data-number="12" class="u-grid-wrapper"><div role="none" data-large-columns="2" data-medium-columns="1" data-small-columns="0" data-xsmall-columns="0" class="u-grid"><div class="u-display-contents w-dyn-list"><div role="list" class="u-display-contents w-dyn-items"><div role="listitem" class="u-display-contents w-dyn-item"><div data-trigger="hover-if-clickable" class="main_card_wrap"><div class="main_card_group"><div class="main_card_content"><div class="main_card_column"><h3 data-wf--typography-plain--variant="h4" STYLE="" data-number="-1" class="u-text w-variant-f196774e-dbfd-d1b4-1196-b3e824fc5f7d"><span>Compressed Computation is (probably) not Computation in Superposition</span></h3><div data-wf--category-tag--variant="research-green" class="category_tag_wrap"><div class="category_tag_line"></div><div class="tag_wrap">Interpretability</div></div></div><div class="main_card_column u-margin-trim"><p class="main_card_text u-text-style-small u-line-clamp-4 u-text-trim-off">We show that the apparent performance gains of the Compressed Computation toy model arise from unintended label mixing via a noisy residual stream, not from computation in superposition.</p><div class="main_card_detail"><div data-date-range="true" class="event-date_wrap u-text-style-small"><div data-date-start="true" class="event-date_date u-display-none">December 5, 2025</div><div data-date-end="true" class="event-date_date u-display-none"></div><div data-date-output="true" class="event-date_date">Date Range</div><div class="u-embed-js w-embed w-script"><script>
(() => {
  const script = document.currentScript;

  if (!script) {
    console.warn("Date range: current script could not be found.");
    return;
  }

  const wrapper = script.closest("[data-date-range]");

  if (!wrapper) {
    console.warn(
      "Date range: place the Code Embed inside an element with data-date-range."
    );
    return;
  }

  const startElement = wrapper.querySelector("[data-date-start]");
  const endElement = wrapper.querySelector("[data-date-end]");
  const outputElement = wrapper.querySelector("[data-date-output]");

  if (!startElement || !outputElement) {
    console.warn("Date range: required elements are missing.", {
      startElement,
      outputElement
    });
    return;
  }

  const months = [
    "January",
    "February",
    "March",
    "April",
    "May",
    "June",
    "July",
    "August",
    "September",
    "October",
    "November",
    "December"
  ];

  function cleanText(element) {
    return element?.textContent
      .replace(/\u00a0/g, " ")
      .replace(/\s+/g, " ")
      .trim() || "";
  }

  function parseDate(value) {
    const match = value.match(
      /^([A-Za-z]+)\s+(\d{1,2}),\s*(\d{4})$/
    );

    if (!match) return null;

    const monthIndex = months.indexOf(match[1]);

    if (monthIndex === -1) return null;

    return {
      month: match[1],
      monthIndex,
      day: Number(match[2]),
      year: Number(match[3])
    };
  }

  function formatRange(start, end) {
    if (!end) {
      return `${start.month} ${start.day}, ${start.year}`;
    }

    const sameYear = start.year === end.year;
    const sameMonth =
      sameYear && start.monthIndex === end.monthIndex;

    if (sameMonth) {
      return `${start.month} ${start.day}-${end.day}, ${start.year}`;
    }

    if (sameYear) {
      return `${start.month} ${start.day}-${end.month} ${end.day}, ${start.year}`;
    }

    return `${start.month} ${start.day}, ${start.year}-${end.month} ${end.day}, ${end.year}`;
  }

  function initialiseDateRange() {
    const startText = cleanText(startElement);
    const endText = cleanText(endElement);

    const startDate = parseDate(startText);
    const endDate = endText ? parseDate(endText) : null;

    if (!startDate) {
      console.warn(
        'Date range: the start date must use the format "March 27, 2025".',
        startText
      );
      return;
    }

    if (endText && !endDate) {
      console.warn(
        'Date range: the end date must use the format "March 28, 2025".',
        endText
      );
      return;
    }

    outputElement.textContent = formatRange(
      startDate,
      endDate
    );
  }

  /*
   * The Embed is placed after the CMS date elements, so the
   * component can normally initialise immediately.
   */
  initialiseDateRange();
})();
</script></div></div></div></div></div></div><div data-wf--clickable--variant="focus-ring-outside" class="clickable_wrap u-cover-absolute"><a aria-label="Compressed Computation is (probably) not Computation in Superposition" href="/research/compressed-computation-is-probably-not-computation-in-superposition" class="clickable_link w-inline-block"></a></div></div></div></div></div></div></div></div></div></div></div><div data-wf--spacer--variant="main" class="u-section-spacer w-variant-60a7ad7d-02b0-6682-95a5-2218e6fd1490 u-ignore-trim"></div></section><section data-wf--section--variant="inherit" class="u-section u-hide-if-empty-cms"><div data-wf--spacer--variant="main" class="u-section-spacer w-variant-60a7ad7d-02b0-6682-95a5-2218e6fd1490 u-ignore-trim"></div><div class="u-container u-container-small"><div data-wf--layout--variant="stack" class="u-layout-wrapper"><div class="u-layout"><div class="u-layout-column-1  "><div data-number="20" data-wf--typography-heading--variant="h2" class="u-heading w-variant-433d40c6-c261-f13f-c899-61d2cadf150f w-richtext"><h2>News</h2></div></div><div class="u-layout-column-2  "><div STYLE="" class="u-flex-vertical-nowrap u-gap-row-2"><div class="u-display-contents"><div class="u-display-contents w-dyn-list"><div class="w-dyn-empty"><div>No items found.</div></div></div></div></div></div></div></div></div><div data-wf--spacer--variant="main" class="u-section-spacer w-variant-60a7ad7d-02b0-6682-95a5-2218e6fd1490 u-ignore-trim"></div></section><div><section data-wf--section--variant="inherit" class="u-section"><div data-wf--spacer--variant="even" class="u-section-spacer w-variant-41fc0c0a-cac3-53c9-9802-6a916e3fb342 u-ignore-trim"></div><div class="u-container  "><div data-wf--grid--settings-variant="default" STYLE="" data-number="12" class="u-grid-wrapper u-gap-0"><div role="none" data-large-columns="3" data-medium-columns="1" data-small-columns="0" data-xsmall-columns="0" class="u-grid"><div data-wf--card-primary--variant="default" cl