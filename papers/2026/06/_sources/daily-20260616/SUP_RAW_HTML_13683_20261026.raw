            <span class="ltx_tag ltx_tag_listingline"><span id="alg1.l15.1" class="ltx_text" style="font-size:80%;">15:</span></span>
            
            
               <math id="alg1.l15.m1" class="ltx_Math" alttext="(score,sequence)\leftarrow" display="inline" intent=":literal"><semantics><mrow><mrow><mo stretchy="false">(</mo><mrow><mi>s</mi><mo lspace="0em" rspace="0em">​</mo><mi>c</mi><mo lspace="0em" rspace="0em">​</mo><mi>o</mi><mo lspace="0em" rspace="0em">​</mo><mi>r</mi><mo lspace="0em" rspace="0em">​</mo><mi>e</mi></mrow><mo>,</mo><mrow><mi>s</mi><mo lspace="0em" rspace="0em">​</mo><mi>e</mi><mo lspace="0em" rspace="0em">​</mo><mi>q</mi><mo lspace="0em" rspace="0em">​</mo><mi>u</mi><mo lspace="0em" rspace="0em">​</mo><mi>e</mi><mo lspace="0em" rspace="0em">​</mo><mi>n</mi><mo lspace="0em" rspace="0em">​</mo><mi>c</mi><mo lspace="0em" rspace="0em">​</mo><mi>e</mi></mrow><mo stretchy="false">)</mo></mrow><mo stretchy="false">←</mo><mphantom></mphantom></mrow><annotation encoding="application/x-tex">(score,sequence)\leftarrow</annotation></semantics></math> <span id="alg1.l15.3" class="ltx_text ltx_font_smallcaps">NRPA</span>(<math id="alg1.l15.m2" class="ltx_Math" alttext="level-1" display="inline" intent=":literal"><semantics><mrow><mrow><mi>l</mi><mo lspace="0em" rspace="0em">​</mo><mi>e</mi><mo lspace="0em" rspace="0em">​</mo><mi>v</mi><mo lspace="0em" rspace="0em">​</mo><mi>e</mi><mo lspace="0em" rspace="0em">​</mo><mi>l</mi></mrow><mo>−</mo><mn>1</mn></mrow><annotation encoding="application/x-tex">level-1</annotation></semantics></math>, <math id="alg1.l15.m3" class="ltx_Math" alttext="\pi" display="inline" intent=":literal"><semantics><mi>π</mi><annotation encoding="application/x-tex">\pi</annotation></semantics></math>, <math id="alg1.l15.m4" class="ltx_Math" alttext="s" display="inline" intent=":literal"><semantics><mi>s</mi><annotation encoding="application/x-tex">s</annotation></semantics></math>)

</div>
<div id="alg1.l16" class="ltx_listingline">
            <span class="ltx_tag ltx_tag_listingline"><span id="alg1.l16.1" class="ltx_text" style="font-size:80%;">16:</span></span>
            
            
               <span id="alg1.l16.3" class="ltx_text ltx_font_bold">if</span> <math id="alg1.l16.m1" class="ltx_Math" alttext="score&gt;bestScore" display="inline" intent=":literal"><semantics><mrow><mrow><mi>s</mi><mo lspace="0em" rspace="0em">​</mo><mi>c</mi><mo lspace="0em" rspace="0em">​</mo><mi>o</mi><mo lspace="0em" rspace="0em">​</mo><mi>r</mi><mo lspace="0em" rspace="0em">​</mo><mi>e</mi></mrow><mo>&gt;</mo><mrow><mi>b</mi><mo lspace="0em" rspace="0em">​</mo><mi>e</mi><mo lspace="0em" rspace="0em">​</mo><mi>s</mi><mo lspace="0em" rspace="0em">​</mo><mi>t</mi><mo lspace="0em" rspace="0em">​</mo><mi>S</mi><mo lspace="0em" rspace="0em">​</mo><mi>c</mi><mo lspace="0em" rspace="0em">​</mo><mi>o</mi><mo lspace="0em" rspace="0em">​</mo><mi>r</mi><mo lspace="0em" rspace="0em">​</mo><mi>e</mi></mrow></mrow><annotation encoding="application/x-tex">score&gt;bestScore</annotation></semantics></math> <span id="alg1.l16.4" class="ltx_text ltx_font_bold">then</span>

</div>
