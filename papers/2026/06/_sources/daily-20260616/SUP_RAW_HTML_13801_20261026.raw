<span id="A1.T2.2.15.3.1" class="ltx_inline-block ltx_parbox ltx_align_middle" style="width:37.0pt;"><img src="2606.13801v1/examples/Perspective_1.0.png" id="A1.T2.g35" class="ltx_graphics ltx_img_square" style="aspect-ratio:51/51;" width="51" height="51" alt="[Uncaptioned image]">
</span></td>
