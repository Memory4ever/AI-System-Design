<span id="A1.T2.2.15.4.1" class="ltx_inline-block ltx_parbox ltx_align_middle" style="width:37.0pt;"><img src="2606.13801v1/examples/Perspective_2.0.png" id="A1.T2.g36" class="ltx_graphics ltx_img_square" style="aspect-ratio:51/51;" width="51" height="51" alt="[Uncaptioned image]">
</span></td></tr>
<tr id="A1.T2.2.16" class="ltx_tr">
<th id="A1.T2.2.16.1" class="ltx_td ltx_align_left ltx_th ltx_th_row ltx_border_l ltx_border_r ltx_border_t"><span id="A1.T2.2.16.1.1" class="ltx_text" style="font-size:90%;">RandomRotation(rotation = 0.60 * scale)</span></th>
