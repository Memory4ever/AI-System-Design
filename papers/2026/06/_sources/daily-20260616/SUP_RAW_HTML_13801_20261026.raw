<td id="A1.T2.2.1.2" class="ltx_td ltx_align_center ltx_border_r ltx_border_t"><math id="A1.T2.m1" class="ltx_Math" alttext="\bm{\varepsilon}" display="inline" intent=":literal"><semantics><mi mathsize="0.900em">𝜺</mi><annotation encoding="application/x-tex">\bm{\varepsilon}</annotation></semantics></math><span id="A1.T2.2.1.2.1" class="ltx_text ltx_font_bold" style="font-size:90%;">=0.02</span></td>
<td id="A1.T2.2.1.3" class="ltx_td ltx_align_center ltx_border_r ltx_border_t"><math id="A1.T2.m2" class="ltx_Math" alttext="\bm{\varepsilon}" display="inline" intent=":literal"><semantics><mi mathsize="0.900em">𝜺</mi><annotation encoding="application/x-tex">\bm{\varepsilon}</annotation></semantics></math><span id="A1.T2.2.1.3.1" class="ltx_text ltx_font_bold" style="font-size:90%;">=0.10</span></td>
<td id="A1.T2.2.1.4" class="ltx_td ltx_align_center ltx_border_r ltx_border_t"><math id="A1.T2.m3" class="ltx_Math" alttext="\bm{\varepsilon}" display="inline" intent=":literal"><semantics><mi mathsize="0.900em">𝜺</mi><annotation encoding="application/x-tex">\bm{\varepsilon}</annotation></semantics></math><span id="A1.T2.2.1.4.1" class="ltx_text ltx_font_bold" style="font-size:90%;">=0.20</span></td></tr>
