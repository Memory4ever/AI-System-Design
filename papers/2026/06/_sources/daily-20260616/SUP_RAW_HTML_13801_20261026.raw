<span id="A1.T2.2.16.2.1" class="ltx_inline-block ltx_parbox ltx_align_middle" style="width:37.0pt;"><img src="2606.13801v1/examples/Rotate_0.2.png" id="A1.T2.g37" class="ltx_graphics ltx_img_square" style="aspect-ratio:51/51;" width="51" height="51" alt="[Uncaptioned image]">
</span></td>
