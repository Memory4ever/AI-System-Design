<td id="A3.F6.3.2.2" class="ltx_td ltx_nopad_l ltx_nopad_r ltx_align_center" style="padding:-5pt 0.0pt;"><img src="2606.14317v1/figs/sup_intermediate_result/exp_10/row_03_t0091.png" id="A3.F6.g4" class="ltx_graphics ltx_img_landscape" style="aspect-ratio:238/82;" width="238" height="82" alt="Refer to caption"></td></tr>
