<td id="S4.T1.3.15.5" class="ltx_td ltx_align_center ltx_border_bb" style="--ltx-bg-color:#FFDFBF;padding-left:4.0pt;padding-right:4.0pt;"><span id="S4.T1.3.15.5.1" class="ltx_text" style="font-size:90%;--ltx-bg-color:#FFDFBF;">0.61</span></td>
