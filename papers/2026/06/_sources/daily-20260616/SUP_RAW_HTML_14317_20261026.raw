<table id="A3.F7.3" class="ltx_tabular ltx_centering ltx_align_middle">
<tr id="A3.F7.3.1" class="ltx_tr">
<td id="A3.F7.3.1.1" class="ltx_td ltx_nopad_l ltx_nopad_r ltx_align_center" style="padding:-5pt 0.0pt;"><img src="2606.14317v1/figs/sup_intermediate_result/exp_27/row_00_t0000.png" id="A3.F7.g1" class="ltx_graphics ltx_img_landscape" style="aspect-ratio:238/82;" width="238" height="82" alt="Refer to caption"></td>
