</span></td></tr>
<tr id="A2.T4.5.3" class="ltx_tr">
<td id="A2.T4.5.3.1" class="ltx_td ltx_align_center"><span id="A2.T4.5.3.1.1" class="ltx_text" style="font-size:90%;">Physical State and Trajectory Planning</span></td>
<td id="A2.T4.5.3.2" class="ltx_td ltx_align_center"><span id="A2.T4.5.3.2.1" class="ltx_text" style="font-size:90%;">69 sec</span></td>
<td id="A2.T4.5.3.3" class="ltx_td ltx_align_left">
