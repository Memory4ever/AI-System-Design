<script>
  // 8rem, computed from the real root font-size
  const rem = parseFloat(getComputedStyle(document.documentElement).fontSize);
  const OFFSET = 8 * rem; // clears the sticky header

  document.addEventListener('click', (e) => {
    const link = e.target.closest('a[href^="#"]');
    if (!link) return;
    let id;
    try { id = decodeURIComponent(link.getAttribute('href').slice(1)); } catch { return; }
    if (!id) return;                 // ignore a bare "#"
    const target = document.getElementById(id);
    if (!target) return;
    e.preventDefault();
    e.stopPropagation();             // kills Webflow's jQuery scroll handler
    const top = target.getBoundingClientRect().top + window.scrollY - OFFSET;
    window.scrollTo({ top, behavior: 'smooth' });
  }, true);
</script>

<!-- Google Tag Manager (noscript) -->
<noscript><iframe src="https://www.googletagmanager.com/ns.html?id=GTM-T7PKWMJ2"
height="0" width="0" style="display:none;visibility:hidden"></iframe></noscript>
<!-- End Google Tag Manager (noscript) --><script src="https://tools.refokus.com/social-share/bundle.v1.0.0.js"></script>
<script>
(function () {
  function init() {
    const btn = document.querySelector('[data-copy-btn]');
    const citation = document.querySelector('[data-citation]');
    if (!btn || !citation) return;

    btn.addEventListener('click', function () {
      const text = citation.textContent.trim();

      // clickable_btn → clickable_wrap → button_main_wrap (contains .button_main_text)
      const label = btn.parentElement.parentElement.querySelector('.button_main_text');
      if (!label) return;

      const orig = label.textContent;
      copy(text, function () {
        label.textContent = 'Copied';
        setTimeout(function () { label.textContent = orig; }, 2000);
      });
    });
  }

  function copy(text, callback) {
    if (navigator.clipboard && window.isSecureContext) {
      navigator.clipboard.writeText(text).then(callback).catch(function () { fallback(text, callback); });
    } else {
      fallback(text, callback);
    }
  }

  function fallback(text, callback) {
    const ta = document.createElement('textarea');
    ta.value = text;
    ta.style.cssText = 'position:fixed;left:-9999px;top:-9999px;opacity:0';
    document.body.appendChild(ta);
    ta.focus();
    ta.select();
    try { document.execCommand('copy'); callback(); } catch (e) {}
    document.body.removeChild(ta);
  }

  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', init);
  } else {
    init();
  }
})();
</script></body></html>