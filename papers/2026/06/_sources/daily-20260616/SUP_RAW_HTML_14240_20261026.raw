<section id="A2.SS2" class="ltx_subsection">
<h3 class="ltx_title ltx_title_subsection"><span class="ltx_tag ltx_tag_subsection">B.2 </span>Prompts</h3>

<section id="A2.SS2.SSS0.Px1" class="ltx_paragraph">
<h4 class="ltx_title ltx_title_paragraph">Questioner.</h4>

<div id="A2.SS2.SSS0.Px1.p1" class="ltx_para">
<p id="A2.SS2.SSS0.Px1.p1.1" class="ltx_p">The Questioner plays the active role of the game and asks yes/no questions about the hidden object’s static physical properties.</p>
</div>
<div id="A2.SS2.SSS0.Px1.p2" class="ltx_para">
<div id="A2.SS2.SSS0.Px1.p2.1" class="ltx_listing ltx_lstlisting ltx_framed ltx_framed_rectangle ltx_listing" style="--ltx-bg-color:#FAFAFA;"><div class="ltx_listing_data"><a href="data:text/plain;base64," download="">⬇</a></div>
<div id="lstnumberx85" class="ltx_listingline"><span id="lstnumberx85.1" class="ltx_text ltx_lst_identifier ltx_font_typewriter">You</span><span id="lstnumberx85.2" class="ltx_text ltx_lst_space ltx_font_typewriter"> </span><span id="lstnumberx85.3" class="ltx_text ltx_lst_identifier ltx_font_typewriter">are</span><span id="lstnumberx85.4" class="ltx_text ltx_lst_space ltx_font_typewriter"> </span><span id="lstnumberx85.5" class="ltx_text ltx_lst_identifier ltx_font_typewriter">playing</span><span id="lstnumberx85.6" class="ltx_text ltx_lst_space ltx_font_typewriter"> </span><span id="lstnumberx85.7" class="ltx_text ltx_lst_identifier ltx_font_typewriter">a</span><span id="lstnumberx85.8" class="ltx_text ltx_lst_space ltx_font_typewriter"> </span><span id="lstnumberx85.9" class="ltx_text ltx_font_typewriter">20</span><span id="lstnumberx85.10" class="ltx_text ltx_lst_space ltx_font_typewriter"> </span><span id="lstnumberx85.11" class="ltx_text ltx_lst_identifier ltx_font_typewriter">Questions</span><span id="lstnumberx85.12" class="ltx_text ltx_lst_space ltx_font_typewriter"> </span><span id="lstnumberx85.13" class="ltx_text ltx_lst_identifier ltx_font_typewriter">game</span><span id="lstnumberx85.14" class="ltx_text ltx_lst_space ltx_font_typewriter"> </span><span id="lstnumberx85.15" class="ltx_text ltx_lst_identifier ltx_font_typewriter">about</span><span id="lstnumberx85.16" class="ltx_text ltx_lst_space ltx_font_typewriter"> </span><span id="lstnumberx85.17" class="ltx_text ltx_lst_identifier ltx_font_typewriter">object</span><span id="lstnumberx85.18" class="ltx_text ltx_lst_space ltx_font_typewriter"> </span><span id="lstnumberx85.19" class="ltx_text ltx_lst_identifier ltx_font_typewriter">AFFORDANCES</span><span id="lstnumberx85.20" class="ltx_text ltx_font_typewriter">.</span>
</div>
