<td id="A2.T3.2.2.3" class="ltx_td ltx_align_center ltx_border_bb ltx_border_t">93.4</td>
<td id="A2.T3.2.2.4" class="ltx_td ltx_align_center ltx_border_bb ltx_border_t">95.5</td></tr>
</tbody>
