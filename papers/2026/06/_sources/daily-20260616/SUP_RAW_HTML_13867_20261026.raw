<td id="A1.T6.3.3.2" class="ltx_td ltx_align_right"><span id="A1.T6.3.3.2.1" class="ltx_text ltx_font_bold">0.597</span></td>
<td id="A1.T6.3.3.3" class="ltx_td ltx_align_right"><span id="A1.T6.3.3.3.1" class="ltx_text ltx_font_bold">0.708</span></td></tr>
