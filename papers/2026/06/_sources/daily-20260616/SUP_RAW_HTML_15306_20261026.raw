<span id="S2.T2.3.5.1.1.1" class="ltx_p"><span id="S2.T2.3.5.1.1.1.1" class="ltx_text" style="font-size:90%;">Mastermind</span></span>
</span></td>
<td id="S2.T2.3.5.2" class="ltx_td ltx_align_left ltx_align_top">
<span id="S2.T2.3.5.2.1" class="ltx_inline-block ltx_align_top" style="width:117.3pt;">
<span id="S2.T2.3.5.2.1.1" class="ltx_p"><span id="S2.T2.3.5.2.1.1.1" class="ltx_text" style="font-size:90%;">Infer hidden code</span></span>
</span></td>
<td id="S2.T2.3.5.3" class="ltx_td ltx_align_left ltx_align_top">
<span id="S2.T2.3.5.3.1" class="ltx_inline-block ltx_align_top" style="width:124.2pt;">
<span id="S2.T2.3.5.3.1.1" class="ltx_p"><span id="S2.T2.3.5.3.1.1.1" class="ltx_text" style="font-size:90%;">Code constraint, structural rule</span></span>
</span></td></tr>
<tr id="S2.T2.3.6" class="ltx_tr">
<td id="S2.T2.3.6.1" class="ltx_td ltx_align_left ltx_align_top">
