<td id="S4.T4.3.8.9" class="ltx_td ltx_align_center ltx_border_bb" style="padding:0.45pt 4.0pt;"><math id="S4.T4.m53" class="ltx_Math" alttext="+8\%" display="inline" intent=":literal"><semantics><mrow><mo mathsize="0.900em">+</mo><mrow><mn mathsize="0.900em">8</mn><mo>%</mo></mrow></mrow><annotation encoding="application/x-tex">+8\%</annotation></semantics></math></td>
