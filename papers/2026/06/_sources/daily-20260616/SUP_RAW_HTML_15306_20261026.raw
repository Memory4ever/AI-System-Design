</span>
<span id="lstnumberx14" class="ltx_listingline"><span id="lstnumberx14.1" class="ltx_text ltx_lst_space ltx_font_typewriter" style="font-size:70%;--ltx-fg-color:#000000;">    </span><span id="lstnumberx14.2" class="ltx_text ltx_lst_string ltx_font_typewriter" style="font-size:70%;--ltx-fg-color:#BA2121;">"no_info"</span><span id="lstnumberx14.3" class="ltx_text ltx_font_typewriter" style="font-size:70%;--ltx-fg-color:#000000;">,</span><span id="lstnumberx14.4" class="ltx_text ltx_lst_space ltx_font_typewriter" style="font-size:70%;--ltx-fg-color:#000000;">          </span><span id="lstnumberx14.5" class="ltx_text ltx_lst_comment ltx_font_typewriter ltx_font_italic" style="font-size:70%;--ltx-fg-color:#408080;">#<span id="lstnumberx14.5.1" class="ltx_text ltx_lst_space"> </span>prompt</span>
</span>
<span id="lstnumberx15" class="ltx_listingline"><span id="lstnumberx15.1" class="ltx_text ltx_lst_space ltx_font_typewriter" style="font-size:70%;--ltx-fg-color:#000000;">    </span><span id="lstnumberx15.2" class="ltx_text ltx_lst_string ltx_font_typewriter" style="font-size:70%;--ltx-fg-color:#BA2121;">"standard"</span><span id="lstnumberx15.3" class="ltx_text ltx_font_typewriter" style="font-size:70%;--ltx-fg-color:#000000;">,</span><span id="lstnumberx15.4" class="ltx_text ltx_lst_space ltx_font_typewriter" style="font-size:70%;--ltx-fg-color:#000000;">         </span><span id="lstnumberx15.5" class="ltx_text ltx_lst_comment ltx_font_typewriter ltx_font_italic" style="font-size:70%;--ltx-fg-color:#408080;">#<span id="lstnumberx15.5.1" class="ltx_text ltx_lst_space"> </span>feedback</span>
</span>
<span id="lstnumberx16" class="ltx_listingline"><span id="lstnumberx16.1" class="ltx_text ltx_lst_space ltx_font_typewriter" style="font-size:70%;--ltx-fg-color:#000000;">    </span><span id="lstnumberx16.2" class="ltx_text ltx_lst_identifier ltx_font_typewriter" style="font-size:70%;--ltx-fg-color:#000000;">num_episodes</span><span id="lstnumberx16.3" class="ltx_text ltx_font_typewriter" style="font-size:70%;--ltx-fg-color:#000000;">=10,</span><span id="lstnumberx16.4" class="ltx_text ltx_lst_space ltx_font_typewriter" style="font-size:70%;--ltx-fg-color:#000000;">    </span><span id="lstnumberx16.5" class="ltx_text ltx_lst_comment ltx_font_typewriter ltx_font_italic" style="font-size:70%;--ltx-fg-color:#408080;">#<span id="lstnumberx16.5.1" class="ltx_text ltx_lst_space"> </span>horizon<span id="lstnumberx16.5.2" class="ltx_text ltx_lst_space"> </span>N</span>
</span>
