<td id="S7.T1.8.7.2" class="ltx_td ltx_align_center ltx_border_bb ltx_border_t"><span id="S7.T1.8.7.2.1" class="ltx_text ltx_font_bold" style="font-size:90%;">8.97</span></td>
<td id="S7.T1.8.7.3" class="ltx_td ltx_align_center ltx_border_bb ltx_border_t"><span id="S7.T1.8.7.3.1" class="ltx_text ltx_font_bold" style="font-size:90%;">6.75</span></td>
