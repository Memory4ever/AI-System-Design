<td id="S7.T2.8.6.4" class="ltx_td ltx_align_center ltx_border_bb ltx_border_t"><span id="S7.T2.8.6.4.1" class="ltx_text ltx_font_bold" style="font-size:90%;">4.48</span></td>
<td id="S7.T2.8.6.5" class="ltx_td ltx_align_center ltx_border_bb ltx_border_t"><span id="S7.T2.8.6.5.1" class="ltx_text ltx_font_bold" style="font-size:90%;">4.57</span></td>
<td id="S7.T2.8.6.6" class="ltx_td ltx_align_center ltx_border_bb ltx_border_t"><span id="S7.T2.8.6.6.1" class="ltx_text ltx_font_bold" style="font-size:90%;">4.75</span></td>
