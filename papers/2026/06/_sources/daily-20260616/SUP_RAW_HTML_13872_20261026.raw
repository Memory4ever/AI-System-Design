<th id="S7.T1.8.1.2" class="ltx_td ltx_align_center ltx_th ltx_th_column ltx_border_tt"><span id="S7.T1.8.1.2.1" class="ltx_text ltx_font_bold" style="font-size:90%;">Sync-C<math id="S7.T1.m5" class="ltx_Math" alttext="\uparrow" display="inline" intent=":literal"><semantics><mo stretchy="false">↑</mo><annotation encoding="application/x-tex">\uparrow</annotation></semantics></math></span></th>
