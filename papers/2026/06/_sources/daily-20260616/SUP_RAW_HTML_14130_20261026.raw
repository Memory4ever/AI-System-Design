<p id="S5.F3.2" class="ltx_p ltx_align_center"><span id="S5.F3.2.1" class="ltx_text">
<span id="S5.F3.2.1.1" class="ltx_inline-block ltx_transformed_outer" style="width:312.9pt;height:63.3pt;vertical-align:-0.0pt;"><span class="ltx_transformed_inner" style="transform:translate(0.0pt,0.0pt) scale(1,1) ;">
<span id="S5.F3.2.1.1.1" class="ltx_p"><span id="S5.F3.2.1.1.1.1" class="ltx_text"><span class="ltx_inline-block"><svg id="S5.F3.pic1" class="ltx_picture" height="87.53" overflow="visible" version="1.1" viewBox="0 0 428.39 87.53" width="428.39"><g style="--ltx-stroke-color:#000000;--ltx-fill-color:#000000;" fill="#000000" stroke="#000000" transform="translate(0,87.53) matrix(1 0 0 -1 0 0) translate(98.73,0) translate(0,43.77)"><g stroke-width="0.4pt"><g style="--ltx-stroke-color:#2A4B67;--ltx-fill-color:#E8F1F8;" fill="#E8F1F8" stroke="#2A4B67"><path d="M 94.12 32.48 L -94.12 32.48 C -96.52 32.48 -98.45 30.54 -98.45 28.15 L -98.45 -28.15 C -98.45 -30.54 -96.52 -32.48 -94.12 -32.48 L 94.12 -32.48 C 96.52 -32.48 98.45 -30.54 98.45 -28.15 L 98.45 28.15 C 98.45 30.54 96.52 32.48 94.12 32.48 Z M -98.45 -32.48"></path></g><g style="--ltx-stroke-color:#000000;--ltx-fill-color:#000000;" fill="#000000" stroke="#000000" transform="matrix(1.0 0.0 0.0 1.0 -91.54 14.62)"><foreignObject style="--ltx-fo-width:16.6em;--ltx-fo-height:0.49em;--ltx-fo-depth:2.6em;font-size:10pt;" height="42.7" overflow="visible" transform="matrix(1 0 0 -1 0 6.73)" width="229.7"><span class="ltx_foreignobject_container"><span class="ltx_foreignobject_content">
<span id="S5.F3.pic1.1" class="ltx_inline-block ltx_minipage ltx_align_top" style="width:16.6em;">
<span id="S5.F3.pic1.1.1" class="ltx_p"></span>
<span id="S5.F3.pic1.1.2" class="ltx_p ltx_align_left"><span id="S5.F3.pic1.1.2.1" class="ltx_text ltx_font_bold" style="font-size:70%;">1. Safety obligations
<br class="ltx_break"><span id="S5.F3.pic1.1.2.1.1" class="ltx_text ltx_font_medium">Find local obligations
<math id="S5.F3.pic1.m1" class="ltx_Math" alttext="C^{\mathsf{safe}}\mathrel{\overset{\mathrm{def}}{=}}(\varphi_{1},\ldots,\varphi_{n})" display="inline" intent=":literal"><semantics><mrow><msup><mi>C</mi><mi>𝗌𝖺𝖿𝖾</mi></msup><mover accent="true"><mo>=</mo><mo mathsize="0.700em">def</mo></mover><mrow><mo stretchy="false">(</mo><msub><mi>φ</mi><mn>1</mn></msub><mo>,</mo><mi mathvariant="normal">…</mi><mo>,</mo><msub><mi>φ</mi><mi>n</mi></msub><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">C^{\mathsf{safe}}\mathrel{\overset{\mathrm{def}}{=}}(\varphi_{1},\ldots,\varphi_{n})</annotation></semantics></math>
with
<math id="S5.F3.pic1.m2" class="ltx_Math" alttext="\bigwedge_{i}\varphi_{i}\Rightarrow\Phi_{\mathsf{safe}}" display="inline" intent=":literal"><semantics><mrow><mrow><msub><mo>⋀</mo><mi>i</mi></msub><msub><mi>φ</mi><mi>i</mi></msub></mrow><mo stretchy="false">⇒</mo><msub><mi mathvariant="normal">Φ</mi><mi>𝗌𝖺𝖿𝖾</mi></msub></mrow><annotation encoding="application/x-tex">\bigwedge_{i}\varphi_{i}\Rightarrow\Phi_{\mathsf{safe}}</annotation></semantics></math>.</span></span></span>
</span></span></span></foreignObject></g><g style="--ltx-stroke-color:#BB6C2E;--ltx-fill-color:#FFF5EB;" fill="#FFF5EB" stroke="#BB6C2E"><path d="M 325.05 43.49 L 136.8 43.49 C 134.41 43.49 132.47 41.55 132.47 39.16 L 132.47 -39.16 C 132.47 -41.55 134.41 -43.49 136.8 -43.49 L 325.05 -43.49 C 327.44 -43.49 329.38 -41.55 329.38 -39.16 L 329.38 39.16 C 329.38 41.55 327.44 43.49 325.05 43.49 Z M 132.47 -43.49"></path></g><g style="--ltx-stroke-color:#000000;--ltx-fill-color:#000000;" fill="#000000" stroke="#000000" transform="matrix(1.0 0.0 0.0 1.0 139.39 29.85)"><foreignObject style="--ltx-fo-width:16.6em;--ltx-fo-height:0.49em;--ltx-fo-depth:4.8em;font-size:10pt;" height="73.14" overflow="visible" transform="matrix(1 0 0 -1 0 6.73)" width="229.7"><span class="ltx_foreignobject_container"><span class="ltx_foreignobject_content">
<span id="S5.F3.pic1.2" class="ltx_inline-block ltx_minipage ltx_align_top" style="width:16.6em;">
<span id="S5.F3.pic1.2.1" class="ltx_p"></span>
<span id="S5.F3.pic1.2.2" class="ltx_p ltx_align_left"><span id="S5.F3.pic1.2.2.1" class="ltx_text ltx_font_bold" style="font-size:70%;">2. Reward-aware obligations
<br class="ltx_break"><span id="S5.F3.pic1.2.2.1.1" class="ltx_text ltx_font_medium">Find a certified profile <math id="S5.F3.pic1.m3" class="ltx_Math" alttext="C^{\star}" display="inline" intent=":literal"><semantics><msup><mi>C</mi><mo>⋆</mo></msup><annotation encoding="application/x-tex">C^{\star}</annotation></semantics></math> for
reward <math id="S5.F3.pic1.m4" class="ltx_Math" alttext="+" display="inline" intent=":literal"><semantics><mo>+</mo><annotation encoding="application/x-tex">+</annotation></semantics></math> safety; it may expose fewer actions if that protects
high-return coordination.</span></span></span>
</span></span></span></foreignObject></g></g><g style="--ltx-stroke-color:#404040;" stroke="#404040" stroke-dasharray="3.0pt,3.0pt" stroke-dashoffset="0.0pt" stroke-width="0.8pt"><path style="fill:none" d="M 98.73 0 L 123.62 0"></path><g style="--ltx-fill-color:#404040;" fill="#404040" stroke-dasharray="none" stroke-dashoffset="0.0pt" stroke-linejoin="miter" transform="matrix(1.0 0.0 0.0 1.0 123.62 0)"><path d="M 6.37 0 C 5.58 0.19 2.15 1.28 0 2.46 L 0 -2.46 C 2.15 -1.28 5.58 -0.19 6.37 0 Z"></path></g><g style="--ltx-stroke-color:#000000;--ltx-fill-color:#000000;" fill="#000000" stroke="#000000" transform="matrix(1.0 0.0 0.0 1.0 102.04 5.17)"><foreignObject style="--ltx-fo-width:2.43em;--ltx-fo-height:0.61em;--ltx-fo-depth:0em;font-size:7.97pt;" height="6.73" overflow="visible" transform="matrix(1 0 0 -1 0 6.73)" width="26.84"><span class="ltx_foreignobject_container"><span class="ltx_foreignobject_content"><span id="S5.F3.pic1.3" class="ltx_text" style="font-size:70%;">refine</span></span></span></foreignObject></g></g></g></svg></span></span></span>
</span></span></span></p>
<figcaption class="ltx_caption ltx_centering"><span class="ltx_tag ltx_tag_figure">Figure 3: </span>Safety certification and reward-aware contract selection are distinct objectives.</figcaption>
</figure>
<div id="S5.SS2.p2" class="ltx_para">
<p id="S5.SS2.p2.1" class="ltx_p">Notice cardinality permissiveness is not the optimisation objective: <math id="S5.SS2.p2.m1" class="ltx_Math" alttext="\rho_{i}(x^{\mathcal{C}})=1" display="inline" intent=":literal"><semantics><mrow><mrow><msub><mi>ρ</mi><mi>i</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msup><mi>x</mi><mi class="ltx_font_mathcaligraphic">𝒞</mi></msup><mo stretchy="false">)</mo></mrow></mrow><mo>=</mo><mn>1</mn></mrow><annotation encoding="application/x-tex">\rho_{i}(x^{\mathcal{C}})=1</annotation></semantics></math> means no protocol-available primitive action of agent <math id="S5.SS2.p2.m2" class="ltx_Math" alttext="i" display="inline" intent=":literal"><semantics><mi>i</mi><annotation encoding="application/x-tex">i</annotation></semantics></math> is removed at <math id="S5.SS2.p2.m3" class="ltx_Math" alttext="x^{\mathcal{C}}" display="inline" intent=":literal"><semantics><msup><mi>x</mi><mi class="ltx_font_mathcaligraphic">𝒞</mi></msup><annotation encoding="application/x-tex">x^{\mathcal{C}}</annotation></semantics></math>, while smaller values indicate more intervention. A large mask can preserve many low-value actions while excluding coordinated high-return behaviours, and a stricter certified profile can make useful coordination easier to learn. Contract selection therefore optimises observed team return over certified profiles, not total mask cardinality. The relevant completeness question is whether some certified contract preserves the globally optimal safe behaviour. We formalise this by comparing policies admitted by certified decentralised shields.</p>
</div>
<div id="Thmdefinition15" class="ltx_theorem ltx_theorem_definition">
<h6 class="ltx_title ltx_runin ltx_title_theorem"><span class="ltx_tag ltx_tag_theorem"><span id="Thmdefinition15.2" class="ltx_text ltx_font_bold">Definition 15</span></span><span id="Thmdefinition15.3" class="ltx_text ltx_font_bold"> (Contract-Compatible Policies)</span></h6>
<div id="Thmdefinition15.p1" class="ltx_para">
<p id="Thmdefinition15.p1.1" class="ltx_p">Let <math id="Thmdefinition15.p1.m1" class="ltx_Math" alttext="\mathcal{C}" display="inline" intent=":literal"><semantics><mi class="ltx_font_mathcaligraphic">𝒞</mi><annotation encoding="application/x-tex">\mathcal{C}</annotation></semantics></math> be a certified contract. For a joint policy <math id="Thmdefinition15.p1.m2" class="ltx_Math" alttext="\pi" display="inline" intent=":literal"><semantics><mi>π</mi><annotation encoding="application/x-tex">\pi</annotation></semantics></math>, let <math id="Thmdefinition15.p1.m3" class="ltx_Math" alttext="\mathsf{Reach}_{\mathcal{C}}(\pi)" display="inline" intent=":literal"><semantics><mrow><msub><mi>𝖱𝖾𝖺𝖼𝗁</mi><mi class="ltx_font_mathcaligraphic">𝒞</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>π</mi><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">\mathsf{Reach}_{\mathcal{C}}(\pi)</annotation></semantics></math> be the least subset of <math id="Thmdefinition15.p1.m4" class="ltx_Math" alttext="\mathsf{Win}^{\Box}_{\mathcal{C}}" display="inline" intent=":literal"><semantics><msubsup><mi>𝖶𝗂𝗇</mi><mi class="ltx_font_mathcaligraphic">𝒞</mi><mi mathvariant="normal">□</mi></msubsup><annotation encoding="application/x-tex">\mathsf{Win}^{\Box}_{\mathcal{C}}</annotation></semantics></math> containing
<math id="Thmdefinition15.p1.m5" class="ltx_Math" alttext="x_{0}^{\mathcal{C}}" display="inline" intent=":literal"><semantics><msubsup><mi>x</mi><mn>0</mn><mi class="ltx_font_mathcaligraphic">𝒞</mi></msubsup><annotation encoding="application/x-tex">x_{0}^{\mathcal{C}}</annotation></semantics></math> and closed under admitted <math id="Thmdefinition15.p1.m6" class="ltx_Math" alttext="\pi" display="inline" intent=":literal"><semantics><mi>π</mi><annotation encoding="application/x-tex">\pi</annotation></semantics></math>-successors: if
<math id="Thmdefinition15.p1.m7" class="ltx_Math" alttext="x^{\mathcal{C}}=(s,\bar{q})\in\mathsf{Reach}_{\mathcal{C}}(\pi)" display="inline" intent=":literal"><semantics><mrow><msup><mi>x</mi><mi class="ltx_font_mathcaligraphic">𝒞</mi></msup><mo>=</mo><mrow><mo stretchy="false">(</mo><mi>s</mi><mo>,</mo><mover accent="true"><mi>q</mi><mo>¯</mo></mover><mo stretchy="false">)</mo></mrow><mo>∈</mo><mrow><msub><mi>𝖱𝖾𝖺𝖼𝗁</mi><mi class="ltx_font_mathcaligraphic">𝒞</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>π</mi><mo stretchy="false">)</mo></mrow></mrow></mrow><annotation encoding="application/x-tex">x^{\mathcal{C}}=(s,\bar{q})\in\mathsf{Reach}_{\mathcal{C}}(\pi)</annotation></semantics></math>,
<math id="Thmdefinition15.p1.m8" class="ltx_math_unparsed" alttext="a\in\Supp(\pi(\cdot\mid s))\cap\mathsf{Adm}_{\mathcal{C}}(x^{\mathcal{C}})" display="inline" intent=":literal"><semantics><mrow><mi>a</mi><mo>∈</mo><mi>Supp</mi><mrow><mo stretchy="false">(</mo><mi>π</mi><mrow><mo stretchy="false">(</mo><mo lspace="0em" rspace="0em">⋅</mo><mo lspace="0em" rspace="0.167em">∣</mo><mi>s</mi><mo stretchy="false">)</mo></mrow><mo stretchy="false">)</mo></mrow><mo>∩</mo><msub><mi>𝖠𝖽𝗆</mi><mi class="ltx_font_mathcaligraphic">𝒞</mi></msub><mrow><mo stretchy="false">(</mo><msup><mi>x</mi><mi class="ltx_font_mathcaligraphic">𝒞</mi></msup><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">a\in\Supp(\pi(\cdot\mid s))\cap\mathsf{Adm}_{\mathcal{C}}(x^{\mathcal{C}})</annotation></semantics></math>, and
<math id="Thmdefinition15.p1.m9" class="ltx_Math" alttext="x^{\prime}\in\mathrm{Post}_{\mathcal{C}}(x^{\mathcal{C}},a)" display="inline" intent=":literal"><semantics><mrow><msup><mi>x</mi><mo>′</mo></msup><mo>∈</mo><mrow><msub><mi>Post</mi><mi class="ltx_font_mathcaligraphic">𝒞</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msup><mi>x</mi><mi class="ltx_font_mathcaligraphic">𝒞</mi></msup><mo>,</mo><mi>a</mi><mo stretchy="false">)</mo></mrow></mrow></mrow><annotation encoding="application/x-tex">x^{\prime}\in\mathrm{Post}_{\mathcal{C}}(x^{\mathcal{C}},a)</annotation></semantics></math>, then
<math id="Thmdefinition15.p1.m10" class="ltx_Math" alttext="x^{\prime}\in\mathsf{Reach}_{\mathcal{C}}(\pi)" display="inline" intent=":literal"><semantics><mrow><msup><mi>x</mi><mo>′</mo></msup><mo>∈</mo><mrow><msub><mi>𝖱𝖾𝖺𝖼𝗁</mi><mi class="ltx_font_mathcaligraphic">𝒞</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>π</mi><mo stretchy="false">)</mo></mrow></mrow></mrow><annotation encoding="application/x-tex">x^{\prime}\in\mathsf{Reach}_{\mathcal{C}}(\pi)</annotation></semantics></math>. The policies compatible with <math id="Thmdefinition15.p1.m11" class="ltx_Math" alttext="\mathcal{C}" display="inline" intent=":literal"><semantics><mi class="ltx_font_mathcaligraphic">𝒞</mi><annotation encoding="application/x-tex">\mathcal{C}</annotation></semantics></math> are</p>
<table id="S5.Ex11" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="S5.Ex11.m1" class="ltx_math_unparsed" alttext="\Pi(\mathcal{C})\mathrel{\overset{\mathrm{def}}{=}}\left\{\pi\;\middle|\;\forall x^{\mathcal{C}}=(s,\bar{q})\in\mathsf{Reach}_{\mathcal{C}}(\pi),\ \Supp(\pi(\cdot\mid s))\subseteq\mathsf{Adm}_{\mathcal{C}}(x^{\mathcal{C}})\right\}." display="block" intent=":literal"><semantics><mrow><mi mathvariant="normal">Π</mi><mrow><mo stretchy="false">(</mo><mi class="ltx_font_mathcaligraphic">𝒞</mi><mo stretchy="false">)</mo></mrow><mover accent="true"><mo>=</mo><mo mathsize="0.700em">def</mo></mover><mrow><mo>{</mo><mi>π</mi><mo rspace="0.447em" stretchy="true">|</mo><mo rspace="0.167em">∀</mo><msup><mi>x</mi><mi class="ltx_font_mathcaligraphic">𝒞</mi></msup><mo>=</mo><mrow><mo stretchy="false">(</mo><mi>s</mi><mo>,</mo><mover accent="true"><mi>q</mi><mo>¯</mo></mover><mo stretchy="false">)</mo></mrow><mo>∈</mo><msub><mi>𝖱𝖾𝖺𝖼𝗁</mi><mi class="ltx_font_mathcaligraphic">𝒞</mi></msub><mrow><mo stretchy="false">(</mo><mi>π</mi><mo stretchy="false">)</mo></mrow><mo rspace="0.667em">,</mo><mi>Supp</mi><mrow><mo stretchy="false">(</mo><mi>π</mi><mrow><mo stretchy="false">(</mo><mo lspace="0em" rspace="0em">⋅</mo><mo lspace="0em" rspace="0.167em">∣</mo><mi>s</mi><mo stretchy="false">)</mo></mrow><mo stretchy="false">)</mo></mrow><mo>⊆</mo><msub><mi>𝖠𝖽𝗆</mi><mi class="ltx_font_mathcaligraphic">𝒞</mi></msub><mrow><mo stretchy="false">(</mo><msup><mi>x</mi><mi class="ltx_font_mathcaligraphic">𝒞</mi></msup><mo stretchy="false">)</mo></mrow><mo>}</mo></mrow><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">\Pi(\mathcal{C})\mathrel{\overset{\mathrm{def}}{=}}\left\{\pi\;\middle|\;\forall x^{\mathcal{C}}=(s,\bar{q})\in\mathsf{Reach}_{\mathcal{C}}(\pi),\ \Supp(\pi(\cdot\mid s))\subseteq\mathsf{Adm}_{\mathcal{C}}(x^{\mathcal{C}})\right\}.</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
</div>
</div>
<div id="S5.SS2.p3" class="ltx_para">
<p id="S5.SS2.p3.1" class="ltx_p">For a deterministic Markov policy <math id="S5.SS2.p3.m1" class="ltx_Math" alttext="\pi" display="inline" intent=":literal"><semantics><mi>π</mi><annotation encoding="application/x-tex">\pi</annotation></semantics></math>, write <math id="S5.SS2.p3.m2" class="ltx_Math" alttext="a_{\pi}(s)" display="inline" intent=":literal"><semantics><mrow><msub><mi>a</mi><mi>π</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>s</mi><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">a_{\pi}(s)</annotation></semantics></math> for its unique joint action at state <math id="S5.SS2.p3.m3" class="ltx_Math" alttext="s" display="inline" intent=":literal"><semantics><mi>s</mi><annotation encoding="application/x-tex">s</annotation></semantics></math>. Then <math id="S5.SS2.p3.m4" class="ltx_Math" alttext="\pi\in\Pi(\mathcal{C})" display="inline" intent=":literal"><semantics><mrow><mi>π</mi><mo>∈</mo><mrow><mi mathvariant="normal">Π</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi class="ltx_font_mathcaligraphic">𝒞</mi><mo stretchy="false">)</mo></mrow></mrow></mrow><annotation encoding="application/x-tex">\pi\in\Pi(\mathcal{C})</annotation></semantics></math> iff, for every
<math id="S5.SS2.p3.m5" class="ltx_Math" alttext="x^{\mathcal{C}}=(s,\bar{q})\in\mathsf{Reach}_{\mathcal{C}}(\pi)" display="inline" intent=":literal"><semantics><mrow><msup><mi>x</mi><mi class="ltx_font_mathcaligraphic">𝒞</mi></msup><mo>=</mo><mrow><mo stretchy="false">(</mo><mi>s</mi><mo>,</mo><mover accent="true"><mi>q</mi><mo>¯</mo></mover><mo stretchy="false">)</mo></mrow><mo>∈</mo><mrow><msub><mi>𝖱𝖾𝖺𝖼𝗁</mi><mi class="ltx_font_mathcaligraphic">𝒞</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>π</mi><mo stretchy="false">)</mo></mrow></mrow></mrow><annotation encoding="application/x-tex">x^{\mathcal{C}}=(s,\bar{q})\in\mathsf{Reach}_{\mathcal{C}}(\pi)</annotation></semantics></math>, we have
<math id="S5.SS2.p3.m6" class="ltx_Math" alttext="a_{\pi}(s)\in\mathsf{Adm}_{\mathcal{C}}(x^{\mathcal{C}})." display="inline" intent=":literal"><semantics><mrow><mrow><mrow><msub><mi>a</mi><mi>π</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>s</mi><mo stretchy="false">)</mo></mrow></mrow><mo>∈</mo><mrow><msub><mi>𝖠𝖽𝗆</mi><mi class="ltx_font_mathcaligraphic">𝒞</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msup><mi>x</mi><mi class="ltx_font_mathcaligraphic">𝒞</mi></msup><mo stretchy="false">)</mo></mrow></mrow></mrow><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">a_{\pi}(s)\in\mathsf{Adm}_{\mathcal{C}}(x^{\mathcal{C}}).</annotation></semantics></math>
Equivalently, each local action <math id="S5.SS2.p3.m7" class="ltx_Math" alttext="a^{i}_{\pi}(s)" display="inline" intent=":literal"><semantics><mrow><msubsup><mi>a</mi><mi>π</mi><mi>i</mi></msubsup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>s</mi><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">a^{i}_{\pi}(s)</annotation></semantics></math> lies in the deployed local mask
<math id="S5.SS2.p3.m8" class="ltx_Math" alttext="\mathcal{M}_{\mathord{\raisebox{-0.2411pt}{\mbox{\hbox to3.22pt{\vbox to4.3pt{\pgfpicture\makeatletter\hbox{\hskip 1.60818pt\lower-2.23749pt\hbox to0.0pt{\lxSVG@begingroup@{_scopebegin=1} \lxSVG@begingroup@{stroke=#000000} \lxSVG@begingroup@{fill=#000000} \lxSVG@setlinewidth{\the\pgflinewidth}\lxSVG@begingroup@{stroke-width=0.4pt} \lx@inpgf@ignorespaces\nullfont\hbox to0.0pt{\lxSVG@begingroup@{_scopebegin=1} {\lx@inpgf@ignorespaces}\lx@inpgf@ignorespaces{\lx@inpgf@ignorespaces}\lx@inpgf@ignorespaces{{}{{}}{}
{}{}
{}{}{{}}{}{{}}{}{}{}{{}}{}{{}}{}{}{}
{}{}
{\lx@inpgf@ignorespaces}\lxSVG@begingroup@{_scopebegin=1} \lxSVG@begingroup@{fill=#5C6269} \lxSVG@fill\lxSVG@drawpath@unclipped{M 0 2.85 L 2.23 1.89 L 1.74 -0.24 C 1.35 -1.79 0.44 -2.66 0 -3.1 C -0.44 -2.66 -1.35 -1.79 -1.74 -0.24 L -2.23 1.89 Z}{stroke:none} \lx@inpgf@ignorespaces
\lxSVG@closescope }
\lxSVG@closescope {\lx@inpgf@ignorespaces}{\lx@inpgf@ignorespaces}{\lx@inpgf@ignorespaces}\hss}\lxSVG@discardpath\lxSVG@closescope \hss}}\lxSVG@closescope\endpgfpicture}}}}}}^{\mathcal{C},i}(x^{\mathcal{C}})" display="inline" intent=":literal"><semantics><mrow><msubsup><mi class="ltx_font_mathcaligraphic">ℳ</mi><mpadded voffset="-0.2pt"><mtext> <svg style="vertical-align:-1.01px" height="5.95" overflow="visible" version="1.1" viewBox="0 0 4.45 5.95" width="4.45"> <g style="--ltx-stroke-color:#000000;--ltx-fill-color:#5C6269;" fill="#5C6269" stroke="#000000" stroke-width="0.4pt" transform="translate(0,5.95) matrix(1 0 0 -1 0 0) translate(2.23,0) translate(0,3.1)"> <path style="stroke:none" d="M 0 2.85 L 2.23 1.89 L 1.74 -0.24 C 1.35 -1.79 0.44 -2.66 0 -3.1 C -0.44 -2.66 -1.35 -1.79 -1.74 -0.24 L -2.23 1.89 Z"></path> </g> </svg> </mtext></mpadded><mrow><mi class="ltx_font_mathcaligraphic">𝒞</mi><mo>,</mo><mi>i</mi></mrow></msubsup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msup><mi>x</mi><mi class="ltx_font_mathcaligraphic">𝒞</mi></msup><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">\mathcal{M}_{\mathord{\raisebox{-0.2411pt}{\mbox{\hbox to3.22pt{\vbox to4.3pt{\pgfpicture\makeatletter\hbox{\hskip 1.60818pt\lower-2.23749pt\hbox to0.0pt{\lxSVG@begingroup@{_scopebegin=1} \lxSVG@begingroup@{stroke=#000000} \lxSVG@begingroup@{fill=#000000} \lxSVG@setlinewidth{\the\pgflinewidth}\lxSVG@begingroup@{stroke-width=0.4pt} \lx@inpgf@ignorespaces\nullfont\hbox to0.0pt{\lxSVG@begingroup@{_scopebegin=1} {\lx@inpgf@ignorespaces}\lx@inpgf@ignorespaces{\lx@inpgf@ignorespaces}\lx@inpgf@ignorespaces{{}{{}}{}
{}{}
{}{}{{}}{}{{}}{}{}{}{{}}{}{{}}{}{}{}
{}{}
{\lx@inpgf@ignorespaces}\lxSVG@begingroup@{_scopebegin=1} \lxSVG@begingroup@{fill=#5C6269} \lxSVG@fill\lxSVG@drawpath@unclipped{M 0 2.85 L 2.23 1.89 L 1.74 -0.24 C 1.35 -1.79 0.44 -2.66 0 -3.1 C -0.44 -2.66 -1.35 -1.79 -1.74 -0.24 L -2.23 1.89 Z}{stroke:none} \lx@inpgf@ignorespaces
\lxSVG@closescope }
\lxSVG@closescope {\lx@inpgf@ignorespaces}{\lx@inpgf@ignorespaces}{\lx@inpgf@ignorespaces}\hss}\lxSVG@discardpath\lxSVG@closescope \hss}}\lxSVG@closescope\endpgfpicture}}}}}}^{\mathcal{C},i}(x^{\mathcal{C}})</annotation></semantics></math> at every reachable contract-product state.</p>
</div>
<div id="S5.Thmtheorem1" class="ltx_theorem ltx_theorem_theorem">
<h6 class="ltx_title ltx_runin ltx_title_theorem"><span class="ltx_tag ltx_tag_theorem"><span id="S5.Thmtheorem1.2" class="ltx_text ltx_font_bold">Theorem 5.1</span></span><span id="S5.Thmtheorem1.3" class="ltx_text ltx_font_bold"> (Optimal Safe Recovery (restated))</span></h6>
<div id="S5.Thmtheorem1.p1" class="ltx_para">
<p id="S5.Thmtheorem1.p1.1" class="ltx_p"><span id="S5.Thmtheorem1.p1.1.1" class="ltx_text ltx_font_italic">Let <math id="S5.Thmtheorem1.p1.m1" class="ltx_Math" alttext="\mathcal{L}_{\mathsf{cert}}" display="inline" intent=":literal"><semantics><msub><mi class="ltx_font_mathcaligraphic">ℒ</mi><mi>𝖼𝖾𝗋𝗍</mi></msub><annotation encoding="application/x-tex">\mathcal{L}_{\mathsf{cert}}</annotation></semantics></math> be a certified library, and let
<math id="S5.Thmtheorem1.p1.m2" class="ltx_Math" alttext="\pi^{\star}\in\arg\max_{\pi\in\Pi_{\mathsf{safe}}}J_{s_{0}}(\pi)" display="inline" intent=":literal"><semantics><mrow><msup><mi>π</mi><mo>⋆</mo></msup><mo>∈</mo><mrow><mrow><mi>arg</mi><mo lspace="0.167em">⁡</mo><msub><mi>max</mi><mrow><mi>π</mi><mo>∈</mo><msub><mi mathvariant="normal">Π</mi><mi>𝗌𝖺𝖿𝖾</mi></msub></mrow></msub></mrow><mo lspace="0.167em" rspace="0em">​</mo><msub><mi>J</mi><msub><mi>s</mi><mn>0</mn></msub></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>π</mi><mo stretchy="false">)</mo></mrow></mrow></mrow><annotation encoding="application/x-tex">\pi^{\star}\in\arg\max_{\pi\in\Pi_{\mathsf{safe}}}J_{s_{0}}(\pi)</annotation></semantics></math> be a
deterministic Markov policy. If some <math id="S5.Thmtheorem1.p1.m3" class="ltx_Math" alttext="\mathcal{C}^{\star}\in\mathcal{L}_{\mathsf{cert}}" display="inline" intent=":literal"><semantics><mrow><msup><mi class="ltx_font_mathcaligraphic">𝒞</mi><mo>⋆</mo></msup><mo>∈</mo><msub><mi class="ltx_font_mathcaligraphic">ℒ</mi><mi>𝖼𝖾𝗋𝗍</mi></msub></mrow><annotation encoding="application/x-tex">\mathcal{C}^{\star}\in\mathcal{L}_{\mathsf{cert}}</annotation></semantics></math> satisfies <math id="S5.Thmtheorem1.p1.m4" class="ltx_Math" alttext="\pi^{\star}\in\Pi(\mathcal{C}^{\star})" display="inline" intent=":literal"><semantics><mrow><msup><mi>π</mi><mo>⋆</mo></msup><mo>∈</mo><mrow><mi mathvariant="normal">Π</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><msup><mi class="ltx_font_mathcaligraphic">𝒞</mi><mo>⋆</mo></msup><mo stretchy="false">)</mo></mrow></mrow></mrow><annotation encoding="application/x-tex">\pi^{\star}\in\Pi(\mathcal{C}^{\star})</annotation></semantics></math>, then
<math id="S5.Thmtheorem1.p1.m5" class="ltx_math_unparsed" alttext="\max\left\{J_{s_{0}}(\pi)\;\middle|\;\mathcal{C}\in\mathcal{L}_{\mathsf{cert}},\ \pi\in\Pi(\mathcal{C})\right\}=J_{s_{0}}(\pi^{\star})." display="inline" intent=":literal"><semantics><mrow><mi>max</mi><mrow><mo>{</mo><msub><mi>J</mi><msub><mi>s</mi><mn>0</mn></msub></msub><mrow><mo stretchy="false">(</mo><mi>π</mi><mo stretchy="false">)</mo></mrow><mo stretchy="true">|</mo><mi class="ltx_font_mathcaligraphic">𝒞</mi><mo>∈</mo><msub><mi class="ltx_font_mathcaligraphic">ℒ</mi><mi>𝖼𝖾𝗋𝗍</mi></msub><mo rspace="0.667em">,</mo><mi>π</mi><mo>∈</mo><mi mathvariant="normal">Π</mi><mrow><mo stretchy="false">(</mo><mi class="ltx_font_mathcaligraphic">𝒞</mi><mo stretchy="false">)</mo></mrow><mo>}</mo></mrow><mo>=</mo><msub><mi>J</mi><msub><mi>s</mi><mn>0</mn></msub></msub><mrow><mo stretchy="false">(</mo><msup><mi>π</mi><mo>⋆</mo></msup><mo stretchy="false">)</mo></mrow><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">\max\left\{J_{s_{0}}(\pi)\;\middle|\;\mathcal{C}\in\mathcal{L}_{\mathsf{cert}},\ \pi\in\Pi(\mathcal{C})\right\}=J_{s_{0}}(\pi^{\star}).</annotation></semantics></math>
Equivalently, when empty inner feasible sets are ignored,</span></p>
<table id="S5.Ex12" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="S5.Ex12.m1" class="ltx_Math" alttext="\max_{\mathcal{C}\in\mathcal{L}_{\mathsf{cert}}}\max_{\pi\in\Pi(\mathcal{C})}J_{s_{0}}(\pi)=J_{s_{0}}(\pi^{\star})." display="block" intent=":literal"><semantics><mrow><mrow><mrow><mrow><munder><mi>max</mi><mrow><mi class="ltx_font_mathcaligraphic">𝒞</mi><mo>∈</mo><msub><mi class="ltx_font_mathcaligraphic">ℒ</mi><mi>𝖼𝖾𝗋𝗍</mi></msub></mrow></munder><mo lspace="0.167em">⁡</mo><munder><mi>max</mi><mrow><mi>π</mi><mo>∈</mo><mrow><mi mathvariant="normal">Π</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi class="ltx_font_mathcaligraphic">𝒞</mi><mo stretchy="false">)</mo></mrow></mrow></mrow></munder></mrow><mo lspace="0.167em" rspace="0em">​</mo><msub><mi>J</mi><msub><mi>s</mi><mn>0</mn></msub></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>π</mi><mo stretchy="false">)</mo></mrow></mrow><mo>=</mo><mrow><msub><mi>J</mi><msub><mi>s</mi><mn>0</mn></msub></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msup><mi>π</mi><mo>⋆</mo></msup><mo stretchy="false">)</mo></mrow></mrow></mrow><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">\max_{\mathcal{C}\in\mathcal{L}_{\mathsf{cert}}}\max_{\pi\in\Pi(\mathcal{C})}J_{s_{0}}(\pi)=J_{s_{0}}(\pi^{\star}).</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
</div>
</div>
<div id="S5.SS2.p4" class="ltx_para">
<p id="S5.SS2.p4.1" class="ltx_p">The proof is available in Appendix <a href="#Pt0.A2.SS2" title="0.B.2 Proof of Theorem 2. Optimal Safe Recovery ‣ Appendix 0.B Technical Results ‣ Contract-Based Compositional Shielding for Safe Multi-Agent Reinforcement Learning" class="ltx_ref"><span class="ltx_text ltx_ref_tag">0.B.2</span></a>. In particular, suppose <math id="S5.SS2.p4.m1" class="ltx_Math" alttext="\pi^{\star}" display="inline" intent=":literal"><semantics><msup><mi>π</mi><mo>⋆</mo></msup><annotation encoding="application/x-tex">\pi^{\star}</annotation></semantics></math> is a deterministic Markov optimum in <math id="S5.SS2.p4.m2" class="ltx_Math" alttext="\Pi_{\mathsf{safe}}" display="inline" intent=":literal"><semantics><msub><mi mathvariant="normal">Π</mi><mi>𝗌𝖺𝖿𝖾</mi></msub><annotation encoding="application/x-tex">\Pi_{\mathsf{safe}}</annotation></semantics></math>, the local alphabets are action-separating (e.g. by folding the last action into the state or using a non-Markovian labelling function) for <math id="S5.SS2.p4.m3" class="ltx_Math" alttext="\pi^{\star}" display="inline" intent=":literal"><semantics><msup><mi>π</mi><mo>⋆</mo></msup><annotation encoding="application/x-tex">\pi^{\star}</annotation></semantics></math>, and the depth bound <math id="S5.SS2.p4.m4" class="ltx_Math" alttext="D" display="inline" intent=":literal"><semantics><mi>D</mi><annotation encoding="application/x-tex">D</annotation></semantics></math> and candidate family are rich enough that <math id="S5.SS2.p4.m5" class="ltx_Math" alttext="\mathcal{L}_{\mathsf{cert}}" display="inline" intent=":literal"><semantics><msub><mi class="ltx_font_mathcaligraphic">ℒ</mi><mi>𝖼𝖾𝗋𝗍</mi></msub><annotation encoding="application/x-tex">\mathcal{L}_{\mathsf{cert}}</annotation></semantics></math> contains a certified contract <math id="S5.SS2.p4.m6" class="ltx_Math" alttext="\mathcal{C}^{\star}" display="inline" intent=":literal"><semantics><msup><mi class="ltx_font_mathcaligraphic">𝒞</mi><mo>⋆</mo></msup><annotation encoding="application/x-tex">\mathcal{C}^{\star}</annotation></semantics></math> with</p>
<table id="S5.Ex13" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="S5.Ex13.m1" class="ltx_Math" alttext="\mathcal{M}_{\mathord{\raisebox{-0.2411pt}{\mbox{\hbox to3.22pt{\vbox to4.3pt{\pgfpicture\makeatletter\hbox{\hskip 1.60818pt\lower-2.23749pt\hbox to0.0pt{\lxSVG@begingroup@{_scopebegin=1} \lxSVG@begingroup@{stroke=#000000} \lxSVG@begingroup@{fill=#000000} \lxSVG@setlinewidth{\the\pgflinewidth}\lxSVG@begingroup@{stroke-width=0.4pt} \lx@inpgf@ignorespaces\nullfont\hbox to0.0pt{\lxSVG@begingroup@{_scopebegin=1} {\lx@inpgf@ignorespaces}\lx@inpgf@ignorespaces{\lx@inpgf@ignorespaces}\lx@inpgf@ignorespaces{{}{{}}{}
{}{}
{}{}{{}}{}{{}}{}{}{}{{}}{}{{}}{}{}{}
{}{}
{\lx@inpgf@ignorespaces}\lxSVG@begingroup@{_scopebegin=1} \lxSVG@begingroup@{fill=#5C6269} \lxSVG@fill\lxSVG@drawpath@unclipped{M 0 2.85 L 2.23 1.89 L 1.74 -0.24 C 1.35 -1.79 0.44 -2.66 0 -3.1 C -0.44 -2.66 -1.35 -1.79 -1.74 -0.24 L -2.23 1.89 Z}{stroke:none} \lx@inpgf@ignorespaces
\lxSVG@closescope }
\lxSVG@closescope {\lx@inpgf@ignorespaces}{\lx@inpgf@ignorespaces}{\lx@inpgf@ignorespaces}\hss}\lxSVG@discardpath\lxSVG@closescope \hss}}\lxSVG@closescope\endpgfpicture}}}}}}^{\mathcal{C},i}(x^{\mathcal{C}^{\star}})=\{a^{i}_{\pi^{\star}}(s)\}\qquad\text{for every reachable }x^{\mathcal{C}^{\star}}=(s,\bar{q})\text{ and every }i\in\mathsf{Ag}," display="block" intent=":literal"><semantics><mrow><mrow><mrow><mrow><msubsup><mi class="ltx_font_mathcaligraphic">ℳ</mi><mpadded voffset="-0.2pt"><mtext> <svg style="vertical-align:-1.01px" height="5.95" overflow="visible" version="1.1" viewBox="0 0 4.45 5.95" width="4.45"> <g style="--ltx-stroke-color:#000000;--ltx-fill-color:#5C6269;" fill="#5C6269" stroke="#000000" stroke-width="0.4pt" transform="translate(0,5.95) matrix(1 0 0 -1 0 0) translate(2.23,0) translate(0,3.1)"> <path style="stroke:none" d="M 0 2.85 L 2.23 1.89 L 1.74 -0.24 C 1.35 -1.79 0.44 -2.66 0 -3.1 C -0.44 -2.66 -1.35 -1.79 -1.74 -0.24 L -2.23 1.89 Z"></path> </g> </svg> </mtext></mpadded><mrow><mi class="ltx_font_mathcaligraphic">𝒞</mi><mo>,</mo><mi>i</mi></mrow></msubsup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msup><mi>x</mi><msup><mi class="ltx_font_mathcaligraphic">𝒞</mi><mo>⋆</mo></msup></msup><mo stretchy="false">)</mo></mrow></mrow><mo>=</mo><mrow><mo stretchy="false">{</mo><mrow><msubsup><mi>a</mi><msup><mi>π</mi><mo>⋆</mo></msup><mi>i</mi></msubsup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>s</mi><mo stretchy="false">)</mo></mrow></mrow><mo stretchy="false">}</mo></mrow></mrow><mspace style="width:2em;" width="2em"></mspace><mrow><mrow><mtext>for every reachable </mtext><mo lspace="0em" rspace="0em">​</mo><msup><mi>x</mi><msup><mi class="ltx_font_mathcaligraphic">𝒞</mi><mo>⋆</mo></msup></msup></mrow><mo>=</mo><mrow><mrow><mo stretchy="false">(</mo><mi>s</mi><mo>,</mo><mover accent="true"><mi>q</mi><mo>¯</mo></mover><mo stretchy="false">)</mo></mrow><mo lspace="0em" rspace="0em">​</mo><mtext> and every </mtext><mo lspace="0em" rspace="0em">​</mo><mi>i</mi></mrow><mo>∈</mo><mi>𝖠𝗀</mi></mrow></mrow><mo>,</mo></mrow><annotation encoding="application/x-tex">\mathcal{M}_{\mathord{\raisebox{-0.2411pt}{\mbox{\hbox to3.22pt{\vbox to4.3pt{\pgfpicture\makeatletter\hbox{\hskip 1.60818pt\lower-2.23749pt\hbox to0.0pt{\lxSVG@begingroup@{_scopebegin=1} \lxSVG@begingroup@{stroke=#000000} \lxSVG@begingroup@{fill=#000000} \lxSVG@setlinewidth{\the\pgflinewidth}\lxSVG@begingroup@{stroke-width=0.4pt} \lx@inpgf@ignorespaces\nullfont\hbox to0.0pt{\lxSVG@begingroup@{_scopebegin=1} {\lx@inpgf@ignorespaces}\lx@inpgf@ignorespaces{\lx@inpgf@ignorespaces}\lx@inpgf@ignorespaces{{}{{}}{}
{}{}
