<span id="Pt0.A6.T7.2.1.1.1.1.1.1.2.3" class="ltx_td ltx_nopad_r ltx_align_left ltx_border_t" style="padding:0.2pt 3.0pt;"><span id="Pt0.A6.T7.2.1.1.1.1.1.1.2.3.1" class="ltx_text" style="--ltx-bg-color:#FFFFFF;">two hidden layers, width <math id="Pt0.A6.T7.m2" class="ltx_Math" alttext="256" display="inline" intent=":literal"><semantics><mn style="--ltx-bg-color:#FFFFFF;" mathbackground="#FFFFFF">256</mn><annotation encoding="application/x-tex">256</annotation></semantics></math>, <span id="Pt0.A6.T7.2.1.1.1.1.1.1.2.3.1.1" class="ltx_text ltx_font_typewriter">relu</span></span></span></span>
<span id="Pt0.A6.T7.2.1.1.1.1.1.1.3" class="ltx_tr" style="--ltx-bg-color:#F7F7F7;">
<span id="Pt0.A6.T7.2.1.1.1.1.1.1.3.1" class="ltx_td ltx_align_left" style="padding:0.2pt 3.0pt;"><span id="Pt0.A6.T7.2.1.1.1.1.1.1.3.1.1" class="ltx_text" style="--ltx-bg-color:#F7F7F7;">Normalisation</span></span>
<span id="Pt0.A6.T7.2.1.1.1.1.1.1.3.2" class="ltx_td ltx_align_left" style="padding:0.2pt 3.0pt;"><span id="Pt0.A6.T7.2.1.1.1.1.1.1.3.2.1" class="ltx_text" style="--ltx-bg-color:#F7F7F7;">none</span></span>
<span id="Pt0.A6.T7.2.1.1.1.1.1.1.3.3" class="ltx_td ltx_nopad_r ltx_align_left" style="padding:0.2pt 3.0pt;"><span id="Pt0.A6.T7.2.1.1.1.1.1.1.3.3.1" class="ltx_text" style="--ltx-bg-color:#F7F7F7;">layer normalisation</span></span></span>
<span id="Pt0.A6.T7.2.1.1.1.1.1.1.4" class="ltx_tr" style="--ltx-bg-color:#FFFFFF;">
<span id="Pt0.A6.T7.2.1.1.1.1.1.1.4.1" class="ltx_td ltx_align_left" style="padding:0.2pt 3.0pt;"><span id="Pt0.A6.T7.2.1.1.1.1.1.1.4.1.1" class="ltx_text" style="--ltx-bg-color:#FFFFFF;">Update epochs</span></span>
<span id="Pt0.A6.T7.2.1.1.1.1.1.1.4.2" class="ltx_td ltx_align_left" style="padding:0.2pt 3.0pt;"><math id="Pt0.A6.T7.m3" class="ltx_Math" style="--ltx-bg-color:#FFFFFF;" alttext="4" display="inline" intent=":literal"><semantics><mn style="--ltx-bg-color:#FFFFFF;" mathbackground="#FFFFFF">4</mn><annotation encoding="application/x-tex">4</annotation></semantics></math></span>
<span id="Pt0.A6.T7.2.1.1.1.1.1.1.4.3" class="ltx_td ltx_nopad_r ltx_align_left" style="padding:0.2pt 3.0pt;"><math id="Pt0.A6.T7.m4" class="ltx_Math" style="--ltx-bg-color:#FFFFFF;" alttext="4" display="inline" intent=":literal"><semantics><mn style="--ltx-bg-color:#FFFFFF;" mathbackground="#FFFFFF">4</mn><annotation encoding="application/x-tex">4</annotation></semantics></math></span></span>
