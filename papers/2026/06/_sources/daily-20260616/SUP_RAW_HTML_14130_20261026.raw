<span id="Pt0.A4.T1.2.1.1.1" class="ltx_inline-block ltx_transformed_outer" style="width:473.6pt;height:124.3pt;vertical-align:-60.4pt;"><span class="ltx_transformed_inner" style="transform:translate(0.0pt,0.0pt) scale(1,1) ;">
