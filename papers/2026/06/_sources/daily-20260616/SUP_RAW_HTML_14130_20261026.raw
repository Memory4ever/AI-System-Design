<span id="Pt0.A4.T1.2.1.1.1.1.1.1.2.1.1" class="ltx_inline-block ltx_align_top" style="width:58.7pt;--ltx-bg-color:#FFFFFF;">
<span id="Pt0.A4.T1.2.1.1.1.1.1.1.2.1.1.1" class="ltx_p ltx_align_left"><span id="Pt0.A4.T1.2.1.1.1.1.1.1.2.1.1.1.1" class="ltx_text ltx_font_smallcaps">Car Platoon</span></span>
</span></span>
