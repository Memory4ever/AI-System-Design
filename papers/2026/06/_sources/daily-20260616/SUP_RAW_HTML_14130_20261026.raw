<span id="Pt0.A4.T1.p1.1.2.1.1.1" class="ltx_td ltx_nopad_r ltx_align_center" style="padding:0.6pt 2.0pt;">Safety <math id="Pt0.A4.T1.p1.m1" class="ltx_Math" alttext="\mathsf{LTL}_{\mathsf{safe}}" display="inline" intent=":literal"><semantics><msub><mi style="--ltx-bg-color:#FFFFFF;" mathbackground="#FFFFFF">𝖫𝖳𝖫</mi><mi style="--ltx-bg-color:#FFFFFF;" mathbackground="#FFFFFF">𝗌𝖺𝖿𝖾</mi></msub><annotation encoding="application/x-tex">\mathsf{LTL}_{\mathsf{safe}}</annotation></semantics></math></span></span>
