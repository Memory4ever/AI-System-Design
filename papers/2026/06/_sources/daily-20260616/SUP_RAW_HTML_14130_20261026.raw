<span id="Pt0.A3.F5.3.1.3" class="ltx_inline-logical-block ltx_parbox ltx_align_top" style="width:134.6pt;">
<span id="Pt0.A3.F5.p1" class="ltx_para ltx_noindent ltx_align_center">
<span id="Pt0.A3.F5.p1.1" class="ltx_p"><span id="Pt0.A3.F5.p1.1.1" class="ltx_text">
<span id="Pt0.A3.F5.p1.1.1.1" class="ltx_inline-block ltx_transformed_outer" style="width:134.6pt;height:40.6pt;vertical-align:-0.0pt;"><span class="ltx_transformed_inner" style="transform:translate(-10.2pt,3.1pt) scale(0.9,0.9) ;">
<span id="Pt0.A3.F5.p1.1.1.1.1" class="ltx_p"><span id="Pt0.A3.F5.p1.1.1.1.1.1" class="ltx_text">
