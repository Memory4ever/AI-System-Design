<span id="Pt0.A6.T7.2.1.1.1.1.1.1.6.3" class="ltx_td ltx_nopad_r ltx_align_left" style="padding:0.2pt 3.0pt;"><span id="Pt0.A6.T7.2.1.1.1.1.1.1.6.3.1" class="ltx_text" style="--ltx-bg-color:#FFFFFF;">immediate</span></span></span>
