:#DC8036;--ltx-fill-color:#DC8036;" fill="#DC8036" stroke="#DC8036" transform="matrix(1.0 0.0 0.0 1.0 6.57 28.03)"><foreignObject style="--ltx-fo-width:0.5em;--ltx-fo-height:0.48em;--ltx-fo-depth:0em;font-size:11.75pt;" height="7.73" overflow="visible" transform="matrix(1 0 0 -1 0 7.73)" width="8.13"><span class="ltx_foreignobject_container"><span class="ltx_foreignobject_content"><math id="S1.F1.pic6.m7" class="ltx_Math" alttext="\star" display="inline" intent=":literal"><semantics><mo style="--ltx-fg-color:#DC8036;" mathcolor="#DC8036" mathsize="1.200em">⋆</mo><annotation encoding="application/x-tex">\star</annotation></semantics></math></span></span></foreignObject></g><g style="--ltx-stroke-color:#000000;--ltx-fill-color:#000000;" fill="#000000" stroke="#000000" transform="matrix(1.0 0.0 0.0 1.0 6.01 7.29)"><foreignObject style="--ltx-fo-width:0.84em;--ltx-fo-height:0.6em;--ltx-fo-depth:0em;font-size:7.97pt;" height="6.67" overflow="visible" transform="matrix(1 0 0 -1 0 6.67)" width="9.24"><span class="ltx_foreignobject_container"><span class="ltx_foreignobject_content"><span id="S1.F1.pic6.1" class="ltx_text" style="font-size:70%;">✓</span></span></span></foreignObject></g><g style="--ltx-stroke-color:#000000;--ltx-fill-color:#000000;" fill="#000000" stroke="#000000" transform="matrix(1.0 0.0 0.0 1.0 27.27 7.29)"><foreignObject style="--ltx-fo-width:0.84em;--ltx-fo-height:0.6em;--ltx-fo-depth:0em;font-size:7.97pt;" height="6.67" overflow="visible" transform="matrix(1 0 0 -1 0 6.67)" width="9.24"><span class="ltx_foreignobject_container"><span class="ltx_foreignobject_content"><span id="S1.F1.pic6.2" class="ltx_text" style="font-size:70%;">✓</span></span></span></foreignObject></g><g style="--ltx-stroke-color:#000000;--ltx-fill-color:#000000;" fill="#000000" stroke="#000000" transform="matrix(1.0 0.0 0.0 1.0 27.57 29.47)"><foreignObject style="--ltx-fo-width:0.76em;--ltx-fo-height:0.53em;--ltx-fo-depth:0.1em;font-size:8.19pt;" height="7.15" overflow="visible" transform="matrix(1 0 0 -1 0 6)" width="8.65"><span class="ltx_foreignobject_container"><span class="ltx_foreignobject_content"><math id="S1.F1.pic6.m8" class="ltx_Math" alttext="\times" display="inline" intent=":literal"><semantics><mo mathsize="0.700em">×</mo><annotation encoding="application/x-tex">\times</annotation></semantics></math></span></span></foreignObject></g></g></svg></span></span></span>
<span id="S1.F1.3.1.1.1.1.1.3" class="ltx_tr">
<span id="S1.F1.3.1.1.1.1.1.3.1" class="ltx_td ltx_align_center">
<span id="S1.F1.3.1.1.1.1.1.3.1.1" class="ltx_inline-block ltx_minipage ltx_align_top" style="width:89.7pt;">
<span id="S1.F1.3.1.1.1.1.1.3.1.1.1" class="ltx_p ltx_align_center"><math id="S1.F1.m3" class="ltx_Math" alttext="\mathsf{Safe}(x)\mathrel{\overset{\mathrm{def}}{=}}\{(0,0),(1,0),(0,1)\}" display="inline" intent=":literal"><semantics><mrow><mrow><mi mathsize="0.700em">𝖲𝖺𝖿𝖾</mi><mo>⁡</mo><mrow><mo maxsize="0.700em" minsize="0.700em">(</mo><mi mathsize="0.700em">x</mi><mo maxsize="0.700em" minsize="0.700em">)</mo></mrow></mrow><mover accent="true"><mo mathsize="0.700em">=</mo><mo mathsize="0.490em">def</mo></mover><mrow><mo stretchy="false">{</mo><mrow><mo maxsize="0.700em" minsize="0.700em">(</mo><mn mathsize="0.700em">0</mn><mo mathsize="0.700em">,</mo><mn mathsize="0.700em">0</mn><mo maxsize="0.700em" minsize="0.700em">)</mo></mrow><mo mathsize="0.700em">,</mo><mrow><mo maxsize="0.700em" minsize="0.700em">(</mo><mn mathsize="0.700em">1</mn><mo mathsize="0.700em">,</mo><mn mathsize="0.700em">0</mn><mo maxsize="0.700em" minsize="0.700em">)</mo></mrow><mo mathsize="0.700em">,</mo><mrow><mo maxsize="0.700em" minsize="0.700em">(</mo><mn mathsize="0.700em">0</mn><mo mathsize="0.700em">,</mo><mn mathsize="0.700em">1</mn><mo maxsize="0.700em" minsize="0.700em">)</mo></mrow><mo stretchy="false">}</mo></mrow></mrow><annotation encoding="application/x-tex">\mathsf{Safe}(x)\mathrel{\overset{\mathrm{def}}{=}}\{(0,0),(1,0),(0,1)\}</annotation></semantics></math><span id="S1.F1.3.1.1.1.1.1.3.1.1.1.1" class="ltx_text" style="font-size:70%;">.</span></span>
</span>   </span>
<span id="S1.F1.3.1.1.1.1.1.3.2" class="ltx_td ltx_align_right">
<span id="S1.F1.3.1.1.1.1.1.3.2.1" class="ltx_inline-block ltx_minipage ltx_align_top" style="width:89.7pt;">
<span id="S1.F1.3.1.1.1.1.1.3.2.1.1" class="ltx_p ltx_align_center"><math id="S1.F1.m4" class="ltx_Math" alttext="\mathsf{Safe}_{1}(x)\times\mathsf{Safe}_{2}(x)=\{(0,0)\}" display="inline" intent=":literal"><semantics><mrow><mrow><mrow><mrow><msub><mi mathsize="0.700em">𝖲𝖺𝖿𝖾</mi><mn mathsize="0.700em">1</mn></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo maxsize="0.700em" minsize="0.700em">(</mo><mi mathsize="0.700em">x</mi><mo maxsize="0.700em" minsize="0.700em" rspace="0.055em">)</mo></mrow></mrow><mo mathsize="0.700em" rspace="0.222em">×</mo><msub><mi mathsize="0.700em">𝖲𝖺𝖿𝖾</mi><mn mathsize="0.700em">2</mn></msub></mrow><mo lspace="0em" rspace="0em">​</mo><mrow><mo maxsize="0.700em" minsize="0.700em">(</mo><mi mathsize="0.700em">x</mi><mo maxsize="0.700em" minsize="0.700em">)</mo></mrow></mrow><mo mathsize="0.700em">=</mo><mrow><mo stretchy="false">{</mo><mrow><mo maxsize="0.700em" minsize="0.700em">(</mo><mn mathsize="0.700em">0</mn><mo mathsize="0.700em">,</mo><mn mathsize="0.700em">0</mn><mo maxsize="0.700em" minsize="0.700em">)</mo></mrow><mo stretchy="false">}</mo></mrow></mrow><annotation encoding="application/x-tex">\mathsf{Safe}_{1}(x)\times\mathsf{Safe}_{2}(x)=\{(0,0)\}</annotation></semantics></math><span id="S1.F1.3.1.1.1.1.1.3.2.1.1.1" class="ltx_text" style="font-size:70%;">.</span></span>
</span>   </span>
<span id="S1.F1.3.1.1.1.1.1.3.3" class="ltx_td ltx_nopad_r ltx_align_center">
<span id="S1.F1.3.1.1.1.1.1.3.3.1" class="ltx_inline-block ltx_minipage ltx_align_top" style="width:89.7pt;">
<span id="S1.F1.3.1.1.1.1.1.3.3.1.1" class="ltx_p ltx_align_center"><math id="S1.F1.m5" class="ltx_Math" alttext="\varphi_{2}:\mathsf{Always}(p_{2}=0)" display="inline" intent=":literal"><semantics><mrow><msub><mi mathsize="0.700em">φ</mi><mn mathsize="0.700em">2</mn></msub><mo lspace="0.278em" mathsize="0.700em" rspace="0.278em">:</mo><mrow><mi mathsize="0.700em">𝖠𝗅𝗐𝖺𝗒𝗌</mi><mo>⁡</mo><mrow><mo maxsize="0.700em" minsize="0.700em">(</mo><mrow><msub><mi mathsize="0.700em">p</mi><mn mathsize="0.700em">2</mn></msub><mo mathsize="0.700em">=</mo><mn mathsize="0.700em">0</mn></mrow><mo maxsize="0.700em" minsize="0.700em">)</mo></mrow></mrow></mrow><annotation encoding="application/x-tex">\varphi_{2}:\mathsf{Always}(p_{2}=0)</annotation></semantics></math><span id="S1.F1.3.1.1.1.1.1.3.3.1.1.1" class="ltx_text" style="font-size:70%;"> permits <math id="S1.F1.m6" class="ltx_Math" alttext="1\in S_{1}^{C}(x)" display="inline" intent=":literal"><semantics><mrow><mn>1</mn><mo>∈</mo><mrow><msubsup><mi>S</mi><mn>1</mn><mi>C</mi></msubsup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>x</mi><mo stretchy="false">)</mo></mrow></mrow></mrow><annotation encoding="application/x-tex">1\in S_{1}^{C}(x)</annotation></semantics></math>.</span></span>
</span></span></span>
</span></span></span>
</span></span></span></p></div></div>
<figcaption class="ltx_caption"><span class="ltx_tag ltx_tag_figure">Figure 1: </span>A <math id="S1.F1.m8" class="ltx_Math" alttext="2\times 2" display="inline" intent=":literal"><semantics><mrow><mn>2</mn><mo lspace="0.222em" rspace="0.222em">×</mo><mn>2</mn></mrow><annotation encoding="application/x-tex">2\times 2</annotation></semantics></math> safe-coordination instance in which unilateral local masks lose the safe optimal action, while a refined obligation recovers it through teammate commitment.</figcaption>
</figure>
<div id="Thmexample1" class="ltx_theorem ltx_theorem_example">
<h6 class="ltx_title ltx_runin ltx_title_theorem"><span class="ltx_tag ltx_tag_theorem"><span id="Thmexample1.2" class="ltx_text ltx_font_bold">Example 1</span></span></h6>
<div id="Thmexample1.p1" class="ltx_para">
<p id="Thmexample1.p1.1" class="ltx_p">Figure <a href="#S1.F1" title="Figure 1 ‣ 1 Introduction ‣ Contract-Based Compositional Shielding for Safe Multi-Agent Reinforcement Learning" class="ltx_ref"><span class="ltx_text ltx_ref_tag">1</span></a> gives a two-agent safe-coordination instance. At state <math id="Thmexample1.p1.m1" class="ltx_Math" alttext="x" display="inline" intent=":literal"><semantics><mi>x</mi><annotation encoding="application/x-tex">x</annotation></semantics></math>, each agent chooses an action <math id="Thmexample1.p1.m2" class="ltx_Math" alttext="p_{i}\in\{0,1\}" display="inline" intent=":literal"><semantics><mrow><msub><mi>p</mi><mi>i</mi></msub><mo>∈</mo><mrow><mo stretchy="false">{</mo><mrow><mn>0</mn><mo>,</mo><mn>1</mn></mrow><mo stretchy="false">}</mo></mrow></mrow><annotation encoding="application/x-tex">p_{i}\in\{0,1\}</annotation></semantics></math>, and safety excludes only the simultaneous choice of <math id="Thmexample1.p1.m3" class="ltx_Math" alttext="1" display="inline" intent=":literal"><semantics><mn>1</mn><annotation encoding="application/x-tex">1</annotation></semantics></math>:
<math id="Thmexample1.p1.m4" class="ltx_Math" alttext="\mathsf{Safe}(x)\mathrel{\overset{\mathrm{def}}{=}}\{(0,0),(1,0),(0,1)\}." display="inline" intent=":literal"><semantics><mrow><mrow><mrow><mi>𝖲𝖺𝖿𝖾</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>x</mi><mo stretchy="false">)</mo></mrow></mrow><mover accent="true"><mo>=</mo><mo mathsize="0.700em">def</mo></mover><mrow><mo stretchy="false">{</mo><mrow><mo stretchy="false">(</mo><mn>0</mn><mo>,</mo><mn>0</mn><mo stretchy="false">)</mo></mrow><mo>,</mo><mrow><mo stretchy="false">(</mo><mn>1</mn><mo>,</mo><mn>0</mn><mo stretchy="false">)</mo></mrow><mo>,</mo><mrow><mo stretchy="false">(</mo><mn>0</mn><mo>,</mo><mn>1</mn><mo stretchy="false">)</mo></mrow><mo stretchy="false">}</mo></mrow></mrow><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">\mathsf{Safe}(x)\mathrel{\overset{\mathrm{def}}{=}}\{(0,0),(1,0),(0,1)\}.</annotation></semantics></math>
Suppose the team reward favours <math id="Thmexample1.p1.m5" class="ltx_Math" alttext="(1,0)" display="inline" intent=":literal"><semantics><mrow><mo stretchy="false">(</mo><mn>1</mn><mo>,</mo><mn>0</mn><mo stretchy="false">)</mo></mrow><annotation encoding="application/x-tex">(1,0)</annotation></semantics></math>. A central shield may admit the whole safe relation and therefore preserve this coordinated optimum. A purely unilateral decomposition, which permits an action only when it is safe against every teammate action, keeps only <math id="Thmexample1.p1.m6" class="ltx_Math" alttext="\{0\}\times\{0\}" display="inline" intent=":literal"><semantics><mrow><mrow><mo stretchy="false">{</mo><mn>0</mn><mo rspace="0.055em" stretchy="false">}</mo></mrow><mo rspace="0.222em">×</mo><mrow><mo stretchy="false">{</mo><mn>0</mn><mo stretchy="false">}</mo></mrow></mrow><annotation encoding="application/x-tex">\{0\}\times\{0\}</annotation></semantics></math>: <math id="Thmexample1.p1.m7" class="ltx_Math" alttext="p_{1}=1" display="inline" intent=":literal"><semantics><mrow><msub><mi>p</mi><mn>1</mn></msub><mo>=</mo><mn>1</mn></mrow><annotation encoding="application/x-tex">p_{1}=1</annotation></semantics></math> is safe only when <math id="Thmexample1.p1.m8" class="ltx_Math" alttext="p_{2}=0" display="inline" intent=":literal"><semantics><mrow><msub><mi>p</mi><mn>2</mn></msub><mo>=</mo><mn>0</mn></mrow><annotation encoding="application/x-tex">p_{2}=0</annotation></semantics></math>, and <math id="Thmexample1.p1.m9" class="ltx_Math" alttext="p_{2}=1" display="inline" intent=":literal"><semantics><mrow><msub><mi>p</mi><mn>2</mn></msub><mo>=</mo><mn>1</mn></mrow><annotation encoding="application/x-tex">p_{2}=1</annotation></semantics></math> is safe only when <math id="Thmexample1.p1.m10" class="ltx_Math" alttext="p_{1}=0" display="inline" intent=":literal"><semantics><mrow><msub><mi>p</mi><mn>1</mn></msub><mo>=</mo><mn>0</mn></mrow><annotation encoding="application/x-tex">p_{1}=0</annotation></semantics></math>. Thus unilateral (factorised) masking loses the optimal safe action. A certified local obligation, for example <math id="Thmexample1.p1.m11" class="ltx_Math" alttext="\mathsf{Always}(p_{2}=0)" display="inline" intent=":literal"><semantics><mrow><mi>𝖠𝗅𝗐𝖺𝗒𝗌</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mrow><msub><mi>p</mi><mn>2</mn></msub><mo>=</mo><mn>0</mn></mrow><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">\mathsf{Always}(p_{2}=0)</annotation></semantics></math>, records the missing commitment: under that contract, agent 1 can again be permitted to choose <math id="Thmexample1.p1.m12" class="ltx_Math" alttext="p_{1}=1" display="inline" intent=":literal"><semantics><mrow><msub><mi>p</mi><mn>1</mn></msub><mo>=</mo><mn>1</mn></mrow><annotation encoding="application/x-tex">p_{1}=1</annotation></semantics></math>, recovering <math id="Thmexample1.p1.m13" class="ltx_Math" alttext="(1,0)" display="inline" intent=":literal"><semantics><mrow><mo stretchy="false">(</mo><mn>1</mn><mo>,</mo><mn>0</mn><mo stretchy="false">)</mo></mrow><annotation encoding="application/x-tex">(1,0)</annotation></semantics></math> without admitting the unsafe pair <math id="Thmexample1.p1.m14" class="ltx_Math" alttext="(1,1)" display="inline" intent=":literal"><semantics><mrow><mo stretchy="false">(</mo><mn>1</mn><mo>,</mo><mn>1</mn><mo stretchy="false">)</mo></mrow><annotation encoding="application/x-tex">(1,1)</annotation></semantics></math>.</p>
</div>
</div>
<div id="S1.p2" class="ltx_para">
<p id="S1.p2.1" class="ltx_p">This paper studies compositional decentralised shielding which allows the preservation of optimal safe coordination actions for cooperative MARL. We construct local shields from certified local temporal contracts, while preserving a single shared global safety objective. We ask whether decentralised shields can recover optimal team-return safe coordination without falling back to a conservative Cartesian decomposition of the central shield. The technical challenge is to let agents rely on one another’s obligations without introducing an unsound proof cycle. We answer it by certifying whole contract tuples through a circular fixed-point construction and projecting the jointly certified action relation into decentralised runtime masks. Learning then selects among finite tuples of local temporal obligations whose conjunction entails the single globally shared temporal objective, exposing high-return coordinated behaviours whilst upholding deterministic safety end-to-end.</p>
</div>
<section id="S1.SS0.SSS0.Px1" class="ltx_paragraph">
<h5 class="ltx_title ltx_title_paragraph">Contributions.</h5>

<div id="S1.SS0.SSS0.Px1.p1" class="ltx_para">
<p id="S1.SS0.SSS0.Px1.p1.1" class="ltx_p">Our contributions are as follows:
<span id="S1.SS0.SSS0.Px1.p1.1.1" class="ltx_text"></span>
<br class="ltx_break">
<span id="S1.I1" class="ltx_inline-enumerate">
<span id="S1.I1.i1" class="ltx_inline-item"><span class="ltx_tag ltx_tag_inline-item">(i)</span> <span id="S1.I1.i1.2" class="ltx_text">We show how a shared global safety specification in <math id="S1.I1.i1.m1" class="ltx_Math" alttext="\mathsf{LTL}_{\mathsf{safe}}" display="inline" intent=":literal"><semantics><msub><mi>𝖫𝖳𝖫</mi><mi>𝗌𝖺𝖿𝖾</mi></msub><annotation encoding="application/x-tex">\mathsf{LTL}_{\mathsf{safe}}</annotation></semantics></math> can be decomposed through candidate local obligations and compiled into deterministic safety automata for shield synthesis.
<br class="ltx_break"></span></span>
<span id="S1.I1.i2" class="ltx_inline-item"><span class="ltx_tag ltx_tag_inline-item">(ii)</span> <span id="S1.I1.i2.2" class="ltx_text">We provide formal soundness guarantees for decentralised shielding based on circular assume-guarantee reasoning, local <math id="S1.I1.i2.m1" class="ltx_Math" alttext="\mathsf{LTL}_{\mathsf{safe}}" display="inline" intent=":literal"><semantics><msub><mi>𝖫𝖳𝖫</mi><mi>𝗌𝖺𝖿𝖾</mi></msub><annotation encoding="application/x-tex">\mathsf{LTL}_{\mathsf{safe}}</annotation></semantics></math> contracts, and contract-product fixed points. Moreover, we also prove recoverability of the optimal safe deterministic policy under explicit library-representability conditions. 
<br class="ltx_break"></span></span>
<span id="S1.I1.i3" class="ltx_inline-item"><span class="ltx_tag ltx_tag_inline-item">(iii)</span> <span id="S1.I1.i3.2" class="ltx_text">We show how bounded certified profile search and discounted upper-confidence contract selection can reduce conservatism while preserving certification.
<br class="ltx_break"></span></span>
<span id="S1.I1.i4" class="ltx_inline-item"><span class="ltx_tag ltx_tag_inline-item">(iv)</span> <span id="S1.I1.i4.2" class="ltx_text">Furthermore, we evaluate reward and safety performance across 6 cooperative multi-agent environments using an extensive set of 15 algorithmic variants.</span></span>
</span></p>
</div>
</section>
</section>
<section id="S2" class="ltx_section">
<h2 class="ltx_title ltx_title_section"><span class="ltx_tag ltx_tag_section">2 </span>Related Work</h2>

<section id="S2.SS0.SSS0.Px1" class="ltx_paragraph">
<h5 class="ltx_title ltx_title_paragraph">Multi-Agent Shielding.</h5>

<div id="S2.SS0.SSS0.Px1.p1" class="ltx_para">
<p id="S2.SS0.SSS0.Px1.p1.1" class="ltx_p">First covered in <cite class="ltx_cite ltx_citemacro_cite">[<a href="#bib.bib15" title="" class="ltx_ref">11</a>]</cite>, multi-agent shielding has since been studied in both centralised and factorised (decentralised) forms. There is also the notion of <em id="S2.SS0.SSS0.Px1.p1.1.1" class="ltx_emph ltx_font_italic">dynamic shielding</em> <cite class="ltx_cite ltx_citemacro_cite">[<a href="#bib.bib3" title="" class="ltx_ref">29</a>]</cite>, which allows shields to split, merge, and recompute based on the current agent configuration, for example when interaction is local in space. In particular, Alshiekh et al. <cite class="ltx_cite ltx_citemacro_cite">[<a href="#bib.bib2" title="" class="ltx_ref">3</a>]</cite> compile safety specifications into automata and synthesise shields that are correct by construction and <em id="S2.SS0.SSS0.Px1.p1.1.2" class="ltx_emph ltx_font_italic">minimally interfering</em>, in the sense that they forbid an action only when allowing it could lead to a violation. We adapt the same automata-theoretic safety-game perspective as <cite class="ltx_cite ltx_citemacro_cite">[<a href="#bib.bib2" title="" class="ltx_ref">3</a>, <a href="#bib.bib6" title="" class="ltx_ref">17</a>]</cite> for decentralised contracts.</p>
</div>
</section>
<section id="S2.SS0.SSS0.Px2" class="ltx_paragraph">
<h5 class="ltx_title ltx_title_paragraph">Compositional Shielding.</h5>

<div id="S2.SS0.SSS0.Px2.p1" class="ltx_para">
<p id="S2.SS0.SSS0.Px2.p1.1" class="ltx_p">Melcer et al. <cite class="ltx_cite ltx_citemacro_cite">[<a href="#bib.bib4" title="" class="ltx_ref">19</a>]</cite> address shield decentralisation by compiling a centralised shield into per-agent local shields, which is a <em id="S2.SS0.SSS0.Px2.p1.1.1" class="ltx_emph ltx_font_italic">shield decomposition</em> method or Cartesian factorisation. Their construction starts from a known-safe joint action for each shield-state/observation pair and incrementally enlarges each agent’s locally permitted action set only when every induced joint action remains safe and the successor shield state remains locally identifiable. This preserves safety guarantees in a communication-free setting. The price of this decentralisation is that the safe joint-action relation must admit a Cartesian-style decomposition into independent local permissions. Jointly safe but non-factorisable coordinated actions are excluded, making the decentralised shield strictly more conservative than the original centralised shield in general.</p>
</div>
<div id="S2.SS0.SSS0.Px2.p2" class="ltx_para">
<p id="S2.SS0.SSS0.Px2.p2.1" class="ltx_p">Brorholt et al. <cite class="ltx_cite ltx_citemacro_cite">[<a href="#bib.bib5" title="" class="ltx_ref">6</a>]</cite> show that naively projecting a centralised shield can lose coordination information, and recover sound decentralised shields through <em id="S2.SS0.SSS0.Px2.p2.1.1" class="ltx_emph ltx_font_italic">ordered assume-guarantee</em> reasoning. Their method requires an acyclic dependency structure: an agent may rely only on guarantees earlier in the order, and the associated cascading-learning procedure exploits this order to obtain in-distribution training and Pareto-style guarantees under local-optimality assumptions. This is the closest precedent to our setting. Our contribution differs in both the proof principle and the learning style. Rather than fixing an acyclic dependency order, we certify an entire tuple of local obligations simultaneously by a contract-product fixed point. This permits circular coordination assumptions and therefore does not require cascading training or an acyclic training order. Moreover, algorithmic synthesis of local assume-guarantee properties is left unaddressed; we keep a single shared global <math id="S2.SS0.SSS0.Px2.p2.m1" class="ltx_Math" alttext="\mathsf{LTL}_{\mathsf{safe}}" display="inline" intent=":literal"><semantics><msub><mi>𝖫𝖳𝖫</mi><mi>𝗌𝖺𝖿𝖾</mi></msub><annotation encoding="application/x-tex">\mathsf{LTL}_{\mathsf{safe}}</annotation></semantics></math> objective and search over finite tuples of local <math id="S2.SS0.SSS0.Px2.p2.m2" class="ltx_Math" alttext="\mathsf{LTL}_{\mathsf{safe}}" display="inline" intent=":literal"><semantics><msub><mi>𝖫𝖳𝖫</mi><mi>𝗌𝖺𝖿𝖾</mi></msub><annotation encoding="application/x-tex">\mathsf{LTL}_{\mathsf{safe}}</annotation></semantics></math> obligations whose conjunction entails it. Learning then selects among pre-certified contracts that can expose high-return safe behaviours while preserving deterministic safety.</p>
</div>
</section>
</section>
<section id="S3" class="ltx_section">
<h2 class="ltx_title ltx_title_section"><span class="ltx_tag ltx_tag_section">3 </span>Preliminaries</h2>

<section id="S3.SS0.SSS0.Px1" class="ltx_paragraph">
<h5 class="ltx_title ltx_title_paragraph">Multi-Agent Reinforcement Learning.</h5>

<div id="S3.SS0.SSS0.Px1.p1" class="ltx_para">
<p id="S3.SS0.SSS0.Px1.p1.1" class="ltx_p">We model multi-agent RL problems as an <math id="S3.SS0.SSS0.Px1.p1.m1" class="ltx_Math" alttext="n" display="inline" intent=":literal"><semantics><mi>n</mi><annotation encoding="application/x-tex">n</annotation></semantics></math>-agent <em id="S3.SS0.SSS0.Px1.p1.1.1" class="ltx_emph ltx_font_italic">concurrent stochastic game</em> (a.k.a. a <span id="S3.SS0.SSS0.Px1.p1.1.2" class="ltx_text ltx_font_italic">Markov game</span> <cite class="ltx_cite ltx_citemacro_cite">[<a href="#bib.bib1" title="" class="ltx_ref">18</a>]</cite>)
<math id="S3.SS0.SSS0.Px1.p1.m2" class="ltx_Math" alttext="\mathcal{M}\mathrel{\overset{\mathrm{def}}{=}}(\mathcal{S},s_{0},\mathcal{A}^{1},\dots,\mathcal{A}^{n},d^{1},\dots,d^{n},\mathcal{P},\mathcal{R}^{1},\dots,\mathcal{R}^{n},\gamma)" display="inline" intent=":literal"><semantics><mrow><mi class="ltx_font_mathcaligraphic">ℳ</mi><mover accent="true"><mo>=</mo><mo mathsize="0.700em">def</mo></mover><mrow><mo stretchy="false">(</mo><mi class="ltx_font_mathcaligraphic">𝒮</mi><mo>,</mo><msub><mi>s</mi><mn>0</mn></msub><mo>,</mo><msup><mi class="ltx_font_mathcaligraphic">𝒜</mi><mn>1</mn></msup><mo>,</mo><mi mathvariant="normal">…</mi><mo>,</mo><msup><mi class="ltx_font_mathcaligraphic">𝒜</mi><mi>n</mi></msup><mo>,</mo><msup><mi>d</mi><mn>1</mn></msup><mo>,</mo><mi mathvariant="normal">…</mi><mo>,</mo><msup><mi>d</mi><mi>n</mi></msup><mo>,</mo><mi class="ltx_font_mathcaligraphic">𝒫</mi><mo>,</mo><msup><mi class="ltx_font_mathcaligraphic">ℛ</mi><mn>1</mn></msup><mo>,</mo><mi mathvariant="normal">…</mi><mo>,</mo><msup><mi class="ltx_font_mathcaligraphic">ℛ</mi><mi>n</mi></msup><mo>,</mo><mi>γ</mi><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">\mathcal{M}\mathrel{\overset{\mathrm{def}}{=}}(\mathcal{S},s_{0},\mathcal{A}^{1},\dots,\mathcal{A}^{n},d^{1},\dots,d^{n},\mathcal{P},\mathcal{R}^{1},\dots,\mathcal{R}^{n},\gamma)</annotation></semantics></math>, where <math id="S3.SS0.SSS0.Px1.p1.m3" class="ltx_Math" alttext="\mathcal{S}" display="inline" intent=":literal"><semantics><mi class="ltx_font_mathcaligraphic">𝒮</mi><annotation encoding="application/x-tex">\mathcal{S}</annotation></semantics></math> is the finite <span id="S3.SS0.SSS0.Px1.p1.1.3" class="ltx_text ltx_font_italic">state space</span> and <math id="S3.SS0.SSS0.Px1.p1.m4" class="ltx_Math" alttext="s_{0}\in\mathcal{S}" display="inline" intent=":literal"><semantics><mrow><msub><mi>s</mi><mn>0</mn></msub><mo>∈</mo><mi class="ltx_font_mathcaligraphic">𝒮</mi></mrow><annotation encoding="application/x-tex">s_{0}\in\mathcal{S}</annotation></semantics></math> is the <span id="S3.SS0.SSS0.Px1.p1.1.4" class="ltx_text ltx_font_italic">initial state</span>; <math id="S3.SS0.SSS0.Px1.p1.m5" class="ltx_Math" alttext="\mathsf{Ag}\mathrel{\overset{\mathrm{def}}{=}}\{1,\dots,n\}" display="inline" intent=":literal"><semantics><mrow><mi>𝖠𝗀</mi><mover accent="true"><mo>=</mo><mo mathsize="0.700em">def</mo></mover><mrow><mo stretchy="false">{</mo><mrow><mn>1</mn><mo>,</mo><mi mathvariant="normal">…</mi><mo>,</mo><mi>n</mi></mrow><mo stretchy="false">}</mo></mrow></mrow><annotation encoding="application/x-tex">\mathsf{Ag}\mathrel{\overset{\mathrm{def}}{=}}\{1,\dots,n\}</annotation></semantics></math> is the set of <span id="S3.SS0.SSS0.Px1.p1.1.5" class="ltx_text ltx_font_italic">agents</span>; each <math id="S3.SS0.SSS0.Px1.p1.m6" class="ltx_Math" alttext="\mathcal{A}^{i}" display="inline" intent=":literal"><semantics><msup><mi class="ltx_font_mathcaligraphic">𝒜</mi><mi>i</mi></msup><annotation encoding="application/x-tex">\mathcal{A}^{i}</annotation></semantics></math> is the finite <span id="S3.SS0.SSS0.Px1.p1.1.6" class="ltx_text ltx_font_italic">action space</span> of agent <math id="S3.SS0.SSS0.Px1.p1.m7" class="ltx_Math" alttext="i\in\mathsf{Ag}" display="inline" intent=":literal"><semantics><mrow><mi>i</mi><mo>∈</mo><mi>𝖠𝗀</mi></mrow><annotation encoding="application/x-tex">i\in\mathsf{Ag}</annotation></semantics></math> and <math id="S3.SS0.SSS0.Px1.p1.m8" class="ltx_Math" alttext="\mathcal{A}\mathrel{\overset{\mathrm{def}}{=}}\prod_{i\in\mathsf{Ag}}\mathcal{A}^{i}" display="inline" intent=":literal"><semantics><mrow><mi class="ltx_font_mathcaligraphic">𝒜</mi><mover accent="true"><mo rspace="0.111em">=</mo><mo mathsize="0.700em">def</mo></mover><mrow><msub><mo>∏</mo><mrow><mi>i</mi><mo>∈</mo><mi>𝖠𝗀</mi></mrow></msub><msup><mi class="ltx_font_mathcaligraphic">𝒜</mi><mi>i</mi></msup></mrow></mrow><annotation encoding="application/x-tex">\mathcal{A}\mathrel{\overset{\mathrm{def}}{=}}\prod_{i\in\mathsf{Ag}}\mathcal{A}^{i}</annotation></semantics></math> is the <span id="S3.SS0.SSS0.Px1.p1.1.7" class="ltx_text ltx_font_italic">joint action space</span>;
each <math id="S3.SS0.SSS0.Px1.p1.m9" class="ltx_Math" alttext="d^{i}:\mathcal{S}\to 2^{\mathcal{A}^{i}}\setminus\{\emptyset\}" display="inline" intent=":literal"><semantics><mrow><msup><mi>d</mi><mi>i</mi></msup><mo lspace="0.278em" rspace="0.278em">:</mo><mrow><mi class="ltx_font_mathcaligraphic">𝒮</mi><mo stretchy="false">→</mo><mrow><msup><mn>2</mn><msup><mi class="ltx_font_mathcaligraphic">𝒜</mi><mi>i</mi></msup></msup><mo>∖</mo><mrow><mo stretchy="false">{</mo><mi mathvariant="normal">∅</mi><mo stretchy="false">}</mo></mrow></mrow></mrow></mrow><annotation encoding="application/x-tex">d^{i}:\mathcal{S}\to 2^{\mathcal{A}^{i}}\setminus\{\emptyset\}</annotation></semantics></math> is the <span id="S3.SS0.SSS0.Px1.p1.1.8" class="ltx_text ltx_font_italic">action-availability protocol</span> of agent <math id="S3.SS0.SSS0.Px1.p1.m10" class="ltx_Math" alttext="i" display="inline" intent=":literal"><semantics><mi>i</mi><annotation encoding="application/x-tex">i</annotation></semantics></math>, with <span id="S3.SS0.SSS0.Px1.p1.1.9" class="ltx_text ltx_font_italic">legal joint-action</span> set <math id="S3.SS0.SSS0.Px1.p1.m11" class="ltx_Math" alttext="d(s)\mathrel{\overset{\mathrm{def}}{=}}\prod_{i\in\mathsf{Ag}}d^{i}(s)" display="inline" intent=":literal"><semantics><mrow><mrow><mi>d</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>s</mi><mo stretchy="false">)</mo></mrow></mrow><mover accent="true"><mo rspace="0.111em">=</mo><mo mathsize="0.700em">def</mo></mover><mrow><msub><mo>∏</mo><mrow><mi>i</mi><mo>∈</mo><mi>𝖠𝗀</mi></mrow></msub><mrow><msup><mi>d</mi><mi>i</mi></msup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>s</mi><mo stretchy="false">)</mo></mrow></mrow></mrow></mrow><annotation encoding="application/x-tex">d(s)\mathrel{\overset{\mathrm{def}}{=}}\prod_{i\in\mathsf{Ag}}d^{i}(s)</annotation></semantics></math> at state <math id="S3.SS0.SSS0.Px1.p1.m12" class="ltx_Math" alttext="s" display="inline" intent=":literal"><semantics><mi>s</mi><annotation encoding="application/x-tex">s</annotation></semantics></math>, so <math id="S3.SS0.SSS0.Px1.p1.m13" class="ltx_Math" alttext="a" display="inline" intent=":literal"><semantics><mi>a</mi><annotation encoding="application/x-tex">a</annotation></semantics></math> is <span id="S3.SS0.SSS0.Px1.p1.1.10" class="ltx_text ltx_font_italic">legal</span> at <math id="S3.SS0.SSS0.Px1.p1.m14" class="ltx_Math" alttext="s" display="inline" intent=":literal"><semantics><mi>s</mi><annotation encoding="application/x-tex">s</annotation></semantics></math> iff <math id="S3.SS0.SSS0.Px1.p1.m15" class="ltx_Math" alttext="a\in d(s)" display="inline" intent=":literal"><semantics><mrow><mi>a</mi><mo>∈</mo><mrow><mi>d</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>s</mi><mo stretchy="false">)</mo></mrow></mrow></mrow><annotation encoding="application/x-tex">a\in d(s)</annotation></semantics></math>.
If the environment has no state-dependent feasibility restrictions, then <math id="S3.SS0.SSS0.Px1.p1.m16" class="ltx_Math" alttext="d^{i}(s)=\mathcal{A}^{i}" display="inline" intent=":literal"><semantics><mrow><mrow><msup><mi>d</mi><mi>i</mi></msup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>s</mi><mo stretchy="false">)</mo></mrow></mrow><mo>=</mo><msup><mi class="ltx_font_mathcaligraphic">𝒜</mi><mi>i</mi></msup></mrow><annotation encoding="application/x-tex">d^{i}(s)=\mathcal{A}^{i}</annotation></semantics></math> for all <math id="S3.SS0.SSS0.Px1.p1.m17" class="ltx_Math" alttext="i" display="inline" intent=":literal"><semantics><mi>i</mi><annotation encoding="application/x-tex">i</annotation></semantics></math> and <math id="S3.SS0.SSS0.Px1.p1.m18" class="ltx_Math" alttext="s" display="inline" intent=":literal"><semantics><mi>s</mi><annotation encoding="application/x-tex">s</annotation></semantics></math>;
<math id="S3.SS0.SSS0.Px1.p1.m19" class="ltx_Math" alttext="\mathsf{Dom}(d)\mathrel{\overset{\mathrm{def}}{=}}\{(s,a)\in\mathcal{S}\times\mathcal{A}\mid a\in d(s)\}" display="inline" intent=":literal"><semantics><mrow><mrow><mi>𝖣𝗈𝗆</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>d</mi><mo stretchy="false">)</mo></mrow></mrow><mover accent="true"><mo>=</mo><mo mathsize="0.700em">def</mo></mover><mrow><mo stretchy="false">{</mo><mrow><mrow><mo stretchy="false">(</mo><mi>s</mi><mo>,</mo><mi>a</mi><mo stretchy="false">)</mo></mrow><mo>∈</mo><mrow><mi class="ltx_font_mathcaligraphic">𝒮</mi><mo lspace="0.222em" rspace="0.222em">×</mo><mi class="ltx_font_mathcaligraphic">𝒜</mi></mrow></mrow><mo fence="true" lspace="0em" rspace="0em">∣</mo><mrow><mi>a</mi><mo>∈</mo><mrow><mi>d</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>s</mi><mo stretchy="false">)</mo></mrow></mrow></mrow><mo stretchy="false">}</mo></mrow></mrow><annotation encoding="application/x-tex">\mathsf{Dom}(d)\mathrel{\overset{\mathrm{def}}{=}}\{(s,a)\in\mathcal{S}\times\mathcal{A}\mid a\in d(s)\}</annotation></semantics></math> is the <span id="S3.SS0.SSS0.Px1.p1.1.11" class="ltx_text ltx_font_italic">legal state-action domain</span>; <math id="S3.SS0.SSS0.Px1.p1.m20" class="ltx_Math" alttext="\mathcal{P}:\mathsf{Dom}(d)\to\Delta(\mathcal{S})" display="inline" intent=":literal"><semantics><mrow><mi class="ltx_font_mathcaligraphic">𝒫</mi><mo lspace="0.278em" rspace="0.278em">:</mo><mrow><mrow><mi>𝖣𝗈𝗆</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>d</mi><mo stretchy="false">)</mo></mrow></mrow><mo stretchy="false">→</mo><mrow><mi mathvariant="normal">Δ</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi class="ltx_font_mathcaligraphic">𝒮</mi><mo stretchy="false">)</mo></mrow></mrow></mrow></mrow><annotation encoding="application/x-tex">\mathcal{P}:\mathsf{Dom}(d)\to\Delta(\mathcal{S})</annotation></semantics></math> is the <span id="S3.SS0.SSS0.Px1.p1.1.12" class="ltx_text ltx_font_italic">transition function</span>, with <math id="S3.SS0.SSS0.Px1.p1.m21" class="ltx_Math" alttext="\Delta(\mathcal{S})" display="inline" intent=":literal"><semantics><mrow><mi mathvariant="normal">Δ</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi class="ltx_font_mathcaligraphic">𝒮</mi><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">\Delta(\mathcal{S})</annotation></semantics></math> being the set of <span id="S3.SS0.SSS0.Px1.p1.1.13" class="ltx_text ltx_font_italic">probability distributions</span> over <math id="S3.SS0.SSS0.Px1.p1.m22" class="ltx_Math" alttext="\mathcal{S}" display="inline" intent=":literal"><semantics><mi class="ltx_font_mathcaligraphic">𝒮</mi><annotation encoding="application/x-tex">\mathcal{S}</annotation></semantics></math>; each <math id="S3.SS0.SSS0.Px1.p1.m23" class="ltx_Math" alttext="\mathcal{R}^{i}:\mathsf{Dom}(d)\times\mathcal{S}\to\mathbb{R}" display="inline" intent=":literal"><semantics><mrow><msup><mi class="ltx_font_mathcaligraphic">ℛ</mi><mi>i</mi></msup><mo lspace="0.278em" rspace="0.278em">:</mo><mrow><mrow><mrow><mi>𝖣𝗈𝗆</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>d</mi><mo rspace="0.055em" stretchy="false">)</mo></mrow></mrow><mo rspace="0.222em">×</mo><mi class="ltx_font_mathcaligraphic">𝒮</mi></mrow><mo stretchy="false">→</mo><mi>ℝ</mi></mrow></mrow><annotation encoding="application/x-tex">\mathcal{R}^{i}:\mathsf{Dom}(d)\times\mathcal{S}\to\mathbb{R}</annotation></semantics></math> is the (Markovian) <span id="S3.SS0.SSS0.Px1.p1.1.14" class="ltx_text ltx_font_italic">reward function</span> of agent <math id="S3.SS0.SSS0.Px1.p1.m24" class="ltx_Math" alttext="i" display="inline" intent=":literal"><semantics><mi>i</mi><annotation encoding="application/x-tex">i</annotation></semantics></math>; and <math id="S3.SS0.SSS0.Px1.p1.m25" class="ltx_Math" alttext="\gamma" display="inline" intent=":literal"><semantics><mi>γ</mi><annotation encoding="application/x-tex">\gamma</annotation></semantics></math> is the <span id="S3.SS0.SSS0.Px1.p1.1.15" class="ltx_text ltx_font_italic">discount factor</span>. The action protocol captures state-dependent primitive-action feasibility before shielding.</p>
</div>
<div id="S3.SS0.SSS0.Px1.p2" class="ltx_para">
<p id="S3.SS0.SSS0.Px1.p2.1" class="ltx_p">A (stochastic) <em id="S3.SS0.SSS0.Px1.p2.1.1" class="ltx_emph ltx_font_italic">policy</em> <math id="S3.SS0.SSS0.Px1.p2.m1" class="ltx_Math" alttext="\pi^{i}" display="inline" intent=":literal"><semantics><msup><mi>π</mi><mi>i</mi></msup><annotation encoding="application/x-tex">\pi^{i}</annotation></semantics></math> (also known as a <span id="S3.SS0.SSS0.Px1.p2.1.2" class="ltx_text ltx_font_italic">strategy</span>) of agent <math id="S3.SS0.SSS0.Px1.p2.m2" class="ltx_Math" alttext="i" display="inline" intent=":literal"><semantics><mi>i</mi><annotation encoding="application/x-tex">i</annotation></semantics></math> is a function <math id="S3.SS0.SSS0.Px1.p2.m3" class="ltx_Math" alttext="\pi^{i}:\mathcal{S}\to\Delta(\mathcal{A}^{i})" display="inline" intent=":literal"><semantics><mrow><msup><mi>π</mi><mi>i</mi></msup><mo lspace="0.278em" rspace="0.278em">:</mo><mrow><mi class="ltx_font_mathcaligraphic">𝒮</mi><mo stretchy="false">→</mo><mrow><mi mathvariant="normal">Δ</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><msup><mi class="ltx_font_mathcaligraphic">𝒜</mi><mi>i</mi></msup><mo stretchy="false">)</mo></mrow></mrow></mrow></mrow><annotation encoding="application/x-tex">\pi^{i}:\mathcal{S}\to\Delta(\mathcal{A}^{i})</annotation></semantics></math> such that <math id="S3.SS0.SSS0.Px1.p2.m4" class="ltx_Math" alttext="\pi^{i}(a^{i}\mid s)=0" display="inline" intent=":literal"><semantics><mrow><mrow><msup><mi>π</mi><mi>i</mi></msup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msup><mi>a</mi><mi>i</mi></msup><mo fence="true" lspace="0em" rspace="0em">∣</mo><mi>s</mi><mo stretchy="false">)</mo></mrow></mrow><mo>=</mo><mn>0</mn></mrow><annotation encoding="application/x-tex">\pi^{i}(a^{i}\mid s)=0</annotation></semantics></math> whenever <math id="S3.SS0.SSS0.Px1.p2.m5" class="ltx_Math" alttext="a^{i}\notin d^{i}(s)" display="inline" intent=":literal"><semantics><mrow><msup><mi>a</mi><mi>i</mi></msup><mo>∉</mo><mrow><msup><mi>d</mi><mi>i</mi></msup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>s</mi><mo stretchy="false">)</mo></mrow></mrow></mrow><annotation encoding="application/x-tex">a^{i}\notin d^{i}(s)</annotation></semantics></math>. A <span id="S3.SS0.SSS0.Px1.p2.1.3" class="ltx_text ltx_font_italic">joint policy</span> <math id="S3.SS0.SSS0.Px1.p2.m6" class="ltx_Math" alttext="\pi=(\pi^{1},\dots,\pi^{n})" display="inline" intent=":literal"><semantics><mrow><mi>π</mi><mo>=</mo><mrow><mo stretchy="false">(</mo><msup><mi>π</mi><mn>1</mn></msup><mo>,</mo><mi mathvariant="normal">…</mi><mo>,</mo><msup><mi>π</mi><mi>n</mi></msup><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">\pi=(\pi^{1},\dots,\pi^{n})</annotation></semantics></math> induces the decentralised product distribution
<math id="S3.SS0.SSS0.Px1.p2.m7" class="ltx_Math" alttext="\pi(a\mid s)\mathrel{\overset{\mathrm{def}}{=}}\prod_{i=1}^{n}\pi^{i}(a^{i}\mid s)," display="inline" intent=":literal"><semantics><mrow><mrow><mrow><mi>π</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>a</mi><mo fence="true" lspace="0em" rspace="0em">∣</mo><mi>s</mi><mo stretchy="false">)</mo></mrow></mrow><mover accent="true"><mo rspace="0.111em">=</mo><mo mathsize="0.700em">def</mo></mover><mrow><msubsup><mo>∏</mo><mrow><mi>i</mi><mo>=</mo><mn>1</mn></mrow><mi>n</mi></msubsup><mrow><msup><mi>π</mi><mi>i</mi></msup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msup><mi>a</mi><mi>i</mi></msup><mo fence="true" lspace="0em" rspace="0em">∣</mo><mi>s</mi><mo stretchy="false">)</mo></mrow></mrow></mrow></mrow><mo>,</mo></mrow><annotation encoding="application/x-tex">\pi(a\mid s)\mathrel{\overset{\mathrm{def}}{=}}\prod_{i=1}^{n}\pi^{i}(a^{i}\mid s),</annotation></semantics></math>
where
<math id="S3.SS0.SSS0.Px1.p2.m8" class="ltx_Math" alttext="a=(a^{1},\dots,a^{n})." display="inline" intent=":literal"><semantics><mrow><mrow><mi>a</mi><mo>=</mo><mrow><mo stretchy="false">(</mo><msup><mi>a</mi><mn>1</mn></msup><mo>,</mo><mi mathvariant="normal">…</mi><mo>,</mo><msup><mi>a</mi><mi>n</mi></msup><mo stretchy="false">)</mo></mrow></mrow><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">a=(a^{1},\dots,a^{n}).</annotation></semantics></math>
The joint policy of other agents is <math id="S3.SS0.SSS0.Px1.p2.m9" class="ltx_Math" alttext="\pi^{-i}(a^{-i}|s)\mathrel{\overset{\mathrm{def}}{=}}\prod_{j\neq i}\pi^{j}(a^{j}|s)" display="inline" intent=":literal"><semantics><mrow><mrow><msup><mi>π</mi><mrow><mo>−</mo><mi>i</mi></mrow></msup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msup><mi>a</mi><mrow><mo>−</mo><mi>i</mi></mrow></msup><mo lspace="0em" rspace="0em">|</mo><mi>s</mi><mo stretchy="false">)</mo></mrow></mrow><mover accent="true"><mo rspace="0.111em">=</mo><mo mathsize="0.700em">def</mo></mover><mrow><msub><mo>∏</mo><mrow><mi>j</mi><mo>≠</mo><mi>i</mi></mrow></msub><mrow><msup><mi>π</mi><mi>j</mi></msup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msup><mi>a</mi><mi>j</mi></msup><mo lspace="0em" rspace="0em">|</mo><mi>s</mi><mo stretchy="false">)</mo></mrow></mrow></mrow></mrow><annotation encoding="application/x-tex">\pi^{-i}(a^{-i}|s)\mathrel{\overset{\mathrm{def}}{=}}\prod_{j\neq i}\pi^{j}(a^{j}|s)</annotation></semantics></math>, where <math id="S3.SS0.SSS0.Px1.p2.m10" class="ltx_Math" alttext="a^{-i}" display="inline" intent=":literal"><semantics><msup><mi>a</mi><mrow><mo>−</mo><mi>i</mi></mrow></msup><annotation encoding="application/x-tex">a^{-i}</annotation></semantics></math> is the joint action except agent <math id="S3.SS0.SSS0.Px1.p2.m11" class="ltx_Math" alttext="i" display="inline" intent=":literal"><semantics><mi>i</mi><annotation encoding="application/x-tex">i</annotation></semantics></math>’s action. In the <em id="S3.SS0.SSS0.Px1.p2.1.4" class="ltx_emph ltx_font_italic">cooperative</em> strategic setting, the agents are evaluated by a common team objective. We use the standard team-return criterion:</p>
<table id="S3.Ex1" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="S3.Ex1.m1" class="ltx_Math" alttext="J_{s_{0}}(\pi)\mathrel{\overset{\mathrm{def}}{=}}\mathbb{E}^{\pi}\!\left[\sum_{t=0}^{\infty}\gamma^{t}\sum_{i=1}^{n}\mathcal{R}^{i}(s_{t},a_{t},s_{t+1})\right]," display="block" intent=":literal"><semantics><mrow><mrow><mrow><msub><mi>J</mi><msub><mi>s</mi><mn>0</mn></msub></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>π</mi><mo stretchy="false">)</mo></mrow></mrow><mover accent="true"><mo>=</mo><mo mathsize="0.700em">def</mo></mover><mrow><msup><mi>𝔼</mi><mi>π</mi></msup><mo lspace="0em" rspace="0em">​</mo><mrow><mo>[</mo><mrow><munderover><mo lspace="0em" movablelimits="false">∑</mo><mrow><mi>t</mi><mo>=</mo><mn>0</mn></mrow><mi mathvariant="normal">∞</mi></munderover><mrow><msup><mi>γ</mi><mi>t</mi></msup><mo lspace="0em" rspace="0em">​</mo><mrow><munderover><mo movablelimits="false">∑</mo><mrow><mi>i</mi><mo>=</mo><mn>1</mn></mrow><mi>n</mi></munderover><mrow><msup><mi class="ltx_font_mathcaligraphic">ℛ</mi><mi>i</mi></msup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mi>s</mi><mi>t</mi></msub><mo>,</mo><msub><mi>a</mi><mi>t</mi></msub><mo>,</mo><msub><mi>s</mi><mrow><mi>t</mi><mo>+</mo><mn>1</mn></mrow></msub><mo stretchy="false">)</mo></mrow></mrow></mrow></mrow></mrow><mo>]</mo></mrow></mrow></mrow><mo>,</mo></mrow><annotation encoding="application/x-tex">J_{s_{0}}(\pi)\mathrel{\overset{\mathrm{def}}{=}}\mathbb{E}^{\pi}\!\left[\sum_{t=0}^{\infty}\gamma^{t}\sum_{i=1}^{n}\mathcal{R}^{i}(s_{t},a_{t},s_{t+1})\right],</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="S3.SS0.SSS0.Px1.p2.2" class="ltx_p">where <math id="S3.SS0.SSS0.Px1.p2.m12" class="ltx_Math" alttext="\pi=(\pi^{1},\dots,\pi^{n})" display="inline" intent=":literal"><semantics><mrow><mi>π</mi><mo>=</mo><mrow><mo stretchy="false">(</mo><msup><mi>π</mi><mn>1</mn></msup><mo>,</mo><mi mathvariant="normal">…</mi><mo>,</mo><msup><mi>π</mi><mi>n</mi></msup><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">\pi=(\pi^{1},\dots,\pi^{n})</annotation></semantics></math> is the joint policy. A joint policy <math id="S3.SS0.SSS0.Px1.p2.m13" class="ltx_Math" alttext="\pi^{\star}" display="inline" intent=":literal"><semantics><msup><mi>π</mi><mo>⋆</mo></msup><annotation encoding="application/x-tex">\pi^{\star}</annotation></semantics></math> is <em id="S3.SS0.SSS0.Px1.p2.2.1" class="ltx_emph ltx_font_italic">team-optimal</em> iff <math id="S3.SS0.SSS0.Px1.p2.m14" class="ltx_Math" alttext="\pi^{\star}\in\arg\max_{\pi}J_{s_{0}}(\pi)" display="inline" intent=":literal"><semantics><mrow><msup><mi>π</mi><mo>⋆</mo></msup><mo>∈</mo><mrow><mrow><mi>arg</mi><mo lspace="0.167em">⁡</mo><msub><mi>max</mi><mi>π</mi></msub></mrow><mo lspace="0.167em" rspace="0em">​</mo><msub><mi>J</mi><msub><mi>s</mi><mn>0</mn></msub></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>π</mi><mo stretchy="false">)</mo></mrow></mrow></mrow><annotation encoding="application/x-tex">\pi^{\star}\in\arg\max_{\pi}J_{s_{0}}(\pi)</annotation></semantics></math>, that is, no other joint policy achieves higher expected discounted total reward from the initial state.</p>
</div>
<div id="S3.SS0.SSS0.Px1.p3" class="ltx_para">
<p id="S3.SS0.SSS0.Px1.p3.1" class="ltx_p">Throughout, for a distribution <math id="S3.SS0.SSS0.Px1.p3.m1" class="ltx_Math" alttext="\mu\in\Delta(Z)" display="inline" intent=":literal"><semantics><mrow><mi>μ</mi><mo>∈</mo><mrow><mi mathvariant="normal">Δ</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>Z</mi><mo stretchy="false">)</mo></mrow></mrow></mrow><annotation encoding="application/x-tex">\mu\in\Delta(Z)</annotation></semantics></math>, write
<math id="S3.SS0.SSS0.Px1.p3.m2" class="ltx_Math" alttext="\Supp(\mu)\mathrel{\overset{\mathrm{def}}{=}}\{z\in Z\mid\mu(z)&gt;0\}" display="inline" intent=":literal"><semantics><mrow><mrow><mi>Supp</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>μ</mi><mo stretchy="false">)</mo></mrow></mrow><mover accent="true"><mo>=</mo><mo mathsize="0.700em">def</mo></mover><mrow><mo stretchy="false">{</mo><mrow><mi>z</mi><mo>∈</mo><mi>Z</mi></mrow><mo fence="true" lspace="0em" rspace="0em">∣</mo><mrow><mrow><mi>μ</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>z</mi><mo stretchy="false">)</mo></mrow></mrow><mo>&gt;</mo><mn>0</mn></mrow><mo stretchy="false">}</mo></mrow></mrow><annotation encoding="application/x-tex">\Supp(\mu)\mathrel{\overset{\mathrm{def}}{=}}\{z\in Z\mid\mu(z)&gt;0\}</annotation></semantics></math> for its support, i.e. the set of values that can occur with non-zero probability. An <span id="S3.SS0.SSS0.Px1.p3.1.1" class="ltx_text ltx_font_italic">execution</span> from <math id="S3.SS0.SSS0.Px1.p3.m3" class="ltx_Math" alttext="s" display="inline" intent=":literal"><semantics><mi>s</mi><annotation encoding="application/x-tex">s</annotation></semantics></math> is an alternating sequence <math id="S3.SS0.SSS0.Px1.p3.m4" class="ltx_math_unparsed" alttext="s_{0}a_{0}s_{1}a_{1}\cdots" display="inline" intent=":literal"><semantics><mrow><mi>s</mi><msub><mrow></mrow><mn>0</mn></msub><mi>a</mi><msub><mrow></mrow><mn>0</mn></msub><mi>s</mi><msub><mrow></mrow><mn>1</mn></msub><mi>a</mi><msub><mrow></mrow><mn>1</mn></msub><mo lspace="0em">⋯</mo></mrow><annotation encoding="application/x-tex">s_{0}a_{0}s_{1}a_{1}\cdots</annotation></semantics></math> with <math id="S3.SS0.SSS0.Px1.p3.m5" class="ltx_Math" alttext="s_{0}=s" display="inline" intent=":literal"><semantics><mrow><msub><mi>s</mi><mn>0</mn></msub><mo>=</mo><mi>s</mi></mrow><annotation encoding="application/x-tex">s_{0}=s</annotation></semantics></math>, <math id="S3.SS0.SSS0.Px1.p3.m6" class="ltx_Math" alttext="a_{t}\in d(s_{t})" display="inline" intent=":literal"><semantics><mrow><msub><mi>a</mi><mi>t</mi></msub><mo>∈</mo><mrow><mi>d</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><msub><mi>s</mi><mi>t</mi></msub><mo stretchy="false">)</mo></mrow></mrow></mrow><annotation encoding="application/x-tex">a_{t}\in d(s_{t})</annotation></semantics></math>, and <math id="S3.SS0.SSS0.Px1.p3.m7" class="ltx_Math" alttext="s_{t+1}\in\Supp(\mathcal{P}(s_{t},a_{t}))" display="inline" intent=":literal"><semantics><mrow><msub><mi>s</mi><mrow><mi>t</mi><mo>+</mo><mn>1</mn></mrow></msub><mo>∈</mo><mrow><mi>Supp</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mrow><mi class="ltx_font_mathcaligraphic">𝒫</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><msub><mi>s</mi><mi>t</mi></msub><mo>,</mo><msub><mi>a</mi><mi>t</mi></msub><mo stretchy="false">)</mo></mrow></mrow><mo stretchy="false">)</mo></mrow></mrow></mrow><annotation encoding="application/x-tex">s_{t+1}\in\Supp(\mathcal{P}(s_{t},a_{t}))</annotation></semantics></math> at every step; finite execution prefixes are defined similarly. The execution is consistent with <math id="S3.SS0.SSS0.Px1.p3.m8" class="ltx_Math" alttext="\pi" display="inline" intent=":literal"><semantics><mi>π</mi><annotation encoding="application/x-tex">\pi</annotation></semantics></math> if <math id="S3.SS0.SSS0.Px1.p3.m9" class="ltx_Math" alttext="\pi(a_{t}\mid s_{t})&gt;0" display="inline" intent=":literal"><semantics><mrow><mrow><mi>π</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><msub><mi>a</mi><mi>t</mi></msub><mo fence="true" lspace="0em" rspace="0em">∣</mo><msub><mi>s</mi><mi>t</mi></msub><mo stretchy="false">)</mo></mrow></mrow><mo>&gt;</mo><mn>0</mn></mrow><annotation encoding="application/x-tex">\pi(a_{t}\mid s_{t})&gt;0</annotation></semantics></math> at every step. We write <math id="S3.SS0.SSS0.Px1.p3.m10" class="ltx_Math" alttext="\mathsf{IPath}^{\pi}(s)" display="inline" intent=":literal"><semantics><mrow><msup><mi>𝖨𝖯𝖺𝗍𝗁</mi><mi>π</mi></msup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>s</mi><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">\mathsf{IPath}^{\pi}(s)</annotation></semantics></math> for the set of state paths <math id="S3.SS0.SSS0.Px1.p3.m11" class="ltx_math_unparsed" alttext="s_{0}s_{1}\cdots" display="inline" intent=":literal"><semantics><mrow><mi>s</mi><msub><mrow></mrow><mn>0</mn></msub><mi>s</mi><msub><mrow></mrow><mn>1</mn></msub><mo lspace="0em">⋯</mo></mrow><annotation encoding="application/x-tex">s_{0}s_{1}\cdots</annotation></semantics></math> induced by executions from <math id="S3.SS0.SSS0.Px1.p3.m12" class="ltx_Math" alttext="s" display="inline" intent=":literal"><semantics><mi>s</mi><annotation encoding="application/x-tex">s</annotation></semantics></math> that are consistent with <math id="S3.SS0.SSS0.Px1.p3.m13" class="ltx_Math" alttext="\pi" display="inline" intent=":literal"><semantics><mi>π</mi><annotation encoding="application/x-tex">\pi</annotation></semantics></math>. The same joint policy induces a finite <span id="S3.SS0.SSS0.Px1.p3.1.2" class="ltx_text ltx_font_italic">Markov chain</span> <cite class="ltx_cite ltx_citemacro_cite">[<a href="#bib.bib9" title="" class="ltx_ref">4</a>]</cite> <math id="S3.SS0.SSS0.Px1.p3.m14" class="ltx_Math" alttext="\mathcal{M}^{\pi}\mathrel{\overset{\mathrm{def}}{=}}(\mathcal{S},s_{0},\mathcal{P}^{\pi})" display="inline" intent=":literal"><semantics><mrow><msup><mi class="ltx_font_mathcaligraphic">ℳ</mi><mi>π</mi></msup><mover accent="true"><mo>=</mo><mo mathsize="0.700em">def</mo></mover><mrow><mo stretchy="false">(</mo><mi class="ltx_font_mathcaligraphic">𝒮</mi><mo>,</mo><msub><mi>s</mi><mn>0</mn></msub><mo>,</mo><msup><mi class="ltx_font_mathcaligraphic">𝒫</mi><mi>π</mi></msup><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">\mathcal{M}^{\pi}\mathrel{\overset{\mathrm{def}}{=}}(\mathcal{S},s_{0},\mathcal{P}^{\pi})</annotation></semantics></math>, where
<math id="S3.SS0.SSS0.Px1.p3.m15" class="ltx_Math" alttext="\mathcal{P}^{\pi}(s,s^{\prime})\mathrel{\overset{\mathrm{def}}{=}}\sum_{a\in d(s)}\pi(a\mid s)\,\mathcal{P}(s,a)(s^{\prime})." display="inline" intent=":literal"><semantics><mrow><mrow><mrow><msup><mi class="ltx_font_mathcaligraphic">𝒫</mi><mi>π</mi></msup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>s</mi><mo>,</mo><msup><mi>s</mi><mo>′</mo></msup><mo stretchy="false">)</mo></mrow></mrow><mover accent="true"><mo rspace="0.111em">=</mo><mo mathsize="0.700em">def</mo></mover><mrow><msub><mo>∑</mo><mrow><mi>a</mi><mo>∈</mo><mrow><mi>d</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>s</mi><mo stretchy="false">)</mo></mrow></mrow></mrow></msub><mrow><mrow><mi>π</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>a</mi><mo fence="true" lspace="0em" rspace="0em">∣</mo><mi>s</mi><mo stretchy="false">)</mo></mrow></mrow><mo lspace="0.170em" rspace="0em">​</mo><mi class="ltx_font_mathcaligraphic">𝒫</mi><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>s</mi><mo>,</mo><mi>a</mi><mo stretchy="false">)</mo></mrow><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msup><mi>s</mi><mo>′</mo></msup><mo stretchy="false">)</mo></mrow></mrow></mrow></mrow><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">\mathcal{P}^{\pi}(s,s^{\prime})\mathrel{\overset{\mathrm{def}}{=}}\sum_{a\in d(s)}\pi(a\mid s)\,\mathcal{P}(s,a)(s^{\prime}).</annotation></semantics></math></p>
</div>
</section>
<section id="S3.SS0.SSS0.Px2" class="ltx_paragraph">
<h5 class="ltx_title ltx_title_paragraph">Safe LTL.</h5>

<div id="S3.SS0.SSS0.Px2.p1" class="ltx_para">
<p id="S3.SS0.SSS0.Px2.p1.1" class="ltx_p">We express the desired global behaviour as a trace property in the safety fragment of <em id="S3.SS0.SSS0.Px2.p1.1.1" class="ltx_emph ltx_font_italic">Linear Temporal Logic</em>, denoted <math id="S3.SS0.SSS0.Px2.p1.m1" class="ltx_Math" alttext="\mathsf{LTL}_{\mathsf{safe}}" display="inline" intent=":literal"><semantics><msub><mi>𝖫𝖳𝖫</mi><mi>𝗌𝖺𝖿𝖾</mi></msub><annotation encoding="application/x-tex">\mathsf{LTL}_{\mathsf{safe}}</annotation></semantics></math>. We consider a <em id="S3.SS0.SSS0.Px2.p1.1.2" class="ltx_emph ltx_font_italic">labelled stochastic game</em> obtained by extending a Markov game <math id="S3.SS0.SSS0.Px2.p1.m2" class="ltx_Math" alttext="\mathcal{M}" display="inline" intent=":literal"><semantics><mi class="ltx_font_mathcaligraphic">ℳ</mi><annotation encoding="application/x-tex">\mathcal{M}</annotation></semantics></math> with a finite global alphabet <math id="S3.SS0.SSS0.Px2.p1.m3" class="ltx_Math" alttext="\mathsf{Ap}" display="inline" intent=":literal"><semantics><mi>𝖠𝗉</mi><annotation encoding="application/x-tex">\mathsf{Ap}</annotation></semantics></math> and a global labelling function
<math id="S3.SS0.SSS0.Px2.p1.m4" class="ltx_Math" alttext="\mathcal{L}:\mathcal{S}\to 2^{\mathsf{Ap}}" display="inline" intent=":literal"><semantics><mrow><mi class="ltx_font_mathcaligraphic">ℒ</mi><mo lspace="0.278em" rspace="0.278em">:</mo><mrow><mi class="ltx_font_mathcaligraphic">𝒮</mi><mo stretchy="false">→</mo><msup><mn>2</mn><mi>𝖠𝗉</mi></msup></mrow></mrow><annotation encoding="application/x-tex">\mathcal{L}:\mathcal{S}\to 2^{\mathsf{Ap}}</annotation></semantics></math>. The shared safety objective is interpreted over this global labelling. For decentralised contracts we also fix local alphabets <math id="S3.SS0.SSS0.Px2.p1.m5" class="ltx_Math" alttext="\mathsf{Ap}_{i}\subseteq\mathsf{Ap}" display="inline" intent=":literal"><semantics><mrow><msub><mi>𝖠𝗉</mi><mi>i</mi></msub><mo>⊆</mo><mi>𝖠𝗉</mi></mrow><annotation encoding="application/x-tex">\mathsf{Ap}_{i}\subseteq\mathsf{Ap}</annotation></semantics></math> which specify the global propositions that agent <math id="S3.SS0.SSS0.Px2.p1.m6" class="ltx_Math" alttext="i" display="inline" intent=":literal"><semantics><mi>i</mi><annotation encoding="application/x-tex">i</annotation></semantics></math>’s local obligations may mention. Along a path, local observations are obtained by projecting the global labels to <math id="S3.SS0.SSS0.Px2.p1.m7" class="ltx_Math" alttext="\mathsf{Ap}_{i}" display="inline" intent=":literal"><semantics><msub><mi>𝖠𝗉</mi><mi>i</mi></msub><annotation encoding="application/x-tex">\mathsf{Ap}_{i}</annotation></semantics></math>.
The syntax of the safety fragment is generated by the following grammar:</p>
<table id="S3.Ex2" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="S3.Ex2.m1" class="ltx_Math" alttext="\begin{array}[]{rcl}\phi&amp;::=&amp;\top\mid\bot\mid p\mid\neg p\mid\phi\wedge\phi\mid\phi\vee\phi\mid\mathsf{X}\phi\mid\phi\mathsf{W}\phi,\end{array}" display="block" intent=":literal"><semantics><mtable columnspacing="5pt" displaystyle="true"><mtr><mtd class="ltx_align_right" columnalign="right"><mi>ϕ</mi></mtd><mtd><mrow><mo>:</mo><mo lspace="0em">⁣</mo><mo>:=</mo></mrow></mtd><mtd class="ltx_align_left" columnalign="left"><mrow><mo rspace="0em">⊤</mo><mo fence="false" lspace="0em" rspace="0em">|</mo><mrow><mo lspace="0em" rspace="0em">⊥</mo><mo fence="false" lspace="0em">|</mo><mrow><mi>p</mi><mo fence="false">|</mo><mrow><mrow><mo rspace="0.167em">¬</mo><mrow><mi>p</mi><mo lspace="0em" rspace="0em">​</mo><mrow><mo rspace="0.167em">∣</mo><mrow><mi>ϕ</mi><mo>∧</mo><mrow><mi>ϕ</mi><mo lspace="0em" rspace="0em">​</mo><mrow><mo rspace="0.167em">∣</mo><mrow><mi>ϕ</mi><mo>∨</mo><mi>ϕ</mi></mrow><mo lspace="0em">∣</mo></mrow><mo lspace="0.167em" rspace="0em">​</mo><mi>𝖷</mi><mo lspace="0em" rspace="0em">​</mo><mi>ϕ</mi></mrow></mrow><mo lspace="0em">∣</mo></mrow><mo lspace="0.167em" rspace="0em">​</mo><mi>ϕ</mi><mo lspace="0em" rspace="0em">​</mo><mi>𝖶</mi><mo lspace="0em" rspace="0em">​</mo><mi>ϕ</mi></mrow></mrow><mo>,</mo></mrow></mrow></mrow></mrow></mtd></mtr></mtable><annotation encoding="application/x-tex">\begin{array}[]{rcl}\phi&amp;::=&amp;\top\mid\bot\mid p\mid\neg p\mid\phi\wedge\phi\mid\phi\vee\phi\mid\mathsf{X}\phi\mid\phi\mathsf{W}\phi,\end{array}</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="S3.SS0.SSS0.Px2.p1.2" class="ltx_p">where <math id="S3.SS0.SSS0.Px2.p1.m8" class="ltx_Math" alttext="p\in\mathsf{Ap}" display="inline" intent=":literal"><semantics><mrow><mi>p</mi><mo>∈</mo><mi>𝖠𝗉</mi></mrow><annotation encoding="application/x-tex">p\in\mathsf{Ap}</annotation></semantics></math>, and <math id="S3.SS0.SSS0.Px2.p1.m9" class="ltx_Math" alttext="\top,\bot" display="inline" intent=":literal"><semantics><mrow><mo rspace="0em">⊤</mo><mo rspace="0em">,</mo><mo lspace="0em">⊥</mo></mrow><annotation encoding="application/x-tex">\top,\bot</annotation></semantics></math> denote the Boolean constants. We read <math id="S3.SS0.SSS0.Px2.p1.m10" class="ltx_Math" alttext="\mathsf{X}" display="inline" intent=":literal"><semantics><mi>𝖷</mi><annotation encoding="application/x-tex">\mathsf{X}</annotation></semantics></math> as <span id="S3.SS0.SSS0.Px2.p1.2.1" class="ltx_text ltx_font_italic">next</span> and <math id="S3.SS0.SSS0.Px2.p1.m11" class="ltx_Math" alttext="\mathsf{W}" display="inline" intent=":literal"><semantics><mi>𝖶</mi><annotation encoding="application/x-tex">\mathsf{W}</annotation></semantics></math> as <span id="S3.SS0.SSS0.Px2.p1.2.2" class="ltx_text ltx_font_italic">weak until</span>: <math id="S3.SS0.SSS0.Px2.p1.m12" class="ltx_Math" alttext="\phi\mathsf{W}\psi" display="inline" intent=":literal"><semantics><mrow><mi>ϕ</mi><mo lspace="0em" rspace="0em">​</mo><mi>𝖶</mi><mo lspace="0em" rspace="0em">​</mo><mi>ψ</mi></mrow><annotation encoding="application/x-tex">\phi\mathsf{W}\psi</annotation></semantics></math> requires <math id="S3.SS0.SSS0.Px2.p1.m13" class="ltx_Math" alttext="\phi" display="inline" intent=":literal"><semantics><mi>ϕ</mi><annotation encoding="application/x-tex">\phi</annotation></semantics></math> until <math id="S3.SS0.SSS0.Px2.p1.m14" class="ltx_Math" alttext="\psi" display="inline" intent=":literal"><semantics><mi>ψ</mi><annotation encoding="application/x-tex">\psi</annotation></semantics></math>, or <math id="S3.SS0.SSS0.Px2.p1.m15" class="ltx_Math" alttext="\phi" display="inline" intent=":literal"><semantics><mi>ϕ</mi><annotation encoding="application/x-tex">\phi</annotation></semantics></math> forever if <math id="S3.SS0.SSS0.Px2.p1.m16" class="ltx_Math" alttext="\psi" display="inline" intent=":literal"><semantics><mi>ψ</mi><annotation encoding="application/x-tex">\psi</annotation></semantics></math> never occurs. Thus the fragment captures invariance-style properties: negation is restricted to atoms and temporal progression is expressed through next and weak until. This presentation is equivalent to the standard negation-normal Safety LTL fragment using <math id="S3.SS0.SSS0.Px2.p1.m17" class="ltx_Math" alttext="\mathsf{X}" display="inline" intent=":literal"><semantics><mi>𝖷</mi><annotation encoding="application/x-tex">\mathsf{X}</annotation></semantics></math>, <math id="S3.SS0.SSS0.Px2.p1.m18" class="ltx_Math" alttext="\mathsf{R}" display="inline" intent=":literal"><semantics><mi>𝖱</mi><annotation encoding="application/x-tex">\mathsf{R}</annotation></semantics></math>, and <math id="S3.SS0.SSS0.Px2.p1.m19" class="ltx_Math" alttext="\mathsf{W}" display="inline" intent=":literal"><semantics><mi>𝖶</mi><annotation encoding="application/x-tex">\mathsf{W}</annotation></semantics></math> <cite class="ltx_cite ltx_citemacro_cite">[<a href="#bib.bib7" title="" class="ltx_ref">24</a>]</cite>, since <math id="S3.SS0.SSS0.Px2.p1.m20" class="ltx_Math" alttext="\phi\mathsf{R}\psi" display="inline" intent=":literal"><semantics><mrow><mi>ϕ</mi><mo lspace="0em" rspace="0em">​</mo><mi>𝖱</mi><mo lspace="0em" rspace="0em">​</mo><mi>ψ</mi></mrow><annotation encoding="application/x-tex">\phi\mathsf{R}\psi</annotation></semantics></math> can be written as <math id="S3.SS0.SSS0.Px2.p1.m21" class="ltx_Math" alttext="\psi\mathsf{W}(\phi\wedge\psi)" display="inline" intent=":literal"><semantics><mrow><mi>ψ</mi><mo lspace="0em" rspace="0em">​</mo><mi>𝖶</mi><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mrow><mi>ϕ</mi><mo>∧</mo><mi>ψ</mi></mrow><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">\psi\mathsf{W}(\phi\wedge\psi)</annotation></semantics></math>. We use the always operator <math id="S3.SS0.SSS0.Px2.p1.m22" class="ltx_Math" alttext="\mathsf{G}\phi\mathrel{\overset{\mathrm{def}}{=}}\phi\mathsf{W}\bot" display="inline" intent=":literal"><semantics><mrow><mrow><mi>𝖦</mi><mo lspace="0em" rspace="0em">​</mo><mi>ϕ</mi></mrow><mover accent="true"><mo>=</mo><mo mathsize="0.700em">def</mo></mover><mrow><mrow><mi>ϕ</mi><mo lspace="0em" rspace="0em">​</mo><mi>𝖶</mi></mrow><mo lspace="0.222em">⊥</mo></mrow></mrow><annotation encoding="application/x-tex">\mathsf{G}\phi\mathrel{\overset{\mathrm{def}}{=}}\phi\mathsf{W}\bot</annotation></semantics></math>. The connectives <math id="S3.SS0.SSS0.Px2.p1.m23" class="ltx_Math" alttext="\rightarrow" display="inline" intent=":literal"><semantics><mo stretchy="false">→</mo><annotation encoding="application/x-tex">\rightarrow</annotation></semantics></math> and <math id="S3.SS0.SSS0.Px2.p1.m24" class="ltx_Math" alttext="\leftrightarrow" display="inline" intent=":literal"><semantics><mo stretchy="false">↔</mo><annotation encoding="application/x-tex">\leftrightarrow</annotation></semantics></math> are used only as standard abbreviations with their expansions normalised to the safety grammar, since negation is only allowed on atomic propositions.</p>
</div>
<div id="S3.SS0.SSS0.Px2.p2" class="ltx_para">
<p id="S3.SS0.SSS0.Px2.p2.1" class="ltx_p">Let <math id="S3.SS0.SSS0.Px2.p2.m1" class="ltx_Math" alttext="\mathcal{T}\mathrel{\overset{\mathrm{def}}{=}}(2^{\mathsf{Ap}})^{\omega}" display="inline" intent=":literal"><semantics><mrow><mi class="ltx_font_mathcaligraphic">𝒯</mi><mover accent="true"><mo>=</mo><mo mathsize="0.700em">def</mo></mover><msup><mrow><mo stretchy="false">(</mo><msup><mn>2</mn><mi>𝖠𝗉</mi></msup><mo stretchy="false">)</mo></mrow><mi>ω</mi></msup></mrow><annotation encoding="application/x-tex">\mathcal{T}\mathrel{\overset{\mathrm{def}}{=}}(2^{\mathsf{Ap}})^{\omega}</annotation></semantics></math> be the set of traces over <math id="S3.SS0.SSS0.Px2.p2.m2" class="ltx_Math" alttext="\mathsf{Ap}" display="inline" intent=":literal"><semantics><mi>𝖠𝗉</mi><annotation encoding="application/x-tex">\mathsf{Ap}</annotation></semantics></math>. Each path <math id="S3.SS0.SSS0.Px2.p2.m3" class="ltx_math_unparsed" alttext="\rho=s_{0}s_{1}s_{2}\cdots\in\mathsf{IPath}^{\pi}(s)" display="inline" intent=":literal"><semantics><mrow><mi>ρ</mi><mo>=</mo><msub><mi>s</mi><mn>0</mn></msub><msub><mi>s</mi><mn>1</mn></msub><msub><mi>s</mi><mn>2</mn></msub><mo lspace="0em" rspace="0.1389em">⋯</mo><mo lspace="0.1389em">∈</mo><msup><mi>𝖨𝖯𝖺𝗍𝗁</mi><mi>π</mi></msup><mrow><mo stretchy="false">(</mo><mi>s</mi><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">\rho=s_{0}s_{1}s_{2}\cdots\in\mathsf{IPath}^{\pi}(s)</annotation></semantics></math> induces the global trace <math id="S3.SS0.SSS0.Px2.p2.m4" class="ltx_math_unparsed" alttext="\mathcal{T}_{\mathcal{L}}(\rho)\mathrel{\overset{\mathrm{def}}{=}}\mathcal{L}(s_{0})\,\mathcal{L}(s_{1})\,\mathcal{L}(s_{2})\cdots\in\mathcal{T}" display="inline" intent=":literal"><semantics><mrow><msub><mi class="ltx_font_mathcaligraphic">𝒯</mi><mi class="ltx_font_mathcaligraphic">ℒ</mi></msub><mrow><mo stretchy="false">(</mo><mi>ρ</mi><mo stretchy="false">)</mo></mrow><mover accent="true"><mo>=</mo><mo mathsize="0.700em">def</mo></mover><mi class="ltx_font_mathcaligraphic">ℒ</mi><mrow><mo stretchy="false">(</mo><msub><mi>s</mi><mn>0</mn></msub><mo rspace="0.170em" stretchy="false">)</mo></mrow><mi class="ltx_font_mathcaligraphic">ℒ</mi><mrow><mo stretchy="false">(</mo><msub><mi>s</mi><mn>1</mn></msub><mo rspace="0.170em" stretchy="false">)</mo></mrow><mi class="ltx_font_mathcaligraphic">ℒ</mi><mrow><mo stretchy="false">(</mo><msub><mi>s</mi><mn>2</mn></msub><mo stretchy="false">)</mo></mrow><mo lspace="0em" rspace="0.1389em">⋯</mo><mo lspace="0.1389em">∈</mo><mi class="ltx_font_mathcaligraphic">𝒯</mi></mrow><annotation encoding="application/x-tex">\mathcal{T}_{\mathcal{L}}(\rho)\mathrel{\overset{\mathrm{def}}{=}}\mathcal{L}(s_{0})\,\mathcal{L}(s_{1})\,\mathcal{L}(s_{2})\cdots\in\mathcal{T}</annotation></semantics></math> and, for each agent <math id="S3.SS0.SSS0.Px2.p2.m5" class="ltx_Math" alttext="i" display="inline" intent=":literal"><semantics><mi>i</mi><annotation encoding="application/x-tex">i</annotation></semantics></math>, the local trace <math id="S3.SS0.SSS0.Px2.p2.m6" class="ltx_math_unparsed" alttext="\mathcal{T}_{\mathcal{L}}(\rho)\!\upharpoonright_{\mathsf{Ap}_{i}}\mathrel{\overset{\mathrm{def}}{=}}(\mathcal{L}(s_{0})\cap\mathsf{Ap}_{i})\,(\mathcal{L}(s_{1})\cap\mathsf{Ap}_{i})\,(\mathcal{L}(s_{2})\cap\mathsf{Ap}_{i})\cdots\in(2^{\mathsf{Ap}_{i}})^{\omega}" display="inline" intent=":literal"><semantics><mrow><msub><mi class="ltx_font_mathcaligraphic">𝒯</mi><mi class="ltx_font_mathcaligraphic">ℒ</mi></msub><mrow><mo stretchy="false">(</mo><mi>ρ</mi><mo stretchy="false">)</mo></mrow><msub><mo lspace="0.108em" rspace="0em" stretchy="false">↾</mo><msub><mi>𝖠𝗉</mi><mi>i</mi></msub></msub><mover accent="true"><mo lspace="0em">=</mo><mo mathsize="0.700em">def</mo></mover><mrow><mo stretchy="false">(</mo><mi class="ltx_font_mathcaligraphic">ℒ</mi><mrow><mo stretchy="false">(</mo><msub><mi>s</mi><mn>0</mn></msub><mo stretchy="false">)</mo></mrow><mo>∩</mo><msub><mi>𝖠𝗉</mi><mi>i</mi></msub><mo rspace="0.170em" stretchy="false">)</mo></mrow><mrow><mo stretchy="false">(</mo><mi class="ltx_font_mathcaligraphic">ℒ</mi><mrow><mo stretchy="false">(</mo><msub><mi>s</mi><mn>1</mn></msub><mo stretchy="false">)</mo></mrow><mo>∩</mo><msub><mi>𝖠𝗉</mi><mi>i</mi></msub><mo rspace="0.170em" stretchy="false">)</mo></mrow><mrow><mo stretchy="false">(</mo><mi class="ltx_font_mathcaligraphic">ℒ</mi><mrow><mo stretchy="false">(</mo><msub><mi>s</mi><mn>2</mn></msub><mo stretchy="false">)</mo></mrow><mo>∩</mo><msub><mi>𝖠𝗉</mi><mi>i</mi></msub><mo stretchy="false">)</mo></mrow><mo lspace="0em" rspace="0.1389em">⋯</mo><mo lspace="0.1389em">∈</mo><msup><mrow><mo stretchy="false">(</mo><msup><mn>2</mn><msub><mi>𝖠𝗉</mi><mi>i</mi></msub></msup><mo stretchy="false">)</mo></mrow><mi>ω</mi></msup></mrow><annotation encoding="application/x-tex">\mathcal{T}_{\mathcal{L}}(\rho)\!\upharpoonright_{\mathsf{Ap}_{i}}\mathrel{\overset{\mathrm{def}}{=}}(\mathcal{L}(s_{0})\cap\mathsf{Ap}_{i})\,(\mathcal{L}(s_{1})\cap\mathsf{Ap}_{i})\,(\mathcal{L}(s_{2})\cap\mathsf{Ap}_{i})\cdots\in(2^{\mathsf{Ap}_{i}})^{\omega}</annotation></semantics></math>. We write <math id="S3.SS0.SSS0.Px2.p2.m7" class="ltx_Math" alttext="(\tau,k)\models\phi" display="inline" intent=":literal"><semantics><mrow><mrow><mo stretchy="false">(</mo><mi>τ</mi><mo>,</mo><mi>k</mi><mo stretchy="false">)</mo></mrow><mo>⊧</mo><mi>ϕ</mi></mrow><annotation encoding="application/x-tex">(\tau,k)\models\phi</annotation></semantics></math> when formula <math id="S3.SS0.SSS0.Px2.p2.m8" class="ltx_Math" alttext="\phi" display="inline" intent=":literal"><semantics><mi>ϕ</mi><annotation encoding="application/x-tex">\phi</annotation></semantics></math> holds at position <math id="S3.SS0.SSS0.Px2.p2.m9" class="ltx_Math" alttext="k" display="inline" intent=":literal"><semantics><mi>k</mi><annotation encoding="application/x-tex">k</annotation></semantics></math> of trace <math id="S3.SS0.SSS0.Px2.p2.m10" class="ltx_Math" alttext="\tau" display="inline" intent=":literal"><semantics><mi>τ</mi><annotation encoding="application/x-tex">\tau</annotation></semantics></math>, and <math id="S3.SS0.SSS0.Px2.p2.m11" class="ltx_Math" alttext="\tau\models\phi" display="inline" intent=":literal"><semantics><mrow><mi>τ</mi><mo>⊧</mo><mi>ϕ</mi></mrow><annotation encoding="application/x-tex">\tau\models\phi</annotation></semantics></math> for satisfaction at position <math id="S3.SS0.SSS0.Px2.p2.m12" class="ltx_Math" alttext="0" display="inline" intent=":literal"><semantics><mn>0</mn><annotation encoding="application/x-tex">0</annotation></semantics></math>. The inductive trace semantics are given in Appendix <a href="#Pt0.A1" title="Appendix 0.A Safe LTL Semantics ‣ Contract-Based Compositional Shielding for Safe Multi-Agent Reinforcement Learning" class="ltx_ref"><span class="ltx_text ltx_ref_tag">0.A</span></a> as standard. In the main text we use the induced-chain satisfaction relation
<math id="S3.SS0.SSS0.Px2.p2.m13" class="ltx_Math" alttext="\mathcal{M}^{\pi}\models\phi\quad\text{iff}\quad\mathcal{T}_{\mathcal{L}}(\rho)\models\phi\text{ for every }\rho\in\mathsf{IPath}^{\pi}(s_{0})." display="inline" intent=":literal"><semantics><mrow><mrow><mrow><msup><mi class="ltx_font_mathcaligraphic">ℳ</mi><mi>π</mi></msup><mo>⊧</mo><mi>ϕ</mi></mrow><mspace style="width:1em;" width="1em"></mspace><mtext>iff</mtext><mspace style="width:1em;" width="1em"></mspace><mrow><mrow><msub><mi class="ltx_font_mathcaligraphic">𝒯</mi><mi class="ltx_font_mathcaligraphic">ℒ</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>ρ</mi><mo stretchy="false">)</mo></mrow></mrow><mo>⊧</mo><mrow><mi>ϕ</mi><mo lspace="0em" rspace="0em">​</mo><mtext> for every </mtext><mo lspace="0em" rspace="0em">​</mo><mi>ρ</mi></mrow><mo>∈</mo><mrow><msup><mi>𝖨𝖯𝖺𝗍𝗁</mi><mi>π</mi></msup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mi>s</mi><mn>0</mn></msub><mo stretchy="false">)</mo></mrow></mrow></mrow></mrow><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">\mathcal{M}^{\pi}\models\phi\quad\text{iff}\quad\mathcal{T}_{\mathcal{L}}(\rho)\models\phi\text{ for every }\rho\in\mathsf{IPath}^{\pi}(s_{0}).</annotation></semantics></math>
Thus satisfaction is universal over paths: a policy satisfies the safety formula only when all possible executions that it can generate satisfy the formula.</p>
</div>
</section>
<section id="S3.SS0.SSS0.Px3" class="ltx_paragraph">
<h5 class="ltx_title ltx_title_paragraph">Problem Statement.</h5>

<div id="S3.SS0.SSS0.Px3.p1" class="ltx_para">
<p id="S3.SS0.SSS0.Px3.p1.1" class="ltx_p">In the labelled cooperative stochastic game defined above, fix a shared safety specification <math id="S3.SS0.SSS0.Px3.p1.m1" class="ltx_Math" alttext="\Phi_{\mathsf{safe}}\in\mathsf{LTL}_{\mathsf{safe}}(\mathsf{Ap})" display="inline" intent=":literal"><semantics><mrow><msub><mi mathvariant="normal">Φ</mi><mi>𝗌𝖺𝖿𝖾</mi></msub><mo>∈</mo><mrow><msub><mi>𝖫𝖳𝖫</mi><mi>𝗌𝖺𝖿𝖾</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>𝖠𝗉</mi><mo stretchy="false">)</mo></mrow></mrow></mrow><annotation encoding="application/x-tex">\Phi_{\mathsf{safe}}\in\mathsf{LTL}_{\mathsf{safe}}(\mathsf{Ap})</annotation></semantics></math>. For a joint policy <math id="S3.SS0.SSS0.Px3.p1.m2" class="ltx_Math" alttext="\pi=(\pi^{1},\dots,\pi^{n})" display="inline" intent=":literal"><semantics><mrow><mi>π</mi><mo>=</mo><mrow><mo stretchy="false">(</mo><msup><mi>π</mi><mn>1</mn></msup><mo>,</mo><mi mathvariant="normal">…</mi><mo>,</mo><msup><mi>π</mi><mi>n</mi></msup><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">\pi=(\pi^{1},\dots,\pi^{n})</annotation></semantics></math>, the safe policy set is
<math id="S3.SS0.SSS0.Px3.p1.m3" class="ltx_Math" alttext="\Pi_{\mathsf{safe}}\mathrel{\overset{\mathrm{def}}{=}}\left\{\pi\;\middle|\;\mathcal{M}^{\pi}\models\Phi_{\mathsf{safe}}\right\}." display="inline" intent=":literal"><semantics><mrow><mrow><msub><mi mathvariant="normal">Π</mi><mi>𝗌𝖺𝖿𝖾</mi></msub><mover accent="true"><mo>=</mo><mo mathsize="0.700em">def</mo></mover><mrow><mo>{</mo><mi>π</mi><mo stretchy="true">|</mo><mrow><msup><mi class="ltx_font_mathcaligraphic">ℳ</mi><mi>π</mi></msup><mo>⊧</mo><msub><mi mathvariant="normal">Φ</mi><mi>𝗌𝖺𝖿𝖾</mi></msub></mrow><mo>}</mo></mrow></mrow><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">\Pi_{\mathsf{safe}}\mathrel{\overset{\mathrm{def}}{=}}\left\{\pi\;\middle|\;\mathcal{M}^{\pi}\models\Phi_{\mathsf{safe}}\right\}.</annotation></semantics></math>
The formal target is to find a
team-return-optimal safe joint policy, that is:</p>
<table id="S3.Ex3" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="S3.Ex3.m1" class="ltx_Math" alttext="\pi^{\star}\in\arg\max_{\pi\in\Pi_{\mathsf{safe}}}J_{s_{0}}(\pi)." display="block" intent=":literal"><semantics><mrow><mrow><msup><mi>π</mi><mo>⋆</mo></msup><mo>∈</mo><mrow><mrow><mi>arg</mi><mo lspace="0.167em">⁡</mo><munder><mi>max</mi><mrow><mi>π</mi><mo>∈</mo><msub><mi mathvariant="normal">Π</mi><mi>𝗌𝖺𝖿𝖾</mi></msub></mrow></munder></mrow><mo lspace="0.167em" rspace="0em">​</mo><msub><mi>J</mi><msub><mi>s</mi><mn>0</mn></msub></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>π</mi><mo stretchy="false">)</mo></mrow></mrow></mrow><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">\pi^{\star}\in\arg\max_{\pi\in\Pi_{\mathsf{safe}}}J_{s_{0}}(\pi).</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="S3.SS0.SSS0.Px3.p1.2" class="ltx_p">Thus the objective is not merely to rule out unsafe executions: among policies whose induced traces all satisfy the temporal safety property, the learner should preserve as much discounted team return as possible. As in Example <a href="#Thmexample1" title="Example 1 ‣ 1 Introduction ‣ Contract-Based Compositional Shielding for Safe Multi-Agent Reinforcement Learning" class="ltx_ref"><span class="ltx_text ltx_ref_tag">1</span></a>, the optimum may require coordinated joint actions that a Cartesian decomposition of the central safe-action relation would discard. We target decentralised execution: each shield restricts one agent to locally admissible actions, while certification of the active contract ensures every joint execution admitted by the distributed masks satisfies <math id="S3.SS0.SSS0.Px3.p1.m4" class="ltx_Math" alttext="\Phi_{\mathsf{safe}}" display="inline" intent=":literal"><semantics><msub><mi mathvariant="normal">Φ</mi><mi>𝗌𝖺𝖿𝖾</mi></msub><annotation encoding="application/x-tex">\Phi_{\mathsf{safe}}</annotation></semantics></math>.</p>
</div>
</section>
</section>
<section id="S4" class="ltx_section">
<h2 class="ltx_title ltx_title_section"><span class="ltx_tag ltx_tag_section">4 </span>Contract Shielding</h2>

<div id="S4.p1" class="ltx_para">
<p id="S4.p1.1" class="ltx_p">Contract shield synthesis constructs decentralised action masks whose Cartesian product is safe under a globally certified contract. Rather than deploying the central safety-game action relation directly, the construction compiles candidate local obligations into automata and certifies local action rectangles through a contract-product fixed point. We use a finite <em id="S4.p1.1.1" class="ltx_emph ltx_font_italic">safety abstraction</em>, obtainable by bisimulation <cite class="ltx_cite ltx_citemacro_cite">[<a href="#bib.bib10" title="" class="ltx_ref">10</a>]</cite>, that is exact for the contract shielding problem. Each contract supplies one temporal obligation per agent. Using the finite bad-prefix characterisation of safety properties <cite class="ltx_cite ltx_citemacro_cite">[<a href="#bib.bib6" title="" class="ltx_ref">17</a>]</cite>, each local <math id="S4.p1.m1" class="ltx_Math" alttext="\mathsf{LTL}_{\mathsf{safe}}" display="inline" intent=":literal"><semantics><msub><mi>𝖫𝖳𝖫</mi><mi>𝗌𝖺𝖿𝖾</mi></msub><annotation encoding="application/x-tex">\mathsf{LTL}_{\mathsf{safe}}</annotation></semantics></math> obligation induces a finite deterministic safety monitor: its bad states recognise exactly the finite prefixes from which the obligation is irrecoverably violated. The shield is synthesised from their product with the environment and certifying non-reachability of unsafe states; the resulting fixed point certifies decentralised action interfaces as opposed to a central joint-action controller.</p>
</div>
<div id="S4.p2" class="ltx_para">
<p id="S4.p2.1" class="ltx_p">Figure <a href="#S4.F2" title="Figure 2 ‣ 4 Contract Shielding ‣ Contract-Based Compositional Shielding for Safe Multi-Agent Reinforcement Learning" class="ltx_ref"><span class="ltx_text ltx_ref_tag">2</span></a> summarises our approach. The labelled game and global safety specification are compiled into contract-specific safety products with local obligations providing the assume-guarantee interface of Section <a href="#S4.SS1" title="4.1 Assume-Guarantee Contracts ‣ 4 Contract Shielding ‣ Contract-Based Compositional Shielding for Safe Multi-Agent Reinforcement Learning" class="ltx_ref"><span class="ltx_text ltx_ref_tag">4.1</span></a>; resulting contract products are solved and projected to decentralised masks in Section <a href="#S4.SS2" title="4.2 Contract Product Shields ‣ 4 Contract Shielding ‣ Contract-Based Compositional Shielding for Safe Multi-Agent Reinforcement Learning" class="ltx_ref"><span class="ltx_text ltx_ref_tag">4.2</span></a>. The certified contracts then form the library used for learning-time selection in Section <a href="#S5" title="5 Learning with Contract Shields ‣ Contract-Based Compositional Shielding for Safe Multi-Agent Reinforcement Learning" class="ltx_ref"><span class="ltx_text ltx_ref_tag">5</span></a>.</p>
</div>
<figure id="S4.F2" class="ltx_figure">
<div id="S4.F2.2" class="ltx_inline-block ltx_align_center ltx_transformed_outer" style="width:345.0pt;height:44.2pt;vertical-align:-0.0pt;"><span class="ltx_transformed_inner" style="transform:translate(-78.5pt,10.1pt) scale(0.7,0.7) ;">
