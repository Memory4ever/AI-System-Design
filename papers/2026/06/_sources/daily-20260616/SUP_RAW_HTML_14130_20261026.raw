\lxSVG@closescope }
\lxSVG@closescope {\lx@inpgf@ignorespaces}{\lx@inpgf@ignorespaces}{\lx@inpgf@ignorespaces}\hss}\lxSVG@discardpath\lxSVG@closescope \hss}}\lxSVG@closescope\endpgfpicture}}}}}}^{\mathcal{C},i}(x^{\mathcal{C}})|}{|d^{i}(s)|}.</annotation></semantics></math></p>
</div>
</div>
