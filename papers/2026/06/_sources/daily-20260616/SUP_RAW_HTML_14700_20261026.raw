<th id="S4.T3.2.1.2" class="ltx_td ltx_align_center ltx_th ltx_th_column"><span id="S4.T3.2.1.2.1" class="ltx_text ltx_font_bold" style="font-size:90%;"># Params</span></th>
<th id="S4.T3.2.1.3" class="ltx_td ltx_align_center ltx_th ltx_th_column"><span id="S4.T3.2.1.3.1" class="ltx_text ltx_font_bold" style="font-size:90%;">GenEval <math id="S4.T3.m1" class="ltx_Math" alttext="\uparrow" display="inline" intent=":literal"><semantics><mo stretchy="false">↑</mo><annotation encoding="application/x-tex">\uparrow</annotation></semantics></math></span></th></tr>
