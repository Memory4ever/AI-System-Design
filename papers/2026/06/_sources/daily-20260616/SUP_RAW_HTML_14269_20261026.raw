<th id="S6.T14.4.2.1" class="ltx_td ltx_align_left ltx_th ltx_th_row ltx_border_t">Standard Top-K</th>
<td id="S6.T14.4.2.2" class="ltx_td ltx_align_center ltx_border_t"><math id="S6.T14.m1" class="ltx_Math" alttext="405\pm 12" display="inline" intent=":literal"><semantics><mrow><mn>405</mn><mo>±</mo><mn>12</mn></mrow><annotation encoding="application/x-tex">405\pm 12</annotation></semantics></math> ms</td></tr>
<tr id="S6.T14.4.3" class="ltx_tr">
<th id="S6.T14.4.3.1" class="ltx_td ltx_align_left ltx_th ltx_th_row">ScoreGate (ours)</th>
