<th id="S5.T10.4.1.2" class="ltx_td ltx_align_center ltx_th ltx_th_column ltx_border_tt"><span id="S5.T10.4.1.2.1" class="ltx_text ltx_font_bold">Standard Top-K</span></th>
<th id="S5.T10.4.1.3" class="ltx_td ltx_align_center ltx_th ltx_th_column ltx_border_tt"><span id="S5.T10.4.1.3.1" class="ltx_text ltx_font_bold">ScoreGate</span></th>
<th id="S5.T10.4.1.4" class="ltx_td ltx_align_center ltx_th ltx_th_column ltx_border_tt"><math id="S5.T10.m15" class="ltx_Math" alttext="\Delta" display="inline" intent=":literal"><semantics><mi mathvariant="normal">Δ</mi><annotation encoding="application/x-tex">\Delta</annotation></semantics></math></th></tr>
