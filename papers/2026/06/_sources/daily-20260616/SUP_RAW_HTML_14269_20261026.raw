<span id="S6.T13.4.1.1.1" class="ltx_inline-block ltx_align_top" style="width:85.4pt;">
<span id="S6.T13.4.1.1.1.1" class="ltx_p"><span id="S6.T13.4.1.1.1.1.1" class="ltx_text ltx_font_bold" style="font-size:90%;">Query</span></span>
</span></th>
<th id="S6.T13.4.1.2" class="ltx_td ltx_align_left ltx_align_top ltx_th ltx_th_column ltx_border_tt">
<span id="S6.T13.4.1.2.1" class="ltx_inline-block ltx_align_top" style="width:99.6pt;">
<span id="S6.T13.4.1.2.1.1" class="ltx_p"><span id="S6.T13.4.1.2.1.1.1" class="ltx_text ltx_font_bold" style="font-size:90%;">Chunk description</span></span>
</span></th>
<th id="S6.T13.4.1.3" class="ltx_td ltx_align_center ltx_th ltx_th_column ltx_border_tt"><span id="S6.T13.4.1.3.1" class="ltx_text ltx_font_bold" style="font-size:90%;">Bucket</span></th>
<th id="S6.T13.4.1.4" class="ltx_td ltx_align_left ltx_align_top ltx_th ltx_th_column ltx_border_tt">
<span id="S6.T13.4.1.4.1" class="ltx_inline-block ltx_align_top" style="width:99.6pt;">
<span id="S6.T13.4.1.4.1.1" class="ltx_p"><span id="S6.T13.4.1.4.1.1.1" class="ltx_text ltx_font_bold" style="font-size:90%;">Failure cause</span></span>
</span></th></tr>
