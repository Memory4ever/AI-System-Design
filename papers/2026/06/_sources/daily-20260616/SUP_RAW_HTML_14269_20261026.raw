<td id="S5.T10.4.2.3" class="ltx_td ltx_align_center ltx_border_t"><math id="S5.T10.m17" class="ltx_Math" alttext="4.27\pm 0.29" display="inline" intent=":literal"><semantics><mrow><mn>4.27</mn><mo>±</mo><mn>0.29</mn></mrow><annotation encoding="application/x-tex">4.27\pm 0.29</annotation></semantics></math></td>
<td id="S5.T10.4.2.4" class="ltx_td ltx_align_center ltx_border_t"><math id="S5.T10.m18" class="ltx_Math" alttext="+0.04" display="inline" intent=":literal"><semantics><mrow><mo>+</mo><mn>0.04</mn></mrow><annotation encoding="application/x-tex">+0.04</annotation></semantics></math></td></tr>
