<td id="S5.T3.2.8.1" class="ltx_td ltx_align_left" style="padding-left:4.0pt;padding-right:4.0pt;"><span id="S5.T3.2.8.1.1" class="ltx_text" style="font-size:70%;">gap (rank1<math id="S5.T3.m14" class="ltx_Math" alttext="-" display="inline" intent=":literal"><semantics><mo>−</mo><annotation encoding="application/x-tex">-</annotation></semantics></math>rank2)</span></td>
