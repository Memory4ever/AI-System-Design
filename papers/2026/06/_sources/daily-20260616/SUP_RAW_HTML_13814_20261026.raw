<tr id="S5.T5.2.3" class="ltx_tr">
<td id="S5.T5.2.3.1" class="ltx_td ltx_align_left" style="padding-left:3.0pt;padding-right:3.0pt;"><span id="S5.T5.2.3.1.1" class="ltx_text" style="font-size:70%;">qwen</span></td>
<td id="S5.T5.2.3.2" class="ltx_td ltx_align_right" style="padding-left:3.0pt;padding-right:3.0pt;"><math id="S5.T5.m13" class="ltx_Math" alttext="51.10" display="inline" intent=":literal"><semantics><mn mathsize="0.700em">51.10</mn><annotation encoding="application/x-tex">51.10</annotation></semantics></math></td>
