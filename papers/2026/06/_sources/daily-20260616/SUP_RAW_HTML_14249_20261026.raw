<div id="lstnumberx310" class="ltx_listingline"><span id="lstnumberx310.1" class="ltx_text ltx_lst_space ltx_font_typewriter" style="font-size:70%;">  </span><span id="lstnumberx310.2" class="ltx_text ltx_lst_identifier ltx_font_typewriter" style="font-size:70%;">before</span><span id="lstnumberx310.3" class="ltx_text ltx_lst_space ltx_font_typewriter" style="font-size:70%;"> </span><span id="lstnumberx310.4" class="ltx_text ltx_font_typewriter" style="font-size:70%;">`</span><span id="lstnumberx310.5" class="ltx_text ltx_lst_identifier ltx_font_typewriter" style="font-size:70%;">take</span><span id="lstnumberx310.6" class="ltx_text ltx_font_typewriter" style="font-size:70%;">`-</span><span id="lstnumberx310.7" class="ltx_text ltx_lst_identifier ltx_font_typewriter" style="font-size:70%;">ing</span><span id="lstnumberx310.8" class="ltx_text ltx_lst_space ltx_font_typewriter" style="font-size:70%;"> </span><span id="lstnumberx310.9" class="ltx_text ltx_lst_identifier ltx_font_typewriter" style="font-size:70%;">the</span><span id="lstnumberx310.10" class="ltx_text ltx_lst_space ltx_font_typewriter" style="font-size:70%;"> </span><span id="lstnumberx310.11" class="ltx_text ltx_lst_identifier ltx_font_typewriter" style="font-size:70%;">next</span><span id="lstnumberx310.12" class="ltx_text ltx_font_typewriter" style="font-size:70%;">.</span>
