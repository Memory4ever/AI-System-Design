              <math id="algorithm1.m15" class="ltx_Math" alttext="\mathcal{T}_{t+1}\leftarrow\mathcal{T}_{t}\cup\Delta\mathcal{T}_{t}" display="inline" intent=":literal"><semantics><mrow><msub><mi class="ltx_font_mathcaligraphic" mathsize="0.900em">𝒯</mi><mrow><mi mathsize="0.900em">t</mi><mo mathsize="0.900em">+</mo><mn mathsize="0.900em">1</mn></mrow></msub><mo mathsize="0.900em" stretchy="false">←</mo><mrow><msub><mi class="ltx_font_mathcaligraphic" mathsize="0.900em">𝒯</mi><mi mathsize="0.900em">t</mi></msub><mo mathsize="0.900em">∪</mo><mrow><mi mathsize="0.900em" mathvariant="normal">Δ</mi><mo lspace="0em" rspace="0em">​</mo><msub><mi class="ltx_font_mathcaligraphic" mathsize="0.900em">𝒯</mi><mi mathsize="0.900em">t</mi></msub></mrow></mrow></mrow><annotation encoding="application/x-tex">\mathcal{T}_{t+1}\leftarrow\mathcal{T}_{t}\cup\Delta\mathcal{T}_{t}</annotation></semantics></math><span id="algorithm1.6.8.4" class="ltx_text" style="font-size:90%;">;</span>
