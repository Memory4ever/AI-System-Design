<th id="S3.T2.3.1.2" class="ltx_td ltx_align_left ltx_th ltx_th_column ltx_border_tt"><span id="S3.T2.3.1.2.1" class="ltx_text ltx_font_bold" style="font-size:90%;">Symbolic-space dual</span></th>
<th id="S3.T2.3.1.3" class="ltx_td ltx_align_left ltx_th ltx_th_column ltx_border_tt"><span id="S3.T2.3.1.3.1" class="ltx_text ltx_font_bold" style="font-size:90%;">AEGIS realization</span></th></tr>
