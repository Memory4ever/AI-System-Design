</div>
<div id="lstnumberx328" class="ltx_listingline"><span id="lstnumberx328.1" class="ltx_text ltx_lst_space ltx_font_typewriter" style="font-size:70%;">  </span><span id="lstnumberx328.2" class="ltx_text ltx_font_typewriter" style="font-size:70%;">-</span><span id="lstnumberx328.3" class="ltx_text ltx_lst_space ltx_font_typewriter" style="font-size:70%;"> </span><span id="lstnumberx328.4" class="ltx_text ltx_lst_identifier ltx_font_typewriter" style="font-size:70%;">type</span><span id="lstnumberx328.5" class="ltx_text ltx_font_typewriter" style="font-size:70%;">:</span><span id="lstnumberx328.6" class="ltx_text ltx_lst_space ltx_font_typewriter" style="font-size:70%;"> </span><span id="lstnumberx328.7" class="ltx_text ltx_lst_identifier ltx_font_typewriter" style="font-size:70%;">http_endpoint</span>
</div>
<div id="lstnumberx329" class="ltx_listingline"><span id="lstnumberx329.1" class="ltx_text ltx_lst_space ltx_font_typewriter" style="font-size:70%;">    </span><span id="lstnumberx329.2" class="ltx_text ltx_lst_identifier ltx_font_typewriter" style="font-size:70%;">claim</span><span id="lstnumberx329.3" class="ltx_text ltx_font_typewriter" style="font-size:70%;">:</span><span id="lstnumberx329.4" class="ltx_text ltx_lst_space ltx_font_typewriter" style="font-size:70%;"> </span><span id="lstnumberx329.5" class="ltx_text ltx_font_typewriter" style="font-size:70%;">"</span><span id="lstnumberx329.6" class="ltx_text ltx_lst_identifier ltx_font_typewriter" style="font-size:70%;">MediaWiki</span><span id="lstnumberx329.7" class="ltx_text ltx_lst_space ltx_font_typewriter" style="font-size:70%;"> </span><span id="lstnumberx329.8" class="ltx_text ltx_lst_identifier ltx_font_typewriter" style="font-size:70%;">API</span><span id="lstnumberx329.9" class="ltx_text ltx_lst_space ltx_font_typewriter" style="font-size:70%;"> </span><span id="lstnumberx329.10" class="ltx_text ltx_lst_identifier ltx_font_typewriter" style="font-size:70%;">returns</span><span id="lstnumberx329.11" class="ltx_text ltx_lst_space ltx_font_typewriter" style="font-size:70%;"> </span><span id="lstnumberx329.12" class="ltx_text ltx_lst_identifier ltx_font_typewriter" style="font-size:70%;">full</span><span id="lstnumberx329.13" class="ltx_text ltx_lst_space ltx_font_typewriter" style="font-size:70%;"> </span><span id="lstnumberx329.14" class="ltx_text ltx_lst_identifier ltx_font_typewriter" style="font-size:70%;">plain</span><span id="lstnumberx329.15" class="ltx_text ltx_font_typewriter" style="font-size:70%;">-</span><span id="lstnumberx329.16" class="ltx_text ltx_lst_identifier ltx_font_typewriter" style="font-size:70%;">text</span><span id="lstnumberx329.17" class="ltx_text ltx_lst_space ltx_font_typewriter" style="font-size:70%;"> </span><span id="lstnumberx329.18" class="ltx_text ltx_lst_identifier ltx_font_typewriter" style="font-size:70%;">extract</span><span id="lstnumberx329.19" class="ltx_text ltx_lst_space ltx_font_typewriter" style="font-size:70%;"> </span><span id="lstnumberx329.20" class="ltx_text ltx_lst_identifier ltx_font_typewriter" style="font-size:70%;">where</span><span id="lstnumberx329.21" class="ltx_text ltx_lst_space ltx_font_typewriter" style="font-size:70%;"> </span><span id="lstnumberx329.22" class="ltx_text ltx_lst_identifier ltx_font_typewriter" style="font-size:70%;">WebFetch</span><span id="lstnumberx329.23" class="ltx_text ltx_lst_space ltx_font_typewriter" style="font-size:70%;"> </span><span id="lstnumberx329.24" class="ltx_text ltx_lst_identifier ltx_font_typewriter" style="font-size:70%;">returns</span><span id="lstnumberx329.25" class="ltx_text ltx_lst_space ltx_font_typewriter" style="font-size:70%;"> </span><span id="lstnumberx329.26" class="ltx_text ltx_font_typewriter" style="font-size:70%;">0</span><span id="lstnumberx329.27" class="ltx_text ltx_lst_space ltx_font_typewriter" style="font-size:70%;"> </span><span id="lstnumberx329.28" class="ltx_text ltx_lst_identifier ltx_font_typewriter" style="font-size:70%;">chars</span><span id="lstnumberx329.29" class="ltx_text ltx_font_typewriter" style="font-size:70%;">"</span>
</div>
<div id="lstnumberx330" class="ltx_listingline"><span id="lstnumberx330.1" class="ltx_text ltx_lst_space ltx_font_typewriter" style="font-size:70%;">    </span><span id="lstnumberx330.2" class="ltx_text ltx_lst_identifier ltx_font_typewriter" style="font-size:70%;">evidence</span><span id="lstnumberx330.3" class="ltx_text ltx_font_typewriter" style="font-size:70%;">:</span><span id="lstnumberx330.4" class="ltx_text ltx_lst_space ltx_font_typewriter" style="font-size:70%;"> </span><span id="lstnumberx330.5" class="ltx_text ltx_font_typewriter" style="font-size:70%;">"</span><span id="lstnumberx330.6" class="ltx_text ltx_lst_identifier ltx_font_typewriter" style="font-size:70%;">GET</span><span id="lstnumberx330.7" class="ltx_text ltx_lst_space ltx_font_typewriter" style="font-size:70%;"> </span><span id="lstnumberx330.8" class="ltx_text ltx_font_typewriter" style="font-size:70%;">.../</span><span id="lstnumberx330.9" class="ltx_text ltx_lst_identifier ltx_font_typewriter" style="font-size:70%;">w</span><span id="lstnumberx330.10" class="ltx_text ltx_font_typewriter" style="font-size:70%;">/</span><span id="lstnumberx330.11" class="ltx_text ltx_lst_identifier ltx_font_typewriter" style="font-size:70%;">api</span><span id="lstnumberx330.12" class="ltx_text ltx_font_typewriter" style="font-size:70%;">.</span><span id="lstnumberx330.13" class="ltx_text ltx_lst_identifier ltx_font_typewriter" style="font-size:70%;">php</span><span id="lstnumberx330.14" class="ltx_text ltx_font_typewriter" style="font-size:70%;">?...&amp;</span><span id="lstnumberx330.15" class="ltx_text ltx_lst_identifier ltx_font_typewriter" style="font-size:70%;">explaintext</span><span id="lstnumberx330.16" class="ltx_text ltx_font_typewriter" style="font-size:70%;">=</span><span id="lstnumberx330.17" class="ltx_text ltx_lst_identifier ltx_font_typewriter" style="font-size:70%;">true</span><span id="lstnumberx330.18" class="ltx_text ltx_lst_space ltx_font_typewriter" style="font-size:70%;"> </span><spa