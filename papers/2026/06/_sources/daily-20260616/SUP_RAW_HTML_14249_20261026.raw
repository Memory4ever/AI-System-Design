<td id="S3.T2.3.6.2" class="ltx_td ltx_align_left ltx_border_bb"><math id="S3.T2.m8" class="ltx_Math" alttext="\mathcal{H}_{t+1}\leftarrow U(\widetilde{\mathcal{H}}_{t},\mathcal{T}_{t},r_{t})" display="inline" intent=":literal"><semantics><mrow><msub><mi class="ltx_font_mathcaligraphic" mathsize="0.900em">ℋ</mi><mrow><mi mathsize="0.900em">t</mi><mo mathsize="0.900em">+</mo><mn mathsize="0.900em">1</mn></mrow></msub><mo mathsize="0.900em" stretchy="false">←</mo><mrow><mi mathsize="0.900em">U</mi><mo>⁡</mo><mrow><mo maxsize="0.900em" minsize="0.900em">(</mo><msub><mover accent="true"><mi class="ltx_font_mathcaligraphic" mathsize="0.900em">ℋ</mi><mo>~</mo></mover><mi mathsize="0.900em">t</mi></msub><mo mathsize="0.900em">,</mo><msub><mi class="ltx_font_mathcaligraphic" mathsize="0.900em">𝒯</mi><mi mathsize="0.900em">t</mi></msub><mo mathsize="0.900em">,</mo><msub><mi mathsize="0.900em">r</mi><mi mathsize="0.900em">t</mi></msub><mo maxsize="0.900em" minsize="0.900em">)</mo></mrow></mrow></mrow><annotation encoding="application/x-tex">\mathcal{H}_{t+1}\leftarrow U(\widetilde{\mathcal{H}}_{t},\mathcal{T}_{t},r_{t})</annotation></semantics></math></td>
