              <span id="algorithm1.6.7.4" class="ltx_text" style="font-size:90%;">run </span><math id="algorithm1.m12" class="ltx_Math" alttext="\mathcal{H}_{t}" display="inline" intent=":literal"><semantics><msub><mi class="ltx_font_mathcaligraphic" mathsize="0.900em">ℋ</mi><mi mathsize="0.900em">t</mi></msub><annotation encoding="application/x-tex">\mathcal{H}_{t}</annotation></semantics></math><span id="algorithm1.6.7.5" class="ltx_text" style="font-size:90%;"> on </span><math id="algorithm1.m13" class="ltx_Math" alttext="B_{t}" display="inline" intent=":literal"><semantics><msub><mi mathsize="0.900em">B</mi><mi mathsize="0.900em">t</mi></msub><annotation encoding="application/x-tex">B_{t}</annotation></semantics></math><span id="algorithm1.6.7.6" class="ltx_text" style="font-size:90%;"> to get traces </span><math id="algorithm1.m14" class="ltx_Math" alttext="\Delta\mathcal{T}_{t}" display="inline" intent=":literal"><semantics><mrow><mi mathsize="0.900em" mathvariant="normal">Δ</mi><mo lspace="0em" rspace="0em">​</mo><msub><mi class="ltx_font_mathcaligraphic" mathsize="0.900em">𝒯</mi><mi mathsize="0.900em">t</mi></msub></mrow><annotation encoding="application/x-tex">\Delta\mathcal{T}_{t}</annotation></semantics></math><span id="algorithm1.6.7.7" class="ltx_text" style="font-size:90%;">;</span>
</div>
