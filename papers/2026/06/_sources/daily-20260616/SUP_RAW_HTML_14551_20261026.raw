<th id="S5.T3.2.1.9.3" class="ltx_td ltx_nopad_l ltx_align_left ltx_th ltx_th_row ltx_border_bb" style="padding:-0.5pt 2.2pt;"><span id="S5.T3.2.1.9.3.1" class="ltx_text ltx_font_bold">Full TRACE</span></th>
