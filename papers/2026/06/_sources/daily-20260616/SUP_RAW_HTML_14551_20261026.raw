<span id="A1.T15.2.1.6.1.1" class="ltx_inline-block ltx_align_top" style="width:31.0pt;">
<span id="A1.T15.2.1.6.1.1.1" class="ltx_p ltx_align_left">Medicine</span>
</span></td>
<td id="A1.T15.2.1.6.2" class="ltx_td ltx_align_left ltx_align_top ltx_border_bb" style="padding:0.5pt 2.0pt;">
<span id="A1.T15.2.1.6.2.1" class="ltx_inline-block ltx_align_top" style="width:58.7pt;">
