<th id="A1.T9.2.1.4.1" class="ltx_td ltx_align_left ltx_th ltx_th_row" style="padding:0.25pt 3.2pt;">Left arm joints <math id="A1.T9.m5" class="ltx_Math" alttext="q^{L}_{0,\ldots,6}" display="inline" intent=":literal"><semantics><msubsup><mi>q</mi><mrow><mn>0</mn><mo>,</mo><mi mathvariant="normal">…</mi><mo>,</mo><mn>6</mn></mrow><mi>L</mi></msubsup><annotation encoding="application/x-tex">q^{L}_{0,\ldots,6}</annotation></semantics></math></th>
