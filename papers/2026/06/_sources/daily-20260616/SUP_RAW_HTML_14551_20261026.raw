<td id="A1.T6.2.1.3.6" class="ltx_td ltx_align_left ltx_align_top ltx_border_bb" style="padding:0.4pt 2.8pt;">
<span id="A1.T6.2.1.3.6.1" class="ltx_inline-block ltx_align_top" style="width:34.5pt;">
<span id="A1.T6.2.1.3.6.1.1" class="ltx_p ltx_align_center"><math id="A1.T6.m6" class="ltx_Math" alttext="10.3\%" display="inline" intent=":literal"><semantics><mrow><mn>10.3</mn><mo>%</mo></mrow><annotation encoding="application/x-tex">10.3\%</annotation></semantics></math></span>
</span></td>
<td id="A1.T6.2.1.3.7" class="ltx_td ltx_nopad_r ltx_align_left ltx_align_top ltx_border_bb" style="padding:0.4pt 2.8pt;">
<span id="A1.T6.2.1.3.7.1" class="ltx_inline-block ltx_align_top" style="width:31.0pt;">
