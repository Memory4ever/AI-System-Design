<span id="A1.T18.2.1.6.1.1.1" class="ltx_p ltx_align_left">Other or unclassified</span>
</span></td>
<td id="A1.T18.2.1.6.2" class="ltx_td ltx_align_left ltx_align_top ltx_border_bb" style="padding:0.4pt 2.8pt;">
