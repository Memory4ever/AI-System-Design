<td id="S3.T1.2.1.2.3" class="ltx_td ltx_align_right ltx_border_t">✗</td>
<td id="S3.T1.2.1.2.4" class="ltx_td ltx_align_right ltx_border_t">34.3%</td>
<td id="S3.T1.2.1.2.5" class="ltx_td ltx_align_right ltx_border_t">2.1</td>
<td id="S3.T1.2.1.2.6" class="ltx_td ltx_align_right ltx_border_t">48.8</td>
