<th id="S3.T1.2.1.1.2" class="ltx_td ltx_align_left ltx_th ltx_th_column ltx_th_row ltx_border_tt"><span id="S3.T1.2.1.1.2.1" class="ltx_text ltx_font_bold">Agent Scaffold</span></th>
<th id="S3.T1.2.1.1.3" class="ltx_td ltx_align_right ltx_th ltx_th_column ltx_border_tt"><span id="S3.T1.2.1.1.3.1" class="ltx_text ltx_font_bold">Open Weights?</span></th>
