<th id="S3.T1.2.1.1.7" class="ltx_td ltx_nopad_r ltx_align_right ltx_th ltx_th_column ltx_border_tt"><span id="S3.T1.2.1.1.7.1" class="ltx_text ltx_font_bold">Cost ($)</span></th></tr>
