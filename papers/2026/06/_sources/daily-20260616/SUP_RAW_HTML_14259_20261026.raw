<td id="S4.T2.5.7.2" class="ltx_td ltx_align_right ltx_border_bb"><math id="S4.T2.m25" class="ltx_Math" alttext="5.955" display="inline" intent=":literal"><semantics><mn mathsize="0.900em">5.955</mn><annotation encoding="application/x-tex">5.955</annotation></semantics></math></td>
