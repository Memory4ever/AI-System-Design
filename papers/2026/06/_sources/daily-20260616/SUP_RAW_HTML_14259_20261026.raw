<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A2.Ex129.m2" class="ltx_Math" alttext="\displaystyle\in\{10^{-4},3\cdot 10^{-4},10^{-3},3\cdot 10^{-3}\}" display="inline" intent=":literal"><semantics><mrow><mphantom></mphantom><mo>∈</mo><mrow><mo stretchy="false">{</mo><mrow><msup><mn>10</mn><mrow><mo>−</mo><mn>4</mn></mrow></msup><mo>,</mo><mrow><mn>3</mn><mo lspace="0.222em" rspace="0.222em">⋅</mo><msup><mn>10</mn><mrow><mo>−</mo><mn>4</mn></mrow></msup></mrow><mo>,</mo><msup><mn>10</mn><mrow><mo>−</mo><mn>3</mn></mrow></msup><mo>,</mo><mrow><mn>3</mn><mo lspace="0.222em" rspace="0.222em">⋅</mo><msup><mn>10</mn><mrow><mo>−</mo><mn>3</mn></mrow></msup></mrow></mrow><mo stretchy="false">}</mo></mrow></mrow><annotation encoding="application/x-tex">\displaystyle\in\{10^{-4},3\cdot 10^{-4},10^{-3},3\cdot 10^{-3}\}</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
