<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A2.Ex104.m2" class="ltx_Math" alttext="\displaystyle\in\{10^{-2},10^{-1},10^{0},10^{1},3\cdot 10^{1}\}" display="inline" intent=":literal"><semantics><mrow><mphantom></mphantom><mo>∈</mo><mrow><mo stretchy="false">{</mo><mrow><msup><mn>10</mn><mrow><mo>−</mo><mn>2</mn></mrow></msup><mo>,</mo><msup><mn>10</mn><mrow><mo>−</mo><mn>1</mn></mrow></msup><mo>,</mo><msup><mn>10</mn><mn>0</mn></msup><mo>,</mo><msup><mn>10</mn><mn>1</mn></msup><mo>,</mo><mrow><mn>3</mn><mo lspace="0.222em" rspace="0.222em">⋅</mo><msup><mn>10</mn><mn>1</mn></msup></mrow></mrow><mo stretchy="false">}</mo></mrow></mrow><annotation encoding="application/x-tex">\displaystyle\in\{10^{-2},10^{-1},10^{0},10^{1},3\cdot 10^{1}\}</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
<tbody id="A2.Ex105"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_eqn_cell"></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A2.Ex105.m1" class="ltx_Math" alttext="\displaystyle\times\{0.9,0.95,0.99,0.999\}" display="inline" intent=":literal"><semantics><mrow><mphantom></mphantom><mo lspace="0.222em" rspace="0.222em">×</mo><mrow><mo stretchy="false">{</mo><mrow><mn>0.9</mn><mo>,</mo><mn>0.95</mn><mo>,</mo><mn>0.99</mn><mo>,</mo><mn>0.999</mn></mrow><mo stretchy="false">}</mo></mrow></mrow><annotation encoding="application/x-tex">\displaystyle\times\{0.9,0.95,0.99,0.999\}</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
