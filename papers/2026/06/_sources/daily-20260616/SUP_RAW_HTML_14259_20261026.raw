<td class="ltx_td ltx_align_right ltx_eqn_cell"><math id="A2.Ex80.m1" class="ltx_Math" alttext="\displaystyle(\eta,\beta,B,\lambda)" display="inline" intent=":literal"><semantics><mrow><mo stretchy="false">(</mo><mi>η</mi><mo>,</mo><mi>β</mi><mo>,</mo><mi>B</mi><mo>,</mo><mi>λ</mi><mo stretchy="false">)</mo></mrow><annotation encoding="application/x-tex">\displaystyle(\eta,\beta,B,\lambda)</annotation></semantics></math></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A2.Ex80.m2" class="ltx_Math" alttext="\displaystyle\in\{10^{-4},10^{-3},10^{-2},10^{-1}\}" display="inline" intent=":literal"><semantics><mrow><mphantom></mphantom><mo>∈</mo><mrow><mo stretchy="false">{</mo><mrow><msup><mn>10</mn><mrow><mo>−</mo><mn>4</mn></mrow></msup><mo>,</mo><msup><mn>10</mn><mrow><mo>−</mo><mn>3</mn></mrow></msup><mo>,</mo><msup><mn>10</mn><mrow><mo>−</mo><mn>2</mn></mrow></msup><mo>,</mo><msup><mn>10</mn><mrow><mo>−</mo><mn>1</mn></mrow></msup></mrow><mo stretchy="false">}</mo></mrow></mrow><annotation encoding="application/x-tex">\displaystyle\in\{10^{-4},10^{-3},10^{-2},10^{-1}\}</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
<tbody id="A2.Ex81"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
