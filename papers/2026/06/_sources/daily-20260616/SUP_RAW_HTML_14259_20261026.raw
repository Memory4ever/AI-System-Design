<td id="A2.T4.5.6.3" class="ltx_td ltx_align_right ltx_border_bb"><math id="A2.T4.m22" class="ltx_Math" alttext="5.348" display="inline" intent=":literal"><semantics><mn>5.348</mn><annotation encoding="application/x-tex">5.348</annotation></semantics></math></td>
<td id="A2.T4.5.6.4" class="ltx_td ltx_align_right ltx_border_bb"><math id="A2.T4.m23" class="ltx_Math" alttext="+0.654" display="inline" intent=":literal"><semantics><mrow><mo>+</mo><mn>0.654</mn></mrow><annotation encoding="application/x-tex">+0.654</annotation></semantics></math></td>
