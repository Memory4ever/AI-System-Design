<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_eqn_cell"></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A2.Ex77.m1" class="ltx_Math" alttext="\displaystyle\times\{0.9,0.95,0.99\}" display="inline" intent=":literal"><semantics><mrow><mphantom></mphantom><mo lspace="0.222em" rspace="0.222em">×</mo><mrow><mo stretchy="false">{</mo><mrow><mn>0.9</mn><mo>,</mo><mn>0.95</mn><mo>,</mo><mn>0.99</mn></mrow><mo stretchy="false">}</mo></mrow></mrow><annotation encoding="application/x-tex">\displaystyle\times\{0.9,0.95,0.99\}</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
<tbody id="A2.Ex78"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
