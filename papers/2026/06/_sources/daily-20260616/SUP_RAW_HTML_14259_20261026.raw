<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_eqn_cell"></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A1.Ex52.m1" class="ltx_Math" alttext="\displaystyle\times\{256,1024,4096\}." display="inline" intent=":literal"><semantics><mrow><mrow><mphantom></mphantom><mo lspace="0.222em" rspace="0.222em">×</mo><mrow><mo stretchy="false">{</mo><mrow><mn>256</mn><mo>,</mo><mn>1024</mn><mo>,</mo><mn>4096</mn></mrow><mo stretchy="false">}</mo></mrow></mrow><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">\displaystyle\times\{256,1024,4096\}.</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
</div></li>
</ul>
<p id="A1.SS7.p2.3" class="ltx_p">This setup trains a total of 224 model configurations.</p>
</div>
<figure id="A1.F13" class="ltx_figure">
<div class="ltx_flex_figure">
<div class="ltx_flex_cell ltx_flex_size_1"><object type="image/svg+xml" data="2606.14259v1/gap_zinc250k_grit_tr_loss_ema.svg" id="A1.F13.g1" class="ltx_graphics ltx_centering ltx_figure_panel ltx_img_landscape" style="aspect-ratio:476/131;" width="476" height="131"></object></div><div class="ltx_flex_break"></div><div class="ltx_flex_cell ltx_flex_size_1"><object type="image/svg+xml" data="2606.14259v1/gap_zinc250k_gat_tr_loss_ema.svg" id="A1.F13.g2" class="ltx_graphics ltx_centering ltx_figure_panel ltx_img_landscape" style="aspect-ratio:381/132;" width="381" height="132"></object></div></div>
