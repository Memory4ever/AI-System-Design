<th id="S1.F1.3.2.2.2" class="ltx_td ltx_align_left ltx_th ltx_th_column"><span id="S1.F1.3.2.2.2.1" class="ltx_text ltx_font_bold" style="font-size:70%;">Arch.</span></th>
<th id="S1.F1.3.2.2.3" class="ltx_td ltx_align_left ltx_th ltx_th_column"><span id="S1.F1.3.2.2.3.1" class="ltx_text ltx_font_bold" style="font-size:70%;">Arch.</span></th></tr>
