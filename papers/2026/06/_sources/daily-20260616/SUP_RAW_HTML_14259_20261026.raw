<td id="A2.T4.5.3.2" class="ltx_td ltx_align_right ltx_border_t"><math id="A2.T4.m9" class="ltx_Math" alttext="6.133" display="inline" intent=":literal"><semantics><mn>6.133</mn><annotation encoding="application/x-tex">6.133</annotation></semantics></math></td>
<td id="A2.T4.5.3.3" class="ltx_td ltx_align_right ltx_border_t"><math id="A2.T4.m10" class="ltx_Math" alttext="5.337" display="inline" intent=":literal"><semantics><mn>5.337</mn><annotation encoding="application/x-tex">5.337</annotation></semantics></math></td>
<td id="A2.T4.5.3.4" class="ltx_td ltx_align_right ltx_border_t"><math id="A2.T4.m11" class="ltx_Math" alttext="+0.797" display="inline" intent=":literal"><semantics><mrow><mo>+</mo><mn>0.797</mn></mrow><annotation encoding="application/x-tex">+0.797</annotation></semantics></math></td>
<td id="A2.T4.5.3.5" class="ltx_td ltx_align_right ltx_border_t"><math id="A2.T4.m12" class="ltx_Math" alttext="+13.00\%" display="inline" intent=":literal"><semantics><mrow><mo>+</mo><mrow><mn>13.00</mn><mo>%</mo></mrow></mrow><annotation encoding="application/x-tex">+13.00\%</annotation></semantics></math></td></tr>
