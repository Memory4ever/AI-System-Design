<td id="A2.T4.5.5.5" class="ltx_td ltx_align_right"><math id="A2.T4.m20" class="ltx_Math" alttext="+11.16\%" display="inline" intent=":literal"><semantics><mrow><mo>+</mo><mrow><mn>11.16</mn><mo>%</mo></mrow></mrow><annotation encoding="application/x-tex">+11.16\%</annotation></semantics></math></td></tr>
<tr id="A2.T4.5.6" class="ltx_tr">
