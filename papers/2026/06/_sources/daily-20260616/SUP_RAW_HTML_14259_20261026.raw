<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_eqn_cell"></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A2.Ex116.m1" class="ltx_Math" alttext="\displaystyle\times\{16,64,256,1024\}." display="inline" intent=":literal"><semantics><mrow><mrow><mphantom></mphantom><mo lspace="0.222em" rspace="0.222em">×</mo><mrow><mo stretchy="false">{</mo><mrow><mn>16</mn><mo>,</mo><mn>64</mn><mo>,</mo><mn>256</mn><mo>,</mo><mn>1024</mn></mrow><mo stretchy="false">}</mo></mrow></mrow><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">\displaystyle\times\{16,64,256,1024\}.</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
</div></li>
<li id="A2.I7.i2" class="ltx_item" style="list-style-type:none;"><span class="ltx_tag ltx_tag_item">•</span> 
<div id="A2.I7.i2.p1" class="ltx_para">
<p id="A2.I7.i2.p1.1" class="ltx_p">Adam (64 runs) (<math id="A2.I7.i2.p1.m1" class="ltx_Math" alttext="\beta_{1}=\beta_{2}=\beta" display="inline" intent=":literal"><semantics><mrow><msub><mi>β</mi><mn>1</mn></msub><mo>=</mo><msub><mi>β</mi><mn>2</mn></msub><mo>=</mo><mi>β</mi></mrow><annotation encoding="application/x-tex">\beta_{1}=\beta_{2}=\beta</annotation></semantics></math>)</p>
<table id="A2.EGx36" class="ltx_equationgroup ltx_eqn_align ltx_eqn_table">

<tbody id="A2.Ex117"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_align_right ltx_eqn_cell"><math id="A2.Ex117.m1" class="ltx_Math" alttext="\displaystyle(\eta,\beta,B)" display="inline" intent=":literal"><semantics><mrow><mo stretchy="false">(</mo><mi>η</mi><mo>,</mo><mi>β</mi><mo>,</mo><mi>B</mi><mo stretchy="false">)</mo></mrow><annotation encoding="application/x-tex">\displaystyle(\eta,\beta,B)</annotation></semantics></math></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A2.Ex117.m2" class="ltx_Math" alttext="\displaystyle\in\{10^{-4},10^{-3},10^{-2},10^{-1}\}" display="inline" intent=":literal"><semantics><mrow><mphantom></mphantom><mo>∈</mo><mrow><mo stretchy="false">{</mo><mrow><msup><mn>10</mn><mrow><mo>−</mo><mn>4</mn></mrow></msup><mo>,</mo><msup><mn>10</mn><mrow><mo>−</mo><mn>3</mn></mrow></msup><mo>,</mo><msup><mn>10</mn><mrow><mo>−</mo><mn>2</mn></mrow></msup><mo>,</mo><msup><mn>10</mn><mrow><mo>−</mo><mn>1</mn></mrow></msup></mrow><mo stretchy="false">}</mo></mrow></mrow><annotation encoding="application/x-tex">\displaystyle\in\{10^{-4},10^{-3},10^{-2},10^{-1}\}</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
<tbody id="A2.Ex118"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_eqn_cell"></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A2.Ex118.m1" class="ltx_Math" alttext="\displaystyle\times\{0.9,0.95,0.99,0.999\}" display="inline" intent=":literal"><semantics><mrow><mphantom></mphantom><mo lspace="0.222em" rspace="0.222em">×</mo><mrow><mo stretchy="false">{</mo><mrow><mn>0.9</mn><mo>,</mo><mn>0.95</mn><mo>,</mo><mn>0.99</mn><mo>,</mo><mn>0.999</mn></mrow><mo stretchy="false">}</mo></mrow></mrow><annotation encoding="application/x-tex">\displaystyle\times\{0.9,0.95,0.99,0.999\}</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
<tbody id="A2.Ex119"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_eqn_cell"></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A2.Ex119.m1" class="ltx_Math" alttext="\displaystyle\times\{16,64,256,1024\}." display="inline" intent=":literal"><semantics><mrow><mrow><mphantom></mphantom><mo lspace="0.222em" rspace="0.222em">×</mo><mrow><mo stretchy="false">{</mo><mrow><mn>16</mn><mo>,</mo><mn>64</mn><mo>,</mo><mn>256</mn><mo>,</mo><mn>1024</mn></mrow><mo stretchy="false">}</mo></mrow></mrow><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">\displaystyle\times\{16,64,256,1024\}.</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
</div></li>
</ul>
</div>
<figure id="A2.F20" class="ltx_figure"><object type="image/svg+xml" data="2606.14259v1/gap_fineweb_large_tr_loss_ema.svg" id="A2.F20.g1" class="ltx_graphics ltx_centering ltx_img_landscape" style="aspect-ratio:476/131;" width="476" height="131"></object>
<figcaption class="ltx_caption ltx_centering"><span class="ltx_tag ltx_tag_figure"><span id="A2.F20.3" class="ltx_text" style="font-size:90%;">Figure 20</span>: </span><span id="A2.F20.4" class="ltx_text" style="font-size:90%;">GPT 250M trained on FineWeb 5BT across batch sizes.</span></figcaption>
</figure>
<div id="A2.SS4.p4" class="ltx_para">
<p id="A2.SS4.p4.1" class="ltx_p"><span id="A2.SS4.p4.1.1" class="ltx_text ltx_font_bold">ViT 128M on I21K.</span> Same setup as <a href="#A1.SS4" title="A.4 Experiments on ImageNet21K ‣ Appendix A Experimental details ‣ Beyond a Single Explanation of the Adam–SGD Gap" class="ltx_ref"><span class="ltx_text ltx_ref_tag">Section</span> <span class="ltx_text ltx_ref_tag">A.4</span></a> but larger scale. The ViT architecture here has 16 layers, 16 heads, and 768 embedding size. We tune the learning rate <math id="A2.SS4.p4.m1" class="ltx_Math" alttext="\eta" display="inline" intent=":literal"><semantics><mi>η</mi><annotation encoding="application/x-tex">\eta</annotation></semantics></math>, <math id="A2.SS4.p4.m2" class="ltx_Math" alttext="\beta" display="inline" intent=":literal"><semantics><mi>β</mi><annotation encoding="application/x-tex">\beta</annotation></semantics></math>, and batch size <math id="A2.SS4.p4.m3" class="ltx_Math" alttext="B" display="inline" intent=":literal"><semantics><mi>B</mi><annotation encoding="application/x-tex">B</annotation></semantics></math> as</p>
</div>
<div id="A2.SS4.p5" class="ltx_para">
<ul id="A2.I8" class="ltx_itemize ltx_leftmargin_flush">
<li id="A2.I8.i1" class="ltx_item" style="list-style-type:none;"><span class="ltx_tag ltx_tag_item">•</span> 
<div id="A2.I8.i1.p1" class="ltx_para">
<p id="A2.I8.i1.p1.1" class="ltx_p">SGD (32 runs)</p>
<table id="A2.EGx37" class="ltx_equationgroup ltx_eqn_align ltx_eqn_table">

<tbody id="A2.Ex120"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_align_right ltx_eqn_cell"><math id="A2.Ex120.m1" class="ltx_Math" alttext="\displaystyle(\eta,\beta,B)" display="inline" intent=":literal"><semantics><mrow><mo stretchy="false">(</mo><mi>η</mi><mo>,</mo><mi>β</mi><mo>,</mo><mi>B</mi><mo stretchy="false">)</mo></mrow><annotation encoding="application/x-tex">\displaystyle(\eta,\beta,B)</annotation></semantics></math></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A2.Ex120.m2" class="ltx_Math" alttext="\displaystyle\in\{10^{-2},10^{-1},10^{0},10^{1}\}" display="inline" intent=":literal"><semantics><mrow><mphantom></mphantom><mo>∈</mo><mrow><mo stretchy="false">{</mo><mrow><msup><mn>10</mn><mrow><mo>−</mo><mn>2</mn></mrow></msup><mo>,</mo><msup><mn>10</mn><mrow><mo>−</mo><mn>1</mn></mrow></msup><mo>,</mo><msup><mn>10</mn><mn>0</mn></msup><mo>,</mo><msup><mn>10</mn><mn>1</mn></msup></mrow><mo stretchy="false">}</mo></mrow></mrow><annotation encoding="application/x-tex">\displaystyle\in\{10^{-2},10^{-1},10^{0},10^{1}\}</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
