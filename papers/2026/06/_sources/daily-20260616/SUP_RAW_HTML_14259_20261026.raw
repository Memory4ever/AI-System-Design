<th id="A2.T4.5.1.2" class="ltx_td ltx_align_center ltx_th ltx_th_column ltx_border_tt" colspan="4"><span id="A2.T4.5.1.2.1" class="ltx_text ltx_font_bold">Train loss</span></th></tr>
<tr id="A2.T4.5.2" class="ltx_tr">
<th id="A2.T4.5.2.1" class="ltx_td ltx_align_center ltx_th ltx_th_column ltx_th_row"><span id="A2.T4.5.2.1.1" class="ltx_text ltx_font_bold">Arch.</span></th>
<th id="A2.T4.5.2.2" class="ltx_td ltx_align_center ltx_th ltx_th_column ltx_border_t"><span id="A2.T4.5.2.2.1" class="ltx_text ltx_font_bold">Adam</span></th>
