<td class="ltx_td ltx_eqn_cell"></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A2.Ex108.m1" class="ltx_Math" alttext="\displaystyle\times\{0.9,0.95,0.99,0.999\}" display="inline" intent=":literal"><semantics><mrow><mphantom></mphantom><mo lspace="0.222em" rspace="0.222em">×</mo><mrow><mo stretchy="false">{</mo><mrow><mn>0.9</mn><mo>,</mo><mn>0.95</mn><mo>,</mo><mn>0.99</mn><mo>,</mo><mn>0.999</mn></mrow><mo stretchy="false">}</mo></mrow></mrow><annotation encoding="application/x-tex">\displaystyle\times\{0.9,0.95,0.99,0.999\}</annotation></semantics></math></td>
