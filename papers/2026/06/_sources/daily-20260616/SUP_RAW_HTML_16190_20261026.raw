<th id="A3.T7.st1.5.2.7" class="ltx_td ltx_nopad_r ltx_align_center ltx_th ltx_th_column ltx_border_t"><span id="A3.T7.st1.5.2.7.1" class="ltx_text ltx_font_italic">H</span></th></tr>
