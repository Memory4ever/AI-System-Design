<td id="A8.F13.3.3.4" class="ltx_td ltx_nopad_r ltx_align_left"><span id="A8.F13.3.3.4.1" class="ltx_text" style="--ltx-bg-color:#FFFFFF;">6.929</span></td></tr>
<tr id="A8.F13.3.4" class="ltx_tr" style="--ltx-bg-color:#F3F3F3;">
<td id="A8.F13.3.4.1" class="ltx_td ltx_align_left ltx_border_r"><span id="A8.F13.3.4.1.1" class="ltx_text" style="--ltx-bg-color:#F3F3F3;">16 B</span></td>
<td id="A8.F13.3.4.2" class="ltx_td ltx_align_left ltx_border_r"><math id="A8.F13.m7" class="ltx_Math" style="--ltx-bg-color:#F3F3F3;" alttext="56.836\pm 0.011" display="inline" intent=":literal"><semantics><mrow><mn style="--ltx-bg-color:#F3F3F3;" mathbackground="#F3F3F3">56.836</mn><mo style="--ltx-bg-color:#F3F3F3;" mathbackground="#F3F3F3">±</mo><mn style="--ltx-bg-color:#F3F3F3;" mathbackground="#F3F3F3">0.011</mn></mrow><annotation encoding="application/x-tex">56.836\pm 0.011</annotation></semantics></math></td>
