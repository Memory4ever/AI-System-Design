<td id="A8.F13.3.2.3" class="ltx_td ltx_align_left ltx_border_r ltx_border_t"><math id="A8.F13.m4" class="ltx_Math" style="--ltx-bg-color:#F3F3F3;" alttext="58.968\pm 0.027" display="inline" intent=":literal"><semantics><mrow><mn style="--ltx-bg-color:#F3F3F3;" mathbackground="#F3F3F3">58.968</mn><mo style="--ltx-bg-color:#F3F3F3;" mathbackground="#F3F3F3">±</mo><mn style="--ltx-bg-color:#F3F3F3;" mathbackground="#F3F3F3">0.027</mn></mrow><annotation encoding="application/x-tex">58.968\pm 0.027</annotation></semantics></math></td>
<td id="A8.F13.3.2.4" class="ltx_td ltx_nopad_r ltx_align_left ltx_border_t"><span id="A8.F13.3.2.4.1" class="ltx_text" style="--ltx-bg-color:#F3F3F3;">5.862</span></td></tr>
