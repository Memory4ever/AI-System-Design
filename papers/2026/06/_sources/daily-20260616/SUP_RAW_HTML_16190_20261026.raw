<thead class="ltx_thead">
<tr id="A8.F13.3.1" class="ltx_tr">
<th id="A8.F13.3.1.1" class="ltx_td ltx_align_left ltx_th ltx_th_column ltx_border_r ltx_border_tt"><span id="A8.F13.3.1.1.1" class="ltx_text ltx_font_bold">Packet size</span></th>
<th id="A8.F13.3.1.2" class="ltx_td ltx_align_left ltx_th ltx_th_column ltx_border_r ltx_border_tt"><span id="A8.F13.3.1.2.1" class="ltx_text ltx_font_bold">Tx time (ms)</span></th>
<th id="A8.F13.3.1.3" class="ltx_td ltx_align_left ltx_th ltx_th_column ltx_border_r ltx_border_tt"><math id="A8.F13.m1" class="ltx_Math" alttext="I_{\text{tx,avg}}" display="inline" intent=":literal"><semantics><msub><mi>I</mi><mtext class="ltx_mathvariant_bold">tx,avg</mtext></msub><annotation encoding="application/x-tex">I_{\text{tx,avg}}</annotation></semantics></math><span id="A8.F13.3.1.3.1" class="ltx_text ltx_font_bold"> (mA)</span></th>
<th id="A8.F13.3.1.4" class="ltx_td ltx_nopad_r ltx_align_left ltx_th ltx_th_column ltx_border_tt"><math id="A8.F13.m2" class="ltx_Math" alttext="E_{\text{tx}}" display="inline" intent=":literal"><semantics><msub><mi>E</mi><mtext class="ltx_mathvariant_bold">tx</mtext></msub><annotation encoding="application/x-tex">E_{\text{tx}}</annotation></semantics></math><span id="A8.F13.3.1.4.1" class="ltx_text ltx_font_bold"> (mJ)</span></th></tr>
