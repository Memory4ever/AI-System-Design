<figure id="alg3" class="ltx_float ltx_float_algorithm ltx_framed ltx_framed_top">

<figcaption class="ltx_caption"><span class="ltx_tag ltx_tag_float"><span id="alg3.3" class="ltx_text ltx_font_bold">Algorithm 3</span> </span> Token Alignment via LCS</figcaption><div class="ltx_flex_figure">
<div class="ltx_flex_cell ltx_flex_size_1">
<p id="alg3.4" class="ltx_p ltx_figure_panel ltx_framed ltx_framed_topbottom"><span id="alg3.4.1" class="ltx_text ltx_font_bold">Input</span>: Target <math id="alg3.m1" class="ltx_Math" alttext="\hat{P}_{tgt}" display="inline" intent=":literal"><semantics><msub><mover accent="true"><mi>P</mi><mo>^</mo></mover><mrow><mi>t</mi><mo lspace="0em" rspace="0em">​</mo><mi>g</mi><mo lspace="0em" rspace="0em">​</mo><mi>t</mi></mrow></msub><annotation encoding="application/x-tex">\hat{P}_{tgt}</annotation></semantics></math>, Source <math id="alg3.m2" class="ltx_Math" alttext="\hat{P}_{src}" display="inline" intent=":literal"><semantics><msub><mover accent="true"><mi>P</mi><mo>^</mo></mover><mrow><mi>s</mi><mo lspace="0em" rspace="0em">​</mo><mi>r</mi><mo lspace="0em" rspace="0em">​</mo><mi>c</mi></mrow></msub><annotation encoding="application/x-tex">\hat{P}_{src}</annotation></semantics></math>, Tokenizer <math id="alg3.m3" class="ltx_Math" alttext="\mathcal{T}" display="inline" intent=":literal"><semantics><mi class="ltx_font_mathcaligraphic">𝒯</mi><annotation encoding="application/x-tex">\mathcal{T}</annotation></semantics></math> 
<br class="ltx_break"><span id="alg3.4.2" class="ltx_text ltx_font_bold">Output</span>: Structure-preserving token indices <math id="alg3.m4" class="ltx_Math" alttext="\overline{k}" display="inline" intent=":literal"><semantics><mover accent="true"><mi>k</mi><mo stretchy="true">¯</mo></mover><annotation encoding="application/x-tex">\overline{k}</annotation></semantics></math> and edit-driving token indices <math id="alg3.m5" class="ltx_Math" alttext="k" display="inline" intent=":literal"><semantics><mi>k</mi><annotation encoding="application/x-tex">k</annotation></semantics></math></p></div><div class="ltx_flex_break"></div><div class="ltx_flex_cell ltx_flex_size_1">
<div id="alg3.5" class="ltx_listing ltx_figure_panel ltx_listing">
<div id="alg3.l1" class="ltx_listingline">
                <span class="ltx_tag ltx_tag_listingline"><span id="alg3.l1.1" class="ltx_text" style="font-size:80%;">1:</span></span>
                
                
               <math id="alg3.l1.m1" class="ltx_Math" alttext="\texttt{target\_id}\leftarrow\mathcal{T}.\texttt{encode}(\hat{P}_{tgt})" display="inline" intent=":literal"><semantics><mrow><mrow><mtext class="ltx_mathvariant_monospace">target_id</mtext><mo stretchy="false">←</mo><mi class="ltx_font_mathcaligraphic">𝒯</mi></mrow><mo lspace="0em" rspace="0.167em">.</mo><mrow><mtext class="ltx_mathvariant_monospace">encode</mtext><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mover accent="true"><mi>P</mi><mo>^</mo></mover><mrow><mi>t</mi><mo lspace="0em" rspace="0em">​</mo><mi>g</mi><mo lspace="0em" rspace="0em">​</mo><mi>t</mi></mrow></msub><mo stretchy="false">)</mo></mrow></mrow></mrow><annotation encoding="application/x-tex">\texttt{target\_id}\leftarrow\mathcal{T}.\texttt{encode}(\hat{P}_{tgt})</annotation></semantics></math>

</div>
<div id="alg3.l2" class="ltx_listingline">
                <span class="ltx_tag ltx_tag_listingline"><span id="alg3.l2.1" class="ltx_text" style="font-size:80%;">2:</span></span>
                
                
               <math id="alg3.l2.m1" class="ltx_Math" alttext="\texttt{src\_id}\leftarrow\mathcal{T}.\texttt{encode}(\hat{P}_{src})" display="inline" intent=":literal"><semantics><mrow><mrow><mtext class="ltx_mathvariant_monospace">src_id</mtext><mo stretchy="false">←</mo><mi class="ltx_font_mathcaligraphic">𝒯</mi></mrow><mo lspace="0em" rspace="0.167em">.</mo><mrow><mtext class="ltx_mathvariant_monospace">encode</mtext><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mover accent="true"><mi>P</mi><mo>^</mo></mover><mrow><mi>s</mi><mo lspace="0em" rspace="0em">​</mo><mi>r</mi><mo lspace="0em" rspace="0em">​</mo><mi>c</mi></mrow></msub><mo stretchy="false">)</mo></mrow></mrow></mrow><annotation encoding="application/x-tex">\texttt{src\_id}\leftarrow\mathcal{T}.\texttt{encode}(\hat{P}_{src})</annotation></semantics></math>

</div>
<div id="alg3.l3" class="ltx_listingline">
                <span class="ltx_tag ltx_tag_listingline"><span id="alg3.l3.1" class="ltx_text" style="font-size:80%;">3:</span></span>
                
                
               <math id="alg3.l3.m1" class="ltx_Math" alttext="n\leftarrow|\texttt{target\_id}|" display="inline" intent=":literal"><semantics><mrow><mi>n</mi><mo stretchy="false">←</mo><mrow><mo stretchy="false">|</mo><mtext class="ltx_mathvariant_monospace">target_id</mtext><mo stretchy="false">|</mo></mrow></mrow><annotation encoding="application/x-tex">n\leftarrow|\texttt{target\_id}|</annotation></semantics></math>, <math id="alg3.l3.m2" class="ltx_Math" alttext="m\leftarrow|\texttt{src\_id}|" display="inline" intent=":literal"><semantics><mrow><mi>m</mi><mo stretchy="false">←</mo><mrow><mo stretchy="false">|</mo><mtext class="ltx_mathvariant_monospace">src_id</mtext><mo stretchy="false">|</mo></mrow></mrow><annotation encoding="application/x-tex">m\leftarrow|\texttt{src\_id}|</annotation></semantics></math>

</div>
<div id="alg3.l4" class="ltx_listingline">
                <span class="ltx_tag ltx_tag_listingline"><span id="alg3.l4.1" class="ltx_text" style="font-size:80%;">4:</span></span>
                
                
               Initialize <math id="alg3.l4.m1" class="ltx_Math" alttext="dp" display="inline" intent=":literal"><semantics><mrow><mi>d</mi><mo lspace="0em" rspace="0em">​</mo><mi>p</mi></mrow><annotation encoding="application/x-tex">dp</annotation></semantics></math> as zero matrix of size <math id="alg3.l4.m2" class="ltx_Math" alttext="(n{+}1)\times(m{+}1)" display="inline" intent=":literal"><semantics><mrow><mrow><mo stretchy="false">(</mo><mrow><mi>n</mi><mo>+</mo><mn>1</mn></mrow><mo rspace="0.055em" stretchy="false">)</mo></mrow><mo rspace="0.222em">×</mo><mrow><mo stretchy="false">(</mo><mrow><mi>m</mi><mo>+</mo><mn>1</mn></mrow><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">(n{+}1)\times(m{+}1)</annotation></semantics></math>

</div>
<div id="alg3.l5" class="ltx_listingline">
                <span class="ltx_tag ltx_tag_listingline"><span id="alg3.l5.1" class="ltx_text" style="font-size:80%;">5:</span></span>
                
                
               <span id="alg3.l5.3" class="ltx_text ltx_font_bold">for</span> <math id="alg3.l5.m1" class="ltx_Math" alttext="i=0" display="inline" intent=":literal"><semantics><mrow><mi>i</mi><mo>=</mo><mn>0</mn></mrow><annotation encoding="application/x-tex">i=0</annotation></semantics></math> to <math id="alg3.l5.m2" class="ltx_Math" alttext="n{-}1" display="inline" intent=":literal"><semantics><mrow><mi>n</mi><mo>−</mo><mn>1</mn></mrow><annotation encoding="application/x-tex">n{-}1</annotation></semantics></math> <span id="alg3.l5.4" class="ltx_text ltx_font_bold">do</span>



</div>
<div id="alg3.l6" class="ltx_listingline">
                <span class="ltx_tag ltx_tag_listingline"><span id="alg3.l6.1" class="ltx_text" style="font-size:80%;">6:</span></span>
                
                
                <span id="alg3.l6.3" class="ltx_text ltx_font_bold">for</span> <math id="alg3.l6.m1" class="ltx_Math" alttext="j=0" display="inline" intent=":literal"><semantics><mrow><mi>j</mi><mo>=</mo><mn>0</mn></mrow><annotation encoding="application/x-tex">j=0</annotation></semantics></math> to <math id="alg3.l6.m2" class="ltx_Math" alttext="m{-}1" display="inline" intent=":literal"><semantics><mrow><mi>m</mi><mo>−</mo><mn>1</mn></mrow><annotation encoding="application/x-tex">m{-}1</annotation></semantics></math> <span id="alg3.l6.4" class="ltx_text ltx_font_bold">do</span>



</div>
<div id="alg3.l7" class="ltx_listingline">
                <span class="ltx_tag ltx_tag_listingline"><span id="alg3.l7.1" class="ltx_text" style="font-size:80%;">7:</span></span>
                
                
                 <span id="alg3.l7.3" class="ltx_text ltx_font_bold">if</span> <math id="alg3.l7.m1" class="ltx_Math" alttext="\texttt{target\_id}[i]=\texttt{src\_id}[j]" display="inline" intent=":literal"><semantics><mrow><mrow><mtext class="ltx_mathvariant_monospace">target_id</mtext><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">[</mo><mi>i</mi><mo stretchy="false">]</mo></mrow></mrow><mo>=</mo><mrow><mtext class="ltx_mathvariant_monospace">src_id</mtext><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">[</mo><mi>j</mi><mo stretchy="false">]</mo></mrow></mrow></mrow><annotation encoding="application/x-tex">\texttt{target\_id}[i]=\texttt{src\_id}[j]</annotation></semantics></math> <span id="alg3.l7.4" class="ltx_text ltx_font_bold">then</span>



</div>
