<td id="S4.T2.6.3.4" class="ltx_td ltx_align_center"><span id="S4.T2.6.3.4.1" class="ltx_text" style="font-size:90%;">2% (42)</span></td>
<td id="S4.T2.6.3.5" class="ltx_td ltx_align_center"><span id="S4.T2.6.3.5.1" class="ltx_text" style="font-size:90%;">1% (12)</span></td></tr>
