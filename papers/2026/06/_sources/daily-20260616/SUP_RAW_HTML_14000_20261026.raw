<td id="S4.T2.6.4.3" class="ltx_td ltx_align_center"><span id="S4.T2.6.4.3.1" class="ltx_text" style="font-size:90%;">42% (40)</span></td>
<td id="S4.T2.6.4.4" class="ltx_td ltx_align_center"><span id="S4.T2.6.4.4.1" class="ltx_text" style="font-size:90%;">25% (463)</span></td>
<td id="S4.T2.6.4.5" class="ltx_td ltx_align_center"><span id="S4.T2.6.4.5.1" class="ltx_text" style="font-size:90%;">18% (253)</span></td></tr>
<tr id="S4.T2.6.5" class="ltx_tr">
<th id="S4.T2.6.5.1" class="ltx_td ltx_align_left ltx_th ltx_th_row ltx_border_t"><span id="S4.T2.6.5.1.1" class="ltx_text" style="font-size:70%;">NL vs. NL<math id="S4.T2.m3" class="ltx_Math" alttext="{}_{\text{b}}" display="inline" intent=":literal"><semantics><msub><mrow></mrow><mtext>b</mtext></msub><annotation encoding="application/x-tex">{}_{\text{b}}</annotation></semantics></math></span></th>
