<td id="A1.T7.3.8.2" class="ltx_td ltx_align_left ltx_align_top ltx_border_bb">
<span id="A1.T7.3.8.2.1" class="ltx_inline-block ltx_align_top" style="width:119.5pt;">
<span id="A1.T7.3.8.2.1.1" class="ltx_p"><span id="A1.T7.3.8.2.1.1.1" class="ltx_text" style="font-size:90%;">Mixed</span></span>
</span></td></tr>
</tbody>
</table>
<figcaption class="ltx_caption ltx_centering" style="font-size:90%;"><span class="ltx_tag ltx_tag_table">Table 7: </span>License information per dataset.</figcaption>
</figure>
