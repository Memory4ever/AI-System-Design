<td id="S6.T3.2.5.2" class="ltx_td ltx_align_left"><math id="S6.T3.m3" class="ltx_Math" alttext="5\times 10^{5}" display="inline" intent=":literal"><semantics><mrow><mn mathsize="0.900em">5</mn><mo lspace="0.222em" mathsize="0.900em" rspace="0.222em">×</mo><msup><mn mathsize="0.900em">10</mn><mn mathsize="0.900em">5</mn></msup></mrow><annotation encoding="application/x-tex">5\times 10^{5}</annotation></semantics></math></td>
<td id="S6.T3.2.5.3" class="ltx_td ltx_align_left"><math id="S6.T3.m4" class="ltx_Math" alttext="5\times 10^{5}" display="inline" intent=":literal"><semantics><mrow><mn mathsize="0.900em">5</mn><mo lspace="0.222em" mathsize="0.900em" rspace="0.222em">×</mo><msup><mn mathsize="0.900em">10</mn><mn mathsize="0.900em">5</mn></msup></mrow><annotation encoding="application/x-tex">5\times 10^{5}</annotation></semantics></math></td></tr>
<tr id="S6.T3.2.6" class="ltx_tr">
<th id="S6.T3.2.6.1" class="ltx_td ltx_align_left ltx_th ltx_th_row"><span id="S6.T3.2.6.1.1" class="ltx_text" style="font-size:90%;">Batch / discount <math id="S6.T3.m5" class="ltx_Math" alttext="\gamma" display="inline" intent=":literal"><semantics><mi>γ</mi><annotation encoding="application/x-tex">\gamma</annotation></semantics></math></span></th>
<td id="S6.T3.2.6.2" class="ltx_td ltx_align_left"><span id="S6.T3.2.6.2.1" class="ltx_text" style="font-size:90%;">256 / 0.999</span></td>
<td id="S6.T3.2.6.3" class="ltx_td ltx_align_left"><span id="S6.T3.2.6.3.1" class="ltx_text" style="font-size:90%;">256 / 0.999</span></td></tr>
