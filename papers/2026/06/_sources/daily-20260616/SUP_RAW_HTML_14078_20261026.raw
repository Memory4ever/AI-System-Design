<div id="S5.T2.5.1.21.10.1" class="ltx_inline-block ltx_transformed_outer" style="width:22.8pt;height:6.4pt;vertical-align:-0.0pt;"><span class="ltx_transformed_inner" style="transform:translate(0.0pt,0.0pt) scale(1.0,1.0) ;">
