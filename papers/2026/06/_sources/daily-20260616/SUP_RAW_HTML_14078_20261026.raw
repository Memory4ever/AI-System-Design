<section id="A2" class="ltx_appendix">
<h2 class="ltx_title ltx_title_appendix"><span class="ltx_tag ltx_tag_appendix">Appendix B </span>Theoretical Proof</h2>

<section id="A2.SS1" class="ltx_subsection">
<h3 class="ltx_title ltx_title_subsection"><span class="ltx_tag ltx_tag_subsection">B.1. </span>Proof of Proposition <a href="#S4.Thmtheorem2" title="Proposition 0. ‣ 4.1. Problem Formulation ‣ 4. Methodology ‣ Rethinking Backdoor Adversarial Unlearning through the Lens of Catastrophic Forgetting in Continual Learning" class="ltx_ref"><span class="ltx_text ltx_ref_tag">4.2</span></a></h3>

<div id="A2.SS1.2" class="ltx_proof">
<h6 class="ltx_title ltx_runin ltx_font_italic ltx_title_proof">Proof.</h6>
<div id="A2.SS1.p1" class="ltx_para">
<p id="A2.SS1.p1.1" class="ltx_p"><span id="A2.SS1.p1.1.1" class="ltx_text">For one of the backdoor unlearning objective <math id="A2.SS1.p1.m1" class="ltx_Math" alttext="\Delta^{\tau_{c}\to\tau_{u}}(X^{\tau_{c}})=0" display="inline" intent=":literal"><semantics><mrow><mrow><msup><mi mathvariant="normal">Δ</mi><mrow><msub><mi>τ</mi><mi>c</mi></msub><mo stretchy="false">→</mo><msub><mi>τ</mi><mi>u</mi></msub></mrow></msup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msup><mi>X</mi><msub><mi>τ</mi><mi>c</mi></msub></msup><mo stretchy="false">)</mo></mrow></mrow><mo>=</mo><mn>0</mn></mrow><annotation encoding="application/x-tex">\Delta^{\tau_{c}\to\tau_{u}}(X^{\tau_{c}})=0</annotation></semantics></math>, we have:</span></p>
<table id="A2.E28" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td rowspan="0" class="ltx_eqn_cell ltx_eqn_eqno ltx_align_middle ltx_align_left"><span class="ltx_tag ltx_tag_equation ltx_align_left">(28)</span></td>
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center">
<div id="A2.E28.2" class="ltx_inline-block ltx_markedasmath ltx_transformed_outer" style="width:310.5pt;height:96.1pt;vertical-align:-45.4pt;"><span class="ltx_transformed_inner" style="transform:translate(10.4pt,-3.2pt) scale(1.07159913847785,1.07159913847785) ;">
<p id="A2.E28.2.1" class="ltx_p"><math id="A2.E28.m1.m1" class="ltx_Math" alttext="\begin{aligned} \Delta^{\tau_{c}-&gt;\tau_{u}}(X^{\tau_{c}})&amp;=\left\|\sigma^{\tau_{c}\to\tau_{u}}(X^{\tau_{c}})\right\|^{2}_{2}\\
&amp;=\sum_{(x_{c},y)\in X^{\tau_{c}}}(f^{*}_{\tau_{u}}(x_{c})-f^{*}_{\tau_{c}}(x_{c}))^{2}\\
&amp;=\sum_{(x_{c},y)\in X^{\tau_{c}}}(f^{*}_{\tau_{u}}(x_{c})-f^{*}_{\tau_{b}}(x_{c})+f^{*}_{\tau_{b}}(x_{c})-f^{*}_{\tau_{c}}(x_{c}))^{2}\\
&amp;=\sum_{(x_{c},y)\in X^{\tau_{c}}}[\nabla_{\theta}f^{*}_{\tau_{b}}(x_{c})(\theta_{\tau_{u}}^{*}-\theta_{\tau_{b}}^{*})+\nabla_{\theta}f^{*}_{\tau_{c}}(x_{c})(\theta_{\tau_{b}}^{*}-\theta_{\tau_{c}}^{*})]^{2}.\end{aligned}" display="inline" intent=":literal"><semantics><mtable columnspacing="0pt" rowspacing="0pt"><mtr><mtd class="ltx_align_right" columnalign="right"><mrow><msup><mi mathvariant="normal">Δ</mi><mrow><mrow><msub><mi>τ</mi><mi>c</mi></msub><mo rspace="0em">−</mo></mrow><mo lspace="0em">&gt;</mo><msub><mi>τ</mi><mi>u</mi></msub></mrow></msup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msup><mi>X</mi><msub><mi>τ</mi><mi>c</mi></msub></msup><mo stretchy="false">)</mo></mrow></mrow></mtd><mtd class="ltx_align_left" columnalign="left"><mrow><mphantom></mphantom><mo>=</mo><msubsup><mrow><mo>‖</mo><mrow><msup><mi>σ</mi><mrow><msub><mi>τ</mi><mi>c</mi></msub><mo stretchy="false">→</mo><msub><mi>τ</mi><mi>u</mi></msub></mrow></msup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msup><mi>X</mi><msub><mi>τ</mi><mi>c</mi></msub></msup><mo stretchy="false">)</mo></mrow></mrow><mo>‖</mo></mrow><mn>2</mn><mn>2</mn></msubsup></mrow></mtd></mtr><mtr><mtd></mtd><mtd class="ltx_align_left" columnalign="left"><mrow><mphantom></mphantom><mo>=</mo><mrow><mstyle displaystyle="true"><munder><mo movablelimits="false">∑</mo><mrow><mrow><mo stretchy="false">(</mo><msub><mi>x</mi><mi>c</mi></msub><mo>,</mo><mi>y</mi><mo stretchy="false">)</mo></mrow><mo>∈</mo><msup><mi>X</mi><msub><mi>τ</mi><mi>c</mi></msub></msup></mrow></munder></mstyle><msup><mrow><mo stretchy="false">(</mo><mrow><mrow><msubsup><mi>f</mi><msub><mi>τ</mi><mi>u</mi></msub><mo>∗</mo></msubsup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mi>x</mi><mi>c</mi></msub><mo stretchy="false">)</mo></mrow></mrow><mo>−</mo><mrow><msubsup><mi>f</mi><msub><mi>τ</mi><mi>c</mi></msub><mo>∗</mo></msubsup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mi>x</mi><mi>c</mi></msub><mo stretchy="false">)</mo></mrow></mrow></mrow><mo stretchy="false">)</mo></mrow><mn>2</mn></msup></mrow></mrow></mtd></mtr><mtr><mtd></mtd><mtd class="ltx_align_left" columnalign="left"><mrow><mphantom></mphantom><mo>=</mo><mrow><mstyle displaystyle="true"><munder><mo movablelimits="false">∑</mo><mrow><mrow><mo stretchy="false">(</mo><msub><mi>x</mi><mi>c</mi></msub><mo>,</mo><mi>y</mi><mo stretchy="false">)</mo></mrow><mo>∈</mo><msup><mi>X</mi><msub><mi>τ</mi><mi>c</mi></msub></msup></mrow></munder></mstyle><msup><mrow><mo stretchy="false">(</mo><mrow><mrow><mrow><mrow><msubsup><mi>f</mi><msub><mi>τ</mi><mi>u</mi></msub><mo>∗</mo></msubsup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mi>x</mi><mi>c</mi></msub><mo stretchy="false">)</mo></mrow></mrow><mo>−</mo><mrow><msubsup><mi>f</mi><msub><mi>τ</mi><mi>b</mi></msub><mo>∗</mo></msubsup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mi>x</mi><mi>c</mi></msub><mo stretchy="false">)</mo></mrow></mrow></mrow><mo>+</mo><mrow><msubsup><mi>f</mi><msub><mi>τ</mi><mi>b</mi></msub><mo>∗</mo></msubsup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mi>x</mi><mi>c</mi></msub><mo stretchy="false">)</mo></mrow></mrow></mrow><mo>−</mo><mrow><msubsup><mi>f</mi><msub><mi>τ</mi><mi>c</mi></msub><mo>∗</mo></msubsup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mi>x</mi><mi>c</mi></msub><mo stretchy="false">)</mo></mrow></mrow></mrow><mo stretchy="false">)</mo></mrow><mn>2</mn></msup></mrow></mrow></mtd></mtr><mtr><mtd></mtd><mtd class="ltx_align_left" columnalign="left"><mrow><mrow><mphantom></mphantom><mo>=</mo><mrow><mstyle displaystyle="true"><munder><mo movablelimits="false">∑</mo><mrow><mrow><mo stretchy="false">(</mo><msub><mi>x</mi><mi>c</mi></msub><mo>,</mo><mi>y</mi><mo stretchy="false">)</mo></mrow><mo>∈</mo><msup><mi>X</mi><msub><mi>τ</mi><mi>c</mi></msub></msup></mrow></munder></mstyle><msup><mrow><mo stretchy="false">[</mo><mrow><mrow><mrow><msub><mo rspace="0.167em">∇</mo><mi>θ</mi></msub><msubsup><mi>f</mi><msub><mi>τ</mi><mi>b</mi></msub><mo>∗</mo></msubsup></mrow><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mi>x</mi><mi>c</mi></msub><mo stretchy="false">)</mo></mrow><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mrow><msubsup><mi>θ</mi><msub><mi>τ</mi><mi>u</mi></msub><mo>∗</mo></msubsup><mo>−</mo><msubsup><mi>θ</mi><msub><mi>τ</mi><mi>b</mi></msub><mo>∗</mo></msubsup></mrow><mo stretchy="false">)</mo></mrow></mrow><mo>+</mo><mrow><mrow><msub><mo rspace="0.167em">∇</mo><mi>θ</mi></msub><msubsup><mi>f</mi><msub><mi>τ</mi><mi>c</mi></msub><mo>∗</mo></msubsup></mrow><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mi>x</mi><mi>c</mi></msub><mo stretchy="false">)</mo></mrow><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mrow><msubsup><mi>θ</mi><msub><mi>τ</mi><mi>b</mi></msub><mo>∗</mo></msubsup><mo>−</mo><msubsup><mi>θ</mi><msub><mi>τ</mi><mi>c</mi></msub><mo>∗</mo></msubsup></mrow><mo stretchy="false">)</mo></mrow></mrow></mrow><mo stretchy="false">]</mo></mrow><mn>2</mn></msup></mrow></mrow><mo lspace="0em">.</mo></mrow></mtd></mtr></mtable><annotation encoding="application/x-tex">\begin{aligned} \Delta^{\tau_{c}-&gt;\tau_{u}}(X^{\tau_{c}})&amp;=\left\|\sigma^{\tau_{c}\to\tau_{u}}(X^{\tau_{c}})\right\|^{2}_{2}\\
&amp;=\sum_{(x_{c},y)\in X^{\tau_{c}}}(f^{*}_{\tau_{u}}(x_{c})-f^{*}_{\tau_{c}}(x_{c}))^{2}\\
&amp;=\sum_{(x_{c},y)\in X^{\tau_{c}}}(f^{*}_{\tau_{u}}(x_{c})-f^{*}_{\tau_{b}}(x_{c})+f^{*}_{\tau_{b}}(x_{c})-f^{*}_{\tau_{c}}(x_{c}))^{2}\\
&amp;=\sum_{(x_{c},y)\in X^{\tau_{c}}}[\nabla_{\theta}f^{*}_{\tau_{b}}(x_{c})(\theta_{\tau_{u}}^{*}-\theta_{\tau_{b}}^{*})+\nabla_{\theta}f^{*}_{\tau_{c}}(x_{c})(\theta_{\tau_{b}}^{*}-\theta_{\tau_{c}}^{*})]^{2}.\end{aligned}</annotation></semantics></math></p>
</span></div></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="A2.SS1.p1.2" class="ltx_p"><span id="A2.SS1.p1.2.1" class="ltx_text">Here, we used constant NTK assumption, <em id="A2.SS1.p1.2.1.1" class="ltx_emph ltx_font_italic">i.e.,</em> <math id="A2.SS1.p1.m2" class="ltx_Math" alttext="\nabla_{\theta}f^{*}_{\tau}(x)=\nabla_{\theta}f_{0}(x)" display="inline" intent=":literal"><semantics><mrow><mrow><mrow><msub><mo>∇</mo><mi>θ</mi></msub><msubsup><mi>f</mi><mi>τ</mi><mo>∗</mo></msubsup></mrow><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>x</mi><mo stretchy="false">)</mo></mrow></mrow><mo>=</mo><mrow><mrow><msub><mo rspace="0.167em">∇</mo><mi>θ</mi></msub><msub><mi>f</mi><mn>0</mn></msub></mrow><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>x</mi><mo stretchy="false">)</mo></mrow></mrow></mrow><annotation encoding="application/x-tex">\nabla_{\theta}f^{*}_{\tau}(x)=\nabla_{\theta}f_{0}(x)</annotation></semantics></math>, Consequently, we have</span></p>
<table id="A2.E29" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td rowspan="0" class="ltx_eqn_cell ltx_eqn_eqno ltx_align_middle ltx_align_left"><span class="ltx_tag ltx_tag_equation ltx_align_left">(29)</span></td>
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center">
<div id="A2.E29.2" class="ltx_inline-block ltx_markedasmath ltx_transformed_outer" style="width:310.5pt;height:20.5pt;vertical-align:-11.3pt;"><span class="ltx_transformed_inner" style="transform:translate(17.5pt,-1.2pt) scale(1.12685191958594,1.12685191958594) ;">
<p id="A2.E29.2.1" class="ltx_p"><math id="A2.E29.m1.m1" class="ltx_Math" alttext="\Delta^{\tau_{c}-&gt;\tau_{u}}(X^{\tau_{c}})=\sum_{(x_{c},y)\in X^{\tau_{c}}}(\nabla_{\theta}f_{0}(x_{c})[(\theta_{\tau_{u}}^{*}-\theta_{\tau_{b}}^{*})+(\theta_{\tau_{b}}^{*}-\theta_{\tau_{c}}^{*})])^{2}." display="inline" intent=":literal"><semantics><mrow><mrow><mrow><msup><mi mathvariant="normal">Δ</mi><mrow><mrow><msub><mi>τ</mi><mi>c</mi></msub><mo rspace="0em">−</mo></mrow><mo lspace="0em">&gt;</mo><msub><mi>τ</mi><mi>u</mi></msub></mrow></msup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msup><mi>X</mi><msub><mi>τ</mi><mi>c</mi></msub></msup><mo stretchy="false">)</mo></mrow></mrow><mo rspace="0.111em">=</mo><mrow><msub><mo rspace="0em">∑</mo><mrow><mrow><mo stretchy="false">(</mo><msub><mi>x</mi><mi>c</mi></msub><mo>,</mo><mi>y</mi><mo stretchy="false">)</mo></mrow><mo>∈</mo><msup><mi>X</mi><msub><mi>τ</mi><mi>c</mi></msub></msup></mrow></msub><msup><mrow><mo stretchy="false">(</mo><mrow><mrow><msub><mo rspace="0.167em">∇</mo><mi>θ</mi></msub><msub><mi>f</mi><mn>0</mn></msub></mrow><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mi>x</mi><mi>c</mi></msub><mo stretchy="false">)</mo></mrow><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">[</mo><mrow><mrow><mo stretchy="false">(</mo><mrow><msubsup><mi>θ</mi><msub><mi>τ</mi><mi>u</mi></msub><mo>∗</mo></msubsup><mo>−</mo><msubsup><mi>θ</mi><msub><mi>τ</mi><mi>b</mi></msub><mo>∗</mo></msubsup></mrow><mo stretchy="false">)</mo></mrow><mo>+</mo><mrow><mo stretchy="false">(</mo><mrow><msubsup><mi>θ</mi><msub><mi>τ</mi><mi>b</mi></msub><mo>∗</mo></msubsup><mo>−</mo><msubsup><mi>θ</mi><msub><mi>τ</mi><mi>c</mi></msub><mo>∗</mo></msubsup></mrow><mo stretchy="false">)</mo></mrow></mrow><mo stretchy="false">]</mo></mrow></mrow><mo stretchy="false">)</mo></mrow><mn>2</mn></msup></mrow></mrow><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">\Delta^{\tau_{c}-&gt;\tau_{u}}(X^{\tau_{c}})=\sum_{(x_{c},y)\in X^{\tau_{c}}}(\nabla_{\theta}f_{0}(x_{c})[(\theta_{\tau_{u}}^{*}-\theta_{\tau_{b}}^{*})+(\theta_{\tau_{b}}^{*}-\theta_{\tau_{c}}^{*})])^{2}.</annotation></semantics></math></p>
</span></div></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="A2.SS1.p1.3" class="ltx_p"><span id="A2.SS1.p1.3.1" class="ltx_text">Due to the orthogonality between the backdoor task <math id="A2.SS1.p1.m3" class="ltx_Math" alttext="\tau_{b}" display="inline" intent=":literal"><semantics><msub><mi>τ</mi><mi>b</mi></msub><annotation encoding="application/x-tex">\tau_{b}</annotation></semantics></math> and clean task <math id="A2.SS1.p1.m4" class="ltx_Math" alttext="\tau_{c}" display="inline" intent=":literal"><semantics><msub><mi>τ</mi><mi>c</mi></msub><annotation encoding="application/x-tex">\tau_{c}</annotation></semantics></math>, namely <math id="A2.SS1.p1.m5" class="ltx_Math" alttext="\nabla_{\theta}f_{0}(x_{c})\perp(\theta_{\tau_{b}}^{*}-\theta_{\tau_{c}}^{*})" display="inline" intent=":literal"><semantics><mrow><mrow><mrow><msub><mo>∇</mo><mi>θ</mi></msub><msub><mi>f</mi><mn>0</mn></msub></mrow><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mi>x</mi><mi>c</mi></msub><mo stretchy="false">)</mo></mrow></mrow><mo>⟂</mo><mrow><mo stretchy="false">(</mo><mrow><msubsup><mi>θ</mi><msub><mi>τ</mi><mi>b</mi></msub><mo>∗</mo></msubsup><mo>−</mo><msubsup><mi>θ</mi><msub><mi>τ</mi><mi>c</mi></msub><mo>∗</mo></msubsup></mrow><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">\nabla_{\theta}f_{0}(x_{c})\perp(\theta_{\tau_{b}}^{*}-\theta_{\tau_{c}}^{*})</annotation></semantics></math>,
we have</span></p>
<table id="A2.E30" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td rowspan="1" class="ltx_eqn_cell ltx_eqn_eqno ltx_align_middle ltx_align_left"><span class="ltx_tag ltx_tag_equation ltx_align_left">(30)</span></td>
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="A2.E30.m1" class="ltx_Math" alttext="\left\langle\nabla_{\theta}f_{0}(x_{c}),(\theta_{\tau_{b}}^{*}-\theta_{\tau_{c}}^{*})\right\rangle=0,\forall x_{c}\in X^{\tau_{c}}." display="block" intent=":literal"><semantics><mrow><mrow><mrow><mrow><mo>⟨</mo><mrow><mrow><mrow><msub><mo rspace="0.167em">∇</mo><mi>θ</mi></msub><msub><mi>f</mi><mn>0</mn></msub></mrow><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mi>x</mi><mi>c</mi></msub><mo stretchy="false">)</mo></mrow></mrow><mo>,</mo><mrow><mo stretchy="false">(</mo><mrow><msubsup><mi>θ</mi><msub><mi>τ</mi><mi>b</mi></msub><mo>∗</mo></msubsup><mo>−</mo><msubsup><mi>θ</mi><msub><mi>τ</mi><mi>c</mi></msub><mo>∗</mo></msubsup></mrow><mo stretchy="false">)</mo></mrow></mrow><mo>⟩</mo></mrow><mo>=</mo><mn>0</mn></mrow><mo>,</mo><mrow><mrow><mo rspace="0.167em">∀</mo><msub><mi>x</mi><mi>c</mi></msub></mrow><mo>∈</mo><msup><mi>X</mi><msub><mi>τ</mi><mi>c</mi></msub></msup></mrow></mrow><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">\left\langle\nabla_{\theta}f_{0}(x_{c}),(\theta_{\tau_{b}}^{*}-\theta_{\tau_{c}}^{*})\right\rangle=0,\forall x_{c}\in X^{\tau_{c}}.</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="A2.SS1.p1.4" class="ltx_p"><span id="A2.SS1.p1.4.1" class="ltx_text">Thus, if <math id="A2.SS1.p1.m6" class="ltx_Math" alttext="\Delta^{\tau_{c}-&gt;\tau_{u}}(X^{\tau_{c}})=0" display="inline" intent=":literal"><semantics><mrow><mrow><msup><mi mathvariant="normal">Δ</mi><mrow><mrow><msub><mi>τ</mi><mi>c</mi></msub><mo rspace="0em">−</mo></mrow><mo lspace="0em">&gt;</mo><msub><mi>τ</mi><mi>u</mi></msub></mrow></msup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msup><mi>X</mi><msub><mi>τ</mi><mi>c</mi></msub></msup><mo stretchy="false">)</mo></mrow></mrow><mo>=</mo><mn>0</mn></mrow><annotation encoding="application/x-tex">\Delta^{\tau_{c}-&gt;\tau_{u}}(X^{\tau_{c}})=0</annotation></semantics></math>, we have</span></p>
<table id="A2.E31" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td rowspan="1" class="ltx_eqn_cell ltx_eqn_eqno ltx_align_middle ltx_align_left"><span class="ltx_tag ltx_tag_equation ltx_align_left">(31)</span></td>
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="A2.E31.m1" class="ltx_Math" alttext="\left\langle\nabla_{\theta}f_{0}(x_{c}),\theta_{\tau_{u}}^{*}-\theta_{\tau_{b}}^{*}\right\rangle=0," display="block" intent=":literal"><semantics><mrow><mrow><mrow><mo>⟨</mo><mrow><mrow><mrow><msub><mo rspace="0.167em">∇</mo><mi>θ</mi></msub><msub><mi>f</mi><mn>0</mn></msub></mrow><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mi>x</mi><mi>c</mi></msub><mo stretchy="false">)</mo></mrow></mrow><mo>,</mo><mrow><msubsup><mi>θ</mi><msub><mi>τ</mi><mi>u</mi></msub><mo>∗</mo></msubsup><mo>−</mo><msubsup><mi>θ</mi><msub><mi>τ</mi><mi>b</mi></msub><mo>∗</mo></msubsup></mrow></mrow><mo>⟩</mo></mrow><mo>=</mo><mn>0</mn></mrow><mo>,</mo></mrow><annotation encoding="application/x-tex">\left\langle\nabla_{\theta}f_{0}(x_{c}),\theta_{\tau_{u}}^{*}-\theta_{\tau_{b}}^{*}\right\rangle=0,</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="A2.SS1.p1.5" class="ltx_p"><em id="A2.SS1.p1.5.1" class="ltx_emph ltx_font_italic">i.e.,</em><span id="A2.SS1.p1.5.2" class="ltx_text"></span></p>
<table id="A2.E32" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td rowspan="1" class="ltx_eqn_cell ltx_eqn_eqno ltx_align_middle ltx_align_left"><span class="ltx_tag ltx_tag_equation ltx_align_left">(32)</span></td>
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="A2.E32.m1" class="ltx_Math" alttext="\nabla_{\theta}f_{0}(x_{c})\perp(\theta_{\tau_{u}}^{*}-\theta_{\tau_{b}}^{*}),\forall x_{c}\in X^{\tau_{c}}." display="block" intent=":literal"><semantics><mrow><mrow><mrow><mrow><mrow><msub><mo>∇</mo><mi>θ</mi></msub><msub><mi>f</mi><mn>0</mn></msub></mrow><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mi>x</mi><mi>c</mi></msub><mo stretchy="false">)</mo></mrow></mrow><mo>⟂</mo><mrow><mo stretchy="false">(</mo><mrow><msubsup><mi>θ</mi><msub><mi>τ</mi><mi>u</mi></msub><mo>∗</mo></msubsup><mo>−</mo><msubsup><mi>θ</mi><msub><mi>τ</mi><mi>b</mi></msub><mo>∗</mo></msubsup></mrow><mo stretchy="false">)</mo></mrow></mrow><mo>,</mo><mrow><mrow><mo rspace="0.167em">∀</mo><msub><mi>x</mi><mi>c</mi></msub></mrow><mo>∈</mo><msup><mi>X</mi><msub><mi>τ</mi><mi>c</mi></msub></msup></mrow></mrow><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">\nabla_{\theta}f_{0}(x_{c})\perp(\theta_{\tau_{u}}^{*}-\theta_{\tau_{b}}^{*}),\forall x_{c}\in X^{\tau_{c}}.</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="A2.SS1.p1.6" class="ltx_p"><span id="A2.SS1.p1.6.1" class="ltx_text">Given that both <math id="A2.SS1.p1.m7" class="ltx_Math" alttext="\theta_{\tau_{u}}^{*}-\theta_{\tau_{b}}^{*}" display="inline" intent=":literal"><semantics><mrow><msubsup><mi>θ</mi><msub><mi>τ</mi><mi>u</mi></msub><mo>∗</mo></msubsup><mo>−</mo><msubsup><mi>θ</mi><msub><mi>τ</mi><mi>b</mi></msub><mo>∗</mo></msubsup></mrow><annotation encoding="application/x-tex">\theta_{\tau_{u}}^{*}-\theta_{\tau_{b}}^{*}</annotation></semantics></math> and <math id="A2.SS1.p1.m8" class="ltx_Math" alttext="\theta_{\tau_{c}}^{*}-\theta_{0}" display="inline" intent=":literal"><semantics><mrow><msubsup><mi>θ</mi><msub><mi>τ</mi><mi>c</mi></msub><mo>∗</mo></msubsup><mo>−</mo><msub><mi>θ</mi><mn>0</mn></msub></mrow><annotation encoding="application/x-tex">\theta_{\tau_{c}}^{*}-\theta_{0}</annotation></semantics></math> can be regarded as approximate gradient directions for
the unlearning task <math id="A2.SS1.p1.m9" class="ltx_Math" alttext="\tau_{u}" display="inline" intent=":literal"><semantics><msub><mi>τ</mi><mi>u</mi></msub><annotation encoding="application/x-tex">\tau_{u}</annotation></semantics></math> and the clean task <math id="A2.SS1.p1.m10" class="ltx_Math" alttext="\tau_{c}" display="inline" intent=":literal"><semantics><msub><mi>τ</mi><mi>c</mi></msub><annotation encoding="application/x-tex">\tau_{c}</annotation></semantics></math>, respectively, it follows that</span></p>
<table id="A2.E33" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td rowspan="1" class="ltx_eqn_cell ltx_eqn_eqno ltx_align_middle ltx_align_left"><span class="ltx_tag ltx_tag_equation ltx_align_left">(33)</span></td>
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="A2.E33.m1" class="ltx_Math" alttext="\nabla_{\theta}f_{0}(x_{u},\theta)\perp(\theta_{\tau_{c}}^{*}-\theta_{0}),\forall x_{u}\in X^{\tau_{u}}." display="block" intent=":literal"><semantics><mrow><mrow><mrow><mrow><mrow><msub><mo>∇</mo><mi>θ</mi></msub><msub><mi>f</mi><mn>0</mn></msub></mrow><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mi>x</mi><mi>u</mi></msub><mo>,</mo><mi>θ</mi><mo stretchy="false">)</mo></mrow></mrow><mo>⟂</mo><mrow><mo stretchy="false">(</mo><mrow><msubsup><mi>θ</mi><msub><mi>τ</mi><mi>c</mi></msub><mo>∗</mo></msubsup><mo>−</mo><msub><mi>θ</mi><mn>0</mn></msub></mrow><mo stretchy="false">)</mo></mrow></mrow><mo>,</mo><mrow><mrow><mo rspace="0.167em">∀</mo><msub><mi>x</mi><mi>u</mi></msub></mrow><mo>∈</mo><msup><mi>X</mi><msub><mi>τ</mi><mi>u</mi></msub></msup></mrow></mrow><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">\nabla_{\theta}f_{0}(x_{u},\theta)\perp(\theta_{\tau_{c}}^{*}-\theta_{0}),\forall x_{u}\in X^{\tau_{u}}.</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="A2.SS1.p1.7" class="ltx_p"><span id="A2.SS1.p1.7.1" class="ltx_text">Similarly, for <math id="A2.SS1.p1.m11" class="ltx_Math" alttext="\Delta^{\tau_{c}\to\tau_{u}}(X^{\tau_{b}})=0" display="inline" intent=":literal"><semantics><mrow><mrow><msup><mi mathvariant="normal">Δ</mi><mrow><msub><mi>τ</mi><mi>c</mi></msub><mo stretchy="false">→</mo><msub><mi>τ</mi><mi>u</mi></msub></mrow></msup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msup><mi>X</mi><msub><mi>τ</mi><mi>b</mi></msub></msup><mo stretchy="false">)</mo></mrow></mrow><mo>=</mo><mn>0</mn></mrow><annotation encoding="application/x-tex">\Delta^{\tau_{c}\to\tau_{u}}(X^{\tau_{b}})=0</annotation></semantics></math>, we have</span></p>
<table id="A2.EGx6" class="ltx_equationgroup ltx_eqn_align ltx_eqn_table">

<tbody id="A2.E34"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td rowspan="1" class="ltx_eqn_cell ltx_eqn_eqno ltx_align_middle ltx_align_left"><span class="ltx_tag ltx_tag_equation ltx_align_left">(34)</span></td>
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_align_right ltx_eqn_cell"><math id="A2.E34.m1" class="ltx_Math" alttext="\displaystyle\Delta^{\tau_{c}-&gt;\tau_{u}}(X^{\tau_{b}})" display="inline" intent=":literal"><semantics><mrow><msup><mi mathvariant="normal">Δ</mi><mrow><mrow><msub><mi>τ</mi><mi>c</mi></msub><mo rspace="0em">−</mo></mrow><mo lspace="0em">&gt;</mo><msub><mi>τ</mi><mi>u</mi></msub></mrow></msup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msup><mi>X</mi><msub><mi>τ</mi><mi>b</mi></msub></msup><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">\displaystyle\Delta^{\tau_{c}-&gt;\tau_{u}}(X^{\tau_{b}})</annotation></semantics></math></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A2.E34.m2" class="ltx_Math" alttext="\displaystyle=\left\|\sigma^{\tau_{c}\to\tau_{u}}(X^{\tau_{b}})\right\|^{2}_{2}" display="inline" intent=":literal"><semantics><mrow><mphantom></mphantom><mo>=</mo><msubsup><mrow><mo>‖</mo><mrow><msup><mi>σ</mi><mrow><msub><mi>τ</mi><mi>c</mi></msub><mo stretchy="false">→</mo><msub><mi>τ</mi><mi>u</mi></msub></mrow></msup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msup><mi>X</mi><msub><mi>τ</mi><mi>b</mi></msub></msup><mo stretchy="false">)</mo></mrow></mrow><mo>‖</mo></mrow><mn>2</mn><mn>2</mn></msubsup></mrow><annotation encoding="application/x-tex">\displaystyle=\left\|\sigma^{\tau_{c}\to\tau_{u}}(X^{\tau_{b}})\right\|^{2}_{2}</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
<tbody id="A2.E35"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td rowspan="1" class="ltx_eqn_cell ltx_eqn_eqno ltx_align_middle ltx_align_left"><span class="ltx_tag ltx_tag_equation ltx_align_left">(35)</span></td>
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_eqn_cell"></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A2.E35.m1" class="ltx_Math" alttext="\displaystyle=\sum_{(x_{b},y)\in X^{\tau_{b}}}(\nabla_{\theta}f_{0}(x_{b})[(\theta_{\tau_{u}}^{*}-\theta_{\tau_{b}}^{*})+(\theta_{\tau_{b}}^{*}-\theta_{\tau_{c}}^{*})])^{2}." display="inline" intent=":literal"><semantics><mrow><mrow><mphantom></mphantom><mo>=</mo><mrow><mstyle displaystyle="true"><munder><mo movablelimits="false">∑</mo><mrow><mrow><mo stretchy="false">(</mo><msub><mi>x</mi><mi>b</mi></msub><mo>,</mo><mi>y</mi><mo stretchy="false">)</mo></mrow><mo>∈</mo><msup><mi>X</mi><msub><mi>τ</mi><mi>b</mi></msub></msup></mrow></munder></mstyle><msup><mrow><mo stretchy="false">(</mo><mrow><mrow><msub><mo rspace="0.167em">∇</mo><mi>θ</mi></msub><msub><mi>f</mi><mn>0</mn></msub></mrow><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mi>x</mi><mi>b</mi></msub><mo stretchy="false">)</mo></mrow><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">[</mo><mrow><mrow><mo stretchy="false">(</mo><mrow><msubsup><mi>θ</mi><msub><mi>τ</mi><mi>u</mi></msub><mo>∗</mo></msubsup><mo>−</mo><msubsup><mi>θ</mi><msub><mi>τ</mi><mi>b</mi></msub><mo>∗</mo></msubsup></mrow><mo stretchy="false">)</mo></mrow><mo>+</mo><mrow><mo stretchy="false">(</mo><mrow><msubsup><mi>θ</mi><msub><mi>τ</mi><mi>b</mi></msub><mo>∗</mo></msubsup><mo>−</mo><msubsup><mi>θ</mi><msub><mi>τ</mi><mi>c</mi></msub><mo>∗</mo></msubsup></mrow><mo stretchy="false">)</mo></mrow></mrow><mo stretchy="false">]</mo></mrow></mrow><mo stretchy="false">)</mo></mrow><mn>2</mn></msup></mrow></mrow><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">\displaystyle=\sum_{(x_{b},y)\in X^{\tau_{b}}}(\nabla_{\theta}f_{0}(x_{b})[(\theta_{\tau_{u}}^{*}-\theta_{\tau_{b}}^{*})+(\theta_{\tau_{b}}^{*}-\theta_{\tau_{c}}^{*})])^{2}.</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="A2.SS1.p1.8" class="ltx_p"><span id="A2.SS1.p1.8.1" class="ltx_text">Thus, we obtain <math id="A2.SS1.p1.m12" class="ltx_Math" alttext="(\theta_{\tau_{u}}^{*}-\theta_{\tau_{b}}^{*})=-(\theta_{\tau_{b}}^{*}-\theta_{\tau_{c}}^{*})" display="inline" intent=":literal"><semantics><mrow><mrow><mo stretchy="false">(</mo><mrow><msubsup><mi>θ</mi><msub><mi>τ</mi><mi>u</mi></msub><mo>∗</mo></msubsup><mo>−</mo><msubsup><mi>θ</mi><msub><mi>τ</mi><mi>b</mi></msub><mo>∗</mo></msubsup></mrow><mo stretchy="false">)</mo></mrow><mo>=</mo><mrow><mo>−</mo><mrow><mo stretchy="false">(</mo><mrow><msubsup><mi>θ</mi><msub><mi>τ</mi><mi>b</mi></msub><mo>∗</mo></msubsup><mo>−</mo><msubsup><mi>θ</mi><msub><mi>τ</mi><mi>c</mi></msub><mo>∗</mo></msubsup></mrow><mo stretchy="false">)</mo></mrow></mrow></mrow><annotation encoding="application/x-tex">(\theta_{\tau_{u}}^{*}-\theta_{\tau_{b}}^{*})=-(\theta_{\tau_{b}}^{*}-\theta_{\tau_{c}}^{*})</annotation></semantics></math>, <em id="A2.SS1.p1.8.1.1" class="ltx_emph ltx_font_italic">i.e.,</em></span></p>
<table id="A2.E36" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td rowspan="1" class="ltx_eqn_cell ltx_eqn_eqno ltx_align_middle ltx_align_left"><span class="ltx_tag ltx_tag_equation ltx_align_left">(36)</span></td>
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="A2.E36.m1" class="ltx_Math" alttext="\nabla_{\theta}f_{0}(x_{u},\theta)\parallel(\theta_{\tau_{b}}^{*}-\theta_{\tau_{c}}^{*}),\forall x_{u}\in X_{\tau_{u}}.\\
" display="block" intent=":literal"><semantics><mrow><mrow><mrow><mrow><msub><mo>∇</mo><mi>θ</mi></msub><msub><mi>f</mi><mn>0</mn></msub></mrow><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mi>x</mi><mi>u</mi></msub><mo>,</mo><mi>θ</mi><mo stretchy="false">)</mo></mrow></mrow><mo fence="false">|</mo><mrow><mrow><mo stretchy="false">(</mo><mrow><msubsup><mi>θ</mi><msub><mi>τ</mi><mi>b</mi></msub><mo>∗</mo></msubsup><mo>−</mo><msubsup><mi>θ</mi><msub><mi>τ</mi><mi>c</mi></msub><mo>∗</mo></msubsup></mrow><mo stretchy="false">)</mo></mrow><mo>,</mo><mrow><mrow><mo rspace="0.167em">∀</mo><msub><mi>x</mi><mi>u</mi></msub></mrow><mo>∈</mo><msub><mi>X</mi><msub><mi>τ</mi><mi>u</mi></msub></msub></mrow></mrow></mrow><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">\nabla_{\theta}f_{0}(x_{u},\theta)\parallel(\theta_{\tau_{b}}^{*}-\theta_{\tau_{c}}^{*}),\forall x_{u}\in X_{\tau_{u}}.\\
</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="A2.SS1.p1.9" class="ltx_p"><span id="A2.SS1.p1.9.1" class="ltx_text">∎</span></p>
</div>
</div>
</section>
<section id="A2.SS2" class="ltx_subsection">
<h3 class="ltx_title ltx_title_subsection"><span class="ltx_tag ltx_tag_subsection">B.2. </span>Proof of Proposition <a href="#S4.Thmtheorem3" title="Proposition 0. ‣ 4.1. Problem Formulation ‣ 4. Methodology ‣ Rethinking Backdoor Adversarial Unlearning through the Lens of Catastrophic Forgetting in Continual Learning" class="ltx_ref"><span class="ltx_text ltx_ref_tag">4.3</span></a></h3>

<div id="A2.SS2.2" class="ltx_proof">
<h6 class="ltx_title ltx_runin ltx_font_italic ltx_title_proof">Proof.</h6>
<div id="A2.SS2.p1" class="ltx_para">
<p id="A2.SS2.p1.1" class="ltx_p"><span id="A2.SS2.p1.1.1" class="ltx_text">For <math id="A2.SS2.p1.m1" class="ltx_Math" alttext="\nabla_{\theta}f_{0}(x,\theta)" display="inline" intent=":literal"><semantics><mrow><mrow><msub><mo>∇</mo><mi>θ</mi></msub><msub><mi>f</mi><mn>0</mn></msub></mrow><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>x</mi><mo>,</mo><mi>θ</mi><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">\nabla_{\theta}f_{0}(x,\theta)</annotation></semantics></math>,based on Equation <a href="#S3.E1" title="In 3.1. Notation ‣ 3. Preliminary ‣ Rethinking Backdoor Adversarial Unlearning through the Lens of Catastrophic Forgetting in Continual Learning" class="ltx_ref"><span class="ltx_text ltx_ref_tag">1</span></a>, we have</span></p>
<table id="A2.EGx7" class="ltx_equationgroup ltx_eqn_align ltx_eqn_table">

<tbody id="A2.Ex3"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_align_right ltx_eqn_cell"><math id="A2.Ex3.m1" class="ltx_Math" alttext="\displaystyle\frac{\partial f(x,w)}{\partial w^{l+1}}" display="inline" intent=":literal"><semantics><mstyle displaystyle="true"><mfrac><mrow><mo>∂</mo><mrow><mi>f</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>x</mi><mo>,</mo><mi>w</mi><mo stretchy="false">)</mo></mrow></mrow></mrow><mrow><mo>∂</mo><msup><mi>w</mi><mrow><mi>l</mi><mo>+</mo><mn>1</mn></mrow></msup></mrow></mfrac></mstyle><annotation encoding="application/x-tex">\displaystyle\frac{\partial f(x,w)}{\partial w^{l+1}}</annotation></semantics></math></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A2.Ex3.m2" class="ltx_Math" alttext="\displaystyle=\frac{\partial f(x,w)}{\partial h^{l+1}}\cdot\frac{\partial h^{l+1}}{\partial w^{l+1}}" display="inline" intent=":literal"><semantics><mrow><mphantom></mphantom><mo>=</mo><mrow><mstyle displaystyle="true"><mfrac><mrow><mo>∂</mo><mrow><mi>f</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>x</mi><mo>,</mo><mi>w</mi><mo stretchy="false">)</mo></mrow></mrow></mrow><mrow><mo>∂</mo><msup><mi>h</mi><mrow><mi>l</mi><mo>+</mo><mn>1</mn></mrow></msup></mrow></mfrac></mstyle><mo lspace="0.222em" rspace="0.222em">⋅</mo><mstyle displaystyle="true"><mfrac><mrow><mo>∂</mo><msup><mi>h</mi><mrow><mi>l</mi><mo>+</mo><mn>1</mn></mrow></msup></mrow><mrow><mo>∂</mo><msup><mi>w</mi><mrow><mi>l</mi><mo>+</mo><mn>1</mn></mrow></msup></mrow></mfrac></mstyle></mrow></mrow><annotation encoding="application/x-tex">\displaystyle=\frac{\partial f(x,w)}{\partial h^{l+1}}\cdot\frac{\partial h^{l+1}}{\partial w^{l+1}}</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
<tbody id="A2.Ex4"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_eqn_cell"></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A2.Ex4.m1" class="ltx_Math" alttext="\displaystyle=\frac{\partial f(x,w)}{\partial h^{l+1}}\cdot z^{l}" display="inline" intent=":literal"><semantics><mrow><mphantom></mphantom><mo>=</mo><mrow><mstyle displaystyle="true"><mfrac><mrow><mo>∂</mo><mrow><mi>f</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>x</mi><mo>,</mo><mi>w</mi><mo stretchy="false">)</mo></mrow></mrow></mrow><mrow><mo>∂</mo><msup><mi>h</mi><mrow><mi>l</mi><mo>+</mo><mn>1</mn></mrow></msup></mrow></mfrac></mstyle><mo lspace="0.222em" rspace="0.222em">⋅</mo><msup><mi>z</mi><mi>l</mi></msup></mrow></mrow><annotation encoding="application/x-tex">\displaystyle=\frac{\partial f(x,w)}{\partial h^{l+1}}\cdot z^{l}</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
<tbody id="A2.E37"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td rowspan="1" class="ltx_eqn_cell ltx_eqn_eqno ltx_align_middle ltx_align_left"><span class="ltx_tag ltx_tag_equation ltx_align_left">(37)</span></td>
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_eqn_cell"></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A2.E37.m1" class="ltx_Math" alttext="\displaystyle=\frac{\partial f(x,w)}{z^{l+1}}\cdot\frac{\partial z^{l+1}}{\partial h^{l+1}}\cdot z^{l}." display="inline" intent=":literal"><semantics><mrow><mrow><mphantom></mphantom><mo>=</mo><mrow><mstyle displaystyle="true"><mfrac><mrow><mo>∂</mo><mrow><mi>f</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>x</mi><mo>,</mo><mi>w</mi><mo stretchy="false">)</mo></mrow></mrow></mrow><msup><mi>z</mi><mrow><mi>l</mi><mo>+</mo><mn>1</mn></mrow></msup></mfrac></mstyle><mo lspace="0.222em" rspace="0.222em">⋅</mo><mstyle displaystyle="true"><mfrac><mrow><mo>∂</mo><msup><mi>z</mi><mrow><mi>l</mi><mo>+</mo><mn>1</mn></mrow></msup></mrow><mrow><mo>∂</mo><msup><mi>h</mi><mrow><mi>l</mi><mo>+</mo><mn>1</mn></mrow></msup></mrow></mfrac></mstyle><mo lspace="0.222em" rspace="0.222em">⋅</mo><msup><mi>z</mi><mi>l</mi></msup></mrow></mrow><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">\displaystyle=\frac{\partial f(x,w)}{z^{l+1}}\cdot\frac{\partial z^{l+1}}{\partial h^{l+1}}\cdot z^{l}.</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="A2.SS2.p1.2" class="ltx_p"><span id="A2.SS2.p1.2.1" class="ltx_text">If the gradients of the backdoor unlearning task <math id="A2.SS2.p1.m2" class="ltx_Math" alttext="\tau_{u}" display="inline" intent=":literal"><semantics><msub><mi>τ</mi><mi>u</mi></msub><annotation encoding="application/x-tex">\tau_{u}</annotation></semantics></math> are aligned with those of the backdoor task <math id="A2.SS2.p1.m3" class="ltx_Math" alttext="\tau_{b}" display="inline" intent=":literal"><semantics><msub><mi>τ</mi><mi>b</mi></msub><annotation encoding="application/x-tex">\tau_{b}</annotation></semantics></math>, <em id="A2.SS2.p1.2.1.1" class="ltx_emph ltx_font_italic">i.e.,</em></span></p>
<table id="A2.E38" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td rowspan="1" class="ltx_eqn_cell ltx_eqn_eqno ltx_align_middle ltx_align_left"><span class="ltx_tag ltx_tag_equation ltx_align_left">(38)</span></td>
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="A2.E38.m1" class="ltx_Math" alttext="\nabla_{\theta}f_{0}(x_{u},\theta)\parallel\nabla_{\theta}f_{0}(x_{b},\theta),\forall x_{u}\in X_{\tau_{u}},\forall x_{b}\in X_{\tau_{b}}." display="block" intent=":literal"><semantics><mrow><mrow><mrow><mrow><msub><mo>∇</mo><mi>θ</mi></msub><msub><mi>f</mi><mn>0</mn></msub></mrow><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mi>x</mi><mi>u</mi></msub><mo>,</mo><mi>θ</mi><mo stretchy="false">)</mo></mrow></mrow><mo fence="false">|</mo><mrow><mrow><mrow><msub><mo rspace="0.167em">∇</mo><mi>θ</mi></msub><msub><mi>f</mi><mn>0</mn></msub></mrow><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mi>x</mi><mi>b</mi></msub><mo>,</mo><mi>θ</mi><mo stretchy="false">)</mo></mrow></mrow><mo>,</mo><mrow><mrow><mo rspace="0.167em">∀</mo><msub><mi>x</mi><mi>u</mi></msub></mrow><mo>∈</mo><msub><mi>X</mi><msub><mi>τ</mi><mi>u</mi></msub></msub></mrow><mo>,</mo><mrow><mrow><mo rspace="0.167em">∀</mo><msub><mi>x</mi><mi>b</mi></msub></mrow><mo>∈</mo><msub><mi>X</mi><msub><mi>τ</mi><mi>b</mi></msub></msub></mrow></mrow></mrow><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">\nabla_{\theta}f_{0}(x_{u},\theta)\parallel\nabla_{\theta}f_{0}(x_{b},\theta),\forall x_{u}\in X_{\tau_{u}},\forall x_{b}\in X_{\tau_{b}}.</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="A2.SS2.p1.3" class="ltx_p"><span id="A2.SS2.p1.3.1" class="ltx_text">Then, the outputs of each layer of the neural network, <math id="A2.SS2.p1.m4" class="ltx_Math" alttext="z^{l+1}_{u}" display="inline" intent=":literal"><semantics><msubsup><mi>z</mi><mi>u</mi><mrow><mi>l</mi><mo>+</mo><mn>1</mn></mrow></msubsup><annotation encoding="application/x-tex">z^{l+1}_{u}</annotation></semantics></math> and <math id="A2.SS2.p1.m5" class="ltx_Math" alttext="z^{l+1}_{b}" display="inline" intent=":literal"><semantics><msubsup><mi>z</mi><mi>b</mi><mrow><mi>l</mi><mo>+</mo><mn>1</mn></mrow></msubsup><annotation encoding="application/x-tex">z^{l+1}_{b}</annotation></semantics></math> should also be aligned accordingly.</span></p>
</div>
<div id="A2.SS2.p2" class="ltx_para">
<p id="A2.SS2.p2.1" class="ltx_p"><span id="A2.SS2.p2.1.1" class="ltx_text">Given the characteristics of backdoor attacks, for the poisoned sample <math id="A2.SS2.p2.m1" class="ltx_Math" alttext="\forall x_{b}\in X^{\tau_{b}}" display="inline" intent=":literal"><semantics><mrow><mrow><mo rspace="0.167em">∀</mo><msub><mi>x</mi><mi>b</mi></msub></mrow><mo>∈</mo><msup><mi>X</mi><msub><mi>τ</mi><mi>b</mi></msub></msup></mrow><annotation encoding="application/x-tex">\forall x_{b}\in X^{\tau_{b}}</annotation></semantics></math>, the backdoor model predicts the poisoned sample <math id="A2.SS2.p2.m2" class="ltx_Math" alttext="x_{b}" display="inline" intent=":literal"><semantics><msub><mi>x</mi><mi>b</mi></msub><annotation encoding="application/x-tex">x_{b}</annotation></semantics></math> into
the target label, whereas the clean model tends to classify it as its real source label <math id="A2.SS2.p2.m3" class="ltx_Math" alttext="y" display="inline" intent=":literal"><semantics><mi>y</mi><annotation encoding="application/x-tex">y</annotation></semantics></math>. Therefore, we can conclude that for <math id="A2.SS2.p2.m4" class="ltx_Math" alttext="\forall x_{b}\in X^{\tau_{b}}" display="inline" intent=":literal"><semantics><mrow><mrow><mo rspace="0.167em">∀</mo><msub><mi>x</mi><mi>b</mi></msub></mrow><mo>∈</mo><msup><mi>X</mi><msub><mi>τ</mi><mi>b</mi></msub></msup></mrow><annotation encoding="application/x-tex">\forall x_{b}\in X^{\tau_{b}}</annotation></semantics></math>,
we have <math id="A2.SS2.p2.m5" class="ltx_Math" alttext="f^{*}_{\tau_{b}}(x_{b})=y_{t}" display="inline" intent=":literal"><semantics><mrow><mrow><msubsup><mi>f</mi><msub><mi>τ</mi><mi>b</mi></msub><mo>∗</mo></msubsup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mi>x</mi><mi>b</mi></msub><mo stretchy="false">)</mo></mrow></mrow><mo>=</mo><msub><mi>y</mi><mi>t</mi></msub></mrow><annotation encoding="application/x-tex">f^{*}_{\tau_{b}}(x_{b})=y_{t}</annotation></semantics></math> and <math id="A2.SS2.p2.m6" class="ltx_Math" alttext="f^{*}_{\tau_{c}}(x_{b})=y" display="inline" intent=":literal"><semantics><mrow><mrow><msubsup><mi>f</mi><msub><mi>τ</mi><mi>c</mi></msub><mo>∗</mo></msubsup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mi>x</mi><mi>b</mi></msub><mo stretchy="false">)</mo></mrow></mrow><mo>=</mo><mi>y</mi></mrow><annotation encoding="application/x-tex">f^{*}_{\tau_{c}}(x_{b})=y</annotation></semantics></math>. Consequently, For <math id="A2.SS2.p2.m7" class="ltx_Math" alttext="\forall\tilde{x}\in X^{\tau_{u}}" display="inline" intent=":literal"><semantics><mrow><mrow><mo rspace="0.167em">∀</mo><mover accent="true"><mi>x</mi><mo>~</mo></mover></mrow><mo>∈</mo><msup><mi>X</mi><msub><mi>τ</mi><mi>u</mi></msub></msup></mrow><annotation encoding="application/x-tex">\forall\tilde{x}\in X^{\tau_{u}}</annotation></semantics></math>, the following conditions must be satisfied:</span></p>
<table id="A2.E39" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td rowspan="1" class="ltx_eqn_cell ltx_eqn_eqno ltx_align_middle ltx_align_left"><span class="ltx_tag ltx_tag_equation ltx_align_left">(39)</span></td>
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="A2.E39.m1" class="ltx_math_unparsed" alttext="\left\{\begin{matrix}f^{*}_{\tau_{c}}(\tilde{x};\theta_{\tau_{c}})=f^{*}_{\tau_{c}}(x_{b};\theta_{\tau_{c}})=y,\\
f^{*}_{\tau_{b}}(\tilde{x};\theta_{\tau_{b}})=f^{*}_{\tau_{b}}(x_{b};\theta_{\tau_{b}})=y_{t}.\\
\end{matrix}\right." display="block" intent=":literal"><semantics><mrow><mo>{</mo><mtable displaystyle="true" rowspacing="0pt"><mtr><mtd><mrow><mrow><mrow><msubsup><mi>f</mi><msub><mi>τ</mi><mi>c</mi></msub><mo>∗</mo></msubsup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mover accent="true"><mi>x</mi><mo>~</mo></mover><mo>,</mo><msub><mi>θ</mi><msub><mi>τ</mi><mi>c</mi></msub></msub><mo stretchy="false">)</mo></mrow></mrow><mo>=</mo><mrow><msubsup><mi>f</mi><msub><mi>τ</mi><mi>c</mi></msub><mo>∗</mo></msubsup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mi>x</mi><mi>b</mi></msub><mo>,</mo><msub><mi>θ</mi><msub><mi>τ</mi><mi>c</mi></msub></msub><mo stretchy="false">)</mo></mrow></mrow><mo>=</mo><mi>y</mi></mrow><mo>,</mo></mrow></mtd></mtr><mtr><mtd><mrow><mrow><mrow><msubsup><mi>f</mi><msub><mi>τ</mi><mi>b</mi></msub><mo>∗</mo></msubsup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mover accent="true"><mi>x</mi><mo>~</mo></mover><mo>,</mo><msub><mi>θ</mi><msub><mi>τ</mi><mi>b</mi></msub></msub><mo stretchy="false">)</mo></mrow></mrow><mo>=</mo><mrow><msubsup><mi>f</mi><msub><mi>τ</mi><mi>b</mi></msub><mo>∗</mo></msubsup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mi>x</mi><mi>b</mi></msub><mo>,</mo><msub><mi>θ</mi><msub><mi>τ</mi><mi>b</mi></msub></msub><mo stretchy="false">)</mo></mrow></mrow><mo>=</mo><msub><mi>y</mi><mi>t</mi></msub></mrow><mo lspace="0em">.</mo></mrow></mtd></mtr></mtable></mrow><annotation encoding="application/x-tex">\left\{\begin{matrix}f^{*}_{\tau_{c}}(\tilde{x};\theta_{\tau_{c}})=f^{*}_{\tau_{c}}(x_{b};\theta_{\tau_{c}})=y,\\
f^{*}_{\tau_{b}}(\tilde{x};\theta_{\tau_{b}})=f^{*}_{\tau_{b}}(x_{b};\theta_{\tau_{b}})=y_{t}.\\
\end{matrix}\right.</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
</div>
<div id="A2.SS2.p3" class="ltx_para">
<p id="A2.SS2.p3.1" class="ltx_p"><span id="A2.SS2.p3.1.1" class="ltx_text">∎</span></p>
</div>
</div>
</section>
<section id="A2.SS3" class="ltx_subsection">
<h3 class="ltx_title ltx_title_subsection"><span class="ltx_tag ltx_tag_subsection">B.3. </span>Derivation of <span id="A2.SS3.2" class="ltx_text">MAP<sub id="A2.SS3.2.1" class="ltx_sub"><span id="A2.SS3.2.1.1" class="ltx_text ltx_font_italic">θ</span></sub></span></h3>

<div id="A2.SS3.p1" class="ltx_para">
<p id="A2.SS3.p1.1" class="ltx_p">For <math id="A2.SS3.p1.m1" class="ltx_Math" alttext="\log p(\theta|y)" display="inline" intent=":literal"><semantics><mrow><mi>log</mi><mo lspace="0.167em">⁡</mo><mrow><mi>p</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>θ</mi><mo lspace="0em" rspace="0em">|</mo><mi>y</mi><mo stretchy="false">)</mo></mrow></mrow></mrow><annotation encoding="application/x-tex">\log p(\theta|y)</annotation></semantics></math>, we have</p>
<table id="A2.E40" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td rowspan="0" class="ltx_eqn_cell ltx_eqn_eqno ltx_align_middle ltx_align_left"><span class="ltx_tag ltx_tag_equation ltx_align_left">(40)</span></td>
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center">
<div id="A2.E40.2" class="ltx_inline-block ltx_markedasmath ltx_transformed_outer" style="width:310.5pt;height:82.3pt;vertical-align:-37.4pt;"><span class="ltx_transformed_inner" style="transform:translate(52.5pt,-13.9pt) scale(1.51107341082618,1.51107341082618) ;">
<p id="A2.E40.2.1" class="ltx_p"><math id="A2.E40.m1.m1" class="ltx_Math" alttext="\begin{aligned} &amp;\log p(\theta|y)=\int q(\tilde{x})\cdot\log(p(\theta|y))d\tilde{x}\\
&amp;=\int q(\tilde{x})\log(\frac{p(\theta,\tilde{x}|y)}{p(\tilde{x}|\theta,y)})d\tilde{x}\\
&amp;=\int q(\tilde{x})\left[\log(\frac{p(\theta,\tilde{x}|y)}{q(\tilde{x})})-\log(\frac{p(\tilde{x}|\theta,y)}{q(\tilde{x})})\right]d\tilde{x}\\
&amp;=\underbrace{\int q(\tilde{x})\left[\log(p(\theta,\tilde{x}|y))-\log(q(\tilde{x}))\right]d\tilde{x}}_{L(q,\theta)}+\underbrace{\int q(\tilde{x})\log(\frac{q(\tilde{x})}{p(\tilde{x}|\theta,y)})d\tilde{x}}_{KL(q(\tilde{x})||p(\tilde{x}|\theta,y))}.\end{aligned}" display="inline" intent=":literal"><semantics><mtable columnspacing="0pt" rowspacing="0pt"><mtr><mtd></mtd><mtd class="ltx_align_left" columnalign="left"><mrow><mrow><mi>log</mi><mo lspace="0.167em">⁡</mo><mrow><mi>p</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>θ</mi><mo lspace="0em" rspace="0em">|</mo><mi>y</mi><mo stretchy="false">)</mo></mrow></mrow></mrow><mo>=</mo><mrow><mrow><mstyle displaystyle="true"><mrow><mo>∫</mo><mrow><mi>q</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mover accent="true"><mi>x</mi><mo>~</mo></mover><mo stretchy="false">)</mo></mrow></mrow></mrow></mstyle><mo lspace="0.222em" rspace="0.222em">⋅</mo><mrow><mi>log</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mrow><mi>p</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>θ</mi><mo lspace="0em" rspace="0em">|</mo><mi>y</mi><mo stretchy="false">)</mo></mrow></mrow><mo stretchy="false">)</mo></mrow></mrow></mrow><mo lspace="0em" rspace="0em">​</mo><mrow><mo rspace="0em">d</mo><mover accent="true"><mi>x</mi><mo>~</mo></mover></mrow></mrow></mrow></mtd></mtr><mtr><mtd></mtd><mtd class="ltx_align_left" columnalign="left"><mrow><mphantom></mphantom><mo>=</mo><mstyle displaystyle="true"><mrow><mo>∫</mo><mrow><mrow><mi>q</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mover accent="true"><mi>x</mi><mo>~</mo></mover><mo stretchy="false">)</mo></mrow></mrow><mo lspace="0.167em" rspace="0em">​</mo><mrow><mi>log</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mfrac><mrow><mi>p</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mrow><mi>θ</mi><mo>,</mo><mover accent="true"><mi>x</mi><mo>~</mo></mover></mrow><mo lspace="0em" rspace="0em">|</mo><mi>y</mi><mo stretchy="false">)</mo></mrow></mrow><mrow><mi>p</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mover accent="true"><mi>x</mi><mo>~</mo></mover><mo lspace="0em" rspace="0em">|</mo><mrow><mi>θ</mi><mo>,</mo><mi>y</mi></mrow><mo stretchy="false">)</mo></mrow></mrow></mfrac><mo stretchy="false">)</mo></mrow></mrow><mo lspace="0em" rspace="0em">​</mo><mrow><mo rspace="0em">d</mo><mover accent="true"><mi>x</mi><mo>~</mo></mover></mrow></mrow></mrow></mstyle></mrow></mtd></mtr><mtr><mtd></mtd><mtd class="ltx_align_left" columnalign="left"><mrow><mphantom></mphantom><mo>=</mo><mstyle displaystyle="true"><mrow><mo>∫</mo><mrow><mrow><mi>q</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mover accent="true"><mi>x</mi><mo>~</mo></mover><mo stretchy="false">)</mo></mrow></mrow><mo lspace="0em" rspace="0em">​</mo><mrow><mo>[</mo><mrow><mrow><mi>log</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mfrac><mrow><mi>p</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mrow><mi>θ</mi><mo>,</mo><mover accent="true"><mi>x</mi><mo>~</mo></mover></mrow><mo lspace="0em" rspace="0em">|</mo><mi>y</mi><mo stretchy="false">)</mo></mrow></mrow><mrow><mi>q</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mover accent="true"><mi>x</mi><mo>~</mo></mover><mo stretchy="false">)</mo></mrow></mrow></mfrac><mo stretchy="false">)</mo></mrow></mrow><mo>−</mo><mrow><mi>log</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mfrac><mrow><mi>p</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mover accent="true"><mi>x</mi><mo>~</mo></mover><mo lspace="0em" rspace="0em">|</mo><mrow><mi>θ</mi><mo>,</mo><mi>y</mi></mrow><mo stretchy="false">)</mo></mrow></mrow><mrow><mi>q</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mover accent="true"><mi>x</mi><mo>~</mo></mover><mo stretchy="false">)</mo></mrow></mrow></mfrac><mo stretchy="false">)</mo></mrow></mrow></mrow><mo>]</mo></mrow><mo lspace="0em" rspace="0em">​</mo><mrow><mo rspace="0em">d</mo><mover accent="true"><mi>x</mi><mo>~</mo></mover></mrow></mrow></mrow></mstyle></mrow></mtd></mtr><mtr><mtd></mtd><mtd class="ltx_align_left" columnalign="left"><mrow><mo>=</mo><munder accentunder="true"><mstyle displaystyle="true"><mrow><mo>∫</mo><mrow><mrow><mi>q</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mover accent="true"><mi>x</mi><mo>~</mo></mover><mo stretchy="false">)</mo></mrow></mrow><mo lspace="0em" rspace="0em">​</mo><mrow><mo>[</mo><mrow><mrow><mi>log</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mrow><mi>p</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mrow><mi>θ</mi><mo>,</mo><mover accent="true"><mi>x</mi><mo>~</mo></mover></mrow><mo lspace="0em" rspace="0em">|</mo><mi>y</mi><mo stretchy="false">)</mo></mrow></mrow><mo stretchy="false">)</mo></mrow></mrow><mo>−</mo><mrow><mi>log</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mrow><mi>q</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mover accent="true"><mi>x</mi><mo>~</mo></mover><mo stretchy="false">)</mo></mrow></mrow><mo stretchy="false">)</mo></mrow></mrow></mrow><mo>]</mo></mrow><mo lspace="0em" rspace="0em">​</mo><mrow><mo rspace="0em">d</mo><mover accent="true"><mi>x</mi><mo>~</mo></mover></mrow></mrow></mrow></mstyle><mo stretchy="true">⏟</mo></munder><msub><mrow></mrow><mrow><mi>L</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>q</mi><mo>,</mo><mi>θ</mi><mo stretchy="false">)</mo></mrow></mrow></msub><mo>+</mo><munder accentunder="true"><mstyle displaystyle="true"><mrow><mo>∫</mo><mrow><mrow><mi>q</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mover accent="true"><mi>x</mi><mo>~</mo></mover><mo stretchy="false">)</mo></mrow></mrow><mo lspace="0.167em" rspace="0em">​</mo><mrow><mi>log</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mfrac><mrow><mi>q</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mover accent="true"><mi>x</mi><mo>~</mo></mover><mo stretchy="false">)</mo></mrow></mrow><mrow><mi>p</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mover accent="true"><mi>x</mi><mo>~</mo></mover><mo lspace="0em" rspace="0em">|</mo><mrow><mi>θ</mi><mo>,</mo><mi>y</mi></mrow><mo stretchy="false">)</mo></mrow></mrow></mfrac><mo stretchy="false">)</mo></mrow></mrow><mo lspace="0em" rspace="0em">​</mo><mrow><mo rspace="0em">d</mo><mover accent="true"><mi>x</mi><mo>~</mo></mover></mrow></mrow></mrow></mstyle><mo stretchy="true">⏟</mo></munder><msub><mrow></mrow><mrow><mi>K</mi><mi>L</mi><mo stretchy="false">(</mo><mi>q</mi><mo stretchy="false">(</mo><mover accent="true"><mi>x</mi><mo>~</mo></mover><mo stretchy="false">)</mo><mo fence="false" rspace="0.167em" stretchy="false">|</mo><mo fence="false" rspace="0.167em" stretchy="false">|</mo><mi>p</mi><mo stretchy="false">(</mo><mover accent="true"><mi>x</mi><mo>~</mo></mover><mo fence="false" rspace="0.167em" stretchy="false">|</mo><mi>θ</mi><mo>,</mo><mi>y</mi><mo stretchy="false">)</mo><mo stretchy="false">)</mo></mrow></msub><mo lspace="0em">.</mo></mrow></mtd></mtr></mtable><annotation encoding="application/x-tex">\begin{aligned} &amp;\log p(\theta|y)=\int q(\tilde{x})\cdot\log(p(\theta|y))d\tilde{x}\\
&amp;=\int q(\tilde{x})\log(\frac{p(\theta,\tilde{x}|y)}{p(\tilde{x}|\theta,y)})d\tilde{x}\\
&amp;=\int q(\tilde{x})\left[\log(\frac{p(\theta,\tilde{x}|y)}{q(\tilde{x})})-\log(\frac{p(\tilde{x}|\theta,y)}{q(\tilde{x})})\right]d\tilde{x}\\
&amp;=\underbrace{\int q(\tilde{x})\left[\log(p(\theta,\tilde{x}|y))-\log(q(\tilde{x}))\right]d\tilde{x}}_{L(q,\theta)}+\underbrace{\int q(\tilde{x})\log(\frac{q(\tilde{x})}{p(\tilde{x}|\theta,y)})d\tilde{x}}_{KL(q(\tilde{x})||p(\tilde{x}|\theta,y))}.\end{aligned}</annotation></semantics></math></p>
</span></div></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
</div>
</section>
</section>
<section id="A3" class="ltx_appendix">
<h2 class="ltx_title ltx_title_appendix"><span class="ltx_tag ltx_tag_appendix">Appendix C </span>Extending BI-BAU to Multi-Modal Contrastive Learning</h2>

<div id="A3.p1" class="ltx_para">
<p id="A3.p1.1" class="ltx_p">Moreover, our BI-BAU framework can be easily extended to multi-modal contrastive learning scenarios. Taking the Contrastive Language-Image Pre-training (CLIP) model
as an example, CLIP <cite class="ltx_cite ltx_citemacro_citep">(<a href="#bib.bib42" title="" class="ltx_ref">Radford et al., 2021</a>)</cite> is a vision-language pre-training framework that enables cross-modal understanding by aligning image and text modalities
within a shared feature space. A pre-trained CLIP model typically consists of an visual encoder <math id="A3.p1.m1" class="ltx_Math" alttext="\mathcal{I}(\cdot;\theta_{\mathcal{I}})" display="inline" intent=":literal"><semantics><mrow><mi class="ltx_font_mathcaligraphic">ℐ</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mo lspace="0em" rspace="0em">⋅</mo><mo>,</mo><msub><mi>θ</mi><mi class="ltx_font_mathcaligraphic">ℐ</mi></msub><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">\mathcal{I}(\cdot;\theta_{\mathcal{I}})</annotation></semantics></math> and a text encoder
<math id="A3.p1.m2" class="ltx_Math" alttext="\mathcal{T}(\cdot;\theta_{\mathcal{T}})" display="inline" intent=":literal"><semantics><mrow><mi class="ltx_font_mathcaligraphic">𝒯</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mo lspace="0em" rspace="0em">⋅</mo><mo>,</mo><msub><mi>θ</mi><mi class="ltx_font_mathcaligraphic">𝒯</mi></msub><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">\mathcal{T}(\cdot;\theta_{\mathcal{T}})</annotation></semantics></math>.</p>
</div>
<div id="A3.p2" class="ltx_para">
<p id="A3.p2.1" class="ltx_p">For a <math id="A3.p2.m1" class="ltx_Math" alttext="K" display="inline" intent=":literal"><semantics><mi>K</mi><annotation encoding="application/x-tex">K</annotation></semantics></math>-class classification task, given an image-text pair <math id="A3.p2.m2" class="ltx_Math" alttext="(I,T)" display="inline" intent=":literal"><semantics><mrow><mo stretchy="false">(</mo><mi>I</mi><mo>,</mo><mi>T</mi><mo stretchy="false">)</mo></mrow><annotation encoding="application/x-tex">(I,T)</annotation></semantics></math>, the visual encoder (<em id="A3.p2.1.1" class="ltx_emph ltx_font_italic">e.g.,</em> a Vision Transformer (ViT) <cite class="ltx_cite ltx_citemacro_citep">(<a href="#bib.bib10" title="" class="ltx_ref">Dosovitskiy et al., 2020</a>)</cite>) produces
the image feature representation <math id="A3.p2.m3" class="ltx_Math" alttext="z(I)=\mathcal{I}(I;\theta_{\mathcal{I}})" display="inline" intent=":literal"><semantics><mrow><mrow><mi>z</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>I</mi><mo stretchy="false">)</mo></mrow></mrow><mo>=</mo><mrow><mi class="ltx_font_mathcaligraphic">ℐ</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>I</mi><mo>,</mo><msub><mi>θ</mi><mi class="ltx_font_mathcaligraphic">ℐ</mi></msub><mo stretchy="false">)</mo></mrow></mrow></mrow><annotation encoding="application/x-tex">z(I)=\mathcal{I}(I;\theta_{\mathcal{I}})</annotation></semantics></math>.
For the text branch, each class name <math id="A3.p2.m4" class="ltx_Math" alttext="t_{i}" display="inline" intent=":literal"><semantics><msub><mi>t</mi><mi>i</mi></msub><annotation encoding="application/x-tex">t_{i}</annotation></semantics></math> is inserted into a predefined template prompt (<em id="A3.p2.1.2" class="ltx_emph ltx_font_italic">e.g.,</em> “a photo of a class”), forming the text <math id="A3.p2.m5" class="ltx_Math" alttext="T_{i}" display="inline" intent=":literal"><semantics><msub><mi>T</mi><mi>i</mi></msub><annotation encoding="application/x-tex">T_{i}</annotation></semantics></math>.
The text encoder then produces the corresponding textual representation <math id="A3.p2.m6" class="ltx_Math" alttext="z(T_{i})=\mathcal{T}(T_{i},\theta_{\mathcal{T}})" display="inline" intent=":literal"><semantics><mrow><mrow><mi>z</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><msub><mi>T</mi><mi>i</mi></msub><mo stretchy="false">)</mo></mrow></mrow><mo>=</mo><mrow><mi class="ltx_font_mathcaligraphic">𝒯</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><msub><mi>T</mi><mi>i</mi></msub><mo>,</mo><msub><mi>θ</mi><mi class="ltx_font_mathcaligraphic">𝒯</mi></msub><mo stretchy="false">)</mo></mrow></mrow></mrow><annotation encoding="application/x-tex">z(T_{i})=\mathcal{T}(T_{i},\theta_{\mathcal{T}})</annotation></semantics></math>.</p>
</div>
<div id="A3.p3" class="ltx_para">
<p id="A3.p3.1" class="ltx_p">During training, CLIP employs contrastive learning to align image and text representations. Given a batch of <math id="A3.p3.m1" class="ltx_Math" alttext="n" display="inline" intent=":literal"><semantics><mi>n</mi><annotation encoding="application/x-tex">n</annotation></semantics></math> pairs <math id="A3.p3.m2" class="ltx_Math" alttext="(I_{j},T_{j})" display="inline" intent=":literal"><semantics><mrow><mo stretchy="false">(</mo><msub><mi>I</mi><mi>j</mi></msub><mo>,</mo><msub><mi>T</mi><mi>j</mi></msub><mo stretchy="false">)</mo></mrow><annotation encoding="application/x-tex">(I_{j},T_{j})</annotation></semantics></math>, the bidirectional loss
including image-to-text matching loss and Text-to-Image matching loss, is computed as:</p>
<table id="A3.E41" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td rowspan="1" class="ltx_eqn_cell ltx_eqn_eqno ltx_align_middle ltx_align_left"><span class="ltx_tag ltx_tag_equation ltx_align_left">(41)</span></td>
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="A3.E41.m1" class="ltx_math_unparsed" alttext="\mathcal{L}_{\text{img2txt}}=-\frac{1}{n}\sum_{j=1}^{n}\log\frac{\exp(\cos(z(I_{j}),z(T_{j}))/\tau)}{\sum_{k=1}^{n}\exp(\cos(z(I_{j}),z(T_{k}))/\tau)}," display="block" intent=":literal"><semantics><mrow><mi class="ltx_font_mathcaligraphic">ℒ</mi><msub><mrow></mrow><mtext>img2txt</mtext></msub><mo rspace="0em">=</mo><mo lspace="0em">−</mo><mfrac><mn>1</mn><mi>n</mi></mfrac><mo movablelimits="false">∑</mo><msub><mrow></mrow><mrow><mi>j</mi><mo>=</mo><mn>1</mn></mrow></msub><msup><mrow></mrow><mi>n</mi></msup><mi>log</mi><mfrac><mrow><mi>exp</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mrow><mrow><mi>cos</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mrow><mi>z</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><msub><mi>I</mi><mi>j</mi></msub><mo stretchy="false">)</mo></mrow></mrow><mo>,</mo><mrow><mi>z</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><msub><mi>T</mi><mi>j</mi></msub><mo stretchy="false">)</mo></mrow></mrow><mo stretchy="false">)</mo></mrow></mrow><mo>/</mo><mi>τ</mi></mrow><mo stretchy="false">)</mo></mrow></mrow><mrow><msubsup><mo>∑</mo><mrow><mi>k</mi><mo>=</mo><mn>1</mn></mrow><mi>n</mi></msubsup><mrow><mi>exp</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mrow><mrow><mi>cos</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mrow><mi>z</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><msub><mi>I</mi><mi>j</mi></msub><mo stretchy="false">)</mo></mrow></mrow><mo>,</mo><mrow><mi>z</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><msub><mi>T</mi><mi>k</mi></msub><mo stretchy="false">)</mo></mrow></mrow><mo stretchy="false">)</mo></mrow></mrow><mo>/</mo><mi>τ</mi></mrow><mo stretchy="false">)</mo></mrow></mrow></mrow></mfrac><mo>,</mo></mrow><annotation encoding="application/x-tex">\mathcal{L}_{\text{img2txt}}=-\frac{1}{n}\sum_{j=1}^{n}\log\frac{\exp(\cos(z(I_{j}),z(T_{j}))/\tau)}{\sum_{k=1}^{n}\exp(\cos(z(I_{j}),z(T_{k}))/\tau)},</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
</div>
<div id="A3.p4" class="ltx_para">
<table id="A3.E42" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td rowspan="1" class="ltx_eqn_cell ltx_eqn_eqno ltx_align_middle ltx_align_left"><span class="ltx_tag ltx_tag_equation ltx_align_left">(42)</span></td>
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="A3.E42.m1" class="ltx_math_unparsed" alttext="\mathcal{L}_{\text{txt2img}}=-\frac{1}{n}\sum_{j=1}^{n}\log\frac{\exp(\cos(z(T_{j}),z(I_{j}))/\tau)}{\sum_{k=1}^{n}\exp(\cos(z(T_{j}),z(I_{k}))/\tau)}." display="block" intent=":literal"><semantics><mrow><mi class="ltx_font_mathcaligraphic">ℒ</mi><msub><mrow></mrow><mtext>txt2img</mtext></msub><mo rspace="0em">=</mo><mo lspace="0em">−</mo><mfrac><mn>1</mn><mi>n</mi></mfrac><mo movablelimits="false">∑</mo><msub><mrow></mrow><mrow><mi>j</mi><mo>=</mo><mn>1</mn></mrow></msub><msup><mrow></mrow><mi>n</mi></msup><mi>log</mi><mfrac><mrow><mi>exp</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mrow><mrow><mi>cos</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mrow><mi>z</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><msub><mi>T</mi><mi>j</mi></msub><mo stretchy="false">)</mo></mrow></mrow><mo>,</mo><mrow><mi>z</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><msub><mi>I</mi><mi>j</mi></msub><mo stretchy="false">)</mo></mrow></mrow><mo stretchy="false">)</mo></mrow></mrow><mo>/</mo><mi>τ</mi></mrow><mo stretchy="false">)</mo></mrow></mrow><mrow><msubsup><mo>∑</mo><mrow><mi>k</mi><mo>=</mo><mn>1</mn></mrow><mi>n</mi></msubsup><mrow><mi>exp</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mrow><mrow><mi>cos</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mrow><mi>z</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><msub><mi>T</mi><mi>j</mi></msub><mo stretchy="false">)</mo></mrow></mrow><mo>,</mo><mrow><mi>z</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><msub><mi>I</mi><mi>k</mi></msub><mo stretchy="false">)</mo></mrow></mrow><mo stretchy="false">)</mo></mrow></mrow><mo>/</mo><mi>τ</mi></mrow><mo stretchy="false">)</mo></mrow></mrow></mrow></mfrac><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">\mathcal{L}_{\text{txt2img}}=-\frac{1}{n}\sum_{j=1}^{n}\log\frac{\exp(\cos(z(T_{j}),z(I_{j}))/\tau)}{\sum_{k=1}^{n}\exp(\cos(z(T_{j}),z(I_{k}))/\tau)}.</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="A3.p4.1" class="ltx_p">where <math id="A3.p4.m1" class="ltx_Math" alttext="cos(·,·)" display="inline" intent=":literal"><semantics><mrow><mi>c</mi><mo lspace="0em" rspace="0em">​</mo><mi>o</mi><mo lspace="0em" rspace="0em">​</mo><mi>s</mi><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>·</mi><mo>,</mo><mi>·</mi><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">cos(·,·)</annotation></semantics></math> denotes the cosine similarity score and <math id="A3.p4.m2" class="ltx_Math" alttext="\tau" display="inline" intent=":literal"><semantics><mi>τ</mi><annotation encoding="application/x-tex">\tau</annotation></semantics></math> is the temperature parameter. The final training objective is the average of the two directions:</p>
<table id="A3.E43" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td rowspan="1" class="ltx_eqn_cell ltx_eqn_eqno ltx_align_middle ltx_align_left"><span class="ltx_tag ltx_tag_equation ltx_align_left">(43)</span></td>
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="A3.E43.m1" class="ltx_Math" alttext="\mathcal{L}_{\text{CLIP}}=\frac{1}{2}(\mathcal{L}_{\text{img2txt}}+\mathcal{L}_{\text{txt2img}})." display="block" intent=":literal"><semantics><mrow><mrow><msub><mi class="ltx_font_mathcaligraphic">ℒ</mi><mtext>CLIP</mtext></msub><mo>=</mo><mrow><mfrac><mn>1</mn><mn>2</mn></mfrac><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mrow><msub><mi class="ltx_font_mathcaligraphic">ℒ</mi><mtext>img2txt</mtext></msub><mo>+</mo><msub><mi class="ltx_font_mathcaligraphic">ℒ</mi><mtext>txt2img</mtext></msub></mrow><mo stretchy="false">)</mo></mrow></mrow></mrow><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">\mathcal{L}_{\text{CLIP}}=\frac{1}{2}(\mathcal{L}_{\text{img2txt}}+\mathcal{L}_{\text{txt2img}}).</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
</div>
<div id="A3.p5" class="ltx_para">
<p id="A3.p5.1" class="ltx_p"><span id="A3.p5.1.1" class="ltx_text ltx_font_bold">Extend BI-BAU to CLIP Model.</span> Following the core principles established in the main paper, BI-BAU can be naturally extended to the CLIP model.
As before, the framework consists of two main steps: an Inner Maximization step and an Outer Minimization step.</p>
</div>
<div id="A3.p6" class="ltx_para">
<p id="A3.p6.1" class="ltx_p"><span id="A3.p6.1.1" class="ltx_text ltx_font_bold">In the Inner Maximization step.</span> For multi-modal contrastive learning, the cross-entropy loss <math id="A3.p6.m1" class="ltx_Math" alttext="\ell_{ce}" display="inline" intent=":literal"><semantics><msub><mi mathvariant="normal">ℓ</mi><mrow><mi>c</mi><mo lspace="0em" rspace="0em">​</mo><mi>e</mi></mrow></msub><annotation encoding="application/x-tex">\ell_{ce}</annotation></semantics></math> in Eq. <a href="#S4.E22" title="In 4.3. Proposed Method ‣ 4. Methodology ‣ Rethinking Backdoor Adversarial Unlearning through the Lens of Catastrophic Forgetting in Continual Learning" class="ltx_ref"><span class="ltx_text ltx_ref_tag">22</span></a> is replaced by the CLIP
contrastive loss <math id="A3.p6.m2" class="ltx_Math" alttext="\mathcal{L}_{\text{CLIP}}(\tilde{I},T)" display="inline" intent=":literal"><semantics><mrow><msub><mi class="ltx_font_mathcaligraphic">ℒ</mi><mtext>CLIP</mtext></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mover accent="true"><mi>I</mi><mo>~</mo></mover><mo>,</mo><mi>T</mi><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">\mathcal{L}_{\text{CLIP}}(\tilde{I},T)</annotation></semantics></math>, where <math id="A3.p6.m3" class="ltx_Math" alttext="\tilde{I}" display="inline" intent=":literal"><semantics><mover accent="true"><mi>I</mi><mo>~</mo></mover><annotation encoding="application/x-tex">\tilde{I}</annotation></semantics></math> denotes adversarial images and <math id="A3.p6.m4" class="ltx_Math" alttext="T" display="inline" intent=":literal"><semantics><mi>T</mi><annotation encoding="application/x-tex">T</annotation></semantics></math> their corresponding textual captions.</p>
</div>
<div id="A3.p7" class="ltx_para">
<p id="A3.p7.1" class="ltx_p">For the knowledge distillation term <math id="A3.p7.m1" class="ltx_Math" alttext="\ell_{kd}" display="inline" intent=":literal"><semantics><msub><mi mathvariant="normal">ℓ</mi><mrow><mi>k</mi><mo lspace="0em" rspace="0em">​</mo><mi>d</mi></mrow></msub><annotation encoding="application/x-tex">\ell_{kd}</annotation></semantics></math>, inspired by Relational Knowledge Distillation (RKD) <cite class="ltx_cite ltx_citemacro_citep">(<a href="#bib.bib39" title="" class="ltx_ref">Park et al., 2019</a>; <a href="#bib.bib50" title="" class="ltx_ref">Tung and Mori, 2019</a>)</cite>, which transfers
structural knowledge by leveraging mutual relations of data instances in the teacher’s output space. we adopt a relational distillation loss:</p>
<table id="A3.E44" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td rowspan="1" class="ltx_eqn_cell ltx_eqn_eqno ltx_align_middle ltx_align_left"><span class="ltx_tag ltx_tag_equation ltx_align_left">(44)</span></td>
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="A3.E44.m1" class="ltx_math_unparsed" alttext="\mathcal{L}_{\text{rkd}}=\text{KL}\big(\cos(Z_{\tilde{I}},Z_{T})||\cos(Z_{I},Z_{T})\big)" display="block" intent=":literal"><semantics><mrow><msub><mi class="ltx_font_mathcaligraphic">ℒ</mi><mtext>rkd</mtext></msub><mo>=</mo><mtext>KL</mtext><mrow><mo maxsize="1.200em" minsize="1.200em">(</mo><mi>cos</mi><mrow><mo stretchy="false">(</mo><msub><mi>Z</mi><mover accent="true"><mi>I</mi><mo>~</mo></mover></msub><mo>,</mo><msub><mi>Z</mi><mi>T</mi></msub><mo stretchy="false">)</mo></mrow><mo fence="false" rspace="0.167em" stretchy="false">|</mo><mo fence="false" rspace="0.167em" stretchy="false">|</mo><mi>cos</mi><mrow><mo stretchy="false">(</mo><msub><mi>Z</mi><mi>I</mi></msub><mo>,</mo><msub><mi>Z</mi><mi>T</mi></msub><mo stretchy="false">)</mo></mrow><mo maxsize="1.200em" minsize="1.200em">)</mo></mrow></mrow><annotation encoding="application/x-tex">\mathcal{L}_{\text{rkd}}=\text{KL}\big(\cos(Z_{\tilde{I}},Z_{T})||\cos(Z_{I},Z_{T})\big)</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="A3.p7.2" class="ltx_p">where <math id="A3.p7.m2" class="ltx_Math" alttext="Z_{I}=\left\{z(I_{j})\right\}_{j=1}^{B}" display="inline" intent=":literal"><semantics><mrow><msub><mi>Z</mi><mi>I</mi></msub><mo>=</mo><msubsup><mrow><mo>{</mo><mrow><mi>z</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><msub><mi>I</mi><mi>j</mi></msub><mo stretchy="false">)</mo></mrow></mrow><mo>}</mo></mrow><mrow><mi>j</mi><mo>=</mo><mn>1</mn></mrow><mi>B</mi></msubsup></mrow><annotation encoding="application/x-tex">Z_{I}=\left\{z(I_{j})\right\}_{j=1}^{B}</annotation></semantics></math>, <math id="A3.p7.m3" class="ltx_Math" alttext="Z_{T}=\left\{z(T_{j})\right\}_{j=1}^{B}" display="inline" intent=":literal"><semantics><mrow><msub><mi>Z</mi><mi>T</mi></msub><mo>=</mo><msubsup><mrow><mo>{</mo><mrow><mi>z</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><msub><mi>T</mi><mi>j</mi></msub><mo stretchy="false">)</mo></mrow></mrow><mo>}</mo></mrow><mrow><mi>j</mi><mo>=</mo><mn>1</mn></mrow><mi>B</mi></msubsup></mrow><annotation encoding="application/x-tex">Z_{T}=\left\{z(T_{j})\right\}_{j=1}^{B}</annotation></semantics></math> denote natural image-text feature sets, while <math id="A3.p7.m4" class="ltx_Math" alttext="Z_{\tilde{I}}" display="inline" intent=":literal"><semantics><msub><mi>Z</mi><mover accent="true"><mi>I</mi><mo>~</mo></mover></msub><annotation encoding="application/x-tex">Z_{\tilde{I}}</annotation></semantics></math> represents
the corresponding adversarial features. The pairs <math id="A3.p7.m5" class="ltx_Math" alttext="(Z_{I},Z_{T})" display="inline" intent=":literal"><semantics><mrow><mo stretchy="false">(</mo><msub><mi>Z</mi><mi>I</mi></msub><mo>,</mo><msub><mi>Z</mi><mi>T</mi></msub><mo stretchy="false">)</mo></mrow><annotation encoding="application/x-tex">(Z_{I},Z_{T})</annotation></semantics></math> and <math id="A3.p7.m6" class="ltx_Math" alttext="(Z_{\tilde{I}},Z_{T})" display="inline" intent=":literal"><semantics><mrow><mo stretchy="false">(</mo><msub><mi>Z</mi><mover accent="true"><mi>I</mi><mo>~</mo></mover></msub><mo>,</mo><msub><mi>Z</mi><mi>T</mi></msub><mo stretchy="false">)</mo></mrow><annotation encoding="application/x-tex">(Z_{\tilde{I}},Z_{T})</annotation></semantics></math> are extracted from the original backdoored CLIP model and the updated
model, respectively. The relational potential function <math id="A3.p7.m7" class="ltx_Math" alttext="\cos(\cdot,\cdot)" display="inline" intent=":literal"><semantics><mrow><mi>cos</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mo lspace="0em" rspace="0em">⋅</mo><mo rspace="0em">,</mo><mo lspace="0em" rspace="0em">⋅</mo><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">\cos(\cdot,\cdot)</annotation></semantics></math> encodes the pairwise similarity between image-text features within a batch of size <math id="A3.p7.m8" class="ltx_Math" alttext="B" display="inline" intent=":literal"><semantics><mi>B</mi><annotation encoding="application/x-tex">B</annotation></semantics></math>.
Accordingly, Kullback-Leibler (KL) divergence <math id="A3.p7.m9" class="ltx_Math" alttext="\mathcal{L}_{\text{rkd}}" display="inline" intent=":literal"><semantics><msub><mi class="ltx_font_mathcaligraphic">ℒ</mi><mtext>rkd</mtext></msub><annotation encoding="application/x-tex">\mathcal{L}_{\text{rkd}}</annotation></semantics></math> measures the discrepancy between the relational structures induced by adversarial samples,
<math id="A3.p7.m10" class="ltx_Math" alttext="\cos(Z_{\tilde{I}},Z_{T})" display="inline" intent=":literal"><semantics><mrow><mi>cos</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><msub><mi>Z</mi><mover accent="true"><mi>I</mi><mo>~</mo></mover></msub><mo>,</mo><msub><mi>Z</mi><mi>T</mi></msub><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">\cos(Z_{\tilde{I}},Z_{T})</annotation></semantics></math>, and those of the natural samples, <math id="A3.p7.m11" class="ltx_Math" alttext="\cos(Z_{I},Z_{T})" display="inline" intent=":literal"><semantics><mrow><mi>cos</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><msub><mi>Z</mi><mi>I</mi></msub><mo>,</mo><msub><mi>Z</mi><mi>T</mi></msub><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">\cos(Z_{I},Z_{T})</annotation></semantics></math>.</p>
</div>
<div id="A3.p8" class="ltx_para">
<p id="A3.p8.1" class="ltx_p">By maximizing <math id="A3.p8.m1" class="ltx_Math" alttext="-\mathcal{L}_{\text{rkd}}" display="inline" intent=":literal"><semantics><mrow><mo>−</mo><msub><mi class="ltx_font_mathcaligraphic">ℒ</mi><mtext>rkd</mtext></msub></mrow><annotation encoding="application/x-tex">-\mathcal{L}_{\text{rkd}}</annotation></semantics></math>, we enforce the adversarial image-text representations to preserve the pairwise relational structure induced by the
original model, thereby retaining core semantic information while suppressing backdoor effects.</p>
</div>
<div id="A3.p9" class="ltx_para">
<p id="A3.p9.1" class="ltx_p">In the case of the CLIP model, the prior loss <math id="A3.p9.m1" class="ltx_Math" alttext="\ell_{prior}" display="inline" intent=":literal"><semantics><msub><mi mathvariant="normal">ℓ</mi><mrow><mi>p</mi><mo lspace="0em" rspace="0em">​</mo><mi>r</mi><mo lspace="0em" rspace="0em">​</mo><mi>i</mi><mo lspace="0em" rspace="0em">​</mo><mi>o</mi><mo lspace="0em" rspace="0em">​</mo><mi>r</mi></mrow></msub><annotation encoding="application/x-tex">\ell_{prior}</annotation></semantics></math> is defined as:</p>
<table id="A3.E45" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td rowspan="1" class="ltx_eqn_cell ltx_eqn_eqno ltx_align_middle ltx_align_left"><span class="ltx_tag ltx_tag_equation ltx_align_left">(45)</span></td>
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="A3.E45.m1" class="ltx_Math" alttext="\mathcal{L}_{prior}=\text{MSE}\big(Z_{\tilde{I}},Z_{I}\big)-\cos(\beta+k\cdot\frac{\pi}{2})" display="block" intent=":literal"><semantics><mrow><msub><mi class="ltx_font_mathcaligraphic">ℒ</mi><mrow><mi>p</mi><mo lspace="0em" rspace="0em">​</mo><mi>r</mi><mo lspace="0em" rspace="0em">​</mo><mi>i</mi><mo lspace="0em" rspace="0em">​</mo><mi>o</mi><mo lspace="0em" rspace="0em">​</mo><mi>r</mi></mrow></msub><mo>=</mo><mrow><mrow><mtext>MSE</mtext><mo lspace="0em" rspace="0em">​</mo><mrow><mo maxsize="1.200em" minsize="1.200em">(</mo><msub><mi>Z</mi><mover accent="true"><mi>I</mi><mo>~</mo></mover></msub><mo>,</mo><msub><mi>Z</mi><mi>I</mi></msub><mo maxsize="1.200em" minsize="1.200em">)</mo></mrow></mrow><mo>−</mo><mrow><mi>cos</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mrow><mi>β</mi><mo>+</mo><mrow><mi>k</mi><mo lspace="0.222em" rspace="0.222em">⋅</mo><mfrac><mi>π</mi><mn>2</mn></mfrac></mrow></mrow><mo stretchy="false">)</mo></mrow></mrow></mrow></mrow><annotation encoding="application/x-tex">\mathcal{L}_{prior}=\text{MSE}\big(Z_{\tilde{I}},Z_{I}\big)-\cos(\beta+k\cdot\frac{\pi}{2})</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="A3.p9.2" class="ltx_p">where <math id="A3.p9.m2" class="ltx_Math" alttext="Z_{\tilde{I}}" display="inline" intent=":literal"><semantics><msub><mi>Z</mi><mover accent="true"><mi>I</mi><mo>~</mo></mover></msub><annotation encoding="application/x-tex">Z_{\tilde{I}}</annotation></semantics></math> and <math id="A3.p9.m3" class="ltx_Math" alttext="Z_{I}" display="inline" intent=":literal"><semantics><msub><mi>Z</mi><mi>I</mi></msub><annotation encoding="application/x-tex">Z_{I}</annotation></semantics></math> are visual encoder outputs of adversarial and clean images, respectively, and <math id="A3.p9.m4" class="ltx_Math" alttext="\beta" display="inline" intent=":literal"><semantics><mi>β</mi><annotation encoding="application/x-tex">\beta</annotation></semantics></math> follows the definition in Section <a href="#S4.SS3" title="4.3. Proposed Method ‣ 4. Methodology ‣ Rethinking Backdoor Adversarial Unlearning through the Lens of Catastrophic Forgetting in Continual Learning" class="ltx_ref"><span class="ltx_text ltx_ref_tag">4.3</span></a>.</p>
</div>
<div id="A3.p10" class="ltx_para">
<p id="A3.p10.1" class="ltx_p">Combining Eqs. <a href="#A3.E44" title="In Appendix C Extending BI-BAU to Multi-Modal Contrastive Learning ‣ Rethinking Backdoor Adversarial Unlearning through the Lens of Catastrophic Forgetting in Continual Learning" class="ltx_ref"><span class="ltx_text ltx_ref_tag">44</span></a> and <a href="#A3.E45" title="In Appendix C Extending BI-BAU to Multi-Modal Contrastive Learning ‣ Rethinking Backdoor Adversarial Unlearning through the Lens of Catastrophic Forgetting in Continual Learning" class="ltx_ref"><span class="ltx_text ltx_ref_tag">45</span></a>, the resulting inner maximization objective is:</p>
<table id="A3.E46" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td rowspan="1" class="ltx_eqn_cell ltx_eqn_eqno ltx_align_middle ltx_align_left"><span class="ltx_tag ltx_tag_equation ltx_align_left">(46)</span></td>
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="A3.E46.m1" class="ltx_Math" alttext="\mathcal{L}_{adv-in}=-\mathcal{L}_{\text{CLIP}}-\lambda_{1}\mathcal{L}_{kd}+\lambda_{2}\mathcal{L}_{prior}" display="block" intent=":literal"><semantics><mrow><msub><mi class="ltx_font_mathcaligraphic">ℒ</mi><mrow><mrow><mi>a</mi><mo lspace="0em" rspace="0em">​</mo><mi>d</mi><mo lspace="0em" rspace="0em">​</mo><mi>v</mi></mrow><mo>−</mo><mrow><mi>i</mi><mo lspace="0em" rspace="0em">​</mo><mi>n</mi></mrow></mrow></msub><mo>=</mo><mrow><mrow><mrow><mo>−</mo><msub><mi class="ltx_font_mathcaligraphic">ℒ</mi><mtext>CLIP</mtext></msub></mrow><mo>−</mo><mrow><msub><mi>λ</mi><mn>1</mn></msub><mo lspace="0em" rspace="0em">​</mo><msub><mi class="ltx_font_mathcaligraphic">ℒ</mi><mrow><mi>k</mi><mo lspace="0em" rspace="0em">​</mo><mi>d</mi></mrow></msub></mrow></mrow><mo>+</mo><mrow><msub><mi>λ</mi><mn>2</mn></msub><mo lspace="0em" rspace="0em">​</mo><msub><mi class="ltx_font_mathcaligraphic">ℒ</mi><mrow><mi>p</mi><mo lspace="0em" rspace="0em">​</mo><mi>r</mi><mo lspace="0em" rspace="0em">​</mo><mi>i</mi><mo lspace="0em" rspace="0em">​</mo><mi>o</mi><mo lspace="0em" rspace="0em">​</mo><mi>r</mi></mrow></msub></mrow></mrow></mrow><annotation encoding="application/x-tex">\mathcal{L}_{adv-in}=-\mathcal{L}_{\text{CLIP}}-\lambda_{1}\mathcal{L}_{kd}+\lambda_{2}\mathcal{L}_{prior}</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
</div>
<div id="A3.p11" class="ltx_para">
<p id="A3.p11.1" class="ltx_p"><span id="A3.p11.1.1" class="ltx_text ltx_font_bold">In the Outer Minimization step.</span> the cross-entropy loss term in Eq. <a href="#S4.E25" title="In 4.3. Proposed Method ‣ 4. Methodology ‣ Rethinking Backdoor Adversarial Unlearning through the Lens of Catastrophic Forgetting in Continual Learning" class="ltx_ref"><span class="ltx_text ltx_ref_tag">25</span></a> is similarly replaced with the CLIP contrastive loss <math id="A3.p11.m1" class="ltx_Math" alttext="\mathcal{L}{\text{CLIP}}(\tilde{I},T)" display="inline" intent=":literal"><semantics><mrow><mi class="ltx_font_mathcaligraphic">ℒ</mi><mo lspace="0em" rspace="0em">​</mo><mtext>CLIP</mtext><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mover accent="true"><mi>I</mi><mo>~</mo></mover><mo>,</mo><mi>T</mi><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">\mathcal{L}{\text{CLIP}}(\tilde{I},T)</annotation></semantics></math>.
The Elastic Weight Consolidation (EWC) loss and the inverse EWC loss retain the same formulations, given by</p>
<table id="A3.E47" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td rowspan="0" class="ltx_eqn_cell ltx_eqn_eqno ltx_align_middle ltx_align_left"><span class="ltx_tag ltx_tag_equation ltx_align_left">(47)</span></td>
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center">
<div id="A3.E47.2" class="ltx_inline-block ltx_markedasmath ltx_transformed_outer" style="width:206.6pt;height:21.5pt;vertical-align:-8.5pt;"><span class="ltx_transformed_inner" style="transform:translate(-11.5pt,1.2pt) scale(0.9,0.9) ;">
<p id="A3.E47.2.1" class="ltx_p"><math id="A3.E47.m1.m1" class="ltx_Math" alttext="\begin{aligned} \mathcal{L}_{ewc}&amp;=(\theta_{\tau_{b}}^{*}(\mathcal{I})-\theta(\mathcal{I}))^{T}F_{\tau_{c}}(\theta_{\tau_{b}}^{*}(\mathcal{I})-\theta(\mathcal{I})),\\
\mathcal{L}_{inv-ewc}&amp;=1.0/\left[1.0+(\theta_{\tau_{b}}^{*}(\mathcal{I})-\theta(\mathcal{I}))^{T}F_{\tau_{u}}(\theta_{\tau_{b}}^{*}(\mathcal{I})-\theta(\mathcal{I}))\right].\end{aligned}" display="inline" intent=":literal"><semantics><mtable columnspacing="0pt" rowspacing="0pt"><mtr><mtd class="ltx_align_right" columnalign="right"><msub><mi class="ltx_font_mathcaligraphic">ℒ</mi><mrow><mi>e</mi><mo lspace="0em" rspace="0em">​</mo><mi>w</mi><mo lspace="0em" rspace="0em">​</mo><mi>c</mi></mrow></msub></mtd><mtd class="ltx_align_left" columnalign="left"><mrow><mrow><mphantom></mphantom><mo>=</mo><mrow><msup><mrow><mo stretchy="false">(</mo><mrow><mrow><msubsup><mi>θ</mi><msub><mi>τ</mi><mi>b</mi></msub><mo>∗</mo></msubsup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi class="ltx_font_mathcaligraphic">ℐ</mi><mo stretchy="false">)</mo></mrow></mrow><mo>−</mo><mrow><mi>θ</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi class="ltx_font_mathcaligraphic">ℐ</mi><mo stretchy="false">)</mo></mrow></mrow></mrow><mo stretchy="false">)</mo></mrow><mi>T</mi></msup><mo lspace="0em" rspace="0em">​</mo><msub><mi>F</mi><msub><mi>τ</mi><mi>c</mi></msub></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mrow><mrow><msubsup><mi>θ</mi><msub><mi>τ</mi><mi>b</mi></msub><mo>∗</mo></msubsup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi class="ltx_font_mathcaligraphic">ℐ</mi><mo stretchy="false">)</mo></mrow></mrow><mo>−</mo><mrow><mi>θ</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi class="ltx_font_mathcaligraphic">ℐ</mi><mo stretchy="false">)</mo></mrow></mrow></mrow><mo stretchy="false">)</mo></mrow></mrow></mrow><mo>,</mo></mrow></mtd></mtr><mtr><mtd class="ltx_align_right" columnalign="right"><msub><mi class="ltx_font_mathcaligraphic">ℒ</mi><mrow><mrow><mi>i</mi><mo lspace="0em" rspace="0em">​</mo><mi>n</mi><mo lspace="0em" rspace="0em">​</mo><mi>v</mi></mrow><mo>−</mo><mrow><mi>e</mi><mo lspace="0em" rspace="0em">​</mo><mi>w</mi><mo lspace="0em" rspace="0em">​</mo><mi>c</mi></mrow></mrow></msub></mtd><mtd class="ltx_align_left" columnalign="left"><mrow><mrow><mphantom></mphantom><mo>=</mo><mrow><mn>1.0</mn><mo>/</mo><mrow><mo>[</mo><mrow><mn>1.0</mn><mo>+</mo><mrow><msup><mrow><mo stretchy="false">(</mo><mrow><mrow><msubsup><mi>θ</mi><msub><mi>τ</mi><mi>b</mi></msub><mo>∗</mo></msubsup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi class="ltx_font_mathcaligraphic">ℐ</mi><mo stretchy="false">)</mo></mrow></mrow><mo>−</mo><mrow><mi>θ</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi class="ltx_font_mathcaligraphic">ℐ</mi><mo stretchy="false">)</mo></mrow></mrow></mrow><mo stretchy="false">)</mo></mrow><mi>T</mi></msup><mo lspace="0em" rspace="0em">​</mo><msub><mi>F</mi><msub><mi>τ</mi><mi>u</mi></msub></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mrow><mrow><msubsup><mi>θ</mi><msub><mi>τ</mi><mi>b</mi></msub><mo>∗</mo></msubsup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi class="ltx_font_mathcaligraphic">ℐ</mi><mo stretchy="false">)</mo></mrow></mrow><mo>−</mo><mrow><mi>θ</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi class="ltx_font_mathcaligraphic">ℐ</mi><mo stretchy="false">)</mo></mrow></mrow></mrow><mo stretchy="false">)</mo></mrow></mrow></mrow><mo>]</mo></mrow></mrow></mrow><mo lspace="0em">.</mo></mrow></mtd></mtr></mtable><annotation encoding="application/x-tex">\begin{aligned} \mathcal{L}_{ewc}&amp;=(\theta_{\tau_{b}}^{*}(\mathcal{I})-\theta(\mathcal{I}))^{T}F_{\tau_{c}}(\theta_{\tau_{b}}^{*}(\mathcal{I})-\theta(\mathcal{I})),\\
\mathcal{L}_{inv-ewc}&amp;=1.0/\left[1.0+(\theta_{\tau_{b}}^{*}(\mathcal{I})-\theta(\mathcal{I}))^{T}F_{\tau_{u}}(\theta_{\tau_{b}}^{*}(\mathcal{I})-\theta(\mathcal{I}))\right].\end{aligned}</annotation></semantics></math></p>
</span></div></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="A3.p11.2" class="ltx_p">Here, <math id="A3.p11.m2" class="ltx_Math" alttext="\theta(\mathcal{I})" display="inline" intent=":literal"><semantics><mrow><mi>θ</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi class="ltx_font_mathcaligraphic">ℐ</mi><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">\theta(\mathcal{I})</annotation></semantics></math> denotes the parameters of the visual encoder. Notably, in the CLIP-based unlearning setting, we update only the visual encoder
<math id="A3.p11.m3" class="ltx_Math" alttext="\mathcal{I}(\cdot;\theta_{\mathcal{I}})" display="inline" intent=":literal"><semantics><mrow><mi class="ltx_font_mathcaligraphic">ℐ</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mo lspace="0em" rspace="0em">⋅</mo><mo>,</mo><msub><mi>θ</mi><mi class="ltx_font_mathcaligraphic">ℐ</mi></msub><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">\mathcal{I}(\cdot;\theta_{\mathcal{I}})</annotation></semantics></math> during optimization, while keeping the text encoder <math id="A3.p11.m4" class="ltx_Math" alttext="\mathcal{T}(\cdot;\theta_{\mathcal{T}})" display="inline" intent=":literal"><semantics><mrow><mi class="ltx_font_mathcaligraphic">𝒯</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mo lspace="0em" rspace="0em">⋅</mo><mo>,</mo><msub><mi>θ</mi><mi class="ltx_font_mathcaligraphic">𝒯</mi></msub><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">\mathcal{T}(\cdot;\theta_{\mathcal{T}})</annotation></semantics></math> fixed.</p>
</div>
<div id="A3.p12" class="ltx_para">
<p id="A3.p12.1" class="ltx_p">Accordingly, the overall outer optimization objective becomes:</p>
<table id="A3.E48" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td rowspan="1" class="ltx_eqn_cell ltx_eqn_eqno ltx_align_middle ltx_align_left"><span class="ltx_tag ltx_tag_equation ltx_align_left">(48)</span></td>
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="A3.E48.m1" class="ltx_Math" alttext="\mathcal{L}_{adv-out}=\mathcal{L}_{\text{CLIP}}(f_{\theta}(\tilde{x};\theta),y)+\gamma_{1}\mathcal{L}_{inv-ewc}+\gamma_{2}\mathcal{L}_{ewc}." display="block" intent=":literal"><semantics><mrow><mrow><msub><mi class="ltx_font_mathcaligraphic">ℒ</mi><mrow><mrow><mi>a</mi><mo lspace="0em" rspace="0em">​</mo><mi>d</mi><mo lspace="0em" rspace="0em">​</mo><mi>v</mi></mrow><mo>−</mo><mrow><mi>o</mi><mo lspace="0em" rspace="0em">​</mo><mi>u</mi><mo lspace="0em" rspace="0em">​</mo><mi>t</mi></mrow></mrow></msub><mo>=</mo><mrow><mrow><msub><mi class="ltx_font_mathcaligraphic">ℒ</mi><mtext>CLIP</mtext></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mrow><msub><mi>f</mi><mi>θ</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mover accent="true"><mi>x</mi><mo>~</mo></mover><mo>,</mo><mi>θ</mi><mo stretchy="false">)</mo></mrow></mrow><mo>,</mo><mi>y</mi><mo stretchy="false">)</mo></mrow></mrow><mo>+</mo><mrow><msub><mi>γ</mi><mn>1</mn></msub><mo lspace="0em" rspace="0em">​</mo><msub><mi class="ltx_font_mathcaligraphic">ℒ</mi><mrow><mrow><mi>i</mi><mo lspace="0em" rspace="0em">​</mo><mi>n</mi><mo lspace="0em" rspace="0em">​</mo><mi>v</mi></mrow><mo>−</mo><mrow><mi>e</mi><mo lspace="0em" rspace="0em">​</mo><mi>w</mi><mo lspace="0em" rspace="0em">​</mo><mi>c</mi></mrow></mrow></msub></mrow><mo>+</mo><mrow><msub><mi>γ</mi><mn>2</mn></msub><mo lspace="0em" rspace="0em">​</mo><msub><mi class="ltx_font_mathcaligraphic">ℒ</mi><mrow><mi>e</mi><mo lspace="0em" rspace="0em">​</mo><mi>w</mi><mo lspace="0em" rspace="0em">​</mo><mi>c</mi></mrow></msub></mrow></mrow></mrow><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">\mathcal{L}_{adv-out}=\mathcal{L}_{\text{CLIP}}(f_{\theta}(\tilde{x};\theta),y)+\gamma_{1}\mathcal{L}_{inv-ewc}+\gamma_{2}\mathcal{L}_{ewc}.</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
</div>
<div id="A3.p13" class="ltx_para">
<p id="A3.p13.1" class="ltx_p">This extension preserves the core BI-BAU principles while adapting the framework to multi-modal contrastive learning, enabling effective backdoor unlearning for
CLIP-based models.</p>
</div>
</section>
<section id="A4" class="ltx_appendix">
<h2 class="ltx_title ltx_title_appendix"><span class="ltx_tag ltx_tag_appendix">Appendix D </span>Additional Implementation Details</h2>

<section id="A4.SS1" class="ltx_subsection">
<h3 class="ltx_title ltx_title_subsection"><span class="ltx_tag ltx_tag_subsection">D.1. </span>Datasets and Network Architectures</h3>

<div id="A4.SS1.p1" class="ltx_para">
<p id="A4.SS1.p1.1" class="ltx_p">To comprehensively evaluate the effectiveness of our proposed BI-BAU method, we conduct experiments on both standard image classification and multi-modal
contrastive learning tasks.</p>
</div>
<div id="A4.SS1.p2" class="ltx_para">
<p id="A4.SS1.p2.1" class="ltx_p"><span id="A4.SS1.p2.1.1" class="ltx_text ltx_font_bold">Supervised Learning.</span> For image classification, we use three benchmark datasets: CIFAR-10 <cite class="ltx_cite ltx_citemacro_citep">(<a href="#bib.bib21" title="" class="ltx_ref">Krizhevsky et al., 2009</a>)</cite>, Tiny-ImageNet-200 <cite class="ltx_cite ltx_citemacro_citep">(<a href="#bib.bib59" title="" class="ltx_ref">Wu et al., 2017</a>)</cite>,
and GTSRB <cite class="ltx_cite ltx_citemacro_citep">(<a href="#bib.bib48" title="" class="ltx_ref">Stallkamp et al., 2011</a>)</cite>, and three neural network architectures: ResNet-18 <cite class="ltx_cite ltx_citemacro_citep">(<a href="#bib.bib15" title="" class="ltx_ref">He et al., 2016</a>)</cite>, VGG19 <cite class="ltx_cite ltx_citemacro_citep">(<a href="#bib.bib47" title="" class="ltx_ref">Simonyan and Zisserman, 2014</a>)</cite>, and Vision Transformer (ViT) <cite class="ltx_cite ltx_citemacro_citep">(<a href="#bib.bib10" title="" class="ltx_ref">Dosovitskiy et al., 2020</a>)</cite>.
Dataset statistics and model assignments are summarized in Table <a href="#A4.T8" title="Table 8 ‣ D.1. Datasets and Network Architectures ‣ Appendix D Additional Implementation Details ‣ Rethinking Backdoor Adversarial Unlearning through the Lens of Catastrophic Forgetting in Continual Learning" class="ltx_ref"><span class="ltx_text ltx_ref_tag">8</span></a>.</p>
</div>
<figure id="A4.T8" class="ltx_table">
<figcaption class="ltx_caption ltx_centering"><span class="ltx_tag ltx_tag_table"><span id="A4.T8.3" class="ltx_text" style="font-size:90%;">Table 8</span>. </span><span id="A4.T8.4" class="ltx_text" style="font-size:90%;">Summary of datasets and model architectures used in supervised learning tasks.</span></figcaption>
<div id="A4.T8.5" class="ltx_inline-block ltx_align_center ltx_transformed_outer" style="width:345.0pt;height:46.5pt;vertical-align:-20.9pt;"><span class="ltx_transformed_inner" style="transform:translate(-10.2pt,1.4pt) scale(0.943982833396419,0.943982833396419) ;">
<table id="A4.T8.5.1" class="ltx_tabular ltx_align_middle">
<tr id="A4.T8.5.1.1" class="ltx_tr">
<td id="A4.T8.5.1.1.1" class="ltx_td ltx_align_center ltx_border_tt" style="padding-top:1pt;padding-bottom:1pt;">Dataset</td>
<td id="A4.T8.5.1.1.2" class="ltx_td ltx_align_center ltx_border_tt" style="padding-top:1pt;padding-bottom:1pt;">Labels</td>
<td id="A4.T8.5.1.1.3" class="ltx_td ltx_align_center ltx_border_tt" style="padding-top:1pt;padding-bottom:1pt;">Input Size</td>
<td id="A4.T8.5.1.1.4" class="ltx_td ltx_align_center ltx_border_tt" style="padding-top:1pt;padding-bottom:1pt;">Training Images</td>
<td id="A4.T8.5.1.1.5" class="ltx_td ltx_align_center ltx_border_tt" style="padding-top:1pt;padding-bottom:1pt;">DNN</td></tr>
<tr id="A4.T8.5.1.2" class="ltx_tr">
<td id="A4.T8.5.1.2.1" class="ltx_td ltx_align_center ltx_border_t" style="padding-top:1pt;padding-bottom:1pt;">CIFAR-10</td>
<td id="A4.T8.5.1.2.2" class="ltx_td ltx_align_center ltx_border_t" style="padding-top:1pt;padding-bottom:1pt;">10</td>
<td id="A4.T8.5.1.2.3" class="ltx_td ltx_align_center ltx_border_t" style="padding-top:1pt;padding-bottom:1pt;">32<math id="A4.T8.m1" class="ltx_Math" alttext="\times" display="inline" intent=":literal"><semantics><mo>×</mo><annotation encoding="application/x-tex">\times</annotation></semantics></math>32<math id="A4.T8.m2" class="ltx_Math" alttext="\times" display="inline" intent=":literal"><semantics><mo>×</mo><annotation encoding="application/x-tex">\times</annotation></semantics></math>3</td>
<td id="A4.T8.5.1.2.4" class="ltx_td ltx_align_center ltx_border_t" style="padding-top:1pt;padding-bottom:1pt;">50,000</td>
<td id="A4.T8.5.1.2.5" class="ltx_td ltx_align_center ltx_border_t" style="padding-top:1pt;padding-bottom:1pt;">ResNet-18 / ViT</td></tr>
<tr id="A4.T8.5.1.3" class="ltx_tr">
<td id="A4.T8.5.1.3.1" class="ltx_td ltx_align_center" style="padding-top:1pt;padding-bottom:1pt;">Tiny-ImageNet-200</td>
<td id="A4.T8.5.1.3.2" class="ltx_td ltx_align_center" style="padding-top:1pt;padding-bottom:1pt;">200</td>
<td id="A4.T8.5.1.3.3" class="ltx_td ltx_align_center" style="padding-top:1pt;padding-bottom:1pt;">32<math id="A4.T8.m3" class="ltx_Math" alttext="\times" display="inline" intent=":literal"><semantics><mo>×</mo><annotation encoding="application/x-tex">\times</annotation></semantics></math>32<math id="A4.T8.m4" class="ltx_Math" alttext="\times" display="inline" intent=":literal"><semantics><mo>×</mo><annotation encoding="application/x-tex">\times</annotation></semantics></math>3</td>
<td id="A4.T8.5.1.3.4" class="ltx_td ltx_align_center" style="padding-top:1pt;padding-bottom:1pt;">100,000</td>
<td id="A4.T8.5.1.3.5" class="ltx_td ltx_align_center" style="padding-top:1pt;padding-bottom:1pt;">ResNet-18</td></tr>
<tr id="A4.T8.5.1.4" class="ltx_tr">
<td id="A4.T8.5.1.4.1" class="ltx_td ltx_align_center ltx_border_bb" style="padding-top:1pt;padding-bottom:1pt;">GTSRB</td>
<td id="A4.T8.5.1.4.2" class="ltx_td ltx_align_center ltx_border_bb" style="padding-top:1pt;padding-bottom:1pt;">43</td>
<td id="A4.T8.5.1.4.3" class="ltx_td ltx_align_center ltx_border_bb" style="padding-top:1pt;padding-bottom:1pt;">32<math id="A4.T8.m5" class="ltx_Math" alttext="\times" display="inline" intent=":literal"><semantics><mo>×</mo><annotation encoding="application/x-tex">\times</annotation></semantics></math>32<math id="A4.T8.m6" class="ltx_Math" alttext="\times" display="inline" intent=":literal"><semantics><mo>×</mo><annotation encoding="application/x-tex">\times</annotation></semantics></math>3</td>
<td id="A4.T8.5.1.4.4" class="ltx_td ltx_align_center ltx_border_bb" style="padding-top:1pt;padding-bottom:1pt;">39,252</td>
<td id="A4.T8.5.1.4.5" class="ltx_td ltx_align_center ltx_border_bb" style="padding-top:1pt;padding-bottom:1pt;">VGG19</td></tr>
</table>
</span></div>
</figure>
<div id="A4.SS1.p3" class="ltx_para">
<p id="A4.SS1.p3.1" class="ltx_p">For all classification tasks, we perform backdoor attacks on either the ResNet-18 or VGG19 models over 200 training epochs, with a batch size of 128.
We employ the stochastic gradient descent (SGD) optimizer with an initial learning rate of 0.1, a momentum of 0.9, and a weight decay of <math id="A4.SS1.p3.m1" class="ltx_Math" alttext="5\times 10^{-4}" display="inline" intent=":literal"><semantics><mrow><mn>5</mn><mo lspace="0.222em" rspace="0.222em">×</mo><msup><mn>10</mn><mrow><mo>−</mo><mn>4</mn></mrow></msup></mrow><annotation encoding="application/x-tex">5\times 10^{-4}</annotation></semantics></math>.
The learning rate is reduced by a factor of 10 at the 100th and 150th epochs, respectively.</p>
</div>
<div id="A4.SS1.p4" class="ltx_para">
<p id="A4.SS1.p4.1" class="ltx_p"><span id="A4.SS1.p4.1.1" class="ltx_text ltx_font_bold">Multi-Modal Contrastive Learning.</span> For multi-modal evaluation, we adopt OpenAI’s open-source CLIP <cite class="ltx_cite ltx_citemacro_citep">(<a href="#bib.bib42" title="" class="ltx_ref">Radford et al., 2021</a>)</cite> as the pre-trained backbone,
trained on 400 million image-text pairs. Specifically, the “ViT-B/32” variant is used as the visual encoder, and a Transformer serves as the text encoder.
A backdoor is first implanted into the pre-trained CLIP model on ImageNet-1K. Then, a fine-tuning dataset is constructed by sampling 50,000 image-text pairs from
Conceptual Captions (CC3M) <cite class="ltx_cite ltx_citemacro_citep">(<a href="#bib.bib46" title="" class="ltx_ref">Sharma et al., 2018</a>)</cite>, corresponding to only <math id="A4.SS1.p4.m1" class="ltx_Math" alttext="\sim" display="inline" intent=":literal"><semantics><mo>∼</mo><annotation encoding="application/x-tex">\sim</annotation></semantics></math>0.6% of the full dataset. This setup allows us to evaluate the effectiveness
of BI-BAU under limited-data backdoor mitigation scenarios.</p>
</div>
</section>
<section id="A4.SS2" class="ltx_subsection">
<h3 class="ltx_title ltx_title_subsection"><span class="ltx_tag ltx_tag_subsection">D.2. </span>Attack Settings</h3>

<div id="A4.SS2.p1" class="ltx_para">
<p id="A4.SS2.p1.1" class="ltx_p"><span id="A4.SS2.p1.1.1" class="ltx_text ltx_font_bold">Backdoor Attacks.</span> We conduct a comprehensive study by adopting 10 representative backdoor attacks to evaluate the effectiveness of our method, which can
be grouped into the following five categories: (1) Patch-based attacks: BadNets <cite class="ltx_cite ltx_citemacro_citep">(<a href="#bib.bib14" title="" class="ltx_ref">Gu et al., 2019</a>)</cite> and Blended <cite class="ltx_cite ltx_citemacro_citep">(<a href="#bib.bib5" title="" class="ltx_ref">Chen et al., 2017</a>)</cite>;
(2) Invisible backdoor attacks: WaNet <cite class="ltx_cite ltx_citemacro_citep">(<a href="#bib.bib35" title="" class="ltx_ref">Nguyen and Tran, 2021</a>)</cite> and Refool <cite class="ltx_cite ltx_citemacro_citep">(<a href="#bib.bib31" title="" class="ltx_ref">Liu et al., 2020</a>)</cite>; (3) Sample-specific backdoor attacks: IAD <cite class="ltx_cite ltx_citemacro_citep">(<a href="#bib.bib37" title="" class="ltx_ref">Nguyen and Tran, 2020</a>)</cite> and ISSBA <cite class="ltx_cite ltx_citemacro_citep">(<a href="#bib.bib24" title="" class="ltx_ref">Li et al., 2021a</a>)</cite>;
(4) Clean-label attacks: SIG <cite class="ltx_cite ltx_citemacro_citep">(<a href="#bib.bib3" title="" class="ltx_ref">Barni et al., 2019</a>)</cite> and Narcissus <cite class="ltx_cite ltx_citemacro_citep">(<a href="#bib.bib64" title="" class="ltx_ref">Zeng et al., 2023</a>)</cite>, as well as (5) two adaptive attacks <cite class="ltx_cite ltx_citemacro_citep">(<a href="#bib.bib40" title="" class="ltx_ref">Qi et al., 2023</a>)</cite>: Adaptive-Blend and Adaptive-Patch,
which are specifically designed to evade latent separation-based defenses. For a fair and reliable comparison, we use the implementation provided by BackdoorBench <cite class="ltx_cite ltx_citemacro_citep">(<a href="#bib.bib57" title="" class="ltx_ref">Wu et al., 2022</a>)</cite>
and follow default configuration specified in the original papers. By default, the poisoning ratio <math id="A4.SS2.p1.m1" class="ltx_Math" alttext="\rho" display="inline" intent=":literal"><semantics><mi>ρ</mi><annotation encoding="application/x-tex">\rho</annotation></semantics></math> is set to 10% and the target label <math id="A4.SS2.p1.m2" class="ltx_Math" alttext="y_{t}" display="inline" intent=":literal"><semantics><msub><mi>y</mi><mi>t</mi></msub><annotation encoding="application/x-tex">y_{t}</annotation></semantics></math> set to 0 for all attacks,
expect for SIG and Narcissus. For the SIG attack, the poisoning ratio is set to <math id="A4.SS2.p1.m3" class="ltx_Math" alttext="2.5\%" display="inline" intent=":literal"><semantics><mrow><mn>2.5</mn><mo>%</mo></mrow><annotation encoding="application/x-tex">2.5\%</annotation></semantics></math> (<em id="A4.SS2.p1.1.2" class="ltx_emph ltx_font_italic">i.e.,</em> <math id="A4.SS2.p1.m4" class="ltx_Math" alttext="25\%" display="inline" intent=":literal"><semantics><mrow><mn>25</mn><mo>%</mo></mrow><annotation encoding="application/x-tex">25\%</annotation></semantics></math> of training samples with the target label), and the target label
<math id="A4.SS2.p1.m5" class="ltx_Math" alttext="y_{t}=3" display="inline" intent=":literal"><semantics><mrow><msub><mi>y</mi><mi>t</mi></msub><mo>=</mo><mn>3</mn></mrow><annotation encoding="application/x-tex">y_{t}=3</annotation></semantics></math>. For the Narcissus, the poisoning ratio is set to <math id="A4.SS2.p1.m6" class="ltx_Math" alttext="0.05\%" display="inline" intent=":literal"><semantics><mrow><mn>0.05</mn><mo>%</mo></mrow><annotation encoding="application/x-tex">0.05\%</annotation></semantics></math> of the entire dataset, with the target label <math id="A4.SS2.p1.m7" class="ltx_Math" alttext="y_{t}" display="inline" intent=":literal"><semantics><msub><mi>y</mi><mi>t</mi></msub><annotation encoding="application/x-tex">y_{t}</annotation></semantics></math> set to 0.</p>
</div>
<div id="A4.SS2.p2" class="ltx_para">
<p id="A4.SS2.p2.1" class="ltx_p">Furthermore, to verify that our proposed BI-BAU method can effectively and thoroughly eliminate backdoor effects from compromised models, we implement two backdoor
re-activation attacks introduced by <cite class="ltx_cite ltx_citemacro_citet"><a href="#bib.bib34" title="" class="ltx_ref">Min et al. (2024)</a></cite>, namely the Retuning Attack (RA) and the Query-based Reactivation Attack (QRA).
Following its original implementation <cite class="ltx_cite ltx_citemacro_citep">(<a href="#bib.bib34" title="" class="ltx_ref">Min et al., 2024</a>)</cite>, we provide the configuration details as follows.</p>
</div>
<div id="A4.SS2.p3" class="ltx_para">
<p id="A4.SS2.p3.1" class="ltx_p"><span id="A4.SS2.p3.1.1" class="ltx_text ltx_font_bold">RA Configuration.</span> For all three datasets, we use 5 samples for the BadNet, WaNet, IAD, and ISSBA attacks, and 1 sample for the Blended attack.
For the Refool, SIG, Narcissus, Adaptive-Blend, and Adaptive-Patch attacks, we adopt 2 samples for CIFAR-10 and Tiny-ImageNet-200, while using 5 samples for GTSRB.
To mitigate the risk that directly fine-tuning the purified model with poisoned samples may degrade clean accuracy, we incorporate an additional 0.02% of
the overall training dataset as benign samples during the fine-tuning process.</p>
</div>
<div id="A4.SS2.p4" class="ltx_para">
<p id="A4.SS2.p4.1" class="ltx_p"><span id="A4.SS2.p4.1.1" class="ltx_text ltx_font_bold">QRA Configuration.</span> We employ a three-layer Multilayer Perceptron (MLP) to generate reversed perturbations in the input space. Each hidden layer contains
1024 neurons and is followed by a Rectified Linear Unit (ReLU) activation function. To train the generator, we use 500 benign examples and 500 backdoored examples
from the CIFAR-10 dataset. The training is conducted for 50 epochs using a fixed learning rate of 0.1 and a batch size of 128. The balancing coefficient <math id="A4.SS2.p4.m1" class="ltx_Math" alttext="\alpha" display="inline" intent=":literal"><semantics><mi>α</mi><annotation encoding="application/x-tex">\alpha</annotation></semantics></math>
is set to 0.2 across all attack types to ensure high Q-ASR on purified models while simultaneously reducing the attack performance on clean models.
Additionally, the perturbation budget is fixed at 16/255 for all experiments.</p>
</div>
</section>
<section id="A4.SS3" class="ltx_subsection">
<h3 class="ltx_title ltx_title_subsection"><span class="ltx_tag ltx_tag_subsection">D.3. </span>Defense Settings</h3>

<div id="A4.SS3.p1" class="ltx_para">
<p id="A4.SS3.p1.1" class="ltx_p">In addition, as a comparative reference, we construct an idealized backdoor unlearning scenario (termed IBU), in which we assume that the defender fine-tunes
the model using real backdoor poisoned samples with original labels, alongside a small subset of clean data <math id="A4.SS3.p1.m1" class="ltx_Math" alttext="\mathcal{D}_{cl}" display="inline" intent=":literal"><semantics><msub><mi class="ltx_font_mathcaligraphic">𝒟</mi><mrow><mi>c</mi><mo lspace="0em" rspace="0em">​</mo><mi>l</mi></mrow></msub><annotation encoding="application/x-tex">\mathcal{D}_{cl}</annotation></semantics></math>, to maintain the model’s performance
on clean tasks, as follows:</p>
<table id="A4.E49" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td rowspan="1" class="ltx_eqn_cell ltx_eqn_eqno ltx_align_middle ltx_align_left"><span class="ltx_tag ltx_tag_equation ltx_align_left">(49)</span></td>
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="A4.E49.m1" class="ltx_Math" alttext="\min_{\theta}\mathcal{R}_{cl}+\lambda\mathcal{R}_{bu}" display="block" intent=":literal"><semantics><mrow><mrow><munder><mi>min</mi><mi>θ</mi></munder><mo lspace="0.167em">⁡</mo><msub><mi class="ltx_font_mathcaligraphic">ℛ</mi><mrow><mi>c</mi><mo lspace="0em" rspace="0em">​</mo><mi>l</mi></mrow></msub></mrow><mo>+</mo><mrow><mi>λ</mi><mo lspace="0em" rspace="0em">​</mo><msub><mi class="ltx_font_mathcaligraphic">ℛ</mi><mrow><mi>b</mi><mo lspace="0em" rspace="0em">​</mo><mi>u</mi></mrow></msub></mrow></mrow><annotation encoding="application/x-tex">\min_{\theta}\mathcal{R}_{cl}+\lambda\mathcal{R}_{bu}</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="A4.SS3.p1.2" class="ltx_p">where</p>
<table id="A4.E50" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td rowspan="1" class="ltx_eqn_cell ltx_eqn_eqno ltx_align_middle ltx_align_left"><span class="ltx_tag ltx_tag_equation ltx_align_left">(50)</span></td>
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="A4.E50.m1" class="ltx_math_unparsed" alttext="\left\{\begin{matrix}\mathcal{R}_{cl}=\mathbb{E}_{(x,y)\sim\mathcal{D}_{cl}}(\ell(f(x;\theta),y)),\\
\mathcal{R}_{bu}=\mathbb{E}_{(x,y)\sim\mathcal{D}_{-y_{t}}}(\ell(f((1-m)\odot x+m\odot\Delta;\theta),y)).\end{matrix}\right." display="block" intent=":literal"><semantics><mrow><mo>{</mo><mtable displaystyle="true" rowspacing="0pt"><mtr><mtd><mrow><mrow><msub><mi class="ltx_font_mathcaligraphic">ℛ</mi><mrow><mi>c</mi><mo lspace="0em" rspace="0em">​</mo><mi>l</mi></mrow></msub><mo>=</mo><mrow><msub><mi>𝔼</mi><mrow><mrow><mo stretchy="false">(</mo><mi>x</mi><mo>,</mo><mi>y</mi><mo stretchy="false">)</mo></mrow><mo>∼</mo><msub><mi class="ltx_font_mathcaligraphic">𝒟</mi><mrow><mi>c</mi><mo lspace="0em" rspace="0em">​</mo><mi>l</mi></mrow></msub></mrow></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mrow><mi mathvariant="normal">ℓ</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mrow><mi>f</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>x</mi><mo>,</mo><mi>θ</mi><mo stretchy="false">)</mo></mrow></mrow><mo>,</mo><mi>y</mi><mo stretchy="false">)</mo></mrow></mrow><mo stretchy="false">)</mo></mrow></mrow></mrow><mo>,</mo></mrow></mtd></mtr><mtr><mtd><mrow><mrow><msub><mi class="ltx_font_mathcaligraphic">ℛ</mi><mrow><mi>b</mi><mo lspace="0em" rspace="0em">​</mo><mi>u</mi></mrow></msub><mo>=</mo><mrow><msub><mi>𝔼</mi><mrow><mrow><mo stretchy="false">(</mo><mi>x</mi><mo>,</mo><mi>y</mi><mo stretchy="false">)</mo></mrow><mo>∼</mo><msub><mi class="ltx_font_mathcaligraphic">𝒟</mi><mrow><mo>−</mo><msub><mi>y</mi><mi>t</mi></msub></mrow></msub></mrow></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mrow><mi mathvariant="normal">ℓ</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mrow><mi>f</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mrow><mrow><mrow><mo stretchy="false">(</mo><mrow><mn>1</mn><mo>−</mo><mi>m</mi></mrow><mo rspace="0.055em" stretchy="false">)</mo></mrow><mo rspace="0.222em">⊙</mo><mi>x</mi></mrow><mo>+</mo><mrow><mi>m</mi><mo lspace="0.222em" rspace="0.222em">⊙</mo><mi mathvariant="normal">Δ</mi></mrow></mrow><mo>,</mo><mi>θ</mi><mo stretchy="false">)</mo></mrow></mrow><mo>,</mo><mi>y</mi><mo stretchy="false">)</mo></mrow></mrow><mo stretchy="false">)</mo></mrow></mrow></mrow><mo lspace="0em">.</mo></mrow></mtd></mtr></mtable></mrow><annotation encoding="application/x-tex">\left\{\begin{matrix}\mathcal{R}_{cl}=\mathbb{E}_{(x,y)\sim\mathcal{D}_{cl}}(\ell(f(x;\theta),y)),\\
\mathcal{R}_{bu}=\mathbb{E}_{(x,y)\sim\mathcal{D}_{-y_{t}}}(\ell(f((1-m)\odot x+m\odot\Delta;\theta),y)).\end{matrix}\right.</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="A4.SS3.p1.3" class="ltx_p">A poisoned sample is defined as <math id="A4.SS3.p1.m2" class="ltx_Math" alttext="(1-m)\odot x+m\odot\Delta" display="inline" intent=":literal"><semantics><mrow><mrow><mrow><mo stretchy="false">(</mo><mrow><mn>1</mn><mo>−</mo><mi>m</mi></mrow><mo rspace="0.055em" stretchy="false">)</mo></mrow><mo rspace="0.222em">⊙</mo><mi>x</mi></mrow><mo>+</mo><mrow><mi>m</mi><mo lspace="0.222em" rspace="0.222em">⊙</mo><mi mathvariant="normal">Δ</mi></mrow></mrow><annotation encoding="application/x-tex">(1-m)\odot x+m\odot\Delta</annotation></semantics></math>, where <math id="A4.SS3.p1.m3" class="ltx_Math" alttext="\odot" display="inline" intent=":literal"><semantics><mo>⊙</mo><annotation encoding="application/x-tex">\odot</annotation></semantics></math> denotes the element-wise product, <math id="A4.SS3.p1.m4" class="ltx_Math" alttext="\Delta" display="inline" intent=":literal"><semantics><mi mathvariant="normal">Δ</mi><annotation encoding="application/x-tex">\Delta</annotation></semantics></math> is the backdoor trigger, and
the binary mask <math id="A4.SS3.p1.m5" class="ltx_Math" alttext="m\in\{0,1\}^{n}" display="inline" intent=":literal"><semantics><mrow><mi>m</mi><mo>∈</mo><msup><mrow><mo stretchy="false">{</mo><mrow><mn>0</mn><mo>,</mo><mn>1</mn></mrow><mo stretchy="false">}</mo></mrow><mi>n</mi></msup></mrow><annotation encoding="application/x-tex">m\in\{0,1\}^{n}</annotation></semantics></math> specifies its location and intensity. The coefficients <math id="A4.SS3.p1.m6" class="ltx_Math" alttext="\lambda" display="inline" intent=":literal"><semantics><mi>λ</mi><annotation encoding="application/x-tex">\lambda</annotation></semantics></math> balance clean task performance and the backdoor unlearning objective.
In our experiments, we set <math id="A4.SS3.p1.m7" class="ltx_Math" alttext="\lambda=1.0" display="inline" intent=":literal"><semantics><mrow><mi>λ</mi><mo>=</mo><mn>1.0</mn></mrow><annotation encoding="application/x-tex">\lambda=1.0</annotation></semantics></math>.</p>
</div>
<div id="A4.SS3.p2" class="ltx_para">
<p id="A4.SS3.p2.1" class="ltx_p">BI-BAU employs projected gradient descent (PGD) attack <cite class="ltx_cite ltx_citemacro_citep">(<a href="#bib.bib7" title="" class="ltx_ref">Cubuk et al., 2017</a>)</cite> to generate adversarial examples in the inner maximization step and subsequently unlearns them to mitigate the backdoor effects in the outer minimization step.
<span id="A4.SS3.p2.1.1" class="ltx_text ltx_font_bold">(i) In the inner optimization step</span>, we set the parameters involved in <math id="A4.SS3.p2.m1" class="ltx_Math" alttext="\mathcal{L}_{adv\text{-}in}" display="inline" intent=":literal"><semantics><msub><mi class="ltx_font_mathcaligraphic">ℒ</mi><mrow><mi>a</mi><mo lspace="0em" rspace="0em">​</mo><mi>d</mi><mo lspace="0em" rspace="0em">​</mo><mi>v</mi><mo lspace="0em" rspace="0em">​</mo><mtext>-</mtext><mo lspace="0em" rspace="0em">​</mo><mi>i</mi><mo lspace="0em" rspace="0em">​</mo><mi>n</mi></mrow></msub><annotation encoding="application/x-tex">\mathcal{L}_{adv\text{-}in}</annotation></semantics></math> as <math id="A4.SS3.p2.m2" class="ltx_Math" alttext="\lambda_{1}=1.0" display="inline" intent=":literal"><semantics><mrow><msub><mi>λ</mi><mn>1</mn></msub><mo>=</mo><mn>1.0</mn></mrow><annotation encoding="application/x-tex">\lambda_{1}=1.0</annotation></semantics></math> and <math id="A4.SS3.p2.m3" class="ltx_Math" alttext="\lambda_{2}=1.0" display="inline" intent=":literal"><semantics><mrow><msub><mi>λ</mi><mn>2</mn></msub><mo>=</mo><mn>1.0</mn></mrow><annotation encoding="application/x-tex">\lambda_{2}=1.0</annotation></semantics></math>.
For the data likelihood loss <math id="A4.SS3.p2.m4" class="ltx_Math" alttext="\ell_{kd}" display="inline" intent=":literal"><semantics><msub><mi mathvariant="normal">ℓ</mi><mrow><mi>k</mi><mo lspace="0em" rspace="0em">​</mo><mi>d</mi></mrow></msub><annotation encoding="application/x-tex">\ell_{kd}</annotation></semantics></math>, we use <math id="A4.SS3.p2.m5" class="ltx_Math" alttext="\alpha=0.2" display="inline" intent=":literal"><semantics><mrow><mi>α</mi><mo>=</mo><mn>0.2</mn></mrow><annotation encoding="application/x-tex">\alpha=0.2</annotation></semantics></math> and <math id="A4.SS3.p2.m6" class="ltx_Math" alttext="T=1.0" display="inline" intent=":literal"><semantics><mrow><mi>T</mi><mo>=</mo><mn>1.0</mn></mrow><annotation encoding="application/x-tex">T=1.0</annotation></semantics></math>. Regarding the parameter <math id="A4.SS3.p2.m7" class="ltx_Math" alttext="k" display="inline" intent=":literal"><semantics><mi>k</mi><annotation encoding="application/x-tex">k</annotation></semantics></math> in the prior loss term <math id="A4.SS3.p2.m8" class="ltx_Math" alttext="\ell_{prior}" display="inline" intent=":literal"><semantics><msub><mi mathvariant="normal">ℓ</mi><mrow><mi>p</mi><mo lspace="0em" rspace="0em">​</mo><mi>r</mi><mo lspace="0em" rspace="0em">​</mo><mi>i</mi><mo lspace="0em" rspace="0em">​</mo><mi>o</mi><mo lspace="0em" rspace="0em">​</mo><mi>r</mi></mrow></msub><annotation encoding="application/x-tex">\ell_{prior}</annotation></semantics></math>, we set <math id="A4.SS3.p2.m9" class="ltx_Math" alttext="k=0.8" display="inline" intent=":literal"><semantics><mrow><mi>k</mi><mo>=</mo><mn>0.8</mn></mrow><annotation encoding="application/x-tex">k=0.8</annotation></semantics></math> for general attacks.
However, for attacks characterized by low orthogonality or low linearity, we set <math id="A4.SS3.p2.m10" class="ltx_Math" alttext="k=0.4" display="inline" intent=":literal"><semantics><mrow><mi>k</mi><mo>=</mo><mn>0.4</mn></mrow><annotation encoding="application/x-tex">k=0.4</annotation></semantics></math> for Refool, and <math id="A4.SS3.p2.m11" class="ltx_Math" alttext="k=0.2" display="inline" intent=":literal"><semantics><mrow><mi>k</mi><mo>=</mo><mn>0.2</mn></mrow><annotation encoding="application/x-tex">k=0.2</annotation></semantics></math> for SIG, Narcissus, Adaptive-Blend, and Adaptive-Patch.
<span id="A4.SS3.p2.1.2" class="ltx_text ltx_font_bold">(ii) In the outer optimization step</span>, for the loss <math id="A4.SS3.p2.m12" class="ltx_Math" alttext="\mathcal{L}_{adv\text{-}out}" display="inline" intent=":literal"><semantics><msub><mi class="ltx_font_mathcaligraphic">ℒ</mi><mrow><mi>a</mi><mo lspace="0em" rspace="0em">​</mo><mi>d</mi><mo lspace="0em" rspace="0em">​</mo><mi>v</mi><mo lspace="0em" rspace="0em">​</mo><mtext>-</mtext><mo lspace="0em" rspace="0em">​</mo><mi>o</mi><mo lspace="0em" rspace="0em">​</mo><mi>u</mi><mo lspace="0em" rspace="0em">​</mo><mi>t</mi></mrow></msub><annotation encoding="application/x-tex">\mathcal{L}_{adv\text{-}out}</annotation></semantics></math>, we set the parameters <math id="A4.SS3.p2.m13" class="ltx_Math" alttext="\gamma_{1}" display="inline" intent=":literal"><semantics><msub><mi>γ</mi><mn>1</mn></msub><annotation encoding="application/x-tex">\gamma_{1}</annotation></semantics></math> and <math id="A4.SS3.p2.m14" class="ltx_Math" alttext="\gamma_{2}" display="inline" intent=":literal"><semantics><msub><mi>γ</mi><mn>2</mn></msub><annotation encoding="application/x-tex">\gamma_{2}</annotation></semantics></math> as follows.
we use <math id="A4.SS3.p2.m15" class="ltx_Math" alttext="\gamma_{1}=1.0" display="inline" intent=":literal"><semantics><mrow><msub><mi>γ</mi><mn>1</mn></msub><mo>=</mo><mn>1.0</mn></mrow><annotation encoding="application/x-tex">\gamma_{1}=1.0</annotation></semantics></math>, and <math id="A4.SS3.p2.m16" class="ltx_Math" alttext="\gamma_{2}=1.0" display="inline" intent=":literal"><semantics><mrow><msub><mi>γ</mi><mn>2</mn></msub><mo>=</mo><mn>1.0</mn></mrow><annotation encoding="application/x-tex">\gamma_{2}=1.0</annotation></semantics></math>, with a learning rate of <math id="A4.SS3.p2.m17" class="ltx_Math" alttext="0.0001" display="inline" intent=":literal"><semantics><mn>0.0001</mn><annotation encoding="application/x-tex">0.0001</annotation></semantics></math> for general backdoor attacks.
In contrast, for attacks with low orthogonality or low linearity, we adopt <math id="A4.SS3.p2.m18" class="ltx_Math" alttext="\gamma_{1}=1.0" display="inline" intent=":literal"><semantics><mrow><msub><mi>γ</mi><mn>1</mn></msub><mo>=</mo><mn>1.0</mn></mrow><annotation encoding="application/x-tex">\gamma_{1}=1.0</annotation></semantics></math>, and <math id="A4.SS3.p2.m19" class="ltx_Math" alttext="\gamma_{2}=0.01" display="inline" intent=":literal"><semantics><mrow><msub><mi>γ</mi><mn>2</mn></msub><mo>=</mo><mn>0.01</mn></mrow><annotation encoding="application/x-tex">\gamma_{2}=0.01</annotation></semantics></math> and set the learning rate to <math id="A4.SS3.p2.m20" class="ltx_Math" alttext="0.0005" display="inline" intent=":literal"><semantics><mn>0.0005</mn><annotation encoding="application/x-tex">0.0005</annotation></semantics></math>.
In our method, adversarial examples are generated using Projected Gradient Descent (PGD) under the <math id="A4.SS3.p2.m21" class="ltx_Math" alttext="L_{\infty}" display="inline" intent=":literal"><semantics><msub><mi>L</mi><mi mathvariant="normal">∞</mi></msub><annotation encoding="application/x-tex">L_{\infty}</annotation></semantics></math> norm constraint.
Specifically, we employ 20 steps with a step size of 2.0 and a perturbation bound of 25.0 across all experiments.
All perturbations are applied in the input pixel space, where pixel values range from 0 to 255.</p>
</div>
</section>
<section id="A4.SS4" class="ltx_subsection">
<h3 class="ltx_title ltx_title_subsection"><span class="ltx_tag ltx_tag_subsection">D.4. </span>Layer-wise Activation Analysis</h3>

<div id="A4.SS4.p1" class="ltx_para">
<p id="A4.SS4.p1.1" class="ltx_p">To further verify whether “complete unlearning” is truly achieved, we adopt and extend additional neural-level evaluation metrics, such as the Backdoor Existence
Coefficient (BEC) introduced by <cite class="ltx_cite ltx_citemacro_citet"><a href="#bib.bib68" title="" class="ltx_ref">Zhu et al. (2024)</a></cite>.
An effective indicator should be able to quantify the similarity of backdoor effects between the backdoored model and the target defense model across the entire network,
thereby validating that BI-BAU completely eliminates the backdoor effects embedded in the original backdoored model and achieves the claimed backdoor defense goal
of “complete unlearning”. The implementation details of the Backdoor Existence Coefficient (BEC) are described as follows. Backdoor Existence Coefficient (BEC),
which is calculated through the following three steps <cite class="ltx_cite ltx_citemacro_citep">(<a href="#bib.bib68" title="" class="ltx_ref">Zhu et al., 2024</a>)</cite>:</p>
<ol id="A4.I1" class="ltx_enumerate">
<li id="A4.I1.i1" class="ltx_item" style="list-style-type:none;"><span class="ltx_tag ltx_tag_item">(1)</span> 
<div id="A4.I1.i1.p1" class="ltx_para">
<p id="A4.I1.i1.p1.1" class="ltx_p"><span id="A4.I1.i1.p1.1.1" class="ltx_text ltx_font_bold">Backdoor neuron identification</span>: Firstly, we need to identify backdoor-related neurons. <cite class="ltx_cite ltx_citemacro_citet"><a href="#bib.bib66" title="" class="ltx_ref">Zheng et al. (2022a)</a></cite> proposed Trigger-activated Change (TAC)
to quantify the correlation between backdoor impact and neurons.
With this metric, backdoor-related neurons in <math id="A4.I1.i1.p1.m1" class="ltx_Math" alttext="f_{{\bm{\theta}}_{\text{A}}}" display="inline" intent=":literal"><semantics><msub><mi>f</mi><msub><mi>𝜽</mi><mtext>A</mtext></msub></msub><annotation encoding="application/x-tex">f_{{\bm{\theta}}_{\text{A}}}</annotation></semantics></math> are identified for each layer. Thus, the feature maps corresponding to these neuron indices
are selected for each model, denoted as <math id="A4.I1.i1.p1.m2" class="ltx_Math" alttext="\tilde{m}^{(l)}_{\text{A}}(\bm{x}_{\bm{\xi}})" display="inline" intent=":literal"><semantics><mrow><msubsup><mover accent="true"><mi>m</mi><mo>~</mo></mover><mtext>A</mtext><mrow><mo stretchy="false">(</mo><mi>l</mi><mo stretchy="false">)</mo></mrow></msubsup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mi>𝒙</mi><mi>𝝃</mi></msub><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">\tilde{m}^{(l)}_{\text{A}}(\bm{x}_{\bm{\xi}})</annotation></semantics></math>, <math id="A4.I1.i1.p1.m3" class="ltx_Math" alttext="\tilde{m}^{(l)}_{\text{D}}(\bm{x}_{\bm{\xi}})" display="inline" intent=":literal"><semantics><mrow><msubsup><mover accent="true"><mi>m</mi><mo>~</mo></mover><mtext>D</mtext><mrow><mo stretchy="false">(</mo><mi>l</mi><mo stretchy="false">)</mo></mrow></msubsup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mi>𝒙</mi><mi>𝝃</mi></msub><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">\tilde{m}^{(l)}_{\text{D}}(\bm{x}_{\bm{\xi}})</annotation></semantics></math>, and <math id="A4.I1.i1.p1.m4" class="ltx_Math" alttext="\tilde{m}^{(l)}_{\text{C}}(\bm{x}_{\bm{\xi}})" display="inline" intent=":literal"><semantics><mrow><msubsup><mover accent="true"><mi>m</mi><mo>~</mo></mover><mtext>C</mtext><mrow><mo stretchy="false">(</mo><mi>l</mi><mo stretchy="false">)</mo></mrow></msubsup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mi>𝒙</mi><mi>𝝃</mi></msub><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">\tilde{m}^{(l)}_{\text{C}}(\bm{x}_{\bm{\xi}})</annotation></semantics></math>,
respectively. Denote the feature maps across dataset <math id="A4.I1.i1.p1.m5" class="ltx_Math" alttext="\mathcal{D}_{p}" display="inline" intent=":literal"><semantics><msub><mi class="ltx_font_mathcaligraphic">𝒟</mi><mi>p</mi></msub><annotation encoding="application/x-tex">\mathcal{D}_{p}</annotation></semantics></math> as <math id="A4.I1.i1.p1.m6" class="ltx_Math" alttext="\tilde{m}^{(l)}(\mathcal{D}_{p})\in\mathbb{R}^{n_{p}\times(\tilde{c}_{l}\times h_{l}\times w_{l})}" display="inline" intent=":literal"><semantics><mrow><mrow><msup><mover accent="true"><mi>m</mi><mo>~</mo></mover><mrow><mo stretchy="false">(</mo><mi>l</mi><mo stretchy="false">)</mo></mrow></msup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mi class="ltx_font_mathcaligraphic">𝒟</mi><mi>p</mi></msub><mo stretchy="false">)</mo></mrow></mrow><mo>∈</mo><msup><mi>ℝ</mi><mrow><msub><mi>n</mi><mi>p</mi></msub><mo lspace="0.222em" rspace="0.222em">×</mo><mrow><mo stretchy="false">(</mo><mrow><msub><mover accent="true"><mi>c</mi><mo>~</mo></mover><mi>l</mi></msub><mo lspace="0.222em" rspace="0.222em">×</mo><msub><mi>h</mi><mi>l</mi></msub><mo lspace="0.222em" rspace="0.222em">×</mo><msub><mi>w</mi><mi>l</mi></msub></mrow><mo stretchy="false">)</mo></mrow></mrow></msup></mrow><annotation encoding="application/x-tex">\tilde{m}^{(l)}(\mathcal{D}_{p})\in\mathbb{R}^{n_{p}\times(\tilde{c}_{l}\times h_{l}\times w_{l})}</annotation></semantics></math>.</p>
</div></li>
<li id="A4.I1.i2" class="ltx_item" style="list-style-type:none;"><span class="ltx_tag ltx_tag_item">(2)</span> 
<div id="A4.I1.i2.p1" class="ltx_para">
<p id="A4.I1.i2.p1.1" class="ltx_p"><span id="A4.I1.i2.p1.1.1" class="ltx_text ltx_font_bold">Backdoor effect similarity metric</span>: In order to measure the backdoor effect similarity between models, we employ Centered Kernel Alignment (CKA) <cite class="ltx_cite ltx_citemacro_citep">(<a href="#bib.bib20" title="" class="ltx_ref">Kornblith et al., 2019</a>)</cite>
to quantify the similarity between these matrices.
The similarity in backdoor effects between <math id="A4.I1.i2.p1.m1" class="ltx_Math" alttext="f_{{\bm{\theta}}_{\text{D}}}" display="inline" intent=":literal"><semantics><msub><mi>f</mi><msub><mi>𝜽</mi><mtext>D</mtext></msub></msub><annotation encoding="application/x-tex">f_{{\bm{\theta}}_{\text{D}}}</annotation></semantics></math> and <math id="A4.I1.i2.p1.m2" class="ltx_Math" alttext="f_{{\bm{\theta}}_{\text{A}}}" display="inline" intent=":literal"><semantics><msub><mi>f</mi><msub><mi>𝜽</mi><mtext>A</mtext></msub></msub><annotation encoding="application/x-tex">f_{{\bm{\theta}}_{\text{A}}}</annotation></semantics></math>, calculated through the use of corresponding features, can be computed as:</p>
<table id="A4.E51" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td rowspan="1" class="ltx_eqn_cell ltx_eqn_eqno ltx_align_middle ltx_align_left"><span class="ltx_tag ltx_tag_equation ltx_align_left">(51)</span></td>
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="A4.E51.m1" class="ltx_Math" alttext="S_{\text{D},\text{A}}^{(l)}(\mathcal{D}_{p})=\text{CKA}\left(\tilde{m}_{\text{D}}^{(l)}(\mathcal{D}_{p}),\tilde{m}_{\text{A}}^{(l)}(\mathcal{D}_{p})\right)," display="block" intent=":literal"><semantics><mrow><mrow><mrow><msubsup><mi>S</mi><mrow><mtext>D</mtext><mo>,</mo><mtext>A</mtext></mrow><mrow><mo stretchy="false">(</mo><mi>l</mi><mo stretchy="false">)</mo></mrow></msubsup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mi class="ltx_font_mathcaligraphic">𝒟</mi><mi>p</mi></msub><mo stretchy="false">)</mo></mrow></mrow><mo>=</mo><mrow><mtext>CKA</mtext><mo lspace="0em" rspace="0em">​</mo><mrow><mo>(</mo><mrow><msubsup><mover accent="true"><mi>m</mi><mo>~</mo></mover><mtext>D</mtext><mrow><mo stretchy="false">(</mo><mi>l</mi><mo stretchy="false">)</mo></mrow></msubsup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mi class="ltx_font_mathcaligraphic">𝒟</mi><mi>p</mi></msub><mo stretchy="false">)</mo></mrow></mrow><mo>,</mo><mrow><msubsup><mover accent="true"><mi>m</mi><mo>~</mo></mover><mtext>A</mtext><mrow><mo stretchy="false">(</mo><mi>l</mi><mo stretchy="false">)</mo></mrow></msubsup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mi class="ltx_font_mathcaligraphic">𝒟</mi><mi>p</mi></msub><mo stretchy="false">)</mo></mrow></mrow><mo>)</mo></mrow></mrow></mrow><mo>,</mo></mrow><annotation encoding="application/x-tex">S_{\text{D},\text{A}}^{(l)}(\mathcal{D}_{p})=\text{CKA}\left(\tilde{m}_{\text{D}}^{(l)}(\mathcal{D}_{p}),\tilde{m}_{\text{A}}^{(l)}(\mathcal{D}_{p})\right),</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="A4.I1.i2.p1.2" class="ltx_p">and <math id="A4.I1.i2.p1.m3" class="ltx_Math" alttext="S_{\text{C},\text{A}}^{(l)}(\mathcal{D}_{p})" display="inline" intent=":literal"><semantics><mrow><msubsup><mi>S</mi><mrow><mtext>C</mtext><mo>,</mo><mtext>A</mtext></mrow><mrow><mo stretchy="false">(</mo><mi>l</mi><mo stretchy="false">)</mo></mrow></msubsup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mi class="ltx_font_mathcaligraphic">𝒟</mi><mi>p</mi></msub><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">S_{\text{C},\text{A}}^{(l)}(\mathcal{D}_{p})</annotation></semantics></math> is computed accordingly.</p>
</div></li>
<li id="A4.I1.i3" class="ltx_item" style="list-style-type:none;"><span class="ltx_tag ltx_tag_item">(3)</span> 
<div id="A4.I1.i3.p1" class="ltx_para">
<p id="A4.I1.i3.p1.1" class="ltx_p"><span id="A4.I1.i3.p1.1.1" class="ltx_text ltx_font_bold">Backdoor existence coefficient computation</span>: The BEC is the average of normalized backdoor effect similarity across all layers. By assigning the BEC
of <math id="A4.I1.i3.p1.m1" class="ltx_Math" alttext="f_{{\bm{\theta}}_{\text{A}}}" display="inline" intent=":literal"><semantics><msub><mi>f</mi><msub><mi>𝜽</mi><mtext>A</mtext></msub></msub><annotation encoding="application/x-tex">f_{{\bm{\theta}}_{\text{A}}}</annotation></semantics></math> a value of 1 and <math id="A4.I1.i3.p1.m2" class="ltx_Math" alttext="f_{{\bm{\theta}}_{\text{C}}}" display="inline" intent=":literal"><semantics><msub><mi>f</mi><msub><mi>𝜽</mi><mtext>C</mtext></msub></msub><annotation encoding="application/x-tex">f_{{\bm{\theta}}_{\text{C}}}</annotation></semantics></math> a value of 0, the computation can proceed as follows:</p>
<table id="A4.E52" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td rowspan="1" class="ltx_eqn_cell ltx_eqn_eqno ltx_align_middle ltx_align_left"><span class="ltx_tag ltx_tag_equation ltx_align_left">(52)</span></td>
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="A4.E52.m1" class="ltx_Math" alttext="\rho_{\text{BEC}}(f_{{\bm{\theta}}_{\text{D}}},f_{{\bm{\theta}}_{\text{A}}},f_{{\bm{\theta}}_{\text{C}}};\mathcal{D}_{p})=\frac{1}{N}\sum_{l=1}^{N}\frac{S_{\text{D},\text{A}}^{(l)}(\mathcal{D}_{p})-S_{\text{C},\text{A}}^{(l)}(\mathcal{D}_{p})}{S_{\text{A},\text{A}}^{(l)}(\mathcal{D}_{p})-S_{\text{C},\text{A}}^{(l)}(\mathcal{D}_{p})}." display="block" intent=":literal"><semantics><mrow><mrow><mrow><msub><mi>ρ</mi><mtext>BEC</mtext></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mi>f</mi><msub><mi>𝜽</mi><mtext>D</mtext></msub></msub><mo>,</mo><msub><mi>f</mi><msub><mi>𝜽</mi><mtext>A</mtext></msub></msub><mo>,</mo><msub><mi>f</mi><msub><mi>𝜽</mi><mtext>C</mtext></msub></msub><mo>,</mo><msub><mi class="ltx_font_mathcaligraphic">𝒟</mi><mi>p</mi></msub><mo stretchy="false">)</mo></mrow></mrow><mo>=</mo><mrow><mfrac><mn>1</mn><mi>N</mi></mfrac><mo lspace="0em" rspace="0em">​</mo><mrow><munderover><mo movablelimits="false">∑</mo><mrow><mi>l</mi><mo>=</mo><mn>1</mn></mrow><mi>N</mi></munderover><mfrac><mrow><mrow><msubsup><mi>S</mi><mrow><mtext>D</mtext><mo>,</mo><mtext>A</mtext></mrow><mrow><mo stretchy="false">(</mo><mi>l</mi><mo stretchy="false">)</mo></mrow></msubsup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mi class="ltx_font_mathcaligraphic">𝒟</mi><mi>p</mi></msub><mo stretchy="false">)</mo></mrow></mrow><mo>−</mo><mrow><msubsup><mi>S</mi><mrow><mtext>C</mtext><mo>,</mo><mtext>A</mtext></mrow><mrow><mo stretchy="false">(</mo><mi>l</mi><mo stretchy="false">)</mo></mrow></msubsup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mi class="ltx_font_mathcaligraphic">𝒟</mi><mi>p</mi></msub><mo stretchy="false">)</mo></mrow></mrow></mrow><mrow><mrow><msubsup><mi>S</mi><mrow><mtext>A</mtext><mo>,</mo><mtext>A</mtext></mrow><mrow><mo stretchy="false">(</mo><mi>l</mi><mo stretchy="false">)</mo></mrow></msubsup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mi class="ltx_font_mathcaligraphic">𝒟</mi><mi>p</mi></msub><mo stretchy="false">)</mo></mrow></mrow><mo>−</mo><mrow><msubsup><mi>S</mi><mrow><mtext>C</mtext><mo>,</mo><mtext>A</mtext></mrow><mrow><mo stretchy="false">(</mo><mi>l</mi><mo stretchy="false">)</mo></mrow></msubsup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mi class="ltx_font_mathcaligraphic">𝒟</mi><mi>p</mi></msub><mo stretchy="false">)</mo></mrow></mrow></mrow></mfrac></mrow></mrow></mrow><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">\rho_{\text{BEC}}(f_{{\bm{\theta}}_{\text{D}}},f_{{\bm{\theta}}_{\text{A}}},f_{{\bm{\theta}}_{\text{C}}};\mathcal{D}_{p})=\frac{1}{N}\sum_{l=1}^{N}\frac{S_{\text{D},\text{A}}^{(l)}(\mathcal{D}_{p})-S_{\text{C},\text{A}}^{(l)}(\mathcal{D}_{p})}{S_{\text{A},\text{A}}^{(l)}(\mathcal{D}_{p})-S_{\text{C},\text{A}}^{(l)}(\mathcal{D}_{p})}.</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
</div></li>
</ol>
<p id="A4.SS4.p1.2" class="ltx_p">Denote <math id="A4.SS4.p1.m1" class="ltx_Math" alttext="\rho_{\text{BEC}}(f_{{\bm{\theta}}_{\text{D}}},f_{{\bm{\theta}}_{\text{A}}},f_{{\bm{\theta}}_{\text{C}}};\mathcal{D}_{p})" display="inline" intent=":literal"><semantics><mrow><msub><mi>ρ</mi><mtext>BEC</mtext></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mi>f</mi><msub><mi>𝜽</mi><mtext>D</mtext></msub></msub><mo>,</mo><msub><mi>f</mi><msub><mi>𝜽</mi><mtext>A</mtext></msub></msub><mo>,</mo><msub><mi>f</mi><msub><mi>𝜽</mi><mtext>C</mtext></msub></msub><mo>,</mo><msub><mi class="ltx_font_mathcaligraphic">𝒟</mi><mi>p</mi></msub><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">\rho_{\text{BEC}}(f_{{\bm{\theta}}_{\text{D}}},f_{{\bm{\theta}}_{\text{A}}},f_{{\bm{\theta}}_{\text{C}}};\mathcal{D}_{p})</annotation></semantics></math> as <math id="A4.SS4.p1.m2" class="ltx_Math" alttext="\rho_{\text{BEC}}(f_{{\bm{\theta}}_{\text{D}}})" display="inline" intent=":literal"><semantics><mrow><msub><mi>ρ</mi><mtext>BEC</mtext></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mi>f</mi><msub><mi>𝜽</mi><mtext>D</mtext></msub></msub><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">\rho_{\text{BEC}}(f_{{\bm{\theta}}_{\text{D}}})</annotation></semantics></math> for simplicity.
<cite class="ltx_cite ltx_citemacro_citet"><a href="#bib.bib68" title="" class="ltx_ref">Zhu et al. (2024)</a></cite> utilize <span id="A4.SS4.p1.2.1" class="ltx_text ltx_markedasmath">BEC</span> to signify backdoor existence of the target defense model (<em id="A4.SS4.p1.2.2" class="ltx_emph ltx_font_italic">i.e.,</em> the purified model) <math id="A4.SS4.p1.m4" class="ltx_Math" alttext="f_{{\bm{\theta}}_{\text{D}}}" display="inline" intent=":literal"><semantics><msub><mi>f</mi><msub><mi>𝜽</mi><mtext>D</mtext></msub></msub><annotation encoding="application/x-tex">f_{{\bm{\theta}}_{\text{D}}}</annotation></semantics></math>.</p>
</div>
<div id="A4.SS4.p2" class="ltx_para">
<p id="A4.SS4.p2.1" class="ltx_p">However, <math id="A4.SS4.p2.m1" class="ltx_Math" alttext="\rho_{\text{BEC}}" display="inline" intent=":literal"><semantics><msub><mi>ρ</mi><mtext>BEC</mtext></msub><annotation encoding="application/x-tex">\rho_{\text{BEC}}</annotation></semantics></math> may occasionally take values below 0. To address this, we apply a sigmoid transformation:</p>
<table id="A4.E53" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td rowspan="1" class="ltx_eqn_cell ltx_eqn_eqno ltx_align_middle ltx_align_left"><span class="ltx_tag ltx_tag_equation ltx_align_left">(53)</span></td>
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="A4.E53.m1" class="ltx_Math" alttext="\sigma(\rho_{\text{BEC}})=\frac{1}{1+\text{exp}(-k(\rho_{\text{BEC}}-\rho_{c}))}" display="block" intent=":literal"><semantics><mrow><mrow><mi>σ</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><msub><mi>ρ</mi><mtext>BEC</mtext></msub><mo stretchy="false">)</mo></mrow></mrow><mo>=</mo><mfrac><mn>1</mn><mrow><mn>1</mn><mo>+</mo><mrow><mtext>exp</mtext><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mrow><mo>−</mo><mrow><mi>k</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mrow><msub><mi>ρ</mi><mtext>BEC</mtext></msub><mo>−</mo><msub><mi>ρ</mi><mi>c</mi></msub></mrow><mo stretchy="false">)</mo></mrow></mrow></mrow><mo stretchy="false">)</mo></mrow></mrow></mrow></mfrac></mrow><annotation encoding="application/x-tex">\sigma(\rho_{\text{BEC}})=\frac{1}{1+\text{exp}(-k(\rho_{\text{BEC}}-\rho_{c}))}</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="A4.SS4.p2.2" class="ltx_p">where <math id="A4.SS4.p2.m2" class="ltx_Math" alttext="k&gt;0" display="inline" intent=":literal"><semantics><mrow><mi>k</mi><mo>&gt;</mo><mn>0</mn></mrow><annotation encoding="application/x-tex">k&gt;0</annotation></semantics></math> controls the steepness of the curve, <math id="A4.SS4.p2.m3" class="ltx_Math" alttext="\rho_{c}" display="inline" intent=":literal"><semantics><msub><mi>ρ</mi><mi>c</mi></msub><annotation encoding="application/x-tex">\rho_{c}</annotation></semantics></math> represents the center of the curve, and <math id="A4.SS4.p2.m4" class="ltx_Math" alttext="\sigma(\rho_{\text{BEC}})=0.5" display="inline" intent=":literal"><semantics><mrow><mrow><mi>σ</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><msub><mi>ρ</mi><mtext>BEC</mtext></msub><mo stretchy="false">)</mo></mrow></mrow><mo>=</mo><mn>0.5</mn></mrow><annotation encoding="application/x-tex">\sigma(\rho_{\text{BEC}})=0.5</annotation></semantics></math> when <math id="A4.SS4.p2.m5" class="ltx_Math" alttext="\rho_{\text{BEC}}=\rho_{c}" display="inline" intent=":literal"><semantics><mrow><msub><mi>ρ</mi><mtext>BEC</mtext></msub><mo>=</mo><msub><mi>ρ</mi><mi>c</mi></msub></mrow><annotation encoding="application/x-tex">\rho_{\text{BEC}}=\rho_{c}</annotation></semantics></math>.
The function <math id="A4.SS4.p2.m6" class="ltx_Math" alttext="\sigma" display="inline" intent=":literal"><semantics><mi>σ</mi><annotation encoding="application/x-tex">\sigma</annotation></semantics></math> maps <math id="A4.SS4.p2.m7" class="ltx_Math" alttext="\rho_{\text{BEC}}" display="inline" intent=":literal"><semantics><msub><mi>ρ</mi><mtext>BEC</mtext></msub><annotation encoding="application/x-tex">\rho_{\text{BEC}}</annotation></semantics></math> into the range <math id="A4.SS4.p2.m8" class="ltx_Math" alttext="[0,1.0]" display="inline" intent=":literal"><semantics><mrow><mo stretchy="false">[</mo><mn>0</mn><mo>,</mo><mn>1.0</mn><mo stretchy="false">]</mo></mrow><annotation encoding="application/x-tex">[0,1.0]</annotation></semantics></math>, where a higher value of <math id="A4.SS4.p2.m9" class="ltx_Math" alttext="\sigma(\rho_{\text{BEC}})" display="inline" intent=":literal"><semantics><mrow><mi>σ</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><msub><mi>ρ</mi><mtext>BEC</mtext></msub><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">\sigma(\rho_{\text{BEC}})</annotation></semantics></math> indicates a stronger presence of backdoors
in the model.</p>
</div>
<div id="A4.SS4.p3" class="ltx_para">
<p id="A4.SS4.p3.1" class="ltx_p">In the experiments, we set <math id="A4.SS4.p3.m1" class="ltx_Math" alttext="k=4.0" display="inline" intent=":literal"><semantics><mrow><mi>k</mi><mo>=</mo><mn>4.0</mn></mrow><annotation encoding="application/x-tex">k=4.0</annotation></semantics></math> and <math id="A4.SS4.p3.m2" class="ltx_Math" alttext="\rho_{c}=0.5" display="inline" intent=":literal"><semantics><mrow><msub><mi>ρ</mi><mi>c</mi></msub><mo>=</mo><mn>0.5</mn></mrow><annotation encoding="application/x-tex">\rho_{c}=0.5</annotation></semantics></math>. Considering that the shallow layers in neural networks generally capture more general features and are
more susceptible to noise <cite class="ltx_cite ltx_citemacro_citep">(<a href="#bib.bib45" title="" class="ltx_ref">Semenova et al., 2022</a>)</cite>, we only used the last 10 convolutional layers (20 layers in total for ResNet-18).
This metric serves as a complementary evaluation to ASR, enabling quantification of residual backdoor effects at the layer-wise level within the neural network.</p>
</div>
</section>
</section>
<section id="A5" class="ltx_appendix">
<h2 class="ltx_title ltx_title_appendix"><span class="ltx_tag ltx_tag_appendix">Appendix E </span>Additional Experiments</h2>

<section id="A5.SS1" class="ltx_subsection">
<h3 class="ltx_title ltx_title_subsection"><span class="ltx_tag ltx_tag_subsection">E.1. </span>Validating Assumption <a href="#ThmAssumption1" title="Assumption 1. ‣ 4.1. Problem Formulation ‣ 4. Methodology ‣ Rethinking Backdoor Adversarial Unlearning through the Lens of Catastrophic Forgetting in Continual Learning" class="ltx_ref"><span class="ltx_text ltx_ref_tag">1</span></a></h3>

<div id="A5.SS1.p1" class="ltx_para">
<p id="A5.SS1.p1.1" class="ltx_p">Prior study <cite class="ltx_cite ltx_citemacro_citep">(<a href="#bib.bib25" title="" class="ltx_ref">Li et al., 2021b</a>)</cite> views backdoor learning as a composition of a clean task <math id="A5.SS1.p1.m1" class="ltx_Math" alttext="\tau_{c}" display="inline" intent=":literal"><semantics><msub><mi>τ</mi><mi>c</mi></msub><annotation encoding="application/x-tex">\tau_{c}</annotation></semantics></math> and a backdoor task <math id="A5.SS1.p1.m2" class="ltx_Math" alttext="\tau_{b}" display="inline" intent=":literal"><semantics><msub><mi>τ</mi><mi>b</mi></msub><annotation encoding="application/x-tex">\tau_{b}</annotation></semantics></math>.
<cite class="ltx_cite ltx_citemacro_citet"><a href="#bib.bib65" title="" class="ltx_ref">Zhang et al. (2024)</a></cite> further characterize this process as a two-stage task flow: <math id="A5.SS1.p1.m3" class="ltx_Math" alttext="\mathcal{T}=\{\tau_{b},\tau_{c}\}" display="inline" intent=":literal"><semantics><mrow><mi class="ltx_font_mathcaligraphic">𝒯</mi><mo>=</mo><mrow><mo stretchy="false">{</mo><msub><mi>τ</mi><mi>b</mi></msub><mo>,</mo><msub><mi>τ</mi><mi>c</mi></msub><mo stretchy="false">}</mo></mrow></mrow><annotation encoding="application/x-tex">\mathcal{T}=\{\tau_{b},\tau_{c}\}</annotation></semantics></math>,
comprising two independent learning tasks:① an initial rapid learning phase in which the backdoor task is acquired within just a few training epochs, followed by
② a subsequent phase of gradual adaptation to the clean task.</p>
</div>
<figure id="A5.F6" class="ltx_figure">
<div class="ltx_flex_figure">
<div class="ltx_flex_cell ltx_flex_size_3">
<figure id="A5.F6.sf1" class="ltx_figure ltx_figure_panel ltx_align_center"><object type="image/svg+xml" data="2606.14078v1/mix_clean_backdoor.svg" id="A5.F6.sf1.g1" class="ltx_graphics ltx_centering ltx_img_landscape" style="aspect-ratio:476/358;" width="476" height="358"></object>
<figcaption class="ltx_caption ltx_centering"><span class="ltx_tag ltx_tag_figure"><span id="A5.F6.sf1.3" class="ltx_text" style="font-size:90%;">(a)</span> </span><span id="A5.F6.sf1.4" class="ltx_text" style="font-size:90%;">Joint Learning</span></figcaption>
</figure></div><div class="ltx_flex_cell ltx_flex_size_3">
<figure id="A5.F6.sf2" class="ltx_figure ltx_figure_panel ltx_align_center"><object type="image/svg+xml" data="2606.14078v1/backdoor_to_clean.svg" id="A5.F6.sf2.g1" class="ltx_graphics ltx_centering ltx_img_landscape" style="aspect-ratio:476/358;" width="476" height="358"></object>
<figcaption class="ltx_caption ltx_centering"><span class="ltx_tag ltx_tag_figure"><span id="A5.F6.sf2.3" class="ltx_text" style="font-size:90%;">(b)</span> </span><math id="A5.F6.sf2.m2" class="ltx_Math" alttext="\mathcal{T}=\{\tau_{b},\tau_{c}\}" display="inline" intent=":literal"><semantics><mrow><mi class="ltx_font_mathcaligraphic" mathsize="0.900em">𝒯</mi><mo mathsize="0.900em">=</mo><mrow><mo stretchy="false">{</mo><msub><mi mathsize="0.900em">τ</mi><mi mathsize="0.900em">b</mi></msub><mo mathsize="0.900em">,</mo><msub><mi mathsize="0.900em">τ</mi><mi mathsize="0.900em">c</mi></msub><mo stretchy="false">}</mo></mrow></mrow><annotation encoding="application/x-tex">\mathcal{T}=\{\tau_{b},\tau_{c}\}</annotation></semantics></math></figcaption>
</figure></div><div class="ltx_flex_cell ltx_flex_size_3">
<figure id="A5.F6.sf3" class="ltx_figure ltx_figure_panel ltx_align_center"><object type="image/svg+xml" data="2606.14078v1/clean_to_backdoor.svg" id="A5.F6.sf3.g1" class="ltx_graphics ltx_centering ltx_img_landscape" style="aspect-ratio:476/358;" width="476" height="358"></object>
<figcaption class="ltx_caption ltx_centering"><span class="ltx_tag ltx_tag_figure"><span id="A5.F6.sf3.3" class="ltx_text" style="font-size:90%;">(c)</span> </span><math id="A5.F6.sf3.m2" class="ltx_Math" alttext="\mathcal{T}=\{\tau_{c},\tau_{b}\}" display="inline" intent=":literal"><semantics><mrow><mi class="ltx_font_mathcaligraphic" mathsize="0.900em">𝒯</mi><mo mathsize="0.900em">=</mo><mrow><mo stretchy="false">{</mo><msub><mi mathsize="0.900em">τ</mi><mi mathsize="0.900em">c</mi></msub><mo mathsize="0.900em">,</mo><msub><mi mathsize="0.900em">τ</mi><mi mathsize="0.900em">b</mi></msub><mo stretchy="false">}</mo></mrow></mrow><annotation encoding="application/x-tex">\mathcal{T}=\{\tau_{c},\tau_{b}\}</annotation></semantics></math></figcaption>
</figure></div></div>
<figcaption class="ltx_caption ltx_centering"><span class="ltx_tag ltx_tag_figure"><span id="A5.F6.4" class="ltx_text" style="font-size:90%;">Figure 6</span>. </span><span id="A5.F6.5" class="ltx_text" style="font-size:90%;">Illustration of backdoor learning as a task flow.</span></figcaption>
</figure>
<div id="A5.SS1.p2" class="ltx_para">
<p id="A5.SS1.p2.1" class="ltx_p">To validate the plausibility of Assumption <a href="#ThmAssumption1" title="Assumption 1. ‣ 4.1. Problem Formulation ‣ 4. Methodology ‣ Rethinking Backdoor Adversarial Unlearning through the Lens of Catastrophic Forgetting in Continual Learning" class="ltx_ref"><span class="ltx_text ltx_ref_tag">1</span></a>, we compare three training settings:
(i) the standard backdoor learning setup, (ii) a task stream <math id="A5.SS1.p2.m1" class="ltx_Math" alttext="\mathcal{T}=\{\tau_{b},\tau_{c}\}" display="inline" intent=":literal"><semantics><mrow><mi class="ltx_font_mathcaligraphic">𝒯</mi><mo>=</mo><mrow><mo stretchy="false">{</mo><msub><mi>τ</mi><mi>b</mi></msub><mo>,</mo><msub><mi>τ</mi><mi>c</mi></msub><mo stretchy="false">}</mo></mrow></mrow><annotation encoding="application/x-tex">\mathcal{T}=\{\tau_{b},\tau_{c}\}</annotation></semantics></math>, and (iii) a task stream <math id="A5.SS1.p2.m2" class="ltx_Math" alttext="\mathcal{T}=\{\tau_{c},\tau_{b}\}" display="inline" intent=":literal"><semantics><mrow><mi class="ltx_font_mathcaligraphic">𝒯</mi><mo>=</mo><mrow><mo stretchy="false">{</mo><msub><mi>τ</mi><mi>c</mi></msub><mo>,</mo><msub><mi>τ</mi><mi>b</mi></msub><mo stretchy="false">}</mo></mrow></mrow><annotation encoding="application/x-tex">\mathcal{T}=\{\tau_{c},\tau_{b}\}</annotation></semantics></math>.
Following the continual learning paradigm, we simulate the task streams using a ResNet-18 architecture on the CIFAR-10 dataset, with BadNets as a representative
attack method. Since the clean task <math id="A5.SS1.p2.m3" class="ltx_Math" alttext="\tau_{c}" display="inline" intent=":literal"><semantics><msub><mi>τ</mi><mi>c</mi></msub><annotation encoding="application/x-tex">\tau_{c}</annotation></semantics></math> and backdoor task <math id="A5.SS1.p2.m4" class="ltx_Math" alttext="\tau_{b}" display="inline" intent=":literal"><semantics><msub><mi>τ</mi><mi>b</mi></msub><annotation encoding="application/x-tex">\tau_{b}</annotation></semantics></math> share the same classifier (<em id="A5.SS1.p2.1.1" class="ltx_emph ltx_font_italic">i.e.,</em> the fully connected (FC) classification head), their parameters
inevitably overlap, making complete isolation between tasks is impractical. To approximate independent training on <math id="A5.SS1.p2.m5" class="ltx_Math" alttext="D_{c}" display="inline" intent=":literal"><semantics><msub><mi>D</mi><mi>c</mi></msub><annotation encoding="application/x-tex">D_{c}</annotation></semantics></math> and <math id="A5.SS1.p2.m6" class="ltx_Math" alttext="D_{p}" display="inline" intent=":literal"><semantics><msub><mi>D</mi><mi>p</mi></msub><annotation encoding="application/x-tex">D_{p}</annotation></semantics></math>, we adopt a rehearsal strategy
by introducing a few samples from the complementary task. This approach is supported by prior work <cite class="ltx_cite ltx_citemacro_citep">(<a href="#bib.bib43" title="" class="ltx_ref">Rolnick et al., 2019</a>)</cite> in continual learning, which helps
mitigate interference. Notably, the inclusion of a small number of samples is insufficient to achieve high performance, and is intended solely to approximate
task independence.</p>
<ol id="A5.I1" class="ltx_enumerate">
<li id="A5.I1.i1" class="ltx_item" style="list-style-type:none;"><span class="ltx_tag ltx_tag_item">()</span> 
<div id="A5.I1.i1.p1" class="ltx_para">
<p id="A5.I1.i1.p1.1" class="ltx_p">In the standard backdoor learning setting, the model is trained jointly on the poisoned dataset <math id="A5.I1.i1.p1.m1" class="ltx_Math" alttext="D_{p}" display="inline" intent=":literal"><semantics><msub><mi>D</mi><mi>p</mi></msub><annotation encoding="application/x-tex">D_{p}</annotation></semantics></math> and clean dataset <math id="A5.I1.i1.p1.m2" class="ltx_Math" alttext="D_{c}" display="inline" intent=":literal"><semantics><msub><mi>D</mi><mi>c</mi></msub><annotation encoding="application/x-tex">D_{c}</annotation></semantics></math>, with backdoor and clean tasks
learned simultaneously, as illustrated in Figure <a href="#A5.F6" title="Figure 6 ‣ E.1. Validating Assumption ‣ Appendix E Additional Experiments ‣ Rethinking Backdoor Adversarial Unlearning through the Lens of Catastrophic Forgetting in Continual Learning" class="ltx_ref"><span class="ltx_text ltx_ref_tag">6</span></a> (a).</p>
</div></li>
<li id="A5.I1.i2" class="ltx_item" style="list-style-type:none;"><span class="ltx_tag ltx_tag_item">()</span> 
<div id="A5.I1.i2.p1" class="ltx_para">
<p id="A5.I1.i2.p1.1" class="ltx_p">For the task stream <math id="A5.I1.i2.p1.m1" class="ltx_Math" alttext="\mathcal{T}=\{\tau_{b},\tau_{c}\}" display="inline" intent=":literal"><semantics><mrow><mi class="ltx_font_mathcaligraphic">𝒯</mi><mo>=</mo><mrow><mo stretchy="false">{</mo><msub><mi>τ</mi><mi>b</mi></msub><mo>,</mo><msub><mi>τ</mi><mi>c</mi></msub><mo stretchy="false">}</mo></mrow></mrow><annotation encoding="application/x-tex">\mathcal{T}=\{\tau_{b},\tau_{c}\}</annotation></semantics></math>, the training process is divided into two sequential phases. In the first phase, the model is
trained for 20 epochs based on a mixed dataset composed of the full poisoned dataset <math id="A5.I1.i2.p1.m2" class="ltx_Math" alttext="D_{p}" display="inline" intent=":literal"><semantics><msub><mi>D</mi><mi>p</mi></msub><annotation encoding="application/x-tex">D_{p}</annotation></semantics></math> and a small fraction (10%) of clean data.
In the second stage, the model is further trained on the full clean dataset <math id="A5.I1.i2.p1.m3" class="ltx_Math" alttext="D_{c}" display="inline" intent=":literal"><semantics><msub><mi>D</mi><mi>c</mi></msub><annotation encoding="application/x-tex">D_{c}</annotation></semantics></math> with only 1% of poisoned subset <math id="A5.I1.i2.p1.m4" class="ltx_Math" alttext="D_{p}" display="inline" intent=":literal"><semantics><msub><mi>D</mi><mi>p</mi></msub><annotation encoding="application/x-tex">D_{p}</annotation></semantics></math>, continuing for 80 epochs, as illustrated in Figure <a href="#A5.F6" title="Figure 6 ‣ E.1. Validating Assumption ‣ Appendix E Additional Experiments ‣ Rethinking Backdoor Adversarial Unlearning through the Lens of Catastrophic Forgetting in Continual Learning" class="ltx_ref"><span class="ltx_text ltx_ref_tag">6</span></a> (b).</p>
</div></li>
<li id="A5.I1.i3" class="ltx_item" style="list-style-type:none;"><span class="ltx_tag ltx_tag_item">()</span> 
<div id="A5.I1.i3.p1" class="ltx_para">
<p id="A5.I1.i3.p1.1" class="ltx_p">For the task stream <math id="A5.I1.i3.p1.m1" class="ltx_Math" alttext="\mathcal{T}=\{\tau_{c},\tau_{b}\}" display="inline" intent=":literal"><semantics><mrow><mi class="ltx_font_mathcaligraphic">𝒯</mi><mo>=</mo><mrow><mo stretchy="false">{</mo><msub><mi>τ</mi><mi>c</mi></msub><mo>,</mo><msub><mi>τ</mi><mi>b</mi></msub><mo stretchy="false">}</mo></mrow></mrow><annotation encoding="application/x-tex">\mathcal{T}=\{\tau_{c},\tau_{b}\}</annotation></semantics></math>, we adopt a similar two-stage setup. The first stage involves training on the full clean dataset <math id="A5.I1.i3.p1.m2" class="ltx_Math" alttext="D_{c}" display="inline" intent=":literal"><semantics><msub><mi>D</mi><mi>c</mi></msub><annotation encoding="application/x-tex">D_{c}</annotation></semantics></math>
along with a small set of poisoned samples (10 instances, approximately 0.2% of <math id="A5.I1.i3.p1.m3" class="ltx_Math" alttext="D_{p}" display="inline" intent=":literal"><semantics><msub><mi>D</mi><mi>p</mi></msub><annotation encoding="application/x-tex">D_{p}</annotation></semantics></math>). These few samples are included only to approximate task independence
and have negligible impact on the overall results. In the second stage, the model is exposed to the full poisoned dataset <math id="A5.I1.i3.p1.m4" class="ltx_Math" alttext="D_{p}" display="inline" intent=":literal"><semantics><msub><mi>D</mi><mi>p</mi></msub><annotation encoding="application/x-tex">D_{p}</annotation></semantics></math> and 10% of the clean data,
continuing training until a total of 100 epochs is reached, as illustrated in Figure <a href="#A5.F6" title="Figure 6 ‣ E.1. Validating Assumption ‣ Appendix E Additional Experiments ‣ Rethinking Backdoor Adversarial Unlearning through the Lens of Catastrophic Forgetting in Continual Learning" class="ltx_ref"><span class="ltx_text ltx_ref_tag">6</span></a> (c).</p>
</div></li>
</ol>
</div>
<div id="A5.SS1.p3" class="ltx_para">
<p id="A5.SS1.p3.1" class="ltx_p">As shown in Figure <a href="#A5.F6" title="Figure 6 ‣ E.1. Validating Assumption ‣ Appendix E Additional Experiments ‣ Rethinking Backdoor Adversarial Unlearning through the Lens of Catastrophic Forgetting in Continual Learning" class="ltx_ref"><span class="ltx_text ltx_ref_tag">6</span></a> (a), in the standard backdoor learning setting, the backdoor is rapidly injected into the model, evidenced
by the attack success rate (ASR) peaking within the first 5 training epochs. Subsequently, the clean task <math id="A5.SS1.p3.m1" class="ltx_Math" alttext="\tau_{c}" display="inline" intent=":literal"><semantics><msub><mi>τ</mi><mi>c</mi></msub><annotation encoding="application/x-tex">\tau_{c}</annotation></semantics></math> is gradually learned as training progresses
until convergence, while the ASR remains nearly unchanged. This observation is consistent with the findings reported by <cite class="ltx_cite ltx_citemacro_citet"><a href="#bib.bib65" title="" class="ltx_ref">Zhang et al. (2024)</a></cite>.
In Figure <a href="#A5.F6" title="Figure 6 ‣ E.1. Validating Assumption ‣ Appendix E Additional Experiments ‣ Rethinking Backdoor Adversarial Unlearning through the Lens of Catastrophic Forgetting in Continual Learning" class="ltx_ref"><span class="ltx_text ltx_ref_tag">6</span></a> (b), we manually partition the dataset to further decouple the backdoor task <math id="A5.SS1.p3.m2" class="ltx_Math" alttext="\tau_{b}" display="inline" intent=":literal"><semantics><msub><mi>τ</mi><mi>b</mi></msub><annotation encoding="application/x-tex">\tau_{b}</annotation></semantics></math> and the clean task <math id="A5.SS1.p3.m3" class="ltx_Math" alttext="\tau_{c}" display="inline" intent=":literal"><semantics><msub><mi>τ</mi><mi>c</mi></msub><annotation encoding="application/x-tex">\tau_{c}</annotation></semantics></math>.
Following a two-stage learning procedure, we observe similar dynamics: the backdoor task is quickly learned in the initial phase, and upon switching to the clean task <math id="A5.SS1.p3.m4" class="ltx_Math" alttext="\tau_{c}" display="inline" intent=":literal"><semantics><msub><mi>τ</mi><mi>c</mi></msub><annotation encoding="application/x-tex">\tau_{c}</annotation></semantics></math>,
the clean accuracy (CA) gradually improves while the ASR remains stable. Finally, model achieves a comparable CA and ASR to that of the standard backdoor learning setup.
In contrast, Figure <a href="#A5.F6" title="Figure 6 ‣ E.1. Validating Assumption ‣ Appendix E Additional Experiments ‣ Rethinking Backdoor Adversarial Unlearning through the Lens of Catastrophic Forgetting in Continual Learning" class="ltx_ref"><span class="ltx_text ltx_ref_tag">6</span></a> (c) presents the reversed task stream <math id="A5.SS1.p3.m5" class="ltx_Math" alttext="\mathcal{T}=\{\tau_{c},\tau_{b}\}" display="inline" intent=":literal"><semantics><mrow><mi class="ltx_font_mathcaligraphic">𝒯</mi><mo>=</mo><mrow><mo stretchy="false">{</mo><msub><mi>τ</mi><mi>c</mi></msub><mo>,</mo><msub><mi>τ</mi><mi>b</mi></msub><mo stretchy="false">}</mo></mrow></mrow><annotation encoding="application/x-tex">\mathcal{T}=\{\tau_{c},\tau_{b}\}</annotation></semantics></math>, where the clean task <math id="A5.SS1.p3.m6" class="ltx_Math" alttext="\tau_{c}" display="inline" intent=":literal"><semantics><msub><mi>τ</mi><mi>c</mi></msub><annotation encoding="application/x-tex">\tau_{c}</annotation></semantics></math> is
gradually learned in the first stage, followed by a rapid acquisition of the backdoor task <math id="A5.SS1.p3.m7" class="ltx_Math" alttext="\tau_{b}" display="inline" intent=":literal"><semantics><msub><mi>τ</mi><mi>b</mi></msub><annotation encoding="application/x-tex">\tau_{b}</annotation></semantics></math>, without significant degradation in CA.
This again results in a similar convergence outcome, suggesting that tasks <math id="A5.SS1.p3.m8" class="ltx_Math" alttext="\tau_{b}" display="inline" intent=":literal"><semantics><msub><mi>τ</mi><mi>b</mi></msub><annotation encoding="application/x-tex">\tau_{b}</annotation></semantics></math> and <math id="A5.SS1.p3.m9" class="ltx_Math" alttext="\tau_{c}" display="inline" intent=":literal"><semantics><msub><mi>τ</mi><mi>c</mi></msub><annotation encoding="application/x-tex">\tau_{c}</annotation></semantics></math> can be interchanged without loss of generality,
further supporting the plausibility of Assumption <a href="#ThmAssumption1" title="Assumption 1. ‣ 4.1. Problem Formulation ‣ 4. Methodology ‣ Rethinking Backdoor Adversarial Unlearning through the Lens of Catastrophic Forgetting in Continual Learning" class="ltx_ref"><span class="ltx_text ltx_ref_tag">1</span></a>.</p>
</div>
<div id="A5.SS1.p4" class="ltx_para">
<p id="A5.SS1.p4.1" class="ltx_p">Overall, these experiments empirically validate that the clean and backdoor tasks can be modeled as a sequential task flow, supporting our continual learning
formulation for backdoor unlearning.</p>
</div>
<figure id="A5.T9" class="ltx_table">
<figcaption class="ltx_caption ltx_centering"><span class="ltx_tag ltx_tag_table"><span id="A5.T9.3" class="ltx_text" style="font-size:90%;">Table 9</span>. </span><span id="A5.T9.4" class="ltx_text" style="font-size:90%;">Performance (%) of safety tuning strategies for eliminating backdoor effects on the Tiny-ImageNet-200 dataset.</span></figcaption>
<div id="A5.T9.5" class="ltx_inline-block ltx_align_center ltx_transformed_outer" style="width:338.1pt;height:54.3pt;vertical-align:-26.3pt;"><span class="ltx_transformed_inner" style="transform:translate(-333.8pt,53.6pt) scale(0.336155521848408,0.336155521848408) ;">
<table id="A5.T9.5.1" class="ltx_tabular ltx_align_middle">
<tr id="A5.T9.5.1.1" class="ltx_tr">
<td id="A5.T9.5.1.1.1" class="ltx_td ltx_align_center ltx_border_r ltx_border_tt" style="padding-top:2.5pt;padding-bottom:2.5pt;">Attack <math id="A5.T9.m1" class="ltx_Math" alttext="\to" display="inline" intent=":literal"><semantics><mo stretchy="false">→</mo><annotation encoding="application/x-tex">\to</annotation></semantics></math></td>
<td id="A5.T9.5.1.1.2" class="ltx_td ltx_align_center ltx_border_r ltx_border_tt" style="padding-top:2.5pt;padding-bottom:2.5pt;" colspan="2">BadNets</td>
<td id="A5.T9.5.1.1.3" class="ltx_td ltx_align_center ltx_border_r ltx_border_tt" style="padding-top:2.5pt;padding-bottom:2.5pt;" colspan="2">Blended</td>
<td id="A5.T9.5.1.1.4" class="ltx_td ltx_align_center ltx_border_r ltx_border_tt" style="padding-top:2.5pt;padding-bottom:2.5pt;" colspan="2">WaNet</td>
<td id="A5.T9.5.1.1.5" class="ltx_td ltx_align_center ltx_border_r ltx_border_tt" style="padding-top:2.5pt;padding-bottom:2.5pt;" colspan="2">Refool</td>
<td id="A5.T9.5.1.1.6" class="ltx_td ltx_align_center ltx_border_r ltx_border_tt" style="padding-top:2.5pt;padding-bottom:2.5pt;" colspan="2">IAD</td>
<td id="A5.T9.5.1.1.7" class="ltx_td ltx_align_center ltx_border_r ltx_border_tt" style="padding-top:2.5pt;padding-bottom:2.5pt;" colspan="2">ISSBA</td>
<td id="A5.T9.5.1.1.8" class="ltx_td ltx_align_center ltx_border_r ltx_border_tt" style="padding-top:2.5pt;padding-bottom:2.5pt;" colspan="2">SIG</td>
<td id="A5.T9.5.1.1.9" class="ltx_td ltx_align_center ltx_border_r ltx_border_tt" style="padding-top:2.5pt;padding-bottom:2.5pt;" colspan="2">Narcissus</td>
<td id="A5.T9.5.1.1.10" class="ltx_td ltx_align_center ltx_border_tt" style="padding-top:2.5pt;padding-bottom:2.5pt;" colspan="2">Average</td></tr>
<tr id="A5.T9.5.1.2" class="ltx_tr">
<td id="A5.T9.5.1.2.1" class="ltx_td ltx_align_center ltx_border_r ltx_border_t" style="padding-top:2.5pt;padding-bottom:2.5pt;">Defense <math id="A5.T9.m2" class="ltx_Math" alttext="\downarrow" display="inline" intent=":literal"><semantics><mo stretchy="false">↓</mo><annotation encoding="application/x-tex">\downarrow</annotation></semantics></math></td>
<td id="A5.T9.5.1.2.2" class="ltx_td ltx_align_center ltx_border_t" style="padding-top:2.5pt;padding-bottom:2.5pt;">CA</td>
<td id="A5.T9.5.1.2.3" class="ltx_td ltx_align_center ltx_border_r ltx_border_t" style="padding-top:2.5pt;padding-bottom:2.5pt;">ASR</td>
