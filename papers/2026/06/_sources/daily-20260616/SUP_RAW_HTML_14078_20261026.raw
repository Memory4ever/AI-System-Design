<div id="S5.T4.5.1.8.3.1" class="ltx_inline-block ltx_transformed_outer" style="width:27.8pt;height:6.4pt;vertical-align:-0.0pt;"><span class="ltx_transformed_inner" style="transform:translate(0.0pt,0.0pt) scale(1.0,1.0) ;">
