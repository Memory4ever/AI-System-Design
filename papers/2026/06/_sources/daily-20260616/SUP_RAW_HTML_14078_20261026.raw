<div id="S5.T2.5.1.21.9.1" class="ltx_inline-block ltx_transformed_outer" style="width:17.8pt;height:6.4pt;vertical-align:-0.0pt;"><span class="ltx_transformed_inner" style="transform:translate(0.0pt,0.0pt) scale(1.0,1.0) ;">
<p id="S5.T2.5.1.21.9.1.1" class="ltx_p"><span id="S5.T2.5.1.21.9.1.1.1" class="ltx_text" style="--ltx-bg-color:#D9F2D9;">4.90</span></p>
</span></div>/
<div id="S5.T2.5.1.21.9.2" class="ltx_inline-block ltx_transformed_outer" style="width:17.8pt;height:6.4pt;vertical-align:-0.0pt;"><span class="ltx_transformed_inner" style="transform:translate(0.0pt,0.0pt) scale(1.0,1.0) ;">
