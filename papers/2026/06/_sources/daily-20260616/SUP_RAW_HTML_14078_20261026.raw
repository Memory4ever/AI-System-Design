</span></div></td>
<td id="S5.T4.5.1.8.4" class="ltx_td ltx_align_center ltx_border_r ltx_border_t" style="padding-top:2.5pt;padding-bottom:2.5pt;">0.1765</td>
<td id="S5.T4.5.1.8.5" class="ltx_td ltx_align_center ltx_border_r ltx_border_t" style="padding-top:2.5pt;padding-bottom:2.5pt;">0.1018</td>
<td id="S5.T4.5.1.8.6" class="ltx_td ltx_align_center ltx_border_r ltx_border_t" style="padding-top:2.5pt;padding-bottom:2.5pt;">0.1074</td>
<td id="S5.T4.5.1.8.7" class="ltx_td ltx_align_center ltx_border_r ltx_border_t" style="padding-top:2.5pt;padding-bottom:2.5pt;">0.0365</td>
<td id="S5.T4.5.1.8.8" class="ltx_td ltx_align_center ltx_border_t" style="padding-top:2.5pt;padding-bottom:2.5pt;">0.0976</td></tr>
<tr id="S5.T4.5.1.9" class="ltx_tr">
<td id="S5.T4.5.1.9.1" class="ltx_td ltx_align_center ltx_border_bb ltx_border_r ltx_border_t" style="padding-top:2.5pt;padding-bottom:2.5pt;">BI-BAU (U)</td>
<td id="S5.T4.5.1.9.2" class="ltx_td ltx_align_center ltx_border_bb ltx_border_r ltx_border_t" style="padding-top:2.5pt;padding-bottom:2.5pt;">
<div id="S5.T4.5.1.9.2.1" class="ltx_inline-block ltx_transformed_outer" style="width:27.8pt;height:6.4pt;vertical-align:-0.0pt;"><span class="ltx_transformed_inner" style="transform:translate(0.0pt,0.0pt) scale(1.0,1.0) ;">
<p id="S5.T4.5.1.9.2.1.1" class="ltx_p"><span id="S5.T4.5.1.9.2.1.1.1" class="ltx_text" style="--ltx-bg-color:#D9F2D9;">0.1501</span></p>
</span></div></td>
