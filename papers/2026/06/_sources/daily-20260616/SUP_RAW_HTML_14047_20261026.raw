<section id="A1" class="ltx_appendix">
<h2 class="ltx_title ltx_title_appendix"><span class="ltx_tag ltx_tag_appendix">Appendix A </span>Algorithmic Details</h2>

<div id="A1.p1" class="ltx_para">
<p id="A1.p1.1" class="ltx_p">This appendix provides algorithmic descriptions of the key KGERMAR components referenced in the main paper.</p>
</div>
<section id="A1.SS1" class="ltx_subsection">
<h3 class="ltx_title ltx_title_subsection"><span class="ltx_tag ltx_tag_subsection">A.1 </span>Contextual Knowledge Graph Construction</h3>

<figure id="alg1" class="ltx_float ltx_float_algorithm ltx_framed ltx_framed_top">
<figcaption class="ltx_caption"><span class="ltx_tag ltx_tag_float"><span id="alg1.3" class="ltx_text ltx_font_bold">Algorithm 1</span> </span> Contextual Knowledge Graph Construction</figcaption>
<div id="alg1.4" class="ltx_listing ltx_framed ltx_framed_topbottom ltx_listing">
<div id="alg1.l1" class="ltx_listingline">
              <span class="ltx_tag ltx_tag_listingline">1:</span>
              
              
            Context <math id="alg1.l1.m1" class="ltx_Math" alttext="d_{i}" display="inline" intent=":literal"><semantics><msub><mi>d</mi><mi>i</mi></msub><annotation encoding="application/x-tex">d_{i}</annotation></semantics></math>, NER model <math id="alg1.l1.m2" class="ltx_Math" alttext="\mathcal{F}_{e}" display="inline" intent=":literal"><semantics><msub><mi class="ltx_font_mathcaligraphic">ℱ</mi><mi>e</mi></msub><annotation encoding="application/x-tex">\mathcal{F}_{e}</annotation></semantics></math>, Relation model <math id="alg1.l1.m3" class="ltx_Math" alttext="\mathcal{F}_{r}" display="inline" intent=":literal"><semantics><msub><mi class="ltx_font_mathcaligraphic">ℱ</mi><mi>r</mi></msub><annotation encoding="application/x-tex">\mathcal{F}_{r}</annotation></semantics></math>

</div>
<div id="alg1.l2" class="ltx_listingline">
              <span class="ltx_tag ltx_tag_listingline">2:</span>
              
              
            Context window size <math id="alg1.l2.m1" class="ltx_Math" alttext="W" display="inline" intent=":literal"><semantics><mi>W</mi><annotation encoding="application/x-tex">W</annotation></semantics></math>, Confidence thresholds <math id="alg1.l2.m2" class="ltx_Math" alttext="\theta_{min},\theta_{conf}" display="inline" intent=":literal"><semantics><mrow><msub><mi>θ</mi><mrow><mi>m</mi><mo lspace="0em" rspace="0em">​</mo><mi>i</mi><mo lspace="0em" rspace="0em">​</mo><mi>n</mi></mrow></msub><mo>,</mo><msub><mi>θ</mi><mrow><mi>c</mi><mo lspace="0em" rspace="0em">​</mo><mi>o</mi><mo lspace="0em" rspace="0em">​</mo><mi>n</mi><mo lspace="0em" rspace="0em">​</mo><mi>f</mi></mrow></msub></mrow><annotation encoding="application/x-tex">\theta_{min},\theta_{conf}</annotation></semantics></math>

</div>
<div id="alg1.l3" class="ltx_listingline">
              <span class="ltx_tag ltx_tag_listingline">3:</span>
              
              
            Knowledge graph <math id="alg1.l3.m1" class="ltx_Math" alttext="\mathcal{G}_{i}=(\mathcal{E}_{i},\mathcal{R},\mathcal{T}_{i})" display="inline" intent=":literal"><semantics><mrow><msub><mi class="ltx_font_mathcaligraphic">𝒢</mi><mi>i</mi></msub><mo>=</mo><mrow><mo stretchy="false">(</mo><msub><mi class="ltx_font_mathcaligraphic">ℰ</mi><mi>i</mi></msub><mo>,</mo><mi class="ltx_font_mathcaligraphic">ℛ</mi><mo>,</mo><msub><mi class="ltx_font_mathcaligraphic">𝒯</mi><mi>i</mi></msub><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">\mathcal{G}_{i}=(\mathcal{E}_{i},\mathcal{R},\mathcal{T}_{i})</annotation></semantics></math>

</div>
<div id="alg1.l4" class="ltx_listingline">
              <span class="ltx_tag ltx_tag_listingline">4:</span>
              
              
            <math id="alg1.l4.m1" class="ltx_Math" alttext="\mathcal{E}_{raw}\leftarrow\mathcal{F}_{e}(d_{i})" display="inline" intent=":literal"><semantics><mrow><msub><mi class="ltx_font_mathcaligraphic">ℰ</mi><mrow><mi>r</mi><mo lspace="0em" rspace="0em">​</mo><mi>a</mi><mo lspace="0em" rspace="0em">​</mo><mi>w</mi></mrow></msub><mo stretchy="false">←</mo><mrow><msub><mi class="ltx_font_mathcaligraphic">ℱ</mi><mi>e</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mi>d</mi><mi>i</mi></msub><mo stretchy="false">)</mo></mrow></mrow></mrow><annotation encoding="application/x-tex">\mathcal{E}_{raw}\leftarrow\mathcal{F}_{e}(d_{i})</annotation></semantics></math> <span id="alg1.l4.2" class="ltx_text" style="float:right;"><math id="alg1.l4.m2" class="ltx_Math" alttext="\triangleright" display="inline" intent=":literal"><semantics><mo>⊳</mo><annotation encoding="application/x-tex">\triangleright</annotation></semantics></math> Extract raw entities with positions
</span>
</div>
<div id="alg1.l5" class="ltx_listingline">
              <span class="ltx_tag ltx_tag_listingline">5:</span>
              
              
            <math id="alg1.l5.m1" class="ltx_Math" alttext="\mathcal{E}_{i}\leftarrow\text{consolidate}(\mathcal{E}_{raw})" display="inline" intent=":literal"><semantics><mrow><msub><mi class="ltx_font_mathcaligraphic">ℰ</mi><mi>i</mi></msub><mo stretchy="false">←</mo><mrow><mtext>consolidate</mtext><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mi class="ltx_font_mathcaligraphic">ℰ</mi><mrow><mi>r</mi><mo lspace="0em" rspace="0em">​</mo><mi>a</mi><mo lspace="0em" rspace="0em">​</mo><mi>w</mi></mrow></msub><mo stretchy="false">)</mo></mrow></mrow></mrow><annotation encoding="application/x-tex">\mathcal{E}_{i}\leftarrow\text{consolidate}(\mathcal{E}_{raw})</annotation></semantics></math> <span id="alg1.l5.2" class="ltx_text" style="float:right;"><math id="alg1.l5.m2" class="ltx_Math" alttext="\triangleright" display="inline" intent=":literal"><semantics><mo>⊳</mo><annotation encoding="application/x-tex">\triangleright</annotation></semantics></math> Merge similar entities
</span>
</div>
<div id="alg1.l6" class="ltx_listingline">
              <span class="ltx_tag ltx_tag_listingline">6:</span>
              
              
            <math id="alg1.l6.m1" class="ltx_Math" alttext="\mathcal{T}_{i}\leftarrow\emptyset" display="inline" intent=":literal"><semantics><mrow><msub><mi class="ltx_font_mathcaligraphic">𝒯</mi><mi>i</mi></msub><mo stretchy="false">←</mo><mi mathvariant="normal">∅</mi></mrow><annotation encoding="application/x-tex">\mathcal{T}_{i}\leftarrow\emptyset</annotation></semantics></math> <span id="alg1.l6.2" class="ltx_text" style="float:right;"><math id="alg1.l6.m2" class="ltx_Math" alttext="\triangleright" display="inline" intent=":literal"><semantics><mo>⊳</mo><annotation encoding="application/x-tex">\triangleright</annotation></semantics></math> Initialize triple set
</span>
</div>
<div id="alg1.l7" class="ltx_listingline">
              <span class="ltx_tag ltx_tag_listingline">7:</span>
              
              
            <span id="alg1.l7.2" class="ltx_text ltx_font_bold">for</span> <math id="alg1.l7.m1" class="ltx_Math" alttext="(e_{h},e_{t})\in\mathcal{E}_{i}\times\mathcal{E}_{i}" display="inline" intent=":literal"><semantics><mrow><mrow><mo stretchy="false">(</mo><msub><mi>e</mi><mi>h</mi></msub><mo>,</mo><msub><mi>e</mi><mi>t</mi></msub><mo stretchy="false">)</mo></mrow><mo>∈</mo><mrow><msub><mi class="ltx_font_mathcaligraphic">ℰ</mi><mi>i</mi></msub><mo lspace="0.222em" rspace="0.222em">×</mo><msub><mi class="ltx_font_mathcaligraphic">ℰ</mi><mi>i</mi></msub></mrow></mrow><annotation encoding="application/x-tex">(e_{h},e_{t})\in\mathcal{E}_{i}\times\mathcal{E}_{i}</annotation></semantics></math> where <math id="alg1.l7.m2" class="ltx_Math" alttext="e_{h}\neq e_{t}" display="inline" intent=":literal"><semantics><mrow><msub><mi>e</mi><mi>h</mi></msub><mo>≠</mo><msub><mi>e</mi><mi>t</mi></msub></mrow><annotation encoding="application/x-tex">e_{h}\neq e_{t}</annotation></semantics></math> <span id="alg1.l7.3" class="ltx_text ltx_font_bold">do</span>

</div>
<div id="alg1.l8" class="ltx_listingline">
              <span class="ltx_tag ltx_tag_listingline">8:</span>
              
              
              <span id="alg1.l8.2" class="ltx_text ltx_font_bold">if</span> <math id="alg1.l8.m1" class="ltx_Math" alttext="\text{distance}(e_{h},e_{t})\leq W" display="inline" intent=":literal"><semantics><mrow><mrow><mtext>distance</mtext><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mi>e</mi><mi>h</mi></msub><mo>,</mo><msub><mi>e</mi><mi>t</mi></msub><mo stretchy="false">)</mo></mrow></mrow><mo>≤</mo><mi>W</mi></mrow><annotation encoding="application/x-tex">\text{distance}(e_{h},e_{t})\leq W</annotation></semantics></math> <span id="alg1.l8.3" class="ltx_text ltx_font_bold">then</span> <span id="alg1.l8.4" class="ltx_text" style="float:right;"><math id="alg1.l8.m2" class="ltx_Math" alttext="\triangleright" display="inline" intent=":literal"><semantics><mo>⊳</mo><annotation encoding="application/x-tex">\triangleright</annotation></semantics></math> Within context window
</span>
</div>
<div id="alg1.l9" class="ltx_listingline">
              <span class="ltx_tag ltx_tag_listingline">9:</span>
              
              
               <math id="alg1.l9.m1" class="ltx_Math" alttext="\text{context}\leftarrow\text{extract\_context}_{W}(e_{h},e_{t},d_{i})" display="inline" intent=":literal"><semantics><mrow><mtext>context</mtext><mo stretchy="false">←</mo><mrow><msub><mtext>extract_context</mtext><mi>W</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mi>e</mi><mi>h</mi></msub><mo>,</mo><msub><mi>e</mi><mi>t</mi></msub><mo>,</mo><msub><mi>d</mi><mi>i</mi></msub><mo stretchy="false">)</mo></mrow></mrow></mrow><annotation encoding="application/x-tex">\text{context}\leftarrow\text{extract\_context}_{W}(e_{h},e_{t},d_{i})</annotation></semantics></math>

</div>
<div id="alg1.l10" class="ltx_listingline">
              <span class="ltx_tag ltx_tag_listingline">10:</span>
              
              
               <math id="alg1.l10.m1" class="ltx_Math" alttext="r\leftarrow\mathcal{F}_{r}(e_{h},e_{t},\text{context})" display="inline" intent=":literal"><semantics><mrow><mi>r</mi><mo stretchy="false">←</mo><mrow><msub><mi class="ltx_font_mathcaligraphic">ℱ</mi><mi>r</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mi>e</mi><mi>h</mi></msub><mo>,</mo><msub><mi>e</mi><mi>t</mi></msub><mo>,</mo><mtext>context</mtext><mo stretchy="false">)</mo></mrow></mrow></mrow><annotation encoding="application/x-tex">r\leftarrow\mathcal{F}_{r}(e_{h},e_{t},\text{context})</annotation></semantics></math> <span id="alg1.l10.2" class="ltx_text" style="float:right;"><math id="alg1.l10.m2" class="ltx_Math" alttext="\triangleright" display="inline" intent=":literal"><semantics><mo>⊳</mo><annotation encoding="application/x-tex">\triangleright</annotation></semantics></math> Predict relation
</span>
</div>
<div id="alg1.l11" class="ltx_listingline">
              <span class="ltx_tag ltx_tag_listingline">11:</span>
              
              
               <math id="alg1.l11.m1" class="ltx_Math" alttext="\text{conf}\leftarrow\text{confidence}(\mathcal{F}_{r},e_{h},r,e_{t})" display="inline" intent=":literal"><semantics><mrow><mtext>conf</mtext><mo stretchy="false">←</mo><mrow><mtext>confidence</mtext><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mi class="ltx_font_mathcaligraphic">ℱ</mi><mi>r</mi></msub><mo>,</mo><msub><mi>e</mi><mi>h</mi></msub><mo>,</mo><mi>r</mi><mo>,</mo><msub><mi>e</mi><mi>t</mi></msub><mo stretchy="false">)</mo></mrow></mrow></mrow><annotation encoding="application/x-tex">\text{conf}\leftarrow\text{confidence}(\mathcal{F}_{r},e_{h},r,e_{t})</annotation></semantics></math>

</div>
<div id="alg1.l12" class="ltx_listingline">
              <span class="ltx_tag ltx_tag_listingline">12:</span>
              
              
               <span id="alg1.l12.2" class="ltx_text ltx_font_bold">if</span> <math id="alg1.l12.m1" class="ltx_Math" alttext="r\neq\emptyset" display="inline" intent=":literal"><semantics><mrow><mi>r</mi><mo>≠</mo><mi mathvariant="normal">∅</mi></mrow><annotation encoding="application/x-tex">r\neq\emptyset</annotation></semantics></math> and <math id="alg1.l12.m2" class="ltx_Math" alttext="\text{conf}&gt;\theta_{min}" display="inline" intent=":literal"><semantics><mrow><mtext>conf</mtext><mo>&gt;</mo><msub><mi>θ</mi><mrow><mi>m</mi><mo lspace="0em" rspace="0em">​</mo><mi>i</mi><mo lspace="0em" rspace="0em">​</mo><mi>n</mi></mrow></msub></mrow><annotation encoding="application/x-tex">\text{conf}&gt;\theta_{min}</annotation></semantics></math> <span id="alg1.l12.3" class="ltx_text ltx_font_bold">then</span>

</div>
<div id="alg1.l13" class="ltx_listingline">
              <span class="ltx_tag ltx_tag_listingline">13:</span>
              
              
                 <math id="alg1.l13.m1" class="ltx_Math" alttext="w\leftarrow\alpha\cdot\text{conf}+(1-\alpha)\cdot\text{freq\_score}(e_{h},r,e_{t})" display="inline" intent=":literal"><semantics><mrow><mi>w</mi><mo stretchy="false">←</mo><mrow><mrow><mi>α</mi><mo lspace="0.222em" rspace="0.222em">⋅</mo><mtext>conf</mtext></mrow><mo>+</mo><mrow><mrow><mrow><mo stretchy="false">(</mo><mrow><mn>1</mn><mo>−</mo><mi>α</mi></mrow><mo rspace="0.055em" stretchy="false">)</mo></mrow><mo rspace="0.222em">⋅</mo><mtext>freq_score</mtext></mrow><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mi>e</mi><mi>h</mi></msub><mo>,</mo><mi>r</mi><mo>,</mo><msub><mi>e</mi><mi>t</mi></msub><mo stretchy="false">)</mo></mrow></mrow></mrow></mrow><annotation encoding="application/x-tex">w\leftarrow\alpha\cdot\text{conf}+(1-\alpha)\cdot\text{freq\_score}(e_{h},r,e_{t})</annotation></semantics></math>

</div>
<div id="alg1.l14" class="ltx_listingline">
              <span class="ltx_tag ltx_tag_listingline">14:</span>
              
              
                 <math id="alg1.l14.m1" class="ltx_Math" alttext="\mathcal{T}_{i}\leftarrow\mathcal{T}_{i}\cup\{(e_{h},r,e_{t},w)\}" display="inline" intent=":literal"><semantics><mrow><msub><mi class="ltx_font_mathcaligraphic">𝒯</mi><mi>i</mi></msub><mo stretchy="false">←</mo><mrow><msub><mi class="ltx_font_mathcaligraphic">𝒯</mi><mi>i</mi></msub><mo>∪</mo><mrow><mo stretchy="false">{</mo><mrow><mo stretchy="false">(</mo><msub><mi>e</mi><mi>h</mi></msub><mo>,</mo><mi>r</mi><mo>,</mo><msub><mi>e</mi><mi>t</mi></msub><mo>,</mo><mi>w</mi><mo stretchy="false">)</mo></mrow><mo stretchy="false">}</mo></mrow></mrow></mrow><annotation encoding="application/x-tex">\mathcal{T}_{i}\leftarrow\mathcal{T}_{i}\cup\{(e_{h},r,e_{t},w)\}</annotation></semantics></math>

</div>
<div id="alg1.l15" class="ltx_listingline">
              <span class="ltx_tag ltx_tag_listingline">15:</span>
              
              
               <span id="alg1.l15.2" class="ltx_text ltx_font_bold">end</span> <span id="alg1.l15.3" class="ltx_text ltx_font_bold">if</span>
</div>
<div id="alg1.l16" class="ltx_listingline">
              <span class="ltx_tag ltx_tag_listingline">16:</span>
              
              
              <span id="alg1.l16.2" class="ltx_text ltx_font_bold">end</span> <span id="alg1.l16.3" class="ltx_text ltx_font_bold">if</span>
</div>
<div id="alg1.l17" class="ltx_listingline">
              <span class="ltx_tag ltx_tag_listingline">17:</span>
              
              
            <span id="alg1.l17.2" class="ltx_text ltx_font_bold">end</span> <span id="alg1.l17.3" class="ltx_text ltx_font_bold">for</span>
</div>
<div id="alg1.l18" class="ltx_listingline">
              <span class="ltx_tag ltx_tag_listingline">18:</span>
              
              
            <math id="alg1.l18.m1" class="ltx_Math" alttext="\mathcal{T}_{i}\leftarrow\{(h,r,t,w)\in\mathcal{T}_{i}:w&gt;\theta_{conf}\}" display="inline" intent=":literal"><semantics><mrow><msub><mi class="ltx_font_mathcaligraphic">𝒯</mi><mi>i</mi></msub><mo stretchy="false">←</mo><mrow><mo stretchy="false">{</mo><mrow><mrow><mo stretchy="false">(</mo><mi>h</mi><mo>,</mo><mi>r</mi><mo>,</mo><mi>t</mi><mo>,</mo><mi>w</mi><mo stretchy="false">)</mo></mrow><mo>∈</mo><msub><mi class="ltx_font_mathcaligraphic">𝒯</mi><mi>i</mi></msub></mrow><mo lspace="0.278em" rspace="0.278em">:</mo><mrow><mi>w</mi><mo>&gt;</mo><msub><mi>θ</mi><mrow><mi>c</mi><mo lspace="0em" rspace="0em">​</mo><mi>o</mi><mo lspace="0em" rspace="0em">​</mo><mi>n</mi><mo lspace="0em" rspace="0em">​</mo><mi>f</mi></mrow></msub></mrow><mo stretchy="false">}</mo></mrow></mrow><annotation encoding="application/x-tex">\mathcal{T}_{i}\leftarrow\{(h,r,t,w)\in\mathcal{T}_{i}:w&gt;\theta_{conf}\}</annotation></semantics></math> <span id="alg1.l18.2" class="ltx_text" style="float:right;"><math id="alg1.l18.m2" class="ltx_Math" alttext="\triangleright" display="inline" intent=":literal"><semantics><mo>⊳</mo><annotation encoding="application/x-tex">\triangleright</annotation></semantics></math> Filter by confidence
<span id="alg1.l18.2.1" class="ltx_text ltx_font_bold">return</span> <math id="alg1.l18.m3" class="ltx_Math" alttext="\mathcal{G}_{i}=(\mathcal{E}_{i},\mathcal{R},\mathcal{T}_{i})" display="inline" intent=":literal"><semantics><mrow><msub><mi class="ltx_font_mathcaligraphic">𝒢</mi><mi>i</mi></msub><mo>=</mo><mrow><mo stretchy="false">(</mo><msub><mi class="ltx_font_mathcaligraphic">ℰ</mi><mi>i</mi></msub><mo>,</mo><mi class="ltx_font_mathcaligraphic">ℛ</mi><mo>,</mo><msub><mi class="ltx_font_mathcaligraphic">𝒯</mi><mi>i</mi></msub><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">\mathcal{G}_{i}=(\mathcal{E}_{i},\mathcal{R},\mathcal{T}_{i})</annotation></semantics></math>
</span>
</div>
</div>
</figure>
</section>
<section id="A1.SS2" class="ltx_subsection">
<h3 class="ltx_title ltx_title_subsection"><span class="ltx_tag ltx_tag_subsection">A.2 </span>Multi-Modal Retrieval</h3>

<div id="A1.SS2.p1" class="ltx_para">
<p id="A1.SS2.p1.1" class="ltx_p">The pseudo is depicted in Algorithm <a href="#alg2" title="Algorithm 2 ‣ A.2 Multi-Modal Retrieval ‣ Appendix A Algorithmic Details ‣ Knowledge Graph Enhanced Memory-Augmented Retrieval for Long Context Modeling" class="ltx_ref"><span class="ltx_text ltx_ref_tag">2</span></a>.</p>
</div>
<figure id="alg2" class="ltx_float ltx_float_algorithm ltx_framed ltx_framed_top">
<figcaption class="ltx_caption"><span class="ltx_tag ltx_tag_float"><span id="alg2.3" class="ltx_text ltx_font_bold">Algorithm 2</span> </span> Multi-Modal Retrieval</figcaption>
<div id="alg2.4" class="ltx_listing ltx_framed ltx_framed_topbottom ltx_listing">
<div id="alg2.l1" class="ltx_listingline">
              <span class="ltx_tag ltx_tag_listingline">1:</span>
              
              
            Query <math id="alg2.l1.m1" class="ltx_Math" alttext="q" display="inline" intent=":literal"><semantics><mi>q</mi><annotation encoding="application/x-tex">q</annotation></semantics></math>, Memory banks <math id="alg2.l1.m2" class="ltx_Math" alttext="(\mathcal{M}_{ctx},\mathcal{M}_{sem},\mathcal{M}_{kg})" display="inline" intent=":literal"><semantics><mrow><mo stretchy="false">(</mo><msub><mi class="ltx_font_mathcaligraphic">ℳ</mi><mrow><mi>c</mi><mo lspace="0em" rspace="0em">​</mo><mi>t</mi><mo lspace="0em" rspace="0em">​</mo><mi>x</mi></mrow></msub><mo>,</mo><msub><mi class="ltx_font_mathcaligraphic">ℳ</mi><mrow><mi>s</mi><mo lspace="0em" rspace="0em">​</mo><mi>e</mi><mo lspace="0em" rspace="0em">​</mo><mi>m</mi></mrow></msub><mo>,</mo><msub><mi class="ltx_font_mathcaligraphic">ℳ</mi><mrow><mi>k</mi><mo lspace="0em" rspace="0em">​</mo><mi>g</mi></mrow></msub><mo stretchy="false">)</mo></mrow><annotation encoding="application/x-tex">(\mathcal{M}_{ctx},\mathcal{M}_{sem},\mathcal{M}_{kg})</annotation></semantics></math>

</div>
<div id="alg2.l2" class="ltx_listingline">
              <span class="ltx_tag ltx_tag_listingline">2:</span>
              
              
            Retrieval budget <math id="alg2.l2.m1" class="ltx_Math" alttext="K" display="inline" intent=":literal"><semantics><mi>K</mi><annotation encoding="application/x-tex">K</annotation></semantics></math>, Fusion weights <math id="alg2.l2.m2" class="ltx_Math" alttext="\{\lambda_{1},\lambda_{2},\lambda_{3}\}" display="inline" intent=":literal"><semantics><mrow><mo stretchy="false">{</mo><msub><mi>λ</mi><mn>1</mn></msub><mo>,</mo><msub><mi>λ</mi><mn>2</mn></msub><mo>,</mo><msub><mi>λ</mi><mn>3</mn></msub><mo stretchy="false">}</mo></mrow><annotation encoding="application/x-tex">\{\lambda_{1},\lambda_{2},\lambda_{3}\}</annotation></semantics></math>

</div>
<div id="alg2.l3" class="ltx_listingline">
              <span class="ltx_tag ltx_tag_listingline">3:</span>
              
              
            Retrieved contexts <math id="alg2.l3.m1" class="ltx_Math" alttext="\mathcal{R}" display="inline" intent=":literal"><semantics><mi class="ltx_font_mathcaligraphic">ℛ</mi><annotation encoding="application/x-tex">\mathcal{R}</annotation></semantics></math>

</div>
<div id="alg2.l4" class="ltx_listingline">
              <span class="ltx_tag ltx_tag_listingline">4:</span>
              
              
            <math id="alg2.l4.m1" class="ltx_Math" alttext="\mathbf{q}_{embed}\leftarrow\text{Embed}(q)" display="inline" intent=":literal"><semantics><mrow><msub><mi>𝐪</mi><mrow><mi>e</mi><mo lspace="0em" rspace="0em">​</mo><mi>m</mi><mo lspace="0em" rspace="0em">​</mo><mi>b</mi><mo lspace="0em" rspace="0em">​</mo><mi>e</mi><mo lspace="0em" rspace="0em">​</mo><mi>d</mi></mrow></msub><mo stretchy="false">←</mo><mrow><mtext>Embed</mtext><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>q</mi><mo stretchy="false">)</mo></mrow></mrow></mrow><annotation encoding="application/x-tex">\mathbf{q}_{embed}\leftarrow\text{Embed}(q)</annotation></semantics></math> <span id="alg2.l4.2" class="ltx_text" style="float:right;"><math id="alg2.l4.m2" class="ltx_Math" alttext="\triangleright" display="inline" intent=":literal"><semantics><mo>⊳</mo><annotation encoding="application/x-tex">\triangleright</annotation></semantics></math> Encode query
</span>
</div>
<div id="alg2.l5" class="ltx_listingline">
              <span class="ltx_tag ltx_tag_listingline">5:</span>
              
              
            <span id="alg2.l5.2" class="ltx_text ltx_font_bold">// Parallel retrieval from each memory bank</span>

</div>
<div id="alg2.l6" class="ltx_listingline">
              <span class="ltx_tag ltx_tag_listingline">6:</span>
              
              
