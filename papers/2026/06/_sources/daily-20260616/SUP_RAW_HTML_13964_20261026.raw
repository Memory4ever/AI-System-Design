             <math id="alg1.l25.m1" class="ltx_Math" alttext="\tilde{\epsilon}_{t}\leftarrow\hat{\epsilon}_{t}" display="inline" intent=":literal"><semantics><mrow><msub><mover accent="true"><mi>ϵ</mi><mo>~</mo></mover><mi>t</mi></msub><mo stretchy="false">←</mo><msub><mover accent="true"><mi>ϵ</mi><mo>^</mo></mover><mi>t</mi></msub></mrow><annotation encoding="application/x-tex">\tilde{\epsilon}_{t}\leftarrow\hat{\epsilon}_{t}</annotation></semantics></math>

</div>
<div id="alg1.l26" class="ltx_listingline">
            
            
            <span id="alg1.l26.2" class="ltx_text ltx_font_bold">end</span> <span id="alg1.l26.3" class="ltx_text ltx_font_bold">if</span>
</div>
<div id="alg1.l27" class="ltx_listingline">
            
            
            <math id="alg1.l27.m1" class="ltx_Math" alttext="\hat{z}_{t-1}\leftarrow\sqrt{\bar{\alpha}_{t-1}}\frac{\hat{z}_{t}-\sqrt{1-\bar{\alpha}_{t}}\,\tilde{\epsilon}_{t}}{\sqrt{\bar{\alpha}_{t}}}+\sqrt{1-\bar{\alpha}_{t-1}}\,\tilde{\epsilon}_{t}" display="inline" intent=":literal"><semantics><mrow><msub><mover accent="true"><mi>z</mi><mo>^</mo></mover><mrow><mi>t</mi><mo>−</mo><mn>1</mn></mrow></msub><mo stretchy="false">←</mo><mrow><mrow><msqrt><msub><mover accent="true"><mi>α</mi><mo>¯</mo></mover><mrow><mi>t</mi><mo>−</mo><mn>1</mn></mrow></msub></msqrt><mo lspace="0em" rspace="0em">​</mo><mfrac><mrow><msub><mover accent="true"><mi>z</mi><mo>^</mo></mover><mi>t</mi></msub><mo>−</mo><mrow><msqrt><mrow><mn>1</mn><mo>−</mo><msub><mover accent="true"><mi>α</mi><mo>¯</mo></mover><mi>t</mi></msub></mrow></msqrt><mo lspace="0.170em" rspace="0em">​</mo><msub><mover accent="true"><mi>ϵ</mi><mo>~</mo></mover><mi>t</mi></msub></mrow></mrow><msqrt><msub><mover accent="true"><mi>α</mi><mo>¯</mo></mover><mi>t</mi></msub></msqrt></mfrac></mrow><mo>+</mo><mrow><msqrt><mrow><mn>1</mn><mo>−</mo><msub><mover accent="true"><mi>α</mi><mo>¯</mo></mover><mrow><mi>t</mi><mo>−</mo><mn>1</mn></mrow></msub></mrow></msqrt><mo lspace="0.170em" rspace="0em">​</mo><msub><mover accent="true"><mi>ϵ</mi><mo>~</mo></mover><mi>t</mi></msub></mrow></mrow></mrow><annotation encoding="application/x-tex">\hat{z}_{t-1}\leftarrow\sqrt{\bar{\alpha}_{t-1}}\frac{\hat{z}_{t}-\sqrt{1-\bar{\alpha}_{t}}\,\tilde{\epsilon}_{t}}{\sqrt{\bar{\alpha}_{t}}}+\sqrt{1-\bar{\alpha}_{t-1}}\,\tilde{\epsilon}_{t}</annotation></semantics></math>
{DDIM Sampling}

</div>
<div id="alg1.l28" class="ltx_listingline">
            
            
           <span id="alg1.l28.2" class="ltx_text ltx_font_bold">end</span> <span id="alg1.l28.3" class="ltx_text ltx_font_bold">for</span>
</div>
<div id="alg1.l29" class="ltx_listingline">
            
            
           <math id="alg1.l29.m1" class="ltx_Math" alttext="\hat{x}_{0}\leftarrow D(\hat{z}_{0})" display="inline" intent=":literal"><semantics><mrow><msub><mover accent="true"><mi>x</mi><mo>^</mo></mover><mn>0</mn></msub><mo stretchy="false">←</mo><mrow><mi>D</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><msub><mover accent="true"><mi>z</mi><mo>^</mo></mover><mn>0</mn></msub><mo stretchy="false">)</mo></mrow></mrow></mrow><annotation encoding="application/x-tex">\hat{x}_{0}\leftarrow D(\hat{z}_{0})</annotation></semantics></math>

</div>
