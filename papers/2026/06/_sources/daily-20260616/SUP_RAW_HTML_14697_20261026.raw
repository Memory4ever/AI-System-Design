<td id="S4.T2.14.1.1.2" class="ltx_td ltx_nopad_l ltx_nopad_r ltx_align_center ltx_align_middle ltx_border_r ltx_border_tt" style="padding:0.75pt 0.5pt;" colspan="4"><span id="S4.T2.14.1.1.2.1" class="ltx_text" style="font-size:90%;">VQA-RAD</span></td>
<td id="S4.T2.14.1.1.3" class="ltx_td ltx_nopad_l ltx_nopad_r ltx_align_center ltx_align_middle ltx_border_r ltx_border_tt" style="padding:0.75pt 0.5pt;" colspan="4"><span id="S4.T2.14.1.1.3.1" class="ltx_text" style="font-size:90%;">PathVQA</span></td>
<td id="S4.T2.14.1.1.4" class="ltx_td ltx_nopad_l ltx_nopad_r ltx_align_center ltx_align_middle ltx_border_r ltx_border_tt" style="padding:0.75pt 0.5pt;" colspan="4"><span id="S4.T2.14.1.1.4.1" class="ltx_text" style="font-size:90%;">MedFrameQA</span></td>
<td id="S4.T2.14.1.1.5" class="ltx_td ltx_nopad_l ltx_nopad_r ltx_align_center ltx_align_middle ltx_border_r ltx_border_tt" style="padding:0.75pt 0.5pt;" colspan="4"><span id="S4.T2.14.1.1.5.1" class="ltx_text" style="font-size:90%;">MedXpertQA</span></td>
<td id="S4.T2.14.1.1.6" class="ltx_td ltx_nopad_l ltx_align_center ltx_align_middle ltx_border_tt" style="padding:0.75pt 0.5pt;" colspan="4"><span id="S4.T2.14.1.1.6.1" class="ltx_text" style="font-size:90%;">AVG</span></td></tr>
