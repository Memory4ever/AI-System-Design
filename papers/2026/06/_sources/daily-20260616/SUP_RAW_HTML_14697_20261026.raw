</span></td>
<td id="S4.T2.14.1.2.5" class="ltx_td ltx_nopad_l ltx_nopad_r ltx_align_left ltx_align_middle ltx_border_t" style="padding:0.75pt 0.5pt;">
<span id="S4.T2.14.1.2.5.1" class="ltx_inline-block ltx_align_middle" style="width:26.2pt;">
<span id="S4.T2.14.1.2.5.1.1" class="ltx_p ltx_align_center"><span id="S4.T2.14.1.2.5.1.1.1" class="ltx_text" style="font-size:90%;">Acc</span><math id="S4.T2.m14" class="ltx_Math" alttext="\uparrow" display="inline" intent=":literal"><semantics><mo mathsize="0.900em" stretchy="false">↑</mo><annotation encoding="application/x-tex">\uparrow</annotation></semantics></math></span>
</span></td>
<td id="S4.T2.14.1.2.6" class="ltx_td ltx_nopad_l ltx_nopad_r ltx_align_left ltx_align_middle ltx_border_t" style="padding:0.75pt 0.5pt;">
<span id="S4.T2.14.1.2.6.1" class="ltx_inline-block ltx_align_middle" style="width:26.2pt;">
<span id="S4.T2.14.1.2.6.1.1" class="ltx_p ltx_align_center"><math id="S4.T2.m15" class="ltx_Math" alttext="\mathrm{H}^{V}" display="inline" intent=":literal"><semantics><msup><mi mathsize="0.900em">H</mi><mi mathsize="0.900em">V</mi></msup><annotation encoding="application/x-tex">\mathrm{H}^{V}</annotation></semantics></math><math id="S4.T2.m16" class="ltx_Math" alttext="\downarrow" display="inline" intent=":literal"><semantics><mo mathsize="0.900em" stretchy="false">↓</mo><annotation encoding="application/x-tex">\downarrow</annotation></semantics></math></span>
</span></td>
<td id="S4.T2.14.1.2.7" class="ltx_td ltx_nopad_l ltx_nopad_r ltx_align_left ltx_align_middle ltx_border_t" style="padding:0.75pt 0.5pt;">
<span id="S4.T2.14.1.2.7.1" class="ltx_inline-block ltx_align_middle" style="width:26.2pt;">
<span id="S4.T2.14.1.2.7.1.1" class="ltx_p ltx_align_center"><math id="S4.T2.m17" class="ltx_Math" alttext="\mathrm{H}^{K}" display="inline" intent=":literal"><semantics><msup><mi mathsize="0.900em">H</mi><mi mathsize="0.900em">K</mi></msup><annotation encoding="application/x-tex">\mathrm{H}^{K}</annotation></semantics></math><math id="S4.T2.m18" class="ltx_Math" alttext="\downarrow" display="inline" intent=":literal"><semantics><mo mathsize="0.900em" stretchy="false">↓</mo><annotation encoding="application/x-tex">\downarrow</annotation></semantics></math></span>
</span></td>
