<span id="S1.T1.12.1.1.3.1" class="ltx_inline-block ltx_align_center ltx_align_middle" style="width:38.4pt;--ltx-bg-color:#DCE7F7;">
<span id="S1.T1.12.1.1.3.1.1" class="ltx_p"><span id="S1.T1.12.1.1.3.1.1.1" class="ltx_text ltx_font_bold" style="font-size:90%;">Multi-</span></span>
<span id="S1.T1.12.1.1.3.1.2" class="ltx_p"><span id="S1.T1.12.1.1.3.1.2.1" class="ltx_text ltx_font_bold" style="font-size:90%;">modal</span></span>
