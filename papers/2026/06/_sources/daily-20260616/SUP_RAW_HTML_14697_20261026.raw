<span id="S1.T1.12.1.1.4.1.1" class="ltx_p"><span id="S1.T1.12.1.1.4.1.1.1" class="ltx_text ltx_font_bold" style="font-size:90%;">Structured</span></span>
<span id="S1.T1.12.1.1.4.1.2" class="ltx_p"><span id="S1.T1.12.1.1.4.1.2.1" class="ltx_text ltx_font_bold" style="font-size:90%;">CoT</span></span>
</span></td>
<td id="S1.T1.12.1.1.5" class="ltx_td ltx_align_left ltx_align_middle ltx_border_tt" style="--ltx-bg-color:#DFEFDF;padding:0.65pt 4.5pt;">
<span id="S1.T1.12.1.1.5.1" class="ltx_inline-block ltx_align_center ltx_align_middle" style="width:45.5pt;--ltx-bg-color:#DFEFDF;">
<span id="S1.T1.12.1.1.5.1.1" class="ltx_p"><span id="S1.T1.12.1.1.5.1.1.1" class="ltx_text ltx_font_bold" style="font-size:90%;">Stage-wise</span></span>
<span id="S1.T1.12.1.1.5.1.2" class="ltx_p"><span id="S1.T1.12.1.1.5.1.2.1" class="ltx_text ltx_font_bold" style="font-size:90%;">Trace</span></span>
</span></td>
<td id="S1.T1.12.1.1.6" class="ltx_td ltx_align_left ltx_align_middle ltx_border_tt" style="--ltx-bg-color:#F5E4D6;padding:0.65pt 4.5pt;">
