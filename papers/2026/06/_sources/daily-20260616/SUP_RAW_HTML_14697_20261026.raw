<td id="S4.T2.14.1.2.3" class="ltx_td ltx_nopad_l ltx_nopad_r ltx_align_left ltx_align_middle ltx_border_t" style="padding:0.75pt 0.5pt;">
<span id="S4.T2.14.1.2.3.1" class="ltx_inline-block ltx_align_middle" style="width:26.2pt;">
