<td id="A3.T4.6.4.2" class="ltx_td ltx_align_center ltx_border_b"><span id="A3.T4.6.4.2.1" class="ltx_text" style="font-size:90%;">0.47</span></td>
<td id="A3.T4.6.4.3" class="ltx_td ltx_align_center ltx_border_b"><span id="A3.T4.6.4.3.1" class="ltx_text" style="font-size:90%;">0.71</span></td>
