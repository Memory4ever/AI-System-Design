py:"复制",backToTop:"返回顶部",copyFailed:"复制失败，请手动复制",justGenerated:"刚刚生成",minutesAgo:"{{count}}分钟前",hoursAgo:"{{count}}小时前",applyPublish:"申请对外",copySuccess:"复制成功",expandCode:"展开",collapseCode:"收起",expandFullText:"展开全文",collapse:"收起",rejectReasonTitle:"审核驳回原因",rejectReasonPlaceholder:"请输入驳回原因",rejectReasonRequired:"请输入驳回原因",rejectReasonPrefix:"驳回原因：",rejectReasonEmpty:"暂无驳回原因",justNow:"刚刚",confirmDelete:"确认"},_m={noPermission:"当前页面暂无权限访问"},Am={writeArticle:"写文章",articleManagement:"文章管理",myApprovals:"我的审批",commentReview:"评论审核",myApplications:"我的申请",userAvatar:"用户头像",personalCenter:"个人中心",feedback:"意见反馈",editingGuidelines:"编辑指南",logout:"退出登录",editVersionEn:"撰写英文版",exitPreview:"退出预览",previewMode:"预览模式",expiredAt:"将在{{time}}后失效",editVersionZh:"撰写中文版",login:"登录",sign:"登录",tryHy:"试用 Hy",navModel:"模型",navHyModel:"Hy 模型",navOpenSourceModel:"开源模型",navResearch:"研究",navGallery:"Gallery",navSolutions:"Co-design",navAboutUs:"关于我们",home:"首页"},Sm={title:"Gallery",subtitle:"看见混元的创造力",viewDetail:"查看详情",viewWork:"查看作品",remix:"生成同款",remixOnPc:"去PC端生成同款",filter:"类型筛选",new:"New",copyPrompt:"复制提示词",play:"播放",copied:"已复制",close:"关闭",back:"返回",prev:"上一个",next:"下一个",empty:"没有符合筛选的作品",notFound:"没有找到这个作品",noAccess:"暂无访问权限",model:{hy4:"Hy4 preview",hy3:"Hy3"},category:{all:"全部",frontend:"前端",game:"游戏",office:"办公",video:"视频"},sbs:{brand:"Hy Gallery",allProjects:"所有项目",collapse:"收起",expand:"展开",darkMode:"暗黑模式",lightMode:"明亮模式",emptyCell:"暂无结果",empty:"暂无项目",mode:{high:"High",noThink:"No think",middle:"Middle"},column:{hy4:"Hy4",hy4preview:"Hy4 preview"}}},km={heroTitle:"Co-design",heroDesc:"基于模型与产品的协同设计模式（Co-design），持续将真实场景中的反馈转化为模型进步，让每一次产品体验都更智能、更高效、更可靠。",prevPartner:"上一个",nextPartner:"下一个",learnMore:"了解更多",feedbackTitle:"反馈",faqTitle:"常见问题",trustedTitle:"与司内各业务持续Co-design"},Pm={pageTitle:"文章管理",tabAllPublished:"全部发布",tabMyPosts:"我的发布",tabMyDrafts:"我的草稿",statusPublished:"已发布",statusDraft:"草稿",emptyNoPublished:"暂无已发布文章",emptyNoPublishedTip:"点击这里写下你的第一篇文章",emptyNoDrafts:"暂无草稿",emptyNoDraftsTip:"灵感稍纵即逝