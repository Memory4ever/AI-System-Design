<td id="S7.T7.15.2.5" class="ltx_td ltx_align_center ltx_border_t" style="padding:0.65pt 4.0pt;"><span id="S7.T7.15.2.5.1" class="ltx_text" style="font-size:80%;">76.16</span></td>
<td id="S7.T7.15.2.6" class="ltx_td ltx_align_center ltx_border_t" style="padding:0.65pt 4.0pt;"><span id="S7.T7.15.2.6.1" class="ltx_text" style="font-size:80%;">1.00</span></td>
<td id="S7.T7.15.2.7" class="ltx_td ltx_align_center ltx_border_t" style="padding:0.65pt 4.0pt;"><span id="S7.T7.15.2.7.1" class="ltx_text" style="font-size:80%;">1.00</span></td>
<td id="S7.T7.15.2.8" class="ltx_td ltx_align_center ltx_border_t" style="padding:0.65pt 4.0pt;"><span id="S7.T7.15.2.8.1" class="ltx_text" style="font-size:80%;">0.00</span></td>
<td id="S7.T7.15.2.9" class="ltx_td ltx_align_center ltx_border_t" style="padding:0.65pt 4.0pt;"><span id="S7.T7.15.2.9.1" class="ltx_text" style="font-size:80%;">29875</span></td></tr>
<tr id="S7.T7.15.3" class="ltx_tr">
<td id="S7.T7.15.3.1" class="ltx_td ltx_align_left" style="padding:0.65pt 4.0pt;"><span id="S7.T7.15.3.1.1" class="ltx_text" style="font-size:80%;">Keyword top-10</span></td>
