<td id="S6.T6.8.4.5" class="ltx_td ltx_align_center ltx_border_t" style="padding:0.65pt 4.0pt;"><span id="S6.T6.8.4.5.1" class="ltx_text" style="font-size:80%;">1.00</span></td>
