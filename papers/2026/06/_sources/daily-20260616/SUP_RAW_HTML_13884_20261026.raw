<span id="S5.T3.6.1.3.1.1" class="ltx_p ltx_align_left"><span id="S5.T3.6.1.3.1.1.1" class="ltx_text" style="font-size:80%;">Authorization </span><math id="S5.T3.m2" class="ltx_Math" alttext="\alpha_{i}" display="inline" intent=":literal"><semantics><msub><mi mathsize="0.800em">α</mi><mi mathsize="0.800em">i</mi></msub><annotation encoding="application/x-tex">\alpha_{i}</annotation></semantics></math></span>
</span></th>
<th id="S5.T3.6.1.4" class="ltx_td ltx_nopad_r ltx_align_left ltx_th ltx_th_column ltx_border_tt" style="padding:1.05pt 5.0pt;">
