</span></th>
<td id="A7.T9.2.5.2" class="ltx_td ltx_nopad_r ltx_align_center"><math id="A7.T9.m4" class="ltx_Math" alttext="0.3711\pm 0.0466" display="inline" intent=":literal"><semantics><mrow><mn>0.3711</mn><mo>±</mo><mn>0.0466</mn></mrow><annotation encoding="application/x-tex">0.3711\pm 0.0466</annotation></semantics></math></td></tr>
