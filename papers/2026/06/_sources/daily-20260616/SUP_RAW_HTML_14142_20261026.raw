</span></th>
<td id="A7.T9.2.4.2" class="ltx_td ltx_nopad_r ltx_align_center"><math id="A7.T9.m3" class="ltx_Math" alttext="0.3224\pm 0.0423" display="inline" intent=":literal"><semantics><mrow><mn>0.3224</mn><mo>±</mo><mn>0.0423</mn></mrow><annotation encoding="application/x-tex">0.3224\pm 0.0423</annotation></semantics></math></td></tr>
<tr id="A7.T9.2.5" class="ltx_tr">
<th id="A7.T9.2.5.1" class="ltx_td ltx_align_left ltx_th ltx_th_row">
