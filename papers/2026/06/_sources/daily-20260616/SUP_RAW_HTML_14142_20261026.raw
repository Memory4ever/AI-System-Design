<section id="A7" class="ltx_appendix">
<h2 class="ltx_title ltx_title_appendix"><span class="ltx_tag ltx_tag_appendix">Appendix G </span>Complementary Experiment Results</h2>

<section id="A7.SS1" class="ltx_subsection">
<h3 class="ltx_title ltx_title_subsection"><span class="ltx_tag ltx_tag_subsection">G.1 </span>Inference Speed of CoT SFT Variants</h3>

<figure id="A7.T9" class="ltx_table">
<table id="A7.T9.2" class="ltx_tabular ltx_guessed_headers ltx_align_middle">
<thead class="ltx_thead">
<tr id="A7.T9.2.1" class="ltx_tr">
<th id="A7.T9.2.1.1" class="ltx_td ltx_align_left ltx_th ltx_th_column ltx_th_row ltx_border_tt">
<span id="A7.T9.2.1.1.1" class="ltx_inline-block ltx_align_top">
<span id="A7.T9.2.1.1.1.1" class="ltx_p ltx_align_left"><span id="A7.T9.2.1.1.1.1.1" class="ltx_text ltx_font_bold">Model</span></span>
</span></th>
<th id="A7.T9.2.1.2" class="ltx_td ltx_nopad_r ltx_align_center ltx_th ltx_th_column ltx_border_tt"><span id="A7.T9.2.1.2.1" class="ltx_text ltx_font_bold">Seconds/Sample</span></th></tr>
</thead>
<tbody class="ltx_tbody">
<tr id="A7.T9.2.2" class="ltx_tr">
