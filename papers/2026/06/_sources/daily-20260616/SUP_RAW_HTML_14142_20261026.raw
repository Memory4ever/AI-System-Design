</span></th>
<td id="A7.T9.2.3.2" class="ltx_td ltx_nopad_r ltx_align_center"><math id="A7.T9.m2" class="ltx_Math" alttext="0.4211\pm 0.0459" display="inline" intent=":literal"><semantics><mrow><mn>0.4211</mn><mo>±</mo><mn>0.0459</mn></mrow><annotation encoding="application/x-tex">0.4211\pm 0.0459</annotation></semantics></math></td></tr>
<tr id="A7.T9.2.4" class="ltx_tr">
<th id="A7.T9.2.4.1" class="ltx_td ltx_align_left ltx_th ltx_th_row">
