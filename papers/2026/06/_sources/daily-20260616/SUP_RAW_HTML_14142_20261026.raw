</span></th>
<td id="A7.T9.2.6.2" class="ltx_td ltx_nopad_r ltx_align_center"><math id="A7.T9.m5" class="ltx_Math" alttext="0.3379\pm 0.0431" display="inline" intent=":literal"><semantics><mrow><mn>0.3379</mn><mo>±</mo><mn>0.0431</mn></mrow><annotation encoding="application/x-tex">0.3379\pm 0.0431</annotation></semantics></math></td></tr>
<tr id="A7.T9.2.7" class="ltx_tr">
