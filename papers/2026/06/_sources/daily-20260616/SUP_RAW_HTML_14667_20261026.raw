<td id="S4.T1.6.1.6.2" class="ltx_td ltx_align_center ltx_border_bb ltx_border_t"><span id="S4.T1.6.1.6.2.1" class="ltx_text ltx_underline">0.4977</span></td>
<td id="S4.T1.6.1.6.3" class="ltx_td ltx_align_center ltx_border_bb ltx_border_t"><span id="S4.T1.6.1.6.3.1" class="ltx_text ltx_font_bold">0.3063</span></td>
