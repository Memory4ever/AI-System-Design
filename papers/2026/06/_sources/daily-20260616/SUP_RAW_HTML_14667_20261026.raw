<td id="S4.T1.6.1.6.7" class="ltx_td ltx_align_center ltx_border_bb ltx_border_t"><span id="S4.T1.6.1.6.7.1" class="ltx_text ltx_font_bold">0.8578</span></td>
<td id="S4.T1.6.1.6.8" class="ltx_td ltx_align_center ltx_border_bb ltx_border_t"><span id="S4.T1.6.1.6.8.1" class="ltx_text ltx_font_bold">0.7268</span></td></tr>
