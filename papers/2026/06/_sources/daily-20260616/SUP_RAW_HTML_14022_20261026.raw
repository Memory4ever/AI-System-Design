<td id="A6.T38.5.3.3" class="ltx_td ltx_align_center"><math id="A6.T38.m5" class="ltx_Math" alttext="\sim 14.3" display="inline" intent=":literal"><semantics><mrow><mphantom></mphantom><mo mathsize="0.800em">∼</mo><mn mathsize="0.800em">14.3</mn></mrow><annotation encoding="application/x-tex">\sim 14.3</annotation></semantics></math></td>
