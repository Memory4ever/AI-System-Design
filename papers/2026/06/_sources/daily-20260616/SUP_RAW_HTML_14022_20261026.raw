<th id="A4.T23.5.2.2" class="ltx_td ltx_align_left ltx_th ltx_th_row ltx_border_t"><span id="A4.T23.5.2.2.1" class="ltx_text" style="font-size:80%;">PostDeg-L-FG <math id="A4.T23.m8" class="ltx_Math" alttext="\dagger" display="inline" intent=":literal"><semantics><mo>†</mo><annotation encoding="application/x-tex">\dagger</annotation></semantics></math></span></th>
<td id="A4.T23.5.2.3" class="ltx_td ltx_align_center ltx_border_t"><span id="A4.T23.5.2.3.1" class="ltx_text" style="font-size:80%;">1.5628 <math id="A4.T23.m9" class="ltx_Math" alttext="\pm" display="inline" intent=":literal"><semantics><mo>±</mo><annotation encoding="application/x-tex">\pm</annotation></semantics></math> 0.0021</span></td>
<td id="A4.T23.5.2.4" class="ltx_td ltx_align_center ltx_border_t"><span id="A4.T23.5.2.4.1" class="ltx_text" style="font-size:80%;">0.7543 <math id="A4.T23.m10" class="ltx_Math" alttext="\pm" display="inline" intent=":literal"><semantics><mo>±</mo><annotation encoding="application/x-tex">\pm</annotation></semantics></math> 0.0009</span></td>
<td id="A4.T23.5.2.5" class="ltx_td ltx_align_center ltx_border_t"><span id="A4.T23.5.2.5.1" class="ltx_text" style="font-size:80%;">0.2514 <math id="A4.T23.m11" class="ltx_Math" alttext="\pm" display="inline" intent=":literal"><semantics><mo>±</mo><annotation encoding="application/x-tex">\pm</annotation></semantics></math> 0.0003</span></td></tr>
