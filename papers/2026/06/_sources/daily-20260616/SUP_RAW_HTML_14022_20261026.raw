<span id="S3.T1.5.5.4.1.1" class="ltx_p ltx_align_left"><span id="S3.T1.5.5.4.1.1.1" class="ltx_text" style="font-size:80%;">May recover part of the signal</span></span>
</span></td>
<td id="S3.T1.5.5.5" class="ltx_td ltx_align_left ltx_align_top" style="padding:0.45pt 3.0pt;">
<span id="S3.T1.5.5.5.1" class="ltx_inline-block ltx_align_top" style="width:93.2pt;">
