<span id="S3.T1.5.2.4.1.1" class="ltx_p ltx_align_left"><span id="S3.T1.5.2.4.1.1.1" class="ltx_text" style="font-size:80%;">Loses topology magnitude</span></span>
</span></td>
<td id="S3.T1.5.2.5" class="ltx_td ltx_align_left ltx_align_top ltx_border_t" style="padding:0.45pt 3.0pt;">
