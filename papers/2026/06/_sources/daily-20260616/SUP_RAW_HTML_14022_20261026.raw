<span id="S3.T1.5.2.5.1.1" class="ltx_p ltx_align_left"><span id="S3.T1.5.2.5.1.1.1" class="ltx_text" style="font-size:80%;">residual </span><math id="S3.T1.m2" class="ltx_math_unparsed" alttext="\leq 2.44\!\times\!10^{-5}" display="inline" intent=":literal"><semantics><mrow><mpadded style="width:0.648em;" width="0.648em"><mo mathsize="0.800em">≤</mo></mpadded><mo mathsize="0.800em" rspace="0.222em">×</mo><mn mathsize="0.800em">10</mn><msup><mrow></mrow><mrow><mo mathsize="0.800em">−</mo><mn mathsize="0.800em">5</mn></mrow></msup></mrow><annotation encoding="application/x-tex">\leq 2.44\!\times\!10^{-5}</annotation></semantics></math><span id="S3.T1.5.2.5.1.1.2" class="ltx_text" style="font-size:80%;"> on every task</span></span>
</span></td></tr>
<tr id="S3.T1.5.3" class="ltx_tr" style="--ltx-bg-color:#DDECF8;">
<td id="S3.T1.5.3.1" class="ltx_td ltx_align_left ltx_align_top" style="padding:0.45pt 3.0pt;">
<span id="S3.T1.5.3.1.1" class="ltx_inline-block ltx_align_top" style="width:55.2pt;--ltx-bg-color:#DDECF8;">
<span id="S3.T1.5.3.1.1.1" class="ltx_p ltx_align_left"><span id="S3.T1.5.3.1.1.1.1" class="ltx_text ltx_font_bold" style="font-size:80%;">Post-LN positive scalar</span></span>
</span></td>
<td id="S3.T1.5.3.2" class="ltx_td ltx_align_left ltx_align_top" style="padding:0.45pt 3.0pt;">
<span id="S3.T1.5.3.2.1" class="ltx_inline-block ltx_align_top" style="width:69.0pt;--ltx-bg-color:#DDECF8;">
<span id="S3.T1.5.3.2.1.1" class="ltx_p ltx_align_left"><math id="S3.T1.m3" class="ltx_math_unparsed" alttext="(c_{i}+\varepsilon)^{-1/2}\operatorname{LN}(z_{i})" display="inline" intent=":literal"><semantics><mrow><msup><mrow><mo style="--ltx-bg-color:#DDECF8;" mathbackground="#DDECF8" maxsize="0.800em" minsize="0.800em">(</mo><msub><mi style="--ltx-bg-color:#DDECF8;" mathbackground="#DDECF8" mathsize="0.800em">c</mi><mi style="--ltx-bg-color:#DDECF8;" mathbackground="#DDECF8" mathsize="0.800em">i</mi></msub><mo style="--ltx-bg-color:#DDECF8;" mathbackground="#DDECF8" mathsize="0.800em">+</mo><mi style="--ltx-bg-color:#DDECF8;" mathbackground="#DDECF8" mathsize="0.800em">ε</mi><mo style="--ltx-bg-color:#DDECF8;" mathbackground="#DDECF8" maxsize="0.800em" minsize="0.800em">)</mo></mrow><mrow><mo style="--ltx-bg-color:#DDECF8;" mathbackground="#DDECF8" mathsize="0.800em">−</mo><mn style="--ltx-bg-color:#DDECF8;" mathbackground="#DDECF8" mathsize="0.800em">1</mn><mo style="--ltx-bg-color:#DDECF8;" mathbackground="#DDECF8" maxsize="0.800em" minsize="0.800em" stretchy="true" symmetric="true">/</mo><mn style="--ltx-bg-color:#DDECF8;" mathbackground="#DDECF8" mathsize="0.800em">2</mn></mrow></msup><mi style="--ltx-bg-color:#DDECF8;" mathbackground="#DDECF8" mathsize="0.800em">LN</mi><mrow><mo style="--ltx-bg-color:#DDECF8;" mathbackground="#DDECF8" maxsize="0.800em" minsize="0.800em">(</mo><msub><mi style="--ltx-bg-color:#DDECF8;" mathbackground="#DDECF8" mathsize="0.800em">z</mi><mi style="--ltx-bg-color:#DDECF8;" mathbackground="#DDECF8" mathsize="0.800em">i</mi></msub><mo style="--ltx-bg-color:#DDECF8;" mathbackground="#DDECF8" maxsize="0.800em" minsize="0.800em">)</mo></mrow></mrow><annotation encoding="application/x-tex">(c_{i}+\varepsilon)^{-1/2}\operatorname{LN}(z_{i})</annotation></semantics></math></span>
</span></td>
<td id="S3.T1.5.3.3" class="ltx_td ltx_align_left ltx_align_top" style="padding:0.45pt 3.0pt;">
<span id="S3.T1.5.3.3.1" class="ltx_inline-block ltx_align_top" style="width:31.0pt;--ltx-bg-color:#DDECF8;">
<span id="S3.T1.5.3.3.1.1" class="ltx_p ltx_align_left"><span id="S3.T1.5.3.3.1.1.1" class="ltx_text ltx_font_bold" style="font-size:80%;">✘(no)</span></span>
</span></td>
