<td id="S4.T2.5.3.3" class="ltx_td ltx_align_center" style="padding:0.45pt 5.0pt;"><span id="S4.T2.5.3.3.1" class="ltx_text" style="font-size:80%;">0.42</span></td>
<td id="S4.T2.5.3.4" class="ltx_td ltx_align_center" style="padding:0.45pt 5.0pt;"><span id="S4.T2.5.3.4.1" class="ltx_text" style="font-size:80%;">20</span></td>
<td id="S4.T2.5.3.5" class="ltx_td ltx_align_center" style="padding:0.45pt 5.0pt;"><span id="S4.T2.5.3.5.1" class="ltx_text" style="font-size:80%;">0.46</span></td>
<td id="S4.T2.5.3.6" class="ltx_td ltx_align_center" style="padding:0.45pt 5.0pt;"><span id="S4.T2.5.3.6.1" class="ltx_text" style="font-size:80%;">moderate</span></td>
<td id="S4.T2.5.3.7" class="ltx_td ltx_align_center" style="padding:0.45pt 5.0pt;"><math id="S4.T2.m5" class="ltx_Math" alttext="+2.5\%" display="inline" intent=":literal"><semantics><mrow><mo mathsize="0.800em">+</mo><mrow><mn mathsize="0.800em">2.5</mn><mo>%</mo></mrow></mrow><annotation encoding="application/x-tex">+2.5\%</annotation></semantics></math></td></tr>
