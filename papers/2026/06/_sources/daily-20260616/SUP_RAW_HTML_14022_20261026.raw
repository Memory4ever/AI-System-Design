<td id="S4.T2.5.2.6" class="ltx_td ltx_align_center ltx_border_t" style="padding:0.45pt 5.0pt;"><span id="S4.T2.5.2.6.1" class="ltx_text" style="font-size:80%;--ltx-bg-color:#DDECF8;">high</span></td>
<td id="S4.T2.5.2.7" class="ltx_td ltx_align_center ltx_border_t" style="padding:0.45pt 5.0pt;"><math id="S4.T2.m4" class="ltx_Math" style="--ltx-bg-color:#DDECF8;" alttext="+3.5\%" display="inline" intent=":literal"><semantics><mrow><mo style="--ltx-bg-color:#DDECF8;" mathbackground="#DDECF8" mathsize="0.800em">+</mo><mrow><mn style="--ltx-bg-color:#DDECF8;" mathbackground="#DDECF8" mathsize="0.800em">3.5</mn><mo style="--ltx-bg-color:#DDECF8;" mathbackground="#DDECF8">%</mo></mrow></mrow><annotation encoding="application/x-tex">+3.5\%</annotation></semantics></math></td></tr>
<tr id="S4.T2.5.3" class="ltx_tr">
