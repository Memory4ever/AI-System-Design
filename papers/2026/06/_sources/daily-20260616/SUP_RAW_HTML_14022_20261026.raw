<th id="A4.T9.5.1.6" class="ltx_td ltx_align_center ltx_th ltx_th_column ltx_border_tt"><span id="A4.T9.5.1.6.1" class="ltx_text" style="font-size:80%;">worst-case ratio</span></th></tr>
