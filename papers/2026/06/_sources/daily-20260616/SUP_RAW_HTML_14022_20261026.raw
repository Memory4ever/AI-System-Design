<th id="A4.T23.5.4.2" class="ltx_td ltx_align_left ltx_th ltx_th_row ltx_border_t"><span id="A4.T23.5.4.2.1" class="ltx_text" style="font-size:80%;">PostDeg-L-FG <math id="A4.T23.m16" class="ltx_Math" alttext="\dagger" display="inline" intent=":literal"><semantics><mo>†</mo><annotation encoding="application/x-tex">\dagger</annotation></semantics></math></span></th>
<td id="A4.T23.5.4.3" class="ltx_td ltx_align_center ltx_border_t"><span id="A4.T23.5.4.3.1" class="ltx_text" style="font-size:80%;">1.5867 <math id="A4.T23.m17" class="ltx_Math" alttext="\pm" display="inline" intent=":literal"><semantics><mo>±</mo><annotation encoding="application/x-tex">\pm</annotation></semantics></math> 0.0041</span></td>
