<span id="S3.T1.5.3.5.1" class="ltx_inline-block ltx_align_top" style="width:93.2pt;--ltx-bg-color:#DDECF8;">
<span id="S3.T1.5.3.5.1.1" class="ltx_p ltx_align_left"><math id="S3.T1.m4" class="ltx_math_unparsed" alttext="+3.5\%/+2.5\%/+5.6\%" display="inline" intent=":literal"><semantics><mrow><mo style="--ltx-bg-color:#DDECF8;" mathbackground="#DDECF8" mathsize="0.800em">+</mo><mn style="--ltx-bg-color:#DDECF8;" mathbackground="#DDECF8" mathsize="0.800em">3.5</mn><mo style="--ltx-bg-color:#DDECF8;" mathbackground="#DDECF8">%</mo><mo style="--ltx-bg-color:#DDECF8;" mathbackground="#DDECF8" maxsize="0.800em" minsize="0.800em" rspace="0em" stretchy="true" symmetric="true">/</mo><mo style="--ltx-bg-color:#DDECF8;" lspace="0em" mathbackground="#DDECF8" mathsize="0.800em">+</mo><mn style="--ltx-bg-color:#DDECF8;" mathbackground="#DDECF8" mathsize="0.800em">2.5</mn><mo style="--ltx-bg-color:#DDECF8;" mathbackground="#DDECF8">%</mo><mo style="--ltx-bg-color:#DDECF8;" mathbackground="#DDECF8" maxsize="0.800em" minsize="0.800em" rspace="0em" stretchy="true" symmetric="true">/</mo><mo style="--ltx-bg-color:#DDECF8;" lspace="0em" mathbackground="#DDECF8" mathsize="0.800em">+</mo><mn style="--ltx-bg-color:#DDECF8;" mathbackground="#DDECF8" mathsize="0.800em">5.6</mn><mo style="--ltx-bg-color:#DDECF8;" mathbackground="#DDECF8">%</mo></mrow><annotation encoding="application/x-tex">+3.5\%/+2.5\%/+5.6\%</annotation></semantics></math><span id="S3.T1.5.3.5.1.1.1" class="ltx_text" style="font-size:80%;">, 10/10 wins</span></span>
</span></td></tr>
