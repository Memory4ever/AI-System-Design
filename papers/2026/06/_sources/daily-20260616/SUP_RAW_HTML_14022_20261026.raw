<td id="A4.T23.5.3.5" class="ltx_td ltx_align_center"><span id="A4.T23.5.3.5.1" class="ltx_text" style="font-size:80%;">0.2515 <math id="A4.T23.m15" class="ltx_Math" alttext="\pm" display="inline" intent=":literal"><semantics><mo>±</mo><annotation encoding="application/x-tex">\pm</annotation></semantics></math> 0.0002</span></td></tr>
