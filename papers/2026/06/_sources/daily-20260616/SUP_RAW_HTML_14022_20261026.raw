<td id="S4.T2.5.2.3" class="ltx_td ltx_align_center ltx_border_t" style="padding:0.45pt 5.0pt;"><span id="S4.T2.5.2.3.1" class="ltx_text" style="font-size:80%;--ltx-bg-color:#DDECF8;">0.81</span></td>
<td id="S4.T2.5.2.4" class="ltx_td ltx_align_center ltx_border_t" style="padding:0.45pt 5.0pt;"><span id="S4.T2.5.2.4.1" class="ltx_text" style="font-size:80%;--ltx-bg-color:#DDECF8;">45</span></td>
