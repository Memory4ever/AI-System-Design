<td id="A4.T4.6.4.3" class="ltx_td ltx_align_center" style="padding-left:2.6pt;padding-right:2.6pt;"><span id="A4.T4.6.4.3.1" class="ltx_text" style="font-size:80%;">0.2435 <math id="A4.T4.m25" class="ltx_Math" alttext="\pm" display="inline" intent=":literal"><semantics><mo>±</mo><annotation encoding="application/x-tex">\pm</annotation></semantics></math> 0.0007</span></td>
