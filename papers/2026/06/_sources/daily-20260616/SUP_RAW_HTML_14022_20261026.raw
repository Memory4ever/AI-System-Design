<td id="A4.T23.5.4.5" class="ltx_td ltx_align_center ltx_border_t"><span id="A4.T23.5.4.5.1" class="ltx_text" style="font-size:80%;">0.2551 <math id="A4.T23.m19" class="ltx_Math" alttext="\pm" display="inline" intent=":literal"><semantics><mo>±</mo><annotation encoding="application/x-tex">\pm</annotation></semantics></math> 0.0004</span></td></tr>
