<td id="A4.T14.5.18.1" class="ltx_td ltx_align_left ltx_border_tt" style="padding-left:8.0pt;padding-right:8.0pt;" colspan="4"><span id="A4.T14.5.18.1.1" class="ltx_text ltx_font_italic" style="font-size:80%;">Note:<span id="A4.T14.5.18.1.1.1" class="ltx_text ltx_font_upright"> <sup id="A4.T14.5.18.1.1.1.1" class="ltx_sup"><span id="A4.T14.5.18.1.1.1.1.1" class="ltx_text ltx_font_italic">∗∗∗</span></sup> <math id="A4.T14.m19" class="ltx_Math" alttext="p{&lt;}0.001" display="inline" intent=":literal"><semantics><mrow><mi>p</mi><mo>&lt;</mo><mn>0.001</mn></mrow><annotation encoding="application/x-tex">p{&lt;}0.001</annotation></semantics></math>, <sup id="A4.T14.5.18.1.1.1.2" class="ltx_sup"><span id="A4.T14.5.18.1.1.1.2.1" class="ltx_text ltx_font_italic">∗∗</span></sup> <math id="A4.T14.m21" class="ltx_Math" alttext="p{&lt;}0.01" display="inline" intent=":literal"><semantics><mrow><mi>p</mi><mo>&lt;</mo><mn>0.01</mn></mrow><annotation encoding="application/x-tex">p{&lt;}0.01</annotation></semantics></math>, <sup id="A4.T14.5.18.1.1.1.3" class="ltx_sup"><span id="A4.T14.5.18.1.1.1.3.1" class="ltx_text ltx_font_italic">∗</span></sup> <math id="A4.T14.m23" class="ltx_Math" alttext="p{&lt;}0.05" display="inline" intent=":literal"><semantics><mrow><mi>p</mi><mo>&lt;</mo><mn>0.05</mn></mrow><annotation encoding="application/x-tex">p{&lt;}0.05</annotation></semantics></math>, n.s. = not significant.</span></span></td></tr>
