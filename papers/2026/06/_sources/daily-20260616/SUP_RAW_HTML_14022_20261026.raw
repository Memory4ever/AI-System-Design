<td id="A6.T38.5.6.2" class="ltx_td ltx_align_center"><math id="A6.T38.m10" class="ltx_Math" alttext="\sim 2.1" display="inline" intent=":literal"><semantics><mrow><mphantom></mphantom><mo mathsize="0.800em">∼</mo><mn mathsize="0.800em">2.1</mn></mrow><annotation encoding="application/x-tex">\sim 2.1</annotation></semantics></math></td>
<td id="A6.T38.5.6.3" class="ltx_td ltx_align_center"><math id="A6.T38.m11" class="ltx_Math" alttext="\sim 0.5" display="inline" intent=":literal"><semantics><mrow><mphantom></mphantom><mo mathsize="0.800em">∼</mo><mn mathsize="0.800em">0.5</mn></mrow><annotation encoding="application/x-tex">\sim 0.5</annotation></semantics></math></td>
