<td id="A4.T9.5.2.3" class="ltx_td ltx_align_center ltx_border_t"><span id="A4.T9.5.2.3.1" class="ltx_text" style="font-size:80%;">27.79 <math id="A4.T9.m26" class="ltx_Math" alttext="\pm" display="inline" intent=":literal"><semantics><mo>±</mo><annotation encoding="application/x-tex">\pm</annotation></semantics></math> 0.13</span></td>
<td id="A4.T9.5.2.4" class="ltx_td ltx_align_center ltx_border_t"><span id="A4.T9.5.2.4.1" class="ltx_text" style="font-size:80%;">42.25 <math id="A4.T9.m27" class="ltx_Math" alttext="\pm" display="inline" intent=":literal"><semantics><mo>±</mo><annotation encoding="application/x-tex">\pm</annotation></semantics></math> 0.19</span></td>
