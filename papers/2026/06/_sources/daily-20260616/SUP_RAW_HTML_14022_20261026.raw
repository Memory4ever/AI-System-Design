<td id="S4.T2.5.4.2" class="ltx_td ltx_align_center" style="padding:0.45pt 5.0pt;"><span id="S4.T2.5.4.2.1" class="ltx_text" style="font-size:80%;">9.95</span></td>
<td id="S4.T2.5.4.3" class="ltx_td ltx_align_center" style="padding:0.45pt 5.0pt;"><span id="S4.T2.5.4.3.1" class="ltx_text" style="font-size:80%;">0.33</span></td>
<td id="S4.T2.5.4.4" class="ltx_td ltx_align_center" style="padding:0.45pt 5.0pt;"><span id="S4.T2.5.4.4.1" class="ltx_text" style="font-size:80%;">27</span></td>
