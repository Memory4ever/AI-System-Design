<td id="S7.T2.2.3.2" class="ltx_td ltx_align_right"><math id="S7.T2.m4" class="ltx_Math" alttext="0.54\pm 0.34" display="inline" intent=":literal"><semantics><mrow><mn mathsize="0.900em">0.54</mn><mo mathsize="0.900em">±</mo><mn mathsize="0.900em">0.34</mn></mrow><annotation encoding="application/x-tex">0.54\pm 0.34</annotation></semantics></math></td>
