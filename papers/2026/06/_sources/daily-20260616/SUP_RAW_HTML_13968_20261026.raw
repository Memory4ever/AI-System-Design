<td id="S7.T2.2.2.2" class="ltx_td ltx_align_right ltx_border_t"><math id="S7.T2.m3" class="ltx_Math" alttext="0.26\pm 0.07" display="inline" intent=":literal"><semantics><mrow><mn mathsize="0.900em">0.26</mn><mo mathsize="0.900em">±</mo><mn mathsize="0.900em">0.07</mn></mrow><annotation encoding="application/x-tex">0.26\pm 0.07</annotation></semantics></math></td>
<td id="S7.T2.2.2.3" class="ltx_td ltx_nopad_r ltx_align_right ltx_border_t"><span id="S7.T2.2.2.3.1" class="ltx_text" style="font-size:90%;">85.5</span></td></tr>
