<th id="S7.T2.2.1.3" class="ltx_td ltx_nopad_r ltx_align_right ltx_th ltx_th_column ltx_border_tt"><span id="S7.T2.2.1.3.1" class="ltx_text ltx_font_bold" style="font-size:90%;">tok/s</span></th></tr>
</thead>
