An Thai Le<sup id="id1.3.2" class="ltx_sup"><span id="id1.3.2.1" class="ltx_text ltx_font_italic">1,2</span></sup>, Minh Nhat Vu<sup id="id1.3.3" class="ltx_sup"><span id="id1.3.3.1" class="ltx_text ltx_font_italic">1,2</span></sup>, Mathias Niepert<sup id="id1.3.4" class="ltx_sup"><span id="id1.3.4.1" class="ltx_text ltx_font_italic">4,5</span></sup>, Khoa D. Doan<sup id="id1.3.5" class="ltx_sup"><span id="id1.3.5.1" class="ltx_text ltx_font_italic">1</span></sup></span>
