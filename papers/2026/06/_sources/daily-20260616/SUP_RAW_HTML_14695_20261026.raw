<span id="A4.T10.5.1.1.1.1.1.1.3.1" class="ltx_td ltx_align_left ltx_th ltx_th_row">SliceGPT (n=200) <cite class="ltx_cite ltx_citemacro_citep"><span id="A4.T10.5.1.1.1.1.1.1.3.1.1" class="ltx_text" style="font-size:70%;">(</span><a href="#bib.bib21" title="" class="ltx_ref">Ashkboos et al., 2024</a><span id="A4.T10.5.1.1.1.1.1.1.3.1.3" class="ltx_text" style="font-size:70%;">)</span></cite></span>
<span id="A4.T10.5.1.1.1.1.1.1.3.2" class="ltx_td ltx_align_center">24 (12.0%)</span>
<span id="A4.T10.5.1.1.1.1.1.1.3.3" class="ltx_td ltx_align_center">62 (31.0%)</span>
<span id="A4.T10.5.1.1.1.1.1.1.3.4" class="ltx_td ltx_align_center">32 (16.0%)</span>
