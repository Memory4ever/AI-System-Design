<th id="S3.T2.6.2.1" class="ltx_td ltx_align_left ltx_th ltx_th_row" style="padding-top:0.5pt;padding-bottom:0.5pt;"><span id="S3.T2.6.2.1.1" class="ltx_text ltx_font_smallcaps">Set</span></th>
<td id="S3.T2.6.2.2" class="ltx_td ltx_align_center" style="padding-top:0.5pt;padding-bottom:0.5pt;"><span id="S3.T2.6.2.2.1" class="ltx_text ltx_font_smallcaps">mean</span></td>
