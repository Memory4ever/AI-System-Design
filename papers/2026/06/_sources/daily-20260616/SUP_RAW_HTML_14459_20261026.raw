<td id="S3.T2.6.1.2" class="ltx_td ltx_align_center ltx_border_t" style="padding-top:0.5pt;padding-bottom:0.5pt;" colspan="2"><span id="S3.T2.6.1.2.1" class="ltx_text ltx_font_smallcaps">A-WER</span> (<math id="S3.T2.m1" class="ltx_Math" alttext="\downarrow" display="inline" intent=":literal"><semantics><mo stretchy="false">↓</mo><annotation encoding="application/x-tex">\downarrow</annotation></semantics></math>)</td>
<td id="S3.T2.6.1.3" class="ltx_td ltx_align_center ltx_border_t" style="padding-top:0.5pt;padding-bottom:0.5pt;" colspan="2"><span id="S3.T2.6.1.3.1" class="ltx_text ltx_font_smallcaps">F1</span> (<math id="S3.T2.m2" class="ltx_Math" alttext="\uparrow" display="inline" intent=":literal"><semantics><mo stretchy="false">↑</mo><annotation encoding="application/x-tex">\uparrow</annotation></semantics></math>)</td></tr>
