<th id="S3.T3.6.6.1" class="ltx_td ltx_align_left ltx_th ltx_th_row ltx_border_t" style="padding-top:0.5pt;padding-bottom:0.5pt;"><span id="S3.T3.6.6.1.1" class="ltx_text ltx_font_smallcaps">Joint</span></th>
<td id="S3.T3.6.6.2" class="ltx_td ltx_align_center ltx_border_t" style="padding-top:0.5pt;padding-bottom:0.5pt;"><math id="S3.T3.m33" class="ltx_Math" alttext="27.24\pm 2.25" display="inline" intent=":literal"><semantics><mrow><mn>27.24</mn><mo>±</mo><mn>2.25</mn></mrow><annotation encoding="application/x-tex">27.24\pm 2.25</annotation></semantics></math></td>
<td id="S3.T3.6.6.3" class="ltx_td ltx_align_center ltx_border_t" style="padding-top:0.5pt;padding-bottom:0.5pt;">-</td>
<td id="S3.T3.6.6.4" class="ltx_td ltx_align_center ltx_border_t" style="padding-top:0.5pt;padding-bottom:0.5pt;">-</td>
<td id="S3.T3.6.6.5" class="ltx_td ltx_align_center ltx_border_t" style="padding-top:0.5pt;padding-bottom:0.5pt;">-</td>
<td id="S3.T3.6.6.6" class="ltx_td ltx_align_center ltx_border_t" style="padding-top:0.5pt;padding-bottom:0.5pt;">-</td>
<td id="S3.T3.6.6.7" class="ltx_td ltx_align_center ltx_border_t" style="padding-top:0.5pt;padding-bottom:0.5pt;">-</td></tr>
<tr id="S3.T3.6.7" class="ltx_tr">
<th id="S3.T3.6.7.1" class="ltx_td ltx_align_left ltx_th ltx_th_row ltx_border_b" style="padding-top:0.5pt;padding-bottom:0.5pt;"><span id="S3.T3.6.7.1.1" class="ltx_text ltx_font_smallcaps">FT</span></th>
<td id="S3.T3.6.7.2" class="ltx_td ltx_align_center ltx_border_b" style="padding-top:0.5pt;padding-bottom:0.5pt;"><math id="S3.T3.m34" class="ltx_Math" alttext="34.14\pm 8.56" display="inline" intent=":literal"><semantics><mrow><mn>34.14</mn><mo>±</mo><mn>8.56</mn></mrow><annotation encoding="application/x-tex">34.14\pm 8.56</annotation></semantics></math></td>
<td id="S3.T3.6.7.3" class="ltx_td ltx_align_center ltx_border_b" style="padding-top:0.5pt;padding-bottom:0.5pt;"><math id="S3.T3.m35" class="ltx_Math" alttext="23.73\pm 3.35" display="inline" intent=":literal"><semantics><mrow><mn>23.73</mn><mo>±</mo><mn>3.35</mn></mrow><annotation encoding="application/x-tex">23.73\pm 3.35</annotation></semantics></math></td>
<td id="S3.T3.6.7.4" class="ltx_td ltx_align_center ltx_border_b" style="padding-top:0.5pt;padding-bottom:0.5pt;"><math id="S3.T3.m36" class="ltx_Math" alttext="-24.55\pm 10.99" display="inline" intent=":literal"><semantics><mrow><mrow><mo>−</mo><mn>24.55</mn></mrow><mo>±</mo><mn>10.99</mn></mrow><annotation encoding="application/x-tex">-24.55\pm 10.99</annotation></semantics></math></td>
<td id="S3.T3.6.7.5" class="ltx_td ltx_align_center ltx_border_b" style="padding-top:0.5pt;padding-bottom:0.5pt;"><math id="S3.T3.m37" class="ltx_Math" alttext="24.55\pm 10.99" display="inline" intent=":literal"><semantics><mrow><mn>24.55</mn><mo>±</mo><mn>10.99</mn></mrow><annotation encoding="application/x-tex">24.55\pm 10.99</annotation></semantics></math></td>
<td id="S3.T3.6.7.6" class="ltx_td ltx_align_center ltx_border_b" style="padding-top:0.5pt;padding-bottom:0.5pt;"><math id="S3.T3.m38" class="ltx_Math" alttext="-27.85\pm 4.25" display="inline" intent=":literal"><semantics><mrow><mrow><mo>−</mo><mn>27.85</mn></mrow><mo>±</mo><mn>4.25</mn></mrow><annotation encoding="application/x-tex">-27.85\pm 4.25</annotation></semantics></math></td>
<td id="S3.T3.6.7.7" class="ltx_td ltx_align_center ltx_border_b" style="padding-top:0.5pt;padding-bottom:0.5pt;"><math id="S3.T3.m39" class="ltx_Math" alttext="\mathbf{26.88\pm 0.33}" display="inline" intent=":literal"><semantics><mrow><mn class="ltx_mathvariant_bold" mathvariant="bold">26.88</mn><mo>±</mo><mn class="ltx_mathvariant_bold" mathvariant="bold">0.33</mn></mrow><annotation encoding="application/x-tex">\mathbf{26.88\pm 0.33}</annotation></semantics></math></td></tr>
