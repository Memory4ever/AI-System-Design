<td id="S3.T2.6.2.4" class="ltx_td ltx_align_center" style="padding-top:0.5pt;padding-bottom:0.5pt;"><span id="S3.T2.6.2.4.1" class="ltx_text ltx_font_smallcaps">mean</span></td>
<td id="S3.T2.6.2.5" class="ltx_td ltx_align_center" style="padding-top:0.5pt;padding-bottom:0.5pt;"><span id="S3.T2.6.2.5.1" class="ltx_text ltx_font_smallcaps">median</span></td></tr>
<tr id="S3.T2.6.3" class="ltx_tr">
<th id="S3.T2.6.3.1" class="ltx_td ltx_align_left ltx_th ltx_th_row ltx_border_t" style="padding-top:0.5pt;padding-bottom:0.5pt;"><math id="S3.T2.m3" class="ltx_Math" alttext="t_{0}" display="inline" intent=":literal"><semantics><msub><mi>t</mi><mn>0</mn></msub><annotation encoding="application/x-tex">t_{0}</annotation></semantics></math></th>
<td id="S3.T2.6.3.2" class="ltx_td ltx_align_center ltx_border_t" style="padding-top:0.5pt;padding-bottom:0.5pt;">7.42</td>
<td id="S3.T2.6.3.3" class="ltx_td ltx_align_center ltx_border_t" style="padding-top:0.5pt;padding-bottom:0.5pt;">0.0</td>
<td id="S3.T2.6.3.4" class="ltx_td ltx_align_center ltx_border_t" style="padding-top:0.5pt;padding-bottom:0.5pt;">98.28</td>
<td id="S3.T2.6.3.5" class="ltx_td ltx_align_center ltx_border_t" style="padding-top:0.5pt;padding-bottom:0.5pt;">99.90</td></tr>
<tr id="S3.T2.6.4" class="ltx_tr">
<th id="S3.T2.6.4.1" class="ltx_td ltx_align_left ltx_th ltx_th_row" style="padding-top:0.5pt;padding-bottom:0.5pt;"><math id="S3.T2.m4" class="ltx_Math" alttext="t_{1}" display="inline" intent=":literal"><semantics><msub><mi>t</mi><mn>1</mn></msub><annotation encoding="application/x-tex">t_{1}</annotation></semantics></math></th>
<td id="S3.T2.6.4.2" class="ltx_td ltx_align_center" style="padding-top:0.5pt;padding-bottom:0.5pt;">47.62</td>
<td id="S3.T2.6.4.3" class="ltx_td ltx_align_center" style="padding-top:0.5pt;padding-bottom:0.5pt;">14.29</td>
<td id="S3.T2.6.4.4" class="ltx_td ltx_align_center" style="padding-top:0.5pt;padding-bottom:0.5pt;">95.80</td>
