<td id="S4.T5.2.3.4" class="ltx_td ltx_align_right" style="padding-left:4.0pt;padding-right:4.0pt;"><math id="S4.T5.m5" class="ltx_Math" alttext="0.0628" display="inline" intent=":literal"><semantics><mn mathsize="0.700em">0.0628</mn><annotation encoding="application/x-tex">0.0628</annotation></semantics></math><span id="S4.T5.2.3.4.1" class="ltx_text" style="font-size:70%;"> (SigLIP)</span></td>
