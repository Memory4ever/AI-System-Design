<td id="S4.T3.2.2.3" class="ltx_td ltx_align_right ltx_border_t" style="padding-left:3.0pt;padding-right:3.0pt;"><span id="S4.T3.2.2.3.1" class="ltx_text" style="font-size:70%;">76.04</span></td>
<td id="S4.T3.2.2.4" class="ltx_td ltx_align_right ltx_border_t" style="padding-left:3.0pt;padding-right:3.0pt;"><span id="S4.T3.2.2.4.1" class="ltx_text" style="font-size:70%;">38.22</span></td>
<td id="S4.T3.2.2.5" class="ltx_td ltx_align_right ltx_border_t" style="padding-left:3.0pt;padding-right:3.0pt;"><span id="S4.T3.2.2.5.1" class="ltx_text" style="font-size:70%;">img–text contr.</span></td></tr>
