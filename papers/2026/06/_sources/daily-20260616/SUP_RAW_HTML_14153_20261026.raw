<th id="S4.T3.2.1.2" class="ltx_td ltx_align_right ltx_th ltx_th_column ltx_border_tt" style="padding-left:3.0pt;padding-right:3.0pt;"><span id="S4.T3.2.1.2.1" class="ltx_text" style="font-size:70%;">Params (M)</span></th>
