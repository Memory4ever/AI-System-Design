<td id="S4.T3.2.3.3" class="ltx_td ltx_align_right" style="padding-left:3.0pt;padding-right:3.0pt;"><span id="S4.T3.2.3.3.1" class="ltx_text" style="font-size:70%;">81.10</span></td>
<td id="S4.T3.2.3.4" class="ltx_td ltx_align_right" style="padding-left:3.0pt;padding-right:3.0pt;"><span id="S4.T3.2.3.4.1" class="ltx_text" style="font-size:70%;">17.45</span></td>
