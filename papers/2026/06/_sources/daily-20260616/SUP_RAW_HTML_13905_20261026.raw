<td id="S4.T5.8.1.3.1" class="ltx_td ltx_align_left ltx_border_t" style="padding-left:5.0pt;padding-right:5.0pt;" rowspan="2"><span id="S4.T5.8.1.3.1.1" class="ltx_text ltx_font_typewriter">BGE-base-en-v1.5</span></td>
<td id="S4.T5.8.1.3.2" class="ltx_td ltx_align_left ltx_border_t" style="padding-left:5.0pt;padding-right:5.0pt;">Original Query</td>
<td id="S4.T5.8.1.3.3" class="ltx_td ltx_align_center ltx_border_t" style="padding-left:5.0pt;padding-right:5.0pt;">0.702</td>
<td id="S4.T5.8.1.3.4" class="ltx_td ltx_align_center ltx_border_t" style="padding-left:5.0pt;padding-right:5.0pt;">0.677</td>
<td id="S4.T5.8.1.3.5" class="ltx_td ltx_align_center ltx_border_t" style="padding-left:5.0pt;padding-right:5.0pt;">0.379</td>
