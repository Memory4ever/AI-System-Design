<td id="S3.T1.6.1.20.6" class="ltx_td ltx_align_center ltx_border_bb ltx_border_tt"><span id="S3.T1.6.1.20.6.1" class="ltx_text ltx_font_bold">0.755</span></td>
<td id="S3.T1.6.1.20.7" class="ltx_td ltx_align_center ltx_border_bb ltx_border_tt"><span id="S3.T1.6.1.20.7.1" class="ltx_text ltx_font_bold">0.774</span></td>
<td id="S3.T1.6.1.20.8" class="ltx_td ltx_align_center ltx_border_bb ltx_border_tt"><span id="S3.T1.6.1.20.8.1" class="ltx_text ltx_font_bold">0.315</span></td>
