<td id="S3.T1.6.1.19.1" class="ltx_td ltx_align_left ltx_border_r" style="padding-bottom: 3.00003pt;"><span id="S3.T1.6.1.19.1.1" class="ltx_text ltx_font_typewriter">ThinkQE</span></td>
<td id="S3.T1.6.1.19.2" class="ltx_td ltx_align_center" style="padding-bottom: 3.00003pt;"><span id="S3.T1.6.1.19.2.1" class="ltx_text ltx_underline">0.697</span></td>
<td id="S3.T1.6.1.19.3" class="ltx_td ltx_align_center" style="padding-bottom: 3.00003pt;"><span id="S3.T1.6.1.19.3.1" class="ltx_text ltx_underline">0.683</span></td>
<td id="S3.T1.6.1.19.4" class="ltx_td ltx_align_center ltx_border_rr" style="padding-bottom: 3.00003pt;"><span id="S3.T1.6.1.19.4.1" class="ltx_text ltx_underline">0.372</span></td>
<td id="S3.T1.6.1.19.5" class="ltx_td ltx_align_center" style="padding-bottom: 3.00003pt;"><span id="S3.T1.6.1.19.5.1" class="ltx_text ltx_underline">0.735</span></td>
