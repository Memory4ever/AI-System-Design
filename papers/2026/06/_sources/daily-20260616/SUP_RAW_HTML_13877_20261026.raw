<td id="A2.T4.4.3.5" class="ltx_td ltx_align_center" style="padding-top:0.75pt;padding-bottom:0.75pt;">10</td></tr>
<tr id="A2.T4.4.4" class="ltx_tr">
<th id="A2.T4.4.4.1" class="ltx_td ltx_align_left ltx_th ltx_th_row ltx_border_bb" style="padding-top:0.75pt;padding-bottom:0.75pt;">Control Mode</th>
<td id="A2.T4.4.4.2" class="ltx_td ltx_align_center ltx_border_bb" style="padding-top:0.75pt;padding-bottom:0.75pt;">Rel. Pose</td>
