<figure id="S4.F4" class="ltx_figure"><img src="2606.13707v1/fig_difficulty.png" id="S4.F4.g1" class="ltx_graphics ltx_centering ltx_img_landscape" style="aspect-ratio:476/179;" width="476" height="179" alt="Refer to caption">
