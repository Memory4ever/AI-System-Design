<td id="Pt0.A1.T3.2.26.5" class="ltx_td ltx_align_center" style="padding:0.25pt 4.0pt;">50</td>
<td id="Pt0.A1.T3.2.26.6" class="ltx_td ltx_align_center" style="padding:0.25pt 4.0pt;">49</td></tr>
<tr id="Pt0.A1.T3.2.27" class="ltx_tr">
<th id="Pt0.A1.T3.2.27.1" class="ltx_td ltx_align_left ltx_th ltx_th_row ltx_border_bb ltx_border_t" style="padding:0.25pt 4.0pt;"><span id="Pt0.A1.T3.2.27.1.1" class="ltx_text ltx_font_bold">Average (50 tasks)</span></th>
