<th id="Pt0.A1.T3.2.25.1" class="ltx_td ltx_align_left ltx_th ltx_th_row" style="padding:0.25pt 4.0pt;">place bread skillet</th>
<td id="Pt0.A1.T3.2.25.2" class="ltx_td ltx_align_center" style="padding:0.25pt 4.0pt;">94</td>
