<td id="Pt0.A1.T3.2.27.3" class="ltx_td ltx_align_center ltx_border_bb ltx_border_t" style="padding:0.25pt 4.0pt;"><span id="Pt0.A1.T3.2.27.3.1" class="ltx_text ltx_font_bold">90.1</span>   </td>
<th id="Pt0.A1.T3.2.27.4" class="ltx_td ltx_nopad_l ltx_th ltx_th_row ltx_border_bb ltx_border_t" style="padding:0.25pt 4.0pt;"></th>
