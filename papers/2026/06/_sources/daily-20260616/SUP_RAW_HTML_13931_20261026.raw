<span id="S3.T4.2.28.9.1" class="ltx_inline-block ltx_align_top" style="width:43.2pt;">
<span id="S3.T4.2.28.9.1.1" class="ltx_p ltx_align_center"><span id="S3.T4.2.28.9.1.1.1" class="ltx_text ltx_align_center ltx_inline-block" style="width:345.0pt;--ltx-bg-color:#F2F9F8;">0.268</span></span>
