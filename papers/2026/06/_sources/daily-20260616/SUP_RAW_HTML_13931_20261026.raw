<span id="A7.T25.2.2.2.1" class="ltx_inline-block ltx_align_top">
<span id="A7.T25.2.2.2.1.1" class="ltx_p ltx_align_left">40</span>
</span></td></tr>
<tr id="A7.T25.2.3" class="ltx_tr">
<td id="A7.T25.2.3.1" class="ltx_td ltx_align_left ltx_align_top" style="padding-left:3.0pt;padding-right:3.0pt;">
<span id="A7.T25.2.3.1.1" class="ltx_inline-block ltx_align_top" style="width:134.6pt;">
