<span id="S1.T1.6.10.7.1" class="ltx_inline-block ltx_align_top" style="width:40.4pt;--ltx-bg-color:#F1F1F1;">
<span id="S1.T1.6.10.7.1.1" class="ltx_p ltx_align_center"><span id="S1.T1.6.10.7.1.1.1" class="ltx_text" style="--ltx-fg-color:#007300;">✓</span></span>
