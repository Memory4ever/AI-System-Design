<span id="S2.T3.2.7.1.1.1" class="ltx_p ltx_align_left">Fact Resolution</span>
</span></td>
<td id="S2.T3.2.7.2" class="ltx_td ltx_nopad_r ltx_align_left ltx_border_t" style="padding:0.2pt 3.0pt;">
