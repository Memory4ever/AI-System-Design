<th id="A1.T3.2.1.3.6" class="ltx_td ltx_align_center ltx_th ltx_th_column ltx_border_r ltx_border_t">620.5</th>
<th id="A1.T3.2.1.3.7" class="ltx_td ltx_align_center ltx_th ltx_th_column ltx_border_t">59.53</th>
<th id="A1.T3.2.1.3.8" class="ltx_td ltx_align_center ltx_th ltx_th_column ltx_border_t">660.5</th></tr>
