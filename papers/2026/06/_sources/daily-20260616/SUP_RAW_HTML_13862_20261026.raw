<td id="A1.T3.2.1.4.4" class="ltx_td ltx_align_center">33.68</td>
<td id="A1.T3.2.1.4.5" class="ltx_td ltx_align_center ltx_border_r">780.6</td>
<td id="A1.T3.2.1.4.6" class="ltx_td ltx_align_center">66.84</td>
<td id="A1.T3.2.1.4.7" class="ltx_td ltx_align_center">838.6</td></tr>
<tr id="A1.T3.2.1.5" class="ltx_tr">
<th id="A1.T3.2.1.5.1" class="ltx_td ltx_align_left ltx_th ltx_th_column ltx_th_row ltx_border_bb ltx_border_t" rowspan="2"><span id="A1.T3.2.1.5.1.1" class="ltx_text">7B</span></th>
<th id="A1.T3.2.1.5.2" class="ltx_td ltx_align_left ltx_th ltx_th_column ltx_th_row ltx_border_r ltx_border_t">Standard CoT</th>
<th id="A1.T3.2.1.5.3" class="ltx_td ltx_align_center ltx_th ltx_th_column ltx_border_t">83.0</th>
<th id="A1.T3.2.1.5.4" class="ltx_td ltx_align_center ltx_th ltx_th_column ltx_border_r ltx_border_t">538.6</th>
<th id="A1.T3.2.1.5.5" class="ltx_td ltx_align_center ltx_th ltx_th_column ltx_border_t">36.35</th>
<th id="A1.T3.2.1.5.6" class="ltx_td ltx_align_center ltx_th ltx_th_column ltx_border_r ltx_border_t">654.6</th>
<th id="A1.T3.2.1.5.7" class="ltx_td ltx_align_center ltx_th ltx_th_column ltx_border_t">69.22</th>
<th id="A1.T3.2.1.5.8" class="ltx_td ltx_align_center ltx_th ltx_th_column ltx_border_t">749.4</th></tr>
