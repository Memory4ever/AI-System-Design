<figure id="algorithm5" class="ltx_float ltx_algorithm ltx_framed ltx_framed_top">
<figcaption class="ltx_caption"><span class="ltx_tag ltx_tag_float"><span id="algorithm5.4" class="ltx_text ltx_font_bold">Algorithm 5</span> </span><span id="algorithm5.5" class="ltx_text ltx_font_smallcaps">BuildSequence</span>: Assemble Input and Target Tensors</figcaption>
<div id="algorithm5.6" class="ltx_listing ltx_lst_numbers_left ltx_framed ltx_framed_topbottom ltx_listing">
<div id="algorithm5.6.1" class="ltx_listingline">
<span id="algorithm5.6.1.1" class="ltx_text"><span id="algorithm5.6.1.1.1" class="ltx_text ltx_font_bold">Input:</span> </span>Question <math id="algorithm5.m1" class="ltx_Math" alttext="q" display="inline" intent=":literal"><semantics><mi>q</mi><annotation encoding="application/x-tex">q</annotation></semantics></math>, answer <math id="algorithm5.m2" class="ltx_Math" alttext="a" display="inline" intent=":literal"><semantics><mi>a</mi><annotation encoding="application/x-tex">a</annotation></semantics></math>, padded chain <math id="algorithm5.m3" class="ltx_Math" alttext="\tilde{\mathbf{c}}" display="inline" intent=":literal"><semantics><mover accent="true"><mi>𝐜</mi><mo>~</mo></mover><annotation encoding="application/x-tex">\tilde{\mathbf{c}}</annotation></semantics></math>, padding mask <math id="algorithm5.m4" class="ltx_Math" alttext="\mathbf{m}" display="inline" intent=":literal"><semantics><mi>𝐦</mi><annotation encoding="application/x-tex">\mathbf{m}</annotation></semantics></math>, window size <math id="algorithm5.m5" class="ltx_Math" alttext="k" display="inline" intent=":literal"><semantics><mi>k</mi><annotation encoding="application/x-tex">k</annotation></semantics></math>, flag <span id="algorithm5.6.1.2" class="ltx_text ltx_markedasmath ltx_font_typewriter">is_mtp</span>
</div>
<div id="algorithm5.6.2" class="ltx_listingline"><span id="algorithm5.6.2.1" class="ltx_text"><span id="algorithm5.6.2.1.1" class="ltx_text ltx_font_bold">Output:</span> </span>Input ids <math id="algorithm5.m7" class="ltx_Math" alttext="\mathbf{x}" display="inline" intent=":literal"><semantics><mi>𝐱</mi><annotation encoding="application/x-tex">\mathbf{x}</annotation></semantics></math>, grouped CoT inputs <math id="algorithm5.m8" class="ltx_Math" alttext="\mathbf{G}\in\mathbb{Z}^{L\times k}" display="inline" intent=":literal"><semantics><mrow><mi>𝐆</mi><mo>∈</mo><msup><mi>ℤ</mi><mrow><mi>L</mi><mo lspace="0.222em" rspace="0.222em">×</mo><mi>k</mi></mrow></msup></mrow><annotation encoding="application/x-tex">\mathbf{G}\in\mathbb{Z}^{L\times k}</annotation></semantics></math>, valid masks <math id="algorithm5.m9" class="ltx_Math" alttext="\mathbf{V}\in\{0,1\}^{L\times k}" display="inline" intent=":literal"><semantics><mrow><mi>𝐕</mi><mo>∈</mo><msup><mrow><mo stretchy="false">{</mo><mrow><mn>0</mn><mo>,</mo><mn>1</mn></mrow><mo stretchy="false">}</mo></mrow><mrow><mi>L</mi><mo lspace="0.222em" rspace="0.222em">×</mo><mi>k</mi></mrow></msup></mrow><annotation encoding="application/x-tex">\mathbf{V}\in\{0,1\}^{L\times k}</annotation></semantics></math>, targets <math id="algorithm5.m10" class="ltx_Math" alttext="\mathbf{y}" display="inline" intent=":literal"><semantics><mi>𝐲</mi><annotation encoding="application/x-tex">\mathbf{y}</annotation></semantics></math>
</div>
<div id="algorithm5.6.3" class="ltx_listingline"><span id="algorithm5.6.3.1" class="ltx_text ltx_font_typewriter">// </span><span id="algorithm5.6.3.2" class="ltx_text ltx_font_typewriter">Tokenize with chat template </span>
</div>
<div id="algorithm5.6.4" class="ltx_listingline">
            <span class="ltx_tag ltx_tag_listingline"><span id="algorithm5.6.4.1" class="ltx_text ltx_font_bold">1</span></span>
          <math id="algorithm5.m11" class="ltx_Math" alttext="\mathbf{t}\leftarrow\textsc{ChatTemplate}(q,a)" display="inline" intent=":literal"><semantics><mrow><mi>𝐭</mi><mo stretchy="false">←</mo><mrow><mtext class="ltx_font_smallcaps">ChatTemplate</mtext><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>q</mi><mo>,</mo><mi>a</mi><mo stretchy="false">)</mo></mrow></mrow></mrow><annotation encoding="application/x-tex">\mathbf{t}\leftarrow\textsc{ChatTemplate}(q,a)</annotation></semantics></math>;  <span id="algorithm5.6.4.2" class="ltx_text ltx_font_typewriter">// </span><span id="algorithm5.6.4.3" class="ltx_text ltx_font_typewriter">contains &lt;think&gt; <math id="algorithm5.m12" class="ltx_Math" alttext="\dots" display="inline" intent=":literal"><semantics><mi mathvariant="normal">…</mi><annotation encoding="application/x-tex">\dots</annotation></semantics></math> &lt;/think&gt;</span>
</div>
<div id="algorithm5.6.5" class="ltx_listingline">
            <span class="ltx_tag ltx_tag_listingline"><span id="algorithm5.6.5.1" class="ltx_text ltx_font_bold">2</span></span>
          <math id="algorithm5.m13" class="ltx_Math" alttext="b\leftarrow\text{index of }\texttt{&lt;think&gt;}\text{ in }\mathbf{t}" display="inline" intent=":literal"><semantics><mrow><mi>b</mi><mo stretchy="false">←</mo><mrow><mrow><mtext>index of </mtext><mtext class="ltx_mathvariant_monospace">&lt;think&gt;</mtext><mtext> in </mtext></mrow><mo lspace="0em" rspace="0em">​</mo><mi>𝐭</mi></mrow></mrow><annotation encoding="application/x-tex">b\leftarrow\text{index of }\texttt{&lt;think&gt;}\text{ in }\mathbf{t}</annotation></semantics></math>;
</div>
<div id="algorithm5.6.6" class="ltx_listingline">
            <span class="ltx_tag ltx_tag_listingline"><span id="algorithm5.6.6.1" class="ltx_text ltx_font_bold">3</span></span>
          <math id="algorithm5.m14" class="ltx_Math" alttext="e\leftarrow\text{index of }\texttt{&lt;/think&gt;}\text{ in }\mathbf{t}" display="inline" intent=":literal"><semantics><mrow><mi>e</mi><mo stretchy="false">←</mo><mrow><mrow><mtext>index of </mtext><mtext class="ltx_mathvariant_monospace">&lt;/think&gt;</mtext><mtext> in </mtext></mrow><mo lspace="0em" rspace="0em">​</mo><mi>𝐭</mi></mrow></mrow><annotation encoding="application/x-tex">e\leftarrow\text{index of }\texttt{&lt;/think&gt;}\text{ in }\mathbf{t}</annotation></semantics></math>;
</div>
<div id="algorithm5.6.7" class="ltx_listingline"><span id="algorithm5.6.7.1" class="ltx_text ltx_font_typewriter">// </span><span id="algorithm5.6.7.2" class="ltx_text ltx_font_typewriter">Group padded chain into <math id="algorithm5.m15" class="ltx_Math" alttext="k" display="inline" intent=":literal"><semantics><mi>k</mi><annotation encoding="application/x-tex">k</annotation></semantics></math>-windows </span>
</div>
<div id="algorithm5.6.8" class="ltx_listingline">
            <span class="ltx_tag ltx_tag_listingline"><span id="algorithm5.6.8.1" class="ltx_text ltx_font_bold">4</span></span>
          <math id="algorithm5.m16" class="ltx_Math" alttext="G_{l}\leftarrow(\tilde{c}_{(l-1)k+1},\dots,\tilde{c}_{lk})" display="inline" intent=":literal"><semantics><mrow><msub><mi>G</mi><mi>l</mi></msub><mo stretchy="false">←</mo><mrow><mo stretchy="false">(</mo><msub><mover accent="true"><mi>c</mi><mo>~</mo></mover><mrow><mrow><mrow><mo stretchy="false">(</mo><mrow><mi>l</mi><mo>−</mo><mn>1</mn></mrow><mo stretchy="false">)</mo></mrow><mo lspace="0em" rspace="0em">​</mo><mi>k</mi></mrow><mo>+</mo><mn>1</mn></mrow></msub><mo>,</mo><mi mathvariant="normal">…</mi><mo>,</mo><msub><mover accent="true"><mi>c</mi><mo>~</mo></mover><mrow><mi>l</mi><mo lspace="0em" rspace="0em">​</mo><mi>k</mi></mrow></msub><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">G_{l}\leftarrow(\tilde{c}_{(l-1)k+1},\dots,\tilde{c}_{lk})</annotation></semantics></math> for <math id="algorithm5.m17" class="ltx_Math" alttext="l=1,\dots,L_{\text{cot}}" display="inline" intent=":literal"><semantics><mrow><mrow><mi>l</mi><mo>=</mo><mn>1</mn></mrow><mo>,</mo><mi mathvariant="normal">…</mi><mo>,</mo><msub><mi>L</mi><mtext>cot</mtext></msub></mrow><annotation encoding="application/x-tex">l=1,\dots,L_{\text{cot}}</annotation></semantics></math>;
</div>
<div id="algorithm5.6.9" class="ltx_listingline">
            <span class="ltx_tag ltx_tag_listingline"><span id="algorithm5.6.9.1" class="ltx_text ltx_font_bold">5</span></span>
          <math id="algorithm5.m18" class="ltx_Math" alttext="V_{l}\leftarrow(\lnot\,m_{(l-1)k+1},\dots,\lnot\,m_{lk})" display="inline" intent=":literal"><semantics><mrow><msub><mi>V</mi><mi>l</mi></msub><mo stretchy="false">←</mo><mrow><mo stretchy="false">(</mo><mrow><mo rspace="0.337em">¬</mo><msub><mi>m</mi><mrow><mrow><mrow><mo stretchy="false">(</mo><mrow><mi>l</mi><mo>−</mo><mn>1</mn></mrow><mo stretchy="false">)</mo></mrow><mo lspace="0em" rspace="0em">​</mo><mi>k</mi></mrow><mo>+</mo><mn>1</mn></mrow></msub></mrow><mo>,</mo><mi mathvariant="normal">…</mi><mo>,</mo><mrow><mo rspace="0.337em">¬</mo><msub><mi>m</mi><mrow><mi>l</mi><mo lspace="0em" rspace="0em">​</mo><mi>k</mi></mrow></msub></mrow><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">V_{l}\leftarrow(\lnot\,m_{(l-1)k+1},\dots,\lnot\,m_{lk})</annotation></semantics></math> for <math id="algorithm5.m19" class="ltx_Math" alttext="l=1,\dots,L_{\text{cot}}" display="inline" intent=":literal"><semantics><mrow><mrow><mi>l</mi><mo>=</mo><mn>1</mn></mrow><mo>,</mo><mi mathvariant="normal">…</mi><mo>,</mo><msub><mi>L</mi><mtext>cot</mtext></msub></mrow><annotation encoding="application/x-tex">l=1,\dots,L_{\text{cot}}</annotation></semantics></math>;
</div>
<div id="algorithm5.6.10" class="ltx_listingline"><span id="algorithm5.6.10.1" class="ltx_text ltx_font_typewriter">// </span><span id="algorithm5.6.10.2" class="ltx_text ltx_font_typewriter">Construct input ids: replace reasoning span with placeholders </span>
</div>
<div id="algorithm5.6.11" class="ltx_listingline">
            <span class="ltx_tag ltx_tag_listingline"><span id="algorithm5.6.11.1" class="ltx_text ltx_font_bold">6</span></span>
          <math id="algorithm5.m20" class="ltx_math_unparsed" alttext="\mathbf{x}\leftarrow[\,\mathbf{t}_{1:b},\;\underbrace{\textsc{pad},\dots,\textsc{pad}}_{L_{\text{cot}}},\;\mathbf{t}_{e:|t|}\,]" display="inline" intent=":literal"><semantics><mrow><mi>𝐱</mi><mo stretchy="false">←</mo><mrow><mo rspace="0.170em" stretchy="false">[</mo><msub><mi>𝐭</mi><mrow><mn>1</mn><mo lspace="0.278em" rspace="0.278em">:</mo><mi>b</mi></mrow></msub><mo rspace="0.447em">,</mo><munder><munder accentunder="true"><mrow><mtext class="ltx_font_smallcaps">pad</mtext><mo>,</mo><mi mathvariant="normal">…</mi><mo>,</mo><mtext class="ltx_font_smallcaps">pad</mtext></mrow><mo stretchy="true">⏟</mo></munder><msub><mi>L</mi><mtext>cot</mtext></msub></munder><mo rspace="0.447em">,</mo><msub><mi>𝐭</mi><mrow><mi>e</mi><mo lspace="0.278em" rspace="0.278em">:</mo><mrow><mo stretchy="false">|</mo><mi>t</mi><mo stretchy="false">|</mo></mrow></mrow></msub><mo stretchy="false">]</mo></mrow></mrow><annotation encoding="application/x-tex">\mathbf{x}\leftarrow[\,\mathbf{t}_{1:b},\;\underbrace{\textsc{pad},\dots,\textsc{pad}}_{L_{\text{cot}}},\;\mathbf{t}_{e:|t|}\,]</annotation></semantics></math>;
</div>
<div id="algorithm5.6.12" class="ltx_listingline">
            <span class="ltx_tag ltx_tag_listingline"><span id="algorithm5.6.12.1" class="ltx_text ltx_font_bold">7</span></span>
          <math id="algorithm5.m21" class="ltx_Math" alttext="r_{\text{start}}\leftarrow b+1,\quad r_{\text{end}}\leftarrow b+L_{\text{cot}}" display="inline" intent=":literal"><semantics><mrow><mrow><msub><mi>r</mi><mtext>start</mtext></msub><mo stretchy="false">←</mo><mrow><mi>b</mi><mo>+</mo><mn>1</mn></mrow></mrow><mo rspace="1.167em">,</mo><mrow><msub><mi>r</mi><mtext>end</mtext></msub><mo stretchy="false">←</mo><mrow><mi>b</mi><mo>+</mo><msub><mi>L</mi><mtext>cot</mtext></msub></mrow></mrow></mrow><annotation encoding="application/x-tex">r_{\text{start}}\leftarrow b+1,\quad r_{\text{end}}\leftarrow b+L_{\text{cot}}</annotation></semantics></math>;
</div>
<div id="algorithm5.6.13" class="ltx_listingline">
            <span class="ltx_tag ltx_tag_listingline"><span id="algorithm5.6.13.1" class="ltx_text ltx_font_bold">8</span></span>
          <math id="algorithm5.m22" class="ltx_math_unparsed" alttext="\mathbf{G}[r_{\text{start}}:r_{\text{end}}]\leftarrow(G_{1},\dots,G_{L_{\text{cot}}})" display="inline" intent=":literal"><semantics><mrow><mi>𝐆</mi><mrow><mo stretchy="false">[</mo><msub><mi>r</mi><mtext>start</mtext></msub><mo lspace="0.278em" rspace="0.278em">:</mo><msub><mi>r</mi><mtext>end</mtext></msub><mo stretchy="false">]</mo></mrow><mo stretchy="false">←</mo><mrow><mo stretchy="false">(</mo><msub><mi>G</mi><mn>1</mn></msub><mo>,</mo><mi mathvariant="normal">…</mi><mo>,</mo><msub><mi>G</mi><msub><mi>L</mi><mtext>cot</mtext></msub></msub><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">\mathbf{G}[r_{\text{start}}:r_{\text{end}}]\leftarrow(G_{1},\dots,G_{L_{\text{cot}}})</annotation></semantics></math>;  <span id="algorithm5.6.13.2" class="ltx_text ltx_font_typewriter">// </span><span id="algorithm5.6.13.3" class="ltx_text ltx_font_typewriter">elsewhere filled with <span id="algorithm5.6.13.3.1" class="ltx_text ltx_font_smallcaps">pad</span></span>
</div>
<div id="algorithm5.6.14" class="ltx_listingline">
            <span class="ltx_tag ltx_tag_listingline"><span id="algorithm5.6.14.1" class="ltx_text ltx_font_bold">9</span></span>
          <math id="algorithm5.m23" class="ltx_math_unparsed" alttext="\mathbf{V}[r_{\text{start}}:r_{\text{end}}]\leftarrow(V_{1},\dots,V_{L_{\text{cot}}})" display="inline" intent=":literal"><semantics><mrow><mi>𝐕</mi><mrow><mo stretchy="false">[</mo><msub><mi>r</mi><mtext>start</mtext></msub><mo lspace="0.278em" rspace="0.278em">:</mo><msub><mi>r</mi><mtext>end</mtext></msub><mo stretchy="false">]</mo></mrow><mo stretchy="false">←</mo><mrow><mo stretchy="false">(</mo><msub><mi>V</mi><mn>1</mn></msub><mo>,</mo><mi mathvariant="normal">…</mi><mo>,</mo><msub><mi>V</mi><msub><mi>L</mi><mtext>cot</mtext></msub></msub><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">\mathbf{V}[r_{\text{start}}:r_{\text{end}}]\leftarrow(V_{1},\dots,V_{L_{\text{cot}}})</annotation></semantics></math>;  <span id="algorithm5.6.14.2" class="ltx_text ltx_font_typewriter">// </span><span id="algorithm5.6.14.3" class="ltx_text ltx_font_typewriter">elsewhere false</span>
</div>
<div id="algorithm5.6.15" class="ltx_listingline">
            <span class="ltx_tag ltx_tag_listingline"><span id="algorithm5.6.15.1" class="ltx_text ltx_font_bold">10</span></span>
          <math id="algorithm5.m24" class="ltx_Math" alttext="\texttt{cot\_mask}_{i}\leftarrow\bigvee_{j=1}^{k}V_{i,j}" display="inline" intent=":literal"><semantics><mrow><msub><mtext class="ltx_mathvariant_monospace">cot_mask</mtext><mi>i</mi></msub><mo rspace="0.111em" stretchy="false">←</mo><mrow><msubsup><mo>⋁</mo><mrow><mi>j</mi><mo>=</mo><mn>1</mn></mrow><mi>k</mi></msubsup><msub><mi>V</mi><mrow><mi>i</mi><mo>,</mo><mi>j</mi></mrow></msub></mrow></mrow><annotation encoding="application/x-tex">\texttt{cot\_mask}_{i}\leftarrow\bigvee_{j=1}^{k}V_{i,j}</annotation></semantics></math>;  <span id="algorithm5.6.15.2" class="ltx_text ltx_font_typewriter">// </span><span id="algorithm5.6.15.3" class="ltx_text ltx_font_typewriter">true if position <math id="algorithm5.m25" class="ltx_Math" alttext="i" display="inline" intent=":literal"><semantics><mi>i</mi><annotation encoding="application/x-tex">i</annotation></semantics></math> has any valid CoT token</span>
</div>
<div id="algorithm5.6.16" class="ltx_listingline"><span id="algorithm5.6.16.1" class="ltx_text ltx_font_typewriter">// </span><span id="algorithm5.6.16.2" class="ltx_text ltx_font_typewriter">Construct targets </span>
</div>
<div id="algorithm5.6.17" class="ltx_listingline">
            <span class="ltx_tag ltx_tag_listingline"><span id="algorithm5.6.17.1" class="ltx_text ltx_font_bold">11</span></span>
          <span id="algorithm5.6.17.2" class="ltx_text ltx_font_bold">for</span> <em id="algorithm5.6.17.3" class="ltx_emph ltx_font_italic"><math id="algorithm5.m26" class="ltx_Math" alttext="i\leftarrow 1" display="inline" intent=":literal"><semantics><mrow><mi>i</mi><mo stretchy="false">←</mo><mn>1</mn></mrow><annotation encoding="application/x-tex">i\leftarrow 1</annotation></semantics></math> <span id="algorithm5.6.17.3.1" class="ltx_text ltx_font_bold ltx_font_upright">to</span> <math id="algorithm5.m27" class="ltx_Math" alttext="L" display="inline" intent=":literal"><semantics><mi>L</mi><annotation encoding="application/x-tex">L</annotation></semantics></math></em> <span id="algorithm5.6.17.4" class="ltx_text ltx_font_bold">do</span>
</div>
<div id="algorithm5.6.18" class="ltx_listingline"> <span class="ltx_rule" style="width:1px;height:100%;--ltx-bg-color:black;display:inline-block;"> </span> 
            <span class="ltx_tag ltx_tag_listingline"><span id="algorithm5.6.18.1" class="ltx_text ltx_font_bold">12</span></span>
          <span id="algorithm5.6.18.2" class="ltx_text ltx_font_bold">if</span> <em id="algorithm5.6.18.3" class="ltx_emph ltx_font_italic"><math id="algorithm5.m28" class="ltx_Math" alttext="\texttt{cot\_mask}_{i}" display="inline" intent=":literal"><semantics><msub><mtext class="ltx_mathvariant_monospace">cot_mask</mtext><mi>i</mi></msub><annotation encoding="application/x-tex">\texttt{cot\_mask}_{i}</annotation></semantics></math></em> <span id="algorithm5.6.18.4" class="ltx_text ltx_font_bold">then</span>
</div>
<div id="algorithm5.6.19" class="ltx_listingline"> <span class="ltx_rule" style="width:1px;height:100%;--ltx-bg-color:black;display:inline-block;"> </span>  <span class="ltx_rule" style="width:1px;height:100%;--ltx-bg-color:black;display:inline-block;"> </span> 
            <span class="ltx_tag ltx_tag_listingline"><span id="algorithm5.6.19.1" class="ltx_text ltx_font_bold">13</span></span>
          <math id="algorithm5.m29" class="ltx_Math" alttext="\mathbf{y}_{i}\leftarrow" display="inline" intent=":literal"><semantics><mrow><msub><mi>𝐲</mi><mi>i</mi></msub><mo stretchy="false">←</mo><mphantom></mphantom></mrow><annotation encoding="application/x-tex">\mathbf{y}_{i}\leftarrow</annotation></semantics></math> first <math id="algorithm5.m30" class="ltx_Math" alttext="G_{l(i)+1}[j]" display="inline" intent=":literal"><semantics><mrow><msub><mi>G</mi><mrow><mrow><mi>l</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>i</mi><mo stretchy="false">)</mo></mrow></mrow><mo>+</mo><mn>1</mn></mrow></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">[</mo><mi>j</mi><mo stretchy="false">]</mo></mrow></mrow><annotation encoding="application/x-tex">G_{l(i)+1}[j]</annotation></semantics></math> such that <math id="algorithm5.m31" class="ltx_Math" alttext="G_{l(i)+1}[j]\neq\textsc{cot\_pad}" display="inline" intent=":literal"><semantics><mrow><mrow><msub><mi>G</mi><mrow><mrow><mi>l</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>i</mi><mo stretchy="false">)</mo></mrow></mrow><mo>+</mo><mn>1</mn></mrow></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">[</mo><mi>j</mi><mo stretchy="false">]</mo></mrow></mrow><mo>≠</mo><mtext class="ltx_font_smallcaps">cot_pad</mtext></mrow><annotation encoding="application/x-tex">G_{l(i)+1}[j]\neq\textsc{cot\_pad}</annotation></semantics></math>;  <span id="algorithm5.6.19.2" class="ltx_text ltx_font_typewriter">// </span><span id="algorithm5.6.19.3" class="ltx_text ltx_font_typewriter">next window’s first valid token</span>
</div>
<div id="algorithm5.6.20" class="ltx_listingline"> <span class="ltx_rule" style="width:1px;height:100%;--ltx-bg-color:black;display:inline-block;"> </span> 
            <span class="ltx_tag ltx_tag_listingline"><span id="algorithm5.6.20.1" class="ltx_text ltx_font_bold">14</span></span>
          <span id="algorithm5.6.20.2" class="ltx_text ltx_font_bold">else if</span> <em id="algorithm5.6.20.3" class="ltx_emph ltx_font_italic"><span id="algorithm5.6.20.3.1" class="ltx_text ltx_markedasmath ltx_font_typewriter">is_mtp</span> <span id="algorithm5.6.20.3.2" class="ltx_text ltx_font_bold">or</span> <math id="algorithm5.m33" class="ltx_Math" alttext="i\leq r_{\text{end}}" display="inline" intent=":literal"><semantics><mrow><mi>i</mi><mo>≤</mo><msub><mi>r</mi><mtext class="ltx_mathvariant_italic">end</mtext></msub></mrow><annotation encoding="application/x-tex">i\leq r_{\text{end}}</annotation></semantics></math></em> <span id="algorithm5.6.20.4" class="ltx_text ltx_font_bold">then</span>
</div>
<div id="algorithm5.6.21" class="ltx_listingline"> <span class="ltx_rule" style="width:1px;height:100%;--ltx-bg-color:black;display:inline-block;"> </span>  <span class="ltx_rule" style="width:1px;height:100%;--ltx-bg-color:black;display:inline-block;"> </span> 
            <span class="ltx_tag ltx_tag_listingline"><span id="algorithm5.6.21.1" class="ltx_text ltx_font_bold">15</span></span>
          <math id="algorithm5.m34" class="ltx_Math" alttext="\mathbf{y}_{i}\leftarrow\textsc{ignore}" display="inline" intent=":literal"><semantics><mrow><msub><mi>𝐲</mi><mi>i</mi></msub><mo stretchy="false">←</mo><mtext class="ltx_font_smallcaps">ignore</mtext></mrow><annotation encoding="application/x-tex">\mathbf{y}_{i}\leftarrow\textsc{ignore}</annotation></semantics></math>;  <span id="algorithm5.6.21.2" class="ltx_text ltx_font_typewriter">// </span><span id="algorithm5.6.21.3" class="ltx_text ltx_font_typewriter">mask out question region; MTP masks answer too</span>
</div>
<div id="algorithm5.6.22" class="ltx_listingline"> <span class="ltx_rule" style="width:1px;height:100%;--ltx-bg-color:black;display:inline-block;"> </span> 
            <span class="ltx_tag ltx_tag_listingline"><span id="algorithm5.6.22.1" class="ltx_text ltx_font_bold">16</span></span>
          <span id="algorithm5.6.22.2" class="ltx_text ltx_font_bold">else</span>
</div>
<div id="algorithm5.6.23" class="ltx_listingline"> <span class="ltx_rule" style="width:1px;height:100%;--ltx-bg-color:black;display:inline-block;"> </span>  <span class="ltx_rule" style="width:1px;height:100%;--ltx-bg-color:black;display:inline-block;"> </span> 
            <span class="ltx_tag ltx_tag_listingline"><span id="algorithm5.6.23.1" class="ltx_text ltx_font_bold">17</span></span>
          <math id="algorithm5.m35" class="ltx_Math" alttext="\mathbf{y}_{i}\leftarrow\mathbf{x}_{i+1}" display="inline" intent=":literal"><semantics><mrow><msub><mi>𝐲</mi><mi>i</mi></msub><mo stretchy="false">←</mo><msub><mi>𝐱</mi><mrow><mi>i</mi><mo>+</mo><mn>1</mn></mrow></msub></mrow><annotation encoding="application/x-tex">\mathbf{y}_{i}\leftarrow\mathbf{x}_{i+1}</annotation></semantics></math>;  <span id="algorithm5.6.23.2" class="ltx_text ltx_font_typewriter">// </span><span id="algorithm5.6.23.3" class="ltx_text ltx_font_typewriter">standard next-token prediction for answer</span>
</div>
<div id="algorithm5.6.24" class="ltx_listingline">
            <span class="ltx_tag ltx_tag_listingline"><span id="algorithm5.6.24.1" class="ltx_text ltx_font_bold">18</span></span>
          <span id="algorithm5.6.24.2" class="ltx_text ltx_font_bold">if</span> <em id="algorithm5.6.24.3" class="ltx_emph ltx_font_italic"><math id="algorithm5.m36" class="ltx_Math" alttext="\lnot\,\texttt{is\_mtp}" display="inline" intent=":literal"><semantics><mrow><mo rspace="0.337em">¬</mo><mtext class="ltx_mathvariant_monospace">is_mtp</mtext></mrow><annotation encoding="application/x-tex">\lnot\,\texttt{is\_mtp}</annotation></semantics></math></em> <span id="algorithm5.6.24.4" class="ltx_text ltx_font_bold">then</span>
</div>
<div id="algorithm5.6.25" class="ltx_listingline"> <span class="ltx_rule" style="width:1px;height:100%;--ltx-bg-color:black;display:inline-block;"> </span> 
            <span class="ltx_tag ltx_tag_listingline"><span id="algorithm5.6.25.1" class="ltx_text ltx_font_bold">19</span></span>
          <math id="algorithm5.m37" class="ltx_Math" alttext="\mathbf{y}_{b}\leftarrow G_{1}[1]" display="inline" intent=":literal"><semantics><mrow><msub><mi>𝐲</mi><mi>b</mi></msub><mo stretchy="false">←</mo><mrow><msub><mi>G</mi><mn>1</mn></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">[</mo><mn>1</mn><mo stretchy="false">]</mo></mrow></mrow></mrow><annotation encoding="application/x-tex">\mathbf{y}_{b}\leftarrow G_{1}[1]</annotation></semantics></math>;  <span id="algorithm5.6.25.2" class="ltx_text ltx_font_typewriter">// </span><span id="algorithm5.6.25.3" class="ltx_text ltx_font_typewriter">at &lt;think&gt;, predict first CoT token</span>
</div>
<div id="algorithm5.6.26" class="ltx_listingline">
            <span class="ltx_tag ltx_tag_listingline"><span id="algorithm5.6.26.1" class="ltx_text ltx_font_bold">20</span></span>
          <span id="algorithm5.6.26.2" class="ltx_text ltx_font_bold">return</span> <math id="algorithm5.m38" class="ltx_Math" alttext="\mathbf{x},\,\mathbf{G},\,\mathbf{V},\,\mathbf{y}" display="inline" intent=":literal"><semantics><mrow><mi>𝐱</mi><mo rspace="0.337em">,</mo><mi>𝐆</mi><mo rspace="0.337em">,</mo><mi>𝐕</mi><mo rspace="0.337em">,</mo><mi>𝐲</mi></mrow><annotation encoding="application/x-tex">\mathbf{x},\,\mathbf{G},\,\mathbf{V},\,\mathbf{y}</annotation></semantics></math>;
</div>
