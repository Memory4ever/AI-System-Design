<figure id="algorithm4" class="ltx_float ltx_algorithm ltx_framed ltx_framed_top">
<figcaption class="ltx_caption"><span class="ltx_tag ltx_tag_float"><span id="algorithm4.4" class="ltx_text ltx_font_bold">Algorithm 4</span> </span><span id="algorithm4.5" class="ltx_text ltx_font_smallcaps">WindowAlignedPad</span>: Window-Aligned Padding</figcaption>
<div id="algorithm4.6" class="ltx_listing ltx_lst_numbers_left ltx_framed ltx_framed_topbottom ltx_listing">
<div id="algorithm4.6.1" class="ltx_listingline">
<span id="algorithm4.6.1.1" class="ltx_text"><span id="algorithm4.6.1.1.1" class="ltx_text ltx_font_bold">Input:</span> </span>Token ids <math id="algorithm4.m1" class="ltx_Math" alttext="\mathbf{c}" display="inline" intent=":literal"><semantics><mi>𝐜</mi><annotation encoding="application/x-tex">\mathbf{c}</annotation></semantics></math>, special mask <math id="algorithm4.m2" class="ltx_Math" alttext="\mathbf{s}" display="inline" intent=":literal"><semantics><mi>𝐬</mi><annotation encoding="application/x-tex">\mathbf{s}</annotation></semantics></math>, window size <math id="algorithm4.m3" class="ltx_Math" alttext="k" display="inline" intent=":literal"><semantics><mi>k</mi><annotation encoding="application/x-tex">k</annotation></semantics></math>, mode <math id="algorithm4.m4" class="ltx_Math" alttext="\mathcal{M}" display="inline" intent=":literal"><semantics><mi class="ltx_font_mathcaligraphic">ℳ</mi><annotation encoding="application/x-tex">\mathcal{M}</annotation></semantics></math>
</div>
<div id="algorithm4.6.2" class="ltx_listingline"><span id="algorithm4.6.2.1" class="ltx_text"><span id="algorithm4.6.2.1.1" class="ltx_text ltx_font_bold">Output:</span> </span>Padded ids <math id="algorithm4.m5" class="ltx_Math" alttext="\tilde{\mathbf{c}}" display="inline" intent=":literal"><semantics><mover accent="true"><mi>𝐜</mi><mo>~</mo></mover><annotation encoding="application/x-tex">\tilde{\mathbf{c}}</annotation></semantics></math>, padding mask <math id="algorithm4.m6" class="ltx_Math" alttext="\mathbf{m}" display="inline" intent=":literal"><semantics><mi>𝐦</mi><annotation encoding="application/x-tex">\mathbf{m}</annotation></semantics></math> (<math id="algorithm4.m7" class="ltx_Math" alttext="m_{i}=\texttt{true}\Rightarrow" display="inline" intent=":literal"><semantics><mrow><msub><mi>m</mi><mi>i</mi></msub><mo>=</mo><mtext class="ltx_mathvariant_monospace">true</mtext><mo stretchy="false">⇒</mo><mphantom></mphantom></mrow><annotation encoding="application/x-tex">m_{i}=\texttt{true}\Rightarrow</annotation></semantics></math> inserted pad)
</div>
<div id="algorithm4.6.3" class="ltx_listingline">
            <span class="ltx_tag ltx_tag_listingline"><span id="algorithm4.6.3.1" class="ltx_text ltx_font_bold">1</span></span>
          <math id="algorithm4.m8" class="ltx_Math" alttext="\texttt{pad\_right}\leftarrow(\mathcal{M}\neq\texttt{prob-frac})" display="inline" intent=":literal"><semantics><mrow><mtext class="ltx_mathvariant_monospace">pad_right</mtext><mo stretchy="false">←</mo><mrow><mo stretchy="false">(</mo><mrow><mi class="ltx_font_mathcaligraphic">ℳ</mi><mo>≠</mo><mtext class="ltx_mathvariant_monospace">prob-frac</mtext></mrow><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">\texttt{pad\_right}\leftarrow(\mathcal{M}\neq\texttt{prob-frac})</annotation></semantics></math>;  <span id="algorithm4.6.3.2" class="ltx_text ltx_font_typewriter">// </span><span id="algorithm4.6.3.3" class="ltx_text ltx_font_typewriter">isolate specials in own window?</span>
</div>
<div id="algorithm4.6.4" class="ltx_listingline">
            <span class="ltx_tag ltx_tag_listingline"><span id="algorithm4.6.4.1" class="ltx_text ltx_font_bold">2</span></span>
          <math id="algorithm4.m9" class="ltx_Math" alttext="\tilde{\mathbf{c}}\leftarrow[\,],\quad\mathbf{m}\leftarrow[\,],\quad j\leftarrow 0" display="inline" intent=":literal"><semantics><mrow><mrow><mover accent="true"><mi>𝐜</mi><mo>~</mo></mover><mo stretchy="false">←</mo><mrow><mo rspace="0.170em" stretchy="false">[</mo><mo stretchy="false">]</mo></mrow></mrow><mo rspace="1.167em">,</mo><mrow><mi>𝐦</mi><mo stretchy="false">←</mo><mrow><mo rspace="0.170em" stretchy="false">[</mo><mo stretchy="false">]</mo></mrow></mrow><mo rspace="1.167em">,</mo><mrow><mi>j</mi><mo stretchy="false">←</mo><mn>0</mn></mrow></mrow><annotation encoding="application/x-tex">\tilde{\mathbf{c}}\leftarrow[\,],\quad\mathbf{m}\leftarrow[\,],\quad j\leftarrow 0</annotation></semantics></math>;  <span id="algorithm4.6.4.2" class="ltx_text ltx_font_typewriter">// </span><math id="algorithm4.m10" class="ltx_Math" alttext="j" display="inline" intent=":literal"><semantics><mi>j</mi><annotation encoding="application/x-tex">j</annotation></semantics></math><span id="algorithm4.6.4.3" class="ltx_text ltx_font_typewriter">: position within current window</span>
</div>
<div id="algorithm4.6.5" class="ltx_listingline">
            <span class="ltx_tag ltx_tag_listingline"><span id="algorithm4.6.5.1" class="ltx_text ltx_font_bold">3</span></span>
          <span id="algorithm4.6.5.2" class="ltx_text ltx_font_bold">for</span> <em id="algorithm4.6.5.3" class="ltx_emph ltx_font_italic"><math id="algorithm4.m11" class="ltx_Math" alttext="i\leftarrow 1" display="inline" intent=":literal"><semantics><mrow><mi>i</mi><mo stretchy="false">←</mo><mn>1</mn></mrow><annotation encoding="application/x-tex">i\leftarrow 1</annotation></semantics></math> <span id="algorithm4.6.5.3.1" class="ltx_text ltx_font_bold ltx_font_upright">to</span> <math id="algorithm4.m12" class="ltx_Math" alttext="|\mathbf{c}|" display="inline" intent=":literal"><semantics><mrow><mo stretchy="false">|</mo><mi>𝐜</mi><mo stretchy="false">|</mo></mrow><annotation encoding="application/x-tex">|\mathbf{c}|</annotation></semantics></math></em> <span id="algorithm4.6.5.4" class="ltx_text ltx_font_bold">do</span>
</div>
<div id="algorithm4.6.6" class="ltx_listingline"> <span class="ltx_rule" style="width:1px;height:100%;--ltx-bg-color:black;display:inline-block;"> </span> 
            <span class="ltx_tag ltx_tag_listingline"><span id="algorithm4.6.6.1" class="ltx_text ltx_font_bold">4</span></span>
          <span id="algorithm4.6.6.2" class="ltx_text ltx_font_bold">if</span> <em id="algorithm4.6.6.3" class="ltx_emph ltx_font_italic"><math id="algorithm4.m13" class="ltx_Math" alttext="s_{i}" display="inline" intent=":literal"><semantics><msub><mi>s</mi><mi>i</mi></msub><annotation encoding="application/x-tex">s_{i}</annotation></semantics></math></em> <span id="algorithm4.6.6.4" class="ltx_text ltx_font_bold">then</span>
</div>
<div id="algorithm4.6.7" class="ltx_listingline"> <span class="ltx_rule" style="width:1px;height:100%;--ltx-bg-color:black;display:inline-block;"> </span>  <span class="ltx_rule" style="width:1px;height:100%;--ltx-bg-color:black;display:inline-block;"> </span> 
            <span class="ltx_tag ltx_tag_listingline"><span id="algorithm4.6.7.1" class="ltx_text ltx_font_bold">5</span></span>
          <span id="algorithm4.6.7.2" class="ltx_text ltx_font_bold">if</span> <em id="algorithm4.6.7.3" class="ltx_emph ltx_font_italic"><math id="algorithm4.m14" class="ltx_Math" alttext="j\neq 0" display="inline" intent=":literal"><semantics><mrow><mi>j</mi><mo>≠</mo><mn>0</mn></mrow><annotation encoding="application/x-tex">j\neq 0</annotation></semantics></math></em> <span id="algorithm4.6.7.4" class="ltx_text ltx_font_bold">then</span>  <span id="algorithm4.6.7.5" class="ltx_text ltx_font_typewriter">// </span><span id="algorithm4.6.7.6" class="ltx_text ltx_font_typewriter">pad to finish current window</span>
</div>
<div id="algorithm4.6.8" class="ltx_listingline"> <span class="ltx_rule" style="width:1px;height:100%;--ltx-bg-color:black;display:inline-block;"> </span>  <span class="ltx_rule" style="width:1px;height:100%;--ltx-bg-color:black;display:inline-block;"> </span>  <span class="ltx_rule" style="width:1px;height:100%;--ltx-bg-color:black;display:inline-block;"> </span> 
            <span class="ltx_tag ltx_tag_listingline"><span id="algorithm4.6.8.1" class="ltx_text ltx_font_bold">6</span></span>
          <math id="algorithm4.m15" class="ltx_Math" alttext="\tilde{\mathbf{c}}\mathrel{{+}{=}}[\textsc{cot\_pad}]^{k-j},\quad\mathbf{m}\mathrel{{+}{=}}[\texttt{true}]^{k-j}" display="inline" intent=":literal"><semantics><mrow><mrow><mover accent="true"><mi>𝐜</mi><mo>~</mo></mover><mrow><mo>+</mo><mo lspace="0em">⁣</mo><mo>=</mo></mrow><msup><mrow><mo stretchy="false">[</mo><mtext class="ltx_font_smallcaps">cot_pad</mtext><mo stretchy="false">]</mo></mrow><mrow><mi>k</mi><mo>−</mo><mi>j</mi></mrow></msup></mrow><mo rspace="1.167em">,</mo><mrow><mi>𝐦</mi><mrow><mo>+</mo><mo lspace="0em">⁣</mo><mo>=</mo></mrow><msup><mrow><mo stretchy="false">[</mo><mtext class="ltx_mathvariant_monospace">true</mtext><mo stretchy="false">]</mo></mrow><mrow><mi>k</mi><mo>−</mo><mi>j</mi></mrow></msup></mrow></mrow><annotation encoding="application/x-tex">\tilde{\mathbf{c}}\mathrel{{+}{=}}[\textsc{cot\_pad}]^{k-j},\quad\mathbf{m}\mathrel{{+}{=}}[\texttt{true}]^{k-j}</annotation></semantics></math>;
</div>
<div id="algorithm4.6.9" class="ltx_listingline"> <span class="ltx_rule" style="width:1px;height:100%;--ltx-bg-color:black;display:inline-block;"> </span>  <span class="ltx_rule" style="width:1px;height:100%;--ltx-bg-color:black;display:inline-block;"> </span> 
            <span class="ltx_tag ltx_tag_listingline"><span id="algorithm4.6.9.1" class="ltx_text ltx_font_bold">7</span></span>
          <math id="algorithm4.m16" class="ltx_Math" alttext="\tilde{\mathbf{c}}\mathrel{{+}{=}}c_{i},\quad\mathbf{m}\mathrel{{+}{=}}\texttt{false}" display="inline" intent=":literal"><semantics><mrow><mrow><mover accent="true"><mi>𝐜</mi><mo>~</mo></mover><mrow><mo>+</mo><mo lspace="0em">⁣</mo><mo>=</mo></mrow><msub><mi>c</mi><mi>i</mi></msub></mrow><mo rspace="1.167em">,</mo><mrow><mi>𝐦</mi><mrow><mo>+</mo><mo lspace="0em">⁣</mo><mo>=</mo></mrow><mtext class="ltx_mathvariant_monospace">false</mtext></mrow></mrow><annotation encoding="application/x-tex">\tilde{\mathbf{c}}\mathrel{{+}{=}}c_{i},\quad\mathbf{m}\mathrel{{+}{=}}\texttt{false}</annotation></semantics></math>;
</div>
<div id="algorithm4.6.10" class="ltx_listingline"> <span class="ltx_rule" style="width:1px;height:100%;--ltx-bg-color:black;display:inline-block;"> </span>  <span class="ltx_rule" style="width:1px;height:100%;--ltx-bg-color:black;display:inline-block;"> </span> 
            <span class="ltx_tag ltx_tag_listingline"><span id="algorithm4.6.10.1" class="ltx_text ltx_font_bold">8</span></span>
          <math id="algorithm4.m17" class="ltx_Math" alttext="j\leftarrow 1" display="inline" intent=":literal"><semantics><mrow><mi>j</mi><mo stretchy="false">←</mo><mn>1</mn></mrow><annotation encoding="application/x-tex">j\leftarrow 1</annotation></semantics></math>;
</div>
<div id="algorithm4.6.11" class="ltx_listingline"> <span class="ltx_rule" style="width:1px;height:100%;--ltx-bg-color:black;display:inline-block;"> </span>  <span class="ltx_rule" style="width:1px;height:100%;--ltx-bg-color:black;display:inline-block;"> </span> 
            <span class="ltx_tag ltx_tag_listingline"><span id="algorithm4.6.11.1" class="ltx_text ltx_font_bold">9</span></span>
          <span id="algorithm4.6.11.2" class="ltx_text ltx_font_bold">if</span> <em id="algorithm4.6.11.3" class="ltx_emph ltx_markedasmath ltx_font_typewriter ltx_font_italic">pad_right</em> <span id="algorithm4.6.11.4" class="ltx_text ltx_font_bold">then</span>  <span id="algorithm4.6.11.5" class="ltx_text ltx_font_typewriter">// </span><span id="algorithm4.6.11.6" class="ltx_text ltx_font_typewriter">fill rest of window</span>
