<th id="A1.T3.2.1.3.1" class="ltx_td ltx_align_left ltx_th ltx_th_column ltx_th_row ltx_border_t" rowspan="2"><span id="A1.T3.2.1.3.1.1" class="ltx_text">1.5B</span></th>
