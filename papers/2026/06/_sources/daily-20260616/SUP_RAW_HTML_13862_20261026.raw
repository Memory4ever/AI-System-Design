          <math id="algorithm4.m19" class="ltx_Math" alttext="\tilde{\mathbf{c}}\mathrel{{+}{=}}[\textsc{cot\_pad}]^{k-1},\quad\mathbf{m}\mathrel{{+}{=}}[\texttt{true}]^{k-1}" display="inline" intent=":literal"><semantics><mrow><mrow><mover accent="true"><mi>𝐜</mi><mo>~</mo></mover><mrow><mo>+</mo><mo lspace="0em">⁣</mo><mo>=</mo></mrow><msup><mrow><mo stretchy="false">[</mo><mtext class="ltx_font_smallcaps">cot_pad</mtext><mo stretchy="false">]</mo></mrow><mrow><mi>k</mi><mo>−</mo><mn>1</mn></mrow></msup></mrow><mo rspace="1.167em">,</mo><mrow><mi>𝐦</mi><mrow><mo>+</mo><mo lspace="0em">⁣</mo><mo>=</mo></mrow><msup><mrow><mo stretchy="false">[</mo><mtext class="ltx_mathvariant_monospace">true</mtext><mo stretchy="false">]</mo></mrow><mrow><mi>k</mi><mo>−</mo><mn>1</mn></mrow></msup></mrow></mrow><annotation encoding="application/x-tex">\tilde{\mathbf{c}}\mathrel{{+}{=}}[\textsc{cot\_pad}]^{k-1},\quad\mathbf{m}\mathrel{{+}{=}}[\texttt{true}]^{k-1}</annotation></semantics></math>;
</div>
