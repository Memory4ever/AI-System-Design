</div>
<div id="algorithm4.6.14" class="ltx_listingline"> <span class="ltx_rule" style="width:1px;height:100%;--ltx-bg-color:black;display:inline-block;"> </span> 
            <span class="ltx_tag ltx_tag_listingline"><span id="algorithm4.6.14.1" class="ltx_text ltx_font_bold">12</span></span>
          <span id="algorithm4.6.14.2" class="ltx_text ltx_font_bold">else</span>
