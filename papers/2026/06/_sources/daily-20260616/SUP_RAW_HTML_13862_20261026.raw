<th id="A1.T3.2.1.3.3" class="ltx_td ltx_align_center ltx_th ltx_th_column ltx_border_t">72.4</th>
<th id="A1.T3.2.1.3.4" class="ltx_td ltx_align_center ltx_th ltx_th_column ltx_border_r ltx_border_t">494.1</th>
