<th id="A2.T5.3.1.3" class="ltx_td ltx_align_center ltx_th ltx_th_column ltx_border_tt"><span id="A2.T5.3.1.3.1" class="ltx_text" style="font-size:90%;">Bucket weights <math id="A2.T5.m2" class="ltx_Math" alttext="(K{=}1,\ 2{-}4,\ 5{-}8,\ 9+)" display="inline" intent=":literal"><semantics><mrow><mo stretchy="false">(</mo><mrow><mi>K</mi><mo>=</mo><mn>1</mn></mrow><mo>,</mo><mrow><mn> 2</mn><mo>−</mo><mn>4</mn></mrow><mo>,</mo><mrow><mn> 5</mn><mo>−</mo><mn>8</mn></mrow><mo>,</mo><mrow><mn> 9</mn><mo rspace="0em">+</mo></mrow><mo stretchy="false">)</mo></mrow><annotation encoding="application/x-tex">(K{=}1,\ 2{-}4,\ 5{-}8,\ 9+)</annotation></semantics></math></span></th></tr>
