            <span id="alg1.l8.3" class="ltx_text" style="font-size:90%;">    </span><math id="alg1.l8.m1" class="ltx_math_unparsed" alttext="\mathcal{F}\leftarrow\mathcal{F}\cup\{(K,\mathbf{v}_{1:R},\pi)\}" display="inline" intent=":literal"><semantics><mrow><mi class="ltx_font_mathcaligraphic" mathsize="0.900em">ℱ</mi><mo mathsize="0.900em" stretchy="false">←</mo><mi class="ltx_font_mathcaligraphic" mathsize="0.900em">ℱ</mi><mo mathsize="0.900em">∪</mo><mrow><mo stretchy="false">{</mo><mrow><mo maxsize="0.900em" minsize="0.900em">(</mo><mi mathsize="0.900em">K</mi><mo mathsize="0.900em">,</mo><msub><mi mathsize="0.900em">𝐯</mi><mrow><mn mathsize="0.900em">1</mn><mo lspace="0.278em" mathsize="0.900em" rspace="0.278em">:</mo><mi mathsize="0.900em">R</mi></mrow></msub><mo mathsize="0.900em">,</mo><mi mathsize="0.900em">π</mi><mo maxsize="0.900em" minsize="0.900em">)</mo></mrow><mo stretchy="false">}</mo></mrow></mrow><annotation encoding="application/x-tex">\mathcal{F}\leftarrow\mathcal{F}\cup\{(K,\mathbf{v}_{1:R},\pi)\}</annotation></semantics></math><span id="alg1.l8.4" class="ltx_text" style="font-size:90%;"> {Store verified prefix as a new anchor}
</span>
</div>
<div id="alg1.l9" class="ltx_listingline">
