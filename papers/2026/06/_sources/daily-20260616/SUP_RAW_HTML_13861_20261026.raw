            <span id="alg1.l4.3" class="ltx_text" style="font-size:90%;">   </span><math id="alg1.l4.m1" class="ltx_Math" alttext="(\text{EM},F,R,K,\pi)\leftarrow\mathcal{V}(\mathbf{v})" display="inline" intent=":literal"><semantics><mrow><mrow><mo maxsize="0.900em" minsize="0.900em">(</mo><mtext mathsize="0.900em">EM</mtext><mo mathsize="0.900em">,</mo><mi mathsize="0.900em">F</mi><mo mathsize="0.900em">,</mo><mi mathsize="0.900em">R</mi><mo mathsize="0.900em">,</mo><mi mathsize="0.900em">K</mi><mo mathsize="0.900em">,</mo><mi mathsize="0.900em">π</mi><mo maxsize="0.900em" minsize="0.900em">)</mo></mrow><mo mathsize="0.900em" stretchy="false">←</mo><mrow><mi class="ltx_font_mathcaligraphic" mathsize="0.900em">𝒱</mi><mo>⁡</mo><mrow><mo maxsize="0.900em" minsize="0.900em">(</mo><mi mathsize="0.900em">𝐯</mi><mo maxsize="0.900em" minsize="0.900em">)</mo></mrow></mrow></mrow><annotation encoding="application/x-tex">(\text{EM},F,R,K,\pi)\leftarrow\mathcal{V}(\mathbf{v})</annotation></semantics></math><span id="alg1.l4.4" class="ltx_text" style="font-size:90%;"> {</span><math id="alg1.l4.m2" class="ltx_Math" alttext="F" display="inline" intent=":literal"><semantics><mi mathsize="0.900em">F</mi><annotation encoding="application/x-tex">F</annotation></semantics></math><span id="alg1.l4.5" class="ltx_text" style="font-size:90%;">: first failure frame; </span><math id="alg1.l4.m3" class="ltx_Math" alttext="R" display="inline" intent=":literal"><semantics><mi mathsize="0.900em">R</mi><annotation encoding="application/x-tex">R</annotation></semantics></math><span id="alg1.l4.6" class="ltx_text" style="font-size:90%;">: aligned restart anchor; </span><math id="alg1.l4.m4" class="ltx_Math" alttext="\pi" display="inline" intent=":literal"><semantics><mi mathsize="0.900em">π</mi><annotation encoding="application/x-tex">\pi</annotation></semantics></math><span id="alg1.l4.7" class="ltx_text" style="font-size:90%;">: verifier-assigned priority}
</span>
</div>
