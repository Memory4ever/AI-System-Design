<td id="A2.T17.3.10.3" class="ltx_td ltx_align_center ltx_border_bb" style="padding-left:4.0pt;padding-right:4.0pt;"><math id="A2.T17.m35" class="ltx_Math" alttext="506/600=84.3\%" display="inline" intent=":literal"><semantics><mrow><mrow><mn mathsize="0.900em">506</mn><mo maxsize="0.900em" minsize="0.900em" stretchy="true" symmetric="true">/</mo><mn mathsize="0.900em">600</mn></mrow><mo mathsize="0.900em">=</mo><mrow><mn mathsize="0.900em">84.3</mn><mo>%</mo></mrow></mrow><annotation encoding="application/x-tex">506/600=84.3\%</annotation></semantics></math></td>
