<td id="S5.T2.1.1.2.3" class="ltx_td ltx_align_center ltx_border_t"><span id="S5.T2.1.1.2.3.1" class="ltx_text ltx_font_bold">12.7</span></td>
<td id="S5.T2.1.1.2.4" class="ltx_td ltx_align_center ltx_border_t">80.2</td>
<td id="S5.T2.1.1.2.5" class="ltx_td ltx_align_center ltx_border_t">19.8</td></tr>
<tr id="S5.T2.1.1.3" class="ltx_tr">
