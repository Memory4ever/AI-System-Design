<td id="S5.T2.1.1.3.3" class="ltx_td ltx_align_center">13.0</td>
<td id="S5.T2.1.1.3.4" class="ltx_td ltx_align_center">79.1</td>
<td id="S5.T2.1.1.3.5" class="ltx_td ltx_align_center">20.9</td></tr>
<tr id="S5.T2.1.1.4" class="ltx_tr">
<th id="S5.T2.1.1.4.1" class="ltx_td ltx_align_left ltx_th ltx_th_row">GroundedSAM <cite class="ltx_cite ltx_citemacro_citep">[<a href="#bib.bib26" title="" class="ltx_ref">15</a>]</cite></th>
<td id="S5.T2.1.1.4.2" class="ltx_td ltx_align_center">44.8</td>
<td id="S5.T2.1.1.4.3" class="ltx_td ltx_align_center">8.5</td>
<td id="S5.T2.1.1.4.4" class="ltx_td ltx_align_center">60.7</td>
<td id="S5.T2.1.1.4.5" class="ltx_td ltx_align_center">39.3</td></tr>
<tr id="S5.T2.1.1.5" class="ltx_tr">
<th id="S5.T2.1.1.5.1" class="ltx_td ltx_align_left ltx_th ltx_th_row ltx_border_bb">YOLO-World <cite class="ltx_cite ltx_citemacro_citep">[<a href="#bib.bib10" title="" class="ltx_ref">23</a>]</cite></th>
<td id="S5.T2.1.1.5.2" class="ltx_td ltx_align_center ltx_border_bb">42.0<sup id="S5.T2.1.1.5.2.1" class="ltx_sup"><span id="S5.T2.1.1.5.2.1.1" class="ltx_text ltx_font_italic">♭</span></sup></td>
<td id="S5.T2.1.1.5.3" class="ltx_td ltx_align_center ltx_border_bb">8.4</td>
