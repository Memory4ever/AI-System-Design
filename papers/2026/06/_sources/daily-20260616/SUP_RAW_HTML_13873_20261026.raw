<span id="lstnumberx7" class="ltx_listingline"><span id="lstnumberx7.1" class="ltx_text ltx_lst_keyword ltx_font_typewriter ltx_font_bold" style="--ltx-fg-color:#7D50C8;">def</span><span id="lstnumberx7.2" class="ltx_text ltx_lst_space ltx_font_typewriter" style="--ltx-fg-color:#000000;"> </span><span id="lstnumberx7.3" class="ltx_text ltx_lst_identifier ltx_font_typewriter" style="--ltx-fg-color:#000000;">forward</span><span id="lstnumberx7.4" class="ltx_text ltx_font_typewriter" style="--ltx-fg-color:#000000;">(</span><span id="lstnumberx7.5" class="ltx_text ltx_lst_identifier ltx_font_typewriter" style="--ltx-fg-color:#000000;">self</span><span id="lstnumberx7.6" class="ltx_text ltx_font_typewriter" style="--ltx-fg-color:#000000;">,</span><span id="lstnumberx7.7" class="ltx_text ltx_lst_space ltx_font_typewriter" style="--ltx-fg-color:#000000;"> </span><span id="lstnumberx7.8" class="ltx_text ltx_lst_identifier ltx_font_typewriter" style="--ltx-fg-color:#000000;">x</span><span id="lstnumberx7.9" class="ltx_text ltx_font_typewriter" style="--ltx-fg-color:#000000;">,</span><span id="lstnumberx7.10" class="ltx_text ltx_lst_space ltx_font_typewriter" style="--ltx-fg-color:#000000;"> </span><span id="lstnumberx7.11" class="ltx_text ltx_lst_identifier ltx_font_typewriter" style="--ltx-fg-color:#000000;">source_id</span><span id="lstnumberx7.12" class="ltx_text ltx_font_typewriter" style="--ltx-fg-color:#000000;">):</span>
</span>
