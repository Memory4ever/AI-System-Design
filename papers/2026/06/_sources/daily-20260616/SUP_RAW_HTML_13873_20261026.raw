<span id="S4.F6.pic1.p1" class="ltx_para ltx_noindent"><span class="ltx_inline-block"><svg id="S4.F6.pic1.p1.pic1" class="ltx_picture" color="#000000" height="243.6" overflow="visible" version="1.1" viewBox="0 0 608.42 243.6" width="608.42"><g style="--ltx-stroke-color:#000000;--ltx-fill-color:#000000;" fill="#000000" stroke="#000000" stroke-width="0.4pt" transform="translate(0,243.6) matrix(1 0 0 -1 0 0)"><g style="--ltx-fill-color:#8794AE;" fill="#8794AE" fill-opacity="1.0"><path style="stroke:none" d="M 0 3.87 L 0 239.73 C 0 241.87 1.73 243.6 3.87 243.6 L 604.54 243.6 C 606.68 243.6 608.42 241.87 608.42 239.73 L 608.42 3.87 C 608.42 1.73 606.68 0 604.54 0 L 3.87 0 C 1.73 0 0 1.73 0 3.87 Z"></path></g><g style="--ltx-fill-color:#ECEFF5;" fill="#ECEFF5" fill-opacity="1.0"><path style="stroke:none" d="M 1.11 3.87 L 1.11 219.68 L 607.31 219.68 L 607.31 3.87 C 607.31 2.35 606.07 1.11 604.54 1.11 L 3.87 1.11 C 2.35 1.11 1.11 2.35 1.11 3.87 Z"></path></g><g fill-opacity="1.0" transform="matrix(1.0 0.0 0.0 1.0 20.79 228.18)"><foreignObject style="--ltx-fo-width:35.63em;--ltx-fo-height:0.75em;--ltx-fo-depth:0.25em;font-size:10pt;" height="13.84" overflow="visible" transform="matrix(1 0 0 -1 0 10.38)" width="493.02"><span class="ltx_foreignobject_container"><span class="ltx_foreignobject_content">
