ransform="matrix(1.0 0.0 0.0 1.0 421.26 39.37)"><foreignObject style="--ltx-fg-color:#000000;" color="#000000" overflow="visible"><span class="ltx_foreignobject_container"><span class="ltx_foreignobject_content"><math id="A3.F8.pic1.m15" class="ltx_Math" alttext="\vdots" display="inline" intent=":literal"><semantics><mi style="--ltx-fg-color:#B3B3B3;" mathcolor="#B3B3B3" mathsize="0.500em" mathvariant="normal">⋮</mi><annotation encoding="application/x-tex">\vdots</annotation></semantics></math></span></span></foreignObject></g><g style="--ltx-stroke-color:#CCCCCC;--ltx-fill-color:#CCCCCC;--ltx-fg-color:#CCCCCC;" color="#CCCCCC" fill="#CCCCCC" stroke="#CCCCCC"><path style="fill:none" d="M 350.76 134.98 L 326.65 113.27"></path></g><g style="--ltx-stroke-color:#CCCCCC;--ltx-fill-color:#CCCCCC;--ltx-fg-color:#CCCCCC;" color="#CCCCCC" fill="#CCCCCC" stroke="#CCCCCC"><path style="fill:none" d="M 365.77 134.98 L 390.32 112.89"></path></g><g style="--ltx-stroke-color:#CCCCCC;--ltx-fill-color:#CCCCCC;--ltx-fg-color:#CCCCCC;" color="#CCCCCC" fill="#CCCCCC" stroke="#CCCCCC"><path style="fill:none" d="M 314.71 99.33 L 299.46 73.9"></path></g><g style="--ltx-stroke-color:#CCCCCC;--ltx-fill-color:#CCCCCC;--ltx-fg-color:#CCCCCC;" color="#CCCCCC" fill="#CCCCCC" stroke="#CCCCCC"><path style="fill:none" d="M 323.08 99.33 L 337.57 75.18"></path></g><g style="--ltx-stroke-color:#CCCCCC;--ltx-fill-color:#CCCCCC;--ltx-fg-color:#CCCCCC;" color="#CCCCCC" fill="#CCCCCC" stroke="#CCCCCC"><path style="fill:none" d="M 392.69 98.05 L 378.97 75.18"></path></g><g style="--ltx-stroke-color:#CCCCCC;--ltx-fill-color:#CCCCCC;--ltx-fg-color:#CCCCCC;" color="#CCCCCC" fill="#CCCCCC" stroke="#CCCCCC"><path style="fill:none" d="M 402.59 98.05 L 416.31 75.18"></path></g><g style="--ltx-stroke-color:#000080;--ltx-fill-color:#000080;--ltx-fg-color:#000080;" color="#000080" fill="#000080" stroke="#000080" transform="matrix(1.0 0.0 0.0 1.0 316.54 88.59)"><foreignObject style="--ltx-fg-color:#000000;--ltx-fo-width:0.5em;--ltx-fo-height:0.47em;--ltx-fo-depth:0em;font-size:6.81pt;" color="#000000" height="4.46" overflow="visible" transform="matrix(1 0 0 -1 0 4.46)" width="4.71"><span class="ltx_foreignobject_container"><span class="ltx_foreignobject_content"><span id="A3.F8.pic1.13" class="ltx_text" style="font-size:50%;--ltx-fg-color:#000080;">1</span></span></span></foreignObject></g><g style="--ltx-stroke-color:#000080;--ltx-fill-color:#000080;--ltx-fg-color:#000080;" color="#000080" fill="#000080" stroke="#000080" transform="matrix(1.0 0.0 0.0 1.0 395.28 87.32)"><foreignObject style="--ltx-fg-color:#000000;--ltx-fo-width:0.5em;--ltx-fo-height:0.47em;--ltx-fo-depth:0em;font-size:6.81pt;" color="#000000" height="4.46" overflow="visible" transform="matrix(1 0 0 -1 0 4.46)" width="4.71"><span class="ltx_foreignobject_container"><span class="ltx_foreignobject_content"><span id="A3.F8.pic1.14" class="ltx_text" style="font-size:50%;--ltx-fg-color:#000080;">2</span></span></span></foreignObject></g><g style="--ltx-stroke-color:#000080;--ltx-fill-color:#000080;--ltx-fg-color:#000080;" color="#000080" fill="#000080" stroke="#000080" transform="matrix(1.0 0.0 0.0 1.0 292.92 49.22)"><foreignObject style="--ltx-fg-color:#000000;--ltx-fo-width:0.5em;--ltx-fo-height:0.47em;--ltx-fo-depth:0em;font-size:6.81pt;" color="#000000" height="4.46" overflow="visible" transform="matrix(1 0 0 -1 0 4.46)" width="4.71"><span class="ltx_foreignobject_container"><span class="ltx_foreignobject_content"><span id="A3.F8.pic1.15" class="ltx_text" style="font-size:50%;--ltx-fg-color:#000080;">3</span></span></span></foreignObject></g><g style="--ltx-stroke-color:#000080;--ltx-fill-color:#000080;--ltx-fg-color:#000080;" color="#000080" fill="#000080" stroke="#000080" transform="matrix(1.0 0.0 0.0 1.0 340.17 47.95)"><foreignObject style="--ltx-fg-color:#000000;--ltx-fo-width:0.5em;--ltx-fo-height:0.47em;--ltx-fo-depth:0em;font-size:6.81pt;" color="#000000" height="4.46" overflow="visible" transform="matrix(1 0 0 -1 0 4.46)" width="4.71"><span class="ltx_foreignobject_container"><span class="ltx_foreignobject_content"><span id="A3.F8.pic1.16" class="ltx_text" style="font-size:50%;--ltx-fg-color:#000080;">4</span></span></span></foreignObject></g><g style="--ltx-stroke-color:#000080;--ltx-fill-color:#000080;--ltx-fg-color:#000080;" color="#000080" fill="#000080" stroke="#000080" transform="matrix(1.0 0.0 0.0 1.0 371.66 47.95)"><foreignObject style="--ltx-fg-color:#000000;--ltx-fo-width:0.5em;--ltx-fo-height:0.47em;--ltx-fo-depth:0em;font-size:6.81pt;" color="#000000" height="4.46" overflow="visible" transform="matrix(1 0 0 -1 0 4.46)" width="4.71"><span class="ltx_foreignobject_container"><span class="ltx_foreignobject_content"><span id="A3.F8.pic1.17" class="ltx_text" style="font-size:50%;--ltx-fg-color:#000080;">5</span></span></span></foreignObject></g><g style="--ltx-stroke-color:#000080;--ltx-fill-color:#000080;--ltx-fg-color:#000080;" color="#000080" fill="#000080" stroke="#000080" transform="matrix(1.0 0.0 0.0 1.0 418.91 47.95)"><foreignObject style="--ltx-fg-color:#000000;--ltx-fo-width:0.5em;--ltx-fo-height:0.47em;--ltx-fo-depth:0em;font-size:6.81pt;" color="#000000" height="4.46" overflow="visible" transform="matrix(1 0 0 -1 0 4.46)" width="4.71"><span class="ltx_foreignobject_container"><span class="ltx_foreignobject_content"><span id="A3.F8.pic1.18" class="ltx_text" style="font-size:50%;--ltx-fg-color:#000080;">6</span></span></span></foreignObject></g><g style="--ltx-stroke-color:#B3B3B3;--ltx-fill-color:#B3B3B3;--ltx-fg-color:#B3B3B3;" color="#B3B3B3" fill="#B3B3B3" stroke="#B3B3B3"><path style="fill:none" d="M 333.71 106.3 L 379.02 106.3"></path></g><g style="--ltx-stroke-color:#B3B3B3;--ltx-fill-color:#B3B3B3;--ltx-fg-color:#B3B3B3;" color="#B3B3B3" fill="#B3B3B3" stroke="#B3B3B3" stroke-dasharray="none" stroke-dashoffset="0.0pt" stroke-linejoin="miter" transform="matrix(1.0 0.0 0.0 1.0 376.76 106.3)"><path d="M 5.9 0 L 0.89 1.87 L 2.4 0 L 0.89 -1.87 Z"></path></g><g style="--ltx-stroke-color:#B3B3B3;--ltx-fill-color:#B3B3B3;--ltx-fg-color:#B3B3B3;" color="#B3B3B3" fill="#B3B3B3" stroke="#B3B3B3"><path style="fill:none" d="M 313.08 66.93 L 320.9 66.93"></path></g><g style="--ltx-stroke-color:#B3B3B3;--ltx-fill-color:#B3B3B3;--ltx-fg-color:#B3B3B3;" color="#B3B3B3" fill="#B3B3B3" stroke="#B3B3B3" stroke-dasharray="none" stroke-dashoffset="0.0pt" stroke-linejoin="miter" transform="matrix(1.0 0.0 0.0 1.0 318.64 66.93)"><path d="M 5.9 0 L 0.89 1.87 L 2.4 0 L 0.89 -1.87 Z"></path></g><g style="--ltx-stroke-color:#B3B3B3;--ltx-fill-color:#B3B3B3;--ltx-fg-color:#B3B3B3;" color="#B3B3B3" fill="#B3B3B3" stroke="#B3B3B3"><path style="fill:none" d="M 345.92 66.93 L 352.39 66.93"></path></g><g style="--ltx-stroke-color:#B3B3B3;--ltx-fill-color:#B3B3B3;--ltx-fg-color:#B3B3B3;" color="#B3B3B3" fill="#B3B3B3" stroke="#B3B3B3" stroke-dasharray="none" stroke-dashoffset="0.0pt" stroke-linejoin="miter" transform="matrix(1.0 0.0 0.0 1.0 350.13 66.93)"><path d="M 5.9 0 L 0.89 1.87 L 2.4 0 L 0.89 -1.87 Z"></path></g><g style="--ltx-stroke-color:#B3B3B3;--ltx-fill-color:#B3B3B3;--ltx-fg-color:#B3B3B3;" color="#B3B3B3" fill="#B3B3B3" stroke="#B3B3B3"><path style="fill:none" d="M 391.26 66.93 L 400.2 66.93"></path></g><g style="--ltx-stroke-color:#B3B3B3;--ltx-fill-color:#B3B3B3;--ltx-fg-color:#B3B3B3;" color="#B3B3B3" fill="#B3B3B3" stroke="#B3B3B3" stroke-dasharray="none" stroke-dashoffset="0.0pt" stroke-linejoin="miter" transform="matrix(1.0 0.0 0.0 1.0 397.94 66.93)"><path d="M 5.9 0 L 0.89 1.87 L 2.4 0 L 0.89 -1.87 Z"></path></g><g style="--ltx-stroke-color:#000000;--ltx-fill-color:#000000;" fill="#000000" stroke="#000000" transform="matrix(1.0 0.0 0.0 1.0 246.82 -44.07)"><g class="ltx_tikzmatrix" transform="matrix(1 0 0 -1 0 19.68)"><g class="ltx_tikzmatrix_row" transform="matrix(1 0 0 1 0 7.69)"><g class="ltx_tikzmatrix_col ltx_nopad_r" transform="matrix(1 0 0 -1 45.7 0)"><foreignObject style="--ltx-fo-width:11.18em;--ltx-fo-height:0.65em;--ltx-fo-depth:0.18em;font-size:8.5pt;" height="9.84" overflow="visible" transform="matrix(1 0 0 -1 0 7.69)" width="131.51"><span class="ltx_foreignobject_container"><span class="ltx_foreignobject_content"><math id="A3.F8.pic1.m16" class="ltx_Math" alttext="F_{2}" display="inline" intent=":literal"><semantics><msub><mi mathsize="0.800em">F</mi><mn mathsize="0.800em">2</mn></msub><annotation encoding="application/x-tex">F_{2}</annotation></semantics></math><span id="A3.F8.pic1.19" class="ltx_text" style="font-size:80%;">: words are tree nodes;</span></span></span></foreignObject></g></g><g class="ltx_tikzmatrix_row" transform="matrix(1 0 0 1 0 17.53)"><g class="ltx_tikzmatrix_col ltx_nopad_r" transform="matrix(1 0 0 -1 0 0)"><foreignObject style="--ltx-fo-width:18.95em;--ltx-fo-height:0.65em;--ltx-fo-depth:0.18em;font-size:8.5pt;" height="9.84" overflow="visible" transform="matrix(1 0 0 -1 0 7.69)" width="222.9"><span class="ltx_foreignobject_container"><span class="ltx_foreignobject_content"><span id="A3.F8.pic1.20" class="ltx_text" style="font-size:80%;">length-then-lex reads the tree level by level</span></span></span></foreignObject></g></g></g></g></g></svg></span>
<figcaption class="ltx_caption ltx_centering"><span class="ltx_tag ltx_tag_figure"><span id="A3.F8.3" class="ltx_text" style="font-size:90%;">Figure 8</span>: </span><span id="A3.F8.4" class="ltx_text" style="font-size:90%;">The two monoids and their canonical orders (<a href="#A3.SS1" title="Monoids and canonical orders ‣ Appendix C Mathematical Background" class="ltx_ref"><span class="ltx_text ltx_ref_tag">Section</span> <span class="ltx_text ltx_ref_tag">C.1</span></a>). Left:
<math id="A3.F8.m5" class="ltx_Math" alttext="A_{2}\cong(\mathbb{N}^{2},+)" display="inline" intent=":literal"><semantics><mrow><msub><mi>A</mi><mn>2</mn></msub><mo>≅</mo><mrow><mo stretchy="false">(</mo><msup><mi>ℕ</mi><mn>2</mn></msup><mo rspace="0em">,</mo><mo lspace="0em" rspace="0em">+</mo><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">A_{2}\cong(\mathbb{N}^{2},+)</annotation></semantics></math>; degree-then-lex enumerates the lattice diagonal by diagonal,
so the order is isomorphic to <math id="A3.F8.m6" class="ltx_Math" alttext="\mathbb{N}" display="inline" intent=":literal"><semantics><mi>ℕ</mi><annotation encoding="application/x-tex">\mathbb{N}</annotation></semantics></math>. Right: <math id="A3.F8.m7" class="ltx_Math" alttext="F_{2}" display="inline" intent=":literal"><semantics><msub><mi>F</mi><mn>2</mn></msub><annotation encoding="application/x-tex">F_{2}</annotation></semantics></math>; length-then-lex reads the word
tree level by level. In both cases <math id="A3.F8.m8" class="ltx_Math" alttext="L[1\!\dots\!N]" display="inline" intent=":literal"><semantics><mrow><mi>L</mi><mo>⁡</mo><mrow><mo stretchy="false">[</mo><mrow><mpadded style="width:0.600em;" width="0.600em"><mi mathvariant="normal">…</mi></mpadded><mo lspace="0em" rspace="0em">​</mo><mi>N</mi></mrow><mo stretchy="false">]</mo></mrow></mrow><annotation encoding="application/x-tex">L[1\!\dots\!N]</annotation></semantics></math> is a well-defined initial segment,
which is all the density machinery of <a href="#S2" title="The Model" class="ltx_ref"><span class="ltx_text ltx_ref_tag">Section</span> <span class="ltx_text ltx_ref_tag">2</span></a> needs.</span></figcaption>
</figure>
</section>
<section id="A3.SS2" class="ltx_subsection">
<h3 class="ltx_title ltx_font_bold ltx_title_subsection" style="font-size:120%;--ltx-fg-color:#1F4FA8;">The macro framework</h3>

<div id="A3.SS2.p1" class="ltx_para">
<p id="A3.SS2.p1.1" class="ltx_p">Following ABFM, a <em id="A3.SS2.p1.1.1" class="ltx_emph ltx_font_italic">dictionary</em> <math id="A3.SS2.p1.m1" class="ltx_Math" alttext="D" display="inline" intent=":literal"><semantics><mi>D</mi><annotation encoding="application/x-tex">D</annotation></semantics></math> is a finite or infinite set of designated monoid
elements, called <em id="A3.SS2.p1.1.2" class="ltx_emph ltx_font_italic">macros</em>. Generation is allowed to use the <em id="A3.SS2.p1.1.3" class="ltx_emph ltx_font_italic">augmented generating
set</em> <math id="A3.SS2.p1.m2" class="ltx_Math" alttext="G\cup D" display="inline" intent=":literal"><semantics><mrow><mi>G</mi><mo>∪</mo><mi>D</mi></mrow><annotation encoding="application/x-tex">G\cup D</annotation></semantics></math>: a factorization of <math id="A3.SS2.p1.m3" class="ltx_Math" alttext="w" display="inline" intent=":literal"><semantics><mi>w</mi><annotation encoding="application/x-tex">w</annotation></semantics></math> is an expression of <math id="A3.SS2.p1.m4" class="ltx_Math" alttext="w" display="inline" intent=":literal"><semantics><mi>w</mi><annotation encoding="application/x-tex">w</annotation></semantics></math> as a product of elements of <math id="A3.SS2.p1.m5" class="ltx_Math" alttext="G\cup D" display="inline" intent=":literal"><semantics><mrow><mi>G</mi><mo>∪</mo><mi>D</mi></mrow><annotation encoding="application/x-tex">G\cup D</annotation></semantics></math>. The <em id="A3.SS2.p1.1.4" class="ltx_emph ltx_font_italic">wrapped length</em></p>
<table id="A3.E1" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="A3.E1.m1" class="ltx_math_unparsed" alttext="\lvert w\rvert_{G\cup D}\coloneqq\min\left\{\,k:w=g_{1}\cdots g_{k},\ g_{j}\in G\cup D\,\right\}" display="block" intent=":literal"><semantics><mrow><msub><mrow><mo stretchy="false">|</mo><mi>w</mi><mo stretchy="false">|</mo></mrow><mrow><mi>G</mi><mo>∪</mo><mi>D</mi></mrow></msub><mo>≔</mo><mi>min</mi><mrow><mo rspace="0.170em">{</mo><mi>k</mi><mo lspace="0.278em" rspace="0.278em">:</mo><mi>w</mi><mo>=</mo><msub><mi>g</mi><mn>1</mn></msub><mo lspace="0em" rspace="0em">⋯</mo><msub><mi>g</mi><mi>k</mi></msub><mo rspace="0.667em">,</mo><msub><mi>g</mi><mi>j</mi></msub><mo>∈</mo><mi>G</mi><mo>∪</mo><mi>D</mi><mo lspace="0.170em">}</mo></mrow></mrow><annotation encoding="application/x-tex">\lvert w\rvert_{G\cup D}\coloneqq\min\left\{\,k:w=g_{1}\cdots g_{k},\ g_{j}\in G\cup D\,\right\}</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td>
<td rowspan="1" class="ltx_eqn_cell ltx_eqn_eqno ltx_align_middle ltx_align_right"><span class="ltx_tag ltx_tag_equation ltx_align_right">(C.1)</span></td></tr></tbody>
</table>
<p id="A3.SS2.p1.2" class="ltx_p">is the minimum number of symbols from <math id="A3.SS2.p1.m6" class="ltx_Math" alttext="G\cup D" display="inline" intent=":literal"><semantics><mrow><mi>G</mi><mo>∪</mo><mi>D</mi></mrow><annotation encoding="application/x-tex">G\cup D</annotation></semantics></math> in any factorization of <math id="A3.SS2.p1.m7" class="ltx_Math" alttext="w" display="inline" intent=":literal"><semantics><mi>w</mi><annotation encoding="application/x-tex">w</annotation></semantics></math>, and the
<em id="A3.SS2.p1.2.1" class="ltx_emph ltx_font_italic">raw</em> (unwrapped) length <math id="A3.SS2.p1.m8" class="ltx_Math" alttext="\lvert w\rvert_{G}" display="inline" intent=":literal"><semantics><msub><mrow><mo stretchy="false">|</mo><mi>w</mi><mo stretchy="false">|</mo></mrow><mi>G</mi></msub><annotation encoding="application/x-tex">\lvert w\rvert_{G}</annotation></semantics></math> uses <math id="A3.SS2.p1.m9" class="ltx_Math" alttext="G" display="inline" intent=":literal"><semantics><mi>G</mi><annotation encoding="application/x-tex">G</annotation></semantics></math> alone. A macro that abbreviates a long
element shortens its wrapped length below its raw length: this is the precise sense in which
“compressible” means “short under the dictionary.”</p>
</div>
<div id="A3.SS2.p2" class="ltx_para">
<p id="A3.SS2.p2.1" class="ltx_p">For <math id="A3.SS2.p2.m1" class="ltx_Math" alttext="A_{n}" display="inline" intent=":literal"><semantics><msub><mi>A</mi><mi>n</mi></msub><annotation encoding="application/x-tex">A_{n}</annotation></semantics></math> the relevant dictionaries are <em id="A3.SS2.p2.1.1" class="ltx_emph ltx_font_italic">geometric</em>: <math id="A3.SS2.p2.m2" class="ltx_math_unparsed" alttext="D_{c}=\{\,c^{\,j}a_{i}:i\leq n,\ j\geq 1\,\}" display="inline" intent=":literal"><semantics><mrow><msub><mi>D</mi><mi>c</mi></msub><mo>=</mo><mrow><mo rspace="0.170em" stretchy="false">{</mo><msup><mi>c</mi><mi>j</mi></msup><msub><mi>a</mi><mi>i</mi></msub><mo lspace="0.278em" rspace="0.278em">:</mo><mi>i</mi><mo>≤</mo><mi>n</mi><mo rspace="0.667em">,</mo><mi>j</mi><mo>≥</mo><mn>1</mn><mo lspace="0.170em" stretchy="false">}</mo></mrow></mrow><annotation encoding="application/x-tex">D_{c}=\{\,c^{\,j}a_{i}:i\leq n,\ j\geq 1\,\}</annotation></semantics></math> provides single-letter powers at every scale <math id="A3.SS2.p2.m3" class="ltx_Math" alttext="c^{j}" display="inline" intent=":literal"><semantics><msup><mi>c</mi><mi>j</mi></msup><annotation encoding="application/x-tex">c^{j}</annotation></semantics></math>. For this dictionary the
wrapped length has a closed form,</p>
<table id="A3.E2" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="A3.E2.m1" class="ltx_Math" alttext="\lvert w\rvert_{G\cup D_{c}}=\sum_{i=1}^{n}s_{c}(N_{i})," display="block" intent=":literal"><semantics><mrow><mrow><msub><mrow><mo stretchy="false">|</mo><mi>w</mi><mo stretchy="false">|</mo></mrow><mrow><mi>G</mi><mo>∪</mo><msub><mi>D</mi><mi>c</mi></msub></mrow></msub><mo rspace="0.111em">=</mo><mrow><munderover><mo movablelimits="false">∑</mo><mrow><mi>i</mi><mo>=</mo><mn>1</mn></mrow><mi>n</mi></munderover><mrow><msub><mi>s</mi><mi>c</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mi>N</mi><mi>i</mi></msub><mo stretchy="false">)</mo></mrow></mrow></mrow></mrow><mo>,</mo></mrow><annotation encoding="application/x-tex">\lvert w\rvert_{G\cup D_{c}}=\sum_{i=1}^{n}s_{c}(N_{i}),</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td>
<td rowspan="1" class="ltx_eqn_cell ltx_eqn_eqno ltx_align_middle ltx_align_right"><span class="ltx_tag ltx_tag_equation ltx_align_right">(C.2)</span></td></tr></tbody>
</table>
<p id="A3.SS2.p2.2" class="ltx_p">where <math id="A3.SS2.p2.m4" class="ltx_Math" alttext="s_{c}(N)" display="inline" intent=":literal"><semantics><mrow><msub><mi>s</mi><mi>c</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>N</mi><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">s_{c}(N)</annotation></semantics></math> is the sum of the base-<math id="A3.SS2.p2.m5" class="ltx_Math" alttext="c" display="inline" intent=":literal"><semantics><mi>c</mi><annotation encoding="application/x-tex">c</annotation></semantics></math> digits of <math id="A3.SS2.p2.m6" class="ltx_Math" alttext="N" display="inline" intent=":literal"><semantics><mi>N</mi><annotation encoding="application/x-tex">N</annotation></semantics></math> (<a href="#A3.F9" title="In The macro framework ‣ Appendix C Mathematical Background" class="ltx_ref"><span class="ltx_text ltx_ref_tag">Figure</span> <span class="ltx_text ltx_ref_tag">9</span></a>) (the digit-sum
lemma, <a href="#A4.Thmtheorem7" title="Lemma D.7 (Digit-sum formula). ‣ Proof. ‣ Abelian refinement chains () ‣ The instantiation (, and ) ‣ Appendix D Deferred Proofs" class="ltx_ref"><span class="ltx_text ltx_ref_tag">Lemma</span> <span class="ltx_text ltx_ref_tag">D.7</span></a>; the minimizing factorization is the base-<math id="A3.SS2.p2.m7" class="ltx_Math" alttext="c" display="inline" intent=":literal"><semantics><mi>c</mi><annotation encoding="application/x-tex">c</annotation></semantics></math> representation of
each coordinate).</p>
</div>
<figure id="A3.F9" class="ltx_figure">
