<span id="A9.T6.7.41.1.1" class="ltx_inline-block ltx_align_top" style="width:55.2pt;">
<span id="A9.T6.7.41.1.1.1" class="ltx_p"><span id="A9.T6.7.41.1.1.1.1" class="ltx_text ltx_font_bold" style="font-size:80%;">this paper</span></span>
</span></td>
<td id="A9.T6.7.41.2" class="ltx_td ltx_align_left ltx_align_top ltx_border_bb ltx_border_t" style="padding:0.5pt 4.0pt;">
<span id="A9.T6.7.41.2.1" class="ltx_inline-block ltx_align_top" style="width:63.8pt;">
<span id="A9.T6.7.41.2.1.1" class="ltx_p"><span id="A9.T6.7.41.2.1.1.1" class="ltx_text ltx_font_bold" style="font-size:80%;">nested pair: ambient <math id="A9.T6.m9" class="ltx_Math" alttext="F\supsetneq" display="inline" intent=":literal"><semantics><mrow><mi>F</mi><mo>⊋</mo><mphantom></mphantom></mrow><annotation encoding="application/x-tex">F\supsetneq</annotation></semantics></math> target <math id="A9.T6.m10" class="ltx_Math" alttext="H" display="inline" intent=":literal"><semantics><mi>H</mi><annotation encoding="application/x-tex">H</annotation></semantics></math>, core of density <math id="A9.T6.m11" class="ltx_Math" alttext="\alpha" display="inline" intent=":literal"><semantics><mi>α</mi><annotation encoding="application/x-tex">\alpha</annotation></semantics></math></span></span>
</span></td>
