-color:#A6A6A6;--ltx-fg-color:#A6A6A6;" color="#A6A6A6" fill="#A6A6A6" stroke="#A6A6A6"><path style="fill:none" d="M 337.04 -141.88 L 323.42 -141.08"></path></g><g style="--ltx-stroke-color:#A6A6A6;--ltx-fill-color:#A6A6A6;--ltx-fg-color:#A6A6A6;" color="#A6A6A6" fill="#A6A6A6" stroke="#A6A6A6" stroke-dasharray="none" stroke-dashoffset="0.0pt" stroke-linejoin="miter" transform="matrix(-0.99828 0.05869 -0.05869 -0.99828 325.68 -141.21)"><path d="M 5.9 0 L 0.89 1.87 L 2.4 0 L 0.89 -1.87 Z"></path></g><g style="--ltx-stroke-color:#A6A6A6;--ltx-fill-color:#A6A6A6;--ltx-fg-color:#A6A6A6;" color="#A6A6A6" fill="#A6A6A6" stroke="#A6A6A6"><path style="fill:none" d="M 290.54 -204.45 L 374.88 -159.81"></path></g><g style="--ltx-stroke-color:#A6A6A6;--ltx-fill-color:#A6A6A6;--ltx-fg-color:#A6A6A6;" color="#A6A6A6" fill="#A6A6A6" stroke="#A6A6A6" stroke-dasharray="none" stroke-dashoffset="0.0pt" stroke-linejoin="miter" transform="matrix(0.88383 0.4678 -0.4678 0.88383 372.88 -160.86)"><path d="M 5.9 0 L 0.89 1.87 L 2.4 0 L 0.89 -1.87 Z"></path></g><g stroke-dasharray="0.4pt,2.0pt" stroke-dashoffset="0.0pt"><g style="--ltx-stroke-color:#B3B3B3;--ltx-fill-color:#B3B3B3;--ltx-fg-color:#B3B3B3;" color="#B3B3B3" fill="#B3B3B3" stroke="#B3B3B3"><path style="fill:none" d="M 293.4 -125.71 L 371.93 -88.76"></path></g><g style="--ltx-stroke-color:#B3B3B3;--ltx-fill-color:#B3B3B3;--ltx-fg-color:#B3B3B3;" color="#B3B3B3" fill="#B3B3B3" stroke="#B3B3B3" stroke-dasharray="none" stroke-dashoffset="0.0pt" stroke-linejoin="miter" transform="matrix(0.90485 0.42574 -0.42574 0.90485 369.89 -89.72)"><path d="M 5.9 0 L 0.89 1.87 L 2.4 0 L 0.89 -1.87 Z"></path></g><g style="--ltx-stroke-color:#B3B3B3;--ltx-fill-color:#B3B3B3;" fill="#B3B3B3" stroke="#B3B3B3" transform="matrix(0.90485 0.42574 -0.42574 0.90485 313.88 -110.67)"><foreignObject style="--ltx-fo-width:3.77em;--ltx-fo-height:0.61em;--ltx-fo-depth:0em;font-size:7.97pt;" height="6.73" overflow="visible" transform="matrix(1 0 0 -1 0 6.73)" width="41.6"><span class="ltx_foreignobject_container"><span class="ltx_foreignobject_content"><span id="A2.F7.pic1.4" class="ltx_text" style="font-size:70%;--ltx-fg-color:#B3B3B3;">interface</span></span></span></foreignObject></g></g><g style="--ltx-stroke-color:#A6A6A6;--ltx-fill-color:#A6A6A6;--ltx-fg-color:#A6A6A6;" color="#A6A6A6" fill="#A6A6A6" stroke="#A6A6A6"><path style="fill:none" d="M 417.04 -86.89 C 458.59 -119.35 458.59 -171.99 420.5 -201.75"></path></g><g style="--ltx-stroke-color:#A6A6A6;--ltx-fill-color:#A6A6A6;--ltx-fg-color:#A6A6A6;" color="#A6A6A6" fill="#A6A6A6" stroke="#A6A6A6" stroke-dasharray="none" stroke-dashoffset="0.0pt" stroke-linejoin="miter" transform="matrix(-0.78801 -0.61566 0.61566 -0.78801 422.28 -200.36)"><path d="M 5.9 0 L 0.89 1.87 L 2.4 0 L 0.89 -1.87 Z"></path></g><g style="--ltx-stroke-color:#A6A6A6;--ltx-fill-color:#A6A6A6;--ltx-fg-color:#A6A6A6;" color="#A6A6A6" fill="#A6A6A6" stroke="#A6A6A6"><path style="fill:none" d="M 209.03 -258.05 C 271.13 -257.32 307.08 -250.55 361.09 -230.17"></path></g><g style="--ltx-stroke-color:#A6A6A6;--ltx-fill-color:#A6A6A6;--ltx-fg-color:#A6A6A6;" color="#A6A6A6" fill="#A6A6A6" stroke="#A6A6A6" stroke-dasharray="none" stroke-dashoffset="0.0pt" stroke-linejoin="miter" transform="matrix(0.93562 0.353 -0.353 0.93562 358.97 -230.97)"><path d="M 5.9 0 L 0.89 1.87 L 2.4 0 L 0.89 -1.87 Z"></path></g><g style="--ltx-stroke-color:#A6A6A6;--ltx-fill-color:#A6A6A6;--ltx-fg-color:#A6A6A6;" color="#A6A6A6" fill="#A6A6A6" stroke="#A6A6A6"><path style="fill:none" d="M 401.57 -228.62 L 401.57 -247.31"></path></g><g style="--ltx-stroke-color:#A6A6A6;--ltx-fill-color:#A6A6A6;--ltx-fg-color:#A6A6A6;" color="#A6A6A6" fill="#A6A6A6" stroke="#A6A6A6" stroke-dasharray="none" stroke-dashoffset="0.0pt" stroke-linejoin="miter" transform="matrix(0.0 -1.0 1.0 0.0 401.57 -245.05)"><path d="M 5.9 0 L 0.89 1.87 L 2.4 0 L 0.89 -1.87 Z"></path></g></g></svg></span>
<figcaption class="ltx_caption ltx_centering"><span class="ltx_tag ltx_tag_figure"><span id="A2.F7.3" class="ltx_text" style="font-size:90%;">Figure 7</span>: </span><span id="A2.F7.4" class="ltx_text" style="font-size:90%;">Dependency map. Dashed boxes are restated prior facts; solid boxes are
results of this paper. The impossibility theorem (<a href="#S3.Thmtheorem6" title="Theorem 3.6 (Impossibility side of the dichotomy). ‣ The tight family. ‣ The trivia phase transition ‣ Main Results" class="ltx_ref"><span class="ltx_text ltx_ref_tag">Theorem</span> <span class="ltx_text ltx_ref_tag">3.6</span></a>) and the
achievability theorem (<a href="#S3.Thmtheorem7" title="Theorem 3.7 (Achievability side: sweep and the tight generator). ‣ The tight family. ‣ The trivia phase transition ‣ Main Results" class="ltx_ref"><span class="ltx_text ltx_ref_tag">Theorem</span> <span class="ltx_text ltx_ref_tag">3.7</span></a>) meet at the dichotomy
(<a href="#S3.Thmtheorem10" title="Corollary 3.10 (The trivia dichotomy). ‣ The tight family. ‣ The trivia phase transition ‣ Main Results" class="ltx_ref"><span class="ltx_text ltx_ref_tag">Corollary</span> <span class="ltx_text ltx_ref_tag">3.10</span></a>); the case study (<a href="#S4.Thmtheorem1" title="Theorem 4.1 (Abelian refinement chains are identifiable). ‣ Case Study: Instantiation in a Compression Model of Mathematics" class="ltx_ref"><span class="ltx_text ltx_ref_tag">Theorem</span> <span class="ltx_text ltx_ref_tag">4.1</span></a>, <a href="#S4.Thmtheorem2" title="Proposition 4.2 (Free-monoid pairs realize the dichotomy). ‣ Case Study: Instantiation in a Compression Model of Mathematics" class="ltx_ref"><span class="ltx_text ltx_ref_tag">Proposition</span> <span class="ltx_text ltx_ref_tag">4.2</span></a>,
<a href="#S4.Thmtheorem3" title="Proposition 4.3 (Imprecision of exhaustive generation). ‣ Case Study: Instantiation in a Compression Model of Mathematics" class="ltx_ref"><span class="ltx_text ltx_ref_tag">Proposition</span> <span class="ltx_text ltx_ref_tag">4.3</span></a>) reads the dichotomy off the interface of
<a href="#S3.Thmtheorem11" title="Remark 3.11 (Interface of the impossibility proofs). ‣ The tight family. ‣ The trivia phase transition ‣ Main Results" class="ltx_ref"><span class="ltx_text ltx_ref_tag">Remark</span> <span class="ltx_text ltx_ref_tag">3.11</span></a>.</span></figcaption>
</figure>
<div id="A2.p1" class="ltx_para">
<p id="A2.p1.1" class="ltx_p"><a href="#A2.F7" title="In Appendix B Map of the Results" class="ltx_ref"><span class="ltx_text ltx_ref_tag">Figure</span> <span class="ltx_text ltx_ref_tag">7</span></a> traces the dependency structure. The map has four layers. The restated facts
supply the two external inputs: KMV’s breadth characterization (<a href="#S2.Thmtheorem7" title="Fact 2.7 (Breadth characterizations; ( , , Theorems 3.3 and 3.8)). ‣ Restated characterizations (cited facts). ‣ The nested model: validity versus value ‣ The Model" class="ltx_ref"><span class="ltx_text ltx_ref_tag">Fact</span> <span class="ltx_text ltx_ref_tag">2.7</span></a>) and KW’s
partial-enumeration guarantees (<a href="#S2.Thmtheorem1" title="Fact 2.1 (Partial-enumeration generation; ( , , Theorem 1.6 in arXiv version)). ‣ Partial enumeration and the revealed core ‣ The Model" class="ltx_ref"><span class="ltx_text ltx_ref_tag">Facts</span> <span class="ltx_text ltx_ref_tag">2.1</span></a> and <a href="#S2.Thmtheorem2" title="Fact 2.2 (Chain validity in the partial model; ( , , Lemma 2.5(1) in arXiv version)). ‣ Partial enumeration and the revealed core ‣ The Model" class="ltx_ref"><span class="ltx_text ltx_ref_tag">2.2</span></a>). The lemmas are the load-bearing
mechanisms: sandwich-exclusion and fresh-index (<a href="#A4.Thmtheorem2" title="Lemma D.2 (Sandwich-exclusion). ‣ The exhaustive generator and the separation () ‣ Appendix D Deferred Proofs" class="ltx_ref"><span class="ltx_text ltx_ref_tag">Lemmas</span> <span class="ltx_text ltx_ref_tag">D.2</span></a> and <a href="#A4.Thmtheorem3" title="Lemma D.3 (Fresh-index availability). ‣ The exhaustive generator and the separation () ‣ Appendix D Deferred Proofs" class="ltx_ref"><span class="ltx_text ltx_ref_tag">D.3</span></a>) for the
separation, the race lemma and density-composition (<a href="#S3.Thmtheorem5" title="Lemma 3.5 (Race lemma). ‣ The tight family. ‣ The trivia phase transition ‣ Main Results" class="ltx_ref"><span class="ltx_text ltx_ref_tag">Lemmas</span> <span class="ltx_text ltx_ref_tag">3.5</span></a> and <a href="#A4.Thmtheorem4" title="Lemma D.4 (Density composition). ‣ Impossibility side of the dichotomy () ‣ Appendix D Deferred Proofs" class="ltx_ref"><span class="ltx_text ltx_ref_tag">D.4</span></a>) for the
lower bound, and the pointer lemma (<a href="#A4.Thmtheorem5" title="Lemma D.5 (Pointer lemma). ‣ Proof. ‣ Achievability: sweep and the tight generator () ‣ Appendix D Deferred Proofs" class="ltx_ref"><span class="ltx_text ltx_ref_tag">Lemma</span> <span class="ltx_text ltx_ref_tag">D.5</span></a>) for the sweep. The theorems assemble
these: taste (<a href="#S3.Thmtheorem1" title="Theorem 3.1 (Verification is not taste). ‣ Verification is not taste ‣ Main Results" class="ltx_ref"><span class="ltx_text ltx_ref_tag">Theorem</span> <span class="ltx_text ltx_ref_tag">3.1</span></a>) from KMV, the separation (<a href="#S3.Thmtheorem2" title="Theorem 3.2 (The exhaustive generator and the separation). ‣ Sound coverage: what the verifier does buy ‣ Main Results" class="ltx_ref"><span class="ltx_text ltx_ref_tag">Theorem</span> <span class="ltx_text ltx_ref_tag">3.2</span></a>) from the two chain
lemmas, the caps (<a href="#S3.Thmtheorem6" title="Theorem 3.6 (Impossibility side of the dichotomy). ‣ The tight family. ‣ The trivia phase transition ‣ Main Results" class="ltx_ref"><span class="ltx_text ltx_ref_tag">Theorem</span> <span class="ltx_text ltx_ref_tag">3.6</span></a>) and the sweep theorem (<a href="#S3.Thmtheorem7" title="Theorem 3.7 (Achievability side: sweep and the tight generator). ‣ The tight family. ‣ The trivia phase transition ‣ Main Results" class="ltx_ref"><span class="ltx_text ltx_ref_tag">Theorem</span> <span class="ltx_text ltx_ref_tag">3.7</span></a>) from the race,
composition, and pointer lemmas. The caps and the sweep theorem meet at the dichotomy
(<a href="#S3.Thmtheorem10" title="Corollary 3.10 (The trivia dichotomy). ‣ The tight family. ‣ The trivia phase transition ‣ Main Results" class="ltx_ref"><span class="ltx_text ltx_ref_tag">Corollary</span> <span class="ltx_text ltx_ref_tag">3.10</span></a>). Finally the case study instantiates the abstract picture:
<a href="#S4.Thmtheorem1" title="Theorem 4.1 (Abelian refinement chains are identifiable). ‣ Case Study: Instantiation in a Compression Model of Mathematics" class="ltx_ref"><span class="ltx_text ltx_ref_tag">Theorem</span> <span class="ltx_text ltx_ref_tag">4.1</span></a> reads off taste, while <a href="#S4.Thmtheorem2" title="Proposition 4.2 (Free-monoid pairs realize the dichotomy). ‣ Case Study: Instantiation in a Compression Model of Mathematics" class="ltx_ref"><span class="ltx_text ltx_ref_tag">Proposition</span> <span class="ltx_text ltx_ref_tag">4.2</span></a> reads the dichotomy off the
interface (<a href="#S3.Thmtheorem11" title="Remark 3.11 (Interface of the impossibility proofs). ‣ The tight family. ‣ The trivia phase transition ‣ Main Results" class="ltx_ref"><span class="ltx_text ltx_ref_tag">Remark</span> <span class="ltx_text ltx_ref_tag">3.11</span></a>) and reuses the sweep pointer for its extreme separation
point.</p>
</div>
</section>
<section id="A3" class="ltx_appendix">
<h2 class="ltx_title ltx_title_appendix"><span class="ltx_tag ltx_tag_appendix">Appendix C </span>Mathematical Background</h2>

<div id="A3.p1" class="ltx_para">
<p id="A3.p1.1" class="ltx_p">The case study of <a href="#S4" title="Case Study: Instantiation in a Compression Model of Mathematics" class="ltx_ref"><span class="ltx_text ltx_ref_tag">Section</span> <span class="ltx_text ltx_ref_tag">4</span></a> works inside two monoids and the macro
framework of <cite class="ltx_cite ltx_citemacro_citet"><a href="#bib.bib25" title="" class="ltx_ref">Aksenov et al. (2026)</a></cite> (ABFM). We collect the definitions here so the
body can name them in one line. We use this model as a substrate only: no theorem of ABFM is
an ingredient in any proof below.</p>
</div>
<section id="A3.SS1" class="ltx_subsection">
<h3 class="ltx_title ltx_font_bold ltx_title_subsection" style="font-size:120%;--ltx-fg-color:#1F4FA8;">Monoids and canonical orders</h3>

<div id="A3.SS1.p1" class="ltx_para">
<p id="A3.SS1.p1.1" class="ltx_p">A <em id="A3.SS1.p1.1.1" class="ltx_emph ltx_font_italic">monoid</em> is a set with an associative binary operation and an identity element. Two
monoids carry the case study.</p>
</div>
<div id="A3.SS1.p2" class="ltx_para">
<p id="A3.SS1.p2.1" class="ltx_p"><em id="A3.SS1.p2.1.1" class="ltx_emph ltx_font_italic">The free abelian monoid <math id="A3.SS1.p2.m1" class="ltx_Math" alttext="A_{n}" display="inline" intent=":literal"><semantics><msub><mi>A</mi><mi>n</mi></msub><annotation encoding="application/x-tex">A_{n}</annotation></semantics></math></em> on generators <math id="A3.SS1.p2.m2" class="ltx_Math" alttext="a_{1},\dots,a_{n}" display="inline" intent=":literal"><semantics><mrow><msub><mi>a</mi><mn>1</mn></msub><mo>,</mo><mi mathvariant="normal">…</mi><mo>,</mo><msub><mi>a</mi><mi>n</mi></msub></mrow><annotation encoding="application/x-tex">a_{1},\dots,a_{n}</annotation></semantics></math> is the set of formal
products <math id="A3.SS1.p2.m3" class="ltx_Math" alttext="\prod_{i=1}^{n}a_{i}^{N_{i}}" display="inline" intent=":literal"><semantics><mrow><msubsup><mo>∏</mo><mrow><mi>i</mi><mo>=</mo><mn>1</mn></mrow><mi>n</mi></msubsup><msubsup><mi>a</mi><mi>i</mi><msub><mi>N</mi><mi>i</mi></msub></msubsup></mrow><annotation encoding="application/x-tex">\prod_{i=1}^{n}a_{i}^{N_{i}}</annotation></semantics></math> with <math id="A3.SS1.p2.m4" class="ltx_Math" alttext="N_{i}\in\mathbb{N}" display="inline" intent=":literal"><semantics><mrow><msub><mi>N</mi><mi>i</mi></msub><mo>∈</mo><mi>ℕ</mi></mrow><annotation encoding="application/x-tex">N_{i}\in\mathbb{N}</annotation></semantics></math>, multiplied coordinate-wise; it is
isomorphic to <math id="A3.SS1.p2.m5" class="ltx_Math" alttext="(\mathbb{N}^{n},+)" display="inline" intent=":literal"><semantics><mrow><mo stretchy="false">(</mo><msup><mi>ℕ</mi><mi>n</mi></msup><mo rspace="0em">,</mo><mo lspace="0em" rspace="0em">+</mo><mo stretchy="false">)</mo></mrow><annotation encoding="application/x-tex">(\mathbb{N}^{n},+)</annotation></semantics></math>, with each element identified with its exponent vector <math id="A3.SS1.p2.m6" class="ltx_Math" alttext="(N_{1},\dots,N_{n})" display="inline" intent=":literal"><semantics><mrow><mo stretchy="false">(</mo><msub><mi>N</mi><mn>1</mn></msub><mo>,</mo><mi mathvariant="normal">…</mi><mo>,</mo><msub><mi>N</mi><mi>n</mi></msub><mo stretchy="false">)</mo></mrow><annotation encoding="application/x-tex">(N_{1},\dots,N_{n})</annotation></semantics></math>. The <em id="A3.SS1.p2.1.2" class="ltx_emph ltx_font_italic">raw length</em> (the generator count) is <math id="A3.SS1.p2.m7" class="ltx_Math" alttext="\lvert w\rvert_{G}=\sum_{i=1}^{n}N_{i}" display="inline" intent=":literal"><semantics><mrow><msub><mrow><mo stretchy="false">|</mo><mi>w</mi><mo stretchy="false">|</mo></mrow><mi>G</mi></msub><mo rspace="0.111em">=</mo><mrow><msubsup><mo>∑</mo><mrow><mi>i</mi><mo>=</mo><mn>1</mn></mrow><mi>n</mi></msubsup><msub><mi>N</mi><mi>i</mi></msub></mrow></mrow><annotation encoding="application/x-tex">\lvert w\rvert_{G}=\sum_{i=1}^{n}N_{i}</annotation></semantics></math>. We order
<math id="A3.SS1.p2.m8" class="ltx_Math" alttext="A_{n}" display="inline" intent=":literal"><semantics><msub><mi>A</mi><mi>n</mi></msub><annotation encoding="application/x-tex">A_{n}</annotation></semantics></math> by degree-then-lex: first by <math id="A3.SS1.p2.m9" class="ltx_Math" alttext="\lvert w\rvert_{G}" display="inline" intent=":literal"><semantics><msub><mrow><mo stretchy="false">|</mo><mi>w</mi><mo stretchy="false">|</mo></mrow><mi>G</mi></msub><annotation encoding="application/x-tex">\lvert w\rvert_{G}</annotation></semantics></math>, then lexicographically on the exponent vector.</p>
</div>
<div id="A3.SS1.p3" class="ltx_para">
<p id="A3.SS1.p3.1" class="ltx_p"><em id="A3.SS1.p3.1.1" class="ltx_emph ltx_font_italic">The free monoid <math id="A3.SS1.p3.m1" class="ltx_Math" alttext="F_{n}" display="inline" intent=":literal"><semantics><msub><mi>F</mi><mi>n</mi></msub><annotation encoding="application/x-tex">F_{n}</annotation></semantics></math></em> on <math id="A3.SS1.p3.m2" class="ltx_Math" alttext="n" display="inline" intent=":literal"><semantics><mi>n</mi><annotation encoding="application/x-tex">n</annotation></semantics></math> letters is the set of finite words over the alphabet, with
concatenation as the operation and the empty word as identity; <math id="A3.SS1.p3.m3" class="ltx_Math" alttext="\lvert w\rvert_{G}" display="inline" intent=":literal"><semantics><msub><mrow><mo stretchy="false">|</mo><mi>w</mi><mo stretchy="false">|</mo></mrow><mi>G</mi></msub><annotation encoding="application/x-tex">\lvert w\rvert_{G}</annotation></semantics></math> is the word length.
We order <math id="A3.SS1.p3.m4" class="ltx_Math" alttext="F_{n}" display="inline" intent=":literal"><semantics><msub><mi>F</mi><mi>n</mi></msub><annotation encoding="application/x-tex">F_{n}</annotation></semantics></math> by length-then-lex.</p>
</div>
<div id="A3.SS1.p4" class="ltx_para">
<p id="A3.SS1.p4.1" class="ltx_p">Both orders are order-isomorphic to <math id="A3.SS1.p4.m1" class="ltx_Math" alttext="\mathbb{N}" display="inline" intent=":literal"><semantics><mi>ℕ</mi><annotation encoding="application/x-tex">\mathbb{N}</annotation></semantics></math> (<a href="#A3.F8" title="In Monoids and canonical orders ‣ Appendix C Mathematical Background" class="ltx_ref"><span class="ltx_text ltx_ref_tag">Figure</span> <span class="ltx_text ltx_ref_tag">8</span></a>; each has finitely many elements
below any given one, and the order is total), which is exactly the structure the density
machinery of <a href="#S2.SS1" title="Ground set, generation in the limit, and breadth ‣ The Model" class="ltx_ref"><span class="ltx_text ltx_ref_tag">Section</span> <span class="ltx_text ltx_ref_tag">2.1</span></a> requires: a countable ground set with a canonical order in
which <math id="A3.SS1.p4.m2" class="ltx_Math" alttext="L[1\!\dots\!N]" display="inline" intent=":literal"><semantics><mrow><mi>L</mi><mo>⁡</mo><mrow><mo stretchy="false">[</mo><mrow><mpadded style="width:0.580em;" width="0.580em"><mi mathvariant="normal">…</mi></mpadded><mo lspace="0em" rspace="0em">​</mo><mi>N</mi></mrow><mo stretchy="false">]</mo></mrow></mrow><annotation encoding="application/x-tex">L[1\!\dots\!N]</annotation></semantics></math> is a well-defined initial segment.</p>
</div>
<figure id="A3.F8" class="ltx_figure"><span class="ltx_inline-block"><svg id="A3.F8.pic1" class="ltx_picture ltx_centering" height="211.15" overflow="visible" version="1.1" viewBox="0 0 519.9 211.15" width="519.9"><g style="--ltx-stroke-color:#000000;--ltx-fill-color:#000000;" fill="#000000" stroke="#000000" stroke-width="0.4pt" transform="translate(0,211.15) matrix(1 0 0 -1 0 0) translate(45.57,0) translate(0,52.35)"><g style="--ltx-stroke-color:#A6A6A6;--ltx-fill-color:#A6A6A6;--ltx-fg-color:#A6A6A6;" color="#A6A6A6" fill="#A6A6A6" stroke="#A6A6A6"><path style="fill:none" d="M 0 0 L 149.16 0"></path></g><g style="--ltx-stroke-color:#A6A6A6;--ltx-fill-color:#A6A6A6;--ltx-fg-color:#A6A6A6;" color="#A6A6A6" fill="#A6A6A6" stroke="#A6A6A6" stroke-dasharray="none" stroke-dashoffset="0.0pt" stroke-linejoin="miter" transform="matrix(1.0 0.0 0.0 1.0 146.9 0)"><path d="M 5.9 0 L 0.89 1.87 L 2.4 0 L 0.89 -1.87 Z"></path></g><g style="--ltx-stroke-color:#000000;--ltx-fill-color:#000000;--ltx-fg-color:#000000;" color="#000000" fill="#000000" stroke="#000000" transform="matrix(1.0 0.0 0.0 1.0 140.3 -11.51)"><foreignObject style="--ltx-fg-color:#000000;--ltx-fo-width:1.22em;--ltx-fo-height:0.58em;--ltx-fo-depth:0.12em;font-size:8.19pt;" color="#000000" height="8" overflow="visible" transform="matrix(1 0 0 -1 0 6.62)" width="13.89"><span class="ltx_foreignobject_container"><span class="ltx_foreignobject_content"><math id="A3.F8.pic1.m1" class="ltx_Math" alttext="N_{1}" display="inline" intent=":literal"><semantics><msub><mi style="--ltx-fg-color:#000000;" mathcolor="#000000" mathsize="0.700em">N</mi><mn style="--ltx-fg-color:#000000;" mathcolor="#000000" mathsize="0.700em">1</mn></msub><annotation encoding="application/x-tex">N_{1}</annotation></semantics></math></span></span></foreignObject></g><g style="--ltx-stroke-color:#A6A6A6;--ltx-fill-color:#A6A6A6;--ltx-fg-color:#A6A6A6;" color="#A6A6A6" fill="#A6A6A6" stroke="#A6A6A6"><path style="fill:none" d="M 0 0 L 0 149.16"></path></g><g style="--ltx-stroke-color:#A6A6A6;--ltx-fill-color:#A6A6A6;--ltx-fg-color:#A6A6A6;" color="#A6A6A6" fill="#A6A6A6" stroke="#A6A6A6" stroke-dasharray="none" stroke-dashoffset="0.0pt" stroke-linejoin="miter" transform="matrix(0.0 1.0 -1.0 0.0 0 146.9)"><path d="M 5.9 0 L 0.89 1.87 L 2.4 0 L 0.89 -1.87 Z"></path></g><g style="--ltx-stroke-color:#000000;--ltx-fill-color:#000000;--ltx-fg-color:#000000;" color="#000000" fill="#000000" stroke="#000000" transform="matrix(1.0 0.0 0.0 1.0 -18.77 147.57)"><foreignObject style="--ltx-fg-color:#000000;--ltx-fo-width:1.22em;--ltx-fo-height:0.58em;--ltx-fo-depth:0.12em;font-size:8.19pt;" color="#000000" height="8" overflow="visible" transform="matrix(1 0 0 -1 0 6.62)" width="13.89"><span class="ltx_foreignobject_container"><span class="ltx_foreignobject_content"><math id="A3.F8.pic1.m2" class="ltx_Math" alttext="N_{2}" display="inline" intent=":literal"><semantics><msub><mi style="--ltx-fg-color:#000000;" mathcolor="#000000" mathsize="0.700em">N</mi><mn style="--ltx-fg-color:#000000;" mathcolor="#000000" mathsize="0.700em">2</mn></msub><annotation encoding="application/x-tex">N_{2}</annotation></semantics></math></span></span></foreignObject></g><g style="--ltx-stroke-color:#000099;--ltx-fill-color:#000099;--ltx-fg-color:#000099;" color="#000099" fill="#000099" stroke="#000099"><path style="stroke:none" d="M 39.37 0 M 41.72 0 C 41.72 1.3 40.67 2.35 39.37 2.35 C 38.07 2.35 37.02 1.3 37.02 0 C 37.02 -1.3 38.07 -2.35 39.37 -2.35 C 40.67 -2.35 41.72 -1.3 41.72 0 Z M 39.37 0"></path></g><g style="--ltx-stroke-color:#000080;--ltx-fill-color:#000080;--ltx-fg-color:#000080;" color="#000080" fill="#000080" stroke="#000080" transform="matrix(1.0 0.0 0.0 1.0 42.88 -9.35)"><foreignObject style="--ltx-fg-color:#000000;--ltx-fo-width:0.5em;--ltx-fo-height:0.47em;--ltx-fo-depth:0em;font-size:6.81pt;" color="#000000" height="4.46" overflow="visible" transform="matrix(1 0 0 -1 0 4.46)" width="4.71"><span class="ltx_foreignobject_container"