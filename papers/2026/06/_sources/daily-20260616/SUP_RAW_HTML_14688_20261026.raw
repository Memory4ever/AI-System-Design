<span id="A5.p2.1.4.1.1" class="ltx_inline-block ltx_align_top" style="width:93.2pt;">
<span id="A5.p2.1.4.1.1.1" class="ltx_p">feedback queries to the target <cite class="ltx_cite ltx_citemacro_citep">(<a href="#bib.bib8" title="" class="ltx_ref">Charikar and Pabbaraju, 2025</a>; <a href="#bib.bib9" title="" class="ltx_ref">Bai et al., 2026</a>)</cite></span>
</span></td>
<td id="A5.p2.1.4.2" class="ltx_td ltx_align_left ltx_align_top" style="padding-top:1.25pt;padding-bottom:1.25pt;">
<span id="A5.p2.1.4.2.1" class="ltx_inline-block ltx_align_top" style="width:103.5pt;">
<span id="A5.p2.1.4.2.1.1" class="ltx_p">is <math id="A5.m3" class="ltx_Math" alttext="x" display="inline" intent=":literal"><semantics><mi>x</mi><annotation encoding="application/x-tex">x</annotation></semantics></math> in <math id="A5.m4" class="ltx_Math" alttext="H" display="inline" intent=":literal"><semantics><mi>H</mi><annotation encoding="application/x-tex">H</annotation></semantics></math> (same-level membership)</span>
</span></td>
