<td id="A7.T5.4.7.1" class="ltx_td ltx_align_right"><span id="A7.T5.4.7.1.1" class="ltx_text" style="font-size:80%;">16</span></td>
<td id="A7.T5.4.7.2" class="ltx_td ltx_align_left"><em id="A7.T5.4.7.2.1" class="ltx_emph ltx_font_italic" style="font-size:80%;">recycle</em><span id="A7.T5.4.7.2.2" class="ltx_text" style="font-size:80%;"> (<math id="A7.T5.m15" class="ltx_Math" alttext="=a_{5}" display="inline" intent=":literal"><semantics><mrow><mphantom></mphantom><mo>=</mo><msub><mi>a</mi><mn>5</mn></msub></mrow><annotation encoding="application/x-tex">=a_{5}</annotation></semantics></math>)</span></td>
<td id="A7.T5.4.7.3" class="ltx_td ltx_align_left"><span id="A7.T5.4.7.3.1" class="ltx_text ltx_font_bold" style="font-size:80%;">sweep</span></td>
<td id="A7.T5.4.7.4" class="ltx_td ltx_align_right"><span id="A7.T5.4.7.4.1" class="ltx_text" style="font-size:80%;">26</span></td>
<td id="A7.T5.4.7.5" class="ltx_td ltx_nopad_r ltx_align_right"><span id="A7.T5.4.7.5.1" class="ltx_text ltx_font_bold" style="font-size:80%;">12</span></td></tr>
<tr id="A7.T5.4.8" class="ltx_tr">
<td id="A7.T5.4.8.1" class="ltx_td ltx_align_right"><span id="A7.T5.4.8.1.1" class="ltx_text" style="font-size:80%;">17</span></td>
<td id="A7.T5.4.8.2" class="ltx_td ltx_align_left"><span id="A7.T5.4.8.2.1" class="ltx_text" style="font-size:80%;">fresh</span></td>
<td id="A7.T5.4.8.3" class="ltx_td ltx_align_left"><span id="A7.T5.4.8.3.1" class="ltx_text" style="font-size:80%;">race</span></td>
