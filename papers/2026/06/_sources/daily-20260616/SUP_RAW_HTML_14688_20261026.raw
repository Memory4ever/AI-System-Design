<span id="A5.p2.1.1.2.1" class="ltx_inline-block ltx_align_top" style="width:103.5pt;">
<span id="A5.p2.1.1.2.1.1" class="ltx_p">Oracle answers</span>
</span></td>
<td id="A5.p2.1.1.3" class="ltx_td ltx_nopad_r ltx_align_left ltx_align_top ltx_border_tt" style="padding-top:1.25pt;padding-bottom:1.25pt;">
