27.17 28.74 L 327.17 17.72 Z M 327.17 28.74"></path></g><g style="--ltx-stroke-color:#000000;--ltx-fill-color:#000000;" fill="#000000" stroke="#000000" transform="matrix(1.0 0.0 0.0 1.0 426.15 18.96)"><foreignObject style="--ltx-fo-width:4.4em;--ltx-fo-height:0.77em;--ltx-fo-depth:0em;font-size:7.97pt;" height="8.55" overflow="visible" transform="matrix(1 0 0 -1 0 8.55)" width="48.52"><span class="ltx_foreignobject_container"><span class="ltx_foreignobject_content"><math id="S3.F6.pic1.m10" class="ltx_Math" alttext="T=10^{6}" display="inline" intent=":literal"><semantics><mrow><mi mathsize="0.700em">T</mi><mo mathsize="0.700em">=</mo><msup><mn mathsize="0.700em">10</mn><mn mathsize="0.700em">6</mn></msup></mrow><annotation encoding="application/x-tex">T=10^{6}</annotation></semantics></math><span id="S3.F6.pic1.4" class="ltx_text" style="font-size:70%;">:  <math id="S3.F6.pic1.m11" class="ltx_Math" alttext="0.830" display="inline" intent=":literal"><semantics><mn>0.830</mn><annotation encoding="application/x-tex">0.830</annotation></semantics></math></span></span></span></foreignObject></g><g style="--ltx-stroke-color:#B3B3B3;--ltx-fill-color:#B3B3B3;--ltx-fg-color:#B3B3B3;" color="#B3B3B3" fill="#B3B3B3" stroke="#B3B3B3"><path style="fill:none" d="M 208.66 76.38 L 208.66 38.24"></path></g><g style="--ltx-stroke-color:#B3B3B3;--ltx-fill-color:#B3B3B3;--ltx-fg-color:#B3B3B3;" color="#B3B3B3" fill="#B3B3B3" stroke="#B3B3B3" stroke-dasharray="none" stroke-dashoffset="0.0pt" stroke-linejoin="miter" transform="matrix(0.0 -1.0 1.0 0.0 208.66 40.5)"><path d="M 5.9 0 L 0.89 1.87 L 2.4 0 L 0.89 -1.87 Z"></path></g><g style="--ltx-stroke-color:#000000;--ltx-fill-color:#000000;" fill="#000000" stroke="#000000" transform="matrix(1.0 0.0 0.0 1.0 33.06 -21.84)"><g class="ltx_tikzmatrix" transform="matrix(1 0 0 -1 0 19.37)"><g class="ltx_tikzmatrix_row" transform="matrix(1 0 0 1 0 7.26)"><g class="ltx_tikzmatrix_col ltx_nopad_r" transform="matrix(1 0 0 -1 0 0)"><foreignObject style="--ltx-fo-width:24.52em;--ltx-fo-height:0.61em;--ltx-fo-depth:0.17em;font-size:7.97pt;" height="8.61" overflow="visible" transform="matrix(1 0 0 -1 0 6.73)" width="270.52"><span class="ltx_foreignobject_container"><span class="ltx_foreignobject_content"><span id="S3.F6.pic1.5" class="ltx_text" style="font-size:70%;">the horizon </span><math id="S3.F6.pic1.m12" class="ltx_Math" alttext="T" display="inline" intent=":literal"><semantics><mi mathsize="0.700em">T</mi><annotation encoding="application/x-tex">T</annotation></semantics></math><span id="S3.F6.pic1.6" class="ltx_text" style="font-size:70%;"> grows; the reading at the </span><em id="S3.F6.pic1.7" class="ltx_emph ltx_font_italic" style="font-size:70%;">fixed</em><span id="S3.F6.pic1.8" class="ltx_text" style="font-size:70%;"> prefix climbs to
</span><math id="S3.F6.pic1.m13" class="ltx_Math" alttext="1-\alpha/2=5/6" display="inline" intent=":literal"><semantics><mrow><mrow><mn mathsize="0.700em">1</mn><mo mathsize="0.700em">−</mo><mrow><mi mathsize="0.700em">α</mi><mo maxsize="0.700em" minsize="0.700em" stretchy="true" symmetric="true">/</mo><mn mathsize="0.700em">2</mn></mrow></mrow><mo mathsize="0.700em">=</mo><mrow><mn mathsize="0.700em">5</mn><mo maxsize="0.700em" minsize="0.700em" stretchy="true" symmetric="true">/</mo><mn mathsize="0.700em">6</mn></mrow></mrow><annotation encoding="application/x-tex">1-\alpha/2=5/6</annotation></semantics></math></span></span></foreignObject></g></g><g class="ltx_tikzmatrix_row" transform="matrix(1 0 0 1 0 16.95)"><g class="ltx_tikzmatrix_col ltx_nopad_r" transform="matrix(1 0 0 -1 10.46 0)"><foreignObject style="--ltx-fo-width:29.25em;--ltx-fo-height:0.66em;--ltx-fo-depth:0.22em;font-size:7.97pt;" height="9.69" overflow="visible" transform="matrix(1 0 0 -1 0 7.26)" width="322.65"><span class="ltx_foreignobject_container"><span class="ltx_foreignobject_content"><span id="S3.F6.pic1.9" class="ltx_text" style="font-size:70%;">(sweep rounds have density </span><math id="S3.F6.pic1.m14" class="ltx_Math" alttext="0" display="inline" intent=":literal"><semantics><mn mathsize="0.700em">0</mn><annotation encoding="application/x-tex">0</annotation></semantics></math><span id="S3.F6.pic1.10" class="ltx_text" style="font-size:70%;">: the trivia </span><em id="S3.F6.pic1.11" class="ltx_emph ltx_font_italic" style="font-size:70%;">count</em><span id="S3.F6.pic1.12" class="ltx_text" style="font-size:70%;"> is infinite, the rate is not)</span></span></span></foreignObject></g></g></g></g></g></svg></span>
<figcaption class="ltx_caption ltx_centering"><span class="ltx_tag ltx_tag_figure"><span id="S3.F6.3" class="ltx_text" style="font-size:90%;">Figure 6</span>: </span><span id="S3.F6.4" class="ltx_text" style="font-size:90%;">Coverage is a property of the limit set. Snapshots of the same fixed
prefix <math id="S3.F6.m5" class="ltx_Math" alttext="K^{\prime}[1\!\dots\!N]" display="inline" intent=":literal"><semantics><mrow><msup><mi>K</mi><mo>′</mo></msup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">[</mo><mrow><mpadded style="width:0.600em;" width="0.600em"><mi mathvariant="normal">…</mi></mpadded><mo lspace="0em" rspace="0em">​</mo><mi>N</mi></mrow><mo stretchy="false">]</mo></mrow></mrow><annotation encoding="application/x-tex">K^{\prime}[1\!\dots\!N]</annotation></semantics></math> (<math id="S3.F6.m6" class="ltx_Math" alttext="\alpha=1/3" display="inline" intent=":literal"><semantics><mrow><mi>α</mi><mo>=</mo><mrow><mn>1</mn><mo>/</mo><mn>3</mn></mrow></mrow><annotation encoding="application/x-tex">\alpha=1/3</annotation></semantics></math>) as the horizon grows; the measured
coverage (right, from <a href="#A6" title="Appendix F Numerical Validation" class="ltx_ref"><span class="ltx_text ltx_ref_tag">Appendix</span> <span class="ltx_text ltx_ref_tag">F</span></a>) climbs to <math id="S3.F6.m7" class="ltx_Math" alttext="1-\alpha/2" display="inline" intent=":literal"><semantics><mrow><mn>1</mn><mo>−</mo><mrow><mi>α</mi><mo>/</mo><mn>2</mn></mrow></mrow><annotation encoding="application/x-tex">1-\alpha/2</annotation></semantics></math>. Sweep
rounds are sparse, so the trivia rate vanishes even though every <math id="S3.F6.m8" class="ltx_Math" alttext="D" display="inline" intent=":literal"><semantics><mi>D</mi><annotation encoding="application/x-tex">D</annotation></semantics></math>-cell is
eventually claimed. The snapshots also illustrate why simulations must fix the
prefix and grow the horizon.</span></figcaption>
</figure>
<div id="S3.SS3.SSS0.Px1.p8" class="ltx_para">
<p id="S3.SS3.SSS0.Px1.p8.1" class="ltx_p">For a countable collection <math id="S3.SS3.SSS0.Px1.p8.m1" class="ltx_Math" alttext="\mathcal{H}" display="inline" intent=":literal"><semantics><mi class="ltx_font_mathcaligraphic">ℋ</mi><annotation encoding="application/x-tex">\mathcal{H}</annotation></semantics></math>, write <math id="S3.SS3.SSS0.Px1.p8.m2" class="ltx_Math" alttext="U_{t}=\bigcup\{H^{\prime}\in\mathcal{H}:S_{t}\subseteq H^{\prime}\}" display="inline" intent=":literal"><semantics><mrow><msub><mi>U</mi><mi>t</mi></msub><mo rspace="0.111em">=</mo><mrow><mo rspace="0em">⋃</mo><mrow><mo stretchy="false">{</mo><mrow><msup><mi>H</mi><mo>′</mo></msup><mo>∈</mo><mi class="ltx_font_mathcaligraphic">ℋ</mi></mrow><mo lspace="0.278em" rspace="0.278em">:</mo><mrow><msub><mi>S</mi><mi>t</mi></msub><mo>⊆</mo><msup><mi>H</mi><mo>′</mo></msup></mrow><mo stretchy="false">}</mo></mrow></mrow></mrow><annotation encoding="application/x-tex">U_{t}=\bigcup\{H^{\prime}\in\mathcal{H}:S_{t}\subseteq H^{\prime}\}</annotation></semantics></math> for the union of the consistent candidates and let <math id="S3.SS3.SSS0.Px1.p8.m3" class="ltx_Math" alttext="\mathcal{I}^{(t)}" display="inline" intent=":literal"><semantics><msup><mi class="ltx_font_mathcaligraphic">ℐ</mi><mrow><mo stretchy="false">(</mo><mi>t</mi><mo stretchy="false">)</mo></mrow></msup><annotation encoding="application/x-tex">\mathcal{I}^{(t)}</annotation></semantics></math> be KW’s identified
intersection (<a href="#S2.Thmtheorem1" title="Fact 2.1 (Partial-enumeration generation; ( , , Theorem 1.6 in arXiv version)). ‣ Partial enumeration and the revealed core ‣ The Model" class="ltx_ref"><span class="ltx_text ltx_ref_tag">Fact</span> <span class="ltx_text ltx_ref_tag">2.1</span></a>); the universal sweep generator is</p>
<table id="S3.E3" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="S3.E3.m1" class="ltx_math_unparsed" alttext="a_{t}=\begin{cases}\prec\text{-least of }U_{t}\setminus(S_{t}\cup O_{t-1}),&amp;t\in R\coloneqq\{k^{2}:k\geq 1\},\\[2.0pt]
\prec\text{-least of }\mathcal{I}^{(t)}\setminus(S_{t}\cup O_{t-1}),&amp;t\notin R.\end{cases}" display="block" intent=":literal"><semantics><mrow><mi>a</mi><msub><mrow></mrow><mi>t</mi></msub><mo>=</mo><mrow><mo>{</mo><mtable columnspacing="5pt" displaystyle="true" rowspacing="0pt"><mtr><mtd class="ltx_align_left" columnalign="left"><mrow><mrow><mphantom></mphantom><mo>≺</mo><mrow><mrow><mtext>-least of </mtext><mo lspace="0em" rspace="0em">​</mo><msub><mi>U</mi><mi>t</mi></msub></mrow><mo>∖</mo><mrow><mo stretchy="false">(</mo><mrow><msub><mi>S</mi><mi>t</mi></msub><mo>∪</mo><msub><mi>O</mi><mrow><mi>t</mi><mo>−</mo><mn>1</mn></mrow></msub></mrow><mo stretchy="false">)</mo></mrow></mrow></mrow><mo>,</mo></mrow></mtd><mtd class="ltx_align_left" columnalign="left"><mrow><mrow><mi>t</mi><mo>∈</mo><mi>R</mi><mo>≔</mo><mrow><mo stretchy="false">{</mo><msup><mi>k</mi><mn>2</mn></msup><mo lspace="0.278em" rspace="0.278em">:</mo><mrow><mi>k</mi><mo>≥</mo><mn>1</mn></mrow><mo stretchy="false">}</mo></mrow></mrow><mo>,</mo></mrow></mtd></mtr><mtr><mtd class="ltx_align_left" columnalign="left"><mrow><mrow><mphantom></mphantom><mo>≺</mo><mrow><mrow><mtext>-least of </mtext><mo lspace="0em" rspace="0em">​</mo><msup><mi class="ltx_font_mathcaligraphic">ℐ</mi><mrow><mo stretchy="false">(</mo><mi>t</mi><mo stretchy="false">)</mo></mrow></msup></mrow><mo>∖</mo><mrow><mo stretchy="false">(</mo><mrow><msub><mi>S</mi><mi>t</mi></msub><mo>∪</mo><msub><mi>O</mi><mrow><mi>t</mi><mo>−</mo><mn>1</mn></mrow></msub></mrow><mo stretchy="false">)</mo></mrow></mrow></mrow><mo>,</mo></mrow></mtd><mtd class="ltx_align_left" columnalign="left"><mrow><mrow><mi>t</mi><mo>∉</mo><mi>R</mi></mrow><mo lspace="0em">.</mo></mrow></mtd></mtr></mtable></mrow></mrow><annotation encoding="application/x-tex">a_{t}=\begin{cases}\prec\text{-least of }U_{t}\setminus(S_{t}\cup O_{t-1}),&amp;t\in R\coloneqq\{k^{2}:k\geq 1\},\\[2.0pt]
\prec\text{-least of }\mathcal{I}^{(t)}\setminus(S_{t}\cup O_{t-1}),&amp;t\notin R.\end{cases}</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td>
<td rowspan="1" class="ltx_eqn_cell ltx_eqn_eqno ltx_align_middle ltx_align_right"><span class="ltx_tag ltx_tag_equation ltx_align_right">(3.3)</span></td></tr></tbody>
</table>
<p id="S3.SS3.SSS0.Px1.p8.2" class="ltx_p">(In spirit, <math id="S3.SS3.SSS0.Px1.p8.m4" class="ltx_Math" alttext="G_{\mathrm{sw}}" display="inline" intent=":literal"><semantics><msub><mi>G</mi><mi>sw</mi></msub><annotation encoding="application/x-tex">G_{\mathrm{sw}}</annotation></semantics></math> is the gleaner of Millet’s painting: it walks the field
in canonical order and gathers whatever the reapers have left behind.) On the tight family,
with <math id="S3.SS3.SSS0.Px1.p8.m5" class="ltx_Math" alttext="\mathcal{H}_{t}=\{H^{\prime}\in\mathcal{H}_{\alpha}:S_{t}\subseteq H^{\prime}\}" display="inline" intent=":literal"><semantics><mrow><msub><mi class="ltx_font_mathcaligraphic">ℋ</mi><mi>t</mi></msub><mo>=</mo><mrow><mo stretchy="false">{</mo><mrow><msup><mi>H</mi><mo>′</mo></msup><mo>∈</mo><msub><mi class="ltx_font_mathcaligraphic">ℋ</mi><mi>α</mi></msub></mrow><mo lspace="0.278em" rspace="0.278em">:</mo><mrow><msub><mi>S</mi><mi>t</mi></msub><mo>⊆</mo><msup><mi>H</mi><mo>′</mo></msup></mrow><mo stretchy="false">}</mo></mrow></mrow><annotation encoding="application/x-tex">\mathcal{H}_{t}=\{H^{\prime}\in\mathcal{H}_{\alpha}:S_{t}\subseteq H^{\prime}\}</annotation></semantics></math>, <math id="S3.SS3.SSS0.Px1.p8.m6" class="ltx_Math" alttext="U_{t}=\bigcup\mathcal{H}_{t}" display="inline" intent=":literal"><semantics><mrow><msub><mi>U</mi><mi>t</mi></msub><mo rspace="0.111em">=</mo><mrow><mo>⋃</mo><msub><mi class="ltx_font_mathcaligraphic">ℋ</mi><mi>t</mi></msub></mrow></mrow><annotation encoding="application/x-tex">U_{t}=\bigcup\mathcal{H}_{t}</annotation></semantics></math>, and <math id="S3.SS3.SSS0.Px1.p8.m7" class="ltx_Math" alttext="I_{t}=\bigcap\mathcal{H}_{t}" display="inline" intent=":literal"><semantics><mrow><msub><mi>I</mi><mi>t</mi></msub><mo rspace="0.111em">=</mo><mrow><mo>⋂</mo><msub><mi class="ltx_font_mathcaligraphic">ℋ</mi><mi>t</mi></msub></mrow></mrow><annotation encoding="application/x-tex">I_{t}=\bigcap\mathcal{H}_{t}</annotation></semantics></math>, the tight generator is</p>
<table id="S3.E4" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="S3.E4.m1" class="ltx_math_unparsed" alttext="a_{t}=\begin{cases}\prec\text{-least of }U_{t}\setminus(S_{t}\cup O_{t-1}),&amp;t\in R\coloneqq\{k^{2}:k\geq 1\},\\[2.0pt]
\prec\text{-least of }I_{t}\setminus(S_{t}\cup O_{t-1}),&amp;t\notin R.\end{cases}" display="block" intent=":literal"><semantics><mrow><mi>a</mi><msub><mrow></mrow><mi>t</mi></msub><mo>=</mo><mrow><mo>{</mo><mtable columnspacing="5pt" displaystyle="true" rowspacing="0pt"><mtr><mtd class="ltx_align_left" columnalign="left"><mrow><mrow><mphantom></mphantom><mo>≺</mo><mrow><mrow><mtext>-least of </mtext><mo lspace="0em" rspace="0em">​</mo><msub><mi>U</mi><mi>t</mi></msub></mrow><mo>∖</mo><mrow><mo stretchy="false">(</mo><mrow><msub><mi>S</mi><mi>t</mi></msub><mo>∪</mo><msub><mi>O</mi><mrow><mi>t</mi><mo>−</mo><mn>1</mn></mrow></msub></mrow><mo stretchy="false">)</mo></mrow></mrow></mrow><mo>,</mo></mrow></mtd><mtd class="ltx_align_left" columnalign="left"><mrow><mrow><mi>t</mi><mo>∈</mo><mi>R</mi><mo>≔</mo><mrow><mo stretchy="false">{</mo><msup><mi>k</mi><mn>2</mn></msup><mo lspace="0.278em" rspace="0.278em">:</mo><mrow><mi>k</mi><mo>≥</mo><mn>1</mn></mrow><mo stretchy="false">}</mo></mrow></mrow><mo>,</mo></mrow></mtd></mtr><mtr><mtd class="ltx_align_left" columnalign="left"><mrow><mrow><mphantom></mphantom><mo>≺</mo><mrow><mrow><mtext>-least of </mtext><mo lspace="0em" rspace="0em">​</mo><msub><mi>I</mi><mi>t</mi></msub></mrow><mo>∖</mo><mrow><mo stretchy="false">(</mo><mrow><msub><mi>S</mi><mi>t</mi></msub><mo>∪</mo><msub><mi>O</mi><mrow><mi>t</mi><mo>−</mo><mn>1</mn></mrow></msub></mrow><mo stretchy="false">)</mo></mrow></mrow></mrow><mo>,</mo></mrow></mtd><mtd class="ltx_align_left" columnalign="left"><mrow><mrow><mi>t</mi><mo>∉</mo><mi>R</mi></mrow><mo lspace="0em">.</mo></mrow></mtd></mtr></mtable></mrow></mrow><annotation encoding="application/x-tex">a_{t}=\begin{cases}\prec\text{-least of }U_{t}\setminus(S_{t}\cup O_{t-1}),&amp;t\in R\coloneqq\{k^{2}:k\geq 1\},\\[2.0pt]
\prec\text{-least of }I_{t}\setminus(S_{t}\cup O_{t-1}),&amp;t\notin R.\end{cases}</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td>
<td rowspan="1" class="ltx_eqn_cell ltx_eqn_eqno ltx_align_middle ltx_align_right"><span class="ltx_tag ltx_tag_equation ltx_align_right">(3.4)</span></td></tr></tbody>
</table>
</div>
<div id="S3.Thmtheorem7" class="ltx_theorem ltx_theorem_theorem">
<h6 class="ltx_title ltx_runin ltx_title_theorem"><span class="ltx_tag ltx_tag_theorem"><span id="S3.Thmtheorem7.2" class="ltx_text ltx_font_bold">Theorem 3.7</span></span><span id="S3.Thmtheorem7.3" class="ltx_text ltx_font_bold"> </span>(Achievability side: sweep and the tight generator)<span id="S3.Thmtheorem7.4" class="ltx_text ltx_font_bold">.</span></h6>
<div id="S3.Thmtheorem7.p1" class="ltx_para">
<p id="S3.Thmtheorem7.p1.1" class="ltx_p"><span id="S3.Thmtheorem7.p1.1.1" class="ltx_text ltx_font_italic">With the partial model and limit-set coverage:</span></p>
<ol id="S3.I5" class="ltx_enumerate" style="--ltx-enum-leftmargin:2.2em;">
<li id="S3.I5.i1" class="ltx_item" style="list-style-type:none;"><span class="ltx_tag ltx_tag_item">(i)</span> 
<div id="S3.I5.i1.p1" class="ltx_para">
<p id="S3.I5.i1.p1.1" class="ltx_p"><span id="S3.I5.i1.p1.1.1" class="ltx_text">(Universal sweep)</span><span id="S3.I5.i1.p1.1.2" class="ltx_text ltx_font_italic"> The generator </span><math id="S3.I5.i1.p1.m1" class="ltx_Math" alttext="G_{\mathrm{sw}}" display="inline" intent=":literal"><semantics><msub><mi>G</mi><mi>sw</mi></msub><annotation encoding="application/x-tex">G_{\mathrm{sw}}</annotation></semantics></math><span id="S3.I5.i1.p1.1.3" class="ltx_text ltx_font_italic"> of (</span><a href="#S3.E3" title="Equation 3.3 ‣ The tight family. ‣ The trivia phase transition ‣ Main Results" class="ltx_ref ltx_font_italic"><span class="ltx_text ltx_ref_tag">3.3</span></a><span id="S3.I5.i1.p1.1.4" class="ltx_text ltx_font_italic">) is
sound (zero hallucination, unconditionally) and on every legal instance achieves </span><math id="S3.I5.i1.p1.m2" class="ltx_Math" alttext="O\supseteq H\setminus C" display="inline" intent=":literal"><semantics><mrow><mi>O</mi><mo>⊇</mo><mrow><mi>H</mi><mo>∖</mo><mi>C</mi></mrow></mrow><annotation encoding="application/x-tex">O\supseteq H\setminus C</annotation></semantics></math><span id="S3.I5.i1.p1.1.5" class="ltx_text ltx_font_italic">, hence coverage </span><math id="S3.I5.i1.p1.m3" class="ltx_Math" alttext="c\geq 1-\overline{d}(C,H)" display="inline" intent=":literal"><semantics><mrow><mi>c</mi><mo>≥</mo><mrow><mn>1</mn><mo>−</mo><mrow><mover accent="true"><mi>d</mi><mo stretchy="true">¯</mo></mover><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>C</mi><mo>,</mo><mi>H</mi><mo stretchy="false">)</mo></mrow></mrow></mrow></mrow><annotation encoding="application/x-tex">c\geq 1-\overline{d}(C,H)</annotation></semantics></math><span id="S3.I5.i1.p1.1.6" class="ltx_text ltx_font_italic"> (</span><math id="S3.I5.i1.p1.m4" class="ltx_Math" alttext="\geq 1-\alpha" display="inline" intent=":literal"><semantics><mrow><mphantom></mphantom><mo>≥</mo><mrow><mn>1</mn><mo>−</mo><mi>α</mi></mrow></mrow><annotation encoding="application/x-tex">\geq 1-\alpha</annotation></semantics></math><span id="S3.I5.i1.p1.1.7" class="ltx_text ltx_font_italic"> when </span><math id="S3.I5.i1.p1.m5" class="ltx_Math" alttext="d(C,H)=\alpha" display="inline" intent=":literal"><semantics><mrow><mrow><mi>d</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>C</mi><mo>,</mo><mi>H</mi><mo stretchy="false">)</mo></mrow></mrow><mo>=</mo><mi>α</mi></mrow><annotation encoding="application/x-tex">d(C,H)=\alpha</annotation></semantics></math><span id="S3.I5.i1.p1.1.8" class="ltx_text ltx_font_italic"> exists), with trivia rounds among </span><math id="S3.I5.i1.p1.m6" class="ltx_Math" alttext="[1\dots N]" display="inline" intent=":literal"><semantics><mrow><mo stretchy="false">[</mo><mrow><mn>1</mn><mo lspace="0em" rspace="0em">​</mo><mi mathvariant="normal">…</mi><mo lspace="0em" rspace="0em">​</mo><mi>N</mi></mrow><mo stretchy="false">]</mo></mrow><annotation encoding="application/x-tex">[1\dots N]</annotation></semantics></math><span id="S3.I5.i1.p1.1.9" class="ltx_text ltx_font_italic">
bounded by </span><math id="S3.I5.i1.p1.m7" class="ltx_Math" alttext="T_{0}+\lfloor\sqrt{N}\rfloor" display="inline" intent=":literal"><semantics><mrow><msub><mi>T</mi><mn>0</mn></msub><mo>+</mo><mrow><mo stretchy="false">⌊</mo><msqrt><mi>N</mi></msqrt><mo stretchy="false">⌋</mo></mrow></mrow><annotation encoding="application/x-tex">T_{0}+\lfloor\sqrt{N}\rfloor</annotation></semantics></math><span id="S3.I5.i1.p1.1.10" class="ltx_text ltx_font_italic"> (</span><math id="S3.I5.i1.p1.m8" class="ltx_Math" alttext="T_{0}" display="inline" intent=":literal"><semantics><msub><mi>T</mi><mn>0</mn></msub><annotation encoding="application/x-tex">T_{0}</annotation></semantics></math><span id="S3.I5.i1.p1.1.11" class="ltx_text ltx_font_italic"> finite, instance-dependent): the trivia
rate tends to </span><math id="S3.I5.i1.p1.m9" class="ltx_Math" alttext="0" display="inline" intent=":literal"><semantics><mn>0</mn><annotation encoding="application/x-tex">0</annotation></semantics></math><span id="S3.I5.i1.p1.1.12" class="ltx_text ltx_font_italic"> while the count is infinite in general (necessarily, by
</span><a href="#S3.Thmtheorem6" title="Theorem 3.6 (Impossibility side of the dichotomy). ‣ The tight family. ‣ The trivia phase transition ‣ Main Results" class="ltx_ref ltx_font_italic"><span class="ltx_text ltx_ref_tag">Theorem</span> <span class="ltx_text ltx_ref_tag">3.6</span></a><span id="S3.I5.i1.p1.1.13" class="ltx_text ltx_font_italic">(c)).</span></p>
</div></li>
<li id="S3.I5.i2" class="ltx_item" style="list-style-type:none;"><span class="ltx_tag ltx_tag_item">(ii)</span> 
<div id="S3.I5.i2.p1" class="ltx_para">
<p id="S3.I5.i2.p1.1" class="ltx_p"><span id="S3.I5.i2.p1.1.1" class="ltx_text">(Tight generator on <math id="S3.I5.i2.p1.m1" class="ltx_Math" alttext="\mathcal{H}_{\alpha}" display="inline" intent=":literal"><semantics><msub><mi class="ltx_font_mathcaligraphic">ℋ</mi><mi>α</mi></msub><annotation encoding="application/x-tex">\mathcal{H}_{\alpha}</annotation></semantics></math>)</span><span id="S3.I5.i2.p1.1.2" class="ltx_text ltx_font_italic"> On the tight family </span><math id="S3.I5.i2.p1.m2" class="ltx_Math" alttext="\mathcal{H}_{\alpha}" display="inline" intent=":literal"><semantics><msub><mi class="ltx_font_mathcaligraphic">ℋ</mi><mi>α</mi></msub><annotation encoding="application/x-tex">\mathcal{H}_{\alpha}</annotation></semantics></math><span id="S3.I5.i2.p1.1.3" class="ltx_text ltx_font_italic"> the single
deterministic generator </span><math id="S3.I5.i2.p1.m3" class="ltx_Math" alttext="G^{*}" display="inline" intent=":literal"><semantics><msup><mi>G</mi><mo>∗</mo></msup><annotation encoding="application/x-tex">G^{*}</annotation></semantics></math><span id="S3.I5.i2.p1.1.4" class="ltx_text ltx_font_italic"> of (</span><a href="#S3.E4" title="Equation 3.4 ‣ The tight family. ‣ The trivia phase transition ‣ Main Results" class="ltx_ref ltx_font_italic"><span class="ltx_text ltx_ref_tag">3.4</span></a><span id="S3.I5.i2.p1.1.5" class="ltx_text ltx_font_italic">) achieves, with zero hallucination:</span></p>
<ol id="S3.I5.i2.I1" class="ltx_enumerate" style="--ltx-enum-leftmargin:2.2em;">
<li id="S3.I5.i2.I1.i1" class="ltx_item" style="list-style-type:none;"><span class="ltx_tag ltx_tag_item">(a)</span> 
<div id="S3.I5.i2.I1.i1.p1" class="ltx_para">
<p id="S3.I5.i2.I1.i1.p1.1" class="ltx_p"><span id="S3.I5.i2.I1.i1.p1.1.1" class="ltx_text ltx_font_italic">truth </span><math id="S3.I5.i2.I1.i1.p1.m1" class="ltx_Math" alttext="K" display="inline" intent=":literal"><semantics><mi>K</mi><annotation encoding="application/x-tex">K</annotation></semantics></math><span id="S3.I5.i2.I1.i1.p1.1.2" class="ltx_text ltx_font_italic"> (any </span><math id="S3.I5.i2.I1.i1.p1.m2" class="ltx_Math" alttext="C\subseteq K" display="inline" intent=":literal"><semantics><mrow><mi>C</mi><mo>⊆</mo><mi>K</mi></mrow><annotation encoding="application/x-tex">C\subseteq K</annotation></semantics></math><span id="S3.I5.i2.I1.i1.p1.1.3" class="ltx_text ltx_font_italic">, any order): </span><math id="S3.I5.i2.I1.i1.p1.m3" class="ltx_Math" alttext="c\geq\max(1/2,\ 1-\overline{d}(C,K))" display="inline" intent=":literal"><semantics><mrow><mi>c</mi><mo>≥</mo><mrow><mi>max</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mrow><mn>1</mn><mo>/</mo><mn>2</mn></mrow><mo>,</mo><mrow><mn> 1</mn><mo>−</mo><mrow><mover accent="true"><mi>d</mi><mo stretchy="true">¯</mo></mover><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>C</mi><mo>,</mo><mi>K</mi><mo stretchy="false">)</mo></mrow></mrow></mrow><mo stretchy="false">)</mo></mrow></mrow></mrow><annotation encoding="application/x-tex">c\geq\max(1/2,\ 1-\overline{d}(C,K))</annotation></semantics></math><span id="S3.I5.i2.I1.i1.p1.1.4" class="ltx_text ltx_font_italic">, trivia rate </span><math id="S3.I5.i2.I1.i1.p1.m4" class="ltx_Math" alttext="\leq\lfloor\sqrt{N}\rfloor/N" display="inline" intent=":literal"><semantics><mrow><mphantom></mphantom><mo>≤</mo><mrow><mrow><mo stretchy="false">⌊</mo><msqrt><mi>N</mi></msqrt><mo stretchy="false">⌋</mo></mrow><mo>/</mo><mi>N</mi></mrow></mrow><annotation encoding="application/x-tex">\leq\lfloor\sqrt{N}\rfloor/N</annotation></semantics></math><span id="S3.I5.i2.I1.i1.p1.1.5" class="ltx_text ltx_font_italic">;</span></p>
</div></li>
<li id="S3.I5.i2.I1.i2" class="ltx_item" style="list-style-type:none;"><span class="ltx_tag ltx_tag_item">(b)</span> 
<div id="S3.I5.i2.I1.i2.p1" class="ltx_para">
<p id="S3.I5.i2.I1.i2.p1.1" class="ltx_p"><span id="S3.I5.i2.I1.i2.p1.1.1" class="ltx_text ltx_font_italic">truth </span><math id="S3.I5.i2.I1.i2.p1.m1" class="ltx_Math" alttext="K^{\prime}" display="inline" intent=":literal"><semantics><msup><mi>K</mi><mo>′</mo></msup><annotation encoding="application/x-tex">K^{\prime}</annotation></semantics></math><span id="S3.I5.i2.I1.i2.p1.1.2" class="ltx_text ltx_font_italic"> with </span><math id="S3.I5.i2.I1.i2.p1.m2" class="ltx_Math" alttext="C\subseteq K" display="inline" intent=":literal"><semantics><mrow><mi>C</mi><mo>⊆</mo><mi>K</mi></mrow><annotation encoding="application/x-tex">C\subseteq K</annotation></semantics></math><span id="S3.I5.i2.I1.i2.p1.1.3" class="ltx_text ltx_font_italic"> (covering all of </span><a href="#S3.Thmtheorem6" title="Theorem 3.6 (Impossibility side of the dichotomy). ‣ The tight family. ‣ The trivia phase transition ‣ Main Results" class="ltx_ref ltx_font_italic"><span class="ltx_text ltx_ref_tag">Theorem</span> <span class="ltx_text ltx_ref_tag">3.6</span></a><span id="S3.I5.i2.I1.i2.p1.1.4" class="ltx_text ltx_font_italic">(a)’s tight
instances): </span><math id="S3.I5.i2.I1.i2.p1.m3" class="ltx_Math" alttext="c\geq 1-\alpha/2-o(1)" display="inline" intent=":literal"><semantics><mrow><mi>c</mi><mo>≥</mo><mrow><mn>1</mn><mo>−</mo><mrow><mi>α</mi><mo>/</mo><mn>2</mn></mrow><mo>−</mo><mrow><mi>o</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mn>1</mn><mo stretchy="false">)</mo></mrow></mrow></mrow></mrow><annotation encoding="application/x-tex">c\geq 1-\alpha/2-o(1)</annotation></semantics></math><span id="S3.I5.i2.I1.i2.p1.1.5" class="ltx_text ltx_font_italic">, with zero trivia;</span></p>
</div></li>
<li id="S3.I5.i2.I1.i3" class="ltx_item" style="list-style-type:none;"><span class="ltx_tag ltx_tag_item">(c)</span> 
<div id="S3.I5.i2.I1.i3.p1" class="ltx_para">
<p id="S3.I5.i2.I1.i3.p1.1" class="ltx_p"><span id="S3.I5.i2.I1.i3.p1.1.1" class="ltx_text ltx_font_italic">truth </span><math id="S3.I5.i2.I1.i3.p1.m1" class="ltx_Math" alttext="K^{\prime}" display="inline" intent=":literal"><semantics><msup><mi>K</mi><mo>′</mo></msup><annotation encoding="application/x-tex">K^{\prime}</annotation></semantics></math><span id="S3.I5.i2.I1.i3.p1.1.2" class="ltx_text ltx_font_italic"> with </span><math id="S3.I5.i2.I1.i3.p1.m2" class="ltx_Math" alttext="C\not\subseteq K" display="inline" intent=":literal"><semantics><mrow><mi>C</mi><mo>⊈</mo><mi>K</mi></mrow><annotation encoding="application/x-tex">C\not\subseteq K</annotation></semantics></math><span id="S3.I5.i2.I1.i3.p1.1.3" class="ltx_text ltx_font_italic">: </span><math id="S3.I5.i2.I1.i3.p1.m3" class="ltx_Math" alttext="c\geq\max(1/2,\ 1-\overline{d}(C,K^{\prime}))" display="inline" intent=":literal"><semantics><mrow><mi>c</mi><mo>≥</mo><mrow><mi>max</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mrow><mn>1</mn><mo>/</mo><mn>2</mn></mrow><mo>,</mo><mrow><mn> 1</mn><mo>−</mo><mrow><mover accent="true"><mi>d</mi><mo stretchy="true">¯</mo></mover><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>C</mi><mo>,</mo><msup><mi>K</mi><mo>′</mo></msup><mo stretchy="false">)</mo></mrow></mrow></mrow><mo stretchy="false">)</mo></mrow></mrow></mrow><annotation encoding="application/x-tex">c\geq\max(1/2,\ 1-\overline{d}(C,K^{\prime}))</annotation></semantics></math><span id="S3.I5.i2.I1.i3.p1.1.4" class="ltx_text ltx_font_italic">,
zero trivia.</span></p>
</div></li>
</ol>
</div></li>
<li id="S3.I5.i3" class="ltx_item" style="list-style-type:none;"><span class="ltx_tag ltx_tag_item">(iii)</span> 
<div id="S3.I5.i3.p1" class="ltx_para">
<p id="S3.I5.i3.p1.1" class="ltx_p"><span id="S3.I5.i3.p1.1.1" class="ltx_text">(Finite-trivia side; restated)</span><span id="S3.I5.i3.p1.1.2" class="ltx_text ltx_font_italic"> </span><a href="#S2.Thmtheorem1" title="Fact 2.1 (Partial-enumeration generation; ( , , Theorem 1.6 in arXiv version)). ‣ Partial enumeration and the revealed core ‣ The Model" class="ltx_ref ltx_font_italic"><span class="ltx_text ltx_ref_tag">Fact</span> <span class="ltx_text ltx_ref_tag">2.1</span></a><span id="S3.I5.i3.p1.1.3" class="ltx_text ltx_font_italic"> gives a generator with
</span><math id="S3.I5.i3.p1.m1" class="ltx_Math" alttext="\underline{d}(O,H)\geq\tfrac{1}{2}\underline{d}(C,H)" display="inline" intent=":literal"><semantics><mrow><mrow><munder accentunder="true"><mi>d</mi><mo stretchy="true">¯</mo></munder><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>O</mi><mo>,</mo><mi>H</mi><mo stretchy="false">)</mo></mrow></mrow><mo>≥</mo><mrow><mfrac><mn>1</mn><mn>2</mn></mfrac><mo lspace="0em" rspace="0em">​</mo><munder accentunder="true"><mi>d</mi><mo stretchy="true">¯</mo></munder><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>C</mi><mo>,</mo><mi>H</mi><mo stretchy="false">)</mo></mrow></mrow></mrow><annotation encoding="application/x-tex">\underline{d}(O,H)\geq\tfrac{1}{2}\underline{d}(C,H)</annotation></semantics></math><span id="S3.I5.i3.p1.1.4" class="ltx_text ltx_font_italic"> for every countable collection and
eventually zero trivia; on </span><math id="S3.I5.i3.p1.m2" class="ltx_Math" alttext="\mathcal{H}_{\alpha}" display="inline" intent=":literal"><semantics><msub><mi class="ltx_font_mathcaligraphic">ℋ</mi><mi>α</mi></msub><annotation encoding="application/x-tex">\mathcal{H}_{\alpha}</annotation></semantics></math><span id="S3.I5.i3.p1.1.5" class="ltx_text ltx_font_italic"> it attains </span><math id="S3.I5.i3.p1.m3" class="ltx_Math" alttext="\alpha/2" display="inline" intent=":literal"><semantics><mrow><mi>α</mi><mo>/</mo><mn>2</mn></mrow><annotation encoding="application/x-tex">\alpha/2</annotation></semantics></math><span id="S3.I5.i3.p1.1.6" class="ltx_text ltx_font_italic"> at truth </span><math id="S3.I5.i3.p1.m4" class="ltx_Math" alttext="K^{\prime}" display="inline" intent=":literal"><semantics><msup><mi>K</mi><mo>′</mo></msup><annotation encoding="application/x-tex">K^{\prime}</annotation></semantics></math><span id="S3.I5.i3.p1.1.7" class="ltx_text ltx_font_italic"> and </span><math id="S3.I5.i3.p1.m5" class="ltx_Math" alttext="1/2" display="inline" intent=":literal"><semantics><mrow><mn>1</mn><mo>/</mo><mn>2</mn></mrow><annotation encoding="application/x-tex">1/2</annotation></semantics></math><span id="S3.I5.i3.p1.1.8" class="ltx_text ltx_font_italic"> at truth
</span><math id="S3.I5.i3.p1.m6" class="ltx_Math" alttext="K" display="inline" intent=":literal"><semantics><mi>K</mi><annotation encoding="application/x-tex">K</annotation></semantics></math><span id="S3.I5.i3.p1.1.9" class="ltx_text ltx_font_italic">, matching </span><a href="#S3.Thmtheorem6" title="Theorem 3.6 (Impossibility side of the dichotomy). ‣ The tight family. ‣ The trivia phase transition ‣ Main Results" class="ltx_ref ltx_font_italic"><span class="ltx_text ltx_ref_tag">Theorem</span> <span class="ltx_text ltx_ref_tag">3.6</span></a><span id="S3.I5.i3.p1.1.10" class="ltx_text ltx_font_italic">’s caps.</span></p>
</div></li>
</ol>
</div>
</div>
<div id="S3.SS3.SSS0.Px1.3" class="ltx_proof">
<h6 class="ltx_title ltx_runin ltx_font_italic ltx_title_proof">Proof sketch.</h6>
<div id="S3.SS3.SSS0.Px1.p9" class="ltx_para">
<p id="S3.SS3.SSS0.Px1.p9.1" class="ltx_p"><span id="S3.SS3.SSS0.Px1.p9.1.1" class="ltx_text">A pointer lemma drives (i): any <math id="S3.SS3.SSS0.Px1.p9.m1" class="ltx_Math" alttext="x\in H\setminus C" display="inline" intent=":literal"><semantics><mrow><mi>x</mi><mo>∈</mo><mrow><mi>H</mi><mo>∖</mo><mi>C</mi></mrow></mrow><annotation encoding="application/x-tex">x\in H\setminus C</annotation></semantics></math> stays in <math id="S3.SS3.SSS0.Px1.p9.m2" class="ltx_Math" alttext="U_{t}" display="inline" intent=":literal"><semantics><msub><mi>U</mi><mi>t</mi></msub><annotation encoding="application/x-tex">U_{t}</annotation></semantics></math> (as <math id="S3.SS3.SSS0.Px1.p9.m3" class="ltx_Math" alttext="H" display="inline" intent=":literal"><semantics><mi>H</mi><annotation encoding="application/x-tex">H</annotation></semantics></math> is
consistent) and is never enumerated, so if it were never output the sweep rounds (of which
there are infinitely many) would always emit a new element strictly below <math id="S3.SS3.SSS0.Px1.p9.m4" class="ltx_Math" alttext="x" display="inline" intent=":literal"><semantics><mi>x</mi><annotation encoding="application/x-tex">x</annotation></semantics></math>, which is
impossible, as only finitely many positions lie below <math id="S3.SS3.SSS0.Px1.p9.m5" class="ltx_Math" alttext="x" display="inline" intent=":literal"><semantics><mi>x</mi><annotation encoding="application/x-tex">x</annotation></semantics></math>. For (ii), <math id="S3.SS3.SSS0.Px1.p9.m6" class="ltx_Math" alttext="G^{*}" display="inline" intent=":literal"><semantics><msup><mi>G</mi><mo>∗</mo></msup><annotation encoding="application/x-tex">G^{*}</annotation></semantics></math> races on the
conjunction <math id="S3.SS3.SSS0.Px1.p9.m7" class="ltx_Math" alttext="I_{t}" display="inline" intent=":literal"><semantics><msub><mi>I</mi><mi>t</mi></msub><annotation encoding="application/x-tex">I_{t}</annotation></semantics></math> (which equals <math id="S3.SS3.SSS0.Px1.p9.m8" class="ltx_Math" alttext="K" display="inline" intent=":literal"><semantics><mi>K</mi><annotation encoding="application/x-tex">K</annotation></semantics></math> while the seen-set sits inside <math id="S3.SS3.SSS0.Px1.p9.m9" class="ltx_Math" alttext="K" display="inline" intent=":literal"><semantics><mi>K</mi><annotation encoding="application/x-tex">K</annotation></semantics></math>) and sweeps on the
union <math id="S3.SS3.SSS0.Px1.p9.m10" class="ltx_Math" alttext="U_{t}=K^{\prime}" display="inline" intent=":literal"><semantics><mrow><msub><mi>U</mi><mi>t</mi></msub><mo>=</mo><msup><mi>K</mi><mo>′</mo></msup></mrow><annotation encoding="application/x-tex">U_{t}=K^{\prime}</annotation></semantics></math>, so race covers half of <math id="S3.SS3.SSS0.Px1.p9.m11" class="ltx_Math" alttext="K" display="inline" intent=":literal"><semantics><mi>K</mi><annotation encoding="application/x-tex">K</annotation></semantics></math> and the sweep claims all of <math id="S3.SS3.SSS0.Px1.p9.m12" class="ltx_Math" alttext="D=K^{\prime}\setminus K" display="inline" intent=":literal"><semantics><mrow><mi>D</mi><mo>=</mo><mrow><msup><mi>K</mi><mo>′</mo></msup><mo>∖</mo><mi>K</mi></mrow></mrow><annotation encoding="application/x-tex">D=K^{\prime}\setminus K</annotation></semantics></math>;
at truth <math id="S3.SS3.SSS0.Px1.p9.m13" class="ltx_Math" alttext="K^{\prime}" display="inline" intent=":literal"><semantics><msup><mi>K</mi><mo>′</mo></msup><annotation encoding="application/x-tex">K^{\prime}</annotation></semantics></math> the two disjoint contributions sum to <math id="S3.SS3.SSS0.Px1.p9.m14" class="ltx_Math" alttext="1-\alpha/2" display="inline" intent=":literal"><semantics><mrow><mn>1</mn><mo>−</mo><mrow><mi>α</mi><mo>/</mo><mn>2</mn></mrow></mrow><annotation encoding="application/x-tex">1-\alpha/2</annotation></semantics></math>. A key consistency point:
at truth <math id="S3.SS3.SSS0.Px1.p9.m15" class="ltx_Math" alttext="K" display="inline" intent=":literal"><semantics><mi>K</mi><annotation encoding="application/x-tex">K</annotation></semantics></math> the sweep eventually claims all of <math id="S3.SS3.SSS0.Px1.p9.m16" class="ltx_Math" alttext="D" display="inline" intent=":literal"><semantics><mi>D</mi><annotation encoding="application/x-tex">D</annotation></semantics></math>, so <math id="S3.SS3.SSS0.Px1.p9.m17" class="ltx_Math" alttext="O\cap D=D" display="inline" intent=":literal"><semantics><mrow><mrow><mi>O</mi><mo>∩</mo><mi>D</mi></mrow><mo>=</mo><mi>D</mi></mrow><annotation encoding="application/x-tex">O\cap D=D</annotation></semantics></math> is infinite, which
is exactly why <a href="#S3.Thmtheorem6" title="Theorem 3.6 (Impossibility side of the dichotomy). ‣ The tight family. ‣ The trivia phase transition ‣ Main Results" class="ltx_ref"><span class="ltx_text ltx_ref_tag">Theorem</span> <span class="ltx_text ltx_ref_tag">3.6</span></a>(b)’s finite-trivia cap does not apply to <math id="S3.SS3.SSS0.Px1.p9.m18" class="ltx_Math" alttext="G^{*}" display="inline" intent=":literal"><semantics><msup><mi>G</mi><mo>∗</mo></msup><annotation encoding="application/x-tex">G^{*}</annotation></semantics></math>. For (iii) we
need nothing about the internal mechanics of KW’s generator: since it achieves generation in
the limit (<math id="S3.SS3.SSS0.Px1.p9.m19" class="ltx_Math" alttext="\exists t^{*}\,\forall t\geq t^{*}:a_{t}\in H\setminus S_{t}" display="inline" intent=":literal"><semantics><mrow><mrow><mo rspace="0.167em">∃</mo><mrow><msup><mi>t</mi><mo>∗</mo></msup><mo lspace="0.167em" rspace="0em">​</mo><mrow><mo rspace="0.167em">∀</mo><mi>t</mi></mrow></mrow></mrow><mo>≥</mo><msup><mi>t</mi><mo>∗</mo></msup><mo lspace="0.278em" rspace="0.278em">:</mo><mrow><msub><mi>a</mi><mi>t</mi></msub><mo>∈</mo><mrow><mi>H</mi><mo>∖</mo><msub><mi>S</mi><mi>t</mi></msub></mrow></mrow></mrow><annotation encoding="application/x-tex">\exists t^{*}\,\forall t\geq t^{*}:a_{t}\in H\setminus S_{t}</annotation></semantics></math>) and <math id="S3.SS3.SSS0.Px1.p9.m20" class="ltx_Math" alttext="H\subseteq F" display="inline" intent=":literal"><semantics><mrow><mi>H</mi><mo>⊆</mo><mi>F</mi></mrow><annotation encoding="application/x-tex">H\subseteq F</annotation></semantics></math>, it is eventually sound and eventually zero-trivia, which is exactly what our
soundness and finite-trivia hypotheses require. Full proof in <a href="#A4.SS5" title="Achievability: sweep and the tight generator () ‣ Appendix D Deferred Proofs" class="ltx_ref"><span class="ltx_text ltx_ref_tag">Section</span> <span class="ltx_text ltx_ref_tag">D.5</span></a>.
∎</span></p>
</div>
</div>
<div id="S3.Thmtheorem8" class="ltx_theorem ltx_theorem_remark">
<h6 class="ltx_title ltx_runin ltx_title_theorem"><span class="ltx_tag ltx_tag_theorem"><span id="S3.Thmtheorem8.2" class="ltx_text ltx_font_italic">Remark 3.8</span></span><span id="S3.Thmtheorem8.3" class="ltx_text ltx_font_italic"> </span>(Scope on part (ii))<span id="S3.Thmtheorem8.4" class="ltx_text ltx_font_italic">.</span></h6>
<div id="S3.Thmtheorem8.p1" class="ltx_para">
<p id="S3.Thmtheorem8.p1.1" class="ltx_p">The unqualified “<math id="S3.Thmtheorem8.p1.m1" class="ltx_Math" alttext="1-\alpha/2" display="inline" intent=":literal"><semantics><mrow><mn>1</mn><mo>−</mo><mrow><mi>α</mi><mo>/</mo><mn>2</mn></mrow></mrow><annotation encoding="application/x-tex">1-\alpha/2</annotation></semantics></math> at truth <math id="S3.Thmtheorem8.p1.m2" class="ltx_Math" alttext="K^{\prime}" display="inline" intent=":literal"><semantics><msup><mi>K</mi><mo>′</mo></msup><annotation encoding="application/x-tex">K^{\prime}</annotation></semantics></math>” is
false for general <math id="S3.Thmtheorem8.p1.m3" class="ltx_Math" alttext="C\subseteq K^{\prime}" display="inline" intent=":literal"><semantics><mrow><mi>C</mi><mo>⊆</mo><msup><mi>K</mi><mo>′</mo></msup></mrow><annotation encoding="application/x-tex">C\subseteq K^{\prime}</annotation></semantics></math>: if <math id="S3.Thmtheorem8.p1.m4" class="ltx_Math" alttext="C=K^{\prime}" display="inline" intent=":literal"><semantics><mrow><mi>C</mi><mo>=</mo><msup><mi>K</mi><mo>′</mo></msup></mrow><annotation encoding="application/x-tex">C=K^{\prime}</annotation></semantics></math> is enumerated by the racing adversary,
every generator is capped at <math id="S3.Thmtheorem8.p1.m5" class="ltx_Math" alttext="1/2" display="inline" intent=":literal"><semantics><mrow><mn>1</mn><mo>/</mo><mn>2</mn></mrow><annotation encoding="application/x-tex">1/2</annotation></semantics></math>. Case (b)’s restriction <math id="S3.Thmtheorem8.p1.m6" class="ltx_Math" alttext="C\subseteq K" display="inline" intent=":literal"><semantics><mrow><mi>C</mi><mo>⊆</mo><mi>K</mi></mrow><annotation encoding="application/x-tex">C\subseteq K</annotation></semantics></math> is exactly what
the dichotomy needs.</p>
</div>
</div>
<div id="S3.Thmtheorem9" class="ltx_theorem ltx_theorem_remark">
<h6 class="ltx_title ltx_runin ltx_title_theorem"><span class="ltx_tag ltx_tag_theorem"><span id="S3.Thmtheorem9.2" class="ltx_text ltx_font_italic">Remark 3.9</span></span><span id="S3.Thmtheorem9.3" class="ltx_text ltx_font_italic"> </span>(Consistency mechanism)<span id="S3.Thmtheorem9.4" class="ltx_text ltx_font_italic">.</span></h6>
<div id="S3.Thmtheorem9.p1" class="ltx_para">
<p id="S3.Thmtheorem9.p1.1" class="ltx_p">At truth <math id="S3.Thmtheorem9.p1.m1" class="ltx_Math" alttext="K" display="inline" intent=":literal"><semantics><mi>K</mi><annotation encoding="application/x-tex">K</annotation></semantics></math>, <math id="S3.Thmtheorem9.p1.m2" class="ltx_Math" alttext="G^{*}" display="inline" intent=":literal"><semantics><msup><mi>G</mi><mo>∗</mo></msup><annotation encoding="application/x-tex">G^{*}</annotation></semantics></math> emits infinitely many elements of <math id="S3.Thmtheorem9.p1.m3" class="ltx_Math" alttext="D=F\setminus K" display="inline" intent=":literal"><semantics><mrow><mi>D</mi><mo>=</mo><mrow><mi>F</mi><mo>∖</mo><mi>K</mi></mrow></mrow><annotation encoding="application/x-tex">D=F\setminus K</annotation></semantics></math> (the sweep covers
the union <math id="S3.Thmtheorem9.p1.m4" class="ltx_Math" alttext="K^{\prime}\supseteq D" display="inline" intent=":literal"><semantics><mrow><msup><mi>K</mi><mo>′</mo></msup><mo>⊇</mo><mi>D</mi></mrow><annotation encoding="application/x-tex">K^{\prime}\supseteq D</annotation></semantics></math>), so its trivia count there is infinite. This is the mechanism that
reconciles <a href="#S3.Thmtheorem6" title="Theorem 3.6 (Impossibility side of the dichotomy). ‣ The tight family. ‣ The trivia phase transition ‣ Main Results" class="ltx_ref"><span class="ltx_text ltx_ref_tag">Theorem</span> <span class="ltx_text ltx_ref_tag">3.6</span></a>(b) with <a href="#S3.Thmtheorem7" title="Theorem 3.7 (Achievability side: sweep and the tight generator). ‣ The tight family. ‣ The trivia phase transition ‣ Main Results" class="ltx_ref"><span class="ltx_text ltx_ref_tag">Theorem</span> <span class="ltx_text ltx_ref_tag">3.7</span></a>(ii): the finite-trivia cap of <math id="S3.Thmtheorem9.p1.m5" class="ltx_Math" alttext="\alpha/2" display="inline" intent=":literal"><semantics><mrow><mi>α</mi><mo>/</mo><mn>2</mn></mrow><annotation encoding="application/x-tex">\alpha/2</annotation></semantics></math>
governs only generators whose trivia count is finite on <em id="S3.Thmtheorem9.p1.1.1" class="ltx_emph ltx_font_italic">every</em> instance, and <math id="S3.Thmtheorem9.p1.m6" class="ltx_Math" alttext="G^{*}" display="inline" intent=":literal"><semantics><msup><mi>G</mi><mo>∗</mo></msup><annotation encoding="application/x-tex">G^{*}</annotation></semantics></math> is
not one of them. The infinitude of <math id="S3.Thmtheorem9.p1.m7" class="ltx_Math" alttext="O\cap D" display="inline" intent=":literal"><semantics><mrow><mi>O</mi><mo>∩</mo><mi>D</mi></mrow><annotation encoding="application/x-tex">O\cap D</annotation></semantics></math> at truth <math id="S3.Thmtheorem9.p1.m8" class="ltx_Math" alttext="K" display="inline" intent=":literal"><semantics><mi>K</mi><annotation encoding="application/x-tex">K</annotation></semantics></math> is precisely the resource that
pays for coverage <math id="S3.Thmtheorem9.p1.m9" class="ltx_Math" alttext="1-\alpha/2" display="inline" intent=":literal"><semantics><mrow><mn>1</mn><mo>−</mo><mrow><mi>α</mi><mo>/</mo><mn>2</mn></mrow></mrow><annotation encoding="application/x-tex">1-\alpha/2</annotation></semantics></math> at truth <math id="S3.Thmtheorem9.p1.m10" class="ltx_Math" alttext="K^{\prime}" display="inline" intent=":literal"><semantics><msup><mi>K</mi><mo>′</mo></msup><annotation encoding="application/x-tex">K^{\prime}</annotation></semantics></math>.</p>
</div>
</div>
<div id="S3.SS3.SSS0.Px1.p10" class="ltx_para">
<p id="S3.SS3.SSS0.Px1.p10.1" class="ltx_p">Combining the two sides gives the dichotomy in closed form.</p>
</div>
<div id="S3.Thmtheorem10" class="ltx_theorem ltx_theorem_corollary">
<h6 class="ltx_title ltx_runin ltx_title_theorem"><span class="ltx_tag ltx_tag_theorem"><span id="S3.Thmtheorem10.2" class="ltx_text ltx_font_bold">Corollary 3.10</span></span><span id="S3.Thmtheorem10.3" class="ltx_text ltx_font_bold"> </span>(The trivia dichotomy)<span id="S3.Thmtheorem10.4" class="ltx_text ltx_font_bold">.</span></h6>
<div id="S3.Thmtheorem10.p1" class="ltx_para">
<p id="S3.Thmtheorem10.p1.1" class="ltx_p"><span id="S3.Thmtheorem10.p1.1.1" class="ltx_text ltx_font_italic">On the tight family <math id="S3.Thmtheorem10.p1.m1" class="ltx_Math" alttext="\mathcal{H}_{\alpha}" display="inline" intent=":literal"><semantics><msub><mi class="ltx_font_mathcaligraphic">ℋ</mi><mi>α</mi></msub><annotation encoding="application/x-tex">\mathcal{H}_{\alpha}</annotation></semantics></math> of (<a href="#S3.E1" title="Equation 3.1 ‣ The tight family. ‣ The trivia phase transition ‣ Main Results" class="ltx_ref"><span class="ltx_text ltx_ref_tag">3.1</span></a>) with revealed core of exact density <math id="S3.Thmtheorem10.p1.m2" class="ltx_Math" alttext="\alpha" display="inline" intent=":literal"><semantics><mi>α</mi><annotation encoding="application/x-tex">\alpha</annotation></semantics></math>,
the optimal guaranteed coverage of valuable mathematics is</span></p>
<table id="S3.E5" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="S3.E5.m1" class="ltx_Math" alttext="c^{*}=\begin{cases}\alpha/2,&amp;\text{under any finite-trivia allowance, and}\\
1-\alpha/2,&amp;\text{under any infinite-trivia allowance,}\end{cases}" display="block" intent=":literal"><semantics><mrow><msup><mi>c</mi><mo>∗</mo></msup><mo>=</mo><mrow><mo>{</mo><mtable columnspacing="5pt" displaystyle="true" rowspacing="0pt"><mtr><mtd class="ltx_align_left" columnalign="left"><mrow><mrow><mi>α</mi><mo>/</mo><mn>2</mn></mrow><mo>,</mo></mrow></mtd><mtd class="ltx_align_left" columnalign="left"><mtext class="ltx_mathvariant_italic">under any finite-trivia allowance, and</mtext></mtd></mtr><mtr><mtd class="ltx_align_left" columnalign="left"><mrow><mrow><mn>1</mn><mo>−</mo><mrow><mi>α</mi><mo>/</mo><mn>2</mn></mrow></mrow><mo>,</mo></mrow></mtd><mtd class="ltx_align_left" columnalign="left"><mtext class="ltx_mathvariant_italic">under any infinite-trivia allowance,</mtext></mtd></mtr></mtable></mrow></mrow><annotation encoding="application/x-tex">c^{*}=\begin{cases}\alpha/2,&amp;\text{under any finite-trivia allowance, and}\\
1-\alpha/2,&amp;\text{under any infinite-trivia allowance,}\end{cases}</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td>
<td rowspan="1" class="ltx_eqn_cell ltx_eqn_eqno ltx_align_middle ltx_align_right"><span class="ltx_tag ltx_tag_equation ltx_align_right">(3.5)</span></td></tr></tbody>
</table>
<p id="S3.Thmtheorem10.p1.2" class="ltx_p"><span id="S3.Thmtheorem10.p1.2.1" class="ltx_text ltx_font_italic">both bounds tight, the latter already attained at vanishing trivia rate. The transition is in
trivia count, not rate. The jump <math id="S3.Thmtheorem10.p1.m3" class="ltx_Math" alttext="1-\alpha" display="inline" intent=":literal"><semantics><mrow><mn>1</mn><mo>−</mo><mi>α</mi></mrow><annotation encoding="application/x-tex">1-\alpha</annotation></semantics></math> between the two regimes is exactly the
unrecorded mass — the valuable statements never written into the core.</span></p>
</div>
</div>
<div id="S3.SS3.SSS0.Px1.4" class="ltx_proof">
<h6 class="ltx_title ltx_runin ltx_font_italic ltx_title_proof">Proof.</h6>
<div id="S3.SS3.SSS0.Px1.p11" class="ltx_para">
<p id="S3.SS3.SSS0.Px1.p11.1" class="ltx_p"><span id="S3.SS3.SSS0.Px1.p11.1.1" class="ltx_text">The finite-trivia value <math id="S3.SS3.SSS0.Px1.p11.m1" class="ltx_Math" alttext="\alpha/2" display="inline" intent=":literal"><semantics><mrow><mi>α</mi><mo>/</mo><mn>2</mn></mrow><annotation encoding="application/x-tex">\alpha/2</annotation></semantics></math> is upper-bounded by <a href="#S3.Thmtheorem6" title="Theorem 3.6 (Impossibility side of the dichotomy). ‣ The tight family. ‣ The trivia phase transition ‣ Main Results" class="ltx_ref"><span class="ltx_text ltx_ref_tag">Theorem</span> <span class="ltx_text ltx_ref_tag">3.6</span></a>(b) and attained by
<a href="#S3.Thmtheorem7" title="Theorem 3.7 (Achievability side: sweep and the tight generator). ‣ The tight family. ‣ The trivia phase transition ‣ Main Results" class="ltx_ref"><span class="ltx_text ltx_ref_tag">Theorem</span> <span class="ltx_text ltx_ref_tag">3.7</span></a>(iii). The infinite-trivia value <math id="S3.SS3.SSS0.Px1.p11.m2" class="ltx_Math" alttext="1-\alpha/2" display="inline" intent=":literal"><semantics><mrow><mn>1</mn><mo>−</mo><mrow><mi>α</mi><mo>/</mo><mn>2</mn></mrow></mrow><annotation encoding="application/x-tex">1-\alpha/2</annotation></semantics></math> is upper-bounded by
<a href="#S3.Thmtheorem6" title="Theorem 3.6 (Impossibility side of the dichotomy). ‣ The tight family. ‣ The trivia phase transition ‣ Main Results" class="ltx_ref"><span class="ltx_text ltx_ref_tag">Theorem</span> <span class="ltx_text ltx_ref_tag">3.6</span></a>(a) and attained by <math id="S3.SS3.SSS0.Px1.p11.m3" class="ltx_Math" alttext="G^{*}" display="inline" intent=":literal"><semantics><msup><mi>G</mi><mo>∗</mo></msup><annotation encoding="application/x-tex">G^{*}</annotation></semantics></math> at vanishing rate via <a href="#S3.Thmtheorem7" title="Theorem 3.7 (Achievability side: sweep and the tight generator). ‣ The tight family. ‣ The trivia phase transition ‣ Main Results" class="ltx_ref"><span class="ltx_text ltx_ref_tag">Theorem</span> <span class="ltx_text ltx_ref_tag">3.7</span></a>(ii)(b). The
gap is <math id="S3.SS3.SSS0.Px1.p11.m4" class="ltx_Math" alttext="(1-\alpha/2)-\alpha/2=1-\alpha=1-d(C,H)" display="inline" intent=":literal"><semantics><mrow><mrow><mrow><mo stretchy="false">(</mo><mrow><mn>1</mn><mo>−</mo><mrow><mi>α</mi><mo>/</mo><mn>2</mn></mrow></mrow><mo stretchy="false">)</mo></mrow><mo>−</mo><mrow><mi>α</mi><mo>/</mo><mn>2</mn></mrow></mrow><mo>=</mo><mrow><mn>1</mn><mo>−</mo><mi>α</mi></mrow><mo>=</mo><mrow><mn>1</mn><mo>−</mo><mrow><mi>d</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>C</mi><mo>,</mo><mi>H</mi><mo stretchy="false">)</mo></mrow></mrow></mrow></mrow><annotation encoding="application/x-tex">(1-\alpha/2)-\alpha/2=1-\alpha=1-d(C,H)</annotation></semantics></math>, the lower density of
<math id="S3.SS3.SSS0.Px1.p11.m5" class="ltx_Math" alttext="H\setminus C" display="inline" intent=":literal"><semantics><mrow><mi>H</mi><mo>∖</mo><mi>C</mi></mrow><annotation encoding="application/x-tex">H\setminus C</annotation></semantics></math> in <math id="S3.SS3.SSS0.Px1.p11.m6" class="ltx_Math" alttext="H" display="inline" intent=":literal"><semantics><mi>H</mi><annotation encoding="application/x-tex">H</annotation></semantics></math>.
∎</span></p>
</div>
</div>
<figure id="S3.T1" class="ltx_table">
<figcaption class="ltx_caption ltx_centering"><span class="ltx_tag ltx_tag_table"><span id="S3.T1.4" class="ltx_text" style="font-size:90%;">Table 1</span>: </span><span id="S3.T1.5" class="ltx_text" style="font-size:90%;">The trivia phase transition on <math id="S3.T1.m6" class="ltx_Math" alttext="\mathcal{H}_{\alpha}" display="inline" intent=":literal"><semantics><msub><mi class="ltx_font_mathcaligraphic">ℋ</mi><mi>α</mi></msub><annotation encoding="application/x-tex">\mathcal{H}_{\alpha}</annotation></semantics></math> (revealed core <math id="S3.T1.m7" class="ltx_Math" alttext="C\subseteq K" display="inline" intent=":literal"><semantics><mrow><mi>C</mi><mo>⊆</mo><mi>K</mi></mrow><annotation encoding="application/x-tex">C\subseteq K</annotation></semantics></math> of
exact density <math id="S3.T1.m8" class="ltx_Math" alttext="\alpha" display="inline" intent=":literal"><semantics><mi>α</mi><annotation encoding="application/x-tex">\alpha</annotation></semantics></math>, presented as the candidate intersection). The optimum jumps by the
unrecorded mass <math id="S3.T1.m9" class="ltx_Math" alttext="1-\alpha" display="inline" intent=":literal"><semantics><mrow><mn>1</mn><mo>−</mo><mi>α</mi></mrow><annotation encoding="application/x-tex">1-\alpha</annotation></semantics></math> as the trivia allowance crosses from finite to infinite count,
even though the infinite-count optimum is attained at trivia <em id="S3.T1.5.1" class="ltx_emph ltx_font_italic">rate</em> <math id="S3.T1.m10" class="ltx_Math" alttext="\to 0" display="inline" intent=":literal"><semantics><mrow><mphantom></mphantom><mo stretchy="false">→</mo><mn>0</mn></mrow><annotation encoding="application/x-tex">\to 0</annotation></semantics></math>.</span></figcaption>
<table id="S3.T1.6" class="ltx_tabular ltx_centering ltx_align_middle">
<tr id="S3.T1.6.1" class="ltx_tr">
<td id="S3.T1.6.1.1" class="ltx_td ltx_align_left ltx_border_tt">Trivia allowance</td>
<td id="S3.T1.6.1.2" class="ltx_td ltx_align_center ltx_border_tt">Optimal coverage <math id="S3.T1.m11" class="ltx_Math" alttext="c^{*}" display="inline" intent=":literal"><semantics><msup><mi>c</mi><mo>∗</mo></msup><annotation encoding="application/x-tex">c^{*}</annotation></semantics></math></td>
<td id="S3.T1.6.1.3" class="ltx_td ltx_align_center ltx_border_tt">Attained by</td>
<td id="S3.T1.6.1.4" class="ltx_td ltx_nopad_r ltx_align_left ltx_border_tt">Tight by</td></tr>
<tr id="S3.T1.6.2" class="ltx_tr">
<td id="S3.T1.6.2.1" class="ltx_td ltx_align_left ltx_border_t">Finite count</td>
<td id="S3.T1.6.2.2" class="ltx_td ltx_align_center ltx_border_t"><math id="S3.T1.m12" class="ltx_Math" alttext="\alpha/2" display="inline" intent=":literal"><semantics><mrow><mi>α</mi><mo>/</mo><mn>2</mn></mrow><annotation encoding="application/x-tex">\alpha/2</annotation></semantics></math></td>
<td id="S3.T1.6.2.3" class="ltx_td ltx_align_center ltx_border_t"><a href="#S2.Thmtheorem1" title="Fact 2.1 (Partial-enumeration generation; ( , , Theorem 1.6 in arXiv version)). ‣ Partial enumeration and the revealed core ‣ The Model" class="ltx_ref"><span class="ltx_text ltx_ref_tag">Fact</span> <span class="ltx_text ltx_ref_tag">2.1</span></a> (KW)</td>
<td id="S3.T1.6.2.4" class="ltx_td ltx_nopad_r ltx_align_left ltx_border_t"><a href="#S3.Thmtheorem6" title="Theorem 3.6 (Impossibility side of the dichotomy). ‣ The tight family. ‣ The trivia phase transition ‣ Main Results" class="ltx_ref"><span class="ltx_text ltx_ref_tag">Theorem</span> <span class="ltx_text ltx_ref_tag">3.6</span></a>(b)</td></tr>
<tr id="S3.T1.6.3" class="ltx_tr">
<td id="S3.T1.6.3.1" class="ltx_td ltx_align_left">Infinite count (rate <math id="S3.T1.m13" class="ltx_Math" alttext="\to 0" display="inline" intent=":literal"><semantics><mrow><mphantom></mphantom><mo stretchy="false">→</mo><mn>0</mn></mrow><annotation encoding="application/x-tex">\to 0</annotation></semantics></math>)</td>
<td id="S3.T1.6.3.2" class="ltx_td ltx_align_center"><math id="S3.T1.m14" class="ltx_Math" alttext="1-\alpha/2" display="inline" intent=":literal"><semantics><mrow><mn>1</mn><mo>−</mo><mrow><mi>α</mi><mo>/</mo><mn>2</mn></mrow></mrow><annotation encoding="application/x-tex">1-\alpha/2</annotation></semantics></math>  <span id="S3.T1.6.3.2.1" class="ltx_text" style="font-size:80%;">(<math id="S3.T1.m15" class="ltx_Math" alttext="G^{*}" display="inline" intent=":literal"><semantics><msup><mi>G</mi><mo>∗</mo></msup><annotation encoding="application/x-tex">G^{*}</annotation></semantics></math>, core <math id="S3.T1.m16" class="ltx_Math" alttext="C\subseteq K" display="inline" intent=":literal"><semantics><mrow><mi>C</mi><mo>⊆</mo><mi>K</mi></mrow><annotation encoding="application/x-tex">C\subseteq K</annotation></semantics></math>)</span></td>
<td id="S3.T1.6.3.3" class="ltx_td ltx_align_center"><math id="S3.T1.m17" class="ltx_Math" alttext="G^{*}" display="inline" intent=":literal"><semantics><msup><mi>G</mi><mo>∗</mo></msup><annotation encoding="application/x-tex">G^{*}</annotation></semantics></math>, <a href="#S3.E4" title="In The tight family. ‣ The trivia phase transition ‣ Main Results" class="ltx_ref"><span class="ltx_text ltx_ref_tag">Equation</span> <span class="ltx_text ltx_ref_tag">3.4</span></a></td>
<td id="S3.T1.6.3.4" class="ltx_td ltx_nopad_r ltx_align_left"><a href="#S3.Thmtheorem6" title="Theorem 3.6 (Impossibility side of the dichotomy). ‣ The tight family. ‣ The trivia phase transition ‣ Main Results" class="ltx_ref"><span class="ltx_text ltx_ref_tag">Theorem</span> <span class="ltx_text ltx_ref_tag">3.6</span></a>(a)</td></tr>
<tr id="S3.T1.6.4" class="ltx_tr">
<td id="S3.T1.6.4.1" class="ltx_td ltx_align_left ltx_border_bb ltx_border_t" colspan="2">Jump <math id="S3.T1.m18" class="ltx_Math" alttext="=1-\alpha=" display="inline" intent=":literal"><semantics><mrow><mphantom></mphantom><mo>=</mo><mrow><mn>1</mn><mo>−</mo><mi>α</mi></mrow><mo>=</mo><mphantom></mphantom></mrow><annotation encoding="application/x-tex">=1-\alpha=</annotation></semantics></math> unrecorded mass</td>
<td id="S3.T1.6.4.2" class="ltx_td ltx_border_bb ltx_border_t"></td>
<td id="S3.T1.6.4.3" class="ltx_td ltx_nopad_r ltx_border_bb ltx_border_t"></td></tr>
</table>
</figure>
<div id="S3.Thmtheorem11" class="ltx_theorem ltx_theorem_remark">
<h6 class="ltx_title ltx_runin ltx_title_theorem"><span class="ltx_tag ltx_tag_theorem"><span id="S3.Thmtheorem11.2" class="ltx_text ltx_font_italic">Remark 3.11</span></span><span id="S3.Thmtheorem11.3" class="ltx_text ltx_font_italic"> </span>(Interface of the impossibility proofs)<span id="S3.Thmtheorem11.4" class="ltx_text ltx_font_italic">.</span></h6>
<div id="S3.Thmtheorem11.p1" class="ltx_para">
<p id="S3.Thmtheorem11.p1.1" class="ltx_p">The proofs of <a href="#S3.Thmtheorem5" title="Lemma 3.5 (Race lemma). ‣ The tight family. ‣ The trivia phase transition ‣ Main Results" class="ltx_ref"><span class="ltx_text ltx_ref_tag">Lemmas</span> <span class="ltx_text ltx_ref_tag">3.5</span></a> and <a href="#S3.Thmtheorem6" title="Theorem 3.6 (Impossibility side of the dichotomy). ‣ The tight family. ‣ The trivia phase transition ‣ Main Results" class="ltx_ref"><span class="ltx_text ltx_ref_tag">3.6</span></a> use <em id="S3.Thmtheorem11.p1.1.1" class="ltx_emph ltx_font_italic">only</em> the following properties of the triple
<math id="S3.Thmtheorem11.p1.m1" class="ltx_Math" alttext="(K,K^{\prime},F)" display="inline" intent=":literal"><semantics><mrow><mo stretchy="false">(</mo><mi>K</mi><mo>,</mo><msup><mi>K</mi><mo>′</mo></msup><mo>,</mo><mi>F</mi><mo stretchy="false">)</mo></mrow><annotation encoding="application/x-tex">(K,K^{\prime},F)</annotation></semantics></math>: a countable ground set with a canonical order; nesting <math id="S3.Thmtheorem11.p1.m2" class="ltx_Math" alttext="K\subsetneq K^{\prime}\subseteq F" display="inline" intent=":literal"><semantics><mrow><mi>K</mi><mo>⊊</mo><msup><mi>K</mi><mo>′</mo></msup><mo>⊆</mo><mi>F</mi></mrow><annotation encoding="application/x-tex">K\subsetneq K^{\prime}\subseteq F</annotation></semantics></math> with all three infinite; <math id="S3.Thmtheorem11.p1.m3" class="ltx_Math" alttext="F\setminus K^{\prime}" display="inline" intent=":literal"><semantics><mrow><mi>F</mi><mo>∖</mo><msup><mi>K</mi><mo>′</mo></msup></mrow><annotation encoding="application/x-tex">F\setminus K^{\prime}</annotation></semantics></math> infinite; and <math id="S3.Thmtheorem11.p1.m4" class="ltx_Math" alttext="m_{N}\coloneqq\lvert K\cap K^{\prime}[1\!\dots\!N]\rvert=\alpha N+O(1)" display="inline" intent=":literal"><semantics><mrow><msub><mi>m</mi><mi>N</mi></msub><mo>≔</mo><mrow><mo stretchy="false">|</mo><mrow><mi>K</mi><mo>∩</mo><mrow><msup><mi>K</mi><mo>′</mo></msup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">[</mo><mrow><mpadded style="width:0.580em;" width="0.580em"><mi mathvariant="normal">…</mi></mpadded><mo lspace="0em" rspace="0em">​</mo><mi>N</mi></mrow><mo stretchy="false">]</mo></mrow></mrow></mrow><mo stretchy="false">|</mo></mrow><mo>=</mo><mrow><mrow><mi>α</mi><mo lspace="0em" rspace="0em">​</mo><mi>N</mi></mrow><mo>+</mo><mrow><mi>O</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mn>1</mn><mo stretchy="false">)</mo></mrow></mrow></mrow></mrow><annotation encoding="application/x-tex">m_{N}\coloneqq\lvert K\cap K^{\prime}[1\!\dots\!N]\rvert=\alpha N+O(1)</annotation></semantics></math> with <math id="S3.Thmtheorem11.p1.m5" class="ltx_Math" alttext="\alpha&gt;0" display="inline" intent=":literal"><semantics><mrow><mi>α</mi><mo>&gt;</mo><mn>0</mn></mrow><annotation encoding="application/x-tex">\alpha&gt;0</annotation></semantics></math> exact. Any triple meeting this
interface inherits <a href="#S3.Thmtheorem5" title="Lemma 3.5 (Race lemma). ‣ The tight family. ‣ The trivia phase transition ‣ Main Results" class="ltx_ref"><span class="ltx_text ltx_ref_tag">Lemmas</span> <span class="ltx_text ltx_ref_tag">3.5</span></a> and <a href="#S3.Thmtheorem6" title="Theorem 3.6 (Impossibility side of the dichotomy). ‣ The tight family. ‣ The trivia phase transition ‣ Main Results" class="ltx_ref"><span class="ltx_text ltx_ref_tag">3.6</span></a> verbatim. We invoke this in <a href="#S4.Thmtheorem2" title="Proposition 4.2 (Free-monoid pairs realize the dichotomy). ‣ Case Study: Instantiation in a Compression Model of Mathematics" class="ltx_ref"><span class="ltx_text ltx_ref_tag">Proposition</span> <span class="ltx_text ltx_ref_tag">4.2</span></a> to
transport the dichotomy into the compression model.</p>
</div>
</div>
</section>
</section>
</section>
<section id="S4" class="ltx_section">
<h2 class="ltx_title ltx_font_bold ltx_title_section" style="font-size:144%;--ltx-fg-color:#1F4FA8;">Case Study: Instantiation in a Compression Model of Mathematics</h2>

<div id="S4.p1" class="ltx_para">
<p id="S4.p1.1" class="ltx_p">The dichotomy was stated abstractly. We close more modestly: we exhibit, inside a concrete
model of mathematics-as-compression, the macro framework of <cite class="ltx_cite ltx_citemacro_citet"><a href="#bib.bib25" title="" class="ltx_ref">Aksenov et al. (2026)</a></cite>
(hereafter ABFM), concrete compressible-language families that meet the lower-bound interface
of <a href="#S3.Thmtheorem11" title="Remark 3.11 (Interface of the impossibility proofs). ‣ The tight family. ‣ The trivia phase transition ‣ Main Results" class="ltx_ref"><span class="ltx_text ltx_ref_tag">Remark</span> <span class="ltx_text ltx_ref_tag">3.11</span></a>, together with a structured family where no trivia are needed. We
claim no more than this, not a theorem about all compressible languages. In ABFM a
“valuable” statement is a <em id="S4.p1.1.1" class="ltx_emph ltx_font_italic">compressible</em> string: one whose length under a macro
dictionary is far below its raw length. We are explicit about the ledger: no ABFM theorem is
an ingredient. ABFM supplies the definitional substrate (macros, wrapped length, geometric
dictionaries) and the motivating asymmetry between the abelian monoid <math id="S4.p1.m1" class="ltx_Math" alttext="A_{n}" display="inline" intent=":literal"><semantics><msub><mi>A</mi><mi>n</mi></msub><annotation encoding="application/x-tex">A_{n}</annotation></semantics></math> and the free
monoid <math id="S4.p1.m2" class="ltx_Math" alttext="F_{n}" display="inline" intent=":literal"><semantics><msub><mi>F</mi><mi>n</mi></msub><annotation encoding="application/x-tex">F_{n}</annotation></semantics></math>; the proofs below are self-contained.</p>
</div>
<div id="S4.p2" class="ltx_para">
<p id="S4.p2.1" class="ltx_p">We work in the abelian monoid <math id="S4.p2.m1" class="ltx_Math" alttext="A_{n}" display="inline" intent=":literal"><semantics><msub><mi>A</mi><mi>n</mi></msub><annotation encoding="application/x-tex">A_{n}</annotation></semantics></math> and the free monoid <math id="S4.p2.m2" class="ltx_Math" alttext="F_{n}" display="inline" intent=":literal"><semantics><msub><mi>F</mi><mi>n</mi></msub><annotation encoding="application/x-tex">F_{n}</annotation></semantics></math>, each with its canonical order
isomorphic to <math id="S4.p2.m3" class="ltx_Math" alttext="\mathbb{N}" display="inline" intent=":literal"><semantics><mi>ℕ</mi><annotation encoding="application/x-tex">\mathbb{N}</annotation></semantics></math> (as <a href="#S3.Thmtheorem5" title="Lemma 3.5 (Race lemma). ‣ The tight family. ‣ The trivia phase transition ‣ Main Results" class="ltx_ref"><span class="ltx_text ltx_ref_tag">Lemmas</span> <span class="ltx_text ltx_ref_tag">3.5</span></a> and <a href="#S3.Thmtheorem6" title="Theorem 3.6 (Impossibility side of the dichotomy). ‣ The tight family. ‣ The trivia phase transition ‣ Main Results" class="ltx_ref"><span class="ltx_text ltx_ref_tag">3.6</span></a> demand), and write <math id="S4.p2.m4" class="ltx_Math" alttext="H_{D}\coloneqq\{\,w:\lvert w\rvert_{G\cup D}\leq\theta_{\kappa}(\lvert w\rvert_{G})\,\}" display="inline" intent=":literal"><semantics><mrow><msub><mi>H</mi><mi>D</mi></msub><mo>≔</mo><mrow><mo rspace="0.170em" stretchy="false">{</mo><mi>w</mi><mo lspace="0.278em" rspace="0.278em">:</mo><mrow><msub><mrow><mo stretchy="false">|</mo><mi>w</mi><mo stretchy="false">|</mo></mrow><mrow><mi>G</mi><mo>∪</mo><mi>D</mi></mrow></msub><mo>≤</mo><mrow><msub><mi>θ</mi><mi>κ</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mrow><mo stretchy="false">|</mo><mi>w</mi><mo stretchy="false">|</mo></mrow><mi>G</mi></msub><mo rspace="0.170em" stretchy="false">)</mo></mrow></mrow></mrow><mo stretchy="false">}</mo></mrow></mrow><annotation encoding="application/x-tex">H_{D}\coloneqq\{\,w:\lvert w\rvert_{G\cup D}\leq\theta_{\kappa}(\lvert w\rvert_{G})\,\}</annotation></semantics></math> for the sublanguage compressible under a
macro dictionary <math id="S4.p2.m5" class="ltx_Math" alttext="D" display="inline" intent=":literal"><semantics><mi>D</mi><annotation encoding="application/x-tex">D</annotation></semantics></math>, where <math id="S4.p2.m6" class="ltx_Math" alttext="\lvert w\rvert_{G\cup D}" display="inline" intent=":literal"><semantics><msub><mrow><mo stretchy="false">|</mo><mi>w</mi><mo stretchy="false">|</mo></mrow><mrow><mi>G</mi><mo>∪</mo><mi>D</mi></mrow></msub><annotation encoding="application/x-tex">\lvert w\rvert_{G\cup D}</annotation></semantics></math> is the wrapped length and <math id="S4.p2.m7" class="ltx_Math" alttext="\theta_{\kappa}(L)=\kappa\log_{2}(1+L)" display="inline" intent=":literal"><semantics><mrow><mrow><msub><mi>θ</mi><mi>κ</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>L</mi><mo stretchy="false">)</mo></mrow></mrow><mo>=</mo><mrow><mi>κ</mi><mo lspace="0.167em" rspace="0em">​</mo><mrow><msub><mi>log</mi><mn>2</mn></msub><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mrow><mn>1</mn><mo>+</mo><mi>L</mi></mrow><mo stretchy="false">)</mo></mrow></mrow></mrow></mrow><annotation encoding="application/x-tex">\theta_{\kappa}(L)=\kappa\log_{2}(1+L)</annotation></semantics></math> the compressibility cut (<a href="#A3" title="Appendix C Mathematical Background" class="ltx_ref"><span class="ltx_text ltx_ref_tag">Appendix</span> <span class="ltx_text ltx_ref_tag">C</span></a> collects the definitions
and the macro framework).</p>
</div>
<div id="S4.p3" class="ltx_para">
<p id="S4.p3.1" class="ltx_p">The abelian regime is benign: compressible languages there form an identifiable chain, so
breadth needs no trivia at all.</p>
</div>
<div id="S4.Thmtheorem1" class="ltx_theorem ltx_theorem_theorem">
<h6 class="ltx_title ltx_runin ltx_title_theorem"><span class="ltx_tag ltx_tag_theorem"><span id="S4.Thmtheorem1.2" class="ltx_text ltx_font_bold">Theorem 4.1</span></span><span id="S4.Thmtheorem1.3" class="ltx_text ltx_font_bold"> </span>(Abelian refinement chains are identifiable)<span id="S4.Thmtheorem1.4" class="ltx_text ltx_font_bold">.</span></h6>
<div id="S4.Thmtheorem1.p1" class="ltx_para">
<p id="S4.Thmtheorem1.p1.1" class="ltx_p"><span id="S4.Thmtheorem1.p1.1.1" class="ltx_text ltx_font_italic">Fix <math id="S4.Thmtheorem1.p1.m1" class="ltx_Math" alttext="\kappa\geq 1" display="inline" intent=":literal"><semantics><mrow><mi>κ</mi><mo>≥</mo><mn>1</mn></mrow><annotation encoding="application/x-tex">\kappa\geq 1</annotation></semantics></math> and <math id="S4.Thmtheorem1.p1.m2" class="ltx_Math" alttext="b\geq 16\kappa^{2}" display="inline" intent=":literal"><semantics><mrow><mi>b</mi><mo>≥</mo><mrow><mn>16</mn><mo lspace="0em" rspace="0em">​</mo><msup><mi>κ</mi><mn>2</mn></msup></mrow></mrow><annotation encoding="application/x-tex">b\geq 16\kappa^{2}</annotation></semantics></math>, and set <math id="S4.Thmtheorem1.p1.m3" class="ltx_Math" alttext="b_{t}\coloneqq b^{2^{t}}" display="inline" intent=":literal"><semantics><mrow><msub><mi>b</mi><mi>t</mi></msub><mo>≔</mo><msup><mi>b</mi><msup><mn>2</mn><mi>t</mi></msup></msup></mrow><annotation encoding="application/x-tex">b_{t}\coloneqq b^{2^{t}}</annotation></semantics></math> and <math id="S4.Thmtheorem1.p1.m4" class="ltx_math_unparsed" alttext="D_{t}\coloneqq\{b_{t}^{\,j}a_{i}:i\leq n,\ j\geq 1\}" display="inline" intent=":literal"><semantics><mrow><msub><mi>D</mi><mi>t</mi></msub><mo>≔</mo><mrow><mo stretchy="false">{</mo><msubsup><mi>b</mi><mi>t</mi><mi>j</mi></msubsup><msub><mi>a</mi><mi>i</mi></msub><mo lspace="0.278em" rspace="0.278em">:</mo><mi>i</mi><mo>≤</mo><mi>n</mi><mo rspace="0.667em">,</mo><mi>j</mi><mo>≥</mo><mn>1</mn><mo stretchy="false">}</mo></mrow></mrow><annotation encoding="application/x-tex">D_{t}\coloneqq\{b_{t}^{\,j}a_{i}:i\leq n,\ j\geq 1\}</annotation></semantics></math> (geometric dictionaries, nested by refinement: <math id="S4.Thmtheorem1.p1.m5" class="ltx_Math" alttext="D_{t+1}\subseteq D_{t}" display="inline" intent=":literal"><semantics><mrow><msub><mi>D</mi><mrow><mi>t</mi><mo>+</mo><mn>1</mn></mrow></msub><mo>⊆</mo><msub><mi>D</mi><mi>t</mi></msub></mrow><annotation encoding="application/x-tex">D_{t+1}\subseteq D_{t}</annotation></semantics></math>). Then <math id="S4.Thmtheorem1.p1.m6" class="ltx_Math" alttext="\mathcal{H}_{\mathrm{ab}}\coloneqq\{H_{D_{t}}\}_{t}" display="inline" intent=":literal"><semantics><mrow><msub><mi class="ltx_font_mathcaligraphic">ℋ</mi><mi>ab</mi></msub><mo>≔</mo><msub><mrow><mo stretchy="false">{</mo><msub><mi>H</mi><msub><mi>D</mi><mi>t</mi></msub></msub><mo stretchy="false">}</mo></mrow><mi>t</mi></msub></mrow><annotation encoding="application/x-tex">\mathcal{H}_{\mathrm{ab}}\coloneqq\{H_{D_{t}}\}_{t}</annotation></semantics></math> is a strictly descending
chain of infinite languages satisfying Angluin’s condition with the singleton tell-tales <math id="S4.Thmtheorem1.p1.m7" class="ltx_Math" alttext="T_{t}=\{a_{1}^{\,b_{t}+b_{t}^{3}}\}" display="inline" intent=":literal"><semantics><mrow><msub><mi>T</mi><mi>t</mi></msub><mo>=</mo><mrow><mo stretchy="false">{</mo><msubsup><mi>a</mi><mn>1</mn><mrow><msub><mi>b</mi><mi>t</mi></msub><mo>+</mo><msubsup><mi>b</mi><mi>t</mi><mn>3</mn></msubsup></mrow></msubsup><mo stretchy="false">}</mo></mrow></mrow><annotation encoding="application/x-tex">T_{t}=\{a_{1}^{\,b_{t}+b_{t}^{3}}\}</annotation></semantics></math>. Consequently, by <a href="#S3.Thmtheorem1" title="Theorem 3.1 (Verification is not taste). ‣ Verification is not taste ‣ Main Results" class="ltx_ref"><span class="ltx_text ltx_ref_tag">Theorem</span> <span class="ltx_text ltx_ref_tag">3.1</span></a>(a) (single fiber <math id="S4.Thmtheorem1.p1.m8" class="ltx_Math" alttext="F=A_{n}" display="inline" intent=":literal"><semantics><mrow><mi>F</mi><mo>=</mo><msub><mi>A</mi><mi>n</mi></msub></mrow><annotation encoding="application/x-tex">F=A_{n}</annotation></semantics></math>), exact breadth in the limit is achievable on <math id="S4.Thmtheorem1.p1.m9" class="ltx_Math" alttext="\mathcal{H}_{\mathrm{ab}}" display="inline" intent=":literal"><semantics><msub><mi class="ltx_font_mathcaligraphic">ℋ</mi><mi>ab</mi></msub><annotation encoding="application/x-tex">\mathcal{H}_{\mathrm{ab}}</annotation></semantics></math>: in the structured
abelian regime, valuable generation needs no trivia. </span>(<span id="S4.Thmtheorem1.p1.1.2" class="ltx_text ltx_font_italic">The partial-enumeration
behavior of this chain is open.</span>)<span id="S4.Thmtheorem1.p1.1.3" class="ltx_text"></span></p>
</div>
</div>
<div id="S4.2" class="ltx_proof">
<h6 class="ltx_title ltx_runin ltx_font_italic ltx_title_proof">Proof sketch.</h6>
<div id="S4.p4" class="ltx_para">
<p id="S4.p4.1" class="ltx_p"><span id="S4.p4.1.1" class="ltx_text">A digit-sum formula computes the wrapped length, <math id="S4.p4.m1" class="ltx_Math" alttext="\lvert w\rvert_{G\cup D_{t}}=\sum_{i}s_{b_{t}}(N_{i})" display="inline" intent=":literal"><semantics><mrow><msub><mrow><mo stretchy="false">|</mo><mi>w</mi><mo stretchy="false">|</mo></mrow><mrow><mi>G</mi><mo>∪</mo><msub><mi>D</mi><mi>t</mi></msub></mrow></msub><mo rspace="0.111em">=</mo><mrow><msub><mo>∑</mo><mi>i</mi></msub><mrow><msub><mi>s</mi><msub><mi>b</mi><mi>t</mi></msub></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mi>N</mi><mi>i</mi></msub><mo stretchy="false">)</mo></mrow></mrow></mrow></mrow><annotation encoding="application/x-tex">\lvert w\rvert_{G\cup D_{t}}=\sum_{i}s_{b_{t}}(N_{i})</annotation></semantics></math>
(replace <math id="S4.p4.m2" class="ltx_Math" alttext="b_{t}" display="inline" intent=":literal"><semantics><msub><mi>b</mi><mi>t</mi></msub><annotation encoding="application/x-tex">b_{t}</annotation></semantics></math> copies of <math id="S4.p4.m3" class="ltx_Math" alttext="b_{t}^{\,j}" display="inline" intent=":literal"><semantics><msubsup><mi>b</mi><mi>t</mi><mi>j</mi></msubsup><annotation encoding="application/x-tex">b_{t}^{\,j}</annotation></semantics></math> by one <math id="S4.p4.m4" class="ltx_Math" alttext="b_{t}^{\,j+1}" display="inline" intent=":literal"><semantics><msubsup><mi>b</mi><mi>t</mi><mrow><mi>j</mi><mo>+</mo><mn>1</mn></mrow></msubsup><annotation encoding="application/x-tex">b_{t}^{\,j+1}</annotation></semantics></math>, terminating at the base-<math id="S4.p4.m5" class="ltx_Math" alttext="b_{t}" display="inline" intent=":literal"><semantics><msub><mi>b</mi><mi>t</mi></msub><annotation encoding="application/x-tex">b_{t}</annotation></semantics></math>
representation). Same-count representations transfer down the chain, giving nesting; the
witness <math id="S4.p4.m6" class="ltx_Math" alttext="a_{1}^{\,b_{t}+b_{t}^{3}}" display="inline" intent=":literal"><semantics><msubsup><mi>a</mi><mn>1</mn><mrow><msub><mi>b</mi><mi>t</mi></msub><mo>+</mo><msubsup><mi>b</mi><mi>t</mi><mn>3</mn></msubsup></mrow></msubsup><annotation encoding="application/x-tex">a_{1}^{\,b_{t}+b_{t}^{3}}</annotation></semantics></math> has digit sum <math id="S4.p4.m7" class="ltx_Math" alttext="2" display="inline" intent=":literal"><semantics><mn>2</mn><annotation encoding="application/x-tex">2</annotation></semantics></math> in base <math id="S4.p4.m8" class="ltx_Math" alttext="b_{t}" display="inline" intent=":literal"><semantics><msub><mi>b</mi><mi>t</mi></msub><annotation encoding="application/x-tex">b_{t}</annotation></semantics></math> but <math id="S4.p4.m9" class="ltx_Math" alttext="2b_{t}" display="inline" intent=":literal"><semantics><mrow><mn>2</mn><mo lspace="0em" rspace="0em">​</mo><msub><mi>b</mi><mi>t</mi></msub></mrow><annotation encoding="application/x-tex">2b_{t}</annotation></semantics></math> in base <math id="S4.p4.m10" class="ltx_Math" alttext="b_{t}^{2}" display="inline" intent=":literal"><semantics><msubsup><mi>b</mi><mi>t</mi><mn>2</mn></msubsup><annotation encoding="application/x-tex">b_{t}^{2}</annotation></semantics></math>,
separating <math id="S4.p4.m11" class="ltx_Math" alttext="H_{D_{t}}" display="inline" intent=":literal"><semantics><msub><mi>H</mi><msub><mi>D</mi><mi>t</mi></msub></msub><annotation encoding="application/x-tex">H_{D_{t}}</annotation></semantics></math> from <math id="S4.p4.m12" class="ltx_Math" alttext="H_{D_{t+1}}" display="inline" intent=":literal"><semantics><msub><mi>H</mi><msub><mi>D</mi><mrow><mi>t</mi><mo>+</mo><mn>1</mn></mrow></msub></msub><annotation encoding="application/x-tex">H_{D_{t+1}}</annotation></semantics></math> because <math id="S4.p4.m13" class="ltx_Math" alttext="2b_{t}&gt;5\kappa\log_{2}b_{t}" display="inline" intent=":literal"><semantics><mrow><mrow><mn>2</mn><mo lspace="0em" rspace="0em">​</mo><msub><mi>b</mi><mi>t</mi></msub></mrow><mo>&gt;</mo><mrow><mn>5</mn><mo lspace="0em" rspace="0em">​</mo><mi>κ</mi><mo lspace="0.167em" rspace="0em">​</mo><msub><mi>log</mi><mn>2</mn></msub><mo lspace="0.167em" rspace="0em">​</mo><msub><mi>b</mi><mi>t</mi></msub></mrow></mrow><annotation encoding="application/x-tex">2b_{t}&gt;5\kappa\log_{2}b_{t}</annotation></semantics></math> for <math id="S4.p4.m14" class="ltx_Math" alttext="b\geq 16\kappa^{2}" display="inline" intent=":literal"><semantics><mrow><mi>b</mi><mo>≥</mo><mrow><mn>16</mn><mo lspace="0em" rspace="0em">​</mo><msup><mi>κ</mi><mn>2</mn></msup></mrow></mrow><annotation encoding="application/x-tex">b\geq 16\kappa^{2}</annotation></semantics></math>. Full proof in <a href="#A4.SS6.SSS1" title="Abelian refinement chains () ‣ The instantiation (, and ) ‣ Appendix D Deferred Proofs" class="ltx_ref"><span class="ltx_text ltx_ref_tag">Section</span> <span class="ltx_text ltx_ref_tag">D.6.1</span></a>.
∎</span></p>
</div>
</div>
<div id="S4.p5" class="ltx_para">
<p id="S4.p5.1" class="ltx_p">In the free regime we exhibit families meeting the lower-bound interface
(<a href="#S3.Thmtheorem11" title="Remark 3.11 (Interface of the impossibility proofs). ‣ The tight family. ‣ The trivia phase transition ‣ Main Results" class="ltx_ref"><span class="ltx_text ltx_ref_tag">Remark</span> <span class="ltx_text ltx_ref_tag">3.11</span></a>). Name-cut pairs realize the tight family at every rational density, and
an unbounded-cut variant realizes the extreme separation point: finite-trivia coverage <math id="S4.p5.m1" class="ltx_Math" alttext="0" display="inline" intent=":literal"><semantics><mn>0</mn><annotation encoding="application/x-tex">0</annotation></semantics></math>
against sweep coverage <math id="S4.p5.m2" class="ltx_Math" alttext="1" display="inline" intent=":literal"><semantics><mn>1</mn><annotation encoding="application/x-tex">1</annotation></semantics></math>. These are worked instances, not a statement about every
compressible-language pair.</p>
</div>
<div id="S4.p6" class="ltx_para">
<p id="S4.p6.1" class="ltx_p">Work in <math id="S4.p6.m1" class="ltx_Math" alttext="F_{n}" display="inline" intent=":literal"><semantics><msub><mi>F</mi><mi>n</mi></msub><annotation encoding="application/x-tex">F_{n}</annotation></semantics></math> (<math id="S4.p6.m2" class="ltx_Math" alttext="n\geq 2" display="inline" intent=":literal"><semantics><mrow><mi>n</mi><mo>≥</mo><mn>2</mn></mrow><annotation encoding="application/x-tex">n\geq 2</annotation></semantics></math>) with letters <math id="S4.p6.m3" class="ltx_Math" alttext="\{a,x\}" display="inline" intent=":literal"><semantics><mrow><mo stretchy="false">{</mo><mi>a</mi><mo>,</mo><mi>x</mi><mo stretchy="false">}</mo></mrow><annotation encoding="application/x-tex">\{a,x\}</annotation></semantics></math> and a target density <math id="S4.p6.m4" class="ltx_Math" alttext="\alpha=p/q" display="inline" intent=":literal"><semantics><mrow><mi>α</mi><mo>=</mo><mrow><mi>p</mi><mo>/</mo><mi>q</mi></mrow></mrow><annotation encoding="application/x-tex">\alpha=p/q</annotation></semantics></math>. The
construction uses the macros <math id="S4.p6.m5" class="ltx_Math" alttext="\mu_{m,i}\coloneqq x^{i}a\,x^{q+1-i}a\,x^{2^{m}}" display="inline" intent=":literal"><semantics><mrow><msub><mi>μ</mi><mrow><mi>m</mi><mo>,</mo><mi>i</mi></mrow></msub><mo>≔</mo><mrow><msup><mi>x</mi><mi>i</mi></msup><mo lspace="0em" rspace="0em">​</mo><mi>a</mi><mo lspace="0.170em" rspace="0em">​</mo><msup><mi>x</mi><mrow><mrow><mi>q</mi><mo>+</mo><mn>1</mn></mrow><mo>−</mo><mi>i</mi></mrow></msup><mo lspace="0em" rspace="0em">​</mo><mi>a</mi><mo lspace="0.170em" rspace="0em">​</mo><msup><mi>x</mi><msup><mn>2</mn><mi>m</mi></msup></msup></mrow></mrow><annotation encoding="application/x-tex">\mu_{m,i}\coloneqq x^{i}a\,x^{q+1-i}a\,x^{2^{m}}</annotation></semantics></math> (<math id="S4.p6.m6" class="ltx_Math" alttext="m\geq 1" display="inline" intent=":literal"><semantics><mrow><mi>m</mi><mo>≥</mo><mn>1</mn></mrow><annotation encoding="application/x-tex">m\geq 1</annotation></semantics></math>, <math id="S4.p6.m7" class="ltx_Math" alttext="1\leq i\leq q" display="inline" intent=":literal"><semantics><mrow><mn>1</mn><mo>≤</mo><mi>i</mi><mo>≤</mo><mi>q</mi></mrow><annotation encoding="application/x-tex">1\leq i\leq q</annotation></semantics></math>) and, under the bounded cut <math id="S4.p6.m8" class="ltx_Math" alttext="\theta\equiv 1" display="inline" intent=":literal"><semantics><mrow><mi>θ</mi><mo>≡</mo><mn>1</mn></mrow><annotation encoding="application/x-tex">\theta\equiv 1</annotation></semantics></math> (<math id="S4.p6.m9" class="ltx_Math" alttext="H_{D,1}=G\cup D" display="inline" intent=":literal"><semantics><mrow><msub><mi>H</mi><mrow><mi>D</mi><mo>,</mo><mn>1</mn></mrow></msub><mo>=</mo><mrow><mi>G</mi><mo>∪</mo><mi>D</mi></mrow></mrow><annotation encoding="application/x-tex">H_{D,1}=G\cup D</annotation></semantics></math>, the
nameable corpus), the name-cut pair</p>
<table id="S4.E1" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="S4.E1.m1" class="ltx_Math" alttext="K\coloneqq\{a,x\}\cup\{\mu_{m,i}:i\leq p\}\ \subsetneq\ K^{\prime}\coloneqq\{a,x\}\cup\{\text{all }\mu_{m,i}\}." display="block" intent=":literal"><semantics><mrow><mrow><mi>K</mi><mo>≔</mo><mrow><mrow><mo stretchy="false">{</mo><mi>a</mi><mo>,</mo><mi>x</mi><mo stretchy="false">}</mo></mrow><mo>∪</mo><mrow><mo stretchy="false">{</mo><msub><mi>μ</mi><mrow><mi>m</mi><mo>,</mo><mi>i</mi></mrow></msub><mo lspace="0.278em" rspace="0.278em">:</mo><mrow><mi>i</mi><mo>≤</mo><mi>p</mi></mrow><mo rspace="0.500em" stretchy="false">}</mo></mrow></mrow><mo rspace="0.778em">⊊</mo><msup><mi>K</mi><mo>′</mo></msup><mo>≔</mo><mrow><mrow><mo stretchy="false">{</mo><mi>a</mi><mo>,</mo><mi>x</mi><mo stretchy="false">}</mo></mrow><mo>∪</mo><mrow><mo stretchy="false">{</mo><mrow><mtext>all </mtext><mo lspace="0em" rspace="0em">​</mo><msub><mi>μ</mi><mrow><mi>m</mi><mo>,</mo><mi>i</mi></mrow></msub></mrow><mo stretchy="false">}</mo></mrow></mrow></mrow><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">K\coloneqq\{a,x\}\cup\{\mu_{m,i}:i\leq p\}\ \subsetneq\ K^{\prime}\coloneqq\{a,x\}\cup\{\text{all }\mu_{m,i}\}.</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td>
<td rowspan="1" class="ltx_eqn_cell ltx_eqn_eqno ltx_align_middle ltx_align_right"><span class="ltx_tag ltx_tag_equation ltx_align_right">(4.1)</span></td></tr></tbody>
</table>
</div>
<div id="S4.Thmtheorem2" class="ltx_theorem ltx_theorem_proposition">
<h6 class="ltx_title ltx_runin ltx_title_theorem"><span class="ltx_tag ltx_tag_theorem"><span id="S4.Thmtheorem2.2" class="ltx_text ltx_font_bold">Proposition 4.2</span></span><span id="S4.Thmtheorem2.3" class="ltx_text ltx_font_bold"> </span>(Free-monoid pairs realize the dichotomy)<span id="S4.Thmtheorem2.4" class="ltx_text ltx_font_bold">.</span></h6>
<div id="S4.Thmtheorem2.p1" class="ltx_para">
<p id="S4.Thmtheorem2.p1.1" class="ltx_p"><span id="S4.Thmtheorem2.p1.1.1" class="ltx_text ltx_font_italic">In <math id="S4.Thmtheorem2.p1.m1" class="ltx_Math" alttext="F_{n}" display="inline" intent=":literal"><semantics><msub><mi>F</mi><mi>n</mi></msub><annotation encoding="application/x-tex">F_{n}</annotation></semantics></math> (<math id="S4.Thmtheorem2.p1.m2" class="ltx_Math" alttext="n\geq 2" display="inline" intent=":literal"><semantics><mrow><mi>n</mi><mo>≥</mo><mn>2</mn></mrow><annotation encoding="application/x-tex">n\geq 2</annotation></semantics></math>), with letters <math id="S4.Thmtheorem2.p1.m3" class="ltx_Math" alttext="\{a,x\}" display="inline" intent=":literal"><semantics><mrow><mo stretchy="false">{</mo><mi>a</mi><mo>,</mo><mi>x</mi><mo stretchy="false">}</mo></mrow><annotation encoding="application/x-tex">\{a,x\}</annotation></semantics></math>:</span></p>
<ol id="S4.I1" class="ltx_enumerate" style="--ltx-enum-leftmargin:2.2em;">
<li id="S4.I1.i1" class="ltx_item" style="list-style-type:none;"><span class="ltx_tag ltx_tag_item">(i)</span> 
<div id="S4.I1.i1.p1" class="ltx_para">
<p id="S4.I1.i1.p1.1" class="ltx_p"><span id="S4.I1.i1.p1.1.1" class="ltx_text">(Name-cut pairs at every rational <math id="S4.I1.i1.p1.m1" class="ltx_Math" alttext="\alpha" display="inline" intent=":literal"><semantics><mi>α</mi><annotation encoding="application/x-tex">\alpha</annotation></semantics></math>)</span><span id="S4.I1.i1.p1.1.2" class="ltx_text ltx_font_italic"> The pair (</span><a href="#S4.E1" title="Equation 4.1 ‣ Case Study: Instantiation in a Compression Model of Mathematics" class="ltx_ref ltx_font_italic"><span class="ltx_text ltx_ref_tag">4.1</span></a><span id="S4.I1.i1.p1.1.3" class="ltx_text ltx_font_italic">)
satisfies </span><math id="S4.I1.i1.p1.m2" class="ltx_Math" alttext="\lvert K\cap K^{\prime}[1\!\dots\!N]\rvert=\alpha N+O(q)" display="inline" intent=":literal"><semantics><mrow><mrow><mo stretchy="false">|</mo><mrow><mi>K</mi><mo>∩</mo><mrow><msup><mi>K</mi><mo>′</mo></msup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">[</mo><mrow><mpadded style="width:0.580em;" width="0.580em"><mi mathvariant="normal">…</mi></mpadded><mo lspace="0em" rspace="0em">​</mo><mi>N</mi></mrow><mo stretchy="false">]</mo></mrow></mrow></mrow><mo stretchy="false">|</mo></mrow><mo>=</mo><mrow><mrow><mi>α</mi><mo lspace="0em" rspace="0em">​</mo><mi>N</mi></mrow><mo>+</mo><mrow><mi>O</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>q</mi><mo stretchy="false">)</mo></mrow></mrow></mrow></mrow><annotation encoding="application/x-tex">\lvert K\cap K^{\prime}[1\!\dots\!N]\rvert=\alpha N+O(q)</annotation></semantics></math><span id="S4.I1.i1.p1.1.4" class="ltx_text ltx_font_italic">, so </span><math id="S4.I1.i1.p1.m3" class="ltx_Math" alttext="d(K,K^{\prime})=\alpha" display="inline" intent=":literal"><semantics><mrow><mrow><mi>d</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>K</mi><mo>,</mo><msup><mi>K</mi><mo>′</mo></msup><mo stretchy="false">)</mo></mrow></mrow><mo>=</mo><mi>α</mi></mrow><annotation encoding="application/x-tex">d(K,K^{\prime})=\alpha</annotation></semantics></math><span id="S4.I1.i1.p1.1.5" class="ltx_text ltx_font_italic">
exactly; it meets the interface of </span><a href="#S3.Thmtheorem11" title="Remark 3.11 (Interface of the impossibility proofs). ‣ The tight family. ‣ The trivia phase transition ‣ Main Results" class="ltx_ref ltx_font_italic"><span class="ltx_text ltx_ref_tag">Remark</span> <span class="ltx_text ltx_ref_tag">3.11</span></a><span id="S4.I1.i1.p1.1.6" class="ltx_text ltx_font_italic">, and the dichotomy
(</span><a href="#S3.Thmtheorem10" title="Corollary 3.10 (The trivia dichotomy). ‣ The tight family. ‣ The trivia phase transition ‣ Main Results" class="ltx_ref ltx_font_italic"><span class="ltx_text ltx_ref_tag">Corollary</span> <span class="ltx_text ltx_ref_tag">3.10</span></a><span id="S4.I1.i1.p1.1.7" class="ltx_text ltx_font_italic">) holds verbatim inside the compression model.</span></p>
</div></li>
<li id="S4.I1.i2" class="ltx_item" style="list-style-type:none;"><span class="ltx_tag ltx_tag_item">(ii)</span> 
<div id="S4.I1.i2.p1" class="ltx_para">
<p id="S4.I1.i2.p1.1" class="ltx_p"><span id="S4.I1.i2.p1.1.1" class="ltx_text">(Obstruction: the bounded cut is forced)</span><span id="S4.I1.i2.p1.1.2" class="ltx_text ltx_font_italic"> For the unbounded cut
</span><math id="S4.I1.i2.p1.m1" class="ltx_Math" alttext="\theta_{\kappa}" display="inline" intent=":literal"><semantics><msub><mi>θ</mi><mi>κ</mi></msub><annotation encoding="application/x-tex">\theta_{\kappa}</annotation></semantics></math><span id="S4.I1.i2.p1.1.3" class="ltx_text ltx_font_italic"> with dictionary-only wrapped length and nested tag-dictionaries
(</span><math id="S4.I1.i2.p1.m2" class="ltx_Math" alttext="\hat{\mu}_{m,i}=aa\,x^{i}a\,x^{q+1-i}a\,x^{2^{m}}" display="inline" intent=":literal"><semantics><mrow><msub><mover accent="true"><mi>μ</mi><mo>^</mo></mover><mrow><mi>m</mi><mo>,</mo><mi>i</mi></mrow></msub><mo>=</mo><mrow><mi>a</mi><mo lspace="0em" rspace="0em">​</mo><mi>a</mi><mo lspace="0.170em" rspace="0em">​</mo><msup><mi>x</mi><mi>i</mi></msup><mo lspace="0em" rspace="0em">​</mo><mi>a</mi><mo lspace="0.170em" rspace="0em">​</mo><msup><mi>x</mi><mrow><mrow><mi>q</mi><mo>+</mo><mn>1</mn></mrow><mo>−</mo><mi>i</mi></mrow></msup><mo lspace="0em" rspace="0em">​</mo><mi>a</mi><mo lspace="0.170em" rspace="0em">​</mo><msup><mi>x</mi><msup><mn>2</mn><mi>m</mi></msup></msup></mrow></mrow><annotation encoding="application/x-tex">\hat{\mu}_{m,i}=aa\,x^{i}a\,x^{q+1-i}a\,x^{2^{m}}</annotation></semantics></math><span id="S4.I1.i2.p1.1.4" class="ltx_text ltx_font_italic">, tags </span><math id="S4.I1.i2.p1.m3" class="ltx_Math" alttext="\leq p" display="inline" intent=":literal"><semantics><mrow><mphantom></mphantom><mo>≤</mo><mi>p</mi></mrow><annotation encoding="application/x-tex">\leq p</annotation></semantics></math><span id="S4.I1.i2.p1.1.5" class="ltx_text ltx_font_italic"> versus all), the
analogous pair </span><math id="S4.I1.i2.p1.m4" class="ltx_Math" alttext="(\hat{K},\hat{K}^{\prime})" display="inline" intent=":literal"><semantics><mrow><mo stretchy="false">(</mo><mover accent="true"><mi>K</mi><mo>^</mo></mover><mo>,</mo><msup><mover accent="true"><mi>K</mi><mo>^</mo></mover><mo>′</mo></msup><mo stretchy="false">)</mo></mrow><annotation encoding="application/x-tex">(\hat{K},\hat{K}^{\prime})</annotation></semantics></math><span id="S4.I1.i2.p1.1.6" class="ltx_text ltx_font_italic"> has </span><math id="S4.I1.i2.p1.m5" class="ltx_Math" alttext="\overline{d}(\hat{K},\hat{K}^{\prime})=0" display="inline" intent=":literal"><semantics><mrow><mrow><mover accent="true"><mi>d</mi><mo stretchy="true">¯</mo></mover><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mover accent="true"><mi>K</mi><mo>^</mo></mover><mo>,</mo><msup><mover accent="true"><mi>K</mi><mo>^</mo></mover><mo>′</mo></msup><mo stretchy="false">)</mo></mrow></mrow><mo>=</mo><mn>0</mn></mrow><annotation encoding="application/x-tex">\overline{d}(\hat{K},\hat{K}^{\prime})=0</annotation></semantics></math><span id="S4.I1.i2.p1.1.7" class="ltx_text ltx_font_italic"> (unique parsing via
</span><math id="S4.I1.i2.p1.m6" class="ltx_Math" alttext="aa" display="inline" intent=":literal"><semantics><mrow><mi>a</mi><mo lspace="0em" rspace="0em">​</mo><mi>a</mi></mrow><annotation encoding="application/x-tex">aa</annotation></semantics></math><span id="S4.I1.i2.p1.1.8" class="ltx_text ltx_font_italic">-blocks; the total count of compressible strings is exponential in </span><math id="S4.I1.i2.p1.m7" class="ltx_Math" alttext="L" display="inline" intent=":literal"><semantics><mi>L</mi><annotation encoding="application/x-tex">L</annotation></semantics></math><span id="S4.I1.i2.p1.1.9" class="ltx_text ltx_font_italic">, the </span><math id="S4.I1.i2.p1.m8" class="ltx_Math" alttext="k" display="inline" intent=":literal"><semantics><mi>k</mi><annotation encoding="application/x-tex">k</annotation></semantics></math><span id="S4.I1.i2.p1.1.10" class="ltx_text ltx_font_italic">-block
counting </span><math id="S4.I1.i2.p1.m9" class="ltx_Math" alttext="N_{k}(L)\leq q^{k}(\log_{2}L+1)^{k}" display="inline" intent=":literal"><semantics><mrow><mrow><msub><mi>N</mi><mi>k</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>L</mi><mo stretchy="false">)</mo></mrow></mrow><mo>≤</mo><mrow><msup><mi>q</mi><mi>k</mi></msup><mo lspace="0em" rspace="0em">​</mo><msup><mrow><mo stretchy="false">(</mo><mrow><mrow><msub><mi>log</mi><mn>2</mn></msub><mo lspace="0.167em">⁡</mo><mi>L</mi></mrow><mo>+</mo><mn>1</mn></mrow><mo stretchy="false">)</mo></mrow><mi>k</mi></msup></mrow></mrow><annotation encoding="application/x-tex">N_{k}(L)\leq q^{k}(\log_{2}L+1)^{k}</annotation></semantics></math><span id="S4.I1.i2.p1.1.11" class="ltx_text ltx_font_italic"> bounds the small-</span><math id="S4.I1.i2.p1.m10" class="ltx_Math" alttext="k" display="inline" intent=":literal"><semantics><mi>k</mi><annotation encoding="application/x-tex">k</annotation></semantics></math><span id="S4.I1.i2.p1.1.12" class="ltx_text ltx_font_italic"> mass, and the tag
restriction truncates the rest; the good-word fraction vanishes at rate </span><math id="S4.I1.i2.p1.m11" class="ltx_Math" alttext="\Theta(1/\log L)" display="inline" intent=":literal"><semantics><mrow><mi mathvariant="normal">Θ</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mrow><mn>1</mn><mo>/</mo><mrow><mi>log</mi><mo lspace="0.167em">⁡</mo><mi>L</mi></mrow></mrow><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">\Theta(1/\log L)</annotation></semantics></math><span id="S4.I1.i2.p1.1.13" class="ltx_text ltx_font_italic">
along prefix scales). Nested tag-pairs under unbounded cuts realize no </span><math id="S4.I1.i2.p1.m12" class="ltx_Math" alttext="\alpha\in(0,1)" display="inline" intent=":literal"><semantics><mrow><mi>α</mi><mo>∈</mo><mrow><mo stretchy="false">(</mo><mn>0</mn><mo>,</mo><mn>1</mn><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">\alpha\in(0,1)</annotation></semantics></math><span id="S4.I1.i2.p1.1.14" class="ltx_text ltx_font_italic">.</span></p>
</div></li>
<li id="S4.I1.i3" class="ltx_item" style="list-style-type:none;"><span class="ltx_tag ltx_tag_item">(iii)</span> 
<div id="S4.I1.i3.p1" class="ltx_para">
<p id="S4.I1.i3.p1.1" class="ltx_p"><span id="S4.I1.i3.p1.1.1" class="ltx_text">(Extreme separation point)</span><span id="S4.I1.i3.p1.1.2" class="ltx_text ltx_font_italic"> For that pair </span><math id="S4.I1.i3.p1.m1" class="ltx_Math" alttext="(\hat{K},\hat{K}^{\prime})" display="inline" intent=":literal"><semantics><mrow><mo stretchy="false">(</mo><mover accent="true"><mi>K</mi><mo>^</mo></mover><mo>,</mo><msup><mover accent="true"><mi>K</mi><mo>^</mo></mover><mo>′</mo></msup><mo stretchy="false">)</mo></mrow><annotation encoding="application/x-tex">(\hat{K},\hat{K}^{\prime})</annotation></semantics></math><span id="S4.I1.i3.p1.1.3" class="ltx_text ltx_font_italic">, finite-trivia
sound generators have coverage </span><math id="S4.I1.i3.p1.m2" class="ltx_Math" alttext="0" display="inline" intent=":literal"><semantics><mn>0</mn><annotation encoding="application/x-tex">0</annotation></semantics></math><span id="S4.I1.i3.p1.1.4" class="ltx_text ltx_font_italic"> at truth </span><math id="S4.I1.i3.p1.m3" class="ltx_Math" alttext="\hat{K}^{\prime}" display="inline" intent=":literal"><semantics><msup><mover accent="true"><mi>K</mi><mo>^</mo></mover><mo>′</mo></msup><annotation encoding="application/x-tex">\hat{K}^{\prime}</annotation></semantics></math><span id="S4.I1.i3.p1.1.5" class="ltx_text ltx_font_italic"> (same-transcript transfer and
</span><math id="S4.I1.i3.p1.m4" class="ltx_Math" alttext="\overline{d}(\hat{K},\hat{K}^{\prime})=0" display="inline" intent=":literal"><semantics><mrow><mrow><mover accent="true"><mi>d</mi><mo stretchy="true">¯</mo></mover><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mover accent="true"><mi>K</mi><mo>^</mo></mover><mo>,</mo><msup><mover accent="true"><mi>K</mi><mo>^</mo></mover><mo>′</mo></msup><mo stretchy="false">)</mo></mrow></mrow><mo>=</mo><mn>0</mn></mrow><annotation encoding="application/x-tex">\overline{d}(\hat{K},\hat{K}^{\prime})=0</annotation></semantics></math><span id="S4.I1.i3.p1.1.6" class="ltx_text ltx_font_italic">), while </span><math id="S4.I1.i3.p1.m5" class="ltx_Math" alttext="G_{\mathrm{sw}}" display="inline" intent=":literal"><semantics><msub><mi>G</mi><mi>sw</mi></msub><annotation encoding="application/x-tex">G_{\mathrm{sw}}</annotation></semantics></math><span id="S4.I1.i3.p1.1.7" class="ltx_text ltx_font_italic"> of </span><a href="#S3.Thmtheorem7" title="Theorem 3.7 (Achievability side: sweep and the tight generator). ‣ The tight family. ‣ The trivia phase transition ‣ Main Results" class="ltx_ref ltx_font_italic"><span class="ltx_text ltx_ref_tag">Theorem</span> <span class="ltx_text ltx_ref_tag">3.7</span></a><span id="S4.I1.i3.p1.1.8" class="ltx_text ltx_font_italic">(i) achieves
coverage </span><math id="S4.I1.i3.p1.m6" class="ltx_Math" alttext="1" display="inline" intent=":literal"><semantics><mn>1</mn><annotation encoding="application/x-tex">1</annotation></semantics></math><span id="S4.I1.i3.p1.1.9" class="ltx_text ltx_font_italic"> with vanishing trivia rate. The free regime exhibits the maximal gap of the
dichotomy: coverage </span><math id="S4.I1.i3.p1.m7" class="ltx_Math" alttext="0" display="inline" intent=":literal"><semantics><mn>0</mn><annotation encoding="application/x-tex">0</annotation></semantics></math><span id="S4.I1.i3.p1.1.10" class="ltx_text ltx_font_italic"> versus </span><math id="S4.I1.i3.p1.m8" class="ltx_Math" alttext="1" display="inline" intent=":literal"><semantics><mn>1</mn><annotation encoding="application/x-tex">1</annotation></semantics></math><span id="S4.I1.i3.p1.1.11" class="ltx_text ltx_font_italic">.</span></p>
</div></li>
</ol>
</div>
</div>
<div id="S4.p7" class="ltx_para">
<p id="S4.p7.1" class="ltx_p">Finally, the exhaustive generator is quantitatively imprecise: among formal statements within
a ball, only a polynomially small fraction is valuable.</p>
</div>
<div id="S4.Thmtheorem3" class="ltx_theorem ltx_theorem_proposition">
<h6 class="ltx_title ltx_runin ltx_title_theorem"><span class="ltx_tag ltx_tag_theorem"><span id="S4.Thmtheorem3.2" class="ltx_text ltx_font_bold">Proposition 4.3</span></span><span id="S4.Thmtheorem3.3" class="ltx_text ltx_font_bold"> </span>(Imprecision of exhaustive generation)<span id="S4.Thmtheorem3.4" class="ltx_text ltx_font_bold">.</span></h6>
<div id="S4.Thmtheorem3.p1" class="ltx_para">
<p id="S4.Thmtheorem3.p1.1" class="ltx_p"><span id="S4.Thmtheorem3.p1.1.1" class="ltx_text ltx_font_italic">In <math id="S4.Thmtheorem3.p1.m1" class="ltx_Math" alttext="A_{n}" display="inline" intent=":literal"><semantics><msub><mi>A</mi><mi>n</mi></msub><annotation encoding="application/x-tex">A_{n}</annotation></semantics></math> with base <math id="S4.Thmtheorem3.p1.m2" class="ltx_Math" alttext="c\geq 4" display="inline" intent=":literal"><semantics><mrow><mi>c</mi><mo>≥</mo><mn>4</mn></mrow><annotation encoding="application/x-tex">c\geq 4</annotation></semantics></math> and <math id="S4.Thmtheorem3.p1.m3" class="ltx_Math" alttext="\kappa&lt;n(1-1/\log_{2}c)" display="inline" intent=":literal"><semantics><mrow><mi>κ</mi><mo>&lt;</mo><mrow><mi>n</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mrow><mn>1</mn><mo>−</mo><mrow><mn>1</mn><mo>/</mo><mrow><msub><mi>log</mi><mn>2</mn></msub><mo lspace="0.167em">⁡</mo><mi>c</mi></mrow></mrow></mrow><mo stretchy="false">)</mo></mrow></mrow></mrow><annotation encoding="application/x-tex">\kappa&lt;n(1-1/\log_{2}c)</annotation></semantics></math>, the compressible sublanguage <math id="S4.Thmtheorem3.p1.m4" class="ltx_Math" alttext="H=H_{D_{c}}" display="inline" intent=":literal"><semantics><mrow><mi>H</mi><mo>=</mo><msub><mi>H</mi><msub><mi>D</mi><mi>c</mi></msub></msub></mrow><annotation encoding="application/x-tex">H=H_{D_{c}}</annotation></semantics></math> satisfies</span></p>
<table id="S4.E2" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="S4.E2.m1" class="ltx_Math" alttext="c_{1}\,r^{\,1/\log_{2}c-n}\ \leq\ \frac{\lvert H\cap B_{G}(r)\rvert}{\lvert B_{G}(r)\rvert}\ \leq\ c_{2}\,r^{-\delta},\qquad\delta=n-\kappa-n/\log_{2}c&gt;0," display="block" intent=":literal"><semantics><mrow><mrow><mrow><mrow><msub><mi>c</mi><mn>1</mn></msub><mo lspace="0.170em" rspace="0em">​</mo><msup><mi>r</mi><mrow><mrow><mn> 1</mn><mo>/</mo><mrow><msub><mi>log</mi><mn>2</mn></msub><mo lspace="0.167em">⁡</mo><mi>c</mi></mrow></mrow><mo>−</mo><mi>n</mi></mrow></msup></mrow><mo rspace="0.778em">≤</mo><mfrac><mrow><mo stretchy="false">|</mo><mrow><mi>H</mi><mo>∩</mo><mrow><msub><mi>B</mi><mi>G</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>r</mi><mo stretchy="false">)</mo></mrow></mrow></mrow><mo stretchy="false">|</mo></mrow><mrow><mo stretchy="false">|</mo><mrow><msub><mi>B</mi><mi>G</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>r</mi><mo stretchy="false">)</mo></mrow></mrow><mo stretchy="false">|</mo></mrow></mfrac><mo lspace="0.778em" rspace="0.778em">≤</mo><mrow><msub><mi>c</mi><mn>2</mn></msub><mo lspace="0em" rspace="0em">​</mo><msup><mi>r</mi><mrow><mo>−</mo><mi>δ</mi></mrow></msup></mrow></mrow><mo rspace="2.167em">,</mo><mrow><mi>δ</mi><mo>=</mo><mrow><mi>n</mi><mo>−</mo><mi>κ</mi><mo>−</mo><mrow><mi>n</mi><mo>/</mo><mrow><msub><mi>log</mi><mn>2</mn></msub><mo lspace="0.167em">⁡</mo><mi>c</mi></mrow></mrow></mrow><mo>&gt;</mo><mn>0</mn></mrow></mrow><mo>,</mo></mrow><annotation encoding="application/x-tex">c_{1}\,r^{\,1/\log_{2}c-n}\ \leq\ \frac{\lvert H\cap B_{G}(r)\rvert}{\lvert B_{G}(r)\rvert}\ \leq\ c_{2}\,r^{-\delta},\qquad\delta=n-\kappa-n/\log_{2}c&gt;0,</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td>
<td rowspan="1" class="ltx_eqn_cell ltx_eqn_eqno ltx_align_middle ltx_align_right"><span class="ltx_tag ltx_tag_equation ltx_align_right">(4.2)</span></td></tr></tbody>
</table>
<p id="S4.Thmtheorem3.p1.2" class="ltx_p"><span id="S4.Thmtheorem3.p1.2.1" class="ltx_text ltx_font_italic">where <math id="S4.Thmtheorem3.p1.m5" class="ltx_Math" alttext="B_{G}(r)" display="inline" intent=":literal"><semantics><mrow><msub><mi>B</mi><mi>G</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>r</mi><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">B_{G}(r)</annotation></semantics></math> is the wrapped-length ball of radius <math id="S4.Thmtheorem3.p1.m6" class="ltx_Math" alttext="r" display="inline" intent=":literal"><semantics><mi>r</mi><annotation encoding="application/x-tex">r</annotation></semantics></math>. The fraction of compressible
statements is polynomially small in the radius <math id="S4.Thmtheorem3.p1.m7" class="ltx_Math" alttext="r" display="inline" intent=":literal"><semantics><mi>r</mi><annotation encoding="application/x-tex">r</annotation></semantics></math>, equivalently exponentially small in ABFM’s
compressed scale <math id="S4.Thmtheorem3.p1.m8" class="ltx_Math" alttext="s" display="inline" intent=":literal"><semantics><mi>s</mi><annotation encoding="application/x-tex">s</annotation></semantics></math> (since <math id="S4.Thmtheorem3.p1.m9" class="ltx_Math" alttext="r=c^{\Theta(s)}" display="inline" intent=":literal"><semantics><mrow><mi>r</mi><mo>=</mo><msup><mi>c</mi><mrow><mi mathvariant="normal">Θ</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>s</mi><mo stretchy="false">)</mo></mrow></mrow></msup></mrow><annotation encoding="application/x-tex">r=c^{\Theta(s)}</annotation></semantics></math>; interpretation only). The exhaustive
generator’s precision thus tends to <math id="S4.Thmtheorem3.p1.m10" class="ltx_Math" alttext="0" display="inline" intent=":literal"><semantics><mn>0</mn><annotation encoding="application/x-tex">0</annotation></semantics></math> polynomially in volume, while the sweep generator’s
precision tends to <math id="S4.Thmtheorem3.p1.m11" class="ltx_Math" alttext="1" display="inline" intent=":literal"><semantics><mn>1</mn><annotation encoding="application/x-tex">1</annotation></semantics></math>.</span></p>
</div>
</div>
<div id="S4.3" class="ltx_proof">
<h6 class="ltx_title ltx_runin ltx_font_italic ltx_title_proof">Proof sketch.</h6>
<div id="S4.p8" class="ltx_para">
<p id="S4.p8.1" class="ltx_p"><span id="S4.p8.1.1" class="ltx_text">Two-sided counting of compressible multisets: the upper bound counts representations with
small digit sums against the volume of <math id="S4.p8.m1" class="ltx_Math" alttext="B_{G}(r)" display="inline" intent=":literal"><semantics><mrow><msub><mi>B</mi><mi>G</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>r</mi><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">B_{G}(r)</annotation></semantics></math>, the lower bound exhibits a positive density
of compressible points. Full proof in <a href="#A4.SS6" title="The instantiation (, and ) ‣ Appendix D Deferred Proofs" class="ltx_ref"><span class="ltx_text ltx_ref_tag">Section</span> <span class="ltx_text ltx_ref_tag">D.6</span></a>.
∎</span></p>
</div>
</div>
<div id="S4.Thmtheorem4" class="ltx_theorem ltx_theorem_remark">
<h6 class="ltx_title ltx_runin ltx_title_theorem"><span class="ltx_tag ltx_tag_theorem"><span id="S4.Thmtheorem4.2" class="ltx_text ltx_font_italic">Remark 4.4</span></span><span id="S4.Thmtheorem4.3" class="ltx_text ltx_font_italic"> </span>(Numerical sanity checks)<span id="S4.Thmtheorem4.4" class="ltx_text ltx_font_italic">.</span></h6>
<div id="S4.Thmtheorem4.p1" class="ltx_para">
<p id="S4.Thmtheorem4.p1.1" class="ltx_p">The density claims were sanity-checked numerically using the limit-set methodology: fix the
prefix size <math id="S4.Thmtheorem4.p1.m1" class="ltx_Math" alttext="N" display="inline" intent=":literal"><semantics><mi>N</mi><annotation encoding="application/x-tex">N</annotation></semantics></math>, grow the run length <math id="S4.Thmtheorem4.p1.m2" class="ltx_Math" alttext="T" display="inline" intent=":literal"><semantics><mi>T</mi><annotation encoding="application/x-tex">T</annotation></semantics></math>, and compute coverages in exact rational arithmetic
to avoid floating-point artifacts in the density limits. The race share converges to <math id="S4.Thmtheorem4.p1.m3" class="ltx_Math" alttext="1/2" display="inline" intent=":literal"><semantics><mrow><mn>1</mn><mo>/</mo><mn>2</mn></mrow><annotation encoding="application/x-tex">1/2</annotation></semantics></math>,
and on <math id="S4.Thmtheorem4.p1.m4" class="ltx_Math" alttext="\mathcal{H}_{\alpha}" display="inline" intent=":literal"><semantics><msub><mi class="ltx_font_mathcaligraphic">ℋ</mi><mi>α</mi></msub><annotation encoding="application/x-tex">\mathcal{H}_{\alpha}</annotation></semantics></math> with <math id="S4.Thmtheorem4.p1.m5" class="ltx_Math" alttext="\alpha=1/3" display="inline" intent=":literal"><semantics><mrow><mi>α</mi><mo>=</mo><mrow><mn>1</mn><mo>/</mo><mn>3</mn></mrow></mrow><annotation encoding="application/x-tex">\alpha=1/3</annotation></semantics></math> the truth-<math id="S4.Thmtheorem4.p1.m6" class="ltx_Math" alttext="K^{\prime}" display="inline" intent=":literal"><semantics><msup><mi>K</mi><mo>′</mo></msup><annotation encoding="application/x-tex">K^{\prime}</annotation></semantics></math> coverage of <math id="S4.Thmtheorem4.p1.m7" class="ltx_Math" alttext="G^{*}" display="inline" intent=":literal"><semantics><msup><mi>G</mi><mo>∗</mo></msup><annotation encoding="application/x-tex">G^{*}</annotation></semantics></math> converges to <math id="S4.Thmtheorem4.p1.m8" class="ltx_Math" alttext="5/6=1-\alpha/2" display="inline" intent=":literal"><semantics><mrow><mrow><mn>5</mn><mo>/</mo><mn>6</mn></mrow><mo>=</mo><mrow><mn>1</mn><mo>−</mo><mrow><mi>α</mi><mo>/</mo><mn>2</mn></mrow></mrow></mrow><annotation encoding="application/x-tex">5/6=1-\alpha/2</annotation></semantics></math> while a pure-race generator stalls at <math id="S4.Thmtheorem4.p1.m9" class="ltx_Math" alttext="\alpha/2\approx 0.17" display="inline" intent=":literal"><semantics><mrow><mrow><mi>α</mi><mo>/</mo><mn>2</mn></mrow><mo>≈</mo><mn>0.17</mn></mrow><annotation encoding="application/x-tex">\alpha/2\approx 0.17</annotation></semantics></math>. See
<a href="#A6" title="Appendix F Numerical Validation" class="ltx_ref"><span class="ltx_text ltx_ref_tag">Appendix</span> <span class="ltx_text ltx_ref_tag">F</span></a> for the details.</p>
</div>
</div>
</section>
<section id="S5" class="ltx_section">
<h2 class="ltx_title ltx_font_bold ltx_title_section" style="font-size:144%;--ltx-fg-color:#1F4FA8;">Discussion</h2>

<section id="S5.SS0.SSS0.Px1" class="ltx_paragraph">
<h5 class="ltx_title ltx_title_paragraph">What the results say for practice.</h5>

<div id="S5.SS0.SSS0.Px1.p1" class="ltx_para">
<p id="S5.SS0.SSS0.Px1.p1.1" class="ltx_p">The picture for verifier-coupled mathematical generation is sharp and, we think, not the one a
practitioner expects. A proof checker guarantees validity and makes every error benign (under
sound coverage no output is ever false, <a href="#S3.Thmtheorem2" title="Theorem 3.2 (The exhaustive generator and the separation). ‣ Sound coverage: what the verifier does buy ‣ Main Results" class="ltx_ref"><span class="ltx_text ltx_ref_tag">Theorem</span> <span class="ltx_text ltx_ref_tag">3.2</span></a>), but it supplies no information
about value (<a href="#S3.Thmtheorem1" title="Theorem 3.1 (Verification is not taste). ‣ Verification is not taste ‣ Main Results" class="ltx_ref"><span class="ltx_text ltx_ref_tag">Theorem</span> <span class="ltx_text ltx_ref_tag">3.1</span></a>). Covering unrecorded valuable mathematics is therefore not
free: by <a href="#S3.Thmtheorem10" title="Corollary 3.10 (The trivia dichotomy). ‣ The tight family. ‣ The trivia phase transition ‣ Main Results" class="ltx_ref"><span class="ltx_text ltx_ref_tag">Corollary</span> <span class="ltx_text ltx_ref_tag">3.10</span></a> any generator reaching beyond coverage <math id="S5.SS0.SSS0.Px1.p1.m1" class="ltx_Math" alttext="\alpha/2" display="inline" intent=":literal"><semantics><mrow><mi>α</mi><mo>/</mo><mn>2</mn></mrow><annotation encoding="application/x-tex">\alpha/2</annotation></semantics></math> must emit
infinitely many certified trivia, and a generator that does so is the <em id="S5.SS0.SSS0.Px1.p1.1.1" class="ltx_emph ltx_font_italic">provably optimal
shape</em> of a broad generator, not a defect to be engineered away. What can be engineered away
is its visible cost: those trivia are needed only at asymptotically negligible rate
(<a href="#S3.Thmtheorem7" title="Theorem 3.7 (Achievability side: sweep and the tight generator). ‣ The tight family. ‣ The trivia phase transition ‣ Main Results" class="ltx_ref"><span class="ltx_text ltx_ref_tag">Theorem</span> <span class="ltx_text ltx_ref_tag">3.7</span></a>). The corollary for system design is that selectivity—taste, the
decision of which valid statements are worth recording—cannot come from the verifier and
must come from examples; “filter the trivia” is a post-processing question about value,
orthogonal to the validity the checker already certifies.</p>
</div>
</section>
<section id="S5.SS0.SSS0.Px2" class="ltx_paragraph">
<h5 class="ltx_title ltx_title_paragraph">The count budget collapses (a finding, not an open problem).</h5>

<div id="S5.SS0.SSS0.Px2.p1" class="ltx_para">
<p id="S5.SS0.SSS0.Px2.p1.1" class="ltx_p">One might hope for a finer hierarchy between the finite and the infinite trivia regimes,
indexed by a count budget <math id="S5.SS0.SSS0.Px2.p1.m1" class="ltx_Math" alttext="g(N)" display="inline" intent=":literal"><semantics><mrow><mi>g</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>N</mi><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">g(N)</annotation></semantics></math> on the trivia emitted in the first <math id="S5.SS0.SSS0.Px2.p1.m2" class="ltx_Math" alttext="N" display="inline" intent=":literal"><semantics><mi>N</mi><annotation encoding="application/x-tex">N</annotation></semantics></math> rounds. There is none.
Our achievability proof shows that the sweep claims every never-enumerated valuable string
under <em id="S5.SS0.SSS0.Px2.p1.1.1" class="ltx_emph ltx_font_italic">any</em> unbounded trivia allowance, so every <math id="S5.SS0.SSS0.Px2.p1.m3" class="ltx_Math" alttext="g(N)\to\infty" display="inline" intent=":literal"><semantics><mrow><mrow><mi>g</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>N</mi><mo stretchy="false">)</mo></mrow></mrow><mo stretchy="false">→</mo><mi mathvariant="normal">∞</mi></mrow><annotation encoding="application/x-tex">g(N)\to\infty</annotation></semantics></math> already buys the full
<math id="S5.SS0.SSS0.Px2.p1.m4" class="ltx_Math" alttext="1-\alpha/2" display="inline" intent=":literal"><semantics><mrow><mn>1</mn><mo>−</mo><mrow><mi>α</mi><mo>/</mo><mn>2</mn></mrow></mrow><annotation encoding="application/x-tex">1-\alpha/2</annotation></semantics></math> (<a href="#S3.Thmtheorem7" title="Theorem 3.7 (Achievability side: sweep and the tight generator). ‣ The tight family. ‣ The trivia phase transition ‣ Main Results" class="ltx_ref"><span class="ltx_text ltx_ref_tag">Theorem</span> <span class="ltx_text ltx_ref_tag">3.7</span></a>); the finite-trivia cap <math id="S5.SS0.SSS0.Px2.p1.m5" class="ltx_Math" alttext="\alpha/2" display="inline" intent=":literal"><semantics><mrow><mi>α</mi><mo>/</mo><mn>2</mn></mrow><annotation encoding="application/x-tex">\alpha/2</annotation></semantics></math> is exactly the
complementary case (<a href="#S3.Thmtheorem6" title="Theorem 3.6 (Impossibility side of the dichotomy). ‣ The tight family. ‣ The trivia phase transition ‣ Main Results" class="ltx_ref"><span class="ltx_text ltx_ref_tag">Theorem</span> <span class="ltx_text ltx_ref_tag">3.6</span></a>). The dichotomy is genuinely <em id="S5.SS0.SSS0.Px2.p1.1.2" class="ltx_emph ltx_font_italic">count-finite versus
count-infinite</em>, full stop, and not the coarse shadow of a smoother trade-off.</p>
</div>
</section>
<section id="S5.SS0.SSS0.Px3" class="ltx_paragraph">
<h5 class="ltx_title ltx_title_paragraph">Open problems.</h5>

<div id="S5.SS0.SSS0.Px3.p1" class="ltx_para">
<ol id="S5.I1" class="ltx_enumerate" style="--ltx-enum-leftmargin:2.2em;">
<li id="S5.I1.i1" class="ltx_item" style="list-style-type:none;"><span class="ltx_tag ltx_tag_item">1.</span> 
<div id="S5.I1.i1.p1" class="ltx_para">
<p id="S5.I1.i1.p1.1" class="ltx_p"><em id="S5.I1.i1.p1.1.1" class="ltx_emph ltx_font_italic">The singleton sparse-core race.</em> On the tight family the recorded core is the
conjunction of the candidates and is raceable at exactly <math id="S5.I1.i1.p1.m1" class="ltx_Math" alttext="1/2" display="inline" intent=":literal"><semantics><mrow><mn>1</mn><mo>/</mo><mn>2</mn></mrow><annotation encoding="application/x-tex">1/2</annotation></semantics></math>. When the core is an
unstructured sparse set (a singleton collection), a bottom-racing adversary outruns any
core-blind generator, and the optimal share of the recorded mass is governed by
combinatorics we have not resolved. We conjecture the optimum is <math id="S5.I1.i1.p1.m2" class="ltx_Math" alttext="1-\alpha" display="inline" intent=":literal"><semantics><mrow><mn>1</mn><mo>−</mo><mi>α</mi></mrow><annotation encoding="application/x-tex">1-\alpha</annotation></semantics></math> for <math id="S5.I1.i1.p1.m3" class="ltx_Math" alttext="\alpha\leq 1/2" display="inline" intent=":literal"><semantics><mrow><mi>α</mi><mo>≤</mo><mrow><mn>1</mn><mo>/</mo><mn>2</mn></mrow></mrow><annotation encoding="application/x-tex">\alpha\leq 1/2</annotation></semantics></math>; settling it is a cat-and-mouse problem about which the present techniques are
silent.</p>
</div></li>
<li id="S5.I1.i2" class="ltx_item" style="list-style-type:none;"><span class="ltx_tag ltx_tag_item">2.</span> 
<div id="S5.I1.i2.p1" class="ltx_para">
<p id="S5.I1.i2.p1.1" class="ltx_p"><em id="S5.I1.i2.p1.1.1" class="ltx_emph ltx_font_italic">Partial enumeration of structured chains.</em> <a href="#S4.Thmtheorem1" title="Theorem 4.1 (Abelian refinement chains are identifiable). ‣ Case Study: Instantiation in a Compression Model of Mathematics" class="ltx_ref"><span class="ltx_text ltx_ref_tag">Theorem</span> <span class="ltx_text ltx_ref_tag">4.1</span></a> establishes
breadth for abelian refinement chains in the breadth model; the behavior of their relative
densities under partial enumeration, whether the structured regime that needs no trivia
for breadth also escapes them for density, is open.</p>
</div></li>
<li id="S5.I1.i3" class="ltx_item" style="list-style-type:none;"><span class="ltx_tag ltx_tag_item">3.</span> 
<div id="S5.I1.i3.p1" class="ltx_para">
<p id="S5.I1.i3.p1.1" class="ltx_p"><em id="S5.I1.i3.p1.1.1" class="ltx_emph ltx_font_italic">Statistical rates.</em> We work distribution-free and in the limit. A relativization
of the rate analysis of <cite class="ltx_cite ltx_citemacro_citet"><a href="#bib.bib2" title="" class="ltx_ref">Kalavasis et al. (2025)</a></cite> to the nested pair, quantifying how
fast coverage approaches its optimum, is left open.</p>
</div></li>
<li id="S5.I1.i4" class="ltx_item" style="list-style-type:none;"><span class="ltx_tag ltx_tag_item">4.</span> 
<div id="S5.I1.i4.p1" class="ltx_para">
<p id="S5.I1.i4.p1.1" class="ltx_p"><em id="S5.I1.i4.p1.1.1" class="ltx_emph ltx_font_italic">Computational and efficient versions.</em> Our generators are arbitrary functions of
the prefix; whether the dichotomy survives a computability or efficiency constraint, in
the spirit of the complexity barriers of <cite class="ltx_cite ltx_citemacro_citet"><a href="#bib.bib15" title="" class="ltx_ref">Arenas et al. (2026)</a></cite>, is open in the
nested model.</p>
</div></li>
<li id="S5.I1.i5" class="ltx_item" style="list-style-type:none;"><span class="ltx_tag ltx_tag_item">5.</span> 
<div id="S5.I1.i5.p1" class="ltx_para">
<p id="S5.I1.i5.p1.1" class="ltx_p"><em id="S5.I1.i5.p1.1.1" class="ltx_emph ltx_font_italic">Oracle-free sound coverage.</em> <a href="#S3.Thmtheorem2" title="Theorem 3.2 (The exhaustive generator and the separation). ‣ Sound coverage: what the verifier does buy ‣ Main Results" class="ltx_ref"><span class="ltx_text ltx_ref_tag">Theorem</span> <span class="ltx_text ltx_ref_tag">3.2</span></a>(b) exhibits one pair model on
which no oracle-free generator achieves sound coverage, but we do not characterize which
pair models admit it. We ask for an Angluin-type condition on <math id="S5.I1.i5.p1.m1" class="ltx_Math" alttext="\mathcal{P}" display="inline" intent=":literal"><semantics><mi class="ltx_font_mathcaligraphic">𝒫</mi><annotation encoding="application/x-tex">\mathcal{P}</annotation></semantics></math> (a combinatorial
property of the candidate pairs) deciding whether oracle-free sound coverage
(equivalently, the sandwich property of (<a href="#S2.E6" title="Equation 2.6 ‣ Definition 2.6 (Coverage, soundness, sound coverage). ‣ The nested model: validity versus value ‣ The Model" class="ltx_ref"><span class="ltx_text ltx_ref_tag">2.6</span></a>)) is achievable; our separation
gives one failure, a full characterization is open.</p>
</div></li>
</ol>
</div>
</section>
<section id="S5.SS0.SSS0.Px4" class="ltx_paragraph">
<h5 class="ltx_title ltx_title_paragraph">Limitation.</h5>

<div id="S5.SS0.SSS0.Px4.p1" class="ltx_para">
<p id="S5.SS0.SSS0.Px4.p1.1" class="ltx_p">The dichotomy is stated for the tight family <math id="S5.SS0.SSS0.Px4.p1.m1" class="ltx_Math" alttext="\mathcal{H}_{\alpha}" display="inline" intent=":literal"><semantics><msub><mi class="ltx_font_mathcaligraphic">ℋ</mi><mi>α</mi></msub><annotation encoding="application/x-tex">\mathcal{H}_{\alpha}</annotation></semantics></math>, where the recorded core is the
conjunction of candidates; the universal sweep bound <math id="S5.SS0.SSS0.Px4.p1.m2" class="ltx_Math" alttext="c\geq 1-\overline{d}(C,H)" display="inline" intent=":literal"><semantics><mrow><mi>c</mi><mo>≥</mo><mrow><mn>1</mn><mo>−</mo><mrow><mover accent="true"><mi>d</mi><mo stretchy="true">¯</mo></mover><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>C</mi><mo>,</mo><mi>H</mi><mo stretchy="false">)</mo></mrow></mrow></mrow></mrow><annotation encoding="application/x-tex">c\geq 1-\overline{d}(C,H)</annotation></semantics></math> holds for
every countable collection, but the matching lower bound <math id="S5.SS0.SSS0.Px4.p1.m3" class="ltx_Math" alttext="1-\alpha/2" display="inline" intent=":literal"><semantics><mrow><mn>1</mn><mo>−</mo><mrow><mi>α</mi><mo>/</mo><mn>2</mn></mrow></mrow><annotation encoding="application/x-tex">1-\alpha/2</annotation></semantics></math> does not, and core
structure, not merely density, decides the optimum, as the singleton race above shows. The
compression instantiation is a worked realization, not a theorem about all compressible
languages: <a href="#S4.Thmtheorem2" title="Proposition 4.2 (Free-monoid pairs realize the dichotomy). ‣ Case Study: Instantiation in a Compression Model of Mathematics" class="ltx_ref"><span class="ltx_text ltx_ref_tag">Proposition</span> <span class="ltx_text ltx_ref_tag">4.2</span></a> exhibits families meeting the lower-bound interface, not a
generic-language statement. And throughout, value is modeled as an unknown language, not
defined; the contribution is the price of covering it, not a theory of what makes mathematics
worth doing.</p>
</div>
</section>
</section>
<section id="S6" class="ltx_section">
<h2 class="ltx_title ltx_font_bold ltx_title_section" style="font-size:144%;--ltx-fg-color:#1F4FA8;">Outlook: We Must Generate. We Will Select.</h2>

<div id="S6.p1" class="ltx_para">
<p id="S6.p1.1" class="ltx_p">A century ago, <cite class="ltx_cite ltx_citemacro_citet"><a href="#bib.bib54" title="" class="ltx_ref">Poincaré (1914)</a></cite> located mathematical discovery not in the
production of true statements, which “can be done by any one,” but in the discernment that
selects among them. Our results give that observation a quantitative edge in the machine age.
A perfect verifier secures the border of the formal world: within it nothing is false, and
every unavoidable error has been demoted to mere triviality (<a href="#S3.Thmtheorem2" title="Theorem 3.2 (The exhaustive generator and the separation). ‣ Sound coverage: what the verifier does buy ‣ Main Results" class="ltx_ref"><span class="ltx_text ltx_ref_tag">Theorem</span> <span class="ltx_text ltx_ref_tag">3.2</span></a>). About which
truths deserve to be kept, however, the verifier is silent (<a href="#S3.Thmtheorem1" title="Theorem 3.1 (Verification is not taste). ‣ Verification is not taste ‣ Main Results" class="ltx_ref"><span class="ltx_text ltx_ref_tag">Theorem</span> <span class="ltx_text ltx_ref_tag">3.1</span></a>), and the
dichotomy prices that silence. A generator that would harvest the unrecorded valuable
mathematics must flood; the flood can be thinned to a vanishing fraction of the stream, but
never dammed to a finite count (<a href="#S3.Thmtheorem7" title="Theorem 3.7 (Achievability side: sweep and the tight generator). ‣ The tight family. ‣ The trivia phase transition ‣ Main Results" class="ltx_ref"><span class="ltx_text ltx_ref_tag">Theorem</span> <span class="ltx_text ltx_ref_tag">3.7</span></a>, <a href="#S3.Thmtheorem10" title="Corollary 3.10 (The trivia dichotomy). ‣ The tight family. ‣ The trivia phase transition ‣ Main Results" class="ltx_ref"><span class="ltx_text ltx_ref_tag">Corollary</span> <span class="ltx_text ltx_ref_tag">3.10</span></a>). Flood and harvest
are not a defect and its remedy. They are two faces of a single process, and the first cannot
be dispensed with if the second is to be complete. What remains, for machines as it has
always been for mathematicians, is taste: the selection that must follow correctness and that
no checker can supply. If machines are to help expand mathematics, they must first be allowed
to generate more truth than anyone cares to know, and we must learn to find, inside that
flood, the part worth keeping. Hilbert’s confidence, broadcast to the world in
<cite class="ltx_cite ltx_citemacro_citeyear"><a href="#bib.bib61" title="" class="ltx_ref">1930</a></cite>, has lost none of its force. Our theorems only add a
quiet corollary: the knowing will not arrive alone.</p>
</div>
<div id="S6.p2" class="ltx_para ltx_noindent"><span class="ltx_inline-block"><svg id="S6.p2.pic1" class="ltx_picture" height="68.06" overflow="visible" version="1.1" viewBox="0 0 670 68.06" width="670"><g style="--ltx-stroke-color:#000000;--ltx-fill-color:#000000;" fill="#000000" stroke="#000000" stroke-width="0.4pt" transform="translate(0,68.06) matrix(1 0 0 -1 0 0)"><clipPath id="pgfcp21"><path d="M -22670.54 -22670.54 L 22670.54 -22670.54 L 22670.54 22670.54 L -22670.54 22670.54 Z M 0 7.87 L 0 60.19 C 0 64.54 3.53 68.06 7.87 68.06 L 662.13 68.06 C 666.48 68.06 670 64.54 670 60.19 L 670 7.87 C 670 3.53 666.48 0 662.13 0 L 7.87 0 C 3.53 0 0 3.53 0 7.87 Z"></path></clipPath><g fill-rule="evenodd"><g style="--ltx-fill-color:#F2F2F2;" fill="#F2F2F2" fill-opacity="1.0"><path style="stroke:none" d="M 0 7.87 L 0 60.19 C 0 64.54 3.53 68.06 7.87 68.06 L 662.13 68.06 C 666.48 68.06 670 64.54 670 60.19 L 670 7.87 C 670 3.53 666.48 0 662.13 0 L 7.87 0 C 3.53 0 0 3.53 0 7.87 Z"></path><clipPath id="pgfcp22"><path d="M 0 7.87 L 0 60.19 C 0 64.54 3.53 68.06 7.87 68.06 L 662.13 68.06 C 666.48 68.06 670 64.54 670 60.19 L 670 7.87 C 670 3.53 666.48 0 662.13 0 L 7.87 0 C 3.53 0 0 3.53 0 7.87 Z"></path></clipPath><g clip-path="url(#pgfcp22)"><g transform="matrix(1.0 0.0 0.0 1.0 335 34.03) matrix(0.0 1.0 -1.0 0.0 0 0) matrix(0.98026 0.0 0.0 9.64932 0 0)"><defs><linearGradient gradientTransform="rotate(90)" id="pgfsh23"><stop offset="0.0" stop-color="#FCF8EE"></stop><stop offset="0.24998" stop-color="#FCF8EE"></stop><stop offset="0.49996" stop-color="#F8F8F5"></stop><stop offset="0.75002" stop-color="#F3F7FC"></stop><stop offset="1.0" stop-color="#F3F7FC"></stop></linearGradient></defs><g transform="translate(-69.44499 -69.44499)"><rect style="fill:url(#pgfsh23);stroke:none" height="138.89" width="138.89"></rect></g></g></g></g><g fill-opacity="1.0" transform="matrix(1.0 0.0 0.0 1.0 16.39 47.52)"><foreignObject style="--ltx-fo-width:46.05em;--ltx-fo-height:0.7em;--ltx-fo-depth:2.65em;font-size:10pt;" height="46.35" overflow="visible" transform="matrix(1 0 0 -1 0 9.69)" width="637.2"><span class="ltx_foreignobject_container"><span class="ltx_foreignobject_content">
<span id="S6.p2.pic1.1" class="ltx_inline-block ltx_minipage ltx_align_bottom" style="width:46.05em;">
<span id="S6.p2.pic1.1.1" class="ltx_quote">
<span id="S6.p2.pic1.1.1.1" class="ltx_p"><span id="S6.p2.pic1.1.1.1.1" class="ltx_text ltx_font_italic" style="--ltx-fg-color:#000000;">“Wir müssen wissen. Wir werden wissen.”</span></span>
<span id="S6.p2.pic1.1.1.2" class="ltx_p"><span id="S6.p2.pic1.1.1.2.1" class="ltx_text ltx_font_italic" style="--ltx-fg-color:#000000;">“We must know. We will know.”</span></span>
<span id="S6.p2.pic1.1.1.3" class="ltx_p"><span id="S6.p2.pic1.1.1.3.1" class="ltx_text ltx_font_italic" style="--ltx-fg-color:#000000;">— David Hilbert, Königsberg address <cite class="ltx_cite ltx_citemacro_citeyearpar">(<a href="#bib.bib61" title="" class="ltx_ref">1930</a>)</cite></span></span>
</span>
</span></span></span></foreignObject></g></g></g></svg></span>
</div>
</section>
