<td id="A6.SS0.SSS0.Px2.p2.1.7.2" class="ltx_td ltx_align_left ltx_border_bb"><math id="A6.SS0.SSS0.Px2.m27" class="ltx_Math" alttext="K^{\prime}" display="inline" intent=":literal"><semantics><msup><mi>K</mi><mo>′</mo></msup><annotation encoding="application/x-tex">K^{\prime}</annotation></semantics></math></td>
