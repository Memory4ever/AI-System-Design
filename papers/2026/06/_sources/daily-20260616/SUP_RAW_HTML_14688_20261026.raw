<td id="A7.T5.4.6.4" class="ltx_td ltx_align_right"><span id="A7.T5.4.6.4.1" class="ltx_text" style="font-size:80%;">94</span></td>
<td id="A7.T5.4.6.5" class="ltx_td ltx_nopad_r ltx_align_right"><span id="A7.T5.4.6.5.1" class="ltx_text" style="font-size:80%;">98</span></td></tr>
