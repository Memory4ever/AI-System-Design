contradiction (</span><a href="#A4.Thmtheorem2" title="Lemma D.2 (Sandwich-exclusion). ‣ The exhaustive generator and the separation () ‣ Appendix D Deferred Proofs" class="ltx_ref" style="font-size:70%;"><span class="ltx_text ltx_ref_tag">Lemma</span> <span class="ltx_text ltx_ref_tag">D.2</span></a><span id="S3.F2.pic1.15" class="ltx_text" style="font-size:70%;">).</span></span></span></foreignObject></g></g></g></g><g></g><g style="--ltx-stroke-color:#4D4D1F;--ltx-fill-color:#E8E8BE;" fill="#E8E8BE" stroke="#4D4D1F"><path d="M 19.69 0 M 19.69 2.08 L 19.69 15.64 C 19.69 16.79 20.61 17.72 21.76 17.72 L 234.14 17.72 C 235.29 17.72 236.22 16.79 236.22 15.64 L 236.22 2.08 C 236.22 0.93 235.29 0 234.14 0 L 21.76 0 C 20.61 0 19.69 0.93 19.69 2.08 Z M 236.22 17.72"></path></g><g></g><g><defs><pattern id="pgfupat20" href="#pgfpat3"><g style="--ltx-stroke-color:#FF7373;--ltx-fill-color:#FF7373;" fill="#FF7373" stroke="#FF7373"><use href="#pgfsym3"></use></g></pattern></defs></g><g style="--ltx-stroke-color:#FF9999;--ltx-fill-color:#000000;" fill="#000000" stroke="#FF9999"><path d="M 236.22 0 M 236.22 2.08 L 236.22 15.64 C 236.22 16.79 237.15 17.72 238.3 17.72 L 431 17.72 C 432.14 17.72 433.07 16.79 433.07 15.64 L 433.07 2.08 C 433.07 0.93 432.14 0 431 0 L 238.3 0 C 237.15 0 236.22 0.93 236.22 2.08 Z M 433.07 17.72"></path></g><g style="--ltx-stroke-color:#000000;--ltx-fill-color:#000000;" fill="#000000" stroke="#000000" transform="matrix(1.0 0.0 0.0 1.0 445.83 6.5)"><foreignObject style="--ltx-fo-width:5.46em;--ltx-fo-height:0.6em;--ltx-fo-depth:0.17em;font-size:7.97pt;" height="8.5" overflow="visible" transform="matrix(1 0 0 -1 0 6.62)" width="60.22"><span class="ltx_foreignobject_container"><span class="ltx_foreignobject_content"><math id="S3.F2.pic1.m13" class="ltx_Math" alttext="H_{1}" display="inline" intent=":literal"><semantics><msub><mi mathsize="0.700em">H</mi><mn mathsize="0.700em">1</mn></msub><annotation encoding="application/x-tex">H_{1}</annotation></semantic