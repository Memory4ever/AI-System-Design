<td id="A6.SS0.SSS0.Px2.p2.1.7.5" class="ltx_td ltx_nopad_r ltx_align_left ltx_border_bb"><math id="A6.SS0.SSS0.Px2.m29" class="ltx_Math" alttext="0" display="inline" intent=":literal"><semantics><mn>0</mn><annotation encoding="application/x-tex">0</annotation></semantics></math></td></tr>
