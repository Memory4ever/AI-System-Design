<td id="A6.SS0.SSS0.Px2.p2.1.5.5" class="ltx_td ltx_nopad_r ltx_align_left"><math id="A6.SS0.SSS0.Px2.m20" class="ltx_Math" alttext="1-\alpha=0.6667" display="inline" intent=":literal"><semantics><mrow><mrow><mn>1</mn><mo>−</mo><mi>α</mi></mrow><mo>=</mo><mn>0.6667</mn></mrow><annotation encoding="application/x-tex">1-\alpha=0.6667</annotation></semantics></math></td></tr>
<tr id="A6.SS0.SSS0.Px2.p2.1.6" class="ltx_tr">
<td id="A6.SS0.SSS0.Px2.p2.1.6.1" class="ltx_td ltx_align_left ltx_border_t"><math id="A6.SS0.SSS0.Px2.m21" class="ltx_Math" alttext="G^{*}" display="inline" intent=":literal"><semantics><msup><mi>G</mi><mo>∗</mo></msup><annotation encoding="application/x-tex">G^{*}</annotation></semantics></math> trivia</td>
<td id="A6.SS0.SSS0.Px2.p2.1.6.2" class="ltx_td ltx_align_left ltx_border_t"><math id="A6.SS0.SSS0.Px2.m22" class="ltx_Math" alttext="K" display="inline" intent=":literal"><semantics><mi>K</mi><annotation encoding="application/x-tex">K</annotation></semantics></math></td>
