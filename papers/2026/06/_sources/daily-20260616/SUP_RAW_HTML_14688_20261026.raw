mrow><annotation encoding="application/x-tex">K[10]</annotation></semantics></math></span></span></foreignObject></g><g style="--ltx-fill-color:#FFC7C7;" fill="#FFC7C7"><path d="M 337.8 0 M 337.8 0 L 337.8 24.41 L 366.14 24.41 L 366.14 0 Z M 366.14 24.41"></path></g><g style="--ltx-stroke-color:#000000;--ltx-fill-color:#000000;" fill="#000000" stroke="#000000" transform="matrix(1.0 0.0 0.0 1.0 340.3 10.47)"><foreignObject style="--ltx-fo-width:2.29em;--ltx-fo-height:0.51em;--ltx-fo-depth:0.17em;font-size:7.36pt;" height="6.92" overflow="visible" transform="matrix(1 0 0 -1 0 5.19)" width="23.34"><span class="ltx_foreignobject_container"><span class="ltx_foreignobject_content"><math id="S3.F4.pic1.m11" class="ltx_Math" alttext="K[11]" display="inline" intent=":literal"><semantics><mrow><mi mathsize="0.500em">K</mi><mo>⁡</mo><mrow><mo maxsize="0.500em" minsize="0.500em">[</mo><mn mathsize="0.500em">11</mn><mo maxsize="0.500em" minsize="0.500em">]</mo></mrow></mrow><annotation encoding="application/x-tex">K[11]</annotation></semantics></math></span></span></foreignObject></g><g style="--ltx-fill-color:#C7C7FF;" fill="#C7C7FF"><path d="M 368.5 0 M 368.5 0 L 368.5 24.41 L 396.85 24.41 L 396.85 0 Z M 396.85 24.41"></path></g><g style="--ltx-stroke-color:#000000;--ltx-fill-color:#000000;" fill="#000000" stroke="#000000" transform="matrix(1.0 0.0 0.0 1.0 371.01 10.47)"><foreignObject style="--ltx-fo-width:2.29em;--ltx-fo-height:0.51em;--ltx-fo-depth:0.17em;font-size:7.36pt;" height="6.92" overflow="visible" transform="matrix(1 0 0 -1 0 5.19)" width="23.34"><span class="ltx_foreignobject_container"><span class="ltx_foreignobject_content"><math id="S3.F4.pic1.m12" class="ltx_Math" alttext="K[12]" display="inline" intent=":literal"><semantics><mrow><mi mathsize="0.500em">K</mi><mo>⁡</mo><mrow><mo maxsize="0.500em" minsize="0.500em">[</mo><mn mathsize="0.500em">12</mn><mo maxsize="0.500em" minsize="0.500em">]</mo></mrow></mrow><annotation encoding="application/x-tex">K[12]</annotation></semantics></math></span></span></foreignObject></g><g style="--ltx-fill-color:#FFC7C7;" fill="#FFC7C7"><path d="M 399.21 0 M 399.21 0 L 399.21 24.41 L 427.56 24.41 L 427.56 0 Z M 427.56 24.41"></path></g><g style="--ltx-stroke-color:#000000;--ltx-fill-color:#000000;" fill="#000000" stroke="#000000" transform="matrix(1.0 0.0 0.0 1.0 401.72 10.47)"><foreignObject style="--ltx-fo-width:2.29em;--ltx-fo-height:0.51em;--ltx-fo-depth:0.17em;font-size:7.36pt;" height="6.92" overflow="visible" transform="matrix(1 0 0 -1 0 5.19)" width="23.34"><span class="ltx_foreignobject_container"><span class="ltx_foreignobject_content"><math id="S3.F4.pic1.m13" class="ltx_Math" alttext="K[13]" display="inline" intent=":literal"><semantics><mrow><mi mathsize="0.500em">K</mi><mo>⁡</mo><mrow><mo maxsize="0.500em" minsize="0.500em">[</mo><mn mathsize="0.500em">13</mn><mo maxsize="0.500em" minsize="0.500em">]</mo></mrow></mrow><annotation encoding="application/x-tex">K[13]</annotation></semantics></math></span></span></foreignObject></g><g style="--ltx-fill-color:#C7C7FF;" fill="#C7C7FF"><path d="M 429.92 0 M 429.92 0 L 429.92 24.41 L 458.27 24.41 L 458.27 0 Z M 458.27 24.41"></path></g><g style="--ltx-stroke-color:#000000;--ltx-fill-color:#000000;" fill="#000000" stroke="#000000" transform="matrix(1.0 0.0 0.0 1.0 432.42 10.47)"><foreignObject style="--ltx-fo-width:2.29em;--ltx-fo-height:0.51em;--ltx-fo-depth:0.17em;font-size:7.36pt;" height="6.92" overflow="visible" transform="matrix(1 0 0 -1 0 5.19)" width="23.34"><span class="ltx_foreignobject_container"><span class="ltx_foreignobject_content"><math id="S3.F4.pic1.m14" class="ltx_Math" alttext="K[14]" display="inline" intent=":literal"><semantics><mrow><mi mathsize="0.500em">K</mi><mo>⁡</mo><mrow><mo maxsize="0.500em" minsize="0.500em">[</mo><mn mathsize="0.500em">14</mn><mo maxsize="0.500em" minsize="0.500em">]</mo></mrow></mrow><annotation encoding="application/x-tex">K[14]</annotation></semantics></math></span></span></foreignObject></g><g style="--ltx-stroke-color:#990000;--ltx-fill-color:#990000;--ltx-fg-color:#990000;" color="#990000" fill="#990000" stroke="#990000" transform="matrix(1.0 0.0 0.0 1.0 35.6 53.48)"><foreignObject style="--ltx-fg-color:#000000;--ltx-fo-width:25.05em;--ltx-fo-height:0.61em;--ltx-fo-depth:0.17em;font-size:7.97pt;" color="#000000" height="8.61" overflow="visible" transform="matrix(1 0 0 -1 0 6.73)" width="276.29"><span class="ltx_foreignobject_container"><span class="ltx_foreignobject_content"><span id="S3.F4.pic1.1" class="ltx_text" style="font-size:70%;--ltx-fg-color:#990000;">adversary <math id="S3.F4.pic1.m15" class="ltx_Math" alttext="A_{K}" display="inline" intent=":literal"><semantics><msub><mi style="--ltx-fg-color:#990000;" mathcolor="#990000">A</mi><mi style="--ltx-fg-color:#990000;" mathcolor="#990000">K</mi></msub><annotation encoding="application/x-tex">A_{K}</annotation></semantics></math>: enumerates the least <em id="S3.F4.pic1.1.1" class="ltx_emph ltx_font_italic">unused</em> element, one per round</span></span></span></foreignObject></g><g style="--ltx-stroke-color:#000099;--ltx-fill-color:#000099;--ltx-fg-color:#000099;" color="#000099" fill="#000099" stroke="#000099" transform="matrix(1.0 0.0 0.0 1.0 35.6 39.31)"><foreignObject style="--ltx-fg-color:#000000;--ltx-fo-width:27.53em;--ltx-fo-height:0.61em;--ltx-fo-depth:0.17em;font-size:7.97pt;" color="#000000" height="8.61" overflow="visible" transform="matrix(1 0 0 -1 0 6.73)" width="303.72"><span class="ltx_foreignobject_container"><span class="ltx_foreignobject_content"><span id="S3.F4.pic1.2" class="ltx_text" style="font-size:70%;--ltx-fg-color:#000099;">generator: outputs the least unused element of <math id="S3.F4.pic1.m16" class="ltx_Math" alttext="K" display="inline" intent=":literal"><semantics><mi style="--ltx-fg-color:#000099;" mathcolor="#000099">K</mi><annotation encoding="application/x-tex">K</annotation></semantics></math>, one per round</span></span></span></foreignObject></g><g style="--ltx-stroke-color:#990000;--ltx-fill-color:#990000;--ltx-fg-color:#990000;" color="#990000" fill="#990000" stroke="#990000" stroke-width="1.2pt"><path style="fill:none" d="M 92.13 -2.36 M 92.13 -2.36 L 92.13 26.77 L 120.47 26.77 L 120.47 -2.36 Z M 120.47 26.77"></path></g><g style="--ltx-stroke-color:#990000;--ltx-fill-color:#990000;--ltx-fg-color:#990000;" color="#990000" fill="#990000" stroke="#990000"><path style="fill:none" d="M 133.86 -24.41 L 117.27 -7.82"></path></g><g style="--ltx-stroke-color:#990000;--ltx-fill-color:#990000;--ltx-fg-color:#990000;" color="#990000" fill="#990000" stroke="#990000" stroke-dasharray="none" stroke-dashoffset="0.0pt" stroke-linejoin="miter" transform="matrix(-0.7071 0.7071 -0.7071 -0.7071 118.87 -9.42)"><path d="M 5.9 0 L 0.89 1.87 L 2.4 0 L 0.89 -1.87 Z"></path></g><g style="--ltx-stroke-color:#800000;--ltx-fill-color:#800000;--ltx-fg-color:#800000;" color="#800000" fill="#800000" stroke="#800000" transform="matrix(1.0 0.0 0.0 1.0 141.11 -32.9)"><g class="ltx_tikzmatrix" transform="matrix(1 0 0 -1 0 18.66)"><g class="ltx_tikzmatrix_row" transform="matrix(1 0 0 1 0 7.1)"><g class="ltx_tikzmatrix_col ltx_nopad_l ltx_nopad_r" transform="matrix(1 0 0 -1 0 0)"><foreignObject style="--ltx-fo-width:23.58em;--ltx-fo-height:0.61em;--ltx-fo-depth:0.17em;font-size:7.97pt;" height="8.61" overflow="visible" transform="matrix(1 0 0 -1 0 6.73)" width="260.06"><span class="ltx_foreignobject_container"><span class="ltx_foreignobject_content"><span id="S3.F4.pic1.3" class="ltx_text" style="font-size:70%;">at rounds </span><math id="S3.F4.pic1.m17" class="ltx_Math" alttext="t=2^{n}" display="inline" intent=":literal"><semantics><mrow><mi mathsize="0.700em">t</mi><mo mathsize="0.700em">=</mo><msup><mn mathsize="0.700em">2</mn><mi mathsize="0.700em">n</mi></msup></mrow><annotation encoding="application/x-tex">t=2^{n}</annotation></semantics></math><span id="S3.F4.pic1.4" class="ltx_text" style="font-size:70%;">: re-enumerate a generator-claimed element</span></span></span></foreignObject></g></g><g class="ltx_tikzmatrix_row" transform="matrix(1 0 0 1 0 16.24)"><g class="ltx_tikzmatrix_col ltx_nopad_l ltx_nopad_r" transform="matrix(1 0 0 -1 0 0)"><foreignObject style="--ltx-fo-width:20.47em;--ltx-fo-height:0.66em;--ltx-fo-depth:0.22em;font-size:7.97pt;" height="9.69" overflow="visible" transform="matrix(1 0 0 -1 0 7.26)" width="225.77"><span class="ltx_foreignobject_container"><span class="ltx_foreignobject_content"><span id="S3.F4.pic1.5" class="ltx_text" style="font-size:70%;">(keeps the enumeration complete; only </span><math id="S3.F4.pic1.m18" class="ltx_Math" alttext="O(\log)" display="inline" intent=":literal"><semantics><mrow><mi mathsize="0.700em">O</mi><mo>⁡</mo><mrow><mo maxsize="0.700em" minsize="0.700em">(</mo><mi mathsize="0.700em">log</mi><mo maxsize="0.700em" minsize="0.700em">)</mo></mrow></mrow><annotation encoding="application/x-tex">O(\log)</annotation></semantics></math><span id="S3.F4.pic1.6" class="ltx_text" style="font-size:70%;"> many)</span></span></span></foreignObject></g></g></g></g><path style="fill:none" d="M 30.71 -50.39 M 30.71 -50.39 C 31.75 -52.47 34.17 -53.85 37.63 -53.85 L 238.75 -53.85 C 242.21 -53.85 244.63 -55.24 245.67 -57.31 C 246.71 -55.24 249.13 -53.85 252.59 -53.85 L 453.71 -53.85 C 457.17 -53.85 459.59 -52.47 460.63 -50.39"></path><g style="--ltx-stroke-color:#000000;--ltx-fill-color:#000000;" fill="#000000" stroke="#000000" transform="matrix(1.0 0.0 0.0 1.0 53.54 -71.21)"><foreignObject style="--ltx-fo-width:25.61em;--ltx-fo-height:0.66em;--ltx-fo-depth:0.22em;font-size:7.97pt;" height="9.69" overflow="visible" transform="matrix(1 0 0 -1 0 7.26)" width="282.48"><span class="ltx_foreignobject_container"><span class="ltx_foreignobject_content"><span id="S3.F4.pic1.7" class="ltx_text" style="font-size:70%;">every prefix </span><math id="S3.F4.pic1.m19" class="ltx_Math" alttext="K[1\!\dots\!M]" display="inline" intent=":literal"><semantics><mrow><mi mathsize="0.700em">K</mi><mo>⁡</mo><mrow><mo maxsize="0.700em" minsize="0.700em">[</mo><mrow><mpadded style="width:0.630em;" width="0.630em"><mi mathsize="0.700em" mathvariant="normal">…</mi></mpadded><mo lspace="0em" rspace="0em">​</mo><mi mathsize="0.700em">M</mi></mrow><mo maxsize="0.700em" minsize="0.700em">]</mo></mrow></mrow><annotation encoding="application/x-tex">K[1\!\dots\!M]</annotation></semantics></math><span id="S3.F4.pic1.8" class="ltx_text" style="font-size:70%;"> splits </span><math id="S3.F4.pic1.m20" class="ltx_Math" alttext="\tfrac{M}{2}\pm O(\log M)" display="inline" intent=":literal"><semantics><mrow><mfrac><mi mathsize="0.700em">M</mi><mn mathsize="0.700em">2</mn></mfrac><mo mathsize="0.700em">±</mo><mrow><mi mathsize="0.700em">O</mi><mo>⁡</mo><mrow><mo maxsize="0.700em" minsize="0.700em">(</mo><mrow><mi mathsize="0.700em">log</mi><mo lspace="0.167em">⁡</mo><mi mathsize="0.700em">M</mi></mrow><mo maxsize="0.700em" minsize="0.700em">)</mo></mrow></mrow></mrow><annotation encoding="application/x-tex">\tfrac{M}{2}\pm O(\log M)</annotation></semantics></math><span id="S3.F4.pic1.9" class="ltx_text" style="font-size:70%;"> each:
the cap (R2) and the share (R1)</span></span></span></foreignObject></g><g style="--ltx-stroke-color:#808080;--ltx-fill-color:#808080;--ltx-fg-color:#808080;" color="#808080" fill="#808080" stroke="#808080" transform="matrix(1.0 0.0 0.0 1.0 473.78 10.47)"><foreignObject style="--ltx-fg-color:#000000;--ltx-fo-width:0.51em;--ltx-fo-height:0.48em;--ltx-fo-depth:0.14em;font-size:7.36pt;" color="#000000" height="6.23" overflow="visible" transform="matrix(1 0 0 -1 0 4.84)" width="5.19"><span class="ltx_foreignobject_container"><span class="ltx_foreignobject_content"><math id="S3.F4.pic1.m21" class="ltx_Math" alttext="\cdots" display="inline" intent=":literal"><semantics><mo style="--ltx-fg-color:#808080;" mathcolor="#808080" mathsize="0.500em">⋯</mo><annotation encoding="application/x-tex">\cdots</annotation></semantics></math></span></span></foreignObject></g></g></svg></span>
<figcaption class="ltx_caption ltx_centering"><span class="ltx_tag ltx_tag_figure"><span id="S3.F4.3" class="ltx_text" style="font-size:90%;">Figure 4</span>: </span><span id="S3.F4.4" class="ltx_text" style="font-size:90%;">The race on the canonical order of <math id="S3.F4.m5" class="ltx_Math" alttext="K" display="inline" intent=":literal"><semantics><mi>K</mi><annotation encoding="application/x-tex">K</annotation></semantics></math> (<a href="#S3.Thmtheorem5" title="Lemma 3.5 (Race lemma). ‣ The tight family. ‣ The trivia phase transition ‣ Main Results" class="ltx_ref"><span class="ltx_text ltx_ref_tag">Lemma</span> <span class="ltx_text ltx_ref_tag">3.5</span></a>). Each round
the adversary enumerates one element and the generator outputs one, so every
prefix splits roughly in half: no generator beats <math id="S3.F4.m6" class="ltx_Math" alttext="1/2" display="inline" intent=":literal"><semantics><mrow><mn>1</mn><mo>/</mo><mn>2</mn></mrow><annotation encoding="application/x-tex">1/2</annotation></semantics></math> on a raced core (R2),
and the greedy racer secures <math id="S3.F4.m7" class="ltx_Math" alttext="1/2" display="inline" intent=":literal"><semantics><mrow><mn>1</mn><mo>/</mo><mn>2</mn></mrow><annotation encoding="application/x-tex">1/2</annotation></semantics></math> against every enumeration (R1). The
power-of-two recycling steps keep the adversary’s stream a legal full
enumeration at a cost of <math id="S3.F4.m8" class="ltx_Math" alttext="O(\log M)" display="inline" intent=":literal"><semantics><mrow><mi>O</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mrow><mi>log</mi><mo lspace="0.167em">⁡</mo><mi>M</mi></mrow><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">O(\log M)</annotation></semantics></math> per prefix.</span></figcaption>
</figure>
<div id="S3.SS3.SSS0.Px1.p4" class="ltx_para">
<p id="S3.SS3.SSS0.Px1.p4.1" class="ltx_p">The race lemma drives the impossibility side of the dichotomy. It establishes that on <math id="S3.SS3.SSS0.Px1.p4.m1" class="ltx_Math" alttext="\mathcal{H}_{\alpha}" display="inline" intent=":literal"><semantics><msub><mi class="ltx_font_mathcaligraphic">ℋ</mi><mi>α</mi></msub><annotation encoding="application/x-tex">\mathcal{H}_{\alpha}</annotation></semantics></math>
no generator can exceed <math id="S3.SS3.SSS0.Px1.p4.m2" class="ltx_Math" alttext="1-\alpha/2" display="inline" intent=":literal"><semantics><mrow><mn>1</mn><mo>−</mo><mrow><mi>α</mi><mo>/</mo><mn>2</mn></mrow></mrow><annotation encoding="application/x-tex">1-\alpha/2</annotation></semantics></math> in coverage, and that a generator confined to finitely
many trivia cannot exceed <math id="S3.SS3.SSS0.Px1.p4.m3" class="ltx_Math" alttext="\alpha/2" display="inline" intent=":literal"><semantics><mrow><mi>α</mi><mo>/</mo><mn>2</mn></mrow><annotation encoding="application/x-tex">\alpha/2</annotation></semantics></math>.</p>
</div>
<div id="S3.Thmtheorem6" class="ltx_theorem ltx_theorem_theorem">
<h6 class="ltx_title ltx_runin ltx_title_theorem"><span class="ltx_tag ltx_tag_theorem"><span id="S3.Thmtheorem6.2" class="ltx_text ltx_font_bold">Theorem 3.6</span></span><span id="S3.Thmtheorem6.3" class="ltx_text ltx_font_bold"> </span>(Impossibility side of the dichotomy)<span id="S3.Thmtheorem6.4" class="ltx_text ltx_font_bold">.</span></h6>
<div id="S3.Thmtheorem6.p1" class="ltx_para">
<p id="S3.Thmtheorem6.p1.1" class="ltx_p"><span id="S3.Thmtheorem6.p1.1.1" class="ltx_text ltx_font_italic">On the tight family <math id="S3.Thmtheorem6.p1.m1" class="ltx_Math" alttext="\mathcal{H}_{\alpha}" display="inline" intent=":literal"><semantics><msub><mi class="ltx_font_mathcaligraphic">ℋ</mi><mi>α</mi></msub><annotation encoding="application/x-tex">\mathcal{H}_{\alpha}</annotation></semantics></math> of (<a href="#S3.E1" title="Equation 3.1 ‣ The tight family. ‣ The trivia phase transition ‣ Main Results" class="ltx_ref"><span class="ltx_text ltx_ref_tag">3.1</span></a>), with deterministic element-based generators
and limit-set coverage:</span></p>
<ol id="S3.I4" class="ltx_enumerate" style="--ltx-enum-leftmargin:2.2em;">
<li id="S3.I4.i1" class="ltx_item" style="list-style-type:none;"><span class="ltx_tag ltx_tag_item">(a)</span> 
<div id="S3.I4.i1.p1" class="ltx_para">
<p id="S3.I4.i1.p1.1" class="ltx_p"><span id="S3.I4.i1.p1.1.1" class="ltx_text">(Race cap)</span><span id="S3.I4.i1.p1.1.2" class="ltx_text ltx_font_italic"> For every deterministic generator there are two legal instances of
</span><math id="S3.I4.i1.p1.m1" class="ltx_Math" alttext="\mathcal{H}_{\alpha}" display="inline" intent=":literal"><semantics><msub><mi class="ltx_font_mathcaligraphic">ℋ</mi><mi>α</mi></msub><annotation encoding="application/x-tex">\mathcal{H}_{\alpha}</annotation></semantics></math><span id="S3.I4.i1.p1.1.3" class="ltx_text ltx_font_italic"> sharing one transcript (the adversary is </span><math id="S3.I4.i1.p1.m2" class="ltx_Math" alttext="A_{K}" display="inline" intent=":literal"><semantics><msub><mi>A</mi><mi>K</mi></msub><annotation encoding="application/x-tex">A_{K}</annotation></semantics></math><span id="S3.I4.i1.p1.1.4" class="ltx_text ltx_font_italic"> inside </span><math id="S3.I4.i1.p1.m3" class="ltx_Math" alttext="K" display="inline" intent=":literal"><semantics><mi>K</mi><annotation encoding="application/x-tex">K</annotation></semantics></math><span id="S3.I4.i1.p1.1.5" class="ltx_text ltx_font_italic">), with coverage at most
</span><math id="S3.I4.i1.p1.m4" class="ltx_Math" alttext="1/2" display="inline" intent=":literal"><semantics><mrow><mn>1</mn><mo>/</mo><mn>2</mn></mrow><annotation encoding="application/x-tex">1/2</annotation></semantics></math><span id="S3.I4.i1.p1.1.6" class="ltx_text ltx_font_italic"> at truth </span><math id="S3.I4.i1.p1.m5" class="ltx_Math" alttext="K" display="inline" intent=":literal"><semantics><mi>K</mi><annotation encoding="application/x-tex">K</annotation></semantics></math><span id="S3.I4.i1.p1.1.7" class="ltx_text ltx_font_italic"> and at most </span><math id="S3.I4.i1.p1.m6" class="ltx_Math" alttext="1-\alpha/2" display="inline" intent=":literal"><semantics><mrow><mn>1</mn><mo>−</mo><mrow><mi>α</mi><mo>/</mo><mn>2</mn></mrow></mrow><annotation encoding="application/x-tex">1-\alpha/2</annotation></semantics></math><span id="S3.I4.i1.p1.1.8" class="ltx_text ltx_font_italic"> at truth </span><math id="S3.I4.i1.p1.m7" class="ltx_Math" alttext="K^{\prime}" display="inline" intent=":literal"><semantics><msup><mi>K</mi><mo>′</mo></msup><annotation encoding="application/x-tex">K^{\prime}</annotation></semantics></math><span id="S3.I4.i1.p1.1.9" class="ltx_text ltx_font_italic"> (revealed core </span><math id="S3.I4.i1.p1.m8" class="ltx_Math" alttext="C=K" display="inline" intent=":literal"><semantics><mrow><mi>C</mi><mo>=</mo><mi>K</mi></mrow><annotation encoding="application/x-tex">C=K</annotation></semantics></math><span id="S3.I4.i1.p1.1.10" class="ltx_text ltx_font_italic">,
density </span><math id="S3.I4.i1.p1.m9" class="ltx_Math" alttext="\alpha" display="inline" intent=":literal"><semantics><mi>α</mi><annotation encoding="application/x-tex">\alpha</annotation></semantics></math><span id="S3.I4.i1.p1.1.11" class="ltx_text ltx_font_italic">). Hence no generator guarantees coverage exceeding </span><math id="S3.I4.i1.p1.m10" class="ltx_Math" alttext="1-\alpha/2" display="inline" intent=":literal"><semantics><mrow><mn>1</mn><mo>−</mo><mrow><mi>α</mi><mo>/</mo><mn>2</mn></mrow></mrow><annotation encoding="application/x-tex">1-\alpha/2</annotation></semantics></math><span id="S3.I4.i1.p1.1.12" class="ltx_text ltx_font_italic"> on
</span><math id="S3.I4.i1.p1.m11" class="ltx_Math" alttext="\mathcal{H}_{\alpha}" display="inline" intent=":literal"><semantics><msub><mi class="ltx_font_mathcaligraphic">ℋ</mi><mi>α</mi></msub><annotation encoding="application/x-tex">\mathcal{H}_{\alpha}</annotation></semantics></math><span id="S3.I4.i1.p1.1.13" class="ltx_text ltx_font_italic">, nor exceeding </span><math id="S3.I4.i1.p1.m12" class="ltx_Math" alttext="1/2" display="inline" intent=":literal"><semantics><mrow><mn>1</mn><mo>/</mo><mn>2</mn></mrow><annotation encoding="application/x-tex">1/2</annotation></semantics></math><span id="S3.I4.i1.p1.1.14" class="ltx_text ltx_font_italic"> at truth </span><math id="S3.I4.i1.p1.m13" class="ltx_Math" alttext="K" display="inline" intent=":literal"><semantics><mi>K</mi><annotation encoding="application/x-tex">K</annotation></semantics></math><span id="S3.I4.i1.p1.1.15" class="ltx_text ltx_font_italic">.</span></p>
</div></li>
<li id="S3.I4.i2" class="ltx_item" style="list-style-type:none;"><span class="ltx_tag ltx_tag_item">(b)</span> 
<div id="S3.I4.i2.p1" class="ltx_para">
<p id="S3.I4.i2.p1.1" class="ltx_p"><span id="S3.I4.i2.p1.1.1" class="ltx_text">(Finite-trivia cap)</span><span id="S3.I4.i2.p1.1.2" class="ltx_text ltx_font_italic"> Every deterministic generator that emits finitely many
trivia on every legal instance has coverage at most </span><math id="S3.I4.i2.p1.m1" class="ltx_Math" alttext="\alpha/2" display="inline" intent=":literal"><semantics><mrow><mi>α</mi><mo>/</mo><mn>2</mn></mrow><annotation encoding="application/x-tex">\alpha/2</annotation></semantics></math><span id="S3.I4.i2.p1.1.3" class="ltx_text ltx_font_italic"> on the truth-</span><math id="S3.I4.i2.p1.m2" class="ltx_Math" alttext="K^{\prime}" display="inline" intent=":literal"><semantics><msup><mi>K</mi><mo>′</mo></msup><annotation encoding="application/x-tex">K^{\prime}</annotation></semantics></math><span id="S3.I4.i2.p1.1.4" class="ltx_text ltx_font_italic"> racing
instance.</span></p>
</div></li>
<li id="S3.I4.i3" class="ltx_item" style="list-style-type:none;"><span class="ltx_tag ltx_tag_item">(c)</span> 
<div id="S3.I4.i3.p1" class="ltx_para">
<p id="S3.I4.i3.p1.1" class="ltx_p"><span id="S3.I4.i3.p1.1.1" class="ltx_text">(Necessity of trivia)</span><span id="S3.I4.i3.p1.1.2" class="ltx_text ltx_font_italic"> Any generator guaranteeing coverage exceeding
</span><math id="S3.I4.i3.p1.m1" class="ltx_Math" alttext="\alpha/2" display="inline" intent=":literal"><semantics><mrow><mi>α</mi><mo>/</mo><mn>2</mn></mrow><annotation encoding="application/x-tex">\alpha/2</annotation></semantics></math><span id="S3.I4.i3.p1.1.3" class="ltx_text ltx_font_italic"> on all of </span><math id="S3.I4.i3.p1.m2" class="ltx_Math" alttext="\mathcal{H}_{\alpha}" display="inline" intent=":literal"><semantics><msub><mi class="ltx_font_mathcaligraphic">ℋ</mi><mi>α</mi></msub><annotation encoding="application/x-tex">\mathcal{H}_{\alpha}</annotation></semantics></math><span id="S3.I4.i3.p1.1.4" class="ltx_text ltx_font_italic"> emits infinitely many trivia on some instance; with
</span><a href="#S3.Thmtheorem7" title="Theorem 3.7 (Achievability side: sweep and the tight generator). ‣ The tight family. ‣ The trivia phase transition ‣ Main Results" class="ltx_ref ltx_font_italic"><span class="ltx_text ltx_ref_tag">Theorem</span> <span class="ltx_text ltx_ref_tag">3.7</span></a><span id="S3.I4.i3.p1.1.5" class="ltx_text">(iii)</span><span id="S3.I4.i3.p1.1.6" class="ltx_text ltx_font_italic">, </span><math id="S3.I4.i3.p1.m3" class="ltx_Math" alttext="\alpha/2" display="inline" intent=":literal"><semantics><mrow><mi>α</mi><mo>/</mo><mn>2</mn></mrow><annotation encoding="application/x-tex">\alpha/2</annotation></semantics></math><span id="S3.I4.i3.p1.1.7" class="ltx_text ltx_font_italic"> is exactly the finite-trivia frontier.</span></p>
</div></li>
</ol>
</div>
</div>
<div id="S3.SS3.SSS0.Px1.p5" class="ltx_para">
<p id="S3.SS3.SSS0.Px1.p5.1" class="ltx_p">The caps bind per instance for every generator; no adaptivity to the realized truth is used,
and the per-prefix forms with explicit constants appear in the proofs. The remaining
sparse-core dodge (a singleton-core variant) is left open.</p>
</div>
<div id="S3.SS3.SSS0.Px1.2" class="ltx_proof">
<h6 class="ltx_title ltx_runin ltx_font_italic ltx_title_proof">Proof sketch.</h6>
<div id="S3.SS3.SSS0.Px1.p6" class="ltx_para">
<p id="S3.SS3.SSS0.Px1.p6.1" class="ltx_p"><span id="S3.SS3.SSS0.Px1.p6.1.1" class="ltx_text">Run any generator against <math id="S3.SS3.SSS0.Px1.p6.m1" class="ltx_Math" alttext="A_{K}" display="inline" intent=":literal"><semantics><msub><mi>A</mi><mi>K</mi></msub><annotation encoding="application/x-tex">A_{K}</annotation></semantics></math> (<a href="#S3.F5" title="In The tight family. ‣ The trivia phase transition ‣ Main Results" class="ltx_ref"><span class="ltx_text ltx_ref_tag">Figure</span> <span class="ltx_text ltx_ref_tag">5</span></a>): a single transcript serves both the
truth-<math id="S3.SS3.SSS0.Px1.p6.m2" class="ltx_Math" alttext="K" display="inline" intent=":literal"><semantics><mi>K</mi><annotation encoding="application/x-tex">K</annotation></semantics></math> reading (full enumeration of <math id="S3.SS3.SSS0.Px1.p6.m3" class="ltx_Math" alttext="K" display="inline" intent=":literal"><semantics><mi>K</mi><annotation encoding="application/x-tex">K</annotation></semantics></math>, capped at <math id="S3.SS3.SSS0.Px1.p6.m4" class="ltx_Math" alttext="1/2" display="inline" intent=":literal"><semantics><mrow><mn>1</mn><mo>/</mo><mn>2</mn></mrow><annotation encoding="application/x-tex">1/2</annotation></semantics></math> by <a href="#S3.Thmtheorem5" title="Lemma 3.5 (Race lemma). ‣ The tight family. ‣ The trivia phase transition ‣ Main Results" class="ltx_ref"><span class="ltx_text ltx_ref_tag">Lemma</span> <span class="ltx_text ltx_ref_tag">3.5</span></a>(R2)) and the
truth-<math id="S3.SS3.SSS0.Px1.p6.m5" class="ltx_Math" alttext="K^{\prime}" display="inline" intent=":literal"><semantics><msup><mi>K</mi><mo>′</mo></msup><annotation encoding="application/x-tex">K^{\prime}</annotation></semantics></math> reading (core <math id="S3.SS3.SSS0.Px1.p6.m6" class="ltx_Math" alttext="C=K" display="inline" intent=":literal"><semantics><mrow><mi>C</mi><mo>=</mo><mi>K</mi></mrow><annotation encoding="application/x-tex">C=K</annotation></semantics></math> of exact density <math id="S3.SS3.SSS0.Px1.p6.m7" class="ltx_Math" alttext="\alpha" display="inline" intent=":literal"><semantics><mi>α</mi><annotation encoding="application/x-tex">\alpha</annotation></semantics></math>). For (a) at truth <math id="S3.SS3.SSS0.Px1.p6.m8" class="ltx_Math" alttext="K^{\prime}" display="inline" intent=":literal"><semantics><msup><mi>K</mi><mo>′</mo></msup><annotation encoding="application/x-tex">K^{\prime}</annotation></semantics></math>, split
<math id="S3.SS3.SSS0.Px1.p6.m9" class="ltx_Math" alttext="K^{\prime}[1\!\dots\!N]=K[1\!\dots\!m_{N}]\sqcup(D\cap K^{\prime}[1\!\dots\!N])" display="inline" intent=":literal"><semantics><mrow><mrow><msup><mi>K</mi><mo>′</mo></msup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">[</mo><mrow><mpadded style="width:0.580em;" width="0.580em"><mi mathvariant="normal">…</mi></mpadded><mo lspace="0em" rspace="0em">​</mo><mi>N</mi></mrow><mo stretchy="false">]</mo></mrow></mrow><mo>=</mo><mrow><mrow><mi>K</mi><mo>⁡</mo><mrow><mo stretchy="false">[</mo><mrow><mpadded style="width:0.580em;" width="0.580em"><mi mathvariant="normal">…</mi></mpadded><mo lspace="0em" rspace="0em">​</mo><msub><mi>m</mi><mi>N</mi></msub></mrow><mo stretchy="false">]</mo></mrow></mrow><mo>⊔</mo><mrow><mo stretchy="false">(</mo><mrow><mi>D</mi><mo>∩</mo><mrow><msup><mi>K</mi><mo>′</mo></msup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">[</mo><mrow><mpadded style="width:0.580em;" width="0.580em"><mi mathvariant="normal">…</mi></mpadded><mo lspace="0em" rspace="0em">​</mo><mi>N</mi></mrow><mo stretchy="false">]</mo></mrow></mrow></mrow><mo stretchy="false">)</mo></mrow></mrow></mrow><annotation encoding="application/x-tex">K^{\prime}[1\!\dots\!N]=K[1\!\dots\!m_{N}]\sqcup(D\cap K^{\prime}[1\!\dots\!N])</annotation></semantics></math> with <math id="S3.SS3.SSS0.Px1.p6.m10" class="ltx_Math" alttext="m_{N}=\lfloor\alpha N\rfloor" display="inline" intent=":literal"><semantics><mrow><msub><mi>m</mi><mi>N</mi></msub><mo>=</mo><mrow><mo stretchy="false">⌊</mo><mrow><mi>α</mi><mo lspace="0em" rspace="0em">​</mo><mi>N</mi></mrow><mo stretchy="false">⌋</mo></mrow></mrow><annotation encoding="application/x-tex">m_{N}=\lfloor\alpha N\rfloor</annotation></semantics></math> and cap the <math id="S3.SS3.SSS0.Px1.p6.m11" class="ltx_Math" alttext="K" display="inline" intent=":literal"><semantics><mi>K</mi><annotation encoding="application/x-tex">K</annotation></semantics></math>-part by (R2). For (b), finite trivia at truth <math id="S3.SS3.SSS0.Px1.p6.m12" class="ltx_Math" alttext="K" display="inline" intent=":literal"><semantics><mi>K</mi><annotation encoding="application/x-tex">K</annotation></semantics></math> forces <math id="S3.SS3.SSS0.Px1.p6.m13" class="ltx_Math" alttext="\lvert O\cap D\rvert&lt;\infty" display="inline" intent=":literal"><semantics><mrow><mrow><mo stretchy="false">|</mo><mrow><mi>O</mi><mo>∩</mo><mi>D</mi></mrow><mo stretchy="false">|</mo></mrow><mo>&lt;</mo><mi mathvariant="normal">∞</mi></mrow><annotation encoding="application/x-tex">\lvert O\cap D\rvert&lt;\infty</annotation></semantics></math>, so a density-composition lemma carries the <math id="S3.SS3.SSS0.Px1.p6.m14" class="ltx_Math" alttext="\alpha/2" display="inline" intent=":literal"><semantics><mrow><mi>α</mi><mo>/</mo><mn>2</mn></mrow><annotation encoding="application/x-tex">\alpha/2</annotation></semantics></math> cap to truth <math id="S3.SS3.SSS0.Px1.p6.m15" class="ltx_Math" alttext="K^{\prime}" display="inline" intent=":literal"><semantics><msup><mi>K</mi><mo>′</mo></msup><annotation encoding="application/x-tex">K^{\prime}</annotation></semantics></math>.
Full proof in <a href="#A4.SS4" title="Impossibility side of the dichotomy () ‣ Appendix D Deferred Proofs" class="ltx_ref"><span class="ltx_text ltx_ref_tag">Section</span> <span class="ltx_text ltx_ref_tag">D.4</span></a>.
∎</span></p>
</div>
</div>
<figure id="S3.F5" class="ltx_figure"><span class="ltx_inline-block"><svg id="S3.F5.pic1" class="ltx_picture ltx_centering" height="214.23" overflow="visible" version="1.1" viewBox="0 0 465.51 214.23" width="465.51"><g style="--ltx-stroke-color:#000000;--ltx-fill-color:#000000;" fill="#000000" stroke="#000000" stroke-width="0.4pt" transform="translate(0,214.23) matrix(1 0 0 -1 0 0) translate(18.19,0) translate(0,167.78)"><g style="--ltx-fill-color:#F0F0F0;" fill="#F0F0F0"><path d="M 41.34 0 M 41.34 0 L 41.34 23.62 L 79.92 23.62 L 79.92 0 Z M 79.92 23.62"></path></g><g style="--ltx-stroke-color:#000000;--ltx-fill-color:#000000;" fill="#000000" stroke="#000000" transform="matrix(1.0 0.0 0.0 1.0 54.46 10.42)"><foreignObject style="--ltx-fo-width:1.09em;--ltx-fo-height:0.37em;--ltx-fo-depth:0.12em;font-size:8.19pt;" height="5.55" overflow="visible" transform="matrix(1 0 0 -1 0 4.17)" width="12.35"><span class="ltx_foreignobject_container"><span class="ltx_foreignobject_content"><math id="S3.F5.pic1.m1" class="ltx_Math" alttext="w_{1}" display="inline" intent=":literal"><semantics><msub><mi mathsize="0.700em">w</mi><mn mathsize="0.700em">1</mn></msub><annotation encoding="application/x-tex">w_{1}</annotation></semantics></math></span></span></foreignObject></g><g style="--ltx-fill-color:#F0F0F0;" fill="#F0F0F0"><path d="M 82.68 0 M 82.68 0 L 82.68 23.62 L 121.26 23.62 L 121.26 0 Z M 121.26 23.62"></path></g><g style="--ltx-stroke-color:#000000;--ltx-fill-color:#000000;" fill="#000000" stroke="#000000" transform="matrix(1.0 0.0 0.0 1.0 95.79 10.42)"><foreignObject style="--ltx-fo-width:1.09em;--ltx-fo-height:0.37em;--ltx-fo-depth:0.12em;font-size:8.19pt;" height="5.55" overflow="visible" transform="matrix(1 0 0 -1 0 4.17)" width="12.35"><span class="ltx_foreignobject_container"><span class="ltx_foreignobject_content"><math id="S3.F5.pic1.m2" class="ltx_Math" alttext="w_{2}" display="inline" intent=":literal"><semantics><msub><mi mathsize="0.700em">w</mi><mn mathsize="0.700em">2</mn></msub><annotation encoding="application/x-tex">w_{2}</annotation></semantics></math></span></span></foreignObject></g><g style="--ltx-fill-color:#F0F0F0;" fill="#F0F0F0"><path d="M 124.02 0 M 124.02 0 L 124.02 23.62 L 162.6 23.62 L 162.6 0 Z M 162.6 23.62"></path></g><g style="--ltx-stroke-color:#000000;--ltx-fill-color:#000000;" fill="#000000" stroke="#000000" transform="matrix(1.0 0.0 0.0 1.0 137.13 10.42)"><foreignObject style="--ltx-fo-width:1.09em;--ltx-fo-height:0.37em;--ltx-fo-depth:0.12em;font-size:8.19pt;" height="5.55" overflow="visible" transform="matrix(1 0 0 -1 0 4.17)" width="12.35"><span class="ltx_foreignobject_container"><span class="ltx_foreignobject_content"><math id="S3.F5.pic1.m3" class="ltx_Math" alttext="w_{3}" display="inline" intent=":literal"><semantics><msub><mi mathsize="0.700em">w</mi><mn mathsize="0.700em">3</mn></msub><annotation encoding="application/x-tex">w_{3}</annotation></semantics></math></span></span></foreignObject></g><g style="--ltx-fill-color:#F0F0F0;" fill="#F0F0F0"><path d="M 165.35 0 M 165.35 0 L 165.35 23.62 L 203.94 23.62 L 203.94 0 Z M 203.94 23.62"></path></g><g style="--ltx-stroke-color:#000000;--ltx-fill-color:#000000;" fill="#000000" stroke="#000000" transform="matrix(1.0 0.0 0.0 1.0 178.47 10.42)"><foreignObject style="--ltx-fo-width:1.09em;--ltx-fo-height:0.37em;--ltx-fo-depth:0.12em;font-size:8.19pt;" height="5.55" overflow="visible" transform="matrix(1 0 0 -1 0 4.17)" width="12.35"><span class="ltx_foreignobject_container"><span class="ltx_foreignobject_content"><math id="S3.F5.pic1.m4" class="ltx_Math" alttext="w_{4}" display="inline" intent=":literal"><semantics><msub><mi mathsize="0.700em">w</mi><mn mathsize="0.700em">4</mn></msub><annotation encoding="application/x-tex">w_{4}</annotation></semantics></math></span></span></foreignObject></g><g style="--ltx-fill-color:#F0F0F0;" fill="#F0F0F0"><path d="M 206.69 0 M 206.69 0 L 206.69 23.62 L 245.28 23.62 L 245.28 0 Z M 245.28 23.62"></path></g><g style="--ltx-stroke-color:#000000;--ltx-fill-color:#000000;" fill="#000000" stroke="#000000" transform="matrix(1.0 0.0 0.0 1.0 219.81 10.42)"><foreignObject style="--ltx-fo-width:1.09em;--ltx-fo-height:0.37em;--ltx-fo-depth:0.12em;font-size:8.19pt;" height="5.55" overflow="visible" transform="matrix(1 0 0 -1 0 4.17)" width="12.35"><span class="ltx_foreignobject_container"><span class="ltx_foreignobject_content"><math id="S3.F5.pic1.m5" class="ltx_Math" alttext="w_{5}" display="inline" intent=":literal"><semantics><msub><mi mathsize="0.700em">w</mi><mn mathsize="0.700em">5</mn></msub><annotation encoding="application/x-tex">w_{5}</annotation></semantics></math></span></span></foreignObject></g><g style="--ltx-fill-color:#F0F0F0;" fill="#F0F0F0"><path d="M 248.03 0 M 248.03 0 L 248.03 23.62 L 286.61 23.62 L 286.61 0 Z M 286.61 23.62"></path></g><g style="--ltx-stroke-color:#000000;--ltx-fill-color:#000000;" fill="#000000" stroke="#000000" transform="matrix(1.0 0.0 0.0 1.0 261.15 10.42)"><foreignObject style="--ltx-fo-width:1.09em;--ltx-fo-height:0.37em;--ltx-fo-depth:0.12em;font-size:8.19pt;" height="5.55" overflow="visible" transform="matrix(1 0 0 -1 0 4.17)" width="12.35"><span class="ltx_foreignobject_container"><span class="ltx_foreignobject_content"><math id="S3.F5.pic1.m6" class="ltx_Math" alttext="w_{6}" display="inline" intent=":literal"><semantics><msub><mi mathsize="0.700em">w</mi><mn mathsize="0.700em">6</mn></msub><annotation encoding="application/x-tex">w_{6}</annotation></semantics></math></span></span></foreignObject></g><g style="--ltx-fill-color:#F0F0F0;" fill="#F0F0F0"><path d="M 289.37 0 M 289.37 0 L 289.37 23.62 L 327.95 23.62 L 327.95 0 Z M 327.95 23.62"></path></g><g style="--ltx-stroke-color:#000000;--ltx-fill-color:#000000;" fill="#000000" stroke="#000000" transform="matrix(1.0 0.0 0.0 1.0 302.49 10.42)"><foreignObject style="--ltx-fo-width:1.09em;--ltx-fo-height:0.37em;--ltx-fo-depth:0.12em;font-size:8.19pt;" height="5.55" overflow="visible" transform="matrix(1 0 0 -1 0 4.17)" width="12.35"><span class="ltx_foreignobject_container"><span class="ltx_foreignobject_content"><math id="S3.F5.pic1.m7" class="ltx_Math" alttext="w_{7}" display="inline" intent=":literal"><semantics><msub><mi mathsize="0.700em">w</mi><mn mathsize="0.700em">7</mn></msub><annotation encoding="application/x-tex">w_{7}</annotation></semantics></math></span></span></foreignObject></g><g style="--ltx-fill-color:#F0F0F0;" fill="#F0F0F0"><path d="M 330.71 0 M 330.71 0 L 330.71 23.62 L 369.29 23.62 L 369.29 0 Z M 369.29 23.62"></path></g><g style="--ltx-stroke-color:#000000;--ltx-fill-color:#000000;" fill="#000000" stroke="#000000" transform="matrix(1.0 0.0 0.0 1.0 343.83 10.42)"><foreignObject style="--ltx-fo-width:1.09em;--ltx-fo-height:0.37em;--ltx-fo-depth:0.12em;font-size:8.19pt;" height="5.55" overflow="visible" transform="matrix(1 0 0 -1 0 4.17)" width="12.35"><span class="ltx_foreignobject_container"><span class="ltx_foreignobject_content"><math id="S3.F5.pic1.m8" class="ltx_Math" alttext="w_{8}" display="inline" intent=":literal"><semantics><msub><mi mathsize="0.700em">w</mi><mn mathsize="0.700em">8</mn></msub><annotation encoding="application/x-tex">w_{8}</annotation></semantics></math></span></span></foreignObject></g><g style="--ltx-stroke-color:#808080;--ltx-fill-color:#808080;--ltx-fg-color:#808080;" color="#808080" fill="#808080" stroke="#808080" transform="matrix(1.0 0.0 0.0 1.0 390.07 9.39)"><foreignObject style="--ltx-fg-color:#000000;--ltx-fo-width:0.64em;--ltx-fo-height:0.6em;--ltx-fo-depth:0.17em;font-size:8.19pt;" color="#000000" height="8.72" overflow="visible" transform="matrix(1 0 0 -1 0 6.78)" width="7.26"><span class="ltx_foreignobject_container"><span class="ltx_foreignobject_content"><math id="S3.F5.pic1.m9" class="ltx_Math" alttext="\cdots" display="inline" intent=":literal"><semantics><mo style="--ltx-fg-color:#808080;" mathcolor="#808080" mathsize="0.700em">⋯</mo><annotation encoding="application/x-tex">\cdots</annotation></semantics></math></span></span></foreignObject></g><g style="--ltx-stroke-color:#000000;--ltx-fill-color:#000000;" fill="#000000" stroke="#000000" transform="matrix(1.0 0.0 0.0 1.0 60.21 35.12)"><foreignObject style="--ltx-fo-width:24.53em;--ltx-fo-height:0.61em;--ltx-fo-depth:0.17em;font-size:7.97pt;" height="8.61" overflow="visible" transform="matrix(1 0 0 -1 0 6.73)" width="270.64"><span class="ltx_foreignobject_container"><span class="ltx_foreignobject_content"><span id="S3.F5.pic1.1" class="ltx_text" style="font-size:70%;">one interaction: the racing stream inside <math id="S3.F5.pic1.m10" class="ltx_Math" alttext="K" display="inline" intent=":literal"><semantics><mi>K</mi><annotation encoding="application/x-tex">K</annotation></semantics></math>, one limit set <math id="S3.F5.pic1.m11" class="ltx_Math" alttext="O" display="inline" intent=":literal"><semantics><mi>O</mi><annotation encoding="application/x-tex">O</annotation></semantics></math></span></span></span></foreignObject></g><g stroke-width="0.8pt"><g style="--ltx-stroke-color:#000099;--ltx-fill-color:#000099;--ltx-fg-color:#000099;" color="#000099" fill="#000099" stroke="#000099"><path style="fill:none" d="M 133.86 -7.09 L 98.99 -37.43"></path></g><g style="--ltx-stroke-color:#000099;--ltx-fill-color:#000099;--ltx-fg-color:#000099;" color="#000099" fill="#000099" stroke="#000099" stroke-dasharray="none" stroke-dashoffset="0.0pt" stroke-linejoin="miter" transform="matrix(-0.75444 -0.65637 0.65637 -0.75444 101.38 -35.34)"><path d="M 7.66 0 L 1.79 2.18 L 3.45 0 L 1.79 -2.18 Z"></path></g></g><g stroke-width="0.8pt"><g style="--ltx-stroke-color:#4D4D1F;--ltx-fill-color:#4D4D1F;--ltx-fg-color:#4D4D00;" color="#4D4D00" fill="#4D4D1F" stroke="#4D4D1F"><path style="fill:none" d="M 275.59 -7.09 L 310.46 -37.43"></path></g><g style="--ltx-stroke-color:#4D4D1F;--ltx-fill-color:#4D4D1F;--ltx-fg-color:#4D4D00;" color="#4D4D00" fill="#4D4D1F" stroke="#4D4D1F" stroke-dasharray="none" stroke-dashoffset="0.0pt" stroke-linejoin="miter" transform="matrix(0.75444 -0.65637 0.65637 0.75444 308.07 -35.34)"><path d="M 7.66 0 L 1.79 2.18 L 3.45 0 L 1.79 -2.18 Z"></path></g></g><g style="--ltx-fill-color:#F2F2FF;" fill="#F2F2FF"><path d="M 192.33 -47.52 L 8.46 -47.52 C 5.4 -47.52 2.92 -50 2.92 -53.06 L 2.92 -98.18 C 2.92 -101.24 5.4 -103.71 8.46 -103.71 L 192.33 -103.71 C 195.39 -103.71 197.86 -101.24 197.86 -98.18 L 197.86 -53.06 C 197.86 -50 195.39 -47.52 192.33 -47.52 Z M 2.92 -103.71"></path></g><g style="--ltx-stroke-color:#000000;--ltx-fill-color:#000000;" fill="#000000" stroke="#000000" transform="matrix(1.0 0.0 0.0 1.0 9.84 -61.17)"><foreignObject style="--ltx-fo-width:16.42em;--ltx-fo-height:0.49em;--ltx-fo-depth:2.58em;font-size:10pt;" height="42.36" overflow="visible" transform="matrix(1 0 0 -1 0 6.73)" width="227.21"><span class="ltx_foreignobject_container"><span class="ltx_foreignobject_content">
<span id="S3.F5.pic1.2" class="ltx_inline-block ltx_minipage ltx_align_top" style="width:16.42em;">
<span id="S3.F5.pic1.2.1" class="ltx_p"></span>
<span id="S3.F5.pic1.2.2" class="ltx_p ltx_align_left"><span id="S3.F5.pic1.2.2.1" class="ltx_text ltx_font_bold" style="font-size:70%;">Reading 1: truth <math id="S3.F5.pic1.m12" class="ltx_Math" alttext="K" display="inline" intent=":literal"><semantics><mi>K</mi><annotation encoding="application/x-tex">K</annotation></semantics></math>.
<br class="ltx_break"><math id="S3.F5.pic1.m13" class="ltx_Math" alttext="E" display="inline" intent=":literal"><semantics><mi>E</mi><annotation encoding="application/x-tex">E</annotation></semantics></math><span id="S3.F5.pic1.2.2.1.1" class="ltx_text ltx_font_medium"> is a <em id="S3.F5.pic1.2.2.1.1.1" class="ltx_emph ltx_font_italic">full</em> enumeration of <math id="S3.F5.pic1.m14" class="ltx_Math" alttext="K" display="inline" intent=":literal"><semantics><mi>K</mi><annotation encoding="application/x-tex">K</annotation></semantics></math>.
<br class="ltx_break">Race cap (R2): <math id="S3.F5.pic1.m15" class="ltx_Math" alttext="\overline{d}(O\cap K,K)\leq 1/2" display="inline" intent=":literal"><semantics><mrow><mrow><mover accent="true"><mi>d</mi><mo stretchy="true">¯</mo></mover><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mrow><mi>O</mi><mo>∩</mo><mi>K</mi></mrow><mo>,</mo><mi>K</mi><mo stretchy="false">)</mo></mrow></mrow><mo>≤</mo><mrow><mn>1</mn><mo>/</mo><mn>2</mn></mrow></mrow><annotation encoding="application/x-tex">\overline{d}(O\cap K,K)\leq 1/2</annotation></semantics></math>.</span></span></span>
</span></span></span></foreignObject></g><g style="--ltx-fill-color:#F6F6E5;" fill="#F6F6E5"><path d="M 440.36 -47.52 L 217.12 -47.52 C 214.06 -47.52 211.59 -50 211.59 -53.06 L 211.59 -116 C 211.59 -119.06 214.06 -121.53 217.12 -121.53 L 440.36 -121.53 C 443.42 -121.53 445.9 -119.06 445.9 -116 L 445.9 -53.06 C 445.9 -50 443.42 -47.52 440.36 -47.52 Z M 211.59 -121.53"></path></g><g style="--ltx-stroke-color:#000000;--ltx-fill-color:#000000;" fill="#000000" stroke="#000000" transform="matrix(1.0 0.0 0.0 1.0 218.5 -62.38)"><foreignObject style="--ltx-fo-width:19.98em;--ltx-fo-height:0.57em;--ltx-fo-depth:3.78em;font-size:10pt;" height="60.18" overflow="visible" transform="matrix(1 0 0 -1 0 7.94)" width="276.47"><span class="ltx_foreignobject_container"><span class="ltx_foreignobject_content">
<span id="S3.F5.pic1.3" class="ltx_inline-block ltx_minipage ltx_align_top" style="width:19.98em;">
<span id="S3.F5.pic1.3.1" class="ltx_p"></span>
<span id="S3.F5.pic1.3.2" class="ltx_p ltx_align_left"><span id="S3.F5.pic1.3.2.1" class="ltx_text ltx_font_bold" style="font-size:70%;">Reading 2: truth <math id="S3.F5.pic1.m16" class="ltx_Math" alttext="K^{\prime}" display="inline" intent=":literal"><semantics><msup><mi>K</mi><mo>′</mo></msup><annotation encoding="application/x-tex">K^{\prime}</annotation></semantics></math>.
<br class="ltx_break"><math id="S3.F5.pic1.m17" class="ltx_Math" alttext="E" display="inline" intent=":literal"><semantics><mi>E</mi><annotation encoding="application/x-tex">E</annotation></semantics></math><span id="S3.F5.pic1.3.2.1.1" class="ltx_text ltx_font_medium"> is a <em id="S3.F5.pic1.3.2.1.1.1" class="ltx_emph ltx_font_italic">partial</em> enumeration: core <math id="S3.F5.pic1.m18" class="ltx_Math" alttext="C=K" display="inline" intent=":literal"><semantics><mrow><mi>C</mi><mo>=</mo><mi>K</mi></mrow><annotation encoding="application/x-tex">C=K</annotation></semantics></math>, density <math id="S3.F5.pic1.m19" class="ltx_Math" alttext="\alpha" display="inline" intent=":literal"><semantics><mi>α</mi><annotation encoding="application/x-tex">\alpha</annotation></semantics></math>.
<br class="ltx_break">Cap: <math id="S3.F5.pic1.m20" class="ltx_Math" alttext="c\leq(1-\alpha)+\alpha/2=1-\alpha/2" display="inline" intent=":literal"><semantics><mrow><mi>c</mi><mo>≤</mo><mrow><mrow><mo stretchy="false">(</mo><mrow><mn>1</mn><mo>−</mo><mi>α</mi></mrow><mo stretchy="false">)</mo></mrow><mo>+</mo><mrow><mi>α</mi><mo>/</mo><mn>2</mn></mrow></mrow><mo>=</mo><mrow><mn>1</mn><mo>−</mo><mrow><mi>α</mi><mo>/</mo><mn>2</mn></mrow></mrow></mrow><annotation encoding="application/x-tex">c\leq(1-\alpha)+\alpha/2=1-\alpha/2</annotation></semantics></math>.</span></span></span>
</span></span></span></foreignObject></g><g style="--ltx-stroke-color:#000000;--ltx-fill-color:#000000;" fill="#000000" stroke="#000000" transform="matrix(1.0 0.0 0.0 1.0 -13.58 -159.7)"><g class="ltx_tikzmatrix" transform="matrix(1 0 0 -1 0 22.45)"><g class="ltx_tikzmatrix_row" transform="matrix(1 0 0 1 0 6.73)"><g class="ltx_tikzmatrix_col ltx_nopad_r" transform="matrix(1 0 0 -1 43.17 0)"><foreignObject style="--ltx-fo-width:31.7em;--ltx-fo-height:0.61em;--ltx-fo-depth:0.17em;font-size:7.97pt;" height="8.61" overflow="visible" transform="matrix(1 0 0 -1 0 6.73)" width="349.71"><span class="ltx_foreignobject_container"><span class="ltx_foreignobject_content"><span id="S3.F5.pic1.4" class="ltx_text" style="font-size:70%;">the generator cannot tell the readings apart, so </span><em id="S3.F5.pic1.5" class="ltx_emph ltx_font_italic" style="font-size:70%;">both</em><span id="S3.F5.pic1.6" class="ltx_text" style="font-size:70%;"> caps bind the same run</span></span></span></foreignObject></g></g><g class="ltx_tikzmatrix_row" transform="matrix(1 0 0 1 0 18.99)"><g class="ltx_tikzmatrix_col ltx_nopad_r" transform="matrix(1 0 0 -1 0 0)"><foreignObject style="--ltx-fo-width:33.75em;--ltx-fo-height:0.66em;--ltx-fo-depth:0.22em;font-size:7.97pt;" height="9.69" overflow="visible" transform="matrix(1 0 0 -1 0 7.26)" width="372.25"><span class="ltx_foreignobject_container"><span class="ltx_foreignobject_content"><span id="S3.F5.pic1.7" class="ltx_text" style="font-size:70%;">(and finitely many trivia under Reading 1 forces </span><math id="S3.F5.pic1.m21" class="ltx_Math" alttext="\lvert O\cap D\rvert&lt;\infty" display="inline" intent=":literal"><semantics><mrow><mrow><mo stretchy="false">|</mo><mrow><mi mathsize="0.700em">O</mi><mo mathsize="0.700em">∩</mo><mi mathsize="0.700em">D</mi></mrow><mo stretchy="false">|</mo></mrow><mo mathsize="0.700em">&lt;</mo><mi mathsize="0.700em" mathvariant="normal">∞</mi></mrow><annotation encoding="application/x-tex">\lvert O\cap D\rvert&lt;\infty</annotation></semantics></math><span id="S3.F5.pic1.8" class="ltx_text" style="font-size:70%;"> under
Reading 2: the </span><math id="S3.F5.pic1.m22" class="ltx_Math" alttext="\alpha/2" display="inline" intent=":literal"><semantics><mrow><mi mathsize="0.700em">α</mi><mo maxsize="0.700em" minsize="0.700em" stretchy="true" symmetric="true">/</mo><mn mathsize="0.700em">2</mn></mrow><annotation encoding="application/x-tex">\alpha/2</annotation></semantics></math><span id="S3.F5.pic1.9" class="ltx_text" style="font-size:70%;"> cap)</span></span></span></foreignObject></g></g></g></g></g></svg></span>
<figcaption class="ltx_caption ltx_centering"><span class="ltx_tag ltx_tag_figure"><span id="S3.F5.3" class="ltx_text" style="font-size:90%;">Figure 5</span>: </span><span id="S3.F5.4" class="ltx_text" style="font-size:90%;">One transcript, two readings (<a href="#S3.Thmtheorem6" title="Theorem 3.6 (Impossibility side of the dichotomy). ‣ The tight family. ‣ The trivia phase transition ‣ Main Results" class="ltx_ref"><span class="ltx_text ltx_ref_tag">Theorem</span> <span class="ltx_text ltx_ref_tag">3.6</span></a>). The racing stream
inside <math id="S3.F5.m9" class="ltx_Math" alttext="K" display="inline" intent=":literal"><semantics><mi>K</mi><annotation encoding="application/x-tex">K</annotation></semantics></math> is simultaneously a legal full enumeration of <math id="S3.F5.m10" class="ltx_Math" alttext="K" display="inline" intent=":literal"><semantics><mi>K</mi><annotation encoding="application/x-tex">K</annotation></semantics></math> and a legal
partial enumeration of <math id="S3.F5.m11" class="ltx_Math" alttext="K^{\prime}" display="inline" intent=":literal"><semantics><msup><mi>K</mi><mo>′</mo></msup><annotation encoding="application/x-tex">K^{\prime}</annotation></semantics></math> with core <math id="S3.F5.m12" class="ltx_Math" alttext="K" display="inline" intent=":literal"><semantics><mi>K</mi><annotation encoding="application/x-tex">K</annotation></semantics></math>. A deterministic generator produces
one limit set, so the race cap binds at truth <math id="S3.F5.m13" class="ltx_Math" alttext="K" display="inline" intent=":literal"><semantics><mi>K</mi><annotation encoding="application/x-tex">K</annotation></semantics></math> and the <math id="S3.F5.m14" class="ltx_Math" alttext="1-\alpha/2" display="inline" intent=":literal"><semantics><mrow><mn>1</mn><mo>−</mo><mrow><mi>α</mi><mo>/</mo><mn>2</mn></mrow></mrow><annotation encoding="application/x-tex">1-\alpha/2</annotation></semantics></math> cap at
truth <math id="S3.F5.m15" class="ltx_Math" alttext="K^{\prime}" display="inline" intent=":literal"><semantics><msup><mi>K</mi><mo>′</mo></msup><annotation encoding="application/x-tex">K^{\prime}</annotation></semantics></math>; finitely many trivia at the first reading collapse the second to
<math id="S3.F5.m16" class="ltx_Math" alttext="\alpha/2" display="inline" intent=":literal"><semantics><mrow><mi>α</mi><mo>/</mo><mn>2</mn></mrow><annotation encoding="application/x-tex">\alpha/2</annotation></semantics></math>.</span></figcaption>
</figure>
<div id="S3.SS3.SSS0.Px1.p7" class="ltx_para">
<p id="S3.SS3.SSS0.Px1.p7.1" class="ltx_p">The matching achievability is a single explicit generator, <math id="S3.SS3.SSS0.Px1.p7.m1" class="ltx_Math" alttext="G^{*}" display="inline" intent=":literal"><semantics><msup><mi>G</mi><mo>∗</mo></msup><annotation encoding="application/x-tex">G^{*}</annotation></semantics></math>, that races on the
conjunction of the consistent candidates and sweeps on their union. We define it together with
the universal sweep generator <math id="S3.SS3.SSS0.Px1.p7.m2" class="ltx_Math" alttext="G_{\mathrm{sw}}" display="inline" intent=":literal"><semantics><msub><mi>G</mi><mi>sw</mi></msub><annotation encoding="application/x-tex">G_{\mathrm{sw}}</annotation></semantics></math>, which gives the universal lower bound <math id="S3.SS3.SSS0.Px1.p7.m3" class="ltx_Math" alttext="c\geq 1-\overline{d}(C,H)" display="inline" intent=":literal"><semantics><mrow><mi>c</mi><mo>≥</mo><mrow><mn>1</mn><mo>−</mo><mrow><mover accent="true"><mi>d</mi><mo stretchy="true">¯</mo></mover><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>C</mi><mo>,</mo><mi>H</mi><mo stretchy="false">)</mo></mrow></mrow></mrow></mrow><annotation encoding="application/x-tex">c\geq 1-\overline{d}(C,H)</annotation></semantics></math> for every countable collection.</p>
</div>
<figure id="S3.F6" class="ltx_figure"><span class="ltx_inline-block"><svg id="S3.F6.pic1" class="ltx_picture ltx_centering" height="154.81" overflow="visible" version="1.1" viewBox="0 0 507.87 154.81" width="507.87"><g style="--ltx-stroke-color:#000000;--ltx-fill-color:#000000;" fill="#000000" stroke="#000000" stroke-width="0.4pt" transform="translate(0,154.81) matrix(1 0 0 -1 0 0) translate(-15.91,0) translate(0,28.87)"><g style="--ltx-stroke-color:#000000;--ltx-fill-color:#000000;" fill="#000000" stroke="#000000" transform="matrix(1.0 0.0 0.0 1.0 21.42 113.38)"><foreignObject style="--ltx-fo-width:31.25em;--ltx-fo-height:0.66em;--ltx-fo-depth:0.22em;font-size:7.97pt;" height="9.69" overflow="visible" transform="matrix(1 0 0 -1 0 7.26)" width="344.75"><span class="ltx_foreignobject_container"><span class="ltx_foreignobject_content"><span id="S3.F6.pic1.1" class="ltx_text" style="font-size:70%;">fixed prefix <math id="S3.F6.pic1.m1" class="ltx_Math" alttext="K^{\prime}[1\!\dots\!N]" display="inline" intent=":literal"><semantics><mrow><msup><mi>K</mi><mo>′</mo></msup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">[</mo><mrow><mpadded style="width:0.630em;" width="0.630em"><mi mathvariant="normal">…</mi></mpadded><mo lspace="0em" rspace="0em">​</mo><mi>N</mi></mrow><mo stretchy="false">]</mo></mrow></mrow><annotation encoding="application/x-tex">K^{\prime}[1\!\dots\!N]</annotation></semantics></math>; thick cells <math id="S3.F6.pic1.m2" class="ltx_Math" alttext="=K" display="inline" intent=":literal"><semantics><mrow><mphantom></mphantom><mo>=</mo><mi>K</mi></mrow><annotation encoding="application/x-tex">=K</annotation></semantics></math> (raced), thin cells <math id="S3.F6.pic1.m3" class="ltx_Math" alttext="=D" display="inline" intent=":literal"><semantics><mrow><mphantom></mphantom><mo>=</mo><mi>D</mi></mrow><annotation encoding="application/x-tex">=D</annotation></semantics></math> (swept); filled <math id="S3.F6.pic1.m4" class="ltx_Math" alttext="=" display="inline" intent=":literal"><semantics><mo>=</mo><annotation encoding="application/x-tex">=</annotation></semantics></math> claimed by <math id="S3.F6.pic1.m5" class="ltx_Math" alttext="O" display="inline" intent=":literal"><semantics><mi>O</mi><annotation encoding="application/x-tex">O</annotation></semantics></math></span></span></span></foreignObject></g><g stroke-width="0.9pt"><path style="fill:none" d="M 16.54 78.74 M 16.54 78.74 L 16.54 93.7 L 31.5 93.7 L 31.5 78.74 Z M 31.5 93.7"></path></g><g style="--ltx-stroke-color:#B3B3B3;--ltx-fill-color:#B3B3B3;--ltx-fg-color:#B3B3B3;" color="#B3B3B3" fill="#B3B3B3" stroke="#B3B3B3"><path style="fill:none" d="M 33.07 78.74 M 33.07 78.74 L 33.07 93.7 L 48.03 93.7 L 48.03 78.74 Z M 48.03 93.7"></path></g><g style="--ltx-stroke-color:#B3B3B3;--ltx-fill-color:#B3B3B3;--ltx-fg-color:#B3B3B3;" color="#B3B3B3" fill="#B3B3B3" stroke="#B3B3B3"><path style="fill:none" d="M 49.61 78.74 M 49.61 78.74 L 49.61 93.7 L 64.57 93.7 L 64.57 78.74 Z M 64.57 93.7"></path></g><g stroke-width="0.9pt"><path style="fill:none" d="M 66.14 78.74 M 66.14 78.74 L 66.14 93.7 L 81.1 93.7 L 81.1 78.74 Z M 81.1 93.7"></path></g><g style="--ltx-stroke-color:#B3B3B3;--ltx-fill-color:#B3B3B3;--ltx-fg-color:#B3B3B3;" color="#B3B3B3" fill="#B3B3B3" stroke="#B3B3B3"><path style="fill:none" d="M 82.68 78.74 M 82.68 78.74 L 82.68 93.7 L 97.64 93.7 L 97.64 78.74 Z M 97.64 93.7"></path></g><g style="--ltx-stroke-color:#B3B3B3;--ltx-fill-color:#B3B3B3;--ltx-fg-color:#B3B3B3;" color="#B3B3B3" fill="#B3B3B3" stroke="#B3B3B3"><path style="fill:none" d="M 99.21 78.74 M 99.21 78.74 L 99.21 93.7 L 114.17 93.7 L 114.17 78.74 Z M 114.17 93.7"></path></g><g stroke-width="0.9pt"><path style="fill:none" d="M 115.75 78.74 M 115.75 78.74 L 115.75 93.7 L 130.71 93.7 L 130.71 78.74 Z M 130.71 93.7"></path></g><g style="--ltx-stroke-color:#B3B3B3;--ltx-fill-color:#B3B3B3;--ltx-fg-color:#B3B3B3;" color="#B3B3B3" fill="#B3B3B3" stroke="#B3B3B3"><path style="fill:none" d=