<td id="S4.T2.3.1.18.3" class="ltx_td ltx_align_center"><span id="S4.T2.3.1.18.3.1" class="ltx_text" style="font-size:90%;">0.9288</span></td>
<td id="S4.T2.3.1.18.4" class="ltx_td ltx_align_center"><span id="S4.T2.3.1.18.4.1" class="ltx_text" style="font-size:90%;">0.9244</span></td>
<td id="S4.T2.3.1.18.5" class="ltx_td ltx_align_center"><span id="S4.T2.3.1.18.5.1" class="ltx_text" style="font-size:90%;">0.9525</span></td></tr>
