<td id="S4.T2.4.8.5" class="ltx_td ltx_align_center ltx_border_b ltx_border_r"><span id="S4.T2.4.8.5.1" class="ltx_text ltx_font_smallcaps" style="font-size:90%;">-</span></td></tr>
</tbody>
