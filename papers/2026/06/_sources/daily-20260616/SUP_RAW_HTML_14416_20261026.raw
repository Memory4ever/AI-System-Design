             <span id="alg1.l15.3" class="ltx_text ltx_font_bold">for</span> each local epoch <math id="alg1.l15.m1" class="ltx_Math" alttext="t=1,\ldots,T" display="inline" intent=":literal"><semantics><mrow><mrow><mi>t</mi><mo>=</mo><mn>1</mn></mrow><mo>,</mo><mi mathvariant="normal">…</mi><mo>,</mo><mi>T</mi></mrow><annotation encoding="application/x-tex">t=1,\ldots,T</annotation></semantics></math> <span id="alg1.l15.4" class="ltx_text ltx_font_bold">do</span>



