              <span id="alg1.l16.3" class="ltx_text ltx_font_bold">for</span> each batch <math id="alg1.l16.m1" class="ltx_math_unparsed" alttext="(x_{m,1:B},y_{m,1:B})\in D_{m}" display="inline" intent=":literal"><semantics><mrow><mrow><mo stretchy="false">(</mo><msub><mi>x</mi><mrow><mrow><mi>m</mi><mo>,</mo><mn>1</mn></mrow><mo lspace="0.278em" rspace="0.278em">:</mo><mi>B</mi></mrow></msub><mo>,</mo><msub><mi>y</mi><mrow><mrow><mi>m</mi><mo>,</mo><mn>1</mn></mrow><mo lspace="0.278em" rspace="0.278em">:</mo><mi>B</mi></mrow></msub><mo stretchy="false">)</mo></mrow><mo>∈</mo><msub><mi>D</mi><mi>m</mi></msub></mrow><annotation encoding="application/x-tex">(x_{m,1:B},y_{m,1:B})\in D_{m}</annotation></semantics></math> <span id="alg1.l16.4" class="ltx_text ltx_font_bold">do</span>



