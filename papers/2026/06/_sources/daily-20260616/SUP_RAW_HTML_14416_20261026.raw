             <span id="alg1.l12.3" class="ltx_text ltx_font_bold">return</span> <math id="alg1.l12.m1" class="ltx_Math" alttext="w^{K}" display="inline" intent=":literal"><semantics><msup><mi>w</mi><mi>K</mi></msup><annotation encoding="application/x-tex">w^{K}</annotation></semantics></math>

