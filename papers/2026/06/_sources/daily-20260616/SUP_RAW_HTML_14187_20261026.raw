              <span id="alg1.l12.3" class="ltx_text ltx_font_bold" style="font-size:90%;">end</span><span id="alg1.l12.4" class="ltx_text" style="font-size:90%;"> </span><span id="alg1.l12.5" class="ltx_text ltx_font_bold" style="font-size:90%;">while</span>
</div>
