<td id="S4.T1.2.1.15.10" class="ltx_td ltx_align_center ltx_border_bb" style="padding-left:4.0pt;padding-right:4.0pt;"><span id="S4.T1.2.1.15.10.1" class="ltx_text ltx_font_bold" style="font-size:80%;--ltx-bg-color:#FFE6E6;">23.69</span></td></tr>
</tbody>
</table>
</span></div>
</figure>
</section>
