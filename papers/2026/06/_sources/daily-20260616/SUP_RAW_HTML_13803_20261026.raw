<figcaption class="ltx_caption"><span class="ltx_tag ltx_tag_figure"><span id="A4.F6.sf3.3" class="ltx_text" style="font-size:90%;">(c)</span> </span><math id="A4.F6.sf3.m2" class="ltx_Math" alttext="W=16" display="inline" intent=":literal"><semantics><mrow><mi mathsize="0.900em">W</mi><mo mathsize="0.900em">=</mo><mn mathsize="0.900em">16</mn></mrow><annotation encoding="application/x-tex">W=16</annotation></semantics></math><span id="A4.F6.sf3.4" class="ltx_text" style="font-size:90%;">.</span></figcaption>
