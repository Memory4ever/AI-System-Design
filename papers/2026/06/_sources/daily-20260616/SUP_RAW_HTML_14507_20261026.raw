<td id="S4.T4.4.7.5" class="ltx_td ltx_align_right ltx_border_bb" style="padding-left:2.5pt;padding-right:2.5pt;"><span id="S4.T4.4.7.5.1" class="ltx_text" style="font-size:80%;">0.000</span></td>
<td id="S4.T4.4.7.6" class="ltx_td ltx_align_right ltx_border_bb" style="padding-left:2.5pt;padding-right:2.5pt;"><span id="S4.T4.4.7.6.1" class="ltx_text" style="font-size:80%;">1</span></td></tr>
