<td id="S4.T2.4.6.4" class="ltx_td ltx_align_right ltx_border_bb" style="padding-left:3.5pt;padding-right:3.5pt;"><span id="S4.T2.4.6.4.1" class="ltx_text" style="font-size:80%;">0.381</span></td>
