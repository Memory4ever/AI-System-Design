<td id="S5.T3.2.1.3.8" class="ltx_td ltx_align_right" style="padding:0.2pt 4.0pt;"><span id="S5.T3.2.1.3.8.1" class="ltx_text" style="font-size:80%;">13.2</span></td></tr>
