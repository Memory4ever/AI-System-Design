<td id="S5.T4.5.5.5" class="ltx_td ltx_align_right ltx_border_t" style="padding:0.2pt 4.0pt;"><span id="S5.T4.5.5.5.1" class="ltx_text" style="font-size:70%;">45.5</span></td>
<td id="S5.T4.5.5.6" class="ltx_td ltx_align_right ltx_border_t" style="padding:0.2pt 4.0pt;"><span id="S5.T4.5.5.6.1" class="ltx_text" style="font-size:70%;">7.2</span></td>
<td id="S5.T4.5.5.7" class="ltx_td ltx_nopad_r ltx_align_right ltx_border_t" style="padding:0.2pt 4.0pt;"><span id="S5.T4.5.5.7.1" class="ltx_text" style="font-size:70%;">12.1</span></td></tr>
<tr id="S5.T4.5.6" class="ltx_tr">
<th id="S5.T4.5.6.1" class="ltx_td ltx_align_left ltx_th ltx_th_row" style="padding:0.2pt 4.0pt;"><span id="S5.T4.5.6.1.1" class="ltx_text ltx_font_smallcaps" style="font-size:70%;">Standard</span></th>
<td id="S5.T4.5.6.2" class="ltx_td ltx_align_right" style="padding:0.2pt 4.0pt;"><span id="S5.T4.5.6.2.1" class="ltx_text" style="font-size:70%;">57.8 <span id="S5.T4.5.6.2.1.1" class="ltx_text" style="font-size:114%;--ltx-fg-color:#15803D;">(<math id="S5.T4.m11" class="ltx_Math" alttext="+1.5" display="inline" intent=":literal"><semantics><mrow><mo style="--ltx-fg-color:#15803D;" mathcolor="#15803D">+</mo><mn style="--ltx-fg-color:#15803D;" mathcolor="#15803D">1.5</mn></mrow><annotation encoding="application/x-tex">+1.5</annotation></semantics></math>)</span></span></td>
<td id="S5.T4.5.6.3" class="ltx_td ltx_align_right" style="padding:0.2pt 4.0pt;"><span id="S5.T4.5.6.3.1" class="ltx_text" style="font-size:70%;">56.9 <span id="S5.T4.5.6.3.1.1" class="ltx_text" style="font-size:114%;--ltx-fg-color:#15803D;">(<math id="S5.T4.m12" class="ltx_Math" alttext="+3.1" display="inline" intent=":literal"><semantics><mrow><mo style="--ltx-fg-color:#15803D;" mathcolor="#15803D">+</mo><mn style="--ltx-fg-color:#15803D;" mathcolor="#15803D">3.1</mn></mrow><annotation encoding="application/x-tex">+3.1</annotation></semantics></math>)</span></span></td>
