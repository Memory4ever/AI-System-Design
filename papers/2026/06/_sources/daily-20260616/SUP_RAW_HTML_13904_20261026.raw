<th id="S5.T3.2.1.4.1" class="ltx_td ltx_align_left ltx_th ltx_th_row" style="padding:0.2pt 4.0pt;"><span id="S5.T3.2.1.4.1.1" class="ltx_text ltx_font_smallcaps" style="font-size:80%;">Ideal</span></th>
