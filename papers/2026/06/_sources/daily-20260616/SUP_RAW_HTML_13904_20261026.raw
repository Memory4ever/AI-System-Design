<td id="S4.T1.4.2.4" class="ltx_td ltx_align_right ltx_border_t" style="padding-left:3.0pt;padding-right:3.0pt;"><span id="S4.T1.4.2.4.1" class="ltx_text" style="font-size:90%;">6.9</span></td>
