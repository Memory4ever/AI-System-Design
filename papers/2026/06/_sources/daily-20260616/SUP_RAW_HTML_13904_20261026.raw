<td id="S5.T5.4.2.4" class="ltx_td ltx_align_right ltx_border_t" style="padding:-0.2pt 2.5pt;"><span id="S5.T5.4.2.4.1" class="ltx_text" style="font-size:80%;">49.6%</span></td></tr>
<tr id="S5.T5.4.3" class="ltx_tr">
<th id="S5.T5.4.3.1" class="ltx_td ltx_align_left ltx_th ltx_th_row" style="padding:-0.2pt 2.5pt;"><span id="S5.T5.4.3.1.1" class="ltx_text" style="font-size:80%;">Standard</span></th>
<td id="S5.T5.4.3.2" class="ltx_td ltx_align_right" style="padding:-0.2pt 2.5pt;"><span id="S5.T5.4.3.2.1" class="ltx_text" style="font-size:80%;">12.6%</span></td>
<td id="S5.T5.4.3.3" class="ltx_td ltx_align_right" style="padding:-0.2pt 2.5pt;"><span id="S5.T5.4.3.3.1" class="ltx_text" style="font-size:80%;">46.4% <span id="S5.T5.4.3.3.1.1" class="ltx_text" style="--ltx-fg-color:#B91C1C;">(<math id="S5.T5.m1" class="ltx_Math" alttext="-3.2" display="inline" intent=":literal"><semantics><mrow><mo style="--ltx-fg-color:#B91C1C;" mathcolor="#B91C1C">−</mo><mn style="--ltx-fg-color:#B91C1C;" mathcolor="#B91C1C">3.2</mn></mrow><annotation encoding="application/x-tex">-3.2</annotation></semantics></math>)</span></span></td></tr>
