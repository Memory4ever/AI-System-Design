<td id="S5.T4.5.6.6" class="ltx_td ltx_nopad_r ltx_align_right" style="padding:0.2pt 4.0pt;"><span id="S5.T4.5.6.6.1" class="ltx_text" style="font-size:70%;">13.2</span></td></tr>
