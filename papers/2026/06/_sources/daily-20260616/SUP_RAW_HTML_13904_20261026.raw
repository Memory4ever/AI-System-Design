<td id="S5.T4.5.7.2" class="ltx_td ltx_align_right" style="padding:0.2pt 4.0pt;"><span id="S5.T4.5.7.2.1" class="ltx_text ltx_font_bold" style="font-size:70%;">76.3<span id="S5.T4.5.7.2.1.1" class="ltx_text ltx_font_medium"> <span id="S5.T4.5.7.2.1.1.1" class="ltx_text" style="font-size:114%;--ltx-fg-color:#15803D;">(<math id="S5.T4.m14" class="ltx_Math" alttext="+20.0" display="inline" intent=":literal"><semantics><mrow><mo style="--ltx-fg-color:#15803D;" mathcolor="#15803D">+</mo><mn style="--ltx-fg-color:#15803D;" mathcolor="#15803D">20.0</mn></mrow><annotation encoding="application/x-tex">+20.0</annotation></semantics></math>)</span></span></span></td>
