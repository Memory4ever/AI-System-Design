<td id="A4.T2.5.2.3" class="ltx_td ltx_align_center ltx_border_t"><span id="A4.T2.5.2.3.1" class="ltx_text" style="font-size:90%;">.749</span></td>
<td id="A4.T2.5.2.4" class="ltx_td ltx_align_center ltx_border_t"><span id="A4.T2.5.2.4.1" class="ltx_text" style="font-size:90%;">.023</span></td>
<td id="A4.T2.5.2.5" class="ltx_td ltx_align_center ltx_border_t"><span id="A4.T2.5.2.5.1" class="ltx_text" style="font-size:90%;">25</span></td>
