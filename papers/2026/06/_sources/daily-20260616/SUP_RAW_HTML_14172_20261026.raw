<td id="S6.T5.2.1.2.4" class="ltx_td ltx_nopad_l ltx_nopad_r ltx_align_center ltx_border_t" style="padding:0.2pt 1.6pt;"><math id="S6.T5.m3" class="ltx_Math" alttext="O(|\mathcal{V}|^{2}+Kd)" display="inline" intent=":literal"><semantics><mrow><mi mathsize="0.700em">O</mi><mo>⁡</mo><mrow><mo maxsize="0.700em" minsize="0.700em">(</mo><mrow><msup><mrow><mo maxsize="0.700em" minsize="0.700em" stretchy="true">|</mo><mi class="ltx_font_mathcaligraphic" mathsize="0.700em">𝒱</mi><mo maxsize="0.700em" minsize="0.700em" stretchy="true">|</mo></mrow><mn mathsize="0.700em">2</mn></msup><mo mathsize="0.700em">+</mo><mrow><mi mathsize="0.700em">K</mi><mo lspace="0em" rspace="0em">​</mo><mi mathsize="0.700em">d</mi></mrow></mrow><mo maxsize="0.700em" minsize="0.700em">)</mo></mrow></mrow><annotation encoding="application/x-tex">O(|\mathcal{V}|^{2}+Kd)</annotation></semantics></math></td></tr>
