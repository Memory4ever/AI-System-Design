<tr id="A3.T6.2.1.5" class="ltx_tr">
<td id="A3.T6.2.1.5.1" class="ltx_td ltx_align_center" style="padding:-0.6pt 3.0pt;">1</td>
<td id="A3.T6.2.1.5.2" class="ltx_td ltx_align_center" style="padding:-0.6pt 3.0pt;">/</td>
<td id="A3.T6.2.1.5.3" class="ltx_td ltx_align_center" style="padding:-0.6pt 3.0pt;">0.5</td>
<td id="A3.T6.2.1.5.4" class="ltx_td ltx_align_center" style="padding:-0.6pt 3.0pt;">/</td>
<td id="A3.T6.2.1.5.5" class="ltx_td ltx_align_center" style="padding:-0.6pt 3.0pt;">/</td>
<td id="A3.T6.2.1.5.6" class="ltx_td ltx_align_left" style="padding:-0.6pt 3.0pt;">GRPO</td>
<td id="A3.T6.2.1.5.7" class="ltx_td ltx_align_right" style="padding:-0.6pt 3.0pt;">0.726</td>
<td id="A3.T6.2.1.5.8" class="ltx_td ltx_align_right" style="padding:-0.6pt 3.0pt;">392.908</td>
