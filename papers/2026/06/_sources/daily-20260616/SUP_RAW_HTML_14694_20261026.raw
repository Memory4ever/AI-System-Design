<td id="S4.T3.2.1.10.5" class="ltx_td ltx_nopad_l ltx_align_left ltx_border_bb" style="padding:-0.4pt 3.0pt;"><span id="S4.T3.2.1.10.5.1" class="ltx_text" style="--ltx-fg-color:#D00000;">(-16.7%)</span></td>
