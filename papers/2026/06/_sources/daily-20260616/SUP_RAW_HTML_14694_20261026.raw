<td id="A3.T6.2.1.4.10" class="ltx_td ltx_align_right" style="padding:-0.6pt 3.0pt;">286.132</td>
<td id="A3.T6.2.1.4.11" class="ltx_td ltx_align_right" style="padding:-0.6pt 3.0pt;">0.688</td>
