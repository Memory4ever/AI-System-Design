<td id="A3.T6.2.1.1.4" class="ltx_td ltx_align_center ltx_border_tt" style="padding:-0.6pt 3.0pt;" rowspan="2"><span id="A3.T6.2.1.1.4.1" class="ltx_text"><math id="A3.T6.m3" class="ltx_Math" alttext="\lambda" display="inline" intent=":literal"><semantics><mi>λ</mi><annotation encoding="application/x-tex">\lambda</annotation></semantics></math></span></td>
<td id="A3.T6.2.1.1.5" class="ltx_td ltx_align_left ltx_border_tt" style="padding:-0.6pt 3.0pt;" rowspan="2"><span id="A3.T6.2.1.1.5.1" class="ltx_text">Method</span></td>
<td id="A3.T6.2.1.1.6" class="ltx_td ltx_align_center ltx_border_tt" style="padding:-0.6pt 3.0pt;" colspan="2">GSM-symbolic P2</td>
<td id="A3.T6.2.1.1.7" class="ltx_td ltx_align_center ltx_border_tt" style="padding:-0.6pt 3.0pt;" colspan="2">GSM-symbolic P1</td>
<td id="A3.T6.2.1.1.8" class="ltx_td ltx_align_center ltx_border_tt" style="padding:-0.6pt 3.0pt;" colspan="2">MetaMathQA</td></tr>
<tr id="A3.T6.2.1.2" class="ltx_tr">
<td id="A3.T6.2.1.2.1" class="ltx_td ltx_align_center ltx_border_t" style="padding:-0.6pt 3.0pt;">Acc.</td>
<td id="A3.T6.2.1.2.2" class="ltx_td ltx_align_center ltx_border_t" style="padding:-0.6pt 3.0pt;">Format</td>
<td id="A3.T6.2.1.2.3" class="ltx_td ltx_align_right ltx_border_t" style="padding:-0.6pt 3.0pt;">Acc</td>
<td id="A3.T6.2.1.2.4" class="ltx_td ltx_align_right ltx_border_t" style="padding:-0.6pt 3.0pt;">Len.</td>
<td id="A3.T6.2.1.2.5" class="ltx_td ltx_align_right ltx_border_t" style="padding:-0.6pt 3.0pt;">Acc</td>
<td id="A3.T6.2.1.2.6" class="ltx_td ltx_align_right ltx_border_t" style="padding:-0.6pt 3.0pt;">Len.</td>
