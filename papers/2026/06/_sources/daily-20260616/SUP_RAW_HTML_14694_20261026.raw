<td id="A3.T6.2.1.3.1" class="ltx_td ltx_align_left ltx_border_t" style="padding:-0.6pt 3.0pt;" colspan="12"><span id="A3.T6.2.1.3.1.1" class="ltx_text ltx_font_italic">Baselines</span></td></tr>
<tr id="A3.T6.2.1.4" class="ltx_tr">
<td id="A3.T6.2.1.4.1" class="ltx_td ltx_align_center" style="padding:-0.6pt 3.0pt;">/</td>
