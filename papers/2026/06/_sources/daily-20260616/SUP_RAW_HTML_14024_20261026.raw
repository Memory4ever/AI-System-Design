<td id="S4.T1.5.4.2" class="ltx_td ltx_align_center ltx_border_t" style="padding:0.55pt 4.0pt;"><span id="S4.T1.5.4.2.1" class="ltx_text" style="font-size:90%;">63.10</span></td>
<td id="S4.T1.5.4.3" class="ltx_td ltx_align_center ltx_border_t" style="padding:0.55pt 4.0pt;"><span id="S4.T1.5.4.3.1" class="ltx_text" style="font-size:90%;">81.85</span></td>
<td id="S4.T1.5.4.4" class="ltx_td ltx_align_center ltx_border_t" style="padding:0.55pt 4.0pt;"><span id="S4.T1.5.4.4.1" class="ltx_text" style="font-size:90%;">84.88</span></td>
<td id="S4.T1.5.4.5" class="ltx_td ltx_align_center ltx_border_t" style="padding:0.55pt 4.0pt;"><span id="S4.T1.5.4.5.1" class="ltx_text" style="font-size:90%;">96.45</span></td>
<td id="S4.T1.5.4.6" class="ltx_td ltx_align_center ltx_border_t" style="padding:0.55pt 4.0pt;"><span id="S4.T1.5.4.6.1" class="ltx_text" style="font-size:90%;">43.27</span></td>
<td id="S4.T1.5.4.7" class="ltx_td ltx_align_center ltx_border_t" style="padding:0.55pt 4.0pt;"><span id="S4.T1.5.4.7.1" class="ltx_text" style="font-size:90%;">76.17</span></td>
