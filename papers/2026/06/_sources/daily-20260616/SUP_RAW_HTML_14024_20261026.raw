<td id="S4.T9.3.1.7.7" class="ltx_td ltx_align_center ltx_border_t" style="padding-left:2.4pt;padding-right:2.4pt;"><span id="S4.T9.3.1.7.7.1" class="ltx_text ltx_underline" style="font-size:70%;">503.7</span></td>
