<td id="S4.T9.3.1.8.4" class="ltx_td ltx_align_center" style="padding-left:2.4pt;padding-right:2.4pt;"><span id="S4.T9.3.1.8.4.1" class="ltx_text" style="font-size:70%;">55.4</span></td>
<td id="S4.T9.3.1.8.5" class="ltx_td ltx_align_center" style="padding-left:2.4pt;padding-right:2.4pt;"><span id="S4.T9.3.1.8.5.1" class="ltx_text" style="font-size:70%;">-</span></td>
<td id="S4.T9.3.1.8.6" class="ltx_td ltx_align_center" style="padding-left:2.4pt;padding-right:2.4pt;"><span id="S4.T9.3.1.8.6.1" class="ltx_text" style="font-size:70%;">1069.6</span></td>
