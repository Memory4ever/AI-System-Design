<td id="A1.T10.1.6.4" class="ltx_td ltx_align_center ltx_border_bb ltx_border_t" style="padding-left:3.2pt;padding-right:3.2pt;"><span id="A1.T10.1.6.4.1" class="ltx_text ltx_font_bold">44.7</span></td>
<td id="A1.T10.1.6.5" class="ltx_td ltx_align_center ltx_border_bb ltx_border_t" style="padding-left:3.2pt;padding-right:3.2pt;"><span id="A1.T10.1.6.5.1" class="ltx_text ltx_underline">65.4</span></td>
<td id="A1.T10.1.6.6" class="ltx_td ltx_align_center ltx_border_bb ltx_border_t" style="padding-left:3.2pt;padding-right:3.2pt;"><span id="A1.T10.1.6.6.1" class="ltx_text ltx_font_bold">55.4</span></td>
