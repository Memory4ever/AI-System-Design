<td id="S4.T9.3.1.9.2" class="ltx_td ltx_align_center ltx_border_bb" style="padding-left:2.4pt;padding-right:2.4pt;"><span id="S4.T9.3.1.9.2.1" class="ltx_text" style="font-size:70%;">-</span></td>
