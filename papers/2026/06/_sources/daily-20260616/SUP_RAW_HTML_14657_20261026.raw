<td id="S3.T2.5.7.6" class="ltx_td ltx_align_center ltx_border_t"><span id="S3.T2.5.7.6.1" class="ltx_text" style="font-size:90%;">60.8</span></td>
<td id="S3.T2.5.7.7" class="ltx_td ltx_align_center ltx_border_r ltx_border_t"><span id="S3.T2.5.7.7.1" class="ltx_text" style="font-size:90%;">97.2</span></td>
