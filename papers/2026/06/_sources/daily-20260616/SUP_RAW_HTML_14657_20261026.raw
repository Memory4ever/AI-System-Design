<td id="S3.T2.5.7.9" class="ltx_td ltx_align_center ltx_border_t"><span id="S3.T2.5.7.9.1" class="ltx_text" style="font-size:90%;">67.1</span></td></tr>
<tr id="S3.T2.5.8" class="ltx_tr">
<td id="S3.T2.5.8.1" class="ltx_td ltx_align_left ltx_border_r"><span id="S3.T2.5.8.1.1" class="ltx_text" style="font-size:90%;">HPSv3</span></td>
<td id="S3.T2.5.8.2" class="ltx_td ltx_align_center"><span id="S3.T2.5.8.2.1" class="ltx_text ltx_font_bold" style="font-size:90%;">66.8</span></td>
