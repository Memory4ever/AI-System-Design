{"url": "https://api.datacite.org/dois?client-id=arxiv.content&query=registered%3A%5B2026-06-15T16%3A00%3A00Z+TO+2026-06-16T15%3A59%3A59Z%5D+AND+%28titles.title%3A%28agent+OR+agents+OR+reasoning+OR+retrieval+OR+memory+OR+planning+OR+reinforcement+OR+reward+OR+evaluation+OR+benchmark%29+AND+descriptions.description%3A%28LLM+OR+%22language+model%22+OR+%22language+models%22+OR+foundation%29%29&page%5Bsize%5D=1000&page%5Bnumber%5D=1", "payload": {"data": [{"id": "10.48550/arxiv.2606.15735", "type": "dois", "attributes": {"doi": "10.48550/arxiv.2606.15735", "identifiers": [{"identifier": "2606.15735", "identifierType": "arXiv"}], "creators": [{"nameType": "Personal", "givenName": "Jiyoun", "familyName": "Kim", "name": "Kim, Jiyoun", "affiliation": [], "nameIdentifiers": []}, {"nameType": "Personal", "givenName": "Muhan", "familyName": "Yeo", "name": "Yeo, Muhan", "affiliation": [], "nameIdentifiers": []}, {"nameType": "Personal", "givenName": "Eunhye", "familyName": "Jang", "name": "Jang, Eunhye", "affiliation": [], "nameIdentifiers": []}, {"nameType": "Personal", "givenName": "Jeewon", "familyName": "Yang", "name": "Yang, Jeewon", "affiliation": [], "nameIdentifiers": []}, {"nameType": "Personal", "givenName": "Hangyul", "familyName": "Yoon", "name": "Yoon, Hangyul", "affiliation": [], "nameIdentifiers": []}, {"nameType": "Personal", "givenName": "Su Ji", "familyName": "Lee", "name": "Lee, Su Ji", "affiliation": [], "nameIdentifiers": []}, {"nameType": "Personal", "givenName": "Hee Jo", "familyName": "Han", "name": "Han, Hee Jo", "affiliation": [], "nameIdentifiers": []}, {"nameType": "Personal", "givenName": "Hee-Jae", "familyName": "Jung", "name": "Jung, Hee-Jae", "affiliation": [], "nameIdentifiers": []}, {"nameType": "Personal", "givenName": "Doyun", "familyName": "Kwon", "name": "Kwon, Doyun", "affiliation": [], "nameIdentifiers": []}, {"nameType": "Personal", "givenName": "Jun young", "familyName": "Lee", "name": "Lee, Jun young", "affiliation": [], "nameIdentifiers": []}, {"nameType": "Personal", "givenName": "Jaehun", "familyName": "Lee", "name": "Lee, Jaehun", "affiliation": [], "nameIdentifiers": []}, {"nameType": "Personal", "givenName": "Jung-Oh", "familyName": "Lee", "name": "Lee, Jung-Oh", "affiliation": [], "nameIdentifiers": []}, {"nameType": "Personal", "givenName": "Sunjun", "familyName": "Kweon", "name": "Kweon, Sunjun", "affiliation": [], "nameIdentifiers": []}, {"nameType": "Personal", "givenName": "Jong Hak", "familyName": "Moon", "name": "Moon, Jong Hak", "affiliation": [], "nameIdentifiers": []}, {"nameType": "Personal", "givenName": "Daseul", "familyName": "Kim", "name": "Kim, Daseul", "affiliation": [], "nameIdentifiers": []}, {"nameType": "Personal", "givenName": "Minjae", "familyName": "Cho", "name": "Cho, Minjae", "affiliation": [], "nameIdentifiers": []}, {"nameType": "Personal", "givenName": "Edward", "familyName": "Choi", "name": "Choi, Edward", "affiliation": [], "nameIdentifiers": []}], "titles": [{"title": "EHRNote-ChatQA: A Benchmark for Evidence-Grounded Multi-Turn Clinical Question Answering over Longitudinal Discharge Summaries"}], "publisher": "arXiv", "container": {}, "publicationYear": 2026, "subjects": [{"subject": "Computation and Language (cs.CL)", "lang": "en", "subjectScheme": "arXiv"}, {"subject": "Artificial Intelligence (cs.AI)", "lang": "en", "subjectScheme": "arXiv"}, {"subject": "FOS: Computer and information sciences", "subjectScheme": "Fields of Science and Technology (FOS)"}], "contributors": [], "dates": [{"date": "2026-06-14T10:35:19Z", "dateType": "Submitted", "dateInformation": "v1"}, {"date": "2026-06-16T00:55:40Z", "dateType": "Updated", "dateInformation": "v1"}, {"date": "2026-06-16T10:33:24Z", "dateType": "Submitted", "dateInformation": "v2"}, {"date": "2026-06-17T00:44:49Z", "dateType": "Updated", "dateInformation": "v2"}, {"date": "2026-10-21T15:46:36Z", "dateType": "Submitted", "dateInformation": "v3"}, {"date": "2026-10-22T01:18:57Z", "dateType": "Updated", "dateInformation": "v3"}, {"date": "2026-06", "dateType": "Available", "dateInformation": "v1"}], "language": null, "types": {"schemaOrg": "CreativeWork", "resourceTypeGeneral": "Preprint", "citeproc": "article", "bibtex": "misc", "ris": "GEN", "resourceType": "Article"}, "relatedIdentifiers": [], "relatedItems": [], "sizes": [], "formats": [], "version": "3", "rightsList": [{"rightsIdentifierScheme": "SPDX", "rightsUri": "https://creativecommons.org/licenses/by/4.0/legalcode", "schemeUri": "https://spdx.org/licenses/", "rights": "Creative Commons Attribution 4.0 International", "rightsIdentifier": "cc-by-4.0"}], "descriptions": [{"descriptionType": "Abstract", "description": "Discharge summaries are crucial clinical documents containing the context of a patient's overall hospital stay, and are routinely reviewed by medical experts for patient readmission, ongoing care, and diagnostic decision-making. When reviewing them, medical experts often must iteratively synthesize information across multiple discharge summaries while verifying the evidence supporting each answer. Although large language models (LLMs) are increasingly explored for clinical question answering, existing benchmarks do not sufficiently reflect this setting: they often evaluate exam-style medical knowledge or focus on single-turn question answering with limited evidence-grounding evaluation. We introduce EHRNote-ChatQA, the first benchmark for evidence-grounded multi-turn clinical question answering over patients' multiple discharge summaries. Built from de-identified MIMIC-IV discharge summaries, EHRNote-ChatQA contains 967 patient-level multi-turn samples spanning one to five notes and 16,072 medical-expert-verified QA pairs (8,036 content questions, each paired with an evidence-grounding question) across eight clinical categories. The benchmark is constructed through an expert-informed pipeline combining discharge-summary structuring schema, expert-curated multi-turn QA templates, and LLM-based generation, followed by review and revision of every single QA sample by 12 medical experts (11 physicians and 1 nurse). Benchmarking 24 proprietary and open-weight LLMs reveals several challenges, including that LLMs struggle more with evidence grounding than content answering, multi-turn errors compound across turns, and single-turn clinical QA performance does not reliably transfer to this setting. These findings establish EHRNote-ChatQA as a rigorous and practical benchmark for evaluating clinical QA systems."}], "geoLocations": [], "fundingReferences": [], "url": "https://arxiv.org/abs/2606.15735", "contentUrl": null, "metadataVersion": 2, "schemaVersion": "http://datacite.org/schema/kernel-4", "source": "mds", "isActive": true, "state": "findable", "reason": null, "viewCount": 0, "downloadCount": 0, "referenceCount": 0, "citationCount": 0, "partCount": 0, "partOfCount": 0, "versionCount": 0, "versionOfCount": 0, "created": "2026-06-16T03:30:11Z", "registered": "2026-06-16T03:30:12Z", "published": null, "updated": "2026-10-22T03:04:45Z"}, "relationships": {"client": {"data": {"id": "arxiv.content", "type": "clients"}}}}, {"id": "10.48550/arxiv.2606.15555", "type": "dois", "attributes": {"doi": "10.48550/arxiv.2606.15555", "identifiers": [{"identifier": "2606.15555", "identifierType": "arXiv"}], "creators": [{"nameType": "Personal", "givenName": "Ruicheng", "familyName": "Ao", "name": "Ao, Ruicheng", "affiliation": [], "nameIdentifiers": []}, {"nameType": "Personal", "givenName": "Jing", "familyName": "Dong", "name": "Dong, Jing", "affiliation": [], "nameIdentifiers": []}, {"nameType": "Personal", "givenName": "Gan", "familyName": "Luo", "name": "Luo, Gan", "affiliation": [], "nameIdentifiers": []}, {"nameType": "Personal", "givenName": "David", "familyName": "Simchi-Levi", "name": "Simchi-Levi, David", "affiliation": [], "nameIdentifiers": []}], "titles": [{"title": "Service-Induced Congestion in Memory-Constrained LLM Serving"}], "publisher": "arXiv", "container": {}, "publicationYear": 2026, "subjects": [{"subject": "Optimization and Control (math.OC)", "lang": "en", "subjectScheme": "arXiv"}, {"subject": "Artificial Intelligence (cs.AI)", "lang": "en", "subjectScheme": "arXiv"}, {"subject": "Machine Learning (cs.LG)", "lang": "en", "subjectScheme": "arXiv"}, {"subject": "Machine Learning (stat.ML)", "lang": "en", "subjectScheme": "arXiv"}, {"subject": "FOS: Mathematics", "subjectScheme": "Fields of Science and Technology (FOS)"}, {"subject": "FOS: Computer and information sciences", "subjectScheme": "Fields of Science and Technology (FOS)"}], "contributors": [], "dates": [{"date": "2026-06-14T02:49:03Z", "dateType": "Submitted", "dateInformation": "v1"}, {"date": "2026-06-16T00:47:26Z", "dateType": "Updated", "dateInformation": "v1"}, {"date": "2026-10-19T03:59:06Z", "dateType": "Submitted", "dateInformation": "v2"}, {"date": "2026-10-20T01:48:32Z", "dateType": "Updated", "dateInformation": "v2"}, {"date": "2026-10-20T03:22:51Z", "dateType": "Submitted", "dateInformation": "v3"}, {"date": "2026-10-21T00:34:27Z", "dateType": "Updated", "dateInformation": "v3"}, {"date": "2026-06", "dateType": "Available", "dateInformation": "v1"}], "language": null, "types": {"schemaOrg": "CreativeWork", "resourceTypeGeneral": "Preprint", "citeproc": "article", "bibtex": "misc", "ris": "GEN", "resourceType": "Article"}, "relatedIdentifiers": [], "relatedItems": [], "sizes": [], "formats": [], "version": "3", "rightsList": [{"rightsUri": "http://arxiv.org/licenses/nonexclusive-distrib/1.0/", "rights": "arXiv.org perpetual, non-exclusive license"}], "descriptions": [{"descriptionType": "Abstract", "description": "In large language model (LLM) serving, each request accumulates persistent graphics processing unit (GPU) memory during service as its key-value cache grows with every generated token. Under high concurrency, aggregate memory usage therefore increases endogenously over time: the service process itself creates future capacity pressure. When memory capacity is exceeded, systems evict active requests, discarding cached state and restarting them later, which wastes computation and reduces throughput. We develop a discrete-time dynamical model of memory-constrained LLM inference that captures admission, memory growth, and eviction under continuous batching. In the saturated-input regime, the system admits both eviction-free fixed points and limit cycles with evictions. For homogeneous workloads, we show that the eviction-free equilibrium is unstable and that, except for a Lebesgue-measure-zero exact-capture set, the system converges to a unique worst-case limit cycle that is asymptotically stable outside this exceptional set, with throughput losses as large as 50%. For heterogeneous workloads, we prove a stability criterion in the two-class common-input setting and explain how the survival-polynomial mechanism generalizes to multiple classes and heterogeneous-input lengths. Under an input-dominated scaling regime, coprime decoding lengths stabilize the eviction-free equilibrium, while non-coprime lengths create synchronized modes that drive instability. These results characterize when workload heterogeneity desynchronizes completions and helps stabilize memory-constrained serving. More broadly, we identify service-induced congestion as a structural instability mechanism and derive scheduling design principles for sustaining high throughput."}, {"descriptionType": "Other", "description": "100 pages. v2: adds GPU experiments with benchmark workloads (Appendix D.4) and revises the figures"}], "geoLocations": [], "fundingReferences": [], "url": "https://arxiv.org/abs/2606.15555", "contentUrl": null, "metadataVersion": 2, "schemaVersion": "http://datacite.org/schema/kernel-4", "source": "mds", "isActive": true, "state": "findable", "reason": null, "viewCount": 0, "downloadCount": 0, "referenceCount": 0, "citationCount": 0, "partCount": 0, "partOfCount": 0, "versionCount": 0, "versionOfCount": 0, "created": "2026-06-16T03:26:21Z", "registered": "2026-06-16T03:26:22Z", "published": null, "updated": "2026-10-21T03:18:35Z"}, "relationships": {"client": {"data": {"id": "arxiv.content", "type": "clients"}}}}, {"id": "10.48550/arxiv.2606.17029", "type": "dois", "attributes": {"doi": "10.48550/arxiv.2606.17029", "identifiers": [{"identifier": "2606.17029", "identifierType": "arXiv"}], "creators": [{"nameType": "Personal", "givenName": "Minghang", "familyName": "Zhu", "name": "Zhu, Minghang", "affiliation": [], "nameIdentifiers": []}, {"nameType": "Personal", "givenName": "Chuyang", "familyName": "Wei", "name": "Wei, Chuyang", "affiliation": [], "nameIdentifiers": []}, {"nameType": "Personal", "givenName": "Junhao", "familyName": "Xu", "name": "Xu, Junhao", "affiliation": [], "nameIdentifiers": []}, {"nameType": "Personal", "givenName": "Yilin", "familyName": "Cheng", "name": "Cheng, Yilin", "affiliation": [], "nameIdentifiers": []}, {"nameType": "Personal", "givenName": "Zhumin", "familyName": "Chen", "name": "Chen, Zhumin", "affiliation": [], "nameIdentifiers": []}, {"nameType": "Personal", "givenName": "Jiyan", "familyName": "He", "name": "He, Jiyan", "affiliation": [], "nameIdentifiers": []}], "titles": [{"title": "DEEPRUBRIC: Evidence-Tree Rubric Supervision for Efficient Reinforcement Learning of Deep Research Agents"}], "publisher": "arXiv", "container": {}, "publicationYear": 2026, "subjects": [{"subject": "Computation and Language (cs.CL)", "lang": "en", "subjectScheme": "arXiv"}, {"subject": "FOS: Computer and information sciences", "subjectScheme": "Fields of Science and Technology (FOS)"}], "contributors": [], "dates": [{"date": "2026-06-15T17:52:27Z", "dateType": "Submitted", "dateInformation": "v1"}, {"date": "2026-06-16T02:03:45Z", "dateType": "Updated", "dateInformation": "v1"}, {"date": "2026-10-14T09:24:07Z", "dateType": "Submitted", "dateInformation": "v2"}, {"date": "2026-10-15T00:59:39Z", "dateType": "Updated", "dateInformation": "v2"}, {"date": "2026-06", "dateType": "Available", "dateInformation": "v1"}], "language": null, "types": {"schemaOrg": "CreativeWork", "resourceTypeGeneral": "Preprint", "citeproc": "article", "bibtex": "misc", "ris": "GEN", "resourceType": "Article"}, "relatedIdentifiers": [], "relatedItems": [], "sizes": [], "formats": [], "version": "2", "rightsList": [{"rightsUri": "http://arxiv.org/licenses/nonexclusive-distrib/1.0/", "rights": "arXiv.org perpetual, non-exclusive license"}], "descriptions": [{"descriptionType": "Abstract", "description": "Deep research agents synthesize long-form reports by searching and reasoning over retrieved evidence. Reinforcement learning with rubric-based rewards improves these agents by optimizing them against checkable criteria that translate report quality into reward signals, but its efficiency depends on whether those criteria reliably capture the task scope and evidence needs. Most existing studies ask an LLM to generate rubrics for a given query, but when the model fails to infer the underlying information needs, the generated rubrics may be incomplete and reduce RL efficiency. To obtain more reliable query--rubric supervision, we introduce DeepRubric, a data construction framework that reverses this process: instead of inferring evaluation criteria for a given query, it first determines what an evidence-backed report should be evaluated on and then synthesizes aligned query--rubric pairs from those evaluation targets. Starting from a sampled seed topic, DeepRubric builds an evidence tree by recursively expanding evidence-backed sub-questions, whose leaves serve as atomic and verifiable evaluation targets. It then uses the evidence tree to synthesize the training query and rubrics, ensuring that the reward evaluates exactly the information requested by the query. Using DeepRubric, we construct 9K query--rubric supervision examples and train DeepRubric-8B with rubric-based GRPO, achieving comparable performance to prior open state-of-the-art deep research models across three benchmarks with roughly 13x fewer RL GPU-hours."}, {"descriptionType": "Other", "description": "EMNLP 2026 Main Conference"}], "geoLocations": [], "fundingReferences": [], "url": "https://arxiv.org/abs/2606.17029", "contentUrl": null, "metadataVersion": 1, "schemaVersion": "http://datacite.org/schema/kernel-4", "source": "mds", "isActive": true, "state": "findable", "reason": null, "viewCount": 0, "downloadCount": 0, "referenceCount": 0, "citationCount": 0, "partCount": 0, "partOfCount": 0, "versionCount": 0, "versionOfCount": 0, "created": "2026-06-16T03:58:08Z", "registered": "2026-06-16T03:58:08Z", "published": null, "updated": "2026-10-15T03:15:39Z"}, "relationships": {"client": {"data": {"id": "arxiv.content", "type": "clients"}}}}, {"id": "10.48550/arxiv.2606.16710", "type": "dois", "attributes": {"doi": "10.48550/arxiv.2606.16710", "identifiers": [{"identifier": "2606.16710", "identifierType": "arXiv"}], "creators": [{"nameType": "Personal", "givenName": "Jonas", "familyName": "Becker", "name": "Becker, Jonas", "affiliation": [], "nameIdentifiers": []}, {"nameType": "Personal", "givenName": "Jan Philip", "familyName": "Wahle", "name": "Wahle, Jan Philip", "affiliation": [], "nameIdentifiers": []}, {"nameType": "Personal", "givenName": "Terry", "familyName": "Ruas", "name": "Ruas, Terry", "affiliation": [], "nameIdentifiers": []}, {"nameType": "Personal", "givenName": "Bela", "familyName": "Gipp", "name": "Gipp, Bela", "affiliation": [], "nameIdentifiers": []}], "titles": [{"title": "Misinformation Propagation in Benign Multi-Agent Systems"}], "publisher": "arXiv", "container": {}, "publicationYear": 2026, "subjects": [{"subject": "Multiagent Systems (cs.MA)", "lang": "en", "subjectScheme": "arXiv"}, {"subject": "Computation and Language (cs.CL)", "lang": "en", "subjectScheme": "arXiv"}, {"subject": "FOS: Computer and information sciences", "subjectScheme": "Fields of Science and Technology (FOS)"}, {"subject": "A.1; I.2.7", "lang": "en", "subjectScheme": "ACM"}], "contributors": [], "dates": [{"date": "2026-06-15T13:40:01Z", "dateType": "Submitted", "dateInformation": "v1"}, {"date": "2026-06-16T01:47:18Z", "dateType": "Updated", "dateInformation": "v1"}, {"date": "2026-10-14T09:21:50Z", "dateType": "Submitted", "dateInformation": "v2"}, {"date": "2026-10-15T00:59:30Z", "dateType": "Updated", "dateInformation": "v2"}, {"date": "2026-06", "dateType": "Available", "dateInformation": "v1"}], "language": null, "types": {"schemaOrg": "CreativeWork", "resourceTypeGeneral": "Preprint", "citeproc": "article", "bibtex": "misc", "ris": "GEN", "resourceType": "Article"}, "relatedIdentifiers": [], "relatedItems": [], "sizes": [], "formats": [], "version": "2", "rightsList": [{"rightsIdentifierScheme": "SPDX", "rightsUri": "https://creativecommons.org/licenses/by/4.0/legalcode", "schemeUri": "https://spdx.org/licenses/", "rights": "Creative Commons Attribution 4.0 International", "rightsIdentifier": "cc-by-4.0"}], "descriptions": [{"descriptionType": "Abstract", "description": "Multi-agent systems (MAS) are credited with solving complex problems, yet their agents routinely act on context that may be false. Prior work shows single LLMs are swayed by false context, and MAS can be compromised by adversarial agents persuading peers. We study the benign case: agents follow one protocol, none intends to deceive, but some read a misleading passage. We study it with MINT, 10,278 LLM-written misinformation passages in eight styles, testing three open-weight models on commonsense reasoning, knowledge QA, and moral judgment. A relevant false passage costs a single agent 0.12-0.43 accuracy; irrelevant or content-free passages typically cost at most 0.06. Debate looks robust because uninformed agents outnumber misinformed ones. With one of three misinformed, it is no better than choosing the majority over equally exposed independent samples. Interaction helps only with a misinformed majority, recovering up to 0.24 accuracy over voting (0.29 under consensus). A one-sentence unreliability warning recovers up to 0.18 accuracy under voting (0.28 under consensus), at no significant cost under voting when context is true. Robustness should be judged against exposure-matched baselines, with prompt-level skepticism as cheap first defense."}, {"descriptionType": "Other", "description": "64 pages, 12 figures, 31 tables"}], "geoLocations": [], "fundingReferences": [], "url": "https://arxiv.org/abs/2606.16710", "contentUrl": null, "metadataVersion": 1, "schemaVersion": "http://datacite.org/schema/kernel-4", "source": "mds", "isActive": true, "state": "findable", "reason": null, "viewCount": 0, "downloadCount": 0, "referenceCount": 0, "citationCount": 0, "partCount": 0, "partOfCount": 0, "versionCount": 0, "versionOfCount": 0, "created": "2026-06-16T03:51:14Z", "registered": "2026-06-16T03:51:14Z", "published": null, "updated": "2026-10-15T03:15:38Z"}, "relationships": {"client": {"data": {"id": "arxiv.content", "type": "clients"}}}}, {"id": "10.48550/arxiv.2606.15007", "type": "dois", "attributes": {"doi": "10.48550/arxiv.2606.15007", "identifiers": [{"identifier": "2606.15007", "identifierType": "arXiv"}], "creators": [{"nameType": "Personal", "affiliation": ["Allan"], "familyName": "NVIDIA", "name": "NVIDIA", "nameIdentifiers": []}, {"nameType": "Personal", "affiliation": ["Allan"], "familyName": ":", "name": ":", "nameIdentifiers": []}, {"nameType": "Personal", "affiliation": ["Allan"], "givenName": "Aaron", "familyName": "Blakeman", "name": "Blakeman, Aaron", "nameIdentifiers": []}, {"nameType": "Personal", "affiliation": ["Allan"], "givenName": "Aaron", "familyName": "Thomas", "name": "Thomas, Aaron", "nameIdentifiers": []}, {"nameType": "Personal", "affiliation": ["Allan"], "givenName": "Aastha", "familyName": "Jhunjhunwala", "name": "Jhunjhunwala, Aastha", "nameIdentifiers": []}, {"nameType": "Personal", "affiliation": ["Allan"], "givenName": "Abhibha", "familyName": "Gupta", "name": "Gupta