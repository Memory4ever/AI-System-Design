{"data":{"id":"10.48550/arxiv.2602.13659","type":"dois","attributes":{"doi":"10.48550/arxiv.2602.13659","prefix":"10.48550","suffix":"arxiv.2602.13659","identifiers":[{"identifier":"2602.13659","identifierType":"arXiv"}],"alternateIdentifiers":[{"alternateIdentifierType":"arXiv","alternateIdentifier":"2602.13659"}],"creators":[{"name":"Parfenov, Valery","nameType":"Personal","givenName":"Valery","familyName":"Parfenov","affiliation":[],"nameIdentifiers":[]},{"name":"Evseev, Grigoriy","nameType":"Personal","givenName":"Grigoriy","familyName":"Evseev","affiliation":[],"nameIdentifiers":[]},{"name":"Veprikov, Andrey","nameType":"Personal","givenName":"Andrey","familyName":"Veprikov","affiliation":[],"nameIdentifiers":[]},{"name":"Bushkov, Nikolay","nameType":"Personal","givenName":"Nikolay","familyName":"Bushkov","affiliation":[],"nameIdentifiers":[]},{"name":"Moiseev, Stanislav","nameType":"Personal","givenName":"Stanislav","familyName":"Moiseev","affiliation":[],"nameIdentifiers":[]},{"name":"Beznosikov, Aleksandr","nameType":"Personal","givenName":"Aleksandr","familyName":"Beznosikov","affiliation":[],"nameIdentifiers":[]}],"titles":[{"title":"Zero-Order Optimization for LLM Fine-Tuning via Learnable Direction Sampling"}],"publisher":"arXiv","container":{},"publicationYear":2026,"subjects":[{"lang":"en","subject":"Machine Learning (cs.LG)","subjectScheme":"arXiv"},{"lang":"en","subject":"Optimization and Control (math.OC)","subjectScheme":"arXiv"},{"subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"},{"subject":"FOS: Computer and information sciences","schemeUri":"http://www.oecd.org/science/inno/38235147.pdf","subjectScheme":"Fields of Science and Technology (FOS)"},{"subject":"FOS: Mathematics","subjectScheme":"Fields of Science and Technology (FOS)"},{"subject":"FOS: Mathematics","schemeUri":"http://www.oecd.org/science/inno/38235147.pdf","subjectScheme":"Fields of Science and Technology (FOS)"}],"contributors":[],"dates":[{"date":"2026-02-14T08:01:41Z","dateType":"Submitted","dateInformation":"v1"},{"date":"2026-02-17T01:26:35Z","dateType":"Updated","dateInformation":"v1"},{"date":"2026-02","dateType":"Available","dateInformation":"v1"},{"date":"2026","dateType":"Issued"}],"language":null,"types":{"ris":"GEN","bibtex":"misc","citeproc":"article","schemaOrg":"CreativeWork","resourceType":"Article","resourceTypeGeneral":"Preprint"},"relatedIdentifiers":[],"relatedItems":[],"sizes":[],"formats":[],"version":"1","rightsList":[{"rights":"arXiv.org perpetual, non-exclusive license","rightsUri":"http://arxiv.org/licenses/nonexclusive-distrib/1.0/"}],"descriptions":[{"description":"Fine-tuning large pretrained language models (LLMs) is a cornerstone of modern NLP, yet its growing memory demands (driven by backpropagation and large optimizer States) limit deployment in resource-constrained settings. Zero-order (ZO) methods bypass backpropagation by estimating directional derivatives from forward evaluations, offering substantial memory savings. However, classical ZO estimators suffer from high variance and an adverse dependence on the parameter dimensionality $d$, which has constrained their use to low-dimensional problems. In this work, we propose a policy-driven ZO framework that treats the sampling distribution over perturbation directions as a learnable policy and updates it to reduce the variance of directional estimates. We develop a practical algorithm implementing this idea and provide a theoretical analysis, showing that learned sampling distributions improve the quality of gradient information and relax the explicit dependence on $d$ in convergence bounds. Empirically, we validate the approach on challenging LLM fine-tuning benchmarks, demonstrating substantially improved performance compared to standard ZO baselines. Our results suggest that adaptive direction sampling is a promising route to make ZO fine-tuning viable at scale. The source code is available at https://github.com/brain-lab-research/zo_ldsd","descriptionType":"Abstract"}],"geoLocations":[],"fundingReferences":[],"xml":"","url":"https://arxiv.org/abs/2602.13659","contentUrl":null,"metadataVersion":0,"schemaVersion":"http://datacite.org/schema/kernel-4","source":"mds","isActive":true,"state":"findable","reason":null,"viewCount":0,"viewsOverTime":[],"downloadCount":0,"downloadsOverTime":[],"referenceCount":0,"citationCount":0,"citationsOverTime":[],"partCount":0,"partOfCount":0,"versionCount":0,"versionOfCount":0,"created":"2026-02-17T03:57:02.000Z","registered":"2026-02-17T03:57:03.000Z","published":"2026","updated":"2026-02-17T03:57:03.000Z"},"relationships":{"client":{"data":{"id":"arxiv.content","type":"clients"}},"provider":{"data":{"id":"arxiv","type":"providers"}},"media":{"data":{"id":"10.48550/arxiv.2602.13659","type":"media"}},"references":{"data":[]},"citations":{"data":[]},"parts":{"data":[]},"partOf":{"data":[]},"versions":{"data":[]},"versionOf":{"data":[]}}}}