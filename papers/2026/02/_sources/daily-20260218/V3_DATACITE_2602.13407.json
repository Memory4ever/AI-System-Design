{"data":{"id":"10.48550/arxiv.2602.13407","type":"dois","attributes":{"doi":"10.48550/arxiv.2602.13407","prefix":"10.48550","suffix":"arxiv.2602.13407","identifiers":[{"identifier":"2602.13407","identifierType":"arXiv"}],"alternateIdentifiers":[{"alternateIdentifierType":"arXiv","alternateIdentifier":"2602.13407"}],"creators":[{"name":"Zhao, Anhao","nameType":"Personal","givenName":"Anhao","familyName":"Zhao","affiliation":[],"nameIdentifiers":[]},{"name":"Chen, Ziyang","nameType":"Personal","givenName":"Ziyang","familyName":"Chen","affiliation":[],"nameIdentifiers":[]},{"name":"Tong, Junlong","nameType":"Personal","givenName":"Junlong","familyName":"Tong","affiliation":[],"nameIdentifiers":[]},{"name":"Fan, Yingqi","nameType":"Personal","givenName":"Yingqi","familyName":"Fan","affiliation":[],"nameIdentifiers":[]},{"name":"Ye, Fanghua","nameType":"Personal","givenName":"Fanghua","familyName":"Ye","affiliation":[],"nameIdentifiers":[]},{"name":"Li, Shuhao","nameType":"Personal","givenName":"Shuhao","familyName":"Li","affiliation":[],"nameIdentifiers":[]},{"name":"Ma, Yunpu","nameType":"Personal","givenName":"Yunpu","familyName":"Ma","affiliation":[],"nameIdentifiers":[]},{"name":"Li, Wenjie","nameType":"Personal","givenName":"Wenjie","familyName":"Li","affiliation":[],"nameIdentifiers":[]},{"name":"Shen, Xiaoyu","nameType":"Personal","givenName":"Xiaoyu","familyName":"Shen","affiliation":[],"nameIdentifiers":[]}],"titles":[{"title":"On-Policy Supervised Fine-Tuning for Efficient Reasoning"}],"publisher":"arXiv","container":{},"publicationYear":2026,"subjects":[{"lang":"en","subject":"Artificial Intelligence (cs.AI)","subjectScheme":"arXiv"},{"subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"},{"subject":"FOS: Computer and information sciences","schemeUri":"http://www.oecd.org/science/inno/38235147.pdf","subjectScheme":"Fields of Science and Technology (FOS)"}],"contributors":[],"dates":[{"date":"2026-02-13T19:16:39Z","dateType":"Submitted","dateInformation":"v1"},{"date":"2026-02-17T01:06:07Z","dateType":"Updated","dateInformation":"v1"},{"date":"2026-02","dateType":"Available","dateInformation":"v1"},{"date":"2026","dateType":"Issued"}],"language":null,"types":{"ris":"GEN","bibtex":"misc","citeproc":"article","schemaOrg":"CreativeWork","resourceType":"Article","resourceTypeGeneral":"Preprint"},"relatedIdentifiers":[],"relatedItems":[],"sizes":[],"formats":[],"version":"1","rightsList":[{"rights":"arXiv.org perpetual, non-exclusive license","rightsUri":"http://arxiv.org/licenses/nonexclusive-distrib/1.0/"}],"descriptions":[{"description":"Large reasoning models (LRMs) are commonly trained with reinforcement learning (RL) to explore long chain-of-thought reasoning, achieving strong performance at high computational cost. Recent methods add multi-reward objectives to jointly optimize correctness and brevity, but these complex extensions often destabilize training and yield suboptimal trade-offs. We revisit this objective and challenge the necessity of such complexity. Through principled analysis, we identify fundamental misalignments in this paradigm: KL regularization loses its intended role when correctness and length are directly verifiable, and group-wise normalization becomes ambiguous under multiple reward signals. By removing these two items and simplifying the reward to a truncation-based length penalty, we show that the optimization problem reduces to supervised fine-tuning on self-generated data filtered for both correctness and conciseness. We term this simplified training strategy on-policy SFT. Despite its simplicity, on-policy SFT consistently defines the accuracy-efficiency Pareto frontier. It reduces CoT length by up to 80 while maintaining original accuracy, surpassing more complex RL-based methods across five benchmarks. Furthermore, it significantly enhances training efficiency, reducing GPU memory usage by 50% and accelerating convergence by 70%. Our code is available at https://github.com/EIT-NLP/On-Policy-SFT.","descriptionType":"Abstract"}],"geoLocations":[],"fundingReferences":[],"xml":"","url":"https://arxiv.org/abs/2602.13407","contentUrl":null,"metadataVersion":0,"schemaVersion":"http://datacite.org/schema/kernel-4","source":"mds","isActive":true,"state":"findable","reason":null,"viewCount":0,"viewsOverTime":[],"downloadCount":0,"downloadsOverTime":[],"referenceCount":0,"citationCount":0,"citationsOverTime":[],"partCount":0,"partOfCount":0,"versionCount":0,"versionOfCount":0,"created":"2026-02-17T03:50:43.000Z","registered":"2026-02-17T03:50:44.000Z","published":"2026","updated":"2026-02-17T03:50:44.000Z"},"relationships":{"client":{"data":{"id":"arxiv.content","type":"clients"}},"provider":{"data":{"id":"arxiv","type":"providers"}},"media":{"data":{"id":"10.48550/arxiv.2602.13407","type":"media"}},"references":{"data":[]},"citations":{"data":[]},"parts":{"data":[]},"partOf":{"data":[]},"versions":{"data":[]},"versionOf":{"data":[]}}}}