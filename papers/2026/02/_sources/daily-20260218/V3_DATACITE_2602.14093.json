{"data":{"id":"10.48550/arxiv.2602.14093","type":"dois","attributes":{"doi":"10.48550/arxiv.2602.14093","prefix":"10.48550","suffix":"arxiv.2602.14093","identifiers":[{"identifier":"2602.14093","identifierType":"arXiv"}],"alternateIdentifiers":[{"alternateIdentifierType":"arXiv","alternateIdentifier":"2602.14093"}],"creators":[{"name":"Cao, Yuan","nameType":"Personal","givenName":"Yuan","familyName":"Cao","affiliation":[],"nameIdentifiers":[]},{"name":"Ran, Dezhi","nameType":"Personal","givenName":"Dezhi","familyName":"Ran","affiliation":[],"nameIdentifiers":[]},{"name":"Wu, Mengzhou","nameType":"Personal","givenName":"Mengzhou","familyName":"Wu","affiliation":[],"nameIdentifiers":[]},{"name":"Guo, Yuzhe","nameType":"Personal","givenName":"Yuzhe","familyName":"Guo","affiliation":[],"nameIdentifiers":[]},{"name":"Chen, Xin","nameType":"Personal","givenName":"Xin","familyName":"Chen","affiliation":[],"nameIdentifiers":[]},{"name":"Li, Ang","nameType":"Personal","givenName":"Ang","familyName":"Li","affiliation":[],"nameIdentifiers":[]},{"name":"Cao, Gang","nameType":"Personal","givenName":"Gang","familyName":"Cao","affiliation":[],"nameIdentifiers":[]},{"name":"Zhi, Gong","nameType":"Personal","givenName":"Gong","familyName":"Zhi","affiliation":[],"nameIdentifiers":[]},{"name":"Yu, Hao","nameType":"Personal","givenName":"Hao","familyName":"Yu","affiliation":[],"nameIdentifiers":[]},{"name":"Li, Linyi","nameType":"Personal","givenName":"Linyi","familyName":"Li","affiliation":[],"nameIdentifiers":[]},{"name":"Yang, Wei","nameType":"Personal","givenName":"Wei","familyName":"Yang","affiliation":[],"nameIdentifiers":[]},{"name":"Xie, Tao","nameType":"Personal","givenName":"Tao","familyName":"Xie","affiliation":[],"nameIdentifiers":[]}],"titles":[{"title":"GUI-GENESIS: Automated Synthesis of Efficient Environments with Verifiable Rewards for GUI Agent Post-Training"}],"publisher":"arXiv","container":{},"publicationYear":2026,"subjects":[{"lang":"en","subject":"Artificial Intelligence (cs.AI)","subjectScheme":"arXiv"},{"lang":"en","subject":"Machine Learning (cs.LG)","subjectScheme":"arXiv"},{"subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"},{"subject":"FOS: Computer and information sciences","schemeUri":"http://www.oecd.org/science/inno/38235147.pdf","subjectScheme":"Fields of Science and Technology (FOS)"}],"contributors":[],"dates":[{"date":"2026-02-15T10:58:01Z","dateType":"Submitted","dateInformation":"v1"},{"date":"2026-02-17T01:53:15Z","dateType":"Updated","dateInformation":"v1"},{"date":"2026-02","dateType":"Available","dateInformation":"v1"},{"date":"2026","dateType":"Issued"}],"language":null,"types":{"ris":"GEN","bibtex":"misc","citeproc":"article","schemaOrg":"CreativeWork","resourceType":"Article","resourceTypeGeneral":"Preprint"},"relatedIdentifiers":[],"relatedItems":[],"sizes":[],"formats":[],"version":"1","rightsList":[{"rights":"arXiv.org perpetual, non-exclusive license","rightsUri":"http://arxiv.org/licenses/nonexclusive-distrib/1.0/"}],"descriptions":[{"description":"Post-training GUI agents in interactive environments is critical for developing generalization and long-horizon planning capabilities. However, training on real-world applications is hindered by high latency, poor reproducibility, and unverifiable rewards relying on noisy visual proxies. To address the limitations, we present GUI-GENESIS, the first framework to automatically synthesize efficient GUI training environments with verifiable rewards. GUI-GENESIS reconstructs real-world applications into lightweight web environments using multimodal code models and equips them with code-native rewards, executable assertions that provide deterministic reward signals and eliminate visual estimation noise. Extensive experiments show that GUI-GENESIS reduces environment latency by 10 times and costs by over $28,000 per epoch compared to training on real applications. Notably, agents trained with GUI-GENESIS outperform the base model by 14.54% and even real-world RL baselines by 3.27% on held-out real-world tasks. Finally, we observe that models can synthesize environments they cannot yet solve, highlighting a pathway for self-improving agents.","descriptionType":"Abstract"}],"geoLocations":[],"fundingReferences":[],"xml":"","url":"https://arxiv.org/abs/2602.14093","contentUrl":null,"metadataVersion":0,"schemaVersion":"http://datacite.org/schema/kernel-4","source":"mds","isActive":true,"state":"findable","reason":null,"viewCount":0,"viewsOverTime":[],"downloadCount":0,"downloadsOverTime":[],"referenceCount":0,"citationCount":0,"citationsOverTime":[],"partCount":0,"partOfCount":0,"versionCount":0,"versionOfCount":0,"created":"2026-02-17T04:07:34.000Z","registered":"2026-02-17T04:07:34.000Z","published":"2026","updated":"2026-02-17T04:07:34.000Z"},"relationships":{"client":{"data":{"id":"arxiv.content","type":"clients"}},"provider":{"data":{"id":"arxiv","type":"providers"}},"media":{"data":{"id":"10.48550/arxiv.2602.14093","type":"media"}},"references":{"data":[]},"citations":{"data":[]},"parts":{"data":[]},"partOf":{"data":[]},"versions":{"data":[]},"versionOf":{"data":[]}}}}