{"data":{"id":"10.48550/arxiv.2602.14518","type":"dois","attributes":{"doi":"10.48550/arxiv.2602.14518","prefix":"10.48550","suffix":"arxiv.2602.14518","identifiers":[{"identifier":"2602.14518","identifierType":"arXiv"}],"alternateIdentifiers":[{"alternateIdentifierType":"arXiv","alternateIdentifier":"2602.14518"}],"creators":[{"name":"Tang, Jing","nameType":"Personal","givenName":"Jing","familyName":"Tang","affiliation":[],"nameIdentifiers":[]},{"name":"Wang, Kun","nameType":"Personal","givenName":"Kun","familyName":"Wang","affiliation":[],"nameIdentifiers":[]},{"name":"Lu, Haolang","nameType":"Personal","givenName":"Haolang","familyName":"Lu","affiliation":[],"nameIdentifiers":[]},{"name":"Chen, Hongjin","nameType":"Personal","givenName":"Hongjin","familyName":"Chen","affiliation":[],"nameIdentifiers":[]},{"name":"Chen, KaiTao","nameType":"Personal","givenName":"KaiTao","familyName":"Chen","affiliation":[],"nameIdentifiers":[]},{"name":"Sun, Zhongxiang","nameType":"Personal","givenName":"Zhongxiang","familyName":"Sun","affiliation":[],"nameIdentifiers":[]},{"name":"Li, Qiankun","nameType":"Personal","givenName":"Qiankun","familyName":"Li","affiliation":[],"nameIdentifiers":[]},{"name":"Lyu, Lingjuan","nameType":"Personal","givenName":"Lingjuan","familyName":"Lyu","affiliation":[],"nameIdentifiers":[]},{"name":"Nan, Guoshun","nameType":"Personal","givenName":"Guoshun","familyName":"Nan","affiliation":[],"nameIdentifiers":[]},{"name":"Zeng, Zhigang","nameType":"Personal","givenName":"Zhigang","familyName":"Zeng","affiliation":[],"nameIdentifiers":[]}],"titles":[{"title":"Diagnosing Knowledge Conflict in Multimodal Long-Chain Reasoning"}],"publisher":"arXiv","container":{},"publicationYear":2026,"subjects":[{"lang":"en","subject":"Artificial Intelligence (cs.AI)","subjectScheme":"arXiv"},{"subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"},{"subject":"FOS: Computer and information sciences","schemeUri":"http://www.oecd.org/science/inno/38235147.pdf","subjectScheme":"Fields of Science and Technology (FOS)"}],"contributors":[],"dates":[{"date":"2026-02-16T07:10:44Z","dateType":"Submitted","dateInformation":"v1"},{"date":"2026-02-17T02:19:37Z","dateType":"Updated","dateInformation":"v1"},{"date":"2026-02","dateType":"Available","dateInformation":"v1"},{"date":"2026","dateType":"Issued"}],"language":null,"types":{"ris":"GEN","bibtex":"misc","citeproc":"article","schemaOrg":"CreativeWork","resourceType":"Article","resourceTypeGeneral":"Preprint"},"relatedIdentifiers":[],"relatedItems":[],"sizes":[],"formats":[],"version":"1","rightsList":[{"rights":"arXiv.org perpetual, non-exclusive license","rightsUri":"http://arxiv.org/licenses/nonexclusive-distrib/1.0/"}],"descriptions":[{"description":"Multimodal large language models (MLLMs) in long chain-of-thought reasoning often fail when different knowledge sources provide conflicting signals. We formalize these failures under a unified notion of knowledge conflict, distinguishing input-level objective conflict from process-level effective conflict. Through probing internal representations, we reveal that: (I) Linear Separability: different conflict types are explicitly encoded as linearly separable features rather than entangled; (II) Depth Localization: conflict signals concentrate in mid-to-late layers, indicating a distinct processing stage for conflict encoding; (III) Hierarchical Consistency: aggregating noisy token-level signals along trajectories robustly recovers input-level conflict types; and (IV) Directional Asymmetry: reinforcing the model's implicit source preference under conflict is far easier than enforcing the opposite source. Our findings provide a mechanism-level view of multimodal reasoning under knowledge conflict and enable principled diagnosis and control of long-CoT failures.","descriptionType":"Abstract"}],"geoLocations":[],"fundingReferences":[],"xml":"","url":"https://arxiv.org/abs/2602.14518","contentUrl":null,"metadataVersion":0,"schemaVersion":"http://datacite.org/schema/kernel-4","source":"mds","isActive":true,"state":"findable","reason":null,"viewCount":0,"viewsOverTime":[],"downloadCount":0,"downloadsOverTime":[],"referenceCount":0,"citationCount":0,"citationsOverTime":[],"partCount":0,"partOfCount":0,"versionCount":0,"versionOfCount":0,"created":"2026-02-17T04:18:16.000Z","registered":"2026-02-17T04:18:16.000Z","published":"2026","updated":"2026-02-17T04:18:16.000Z"},"relationships":{"client":{"data":{"id":"arxiv.content","type":"clients"}},"provider":{"data":{"id":"arxiv","type":"providers"}},"media":{"data":{"id":"10.48550/arxiv.2602.14518","type":"media"}},"references":{"data":[]},"citations":{"data":[]},"parts":{"data":[]},"partOf":{"data":[]},"versions":{"data":[]},"versionOf":{"data":[]}}}}