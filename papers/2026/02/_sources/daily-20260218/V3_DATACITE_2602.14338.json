{"data":{"id":"10.48550/arxiv.2602.14338","type":"dois","attributes":{"doi":"10.48550/arxiv.2602.14338","prefix":"10.48550","suffix":"arxiv.2602.14338","identifiers":[{"identifier":"2602.14338","identifierType":"arXiv"}],"alternateIdentifiers":[{"alternateIdentifierType":"arXiv","alternateIdentifier":"2602.14338"}],"creators":[{"name":"Zhang, Zhi","nameType":"Personal","givenName":"Zhi","familyName":"Zhang","affiliation":[],"nameIdentifiers":[]},{"name":"Han, Zhen","nameType":"Personal","givenName":"Zhen","familyName":"Han","affiliation":[],"nameIdentifiers":[]},{"name":"Mavromatis, Costas","nameType":"Personal","givenName":"Costas","familyName":"Mavromatis","affiliation":[],"nameIdentifiers":[]},{"name":"Zhu, Qi","nameType":"Personal","givenName":"Qi","familyName":"Zhu","affiliation":[],"nameIdentifiers":[]},{"name":"Zhang, Yunyi","nameType":"Personal","givenName":"Yunyi","familyName":"Zhang","affiliation":[],"nameIdentifiers":[]},{"name":"Guan, Sheng","nameType":"Personal","givenName":"Sheng","familyName":"Guan","affiliation":[],"nameIdentifiers":[]},{"name":"Wang, Dingmin","nameType":"Personal","givenName":"Dingmin","familyName":"Wang","affiliation":[],"nameIdentifiers":[]},{"name":"Zhou, Xiong","nameType":"Personal","givenName":"Xiong","familyName":"Zhou","affiliation":[],"nameIdentifiers":[]},{"name":"Wang, Shuai","nameType":"Personal","givenName":"Shuai","familyName":"Wang","affiliation":[],"nameIdentifiers":[]},{"name":"Adeshina, Soji","nameType":"Personal","givenName":"Soji","familyName":"Adeshina","affiliation":[],"nameIdentifiers":[]},{"name":"Ioannidis, Vassilis","nameType":"Personal","givenName":"Vassilis","familyName":"Ioannidis","affiliation":[],"nameIdentifiers":[]},{"name":"Rangwala, Huzefa","nameType":"Personal","givenName":"Huzefa","familyName":"Rangwala","affiliation":[],"nameIdentifiers":[]}],"titles":[{"title":"Train Less, Learn More: Adaptive Efficient Rollout Optimization for Group-Based Reinforcement Learning"}],"publisher":"arXiv","container":{},"publicationYear":2026,"subjects":[{"lang":"en","subject":"Machine Learning (cs.LG)","subjectScheme":"arXiv"},{"lang":"en","subject":"Artificial Intelligence (cs.AI)","subjectScheme":"arXiv"},{"subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"},{"subject":"FOS: Computer and information sciences","schemeUri":"http://www.oecd.org/science/inno/38235147.pdf","subjectScheme":"Fields of Science and Technology (FOS)"}],"contributors":[],"dates":[{"date":"2026-02-15T23:14:05Z","dateType":"Submitted","dateInformation":"v1"},{"date":"2026-02-17T02:08:35Z","dateType":"Updated","dateInformation":"v1"},{"date":"2026-02","dateType":"Available","dateInformation":"v1"},{"date":"2026","dateType":"Issued"}],"language":null,"types":{"ris":"GEN","bibtex":"misc","citeproc":"article","schemaOrg":"CreativeWork","resourceType":"Article","resourceTypeGeneral":"Preprint"},"relatedIdentifiers":[],"relatedItems":[],"sizes":[],"formats":[],"version":"1","rightsList":[{"rights":"Creative Commons Attribution 4.0 International","rightsUri":"https://creativecommons.org/licenses/by/4.0/legalcode","schemeUri":"https://spdx.org/licenses/","rightsIdentifier":"cc-by-4.0","rightsIdentifierScheme":"SPDX"}],"descriptions":[{"description":"Reinforcement learning (RL) plays a central role in large language model (LLM) post-training. Among existing approaches, Group Relative Policy Optimization (GRPO) is widely used, especially for RL with verifiable rewards (RLVR) fine-tuning. In GRPO, each query prompts the LLM to generate a group of rollouts with a fixed group size $N$. When all rollouts in a group share the same outcome, either all correct or all incorrect, the group-normalized advantages become zero, yielding no gradient signal and wasting fine-tuning compute. We introduce Adaptive Efficient Rollout Optimization (AERO), an enhancement of GRPO. AERO uses an adaptive rollout strategy, applies selective rejection to strategically prune rollouts, and maintains a Bayesian posterior to prevent zero-advantage dead zones. Across three model configurations (Qwen2.5-Math-1.5B, Qwen2.5-7B, and Qwen2.5-7B-Instruct), AERO improves compute efficiency without sacrificing performance. Under the same total rollout budget, AERO reduces total training compute by about 48% while shortening wall-clock time per step by about 45% on average. Despite the substantial reduction in compute, AERO matches or improves Pass@8 and Avg@8 over GRPO, demonstrating a practical, scalable, and compute-efficient strategy for RL-based LLM alignment.","descriptionType":"Abstract"}],"geoLocations":[],"fundingReferences":[],"xml":"","url":"https://arxiv.org/abs/2602.14338","contentUrl":null,"metadataVersion":0,"schemaVersion":"http://datacite.org/schema/kernel-4","source":"mds","isActive":true,"state":"findable","reason":null,"viewCount":0,"viewsOverTime":[],"downloadCount":0,"downloadsOverTime":[],"referenceCount":0,"citationCount":0,"citationsOverTime":[],"partCount":0,"partOfCount":0,"versionCount":0,"versionOfCount":0,"created":"2026-02-17T04:13:32.000Z","registered":"2026-02-17T04:13:32.000Z","published":"2026","updated":"2026-02-17T04:13:32.000Z"},"relationships":{"client":{"data":{"id":"arxiv.content","type":"clients"}},"provider":{"data":{"id":"arxiv","type":"providers"}},"media":{"data":{"id":"10.48550/arxiv.2602.14338","type":"media"}},"references":{"data":[]},"citations":{"data":[]},"parts":{"data":[]},"partOf":{"data":[]},"versions":{"data":[]},"versionOf":{"data":[]}}}}