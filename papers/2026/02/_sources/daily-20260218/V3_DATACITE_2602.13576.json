{"data":{"id":"10.48550/arxiv.2602.13576","type":"dois","attributes":{"doi":"10.48550/arxiv.2602.13576","prefix":"10.48550","suffix":"arxiv.2602.13576","identifiers":[{"identifier":"2602.13576","identifierType":"arXiv"}],"alternateIdentifiers":[{"alternateIdentifierType":"arXiv","alternateIdentifier":"2602.13576"}],"creators":[{"name":"Ding, Ruomeng","nameType":"Personal","givenName":"Ruomeng","familyName":"Ding","affiliation":[],"nameIdentifiers":[]},{"name":"Pang, Yifei","nameType":"Personal","givenName":"Yifei","familyName":"Pang","affiliation":[],"nameIdentifiers":[]},{"name":"Sun, He","nameType":"Personal","givenName":"He","familyName":"Sun","affiliation":[],"nameIdentifiers":[]},{"name":"Wang, Yizhong","nameType":"Personal","givenName":"Yizhong","familyName":"Wang","affiliation":[],"nameIdentifiers":[]},{"name":"Wu, Zhiwei Steven","nameType":"Personal","givenName":"Zhiwei Steven","familyName":"Wu","affiliation":[],"nameIdentifiers":[]},{"name":"Deng, Zhun","nameType":"Personal","givenName":"Zhun","familyName":"Deng","affiliation":[],"nameIdentifiers":[]}],"titles":[{"title":"Rubrics as an Attack Surface: Stealthy Preference Drift in LLM Judges"}],"publisher":"arXiv","container":{},"publicationYear":2026,"subjects":[{"lang":"en","subject":"Cryptography and Security (cs.CR)","subjectScheme":"arXiv"},{"lang":"en","subject":"Artificial Intelligence (cs.AI)","subjectScheme":"arXiv"},{"lang":"en","subject":"Computation and Language (cs.CL)","subjectScheme":"arXiv"},{"subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"}],"contributors":[],"dates":[{"date":"2026-02-14T03:19:14Z","dateType":"Submitted","dateInformation":"v1"},{"date":"2026-02-17T01:19:02Z","dateType":"Updated","dateInformation":"v1"},{"date":"2026-09-14T12:28:07Z","dateType":"Submitted","dateInformation":"v2"},{"date":"2026-09-15T01:59:15Z","dateType":"Updated","dateInformation":"v2"},{"date":"2026-02","dateType":"Available","dateInformation":"v1"}],"language":null,"types":{"ris":"GEN","bibtex":"misc","citeproc":"article","schemaOrg":"CreativeWork","resourceType":"Article","resourceTypeGeneral":"Preprint"},"relatedIdentifiers":[],"relatedItems":[],"sizes":[],"formats":[],"version":"2","rightsList":[{"rights":"Creative Commons Attribution 4.0 International","rightsUri":"https://creativecommons.org/licenses/by/4.0/legalcode","schemeUri":"https://spdx.org/licenses/","rightsIdentifier":"cc-by-4.0","rightsIdentifierScheme":"SPDX"}],"descriptions":[{"description":"Evaluation and alignment pipelines for large language models increasingly rely on LLM-based judges, whose behavior is guided by natural-language rubrics and validated on benchmarks. We identify a previously under-recognized vulnerability in this workflow, which we term Rubric-Induced Preference Drift (RIPD). Even when rubric edits pass benchmark validation, they can still produce systematic and directional shifts in a judge's preferences on target domains. Because rubrics serve as a high-level decision interface, such drift can emerge from seemingly natural, criterion-preserving edits and remain difficult to detect through aggregate benchmark metrics or limited spot-checking. We further show this vulnerability can be exploited through rubric-based preference attacks, in which benchmark-compliant rubric edits steer judgments away from a fixed human or trusted reference on target domains, systematically inducing RIPD and reducing target-domain accuracy up to 9.5% (helpfulness) and 27.9% (harmlessness). When these judgments are used to generate preference labels for downstream post-training, the induced bias propagates through alignment pipelines and becomes internalized in trained policies. This leads to persistent and systematic drift in model behavior. Overall, our findings highlight evaluation rubrics as a sensitive and manipulable control interface, revealing a system-level alignment risk that extends beyond evaluator reliability alone. The code is available at: https://github.com/ZDCSlab/Rubrics-as-an-Attack-Surface. Warning: Certain sections may contain potentially harmful content that may not be appropriate for all readers.","descriptionType":"Abstract"},{"description":"Accepted at COLM 2026","descriptionType":"Other"}],"geoLocations":[],"fundingReferences":[],"xml":"","url":"https://arxiv.org/abs/2602.13576","contentUrl":null,"metadataVersion":1,"schemaVersion":"http://datacite.org/schema/kernel-4","source":"mds","isActive":true,"state":"findable","reason":null,"viewCount":0,"viewsOverTime":[],"downloadCount":0,"downloadsOverTime":[],"referenceCount":0,"citationCount":0,"citationsOverTime":[],"partCount":0,"partOfCount":0,"versionCount":0,"versionOfCount":0,"created":"2026-02-17T03:54:57.000Z","registered":"2026-02-17T03:54:58.000Z","published":"2026","updated":"2026-09-15T04:44:54.000Z"},"relationships":{"client":{"data":{"id":"arxiv.content","type":"clients"}},"provider":{"data":{"id":"arxiv","type":"providers"}},"media":{"data":{"id":"10.48550/arxiv.2602.13576","type":"media"}},"references":{"data":[]},"citations":{"data":[]},"parts":{"data":[]},"partOf":{"data":[]},"versions":{"data":[]},"versionOf":{"data":[]}}}}