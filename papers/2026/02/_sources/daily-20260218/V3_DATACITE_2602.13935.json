{"data":{"id":"10.48550/arxiv.2602.13935","type":"dois","attributes":{"doi":"10.48550/arxiv.2602.13935","prefix":"10.48550","suffix":"arxiv.2602.13935","identifiers":[{"identifier":"2602.13935","identifierType":"arXiv"}],"alternateIdentifiers":[{"alternateIdentifierType":"arXiv","alternateIdentifier":"2602.13935"}],"creators":[{"name":"Xie, Yangxinyu","nameType":"Personal","givenName":"Yangxinyu","familyName":"Xie","affiliation":[],"nameIdentifiers":[]},{"name":"Wang, Tao","nameType":"Personal","givenName":"Tao","familyName":"Wang","affiliation":[],"nameIdentifiers":[]},{"name":"Mallick, Soham","nameType":"Personal","givenName":"Soham","familyName":"Mallick","affiliation":[],"nameIdentifiers":[]},{"name":"Sun, Yan","nameType":"Personal","givenName":"Yan","familyName":"Sun","affiliation":[],"nameIdentifiers":[]},{"name":"Noarov, Georgy","nameType":"Personal","givenName":"Georgy","familyName":"Noarov","affiliation":[],"nameIdentifiers":[]},{"name":"Yu, Mengxin","nameType":"Personal","givenName":"Mengxin","familyName":"Yu","affiliation":[],"nameIdentifiers":[]},{"name":"Mallick, Tanwi","nameType":"Personal","givenName":"Tanwi","familyName":"Mallick","affiliation":[],"nameIdentifiers":[]},{"name":"Dobriban, Edgar","nameType":"Personal","givenName":"Edgar","familyName":"Dobriban","affiliation":[],"nameIdentifiers":[]}],"titles":[{"title":"Statistical Early Stopping for Reasoning Models"}],"publisher":"arXiv","container":{},"publicationYear":2026,"subjects":[{"lang":"en","subject":"Artificial Intelligence (cs.AI)","subjectScheme":"arXiv"},{"lang":"en","subject":"Machine Learning (cs.LG)","subjectScheme":"arXiv"},{"lang":"en","subject":"Machine Learning (stat.ML)","subjectScheme":"arXiv"},{"subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"}],"contributors":[],"dates":[{"date":"2026-02-15T00:14:53Z","dateType":"Submitted","dateInformation":"v1"},{"date":"2026-02-17T01:42:24Z","dateType":"Updated","dateInformation":"v1"},{"date":"2026-07-22T15:05:27Z","dateType":"Submitted","dateInformation":"v2"},{"date":"2026-07-23T00:52:08Z","dateType":"Updated","dateInformation":"v2"},{"date":"2026-07-24T16:32:28Z","dateType":"Submitted","dateInformation":"v3"},{"date":"2026-07-27T00:48:10Z","dateType":"Updated","dateInformation":"v3"},{"date":"2026-02","dateType":"Available","dateInformation":"v1"}],"language":null,"types":{"ris":"GEN","bibtex":"misc","citeproc":"article","schemaOrg":"CreativeWork","resourceType":"Article","resourceTypeGeneral":"Preprint"},"relatedIdentifiers":[],"relatedItems":[],"sizes":[],"formats":[],"version":"3","rightsList":[{"rights":"arXiv.org perpetual, non-exclusive license","rightsUri":"http://arxiv.org/licenses/nonexclusive-distrib/1.0/"}],"descriptions":[{"description":"While LLMs have seen substantial improvement in reasoning capabilities, they also sometimes overthink, generating unnecessary reasoning steps, particularly under uncertainty, given ill-posed or ambiguous queries. We introduce statistically principled early stopping methods that monitor uncertainty signals during generation to mitigate this issue. Our first approach is parametric: it models inter-arrival times of uncertainty keywords as a renewal process and applies sequential testing for stopping. Our second approach is nonparametric and provides finite-sample guarantees on the probability of halting too early on well-posed queries. We conduct empirical evaluations on reasoning tasks across several domains and models. Our results indicate that uncertainty-aware early stopping can improve both efficiency and reliability in LLM reasoning, and we observe especially significant gains for math reasoning.","descriptionType":"Abstract"}],"geoLocations":[],"fundingReferences":[],"xml":"","url":"https://arxiv.org/abs/2602.13935","contentUrl":null,"metadataVersion":2,"schemaVersion":"http://datacite.org/schema/kernel-4","source":"mds","isActive":true,"state":"findable","reason":null,"viewCount":0,"viewsOv