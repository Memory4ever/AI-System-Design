{"data":{"id":"10.48550/arxiv.2602.14286","type":"dois","attributes":{"doi":"10.48550/arxiv.2602.14286","prefix":"10.48550","suffix":"arxiv.2602.14286","identifiers":[{"identifier":"2602.14286","identifierType":"arXiv"}],"alternateIdentifiers":[{"alternateIdentifierType":"arXiv","alternateIdentifier":"2602.14286"}],"creators":[{"name":"Su, Weijie","nameType":"Personal","givenName":"Weijie","familyName":"Su","affiliation":[],"nameIdentifiers":[]},{"name":"Wang, Ruodu","nameType":"Personal","givenName":"Ruodu","familyName":"Wang","affiliation":[],"nameIdentifiers":[]},{"name":"Zhao, Zinan","nameType":"Personal","givenName":"Zinan","familyName":"Zhao","affiliation":[],"nameIdentifiers":[]}],"titles":[{"title":"Online LLM watermark detection via e-processes"}],"publisher":"arXiv","container":{},"publicationYear":2026,"subjects":[{"lang":"en","subject":"Methodology (stat.ME)","subjectScheme":"arXiv"},{"lang":"en","subject":"Machine Learning (stat.ML)","subjectScheme":"arXiv"},{"subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"},{"subject":"FOS: Computer and information sciences","schemeUri":"http://www.oecd.org/science/inno/38235147.pdf","subjectScheme":"Fields of Science and Technology (FOS)"}],"contributors":[],"dates":[{"date":"2026-02-15T19:37:06Z","dateType":"Submitted","dateInformation":"v1"},{"date":"2026-02-17T02:05:08Z","dateType":"Updated","dateInformation":"v1"},{"date":"2026-03-11T16:32:01Z","dateType":"Submitted","dateInformation":"v2"},{"date":"2026-03-12T01:01:54Z","dateType":"Updated","dateInformation":"v2"},{"date":"2026-03-18T03:26:04Z","dateType":"Submitted","dateInformation":"v3"},{"date":"2026-03-19T00:41:27Z","dateType":"Updated","dateInformation":"v3"},{"date":"2026-04-10T15:05:33Z","dateType":"Submitted","dateInformation":"v4"},{"date":"2026-04-13T00:54:53Z","dateType":"Updated","dateInformation":"v4"},{"date":"2026-02","dateType":"Available","dateInformation":"v1"},{"date":"2026","dateType":"Issued"}],"language":null,"types":{"ris":"GEN","bibtex":"misc","citeproc":"article","schemaOrg":"CreativeWork","resourceType":"Article","resourceTypeGeneral":"Preprint"},"relatedIdentifiers":[],"relatedItems":[],"sizes":[],"formats":[],"version":"4","rightsList":[{"rights":"arXiv.org perpetual, non-exclusive license","rightsUri":"http://arxiv.org/licenses/nonexclusive-distrib/1.0/"}],"descriptions":[{"description":"Watermarking for large language models (LLMs) has emerged as an effective tool for distinguishing AI-generated text from human-written content. Statistically, watermark schemes induce dependence between generated tokens and a pseudo-random sequence, reducing watermark detection to a hypothesis testing problem on independence. We develop a unified framework for LLM watermark detection based on e-processes, providing anytime-valid guarantees for online testing. We propose various methods to construct empirically adaptive e-processes that can enhance the detection power. The proposed methods are applicable to any sequential testing problem where independent pivotal statistics are available. In addition, theoretical results are established to characterize the power properties of the proposed procedures. Some experiments demonstrate that the proposed framework achieves competitive performance compared to existing watermark detection methods.","descriptionType":"Abstract"}],"geoLocations":[],"fundingReferences":[],"xml":"","url":"https://arxiv.org/abs/2602.14286","contentUrl":null,"metadataVersion":3,"schemaVersion":"http://datacite.org/schema/kernel-4","source":"mds","isActive":true,"state":"findable","reason":null,"viewCount":0,"viewsOverTime":[],"downloadCount":0,"downloadsOverTime":[],"referenceCount":0,"citationCount":0,"citationsOverTime":[],"partCount":0,"partOfCount":0,"versionCount":0,"versionOfCount":0,"created":"2026-02-17T04:12:08.000Z","registered":"2026-02-17T04:12:09.000Z","published":"2026","updated":"2026-04-13T02:12:14.000Z"},"relationships"