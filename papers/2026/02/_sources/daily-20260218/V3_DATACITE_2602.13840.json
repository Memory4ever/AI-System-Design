{"data":{"id":"10.48550/arxiv.2602.13840","type":"dois","attributes":{"doi":"10.48550/arxiv.2602.13840","prefix":"10.48550","suffix":"arxiv.2602.13840","identifiers":[{"identifier":"2602.13840","identifierType":"arXiv"}],"alternateIdentifiers":[{"alternateIdentifierType":"arXiv","alternateIdentifier":"2602.13840"}],"creators":[{"name":"Cheng, Yuhan","nameType":"Personal","givenName":"Yuhan","familyName":"Cheng","affiliation":[],"nameIdentifiers":[]},{"name":"Ye, Hancheng","nameType":"Personal","givenName":"Hancheng","familyName":"Ye","affiliation":[],"nameIdentifiers":[]},{"name":"Li, Hai Helen","nameType":"Personal","givenName":"Hai Helen","familyName":"Li","affiliation":[],"nameIdentifiers":[]},{"name":"Sun, Jingwei","nameType":"Personal","givenName":"Jingwei","familyName":"Sun","affiliation":[],"nameIdentifiers":[]},{"name":"Chen, Yiran","nameType":"Personal","givenName":"Yiran","familyName":"Chen","affiliation":[],"nameIdentifiers":[]}],"titles":[{"title":"PrivAct: Internalizing Contextual Privacy Preservation via Multi-Agent Preference Training"}],"publisher":"arXiv","container":{},"publicationYear":2026,"subjects":[{"lang":"en","subject":"Computation and Language (cs.CL)","subjectScheme":"arXiv"},{"subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"}],"contributors":[],"dates":[{"date":"2026-02-14T18:07:51Z","dateType":"Submitted","dateInformation":"v1"},{"date":"2026-02-17T01:36:52Z","dateType":"Updated","dateInformation":"v1"},{"date":"2026-08-17T18:21:53Z","dateType":"Submitted","dateInformation":"v2"},{"date":"2026-08-19T00:04:16Z","dateType":"Updated","dateInformation":"v2"},{"date":"2026-02","dateType":"Available","dateInformation":"v1"}],"language":null,"types":{"ris":"GEN","bibtex":"misc","citeproc":"article","schemaOrg":"CreativeWork","resourceType":"Article","resourceTypeGeneral":"Preprint"},"relatedIdentifiers":[],"relatedItems":[],"sizes":[],"formats":[],"version":"2","rightsList":[{"rights":"Creative Commons Attribution 4.0 International","rightsUri":"https://creativecommons.org/licenses/by/4.0/legalcode","schemeUri":"https://spdx.org/licenses/","rightsIdentifier":"cc-by-4.0","rightsIdentifierScheme":"SPDX"}],"descriptions":[{"description":"Large language model (LLM) agents are increasingly deployed in personalized tasks involving sensitive, context-dependent information, where privacy violations may arise in agents' action due to the implicitness of contextual privacy. Existing approaches rely on external, inference-time interventions which are brittle, scenario-specific, and may expand the privacy attack surface. We propose PrivAct, a contextual privacy-aware multi-agent learning framework that internalizes contextual privacy preservation directly into models' generation behavior for privacy-compliant agentic actions. By embedding privacy preferences into each agent, PrivAct enhances system-wide contextual integrity while achieving a more favorable privacy-helpfulness tradeoff. Experiments across multiple LLM backbones and benchmarks demonstrate consistent improvements in contextual privacy preservation, reducing leakage rates by up to 12.32% while maintaining comparable helpfulness, as well as zero-shot generalization and robustness across diverse multi-agent topologies. Code is available at https://github.com/chengyh23/PrivAct.","descriptionType":"Abstract"},{"description":"Accepted to ICML 2026","descriptionType":"Other"}],"geoLocations":[],"fundingReferences":[],"xml":"","url":"https://arxiv.org/abs/2602.13840","contentUrl":null,"metadataVersion":1,"schemaVersion":"http://datacite.org/schema/kernel-4","source":"mds","isActive":true,"state":"findable","reason":null,"viewCount":0,"viewsOverTime":[],"downloadCount":0,"downloadsOverTime":[],"referenceCount":0,"citationCount":0,"citationsOverTime":[],"partCount":0,"partOfCount":0,"versionCount":0,"versionOfCount":0,"created":"2026-02-17T04:01:33.000Z","registered":"2026-02-17T04:01:33.000Z","published":"2026","updated":"2026-08-19T02:25:58.000Z"},"relationships":{"client":{"data":{"id":"arxiv.content","type":"clients"}},"provider":{"data":{"id":"arxiv","type":"providers"}},"media":{"data":{"id":"10.48550/arxiv.2602.13840","type":"media"}},"references":{"data":[]},"citations":{"data":[]},"parts":{"data":[]},"partOf":{"data":[]},"versions":{"data":[]},"versionOf":{"data":[]}}}}