{"data":{"id":"10.48550/arxiv.2602.13699","type":"dois","attributes":{"doi":"10.48550/arxiv.2602.13699","prefix":"10.48550","suffix":"arxiv.2602.13699","identifiers":[{"identifier":"2602.13699","identifierType":"arXiv"}],"alternateIdentifiers":[{"alternateIdentifierType":"arXiv","alternateIdentifier":"2602.13699"}],"creators":[{"name":"Ostmeier, Sophie","nameType":"Personal","givenName":"Sophie","familyName":"Ostmeier","affiliation":[],"nameIdentifiers":[]},{"name":"Axelrod, Brian","nameType":"Personal","givenName":"Brian","familyName":"Axelrod","affiliation":[],"nameIdentifiers":[]},{"name":"Varma, Maya","nameType":"Personal","givenName":"Maya","familyName":"Varma","affiliation":[],"nameIdentifiers":[]},{"name":"Aali, Asad","nameType":"Personal","givenName":"Asad","familyName":"Aali","affiliation":[],"nameIdentifiers":[]},{"name":"Zhang, Yabin","nameType":"Personal","givenName":"Yabin","familyName":"Zhang","affiliation":[],"nameIdentifiers":[]},{"name":"Paschali, Magdalini","nameType":"Personal","givenName":"Magdalini","familyName":"Paschali","affiliation":[],"nameIdentifiers":[]},{"name":"Koyejo, Sanmi","nameType":"Personal","givenName":"Sanmi","familyName":"Koyejo","affiliation":[],"nameIdentifiers":[]},{"name":"Langlotz, Curtis","nameType":"Personal","givenName":"Curtis","familyName":"Langlotz","affiliation":[],"nameIdentifiers":[]},{"name":"Chaudhari, Akshay","nameType":"Personal","givenName":"Akshay","familyName":"Chaudhari","affiliation":[],"nameIdentifiers":[]}],"titles":[{"title":"Gradient-Stable Attention Heads Signal LLM Correctness"}],"publisher":"arXiv","container":{},"publicationYear":2026,"subjects":[{"lang":"en","subject":"Machine Learning (cs.LG)","subjectScheme":"arXiv"},{"subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"}],"contributors":[],"dates":[{"date":"2026-02-14T09:50:19Z","dateType":"Submitted","dateInformation":"v1"},{"date":"2026-02-17T01:28:52Z","dateType":"Updated","dateInformation":"v1"},{"date":"2026-09-17T20:42:54Z","dateType":"Submitted","dateInformation":"v2"},{"date":"2026-09-21T00:09:51Z","dateType":"Updated","dateInformation":"v2"},{"date":"2026-02","dateType":"Available","dateInformation":"v1"}],"language":null,"types":{"ris":"GEN","bibtex":"misc","citeproc":"article","schemaOrg":"CreativeWork","resourceType":"Article","resourceTypeGeneral":"Preprint"},"relatedIdentifiers":[],"relatedItems":[],"sizes":[],"formats":[],"version":"2","rightsList":[{"rights":"arXiv.org perpetual, non-exclusive license","rightsUri":"http://arxiv.org/licenses/nonexclusive-distrib/1.0/"}],"descriptions":[{"description":"Large language models (LLMs) often generate plausible yet incorrect answers, posing risks in safety-critical settings such as medicine. Human evaluation is expensive, and LLM-as-judge approaches risk introducing hidden errors. Recent single-pass white-box methods detect contextual hallucinations using linear probes over model internals, but their generalization to out-of-domain, out-of-task, and training-free settings remains poorly understood. We introduce HeadEntropy, a method that predicts answer correctness by measuring how susceptible each attention head's pattern is to modification under further gradient updates. The key insight is that the trace of the softmax Jacobian is a monotonic function of 2-Renyi entropy, linking attention spread to gradient stability during training, even without the reference annotation. With no training, HeadEntropy reaches 0.736 AUROC, outperforms every training-free baseline in paired comparison and matches a hidden-state probe out-of-domain, at under 1% of inference cost. We evaluate broadly across 5 instruction-tuned LLMs and 5 datasets spanning general knowledge, multi-hop reasoning, mathematical reasoning, claim verification, and medicine. The code is available at https://github.com/StanfordMIMI/HeadEntropy.","descriptionType":"Abstract"}],"geoLocations":[],"fundingReferences":[],"xml":"","url":"http