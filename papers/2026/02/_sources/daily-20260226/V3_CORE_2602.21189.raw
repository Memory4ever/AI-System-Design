\@add@centering\end{subfigure}\par\vskip 7.97224pt\par\begin{subfigure}[345.0pt]\centering\includegraphics[width=345.0pt]{Figs/deepseek_qwen_threshold_variations_2000_k32/1x3_delta1_0.85_delta2_0.05.pdf}
