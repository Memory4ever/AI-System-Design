<td class="ltx_td ltx_align_right ltx_eqn_cell"><math alttext="\displaystyle\|\nabla^{2}p_{\theta}(x)\|" display="inline"><mrow><mo stretchy="false">‖</mo><mrow><mrow><msup><mo rspace="0.167em">∇</mo><mn>2</mn></msup><msub><mi>p</mi><mi>θ</mi></msub></mrow><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>x</mi><mo stretchy="false">)</mo></mrow></mrow><mo stretchy="false">‖</mo></mrow></math></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math alttext="\displaystyle\leq\mathbb{E}_{y\sim\pi_{\theta}(\cdot|x)}\Big[|r(x,y)|\cdot\,\|\nabla\log\pi_{\theta}(y|x)\|^{2}\Big]+\mathbb{E}_{y\sim\pi_{\theta}(\cdot|x)}\Big[|r(x,y)|\cdot\,\|\nabla^{2}\log\pi_{\theta}(y|x)\|\Big]" class="ltx_math_unparsed" display="inline"><mrow><mo>≤</mo><msub><mi>𝔼</mi><mrow><mi>y</mi><mo>∼</mo><mi>π</mi><msub><mrow></mrow><mi>θ</mi></msub><mo stretchy="false">(</mo><mo lspace="0em" rspace="0em">⋅</mo><mo fence="false" rspace="0.167em" stretchy="false">|</mo><mi>x</mi><mo stretchy="false">)</mo></mrow></msub><mrow><mo maxsize="2.290em" minsize="2.290em">[</mo><mo fence="false" rspace="0.167em" stretchy="false">|</mo><mi>r</mi><mrow><mo stretchy="false">(</mo><mi>x</mi><mo>,</mo><mi>y</mi><mo stretchy="false">)</mo></mrow><mo fence="false" stretchy="false">|</mo><mo lspace="0em">⋅</mo><mo lspace="0em" rspace="0.167em">∥</mo><mo rspace="0.167em">∇</mo><mi>log</mi><msub><mi>π</mi><mi>θ</mi></msub><mrow><mo stretchy="false">(</mo><mi>y</mi><mo fence="false" rspace="0.167em" stretchy="false">|</mo><mi>x</mi><mo stretchy="false">)</mo></mrow><msup><mo lspace="0em" rspace="0.167em">∥</mo><mn>2</mn></msup><mo maxsize="2.290em" minsize="2.290em">]</mo></mrow><mo>+</mo><msub><mi>𝔼</mi><mrow><mi>y</mi><mo>∼</mo><mi>π</mi><msub><mrow></mrow><mi>θ</mi></msub><mo stretchy="false">(</mo><mo lspace="0em" rspace="0em">⋅</mo><mo fence="false" rspace="0.167em" stretchy="false">|</mo><mi>x</mi><mo stretchy="false">)</mo></mrow></msub><mrow><mo maxsize="2.290em" minsize="2.290em">[</mo><mo fence="false" rspace="0.167em" stretchy="false">|</mo><mi>r</mi><mrow><mo stretchy="false">(</mo><mi>x</mi><mo>,</mo><mi>y</mi><mo stretchy="false">)</mo></mrow><mo fence="false" stretchy="false">|</mo><mo lspace="0em">⋅</mo><mo lspace="0em" rspace="0.167em">∥</mo><msup><mo rspace="0.167em">∇</mo><mn>2</mn></msup><mi>log</mi><msub><mi>π</mi><mi>θ</mi></msub><mrow><mo stretchy="false">(</mo><mi>y</mi><mo fence="false" rspace="0.167em" stretchy="false">|</mo><mi>x</mi><mo stretchy="false">)</mo></mrow><mo lspace="0em" rspace="0.167em">∥</mo><mo maxsize="2.290em" minsize="2.290em">]</mo></mrow></mrow></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
