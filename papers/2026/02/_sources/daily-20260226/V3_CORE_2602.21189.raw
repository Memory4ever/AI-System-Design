                                          </mtext><mi>T</mi><mi>h</mi><mi>e</mi><mi>n</mi><mi>i</mi><mi>t</mi><mi>i</mi><mi>m</mi><mi>m</mi><mi>e</mi><mi>d</mi><mi>i</mi><mi>a</mi><mi>t</mi><mi>e</mi><mi>l</mi><mi>y</mi><mi>f</mi><mi>o</mi><mi>l</mi><mi>l</mi><mi>o</mi><mi>w</mi><mi>s</mi><mi>t</mi><mi>h</mi><mi>a</mi><mi>t</mi><mo lspace="0.278em" rspace="0.278em">:</mo><mtable columnspacing="0pt" rowspacing="0pt"><mtr><mtd class="ltx_align_right" columnalign="right"><mrow><mo maxsize="1.430em" minsize="1.430em" stretchy="true">⟨</mo><mrow><mrow><mrow><mo rspace="0.167em">∇</mo><msub><mi>J</mi><mi>k</mi></msub></mrow><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>θ</mi><mo stretchy="false">)</mo></mrow></mrow><mo>,</mo><mrow><mrow><mo rspace="0.167em">∇</mo><msub><mi>J</mi><mn>1</mn></msub></mrow><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>θ</mi><mo stretchy="false">)</mo></mrow></mrow></mrow><mo maxsize="1.430em" minsize="1.430em" stretchy="true">⟩</mo></mrow></mtd><mtd class="ltx_align_left" columnalign="left"><mrow><mo>=</mo><mo maxsize="1.430em" minsize="1.430em" stretchy="true">⟨</mo><mi>𝔼</mi><msub><mrow></mrow><mrow><mi>x</mi><mo>∼</mo><mi class="ltx_font_mathcaligraphic">𝒟</mi></mrow></msub><mo stretchy="false">[</mo><mi>w</mi><msub><mrow></mrow><mi>k</mi></msub><mo stretchy="false">(</mo><mi>p</mi><msub><mrow></mrow><mi>θ</mi></msub><mo stretchy="false">(</mo><mi>x</mi><mo stretchy="false">)</mo><mo rspace="0.167em" stretchy="false">)</mo><mo rspace="0.167em">∇</mo><mi>J</mi><msub><mrow></mrow><mn>1</mn></msub><mo stretchy="false">(</mo><mi>x</mi><mo>;</mo><mi>θ</mi><mo stretchy="false">)</mo><mo stretchy="false">]</mo><mo>,</mo><mo rspace="0.167em">∇</mo><mi>J</mi><msub><mrow></mrow><mn>1</mn></msub><mo stretchy="false">(</mo><mi>θ</mi><mo stretchy="false">)</mo><mo maxsize="1.430em" minsize="1.430em" stretchy="true">⟩</mo></mrow></mtd></mtr><mtr><mtd></mtd><mtd class="ltx_align_left" columnalign="lef