<td id="S4.T1.2.11.2" class="ltx_td ltx_align_center ltx_border_b"><span id="S4.T1.2.11.2.1" class="ltx_text ltx_font_bold" style="--ltx-bg-color:#F2F2F2;">77.0</span></td>
<td id="S4.T1.2.11.3" class="ltx_td ltx_align_center ltx_border_b"><span id="S4.T1.2.11.3.1" class="ltx_text ltx_underline" style="--ltx-bg-color:#F2F2F2;">81.5</span></td>
<td id="S4.T1.2.11.4" class="ltx_td ltx_align_center ltx_border_b"><span id="S4.T1.2.11.4.1" class="ltx_text ltx_font_bold" style="--ltx-bg-color:#F2F2F2;">77.8</span></td>
