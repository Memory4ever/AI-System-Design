<td id="S5.T5.2.1.8.4" class="ltx_td ltx_align_center ltx_border_b"><span id="S5.T5.2.1.8.4.1" class="ltx_text" style="--ltx-bg-color:#F2F2F2;">2.16</span></td>
<td id="S5.T5.2.1.8.5" class="ltx_td ltx_align_center ltx_border_b"><span id="S5.T5.2.1.8.5.1" class="ltx_text" style="--ltx-bg-color:#F2F2F2;">64.1</span></td></tr>
