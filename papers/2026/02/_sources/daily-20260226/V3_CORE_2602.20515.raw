            <math id="alg1.l4.m1" class="ltx_Math" alttext="d_{JS}" display="inline" intent=":literal"><semantics><msub><mi>d</mi><mrow><mi>J</mi><mo lspace="0em" rspace="0em">​</mo><mi>S</mi></mrow></msub><annotation encoding="application/x-tex">d_{JS}</annotation></semantics></math> <math id="alg1.l4.m2" class="ltx_Math" alttext="\leftarrow" display="inline" intent=":literal"><semantics><mo stretchy="false">←</mo><annotation encoding="application/x-tex">\leftarrow</annotation></semantics></math> <math id="alg1.l4.m3" class="ltx_Math" alttext="\sqrt{JSD(\bar{a}||\hat{a})}" display="inline" intent=":literal"><semantics><msqrt><mrow><mi>J</mi><mi>S</mi><mi>D</mi><mo stretchy="false">(</mo><mover accent="true"><mi>a</mi><mo>¯</mo></mover><mo fence="false" rspace="0.167em" stretchy="false">|</mo><mo fence="false" rspace="0.167em" stretchy="false">|</mo><mover accent="true"><mi>a</mi><mo>^</mo></mover><mo stretchy="false">)</mo></mrow></msqrt><annotation encoding="application/x-tex">\sqrt{JSD(\bar{a}||\hat{a})}</annotation></semantics></math>
<span id="alg1.l4.2" class="ltx_text" style="--ltx-fg-color:#0000FF;float:right;"><math id="alg1.l4.m4" class="ltx_Math" alttext="\triangleright" display="inline" intent=":literal"><semantics><mo style="--ltx-fg-color:#0000FF;" mathcolor="#0000FF">⊳</mo><annotation encoding="application/x-tex">\triangleright</annotation></semantics></math> Jensen-Shannon divergence<span id="alg1.l4.2.1" class="ltx_text" style="--ltx-fg-color:#000000;">
</span></span>
</div>
