            <math id="alg1.l19.m1" class="ltx_math_unparsed" alttext="S_{s}\leftarrow I_{s}[1:K_{s}]" display="inline" intent=":literal"><semantics><mrow><msub><mi>S</mi><mi>s</mi></msub><mo stretchy="false">←</mo><msub><mi>I</mi><mi>s</mi></msub><mrow><mo stretchy="false">[</mo><mn>1</mn><mo lspace="0.278em" rspace="0.278em">:</mo><msub><mi>K</mi><mi>s</mi></msub><mo stretchy="false">]</mo></mrow></mrow><annotation encoding="application/x-tex">S_{s}\leftarrow I_{s}[1:K_{s}]</annotation></semantics></math>

