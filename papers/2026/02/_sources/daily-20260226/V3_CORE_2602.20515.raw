</div>
<div id="alg1.l16" class="ltx_listingline">
              <span class="ltx_tag ltx_tag_listingline"><span id="alg1.l16.1" class="ltx_text" style="font-size:80%;">16:</span></span>
              
            <math id="alg1.l16.m1" class="ltx_Math" alttext="K_{v}\leftarrow" display="inline" intent=":literal"><semantics><mrow><msub><mi>K</mi><mi>v</mi></msub><mo stretchy="false">←</mo><mphantom></mphantom></mrow><annotation encoding="application/x-tex">K_{v}\leftarrow</annotation></semantics></math> min({<math id="alg1.l16.m2" class="ltx_math_unparsed" alttext="k:\Sigma_{i\in I_{v}[1:k]}a_{v}[i]\geq\gamma" display="inline" intent=":literal"><semantics><mrow><mi>k</mi><mo lspace="0.278em" rspace="0.278em">:</mo><msub><mi mathvariant="normal">Σ</mi><mrow><mi>i</mi><mo>∈</mo><mi>I</mi><msub><mrow></mrow><mi>v</mi></msub><mo stretchy="false">[</mo><mn>1</mn><mo lspace="0.278em" rspace="0.278em">:</mo><mi>k</mi><mo stretchy="false">]</mo></mrow></msub><msub><mi>a</mi><mi>v</mi></msub><mrow><mo stretchy="false">[</mo><mi>i</mi><mo stretchy="false">]</mo></mrow><mo>≥</mo><mi>γ</mi></mrow><annotation encoding="application/x-tex">k:\Sigma_{i\in I_{v}[1:k]}a_{v}[i]\geq\gamma</annotation></semantics></math>} <span id="alg1.l16.2" class="ltx_text" style="--ltx-fg-color:#0000FF;float:right;"><math id="alg1.l16.m3" class="ltx_Math" alttext="\triangleright" display="inline" intent=":literal"><semantics><mo style="--ltx-fg-color:#0000FF;" mathcolor="#0000FF">⊳</mo><annotation encoding="application/x-tex">\triangleright</annotation></semantics></math> minimum computational budget making the sum of the scores exceeds <math id="alg1.l16.m4" class="ltx_Math" alttext="\gamma" display="inline" intent=":literal"><semantics><mi style="--ltx-fg-color:#0000FF;" mathcolor="#0000FF">γ</mi><annotation encoding="application/x-tex">\gamma</annotation></semantics></math> <span id="alg1.l16.2.1" class="ltx_text" style="--ltx-fg-color:#000000;">
</span></span>
</div>
<div id="alg1.l17" class="ltx_listingline">
              <span class="ltx_tag ltx_tag_listingline"><span id="alg1.l17.1" class="ltx_text" style="font-size:80%;">17:</span></span>
              
            <math id="alg1.l17.m1" class="ltx_Math" alttext="K_{s}\leftarrow" display="inline" intent=":literal"><semantics><mrow><msub><mi>K</mi><mi>s</mi></msub><mo stretchy="false">←</mo><mphantom></mphantom></mrow><annotation encoding="application/x-tex">K_{s}\leftarrow</annotation></semantics></math> min({<math id="alg1.l17.m2" class="ltx_math_unparsed" alttext="k:\Sigma_{i\in I_{s}[1:k]}a_{s}[i]\geq\gamma" display="inline" intent=":literal"><semantics><mrow><mi>k</mi><mo lspace="0.278em" rspace="0.278em">:</mo><msub><mi mathvariant="normal">Σ</mi><mrow><mi>i</mi><mo>∈</mo><mi>I</mi><msub><mrow></mrow><mi>s</mi></msub><mo stretchy="false">[</mo><mn>1</mn><mo lspace="0.278em" rspace="0.278em">:</mo><mi>k</mi><mo stretchy="false">]</mo></mrow></msub><msub><mi>a</mi><mi>s</mi></msub><mrow><mo stretchy="false">[</mo><mi>i</mi><mo stretchy="false">]</mo></mrow><mo>≥</mo><mi>γ</mi></mrow><annotation encoding="application/x-tex">k:\Sigma_{i\in I_{s}[1:k]}a_{s}[i]\geq\gamma</annotation></semantics></math>}

</div>
<div id="alg1.l18" class="ltx_listingline">
              <span class="ltx_tag ltx_tag_listingline"><span id="alg1.l18.1" class="ltx_text" style="font-size:80%;">18:</span></span>
              
            <math id="alg1.l18.m1" class="ltx_math_unparsed" alttext="S_{v}\leftarrow I_{v}[1:K_{v}]" display="inline" intent=":literal"><semantics><mrow><msub><mi>S</mi><mi>v</mi></msub><mo stretchy="false">←</mo><msub><mi>I</mi><mi>v</mi></msub><mrow><mo stretchy="false">[</mo><mn>1</mn><mo lspace="0.278em" rspace="0.278em">:</mo><msub><mi>K</mi><mi>v</mi></msub><mo stretchy="false">]</mo></mrow></mrow><annotation encoding="application/x-tex">S_{v}\leftarrow I_{v}[1:K_{v}]</annotation></semantics></math> <span id="alg1.l18.2" class="ltx_text" style="--ltx-fg-color:#0000FF;float:right;"><math id="alg1.l18.m2" class="ltx_Math" alttext="\triangleright" display="inline" intent=":literal"><semantics><mo style="--ltx-fg-color:#0000FF;" mathcolor="#0000FF">⊳</mo><annotation encoding="application/x-tex">\triangleright</annotation></semantics></math> Select indices<span id="alg1.l18.2.1" class="ltx_text" style="--ltx-fg-color:#000000;">
</span></span>
</div>
