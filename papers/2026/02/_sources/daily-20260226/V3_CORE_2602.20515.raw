<div id="alg1.l14" class="ltx_listingline">
              <span class="ltx_tag ltx_tag_listingline"><span id="alg1.l14.1" class="ltx_text" style="font-size:80%;">14:</span></span>
              
            <math id="alg1.l14.m1" class="ltx_Math" alttext="I_{v}\leftarrow" display="inline" intent=":literal"><semantics><mrow><msub><mi>I</mi><mi>v</mi></msub><mo stretchy="false">←</mo><mphantom></mphantom></mrow><annotation encoding="application/x-tex">I_{v}\leftarrow</annotation></semantics></math> argsort(<math id="alg1.l14.m2" class="ltx_Math" alttext="a_{v}" display="inline" intent=":literal"><semantics><msub><mi>a</mi><mi>v</mi></msub><annotation encoding="application/x-tex">a_{v}</annotation></semantics></math>) <span id="alg1.l14.2" class="ltx_text" style="--ltx-fg-color:#0000FF;float:right;"><math id="alg1.l14.m3" class="ltx_Math" alttext="\triangleright" display="inline" intent=":literal"><semantics><mo style="--ltx-fg-color:#0000FF;" mathcolor="#0000FF">⊳</mo><annotation encoding="application/x-tex">\triangleright</annotation></semantics></math> Sort vertical and slash attention scores<span id="alg1.l14.2.1" class="ltx_text" style="--ltx-fg-color:#000000;">
