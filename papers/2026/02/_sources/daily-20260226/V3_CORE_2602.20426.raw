</span>
</span></span></span></span></foreignObject></g></g></svg></span><code id="A2.SS1.SSS0.Px2.p2.1.1" class="ltx_verbatim"><span class="ltx_inline-block"><svg id="A2.SS1.SSS0.Px2.p2.pic2" class="ltx_picture" height="48.53" overflow="visible" version="1.1" viewBox="0 0 477.38 48.53" width="477.38"><g style="--ltx-stroke-color:#000000;--ltx-fill-color:#000000;" fill="#000000" stroke="#000000" stroke-width="0.4pt" transform="translate(0,48.53) matrix(1 0 0 -1 0 0)"><g style="--ltx-fill-color:#000000;" fill="#000000" fill-opacity="1.0"><path style="stroke:none" d="M 0 5.32 L 0 43.21 C 0 46.15 2.38 48.53 5.32 48.53 L 472.06 48.53 C 474.99 48.53 477.38 46.15 477.38 43.21 L 477.38 5.32 C 477.38 2.38 474.99 0 472.06 0 L 5.32 0 C 2.38 0 0 2.38 0 5.32 Z"></path></g><g style="--ltx-fill-color:#D3D3D3;" fill="#D3D3D3" fill-opacity="1.0"><path style="stroke:none" d="M 1.38 5.32 L 1.38 24.05 L 475.99 24.05 L 475.99 5.32 C 475.99 3.15 474.23 1.38 472.06 1.38 L 5.32 1.38 C 3.15 1.38 1.38 3.15 1.38 5.32 Z"></path></g><g fill-opacity="1.0" transform="matrix(1.0 0.0 0.0 1.0 9.26 32.83)"><foreignObject style="--ltx-fo-width:33.16em;--ltx-fo-height:0.75em;--ltx-fo-depth:0.25em;font-size:10pt;" height="13.84" overflow="visible" transform="matrix(1 0 0 -1 0 10.38)" width="458.84"><span class="ltx_foreignobject_container"><span class="ltx_foreignobject_content">
