</span></span></span></foreignObject></g><g fill-opacity="1.0" transform="matrix(1.0 0.0 0.0 1.0 9.26 10.99)"><foreignObject style="--ltx-fo-width:63.16em;--ltx-fo-height:0.38em;--ltx-fo-depth:0.13em;font-size:10pt;" height="6.92" overflow="visible" transform="matrix(1 0 0 -1 0 5.19)" width="873.96"><span class="ltx_foreignobject_container"><span class="ltx_foreignobject_content"><span id="A2.SS1.SSS0.Px2.p2.pic3.2" class="ltx_inline-logical-block ltx_minipage ltx_align_bottom" style="width:63.16em;">
