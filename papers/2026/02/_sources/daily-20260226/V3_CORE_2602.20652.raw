<th id="A7.T4.3.1.1.5" class="ltx_td ltx_align_right ltx_th ltx_th_column ltx_border_tt" style="padding-left:4.0pt;padding-right:4.0pt;"><span id="A7.T4.3.1.1.5.1" class="ltx_text" style="font-size:90%;">Accuracy</span></th>
