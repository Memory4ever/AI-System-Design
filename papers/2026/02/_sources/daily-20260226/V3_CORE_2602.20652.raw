<th id="A7.T4.3.1.1.8" class="ltx_td ltx_align_right ltx_th ltx_th_column ltx_border_tt" style="padding-left:4.0pt;padding-right:4.0pt;"><span id="A7.T4.3.1.1.8.1" class="ltx_text" style="font-size:90%;">CCV</span></th></tr>
</thead>
<tbody class="ltx_tbody">
<tr id="A7.T4.3.1.2" class="ltx_tr">
<td id="A7.T4.3.1.2.1" class="ltx_td ltx_align_left ltx_border_t" style="padding-left:4.0pt;padding-right:4.0pt;" rowspan="9"><span id="A7.T4.3.1.2.1.1" class="ltx_text" style="font-size:90%;">Imagenet</span></td>
<td id="A7.T4.3.1.2.2" class="ltx_td ltx_align_right ltx_border_t" style="padding-left:4.0pt;padding-right:4.0pt;" rowspan="9"><span id="A7.T4.3.1.2.2.1" class="ltx_text" style="font-size:90%;">1000</span></td>
<td id="A7.T4.3.1.2.3" class="ltx_td ltx_align_right ltx_border_t" style="padding-left:4.0pt;padding-right:4.0pt;" rowspan="9"><span id="A7.T4.3.1.2.3.1" class="ltx_text" style="font-size:90%;">10000</span></td>
<td id="A7.T4.3.1.2.4" class="ltx_td ltx_align_left ltx_border_t" style="padding-left:4.0pt;padding-right:4.0pt;"><span id="A7.T4.3.1.2.4.1" class="ltx_text" style="font-size:90%;">DANCE (Ours)</span></td>
<td id="A7.T4.3.1.2.5" class="ltx_td ltx_align_right ltx_border_t" style="padding-left:4.0pt;padding-right:4.0pt;"><span id="A7.T4.3.1.2.5.1" class="ltx_text" style="font-size:90%;">0.729</span></td>
<td id="A7.T4.3.1.2.6" class="ltx_td ltx_align_right ltx_border_t" style="padding-left:4.0pt;padding-right:4.0pt;"><span id="A7.T4.3.1.2.6.1" class="ltx_text" style="font-size:90%;">10.75</span></td>
<td id="A7.T4.3.1.2.7" class="ltx_td ltx_align_right ltx_border_t" style="padding-left:4.0pt;padding-right:4.0pt;"><span id="A7.T4.3.1.2.7.1" class="ltx_text" style="font-size:90%;">0.953</span></td>
<td id="A7.T4.3.1.2.8" class="ltx_td ltx_align_right ltx_border_t" style="padding-left:4.0pt;padding-right:4.0pt;"><span id="A7.T4.3.1.2.8.1" class="ltx_text" style="font-size:90%;">6.450</span></td></tr>
<tr id="A7.T4.3.1.3" class="ltx_tr">
<td id="A7.T4.3.1.3.1" class="ltx_td ltx_align_left" style="padding-left:4.0pt;padding-right:4.0pt;"><math id="A7.T4.m1" class="ltx_Math" alttext="k" display="inline" intent=":literal"><semantics><mi mathsize="0.900em">k</mi><annotation encoding="application/x-tex">k</annotation></semantics></math><span id="A7.T4.3.1.3.1.1" class="ltx_text" style="font-size:90%;">-NN Set (Ours)</span></td>
<td id="A7.T4.3.1.3.2" class="ltx_td ltx_align_right" style="padding-left:4.0pt;padding-right:4.0pt;"><span id="A7.T4.3.1.3.2.1" class="ltx_text" style="font-size:90%;">0.729</span></td>
<td id="A7.T4.3.1.3.3" class="ltx_td ltx_align_right" style="padding-left:4.0pt;padding-right:4.0pt;"><span id="A7.T4.3.1.3.3.1" class="ltx_text" style="font-size:90%;">10.75</span></td>
<td id="A7.T4.3.1.3.4" class="ltx_td ltx_align_right" style="padding-left:4.0pt;padding-right:4.0pt;"><span id="A7.T4.3.1.3.4.1" class="ltx_text" style="font-size:90%;">0.953</span></td>
<td id="A7.T4.3.1.3.5" class="ltx_td ltx_align_right" style="padding-left:4.0pt;padding-right:4.0pt;"><span id="A7.T4.3.1.3.5.1" class="ltx_text" style="font-size:90%;">6.450</span></td></tr>
