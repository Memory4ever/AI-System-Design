<section id="A1" class="ltx_appendix">
<h2 class="ltx_title ltx_title_appendix"><span class="ltx_tag ltx_tag_appendix">Appendix A </span>DANCE Algorithm</h2>

<figure id="alg1" class="ltx_float ltx_float_algorithm ltx_framed ltx_framed_top">
<figcaption class="ltx_caption"><span class="ltx_tag ltx_tag_float"><span id="alg1.3" class="ltx_text ltx_font_bold">Algorithm 1</span> </span> DANCE Conformal Label Sets</figcaption>
<div id="alg1.4" class="ltx_listing ltx_framed ltx_framed_topbottom ltx_listing">
<div id="alg1.l1" class="ltx_listingline">
            <span class="ltx_tag ltx_tag_listingline"><span id="alg1.l1.1" class="ltx_text" style="font-size:80%;">1:</span></span>
            
            
           <span id="alg1.l1.3" class="ltx_text ltx_font_bold">Input:</span> Reference embeddings <math id="alg1.l1.m1" class="ltx_Math" alttext="\mathbf{Z}_{ref}" display="inline" intent=":literal"><semantics><msub><mi>𝐙</mi><mrow><mi>r</mi><mo lspace="0em" rspace="0em">​</mo><mi>e</mi><mo lspace="0em" rspace="0em">​</mo><mi>f</mi></mrow></msub><annotation encoding="application/x-tex">\mathbf{Z}_{ref}</annotation></semantics></math>, Calibration embeddings <math id="alg1.l1.m2" class="ltx_Math" alttext="\mathbf{Z}_{Cal}" display="inline" intent=":literal"><semantics><msub><mi>𝐙</mi><mrow><mi>C</mi><mo lspace="0em" rspace="0em">​</mo><mi>a</mi><mo lspace="0em" rspace="0em">​</mo><mi>l</mi></mrow></msub><annotation encoding="application/x-tex">\mathbf{Z}_{Cal}</annotation></semantics></math>, calibration labels <math id="alg1.l1.m3" class="ltx_Math" alttext="\mathbf{y}_{Cal}" display="inline" intent=":literal"><semantics><msub><mi>𝐲</mi><mrow><mi>C</mi><mo lspace="0em" rspace="0em">​</mo><mi>a</mi><mo lspace="0em" rspace="0em">​</mo><mi>l</mi></mrow></msub><annotation encoding="application/x-tex">\mathbf{y}_{Cal}</annotation></semantics></math>, test embedding <math id="alg1.l1.m4" class="ltx_Math" alttext="\mathbf{Z}_{n+1}" display="inline" intent=":literal"><semantics><msub><mi>𝐙</mi><mrow><mi>n</mi><mo>+</mo><mn>1</mn></mrow></msub><annotation encoding="application/x-tex">\mathbf{Z}_{n+1}</annotation></semantics></math>, learned Kernel <math id="alg1.l1.m5" class="ltx_math_unparsed" alttext="K_{M}(.)" display="inline" intent=":literal"><semantics><mrow><msub><mi>K</mi><mi>M</mi></msub><mrow><mo stretchy="false">(</mo><mo lspace="0em" rspace="0.167em">.</mo><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">K_{M}(.)</annotation></semantics></math>, total error <math id="alg1.l1.m6" class="ltx_Math" alttext="\alpha" display="inline" intent=":literal"><semantics><mi>α</mi><annotation encoding="application/x-tex">\alpha</annotation></semantics></math>, error allocation parameter <math id="alg1.l1.m7" class="ltx_Math" alttext="\lambda" display="inline" intent=":literal"><semantics><mi>λ</mi><annotation encoding="application/x-tex">\lambda</annotation></semantics></math>

</div>
<div id="alg1.l2" class="ltx_listingline">
            <span class="ltx_tag ltx_tag_listingline"><span id="alg1.l2.1" class="ltx_text" style="font-size:80%;">2:</span></span>
            
            
