</figure></div><div class="ltx_flex_cell ltx_flex_size_4">
<figure id="A7.F11.sf8" class="ltx_figure ltx_figure_panel ltx_align_center"><img src="2602.20517v1/conds/Aligning/Begin_with_a_swift_side_approach,_then_slow_down_to_ensure_precise_alignment..png" id="A7.F11.sf8.g1" class="ltx_graphics ltx_img_square" style="aspect-ratio:115/115;" width="115" height="115" alt="Refer to caption">
