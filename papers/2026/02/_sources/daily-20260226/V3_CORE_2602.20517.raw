<td id="S4.SS2.SSS2.p2.1.1.3.3" class="ltx_td ltx_align_center"><span id="S4.SS2.SSS2.p2.1.1.3.3.1" class="ltx_text ltx_font_bold">151.8 <math id="S4.SS2.SSS2.m3" class="ltx_Math" alttext="\pm" display="inline" intent=":literal"><semantics><mo>±</mo><annotation encoding="application/x-tex">\pm</annotation></semantics></math> 2.45</span></td></tr>
