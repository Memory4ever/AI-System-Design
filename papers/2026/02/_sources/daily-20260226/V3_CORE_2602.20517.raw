<td id="A7.T5.5.1.1.4" class="ltx_td ltx_align_center ltx_border_tt"><math id="A7.T5.m2" class="ltx_Math" alttext="t_{0}" display="inline" intent=":literal"><semantics><msub><mi>t</mi><mn>0</mn></msub><annotation encoding="application/x-tex">t_{0}</annotation></semantics></math></td>
<td id="A7.T5.5.1.1.5" class="ltx_td ltx_align_center ltx_border_r ltx_border_tt"><math id="A7.T5.m3" class="ltx_Math" alttext="W" display="inline" intent=":literal"><semantics><mi>W</mi><annotation encoding="application/x-tex">W</annotation></semantics></math></td>
<td id="A7.T5.5.1.1.6" class="ltx_td ltx_align_center ltx_border_tt">Success rate <math id="A7.T5.m4" class="ltx_Math" alttext="\uparrow" display="inline" intent=":literal"><semantics><mo stretchy="false">↑</mo><annotation encoding="application/x-tex">\uparrow</annotation></semantics></math></td>
<td id="A7.T5.5.1.1.7" class="ltx_td ltx_align_center ltx_border_tt">Distance <math id="A7.T5.m5" class="ltx_Math" alttext="\downarrow" display="inline" intent=":literal"><semantics><mo stretchy="false">↓</mo><annotation encoding="application/x-tex">\downarrow</annotation></semantics></math></td>
<td id="A7.T5.5.1.1.8" class="ltx_td ltx_align_center ltx_border_tt">Entropy <math id="A7.T5.m6" class="ltx_Math" alttext="\uparrow" display="inline" intent=":literal"><semantics><mo stretchy="false">↑</mo><annotation encoding="application/x-tex">\uparrow</annotation></semantics></math></td></tr>
<tr id="A7.T5.5.1.2" class="ltx_tr">
<td id="A7.T5.5.1.2.1" class="ltx_td ltx_align_center ltx_border_t">Aligning</td>
<td id="A7.T5.5.1.2.2" class="ltx_td ltx_align_center ltx_border_t">BC</td>
<td id="A7.T5.5.1.2.3" class="ltx_td ltx_border_t"></td>
<td id="A7.T5.5.1.2.4" class="ltx_td ltx_border_t"></td>
<td id="A7.T5.5.1.2.5" class="ltx_td ltx_border_r ltx_border_t"></td>
<td id="A7.T5.5.1.2.6" class="ltx_td ltx_align_center ltx_border_t">0.6645</td>
<td id="A7.T5.5.1.2.7" class="ltx_td ltx_align_center ltx_border_t">0.1105</td>
