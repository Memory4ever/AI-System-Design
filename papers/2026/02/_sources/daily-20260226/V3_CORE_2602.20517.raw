</figure></div><div class="ltx_flex_break"></div><div class="ltx_flex_cell ltx_flex_size_1"><object type="image/svg+xml" data="2602.20517v1/legend_stacking.svg" id="A7.F9.g2" class="ltx_graphics ltx_centering ltx_figure_panel ltx_img_landscape" style="aspect-ratio:240/39;" width="240" height="39"></object></div><div class="ltx_flex_break"></div><div class="ltx_flex_cell ltx_flex_size_1">
<figure id="A7.F9.sf5" class="ltx_figure ltx_figure_panel ltx_align_center"><img src="2602.20517v1/Plots/Stacking_Dataset/init_steps_best.png" id="A7.F9.sf5.g1" class="ltx_graphics ltx_img_square" style="aspect-ratio:368/368;" width="368" height="368" alt="Refer to caption">
<figcaption class="ltx_caption"><span class="ltx_tag ltx_tag_figure"><span id="A7.F9.sf5.3" class="ltx_text" style="font-size:90%;">(e)</span> </span></figcaption>
