Performance training on various training prompts (rollout <math id="A5.F11.m3" class="ltx_Math" alttext="L_{R}=4k" display="inline" intent=":literal"><semantics><mrow><msub><mi>L</mi><mi>R</mi></msub><mo>=</mo><mrow><mn>4</mn><mo lspace="0em" rspace="0em">​</mo><mi>k</mi></mrow></mrow><annotation encoding="application/x-tex">L_{R}=4k</annotation></semantics></math>, target <math id="A5.F11.m4" class="ltx_Math" alttext="L_{T}=4k" display="inline" intent=":literal"><semantics><mrow><msub><mi>L</mi><mi>T</mi></msub><mo>=</mo><mrow><mn>4</mn><mo lspace="0em" rspace="0em">​</mo><mi>k</mi></mrow></mrow><annotation encoding="application/x-tex">L_{T}=4k</annotation></semantics></math>).
</figcaption>
</figure>
<figure id="A5.F12" class="ltx_figure"><object type="image/svg+xml" data="2602.20945v1/data_rollout_N_16k_4k.svg" id="A5.F12.g1" class="ltx_graphics ltx_img_landscape" style="aspect-ratio:476/321;" width="476" height="321"></object>
