Performance training on various training prompts (rollout <math id="A5.F10.m3" class="ltx_Math" alttext="L_{R}=16k" display="inline" intent=":literal"><semantics><mrow><msub><mi>L</mi><mi>R</mi></msub><mo>=</mo><mrow><mn>16</mn><mo lspace="0em" rspace="0em">​</mo><mi>k</mi></mrow></mrow><annotation encoding="application/x-tex">L_{R}=16k</annotation></semantics></math>, target <math id="A5.F10.m4" class="ltx_Math" alttext="L_{T}=8k" display="inline" intent=":literal"><semantics><mrow><msub><mi>L</mi><mi>T</mi></msub><mo>=</mo><mrow><mn>8</mn><mo lspace="0em" rspace="0em">​</mo><mi>k</mi></mrow></mrow><annotation encoding="application/x-tex">L_{T}=8k</annotation></semantics></math>).
</figcaption>
</figure>
<figure id="A5.F11" class="ltx_figure"><object type="image/svg+xml" data="2602.20945v1/data_diff_all_4k_4k.svg" id="A5.F11.g1" class="ltx_graphics ltx_img_landscape" style="aspect-ratio:476/324;" width="476" height="324"></object>
