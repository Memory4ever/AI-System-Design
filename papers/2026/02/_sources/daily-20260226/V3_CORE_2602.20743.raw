92.49 89.82 92.49 89.82 92.49 89.82 C 92.49 89.82 92.49 89.82 92.49 89.82 C 92.49 89.82 92.49 89.82 92.49 89.82 Z M 92.49 89.82"></path><path d="M 151.63 7.12 C 151.63 7.12 151.63 7.12 151.63 7.12 C 151.63 7.12 151.63 7.12 151.63 7.12 C 151.63 7.12 151.63 7.12 151.63 7.12 C 151.63 7.12 151.63 7.12 151.63 7.12 Z M 151.63 7.12"></path></g></g></g><g transform="matrix(1.0 0.0 0.0 1.0 -42.94 178.84)"><g style="--ltx-stroke-color:#000000;--ltx-fill-color:#000000;" class="ltx_nestedsvg" fill="#000000" stroke="#000000" stroke-width="0.4pt" transform="matrix(1 0 0 1 0 0) translate(632.44,0) translate(0,-14.78)"><g style="--ltx-stroke-color:#000000;--ltx-fill-color:#FFFFFF;" fill="#FFFFFF" stroke="#000000"><path style="stroke:none" d="M -632.43 14.78 h 670.73 v 23.52 h -670.73 Z"></path></g><g style="--ltx-stroke-color:#000000;--ltx-fill-color:#FFFFFF;" fill="#FFFFFF" stroke="#000000" transform="matrix(1.0 0.0 0.0 1.0 -628.28 26.54)"><g class="ltx_tikzmatrix" transform="matrix(1 0 0 -1 0 17.98)"><g class="ltx_tikzmatrix_row" transform="matrix(1 0 0 1 0 8.99)"><g style="--ltx-stroke-color:#FFDFC3;--ltx-fill-color:#000000;" class="ltx_tikzmatrix_col ltx_nopad_l ltx_nopad_r" fill="#000000" stroke="#FFDFC3" stroke-width="0.8pt" transform="matrix(1 0 0 -1 0 0) translate(0.55,0)"><path style="fill:none" d="M 0 0 L 11.81 0 L 23.62 0"></path><g style="--ltx-stroke-color:#FF851A;--ltx-fill-color:#FF851A;" fill="#FF851A" stroke="#FF851A"><path d="M 9.04 -2.77 h 5.53 v 5.53 h -5.53 Z"></path></g></g><g style="--ltx-stroke-color:#000000;--ltx-fill-color:#000000;" class="ltx_tikzmatrix_col ltx_nopad_l ltx_nopad_r" fill="#000000" stroke="#000000" transform="matrix(1 0 0 -1 24.73 0) translate(69.03,0) matrix(1.0 0.0 0.0 1.0 -66.26 -3.77)"><foreignObject style="--ltx-fo-width:9.58em;--ltx-fo-height:0.69em;--ltx-fo-depth:0em;font-size:10pt;" height="9.61" overflow="visible" transform="matrix(1 0 0 -1 0 9.61)" width="132.53"><span class="ltx_foreignobject_container"><span class="ltx_foreignob