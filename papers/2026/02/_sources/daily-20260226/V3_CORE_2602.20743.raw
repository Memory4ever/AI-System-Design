            <span id="lstnumberx61.2" class="ltx_text ltx_lst_space ltx_font_typewriter">    </span><span id="lstnumberx61.3" class="ltx_text ltx_lst_identifier ltx_font_typewriter">target_attribute</span><span id="lstnumberx61.4" class="ltx_text ltx_font_typewriter">:</span><span id="lstnumberx61.5" class="ltx_text ltx_lst_space ltx_font_typewriter"> </span><span id="lstnumberx61.6" class="ltx_text ltx_lst_keyword ltx_lst_keywords2 ltx_font_typewriter" style="--ltx-fg-color:#CF212E;">str</span><span id="lstnumberx61.7" class="ltx_text ltx_lst_space ltx_font_typewriter"> </span><span id="lstnumberx61.8" class="ltx_text ltx_font_typewriter">=</span><span id="lstnumberx61.9" class="ltx_text ltx_lst_space ltx_font_typewriter"> </span><span id="lstnumberx61.10" class="ltx_text ltx_lst_emph ltx_font_typewriter" style="--ltx-fg-color:#8251DF;">dspy</span><span id="lstnumberx61.11" class="ltx_text ltx_font_typewriter">.</span><span id="lstnumberx61.12" class="ltx_text ltx_lst_identifier ltx_font_typewriter">InputField</span><span id="lstnumberx61.13" class="ltx_text ltx_font_typewriter">()</span>
