          <span id="algx1.l2.3" class="ltx_text" style="font-size:80%;">target-reference patch mapping </span><math id="algx1.l2.m1" class="ltx_Math" alttext="\mathcal{M}=\{(p_{t},p_{r})\}" display="inline" intent=":literal"><semantics><mrow><mi class="ltx_font_mathcaligraphic" mathsize="0.800em">ℳ</mi><mo mathsize="0.800em">=</mo><mrow><mo stretchy="false">{</mo><mrow><mo maxsize="0.800em" minsize="0.800em">(</mo><msub><mi mathsize="0.800em">p</mi><mi mathsize="0.800em">t</mi></msub><mo mathsize="0.800em">,</mo><msub><mi mathsize="0.800em">p</mi><mi mathsize="0.800em">r</mi></msub><mo maxsize="0.800em" minsize="0.800em">)</mo></mrow><mo stretchy="false">}</mo></mrow></mrow><annotation encoding="application/x-tex">\mathcal{M}=\{(p_{t},p_{r})\}</annotation></semantics></math><span id="algx1.l2.4" class="ltx_text" style="font-size:80%;">
</span>
</div>
<div id="algx1.l3" class="ltx_listingline">
            <span class="ltx_tag ltx_tag_listingline"><span id="algx1.l3.1" class="ltx_text" style="font-size:80%;">3:</span></span>
            
            
          <math id="algx1.l3.m1" class="ltx_Math" alttext="(c_{i},c_{j})\leftarrow\textsc{Centroid}(\mathcal{P}_{R})" display="inline" intent=":literal"><semantics><mrow><mrow><mo maxsize="0.800em" minsize="0.800em">(</mo><msub><mi mathsize="0.800em">c</mi><mi mathsize="0.800em">i</mi></msub><mo mathsize="0.800em">,</mo><msub><mi mathsize="0.800em">c</mi><mi mathsize="0.800em">j</mi></msub><mo maxsize="0.800em" minsize="0.800em">)</mo></mrow><mo mathsize="0.800em" stretchy="false">←</mo><mrow><mtext class="ltx_font_smallcaps" mathsize="0.800em">Centroid</mtext><mo lspace="0em" rspace="0em">​</mo><mrow><mo maxsize="0.800em" minsize="0.800em">(</mo><msub><mi class="ltx_font_mathcaligraphic" mathsize="0.800em">𝒫</mi><mi mathsize="0.800em">R</mi></msub><mo maxsize="0.800em" minsize="0.800em">)</mo></mrow></mrow></mrow><annotation encoding="application/x-tex">(c_{i},c_{j})\leftarrow\textsc{Centroid}(\mathcal{P}_{R})</annotation></semantics></math><span id="algx1.l3.3" class="ltx_text" style="font-size:80%;"> </span><span id="algx1.l3.4" class="ltx_text ltx_font_italic" style="font-size:80%;--ltx-fg-color:#0000FF;">/* subentity center in patch space */</span><span id="algx1.l3.5" class="ltx_text" style="font-size:80%;">
</span>
</div>
