          <math id="algx1.l4.m1" class="ltx_Math" alttext="\mathcal{P}_{\text{ring}}\leftarrow\textsc{PerimeterBand}(\mathcal{P}_{R},(c_{i},c_{j}),\alpha,h_{p},w_{p})" display="inline" intent=":literal"><semantics><mrow><msub><mi class="ltx_font_mathcaligraphic" mathsize="0.800em">𝒫</mi><mtext mathsize="0.800em">ring</mtext></msub><mo mathsize="0.800em" stretchy="false">←</mo><mrow><mtext class="ltx_font_smallcaps" mathsize="0.800em">PerimeterBand</mtext><mo lspace="0em" rspace="0em">​</mo><mrow><mo maxsize="0.800em" minsize="0.800em">(</mo><msub><mi class="ltx_font_mathcaligraphic" mathsize="0.800em">𝒫</mi><mi mathsize="0.800em">R</mi></msub><mo mathsize="0.800em">,</mo><mrow><mo maxsize="0.800em" minsize="0.800em">(</mo><msub><mi mathsize="0.800em">c</mi><mi mathsize="0.800em">i</mi></msub><mo mathsize="0.800em">,</mo><msub><mi mathsize="0.800em">c</mi><mi mathsize="0.800em">j</mi></msub><mo maxsize="0.800em" minsize="0.800em">)</mo></mrow><mo mathsize="0.800em">,</mo><mi mathsize="0.800em">α</mi><mo mathsize="0.800em">,</mo><msub><mi mathsize="0.800em">h</mi><mi mathsize="0.800em">p</mi></msub><mo mathsize="0.800em">,</mo><msub><mi mathsize="0.800em">w</mi><mi mathsize="0.800em">p</mi></msub><mo maxsize="0.800em" minsize="0.800em">)</mo></mrow></mrow></mrow><annotation encoding="application/x-tex">\mathcal{P}_{\text{ring}}\leftarrow\textsc{PerimeterBand}(\mathcal{P}_{R},(c_{i},c_{j}),\alpha,h_{p},w_{p})</annotation></semantics></math><span id="algx1.l4.3" class="ltx_text" style="font-size:80%;"> </span><span id="algx1.l4.4" class="ltx_text ltx_font_italic" style="font-size:80%;--ltx-fg-color:#0000FF;">/* candidate centroid patches band around the subentity */</span><span id="algx1.l4.5" class="ltx_text" style="font-size:80%;">
</span>
</div>
<div id="algx1.l5" class="ltx_listingline">
            <span class="ltx_tag ltx_tag_listingline"><span id="algx1.l5.1" class="ltx_text" style="font-size:80%;">5:</span></span>
            
            
          <math id="algx1.l5.m1" class="ltx_Math" alttext="S\leftarrow\emptyset" display="inline" intent=":literal"><semantics><mrow><mi mathsize="0.800em">S</mi><mo mathsize="0.800em" stretchy="false">←</mo><mi mathsize="0.800em" mathvariant="normal">∅</mi></mrow><annotation encoding="application/x-tex">S\leftarrow\emptyset</annotation></semantics></math><span id="algx1.l5.3" class="ltx_text" style="font-size:80%;">
</span>
</div>
<div id="algx1.l6" class="ltx_listingline">
            <span class="ltx_tag ltx_tag_listingline"><span id="algx1.l6.1" class="ltx_text" style="font-size:80%;">6:</span></span>
            
            
          <span id="algx1.l6.3" class="ltx_text ltx_font_bold" style="font-size:80%;">for</span><span id="algx1.l6.4" class="ltx_text" style="font-size:80%;"> each </span><math id="algx1.l6.m1" class="ltx_Math" alttext="(i,j)\in\mathcal{P}_{\text{ring}}" display="inline" intent=":literal"><semantics><mrow><mrow><mo maxsize="0.800em" minsize="0.800em">(</mo><mi mathsize="0.800em">i</mi><mo mathsize="0.800em">,</mo><mi mathsize="0.800em">j</mi><mo maxsize="0.800em" minsize="0.800em">)</mo></mrow><mo mathsize="0.800em">∈</mo><msub><mi class="ltx_font_mathcaligraphic" mathsize="0.800em">𝒫</mi><mtext mathsize="0.800em">ring</mtext></msub></mrow><annotation encoding="application/x-tex">(i,j)\in\mathcal{P}_{\text{ring}}</annotation></semantics></math><span id="algx1.l6.5" class="ltx_text" style="font-size:80%;"> </span><span id="algx1.l6.6" class="ltx_text ltx_font_bold" style="font-size:80%;">do</span><span id="algx1.l6.7" class="ltx_text" style="font-size:80%;">
</span>
</div>
<div id="algx1.l7" class="ltx_listingline">
            <span class="ltx_tag ltx_tag_listingline"><span id="algx1.l7.1" class="ltx_text" style="font-size:80%;">7:</span></span>
            
            
          <span id="algx1.l7.3" class="ltx_text" style="font-size:80%;">   </span><math id="algx1.l7.m1" class="ltx_Math" alttext="\Delta_{i}\leftarrow i-c_{i},\ \Delta_{j}\leftarrow j-c_{j}" display="inline" intent=":literal"><semantics><mrow><mrow><msub><mi mathsize="0.800em" mathvariant="normal">Δ</mi><mi mathsize="0.800em">i</mi></msub><mo mathsize="0.800em" stretchy="false">←</mo><mrow><mi mathsize="0.800em">i</mi><mo mathsize="0.800em">−</mo><msub><mi mathsize="0.800em">c</mi><mi mathsize="0.800em">i</mi></msub></mrow></mrow><mo mathsize="0.800em" rspace="0.597em">,</mo><mrow><msub><mi mathsize="0.800em" mathvariant="normal">Δ</mi><mi mathsize="0.800em">j</mi></msub><mo mathsize="0.800em" stretchy="false">←</mo><mrow><mi mathsize="0.800em">j</mi><mo mathsize="0.800em">−</mo><msub><mi mathsize="0.800em">c</mi><mi mathsize="0.800em">j</mi></msub></mrow></mrow></mrow><annotation encoding="application/x-tex">\Delta_{i}\leftarrow i-c_{i},\ \Delta_{j}\leftarrow j-c_{j}</annotation></semantics></math><span id="algx1.l7.4" class="ltx_text" style="font-size:80%;">
</span>
</div>
<div id="algx1.l8" class="ltx_listingline">
            <span class="ltx_tag ltx_tag_listingline"><span id="algx1.l8.1" class="ltx_text" style="font-size:80%;">8:</span></span>
            
            
          <span id="algx1.l8.3" class="ltx_text" style="font-size:80%;">   </span><math id="algx1.l8.m1" class="ltx_Math" alttext="\mathcal{P}_{\text{shift}}\leftarrow\{(r_{i}+\Delta_{i},r_{j}+\Delta_{j}):(r_{i},r_{j})\in\mathcal{P}_{R}\}" display="inline" intent=":literal"><semantics><mrow><msub><mi class="ltx_font_mathcaligraphic" mathsize="0.800em">𝒫</mi><mtext mathsize="0.800em">shift</mtext></msub><mo mathsize="0.800em" stretchy="false">←</mo><mrow><mo stretchy="false">{</mo><mrow><mo maxsize="0.800em" minsize="0.800em">(</mo><mrow><msub><mi mathsize="0.800em">r</mi><mi mathsize="0.800em">i</mi></msub><mo mathsize="0.800em">+</mo><msub><mi mathsize="0.800em" mathvariant="normal">Δ</mi><mi mathsize="0.800em">i</mi></msub></mrow><mo mathsize="0.800em">,</mo><mrow><msub><mi mathsize="0.800em">r</mi><mi mathsize="0.800em">j</mi></msub><mo mathsize="0.800em">+</mo><msub><mi mathsize="0.800em" mathvariant="normal">Δ</mi><mi mathsize="0.800em">j</mi></msub></mrow><mo maxsize="0.800em" minsize="0.800em" rspace="0.278em">)</mo></mrow><mo mathsize="0.800em" rspace="0.278em">:</mo><mrow><mrow><mo maxsize="0.800em" minsize="0.800em">(</mo><msub><mi mathsize="0.800em">r</mi><mi mathsize="0.800em">i</mi></msub><mo mathsize="0.800em">,</mo><msub><mi mathsize="0.800em">r</mi><mi mathsize="0.800em">j</mi></msub><mo maxsize="0.800em" minsize="0.800em">)</mo></mrow><mo mathsize="0.800em">∈</mo><msub><mi class="ltx_font_mathcaligraphic" mathsize="0.800em">𝒫</mi><mi mathsize="0.800em">R</mi></msub></mrow><mo stretchy="false">}</mo></mrow></mrow><annotation encoding="application/x-tex">\mathcal{P}_{\text{shift}}\leftarrow\{(r_{i}+\Delta_{i},r_{j}+\Delta_{j}):(r_{i},r_{j})\in\mathcal{P}_{R}\}</annotation></semantics></math><span id="algx1.l8.4" class="ltx_text" style="font-size:80%;">
</span>
</div>
<div id="algx1.l9" class="ltx_listingline">
            <span class="ltx_tag ltx_tag_listingline"><span id="algx1.l9.1" class="ltx_text" style="font-size:80%;">9:</span></span>
            
            
          <span id="algx1.l9.3" class="ltx_text" style="font-size:80%;">   </span><math id="algx1.l9.m1" class="ltx_Math" alttext="r_{\text{self}}\leftarrow\frac{|\mathcal{P}_{\text{shift}}\cap\mathcal{P}_{R}|}{|\mathcal{P}_{\text{shift}}|}" display="inline" intent=":literal"><semantics><mrow><msub><mi mathsize="0.800em">r</mi><mtext mathsize="0.800em">self</mtext></msub><mo mathsize="0.800em" stretchy="false">←</mo><mfrac><mrow><mo maxsize="0.800em" minsize="0.800em" stretchy="true">|</mo><mrow><msub><mi class="ltx_font_mathcaligraphic" mathsize="0.800em">𝒫</mi><mtext mathsize="0.800em">shift</mtext></msub><mo mathsize="0.800em">∩</mo><msub><mi class="ltx_font_mathcaligraphic" mathsize="0.800em">𝒫</mi><mi mathsize="0.800em">R</mi></msub></mrow><mo maxsize="0.800em" minsize="0.800em" stretchy="true">|</mo></mrow><mrow><mo maxsize="0.800em" minsize="0.800em" stretchy="true">|</mo><msub><mi class="ltx_font_mathcaligraphic" mathsize="0.800em">𝒫</mi><mtext mathsize="0.800em">shift</mtext></msub><mo maxsize="0.800em" minsize="0.800em" stretchy="true">|</mo></mrow></mfrac></mrow><annotation encoding="application/x-tex">r_{\text{self}}\leftarrow\frac{|\mathcal{P}_{\text{shift}}\cap\mathcal{P}_{R}|}{|\mathcal{P}_{\text{shift}}|}</annotation></semantics></math><span id="algx1.l9.4" class="ltx_text" style="font-size:80%;">
</span>
</div>
<div id="algx1.l10" class="ltx_listingline">
