          <span id="algx1.l11.3" class="ltx_text" style="font-size:80%;">   </span><math id="algx1.l11.m1" class="ltx_Math" alttext="r_{\text{sub}}\leftarrow\frac{|\mathcal{P}_{\text{shift}}\cap\mathcal{P}_{\text{sub}}|}{|\mathcal{P}_{\text{shift}}|}" display="inline" intent=":literal"><semantics><mrow><msub><mi mathsize="0.800em">r</mi><mtext mathsize="0.800em">sub</mtext></msub><mo mathsize="0.800em" stretchy="false">←</mo><mfrac><mrow><mo maxsize="0.800em" minsize="0.800em" stretchy="true">|</mo><mrow><msub><mi class="ltx_font_mathcaligraphic" mathsize="0.800em">𝒫</mi><mtext mathsize="0.800em">shift</mtext></msub><mo mathsize="0.800em">∩</mo><msub><mi class="ltx_font_mathcaligraphic" mathsize="0.800em">𝒫</mi><mtext mathsize="0.800em">sub</mtext></msub></mrow><mo maxsize="0.800em" minsize="0.800em" stretchy="true">|</mo></mrow><mrow><mo maxsize="0.800em" minsize="0.800em" stretchy="true">|</mo><msub><mi class="ltx_font_mathcaligraphic" mathsize="0.800em">𝒫</mi><mtext mathsize="0.800em">shift</mtext></msub><mo maxsize="0.800em" minsize="0.800em" stretchy="true">|</mo></mrow></mfrac></mrow><annotation encoding="application/x-tex">r_{\text{sub}}\leftarrow\frac{|\mathcal{P}_{\text{shift}}\cap\mathcal{P}_{\text{sub}}|}{|\mathcal{P}_{\text{shift}}|}</annotation></semantics></math><span id="algx1.l11.4" class="ltx_text" style="font-size:80%;">
