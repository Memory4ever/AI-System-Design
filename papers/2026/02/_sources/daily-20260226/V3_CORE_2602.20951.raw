<figure id="alg1" class="ltx_float ltx_float_algorithm ltx_framed ltx_framed_top">
<figcaption class="ltx_caption"><span class="ltx_tag ltx_tag_float"><span id="alg1.3" class="ltx_text ltx_font_bold">Algorithm 1</span> </span> Add Tool</figcaption>
<div id="alg1.4" class="ltx_listing ltx_framed ltx_framed_topbottom ltx_listing">
<div id="algx1.l1" class="ltx_listingline">
            <span class="ltx_tag ltx_tag_listingline"><span id="algx1.l1.1" class="ltx_text" style="font-size:80%;">1:</span></span>
            
            
          <span id="algx1.l1.3" class="ltx_text" style="font-size:80%;">Reference patches </span><math id="algx1.l1.m1" class="ltx_Math" alttext="\mathcal{P}_{R}" display="inline" intent=":literal"><semantics><msub><mi class="ltx_font_mathcaligraphic" mathsize="0.800em">𝒫</mi><mi mathsize="0.800em">R</mi></msub><annotation encoding="application/x-tex">\mathcal{P}_{R}</annotation></semantics></math><span id="algx1.l1.4" class="ltx_text" style="font-size:80%;">, patch grid </span><math id="algx1.l1.m2" class="ltx_Math" alttext="(h_{p},w_{p})" display="inline" intent=":literal"><semantics><mrow><mo maxsize="0.800em" minsize="0.800em">(</mo><msub><mi mathsize="0.800em">h</mi><mi mathsize="0.800em">p</mi></msub><mo mathsize="0.800em">,</mo><msub><mi mathsize="0.800em">w</mi><mi mathsize="0.800em">p</mi></msub><mo maxsize="0.800em" minsize="0.800em">)</mo></mrow><annotation encoding="application/x-tex">(h_{p},w_{p})</annotation></semantics></math><span id="algx1.l1.5" class="ltx_text" style="font-size:80%;">, same-entity foreground </span><math id="algx1.l1.m3" class="ltx_Math" alttext="\mathcal{P}_{\text{ent}}" display="inline" intent=":literal"><semantics><msub><mi class="ltx_font_mathcaligraphic" mathsize="0.800em">𝒫</mi><mtext mathsize="0.800em">ent</mtext></msub><annotation encoding="application/x-tex">\mathcal{P}_{\text{ent}}</annotation></semantics></math><span id="algx1.l1.6" class="ltx_text" style="font-size:80%;">, same-subentity foreground </span><math id="algx1.l1.m4" class="ltx_Math" alttext="\mathcal{P}_{\text{sub}}" display="inline" intent=":literal"><semantics><msub><mi class="ltx_font_mathcaligraphic" mathsize="0.800em">𝒫</mi><mtext mathsize="0.800em">sub</mtext></msub><annotation encoding="application/x-tex">\mathcal{P}_{\text{sub}}</annotation></semantics></math><span id="algx1.l1.7" class="ltx_text" style="font-size:80%;">, ring thickness </span><math id="algx1.l1.m5" class="ltx_Math" alttext="\alpha" display="inline" intent=":literal"><semantics><mi mathsize="0.800em">α</mi><annotation encoding="application/x-tex">\alpha</annotation></semantics></math><span id="algx1.l1.8" class="ltx_text" style="font-size:80%;">, distance weight </span><math id="algx1.l1.m6" class="ltx_Math" alttext="\lambda_{\text{dist}}" display="inline" intent=":literal"><semantics><msub><mi mathsize="0.800em">λ</mi><mtext mathsize="0.800em">dist</mtext></msub><annotation encoding="application/x-tex">\lambda_{\text{dist}}</annotation></semantics></math><span id="algx1.l1.9" class="ltx_text" style="font-size:80%;">
</span>
</div>
<div id="algx1.l2" class="ltx_listingline">
