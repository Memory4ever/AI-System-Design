          <math id="alg6.l5.m1" class="ltx_Math" alttext="c\leftarrow\text{VLM}(I,p_{\text{caption}})" display="inline" intent=":literal"><semantics><mrow><mi>c</mi><mo stretchy="false">←</mo><mrow><mtext>VLM</mtext><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>I</mi><mo>,</mo><msub><mi>p</mi><mtext>caption</mtext></msub><mo stretchy="false">)</mo></mrow></mrow></mrow><annotation encoding="application/x-tex">c\leftarrow\text{VLM}(I,p_{\text{caption}})</annotation></semantics></math>

