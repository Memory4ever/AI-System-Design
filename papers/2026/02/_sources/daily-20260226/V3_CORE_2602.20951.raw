          <math id="alg6.l3.m1" class="ltx_Math" alttext="B\leftarrow\text{VLM}(I,p_{\text{localize}})" display="inline" intent=":literal"><semantics><mrow><mi>B</mi><mo stretchy="false">←</mo><mrow><mtext>VLM</mtext><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>I</mi><mo>,</mo><msub><mi>p</mi><mtext>localize</mtext></msub><mo stretchy="false">)</mo></mrow></mrow></mrow><annotation encoding="application/x-tex">B\leftarrow\text{VLM}(I,p_{\text{localize}})</annotation></semantics></math>

</div>
