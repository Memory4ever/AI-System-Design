            <span class="ltx_tag ltx_tag_listingline"><span id="alg6.l7.1" class="ltx_text" style="font-size:80%;">7:</span></span>
            
            
            <span id="alg6.l7.3" class="ltx_text" style="--ltx-fg-color:#0000FF;"> /* Inpaint region <math id="alg6.l7.m1" class="ltx_Math" alttext="B" display="inline" intent=":literal"><semantics><mi style="--ltx-fg-color:#0000FF;" mathcolor="#0000FF">B</mi><annotation encoding="application/x-tex">B</annotation></semantics></math> using caption <math id="alg6.l7.m2" class="ltx_Math" alttext="c" display="inline" intent=":literal"><semantics><mi style="--ltx-fg-color:#0000FF;" mathcolor="#0000FF">c</mi><annotation encoding="application/x-tex">c</annotation></semantics></math> */ </span>

</div>
<div id="alg6.l8" class="ltx_listingline">
            <span class="ltx_tag ltx_tag_listingline"><span id="alg6.l8.1" class="ltx_text" style="font-size:80%;">8:</span></span>
            
            
