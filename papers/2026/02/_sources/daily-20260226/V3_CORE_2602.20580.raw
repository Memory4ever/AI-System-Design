<tr id="S5.T2.2.1.4.1.2" class="ltx_tr">
<td id="S5.T2.2.1.4.1.2.1" class="ltx_td ltx_nopad_r ltx_align_center"><span id="S5.T2.2.1.4.1.2.1.1" class="ltx_text ltx_font_bold">num</span></td></tr>
</table></th>
<th id="S5.T2.2.1.5" class="ltx_td ltx_align_center ltx_th ltx_th_column ltx_border_tt">
<table id="S5.T2.2.1.5.1" class="ltx_tabular ltx_align_middle">
<tr id="S5.T2.2.1.5.1.1" class="ltx_tr">
<td id="S5.T2.2.1.5.1.1.1" class="ltx_td ltx_nopad_r ltx_align_center"><span id="S5.T2.2.1.5.1.1.1.1" class="ltx_text ltx_font_bold">phone</span></td></tr>
<tr id="S5.T2.2.1.5.1.2" class="ltx_tr">
<td id="S5.T2.2.1.5.1.2.1" class="ltx_td ltx_nopad_r ltx_align_center"><span id="S5.T2.2.1.5.1.2.1.1" class="ltx_text ltx_font_bold">num +1</span></td></tr>
</table></th></tr>
</thead>
<tbody class="ltx_tbody">
<tr id="S5.T2.2.2" class="ltx_tr">
<td id="S5.T2.2.2.1" class="ltx_td ltx_align_center ltx_border_r ltx_border_t"><span id="S5.T2.2.2.1.1" class="ltx_text ltx_font_bold">160m</span></td>
<td id="S5.T2.2.2.2" class="ltx_td ltx_align_center ltx_border_r ltx_border_t">2.34%</td>
