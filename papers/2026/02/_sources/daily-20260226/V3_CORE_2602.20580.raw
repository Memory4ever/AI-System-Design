<tr id="S5.T2.2.5" class="ltx_tr">
<td id="S5.T2.2.5.1" class="ltx_td ltx_align_center ltx_border_r"><span id="S5.T2.2.5.1.1" class="ltx_text ltx_font_bold">1.4b</span></td>
<td id="S5.T2.2.5.2" class="ltx_td ltx_align_center ltx_border_r">16.36%</td>
