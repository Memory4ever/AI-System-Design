<td id="S5.T2.2.4.2" class="ltx_td ltx_align_center ltx_border_r">12.62%</td>
<td id="S5.T2.2.4.3" class="ltx_td ltx_align_center ltx_border_r">7.87%</td>
<td id="S5.T2.2.4.4" class="ltx_td ltx_align_center ltx_border_r">3.28%</td>
