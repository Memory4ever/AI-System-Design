<td id="S5.T2.2.2.4" class="ltx_td ltx_align_center ltx_border_r ltx_border_t">1.64%</td>
<td id="S5.T2.2.2.5" class="ltx_td ltx_align_center ltx_border_t">1.23%</td></tr>
<tr id="S5.T2.2.3" class="ltx_tr">
<td id="S5.T2.2.3.1" class="ltx_td ltx_align_center ltx_border_r"><span id="S5.T2.2.3.1.1" class="ltx_text ltx_font_bold">410m</span></td>
<td id="S5.T2.2.3.2" class="ltx_td ltx_align_center ltx_border_r">8.41%</td>
