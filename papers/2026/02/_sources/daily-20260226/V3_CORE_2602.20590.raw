23"></path></g><g style="--ltx-stroke-color:#333333;--ltx-fill-color:#333333;" fill="#333333" stroke="#333333" transform="matrix(1.0 0.0 0.0 1.0 -3.39 -206.8)"><foreignObject style="--ltx-fo-width:0.5em;--ltx-fo-height:0.53em;--ltx-fo-depth:0em;font-size:9.8pt;" height="7.13" overflow="visible" transform="matrix(1 0 0 -1 0 7.13)" width="6.78"><span class="ltx_foreignobject_container"><span class="ltx_foreignobject_content"><span id="S3.SS2.p2.pic1.7" class="ltx_text ltx_font_bold" style="font-size:80%;--ltx-fg-color:#333333;">5</span></span></span></foreignObject></g></g><g stroke-width="0.8pt"><g style="--ltx-stroke-color:#333333;--ltx-fill-color:#333333;--ltx-fg-color:#333333;" color="#333333" fill="#333333" stroke="#333333"><path style="fill:none" d="M -31.08 -232.7 L 22.75 -259.25"></path></g><g style="--ltx-stroke-color:#333333;--ltx-fill-color:#333333;--ltx-fg-color:#333333;" color="#333333" fill="#333333" stroke="#333333" stroke-dasharray="none" stroke-dashoffset="0.0pt" stroke-linejoin="miter" transform="matrix(0.8968 -0.44241 0.44241 0.8968 22.75 -259.25)"><path d="M 7.08 0 C 6.21 0.21 2.39 1.42 0 2.73 L 0 -2.73 C 2.39 -1.42 6.21 -0.21 7.08 0 Z"></path></g><g style="--ltx-fill-color:#FFFFFF;" fill="#FFFFFF"><path style="stroke:none" d="M 2.6 -235.6 C 2.6 -230.73 -1.35 -226.79 -6.22 -226.79 C -11.08 -226.79 -15.03 -230.73 -15.03 -235.6 C -15.03 -240.47 -11.08 -244.41 -6.22 -244.41 C -1.35 -244.41 2.6 -240.47 2.6 -235.6 Z M -6.22 -235.6"></path></g><g style="--ltx-stroke-color:#333333;--ltx-fill-color:#333333;" fill="#333333" stroke="#333333" transform="matrix(1.0 0.0 0.0 1.0 -9.61 -239.17)"><foreignObject style="--ltx-fo-width:0.5em;--ltx-fo-height:0.53em;--ltx-fo-depth:0em;font-size:9.8pt;" height="7.13" overflow="visible" transform="matrix(1 0 0 -1 0 7.13)" width="6.78"><span class="ltx_foreignobject_container"><span class="ltx_foreignobject_content"><span id="S3.SS2.p2.pic1.8" class="ltx_text ltx_font_bold" style="font-size:80%;--ltx-fg-color:#333333;">6</span></span></span></foreignObject></g></g><g style="--ltx-fg-color:#B3B3B3;" color="#B3B3B3" stroke-dasharray="3.0pt,2.0pt" stroke-dashoffset="0.0pt" stroke-width="0.4pt"><g style="--ltx-stroke-color:#B3B3B3;--ltx-fill-color:#B3B3B3;" fill="#B3B3B3" stroke="#B3B3B3"><path style="fill:none" d="M -31.08 -161.83 C 15.22 -188.57 -19.16 -265.18 23.94 -280.87"></path></g><g style="--ltx-stroke-color:#B3B3B3;--ltx-fill-color:#B3B3B3;" fill="#B3B3B3" stroke="#B3B3B3" stroke-dasharray="none" stroke-dashoffset="0.0pt" stroke-linejoin="miter" transform="matrix(0.9397 -0.34203 0.34203 0.9397 23.94 -280.87)"><path d="M 6.49 0 C 5.69 0.19 2.19 1.28 0 2.47 L 0 -2.47 C 2.19 -1.28 5.69 -0.19 6.49 0 Z"></path></g></g><g stroke-width="0.8pt"><g style="--ltx-stroke-color:#333333;--ltx-fill-color:#333333;--ltx-fg-color:#333333;" color="#333333" fill="#333333" stroke="#333333"><path style="fill:none" d="M 31.08 -283.46 L -21.79 -283.46"></path></g><g style="--ltx-stroke-color:#333333;--ltx-fill-color:#333333;--ltx-fg-color:#333333;" color="#333333" fill="#333333" stroke="#333333" stroke-dasharray="none" stroke-dashoffset="0.0pt" stroke-linejoin="miter" transform="matrix(-1.0 0.0 0.0 -1.0 -21.79 -283.46)"><path d="M 7.08 0 C 6.21 0.21 2.39 1.42 0 2.73 L 0 -2.73 C 2.39 -1.42 6.21 -0.21 7.08 0 Z"></path></g><g style="--ltx-fill-color:#FFFFFF;" fill="#FFFFFF"><path style="stroke:none" d="M 8.81 -274.1 C 8.81 -269.23 4.87 -265.29 0 -265.29 C -4.87 -265.29 -8.81 -269.23 -8.81 -274.1 C -8.81 -278.97 -4.87 -282.91 0 -282.91 C 4.87 -282.91 8.81 -278.97 8.81 -274.1 Z M 0 -274.1"></path></g><g style="--ltx-stroke-color:#333333;--ltx-fill-color:#333333;" fill="#333333" stroke="#333333" transform="matrix(1.0 0.0 0.0 1.0 -3.39 -277.67)"><foreignObject style="--ltx-fo-width:0.5em;--ltx-fo-height:0.53em;--ltx-fo-depth:0em;font-size:9.8pt;" height="7.13" overflow="visible" transform="matrix(1 0 0 -1 0 7.13)" width="6.78"><span class="ltx_foreignobject_container"><span class="ltx_foreignobject_content"><span id="S3.SS2.p2.pic1.9" class="ltx_text ltx_font_bold" style="font-size:80%;--ltx-fg-color:#333333;">7</span></span></span></foreignObject></g></g><g style="--ltx-fg-color:#A6A6A6;" color="#A6A6A6" stroke-width="0.5pt"><g style="--ltx-stroke-color:#A6A6A6;--ltx-fill-color:#A6A6A6;" fill="#A6A6A6" stroke="#A6A6A6"><path style="fill:none" d="M -153.54 15.75 M -153.54 15.75 C -155.62 14.71 -157 12.29 -157 8.83 L -157 -28.51 C -157 -31.97 -158.39 -34.4 -160.46 -35.43 C -158.39 -36.47 -157 -38.89 -157 -42.35 L -157 -79.7 C -157 -83.15 -155.62 -85.58 -153.54 -86.61"></path></g><g style="--ltx-stroke-color:#A6A6A6;--ltx-fill-color:#A6A6A6;--ltx-fg-color:#000000;" color="#000000" fill="#A6A6A6" stroke="#A6A6A6" transform="matrix(1.0 0.0 0.0 1.0 -219.85 -41.22)"><g style="--ltx-fg-color:#A6A6A6;" class="ltx_tikzmatrix" color="#A6A6A6" transform="matrix(1 0 0 -1 0 16.41)"><g class="ltx_tikzmatrix_row" transform="matrix(1 0 0 1 0 6.73)"><g class="ltx_tikzmatrix_col ltx_nopad_r" transform="matrix(1 0 0 -1 10.95 0)"><foreignObject style="--ltx-fo-width:2.85em;--ltx-fo-height:0.61em;--ltx-fo-depth:0em;font-size:7.97pt;" height="6.73" overflow="visible" transform="matrix(1 0 0 -1 0 6.73)" width="31.45"><span class="ltx_foreignobject_container"><span class="ltx_foreignobject_content"><span id="S3.SS2.p2.pic1.10" class="ltx_text" style="font-size:70%;">known</span></span></span></foreignObject></g></g><g class="ltx_tikzmatrix_row" transform="matrix(1 0 0 1 0 13.99)"><g class="ltx_tikzmatrix_col ltx_nopad_r" transform="matrix(1 0 0 -1 0 0)"><foreignObject style="--ltx-fo-width:4.81em;--ltx-fo-height:0.66em;--ltx-fo-depth:0.22em;font-size:7.97pt;" height="9.69" overflow="visible" transform="matrix(1 0 0 -1 0 7.26)" width="53.05"><span class="ltx_foreignobject_container"><span class="ltx_foreignobject_content"><span id="S3.SS2.p2.pic1.11" class="ltx_text" style="font-size:70%;">(base case)</span></span></span></foreignObject></g></g></g></g></g><g style="--ltx-fg-color:#A6A6A6;" color="#A6A6A6" stroke-width="0.5pt"><g style="--ltx-stroke-color:#A6A6A6;--ltx-fill-color:#A6A6A6;" fill="#A6A6A6" stroke="#A6A6A6"><path style="fill:none" d="M 153.54 15.75 M 153.54 15.75 C 155.62 14.71 157 12.29 157 8.83 L 157 6.92 C 157 3.46 158.39 1.04 160.46 0 C 158.39 -1.04 157 -3.46 157 -6.92 L 157 -8.83 C 157 -12.29 155.62 -14.71 153.54 -15.75"></path></g><g style="--ltx-stroke-color:#A6A6A6;--ltx-fill-color:#A6A6A6;--ltx-fg-color:#000000;" color="#000000" fill="#A6A6A6" stroke="#A6A6A6" transform="matrix(1.0 0.0 0.0 1.0 166.8 -3.36)"><foreignObject style="--ltx-fg-color:#A6A6A6;--ltx-fo-width:2.85em;--ltx-fo-height:0.61em;--ltx-fo-depth:0em;font-size:7.97pt;" color="#A6A6A6" height="6.73" overflow="visible" transform="matrix(1 0 0 -1 0 6.73)" width="31.45"><span class="ltx_foreignobject_container"><span class="ltx_foreignobject_content"><span id="S3.SS2.p2.pic1.12" class="ltx_text" style="font-size:70%;">known</span></span></span></foreignObject></g></g></g></svg></span>
</div>
          
<figure id="S3.F1" class="ltx_figure ltx_align_center">
<figcaption class="ltx_caption"><span class="ltx_tag ltx_tag_figure"><span id="S3.F1.2" class="ltx_text" style="font-size:90%;">Figure 1</span>. </span><span id="S3.F1.3" class="ltx_text" style="font-size:90%;">A schematic illustration of the frequency-marching recovery. Signal coefficients (blue, left) and distribution Fourier coefficients (orange, right) are recovered at progressively higher frequency bands. At each band <math id="S3.F1.m5" class="ltx_Math" alttext="\ell\geq 2" display="inline" intent=":literal"><semantics><mrow><mi mathvariant="normal">ℓ</mi><mo>≥</mo><mn>2</mn></mrow><annotation encoding="application/x-tex">\ell\geq 2</annotation></semantics></math>, the distribution <math id="S3.F1.m6" class="ltx_Math" alttext="\hat{\rho}(H_{\ell})" display="inline" intent=":literal"><semantics><mrow><mover accent="true"><mi>ρ</mi><mo mathsize="1.110em">^</mo></mover><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mi>H</mi><mi mathvariant="normal">ℓ</mi></msub><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">\hat{\rho}(H_{\ell})</annotation></semantics></math> is first solved from the second moment using previously recovered signal coefficients (diagonal and dashed arrows), and then <math id="S3.F1.m7" class="ltx_Math" alttext="X_{\ell}" display="inline" intent=":literal"><semantics><msub><mi>X</mi><mi mathvariant="normal">ℓ</mi></msub><annotation encoding="application/x-tex">X_{\ell}</annotation></semantics></math> is recovered from the first moment by inverting <math id="S3.F1.m8" class="ltx_Math" alttext="\hat{\rho}(H_{\ell})" display="inline" intent=":literal"><semantics><mrow><mover accent="true"><mi>ρ</mi><mo mathsize="1.110em">^</mo></mover><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mi>H</mi><mi mathvariant="normal">ℓ</mi></msub><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">\hat{\rho}(H_{\ell})</annotation></semantics></math> (horizontal arrows). The numbers show the order of computation.</span></figcaption>
</figure>
        
</div>
<br class="ltx_break">
</div>
<section id="S3.SS2.SSS0.Px1" class="ltx_paragraph">
<h5 class="ltx_title ltx_font_bold ltx_title_paragraph">Base case.</h5>

<div id="S3.SS2.SSS0.Px1.p1" class="ltx_para">
<p id="S3.SS2.SSS0.Px1.p1.1" class="ltx_p">We begin by recalling that for any compact group, the <math id="S3.SS2.SSS0.Px1.p1.m1" class="ltx_Math" alttext="G" display="inline" intent=":literal"><semantics><mi>G</mi><annotation encoding="application/x-tex">G</annotation></semantics></math>-invariant part
of the <math id="S3.SS2.SSS0.Px1.p1.m2" class="ltx_Math" alttext="d" display="inline" intent=":literal"><semantics><mi>d</mi><annotation encoding="application/x-tex">d</annotation></semantics></math>-th moment with respect to an arbitrary probability distribution is the uniform <math id="S3.SS2.SSS0.Px1.p1.m3" class="ltx_Math" alttext="d" display="inline" intent=":literal"><semantics><mi>d</mi><annotation encoding="application/x-tex">d</annotation></semantics></math>-th moment. In particular, the uniform second moment is known from the non-uniform second moment, so by <cite class="ltx_cite ltx_citemacro_cite">[<a href="#bib.bib9" title="" class="ltx_ref">9</a>]</cite> we know the matrices <math id="S3.SS2.SSS0.Px1.p1.m4" class="ltx_Math" alttext="X^{*}_{\ell}X_{\ell}" display="inline" intent=":literal"><semantics><mrow><msubsup><mi>X</mi><mi mathvariant="normal">ℓ</mi><mo>∗</mo></msubsup><mo lspace="0em" rspace="0em">​</mo><msub><mi>X</mi><mi mathvariant="normal">ℓ</mi></msub></mrow><annotation encoding="application/x-tex">X^{*}_{\ell}X_{\ell}</annotation></semantics></math> for each <math id="S3.SS2.SSS0.Px1.p1.m5" class="ltx_Math" alttext="\ell" display="inline" intent=":literal"><semantics><mi mathvariant="normal">ℓ</mi><annotation encoding="application/x-tex">\ell</annotation></semantics></math>. Moreover, we know <math id="S3.SS2.SSS0.Px1.p1.m6" class="ltx_Math" alttext="X_{0}" display="inline" intent=":literal"><semantics><msub><mi>X</mi><mn>0</mn></msub><annotation encoding="application/x-tex">X_{0}</annotation></semantics></math> since we know <math id="S3.SS2.SSS0.Px1.p1.m7" class="ltx_Math" alttext="\hat{\rho}(\mathbf{1})=1" display="inline" intent=":literal"><semantics><mrow><mrow><mover accent="true"><mi>ρ</mi><mo>^</mo></mover><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mn>𝟏</mn><mo stretchy="false">)</mo></mrow></mrow><mo>=</mo><mn>1</mn></mrow><annotation encoding="application/x-tex">\hat{\rho}(\mathbf{1})=1</annotation></semantics></math> for any probability distribution and we know <math id="S3.SS2.SSS0.Px1.p1.m8" class="ltx_Math" alttext="\hat{\rho}(\mathbf{1})X_{0}" display="inline" intent=":literal"><semantics><mrow><mover accent="true"><mi>ρ</mi><mo>^</mo></mover><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mn>𝟏</mn><mo stretchy="false">)</mo></mrow><mo lspace="0em" rspace="0em">​</mo><msub><mi>X</mi><mn>0</mn></msub></mrow><annotation encoding="application/x-tex">\hat{\rho}(\mathbf{1})X_{0}</annotation></semantics></math>. Let <math id="S3.SS2.SSS0.Px1.p1.m9" class="ltx_Math" alttext="X^{\prime}_{1}" display="inline" intent=":literal"><semantics><msubsup><mi>X</mi><mn>1</mn><mo>′</mo></msubsup><annotation encoding="application/x-tex">X^{\prime}_{1}</annotation></semantics></math>
be any square root of the Gram matrix <math id="S3.SS2.SSS0.Px1.p1.m10" class="ltx_Math" alttext="X^{*}_{1}X_{1}" display="inline" intent=":literal"><semantics><mrow><msubsup><mi>X</mi><mn>1</mn><mo>∗</mo></msubsup><mo lspace="0em" rspace="0em">​</mo><msub><mi>X</mi><mn>1</mn></msub></mrow><annotation encoding="application/x-tex">X^{*}_{1}X_{1}</annotation></semantics></math>. Once we fix <math id="S3.SS2.SSS0.Px1.p1.m11" class="ltx_Math" alttext="X^{\prime}_{1}" display="inline" intent=":literal"><semantics><msubsup><mi>X</mi><mn>1</mn><mo>′</mo></msubsup><annotation encoding="application/x-tex">X^{\prime}_{1}</annotation></semantics></math>, we can uniquely determine the Fourier coefficient <math id="S3.SS2.SSS0.Px1.p1.m12" class="ltx_Math" alttext="\hat{\rho}(H_{1})" display="inline" intent=":literal"><semantics><mrow><mover accent="true"><mi>ρ</mi><mo>^</mo></mover><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mi>H</mi><mn>1</mn></msub><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">\hat{\rho}(H_{1})</annotation></semantics></math> from the first moment <math id="S3.SS2.SSS0.Px1.p1.m13" class="ltx_Math" alttext="\hat{\rho}(H_{1})^{*}X^{\prime}_{1}" display="inline" intent=":literal"><semantics><mrow><mover accent="true"><mi>ρ</mi><mo>^</mo></mover><mo lspace="0em" rspace="0em">​</mo><msup><mrow><mo stretchy="false">(</mo><msub><mi>H</mi><mn>1</mn></msub><mo stretchy="false">)</mo></mrow><mo>∗</mo></msup><mo lspace="0em" rspace="0em">​</mo><msubsup><mi>X</mi><mn>1</mn><mo>′</mo></msubsup></mrow><annotation encoding="application/x-tex">\hat{\rho}(H_{1})^{*}X^{\prime}_{1}</annotation></semantics></math> since we assume
that we have at least three shells (<math id="S3.SS2.SSS0.Px1.p1.m14" class="ltx_Math" alttext="R\geq 3" display="inline" intent=":literal"><semantics><mrow><mi>R</mi><mo>≥</mo><mn>3</mn></mrow><annotation encoding="application/x-tex">R\geq 3</annotation></semantics></math>) and the latter implies that the rank of <math id="S3.SS2.SSS0.Px1.p1.m15" class="ltx_Math" alttext="X^{\prime}_{1}" display="inline" intent=":literal"><semantics><msubsup><mi>X</mi><mn>1</mn><mo>′</mo></msubsup><annotation encoding="application/x-tex">X^{\prime}_{1}</annotation></semantics></math> is three for a generic signal.
Hence, we have recovered the first bands of both the distribution and signal up to the same <math id="S3.SS2.SSS0.Px1.p1.m16" class="ltx_Math" alttext="\mathrm{O}(3)" display="inline" intent=":literal"><semantics><mrow><mi>O</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mn>3</mn><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">\mathrm{O}(3)</annotation></semantics></math> action,
which is equivalent to recovering their joint <math id="S3.SS2.SSS0.Px1.p1.m17" class="ltx_Math" alttext="\SO(3)" display="inline" intent=":literal"><semantics><mrow><mi>SO</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mn>3</mn><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">\SO(3)</annotation></semantics></math> orbit up to a global sign.
We can eliminate the sign ambiguity by comparing
<math id="S3.SS2.SSS0.Px1.p1.m18" class="ltx_Math" alttext="(\hat{\rho}(H_{1})^{\prime})^{*}(X^{\prime}_{1}\otimes X^{\prime}_{1})_{1}" display="inline" intent=":literal"><semantics><mrow><msup><mrow><mo stretchy="false">(</mo><mrow><mover accent="true"><mi>ρ</mi><mo>^</mo></mover><mo lspace="0em" rspace="0em">​</mo><msup><mrow><mo stretchy="false">(</mo><msub><mi>H</mi><mn>1</mn></msub><mo stretchy="false">)</mo></mrow><mo>′</mo></msup></mrow><mo stretchy="false">)</mo></mrow><mo>∗</mo></msup><mo lspace="0em" rspace="0em">​</mo><msub><mrow><mo stretchy="false">(</mo><mrow><msubsup><mi>X</mi><mn>1</mn><mo>′</mo></msubsup><mo lspace="0.222em" rspace="0.222em">⊗</mo><msubsup><mi>X</mi><mn>1</mn><mo>′</mo></msubsup></mrow><mo stretchy="false">)</mo></mrow><mn>1</mn></msub></mrow><annotation encoding="application/x-tex">(\hat{\rho}(H_{1})^{\prime})^{*}(X^{\prime}_{1}\otimes X^{\prime}_{1})_{1}</annotation></semantics></math> with the component <math id="S3.SS2.SSS0.Px1.p1.m19" class="ltx_Math" alttext="\hat{\rho}(H_{1})^{*}(X_{1}\otimes X_{1})_{1}" display="inline" intent=":literal"><semantics><mrow><mover accent="true"><mi>ρ</mi><mo>^</mo></mover><mo lspace="0em" rspace="0em">​</mo><msup><mrow><mo stretchy="false">(</mo><msub><mi>H</mi><mn>1</mn></msub><mo stretchy="false">)</mo></mrow><mo>∗</mo></msup><mo lspace="0em" rspace="0em">​</mo><msub><mrow><mo stretchy="false">(</mo><mrow><msub><mi>X</mi><mn>1</mn></msub><mo lspace="0.222em" rspace="0.222em">⊗</mo><msub><mi>X</mi><mn>1</mn></msub></mrow><mo stretchy="false">)</mo></mrow><mn>1</mn></msub></mrow><annotation encoding="application/x-tex">\hat{\rho}(H_{1})^{*}(X_{1}\otimes X_{1})_{1}</annotation></semantics></math> of the second moment.</p>
</div>
</section>
<section id="S3.SS2.SSS0.Px2" class="ltx_paragraph">
<h5 class="ltx_title ltx_font_bold ltx_title_paragraph">Induction step.</h5>

<div id="S3.SS2.SSS0.Px2.p1" class="ltx_para">
<p id="S3.SS2.SSS0.Px2.p1.1" class="ltx_p">Now, suppose that we have determined the following Fourier coefficients,
<math id="S3.SS2.SSS0.Px2.p1.m1" class="ltx_Math" alttext="\hat{\rho}(\mathbf{1}),\ldots,\hat{\rho}(H_{\ell-1})" display="inline" intent=":literal"><semantics><mrow><mrow><mover accent="true"><mi>ρ</mi><mo>^</mo></mover><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mn>𝟏</mn><mo stretchy="false">)</mo></mrow></mrow><mo>,</mo><mi mathvariant="normal">…</mi><mo>,</mo><mrow><mover accent="true"><mi>ρ</mi><mo>^</mo></mover><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mi>H</mi><mrow><mi mathvariant="normal">ℓ</mi><mo>−</mo><mn>1</mn></mrow></msub><mo stretchy="false">)</mo></mrow></mrow></mrow><annotation encoding="application/x-tex">\hat{\rho}(\mathbf{1}),\ldots,\hat{\rho}(H_{\ell-1})</annotation></semantics></math>, and thus the corresponding signal matrices <math id="S3.SS2.SSS0.Px2.p1.m2" class="ltx_Math" alttext="X_{1},\ldots,X_{\ell-1}" display="inline" intent=":literal"><semantics><mrow><msub><mi>X</mi><mn>1</mn></msub><mo>,</mo><mi mathvariant="normal">…</mi><mo>,</mo><msub><mi>X</mi><mrow><mi mathvariant="normal">ℓ</mi><mo>−</mo><mn>1</mn></mrow></msub></mrow><annotation encoding="application/x-tex">X_{1},\ldots,X_{\ell-1}</annotation></semantics></math>.
We will show that we can solve a linear system to determine the Fourier coefficient <math id="S3.SS2.SSS0.Px2.p1.m3" class="ltx_Math" alttext="\hat{\rho}(H_{\ell})" display="inline" intent=":literal"><semantics><mrow><mover accent="true"><mi>ρ</mi><mo>^</mo></mover><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mi>H</mi><mi mathvariant="normal">ℓ</mi></msub><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">\hat{\rho}(H_{\ell})</annotation></semantics></math>.</p>
</div>
<div id="S3.Thmtheorem5" class="ltx_theorem ltx_theorem_lemma">
<h6 class="ltx_title ltx_runin ltx_title_theorem"><span class="ltx_tag ltx_tag_theorem"><span id="S3.Thmtheorem5.1" class="ltx_text ltx_font_bold">Lemma 3.5</span></span><span id="S3.Thmtheorem5.2" class="ltx_text ltx_font_bold">.</span></h6>
<div id="S3.Thmtheorem5.p1" class="ltx_para">
<p id="S3.Thmtheorem5.p1.1" class="ltx_p"><span id="S3.Thmtheorem5.p1.1.1" class="ltx_text ltx_font_italic">Suppose the orbit of <math id="S3.Thmtheorem5.p1.m1" class="ltx_Math" alttext="(\rho,x)\in L^{2}(\mathrm{SO}(3))_{\ell-1}\times(L^{2}(S^{2})_{\ell-1})^{R}" display="inline" intent=":literal"><semantics><mrow><mrow><mo stretchy="false">(</mo><mi>ρ</mi><mo>,</mo><mi>x</mi><mo stretchy="false">)</mo></mrow><mo>∈</mo><mrow><mrow><msup><mi>L</mi><mn>2</mn></msup><mo lspace="0em" rspace="0em">​</mo><msub><mrow><mo stretchy="false">(</mo><mrow><mi>SO</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mn>3</mn><mo stretchy="false">)</mo></mrow></mrow><mo rspace="0.055em" stretchy="false">)</mo></mrow><mrow><mi mathvariant="normal">ℓ</mi><mo>−</mo><mn>1</mn></mrow></msub></mrow><mo rspace="0.222em">×</mo><msup><mrow><mo stretchy="false">(</mo><mrow><msup><mi>L</mi><mn>2</mn></msup><mo lspace="0em" rspace="0em">​</mo><msub><mrow><mo stretchy="false">(</mo><msup><mi>S</mi><mn>2</mn></msup><mo stretchy="false">)</mo></mrow><mrow><mi mathvariant="normal">ℓ</mi><mo>−</mo><mn>1</mn></mrow></msub></mrow><mo stretchy="false">)</mo></mrow><mi>R</mi></msup></mrow></mrow><annotation encoding="application/x-tex">(\rho,x)\in L^{2}(\mathrm{SO}(3))_{\ell-1}\times(L^{2}(S^{2})_{\ell-1})^{R}</annotation></semantics></math> is fixed with <math id="S3.Thmtheorem5.p1.m2" class="ltx_Math" alttext="\ell&gt;1" display="inline" intent=":literal"><semantics><mrow><mi mathvariant="normal">ℓ</mi><mo>&gt;</mo><mn>1</mn></mrow><annotation encoding="application/x-tex">\ell&gt;1</annotation></semantics></math>. If <math id="S3.Thmtheorem5.p1.m3" class="ltx_Math" alttext="-\ell\leq s\leq\ell" display="inline" intent=":literal"><semantics><mrow><mrow><mo>−</mo><mi mathvariant="normal">ℓ</mi></mrow><mo>≤</mo><mi>s</mi><mo>≤</mo><mi mathvariant="normal">ℓ</mi></mrow><annotation encoding="application/x-tex">-\ell\leq s\leq\ell</annotation></semantics></math>, the distribution coefficients
<math id="S3.Thmtheorem5.p1.m4" class="ltx_Math" alttext="{\rho}^{\ell}_{k}[s]" display="inline" intent=":literal"><semantics><mrow><msubsup><mi>ρ</mi><mi>k</mi><mi mathvariant="normal">ℓ</mi></msubsup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">[</mo><mi>s</mi><mo stretchy="false">]</mo></mrow></mrow><annotation encoding="application/x-tex">{\rho}^{\ell}_{k}[s]</annotation></semantics></math> for <math id="S3.Thmtheorem5.p1.m5" class="ltx_Math" alttext="-\ell\leq k\leq\ell" display="inline" intent=":literal"><semantics><mrow><mrow><mo>−</mo><mi mathvariant="normal">ℓ</mi></mrow><mo>≤</mo><mi>k</mi><mo>≤</mo><mi mathvariant="normal">ℓ</mi></mrow><annotation encoding="application/x-tex">-\ell\leq k\leq\ell</annotation></semantics></math>
are determined by the invariants <math id="S3.Thmtheorem5.p1.m6" class="ltx_Math" alttext="M_{2}(\rho,x;H_{\ell}[s_{1}],H_{i}[s_{2}],H_{\ell-i}[s_{3}])" display="inline" intent=":literal"><semantics><mrow><msub><mi>M</mi><mn>2</mn></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>ρ</mi><mo>,</mo><mi>x</mi><mo>,</mo><mrow><msub><mi>H</mi><mi mathvariant="normal">ℓ</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">[</mo><msub><mi>s</mi><mn>1</mn></msub><mo stretchy="false">]</mo></mrow></mrow><mo>,</mo><mrow><msub><mi>H</mi><mi>i</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">[</mo><msub><mi>s</mi><mn>2</mn></msub><mo stretchy="false">]</mo></mrow></mrow><mo>,</mo><mrow><msub><mi>H</mi><mrow><mi mathvariant="normal">ℓ</mi><mo>−</mo><mi>i</mi></mrow></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">[</mo><msub><mi>s</mi><mn>3</mn></msub><mo stretchy="false">]</mo></mrow></mrow><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">M_{2}(\rho,x;H_{\ell}[s_{1}],H_{i}[s_{2}],H_{\ell-i}[s_{3}])</annotation></semantics></math> for <math id="S3.Thmtheorem5.p1.m7" class="ltx_Math" alttext="0\leq i\leq\lfloor\ell/2\rfloor" display="inline" intent=":literal"><semantics><mrow><mn>0</mn><mo>≤</mo><mi>i</mi><mo>≤</mo><mrow><mo stretchy="false">⌊</mo><mrow><mi mathvariant="normal">ℓ</mi><mo>/</mo><mn>2</mn></mrow><mo stretchy="false">⌋</mo></mrow></mrow><annotation encoding="application/x-tex">0\leq i\leq\lfloor\ell/2\rfloor</annotation></semantics></math>, provided that <math id="S3.Thmtheorem5.p1.m8" class="ltx_Math" alttext="R\geq 3" display="inline" intent=":literal"><semantics><mrow><mi>R</mi><mo>≥</mo><mn>3</mn></mrow><annotation encoding="application/x-tex">R\geq 3</annotation></semantics></math>.</span></p>
</div>
</div>
<div id="S3.SS2.SSS0.Px2.1" class="ltx_proof">
<h6 class="ltx_title ltx_runin ltx_font_italic ltx_title_proof">Proof.</h6>
<div id="S3.SS2.SSS0.Px2.p2" class="ltx_para">
<p id="S3.SS2.SSS0.Px2.p2.1" class="ltx_p"><span id="S3.SS2.SSS0.Px2.p2.1.1" class="ltx_text">For fixed <math id="S3.SS2.SSS0.Px2.p2.m1" class="ltx_Math" alttext="s_{1}" display="inline" intent=":literal"><semantics><msub><mi>s</mi><mn>1</mn></msub><annotation encoding="application/x-tex">s_{1}</annotation></semantics></math>, the second moment equation (<a href="#S2.E23" title="In 2.3. A Fourier-theoretic perspective of SO(3) moments ‣ 2. Background ‣ Provable orbit recovery over SO(3) from the non-uniform second moment" class="ltx_ref"><span class="ltx_text ltx_ref_tag">23</span></a>)</span></p>
<table id="S3.Ex13" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="S3.Ex13.m1" class="ltx_Math" alttext="M_{2}(\rho,x;H_{\ell}[s_{1}],H_{i}[s_{2}],H_{\ell-i}[s_{3}])=\sum_{\begin{subarray}{c}k_{2}+k_{3}=k_{1}\\
|k_{1}|\leq\ell,|k_{2}|\leq i,|k_{3}|\leq\ell-i\end{subarray}}\langle i\,k_{2}\;(\ell-i)\,k_{3}\mid\ell\,k_{1}\rangle\,\overline{\hat{\rho}^{\ell}_{k_{1}}[s_{1}]}\,x^{i}_{k_{2}}[s_{2}]\,x^{\ell-i}_{k_{3}}[s_{3}]," display="block" intent=":literal"><semantics><mrow><mrow><mrow><msub><mi>M</mi><mn>2</mn></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>ρ</mi><mo>,</mo><mi>x</mi><mo>,</mo><mrow><msub><mi>H</mi><mi mathvariant="normal">ℓ</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">[</mo><msub><mi>s</mi><mn>1</mn></msub><mo stretchy="false">]</mo></mrow></mrow><mo>,</mo><mrow><msub><mi>H</mi><mi>i</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">[</mo><msub><mi>s</mi><mn>2</mn></msub><mo stretchy="false">]</mo></mrow></mrow><mo>,</mo><mrow><msub><mi>H</mi><mrow><mi mathvariant="normal">ℓ</mi><mo>−</mo><mi>i</mi></mrow></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">[</mo><msub><mi>s</mi><mn>3</mn></msub><mo stretchy="false">]</mo></mrow></mrow><mo stretchy="false">)</mo></mrow></mrow><mo rspace="0.111em">=</mo><mrow><munder><mo movablelimits="false" rspace="0em">∑</mo><mtable rowspacing="0pt"><mtr><mtd><mrow><mrow><msub><mi>k</mi><mn>2</mn></msub><mo>+</mo><msub><mi>k</mi><mn>3</mn></msub></mrow><mo>=</mo><msub><mi>k</mi><mn>1</mn></msub></mrow></mtd></mtr><mtr><mtd><mrow><mrow><mrow><mo stretchy="false">|</mo><msub><mi>k</mi><mn>1</mn></msub><mo stretchy="false">|</mo></mrow><mo>≤</mo><mi mathvariant="normal">ℓ</mi></mrow><mo>,</mo><mrow><mrow><mo stretchy="false">|</mo><msub><mi>k</mi><mn>2</mn></msub><mo stretchy="false">|</mo></mrow><mo>≤</mo><mi>i</mi></mrow><mo>,</mo><mrow><mrow><mo stretchy="false">|</mo><msub><mi>k</mi><mn>3</mn></msub><mo stretchy="false">|</mo></mrow><mo>≤</mo><mrow><mi mathvariant="normal">ℓ</mi><mo>−</mo><mi>i</mi></mrow></mrow></mrow></mtd></mtr></mtable></munder><mrow><mrow><mo stretchy="false">⟨</mo><mrow><mi>i</mi><mo lspace="0.170em" rspace="0em">​</mo><msub><mi>k</mi><mn>2</mn></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mrow><mi mathvariant="normal">ℓ</mi><mo>−</mo><mi>i</mi></mrow><mo stretchy="false">)</mo></mrow><mo lspace="0.170em" rspace="0em">​</mo><msub><mi>k</mi><mn>3</mn></msub></mrow><mo lspace="0em" rspace="0.167em">∣</mo><mrow><mi mathvariant="normal">ℓ</mi><mo lspace="0.170em" rspace="0em">​</mo><msub><mi>k</mi><mn>1</mn></msub></mrow><mo stretchy="false">⟩</mo></mrow><mo lspace="0.170em" rspace="0em">​</mo><mover accent="true"><mrow><msubsup><mover accent="true"><mi>ρ</mi><mo>^</mo></mover><msub><mi>k</mi><mn>1</mn></msub><mi mathvariant="normal">ℓ</mi></msubsup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">[</mo><msub><mi>s</mi><mn>1</mn></msub><mo stretchy="false">]</mo></mrow></mrow><mo stretchy="true">¯</mo></mover><mo lspace="0em" rspace="0em">​</mo><msubsup><mi>x</mi><msub><mi>k</mi><mn>2</mn></msub><mi>i</mi></msubsup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">[</mo><msub><mi>s</mi><mn>2</mn></msub><mo stretchy="false">]</mo></mrow><mo lspace="0.170em" rspace="0em">​</mo><msubsup><mi>x</mi><msub><mi>k</mi><mn>3</mn></msub><mrow><mi mathvariant="normal">ℓ</mi><mo>−</mo><mi>i</mi></mrow></msubsup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">[</mo><msub><mi>s</mi><mn>3</mn></msub><mo stretchy="false">]</mo></mrow></mrow></mrow></mrow><mo>,</mo></mrow><annotation encoding="application/x-tex">M_{2}(\rho,x;H_{\ell}[s_{1}],H_{i}[s_{2}],H_{\ell-i}[s_{3}])=\sum_{\begin{subarray}{c}k_{2}+k_{3}=k_{1}\\
|k_{1}|\leq\ell,|k_{2}|\leq i,|k_{3}|\leq\ell-i\end{subarray}}\langle i\,k_{2}\;(\ell-i)\,k_{3}\mid\ell\,k_{1}\rangle\,\overline{\hat{\rho}^{\ell}_{k_{1}}[s_{1}]}\,x^{i}_{k_{2}}[s_{2}]\,x^{\ell-i}_{k_{3}}[s_{3}],</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="S3.SS2.SSS0.Px2.p2.2" class="ltx_p"><span id="S3.SS2.SSS0.Px2.p2.2.1" class="ltx_text">gives a linear equation in the <math id="S3.SS2.SSS0.Px2.p2.m2" class="ltx_Math" alttext="2\ell+1" display="inline" intent=":literal"><semantics><mrow><mrow><mn>2</mn><mo lspace="0em" rspace="0em">​</mo><mi mathvariant="normal">ℓ</mi></mrow><mo>+</mo><mn>1</mn></mrow><annotation encoding="application/x-tex">2\ell+1</annotation></semantics></math> unknowns <math id="S3.SS2.SSS0.Px2.p2.m3" class="ltx_Math" alttext="\overline{\hat{\rho}}^{\ell}_{k}[s_{1}]" display="inline" intent=":literal"><semantics><mrow><msubsup><mover accent="true"><mover accent="true"><mi>ρ</mi><mo>^</mo></mover><mo stretchy="true">¯</mo></mover><mi>k</mi><mi mathvariant="normal">ℓ</mi></msubsup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">[</mo><msub><mi>s</mi><mn>1</mn></msub><mo stretchy="false">]</mo></mrow></mrow><annotation encoding="application/x-tex">\overline{\hat{\rho}}^{\ell}_{k}[s_{1}]</annotation></semantics></math> with <math id="S3.SS2.SSS0.Px2.p2.m4" class="ltx_Math" alttext="-\ell\leq k\leq\ell" display="inline" intent=":literal"><semantics><mrow><mrow><mo>−</mo><mi mathvariant="normal">ℓ</mi></mrow><mo>≤</mo><mi>k</mi><mo>≤</mo><mi mathvariant="normal">ℓ</mi></mrow><annotation encoding="application/x-tex">-\ell\leq k\leq\ell</annotation></semantics></math>.
The coefficients <math id="S3.SS2.SSS0.Px2.p2.m5" class="ltx_Math" alttext="C(x^{i}[s_{2}],x^{\ell-i}[s_{3}])_{k}=\sum_{\begin{subarray}{c}k_{1}-k_{2}=k\end{subarray}}\langle i\,k_{1}\;(\ell-i)\,k_{2}\mid\ell\,k\rangle\,x^{i}[s_{2}]_{k_{1}}x^{\ell-i}[s_{3}]_{k_{2}}" display="inline" intent=":literal"><semantics><mrow><mrow><mi>C</mi><mo lspace="0em" rspace="0em">​</mo><msub><mrow><mo stretchy="false">(</mo><mrow><msup><mi>x</mi><mi>i</mi></msup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">[</mo><msub><mi>s</mi><mn>2</mn></msub><mo stretchy="false">]</mo></mrow></mrow><mo>,</mo><mrow><msup><mi>x</mi><mrow><mi mathvariant="normal">ℓ</mi><mo>−</mo><mi>i</mi></mrow></msup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">[</mo><msub><mi>s</mi><mn>3</mn></msub><mo stretchy="false">]</mo></mrow></mrow><mo stretchy="false">)</mo></mrow><mi>k</mi></msub></mrow><mo rspace="0.111em">=</mo><mrow><msub><mo rspace="0em">∑</mo><mtable><mtr><mtd><mrow><mrow><msub><mi>k</mi><mn>1</mn></msub><mo>−</mo><msub><mi>k</mi><mn>2</mn></msub></mrow><mo>=</mo><mi>k</mi></mrow></mtd></mtr></mtable></msub><mrow><mrow><mo stretchy="false">⟨</mo><mrow><mi>i</mi><mo lspace="0.170em" rspace="0em">​</mo><msub><mi>k</mi><mn>1</mn></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mrow><mi mathvariant="normal">ℓ</mi><mo>−</mo><mi>i</mi></mrow><mo stretchy="false">)</mo></mrow><mo lspace="0.170em" rspace="0em">​</mo><msub><mi>k</mi><mn>2</mn></msub></mrow><mo lspace="0em" rspace="0.167em">∣</mo><mrow><mi mathvariant="normal">ℓ</mi><mo lspace="0.170em" rspace="0em">​</mo><mi>k</mi></mrow><mo stretchy="false">⟩</mo></mrow><mo lspace="0.170em" rspace="0em">​</mo><msup><mi>x</mi><mi>i</mi></msup><mo lspace="0em" rspace="0em">​</mo><msub><mrow><mo stretchy="false">[</mo><msub><mi>s</mi><mn>2</mn></msub><mo stretchy="false">]</mo></mrow><msub><mi>k</mi><mn>1</mn></msub></msub><mo lspace="0em" rspace="0em">​</mo><msup><mi>x</mi><mrow><mi mathvariant="normal">ℓ</mi><mo>−</mo><mi>i</mi></mrow></msup><mo lspace="0em" rspace="0em">​</mo><msub><mrow><mo stretchy="false">[</mo><msub><mi>s</mi><mn>3</mn></msub><mo stretchy="false">]</mo></mrow><msub><mi>k</mi><mn>2</mn></msub></msub></mrow></mrow></mrow><annotation encoding="application/x-tex">C(x^{i}[s_{2}],x^{\ell-i}[s_{3}])_{k}=\sum_{\begin{subarray}{c}k_{1}-k_{2}=k\end{subarray}}\langle i\,k_{1}\;(\ell-i)\,k_{2}\mid\ell\,k\rangle\,x^{i}[s_{2}]_{k_{1}}x^{\ell-i}[s_{3}]_{k_{2}}</annotation></semantics></math> are bilinear forms in the variables
<math id="S3.SS2.SSS0.Px2.p2.m6" class="ltx_Math" alttext="x^{i,\ell-i}_{s,t}[s_{2},s_{3}]\coloneq x^{i}_{s}[s_{2}]x^{\ell-i}_{t}[s_{3}]" display="inline" intent=":literal"><semantics><mrow><mrow><msubsup><mi>x</mi><mrow><mi>s</mi><mo>,</mo><mi>t</mi></mrow><mrow><mi>i</mi><mo>,</mo><mrow><mi mathvariant="normal">ℓ</mi><mo>−</mo><mi>i</mi></mrow></mrow></msubsup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">[</mo><mrow><msub><mi>s</mi><mn>2</mn></msub><mo>,</mo><msub><mi>s</mi><mn>3</mn></msub></mrow><mo stretchy="false">]</mo></mrow></mrow><mo>≔</mo><mrow><msubsup><mi>x</mi><mi>s</mi><mi>i</mi></msubsup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">[</mo><msub><mi>s</mi><mn>2</mn></msub><mo stretchy="false">]</mo></mrow><mo lspace="0em" rspace="0em">​</mo><msubsup><mi>x</mi><mi>t</mi><mrow><mi mathvariant="normal">ℓ</mi><mo>−</mo><mi>i</mi></mrow></msubsup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">[</mo><msub><mi>s</mi><mn>3</mn></msub><mo stretchy="false">]</mo></mrow></mrow></mrow><annotation encoding="application/x-tex">x^{i,\ell-i}_{s,t}[s_{2},s_{3}]\coloneq x^{i}_{s}[s_{2}]x^{\ell-i}_{t}[s_{3}]</annotation></semantics></math>.
Taking indices <math id="S3.SS2.SSS0.Px2.p2.m7" class="ltx_Math" alttext="(s_{2},s_{3})\in S_{i,\ell-i}[R]" display="inline" intent=":literal"><semantics><mrow><mrow><mo stretchy="false">(</mo><msub><mi>s</mi><mn>2</mn></msub><mo>,</mo><msub><mi>s</mi><mn>3</mn></msub><mo stretchy="false">)</mo></mrow><mo>∈</mo><mrow><msub><mi>S</mi><mrow><mi>i</mi><mo>,</mo><mrow><mi mathvariant="normal">ℓ</mi><mo>−</mo><mi>i</mi></mrow></mrow></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">[</mo><mi>R</mi><mo stretchy="false">]</mo></mrow></mrow></mrow><annotation encoding="application/x-tex">(s_{2},s_{3})\in S_{i,\ell-i}[R]</annotation></semantics></math>, where</span></p>
<table id="S3.Ex14" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="S3.Ex14.m1" class="ltx_Math" alttext="S_{i,\ell-i}[R]=\begin{cases}\{(1,1),\ldots,(1,R),(2,1),\ldots,(R,1)\}&amp;\text{if }i\neq\ell-i,\\
\{(1,1),\ldots,(1,R)\}&amp;\text{if }i=\ell-i,\end{cases}" display="block" intent=":literal"><semantics><mrow><mrow><msub><mi>S</mi><mrow><mi>i</mi><mo>,</mo><mrow><mi mathvariant="normal">ℓ</mi><mo>−</mo><mi>i</mi></mrow></mrow></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">[</mo><mi>R</mi><mo stretchy="false">]</mo></mrow></mrow><mo>=</mo><mrow><mo>{</mo><mtable columnspacing="5pt" displaystyle="true" rowspacing="0pt"><mtr><mtd class="ltx_align_left" columnalign="left"><mrow><mo stretchy="false">{</mo><mrow><mrow><mo stretchy="false">(</mo><mn>1</mn><mo>,</mo><mn>1</mn><mo stretchy="false">)</mo></mrow><mo>,</mo><mi mathvariant="normal">…</mi><mo>,</mo><mrow><mo stretchy="false">(</mo><mn>1</mn><mo>,</mo><mi>R</mi><mo stretchy="false">)</mo></mrow><mo>,</mo><mrow><mo stretchy="false">(</mo><mn>2</mn><mo>,</mo><mn>1</mn><mo stretchy="false">)</mo></mrow><mo>,</mo><mi mathvariant="normal">…</mi><mo>,</mo><mrow><mo stretchy="false">(</mo><mi>R</mi><mo>,</mo><mn>1</mn><mo stretchy="false">)</mo></mrow></mrow><mo stretchy="false">}</mo></mrow></mtd><mtd class="ltx_align_left" columnalign="left"><mrow><mrow><mrow><mtext>if </mtext><mo lspace="0em" rspace="0em">​</mo><mi>i</mi></mrow><mo>≠</mo><mrow><mi mathvariant="normal">ℓ</mi><mo>−</mo><mi>i</mi></mrow></mrow><mo>,</mo></mrow></mtd></mtr><mtr><mtd class="ltx_align_left" columnalign="left"><mrow><mo stretchy="false">{</mo><mrow><mo stretchy="false">(</mo><mn>1</mn><mo>,</mo><mn>1</mn><mo stretchy="false">)</mo></mrow><mo>,</mo><mi mathvariant="normal">…</mi><mo>,</mo><mrow><mo stretchy="false">(</mo><mn>1</mn><mo>,</mo><mi>R</mi><mo stretchy="false">)</mo></mrow><mo stretchy="false">}</mo></mrow></mtd><mtd class="ltx_align_left" columnalign="left"><mrow><mrow><mrow><mtext>if </mtext><mo lspace="0em" rspace="0em">​</mo><mi>i</mi></mrow><mo>=</mo><mrow><mi mathvariant="normal">ℓ</mi><mo>−</mo><mi>i</mi></mrow></mrow><mo>,</mo></mrow></mtd></mtr></mtable></mrow></mrow><annotation encoding="application/x-tex">S_{i,\ell-i}[R]=\begin{cases}\{(1,1),\ldots,(1,R),(2,1),\ldots,(R,1)\}&amp;\text{if }i\neq\ell-i,\\
\{(1,1),\ldots,(1,R)\}&amp;\text{if }i=\ell-i,\end{cases}</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="S3.SS2.SSS0.Px2.p2.3" class="ltx_p"><span id="S3.SS2.SSS0.Px2.p2.3.1" class="ltx_text">and varying <math id="S3.SS2.SSS0.Px2.p2.m8" class="ltx_Math" alttext="i" display="inline" intent=":literal"><semantics><mi>i</mi><annotation encoding="application/x-tex">i</annotation></semantics></math> from <math id="S3.SS2.SSS0.Px2.p2.m9" class="ltx_Math" alttext="0" display="inline" intent=":literal"><semantics><mn>0</mn><annotation encoding="application/x-tex">0</annotation></semantics></math> to <math id="S3.SS2.SSS0.Px2.p2.m10" class="ltx_Math" alttext="\lfloor\ell/2\rfloor" display="inline" intent=":literal"><semantics><mrow><mo stretchy="false">⌊</mo><mrow><mi mathvariant="normal">ℓ</mi><mo>/</mo><mn>2</mn></mrow><mo stretchy="false">⌋</mo></mrow><annotation encoding="application/x-tex">\lfloor\ell/2\rfloor</annotation></semantics></math>, we obtain
<math id="S3.SS2.SSS0.Px2.p2.m11" class="ltx_Math" alttext="(\lfloor\ell/2\rfloor+1)\cdot(2R-1)" display="inline" intent=":literal"><semantics><mrow><mrow><mo stretchy="false">(</mo><mrow><mrow><mo stretchy="false">⌊</mo><mrow><mi mathvariant="normal">ℓ</mi><mo>/</mo><mn>2</mn></mrow><mo stretchy="false">⌋</mo></mrow><mo>+</mo><mn>1</mn></mrow><mo rspace="0.055em" stretchy="false">)</mo></mrow><mo rspace="0.222em">⋅</mo><mrow><mo stretchy="false">(</mo><mrow><mrow><mn>2</mn><mo lspace="0em" rspace="0em">​</mo><mi>R</mi></mrow><mo>−</mo><mn>1</mn></mrow><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">(\lfloor\ell/2\rfloor+1)\cdot(2R-1)</annotation></semantics></math>
equations.
For <math id="S3.SS2.SSS0.Px2.p2.m12" class="ltx_Math" alttext="R\geq 3" display="inline" intent=":literal"><semantics><mrow><mi>R</mi><mo>≥</mo><mn>3</mn></mrow><annotation encoding="application/x-tex">R\geq 3</annotation></semantics></math>, this gives at least <math id="S3.SS2.SSS0.Px2.p2.m13" class="ltx_Math" alttext="(\lfloor\ell/2\rfloor+1)\cdot 5\geq 2\ell+1" display="inline" intent=":literal"><semantics><mrow><mrow><mrow><mo stretchy="false">(</mo><mrow><mrow><mo stretchy="false">⌊</mo><mrow><mi mathvariant="normal">ℓ</mi><mo>/</mo><mn>2</mn></mrow><mo stretchy="false">⌋</mo></mrow><mo>+</mo><mn>1</mn></mrow><mo rspace="0.055em" stretchy="false">)</mo></mrow><mo rspace="0.222em">⋅</mo><mn>5</mn></mrow><mo>≥</mo><mrow><mrow><mn>2</mn><mo lspace="0em" rspace="0em">​</mo><mi mathvariant="normal">ℓ</mi></mrow><mo>+</mo><mn>1</mn></mrow></mrow><annotation encoding="application/x-tex">(\lfloor\ell/2\rfloor+1)\cdot 5\geq 2\ell+1</annotation></semantics></math> when <math id="S3.SS2.SSS0.Px2.p2.m14" class="ltx_Math" alttext="\ell\geq 1" display="inline" intent=":literal"><semantics><mrow><mi mathvariant="normal">ℓ</mi><mo>≥</mo><mn>1</mn></mrow><annotation encoding="application/x-tex">\ell\geq 1</annotation></semantics></math>.</span></p>
</div>
<div id="S3.SS2.SSS0.Px2.p3" class="ltx_para">
<p id="S3.SS2.SSS0.Px2.p3.1" class="ltx_p"><span id="S3.SS2.SSS0.Px2.p3.1.1" class="ltx_text">For two distinct pairs <math id="S3.SS2.SSS0.Px2.p3.m1" class="ltx_Math" alttext="(s^{\prime}_{2},s^{\prime}_{3}),(s^{\prime\prime}_{2},s^{\prime\prime}_{3})\in S_{i,\ell-i}[R]" display="inline" intent=":literal"><semantics><mrow><mrow><mo stretchy="false">(</mo><msubsup><mi>s</mi><mn>2</mn><mo>′</mo></msubsup><mo>,</mo><msubsup><mi>s</mi><mn>3</mn><mo>′</mo></msubsup><mo stretchy="false">)</mo></mrow><mo>,</mo><mrow><mrow><mo stretchy="false">(</mo><msubsup><mi>s</mi><mn>2</mn><mo>′′</mo></msubsup><mo>,</mo><msubsup><mi>s</mi><mn>3</mn><mo>′′</mo></msubsup><mo stretchy="false">)</mo></mrow><mo>∈</mo><mrow><msub><mi>S</mi><mrow><mi>i</mi><mo>,</mo><mrow><mi mathvariant="normal">ℓ</mi><mo>−</mo><mi>i</mi></mrow></mrow></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">[</mo><mi>R</mi><mo stretchy="false">]</mo></mrow></mrow></mrow></mrow><annotation encoding="application/x-tex">(s^{\prime}_{2},s^{\prime}_{3}),(s^{\prime\prime}_{2},s^{\prime\prime}_{3})\in S_{i,\ell-i}[R]</annotation></semantics></math>, there are no algebraic relations between the corresponding sets of monomials, so we may treat them as distinct sets of variables.
Using the shorthand <math id="S3.SS2.SSS0.Px2.p3.m2" class="ltx_Math" alttext="C(\{x^{i,\ell-i}_{s,t}[s_{2},s_{3}]\})_{k}" display="inline" intent=":literal"><semantics><mrow><mi>C</mi><mo lspace="0em" rspace="0em">​</mo><msub><mrow><mo stretchy="false">(</mo><mrow><mo stretchy="false">{</mo><mrow><msubsup><mi>x</mi><mrow><mi>s</mi><mo>,</mo><mi>t</mi></mrow><mrow><mi>i</mi><mo>,</mo><mrow><mi mathvariant="normal">ℓ</mi><mo>−</mo><mi>i</mi></mrow></mrow></msubsup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">[</mo><mrow><msub><mi>s</mi><mn>2</mn></msub><mo>,</mo><msub><mi>s</mi><mn>3</mn></msub></mrow><mo stretchy="false">]</mo></mrow></mrow><mo stretchy="false">}</mo></mrow><mo stretchy="false">)</mo></mrow><mi>k</mi></msub></mrow><annotation encoding="application/x-tex">C(\{x^{i,\ell-i}_{s,t}[s_{2},s_{3}]\})_{k}</annotation></semantics></math> for the coefficient <math id="S3.SS2.SSS0.Px2.p3.m3" class="ltx_Math" alttext="C(x^{i}[s_{2}],x^{\ell-i}[s_{3}])_{k}" display="inline" intent=":literal"><semantics><mrow><mi>C</mi><mo lspace="0em" rspace="0em">​</mo><msub><mrow><mo stretchy="false">(</mo><mrow><msup><mi>x</mi><mi>i</mi></msup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">[</mo><msub><mi>s</mi><mn>2</mn></msub><mo stretchy="false">]</mo></mrow></mrow><mo>,</mo><mrow><msup><mi>x</mi><mrow><mi mathvariant="normal">ℓ</mi><mo>−</mo><mi>i</mi></mrow></msup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">[</mo><msub><mi>s</mi><mn>3</mn></msub><mo stretchy="false">]</mo></mrow></mrow><mo stretchy="false">)</mo></mrow><mi>k</mi></msub></mrow><annotation encoding="application/x-tex">C(x^{i}[s_{2}],x^{\ell-i}[s_{3}])_{k}</annotation></semantics></math>, the coefficient matrix is</span></p>
<table id="S3.E24" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td rowspan="1" class="ltx_eqn_cell ltx_eqn_eqno ltx_align_middle ltx_align_left"><span class="ltx_tag ltx_tag_equation ltx_align_left">(24)</span></td>
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="S3.E24.m1" class="ltx_Math" alttext="M=\begin{pmatrix}C(\{x^{0,\ell}_{s,t}[1,1]\})_{-\ell}&amp;\cdots&amp;C(\{x^{0,\ell}_{s,t}[1,1]\})_{\ell}\\
\vdots&amp;&amp;\vdots\\
C(\{x^{0,\ell}_{s,t}[1,R]\})_{-\ell}&amp;\cdots&amp;C(\{x^{0,\ell}_{s,t}[1,R]\})_{\ell}\\
C(\{x^{0,\ell}_{s,t}[2,1]\})_{-\ell}&amp;\cdots&amp;C(\{x^{0,\ell}_{s,t}[2,1]\})_{\ell}\\
\vdots&amp;&amp;\vdots\\
C(\{x^{0,\ell}_{s,t}[R,1]\})_{-\ell}&amp;\cdots&amp;C(\{x^{0,\ell}_{s,t}[R,1]\})_{\ell}\\
C(\{x^{1,\ell-1}_{s,t}[1,1]\})_{-\ell}&amp;\cdots&amp;C(\{x^{1,\ell-1}_{s,t}[1,1]\})_{\ell}\\
\vdots&amp;&amp;\vdots\\
C(\{x^{1,\ell-1}_{s,t}[1,R]\})_{-\ell}&amp;\cdots&amp;C(\{x^{1,\ell-1}_{s,t}[1,R]\})_{\ell}\\
C(\{x^{1,\ell-1}_{s,t}[2,1]\})_{-\ell}&amp;\cdots&amp;C(\{x^{1,\ell-1}_{s,t}[2,1]\})_{\ell}\\
\vdots&amp;&amp;\vdots\\
C(\{x^{1,\ell-1}_{s,t}[R,1]\})_{-\ell}&amp;\cdots&amp;C(\{x^{1,\ell-1}_{s,t}[R,1]\})_{\ell}\\
\vdots&amp;&amp;\vdots\\
C(\{x^{\lfloor\ell/2\rfloor,\lceil\ell/2\rceil}_{s,t}[1,1]\})_{-\ell}&amp;\cdots&amp;C(\{x^{\lfloor\ell/2\rfloor,\lceil\ell/2\rceil}_{s,t}[1,1]\})_{\ell}\\
\vdots&amp;&amp;\vdots\\
C(\{x^{\lfloor\ell/2\rfloor,\lceil\ell/2\rceil}_{s,t}[1,R]\})_{-\ell}&amp;\cdots&amp;C(\{x^{\lfloor\ell/2\rfloor,\lceil\ell/2\rceil}_{s,t}[1,R]\})_{\ell}\\
C(\{x^{\lfloor\ell/2\rfloor,\lceil\ell/2\rceil}_{s,t}[2,1]\})_{-\ell}&amp;\cdots&amp;C(\{x^{\lfloor\ell/2\rfloor,\lceil\ell/2\rceil}_{s,t}[2,1]\})_{\ell}\\
\vdots&amp;&amp;\vdots\\
C(\{x^{\lfloor\ell/2\rfloor,\lceil\ell/2\rceil}_{s,t}[R,1]\})_{-\ell}&amp;\cdots&amp;C(\{x^{\lfloor\ell/2\rfloor,\lceil\ell/2\rceil}_{s,t}[R,1]\})_{\ell}\end{pmatrix}." display="block" intent=":literal"><semantics><mrow><mrow><mi>M</mi><mo>=</mo><mrow><mo>(</mo><mtable columnspacing="5pt" displaystyle="true" rowspacing="0pt"><mtr><mtd><mrow><mi>C</mi><mo lspace="0em" rspace="0em">​</mo><msub><mrow><mo stretchy="false">(</mo><mrow><mo stretchy="false">{</mo><mrow><msubsup><mi>x</mi><mrow><mi>s</mi><mo>,</mo><mi>t</mi></mrow><mrow><mn>0</mn><mo>,</mo><mi mathvariant="normal">ℓ</mi></mrow></msubsup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">[</mo><mrow><mn>1</mn><mo>,</mo><mn>1</mn></mrow><mo stretchy="false">]</mo></mrow></mrow><mo stretchy="false">}</mo></mrow><mo stretchy="false">)</mo></mrow><mrow><mo>−</mo><mi mathvariant="normal">ℓ</mi></mrow></msub></mrow></mtd><mtd><mo>⋯</mo></mtd><mtd><mrow><mi>C</mi><mo lspace="0em" rspace="0em">​</mo><msub><mrow><mo stretchy="false">(</mo><mrow><mo stretchy="false">{</mo><mrow><msubsup><mi>x</mi><mrow><mi>s</mi><mo>,</mo><mi>t</mi></mrow><mrow><mn>0</mn><mo>,</mo><mi mathvariant="normal">ℓ</mi></mrow></msubsup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">[</mo><mrow><mn>1</mn><mo>,</mo><mn>1</mn></mrow><mo stretchy="false">]</mo></mrow></mrow><mo stretchy="false">}</mo></mrow><mo stretchy="false">)</mo></mrow><mi mathvariant="normal">ℓ</mi></msub></mrow></mtd></mtr><mtr><mtd></mtd><mtd></mtd><mtd></mtd></mtr><mtr><mtd><mrow><mi>C</mi><mo lspace="0em" rspace="0em">​</mo><msub><mrow><mo stretchy="false">(</mo><mrow><mo stretchy="false">{</mo><mrow><msubsup><mi>x</mi><mrow><mi>s</mi><mo>,</mo><mi>t</mi></mrow><mrow><mn>0</mn><mo>,</mo><mi mathvariant="normal">ℓ</mi></mrow></msubsup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">[</mo><mrow><mn>1</mn><mo>,</mo><mi>R</mi></mrow><mo stretchy="false">]</mo></mrow></mrow><mo stretchy="false">}</mo></mrow><mo stretchy="false">)</m