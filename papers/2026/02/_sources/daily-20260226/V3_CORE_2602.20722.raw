<td id="A1.T2.8.1.15.1" class="ltx_td ltx_align_left ltx_border_r" style="--ltx-bg-color:#E6E6E6;"><span id="A1.T2.8.1.15.1.1" class="ltx_text ltx_font_bold" style="--ltx-bg-color:#E6E6E6;">BAPO (w/o <math id="A1.T2.m11" class="ltx_Math" alttext="\mathcal{X}_{2}" display="inline" intent=":literal"><semantics><msub><mi style="--ltx-bg-color:#E6E6E6;" class="ltx_font_mathcaligraphic" mathbackground="#E6E6E6">𝒳</mi><mn style="--ltx-bg-color:#E6E6E6;" mathbackground="#E6E6E6">2</mn></msub><annotation encoding="application/x-tex">\mathcal{X}_{2}</annotation></semantics></math>)</span></td>
<td id="A1.T2.8.1.15.2" class="ltx_td ltx_align_center ltx_border_r" style="--ltx-bg-color:#E6E6E6;"><span id="A1.T2.8.1.15.2.1" class="ltx_text" style="--ltx-bg-color:#E6E6E6;">(256, 64)</span></td>
<td id="A1.T2.8.1.15.3" class="ltx_td ltx_align_center ltx_border_r" style="--ltx-bg-color:#E6E6E6;"><span id="A1.T2.8.1.15.3.1" class="ltx_text" style="--ltx-bg-color:#E6E6E6;">30</span></td>
<td id="A1.T2.8.1.15.4" class="ltx_td ltx_align_right" style="--ltx-bg-color:#E6E6E6;"><span id="A1.T2.8.1.15.4.1" class="ltx_text ltx_font_bold" style="--ltx-bg-color:#E6E6E6;">3h 42m</span></td></tr>
<tr id="A1.T2.8.1.16" class="ltx_tr">
