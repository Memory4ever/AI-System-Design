<td id="A1.T3.4.1.8.2" class="ltx_td ltx_align_left ltx_border_r">3</td>
<th id="A1.T3.4.1.8.3" class="ltx_td ltx_align_left ltx_th ltx_th_row">KL coefficient (<math id="A1.T3.m2" class="ltx_Math" alttext="\beta" display="inline" intent=":literal"><semantics><mi>β</mi><annotation encoding="application/x-tex">\beta</annotation></semantics></math>)</th>
<td id="A1.T3.4.1.8.4" class="ltx_td ltx_align_left ltx_border_r">0.001</td>
