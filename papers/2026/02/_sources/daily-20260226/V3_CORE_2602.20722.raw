<th id="A1.T3.4.1.9.1" class="ltx_td ltx_align_center ltx_th ltx_th_row ltx_border_t" colspan="6"><span id="A1.T3.4.1.9.1.1" class="ltx_text ltx_font_bold">Off-policy Configuration</span></th></tr>
<tr id="A1.T3.4.1.10" class="ltx_tr">
<th id="A1.T3.4.1.10.1" class="ltx_td ltx_align_left ltx_th ltx_th_row ltx_border_t" style="--ltx-bg-color:#FFFFCC;"><math id="A1.T3.m3" class="ltx_Math" style="--ltx-bg-color:#FFFFCC;" alttext="c_{1}" display="inline" intent=":literal"><semantics><msub><mi style="--ltx-bg-color:#FFFFCC;" mathbackground="#FFFFCC">c</mi><mn style="--ltx-bg-color:#FFFFCC;" mathbackground="#FFFFCC">1</mn></msub><annotation encoding="application/x-tex">c_{1}</annotation></semantics></math><span id="A1.T3.4.1.10.1.1" class="ltx_text" style="--ltx-bg-color:#FFFFCC;"> threshold</span></th>
