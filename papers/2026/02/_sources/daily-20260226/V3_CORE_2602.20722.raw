<td id="A1.T2.8.1.16.2" class="ltx_td ltx_align_left ltx_border_bb ltx_border_r" style="--ltx-bg-color:#E6E6E6;"><span id="A1.T2.8.1.16.2.1" class="ltx_text ltx_font_bold" style="--ltx-bg-color:#E6E6E6;">BAPO (w/o <math id="A1.T2.m12" class="ltx_Math" alttext="\mathcal{X}_{3}" display="inline" intent=":literal"><semantics><msub><mi style="--ltx-bg-color:#E6E6E6;" class="ltx_font_mathcaligraphic" mathbackground="#E6E6E6">𝒳</mi><mn style="--ltx-bg-color:#E6E6E6;" mathbackground="#E6E6E6">3</mn></msub><annotation encoding="application/x-tex">\mathcal{X}_{3}</annotation></semantics></math>)</span></td>
<td id="A1.T2.8.1.16.3" class="ltx_td ltx_align_center ltx_border_bb ltx_border_r" style="--ltx-bg-color:#E6E6E6;"><span id="A1.T2.8.1.16.3.1" class="ltx_text" style="--ltx-bg-color:#E6E6E6;">(256, 64)</span></td>
<td id="A1.T2.8.1.16.4" class="ltx_td ltx_align_center ltx_border_bb ltx_border_r" style="--ltx-bg-color:#E6E6E6;"><span id="A1.T2.8.1.16.4.1" class="ltx_text" style="--ltx-bg-color:#E6E6E6;">30</span></td>
<td id="A1.T2.8.1.16.5" class="ltx_td ltx_align_right ltx_border_bb" style="--ltx-bg-color:#E6E6E6;"><span id="A1.T2.8.1.16.5.1" class="ltx_text" style="--ltx-bg-color:#E6E6E6;">4h 31m</span></td></tr>
