<span id="S5.T2.tab1.1.1.1.1.1.1.3.4" class="ltx_td ltx_align_center ltx_border_t" style="--ltx-bg-color:#E6E6E6;"><span id="S5.T2.tab1.1.1.1.1.1.1.3.4.1" class="ltx_text ltx_font_bold" style="--ltx-bg-color:#E6E6E6;">135.84</span></span>
