<td id="A4.T11.2.1.2" class="ltx_td ltx_align_left ltx_border_tt" style="padding:2.5pt 8.0pt;"><span id="A4.T11.2.1.2.1" class="ltx_text ltx_font_bold">Feature</span></td>
<td id="A4.T11.2.1.3" class="ltx_td ltx_align_left ltx_align_top ltx_border_tt" style="padding:2.5pt 8.0pt;">
<span id="A4.T11.2.1.3.1" class="ltx_inline-block ltx_align_top" style="width:142.3pt;">
<span id="A4.T11.2.1.3.1.1" class="ltx_p"><span id="A4.T11.2.1.3.1.1.1" class="ltx_text ltx_font_bold">Definition</span></span>
</span></td>
