<span id="S5.T2.tab1.1.1.1.1.1.1.1.4" class="ltx_td ltx_align_center ltx_border_tt"><span id="S5.T2.tab1.1.1.1.1.1.1.1.4.1" class="ltx_text ltx_font_bold">Cum. Regret</span> <math id="S5.T2.m2" class="ltx_Math" alttext="\downarrow" display="inline" intent=":literal"><semantics><mo stretchy="false">↓</mo><annotation encoding="application/x-tex">\downarrow</annotation></semantics></math></span>
<span id="S5.T2.tab1.1.1.1.1.1.1.1.5" class="ltx_td ltx_align_center ltx_border_tt"><span id="S5.T2.tab1.1.1.1.1.1.1.1.5.1" class="ltx_text ltx_font_bold">Win%</span> <math id="S5.T2.m3" class="ltx_Math" alttext="\uparrow" display="inline" intent=":literal"><semantics><mo stretchy="false">↑</mo><annotation encoding="application/x-tex">\uparrow</annotation></semantics></math></span></span>
