<span id="A2.F38.pic1.1" class="ltx_inline-block ltx_minipage ltx_align_bottom" style="width:32.75em;">
<span id="A2.F38.pic1.1.1" class="ltx_p"><span id="A2.F38.pic1.1.1.1" class="ltx_text ltx_font_bold" style="--ltx-fg-color:#000000;">Cue F-String Constructions (Train Cues)</span></span>
</span></span></span></foreignObject></g><g fill-opacity="1.0" transform="matrix(1.0 0.0 0.0 1.0 14.47 14.47)"><foreignObject style="--ltx-fo-width:37.66em;--ltx-fo-height:28.3em;--ltx-fo-depth:0em;font-size:10pt;" height="391.53" overflow="visible" transform="matrix(1 0 0 -1 0 391.53)" width="521.11"><span class="ltx_foreignobject_container"><span class="ltx_foreignobject_content">
<span id="A2.F38.pic1.2" class="ltx_inline-block ltx_minipage ltx_align_bottom" style="width:37.66em;">
<span id="A2.F38.pic1.2.1" class="ltx_p"><span id="A2.F38.pic1.2.1.1" class="ltx_text ltx_font_bold" style="--ltx-fg-color:#000000;">Purpose:<span id="A2.F38.pic1.2.1.1.1" class="ltx_text ltx_font_medium"> Exact string constructions used to make <em id="A2.F38.pic1.2.1.1.1.1" class="ltx_emph ltx_font_italic">original inputs</em> for cue-based counterfactuals (counterfactuals do not have cues).</span></span></span>
<span id="A2.F38.pic1.2.2" class="ltx_p"><span id="A2.F38.pic1.2.2.1" class="ltx_text ltx_font_typewriter ltx_font_bold" style="--ltx-fg-color:#000000;">answer_comment</span></span><code id="A2.F38.pic1.2.3" class="ltx_verbatim" style="--ltx-fg-color:#000000;"><span class="ltx_inline-block"><svg id="A2.F38.pic1.pic1" class="ltx_picture" height="27.58" overflow="visible" version="1.1" viewBox="0 0 521.06 27.58" width="521.06"><g style="--ltx-stroke-color:#000000;--ltx-fill-color:#000000;" fill="#000000" stroke="#000000" stroke-width="0.4pt" transform="translate(0,27.58) matrix(1 0 0 -1 0 0)"><g style="--ltx-fill-color:#CCCCCC;" fill="#CCCCCC" fill-opacity="1.0"><path style="stroke:none" d="M 0 4.49 L 0 23.09 C 0 25.57 2.01 27.58 4.49 27.58 L 516.57 27.58 C 519.05 27.58 521.06 25.57 521.06 23.09 L 521.06 4.49 C 521.06 2.01 519.05 0 516.57 0 L 4.49 0 C 2.01 0 0 2.01 0 4.49 Z"></path></g><g style="--ltx-fill-color:#FAFAFA;" fill="#FAFAFA" fill-opacity="1.0"><path style="stroke:none" d="M 0.55 4.49 L 0.55 23.09 C 0.55 25.26 2.32 27.03 4.49 27.03 L 516.57 27.03 C 518.74 27.03 520.5 25.26 520.5 23.09 L 520.5 4.49 C 520.5 2.32 518.74 0.55 516.57 0.55 L 4.49 0.55 C 2.32 0.55 0.55 2.32 0.55 4.49 Z"></path></g><g fill-opacity="1.0" transform="matrix(1.0 0.0 0.0 1.0 8.43 10.33)"><foreignObject style="--ltx-fo-width:36.44em;--ltx-fo-height:0.69em;--ltx-fo-depth:0.19em;font-size:10pt;" height="12.3" overflow="visible" transform="matrix(1 0 0 -1 0 9.61)" width="504.23"><span class="ltx_foreignobject_container"><span class="ltx_foreignobject_content"><span id="A2.F38.pic1.pic1.1" class="ltx_inline-logical-block ltx_minipage ltx_align_bottom" style="width:36.44em;">
<span id="A2.F38.pic1.pic1.tab1" class="ltx_float ltx_lstlisting">
<span id="A2.F38.pic1.pic1.tab1.1" class="ltx_listing ltx_lstlisting ltx_listing">
</span>
</span></span></span></span></foreignObject></g></g></svg></span><span id="A2.F38.pic1.2.3.1" class="ltx_text ltx_font_typewriter ltx_font_bold">answer_mark</span> (<span id="A2.F38.pic1.2.3.2" class="ltx_text ltx_font_typewriter">\checkmark</span> is ✓)<code id="A2.F38.pic1.2.3.3" class="ltx_verbatim"><span class="ltx_inline-block"><svg id="A2.F38.pic1.pic2" class="ltx_picture" height="27.58" overflow="visible" version="1.1" viewBox="0 0 521.06 27.58" width="521.06"><g style="--ltx-stroke-color:#000000;--ltx-fill-color:#000000;" fill="#000000" stroke="#000000" stroke-width="0.4pt" transform="translate(0,27.58) matrix(1 0 0 -1 0 0)"><g style="--ltx-fill-color:#CCCCCC;" fill="#CCCCCC" fill-opacity="1.0"><path style="stroke:none" d="M 0 4.49 L 0 23.09 C 0 25.57 2.01 27.58 4.49 27.58 L 516.57 27.58 C 519.05 27.58 521.06 25.57 521.06 23.09 L 521.06 4.49 C 521.06 2.01 519.05 0 516.57 0 L 4.49 0 C 2.01 0 0 2.01 0 4.49 Z"></path></g><g style="--ltx-fill-color:#FAFAFA;" fill="#FAFAFA" fill-opacity="1.0"><path style="stroke:none" d="M 0.55 4.49 L 0.55 23.09 C 0.55 25.26 2.32 27.03 4.49 27.03 L 516.57 27.03 C 518.74 27.03 520.5 25.26 520.5 23.09 L 520.5 4.49 C 520.5 2.32 518.74 0.55 516.57 0.55 L 4.49 0.55 C 2.32 0.55 0.55 2.32 0.55 4.49 Z"></path></g><g fill-opacity="1.0" transform="matrix(1.0 0.0 0.0 1.0 8.43 10.33)"><foreignObject style="--ltx-fo-width:36.44em;--ltx-fo-height:0.69em;--ltx-fo-depth:0.19em;font-size:10pt;" height="12.3" overflow="visible" transform="matrix(1 0 0 -1 0 9.61)" width="504.23"><span class="ltx_foreignobject_container"><span class="ltx_foreignobject_content"><span id="A2.F38.pic1.pic2.1" class="ltx_inline-logical-block ltx_minipage ltx_align_bottom" style="width:36.44em;">
<span id="A2.F38.pic1.pic2.tab1" class="ltx_float ltx_lstlisting">
<span id="A2.F38.pic1.pic2.tab1.1" class="ltx_listing ltx_lstlisting ltx_listing">
</span>
</span></span></span></span></foreignObject></g></g></svg></span><span id="A2.F38.pic1.2.3.3.1" class="ltx_text ltx_font_typewriter ltx_font_bold">answer_key<code id="A2.F38.pic1.2.3.3.1.1" class="ltx_verbatim ltx_font_serif ltx_font_medium"><span class="ltx_inline-block"><svg id="A2.F38.pic1.pic3" class="ltx_picture" height="27.58" overflow="visible" version="1.1" viewBox="0 0 521.06 27.58" width="521.06"><g style="--ltx-stroke-color:#000000;--ltx-fill-color:#000000;" fill="#000000" stroke="#000000" stroke-width="0.4pt" transform="translate(0,27.58) matrix(1 0 0 -1 0 0)"><g style="--ltx-fill-color:#CCCCCC;" fill="#CCCCCC" fill-opacity="1.0"><path style="stroke:none" d="M 0 4.49 L 0 23.09 C 0 25.57 2.01 27.58 4.49 27.58 L 516.57 27.58 C 519.05 27.58 521.06 25.57 521.06 23.09 L 521.06 4.49 C 521.06 2.01 519.05 0 516.57 0 L 4.49 0 C 2.01 0 0 2.01 0 4.49 Z"></path></g><g style="--ltx-fill-color:#FAFAFA;" fill="#FAFAFA" fill-opacity="1.0"><path style="stroke:none" d="M 0.55 4.49 L 0.55 23.09 C 0.55 25.26 2.32 27.03 4.49 27.03 L 516.57 27.03 C 518.74 27.03 520.5 25.26 520.5 23.09 L 520.5 4.49 C 520.5 2.32 518.74 0.55 516.57 0.55 L 4.49 0.55 C 2.32 0.55 0.55 2.32 0.55 4.49 Z"></path></g><g fill-opacity="1.0" transform="matrix(1.0 0.0 0.0 1.0 8.43 10.33)"><foreignObject style="--ltx-fo-width:36.44em;--ltx-fo-height:0.69em;--ltx-fo-depth:0.19em;font-size:10pt;" height="12.3" overflow="visible" transform="matrix(1 0 0 -1 0 9.61)" width="504.23"><span class="ltx_foreignobject_container"><span class="ltx_foreignobject_content"><span id="A2.F38.pic1.pic3.1" class="ltx_inline-logical-block ltx_minipage ltx_align_bottom" style="width:36.44em;">
<span id="A2.F38.pic1.pic3.tab1" class="ltx_float ltx_lstlisting">
