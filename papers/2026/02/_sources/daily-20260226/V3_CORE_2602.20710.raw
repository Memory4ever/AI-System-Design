</span></span></span></foreignObject></g><g fill-opacity="1.0" transform="matrix(1.0 0.0 0.0 1.0 12.5 12.5)"><foreignObject style="--ltx-fo-width:37.94em;--ltx-fo-height:40.03em;--ltx-fo-depth:0em;font-size:10pt;" height="553.93" overflow="visible" transform="matrix(1 0 0 -1 0 553.93)" width="524.98"><span class="ltx_foreignobject_container"><span class="ltx_foreignobject_content"><span id="A2.F22.pic1.2" class="ltx_inline-logical-block ltx_minipage ltx_align_bottom" style="width:37.94em;">
<span id="A2.F22.pic1.p1" class="ltx_para ltx_noindent"><span class="ltx_inline-block"><svg id="A2.F22.pic1.p1.pic1" class="ltx_picture" color="#000000" height="79.47" overflow="visible" version="1.1" viewBox="0 0 524.99 79.47" width="524.99"><g style="--ltx-stroke-color:#000000;--ltx-fill-color:#000000;" fill="#000000" stroke="#000000" stroke-width="0.4pt" transform="translate(0,79.47) matrix(1 0 0 -1 0 0)"><g style="--ltx-fill-color:#BFBFBF;" fill="#BFBFBF" fill-opacity="1.0"><path style="stroke:none" d="M 0 2.63 L 0 76.84 C 0 78.3 1.18 79.47 2.63 79.47 L 522.37 79.47 C 523.82 79.47 524.99 78.3 524.99 76.84 L 524.99 2.63 C 524.99 1.18 523.82 0 522.37 0 L 2.63 0 C 1.18 0 0 1.18 0 2.63 Z"></path></g><g style="--ltx-fill-color:#FAFAFA;" fill="#FAFAFA" fill-opacity="1.0"><path style="stroke:none" d="M 0.55 2.63 L 0.55 76.84 C 0.55 77.99 1.48 78.92 2.63 78.92 L 522.37 78.92 C 523.51 78.92 524.44 77.99 524.44 76.84 L 524.44 2.63 C 524.44 1.48 523.51 0.55 522.37 0.55 L 2.63 0.55 C 1.48 0.55 0.55 1.48 0.55 2.63 Z"></path></g><g fill-opacity="1.0" transform="matrix(1.0 0.0 0.0 1.0 10.03 10.03)"><foreignObject style="--ltx-fo-width:36.49em;--ltx-fo-height:4.29em;--ltx-fo-depth:0em;font-size:10pt;" height="59.42" overflow="visible" transform="matrix(1 0 0 -1 0 59.42)" width="504.92"><span class="ltx_foreignobject_container"><span class="ltx_foreignobject_content">
