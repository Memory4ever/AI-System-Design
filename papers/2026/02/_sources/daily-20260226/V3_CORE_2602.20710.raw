<figure id="A2.F37" class="ltx_figure"><span class="ltx_inline-block"><svg id="A2.F37.pic1" class="ltx_picture ltx_centering" height="354.11" overflow="visible" version="1.1" viewBox="0 0 550 354.11" width="550"><g style="--ltx-stroke-color:#000000;--ltx-fill-color:#000000;" fill="#000000" stroke="#000000" stroke-width="0.4pt" transform="translate(0,354.11) matrix(1 0 0 -1 0 0)"><g style="--ltx-fill-color:#B3B3B3;" fill="#B3B3B3" fill-opacity="1.0"><path style="stroke:none" d="M 0 8.57 L 0 345.54 C 0 350.27 3.84 354.11 8.57 354.11 L 541.43 354.11 C 546.16 354.11 550 350.27 550 345.54 L 550 8.57 C 550 3.84 546.16 0 541.43 0 L 8.57 0 C 3.84 0 0 3.84 0 8.57 Z"></path></g><g style="--ltx-fill-color:#FFFFFF;" fill="#FFFFFF" fill-opacity="1.0"><path style="stroke:none" d="M 0.69 8.57 L 0.69 331.01 L 549.31 331.01 L 549.31 8.57 C 549.31 4.22 545.78 0.69 541.43 0.69 L 8.57 0.69 C 4.22 0.69 0.69 4.22 0.69 8.57 Z"></path></g><g style="--ltx-fill-color:#D9D9D9;" fill="#D9D9D9" fill-opacity="1.0"><path style="stroke:none" d="M 0.69 331.7 L 0.69 345.54 C 0.69 349.89 4.22 353.41 8.57 353.41 L 541.43 353.41 C 545.78 353.41 549.31 349.89 549.31 345.54 L 549.31 331.7 Z"></path></g><g fill-opacity="1.0" transform="matrix(1.0 0.0 0.0 1.0 14.47 339.1)"><foreignObject style="--ltx-fo-width:32.75em;--ltx-fo-height:0.75em;--ltx-fo-depth:0.25em;font-size:10pt;" height="13.84" overflow="visible" transform="matrix(1 0 0 -1 0 10.38)" width="453.17"><span class="ltx_foreignobject_container"><span class="ltx_foreignobject_content">
