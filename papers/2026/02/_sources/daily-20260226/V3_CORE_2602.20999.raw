<td id="S3.T1.8.1.2.15" class="ltx_td ltx_align_center ltx_border_r ltx_border_t" style="padding-top:-0.25pt;padding-bottom:-0.25pt;"><span id="S3.T1.8.1.2.15.1" class="ltx_text ltx_font_bold">Avg</span></td>
<td id="S3.T1.8.1.2.16" class="ltx_td ltx_align_center ltx_border_t" style="padding-top:-0.25pt;padding-bottom:-0.25pt;"><span id="S3.T1.8.1.2.16.1" class="ltx_text ltx_font_bold">Sex</span></td>
<td id="S3.T1.8.1.2.17" class="ltx_td ltx_align_center ltx_border_t" style="padding-top:-0.25pt;padding-bottom:-0.25pt;"><span id="S3.T1.8.1.2.17.1" class="ltx_text ltx_font_bold">Vio</span></td>
<td id="S3.T1.8.1.2.18" class="ltx_td ltx_align_center ltx_border_t" style="padding-top:-0.25pt;padding-bottom:-0.25pt;"><span id="S3.T1.8.1.2.18.1" class="ltx_text ltx_font_bold">Hat</span></td>
<td id="S3.T1.8.1.2.19" class="ltx_td ltx_align_center ltx_border_r ltx_border_t" style="padding-top:-0.25pt;padding-bottom:-0.25pt;"><span id="S3.T1.8.1.2.19.1" class="ltx_text ltx_font_bold">Ill</span></td>
<td id="S3.T1.8.1.2.20" class="ltx_td ltx_align_center ltx_border_t" style="padding-top:-0.25pt;padding-bottom:-0.25pt;"><span id="S3.T1.8.1.2.20.1" class="ltx_text ltx_font_bold">Avg</span></td></tr>
