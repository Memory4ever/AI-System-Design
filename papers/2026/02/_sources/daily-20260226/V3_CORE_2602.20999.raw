<td id="S3.T1.8.1.2.13" class="ltx_td ltx_align_center ltx_border_t" style="padding-top:-0.25pt;padding-bottom:-0.25pt;"><span id="S3.T1.8.1.2.13.1" class="ltx_text ltx_font_bold">Hat</span></td>
