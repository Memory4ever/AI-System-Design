<td id="S4.T2.3.1.14.7" class="ltx_td ltx_align_center">69.12</td>
<td id="S4.T2.3.1.14.8" class="ltx_td ltx_align_center"><span id="S4.T2.3.1.14.8.1" class="ltx_text ltx_font_bold">70.77</span></td>
<td id="S4.T2.3.1.14.9" class="ltx_td ltx_align_center"><span id="S4.T2.3.1.14.9.1" class="ltx_text ltx_font_bold">64.47</span></td></tr>
<tr id="S4.T2.3.1.15" class="ltx_tr">
<th id="S4.T2.3.1.15.1" class="ltx_td ltx_align_left ltx_th ltx_th_row ltx_border_bb ltx_border_t">Human</th>
<td id="S4.T2.3.1.15.2" class="ltx_td ltx_align_center ltx_border_bb ltx_border_t">100.0</td>
<td id="S4.T2.3.1.15.3" class="ltx_td ltx_align_center ltx_border_bb ltx_border_t">99.26</td>
<td id="S4.T2.3.1.15.4" class="ltx_td ltx_align_center ltx_border_bb ltx_border_t">97.11</td>
<td id="S4.T2.3.1.15.5" class="ltx_td ltx_align_center ltx_border_bb ltx_border_t">90.44</td>
<td id="S4.T2.3.1.15.6" class="ltx_td ltx_align_center ltx_border_bb ltx_border_t">99.04</td>
<td id="S4.T2.3.1.15.7" class="ltx_td ltx_align_center ltx_border_bb ltx_border_t">94.44</td>
<td id="S4.T2.3.1.15.8" class="ltx_td ltx_align_center ltx_border_bb ltx_border_t">96.15</td>
