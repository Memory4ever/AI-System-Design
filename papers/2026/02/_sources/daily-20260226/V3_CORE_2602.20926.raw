                <span id="alg1.l18.3" class="ltx_text ltx_font_bold">for</span> each candidate <math id="alg1.l18.m1" class="ltx_Math" alttext="H^{\prime}" display="inline" intent=":literal"><semantics><msup><mi>H</mi><mo>′</mo></msup><annotation encoding="application/x-tex">H^{\prime}</annotation></semantics></math> in <math id="alg1.l18.m2" class="ltx_Math" alttext="\mathcal{C}_{cand}" display="inline" intent=":literal"><semantics><msub><mi class="ltx_font_mathcaligraphic">𝒞</mi><mrow><mi>c</mi><mo lspace="0em" rspace="0em">​</mo><mi>a</mi><mo lspace="0em" rspace="0em">​</mo><mi>n</mi><mo lspace="0em" rspace="0em">​</mo><mi>d</mi></mrow></msub><annotation encoding="application/x-tex">\mathcal{C}_{cand}</annotation></semantics></math> <span id="alg1.l18.4" class="ltx_text ltx_font_bold">do</span>



</div>
