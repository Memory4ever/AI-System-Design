<th id="A1.T3.5.1.3" class="ltx_td ltx_align_center ltx_th ltx_th_column ltx_border_tt" style="padding-top:0.9pt;padding-bottom:0.9pt;"><span id="A1.T3.5.1.3.1" class="ltx_text ltx_font_bold" style="font-size:90%;">Value</span></th></tr>
</thead>
