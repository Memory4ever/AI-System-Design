<div id="alg1.l3" class="ltx_listingline">
                <span class="ltx_tag ltx_tag_listingline"><span id="alg1.l3.1" class="ltx_text" style="font-size:80%;">3:</span></span>
                
                
               Retrieve all triples <math id="alg1.l3.m1" class="ltx_Math" alttext="\{\tau\}" display="inline" intent=":literal"><semantics><mrow><mo stretchy="false">{</mo><mi>τ</mi><mo stretchy="false">}</mo></mrow><annotation encoding="application/x-tex">\{\tau\}</annotation></semantics></math> from <math id="alg1.l3.m2" class="ltx_Math" alttext="\mathcal{G}" display="inline" intent=":literal"><semantics><mi class="ltx_font_mathcaligraphic">𝒢</mi><annotation encoding="application/x-tex">\mathcal{G}</annotation></semantics></math>

</div>
<div id="alg1.l4" class="ltx_listingline">
                <span class="ltx_tag ltx_tag_listingline"><span id="alg1.l4.1" class="ltx_text" style="font-size:80%;">4:</span></span>
                
                
               Score triples by similarity to <math id="alg1.l4.m1" class="ltx_Math" alttext="v_{q}" display="inline" intent=":literal"><semantics><msub><mi>v</mi><mi>q</mi></msub><annotation encoding="application/x-tex">v_{q}</annotation></semantics></math>

</div>
<div id="alg1.l5" class="ltx_listingline">
                <span class="ltx_tag ltx_tag_listingline"><span id="alg1.l5.1" class="ltx_text" style="font-size:80%;">5:</span></span>
                
                
               <math id="alg1.l5.m1" class="ltx_Math" alttext="H_{1}\leftarrow\text{Top-}n\text{ ranked triples}" display="inline" intent=":literal"><semantics><mrow><msub><mi>H</mi><mn>1</mn></msub><mo stretchy="false">←</mo><mrow><mtext>Top-</mtext><mo lspace="0em" rspace="0em">​</mo><mi>n</mi><mo lspace="0em" rspace="0em">​</mo><mtext> ranked triples</mtext></mrow></mrow><annotation encoding="application/x-tex">H_{1}\leftarrow\text{Top-}n\text{ ranked triples}</annotation></semantics></math>

</div>
<div id="alg1.l6" class="ltx_listingline">
