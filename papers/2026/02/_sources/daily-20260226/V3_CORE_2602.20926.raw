                <math id="alg1.l17.m1" class="ltx_Math" alttext="H_{i}\leftarrow\emptyset" display="inline" intent=":literal"><semantics><mrow><msub><mi>H</mi><mi>i</mi></msub><mo stretchy="false">←</mo><mi mathvariant="normal">∅</mi></mrow><annotation encoding="application/x-tex">H_{i}\leftarrow\emptyset</annotation></semantics></math>

