<td id="A1.T3.5.4.1" class="ltx_td ltx_align_center" style="padding-top:0.9pt;padding-bottom:0.9pt;"><math id="A1.T3.m3" class="ltx_Math" alttext="k" display="inline" intent=":literal"><semantics><mi mathsize="0.900em">k</mi><annotation encoding="application/x-tex">k</annotation></semantics></math></td>
