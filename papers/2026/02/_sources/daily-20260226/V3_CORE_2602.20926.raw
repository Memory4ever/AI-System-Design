                 <math id="alg1.l10.m1" class="ltx_Math" alttext="\mathcal{T}_{adj}\leftarrow\{\tau\in\mathcal{G}\mid\tau\text{ is adjacent to entities in }H\}" display="inline" intent=":literal"><semantics><mrow><msub><mi class="ltx_font_mathcaligraphic">𝒯</mi><mrow><mi>a</mi><mo lspace="0em" rspace="0em">​</mo><mi>d</mi><mo lspace="0em" rspace="0em">​</mo><mi>j</mi></mrow></msub><mo stretchy="false">←</mo><mrow><mo stretchy="false">{</mo><mrow><mi>τ</mi><mo>∈</mo><mi class="ltx_font_mathcaligraphic">𝒢</mi></mrow><mo fence="true" lspace="0em" rspace="0em">∣</mo><mrow><mi>τ</mi><mo lspace="0em" rspace="0em">​</mo><mtext> is adjacent to entities in </mtext><mo lspace="0em" rspace="0em">​</mo><mi>H</mi></mrow><mo stretchy="false">}</mo></mrow></mrow><annotation encoding="application/x-tex">\mathcal{T}_{adj}\leftarrow\{\tau\in\mathcal{G}\mid\tau\text{ is adjacent to entities in }H\}</annotation></semantics></math>

</div>
<div id="alg1.l11" class="ltx_listingline">
