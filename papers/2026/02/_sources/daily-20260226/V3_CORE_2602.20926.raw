                <span class="ltx_tag ltx_tag_listingline"><span id="alg1.l0a.1" class="ltx_text" style="font-size:80%;">0:</span></span>
                
                
               Final set of HyperNodes <math id="alg1.l0a.m1" class="ltx_Math" alttext="H_{final}" display="inline" intent=":literal"><semantics><msub><mi>H</mi><mrow><mi>f</mi><mo lspace="0em" rspace="0em">​</mo><mi>i</mi><mo lspace="0em" rspace="0em">​</mo><mi>n</mi><mo lspace="0em" rspace="0em">​</mo><mi>a</mi><mo lspace="0em" rspace="0em">​</mo><mi>l</mi></mrow></msub><annotation encoding="application/x-tex">H_{final}</annotation></semantics></math>

</div>
<div id="alg1.l1" class="ltx_listingline">
