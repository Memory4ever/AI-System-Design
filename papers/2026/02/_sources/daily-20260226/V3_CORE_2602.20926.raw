                 <span id="alg1.l11.3" class="ltx_text ltx_font_bold">for</span> each <math id="alg1.l11.m1" class="ltx_Math" alttext="\tau_{next}" display="inline" intent=":literal"><semantics><msub><mi>τ</mi><mrow><mi>n</mi><mo lspace="0em" rspace="0em">​</mo><mi>e</mi><mo lspace="0em" rspace="0em">​</mo><mi>x</mi><mo lspace="0em" rspace="0em">​</mo><mi>t</mi></mrow></msub><annotation encoding="application/x-tex">\tau_{next}</annotation></semantics></math> in <math id="alg1.l11.m2" class="ltx_Math" alttext="\mathcal{T}_{adj}" display="inline" intent=":literal"><semantics><msub><mi class="ltx_font_mathcaligraphic">𝒯</mi><mrow><mi>a</mi><mo lspace="0em" rspace="0em">​</mo><mi>d</mi><mo lspace="0em" rspace="0em">​</mo><mi>j</mi></mrow></msub><annotation encoding="application/x-tex">\mathcal{T}_{adj}</annotation></semantics></math> <span id="alg1.l11.4" class="ltx_text ltx_font_bold">do</span>



</div>
<div id="alg1.l12" class="ltx_listingline">
                <span class="ltx_tag ltx_tag_listingline"><span id="alg1.l12.1" class="ltx_text" style="font-size:80%;">12:</span></span>
                
                
                  <span id="alg1.l12.3" class="ltx_text ltx_font_bold">Expand:</span> <math id="alg1.l12.m1" class="ltx_Math" alttext="H^{\prime}\leftarrow H\cup\{\tau_{next}\}" display="inline" intent=":literal"><semantics><mrow><msup><mi>H</mi><mo>′</mo></msup><mo stretchy="false">←</mo><mrow><mi>H</mi><mo>∪</mo><mrow><mo stretchy="false">{</mo><msub><mi>τ</mi><mrow><mi>n</mi><mo lspace="0em" rspace="0em">​</mo><mi>e</mi><mo lspace="0em" rspace="0em">​</mo><mi>x</mi><mo lspace="0em" rspace="0em">​</mo><mi>t</mi></mrow></msub><mo stretchy="false">}</mo></mrow></mrow></mrow><annotation encoding="application/x-tex">H^{\prime}\leftarrow H\cup\{\tau_{next}\}</annotation></semantics></math>

</div>
<div id="alg1.l13" class="ltx_listingline">
                <span class="ltx_tag ltx_tag_listingline"><span id="alg1.l13.1" class="ltx_text" style="font-size:80%;">13:</span></span>
                
                
                  Add <math id="alg1.l13.m1" class="ltx_Math" alttext="H^{\prime}" display="inline" intent=":literal"><semantics><msup><mi>H</mi><mo>′</mo></msup><annotation encoding="application/x-tex">H^{\prime}</annotation></semantics></math> to <math id="alg1.l13.m2" class="ltx_Math" alttext="\mathcal{C}_{cand}" display="inline" intent=":literal"><semantics><msub><mi class="ltx_font_mathcaligraphic">𝒞</mi><mrow><mi>c</mi><mo lspace="0em" rspace="0em">​</mo><mi>a</mi><mo lspace="0em" rspace="0em">​</mo><mi>n</mi><mo lspace="0em" rspace="0em">​</mo><mi>d</mi></mrow></msub><annotation encoding="application/x-tex">\mathcal{C}_{cand}</annotation></semantics></math>

</div>
<div id="alg1.l14" class="ltx_listingline">
