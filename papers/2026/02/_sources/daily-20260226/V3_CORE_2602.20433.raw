<th id="A1.T2.3.1.1.4" class="ltx_td ltx_align_center ltx_th ltx_th_column ltx_border_t"><span id="A1.T2.3.1.1.4.1" class="ltx_text ltx_font_bold">Isotropy <math id="A1.T2.m3" class="ltx_Math" alttext="\mathcal{I}(\boldsymbol{\mathrm{W}})" display="inline" intent=":literal"><semantics><mrow><mi class="ltx_font_mathcaligraphic">ℐ</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>𝐖</mi><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">\mathcal{I}(\boldsymbol{\mathrm{W}})</annotation></semantics></math></span></th>
<th id="A1.T2.3.1.1.5" class="ltx_td ltx_align_center ltx_th ltx_th_column ltx_border_t"><span id="A1.T2.3.1.1.5.1" class="ltx_text ltx_font_bold">Effective Rank <math id="A1.T2.m4" class="ltx_Math" alttext="\mathcal{R}(\boldsymbol{\mathrm{H}})" display="inline" intent=":literal"><semantics><mrow><mi class="ltx_font_mathcaligraphic">ℛ</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>𝐇</mi><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">\mathcal{R}(\boldsymbol{\mathrm{H}})</annotation></semantics></math></span></th>
<th id="A1.T2.3.1.1.6" class="ltx_td ltx_align_center ltx_th ltx_th_column ltx_border_t"><span id="A1.T2.3.1.1.6.1" class="ltx_text ltx_font_bold">Cosine Similarity <math id="A1.T2.m5" class="ltx_Math" alttext="\mathcal{A}(\boldsymbol{\mathrm{H}})" display="inline" intent=":literal"><semantics><mrow><mi class="ltx_font_mathcaligraphic">𝒜</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>𝐇</mi><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">\mathcal{A}(\boldsymbol{\mathrm{H}})</annotation></semantics></math></span></th></tr>
