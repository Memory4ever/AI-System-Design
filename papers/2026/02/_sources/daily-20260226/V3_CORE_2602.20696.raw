<th id="S6.T7.2.1.5.1" class="ltx_td ltx_align_left ltx_th ltx_th_row" style="padding-top:1pt;padding-bottom:1pt;">PromptCD</th>
<td id="S6.T7.2.1.5.2" class="ltx_td ltx_align_center" style="padding-top:1pt;padding-bottom:1pt;">89.45 (<math id="S6.T7.m7" class="ltx_Math" alttext="\times" display="inline" intent=":literal"><semantics><mo>×</mo><annotation encoding="application/x-tex">\times</annotation></semantics></math>1.74)</td>
<td id="S6.T7.2.1.5.3" class="ltx_td ltx_align_center" style="padding-top:1pt;padding-bottom:1pt;">12.25 (<math id="S6.T7.m8" class="ltx_Math" alttext="\times" display="inline" intent=":literal"><semantics><mo>×</mo><annotation encoding="application/x-tex">\times</annotation></semantics></math>0.63)</td></tr>
<tr id="S6.T7.2.1.6" class="ltx_tr">
<th id="S6.T7.2.1.6.1" class="ltx_td ltx_align_left ltx_th ltx_th_row ltx_border_bb ltx_border_t" style="padding-top:1pt;padding-bottom:1pt;" rowspan="2"><span id="S6.T7.2.1.6.1.1" class="ltx_text ltx_font_smallcaps">LLaMA3-8B</span></th>
