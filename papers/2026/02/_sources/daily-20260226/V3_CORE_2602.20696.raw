<th id="S6.T4.2.1.1.1" class="ltx_td ltx_align_left ltx_th ltx_th_column ltx_th_row ltx_border_r ltx_border_tt"><span id="S6.T4.2.1.1.1.1" class="ltx_text ltx_font_bold">Model</span></th>
<th id="S6.T4.2.1.1.2" class="ltx_td ltx_align_left ltx_th ltx_th_column ltx_th_row ltx_border_r ltx_border_tt"><span id="S6.T4.2.1.1.2.1" class="ltx_text ltx_font_bold">Layers</span> <math id="S6.T4.m1" class="ltx_Math" alttext="\mathcal{L}" display="inline" intent=":literal"><semantics><mi class="ltx_font_mathcaligraphic">ℒ</mi><annotation encoding="application/x-tex">\mathcal{L}</annotation></semantics></math></th>
<th id="S6.T4.2.1.1.3" class="ltx_td ltx_align_center ltx_th ltx_th_column ltx_border_tt"><span id="S6.T4.2.1.1.3.1" class="ltx_text ltx_font_bold">A-OKVQA</span></th>
<th id="S6.T4.2.1.1.4" class="ltx_td ltx_align_center ltx_th ltx_th_column ltx_border_tt"><span id="S6.T4.2.1.1.4.1" class="ltx_text ltx_font_bold">POPE</span></th>
<th id="S6.T4.2.1.1.5" class="ltx_td ltx_align_center ltx_th ltx_th_column ltx_border_tt"><span id="S6.T4.2.1.1.5.1" class="ltx_text ltx_font_bold">V<sup id="S6.T4.2.1.1.5.1.1" class="ltx_sup">∗</sup></span></th>
<th id="S6.T4.2.1.1.6" class="ltx_td ltx_align_center ltx_th ltx_th_column ltx_border_tt"><span id="S6.T4.2.1.1.6.1" class="ltx_text ltx_font_bold">TextVQA</span></th></tr>
</thead>
<tbody class="ltx_tbody">
<tr id="S6.T4.2.1.2" class="ltx_tr">
