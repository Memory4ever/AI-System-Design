o","familyName":"Magrini","name":"Magrini, Fabrizio","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Auggie","familyName":"Marignier","name":"Marignier, Auggie","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Carl","familyName":"Martin","name":"Martin, Carl","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Martin","familyName":"Möllhoff","name":"Möllhoff, Martin","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Iain","familyName":"Neill","name":"Neill, Iain","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Andy","familyName":"Nowacki","name":"Nowacki, Andy","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Bob","familyName":"Paap","name":"Paap, Bob","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Simone","familyName":"Pilia","name":"Pilia, Simone","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Sjoerd","familyName":"de Ridder","name":"de Ridder, Sjoerd","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Elmer","familyName":"Ruigrok","name":"Ruigrok, Elmer","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Peidong","familyName":"Shi","name":"Shi, Peidong","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Anna","familyName":"Stork","name":"Stork, Anna","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Alice","familyName":"Turner","name":"Turner, Alice","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Jim","familyName":"Whiteley","name":"Whiteley, Jim","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Anton","familyName":"Ziolkowski","name":"Ziolkowski, Anton","affiliation":[],"nameIdentifiers":[]}],"titles":[{"title":"The UK and Ireland Geophysical Array -- Concept and Design"}],"publisher":"arXiv","container":{},"publicationYear":2026,"subjects":[{"subject":"Geophysics (physics.geo-ph)","lang":"en","subjectScheme":"arXiv"},{"subject":"FOS: Physical sciences","subjectScheme":"Fields of Science and Technology (FOS)"},{"schemeUri":"http://www.oecd.org/science/inno/38235147.pdf","subject":"FOS: Physical sciences","subjectScheme":"Fields of Science and Technology (FOS)"}],"contributors":[],"dates":[{"date":"2026-02-24T15:05:41Z","dateType":"Submitted","dateInformation":"v1"},{"date":"2026-02-25T01:54:03Z","dateType":"Updated","dateInformation":"v1"},{"date":"2026-02","dateType":"Available","dateInformation":"v1"},{"date":"2026","dateType":"Issued"}],"language":null,"types":{"schemaOrg":"CreativeWork","resourceTypeGeneral":"Preprint","citeproc":"article","bibtex":"misc","ris":"GEN","resourceType":"Article"},"relatedIdentifiers":[],"relatedItems":[],"sizes":[],"formats":[],"version":"1","rightsList":[{"rightsIdentifierScheme":"SPDX","rightsUri":"https://creativecommons.org/licenses/by/4.0/legalcode","schemeUri":"https://spdx.org/licenses/","rights":"Creative Commons Attribution 4.0 International","rightsIdentifier":"cc-by-4.0"}],"descriptions":[{"descriptionType":"Abstract","description":"Scientific exploration of the UK and Ireland's subsurface has made important contributions to scholarship and prosperity for people and the planet, including economic growth, sustainable use of natural resources, storage of greenhouse gases, and inspiring curiosity about the Earth beneath our feet. This article outlines a vision for an array of seismological instruments spanning the UK and Ireland, UKI Array, augmented by other types of geophysical sensors, to maximise the value offered by existing equipment pools. The mission is to research natural phenomena and structure in the deep and shallow Earth, to solve problems concerning hazards and resources, to connect scientists to schools and the broader public, and thus to inspire a new generation to learn about geophysics. The vision was created through a community driven process of engagement and participation. This paper describes the concept and design of the UKI-Array; a companion paper discusses related opportunities and potential applications."}],"geoLocations":[],"fundingReferences":[],"url":"https://arxiv.org/abs/2602.20984","contentUrl":null,"metadataVersion":0,"schemaVersion":"http://datacite.org/schema/kernel-4","source":"mds","isActive":true,"state":"findable","reason":null,"viewCount":0,"downloadCount":0,"referenceCount":0,"citationCount":0,"partCount":0,"partOfCount":0,"versionCount":0,"versionOfCount":0,"created":"2026-02-25T15:33:58Z","registered":"2026-02-25T15:33:59Z","published":null,"updated":"2026-02-25T15:33:59Z"},"relationships":{"client":{"data":{"id":"arxiv.content","type":"clients"}}}},{"id":"10.48550/arxiv.2602.20983","type":"dois","attributes":{"doi":"10.48550/arxiv.2602.20983","identifiers":[{"identifier":"2602.20983","identifierType":"arXiv"}],"creators":[{"nameType":"Personal","givenName":"Thien Duc","familyName":"Hua","name":"Hua, Thien Duc","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Mohammadali","familyName":"Mohammadi","name":"Mohammadi, Mohammadali","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Hien Quoc","familyName":"Ngo","name":"Ngo, Hien Quoc","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Michail","familyName":"Matthaiou","name":"Matthaiou, Michail","affiliation":[],"nameIdentifiers":[]}],"titles":[{"title":"Cell-Free Massive MIMO-Assisted SWIPT Using Stacked Intelligent Metasurfaces"}],"publisher":"arXiv","container":{},"publicationYear":2026,"subjects":[{"subject":"Signal Processing (eess.SP)","lang":"en","subjectScheme":"arXiv"},{"subject":"Information Theory (cs.IT)","lang":"en","subjectScheme":"arXiv"},{"subject":"FOS: Electrical engineering, electronic engineering, information engineering","subjectScheme":"Fields of Science and Technology (FOS)"},{"schemeUri":"http://www.oecd.org/science/inno/38235147.pdf","subject":"FOS: Electrical engineering, electronic engineering, information engineering","subjectScheme":"Fields of Science and Technology (FOS)"},{"subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"},{"schemeUri":"http://www.oecd.org/science/inno/38235147.pdf","subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"}],"contributors":[],"dates":[{"date":"2026-02-24T15:03:18Z","dateType":"Submitted","dateInformation":"v1"},{"date":"2026-02-25T01:53:57Z","dateType":"Updated","dateInformation":"v1"},{"date":"2026-02","dateType":"Available","dateInformation":"v1"},{"date":"2026","dateType":"Issued"}],"language":null,"types":{"schemaOrg":"CreativeWork","resourceTypeGeneral":"Preprint","citeproc":"article","bibtex":"misc","ris":"GEN","resourceType":"Article"},"relatedIdentifiers":[],"relatedItems":[],"sizes":[],"formats":[],"version":"1","rightsList":[{"rightsIdentifierScheme":"SPDX","rightsUri":"https://creativecommons.org/licenses/by/4.0/legalcode","schemeUri":"https://spdx.org/licenses/","rights":"Creative Commons Attribution 4.0 International","rightsIdentifier":"cc-by-4.0"}],"descriptions":[{"descriptionType":"Abstract","description":"This study explores a next-generation multiple access (NGMA) framework for cell-free massive MIMO (CF-mMIMO) systems enhanced by stacked intelligent metasurfaces (SIMs), aiming to improve simultaneous wireless information and power transfer (SWIPT) performance. A fundamental challenge lies in optimally selecting the operating modes of access points (APs) to jointly maximize the received energy and satisfy spectral efficiency (SE) quality-of-service constraints. Practical system impairments, including a non-linear harvested energy model, pilot contamination (PC), channel estimation errors, and reliance on long-term statistical channel state information (CSI), are considered. We derive closed-form expressions for both the achievable SE and the average sum harvested energy (sum-HE). A mixed-integer non-convex optimization problem is formulated to jointly optimize the SIM phase shifts, APs mode selection, and power allocation to maximize average sum-HE under SE and average harvested energy constraints. To solve this problem, we propose a centralized training, decentralized execution (CTDE) framework based on deep reinforcement learning (DRL), which efficiently handles high-dimensional decision spaces. A Markovian environment and a normalized joint reward function are introduced to enhance the training stability across on-policy and off-policy DRL algorithms. Additionally, we provide a two-phase convex-based solution as a theoretical robust performance. Numerical results demonstrate that the proposed DRL-based CTDE framework achieves SWIPT performance comparable to convexification-based solution, while significantly outperforming baselines."},{"descriptionType":"Other","description":"Accepted in IEEE TWC, Feb. 2026"}],"geoLocations":[],"fundingReferences":[],"url":"https://arxiv.org/abs/2602.20983","contentUrl":null,"metadataVersion":0,"schemaVersion":"http://datacite.org/schema/kernel-4","source":"mds","isActive":true,"state":"findable","reason":null,"viewCount":0,"downloadCount":0,"referenceCount":0,"citationCount":0,"partCount":0,"partOfCount":0,"versionCount":0,"versionOfCount":0,"created":"2026-02-25T15:33:56Z","registered":"2026-02-25T15:33:57Z","published":null,"updated":"2026-02-25T15:33:57Z"},"relationships":{"client":{"data":{"id":"arxiv.content","type":"clients"}}}},{"id":"10.48550/arxiv.2602.20982","type":"dois","attributes":{"doi":"10.48550/arxiv.2602.20982","identifiers":[{"identifier":"2602.20982","identifierType":"arXiv"}],"creators":[{"nameType":"Personal","givenName":"Aleksander Bach","familyName":"Lorentzen","name":"Lorentzen, Aleksander Bach","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Alexander","familyName":"Croy","name":"Croy, Alexander","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Antti-Pekka","familyName":"Jauho","name":"Jauho, Antti-Pekka","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Mads","familyName":"Brandbyge","name":"Brandbyge, Mads","affiliation":[],"nameIdentifiers":[]}],"titles":[{"title":"Zandpack: A General Tool for Time-dependent Transport Simulation of Nanoelectronics"}],"publisher":"arXiv","container":{},"publicationYear":2026,"subjects":[{"subject":"Mesoscale and Nanoscale Physics (cond-mat.mes-hall)","lang":"en","subjectScheme":"arXiv"},{"subject":"FOS: Physical sciences","subjectScheme":"Fields of Science and Technology (FOS)"},{"schemeUri":"http://www.oecd.org/science/inno/38235147.pdf","subject":"FOS: Physical sciences","subjectScheme":"Fields of Science and Technology (FOS)"}],"contributors":[],"dates":[{"date":"2026-02-24T15:02:17Z","dateType":"Submitted","dateInformation":"v1"},{"date":"2026-02-25T01:53:51Z","dateType":"Updated","dateInformation":"v1"},{"date":"2026-02","dateType":"Available","dateInformation":"v1"},{"date":"2026","dateType":"Issued"}],"language":null,"types":{"schemaOrg":"CreativeWork","resourceTypeGeneral":"Preprint","citeproc":"article","bibtex":"misc","ris":"GEN","resourceType":"Article"},"relatedIdentifiers":[{"relationType":"IsVersionOf","relatedIdentifier":"10.1016/j.cpc.2026.110087","relatedIdentifierType":"DOI"}],"relatedItems":[],"sizes":[],"formats":[],"version":"1","rightsList":[{"rightsIdentifierScheme":"SPDX","rightsUri":"https://creativecommons.org/licenses/by/4.0/legalcode","schemeUri":"https://spdx.org/licenses/","rights":"Creative Commons Attribution 4.0 International","rightsIdentifier":"cc-by-4.0"}],"descriptions":[{"descriptionType":"Abstract","description":"The auxiliary mode approach to time-dependent open quantum system calculations is implemented and refined to yield a feasible computational approach to simulate nanostructures far from equilibrium. It is done by a careful diagonalization of the electrode level-width function, and provides an efficient approach which can simulate large, open systems at the level of time-dependent density functional theory. The approach, as given in this work, is implemented in the new open-source code Zandpack. The framework is applied to three systems perturbed by the same THz electromagnetic field pulse-form: 1) A Hubbard model for hydrogen on graphene is used to calculate spin-currents, mutual information, spin-transitions, and a pump-probe setup. 2) An armchair graphene nanoribbon (AGNR) probed by a metal tip showing electrons excited from the valence band of the AGNR into the tip via electron-electron interactions. 3) A gold break-junction is modeled with various gap distances, and displays behavior that is more different from the adiabatic case as the gap widens. In the examples 2 and 3, we develop and use a general linearization scheme for time-dependent open system calculations, which utilizes the DFTB+ or SIESTA codes."}],"geoLocations":[],"fundingReferences":[],"url":"https://arxiv.org/abs/2602.20982","contentUrl":null,"metadataVersion":0,"schemaVersion":"http://datacite.org/schema/kernel-4","source":"mds","isActive":true,"state":"findable","reason":null,"viewCount":0,"downloadCount":0,"referenceCount":0,"citationCount":0,"partCount":0,"partOfCount":0,"versionCount":0,"versionOfCount":1,"created":"2026-02-25T15:33:54Z","registered":"2026-02-25T15:33:54Z","published":null,"updated":"2026-02-25T15:33:54Z"},"relationships":{"client":{"data":{"id":"arxiv.content","type":"clients"}}}},{"id":"10.48550/arxiv.2602.20979","type":"dois","attributes":{"doi":"10.48550/arxiv.2602.20979","identifiers":[{"identifier":"2602.20979","identifierType":"arXiv"}],"creators":[{"nameType":"Personal","givenName":"Mark","familyName":"Marron","name":"Marron, Mark","affiliation":[],"nameIdentifiers":[]}],"titles":[{"title":"Toward an Agentic Infused Software Ecosystem"}],"publisher":"arXiv","container":{},"publicationYear":2026,"subjects":[{"subject":"Software Engineering (cs.SE)","lang":"en","subjectScheme":"arXiv"},{"subject":"Artificial Intelligence (cs.AI)","lang":"en","subjectScheme":"arXiv"},{"subject":"Programming Languages (cs.PL)","lang":"en","subjectScheme":"arXiv"},{"subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"},{"schemeUri":"http://www.oecd.org/science/inno/38235147.pdf","subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"}],"contributors":[],"dates":[{"date":"2026-02-24T15:01:29Z","dateType":"Submitted","dateInformation":"v1"},{"date":"2026-02-25T01:53:45Z","dateType":"Updated","dateInformation":"v1"},{"date":"2026-02","dateType":"Available","dateInformation":"v1"},{"date":"2026","dateType":"Issued"}],"language":null,"types":{"schemaOrg":"CreativeWork","resourceTypeGeneral":"Preprint","citeproc":"article","bibtex":"misc","ris":"GEN","resourceType":"Article"},"relatedIdentifiers":[],"relatedItems":[],"sizes":[],"formats":[],"version":"1","rightsList":[{"rightsIdentifierScheme":"SPDX","rightsUri":"https://creativecommons.org/licenses/by/4.0/legalcode","schemeUri":"https://spdx.org/licenses/","rights":"Creative Commons Attribution 4.0 International","rightsIdentifier":"cc-by-4.0"}],"descriptions":[{"descriptionType":"Abstract","description":"Fully leveraging the capabilities of AI agents in software development requires a rethinking of the software ecosystem itself. To this end, this paper outlines the creation of an Agentic Infused Software Ecosystem (AISE), that rests on three pillars. The first, of course, is the AI agents themselves, which in the past 5 years have moved from simple code completion and toward sophisticated independent development tasks, a trend which will only continue. The second pillar is the programming language and APIs (or tools) that these agents use to accomplish tasks, and increasingly, serve as the communication substrate that humans and AI agents interact and collaborate through. The final pillar is the runtime environment and ecosystem that agents operate within, and which provide the capabilities that programmatic agents use to interface with (and effect actions in) the external world. To realize the vision of AISE, all three pillars must be advanced in a holistic manner, and critically, in a manner that is synergistic for AI agents as they exist today, those that will exist in the future, and for the human developers that work alongside them."}],"geoLocations":[],"fundingReferences":[],"url":"https://arxiv.org/abs/2602.20979","contentUrl":null,"metadataVersion":0,"schemaVersion":"http://datacite.org/schema/kernel-4","source":"mds","isActive":true,"state":"findable","reason":null,"viewCount":0,"downloadCount":0,"referenceCount":0,"citationCount":0,"partCount":0,"partOfCount":0,"versionCount":0,"versionOfCount":0,"created":"2026-02-25T15:33:46Z","registered":"2026-02-25T15:33:47Z","published":null,"updated":"2026-02-25T15:33:47Z"},"relationships":{"client":{"data":{"id":"arxiv.content","type":"clients"}}}},{"id":"10.48550/arxiv.2602.20978","type":"dois","attributes":{"doi":"10.48550/arxiv.2602.20978","identifiers":[{"identifier":"2602.20978","identifierType":"arXiv"}],"creators":[{"nameType":"Personal","givenName":"Eleonora","familyName":"Pargoletti","name":"Pargoletti, Eleonora","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Umme H.","familyName":"Hossain","name":"Hossain, Umme H.","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Iolanda","familyName":"Di Bernardo","name":"Di Bernardo, Iolanda","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Hongjun","familyName":"Chen","name":"Chen, Hongjun","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Thanh","familyName":"Tran-Phu","name":"Tran-Phu, Thanh","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Gian Luca","familyName":"Chiarello","name":"Chiarello, Gian Luca","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Josh","familyName":"Lipton-Duffin","name":"Lipton-Duffin, Josh","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Antonio","familyName":"Tricoli","name":"Tricoli, Antonio","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Giuseppe","familyName":"Cappelletti","name":"Cappelletti, Giuseppe","affiliation":[],"nameIdentifiers":[]}],"titles":[{"title":"Engineering of SnO2-Graphene Oxide Nano-Heterojunctions for Selective Room-temperature Chemical Sensing and Optoelectronic Devices"}],"publisher":"arXiv","container":{},"publicationYear":2026,"subjects":[{"subject":"Materials Science (cond-mat.mtrl-sci)","lang":"en","subjectScheme":"arXiv"},{"subject":"FOS: Physical sciences","subjectScheme":"Fields of Science and Technology (FOS)"},{"schemeUri":"http://www.oecd.org/science/inno/38235147.pdf","subject":"FOS: Physical sciences","subjectScheme":"Fields of Science and Technology (FOS)"}],"contributors":[],"dates":[{"date":"2026-02-24T15:01:07Z","dateType":"Submitted","dateInformation":"v1"},{"date":"2026-02-25T01:53:44Z","dateType":"Updated","dateInformation":"v1"},{"date":"2026-02","dateType":"Available","dateInformation":"v1"},{"date":"2026","dateType":"Issued"}],"language":null,"types":{"schemaOrg":"CreativeWork","resourceTypeGeneral":"Preprint","citeproc":"article","bibtex":"misc","ris":"GEN","resourceType":"Article"},"relatedIdentifiers":[{"relationType":"IsVersionOf","relatedIdentifier":"10.1021/acsami.0c09178","relatedIdentifierType":"DOI"}],"relatedItems":[],"sizes":[],"formats":[],"version":"1","rightsList":[{"rightsIdentifierScheme":"SPDX","rightsUri":"https://creativecommons.org/licenses/by/4.0/legalcode","schemeUri":"https://spdx.org/licenses/","rights":"Creative Commons Attribution 4.0 International","rightsIdentifier":"cc-by-4.0"}],"descriptions":[{"descriptionType":"Abstract","description":"The development of high-performing sensing materials, able to detect ppb-trace concentrations of volatile organic compounds at low temperatures, is required for the development of next-generation miniaturized wireless sensors. Here, we present the engineering of selective room-temperature chemical sensors, comprising highly porous tin dioxide (SnO2) - graphene oxide (GO) nano-heterojunction layouts. The optoelectronic and chemical properties of these highly porous (above 90%) p-n heterojunctions were systematically investigated in terms of composition and morphologies. Optimized SnO2-GO layouts demonstrate significant potential as both visible-blind photodetectors and as selective room-temperature chemical sensors. Notably, a low GO content results in an excellent UV light responsivity (400A x W-1), with short rise and decay times, and room-temperature high chemical sensitivity with selective detection of volatile organic compounds such as ethanol down to 100~ppb. In contrast, a high concentration of GO drastically decreases the room-temperature response to ethanol and results in good selectivity to ethylbenzene. The feasibility of tuning the chemical selectivity of the sensor response by engineering the relative amount of GO and SnO2 is a promising feature that may guide the future development of miniaturized solid-state gas sensors. Furthermore, the excellent optoelectronic properties of these SnO2-GO nano-heterojunctions may find applications in various other areas such as optoelectronic devices and (photo)electrocatalysis."}],"geoLocations":[],"fundingReferences":[],"url":"https://arxiv.org/abs/2602.20978","contentUrl":null,"metadataVersion":0,"schemaVersion":"http://datacite.org/schema/kernel-4","source":"mds","isActive":true,"state":"findable","reason":null,"viewCount":0,"downloadCount":0,"referenceCount":0,"citationCount":0,"partCount":0,"partOfCount":0,"versionCount":0,"versionOfCount":1,"created":"2026-02-25T15:33:44Z","registered":"2026-02-25T15:33:44Z","published":null,"updated":"2026-02-25T15:33:44Z"},"relationships":{"client":{"data":{"id":"arxiv.content","type":"clients"}}}},{"id":"10.48550/arxiv.2602.20977","type":"dois","attributes":{"doi":"10.48550/arxiv.2602.20977","identifiers":[{"identifier":"2602.20977","identifierType":"arXiv"}],"creators":[{"nameType":"Personal","givenName":"Sara C.","familyName":"Debón","name":"Debón, Sara C.","affiliation":[],"nameIdentifiers":[]}],"titles":[{"title":"A generalization of a result of Hegedüs"}],"publisher":"arXiv","container":{},"publicationYear":2026,"subjects":[{"subject":"Group Theory (math.GR)","lang":"en","subjectScheme":"arXiv"},{"subject":"Representation Theory (math.RT)","lang":"en","subjectScheme":"arXiv"},{"subject":"FOS: Mathematics","subjectScheme":"Fields of Science and Technology (FOS)"},{"schemeUri":"http://www.oecd.org/science/inno/38235147.pdf","subject":"FOS: Mathematics","subjectScheme":"Fields of Science and Technology (FOS)"}],"contributors":[],"dates":[{"date":"2026-02-24T15:00:29Z","dateType":"Submitted","dateInformation":"v1"},{"date":"2026-02-25T01:53:39Z","dateType":"Updated","dateInformation":"v1"},{"date":"2026-02","dateType":"Available","dateInformation":"v1"},{"date":"2026","dateType":"Issued"}],"language":null,"types":{"schemaOrg":"CreativeWork","resourceTypeGeneral":"Preprint","citeproc":"article","bibtex":"misc","ris":"GEN","resourceType":"Article"},"relatedIdentifiers":[],"relatedItems":[],"sizes":[],"formats":[],"version":"1","rightsList":[{"rightsUri":"http://arxiv.org/licenses/nonexclusive-distrib/1.0/","rights":"arXiv.org perpetual, non-exclusive license"}],"descriptions":[{"descriptionType":"Abstract","description":"A famous result of P. Hegedüs describes the structure of finite rational $\\{2,5\\}$-groups. In this paper, we show how Hegedüs' proof can be used to obtain a similar result for the more general situation of a finite rational $2$-group acting faithfully and with the eigenvector property on a f.d $\\mathbb{F}_p$-vector space with $p\\geq 5$."}],"geoLocations":[],"fundingReferences":[],"url":"https://arxiv.org/abs/2602.20977","contentUrl":null,"metadataVersion":0,"schemaVersion":"http://datacite.org/schema/kernel-4","source":"mds","isActive":true,"state":"findable","reason":null,"viewCount":0,"downloadCount":0,"referenceCount":0,"citationCount":0,"partCount":0,"partOfCount":0,"versionCount":0,"versionOfCount":0,"created":"2026-02-25T15:33:41Z","registered":"2026-02-25T15:33:42Z","published":null,"updated":"2026-02-25T15:33:42Z"},"relationships":{"client":{"data":{"id":"arxiv.content","type":"clients"}}}},{"id":"10.48550/arxiv.2602.20976","type":"dois","attributes":{"doi":"10.48550/arxiv.2602.20976","identifiers":[{"identifier":"2602.20976","identifierType":"arXiv"}],"creators":[{"nameType":"Personal","givenName":"Xuan","familyName":"Luo","name":"Luo, Xuan","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Yubin","familyName":"Chen","name":"Chen, Yubin","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Zhiyu","familyName":"Hou","name":"Hou, Zhiyu","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Linpu","familyName":"Yu","name":"Yu, Linpu","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Geng","familyName":"Tu","name":"Tu, Geng","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Jing","familyName":"Li","name":"Li, Jing","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Ruifeng","familyName":"Xu","name":"Xu, Ruifeng","affiliation":[],"nameIdentifiers":[]}],"titles":[{"title":"Evaluating Proactive Risk Awareness of Large Language Models"}],"publisher":"arXiv","container":{},"publicationYear":2026,"subjects":[{"subject":"Computation and Language (cs.CL)","lang":"en","subjectScheme":"arXiv"},{"subject":"Computers and Society (cs.CY)","lang":"en","subjectScheme":"arXiv"},{"subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"},{"schemeUri":"http://www.oecd.org/science/inno/38235147.pdf","subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"}],"contributors":[],"dates":[{"date":"2026-02-24T15:00:00Z","dateType":"Submitted","dateInformation":"v1"},{"date":"2026-02-25T01:53:32Z","dateType":"Updated","dateInformation":"v1"},{"date":"2026-02","dateType":"Available","dateInformation":"v1"},{"date":"2026","dateType":"Issued"}],"language":null,"types":{"schemaOrg":"CreativeWork","resourceTypeGeneral":"Preprint","citeproc":"article","bibtex":"misc","ris":"GEN","resourceType":"Article"},"relatedIdentifiers":[],"relatedItems":[],"sizes":[],"formats":[],"version":"1","rightsList":[{"rightsIdentifierScheme":"SPDX","rightsUri":"https://creativecommons.org/licenses/by-nc-sa/4.0/legalcode","schemeUri":"https://spdx.org/licenses/","rights":"Creative Commons Attribution Non Commercial Share Alike 4.0 International","rightsIdentifier":"cc-by-nc-sa-4.0"}],"descriptions":[{"descriptionType":"Abstract","description":"As large language models (LLMs) are increasingly embedded in everyday decision-making, their safety responsibilities extend beyond reacting to explicit harmful intent toward anticipating unintended but consequential risks. In this work, we introduce a proactive risk awareness evaluation framework that measures whether LLMs can anticipate potential harms and provide warnings before damage occurs. We construct the Butterfly dataset to instantiate this framework in the environmental and ecological domain. It contains 1,094 queries that simulate ordinary solution-seeking activities whose responses may induce latent ecological impact. Through experiments across five widely used LLMs, we analyze the effects of response length, languages, and modality. Experimental results reveal consistent, significant declines in proactive awareness under length-restricted responses, cross-lingual similarities, and persistent blind spots in (multimodal) species protection. These findings highlight a critical gap between current safety alignment and the requirements of real-world ecological responsibility, underscoring the need for proactive safeguards in LLM deployment."}],"geoLocations":[],"fundingReferences":[],"url":"https://arxiv.org/abs/2602.20976","contentUrl":null,"metadataVersion":0,"schemaVersion":"http://datacite.org/schema/kernel-4","source":"mds","isActive":true,"state":"findable","reason":null,"viewCount":0,"downloadCount":0,"referenceCount":0,"citationCount":0,"partCount":0,"partOfCount":0,"versionCount":0,"versionOfCount":0,"created":"2026-02-25T15:33:39Z","registered":"2026-02-25T15:33:40Z","published":null,"updated":"2026-02-25T15:33:40Z"},"relationships":{"client":{"data":{"id":"arxiv.content","type":"clients"}}}},{"id":"10.48550/arxiv.2602.20973","type":"dois","attributes":{"doi":"10.48550/arxiv.2602.20973","identifiers":[{"identifier":"2602.20973","identifierType":"arXiv"}],"creators":[{"nameType":"Personal","givenName":"Yuliang","familyName":"Ji","name":"Ji, Yuliang","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Fuchen","familyName":"Shen","name":"Shen, Fuchen","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Jian","familyName":"Wu","name":"Wu, Jian","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Qiujie","familyName":"Xie","name":"Xie, Qiujie","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Yue","familyName":"Zhang","name":"Zhang, Yue","affiliation":[],"nameIdentifiers":[]}],"titles":[{"title":"Linear Reasoning vs. Proof by Cases: Obstacles for Large Language Models in FOL Problem Solving"}],"publisher":"arXiv","container":{},"publicationYear":2026,"subjects":[{"subject":"Computation and Language (cs.CL)","lang":"en","subjectScheme":"arXiv"},{"subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"},{"schemeUri":"http://www.oecd.org/science/inno/38235147.pdf","subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"}],"contributors":[],"dates":[{"date":"2026-02-24T14:53:34Z","dateType":"Submitted","dateInformation":"v1"},{"date":"2026-02-25T01:53:00Z","dateType":"Updated","dateInformation":"v1"},{"date":"2026-02","dateType":"Available","dateInformation":"v1"},{"date":"2026","dateType":"Issued"}],"language":null,"types":{"schemaOrg":"CreativeWork","resourceTypeGeneral":"Preprint","citeproc":"article","bibtex":"misc","ris":"GEN","resourceType":"Article"},"relatedIdentifiers":[],"relatedItems":[],"sizes":[],"formats":[],"version":"1","rightsList":[{"rightsIdentifierScheme":"SPDX","rightsUri":"https://creativecommons.org/licenses/by-nc-sa/4.0/legalcode","schemeUri":"https://spdx.org/licenses/","rights":"Creative Commons Attribution Non Commercial Share Alike 4.0 International","rightsIdentifier":"cc-by-nc-sa-4.0"}],"descriptions":[{"descriptionType":"Abstract","description":"To comprehensively evaluate the mathematical reasoning capabilities of Large Language Models (LLMs), researchers have introduced abundant mathematical reasoning datasets. However, most existing datasets primarily focus on linear reasoning, neglecting other parts such as proof by contradiction and proof by cases, which are crucial for investigating LLMs' reasoning abilities. To address this limitation, we first introduce a novel first-order logic (FOL) dataset named PC-FOL, annotated by professional mathematicians, focusing on case-based reasoning problems. All instances in this dataset are equipped with a manually written natural language proof, clearly distinguishing it from conventional linear reasoning datasets. Our experimental results over leading LLMs demonstrate a substantial performance gap between linear reasoning and case-based reasoning problems. To further investigate this phenomenon, we provide a theoretical analysis grounded in graphical model, which provides an explanation for the observed disparity between the two types of reasoning problems. We hope this work can reveal the core challenges in the field of automated natural language mathematical proof generation, paving the way for future research."}],"geoLocations":[],"fundingReferences":[],"url":"https://arxiv.org/abs/2602.20973","contentUrl":null,"metadataVersion":0,"schemaVersion":"http://datacite.org/schema/kernel-4","source":"mds","isActive":true,"state":"findable","reason":null,"viewCount":0,"downloadCount":0,"referenceCount":0,"citationCount":0,"partCount":0,"partOfCount":0,"versionCount":0,"versionOfCount":0,"created":"2026-02-25T15:33:31Z","registered":"2026-02-25T15:33:32Z","published":null,"updated":"2026-02-25T15:33:32Z"},"relationships":{"client":{"data":{"id":"arxiv.content","type":"clients"}}}},{"id":"10.48550/arxiv.2602.20972","type":"dois","attributes":{"doi":"10.48550/arxiv.2602.20972","identifiers":[{"identifier":"2602.20972","identifierType":"arXiv"}],"creators":[{"nameType":"Personal","givenName":"Ming-Kun","familyName":"Xie","name":"Xie, Ming-Kun","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Jia-Hao","familyName":"Xiao","name":"Xiao, Jia-Hao","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Zhiqiang","familyName":"Kou","name":"Kou, Zhiqiang","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Zhongnian","familyName":"Li","name":"Li, Zhongnian","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Gang","familyName":"Niu","name":"Niu, Gang","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Masashi","familyName":"Sugiyama","name":"Sugiyama, Masashi","affiliation":[],"nameIdentifiers":[]}],"titles":[{"title":"Are Multimodal Large Language Models Good Annotators for Image Tagging?"}],"publisher":"arXiv","container":{},"publicationYear":2026,"subjects":[{"subject":"Computer Vision and Pattern Recognition (cs.CV)","lang":"en","subjectScheme":"arXiv"},{"subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"},{"schemeUri":"http://www.oecd.org/science/inno/38235147.pdf","subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"}],"contributors":[],"dates":[{"date":"2026-02-24T14:53:16Z","dateType":"Submitted","dateInformation":"v1"},{"date":"2026-02-25T01:52:55Z","dateType":"Updated","dateInformation":"v1"},{"date":"2026-02","dateType":"Available","dateInformation":"v1"},{"date":"2026","dateType":"Issued"}],"language":null,"types":{"schemaOrg":"CreativeWork","resourceTypeGeneral":"Preprint","citeproc":"article","bibtex":"misc","ris":"GEN","resourceType":"Article"},"relatedIdentifiers":[],"relatedItems":[],"sizes":[],"formats":[],"version":"1","rightsList":[{"rightsUri":"http://arxiv.org/licenses/nonexclusive-distrib/1.0/","rights":"arXiv.org perpetual, non-exclusive license"}],"descriptions":[{"descriptionType":"Abstract","description":"Image tagging, a fundamental vision task, traditionally relies on human-annotated datasets to train multi-label classifiers, which incurs significant labor and costs. While Multimodal Large Language Models (MLLMs) offer promising potential to automate annotation, their capability to replace human annotators remains underexplored. This paper aims to analyze the gap between MLLM-generated and human annotations and to propose an effective solution that enables MLLM-based annotation to replace manual labeling. Our analysis of MLLM annotations reveals that, under a conservative estimate, MLLMs can reduce annotation cost to as low as one-thousandth of the human cost, mainly accounting for GPU usage, which is nearly negligible compared to manual efforts. Their annotation quality reaches about 50\\% to 80\\% of human performance, while achieving over 90\\% performance on downstream training tasks.Motivated by these findings, we propose TagLLM, a novel framework for image tagging, which aims to narrow the gap between MLLM-generated and human annotations. TagLLM comprises two components: Candidates generation, which employs structured group-wise prompting to efficiently produce a compact candidate set that covers as many true labels as possible while reducing subsequent annotation workload; and label disambiguation, which interactively calibrates the semantic concept of categories in the prompts and effectively refines the candidate labels. Extensive experiments show that TagLLM substantially narrows the gap between MLLM-generated and human annotations, especially in downstream training performance, where it closes about 60\\% to 80\\% of the difference."}],"geoLocations":[],"fundingReferences":[],"url":"https://arxiv.org/abs/2602.20972","contentUrl":null,"metadataVersion":0,"schemaVersion":"http://datacite.org/schema/kernel-4","source":"mds","isActive":true,"state":"findable","reason":null,"viewCount":0,"downloadCount":0,"referenceCount":0,"citationCount":0,"partCount":0,"partOfCount":0,"versionCount":0,"versionOfCount":0,"created":"2026-02-25T15:33:29Z","registered":"2026-02-25T15:33:29Z","published":null,"updated":"2026-02-25T15:33:29Z"},"relationships":{"client":{"data":{"id":"arxiv.content","type":"clients"}}}},{"id":"10.48550/arxiv.2602.20966","type":"dois","attributes":{"doi":"10.48550/arxiv.2602.20966","identifiers":[{"identifier":"2602.20966","identifierType":"arXiv"}],"creators":[{"nameType":"Personal","givenName":"Paola","familyName":"Merlo","name":"Merlo, Paola","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Chunyang","familyName":"Jiang","name":"Jiang, Chunyang","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Giuseppe","familyName":"Samo","name":"Samo, Giuseppe","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Vivi","familyName":"Nastase","name":"Nastase, Vivi","affiliation":[],"nameIdentifiers":[]}],"titles":[{"title":"Blackbird Language Matrices: A Framework to Investigate the Linguistic Competence of Language Models"}],"publisher":"arXiv","container":{},"publicationYear":2026,"subjects":[{"subject":"Computation and Language (cs.CL)","lang":"en","subjectScheme":"arXiv"},{"subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"},{"schemeUri":"http://www.oecd.org/science/inno/38235147.pdf","subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"}],"contributors":[],"dates":[{"date":"2026-02-24T14:45:08Z","dateType":"Submitted","dateInformation":"v1"},{"date":"2026-02-25T01:52:39Z","dateType":"Updated","dateInformation":"v1"},{"date":"2026-02","dateType":"Available","dateInformation":"v1"},{"date":"2026","dateType":"Issued"}],"language":null,"types":{"schemaOrg":"CreativeWork","resourceTypeGeneral":"Preprint","citeproc":"article","bibtex":"misc","ris":"GEN","resourceType":"Article"},"relatedIdentifiers":[],"relatedItems":[],"sizes":[],"formats":[],"version":"1","rightsList":[{"rightsIdentifierScheme":"SPDX","rightsUri":"https://creativecommons.org/licenses/by/4.0/legalcode","schemeUri":"https://spdx.org/licenses/","rights":"Creative Commons Attribution 4.0 International","rightsIdentifier":"cc-by-4.0"}],"descriptions":[{"descriptionType":"Abstract","description":"This article describes a novel language task, the Blackbird Language Matrices (BLM) task, inspired by intelligence tests, and illustrates the BLM datasets, their construction and benchmarking, and targeted experiments on chunking and systematicity. BLMs are multiple-choice problems, structured at multiple levels: within each sentence, across the input sequence, within each candidate answer. Because of their rich structure, these curated, but naturalistic datasets are key to answer some core questions about current large language models abilities: do LLMs detect linguistic objects and their properties? Do they detect and use systematic patterns across sentences? Are they more prone to linguistic or reasoning errors, and how do these interact?\n We show that BLMs, while challenging, can be solved at good levels of performance, in more than one language, with simple baseline models or, at better performance levels, with more tailored models. We show that their representations contain the grammatical objects and attributes relevant to solve a linguistic task. We also show that these solutions are reached by detecting systematic patterns across sentences.\n The paper supports the point of view that curated, structured datasets support multi-faceted investigations of properties of language and large language models. Because they present a curated, articulated structure, because they comprise both learning contexts and expected answers, and because they are partly built by hand, BLMs fall in the category of datasets that can support explainability investigations, and be useful to ask why large language models behave the way they do."},{"descriptionType":"Other","description":"Under review, 46 pages, 5 tables, 28 figures"}],"geoLocations":[],"fundingReferences":[],"url":"https://arxiv.org/abs/2602.20966","contentUrl":null,"metadataVersion":0,"schemaVersion":"http://datacite.org/schema/kernel-4","source":"mds","isActive":true,"state":"findable","reason":null,"viewCount":0,"downloadCount":0,"referenceCount":0,"citationCount":0,"partCount":0,"partOfCount":0,"versionCount":0,"versionOfCount":0,"created":"2026-02-25T15:33:14Z","registered":"2026-02-25T15:33:14Z","published":null,"updated":"2026-02-25T15:33:14Z"},"relationships":{"client":{"data":{"id":"arxiv.content","type":"clients"}}}},{"id":"10.48550/arxiv.2602.20965","type":"dois","attributes":{"doi":"10.48550/arxiv.2602.20965","identifiers":[{"identifier":"2602.20965","identifierType":"arXiv"}],"creators":[{"nameType":"Personal","givenName":"María José","familyName":"Llop","name":"Llop, María José","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Andrea","familyName":"Bergesio","name":"Bergesio, Andrea","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Anne-Françoise","familyName":"Yao","name":"Yao, Anne-Françoise","affiliation":[],"nameIdentifiers":[]}],"titles":[{"title":"Estimating the Partially Linear Zero-Inflated Poisson Regression Model: a Robust Approach Using a EM-like Algorithm"}],"publisher":"arXiv","container":{},"publicationYear":2026,"subjects":[{"subject":"Methodology (stat.ME)","lang":"en","subjectScheme":"arXiv"},{"subject":"Statistics Theory (math.ST)","lang":"en","subjectScheme":"arXiv"},{"subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"},{"schemeUri":"http://www.oecd.org/science/inno/38235147.pdf","subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"},{"subject":"FOS: Mathematics","subjectScheme":"Fields of Science and Technology (FOS)"},{"schemeUri":"http://www.oecd.org/science/inno/38235147.pdf","subject":"FOS: Mathematics","subjectScheme":"Fields of Science and Technology (FOS)"}],"contributors":[],"dates":[{"date":"2026-02-24T14:44:22Z","dateType":"Submitted","dateInformation":"v1"},{"date":"2026-02-25T01:52:35Z","dateType":"Updated","dateInformation":"v1"},{"date":"2026-02","dateType":"Available","dateInformation":"v1"},{"date":"2026","dateType":"Issued"}],"language":null,"types":{"schemaOrg":"CreativeWork","resourceTypeGeneral":"Preprint","citeproc":"article","bibtex":"misc","ris":"GEN","resourceType":"Article"},"relatedIdentifiers":[],"relatedItems":[],"sizes":[],"formats":[],"version":"1","rightsList":[{"rightsUri":"http://arxiv.org/licenses/nonexclusive-distrib/1.0/","rights":"arXiv.org perpetual, non-exclusive license"}],"descriptions":[{"descriptionType":"Abstract","description":"Count data with an excessive number of zeros frequently arise in fields such as economics, medicine, and public health. Traditional count models often fail to adequately handle such data, especially when the relationship between the response and some predictors is nonlinear. To overcome these limitations, the partially linear zero-inflated Poisson (PLZIP) model has been proposed as a flexible alternative. However, all existing estimation approaches for this model are based on likelihood, which is known to be highly sensitive to outliers and slight deviations from the model assumptions. This article presents the first robust estimation method specifically developed for the PLZIP model. An Expectation-Maximization-like algorithm is used to take advantage of the mixture nature of the model and to address extreme observations in both the response and the covariates. Results of the algorithm convergence and the consistency of the estimators are proved. A simulation study under various contamination schemes showed the robustness and efficiency of the proposed estimators in finite samples, compared to classical estimators. Finally, the application of the methodology is illustrated through an example using real data."}],"geoLocations":[],"fundingReferences":[],"url":"https://arxiv.org/abs/2602.20965","contentUrl":null,"metadataVersion":0,"schemaVersion":"http://datacite.org/schema/kernel-4","source":"mds","isActive":true,"state":"findable","reason":null,"viewCount":0,"downloadCount":0,"referenceCount":0,"citationCount":0,"partCount":0,"partOfCount":0,"versionCount":0,"versionOfCount":0,"created":"2026-02-25T15:33:11Z","registered":"2026-02-25T15:33:12Z","published":null,"updated":"2026-02-25T15:33:12Z"},"relationships":{"client":{"data":{"id":"arxiv.content","type":"clients"}}}},{"id":"10.48550/arxiv.2602.20961","type":"dois","attributes":{"doi":"10.48550/arxiv.2602.20961","identifiers":[{"identifier":"2602.20961","identifierType":"arXiv"}],"creators":[{"nameType":"Personal","givenName":"Koen van den","familyName":"Dungen","name":"Dungen, Koen van den","affiliation":[],"nameIdentifiers":[]}],"titles":[{"title":"A K-theoretic note on the spectral localiser"}],"publisher":"arXiv","container":{},"publicationYear":2026,"subjects":[{"subject":"K-Theory and Homology (math.KT)","lang":"en","subjectScheme":"arXiv"},{"subject":"FOS: Mathematics","subjectScheme":"Fields of Science and Technology (FOS)"},{"schemeUri":"http://www.oecd.org/science/inno/38235147.pdf","subject":"FOS: Mathematics","subjectScheme":"Fields of Science and Technology (FOS)"},{"subject":"46L80, 19K56, 58J30","lang":"en","subjectScheme":"MSC"}],"contributors":[],"dates":[{"date":"2026-02-24T14:40:27Z","dateType":"Submitted","dateInformation":"v1"},{"date":"2026-02-25T01:52:22Z","dateType":"Updated","dateInformation":"v1"},{"date":"2026-02","dateType":"Available","dateInformation":"v1"},{"date":"2026","dateType":"Issued"}],"language":null,"types":{"schemaOrg":"CreativeWork","resourceTypeGeneral":"Preprint","citeproc":"article","bibtex":"misc","ris":"GEN","resourceType":"Article"},"relatedIdentifiers":[],"relatedItems":[],"sizes":[],"formats":[],"version":"1","rightsList":[{"rightsUri":"http://arxiv.org/licenses/nonexclusive-distrib/1.0/","rights":"arXiv.org perpetual, non-exclusive license"}],"descriptions":[{"descriptionType":"Abstract","description":"We review the construction of the spectral localiser (due to Loring and Schulz-Baldes) from a K-theoretic perspective. We first give a K-theoretic argument providing a spectral flow expression for the even or odd index pairing in terms of the \"infinite volume\" spectral localiser. Our approach towards this first step is more direct, treats the even and odd cases on an equal footing, and has the advantage that the construction of the spectral localiser becomes immediately apparent from the computation of the index pairing via a Kasparov product. In a second step of \"spectral truncation\", we then describe how this spectral flow expression can be computed in terms of the signature of the \"finite volume\" spectral localiser. Throughout, we do not require invertibility of the operator representing the K-homology class, and the even index pairing then obtains an additional contribution coming from the Fredholm index."},{"descriptionType":"Other","description":"18 pages"}],"geoLocations":[],"fundingReferences":[],"url":"https://arxiv.org/abs/2602.20961","contentUrl":null,"metadataVersion":0,"schemaVersion":"http://datacite.org/schema/kernel-4","source":"mds","isActive":true,"state":"findable","reason":null,"viewCount":0,"downloadCount":0,"referenceCount":0,"citationCount":0,"partCount":0,"partOfCount":0,"versionCount":0,"versionOfCount":0,"created":"2026-02-25T15:33:01Z","registered":"2026-02-25T15:33:02Z","published":null,"updated":"2026-02-25T15:33:02Z"},"relationships":{"client":{"data":{"id":"arxiv.content","type":"clients"}}}},{"id":"10.48550/arxiv.2602.20959","type":"dois","attributes":{"doi":"10.48550/arxiv.2602.20959","identifiers":[{"identifier":"2602.20959","identifierType":"arXiv"}],"creators":[{"nameType":"Personal","givenName":"Ian","familyName":"Slagle","name":"Slagle, Ian","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Faisal","familyName":"Alamgir","name":"Alamgir, Faisal","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Victor","familyName":"Fung","name":"Fung, Victor","affiliation":[],"nameIdentifiers":[]}],"titles":[{"title":"Determining Atomic Structure from Spectroscopy via an Active Learning Framework"}],"publisher":"arXiv","container":{},"publicationYear":2026,"subjects":[{"subject":"Materials Science (cond-mat.mtrl-sci)","lang":"en","subjectScheme":"arXiv"},{"subject":"FOS: Physical sciences","subjectScheme":"Fields of Science and Technology (FOS)"},{"schemeUri":"http://www.oecd.org/science/inno/38235147.pdf","subject":"FOS: Physical sciences","subjectScheme":"Fields of Science and Technology (FOS)"}],"contributors":[],"dates":[{"date":"2026-02-24T14:39:32Z","dateType":"Submitted","dateInformation":"v1"},{"date":"2026-02-25T01:52:16Z","dateType":"Updated","dateInformation":"v1"},{"date":"2026-02","dateType":"Available","dateInformation":"v1"},{"date":"2026","dateType":"Issued"}],"language":null,"types":{"schemaOrg":"CreativeWork","resourceTypeGeneral":"Preprint","citeproc":"article","bibtex":"misc","ris":"GEN","resourceType":"Article"},"relatedIdentifiers":[],"relatedItems":[],"sizes":[],"formats":[],"version":"1","rightsList":[{"rightsIdentifierScheme":"SPDX","rightsUri":"https://creativecommons.org/licenses/by/4.0/legalcode","schemeUri":"https://spdx.org/licenses/","rights":"Creative Commons Attribution 4.0 International","rightsIdentifier":"cc-by-4.0"}],"descriptions":[{"descriptionType":"Abstract","description":"Determining atomic structure from spectroscopic data is central to materials science but remains restricted to a limited set of techniques and material classes, largely due to the computational cost and complexity of structural refinement. Here we introduce ActiveStructOpt, a general framework that integrates graph neural network surrogate models with active learning to efficiently determine candidate structures that reproduce target spectra with minimal computational expenditure. Benchmarking with X-ray pair distribution function data, and with the more computationally demanding simulations of X-ray absorption near-edge spectra (XANES) and extended X-ray absorption fine structure (EXAFS), demonstrate that ActiveStructOpt reliably determines structures that match closely in spectra across diverse materials classes. Under equivalent computational budgets, ActiveStructOpt outperforms existing structure determination methods. By enabling data-efficient, multi-objective structural refinement across a broad range of computable spectroscopic techniques, ActiveStructOpt provides a flexible and extensible approach to atomic structure determination in complex materials."}],"geoLocations":[],"fundingReferences":[],"url":"https://arxiv.org/abs/2602.20959","contentUrl":null,"metadataVersion":0,"schemaVersion":"http://datacite.org/schema/kernel-4","source":"mds","isActive":true,"state":"findable","reason":null,"viewCount":0,"downloadCount":0,"referenceCount":0,"citationCount":0,"partCount":0,"partOfCount":0,"versionCount":0,"versionOfCount":0,"created":"2026-02-25T15:32:56Z","registered":"2026-02-25T15:32:57Z","published":null,"updated":"2026-02-25T15:32:57Z"},"relationships":{"client":{"data":{"id":"arxiv.content","type":"clients"}}}},{"id":"10.48550/arxiv.2602.20957","type":"dois","attributes":{"doi":"10.48550/arxiv.2602.20957","identifiers":[{"identifier":"2602.20957","identifierType":"arXiv"}],"creators":[{"nameType":"Personal","givenName":"Dmitry","familyName":"Vasilyev","name":"Vasilyev, Dmitry","affiliation":[],"nameIdentifiers":[]}],"titles":[{"title":"A One-Dimensional Reduction Method for Calculating Thermal Expansion in Solids: Application to Orthorhombic Systems"}],"publisher":"arXiv","container":{},"publicationYear":2026,"subjects":[{"subject":"Materials Science (cond-mat.mtrl-sci)","lang":"en","subjectScheme":"arXiv"},{"subject":"FOS: Physical sciences","subjectScheme":"Fields of Science and Technology (FOS)"},{"schemeUri":"http://www.oecd.org/science/inno/38235147.pdf","subject":"FOS: Physical sciences","subjectScheme":"Fields of Science and Technology (FOS)"}],"contributors":[],"dates":[{"date":"2026-02-24T14:37:18Z","dateType":"Submitted","dateInformation":"v1"},{"date":"2026-02-25T01:52:11Z","dateType":"Updated","dateInformation":"v1"},{"date":"2026-02","dateType":"Available","dateInformation":"v1"},{"date":"2026","dateType":"Issued"}],"language":null,"types":{"schemaOrg":"CreativeWork","resourceTypeGeneral":"Preprint","citeproc":"article","bibtex":"misc","ris":"GEN","resourceType":"Article"},"relatedIdentifiers":[],"relatedItems":[],"sizes":[],"formats":[],"version":"1","rightsList":[{"rightsUri":"http://arxiv.org/licenses/nonexclusive-distrib/1.0/","rights":"arXiv.org perpetual, non-exclusive license"}],"descriptions":[{"descriptionType":"Abstract","description":"Anisotropic thermal expansion plays a critical role in the performance and reliability of functional materials, yet its theoretical description remains limited. Here, a computational framework that reduces the calculation of thermal expansion in solids to an effective one-dimensional problem is presented and applied to orthorhombic lattice. Using this method, a comprehensive set of thermodynamic and mechanical properties is determined."}],"geoLocations":[],"fundingReferences":[],"url":"https://arxiv.org/abs/2602.20957","contentUrl":null,"metadataVersion":0,"schemaVersion":"http://datacite.org/schema/kernel-4","source":"mds","isActive":true,"state":"findable","reason":null,"viewCount":0,"downloadCount":0,"referenceCount":0,"citationCount":0,"partCount":0,"partOfCount":0,"versionCount":0,"versionOfCount":0,"created":"2026-02-25T15:32:51Z","registered":"2026-02-25T15:32:52Z","published":null,"updated":"2026-02-25T15:32:52Z"},"relationships":{"client":{"data":{"id":"arxiv.content","type":"clients"}}}},{"id":"10.48550/arxiv.2602.20956","type":"dois","attributes":{"doi":"10.48550/arxiv.2602.20956","identifiers":[{"identifier":"2602.20956","identifierType":"arXiv"}],"creators":[{"nameType":"Personal","givenName":"Walid","familyName":"Hachem","name":"Hachem, Walid","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Michail","familyName":"Louvaris","name":"Louvaris, Michail","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Jamal","familyName":"Najim","name":"Najim, Jamal","affiliation":[],"nameIdentifiers":[]}],"titles":[{"title":"Extreme eigenvalues and eigenvectors for finite rank additive deformations of non-hermitian sparse random matrices"}],"publisher":"arXiv","container":{},"publicationYear":2026,"subjects":[{"subject":"Probability (math.PR)","lang":"en","subjectScheme":"arXiv"},{"subject":"Statistics Theory (math.ST)","lang":"en","subjectScheme":"arXiv"},{"subject":"FOS: Mathematics","subjectScheme":"Fields of Science and Technology (FOS)"},{"schemeUri":"http://www.oecd.org/science/inno/38235147.pdf","subject":"FOS: Mathematics","subjectScheme":"Fields of Science and Technology (FOS)"}],"contributors":[],"dates":[{"date":"2026-02-24T14:37:07Z","dateType":"Submitted","dateInformation":"v1"},{"date":"2026-02-25T01:52:10Z","dateType":"Updated","dateInformation":"v1"},{"date":"2026-02","dateType":"Available","dateInformation":"v1"},{"date":"2026","dateType":"Issued"}],"language":null,"types":{"schemaOrg":"CreativeWork","resourceTypeGeneral":"Preprint","citeproc":"article","bibtex":"misc","ris":"GEN","resourceType":"Article"},"relatedIdentifiers":[],"relatedItems":[],"sizes":[],"formats":[],"version":"1","rightsList":[{"rightsIdentifierScheme":"SPDX","rightsUri":"https://creativecommons.org/licenses/by-nc-nd/4.0/legalcode","schemeUri":"https://spdx.org/licenses/","rights":"Creative Commons Attribution Non Commercial No Derivatives 4.0 International","rightsIdentifier":"cc-by-nc-nd-4.0"}],"descriptions":[{"descriptionType":"Abstract","description":"Consider a $n\\times n$ sparse non-Hermitian random matrix $X_n$ defined as the Hadamard product between a random matrix with centered independent and identically distributed entries and a sparse Bernoulli matrix with success probability $K_n/n$ where $K_n\\le n$ (and possibly $K_n\\ll n$) and $K_n\\to \\infty$ as $n\\to \\infty$. Let $E_n$ be a deterministic $n\\times n$ finite-rank matrix. We prove that the outlier eigenvalues of $Y_n= X_n +E_n$ asymptotically match those of $E_n$. In the special case of a rank-one deformation, assuming further that the sparsity parameter satisfies $K_n \\gg \\log^9(n)$ and that the entries of the random matrix are sub-Gaussian, we describe the limiting behavior of the projection of the right eigenvector associated with the leading eigenvalue onto the right eigenvector of the rank-one deformation. In particular, we prove that the projection behaves as in the Hermitian case. To that end, we rely on the recent universality results of Brailovskaya and van Handel (2024) relating the singular value spectra of deformations of $X_n$ to Gaussian analogues of these matrices. Our analysis builds upon a recent framework introduced by Bordenave et.al. (2022), and amounts to showing the asymptotic equivalence between the reverse characteristic polynomial of the random matrix and a random analytic function on the unit disc with explicit dependence on the finite-rank deformation."},{"descriptionType":"Other","description":"27 pages"}],"geoLocations":[],"fundingReferences":[],"url":"https://arxiv.org/abs/2602.20956","contentUrl":null,"metadataVersion":0,"schemaVersion":"http://datacite.org/schema/kernel-4","source":"mds","isActive":true,"state":"findable","reason":null,"viewCount":0,"downloadCount":0,"referenceCount":0,"citationCount":0,"partCount":0,"partOfCount":0,"versionCount":0,"versionOfCount":0,"created":"2026-02-25T15:32:48Z","registered":"2026-02-25T15:32:49Z","published":null,"updated":"2026-02-25T15:32:49Z"},"relationships":{"client":{"data":{"id":"arxiv.content","type":"clients"}}}},{"id":"10.48550/arxiv.2602.20955","type":"dois","attributes":{"doi":"10.48550/arxiv.2602.20955","identifiers":[{"identifier":"2602.20955","identifierType":"arXiv"}],"creators":[{"nameType":"Personal","givenName":"Woula","familyName":"Themistoclakis","name":"Themistoclakis, Woula","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Marc","familyName":"Van Barel","name":"Van Barel, Marc","affiliation":[],"nameIdentifiers":[]}],"titles":[{"title":"Orthonormal polynomial wavelets associated with de la Vallée Poussin-type interpolation on $[-1,1]$"}],"publisher":"arXiv","container":{},"publicationYear":2026,"subjects":[{"subject":"Numerical Analysis (math.NA)","lang":"en","subjectScheme":"arXiv"},{"subject":"FOS: Mathematics","subjectScheme":"Fields of Science and Technology (FOS)"},{"schemeUri":"http://www.oecd.org/science/inno/38235147.pdf","subject":"FOS: Mathematics","subjectScheme":"Fields of Science and Technology (FOS)"},{"subject":"42C40, 65T60","lang":"en","subjectScheme":"MSC"}],"contributors":[],"dates":[{"date":"2026-02-24T14:37:04Z","dateType":"Submitted","dateInformation":"v1"},{"date":"2026-02-25T01:52:09Z","dateType":"Updated","dateInformation":"v1"},{"date":"2026-02","dateType":"Available","dateInformation":"v1"},{"date":"2026","dateType":"Issued"}],"language":null,"types":{"schemaOrg":"CreativeWork","resourceTypeGeneral":"Preprint","citeproc":"article","bibtex":"misc","ris":"GEN","resourceType":"Article"},"relatedIdentifiers":[],"relatedItems":[],"sizes":[],"formats":[],"version":"1","rightsList":[{"rightsUri":"http://arxiv.org/licenses/nonexclusive-distrib/1.0/","rights":"arXiv.org perpetual, non-exclusive license"}],"descriptions":[{"descriptionType":"Abstract","description":"Starting from de la Vallée Poussin type (VP) interpolation, the authors have recently introduced a family of interpolating polynomial scaling and wavelet bases generating the approximation and detail spaces of a non-standard multiresolution analysis. Motivated by the fact that, in many applications, orthonormal rather than interpolating bases are preferable, the present study develops a new family of scaling and wavelet polynomials that provide well-localized and orthonormal bases for the same approximation and detail spaces.\n We show that the proposed new bases have a behavior very similar to the interpolating bases already introduced, presenting similar features although they are not interpolating but orthonormal. In particular, we study the Fourier projection corresponding to the proposed orthonormal scaling basis, and introduce a discrete version of it by approximating the Fourier--like coefficients. For both continuous and discrete orthogonal projections, we prove the uniform boundedness of the Lebesgue constants and the uniform convergence with an asymptotic rate comparable with the best uniform polynomial approximation.\n Numerical experiments confirm the theoretical results and compare the new orthonormal VP scaling and wavelet bases with the interpolating case previously treated by the authors."},{"descriptionType":"Other","description":"33 pages"}],"geoLocations":[],"fundingReferences":[],"url":"https://arxiv.org/abs/2602.20955","contentUrl":null,"metadataVersion":0,"schemaVersion":"http://datacite.org/schema/kernel-4","source":"mds","isActive":true,"state":"findable","reason":null,"viewCount":0,"downloadCount":0,"referenceCount":0,"citationCount":0,"partCount":0,"partOfCount":0,"versionCount":0,"versionOfCount":0,"created":"2026-02-25T15:32:46Z","registered":"2026-02-25T15:32:47Z","published":null,"updated":"2026-02-25T15:32:47Z"},"relationships":{"client":{"data":{"id":"arxiv.content","type":"clients"}}}},{"id":"10.48550/arxiv.2602.20954","type":"dois","attributes":{"doi":"10.48550/arxiv.2602.20954","identifiers":[{"identifier":"2602.20954","identifierType":"arXiv"}],"creators":[{"nameType":"Personal","givenName":"Jan W.","familyName":"Owsiński","name":"Owsiński, Jan W.","affiliation":[],"nameIdentifiers":[]}],"titles":[{"title":"Hierarchical Aggregation Clustering Algorithms Derived from the Bi-partial Objective Function"}],"publisher":"arXiv","container":{},"publicationYear":2026,"subjects":[{"subject":"Other Statistics (stat.OT)","lang":"en","subjectScheme":"arXiv"},{"subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"},{"schemeUri":"http://www.oecd.org/science/inno/38235147.pdf","subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"},{"subject":"E.1; G.3; I.5","lang":"en","subjectScheme":"ACM"},{"subject":"62H30","lang":"en","subjectScheme":"MSC"}],"contributors":[],"dates":[{"date":"2026-02-24T14:36:35Z","dateType":"Submitted","dateInformation":"v1"},{"date":"2026-02-25T01:52:08Z","dateType":"Updated","dateInformation":"v1"},{"date":"2026-02","dateType":"Available","dateInformation":"v1"},{"date":"2026","dateType":"Issued"}],"language":null,"types":{"schemaOrg":"CreativeWork","resourceTypeGeneral":"Preprint","citeproc":"article","bibtex":"misc","ris":"GEN","resourceType":"Article"},"relatedIdentifiers":[],"relatedItems":[],"sizes":[],"formats":[],"version":"1","rightsList":[{"rightsIdentifierScheme":"SPDX","rightsUri":"https://creativecommons.org/licenses/by/4.0/legalcode","schemeUri":"https://spdx.org/licenses/","rights":"Creative Commons Attribution 4.0 International","rightsIdentifier":"cc-by-4.0"}],"descriptions":[{"descriptionType":"Abstract","description":"The paper outlines the principles of construction of a broad class of hierarchical aggregation algorithms of cluster analysis, essentially based on minimum distance mergers, which are derived from the general bi-partial objective function. It is shown how the algorithms arise from the bi-partial objective function, their affinity with the classical hierarchical aggregation algorithms is demonstrated, and the examples of such algorithms for the concrete forms of the bi-partial objective function are provided. This amounts to the first explicit and, at the same time, quite general, connection between optimization in clustering and the hierarchical aggregation algorithms. Thereby, the respective hierarchical algorithms gain a deeper justification, the means for evaluating the quality of clustering is provided, along with the criterion of stopping the cluster mergers."},{"descriptionType":"Other","description":"An original paper, not yet submitted anywhere"}],"geoLocations":[],"fundingReferences":[],"url":"https://arxiv.org/abs/2602.20954","contentUrl":null,"metadataVersion":0,"schemaVersion":"http://datacite.org/schema/kernel-4","source":"mds","isActive":true,"state":"findable","reason":null,"viewCount":0,"downloadCount":0,"referenceCount":0,"citationCount":0,"partCount":0,"partOfCount":0,"versionCount":0,"versionOfCount":0,"created":"2026-02-25T15:32:41Z","registered":"2026-02-25T15:32:44Z","published":null,"updated":"2026-02-25T15:32:44Z"},"relationships":{"client":{"data":{"id":"arxiv.content","type":"clients"}}}},{"id":"10.48550/arxiv.2602.20952","type":"dois","attributes":{"doi":"10.48550/arxiv.2602.20952","identifiers":[{"identifier":"2602.20952","identifierType":"arXiv"}],"creators":[{"nameType":"Personal","givenName":"Zhen","familyName":"Lv","name":"Lv, Zhen","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Cong","familyName":"Cao","name":"Cao, Cong","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Hongwei","familyName":"Huo","name":"Huo, Hongwei","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Jiangtao","familyName":"Cui","name":"Cui, Jiangtao","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Yanguo","familyName":"Peng","name":"Peng, Yanguo","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Hui","familyName":"Li","name":"Li, Hui","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Yingfan","familyName":"Liu","name":"Liu, Yingfan","affiliation":[],"nameIdentifiers":[]}],"titles":[{"title":"RISK: Efficiently processing rich spatial-keyword queries on encrypted geo-textual data"}],"publisher":"arXiv","container":{},"publicationYear":2026,"subjects":[{"subject":"Databases (cs.DB)","lang":"en","subjectScheme":"arXiv"},{"subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"},{"schemeUri":"http://www.oecd.org/science/inno/38235147.pdf","subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"}],"contributors":[],"dates":[{"date":"2026-02-24T14:35:32Z","dateType":"Submitted","dateInformation":"v1"},{"date":"2026-02-25T01:52:00Z","dateType":"Updated","dateInformation":"v1"},{"date":"2026-02","dateType":"Available","dateInformation":"v1"},{"date":"2026","dateType":"Issued"}],"language":null,"types":{"schemaOrg":"CreativeWork","resourceTypeGeneral":"Preprint","citeproc":"article","bibtex":"misc","ris":"GEN","resourceType":"Article"},"relatedIdentifiers":[],"relatedItems":[],"sizes":[],"formats":[],"version":"1","rightsList":[{"rightsIdentifierScheme":"SPDX","rightsUri":"https://creativecommons.org/licenses/by/4.0/legalcode","schemeUri":"https://spdx.org/licenses/","rights":"Creative Commons Attribution 4.0 International","rightsIdentifier":"cc-by-4.0"}],"descriptions":[{"descriptionType":"Abstract","description":"Symmetric searchable encryption (SSE) for geo-textual data has attracted significant attention. However, existing schemes rely on task-specific, incompatible indices for isolated specific secure queries (e.g., range or k-nearest neighbor spatial-keyword queries), limiting practicality due to prohibitive multi-index overhead. To address this, we propose RISK, a model for rich spatial-keyword queries on encrypted geo-textual data. In a textual-first-then-spatial manner, RISK is built on a novel k-nearest neighbor quadtree (kQ-tree) that embeds representative and regional nearest neighbors, with the kQ-tree further encrypted using standard cryptographic tools (e.g., keyed hash functions and symmetric encryption). Overall, RISK seamlessly supports both secure range and k-nearest neighbor queries, is provably secure under IND-CKA2 model, and extensible to multi-party scenarios and dynamic updates. Experiments on three real-world and one synthetic datasets show that RISK outperforms state-of-the-art methods by at least 0.5 and 4 orders of magnitude in response time for 1% range queries and 10-nearest neighbor queries, respectively."},{"descriptionType":"Other","description":"15 pages, 10 figures, IEEE ICDE"}],"geoLocations":[],"fundingReferences":[],"url":"https://arxiv.org/abs/2602.20952","contentUrl":null,"metadataVersion":0,"schemaVersion":"http://datacite.org/schema/kernel-4","source":"mds","isActive":true,"state":"findable","reason":null,"viewCount":0,"downloadCount":0,"referenceCount":0,"citationCount":0,"partCount":0,"partOfCount":0,"versionCount":0,"versionOfCount":0,"created":"2026-02-25T15:32:37Z","registered":"2026-02-25T15:32:37Z","published":null,"updated":"2026-02-25T15:32:37Z"},"relationships":{"client":{"data":{"id":"arxiv.content","type":"clients"}}}},{"id":"10.48550/arxiv.2602.20950","type":"dois","attributes":{"doi":"10.48550/arxiv.2602.20950","identifiers":[{"identifier":"2602.20950","identifierType":"arXiv"}],"creators":[{"nameType":"Personal","givenName":"Shihan","familyName":"Li","name":"Li, Shihan","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Jinhan","familyName":"Guo","name":"Guo, Jinhan","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Wensi","familyName":"Wang","name":"Wang, Wensi","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Yu","familyName":"Dai","name":"Dai, Yu","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Brigitte","familyName":"Schmieder","name":"Schmieder, Brigitte","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Jaroslav","familyName":"DudÍk","name":"DudÍk, Jaroslav","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Yang","familyName":"Guo","name":"Guo, Yang","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Mingde","familyName":"Ding","name":"Ding, Mingde","affiliation":[],"nameIdentifiers":[]}],"titles":[{"title":"Multiple Extreme Ultraviolet Peaks Attributed to Three-dimensional Magnetic Reconnection in a Long-duration Solar Flare"}],"publisher":"arXiv","container":{},"publicationYear":2026,"subjects":[{"subject":"Solar and Stellar Astrophysics (astro-ph.SR)","lang":"en","subjectScheme":"arXiv"},{"subject":"FOS: Physical sciences","subjectScheme":"Fields of Science and Technology (FOS)"},{"schemeUri":"http://www.oecd.org/science/inno/38235147.pdf","subject":"FOS: Physical sciences","subjectScheme":"Fields of Science and Technology (FOS)"}],"contributors":[],"dates":[{"date":"2026-02-24T14:33:56Z","dateType":"Submitted","dateInformation":"v1"},{"date":"2026-02-25T01:51:51Z","dateType":"Updated","dateInformation":"v1"},{"date":"2026-02","dateType":"Available","dateInformation":"v1"},{"date":"2026","dateType":"Issued"}],"language":null,"types":{"schemaOrg":"CreativeWork","resourceTypeGeneral":"Preprint","citeproc":"article","bibtex":"misc","ris":"GEN","resourceType":"Article"},"relatedIdentifiers":[],"relatedItems":[],"sizes":[],"formats":[],"version":"1","rightsList":[{"rightsUri":"http://arxiv.org/licenses/nonexclusive-distrib/1.0/","rights":"arXiv.org perpetual, non-exclusive license"}],"descriptions":[{"descriptionType":"Abstract","description":"Solar flares are a major driver of hazardous space weather, whose intense electromagnetic emissions and energetic particles can significantly disturb the near-Earth space environment. Therefore, understanding the physical processes during a solar flare and predicting its radiation profiles are of great importance. In this study, we analyze and model an M1.4 two-ribbon long-duration flare, whose multiple extreme-ultraviolet (EUV) emission peaks are found to correspond to different three-dimensional (3D) magnetic reconnections driven by the continuous evolution of a flux rope. In particular, the second and third peaks in the 335 Å EUV channel originate from longer and higher flare loops with extended cooling times, formed by reconnection between flux-rope field lines and ambient sheared-arcade field lines ($ar\\text{--}rf$) and between flux-rope field lines themselves ($rr\\text{--}rf$). These results are supported by the drifting of the flux-rope footpoint (and flare ribbon) and the decrease in toroidal flux of the flux rope, as well as by the connectivity transfer of representative field lines in the magnetohydrodynamic (MHD) simulation. This work points out, for the first time, new manifestations of the 3D flare scenario in EUV light curves. On the one hand, it provides an explanation for two-ribbon late-phase flares. On the other hand, the conclusions presented here help bridge the gap between imaging observations, EUV light-curve diagnostics, and the magnetic structures of the associated coronal mass ejections."},{"descriptionType":"Other","description":"Accepted for publication in The Astrophysical Journal"}],"geoLocations":[],"fundingReferences":[],"url":"https://arxiv.org/abs/2602.20950","contentUrl":null,"metadataVersion":0,"schemaVersion":"http://datacite.org/schema/kernel-4","source":"mds","isActive":true,"state":"findable","reason":null,"viewCount":0,"downloadCount":0,"referenceCount":0,"citationCount":0,"partCount":0,"partOfCount":0,"versionCount":0,"versionOfCount":0,"created":"2026-02-25T15:32:32Z","registered":"2026-02-25T15:32:33Z","published":null,"updated":"2026-02-25T15:32:33Z"},"relationships":{"client":{"data":{"id":"arxiv.content","type":"clients"}}}},{"id":"10.48550/arxiv.2602.20947","type":"dois","attributes":{"doi":"10.48550/arxiv.2602.20947","identifiers":[{"identifier":"2602.20947","identifierType":"arXiv"}],"creators":[{"nameType":"Personal","givenName":"Thorbjørn Mosekjær","familyName":"Iversen","name":"Iversen, Thorbjørn Mosekjær","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Zebin","familyName":"Duan","name":"Duan, Zebin","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Frederik","familyName":"Hagelskjær","name":"Hagelskjær, Frederik","affiliation":[],"nameIdentifiers":[]}],"titles":[{"title":"Estimation of Confidence Bounds in Binary Classification using Wilson Score Kernel Density Estimation"}],"publisher":"arXiv","container":{},"publicationYear":2026,"subjects":[{"subject":"Machine Learning (cs.LG)","lang":"en","subjectScheme":"arXiv"},{"subject":"Computer Vision and Pattern Recognition (cs.CV)","lang":"en","subjectScheme":"arXiv"},{"subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"},{"schemeUri":"http://www.oecd.org/science/inno/38235147.pdf","subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"}],"contributors":[],"dates":[{"date":"2026-02-24T14:31:28Z","dateType":"Submitted","dateInformation":"v1"},{"date":"2026-02-25T01:51:35Z","dateType":"Updated","dateInformation":"v1"},{"date":"2026-02","dateType":"Available","dateInformation":"v1"},{"date":"2026","dateType":"Issued"}],"language":null,"types":{"schemaOrg":"CreativeWork","resourceTypeGeneral":"Preprint","citeproc":"article","bibtex":"misc","ris":"GEN","resourceType":"Article"},"relatedIdentifiers":[],"relatedItems":[],"sizes":[],"formats":[],"version":"1","rightsList":[{"rightsUri":"http://arxiv.org/licenses/nonexclusive-distrib/1.0/","rights":"arXiv.org perpetual, non-exclusive license"}],"descriptions":[{"descriptionType":"Abstract","description":"The performance and ease of use of deep learning-based binary classifiers have improved significantly in recent years. This has opened up the potential for automating critical inspection tasks, which have traditionally only been trusted to be done manually. However, the application of binary classifiers in critical operations depends on the estimation of reliable confidence bounds such that system performance can be ensured up to a given statistical significance. We present Wilson Score Kernel Density Classification, which is a novel kernel-based method for estimating confidence bounds in binary classification. The core of our method is the Wilson Score Kernel Density Estimator, which is a function estimator for estimating confidence bounds in Binomial experiments with conditionally varying success probabilities. Our method is evaluated in the context of selective classification on four different datasets, illustrating its use as a classification head of any feature extractor, including vision foundation models. Our proposed method shows similar performance to Gaussian Process Classification, but at a lower computational complexity."}],"geoLocations":[],"fundingReferences":[],"url":"https://arxiv.org/abs/2602.20947","contentUrl":null,"metadataVersion":0,"schemaVersion":"http://datacite.org/schema/kernel-4","source":"mds","isActive":true,"state":"findable","reason":null,"viewCount":0,"downloadCount":0,"referenceCount":0,"citationCount":0,"partCount":0,"partOfCount":0,"versionCount":0,"versionOfCount":0,"created":"2026-02-25T15:32:24Z","registered":"2026-02-25T15:32:25Z","published":null,"updated":"2026-02-25T15:32:25Z"},"relationships":{"client":{"data":{"id":"arxiv.content","type":"clients"}}}},{"id":"10.48550/arxiv.2602.20943","type":"dois","attributes":{"doi":"10.48550/arxiv.2602.20943","identifiers":[{"identifier":"2602.20943","identifierType":"arXiv"}],"creators":[{"nameType":"Personal","givenName":"Kaiyuan","familyName":"Tan","name":"Tan, Kaiyuan","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Yingying","familyName":"Shen","name":"Shen, Yingying","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Mingfei","familyName":"Tu","name":"Tu, Mingfei","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Haohui","familyName":"Zhu","name":"Zhu, Haohui","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Bing","familyName":"Wang","name":"Wang, Bing","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Guang","familyName":"Chen","name":"Chen, Guang","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Hangjun","familyName":"Ye","name":"Ye, Hangjun","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Haiyang","familyName":"Sun","name":"Sun, Haiyang","affiliation":[],"nameIdentifiers":[]}],"titles":[{"title":"UFO: Unifying Feed-Forward and Optimization-based Methods for Large Driving Scene Modeling"}],"publisher":"arXiv","container":{},"publicationYear":2026,"subjects":[{"subject":"Computer Vision and Pattern Recognition (cs.CV)","lang":"en","subjectScheme":"arXiv"},{"subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"},{"schemeUri":"http://www.oecd.org/science/inno/38235147.pdf","subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"}],"contributors":[],"dates":[{"date":"2026-02-24T14:24:50Z","dateType":"Submitted","dateInformation":"v1"},{"date":"2026-02-25T01:51:20Z","dateType":"Updated","dateInformation":"v1"},{"date":"2026-02","dateType":"Available","dateInformation":"v1"},{"date":"2026","dateType":"Issued"}],"language":null,"types":{"schemaOrg":"CreativeWork","resourceTypeGeneral":"Preprint","citeproc":"article","bibtex":"misc","ris":"GEN","resourceType":"Article"},"relatedIdentifiers":[],"relatedItems":[],"sizes":[],"formats":[],"version":"1","rightsList":[{"rightsIdentifierScheme":"SPDX","rightsUri":"https://creativecommons.org/licenses/by/4.0/legalcode","schemeUri":"https://spdx.org/licenses/","rights":"Creative Commons Attribution 4.0 International","rightsIdentifier":"cc-by-4.0"}],"descriptions":[{"descriptionType":"Abstract","description":"Dynamic driving scene reconstruction is critical for autonomous driving simulation and closed-loop learning. While recent feed-forward methods have shown promise for 3D reconstruction, they struggle with long-range driving sequences due to quadratic complexity in sequence length and challenges in modeling dynamic objects over extended durations. We propose UFO, a novel recurrent paradigm that combines the benefits of optimization-based and feed-forward methods for efficient long-range 4D reconstruction. Our approach maintains a 4D scene representation that is iteratively refined as new observations arrive, using a visibility-based filtering mechanism to select informative scene tokens and enable efficient processing of long sequences. For dynamic objects, we introduce an object pose-guided modeling approach that supports accurate long-range motion capture. Experiments on the Waymo Open Dataset demonstrate that our method significantly outperforms both per-scene optimization and existing feed-forward methods across various sequence lengths. Notably, our approach can reconstruct 16-second driving logs within 0.5 second while maintaining superior visual quality and geometric accuracy."}],"geoLocations":[],"fundingReferences":[],"url":"https://arxiv.org/abs/2602.20943","contentUrl":null,"metadataVersion":0,"schemaVersion":"http://datacite.org/schema/kernel-4","source":"mds","isActive":true,"state":"findable","reason":null,"viewCount":0,"downloadCount":0,"referenceCount":0,"citationCount":0,"partCount":0,"partOfCount":0,"versionCount":0,"versionOfCount":0,"created":"2026-02-25T15:32:15Z","registered":"2026-02-25T15:32:15Z","published":null,"updated":"2026-02-25T15:32:15Z"},"relationships":{"client":{"data":{"id":"arxiv.content","type":"clients"}}}},{"id":"10.48550/arxiv.2602.20942","type":"dois","attributes":{"doi":"10.48550/arxiv.2602.20942","identifiers":[{"identifier":"2602.20942","identifierType":"arXiv"}],"creators":[{"nameType":"Personal","givenName":"Khwahish","familyName":"Kushwah","name":"Kushwah, Khwahish","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Gabriel Silveria","familyName":"Denicol","name":"Denicol, Gabriel Silveria","affiliation":[],"nameIdentifiers":[]}],"titles":[{"title":"Relativistic Dissipative Magnetohydrodynamics from the Boltzmann equation for 2-particle species gas"}],"publisher":"arXiv","container":{},"publicationYear":2026,"subjects":[{"subject":"High Energy Astrophysical Phenomena (astro-ph.HE)","lang":"en","subjectScheme":"arXiv"},{"subject":"High Energy Physics - Theory (hep-th)","lang":"en","subjectScheme":"arXiv"},{"subject":"FOS: Physical sciences","subjectScheme":"Fields of Science and Technology (FOS)"},{"schemeUri":"http://www.oecd.org/science/inno/38235147.pdf","subject":"FOS: Physical sciences","subjectScheme":"Fields of Science and Technology (FOS)"}],"contributors":[],"dates":[{"date":"2026-02-24T14:22:56Z","dateType":"Submitted","dateInformation":"v1"},{"date":"2026-02-25T01:51:19Z","dateType":"Updated","dateInformation":"v1"},{"date":"2026-02","dateType":"Available","dateInformation":"v1"},{"date":"2026","dateType":"Issued"}],"language":null,"types":{"schemaOrg":"CreativeWork","resourceTypeGeneral":"Preprint","citeproc":"article","bibtex":"misc","ris":"GEN","resourceType":"Article"},"relatedIdentifiers":[{"relationType":"IsVersionOf","relatedIdentifier":"10.1051/epjconf/202429603004","relatedIdentifierType":"DOI"}],"relatedItems":[],"sizes":[],"formats":[],"version":"1","rightsList":[{"rightsIdentifierScheme":"SPDX","rightsUri":"https://creativecommons.org/licenses/by/4.0/legalcode","schemeUri":"https://spdx.org/licenses/","rights":"Creative Commons Attribution 4.0 International","rightsIdentifier":"cc-by-4.0"}],"descriptions":[{"descriptionType":"Abstract","description":"We derive the equations of motion of relativistic magnetohydrodynamics from the Boltzmann equation using the method of moments. We consider a locally electrically neutral system composed of two particle species with opposite charges, with vanishing dipole moment or spin, so that the fluid has vanishing magnetization and polarization. We find that the dynamics of this fluid changes dramatically in the presence of a magnetic field. The shear stress tensor no longer adheres to a single differential equation; instead, it splits into three non-degenerate components, each evolving according to distinct dynamical equations. Exploring these equations in a Bjorken flow scenario, we find that for large magnetic fields, our theory predicts oscillatory behavior beyond the scope of an Israel-Stewart-like theory."},{"descriptionType":"Other","description":"Contribution to Quark Matter 2023"}],"geoLocations":[],"fundingReferences":[],"url":"https://arxiv.org/abs/2602.20942","contentUrl":null,"metadataVersion":0,"schemaVersion":"http://datacite.org/schema/kernel-4","source":"mds","isActive":true,"state":"findable","reason":null,"viewCount":0,"downloadCount":0,"referenceCount":0,"citationCount":0,"partCount":0,"partOfCount":0,"versionCount":0,"versionOfCount":1,"created":"2026-02-25T15:32:12Z","registered":"2026-02-25T15:32:13Z","published":null,"updated":"2026-02-25T15:32:13Z"},"relationships":{"client":{"data":{"id":"arxiv.content","type":"clients"}}}},{"id":"10.48550/arxiv.2602.20939","type":"dois","attributes":{"doi":"10.48550/arxiv.2602.20939","identifiers":[{"identifier":"2602.20939","identifierType":"arXiv"}],"creators":[{"nameType":"Personal","givenName":"Cynthia","familyName":"Medeiros","name":"Medeiros, Cynthia","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"John","familyName":"Quigley","name":"Quigley, John","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Matthew","familyName":"Revie","name":"Revie, Matthew","affiliation":[],"nameIdentifiers":[]}],"titles":[{"title":"A Statistical Framework for Detecting Emergent Narratives in Longitudinal Text Corpora"}],"publisher":"arXiv","container":{},"publicationYear":2026,"subjects":[{"subject":"Methodology (stat.ME)","lang":"en","subjectScheme":"arXiv"},{"subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"},{"schemeUri":"http://www.oecd.org/science/inno/38235147.pdf","subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"}],"contributors":[],"dates":[{"date":"2026-02-24T14:19:06Z","dateType":"Submitted","dateInformation":"v1"},{"date":"2026-02-25T01:51:14Z","dateType":"Updated","dateInformation":"v1"},{"date":"2026-02","dateType":"Available","dateInformation":"v1"},{"date":"2026","dateType":"Issued"}],"language":null,"types":{"schemaOrg":"CreativeWork","resourceTypeGeneral":"Preprint","citeproc":"article","bibtex":"misc","ris":"GEN","resourceType":"Article"},"relatedIdentifiers":[],"relatedItems":[],"sizes":[],"formats":[],"version":"1","rightsList":[{"rightsUri":"http://arxiv.org/licenses/nonexclusive-distrib/1.0/","rights":"arXiv.org perpetual, non-exclusive license"}],"descriptions":[{"descriptionType":"Abstract","description":"Narratives about economic events and policies are widely recognised as influential drivers of economic and business behaviour. Yet the statistical identification of narrative emergence remains underdeveloped. Narratives evolve gradually, exhibit subtle shifts in content, and may exert influence disproportionate to their observable frequency, making it difficult to determine when observed changes reflect genuine structural shifts rather than routine variation in language use. We propose a statistical framework for detecting narrative emergence in longitudinal text corpora using Latent Dirichlet Allocation (LDA). We define emergence as a sustained increase in a topic's relative prominence over time and articulate a statistical framework for interpreting such trajectories, recognising that topic proportions are latent, model-estimated quantities. We illustrate the approach using a corpus of academic publications in economics spanning 1970-2018, where Nobel Prize-recognised contributions serve as externally observable signals of influential narratives. Topics associated with these contributions display sustained increases in estimated prevalence that coincide with periods of heightened citation activity and broader disciplinary recognition. These findings indicate that model-based topic trajectories can reflect identifiable shifts in economic discourse and provide a statistically grounded basis for analysing thematic change in longitudinal textual data."}],"geoLocations":[],"fundingReferences":[],"url":"https://arxiv.org/abs/2602.20939","contentUrl":null,"metadataVersion":0,"schemaVersion":"http://datacite.org/schema/kernel-4","source":"mds","isActive":true,"state":"findable","reason":null,"viewCount":0,"downloadCount":0,"referenceCount":0,"citationCount":0,"partCount":0,"partOfCount":0,"versionCount":0,"versionOfCount":0,"created":"2026-02-25T15:32:04Z","registered":"2026-02-25T15:32:05Z","published":null,"updated":"2026-02-25T15:32:05Z"},"relationships":{"client":{"data":{"id":"arxiv.content","type":"clients"}}}},{"id":"10.48550/arxiv.2602.20937","type":"dois","attributes":{"doi":"10.48550/arxiv.2602.20937","identifiers":[{"identifier":"2602.20937","identifierType":"arXiv"}],"creators":[{"nameType":"Personal","givenName":"Akshita","familyName":"Gupta","name":"Gupta, Akshita","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Marieme","familyName":"Ngom","name":"Ngom, Marieme","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Sam","familyName":"Foreman","name":"Foreman, Sam","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Venkatram","familyName":"Vishwanath","name":"Vishwanath, Venkatram","affiliation":[],"nameIdentifiers":[]}],"titles":[{"title":"Extending $μ$P: Spectral Conditions for Feature Learning Across Optimizers"}],"publisher":"arXiv","container":{},"publicationYear":2026,"subjects":[{"subject":"Machine Learning (cs.LG)","lang":"en","subjectScheme":"arXiv"},{"subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"},{"schemeUri":"http://www.oecd.org/science/inno/38235147.pdf","subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"},{"subject":"I.2.7","lang":"en","subjectScheme":"ACM"},{"subject":"68T07","lang":"en","subjectScheme":"MSC"}],"contributors":[],"dates":[{"date":"2026-02-24T14:17:51Z","dateType":"Submitted","dateInformation":"v1"},{"date":"2026-02-25T01:51:10Z","dateType":"Updated","dateInformation":"v1"},{"date":"2026-02","dateType":"Available","dateInformation":"v1"},{"date":"2026","dateType":"Issued"}],"language":null,"types":{"schemaOrg":"CreativeWork","resourceTypeGeneral":"Preprint","citeproc":"article","bibtex":"misc","ris":"GEN","resourceType":"Article"},"relatedIdentifiers":[],"relatedItems":[],"sizes":[],"formats":[],"version":"1","rightsList":[{"rightsUri":"http://arxiv.org/licenses/nonexclusive-distrib/1.0/","rights":"arXiv.org perpetual, non-exclusive license"}],"descriptions":[{"descriptionType":"Abstract","description":"Several variations of adaptive first-order and second-order optimization methods have been proposed to accelerate and scale the training of large language models. The performance of these optimization routines is highly sensitive to the choice of hyperparameters (HPs), which are computationally expensive to tune for large-scale models. Maximal update parameterization $(μ$P$)$ is a set of scaling rules which aims to make the optimal HPs independent of the model size, thereby allowing the HPs tuned on a smaller (computationally cheaper) model to be transferred to train a larger, target model. Despite promising results for SGD and Adam, deriving $μ$P for other optimizers is challenging because the underlying tensor programming approach is difficult to grasp. Building on recent work that introduced spectral conditions as an alternative to tensor programs, we propose a novel framework to derive $μ$P for a broader class of optimizers, including AdamW, ADOPT, LAMB, Sophia, Shampoo and Muon. We implement our $μ$P derivations on multiple benchmark models and demonstrate zero-shot learning rate transfer across increasing model width for the above optimizers. Further, we provide empirical insights into depth-scaling parameterization for these optimizers."},{"descriptionType":"Other","description":"10 main pages, 16 appendix pages and 17 figures; Amended version of the publication in 17th International OPT Workshop on Optimization for Machine Learning"}],"geoLocations":[],"fundingReferences":[],"url":"https://arxiv.org/abs/2602.20937","contentUrl":null,"metadataVersion":0,"schemaVersion":"http://datacite.org/schema/kernel-4","source":"mds","isActive":true,"state":"findable","reason":null,"viewCount":0,"downloadCount":0,"referenceCount":0,"citationCount":0,"partCount":0,"partOfCount":0,"versionCount":0,"versionOfCount":0,"created":"2026-02-25T15:31:59Z","registered":"2026-02-25T15:32:00Z","published":null,"updated":"2026-02-25T15:32:00Z"},"relationships":{"client":{"data":{"id":"arxiv.content","type":"clients"}}}},{"id":"10.48550/arxiv.2602.20934","type":"dois","attributes":{"doi":"10.48550/arxiv.2602.20934","identifiers":[{"identifier":"2602.20934","identifierType":"arXiv"}],"creators":[{"nameType":"Personal","givenName":"ChengYou","familyName":"Li","name":"Li, ChengYou","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"XiaoDong","familyName":"Liu","name":"Liu, XiaoDong","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"XiangBao","familyName":"Meng","name":"Meng, XiangBao","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"XinYu","familyName":"Zhao","name":"Zhao, XinYu","affiliation":[],"nameIdentifiers":[]}],"titles":[{"title":"Architecting AgentOS: From Token-Level Context to Emergent System-Level Intelligence"}],"publisher":"arXiv","container":{},"publicationYear":2026,"subjects":[{"subject":"Artificial Intelligence (cs.AI)","lang":"en","subjectScheme":"arXiv"},{"subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"},{"schemeUri":"http://www.oecd.org/science/inno/38235147.pdf","subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"}],"contributors":[],"dates":[{"date":"2026-02-24T14:12:21Z","dateType":"Submitted","dateInformation":"v1"},{"date":"2026-02-25T01:50:42Z","dateType":"Updated","dateInformation":"v1"},{"date":"2026-02","dateType":"Available","dateInformation":"v1"},{"date":"2026","dateType":"Issued"}],"language":null,"types":{"schemaOrg":"CreativeWork","resourceTypeGeneral":"Preprint","citeproc":"article","bibtex":"misc","ris":"GEN","resourceType":"Article"},"relatedIdentifiers":[],"relatedItems":[],"sizes":[],"formats":[],"version":"1","rightsList":[{"rightsUri":"http://arxiv.org/licenses/nonexclusive-distrib/1.0/","rights":"arXiv.org perpetual, non-exclusive license"}],"descriptions":[{"descriptionType":"Abstract","description":"The paradigm of Large Language Models is undergoing a fundamental transition from static inference engines to dynamic autonomous cognitive systems.While current research primarily focuses on scaling context windows or optimizing prompt engineering the theoretical bridge between micro scale token processing and macro scale systemic intelligence remains fragmented.This paper proposes AgentOS,a holistic conceptual framework that redefines the LLM as a \"Reasoning Kernel\" governed by structured operating system logic.Central to this architecture is Deep Context Management which conceptualizes the context window as an Addressable Semantic Space rather than a passive buffer.We systematically deconstruct the transition from discrete sequences to coherent cognitive states introducing mechanisms for Semantic Slicing and Temporal Alignment to mitigate cognitive drift in multi-agent orchestration.By mapping classical OS abstractions such as memory paging interrupt handling and process scheduling onto LLM native constructs, this review provides a rigorous roadmap for architecting resilient scalable and self-evolving cognitive environments.Our analysis asserts that the next frontier of AGI development lies in the architectural efficiency of system-level coordination."},{"descriptionType":"Other","description":"16 pages,9 figures"}],"geoLocations":[],"fundingReferences":[],"url":"https://arxiv.org/abs/2602.20934","contentUrl":null,"metadataVersion":0,"schemaVersion":"http://datacite.org/schema/kernel-4","source":"mds","isActive":true,"state":"findable","reason":null,"viewCount":0,"downloadCount":0,"referenceCount":0,"citationCount":0,"partCount":0,"partOfCount":0,"versionCount":0,"versionOfCount":0,"created":"2026-02-25T15:31:52Z","registered":"2026-02-25T15:31:52Z","published":null,"updated":"2026-02-25T15:31:52Z"},"relationships":{"client":{"data":{"id":"arxiv.content","type":"clients"}}}},{"id":"10.48550/arxiv.2602.20933","type":"dois","attributes":{"doi":"10.48550/arxiv.2602.20933","identifiers":[{"identifier":"2602.20933","identifierType":"arXiv"}],"creators":[{"nameType":"Personal","givenName":"Shuangkang","familyName":"Fang","name":"Fang, Shuangkang","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"I-Chao","familyName":"Shen","name":"Shen, I-Chao","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Xuanyang","familyName":"Zhang","name":"Zhang, Xuanyang","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Zesheng","familyName":"Wang","name":"Wang, Zesheng","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Yufeng","familyName":"Wang","name":"Wang, Yufeng","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Wenrui","familyName":"Ding","name":"Ding, Wenrui","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Gang","familyName":"Yu","name":"Yu, Gang","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Takeo","familyName":"Igarashi","name":"Igarashi, Takeo","affiliation":[],"nameIdentifiers":[]}],"titles":[{"title":"Dropping Anchor and Spherical Harmonics for Sparse-view Gaussian Splatting"}],"publisher":"arXiv","container":{},"publicationYear":2026,"subjects":[{"subject":"Computer Vision and Pattern Recognition (cs.CV)","lang":"en","subjectScheme":"arXiv"},{"subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"},{"schemeUri":"http://www.oecd.org/science/inno/38235147.pdf","subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"}],"contributors":[],"dates":[{"date":"2026-02-24T14:11:56Z","dateType":"Submitted","dateInformation":"v1"},{"date":"2026-02-25T01:50:38Z","dateType":"Updated","dateInformation":"v1"},{"date":"2026-02","dateType":"Available","dateInformation":"v1"},{"date":"2026","dateType":"Issued"}],"language":null,"types":{"schemaOrg":"CreativeWork","resourceTypeGeneral":"Preprint","citeproc":"article","bibtex":"misc","ris":"GEN","resourceType":"Article"},"relatedIdentifiers":[],"relatedItems":[],"sizes":[],"formats":[],"version":"1","rightsList":[{"rightsIdentifierScheme":"SPDX","rightsUri":"https://creativecommons.org/licenses/by/4.0/legalcode","schemeUri":"https://spdx.org/licenses/","rights":"Creative Commons Attribution 4.0 International","rightsIdentifier":"cc-by-4.0"}],"descriptions":[{"descriptionType":"Abstract","description":"Recent 3D Gaussian Splatting (3DGS) Dropout methods address overfitting under sparse-view conditions by randomly nullifying Gaussian opacities. However, we identify a neighbor compensation effect in these approaches: dropped Gaussians are often compensated by their neighbors, weakening the intended regularization. Moreover, these methods overlook the contribution of high-degree spherical harmonic coefficients (SH) to overfitting. To address these issues, we propose DropAnSH-GS, a novel anchor-based Dropout strategy. Rather than dropping Gaussians independently, our method randomly selects certain Gaussians as anchors and simultaneously removes their spatial neighbors. This effectively disrupts local redundancies near anchors and encourages the model to learn more robust, globally informed representations. Furthermore, we extend the Dropout to color attributes by randomly dropping higher-degree SH to concentrate appearance information in lower-degree SH. This strategy further mitigates overfitting and enables flexible post-training model compression via SH truncation. Experimental results demonstrate that DropAnSH-GS substantially outperforms existing Dropout methods with negligible computational overhead, and can be readily integrated into various 3DGS variants to enhance their performances. Project Website: https://sk-fun.fun/DropAnSH-GS"},{"descriptionType":"Other","description":"Accepted by CVPR 2026"}],"geoLocations":[],"fundingReferences":[],"url":"https://arxiv.org/abs/2602.20933","contentUrl":null,"metadataVersion":0,"schemaVersion":"http://datacite.org/schema/kernel-4","source":"mds","isActive":true,"state":"findable","reason":null,"viewCount":0,"downloadCount":0,"referenceCount":0,"citationCount":0,"partCount":0,"partOfCount":0,"versionCount":0,"versionOfCount":0,"created":"2026-02-25T15:31:49Z","registered":"2026-02-25T15:31:50Z","published":null,"updated":"2026-02-25T15:31:50Z"},"relationships":{"client":{"data":{"id":"arxiv.content","type":"clients"}}}},{"id":"10.48550/arxiv.2602.20932","type":"dois","attributes":{"doi":"10.48550/arxiv.2602.20932","identifiers":[{"identifier":"2602.20932","identifierType":"arXiv"}],"creators":[{"nameType":"Personal","givenName":"Anupam","familyName":"Sharma","name":"Sharma, Anupam","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Harish","familyName":"Katti","name":"Katti, Harish","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Prajwal","familyName":"Singh","name":"Singh, Prajwal","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Shanmuganathan","familyName":"Raman","name":"Raman, Shanmuganathan","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Krishna","familyName":"Miyapuram","name":"Miyapuram, Krishna","affiliation":[],"nameIdentifiers":[]}],"titles":[{"title":"Hierarchic-EEG2Text: Assessing EEG-To-Text Decoding across Hierarchical Abstraction Levels"}],"publisher":"arXiv","container":{},"publicationYear":2026,"subjects":[{"subject":"Machine Learning (cs.LG)","lang":"en","subjectScheme":"arXiv"},{"subject":"Human-Computer Interaction (cs.HC)","lang":"en","subjectScheme":"arXiv"},{"subject":"Signal Processing (eess.SP)","lang":"en","subjectScheme":"arXiv"},{"subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"},{"schemeUri":"http://www.oecd.org/science/inno/38235147.pdf","subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"},{"subject":"FOS: Electrical engineering, electronic engineering, information engineering","subjectScheme":"Fields of Science and Technology (FOS)"},{"schemeUri":"http://www.oecd.org/science/inno/38235147.pdf","subject":"FOS: Electrical engineering, electronic engineering, information engineering","subjectScheme":"Fields of Science and Technology (FOS)"}],"contributors":[],"dates":[{"date":"2026-02-24T14:10:41Z","dateType":"Submitted","dateInformation":"v1"},{"date":"2026-02-25T01:50:36Z","dateType":"Updated","dateInformation":"v1"},{"date":"2026-02","dateType":"Available","dateInformation":"v1"},{"date":"2026","dateType":"Issued"}],"language":null,"types":{"schemaOrg":"CreativeWork","resourceTypeGeneral":"Preprint","citeproc":"article","bibtex":"misc","ris":"GEN","resourceType":"Article"},"relatedIdentifiers":[],"relatedItems":[],"sizes":[],"formats":[],"version":"1","rightsList":[{"rightsIdentifierScheme":"SPDX","rightsUri":"https://creativecommons.org/licenses/by/4.0/legalcode","schemeUri":"https://spdx.org/licenses/","rights":"Creative Commons Attribution 4.0 International","rightsIdentifier":"cc-by-4.0"}],"descriptions":[{"descriptionType":"Abstract","description":"An electroencephalogram (EEG) records the spatially averaged electrical activity of neurons in the brain, measured from the human scalp. Prior studies have explored EEG-based classification of objects or concepts, often for passive viewing of briefly presented image or video stimuli, with limited classes. Because EEG exhibits a low signal-to-noise ratio, recognizing fine-grained representations across a large number of classes remains challenging; however, abstract-level object representations may exist. In this work, we investigate whether EEG captures object representations across multiple hierarchical levels, and propose episodic analysis, in which a Machine Learning (ML) model is evaluated across various, yet related, classification tasks (episodes). Unlike prior episodic EEG studies that rely on fixed or randomly sampled classes of equal cardinality, we adopt hierarchy-aware episode sampling using WordNet to generate episodes with variable classes of diverse hierarchy. We also present the largest episodic framework in the EEG domain for detecting observed text from EEG signals in the PEERS dataset, comprising $931538$ EEG samples under $1610$ object labels, acquired from $264$ human participants (subjects) performing controlled cognitive tasks, enabling the study of neural dynamics underlying perception, decision-making, and performance monitoring.\n We examine how the semantic abstraction level affects classification performance across multiple learning techniques and architectures, providing a comprehensive analysis. The models tend to improve performance when the classification categories are drawn from higher levels of the hierarchy, suggesting sensitivity to abstraction. Our work highlights abstraction depth as an underexplored dimension of EEG decoding and motivates future research in this direction."}],"geoLocations":[],"fundingReferences":[],"url":"https://arxiv.org/abs/2602.20932","contentUrl":null,"metadataVersion":0,"schemaVersion":"http://datacite.org/schema/kernel-4","source":"mds","isActive":true,"state":"findable","reason":null,"viewCount":0,"downloadCount":0,"referenceCount":0,"citationCount":0,"partCount":0,"partOfCount":0,"versionCount":0,"versionOfCount":0,"created":"2026-02-25T15:31:46Z","registered":"2026-02-25T15:31:47Z","published":null,"updated":"2026-02-25T15:31:47Z"},"relationships":{"client":{"data":{"id":"arxiv.content","type":"clients"}}}},{"id":"10.48550/arxiv.2602.20931","type":"dois","attributes":{"doi":"10.48550/arxiv.2602.20931","identifiers":[{"identifier":"2602.20931","identifierType":"arXiv"}],"creators":[{"nameType":"Personal","givenName":"O. P.","familyName":"Ferreira","name":"Ferreira, O. P.","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"D. S.","familyName":"Gonçalves","name":"Gonçalves, D. S.","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"M. S.","familyName":"Louzeiro","name":"Louzeiro, M. S.","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"S. Z.","familyName":"Németh","name":"Németh, S. Z.","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"J.","familyName":"Zhu","name":"Zhu, J.","affiliation":[],"nameIdentifiers":[]}],"titles":[{"title":"A subdifferential characterization via Busemann functions and applications to DC optimization on Hadamard manifolds"}],"publisher":"arXiv","container":{},"publicationYear":2026,"subjects":[{"subject":"Optimization and Control (math.OC)","lang":"en","subjectScheme":"arXiv"},{"subject":"FOS: Mathematics","subjectScheme":"Fields of Science and Technology (FOS)"},{"schemeUri":"http://www.oecd.org/science/inno/38235147.pdf","subject":"FOS: Mathematics","subjectScheme":"Fields of Science and Technology (FOS)"}],"contributors":[],"dates":[{"date":"2026-02-24T14:09:59Z","dateType":"Submitted","dateInformation":"v1"},{"date":"2026-02-25T01:50:35Z","dateType":"Updated","dateInformation":"v1"},{"date":"2026-02","dateType":"Available","dateInformation":"v1"},{"date":"2026","dateType":"Issued"}],"language":null,"types":{"schemaOrg":"CreativeWork","resourceTypeGeneral":"Preprint","citeproc":"article","bibtex":"misc","ris":"GEN","resourceType":"Article"},"relatedIdentifiers":[],"relatedItems":[],"sizes":[],"formats":[],"version":"1","rightsList":[{"rightsUri":"http://arxiv.org/licenses/nonexclusive-distrib/1.0/","rights":"arXiv.org perpetual, non-exclusive license"}],"descriptions":[{"descriptionType":"Abstract","description":"This paper investigates the properties of Busemann functions on Hadamard manifolds and their use in optimization algorithms in Riemannian settings. We present a new Busemann-based characterization of the subdifferential, which is particularly well suited to Riemannian optimization. In the classical Hadamard manifold framework, a subgradient provides a global lower model of a convex function expressed through the inverse exponential map. However, this model may fail to exhibit a useful convexity or concavity structure. By contrast, our characterization yields a concave bounding function by exploiting key properties of Busemann functions. We use this concavity to design and analyze difference-of-convex (DC) optimization methods on Hadamard manifolds. In particular, we reformulate the classical DC algorithm (DCA) for Riemannian contexts and study its convergence properties. We also report preliminary numerical experiments comparing the proposed Busemann DCA, which leads to geodesically convex subproblems, with the classical Riemannian DCA."}],"geoLocations":[],"fundingReferences":[],"url":"https://arxiv.org/abs/2602.20931","contentUrl":null,"metadataVersion":0,"schemaVersion":"http://datacite.org/schema/kernel-4","source":"mds","isActive":true,"state":"findable","reason":null,"viewCount":0,"downloadCount":0,"referenceCount":0,"citationCount":0,"partCount":0,"partOfCount":0,"versionCount":0,"versionOfCount":0,"created":"2026-02-25T15:31:44Z","registered":"2026-02-25T15:31:45Z","published":null,"updated":"2026-02-25T15:31:45Z"},"relationships":{"client":{"data":{"id":"arxiv.content","type":"clients"}}}},{"id":"10.48550/arxiv.2602.20929","type":"dois","attributes":{"doi":"10.48550/arxiv.2602.20929","identifiers":[{"identifier":"2602.20929","identifierType":"arXiv"}],"creators":[{"nameType":"Personal","givenName":"Hirotaka","familyName":"Yoneda","name":"Yoneda, Hirotaka","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Masataka","familyName":"Yoneda","name":"Yoneda, Masataka","affiliation":[],"nameIdentifiers":[]}],"titles":[{"title":"Fair Division with Soft Conflicts"}],"publisher":"arXiv","container":{},"publicationYear":2026,"subjects":[{"subject":"Computer Science and Game Theory (cs.GT)","lang":"en","subjectScheme":"arXiv"},{"subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"},{"schemeUri":"http://www.oecd.org/science/inno/38235147.pdf","subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"}],"contributors":[],"dates":[{"date":"2026-02-24T14:07:51Z","dateType":"Submitted","dateInformation":"v1"},{"date":"2026-02-25T01:50:18Z","dateType":"Updated","dateInformation":"v1"},{"date":"2026-02","dateType":"Available","dateInformation":"v1"},{"date":"2026","dateType":"Issued"}],"language":null,"types":{"schemaOrg":"CreativeWork","resourceTypeGeneral":"Preprint","citeproc":"article","bibtex":"misc","ris":"GEN","resourceType":"Article"},"relatedIdentifiers":[],"relatedItems":[],"sizes":[],"formats":[],"version":"1","rightsList":[{"rightsIdentifierScheme":"SPDX","rightsUri":"https://creativecommons.org/licenses/by/4.0/legalcode","schemeUri":"https://spdx.org/licenses/","rights":"Creative Commons Attribution 4.0 International","rightsIdentifier":"cc-by-4.0"}],"descriptions":[{"descriptionType":"Abstract","description":"We study the fair division of indivisible goods with conflicts between pairs of goods, represented by a graph $G = (V, E)$. We consider ``soft'' conflicts: assigning two adjacent goods to the same agent is allowed, but we seek allocations that are envy-free up to one good (EF1) while keeping the number of such conflict violations small.\n We propose a linear-time algorithm for general additive valuations that finds an EF1 allocation with at most $|E|/n + O(|E|^{1-1/(2n-2)})$ violations, for any constant number of agents $n$. The leading term $|E|/n$ matches the worst-case bound on the number of violations. We use a novel approach that combines an algorithm for fair division with cardinality constraints from Biswas \\\u0026amp; Barman (2018) and a geometric ``closest points'' argument. For identical additive valuations, we also propose a simple round-robin-based algorithm that finds an EF1 allocation with at most $|E|/n$ violations."},{"descriptionType":"Other","description":"16 pages"}],"geoLocations":[],"fundingReferences":[],"url":"https://arxiv.org/abs/2602.20929","contentUrl":null,"metadataVersion":0,"schemaVersion":"http://datacite.org/schema/kernel-4","source":"mds","isActive":true,"state":"findable","reason":null,"viewCount":0,"downloadCount":0,"referenceCount":0,"citationCount":0,"partCount":0,"partOfCount":0,"versionCount":0,"versionOfCount":0,"created":"2026-02-25T15:31:39Z","registered":"2026-02-25T15:31:40Z","published":null,"updated":"2026-02-25T15:31:40Z"},"relationships":{"client":{"data":{"id":"arxiv.content","type":"clients"}}}},{"id":"10.48550/arxiv.2602.20926","type":"dois","attributes":{"doi":"10.48550/arxiv.2602.20926","identifiers":[{"identifier":"2602.20926","identifierType":"arXiv"}],"creators":[{"nameType":"Personal","givenName":"Yuqi","familyName":"Huang","name":"Huang, Yuqi","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Ning","familyName":"Liao","name":"Liao, Ning","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Kai","familyName":"Yang","name":"Yang, Kai","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Anning","familyName":"Hu","name":"Hu, Anning","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Shengchao","familyName":"Hu","name":"Hu, Shengchao","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Xiaoxing","familyName":"Wang","name":"Wang, Xiaoxing","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Junchi","familyName":"Yan","name":"Yan, Junchi","affiliation":[],"nameIdentifiers":[]}],"titles":[{"title":"HELP: HyperNode Expansion and Logical Path-Guided Evidence Localization for Accurate and Efficient GraphRAG"}],"publisher":"arXiv","container":{},"publicationYear":2026,"subjects":[{"subject":"Artificial Intelligence (cs.AI)","lang":"en","subjectScheme":"arXiv"},{"subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"},{"schemeUri":"http://www.oecd.org/science/inno/38235147.pdf","subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"}],"contributors":[],"dates":[{"date":"2026-02-24T14:05:29Z","dateType":"Submitted","dateInformation":"v1"},{"date":"2026-02-25T01:50:12Z","dateType":"Updated","dateInformation":"v1"},{"date":"2026-02","dateType":"Available","dateInformation":"v1"},{"date":"2026","dateType":"Issued"}],"language":null,"types":{"schemaOrg":"CreativeWork","resourceTypeGeneral":"Preprint","citeproc":"article","bibtex":"misc","ris":"GEN","resourceType":"Article"},"relatedIdentifiers":[],"relatedItems":[],"sizes":[],"formats":[],"version":"1","rightsList":[{"rightsUri":"http://arxiv.org/licenses/nonexclusive-distrib/1.0/","rights":"arXiv.org perpetual, non-exclusive license"}],"descriptions":[{"descriptionType":"Abstract","description":"Large Language Models (LLMs) often struggle with inherent knowledge boundaries and hallucinations, limiting their reliability in knowledge-intensive tasks. While Retrieval-Augmented Generation (RAG) mitigates these issues, it frequently overlooks structural interdependencies essential for multi-hop reasoning. Graph-based RAG approaches attempt to bridge this gap, yet they typically face trade-offs between accuracy and efficiency due to challenges such as costly graph traversals and semantic noise in LLM-generated summaries. In this paper, we propose HyperNode Expansion and Logical Path-Guided Evidence Localization strategies for GraphRAG (HELP), a novel framework designed to balance accuracy with practical efficiency through two core strategies: 1) HyperNode Expansion, which iteratively chains knowledge triplets into coherent reasoning paths abstracted as HyperNodes to capture complex structural dependencies and ensure retrieval accuracy; and 2) Logical Path-Guided Evidence Localization, which leverages precomputed graph-text correlations to map these paths directly to the corpus for superior efficiency. HELP avoids expensive random walks and semantic distortion, preserving knowledge integrity while drastically reducing retrieval latency. Extensive experiments demonstrate that HELP achieves competitive performance across multiple simple and multi-hop QA benchmarks and up to a 28.8$\\times$ speedup over leading Graph-based RAG baselines."}],"geoLocations":[],"fundingReferences":[],"url":"https://arxiv.org/abs/2602.20926","contentUrl":null,"metadataVersion":0,"schemaVersion":"http://datacite.org/schema/kernel-4","source":"mds","isActive":true,"state":"findable","reason":null,"viewCount":0,"downloadCount":0,"referenceCount":0,"citationCount":0,"partCount":0,"partOfCount":0,"versionCount":0,"versionOfCount":0,"created":"2026-02-25T15:31:32Z","registered":"2026-02-25T15:31:32Z","published":null,"updated":"2026-02-25T15:31:32Z"},"relationships":{"client":{"data":{"id":"arxiv.content","type":"clients"}}}},{"id":"10.48550/arxiv.2602.20925","type":"dois","attributes":{"doi":"10.48550/arxiv.2602.20925","identifiers":[{"identifier":"2602.20925","identifierType":"arXiv"}],"creators":[{"nameType":"Personal","givenName":"Zeyu","familyName":"Jiang","name":"Jiang, Zeyu","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Kuan","familyName":"Xu","name":"Xu, Kuan","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Changhao","familyName":"Chen","name":"Chen, Changhao","affiliation":[],"nameIdentifiers":[]}],"titles":[{"title":"LST-SLAM: A Stereo Thermal SLAM System for Kilometer-Scale Dynamic Environments"}],"publisher":"arXiv","container":{},"publicationYear":2026,"subjects":[{"subject":"Robotics (cs.RO)","lang":"en","subjectScheme":"arXiv"},{"subject":"Computer Vision and Pattern Recognition (cs.CV)","lang":"en","subjectScheme":"arXiv"},{"subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"},{"schemeUri":"http://www.oecd.org/science/inno/38235147.pdf","subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"}],"contributors":[],"dates":[{"date":"2026-02-24T14:04:54Z","dateType":"Submitted","dateInformation":"v1"},{"date":"2026-02-25T01:50:09Z","dateType":"Updated","dateInformation":"v1"},{"date":"2026-02","dateType":"Available","dateInformation":"v1"},{"date":"2026","dateType":"Issued"}],"language":null,"types":{"schemaOrg":"CreativeWork","resourceTypeGeneral":"Preprint","citeproc":"article","bibtex":"misc","ris":"GEN","resourceType":"Article"},"relatedIdentifiers":[],"relatedItems":[],"sizes":[],"formats":[],"version":"1","rightsList":[{"rightsIdentifierScheme":"SPDX","rightsUri":"https://creativecommons.org/licenses/by/4.0/legalcode","schemeUri":"https://spdx.org/licenses/","rights":"Creative Commons Attribution 4.0 International","rightsIdentifier":"cc-by-4.0"}],"descriptions":[{"descriptionType":"Abstract","description":"Thermal cameras offer strong potential for robot perception under challenging illumination and weather conditions. However, thermal Simultaneous Localization and Mapping (SLAM) remains difficult due to unreliable feature extraction, unstable motion tracking, and inconsistent global pose and map construction, particularly in dynamic large-scale outdoor environments. To address these challenges, we propose LST-SLAM, a novel large-scale stereo thermal SLAM system that achieves robust performance in complex, dynamic scenes. Our approach combines self-supervised thermal feature learning, stereo dual-level motion tracking, and geometric pose optimization. We also introduce a semantic-geometric hybrid constraint that suppresses potentially dynamic features lacking strong inter-frame geometric consistency. Furthermore, we develop an online incremental bag-of-words model for loop closure detection, coupled with global pose optimization to mitigate accumulated drift. Extensive experiments on kilometer-scale dynamic thermal datasets show that LST-SLAM significantly outperforms recent representative SLAM systems, including AirSLAM and DROID-SLAM, in both robustness and accuracy."},{"descriptionType":"Other","description":"ICRA 2026"}],"geoLocations":[],"fundingReferences":[],"url":"https://arxiv.org/abs/2602.20925","contentUrl":null,"metadataVersion":0,"schemaVersion":"http://datacite.org/schema/kernel-4","source":"mds","isActive":true,"state":"findable","reason":null,"viewCount":0,"downloadCount":0,"referenceCount":0,"citationCount":0,"partCount":0,"partOfCount":0,"versionCount":0,"versionOfCount":0,"created":"2026-02-25T15:31:29Z","registered":"2026-02-25T15:31:30Z","published":null,"updated":"2026-02-25T15:31:30Z"},"relationships":{"client":{"data":{"id":"arxiv.content","type":"clients"}}}},{"id":"10.48550/arxiv.2602.20924","type":"dois","attributes":{"doi":"10.48550/arxiv.2602.20924","identifiers":[{"identifier":"2602.20924","identifierType":"arXiv"}],"creators":[{"nameType":"Personal","givenName":"Alagappan","familyName":"Ramanathan","name":"Ramanathan, Alagappan","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Eunju","familyName":"Kang","name":"Kang, Eunju","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Dongsu","familyName":"Han","name":"Han, Dongsu","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Sangeetha Abdu","familyName":"Jyothi","name":"Jyothi, Sangeetha Abdu","affiliation":[],"nameIdentifiers":[]}],"titles":[{"title":"Airavat: An Agentic Framework for Internet Measurement"}],"publisher":"arXiv","container":{},"publicationYear":2026,"subjects":[{"subject":"Networking and Internet Architecture (cs.NI)","lang":"en","subjectScheme":"arXiv"},{"subject":"Artificial Intelligence (cs.AI)","lang":"en","subjectScheme":"arXiv"},{"subject":"Software Engineering (cs.SE)","lang":"en","subjectScheme":"arXiv"},{"subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"},{"schemeUri":"http://www.oecd.org/science/inno/38235147.pdf","subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"}],"contributors":[],"dates":[{"date":"2026-02-24T14:04:18Z","dateType":"Submitted","dateInformation":"v1"},{"date":"2026-02-25T01:50:07Z","dateType":"Updated","dateInformation":"v1"},{"date":"2026-02","dateType":"Available","dateInformation":"v1"},{"date":"2026","dateType":"Issued"}],"language":null,"types":{"schemaOrg":"CreativeWork","resourceTypeGeneral":"Preprint","citeproc":"article","bibtex":"misc","ris":"GEN","resourceType":"Article"},"relatedIdentifiers":[],"relatedItems":[],"sizes":[],"formats":[],"version":"1","rightsList":[{"rightsIdentifierScheme":"SPDX","rightsUri":"https://creativecommons.org/licenses/by/4.0/legalcode","schemeUri":"https://spdx.org/licenses/","rights":"Creative Commons Attribution 4.0 International","rightsIdentifier":"cc-by-4.0"}],"descriptions":[{"descriptionType":"Abstract","description":"Internet measurement faces twin challenges: complex analyses require expert-level orchestration of tools, yet even syntactically correct implementations can have methodological flaws and can be difficult to verify. Democratizing measurement capabilities thus demands automating both workflow generation and verification against methodological standards established through decades of research.\n We present Airavat, the first agentic framework for Internet measurement workflow generation with systematic verification and validation. Airavat coordinates a set of agents mirroring expert reasoning: three agents handle problem decomposition, solution design, and code implementation, with assistance from a registry of existing tools. Two specialized engines ensure methodological correctness: a Verification Engine evaluates workflows against a knowledge graph encoding five decades of measurement research, while a Validation Engine identifies appropriate validation techniques grounded in established methodologies. Through four Internet measurement case studies, we demonstrate that Airavat (i) generates workflows matching expert-level solutions, (ii) makes sound architectural decisions, (iii) addresses novel problems without ground truth, and (iv) identifies methodological flaws missed by standard execution-based testing."}],"geoLocations":[],"fundingReferences":[],"url":"https://arxiv.org/abs/2602.20924","contentUrl":null,"metadataVersion":0,"schemaVersion":"http://datacite.org/schema/kernel-4","source":"mds","isActive":true,"state":"findable","reason":null,"viewCount":0,"downloadCount":0,"referenceCount":0,"citationCount":0,"partCount":0,"partOfCount":0,"versionCount":0,"versionOfCount":0,"created":"2026-02-25T15:31:27Z","registered":"2026-02-25T15:31:27Z","published":null,"updated":"2026-02-25T15:31:27Z"},"relationships":{"client":{"data":{"id":"arxiv.content","type":"clients"}}}},{"id":"10.48550/arxiv.2602.20923","type":"dois","attributes":{"doi":"10.48550/arxiv.2602.20923","identifiers":[{"identifier":"2602.20923","identifierType":"arXiv"}],"creators":[{"nameType":"Personal","givenName":"Jiarong","familyName":"Wei","name":"Wei, Jiarong","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Anna","familyName":"Rehr","name":"Rehr, Anna","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Christian","familyName":"Feist","name":"Feist, Christian","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Abhinav","familyName":"Valada","name":"Valada, Abhinav","affiliation":[],"nameIdentifiers":[]}],"titles":[{"title":"ParkDiffusion++: Ego Intention Conditioned Joint Multi-Agent Trajectory Prediction for Automated Parking using Diffusion Models"}],"publisher":"arXiv","container":{},"publicationYear":2026,"subjects":[{"subject":"Robotics (cs.RO)","lang":"en","subjectScheme":"arXiv"},{"subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"},{"schemeUri":"http://www.oecd.org/science/inno/38235147.pdf","subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"}],"contributors":[],"dates":[{"date":"2026-02-24T14:01:33Z","dateType":"Submitted","dateInformation":"v1"},{"date":"2026-02-25T01:50:06Z","dateType":"Updated","dateInformation":"v1"},{"date":"2026-02","dateType":"Available","dateInformation":"v1"},{"date":"2026","dateType":"Issued"}],"language":null,"types":{"schemaOrg":"CreativeWork","resourceTypeGeneral":"Preprint","citeproc":"article","bibtex":"misc","ris":"GEN","resourceType":"Article"},"relatedIdentifiers":[],"relatedItems":[],"sizes":[],"formats":[],"version":"1","rightsList":[{"rightsUri":"http://arxiv.org/licenses/nonexclusive-distrib/1.0/","rights":"arXiv.org perpetual, non-exclusive license"}],"descriptions":[{"descriptionType":"Abstract","description":"Automated parking is a challenging operational domain for advanced driver assistance systems, requiring robust scene understanding and interaction reasoning. The key challenge is twofold: (i) predict multiple plausible ego intentions according to context and (ii) for each intention, predict the joint responses of surrounding agents, enabling effective what-if decision-making. However, existing methods often fall short, typically treating these interdependent problems in isolation. We propose ParkDiffusion++, which jointly learns a multi-modal ego intention predictor and an ego-conditioned multi-agent joint trajectory predictor for automated parking. Our approach makes several key contributions. First, we introduce an ego intention tokenizer that predicts a small set of discrete endpoint intentions from agent histories and vectorized map polylines. Second, we perform ego-intention-conditioned joint prediction, yielding socially consistent predictions of the surrounding agents for each possible ego intention. Third, we employ a lightweight safety-guided denoiser with different constraints to refine joint scenes during training, thus improving accuracy and safety. Fourth, we propose counterfactual knowledge distillation, where an EMA teacher refined by a frozen safety-guided denoiser provides pseudo-targets that capture how agents react to alternative ego intentions. Extensive evaluations demonstrate that ParkDiffusion++ achieves state-of-the-art performance on the Dragon Lake Parking (DLP) dataset and the Intersections Drone (inD) dataset. Importantly, qualitative what-if visualizations show that other agents react appropriately to different ego intentions."},{"descriptionType":"Other","description":"ICRA 2026 Camera Ready Version"}],"geoLocations":[],"fundingReferences":[],"url":"https://arxiv.org/abs/2602.20923","contentUrl":null,"metadataVersion":0,"schemaVersion":"http://datacite.org/schema/kernel-4","source":"mds","isActive":true,"state":"findable","reason":null,"viewCount":0,"downloadCount":0,"referenceCount":0,"citationCount":0,"partCount":0,"partOfCount":0,"versionCount":0,"versionOfCount":0,"created":"2026-02-25T15:31:24Z","registered":"2026-02-25T15:31:25Z","published":null,"updated":"2026-02-25T15:31:25Z"},"relationships":{"client":{"data":{"id":"arxiv.content","type":"clients"}}}},{"id":"10.48550/arxiv.2602.20922","type":"dois","attributes":{"doi":"10.48550/arxiv.2602.20922","identifiers":[{"identifier":"2602.20922","identifierType":"arXiv"}],"creators":[{"nameType":"Personal","givenName":"Daniel","familyName":"Bath","name":"Bath, Daniel","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Willem","familyName":"Veys","name":"Veys, Willem","affiliation":[],"nameIdentifiers":[]}],"titles":[{"title":"The Strong Monodromy Conjecture for a class of homogeneous polynomials in three variables"}],"publisher":"arXiv","container":{},"publicationYear":2026,"subjects":[{"subject":"Algebraic Geometry (math.AG)","lang":"en","subjectScheme":"arXiv"},{"subject":"Commutative Algebra (math.AC)","lang":"en","subjectScheme":"arXiv"},{"subject":"FOS: Mathematics","subjectScheme":"Fields of Science and Technology (FOS)"},{"schemeUri":"http://www.oecd.org/science/inno/38235147.pdf","subject":"FOS: Mathematics","subjectScheme":"Fields of Science and Technology (FOS)"},{"subject":"Primary: 14F10, 14E18","lang":"en","subjectScheme":"MSC"}],"contributors":[],"dates":[{"date":"2026-02-24T14:00:29Z","dateType":"Submitted","dateInformation":"v1"},{"date":"2026-02-25T01:50:05Z","dateType":"Updated","dateInformation":"v1"},{"date":"2026-02","dateType":"Available","dateInformation":"v1"},{"date":"2026","dateType":"Issued"}],"language":null,"types":{"schemaOrg":"CreativeWork","resourceTypeGeneral":"Preprint","citeproc":"article","bibtex":"misc","ris":"GEN","resourceType":"Article"},"relatedIdentifiers":[],"relatedItems":[],"sizes":[],"formats":[],"version":"1","rightsList":[{"rightsUri":"http://arxiv.org/licenses/nonexclusive-distrib/1.0/","rights":"arXiv.org perpetual, non-exclusive license"}],"descriptions":[{"descriptionType":"Abstract","description":"We consider the class of all homogeneous, possibly non-reduced, polynomials $f$ whose associated reduced projective divisor $D_{\\text{red}} \\subset \\mathbb{P}^{n-1}$ has (at worst) quasi-homogeneous isolated singularities. In an arbitrary number of variables $n$ and with $d$ denoting the degree of $f$, we characterize when $-n/d$ is a root of the Bernstein--Sato polynomial of $f$ in terms of elementary data involving logarithmic derivations. When we restrict to three variables, we prove the resulting class of polynomials satisfies the Strong Monodromy Conjecture, in the motivic sense."}],"geoLocations":[],"fundingReferences":[],"url":"https://arxiv.org/abs/2602.20922","contentUrl":null,"metadataVersion":0,"schemaVersion":"http://datacite.org/schema/kernel-4","source":"mds","isActive":true,"state":"findable","reason":null,"viewCount":0,"downloadCount":0,"referenceCount":0,"citationCount":0,"partCount":0,"partOfCount":0,"versionCount":0,"versionOfCount":0,"created":"2026-02-25T15:31:21Z","registered":"2026-02-25T15:31:22Z","published":null,"updated":"2026-02-25T15:31:22Z"},"relationships":{"client":{"data":{"id":"arxiv.content","type":"clients"}}}},{"id":"10.48550/arxiv.2602.20921","type":"dois","attributes":{"doi":"10.48550/arxiv.2602.20921","identifiers":[{"identifier":"2602.20921","identifierType":"arXiv"}],"creators":[{"nameType":"Personal","givenName":"Jinshu","familyName":"Huang","name":"Huang, Jinshu","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Mingfei","familyName":"Sun","name":"Sun, Mingfei","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Chunlin","familyName":"Wu","name":"Wu, Chunlin","affiliation":[],"nameIdentifiers":[]}],"titles":[{"title":"On the Generalization Behavior of Deep Residual Networks From a Dynamical System Perspective"}],"publisher":"arXiv","container":{},"publicationYear":2026,"subjects":[{"subject":"Machine Learning (cs.LG)","lang":"en","subjectScheme":"arXiv"},{"subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"},{"schemeUri":"http://www.oecd.org/science/inno/38235147.pdf","subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"}],"contributors":[],"dates":[{"date":"2026-02-24T13:59:06Z","dateType":"Submitted","dateInformation":"v1"},{"date":"2026-02-25T01:50:04Z","dateType":"Updated","dateInformation":"v1"},{"date":"2026-02","dateType":"Available","dateInformation":"v1"},{"date":"2026","dateType":"Issued"}],"language":null,"types":{"schemaOrg":"CreativeWork","resourceTypeGeneral":"Preprint","citeproc":"article","bibtex":"misc","ris":"GEN","resourceType":"Article"},"relatedIdentifiers":[],"relatedItems":[],"sizes":[],"formats":[],"version":"1","rightsList":[{"rightsUri":"http://arxiv.org/licenses/nonexclusive-distrib/1.0/","rights":"arXiv.org perpetual, non-exclusive license"}],"descriptions":[{"descriptionType":"Abstract","description":"Deep neural networks (DNNs) have significantly advanced machine learning, with model depth playing a central role in their successes. The dynamical system modeling approach has recently emerged as a powerful framework, offering new mathematical insights into the structure and learning behavior of DNNs. In this work, we establish generalization error bounds for both discrete- and continuous-time residual networks (ResNets) by combining Rademacher complexity, flow maps of dynamical systems, and the convergence behavior of ResNets in the deep-layer limit. The resulting bounds are of order $O(1/\\sqrt{S})$ with respect to the number of training samples $S$, and include a structure-dependent negative term, yielding depth-uniform and asymptotic generalization bounds under milder assumptions. These findings provide a unified understanding of generalization across both discrete- and continuous-time ResNets, helping to close the gap in both the order of sample complexity and assumptions between the discrete- and continuous-time settings."}],"geoLocations":[],"fundingReferences":[],"url":"https://arxiv.org/abs/2602.20921","contentUrl":null,"metadataVersion":0,"schemaVersion":"http://datacite.org/schema/kernel-4","source":"mds","isActive":true,"state":"findable","reason":null,"viewCount":0,"downloadCount":0,"referenceCount":0,"citationCount":0,"partCount":0,"partOfCount":0,"versionCount":0,"versionOfCount":0,"created":"2026-02-25T15:31:19Z","registered":"2026-02-25T15:31:20Z","published":null,"updated":"2026-02-25T15:31:20Z"},"relationships":{"client":{"data":{"id":"arxiv.content","type":"clients"}}}},{"id":"10.48550/arxiv.2602.20920","type":"dois","attributes":{"doi":"10.48550/arxiv.2602.20920","identifiers":[{"identifier":"2602.20920","identifierType":"arXiv"}],"creators":[{"nameType":"Personal","givenName":"Daniel","familyName":"Huczala","name":"Huczala, Daniel","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Severinas","familyName":"Zube","name":"Zube, Severinas","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Martin","familyName":"Pfurner","name":"Pfurner, Martin","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Johannes","familyName":"Siegele","name":"Siegele, Johannes","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Frank C.","familyName":"Park","name":"Park, Frank C.","affiliation":[],"nameIdentifiers":[]}],"titles":[{"title":"Computer-Aided Design of Rational Motions for 4R and 6R Spatial Mechanism Synthesis"}],"publisher":"arXiv","container":{},"publicationYear":2026,"subjects":[{"subject":"Robotics (cs.RO)","lang":"en","subjectScheme":"arXiv"},{"subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"},{"schemeUri":"http://www.oecd.org/science/inno/38235147.pdf","subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"}],"contributors":[],"dates":[{"date":"2026-02-24T13:58:36Z","dateType":"Submitted","dateInformation":"v1"},{"date":"2026-02-25T01:50:03Z","dateType":"Updated","dateInformation":"v1"},{"date":"2026-02","dateType":"Available","dateInformation":"v1"},{"date":"2026","dateType":"Issued"}],"language":null,"types":{"schemaOrg":"CreativeWork","resourceTypeGeneral":"Preprint","citeproc":"article","bibtex":"misc","ris":"GEN","resourceType":"Article"},"relatedIdentifiers":[],"relatedItems":[],"sizes":[],"formats":[],"version":"1","rightsList":[{"rightsUri":"http://arxiv.org/licenses/nonexclusive-distrib/1.0/","rights":"arXiv.org perpetual, non-exclusive license"}],"descriptions":[{"descriptionType":"Abstract","description":"This paper focuses on geometric methods for generating rational motions used in the design of single-loop rational linkages, 1-degree-of-freedom mechanisms that can execute prescribed spatial tasks. Building on established rational motion synthesis methods, we introduce a new interpolation scheme for seven 3D points based on cubic quaternionic Bezier curves. The resulting motion admits factorization, i.e. the synthesis of a spatial six-bar mechanism whose tool frame passes the specified seven points. To support engineering practice, we provide open-source CAD tools that implement also the other methods and provide fast visual evaluation of motion generation and mechanism synthesis."}],"geoLocations":[],"fundingReferences":[],"url":"https://arxiv.org/abs/2602.20920","contentUrl":null,"metadataVersion":0,"schemaVersion":"http://datacite.org/schema/kernel-4","source":"mds","isActive":true,"state":"findable","reason":null,"viewCount":0,"downloadCount":0,"referenceCount":0,"citationCount":0,"partCount":0,"partOfCount":0,"versionCount":0,"versionOfCount":0,"created":"2026-02-25T15:31:16Z","registered":"2026-02-25T15:31:17Z","published":null,"updated":"2026-02-25T15:31:17Z"},"relationships":{"client":{"data":{"id":"arxiv.content","type":"clients"}}}},{"id":"10.48550/arxiv.2602.20918","type":"dois","attributes":{"doi":"10.48550/arxiv.2602.20918","identifiers":[{"identifier":"2602.20918","identifierType":"arXiv"}],"creators":[{"nameType":"Personal","givenName":"Hyewon","familyName":"Jang","name":"Jang, Hyewon","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Nikolai","familyName":"Ilinykh","name":"Ilinykh, Nikolai","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Sharid","familyName":"Loáiciga","name":"Loáiciga, Sharid","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Jey Han","familyName":"Lau","name":"Lau, Jey Han","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Shalom","familyName":"Lappin","name":"Lappin, Shalom","affiliation":[],"nameIdentifiers":[]}],"titles":[{"title":"Predicting Sentence Acceptability Judgments in Multimodal Contexts"}],"publisher":"arXiv","container":{},"publicationYear":2026,"subjects":[{"subject":"Artificial Intelligence (cs.AI)","lang":"en","subjectScheme":"arXiv"},{"subject":"Computation and Language (cs.CL)","lang":"en","subjectScheme":"arXiv"},{"subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"},{"schemeUri":"http://www.oecd.org/science/inno/38235147.pdf","subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"}],"contributors":[],"dates":[{"date":"2026-02-24T13:54:38Z","dateType":"Submitted","dateInformation":"v1"},{"date":"2026-02-25T01:49:49Z","dateType":"Updated","dateInformation":"v1"},{"date":"2026-02","dateType":"Available","dateInformation":"v1"},{"date":"2026","dateType":"Issued"}],"language":null,"types":{"schemaOrg":"CreativeWork","resourceTypeGeneral":"Preprint","citeproc":"article","bibtex":"misc","ris":"GEN","resourceType":"Article"},"relatedIdentifiers":[],"relatedItems":[],"sizes":[],"formats":[],"version":"1","rightsList":[{"rightsIdentifierScheme":"SPDX","rightsUri":"https://creativecommons.org/licenses/by-nc-sa/4.0/legalcode","schemeUri":"https://spdx.org/licenses/","rights":"Creative Commons Attribution Non Commercial Share Alike 4.0 International","rightsIdentifier":"cc-by-nc-sa-4.0"}],"descriptions":[{"descriptionType":"Abstract","description":"Previous work has examined the capacity of deep neural networks (DNNs), particularly transformers, to predict human sentence acceptability judgments, both independently of context, and in document contexts. We consider the effect of prior exposure to visual images (i.e., visual context) on these judgments for humans and large language models (LLMs). Our results suggest that, in contrast to textual context, visual images appear to have little if any impact on human acceptability ratings. However, LLMs display the compression effect seen in previous work on human judgments in document contexts. Different sorts of LLMs are able to predict human acceptability judgments to a high degree of accuracy, but in general, their performance is slightly better when visual contexts are removed. Moreover, the distribution of LLM judgments varies among models, with Qwen resembling human patterns, and others diverging from them. LLM-generated predictions on sentence acceptability are highly correlated with their normalised log probabilities in general. However, the correlations decrease when visual contexts are present, suggesting that a higher gap exists between the internal representations of LLMs and their generated predictions in the presence of visual contexts. Our experimental work suggests interesting points of similarity and of difference between human and LLM processing of sentences in multimodal contexts."}],"geoLocations":[],"fundingReferences":[],"url":"https://arxiv.org/abs/2602.20918","contentUrl":null,"metadataVersion":0,"schemaVersion":"http://datacite.org/schema/kernel-4","source":"mds","isActive":true,"state":"findable","reason":null,"viewCount":0,"downloadCount":0,"referenceCount":0,"citationCount":0,"partCount":0,"partOfCount":0,"versionCount":0,"versionOfCount":0,"created":"2026-02-25T15:31:11Z","registered":"2026-02-25T15:31:12Z","published":null,"updated":"2026-02-25T15:31:12Z"},"relationships":{"client":{"data":{"id":"arxiv.content","type":"clients"}}}},{"id":"10.48550/arxiv.2602.20916","type":"dois","attributes":{"doi":"10.48550/arxiv.2602.20916","identifiers":[{"identifier":"2602.20916","identifierType":"arXiv"}],"creators":[{"nameType":"Personal","givenName":"Martin","familyName":"Lopez-Corredoira","name":"Lopez-Corredoira, Martin","affiliation":[],"nameIdentifiers":[]}],"titles":[{"title":"Constraints on CMBR flux due to high-z dust emission"}],"publisher":"arXiv","container":{},"publicationYear":2026,"subjects":[{"subject":"Cosmology and Nongalactic Astrophysics (astro-ph.CO)","lang":"en","subjectScheme":"arXiv"},{"subject":"Astrophysics of Galaxies (astro-ph.GA)","lang":"en","subjectScheme":"arXiv"},{"subject":"FOS: Physical sciences","subjectScheme":"Fields of Science and Technology (FOS)"},{"schemeUri":"http://www.oecd.org/science/inno/38235147.pdf","subject":"FOS: Physical sciences","subjectScheme":"Fields of Science and Technology (FOS)"}],"contributors":[],"dates":[{"date":"2026-02-24T13:52:52Z","dateType":"Submitted","dateInformation":"v1"},{"date":"2026-02-25T01:49:44Z","dateType":"Updated","dateInformation":"v1"},{"date":"2026-02","dateType":"Available","dateInformation":"v1"},{"date":"2026","dateType":"Issued"}],"language":null,"types":{"schemaOrg":"CreativeWork","resourceTypeGeneral":"Preprint","citeproc":"article","bibtex":"misc","ris":"GEN","resourceType":"Article"},"relatedIdentifiers":[],"relatedItems":[],"sizes":[],"formats":[],"version":"1","rightsList":[{"rightsUri":"http://arxiv.org/licenses/nonexclusive-distrib/1.0/","rights":"arXiv.org perpetual, non-exclusive license"}],"descriptions":[{"descriptionType":"Abstract","description":"Gjergo \u0026amp; Kroupa (2025) have proposed a new foreground CMBR component produced by dust associated with the progenitor clouds at $z=15-20$ that led to the formation of massive early-type galaxies, calculating that a minimum of 1.4% and a maximum of 100% of the whole CMBR radiation would be produced by this mechanism. Here, I check how much dust emission is compatible with the spectrum of the CMBR monopole flux measurements within the corresponding errors. COBE-FIRAS monopole is fitted to different models with different dust emissivity spectral indexes ($β$) and dispersion of redshifts of the progenitor clouds ($σ_d$). Within the realistic values of $β\\ge 0.5$, $σ_d\\ge 0.8$, the contamination of CMBR flux by high $z$ dust should be $\u0026lt;1.3$% (95% CL)."},{"descriptionType":"Other","description":"3 pages, accepted for publication in Research Notes of the AAS"}],"geoLocations":[],"fundingReferences":[],"url":"https://arxiv.org/abs/2602.20916","contentUrl":null,"metadataVersion":0,"schemaVersion":"http://datacite.org/schema/kernel-4","source":"mds","isActive":true,"state":"findable","reason":null,"viewCount":0,"downloadCount":0,"referenceCount":0,"citationCount":0,"partCount":0,"partOfCount":0,"versionCount":0,"versionOfCount":0,"created":"2026-02-25T15:31:06Z","registered":"2026-02-25T15:31:07Z","published":null,"updated":"2026-02-25T15:31:07Z"},"relationships":{"client":{"data":{"id":"arxiv.content","type":"clients"}}}},{"id":"10.48550/arxiv.2602.20915","type":"dois","attributes":{"doi":"10.48550/arxiv.2602.20915","identifiers":[{"identifier":"2602.20915","identifierType":"arXiv"}],"creators":[{"nameType":"Personal","givenName":"Dimitrios","familyName":"Dimou","name":"Dimou, Dimitrios","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"José","familyName":"Santos-Victor","name":"Santos-Victor, José","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Plinio","familyName":"Moreno","name":"Moreno, Plinio","affiliation":[],"nameIdentifiers":[]}],"titles":[{"title":"Task-oriented grasping for dexterous robots using postural synergies and reinforcement learning"}],"publisher":"arXiv","container":{},"publicationYear":2026,"subjects":[{"subject":"Robotics (cs.RO)","lang":"en","subjectScheme":"arXiv"},{"subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"},{"schemeUri":"http://www.oecd.org/science/inno/38235147.pdf","subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"}],"contributors":[],"dates":[{"date":"2026-02-24T13:51:09Z","dateType":"Submitted","dateInformation":"v1"},{"date":"2026-02-25T01:49:39Z","dateType":"Updated","dateInformation":"v1"},{"date":"2026-02","dateType":"Available","dateInformation":"v1"},{"date":"2026","dateType":"Issued"}],"language":null,"types":{"schemaOrg":"CreativeWork","resourceTypeGeneral":"Preprint","citeproc":"article","bibtex":"misc","ris":"GEN","resourceType":"Article"},"relatedIdentifiers":[],"relatedItems":[],"sizes":[],"formats":[],"version":"1","rightsList":[{"rightsIdentifierScheme":"SPDX","rightsUri":"https://creativecommons.org/licenses/by/4.0/legalcode","schemeUri":"https://spdx.org/licenses/","rights":"Creative Commons Attribution 4.0 International","rightsIdentifier":"cc-by-4.0"}],"descriptions":[{"descriptionType":"Abstract","description":"In this paper, we address the problem of task-oriented grasping for humanoid robots, emphasizing the need to align with human social norms and task-specific objectives. Existing methods, employ a variety of open-loop and closed-loop approaches but lack an end-to-end solution that can grasp several objects while taking into account the downstream task's constraints. Our proposed approach employs reinforcement learning to enhance task-oriented grasping, prioritizing the post-grasp intention of the agent. We extract human grasp preferences from the ContactPose dataset, and train a hand synergy model based on the Variational Autoencoder (VAE) to imitate the participant's grasping actions. Based on this data, we train an agent able to grasp multiple objects while taking into account distinct post-grasp intentions that are task-specific. By combining data-driven insights from human grasping behavior with learning by exploration provided by reinforcement learning, we can develop humanoid robots capable of context-aware manipulation actions, facilitating collaboration in human-centered environments."}],"geoLocations":[],"fundingReferences":[],"url":"https://arxiv.org/abs/2602.20915","contentUrl":null,"metadataVersion":0,"schemaVersion":"http://datacite.org/schema/kernel-4","source":"mds","isActive":true,"state":"findable","reason":null,"viewCount":0,"downloadCount":0,"referenceCount":0,"citationCount":0,"partCount":0,"partOfCount":0,"versionCount":0,"versionOfCount":0,"created":"2026-02-25T15:31:04Z","registered":"2026-02-25T15:31:05Z","published":null,"updated":"2026-02-25T15:31:05Z"},"relationships":{"client":{"data":{"id":"arxiv.content","type":"clients"}}}},{"id":"10.48550/arxiv.2602.20914","type":"dois","attributes":{"doi":"10.48550/arxiv.2602.20914","identifiers":[{"identifier":"2602.20914","identifierType":"arXiv"}],"creators":[{"nameType":"Personal","givenName":"Mario Sánchez","familyName":"Sanz","name":"Sanz, Mario Sánchez","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Antonio L.","familyName":"Sánchez","name":"Sánchez, Antonio L.","affiliation":[],"nameIdentifiers":[]}],"titles":[{"title":"Advection-modulated gaseous diffusion through an orifice"}],"publisher":"arXiv","container":{},"publicationYear":2026,"subjects":[{"subject":"Fluid Dynamics (physics.flu-dyn)","lang":"en","subjectScheme":"arXiv"},{"subject":"FOS: Physical sciences","subjectScheme":"Fields of Science and Technology (FOS)"},{"schemeUri":"http://www.oecd.org/science/inno/38235147.pdf","subject":"FOS: Physical sciences","subjectScheme":"Fields of Science and Technology (FOS)"}],"contributors":[],"dates":[{"date":"2026-02-24T13:50:11Z","dateType":"Submitted","dateInformation":"v1"},{"date":"2026-02-25T01:49:37Z","dateType":"Updated","dateInformation":"v1"},{"date":"2026-02","dateType":"Available","dateInformation":"v1"},{"date":"2026","dateType":"Issued"}],"language":null,"types":{"schemaOrg":"CreativeWork","resourceTypeGeneral":"Preprint","citeproc":"article","bibtex":"misc","ris":"GEN","resourceType":"Article"},"relatedIdentifiers":[],"relatedItems":[],"sizes":[],"formats":[],"version":"1","rightsList":[{"rightsIdentifierScheme":"SPDX","rightsUri":"https://creativecommons.org/licenses/by-nc-nd/4.0/legalcode","schemeUri":"https://spdx.org/licenses/","rights":"Creative Commons Attribution Non Commercial No Derivatives 4.0 International","rightsIdentifier":"cc-by-nc-nd-4.0"}],"descriptions":[{"descriptionType":"Abstract","description":"We examine flow and transport through an orifice in a flat wall separating semi-infinite atmospheres of two dissimilar gases. The analysis assumes steady conditions and order-unity values of the Schmidt number Sc and Péclet number Pe, such that advection and diffusion contribute comparably to mass and momentum transport. Mixing between the two gases induces order-unity variations in viscosity and density, resulting in coupled concentration and velocity fields. The solution yields the mass transfer rates of both gases, expressed in terms of an appropriately defined Sherwood number, as well as the overpressure required to sustain the flow, all as functions of Sc and Pe. An explicit analytical solution is obtained in the limit of small Pe, while numerical integration is used to describe flows with Pe = O(1). The mixing of hydrogen and air is used as an illustrative example that serves to highlight the influence of large gas-molecular-weight differences on the flow structure and associated mixing rate, with additional selected results given for the case of hydrogen and water vapor."}],"geoLocations":[],"fundingReferences":[],"url":"https://arxiv.org/abs/2602.20914","contentUrl":null,"metadataVersion":0,"schemaVersion":"http://datacite.org/schema/kernel-4","source":"mds","isActive":true,"state":"findable","reason":null,"viewCount":0,"downloadCount":0,"referenceCount":0,"citationCount":0,"partCount":0,"partOfCount":0,"versionCount":0,"versionOfCount":0,"created":"2026-02-25T15:31:01Z","registered":"2026-02-25T15:31:02Z","published":null,"updated":"2026-02-25T15:31:02Z"},"relationships":{"client":{"data":{"id":"arxiv.content","type":"clients"}}}},{"id":"10.48550/arxiv.2602.20911","type":"dois","attributes":{"doi":"10.48550/arxiv.2602.20911","identifiers":[{"identifier":"2602.20911","identifierType":"arXiv"}],"creators":[{"nameType":"Personal","givenName":"Ruiqi","familyName":"Liu","name":"Liu, Ruiqi","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Boyu","familyName":"Diao","name":"Diao, Boyu","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Hangda","familyName":"Liu","name":"Liu, Hangda","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Zhulin","familyName":"An","name":"An, Zhulin","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Fei","familyName":"Wang","name":"Wang, Fei","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Yongjun","familyName":"Xu","name":"Xu, Yongjun","affiliation":[],"nameIdentifiers":[]}],"titles":[{"title":"From Isolation to Integration: Building an Adaptive Expert Forest for Pre-Trained Model-based Class-Incremental Learning"}],"publisher":"arXiv","container":{},"publicationYear":2026,"subjects":[{"subject":"Machine Learning (cs.LG)","lang":"en","subjectScheme":"arXiv"},{"subject":"Computer Vision and Pattern Recognition (cs.CV)","lang":"en","subjectScheme":"arXiv"},{"subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"},{"schemeUri":"http://www.oecd.org/science/inno/38235147.pdf","subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"}],"contributors":[],"dates":[{"date":"2026-02-24T13:48:13Z","dateType":"Submitted","dateInformation":"v1"},{"date":"2026-02-25T01:49:20Z","dateType":"Updated","dateInformation":"v1"},{"date":"2026-02","dateType":"Available","dateInformation":"v1"},{"date":"2026","dateType":"Issued"}],"language":null,"types":{"schemaOrg":"CreativeWork","resourceTypeGeneral":"Preprint","citeproc":"article","bibtex":"misc","ris":"GEN","resourceType":"Article"},"relatedIdentifiers":[],"relatedItems":[],"sizes":[],"formats":[],"version":"1","rightsList":[{"rightsIdentifierScheme":"SPDX","rightsUri":"https://creativecommons.org/licenses/by/4.0/legalcode","schemeUri":"https://spdx.org/licenses/","rights":"Creative Commons Attribution 4.0 International","rightsIdentifier":"cc-by-4.0"}],"descriptions":[{"descriptionType":"Abstract","description":"Class-Incremental Learning (CIL) requires models to learn new classes without forgetting old ones. A common method is to freeze a pre-trained model and train a new, lightweight adapter for each task. While this prevents forgetting, it treats the learned knowledge as a simple, unstructured collection and fails to use the relationships between tasks. To this end, we propose the Semantic-guided Adaptive Expert Forest (SAEF), a new method that organizes adapters into a structured hierarchy for better knowledge sharing. SAEF first groups tasks into conceptual clusters based on their semantic relationships. Then, within each cluster, it builds a balanced expert tree by creating new adapters from merging the adapters of similar tasks. At inference time, SAEF finds and activates a set of relevant experts from the forest for any given input. The final prediction is made by combining the outputs of these activated experts, weighted by how confident each expert is. Experiments on several benchmark datasets show that SAEF achieves SOTA performance."}],"geoLocations":[],"fundingReferences":[],"url":"https://arxiv.org/abs/2602.20911","contentUrl":null,"metadataVersion":0,"schemaVersion":"http://datacite.org/schema/kernel-4","source":"mds","isActive":true,"state":"findable","reason":null,"viewCount":0,"downloadCount":0,"referenceCount":0,"citationCount":0,"partCount":0,"partOfCount":0,"versionCount":0,"versionOfCount":0,"created":"2026-02-25T15:30:53Z","registered":"2026-02-25T15:30:54Z","published":null,"updated":"2026-02-25T15:30:54Z"},"relationships":{"client":{"data":{"id":"arxiv.content","type":"clients"}}}},{"id":"10.48550/arxiv.2602.20910","type":"dois","attributes":{"doi":"10.48550/arxiv.2602.20910","identifiers":[{"identifier":"2602.20910","identifierType":"arXiv"}],"creators":[{"nameType":"Personal","givenName":"Yuxin","familyName":"Sun","name":"Sun, Yuxin","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Chun","familyName":"Gao","name":"Gao, Chun","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Jin","familyName":"Xie","name":"Xie, Jin","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Pan","familyName":"Wang","name":"Wang, Pan","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Zejie","familyName":"Yu","name":"Yu, Zejie","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Yiwei","familyName":"Xie","name":"Xie, Yiwei","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Huan","familyName":"Li","name":"Li, Huan","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Daoxin","familyName":"Dai","name":"Dai, Daoxin","affiliation":[],"nameIdentifiers":[]}],"titles":[{"title":"Novel High-Scalability Architecture for Photonic Deep Learning"}],"publisher":"arXiv","container":{},"publicationYear":2026,"subjects":[{"subject":"Optics (physics.optics)","lang":"en","subjectScheme":"arXiv"},{"subject":"FOS: Physical sciences","subjectScheme":"Fields of Science and Technology (FOS)"},{"schemeUri":"http://www.oecd.org/science/inno/38235147.pdf","subject":"FOS: Physical sciences","subjectScheme":"Fields of Science and Technology (FOS)"}],"contributors":[],"dates":[{"date":"2026-02-24T13:47:08Z","dateType":"Submitted","dateInformation":"v1"},{"date":"2026-02-25T01:49:10Z","dateType":"Updated","dateInformation":"v1"},{"date":"2026-02","dateType":"Available","dateInformation":"v1"},{"date":"2026","dateType":"Issued"}],"language":null,"types":{"schemaOrg":"CreativeWork","resourceTypeGeneral":"Preprint","citeproc":"article","bibtex":"misc","ris":"GEN","resourceType":"Article"},"relatedIdentifiers":[],"relatedItems":[],"sizes":[],"formats":[],"version":"1","rightsList":[{"rightsUri":"http://arxiv.org/licenses/nonexclusive-distrib/1.0/","rights":"arXiv.org perpetual, non-exclusive license"}],"descriptions":[{"descriptionType":"Abstract","description":"Photonic computing promises ultrafast and energy-efficient artificial intelligence. However, existing photonic neural networks (PNNs) remain functionally shallow and difficult to scale. Here we establish a theory-guided framework showing that power stability and complex-field correlation are the fundamental prerequisites for scalable, coherent PNNs. Building on these macroscopic principles, we introduce the Coherent, Compensated and Cross-connected (C3) unit - an architecture that integrates coherent nonlinearity, active loss compensation and native optical residual connectivity. Implemented on a silicon-on-insulator platform, the C3 unit provides reconfigurable activation functions and dynamic energy stabilization without external amplification. We validate this framework using a width-constrained spiral benchmark, in which the C3 unit substantially improves parameter utilization and power robustness relative to incoherent nonlinearities. In a high-complexity 1,623-class recognition task, our C3-enabled coherent residual network (CoP-ResNet) achieves a top-1 accuracy of 77.92%, whereas non-residual architectures fail to converge. Together, these results offer a physically grounded, theory-guided pathway toward greater optical processing depth, laying the foundation for next-generation, large-scale photonic computing architectures."},{"descriptionType":"Other","description":"20 pages, 6 figures"}],"geoLocations":[],"fundingReferences":[],"url":"https://arxiv.org/abs/2602.20910","contentUrl":null,"metadataVersion":0,"schemaVersion":"http://datacite.org/schema/kernel-4","source":"mds","isActive":true,"state":"findable","reason":null,"viewCount":0,"downloadCount":0,"referenceCount":0,"citationCount":0,"partCount":0,"partOfCount":0,"versionCount":0,"versionOfCount":0,"created":"2026-02-25T15:30:51Z","registered":"2026-02-25T15:30:52Z","published":null,"updated":"2026-02-25T15:30:52Z"},"relationships":{"client":{"data":{"id":"arxiv.content","type":"clients"}}}},{"id":"10.48550/arxiv.2602.20904","type":"dois","attributes":{"doi":"10.48550/arxiv.2602.20904","identifiers":[{"identifier":"2602.20904","identifierType":"arXiv"}],"creators":[{"nameType":"Personal","givenName":"Nathan","familyName":"Hu","name":"Hu, Nathan","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Jake","familyName":"Ward","name":"Ward, Jake","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Thomas","familyName":"Icard","name":"Icard, Thomas","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Christopher","familyName":"Potts","name":"Potts, Christopher","affiliation":[],"nameIdentifiers":[]}],"titles":[{"title":"Transcoder Adapters for Reasoning-Model Diffing"}],"publisher":"arXiv","container":{},"publicationYear":2026,"subjects":[{"subject":"Machine Learning (cs.LG)","lang":"en","subjectScheme":"arXiv"},{"subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"},{"schemeUri":"http://www.oecd.org/science/inno/38235147.pdf","subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"}],"contributors":[],"dates":[{"date":"2026-02-24T13:40:28Z","dateType":"Submitted","dateInformation":"v1"},{"date":"2026-02-25T01:48:35Z","dateType":"Updated","dateInformation":"v1"},{"date":"2026-02","dateType":"Available","dateInformation":"v1"},{"date":"2026","dateType":"Issued"}],"language":null,"types":{"schemaOrg":"CreativeWork","resourceTypeGeneral":"Preprint","citeproc":"article","bibtex":"misc","ris":"GEN","resourceType":"Article"},"relatedIdentifiers":[],"relatedItems":[],"sizes":[],"formats":[],"version":"1","rightsList":[{"rightsIdentifierScheme":"SPDX","rightsUri":"https://creativecommons.org/licenses/by/4.0/legalcode","schemeUri":"https://spdx.org/licenses/","rights":"Creative Commons Attribution 4.0 International","rightsIdentifier":"cc-by-4.0"}],"descriptions":[{"descriptionType":"Abstract","description":"While reasoning models are increasingly ubiquitous, the effects of reasoning training on a model's internal mechanisms remain poorly understood. In this work, we introduce transcoder adapters, a technique for learning an interpretable approximation of the difference in MLP computation before and after fine-tuning. We apply transcoder adapters to characterize the differences between Qwen2.5-Math-7B and its reasoning-distilled variant, DeepSeek-R1-Distill-Qwen-7B. Learned adapters are faithful to the target model's internal computation and next-token predictions. When evaluated on reasoning benchmarks, adapters match the reasoning model's response lengths and typically recover 50-90% of the accuracy gains from reasoning fine-tuning. Adapter features are sparsely activating and interpretable. When examining adapter features, we find that only ~8% have activating examples directly related to reasoning behaviors. We deeply study one such behavior -- the production of hesitation tokens (e.g., \"wait\"). Using attribution graphs, we trace hesitation to only ~2.4% of adapter features (5.6k total) performing one of two functions. These features are necessary and sufficient for producing hesitation tokens; removing them reduces response length, often without affecting accuracy. Overall, our results provide insight into reasoning training and suggest transcoder adapters may be useful for studying fine-tuning more broadly."},{"descriptionType":"Other","description":"9 pages main, 27 pages total, 10 figures. Code and visualizations at https://transcoder-adapters.github.io/"}],"geoLocations":[],"fundingReferences":[],"url":"https://arxiv.org/abs/2602.20904","contentUrl":null,"metadataVersion":0,"schemaVersion":"http://datacite.org/schema/kernel-4","source":"mds","isActive":true,"state":"findable","reason":null,"viewCount":0,"downloadCount":0,"referenceCount":0,"citationCount":0,"partCount":0,"partOfCount":0,"versionCount":0,"versionOfCount":0,"created":"2026-02-25T15:30:36Z","registered":"2026-02-25T15:30:37Z","published":null,"updated":"2026-02-25T15:30:37Z"},"relationships":{"client":{"data":{"id":"arxiv.content","type":"clients"}}}},{"id":"10.48550/arxiv.2602.20161","type":"dois","attributes":{"doi":"10.48550/arxiv.2602.20161","identifiers":[{"identifier":"2602.20161","identifierType":"arXiv"}],"creators":[{"nameType":"Personal","givenName":"Abdelrahman","familyName":"Shaker","name":"Shaker, Abdelrahman","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Ahmed","familyName":"Heakl","name":"Heakl, Ahmed","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Jaseel","familyName":"Muhammad","name":"Muhammad, Jaseel","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Ritesh","familyName":"Thawkar","name":"Thawkar, Ritesh","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Omkar","familyName":"Thawakar","name":"Thawakar, Omkar","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Senmao","familyName":"Li","name":"Li, Senmao","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Hisham","familyName":"Cholakkal","name":"Cholakkal, Hisham","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Ian","familyName":"Reid","name":"Reid, Ian","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Eric P.","familyName":"Xing","name":"Xing, Eric P.","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Salman","familyName":"Khan","name":"Khan, Salman","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Fahad Shahbaz","familyName":"Khan","name":"Khan, Fahad Shahbaz","affiliation":[],"nameIdentifiers":[]}],"titles":[{"title":"Mobile-O: Unified Multimodal Understanding and Generation on Mobile Device"}],"publisher":"arXiv","container":{},"publicationYear":2026,"subjects":[{"subject":"Computer Vision and Pattern Recognition (cs.CV)","lang":"en","subjectScheme":"arXiv"},{"subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"},{"schemeUri":"http://www.oecd.org/science/inno/38235147.pdf","subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"}],"contributors":[],"dates":[{"date":"2026-02-23T18:59:58Z","dateType":"Submitted","dateInformation":"v1"},{"date":"2026-02-24T02:46:32Z","dateType":"Updated","dateInformation":"v1"},{"date":"2026-02-24T10:29:43Z","dateType":"Submitted","dateInformation":"v2"},{"date":"2026-02-25T01:39:51Z","dateType":"Updated","dateInformation":"v2"},{"date":"2026-02","dateType":"Available","dateInformation":"v1"},{"date":"2026","dateType":"Issued"}],"language":null,"types":{"schemaOrg":"CreativeWork","resourceTypeGeneral":"Preprint","citeproc":"article","bibtex":"misc","ris":"GEN","resourceType":"Article"},"relatedIdentifiers":[],"relatedItems":[],"sizes":[],"formats":[],"version":"2","rightsList":[{"rightsIdentifierScheme":"SPDX","rightsUri":"https://creativecommons.org/licenses/by-nc-sa/4.0/legalcode","schemeUri":"https://spdx.org/licenses/","rights":"Creative Commons Attribution Non Commercial Share Alike 4.0 International","rightsIdentifier":"cc-by-nc-sa-4.0"}],"descriptions":[{"descriptionType":"Abstract","description":"Unified multimodal models can both understand and generate visual content within a single architecture. Existing models, however, remain data-hungry and too heavy for deployment on edge devices. We present Mobile-O, a compact vision-language-diffusion model that brings unified multimodal intelligence to a mobile device. Its core module, the Mobile Conditioning Projector (MCP), fuses vision-language features with a diffusion generator using depthwise-separable convolutions and layerwise alignment. This design enables efficient cross-modal conditioning with minimal computational cost. Trained on only a few million samples and post-trained in a novel quadruplet format (generation prompt, image, question, answer), Mobile-O jointly enhances both visual understanding and generation capabilities. Despite its efficiency, Mobile-O attains competitive or superior performance compared to other unified models, achieving 74% on GenEval and outperforming Show-O and JanusFlow by 5% and 11%, while running 6x and 11x faster, respectively. For visual understanding, Mobile-O surpasses them by 15.3% and 5.1% averaged across seven benchmarks. Running in only ~3s per 512x512 image on an iPhone, Mobile-O establishes the first practical framework for real-time unified multimodal understanding and generation on edge devices. We hope Mobile-O will ease future research in real-time unified multimodal intelligence running entirely on-device with no cloud dependency. Our code, models, datasets, and mobile application are publicly available at https://amshaker.github.io/Mobile-O/"},{"descriptionType":"Other","description":"Project page: https://amshaker.github.io/Mobile-O/"}],"geoLocations":[],"fundingReferences":[],"url":"https://arxiv.org/abs/2602.20161","contentUrl":null,"metadataVersion":0,"schemaVersion":"http://datacite.org/schema/kernel-4","source":"mds","isActive":true,"state":"findable","reason":null,"viewCount":0,"downloadCount":0,"referenceCount":0,"citationCount":0,"partCount":0,"partOfCount":0,"versionCount":0,"versionOfCount":0,"created":"2026-02-25T15:30:29Z","registered":"2026-02-25T15:30:29Z","published":null,"updated":"2026-02-25T15:30:29Z"},"relationships":{"client":{"data":{"id":"arxiv.content","type":"clients"}}}},{"id":"10.48550/arxiv.2602.20158","type":"dois","attributes":{"doi":"10.48550/arxiv.2602.20158","identifiers":[{"identifier":"2602.20158","identifierType":"arXiv"}],"creators":[{"nameType":"Personal","givenName":"Zijian","familyName":"Liang","name":"Liang, Zijian","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Yu-An","familyName":"Chen","name":"Chen, Yu-An","affiliation":[],"nameIdentifiers":[]}],"titles":[{"title":"Generalized $\\mathbb{Z}_p$ toric codes as qudit low-density parity-check codes"}],"publisher":"arXiv","container":{},"publicationYear":2026,"subjects":[{"subject":"Quantum Physics (quant-ph)","lang":"en","subjectScheme":"arXiv"},{"subject":"Strongly Correlated Electrons (cond-mat.str-el)","lang":"en","subjectScheme":"arXiv"},{"subject":"Mathematical Physics (math-ph)","lang":"en","subjectScheme":"arXiv"},{"subject":"Quantum Algebra (math.QA)","lang":"en","subjectScheme":"arXiv"},{"subject":"FOS: Physical sciences","subjectScheme":"Fields of Science and Technology (FOS)"},{"schemeUri":"http://www.oecd.org/science/inno/38235147.pdf","subject":"FOS: Physical sciences","subjectScheme":"Fields of Science and Technology (FOS)"},{"subject":"FOS: Mathematics","subjectScheme":"Fields of Science and Technology (FOS)"},{"schemeUri":"http://www.oecd.org/science/inno/38235147.pdf","subject":"FOS: Mathematics","subjectScheme":"Fields of Science and Technology (FOS)"}],"contributors":[],"dates":[{"date":"2026-02-23T18:59:31Z","dateType":"Submitted","dateInformation":"v1"},{"date":"2026-02-24T02:46:26Z","dateType":"Updated","dateInformation":"v1"},{"date":"2026-02","dateType":"Available","dateInformation":"v1"},{"date":"2026","dateType":"Issued"}],"language":null,"types":{"schemaOrg":"CreativeWork","resourceTypeGeneral":"Preprint","citeproc":"article","bibtex":"misc","ris":"GEN","resourceType":"Article"},"relatedIdentifiers":[],"relatedItems":[],"sizes":[],"formats":[],"version":"1","rightsList":[{"rightsUri":"http://arxiv.org/licenses/nonexclusive-distrib/1.0/","rights":"arXiv.org perpetual, non-exclusive license"}],"descriptions":[{"descriptionType":"Abstract","description":"We study two-dimensional translation-invariant CSS stabilizer codes over prime-dimensional qudits on the square lattice under twisted boundary conditions, generalizing the Kitaev $\\mathbb{Z}_p$ toric code by augmenting each stabilizer with two additional qudits. Using the Laurent-polynomial formalism, we adapt the Gröbner basis to compute the logical dimension $k$ efficiently, without explicitly constructing large parity-check matrices. We then perform a systematic search over various stabilizer realizations and lattice geometries for $p\\in\\{3,5,7,11\\}$, identifying qudit low-density parity-check codes with the optimal finite-size performance. Representative examples include $[[242,10,22]]_3$ and $[[120,6,20]]_{11}$, both achieving $k d^{2}/n=20$. Across the searched regime, the best observed $k d^{2}$ at fixed $n$ increases with $p$, with an empirical relation $k d^{2} = 0.0541 \\, n^{2}\\ln p + 3.84 \\, n$, compatible with a Bravyi--Poulin--Terhal-type tradeoff when the interaction range grows with system size."},{"descriptionType":"Other","description":"9+1 pages, 4 figures"}],"geoLocations":[],"fundingReferences":[],"url":"https://arxiv.org/abs/2602.20158","contentUrl":null,"metadataVersion":0,"schemaVersion":"http://datacite.org/schema/kernel-4","source":"mds","isActive":true,"state":"findable","reason":null,"viewCount":0,"downloadCount":0,"referenceCount":0,"citationCount":0,"partCount":0,"partOfCount":0,"versionCount":0,"versionOfCount":0,"created":"2026-02-25T15:30:21Z","registered":"2026-02-25T15:30:21Z","published":null,"updated":"2026-02-25T15:30:21Z"},"relationships":{"client":{"data":{"id":"arxiv.content","type":"clients"}}}},{"id":"10.48550/arxiv.2602.20157","type":"dois","attributes":{"doi":"10.48550/arxiv.2602.20157","identifiers":[{"identifier":"2602.20157","identifierType":"arXiv"}],"creators":[{"nameType":"Personal","givenName":"Zhongxiao","familyName":"Cong","name":"Cong, Zhongxiao","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Qitao","familyName":"Zhao","name":"Zhao, Qitao","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Minsik","familyName":"Jeon","name":"Jeon, Minsik","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Shubham","familyName":"Tulsiani","name":"Tulsiani, Shubham","affiliation":[],"nameIdentifiers":[]}],"titles":[{"title":"Flow3r: Factored Flow Prediction for Scalable Visual Geometry Learning"}],"publisher":"arXiv","container":{},"publicationYear":2026,"subjects":[{"subject":"Computer Vision and Pattern Recognition (cs.CV)","lang":"en","subjectScheme":"arXiv"},{"subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"},{"schemeUri":"http://www.oecd.org/science/inno/38235147.pdf","subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"}],"contributors":[],"dates":[{"date":"2026-02-23T18:59:30Z","dateType":"Submitted","dateInformation":"v1"},{"date":"2026-02-24T02:46:24Z","dateType":"Updated","dateInformation":"v1"},{"date":"2026-02","dateType":"Available","dateInformation":"v1"},{"date":"2026","dateType":"Issued"}],"language":null,"types":{"schemaOrg":"CreativeWork","resourceTypeGeneral":"Preprint","citeproc":"article","bibtex":"misc","ris":"GEN","resourceType":"Article"},"relatedIdentifiers":[],"relatedItems":[],"sizes":[],"formats":[],"version":"1","rightsList":[{"rightsIdentifierScheme":"SPDX","rightsUri":"https://creativecommons.org/licenses/by/4.0/legalcode","schemeUri":"https://spdx.org/licenses/","rights":"Creative Commons Attribution 4.0 International","rightsIdentifier":"cc-by-4.0"}],"descriptions":[{"descriptionType":"Abstract","description":"Current feed-forward 3D/4D reconstruction systems rely on dense geometry and pose supervision -- expensive to obtain at scale and particularly scarce for dynamic real-world scenes. We present Flow3r, a framework that augments visual geometry learning with dense 2D correspondences (`flow') as supervision, enabling scalable training from unlabeled monocular videos. Our key insight is that the flow prediction module should be factored: predicting flow between two images using geometry latents from one and pose latents from the other. This factorization directly guides the learning of both scene geometry and camera motion, and naturally extends to dynamic scenes. In controlled experiments, we show that factored flow prediction outperforms alternative designs and that performance scales consistently with unlabeled data. Integrating factored flow into existing visual geometry architectures and training with ${\\sim}800$K unlabeled videos, Flow3r achieves state-of-the-art results across eight benchmarks spanning static and dynamic scenes, with its largest gains on in-the-wild dynamic videos where labeled data is most scarce."},{"descriptionType":"Other","description":"CVPR 2026. Project website: https://flow3r-project.github.io/"}],"geoLocations":[],"fundingReferences":[],"url":"https://arxiv.org/abs/2602.20157","contentUrl":null,"metadataVersion":0,"schemaVersion":"http://datacite.org/schema/kernel-4","source":"mds","isActive":true,"state":"findable","reason":null,"viewCount":0,"downloadCount":0,"referenceCount":0,"citationCount":0,"partCount":0,"partOfCount":0,"versionCount":0,"versionOfCount":0,"created":"2026-02-25T15:30:18Z","registered":"2026-02-25T15:30:19Z","published":null,"updated":"2026-02-25T15:30:19Z"},"relationships":{"client":{"data":{"id":"arxiv.content","type":"clients"}}}},{"id":"10.48550/arxiv.2602.20154","type":"dois","attributes":{"doi":"10.48550/arxiv.2602.20154","identifiers":[{"identifier":"2602.20154","identifierType":"arXiv"}],"creators":[{"nameType":"Personal","givenName":"Shao-Hen","familyName":"Chiew","name":"Chiew, Shao-Hen","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Armando","familyName":"Angrisani","name":"Angrisani, Armando","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Zoë","familyName":"Holmes","name":"Holmes, Zoë","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Giuseppe","familyName":"Carleo","name":"Carleo, Giuseppe","affiliation":[],"nameIdentifiers":[]}],"titles":[{"title":"Quantum simulation in the Heisenberg picture via vectorization"}],"publisher":"arXiv","container":{},"publicationYear":2026,"subjects":[{"subject":"Quantum Physics (quant-ph)","lang":"en","subjectScheme":"arXiv"},{"subject":"FOS: Physical sciences","subjectScheme":"Fields of Science and Technology (FOS)"},{"schemeUri":"http://www.oecd.org/science/inno/38235147.pdf","subject":"FOS: Physical sciences","subjectScheme":"Fields of Science and Technology (FOS)"}],"contributors":[],"dates":[{"date":"2026-02-23T18:59:11Z","dateType":"Submitted","dateInformation":"v1"},{"date":"2026-02-24T02:46:21Z","dateType":"Updated","dateInformation":"v1"},{"date":"2026-02","dateType":"Available","dateInformation":"v1"},{"date":"2026","dateType":"Issued"}],"language":null,"types":{"schemaOrg":"CreativeWork","resourceTypeGeneral":"Preprint","citeproc":"article","bibtex":"misc","ris":"GEN","resourceType":"Article"},"relatedIdentifiers":[],"relatedItems":[],"sizes":[],"formats":[],"version":"1","rightsList":[{"rightsUri":"http://arxiv.org/licenses/nonexclusive-distrib/1.0/","rights":"arXiv.org perpetual, non-exclusive license"}],"descriptions":[{"descriptionType":"Abstract","description":"We present a general framework for simulating quantum systems in the Heisenberg picture on quantum hardware. Based on the vectorization map, our framework fully exploits the mapping between operators and quantum states, allowing any task defined on Heisenberg operators to be mapped to standard Schrödinger-picture tasks that are naturally accessible via quantum computers and simulators. This yields new or improved protocols for tasks such as operator sampling, the computation of OTOCs/superoperator expectation values and their higher order moments, two-point correlators, and operator stabilizer and entanglement entropies. Our approach is also amenable to implementation, as it inherits the structure and resource requirements of the (forward and time-reversed) Schrödinger-picture quantum simulation problem. We demonstrate this by proposing implementations of our framework for a 2D problem on digital and analog quantum simulators, taking into account device connectivity constraints."}],"geoLocations":[],"fundingReferences":[],"url":"https://arxiv.org/abs/2602.20154","contentUrl":null,"metadataVersion":0,"schemaVersion":"http://datacite.org/schema/kernel-4","source":"mds","isActive":true,"state":"findable","reason":null,"viewCount":0,"downloadCount":0,"referenceCount":0,"citationCount":0,"partCount":0,"partOfCount":0,"versionCount":0,"versionOfCount":0,"created":"2026-02-25T15:30:10Z","registered":"2026-02-25T15:30:11Z","published":null,"updated":"2026-02-25T15:30:11Z"},"relationships":{"client":{"data":{"id":"arxiv.content","type":"clients"}}}},{"id":"10.48550/arxiv.2602.20153","type":"dois","attributes":{"doi":"10.48550/arxiv.2602.20153","identifiers":[{"identifier":"2602.20153","identifierType":"arXiv"}],"creators":[{"nameType":"Personal","givenName":"Jakob","familyName":"Heiss","name":"Heiss, Jakob","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Sören","familyName":"Lambrecht","name":"Lambrecht, Sören","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Jakob","familyName":"Weissteiner","name":"Weissteiner, Jakob","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Hanna","familyName":"Wutte","name":"Wutte, Hanna","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Žan","familyName":"Žurič","name":"Žurič, Žan","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Josef","familyName":"Teichmann","name":"Teichmann, Josef","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Bin","familyName":"Yu","name":"Yu, Bin","affiliation":[],"nameIdentifiers":[]}],"titles":[{"title":"JUCAL: Jointly Calibrating Aleatoric and Epistemic Uncertainty in Classification Tasks"}],"publisher":"arXiv","container":{},"publicationYear":2026,"subjects":[{"subject":"Machine Learning (stat.ML)","lang":"en","subjectScheme":"arXiv"},{"subject":"Machine Learning (cs.LG)","lang":"en","subjectScheme":"arXiv"},{"subject":"Methodology (stat.ME)","lang":"en","subjectScheme":"arXiv"},{"subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"},{"schemeUri":"http://www.oecd.org/science/inno/38235147.pdf","subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"}],"contributors":[],"dates":[{"date":"2026-02-23T18:59:10Z","dateType":"Submitted","dateInformation":"v1"},{"date":"2026-02-24T02:46:18Z","dateType":"Updated","dateInformation":"v1"},{"date":"2026-02","dateType":"Available","dateInformation":"v1"},{"date":"2026","dateType":"Issued"}],"language":null,"types":{"schemaOrg":"CreativeWork","resourceTypeGeneral":"Preprint","citeproc":"article","bibtex":"misc","ris":"GEN","resourceType":"Article"},"relatedIdentifiers":[],"relatedItems":[],"sizes":[],"formats":[],"version":"1","rightsList":[{"rightsUri":"http://arxiv.org/licenses/nonexclusive-distrib/1.0/","rights":"arXiv.org perpetual, non-exclusive license"}],"descriptions":[{"descriptionType":"Abstract","description":"We study post-calibration uncertainty for trained ensembles of classifiers. Specifically, we consider both aleatoric (label noise) and epistemic (model) uncertainty. Among the most popular and widely used calibration methods in classification are temperature scaling (i.e., pool-then-calibrate) and conformal methods. However, the main shortcoming of these calibration methods is that they do not balance the proportion of aleatoric and epistemic uncertainty. Not balancing these uncertainties can severely misrepresent predictive uncertainty, leading to overconfident predictions in some input regions while being underconfident in others. To address this shortcoming, we present a simple but powerful calibration algorithm Joint Uncertainty Calibration (JUCAL) that jointly calibrates aleatoric and epistemic uncertainty. JUCAL jointly calibrates two constants to weight and scale epistemic and aleatoric uncertainties by optimizing the negative log-likelihood (NLL) on the validation/calibration dataset. JUCAL can be applied to any trained ensemble of classifiers (e.g., transformers, CNNs, or tree-based methods), with minimal computational overhead, without requiring access to the models' internal parameters. We experimentally evaluate JUCAL on various text classification tasks, for ensembles of varying sizes and with different ensembling strategies. Our experiments show that JUCAL significantly outperforms SOTA calibration methods across all considered classification tasks, reducing NLL and predictive set size by up to 15% and 20%, respectively. Interestingly, even applying JUCAL to an ensemble of size 5 can outperform temperature-scaled ensembles of size up to 50 in terms of NLL and predictive set size, resulting in up to 10 times smaller inference costs. Thus, we propose JUCAL as a new go-to method for calibrating ensembles in classification."},{"descriptionType":"Other","description":"11 pages + appendix. Preliminary version of an ongoing project that will be expanded with furhter evaluations"}],"geoLocations":[],"fundingReferences":[],"url":"https://arxiv.org/abs/2602.20153","contentUrl":null,"metadataVersion":0,"schemaVersion":"http://datacite.org/schema/kernel-4","source":"mds","isActive":true,"state":"findable","reason":null,"viewCount":0,"downloadCount":0,"referenceCount":0,"citationCount":0,"partCount":0,"partOfCount":0,"versionCount":0,"versionOfCount":0,"created":"2026-02-25T15:30:08Z","registered":"2026-02-25T15:30:09Z","published":null,"updated":"2026-02-25T15:30:09Z"},"relationships":{"client":{"data":{"id":"arxiv.content","type":"clients"}}}},{"id":"10.48550/arxiv.2602.20152","type":"dois","attributes":{"doi":"10.48550/arxiv.2602.20152","identifiers":[{"identifier":"2602.20152","identifierType":"arXiv"}],"creators":[{"nameType":"Personal","givenName":"Zhenyao","familyName":"Ma","name":"Ma, Zhenyao","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Yue","familyName":"Liang","name":"Liang, Yue","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Dongxu","familyName":"Li","name":"Li, Dongxu","affiliation":[],"nameIdentifiers":[]}],"titles":[{"title":"Behavior Learning (BL): Learning Hierarchical Optimization Structures from Data"}],"publisher":"arXiv","container":{},"publicationYear":2026,"subjects":[{"subject":"Machine Learning (cs.LG)","lang":"en","subjectScheme":"arXiv"},{"subject":"Artificial Intelligence (cs.AI)","lang":"en","subjectScheme":"arXiv"},{"subject":"Machine Learning (stat.ML)","lang":"en","subjectScheme":"arXiv"},{"subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"},{"schemeUri":"http://www.oecd.org/science/inno/38235147.pdf","subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"},{"subject":"I.2.6","lang":"en","subjectScheme":"ACM"}],"contributors":[],"dates":[{"date":"2026-02-23T18:59:04Z","dateType":"Submitted","dateInformation":"v1"},{"date":"2026-02-24T02:46:17Z","dateType":"Updated","dateInformation":"v1"},{"date":"2026-02","dateType":"Available","dateInformation":"v1"},{"date":"2026","dateType":"Issued"}],"language":null,"types":{"schemaOrg":"CreativeWork","resourceTypeGeneral":"Preprint","citeproc":"article","bibtex":"misc","ris":"GEN","resourceType":"Article"},"relatedIdentifiers":[],"relatedItems":[],"sizes":[],"formats":[],"version":"1","rightsList":[{"rightsUri":"http://arxiv.org/licenses/nonexclusive-distrib/1.0/","rights":"arXiv.org perpetual, non-exclusive license"}],"descriptions":[{"descriptionType":"Abstract","description":"Inspired by behavioral science, we propose Behavior Learning (BL), a novel general-purpose machine learning framework that learns interpretable and identifiable optimization structures from data, ranging from single optimization problems to hierarchical compositions. It unifies predictive performance, intrinsic interpretability, and identifiability, with broad applicability to scientific domains involving optimization. BL parameterizes a compositional utility function built from intrinsically interpretable modular blocks, which induces a data distribution for prediction and generation. Each block represents and can be written in symbolic form as a utility maximization problem (UMP), a foundational paradigm in behavioral science and a universal framework of optimization. BL supports architectures ranging from a single UMP to hierarchical compositions, the latter modeling hierarchical optimization structures. Its smooth and monotone variant (IBL) guarantees identifiability. Theoretically, we establish the universal approximation property of BL, and analyze the M-estimation properties of IBL. Empirically, BL demonstrates strong predictive performance, intrinsic interpretability and scalability to high-dimensional data. Code: https://github.com/MoonYLiang/Behavior-Learning ; install via pip install blnetwork."},{"descriptionType":"Other","description":"ICLR 2026"}],"geoLocations":[],"fundingReferences":[],"url":"https://arxiv.org/abs/2602.20152","contentUrl":null,"metadataVersion":0,"schemaVersion":"http://datacite.org/schema/kernel-4","source":"mds","isActive":true,"state":"findable","reason":null,"viewCount":0,"downloadCount":0,"referenceCount":0,"citationCount":0,"partCount":0,"partOfCount":0,"versionCount":0,"versionOfCount":0,"created":"2026-02-25T15:30:05Z","registered":"2026-02-25T15:30:06Z","published":null,"updated":"2026-02-25T15:30:06Z"},"relationships":{"client":{"data":{"id":"arxiv.content","type":"clients"}}}},{"id":"10.48550/arxiv.2602.20151","type":"dois","attributes":{"doi":"10.48550/arxiv.2602.20151","identifiers":[{"identifier":"2602.20151","identifierType":"arXiv"}],"creators":[{"nameType":"Personal","givenName":"Anastasios N.","familyName":"Angelopoulos","name":"Angelopoulos, Anastasios N.","affiliation":[],"nameIdentifiers":[]}],"titles":[{"title":"Conformal Risk Control for Non-Monotonic Losses"}],"publisher":"arXiv","container":{},"publicationYear":2026,"subjects":[{"subject":"Methodology (stat.ME)","lang":"en","subjectScheme":"arXiv"},{"subject":"Machine Learning (cs.LG)","lang":"en","subjectScheme":"arXiv"},{"subject":"Statistics Theory (math.ST)","lang":"en","subjectScheme":"arXiv"},{"subject":"Machine Learning (stat.ML)","lang":"en","subjectScheme":"arXiv"},{"subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"},{"schemeUri":"http://www.oecd.org/science/inno/38235147.pdf","subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"},{"subject":"FOS: Mathematics","subjectScheme":"Fields of Science and Technology (FOS)"},{"schemeUri":"http://www.oecd.org/science/inno/38235147.pdf","subject":"FOS: Mathematics","subjectScheme":"Fields of Science and Technology (FOS)"}],"contributors":[],"dates":[{"date":"2026-02-23T18:58:54Z","dateType":"Submitted","dateInformation":"v1"},{"date":"2026-02-24T02:46:16Z","dateType":"Updated","dateInformation":"v1"},{"date":"2026-02","dateType":"Available","dateInformation":"v1"},{"date":"2026","dateType":"Issued"}],"language":null,"types":{"schemaOrg":"CreativeWork","resourceTypeGeneral":"Preprint","citeproc":"article","bibtex":"misc","ris":"GEN","resourceType":"Article"},"relatedIdentifiers":[],"relatedItems":[],"sizes":[],"formats":[],"version":"1","rightsList":[{"rightsUri":"http://arxiv.org/licenses/nonexclusive-distrib/1.0/","rights":"arXiv.org perpetual, non-exclusive license"}],"descriptions":[{"descriptionType":"Abstract","description":"Conformal risk control is an extension of conformal prediction for controlling risk functions beyond miscoverage. The original algorithm controls the expected value of a loss that is monotonic in a one-dimensional parameter. Here, we present risk control guarantees for generic algorithms applied to possibly non-monotonic losses with multidimensional parameters. The guarantees depend on the stability of the algorithm -- unstable algorithms have looser guarantees. We give applications of this technique to selective image classification, FDR and IOU control of tumor segmentations, and multigroup debiasing of recidivism predictions across overlapping race and sex groups using empirical risk minimization."}],"geoLocations":[],"fundingReferences":[],"url":"https://arxiv.org/abs/2602.20151","contentUrl":null,"metadataVersion":0,"schemaVersion":"http://datacite.org/schema/kernel-4","source":"mds","isActive":true,"state":"findable","reason":null,"viewCount":0,"downloadCount":0,"referenceCount":0,"citationCount":0,"partCount":0,"partOfCount":0,"versionCount":0,"versionOfCount":0,"created":"2026-02-25T15:30:02Z","registered":"2026-02-25T15:30:03Z","published":null,"updated":"2026-02-25T15:30:03Z"},"relationships":{"client":{"data":{"id":"arxiv.content","type":"clients"}}}},{"id":"10.48550/arxiv.2602.20149","type":"dois","attributes":{"doi":"10.48550/arxiv.2602.20149","identifiers":[{"identifier":"2602.20149","identifierType":"arXiv"}],"creators":[{"nameType":"Personal","givenName":"Radhakrishnan","familyName":"Balu","name":"Balu, Radhakrishnan","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"S. James","familyName":"Gates","name":"Gates, S. James","affiliation":[],"nameIdentifiers":[]}],"titles":[{"title":"Quantum Information Approach to Bosonization of Supersymmetric Yang-Mills Fields"}],"publisher":"arXiv","container":{},"publicationYear":2026,"subjects":[{"subject":"Quantum Physics (quant-ph)","lang":"en","subjectScheme":"arXiv"},{"subject":"Mathematical Physics (math-ph)","lang":"en","subjectScheme":"arXiv"},{"subject":"FOS: Physical sciences","subjectScheme":"Fields of Science and Technology (FOS)"},{"schemeUri":"http://www.oecd.org/science/inno/38235147.pdf","subject":"FOS: Physical sciences","subjectScheme":"Fields of Science and Technology (FOS)"}],"contributors":[],"dates":[{"date":"2026-02-23T18:57:21Z","dateType":"Submitted","dateInformation":"v1"},{"date":"2026-02-24T02:46:09Z","dateType":"Updated","dateInformation":"v1"},{"date":"2026-02","dateType":"Available","dateInformation":"v1"},{"date":"2026","dateType":"Issued"}],"language":null,"types":{"schemaOrg":"CreativeWork","resourceTypeGeneral":"Preprint","citeproc":"article","bibtex":"misc","ris":"GEN","resourceType":"Article"},"relatedIdentifiers":[],"relatedItems":[],"sizes":[],"formats":[],"version":"1","rightsList":[{"rightsUri":"http://arxiv.org/licenses/nonexclusive-distrib/1.0/","rights":"arXiv.org perpetual, non-exclusive license"}],"descriptions":[{"descriptionType":"Abstract","description":"We consider bosonization of supersymmetry in the context of Wess-Zumino quantum mechanics. Our motivation for this investigation is the flexibility the bosonic fock space affords as any classical probability distribution can be realized on it making it a versatile framework to work with for quantum processes. We proceed by constructing a minimal bosonization of a system with one bosonic and two fermionic degrees of freedom. We iterate this process to construct a tower of SUSY systems that is akin to unfolded Adinkras. We then identify an osp(2|2) symmetry of the system constructed. To build an irreducible representation of the system we induce representations across the sectors, a first to our knowledge, as the previous work have focused on induction only within the bosonic sector. First, we start with a fermionic representation using Clifford algebras and then induce a representation to gl(2|2) and restrict it to osp(2|2). In the second method, we induce a representation from that of the bosonic sector. In both cases, our representations are in terms of qubit operators that provide a way to solve SUSY problems using quantum information based approaches. Depending upon the direction of induction the representations are suitable for implementation on a hybrid qubit and fermionic or bosonic quantum computers."}],"geoLocations":[],"fundingReferences":[],"url":"https://arxiv.org/abs/2602.20149","contentUrl":null,"metadataVersion":0,"schemaVersion":"http://datacite.org/schema/kernel-4","source":"mds","isActive":true,"state":"findable","reason":null,"viewCount":0,"downloadCount":0,"referenceCount":0,"citationCount":0,"partCount":0,"partOfCount":0,"versionCount":0,"versionOfCount":0,"created":"2026-02-25T15:29:57Z","registered":"2026-02-25T15:29:57Z","published":null,"updated":"2026-02-25T15:29:57Z"},"relationships":{"client":{"data":{"id":"arxiv.content","type":"clients"}}}},{"id":"10.48550/arxiv.2602.20148","type":"dois","attributes":{"doi":"10.48550/arxiv.2602.20148","identifiers":[{"identifier":"2602.20148","identifierType":"arXiv"}],"creators":[{"nameType":"Personal","givenName":"Jordan T.","familyName":"McCourt","name":"McCourt, Jordan T.","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Ryan","familyName":"Henderson","name":"Henderson, Ryan","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"John","familyName":"Chiles","name":"Chiles, John","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Chun-Chia","familyName":"Chen","name":"Chen, Chun-Chia","affiliation":[],"nameIdentifiers":[]},{"nameType":"Organizational","affiliation":[],"name":"Shama","nameIdentifiers":[]},{"nameType":"Personal","givenName":"Divine","familyName":"Kumah","name":"Kumah, Divine","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Vadim","familyName":"Geshkenbein","name":"Geshkenbein, Vadim","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Gleb","familyName":"Finkelstein","name":"Finkelstein, Gleb","affiliation":[],"nameIdentifiers":[]}],"titles":[{"title":"Vortex Tunneling and Critical State in an Oxide Heterostructure"}],"publisher":"arXiv","container":{},"publicationYear":2026,"subjects":[{"subject":"Superconductivity (cond-mat.supr-con)","lang":"en","subjectScheme":"arXiv"},{"subject":"Mesoscale and Nanoscale Physics (cond-mat.mes-hall)","lang":"en","subjectScheme":"arXiv"},{"subject":"FOS: Physical sciences","subjectScheme":"Fields of Science and Technology (FOS)"},{"schemeUri":"http://www.oecd.org/science/inno/38235147.pdf","subject":"FOS: Physical sciences","subjectScheme":"Fields of Science and Technology (FOS)"}],"contributors":[],"dates":[{"date":"2026-02-23T18:57:05Z","dateType":"Submitted","dateInformation":"v1"},{"date":"2026-02-24T02:46:05Z","dateType":"Updated","dateInformation":"v1"},{"date":"2026-02","dateType":"Available","dateInformation":"v1"},{"date":"2026","dateType":"Issued"}],"language":null,"types":{"schemaOrg":"CreativeWork","resourceTypeGeneral":"Preprint","citeproc":"article","bibtex":"misc","ris":"GEN","resourceType":"Article"},"relatedIdentifiers":[],"relatedItems":[],"sizes":[],"formats":[],"version":"1","rightsList":[{"rightsIdentifierScheme":"SPDX","rightsUri":"https://creativecommons.org/licenses/by/4.0/legalcode","schemeUri":"https://spdx.org/licenses/","rights":"Creative Commons Attribution 4.0 International","rightsIdentifier":"cc-by-4.0"}],"descriptions":[{"descriptionType":"Abstract","description":"Two-dimensional superconductors offer an excellent platform for the study of vortex matter due to their low superfluid stiffness and inability to effectively screen applied magnetic fields. Here we explore vortices in a two-dimensional superconductor formed at the surface of the complex oxide KTaO$_3$. Multiple regimes of vortex-mediated transport are identified and studied, revealing switching behaviour attributed to nucleation of individual vortices. Analysis of this regime allows us to identify the quantum tunneling of vortices, which transitions to thermally activated behaviour at elevated temperatures. Magnetic field dependence reveals rich histograms of the switching currents which we attribute to different configurations of pinned vortices."},{"descriptionType":"Other","description":"13 pages, 4 figures, 10 supplementary figures"}],"geoLocations":[],"fundingReferences":[],"url":"https://arxiv.org/abs/2602.20148","contentUrl":null,"metadataVersion":0,"schemaVersion":"http://datacite.org/schema/kernel-4","source":"mds","isActive":true,"state":"findable","reason":null,"viewCount":0,"downloadCount":0,"referenceCount":0,"citationCount":0,"partCount":0,"partOfCount":0,"versionCount":0,"versionOfCount":0,"created":"2026-02-25T15:29:54Z","registered":"2026-02-25T15:29:55Z","published":null,"updated":"2026-02-25T15:29:55Z"},"relationships":{"client":{"data":{"id":"arxiv.content","type":"clients"}}}},{"id":"10.48550/arxiv.2602.20145","type":"dois","attributes":{"doi":"10.48550/arxiv.2602.20145","identifiers":[{"identifier":"2602.20145","identifierType":"arXiv"}],"creators":[{"nameType":"Personal","givenName":"Kohta","familyName":"Murase","name":"Murase, Kohta","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Shigeo S.","familyName":"Kimura","name":"Kimura, Shigeo S.","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Mainak","familyName":"Mukhopadhyay","name":"Mukhopadhyay, Mainak","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Mukul","familyName":"Bhattacharya","name":"Bhattacharya, Mukul","affiliation":[],"nameIdentifiers":[]}],"titles":[{"title":"IceCube's convex all-sky neutrino spectrum consistent with the magnetically powered corona scenario for active galactic nuclei"}],"publisher":"arXiv","container":{},"publicationYear":2026,"subjects":[{"subject":"High Energy Astrophysical Phenomena (astro-ph.HE)","lang":"en","subjectScheme":"arXiv"},{"subject":"Astrophysics of Galaxies (astro-ph.GA)","lang":"en","subjectScheme":"arXiv"},{"subject":"High Energy Physics - Phenomenology (hep-ph)","lang":"en","subjectScheme":"arXiv"},{"subject":"FOS: Physical sciences","subjectScheme":"Fields of Science and Technology (FOS)"},{"schemeUri":"http://www.oecd.org/science/inno/38235147.pdf","subject":"FOS: Physical sciences","subjectScheme":"Fields of Science and Technology (FOS)"}],"contributors":[],"dates":[{"date":"2026-02-23T18:55:57Z","dateType":"Submitted","dateInformation":"v1"},{"date":"2026-02-24T02:46:02Z","dateType":"Updated","dateInformation":"v1"},{"date":"2026-02","dateType":"Available","dateInformation":"v1"},{"date":"2026","dateType":"Issued"}],"language":null,"types":{"schemaOrg":"CreativeWork","resourceTypeGeneral":"Preprint","citeproc":"article","bibtex":"misc","ris":"GEN","resourceType":"Article"},"relatedIdentifiers":[],"relatedItems":[],"sizes":[],"formats":[],"version":"1","rightsList":[{"rightsUri":"http://arxiv.org/licenses/nonexclusive-distrib/1.0/","rights":"arXiv.org perpetual, non-exclusive license"}],"descriptions":[{"descriptionType":"Abstract","description":"High-energy multimessenger background analyses over the past decade have provided evidence for a population of hidden neutrino sources that are opaque to GeV-TeV gamma rays, a picture bolstered by recent observations of the nearby active galaxy NGC 1068. The coronal regions in the hearts of active galactic nuclei (AGNs) have been proposed as the most promising sites for such hidden nonthermal particle production, and NGC 1068 is expected to be the most neutrino-active galaxy for IceCube. We demonstrate that the latest all-sky neutrino spectrum, exhibiting a spectral bend around 3-30 TeV, is consistent with predictions of the magnetically powered corona scenario, and the models for the all-sky neutrino flux can simultaneously explain the multimessenger data from NGC 1068 within observational and modeling uncertainties. We further show, in a largely model-independent way, that the contribution from NGC 1068-like sources does not overshoot the observed medium-energy neutrino flux. Finally, we highlight the key role of the Eddington ratio, which can drive substantial variations in the predicted neutrino fluxes of nearby AGNs, and we encourage systematic multimessenger searches for the neutrino-brightest AGNs."},{"descriptionType":"Other","description":"25 pages, 11 figures, 4 tables"}],"geoLocations":[],"fundingReferences":[],"url":"https://arxiv.org/abs/2602.20145","contentUrl":null,"metadataVersion":0,"schemaVersion":"http://datacite.org/schema/kernel-4","source":"mds","isActive":true,"state":"findable","reason":null,"viewCount":0,"downloadCount":0,"referenceCount":0,"citationCount":0,"partCount":0,"partOfCount":0,"versionCount":0,"versionOfCount":0,"created":"2026-02-25T15:29:47Z","registered":"2026-02-25T15:29:48Z","published":null,"updated":"2026-02-25T15:29:48Z"},"relationships":{"client":{"data":{"id":"arxiv.content","type":"clients"}}}},{"id":"10.48550/arxiv.2602.20142","type":"dois","attributes":{"doi":"10.48550/arxiv.2602.20142","identifiers":[{"identifier":"2602.20142","identifierType":"arXiv"}],"creators":[{"nameType":"Personal","givenName":"Yuzhou","familyName":"Hao","name":"Hao, Yuzhou","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Turab","familyName":"Lookman","name":"Lookman, Turab","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Xiangdong","familyName":"Ding","name":"Ding, Xiangdong","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Jun","familyName":"Sun","name":"Sun, Jun","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Zhibin","familyName":"Gao","name":"Gao, Zhibin","affiliation":[],"nameIdentifiers":[]}],"titles":[{"title":"Role of octahedral tilting induced acoustic softening on limiting thermal transport in SrSnO3"}],"publisher":"arXiv","container":{},"publicationYear":2026,"subjects":[{"subject":"Materials Science (cond-mat.mtrl-sci)","lang":"en","subjectScheme":"arXiv"},{"subject":"FOS: Physical sciences","subjectScheme":"Fields of Science and Technology (FOS)"},{"schemeUri":"http://www.oecd.org/science/inno/38235147.pdf","subject":"FOS: Physical sciences","subjectScheme":"Fields of Science and Technology (FOS)"}],"contributors":[],"dates":[{"date":"2026-02-23T18:53:37Z","dateType":"Submitted","dateInformation":"v1"},{"date":"2026-02-25T01:19:19Z","dateType":"Updated","dateInformation":"v1"},{"date":"2026-02","dateType":"Available","dateInformation":"v1"},{"date":"2026","dateType":"Issued"}],"language":null,"types":{"schemaOrg":"CreativeWork","resourceTypeGeneral":"Preprint","citeproc":"article","bibtex":"misc","ris":"GEN","resourceType":"Article"},"relatedIdentifiers":[{"relationType":"IsVersionOf","relatedIdentifier":"10.1103/76nt-hw3h","relatedIdentifierType":"DOI"}],"relatedItems":[],"sizes":[],"formats":[],"version":"1","rightsList":[{"rightsUri":"http://arxiv.org/licenses/nonexclusive-distrib/1.0/","rights":"arXiv.org perpetual, non-exclusive license"}],"descriptions":[{"descriptionType":"Abstract","description":"Octahedral tilting is a fundamental structural distortion in perovskites, governing key phenomena such as lattice stabilizing, soft phonon dynamics, group-theoretical analysis, phase transitions, ferroelectricity, and even for tunable electronic band gap. However, its influence on lattice thermal conductivity (kL) remains poorly understood. In the archetypal perovskite SrTiO3, tilting in the low-temperature tetragonal phase is known to enhance kL by suppressing specific phonon scattering channels around 200 cm-1. Here, we investigate the thermal transport in strontium stannate (SrSnO3), another perovskite oxide that undergoes temperature-driven phase transitions, and reveal a completely opposite effect. Through a systematic study across its orthorhombic, tetragonal, and cubic phases, we demonstrate that octahedral tilting in the tetragonal phase of SrSnO3 anomalously triggers acoustic phonon softening. This softening manifests as reduced frequencies and group velocities in low-frequency (\u0026lt;3 THz) acoustic modes, creating a large decrease for heat transport, particularly along the c-axis. Consequently, kL is significantly suppressed, decreasing from 7.48 W m-1 K-1 to 6.06 W m-1 K-1 as the tilting angle increases by a mere 1 degree. These findings identify tilting-induced acoustic softening as a pivotal mechanism for limiting and controlling anisotropic thermal transport in SrSnO3, presenting a stark contrast to the established behavior in SrTiO3."}],"geoLocations":[],"fundingReferences":[],"url":"https://arxiv.org/abs/2602.20142","contentUrl":null,"metadataVersion":0,"schemaVersion":"http://datacite.org/schema/kernel-4","source":"mds","isActive":true,"state":"findable","reason":null,"viewCount":0,"downloadCount":0,"referenceCount":0,"citationCount":0,"partCount":0,"partOfCount":0,"versionCount":0,"versionOfCount":1,"created":"2026-02-25T15:29:39Z","registered":"2026-02-25T15:29:40Z","published":null,"updated":"2026-02-25T15:29:40Z"},"relationships":{"client":{"data":{"id":"arxiv.content","type":"clients"}}}},{"id":"10.48550/arxiv.2602.20140","type":"dois","attributes":{"doi":"10.48550/arxiv.2602.20140","identifiers":[{"identifier":"2602.20140","identifierType":"arXiv"}],"creators":[{"nameType":"Personal","givenName":"Akshay","familyName":"Subramanian","name":"Subramanian, Akshay","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Elton","familyName":"Pan","name":"Pan, Elton","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Juno","familyName":"Nam","name":"Nam, Juno","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Maurice","familyName":"Weiler","name":"Weiler, Maurice","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Shuhui","familyName":"Qu","name":"Qu, Shuhui","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Cheol Woo","familyName":"Park","name":"Park, Cheol Woo","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Tommi S.","familyName":"Jaakkola","name":"Jaakkola, Tommi S.","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Elsa","familyName":"Olivetti","name":"Olivetti, Elsa","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Rafael","familyName":"Gomez-Bombarelli","name":"Gomez-Bombarelli, Rafael","affiliation":[],"nameIdentifiers":[]}],"titles":[{"title":"PackFlow: Generative Molecular Crystal Structure Prediction via Reinforcement Learning Alignment"}],"publisher":"arXiv","container":{},"publicationYear":2026,"subjects":[{"subject":"Chemical Physics (physics.chem-ph)","lang":"en","subjectScheme":"arXiv"},{"subject":"FOS: Physical sciences","subjectScheme":"Fields of Science and Technology (FOS)"},{"schemeUri":"http://www.oecd.org/science/inno/38235147.pdf","subject":"FOS: Physical sciences","subjectScheme":"Fields of Science and Technology (FOS)"}],"contributors":[],"dates":[{"date":"2026-02-23T18:52:13Z","dateType":"Submitted","dateInformation":"v1"},{"date":"2026-02-24T02:45:52Z","dateType":"Updated","dateInformation":"v1"},{"date":"2026-02","dateType":"Available","dateInformation":"v1"},{"date":"2026","dateType":"Issued"}],"language":null,"types":{"schemaOrg":"CreativeWork","resourceTypeGeneral":"Preprint","citeproc":"article","bibtex":"misc","ris":"GEN","resourceType":"Article"},"relatedIdentifiers":[],"relatedItems":[],"sizes":[],"formats":[],"version":"1","rightsList":[{"rightsIdentifierScheme":"SPDX","rightsUri":"https://creativecommons.org/licenses/by/4.0/legalcode","schemeUri":"https://spdx.org/licenses/","rights":"Creative Commons Attribution 4.0 International","rightsIdentifier":"cc-by-4.0"}],"descriptions":[{"descriptionType":"Abstract","description":"Organic molecular crystals underpin technologies ranging from pharmaceuticals to organic electronics, yet predicting solid-state packing of molecules remains challenging because candidate generation is combinatorial and stability is only resolved after costly energy evaluations. Here we introduce PackFlow, a flow matching framework for molecular crystal structure prediction (CSP) that generates heavy-atom crystal proposals by jointly sampling Cartesian coordinates and unit-cell lattice parameters given a molecular graph. This lattice-aware generation interfaces directly with downstream relaxation and lattice-energy ranking, positioning PackFlow as a scalable proposal engine within standard CSP pipelines. To explicitly steer generation toward physically favourable regions, we propose physics alignment, a reinforcement learning post-training stage that uses machine-learned interatomic potential energies and forces as stability proxies. Physics alignment improves physical validity without altering inference-time sampling. We validate PackFlow's performance against heuristic baselines through two distinct evaluations. First, on a broad unseen set of molecular systems, we demonstrate superior candidate generation capability, with proposals exhibiting greater structural similarity to experimental polymorphs. Second, we assess the full end-to-end workflow on two unseen CSP blind-test case studies, including relaxation and lattice-energy analysis. In both settings, PackFlow outperforms heuristics-based methods by concentrating probability mass in low-energy basins, yielding candidates that relax into lower-energy minima and offering a practical route to amortize the relax-and-rank bottleneck."}],"geoLocations":[],"fundingReferences":[],"url":"https://arxiv.org/abs/2602.20140","contentUrl":null,"metadataVersion":0,"schemaVersion":"http://datacite.org/schema/kernel-4","source":"mds","isActive":true,"state":"findable","reason":null,"viewCount":0,"downloadCount":0,"referenceCount":0,"citationCount":0,"partCount":0,"partOfCount":0,"versionCount":0,"versionOfCount":0,"created":"2026-02-25T15:29:34Z","registered":"2026-02-25T15:29:35Z","published":null,"updated":"2026-02-25T15:29:35Z"},"relationships":{"client":{"data":{"id":"arxiv.content","type":"clients"}}}},{"id":"10.48550/arxiv.2602.20137","type":"dois","attributes":{"doi":"10.48550/arxiv.2602.20137","identifiers":[{"identifier":"2602.20137","identifierType":"arXiv"}],"creators":[{"nameType":"Personal","givenName":"Martin","familyName":"Sinnona","name":"Sinnona, Martin","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Valentin","familyName":"Bonas","name":"Bonas, Valentin","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Emmanuel","familyName":"Iarussi","name":"Iarussi, Emmanuel","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Viviana","familyName":"Siless","name":"Siless, Viviana","affiliation":[],"nameIdentifiers":[]}],"titles":[{"title":"Do Large Language Models Understand Data Visualization Rules?"}],"publisher":"arXiv","container":{},"publicationYear":2026,"subjects":[{"subject":"Computer Vision and Pattern Recognition (cs.CV)","lang":"en","subjectScheme":"arXiv"},{"subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"},{"schemeUri":"http://www.oecd.org/science/inno/38235147.pdf","subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"}],"contributors":[],"dates":[{"date":"2026-02-23T18:47:51Z","dateType":"Submitted","dateInformation":"v1"},{"date":"2026-02-24T02:45:46Z","dateType":"Updated","dateInformation":"v1"},{"date":"2026-02","dateType":"Available","dateInformation":"v1"},{"date":"2026","dateType":"Issued"}],"language":null,"types":{"schemaOrg":"CreativeWork","resourceTypeGeneral":"Preprint","citeproc":"article","bibtex":"misc","ris":"GEN","resourceType":"Article"},"relatedIdentifiers":[],"relatedItems":[],"sizes":[],"formats":[],"version":"1","rightsList":[{"rightsIdentifierScheme":"SPDX","rightsUri":"https://creativecommons.org/licenses/by/4.0/legalcode","schemeUri":"https://spdx.org/licenses/","rights":"Creative Commons Attribution 4.0 International","rightsIdentifier":"cc-by-4.0"}],"descriptions":[{"descriptionType":"Abstract","description":"Data visualization rules-derived from decades of research in design and perception-ensure trustworthy chart communication. While prior work has shown that large language models (LLMs) can generate charts or flag misleading figures, it remains unclear whether they can reason about and enforce visualization rules directly. Constraint-based systems such as Draco encode these rules as logical constraints for precise automated checks, but maintaining symbolic encodings requires expert effort, motivating the use of LLMs as flexible rule validators. In this paper, we present the first systematic evaluation of LLMs against visualization rules using hard-verification ground truth derived from Answer Set Programming (ASP). We translated a subset of Draco's constraints into natural-language statements and generated a controlled dataset of 2,000 Vega-Lite specifications annotated with explicit rule violations. LLMs were evaluated on both accuracy in detecting violations and prompt adherence, which measures whether outputs follow the required structured format. Results show that frontier models achieve high adherence (Gemma 3 4B / 27B: 100%, GPT-oss 20B: 98%) and reliably detect common violations (F1 up to 0.82),yet performance drops for subtler perceptual rules (F1 \u0026lt; 0.15 for some categories) and for outputs generated from technical ASP formulations.Translating constraints into natural language improved performance by up to 150% for smaller models. These findings demonstrate the potential of LLMs as flexible, language-driven validators while highlighting their current limitations compared to symbolic solvers."}],"geoLocations":[],"fundingReferences":[],"url":"https://arxiv.org/abs/2602.20137","contentUrl":null,"metadataVersion":0,"schemaVersion":"http://datacite.org/schema/kernel-4","source":"mds","isActive":true,"state":"findable","reason":null,"viewCount":0,"downloadCount":0,"referenceCount":0,"citationCount":0,"partCount":0,"partOfCount":0,"versionCount":0,"versionOfCount":0,"created":"2026-02-25T15:29:27Z","registered":"2026-02-25T15:29:28Z","published":null,"updated":"2026-02-25T15:29:28Z"},"relationships":{"client":{"data":{"id":"arxiv.content","type":"clients"}}}},{"id":"10.48550/arxiv.2602.20136","type":"dois","attributes":{"doi":"10.48550/arxiv.2602.20136","identifiers":[{"identifier":"2602.20136","identifierType":"arXiv"}],"creators":[{"nameType":"Personal","givenName":"Sergio","familyName":"Mayorga","name":"Mayorga, Sergio","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Eugene","familyName":"Stepanov","name":"Stepanov, Eugene","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Pedro","familyName":"Barrios","name":"Barrios, Pedro","affiliation":[],"nameIdentifiers":[]}],"titles":[{"title":"On a discrete max-plus transportation problem"}],"publisher":"arXiv","container":{},"publicationYear":2026,"subjects":[{"subject":"Optimization and Control (math.OC)","lang":"en","subjectScheme":"arXiv"},{"subject":"Combinatorics (math.CO)","lang":"en","subjectScheme":"arXiv"},{"subject":"Probability (math.PR)","lang":"en","subjectScheme":"arXiv"},{"subject":"FOS: Mathematics","subjectScheme":"Fields of Science and Technology (FOS)"},{"schemeUri":"http://www.oecd.org/science/inno/38235147.pdf","subject":"FOS: Mathematics","subjectScheme":"Fields of Science and Technology (FOS)"}],"contributors":[],"dates":[{"date":"2026-02-23T18:47:18Z","dateType":"Submitted","dateInformation":"v1"},{"date":"2026-02-24T02:45:45Z","dateType":"Updated","dateInformation":"v1"},{"date":"2026-02","dateType":"Available","dateInformation":"v1"},{"date":"2026","dateType":"Issued"}],"language":null,"types":{"schemaOrg":"CreativeWork","resourceTypeGeneral":"Preprint","citeproc":"article","bibtex":"misc","ris":"GEN","resourceType":"Article"},"relatedIdentifiers":[],"relatedItems":[],"sizes":[],"formats":[],"version":"1","rightsList":[{"rightsUri":"http://arxiv.org/licenses/nonexclusive-distrib/1.0/","rights":"arXiv.org perpetual, non-exclusive license"}],"descriptions":[{"descriptionType":"Abstract","description":"We provide an explicit algorithm to solve the idempotent analogue of the discrete Monge-Kantorovich optimal mass transportation problem with the usual real number field replaced by the tropical (max-plus) semiring, in which addition is defined as the maximum and product is defined as usual addition, with minus infinity and zero playing the roles of additive and multiplicative identities. Such a problem may be naturally called tropical or \"max-plus\" optimal transportation problem. We show that the solutions to the latter, called the optimal tropical plans, may not correspond to perfect matchings even if the data (max-plus probability measures) have all weights equal to zero, in contrast with the classical discrete optimal transportation analogue, where perfect matching optimal plans in similar situations always exist. Nevertheless, in some randomized situation the existence of perfect matching optimal tropical plans may occur rather frequently. At last, we prove that the uniqueness of solutions of the optimal tropical transportation problem is quite rare."}],"geoLocations":[],"fundingReferences":[],"url":"https://arxiv.org/abs/2602.20136","contentUrl":null,"metadataVersion":0,"schemaVersion":"http://datacite.org/schema/kernel-4","source":"mds","isActive":true,"state":"findable","reason":null,"viewCount":0,"downloadCount":0,"referenceCount":0,"citationCount":0,"partCount":0,"partOfCount":0,"versionCount":0,"versionOfCount":0,"created":"2026-02-25T15:29:24Z","registered":"2026-02-25T15:29:25Z","published":null,"updated":"2026-02-25T15:29:25Z"},"relationships":{"client":{"data":{"id":"arxiv.content","type":"clients"}}}},{"id":"10.48550/arxiv.2602.20133","type":"dois","attributes":{"doi":"10.48550/arxiv.2602.20133","identifiers":[{"identifier":"2602.20133","identifierType":"arXiv"}],"creators":[{"nameType":"Personal","givenName":"Mert","familyName":"Cemri","name":"Cemri, Mert","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Shubham","familyName":"Agrawal","name":"Agrawal, Shubham","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Akshat","familyName":"Gupta","name":"Gupta, Akshat","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Shu","familyName":"Liu","name":"Liu, Shu","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Audrey","familyName":"Cheng","name":"Cheng, Audrey","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Qiuyang","familyName":"Mang","name":"Mang, Qiuyang","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Ashwin","familyName":"Naren","name":"Naren, Ashwin","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Lutfi Eren","familyName":"Erdogan","name":"Erdogan, Lutfi Eren","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Koushik","familyName":"Sen","name":"Sen, Koushik","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Matei","familyName":"Zaharia","name":"Zaharia, Matei","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Alex","familyName":"Dimakis","name":"Dimakis, Alex","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Ion","familyName":"Stoica","name":"Stoica, Ion","affiliation":[],"nameIdentifiers":[]}],"titles":[{"title":"AdaEvolve: Adaptive LLM Driven Zeroth-Order Optimization"}],"publisher":"arXiv","container":{},"publicationYear":2026,"subjects":[{"subject":"Neural and Evolutionary Computing (cs.NE)","lang":"en","subjectScheme":"arXiv"},{"subject":"Artificial Intelligence (cs.AI)","lang":"en","subjectScheme":"arXiv"},{"subject":"Computation and Language (cs.CL)","lang":"en","subjectScheme":"arXiv"},{"subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"},{"schemeUri":"http://www.oecd.org/science/inno/38235147.pdf","subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"}],"contributors":[],"dates":[{"date":"2026-02-23T18:45:31Z","dateType":"Submitted","dateInformation":"v1"},{"date":"2026-02-24T02:45:36Z","dateType":"Updated","dateInformation":"v1"},{"date":"2026-02","dateType":"Available","dateInformation":"v1"},{"date":"2026","dateType":"Issued"}],"language":null,"types":{"schemaOrg":"CreativeWork","resourceTypeGeneral":"Preprint","citeproc":"article","bibtex":"misc","ris":"GEN","resourceType":"Article"},"relatedIdentifiers":[],"relatedItems":[],"sizes":[],"formats":[],"version":"1","rightsList":[{"rightsIdentifierScheme":"SPDX","rightsUri":"https://creativecommons.org/licenses/by/4.0/legalcode","schemeUri":"https://spdx.org/licenses/","rights":"Creative Commons Attribution 4.0 International","rightsIdentifier":"cc-by-4.0"}],"descriptions":[{"descriptionType":"Abstract","description":"The paradigm of automated program generation is shifting from one-shot generation to inference-time search, where Large Language Models (LLMs) function as semantic mutation operators within evolutionary loops. While effective, these systems are currently governed by static schedules that fail to account for the non-stationary dynamics of the search process. This rigidity results in substantial computational waste, as resources are indiscriminately allocated to stagnating populations while promising frontiers remain under-exploited. We introduce AdaEvolve, a framework that reformulates LLM-driven evolution as a hierarchical adaptive optimization problem. AdaEvolve uses an \"accumulated improvement signal\" to unify decisions across three levels: Local Adaptation, which dynamically modulates the exploration intensity within a population of solution candidates; Global Adaptation, which routes the global resource budget via bandit-based scheduling across different solution candidate populations; and Meta-Guidance which generates novel solution tactics based on the previously generated solutions and their corresponding improvements when the progress stalls. We demonstrate that AdaEvolve consistently outperforms the open-sourced baselines across 185 different open-ended optimization problems including combinatorial, systems optimization and algorithm design problems."}],"geoLocations":[],"fundingReferences":[],"url":"https://arxiv.org/abs/2602.20133","contentUrl":null,"metadataVersion":0,"schemaVersion":"http://datacite.org/schema/kernel-4","source":"mds","isActive":true,"state":"findable","reason":null,"viewCount":0,"downloadCount":0,"referenceCount":0,"citationCount":0,"partCount":0,"partOfCount":0,"versionCount":0,"versionOfCount":0,"created":"2026-02-25T15:29:17Z","registered":"2026-02-25T15:29:17Z","published":null,"updated":"2026-02-25T15:29:17Z"},"relationships":{"client":{"data":{"id":"arxiv.content","type":"clients"}}}},{"id":"10.48550/arxiv.2602.20132","type":"dois","attributes":{"doi":"10.48550/arxiv.2602.20132","identifiers":[{"identifier":"2602.20132","identifierType":"arXiv"}],"creators":[{"nameType":"Personal","givenName":"Wendi","familyName":"Li","name":"Li, Wendi","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Sharon","familyName":"Li","name":"Li, Sharon","affiliation":[],"nameIdentifiers":[]}],"titles":[{"title":"LAD: Learning Advantage Distribution for Reasoning"}],"publisher":"arXiv","container":{},"publicationYear":2026,"subjects":[{"subject":"Machine Learning (cs.LG)","lang":"en","subjectScheme":"arXiv"},{"subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"},{"schemeUri":"http://www.oecd.org/science/inno/38235147.pdf","subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"}],"contributors":[],"dates":[{"date":"2026-02-23T18:44:10Z","dateType":"Submitted","dateInformation":"v1"},{"date":"2026-02-24T02:45:29Z","dateType":"Updated","dateInformation":"v1"},{"date":"2026-02","dateType":"Available","dateInformation":"v1"},{"date":"2026","dateType":"Issued"}],"language":null,"types":{"schemaOrg":"CreativeWork","resourceTypeGeneral":"Preprint","citeproc":"article","bibtex":"misc","ris":"GEN","resourceType":"Article"},"relatedIdentifiers":[],"relatedItems":[],"sizes":[],"formats":[],"version":"1","rightsList":[{"rightsUri":"http://arxiv.org/licenses/nonexclusive-distrib/1.0/","rights":"arXiv.org perpetual, non-exclusive license"}],"descriptions":[{"descriptionType":"Abstract","description":"Current reinforcement learning objectives for large-model reasoning primarily focus on maximizing expected rewards. This paradigm can lead to overfitting to dominant reward signals, while neglecting alternative yet valid reasoning trajectories, thereby limiting diversity and exploration. To address this issue, we introduce Learning Advantage Distributions (LAD), a distribution-matching framework that replaces advantage maximization with learning the advantage-induced distribution. By establishing the equivalence between the optimal policy update and an advantage-based target distribution, we derive a practical LAD objective formulated as minimizing an $f$-divergence between the policy-induced and advantage-induced distributions. This yields a gradient update that increases likelihood for high-advantage responses while suppressing over-confident probability growth, preventing collapse without requiring auxiliary entropy regularization. LAD incurs no extra training cost compared to GRPO and scales naturally to LLM post-training. In a controlled bandit setting, LAD faithfully recovers the multimodal advantage distribution, validating the theoretical formulation. Experiments on math and code reasoning tasks across several LLM backbones show that LAD reliably improves both accuracy and generative diversity."}],"geoLocations":[],"fundingReferences":[],"url":"https://arxiv.org/abs/2602.20132","contentUrl":null,"metadataVersion":0,"schemaVersion":"http://datacite.org/schema/kernel-4","source":"mds","isActive":true,"state":"findable","reason":null,"viewCount":0,"downloadCount":0,"referenceCount":0,"citationCount":0,"partCount":0,"partOfCount":0,"versionCount":0,"versionOfCount":0,"created":"2026-02-25T15:29:14Z","registered":"2026-02-25T15:29:15Z","published":null,"updated":"2026-02-25T15:29:15Z"},"relationships":{"client":{"data":{"id":"arxiv.content","type":"clients"}}}},{"id":"10.48550/arxiv.2602.20131","type":"dois","attributes":{"doi":"10.48550/arxiv.2602.20131","identifiers":[{"identifier":"2602.20131","identifierType":"arXiv"}],"creators":[{"nameType":"Personal","givenName":"Dengjun","familyName":"Guo","name":"Guo, Dengjun","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"In-Jee","familyName":"Jeong","name":"Jeong, In-Jee","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Lifeng","familyName":"Zhao","name":"Zhao, Lifeng","affiliation":[],"nameIdentifiers":[]}],"titles":[{"title":"Global dynamics of a single vortex ring"}],"publisher":"arXiv","container":{},"publicationYear":2026,"subjects":[{"subject":"Analysis of PDEs (math.AP)","lang":"en","subjectScheme":"arXiv"},{"subject":"FOS: Mathematics","subjectScheme":"Fields of Science and Technology (FOS)"},{"schemeUri":"http://www.oecd.org/science/inno/38235147.pdf","subject":"FOS: Mathematics","subjectScheme":"Fields of Science and Technology (FOS)"}],"contributors":[],"dates":[{"date":"2026-02-23T18:43:52Z","dateType":"Submitted","dateInformation":"v1"},{"date":"2026-02-24T02:45:28Z","dateType":"Updated","dateInformation":"v1"},{"date":"2026-02","dateType":"Available","dateInformation":"v1"},{"date":"2026","dateType":"Issued"}],"language":null,"types":{"schemaOrg":"CreativeWork","resourceTypeGeneral":"Preprint","citeproc":"article","bibtex":"misc","ris":"GEN","resourceType":"Article"},"relatedIdentifiers":[],"relatedItems":[],"sizes":[],"formats":[],"version":"1","rightsList":[{"rightsUri":"http://arxiv.org/licenses/nonexclusive-distrib/1.0/","rights":"arXiv.org perpetual, non-exclusive license"}],"descriptions":[{"descriptionType":"Abstract","description":"We study the global-in-time dynamics of vortex rings for the three-dimensional incompressible Euler equations, under the assumption of axisymmetric flows without swirl.\n For a broad class of initial data sharing only the macroscopic invariants with a thin vortex ring, we prove that the vorticity remains sharply concentrated and propagates along the symmetry axis with leading-order speed given by the Kelvin--Hicks formula, providing the first global-in-time validation of the vortex filament conjecture for a single vortex ring arising from generic initial data.\n We further identify a universal filamentation mechanism driven by the competition between rapid core translation and slower local induction. This mechanism gives linear-in-time stretching of the vortex support under very general assumptions on the data, yielding dynamical instability of any thin vortex ring configurations in the $W^{2,\\infty}$ norm."},{"descriptionType":"Other","description":"23 pages"}],"geoLocations":[],"fundingReferences":[],"url":"https://arxiv.org/abs/2602.20131","contentUrl":null,"metadataVersion":0,"schemaVersion":"http://datacite.org/schema/kernel-4","source":"mds","isActive":true,"state":"findable","reason":null,"viewCount":0,"downloadCount":0,"referenceCount":0,"citationCount":0,"partCount":0,"partOfCount":0,"versionCount":0,"versionOfCount":0,"created":"2026-02-25T15:29:12Z","registered":"2026-02-25T15:29:13Z","published":null,"updated":"2026-02-25T15:29:13Z"},"relationships":{"client":{"data":{"id":"arxiv.content","type":"clients"}}}},{"id":"10.48550/arxiv.2602.20130","type":"dois","attributes":{"doi":"10.48550/arxiv.2602.20130","identifiers":[{"identifier":"2602.20130","identifierType":"arXiv"}],"creators":[{"nameType":"Personal","givenName":"Zaifu","familyName":"Zhan","name":"Zhan, Zaifu","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Min","familyName":"Zeng","name":"Zeng, Min","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Shuang","familyName":"Zhou","name":"Zhou, Shuang","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Yiran","familyName":"Song","name":"Song, Yiran","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Xiaoyi","familyName":"Chen","name":"Chen, Xiaoyi","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Yu","familyName":"Hou","name":"Hou, Yu","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Yifan","familyName":"Wu","name":"Wu, Yifan","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Yang","familyName":"Ruan","name":"Ruan, Yang","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Rui","familyName":"Zhang","name":"Zhang, Rui","affiliation":[],"nameIdentifiers":[]}],"titles":[{"title":"To Reason or Not to: Selective Chain-of-Thought in Medical Question Answering"}],"publisher":"arXiv","container":{},"publicationYear":2026,"subjects":[{"subject":"Computation and Language (cs.CL)","lang":"en","subjectScheme":"arXiv"},{"subject":"Artificial Intelligence (cs.AI)","lang":"en","subjectScheme":"arXiv"},{"subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"},{"schemeUri":"http://www.oecd.org/science/inno/38235147.pdf","subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"}],"contributors":[],"dates":[{"date":"2026-02-23T18:42:50Z","dateType":"Submitted","dateInformation":"v1"},{"date":"2026-02-24T02:45:27Z","dateType":"Updated","dateInformation":"v1"},{"date":"2026-02","dateType":"Available","dateInformation":"v1"},{"date":"2026","dateType":"Issued"}],"language":null,"types":{"schemaOrg":"CreativeWork","resourceTypeGeneral":"Preprint","citeproc":"article","bibtex":"misc","ris":"GEN","resourceType":"Article"},"relatedIdentifiers":[],"relatedItems":[],"sizes":[],"formats":[],"version":"1","rightsList":[{"rightsUri":"http://arxiv.org/licenses/nonexclusive-distrib/1.0/","rights":"arXiv.org perpetual, non-exclusive license"}],"descriptions":[{"descriptionType":"Abstract","description":"Objective: To improve the efficiency of medical question answering (MedQA) with large language models (LLMs) by avoiding unnecessary reasoning while maintaining accuracy.\n Methods: We propose Selective Chain-of-Thought (Selective CoT), an inference-time strategy that first predicts whether a question requires reasoning and generates a rationale only when needed. Two open-source LLMs (Llama-3.1-8B and Qwen-2.5-7B) were evaluated on four biomedical QA benchmarks-HeadQA, MedQA-USMLE, MedMCQA, and PubMedQA. Metrics included accuracy, total generated tokens, and inference time.\n Results: Selective CoT reduced inference time by 13-45% and token usage by 8-47% with minimal accuracy loss ($\\leq$4\\%). In some model-task pairs, it achieved both higher accuracy and greater efficiency than standard CoT. Compared with fixed-length CoT, Selective CoT reached similar or superior accuracy at substantially lower computational cost.\n Discussion: Selective CoT dynamically balances reasoning depth and efficiency by invoking explicit reasoning only when beneficial, reducing redundancy on recall-type questions while preserving interpretability.\n Conclusion: Selective CoT provides a simple, model-agnostic, and cost-effective approach for medical QA, aligning reasoning effort with question complexity to enhance real-world deployability of LLM-based clinical systems."}],"geoLocations":[],"fundingReferences":[],"url":"https://arxiv.org/abs/2602.20130","contentUrl":null,"metadataVersion":0,"schemaVersion":"http://datacite.org/schema/kernel-4","source":"mds","isActive":true,"state":"findable","reason":null,"viewCount":0,"downloadCount":0,"referenceCount":0,"citationCount":0,"partCount":0,"partOfCount":0,"versionCount":0,"versionOfCount":0,"created":"2026-02-25T15:29:09Z","registered":"2026-02-25T15:29:10Z","published":null,"updated":"2026-02-25T15:29:10Z"},"relationships":{"client":{"data":{"id":"arxiv.content","type":"clients"}}}},{"id":"10.48550/arxiv.2602.20129","type":"dois","attributes":{"doi":"10.48550/arxiv.2602.20129","identifiers":[{"identifier":"2602.20129","identifierType":"arXiv"}],"creators":[{"nameType":"Personal","givenName":"Anna","familyName":"Benediktová","name":"Benediktová, Anna","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Lucie","familyName":"Nedvědová","name":"Nedvědová, Lucie","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Michal","familyName":"Procházka","name":"Procházka, Michal","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Zdeněk","familyName":"Jansa","name":"Jansa, Zdeněk","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Štěpánka","familyName":"Jansová","name":"Jansová, Štěpánka","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Christopher D.","familyName":"Woodgate","name":"Woodgate, Christopher D.","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"David","familyName":"Redka","name":"Redka, David","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Julie B.","familyName":"Staunton","name":"Staunton, Julie B.","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Ján","familyName":"Minár","name":"Minár, Ján","affiliation":[],"nameIdentifiers":[]}],"titles":[{"title":"Microstructural Evolution and Crystallization Behavior of Amorphous Medium-Entropy Ti-Nb-Zr-Ag Thin Films"}],"publisher":"arXiv","container":{},"publicationYear":2026,"subjects":[{"subject":"Materials Science (cond-mat.mtrl-sci)","lang":"en","subjectScheme":"arXiv"},{"subject":"FOS: Physical sciences","subjectScheme":"Fields of Science and Technology (FOS)"},{"schemeUri":"http://www.oecd.org/science/inno/38235147.pdf","subject":"FOS: Physical sciences","subjectScheme":"Fields of Science and Technology (FOS)"}],"contributors":[],"dates":[{"date":"2026-02-23T18:42:48Z","dateType":"Submitted","dateInformation":"v1"},{"date":"2026-02-24T02:45:23Z","dateType":"Updated","dateInformation":"v1"},{"date":"2026-02","dateType":"Available","dateInformation":"v1"},{"date":"2026","dateType":"Issued"}],"language":null,"types":{"schemaOrg":"CreativeWork","resourceTypeGeneral":"Preprint","citeproc":"article","bibtex":"misc","ris":"GEN","resourceType":"Article"},"relatedIdentifiers":[],"relatedItems":[],"sizes":[],"formats":[],"version":"1","rightsList":[{"rightsUri":"http://arxiv.org/licenses/nonexclusive-distrib/1.0/","rights":"arXiv.org perpetual, non-exclusive license"}],"descriptions":[{"descriptionType":"Abstract","description":"Improving the performance of metallic implants increasingly relies on the development of multifunctional surface modifications that combine structural stability, bioactivity, and prevention of bacterial colonization. Medium-entropy alloys (MEAs) represent a promising approach for such coatings, as their chemical complexity allows the formation of structurally stable matrices with tunable properties. In this study, Ti-Nb-Zr and Ti-Nb-Zr-Ag thin films were deposited by magnetron sputtering and subjected to annealing at temperatures of up to 1100 $^{\\circ}$C to evaluate the influence of Ag, added for its antibacterial potential, on structural evolution. The as-deposited Ag-free film was fully amorphous, whereas the Ag-containing film exhibited a predominantly amorphous matrix with finely dispersed crystalline nanoparticles, indicating that Ag promoted early-stage crystallization. Both films displayed a fine columnar morphology (column diameter $\\sim$15 nm) with dome-like protrusions, a hierarchical surface structure favorable for protein adhesion. Upon annealing, the Ag-free film recrystallized into a granular, loosely packed morphology, while the Ag-containing film retained a compact structure, demonstrating the stabilizing role of Ag. These findings underscore the potential of Ag-containing amorphous MEAs for forming multifunctional coatings with enhanced thermal stability, antibacterial functionality, and biointerface-relevant surface features for advanced biomedical applications."},{"descriptionType":"Other","description":"11 pages, 5 figures"}],"geoLocations":[],"fundingReferences":[],"url":"https://arxiv.org/abs/2602.20129","contentUrl":null,"metadataVersion":0,"schemaVersion":"http://datacite.org/schema/kernel-4","source":"mds","isActive":true,"state":"findable","reason":null,"viewCount":0,"downloadCount":0,"referenceCount":0,"citationCount":0,"partCount":0,"partOfCount":0,"versionCount":0,"versionOfCount":0,"created":"2026-02-25T15:29:06Z","registered":"2026-02-25T15:29:07Z","published":null,"updated":"2026-02-25T15:29:07Z"},"relationships":{"client":{"data":{"id":"arxiv.content","type":"clients"}}}},{"id":"10.48550/arxiv.2602.20128","type":"dois","attributes":{"doi":"10.48550/arxiv.2602.20128","identifiers":[{"identifier":"2602.20128","identifierType":"arXiv"}],"creators":[{"nameType":"Personal","givenName":"Elia","familyName":"Perego","name":"Perego, Elia","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Andrea","familyName":"Rodriguez-Blanco","name":"Rodriguez-Blanco, Andrea","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"K. Birgitta","familyName":"Whaley","name":"Whaley, K. Birgitta","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Bharath Hebbe","familyName":"Madhusudhana","name":"Madhusudhana, Bharath Hebbe","affiliation":[],"nameIdentifiers":[]}],"titles":[{"title":"Experimental characterization of coherent and non-Markovian errors using tangent space decomposition"}],"publisher":"arXiv","container":{},"publicationYear":2026,"subjects":[{"subject":"Quantum Physics (quant-ph)","lang":"en","subjectScheme":"arXiv"},{"subject":"FOS: Physical sciences","subjectScheme":"Fields of Science and Technology (FOS)"},{"schemeUri":"http://www.oecd.org/science/inno/38235147.pdf","subject":"FOS: Physical sciences","subjectScheme":"Fields of Science and Technology (FOS)"}],"contributors":[],"dates":[{"date":"2026-02-23T18:42:40Z","dateType":"Submitted","dateInformation":"v1"},{"date":"2026-02-24T02:45:22Z","dateType":"Updated","dateInformation":"v1"},{"date":"2026-02","dateType":"Available","dateInformation":"v1"},{"date":"2026","dateType":"Issued"}],"language":null,"types":{"schemaOrg":"CreativeWork","resourceTypeGeneral":"Preprint","citeproc":"article","bibtex":"misc","ris":"GEN","resourceType":"Article"},"relatedIdentifiers":[],"relatedItems":[],"sizes":[],"formats":[],"version":"1","rightsList":[{"rightsUri":"http://arxiv.org/licenses/nonexclusive-distrib/1.0/","rights":"arXiv.org perpetual, non-exclusive license"}],"descriptions":[{"descriptionType":"Abstract","description":"Accurate characterization of coherent and non-Markovian errors remains a central challenge in quantum information processing, as conventional benchmarking techniques typically rely on Markovian and time-independent noise assumptions. In practice, however, quantum devices exhibit both systematic coherent miscalibrations and temporally correlated fluctuations, which complicate error diagnosis and mitigation. Here, we apply a technique based on tangent-space decomposition to characterize such error in single-qubit quantum gates implemented on a trapped ion platform. Small imperfections in a quantum operation are treated as perturbations of the target quantum map, represented as tangent vectors in the space of quantum channels. This formulations enables a natural decomposition of the deviation into three components corresponding to coherent, Markovian and non-Markovian processes.The relative weights of these components provide a quantitative measure of the contribution from each type of error mechanism, directly from a single tomographic snapshot. We experimentally validate this method on a single-qubit gates implemented on a trapped $^{40}$Ca$^+$ ion, where control is achieved through laser-driven optical transitions. By analyzing experimentally reconstructed process matrices, expressed in the Pauli Transfer Matrix and Choi representations, we identify and quantify non-Markovian effects arising from controlled injection of slow fluctuations in the experimental environment. We also characterize deterministic coherent miscalibrations using the same technique. This approach provides a physically transparent and experimentally accessible tool for diagnosing complex error sources in quantum control systems."},{"descriptionType":"Other","description":"12 pages, 4 figures"}],"geoLocations":[],"fundingReferences":[],"url":"https://arxiv.org/abs/2602.20128","contentUrl":null,"metadataVersion":0,"schemaVersion":"http://datacite.org/schema/kernel-4","source":"mds","isActive":true,"state":"findable","reason":null,"viewCount":0,"downloadCount":0,"referenceCount":0,"citationCount":0,"partCount":0,"partOfCount":0,"versionCount":0,"versionOfCount":0,"created":"2026-02-25T15:29:04Z","registered":"2026-02-25T15:29:05Z","published":null,"updated":"2026-02-25T15:29:05Z"},"relationships":{"client":{"data":{"id":"arxiv.content","type":"clients"}}}},{"id":"10.48550/arxiv.2602.20126","type":"dois","attributes":{"doi":"10.48550/arxiv.2602.20126","identifiers":[{"identifier":"2602.20126","identifierType":"arXiv"}],"creators":[{"nameType":"Personal","givenName":"Yunxiao","familyName":"Zhao","name":"Zhao, Yunxiao","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Changxiao","familyName":"Cai","name":"Cai, Changxiao","affiliation":[],"nameIdentifiers":[]}],"titles":[{"title":"Adaptation to Intrinsic Dependence in Diffusion Language Models"}],"publisher":"arXiv","container":{},"publicationYear":2026,"subjects":[{"subject":"Machine Learning (cs.LG)","lang":"en","subjectScheme":"arXiv"},{"subject":"Information Theory (cs.IT)","lang":"en","subjectScheme":"arXiv"},{"subject":"Statistics Theory (math.ST)","lang":"en","subjectScheme":"arXiv"},{"subject":"Machine Learning (stat.ML)","lang":"en","subjectScheme":"arXiv"},{"subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"},{"schemeUri":"http://www.oecd.org/science/inno/38235147.pdf","subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"},{"subject":"FOS: Mathematics","subjectScheme":"Fields of Science and Technology (FOS)"},{"schemeUri":"http://www.oecd.org/science/inno/38235147.pdf","subject":"FOS: Mathematics","subjectScheme":"Fields of Science and Technology (FOS)"}],"contributors":[],"dates":[{"date":"2026-02-23T18:41:34Z","dateType":"Submitted","dateInformation":"v1"},{"date":"2026-02-24T02:45:15Z","dateType":"Updated","dateInformation":"v1"},{"date":"2026-02","dateType":"Available","dateInformation":"v1"},{"date":"2026","dateType":"Issued"}],"language":null,"types":{"schemaOrg":"CreativeWork","resourceTypeGeneral":"Preprint","citeproc":"article","bibtex":"misc","ris":"GEN","resourceType":"Article"},"relatedIdentifiers":[],"relatedItems":[],"sizes":[],"formats":[],"version":"1","rightsList":[{"rightsIdentifierScheme":"SPDX","rightsUri":"https://creativecommons.org/licenses/by/4.0/legalcode","schemeUri":"https://spdx.org/licenses/","rights":"Creative Commons Attribution 4.0 International","rightsIdentifier":"cc-by-4.0"}],"descriptions":[{"descriptionType":"Abstract","description":"Diffusion language models (DLMs) have recently emerged as a promising alternative to autoregressive (AR) approaches, enabling parallel token generation beyond a rigid left-to-right order. Despite growing empirical success, the theoretical understanding of how unmasking schedules -- which specify the order and size of unmasked tokens during sampling -- affect generation quality remains limited. In this work, we introduce a distribution-agnostic unmasking schedule for DLMs that adapts to the (unknown) dependence structure of the target data distribution, without requiring any prior knowledge or hyperparameter tuning. In contrast to prior deterministic procedures that fix unmasking sizes, our method randomizes the number of tokens revealed at each iteration. We show that, for two specific parameter choices, the sampling convergence guarantees -- measured by Kullback-Leibler (KL) divergence -- scale as $\\widetilde O(\\mathsf{TC}/K)$ and $\\widetilde O(\\mathsf{DTC}/K)$ respectively. Here, $K$ is the number of iterations, and $\\mathsf{TC}$ and $\\mathsf{DTC}$ are the total correlation and dual total correlation of the target distribution, capturing the intrinsic dependence structure underlying the data. Importantly, our guarantees hold in the practically relevant parallel-sampling regime $K"}],"geoLocations":[],"fundingReferences":[],"url":"https://arxiv.org/abs/2602.20126","contentUrl":null,"metadataVersion":0,"schemaVersion":"http://datacite.org/schema/kernel-4","source":"mds","isActive":true,"state":"findable","reason":null,"viewCount":0,"downloadCount":0,"referenceCount":0,"citationCount":0,"partCount":0,"partOfCount":0,"versionCount":0,"versionOfCount":0,"created":"2026-02-25T15:28:59Z","registered":"2026-02-25T15:28:59Z","published":null,"updated":"2026-02-25T15:28:59Z"},"relationships":{"client":{"data":{"id":"arxiv.content","type":"clients"}}}},{"id":"10.48550/arxiv.2602.20124","type":"dois","attributes":{"doi":"10.48550/arxiv.2602.20124","identifiers":[{"identifier":"2602.20124","identifierType":"arXiv"}],"creators":[{"nameType":"Personal","givenName":"Benjy","familyName":"Firester","name":"Firester, Benjy","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Raphael","familyName":"Tsiamis","name":"Tsiamis, Raphael","affiliation":[],"nameIdentifiers":[]}],"titles":[{"title":"New minimal surfaces in the sphere from capillary minimal cones"}],"publisher":"arXiv","container":{},"publicationYear":2026,"subjects":[{"subject":"Differential Geometry (math.DG)","lang":"en","subjectScheme":"arXiv"},{"subject":"Analysis of PDEs (math.AP)","lang":"en","subjectScheme":"arXiv"},{"subject":"FOS: Mathematics","subjectScheme":"Fields of Science and Technology (FOS)"},{"schemeUri":"http://www.oecd.org/science/inno/38235147.pdf","subject":"FOS: Mathematics","subjectScheme":"Fields of Science and Technology (FOS)"}],"contributors":[],"dates":[{"date":"2026-02-23T18:39:19Z","dateType":"Submitted","dateInformation":"v1"},{"date":"2026-02-24T02:45:13Z","dateType":"Updated","dateInformation":"v1"},{"date":"2026-02","dateType":"Available","dateInformation":"v1"},{"date":"2026","dateType":"Issued"}],"language":null,"types":{"schemaOrg":"CreativeWork","resourceTypeGeneral":"Preprint","citeproc":"article","bibtex":"misc","ris":"GEN","resourceType":"Article"},"relatedIdentifiers":[],"relatedItems":[],"sizes":[],"formats":[],"version":"1","rightsList":[{"rightsUri":"http://arxiv.org/licenses/nonexclusive-distrib/1.0/","rights":"arXiv.org perpetual, non-exclusive license"}],"descriptions":[{"descriptionType":"Abstract","description":"For every $p,q\\geq 1$, we construct minimal embeddings of $\\mathbb{S}^p \\times \\mathbb{S}^q \\times \\mathbb{S}^1$ in $\\mathbb{S}^{p + q + 2}$ by doubling the links of free-boundary minimal cones in $\\mathbb{R}^{p+q+3}$ with bi-orthogonal symmetry. This solves problems posed by Hsiang-Lawson and Hsiang-Hsiang. The equivariance reduces the minimal surface equation to an ODE, and we prove the existence of capillary minimal cones for every contact angle. We obtain free-boundary solutions as limits of capillary surfaces via a singular shooting problem with infinite initial slope. As the contact angle degenerates to $0$, rescalings of the capillary cones converge to a homogeneous solution of the one-phase Bernoulli problem, further illustrating the connection between one-phase free boundaries and minimal surfaces through the capillary functional."}],"geoLocations":[],"fundingReferences":[],"url":"https://arxiv.org/abs/2602.20124","contentUrl":null,"metadataVersion":0,"schemaVersion":"http://datacite.org/schema/kernel-4","source":"mds","isActive":true,"state":"findable","reason":null,"viewCount":0,"downloadCount":0,"referenceCount":0,"citationCount":0,"partCount":0,"partOfCount":0,"versionCount":0,"versionOfCount":0,"created":"2026-02-25T15:28:54Z","registered":"2026-02-25T15:28:54Z","published":null,"updated":"2026-02-25T15:28:54Z"},"relationships":{"client":{"data":{"id":"arxiv.content","type":"clients"}}}},{"id":"10.48550/arxiv.2602.20123","type":"dois","attributes":{"doi":"10.48550/arxiv.2602.20123","identifiers":[{"identifier":"2602.20123","identifierType":"arXiv"}],"creators":[{"nameType":"Personal","givenName":"Maxwell","familyName":"Poster","name":"Poster, Maxwell","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Sayam","familyName":"Sethi","name":"Sethi, Sayam","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Jonathan","familyName":"Baker","name":"Baker, Jonathan","affiliation":[],"nameIdentifiers":[]}],"titles":[{"title":"CQM: Cyclic Qubit Mappings"}],"publisher":"arXiv","container":{},"publicationYear":2026,"subjects":[{"subject":"Quantum Physics (quant-ph)","lang":"en","subjectScheme":"arXiv"},{"subject":"FOS: Physical sciences","subjectScheme":"Fields of Science and Technology (FOS)"},{"schemeUri":"http://www.oecd.org/science/inno/38235147.pdf","subject":"FOS: Physical sciences","subjectScheme":"Fields of Science and Technology (FOS)"}],"contributors":[],"dates":[{"date":"2026-02-23T18:38:04Z","dateType":"Submitted","dateInformation":"v1"},{"date":"2026-02-24T02:45:06Z","dateType":"Updated","dateInformation":"v1"},{"date":"2026-02-24T07:07:45Z","dateType":"Submitted","dateInformation":"v2"},{"date":"2026-02-25T01:27:32Z","dateType":"Updated","dateInformation":"v2"},{"date":"2026-02","dateType":"Available","dateInformation":"v1"},{"date":"2026","dateType":"Issued"}],"language":null,"types":{"schemaOrg":"CreativeWork","resourceTypeGeneral":"Preprint","citeproc":"article","bibtex":"misc","ris":"GEN","resourceType":"Article"},"relatedIdentifiers":[{"relationType":"IsVersionOf","relatedIdentifier":"10.1109/qce60285.2024.00125","relatedIdentifierType":"DOI"}],"relatedItems":[],"sizes":[],"formats":[],"version":"2","rightsList":[{"rightsIdentifierScheme":"SPDX","rightsUri":"https://creativecommons.org/licenses/by/4.0/legalcode","schemeUri":"https://spdx.org/licenses/","rights":"Creative Commons Attribution 4.0 International","rightsIdentifier":"cc-by-4.0"}],"descriptions":[{"descriptionType":"Abstract","description":"Quantum computers show promise to solve select problems otherwise intractable on classical computers. However, noisy intermediate-scale quantum (NISQ) era devices are currently prone to various sources of error. Quantum error correction (QEC) shows promise as a path towards fault tolerant quantum computing. Surface codes, in particular, have become ubiquitous throughout literature for their efficacy as a quantum error correcting code, and can execute quantum circuits via lattice surgery operations. Lattice surgery also allows for logical qubits to maneuver around the architecture, if there is space for it. Hardware used for near-term demonstrations have both spatially and temporally varying error results in logical qubits. By maneuvering logical qubits around the topology, an average logical error rate (LER) can be enforced. We propose cyclic qubit mappings (CQM), a dynamic remapping technique implemented during compilation to mitigate hardware heterogeneity by expanding and contracting logical qubits. In addition to LER averaging, CQM shows initial promise given it's minimal execution time overhead and effective resource utilization."}],"geoLocations":[],"fundingReferences":[],"url":"https://arxiv.org/abs/2602.20123","contentUrl":null,"metadataVersion":0,"schemaVersion":"http://datacite.org/schema/kernel-4","source":"mds","isActive":true,"state":"findable","reason":null,"viewCount":0,"downloadCount":0,"referenceCount":0,"citationCount":0,"partCount":0,"partOfCount":0,"versionCount":0,"versionOfCount":1,"created":"2026-02-25T15:28:51Z","registered":"2026-02-25T15:28:52Z","published":null,"updated":"2026-02-25T15:28:52Z"},"relationships":{"client":{"data":{"id":"arxiv.content","type":"clients"}}}},{"id":"10.48550/arxiv.2602.20120","type":"dois","attributes":{"doi":"10.48550/arxiv.2602.20120","identifiers":[{"identifier":"2602.20120","identifierType":"arXiv"}],"creators":[{"nameType":"Personal","givenName":"Rafael Corsi","familyName":"Ferrao","name":"Ferrao, Rafael Corsi","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Luciano Pereira","familyName":"Soares","name":"Soares, Luciano Pereira","affiliation":[],"nameIdentifiers":[]}],"titles":[{"title":"Enhancing Capstone Program Workflow: A Case Study on a Platform for Managing Academic-Industry Projects"}],"publisher":"arXiv","container":{},"publicationYear":2026,"subjects":[{"subject":"Computers and Society (cs.CY)","lang":"en","subjectScheme":"arXiv"},{"subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"},{"schemeUri":"http://www.oecd.org/science/inno/38235147.pdf","subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"}],"contributors":[],"dates":[{"date":"2026-02-23T18:35:20Z","dateType":"Submitted","dateInformation":"v1"},{"date":"2026-02-24T02:44:53Z","dateType":"Updated","dateInformation":"v1"},{"date":"2026-02","dateType":"Available","dateInformation":"v1"},{"date":"2026","dateType":"Issued"}],"language":null,"types":{"schemaOrg":"CreativeWork","resourceTypeGeneral":"Preprint","citeproc":"article","bibtex":"misc","ris":"GEN","resourceType":"Article"},"relatedIdentifiers":[{"relationType":"IsVersionOf","relatedIdentifier":"10.5281/zenodo.15850131","relatedIdentifierType":"DOI"}],"relatedItems":[],"sizes":[],"formats":[],"version":"1","rightsList":[{"rightsIdentifierScheme":"SPDX","rightsUri":"https://creativecommons.org/licenses/by/4.0/legalcode","schemeUri":"https://spdx.org/licenses/","rights":"Creative Commons Attribution 4.0 International","rightsIdentifier":"cc-by-4.0"}],"descriptions":[{"descriptionType":"Abstract","description":"Capstone projects are widely adopted by universities around the world as a culminating assessment in bachelor's degree programs. These projects typically involve student teams tackling complex, real-world problems proposed by external stakeholders, such as companies, NGOs, or research centers. Although they offer valuable hands-on experience, managing Capstone projects can be challenging due to their multiple stages and demands. The process typically begins by identifying students' interests, followed by sourcing and selecting potential projects from external organizations. After presenting these options to students, groups must be formed based on various criteria, including academic ranking, GPA, previous experience, and individual skill sets.\n In this paper, we detail a web-based tool designed to streamline the management of Capstone projects at Insper, with an emphasis on project sourcing and group formation. We also discuss the technological solutions and the challenges encountered throughout development and deployment. Furthermore, we present usage data from recent years, offering insights that may prove valuable for institutions or teams developing similar tools in the future."}],"geoLocations":[],"fundingReferences":[],"url":"https://arxiv.org/abs/2602.20120","contentUrl":null,"metadataVersion":0,"schemaVersion":"http://datacite.org/schema/kernel-4","source":"mds","isActive":true,"state":"findable","reason":null,"viewCount":0,"downloadCount":0,"referenceCount":0,"citationCount":0,"partCount":0,"partOfCount":0,"versionCount":0,"versionOfCount":1,"created":"2026-02-25T15:28:44Z","registered":"2026-02-25T15:28:45Z","published":null,"updated":"2026-02-25T15:28:45Z"},"relationships":{"client":{"data":{"id":"arxiv.content","type":"clients"}}}},{"id":"10.48550/arxiv.2602.20119","type":"dois","attributes":{"doi":"10.48550/arxiv.2602.20119","identifiers":[{"identifier":"2602.20119","identifierType":"arXiv"}],"creators":[{"nameType":"Personal","givenName":"Jiahui","familyName":"Fu","name":"Fu, Jiahui","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Junyu","familyName":"Nan","name":"Nan, Junyu","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Lingfeng","familyName":"Sun","name":"Sun, Lingfeng","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Hongyu","familyName":"Li","name":"Li, Hongyu","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Jianing","familyName":"Qian","name":"Qian, Jianing","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Jennifer L.","familyName":"Barry","name":"Barry, Jennifer L.","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Kris","familyName":"Kitani","name":"Kitani, Kris","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"George","familyName":"Konidaris","name":"Konidaris, George","affiliation":[],"nameIdentifiers":[]}],"titles":[{"title":"NovaPlan: Zero-Shot Long-Horizon Manipulation via Closed-Loop Video Language Planning"}],"publisher":"arXiv","container":{},"publicationYear":2026,"subjects":[{"subject":"Robotics (cs.RO)","lang":"en","subjectScheme":"arXiv"},{"subject":"Artificial Intelligence (cs.AI)","lang":"en","subjectScheme":"arXiv"},{"subject":"Computer Vision and Pattern Recognition (cs.CV)","lang":"en","subjectScheme":"arXiv"},{"subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"},{"schemeUri":"http://www.oecd.org/science/inno/38235147.pdf","subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"}],"contributors":[],"dates":[{"date":"2026-02-23T18:35:18Z","dateType":"Submitted","dateInformation":"v1"},{"date":"2026-02-24T02:44:50Z","dateType":"Updated","dateInformation":"v1"},{"date":"2026-02","dateType":"Available","dateInformation":"v1"},{"date":"2026","dateType":"Issued"}],"language":null,"types":{"schemaOrg":"CreativeWork","resourceTypeGeneral":"Preprint","citeproc":"article","bibtex":"misc","ris":"GEN","resourceType":"Article"},"relatedIdentifiers":[],"relatedItems":[],"sizes":[],"formats":[],"version":"1","rightsList":[{"rightsIdentifierScheme":"SPDX","rightsUri":"https://creativecommons.org/licenses/by/4.0/legalcode","schemeUri":"https://spdx.org/licenses/","rights":"Creative Commons Attribution 4.0 International","rightsIdentifier":"cc-by-4.0"}],"descriptions":[{"descriptionType":"Abstract","description":"Solving long-horizon tasks requires robots to integrate high-level semantic reasoning with low-level physical interaction. While vision-language models (VLMs) and video generation models can decompose tasks and imagine outcomes, they often lack the physical grounding necessary for real-world execution. We introduce NovaPlan, a hierarchical framework that unifies closed-loop VLM and video planning with geometrically grounded robot execution for zero-shot long-horizon manipulation. At the high level, a VLM planner decomposes tasks into sub-goals and monitors robot execution in a closed loop, enabling the system to recover from single-step failures through autonomous re-planning. To compute low-level robot actions, we extract and utilize both task-relevant object keypoints and human hand poses as kinematic priors from the generated videos, and employ a switching mechanism to choose the better one as a reference for robot actions, maintaining stable execution even under heavy occlusion or depth inaccuracy. We demonstrate the effectiveness of NovaPlan on three long-horizon tasks and the Functional Manipulation Benchmark (FMB). Our results show that NovaPlan can perform complex assembly tasks and exhibit dexterous error recovery behaviors without any prior demonstrations or training. Project page: https://nova-plan.github.io/"},{"descriptionType":"Other","description":"25 pages, 15 figures. Project webpage: https://nova-plan.github.io/"}],"geoLocations":[],"fundingReferences":[],"url":"https://arxiv.org/abs/2602.20119","contentUrl":null,"metadataVersion":0,"schemaVersion":"http://datacite.org/schema/kernel-4","source":"mds","isActive":true,"state":"findable","reason":null,"viewCount":0,"downloadCount":0,"referenceCount":0,"citationCount":0,"partCount":0,"partOfCount":0,"versionCount":0,"versionOfCount":0,"created":"2026-02-25T15:28:42Z","registered":"2026-02-25T15:28:42Z","published":null,"updated":"2026-02-25T15:28:42Z"},"relationships":{"client":{"data":{"id":"arxiv.content","type":"clients"}}}},{"id":"10.48550/arxiv.2602.20118","type":"dois","attributes":{"doi":"10.48550/arxiv.2602.20118","identifiers":[{"identifier":"2602.20118","identifierType":"arXiv"}],"creators":[{"nameType":"Personal","givenName":"Caleb","familyName":"Hiltunen","name":"Hiltunen, Caleb","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Yeonwoo","familyName":"Rho","name":"Rho, Yeonwoo","affiliation":[],"nameIdentifiers":[]}],"titles":[{"title":"Improving the Power of Bonferroni Adjustments under Joint Normality and Exchangeability"}],"publisher":"arXiv","container":{},"publicationYear":2026,"subjects":[{"subject":"Methodology (stat.ME)","lang":"en","subjectScheme":"arXiv"},{"subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"},{"schemeUri":"http://www.oecd.org/science/inno/38235147.pdf","subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"}],"contributors":[],"dates":[{"date":"2026-02-23T18:34:58Z","dateType":"Submitted","dateInformation":"v1"},{"date":"2026-02-24T02:44:49Z","dateType":"Updated","dateInformation":"v1"},{"date":"2026-02","dateType":"Available","dateInformation":"v1"},{"date":"2026","dateType":"Issued"}],"language":null,"types":{"schemaOrg":"CreativeWork","resourceTypeGeneral":"Preprint","citeproc":"article","bibtex":"misc","ris":"GEN","resourceType":"Article"},"relatedIdentifiers":[],"relatedItems":[],"sizes":[],"formats":[],"version":"1","rightsList":[{"rightsIdentifierScheme":"SPDX","rightsUri":"https://creativecommons.org/licenses/by/4.0/legalcode","schemeUri":"https://spdx.org/licenses/","rights":"Creative Commons Attribution 4.0 International","rightsIdentifier":"cc-by-4.0"}],"descriptions":[{"descriptionType":"Abstract","description":"Bonferroni's correction is a popular tool to address multiplicity but is notorious for its low power when tests are dependent. This paper proposes a practical modification of Bonferroni's correction when test statistics are jointly normal and exchangeable. This method is intuitive to practitioners and achieves higher power in sparse alternatives, as our simulations suggest. We also prove that this method successfully controls the family-wise error rate at any significance level."}],"geoLocations":[],"fundingReferences":[],"url":"https://arxiv.org/abs/2602.20118","contentUrl":null,"metadataVersion":0,"schemaVersion":"http://datacite.org/schema/kernel-4","source":"mds","isActive":true,"state":"findable","reason":null,"viewCount":0,"downloadCount":0,"referenceCount":0,"citationCount":0,"partCount":0,"partOfCount":0,"versionCount":0,"versionOfCount":0,"created":"2026-02-25T15:28:39Z","registered":"2026-02-25T15:28:40Z","published":null,"updated":"2026-02-25T15:28:40Z"},"relationships":{"client":{"data":{"id":"arxiv.content","type":"clients"}}}},{"id":"10.48550/arxiv.2602.20117","type":"dois","attributes":{"doi":"10.48550/arxiv.2602.20117","identifiers":[{"identifier":"2602.20117","identifierType":"arXiv"}],"creators":[{"nameType":"Personal","givenName":"Andre","familyName":"He","name":"He, Andre","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Nathaniel","familyName":"Weir","name":"Weir, Nathaniel","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Kaj","familyName":"Bostrom","name":"Bostrom, Kaj","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Allen","familyName":"Nie","name":"Nie, Allen","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Darion","familyName":"Cassel","name":"Cassel, Darion","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Sam","familyName":"Bayless","name":"Bayless, Sam","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Huzefa","familyName":"Rangwala","name":"Rangwala, Huzefa","affiliation":[],"nameIdentifiers":[]}],"titles":[{"title":"ReSyn: Autonomously Scaling Synthetic Environments for Reasoning Models"}],"publisher":"arXiv","container":{},"publicationYear":2026,"subjects":[{"subject":"Artificial Intelligence (cs.AI)","lang":"en","subjectScheme":"arXiv"},{"subject":"Machine Learning (cs.LG)","lang":"en","subjectScheme":"arXiv"},{"subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"},{"schemeUri":"http://www.oecd.org/science/inno/38235147.pdf","subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"}],"contributors":[],"dates":[{"date":"2026-02-23T18:34:29Z","dateType":"Submitted","dateInformation":"v1"},{"date":"2026-02-24T02:44:48Z","dateType":"Updated","dateInformation":"v1"},{"date":"2026-02","dateType":"Available","dateInformation":"v1"},{"date":"2026","dateType":"Issued"}],"language":null,"types":{"schemaOrg":"CreativeWork","resourceTypeGeneral":"Preprint","citeproc":"article","bibtex":"misc","ris":"GEN","resourceType":"Article"},"relatedIdentifiers":[],"relatedItems":[],"sizes":[],"formats":[],"version":"1","rightsList":[{"rightsIdentifierScheme":"SPDX","rightsUri":"https://creativecommons.org/licenses/by/4.0/legalcode","schemeUri":"https://spdx.org/licenses/","rights":"Creative Commons Attribution 4.0 International","rightsIdentifier":"cc-by-4.0"}],"descriptions":[{"descriptionType":"Abstract","description":"Reinforcement learning with verifiable rewards (RLVR) has emerged as a promising approach for training reasoning language models (RLMs) by leveraging supervision from verifiers. Although verifier implementation is easier than solution annotation for many tasks, existing synthetic data generation methods remain largely solution-centric, while verifier-based methods rely on a few hand-crafted procedural environments. In this work, we scale RLVR by introducing ReSyn, a pipeline that generates diverse reasoning environments equipped with instance generators and verifiers, covering tasks such as constraint satisfaction, algorithmic puzzles, and spatial reasoning. A Qwen2.5-7B-Instruct model trained with RL on ReSyn data achieves consistent gains across reasoning benchmarks and out-of-domain math benchmarks, including a 27\\% relative improvement on the challenging BBEH benchmark. Ablations show that verifier-based supervision and increased task diversity both contribute significantly, providing empirical evidence that generating reasoning environments at scale can enhance reasoning abilities in RLMs"}],"geoLocations":[],"fundingReferences":[],"url":"https://arxiv.org/abs/2602.20117","contentUrl":null,"metadataVersion":0,"schemaVersion":"http://datacite.org/schema/kernel-4","source":"mds","isActive":true,"state":"findable","reason":null,"viewCount":0,"downloadCount":0,"referenceCount":0,"citationCount":0,"partCount":0,"partOfCount":0,"versionCount":0,"versionOfCount":0,"created":"2026-02-25T15:28:37Z","registered":"2026-02-25T15:28:37Z","published":null,"updated":"2026-02-25T15:28:37Z"},"relationships":{"client":{"data":{"id":"arxiv.content","type":"clients"}}}},{"id":"10.48550/arxiv.2602.20116","type":"dois","attributes":{"doi":"10.48550/arxiv.2602.20116","identifiers":[{"identifier":"2602.20116","identifierType":"arXiv"}],"creators":[{"nameType":"Personal","givenName":"M. A.","familyName":"Arroyo-Ureña","name":"Arroyo-Ureña, M. A.","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"H.","familyName":"Hernández-Arellano","name":"Hernández-Arellano, H.","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"I.","familyName":"Pedraza","name":"Pedraza, I.","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"S.","familyName":"Rosado-Navarro","name":"Rosado-Navarro, S.","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"T. A.","familyName":"Valencia-Pérez","name":"Valencia-Pérez, T. A.","affiliation":[],"nameIdentifiers":[]}],"titles":[{"title":"Production of dark matter in association with a Higgs boson via exclusive photon fusion in $pp$ collisions at $\\sqrt{s}=13$ TeV"}],"publisher":"arXiv","container":{},"publicationYear":2026,"subjects":[{"subject":"High Energy Physics - Phenomenology (hep-ph)","lang":"en","subjectScheme":"arXiv"},{"subject":"FOS: Physical sciences","subjectScheme":"Fields of Science and Technology (FOS)"},{"schemeUri":"http://www.oecd.org/science/inno/38235147.pdf","subject":"FOS: Physical sciences","subjectScheme":"Fields of Science and Technology (FOS)"}],"contributors":[],"dates":[{"date":"2026-02-23T18:34:23Z","dateType":"Submitted","dateInformation":"v1"},{"date":"2026-02-24T02:44:46Z","dateType":"Updated","dateInformation":"v1"},{"date":"2026-02","dateType":"Available","dateInformation":"v1"},{"date":"2026","dateType":"Issued"}],"language":null,"types":{"schemaOrg":"CreativeWork","resourceTypeGeneral":"Preprint","citeproc":"article","bibtex":"misc","ris":"GEN","resourceType":"Article"},"relatedIdentifiers":[],"relatedItems":[],"sizes":[],"formats":[],"version":"1","rightsList":[{"rightsIdentifierScheme":"SPDX","rightsUri":"https://creativecommons.org/licenses/by/4.0/legalcode","schemeUri":"https://spdx.org/licenses/","rights":"Creative Commons Attribution 4.0 International","rightsIdentifier":"cc-by-4.0"}],"descriptions":[{"descriptionType":"Abstract","description":"In this work we study the production of a dark matter (DM) particle in association with a Higgs boson via a central exclusive photon-fusion initiated process. We explore this type of production through the Inert Doublet Model plus a complex Singlet (IDMS), where an extension of the Standard Model by an additional $U(1)_X$ gauge symmetry and a $SU(2)$ inert scalar doublet gives rise to a DM candidate $χ$. This particular process involves the collision of two protons exchanging two colorless particles (in our case, photons), from which a central process occurs. Such interaction can be detected in the LHC using forward proton detectors, where the resulting missing mass spectrum can be observed after proton reconstruction, thus allowing a search for physics Beyond the Standard Model (BSM). We present results for different values of the difference of masses of a heavy scalar coming from the complex singlet, the DM candidate and the Higgs boson, $Δ= M_S - M_χ- M_h$, which is the phase space available for the final state in the central exclusive process."},{"descriptionType":"Other","description":"11 pages, 6 figures"}],"geoLocations":[],"fundingReferences":[],"url":"https://arxiv.org/abs/2602.20116","contentUrl":null,"metadataVersion":0,"schemaVersion":"http://datacite.org/schema/kernel-4","source":"mds","isActive":true,"state":"findable","reason":null,"viewCount":0,"downloadCount":0,"referenceCount":0,"citationCount":0,"partCount":0,"partOfCount":0,"versionCount":0,"versionOfCount":0,"created":"2026-02-25T15:28:34Z","registered":"2026-02-25T15:28:35Z","published":null,"updated":"2026-02-25T15:28:35Z"},"relationships":{"client":{"data":{"id":"arxiv.content","type":"clients"}}}},{"id":"10.48550/arxiv.2602.20113","type":"dois","attributes":{"doi":"10.48550/arxiv.2602.20113","identifiers":[{"identifier":"2602.20113","identifierType":"arXiv"}],"creators":[{"nameType":"Personal","givenName":"Yisi","familyName":"Liu","name":"Liu, Yisi","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Nicholas","familyName":"Lee","name":"Lee, Nicholas","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Gopala","familyName":"Anumanchipalli","name":"Anumanchipalli, Gopala","affiliation":[],"nameIdentifiers":[]}],"titles":[{"title":"StyleStream: Real-Time Zero-Shot Voice Style Conversion"}],"publisher":"arXiv","container":{},"publicationYear":2026,"subjects":[{"subject":"Sound (cs.SD)","lang":"en","subjectScheme":"arXiv"},{"subject":"Artificial Intelligence (cs.AI)","lang":"en","subjectScheme":"arXiv"},{"subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"},{"schemeUri":"http://www.oecd.org/science/inno/38235147.pdf","subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"}],"contributors":[],"dates":[{"date":"2026-02-23T18:32:59Z","dateType":"Submitted","dateInformation":"v1"},{"date":"2026-02-24T02:44:43Z","dateType":"Updated","dateInformation":"v1"},{"date":"2026-02","dateType":"Available","dateInformation":"v1"},{"date":"2026","dateType":"Issued"}],"language":null,"types":{"schemaOrg":"CreativeWork","resourceTypeGeneral":"Preprint","citeproc":"article","bibtex":"misc","ris":"GEN","resourceType":"Article"},"relatedIdentifiers":[],"relatedItems":[],"sizes":[],"formats":[],"version":"1","rightsList":[{"rightsIdentifierScheme":"SPDX","rightsUri":"https://creativecommons.org/licenses/by-nc-sa/4.0/legalcode","schemeUri":"https://spdx.org/licenses/","rights":"Creative Commons Attribution Non Commercial Share Alike 4.0 International","rightsIdentifier":"cc-by-nc-sa-4.0"}],"descriptions":[{"descriptionType":"Abstract","description":"Voice style conversion aims to transform an input utterance to match a target speaker's timbre, accent, and emotion, with a central challenge being the disentanglement of linguistic content from style. While prior work has explored this problem, conversion quality remains limited, and real-time voice style conversion has not been addressed. We propose StyleStream, the first streamable zero-shot voice style conversion system that achieves state-of-the-art performance. StyleStream consists of two components: a Destylizer, which removes style attributes while preserving linguistic content, and a Stylizer, a diffusion transformer (DiT) that reintroduces target style conditioned on reference speech. Robust content-style disentanglement is enforced through text supervision and a highly constrained information bottleneck. This design enables a fully non-autoregressive architecture, achieving real-time voice style conversion with an end-to-end latency of 1 second. Samples and real-time demo: https://berkeley-speech-group.github.io/StyleStream/."}],"geoLocations":[],"fundingReferences":[],"url":"https://arxiv.org/abs/2602.20113","contentUrl":null,"metadataVersion":0,"schemaVersion":"http://datacite.org/schema/kernel-4","source":"mds","isActive":true,"state":"findable","reason":null,"viewCount":0,"downloadCount":0,"referenceCount":0,"citationCount":0,"partCount":0,"partOfCount":0,"versionCount":0,"versionOfCount":0,"created":"2026-02-25T15:28:27Z","registered":"2026-02-25T15:28:28Z","published":null,"updated":"2026-02-25T15:28:28Z"},"relationships":{"client":{"data":{"id":"arxiv.content","type":"clients"}}}},{"id":"10.48550/arxiv.2602.20111","type":"dois","attributes":{"doi":"10.48550/arxiv.2602.20111","identifiers":[{"identifier":"2602.20111","identifierType":"arXiv"}],"creators":[{"nameType":"Personal","givenName":"Ezra","familyName":"Edelman","name":"Edelman, Ezra","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Surbhi","familyName":"Goel","name":"Goel, Surbhi","affiliation":[],"nameIdentifiers":[]}],"titles":[{"title":"Reliable Abstention under Adversarial Injections: Tight Lower Bounds and New Upper Bounds"}],"publisher":"arXiv","container":{},"publicationYear":2026,"subjects":[{"subject":"Machine Learning (cs.LG)","lang":"en","subjectScheme":"arXiv"},{"subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"},{"schemeUri":"http://www.oecd.org/science/inno/38235147.pdf","subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"}],"contributors":[],"dates":[{"date":"2026-02-23T18:30:48Z","dateType":"Submitted","dateInformation":"v1"},{"date":"2026-02-24T02:44:38Z","dateType":"Updated","dateInformation":"v1"},{"date":"2026-02","dateType":"Available","dateInformation":"v1"},{"date":"2026","dateType":"Issued"}],"language":null,"types":{"schemaOrg":"CreativeWork","resourceTypeGeneral":"Preprint","citeproc":"article","bibtex":"misc","ris":"GEN","resourceType":"Article"},"relatedIdentifiers":[],"relatedItems":[],"sizes":[],"formats":[],"version":"1","rightsList":[{"rightsIdentifierScheme":"SPDX","rightsUri":"https://creativecommons.org/licenses/by/4.0/legalcode","schemeUri":"https://spdx.org/licenses/","rights":"Creative Commons Attribution 4.0 International","rightsIdentifier":"cc-by-4.0"}],"descriptions":[{"descriptionType":"Abstract","description":"We study online learning in the adversarial injection model introduced by [Goel et al. 2017], where a stream of labeled examples is predominantly drawn i.i.d.\\ from an unknown distribution $\\mathcal{D}$, but may be interspersed with adversarially chosen instances without the learner knowing which rounds are adversarial. Crucially, labels are always consistent with a fixed target concept (the clean-label setting). The learner is additionally allowed to abstain from predicting, and the total error counts the mistakes whenever the learner decides to predict and incorrect abstentions when it abstains on i.i.d.\\ rounds. Perhaps surprisingly, prior work shows that oracle access to the underlying distribution yields $O(d^2 \\log T)$ combined error for VC dimension $d$, while distribution-agnostic algorithms achieve only $\\tilde{O}(\\sqrt{T})$ for restricted classes, leaving open whether this gap is fundamental.\n We resolve this question by proving a matching $Ω(\\sqrt{T})$ lower bound for VC dimension $1$, establishing a sharp separation between the two information regimes. On the algorithmic side, we introduce a potential-based framework driven by \\emph{robust witnesses}, small subsets of labeled examples that certify predictions while remaining resilient to adversarial contamination. We instantiate this framework using two combinatorial dimensions: (1) \\emph{inference dimension}, yielding combined error $\\tilde{O}(T^{1-1/k})$ for classes of inference dimension $k$, and (2) \\emph{certificate dimension}, a new relaxation we introduce. As an application, we show that halfspaces in $\\mathbb{R}^2$ have certificate dimension $3$, obtaining the first distribution-agnostic bound of $\\tilde{O}(T^{2/3})$ for this class. This is notable since [Blum et al. 2021] showed halfspaces are not robustly learnable under clean-label attacks without abstention."}],"geoLocations":[],"fundingReferences":[],"url":"https://arxiv.org/abs/2602.20111","contentUrl":null,"metadataVersion":0,"schemaVersion":"http://datacite.org/schema/kernel-4","source":"mds","isActive":true,"state":"findable","reason":null,"viewCount":0,"downloadCount":0,"referenceCount":0,"citationCount":0,"partCount":0,"partOfCount":0,"versionCount":0,"versionOfCount":0,"created":"2026-02-25T15:28:22Z","registered":"2026-02-25T15:28:23Z","published":null,"updated":"2026-02-25T15:28:23Z"},"relationships":{"client":{"data":{"id":"arxiv.content","type":"clients"}}}},{"id":"10.48550/arxiv.2602.20110","type":"dois","attributes":{"doi":"10.48550/arxiv.2602.20110","identifiers":[{"identifier":"2602.20110","identifierType":"arXiv"}],"creators":[{"nameType":"Personal","givenName":"Mor","familyName":"Rozner","name":"Rozner, Mor","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Teagan A.","familyName":"Clarke","name":"Clarke, Teagan A.","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Isobel M.","familyName":"Romero-Shaw","name":"Romero-Shaw, Isobel M.","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Johan","familyName":"Samsing","name":"Samsing, Johan","affiliation":[],"nameIdentifiers":[]}],"titles":[{"title":"The Universal Eccentricity Distribution for Dynamical Gravitational-Wave Merger Channels"}],"publisher":"arXiv","container":{},"publicationYear":2026,"subjects":[{"subject":"High Energy Astrophysical Phenomena (astro-ph.HE)","lang":"en","subjectScheme":"arXiv"},{"subject":"General Relativity and Quantum Cosmology (gr-qc)","lang":"en","subjectScheme":"arXiv"},{"subject":"FOS: Physical sciences","subjectScheme":"Fields of Science and Technology (FOS)"},{"schemeUri":"http://www.oecd.org/science/inno/38235147.pdf","subject":"FOS: Physical sciences","subjectScheme":"Fields of Science and Technology (FOS)"}],"contributors":[],"dates":[{"date":"2026-02-23T18:29:31Z","dateType":"Submitted","dateInformation":"v1"},{"date":"2026-02-24T02:44:38Z","dateType":"Updated","dateInformation":"v1"},{"date":"2026-02","dateType":"Available","dateInformation":"v1"},{"date":"2026","dateType":"Issued"}],"language":null,"types":{"schemaOrg":"CreativeWork","resourceTypeGeneral":"Preprint","citeproc":"article","bibtex":"misc","ris":"GEN","resourceType":"Article"},"relatedIdentifiers":[],"relatedItems":[],"sizes":[],"formats":[],"version":"1","rightsList":[{"rightsIdentifierScheme":"SPDX","rightsUri":"https://creativecommons.org/licenses/by/4.0/legalcode","schemeUri":"https://spdx.org/licenses/","rights":"Creative Commons Attribution 4.0 International","rightsIdentifier":"cc-by-4.0"}],"descriptions":[{"descriptionType":"Abstract","description":"We argue that all dynamical astrophysical black hole merger channels are expected to result in a common eccentricity distribution at gravitational wave (GW) frequencies relevant for LIGO/Virgo/KAGRA (LVK) in the high eccentricity limit. This follows from the large separation of scales between the GW regime required for creating eccentric mergers in LVK, and the underlying astrophysical formation environment. Our analytical solution shows exceptional agreement with numerical studies. This finding has important implications for both theoretical studies and ongoing searches for eccentric GW sources."},{"descriptionType":"Other","description":"Comments are welcome!"}],"geoLocations":[],"fundingReferences":[],"url":"https://arxiv.org/abs/2602.20110","contentUrl":null,"metadataVersion":0,"schemaVersion":"http://datacite.org/schema/kernel-4","source":"mds","isActive":true,"state":"findable","reason":null,"viewCount":0,"downloadCount":0,"referenceCount":0,"citationCount":0,"partCount":0,"partOfCount":0,"versionCount":0,"versionOfCount":0,"created":"2026-02-25T15:28:20Z","registered":"2026-02-25T15:28:20Z","published":null,"updated":"2026-02-25T15:28:20Z"},"relationships":{"client":{"data":{"id":"arxiv.content","type":"clients"}}}},{"id":"10.48550/arxiv.2602.20109","type":"dois","attributes":{"doi":"10.48550/arxiv.2602.20109","identifiers":[{"identifier":"2602.20109","identifierType":"arXiv"}],"creators":[{"nameType":"Personal","givenName":"Frederico","familyName":"Bianchini","name":"Bianchini, Frederico","affiliation":[],"nameIdentifiers":[]}],"titles":[{"title":"On the Ramanujan Vector Field modulo $p$"}],"publisher":"arXiv","container":{},"publicationYear":2026,"subjects":[{"subject":"Number Theory (math.NT)","lang":"en","subjectScheme":"arXiv"},{"subject":"Algebraic Geometry (math.AG)","lang":"en","subjectScheme":"arXiv"},{"subject":"FOS: Mathematics","subjectScheme":"Fields of Science and Technology (FOS)"},{"schemeUri":"http://www.oecd.org/science/inno/38235147.pdf","subject":"FOS: Mathematics","subjectScheme":"Fields of Science and Technology (FOS)"},{"subject":"11G25 (Primary), 11F33, 11G05 (Secondary)","lang":"en","subjectScheme":"MSC"}],"contributors":[],"dates":[{"date":"2026-02-23T18:28:58Z","dateType":"Submitted","dateInformation":"v1"},{"date":"2026-02-24T02:44:37Z","dateType":"Updated","dateInformation":"v1"},{"date":"2026-02","dateType":"Available","dateInformation":"v1"},{"date":"2026","dateType":"Issued"}],"language":null,"types":{"schemaOrg":"CreativeWork","resourceTypeGeneral":"Preprint","citeproc":"article","bibtex":"misc","ris":"GEN","resourceType":"Article"},"relatedIdentifiers":[],"relatedItems":[],"sizes":[],"formats":[],"version":"1","rightsList":[{"rightsUri":"http://arxiv.org/licenses/nonexclusive-distrib/1.0/","rights":"arXiv.org perpetual, non-exclusive license"}],"descriptions":[{"descriptionType":"Abstract","description":"For every prime $p \\geq 5$, we compute the $p$-th power of the Ramanujan vector field that arises from the differential relations discovered by Ramanujan for the Eisenstein series $E_2,E_4$ and $E_6$. Our method results in explicit equations for the $p$-th power and uses classical results of Serre and Swinnerton-Dyer about modular forms modulo $p$. From this, we verify that a general conjecture by Sheperd-Barron and Ekedahl is valid for the Ramanujan vector field. Furthermore, we consider the affine realization of a certain moduli space of elliptic curves where the Ramanujan vector field is defined, and describe - in characteristic $p$ - the locus given by supersingular elliptic curves in two ways: a classical one - using equations for the supersingular polynomial - and a new one as the singular set of some vector fields. Additionally, we prove that the Ramanujan vector field is transversal to this locus."},{"descriptionType":"Other","description":"16 pages, 1 table"}],"geoLocations":[],"fundingReferences":[],"url":"https://arxiv.org/abs/2602.20109","contentUrl":null,"metadataVersion":0,"schemaVersion":"http://datacite.org/schema/kernel-4","source":"mds","isActive":true,"state":"findable","reason":null,"viewCount":0,"downloadCount":0,"referenceCount":0,"citationCount":0,"partCount":0,"partOfCount":0,"versionCount":0,"versionOfCount":0,"created":"2026-02-25T15:28:17Z","registered":"2026-02-25T15:28:18Z","published":null,"updated":"2026-02-25T15:28:18Z"},"relationships":{"client":{"data":{"id":"arxiv.content","type":"clients"}}}},{"id":"10.48550/arxiv.2602.20106","type":"dois","attributes":{"doi":"10.48550/arxiv.2602.20106","identifiers":[{"identifier":"2602.20106","identifierType":"arXiv"}],"creators":[{"nameType":"Personal","givenName":"Ossama","familyName":"Kullie","name":"Kullie, Ossama","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Igor A.","familyName":"Ivanov","name":"Ivanov, Igor A.","affiliation":[],"nameIdentifiers":[]}],"titles":[{"title":"The quantum superluminality in the tunnel-ionization process of H-like atoms"}],"publisher":"arXiv","container":{},"publicationYear":2026,"subjects":[{"subject":"Quantum Physics (quant-ph)","lang":"en","subjectScheme":"arXiv"},{"subject":"FOS: Physical sciences","subjectScheme":"Fields of Science and Technology (FOS)"},{"schemeUri":"http://www.oecd.org/science/inno/38235147.pdf","subject":"FOS: Physical sciences","subjectScheme":"Fields of Science and Technology (FOS)"}],"contributors":[],"dates":[{"date":"2026-02-23T18:25:32Z","dateType":"Submitted","dateInformation":"v1"},{"date":"2026-02-24T02:44:31Z","dateType":"Updated","dateInformation":"v1"},{"date":"2026-02","dateType":"Available","dateInformation":"v1"},{"date":"2026","dateType":"Issued"}],"language":null,"types":{"schemaOrg":"CreativeWork","resourceTypeGeneral":"Preprint","citeproc":"article","bibtex":"misc","ris":"GEN","resourceType":"Article"},"relatedIdentifiers":[],"relatedItems":[],"sizes":[],"formats":[],"version":"1","rightsList":[{"rightsIdentifierScheme":"SPDX","rightsUri":"https://creativecommons.org/licenses/by/4.0/legalcode","schemeUri":"https://spdx.org/licenses/","rights":"Creative Commons Attribution 4.0 International","rightsIdentifier":"cc-by-4.0"}],"descriptions":[{"descriptionType":"Abstract","description":"The quantum tunneling time remains the subject of heated debate,\n and one of its most curious features is faster-than-light or\n superluminal tunneling.\n Our tunnel-ionization model of the time-delay, presented in previous work, shows good agreement with the attoclock measurement in the adiabatic and nonadiabatic field calibrations, which also enables the determination of the barrier time-delay.\n In the present work, we show that the tunnel-ionization for H-like atoms with large nuclear charge can be superluminal (quantum superluminality), which in principle can be investigated experimentally using the attoclock scheme.\n We discuss the quantum superluminality in detail for the different regimes of the tunnel-ionization. Our result shows that quantum tunneling faster-than-light is indeed possible, albeit only under somewhat extreme conditions."}],"geoLocations":[],"fundingReferences":[],"url":"https://arxiv.org/abs/2602.20106","contentUrl":null,"metadataVersion":0,"schemaVersion":"http://datacite.org/schema/kernel-4","source":"mds","isActive":true,"state":"findable","reason":null,"viewCount":0,"downloadCount":0,"referenceCount":0,"citationCount":0,"partCount":0,"partOfCount":0,"versionCount":0,"versionOfCount":0,"created":"2026-02-25T15:28:10Z","registered":"2026-02-25T15:28:10Z","published":null,"updated":"2026-02-25T15:28:10Z"},"relationships":{"client":{"data":{"id":"arxiv.content","type":"clients"}}}},{"id":"10.48550/arxiv.2602.20104","type":"dois","attributes":{"doi":"10.48550/arxiv.2602.20104","identifiers":[{"identifier":"2602.20104","identifierType":"arXiv"}],"creators":[{"nameType":"Personal","givenName":"Hasan","familyName":"Amin","name":"Amin, Hasan","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Ming","familyName":"Yin","name":"Yin, Ming","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Rajiv","familyName":"Khanna","name":"Khanna, Rajiv","affiliation":[],"nameIdentifiers":[]}],"titles":[{"title":"Align When They Want, Complement When They Need! Human-Centered Ensembles for Adaptive Human-AI Collaboration"}],"publisher":"arXiv","container":{},"publicationYear":2026,"subjects":[{"subject":"Artificial Intelligence (cs.AI)","lang":"en","subjectScheme":"arXiv"},{"subject":"Human-Computer Interaction (cs.HC)","lang":"en","subjectScheme":"arXiv"},{"subject":"Machine Learning (cs.LG)","lang":"en","subjectScheme":"arXiv"},{"subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"},{"schemeUri":"http://www.oecd.org/science/inno/38235147.pdf","subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"}],"contributors":[],"dates":[{"date":"2026-02-23T18:22:58Z","dateType":"Submitted","dateInformation":"v1"},{"date":"2026-02-24T02:44:24Z","dateType":"Updated","dateInformation":"v1"},{"date":"2026-02","dateType":"Available","dateInformation":"v1"},{"date":"2026","dateType":"Issued"}],"language":null,"types":{"schemaOrg":"CreativeWork","resourceTypeGeneral":"Preprint","citeproc":"article","bibtex":"misc","ris":"GEN","resourceType":"Article"},"relatedIdentifiers":[],"relatedItems":[],"sizes":[],"formats":[],"version":"1","rightsList":[{"rightsIdentifierScheme":"SPDX","rightsUri":"https://creativecommons.org/licenses/by/4.0/legalcode","schemeUri":"https://spdx.org/licenses/","rights":"Creative Commons Attribution 4.0 International","rightsIdentifier":"cc-by-4.0"}],"descriptions":[{"descriptionType":"Abstract","description":"In human-AI decision making, designing AI that complements human expertise has been a natural strategy to enhance human-AI collaboration, yet it often comes at the cost of decreased AI performance in areas of human strengths. This can inadvertently erode human trust and cause them to ignore AI advice precisely when it is most needed. Conversely, an aligned AI fosters trust yet risks reinforcing suboptimal human behavior and lowering human-AI team performance. In this paper, we start by identifying this fundamental tension between performance-boosting (i.e., complementarity) and trust-building (i.e., alignment) as an inherent limitation of the traditional approach for training a single AI model to assist human decision making. To overcome this, we introduce a novel human-centered adaptive AI ensemble that strategically toggles between two specialist AI models - the aligned model and the complementary model - based on contextual cues, using an elegantly simple yet provably near-optimal Rational Routing Shortcut mechanism. Comprehensive theoretical analyses elucidate why the adaptive AI ensemble is effective and when it yields maximum benefits. Moreover, experiments on both simulated and real-world data show that when humans are assisted by the adaptive AI ensemble in decision making, they can achieve significantly higher performance than when they are assisted by single AI models that are trained to either optimize for their independent performance or even the human-AI team performance."},{"descriptionType":"Other","description":"AAAI 2026"}],"geoLocations":[],"fundingReferences":[],"url":"https://arxiv.org/abs/2602.20104","contentUrl":null,"metadataVersion":0,"schemaVersion":"http://datacite.org/schema/kernel-4","source":"mds","isActive":true,"state":"findable","reason":null,"viewCount":0,"downloadCount":0,"referenceCount":0,"citationCount":0,"partCount":0,"partOfCount":0,"versionCount":0,"versionOfCount":0,"created":"2026-02-25T15:28:05Z","registered":"2026-02-25T15:28:05Z","published":null,"updated":"2026-02-25T15:28:05Z"},"relationships":{"client":{"data":{"id":"arxiv.content","type":"clients"}}}},{"id":"10.48550/arxiv.2602.20101","type":"dois","attributes":{"doi":"10.48550/arxiv.2602.20101","identifiers":[{"identifier":"2602.20101","identifierType":"arXiv"}],"creators":[{"nameType":"Personal","givenName":"A. G. M.","familyName":"Pietrow","name":"Pietrow, A. G. M.","affiliation":[],"nameIdentifiers":[]}],"titles":[{"title":"HelioSpectrotron 5000: An interactive multi-resolution solar spectral atlas"}],"publisher":"arXiv","container":{},"publicationYear":2026,"subjects":[{"subject":"Solar and Stellar Astrophysics (astro-ph.SR)","lang":"en","subjectScheme":"arXiv"},{"subject":"Instrumentation and Methods for Astrophysics (astro-ph.IM)","lang":"en","subjectScheme":"arXiv"},{"subject":"FOS: Physical sciences","subjectScheme":"Fields of Science and Technology (FOS)"},{"schemeUri":"http://www.oecd.org/science/inno/38235147.pdf","subject":"FOS: Physical sciences","subjectScheme":"Fields of Science and Technology (FOS)"}],"contributors":[],"dates":[{"date":"2026-02-23T18:17:09Z","dateType":"Submitted","dateInformation":"v1"},{"date":"2026-02-24T02:44:08Z","dateType":"Updated","dateInformation":"v1"},{"date":"2026-02-24T08:21:00Z","dateType":"Submitted","dateInformation":"v2"},{"date":"2026-02-25T01:31:23Z","dateType":"Updated","dateInformation":"v2"},{"date":"2026-02","dateType":"Available","dateInformation":"v1"},{"date":"2026","dateType":"Issued"}],"language":null,"types":{"schemaOrg":"CreativeWork","resourceTypeGeneral":"Preprint","citeproc":"article","bibtex":"misc","ris":"GEN","resourceType":"Article"},"relatedIdentifiers":[{"relationType":"IsVersionOf","relatedIdentifier":"10.33232/001c.158273","relatedIdentifierType":"DOI"}],"relatedItems":[],"sizes":[],"formats":[],"version":"2","rightsList":[{"rightsIdentifierScheme":"SPDX","rightsUri":"https://creativecommons.org/licenses/by/4.0/legalcode","schemeUri":"https://spdx.org/licenses/","rights":"Creative Commons Attribution 4.0 International","rightsIdentifier":"cc-by-4.0"}],"descriptions":[{"descriptionType":"Abstract","description":"HelioSpectrotron 5000 (HS5000) is an interactive, multi-resolution solar spectral atlas designed to facilitate direct comparison between high-resolution reference spectra and observations obtained with a wide range of ground-based instruments. Based on the Hamburg FTS atlas, the HS5000 provides both absolute intensity and continuum-normalized spectra at arbitrary spectral ranges and resolutions, as well as curated line identifications and optional telluric contamination. This framework enables rapid wavelength calibration, line identification, and context image generation."},{"descriptionType":"Other","description":"Published in the Open Journal of Astrophysics, 5 pages, 3 figures"}],"geoLocations":[],"fundingReferences":[],"url":"https://arxiv.org/abs/2602.20101","contentUrl":null,"metadataVersion":0,"schemaVersion":"http://datacite.org/schema/kernel-4","source":"mds","isActive":true,"state":"findable","reason":null,"viewCount":0,"downloadCount":0,"referenceCount":0,"citationCount":0,"partCount":0,"partOfCount":0,"versionCount":0,"versionOfCount":1,"created":"2026-02-25T15:27:58Z","registered":"2026-02-25T15:27:58Z","published":null,"updated":"2026-02-25T15:27:58Z"},"relationships":{"client":{"data":{"id":"arxiv.content","type":"clients"}}}},{"id":"10.48550/arxiv.2602.20100","type":"dois","attributes":{"doi":"10.48550/arxiv.2602.20100","identifiers":[{"identifier":"2602.20100","identifierType":"arXiv"}],"creators":[{"nameType":"Personal","givenName":"Soumick","familyName":"Chatterjee","name":"Chatterjee, Soumick","affiliation":[],"nameIdentifiers":[]}],"titles":[{"title":"Transcending the Annotation Bottleneck: AI-Powered Discovery in Biology and Medicine"}],"publisher":"arXiv","container":{},"publicationYear":2026,"subjects":[{"subject":"Computer Vision and Pattern Recognition (cs.CV)","lang":"en","subjectScheme":"arXiv"},{"subject":"Artificial Intelligence (cs.AI)","lang":"en","subjectScheme":"arXiv"},{"subject":"Image and Video Processing (eess.IV)","lang":"en","subjectScheme":"arXiv"},{"subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"},{"schemeUri":"http://www.oecd.org/science/inno/38235147.pdf","subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"},{"subject":"FOS: Electrical engineering, electronic engineering, information engineering","subjectScheme":"Fields of Science and Technology (FOS)"},{"schemeUri":"http://www.oecd.org/science/inno/38235147.pdf","subject":"FOS: Electrical engineering, electronic engineering, information engineering","subjectScheme":"Fields of Science and Technology (FOS)"}],"contributors":[],"dates":[{"date":"2026-02-23T18:15:30Z","dateType":"Submitted","dateInformation":"v1"},{"date":"2026-02-24T02:44:03Z","dateType":"Updated","dateInformation":"v1"},{"date":"2026-02","dateType":"Available","dateInformation":"v1"},{"date":"2026","dateType":"Issued"}],"language":null,"types":{"schemaOrg":"CreativeWork","resourceTypeGeneral":"Preprint","citeproc":"article","bibtex":"misc","ris":"GEN","resourceType":"Article"},"relatedIdentifiers":[{"relationType":"IsVersionOf","relatedIdentifier":"10.1007/978-3-032-17216-7_19","relatedIdentifierType":"DOI"}],"relatedItems":[],"sizes":[],"formats":[],"version":"1","rightsList":[{"rightsUri":"http://arxiv.org/licenses/nonexclusive-distrib/1.0/","rights":"arXiv.org perpetual, non-exclusive license"}],"descriptions":[{"descriptionType":"Abstract","description":"The dependence on expert annotation has long constituted the primary rate-limiting step in the application of artificial intelligence to biomedicine. While supervised learning drove the initial wave of clinical algorithms, a paradigm shift towards unsupervised and self-supervised learning (SSL) is currently unlocking the latent potential of biobank-scale datasets. By learning directly from the intrinsic structure of data - whether pixels in a magnetic resonance image (MRI), voxels in a volumetric scan, or tokens in a genomic sequence - these methods facilitate the discovery of novel phenotypes, the linkage of morphology to genetics, and the detection of anomalies without human bias. This article synthesises seminal and recent advances in \"learning without labels,\" highlighting how unsupervised frameworks can derive heritable cardiac traits, predict spatial gene expression in histology, and detect pathologies with performance that rivals or exceeds supervised counterparts."}],"geoLocations":[],"fundingReferences":[],"url":"https://arxiv.org/abs/2602.20100","contentUrl":null,"metadataVersion":0,"schemaVersion":"http://datacite.org/schema/kernel-4","source":"mds","isActive":true,"state":"findable","reason":null,"viewCount":0,"downloadCount":0,"referenceCount":0,"citationCount":0,"partCount":0,"partOfCount":0,"versionCount":0,"versionOfCount":1,"created":"2026-02-25T15:27:55Z","registered":"2026-02-25T15:27:56Z","published":null,"updated":"2026-02-25T15:27:56Z"},"relationships":{"client":{"data":{"id":"arxiv.content","type":"clients"}}}},{"id":"10.48550/arxiv.2602.20097","type":"dois","attributes":{"doi":"10.48550/arxiv.2602.20097","identifiers":[{"identifier":"2602.20097","identifierType":"arXiv"}],"creators":[{"nameType":"Personal","givenName":"Pu","familyName":"Jiao","name":"Jiao, Pu","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Sheng","familyName":"Di","name":"Di, Sheng","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Jiannan","familyName":"Tian","name":"Tian, Jiannan","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Mingze","familyName":"Xia","name":"Xia, Mingze","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Xuan","familyName":"Wu","name":"Wu, Xuan","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Yang","familyName":"Zhang","name":"Zhang, Yang","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Xin","familyName":"Liang","name":"Liang, Xin","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Franck","familyName":"Cappello","name":"Cappello, Franck","affiliation":[],"nameIdentifiers":[]}],"titles":[{"title":"Mitigating Artifacts in Pre-quantization Based Scientific Data Compressors with Quantization-aware Interpolation"}],"publisher":"arXiv","container":{},"publicationYear":2026,"subjects":[{"subject":"Distributed, Parallel, and Cluster Computing (cs.DC)","lang":"en","subjectScheme":"arXiv"},{"subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"},{"schemeUri":"http://www.oecd.org/science/inno/38235147.pdf","subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"}],"contributors":[],"dates":[{"date":"2026-02-23T18:09:11Z","dateType":"Submitted","dateInformation":"v1"},{"date":"2026-02-24T02:43:35Z","dateType":"Updated","dateInformation":"v1"},{"date":"2026-02","dateType":"Available","dateInformation":"v1"},{"date":"2026","dateType":"Issued"}],"language":null,"types":{"schemaOrg":"CreativeWork","resourceTypeGeneral":"Preprint","citeproc":"article","bibtex":"misc","ris":"GEN","resourceType":"Article"},"relatedIdentifiers":[],"relatedItems":[],"sizes":[],"formats":[],"version":"1","rightsList":[{"rightsUri":"http://arxiv.org/licenses/nonexclusive-distrib/1.0/","rights":"arXiv.org perpetual, non-exclusive license"}],"descriptions":[{"descriptionType":"Abstract","description":"Error-bounded lossy compression has been regarded as a promising way to address the ever-increasing amount of scientific data in today's high-performance computing systems. Pre-quantization, a critical technique to remove sequential dependency and enable high parallelism, is widely used to design and develop high-throughput error-controlled data compressors. Despite the extremely high throughput of pre-quantization based compressors, they generally suffer from low data quality with medium or large user-specified error bounds. In this paper, we investigate the artifacts generated by pre-quantization based compressors and propose a novel algorithm to mitigate them. Our contributions are fourfold: (1) We carefully characterize the artifacts in pre-quantization based compressors to understand the correlation between the quantization index and compression error; (2) We propose a novel quantization-aware interpolation algorithm to improve the decompressed data; (3) We parallelize our algorithm in both shared-memory and distributed-memory environments to obtain high performance; (4) We evaluate our algorithm and validate it with two leading pre-quantization based compressors using five real-world datasets. Experiments demonstrate that our artifact mitigation algorithm can effectively improve the quality of decompressed data produced by pre-quantization based compressors while maintaining their high compression throughput."}],"geoLocations":[],"fundingReferences":[],"url":"https://arxiv.org/abs/2602.20097","contentUrl":null,"metadataVersion":0,"schemaVersion":"http://datacite.org/schema/kernel-4","source":"mds","isActive":true,"state":"findable","reason":null,"viewCount":0,"downloadCount":0,"referenceCount":0,"citationCount":0,"partCount":0,"partOfCount":0,"versionCount":0,"versionOfCount":0,"created":"2026-02-25T15:27:47Z","registered":"2026-02-25T15:27:48Z","published":null,"updated":"2026-02-25T15:27:48Z"},"relationships":{"client":{"data":{"id":"arxiv.content","type":"clients"}}}},{"id":"10.48550/arxiv.2602.20096","type":"dois","attributes":{"doi":"10.48550/arxiv.2602.20096","identifiers":[{"identifier":"2602.20096","identifierType":"arXiv"}],"creators":[{"nameType":"Personal","givenName":"Zachary","familyName":"Way","name":"Way, Zachary","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Sébastien","familyName":"Lépine","name":"Lépine, Sébastien","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Jonathan","familyName":"Gagné","name":"Gagné, Jonathan","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Ilija","familyName":"Medan","name":"Medan, Ilija","affiliation":[],"nameIdentifiers":[]}],"titles":[{"title":"21,864 Unresolved, Low-mass Binaries Identified via their Overluminosity in \\textit{Gaia} DR3 and a Catalog of 347,440 Systems within 100 pc of the Sun"}],"publisher":"arXiv","container":{},"publicationYear":2026,"subjects":[{"subject":"Solar and Stellar Astrophysics (astro-ph.SR)","lang":"en","subjectScheme":"arXiv"},{"subject":"Astrophysics of Galaxies (astro-ph.GA)","lang":"en","subjectScheme":"arXiv"},{"subject":"FOS: Physical sciences","subjectScheme":"Fields of Science and Technology (FOS)"},{"schemeUri":"http://www.oecd.org/science/inno/38235147.pdf","subject":"FOS: Physical sciences","subjectScheme":"Fields of Science and Technology (FOS)"}],"contributors":[],"dates":[{"date":"2026-02-23T18:09:05Z","dateType":"Submitted","dateInformation":"v1"},{"date":"2026-02-24T02:43:34Z","dateType":"Updated","dateInformation":"v1"},{"date":"2026-02","dateType":"Available","dateInformation":"v1"},{"date":"2026","dateType":"Issued"}],"language":null,"types":{"schemaOrg":"CreativeWork","resourceTypeGeneral":"Preprint","citeproc":"article","bibtex":"misc","ris":"GEN","resourceType":"Article"},"relatedIdentifiers":[{"relationType":"IsVersionOf","relatedIdentifier":"10.3847/1538-3881/ae48ae","relatedIdentifierType":"DOI"}],"relatedItems":[],"sizes":[],"formats":[],"version":"1","rightsList":[{"rightsIdentifierScheme":"SPDX","rightsUri":"https://creativecommons.org/licenses/by/4.0/legalcode","schemeUri":"https://spdx.org/licenses/","rights":"Creative Commons Attribution 4.0 International","rightsIdentifier":"cc-by-4.0"}],"descriptions":[{"descriptionType":"Abstract","description":"The fundamental parameters of a low-mass star can potentially be determined from its photometry and astrometry. This is complicated by the fact that 10-20 percent of low-mass stars are predicted to be equal-mass binaries. These unresolved systems appear more luminous compared to single stars with the same fundamental parameters. We present a method to differentiate binary stars from single-star main sequence K and M dwarfs using their \\textit{Gaia} DR3 XP spectra. We assemble a training set of stars which have pristine astrometry and photometry, are located within 100pc of the Sun, and exclude stars with \\textit{Gaia} DR3 flags suggesting they may be unequal mass systems, thereby leaving stars that are predominantly either single- or equal-mass binaries. We then iteratively train Random Forest Regression (RFR) models to predict absolute magnitude and color given the RP spectral coefficients of a star. After each model, we remove the stars that have absolute magnitudes significantly brighter than their predicted values. This method converges on a model trained only on single stars. We then use this model to identify the ``overluminous'' K and M stars in \\textit{Gaia} DR3 within 100 parsecs, with some quality cuts. We find that $\\sim13\\%$ of the sample is significantly overluminous and assume these to be unresolved binaries. We aggregate several multiplicity surveys across different projected separations and incorporate our overluminous binaries to create a general \\textit{Catalog of Systems} within 100 pc. We use this \\textit{Catalog} to provide lower limits on the multiplicity fraction for stars between $0.1$ and $0.7~M_{\\odot}$."},{"descriptionType":"Other","description":"16 figures, 22 pages, 3 tables. Access to the machine-readable tables may be found at: https://doi.org/10.5281/zenodo.18500082"}],"geoLocations":[],"fundingReferences":[],"url":"https://arxiv.org/abs/2602.20096","contentUrl":null,"metadataVersion":0,"schemaVersion":"http://datacite.org/schema/kernel-4","source":"mds","isActive":true,"state":"findable","reason":null,"viewCount":0,"downloadCount":0,"referenceCount":0,"citationCount":0,"partCount":0,"partOfCount":0,"versionCount":0,"versionOfCount":1,"created":"2026-02-25T15:27:45Z","registered":"2026-02-25T15:27:46Z","published":null,"updated":"2026-02-25T15:27:46Z"},"relationships":{"client":{"data":{"id":"arxiv.content","type":"clients"}}}},{"id":"10.48550/arxiv.2602.20095","type":"dois","attributes":{"doi":"10.48550/arxiv.2602.20095","identifiers":[{"identifier":"2602.20095","identifierType":"arXiv"}],"creators":[{"nameType":"Personal","givenName":"Filippo","familyName":"Berta","name":"Berta, Filippo","affiliation":[],"nameIdentifiers":[]}],"titles":[{"title":"Subconvexity Problem on $\\operatorname{GL}_3$ over number fields: the twist aspect"}],"publisher":"arXiv","container":{},"publicationYear":2026,"subjects":[{"subject":"Number Theory (math.NT)","lang":"en","subjectScheme":"arXiv"},{"subject":"FOS: Mathematics","subjectScheme":"Fields of Science and Technology (FOS)"},{"schemeUri":"http://www.oecd.org/science/inno/38235147.pdf","subject":"FOS: Mathematics","subjectScheme":"Fields of Science and Technology (FOS)"},{"subject":"11FF66, 11R42","lang":"en","subjectScheme":"MSC"}],"contributors":[],"dates":[{"date":"2026-02-23T18:08:46Z","dateType":"Submitted","dateInformation":"v1"},{"date":"2026-02-24T02:43:33Z","dateType":"Updated","dateInformation":"v1"},{"date":"2026-02","dateType":"Available","dateInformation":"v1"},{"date":"2026","dateType":"Issued"}],"language":null,"types":{"schemaOrg":"CreativeWork","resourceTypeGeneral":"Preprint","citeproc":"article","bibtex":"misc","ris":"GEN","resourceType":"Article"},"relatedIdentifiers":[],"relatedItems":[],"sizes":[],"formats":[],"version":"1","rightsList":[{"rightsIdentifierScheme":"SPDX","rightsUri":"https://creativecommons.org/licenses/by/4.0/legalcode","schemeUri":"https://spdx.org/licenses/","rights":"Creative Commons Attribution 4.0 International","rightsIdentifier":"cc-by-4.0"}],"descriptions":[{"descriptionType":"Abstract","description":"Let $F$ denote a number field and let $\\mathfrak{q}\\subset O_F$ traverse a sequence of prime ideals with norm $N(\\mathfrak{q}) \\to \\infty$ and for each $\\mathfrak{q}$, let $χ\\in \\widehat{F^{\\times}\\setminus \\mathbb{A}^\\times}$ be a finite order character of conductor $\\mathfrak{q}$. For a fixed unitary cuspidal automorphic representation $π$ of $\\operatorname{GL}_3/F$ we show that \\begin{equation*} L(π\\otimes χ,\\tfrac{1}{2})\\ll \\ N(\\mathfrak{q})^{3/4-κ}.\\end{equation*} holds for all $κ\u0026lt; \\frac{1}{36}$."},{"descriptionType":"Other","description":"Comments are welcome"}],"geoLocations":[],"fundingReferences":[],"url":"https://arxiv.org/abs/2602.20095","contentUrl":null,"metadataVersion":0,"schemaVersion":"http://datacite.org/schema/kernel-4","source":"mds","isActive":true,"state":"findable","reason":null,"viewCount":0,"downloadCount":0,"referenceCount":0,"citationCount":0,"partCount":0,"partOfCount":0,"versionCount":0,"versionOfCount":0,"created":"2026-02-25T15:27:43Z","registered":"2026-02-25T15:27:43Z","published":null,"updated":"2026-02-25T15:27:43Z"},"relationships":{"client":{"data":{"id":"arxiv.content","type":"clients"}}}},{"id":"10.48550/arxiv.2602.20093","type":"dois","attributes":{"doi":"10.48550/arxiv.2602.20093","identifiers":[{"identifier":"2602.20093","identifierType":"arXiv"}],"creators":[{"nameType":"Personal","givenName":"Kun","familyName":"Yang","name":"Yang, Kun","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Yuxuan","familyName":"Zhu","name":"Zhu, Yuxuan","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Yazhe","familyName":"Chen","name":"Chen, Yazhe","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Siyao","familyName":"Zheng","name":"Zheng, Siyao","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Bangyang","familyName":"Hong","name":"Hong, Bangyang","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Kangle","familyName":"Wu","name":"Wu, Kangle","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Yabo","familyName":"Ni","name":"Ni, Yabo","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Anxiang","familyName":"Zeng","name":"Zeng, Anxiang","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Cong","familyName":"Fu","name":"Fu, Cong","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Hui","familyName":"Li","name":"Li, Hui","affiliation":[],"nameIdentifiers":[]}],"titles":[{"title":"ManCAR: Manifold-Constrained Latent Reasoning with Adaptive Test-Time Computation for Sequential Recommendation"}],"publisher":"arXiv","container":{},"publicationYear":2026,"subjects":[{"subject":"Information Retrieval (cs.IR)","lang":"en","subjectScheme":"arXiv"},{"subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"},{"schemeUri":"http://www.oecd.org/science/inno/38235147.pdf","subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"}],"contributors":[],"dates":[{"date":"2026-02-23T18:02:50Z","dateType":"Submitted","dateInformation":"v1"},{"date":"2026-02-24T02:43:24Z","dateType":"Updated","dateInformation":"v1"},{"date":"2026-02","dateType":"Available","dateInformation":"v1"},{"date":"2026","dateType":"Issued"}],"language":null,"types":{"schemaOrg":"CreativeWork","resourceTypeGeneral":"Preprint","citeproc":"article","bibtex":"misc","ris":"GEN","resourceType":"Article"},"relatedIdentifiers":[],"relatedItems":[],"sizes":[],"formats":[],"version":"1","rightsList":[{"rightsUri":"http://arxiv.org/licenses/nonexclusive-distrib/1.0/","rights":"arXiv.org perpetual, non-exclusive license"}],"descriptions":[{"descriptionType":"Abstract","description":"Sequential recommendation increasingly employs latent multi-step reasoning to enhance test-time computation. Despite empirical gains, existing approaches largely drive intermediate reasoning states via target-dominant objectives without imposing explicit feasibility constraints. This results in latent drift, where reasoning trajectories deviate into implausible regions. We argue that effective recommendation reasoning should instead be viewed as navigation on a collaborative manifold rather than free-form latent refinement. To this end, we propose ManCAR (Manifold-Constrained Adaptive Reasoning), a principled framework that grounds reasoning within the topology of a global interaction graph. ManCAR constructs a local intent prior from the collaborative neighborhood of a user's recent actions, represented as a distribution over the item simplex. During training, the model progressively aligns its latent predictive distribution with this prior, forcing the reasoning trajectory to remain within the valid manifold. At test time, reasoning proceeds adaptively until the predictive distribution stabilizes, avoiding over-refinement. We provide a variational interpretation of ManCAR to theoretically validate its drift-prevention and adaptive test-time stopping mechanisms. Experiments on seven benchmarks demonstrate that ManCAR consistently outperforms state-of-the-art baselines, achieving up to a 46.88% relative improvement w.r.t. NDCG@10. Our code is available at https://github.com/FuCongResearchSquad/ManCAR."},{"descriptionType":"Other","description":"15 pages, 7 figures"}],"geoLocations":[],"fundingReferences":[],"url":"https://arxiv.org/abs/2602.20093","contentUrl":null,"metadataVersion":0,"schemaVersion":"http://datacite.org/schema/kernel-4","source":"mds","isActive":true,"state":"findable","reason":null,"viewCount":0,"downloadCount":0,"referenceCount":0,"citationCount":0,"partCount":0,"partOfCount":0,"versionCount":0,"versionOfCount":0,"created":"2026-02-25T15:27:38Z","registered":"2026-02-25T15:27:39Z","published":null,"updated":"2026-02-25T15:27:39Z"},"relationships":{"client":{"data":{"id":"arxiv.content","type":"clients"}}}},{"id":"10.48550/arxiv.2602.20092","type":"dois","attributes":{"doi":"10.48550/arxiv.2602.20092","identifiers":[{"identifier":"2602.20092","identifierType":"arXiv"}],"creators":[{"nameType":"Personal","givenName":"Leshem","familyName":"Choshen","name":"Choshen, Leshem","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Ryan","familyName":"Cotterell","name":"Cotterell, Ryan","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Mustafa Omer","familyName":"Gul","name":"Gul, Mustafa Omer","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Jaap","familyName":"Jumelet","name":"Jumelet, Jaap","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Tal","familyName":"Linzen","name":"Linzen, Tal","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Aaron","familyName":"Mueller","name":"Mueller, Aaron","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Suchir","familyName":"Salhan","name":"Salhan, Suchir","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Raj Sanjay","familyName":"Shah","name":"Shah, Raj Sanjay","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Alex","familyName":"Warstadt","name":"Warstadt, Alex","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Ethan Gotlieb","familyName":"Wilcox","name":"Wilcox, Ethan Gotlieb","affiliation":[],"nameIdentifiers":[]}],"titles":[{"title":"BabyLM Turns 4 and Goes Multilingual: Call for Papers for the 2026 BabyLM Workshop"}],"publisher":"arXiv","container":{},"publicationYear":2026,"subjects":[{"subject":"Computation and Language (cs.CL)","lang":"en","subjectScheme":"arXiv"},{"subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"},{"schemeUri":"http://www.oecd.org/science/inno/38235147.pdf","subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"}],"contributors":[],"dates":[{"date":"2026-02-23T18:02:23Z","dateType":"Submitted","dateInformation":"v1"},{"date":"2026-02-24T02:43:20Z","dateType":"Updated","dateInformation":"v1"},{"date":"2026-02-24T17:51:23Z","dateType":"Submitted","dateInformation":"v2"},{"date":"2026-02-25T02:03:16Z","dateType":"Updated","dateInformation":"v2"},{"date":"2026-02","dateType":"Available","dateInformation":"v1"},{"date":"2026","dateType":"Issued"}],"language":null,"types":{"schemaOrg":"CreativeWork","resourceTypeGeneral":"Preprint","citeproc":"article","bibtex":"misc","ris":"GEN","resourceType":"Article"},"relatedIdentifiers":[],"relatedItems":[],"sizes":[],"formats":[],"version":"2","rightsList":[{"rightsIdentifierScheme":"SPDX","rightsUri":"https://creativecommons.org/licenses/by/4.0/legalcode","schemeUri":"https://spdx.org/licenses/","rights":"Creative Commons Attribution 4.0 International","rightsIdentifier":"cc-by-4.0"}],"descriptions":[{"descriptionType":"Abstract","description":"The goal of the BabyLM is to stimulate new research connections between cognitive modeling and language model pretraining. We invite contributions in this vein to the BabyLM Workshop, which will also include the 4th iteration of the BabyLM Challenge. As in previous years, the challenge features two ``standard'' tracks (Strict and Strict-Small), in which participants must train language models on under 100M or 10M words of data, respectively. This year, we move beyond our previous English-only pretraining datasets with a new Multilingual track, focusing on English, Dutch, and Chinese. For the workshop, we call for papers related to the overall theme of BabyLM, which includes training efficiency, small-scale training datasets, cognitive modeling, model evaluation, and architecture innovation."},{"descriptionType":"Other","description":"8 pages, 1 table. arXiv admin note: substantial text overlap with arXiv:2502.10645"}],"geoLocations":[],"fundingReferences":[],"url":"https://arxiv.org/abs/2602.20092","contentUrl":null,"metadataVersion":0,"schemaVersion":"http://datacite.org/schema/kernel-4","source":"mds","isActive":true,"state":"findable","reason":null,"viewCount":0,"downloadCount":0,"referenceCount":0,"citationCount":0,"partCount":0,"partOfCount":0,"versionCount":0,"versionOfCount":0,"created":"2026-02-25T15:27:35Z","registered":"2026-02-25T15:27:36Z","published":null,"updated":"2026-02-25T15:27:36Z"},"relationships":{"client":{"data":{"id":"arxiv.content","type":"clients"}}}},{"id":"10.48550/arxiv.2602.20090","type":"dois","attributes":{"doi":"10.48550/arxiv.2602.20090","identifiers":[{"identifier":"2602.20090","identifierType":"arXiv"}],"creators":[{"nameType":"Personal","givenName":"Weisong","familyName":"Dong","name":"Dong, Weisong","affiliation":[],"nameIdentifiers":[]}],"titles":[{"title":"A Liouville-type theorem for $2$-Monge-Ampère equation in dimension three"}],"publisher":"arXiv","container":{},"publicationYear":2026,"subjects":[{"subject":"Analysis of PDEs (math.AP)","lang":"en","subjectScheme":"arXiv"},{"subject":"FOS: Mathematics","subjectScheme":"Fields of Science and Technology (FOS)"},{"schemeUri":"http://www.oecd.org/science/inno/38235147.pdf","subject":"FOS: Mathematics","subjectScheme":"Fields of Science and Technology (FOS)"}],"contributors":[],"dates":[{"date":"2026-02-23T18:02:03Z","dateType":"Submitted","dateInformation":"v1"},{"date":"2026-02-24T02:43:17Z","dateType":"Updated","dateInformation":"v1"},{"date":"2026-02","dateType":"Available","dateInformation":"v1"},{"date":"2026","dateType":"Issued"}],"language":null,"types":{"schemaOrg":"CreativeWork","resourceTypeGeneral":"Preprint","citeproc":"article","bibtex":"misc","ris":"GEN","resourceType":"Article"},"relatedIdentifiers":[],"relatedItems":[],"sizes":[],"formats":[],"version":"1","rightsList":[{"rightsUri":"http://arxiv.org/licenses/nonexclusive-distrib/1.0/","rights":"arXiv.org perpetual, non-exclusive license"}],"descriptions":[{"descriptionType":"Abstract","description":"We prove that every entire solution with quadratic growth, lying in a suitable cone, to the 2-Monge-Ampère equation on $\\mathbb{R}^3$ is a quadratic polynomial. The proof proceeds by first establishing a concavity inequality, and then deriving a Pogorelov-type interior $C^2$ estimate."},{"descriptionType":"Other","description":"18pages"}],"geoLocations":[],"fundingReferences":[],"url":"https://arxiv.org/abs/2602.20090","contentUrl":null,"metadataVersion":0,"schemaVersion":"http://datacite.org/schema/kernel-4","source":"mds","isActive":true,"state":"findable","reason":null,"viewCount":0,"downloadCount":0,"referenceCount":0,"citationCount":0,"partCount":0,"partOfCount":0,"versionCount":0,"versionOfCount":0,"created":"2026-02-25T15:27:31Z","registered":"2026-02-25T15:27:31Z","published":null,"updated":"2026-02-25T15:27:31Z"},"relationships":{"client":{"data":{"id":"arxiv.content","type":"clients"}}}},{"id":"10.48550/arxiv.2602.20088","type":"dois","attributes":{"doi":"10.48550/arxiv.2602.20088","identifiers":[{"identifier":"2602.20088","identifierType":"arXiv"}],"creators":[{"nameType":"Personal","givenName":"Giulia L.","familyName":"Celora","name":"Celora, Giulia L.","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Benjamin J.","familyName":"Walker","name":"Walker, Benjamin J.","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Mohit P.","familyName":"Dalwadi","name":"Dalwadi, Mohit P.","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Philip","familyName":"Pearce","name":"Pearce, Philip","affiliation":[],"nameIdentifiers":[]}],"titles":[{"title":"Chemotaxis of cell aggregates: morphology and dynamics of migrating active droplets"}],"publisher":"arXiv","container":{},"publicationYear":2026,"subjects":[{"subject":"Soft Condensed Matter (cond-mat.soft)","lang":"en","subjectScheme":"arXiv"},{"subject":"Analysis of PDEs (math.AP)","lang":"en","subjectScheme":"arXiv"},{"subject":"Biological Physics (physics.bio-ph)","lang":"en","subjectScheme":"arXiv"},{"subject":"Fluid Dynamics (physics.flu-dyn)","lang":"en","subjectScheme":"arXiv"},{"subject":"FOS: Physical sciences","subjectScheme":"Fields of Science and Technology (FOS)"},{"schemeUri":"http://www.oecd.org/science/inno/38235147.pdf","subject":"FOS: Physical sciences","subjectScheme":"Fields of Science and Technology (FOS)"},{"subject":"FOS: Mathematics","subjectScheme":"Fields of Science and Technology (FOS)"},{"schemeUri":"http://www.oecd.org/science/inno/38235147.pdf","subject":"FOS: Mathematics","subjectScheme":"Fields of Science and Technology (FOS)"}],"contributors":[],"dates":[{"date":"2026-02-23T17:56:28Z","dateType":"Submitted","dateInformation":"v1"},{"date":"2026-02-24T02:42:59Z","dateType":"Updated","dateInformation":"v1"},{"date":"2026-02","dateType":"Available","dateInformation":"v1"},{"date":"2026","dateType":"Issued"}],"language":null,"types":{"schemaOrg":"CreativeWork","resourceTypeGeneral":"Preprint","citeproc":"article","bibtex":"misc","ris":"GEN","resourceType":"Article"},"relatedIdentifiers":[],"relatedItems":[],"sizes":[],"formats":[],"version":"1","rightsList":[{"rightsIdentifierScheme":"SPDX","rightsUri":"https://creativecommons.org/licenses/by/4.0/legalcode","schemeUri":"https://spdx.org/licenses/","rights":"Creative Commons Attribution 4.0 International","rightsIdentifier":"cc-by-4.0"}],"descriptions":[{"descriptionType":"Abstract","description":"Biological tissues have been observed to display emergent fluid-like properties, owing to physical interactions between cells. However, it remains unclear in general how these fluid-like properties affect tissue structure and function. Here, we are motivated by recent experiments in which cell aggregates were observed to behave as active droplets during collective migration along chemical gradients, or chemotaxis. To understand this process, we develop a minimal model of a growing thin active droplet driven by a self-generated chemical gradient. In broad agreement with the experiments, dynamic simulations reveal that chemotacting droplets exhibit proliferation-driven morphological transitions. To fully characterise these transitions, we perform a multiple scales analysis to show that the droplet dynamics follow a sequence of travelling wave solutions defined by a nonlinear eigenvalue problem parametrised by the slowly increasing droplet volume. Our analysis reveals that morphological transitions can occur continuously or through a discontinuous bifurcation. Further asymptotic analysis of the travelling wave problem reveals that these morphological transitions arise from exponentially small (\"beyond-all-orders\") asymptotic terms that originate from the rear and front contact lines. Moreover, we show that the nature of the transitions is fully determined by two key dimensionless parameters, which quantify the internal stress balance within the droplet and the strength of the coupling between the droplet migration dynamics and the external chemical field. Overall, our results provide a complete characterisation of the morphodynamics of a class of migrating active thin droplets, with implications in a range of biological systems where cell aggregates exhibit fluid-like behaviour."}],"geoLocations":[],"fundingReferences":[],"url":"https://arxiv.org/abs/2602.20088","contentUrl":null,"metadataVersion":0,"schemaVersion":"http://datacite.org/schema/kernel-4","source":"mds","isActive":true,"state":"findable","reason":null,"viewCount":0,"downloadCount":0,"referenceCount":0,"citationCount":0,"partCount":0,"partOfCount":0,"versionCount":0,"versionOfCount":0,"created":"2026-02-25T15:27:26Z","registered":"2026-02-25T15:27:26Z","published":null,"updated":"2026-02-25T15:27:26Z"},"relationships":{"client":{"data":{"id":"arxiv.content","type":"clients"}}}},{"id":"10.48550/arxiv.2602.20084","type":"dois","attributes":{"doi":"10.48550/arxiv.2602.20084","identifiers":[{"identifier":"2602.20084","identifierType":"arXiv"}],"creators":[{"nameType":"Personal","givenName":"Martin","familyName":"Sinnona","name":"Sinnona, Martin","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Valentin","familyName":"Bonas","name":"Bonas, Valentin","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Viviana","familyName":"Siless","name":"Siless, Viviana","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Emmanuel","familyName":"Iarussi","name":"Iarussi, Emmanuel","affiliation":[],"nameIdentifiers":[]}],"titles":[{"title":"Do Large Language Models Understand Data Visualization Principles?"}],"publisher":"arXiv","container":{},"publicationYear":2026,"subjects":[{"subject":"Computer Vision and Pattern Recognition (cs.CV)","lang":"en","subjectScheme":"arXiv"},{"subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"},{"schemeUri":"http://www.oecd.org/science/inno/38235147.pdf","subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"}],"contributors":[],"dates":[{"date":"2026-02-23T17:51:06Z","dateType":"Submitted","dateInformation":"v1"},{"date":"2026-02-24T02:42:39Z","dateType":"Updated","dateInformation":"v1"},{"date":"2026-02","dateType":"Available","dateInformation":"v1"},{"date":"2026","dateType":"Issued"}],"language":null,"types":{"schemaOrg":"CreativeWork","resourceTypeGeneral":"Preprint","citeproc":"article","bibtex":"misc","ris":"GEN","resourceType":"Article"},"relatedIdentifiers":[],"relatedItems":[],"sizes":[],"formats":[],"version":"1","rightsList":[{"rightsIdentifierScheme":"SPDX","rightsUri":"https://creativecommons.org/licenses/by/4.0/legalcode","schemeUri":"https://spdx.org/licenses/","rights":"Creative Commons Attribution 4.0 International","rightsIdentifier":"cc-by-4.0"}],"descriptions":[{"descriptionType":"Abstract","description":"Data visualization principles, derived from decades of research in design and perception, ensure proper visual communication. While prior work has shown that large language models (LLMs) can generate charts or flag misleading figures, it remains unclear whether they and their vision-language counterparts (VLMs) can reason about and enforce visualization principles directly. Constraint based systems encode these principles as logical rules for precise automated checks, but translating them into formal specifications demands expert knowledge. This motivates leveraging LLMs and VLMs as principle checkers that can reason about visual design directly, bypassing the need for symbolic rule specification. In this paper, we present the first systematic evaluation of both LLMs and VLMs on their ability to reason about visualization principles, using hard verification ground truth derived from Answer Set Programming (ASP). We compiled a set of visualization principles expressed as natural-language statements and generated a controlled dataset of approximately 2,000 Vega-Lite specifications annotated with explicit principle violations, complemented by over 300 real-world Vega-Lite charts. We evaluated both checking and fixing tasks, assessing how well models detect principle violations and correct flawed chart specifications. Our work highlights both the promise of large (vision-)language models as flexible validators and editors of visualization designs and the persistent gap with symbolic solvers on more nuanced aspects of visual perception. They also reveal an interesting asymmetry: frontier models tend to be more effective at correcting violations than at detecting them reliably."}],"geoLocations":[],"fundingReferences":[],"url":"https://arxiv.org/abs/2602.20084","contentUrl":null,"metadataVersion":0,"schemaVersion":"http://datacite.org/schema/kernel-4","source":"mds","isActive":true,"state":"findable","reason":null,"viewCount":0,"downloadCount":0,"referenceCount":0,"citationCount":0,"partCount":0,"partOfCount":0,"versionCount":0,"versionOfCount":0,"created":"2026-02-25T15:27:16Z","registered":"2026-02-25T15:27:17Z","published":null,"updated":"2026-02-25T15:27:17Z"},"relationships":{"client":{"data":{"id":"arxiv.content","type":"clients"}}}},{"id":"10.48550/arxiv.2602.20082","type":"dois","attributes":{"doi":"10.48550/arxiv.2602.20082","identifiers":[{"identifier":"2602.20082","identifierType":"arXiv"}],"creators":[{"nameType":"Personal","givenName":"Zoe","familyName":"Paraskevopoulou","name":"Paraskevopoulou, Zoe","affiliation":[],"nameIdentifiers":[]}],"titles":[{"title":"Machine-Generated, Machine-Checked Proofs for a Verified Compiler (Experience Report)"}],"publisher":"arXiv","container":{},"publicationYear":2026,"subjects":[{"subject":"Programming Languages (cs.PL)","lang":"en","subjectScheme":"arXiv"},{"subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"},{"schemeUri":"http://www.oecd.org/science/inno/38235147.pdf","subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"}],"contributors":[],"dates":[{"date":"2026-02-23T17:48:24Z","dateType":"Submitted","dateInformation":"v1"},{"date":"2026-02-24T02:42:28Z","dateType":"Updated","dateInformation":"v1"},{"date":"2026-02","dateType":"Available","dateInformation":"v1"},{"date":"2026","dateType":"Issued"}],"language":null,"types":{"schemaOrg":"CreativeWork","resourceTypeGeneral":"Preprint","citeproc":"article","bibtex":"misc","ris":"GEN","resourceType":"Article"},"relatedIdentifiers":[],"relatedItems":[],"sizes":[],"formats":[],"version":"1","rightsList":[{"rightsIdentifierScheme":"SPDX","rightsUri":"https://creativecommons.org/licenses/by/4.0/legalcode","schemeUri":"https://spdx.org/licenses/","rights":"Creative Commons Attribution 4.0 International","rightsIdentifier":"cc-by-4.0"}],"descriptions":[{"descriptionType":"Abstract","description":"We report on using an agentic coding assistant (Claude Code, powered by Claude Opus 4.6) to mechanize a substantial Rocq correctness proof from scratch, with human guidance but without human proof writing. The proof establishes semantic preservation for the administrative normal form (ANF) transformation in the CertiCoq verified compiler for Rocq. The closely related continuation-passing style (CPS) transformation in CertiCoq was previously proved correct by human experts over several months. We use this proof as a template and instruct the LLM to adapt the proof technique to the ANF setting, which differs in important technical ways. The resulting ANF proof comprises approximately 7,800 lines of Rocq (larger than the 5,300-line CPS proof) and was developed in approximately 96 hours. We describe the proof technique and report on the experience of developing it with an LLM, discussing both the strengths and limitations of the approach and its implications for verified compiler construction."}],"geoLocations":[],"fundingReferences":[],"url":"https://arxiv.org/abs/2602.20082","contentUrl":null,"metadataVersion":0,"schemaVersion":"http://datacite.org/schema/kernel-4","source":"mds","isActive":true,"state":"findable","reason":null,"viewCount":0,"downloadCount":0,"referenceCount":0,"citationCount":0,"partCount":0,"partOfCount":0,"versionCount":0,"versionOfCount":0,"created":"2026-02-25T15:27:11Z","registered":"2026-02-25T15:27:12Z","published":null,"updated":"2026-02-25T15:27:12Z"},"relationships":{"client":{"data":{"id":"arxiv.content","type":"clients"}}}},{"id":"10.48550/arxiv.2602.20080","type":"dois","attributes":{"doi":"10.48550/arxiv.2602.20080","identifiers":[{"identifier":"2602.20080","identifierType":"arXiv"}],"creators":[{"nameType":"Personal","affiliation":["Harvard Kennedy School"],"givenName":"M. Alejandra","familyName":"Parra-Orlandoni","name":"Parra-Orlandoni, M. Alejandra","nameIdentifiers":[]},{"nameType":"Personal","affiliation":["Harvard Law School"],"givenName":"Roxanne A.","familyName":"Schnyder","name":"Schnyder, Roxanne A.","nameIdentifiers":[]},{"nameType":"Personal","affiliation":["Harvard Kennedy School"],"givenName":"Christopher J.","familyName":"Mallet","name":"Mallet, Christopher J.","nameIdentifiers":[]}],"titles":[{"title":"The Digital Gorilla: Rebalancing Power in the Age of AI"}],"publisher":"arXiv","container":{},"publicationYear":2026,"subjects":[{"subject":"Computers and Society (cs.CY)","lang":"en","subjectScheme":"arXiv"},{"subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"},{"schemeUri":"http://www.oecd.org/science/inno/38235147.pdf","subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"},{"subject":"K.4.1","lang":"en","subjectScheme":"ACM"}],"contributors":[],"dates":[{"date":"2026-02-23T17:46:54Z","dateType":"Submitted","dateInformation":"v1"},{"date":"2026-02-24T02:42:23Z","dateType":"Updated","dateInformation":"v1"},{"date":"2026-02","dateType":"Available","dateInformation":"v1"},{"date":"2026","dateType":"Issued"}],"language":null,"types":{"schemaOrg":"CreativeWork","resourceTypeGeneral":"Preprint","citeproc":"article","bibtex":"misc","ris":"GEN","resourceType":"Article"},"relatedIdentifiers":[],"relatedItems":[],"sizes":[],"formats":[],"version":"1","rightsList":[{"rightsIdentifierScheme":"SPDX","rightsUri":"https://creativecommons.org/licenses/by-sa/4.0/legalcode","schemeUri":"https://spdx.org/licenses/","rights":"Creative Commons Attribution Share Alike 4.0 International","rightsIdentifier":"cc-by-sa-4.0"}],"descriptions":[{"descriptionType":"Abstract","description":"Contemporary artificial intelligence (AI) policy suffers from a basic categorical error. Existing frameworks rely on analogizing AI to inherited technology types -- such as products, platforms, or infrastructure -- and in doing so generate overlapping, often contradictory governance regimes. This \"analogy trap\" obscures a fundamental transformation: certain advanced AI systems no longer function solely as instruments through which existing institutions exercise power, but as de facto centers of power that shape information, coordinate behavior, and structure social and economic realities at scale. This article offers a new conceptual foundation for AI governance by treating such systems as a fourth societal actor -- what we term the \"Digital Gorilla\" -- alongside People, the State, and Enterprises. It develops a Four Societal Actors framework that maps how power flows among these actors across five power modalities (economic, epistemic, narrative, authoritative, physical) and uses this map to diagnose where AI capabilities disturb established allocations of authority, concentrate power, or erode accountability. Drawing on constitutional principles of separated powers and federalism, the article advances a federalized, polycentric governance architecture and institutionalizes dynamic checks and balances among the four actors, rather than today's more reactive and compliance-driven approaches. Reframing AI governance in this way shifts the inquiry from how to control a risky technology to how to design institutions capable of accommodating these increasingly powerful and autonomous digital systems without sacrificing democratic legitimacy, the rule of law, or the production of public goods, and it recasts familiar debates in administrative, constitutional, and corporate law as questions of power allocation in a four-actor system."},{"descriptionType":"Other","description":"49 pages, 2 figures, preprint"}],"geoLocations":[],"fundingReferences":[],"url":"https://arxiv.org/abs/2602.20080","contentUrl":null,"metadataVersion":0,"schemaVersion":"http://datacite.org/schema/kernel-4","source":"mds","isActive":true,"state":"findable","reason":null,"viewCount":0,"downloadCount":0,"referenceCount":0,"citationCount":0,"partCount":0,"partOfCount":0,"versionCount":0,"versionOfCount":0,"created":"2026-02-25T15:27:06Z","registered":"2026-02-25T15:27:07Z","published":null,"updated":"2026-02-25T15:27:07Z"},"relationships":{"client":{"data":{"id":"arxiv.content","type":"clients"}}}},{"id":"10.48550/arxiv.2602.20079","type":"dois","attributes":{"doi":"10.48550/arxiv.2602.20079","identifiers":[{"identifier":"2602.20079","identifierType":"arXiv"}],"creators":[{"nameType":"Personal","givenName":"Xinya","familyName":"Chen","name":"Chen, Xinya","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Christopher","familyName":"Wewer","name":"Wewer, Christopher","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Jiahao","familyName":"Xie","name":"Xie, Jiahao","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Xinting","familyName":"Hu","name":"Hu, Xinting","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Jan Eric","familyName":"Lenssen","name":"Lenssen, Jan Eric","affiliation":[],"nameIdentifiers":[]}],"titles":[{"title":"SemanticNVS: Improving Semantic Scene Understanding in Generative Novel View Synthesis"}],"publisher":"arXiv","container":{},"publicationYear":2026,"subjects":[{"subject":"Computer Vision and Pattern Recognition (cs.CV)","lang":"en","subjectScheme":"arXiv"},{"subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"},{"schemeUri":"http://www.oecd.org/science/inno/38235147.pdf","subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"}],"contributors":[],"dates":[{"date":"2026-02-23T17:45:21Z","dateType":"Submitted","dateInformation":"v1"},{"date":"2026-02-24T02:42:15Z","dateType":"Updated","dateInformation":"v1"},{"date":"2026-02","dateType":"Available","dateInformation":"v1"},{"date":"2026","dateType":"Issued"}],"language":null,"types":{"schemaOrg":"CreativeWork","resourceTypeGeneral":"Preprint","citeproc":"article","bibtex":"misc","ris":"GEN","resourceType":"Article"},"relatedIdentifiers":[],"relatedItems":[],"sizes":[],"formats":[],"version":"1","rightsList":[{"rightsUri":"http://arxiv.org/licenses/nonexclusive-distrib/1.0/","rights":"arXiv.org perpetual, non-exclusive license"}],"descriptions":[{"descriptionType":"Abstract","description":"We present SemanticNVS, a camera-conditioned multi-view diffusion model for novel view synthesis (NVS), which improves generation quality and consistency by integrating pre-trained semantic feature extractors. Existing NVS methods perform well for views near the input view, however, they tend to generate semantically implausible and distorted images under long-range camera motion, revealing severe degradation. We speculate that this degradation is due to current models failing to fully understand their conditioning or intermediate generated scene content. Here, we propose to integrate pre-trained semantic feature extractors to incorporate stronger scene semantics as conditioning to achieve high-quality generation even at distant viewpoints. We investigate two different strategies, (1) warped semantic features and (2) an alternating scheme of understanding and generation at each denoising step. Experimental results on multiple datasets demonstrate the clear qualitative and quantitative (4.69%-15.26% in FID) improvement over state-of-the-art alternatives."}],"geoLocations":[],"fundingReferences":[],"url":"https://arxiv.org/abs/2602.20079","contentUrl":null,"metadataVersion":0,"schemaVersion":"http://datacite.org/schema/kernel-4","source":"mds","isActive":true,"state":"findable","reason":null,"viewCount":0,"downloadCount":0,"referenceCount":0,"citationCount":0,"partCount":0,"partOfCount":0,"versionCount":0,"versionOfCount":0,"created":"2026-02-25T15:27:04Z","registered":"2026-02-25T15:27:04Z","published":null,"updated":"2026-02-25T15:27:04Z"},"relationships":{"client":{"data":{"id":"arxiv.content","type":"clients"}}}},{"id":"10.48550/arxiv.2602.20077","type":"dois","attributes":{"doi":"10.48550/arxiv.2602.20077","identifiers":[{"identifier":"2602.20077","identifierType":"arXiv"}],"creators":[{"nameType":"Personal","givenName":"Fabricio Danel","familyName":"Matias","name":"Matias, Fabricio Danel","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Facundo","familyName":"Arreyes","name":"Arreyes, Facundo","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Juan Sebastián","familyName":"Ardenghi","name":"Ardenghi, Juan Sebastián","affiliation":[],"nameIdentifiers":[]}],"titles":[{"title":"Entanglement formation in two-dimensional materials within microcavity"}],"publisher":"arXiv","container":{},"publicationYear":2026,"subjects":[{"subject":"Quantum Physics (quant-ph)","lang":"en","subjectScheme":"arXiv"},{"subject":"Strongly Correlated Electrons (cond-mat.str-el)","lang":"en","subjectScheme":"arXiv"},{"subject":"FOS: Physical sciences","subjectScheme":"Fields of Science and Technology (FOS)"},{"schemeUri":"http://www.oecd.org/science/inno/38235147.pdf","subject":"FOS: Physical sciences","subjectScheme":"Fields of Science and Technology (FOS)"},{"subject":"81P40","lang":"en","subjectScheme":"MSC"}],"contributors":[],"dates":[{"date":"2026-02-23T17:42:46Z","dateType":"Submitted","dateInformation":"v1"},{"date":"2026-02-24T02:42:10Z","dateType":"Updated","dateInformation":"v1"},{"date":"2026-02","dateType":"Available","dateInformation":"v1"},{"date":"2026","dateType":"Issued"}],"language":null,"types":{"schemaOrg":"CreativeWork","resourceTypeGeneral":"Preprint","citeproc":"article","bibtex":"misc","ris":"GEN","resourceType":"Article"},"relatedIdentifiers":[],"relatedItems":[],"sizes":[],"formats":[],"version":"1","rightsList":[{"rightsUri":"http://arxiv.org/licenses/nonexclusive-distrib/1.0/","rights":"arXiv.org perpetual, non-exclusive license"}],"descriptions":[{"descriptionType":"Abstract","description":"In this work, the entanglement generation between two hexagonal-lattice layers embedded in a microcavity is studied, accounting for both electromagnetic coupling and intrinsic spin-orbit interaction (SOI). Utilizing a short-time dynamical approach, we perform a perturbative Taylor expansion of the reduced density matrix to characterize the bipartite quantum correlations between the hexagonal layers. We demonstrate that the system undergoes a rapid transition from a localized product state in the conduction bands at t = 0 to a coherent superposition of valence and conduction band states. Our results indicate that the degree of entanglement is highly sensitive to the interlayer photon propagator, which contains the geometric ratios of the layer positions and the height cavity, and the specific Fermi energy and SOI signatures of the respective layers. We show the emergence of spacelike-separated quantum correlations in the ultra-short evolution regime, suggesting that heterostructures in cavities may be suitable to develop experiments for a deep understanding of spacelike-separated quantum effects."},{"descriptionType":"Other","description":"10 pages"}],"geoLocations":[],"fundingReferences":[],"url":"https://arxiv.org/abs/2602.20077","contentUrl":null,"metadataVersion":0,"schemaVersion":"http://datacite.org/schema/kernel-4","source":"mds","isActive":true,"state":"findable","reason":null,"viewCount":0,"downloadCount":0,"referenceCount":0,"citationCount":0,"partCount":0,"partOfCount":0,"versionCount":0,"versionOfCount":0,"created":"2026-02-25T15:26:58Z","registered":"2026-02-25T15:26:59Z","published":null,"updated":"2026-02-25T15:26:59Z"},"relationships":{"client":{"data":{"id":"arxiv.content","type":"clients"}}}},{"id":"10.48550/arxiv.2602.20076","type":"dois","attributes":{"doi":"10.48550/arxiv.2602.20076","identifiers":[{"identifier":"2602.20076","identifierType":"arXiv"}],"creators":[{"nameType":"Personal","givenName":"Wei","familyName":"Xiao","name":"Xiao, Wei","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Christos","familyName":"Cassandras","name":"Cassandras, Christos","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Anni","familyName":"Li","name":"Li, Anni","affiliation":[],"nameIdentifiers":[]}],"titles":[{"title":"Robust Taylor-Lagrange Control for Safety-Critical Systems"}],"publisher":"arXiv","container":{},"publicationYear":2026,"subjects":[{"subject":"Systems and Control (eess.SY)","lang":"en","subjectScheme":"arXiv"},{"subject":"Artificial Intelligence (cs.AI)","lang":"en","subjectScheme":"arXiv"},{"subject":"Robotics (cs.RO)","lang":"en","subjectScheme":"arXiv"},{"subject":"FOS: Electrical engineering, electronic engineering, information engineering","subjectScheme":"Fields of Science and Technology (FOS)"},{"schemeUri":"http://www.oecd.org/science/inno/38235147.pdf","subject":"FOS: Electrical engineering, electronic engineering, information engineering","subjectScheme":"Fields of Science and Technology (FOS)"},{"subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"},{"schemeUri":"http://www.oecd.org/science/inno/38235147.pdf","subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"}],"contributors":[],"dates":[{"date":"2026-02-23T17:40:05Z","dateType":"Submitted","dateInformation":"v1"},{"date":"2026-02-24T02:42:00Z","dateType":"Updated","dateInformation":"v1"},{"date":"2026-02","dateType":"Available","dateInformation":"v1"},{"date":"2026","dateType":"Issued"}],"language":null,"types":{"schemaOrg":"CreativeWork","resourceTypeGeneral":"Preprint","citeproc":"article","bibtex":"misc","ris":"GEN","resourceType":"Article"},"relatedIdentifiers":[],"relatedItems":[],"sizes":[],"formats":[],"version":"1","rightsList":[{"rightsUri":"http://arxiv.org/licenses/nonexclusive-distrib/1.0/","rights":"arXiv.org perpetual, non-exclusive license"}],"descriptions":[{"descriptionType":"Abstract","description":"Solving safety-critical control problem has widely adopted the Control Barrier Function (CBF) method. However, the existence of a CBF is only a sufficient condition for system safety. The recently proposed Taylor-Lagrange Control (TLC) method addresses this limitation, but is vulnerable to the feasibility preservation problem (e.g., inter-sampling effect). In this paper, we propose a robust TLC (rTLC) method to address the feasibility preservation problem. Specifically, the rTLC method expands the safety function at an order higher than the relative degree of the function using Taylor's expansion with Lagrange remainder, which allows the control to explicitly show up at the current time instead of the future time in the TLC method. The rTLC method naturally addresses the feasibility preservation problem with only one hyper-parameter (the discretization time interval size during implementation), which is much less than its counterparts. Finally, we illustrate the effectiveness of the proposed rTLC method through an adaptive cruise control problem, and compare it with existing safety-critical control methods."},{"descriptionType":"Other","description":"7 pages"}],"geoLocations":[],"fundingReferences":[],"url":"https://arxiv.org/abs/2602.20076","contentUrl":null,"metadataVersion":0,"schemaVersion":"http://datacite.org/schema/kernel-4","source":"mds","isActive":true,"state":"findable","reason":null,"viewCount":0,"downloadCount":0,"referenceCount":0,"citationCount":0,"partCount":0,"partOfCount":0,"versionCount":0,"versionOfCount":0,"created":"2026-02-25T15:26:55Z","registered":"2026-02-25T15:26:56Z","published":null,"updated":"2026-02-25T15:26:56Z"},"relationships":{"client":{"data":{"id":"arxiv.content","type":"clients"}}}},{"id":"10.48550/arxiv.2602.20074","type":"dois","attributes":{"doi":"10.48550/arxiv.2602.20074","identifiers":[{"identifier":"2602.20074","identifierType":"arXiv"}],"creators":[{"nameType":"Personal","givenName":"Dorothea","familyName":"Baumeister","name":"Baumeister, Dorothea","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Ratip Emin","familyName":"Berker","name":"Berker, Ratip Emin","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Niclas","familyName":"Boehmer","name":"Boehmer, Niclas","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Sylvain","familyName":"Bouveret","name":"Bouveret, Sylvain","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Andreas","familyName":"Darmann","name":"Darmann, Andreas","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Piotr","familyName":"Faliszewski","name":"Faliszewski, Piotr","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Martin","familyName":"Lackner","name":"Lackner, Martin","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Jérôme","familyName":"Lang","name":"Lang, Jérôme","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Nicholas","familyName":"Mattei","name":"Mattei, Nicholas","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Arianna","familyName":"Novaro","name":"Novaro, Arianna","affiliation":[],"nameIdentifiers":[]}],"titles":[{"title":"Computational Social Choice: Research \u0026amp; Development"}],"publisher":"arXiv","container":{},"publicationYear":2026,"subjects":[{"subject":"Computer Science and Game Theory (cs.GT)","lang":"en","subjectScheme":"arXiv"},{"subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"},{"schemeUri":"http://www.oecd.org/science/inno/38235147.pdf","subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"}],"contributors":[],"dates":[{"date":"2026-02-23T17:35:27Z","dateType":"Submitted","dateInformation":"v1"},{"date":"2026-02-24T02:41:47Z","dateType":"Updated","dateInformation":"v1"},{"date":"2026-02","dateType":"Available","dateInformation":"v1"},{"date":"2026","dateType":"Issued"}],"language":null,"types":{"schemaOrg":"CreativeWork","resourceTypeGeneral":"Preprint","citeproc":"article","bibtex":"misc","ris":"GEN","resourceType":"Article"},"relatedIdentifiers":[],"relatedItems":[],"sizes":[],"formats":[],"version":"1","rightsList":[{"rightsUri":"http://arxiv.org/licenses/nonexclusive-distrib/1.0/","rights":"arXiv.org perpetual, non-exclusive license"}],"descriptions":[{"descriptionType":"Abstract","description":"Computational social choice (COMSOC) studies principled ways to aggregate conflicting individual preferences into collective decisions. In this paper, we call for an increased effort towards Computational Social Choice: Research \u0026amp; Development (COMSOC-R\u0026amp;D), a problem-driven research agenda that explicitly aims to design, implement, and test collective decision-making systems in the real world. We articulate the defining features of COMSOC-R\u0026amp;D, argue for its value, and discuss various roadblocks and possible solutions."},{"descriptionType":"Other","description":"Accepted to AAMAS '26: Blue Sky Track"}],"geoLocations":[],"fundingReferences":[],"url":"https://arxiv.org/abs/2602.20074","contentUrl":null,"metadataVersion":0,"schemaVersion":"http://datacite.org/schema/kernel-4","source":"mds","isActive":true,"state":"findable","reason":null,"viewCount":0,"downloadCount":0,"referenceCount":0,"citationCount":0,"partCount":0,"partOfCount":0,"versionCount":0,"versionOfCount":0,"created":"2026-02-25T15:26:50Z","registered":"2026-02-25T15:26:51Z","published":null,"updated":"2026-02-25T15:26:51Z"},"relationships":{"client":{"data":{"id":"arxiv.content","type":"clients"}}}},{"id":"10.48550/arxiv.2602.20073","type":"dois","attributes":{"doi":"10.48550/arxiv.2602.20073","identifiers":[{"identifier":"2602.20073","identifierType":"arXiv"}],"creators":[{"nameType":"Personal","givenName":"Robin","familyName":"Scholle","name":"Scholle, Robin","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Pietro M.","familyName":"Bonetti","name":"Bonetti, Pietro M.","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Walter","familyName":"Metzner","name":"Metzner, Walter","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Demetrio","familyName":"Vilardi","name":"Vilardi, Demetrio","affiliation":[],"nameIdentifiers":[]}],"titles":[{"title":"Coexisting magnetic, charge, and superconducting orders in the two-dimensional Hubbard model"}],"publisher":"arXiv","container":{},"publicationYear":2026,"subjects":[{"subject":"Strongly Correlated Electrons (cond-mat.str-el)","lang":"en","subjectScheme":"arXiv"},{"subject":"FOS: Physical sciences","subjectScheme":"Fields of Science and Technology (FOS)"},{"schemeUri":"http://www.oecd.org/science/inno/38235147.pdf","subject":"FOS: Physical sciences","subjectScheme":"Fields of Science and Technology (FOS)"}],"contributors":[],"dates":[{"date":"2026-02-23T17:34:34Z","dateType":"Submitted","dateInformation":"v1"},{"date":"2026-02-24T02:41:37Z","dateType":"Updated","dateInformation":"v1"},{"date":"2026-02","dateType":"Available","dateInformation":"v1"},{"date":"2026","dateType":"Issued"}],"language":null,"types":{"schemaOrg":"CreativeWork","resourceTypeGeneral":"Preprint","citeproc":"article","bibtex":"misc","ris":"GEN","resourceType":"Article"},"relatedIdentifiers":[],"relatedItems":[],"sizes":[],"formats":[],"version":"1","rightsList":[{"rightsIdentifierScheme":"SPDX","rightsUri":"https://creativecommons.org/licenses/by/4.0/legalcode","schemeUri":"https://spdx.org/licenses/","rights":"Creative Commons Attribution 4.0 International","rightsIdentifier":"cc-by-4.0"}],"descriptions":[{"descriptionType":"Abstract","description":"We perform a renormalized mean-field study of the two-dimensional repulsive Hubbard model, focusing on the intricate interplay and possible coexistence of magnetic, charge, and superconducting orders. We improve on conventional mean-field theory by utilizing a renormalization group framework that captures high-energy fluctuations. This method generates effective magnetic and $d$-wave pairing interactions, and allows for an unbiased exploration of coexisting phases at weak and moderate interaction strengths. Unrestricted mean-field calculations of the effective Hamiltonian on large finite lattices are combined with analyses in the thermodynamic limit, revealing a rich phase diagram with extensive regions of coexisting orders. We find that $d$-wave superconductivity coexists with Néel order on the electron-doped side. On the hole-doped side, superconductivity is found to coexist with spiral or stripe magnetic orders. Within the stripe ordered region, the superconducting order parameter is spatially modulated, with a period that follows the charge modulation of the stripes. Below van Hove filling, pairing provides the primary energy gain, while the stripe order yields only a small, and hence fragile, additional energy lowering."}],"geoLocations":[],"fundingReferences":[],"url":"https://arxiv.org/abs/2602.20073","contentUrl":null,"metadataVersion":0,"schemaVersion":"http://datacite.org/schema/kernel-4","source":"mds","isActive":true,"state":"findable","reason":null,"viewCount":0,"downloadCount":0,"referenceCount":0,"citationCount":0,"partCount":0,"partOfCount":0,"versionCount":0,"versionOfCount":0,"created":"2026-02-25T15:26:48Z","registered":"2026-02-25T15:26:49Z","published":null,"updated":"2026-02-25T15:26:49Z"},"relationships":{"client":{"data":{"id":"arxiv.content","type":"clients"}}}},{"id":"10.48550/arxiv.2602.20072","type":"dois","attributes":{"doi":"10.48550/arxiv.2602.20072","identifiers":[{"identifier":"2602.20072","identifierType":"arXiv"}],"creators":[{"nameType":"Personal","givenName":"Genly","familyName":"Leon","name":"Leon, Genly","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Amare","familyName":"Abebe","name":"Abebe, Amare","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Andronikos","familyName":"Paliathanasis","name":"Paliathanasis, Andronikos","affiliation":[],"nameIdentifiers":[]}],"titles":[{"title":"Dynamics of the Bianchi~V cosmological model inspired by quintessential $α$-attractors"}],"publisher":"arXiv","container":{},"publicationYear":2026,"subjects":[{"subject":"General Relativity and Quantum Cosmology (gr-qc)","lang":"en","subjectScheme":"arXiv"},{"subject":"High Energy Physics - Theory (hep-th)","lang":"en","subjectScheme":"arXiv"},{"subject":"Mathematical Physics (math-ph)","lang":"en","subjectScheme":"arXiv"},{"subject":"FOS: Physical sciences","subjectScheme":"Fields of Science and Technology (FOS)"},{"schemeUri":"http://www.oecd.org/science/inno/38235147.pdf","subject":"FOS: Physical sciences","subjectScheme":"Fields of Science and Technology (FOS)"}],"contributors":[],"dates":[{"date":"2026-02-23T17:34:11Z","dateType":"Submitted","dateInformation":"v1"},{"date":"2026-02-24T02:41:35Z","dateType":"Updated","dateInformation":"v1"},{"date":"2026-02","dateType":"Available","dateInformation":"v1"},{"date":"2026","dateType":"Issued"}],"language":null,"types":{"schemaOrg":"CreativeWork","resourceTypeGeneral":"Preprint","citeproc":"article","bibtex":"misc","ris":"GEN","resourceType":"Article"},"relatedIdentifiers":[],"relatedItems":[],"sizes":[],"formats":[],"version":"1","rightsList":[{"rightsUri":"http://arxiv.org/licenses/nonexclusive-distrib/1.0/","rights":"arXiv.org perpetual, non-exclusive license"}],"descriptions":[{"descriptionType":"Abstract","description":"We investigate scalar-field cosmologies in the Bianchi V spacetime using a dynamical-systems framework. Motivated by representative $α$-attractor potentials - the E-model and T-model - we apply averaging theorems and amplitude--phase reductions to monomial potentials $\\sim ϕ^{2n}$ of the scalar field, which approximate the attractor models near their minima, in the presence of matter with barotropic index $γ$. The reduced averaged system admits five generic isolated equilibria: Kasner vacua $\\mathcal{K}_0^\\pm$, the matter FLRW point $\\mathcal{F}$, the scalar FLRW point $\\mathcal{S}$, and the curvature Milne-type point $\\mathcal{K}$, together with special families for tuned $(n,γ)$. We find that $\\mathcal{K}_0^\\pm$ are always sources, $\\mathcal{F}$ is generically a saddle but can act as a sink for $γ\u0026lt;\\min\\{\\tfrac{2n}{n+1},\\tfrac{2}{3}\\}$, $\\mathcal{S}$ is a sink if $0\\tfrac{2}{3}$ and $n\u0026gt;\\tfrac{1}{2}$. These results demonstrate that isotropic FLRW $α$-attractor models extend naturally to anisotropic Bianchi~V cosmologies: inflationary attractors remain robust, while the Milne-type curvature solution emerges as the late-time state."},{"descriptionType":"Other","description":"32 pages, 8 compound figures, 3 tables"}],"geoLocations":[],"fundingReferences":[],"url":"https://arxiv.org/abs/2602.20072","contentUrl":null,"metadataVersion":0,"schemaVersion":"http://datacite.org/schema/kernel-4","source":"mds","isActive":true,"state":"findable","reason":null,"viewCount":0,"downloadCount":0,"referenceCount":0,"citationCount":0,"partCount":0,"partOfCount":0,"versionCount":0,"versionOfCount":0,"created":"2026-02-25T15:26:46Z","registered":"2026-02-25T15:26:46Z","published":null,"updated":"2026-02-25T15:26:46Z"},"relationships":{"client":{"data":{"id":"arxiv.content","type":"clients"}}}},{"id":"10.48550/arxiv.2602.20071","type":"dois","attributes":{"doi":"10.48550/arxiv.2602.20071","identifiers":[{"identifier":"2602.20071","identifierType":"arXiv"}],"creators":[{"nameType":"Personal","givenName":"A. Martín","familyName":"Andrés","name":"Andrés, A. Martín","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"M. Álvarez","familyName":"Hernández","name":"Hernández, M. Álvarez","affiliation":[],"nameIdentifiers":[]}],"titles":[{"title":"Estimators of different delta coefficients based on the unbiased estimator of the expected proportions of agreements"}],"publisher":"arXiv","container":{},"publicationYear":2026,"subjects":[{"subject":"Statistics Theory (math.ST)","lang":"en","subjectScheme":"arXiv"},{"subject":"Applications (stat.AP)","lang":"en","subjectScheme":"arXiv"},{"subject":"Methodology (stat.ME)","lang":"en","subjectScheme":"arXiv"},{"subject":"FOS: Mathematics","subjectScheme":"Fields of Science and Technology (FOS)"},{"schemeUri":"http://www.oecd.org/science/inno/38235147.pdf","subject":"FOS: Mathematics","subjectScheme":"Fields of Science and Technology (FOS)"},{"subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"},{"schemeUri":"http://www.oecd.org/science/inno/38235147.pdf","subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"}],"contributors":[],"dates":[{"date":"2026-02-23T17:27:51Z","dateType":"Submitted","dateInformation":"v1"},{"date":"2026-02-24T02:41:20Z","dateType":"Updated","dateInformation":"v1"},{"date":"2026-02","dateType":"Available","dateInformation":"v1"},{"date":"2026","dateType":"Issued"}],"language":null,"types":{"schemaOrg":"CreativeWork","resourceTypeGeneral":"Preprint","citeproc":"article","bibtex":"misc","ris":"GEN","resourceType":"Article"},"relatedIdentifiers":[],"relatedItems":[],"sizes":[],"formats":[],"version":"1","rightsList":[{"rightsIdentifierScheme":"SPDX","rightsUri":"https://creativecommons.org/licenses/by-nc-nd/4.0/legalcode","schemeUri":"https://spdx.org/licenses/","rights":"Creative Commons Attribution Non Commercial No Derivatives 4.0 International","rightsIdentifier":"cc-by-nc-nd-4.0"}],"descriptions":[{"descriptionType":"Abstract","description":"To measure the degree of agreement between two observers that independently classify $n$ subjects within $K$ categories, it is common to use different kappa type coefficients, the most common of which is the $κ_C$ coefficient (Cohen's kappa). As $κ_C$ has some weaknesses -such as its poor performance with highly unbalanced marginal distributions-, the $Δ$ coefficient is sometimes used, based on the $delta$ response model. This model allows us to obtain other parameters like: (a) the $α_i$ contribution of each $i$ category to the value of the global agreement $Δ=\\sum α_i$; and (b) the consistency $\\mathcal{S}_i$ in the category $i$ (degree of agreement in the category $i$), a more appropriate parameter than the kappa value obtained by collapsing the data into the category $i$. It has recently been shown that the classic estimator $\\hatκ_C$ underestimates $κ_C$, having obtained a new estimator $\\hatκ_{CU}$ which is less biased. This article demonstrates that something similar happens to the known estimators $\\hatΔ$, $\\hatα_i$, and $\\hat{\\mathcal{S}}_i$ of $Δ$, $α_i$ and $\\mathcal{S}_i$ (respectively), proposes new and less biased estimators $\\hatΔ_U$, $\\hatα_{iU}$, and $\\hat{\\mathcal{S}}_{iU}$, determines their variances, analyses the behaviour of all estimators, and concludes that the new estimators should be used when $n$ or $K$ are small (at least when $n\\leq 50$ or $K\\leq 3$). Additionally, the case where one of the raters is a gold standard is contemplated, in which situation two new parameters arise: the $conformity$ (the rater's capability to recognize a subject in the category $i$) and the $predictivity$ (the reliability of a response $i$ by the rater)."}],"geoLocations":[],"fundingReferences":[],"url":"https://arxiv.org/abs/2602.20071","contentUrl":null,"metadataVersion":0,"schemaVersion":"http://datacite.org/schema/kernel-4","source":"mds","isActive":true,"state":"findable","reason":null,"viewCount":0,"downloadCount":0,"referenceCount":0,"citationCount":0,"partCount":0,"partOfCount":0,"versionCount":0,"versionOfCount":0,"created":"2026-02-25T15:26:43Z","registered":"2026-02-25T15:26:44Z","published":null,"updated":"2026-02-25T15:26:44Z"},"relationships":{"client":{"data":{"id":"arxiv.content","type":"clients"}}}},{"id":"10.48550/arxiv.2602.20068","type":"dois","attributes":{"doi":"10.48550/arxiv.2602.20068","identifiers":[{"identifier":"2602.20068","identifierType":"arXiv"}],"creators":[{"nameType":"Personal","givenName":"Harry","familyName":"Anthony","name":"Anthony, Harry","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Ziyun","familyName":"Liang","name":"Liang, Ziyun","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Hermione","familyName":"Warr","name":"Warr, Hermione","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Konstantinos","familyName":"Kamnitsas","name":"Kamnitsas, Konstantinos","affiliation":[],"nameIdentifiers":[]}],"titles":[{"title":"The Invisible Gorilla Effect in Out-of-distribution Detection"}],"publisher":"arXiv","container":{},"publicationYear":2026,"subjects":[{"subject":"Computer Vision and Pattern Recognition (cs.CV)","lang":"en","subjectScheme":"arXiv"},{"subject":"Machine Learning (cs.LG)","lang":"en","subjectScheme":"arXiv"},{"subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"},{"schemeUri":"http://www.oecd.org/science/inno/38235147.pdf","subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"}],"contributors":[],"dates":[{"date":"2026-02-23T17:24:18Z","dateType":"Submitted","dateInformation":"v1"},{"date":"2026-02-24T02:41:12Z","dateType":"Updated","dateInformation":"v1"},{"date":"2026-02","dateType":"Available","dateInformation":"v1"},{"date":"2026","dateType":"Issued"}],"language":null,"types":{"schemaOrg":"CreativeWork","resourceTypeGeneral":"Preprint","citeproc":"article","bibtex":"misc","ris":"GEN","resourceType":"Article"},"relatedIdentifiers":[],"relatedItems":[],"sizes":[],"formats":[],"version":"1","rightsList":[{"rightsUri":"http://arxiv.org/licenses/nonexclusive-distrib/1.0/","rights":"arXiv.org perpetual, non-exclusive license"}],"descriptions":[{"descriptionType":"Abstract","description":"Deep Neural Networks achieve high performance in vision tasks by learning features from regions of interest (ROI) within images, but their performance degrades when deployed on out-of-distribution (OOD) data that differs from training data. This challenge has led to OOD detection methods that aim to identify and reject unreliable predictions. Although prior work shows that OOD detection performance varies by artefact type, the underlying causes remain underexplored. To this end, we identify a previously unreported bias in OOD detection: for hard-to-detect artefacts (near-OOD), detection performance typically improves when the artefact shares visual similarity (e.g. colour) with the model's ROI and drops when it does not - a phenomenon we term the Invisible Gorilla Effect. For example, in a skin lesion classifier with red lesion ROI, we show the method Mahalanobis Score achieves a 31.5% higher AUROC when detecting OOD red ink (similar to ROI) compared to black ink (dissimilar) annotations. We annotated artefacts by colour in 11,355 images from three public datasets (e.g. ISIC) and generated colour-swapped counterfactuals to rule out dataset bias. We then evaluated 40 OOD methods across 7 benchmarks and found significant performance drops for most methods when artefacts differed from the ROI. Our findings highlight an overlooked failure mode in OOD detection and provide guidance for more robust detectors. Code and annotations are available at: https://github.com/HarryAnthony/Invisible_Gorilla_Effect."},{"descriptionType":"Other","description":"Accepted at CVPR 2026"}],"geoLocations":[],"fundingReferences":[],"url":"https://arxiv.org/abs/2602.20068","contentUrl":null,"metadataVersion":0,"schemaVersion":"http://datacite.org/schema/kernel-4","source":"mds","isActive":true,"state":"findable","reason":null,"viewCount":0,"downloadCount":0,"referenceCount":0,"citationCount":0,"partCount":0,"partOfCount":0,"versionCount":0,"versionOfCount":0,"created":"2026-02-25T15:26:36Z","registered":"2026-02-25T15:26:36Z","published":null,"updated":"2026-02-25T15:26:36Z"},"relationships":{"client":{"data":{"id":"arxiv.content","type":"clients"}}}},{"id":"10.48550/arxiv.2602.20066","type":"dois","attributes":{"doi":"10.48550/arxiv.2602.20066","identifiers":[{"identifier":"2602.20066","identifierType":"arXiv"}],"creators":[{"nameType":"Personal","givenName":"Kundan","familyName":"Thota","name":"Thota, Kundan","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Xuanhao","familyName":"Mu","name":"Mu, Xuanhao","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Thorsten","familyName":"Schlachter","name":"Schlachter, Thorsten","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Veit","familyName":"Hagenmeyer","name":"Hagenmeyer, Veit","affiliation":[],"nameIdentifiers":[]}],"titles":[{"title":"HeatPrompt: Zero-Shot Vision-Language Modeling of Urban Heat Demand from Satellite Images"}],"publisher":"arXiv","container":{},"publicationYear":2026,"subjects":[{"subject":"Computer Vision and Pattern Recognition (cs.CV)","lang":"en","subjectScheme":"arXiv"},{"subject":"Artificial Intelligence (cs.AI)","lang":"en","subjectScheme":"arXiv"},{"subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"},{"schemeUri":"http://www.oecd.org/science/inno/38235147.pdf","subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"}],"contributors":[],"dates":[{"date":"2026-02-23T17:22:54Z","dateType":"Submitted","dateInformation":"v1"},{"date":"2026-02-24T02:41:09Z","dateType":"Updated","dateInformation":"v1"},{"date":"2026-02","dateType":"Available","dateInformation":"v1"},{"date":"2026","dateType":"Issued"}],"language":null,"types":{"schemaOrg":"CreativeWork","resourceTypeGeneral":"Preprint","citeproc":"article","bibtex":"misc","ris":"GEN","resourceType":"Article"},"relatedIdentifiers":[],"relatedItems":[],"sizes":[],"formats":[],"version":"1","rightsList":[{"rightsUri":"http://arxiv.org/licenses/nonexclusive-distrib/1.0/","rights":"arXiv.org perpetual, non-exclusive license"}],"descriptions":[{"descriptionType":"Abstract","description":"Accurate heat-demand maps play a crucial role in decarbonizing space heating, yet most municipalities lack detailed building-level data needed to calculate them. We introduce HeatPrompt, a zero-shot vision-language energy modeling framework that estimates annual heat demand using semantic features extracted from satellite images, basic Geographic Information System (GIS), and building-level features. We feed pretrained Large Vision Language Models (VLMs) with a domain-specific prompt to act as an energy planner and extract the visual attributes such as roof age, building density, etc, from the RGB satellite image that correspond to the thermal load. A Multi-Layer Perceptron (MLP) regressor trained on these captions shows an $R^2$ uplift of 93.7% and shrinks the mean absolute error (MAE) by 30% compared to the baseline model. Qualitative analysis shows that high-impact tokens align with high-demand zones, offering lightweight support for heat planning in data-scarce regions."}],"geoLocations":[],"fundingReferences":[],"url":"https://arxiv.org/abs/2602.20066","contentUrl":null,"metadataVersion":0,"schemaVersion":"http://datacite.org/schema/kernel-4","source":"mds","isActive":true,"state":"findable","reason":null,"viewCount":0,"downloadCount":0,"referenceCount":0,"citationCount":0,"partCount":0,"partOfCount":0,"versionCount":0,"versionOfCount":0,"created":"2026-02-25T15:26:31Z","registered":"2026-02-25T15:26:31Z","published":null,"updated":"2026-02-25T15:26:31Z"},"relationships":{"client":{"data":{"id":"arxiv.content","type":"clients"}}}},{"id":"10.48550/arxiv.2602.20065","type":"dois","attributes":{"doi":"10.48550/arxiv.2602.20065","identifiers":[{"identifier":"2602.20065","identifierType":"arXiv"}],"creators":[{"nameType":"Personal","givenName":"Natalia","familyName":"Moskvina","name":"Moskvina, Natalia","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Raquel","familyName":"Montero","name":"Montero, Raquel","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Masaya","familyName":"Yoshida","name":"Yoshida, Masaya","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Ferdy","familyName":"Hubers","name":"Hubers, Ferdy","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Paolo","familyName":"Morosi","name":"Morosi, Paolo","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Walid","familyName":"Irhaymi","name":"Irhaymi, Walid","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Jin","familyName":"Yan","name":"Yan, Jin","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Tamara","familyName":"Serrano","name":"Serrano, Tamara","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Elena","familyName":"Pagliarini","name":"Pagliarini, Elena","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Fritz","familyName":"Günther","name":"Günther, Fritz","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Evelina","familyName":"Leivada","name":"Leivada, Evelina","affiliation":[],"nameIdentifiers":[]}],"titles":[{"title":"Multilingual Large Language Models do not comprehend all natural languages to equal degrees"}],"publisher":"arXiv","container":{},"publicationYear":2026,"subjects":[{"subject":"Computation and Language (cs.CL)","lang":"en","subjectScheme":"arXiv"},{"subject":"Artificial Intelligence (cs.AI)","lang":"en","subjectScheme":"arXiv"},{"subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"},{"schemeUri":"http://www.oecd.org/science/inno/38235147.pdf","subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"}],"contributors":[],"dates":[{"date":"2026-02-23T17:22:46Z","dateType":"Submitted","dateInformation":"v1"},{"date":"2026-02-24T02:41:08Z","dateType":"Updated","dateInformation":"v1"},{"date":"2026-02","dateType":"Available","dateInformation":"v1"},{"date":"2026","dateType":"Issued"}],"language":null,"types":{"schemaOrg":"CreativeWork","resourceTypeGeneral":"Preprint","citeproc":"article","bibtex":"misc","ris":"GEN","resourceType":"Article"},"relatedIdentifiers":[],"relatedItems":[],"sizes":[],"formats":[],"version":"1","rightsList":[{"rightsIdentifierScheme":"SPDX","rightsUri":"https://creativecommons.org/licenses/by/4.0/legalcode","schemeUri":"https://spdx.org/licenses/","rights":"Creative Commons Attribution 4.0 International","rightsIdentifier":"cc-by-4.0"}],"descriptions":[{"descriptionType":"Abstract","description":"Large Language Models (LLMs) play a critical role in how humans access information. While their core use relies on comprehending written requests, our understanding of this ability is currently limited, because most benchmarks evaluate LLMs in high-resource languages predominantly spoken by Western, Educated, Industrialised, Rich, and Democratic (WEIRD) communities. The default assumption is that English is the best-performing language for LLMs, while smaller, low-resource languages are linked to less reliable outputs, even in multilingual, state-of-the-art models. To track variation in the comprehension abilities of LLMs, we prompt 3 popular models on a language comprehension task across 12 languages, representing the Indo-European, Afro-Asiatic, Turkic, Sino-Tibetan, and Japonic language families. Our results suggest that the models exhibit remarkable linguistic accuracy across typologically diverse languages, yet they fall behind human baselines in all of them, albeit to different degrees. Contrary to what was expected, English is not the best-performing language, as it was systematically outperformed by several Romance languages, even lower-resource ones. We frame the results by discussing the role of several factors that drive LLM performance, such as tokenization, language distance from Spanish and English, size of training data, and data origin in high- vs. low-resource languages and WEIRD vs. non-WEIRD communities."},{"descriptionType":"Other","description":"36 pages, 3 figures, 2 tables, 4 supplementary tables"}],"geoLocations":[],"fundingReferences":[],"url":"https://arxiv.org/abs/2602.20065","contentUrl":null,"metadataVersion":0,"schemaVersion":"http://datacite.org/schema/kernel-4","source":"mds","isActive":true,"state":"findable","reason":null,"viewCount":0,"downloadCount":0,"referenceCount":0,"citationCount":0,"partCount":0,"partOfCount":0,"versionCount":0,"versionOfCount":0,"created":"2026-02-25T15:26:28Z","registered":"2026-02-25T15:26:29Z","published":null,"updated":"2026-02-25T15:26:29Z"},"relationships":{"client":{"data":{"id":"arxiv.content","type":"clients"}}}},{"id":"10.48550/arxiv.2602.20063","type":"dois","attributes":{"doi":"10.48550/arxiv.2602.20063","identifiers":[{"identifier":"2602.20063","identifierType":"arXiv"}],"creators":[{"nameType":"Personal","givenName":"Mohamed","familyName":"Abouagour","name":"Abouagour, Mohamed","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Eleftherios","familyName":"Garyfallidis","name":"Garyfallidis, Eleftherios","affiliation":[],"nameIdentifiers":[]}],"titles":[{"title":"Spherical Hermite Maps"}],"publisher":"arXiv","container":{},"publicationYear":2026,"subjects":[{"subject":"Graphics (cs.GR)","lang":"en","subjectScheme":"arXiv"},{"subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"},{"schemeUri":"http://www.oecd.org/science/inno/38235147.pdf","subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"},{"subject":"I.3.7; I.3.8; I.3.3; I.3.0","lang":"en","subjectScheme":"ACM"}],"contributors":[],"dates":[{"date":"2026-02-23T17:22:19Z","dateType":"Submitted","dateInformation":"v1"},{"date":"2026-02-24T02:41:04Z","dateType":"Updated","dateInformation":"v1"},{"date":"2026-02","dateType":"Available","dateInformation":"v1"},{"date":"2026","dateType":"Issued"}],"language":null,"types":{"schemaOrg":"CreativeWork","resourceTypeGeneral":"Preprint","citeproc":"article","bibtex":"misc","ris":"GEN","resourceType":"Article"},"relatedIdentifiers":[],"relatedItems":[],"sizes":[],"formats":[],"version":"1","rightsList":[{"rightsUri":"http://arxiv.org/licenses/nonexclusive-distrib/1.0/","rights":"arXiv.org perpetual, non-exclusive license"}],"descriptions":[{"descriptionType":"Abstract","description":"Spherical functions appear throughout computer graphics, from spherical harmonic lighting and precomputed radiance transfer to neural radiance fields and procedural planet rendering. Efficient evaluation is critical for real-time applications, yet existing approaches face a quality-performance trade-off: bilinear LUT sampling is fast but produces faceting, while bicubic filtering requires 16 texture samples. Most implementations use finite differences for normals, requiring extra samples and introducing noise. This paper presents Spherical Hermite Maps, a derivative-augmented LUT representation that resolves this trade-off. By storing function values alongside scaled partial derivatives at each texel of a padded cubemap, bicubic-Hermite reconstruction is enabled from only four texture samples (a 2x2 footprint) while providing continuous gradients from the same samples. The key insight is that Hermite interpolation reconstructs smooth derivatives as a byproduct of value reconstruction, making surface normals effectively free. In controlled experiments, Spherical Hermite Maps improve PSNR by 8-41 dB over bilinear interpolation and match 16-tap bicubic quality at one-quarter the cost. Analytic normals reduce mean angular error by 9-13% on complex surfaces while yielding stable specular highlights. Three applications demonstrate versatility: spherical harmonic glyph visualization, radial depth-map impostors for mesh level-of-detail, and procedural planet/asteroid rendering with spherical heightfields."},{"descriptionType":"Other","description":"17 pages, 13 figures"}],"geoLocations":[],"fundingReferences":[],"url":"https://arxiv.org/abs/2602.20063","contentUrl":null,"metadataVersion":0,"schemaVersion":"http://datacite.org/schema/kernel-4","source":"mds","isActive":true,"state":"findable","reason":null,"viewCount":0,"downloadCount":0,"referenceCount":0,"citationCount":0,"partCount":0,"partOfCount":0,"versionCount":0,"versionOfCount":0,"created":"2026-02-25T15:26:23Z","registered":"2026-02-25T15:26:24Z","published":null,"updated":"2026-02-25T15:26:24Z"},"relationships":{"client":{"data":{"id":"arxiv.content","type":"clients"}}}},{"id":"10.48550/arxiv.2602.20059","type":"dois","attributes":{"doi":"10.48550/arxiv.2602.20059","identifiers":[{"identifier":"2602.20059","identifierType":"arXiv"}],"creators":[{"nameType":"Personal","givenName":"Sarath","familyName":"Shekkizhar","name":"Shekkizhar, Sarath","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Adam","familyName":"Earle","name":"Earle, Adam","affiliation":[],"nameIdentifiers":[]}],"titles":[{"title":"Interaction Theater: A case of LLM Agents Interacting at Scale"}],"publisher":"arXiv","container":{},"publicationYear":2026,"subjects":[{"subject":"Artificial Intelligence (cs.AI)","lang":"en","subjectScheme":"arXiv"},{"subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"},{"schemeUri":"http://www.oecd.org/science/inno/38235147.pdf","subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"}],"contributors":[],"dates":[{"date":"2026-02-23T17:14:29Z","dateType":"Submitted","dateInformation":"v1"},{"date":"2026-02-24T02:40:52Z","dateType":"Updated","dateInformation":"v1"},{"date":"2026-02","dateType":"Available","dateInformation":"v1"},{"date":"2026","dateType":"Issued"}],"language":null,"types":{"schemaOrg":"CreativeWork","resourceTypeGeneral":"Preprint","citeproc":"article","bibtex":"misc","ris":"GEN","resourceType":"Article"},"relatedIdentifiers":[],"relatedItems":[],"sizes":[],"formats":[],"version":"1","rightsList":[{"rightsUri":"http://arxiv.org/licenses/nonexclusive-distrib/1.0/","rights":"arXiv.org perpetual, non-exclusive license"}],"descriptions":[{"descriptionType":"Abstract","description":"As multi-agent architectures and agent-to-agent protocols proliferate, a fundamental question arises: what actually happens when autonomous LLM agents interact at scale? We study this question empirically using data from Moltbook, an AI-agent-only social platform, with 800K posts, 3.5M comments, and 78K agent profiles. We combine lexical metrics (Jaccard specificity), embedding-based semantic similarity, and LLM-as-judge validation to characterize agent interaction quality. Our findings reveal agents produce diverse, well-formed text that creates the surface appearance of active discussion, but the substance is largely absent. Specifically, while most agents ($67.5\\%$) vary their output across contexts, $65\\%$ of comments share no distinguishing content vocabulary with the post they appear under, and information gain from additional comments decays rapidly. LLM judge based metrics classify the dominant comment types as spam ($28\\%$) and off-topic content ($22\\%$). Embedding-based semantic analysis confirms that lexically generic comments are also semantically generic. Agents rarely engage in threaded conversation ($5\\%$ of comments), defaulting instead to independent top-level responses. We discuss implications for multi-agent interaction design, arguing that coordination mechanisms must be explicitly designed; without them, even large populations of capable agents produce parallel output rather than productive exchange."}],"geoLocations":[],"fundingReferences":[],"url":"https://arxiv.org/abs/2602.20059","contentUrl":null,"metadataVersion":0,"schemaVersion":"http://datacite.org/schema/kernel-4","source":"mds","isActive":true,"state":"findable","reason":null,"viewCount":0,"downloadCount":0,"referenceCount":0,"citationCount":0,"partCount":0,"partOfCount":0,"versionCount":0,"versionOfCount":0,"created":"2026-02-25T15:26:13Z","registered":"2026-02-25T15:26:14Z","published":null,"updated":"2026-02-25T15:26:14Z"},"relationships":{"client":{"data":{"id":"arxiv.content","type":"clients"}}}},{"id":"10.48550/arxiv.2602.20058","type":"dois","attributes":{"doi":"10.48550/arxiv.2602.20058","identifiers":[{"identifier":"2602.20058","identifierType":"arXiv"}],"creators":[{"nameType":"Personal","givenName":"Tom","familyName":"Braeckevelt","name":"Braeckevelt, Tom","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Sander","familyName":"Vandenhaute","name":"Vandenhaute, Sander","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Sven M. J.","familyName":"Rogge","name":"Rogge, Sven M. J.","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Johan","familyName":"Hofkens","name":"Hofkens, Johan","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Veronique","familyName":"Van Speybroeck","name":"Van Speybroeck, Veronique","affiliation":[],"nameIdentifiers":[]}],"titles":[{"title":"The effect of the A-site cation on the phase transition temperature of metal halide perovskites"}],"publisher":"arXiv","container":{},"publicationYear":2026,"subjects":[{"subject":"Materials Science (cond-mat.mtrl-sci)","lang":"en","subjectScheme":"arXiv"},{"subject":"Computational Physics (physics.comp-ph)","lang":"en","subjectScheme":"arXiv"},{"subject":"FOS: Physical sciences","subjectScheme":"Fields of Science and Technology (FOS)"},{"schemeUri":"http://www.oecd.org/science/inno/38235147.pdf","subject":"FOS: Physical sciences","subjectScheme":"Fields of Science and Technology (FOS)"}],"contributors":[],"dates":[{"date":"2026-02-23T17:13:35Z","dateType":"Submitted","dateInformation":"v1"},{"date":"2026-02-24T02:40:49Z","dateType":"Updated","dateInformation":"v1"},{"date":"2026-02","dateType":"Available","dateInformation":"v1"},{"date":"2026","dateType":"Issued"}],"language":null,"types":{"schemaOrg":"CreativeWork","resourceTypeGeneral":"Preprint","citeproc":"article","bibtex":"misc","ris":"GEN","resourceType":"Article"},"relatedIdentifiers":[],"relatedItems":[],"sizes":[],"formats":[],"version":"1","rightsList":[{"rightsIdentifierScheme":"SPDX","rightsUri":"https://creativecommons.org/licenses/by-sa/4.0/legalcode","schemeUri":"https://spdx.org/licenses/","rights":"Creative Commons Attribution Share Alike 4.0 International","rightsIdentifier":"cc-by-sa-4.0"}],"descriptions":[{"descriptionType":"Abstract","description":"A key challenge for the practical application of metal halide perovskites (MHPs) is the instability of the desired perovskite phase relative to the optically non-active $δ$ phase. To determine the phase stability, we previously developed a procedure to compute the harmonic free energy as a function of temperature, which was suited for CsPbI$_3$ but fails when Cs is replaced by organic cations due to their rotational freedom. Herein we propose a multistep thermodynamic integration (TI) approach that corrects the harmonic free energy to obtain the Gibbs free energy. Given the abundance of local minima in these materials, we employ replica exchange to prevent simulations from getting trapped, while introducing an intermediate potential energy surface to improve convergence and reduce computational cost. Benchmarking energy and forces from different exchange-correlation functionals and dispersion methods against high-level RPA+HF calculations identifies PBE+D3(BJ) as the best trade-off between accuracy, computational efficiency, and precision. To perform molecular dynamics simulations within the TI framework, it was necessary to train a machine learning potential using the MACE architecture on ab initio data calculated with density functional theory. Our results show that, for all three materials, the free energy difference between the $γ$ and $δ$ phases exhibits a very similar temperature dependence. This suggests that phase stability is primarily governed by differences in ground-state energy, rather than by material-specific thermal effects. Beyond these three materials, our methodology provides a robust framework for investigating the phase behavior of other MHPs, paving the way for the discovery of more stable perovskites."}],"geoLocations":[],"fundingReferences":[],"url":"https://arxiv.org/abs/2602.20058","contentUrl":null,"metadataVersion":0,"schemaVersion":"http://datacite.org/schema/kernel-4","source":"mds","isActive":true,"state":"findable","reason":null,"viewCount":0,"downloadCount":0,"referenceCount":0,"citationCount":0,"partCount":0,"partOfCount":0,"versionCount":0,"versionOfCount":0,"created":"2026-02-25T15:26:11Z","registered":"2026-02-25T15:26:11Z","published":null,"updated":"2026-02-25T15:26:11Z"},"relationships":{"client":{"data":{"id":"arxiv.content","type":"clients"}}}},{"id":"10.48550/arxiv.2602.20057","type":"dois","attributes":{"doi":"10.48550/arxiv.2602.20057","identifiers":[{"identifier":"2602.20057","identifierType":"arXiv"}],"creators":[{"nameType":"Personal","givenName":"Ge","familyName":"Yuan","name":"Yuan, Ge","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Qiyuan","familyName":"Qiao","name":"Qiao, Qiyuan","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Jing","familyName":"Zhang","name":"Zhang, Jing","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Dong","familyName":"Xu","name":"Xu, Dong","affiliation":[],"nameIdentifiers":[]}],"titles":[{"title":"AdaWorldPolicy: World-Model-Driven Diffusion Policy with Online Adaptive Learning for Robotic Manipulation"}],"publisher":"arXiv","container":{},"publicationYear":2026,"subjects":[{"subject":"Robotics (cs.RO)","lang":"en","subjectScheme":"arXiv"},{"subject":"Artificial Intelligence (cs.AI)","lang":"en","subjectScheme":"arXiv"},{"subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"},{"schemeUri":"http://www.oecd.org/science/inno/38235147.pdf","subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"}],"contributors":[],"dates":[{"date":"2026-02-23T17:12:25Z","dateType":"Submitted","dateInformation":"v1"},{"date":"2026-02-24T02:40:44Z","dateType":"Updated","dateInformation":"v1"},{"date":"2026-02","dateType":"Available","dateInformation":"v1"},{"date":"2026","dateType":"Issued"}],"language":null,"types":{"schemaOrg":"CreativeWork","resourceTypeGeneral":"Preprint","citeproc":"article","bibtex":"misc","ris":"GEN","resourceType":"Article"},"relatedIdentifiers":[],"relatedItems":[],"sizes":[],"formats":[],"version":"1","rightsList":[{"rightsUri":"http://arxiv.org/licenses/nonexclusive-distrib/1.0/","rights":"arXiv.org perpetual, non-exclusive license"}],"descriptions":[{"descriptionType":"Abstract","description":"Effective robotic manipulation requires policies that can anticipate physical outcomes and adapt to real-world environments. Effective robotic manipulation requires policies that can anticipate physical outcomes and adapt to real-world environments. In this work, we introduce a unified framework, World-Model-Driven Diffusion Policy with Online Adaptive Learning (AdaWorldPolicy) to enhance robotic manipulation under dynamic conditions with minimal human involvement. Our core insight is that world models provide strong supervision signals, enabling online adaptive learning in dynamic environments, which can be complemented by force-torque feedback to mitigate dynamic force shifts. Our AdaWorldPolicy integrates a world model, an action expert, and a force predictor-all implemented as interconnected Flow Matching Diffusion Transformers (DiT). They are interconnected via the multi-modal self-attention layers, enabling deep feature exchange for joint learning while preserving their distinct modularity characteristics. We further propose a novel Online Adaptive Learning (AdaOL) strategy that dynamically switches between an Action Generation mode and a Future Imagination mode to drive reactive updates across all three modules. This creates a powerful closed-loop mechanism that adapts to both visual and physical domain shifts with minimal overhead. Across a suite of simulated and real-robot benchmarks, our AdaWorldPolicy achieves state-of-the-art performance, with dynamical adaptive capacity to out-of-distribution scenarios."},{"descriptionType":"Other","description":"Homepage: https://AdaWorldPolicy.github.io"}],"geoLocations":[],"fundingReferences":[],"url":"https://arxiv.org/abs/2602.20057","contentUrl":null,"metadataVersion":0,"schemaVersion":"http://datacite.org/schema/kernel-4","source":"mds","isActive":true,"state":"findable","reason":null,"viewCount":0,"downloadCount":0,"referenceCount":0,"citationCount":0,"partCount":0,"partOfCount":0,"versionCount":0,"versionOfCount":0,"created":"2026-02-25T15:26:08Z","registered":"2026-02-25T15:26:09Z","published":null,"updated":"2026-02-25T15:26:09Z"},"relationships":{"client":{"data":{"id":"arxiv.content","type":"clients"}}}},{"id":"10.48550/arxiv.2602.20056","type":"dois","attributes":{"doi":"10.48550/arxiv.2602.20056","identifiers":[{"identifier":"2602.20056","identifierType":"arXiv"}],"creators":[{"nameType":"Personal","givenName":"Connor","familyName":"O'Reilly","name":"O'Reilly, Connor","affiliation":[],"nameIdentifiers":[]}],"titles":[{"title":"Quantitative results on the $k$-dimensional Duffin-Schaeffer conjecture"}],"publisher":"arXiv","container":{},"publicationYear":2026,"subjects":[{"subject":"Number Theory (math.NT)","lang":"en","subjectScheme":"arXiv"},{"subject":"FOS: Mathematics","subjectScheme":"Fields of Science and Technology (FOS)"},{"schemeUri":"http://www.oecd.org/science/inno/38235147.pdf","subject":"FOS: Mathematics","subjectScheme":"Fields of Science and Technology (FOS)"},{"subject":"11J83, 11J13, 11K60","lang":"en","subjectScheme":"MSC"}],"contributors":[],"dates":[{"date":"2026-02-23T17:11:14Z","dateType":"Submitted","dateInformation":"v1"},{"date":"2026-02-24T02:40:40Z","dateType":"Updated","dateInformation":"v1"},{"date":"2026-02","dateType":"Available","dateInformation":"v1"},{"date":"2026","dateType":"Issued"}],"language":null,"types":{"schemaOrg":"CreativeWork","resourceTypeGeneral":"Preprint","citeproc":"article","bibtex":"misc","ris":"GEN","resourceType":"Article"},"relatedIdentifiers":[],"relatedItems":[],"sizes":[],"formats":[],"version":"1","rightsList":[{"rightsUri":"http://arxiv.org/licenses/nonexclusive-distrib/1.0/","rights":"arXiv.org perpetual, non-exclusive license"}],"descriptions":[{"descriptionType":"Abstract","description":"For all $k\\geq 2$, we provide almost-sharp quantitative results for the $k$-dimensional Duffin-Schaeffer conjecture, analogous to recent developments in the 1-D case of Koukoulopoulos-Maynard-Yang. In particular, for $ψ:\\mathbb{N}\\to[0,1/2]$ such that $\\sum_{q\\in \\mathbb{N}}(ψ(q)φ(q)/q)^k$ diverges, $Q\\geq 1$ and $α\\in\\mathbb{R}$, we denote by $S_k(α, Q)$ the number of pairs $(a,q)\\in\\mathbb{Z}^k\\times \\mathbb{N}$ with $q\\leq Q$, $\\gcd(a_i,q)=1$ for each $i\\in\\{1,\\dots,k\\}$, satisfying $\\|qα-a\\|_{\\infty}\u0026lt;ψ(q)$. Defining $Ψ_k(Q)=\\sum_{q\\leq Q}(2ψ(q)φ(q)/q)^k$, we show that for all $\\varepsilon\u0026gt;0$ and almost all $α$ one has $S_k(α,Q)=Ψ_k(Q)+O_{\\varepsilon,k}(Ψ(Q)^{1/2+\\varepsilon})$."},{"descriptionType":"Other","description":"10 pages"}],"geoLocations":[],"fundingReferences":[],"url":"https://arxiv.org/abs/2602.20056","contentUrl":null,"metadataVersion":0,"schemaVersion":"http://datacite.org/schema/kernel-4","source":"mds","isActive":true,"state":"findable","reason":null,"viewCount":0,"downloadCount":0,"referenceCount":0,"citationCount":0,"partCount":0,"partOfCount":0,"versionCount":0,"versionOfCount":0,"created":"2026-02-25T15:26:05Z","registered":"2026-02-25T15:26:06Z","published":null,"updated":"2026-02-25T15:26:06Z"},"relationships":{"client":{"data":{"id":"arxiv.content","type":"clients"}}}},{"id":"10.48550/arxiv.2602.20053","type":"dois","attributes":{"doi":"10.48550/arxiv.2602.20053","identifiers":[{"identifier":"2602.20053","identifierType":"arXiv"}],"creators":[{"nameType":"Personal","givenName":"Jiahui","familyName":"Chen","name":"Chen, Jiahui","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Zehang","familyName":"Deng","name":"Deng, Zehang","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Zeyu","familyName":"Zhang","name":"Zhang, Zeyu","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Chaoyang","familyName":"Li","name":"Li, Chaoyang","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Lianchen","familyName":"Jia","name":"Jia, Lianchen","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Lifeng","familyName":"Sun","name":"Sun, Lifeng","affiliation":[],"nameIdentifiers":[]}],"titles":[{"title":"Decoupling Defense Strategies for Robust Image Watermarking"}],"publisher":"arXiv","container":{},"publicationYear":2026,"subjects":[{"subject":"Computer Vision and Pattern Recognition (cs.CV)","lang":"en","subjectScheme":"arXiv"},{"subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"},{"schemeUri":"http://www.oecd.org/science/inno/38235147.pdf","subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"}],"contributors":[],"dates":[{"date":"2026-02-23T17:02:55Z","dateType":"Submitted","dateInformation":"v1"},{"date":"2026-02-24T02:40:00Z","dateType":"Updated","dateInformation":"v1"},{"date":"2026-02","dateType":"Available","dateInformation":"v1"},{"date":"2026","dateType":"Issued"}],"language":null,"types":{"schemaOrg":"CreativeWork","resourceTypeGeneral":"Preprint","citeproc":"article","bibtex":"misc","ris":"GEN","resourceType":"Article"},"relatedIdentifiers":[],"relatedItems":[],"sizes":[],"formats":[],"version":"1","rightsList":[{"rightsIdentifierScheme":"SPDX","rightsUri":"https://creativecommons.org/licenses/by/4.0/legalcode","schemeUri":"https://spdx.org/licenses/","rights":"Creative Commons Attribution 4.0 International","rightsIdentifier":"cc-by-4.0"}],"descriptions":[{"descriptionType":"Abstract","description":"Deep learning-based image watermarking, while robust against conventional distortions, remains vulnerable to advanced adversarial and regeneration attacks. Conventional countermeasures, which jointly optimize the encoder and decoder via a noise layer, face 2 inevitable challenges: (1) decrease of clean accuracy due to decoder adversarial training and (2) limited robustness due to simultaneous training of all three advanced attacks. To overcome these issues, we propose AdvMark, a novel two-stage fine-tuning framework that decouples the defense strategies. In stage 1, we address adversarial vulnerability via a tailored adversarial training paradigm that primarily fine-tunes the encoder while only conditionally updating the decoder. This approach learns to move the image into a non-attackable region, rather than modifying the decision boundary, thus preserving clean accuracy. In stage 2, we tackle distortion and regeneration attacks via direct image optimization. To preserve the adversarial robustness gained in stage 1, we formulate a principled, constrained image loss with theoretical guarantees, which balances the deviation from cover and previous encoded images. We also propose a quality-aware early-stop to further guarantee the lower bound of visual quality. Extensive experiments demonstrate AdvMark outperforms with the highest image quality and comprehensive robustness, i.e. up to 29\\%, 33\\% and 46\\% accuracy improvement for distortion, regeneration and adversarial attacks, respectively."},{"descriptionType":"Other","description":"CVPR 2026"}],"geoLocations":[],"fundingReferences":[],"url":"https://arxiv.org/abs/2602.20053","contentUrl":null,"metadataVersion":0,"schemaVersion":"http://datacite.org/schema/kernel-4","source":"mds","isActive":true,"state":"findable","reason":null,"viewCount":0,"downloadCount":0,"referenceCount":0,"citationCount":0,"partCount":0,"partOfCount":0,"versionCount":0,"versionOfCount":0,"created":"2026-02-25T15:25:57Z","registered":"2026-02-25T15:25:58Z","published":null,"updated":"2026-02-25T15:25:58Z"},"relationships":{"client":{"data":{"id":"arxiv.content","type":"clients"}}}},{"id":"10.48550/arxiv.2602.20052","type":"dois","attributes":{"doi":"10.48550/arxiv.2602.20052","identifiers":[{"identifier":"2602.20052","identifierType":"arXiv"}],"creators":[{"nameType":"Personal","givenName":"Marco","familyName":"Scharringhausen","name":"Scharringhausen, Marco","affiliation":[],"nameIdentifiers":[]}],"titles":[{"title":"Entropy in Large Language Models"}],"publisher":"arXiv","container":{},"publicationYear":2026,"subjects":[{"subject":"Computation and Language (cs.CL)","lang":"en","subjectScheme":"arXiv"},{"subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"},{"schemeUri":"http://www.oecd.org/science/inno/38235147.pdf","subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"}],"contributors":[],"dates":[{"date":"2026-02-23T17:02:45Z","dateType":"Submitted","dateInformation":"v1"},{"date":"2026-02-24T02:39:59Z","dateType":"Updated","dateInformation":"v1"},{"date":"2026-02","dateType":"Available","dateInformation":"v1"},{"date":"2026","dateType":"Issued"}],"language":null,"types":{"schemaOrg":"CreativeWork","resourceTypeGeneral":"Preprint","citeproc":"article","bibtex":"misc","ris":"GEN","resourceType":"Article"},"relatedIdentifiers":[],"relatedItems":[],"sizes":[],"formats":[],"version":"1","rightsList":[{"rightsIdentifierScheme":"SPDX","rightsUri":"https://creativecommons.org/licenses/by-sa/4.0/legalcode","schemeUri":"https://spdx.org/licenses/","rights":"Creative Commons Attribution Share Alike 4.0 International","rightsIdentifier":"cc-by-sa-4.0"}],"descriptions":[{"descriptionType":"Abstract","description":"In this study, the output of large language models (LLM) is considered an information source generating an unlimited sequence of symbols drawn from a finite alphabet. Given the probabilistic nature of modern LLMs, we assume a probabilistic model for these LLMs, following a constant random distribution and the source itself thus being stationary. We compare this source entropy (per word) to that of natural language (written or spoken) as represented by the Open American National Corpus (OANC). Our results indicate that the word entropy of such LLMs is lower than the word entropy of natural speech both in written or spoken form. The long-term goal of such studies is to formalize the intuitions of information and uncertainty in large language training to assess the impact of training an LLM from LLM generated training data. This refers to texts from the world wide web in particular."},{"descriptionType":"Other","description":"7 pages, 2 figures, 3 tables"}],"geoLocations":[],"fundingReferences":[],"url":"https://arxiv.org/abs/2602.20052","contentUrl":null,"metadataVersion":0,"schemaVersion":"http://datacite.org/schema/kernel-4","source":"mds","isActive":true,"state":"findable","reason":null,"viewCount":0,"downloadCount":0,"referenceCount":0,"citationCount":0,"partCount":0,"partOfCount":0,"versionCount":0,"versionOfCount":0,"created":"2026-02-25T15:25:55Z","registered":"2026-02-25T15:25:56Z","published":null,"updated":"2026-02-25T15:25:56Z"},"relationships":{"client":{"data":{"id":"arxiv.content","type":"clients"}}}},{"id":"10.48550/arxiv.2602.20051","type":"dois","attributes":{"doi":"10.48550/arxiv.2602.20051","identifiers":[{"identifier":"2602.20051","identifierType":"arXiv"}],"creators":[{"nameType":"Personal","givenName":"Yeonsung","familyName":"Kim","name":"Kim, Yeonsung","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Junggeun","familyName":"Do","name":"Do, Junggeun","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Seunguk","familyName":"Do","name":"Do, Seunguk","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Sangmin","familyName":"Kim","name":"Kim, Sangmin","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Jaesik","familyName":"Park","name":"Park, Jaesik","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Jay-Yoon","familyName":"Lee","name":"Lee, Jay-Yoon","affiliation":[],"nameIdentifiers":[]}],"titles":[{"title":"SEAL-pose: Enhancing 3D Human Pose Estimation via a Learned Loss for Structural Consistency"}],"publisher":"arXiv","container":{},"publicationYear":2026,"subjects":[{"subject":"Computer Vision and Pattern Recognition (cs.CV)","lang":"en","subjectScheme":"arXiv"},{"subject":"Artificial Intelligence (cs.AI)","lang":"en","subjectScheme":"arXiv"},{"subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"},{"schemeUri":"http://www.oecd.org/science/inno/38235147.pdf","subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"}],"contributors":[],"dates":[{"date":"2026-02-23T17:00:35Z","dateType":"Submitted","dateInformation":"v1"},{"date":"2026-02-24T02:39:52Z","dateType":"Updated","dateInformation":"v1"},{"date":"2026-02","dateType":"Available","dateInformation":"v1"},{"date":"2026","dateType":"Issued"}],"language":null,"types":{"schemaOrg":"CreativeWork","resourceTypeGeneral":"Preprint","citeproc":"article","bibtex":"misc","ris":"GEN","resourceType":"Article"},"relatedIdentifiers":[],"relatedItems":[],"sizes":[],"formats":[],"version":"1","rightsList":[{"rightsUri":"http://arxiv.org/licenses/nonexclusive-distrib/1.0/","rights":"arXiv.org perpetual, non-exclusive license"}],"descriptions":[{"descriptionType":"Abstract","description":"3D human pose estimation (HPE) is characterized by intricate local and global dependencies among joints. Conventional supervised losses are limited in capturing these correlations because they treat each joint independently. Previous studies have attempted to promote structural consistency through manually designed priors or rule-based constraints; however, these approaches typically require manual specification and are often non-differentiable, limiting their use as end-to-end training objectives. We propose SEAL-pose, a data-driven framework in which a learnable loss-net trains a pose-net by evaluating structural plausibility. Rather than relying on hand-crafted priors, our joint-graph-based design enables the loss-net to learn complex structural dependencies directly from data. Extensive experiments on three 3D HPE benchmarks with eight backbones show that SEAL-pose reduces per-joint errors and improves pose plausibility compared with the corresponding backbones across all settings. Beyond improving each backbone, SEAL-pose also outperforms models with explicit structural constraints, despite not enforcing any such constraints. Finally, we analyze the relationship between the loss-net and structural consistency, and evaluate SEAL-pose in cross-dataset and in-the-wild settings."},{"descriptionType":"Other","description":"17 pages"}],"geoLocations":[],"fundingReferences":[],"url":"https://arxiv.org/abs/2602.20051","contentUrl":null,"metadataVersion":0,"schemaVersion":"http://datacite.org/schema/kernel-4","source":"mds","isActive":true,"state":"findable","reason":null,"viewCount":0,"downloadCount":0,"referenceCount":0,"citationCount":0,"partCount":0,"partOfCount":0,"versionCount":0,"versionOfCount":0,"created":"2026-02-25T15:25:53Z","registered":"2026-02-25T15:25:53Z","published":null,"updated":"2026-02-25T15:25:53Z"},"relationships":{"client":{"data":{"id":"arxiv.content","type":"clients"}}}},{"id":"10.48550/arxiv.2602.20049","type":"dois","attributes":{"doi":"10.48550/arxiv.2602.20049","identifiers":[{"identifier":"2602.20049","identifierType":"arXiv"}],"creators":[{"nameType":"Personal","givenName":"Tobias","familyName":"Gürtler","name":"Gürtler, Tobias","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Benjamin Lucien","familyName":"Kaminski","name":"Kaminski, Benjamin Lucien","affiliation":[],"nameIdentifiers":[]}],"titles":[{"title":"noDice: Inference for Discrete Probabilistic Programs with Nondeterminism and Conditioning"}],"publisher":"arXiv","container":{},"publicationYear":2026,"subjects":[{"subject":"Logic in Computer Science (cs.LO)","lang":"en","subjectScheme":"arXiv"},{"subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"},{"schemeUri":"http://www.oecd.org/science/inno/38235147.pdf","subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"}],"contributors":[],"dates":[{"date":"2026-02-23T16:59:37Z","dateType":"Submitted","dateInformation":"v1"},{"date":"2026-02-24T02:39:49Z","dateType":"Updated","dateInformation":"v1"},{"date":"2026-02","dateType":"Available","dateInformation":"v1"},{"date":"2026","dateType":"Issued"}],"language":null,"types":{"schemaOrg":"CreativeWork","resourceTypeGeneral":"Preprint","citeproc":"article","bibtex":"misc","ris":"GEN","resourceType":"Article"},"relatedIdentifiers":[],"relatedItems":[],"sizes":[],"formats":[],"version":"1","rightsList":[{"rightsIdentifierScheme":"SPDX","rightsUri":"https://creativecommons.org/licenses/by/4.0/legalcode","schemeUri":"https://spdx.org/licenses/","rights":"Creative Commons Attribution 4.0 International","rightsIdentifier":"cc-by-4.0"}],"descriptions":[{"descriptionType":"Abstract","description":"Probabilistic programming languages (PPLs) are an expressive and intuitive means of representing complex probability distributions. In that realm, languages like Dice target an important class of probabilistic programs: those whose probability distributions are discrete. Discrete distributions are common in many fields, including text analysis, network verification, artificial intelligence, and graph analysis. Another important feature in the world of probabilistic modeling are nondeterministic choices as found in Markov Decision Processes (MDPs) which play a major role in reinforcement learning. Modern PPLs usually lack support for nondeterminism. We address this gap with the introduction of noDice, which extends the discrete probabilistic inference engine Dice. noDice performs inference on loop-free programs by constructing an MDP so that the distributions modeled by the program correspond to schedulers in the MDP. Furthermore, decision diagrams are used as an intermediate step to exploit the program structure and drastically reduce the state space of the MDP."},{"descriptionType":"Other","description":"46 pages, 7 figures, accepted to OOPSLA 2026 R1"}],"geoLocations":[],"fundingReferences":[],"url":"https://arxiv.org/abs/2602.20049","contentUrl":null,"metadataVersion":0,"schemaVersion":"http://datacite.org/schema/kernel-4","source":"mds","isActive":true,"state":"findable","reason":null,"viewCount":0,"downloadCount":0,"referenceCount":0,"citationCount":0,"partCount":0,"partOfCount":0,"versionCount":0,"versionOfCount":0,"created":"2026-02-25T15:25:47Z","registered":"2026-02-25T15:25:49Z","published":null,"updated":"2026-02-25T15:25:49Z"},"relationships":{"client":{"data":{"id":"arxiv.content","type":"clients"}}}},{"id":"10.48550/arxiv.2602.20048","type":"dois","attributes":{"doi":"10.48550/arxiv.2602.20048","identifiers":[{"identifier":"2602.20048","identifierType":"arXiv"}],"creators":[{"nameType":"Personal","givenName":"Tarakanath","familyName":"Paipuru","name":"Paipuru, Tarakanath","affiliation":[],"nameIdentifiers":[]}],"titles":[{"title":"CodeCompass: Navigating the Navigation Paradox in Agentic Code Intelligence"}],"publisher":"arXiv","container":{},"publicationYear":2026,"subjects":[{"subject":"Artificial Intelligence (cs.AI)","lang":"en","subjectScheme":"arXiv"},{"subject":"Software Engineering (cs.SE)","lang":"en","subjectScheme":"arXiv"},{"subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"},{"schemeUri":"http://www.oecd.org/science/inno/38235147.pdf","subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"},{"subject":"D.2.3; I.2.2","lang":"en","subjectScheme":"ACM"}],"contributors":[],"dates":[{"date":"2026-02-23T16:58:37Z","dateType":"Submitted","dateInformation":"v1"},{"date":"2026-02-24T02:39:43Z","dateType":"Updated","dateInformation":"v1"},{"date":"2026-02","dateType":"Available","dateInformation":"v1"},{"date":"2026","dateType":"Issued"}],"language":null,"types":{"schemaOrg":"CreativeWork","resourceTypeGeneral":"Preprint","citeproc":"article","bibtex":"misc","ris":"GEN","resourceType":"Article"},"relatedIdentifiers":[],"relatedItems":[],"sizes":[],"formats":[],"version":"1","rightsList":[{"rightsIdentifierScheme":"SPDX","rightsUri":"https://creativecommons.org/licenses/by/4.0/legalcode","schemeUri":"https://spdx.org/licenses/","rights":"Creative Commons Attribution 4.0 International","rightsIdentifier":"cc-by-4.0"}],"descriptions":[{"descriptionType":"Abstract","description":"Modern code intelligence agents operate in contexts exceeding 1 million tokens--far beyond the scale where humans manually locate relevant files. Yet agents consistently fail to discover architecturally critical files when solving real-world coding tasks. We identify the Navigation Paradox: agents perform poorly not due to context limits, but because navigation and retrieval are fundamentally distinct problems. Through 258 automated trials across 30 benchmark tasks on a production FastAPI repository, we demonstrate that graph-based structural navigation via CodeCompass--a Model Context Protocol server exposing dependency graphs--achieves 99.4% task completion on hidden-dependency tasks, a 23.2 percentage-point improvement over vanilla agents (76.2%) and 21.2 points over BM25 retrieval (78.2%).However, we uncover a critical adoption gap: 58% of trials with graph access made zero tool calls, and agents required explicit prompt engineering to adopt the tool consistently. Our findings reveal that the bottleneck is not tool availability but behavioral alignment--agents must be explicitly guided to leverage structural context over lexical heuristics. We contribute: (1) a task taxonomy distinguishing semantic-search, structural, and hidden-dependency scenarios; (2) empirical evidence that graph navigation outperforms retrieval when dependencies lack lexical overlap; and (3) open-source infrastructure for reproducible evaluation of navigation tools."},{"descriptionType":"Other","description":"23 pages, 7 figures. Research study with 258 trials on SWE-bench-lite tasks. Code and data: https://github.com/tpaip607/research-codecompass"}],"geoLocations":[],"fundingReferences":[],"url":"https://arxiv.org/abs/2602.20048","contentUrl":null,"metadataVersion":0,"schemaVersion":"http://datacite.org/schema/kernel-4","source":"mds","isActive":true,"state":"findable","reason":null,"viewCount":0,"downloadCount":0,"referenceCount":0,"citationCount":0,"partCount":0,"partOfCount":0,"versionCount":0,"versionOfCount":0,"created":"2026-02-25T15:25:44Z","registered":"2026-02-25T15:25:45Z","published":null,"updated":"2026-02-25T15:25:45Z"},"relationships":{"client":{"data":{"id":"arxiv.content","type":"clients"}}}},{"id":"10.48550/arxiv.2602.20046","type":"dois","attributes":{"doi":"10.48550/arxiv.2602.20046","identifiers":[{"identifier":"2602.20046","identifierType":"arXiv"}],"creators":[{"nameType":"Personal","givenName":"Eleonora","familyName":"Grassucci","name":"Grassucci, Eleonora","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Giordano","familyName":"Cicchetti","name":"Cicchetti, Giordano","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Danilo","familyName":"Comminiello","name":"Comminiello, Danilo","affiliation":[],"nameIdentifiers":[]}],"titles":[{"title":"Closing the gap in multimodal medical representation alignment"}],"publisher":"arXiv","container":{},"publicationYear":2026,"subjects":[{"subject":"Computer Vision and Pattern Recognition (cs.CV)","lang":"en","subjectScheme":"arXiv"},{"subject":"Machine Learning (cs.LG)","lang":"en","subjectScheme":"arXiv"},{"subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"},{"schemeUri":"http://www.oecd.org/science/inno/38235147.pdf","subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"}],"contributors":[],"dates":[{"date":"2026-02-23T16:57:39Z","dateType":"Submitted","dateInformation":"v1"},{"date":"2026-02-24T02:39:41Z","dateType":"Updated","dateInformation":"v1"},{"date":"2026-02","dateType":"Available","dateInformation":"v1"},{"date":"2026","dateType":"Issued"}],"language":null,"types":{"schemaOrg":"CreativeWork","resourceTypeGeneral":"Preprint","citeproc":"article","bibtex":"misc","ris":"GEN","resourceType":"Article"},"relatedIdentifiers":[],"relatedItems":[],"sizes":[],"formats":[],"version":"1","rightsList":[{"rightsIdentifierScheme":"SPDX","rightsUri":"https://creativecommons.org/licenses/by/4.0/legalcode","schemeUri":"https://spdx.org/licenses/","rights":"Creative Commons Attribution 4.0 International","rightsIdentifier":"cc-by-4.0"}],"descriptions":[{"descriptionType":"Abstract","description":"In multimodal learning, CLIP has emerged as the de-facto approach for mapping different modalities into a shared latent space by bringing semantically similar representations closer while pushing apart dissimilar ones. However, CLIP-based contrastive losses exhibit unintended behaviors that negatively impact true semantic alignment, leading to sparse and fragmented latent spaces. This phenomenon, known as the modality gap, has been partially mitigated for standard text and image pairs but remains unknown and unresolved in more complex multimodal settings, such as the medical domain. In this work, we study this phenomenon in the latter case, revealing that the modality gap is present also in medical alignment, and we propose a modality-agnostic framework that closes this gap, ensuring that semantically related representations are more aligned, regardless of their source modality. Our method enhances alignment between radiology images and clinical text, improving cross-modal retrieval and image captioning."},{"descriptionType":"Other","description":"Accepted at MLSP2025"}],"geoLocations":[],"fundingReferences":[],"url":"https://arxiv.org/abs/2602.20046","contentUrl":null,"metadataVersion":0,"schemaVersion":"http://datacite.org/schema/kernel-4","source":"mds","isActive":true,"state":"findable","reason":null,"viewCount":0,"downloadCount":0,"referenceCount":0,"citationCount":0,"partCount":0,"partOfCount":0,"versionCount":0,"versionOfCount":0,"created":"2026-02-25T15:25:39Z","registered":"2026-02-25T15:25:40Z","published":null,"updated":"2026-02-25T15:25:40Z"},"relationships":{"client":{"data":{"id":"arxiv.content","type":"clients"}}}},{"id":"10.48550/arxiv.2602.20041","type":"dois","attributes":{"doi":"10.48550/arxiv.2602.20041","identifiers":[{"identifier":"2602.20041","identifierType":"arXiv"}],"creators":[{"nameType":"Personal","givenName":"Ghadah","familyName":"Alosaimi","name":"Alosaimi, Ghadah","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Maha","familyName":"Alsayyari","name":"Alsayyari, Maha","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Yixin","familyName":"Sun","name":"Sun, Yixin","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Stamos","familyName":"Katsigiannis","name":"Katsigiannis, Stamos","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Amir","familyName":"Atapour-Abarghouei","name":"Atapour-Abarghouei, Amir","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Toby P.","familyName":"Breckon","name":"Breckon, Toby P.","affiliation":[],"nameIdentifiers":[]}],"titles":[{"title":"EEG-Driven Intention Decoding: Offline Deep Learning Benchmarking on a Robotic Rover"}],"publisher":"arXiv","container":{},"publicationYear":2026,"subjects":[{"subject":"Robotics (cs.RO)","lang":"en","subjectScheme":"arXiv"},{"subject":"Computer Vision and Pattern Recognition (cs.CV)","lang":"en","subjectScheme":"arXiv"},{"subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"},{"schemeUri":"http://www.oecd.org/science/inno/38235147.pdf","subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"}],"contributors":[],"dates":[{"date":"2026-02-23T16:50:21Z","dateType":"Submitted","dateInformation":"v1"},{"date":"2026-02-24T02:39:22Z","dateType":"Updated","dateInformation":"v1"},{"date":"2026-02","dateType":"Available","dateInformation":"v1"},{"date":"2026","dateType":"Issued"}],"language":null,"types":{"schemaOrg":"CreativeWork","resourceTypeGeneral":"Preprint","citeproc":"article","bibtex":"misc","ris":"GEN","resourceType":"Article"},"relatedIdentifiers":[],"relatedItems":[],"sizes":[],"formats":[],"version":"1","rightsList":[{"rightsUri":"http://arxiv.org/licenses/nonexclusive-distrib/1.0/","rights":"arXiv.org perpetual, non-exclusive license"}],"descriptions":[{"descriptionType":"Abstract","description":"Brain-computer interfaces (BCIs) provide a hands-free control modality for mobile robotics, yet decoding user intent during real-world navigation remains challenging. This work presents a brain-robot control framework for offline decoding of driving commands during robotic rover operation. A 4WD Rover Pro platform was remotely operated by 12 participants who navigated a predefined route using a joystick, executing the commands forward, reverse, left, right, and stop. Electroencephalogram (EEG) signals were recorded with a 16-channel OpenBCI cap and aligned with motor actions at Delta = 0 ms and future prediction horizons (Delta \u0026gt; 0 ms). After preprocessing, several deep learning models were benchmarked, including convolutional neural networks, recurrent neural networks, and Transformer architectures. ShallowConvNet achieved the highest performance for both action prediction and intent prediction. By combining real-world robotic control with multi-horizon EEG intention decoding, this study introduces a reproducible benchmark and reveals key design insights for predictive deep learning-based BCI systems."}],"geoLocations":[],"fundingReferences":[],"url":"https://arxiv.org/abs/2602.20041","contentUrl":null,"metadataVersion":0,"schemaVersion":"http://datacite.org/schema/kernel-4","source":"mds","isActive":true,"state":"findable","reason":null,"viewCount":0,"downloadCount":0,"referenceCount":0,"citationCount":0,"partCount":0,"partOfCount":0,"versionCount":0,"versionOfCount":0,"created":"2026-02-25T15:25:27Z","registered":"2026-02-25T15:25:28Z","published":null,"updated":"2026-02-25T15:25:28Z"},"relationships":{"client":{"data":{"id":"arxiv.content","type":"clients"}}}},{"id":"10.48550/arxiv.2602.20040","type":"dois","attributes":{"doi":"10.48550/arxiv.2602.20040","identifiers":[{"identifier":"2602.20040","identifierType":"arXiv"}],"creators":[{"nameType":"Personal","givenName":"Fahmida Liza","familyName":"Piya","name":"Piya, Fahmida Liza","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Rahmatollah","familyName":"Beheshti","name":"Beheshti, Rahmatollah","affiliation":[],"nameIdentifiers":[]}],"titles":[{"title":"AgenticSum: An Agentic Inference-Time Framework for Faithful Clinical Text Summarization"}],"publisher":"arXiv","container":{},"publicationYear":2026,"subjects":[{"subject":"Computation and Language (cs.CL)","lang":"en","subjectScheme":"arXiv"},{"subject":"Artificial Intelligence (cs.AI)","lang":"en","subjectScheme":"arXiv"},{"subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"},{"schemeUri":"http://www.oecd.org/science/inno/38235147.pdf","subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"}],"contributors":[],"dates":[{"date":"2026-02-23T16:49:37Z","dateType":"Submitted","dateInformation":"v1"},{"date":"2026-02-24T02:39:21Z","dateType":"Updated","dateInformation":"v1"},{"date":"2026-02","dateType":"Available","dateInformation":"v1"},{"date":"2026","dateType":"Issued"}],"language":null,"types":{"schemaOrg":"CreativeWork","resourceTypeGeneral":"Preprint","citeproc":"article","bibtex":"misc","ris":"GEN","resourceType":"Article"},"relatedIdentifiers":[],"relatedItems":[],"sizes":[],"formats":[],"version":"1","rightsList":[{"rightsUri":"http://arxiv.org/licenses/nonexclusive-distrib/1.0/","rights":"arXiv.org perpetual, non-exclusive license"}],"descriptions":[{"descriptionType":"Abstract","description":"Large language models (LLMs) offer substantial promise for automating clinical text summarization, yet maintaining factual consistency remains challenging due to the length, noise, and heterogeneity of clinical documentation. We present AgenticSum, an inference-time, agentic framework that separates context selection, generation, verification, and targeted correction to reduce hallucinated content. The framework decomposes summarization into coordinated stages that compress task-relevant context, generate an initial draft, identify weakly supported spans using internal attention grounding signals, and selectively revise flagged content under supervisory control. We evaluate AgenticSum on two public datasets, using reference-based metrics, LLM-as-a-judge assessment, and human evaluation. Across various measures, AgenticSum demonstrates consistent improvements compared to vanilla LLMs and other strong baselines. Our results indicate that structured, agentic design with targeted correction offers an effective inference time solution to improve clinical note summarization using LLMs."}],"geoLocations":[],"fundingReferences":[],"url":"https://arxiv.org/abs/2602.20040","contentUrl":null,"metadataVersion":0,"schemaVersion":"http://datacite.org/schema/kernel-4","source":"mds","isActive":true,"state":"findable","reason":null,"viewCount":0,"downloadCount":0,"referenceCount":0,"citationCount":0,"partCount":0,"partOfCount":0,"versionCount":0,"versionOfCount":0,"created":"2026-02-25T15:25:24Z","registered":"2026-02-25T15:25:25Z","published":null,"updated":"2026-02-25T15:25:25Z"},"relationships":{"client":{"data":{"id":"arxiv.content","type":"clients"}}}},{"id":"10.48550/arxiv.2602.20038","type":"dois","attributes":{"doi":"10.48550/arxiv.2602.20038","identifiers":[{"identifier":"2602.20038","identifierType":"arXiv"}],"creators":[{"nameType":"Personal","givenName":"David","familyName":"Fuenmayor","name":"Fuenmayor, David","affiliation":[],"nameIdentifiers":[]}],"titles":[{"title":"Discernment is all you need"}],"publisher":"arXiv","container":{},"publicationYear":2026,"subjects":[{"subject":"Logic (math.LO)","lang":"en","subjectScheme":"arXiv"},{"subject":"Logic in Computer Science (cs.LO)","lang":"en","subjectScheme":"arXiv"},{"subject":"FOS: Mathematics","subjectScheme":"Fields of Science and Technology (FOS)"},{"schemeUri":"http://www.oecd.org/science/inno/38235147.pdf","subject":"FOS: Mathematics","subjectScheme":"Fields of Science and Technology (FOS)"},{"subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"},{"schemeUri":"http://www.oecd.org/science/inno/38235147.pdf","subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"},{"subject":"F.4.1; I.2.3","lang":"en","subjectScheme":"ACM"},{"subject":"03","lang":"en","subjectScheme":"MSC"}],"contributors":[],"dates":[{"date":"2026-02-23T16:46:19Z","dateType":"Submitted","dateInformation":"v1"},{"date":"2026-02-24T02:39:14Z","dateType":"Updated","dateInformation":"v1"},{"date":"2026-02","dateType":"Available","dateInformation":"v1"},{"date":"2026","dateType":"Issued"}],"language":null,"types":{"schemaOrg":"CreativeWork","resourceTypeGeneral":"Preprint","citeproc":"article","bibtex":"misc","ris":"GEN","resourceType":"Article"},"relatedIdentifiers":[],"relatedItems":[],"sizes":[],"formats":[],"version":"1","rightsList":[{"rightsUri":"http://arxiv.org/licenses/nonexclusive-distrib/1.0/","rights":"arXiv.org perpetual, non-exclusive license"}],"descriptions":[{"descriptionType":"Abstract","description":"We explore the expressive power of HOL, a system of higher-order logic, and its relationship to the simply-typed lambda calculus and Church's simple theory of types, arguing for the potential of HOL as a unifying logical framework, capable of encoding a broad range of logical systems, including modal and non-classical logics. Along the way, we emphasize the essential role of discernment, the ability to tell things apart, as a language primitive; highlighting how it endows HOL with practical expressivity superpowers while elegantly enriching its theoretical properties."}],"geoLocations":[],"fundingReferences":[],"url":"https://arxiv.org/abs/2602.20038","contentUrl":null,"metadataVersion":0,"schemaVersion":"http://datacite.org/schema/kernel-4","source":"mds","isActive":true,"state":"findable","reason":null,"viewCount":0,"downloadCount":0,"referenceCount":0,"citationCount":0,"partCount":0,"partOfCount":0,"versionCount":0,"versionOfCount":0,"created":"2026-02-25T15:25:20Z","registered":"2026-02-25T15:25:20Z","published":null,"updated":"2026-02-25T15:25:20Z"},"relationships":{"client":{"data":{"id":"arxiv.content","type":"clients"}}}},{"id":"10.48550/arxiv.2602.20035","type":"dois","attributes":{"doi":"10.48550/arxiv.2602.20035","identifiers":[{"identifier":"2602.20035","identifierType":"arXiv"}],"creators":[{"nameType":"Personal","givenName":"Grigory","familyName":"Ivanov","name":"Ivanov, Grigory","affiliation":[],"nameIdentifiers":[]}],"titles":[{"title":"No-dimensional results of combinatorial convexity. Dimension strikes back"}],"publisher":"arXiv","container":{},"publicationYear":2026,"subjects":[{"subject":"Functional Analysis (math.FA)","lang":"en","subjectScheme":"arXiv"},{"subject":"FOS: Mathematics","subjectScheme":"Fields of Science and Technology (FOS)"},{"schemeUri":"http://www.oecd.org/science/inno/38235147.pdf","subject":"FOS: Mathematics","subjectScheme":"Fields of Science and Technology (FOS)"},{"subject":"52A35 (primary), 46B20, 46B09, 81P45, 15A60","lang":"en","subjectScheme":"MSC"}],"contributors":[],"dates":[{"date":"2026-02-23T16:43:37Z","dateType":"Submitted","dateInformation":"v1"},{"date":"2026-02-24T02:39:08Z","dateType":"Updated","dateInformation":"v1"},{"date":"2026-02","dateType":"Available","dateInformation":"v1"},{"date":"2026","dateType":"Issued"}],"language":null,"types":{"schemaOrg":"CreativeWork","resourceTypeGeneral":"Preprint","citeproc":"article","bibtex":"misc","ris":"GEN","resourceType":"Article"},"relatedIdentifiers":[],"relatedItems":[],"sizes":[],"formats":[],"version":"1","rightsList":[{"rightsUri":"http://arxiv.org/licenses/nonexclusive-distrib/1.0/","rights":"arXiv.org perpetual, non-exclusive license"}],"descriptions":[{"descriptionType":"Abstract","description":"We discuss no-dimensional (approximate) versions of Carathéodory's and Helly's theorems. Our goal is to draw attention to open problems and potential applications related to these results. We survey recent progress and pose several questions. We also point out a simple way to ``bring the dimension back into the picture'': by combining no-dimensional statements with dimension-dependent norm comparisons, one can transfer problems in $\\ell_1^d$, $\\ell_\\infty^d$, and Schatten classes $S_1, S_\\infty$ to nearby $\\ell_p^d$ or $S_p$ spaces with better geometry.\n As elementary applications, we obtain a weak additive analogue of the Johnson--Lindenstrauss flattening lemma, local-to-global estimates for Chebyshev regression over the $\\ell_1$ ball, and a local-to-global guarantee for quantum feasibility from locally consistent linear measurements."}],"geoLocations":[],"fundingReferences":[],"url":"https://arxiv.org/abs/2602.20035","contentUrl":null,"metadataVersion":0,"schemaVersion":"http://datacite.org/schema/kernel-4","source":"mds","isActive":true,"state":"findable","reason":null,"viewCount":0,"downloadCount":0,"referenceCount":0,"citationCount":0,"partCount":0,"partOfCount":0,"versionCount":0,"versionOfCount":0,"created":"2026-02-25T15:25:13Z","registered":"2026-02-25T15:25:13Z","published":null,"updated":"2026-02-25T15:25:13Z"},"relationships":{"client":{"data":{"id":"arxiv.content","type":"clients"}}}},{"id":"10.48550/arxiv.2602.20034","type":"dois","attributes":{"doi":"10.48550/arxiv.2602.20034","identifiers":[{"identifier":"2602.20034","identifierType":"arXiv"}],"creators":[{"nameType":"Personal","givenName":"Alexandre Barbosa","familyName":"de Lima","name":"de Lima, Alexandre Barbosa","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Xavier","familyName":"Hesselbach","name":"Hesselbach, Xavier","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"José Roberto de Almeida","familyName":"Amazonas","name":"Amazonas, José Roberto de Almeida","affiliation":[],"nameIdentifiers":[]}],"titles":[{"title":"Digital Twin--Driven Adaptive Wavelet Strategy for Efficient 6G Backbone Network Telemetry"}],"publisher":"arXiv","container":{},"publicationYear":2026,"subjects":[{"subject":"Signal Processing (eess.SP)","lang":"en","subjectScheme":"arXiv"},{"subject":"Networking and Internet Architecture (cs.NI)","lang":"en","subjectScheme":"arXiv"},{"subject":"FOS: Electrical engineering, electronic engineering, information engineering","subjectScheme":"Fields of Science and Technology (FOS)"},{"schemeUri":"http://www.oecd.org/science/inno/38235147.pdf","subject":"FOS: Electrical engineering, electronic engineering, information engineering","subjectScheme":"Fields of Science and Technology (FOS)"},{"subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"},{"schemeUri":"http://www.oecd.org/science/inno/38235147.pdf","subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"}],"contributors":[],"dates":[{"date":"2026-02-23T16:42:56Z","dateType":"Submitted","dateInformation":"v1"},{"date":"2026-02-24T02:39:07Z","dateType":"Updated","dateInformation":"v1"},{"date":"2026-02","dateType":"Available","dateInformation":"v1"},{"date":"2026","dateType":"Issued"}],"language":null,"types":{"schemaOrg":"CreativeWork","resourceTypeGeneral":"Preprint","citeproc":"article","bibtex":"misc","ris":"GEN","resourceType":"Article"},"relatedIdentifiers":[],"relatedItems":[],"sizes":[],"formats":[],"version":"1","rightsList":[{"rightsUri":"http://arxiv.org/licenses/nonexclusive-distrib/1.0/","rights":"arXiv.org perpetual, non-exclusive license"}],"descriptions":[{"descriptionType":"Abstract","description":"Classical orthogonal wavelets guarantee perfect reconstruction but rely on fixed bases optimized for polynomial smoothness, achieving suboptimal compression on signals with fractal spectral signatures. Conversely, learned methods offer adaptivity but typically enforce orthogonality via soft penalties, sacrificing structural guarantees.\n This work establishes a rigorous equivalence between Multiscale Entanglement Renormalization Ansatz (MERA) tensor networks and paraunitary filter banks. The resulting framework learns adaptive wavelets while enforcing exact orthogonality through manifold-constrained optimization, guaranteeing perfect reconstruction and energy conservation throughout training.\n Validation on Long-Range Dependent (LRD) network traffic demonstrates that learned filters outperform classical wavelets by 0.5--3.8~dB PSNR on six MAWI backbone traces (2020--2025, 314~Mbps--1.75~Gbps) while preserving the Hurst exponent within estimation uncertainty ($|ΔH| \\le 0.03$). These results establish MERA-inspired wavelets as a principled approach for telemetry compression in 6G digital twin synchronization."}],"geoLocations":[],"fundingReferences":[],"url":"https://arxiv.org/abs/2602.20034","contentUrl":null,"metadataVersion":0,"schemaVersion":"http://datacite.org/schema/kernel-4","source":"mds","isActive":true,"state":"findable","reason":null,"viewCount":0,"downloadCount":0,"referenceCount":0,"citationCount":0,"partCount":0,"partOfCount":0,"versionCount":0,"versionOfCount":0,"created":"2026-02-25T15:25:10Z","registered":"2026-02-25T15:25:11Z","published":null,"updated":"2026-02-25T15:25:11Z"},"relationships":{"client":{"data":{"id":"arxiv.content","type":"clients"}}}},{"id":"10.48550/arxiv.2602.20033","type":"dois","attributes":{"doi":"10.48550/arxiv.2602.20033","identifiers":[{"identifier":"2602.20033","identifierType":"arXiv"}],"creators":[{"nameType":"Personal","givenName":"Rabindra","familyName":"Basnet","name":"Basnet, Rabindra","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Subhashree","familyName":"Chatterjee","name":"Chatterjee, Subhashree","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Paul","familyName":"Kigaya","name":"Kigaya, Paul","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Ezana","familyName":"Negusse","name":"Negusse, Ezana","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"J.","familyName":"van Tol","name":"van Tol, J.","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Ramesh C.","familyName":"Budhani","name":"Budhani, Ramesh C.","affiliation":[],"nameIdentifiers":[]}],"titles":[{"title":"Cr3+ spin dynamics under the octahedral crystal field in van der Waals antiferromagnets"}],"publisher":"arXiv","container":{},"publicationYear":2026,"subjects":[{"subject":"Materials Science (cond-mat.mtrl-sci)","lang":"en","subjectScheme":"arXiv"},{"subject":"FOS: Physical sciences","subjectScheme":"Fields of Science and Technology (FOS)"},{"schemeUri":"http://www.oecd.org/science/inno/38235147.pdf","subject":"FOS: Physical sciences","subjectScheme":"Fields of Science and Technology (FOS)"}],"contributors":[],"dates":[{"date":"2026-02-23T16:42:53Z","dateType":"Submitted","dateInformation":"v1"},{"date":"2026-02-24T02:39:06Z","dateType":"Updated","dateInformation":"v1"},{"date":"2026-02","dateType":"Available","dateInformation":"v1"},{"date":"2026","dateType":"Issued"}],"language":null,"types":{"schemaOrg":"CreativeWork","resourceTypeGeneral":"Preprint","citeproc":"article","bibtex":"misc","ris":"GEN","resourceType":"Article"},"relatedIdentifiers":[],"relatedItems":[],"sizes":[],"formats":[],"version":"1","rightsList":[{"rightsIdentifierScheme":"SPDX","rightsUri":"https://creativecommons.org/publicdomain/zero/1.0/legalcode","schemeUri":"https://spdx.org/licenses/","rights":"Creative Commons Zero v1.0 Universal","rightsIdentifier":"cc0-1.0"}],"descriptions":[{"descriptionType":"Abstract","description":"The magnetic moment in van der Waals (vdW) materials containing 3d transition metals originates from unpaired d-electron spins and their interaction with surrounding ligands. The interplay between exchange interactions and magnetic anisotropy stabilizes long-range ordering of such moments. The compound CuCrP2S6 (CCPS) presents an interesting class of vdW solids where the coupling of Cr3+ moments and ordering of Cu1+ ions give rise to a multiferroic ground state. Here we investigate the spin dynamics of Cr3+ ions in CCPS through magnetization and broadband as well as single sub-THz magnetic resonance measurements. The orbital moment of Cr3+ is quenched under the octahedral crystal field of surrounding chalcogen ions, resulting in negligible magnetic anisotropy-a feature common to Cr-based vdW antiferromagnets (AFM). Resonance spectra over a wide frequency-field-temperature range reveal quasi-2D AFM dynamics governed mainly by isotropic Cr-Cr exchange interactions, which determine the magnetic order, spin reorientation, and damping. Sub-THz resonance spectra also uncover a field-induced ferromagnetic polarization, highlighting the universal role of Cr-Cr exchange in layered Cr compounds. Moreover, persistent magnetic correlations far above the Néel temperature (TN ~ 32 K) points to short-range magnetic order in CCPS and motivates future studies of a possible interplay between AFM and antiferroelectric orders. These results establish CCPS as an exemplary system for exploring 2D magnetism and electric-field-tunable spintronic functionalities in layered multiferroics."}],"geoLocations":[],"fundingReferences":[],"url":"https://arxiv.org/abs/2602.20033","contentUrl":null,"metadataVersion":0,"schemaVersion":"http://datacite.org/schema/kernel-4","source":"mds","isActive":true,"state":"findable","reason":null,"viewCount":0,"downloadCount":0,"referenceCount":0,"citationCount":0,"partCount":0,"partOfCount":0,"versionCount":0,"versionOfCount":0,"created":"2026-02-25T15:25:07Z","registered":"2026-02-25T15:25:08Z","published":null,"updated":"2026-02-25T15:25:08Z"},"relationships":{"client":{"data":{"id":"arxiv.content","type":"clients"}}}},{"id":"10.48550/arxiv.2602.20030","type":"dois","attributes":{"doi":"10.48550/arxiv.2602.20030","identifiers":[{"identifier":"2602.20030","identifierType":"arXiv"}],"creators":[{"nameType":"Personal","givenName":"J.","familyName":"Munárriz","name":"Munárriz, J.","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"F.","familyName":"Domínguez-Adame","name":"Domínguez-Adame, F.","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"R. P. A.","familyName":"Lima","name":"Lima, R. P. A.","affiliation":[],"nameIdentifiers":[]}],"titles":[{"title":"Spectroscopy of the Dirac oscillator perturbed by a surface delta potential"}],"publisher":"arXiv","container":{},"publicationYear":2026,"subjects":[{"subject":"Quantum Physics (quant-ph)","lang":"en","subjectScheme":"arXiv"},{"subject":"FOS: Physical sciences","subjectScheme":"Fields of Science and Technology (FOS)"},{"schemeUri":"http://www.oecd.org/science/inno/38235147.pdf","subject":"FOS: Physical sciences","subjectScheme":"Fields of Science and Technology (FOS)"}],"contributors":[],"dates":[{"date":"2026-02-23T16:39:30Z","dateType":"Submitted","dateInformation":"v1"},{"date":"2026-02-24T02:38:51Z","dateType":"Updated","dateInformation":"v1"},{"date":"2026-02","dateType":"Available","dateInformation":"v1"},{"date":"2026","dateType":"Issued"}],"language":null,"types":{"schemaOrg":"CreativeWork","resourceTypeGeneral":"Preprint","citeproc":"article","bibtex":"misc","ris":"GEN","resourceType":"Article"},"relatedIdentifiers":[{"relationType":"IsVersionOf","relatedIdentifier":"10.1016/j.physleta.2012.10.029","relatedIdentifierType":"DOI"}],"relatedItems":[],"sizes":[],"formats":[],"version":"1","rightsList":[{"rightsUri":"http://arxiv.org/licenses/nonexclusive-distrib/1.0/","rights":"arXiv.org perpetual, non-exclusive license"}],"descriptions":[{"descriptionType":"Abstract","description":"We study theoretically the level shift of the Dirac oscillator perturbed by any sharply peaked potential approaching a surface delta potential. A Green function method is used to obtain closed expressions for all partial waves and parities."}],"geoLocations":[],"fundingReferences":[],"url":"https://arxiv.org/abs/2602.20030","contentUrl":null,"metadataVersion":0,"schemaVersion":"http://datacite.org/schema/kernel-4","source":"mds","isActive":true,"state":"findable","reason":null,"viewCount":0,"downloadCount":0,"referenceCount":0,"citationCount":0,"partCount":0,"partOfCount":0,"versionCount":0,"versionOfCount":1,"created":"2026-02-25T15:25:00Z","registered":"2026-02-25T15:25:01Z","published":null,"updated":"2026-02-25T15:25:01Z"},"relationships":{"client":{"data":{"id":"arxiv.content","type":"clients"}}}},{"id":"10.48550/arxiv.2602.20029","type":"dois","attributes":{"doi":"10.48550/arxiv.2602.20029","identifiers":[{"identifier":"2602.20029","identifierType":"arXiv"}],"creators":[{"nameType":"Personal","givenName":"Yueyun","familyName":"Zhu","name":"Zhu, Yueyun","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Steven","familyName":"Golovkine","name":"Golovkine, Steven","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Norma","familyName":"Bargary","name":"Bargary, Norma","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Andrew J.","familyName":"Simpkin","name":"Simpkin, Andrew J.","affiliation":[],"nameIdentifiers":[]}],"titles":[{"title":"Covariance estimation for derivatives of functional data using an additive penalty in P-splines"}],"publisher":"arXiv","container":{},"publicationYear":2026,"subjects":[{"subject":"Methodology (stat.ME)","lang":"en","subjectScheme":"arXiv"},{"subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"},{"schemeUri":"http://www.oecd.org/science/inno/38235147.pdf","subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"}],"contributors":[],"dates":[{"date":"2026-02-23T16:37:00Z","dateType":"Submitted","dateInformation":"v1"},{"date":"2026-02-24T02:38:40Z","dateType":"Updated","dateInformation":"v1"},{"date":"2026-02","dateType":"Available","dateInformation":"v1"},{"date":"2026","dateType":"Issued"}],"language":null,"types":{"schemaOrg":"CreativeWork","resourceTypeGeneral":"Preprint","citeproc":"article","bibtex":"misc","ris":"GEN","resourceType":"Article"},"relatedIdentifiers":[],"relatedItems":[],"sizes":[],"formats":[],"version":"1","rightsList":[{"rightsIdentifierScheme":"SPDX","rightsUri":"https://creativecommons.org/licenses/by/4.0/legalcode","schemeUri":"https://spdx.org/licenses/","rights":"Creative Commons Attribution 4.0 International","rightsIdentifier":"cc-by-4.0"}],"descriptions":[{"descriptionType":"Abstract","description":"P-splines provide a flexible and computationally efficient smoothing framework and are commonly used for derivative estimation in functional data. Including an additive penalty term in P-splines has been shown to improve estimates of derivatives. We propose a method which incorporates the fast covariance estimation (FACE) algorithm with an additive penalty in P-splines. The proposed method is used to estimate derivatives of covariance for functional data, which play an important role in derivative-based functional principal component analysis (FPCA). Following this, we provide an algorithm for estimating the eigenfunctions and their corresponding scores in derivative-based FPCA. For comparison, we evaluate our algorithm against an existing function \\texttt{FPCAder()} in simulation. In addition, we extend the algorithm to multivariate cases, referred to as derivative multivariate functional principal component analysis (DMFPCA). DMFPCA is applied to joint angles in human movement data, where the derivative-based scores demonstrate strong performance in distinguishing locomotion tasks."}],"geoLocations":[],"fundingReferences":[],"url":"https://arxiv.org/abs/2602.20029","contentUrl":null,"metadataVersion":0,"schemaVersion":"http://datacite.org/schema/kernel-4","source":"mds","isActive":true,"state":"findable","reason":null,"viewCount":0,"downloadCount":0,"referenceCount":0,"citationCount":0,"partCount":0,"partOfCount":0,"versionCount":0,"versionOfCount":0,"created":"2026-02-25T15:24:57Z","registered":"2026-02-25T15:24:58Z","published":null,"updated":"2026-02-25T15:24:58Z"},"relationships":{"client":{"data":{"id":"arxiv.content","type":"clients"}}}},{"id":"10.48550/arxiv.2602.20027","type":"dois","attributes":{"doi":"10.48550/arxiv.2602.20027","identifiers":[{"identifier":"2602.20027","identifierType":"arXiv"}],"creators":[{"nameType":"Personal","givenName":"Linus","familyName":"Rösler","name":"Rösler, Linus","affiliation":[],"nameIdentifiers":[]}],"titles":[{"title":"On the birational isotriviality of the Albanese morphism of a log Calabi-Yau pair with a torus action"}],"publisher":"arXiv","container":{},"publicationYear":2026,"subjects":[{"subject":"Algebraic Geometry (math.AG)","lang":"en","subjectScheme":"arXiv"},{"subject":"FOS: Mathematics","subjectScheme":"Fields of Science and Technology (FOS)"},{"schemeUri":"http://www.oecd.org/science/inno/38235147.pdf","subject":"FOS: Mathematics","subjectScheme":"Fields of Science and Technology (FOS)"},{"subject":"14E99, 14J32, 14J40, 14K99, 14L30 (Primary) 14D06, 14E30 (Secondary)","lang":"en","subjectScheme":"MSC"}],"contributors":[],"dates":[{"date":"2026-02-23T16:33:46Z","dateType":"Submitted","dateInformation":"v1"},{"date":"2026-02-24T02:38:26Z","dateType":"Updated","dateInformation":"v1"},{"date":"2026-02-24T13:08:00Z","dateType":"Submitted","dateInformation":"v2"},{"date":"2026-02-25T01:46:53Z","dateType":"Updated","dateInformation":"v2"},{"date":"2026-02","dateType":"Available","dateInformation":"v1"},{"date":"2026","dateType":"Issued"}],"language":null,"types":{"schemaOrg":"CreativeWork","resourceTypeGeneral":"Preprint","citeproc":"article","bibtex":"misc","ris":"GEN","resourceType":"Article"},"relatedIdentifiers":[],"relatedItems":[],"sizes":[],"formats":[],"version":"2","rightsList":[{"rightsUri":"http://arxiv.org/licenses/nonexclusive-distrib/1.0/","rights":"arXiv.org perpetual, non-exclusive license"}],"descriptions":[{"descriptionType":"Abstract","description":"Let $(X,Δ)$ be a projective, log canonical, $K$-trivial pair over the complex numbers. Let $Z$ be a minimal log canonical center of $(X,Δ)$ and suppose that there exists a torus $\\mathbb{T}\\subseteq\\operatorname{Aut}(X)$ preserving $Δ$ and such that $\\dim\\mathbb{T}=\\operatorname{codim}_X Z$. Then we show that two general fibers of the Albanese morphism $\\operatorname{alb}_X$ are birationally equivalent. In particular, the pathological example of a projective, log canonical, $K$-trivial variety whose Albanese morphism is not generically birationally isotrivial, recently constructed by Bernasconi, Filipazzi, Patakfalvi and Tsakanikas, can be avoided under the additional hypothesis that there exists a torus of large enough dimension in the automorphism group of the given pair."},{"descriptionType":"Other","description":"20 pages, comments welcome!"}],"geoLocations":[],"fundingReferences":[],"url":"https://arxiv.org/abs/2602.20027","contentUrl":null,"metadataVersion":0,"schemaVersion":"http://datacite.org/schema/kernel-4","source":"mds","isActive":true,"state":"findable","reason":null,"viewCount":0,"downloadCount":0,"referenceCount":0,"citationCount":0,"partCount":0,"partOfCount":0,"versionCount":0,"versionOfCount":0,"created":"2026-02-25T15:24:52Z","registered":"2026-02-25T15:24:53Z","published":null,"updated":"2026-02-25T15:24:53Z"},"relationships":{"client":{"data":{"id":"arxiv.content","type":"clients"}}}},{"id":"10.48550/arxiv.2602.20024","type":"dois","attributes":{"doi":"10.48550/arxiv.2602.20024","identifiers":[{"identifier":"2602.20024","identifierType":"arXiv"}],"creators":[{"nameType":"Personal","givenName":"Xinglin","familyName":"Zeng","name":"Zeng, Xinglin","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Linqiao","familyName":"Gan","name":"Gan, Linqiao","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Jesús Humberto Marines","familyName":"Cabello","name":"Cabello, Jesús Humberto Marines","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Olivia","familyName":"Saffer","name":"Saffer, Olivia","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Birgit","familyName":"Stiller","name":"Stiller, Birgit","affiliation":[],"nameIdentifiers":[]}],"titles":[{"title":"Two-spin-multiplexed optoacoustic light storage in chiral photonic crystal fiber"}],"publisher":"arXiv","container":{},"publicationYear":2026,"subjects":[{"subject":"Optics (physics.optics)","lang":"en","subjectScheme":"arXiv"},{"subject":"FOS: Physical sciences","subjectScheme":"Fields of Science and Technology (FOS)"},{"schemeUri":"http://www.oecd.org/science/inno/38235147.pdf","subject":"FOS: Physical sciences","subjectScheme":"Fields of Science and Technology (FOS)"}],"contributors":[],"dates":[{"date":"2026-02-23T16:32:52Z","dateType":"Submitted","dateInformation":"v1"},{"date":"2026-02-24T02:38:07Z","dateType":"Updated","dateInformation":"v1"},{"date":"2026-02","dateType":"Available","dateInformation":"v1"},{"date":"2026","dateType":"Issued"}],"language":null,"types":{"schemaOrg":"CreativeWork","resourceTypeGeneral":"Preprint","citeproc":"article","bibtex":"misc","ris":"GEN","resourceType":"Article"},"relatedIdentifiers":[],"relatedItems":[],"sizes":[],"formats":[],"version":"1","rightsList":[{"rightsIdentifierScheme":"SPDX","rightsUri":"https://creativecommons.org/licenses/by/4.0/legalcode","schemeUri":"https://spdx.org/licenses/","rights":"Creative Commons Attribution 4.0 International","rightsIdentifier":"cc-by-4.0"}],"descriptions":[{"descriptionType":"Abstract","description":"The ability to coherently store and manipulate optical information across multiple degrees of freedom is a central requirement for scalable quantum information processing and multidimensional quantum computing. While polarization- and space-division-multiplexing have substantially increased the capacity of classical optical systems, their extension to coherent and reconfigurable photonic memories remains a key challenge. Here we demonstrate a two-spin-channel-multiplexed photonic memory based on chiral stimulated Brillouin scattering in a chiral photonic crystal fiber. Exploiting the intrinsic preservation of circular polarization in the chiral photonic crystal fiber, left- and right-circularly polarized modes serve as two orthogonal and independent storage channels. Multiple optical data pulses can be selectively or simultaneously stored and retrieved by simply controlling the polarization states of the write-read pulses. The storage time is continuously tunable, and the underlying Brillouin process preserves coherence and channel orthogonality. The result establishes chiral Brillouin scattering as an effective mechanism for spin-channel-multiplexed optoacoustic light storage, providing a robust and scalable platform for multidimensional photonic memories. It also open new opportunities for classic and quantum information processing, reconfigurable quantum networks, and hybrid light-matter interfaces based on coherent acoustic excitations."}],"geoLocations":[],"fundingReferences":[],"url":"https://arxiv.org/abs/2602.20024","contentUrl":null,"metadataVersion":0,"schemaVersion":"http://datacite.org/schema/kernel-4","source":"mds","isActive":true,"state":"findable","reason":null,"viewCount":0,"downloadCount":0,"referenceCount":0,"citationCount":0,"partCount":0,"partOfCount":0,"versionCount":0,"versionOfCount":0,"created":"2026-02-25T15:24:45Z","registered":"2026-02-25T15:24:46Z","published":null,"updated":"2026-02-25T15:24:46Z"},"relationships":{"client":{"data":{"id":"arxiv.content","type":"clients"}}}},{"id":"10.48550/arxiv.2602.20023","type":"dois","attributes":{"doi":"10.48550/arxiv.2602.20023","identifiers":[{"identifier":"2602.20023","identifierType":"arXiv"}],"creators":[{"nameType":"Personal","givenName":"László","familyName":"Kozma","name":"Kozma, László","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Michal","familyName":"Opler","name":"Opler, Michal","affiliation":[],"nameIdentifiers":[]}],"titles":[{"title":"Fast and simple multiplication of bounded twin-width matrices"}],"publisher":"arXiv","container":{},"publicationYear":2026,"subjects":[{"subject":"Data Structures and Algorithms (cs.DS)","lang":"en","subjectScheme":"arXiv"},{"subject":"Computational Complexity (cs.CC)","lang":"en","subjectScheme":"arXiv"},{"subject":"Computational Geometry (cs.CG)","lang":"en","subjectScheme":"arXiv"},{"subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"},{"schemeUri":"http://www.oecd.org/science/inno/38235147.pdf","subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"}],"contributors":[],"dates":[{"date":"2026-02-23T16:32:29Z","dateType":"Submitted","dateInformation":"v1"},{"date":"2026-02-24T02:38:05Z","dateType":"Updated","dateInformation":"v1"},{"date":"2026-02","dateType":"Available","dateInformation":"v1"},{"date":"2026","dateType":"Issued"}],"language":null,"types":{"schemaOrg":"CreativeWork","resourceTypeGeneral":"Preprint","citeproc":"article","bibtex":"misc","ris":"GEN","resourceType":"Article"},"relatedIdentifiers":[],"relatedItems":[],"sizes":[],"formats":[],"version":"1","rightsList":[{"rightsIdentifierScheme":"SPDX","rightsUri":"https://creativecommons.org/licenses/by/4.0/legalcode","schemeUri":"https://spdx.org/licenses/","rights":"Creative Commons Attribution 4.0 International","rightsIdentifier":"cc-by-4.0"}],"descriptions":[{"descriptionType":"Abstract","description":"Matrix multiplication is a fundamental task in almost all computational fields, including machine learning and optimization, computer graphics, signal processing, and graph algorithms (static and dynamic). Twin-width is a natural complexity measure of matrices (and more general structures) that has recently emerged as a unifying concept with important algorithmic applications. While the twin-width of a matrix is invariant to re-ordering rows and columns, most of its algorithmic applications to date assume that the input is given in a certain canonical ordering that yields a bounded twin-width contraction sequence. In general, efficiently finding such a sequence -- even for an approximate twin-width value -- remains a central and elusive open question.\n In this paper we show that a binary $n \\times n$ matrix of twin-width $d$ can be preprocessed in $\\widetilde{\\mathcal{O}}_d(n^2)$ time, so that its product with any vector can be computed in $\\widetilde{\\mathcal{O}}_d(n)$ time. Notably, the twin-width of the input matrix need not be known and no particular ordering of its rows and columns is assumed. If a canonical ordering is available, i.e., if the input matrix is $d$-twin-ordered, then the runtime of preprocessing and matrix-vector products can be further reduced to $\\mathcal{O}(n^2+dn)$ and $\\mathcal{O}(dn)$.\n Consequently, we can multiply two $n \\times n$ matrices in $\\widetilde{\\mathcal{O}}(n^2)$ time, when at least one of the matrices consists of 0/1 entries and has bounded twin-width. The results also extend to the case of bounded twin-width matrices with adversarial corruption. Our algorithms are significantly faster and simpler than earlier methods that involved first-order model checking and required both input matrices to be $d$-twin-ordered."}],"geoLocations":[],"fundingReferences":[],"url":"https://arxiv.org/abs/2602.20023","contentUrl":null,"metadataVersion":0,"schemaVersion":"http://datacite.org/schema/kernel-4","source":"mds","isActive":true,"state":"findable","reason":null,"viewCount":0,"downloadCount":0,"referenceCount":0,"citationCount":0,"partCount":0,"partOfCount":0,"versionCount":0,"versionOfCount":0,"created":"2026-02-25T15:24:42Z","registered":"2026-02-25T15:24:43Z","published":null,"updated":"2026-02-25T15:24:43Z"},"relationships":{"client":{"data":{"id":"arxiv.content","type":"clients"}}}},{"id":"10.48550/arxiv.2602.20022","type":"dois","attributes":{"doi":"10.48550/arxiv.2602.20022","identifiers":[{"identifier":"2602.20022","identifierType":"arXiv"}],"creators":[{"nameType":"Personal","givenName":"Poorna Talkad","familyName":"Sukumar","name":"Sukumar, Poorna Talkad","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Maurizio","familyName":"Porfiri","name":"Porfiri, Maurizio","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Oded","familyName":"Nov","name":"Nov, Oded","affiliation":[],"nameIdentifiers":[]}],"titles":[{"title":"Studying the Separability of Visual Channel Pairs in Symbol Maps"}],"publisher":"arXiv","container":{},"publicationYear":2026,"subjects":[{"subject":"Human-Computer Interaction (cs.HC)","lang":"en","subjectScheme":"arXiv"},{"subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"},{"schemeUri":"http://www.oecd.org/science/inno/38235147.pdf","subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"}],"contributors":[],"dates":[{"date":"2026-02-23T18:19:27Z","dateType":"Submitted","dateInformation":"v1"},{"date":"2026-02-24T02:37:57Z","dateType":"Updated","dateInformation":"v1"},{"date":"2026-02","dateType":"Available","dateInformation":"v1"},{"date":"2026","dateType":"Issued"}],"language":null,"types":{"schemaOrg":"CreativeWork","resourceTypeGeneral":"Preprint","citeproc":"article","bibtex":"misc","ris":"GEN","resourceType":"Article"},"relatedIdentifiers":[{"relationType":"IsVersionOf","relatedIdentifier":"10.1145/3772318.3790287","relatedIdentifierType":"DOI"}],"relatedItems":[],"sizes":[],"formats":[],"version":"1","rightsList":[{"rightsIdentifierScheme":"SPDX","rightsUri":"https://creativecommons.org/licenses/by/4.0/legalcode","schemeUri":"https://spdx.org/licenses/","rights":"Creative Commons Attribution 4.0 International","rightsIdentifier":"cc-by-4.0"}],"descriptions":[{"descriptionType":"Abstract","description":"Visualizations often encode multivariate data by mapping attributes to distinct visual channels such as color, size, or shape. The effectiveness of these encodings depends on separability--the extent to which channels can be perceived independently. Yet systematic evidence for separability, especially in map-based contexts, is lacking. We present a crowdsourced experiment that evaluates the separability of four channel pairs--color (ordered) x shape, color (ordered) x size, size x shape, and size x orientation--in the context of bivariate symbol maps. Both accuracy and speed analyses show that color x shape is the most separable and size x orientation the least separable, while size x color and size x shape do not differ. Separability also proved asymmetric--performance depended on which channel encoded the task-relevant variable, with color and shape outperforming size, and square shape especially difficult to discriminate. Our findings advance the empirical understanding of visual separability, with implications for multivariate map design."}],"geoLocations":[],"fundingReferences":[],"url":"https://arxiv.org/abs/2602.20022","contentUrl":null,"metadataVersion":0,"schemaVersion":"http://datacite.org/schema/kernel-4","source":"mds","isActive":true,"state":"findable","reason":null,"viewCount":0,"downloadCount":0,"referenceCount":0,"citationCount":0,"partCount":0,"partOfCount":0,"versionCount":0,"versionOfCount":1,"created":"2026-02-25T15:24:40Z","registered":"2026-02-25T15:24:41Z","published":null,"updated":"2026-02-25T15:24:41Z"},"relationships":{"client":{"data":{"id":"arxiv.content","type":"clients"}}}},{"id":"10.48550/arxiv.2602.20021","type":"dois","attributes":{"doi":"10.48550/arxiv.2602.20021","identifiers":[{"identifier":"2602.20021","identifierType":"arXiv"}],"creators":[{"nameType":"Personal","givenName":"Natalie","familyName":"Shapira","name":"Shapira, Natalie","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Chris","familyName":"Wendler","name":"Wendler, Chris","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Avery","familyName":"Yen","name":"Yen, Avery","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Gabriele","familyName":"Sarti","name":"Sarti, Gabriele","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Koyena","familyName":"Pal","name":"Pal, Koyena","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Olivia","familyName":"Floody","name":"Floody, Olivia","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Adam","familyName":"Belfki","name":"Belfki, Adam","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Alex","familyName":"Loftus","name":"Loftus, Alex","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Aditya Ratan","familyName":"Jannali","name":"Jannali, Aditya Ratan","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Nikhil","familyName":"Prakash","name":"Prakash, Nikhil","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Jasmine","familyName":"Cui","name":"Cui, Jasmine","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Giordano","familyName":"Rogers","name":"Rogers, Giordano","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Jannik","familyName":"Brinkmann","name":"Brinkmann, Jannik","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Can","familyName":"Rager","name":"Rager, Can","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Amir","familyName":"Zur","name":"Zur, Amir","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Michael","familyName":"Ripa","name":"Ripa, Michael","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Aruna","familyName":"Sankaranarayanan","name":"Sankaranarayanan, Aruna","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"David","familyName":"Atkinson","name":"Atkinson, David","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Rohit","familyName":"Gandikota","name":"Gandikota, Rohit","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Jaden","familyName":"Fiotto-Kaufman","name":"Fiotto-Kaufman, Jaden","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"EunJeong","familyName":"Hwang","name":"Hwang, EunJeong","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Hadas","familyName":"Orgad","name":"Orgad, Hadas","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"P Sam","familyName":"Sahil","name":"Sahil, P Sam","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Negev","familyName":"Taglicht","name":"Taglicht, Negev","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Tomer","familyName":"Shabtay","name":"Shabtay, Tomer","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Atai","familyName":"Ambus","name":"Ambus, Atai","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Nitay","familyName":"Alon","name":"Alon, Nitay","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Shiri","familyName":"Oron","name":"Oron, Shiri","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Ayelet","familyName":"Gordon-Tapiero","name":"Gordon-Tapiero, Ayelet","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Yotam","familyName":"Kaplan","name":"Kaplan, Yotam","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Vered","familyName":"Shwartz","name":"Shwartz, Vered","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Tamar Rott","familyName":"Shaham","name":"Shaham, Tamar Rott","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Christoph","familyName":"Riedl","name":"Riedl, Christoph","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Reuth","familyName":"Mirsky","name":"Mirsky, Reuth","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Maarten","familyName":"Sap","name":"Sap, Maarten","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"David","familyName":"Manheim","name":"Manheim, David","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Tomer","familyName":"Ullman","name":"Ullman, Tomer","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"David","familyName":"Bau","name":"Bau, David","affiliation":[],"nameIdentifiers":[]}],"titles":[{"title":"Agents of Chaos"}],"publisher":"arXiv","container":{},"publicationYear":2026,"subjects":[{"subject":"Artificial Intelligence (cs.AI)","lang":"en","subjectScheme":"arXiv"},{"subject":"Computers and Society (cs.CY)","lang":"en","subjectScheme":"arXiv"},{"subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"},{"schemeUri":"http://www.oecd.org/science/inno/38235147.pdf","subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"}],"contributors":[],"dates":[{"date":"2026-02-23T16:28:48Z","dateType":"Submitted","dateInformation":"v1"},{"date":"2026-02-24T02:37:39Z","dateType":"Updated","dateInformation":"v1"},{"date":"2026-02","dateType":"Available","dateInformation":"v1"},{"date":"2026","dateType":"Issued"}],"language":null,"types":{"schemaOrg":"CreativeWork","resourceTypeGeneral":"Preprint","citeproc":"article","bibtex":"misc","ris":"GEN","resourceType":"Article"},"relatedIdentifiers":[],"relatedItems":[],"sizes":[],"formats":[],"version":"1","rightsList":[{"rightsUri":"http://arxiv.org/licenses/nonexclusive-distrib/1.0/","rights":"arXiv.org perpetual, non-exclusive license"}],"descriptions":[{"descriptionType":"Abstract","description":"We report an exploratory red-teaming study of autonomous language-model-powered agents deployed in a live laboratory environment with persistent memory, email accounts, Discord access, file systems, and shell execution. Over a two-week period, twenty AI researchers interacted with the agents under benign and adversarial conditions. Focusing on failures emerging from the integration of language models with autonomy, tool use, and multi-party communication, we document eleven representative case studies. Observed behaviors include unauthorized compliance with non-owners, disclosure of sensitive information, execution of destructive system-level actions, denial-of-service conditions, uncontrolled resource consumption, identity spoofing vulnerabilities, cross-agent propagation of unsafe practices, and partial system takeover. In several cases, agents reported task completion while the underlying system state contradicted those reports. We also report on some of the failed attempts. Our findings establish the existence of security-, privacy-, and governance-relevant vulnerabilities in realistic deployment settings. These behaviors raise unresolved questions regarding accountability, delegated authority, and responsibility for downstream harms, and warrant urgent attention from legal scholars, policymakers, and researchers across disciplines. This report serves as an initial empirical contribution to that broader conversation."}],"geoLocations":[],"fundingReferences":[],"url":"https://arxiv.org/abs/2602.20021","contentUrl":null,"metadataVersion":0,"schemaVersion":"http://datacite.org/schema/kernel-4","source":"mds","isActive":true,"state":"findable","reason":null,"viewCount":0,"downloadCount":0,"referenceCount":0,"citationCount":4,"partCount":0,"partOfCount":0,"versionCount":0,"versionOfCount":0,"created":"2026-02-25T15:24:37Z","registered":"2026-02-25T15:24:38Z","published":null,"updated":"2026-02-25T15:24:38Z"},"relationships":{"client":{"data":{"id":"arxiv.content","type":"clients"}}}},{"id":"10.48550/arxiv.2602.20018","type":"dois","attributes":{"doi":"10.48550/arxiv.2602.20018","identifiers":[{"identifier":"2602.20018","identifierType":"arXiv"}],"creators":[{"nameType":"Personal","givenName":"Jiechen","familyName":"Chen","name":"Chen, Jiechen","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Michele","familyName":"Polese","name":"Polese, Michele","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Osvaldo","familyName":"Simeone","name":"Simeone, Osvaldo","affiliation":[],"nameIdentifiers":[]}],"titles":[{"title":"From High-Level Requirements to KPIs: Conformal Signal Temporal Logic Learning for Wireless Communications"}],"publisher":"arXiv","container":{},"publicationYear":2026,"subjects":[{"subject":"Signal Processing (eess.SP)","lang":"en","subjectScheme":"arXiv"},{"subject":"FOS: Electrical engineering, electronic engineering, information engineering","subjectScheme":"Fields of Science and Technology (FOS)"},{"schemeUri":"http://www.oecd.org/science/inno/38235147.pdf","subject":"FOS: Electrical engineering, electronic engineering, information engineering","subjectScheme":"Fields of Science and Technology (FOS)"}],"contributors":[],"dates":[{"date":"2026-02-23T16:24:48Z","dateType":"Submitted","dateInformation":"v1"},{"date":"2026-02-24T02:37:31Z","dateType":"Updated","dateInformation":"v1"},{"date":"2026-02","dateType":"Available","dateInformation":"v1"},{"date":"2026","dateType":"Issued"}],"language":null,"types":{"schemaOrg":"CreativeWork","resourceTypeGeneral":"Preprint","citeproc":"article","bibtex":"misc","ris":"GEN","resourceType":"Article"},"relatedIdentifiers":[],"relatedItems":[],"sizes":[],"formats":[],"version":"1","rightsList":[{"rightsUri":"http://arxiv.org/licenses/nonexclusive-distrib/1.0/","rights":"arXiv.org perpetual, non-exclusive license"}],"descriptions":[{"descriptionType":"Abstract","description":"Softwarized radio access networks (RANs), such as those based on the Open RAN (O-RAN) architecture, generate rich streams of key performance indicators (KPIs) that can be leveraged to extract actionable intelligence for network optimization. However, bridging the gap between low-level KPI measurements and high-level requirements, such as quality of experience (QoE), requires methods that are both relevant, capturing temporal patterns predictive of user-level outcomes, and interpretable, providing human-readable insights that operators can validate and act upon. This paper introduces conformal signal temporal logic learning (C-STLL), a framework that addresses both requirements. C-STLL leverages signal temporal logic (STL), a formal language for specifying temporal properties of time series, to learn interpretable formulas that distinguish KPI traces satisfying high-level requirements from those that do not. To ensure reliability, C-STLL wraps around existing STL learning algorithms with a conformal calibration procedure based on the Learn Then Test (LTT) framework. This procedure produces a set of STL formulas with formal guarantees: with high probability, the set contains at least one formula achieving a user-specified accuracy level. The calibration jointly optimizes for reliability, formula complexity, and diversity through principled acceptance and stopping rules validated via multiple hypothesis testing. Experiments using the ns-3 network simulator on a mobile gaming scenario demonstrate that C-STLL effectively controls risk below target levels while returning compact, diverse sets of interpretable temporal specifications that relate KPI behavior to QoE outcomes."}],"geoLocations":[],"fundingReferences":[],"url":"https://arxiv.org/abs/2602.20018","contentUrl":null,"metadataVersion":0,"schemaVersion":"http://datacite.org/schema/kernel-4","source":"mds","isActive":true,"state":"findable","reason":null,"viewCount":0,"downloadCount":0,"referenceCount":0,"citationCount":0,"partCount":0,"partOfCount":0,"versionCount":0,"versionOfCount":0,"created":"2026-02-25T15:24:30Z","registered":"2026-02-25T15:24:31Z","published":null,"updated":"2026-02-25T15:24:31Z"},"relationships":{"client":{"data":{"id":"arxiv.content","type":"clients"}}}},{"id":"10.48550/arxiv.2602.20016","type":"dois","attributes":{"doi":"10.48550/arxiv.2602.20016","identifiers":[{"identifier":"2602.20016","identifierType":"arXiv"}],"creators":[{"nameType":"Personal","givenName":"Claudiu","familyName":"Mîndrilă","name":"Mîndrilă, Claudiu","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Arnab","familyName":"Roy","name":"Roy, Arnab","affiliation":[],"nameIdentifiers":[]}],"titles":[{"title":"Existence of weak solutions for incompressible fluid-Koiter shell interactions with Navier slip boundary condition"}],"publisher":"arXiv","container":{},"publicationYear":2026,"subjects":[{"subject":"Analysis of PDEs (math.AP)","lang":"en","subjectScheme":"arXiv"},{"subject":"FOS: Mathematics","subjectScheme":"Fields of Science and Technology (FOS)"},{"schemeUri":"http://www.oecd.org/science/inno/38235147.pdf","subject":"FOS: Mathematics","subjectScheme":"Fields of Science and Technology (FOS)"}],"contributors":[],"dates":[{"date":"2026-02-23T16:23:15Z","dateType":"Submitted","dateInformation":"v1"},{"date":"2026-02-24T02:37:26Z","dateType":"Updated","dateInformation":"v1"},{"date":"2026-02","dateType":"Available","dateInformation":"v1"},{"date":"2026","dateType":"Issued"}],"language":null,"types":{"schemaOrg":"CreativeWork","resourceTypeGeneral":"Preprint","citeproc":"article","bibtex":"misc","ris":"GEN","resourceType":"Article"},"relatedIdentifiers":[],"relatedItems":[],"sizes":[],"formats":[],"version":"1","rightsList":[{"rightsUri":"http://arxiv.org/licenses/nonexclusive-distrib/1.0/","rights":"arXiv.org perpetual, non-exclusive license"}],"descriptions":[{"descriptionType":"Abstract","description":"We study a three-dimensional fluid-structure interaction problem describing the motion of an incompressible, viscous fluid coupled with a deformable elastic shell of Koiter type that forms part of the fluid boundary. The fluid motion is governed by the incompressible Navier--Stokes equations posed on a time-dependent domain, while the shell evolution is described by a nonlinear elastic model. At the fluid-structure interface, we impose Navier slip boundary conditions, allowing for tangential slip penalized by friction. Our main result establishes the global-in-time existence of weak solutions up to the first possible self-intersection of the shell, for arbitrarily large initial data with finite energy. The analysis is carried out in a fully three-dimensional setting and addresses the major mathematical challenges arising from the moving domain, the geometric nonlinearity of the shell, and the reduced regularization induced by the slip boundary condition. The proof relies on a careful construction of suitable approximation schemes, novel compactness arguments adapted to the slip framework, and a new extension operator for divergence-free test functions compatible with the fluid-shell coupling. As a further contribution, we provide a direct approach to the strong convergence of second-order spatial derivatives of the shell displacement, which allows us to treat nonlinear Koiter shell models within the same framework."}],"geoLocations":[],"fundingReferences":[],"url":"https://arxiv.org/abs/2602.20016","contentUrl":null,"metadataVersion":0,"schemaVersion":"http://datacite.org/schema/kernel-4","source":"mds","isActive":true,"state":"findable","reason":null,"viewCount":0,"downloadCount":0,"referenceCount":0,"citationCount":0,"partCount":0,"partOfCount":0,"versionCount":0,"versionOfCount":0,"created":"2026-02-25T15:24:25Z","registered":"2026-02-25T15:24:26Z","published":null,"updated":"2026-02-25T15:24:26Z"},"relationships":{"client":{"data":{"id":"arxiv.content","type":"clients"}}}},{"id":"10.48550/arxiv.2602.20014","type":"dois","attributes":{"doi":"10.48550/arxiv.2602.20014","identifiers":[{"identifier":"2602.20014","identifierType":"arXiv"}],"creators":[{"nameType":"Personal","givenName":"Olga","familyName":"Viberg","name":"Viberg, Olga","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Mutlu","familyName":"Cukurova","name":"Cukurova, Mutlu","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Rene F.","familyName":"Kizilcec","name":"Kizilcec, Rene F.","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Simon Buckingham","familyName":"Shum","name":"Shum, Simon Buckingham","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Dorottya","familyName":"Demszky","name":"Demszky, Dorottya","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Dragan","familyName":"Gašević","name":"Gašević, Dragan","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Thorben","familyName":"Jansen","name":"Jansen, Thorben","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Ioana","familyName":"Jivet","name":"Jivet, Ioana","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Jelena","familyName":"Jovanovic","name":"Jovanovic, Jelena","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Jennifer","familyName":"Meyer","name":"Meyer, Jennifer","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Kou","familyName":"Murayama","name":"Murayama, Kou","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Zach","familyName":"Pardos","name":"Pardos, Zach","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Chris","familyName":"Piech","name":"Piech, Chris","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Nikol","familyName":"Rummel","name":"Rummel, Nikol","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Naomi E.","familyName":"Winstone","name":"Winstone, Naomi E.","affiliation":[],"nameIdentifiers":[]}],"titles":[{"title":"Protecting and Promoting Human Agency in Education in the Age of Artificial Intelligence"}],"publisher":"arXiv","container":{},"publicationYear":2026,"subjects":[{"subject":"Human-Computer Interaction (cs.HC)","lang":"en","subjectScheme":"arXiv"},{"subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"},{"schemeUri":"http://www.oecd.org/science/inno/38235147.pdf","subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"}],"contributors":[],"dates":[{"date":"2026-02-23T16:21:15Z","dateType":"Submitted","dateInformation":"v1"},{"date":"2026-02-24T02:37:17Z","dateType":"Updated","dateInformation":"v1"},{"date":"2026-02","dateType":"Available","dateInformation":"v1"},{"date":"2026","dateType":"Issued"}],"language":null,"types":{"schemaOrg":"CreativeWork","resourceTypeGeneral":"Preprint","citeproc":"article","bibtex":"misc","ris":"GEN","resourceType":"Article"},"relatedIdentifiers":[],"relatedItems":[],"sizes":[],"formats":[],"version":"1","rightsList":[{"rightsIdentifierScheme":"SPDX","rightsUri":"https://creativecommons.org/licenses/by/4.0/legalcode","schemeUri":"https://spdx.org/licenses/","rights":"Creative Commons Attribution 4.0 International","rightsIdentifier":"cc-by-4.0"}],"descriptions":[{"descriptionType":"Abstract","description":"Human agency is crucial in education and increasingly challenged by the use of generative AI. This meeting report synthesizes interdisciplinary insights and conceptualizes four aspects that delineate human agency: human oversight, AI-human complementarity, AI competencies, and relational emergence. We explore practical dilemmas for protecting and promoting agency, focusing on normative constraints, transparency, and cognitive offloading, and highlight key tensions and implications to inform ethical and effective AI integration in education."},{"descriptionType":"Other","description":"O.V., M.C., and R.F.K. organized the meeting and wrote the first version of the report. All authors contributed to the revision of the manuscript, and read and approved the final version"}],"geoLocations":[],"fundingReferences":[],"url":"https://arxiv.org/abs/2602.20014","contentUrl":null,"metadataVersion":0,"schemaVersion":"http://datacite.org/schema/kernel-4","source":"mds","isActive":true,"state":"findable","reason":null,"viewCount":0,"downloadCount":0,"referenceCount":0,"citationCount":0,"partCount":0,"partOfCount":0,"versionCount":0,"versionOfCount":0,"created":"2026-02-25T15:24:20Z","registered":"2026-02-25T15:24:21Z","published":null,"updated":"2026-02-25T15:24:21Z"},"relationships":{"client":{"data":{"id":"arxiv.content","type":"clients"}}}},{"id":"10.48550/arxiv.2602.20013","type":"dois","attributes":{"doi":"10.48550/arxiv.2602.20013","identifiers":[{"identifier":"2602.20013","identifierType":"arXiv"}],"creators":[{"nameType":"Personal","givenName":"S.","familyName":"Bhuvaneswari","name":"Bhuvaneswari, S.","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"R.","familyName":"Muthuganesan","name":"Muthuganesan, R.","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"R.","familyName":"Radha","name":"Radha, R.","affiliation":[],"nameIdentifiers":[]}],"titles":[{"title":"Quantum correlation and coherence in a mononuclear nickel-based molecular Magnet"}],"publisher":"arXiv","container":{},"publicationYear":2026,"subjects":[{"subject":"Quantum Physics (quant-ph)","lang":"en","subjectScheme":"arXiv"},{"subject":"FOS: Physical sciences","subjectScheme":"Fields of Science and Technology (FOS)"},{"schemeUri":"http://www.oecd.org/science/inno/38235147.pdf","subject":"FOS: Physical sciences","subjectScheme":"Fields of Science and Technology (FOS)"}],"contributors":[],"dates":[{"date":"2026-02-23T16:19:23Z","dateType":"Submitted","dateInformation":"v1"},{"date":"2026-02-24T02:37:13Z","dateType":"Updated","dateInformation":"v1"},{"date":"2026-02","dateType":"Available","dateInformation":"v1"},{"date":"2026","dateType":"Issued"}],"language":null,"types":{"schemaOrg":"CreativeWork","resourceTypeGeneral":"Preprint","citeproc":"article","bibtex":"misc","ris":"GEN","resourceType":"Article"},"relatedIdentifiers":[],"relatedItems":[],"sizes":[],"formats":[],"version":"1","rightsList":[{"rightsIdentifierScheme":"SPDX","rightsUri":"https://creativecommons.org/licenses/by/4.0/legalcode","schemeUri":"https://spdx.org/licenses/","rights":"Creative Commons Attribution 4.0 International","rightsIdentifier":"cc-by-4.0"}],"descriptions":[{"descriptionType":"Abstract","description":"We investigate the behaviors of thermal entanglement, quantum correlation beyond entanglement namely, measurement-induced nonlocality (MIN) and coherence in a nickel radical molecular magnet (Et3NH)[Ni(hfac)2L], whose spin-spin interactions are well described by the Heisenberg model. Using experimentally estimated coupling parameters, we compute the thermal state of the system and analyze the dependence of quantum resources on temperature and magnetic field. The results indicate that the quantum resources of the nickel-radical molecular magnet persist even at room temperature. We show that while negativity (the entanglement measure) rapidly vanishes with increasing temperature and magnetic field, measurement-induced nonlocality and quantum coherence remain comparatively more stable and persist in regions where entanglement is absent. These results highlight the significance of nonclassical correlations beyond entanglement in thermally activated spin systems and suggest that such molecular magnets could serve as viable platforms for quantum information processing in realistic conditions."},{"descriptionType":"Other","description":"10 pages, 4 Figures; Comments are welcome. To appear in Journal of Magnetisam and Magnetic Materials"}],"geoLocations":[],"fundingReferences":[],"url":"https://arxiv.org/abs/2602.20013","contentUrl":null,"metadataVersion":0,"schemaVersion":"http://datacite.org/schema/kernel-4","source":"mds","isActive":true,"state":"findable","reason":null,"viewCount":0,"downloadCount":0,"referenceCount":0,"citationCount":0,"partCount":0,"partOfCount":0,"versionCount":0,"versionOfCount":0,"created":"2026-02-25T15:24:18Z","registered":"2026-02-25T15:24:19Z","published":null,"updated":"2026-02-25T15:24:19Z"},"relationships":{"client":{"data":{"id":"arxiv.content","type":"clients"}}}},{"id":"10.48550/arxiv.2602.20012","type":"dois","attributes":{"doi":"10.48550/arxiv.2602.20012","identifiers":[{"identifier":"2602.20012","identifierType":"arXiv"}],"creators":[{"nameType":"Personal","givenName":"Dylan","familyName":"Mcleod","name":"Mcleod, Dylan","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Fabrizio","familyName":"Chiriano","name":"Chiriano, Fabrizio","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Francesco","familyName":"Graffitti","name":"Graffitti, Francesco","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Alessandro","familyName":"Fedrizzi","name":"Fedrizzi, Alessandro","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Brian D.","familyName":"Gerardot","name":"Gerardot, Brian D.","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Mauro","familyName":"Brotons-Gisbert","name":"Brotons-Gisbert, Mauro","affiliation":[],"nameIdentifiers":[]}],"titles":[{"title":"Twist-Engineered Nonlinearity in Two-Dimensional Crystals for Tailored Quantum Light"}],"publisher":"arXiv","container":{},"publicationYear":2026,"subjects":[{"subject":"Optics (physics.optics)","lang":"en","subjectScheme":"arXiv"},{"subject":"FOS: Physical sciences","subjectScheme":"Fields of Science and Technology (FOS)"},{"schemeUri":"http://www.oecd.org/science/inno/38235147.pdf","subject":"FOS: Physical sciences","subjectScheme":"Fields of Science and Technology (FOS)"}],"contributors":[],"dates":[{"date":"2026-02-23T16:18:18Z","dateType":"Submitted","dateInformation":"v1"},{"date":"2026-02-24T02:37:12Z","dateType":"Updated","dateInformation":"v1"},{"date":"2026-02","dateType":"Available","dateInformation":"v1"},{"date":"2026","dateType":"Issued"}],"language":null,"types":{"schemaOrg":"CreativeWork","resourceTypeGeneral":"Preprint","citeproc":"article","bibtex":"misc","ris":"GEN","resourceType":"Article"},"relatedIdentifiers":[],"relatedItems":[],"sizes":[],"formats":[],"version":"1","rightsList":[{"rightsIdentifierScheme":"SPDX","rightsUri":"https://creativecommons.org/licenses/by-nc-sa/4.0/legalcode","schemeUri":"https://spdx.org/licenses/","rights":"Creative Commons Attribution Non Commercial Share Alike 4.0 International","rightsIdentifier":"cc-by-nc-sa-4.0"}],"descriptions":[{"descriptionType":"Abstract","description":"Van der Waals (vdW) materials enable nonlinear-optical engineering with unprecedented resolution: their strong second-order susceptibilities ($χ^{(2)}$) and twist-tunable interlayer symmetry allow the effective nonlinearity to be shaped continuously, rather than through binary $\\pmχ^{(2)}$ domain inversion as in bulk ferroelectrics. Here, we show that twist-angle domain engineering exploits this continuous degree of freedom to reconstruct target longitudinal nonlinearity profiles with high fidelity. Using spontaneous parametric down-conversion (SPDC) as a benchmark, we demonstrate that twist-engineered vdW crystals yield significantly improved approximations of target phase-matching functions and correspondingly higher single-photon purities, particularly in compact devices where fabrication constraints limit conventional approaches. We further show that this framework remains effective in experimentally relevant vdW materials and demanding non-degenerate wavelength regimes involving mid-infrared photons. More broadly, the ability to continuously and locally program $χ^{(2)}$ establishes a general framework for tailoring a wide range of SPDC properties, including absolute brightness, joint spectral amplitude structure, signal-idler frequency separation, and temporal wavepacket shape beyond what is accessible in conventional nonlinear crystals. These results position vdW heterostructures as a powerful platform for engineered quantum light sources and open new opportunities for nonlinear-optical devices shaped with monolayer thickness scale."}],"geoLocations":[],"fundingReferences":[],"url":"https://arxiv.org/abs/2602.20012","contentUrl":null,"metadataVersion":0,"schemaVersion":"http://datacite.org/schema/kernel-4","source":"mds","isActive":true,"state":"findable","reason":null,"viewCount":0,"downloadCount":0,"referenceCount":0,"citationCount":0,"partCount":0,"partOfCount":0,"versionCount":0,"versionOfCount":0,"created":"2026-02-25T15:24:16Z","registered":"2026-02-25T15:24:16Z","published":null,"updated":"2026-02-25T15:24:16Z"},"relationships":{"client":{"data":{"id":"arxiv.content","type":"clients"}}}},{"id":"10.48550/arxiv.2602.20011","type":"dois","attributes":{"doi":"10.48550/arxiv.2602.20011","identifiers":[{"identifier":"2602.20011","identifierType":"arXiv"}],"creators":[{"nameType":"Personal","givenName":"Stefano","familyName":"De Marco","name":"De Marco, Stefano","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Huyên","familyName":"Pham","name":"Pham, Huyên","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Davide","familyName":"Zanni","name":"Zanni, Davide","affiliation":[],"nameIdentifiers":[]}],"titles":[{"title":"Schrödinger bridges with jumps for time series generation"}],"publisher":"arXiv","container":{},"publicationYear":2026,"subjects":[{"subject":"Mathematical Finance (q-fin.MF)","lang":"en","subjectScheme":"arXiv"},{"subject":"FOS: Economics and business","subjectScheme":"Fields of Science and Technology (FOS)"},{"schemeUri":"http://www.oecd.org/science/inno/38235147.pdf","subject":"FOS: Economics and business","subjectScheme":"Fields of Science and Technology (FOS)"},{"subject":"91G80, 49Q22","lang":"en","subjectScheme":"MSC"}],"contributors":[],"dates":[{"date":"2026-02-23T16:17:25Z","dateType":"Submitted","dateInformation":"v1"},{"date":"2026-02-24T02:37:11Z","dateType":"Updated","dateInformation":"v1"},{"date":"2026-02","dateType":"Available","dateInformation":"v1"},{"date":"2026","dateType":"Issued"}],"language":null,"types":{"schemaOrg":"CreativeWork","resourceTypeGeneral":"Preprint","citeproc":"article","bibtex":"misc","ris":"GEN","resourceType":"Article"},"relatedIdentifiers":[],"relatedItems":[],"sizes":[],"formats":[],"version":"1","rightsList":[{"rightsIdentifierScheme":"SPDX","rightsUri":"https://creativecommons.org/licenses/by/4.0/legalcode","schemeUri":"https://spdx.org/licenses/","rights":"Creative Commons Attribution 4.0 International","rightsIdentifier":"cc-by-4.0"}],"descriptions":[{"descriptionType":"Abstract","description":"We study generative modeling for time series using entropic optimal transport and the Schrödinger bridge (SB) framework, with a focus on applications in finance and energy modeling. Extending the diffusion-based approach of Hamdouche, Henry-Labordère, Pham, 2023, we introduce a jump-diffusion Schrödinger bridge model that allows for discontinuities in the generative dynamics. Starting from a Schrödinger bridge entropy minimization problem, we reformulate the task as a stochastic control problem whose solution characterizes the optimal controlled jump-diffusion process. When sampled on a fixed time grid, this process generates synthetic time series matching the joint distributions of the observed data. The model is fully data-driven, as both the drift and the jump intensity are learned directly from the data. We propose practical algorithms for training, sampling, and hyperparameter calibration. Numerical experiments on simulated and real datasets, including financial and energy time series, show that incorporating jumps substantially improves the realism of the generated data, in particular by capturing abrupt movements, heavy tails, and regime changes that diffusion-only models fail to reproduce. Comparisons with state-of-the-art generative models highlight the benefits and limitations of the proposed approach."},{"descriptionType":"Other","description":"34 pages, 30 figures"}],"geoLocations":[],"fundingReferences":[],"url":"https://arxiv.org/abs/2602.20011","contentUrl":null,"metadataVersion":0,"schemaVersion":"http://datacite.org/schema/kernel-4","source":"mds","isActive":true,"state":"findable","reason":null,"viewCount":0,"downloadCount":0,"referenceCount":0,"citationCount":0,"partCount":0,"partOfCount":0,"versionCount":0,"versionOfCount":0,"created":"2026-02-25T15:24:13Z","registered":"2026-02-25T15:24:14Z","published":null,"updated":"2026-02-25T15:24:14Z"},"relationships":{"client":{"data":{"id":"arxiv.content","type":"clients"}}}},{"id":"10.48550/arxiv.2602.20010","type":"dois","attributes":{"doi":"10.48550/arxiv.2602.20010","identifiers":[{"identifier":"2602.20010","identifierType":"arXiv"}],"creators":[{"nameType":"Personal","givenName":"Wiesław","familyName":"Kubiak","name":"Kubiak, Wiesław","affiliation":[],"nameIdentifiers":[]}],"titles":[{"title":"On scheduling coupled tasks with exact delays to minimize maximum lateness"}],"publisher":"arXiv","container":{},"publicationYear":2026,"subjects":[{"subject":"Discrete Mathematics (cs.DM)","lang":"en","subjectScheme":"arXiv"},{"subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"},{"schemeUri":"http://www.oecd.org/science/inno/38235147.pdf","subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"}],"contributors":[],"dates":[{"date":"2026-02-23T16:17:10Z","dateType":"Submitted","dateInformation":"v1"},{"date":"2026-02-24T02:37:10Z","dateType":"Updated","dateInformation":"v1"},{"date":"2026-02","dateType":"Available","dateInformation":"v1"},{"date":"2026","dateType":"Issued"}],"language":null,"types":{"schemaOrg":"CreativeWork","resourceTypeGeneral":"Preprint","citeproc":"article","bibtex":"misc","ris":"GEN","resourceType":"Article"},"relatedIdentifiers":[],"relatedItems":[],"sizes":[],"formats":[],"version":"1","rightsList":[{"rightsIdentifierScheme":"SPDX","rightsUri":"https://creativecommons.org/licenses/by/4.0/legalcode","schemeUri":"https://spdx.org/licenses/","rights":"Creative Commons Attribution 4.0 International","rightsIdentifier":"cc-by-4.0"}],"descriptions":[{"descriptionType":"Abstract","description":"This paper studies scheduling coupled tasks with exact delays to minimize maximum lateness. The first task has processing time $p\u0026gt;0$ and the second $b_i\\geq 0$, also the second needs to start exactly $p$ units of time after the completion of the first. The couple has due date $d_i$. The tasks are scheduled on a single machine to minimize maximum lateness. The problem has been left open in the literature which offer hardly any results on scheduling coupled tasks with exact delays to minimize maximum lateness. The paper shows polynomial time algorithms for \\emph{agreeable} ($d_i\\geq d_j$ implies $b_i\\geq b_j$) and \\emph{disagreeable} ($d_i\\geq d_j$ implies $b_i\\leq b_j$) cases. The complexity of the general problem remains open."}],"geoLocations":[],"fundingReferences":[],"url":"https://arxiv.org/abs/2602.20010","contentUrl":null,"metadataVersion":0,"schemaVersion":"http://datacite.org/schema/kernel-4","source":"mds","isActive":true,"state":"findable","reason":null,"viewCount":0,"downloadCount":0,"referenceCount":0,"citationCount":0,"partCount":0,"partOfCount":0,"versionCount":0,"versionOfCount":0,"created":"2026-02-25T15:24:11Z","registered":"2026-02-25T15:24:12Z","published":null,"updated":"2026-02-25T15:24:12Z"},"relationships":{"client":{"data":{"id":"arxiv.content","type":"clients"}}}},{"id":"10.48550/arxiv.2602.20009","type":"dois","attributes":{"doi":"10.48550/arxiv.2602.20009","identifiers":[{"identifier":"2602.20009","identifierType":"arXiv"}],"creators":[{"nameType":"Personal","givenName":"Giorgia","familyName":"Sampò","name":"Sampò, Giorgia","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Saverio","familyName":"Giallorenzo","name":"Giallorenzo, Saverio","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Zelda Alice","familyName":"Franceschi","name":"Franceschi, Zelda Alice","affiliation":[],"nameIdentifiers":[]}],"titles":[{"title":"A Mixed-Method Framework for Evaluating the Social Impact of Community Cooperation Projects in Developing Countries"}],"publisher":"arXiv","container":{},"publicationYear":2026,"subjects":[{"subject":"Social and Information Networks (cs.SI)","lang":"en","subjectScheme":"arXiv"},{"subject":"General Economics (econ.GN)","lang":"en","subjectScheme":"arXiv"},{"subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"},{"schemeUri":"http://www.oecd.org/science/inno/38235147.pdf","subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"},{"subject":"FOS: Economics and business","subjectScheme":"Fields of Science and Technology (FOS)"},{"schemeUri":"http://www.oecd.org/science/inno/38235147.pdf","subject":"FOS: Economics and business","subjectScheme":"Fields of Science and Technology (FOS)"}],"contributors":[],"dates":[{"date":"2026-02-23T16:16:37Z","dateType":"Submitted","dateInformation":"v1"},{"date":"2026-02-24T02:37:09Z","dateType":"Updated","dateInformation":"v1"},{"date":"2026-02","dateType":"Available","dateInformation":"v1"},{"date":"2026","dateType":"Issued"}],"language":null,"types":{"schemaOrg":"CreativeWork","resourceTypeGeneral":"Preprint","citeproc":"article","bibtex":"misc","ris":"GEN","resourceType":"Article"},"relatedIdentifiers":[],"relatedItems":[],"sizes":[],"formats":[],"version":"1","rightsList":[{"rightsIdentifierScheme":"SPDX","rightsUri":"https://creativecommons.org/licenses/by-sa/4.0/legalcode","schemeUri":"https://spdx.org/licenses/","rights":"Creative Commons Attribution Share Alike 4.0 International","rightsIdentifier":"cc-by-sa-4.0"}],"descriptions":[{"descriptionType":"Abstract","description":"Why do some community-cooperation projects catalyse participation through durable, resilient collaboration networks while others result in negligible impact and leave the local social fabric unchanged? We argue outcomes hinge on participation architecture: simple, visible routines -- onboarding help, templated tasks, lightweight contribution/benefit tracking -- that create easy ``entry portals'' and route work across clusters without heavy hierarchy. We introduce Project Intervention Response Analysis (PIRA), a mixed anthropological-network-analysis framework that compares observed community networks with counterfactual networks absent from project-induced ties. PIRA also adds a new egocentric metric to detect ``architectural alters'' -- latent facilitators and boundary spanners. We begin validating PIRA in a three-month field study in Pomerini, Tanzania, where NGOs coordinated citizens, associations, and specialists. Findings indicate that sociotechnical participation architectures -- not charismatic hubs -- underwrite durable coordination. PIRA offers a reusable method to link organizational design mechanisms to formal network signatures."}],"geoLocations":[],"fundingReferences":[],"url":"https://arxiv.org/abs/2602.20009","contentUrl":null,"metadataVersion":0,"schemaVersion":"http://datacite.org/schema/kernel-4","source":"mds","isActive":true,"state":"findable","reason":null,"viewCount":0,"downloadCount":0,"referenceCount":0,"citationCount":0,"partCount":0,"partOfCount":0,"versionCount":0,"versionOfCount":0,"created":"2026-02-25T15:24:09Z","registered":"2026-02-25T15:24:09Z","published":null,"updated":"2026-02-25T15:24:09Z"},"relationships":{"client":{"data":{"id":"arxiv.content","type":"clients"}}}},{"id":"10.48550/arxiv.2602.20008","type":"dois","attributes":{"doi":"10.48550/arxiv.2602.20008","identifiers":[{"identifier":"2602.20008","identifierType":"arXiv"}],"creators":[{"nameType":"Personal","givenName":"Louis Fabrice","familyName":"Tshimanga","name":"Tshimanga, Louis Fabrice","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Andrea","familyName":"Zanola","name":"Zanola, Andrea","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Federico","familyName":"Del Pup","name":"Del Pup, Federico","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Manfredo","familyName":"Atzori","name":"Atzori, Manfredo","affiliation":[],"nameIdentifiers":[]}],"titles":[{"title":"Token-UNet: A New Case for Transformers Integration in Efficient and Interpretable 3D UNets for Brain Imaging Segmentation"}],"publisher":"arXiv","container":{},"publicationYear":2026,"subjects":[{"subject":"Computer Vision and Pattern Recognition (cs.CV)","lang":"en","subjectScheme":"arXiv"},{"subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"},{"schemeUri":"http://www.oecd.org/science/inno/38235147.pdf","subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"}],"contributors":[],"dates":[{"date":"2026-02-23T16:15:38Z","dateType":"Submitted","dateInformation":"v1"},{"date":"2026-02-24T02:37:07Z","dateType":"Updated","dateInformation":"v1"},{"date":"2026-02","dateType":"Available","dateInformation":"v1"},{"date":"2026","dateType":"Issued"}],"language":null,"types":{"schemaOrg":"CreativeWork","resourceTypeGeneral":"Preprint","citeproc":"article","bibtex":"misc","ris":"GEN","resourceType":"Article"},"relatedIdentifiers":[],"relatedItems":[],"sizes":[],"formats":[],"version":"1","rightsList":[{"rightsIdentifierScheme":"SPDX","rightsUri":"https://creativecommons.org/licenses/by/4.0/legalcode","schemeUri":"https://spdx.org/licenses/","rights":"Creative Commons Attribution 4.0 International","rightsIdentifier":"cc-by-4.0"}],"descriptions":[{"descriptionType":"Abstract","description":"We present Token-UNet, adopting the TokenLearner and TokenFuser modules to encase Transformers into UNets.\n While Transformers have enabled global interactions among input elements in medical imaging, current computational challenges hinder their deployment on common hardware. Models like (Swin)UNETR adapt the UNet architecture by incorporating (Swin)Transformer encoders, which process tokens that each represent small subvolumes ($8^3$ voxels) of the input.\n The Transformer attention mechanism scales quadratically with the number of tokens, which is tied to the cubic scaling of 3D input resolution.\n This work reconsiders the role of convolution and attention, introducing Token-UNets, a family of 3D segmentation models that can operate in constrained computational environments and time frames.\n To mitigate computational demands, our approach maintains the convolutional encoder of UNet-like models, and applies TokenLearner to 3D feature maps. This module pools a preset number of tokens from local and global structures.\n Our results show this tokenization effectively encodes task-relevant information, yielding naturally interpretable attention maps. The memory footprint, computation times at inference, and parameter counts of our heaviest model are reduced to 33\\%, 10\\%, and 35\\% of the SwinUNETR values, with better average performance (86.75\\% $\\pm 0.19\\%$ Dice score for SwinUNETR vs our 87.21\\% $\\pm 0.35\\%$).\n This work opens the way to more efficient trainings in contexts with limited computational resources, such as 3D medical imaging. Easing model optimization, fine-tuning, and transfer-learning in limited hardware settings can accelerate and diversify the development of approaches, for the benefit of the research community."}],"geoLocations":[],"fundingReferences":[],"url":"https://arxiv.org/abs/2602.20008","contentUrl":null,"metadataVersion":0,"schemaVersion":"http://datacite.org/schema/kernel-4","source":"mds","isActive":true,"state":"findable","reason":null,"viewCount":0,"downloadCount":0,"referenceCount":0,"citationCount":0,"partCount":0,"partOfCount":0,"versionCount":0,"versionOfCount":0,"created":"2026-02-25T15:24:06Z","registered":"2026-02-25T15:24:07Z","published":null,"updated":"2026-02-25T15:24:07Z"},"relationships":{"client":{"data":{"id":"arxiv.content","type":"clients"}}}},{"id":"10.48550/arxiv.2602.20004","type":"dois","attributes":{"doi":"10.48550/arxiv.2602.20004","identifiers":[{"identifier":"2602.20004","identifierType":"arXiv"}],"creators":[{"nameType":"Personal","givenName":"G. G.","familyName":"Luciano","name":"Luciano, G. G.","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"E. N.","familyName":"Saridakis","name":"Saridakis, E. N.","affiliation":[],"nameIdentifiers":[]}],"titles":[{"title":"New modified cosmology from a new generalized entropy"}],"publisher":"arXiv","container":{},"publicationYear":2026,"subjects":[{"subject":"General Relativity and Quantum Cosmology (gr-qc)","lang":"en","subjectScheme":"arXiv"},{"subject":"High Energy Physics - Theory (hep-th)","lang":"en","subjectScheme":"arXiv"},{"subject":"FOS: Physical sciences","subjectScheme":"Fields of Science and Technology (FOS)"},{"schemeUri":"http://www.oecd.org/science/inno/38235147.pdf","subject":"FOS: Physical sciences","subjectScheme":"Fields of Science and Technology (FOS)"}],"contributors":[],"dates":[{"date":"2026-02-23T16:12:12Z","dateType":"Submitted","dateInformation":"v1"},{"date":"2026-02-24T02:37:04Z","dateType":"Updated","dateInformation":"v1"},{"date":"2026-02","dateType":"Available","dateInformation":"v1"},{"date":"2026","dateType":"Issued"}],"language":null,"types":{"schemaOrg":"CreativeWork","resourceTypeGeneral":"Preprint","citeproc":"article","bibtex":"misc","ris":"GEN","resourceType":"Article"},"relatedIdentifiers":[],"relatedItems":[],"sizes":[],"formats":[],"version":"1","rightsList":[{"rightsIdentifierScheme":"SPDX","rightsUri":"https://creativecommons.org/licenses/by/4.0/legalcode","schemeUri":"https://spdx.org/licenses/","rights":"Creative Commons Attribution 4.0 International","rightsIdentifier":"cc-by-4.0"}],"descriptions":[{"descriptionType":"Abstract","description":"We develop new modified cosmological scenarios by applying the first law of thermodynamics at the Universe horizon, utilizing a new entropic functional that generalizes the standard Boltzmann-Gibbs-Shannon entropy. In particular, starting from the general theory of entropy in terms of the probability distribution over the accessible microstates, and by imposing violation of the separability requirement and thus considering a generalized microstate scaling, we result to a generalized entropy expression, which applied in systems with boundaries yields a generalized holographic-like area-law scaling with two exponents. Hence, incorporating it within the gravity-thermodynamics framework, we result to a modified cosmological scenario with additional terms, which eventually give rise to an effective dark energy sector. We extract analytical expressions for the dark energy density and equation-of-state parameters, and we show that the Universe experiences the usual thermal history, with the sequence of matter and dark-energy eras. Additionally, depending on the values of the entropic exponents, the dark energy can be quintessence-like, phantom-like or experience the phantom-divide crossing during its evolution, ultimately stabilizing at the cosmological constant value in the asymptotic far future, a behavior richer than other entropic modified cosmologies."},{"descriptionType":"Other","description":"13 pages, 6 figures"}],"geoLocations":[],"fundingReferences":[],"url":"https://arxiv.org/abs/2602.20004","contentUrl":null,"metadataVersion":0,"schemaVersion":"http://datacite.org/schema/kernel-4","source":"mds","isActive":true,"state":"findable","reason":null,"viewCount":0,"downloadCount":0,"referenceCount":0,"citationCount":0,"partCount":0,"partOfCount":0,"versionCount":0,"versionOfCount":0,"created":"2026-02-25T15:23:56Z","registered":"2026-02-25T15:23:57Z","published":null,"updated":"2026-02-25T15:23:57Z"},"relationships":{"client":{"data":{"id":"arxiv.content","type":"clients"}}}},{"id":"10.48550/arxiv.2602.20003","type":"dois","attributes":{"doi":"10.48550/arxiv.2602.20003","identifiers":[{"identifier":"2602.20003","identifierType":"arXiv"}],"creators":[{"nameType":"Personal","givenName":"Nuocheng","familyName":"Yang","name":"Yang, Nuocheng","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Sihua","familyName":"Wang","name":"Wang, Sihua","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Zhaohui","familyName":"Yang","name":"Yang, Zhaohui","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Mingzhe","familyName":"Chen","name":"Chen, Mingzhe","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Changchuan","familyName":"Yin","name":"Yin, Changchuan","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Kaibin","familyName":"Huang","name":"Huang, Kaibin","affiliation":[],"nameIdentifiers":[]}],"titles":[{"title":"A Secure and Private Distributed Bayesian Federated Learning Design"}],"publisher":"arXiv","container":{},"publicationYear":2026,"subjects":[{"subject":"Machine Learning (cs.LG)","lang":"en","subjectScheme":"arXiv"},{"subject":"Artificial Intelligence (cs.AI)","lang":"en","subjectScheme":"arXiv"},{"subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"},{"schemeUri":"http://www.oecd.org/science/inno/38235147.pdf","subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"}],"contributors":[],"dates":[{"date":"2026-02-23T16:12:02Z","dateType":"Submitted","dateInformation":"v1"},{"date":"2026-02-24T02:37:03Z","dateType":"Updated","dateInformation":"v1"},{"date":"2026-02","dateType":"Available","dateInformation":"v1"},{"date":"2026","dateType":"Issued"}],"language":null,"types":{"schemaOrg":"CreativeWork","resourceTypeGeneral":"Preprint","citeproc":"article","bibtex":"misc","ris":"GEN","resourceType":"Article"},"relatedIdentifiers":[],"relatedItems":[],"sizes":[],"formats":[],"version":"1","rightsList":[{"rightsUri":"http://arxiv.org/licenses/nonexclusive-distrib/1.0/","rights":"arXiv.org perpetual, non-exclusive license"}],"descriptions":[{"descriptionType":"Abstract","description":"Distributed Federated Learning (DFL) enables decentralized model training across large-scale systems without a central parameter server. However, DFL faces three critical challenges: privacy leakage from honest-but-curious neighbors, slow convergence due to the lack of central coordination, and vulnerability to Byzantine adversaries aiming to degrade model accuracy. To address these issues, we propose a novel DFL framework that integrates Byzantine robustness, privacy preservation, and convergence acceleration. Within this framework, each device trains a local model using a Bayesian approach and independently selects an optimal subset of neighbors for posterior exchange. We formulate this neighbor selection as an optimization problem to minimize the global loss function under security and privacy constraints. Solving this problem is challenging because devices only possess partial network information, and the complex coupling between topology, security, and convergence remains unclear. To bridge this gap, we first analytically characterize the trade-offs between dynamic connectivity, Byzantine detection, privacy levels, and convergence speed. Leveraging these insights, we develop a fully distributed Graph Neural Network (GNN)-based Reinforcement Learning (RL) algorithm. This approach enables devices to make autonomous connection decisions based on local observations. Simulation results demonstrate that our method achieves superior robustness and efficiency with significantly lower overhead compared to traditional security and privacy schemes."},{"descriptionType":"Other","description":"14 pages, 9 figures"}],"geoLocations":[],"fundingReferences":[],"url":"https://arxiv.org/abs/2602.20003","contentUrl":null,"metadataVersion":0,"schemaVersion":"http://datacite.org/schema/kernel-4","source":"mds","isActive":true,"state":"findable","reason":null,"viewCount":0,"downloadCount":0,"referenceCount":0,"citationCount":0,"partCount":0,"partOfCount":0,"versionCount":0,"versionOfCount":0,"created":"2026-02-25T15:23:54Z","registered":"2026-02-25T15:23:55Z","published":null,"updated":"2026-02-25T15:23:55Z"},"relationships":{"client":{"data":{"id":"arxiv.content","type":"clients"}}}},{"id":"10.48550/arxiv.2602.20001","type":"dois","attributes":{"doi":"10.48550/arxiv.2602.20001","identifiers":[{"identifier":"2602.20001","identifierType":"arXiv"}],"creators":[{"nameType":"Personal","givenName":"Xianquan","familyName":"Wang","name":"Wang, Xianquan","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Zhaocheng","familyName":"Du","name":"Du, Zhaocheng","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Jieming","familyName":"Zhu","name":"Zhu, Jieming","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Qinglin","familyName":"Jia","name":"Jia, Qinglin","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Zhenhua","familyName":"Dong","name":"Dong, Zhenhua","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Kai","familyName":"Zhang","name":"Zhang, Kai","affiliation":[],"nameIdentifiers":[]}],"titles":[{"title":"FairFS: Addressing Deep Feature Selection Biases for Recommender System"}],"publisher":"arXiv","container":{},"publicationYear":2026,"subjects":[{"subject":"Information Retrieval (cs.IR)","lang":"en","subjectScheme":"arXiv"},{"subject":"Machine Learning (cs.LG)","lang":"en","subjectScheme":"arXiv"},{"subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"},{"schemeUri":"http://www.oecd.org/science/inno/38235147.pdf","subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"}],"contributors":[],"dates":[{"date":"2026-02-23T16:08:32Z","dateType":"Submitted","dateInformation":"v1"},{"date":"2026-02-24T02:36:37Z","dateType":"Updated","dateInformation":"v1"},{"date":"2026-02","dateType":"Available","dateInformation":"v1"},{"date":"2026","dateType":"Issued"}],"language":null,"types":{"schemaOrg":"CreativeWork","resourceTypeGeneral":"Preprint","citeproc":"article","bibtex":"misc","ris":"GEN","resourceType":"Article"},"relatedIdentifiers":[{"relationType":"IsVersionOf","relatedIdentifier":"10.1145/3774904.3792167","relatedIdentifierType":"DOI"}],"relatedItems":[],"sizes":[],"formats":[],"version":"1","rightsList":[{"rightsIdentifierScheme":"SPDX","rightsUri":"https://creativecommons.org/licenses/by/4.0/legalcode","schemeUri":"https://spdx.org/licenses/","rights":"Creative Commons Attribution 4.0 International","rightsIdentifier":"cc-by-4.0"}],"descriptions":[{"descriptionType":"Abstract","description":"Large-scale online marketplaces and recommender systems serve as critical technological support for e-commerce development. In industrial recommender systems, features play vital roles as they carry information for downstream models. Accurate feature importance estimation is critical because it helps identify the most useful feature subsets from thousands of feature candidates for online services. Such selection enables improved online performance while reducing computational cost. To address feature selection problems in deep learning, trainable gate-based and sensitivity-based methods have been proposed and proven effective in industrial practice. However, through the analysis of real-world cases, we identified three bias issues that cause feature importance estimation to rely on partial model layers, samples, or gradients, ultimately leading to inaccurate importance estimation. We refer to these as layer bias, baseline bias, and approximation bias. To mitigate these issues, we propose FairFS, a fair and accurate feature selection algorithm. FairFS regularizes feature importance estimated across all nonlinear transformation layers to address layer bias. It also introduces a smooth baseline feature close to the classifier decision boundary and adopts an aggregated approximation method to alleviate baseline and approximation biases. Extensive experiments demonstrate that FairFS effectively mitigates these biases and achieves state-of-the-art feature selection performance."},{"descriptionType":"Other","description":"Accepted by The Web Conference 2026"}],"geoLocations":[],"fundingReferences":[],"url":"https://arxiv.org/abs/2602.20001","contentUrl":null,"metadataVersion":0,"schemaVersion":"http://datacite.org/schema/kernel-4","source":"mds","isActive":true,"state":"findable","reason":null,"viewCount":0,"downloadCount":0,"referenceCount":0,"citationCount":0,"partCount":0,"partOfCount":0,"versionCount":0,"versionOfCount":1,"created":"2026-02-25T15:23:49Z","registered":"2026-02-25T15:23:49Z","published":null,"updated":"2026-02-25T15:23:49Z"},"relationships":{"client":{"data":{"id":"arxiv.content","type":"clients"}}}},{"id":"10.48550/arxiv.2602.20000","type":"dois","attributes":{"doi":"10.48550/arxiv.2602.20000","identifiers":[{"identifier":"2602.20000","identifierType":"arXiv"}],"creators":[{"nameType":"Personal","givenName":"Jesper","familyName":"Glückstad","name":"Glückstad, Jesper","affiliation":[],"nameIdentifiers":[]}],"titles":[{"title":"Gabor Holography Reinvented"}],"publisher":"arXiv","container":{},"publicationYear":2026,"subjects":[{"subject":"Optics (physics.optics)","lang":"en","subjectScheme":"arXiv"},{"subject":"FOS: Physical sciences","subjectScheme":"Fields of Science and Technology (FOS)"},{"schemeUri":"http://www.oecd.org/science/inno/38235147.pdf","subject":"FOS: Physical sciences","subjectScheme":"Fields of Science and Technology (FOS)"}],"contributors":[],"dates":[{"date":"2026-02-23T16:04:54Z","dateType":"Submitted","dateInformation":"v1"},{"date":"2026-02-24T02:36:29Z","dateType":"Updated","dateInformation":"v1"},{"date":"2026-02","dateType":"Available","dateInformation":"v1"},{"date":"2026","dateType":"Issued"}],"language":null,"types":{"schemaOrg":"CreativeWork","resourceTypeGeneral":"Preprint","citeproc":"article","bibtex":"misc","ris":"GEN","resourceType":"Article"},"relatedIdentifiers":[],"relatedItems":[],"sizes":[],"formats":[],"version":"1","rightsList":[{"rightsIdentifierScheme":"SPDX","rightsUri":"https://creativecommons.org/licenses/by/4.0/legalcode","schemeUri":"https://spdx.org/licenses/","rights":"Creative Commons Attribution 4.0 International","rightsIdentifier":"cc-by-4.0"}],"descriptions":[{"descriptionType":"Abstract","description":"This paper presents a \"reinvention\" of Gabor Holography that does not suffer optically from the inherent twin-image problem originating back to Gabor's original Nobel Prize awarded invention. In-line or on-axis holography was ironically abandoned by its inventor Dennis Gabor himself and was effectively completely \"re-placed\" by so-called off-axis holography at the time when Gabor received the Nobel Prize in Physics in 1971. However, Gabor Holography is today the method of choice in modern digital holography due to its inherent on-axis, common-path robustness, lower requirements to resolution of the image sensor (or recording material), shorter exposure time, relaxed mechanical stability and temporal coherence requirements. However, it still inherently suffers from the aforementioned twin-image problem and, hence, one will find an abundance of papers trying to overcome this challenge by iterative phase retrieval or machine learning based approaches. Gabor Holography Reinvented overcomes this long-lasting twin-image problem for the first time by optical means."},{"descriptionType":"Other","description":"14 pages, 7 figures"}],"geoLocations":[],"fundingReferences":[],"url":"https://arxiv.org/abs/2602.20000","contentUrl":null,"metadataVersion":0,"schemaVersion":"http://datacite.org/schema/kernel-4","source":"mds","isActive":true,"state":"findable","reason":null,"viewCount":0,"downloadCount":0,"referenceCount":0,"citationCount":0,"partCount":0,"partOfCount":0,"versionCount":0,"versionOfCount":0,"created":"2026-02-25T15:23:46Z","registered":"2026-02-25T15:23:47Z","published":null,"updated":"2026-02-25T15:23:47Z"},"relationships":{"client":{"data":{"id":"arxiv.content","type":"clients"}}}},{"id":"10.48550/arxiv.2602.19999","type":"dois","attributes":{"doi":"10.48550/arxiv.2602.19999","identifiers":[{"identifier":"2602.19999","identifierType":"arXiv"}],"creators":[{"nameType":"Personal","givenName":"Zhihao","familyName":"Lu","name":"Lu, Zhihao","affiliation":[],"nameIdentifiers":[]}],"titles":[{"title":"Global and local properties of solutions of elliptic equations with a nonlinear term involving the product of the function and its gradient"}],"publisher":"arXiv","container":{},"publicationYear":2026,"subjects":[{"subject":"Analysis of PDEs (math.AP)","lang":"en","subjectScheme":"arXiv"},{"subject":"FOS: Mathematics","subjectScheme":"Fields of Science and Technology (FOS)"},{"schemeUri":"http://www.oecd.org/science/inno/38235147.pdf","subject":"FOS: Mathematics","subjectScheme":"Fields of Science and Technology (FOS)"},{"subject":"Primary: 35J62, 35B08, 35B09, Secondary: 35A23, 58J05","lang":"en","subjectScheme":"MSC"}],"contributors":[],"dates":[{"date":"2026-02-23T16:03:42Z","dateType":"Submitted","dateInformation":"v1"},{"date":"2026-02-24T02:36:27Z","dateType":"Updated","dateInformation":"v1"},{"date":"2026-02","dateType":"Available","dateInformation":"v1"},{"date":"2026","dateType":"Issued"}],"language":null,"types":{"schemaOrg":"CreativeWork","resourceTypeGeneral":"Preprint","citeproc":"article","bibtex":"misc","ris":"GEN","resourceType":"Article"},"relatedIdentifiers":[],"relatedItems":[],"sizes":[],"formats":[],"version":"1","rightsList":[{"rightsUri":"http://arxiv.org/licenses/nonexclusive-distrib/1.0/","rights":"arXiv.org perpetual, non-exclusive license"}],"descriptions":[{"descriptionType":"Abstract","description":"We study the global and local properties of positive solutions to the quasi-linear elliptic equation:\n \\d u+|\\nabla u|^q u^p=0,\\quad x\\in Ø\\subset \\mathbb{R}^n,\\nonumber where $q\\ge 0$ and $p\\in\\mathbb{R}$. Our contributions are twofold: \n 1. Based on an optimal and new identity for the modulus squared of the logarithmic gradient, we establish optimal and improved Liouville theorems for global positive solutions, and generalize these findings to the framework of Riemannian manifolds.\n 2. Based on a newly discovered mutual control relationship of two nonlinear iterms, for all index pairs \\( (p, q) \\) where the Liouville theorem holds, we derive several optimal gradient estimates for local positive solutions. As a direct corollary, we obtain the corresponding Harnack inequality.\n These results strengthen the related conclusions in Bidaut-Véron--García-Huidobro--Véron \\cite {BGV} from both global and local perspectives."},{"descriptionType":"Other","description":"88 pages, 15 figures. We welcome any suggestions and comments"}],"geoLocations":[],"fundingReferences":[],"url":"https://arxiv.org/abs/2602.19999","contentUrl":null,"metadataVersion":0,"schemaVersion":"http://datacite.org/schema/kernel-4","source":"mds","isActive":true,"state":"findable","reason":null,"viewCount":0,"downloadCount":0,"referenceCount":0,"citationCount":0,"partCount":0,"partOfCount":0,"versionCount":0,"versionOfCount":0,"created":"2026-02-25T15:23:44Z","registered":"2026-02-25T15:23:45Z","published":null,"updated":"2026-02-25T15:23:45Z"},"relationships":{"client":{"data":{"id":"arxiv.content","type":"clients"}}}},{"id":"10.48550/arxiv.2602.19998","type":"dois","attributes":{"doi":"10.48550/arxiv.2602.19998","identifiers":[{"identifier":"2602.19998","identifierType":"arXiv"}],"creators":[{"nameType":"Personal","givenName":"Angela Sara","familyName":"Cacciapuoti","name":"Cacciapuoti, Angela Sara","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Marcello","familyName":"Caleffi","name":"Caleffi, Marcello","affiliation":[],"nameIdentifiers":[]}],"titles":[{"title":"A Quantum Internet Protocol Suite Beyond Layering"}],"publisher":"arXiv","container":{},"publicationYear":2026,"subjects":[{"subject":"Quantum Physics (quant-ph)","lang":"en","subjectScheme":"arXiv"},{"subject":"Networking and Internet Architecture (cs.NI)","lang":"en","subjectScheme":"arXiv"},{"subject":"FOS: Physical sciences","subjectScheme":"Fields of Science and Technology (FOS)"},{"schemeUri":"http://www.oecd.org/science/inno/38235147.pdf","subject":"FOS: Physical sciences","subjectScheme":"Fields of Science and Technology (FOS)"},{"subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"},{"schemeUri":"http://www.oecd.org/science/inno/38235147.pdf","subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"}],"contributors":[],"dates":[{"date":"2026-02-23T16:03:30Z","dateType":"Submitted","dateInformation":"v1"},{"date":"2026-02-24T02:36:26Z","dateType":"Updated","dateInformation":"v1"},{"date":"2026-02","dateType":"Available","dateInformation":"v1"},{"date":"2026","dateType":"Issued"}],"language":null,"types":{"schemaOrg":"CreativeWork","resourceTypeGeneral":"Preprint","citeproc":"article","bibtex":"misc","ris":"GEN","resourceType":"Article"},"relatedIdentifiers":[],"relatedItems":[],"sizes":[],"formats":[],"version":"1","rightsList":[{"rightsIdentifierScheme":"SPDX","rightsUri":"https://creativecommons.org/licenses/by/4.0/legalcode","schemeUri":"https://spdx.org/licenses/","rights":"Creative Commons Attribution 4.0 International","rightsIdentifier":"cc-by-4.0"}],"descriptions":[{"descriptionType":"Abstract","description":"Layering, the protocol organization principle underpinning the classical Internet, is ill-suited to the Quantum Internet, built around entanglement, which is non-local and stateful. This paper proposes a quantum-native organizational principle based on dynamic composition, which replaces static layering with a distributed orchestration fabric driven by the node local state and in-band control. Each node runs a Dynamic Kernel that i) constructs a local PoA of candidate steps to advance a service intent, and ii) executes the PoA by composing atomic micro-protocols into context-aware procedures (the meta-protocols). Quantum packets carry an in-band control-field (the meta-header) containing the service intent and an append-only list of action-commit records, termed as stamps. Successive nodes exploit this minimal, authoritative history to construct their local PoAs. As quantum packets progress, these local commits collectively induce a network-wide, direct acyclic graph that certifies end-to-end service fulfillment, without requiring global synchronization. In contrast to classical encapsulation, the proposed suite enforces order by certification: dependency-aware local scheduling decides what may run at a certain node, stamps certify what did run and constrain subsequent planning. By embedding procedural control within the quantum packet, the design ensures coherence and consistency between entanglement-state evolution and control-flow, preventing divergence between resource state ad protocol logic, while remaining MP-agnostic and implementation-decoupled. The resulting suite is modular, adaptable to entanglement dynamics, and scalable. It operates correctly with or without optional control-plane hints. Indeed, when present, hints can steer QoS policies, without changing semantics. We argue that dynamic composition is the organizing principle required for a truly quantum-native Internet."},{"descriptionType":"Other","description":"This work has been funded by the European Union under Horizon Europe ERC-CoG grant QNattyNet (\"Quantum-Native Communication Networks: from Quantum Message to Quantum Functioning\"), n.101169850. Details at https://qnattynet.quantuminternet.it"}],"geoLocations":[],"fundingReferences":[],"url":"https://arxiv.org/abs/2602.19998","contentUrl":null,"metadataVersion":0,"schemaVersion":"http://datacite.org/schema/kernel-4","source":"mds","isActive":true,"state":"findable","reason":null,"viewCount":0,"downloadCount":0,"referenceCount":0,"citationCount":0,"partCount":0,"partOfCount":0,"versionCount":0,"versionOfCount":0,"created":"2026-02-25T15:23:41Z","registered":"2026-02-25T15:23:42Z","published":null,"updated":"2026-02-25T15:23:42Z"},"relationships":{"client":{"data":{"id":"arxiv.content","type":"clients"}}}},{"id":"10.48550/arxiv.2602.19995","type":"dois","attributes":{"doi":"10.48550/arxiv.2602.19995","identifiers":[{"identifier":"2602.19995","identifierType":"arXiv"}],"creators":[{"nameType":"Personal","givenName":"Bin-Hui","familyName":"Chen","name":"Chen, Bin-Hui","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Juntai","familyName":"Shen","name":"Shen, Juntai","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Paola","familyName":"Di Matteo","name":"Di Matteo, Paola","affiliation":[],"nameIdentifiers":[]}],"titles":[{"title":"Bar Formation During a Gaia-Sausage-Enceladus-like Merger Event"}],"publisher":"arXiv","container":{},"publicationYear":2026,"subjects":[{"subject":"Astrophysics of Galaxies (astro-ph.GA)","lang":"en","subjectScheme":"arXiv"},{"subject":"FOS: Physical sciences","subjectScheme":"Fields of Science and Technology (FOS)"},{"schemeUri":"http://www.oecd.org/science/inno/38235147.pdf","subject":"FOS: Physical sciences","subjectScheme":"Fields of Science and Technology (FOS)"}],"contributors":[],"dates":[{"date":"2026-02-23T16:02:52Z","dateType":"Submitted","dateInformation":"v1"},{"date":"2026-02-24T02:36:18Z","dateType":"Updated","dateInformation":"v1"},{"date":"2026-02","dateType":"Available","dateInformation":"v1"},{"date":"2026","dateType":"Issued"}],"language":null,"types":{"schemaOrg":"CreativeWork","resourceTypeGeneral":"Preprint","citeproc":"article","bibtex":"misc","ris":"GEN","resourceType":"Article"},"relatedIdentifiers":[],"relatedItems":[],"sizes":[],"formats":[],"version":"1","rightsList":[{"rightsUri":"http://arxiv.org/licenses/nonexclusive-distrib/1.0/","rights":"arXiv.org perpetual, non-exclusive license"}],"descriptions":[{"descriptionType":"Abstract","description":"Bars are among the most prominent galactic structures, yet their formation mechanisms remain incompletely understood. They can form either internally, via dynamical instabilities, or externally, triggered by interactions with other galaxies. The impact of mergers on bar formation and survival, however, has not been thoroughly investigated. To explore the influence of mergers on bars, we construct a suite of \\textit{N}-body merger pairs where a Gaia-Sausage-Enceladus-like radially biased satellite disk galaxy merges with a central disk galaxy during its bar formation. With the central galaxy fixed, the satellite varies in merger parameters: the mass ratio $m/M$ relative to the central galaxy, the impact parameter $b$, and the orbital inclination angle $θ_i$ relative to the central disk. We find that the bar survival probability decreases with increasing $m/M$. Mergers with $m/M\\lesssim1/10$ generally preserve the forming bar, whereas those with ${m/M}\\geq1/2$ tend to destroy it, producing more early-type-like remnants. For intermediate mass ratios ($1/5 \\leq m/M \\leq 1/3$), several models yield ``weakening bars'', in which the bar survives the merger but gradually decays during subsequent secular evolution, possibly due to interactions between nested double bars formed from merger debris. In contrast to $m/M$, $b$ and $θ_i$ have only secondary and stochastic effects on bar survival. The different influences of these three merger parameters can be naturally explained by the tidal force exerted by the satellite on the forming bar, which tends to weaken the bar when the satellite crosses it nearly perpendicular to its major axis."},{"descriptionType":"Other","description":"14 pages, 8 figures, accepted for publication on ApJ"}],"geoLocations":[],"fundingReferences":[],"url":"https://arxiv.org/abs/2602.19995","contentUrl":null,"metadataVersion":0,"schemaVersion":"http://datacite.org/schema/kernel-4","source":"mds","isActive":true,"state":"findable","reason":null,"viewCount":0,"downloadCount":0,"referenceCount":0,"citationCount":0,"partCount":0,"partOfCount":0,"versionCount":0,"versionOfCount":0,"created":"2026-02-25T15:23:34Z","registered":"2026-02-25T15:23:35Z","published":null,"updated":"2026-02-25T15:23:35Z"},"relationships":{"client":{"data":{"id":"arxiv.content","type":"clients"}}}},{"id":"10.48550/arxiv.2602.19994","type":"dois","attributes":{"doi":"10.48550/arxiv.2602.19994","identifiers":[{"identifier":"2602.19994","identifierType":"arXiv"}],"creators":[{"nameType":"Personal","givenName":"Christof","familyName":"Leitgeb","name":"Leitgeb, Christof","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Thomas","familyName":"Puchleitner","name":"Puchleitner, Thomas","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Max Peter","familyName":"Ronecker","name":"Ronecker, Max Peter","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Daniel","familyName":"Watzenig","name":"Watzenig, Daniel","affiliation":[],"nameIdentifiers":[]}],"titles":[{"title":"RADE-Net: Robust Attention Network for Radar-Only Object Detection in Adverse Weather"}],"publisher":"arXiv","container":{},"publicationYear":2026,"subjects":[{"subject":"Computer Vision and Pattern Recognition (cs.CV)","lang":"en","subjectScheme":"arXiv"},{"subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"},{"schemeUri":"http://www.oecd.org/science/inno/38235147.pdf","subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"}],"contributors":[],"dates":[{"date":"2026-02-23T16:01:31Z","dateType":"Submitted","dateInformation":"v1"},{"date":"2026-02-24T02:36:09Z","dateType":"Updated","dateInformation":"v1"},{"date":"2026-02","dateType":"Available","dateInformation":"v1"},{"date":"2026","dateType":"Issued"}],"language":null,"types":{"schemaOrg":"CreativeWork","resourceTypeGeneral":"Preprint","citeproc":"article","bibtex":"misc","ris":"GEN","resourceType":"Article"},"relatedIdentifiers":[],"relatedItems":[],"sizes":[],"formats":[],"version":"1","rightsList":[{"rightsUri":"http://arxiv.org/licenses/nonexclusive-distrib/1.0/","rights":"arXiv.org perpetual, non-exclusive license"}],"descriptions":[{"descriptionType":"Abstract","description":"Automotive perception systems are obligated to meet high requirements. While optical sensors such as Camera and Lidar struggle in adverse weather conditions, Radar provides a more robust perception performance, effectively penetrating fog, rain, and snow. Since full Radar tensors have large data sizes and very few datasets provide them, most Radar-based approaches work with sparse point clouds or 2D projections, which can result in information loss. Additionally, deep learning methods show potential to extract richer and more dense features from low level Radar data and therefore significantly increase the perception performance. Therefore, we propose a 3D projection method for fast-Fourier-transformed 4D Range-Azimuth-Doppler-Elevation (RADE) tensors. Our method preserves rich Doppler and Elevation features while reducing the required data size for a single frame by 91.9% compared to a full tensor, thus achieving higher training and inference speed as well as lower model complexity. We introduce RADE-Net, a lightweight model tailored to 3D projections of the RADE tensor. The backbone enables exploitation of low-level and high-level cues of Radar tensors with spatial and channel-attention. The decoupled detection heads predict object center-points directly in the Range-Azimuth domain and regress rotated 3D bounding boxes from rich feature maps in the cartesian scene. We evaluate the model on scenes with multiple different road users and under various weather conditions on the large-scale K-Radar dataset and achieve a 16.7% improvement compared to their baseline, as well as 6.5% improvement over current Radar-only models. Additionally, we outperform several Lidar approaches in scenarios with adverse weather conditions. The code is available under https://github.com/chr-is-tof/RADE-Net."},{"descriptionType":"Other","description":"Accepted to 2026 IEEE Intelligent Vehicles Symposium (IV)"}],"geoLocations":[],"fundingReferences":[],"url":"https://arxiv.org/abs/2602.19994","contentUrl":null,"metadataVersion":0,"schemaVersion":"http://datacite.org/schema/kernel-4","source":"mds","isActive":true,"state":"findable","reason":null,"viewCount":0,"downloadCount":0,"referenceCount":0,"citationCount":0,"partCount":0,"partOfCount":0,"versionCount":0,"versionOfCount":0,"created":"2026-02-25T15:23:32Z","registered":"2026-02-25T15:23:32Z","published":null,"updated":"2026-02-25T15:23:32Z"},"relationships":{"client":{"data":{"id":"arxiv.content","type":"clients"}}}},{"id":"10.48550/arxiv.2602.19993","type":"dois","attributes":{"doi":"10.48550/arxiv.2602.19993","identifiers":[{"identifier":"2602.19993","identifierType":"arXiv"}],"creators":[{"nameType":"Personal","givenName":"Roderich","familyName":"Tumulka","name":"Tumulka, Roderich","affiliation":[],"nameIdentifiers":[]}],"titles":[{"title":"GAP Measures and Wave Function Collapse"}],"publisher":"arXiv","container":{},"publicationYear":2026,"subjects":[{"subject":"Quantum Physics (quant-ph)","lang":"en","subjectScheme":"arXiv"},{"subject":"Mathematical Physics (math-ph)","lang":"en","subjectScheme":"arXiv"},{"subject":"FOS: Physical sciences","subjectScheme":"Fields of Science and Technology (FOS)"},{"schemeUri":"http://www.oecd.org/science/inno/38235147.pdf","subject":"FOS: Physical sciences","subjectScheme":"Fields of Science and Technology (FOS)"}],"contributors":[],"dates":[{"date":"2026-02-23T16:00:49Z","dateType":"Submitted","dateInformation":"v1"},{"date":"2026-02-24T02:36:07Z","dateType":"Updated","dateInformation":"v1"},{"date":"2026-02","dateType":"Available","dateInformation":"v1"},{"date":"2026","dateType":"Issued"}],"language":null,"types":{"schemaOrg":"CreativeWork","resourceTypeGeneral":"Preprint","citeproc":"article","bibtex":"misc","ris":"GEN","resourceType":"Article"},"relatedIdentifiers":[],"relatedItems":[],"sizes":[],"formats":[],"version":"1","rightsList":[{"rightsUri":"http://arxiv.org/licenses/nonexclusive-distrib/1.0/","rights":"arXiv.org perpetual, non-exclusive license"}],"descriptions":[{"descriptionType":"Abstract","description":"GAP measures (also known as Scrooge measures) are a natural class of probability distributions on the unit sphere of a Hilbert space that come up in quantum statistical mechanics; for each density matrix $ρ$ there is a unique measure GAP$_ρ$. We describe and prove a property of these measures that was not recognized so far: If a wave function $Ψ$ is GAP$_ρ$ distributed and a collapse occurs, then the collapsed wave function $Ψ'$ is again GAP distributed (relative to the appropriate $ρ'$). This fact applies to collapses due to a quantum measurement carried out by an observer, as well as to spontaneous collapse theories such as CSL or GRW. More precisely, it is the conditional distribution of $Ψ'$, given the measurement outcome (respectively, the noise in CSL or the collapse history in GRW), that is GAP$_{ρ'}$."},{"descriptionType":"Other","description":"9 pages LaTeX, no figures"}],"geoLocations":[],"fundingReferences":[],"url":"https://arxiv.org/abs/2602.19993","contentUrl":null,"metadataVersion":0,"schemaVersion":"http://datacite.org/schema/kernel-4","source":"mds","isActive":true,"state":"findable","reason":null,"viewCount":0,"downloadCount":0,"referenceCount":0,"citationCount":0,"partCount":0,"partOfCount":0,"versionCount":0,"versionOfCount":0,"created":"2026-02-25T15:23:29Z","registered":"2026-02-25T15:23:30Z","published":null,"updated":"2026-02-25T15:23:30Z"},"relationships":{"client":{"data":{"id":"arxiv.content","type":"clients"}}}},{"id":"10.48550/arxiv.2602.19992","type":"dois","attributes":{"doi":"10.48550/arxiv.2602.19992","identifiers":[{"identifier":"2602.19992","identifierType":"arXiv"}],"creators":[{"nameType":"Personal","givenName":"Eszter","familyName":"Lakics","name":"Lakics, Eszter","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Mónika","familyName":"Valiskó","name":"Valiskó, Mónika","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Dirk","familyName":"Gillespie","name":"Gillespie, Dirk","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Dezső","familyName":"Boda","name":"Boda, Dezső","affiliation":[],"nameIdentifiers":[]}],"titles":[{"title":"The interplay of cation/anion and monovalent/divalent selectivity in negatively charged nanopores: local charge inversion and anion leakage"}],"publisher":"arXiv","container":{},"publicationYear":2026,"subjects":[{"subject":"Mesoscale and Nanoscale Physics (cond-mat.mes-hall)","lang":"en","subjectScheme":"arXiv"},{"subject":"Statistical Mechanics (cond-mat.stat-mech)","lang":"en","subjectScheme":"arXiv"},{"subject":"Chemical Physics (physics.chem-ph)","lang":"en","subjectScheme":"arXiv"},{"subject":"FOS: Physical sciences","subjectScheme":"Fields of Science and Technology (FOS)"},{"schemeUri":"http://www.oecd.org/science/inno/38235147.pdf","subject":"FOS: Physical sciences","subjectScheme":"Fields of Science and Technology (FOS)"}],"contributors":[],"dates":[{"date":"2026-02-23T15:59:00Z","dateType":"Submitted","dateInformation":"v1"},{"date":"2026-02-24T02:36:01Z","dateType":"Updated","dateInformation":"v1"},{"date":"2026-02","dateType":"Available","dateInformation":"v1"},{"date":"2026","dateType":"Issued"}],"language":null,"types":{"schemaOrg":"CreativeWork","resourceTypeGeneral":"Preprint","citeproc":"article","bibtex":"misc","ris":"GEN","resourceType":"Article"},"relatedIdentifiers":[],"relatedItems":[],"sizes":[],"formats":[],"version":"1","rightsList":[{"rightsIdentifierScheme":"SPDX","rightsUri":"https://creativecommons.org/licenses/by/4.0/legalcode","schemeUri":"https://spdx.org/licenses/","rights":"Creative Commons Attribution 4.0 International","rightsIdentifier":"cc-by-4.0"}],"descriptions":[{"descriptionType":"Abstract","description":"The anomalous mole fraction effect (AMFE) is widely regarded as a hallmark of calcium versus monovalent ion selectivity in negatively charged pores. While AMFE is well understood in highly cation-selective narrow ion channels, its microscopic origin in wide synthetic nanopores, where anions may also contribute to transport, remains less clear. Here, we use a reduced Nernst-Planck + Local Equilibrium Monte Carlo framework to study ionic transport in a negatively charged PET nanopore, with particular emphasis on how the modeling of surface carboxyl (COO$^{-}$) groups influences charge inversion, ionic currents, and AMFE. We systematically compare fixed point-charge models and explicit-particle representations of surface oxygens and identify two controlling parameters: the distance of closest approach (DCA) between ionic charges and pore charges and grid spacing that modulates localization (while keeping average surface charge constant). By fitting pore diffusion coefficients to three experimental conductance points, we reproduce the entire experimental AMFE curve as well as anion leakage in CaCl$_2$ seen in experiments and molecular dynamics simulations. Remarkably, vastly different microscopic models of the surface groups yield indistinguishable device-level conductance curves when the DCA is matched, despite substantial differences in local Ca$^{2+}$ concentration profiles. Our results demonstrate that AMFE in wide nanopores is governed by a delicate interplay between charge inversion, anion leakage, and ionic mobility, underlying that in wide pores monovalent vs.\\ divalent cation selectivity is modulated by cations vs.\\ anion selecivity."}],"geoLocations":[],"fundingReferences":[],"url":"https://arxiv.org/abs/2602.19992","contentUrl":null,"metadataVersion":0,"schemaVersion":"http://datacite.org/schema/kernel-4","source":"mds","isActive":true,"state":"findable","reason":null,"viewCount":0,"downloadCount":0,"referenceCount":0,"citationCount":0,"partCount":0,"partOfCount":0,"versionCount":0,"versionOfCount":0,"created":"2026-02-25T15:23:27Z","registered":"2026-02-25T15:23:27Z","published":null,"updated":"2026-02-25T15:23:27Z"},"relationships":{"client":{"data":{"id":"arxiv.content","type":"clients"}}}},{"id":"10.48550/arxiv.2602.19990","type":"dois","attributes":{"doi":"10.48550/arxiv.2602.19990","identifiers":[{"identifier":"2602.19990","identifierType":"arXiv"}],"creators":[{"nameType":"Personal","givenName":"Monica Marconi","familyName":"Sciarroni","name":"Sciarroni, Monica Marconi","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Emanuele","familyName":"Storti","name":"Storti, Emanuele","affiliation":[],"nameIdentifiers":[]}],"titles":[{"title":"A Context-Aware Knowledge Graph Platform for Stream Processing in Industrial IoT"}],"publisher":"arXiv","container":{},"publicationYear":2026,"subjects":[{"subject":"Databases (cs.DB)","lang":"en","subjectScheme":"arXiv"},{"subject":"Distributed, Parallel, and Cluster Computing (cs.DC)","lang":"en","subjectScheme":"arXiv"},{"subject":"Information Retrieval (cs.IR)","lang":"en","subjectScheme":"arXiv"},{"subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"},{"schemeUri":"http://www.oecd.org/science/inno/38235147.pdf","subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"}],"contributors":[],"dates":[{"date":"2026-02-23T15:55:32Z","dateType":"Submitted","dateInformation":"v1"},{"date":"2026-02-24T02:35:49Z","dateType":"Updated","dateInformation":"v1"},{"date":"2026-02","dateType":"Available","dateInformation":"v1"},{"date":"2026","dateType":"Issued"}],"language":null,"types":{"schemaOrg":"CreativeWork","resourceTypeGeneral":"Preprint","citeproc":"article","bibtex":"misc","ris":"GEN","resourceType":"Article"},"relatedIdentifiers":[],"relatedItems":[],"sizes":[],"formats":[],"version":"1","rightsList":[{"rightsIdentifierScheme":"SPDX","rightsUri":"https://creativecommons.org/licenses/by-sa/4.0/legalcode","schemeUri":"https://spdx.org/licenses/","rights":"Creative Commons Attribution Share Alike 4.0 International","rightsIdentifier":"cc-by-sa-4.0"}],"descriptions":[{"descriptionType":"Abstract","description":"Industrial IoT ecosystems bring together sensors, machines and smart devices operating collaboratively across industrial environments. These systems generate large volumes of heterogeneous, high-velocity data streams that require interoperable, secure and contextually aware management. Most of the current stream management architectures, however, still rely on syntactic integration mechanisms, which result in limited flexibility, maintainability and interpretability in complex Industry 5.0 scenarios. This work proposes a context-aware semantic platform for data stream management that unifies heterogeneous IoT/IoE data sources through a Knowledge Graph enabling formal representation of devices, streams, agents, transformation pipelines, roles and rights. The model supports flexible data gathering, composable stream processing pipelines, and dynamic role-based data access based on agents' contexts, relying on Apache Kafka and Apache Flink for real-time processing, while SPARQL and SWRL-based reasoning provide context-dependent stream discovery. Experimental evaluations demonstrate the effectiveness of combining semantic models, context-aware reasoning and distributed stream processing to enable interoperable data workflows for Industry 5.0 environments."}],"geoLocations":[],"fundingReferences":[],"url":"https://arxiv.org/abs/2602.19990","contentUrl":null,"metadataVersion":0,"schemaVersion":"http://datacite.org/schema/kernel-4","source":"mds","isActive":true,"state":"findable","reason":null,"viewCount":0,"downloadCount":0,"referenceCount":0,"citationCount":0,"partCount":0,"partOfCount":0,"versionCount":0,"versionOfCount":0,"created":"2026-02-25T15:23:22Z","registered":"2026-02-25T15:23:22Z","published":null,"updated":"2026-02-25T15:23:23Z"},"relationships":{"client":{"data":{"id":"arxiv.content","type":"clients"}}}},{"id":"10.48550/arxiv.2602.19989","type":"dois","attributes":{"doi":"10.48550/arxiv.2602.19989","identifiers":[{"identifier":"2602.19989","identifierType":"arXiv"}],"creators":[{"nameType":"Personal","givenName":"Simone","familyName":"Costa","name":"Costa, Simone","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Stefano","familyName":"Della Fiore","name":"Della Fiore, Stefano","affiliation":[],"nameIdentifiers":[]}],"titles":[{"title":"New bounds for (weak) sequenceability in $\\mathbb{Z}_k$"}],"publisher":"arXiv","container":{},"publicationYear":2026,"subjects":[{"subject":"Combinatorics (math.CO)","lang":"en","subjectScheme":"arXiv"},{"subject":"FOS: Mathematics","subjectScheme":"Fields of Science and Technology (FOS)"},{"schemeUri":"http://www.oecd.org/science/inno/38235147.pdf","subject":"FOS: Mathematics","subjectScheme":"Fields of Science and Technology (FOS)"}],"contributors":[],"dates":[{"date":"2026-02-23T15:54:26Z","dateType":"Submitted","dateInformation":"v1"},{"date":"2026-02-24T02:35:47Z","dateType":"Updated","dateInformation":"v1"},{"date":"2026-02","dateType":"Available","dateInformation":"v1"},{"date":"2026","dateType":"Issued"}],"language":null,"types":{"schemaOrg":"CreativeWork","resourceTypeGeneral":"Preprint","citeproc":"article","bibtex":"misc","ris":"GEN","resourceType":"Article"},"relatedIdentifiers":[],"relatedItems":[],"sizes":[],"formats":[],"version":"1","rightsList":[{"rightsIdentifierScheme":"SPDX","rightsUri":"https://creativecommons.org/licenses/by/4.0/legalcode","schemeUri":"https://spdx.org/licenses/","rights":"Creative Commons Attribution 4.0 International","rightsIdentifier":"cc-by-4.0"}],"descriptions":[{"descriptionType":"Abstract","description":"A famous conjecture of Graham asserts that every set $A \\subseteq \\mathbb{Z}_p \\setminus \\{0\\}$ can be ordered so that all partial sums are distinct. Although this conjecture was recently proved for sufficiently large primes by Pham and Sauermann in [16], it remains open for general abelian groups, even in the cyclic case $\\mathbb{Z}_k$.\n For cyclic groups, the best known result is due to Bedert and Kravitz in [4], who proved - using a rectification and a two-step probabilistic approach - that the conjecture holds for any subset $A \\subseteq \\mathbb{Z}_k \\setminus \\{0\\}$ such that $$ |A| \\le \\exp\\!\\big(c(\\log p)^{1/4}\\big), $$ for some constant $c\u0026gt;0$, where $p$ denotes the least prime divisor of $k$.\n In this paper, we improve their bound using a rectification argument again, followed by a one-shot probabilistic approach, showing that the conjecture holds whenever $$|A| \\le \\exp\\!\\big(c(\\log p)^{1/3}\\big), $$ thus improving the exponent $1/4$ from [4].\n Moreover, the same one-shot approach adapts to the $t$-weak setting: by imposing all local constraints at once and applying the Lovász Local Lemma, we obtain the existence of a $t$-weak sequencing whenever $$ t \\le \\exp\\!\\big(c(\\log p)^{1/4}\\big). $$"}],"geoLocations":[],"fundingReferences":[],"url":"https://arxiv.org/abs/2602.19989","contentUrl":null,"metadataVersion":0,"schemaVersion":"http://datacite.org/schema/kernel-4","source":"mds","isActive":true,"state":"findable","reason":null,"viewCount":0,"downloadCount":0,"referenceCount":0,"citationCount":0,"partCount":0,"partOfCount":0,"versionCount":0,"versionOfCount":0,"created":"2026-02-25T15:23:19Z","registered":"2026-02-25T15:23:20Z","published":null,"updated":"2026-02-25T15:23:20Z"},"relationships":{"client":{"data":{"id":"arxiv.content","type":"clients"}}}},{"id":"10.48550/arxiv.2602.19987","type":"dois","attributes":{"doi":"10.48550/arxiv.2602.19987","identifiers":[{"identifier":"2602.19987","identifierType":"arXiv"}],"creators":[{"nameType":"Personal","givenName":"Ha-Anh Hoang","familyName":"Nguyen","name":"Nguyen, Ha-Anh Hoang","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Tri-Duc Phan","familyName":"Le","name":"Le, Tri-Duc Phan","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Duc-Hoang","familyName":"Pham","name":"Pham, Duc-Hoang","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Huy-Son","familyName":"Nguyen","name":"Nguyen, Huy-Son","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Cam-Van Thi","familyName":"Nguyen","name":"Nguyen, Cam-Van Thi","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Duc-Trong","familyName":"Le","name":"Le, Duc-Trong","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Hoang-Quynh","familyName":"Le","name":"Le, Hoang-Quynh","affiliation":[],"nameIdentifiers":[]}],"titles":[{"title":"Counterfactual Understanding via Retrieval-aware Multimodal Modeling for Time-to-Event Survival Prediction"}],"publisher":"arXiv","container":{},"publicationYear":2026,"subjects":[{"subject":"Machine Learning (cs.LG)","lang":"en","subjectScheme":"arXiv"},{"subject":"Information Retrieval (cs.IR)","lang":"en","subjectScheme":"arXiv"},{"subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"},{"schemeUri":"http://www.oecd.org/science/inno/38235147.pdf","subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"}],"contributors":[],"dates":[{"date":"2026-02-23T15:53:25Z","dateType":"Submitted","dateInformation":"v1"},{"date":"2026-02-24T02:35:38Z","dateType":"Updated","dateInformation":"v1"},{"date":"2026-02","dateType":"Available","dateInformation":"v1"},{"date":"2026","dateType":"Issued"}],"language":null,"types":{"schemaOrg":"CreativeWork","resourceTypeGeneral":"Preprint","citeproc":"article","bibtex":"misc","ris":"GEN","resourceType":"Article"},"relatedIdentifiers":[],"relatedItems":[],"sizes":[],"formats":[],"version":"1","rightsList":[{"rightsIdentifierScheme":"SPDX","rightsUri":"https://creativecommons.org/licenses/by/4.0/legalcode","schemeUri":"https://spdx.org/licenses/","rights":"Creative Commons Attribution 4.0 International","rightsIdentifier":"cc-by-4.0"}],"descriptions":[{"descriptionType":"Abstract","description":"This paper tackles the problem of time-to-event counterfactual survival prediction, aiming to optimize individualized survival outcomes in the presence of heterogeneity and censored data. We propose CURE, a framework that advances counterfactual survival modeling via comprehensive multimodal embedding and latent subgroup retrieval. CURE integrates clinical, paraclinical, demographic, and multi-omics information, which are aligned and fused through cross-attention mechanisms. Complex multi-omics signals can be adaptively refined using a mixture-of-experts architecture, emphasizing the most informative omics components. Building upon this representation, CURE implicitly retrieves patient-specific latent subgroups that capture both baseline survival dynamics and treatment-dependent variations. Experimental results on METABRIC and TCGA-LUAD datasets demonstrate that proposed CURE model consistently outperforms strong baselines in survival analysis, evaluated using the Time-dependent Concordance Index ($C^{td}$) and Integrated Brier Score (IBS). These findings highlight the potential of CURE to enhance multimodal understanding and serve as a foundation for future treatment recommendation models. All code and related resources are publicly available to facilitate the reproducibility https://github.com/L2R-UET/CURE."}],"geoLocations":[],"fundingReferences":[],"url":"https://arxiv.org/abs/2602.19987","contentUrl":null,"metadataVersion":0,"schemaVersion":"http://datacite.org/schema/kernel-4","source":"mds","isActive":true,"state":"findable","reason":null,"viewCount":0,"downloadCount":0,"referenceCount":0,"citationCount":0,"partCount":0,"partOfCount":0,"versionCount":0,"versionOfCount":0,"created":"2026-02-25T15:23:15Z","registered":"2026-02-25T15:23:15Z","published":null,"updated":"2026-02-25T15:23:15Z"},"relationships":{"client":{"data":{"id":"arxiv.content","type":"clients"}}}},{"id":"10.48550/arxiv.2602.19986","type":"dois","attributes":{"doi":"10.48550/arxiv.2602.19986","identifiers":[{"identifier":"2602.19986","identifierType":"arXiv"}],"creators":[{"nameType":"Personal","givenName":"Alastair B.","familyName":"Claringbold","name":"Claringbold, Alastair B.","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Peter J.","familyName":"Wheatley","name":"Wheatley, Peter J.","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"James","familyName":"Kirk","name":"Kirk, James","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Eva-Maria","familyName":"Ahrer","name":"Ahrer, Eva-Maria","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Ian","familyName":"Skillen","name":"Skillen, Ian","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Matteo","familyName":"Brogi","name":"Brogi, Matteo","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"George W.","familyName":"King","name":"King, George W.","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"James","familyName":"McCormac","name":"McCormac, James","affiliation":[],"nameIdentifiers":[]}],"titles":[{"title":"LRG-BEASTS: Detection of sodium and evidence for water absorption in the hot Saturn HAT-P-44b"}],"publisher":"arXiv","container":{},"publicationYear":2026,"subjects":[{"subject":"Earth and Planetary Astrophysics (astro-ph.EP)","lang":"en","subjectScheme":"arXiv"},{"subject":"FOS: Physical sciences","subjectScheme":"Fields of Science and Technology (FOS)"},{"schemeUri":"http://www.oecd.org/science/inno/38235147.pdf","subject":"FOS: Physical sciences","subjectScheme":"Fields of Science and Technology (FOS)"}],"contributors":[],"dates":[{"date":"2026-02-23T15:53:17Z","dateType":"Submitted","dateInformation":"v1"},{"date":"2026-02-24T02:35:36Z","dateType":"Updated","dateInformation":"v1"},{"date":"2026-02","dateType":"Available","dateInformation":"v1"},{"date":"2026","dateType":"Issued"}],"language":null,"types":{"schemaOrg":"CreativeWork","resourceTypeGeneral":"Preprint","citeproc":"article","bibtex":"misc","ris":"GEN","resourceType":"Article"},"relatedIdentifiers":[],"relatedItems":[],"sizes":[],"formats":[],"version":"1","rightsList":[{"rightsUri":"http://arxiv.org/licenses/nonexclusive-distrib/1.0/","rights":"arXiv.org perpetual, non-exclusive license"}],"descriptions":[{"descriptionType":"Abstract","description":"We present the low-resolution optical transmission spectrum of the inflated hot Saturn HAT-P-44b. The planet is a close sibling in radius (1.24 $\\mathrm{R_{Jup}}$), temperature (1100 K), and mass (0.35 $\\mathrm{M_{Jup}}$) to the exceedingly well-characterized WASP-39b. Using the ACAM instrument on the William Herschel Telescope (WHT), we obtain a transmission spectrum with sub-scale height precision of 246 ppm, with a wavelength range of 495 -- 874 nm and a 20 nm resolution, despite a relatively faint host star ($V\\mathrm{_{mag} = 13.2}$). We detect absorption due to sodium with 3.9$σ$ confidence. Atmospheric retrieval of the transmission spectrum also reveals evidence for \\ch{H2O} absorption and Rayleigh scattering from \\ch{H2} gas consistent with a cool 800 K atmosphere and a super-solar metallicity of 7$\\substack{+16 \\\\ -5}$$\\times$solar. Comparison of retrieval models disfavour the inclusion of a super-Rayleigh scattering slope or high-altitude clouds (at $\u0026lt;1$ mbar) while being agnostic towards the presence of mid-altitude clouds. Our transmission spectrum of HAT-P-44b shows strong similarity to that of its sibling WASP-39b.} This is the tenth planet in the LRG-BEASTS (Low-Resolution Ground-Based Exoplanet Atmosphere Survey using Transmission Spectroscopy) survey."},{"descriptionType":"Other","description":"21 pages, 22 figures, accepted for publication in Monthly Notices of the Royal Astronomical Society"}],"geoLocations":[],"fundingReferences":[],"url":"https://arxiv.org/abs/2602.19986","contentUrl":null,"metadataVersion":0,"schemaVersion":"http://datacite.org/schema/kernel-4","source":"mds","isActive":true,"state":"findable","reason":null,"viewCount":0,"downloadCount":0,"referenceCount":0,"citationCount":0,"partCount":0,"partOfCount":0,"versionCount":0,"versionOfCount":0,"created":"2026-02-25T15:23:12Z","registered":"2026-02-25T15:23:13Z","published":null,"updated":"2026-02-25T15:23:13Z"},"relationships":{"client":{"data":{"id":"arxiv.content","type":"clients"}}}},{"id":"10.48550/arxiv.2602.19985","type":"dois","attributes":{"doi":"10.48550/arxiv.2602.19985","identifiers":[{"identifier":"2602.19985","identifierType":"arXiv"}],"creators":[{"nameType":"Personal","affiliation":["ICTP-SAIFR/IFT-UNESP, Sao Paulo"],"givenName":"Nathan","familyName":"Berkovits","name":"Berkovits, Nathan","nameIdentifiers":[]}],"titles":[{"title":"Instanton Solutions of the Topological A-model Dual to Free Super-Yang-Mills"}],"publisher":"arXiv","container":{},"publicationYear":2026,"subjects":[{"subject":"High Energy Physics - Theory (hep-th)","lang":"en","subjectScheme":"arXiv"},{"subject":"FOS: Physical sciences","subjectScheme":"Fields of Science and Technology (FOS)"},{"schemeUri":"http://www.oecd.org/science/inno/38235147.pdf","subject":"FOS: Physical sciences","subjectScheme":"Fields of Science and Technology (FOS)"}],"contributors":[],"dates":[{"date":"2026-02-23T15:52:01Z","dateType":"Submitted","dateInformation":"v1"},{"date":"2026-02-24T02:35:35Z","dateType":"Updated","dateInformation":"v1"},{"date":"2026-02","dateType":"Available","dateInformation":"v1"},{"date":"2026","dateType":"Issued"}],"language":null,"types":{"schemaOrg":"CreativeWork","resourceTypeGeneral":"Preprint","citeproc":"article","bibtex":"misc","ris":"GEN","resourceType":"Article"},"relatedIdentifiers":[],"relatedItems":[],"sizes":[],"formats":[],"version":"1","rightsList":[{"rightsUri":"http://arxiv.org/licenses/nonexclusive-distrib/1.0/","rights":"arXiv.org perpetual, non-exclusive license"}],"descriptions":[{"descriptionType":"Abstract","description":"A topological A-model constructed from supertwistor variables and a worldsheet U(1) gauge field was recently proposed to describe the $AdS_5\\times S^5$ superstring at zero radius which is dual to free N=4 d=4 super-Yang-Mills. In this note, holomorphic worldsheet instanton solutions of the supertwistor variables are constructed where the U(1) worldsheet gauge field is identified with the square-root of the Strebel differential that describes the ribbon graph on the worldsheet."},{"descriptionType":"Other","description":"6 pages harvmac"}],"geoLocations":[],"fundingReferences":[],"url":"https://arxiv.org/abs/2602.19985","contentUrl":null,"metadataVersion":0,"schemaVersion":"http://datacite.org/schema/kernel-4","source":"mds","isActive":true,"state":"findable","reason":null,"viewCount":0,"downloadCount":0,"referenceCount":0,"citationCount":0,"partCount":0,"partOfCount":0,"versionCount":0,"versionOfCount":0,"created":"2026-02-25T15:23:10Z","registered":"2026-02-25T15:23:10Z","published":null,"updated":"2026-02-25T15:23:10Z"},"relationships":{"client":{"data":{"id":"arxiv.content","type":"clients"}}}},{"id":"10.48550/arxiv.2602.19984","type":"dois","attributes":{"doi":"10.48550/arxiv.2602.19984","identifiers":[{"identifier":"2602.19984","identifierType":"arXiv"}],"creators":[{"nameType":"Personal","givenName":"Federico","familyName":"Incardona","name":"Incardona, Federico","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Alessandro","familyName":"Costa","name":"Costa, Alessandro","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Farida","familyName":"Farsian","name":"Farsian, Farida","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Francesco","familyName":"Franchina","name":"Franchina, Francesco","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Giuseppe","familyName":"Leto","name":"Leto, Giuseppe","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Emilio","familyName":"Mastriani","name":"Mastriani, Emilio","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Kevin","familyName":"Munari","name":"Munari, Kevin","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Giovanni","familyName":"Pareschi","name":"Pareschi, Giovanni","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Salvatore","familyName":"Scuderi","name":"Scuderi, Salvatore","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Sebastiano","familyName":"Spinello","name":"Spinello, Sebastiano","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Gino","familyName":"Tosti","name":"Tosti, Gino","affiliation":[],"nameIdentifiers":[]}],"titles":[{"title":"Multivariate time-series forecasting of ASTRI-Horn monitoring data: A Normal Behavior Model"}],"publisher":"arXiv","container":{},"publicationYear":2026,"subjects":[{"subject":"Instrumentation and Methods for Astrophysics (astro-ph.IM)","lang":"en","subjectScheme":"arXiv"},{"subject":"High Energy Astrophysical Phenomena (astro-ph.HE)","lang":"en","subjectScheme":"arXiv"},{"subject":"Machine Learning (cs.LG)","lang":"en","subjectScheme":"arXiv"},{"subject":"FOS: Physical sciences","subjectScheme":"Fields of Science and Technology (FOS)"},{"schemeUri":"http://www.oecd.org/science/inno/38235147.pdf","subject":"FOS: Physical sciences","subjectScheme":"Fields of Science and Technology (FOS)"},{"subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"},{"schemeUri":"http://www.oecd.org/science/inno/38235147.pdf","subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"}],"contributors":[],"dates":[{"date":"2026-02-23T15:51:50Z","dateType":"Submitted","dateInformation":"v1"},{"date":"2026-02-24T02:35:34Z","dateType":"Updated","dateInformation":"v1"},{"date":"2026-02","dateType":"Available","dateInformation":"v1"},{"date":"2026","dateType":"Issued"}],"language":null,"types":{"schemaOrg":"CreativeWork","resourceTypeGeneral":"Preprint","citeproc":"article","bibtex":"misc","ris":"GEN","resourceType":"Article"},"relatedIdentifiers":[{"relationType":"IsVersionOf","relatedIdentifier":"10.1016/j.ascom.2026.101071","relatedIdentifierType":"DOI"}],"relatedItems":[],"sizes":[],"formats":[],"version":"1","rightsList":[{"rightsIdentifierScheme":"SPDX","rightsUri":"https://creativecommons.org/licenses/by/4.0/legalcode","schemeUri":"https://spdx.org/licenses/","rights":"Creative Commons Attribution 4.0 International","rightsIdentifier":"cc-by-4.0"}],"descriptions":[{"descriptionType":"Abstract","description":"This study presents a Normal Behavior Model (NBM) developed to forecast monitoring time-series data from the ASTRI-Horn Cherenkov telescope under normal operating conditions. The analysis focused on 15 physical variables acquired by the Telescope Control Unit between September 2022 and July 2024, representing sensor measurements from the Azimuth and Elevation motors. After data cleaning, resampling, feature selection, and correlation analysis, the dataset was segmented into fixed-length intervals, in which the first I samples represented the input sequence provided to the model, while the forecast length, T, indicated the number of future time steps to be predicted. A sliding-window technique was then applied to increase the number of intervals. A Multi-Layer Perceptron (MLP) was trained to perform multivariate forecasting across all features simultaneously. Model performance was evaluated using the Mean Squared Error (MSE) and the Normalized Median Absolute Deviation (NMAD), and it was also benchmarked against a Long Short-Term Memory (LSTM) network. The MLP model demonstrated consistent results across different features and I-T configurations, and matched the performance of the LSTM while converging faster. It achieved an MSE of 0.019+/-0.003 and an NMAD of 0.032+/-0.009 on the test set under its best configuration (4 hidden layers, 720 units per layer, and I-T lengths of 300 samples each, corresponding to 5 hours at 1-minute resolution). Extending the forecast horizon up to 6.5 hours-the maximum allowed by this configuration-did not degrade performance, confirming the model's effectiveness in providing reliable hour-scale predictions. The proposed NBM provides a powerful tool for enabling early anomaly detection in online ASTRI-Horn monitoring time series, offering a basis for the future development of a prognostics and health management system that supports predictive maintenance."},{"descriptionType":"Other","description":"15 pages, 12 figures"}],"geoLocations":[],"fundingReferences":[],"url":"https://arxiv.org/abs/2602.19984","contentUrl":null,"metadataVersion":0,"schemaVersion":"http://datacite.org/schema/kernel-4","source":"mds","isActive":true,"state":"findable","reason":null,"viewCount":0,"downloadCount":0,"referenceCount":0,"citationCount":0,"partCount":0,"partOfCount":0,"versionCount":0,"versionOfCount":1,"created":"2026-02-25T15:23:07Z","registered":"2026-02-25T15:23:08Z","published":null,"updated":"2026-02-25T15:23:08Z"},"relationships":{"client":{"data":{"id":"arxiv.content","type":"clients"}}}},{"id":"10.48550/arxiv.2602.19982","type":"dois","attributes":{"doi":"10.48550/arxiv.2602.19982","identifiers":[{"identifier":"2602.19982","identifierType":"arXiv"}],"creators":[{"nameType":"Personal","givenName":"Alaa El","familyName":"Ichi","name":"Ichi, Alaa El","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Khalide","familyName":"Jbilou","name":"Jbilou, Khalide","affiliation":[],"nameIdentifiers":[]}],"titles":[{"title":"A Computationally Efficient Multidimensional Vision Transformer"}],"publisher":"arXiv","container":{},"publicationYear":2026,"subjects":[{"subject":"Machine Learning (cs.LG)","lang":"en","subjectScheme":"arXiv"},{"subject":"Numerical Analysis (math.NA)","lang":"en","subjectScheme":"arXiv"},{"subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"},{"schemeUri":"http://www.oecd.org/science/inno/38235147.pdf","subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"},{"subject":"FOS: Mathematics","subjectScheme":"Fields of Science and Technology (FOS)"},{"schemeUri":"http://www.oecd.org/science/inno/38235147.pdf","subject":"FOS: Mathematics","subjectScheme":"Fields of Science and Technology (FOS)"}],"contributors":[],"dates":[{"date":"2026-02-23T15:49:46Z","dateType":"Submitted","dateInformation":"v1"},{"date":"2026-02-24T02:35:31Z","dateType":"Updated","dateInformation":"v1"},{"date":"2026-02","dateType":"Available","dateInformation":"v1"},{"date":"2026","dateType":"Issued"}],"language":null,"types":{"schemaOrg":"CreativeWork","resourceTypeGeneral":"Preprint","citeproc":"article","bibtex":"misc","ris":"GEN","resourceType":"Article"},"relatedIdentifiers":[],"relatedItems":[],"sizes":[],"formats":[],"version":"1","rightsList":[{"rightsUri":"http://arxiv.org/licenses/nonexclusive-distrib/1.0/","rights":"arXiv.org perpetual, non-exclusive license"}],"descriptions":[{"descriptionType":"Abstract","description":"Vision Transformers have achieved state-of-the-art performance in a wide range\n of computer vision tasks, but their practical deployment is limited by high\n computational and memory costs. In this paper, we introduce a novel tensor-based\n framework for Vision Transformers built upon the Tensor Cosine Product\n (Cproduct). By exploiting multilinear structures inherent in image data and the\n orthogonality of cosine transforms, the proposed approach enables efficient\n attention mechanisms and structured feature representations. We develop the\n theoretical foundations of the tensor cosine product, analyze its algebraic\n properties, and integrate it into a new Cproduct-based Vision Transformer\n architecture (TCP-ViT). Numerical experiments on standard classification and\n segmentation benchmarks demonstrate that the proposed method achieves a uniform\n 1/C parameter reduction (where C is the number of channels) while\n maintaining competitive accuracy."}],"geoLocations":[],"fundingReferences":[],"url":"https://arxiv.org/abs/2602.19982","contentUrl":null,"metadataVersion":0,"schemaVersion":"http://datacite.org/schema/kernel-4","source":"mds","isActive":true,"state":"findable","reason":null,"viewCount":0,"downloadCount":0,"referenceCount":0,"citationCount":0,"partCount":0,"partOfCount":0,"versionCount":0,"versionOfCount":0,"created":"2026-02-25T15:23:02Z","registered":"2026-02-25T15:23:03Z","published":null,"updated":"2026-02-25T15:23:03Z"},"relationships":{"client":{"data":{"id":"arxiv.content","type":"clients"}}}},{"id":"10.48550/arxiv.2602.19981","type":"dois","attributes":{"doi":"10.48550/arxiv.2602.19981","identifiers":[{"identifier":"2602.19981","identifierType":"arXiv"}],"creators":[{"nameType":"Personal","givenName":"Jeffrey","familyName":"Galkowski","name":"Galkowski, Jeffrey","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Zhen","familyName":"Huang","name":"Huang, Zhen","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Maciej","familyName":"Zworski","name":"Zworski, Maciej","affiliation":[],"nameIdentifiers":[]}],"titles":[{"title":"1D Scattering through time dependent media with memory"}],"publisher":"arXiv","container":{},"publicationYear":2026,"subjects":[{"subject":"Analysis of PDEs (math.AP)","lang":"en","subjectScheme":"arXiv"},{"subject":"Mathematical Physics (math-ph)","lang":"en","subjectScheme":"arXiv"},{"subject":"Optics (physics.optics)","lang":"en","subjectScheme":"arXiv"},{"subject":"FOS: Mathematics","subjectScheme":"Fields of Science and Technology (FOS)"},{"schemeUri":"http://www.oecd.org/science/inno/38235147.pdf","subject":"FOS: Mathematics","subjectScheme":"Fields of Science and Technology (FOS)"},{"subject":"FOS: Physical sciences","subjectScheme":"Fields of Science and Technology (FOS)"},{"schemeUri":"http://www.oecd.org/science/inno/38235147.pdf","subject":"FOS: Physical sciences","subjectScheme":"Fields of Science and Technology (FOS)"}],"contributors":[],"dates":[{"date":"2026-02-23T15:49:28Z","dateType":"Submitted","dateInformation":"v1"},{"date":"2026-02-24T02:35:28Z","dateType":"Updated","dateInformation":"v1"},{"date":"2026-02","dateType":"Available","dateInformation":"v1"},{"date":"2026","dateType":"Issued"}],"language":null,"types":{"schemaOrg":"CreativeWork","resourceTypeGeneral":"Preprint","citeproc":"article","bibtex":"misc","ris":"GEN","resourceType":"Article"},"relatedIdentifiers":[],"relatedItems":[],"sizes":[],"formats":[],"version":"1","rightsList":[{"rightsUri":"http://arxiv.org/licenses/nonexclusive-distrib/1.0/","rights":"arXiv.org perpetual, non-exclusive license"}],"descriptions":[{"descriptionType":"Abstract","description":"We construct a scattering matrix with operator valued entries describing solutions to the 1+1 wave equation where permittivities has memory and depends on time and space. It is the analogue of the scattering matrix for spatially localised perturbations where the entries are functions of frequency and appear as Fourier multipliers in solutions of the wave equation. This provides a mathematical explanation of the numerical construction in the recent paper by Horsley et al. The appendix by Zhen Huang and Maciej Zworski presents a numerical scheme for solving the wave equation considered in this article."},{"descriptionType":"Other","description":"2 figures"}],"geoLocations":[],"fundingReferences":[],"url":"https://arxiv.org/abs/2602.19981","contentUrl":null,"metadataVersion":0,"schemaVersion":"http://datacite.org/schema/kernel-4","source":"mds","isActive":true,"state":"findable","reason":null,"viewCount":0,"downloadCount":0,"referenceCount":0,"citationCount":0,"partCount":0,"partOfCount":0,"versionCount":0,"versionOfCount":0,"created":"2026-02-25T15:22:59Z","registered":"2026-02-25T15:23:00Z","published":null,"updated":"2026-02-25T15:23:00Z"},"relationships":{"client":{"data":{"id":"arxiv.content","type":"clients"}}}},{"id":"10.48550/arxiv.2602.19980","type":"dois","attributes":{"doi":"10.48550/arxiv.2602.19980","identifiers":[{"identifier":"2602.19980","identifierType":"arXiv"}],"creators":[{"nameType":"Personal","givenName":"Itamar","familyName":"Trainin","name":"Trainin, Itamar","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Shauli","familyName":"Ravfogel","name":"Ravfogel, Shauli","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Omri","familyName":"Abend","name":"Abend, Omri","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Amir","familyName":"Feder","name":"Feder, Amir","affiliation":[],"nameIdentifiers":[]}],"titles":[{"title":"Discrete Diffusion Models Exploit Asymmetry to Solve Lookahead Planning Tasks"}],"publisher":"arXiv","container":{},"publicationYear":2026,"subjects":[{"subject":"Machine Learning (cs.LG)","lang":"en","subjectScheme":"arXiv"},{"subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"},{"schemeUri":"http://www.oecd.org/science/inno/38235147.pdf","subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"}],"contributors":[],"dates":[{"date":"2026-02-23T15:47:27Z","dateType":"Submitted","dateInformation":"v1"},{"date":"2026-02-24T02:35:20Z","dateType":"Updated","dateInformation":"v1"},{"date":"2026-02","dateType":"Available","dateInformation":"v1"},{"date":"2026","dateType":"Issued"}],"language":null,"types":{"schemaOrg":"CreativeWork","resourceTypeGeneral":"Preprint","citeproc":"article","bibtex":"misc","ris":"GEN","resourceType":"Article"},"relatedIdentifiers":[],"relatedItems":[],"sizes":[],"formats":[],"version":"1","rightsList":[{"rightsIdentifierScheme":"SPDX","rightsUri":"https://creativecommons.org/licenses/by/4.0/legalcode","schemeUri":"https://spdx.org/licenses/","rights":"Creative Commons Attribution 4.0 International","rightsIdentifier":"cc-by-4.0"}],"descriptions":[{"descriptionType":"Abstract","description":"While Autoregressive (AR) Transformer-based Generative Language Models are frequently employed for lookahead tasks, recent research suggests a potential discrepancy in their ability to perform planning tasks that require multi-step lookahead. In this work, we investigate the distinct emergent mechanisms that arise when training AR versus Non-Autoregressive (NAR) models, such as Discrete Diffusion Models (dLLMs), on lookahead tasks. By requiring the models to plan ahead to reach the correct conclusion, we analyze how these two paradigms fundamentally differ in their approach to the problem. We identify a critical asymmetry in planning problems: while forward generation requires complex lookahead at branching junctions, reverse generation is often deterministic. This asymmetry creates an opportunity for NAR models. Through mechanistic analysis of training and inference dynamics, we demonstrate that NAR models learn to solve planning tasks by utilizing future tokens to decode backwards, avoiding the need to learn complex traversal mechanisms entirely. Consequently, we report that both AR and NAR models are able to achieve perfect accuracy on the lookahead task. However, NAR models require exponentially fewer training examples and shallower architectures compared to AR models, which often fail to converge without specific curriculum adjustments."}],"geoLocations":[],"fundingReferences":[],"url":"https://arxiv.org/abs/2602.19980","contentUrl":null,"metadataVersion":0,"schemaVersion":"http://datacite.org/schema/kernel-4","source":"mds","isActive":true,"state":"findable","reason":null,"viewCount":0,"downloadCount":0,"referenceCount":0,"citationCount":0,"partCount":0,"partOfCount":0,"versionCount":0,"versionOfCount":0,"created":"2026-02-25T15:22:57Z","registered":"2026-02-25T15:22:57Z","published":null,"updated":"2026-02-25T15:22:57Z"},"relationships":{"client":{"data":{"id":"arxiv.content","type":"clients"}}}},{"id":"10.48550/arxiv.2602.19979","type":"dois","attributes":{"doi":"10.48550/arxiv.2602.19979","identifiers":[{"identifier":"2602.19979","identifierType":"arXiv"}],"creators":[{"nameType":"Personal","givenName":"Emiel","familyName":"Claasen","name":"Claasen, Emiel","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Mehregan","familyName":"Doroudiani","name":"Doroudiani, Mehregan","affiliation":[],"nameIdentifiers":[]}],"titles":[{"title":"Five-point Type IIB String Amplitudes at One Loop"}],"publisher":"arXiv","container":{},"publicationYear":2026,"subjects":[{"subject":"High Energy Physics - Theory (hep-th)","lang":"en","subjectScheme":"arXiv"},{"subject":"FOS: Physical sciences","subjectScheme":"Fields of Science and Technology (FOS)"},{"schemeUri":"http://www.oecd.org/science/inno/38235147.pdf","subject":"FOS: Physical sciences","subjectScheme":"Fields of Science and Technology (FOS)"}],"contributors":[],"dates":[{"date":"2026-02-23T15:46:39Z","dateType":"Submitted","dateInformation":"v1"},{"date":"2026-02-24T02:35:17Z","dateType":"Updated","dateInformation":"v1"},{"date":"2026-02","dateType":"Available","dateInformation":"v1"},{"date":"2026","dateType":"Issued"}],"language":null,"types":{"schemaOrg":"CreativeWork","resourceTypeGeneral":"Preprint","citeproc":"article","bibtex":"misc","ris":"GEN","resourceType":"Article"},"relatedIdentifiers":[],"relatedItems":[],"sizes":[],"formats":[],"version":"1","rightsList":[{"rightsIdentifierScheme":"SPDX","rightsUri":"https://creativecommons.org/licenses/by/4.0/legalcode","schemeUri":"https://spdx.org/licenses/","rights":"Creative Commons Attribution 4.0 International","rightsIdentifier":"cc-by-4.0"}],"descriptions":[{"descriptionType":"Abstract","description":"Massless type IIB superstring amplitudes are organized according to the number of external states and their ${\\mathrm U}(1)$ charge under the R-symmetry of type IIB supergravity. In this work, we analyze the low-energy expansion of one-loop five-point amplitudes in all charge sectors, focusing on the representative processes involving five gravitons and four gravitons with one dilaton. We compute the one-loop contributions to the moduli-dependent couplings in the type IIB effective action up to the $D^{12}R^5$ and $D^{14}ϕR^4$ interactions. The results are consistent with $S$-duality constraints in every charge sector and exhibit rich arithmetic structure, including single-valued multiple zeta values, affine linear combinations of logarithmic derivatives of the Riemann zeta function at odd integers, and a new constant of currently unknown nature."},{"descriptionType":"Other","description":"36 pages + appendices"}],"geoLocations":[],"fundingReferences":[],"url":"https://arxiv.org/abs/2602.19979","contentUrl":null,"metadataVersion":0,"schemaVersion":"http://datacite.org/schema/kernel-4","source":"mds","isActive":true,"state":"findable","reason":null,"viewCount":0,"downloadCount":0,"referenceCount":0,"citationCount":0,"partCount":0,"partOfCount":0,"versionCount":0,"versionOfCount":0,"created":"2026-02-25T15:22:54Z","registered":"2026-02-25T15:22:55Z","published":null,"updated":"2026-02-25T15:22:55Z"},"relationships":{"client":{"data":{"id":"arxiv.content","type":"clients"}}}},{"id":"10.48550/arxiv.2602.19978","type":"dois","attributes":{"doi":"10.48550/arxiv.2602.19978","identifiers":[{"identifier":"2602.19978","identifierType":"arXiv"}],"creators":[{"nameType":"Personal","givenName":"Eric","familyName":"Dannetun","name":"Dannetun, Eric","affiliation":[],"nameIdentifiers":[]}],"titles":[{"title":"Betti numbers of ideals generated by $n+1$ powers of general linear forms"}],"publisher":"arXiv","container":{},"publicationYear":2026,"subjects":[{"subject":"Commutative Algebra (math.AC)","lang":"en","subjectScheme":"arXiv"},{"subject":"FOS: Mathematics","subjectScheme":"Fields of Science and Technology (FOS)"},{"schemeUri":"http://www.oecd.org/science/inno/38235147.pdf","subject":"FOS: Mathematics","subjectScheme":"Fields of Science and Technology (FOS)"},{"subject":"13D02, 13E10, 13H10, 13P10","lang":"en","subjectScheme":"MSC"}],"contributors":[],"dates":[{"date":"2026-02-23T15:44:01Z","dateType":"Submitted","dateInformation":"v1"},{"date":"2026-02-24T02:35:16Z","dateType":"Updated","dateInformation":"v1"},{"date":"2026-02","dateType":"Available","dateInformation":"v1"},{"date":"2026","dateType":"Issued"}],"language":null,"types":{"schemaOrg":"CreativeWork","resourceTypeGeneral":"Preprint","citeproc":"article","bibtex":"misc","ris":"GEN","resourceType":"Article"},"relatedIdentifiers":[],"relatedItems":[],"sizes":[],"formats":[],"version":"1","rightsList":[{"rightsUri":"http://arxiv.org/licenses/nonexclusive-distrib/1.0/","rights":"arXiv.org perpetual, non-exclusive license"}],"descriptions":[{"descriptionType":"Abstract","description":"We study ideals generated by $n+1$ powers of general linear forms in $R= k[x_1,\\dots,x_n]$. By generalizing the ideas in a recent paper of Diethorn et al., we determine the Betti numbers of such ideals when at least one generator is a square. It follows that all such ideals are level. As a consequence, we show that a generic ideal in $R$ generated by $n+1$ forms, with at least one quadric generator, is level. We also determine the Betti numbers of the Artinian Gorenstein algebras linked to these almost complete intersections. By describing the dual generators of these algebras, we obtain a family of forms, including the elementary symmetric polynomials, whose annihilator ideals have the strong Lefschetz property. Finally, we give explicit generators for the annihilator ideal of any elementary symmetric polynomial."},{"descriptionType":"Other","description":"28 pages, Comments are welcome"}],"geoLocations":[],"fundingReferences":[],"url":"https://arxiv.org/abs/2602.19978","contentUrl":null,"metadataVersion":0,"schemaVersion":"http://datacite.org/schema/kernel-4","source":"mds","isActive":true,"state":"findable","reason":null,"viewCount":0,"downloadCount":0,"referenceCount":0,"citationCount":0,"partCount":0,"partOfCount":0,"versionCount":0,"versionOfCount":0,"created":"2026-02-25T15:22:52Z","registered":"2026-02-25T15:22:53Z","published":null,"updated":"2026-02-25T15:22:53Z"},"relationships":{"client":{"data":{"id":"arxiv.content","type":"clients"}}}},{"id":"10.48550/arxiv.2602.19977","type":"dois","attributes":{"doi":"10.48550/arxiv.2602.19977","identifiers":[{"identifier":"2602.19977","identifierType":"arXiv"}],"creators":[{"nameType":"Personal","givenName":"Valerii","familyName":"Andreichev","name":"Andreichev, Valerii","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Jindra","familyName":"Dušek","name":"Dušek, Jindra","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Markus","familyName":"Meuwly","name":"Meuwly, Markus","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Jeremy O.","familyName":"Richardson","name":"Richardson, Jeremy O.","affiliation":[],"nameIdentifiers":[]}],"titles":[{"title":"High-Accuracy Molecular Simulations with Machine-Learning Potentials and Semiclassical Approximations to Quantum Dynamics"}],"publisher":"arXiv","container":{},"publicationYear":2026,"subjects":[{"subject":"Chemical Physics (physics.chem-ph)","lang":"en","subjectScheme":"arXiv"},{"subject":"FOS: Physical sciences","subjectScheme":"Fields of Science and Technology (FOS)"},{"schemeUri":"http://www.oecd.org/science/inno/38235147.pdf","subject":"FOS: Physical sciences","subjectScheme":"Fields of Science and Technology (FOS)"}],"contributors":[],"dates":[{"date":"2026-02-23T15:43:45Z","dateType":"Submitted","dateInformation":"v1"},{"date":"2026-02-24T02:35:15Z","dateType":"Updated","dateInformation":"v1"},{"date":"2026-02","dateType":"Available","dateInformation":"v1"},{"date":"2026","dateType":"Issued"}],"language":null,"types":{"schemaOrg":"CreativeWork","resourceTypeGeneral":"Preprint","citeproc":"article","bibtex":"misc","ris":"GEN","resourceType":"Article"},"relatedIdentifiers":[],"relatedItems":[],"sizes":[],"formats":[],"version":"1","rightsList":[{"rightsIdentifierScheme":"SPDX","rightsUri":"https://creativecommons.org/licenses/by-nc-nd/4.0/legalcode","schemeUri":"https://spdx.org/licenses/","rights":"Creative Commons Attribution Non Commercial No Derivatives 4.0 International","rightsIdentifier":"cc-by-nc-nd-4.0"}],"descriptions":[{"descriptionType":"Abstract","description":"Accurate simulations of molecules require high-level electronic-structure theory in combination with rigorous methods for approximating the quantum dynamics. Machine-learning approaches can significantly reduce the computational expense of this workflow without any loss of accuracy. We discuss various methods for constructing potential energy surfaces including transfer learning, which requires a minimal number of expensive training points. In this way, we can study chemical reactions at a high level but a low cost. In particular, as the potentials are smooth and differentiable, they enable the use of more advanced semiclassical approximations to quantum dynamics, such as perturbatively corrected instanton theory, which can capture both tunnelling and anharmonicity."}],"geoLocations":[],"fundingReferences":[],"url":"https://arxiv.org/abs/2602.19977","contentUrl":null,"metadataVersion":0,"schemaVersion":"http://datacite.org/schema/kernel-4","source":"mds","isActive":true,"state":"findable","reason":null,"viewCount":0,"downloadCount":0,"referenceCount":0,"citationCount":0,"partCount":0,"partOfCount":0,"versionCount":0,"versionOfCount":0,"created":"2026-02-25T15:22:49Z","registered":"2026-02-25T15:22:50Z","published":null,"updated":"2026-02-25T15:22:50Z"},"relationships":{"client":{"data":{"id":"arxiv.content","type":"clients"}}}},{"id":"10.48550/arxiv.2602.19976","type":"dois","attributes":{"doi":"10.48550/arxiv.2602.19976","identifiers":[{"identifier":"2602.19976","identifierType":"arXiv"}],"creators":[{"nameType":"Personal","givenName":"Sifei","familyName":"Li","name":"Li, Sifei","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Yang","familyName":"Li","name":"Li, Yang","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Zizhou","familyName":"Wang","name":"Wang, Zizhou","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Yuxin","familyName":"Zhang","name":"Zhang, Yuxin","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Fuzhang","familyName":"Wu","name":"Wu, Fuzhang","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Oliver","familyName":"Deussen","name":"Deussen, Oliver","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Tong-Yee","familyName":"Lee","name":"Lee, Tong-Yee","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Weiming","familyName":"Dong","name":"Dong, Weiming","affiliation":[],"nameIdentifiers":[]}],"titles":[{"title":"SongEcho: Towards Cover Song Generation via Instance-Adaptive Element-wise Linear Modulation"}],"publisher":"arXiv","container":{},"publicationYear":2026,"subjects":[{"subject":"Sound (cs.SD)","lang":"en","subjectScheme":"arXiv"},{"subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"},{"schemeUri":"http://www.oecd.org/science/inno/38235147.pdf","subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"}],"contributors":[],"dates":[{"date":"2026-02-23T15:42:38Z","dateType":"Submitted","dateInformation":"v1"},{"date":"2026-02-24T02:35:14Z","dateType":"Updated","dateInformation":"v1"},{"date":"2026-02","dateType":"Available","dateInformation":"v1"},{"date":"2026","dateType":"Issued"}],"language":null,"types":{"schemaOrg":"CreativeWork","resourceTypeGeneral":"Preprint","citeproc":"article","bibtex":"misc","ris":"GEN","resourceType":"Article"},"relatedIdentifiers":[],"relatedItems":[],"sizes":[],"formats":[],"version":"1","rightsList":[{"rightsUri":"http://arxiv.org/licenses/nonexclusive-distrib/1.0/","rights":"arXiv.org perpetual, non-exclusive license"}],"descriptions":[{"descriptionType":"Abstract","description":"Cover songs constitute a vital aspect of musical culture, preserving the core melody of an original composition while reinterpreting it to infuse novel emotional depth and thematic emphasis. Although prior research has explored the reinterpretation of instrumental music through melody-conditioned text-to-music models, the task of cover song generation remains largely unaddressed. In this work, we reformulate our cover song generation as a conditional generation, which simultaneously generates new vocals and accompaniment conditioned on the original vocal melody and text prompts. To this end, we present SongEcho, which leverages Instance-Adaptive Element-wise Linear Modulation (IA-EiLM), a framework that incorporates controllable generation by improving both conditioning injection mechanism and conditional representation. To enhance the conditioning injection mechanism, we extend Feature-wise Linear Modulation (FiLM) to an Element-wise Linear Modulation (EiLM), to facilitate precise temporal alignment in melody control. For conditional representations, we propose Instance-Adaptive Condition Refinement (IACR), which refines conditioning features by interacting with the hidden states of the generative model, yielding instance-adaptive conditioning. Additionally, to address the scarcity of large-scale, open-source full-song datasets, we construct Suno70k, a high-quality AI song dataset enriched with comprehensive annotations. Experimental results across multiple datasets demonstrate that our approach generates superior cover songs compared to existing methods, while requiring fewer than 30% of the trainable parameters. The code, dataset, and demos are available at https://github.com/lsfhuihuiff/SongEcho_ICLR2026."},{"descriptionType":"Other","description":"Accepted at ICLR 2026. 21 pages (10 pages main text), 5 figures"}],"geoLocations":[],"fundingReferences":[],"url":"https://arxiv.org/abs/2602.19976","contentUrl":null,"metadataVersion":0,"schemaVersion":"http://datacite.org/schema/kernel-4","source":"mds","isActive":true,"state":"findable","reason":null,"viewCount":0,"downloadCount":0,"referenceCount":0,"citationCount":0,"partCount":0,"partOfCount":0,"versionCount":0,"versionOfCount":0,"created":"2026-02-25T15:22:47Z","registered":"2026-02-25T15:22:48Z","published":null,"updated":"2026-02-25T15:22:48Z"},"relationships":{"client":{"data":{"id":"arxiv.content","type":"clients"}}}},{"id":"10.48550/arxiv.2602.19975","type":"dois","attributes":{"doi":"10.48550/arxiv.2602.19975","identifiers":[{"identifier":"2602.19975","identifierType":"arXiv"}],"creators":[{"nameType":"Personal","givenName":"I. A.","familyName":"Sarmiento-Alvarado","name":"Sarmiento-Alvarado, I. A.","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Leonel","familyName":"Bixano","name":"Bixano, Leonel","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Tonatiuh","familyName":"Matos","name":"Matos, Tonatiuh","affiliation":[],"nameIdentifiers":[]}],"titles":[{"title":"Axially symmetric wormholes"}],"publisher":"arXiv","container":{},"publicationYear":2026,"subjects":[{"subject":"General Relativity and Quantum Cosmology (gr-qc)","lang":"en","subjectScheme":"arXiv"},{"subject":"FOS: Physical sciences","subjectScheme":"Fields of Science and Technology (FOS)"},{"schemeUri":"http://www.oecd.org/science/inno/38235147.pdf","subject":"FOS: Physical sciences","subjectScheme":"Fields of Science and Technology (FOS)"}],"contributors":[],"dates":[{"date":"2026-02-23T15:41:29Z","dateType":"Submitted","dateInformation":"v1"},{"date":"2026-02-24T02:35:10Z","dateType":"Updated","dateInformation":"v1"},{"date":"2026-02","dateType":"Available","dateInformation":"v1"},{"date":"2026","dateType":"Issued"}],"language":null,"types":{"schemaOrg":"CreativeWork","resourceTypeGeneral":"Preprint","citeproc":"article","bibtex":"misc","ris":"GEN","resourceType":"Article"},"relatedIdentifiers":[],"relatedItems":[],"sizes":[],"formats":[],"version":"1","rightsList":[{"rightsUri":"http://arxiv.org/licenses/nonexclusive-distrib/1.0/","rights":"arXiv.org perpetual, non-exclusive license"}],"descriptions":[{"descriptionType":"Abstract","description":"In this work, we derive an exact vacuum solution to the Einstein field equations that depends on three constant parameters: the throat radius $r_0$, a parameter $q$, which is closely associated with the Komar mass, and a parameter $s$, which introduces axial topological defect while avoiding the emergence of conical singularities. We employ the cut-and-paste construction to generate wormhole geometries from this solution for $q \\neq 0$. In addition, we perform a detailed analysis of the embedding diagrams, the wormhole throat, the occurrence and structure of trapped surfaces, the behavior of geodesics, the associated tidal forces, the Petrov algebraic classification, the Newman-Penrose spin coefficients, and the corresponding invariant conserved charges."}],"geoLocations":[],"fundingReferences":[],"url":"https://arxiv.org/abs/2602.19975","contentUrl":null,"metadataVersion":0,"schemaVersion":"http://datacite.org/schema/kernel-4","source":"mds","isActive":true,"state":"findable","reason":null,"viewCount":0,"downloadCount":0,"referenceCount":0,"citationCount":0,"partCount":0,"partOfCount":0,"versionCount":0,"versionOfCount":0,"created":"2026-02-25T15:22:44Z","registered":"2026-02-25T15:22:45Z","published":null,"updated":"2026-02-25T15:22:45Z"},"relationships":{"client":{"data":{"id":"arxiv.content","type":"clients"}}}},{"id":"10.48550/arxiv.2602.19972","type":"dois","attributes":{"doi":"10.48550/arxiv.2602.19972","identifiers":[{"identifier":"2602.19972","identifierType":"arXiv"}],"creators":[{"nameType":"Personal","givenName":"Shashikant Singh","familyName":"Kunwar","name":"Kunwar, Shashikant Singh","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Madhuparna","familyName":"Karmakar","name":"Karmakar, Madhuparna","affiliation":[],"nameIdentifiers":[]}],"titles":[{"title":"Non Fermi liquid signatures across strain engineered metal-insulator transition in line-graph lattices"}],"publisher":"arXiv","container":{},"publicationYear":2026,"subjects":[{"subject":"Strongly Correlated Electrons (cond-mat.str-el)","lang":"en","subjectScheme":"arXiv"},{"subject":"Materials Science (cond-mat.mtrl-sci)","lang":"en","subjectScheme":"arXiv"},{"subject":"FOS: Physical sciences","subjectScheme":"Fields of Science and Technology (FOS)"},{"schemeUri":"http://www.oecd.org/science/inno/38235147.pdf","subject":"FOS: Physical sciences","subjectScheme":"Fields of Science and Technology (FOS)"}],"contributors":[],"dates":[{"date":"2026-02-23T15:34:48Z","dateType":"Submitted","dateInformation":"v1"},{"date":"2026-02-24T02:34:47Z","dateType":"Updated","dateInformation":"v1"},{"date":"2026-02","dateType":"Available","dateInformation":"v1"},{"date":"2026","dateType":"Issued"}],"language":null,"types":{"schemaOrg":"CreativeWork","resourceTypeGeneral":"Preprint","citeproc":"article","bibtex":"misc","ris":"GEN","resourceType":"Article"},"relatedIdentifiers":[],"relatedItems":[],"sizes":[],"formats":[],"version":"1","rightsList":[{"rightsIdentifierScheme":"SPDX","rightsUri":"https://creativecommons.org/licenses/by/4.0/legalcode","schemeUri":"https://spdx.org/licenses/","rights":"Creative Commons Attribution 4.0 International","rightsIdentifier":"cc-by-4.0"}],"descriptions":[{"descriptionType":"Abstract","description":"Controlling the properties and thus the functionalities of correlated electron systems via externally tunable perturbations has always remained a cherished goal in quantum condensed matter physics. Recently, straintronics has proved to be one such external control which can dictate the quantum phases and transitions in materials via the reconstruction of their electronic band structure. A particularly intriguing scenario arises in the context of flat band line-graph lattices wherein straintronics is found to bring forth non trivial phase transitions. This paper reports the phase transitions and thermal scales across the Lieb/Kagome interconversion in the electronic interaction-strain-temperature space. Based on the thermodynamic, spectroscopic and transport signatures across the strain tuned interconversion of these line-graph lattices we have mapped out the low temperature phases and thermal transition scales, numerically determined using non perturbative calculations. While at the low temperatures, interaction-strain plane is spanned by magnetically correlated insulators, flat band induced weak transiently localized insulators and non Fermi liquid metallic phases, thermal fluctuations aid in to stabilize coexistent magnetic correlations. Apart from quantifying the magnetic transition scales in this system our results on the spectroscopic and transport signatures distill the strain tuned metal-insulator transition and crossover scales which exhibit variable transport scaling exponents."},{"descriptionType":"Other","description":"13 pages, 11 figures"}],"geoLocations":[],"fundingReferences":[],"url":"https://arxiv.org/abs/2602.19972","contentUrl":null,"metadataVersion":0,"schemaVersion":"http://datacite.org/schema/kernel-4","source":"mds","isActive":true,"state":"findable","reason":null,"viewCount":0,"downloadCount":0,"referenceCount":0,"citationCount":0,"partCount":0,"partOfCount":0,"versionCount":0,"versionOfCount":0,"created":"2026-02-25T15:22:37Z","registered":"2026-02-25T15:22:38Z","published":null,"updated":"2026-02-25T15:22:38Z"},"relationships":{"client":{"data":{"id":"arxiv.content","type":"clients"}}}},{"id":"10.48550/arxiv.2602.19971","type":"dois","attributes":{"doi":"10.48550/arxiv.2602.19971","identifiers":[{"identifier":"2602.19971","identifierType":"arXiv"}],"creators":[{"nameType":"Personal","givenName":"Roland","familyName":"Combescot","name":"Combescot, Roland","affiliation":[],"nameIdentifiers":[]}],"titles":[{"title":"Two components relativistic quantum wave equation for scalar bosons"}],"publisher":"arXiv","container":{},"publicationYear":2026,"subjects":[{"subject":"Quantum Physics (quant-ph)","lang":"en","subjectScheme":"arXiv"},{"subject":"FOS: Physical sciences","subjectScheme":"Fields of Science and Technology (FOS)"},{"schemeUri":"http://www.oecd.org/science/inno/38235147.pdf","subject":"FOS: Physical sciences","subjectScheme":"Fields of Science and Technology (FOS)"}],"contributors":[],"dates":[{"date":"2026-02-23T15:34:31Z","dateType":"Submitted","dateInformation":"v1"},{"date":"2026-02-24T02:34:47Z","dateType":"Updated","dateInformation":"v1"},{"date":"2026-02","dateType":"Available","dateInformation":"v1"},{"date":"2026","dateType":"Issued"}],"language":null,"types":{"schemaOrg":"CreativeWork","resourceTypeGeneral":"Preprint","citeproc":"article","bibtex":"misc","ris":"GEN","resourceType":"Article"},"relatedIdentifiers":[],"relatedItems":[],"sizes":[],"formats":[],"version":"1","rightsList":[{"rightsIdentifierScheme":"SPDX","rightsUri":"https://creativecommons.org/licenses/by/4.0/legalcode","schemeUri":"https://spdx.org/licenses/","rights":"Creative Commons Attribution 4.0 International","rightsIdentifier":"cc-by-4.0"}],"descriptions":[{"descriptionType":"Abstract","description":"We show that, in the relativistic regime, scalar bosons satisfy a quantum wave equation which is quite analogous to the Dirac equation. In contrast with the Klein-Gordon equation it is first order with respect to time derivation. It leads in a regular way to the standard Schrödinger equation in the non-relativistic limit. There are two components for the wave function in this representation for the scalar boson, in a way completely analogous to the four components for the spin $1/2$ fermion in the Dirac equation."},{"descriptionType":"Other","description":"3 pages"}],"geoLocations":[],"fundingReferences":[],"url":"https://arxiv.org/abs/2602.19971","contentUrl":null,"metadataVersion":0,"schemaVersion":"http://datacite.org/schema/kernel-4","source":"mds","isActive":true,"state":"findable","reason":null,"viewCount":0,"downloadCount":0,"referenceCount":0,"citationCount":0,"partCount":0,"partOfCount":0,"versionCount":0,"versionOfCount":0,"created":"2026-02-25T15:22:35Z","registered":"2026-02-25T15:22:35Z","published":null,"updated":"2026-02-25T15:22:35Z"},"relationships":{"client":{"data":{"id":"arxiv.content","type":"clients"}}}},{"id":"10.48550/arxiv.2602.19970","type":"dois","attributes":{"doi":"10.48550/arxiv.2602.19970","identifiers":[{"identifier":"2602.19970","identifierType":"arXiv"}],"creators":[{"nameType":"Personal","givenName":"Daniela","familyName":"Di Donato","name":"Di Donato, Daniela","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Luca","familyName":"Rondi","name":"Rondi, Luca","affiliation":[],"nameIdentifiers":[]}],"titles":[{"title":"Discretization and regularization for the reconstruction of inhomogeneities by scattering measurements"}],"publisher":"arXiv","container":{},"publicationYear":2026,"subjects":[{"subject":"Analysis of PDEs (math.AP)","lang":"en","subjectScheme":"arXiv"},{"subject":"Numerical Analysis (math.NA)","lang":"en","subjectScheme":"arXiv"},{"subject":"FOS: Mathematics","subjectScheme":"Fields of Science and Technology (FOS)"},{"schemeUri":"http://www.oecd.org/science/inno/38235147.pdf","subject":"FOS: Mathematics","subjectScheme":"Fields of Science and Technology (FOS)"},{"subject":"35R30 (primary), 49J45 35P25 (secondary)","lang":"en","subjectScheme":"MSC"}],"contributors":[],"dates":[{"date":"2026-02-23T15:34:00Z","dateType":"Submitted","dateInformation":"v1"},{"date":"2026-02-24T02:34:46Z","dateType":"Updated","dateInformation":"v1"},{"date":"2026-02","dateType":"Available","dateInformation":"v1"},{"date":"2026","dateType":"Issued"}],"language":null,"types":{"schemaOrg":"CreativeWork","resourceTypeGeneral":"Preprint","citeproc":"article","bibtex":"misc","ris":"GEN","resourceType":"Article"},"relatedIdentifiers":[],"relatedItems":[],"sizes":[],"formats":[],"version":"1","rightsList":[{"rightsUri":"http://arxiv.org/licenses/nonexclusive-distrib/1.0/","rights":"arXiv.org perpetual, non-exclusive license"}],"descriptions":[{"descriptionType":"Abstract","description":"We consider the inverse problem of reconstructing inhomogeneities by performing a finite number of scattering measurements of acoustic type in the time-harmonic setting. We set up the reconstruction as a fully discrete variational problem with regularization. Such a problem depends on a variety of parameters, that is, the number of measurements, the regularization parameter and the discretization parameter, namely the size of the mesh on which we discretize the unknown coefficients of the Helmholtz type equation modelling our physical system. We show, through a convergence analysis, that one can carefully choose these parameters in such a way that the solution to this discrete regularized minimum problem is a good approximation of the looked-for solution to the inverse problem."},{"descriptionType":"Other","description":"22 pages"}],"geoLocations":[],"fundingReferences":[],"url":"https://arxiv.org/abs/2602.19970","contentUrl":null,"metadataVersion":0,"schemaVersion":"http://datacite.org/schema/kernel-4","source":"mds","isActive":true,"state":"findable","reason":null,"viewCount":0,"downloadCount":0,"referenceCount":0,"citationCount":0,"partCount":0,"partOfCount":0,"versionCount":0,"versionOfCount":0,"created":"2026-02-25T15:22:32Z","registered":"2026-02-25T15:22:33Z","published":null,"updated":"2026-02-25T15:22:33Z"},"relationships":{"client":{"data":{"id":"arxiv.content","type":"clients"}}}},{"id":"10.48550/arxiv.2602.19969","type":"dois","attributes":{"doi":"10.48550/arxiv.2602.19969","identifiers":[{"identifier":"2602.19969","identifierType":"arXiv"}],"creators":[{"nameType":"Personal","givenName":"Yuxing","familyName":"Tian","name":"Tian, Yuxing","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Fengran","familyName":"Mo","name":"Mo, Fengran","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Weixu","familyName":"Zhang","name":"Zhang, Weixu","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Yiyan","familyName":"Qi","name":"Qi, Yiyan","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Jian-Yun","familyName":"Nie","name":"Nie, Jian-Yun","affiliation":[],"nameIdentifiers":[]}],"titles":[{"title":"ReAttn: Improving Attention-based Re-ranking via Attention Re-weighting"}],"publisher":"arXiv","container":{},"publicationYear":2026,"subjects":[{"subject":"Computation and Language (cs.CL)","lang":"en","subjectScheme":"arXiv"},{"subject":"Artificial Intelligence (cs.AI)","lang":"en","subjectScheme":"arXiv"},{"subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"},{"schemeUri":"http://www.oecd.org/science/inno/38235147.pdf","subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"}],"contributors":[],"dates":[{"date":"2026-02-23T15:30:52Z","dateType":"Submitted","dateInformation":"v1"},{"date":"2026-02-24T02:34:36Z","dateType":"Updated","dateInformation":"v1"},{"date":"2026-02","dateType":"Available","dateInformation":"v1"},{"date":"2026","dateType":"Issued"}],"language":null,"types":{"schemaOrg":"CreativeWork","resourceTypeGeneral":"Preprint","citeproc":"article","bibtex":"misc","ris":"GEN","resourceType":"Article"},"relatedIdentifiers":[],"relatedItems":[],"sizes":[],"formats":[],"version":"1","rightsList":[{"rightsIdentifierScheme":"SPDX","rightsUri":"https://creativecommons.org/licenses/by/4.0/legalcode","schemeUri":"https://spdx.org/licenses/","rights":"Creative Commons Attribution 4.0 International","rightsIdentifier":"cc-by-4.0"}],"descriptions":[{"descriptionType":"Abstract","description":"The strong capabilities of recent Large Language Models (LLMs) have made them highly effective for zero-shot re-ranking task. Attention-based re-ranking methods, which derive relevance scores directly from attention weights, offer an efficient and interpretable alternative to generation-based re-ranking methods. However, they still face two major limitations. First, attention signals are highly concentrated a small subset of tokens within a few documents, making others indistinguishable. Second, attention often overemphasizes phrases lexically similar to the query, yielding biased rankings that irrelevant documents with mere lexical resemblance are regarded as relevant. In this paper, we propose \\textbf{ReAttn}, a post-hoc re-weighting strategy for attention-based re-ranking methods. It first compute the cross-document IDF weighting to down-weight attention on query-overlapping tokens that frequently appear across the candidate documents, reducing lexical bias and emphasizing distinctive terms. It then employs entropy-based regularization to mitigate over-concentrated attention, encouraging a more balanced distribution across informative tokens. Both adjustments operate directly on existing attention weights without additional training or supervision. Extensive experiments demonstrate the effectiveness of our method."},{"descriptionType":"Other","description":"Accepted by EACL2026"}],"geoLocations":[],"fundingReferences":[],"url":"https://arxiv.org/abs/2602.19969","contentUrl":null,"metadataVersion":0,"schemaVersion":"http://datacite.org/schema/kernel-4","source":"mds","isActive":true,"state":"findable","reason":null,"viewCount":0,"downloadCount":0,"referenceCount":0,"citationCount":0,"partCount":0,"partOfCount":0,"versionCount":0,"versionOfCount":0,"created":"2026-02-25T15:22:30Z","registered":"2026-02-25T15:22:30Z","published":null,"updated":"2026-02-25T15:22:30Z"},"relationships":{"client":{"data":{"id":"arxiv.content","type":"clients"}}}},{"id":"10.48550/arxiv.2602.19968","type":"dois","attributes":{"doi":"10.48550/arxiv.2602.19968","identifiers":[{"identifier":"2602.19968","identifierType":"arXiv"}],"creators":[{"nameType":"Personal","givenName":"Frank","familyName":"Brückerhoff-Plückelmann","name":"Brückerhoff-Plückelmann, Frank","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Anna P.","familyName":"Ovvyan","name":"Ovvyan, Anna P.","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Akhil","familyName":"Varri","name":"Varri, Akhil","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Hendrik","familyName":"Borras","name":"Borras, Hendrik","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Bernhard","familyName":"Klein","name":"Klein, Bernhard","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"C. David","familyName":"Wright","name":"Wright, C. David","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Harish","familyName":"Bhaskaran","name":"Bhaskaran, Harish","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Ghazi Sarwat","familyName":"Syed","name":"Syed, Ghazi Sarwat","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Abu","familyName":"Sebastian","name":"Sebastian, Abu","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Holger","familyName":"Fröning","name":"Fröning, Holger","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Wolfram","familyName":"Pernice","name":"Pernice, Wolfram","affiliation":[],"nameIdentifiers":[]}],"titles":[{"title":"Probabilistic Photonic Computing"}],"publisher":"arXiv","container":{},"publicationYear":2026,"subjects":[{"subject":"Applied Physics (physics.app-ph)","lang":"en","subjectScheme":"arXiv"},{"subject":"FOS: Physical sciences","subjectScheme":"Fields of Science and Technology (FOS)"},{"schemeUri":"http://www.oecd.org/science/inno/38235147.pdf","subject":"FOS: Physical sciences","subjectScheme":"Fields of Science and Technology (FOS)"}],"contributors":[],"dates":[{"date":"2026-02-23T15:30:34Z","dateType":"Submitted","dateInformation":"v1"},{"date":"2026-02-24T02:34:35Z","dateType":"Updated","dateInformation":"v1"},{"date":"2026-02","dateType":"Available","dateInformation":"v1"},{"date":"2026","dateType":"Issued"}],"language":null,"types":{"schemaOrg":"CreativeWork","resourceTypeGeneral":"Preprint","citeproc":"article","bibtex":"misc","ris":"GEN","resourceType":"Article"},"relatedIdentifiers":[],"relatedItems":[],"sizes":[],"formats":[],"version":"1","rightsList":[{"rightsIdentifierScheme":"SPDX","rightsUri":"https://creativecommons.org/licenses/by-nc-nd/4.0/legalcode","schemeUri":"https://spdx.org/licenses/","rights":"Creative Commons Attribution Non Commercial No Derivatives 4.0 International","rightsIdentifier":"cc-by-nc-nd-4.0"}],"descriptions":[{"descriptionType":"Abstract","description":"Probabilistic computing excels in approximating combinatorial problems and modelling uncertainty. However, using conventional deterministic hardware for probabilistic models is challenging: (pseudo) random number generation introduces computational overhead and additional data shuffling, which is particularly detrimental for safety-critical applications requiring low latency such as autonomous driving. Therefore, there is a pressing need for innovative probabilistic computing architectures that achieve low latencies with reasonable energy consumption. Physical computing offers a promising solution, as these systems do not rely on an abstract deterministic representation of data but directly encode the information in physical quantities. Therefore, they can be seamlessly integrated with physical entropy sources, enabling inherent probabilistic architectures. Photonic computing is a prominent variant due to the large available bandwidth, several orthogonal degrees of freedom for data encoding and optimal properties for in-memory computing and parallel data transfer. Here, we highlight key developments in physical photonic computing and photonic random number generation. We provide insights into the realization of probabilistic photonic processors and lend our perspective on their impact on AI systems and future challenges."}],"geoLocations":[],"fundingReferences":[],"url":"https://arxiv.org/abs/2602.19968","contentUrl":null,"metadataVersion":0,"schemaVersion":"http://datacite.org/schema/kernel-4","source":"mds","isActive":true,"state":"findable","reason":null,"viewCount":0,"downloadCount":0,"referenceCount":0,"citationCount":0,"partCount":0,"partOfCount":0,"versionCount":0,"versionOfCount":0,"created":"2026-02-25T15:22:27Z","registered":"2026-02-25T15:22:28Z","published":null,"updated":"2026-02-25T15:22:28Z"},"relationships":{"client":{"data":{"id":"arxiv.content","type":"clients"}}}},{"id":"10.48550/arxiv.2602.19966","type":"dois","attributes":{"doi":"10.48550/arxiv.2602.19966","identifiers":[{"identifier":"2602.19966","identifierType":"arXiv"}],"creators":[{"nameType":"Personal","givenName":"Joydeep","familyName":"Chandra","name":"Chandra, Joydeep","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Satyam Kumar","familyName":"Navneet","name":"Navneet, Satyam Kumar","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Yong","familyName":"Zhang","name":"Zhang, Yong","affiliation":[],"nameIdentifiers":[]}],"titles":[{"title":"GazeFlow: Personalized Ambient Soundscape Generation for Passive Strabismus Self-Monitoring"}],"publisher":"arXiv","container":{},"publicationYear":2026,"subjects":[{"subject":"Human-Computer Interaction (cs.HC)","lang":"en","subjectScheme":"arXiv"},{"subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"},{"schemeUri":"http://www.oecd.org/science/inno/38235147.pdf","subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"}],"contributors":[],"dates":[{"date":"2026-02-23T15:28:55Z","dateType":"Submitted","dateInformation":"v1"},{"date":"2026-02-24T02:34:26Z","dateType":"Updated","dateInformation":"v1"},{"date":"2026-02","dateType":"Available","dateInformation":"v1"},{"date":"2026","dateType":"Issued"}],"language":null,"types":{"schemaOrg":"CreativeWork","resourceTypeGeneral":"Preprint","citeproc":"article","bibtex":"misc","ris":"GEN","resourceType":"Article"},"relatedIdentifiers":[],"relatedItems":[],"sizes":[],"formats":[],"version":"1","rightsList":[{"rightsIdentifierScheme":"SPDX","rightsUri":"https://creativecommons.org/licenses/by/4.0/legalcode","schemeUri":"https://spdx.org/licenses/","rights":"Creative Commons Attribution 4.0 International","rightsIdentifier":"cc-by-4.0"}],"descriptions":[{"descriptionType":"Abstract","description":"Strabismus affects 2-4% of the population, yet individuals recovering from corrective surgery lack accessible tools for monitoring eye alignment. Dichoptic therapies require active engagement \u0026amp; clinical supervision, limiting their adoption for passive self-awareness. We present GazeFlow, a browser-based self-monitoring system that uses a personalized temporal autoencoder to detect eye drift patterns from webcam-based gaze tracking \u0026amp; provides ambient audio feedback. Unlike alert-based systems, GazeFlow operates according to calm computing principles, morphing musical parameters in proportion to drift severity while remaining in peripheral awareness. We address the challenges of inter-individual variability \u0026amp; domain transfer (1000Hz research to 30Hz webcam) by introducing Binocular Temporal-Frequency Disentanglement (BTFD), Contrastive Biometric Pre-training (CBP), \u0026amp; Gaze-MAML. We validate our approach on the GazeBase dataset (N=50) achieving F1=0.84 for drift detection, \u0026amp; conduct a preliminary user study (N=6) with participants having intermittent strabismus. Participants reported increased awareness of their eye behaviour (M=5.8/7) \u0026amp; preference for ambient feedback over alerts (M=6.2/7). We discuss the system's potential for self-awareness applications \u0026amp; outline directions for clinical validation."}],"geoLocations":[],"fundingReferences":[],"url":"https://arxiv.org/abs/2602.19966","contentUrl":null,"metadataVersion":0,"schemaVersion":"http://datacite.org/schema/kernel-4","source":"mds","isActive":true,"state":"findable","reason":null,"viewCount":0,"downloadCount":0,"referenceCount":0,"citationCount":0,"partCount":0,"partOfCount":0,"versionCount":0,"versionOfCount":0,"created":"2026-02-25T15:22:23Z","registered":"2026-02-25T15:22:23Z","published":null,"updated":"2026-02-25T15:22:23Z"},"relationships":{"client":{"data":{"id":"arxiv.content","type":"clients"}}}},{"id":"10.48550/arxiv.2602.19965","type":"dois","attributes":{"doi":"10.48550/arxiv.2602.19965","identifiers":[{"identifier":"2602.19965","identifierType":"arXiv"}],"creators":[{"nameType":"Personal","givenName":"Sarah","familyName":"Reiss","name":"Reiss, Sarah","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Tobias","familyName":"Knopp","name":"Knopp, Tobias","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Justin","familyName":"Ackers","name":"Ackers, Justin","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Jonas","familyName":"Faltinath","name":"Faltinath, Jonas","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Fabian","familyName":"Mohn","name":"Mohn, Fabian","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Marija","familyName":"Boberg","name":"Boberg, Marija","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Nora","familyName":"Timm","name":"Timm, Nora","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Martin","familyName":"Möddel","name":"Möddel, Martin","affiliation":[],"nameIdentifiers":[]}],"titles":[{"title":"Parameter Estimation for Model-Based Sensing of Magneto-Mechanical Resonators"}],"publisher":"arXiv","container":{},"publicationYear":2026,"subjects":[{"subject":"Applied Physics (physics.app-ph)","lang":"en","subjectScheme":"arXiv"},{"subject":"FOS: Physical sciences","subjectScheme":"Fields of Science and Technology (FOS)"},{"schemeUri":"http://www.oecd.org/science/inno/38235147.pdf","subject":"FOS: Physical sciences","subjectScheme":"Fields of Science and Technology (FOS)"}],"contributors":[],"dates":[{"date":"2026-02-23T15:28:50Z","dateType":"Submitted","dateInformation":"v1"},{"date":"2026-02-24T02:34:24Z","dateType":"Updated","dateInformation":"v1"},{"date":"2026-02","dateType":"Available","dateInformation":"v1"},{"date":"2026","dateType":"Issued"}],"language":null,"types":{"schemaOrg":"CreativeWork","resourceTypeGeneral":"Preprint","citeproc":"article","bibtex":"misc","ris":"GEN","resourceType":"Article"},"relatedIdentifiers":[],"relatedItems":[],"sizes":[],"formats":[],"version":"1","rightsList":[{"rightsIdentifierScheme":"SPDX","rightsUri":"https://creativecommons.org/licenses/by/4.0/legalcode","schemeUri":"https://spdx.org/licenses/","rights":"Creative Commons Attribution 4.0 International","rightsIdentifier":"cc-by-4.0"}],"descriptions":[{"descriptionType":"Abstract","description":"Magneto-mechanical resonators (MMRs) represent a recently proposed type of passive sensor that enables the estimation of its pose as well as sensing other parameters in its environment. The working principle of MMRs entails an excitation of the sensors by oscillating magnetic fields, followed by a readout process facilitated by inductive receiver coils. The sensing technology relies on real-time parameter estimation. This encompasses the solution of a nonlinear inverse problem, with the induced signals and a suitable forward model as inputs. The aim of this paper is twofold: first, to introduce a reference model and simplified models for the MMR dynamics and inductive readout, and second, to provide robust and real-time capable methods to estimate the model parameters. The effectiveness of the presented methods is evaluated in terms of their real-time potential, precision, and accuracy. All presented methods demonstrate the capacity to estimate the measured signal, with the simplified methods reducing the corresponding parameter estimation time by up to two orders of magnitude at the expense of less than 4 % deviation for large maximum deflection angles."},{"descriptionType":"Other","description":"This work has been submitted for potential publication"}],"geoLocations":[],"fundingReferences":[],"url":"https://arxiv.org/abs/2602.19965","contentUrl":null,"metadataVersion":0,"schemaVersion":"http://datacite.org/schema/kernel-4","source":"mds","isActive":true,"state":"findable","reason":null,"viewCount":0,"downloadCount":0,"referenceCount":1,"citationCount":0,"partCount":0,"partOfCount":0,"versionCount":0,"versionOfCount":0,"created":"2026-02-25T15:22:20Z","registered":"2026-02-25T15:22:21Z","published":null,"updated":"2026-02-25T15:22:21Z"},"relationships":{"client":{"data":{"id":"arxiv.content","type":"clients"}}}},{"id":"10.48550/arxiv.2602.19963","type":"dois","attributes":{"doi":"10.48550/arxiv.2602.19963","identifiers":[{"identifier":"2602.19963","identifierType":"arXiv"}],"creators":[{"nameType":"Personal","givenName":"Zhengrong","familyName":"Xie","name":"Xie, Zhengrong","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Zheng","familyName":"Li","name":"Li, Zheng","affiliation":[],"nameIdentifiers":[]}],"titles":[{"title":"On the Spectral Properties of Van Leer and AUSM Flux-Vector Splitting Schemes"}],"publisher":"arXiv","container":{},"publicationYear":2026,"subjects":[{"subject":"Numerical Analysis (math.NA)","lang":"en","subjectScheme":"arXiv"},{"subject":"FOS: Mathematics","subjectScheme":"Fields of Science and Technology (FOS)"},{"schemeUri":"http://www.oecd.org/science/inno/38235147.pdf","subject":"FOS: Mathematics","subjectScheme":"Fields of Science and Technology (FOS)"},{"subject":"35Q31, 65M12, 35L65, 47A75, 15A18","lang":"en","subjectScheme":"MSC"}],"contributors":[],"dates":[{"date":"2026-02-23T15:28:15Z","dateType":"Submitted","dateInformation":"v1"},{"date":"2026-02-24T02:34:22Z","dateType":"Updated","dateInformation":"v1"},{"date":"2026-02","dateType":"Available","dateInformation":"v1"},{"date":"2026","dateType":"Issued"}],"language":null,"types":{"schemaOrg":"CreativeWork","resourceTypeGeneral":"Preprint","citeproc":"article","bibtex":"misc","ris":"GEN","resourceType":"Article"},"relatedIdentifiers":[],"relatedItems":[],"sizes":[],"formats":[],"version":"1","rightsList":[{"rightsUri":"http://arxiv.org/licenses/nonexclusive-distrib/1.0/","rights":"arXiv.org perpetual, non-exclusive license"}],"descriptions":[{"descriptionType":"Abstract","description":"The flux-vector splitting scheme of Van Leer is a cornerstone of computational fluid dynamics, yet its original proof of the eigenvalue sign condition was presented in a condensed form. In this work, we provide a detailed and rigorous analysis of the eigenvalues of the Jacobian matrices associated with the Van Leer splitting for the one-dimensional Euler equations. By constructing the Sturm sequence of the discriminant, we prove that for the admissible parameter range $1 \\le γ\\le 3$, $|M|\u0026lt;1$, and $a\u0026gt;0$, the Jacobian $\\partial F^+/\\partial U$ has one zero eigenvalue and two positive real eigenvalues, confirming Van Leer's original claim. Furthermore, we extend our analysis to two variants of the original AUSM scheme (Advection Upstream Splitting Method) proposed by Liou and Steffen, considering both linear and second-order pressure splittings. For the linear pressure splitting we show that the eigenvalues are not all of the same sign, while for the second-order pressure splitting we prove that all coefficients of the characteristic equation are positive. Numerical experiments reported in the appendix confirm the non-negativity of the discriminant for the AUSM with the second-order pressure splitting, implying that its eigenvalues are real and positive."}],"geoLocations":[],"fundingReferences":[],"url":"https://arxiv.org/abs/2602.19963","contentUrl":null,"metadataVersion":0,"schemaVersion":"http://datacite.org/schema/kernel-4","source":"mds","isActive":true,"state":"findable","reason":null,"viewCount":0,"downloadCount":0,"referenceCount":0,"citationCount":0,"partCount":0,"partOfCount":0,"versionCount":0,"versionOfCount":0,"created":"2026-02-25T15:22:15Z","registered":"2026-02-25T15:22:16Z","published":null,"updated":"2026-02-25T15:22:16Z"},"relationships":{"client":{"data":{"id":"arxiv.content","type":"clients"}}}},{"id":"10.48550/arxiv.2602.19959","type":"dois","attributes":{"doi":"10.48550/arxiv.2602.19959","identifiers":[{"identifier":"2602.19959","identifierType":"arXiv"}],"creators":[{"nameType":"Personal","givenName":"Simon","familyName":"Akar","name":"Akar, Simon","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Mohamed","familyName":"Elashri","name":"Elashri, Mohamed","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Conor","familyName":"Henderson","name":"Henderson, Conor","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Michael","familyName":"Sokoloff","name":"Sokoloff, Michael","affiliation":[],"nameIdentifiers":[]}],"titles":[{"title":"Deploying a Hybrid PVFinder Algorithm for Primary Vertex Reconstruction in LHCb's GPU-Resident HLT1"}],"publisher":"arXiv","container":{},"publicationYear":2026,"subjects":[{"subject":"High Energy Physics - Experiment (hep-ex)","lang":"en","subjectScheme":"arXiv"},{"subject":"FOS: Physical sciences","subjectScheme":"Fields of Science and Technology (FOS)"},{"schemeUri":"http://www.oecd.org/science/inno/38235147.pdf","subject":"FOS: Physical sciences","subjectScheme":"Fields of Science and Technology (FOS)"}],"contributors":[],"dates":[{"date":"2026-02-23T15:26:49Z","dateType":"Submitted","dateInformation":"v1"},{"date":"2026-02-24T02:34:14Z","dateType":"Updated","dateInformation":"v1"},{"date":"2026-02","dateType":"Available","dateInformation":"v1"},{"date":"2026","dateType":"Issued"}],"language":null,"types":{"schemaOrg":"CreativeWork","resourceTypeGeneral":"Preprint","citeproc":"article","bibtex":"misc","ris":"GEN","resourceType":"Article"},"relatedIdentifiers":[],"relatedItems":[],"sizes":[],"formats":[],"version":"1","rightsList":[{"rightsIdentifierScheme":"SPDX","rightsUri":"https://creativecommons.org/licenses/by/4.0/legalcode","schemeUri":"https://spdx.org/licenses/","rights":"Creative Commons Attribution 4.0 International","rightsIdentifier":"cc-by-4.0"}],"descriptions":[{"descriptionType":"Abstract","description":"LHCb's Run 3 upgrade introduced a fully software-based trigger system operating at 30~MHz, processing an average of 5.6 proton-proton collision vertices per bunch crossing (event). This work presents the development of an inference engine for PVFinder, a hybrid deep neural network for finding primary vertices, the proton-proton collision points from which all subsequent particle decays originate into Allen, LHCb's High Level Trigger (HLT1) framework. The integration addresses critical real-time constraints including fixed memory pools, single-stream execution, and sub-400~$μ$s per-event processing budgets on NVIDIA GPUs. We introduce a translation layer that bridges Allen's Structure-of-Arrays (SoA) data layout with cuDNN's tensor format while maintaining zero-copy semantics and deterministic behavior. Current performance shows the CNN stage contributes significant throughput overhead. We present a roadmap targeting order-of-magnitude improvements through mixed-precision computing, model compression and other techniques."},{"descriptionType":"Other","description":"Contribution to the proceedings of the Connecting the Dots Workshop"}],"geoLocations":[],"fundingReferences":[],"url":"https://arxiv.org/abs/2602.19959","contentUrl":null,"metadataVersion":0,"schemaVersion":"http://datacite.org/schema/kernel-4","source":"mds","isActive":true,"state":"findable","reason":null,"viewCount":0,"downloadCount":0,"referenceCount":0,"citationCount":0,"partCount":0,"partOfCount":0,"versionCount":0,"versionOfCount":0,"created":"2026-02-25T15:22:05Z","registered":"2026-02-25T15:22:06Z","published":null,"updated":"2026-02-25T15:22:06Z"},"relationships":{"client":{"data":{"id":"arxiv.content","type":"clients"}}}},{"id":"10.48550/arxiv.2602.19957","type":"dois","attributes":{"doi":"10.48550/arxiv.2602.19957","identifiers":[{"identifier":"2602.19957","identifierType":"arXiv"}],"creators":[{"nameType":"Personal","givenName":"Ivonne","familyName":"Bente","name":"Bente, Ivonne","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Shabnam","familyName":"Taheriniya","name":"Taheriniya, Shabnam","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Francesco","familyName":"Lenzini","name":"Lenzini, Francesco","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Frank","familyName":"Brückerhoff-Plückelmann","name":"Brückerhoff-Plückelmann, Frank","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Michael","familyName":"Kues","name":"Kues, Michael","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Harish","familyName":"Bhaskaran","name":"Bhaskaran, Harish","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"C David","familyName":"Wright","name":"Wright, C David","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Wolfram","familyName":"Pernice","name":"Pernice, Wolfram","affiliation":[],"nameIdentifiers":[]}],"titles":[{"title":"Multidimensional photonic computing"}],"publisher":"arXiv","container":{},"publicationYear":2026,"subjects":[{"subject":"Applied Physics (physics.app-ph)","lang":"en","subjectScheme":"arXiv"},{"subject":"FOS: Physical sciences","subjectScheme":"Fields of Science and Technology (FOS)"},{"schemeUri":"http://www.oecd.org/science/inno/38235147.pdf","subject":"FOS: Physical sciences","subjectScheme":"Fields of Science and Technology (FOS)"}],"contributors":[],"dates":[{"date":"2026-02-23T15:24:59Z","dateType":"Submitted","dateInformation":"v1"},{"date":"2026-02-24T02:34:12Z","dateType":"Updated","dateInformation":"v1"},{"date":"2026-02","dateType":"Available","dateInformation":"v1"},{"date":"2026","dateType":"Issued"}],"language":null,"types":{"schemaOrg":"CreativeWork","resourceTypeGeneral":"Preprint","citeproc":"article","bibtex":"misc","ris":"GEN","resourceType":"Article"},"relatedIdentifiers":[],"relatedItems":[],"sizes":[],"formats":[],"version":"1","rightsList":[{"rightsIdentifierScheme":"SPDX","rightsUri":"https://creativecommons.org/licenses/by-nc-nd/4.0/legalcode","schemeUri":"https://spdx.org/licenses/","rights":"Creative Commons Attribution Non Commercial No Derivatives 4.0 International","rightsIdentifier":"cc-by-nc-nd-4.0"}],"descriptions":[{"descriptionType":"Abstract","description":"The rapidly increasing demands for computational throughput, bandwidth, and memory capacity fueled by breakthroughs in machine learning pose substantial challenges for conventional electronic computing platforms. For digital scaling to keep pace with the accelerating growth of artificial intelligence (AI) models beyond the trajectory of Moores law, computational power has to double roughly every three months. Historically, advancing compute performance relied on spatial scaling to increase the transistor count on a given chip area and, more recently, the development of parallel and multi-core architectures. Exponential scaling on trajectories much steeper than what can be achieved by such conventional strategies, and in line with the demands of AI, can be achieved with computing platforms that process data using multiple, orthogonal dimensions available to photons. Here we elucidate pivotal developments in the realization of multidimensional computing platforms based on photonic systems. Moving to such architectures holds enormous promise for low-latency, high-bandwidth information processing at reduced energy consumption."}],"geoLocations":[],"fundingReferences":[],"url":"https://arxiv.org/abs/2602.19957","contentUrl":null,"metadataVersion":0,"schemaVersion":"http://datacite.org/schema/kernel-4","source":"mds","isActive":true,"state":"findable","reason":null,"viewCount":0,"downloadCount":0,"referenceCount":0,"citationCount":0,"partCount":0,"partOfCount":0,"versionCount":0,"versionOfCount":0,"created":"2026-02-25T15:22:01Z","registered":"2026-02-25T15:22:01Z","published":null,"updated":"2026-02-25T15:22:01Z"},"relationships":{"client":{"data":{"id":"arxiv.content","type":"clients"}}}},{"id":"10.48550/arxiv.2602.19956","type":"dois","attributes":{"doi":"10.48550/arxiv.2602.19956","identifiers":[{"identifier":"2602.19956","identifierType":"arXiv"}],"creators":[{"nameType":"Personal","givenName":"Caroline","familyName":"Horsch","name":"Horsch, Caroline","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Laurens","familyName":"Engwegen","name":"Engwegen, Laurens","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Max","familyName":"Weltevrede","name":"Weltevrede, Max","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Matthijs T. J.","familyName":"Spaan","name":"Spaan, Matthijs T. J.","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Wendelin","familyName":"Böhmer","name":"Böhmer, Wendelin","affiliation":[],"nameIdentifiers":[]}],"titles":[{"title":"Sparse Masked Attention Policies for Reliable Generalization"}],"publisher":"arXiv","container":{},"publicationYear":2026,"subjects":[{"subject":"Machine Learning (cs.LG)","lang":"en","subjectScheme":"arXiv"},{"subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"},{"schemeUri":"http://www.oecd.org/science/inno/38235147.pdf","subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"}],"contributors":[],"dates":[{"date":"2026-02-23T15:23:17Z","dateType":"Submitted","dateInformation":"v1"},{"date":"2026-02-24T02:34:10Z","dateType":"Updated","dateInformation":"v1"},{"date":"2026-02","dateType":"Available","dateInformation":"v1"},{"date":"2026","dateType":"Issued"}],"language":null,"types":{"schemaOrg":"CreativeWork","resourceTypeGeneral":"Preprint","citeproc":"article","bibtex":"misc","ris":"GEN","resourceType":"Article"},"relatedIdentifiers":[],"relatedItems":[],"sizes":[],"formats":[],"version":"1","rightsList":[{"rightsIdentifierScheme":"SPDX","rightsUri":"https://creativecommons.org/licenses/by/4.0/legalcode","schemeUri":"https://spdx.org/licenses/","rights":"Creative Commons Attribution 4.0 International","rightsIdentifier":"cc-by-4.0"}],"descriptions":[{"descriptionType":"Abstract","description":"In reinforcement learning, abstraction methods that remove unnecessary information from the observation are commonly used to learn policies which generalize better to unseen tasks. However, these methods often overlook a crucial weakness: the function which extracts the reduced-information representation has unknown generalization ability in unseen observations. In this paper, we address this problem by presenting an information removal method which more reliably generalizes to new states. We accomplish this by using a learned masking function which operates on, and is integrated with, the attention weights within an attention-based policy network. We demonstrate that our method significantly improves policy generalization to unseen tasks in the Procgen benchmark compared to standard PPO and masking approaches."}],"geoLocations":[],"fundingReferences":[],"url":"https://arxiv.org/abs/2602.19956","contentUrl":null,"metadataVersion":0,"schemaVersion":"http://datacite.org/schema/kernel-4","source":"mds","isActive":true,"state":"findable","reason":null,"viewCount":0,"downloadCount":0,"referenceCount":0,"citationCount":0,"partCount":0,"partOfCount":0,"versionCount":0,"versionOfCount":0,"created":"2026-02-25T15:21:58Z","registered":"2026-02-25T15:21:59Z","published":null,"updated":"2026-02-25T15:21:59Z"},"relationships":{"client":{"data":{"id":"arxiv.content","type":"clients"}}}},{"id":"10.48550/arxiv.2602.19955","type":"dois","attributes":{"doi":"10.48550/arxiv.2602.19955","identifiers":[{"identifier":"2602.19955","identifierType":"arXiv"}],"creators":[{"nameType":"Personal","givenName":"Daniela","familyName":"Pacilé","name":"Pacilé, Daniela","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Simone","familyName":"Lisi","name":"Lisi, Simone","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Iolanda","familyName":"Di Bernardo","name":"Di Bernardo, Iolanda","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"M.","familyName":"Papagno","name":"Papagno, M.","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"L.","familyName":"Ferrari","name":"Ferrari, L.","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Michele","familyName":"Pisarra","name":"Pisarra, Michele","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Marco","familyName":"Caputo","name":"Caputo, Marco","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"S. K.","familyName":"Mahatha","name":"Mahatha, S. K.","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"P. M.","familyName":"Sheverdyaeva","name":"Sheverdyaeva, P. M.","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"P.","familyName":"Moras","name":"Moras, P.","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"P.","familyName":"Lacovig","name":"Lacovig, P.","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Silvano","familyName":"Lizzit","name":"Lizzit, Silvano","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Alessandro","familyName":"Baraldi","name":"Baraldi, Alessandro","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Maria Grazia","familyName":"Betti","name":"Betti, Maria Grazia","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Carlo","familyName":"Carbone","name":"Carbone, Carlo","affiliation":[],"nameIdentifiers":[]}],"titles":[{"title":"Electronic structure of Graphene/Co interfaces"}],"publisher":"arXiv","container":{},"publicationYear":2026,"subjects":[{"subject":"Materials Science (cond-mat.mtrl-sci)","lang":"en","subjectScheme":"arXiv"},{"subject":"FOS: Physical sciences","subjectScheme":"Fields of Science and Technology (FOS)"},{"schemeUri":"http://www.oecd.org/science/inno/38235147.pdf","subject":"FOS: Physical sciences","subjectScheme":"Fields of Science and Technology (FOS)"}],"contributors":[],"dates":[{"date":"2026-02-23T15:22:58Z","dateType":"Submitted","dateInformation":"v1"},{"date":"2026-02-24T02:34:09Z","dateType":"Updated","dateInformation":"v1"},{"date":"2026-02","dateType":"Available","dateInformation":"v1"},{"date":"2026","dateType":"Issued"}],"language":null,"types":{"schemaOrg":"CreativeWork","resourceTypeGeneral":"Preprint","citeproc":"article","bibtex":"misc","ris":"GEN","resourceType":"Article"},"relatedIdentifiers":[{"relationType":"IsVersionOf","relatedIdentifier":"10.1103/physrevb.90.195446","relatedIdentifierType":"DOI"}],"relatedItems":[],"sizes":[],"formats":[],"version":"1","rightsList":[{"rightsIdentifierScheme":"SPDX","rightsUri":"https://creativecommons.org/licenses/by-nc-nd/4.0/legalcode","schemeUri":"https://spdx.org/licenses/","rights":"Creative Commons Attribution Non Commercial No Derivatives 4.0 International","rightsIdentifier":"cc-by-nc-nd-4.0"}],"descriptions":[{"descriptionType":"Abstract","description":"Photoemission, from core levels and valence band, and low-energy electron diffraction (LEED) have been employed to investigate the electronic and structural properties of novel graphene-ferromagnetic (G-FM) systems,obtained by intercalation of one mono-layer (1ML) and several layers (4ML) of Co on G grown on Ir(111). Upon intercalation of 1ML of Co, the Co lattice is resized to match the Ir-Ir lattice parameter, resulting in a mismatched G/Co/Ir(111) system. The intercalation of further Co layers leads to a relaxation of the Co lattice and a progressive formation of a commensurate G layer lying on top. We show the C 1s line shape and the band structure of G in the two artificial phases, mismatched and commensurate G/Co, through a comparison with the electronic structure of G grown directly on a Co thick film. Our results show that while the G valence band mainly reflects the hybridization with the d states of Co, regardless of the structural phase, the C 1s line shape is very sensitive to the rumpling of the G layer and the coordination of carbon atoms with the underlying Co. Even in the commensurate (1x1) G/Co phase, where graphene is in register with the Co film, from the angular dependence of the C 1s core level we infer the presence of a double component, due to in-equivalent adsorption sites of carbon sub-lattices."}],"geoLocations":[],"fundingReferences":[],"url":"https://arxiv.org/abs/2602.19955","contentUrl":null,"metadataVersion":0,"schemaVersion":"http://datacite.org/schema/kernel-4","source":"mds","isActive":true,"state":"findable","reason":null,"viewCount":0,"downloadCount":0,"referenceCount":0,"citationCount":0,"partCount":0,"partOfCount":0,"versionCount":0,"versionOfCount":1,"created":"2026-02-25T15:21:56Z","registered":"2026-02-25T15:21:56Z","published":null,"updated":"2026-02-25T15:21:56Z"},"relationships":{"client":{"data":{"id":"arxiv.content","type":"clients"}}}},{"id":"10.48550/arxiv.2602.19954","type":"dois","attributes":{"doi":"10.48550/arxiv.2602.19954","identifiers":[{"identifier":"2602.19954","identifierType":"arXiv"}],"creators":[{"nameType":"Personal","givenName":"Eamonn","familyName":"Organ","name":"Organ, Eamonn","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Maeve","familyName":"Upton","name":"Upton, Maeve","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Denis","familyName":"Allard","name":"Allard, Denis","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Lionel","familyName":"Benoit","name":"Benoit, Lionel","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"James","familyName":"Sweeney","name":"Sweeney, James","affiliation":[],"nameIdentifiers":[]}],"titles":[{"title":"A Two-Step Spatio-Temporal Framework for Turbine-Height Wind Estimation at Unmonitored Sites from Sparse Meteorological Data"}],"publisher":"arXiv","container":{},"publicationYear":2026,"subjects":[{"subject":"Applications (stat.AP)","lang":"en","subjectScheme":"arXiv"},{"subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"},{"schemeUri":"http://www.oecd.org/science/inno/38235147.pdf","subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"}],"contributors":[],"dates":[{"date":"2026-02-23T15:22:39Z","dateType":"Submitted","dateInformation":"v1"},{"date":"2026-02-24T02:34:08Z","dateType":"Updated","dateInformation":"v1"},{"date":"2026-02","dateType":"Available","dateInformation":"v1"},{"date":"2026","dateType":"Issued"}],"language":null,"types":{"schemaOrg":"CreativeWork","resourceTypeGeneral":"Preprint","citeproc":"article","bibtex":"misc","ris":"GEN","resourceType":"Article"},"relatedIdentifiers":[],"relatedItems":[],"sizes":[],"formats":[],"version":"1","rightsList":[{"rightsIdentifierScheme":"SPDX","rightsUri":"https://creativecommons.org/licenses/by/4.0/legalcode","schemeUri":"https://spdx.org/licenses/","rights":"Creative Commons Attribution 4.0 International","rightsIdentifier":"cc-by-4.0"}],"descriptions":[{"descriptionType":"Abstract","description":"Accurate estimates of wind speeds at wind turbine hub heights are crucial for both wind resource assessment and day-to-day management of electricity grids with high renewable penetration. In the absence of direct measurements, parametric models are commonly used to extrapolate wind speeds from observed heights to turbine heights. Recent literature has proposed extensions to allow for spatially or temporally varying vertical wind gradients, that is, the rate at which wind speed changes with height. However, these approaches typically assume that reference height and hub height measurements are available at the same locations, which limits their applicability in operational settings where meteorological stations and wind farms are spatially separated. In this paper, we develop a two-step spatio-temporal framework to estimate turbine height wind speeds using only open-access observations from sparse meteorological stations. First, a non-parametric generalized additive model is trained on reanalysis data to perform vertical height extrapolation. Second, a spatial Gaussian process model interpolates these hub-height estimates to wind farm locations while explicitly propagating uncertainty from the height extrapolation stage. The proposed framework enables the construction of high-resolution, sub-hourly turbine-height wind speed time series and spatial wind maps using data available in real time, capabilities not provided by existing reanalysis products. We further provide calibrated uncertainty estimates that account for both vertical extrapolation and spatial interpolation errors. The approach is validated using hub-height measurements from seven operational wind farms in Ireland, demonstrating improved accuracy relative to ERA5 reanalysis while relying solely on real-time, open-access data."}],"geoLocations":[],"fundingReferences":[],"url":"https://arxiv.org/abs/2602.19954","contentUrl":null,"metadataVersion":0,"schemaVersion":"http://datacite.org/schema/kernel-4","source":"mds","isActive":true,"state":"findable","reason":null,"viewCount":0,"downloadCount":0,"referenceCount":0,"citationCount":0,"partCount":0,"partOfCount":0,"versionCount":0,"versionOfCount":0,"created":"2026-02-25T15:21:53Z","registered":"2026-02-25T15:21:54Z","published":null,"updated":"2026-02-25T15:21:54Z"},"relationships":{"client":{"data":{"id":"arxiv.content","type":"clients"}}}},{"id":"10.48550/arxiv.2602.19953","type":"dois","attributes":{"doi":"10.48550/arxiv.2602.19953","identifiers":[{"identifier":"2602.19953","identifierType":"arXiv"}],"creators":[{"nameType":"Personal","givenName":"Lei","familyName":"Ni","name":"Ni, Lei","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Jun","familyName":"Lin","name":"Lin, Jun","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Tanmoy","familyName":"Samanta","name":"Samanta, Tanmoy","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Guanchong","familyName":"Cheng","name":"Cheng, Guanchong","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Yifu","familyName":"Wang","name":"Wang, Yifu","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Robert","familyName":"Erdelyi","name":"Erdelyi, Robert","affiliation":[],"nameIdentifiers":[]}],"titles":[{"title":"Energy and mass transport associated with impulsive spicular flows in solar coronal holes"}],"publisher":"arXiv","container":{},"publicationYear":2026,"subjects":[{"subject":"Solar and Stellar Astrophysics (astro-ph.SR)","lang":"en","subjectScheme":"arXiv"},{"subject":"FOS: Physical sciences","subjectScheme":"Fields of Science and Technology (FOS)"},{"schemeUri":"http://www.oecd.org/science/inno/38235147.pdf","subject":"FOS: Physical sciences","subjectScheme":"Fields of Science and Technology (FOS)"}],"contributors":[],"dates":[{"date":"2026-02-23T15:21:42Z","dateType":"Submitted","dateInformation":"v1"},{"date":"2026-02-24T02:34:00Z","dateType":"Updated","dateInformation":"v1"},{"date":"2026-02","dateType":"Available","dateInformation":"v1"},{"date":"2026","dateType":"Issued"}],"language":null,"types":{"schemaOrg":"CreativeWork","resourceTypeGeneral":"Preprint","citeproc":"article","bibtex":"misc","ris":"GEN","resourceType":"Article"},"relatedIdentifiers":[],"relatedItems":[],"sizes":[],"formats":[],"version":"1","rightsList":[{"rightsIdentifierScheme":"SPDX","rightsUri":"https://creativecommons.org/licenses/by/4.0/legalcode","schemeUri":"https://spdx.org/licenses/","rights":"Creative Commons Attribution 4.0 International","rightsIdentifier":"cc-by-4.0"}],"descriptions":[{"descriptionType":"Abstract","description":"How the solar atmosphere is heated from a temperature of about $5,000-6,000$\\,K in the lower atmosphere to about $1-2$\\,MK in the corona has challenged the astrophysical community for about 80 years. The same puzzle exists for the stellar coronae heating as well. In this study, we present a series of findings on solar spicules and their subsequent impact on the corona within a coronal hole environment, characterized by locally open magnetic field lines, combining insights from MHD simulations with observations. We find that the convective and turbulent motions around the solar surface cause plenty of shocks and small-scale magnetic reconnection in the lower atmosphere. The combined effects of shock compression and reconnection outflows then drive the formation of groups of spicules with a quasi-period of about $300$\\,s and width of $\\sim 200-500$\\,km. The spicule upflows provide an averaged mass flux above $10^{-9}$\\,kg\\,m$^{-2}$\\,s$^{-1}$ in the lower corona to sustain the solar wind in coronal holes, and they continuously trigger further new local slow-mode waves and shocks. These waves supply an energy flux of $10-100$\\,W\\,m$^{-2}$ in the lower corona, and they are dissipated by heat conduction and compression heating to sustain the corona temperature of about $1$\\,MK. The results also indicate that the upward propagating disturbances (PDs) observed in extreme ultraviolet (EUV) passbands are caused by both spicule upflows and slow-mode waves and shocks. Our findings help to understand the long standing problem of coronal heating and the origin of solar winds in coronal hole regions."}],"geoLocations":[],"fundingReferences":[],"url":"https://arxiv.org/abs/2602.19953","contentUrl":null,"metadataVersion":0,"schemaVersion":"http://datacite.org/schema/kernel-4","source":"mds","isActive":true,"state":"findable","reason":null,"viewCount":0,"downloadCount":0,"referenceCount":0,"citationCount":0,"partCount":0,"partOfCount":0,"versionCount":0,"versionOfCount":0,"created":"2026-02-25T15:21:51Z","registered":"2026-02-25T15:21:52Z","published":null,"updated":"2026-02-25T15:21:52Z"},"relationships":{"client":{"data":{"id":"arxiv.content","type":"clients"}}}},{"id":"10.48550/arxiv.2602.19952","type":"dois","attributes":{"doi":"10.48550/arxiv.2602.19952","identifiers":[{"identifier":"2602.19952","identifierType":"arXiv"}],"creators":[{"nameType":"Personal","givenName":"Shayan","familyName":"Nazemi","name":"Nazemi, Shayan","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Aurélie","familyName":"Labbe","name":"Labbe, Aurélie","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Stefan","familyName":"Steiner","name":"Steiner, Stefan","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Pratheepa","familyName":"Jeganathan","name":"Jeganathan, Pratheepa","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Martin","familyName":"Trépanier","name":"Trépanier, Martin","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Léo R.","familyName":"Belzile","name":"Belzile, Léo R.","affiliation":[],"nameIdentifiers":[]}],"titles":[{"title":"A Bayesian Framework for Post-disruption Travel Time Prediction in Metro Networks"}],"publisher":"arXiv","container":{},"publicationYear":2026,"subjects":[{"subject":"Applications (stat.AP)","lang":"en","subjectScheme":"arXiv"},{"subject":"Methodology (stat.ME)","lang":"en","subjectScheme":"arXiv"},{"subject":"Machine Learning (stat.ML)","lang":"en","subjectScheme":"arXiv"},{"subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"},{"schemeUri":"http://www.oecd.org/science/inno/38235147.pdf","subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"}],"contributors":[],"dates":[{"date":"2026-02-23T15:20:46Z","dateType":"Submitted","dateInformation":"v1"},{"date":"2026-02-24T02:33:57Z","dateType":"Updated","dateInformation":"v1"},{"date":"2026-02","dateType":"Available","dateInformation":"v1"},{"date":"2026","dateType":"Issued"}],"language":null,"types":{"schemaOrg":"CreativeWork","resourceTypeGeneral":"Preprint","citeproc":"article","bibtex":"misc","ris":"GEN","resourceType":"Article"},"relatedIdentifiers":[],"relatedItems":[],"sizes":[],"formats":[],"version":"1","rightsList":[{"rightsUri":"http://arxiv.org/licenses/nonexclusive-distrib/1.0/","rights":"arXiv.org perpetual, non-exclusive license"}],"descriptions":[{"descriptionType":"Abstract","description":"Disruptions are an inherent feature of transportation systems, occurring unpredictably and with varying durations. Even after an incident is reported as resolved, disruptions can induce irregular train operations that generate substantial uncertainty in passenger waiting and travel times. Accurately forecasting post-disruption travel times therefore remains a critical challenge for transit operators and passenger information systems. This paper develops a Bayesian spatiotemporal modeling framework for post-disruption train travel times that explicitly captures train interactions, headway imbalance, and non-Gaussian distributional characteristics observed during recovery periods. The proposed model decomposes travel times into delay and journey components and incorporates a moving-average error structure to represent dependence between consecutive trains. Skew-normal and skew-$t$ distributions are employed to flexibly accommodate heteroskedasticity, skewness, and heavy-tailed behavior in post-disruption travel times. The framework is evaluated using high-resolution track-occupancy and disruption log data from the Montréal metro system, covering two lines in both travel directions. Empirical results indicate that post-disruption travel times exhibit pronounced distributional asymmetries that vary with traveled distance, as well as significant error dependence across trains. The proposed models consistently outperform baseline specifications in both point prediction accuracy and uncertainty quantification, with the skew-$t$ model demonstrating the most robust performance for longer journeys. These findings underscore the importance of incorporating both distributional flexibility and error dependence when forecasting post-disruption travel times in urban rail systems."}],"geoLocations":[],"fundingReferences":[],"url":"https://arxiv.org/abs/2602.19952","contentUrl":null,"metadataVersion":0,"schemaVersion":"http://datacite.org/schema/kernel-4","source":"mds","isActive":true,"state":"findable","reason":null,"viewCount":0,"downloadCount":0,"referenceCount":0,"citationCount":0,"partCount":0,"partOfCount":0,"versionCount":0,"versionOfCount":0,"created":"2026-02-25T15:21:48Z","registered":"2026-02-25T15:21:49Z","published":null,"updated":"2026-02-25T15:21:49Z"},"relationships":{"client":{"data":{"id":"arxiv.content","type":"clients"}}}},{"id":"10.48550/arxiv.2602.19950","type":"dois","attributes":{"doi":"10.48550/arxiv.2602.19950","identifiers":[{"identifier":"2602.19950","identifierType":"arXiv"}],"creators":[{"nameType":"Personal","givenName":"Peter","familyName":"Caradonna","name":"Caradonna, Peter","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Christopher","familyName":"Turansick","name":"Turansick, Christopher","affiliation":[],"nameIdentifiers":[]}],"titles":[{"title":"Identification in Stochastic Choice"}],"publisher":"arXiv","container":{},"publicationYear":2026,"subjects":[{"subject":"Theoretical Economics (econ.TH)","lang":"en","subjectScheme":"arXiv"},{"subject":"Combinatorics (math.CO)","lang":"en","subjectScheme":"arXiv"},{"subject":"FOS: Economics and business","subjectScheme":"Fields of Science and Technology (FOS)"},{"schemeUri":"http://www.oecd.org/science/inno/38235147.pdf","subject":"FOS: Economics and business","subjectScheme":"Fields of Science and Technology (FOS)"},{"subject":"FOS: Mathematics","subjectScheme":"Fields of Science and Technology (FOS)"},{"schemeUri":"http://www.oecd.org/science/inno/38235147.pdf","subject":"FOS: Mathematics","subjectScheme":"Fields of Science and Technology (FOS)"}],"contributors":[],"dates":[{"date":"2026-02-23T15:17:49Z","dateType":"Submitted","dateInformation":"v1"},{"date":"2026-02-24T02:33:53Z","dateType":"Updated","dateInformation":"v1"},{"date":"2026-02","dateType":"Available","dateInformation":"v1"},{"date":"2026","dateType":"Issued"}],"language":null,"types":{"schemaOrg":"CreativeWork","resourceTypeGeneral":"Preprint","citeproc":"article","bibtex":"misc","ris":"GEN","resourceType":"Article"},"relatedIdentifiers":[],"relatedItems":[],"sizes":[],"formats":[],"version":"1","rightsList":[{"rightsIdentifierScheme":"SPDX","rightsUri":"https://creativecommons.org/licenses/by-nc-sa/4.0/legalcode","schemeUri":"https://spdx.org/licenses/","rights":"Creative Commons Attribution Non Commercial Share Alike 4.0 International","rightsIdentifier":"cc-by-nc-sa-4.0"}],"descriptions":[{"descriptionType":"Abstract","description":"We characterize the identified sets of a wide range of stochastic choice models, including random utility, various models of boundedly-rational behavior, and dynamic discrete choice. In each of these settings, we show two distributions over choice rules are observationally equivalent if and only if they can be obtained from one another via a finite sequence of simple swapping transforms. We leverage this to obtain complete descriptions of both the defining inequalities and extreme points of these identified sets. In cases where choice frequencies vary smoothly with some parameters, we provide a novel global-inverse result for practically testing identification."}],"geoLocations":[],"fundingReferences":[],"url":"https://arxiv.org/abs/2602.19950","contentUrl":null,"metadataVersion":0,"schemaVersion":"http://datacite.org/schema/kernel-4","source":"mds","isActive":true,"state":"findable","reason":null,"viewCount":0,"downloadCount":0,"referenceCount":0,"citationCount":0,"partCount":0,"partOfCount":0,"versionCount":0,"versionOfCount":0,"created":"2026-02-25T15:21:44Z","registered":"2026-02-25T15:21:44Z","published":null,"updated":"2026-02-25T15:21:44Z"},"relationships":{"client":{"data":{"id":"arxiv.content","type":"clients"}}}},{"id":"10.48550/arxiv.2602.19947","type":"dois","attributes":{"doi":"10.48550/arxiv.2602.19947","identifiers":[{"identifier":"2602.19947","identifierType":"arXiv"}],"creators":[{"nameType":"Personal","givenName":"Taehun","familyName":"Kim","name":"Kim, Taehun","affiliation":[],"nameIdentifiers":[]}],"titles":[{"title":"On compressible magnetic relaxation in planar symmetry"}],"publisher":"arXiv","container":{},"publicationYear":2026,"subjects":[{"subject":"Analysis of PDEs (math.AP)","lang":"en","subjectScheme":"arXiv"},{"subject":"FOS: Mathematics","subjectScheme":"Fields of Science and Technology (FOS)"},{"schemeUri":"http://www.oecd.org/science/inno/38235147.pdf","subject":"FOS: Mathematics","subjectScheme":"Fields of Science and Technology (FOS)"},{"subject":"35Q35","lang":"en","subjectScheme":"MSC"}],"contributors":[],"dates":[{"date":"2026-02-23T15:16:13Z","dateType":"Submitted","dateInformation":"v1"},{"date":"2026-02-24T02:33:50Z","dateType":"Updated","dateInformation":"v1"},{"date":"2026-02","dateType":"Available","dateInformation":"v1"},{"date":"2026","dateType":"Issued"}],"language":null,"types":{"schemaOrg":"CreativeWork","resourceTypeGeneral":"Preprint","citeproc":"article","bibtex":"misc","ris":"GEN","resourceType":"Article"},"relatedIdentifiers":[],"relatedItems":[],"sizes":[],"formats":[],"version":"1","rightsList":[{"rightsIdentifierScheme":"SPDX","rightsUri":"https://creativecommons.org/licenses/by/4.0/legalcode","schemeUri":"https://spdx.org/licenses/","rights":"Creative Commons Attribution 4.0 International","rightsIdentifier":"cc-by-4.0"}],"descriptions":[{"descriptionType":"Abstract","description":"We consider the compressible Magnetic Relaxation Equations on the three-dimensional torus $\\mathbb{T}^{3}$. The system is derived from compressible magnetohydrodynamics (MHD) by replacing the acceleration term with a Darcy-type friction. Under planar symmetry, we establish three main results: (1) local well-posedness for smooth initial data, (2) magnetic relaxation for smooth perturbations of constant steady states, and (3) the absence of vacuum states or implosions prior to and at the time of a potential singularity."},{"descriptionType":"Other","description":"32 pages, 1 figure"}],"geoLocations":[],"fundingReferences":[],"url":"https://arxiv.org/abs/2602.19947","contentUrl":null,"metadataVersion":0,"schemaVersion":"http://datacite.org/schema/kernel-4","source":"mds","isActive":true,"state":"findable","reason":null,"viewCount":0,"downloadCount":0,"referenceCount":0,"citationCount":0,"partCount":0,"partOfCount":0,"versionCount":0,"versionOfCount":0,"created":"2026-02-25T15:21:36Z","registered":"2026-02-25T15:21:37Z","published":null,"updated":"2026-02-25T15:21:37Z"},"relationships":{"client":{"data":{"id":"arxiv.content","type":"clients"}}}},{"id":"10.48550/arxiv.2602.19944","type":"dois","attributes":{"doi":"10.48550/arxiv.2602.19944","identifiers":[{"identifier":"2602.19944","identifierType":"arXiv"}],"creators":[{"nameType":"Personal","givenName":"Yilong","familyName":"Yang","name":"Yang, Yilong","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Jianxin","familyName":"Tian","name":"Tian, Jianxin","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Shengchuan","familyName":"Zhang","name":"Zhang, Shengchuan","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Liujuan","familyName":"Cao","name":"Cao, Liujuan","affiliation":[],"nameIdentifiers":[]}],"titles":[{"title":"Discover, Segment, and Select: A Progressive Mechanism for Zero-shot Camouflaged Object Segmentation"}],"publisher":"arXiv","container":{},"publicationYear":2026,"subjects":[{"subject":"Computer Vision and Pattern Recognition (cs.CV)","lang":"en","subjectScheme":"arXiv"},{"subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"},{"schemeUri":"http://www.oecd.org/science/inno/38235147.pdf","subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"}],"contributors":[],"dates":[{"date":"2026-02-23T15:15:37Z","dateType":"Submitted","dateInformation":"v1"},{"date":"2026-02-24T02:33:42Z","dateType":"Updated","dateInformation":"v1"},{"date":"2026-02","dateType":"Available","dateInformation":"v1"},{"date":"2026","dateType":"Issued"}],"language":null,"types":{"schemaOrg":"CreativeWork","resourceTypeGeneral":"Preprint","citeproc":"article","bibtex":"misc","ris":"GEN","resourceType":"Article"},"relatedIdentifiers":[],"relatedItems":[],"sizes":[],"formats":[],"version":"1","rightsList":[{"rightsIdentifierScheme":"SPDX","rightsUri":"https://creativecommons.org/licenses/by/4.0/legalcode","schemeUri":"https://spdx.org/licenses/","rights":"Creative Commons Attribution 4.0 International","rightsIdentifier":"cc-by-4.0"}],"descriptions":[{"descriptionType":"Abstract","description":"Current zero-shot Camouflaged Object Segmentation methods typically employ a two-stage pipeline (discover-then-segment): using MLLMs to obtain visual prompts, followed by SAM segmentation. However, relying solely on MLLMs for camouflaged object discovery often leads to inaccurate localization, false positives, and missed detections. To address these issues, we propose the \\textbf{D}iscover-\\textbf{S}egment-\\textbf{S}elect (\\textbf{DSS}) mechanism, a progressive framework designed to refine segmentation step by step. The proposed method contains a Feature-coherent Object Discovery (FOD) module that leverages visual features to generate diverse object proposals, a segmentation module that refines these proposals through SAM segmentation, and a Semantic-driven Mask Selection (SMS) module that employs MLLMs to evaluate and select the optimal segmentation mask from multiple candidates. Without requiring any training or supervision, DSS achieves state-of-the-art performance on multiple COS benchmarks, especially in multiple-instance scenes."},{"descriptionType":"Other","description":"Accepted by CVPR 2026 (main conference)"}],"geoLocations":[],"fundingReferences":[],"url":"https://arxiv.org/abs/2602.19944","contentUrl":null,"metadataVersion":0,"schemaVersion":"http://datacite.org/schema/kernel-4","source":"mds","isActive":true,"state":"findable","reason":null,"viewCount":0,"downloadCount":0,"referenceCount":0,"citationCount":0,"partCount":0,"partOfCount":0,"versionCount":0,"versionOfCount":0,"created":"2026-02-25T15:21:29Z","registered":"2026-02-25T15:21:30Z","published":null,"updated":"2026-02-25T15:21:30Z"},"relationships":{"client":{"data":{"id":"arxiv.content","type":"clients"}}}},{"id":"10.48550/arxiv.2602.19943","type":"dois","attributes":{"doi":"10.48550/arxiv.2602.19943","identifiers":[{"identifier":"2602.19943","identifierType":"arXiv"}],"creators":[{"nameType":"Personal","givenName":"Abulikemu","familyName":"Abuduweili","name":"Abuduweili, Abulikemu","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Yuyang","familyName":"Pang","name":"Pang, Yuyang","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Feihan","familyName":"Li","name":"Li, Feihan","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Changliu","familyName":"Liu","name":"Liu, Changliu","affiliation":[],"nameIdentifiers":[]}],"titles":[{"title":"Scaling Law of Neural Koopman Operators"}],"publisher":"arXiv","container":{},"publicationYear":2026,"subjects":[{"subject":"Robotics (cs.RO)","lang":"en","subjectScheme":"arXiv"},{"subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"},{"schemeUri":"http://www.oecd.org/science/inno/38235147.pdf","subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"}],"contributors":[],"dates":[{"date":"2026-02-23T15:13:43Z","dateType":"Submitted","dateInformation":"v1"},{"date":"2026-02-24T02:33:35Z","dateType":"Updated","dateInformation":"v1"},{"date":"2026-02","dateType":"Available","dateInformation":"v1"},{"date":"2026","dateType":"Issued"}],"language":null,"types":{"schemaOrg":"CreativeWork","resourceTypeGeneral":"Preprint","citeproc":"article","bibtex":"misc","ris":"GEN","resourceType":"Article"},"relatedIdentifiers":[],"relatedItems":[],"sizes":[],"formats":[],"version":"1","rightsList":[{"rightsUri":"http://arxiv.org/licenses/nonexclusive-distrib/1.0/","rights":"arXiv.org perpetual, non-exclusive license"}],"descriptions":[{"descriptionType":"Abstract","description":"Data-driven neural Koopman operator theory has emerged as a powerful tool for linearizing and controlling nonlinear robotic systems. However, the performance of these data-driven models fundamentally depends on the trade-off between sample size and model dimensions, a relationship for which the scaling laws have remained unclear. This paper establishes a rigorous framework to address this challenge by deriving and empirically validating scaling laws that connect sample size, latent space dimension, and downstream control quality. We derive a theoretical upper bound on the Koopman approximation error, explicitly decomposing it into sampling error and projection error. We show that these terms decay at specific rates relative to dataset size and latent dimension, providing a rigorous basis for the scaling law. Based on the theoretical results, we introduce two lightweight regularizers for the neural Koopman operator: a covariance loss to help stabilize the learned latent features and an inverse control loss to ensure the model aligns with physical actuation. The results from systematic experiments across six robotic environments confirm that model fitting error follows the derived scaling laws, and the regularizers improve dynamic model fitting fidelity, with enhanced closed-loop control performance. Together, our results provide a simple recipe for allocating effort between data collection and model capacity when learning Koopman dynamics for control."}],"geoLocations":[],"fundingReferences":[],"url":"https://arxiv.org/abs/2602.19943","contentUrl":null,"metadataVersion":0,"schemaVersion":"http://datacite.org/schema/kernel-4","source":"mds","isActive":true,"state":"findable","reason":null,"viewCount":0,"downloadCount":0,"referenceCount":0,"citationCount":0,"partCount":0,"partOfCount":0,"versionCount":0,"versionOfCount":0,"created":"2026-02-25T15:21:26Z","registered":"2026-02-25T15:21:27Z","published":null,"updated":"2026-02-25T15:21:27Z"},"relationships":{"client":{"data":{"id":"arxiv.content","type":"clients"}}}},{"id":"10.48550/arxiv.2602.19942","type":"dois","attributes":{"doi":"10.48550/arxiv.2602.19942","identifiers":[{"identifier":"2602.19942","identifierType":"arXiv"}],"creators":[{"nameType":"Personal","givenName":"Ruiqi","familyName":"Liu","name":"Liu, Ruiqi","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Beixiong","familyName":"Zheng","name":"Zheng, Beixiong","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Jemin","familyName":"Lee","name":"Lee, Jemin","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Si-Hyeon","familyName":"Lee","name":"Lee, Si-Hyeon","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Georges","familyName":"Kaddoum","name":"Kaddoum, Georges","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Onur","familyName":"Günlü","name":"Günlü, Onur","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Deniz","familyName":"Gündüz","name":"Gündüz, Deniz","affiliation":[],"nameIdentifiers":[]}],"titles":[{"title":"Secure Communications, Sensing, and Computing Towards Next-Generation Networks"}],"publisher":"arXiv","container":{},"publicationYear":2026,"subjects":[{"subject":"Information Theory (cs.IT)","lang":"en","subjectScheme":"arXiv"},{"subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"},{"schemeUri":"http://www.oecd.org/science/inno/38235147.pdf","subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"}],"contributors":[],"dates":[{"date":"2026-02-23T15:13:27Z","dateType":"Submitted","dateInformation":"v1"},{"date":"2026-02-24T02:33:33Z","dateType":"Updated","dateInformation":"v1"},{"date":"2026-02","dateType":"Available","dateInformation":"v1"},{"date":"2026","dateType":"Issued"}],"language":null,"types":{"schemaOrg":"CreativeWork","resourceTypeGeneral":"Preprint","citeproc":"article","bibtex":"misc","ris":"GEN","resourceType":"Article"},"relatedIdentifiers":[],"relatedItems":[],"sizes":[],"formats":[],"version":"1","rightsList":[{"rightsUri":"http://arxiv.org/licenses/nonexclusive-distrib/1.0/","rights":"arXiv.org perpetual, non-exclusive license"}],"descriptions":[{"descriptionType":"Abstract","description":"Next-generation wireless networks are progressing beyond conventional connectivity to incorporate emerging sensing and computing capabilities. This convergence gives rise to integrated systems that enable not only uninterrupted communication, but also environmental awareness, intelligent decision-making, and novel applications that take advantage of these combined features. At the same time, this integration brings substantial security challenges. As computing, sensing, and communication become more tightly intertwined, the overall complexity of the system increases, creating new vulnerabilities and expanding the attack surface. The widespread deployment of data-heavy artificial intelligence applications further amplifies concerns regarding data security and privacy. This paper presents a comprehensive survey of security and privacy threats, along with potential countermeasures, in integrated wireless systems. We first review physical-layer security techniques for communication networks, and then investigate the security and privacy implications of semantic and pragmatic communications and their associated cross-layer design methodologies. For sensing functionalities, we pinpoint security and privacy risks at the levels of signal sources, propagation channels, and sensing targets, and summarize state-of-the-art defense strategies for each. The growing computational requirements of these applications drive the need for distributed computing over the network, which introduces additional risks such as data leakage, weak authentication, and multiple points of failure. We subsequently discuss secure coded computing approaches that can help overcome several of these challenges. Finally, we introduce unified security frameworks tailored to integrated communication-sensing-computing architectures, offering an end-to-end perspective on protecting future wireless systems."},{"descriptionType":"Other","description":"28 pages, 7 figures, IEEE Journal on Selected Areas in Communications"}],"geoLocations":[],"fundingReferences":[],"url":"https://arxiv.org/abs/2602.19942","contentUrl":null,"metadataVersion":0,"schemaVersion":"http://datacite.org/schema/kernel-4","source":"mds","isActive":true,"state":"findable","reason":null,"viewCount":0,"downloadCount":0,"referenceCount":0,"citationCount":0,"partCount":0,"partOfCount":0,"versionCount":0,"versionOfCount":0,"created":"2026-02-25T15:21:24Z","registered":"2026-02-25T15:21:25Z","published":null,"updated":"2026-02-25T15:21:25Z"},"relationships":{"client":{"data":{"id":"arxiv.content","type":"clients"}}}},{"id":"10.48550/arxiv.2602.19941","type":"dois","attributes":{"doi":"10.48550/arxiv.2602.19941","identifiers":[{"identifier":"2602.19941","identifierType":"arXiv"}],"creators":[{"nameType":"Personal","givenName":"Yangfan","familyName":"Shi","name":"Shi, Yangfan","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Feng","familyName":"Long","name":"Long, Feng","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Enrique","familyName":"Macías","name":"Macías, Enrique","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Gregory J.","familyName":"Herczeg","name":"Herczeg, Gregory J.","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Paola","familyName":"Pinilla","name":"Pinilla, Paola","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Sean M.","familyName":"Andrews","name":"Andrews, Sean M.","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"David J.","familyName":"Wilner","name":"Wilner, David J.","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Haochang","familyName":"Jiang","name":"Jiang, Haochang","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Ruobing","familyName":"Dong","name":"Dong, Ruobing","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Richard","familyName":"Teague","name":"Teague, Richard","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Ilaria","familyName":"Pascucci","name":"Pascucci, Ilaria","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Claudia","familyName":"Toci","name":"Toci, Claudia","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Yuri","familyName":"Aikawa","name":"Aikawa, Yuri","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Daniel","familyName":"Harsono","name":"Harsono, Daniel","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Yao","familyName":"Liu","name":"Liu, Yao","affiliation":[],"nameIdentifiers":[]}],"titles":[{"title":"Probing Dust in the MWC 480 Disk from Millimeter to Centimeter Wavelengths"}],"publisher":"arXiv","container":{},"publicationYear":2026,"subjects":[{"subject":"Earth and Planetary Astrophysics (astro-ph.EP)","lang":"en","subjectScheme":"arXiv"},{"subject":"FOS: Physical sciences","subjectScheme":"Fields of Science and Technology (FOS)"},{"schemeUri":"http://www.oecd.org/science/inno/38235147.pdf","subject":"FOS: Physical sciences","subjectScheme":"Fields of Science and Technology (FOS)"}],"contributors":[],"dates":[{"date":"2026-02-23T15:12:22Z","dateType":"Submitted","dateInformation":"v1"},{"date":"2026-02-24T02:33:26Z","dateType":"Updated","dateInformation":"v1"},{"date":"2026-02","dateType":"Available","dateInformation":"v1"},{"date":"2026","dateType":"Issued"}],"language":null,"types":{"schemaOrg":"CreativeWork","resourceTypeGeneral":"Preprint","citeproc":"article","bibtex":"misc","ris":"GEN","resourceType":"Article"},"relatedIdentifiers":[],"relatedItems":[],"sizes":[],"formats":[],"version":"1","rightsList":[{"rightsIdentifierScheme":"SPDX","rightsUri":"https://creativecommons.org/licenses/by/4.0/legalcode","schemeUri":"https://spdx.org/licenses/","rights":"Creative Commons Attribution 4.0 International","rightsIdentifier":"cc-by-4.0"}],"descriptions":[{"descriptionType":"Abstract","description":"We present deep, high-resolution ($\\sim$100 mas) Karl G. Jansky Very Large Array (VLA) Ka-band (9.1 mm) observations of the disk around MWC 480, and infer dust properties through a combined analysis with archival Atacama Large Millimeter/submillimeter Array (ALMA) data at 0.87, 1.17, 1.33, and 3.0 mm. The prominent dust ring at 95 au (B95) is detected at 9.1 mm for the first time, while the faint outer ring at 160 au is not revealed. Through non-parametric visibility modeling, we identified two new annular features: a plateau within 20-50 au across all wavelengths, and a shoulder exterior to the B95 ring at 0.87, 1.17 and 1.33 mm, consistent with signatures of planet-disk interaction. We find that the width of the B95 ring remains constant across wavelengths, suggesting that fragmentation dominates over radial diffusion or that unresolved substructure is present within the ring. Resolved spectral modeling yields two families of dust solutions that reproduce the observations equally well: compact grains or highly porous (90\\%) grains, with carbonaceous components dominated by refractory organics or amorphous carbon, respectively. The inferred maximum grain sizes peak at the locations of the two rings and reach centimeter within the B95 ring. The total dust masses are $860^{+95}_{-78}\\rm~M_\\oplus$/$1500^{+440}_{-330}\\rm~M_\\oplus$ (large/small-grain solution in inner disk) and $230^{+14}_{-13}\\rm~M_\\oplus$ for the two dust mixtures. The B95 ring alone contains $100^{+5}_{-5}\\rm~M_\\oplus$ and $43^{+2}_{-2}\\rm~M_\\oplus$, respectively, sufficient to assemble the cores of giant planets. Finally, we highlight the power of broadband, multi-wavelength observations in placing better constraints on dust composition and porosity in protoplanetary disks."},{"descriptionType":"Other","description":"29 pages, 18 figures, 4 tables. Accepted for publication in ApJ"}],"geoLocations":[],"fundingReferences":[],"url":"https://arxiv.org/abs/2602.19941","contentUrl":null,"metadataVersion":0,"schemaVersion":"http://datacite.org/schema/kernel-4","source":"mds","isActive":true,"state":"findable","reason":null,"viewCount":0,"downloadCount":0,"referenceCount":0,"citationCount":0,"partCount":0,"partOfCount":0,"versionCount":0,"versionOfCount":0,"created":"2026-02-25T15:21:21Z","registered":"2026-02-25T15:21:22Z","published":null,"updated":"2026-02-25T15:21:22Z"},"relationships":{"client":{"data":{"id":"arxiv.content","type":"clients"}}}},{"id":"10.48550/arxiv.2602.19939","type":"dois","attributes":{"doi":"10.48550/arxiv.2602.19939","identifiers":[{"identifier":"2602.19939","identifierType":"arXiv"}],"creators":[{"nameType":"Personal","givenName":"Viktoria","familyName":"Kainz","name":"Kainz, Viktoria","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Justin","familyName":"Sulik","name":"Sulik, Justin","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Anna","familyName":"Neudert","name":"Neudert, Anna","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Torsten","familyName":"Enßlin","name":"Enßlin, Torsten","affiliation":[],"nameIdentifiers":[]}],"titles":[{"title":"Mass Manipulation in Simulated Social Networks: Dominating vs. Diversifying Attention"}],"publisher":"arXiv","container":{},"publicationYear":2026,"subjects":[{"subject":"Physics and Society (physics.soc-ph)","lang":"en","subjectScheme":"arXiv"},{"subject":"FOS: Physical sciences","subjectScheme":"Fields of Science and Technology (FOS)"},{"schemeUri":"http://www.oecd.org/science/inno/38235147.pdf","subject":"FOS: Physical sciences","subjectScheme":"Fields of Science and Technology (FOS)"}],"contributors":[],"dates":[{"date":"2026-02-23T15:11:31Z","dateType":"Submitted","dateInformation":"v1"},{"date":"2026-02-24T02:33:16Z","dateType":"Updated","dateInformation":"v1"},{"date":"2026-02","dateType":"Available","dateInformation":"v1"},{"date":"2026","dateType":"Issued"}],"language":null,"types":{"schemaOrg":"CreativeWork","resourceTypeGeneral":"Preprint","citeproc":"article","bibtex":"misc","ris":"GEN","resourceType":"Article"},"relatedIdentifiers":[],"relatedItems":[],"sizes":[],"formats":[],"version":"1","rightsList":[{"rightsUri":"http://arxiv.org/licenses/nonexclusive-distrib/1.0/","rights":"arXiv.org perpetual, non-exclusive license"}],"descriptions":[{"descriptionType":"Abstract","description":"Modern information environments, especially social media, are highly complex systems that exceed individual processing capacities such as humans' limited attention. This environment/cognition mismatch can increase susceptibility to misinformation, which various actors exploit for anti-social (including anti-democratic or anti-science) aims. This raises the question of how to feasibly sustain societal resilience against misinformation, though the challenge is to find strategies that respect individuals' cognitive limitations. We investigate whether a simple behavioral rule - topic diversification - can enhance collective performance and mitigate vulnerability. In an agent-based model that includes a deceptive mass-influencing agent (MIA), we compare two attention-distribution strategies: (A) acquaintance-based topic selection, where agents return to familiar content, and (B) randomized topics, which diversify attention. We also track dynamics across different network structures. We find that under acquaintance-based topics, a central MIA advances its propaganda effectively, causing volatile and polarized opinions through repeated exposure and echo chambers. Under randomized topics, this leverage disappears: the MIA's influence collapses across all network structures, and opinions become stable and broadly aligned with reality. These results, while deriving from simple simulations, align with realistic theories of bounded rationality and collective cognition, further suggesting a cognitively feasible, easy-to-monitor and robust strategy: distribute attention to combat misinformation."},{"descriptionType":"Other","description":"main part: 22 pages, 13 figures, 1 table; appendix: 4 pages, 2 figures, 1 table"}],"geoLocations":[],"fundingReferences":[],"url":"https://arxiv.org/abs/2602.19939","contentUrl":null,"metadataVersion":0,"schemaVersion":"http://datacite.org/schema/kernel-4","source":"mds","isActive":true,"state":"findable","reason":null,"viewCount":0,"downloadCount":0,"referenceCount":0,"citationCount":0,"partCount":0,"partOfCount":0,"versionCount":0,"versionOfCount":0,"created":"2026-02-25T15:21:16Z","registered":"2026-02-25T15:21:17Z","published":null,"updated":"2026-02-25T15:21:17Z"},"relationships":{"client":{"data":{"id":"arxiv.content","type":"clients"}}}},{"id":"10.48550/arxiv.2602.19937","type":"dois","attributes":{"doi":"10.48550/arxiv.2602.19937","identifiers":[{"identifier":"2602.19937","identifierType":"arXiv"}],"creators":[{"nameType":"Personal","givenName":"Yifei","familyName":"Shi","name":"Shi, Yifei","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Boyan","familyName":"Wan","name":"Wan, Boyan","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Xin","familyName":"Xu","name":"Xu, Xin","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Kai","familyName":"Xu","name":"Xu, Kai","affiliation":[],"nameIdentifiers":[]}],"titles":[{"title":"Learning Positive-Incentive Point Sampling in Neural Implicit Fields for Object Pose Estimation"}],"publisher":"arXiv","container":{},"publicationYear":2026,"subjects":[{"subject":"Computer Vision and Pattern Recognition (cs.CV)","lang":"en","subjectScheme":"arXiv"},{"subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"},{"schemeUri":"http://www.oecd.org/science/inno/38235147.pdf","subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"}],"contributors":[],"dates":[{"date":"2026-02-23T15:10:00Z","dateType":"Submitted","dateInformation":"v1"},{"date":"2026-02-24T02:33:07Z","dateType":"Updated","dateInformation":"v1"},{"date":"2026-02","dateType":"Available","dateInformation":"v1"},{"date":"2026","dateType":"Issued"}],"language":null,"types":{"schemaOrg":"CreativeWork","resourceTypeGeneral":"Preprint","citeproc":"article","bibtex":"misc","ris":"GEN","resourceType":"Article"},"relatedIdentifiers":[],"relatedItems":[],"sizes":[],"formats":[],"version":"1","rightsList":[{"rightsIdentifierScheme":"SPDX","rightsUri":"https://creativecommons.org/licenses/by/4.0/legalcode","schemeUri":"https://spdx.org/licenses/","rights":"Creative Commons Attribution 4.0 International","rightsIdentifier":"cc-by-4.0"}],"descriptions":[{"descriptionType":"Abstract","description":"Learning neural implicit fields of 3D shapes is a rapidly emerging field that enables shape representation at arbitrary resolutions. Due to the flexibility, neural implicit fields have succeeded in many research areas, including shape reconstruction, novel view image synthesis, and more recently, object pose estimation. Neural implicit fields enable learning dense correspondences between the camera space and the object's canonical space-including unobserved regions in camera space-significantly boosting object pose estimation performance in challenging scenarios like highly occluded objects and novel shapes. Despite progress, predicting canonical coordinates for unobserved camera-space regions remains challenging due to the lack of direct observational signals. This necessitates heavy reliance on the model's generalization ability, resulting in high uncertainty. Consequently, densely sampling points across the entire camera space may yield inaccurate estimations that hinder the learning process and compromise performance. To alleviate this problem, we propose a method combining an SO(3)-equivariant convolutional implicit network and a positive-incentive point sampling (PIPS) strategy. The SO(3)-equivariant convolutional implicit network estimates point-level attributes with SO(3)-equivariance at arbitrary query locations, demonstrating superior performance compared to most existing baselines. The PIPS strategy dynamically determines sampling locations based on the input, thereby boosting the network's accuracy and training efficiency. Our method outperforms the state-of-the-art on three pose estimation datasets. Notably, it demonstrates significant improvements in challenging scenarios, such as objects captured with unseen pose, high occlusion, novel geometry, and severe noise."}],"geoLocations":[],"fundingReferences":[],"url":"https://arxiv.org/abs/2602.19937","contentUrl":null,"metadataVersion":0,"schemaVersion":"http://datacite.org/schema/kernel-4","source":"mds","isActive":true,"state":"findable","reason":null,"viewCount":0,"downloadCount":0,"referenceCount":0,"citationCount":0,"partCount":0,"partOfCount":0,"versionCount":0,"versionOfCount":0,"created":"2026-02-25T15:21:12Z","registered":"2026-02-25T15:21:12Z","published":null,"updated":"2026-02-25T15:21:12Z"},"relationships":{"client":{"data":{"id":"arxiv.content","type":"clients"}}}},{"id":"10.48550/arxiv.2602.19934","type":"dois","attributes":{"doi":"10.48550/arxiv.2602.19934","identifiers":[{"identifier":"2602.19934","identifierType":"arXiv"}],"creators":[{"nameType":"Personal","givenName":"Ondřej","familyName":"Ježil","name":"Ježil, Ondřej","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Dimitrios","familyName":"Tsintsilidas","name":"Tsintsilidas, Dimitrios","affiliation":[],"nameIdentifiers":[]}],"titles":[{"title":"Parallelism and Adaptivity in Student-Teacher Witnessing"}],"publisher":"arXiv","container":{},"publicationYear":2026,"subjects":[{"subject":"Computational Complexity (cs.CC)","lang":"en","subjectScheme":"arXiv"},{"subject":"Logic in Computer Science (cs.LO)","lang":"en","subjectScheme":"arXiv"},{"subject":"Logic (math.LO)","lang":"en","subjectScheme":"arXiv"},{"subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"},{"schemeUri":"http://www.oecd.org/science/inno/38235147.pdf","subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"},{"subject":"FOS: Mathematics","subjectScheme":"Fields of Science and Technology (FOS)"},{"schemeUri":"http://www.oecd.org/science/inno/38235147.pdf","subject":"FOS: Mathematics","subjectScheme":"Fields of Science and Technology (FOS)"}],"contributors":[],"dates":[{"date":"2026-02-23T15:08:49Z","dateType":"Submitted","dateInformation":"v1"},{"date":"2026-02-24T02:33:00Z","dateType":"Updated","dateInformation":"v1"},{"date":"2026-02","dateType":"Available","dateInformation":"v1"},{"date":"2026","dateType":"Issued"}],"language":null,"types":{"schemaOrg":"CreativeWork","resourceTypeGeneral":"Preprint","citeproc":"article","bibtex":"misc","ris":"GEN","resourceType":"Article"},"relatedIdentifiers":[],"relatedItems":[],"sizes":[],"formats":[],"version":"1","rightsList":[{"rightsIdentifierScheme":"SPDX","rightsUri":"https://creativecommons.org/licenses/by/4.0/legalcode","schemeUri":"https://spdx.org/licenses/","rights":"Creative Commons Attribution 4.0 International","rightsIdentifier":"cc-by-4.0"}],"descriptions":[{"descriptionType":"Abstract","description":"Student-Teacher Games are a model of computation in which a computationally restricted Student attempts to produce a string satisfying a refutable property, while an all-powerful Teacher refutes incorrect candidates by providing counterexamples. By the classical result of Krajíček, Pudlák, and Takeuti [KPT90], such games capture the witnessing of $\\forall\\exists\\forall$-formulas in bounded arithmetic. In this paper, we introduce subclasses of total search problems in the polynomial hierarchy, classified by the number of rounds and candidate answers per round required for a Student at the corresponding level to solve them. Assuming the polynomial hierarchy does not collapse, we separate these classes for different number of rounds and queries. As applications we obtain the following results:\n (a) We study theories of bounded arithmetic axiomatized by fine-grained variants of length induction and bounded collection. We prove a general witnessing theorem connecting their $\\forall\\exists\\forall$-consequences to the appropriate classes of Student-Teacher Games. Under the non-collapse of the polynomial hierarchy, we separate these theories.\n (b) These conditional separations resolve two open problems in bounded arithmetic: one by Buss and Ressayre [Bus85, CK93] on the strength of bounded collection, and one by Pollett [Pol97] on the difference between strict and non-strict double length induction.\n (c) Finally, we extend the unprovability of circuit upper bounds due to Krajíček and Oliveira [KO17] to the theory $PV_1+BB(Σ^b_1)$, and the unprovability of strong co-nondeterministic circuit lower bounds due to Pich and Santhanam [PS21] to the theory $PV_1+LLIND(sΣ^b_1)$. By the preceding separations, both theories strictly extend $PV_1$ assuming $NP\\nsubseteq P/poly$."}],"geoLocations":[],"fundingReferences":[],"url":"https://arxiv.org/abs/2602.19934","contentUrl":null,"metadataVersion":0,"schemaVersion":"http://datacite.org/schema/kernel-4","source":"mds","isActive":true,"state":"findable","reason":null,"viewCount":0,"downloadCount":0,"referenceCount":0,"citationCount":0,"partCount":0,"partOfCount":0,"versionCount":0,"versionOfCount":0,"created":"2026-02-25T15:21:04Z","registered":"2026-02-25T15:21:05Z","published":null,"updated":"2026-02-25T15:21:05Z"},"relationships":{"client":{"data":{"id":"arxiv.content","type":"clients"}}}},{"id":"10.48550/arxiv.2602.19931","type":"dois","attributes":{"doi":"10.48550/arxiv.2602.19931","identifiers":[{"identifier":"2602.19931","identifierType":"arXiv"}],"creators":[{"nameType":"Personal","givenName":"Pin-Han","familyName":"Huang","name":"Huang, Pin-Han","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Shang-Tse","familyName":"Chen","name":"Chen, Shang-Tse","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Hsuan-Tien","familyName":"Lin","name":"Lin, Hsuan-Tien","affiliation":[],"nameIdentifiers":[]}],"titles":[{"title":"Expanding the Role of Diffusion Models for Robust Classifier Training"}],"publisher":"arXiv","container":{},"publicationYear":2026,"subjects":[{"subject":"Machine Learning (cs.LG)","lang":"en","subjectScheme":"arXiv"},{"subject":"Computer Vision and Pattern Recognition (cs.CV)","lang":"en","subjectScheme":"arXiv"},{"subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"},{"schemeUri":"http://www.oecd.org/science/inno/38235147.pdf","subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"}],"contributors":[],"dates":[{"date":"2026-02-23T15:06:52Z","dateType":"Submitted","dateInformation":"v1"},{"date":"2026-02-24T02:32:53Z","dateType":"Updated","dateInformation":"v1"},{"date":"2026-02","dateType":"Available","dateInformation":"v1"},{"date":"2026","dateType":"Issued"}],"language":null,"types":{"schemaOrg":"CreativeWork","resourceTypeGeneral":"Preprint","citeproc":"article","bibtex":"misc","ris":"GEN","resourceType":"Article"},"relatedIdentifiers":[],"relatedItems":[],"sizes":[],"formats":[],"version":"1","rightsList":[{"rightsIdentifierScheme":"SPDX","rightsUri":"https://creativecommons.org/licenses/by/4.0/legalcode","schemeUri":"https://spdx.org/licenses/","rights":"Creative Commons Attribution 4.0 International","rightsIdentifier":"cc-by-4.0"}],"descriptions":[{"descriptionType":"Abstract","description":"Incorporating diffusion-generated synthetic data into adversarial training (AT) has been shown to substantially improve the training of robust image classifiers. In this work, we extend the role of diffusion models beyond merely generating synthetic data, examining whether their internal representations, which encode meaningful features of the data, can provide additional benefits for robust classifier training. Through systematic experiments, we show that diffusion models offer representations that are both diverse and partially robust, and that explicitly incorporating diffusion representations as an auxiliary learning signal during AT consistently improves robustness across settings. Furthermore, our representation analysis indicates that incorporating diffusion models into AT encourages more disentangled features, while diffusion representations and diffusion-generated synthetic data play complementary roles in shaping representations. Experiments on CIFAR-10, CIFAR-100, and ImageNet validate these findings, demonstrating the effectiveness of jointly leveraging diffusion representations and synthetic data within AT."}],"geoLocations":[],"fundingReferences":[],"url":"https://arxiv.org/abs/2602.19931","contentUrl":null,"metadataVersion":0,"schemaVersion":"http://datacite.org/schema/kernel-4","source":"mds","isActive":true,"state":"findable","reason":null,"viewCount":0,"downloadCount":0,"referenceCount":0,"citationCount":0,"partCount":0,"partOfCount":0,"versionCount":0,"versionOfCount":0,"created":"2026-02-25T15:20:57Z","registered":"2026-02-25T15:20:57Z","published":null,"updated":"2026-02-25T15:20:57Z"},"relationships":{"client":{"data":{"id":"arxiv.content","type":"clients"}}}},{"id":"10.48550/arxiv.2602.19930","type":"dois","attributes":{"doi":"10.48550/arxiv.2602.19930","identifiers":[{"identifier":"2602.19930","identifierType":"arXiv"}],"creators":[{"nameType":"Personal","givenName":"Nathan","familyName":"Gavenski","name":"Gavenski, Nathan","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Felipe","familyName":"Meneguzzi","name":"Meneguzzi, Felipe","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Odinaldo","familyName":"Rodrigues","name":"Rodrigues, Odinaldo","affiliation":[],"nameIdentifiers":[]}],"titles":[{"title":"Beyond Mimicry: Toward Lifelong Adaptability in Imitation Learning"}],"publisher":"arXiv","container":{},"publicationYear":2026,"subjects":[{"subject":"Artificial Intelligence (cs.AI)","lang":"en","subjectScheme":"arXiv"},{"subject":"Machine Learning (cs.LG)","lang":"en","subjectScheme":"arXiv"},{"subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"},{"schemeUri":"http://www.oecd.org/science/inno/38235147.pdf","subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"}],"contributors":[],"dates":[{"date":"2026-02-23T15:06:33Z","dateType":"Submitted","dateInformation":"v1"},{"date":"2026-02-24T02:32:52Z","dateType":"Updated","dateInformation":"v1"},{"date":"2026-02","dateType":"Available","dateInformation":"v1"},{"date":"2026","dateType":"Issued"}],"language":null,"types":{"schemaOrg":"CreativeWork","resourceTypeGeneral":"Preprint","citeproc":"article","bibtex":"misc","ris":"GEN","resourceType":"Article"},"relatedIdentifiers":[],"relatedItems":[],"sizes":[],"formats":[],"version":"1","rightsList":[{"rightsIdentifierScheme":"SPDX","rightsUri":"https://creativecommons.org/licenses/by/4.0/legalcode","schemeUri":"https://spdx.org/licenses/","rights":"Creative Commons Attribution 4.0 International","rightsIdentifier":"cc-by-4.0"}],"descriptions":[{"descriptionType":"Abstract","description":"Imitation learning stands at a crossroads: despite decades of progress, current imitation learning agents remain sophisticated memorisation machines, excelling at replay but failing when contexts shift or goals evolve. This paper argues that this failure is not technical but foundational: imitation learning has been optimised for the wrong objective. We propose a research agenda that redefines success from perfect replay to compositional adaptability. Such adaptability hinges on learning behavioural primitives once and recombining them through novel contexts without retraining. We establish metrics for compositional generalisation, propose hybrid architectures, and outline interdisciplinary research directions drawing on cognitive science and cultural evolution. Agents that embed adaptability at the core of imitation learning thus have an essential capability for operating in an open-ended world."},{"descriptionType":"Other","description":"Accepted as part of the Blue Sky Ideas Track for the 25th International Conference on Autonomous Agents and Multiagent Systems"}],"geoLocations":[],"fundingReferences":[],"url":"https://arxiv.org/abs/2602.19930","contentUrl":null,"metadataVersion":0,"schemaVersion":"http://datacite.org/schema/kernel-4","source":"mds","isActive":true,"state":"findable","reason":null,"viewCount":0,"downloadCount":0,"referenceCount":0,"citationCount":0,"partCount":0,"partOfCount":0,"versionCount":0,"versionOfCount":0,"created":"2026-02-25T15:20:54Z","registered":"2026-02-25T15:20:55Z","published":null,"updated":"2026-02-25T15:20:55Z"},"relationships":{"client":{"data":{"id":"arxiv.content","type":"clients"}}}},{"id":"10.48550/arxiv.2602.19925","type":"dois","attributes":{"doi":"10.48550/arxiv.2602.19925","identifiers":[{"identifier":"2602.19925","identifierType":"arXiv"}],"creators":[{"nameType":"Personal","givenName":"Maciej","familyName":"Lewkowicz","name":"Lewkowicz, Maciej","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Mirosław","familyName":"Brewczyk","name":"Brewczyk, Mirosław","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Mariusz","familyName":"Gajda","name":"Gajda, Mariusz","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Tomasz","familyName":"Karpiuk","name":"Karpiuk, Tomasz","affiliation":[],"nameIdentifiers":[]}],"titles":[{"title":"Three-dimensional Bose-Fermi droplets at nonzero temperatures"}],"publisher":"arXiv","container":{},"publicationYear":2026,"subjects":[{"subject":"Quantum Gases (cond-mat.quant-gas)","lang":"en","subjectScheme":"arXiv"},{"subject":"FOS: Physical sciences","subjectScheme":"Fields of Science and Technology (FOS)"},{"schemeUri":"http://www.oecd.org/science/inno/38235147.pdf","subject":"FOS: Physical sciences","subjectScheme":"Fields of Science and Technology (FOS)"}],"contributors":[],"dates":[{"date":"2026-02-23T15:05:27Z","dateType":"Submitted","dateInformation":"v1"},{"date":"2026-02-24T02:32:46Z","dateType":"Updated","dateInformation":"v1"},{"date":"2026-02","dateType":"Available","dateInformation":"v1"},{"date":"2026","dateType":"Issued"}],"language":null,"types":{"schemaOrg":"CreativeWork","resourceTypeGeneral":"Preprint","citeproc":"article","bibtex":"misc","ris":"GEN","resourceType":"Article"},"relatedIdentifiers":[],"relatedItems":[],"sizes":[],"formats":[],"version":"1","rightsList":[{"rightsIdentifierScheme":"SPDX","rightsUri":"https://creativecommons.org/licenses/by/4.0/legalcode","schemeUri":"https://spdx.org/licenses/","rights":"Creative Commons Attribution 4.0 International","rightsIdentifier":"cc-by-4.0"}],"descriptions":[{"descriptionType":"Abstract","description":"Using numerical methods, we study the formation of self-bound quantum Bose-Fermi droplets at nonzero temperatures. We describe an attractive atomic Bose-Fermi mixture using quantum hydrodynamics enriched by beyond-mean-field corrections and thermal fluctuations, together with a simplified self-consistent Hartree-Fock model. With these models, we determine that low-temperature droplets with finite lifetimes can exist in free space when the attraction between bosons and fermions is sufficiently strong. Additionally, Bose-Fermi droplets at nonzero temperatures can exist in a box potential in equilibrium with bosonic and fermionic vapor. We discuss the properties of Bose-Fermi droplets at nonzero temperatures in terms of the initial condensate fraction, total atom number, and interspecies attraction strength."},{"descriptionType":"Other","description":"7 pages, 6 figures, 4 videos"}],"geoLocations":[],"fundingReferences":[],"url":"https://arxiv.org/abs/2602.19925","contentUrl":null,"metadataVersion":0,"schemaVersion":"http://datacite.org/schema/kernel-4","source":"mds","isActive":true,"state":"findable","reason":null,"viewCount":0,"downloadCount":0,"referenceCount":0,"citationCount":0,"partCount":0,"partOfCount":0,"versionCount":0,"versionOfCount":0,"created":"2026-02-25T15:20:42Z","registered":"2026-02-25T15:20:43Z","published":null,"updated":"2026-02-25T15:20:43Z"},"relationships":{"client":{"data":{"id":"arxiv.content","type":"clients"}}}},{"id":"10.48550/arxiv.2602.19924","type":"dois","attributes":{"doi":"10.48550/arxiv.2602.19924","identifiers":[{"identifier":"2602.19924","identifierType":"arXiv"}],"creators":[{"nameType":"Personal","givenName":"C.","familyName":"Muñoz-Cabello","name":"Muñoz-Cabello, C.","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"T.","familyName":"Nishimura","name":"Nishimura, T.","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"R. Oset","familyName":"Sinha","name":"Sinha, R. Oset","affiliation":[],"nameIdentifiers":[]}],"titles":[{"title":"Recovery problem of parametrizations from Legendre data"}],"publisher":"arXiv","container":{},"publicationYear":2026,"subjects":[{"subject":"Differential Geometry (math.DG)","lang":"en","subjectScheme":"arXiv"},{"subject":"FOS: Mathematics","subjectScheme":"Fields of Science and Technology (FOS)"},{"schemeUri":"http://www.oecd.org/science/inno/38235147.pdf","subject":"FOS: Mathematics","subjectScheme":"Fields of Science and Technology (FOS)"},{"subject":"57R45, 58C25","lang":"en","subjectScheme":"MSC"}],"contributors":[],"dates":[{"date":"2026-02-23T15:03:30Z","dateType":"Submitted","dateInformation":"v1"},{"date":"2026-02-24T02:32:40Z","dateType":"Updated","dateInformation":"v1"},{"date":"2026-02","dateType":"Available","dateInformation":"v1"},{"date":"2026","dateType":"Issued"}],"language":null,"types":{"schemaOrg":"CreativeWork","resourceTypeGeneral":"Preprint","citeproc":"article","bibtex":"misc","ris":"GEN","resourceType":"Article"},"relatedIdentifiers":[],"relatedItems":[],"sizes":[],"formats":[],"version":"1","rightsList":[{"rightsIdentifierScheme":"SPDX","rightsUri":"https://creativecommons.org/licenses/by/4.0/legalcode","schemeUri":"https://spdx.org/licenses/","rights":"Creative Commons Attribution 4.0 International","rightsIdentifier":"cc-by-4.0"}],"descriptions":[{"descriptionType":"Abstract","description":"The problem of recovery of parametrizations from Legendre data is a very important inverse problem. In this paper, we provide a systematic and widely-applicable method to recover parametrizations $f: U_n \\to \\mathbb{R}^{n+1}$ from Legendre data where $U_n$ is an open subset of $\\mathbb R^n$. Namely, for a dense subset of the space of real-analytic parametrizations from $U_n$ into $\\mathbb{R}^{n+1}$, we show how to recover the parametrization from the Gauss mapping and the height function. Moreover, in order to assist readers to apply results of this paper, many concrete examples are given."},{"descriptionType":"Other","description":"20 pages, 7 figures"}],"geoLocations":[],"fundingReferences":[],"url":"https://arxiv.org/abs/2602.19924","contentUrl":null,"metadataVersion":0,"schemaVersion":"http://datacite.org/schema/kernel-4","source":"mds","isActive":true,"state":"findable","reason":null,"viewCount":0,"downloadCount":0,"referenceCount":0,"citationCount":0,"partCount":0,"partOfCount":0,"versionCount":0,"versionOfCount":0,"created":"2026-02-25T15:20:39Z","registered":"2026-02-25T15:20:40Z","published":null,"updated":"2026-02-25T15:20:40Z"},"relationships":{"client":{"data":{"id":"arxiv.content","type":"clients"}}}},{"id":"10.48550/arxiv.2602.19922","type":"dois","attributes":{"doi":"10.48550/arxiv.2602.19922","identifiers":[{"identifier":"2602.19922","identifierType":"arXiv"}],"creators":[{"nameType":"Personal","givenName":"Mengyan","familyName":"Li","name":"Li, Mengyan","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Xiaoou","familyName":"Li","name":"Li, Xiaoou","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Kenneth D","familyName":"Mandl","name":"Mandl, Kenneth D","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Tianxi","familyName":"Cai","name":"Cai, Tianxi","affiliation":[],"nameIdentifiers":[]}],"titles":[{"title":"Transfer Learning with Network Embeddings under Structured Missingness"}],"publisher":"arXiv","container":{},"publicationYear":2026,"subjects":[{"subject":"Methodology (stat.ME)","lang":"en","subjectScheme":"arXiv"},{"subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"},{"schemeUri":"http://www.oecd.org/science/inno/38235147.pdf","subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"}],"contributors":[],"dates":[{"date":"2026-02-23T15:01:57Z","dateType":"Submitted","dateInformation":"v1"},{"date":"2026-02-24T02:32:37Z","dateType":"Updated","dateInformation":"v1"},{"date":"2026-02","dateType":"Available","dateInformation":"v1"},{"date":"2026","dateType":"Issued"}],"language":null,"types":{"schemaOrg":"CreativeWork","resourceTypeGeneral":"Preprint","citeproc":"article","bibtex":"misc","ris":"GEN","resourceType":"Article"},"relatedIdentifiers":[],"relatedItems":[],"sizes":[],"formats":[],"version":"1","rightsList":[{"rightsIdentifierScheme":"SPDX","rightsUri":"https://creativecommons.org/licenses/by-nc-sa/4.0/legalcode","schemeUri":"https://spdx.org/licenses/","rights":"Creative Commons Attribution Non Commercial Share Alike 4.0 International","rightsIdentifier":"cc-by-nc-sa-4.0"}],"descriptions":[{"descriptionType":"Abstract","description":"Modern data-driven applications increasingly rely on large, heterogeneous datasets collected across multiple sites. Differences in data availability, feature representation, and underlying populations often induce structured missingness, complicating efforts to transfer information from data-rich settings to those with limited data. Many transfer learning methods overlook this structure, limiting their ability to capture meaningful relationships across sites. We propose TransNEST (Transfer learning with Network Embeddings under STructured missingness), a framework that integrates graphical data from source and target sites with prior group structure to construct and refine network embeddings. TransNEST accommodates site-specific features, captures within-group heterogeneity and between-site differences adaptively, and improves embedding estimation under partial feature overlap. We establish the convergence rate for the TransNEST estimator and demonstrate strong finite-sample performance in simulations. We apply TransNEST to a multi-site electronic health record study, transferring feature embeddings from a general hospital system to a pediatric hospital system. Using a hierarchical ontology structure, TransNEST improves pediatric embeddings and supports more accurate pediatric knowledge extraction, achieving the best accuracy for identifying pediatric-specific relational feature pairs compared with benchmark methods."}],"geoLocations":[],"fundingReferences":[],"url":"https://arxiv.org/abs/2602.19922","contentUrl":null,"metadataVersion":0,"schemaVersion":"http://datacite.org/schema/kernel-4","source":"mds","isActive":true,"state":"findable","reason":null,"viewCount":0,"downloadCount":0,"referenceCount":0,"citationCount":0,"partCount":0,"partOfCount":0,"versionCount":0,"versionOfCount":0,"created":"2026-02-25T15:20:35Z","registered":"2026-02-25T15:20:35Z","published":null,"updated":"2026-02-25T15:20:35Z"},"relationships":{"client":{"data":{"id":"arxiv.content","type":"clients"}}}},{"id":"10.48550/arxiv.2602.19921","type":"dois","attributes":{"doi":"10.48550/arxiv.2602.19921","identifiers":[{"identifier":"2602.19921","identifierType":"arXiv"}],"creators":[{"nameType":"Personal","givenName":"Pieter vd","familyName":"Merwe","name":"Merwe, Pieter vd","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Markus","familyName":"Böttcher","name":"Böttcher, Markus","affiliation":[],"nameIdentifiers":[]}],"titles":[{"title":"Investigating polarization signatures from GRB models"}],"publisher":"arXiv","container":{},"publicationYear":2026,"subjects":[{"subject":"High Energy Astrophysical Phenomena (astro-ph.HE)","lang":"en","subjectScheme":"arXiv"},{"subject":"FOS: Physical sciences","subjectScheme":"Fields of Science and Technology (FOS)"},{"schemeUri":"http://www.oecd.org/science/inno/38235147.pdf","subject":"FOS: Physical sciences","subjectScheme":"Fields of Science and Technology (FOS)"}],"contributors":[],"dates":[{"date":"2026-02-23T15:01:29Z","dateType":"Submitted","dateInformation":"v1"},{"date":"2026-02-24T02:32:36Z","dateType":"Updated","dateInformation":"v1"},{"date":"2026-02","dateType":"Available","dateInformation":"v1"},{"date":"2026","dateType":"Issued"}],"language":null,"types":{"schemaOrg":"CreativeWork","resourceTypeGeneral":"Preprint","citeproc":"article","bibtex":"misc","ris":"GEN","resourceType":"Article"},"relatedIdentifiers":[{"relationType":"IsVersionOf","relatedIdentifier":"10.3847/1538-4357/ae3a95","relatedIdentifierType":"DOI"}],"relatedItems":[],"sizes":[],"formats":[],"version":"1","rightsList":[{"rightsUri":"http://arxiv.org/licenses/nonexclusive-distrib/1.0/","rights":"arXiv.org perpetual, non-exclusive license"}],"descriptions":[{"descriptionType":"Abstract","description":"There is still much debate around the inner workings of the GRB prompt emission phase with many questions still left unanswered. Polarization signatures offer a promising new avenue to discriminate between the various GRB prompt emission models. The aim of this study is to estimate energy and time resolved polarization signatures resulting from Inverse Compton (IC) scattering for two specific GRB prompt emission models, namely the backscatter-dominated cork model by \\citet{Vyas2} and a Compton drag model by \\citet{Lazzati2}. In order to achieve this we apply an IC polarization Monte Carlo (MC) algorithm to those two GRB models in order to estimate the expected polarization signatures. For the backscatter-dominated cork model we find polarization signatures below $\\sim 10$~\\%, likely below the detection limits of current or near-future X-ray and $γ$-ray polarimeters. Our results for the Compton drag model indicates polarization results consistent with that found by \\citet{Lazzati3}. Furthermore, we find some energy and time dependence of the estimated polarization, particularly for the polarization angle."},{"descriptionType":"Other","description":"Published in ApJ"}],"geoLocations":[],"fundingReferences":[],"url":"https://arxiv.org/abs/2602.19921","contentUrl":null,"metadataVersion":0,"schemaVersion":"http://datacite.org/schema/kernel-4","source":"mds","isActive":true,"state":"findable","reason":null,"viewCount":0,"downloadCount":0,"referenceCount":0,"citationCount":0,"partCount":0,"partOfCount":0,"versionCount":0,"versionOfCount":1,"created":"2026-02-25T15:20:32Z","registered":"2026-02-25T15:20:33Z","published":null,"updated":"2026-02-25T15:20:33Z"},"relationships":{"client":{"data":{"id":"arxiv.content","type":"clients"}}}},{"id":"10.48550/arxiv.2602.19920","type":"dois","attributes":{"doi":"10.48550/arxiv.2602.19920","identifiers":[{"identifier":"2602.19920","identifierType":"arXiv"}],"creators":[{"nameType":"Personal","givenName":"Suryashekhar","familyName":"Kusari","name":"Kusari, Suryashekhar","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Arti","familyName":"Garg","name":"Garg, Arti","affiliation":[],"nameIdentifiers":[]}],"titles":[{"title":"Periodic drive induced unconventional superconductivity in a half-filled system"}],"publisher":"arXiv","container":{},"publicationYear":2026,"subjects":[{"subject":"Superconductivity (cond-mat.supr-con)","lang":"en","subjectScheme":"arXiv"},{"subject":"FOS: Physical sciences","subjectScheme":"Fields of Science and Technology (FOS)"},{"schemeUri":"http://www.oecd.org/science/inno/38235147.pdf","subject":"FOS: Physical sciences","subjectScheme":"Fields of Science and Technology (FOS)"}],"contributors":[],"dates":[{"date":"2026-02-23T15:01:27Z","dateType":"Submitted","dateInformation":"v1"},{"date":"2026-02-24T02:32:35Z","dateType":"Updated","dateInformation":"v1"},{"date":"2026-02","dateType":"Available","dateInformation":"v1"},{"date":"2026","dateType":"Issued"}],"language":null,"types":{"schemaOrg":"CreativeWork","resourceTypeGeneral":"Preprint","citeproc":"article","bibtex":"misc","ris":"GEN","resourceType":"Article"},"relatedIdentifiers":[],"relatedItems":[],"sizes":[],"formats":[],"version":"1","rightsList":[{"rightsUri":"http://arxiv.org/licenses/nonexclusive-distrib/1.0/","rights":"arXiv.org perpetual, non-exclusive license"}],"descriptions":[{"descriptionType":"Abstract","description":"The non-equilibrium control of electronic properties has emerged as a transformative paradigm for engineering novel quantum phases. The most intriguing example of such a phase is light-induced superconductivity (SC) in non-superconducting materials. However, realizing unconventional SC at commensurate half-filling remains a formidable challenge even in non-equilibrium, as the regime is typically dominated by the robust stability of the antiferromagnetic (AFM) Mott insulating (MI) state. Here, we provide a novel non-equilibrium route to realize unconventional d-wave SC in a half-filled system through Floquet engineering. We analyze the periodically driven Fermi-Hubbard model on a bipartite lattice and demonstrate that a high-frequency drive can transform a weakly interacting insulator into a regime of strong correlations by the drive-induced renormalization of nearest-neighbor hopping. Furthermore, the drive induces staggered higher range hoppings that can frustrate the AFM order while simultaneously generate staggered potential that lifts the kinetic constraints inherent to the half-filled system, fostering the charge dynamics required to stabilize d-wave pairing against the competing AFM state. The resulting SC phase is protected by high-frequency prethermalization, maintaining stability over timescales exponentially large in the drive frequency. This protocol circumvents the need for chemical doping, offering a 'disorder-free' alternative for realizing unconventional pairing with direct applications in optimizing the performance of superconducting quantum computers, qubit arrays and other upcoming quantum technologies."},{"descriptionType":"Other","description":"18 pages, 5 figures"}],"geoLocations":[],"fundingReferences":[],"url":"https://arxiv.org/abs/2602.19920","contentUrl":null,"metadataVersion":0,"schemaVersion":"http://datacite.org/schema/kernel-4","source":"mds","isActive":true,"state":"findable","reason":null,"viewCount":0,"downloadCount":0,"referenceCount":0,"citationCount":0,"partCount":0,"partOfCount":0,"versionCount":0,"versionOfCount":0,"created":"2026-02-25T15:20:29Z","registered":"2026-02-25T15:20:30Z","published":null,"updated":"2026-02-25T15:20:30Z"},"relationships":{"client":{"data":{"id":"arxiv.content","type":"clients"}}}},{"id":"10.48550/arxiv.2602.19918","type":"dois","attributes":{"doi":"10.48550/arxiv.2602.19918","identifiers":[{"identifier":"2602.19918","identifierType":"arXiv"}],"creators":[{"nameType":"Personal","givenName":"Jiaqi","familyName":"Xue","name":"Xue, Jiaqi","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Mengxin","familyName":"Zheng","name":"Zheng, Mengxin","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Qian","familyName":"Lou","name":"Lou, Qian","affiliation":[],"nameIdentifiers":[]}],"titles":[{"title":"RobPI: Robust Private Inference against Malicious Client"}],"publisher":"arXiv","container":{},"publicationYear":2026,"subjects":[{"subject":"Cryptography and Security (cs.CR)","lang":"en","subjectScheme":"arXiv"},{"subject":"Machine Learning (cs.LG)","lang":"en","subjectScheme":"arXiv"},{"subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"},{"schemeUri":"http://www.oecd.org/science/inno/38235147.pdf","subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"}],"contributors":[],"dates":[{"date":"2026-02-23T14:58:08Z","dateType":"Submitted","dateInformation":"v1"},{"date":"2026-02-24T02:32:24Z","dateType":"Updated","dateInformation":"v1"},{"date":"2026-02","dateType":"Available","dateInformation":"v1"},{"date":"2026","dateType":"Issued"}],"language":null,"types":{"schemaOrg":"CreativeWork","resourceTypeGeneral":"Preprint","citeproc":"article","bibtex":"misc","ris":"GEN","resourceType":"Article"},"relatedIdentifiers":[],"relatedItems":[],"sizes":[],"formats":[],"version":"1","rightsList":[{"rightsIdentifierScheme":"SPDX","rightsUri":"https://creativecommons.org/licenses/by/4.0/legalcode","schemeUri":"https://spdx.org/licenses/","rights":"Creative Commons Attribution 4.0 International","rightsIdentifier":"cc-by-4.0"}],"descriptions":[{"descriptionType":"Abstract","description":"The increased deployment of machine learning inference in various applications has sparked privacy concerns. In response, private inference (PI) protocols have been created to allow parties to perform inference without revealing their sensitive data. Despite recent advances in the efficiency of PI, most current methods assume a semi-honest threat model where the data owner is honest and adheres to the protocol. However, in reality, data owners can have different motivations and act in unpredictable ways, making this assumption unrealistic. To demonstrate how a malicious client can compromise the semi-honest model, we first designed an inference manipulation attack against a range of state-of-the-art private inference protocols. This attack allows a malicious client to modify the model output with 3x to 8x fewer queries than current black-box attacks. Motivated by the attacks, we proposed and implemented RobPI, a robust and resilient private inference protocol that withstands malicious clients. RobPI integrates a distinctive cryptographic protocol that bolsters security by weaving encryption-compatible noise into the logits and features of private inference, thereby efficiently warding off malicious-client attacks. Our extensive experiments on various neural networks and datasets show that RobPI achieves ~91.9% attack success rate reduction and increases more than 10x the number of queries required by malicious-client attacks."},{"descriptionType":"Other","description":"Accepted by SaTML 2026"}],"geoLocations":[],"fundingReferences":[],"url":"https://arxiv.org/abs/2602.19918","contentUrl":null,"metadataVersion":0,"schemaVersion":"http://datacite.org/schema/kernel-4","source":"mds","isActive":true,"state":"findable","reason":null,"viewCount":0,"downloadCount":0,"referenceCount":0,"citationCount":0,"partCount":0,"partOfCount":0,"versionCount":0,"versionOfCount":0,"created":"2026-02-25T15:20:24Z","registered":"2026-02-25T15:20:25Z","published":null,"updated":"2026-02-25T15:20:25Z"},"relationships":{"client":{"data":{"id":"arxiv.content","type":"clients"}}}},{"id":"10.48550/arxiv.2602.19917","type":"dois","attributes":{"doi":"10.48550/arxiv.2602.19917","identifiers":[{"identifier":"2602.19917","identifierType":"arXiv"}],"creators":[{"nameType":"Personal","givenName":"Thanh","familyName":"Nguyen","name":"Nguyen, Thanh","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Tung","familyName":"Luu","name":"Luu, Tung","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Tri","familyName":"Ton","name":"Ton, Tri","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Sungwoong","familyName":"Kim","name":"Kim, Sungwoong","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Chang D.","familyName":"Yoo","name":"Yoo, Chang D.","affiliation":[],"nameIdentifiers":[]}],"titles":[{"title":"Uncertainty-Aware Rank-One MIMO Q Network Framework for Accelerated Offline Reinforcement Learning"}],"publisher":"arXiv","container":{},"publicationYear":2026,"subjects":[{"subject":"Machine Learning (cs.LG)","lang":"en","subjectScheme":"arXiv"},{"subject":"Robotics (cs.RO)","lang":"en","subjectScheme":"arXiv"},{"subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"},{"schemeUri":"http://www.oecd.org/science/inno/38235147.pdf","subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"}],"contributors":[],"dates":[{"date":"2026-02-23T14:57:52Z","dateType":"Submitted","dateInformation":"v1"},{"date":"2026-02-24T02:32:23Z","dateType":"Updated","dateInformation":"v1"},{"date":"2026-02","dateType":"Available","dateInformation":"v1"},{"date":"2026","dateType":"Issued"}],"language":null,"types":{"schemaOrg":"CreativeWork","resourceTypeGeneral":"Preprint","citeproc":"article","bibtex":"misc","ris":"GEN","resourceType":"Article"},"relatedIdentifiers":[{"relationType":"IsVersionOf","relatedIdentifier":"10.1109/access.2024.3404474","relatedIdentifierType":"DOI"}],"relatedItems":[],"sizes":[],"formats":[],"version":"1","rightsList":[{"rightsIdentifierScheme":"SPDX","rightsUri":"https://creativecommons.org/licenses/by/4.0/legalcode","schemeUri":"https://spdx.org/licenses/","rights":"Creative Commons Attribution 4.0 International","rightsIdentifier":"cc-by-4.0"}],"descriptions":[{"descriptionType":"Abstract","description":"Offline reinforcement learning (RL) has garnered significant interest due to its safe and easily scalable paradigm. However, training under this paradigm presents its own challenge: the extrapolation error stemming from out-of-distribution (OOD) data. Existing methodologies have endeavored to address this issue through means like penalizing OOD Q-values or imposing similarity constraints on the learned policy and the behavior policy. Nonetheless, these approaches are often beset by limitations such as being overly conservative in utilizing OOD data, imprecise OOD data characterization, and significant computational overhead. To address these challenges, this paper introduces an Uncertainty-Aware Rank-One Multi-Input Multi-Output (MIMO) Q Network framework. The framework aims to enhance Offline Reinforcement Learning by fully leveraging the potential of OOD data while still ensuring efficiency in the learning process. Specifically, the framework quantifies data uncertainty and harnesses it in the training losses, aiming to train a policy that maximizes the lower confidence bound of the corresponding Q-function. Furthermore, a Rank-One MIMO architecture is introduced to model the uncertainty-aware Q-function, \\TP{offering the same ability for uncertainty quantification as an ensemble of networks but with a cost nearly equivalent to that of a single network}. Consequently, this framework strikes a harmonious balance between precision, speed, and memory efficiency, culminating in improved overall performance. Extensive experimentation on the D4RL benchmark demonstrates that the framework attains state-of-the-art performance while remaining computationally efficient. By incorporating the concept of uncertainty quantification, our framework offers a promising avenue to alleviate extrapolation errors and enhance the efficiency of offline RL."},{"descriptionType":"Other","description":"10 pages, 4 Figures, IEEE Access"}],"geoLocations":[],"fundingReferences":[],"url":"https://arxiv.org/abs/2602.19917","contentUrl":null,"metadataVersion":0,"schemaVersion":"http://datacite.org/schema/kernel-4","source":"mds","isActive":true,"state":"findable","reason":null,"viewCount":0,"downloadCount":0,"referenceCount":0,"citationCount":0,"partCount":0,"partOfCount":0,"versionCount":0,"versionOfCount":1,"created":"2026-02-25T15:20:22Z","registered":"2026-02-25T15:20:23Z","published":null,"updated":"2026-02-25T15:20:23Z"},"relationships":{"client":{"data":{"id":"arxiv.content","type":"clients"}}}},{"id":"10.48550/arxiv.2602.19916","type":"dois","attributes":{"doi":"10.48550/arxiv.2602.19916","identifiers":[{"identifier":"2602.19916","identifierType":"arXiv"}],"creators":[{"nameType":"Personal","givenName":"Yixin","familyName":"Yang","name":"Yang, Yixin","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Bojian","familyName":"Wu","name":"Wu, Bojian","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Yang","familyName":"Zhou","name":"Zhou, Yang","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Hui","familyName":"Huang","name":"Huang, Hui","affiliation":[],"nameIdentifiers":[]}],"titles":[{"title":"Augmented Radiance Field: A General Framework for Enhanced Gaussian Splatting"}],"publisher":"arXiv","container":{},"publicationYear":2026,"subjects":[{"subject":"Computer Vision and Pattern Recognition (cs.CV)","lang":"en","subjectScheme":"arXiv"},{"subject":"Graphics (cs.GR)","lang":"en","subjectScheme":"arXiv"},{"subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"},{"schemeUri":"http://www.oecd.org/science/inno/38235147.pdf","subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"}],"contributors":[],"dates":[{"date":"2026-02-23T14:55:31Z","dateType":"Submitted","dateInformation":"v1"},{"date":"2026-02-24T02:32:16Z","dateType":"Updated","dateInformation":"v1"},{"date":"2026-02","dateType":"Available","dateInformation":"v1"},{"date":"2026","dateType":"Issued"}],"language":null,"types":{"schemaOrg":"CreativeWork","resourceTypeGeneral":"Preprint","citeproc":"article","bibtex":"misc","ris":"GEN","resourceType":"Article"},"relatedIdentifiers":[],"relatedItems":[],"sizes":[],"formats":[],"version":"1","rightsList":[{"rightsUri":"http://arxiv.org/licenses/nonexclusive-distrib/1.0/","rights":"arXiv.org perpetual, non-exclusive license"}],"descriptions":[{"descriptionType":"Abstract","description":"Due to the real-time rendering performance, 3D Gaussian Splatting (3DGS) has emerged as the leading method for radiance field reconstruction. However, its reliance on spherical harmonics for color encoding inherently limits its ability to separate diffuse and specular components, making it challenging to accurately represent complex reflections. To address this, we propose a novel enhanced Gaussian kernel that explicitly models specular effects through view-dependent opacity. Meanwhile, we introduce an error-driven compensation strategy to improve rendering quality in existing 3DGS scenes. Our method begins with 2D Gaussian initialization and then adaptively inserts and optimizes enhanced Gaussian kernels, ultimately producing an augmented radiance field. Experiments demonstrate that our method not only surpasses state-of-the-art NeRF methods in rendering performance but also achieves greater parameter efficiency. Project page at: https://xiaoxinyyx.github.io/augs."},{"descriptionType":"Other","description":"Accepted to ICLR 2026. Project page: \\url{https://xiaoxinyyx.github.io/augs}"}],"geoLocations":[],"fundingReferences":[],"url":"https://arxiv.org/abs/2602.19916","contentUrl":null,"metadataVersion":0,"schemaVersion":"http://datacite.org/schema/kernel-4","source":"mds","isActive":true,"state":"findable","reason":null,"viewCount":0,"downloadCount":0,"referenceCount":0,"citationCount":0,"partCount":0,"partOfCount":0,"versionCount":0,"versionOfCount":0,"created":"2026-02-25T15:20:20Z","registered":"2026-02-25T15:20:20Z","published":null,"updated":"2026-02-25T15:20:20Z"},"relationships":{"client":{"data":{"id":"arxiv.content","type":"clients"}}}},{"id":"10.48550/arxiv.2602.19915","type":"dois","attributes":{"doi":"10.48550/arxiv.2602.19915","identifiers":[{"identifier":"2602.19915","identifierType":"arXiv"}],"creators":[{"nameType":"Personal","givenName":"Michael","familyName":"Trimboli","name":"Trimboli, Michael","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Mohammed","familyName":"Alsubaie","name":"Alsubaie, Mohammed","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Sirani M.","familyName":"Perera","name":"Perera, Sirani M.","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Ke-Gang","familyName":"Wang","name":"Wang, Ke-Gang","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Xianqi","familyName":"Li","name":"Li, Xianqi","affiliation":[],"nameIdentifiers":[]}],"titles":[{"title":"Fully Convolutional Spatiotemporal Learning for Microstructure Evolution Prediction"}],"publisher":"arXiv","container":{},"publicationYear":2026,"subjects":[{"subject":"Machine Learning (cs.LG)","lang":"en","subjectScheme":"arXiv"},{"subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"},{"schemeUri":"http://www.oecd.org/science/inno/38235147.pdf","subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"}],"contributors":[],"dates":[{"date":"2026-02-23T14:55:28Z","dateType":"Submitted","dateInformation":"v1"},{"date":"2026-02-24T02:32:13Z","dateType":"Updated","dateInformation":"v1"},{"date":"2026-02","dateType":"Available","dateInformation":"v1"},{"date":"2026","dateType":"Issued"}],"language":null,"types":{"schemaOrg":"CreativeWork","resourceTypeGeneral":"Preprint","citeproc":"article","bibtex":"misc","ris":"GEN","resourceType":"Article"},"relatedIdentifiers":[],"relatedItems":[],"sizes":[],"formats":[],"version":"1","rightsList":[{"rightsIdentifierScheme":"SPDX","rightsUri":"https://creativecommons.org/licenses/by/4.0/legalcode","schemeUri":"https://spdx.org/licenses/","rights":"Creative Commons Attribution 4.0 International","rightsIdentifier":"cc-by-4.0"}],"descriptions":[{"descriptionType":"Abstract","description":"Understanding and predicting microstructure evolution is fundamental to materials science, as it governs the resulting properties and performance of materials. Traditional simulation methods, such as phase-field models, offer high-fidelity results but are computationally expensive due to the need to solve complex partial differential equations at fine spatiotemporal resolutions. To address this challenge, we propose a deep learning-based framework that accelerates microstructure evolution predictions while maintaining high accuracy. Our approach utilizes a fully convolutional spatiotemporal model trained in a self-supervised manner using sequential images generated from simulations of microstructural processes, including grain growth and spinodal decomposition. The trained neural network effectively learns the underlying physical dynamics and can accurately capture both short-term local behaviors and long-term statistical properties of evolving microstructures, while also demonstrating generalization to unseen spatiotemporal domains and variations in configuration and material parameters. Compared to recurrent neural architectures, our model achieves state-of-the-art predictive performance with significantly reduced computational cost in both training and inference. This work establishes a robust baseline for spatiotemporal learning in materials science and offers a scalable, data-driven alternative for fast and reliable microstructure simulations."},{"descriptionType":"Other","description":"24 pages, 11 figures"}],"geoLocations":[],"fundingReferences":[],"url":"https://arxiv.org/abs/2602.19915","contentUrl":null,"metadataVersion":0,"schemaVersion":"http://datacite.org/schema/kernel-4","source":"mds","isActive":true,"state":"findable","reason":null,"viewCount":0,"downloadCount":0,"referenceCount":0,"citationCount":0,"partCount":0,"partOfCount":0,"versionCount":0,"versionOfCount":0,"created":"2026-02-25T15:20:17Z","registered":"2026-02-25T15:20:18Z","published":null,"updated":"2026-02-25T15:20:18Z"},"relationships":{"client":{"data":{"id":"arxiv.content","type":"clients"}}}},{"id":"10.48550/arxiv.2602.19914","type":"dois","attributes":{"doi":"10.48550/arxiv.2602.19914","identifiers":[{"identifier":"2602.19914","identifierType":"arXiv"}],"creators":[{"nameType":"Personal","givenName":"Thatchawin","familyName":"Leelawat","name":"Leelawat, Thatchawin","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Lewis D","familyName":"Griffin","name":"Griffin, Lewis D","affiliation":[],"nameIdentifiers":[]}],"titles":[{"title":"Watson \u0026amp; Holmes: A Naturalistic Benchmark for Comparing Human and LLM Reasoning"}],"publisher":"arXiv","container":{},"publicationYear":2026,"subjects":[{"subject":"Artificial Intelligence (cs.AI)","lang":"en","subjectScheme":"arXiv"},{"subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"},{"schemeUri":"http://www.oecd.org/science/inno/38235147.pdf","subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"}],"contributors":[],"dates":[{"date":"2026-02-23T14:54:38Z","dateType":"Submitted","dateInformation":"v1"},{"date":"2026-02-24T02:32:12Z","dateType":"Updated","dateInformation":"v1"},{"date":"2026-02","dateType":"Available","dateInformation":"v1"},{"date":"2026","dateType":"Issued"}],"language":null,"types":{"schemaOrg":"CreativeWork","resourceTypeGeneral":"Preprint","citeproc":"article","bibtex":"misc","ris":"GEN","resourceType":"Article"},"relatedIdentifiers":[],"relatedItems":[],"sizes":[],"formats":[],"version":"1","rightsList":[{"rightsIdentifierScheme":"SPDX","rightsUri":"https://creativecommons.org/licenses/by/4.0/legalcode","schemeUri":"https://spdx.org/licenses/","rights":"Creative Commons Attribution 4.0 International","rightsIdentifier":"cc-by-4.0"}],"descriptions":[{"descriptionType":"Abstract","description":"Existing benchmarks for AI reasoning provide limited insight into how closely these capabilities resemble human reasoning in naturalistic contexts. We present an adaptation of the Watson \u0026amp; Holmes detective tabletop game as a new benchmark designed to evaluate reasoning performance using incrementally presented narrative evidence, open-ended questions and unconstrained language responses. An automated grading system was developed and validated against human assessors to enable scalable and replicable performance evaluation. Results show a clear improvement in AI model performance over time. Over nine months of 2025, model performance rose from the lower quartile of the human comparison group to approximately the top 5%. Around half of this improvement reflects steady advancement across successive model releases, while the remainder corresponds to a marked step change associated with reasoning-oriented model architectures. Systematic differences in the performance of AI models compared to humans, dependent on features of the specific detection puzzle, were mostly absent with the exception of a fall in performance for models when solving longer cases (case lengths being in the range of 1900-4000 words), and an advantage at inductive reasoning for reasoning models at early stages of case solving when evidence was scant."},{"descriptionType":"Other","description":"51 pages, 13 figures"}],"geoLocations":[],"fundingReferences":[],"url":"https://arxiv.org/abs/2602.19914","contentUrl":null,"metadataVersion":0,"schemaVersion":"http://datacite.org/schema/kernel-4","source":"mds","isActive":true,"state":"findable","reason":null,"viewCount":0,"downloadCount":0,"referenceCount":0,"citationCount":0,"partCount":0,"partOfCount":0,"versionCount":0,"versionOfCount":0,"created":"2026-02-25T15:20:15Z","registered":"2026-02-25T15:20:15Z","published":null,"updated":"2026-02-25T15:20:15Z"},"relationships":{"client":{"data":{"id":"arxiv.content","type":"clients"}}}},{"id":"10.48550/arxiv.2602.19909","type":"dois","attributes":{"doi":"10.48550/arxiv.2602.19909","identifiers":[{"identifier":"2602.19909","identifierType":"arXiv"}],"creators":[{"nameType":"Personal","givenName":"Sid","familyName":"Smith","name":"Smith, Sid","affiliation":[],"nameIdentifiers":[]}],"titles":[{"title":"Symbolic syzygy-constrained reduction rules for Feynman integrals and the LoopIn framework"}],"publisher":"arXiv","container":{},"publicationYear":2026,"subjects":[{"subject":"High Energy Physics - Theory (hep-th)","lang":"en","subjectScheme":"arXiv"},{"subject":"High Energy Physics - Phenomenology (hep-ph)","lang":"en","subjectScheme":"arXiv"},{"subject":"FOS: Physical sciences","subjectScheme":"Fields of Science and Technology (FOS)"},{"schemeUri":"http://www.oecd.org/science/inno/38235147.pdf","subject":"FOS: Physical sciences","subjectScheme":"Fields of Science and Technology (FOS)"}],"contributors":[],"dates":[{"date":"2026-02-23T14:48:24Z","dateType":"Submitted","dateInformation":"v1"},{"date":"2026-02-24T02:31:55Z","dateType":"Updated","dateInformation":"v1"},{"date":"2026-02","dateType":"Available","dateInformation":"v1"},{"date":"2026","dateType":"Issued"}],"language":null,"types":{"schemaOrg":"CreativeWork","resourceTypeGeneral":"Preprint","citeproc":"article","bibtex":"misc","ris":"GEN","resourceType":"Article"},"relatedIdentifiers":[],"relatedItems":[],"sizes":[],"formats":[],"version":"1","rightsList":[{"rightsIdentifierScheme":"SPDX","rightsUri":"https://creativecommons.org/licenses/by/4.0/legalcode","schemeUri":"https://spdx.org/licenses/","rights":"Creative Commons Attribution 4.0 International","rightsIdentifier":"cc-by-4.0"}],"descriptions":[{"descriptionType":"Abstract","description":"We present a new algorithm for integration-by-parts (IBP) reduction of Feynman integrals with high powers of numerators or propagators, a demanding computational step in evaluating multi-loop scattering amplitudes. The algorithm allows us to avoid a large intermediate system of equations and instead focus on applying direct reduction rules to the integrals. We demonstrate the application of our algorithm with some highly non-trivial examples, namely rank-20 integrals for the double box with an external mass and the massless pentabox. We also achieve much faster IBP reduction for an example of scattering amplitudes for spinning black hole binary systems. Finally, we present LoopIn, a modular framework for automating multi-loop calculations, where the IBP techniques described here can be interfaced."},{"descriptionType":"Other","description":"14 pages, 6 figures, 3 tables"}],"geoLocations":[],"fundingReferences":[],"url":"https://arxiv.org/abs/2602.19909","contentUrl":null,"metadataVersion":0,"schemaVersion":"http://datacite.org/schema/kernel-4","source":"mds","isActive":true,"state":"findable","reason":null,"viewCount":0,"downloadCount":0,"referenceCount":0,"citationCount":0,"partCount":0,"partOfCount":0,"versionCount":0,"versionOfCount":0,"created":"2026-02-25T15:20:02Z","registered":"2026-02-25T15:20:03Z","published":null,"updated":"2026-02-25T15:20:03Z"},"relationships":{"client":{"data":{"id":"arxiv.content","type":"clients"}}}},{"id":"10.48550/arxiv.2602.19907","type":"dois","attributes":{"doi":"10.48550/arxiv.2602.19907","identifiers":[{"identifier":"2602.19907","identifierType":"arXiv"}],"creators":[{"nameType":"Personal","givenName":"Kiran","familyName":"Kokilepersaud","name":"Kokilepersaud, Kiran","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Mohit","familyName":"Prabhushankar","name":"Prabhushankar, Mohit","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Ghassan","familyName":"AlRegib","name":"AlRegib, Ghassan","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Stephanie Trejo","familyName":"Corona","name":"Corona, Stephanie Trejo","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Charles","familyName":"Wykoff","name":"Wykoff, Charles","affiliation":[],"nameIdentifiers":[]}],"titles":[{"title":"Gradient based Severity Labeling for Biomarker Classification in OCT"}],"publisher":"arXiv","container":{},"publicationYear":2026,"subjects":[{"subject":"Computer Vision and Pattern Recognition (cs.CV)","lang":"en","subjectScheme":"arXiv"},{"subject":"Machine Learning (cs.LG)","lang":"en","subjectScheme":"arXiv"},{"subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"},{"schemeUri":"http://www.oecd.org/science/inno/38235147.pdf","subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"}],"contributors":[],"dates":[{"date":"2026-02-23T14:46:08Z","dateType":"Submitted","dateInformation":"v1"},{"date":"2026-02-24T02:31:44Z","dateType":"Updated","dateInformation":"v1"},{"date":"2026-02","dateType":"Available","dateInformation":"v1"},{"date":"2026","dateType":"Issued"}],"language":null,"types":{"schemaOrg":"CreativeWork","resourceTypeGeneral":"Preprint","citeproc":"article","bibtex":"misc","ris":"GEN","resourceType":"Article"},"relatedIdentifiers":[],"relatedItems":[],"sizes":[],"formats":[],"version":"1","rightsList":[{"rightsIdentifierScheme":"SPDX","rightsUri":"https://creativecommons.org/licenses/by/4.0/legalcode","schemeUri":"https://spdx.org/licenses/","rights":"Creative Commons Attribution 4.0 International","rightsIdentifier":"cc-by-4.0"}],"descriptions":[{"descriptionType":"Abstract","description":"In this paper, we propose a novel selection strategy for contrastive learning for medical images. On natural images, contrastive learning uses augmentations to select positive and negative pairs for the contrastive loss. However, in the medical domain, arbitrary augmentations have the potential to distort small localized regions that contain the biomarkers we are interested in detecting. A more intuitive approach is to select samples with similar disease severity characteristics, since these samples are more likely to have similar structures related to the progression of a disease. To enable this, we introduce a method that generates disease severity labels for unlabeled OCT scans on the basis of gradient responses from an anomaly detection algorithm. These labels are used to train a supervised contrastive learning setup to improve biomarker classification accuracy by as much as 6% above self-supervised baselines for key indicators of Diabetic Retinopathy."},{"descriptionType":"Other","description":"Accepted at International Conference on Image Processing (ICIP) 2022"}],"geoLocations":[],"fundingReferences":[],"url":"https://arxiv.org/abs/2602.19907","contentUrl":null,"metadataVersion":0,"schemaVersion":"http://datacite.org/schema/kernel-4","source":"mds","isActive":true,"state":"findable","reason":null,"viewCount":0,"downloadCount":0,"referenceCount":0,"citationCount":0,"partCount":0,"partOfCount":0,"versionCount":0,"versionOfCount":0,"created":"2026-02-25T15:19:57Z","registered":"2026-02-25T15:19:58Z","published":null,"updated":"2026-02-25T15:19:58Z"},"relationships":{"client":{"data":{"id":"arxiv.content","type":"clients"}}}},{"id":"10.48550/arxiv.2602.19905","type":"dois","attributes":{"doi":"10.48550/arxiv.2602.19905","identifiers":[{"identifier":"2602.19905","identifierType":"arXiv"}],"creators":[{"nameType":"Personal","givenName":"Shoufeng","familyName":"Wang","name":"Wang, Shoufeng","affiliation":[],"nameIdentifiers":[]}],"titles":[{"title":"Deformed solutions of the Yang-Baxter equation associated to dual weak left $\\star$-braces"}],"publisher":"arXiv","container":{},"publicationYear":2026,"subjects":[{"subject":"Group Theory (math.GR)","lang":"en","subjectScheme":"arXiv"},{"subject":"Quantum Algebra (math.QA)","lang":"en","subjectScheme":"arXiv"},{"subject":"FOS: Mathematics","subjectScheme":"Fields of Science and Technology (FOS)"},{"schemeUri":"http://www.oecd.org/science/inno/38235147.pdf","subject":"FOS: Mathematics","subjectScheme":"Fields of Science and Technology (FOS)"},{"subject":"20M18, 16T25, 16Y99","lang":"en","subjectScheme":"MSC"}],"contributors":[],"dates":[{"date":"2026-02-23T14:44:17Z","dateType":"Submitted","dateInformation":"v1"},{"date":"2026-02-24T02:31:33Z","dateType":"Updated","dateInformation":"v1"},{"date":"2026-02","dateType":"Available","dateInformation":"v1"},{"date":"2026","dateType":"Issued"}],"language":null,"types":{"schemaOrg":"CreativeWork","resourceTypeGeneral":"Preprint","citeproc":"article","bibtex":"misc","ris":"GEN","resourceType":"Article"},"relatedIdentifiers":[],"relatedItems":[],"sizes":[],"formats":[],"version":"1","rightsList":[{"rightsUri":"http://arxiv.org/licenses/nonexclusive-distrib/1.0/","rights":"arXiv.org perpetual, non-exclusive license"}],"descriptions":[{"descriptionType":"Abstract","description":"As generalizations of dual weak left braces and skew left braces, in this paper, dual weak left $\\star$-braces and square skew left braces are introduced, respectively. We firstly show that a dual weak left $\\star$-brace is exactly a strong semilattice of a family of square skew left braces. Then we introduce distributors for dual weak left $\\star$-braces and prove that the map deformed by each distributor is always a solution of the Yang-Baxter equation. Our work may be regarded as extending and enriching some related results on skew left braces and weak left braces in literature."},{"descriptionType":"Other","description":"14 pages"}],"geoLocations":[],"fundingReferences":[],"url":"https://arxiv.org/abs/2602.19905","contentUrl":null,"metadataVersion":0,"schemaVersion":"http://datacite.org/schema/kernel-4","source":"mds","isActive":true,"state":"findable","reason":null,"viewCount":0,"downloadCount":0,"referenceCount":0,"citationCount":0,"partCount":0,"partOfCount":0,"versionCount":0,"versionOfCount":0,"created":"2026-02-25T15:19:53Z","registered":"2026-02-25T15:19:54Z","published":null,"updated":"2026-02-25T15:19:54Z"},"relationships":{"client":{"data":{"id":"arxiv.content","type":"clients"}}}},{"id":"10.48550/arxiv.2602.19904","type":"dois","attributes":{"doi":"10.48550/arxiv.2602.19904","identifiers":[{"identifier":"2602.19904","identifierType":"arXiv"}],"creators":[{"nameType":"Personal","givenName":"Mark V","familyName":"Lawson","name":"Lawson, Mark V","affiliation":[],"nameIdentifiers":[]}],"titles":[{"title":"Finitary Cartesian closed varieties and semigroup actions"}],"publisher":"arXiv","container":{},"publicationYear":2026,"subjects":[{"subject":"Category Theory (math.CT)","lang":"en","subjectScheme":"arXiv"},{"subject":"FOS: Mathematics","subjectScheme":"Fields of Science and Technology (FOS)"},{"schemeUri":"http://www.oecd.org/science/inno/38235147.pdf","subject":"FOS: Mathematics","subjectScheme":"Fields of Science and Technology (FOS)"}],"contributors":[],"dates":[{"date":"2026-02-23T14:43:45Z","dateType":"Submitted","dateInformation":"v1"},{"date":"2026-02-24T02:31:33Z","dateType":"Updated","dateInformation":"v1"},{"date":"2026-02","dateType":"Available","dateInformation":"v1"},{"date":"2026","dateType":"Issued"}],"language":null,"types":{"schemaOrg":"CreativeWork","resourceTypeGeneral":"Preprint","citeproc":"article","bibtex":"misc","ris":"GEN","resourceType":"Article"},"relatedIdentifiers":[],"relatedItems":[],"sizes":[],"formats":[],"version":"1","rightsList":[{"rightsIdentifierScheme":"SPDX","rightsUri":"https://creativecommons.org/licenses/by/4.0/legalcode","schemeUri":"https://spdx.org/licenses/","rights":"Creative Commons Attribution 4.0 International","rightsIdentifier":"cc-by-4.0"}],"descriptions":[{"descriptionType":"Abstract","description":"We build on some ideas of Richard Garner. Let $M$ be a monoid and $B$ a Boolean algebra. A `matched pair' $[B|M]$ consists of $B$ and $M$ and some mutual interactions. Garner showed that every such matched pair determines (what we shall call) a Boolean left restriction monoid $S = S[B|M]$. In this paper, we show that the data of a $[B|M]$-set (defined later) may be encoded by means of a certain kind of action by $S$. This means that the category $[B|M]$-{\\bf sets} is equivalent to a category of {\\bf $S$-actions}. We deduce, as a result of Garner's work, that every non-degenerate finitary Cartesian closed variety is equivalent to a special category of $S$-actions where $S$ is a Boolean left restriction monoid."}],"geoLocations":[],"fundingReferences":[],"url":"https://arxiv.org/abs/2602.19904","contentUrl":null,"metadataVersion":0,"schemaVersion":"http://datacite.org/schema/kernel-4","source":"mds","isActive":true,"state":"findable","reason":null,"viewCount":0,"downloadCount":0,"referenceCount":0,"citationCount":0,"partCount":0,"partOfCount":0,"versionCount":0,"versionOfCount":0,"created":"2026-02-25T15:19:50Z","registered":"2026-02-25T15:19:51Z","published":null,"updated":"2026-02-25T15:19:51Z"},"relationships":{"client":{"data":{"id":"arxiv.content","type":"clients"}}}},{"id":"10.48550/arxiv.2602.19903","type":"dois","attributes":{"doi":"10.48550/arxiv.2602.19903","identifiers":[{"identifier":"2602.19903","identifierType":"arXiv"}],"creators":[{"nameType":"Personal","givenName":"Kurt","familyName":"Butler","name":"Butler, Kurt","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Damian","familyName":"Machlanski","name":"Machlanski, Damian","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Panagiotis","familyName":"Dimitrakopoulos","name":"Dimitrakopoulos, Panagiotis","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Sotirios A.","familyName":"Tsaftaris","name":"Tsaftaris, Sotirios A.","affiliation":[],"nameIdentifiers":[]}],"titles":[{"title":"Rethinking Chronological Causal Discovery with Signal Processing"}],"publisher":"arXiv","container":{},"publicationYear":2026,"subjects":[{"subject":"Signal Processing (eess.SP)","lang":"en","subjectScheme":"arXiv"},{"subject":"Machine Learning (cs.LG)","lang":"en","subjectScheme":"arXiv"},{"subject":"Machine Learning (stat.ML)","lang":"en","subjectScheme":"arXiv"},{"subject":"FOS: Electrical engineering, electronic engineering, information engineering","subjectScheme":"Fields of Science and Technology (FOS)"},{"schemeUri":"http://www.oecd.org/science/inno/38235147.pdf","subject":"FOS: Electrical engineering, electronic engineering, information engineering","subjectScheme":"Fields of Science and Technology (FOS)"},{"subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"},{"schemeUri":"http://www.oecd.org/science/inno/38235147.pdf","subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"},{"subject":"62M10","lang":"en","subjectScheme":"MSC"}],"contributors":[],"dates":[{"date":"2026-02-23T14:43:15Z","dateType":"Submitted","dateInformation":"v1"},{"date":"2026-02-24T02:31:32Z","dateType":"Updated","dateInformation":"v1"},{"date":"2026-02","dateType":"Available","dateInformation":"v1"},{"date":"2026","dateType":"Issued"}],"language":null,"types":{"schemaOrg":"CreativeWork","resourceTypeGeneral":"Preprint","citeproc":"article","bibtex":"misc","ris":"GEN","resourceType":"Article"},"relatedIdentifiers":[],"relatedItems":[],"sizes":[],"formats":[],"version":"1","rightsList":[{"rightsIdentifierScheme":"SPDX","rightsUri":"https://creativecommons.org/licenses/by/4.0/legalcode","schemeUri":"https://spdx.org/licenses/","rights":"Creative Commons Attribution 4.0 International","rightsIdentifier":"cc-by-4.0"}],"descriptions":[{"descriptionType":"Abstract","description":"Causal discovery problems use a set of observations to deduce causality between variables in the real world, typically to answer questions about biological or physical systems. These observations are often recorded at regular time intervals, determined by a user or a machine, depending on the experiment design. There is generally no guarantee that the timing of these recordings matches the timing of the underlying biological or physical events. In this paper, we examine the sensitivity of causal discovery methods to this potential mismatch. We consider empirical and theoretical evidence to understand how causal discovery performance is impacted by changes of sampling rate and window length. We demonstrate that both classical and recent causal discovery methods exhibit sensitivity to these hyperparameters, and we discuss how ideas from signal processing may help us understand these phenomena."},{"descriptionType":"Other","description":"5 pages, 5 figures, Final version accepted to the 59th Asilomar Conference on Signals, Systems, and Computers (2025)"}],"geoLocations":[],"fundingReferences":[],"url":"https://arxiv.org/abs/2602.19903","contentUrl":null,"metadataVersion":0,"schemaVersion":"http://datacite.org/schema/kernel-4","source":"mds","isActive":true,"state":"findable","reason":null,"viewCount":0,"downloadCount":0,"referenceCount":0,"citationCount":0,"partCount":0,"partOfCount":0,"versionCount":0,"versionOfCount":0,"created":"2026-02-25T15:19:48Z","registered":"2026-02-25T15:19:49Z","published":null,"updated":"2026-02-25T15:19:49Z"},"relationships":{"client":{"data":{"id":"arxiv.content","type":"clients"}}}},{"id":"10.48550/arxiv.2602.19901","type":"dois","attributes":{"doi":"10.48550/arxiv.2602.19901","identifiers":[{"identifier":"2602.19901","identifierType":"arXiv"}],"creators":[{"nameType":"Personal","givenName":"Duc-Manh","familyName":"Nguyen","name":"Nguyen, Duc-Manh","affiliation":[],"nameIdentifiers":[]}],"titles":[{"title":"Hilbert surfaces, modular forms, and Siegel-Veech constants"}],"publisher":"arXiv","container":{},"publicationYear":2026,"subjects":[{"subject":"Algebraic Geometry (math.AG)","lang":"en","subjectScheme":"arXiv"},{"subject":"Complex Variables (math.CV)","lang":"en","subjectScheme":"arXiv"},{"subject":"Dynamical Systems (math.DS)","lang":"en","subjectScheme":"arXiv"},{"subject":"Number Theory (math.NT)","lang":"en","subjectScheme":"arXiv"},{"subject":"FOS: Mathematics","subjectScheme":"Fields of Science and Technology (FOS)"},{"schemeUri":"http://www.oecd.org/science/inno/38235147.pdf","subject":"FOS: Mathematics","subjectScheme":"Fields of Science and Technology (FOS)"},{"subject":"30F30, 11F03, 37F34","lang":"en","subjectScheme":"MSC"}],"contributors":[],"dates":[{"date":"2026-02-23T14:42:13Z","dateType":"Submitted","dateInformation":"v1"},{"date":"2026-02-24T02:31:29Z","dateType":"Updated","dateInformation":"v1"},{"date":"2026-02","dateType":"Available","dateInformation":"v1"},{"date":"2026","dateType":"Issued"}],"language":null,"types":{"schemaOrg":"CreativeWork","resourceTypeGeneral":"Preprint","citeproc":"article","bibtex":"misc","ris":"GEN","resourceType":"Article"},"relatedIdentifiers":[],"relatedItems":[],"sizes":[],"formats":[],"version":"1","rightsList":[{"rightsUri":"http://arxiv.org/licenses/nonexclusive-distrib/1.0/","rights":"arXiv.org perpetual, non-exclusive license"}],"descriptions":[{"descriptionType":"Abstract","description":"We give the values of the Siegel-Veech constants associated with saddle connections having distinct endpoints on translation surfaces in Prym eigenform loci in $Ω\\mathcal{M}_3(2,2)^{\\rm odd}$. In particular, we show that these constants are actually the same for all of these loci. As a by-product, we show that the Euler characteristic of the Hilbert modular surfaces which parametrize Abelian surfaces with $(1,2)$-polarization admitting a real multiplication and the Euler characteristic of their product locus are related by a simple formula. For principally polarized Abelian surfaces, a similar phenomenon has been observed by Bainbridge."},{"descriptionType":"Other","description":"25 pages, subsequent to arxiv:2510.23333"}],"geoLocations":[],"fundingReferences":[],"url":"https://arxiv.org/abs/2602.19901","contentUrl":null,"metadataVersion":0,"schemaVersion":"http://datacite.org/schema/kernel-4","source":"mds","isActive":true,"state":"findable","reason":null,"viewCount":0,"downloadCount":0,"referenceCount":0,"citationCount":0,"partCount":0,"partOfCount":0,"versionCount":0,"versionOfCount":0,"created":"2026-02-25T15:19:43Z","registered":"2026-02-25T15:19:44Z","published":null,"updated":"2026-02-25T15:19:44Z"},"relationships":{"client":{"data":{"id":"arxiv.content","type":"clients"}}}},{"id":"10.48550/arxiv.2602.19898","type":"dois","attributes":{"doi":"10.48550/arxiv.2602.19898","identifiers":[{"identifier":"2602.19898","identifierType":"arXiv"}],"creators":[{"nameType":"Personal","givenName":"Stefan","familyName":"Fabian","name":"Fabian, Stefan","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Aljoscha","familyName":"Schmidt","name":"Schmidt, Aljoscha","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Jonas","familyName":"Süß","name":"Süß, Jonas","affiliation":[],"nameIdentifiers":[]},{"nameType":"Organizational","affiliation":[],"name":"Dishant","nameIdentifiers":[]},{"nameType":"Personal","givenName":"Aum","familyName":"Oza","name":"Oza, Aum","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Oskar","familyName":"von Stryk","name":"von Stryk, Oskar","affiliation":[],"nameIdentifiers":[]}],"titles":[{"title":"Athena: An Autonomous Open-Hardware Tracked Rescue Robot Platform"}],"publisher":"arXiv","container":{},"publicationYear":2026,"subjects":[{"subject":"Robotics (cs.RO)","lang":"en","subjectScheme":"arXiv"},{"subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"},{"schemeUri":"http://www.oecd.org/science/inno/38235147.pdf","subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"}],"contributors":[],"dates":[{"date":"2026-02-23T14:38:23Z","dateType":"Submitted","dateInformation":"v1"},{"date":"2026-02-24T02:31:08Z","dateType":"Updated","dateInformation":"v1"},{"date":"2026-02","dateType":"Available","dateInformation":"v1"},{"date":"2026","dateType":"Issued"}],"language":null,"types":{"schemaOrg":"CreativeWork","resourceTypeGeneral":"Preprint","citeproc":"article","bibtex":"misc","ris":"GEN","resourceType":"Article"},"relatedIdentifiers":[{"relationType":"IsVersionOf","relatedIdentifier":"10.1109/ssrr68451.2025.11391264","relatedIdentifierType":"DOI"}],"relatedItems":[],"sizes":[],"formats":[],"version":"1","rightsList":[{"rightsUri":"http://arxiv.org/licenses/nonexclusive-distrib/1.0/","rights":"arXiv.org perpetual, non-exclusive license"}],"descriptions":[{"descriptionType":"Abstract","description":"In disaster response and situation assessment, robots have great potential in reducing the risks to the safety and health of first responders. As the situations encountered and the required capabilities of the robots deployed in such missions differ wildly and are often not known in advance, heterogeneous fleets of robots are needed to cover a wide range of mission requirements. While UAVs can quickly survey the mission environment, their ability to carry heavy payloads such as sensors and manipulators is limited. UGVs can carry required payloads to assess and manipulate the mission environment, but need to be able to deal with difficult and unstructured terrain such as rubble and stairs. The ability of tracked platforms with articulated arms (flippers) to reconfigure their geometry makes them particularly effective for navigating challenging terrain. In this paper, we present Athena, an open-hardware rescue ground robot research platform with four individually reconfigurable flippers and a reliable low-cost remote emergency stop (E-Stop) solution. A novel mounting solution using an industrial PU belt and tooth inserts allows the replacement and testing of different track profiles. The manipulator with a maximum reach of 1.54m can be used to operate doors, valves, and other objects of interest. Full CAD \u0026amp; PCB files, as well as all low-level software, are released as open-source contributions."},{"descriptionType":"Other","description":"https://github.com/tu-darmstadt-ros-pkg/athena"}],"geoLocations":[],"fundingReferences":[],"url":"https://arxiv.org/abs/2602.19898","contentUrl":null,"metadataVersion":0,"schemaVersion":"http://datacite.org/schema/kernel-4","source":"mds","isActive":true,"state":"findable","reason":null,"viewCount":0,"downloadCount":0,"referenceCount":0,"citationCount":0,"partCount":0,"partOfCount":0,"versionCount":0,"versionOfCount":1,"created":"2026-02-25T15:19:36Z","registered":"2026-02-25T15:19:36Z","published":null,"updated":"2026-02-25T15:19:36Z"},"relationships":{"client":{"data":{"id":"arxiv.content","type":"clients"}}}},{"id":"10.48550/arxiv.2602.19896","type":"dois","attributes":{"doi":"10.48550/arxiv.2602.19896","identifiers":[{"identifier":"2602.19896","identifierType":"arXiv"}],"creators":[{"nameType":"Personal","givenName":"Bo","familyName":"Jin","name":"Jin, Bo","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Shichao","familyName":"Zhao","name":"Zhao, Shichao","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Jin","familyName":"Lyu","name":"Lyu, Jin","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Bin","familyName":"Zhang","name":"Zhang, Bin","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Tao","familyName":"Yu","name":"Yu, Tao","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Liang","familyName":"An","name":"An, Liang","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Yebin","familyName":"Liu","name":"Liu, Yebin","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Meili","familyName":"Wang","name":"Wang, Meili","affiliation":[],"nameIdentifiers":[]}],"titles":[{"title":"Monocular Mesh Recovery and Body Measurement of Female Saanen Goats"}],"publisher":"arXiv","container":{},"publicationYear":2026,"subjects":[{"subject":"Computer Vision and Pattern Recognition (cs.CV)","lang":"en","subjectScheme":"arXiv"},{"subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"},{"schemeUri":"http://www.oecd.org/science/inno/38235147.pdf","subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"}],"contributors":[],"dates":[{"date":"2026-02-23T14:37:07Z","dateType":"Submitted","dateInformation":"v1"},{"date":"2026-02-24T02:31:03Z","dateType":"Updated","dateInformation":"v1"},{"date":"2026-02","dateType":"Available","dateInformation":"v1"},{"date":"2026","dateType":"Issued"}],"language":null,"types":{"schemaOrg":"CreativeWork","resourceTypeGeneral":"Preprint","citeproc":"article","bibtex":"misc","ris":"GEN","resourceType":"Article"},"relatedIdentifiers":[],"relatedItems":[],"sizes":[],"formats":[],"version":"1","rightsList":[{"rightsUri":"http://arxiv.org/licenses/nonexclusive-distrib/1.0/","rights":"arXiv.org perpetual, non-exclusive license"}],"descriptions":[{"descriptionType":"Abstract","description":"The lactation performance of Saanen dairy goats, renowned for their high milk yield, is intrinsically linked to their body size, making accurate 3D body measurement essential for assessing milk production potential, yet existing reconstruction methods lack goat-specific authentic 3D data. To address this limitation, we establish the FemaleSaanenGoat dataset containing synchronized eight-view RGBD videos of 55 female Saanen goats (6-18 months). Using multi-view DynamicFusion, we fuse noisy, non-rigid point cloud sequences into high-fidelity 3D scans, overcoming challenges from irregular surfaces and rapid movement. Based on these scans, we develop SaanenGoat, a parametric 3D shape model specifically designed for female Saanen goats. This model features a refined template with 41 skeletal joints and enhanced udder representation, registered with our scan data. A comprehensive shape space constructed from 48 goats enables precise representation of diverse individual variations. With the help of SaanenGoat model, we get high-precision 3D reconstruction from single-view RGBD input, and achieve automated measurement of six critical body dimensions: body length, height, chest width, chest girth, hip width, and hip height. Experimental results demonstrate the superior accuracy of our method in both 3D reconstruction and body measurement, presenting a novel paradigm for large-scale 3D vision applications in precision livestock farming."},{"descriptionType":"Other","description":"Accepted to AAAI2026"}],"geoLocations":[],"fundingReferences":[],"url":"https://arxiv.org/abs/2602.19896","contentUrl":null,"metadataVersion":0,"schemaVersion":"http://datacite.org/schema/kernel-4","source":"mds","isActive":true,"state":"findable","reason":null,"viewCount":0,"downloadCount":0,"referenceCount":0,"citationCount":0,"partCount":0,"partOfCount":0,"versionCount":0,"versionOfCount":0,"created":"2026-02-25T15:19:31Z","registered":"2026-02-25T15:19:31Z","published":null,"updated":"2026-02-25T15:19:31Z"},"relationships":{"client":{"data":{"id":"arxiv.content","type":"clients"}}}},{"id":"10.48550/arxiv.2602.19895","type":"dois","attributes":{"doi":"10.48550/arxiv.2602.19895","identifiers":[{"identifier":"2602.19895","identifierType":"arXiv"}],"creators":[{"nameType":"Personal","givenName":"Zhongwei","familyName":"Wan","name":"Wan, Zhongwei","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Yun","familyName":"Shen","name":"Shen, Yun","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Zhihao","familyName":"Dou","name":"Dou, Zhihao","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Donghao","familyName":"Zhou","name":"Zhou, Donghao","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Yu","familyName":"Zhang","name":"Zhang, Yu","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Xin","familyName":"Wang","name":"Wang, Xin","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Hui","familyName":"Shen","name":"Shen, Hui","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Jing","familyName":"Xiong","name":"Xiong, Jing","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Chaofan","familyName":"Tao","name":"Tao, Chaofan","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Zixuan","familyName":"Zhong","name":"Zhong, Zixuan","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Peizhou","familyName":"Huang","name":"Huang, Peizhou","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Mi","familyName":"Zhang","name":"Zhang, Mi","affiliation":[],"nameIdentifiers":[]}],"titles":[{"title":"DSDR: Dual-Scale Diversity Regularization for Exploration in LLM Reasoning"}],"publisher":"arXiv","container":{},"publicationYear":2026,"subjects":[{"subject":"Machine Learning (cs.LG)","lang":"en","subjectScheme":"arXiv"},{"subject":"Computation and Language (cs.CL)","lang":"en","subjectScheme":"arXiv"},{"subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"},{"schemeUri":"http://www.oecd.org/science/inno/38235147.pdf","subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"}],"contributors":[],"dates":[{"date":"2026-02-23T14:37:01Z","dateType":"Submitted","dateInformation":"v1"},{"date":"2026-02-24T02:31:02Z","dateType":"Updated","dateInformation":"v1"},{"date":"2026-02","dateType":"Available","dateInformation":"v1"},{"date":"2026","dateType":"Issued"}],"language":null,"types":{"schemaOrg":"CreativeWork","resourceTypeGeneral":"Preprint","citeproc":"article","bibtex":"misc","ris":"GEN","resourceType":"Article"},"relatedIdentifiers":[],"relatedItems":[],"sizes":[],"formats":[],"version":"1","rightsList":[{"rightsUri":"http://arxiv.org/licenses/nonexclusive-distrib/1.0/","rights":"arXiv.org perpetual, non-exclusive license"}],"descriptions":[{"descriptionType":"Abstract","description":"Reinforcement learning with verifiers (RLVR) is a central paradigm for improving large language model (LLM) reasoning, yet existing methods often suffer from limited exploration. Policies tend to collapse onto a few reasoning patterns and prematurely stop deep exploration, while conventional entropy regularization introduces only local stochasticity and fails to induce meaningful path-level diversity, leading to weak and unstable learning signals in group-based policy optimization. We propose DSDR, a Dual-Scale Diversity Regularization reinforcement learning framework that decomposes diversity in LLM reasoning into global and coupling components. Globally, DSDR promotes diversity among correct reasoning trajectories to explore distinct solution modes. Locally, it applies a length-invariant, token-level entropy regularization restricted to correct trajectories, preventing entropy collapse within each mode while preserving correctness. The two scales are coupled through a global-to-local allocation mechanism that emphasizes local regularization for more distinctive correct trajectories. We provide theoretical support showing that DSDR preserves optimal correctness under bounded regularization, sustains informative learning signals in group-based optimization, and yields a principled global-to-local coupling rule. Experiments on multiple reasoning benchmarks demonstrate consistent improvements in accuracy and pass@k, highlighting the importance of dual-scale diversity for deep exploration in RLVR. Code is available at https://github.com/SUSTechBruce/DSDR."}],"geoLocations":[],"fundingReferences":[],"url":"https://arxiv.org/abs/2602.19895","contentUrl":null,"metadataVersion":0,"schemaVersion":"http://datacite.org/schema/kernel-4","source":"mds","isActive":true,"state":"findable","reason":null,"viewCount":0,"downloadCount":0,"referenceCount":0,"citationCount":0,"partCount":0,"partOfCount":0,"versionCount":0,"versionOfCount":0,"created":"2026-02-25T15:19:28Z","registered":"2026-02-25T15:19:29Z","published":null,"updated":"2026-02-25T15:19:29Z"},"relationships":{"client":{"data":{"id":"arxiv.content","type":"clients"}}}},{"id":"10.48550/arxiv.2602.19893","type":"dois","attributes":{"doi":"10.48550/arxiv.2602.19893","identifiers":[{"identifier":"2602.19893","identifierType":"arXiv"}],"creators":[{"nameType":"Personal","givenName":"Soumen","familyName":"Pachal","name":"Pachal, Soumen","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Prashanth L.","familyName":"A.","name":"A., Prashanth L.","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Shalabh","familyName":"Bhatnagar","name":"Bhatnagar, Shalabh","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Avinash","familyName":"Achar","name":"Achar, Avinash","affiliation":[],"nameIdentifiers":[]}],"titles":[{"title":"Generalized Random Direction Newton Algorithms for Stochastic Optimization"}],"publisher":"arXiv","container":{},"publicationYear":2026,"subjects":[{"subject":"Machine Learning (cs.LG)","lang":"en","subjectScheme":"arXiv"},{"subject":"Machine Learning (stat.ML)","lang":"en","subjectScheme":"arXiv"},{"subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"},{"schemeUri":"http://www.oecd.org/science/inno/38235147.pdf","subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"}],"contributors":[],"dates":[{"date":"2026-02-23T14:33:39Z","dateType":"Submitted","dateInformation":"v1"},{"date":"2026-02-24T02:30:50Z","dateType":"Updated","dateInformation":"v1"},{"date":"2026-02","dateType":"Available","dateInformation":"v1"},{"date":"2026","dateType":"Issued"}],"language":null,"types":{"schemaOrg":"CreativeWork","resourceTypeGeneral":"Preprint","citeproc":"article","bibtex":"misc","ris":"GEN","resourceType":"Article"},"relatedIdentifiers":[],"relatedItems":[],"sizes":[],"formats":[],"version":"1","rightsList":[{"rightsIdentifierScheme":"SPDX","rightsUri":"https://creativecommons.org/licenses/by/4.0/legalcode","schemeUri":"https://spdx.org/licenses/","rights":"Creative Commons Attribution 4.0 International","rightsIdentifier":"cc-by-4.0"}],"descriptions":[{"descriptionType":"Abstract","description":"We present a family of generalized Hessian estimators of the objective using random direction stochastic approximation (RDSA) by utilizing only noisy function measurements. The form of each estimator and the order of the bias depend on the number of function measurements. In particular, we demonstrate that estimators with more function measurements exhibit lower-order estimation bias. We show the asymptotic unbiasedness of the estimators. We also perform asymptotic and non-asymptotic convergence analyses for stochastic Newton methods that incorporate our generalized Hessian estimators. Finally, we perform numerical experiments to validate our theoretical findings."}],"geoLocations":[],"fundingReferences":[],"url":"https://arxiv.org/abs/2602.19893","contentUrl":null,"metadataVersion":0,"schemaVersion":"http://datacite.org/schema/kernel-4","source":"mds","isActive":true,"state":"findable","reason":null,"viewCount":0,"downloadCount":0,"referenceCount":0,"citationCount":0,"partCount":0,"partOfCount":0,"versionCount":0,"versionOfCount":0,"created":"2026-02-25T15:19:23Z","registered":"2026-02-25T15:19:24Z","published":null,"updated":"2026-02-25T15:19:24Z"},"relationships":{"client":{"data":{"id":"arxiv.content","type":"clients"}}}},{"id":"10.48550/arxiv.2602.19892","type":"dois","attributes":{"doi":"10.48550/arxiv.2602.19892","identifiers":[{"identifier":"2602.19892","identifierType":"arXiv"}],"creators":[{"nameType":"Personal","givenName":"Christopher","familyName":"Cameron","name":"Cameron, Christopher","affiliation":[],"nameIdentifiers":[]}],"titles":[{"title":"Long-Run Sovereign Debt Composition: An Analytic Ergodic Framework with Explicit Maturity Structure"}],"publisher":"arXiv","container":{},"publicationYear":2026,"subjects":[{"subject":"Mathematical Finance (q-fin.MF)","lang":"en","subjectScheme":"arXiv"},{"subject":"FOS: Economics and business","subjectScheme":"Fields of Science and Technology (FOS)"},{"schemeUri":"http://www.oecd.org/science/inno/38235147.pdf","subject":"FOS: Economics and business","subjectScheme":"Fields of Science and Technology (FOS)"}],"contributors":[],"dates":[{"date":"2026-02-23T14:33:35Z","dateType":"Submitted","dateInformation":"v1"},{"date":"2026-02-24T02:30:46Z","dateType":"Updated","dateInformation":"v1"},{"date":"2026-02","dateType":"Available","dateInformation":"v1"},{"date":"2026","dateType":"Issued"}],"language":null,"types":{"schemaOrg":"CreativeWork","resourceTypeGeneral":"Preprint","citeproc":"article","bibtex":"misc","ris":"GEN","resourceType":"Article"},"relatedIdentifiers":[],"relatedItems":[],"sizes":[],"formats":[],"version":"1","rightsList":[{"rightsIdentifierScheme":"SPDX","rightsUri":"https://creativecommons.org/licenses/by/4.0/legalcode","schemeUri":"https://spdx.org/licenses/","rights":"Creative Commons Attribution 4.0 International","rightsIdentifier":"cc-by-4.0"}],"descriptions":[{"descriptionType":"Abstract","description":"This paper describes a discrete-time model of regularly-issued sovereign debt dynamics under a deficit-driven nominal debt growth regime that explicitly accounts for granular maturity. New issuance follows fixed allocations across a finite maturity ladder, and the government budget constraint determines total borrowing endogenously. In the deterministic baseline, we identify a sustainability condition for convergence to a steady-state and derive closed-form steady portfolio shares, as well as key metrics for steady cost and risk (proxied as one-period rollover ratio). Extending the model to a stochastic recurrence equation (SRE) driven by interest rates and (normalized) deficits that are stationary and mean-reverting, and using a future-cashflow state representation of debt, we identify an analogous condition for ergodic convergence to a unique invariant distribution. This implies that metrics calculated by Monte Carlo debt simulations driven by factors with these properties will recover the ergodic means of the underlying system, independently of initial conditions, provided the simulation horizon is sufficiently long. Analytical formulae for expectations of certain key metrics under this invariant distribution are derived, and agreement with simulation is observed. We find that the introduction of stochastic interest-rate/deficit correlation into the framework leads to intuitive correction terms to their deterministic-baseline counterparts."}],"geoLocations":[],"fundingReferences":[],"url":"https://arxiv.org/abs/2602.19892","contentUrl":null,"metadataVersion":0,"schemaVersion":"http://datacite.org/schema/kernel-4","source":"mds","isActive":true,"state":"findable","reason":null,"viewCount":0,"downloadCount":0,"referenceCount":0,"citationCount":0,"partCount":0,"partOfCount":0,"versionCount":0,"versionOfCount":0,"created":"2026-02-25T15:19:21Z","registered":"2026-02-25T15:19:21Z","published":null,"updated":"2026-02-25T15:19:21Z"},"relationships":{"client":{"data":{"id":"arxiv.content","type":"clients"}}}},{"id":"10.48550/arxiv.2602.19891","type":"dois","attributes":{"doi":"10.48550/arxiv.2602.19891","identifiers":[{"identifier":"2602.19891","identifierType":"arXiv"}],"creators":[{"nameType":"Personal","givenName":"Wen-Liang","familyName":"Lin","name":"Lin, Wen-Liang","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Yun-Chien","familyName":"Cheng","name":"Cheng, Yun-Chien","affiliation":[],"nameIdentifiers":[]}],"titles":[{"title":"Using Unsupervised Domain Adaptation Semantic Segmentation for Pulmonary Embolism Detection in Computed Tomography Pulmonary Angiogram (CTPA) Images"}],"publisher":"arXiv","container":{},"publicationYear":2026,"subjects":[{"subject":"Image and Video Processing (eess.IV)","lang":"en","subjectScheme":"arXiv"},{"subject":"Computer Vision and Pattern Recognition (cs.CV)","lang":"en","subjectScheme":"arXiv"},{"subject":"FOS: Electrical engineering, electronic engineering, information engineering","subjectScheme":"Fields of Science and Technology (FOS)"},{"schemeUri":"http://www.oecd.org/science/inno/38235147.pdf","subject":"FOS: Electrical engineering, electronic engineering, information engineering","subjectScheme":"Fields of Science and Technology (FOS)"},{"subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"},{"schemeUri":"http://www.oecd.org/science/inno/38235147.pdf","subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"}],"contributors":[],"dates":[{"date":"2026-02-23T14:33:24Z","dateType":"Submitted","dateInformation":"v1"},{"date":"2026-02-24T02:30:45Z","dateType":"Updated","dateInformation":"v1"},{"date":"2026-02","dateType":"Available","dateInformation":"v1"},{"date":"2026","dateType":"Issued"}],"language":null,"types":{"schemaOrg":"CreativeWork","resourceTypeGeneral":"Preprint","citeproc":"article","bibtex":"misc","ris":"GEN","resourceType":"Article"},"relatedIdentifiers":[],"relatedItems":[],"sizes":[],"formats":[],"version":"1","rightsList":[{"rightsUri":"http://arxiv.org/licenses/nonexclusive-distrib/1.0/","rights":"arXiv.org perpetual, non-exclusive license"}],"descriptions":[{"descriptionType":"Abstract","description":"While deep learning has demonstrated considerable promise in computer-aided diagnosis for pulmonary embolism (PE), practical deployment in Computed Tomography Pulmonary Angiography (CTPA) is often hindered by \"domain shift\" and the prohibitive cost of expert annotations. To address these challenges, an unsupervised domain adaptation (UDA) framework is proposed, utilizing a Transformer backbone and a Mean-Teacher architecture for cross-center semantic segmentation. The primary focus is placed on enhancing pseudo-label reliability by learning deep structural information within the feature space. Specifically, three modules are integrated and designed for this task: (1) a Prototype Alignment (PA) mechanism to reduce category-level distribution discrepancies; (2) Global and Local Contrastive Learning (GLCL) to capture both pixel-level topological relationships and global semantic representations; and (3) an Attention-based Auxiliary Local Prediction (AALP) module designed to reinforce sensitivity to small PE lesions by automatically extracting high-information slices from Transformer attention maps. Experimental validation conducted on cross-center datasets (FUMPE and CAD-PE) demonstrates significant performance gains. In the FUMPE -\u0026gt; CAD-PE task, the IoU increased from 0.1152 to 0.4153, while the CAD-PE -\u0026gt; FUMPE task saw an improvement from 0.1705 to 0.4302. Furthermore, the proposed method achieved a 69.9% Dice score in the CT -\u0026gt; MRI cross-modality task on the MMWHS dataset without utilizing any target-domain labels for model selection, confirming its robustness and generalizability for diverse clinical environments."}],"geoLocations":[],"fundingReferences":[],"url":"https://arxiv.org/abs/2602.19891","contentUrl":null,"metadataVersion":0,"schemaVersion":"http://datacite.org/schema/kernel-4","source":"mds","isActive":true,"state":"findable","reason":null,"viewCount":0,"downloadCount":0,"referenceCount":0,"citationCount":0,"partCount":0,"partOfCount":0,"versionCount":0,"versionOfCount":0,"created":"2026-02-25T15:19:18Z","registered":"2026-02-25T15:19:19Z","published":null,"updated":"2026-02-25T15:19:19Z"},"relationships":{"client":{"data":{"id":"arxiv.content","type":"clients"}}}},{"id":"10.48550/arxiv.2602.19890","type":"dois","attributes":{"doi":"10.48550/arxiv.2602.19890","identifiers":[{"identifier":"2602.19890","identifierType":"arXiv"}],"creators":[{"nameType":"Personal","givenName":"Y.","familyName":"Degerli","name":"Degerli, Y.","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"R.","familyName":"Aleksan","name":"Aleksan, R.","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"R.","familyName":"Casanova","name":"Casanova, R.","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Y.","familyName":"Gan","name":"Gan, Y.","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"S.","familyName":"Grinstein","name":"Grinstein, S.","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"F.","familyName":"Guilloux","name":"Guilloux, F.","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"A.","familyName":"Hanlon","name":"Hanlon, A.","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"T.","familyName":"Hemperek","name":"Hemperek, T.","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"J. P.","familyName":"Meyer","name":"Meyer, J. P.","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"J.","familyName":"Pinol","name":"Pinol, J.","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"P.","familyName":"Schwemling","name":"Schwemling, P.","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"E.","familyName":"Vilella","name":"Vilella, E.","affiliation":[],"nameIdentifiers":[]}],"titles":[{"title":"Test-beam results from MiniCACTUS-v2: A depleted monolithic CMOS timing sensor prototype"}],"publisher":"arXiv","container":{},"publicationYear":2026,"subjects":[{"subject":"Instrumentation and Detectors (physics.ins-det)","lang":"en","subjectScheme":"arXiv"},{"subject":"High Energy Physics - Experiment (hep-ex)","lang":"en","subjectScheme":"arXiv"},{"subject":"FOS: Physical sciences","subjectScheme":"Fields of Science and Technology (FOS)"},{"schemeUri":"http://www.oecd.org/science/inno/38235147.pdf","subject":"FOS: Physical sciences","subjectScheme":"Fields of Science and Technology (FOS)"}],"contributors":[],"dates":[{"date":"2026-02-23T14:32:39Z","dateType":"Submitted","dateInformation":"v1"},{"date":"2026-02-24T02:30:44Z","dateType":"Updated","dateInformation":"v1"},{"date":"2026-02","dateType":"Available","dateInformation":"v1"},{"date":"2026","dateType":"Issued"}],"language":null,"types":{"schemaOrg":"CreativeWork","resourceTypeGeneral":"Preprint","citeproc":"article","bibtex":"misc","ris":"GEN","resourceType":"Article"},"relatedIdentifiers":[],"relatedItems":[],"sizes":[],"formats":[],"version":"1","rightsList":[{"rightsUri":"http://arxiv.org/licenses/nonexclusive-distrib/1.0/","rights":"arXiv.org perpetual, non-exclusive license"}],"descriptions":[{"descriptionType":"Abstract","description":"MiniCACTUS-v2 is a monolithic sensor prototype designed in LF 150 nm CMOS process for time tagging of individual Minimum Ionizing Particles with an accuracy better than 100 ps. The sensing element is a deep n-well/p-substrate diode without internal amplification. To minimize detector capacitances, the analog front-ends and the discriminators for each pixel have been implemented outside the pixel, at the column level. After fabrication, the sensors have been thinned to 150 microns, 175 microns and 200 microns and then post-processed for backside biasing. The breakdown voltages measured on these sensors are higher than 500 V, ensuring the complete depletion of the charge collection volume. In this paper, we will focus on the time resolution measurements from a test-beam campaign conducted in July 2025 at SPS-CERN. During this period, several pixels from the 3 different sensor thicknesses have been tested at different bias voltages. The best time resolution measured is 48.88 ps on a 0.5 mm x 0.5 mm pixel from a 175 microns-thick sensor at 500 V, with nominal settings for the on-chip analog front-end and discriminator."},{"descriptionType":"Other","description":"8 pages, 7 figures"}],"geoLocations":[],"fundingReferences":[],"url":"https://arxiv.org/abs/2602.19890","contentUrl":null,"metadataVersion":0,"schemaVersion":"http://datacite.org/schema/kernel-4","source":"mds","isActive":true,"state":"findable","reason":null,"viewCount":0,"downloadCount":0,"referenceCount":0,"citationCount":0,"partCount":0,"partOfCount":0,"versionCount":0,"versionOfCount":0,"created":"2026-02-25T15:19:16Z","registered":"2026-02-25T15:19:16Z","published":null,"updated":"2026-02-25T15:19:16Z"},"relationships":{"client":{"data":{"id":"arxiv.content","type":"clients"}}}},{"id":"10.48550/arxiv.2602.19886","type":"dois","attributes":{"doi":"10.48550/arxiv.2602.19886","identifiers":[{"identifier":"2602.19886","identifierType":"arXiv"}],"creators":[{"nameType":"Personal","givenName":"Hui","familyName":"Huang","name":"Huang, Hui","affiliation":[],"nameIdentifiers":[]}],"titles":[{"title":"Order Bounds for Hypergeometric and q-Hypergeometric Creative Telescoping"}],"publisher":"arXiv","container":{},"publicationYear":2026,"subjects":[{"subject":"Symbolic Computation (cs.SC)","lang":"en","subjectScheme":"arXiv"},{"subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"},{"schemeUri":"http://www.oecd.org/science/inno/38235147.pdf","subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"}],"contributors":[],"dates":[{"date":"2026-02-23T14:31:44Z","dateType":"Submitted","dateInformation":"v1"},{"date":"2026-02-24T02:30:36Z","dateType":"Updated","dateInformation":"v1"},{"date":"2026-02","dateType":"Available","dateInformation":"v1"},{"date":"2026","dateType":"Issued"}],"language":null,"types":{"schemaOrg":"CreativeWork","resourceTypeGeneral":"Preprint","citeproc":"article","bibtex":"misc","ris":"GEN","resourceType":"Article"},"relatedIdentifiers":[],"relatedItems":[],"sizes":[],"formats":[],"version":"1","rightsList":[{"rightsUri":"http://arxiv.org/licenses/nonexclusive-distrib/1.0/","rights":"arXiv.org perpetual, non-exclusive license"}],"descriptions":[{"descriptionType":"Abstract","description":"Leveraging a general framework adapted from symbolic integration, a unified reduction-based algorithm for computing telescopers of minimal order for hypergeometric and q-hypergeometric terms has been recently developed. In this paper, we conduct a deeper exploration and put forth a new argument for the termination of the algorithm. This not only provides an independent proof of existence of telescopers, but also allows us to derive unified upper and lower bounds on the order of telescopers for hypergeometric terms and their q-analogues. Compared with known bounds in the literature, our bounds, in the hypergeometric case, are exactly the same as the tight ones obtained in 2016; while in the q-hypergeometric case, no lower bounds were known before, and our upper bound is sometimes better and never worse than the known one."}],"geoLocations":[],"fundingReferences":[],"url":"https://arxiv.org/abs/2602.19886","contentUrl":null,"metadataVersion":0,"schemaVersion":"http://datacite.org/schema/kernel-4","source":"mds","isActive":true,"state":"findable","reason":null,"viewCount":0,"downloadCount":0,"referenceCount":0,"citationCount":0,"partCount":0,"partOfCount":0,"versionCount":0,"versionOfCount":0,"created":"2026-02-25T15:19:06Z","registered":"2026-02-25T15:19:07Z","published":null,"updated":"2026-02-25T15:19:07Z"},"relationships":{"client":{"data":{"id":"arxiv.content","type":"clients"}}}},{"id":"10.48550/arxiv.2602.19884","type":"dois","attributes":{"doi":"10.48550/arxiv.2602.19884","identifiers":[{"identifier":"2602.19884","identifierType":"arXiv"}],"creators":[{"nameType":"Personal","givenName":"Harry","familyName":"Fitchett","name":"Fitchett, Harry","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Jasmine","familyName":"Ritchie","name":"Ritchie, Jasmine","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Charles","familyName":"Fox","name":"Fox, Charles","affiliation":[],"nameIdentifiers":[]}],"titles":[{"title":"Extending CPU-less parallel execution of lambda calculus in digital logic with lists and arithmetic"}],"publisher":"arXiv","container":{},"publicationYear":2026,"subjects":[{"subject":"Hardware Architecture (cs.AR)","lang":"en","subjectScheme":"arXiv"},{"subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"},{"schemeUri":"http://www.oecd.org/science/inno/38235147.pdf","subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"}],"contributors":[],"dates":[{"date":"2026-02-23T14:29:06Z","dateType":"Submitted","dateInformation":"v1"},{"date":"2026-02-24T02:30:33Z","dateType":"Updated","dateInformation":"v1"},{"date":"2026-02","dateType":"Available","dateInformation":"v1"},{"date":"2026","dateType":"Issued"}],"language":null,"types":{"schemaOrg":"CreativeWork","resourceTypeGeneral":"Preprint","citeproc":"article","bibtex":"misc","ris":"GEN","resourceType":"Article"},"relatedIdentifiers":[],"relatedItems":[],"sizes":[],"formats":[],"version":"1","rightsList":[{"rightsUri":"http://arxiv.org/licenses/nonexclusive-distrib/1.0/","rights":"arXiv.org perpetual, non-exclusive license"}],"descriptions":[{"descriptionType":"Abstract","description":"Computer architecture is searching for new ways to make use of increasingly available digital logic without the serial bottlenecks of CPU-based design. Recent work has demonstrated a fully CPU-less approach to executing functional programs, by exploiting their inherent parallelisability to compile them directly into parallel digital logic. This work uses lambda-calculus as a hyper simple functional language to prove the concept, but is impractical for real-world programming due to the well-known inefficiencies of pure lambda$-calculus. It is common in language design to extend basic lambda-calculus with additional primitives to short-cut common tasks such as arithmetic and lists. In this work, we build upon our previous research to examine how such extensions may be applied to CPU-less functional execution in digital logic, with the objective of advancing the approach toward practical implementation. We present a set of structures and algorithms for representing new primitives, describe a systematic process for selecting, implementing, and evaluating them, and demonstrate substantial reductions in execution time and node usage. These improvements are implemented in an open-source system, which is shown to correctly evaluate a range of representative lambda expressions."}],"geoLocations":[],"fundingReferences":[],"url":"https://arxiv.org/abs/2602.19884","contentUrl":null,"metadataVersion":0,"schemaVersion":"http://datacite.org/schema/kernel-4","source":"mds","isActive":true,"state":"findable","reason":null,"viewCount":0,"downloadCount":0,"referenceCount":0,"citationCount":0,"partCount":0,"partOfCount":0,"versionCount":0,"versionOfCount":0,"created":"2026-02-25T15:19:01Z","registered":"2026-02-25T15:19:02Z","published":null,"updated":"2026-02-25T15:19:02Z"},"relationships":{"client":{"data":{"id":"arxiv.content","type":"clients"}}}},{"id":"10.48550/arxiv.2602.19883","type":"dois","attributes":{"doi":"10.48550/arxiv.2602.19883","identifiers":[{"identifier":"2602.19883","identifierType":"arXiv"}],"creators":[{"nameType":"Personal","givenName":"Daham","familyName":"Mustafa","name":"Mustafa, Daham","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Diego","familyName":"Collarana","name":"Collarana, Diego","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Yixin","familyName":"Peng","name":"Peng, Yixin","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Rafiqul","familyName":"Haque","name":"Haque, Rafiqul","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Christoph","familyName":"Lange-Bever","name":"Lange-Bever, Christoph","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Christoph","familyName":"Quix","name":"Quix, Christoph","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Stephan","familyName":"Decker","name":"Decker, Stephan","affiliation":[],"nameIdentifiers":[]}],"titles":[{"title":"Denotational Semantics for ODRL: Knowledge-Based Constraint Conflict Detection"}],"publisher":"arXiv","container":{},"publicationYear":2026,"subjects":[{"subject":"Computation and Language (cs.CL)","lang":"en","subjectScheme":"arXiv"},{"subject":"Logic in Computer Science (cs.LO)","lang":"en","subjectScheme":"arXiv"},{"subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"},{"schemeUri":"http://www.oecd.org/science/inno/38235147.pdf","subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"},{"subject":"F.4.1; I.2.4; D.2.4","lang":"en","subjectScheme":"ACM"}],"contributors":[],"dates":[{"date":"2026-02-23T14:28:13Z","dateType":"Submitted","dateInformation":"v1"},{"date":"2026-02-24T02:30:32Z","dateType":"Updated","dateInformation":"v1"},{"date":"2026-02","dateType":"Available","dateInformation":"v1"},{"date":"2026","dateType":"Issued"}],"language":null,"types":{"schemaOrg":"CreativeWork","resourceTypeGeneral":"Preprint","citeproc":"article","bibtex":"misc","ris":"GEN","resourceType":"Article"},"relatedIdentifiers":[],"relatedItems":[],"sizes":[],"formats":[],"version":"1","rightsList":[{"rightsIdentifierScheme":"SPDX","rightsUri":"https://creativecommons.org/licenses/by/4.0/legalcode","schemeUri":"https://spdx.org/licenses/","rights":"Creative Commons Attribution 4.0 International","rightsIdentifier":"cc-by-4.0"}],"descriptions":[{"descriptionType":"Abstract","description":"ODRL's six set-based operators -- isA, isPartOf, hasPart, isAnyOf, isAllOf, isNoneOf -- depend on external domain knowledge that the W3C specification leaves unspecified. Without it, every cross-dataspace policy comparison defaults to Unknown. We present a denotational semantics that maps each ODRL constraint to the set of knowledge-base concepts satisfying it. Conflict detection reduces to denotation intersection under a three-valued verdict -- Conflict, Compatible, or Unknown -- that is sound under incomplete knowledge. The framework covers all three ODRL composition modes (and, or, xone) and all three semantic domains arising in practice: taxonomic (class subsumption), mereological (part-whole containment), and nominal (identity). For cross-dataspace interoperability, we define order-preserving alignments between knowledge bases and prove two guarantees: conflicts are preserved across different KB standards, and unmapped concepts degrade gracefully to Unknown -- never to false conflicts. A runtime soundness theorem ensures that design-time verdicts hold for all execution contexts. The encoding stays within the decidable EPR fragment of first-order logic. We validate it with 154 benchmarks across six knowledge base families (GeoNames, ISO 3166, W3C DPV, a GDPR-derived taxonomy, BCP 47, and ISO 639-3) and four structural KBs targeting adversarial edge cases. Both the Vampire theorem prover and the Z3 SMT solver agree on all 154 verdicts. A key finding is that exclusive composition (xone) requires strictly stronger KB axioms than conjunction or disjunction: open-world semantics blocks exclusivity even when positive evidence appears to satisfy exactly one branch."},{"descriptionType":"Other","description":"17 pages, 6 tables. Working draft. Supplementary material (154 TPTP/SMT-LIB benchmarks, Isabelle/HOL theory file) will be made available at https://github.com/Daham-Mustaf/odrl-benchmark upon publication"}],"geoLocations":[],"fundingReferences":[],"url":"https://arxiv.org/abs/2602.19883","contentUrl":null,"metadataVersion":0,"schemaVersion":"http://datacite.org/schema/kernel-4","source":"mds","isActive":true,"state":"findable","reason":null,"viewCount":0,"downloadCount":0,"referenceCount":0,"citationCount":0,"partCount":0,"partOfCount":0,"versionCount":0,"versionOfCount":0,"created":"2026-02-25T15:18:58Z","registered":"2026-02-25T15:18:59Z","published":null,"updated":"2026-02-25T15:18:59Z"},"relationships":{"client":{"data":{"id":"arxiv.content","type":"clients"}}}},{"id":"10.48550/arxiv.2602.19882","type":"dois","attributes":{"doi":"10.48550/arxiv.2602.19882","identifiers":[{"identifier":"2602.19882","identifierType":"arXiv"}],"creators":[{"nameType":"Personal","givenName":"Cai Heng","familyName":"Li","name":"Li, Cai Heng","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Fu-Gang","familyName":"Yin","name":"Yin, Fu-Gang","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Jin-Xin","familyName":"Zhou","name":"Zhou, Jin-Xin","affiliation":[],"nameIdentifiers":[]}],"titles":[{"title":"The finite $k$-set homogeneous graphs"}],"publisher":"arXiv","container":{},"publicationYear":2026,"subjects":[{"subject":"Group Theory (math.GR)","lang":"en","subjectScheme":"arXiv"},{"subject":"FOS: Mathematics","subjectScheme":"Fields of Science and Technology (FOS)"},{"schemeUri":"http://www.oecd.org/science/inno/38235147.pdf","subject":"FOS: Mathematics","subjectScheme":"Fields of Science and Technology (FOS)"},{"subject":"05C25, 20B25","lang":"en","subjectScheme":"MSC"}],"contributors":[],"dates":[{"date":"2026-02-23T14:27:38Z","dateType":"Submitted","dateInformation":"v1"},{"date":"2026-02-24T02:30:27Z","dateType":"Updated","dateInformation":"v1"},{"date":"2026-02","dateType":"Available","dateInformation":"v1"},{"date":"2026","dateType":"Issued"}],"language":null,"types":{"schemaOrg":"CreativeWork","resourceTypeGeneral":"Preprint","citeproc":"article","bibtex":"misc","ris":"GEN","resourceType":"Article"},"relatedIdentifiers":[],"relatedItems":[],"sizes":[],"formats":[],"version":"1","rightsList":[{"rightsUri":"http://arxiv.org/licenses/nonexclusive-distrib/1.0/","rights":"arXiv.org perpetual, non-exclusive license"}],"descriptions":[{"descriptionType":"Abstract","description":"A classification is given of finite $k$-set-homogeneous graphs for $k\\geqslant 2$, leading to a striking result that each finite $k$-set-homogeneous graph is $k$-homogeneous. It shows that $3$-set-homogeneous graphs are rare, consisting of the following graphs and their complements: $\\C_5$, $\\K_n\\square\\K_n$, $n\\K_m$, the Schläfli graph of order 27, the Higman-Sims graph, the MaLaughlin graph, {affine polar graphs, and elliptic orthogonal graphs}. As an ingredient for the proof, it is shown that all orbitals in a primitive permutation group of rank $4$ are self-paired, except for $\\PSU_3(3)$ acting on 36 points."}],"geoLocations":[],"fundingReferences":[],"url":"https://arxiv.org/abs/2602.19882","contentUrl":null,"metadataVersion":0,"schemaVersion":"http://datacite.org/schema/kernel-4","source":"mds","isActive":true,"state":"findable","reason":null,"viewCount":0,"downloadCount":0,"referenceCount":0,"citationCount":0,"partCount":0,"partOfCount":0,"versionCount":0,"versionOfCount":0,"created":"2026-02-25T15:18:56Z","registered":"2026-02-25T15:18:57Z","published":null,"updated":"2026-02-25T15:18:57Z"},"relationships":{"client":{"data":{"id":"arxiv.content","type":"clients"}}}},{"id":"10.48550/arxiv.2602.19880","type":"dois","attributes":{"doi":"10.48550/arxiv.2602.19880","identifiers":[{"identifier":"2602.19880","identifierType":"arXiv"}],"creators":[{"nameType":"Personal","givenName":"Ricky","familyName":"Li","name":"Li, Ricky","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Benoit","familyName":"Vicedo","name":"Vicedo, Benoit","affiliation":[],"nameIdentifiers":[]}],"titles":[{"title":"Effective Hamiltonians and Wilson--Polchinski renormalisation"}],"publisher":"arXiv","container":{},"publicationYear":2026,"subjects":[{"subject":"High Energy Physics - Theory (hep-th)","lang":"en","subjectScheme":"arXiv"},{"subject":"Mathematical Physics (math-ph)","lang":"en","subjectScheme":"arXiv"},{"subject":"FOS: Physical sciences","subjectScheme":"Fields of Science and Technology (FOS)"},{"schemeUri":"http://www.oecd.org/science/inno/38235147.pdf","subject":"FOS: Physical sciences","subjectScheme":"Fields of Science and Technology (FOS)"}],"contributors":[],"dates":[{"date":"2026-02-23T14:26:03Z","dateType":"Submitted","dateInformation":"v1"},{"date":"2026-02-24T02:30:23Z","dateType":"Updated","dateInformation":"v1"},{"date":"2026-02","dateType":"Available","dateInformation":"v1"},{"date":"2026","dateType":"Issued"}],"language":null,"types":{"schemaOrg":"CreativeWork","resourceTypeGeneral":"Preprint","citeproc":"article","bibtex":"misc","ris":"GEN","resourceType":"Article"},"relatedIdentifiers":[],"relatedItems":[],"sizes":[],"formats":[],"version":"1","rightsList":[{"rightsUri":"http://arxiv.org/licenses/nonexclusive-distrib/1.0/","rights":"arXiv.org perpetual, non-exclusive license"}],"descriptions":[{"descriptionType":"Abstract","description":"We develop a novel approach to the Wilsonian renormalisation of Hamiltonians for 2-dimensional quantum field theories on the cylinder described in the UV by marginally relevant deformations of conformal field theories. To introduce a Wilsonian short-distance cutoff we make essential use of free field realisations of the full vertex operator algebra in the UV. Our method is intrinsically non-perturbative; we derive a Hamiltonian analogue of Polchinski's equation describing the flows of all couplings.\n As a primary example of our general method, we apply it to the marginal anisotropic deformation of the $\\mathfrak{su}_2$ Wess--Zumino--Witten model at level 1, which is equivalent to the sine-Gordon model on the cylinder. In particular, we reproduce the standard renormalisation group flow of the sine-Gordon model near the Kosterlitz--Thouless point to second order in the couplings, a result usually derived using Lagrangian/path-integral methods."},{"descriptionType":"Other","description":"86 pages, 3 figures"}],"geoLocations":[],"fundingReferences":[],"url":"https://arxiv.org/abs/2602.19880","contentUrl":null,"metadataVersion":0,"schemaVersion":"http://datacite.org/schema/kernel-4","source":"mds","isActive":true,"state":"findable","reason":null,"viewCount":0,"downloadCount":0,"referenceCount":0,"citationCount":0,"partCount":0,"partOfCount":0,"versionCount":0,"versionOfCount":0,"created":"2026-02-25T15:18:51Z","registered":"2026-02-25T15:18:52Z","published":null,"updated":"2026-02-25T15:18:52Z"},"relationships":{"client":{"data":{"id":"arxiv.content","type":"clients"}}}},{"id":"10.48550/arxiv.2602.19879","type":"dois","attributes":{"doi":"10.48550/arxiv.2602.19879","identifiers":[{"identifier":"2602.19879","identifierType":"arXiv"}],"creators":[{"nameType":"Personal","givenName":"Paul","familyName":"Paschmanns","name":"Paschmanns, Paul","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Vera","familyName":"Traub","name":"Traub, Vera","affiliation":[],"nameIdentifiers":[]}],"titles":[{"title":"The Bidirected Cut Relaxation for Steiner Tree: Better Integrality Gap Bounds and the Limits of Moat Growing"}],"publisher":"arXiv","container":{},"publicationYear":2026,"subjects":[{"subject":"Data Structures and Algorithms (cs.DS)","lang":"en","subjectScheme":"arXiv"},{"subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"},{"schemeUri":"http://www.oecd.org/science/inno/38235147.pdf","subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"}],"contributors":[],"dates":[{"date":"2026-02-23T14:25:32Z","dateType":"Submitted","dateInformation":"v1"},{"date":"2026-02-24T02:30:23Z","dateType":"Updated","dateInformation":"v1"},{"date":"2026-02","dateType":"Available","dateInformation":"v1"},{"date":"2026","dateType":"Issued"}],"language":null,"types":{"schemaOrg":"CreativeWork","resourceTypeGeneral":"Preprint","citeproc":"article","bibtex":"misc","ris":"GEN","resourceType":"Article"},"relatedIdentifiers":[],"relatedItems":[],"sizes":[],"formats":[],"version":"1","rightsList":[{"rightsUri":"http://arxiv.org/licenses/nonexclusive-distrib/1.0/","rights":"arXiv.org perpetual, non-exclusive license"}],"descriptions":[{"descriptionType":"Abstract","description":"The Steiner Tree problem asks for the cheapest way of connecting a given subset of the vertices in an undirected graph. One of the most prominent linear programming relaxations for Steiner Tree is the Bidirected Cut Relaxation (BCR). Determining the integrality gap of this relaxation is a long-standing open question. For several decades, the best known upper bound was 2, which is achievable by standard techniques. Only very recently, Byrka, Grandoni, and Traub [FOCS 2024] showed that the integrality gap of BCR is strictly below 2.\n We prove that the integrality gap of BCR is at most 1.898, improving significantly on the previous bound of 1.9988. For the important special case where a terminal minimum spanning tree is an optimal Steiner tree, we show that the integrality gap is at most 12/7, by providing a tight analysis of the dual-growth procedure by Byrka et al. To obtain the general bound of 1.898 on the integrality gap, we generalize their dual growth procedure to a broad class of moat-growing algorithms. Moreover, we prove that no such moat-growing algorithm yields dual solutions certifying an integrality gap below 12/7.\n Finally, we observe an interesting connection to the Hypergraphic Relaxation."}],"geoLocations":[],"fundingReferences":[],"url":"https://arxiv.org/abs/2602.19879","contentUrl":null,"metadataVersion":0,"schemaVersion":"http://datacite.org/schema/kernel-4","source":"mds","isActive":true,"state":"findable","reason":null,"viewCount":0,"downloadCount":0,"referenceCount":0,"citationCount":0,"partCount":0,"partOfCount":0,"versionCount":0,"versionOfCount":0,"created":"2026-02-25T15:18:49Z","registered":"2026-02-25T15:18:49Z","published":null,"updated":"2026-02-25T15:18:49Z"},"relationships":{"client":{"data":{"id":"arxiv.content","type":"clients"}}}},{"id":"10.48550/arxiv.2602.19877","type":"dois","attributes":{"doi":"10.48550/arxiv.2602.19877","identifiers":[{"identifier":"2602.19877","identifierType":"arXiv"}],"creators":[{"nameType":"Personal","givenName":"Umut Utku","familyName":"Erdem","name":"Erdem, Umut Utku","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Lucas","familyName":"Giroto","name":"Giroto, Lucas","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Benedikt","familyName":"Geiger","name":"Geiger, Benedikt","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Taewon","familyName":"Jeong","name":"Jeong, Taewon","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Silvio","familyName":"Mandelli","name":"Mandelli, Silvio","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Christian","familyName":"Karle","name":"Karle, Christian","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Benjamin","familyName":"Nuss","name":"Nuss, Benjamin","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Laurent","familyName":"Schmalen","name":"Schmalen, Laurent","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Thomas","familyName":"Zwick","name":"Zwick, Thomas","affiliation":[],"nameIdentifiers":[]}],"titles":[{"title":"Breaking the CP Limit: Robust Long-Range OFDM Sensing via Interference Cleaning"}],"publisher":"arXiv","container":{},"publicationYear":2026,"subjects":[{"subject":"Signal Processing (eess.SP)","lang":"en","subjectScheme":"arXiv"},{"subject":"FOS: Electrical engineering, electronic engineering, information engineering","subjectScheme":"Fields of Science and Technology (FOS)"},{"schemeUri":"http://www.oecd.org/science/inno/38235147.pdf","subject":"FOS: Electrical engineering, electronic engineering, information engineering","subjectScheme":"Fields of Science and Technology (FOS)"}],"contributors":[],"dates":[{"date":"2026-02-23T14:23:07Z","dateType":"Submitted","dateInformation":"v1"},{"date":"2026-02-24T02:30:21Z","dateType":"Updated","dateInformation":"v1"},{"date":"2026-02","dateType":"Available","dateInformation":"v1"},{"date":"2026","dateType":"Issued"}],"language":null,"types":{"schemaOrg":"CreativeWork","resourceTypeGeneral":"Preprint","citeproc":"article","bibtex":"misc","ris":"GEN","resourceType":"Article"},"relatedIdentifiers":[],"relatedItems":[],"sizes":[],"formats":[],"version":"1","rightsList":[{"rightsIdentifierScheme":"SPDX","rightsUri":"https://creativecommons.org/licenses/by-nc-nd/4.0/legalcode","schemeUri":"https://spdx.org/licenses/","rights":"Creative Commons Attribution Non Commercial No Derivatives 4.0 International","rightsIdentifier":"cc-by-nc-nd-4.0"}],"descriptions":[{"descriptionType":"Abstract","description":"In orthogonal frequency-division multiplexing-based radar and integrated sensing and communication systems, the sensing range is traditionally limited by the round-trip time corresponding to the cyclic prefix duration. Targets whose echoes arrive after this duration induce intersymbol interference (ISI) and associated intercarrier interference (ICI), which significantly degrade detection performance, elevate the interference-noise floor in the radar image, and reduce the useful signal power due to window mismatch. Existing methods face a trade-off between recovering useful signal and suppressing interference, particularly in multi-target scenarios. This paper proposes two frameworks to resolve this dilemma, offering a flexible trade-off between computational cost and target detection performance. First, a signal model is derived, demonstrating that ISI and ICI-oriented interference often dominates thermal noise in high-dynamic-range scenarios. To combat the ISI and ICI-based interference-noise floor increase, joint-interference cancellation with coherent compensation is proposed. This approach is an efficient evolution of the successive-interference cancellation algorithm, utilizing high-precision chirp Z-transform estimation and frequency-domain coherent compensation to recover weak distant targets. For scenarios requiring maximum precision, the full reconstruction-based sliding window scheme is presented, which shifts the receive window to capture optimal signal energy while performing full-signal reconstruction for all detected targets. Numerical results show that both methods outperform state-of-the-art benchmarks."}],"geoLocations":[],"fundingReferences":[],"url":"https://arxiv.org/abs/2602.19877","contentUrl":null,"metadataVersion":0,"schemaVersion":"http://datacite.org/schema/kernel-4","source":"mds","isActive":true,"state":"findable","reason":null,"viewCount":0,"downloadCount":0,"referenceCount":0,"citationCount":0,"partCount":0,"partOfCount":0,"versionCount":0,"versionOfCount":0,"created":"2026-02-25T15:18:44Z","registered":"2026-02-25T15:18:44Z","published":null,"updated":"2026-02-25T15:18:44Z"},"relationships":{"client":{"data":{"id":"arxiv.content","type":"clients"}}}},{"id":"10.48550/arxiv.2602.19876","type":"dois","attributes":{"doi":"10.48550/arxiv.2602.19876","identifiers":[{"identifier":"2602.19876","identifierType":"arXiv"}],"creators":[{"nameType":"Personal","givenName":"Thies","familyName":"Plassmann","name":"Plassmann, Thies","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Leon","familyName":"Schaefer","name":"Schaefer, Leon","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Meny","familyName":"Menashes","name":"Menashes, Meny","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Guillaume","familyName":"Salomon","name":"Salomon, Guillaume","affiliation":[],"nameIdentifiers":[]}],"titles":[{"title":"Rapid state-resolved single-atom imaging of alkaline-earth fermions"}],"publisher":"arXiv","container":{},"publicationYear":2026,"subjects":[{"subject":"Quantum Physics (quant-ph)","lang":"en","subjectScheme":"arXiv"},{"subject":"Quantum Gases (cond-mat.quant-gas)","lang":"en","subjectScheme":"arXiv"},{"subject":"Atomic Physics (physics.atom-ph)","lang":"en","subjectScheme":"arXiv"},{"subject":"FOS: Physical sciences","subjectScheme":"Fields of Science and Technology (FOS)"},{"schemeUri":"http://www.oecd.org/science/inno/38235147.pdf","subject":"FOS: Physical sciences","subjectScheme":"Fields of Science and Technology (FOS)"}],"contributors":[],"dates":[{"date":"2026-02-23T14:21:48Z","dateType":"Submitted","dateInformation":"v1"},{"date":"2026-02-24T02:30:13Z","dateType":"Updated","dateInformation":"v1"},{"date":"2026-02","dateType":"Available","dateInformation":"v1"},{"date":"2026","dateType":"Issued"}],"language":null,"types":{"schemaOrg":"CreativeWork","resourceTypeGeneral":"Preprint","citeproc":"article","bibtex":"misc","ris":"GEN","resourceType":"Article"},"relatedIdentifiers":[],"relatedItems":[],"sizes":[],"formats":[],"version":"1","rightsList":[{"rightsUri":"http://arxiv.org/licenses/nonexclusive-distrib/1.0/","rights":"arXiv.org perpetual, non-exclusive license"}],"descriptions":[{"descriptionType":"Abstract","description":"Local Hilbert spaces with large dimension are of key interest for quantum information with applications in quantum computing and memories, quantum simulations and metrology. Thanks to its weak coupling to external perturbations, the large ground-state nuclear spin manifold of fermionic alkaline-earth atoms is an exciting resource to explore for quantum information. Simultaneous single atom and state-resolved detection however remains an outstanding challenge limiting the development of novel quantum computing and simulation schemes beyond qubits. Here, we report on a new imaging technique enabling the simultaneous detection of up to four quantum states encoded in the nuclear spin manifold of a single fermionic strontium atom within 100 microseconds, with state-resolved detection fidelities ranging from 0.936 to 0.997. This technique is further used to track the highly coherent nuclear spin dynamics after a quench highlighting the potential of this system for quantum information. These results offer fascinating perspectives for quantum science with multi-electron atoms ranging from qudit-based quantum computing to quantum simulations of the SU(N) Fermi-Hubbard model."},{"descriptionType":"Other","description":"9 pages, 5 figures"}],"geoLocations":[],"fundingReferences":[],"url":"https://arxiv.org/abs/2602.19876","contentUrl":null,"metadataVersion":0,"schemaVersion":"http://datacite.org/schema/kernel-4","source":"mds","isActive":true,"state":"findable","reason":null,"viewCount":0,"downloadCount":0,"referenceCount":0,"citationCount":0,"partCount":0,"partOfCount":0,"versionCount":0,"versionOfCount":0,"created":"2026-02-25T15:18:41Z","registered":"2026-02-25T15:18:42Z","published":null,"updated":"2026-02-25T15:18:42Z"},"relationships":{"client":{"data":{"id":"arxiv.content","type":"clients"}}}},{"id":"10.48550/arxiv.2602.19875","type":"dois","attributes":{"doi":"10.48550/arxiv.2602.19875","identifiers":[{"identifier":"2602.19875","identifierType":"arXiv"}],"creators":[{"nameType":"Personal","givenName":"André","familyName":"Freitas","name":"Freitas, André","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Luca","familyName":"Biferale","name":"Biferale, Luca","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Mathieu","familyName":"Desbrun","name":"Desbrun, Mathieu","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Gregory","familyName":"Eyink","name":"Eyink, Gregory","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Alexei A.","familyName":"Mailybaev","name":"Mailybaev, Alexei A.","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Kiwon","familyName":"Um","name":"Um, Kiwon","affiliation":[],"nameIdentifiers":[]}],"titles":[{"title":"On the importance of stochasticity in closures of turbulence"}],"publisher":"arXiv","container":{},"publicationYear":2026,"subjects":[{"subject":"Fluid Dynamics (physics.flu-dyn)","lang":"en","subjectScheme":"arXiv"},{"subject":"Chaotic Dynamics (nlin.CD)","lang":"en","subjectScheme":"arXiv"},{"subject":"Computational Physics (physics.comp-ph)","lang":"en","subjectScheme":"arXiv"},{"subject":"FOS: Physical sciences","subjectScheme":"Fields of Science and Technology (FOS)"},{"schemeUri":"http://www.oecd.org/science/inno/38235147.pdf","subject":"FOS: Physical sciences","subjectScheme":"Fields of Science and Technology (FOS)"}],"contributors":[],"dates":[{"date":"2026-02-23T14:21:17Z","dateType":"Submitted","dateInformation":"v1"},{"date":"2026-02-24T02:30:08Z","dateType":"Updated","dateInformation":"v1"},{"date":"2026-02","dateType":"Available","dateInformation":"v1"},{"date":"2026","dateType":"Issued"}],"language":null,"types":{"schemaOrg":"CreativeWork","resourceTypeGeneral":"Preprint","citeproc":"article","bibtex":"misc","ris":"GEN","resourceType":"Article"},"relatedIdentifiers":[],"relatedItems":[],"sizes":[],"formats":[],"version":"1","rightsList":[{"rightsUri":"http://arxiv.org/licenses/nonexclusive-distrib/1.0/","rights":"arXiv.org perpetual, non-exclusive license"}],"descriptions":[{"descriptionType":"Abstract","description":"Deterministic closures for coarse-grained turbulence models help reproduce mean statistics, but often fail to capture the finite-time growth of uncertainty. Using the framework of shell models as a quantitative multi-scale testbed, we compare fully resolved simulations with large-eddy simulations using either stochastic or deterministic subgrid closures. While in the fully resolved system a single microscopic perturbation is rapidly amplified by strongly chaotic dynamics, truncation produces a strong delay and suppression of variance growth when uncertainty is introduced through initial condition perturbations only. We show that a data-driven Langevin-type stochastic closure restores the correct timing and magnitude of variance growth across scales, demonstrating that sustained stochasticity is essential for predictability in reduced turbulent dynamics."}],"geoLocations":[],"fundingReferences":[],"url":"https://arxiv.org/abs/2602.19875","contentUrl":null,"metadataVersion":0,"schemaVersion":"http://datacite.org/schema/kernel-4","source":"mds","isActive":true,"state":"findable","reason":null,"viewCount":0,"downloadCount":0,"referenceCount":0,"citationCount":0,"partCount":0,"partOfCount":0,"versionCount":0,"versionOfCount":0,"created":"2026-02-25T15:18:39Z","registered":"2026-02-25T15:18:39Z","published":null,"updated":"2026-02-25T15:18:39Z"},"relationships":{"client":{"data":{"id":"arxiv.content","type":"clients"}}}},{"id":"10.48550/arxiv.2602.19874","type":"dois","attributes":{"doi":"10.48550/arxiv.2602.19874","identifiers":[{"identifier":"2602.19874","identifierType":"arXiv"}],"creators":[{"nameType":"Personal","givenName":"Lucas","familyName":"Martini","name":"Martini, Lucas","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Alexander","familyName":"Lappe","name":"Lappe, Alexander","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Anna","familyName":"Bognár","name":"Bognár, Anna","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Rufin","familyName":"Vogels","name":"Vogels, Rufin","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Martin A.","familyName":"Giese","name":"Giese, Martin A.","affiliation":[],"nameIdentifiers":[]}],"titles":[{"title":"BigMaQ: A Big Macaque Motion and Animation Dataset Bridging Image and 3D Pose Representations"}],"publisher":"arXiv","container":{},"publicationYear":2026,"subjects":[{"subject":"Computer Vision and Pattern Recognition (cs.CV)","lang":"en","subjectScheme":"arXiv"},{"subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"},{"schemeUri":"http://www.oecd.org/science/inno/38235147.pdf","subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"}],"contributors":[],"dates":[{"date":"2026-02-23T14:21:15Z","dateType":"Submitted","dateInformation":"v1"},{"date":"2026-02-24T02:30:06Z","dateType":"Updated","dateInformation":"v1"},{"date":"2026-02","dateType":"Available","dateInformation":"v1"},{"date":"2026","dateType":"Issued"}],"language":null,"types":{"schemaOrg":"CreativeWork","resourceTypeGeneral":"Preprint","citeproc":"article","bibtex":"misc","ris":"GEN","resourceType":"Article"},"relatedIdentifiers":[],"relatedItems":[],"sizes":[],"formats":[],"version":"1","rightsList":[{"rightsIdentifierScheme":"SPDX","rightsUri":"https://creativecommons.org/licenses/by/4.0/legalcode","schemeUri":"https://spdx.org/licenses/","rights":"Creative Commons Attribution 4.0 International","rightsIdentifier":"cc-by-4.0"}],"descriptions":[{"descriptionType":"Abstract","description":"The recognition of dynamic and social behavior in animals is fundamental for advancing ethology, ecology, medicine and neuroscience. Recent progress in deep learning has enabled automated behavior recognition from video, yet an accurate reconstruction of the three-dimensional (3D) pose and shape has not been integrated into this process. Especially for non-human primates, mesh-based tracking efforts lag behind those for other species, leaving pose descriptions restricted to sparse keypoints that are unable to fully capture the richness of action dynamics. To address this gap, we introduce the $\\textbf{Big Ma}$ca$\\textbf{Q}$ue 3D Motion and Animation Dataset ($\\texttt{BigMaQ}$), a large-scale dataset comprising more than 750 scenes of interacting rhesus macaques with detailed 3D pose descriptions. Extending previous surface-based animal tracking methods, we construct subject-specific textured avatars by adapting a high-quality macaque template mesh to individual monkeys. This allows us to provide pose descriptions that are more accurate than previous state-of-the-art surface-based animal tracking methods. From the original dataset, we derive BigMaQ500, an action recognition benchmark that links surface-based pose vectors to single frames across multiple individual monkeys. By pairing features extracted from established image and video encoders with and without our pose descriptors, we demonstrate substantial improvements in mean average precision (mAP) when pose information is included. With these contributions, $\\texttt{BigMaQ}$ establishes the first dataset that both integrates dynamic 3D pose-shape representations into the learning task of animal action recognition and provides a rich resource to advance the study of visual appearance, posture, and social interaction in non-human primates. The code and data are publicly available at https://martinivis.github.io/BigMaQ/ ."}],"geoLocations":[],"fundingReferences":[],"url":"https://arxiv.org/abs/2602.19874","contentUrl":null,"metadataVersion":0,"schemaVersion":"http://datacite.org/schema/kernel-4","source":"mds","isActive":true,"state":"findable","reason":null,"viewCount":0,"downloadCount":0,"referenceCount":0,"citationCount":0,"partCount":0,"partOfCount":0,"versionCount":0,"versionOfCount":0,"created":"2026-02-25T15:18:36Z","registered":"2026-02-25T15:18:37Z","published":null,"updated":"2026-02-25T15:18:37Z"},"relationships":{"client":{"data":{"id":"arxiv.content","type":"clients"}}}},{"id":"10.48550/arxiv.2602.19873","type":"dois","attributes":{"doi":"10.48550/arxiv.2602.19873","identifiers":[{"identifier":"2602.19873","identifierType":"arXiv"}],"creators":[{"nameType":"Personal","givenName":"Felix","familyName":"Thaler","name":"Thaler, Felix","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Sebastian","familyName":"Keller","name":"Keller, Sebastian","affiliation":[],"nameIdentifiers":[]}],"titles":[{"title":"GPU-Native Compressed Neighbor Lists with a Space-Filling-Curve Data Layout"}],"publisher":"arXiv","container":{},"publicationYear":2026,"subjects":[{"subject":"Computational Engineering, Finance, and Science (cs.CE)","lang":"en","subjectScheme":"arXiv"},{"subject":"Instrumentation and Methods for Astrophysics (astro-ph.IM)","lang":"en","subjectScheme":"arXiv"},{"subject":"Data Structures and Algorithms (cs.DS)","lang":"en","subjectScheme":"arXiv"},{"subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"},{"schemeUri":"http://www.oecd.org/science/inno/38235147.pdf","subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"},{"subject":"FOS: Physical sciences","subjectScheme":"Fields of Science and Technology (FOS)"},{"schemeUri":"http://www.oecd.org/science/inno/38235147.pdf","subject":"FOS: Physical sciences","subjectScheme":"Fields of Science and Technology (FOS)"},{"subject":"J.2","lang":"en","subjectScheme":"ACM"},{"subject":"68W10","lang":"en","subjectScheme":"MSC"}],"contributors":[],"dates":[{"date":"2026-02-23T14:21:12Z","dateType":"Submitted","dateInformation":"v1"},{"date":"2026-02-24T02:30:04Z","dateType":"Updated","dateInformation":"v1"},{"date":"2026-02","dateType":"Available","dateInformation":"v1"},{"date":"2026","dateType":"Issued"}],"language":null,"types":{"schemaOrg":"CreativeWork","resourceTypeGeneral":"Preprint","citeproc":"article","bibtex":"misc","ris":"GEN","resourceType":"Article"},"relatedIdentifiers":[],"relatedItems":[],"sizes":[],"formats":[],"version":"1","rightsList":[{"rightsIdentifierScheme":"SPDX","rightsUri":"https://creativecommons.org/licenses/by-sa/4.0/legalcode","schemeUri":"https://spdx.org/licenses/","rights":"Creative Commons Attribution Share Alike 4.0 International","rightsIdentifier":"cc-by-sa-4.0"}],"descriptions":[{"descriptionType":"Abstract","description":"We have developed a compressed neighbor list for short-range particle-particle interaction based on a space- filling curve (SFC) memory layout and particle clusters. The neighbor list can be constructed efficiently on GPUs, supporting NVIDIA and AMD hardware, and has a memory footprint of only 4 bytes per particle to store approximately 200 neighbors. Compared to the highly-optimized domain-specific neighbor list implementation of GROMACS, a molecular dynamics code, it has a comparable cluster overhead and delivers similar performance in a neighborhood pass. Thanks to the SFC-based data layout and the support for varying interaction radii per particle, our neighbor list performs well for systems with high density contrasts, such as those encountered in many astrophysical and cosmological applications. Due to the close relation between SFCs and octrees, our neighbor list seamlessly integrates with octree-based domain decomposition and multipole-based methods for long-range gravitational or electrostatic interactions. To demonstrate the coupling between long- and short-range forces, we simulate an Evrard collapse, a standard test case for the coupling between hydrodynamical and gravitational forces, on up to 1024 GPUs, and compare our results to the analytical solution."},{"descriptionType":"Other","description":"Accepted at IPDPS 2026"}],"geoLocations":[],"fundingReferences":[],"url":"https://arxiv.org/abs/2602.19873","contentUrl":null,"metadataVersion":0,"schemaVersion":"http://datacite.org/schema/kernel-4","source":"mds","isActive":true,"state":"findable","reason":null,"viewCount":0,"downloadCount":0,"referenceCount":0,"citationCount":0,"partCount":0,"partOfCount":0,"versionCount":0,"versionOfCount":0,"created":"2026-02-25T15:18:34Z","registered":"2026-02-25T15:18:35Z","published":null,"updated":"2026-02-25T15:18:35Z"},"relationships":{"client":{"data":{"id":"arxiv.content","type":"clients"}}}},{"id":"10.48550/arxiv.2602.19872","type":"dois","attributes":{"doi":"10.48550/arxiv.2602.19872","identifiers":[{"identifier":"2602.19872","identifierType":"arXiv"}],"creators":[{"nameType":"Personal","givenName":"Jizhou","familyName":"Han","name":"Han, Jizhou","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Chenhao","familyName":"Ding","name":"Ding, Chenhao","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"SongLin","familyName":"Dong","name":"Dong, SongLin","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Yuhang","familyName":"He","name":"He, Yuhang","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Shaokun","familyName":"Wang","name":"Wang, Shaokun","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Qiang","familyName":"Wang","name":"Wang, Qiang","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Yihong","familyName":"Gong","name":"Gong, Yihong","affiliation":[],"nameIdentifiers":[]}],"titles":[{"title":"GOAL: Geometrically Optimal Alignment for Continual Generalized Category Discovery"}],"publisher":"arXiv","container":{},"publicationYear":2026,"subjects":[{"subject":"Computer Vision and Pattern Recognition (cs.CV)","lang":"en","subjectScheme":"arXiv"},{"subject":"Artificial Intelligence (cs.AI)","lang":"en","subjectScheme":"arXiv"},{"subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"},{"schemeUri":"http://www.oecd.org/science/inno/38235147.pdf","subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"}],"contributors":[],"dates":[{"date":"2026-02-23T14:15:56Z","dateType":"Submitted","dateInformation":"v1"},{"date":"2026-02-24T02:29:55Z","dateType":"Updated","dateInformation":"v1"},{"date":"2026-02","dateType":"Available","dateInformation":"v1"},{"date":"2026","dateType":"Issued"}],"language":null,"types":{"schemaOrg":"CreativeWork","resourceTypeGeneral":"Preprint","citeproc":"article","bibtex":"misc","ris":"GEN","resourceType":"Article"},"relatedIdentifiers":[],"relatedItems":[],"sizes":[],"formats":[],"version":"1","rightsList":[{"rightsUri":"http://arxiv.org/licenses/nonexclusive-distrib/1.0/","rights":"arXiv.org perpetual, non-exclusive license"}],"descriptions":[{"descriptionType":"Abstract","description":"Continual Generalized Category Discovery (C-GCD) requires identifying novel classes from unlabeled data while retaining knowledge of known classes over time. Existing methods typically update classifier weights dynamically, resulting in forgetting and inconsistent feature alignment. We propose GOAL, a unified framework that introduces a fixed Equiangular Tight Frame (ETF) classifier to impose a consistent geometric structure throughout learning. GOAL conducts supervised alignment for labeled samples and confidence-guided alignment for novel samples, enabling stable integration of new classes without disrupting old ones. Experiments on four benchmarks show that GOAL outperforms the prior method Happy, reducing forgetting by 16.1% and boosting novel class discovery by 3.2%, establishing a strong solution for long-horizon continual discovery."},{"descriptionType":"Other","description":"Accept by AAAI 2026"}],"geoLocations":[],"fundingReferences":[],"url":"https://arxiv.org/abs/2602.19872","contentUrl":null,"metadataVersion":0,"schemaVersion":"http://datacite.org/schema/kernel-4","source":"mds","isActive":true,"state":"findable","reason":null,"viewCount":0,"downloadCount":0,"referenceCount":0,"citationCount":0,"partCount":0,"partOfCount":0,"versionCount":0,"versionOfCount":0,"created":"2026-02-25T15:18:30Z","registered":"2026-02-25T15:18:32Z","published":null,"updated":"2026-02-25T15:18:32Z"},"relationships":{"client":{"data":{"id":"arxiv.content","type":"clients"}}}},{"id":"10.48550/arxiv.2602.19871","type":"dois","attributes":{"doi":"10.48550/arxiv.2602.19871","identifiers":[{"identifier":"2602.19871","identifierType":"arXiv"}],"creators":[{"nameType":"Personal","givenName":"M Ashwin","familyName":"Ganesh","name":"Ganesh, M Ashwin","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Akhil","familyName":"Aravind","name":"Aravind, Akhil","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Balasundaram","familyName":"Mohan","name":"Mohan, Balasundaram","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Saptarshi","familyName":"Basu","name":"Basu, Saptarshi","affiliation":[],"nameIdentifiers":[]}],"titles":[{"title":"Machine Learning based Ensemble Flame Regime Classification for Mesoscale Combustors based on Insights from Linear and Nonlinear Dynamic Analysis"}],"publisher":"arXiv","container":{},"publicationYear":2026,"subjects":[{"subject":"Fluid Dynamics (physics.flu-dyn)","lang":"en","subjectScheme":"arXiv"},{"subject":"Chaotic Dynamics (nlin.CD)","lang":"en","subjectScheme":"arXiv"},{"subject":"FOS: Physical sciences","subjectScheme":"Fields of Science and Technology (FOS)"},{"schemeUri":"http://www.oecd.org/science/inno/38235147.pdf","subject":"FOS: Physical sciences","subjectScheme":"Fields of Science and Technology (FOS)"}],"contributors":[],"dates":[{"date":"2026-02-23T14:15:44Z","dateType":"Submitted","dateInformation":"v1"},{"date":"2026-02-24T02:29:53Z","dateType":"Updated","dateInformation":"v1"},{"date":"2026-02","dateType":"Available","dateInformation":"v1"},{"date":"2026","dateType":"Issued"}],"language":null,"types":{"schemaOrg":"CreativeWork","resourceTypeGeneral":"Preprint","citeproc":"article","bibtex":"misc","ris":"GEN","resourceType":"Article"},"relatedIdentifiers":[],"relatedItems":[],"sizes":[],"formats":[],"version":"1","rightsList":[{"rightsIdentifierScheme":"SPDX","rightsUri":"https://creativecommons.org/publicdomain/zero/1.0/legalcode","schemeUri":"https://spdx.org/licenses/","rights":"Creative Commons Zero v1.0 Universal","rightsIdentifier":"cc0-1.0"}],"descriptions":[{"descriptionType":"Abstract","description":"Gaining insights into flame behaviour at small scales can lead to improvements in the efficiency of micro-reactors, compact power generation systems, fire safety technologies, and various other applications where combustion is confined to micro or mesoscales. Flame regimes observed in mesoscale combustors, namely Stable flame, Flames with repetitive extinction and ignition, and Propagating flame, exhibit unique dynamic characteristics that differentiate them from one another. In this study, we systematically examine the various flame regimes observed in mesoscale combustors from both dynamical and statistical standpoints. Our experimental methodology involves stabilizing a flame inside a quartz tube (an optically accessible mesoscale combustor) with an inner diameter of 5 mm. A premixed methane-air mixture is used as fuel, with its equivalence ratio and Reynolds number being the input parameters. Instantaneous OH* chemiluminescence and Acoustic pressure signals, along with high-speed flame imaging, were acquired for combustion dynamics characterization. The objective of this study is to analyze the distinct dynamical signatures associated with these observed flame regimes. For this purpose, Recurrence Quantification Analysis, followed by a Statistical-Spectral analysis, has been performed based on the experimentally acquired OH* Chemiluminescence and Acoustic pressure time-series signals. Subsequently, a stacking ensemble-based machine learning framework has been implemented for mesoscale flame regime classification based on the features extracted from the two aforementioned analyses. In addition, Continuous wavelet transform (CWT) scalograms and three-dimensional phase plots have been graphed to visually elucidate the evolution of system dynamics and the complex interaction of competing time scales in these flame regimes."}],"geoLocations":[],"fundingReferences":[],"url":"https://arxiv.org/abs/2602.19871","contentUrl":null,"metadataVersion":0,"schemaVersion":"http://datacite.org/schema/kernel-4","source":"mds","isActive":true,"state":"findable","reason":null,"viewCount":0,"downloadCount":0,"referenceCount":0,"citationCount":0,"partCount":0,"partOfCount":0,"versionCount":0,"versionOfCount":0,"created":"2026-02-25T15:18:28Z","registered":"2026-02-25T15:18:28Z","published":null,"updated":"2026-02-25T15:18:28Z"},"relationships":{"client":{"data":{"id":"arxiv.content","type":"clients"}}}},{"id":"10.48550/arxiv.2602.19870","type":"dois","attributes":{"doi":"10.48550/arxiv.2602.19870","identifiers":[{"identifier":"2602.19870","identifierType":"arXiv"}],"creators":[{"nameType":"Personal","givenName":"Qiankun","familyName":"Ma","name":"Ma, Qiankun","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Ziyao","familyName":"Zhang","name":"Zhang, Ziyao","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Haofei","familyName":"Wang","name":"Wang, Haofei","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Jie","familyName":"Chen","name":"Chen, Jie","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Zhen","familyName":"Song","name":"Song, Zhen","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Hairong","familyName":"Zheng","name":"Zheng, Hairong","affiliation":[],"nameIdentifiers":[]}],"titles":[{"title":"ApET: Approximation-Error Guided Token Compression for Efficient VLMs"}],"publisher":"arXiv","container":{},"publicationYear":2026,"subjects":[{"subject":"Computer Vision and Pattern Recognition (cs.CV)","lang":"en","subjectScheme":"arXiv"},{"subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"},{"schemeUri":"http://www.oecd.org/science/inno/38235147.pdf","subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"}],"contributors":[],"dates":[{"date":"2026-02-23T14:15:37Z","dateType":"Submitted","dateInformation":"v1"},{"date":"2026-02-24T02:29:51Z","dateType":"Updated","dateInformation":"v1"},{"date":"2026-02","dateType":"Available","dateInformation":"v1"},{"date":"2026","dateType":"Issued"}],"language":null,"types":{"schemaOrg":"CreativeWork","resourceTypeGeneral":"Preprint","citeproc":"article","bibtex":"misc","ris":"GEN","resourceType":"Article"},"relatedIdentifiers":[],"relatedItems":[],"sizes":[],"formats":[],"version":"1","rightsList":[{"rightsIdentifierScheme":"SPDX","rightsUri":"https://creativecommons.org/licenses/by/4.0/legalcode","schemeUri":"https://spdx.org/licenses/","rights":"Creative Commons Attribution 4.0 International","rightsIdentifier":"cc-by-4.0"}],"descriptions":[{"descriptionType":"Abstract","description":"Recent Vision-Language Models (VLMs) have demonstrated remarkable multimodal understanding capabilities, yet the redundant visual tokens incur prohibitive computational overhead and degrade inference efficiency. Prior studies typically relies on [CLS] attention or text-vision cross-attention to identify and discard redundant visual tokens. Despite promising results, such solutions are prone to introduce positional bias and, more critically, are incompatible with efficient attention kernels such as FlashAttention, limiting their practical deployment for VLM acceleration. In this paper, we step away from attention dependencies and revisit visual token compression from an information-theoretic perspective, aiming to maximally preserve visual information without any attention involvement. We present ApET, an Approximation-Error guided Token compression framework. ApET first reconstructs the original visual tokens with a small set of basis tokens via linear approximation, then leverages the approximation error to identify and drop the least informative tokens. Extensive experiments across multiple VLMs and benchmarks demonstrate that ApET retains 95.2% of the original performance on image-understanding tasks and even attains 100.4% on video-understanding tasks, while compressing the token budgets by 88.9% and 87.5%, respectively. Thanks to its attention-free design, ApET seamlessly integrates with FlashAttention, enabling further inference acceleration and making VLM deployment more practical. Code is available at https://github.com/MaQianKun0/ApET."},{"descriptionType":"Other","description":"CVPR2026"}],"geoLocations":[],"fundingReferences":[],"url":"https://arxiv.org/abs/2602.19870","contentUrl":null,"metadataVersion":0,"schemaVersion":"http://datacite.org/schema/kernel-4","source":"mds","isActive":true,"state":"findable","reason":null,"viewCount":0,"downloadCount":0,"referenceCount":0,"citationCount":0,"partCount":0,"partOfCount":0,"versionCount":0,"versionOfCount":0,"created":"2026-02-25T15:18:25Z","registered":"2026-02-25T15:18:26Z","published":null,"updated":"2026-02-25T15:18:26Z"},"relationships":{"client":{"data":{"id":"arxiv.content","type":"clients"}}}},{"id":"10.48550/arxiv.2602.19869","type":"dois","attributes":{"doi":"10.48550/arxiv.2602.19869","identifiers":[{"identifier":"2602.19869","identifierType":"arXiv"}],"creators":[{"nameType":"Personal","givenName":"Amal","familyName":"Alphonse","name":"Alphonse, Amal","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Petar","familyName":"Kunštek","name":"Kunštek, Petar","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Marko","familyName":"Vrdoljak","name":"Vrdoljak, Marko","affiliation":[],"nameIdentifiers":[]}],"titles":[{"title":"Optimal design with uncertainties: a risk-averse approach"}],"publisher":"arXiv","container":{},"publicationYear":2026,"subjects":[{"subject":"Optimization and Control (math.OC)","lang":"en","subjectScheme":"arXiv"},{"subject":"Analysis of PDEs (math.AP)","lang":"en","subjectScheme":"arXiv"},{"subject":"FOS: Mathematics","subjectScheme":"Fields of Science and Technology (FOS)"},{"schemeUri":"http://www.oecd.org/science/inno/38235147.pdf","subject":"FOS: Mathematics","subjectScheme":"Fields of Science and Technology (FOS)"}],"contributors":[],"dates":[{"date":"2026-02-23T14:12:25Z","dateType":"Submitted","dateInformation":"v1"},{"date":"2026-02-24T02:29:45Z","dateType":"Updated","dateInformation":"v1"},{"date":"2026-02","dateType":"Available","dateInformation":"v1"},{"date":"2026","dateType":"Issued"}],"language":null,"types":{"schemaOrg":"CreativeWork","resourceTypeGeneral":"Preprint","citeproc":"article","bibtex":"misc","ris":"GEN","resourceType":"Article"},"relatedIdentifiers":[],"relatedItems":[],"sizes":[],"formats":[],"version":"1","rightsList":[{"rightsUri":"http://arxiv.org/licenses/nonexclusive-distrib/1.0/","rights":"arXiv.org perpetual, non-exclusive license"}],"descriptions":[{"descriptionType":"Abstract","description":"We study a class of stochastic optimal design problems for elliptic partial differential equations in divergence form, where the coefficients represent mixtures of two conducting materials. The objective is to minimize a generalized risk measure of the system response, incorporating uncertainty in the loading through probability distributions. We establish existence of relaxed optimal designs via homogenization theory and derive first-order stationarity conditions satisfied by the optima. Based on these conditions, we develop an optimality criteria algorithm for numerical computations. The stochastic component is treated using a truncated Karhunen--Loève expansion, allowing evaluation of the value-at-risk (VaR) and conditional value-at-risk (CVaR) contributions arising from the sensitivity analysis and featured in the algorithm. The method is illustrated for an example involving CVaR-based compliance minimization."},{"descriptionType":"Other","description":"2 figures"}],"geoLocations":[],"fundingReferences":[],"url":"https://arxiv.org/abs/2602.19869","contentUrl":null,"metadataVersion":0,"schemaVersion":"http://datacite.org/schema/kernel-4","source":"mds","isActive":true,"state":"findable","reason":null,"viewCount":0,"downloadCount":0,"referenceCount":0,"citationCount":0,"partCount":0,"partOfCount":0,"versionCount":0,"versionOfCount":0,"created":"2026-02-25T15:18:23Z","registered":"2026-02-25T15:18:23Z","published":null,"updated":"2026-02-25T15:18:23Z"},"relationships":{"client":{"data":{"id":"arxiv.content","type":"clients"}}}},{"id":"10.48550/arxiv.2602.19868","type":"dois","attributes":{"doi":"10.48550/arxiv.2602.19868","identifiers":[{"identifier":"2602.19868","identifierType":"arXiv"}],"creators":[{"nameType":"Personal","givenName":"David","familyName":"Knothe","name":"Knothe, David","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Oliver","familyName":"Bringmann","name":"Bringmann, Oliver","affiliation":[],"nameIdentifiers":[]}],"titles":[{"title":"Combining Small-Step and Big-Step Semantics to Verify Loop Optimizations"}],"publisher":"arXiv","container":{},"publicationYear":2026,"subjects":[{"subject":"Programming Languages (cs.PL)","lang":"en","subjectScheme":"arXiv"},{"subject":"Logic in Computer Science (cs.LO)","lang":"en","subjectScheme":"arXiv"},{"subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"},{"schemeUri":"http://www.oecd.org/science/inno/38235147.pdf","subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"},{"subject":"F.3.2; D.3.4; D.2.4","lang":"en","subjectScheme":"ACM"}],"contributors":[],"dates":[{"date":"2026-02-23T14:12:17Z","dateType":"Submitted","dateInformation":"v1"},{"date":"2026-02-24T02:29:43Z","dateType":"Updated","dateInformation":"v1"},{"date":"2026-02","dateType":"Available","dateInformation":"v1"},{"date":"2026","dateType":"Issued"}],"language":null,"types":{"schemaOrg":"CreativeWork","resourceTypeGeneral":"Preprint","citeproc":"article","bibtex":"misc","ris":"GEN","resourceType":"Article"},"relatedIdentifiers":[],"relatedItems":[],"sizes":[],"formats":[],"version":"1","rightsList":[{"rightsIdentifierScheme":"SPDX","rightsUri":"https://creativecommons.org/licenses/by/4.0/legalcode","schemeUri":"https://spdx.org/licenses/","rights":"Creative Commons Attribution 4.0 International","rightsIdentifier":"cc-by-4.0"}],"descriptions":[{"descriptionType":"Abstract","description":"Verified compilers aim to guarantee that compilation preserves the observable behavior of source programs. While small-step semantics are widely used in such compilers, they are not always the most convenient framework for structural transformations such as loop optimizations. This paper proposes an approach that leverages both small-step and big-step semantics: small-step semantics are used for local transformations, while big-step semantics are employed for structural transformations. An abstract behavioral semantics is introduced as a common interface between the two styles. Coinductive big-step semantics is extended to correctly handle divergence with both finite and infinite traces, bringing it on par with the expressiveness of small-step semantics. This enables the insertion of big-step transformations into the middle of an existing small-step pipeline, thereby fully preserving all top-level semantic preservation theorems. This approach is practically demonstrated in CompCert by implementing and verifying a few new loop optimizations in big-step Cminor, including loop unswitching and, notably, full loop unrolling."},{"descriptionType":"Other","description":"18 pages, 6 figures. Submitted to ITP 2026"}],"geoLocations":[],"fundingReferences":[],"url":"https://arxiv.org/abs/2602.19868","contentUrl":null,"metadataVersion":0,"schemaVersion":"http://datacite.org/schema/kernel-4","source":"mds","isActive":true,"state":"findable","reason":null,"viewCount":0,"downloadCount":0,"referenceCount":0,"citationCount":0,"partCount":0,"partOfCount":0,"versionCount":0,"versionOfCount":0,"created":"2026-02-25T15:18:20Z","registered":"2026-02-25T15:18:21Z","published":null,"updated":"2026-02-25T15:18:21Z"},"relationships":{"client":{"data":{"id":"arxiv.content","type":"clients"}}}},{"id":"10.48550/arxiv.2602.19867","type":"dois","attributes":{"doi":"10.48550/arxiv.2602.19867","identifiers":[{"identifier":"2602.19867","identifierType":"arXiv"}],"creators":[{"nameType":"Personal","givenName":"Carlo","familyName":"Karam","name":"Karam, Carlo","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Matteo","familyName":"Tacchi","name":"Tacchi, Matteo","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Mirko","familyName":"Fiacchini","name":"Fiacchini, Mirko","affiliation":[],"nameIdentifiers":[]}],"titles":[{"title":"A Stochastic Tube-Based MPC Framework with Hard Input Constraints"}],"publisher":"arXiv","container":{},"publicationYear":2026,"subjects":[{"subject":"Systems and Control (eess.SY)","lang":"en","subjectScheme":"arXiv"},{"subject":"FOS: Electrical engineering, electronic engineering, information engineering","subjectScheme":"Fields of Science and Technology (FOS)"},{"schemeUri":"http://www.oecd.org/science/inno/38235147.pdf","subject":"FOS: Electrical engineering, electronic engineering, information engineering","subjectScheme":"Fields of Science and Technology (FOS)"}],"contributors":[],"dates":[{"date":"2026-02-23T14:12:17Z","dateType":"Submitted","dateInformation":"v1"},{"date":"2026-02-24T02:29:42Z","dateType":"Updated","dateInformation":"v1"},{"date":"2026-02","dateType":"Available","dateInformation":"v1"},{"date":"2026","dateType":"Issued"}],"language":null,"types":{"schemaOrg":"CreativeWork","resourceTypeGeneral":"Preprint","citeproc":"article","bibtex":"misc","ris":"GEN","resourceType":"Article"},"relatedIdentifiers":[],"relatedItems":[],"sizes":[],"formats":[],"version":"1","rightsList":[{"rightsUri":"http://arxiv.org/licenses/nonexclusive-distrib/1.0/","rights":"arXiv.org perpetual, non-exclusive license"}],"descriptions":[{"descriptionType":"Abstract","description":"This work presents a stochastic tube-based model predictive control framework that guarantees hard input constraint satisfaction for linear systems subject to unbounded additive disturbances. The approach relies on a structured design of probabilistic reachable sets that explicitly incorporates actuator saturation into the error dynamics and bounds the resulting nonlinearity within a convex embedding. The proposed controller retains the computational efficiency and structural advantages of stochastic tube-based approaches while ensuring state chance constraint satisfaction alongside hard input limits. Recursive feasibility and mean-square stability are established for our scheme, and a numerical example illustrates its effectiveness."}],"geoLocations":[],"fundingReferences":[],"url":"https://arxiv.org/abs/2602.19867","contentUrl":null,"metadataVersion":0,"schemaVersion":"http://datacite.org/schema/kernel-4","source":"mds","isActive":true,"state":"findable","reason":null,"viewCount":0,"downloadCount":0,"referenceCount":0,"citationCount":0,"partCount":0,"partOfCount":0,"versionCount":0,"versionOfCount":0,"created":"2026-02-25T15:18:18Z","registered":"2026-02-25T15:18:18Z","published":null,"updated":"2026-02-25T15:18:18Z"},"relationships":{"client":{"data":{"id":"arxiv.content","type":"clients"}}}},{"id":"10.48550/arxiv.2602.19862","type":"dois","attributes":{"doi":"10.48550/arxiv.2602.19862","identifiers":[{"identifier":"2602.19862","identifierType":"arXiv"}],"creators":[{"nameType":"Personal","givenName":"Lars","familyName":"Fischer","name":"Fischer, Lars","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Daniel","familyName":"Flögel","name":"Flögel, Daniel","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Sören","familyName":"Hohmann","name":"Hohmann, Sören","affiliation":[],"nameIdentifiers":[]}],"titles":[{"title":"Rendezvous and Docking of Mobile Ground Robots for Efficient Transportation Systems"}],"publisher":"arXiv","container":{},"publicationYear":2026,"subjects":[{"subject":"Systems and Control (eess.SY)","lang":"en","subjectScheme":"arXiv"},{"subject":"Robotics (cs.RO)","lang":"en","subjectScheme":"arXiv"},{"subject":"FOS: Electrical engineering, electronic engineering, information engineering","subjectScheme":"Fields of Science and Technology (FOS)"},{"schemeUri":"http://www.oecd.org/science/inno/38235147.pdf","subject":"FOS: Electrical engineering, electronic engineering, information engineering","subjectScheme":"Fields of Science and Technology (FOS)"},{"subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"},{"schemeUri":"http://www.oecd.org/science/inno/38235147.pdf","subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"}],"contributors":[],"dates":[{"date":"2026-02-23T14:01:37Z","dateType":"Submitted","dateInformation":"v1"},{"date":"2026-02-24T02:29:17Z","dateType":"Updated","dateInformation":"v1"},{"date":"2026-02","dateType":"Available","dateInformation":"v1"},{"date":"2026","dateType":"Issued"}],"language":null,"types":{"schemaOrg":"CreativeWork","resourceTypeGeneral":"Preprint","citeproc":"article","bibtex":"misc","ris":"GEN","resourceType":"Article"},"relatedIdentifiers":[],"relatedItems":[],"sizes":[],"formats":[],"version":"1","rightsList":[{"rightsUri":"http://arxiv.org/licenses/nonexclusive-distrib/1.0/","rights":"arXiv.org perpetual, non-exclusive license"}],"descriptions":[{"descriptionType":"Abstract","description":"In-Motion physical coupling of multiple mobile ground robots has the potential to enable new applications like in-motion transfer that improves efficiency in handling and transferring goods, which tackles current challenges in logistics. A key challenge lies in achieving reliable autonomous in-motion physical coupling of two mobile ground robots starting at any initial position. Existing approaches neglect the modeling of the docking interface and the strategy for approaching it, resulting in uncontrolled collisions that make in-motion physical coupling either impossible or inefficient. To address this challenge, we propose a central mpc approach that explicitly models the dynamics and states of two omnidirectional wheeled robots, incorporates constraints related to their docking interface, and implements an approaching strategy for rendezvous and docking. This novel approach enables omnidirectional wheeled robots with a docking interface to physically couple in motion regardless of their initial position. In addition, it makes in-motion transfer possible, which is 19.75% more time- and 21.04% energy-efficient compared to a non-coupling approach in a logistic scenario."},{"descriptionType":"Other","description":"8 pages, conference paper"}],"geoLocations":[],"fundingReferences":[],"url":"https://arxiv.org/abs/2602.19862","contentUrl":null,"metadataVersion":0,"schemaVersion":"http://datacite.org/schema/kernel-4","source":"mds","isActive":true,"state":"findable","reason":null,"viewCount":0,"downloadCount":0,"referenceCount":0,"citationCount":0,"partCount":0,"partOfCount":0,"versionCount":0,"versionOfCount":0,"created":"2026-02-25T15:18:05Z","registered":"2026-02-25T15:18:06Z","published":null,"updated":"2026-02-25T15:18:06Z"},"relationships":{"client":{"data":{"id":"arxiv.content","type":"clients"}}}},{"id":"10.48550/arxiv.2602.19860","type":"dois","attributes":{"doi":"10.48550/arxiv.2602.19860","identifiers":[{"identifier":"2602.19860","identifierType":"arXiv"}],"creators":[{"nameType":"Personal","givenName":"Tony","familyName":"Zorman","name":"Zorman, Tony","affiliation":[],"nameIdentifiers":[]}],"titles":[{"title":"Categorical Reconstruction Theory"}],"publisher":"arXiv","container":{},"publicationYear":2026,"subjects":[{"subject":"Category Theory (math.CT)","lang":"en","subjectScheme":"arXiv"},{"subject":"Quantum Algebra (math.QA)","lang":"en","subjectScheme":"arXiv"},{"subject":"Representation Theory (math.RT)","lang":"en","subjectScheme":"arXiv"},{"subject":"FOS: Mathematics","subjectScheme":"Fields of Science and Technology (FOS)"},{"schemeUri":"http://www.oecd.org/science/inno/38235147.pdf","subject":"FOS: Mathematics","subjectScheme":"Fields of Science and Technology (FOS)"}],"contributors":[],"dates":[{"date":"2026-02-23T14:00:42Z","dateType":"Submitted","dateInformation":"v1"},{"date":"2026-02-24T02:29:15Z","dateType":"Updated","dateInformation":"v1"},{"date":"2026-02","dateType":"Available","dateInformation":"v1"},{"date":"2026","dateType":"Issued"}],"language":null,"types":{"schemaOrg":"CreativeWork","resourceTypeGeneral":"Preprint","citeproc":"article","bibtex":"misc","ris":"GEN","resourceType":"Article"},"relatedIdentifiers":[],"relatedItems":[],"sizes":[],"formats":[],"version":"1","rightsList":[{"rightsIdentifierScheme":"SPDX","rightsUri":"https://creativecommons.org/licenses/by-sa/4.0/legalcode","schemeUri":"https://spdx.org/licenses/","rights":"Creative Commons Attribution Share Alike 4.0 International","rightsIdentifier":"cc-by-sa-4.0"}],"descriptions":[{"descriptionType":"Abstract","description":"We generalise classical reconstruction results in algebra, using the language of monads, monoidal categories, module categories, as well as various notions of duality, such as closedness, Grothendieck--Verdier duality (also known as *-autonomy), and rigidity."},{"descriptionType":"Other","description":"PhD thesis; based on 2201.05361v2, 2301.03545v2, 2312.13074v2, 2409.00793v2, and 2503.03445"}],"geoLocations":[],"fundingReferences":[],"url":"https://arxiv.org/abs/2602.19860","contentUrl":null,"metadataVersion":0,"schemaVersion":"http://datacite.org/schema/kernel-4","source":"mds","isActive":true,"state":"findable","reason":null,"viewCount":0,"downloadCount":0,"referenceCount":0,"citationCount":0,"partCount":0,"partOfCount":0,"versionCount":0,"versionOfCount":0,"created":"2026-02-25T15:18:00Z","registered":"2026-02-25T15:18:01Z","published":null,"updated":"2026-02-25T15:18:01Z"},"relationships":{"client":{"data":{"id":"arxiv.content","type":"clients"}}}},{"id":"10.48550/arxiv.2602.19859","type":"dois","attributes":{"doi":"10.48550/arxiv.2602.19859","identifiers":[{"identifier":"2602.19859","identifierType":"arXiv"}],"creators":[{"nameType":"Personal","givenName":"August","familyName":"Arnstad","name":"Arnstad, August","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Leiv","familyName":"Rønneberg","name":"Rønneberg, Leiv","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Geir","familyName":"Storvik","name":"Storvik, Geir","affiliation":[],"nameIdentifiers":[]}],"titles":[{"title":"Dirichlet Scale Mixture Priors for Bayesian Neural Networks"}],"publisher":"arXiv","container":{},"publicationYear":2026,"subjects":[{"subject":"Machine Learning (stat.ML)","lang":"en","subjectScheme":"arXiv"},{"subject":"Machine Learning (cs.LG)","lang":"en","subjectScheme":"arXiv"},{"subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"},{"schemeUri":"http://www.oecd.org/science/inno/38235147.pdf","subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"},{"subject":"Primary: 62F15 Secondary: 62J02, 68T05","lang":"en","subjectScheme":"MSC"}],"contributors":[],"dates":[{"date":"2026-02-23T13:58:16Z","dateType":"Submitted","dateInformation":"v1"},{"date":"2026-02-24T02:29:13Z","dateType":"Updated","dateInformation":"v1"},{"date":"2026-02","dateType":"Available","dateInformation":"v1"},{"date":"2026","dateType":"Issued"}],"language":null,"types":{"schemaOrg":"CreativeWork","resourceTypeGeneral":"Preprint","citeproc":"article","bibtex":"misc","ris":"GEN","resourceType":"Article"},"relatedIdentifiers":[],"relatedItems":[],"sizes":[],"formats":[],"version":"1","rightsList":[{"rightsUri":"http://arxiv.org/licenses/nonexclusive-distrib/1.0/","rights":"arXiv.org perpetual, non-exclusive license"}],"descriptions":[{"descriptionType":"Abstract","description":"Neural networks are the cornerstone of modern machine learning, yet can be difficult to interpret, give overconfident predictions and are vulnerable to adversarial attacks. Bayesian neural networks (BNNs) provide some alleviation of these limitations, but have problems of their own. The key step of specifying prior distributions in BNNs is no trivial task, yet is often skipped out of convenience. In this work, we propose a new class of prior distributions for BNNs, the Dirichlet scale mixture (DSM) prior, that addresses current limitations in Bayesian neural networks through structured, sparsity-inducing shrinkage. Theoretically, we derive general dependence structures and shrinkage results for DSM priors and show how they manifest under the geometry induced by neural networks. In experiments on simulated and real world data we find that the DSM priors encourages sparse networks through implicit feature selection, show robustness under adversarial attacks and deliver competitive predictive performance with substantially fewer effective parameters. In particular, their advantages appear most pronounced in correlated, moderately small data regimes, and are more amenable to weight pruning. Moreover, by adopting heavy-tailed shrinkage mechanisms, our approach aligns with recent findings that such priors can mitigate the cold posterior effect, offering a principled alternative to the commonly used Gaussian priors."},{"descriptionType":"Other","description":"24 pages, 20 figures"}],"geoLocations":[],"fundingReferences":[],"url":"https://arxiv.org/abs/2602.19859","contentUrl":null,"metadataVersion":0,"schemaVersion":"http://datacite.org/schema/kernel-4","source":"mds","isActive":true,"state":"findable","reason":null,"viewCount":0,"downloadCount":0,"referenceCount":0,"citationCount":0,"partCount":0,"partOfCount":0,"versionCount":0,"versionOfCount":0,"created":"2026-02-25T15:17:58Z","registered":"2026-02-25T15:17:58Z","published":null,"updated":"2026-02-25T15:17:58Z"},"relationships":{"client":{"data":{"id":"arxiv.content","type":"clients"}}}},{"id":"10.48550/arxiv.2602.19856","type":"dois","attributes":{"doi":"10.48550/arxiv.2602.19856","identifiers":[{"identifier":"2602.19856","identifierType":"arXiv"}],"creators":[{"nameType":"Personal","givenName":"Iqra","familyName":"Kanwal","name":"Kanwal, Iqra","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Jianghao","familyName":"Hao","name":"Hao, Jianghao","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Muhammad Fahim","familyName":"Aslam","name":"Aslam, Muhammad Fahim","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Mauricio","familyName":"Sepúlveda-Cortés","name":"Sepúlveda-Cortés, Mauricio","affiliation":[],"nameIdentifiers":[]}],"titles":[{"title":"Stability and Finite-Time Blow-Up for a Fractionally Damped Nonlinear Plate Equation: Numerical and Analytical Insights"}],"publisher":"arXiv","container":{},"publicationYear":2026,"subjects":[{"subject":"Analysis of PDEs (math.AP)","lang":"en","subjectScheme":"arXiv"},{"subject":"FOS: Mathematics","subjectScheme":"Fields of Science and Technology (FOS)"},{"schemeUri":"http://www.oecd.org/science/inno/38235147.pdf","subject":"FOS: Mathematics","subjectScheme":"Fields of Science and Technology (FOS)"}],"contributors":[],"dates":[{"date":"2026-02-23T13:55:37Z","dateType":"Submitted","dateInformation":"v1"},{"date":"2026-02-24T02:29:09Z","dateType":"Updated","dateInformation":"v1"},{"date":"2026-02","dateType":"Available","dateInformation":"v1"},{"date":"2026","dateType":"Issued"}],"language":null,"types":{"schemaOrg":"CreativeWork","resourceTypeGeneral":"Preprint","citeproc":"article","bibtex":"misc","ris":"GEN","resourceType":"Article"},"relatedIdentifiers":[],"relatedItems":[],"sizes":[],"formats":[],"version":"1","rightsList":[{"rightsUri":"http://arxiv.org/licenses/nonexclusive-distrib/1.0/","rights":"arXiv.org perpetual, non-exclusive license"}],"descriptions":[{"descriptionType":"Abstract","description":"This paper studies a nonlinear plate equation with internal fractional damping and a time-delay term, driven by a polynomial-type nonlinear source. Such a model arises naturally in the description of viscoelastic and feedback-controlled elastic structures. We first establish the local existence and uniqueness of weak solutions using semigroup theory. The long-time behavior of solutions is then analyzed by constructing a suitable Lyapunov functional, from which stability and energy decay results are obtained. Moreover, by applying the concavity method, we prove that solutions associated with negative initial energy blow up in finite time. These results highlight the competing effects of fractional damping and delayed feedback on the qualitative behavior of the system. Finally, numerical simulations are presented to confirm the analytical results and to illustrate both stability and blow-up dynamics."}],"geoLocations":[],"fundingReferences":[],"url":"https://arxiv.org/abs/2602.19856","contentUrl":null,"metadataVersion":0,"schemaVersion":"http://datacite.org/schema/kernel-4","source":"mds","isActive":true,"state":"findable","reason":null,"viewCount":0,"downloadCount":0,"referenceCount":0,"citationCount":0,"partCount":0,"partOfCount":0,"versionCount":0,"versionOfCount":0,"created":"2026-02-25T15:17:50Z","registered":"2026-02-25T15:17:51Z","published":null,"updated":"2026-02-25T15:17:51Z"},"relationships":{"client":{"data":{"id":"arxiv.content","type":"clients"}}}},{"id":"10.48550/arxiv.2602.19855","type":"dois","attributes":{"doi":"10.48550/arxiv.2602.19855","identifiers":[{"identifier":"2602.19855","identifierType":"arXiv"}],"creators":[{"nameType":"Personal","givenName":"Francois","familyName":"Vandenhende","name":"Vandenhende, Francois","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Anna","familyName":"Georgiou","name":"Georgiou, Anna","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Theodoros","familyName":"Psaras","name":"Psaras, Theodoros","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Ellie","familyName":"Karekla","name":"Karekla, Ellie","affiliation":[],"nameIdentifiers":[]}],"titles":[{"title":"SHIELD: Semantic Heterogeneity Integrated Embedding for Latent Discovery in Clinical Trial Safety Signals"}],"publisher":"arXiv","container":{},"publicationYear":2026,"subjects":[{"subject":"Computation and Language (cs.CL)","lang":"en","subjectScheme":"arXiv"},{"subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"},{"schemeUri":"http://www.oecd.org/science/inno/38235147.pdf","subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"}],"contributors":[],"dates":[{"date":"2026-02-23T13:55:36Z","dateType":"Submitted","dateInformation":"v1"},{"date":"2026-02-24T02:29:08Z","dateType":"Updated","dateInformation":"v1"},{"date":"2026-02","dateType":"Available","dateInformation":"v1"},{"date":"2026","dateType":"Issued"}],"language":null,"types":{"schemaOrg":"CreativeWork","resourceTypeGeneral":"Preprint","citeproc":"article","bibtex":"misc","ris":"GEN","resourceType":"Article"},"relatedIdentifiers":[],"relatedItems":[],"sizes":[],"formats":[],"version":"1","rightsList":[{"rightsIdentifierScheme":"SPDX","rightsUri":"https://creativecommons.org/licenses/by-nc-nd/4.0/legalcode","schemeUri":"https://spdx.org/licenses/","rights":"Creative Commons Attribution Non Commercial No Derivatives 4.0 International","rightsIdentifier":"cc-by-nc-nd-4.0"}],"descriptions":[{"descriptionType":"Abstract","description":"We present SHIELD, a novel methodology for automated and integrated safety signal detection in clinical trials. SHIELD combines disproportionality analysis with semantic clustering of adverse event (AE) terms applied to MedDRA term embeddings. For each AE, the pipeline computes an information-theoretic disproportionality measure (Information Component) with effect size derived via empirical Bayesian shrinkage. A utility matrix is constructed by weighting semantic term-term similarities by signal magnitude, followed by spectral embedding and clustering to identify groups of related AEs. Resulting clusters are annotated with syndrome-level summary labels using large language models, yielding a coherent, data-driven representation of treatment-associated safety profiles in the form of a network graph and hierarchical tree. We implement the SHIELD framework in the context of a single-arm incidence summary, to compare two treatment arms or for the detection of any treatment effect in a multi-arm trial. We illustrate its ability to recover known safety signals and generate interpretable, cluster-based summaries in a real clinical trial example. This work bridges statistical signal detection with modern natural language processing to enhance safety assessment and causal interpretation in clinical trials."},{"descriptionType":"Other","description":"3 figures, 1 table"}],"geoLocations":[],"fundingReferences":[],"url":"https://arxiv.org/abs/2602.19855","contentUrl":null,"metadataVersion":0,"schemaVersion":"http://datacite.org/schema/kernel-4","source":"mds","isActive":true,"state":"findable","reason":null,"viewCount":0,"downloadCount":0,"referenceCount":0,"citationCount":0,"partCount":0,"partOfCount":0,"versionCount":0,"versionOfCount":0,"created":"2026-02-25T15:17:48Z","registered":"2026-02-25T15:17:48Z","published":null,"updated":"2026-02-25T15:17:48Z"},"relationships":{"client":{"data":{"id":"arxiv.content","type":"clients"}}}},{"id":"10.48550/arxiv.2602.19854","type":"dois","attributes":{"doi":"10.48550/arxiv.2602.19854","identifiers":[{"identifier":"2602.19854","identifierType":"arXiv"}],"creators":[{"nameType":"Personal","givenName":"Zhihao","familyName":"Ge","name":"Ge, Zhihao","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Yanan","familyName":"He","name":"He, Yanan","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Yajie","familyName":"Yang","name":"Yang, Yajie","affiliation":[],"nameIdentifiers":[]}],"titles":[{"title":"Optimal $L^2$-norm error estimate of multiphysics finite element method for poroelasticity model and simulating brain edema"}],"publisher":"arXiv","container":{},"publicationYear":2026,"subjects":[{"subject":"Numerical Analysis (math.NA)","lang":"en","subjectScheme":"arXiv"},{"subject":"FOS: Mathematics","subjectScheme":"Fields of Science and Technology (FOS)"},{"schemeUri":"http://www.oecd.org/science/inno/38235147.pdf","subject":"FOS: Mathematics","subjectScheme":"Fields of Science and Technology (FOS)"}],"contributors":[],"dates":[{"date":"2026-02-23T13:54:53Z","dateType":"Submitted","dateInformation":"v1"},{"date":"2026-02-24T02:29:06Z","dateType":"Updated","dateInformation":"v1"},{"date":"2026-02","dateType":"Available","dateInformation":"v1"},{"date":"2026","dateType":"Issued"}],"language":null,"types":{"schemaOrg":"CreativeWork","resourceTypeGeneral":"Preprint","citeproc":"article","bibtex":"misc","ris":"GEN","resourceType":"Article"},"relatedIdentifiers":[],"relatedItems":[],"sizes":[],"formats":[],"version":"1","rightsList":[{"rightsUri":"http://arxiv.org/licenses/nonexclusive-distrib/1.0/","rights":"arXiv.org perpetual, non-exclusive license"}],"descriptions":[{"descriptionType":"Abstract","description":"In this paper, we derive an optimal $L^2$-norm error estimate of the multiphysics finite element method for the poroelasticity model by introducing an auxiliary problem. We show some numerical tests to verify the theoretical result and apply the multiphysics finite element method to simulate the brain edema which caused by abnormal accumulation of cerebrospinal fluid in injured areas. And we investigate the effects of the key physical parameters on brain edema and observed that the permeability $K$ has the biggest influence on intracranial pressure and tissue deformation, Young's modulus $E$ and Poisson ratio $ν$ have little effect on the maximum value of intracranial pressure, but have great effect on the tissue deformation and the developing speed of brain edema."}],"geoLocations":[],"fundingReferences":[],"url":"https://arxiv.org/abs/2602.19854","contentUrl":null,"metadataVersion":0,"schemaVersion":"http://datacite.org/schema/kernel-4","source":"mds","isActive":true,"state":"findable","reason":null,"viewCount":0,"downloadCount":0,"referenceCount":0,"citationCount":0,"partCount":0,"partOfCount":0,"versionCount":0,"versionOfCount":0,"created":"2026-02-25T15:17:45Z","registered":"2026-02-25T15:17:46Z","published":null,"updated":"2026-02-25T15:17:46Z"},"relationships":{"client":{"data":{"id":"arxiv.content","type":"clients"}}}},{"id":"10.48550/arxiv.2602.19853","type":"dois","attributes":{"doi":"10.48550/arxiv.2602.19853","identifiers":[{"identifier":"2602.19853","identifierType":"arXiv"}],"creators":[{"nameType":"Personal","givenName":"Leni","familyName":"Yang","name":"Yang, Leni","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Aymeric","familyName":"Ferron","name":"Ferron, Aymeric","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Yvonne","familyName":"Jansen","name":"Jansen, Yvonne","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Pierre","familyName":"Dragicevic","name":"Dragicevic, Pierre","affiliation":[],"nameIdentifiers":[]}],"titles":[{"title":"Progressive Value Reading: The Use of Motion to Gradually Examine Data Involving Large Magnitudes"}],"publisher":"arXiv","container":{},"publicationYear":2026,"subjects":[{"subject":"Human-Computer Interaction (cs.HC)","lang":"en","subjectScheme":"arXiv"},{"subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"},{"schemeUri":"http://www.oecd.org/science/inno/38235147.pdf","subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"}],"contributors":[],"dates":[{"date":"2026-02-23T13:54:34Z","dateType":"Submitted","dateInformation":"v1"},{"date":"2026-02-24T02:29:05Z","dateType":"Updated","dateInformation":"v1"},{"date":"2026-02","dateType":"Available","dateInformation":"v1"},{"date":"2026","dateType":"Issued"}],"language":null,"types":{"schemaOrg":"CreativeWork","resourceTypeGeneral":"Preprint","citeproc":"article","bibtex":"misc","ris":"GEN","resourceType":"Article"},"relatedIdentifiers":[],"relatedItems":[],"sizes":[],"formats":[],"version":"1","rightsList":[{"rightsIdentifierScheme":"SPDX","rightsUri":"https://creativecommons.org/licenses/by-nc-nd/4.0/legalcode","schemeUri":"https://spdx.org/licenses/","rights":"Creative Commons Attribution Non Commercial No Derivatives 4.0 International","rightsIdentifier":"cc-by-nc-nd-4.0"}],"descriptions":[{"descriptionType":"Abstract","description":"People often struggle to interpret data with extremely large or small values, or ranges spanning multiple orders of magnitude. While traditional approaches, such as log scales and multiscale visualizations, can help, we explore in this article a different approach used in some emerging designs: the use of motion to let viewers gradually experience magnitude -- for example, interactive graphics that require long scrolling or street paintings stretching hundreds of meters. This approach typically demands substantial time and sustained interaction, translating differences in magnitude into a visceral sense of duration and effort. Although largely underexplored, this design strategy offers new opportunities. We introduce the term progressive value reading to refer to the use of motion to progressively examine an information object that encodes a value, where the amount of motion reflects the value. We compiled a corpus of 55 real-life and hypothetical visualization examples that allow, encourage, or require progressive value reading. From this corpus, we derived a design space of ten design dimensions, providing a shared vocabulary, inspiration for novel techniques, and a foundation for empirical evaluation. An online corpus is also available for exploration."}],"geoLocations":[],"fundingReferences":[],"url":"https://arxiv.org/abs/2602.19853","contentUrl":null,"metadataVersion":0,"schemaVersion":"http://datacite.org/schema/kernel-4","source":"mds","isActive":true,"state":"findable","reason":null,"viewCount":0,"downloadCount":0,"referenceCount":0,"citationCount":0,"partCount":0,"partOfCount":0,"versionCount":0,"versionOfCount":0,"created":"2026-02-25T15:17:43Z","registered":"2026-02-25T15:17:44Z","published":null,"updated":"2026-02-25T15:17:44Z"},"relationships":{"client":{"data":{"id":"arxiv.content","type":"clients"}}}},{"id":"10.48550/arxiv.2602.19852","type":"dois","attributes":{"doi":"10.48550/arxiv.2602.19852","identifiers":[{"identifier":"2602.19852","identifierType":"arXiv"}],"creators":[{"nameType":"Personal","givenName":"Matteo","familyName":"Bresciani","name":"Bresciani, Matteo","affiliation":[],"nameIdentifiers":[]}],"titles":[{"title":"Thermal field theory and the QCD Equation of State"}],"publisher":"arXiv","container":{},"publicationYear":2026,"subjects":[{"subject":"High Energy Physics - Phenomenology (hep-ph)","lang":"en","subjectScheme":"arXiv"},{"subject":"High Energy Physics - Lattice (hep-lat)","lang":"en","subjectScheme":"arXiv"},{"subject":"FOS: Physical sciences","subjectScheme":"Fields of Science and Technology (FOS)"},{"schemeUri":"http://www.oecd.org/science/inno/38235147.pdf","subject":"FOS: Physical sciences","subjectScheme":"Fields of Science and Technology (FOS)"}],"contributors":[],"dates":[{"date":"2026-02-23T13:54:32Z","dateType":"Submitted","dateInformation":"v1"},{"date":"2026-02-24T02:29:04Z","dateType":"Updated","dateInformation":"v1"},{"date":"2026-02","dateType":"Available","dateInformation":"v1"},{"date":"2026","dateType":"Issued"}],"language":null,"types":{"schemaOrg":"CreativeWork","resourceTypeGeneral":"Preprint","citeproc":"article","bibtex":"misc","ris":"GEN","resourceType":"Article"},"relatedIdentifiers":[],"relatedItems":[],"sizes":[],"formats":[],"version":"1","rightsList":[{"rightsIdentifierScheme":"SPDX","rightsUri":"https://creativecommons.org/licenses/by/4.0/legalcode","schemeUri":"https://spdx.org/licenses/","rights":"Creative Commons Attribution 4.0 International","rightsIdentifier":"cc-by-4.0"}],"descriptions":[{"descriptionType":"Abstract","description":"This Chapter introduces QCD at finite temperature and density. We first present the formulation of the thermal theory in the Euclidean path integral formalism. We then describe how the strong dynamics at high temperature can be inspected through thermal effective field theories. As a concrete example of thermodynamic quantity, we discuss the Equation of State, which characterises the equilibrium properties of the QCD plasma. We finally conclude with an overview of the phase diagram of strongly interacting matter."},{"descriptionType":"Other","description":"11 pages, 6 figures, chapter for Encyclopedia of Particle Physics"}],"geoLocations":[],"fundingReferences":[],"url":"https://arxiv.org/abs/2602.19852","contentUrl":null,"metadataVersion":0,"schemaVersion":"http://datacite.org/schema/kernel-4","source":"mds","isActive":true,"state":"findable","reason":null,"viewCount":0,"downloadCount":0,"referenceCount":0,"citationCount":0,"partCount":0,"partOfCount":0,"versionCount":0,"versionOfCount":0,"created":"2026-02-25T15:17:41Z","registered":"2026-02-25T15:17:41Z","published":null,"updated":"2026-02-25T15:17:41Z"},"relationships":{"client":{"data":{"id":"arxiv.content","type":"clients"}}}},{"id":"10.48550/arxiv.2602.19851","type":"dois","attributes":{"doi":"10.48550/arxiv.2602.19851","identifiers":[{"identifier":"2602.19851","identifierType":"arXiv"}],"creators":[{"nameType":"Personal","givenName":"Xinyan","familyName":"Su","name":"Su, Xinyan","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Jiacan","familyName":"Gao","name":"Gao, Jiacan","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Mingyuan","familyName":"Ma","name":"Ma, Mingyuan","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Xiao","familyName":"Xu","name":"Xu, Xiao","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Xinrui","familyName":"Wan","name":"Wan, Xinrui","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Tianqi","familyName":"Gu","name":"Gu, Tianqi","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Enyun","familyName":"Yu","name":"Yu, Enyun","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Jiecheng","familyName":"Guo","name":"Guo, Jiecheng","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Zhiheng","familyName":"Zhang","name":"Zhang, Zhiheng","affiliation":[],"nameIdentifiers":[]}],"titles":[{"title":"Orthogonal Uplift Learning with Permutation-Invariant Representations for Combinatorial Treatments"}],"publisher":"arXiv","container":{},"publicationYear":2026,"subjects":[{"subject":"Methodology (stat.ME)","lang":"en","subjectScheme":"arXiv"},{"subject":"Machine Learning (cs.LG)","lang":"en","subjectScheme":"arXiv"},{"subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"},{"schemeUri":"http://www.oecd.org/science/inno/38235147.pdf","subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"}],"contributors":[],"dates":[{"date":"2026-02-23T13:54:12Z","dateType":"Submitted","dateInformation":"v1"},{"date":"2026-02-24T02:29:03Z","dateType":"Updated","dateInformation":"v1"},{"date":"2026-02","dateType":"Available","dateInformation":"v1"},{"date":"2026","dateType":"Issued"}],"language":null,"types":{"schemaOrg":"CreativeWork","resourceTypeGeneral":"Preprint","citeproc":"article","bibtex":"misc","ris":"GEN","resourceType":"Article"},"relatedIdentifiers":[],"relatedItems":[],"sizes":[],"formats":[],"version":"1","rightsList":[{"rightsUri":"http://arxiv.org/licenses/nonexclusive-distrib/1.0/","rights":"arXiv.org perpetual, non-exclusive license"}],"descriptions":[{"descriptionType":"Abstract","description":"We study uplift estimation for combinatorial treatments. Uplift measures the pure incremental causal effect of an intervention (e.g., sending a coupon or a marketing message) on user behavior, modeled as a conditional individual treatment effect. Many real-world interventions are combinatorial: a treatment is a policy that specifies context-dependent action distributions rather than a single atomic label. Although recent work considers structured treatments, most methods rely on categorical or opaque encodings, limiting robustness and generalization to rare or newly deployed policies. We propose an uplift estimation framework that aligns treatment representation with causal semantics. Each policy is represented by the mixture it induces over contextaction components and embedded via a permutation-invariant aggregation. This representation is integrated into an orthogonalized low-rank uplift model, extending Robinson-style decompositions to learned, vector-valued treatments. We show that the resulting estimator is expressive for policy-induced causal effects, orthogonally robust to nuisance estimation errors, and stable under small policy perturbations. Experiments on large-scale randomized platform data demonstrate improved uplift accuracy and stability in long-tailed policy regimes"}],"geoLocations":[],"fundingReferences":[],"url":"https://arxiv.org/abs/2602.19851","contentUrl":null,"metadataVersion":0,"schemaVersion":"http://datacite.org/schema/kernel-4","source":"mds","isActive":true,"state":"findable","reason":null,"viewCount":0,"downloadCount":0,"referenceCount":0,"citationCount":0,"partCount":0,"partOfCount":0,"versionCount":0,"versionOfCount":0,"created":"2026-02-25T15:17:38Z","registered":"2026-02-25T15:17:39Z","published":null,"updated":"2026-02-25T15:17:39Z"},"relationships":{"client":{"data":{"id":"arxiv.content","type":"clients"}}}},{"id":"10.48550/arxiv.2602.19850","type":"dois","attributes":{"doi":"10.48550/arxiv.2602.19850","identifiers":[{"identifier":"2602.19850","identifierType":"arXiv"}],"creators":[{"nameType":"Personal","givenName":"Junhui","familyName":"Lee","name":"Lee, Junhui","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Hyosung","familyName":"Kim","name":"Kim, Hyosung","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Saekwang","familyName":"Nam","name":"Nam, Saekwang","affiliation":[],"nameIdentifiers":[]}],"titles":[{"title":"TactiVerse: Generalizing Multi-Point Tactile Sensing in Soft Robotics Using Single-Point Data"}],"publisher":"arXiv","container":{},"publicationYear":2026,"subjects":[{"subject":"Robotics (cs.RO)","lang":"en","subjectScheme":"arXiv"},{"subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"},{"schemeUri":"http://www.oecd.org/science/inno/38235147.pdf","subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"}],"contributors":[],"dates":[{"date":"2026-02-23T13:53:14Z","dateType":"Submitted","dateInformation":"v1"},{"date":"2026-02-24T02:28:58Z","dateType":"Updated","dateInformation":"v1"},{"date":"2026-02","dateType":"Available","dateInformation":"v1"},{"date":"2026","dateType":"Issued"}],"language":null,"types":{"schemaOrg":"CreativeWork","resourceTypeGeneral":"Preprint","citeproc":"article","bibtex":"misc","ris":"GEN","resourceType":"Article"},"relatedIdentifiers":[],"relatedItems":[],"sizes":[],"formats":[],"version":"1","rightsList":[{"rightsUri":"http://arxiv.org/licenses/nonexclusive-distrib/1.0/","rights":"arXiv.org perpetual, non-exclusive license"}],"descriptions":[{"descriptionType":"Abstract","description":"Real-time prediction of deformation in highly compliant soft materials remains a significant challenge in soft robotics. While vision-based soft tactile sensors can track internal marker displacements, learning-based models for 3D contact estimation heavily depend on their training datasets, inherently limiting their ability to generalize to complex scenarios such as multi-point sensing. To address this limitation, we introduce TactiVerse, a U-Net-based framework that formulates contact geometry estimation as a spatial heatmap prediction task. Even when trained exclusively on a limited dataset of single-point indentations, our architecture achieves highly accurate single-point sensing, yielding a superior mean absolute error of 0.0589 mm compared to the 0.0612 mm of a conventional regression-based CNN baseline. Furthermore, we demonstrate that augmenting the training dataset with multi-point contact data substantially enhances the sensor's multi-point sensing capabilities, significantly improving the overall mean MAE for two-point discrimination from 1.214 mm to 0.383 mm. By successfully extrapolating complex contact geometries from fundamental interactions, this methodology unlocks advanced multi-point and large-area shape sensing. Ultimately, it significantly streamlines the development of marker-based soft sensors, offering a highly scalable solution for real-world tactile perception."},{"descriptionType":"Other","description":"6 pages, 7 figures, accepted at 9th IEEE-RAS International Conference on Soft Robotics (RoboSoft)"}],"geoLocations":[],"fundingReferences":[],"url":"https://arxiv.org/abs/2602.19850","contentUrl":null,"metadataVersion":0,"schemaVersion":"http://datacite.org/schema/kernel-4","source":"mds","isActive":true,"state":"findable","reason":null,"viewCount":0,"downloadCount":0,"referenceCount":0,"citationCount":0,"partCount":0,"partOfCount":0,"versionCount":0,"versionOfCount":0,"created":"2026-02-25T15:17:36Z","registered":"2026-02-25T15:17:36Z","published":null,"updated":"2026-02-25T15:17:36Z"},"relationships":{"client":{"data":{"id":"arxiv.content","type":"clients"}}}},{"id":"10.48550/arxiv.2602.19845","type":"dois","attributes":{"doi":"10.48550/arxiv.2602.19845","identifiers":[{"identifier":"2602.19845","identifierType":"arXiv"}],"creators":[{"nameType":"Personal","givenName":"Hyunwoo","familyName":"Park","name":"Park, Hyunwoo","affiliation":[],"nameIdentifiers":[]}],"titles":[{"title":"I Dropped a Neural Net"}],"publisher":"arXiv","container":{},"publicationYear":2026,"subjects":[{"subject":"Machine Learning (cs.LG)","lang":"en","subjectScheme":"arXiv"},{"subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"},{"schemeUri":"http://www.oecd.org/science/inno/38235147.pdf","subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"}],"contributors":[],"dates":[{"date":"2026-02-23T13:49:05Z","dateType":"Submitted","dateInformation":"v1"},{"date":"2026-02-24T02:28:32Z","dateType":"Updated","dateInformation":"v1"},{"date":"2026-02","dateType":"Available","dateInformation":"v1"},{"date":"2026","dateType":"Issued"}],"language":null,"types":{"schemaOrg":"CreativeWork","resourceTypeGeneral":"Preprint","citeproc":"article","bibtex":"misc","ris":"GEN","resourceType":"Article"},"relatedIdentifiers":[],"relatedItems":[],"sizes":[],"formats":[],"version":"1","rightsList":[{"rightsUri":"http://arxiv.org/licenses/nonexclusive-distrib/1.0/","rights":"arXiv.org perpetual, non-exclusive license"}],"descriptions":[{"descriptionType":"Abstract","description":"A recent Dwarkesh Patel podcast with John Collison and Elon Musk featured an interesting puzzle from Jane Street: they trained a neural net, shuffled all 96 layers, and asked to put them back in order.\n Given unlabelled layers of a Residual Network and its training dataset, we recover the exact ordering of the layers. The problem decomposes into pairing each block's input and output projections ($48!$ possibilities) and ordering the reassembled blocks ($48!$ possibilities), for a combined search space of $(48!)^2 \\approx 10^{122}$, which is more than the atoms in the observable universe. We show that stability conditions during training like dynamic isometry leave the product $W_{\\text{out}} W_{\\text{in}}$ for correctly paired layers with a negative diagonal structure, allowing us to use diagonal dominance ratio as a signal for pairing. For ordering, we seed-initialize with a rough proxy such as delta-norm or $\\|W_{\\text{out}}\\|_F$ then hill-climb to zero mean squared error."}],"geoLocations":[],"fundingReferences":[],"url":"https://arxiv.org/abs/2602.19845","contentUrl":null,"metadataVersion":0,"schemaVersion":"http://datacite.org/schema/kernel-4","source":"mds","isActive":true,"state":"findable","reason":null,"viewCount":0,"downloadCount":0,"referenceCount":0,"citationCount":0,"partCount":0,"partOfCount":0,"versionCount":0,"versionOfCount":0,"created":"2026-02-25T15:17:23Z","registered":"2026-02-25T15:17:24Z","published":null,"updated":"2026-02-25T15:17:24Z"},"relationships":{"client":{"data":{"id":"arxiv.content","type":"clients"}}}},{"id":"10.48550/arxiv.2602.19844","type":"dois","attributes":{"doi":"10.48550/arxiv.2602.19844","identifiers":[{"identifier":"2602.19844","identifierType":"arXiv"}],"creators":[{"nameType":"Personal","givenName":"Yedi","familyName":"Zhang","name":"Zhang, Yedi","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Haoyu","familyName":"Wang","name":"Wang, Haoyu","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Xianglin","familyName":"Yang","name":"Yang, Xianglin","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Jin Song","familyName":"Dong","name":"Dong, Jin Song","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Jun","familyName":"Sun","name":"Sun, Jun","affiliation":[],"nameIdentifiers":[]}],"titles":[{"title":"LLM-enabled Applications Require System-Level Threat Monitoring"}],"publisher":"arXiv","container":{},"publicationYear":2026,"subjects":[{"subject":"Cryptography and Security (cs.CR)","lang":"en","subjectScheme":"arXiv"},{"subject":"Artificial Intelligence (cs.AI)","lang":"en","subjectScheme":"arXiv"},{"subject":"Software Engineering (cs.SE)","lang":"en","subjectScheme":"arXiv"},{"subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"},{"schemeUri":"http://www.oecd.org/science/inno/38235147.pdf","subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"}],"contributors":[],"dates":[{"date":"2026-02-23T13:48:36Z","dateType":"Submitted","dateInformation":"v1"},{"date":"2026-02-24T02:28:31Z","dateType":"Updated","dateInformation":"v1"},{"date":"2026-02","dateType":"Available","dateInformation":"v1"},{"date":"2026","dateType":"Issued"}],"language":null,"types":{"schemaOrg":"CreativeWork","resourceTypeGeneral":"Preprint","citeproc":"article","bibtex":"misc","ris":"GEN","resourceType":"Article"},"relatedIdentifiers":[],"relatedItems":[],"sizes":[],"formats":[],"version":"1","rightsList":[{"rightsIdentifierScheme":"SPDX","rightsUri":"https://creativecommons.org/licenses/by/4.0/legalcode","schemeUri":"https://spdx.org/licenses/","rights":"Creative Commons Attribution 4.0 International","rightsIdentifier":"cc-by-4.0"}],"descriptions":[{"descriptionType":"Abstract","description":"LLM-enabled applications are rapidly reshaping the software ecosystem by using large language models as core reasoning components for complex task execution. This paradigm shift, however, introduces fundamentally new reliability challenges and significantly expands the security attack surface, due to the non-deterministic, learning-driven, and difficult-to-verify nature of LLM behavior. In light of these emerging and unavoidable safety challenges, we argue that such risks should be treated as expected operational conditions rather than exceptional events, necessitating a dedicated incident-response perspective. Consequently, the primary barrier to trustworthy deployment is not further improving model capability but establishing system-level threat monitoring mechanisms that can detect and contextualize security-relevant anomalies after deployment -- an aspect largely underexplored beyond testing or guardrail-based defenses. Accordingly, this position paper advocates systematic and comprehensive monitoring of security threats in LLM-enabled applications as a prerequisite for reliable operation and a foundation for dedicated incident-response frameworks."},{"descriptionType":"Other","description":"26 pages"}],"geoLocations":[],"fundingReferences":[],"url":"https://arxiv.org/abs/2602.19844","contentUrl":null,"metadataVersion":0,"schemaVersion":"http://datacite.org/schema/kernel-4","source":"mds","isActive":true,"state":"findable","reason":null,"viewCount":0,"downloadCount":0,"referenceCount":0,"citationCount":0,"partCount":0,"partOfCount":0,"versionCount":0,"versionOfCount":0,"created":"2026-02-25T15:17:21Z","registered":"2026-02-25T15:17:22Z","published":null,"updated":"2026-02-25T15:17:22Z"},"relationships":{"client":{"data":{"id":"arxiv.content","type":"clients"}}}},{"id":"10.48550/arxiv.2602.19843","type":"dois","attributes":{"doi":"10.48550/arxiv.2602.19843","identifiers":[{"identifier":"2602.19843","identifierType":"arXiv"}],"creators":[{"nameType":"Personal","givenName":"Jin","familyName":"Jia","name":"Jia, Jin","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Zhiling","familyName":"Deng","name":"Deng, Zhiling","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Zhuangbin","familyName":"Chen","name":"Chen, Zhuangbin","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Yingqi","familyName":"Wang","name":"Wang, Yingqi","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Zibin","familyName":"Zheng","name":"Zheng, Zibin","affiliation":[],"nameIdentifiers":[]}],"titles":[{"title":"MAS-FIRE: Fault Injection and Reliability Evaluation for LLM-Based Multi-Agent Systems"}],"publisher":"arXiv","container":{},"publicationYear":2026,"subjects":[{"subject":"Software Engineering (cs.SE)","lang":"en","subjectScheme":"arXiv"},{"subject":"Artificial Intelligence (cs.AI)","lang":"en","subjectScheme":"arXiv"},{"subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"},{"schemeUri":"http://www.oecd.org/science/inno/38235147.pdf","subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"}],"contributors":[],"dates":[{"date":"2026-02-23T13:47:43Z","dateType":"Submitted","dateInformation":"v1"},{"date":"2026-02-24T02:28:28Z","dateType":"Updated","dateInformation":"v1"},{"date":"2026-02","dateType":"Available","dateInformation":"v1"},{"date":"2026","dateType":"Issued"}],"language":null,"types":{"schemaOrg":"CreativeWork","resourceTypeGeneral":"Preprint","citeproc":"article","bibtex":"misc","ris":"GEN","resourceType":"Article"},"relatedIdentifiers":[],"relatedItems":[],"sizes":[],"formats":[],"version":"1","rightsList":[{"rightsIdentifierScheme":"SPDX","rightsUri":"https://creativecommons.org/licenses/by-nc-nd/4.0/legalcode","schemeUri":"https://spdx.org/licenses/","rights":"Creative Commons Attribution Non Commercial No Derivatives 4.0 International","rightsIdentifier":"cc-by-nc-nd-4.0"}],"descriptions":[{"descriptionType":"Abstract","description":"As LLM-based Multi-Agent Systems (MAS) are increasingly deployed for complex tasks, ensuring their reliability has become a pressing challenge. Since MAS coordinate through unstructured natural language rather than rigid protocols, they are prone to semantic failures (e.g., hallucinations, misinterpreted instructions, and reasoning drift) that propagate silently without raising runtime exceptions. Prevailing evaluation approaches, which measure only end-to-end task success, offer limited insight into how these failures arise or how effectively agents recover from them. To bridge this gap, we propose MAS-FIRE, a systematic framework for fault injection and reliability evaluation of MAS. We define a taxonomy of 15 fault types covering intra-agent cognitive errors and inter-agent coordination failures, and inject them via three non-invasive mechanisms: prompt modification, response rewriting, and message routing manipulation. Applying MAS-FIRE to three representative MAS architectures, we uncover a rich set of fault-tolerant behaviors that we organize into four tiers: mechanism, rule, prompt, and reasoning. This tiered view enables fine-grained diagnosis of where and why systems succeed or fail. Our findings reveal that stronger foundation models do not uniformly improve robustness. We further show that architectural topology plays an equally decisive role, with iterative, closed-loop designs neutralizing over 40% of faults that cause catastrophic collapse in linear workflows. MAS-FIRE provides the process-level observability and actionable guidance needed to systematically improve multi-agent systems."}],"geoLocations":[],"fundingReferences":[],"url":"https://arxiv.org/abs/2602.19843","contentUrl":null,"metadataVersion":0,"schemaVersion":"http://datacite.org/schema/kernel-4","source":"mds","isActive":true,"state":"findable","reason":null,"viewCount":0,"downloadCount":0,"referenceCount":0,"citationCount":0,"partCount":0,"partOfCount":0,"versionCount":0,"versionOfCount":0,"created":"2026-02-25T15:17:18Z","registered":"2026-02-25T15:17:19Z","published":null,"updated":"2026-02-25T15:17:19Z"},"relationships":{"client":{"data":{"id":"arxiv.content","type":"clients"}}}},{"id":"10.48550/arxiv.2602.19842","type":"dois","attributes":{"doi":"10.48550/arxiv.2602.19842","identifiers":[{"identifier":"2602.19842","identifierType":"arXiv"}],"creators":[{"nameType":"Personal","givenName":"A.","familyName":"Denner","name":"Denner, A.","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"D.","familyName":"Lombardi","name":"Lombardi, D.","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"S. Lopez Portillo","familyName":"Chavez","name":"Chavez, S. Lopez Portillo","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"M.","familyName":"Pellen","name":"Pellen, M.","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"G.","familyName":"Pelliccioli","name":"Pelliccioli, G.","affiliation":[],"nameIdentifiers":[]}],"titles":[{"title":"MoCaNLO: a Monte Carlo integrator for NLO calculations"}],"publisher":"arXiv","container":{},"publicationYear":2026,"subjects":[{"subject":"High Energy Physics - Phenomenology (hep-ph)","lang":"en","subjectScheme":"arXiv"},{"subject":"High Energy Physics - Experiment (hep-ex)","lang":"en","subjectScheme":"arXiv"},{"subject":"FOS: Physical sciences","subjectScheme":"Fields of Science and Technology (FOS)"},{"schemeUri":"http://www.oecd.org/science/inno/38235147.pdf","subject":"FOS: Physical sciences","subjectScheme":"Fields of Science and Technology (FOS)"}],"contributors":[],"dates":[{"date":"2026-02-23T13:46:52Z","dateType":"Submitted","dateInformation":"v1"},{"date":"2026-02-24T02:28:23Z","dateType":"Updated","dateInformation":"v1"},{"date":"2026-02","dateType":"Available","dateInformation":"v1"},{"date":"2026","dateType":"Issued"}],"language":null,"types":{"schemaOrg":"CreativeWork","resourceTypeGeneral":"Preprint","citeproc":"article","bibtex":"misc","ris":"GEN","resourceType":"Article"},"relatedIdentifiers":[],"relatedItems":[],"sizes":[],"formats":[],"version":"1","rightsList":[{"rightsUri":"http://arxiv.org/licenses/nonexclusive-distrib/1.0/","rights":"arXiv.org perpetual, non-exclusive license"}],"descriptions":[{"descriptionType":"Abstract","description":"We present the Monte Carlo integration code MoCaNLO, which computes cross sections and distributions for processes at high-energy colliders like the LHC at leading and next-to-leading order (NLO) in the strong and electroweak couplings. It relies on the Recola package for the calculation of matrix elements and uses Catani-Seymour dipole subtraction for the treatment of infrared singularities. It has been used for several cutting-edge calculations of NLO QCD and electroweak corrections over the last years, such as NLO QCD corrections to off-shell top-antitop-quark production in association with a pair of bottom quarks and NLO electroweak corrections to vector-boson scattering processes."},{"descriptionType":"Other","description":"93 pages, code available at https://mocanlo.gitlab.io"}],"geoLocations":[],"fundingReferences":[],"url":"https://arxiv.org/abs/2602.19842","contentUrl":null,"metadataVersion":0,"schemaVersion":"http://datacite.org/schema/kernel-4","source":"mds","isActive":true,"state":"findable","reason":null,"viewCount":0,"downloadCount":0,"referenceCount":0,"citationCount":0,"partCount":0,"partOfCount":0,"versionCount":0,"versionOfCount":0,"created":"2026-02-25T15:17:16Z","registered":"2026-02-25T15:17:17Z","published":null,"updated":"2026-02-25T15:17:17Z"},"relationships":{"client":{"data":{"id":"arxiv.content","type":"clients"}}}},{"id":"10.48550/arxiv.2602.19841","type":"dois","attributes":{"doi":"10.48550/arxiv.2602.19841","identifiers":[{"identifier":"2602.19841","identifierType":"arXiv"}],"creators":[{"nameType":"Personal","givenName":"Krishna","familyName":"Neupane","name":"Neupane, Krishna","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Igor","familyName":"Griva","name":"Griva, Igor","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Robert","familyName":"Axtell","name":"Axtell, Robert","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"William","familyName":"Kennedy","name":"Kennedy, William","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Jason","familyName":"Kinser","name":"Kinser, Jason","affiliation":[],"nameIdentifiers":[]}],"titles":[{"title":"Detecting and Explaining Unlawful Insider Trading: A Shapley Value and Causal Forest Approach to Identifying Key Drivers and Causal Relationships"}],"publisher":"arXiv","container":{},"publicationYear":2026,"subjects":[{"subject":"Statistical Finance (q-fin.ST)","lang":"en","subjectScheme":"arXiv"},{"subject":"FOS: Economics and business","subjectScheme":"Fields of Science and Technology (FOS)"},{"schemeUri":"http://www.oecd.org/science/inno/38235147.pdf","subject":"FOS: Economics and business","subjectScheme":"Fields of Science and Technology (FOS)"}],"contributors":[],"dates":[{"date":"2026-02-23T13:40:47Z","dateType":"Submitted","dateInformation":"v1"},{"date":"2026-02-24T02:28:02Z","dateType":"Updated","dateInformation":"v1"},{"date":"2026-02","dateType":"Available","dateInformation":"v1"},{"date":"2026","dateType":"Issued"}],"language":null,"types":{"schemaOrg":"CreativeWork","resourceTypeGeneral":"Preprint","citeproc":"article","bibtex":"misc","ris":"GEN","resourceType":"Article"},"relatedIdentifiers":[],"relatedItems":[],"sizes":[],"formats":[],"version":"1","rightsList":[{"rightsIdentifierScheme":"SPDX","rightsUri":"https://creativecommons.org/licenses/by/4.0/legalcode","schemeUri":"https://spdx.org/licenses/","rights":"Creative Commons Attribution 4.0 International","rightsIdentifier":"cc-by-4.0"}],"descriptions":[{"descriptionType":"Abstract","description":"Corporate insiders trade for diverse reasons, often possessing Material Non-Public Information (MNPI). Determining whether specific trades leverage MNPI is a significant challenge due to inherent complexity. This study focuses on two critical objectives: accurately detecting Unlawful Insider Trading (UIT) and identifying key features explaining classification. The analysis demonstrates how combining Shapley Values (SHAP) and Causal Forest (CF) reveals these explanatory drivers.\n The findings underscore the necessity of causality in identifying and interpreting UIT, requiring the consideration of alternative scenarios and potential outcomes. Within a high-dimensional feature space, the proposed architecture integrates state-of-the-art techniques to achieve high classification accuracy. The framework provides robust feature rankings via SHAP and causal significance assessments through CF, facilitating the discovery of unique causal relationships.\n Statistically significant relationships are documented between the outcome and several key features, including director status, price-to-book ratio, return, and market beta. These features significantly influence the likelihood of UIT, suggesting potential links between insider behavior and factors such as information asymmetry, valuation risk, market volatility, and stock performance. The analysis draws attention to the complexities of financial causality, noting that while initial descriptors offer intuitive insights, deeper examination is required to understand nuanced impacts. These findings reaffirm the architectural flexibility of decision tree models. By incorporating heterogeneity during tree construction, these models effectively uncover latent structures within trade, finance, and governance data, characterizing fraudulent behavior while maintaining reliable results."}],"geoLocations":[],"fundingReferences":[],"url":"https://arxiv.org/abs/2602.19841","contentUrl":null,"metadataVersion":0,"schemaVersion":"http://datacite.org/schema/kernel-4","source":"mds","isActive":true,"state":"findable","reason":null,"viewCount":0,"downloadCount":0,"referenceCount":0,"citationCount":0,"partCount":0,"partOfCount":0,"versionCount":0,"versionOfCount":0,"created":"2026-02-25T15:17:13Z","registered":"2026-02-25T15:17:14Z","published":null,"updated":"2026-02-25T15:17:14Z"},"relationships":{"client":{"data":{"id":"arxiv.content","type":"clients"}}}},{"id":"10.48550/arxiv.2602.19840","type":"dois","attributes":{"doi":"10.48550/arxiv.2602.19840","identifiers":[{"identifier":"2602.19840","identifierType":"arXiv"}],"creators":[{"nameType":"Personal","givenName":"Jingzhuo","familyName":"Wu","name":"Wu, Jingzhuo","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Jiajun","familyName":"Zhang","name":"Zhang, Jiajun","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Keyan","familyName":"Jin","name":"Jin, Keyan","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Dehua","familyName":"Ma","name":"Ma, Dehua","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Junbo","familyName":"Wang","name":"Wang, Junbo","affiliation":[],"nameIdentifiers":[]}],"titles":[{"title":"SAMAS: A Spectrum-Guided Multi-Agent System for Achieving Style Fidelity in Literary Translation"}],"publisher":"arXiv","container":{},"publicationYear":2026,"subjects":[{"subject":"Computation and Language (cs.CL)","lang":"en","subjectScheme":"arXiv"},{"subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"},{"schemeUri":"http://www.oecd.org/science/inno/38235147.pdf","subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"}],"contributors":[],"dates":[{"date":"2026-02-23T13:40:44Z","dateType":"Submitted","dateInformation":"v1"},{"date":"2026-02-24T02:28:01Z","dateType":"Updated","dateInformation":"v1"},{"date":"2026-02","dateType":"Available","dateInformation":"v1"},{"date":"2026","dateType":"Issued"}],"language":null,"types":{"schemaOrg":"CreativeWork","resourceTypeGeneral":"Preprint","citeproc":"article","bibtex":"misc","ris":"GEN","resourceType":"Article"},"relatedIdentifiers":[],"relatedItems":[],"sizes":[],"formats":[],"version":"1","rightsList":[{"rightsUri":"http://arxiv.org/licenses/nonexclusive-distrib/1.0/","rights":"arXiv.org perpetual, non-exclusive license"}],"descriptions":[{"descriptionType":"Abstract","description":"Modern large language models (LLMs) excel at generating fluent and faithful translations. However, they struggle to preserve an author's unique literary style, often producing semantically correct but generic outputs. This limitation stems from the inability of current single-model and static multi-agent systems to perceive and adapt to stylistic variations. To address this, we introduce the Style-Adaptive Multi-Agent System (SAMAS), a novel framework that treats style preservation as a signal processing task. Specifically, our method quantifies literary style into a Stylistic Feature Spectrum (SFS) using the wavelet packet transform. This SFS serves as a control signal to dynamically assemble a tailored workflow of specialized translation agents based on the source text's structural patterns. Extensive experiments on translation benchmarks show that SAMAS achieves competitive semantic accuracy against strong baselines, primarily by leveraging its statistically significant advantage in style fidelity."}],"geoLocations":[],"fundingReferences":[],"url":"https://arxiv.org/abs/2602.19840","contentUrl":null,"metadataVersion":0,"schemaVersion":"http://datacite.org/schema/kernel-4","source":"mds","isActive":true,"state":"findable","reason":null,"viewCount":0,"downloadCount":0,"referenceCount":0,"citationCount":0,"partCount":0,"partOfCount":0,"versionCount":0,"versionOfCount":0,"created":"2026-02-25T15:17:11Z","registered":"2026-02-25T15:17:11Z","published":null,"updated":"2026-02-25T15:17:11Z"},"relationships":{"client":{"data":{"id":"arxiv.content","type":"clients"}}}},{"id":"10.48550/arxiv.2602.19838","type":"dois","attributes":{"doi":"10.48550/arxiv.2602.19838","identifiers":[{"identifier":"2602.19838","identifierType":"arXiv"}],"creators":[{"nameType":"Personal","givenName":"Kensuke","familyName":"Okada","name":"Okada, Kensuke","affiliation":[],"nameIdentifiers":[]}],"titles":[{"title":"Optimality of the Half-Order Exponent in the Turing-Good Identities for Bayes Factors"}],"publisher":"arXiv","container":{},"publicationYear":2026,"subjects":[{"subject":"Methodology (stat.ME)","lang":"en","subjectScheme":"arXiv"},{"subject":"Statistics Theory (math.ST)","lang":"en","subjectScheme":"arXiv"},{"subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"},{"schemeUri":"http://www.oecd.org/science/inno/38235147.pdf","subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"},{"subject":"FOS: Mathematics","subjectScheme":"Fields of Science and Technology (FOS)"},{"schemeUri":"http://www.oecd.org/science/inno/38235147.pdf","subject":"FOS: Mathematics","subjectScheme":"Fields of Science and Technology (FOS)"}],"contributors":[],"dates":[{"date":"2026-02-23T13:40:28Z","dateType":"Submitted","dateInformation":"v1"},{"date":"2026-02-24T02:27:59Z","dateType":"Updated","dateInformation":"v1"},{"date":"2026-02","dateType":"Available","dateInformation":"v1"},{"date":"2026","dateType":"Issued"}],"language":null,"types":{"schemaOrg":"CreativeWork","resourceTypeGeneral":"Preprint","citeproc":"article","bibtex":"misc","ris":"GEN","resourceType":"Article"},"relatedIdentifiers":[],"relatedItems":[],"sizes":[],"formats":[],"version":"1","rightsList":[{"rightsUri":"http://arxiv.org/licenses/nonexclusive-distrib/1.0/","rights":"arXiv.org perpetual, non-exclusive license"}],"descriptions":[{"descriptionType":"Abstract","description":"Bayes factors are widely computed by Monte Carlo, yet heavy-tailed sampling distributions can make numerical validation unreliable. The Turing--Good identities provide exact moment equalities for powers of a Bayes factor (a density ratio). When these identities are used as Good-check diagnostics, the power choice becomes a statistical design parameter. We develop a nonasymptotic variance theory for Monte Carlo evaluation of the identities and show that the half-order (square-root) power is uniquely minimax-stable: it equalizes variability across the two model orientations and is the only choice that guarantees finite second moments in a distribution-free worst-case sense over all mutually absolutely continuous model pairs. This yields a balanced two-sample half-order diagnostic that is symmetric in model labeling and has a uniform variance bound at fixed computational budget; in small-overlap regimes it is guaranteed to be no less efficient than the standard one-sided Turing check. Simulations for binomial Bayes factor workflows illustrate stable finite-sample behavior and sensitivity to simulator--evaluator mismatches. We further connect the half-order overlap viewpoint to stable primitives for normalizing-constant ratios and importance-sampling degeneracy summaries."}],"geoLocations":[],"fundingReferences":[],"url":"https://arxiv.org/abs/2602.19838","contentUrl":null,"metadataVersion":0,"schemaVersion":"http://datacite.org/schema/kernel-4","source":"mds","isActive":true,"state":"findable","reason":null,"viewCount":0,"downloadCount":0,"referenceCount":0,"citationCount":0,"partCount":0,"partOfCount":0,"versionCount":0,"versionOfCount":0,"created":"2026-02-25T15:17:05Z","registered":"2026-02-25T15:17:06Z","published":null,"updated":"2026-02-25T15:17:06Z"},"relationships":{"client":{"data":{"id":"arxiv.content","type":"clients"}}}},{"id":"10.48550/arxiv.2602.19836","type":"dois","attributes":{"doi":"10.48550/arxiv.2602.19836","identifiers":[{"identifier":"2602.19836","identifierType":"arXiv"}],"creators":[{"nameType":"Personal","givenName":"S. M.","familyName":"Perriyil","name":"Perriyil, S. M.","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"S. S.","familyName":"Sadangaya","name":"Sadangaya, S. S.","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"C. G. Giménez","familyName":"de Castro","name":"de Castro, C. G. Giménez","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"P. J. A.","familyName":"Simões","name":"Simões, P. J. A.","affiliation":[],"nameIdentifiers":[]}],"titles":[{"title":"Observational Evidence Linking Loop Length and Thermal-Nonthermal Peak Timing in Solar Flares"}],"publisher":"arXiv","container":{},"publicationYear":2026,"subjects":[{"subject":"Solar and Stellar Astrophysics (astro-ph.SR)","lang":"en","subjectScheme":"arXiv"},{"subject":"FOS: Physical sciences","subjectScheme":"Fields of Science and Technology (FOS)"},{"schemeUri":"http://www.oecd.org/science/inno/38235147.pdf","subject":"FOS: Physical sciences","subjectScheme":"Fields of Science and Technology (FOS)"}],"contributors":[],"dates":[{"date":"2026-02-23T13:39:32Z","dateType":"Submitted","dateInformation":"v1"},{"date":"2026-02-24T02:27:57Z","dateType":"Updated","dateInformation":"v1"},{"date":"2026-02","dateType":"Available","dateInformation":"v1"},{"date":"2026","dateType":"Issued"}],"language":null,"types":{"schemaOrg":"CreativeWork","resourceTypeGeneral":"Preprint","citeproc":"article","bibtex":"misc","ris":"GEN","resourceType":"Article"},"relatedIdentifiers":[{"relationType":"IsVersionOf","relatedIdentifier":"10.3847/1538-4357/ae3061","relatedIdentifierType":"DOI"}],"relatedItems":[],"sizes":[],"formats":[],"version":"1","rightsList":[{"rightsIdentifierScheme":"SPDX","rightsUri":"https://creativecommons.org/licenses/by/4.0/legalcode","schemeUri":"https://spdx.org/licenses/","rights":"Creative Commons Attribution 4.0 International","rightsIdentifier":"cc-by-4.0"}],"descriptions":[{"descriptionType":"Abstract","description":"We investigate how the magnetic loop length of solar flares relates to the timing between their thermal and nonthermal emission signatures. Our study analyzes a sample of 96 C-, M-, and X-class flares observed between 2013 and 2015 with soft X-rays, hard X-rays, and extreme UV. For each event, we determine the time delay Δt between the hard X-ray and soft X-ray peak, and estimate the flare loop length L from UV footpoints assuming a semicircular geometry. In every case, longer flare loops are consistently associated with larger timing delays. Across the full sample, we find a strong correlation, R = 0.88 between L and Δt. We also quantify how closely each flare follows the Neupert effect using a coefficient RN, defined as the Pearson correlation between the time derivative of the soft X-ray flux and the hard X-ray light curve. Applying correlation thresholds of RN \u0026gt; 0.5 and RN \u0026gt; 0.8 yields subsets of 87 and 46 events, respectively. In both cases, the linear relationship between loop length and peak delay remains clearly expressed. For the RN \u0026gt; 0.5 subset, the correlation is R = 0.87, while the more selective subset with RN \u0026gt; 0.8 displays an even stronger correlation of R = 0.91. These results show that the overall trend persists across increasingly stringent correlation thresholds. The results provide direct observational confirmation that magnetic loop geometry plays a key role in governing the temporal evolution of energy transport in solar flares."},{"descriptionType":"Other","description":"7 pages, 6 figures, 1 table"}],"geoLocations":[],"fundingReferences":[],"url":"https://arxiv.org/abs/2602.19836","contentUrl":null,"metadataVersion":0,"schemaVersion":"http://datacite.org/schema/kernel-4","source":"mds","isActive":true,"state":"findable","reason":null,"viewCount":0,"downloadCount":0,"referenceCount":0,"citationCount":0,"partCount":0,"partOfCount":0,"versionCount":0,"versionOfCount":1,"created":"2026-02-25T15:17:00Z","registered":"2026-02-25T15:17:01Z","published":null,"updated":"2026-02-25T15:17:01Z"},"relationships":{"client":{"data":{"id":"arxiv.content","type":"clients"}}}},{"id":"10.48550/arxiv.2602.19834","type":"dois","attributes":{"doi":"10.48550/arxiv.2602.19834","identifiers":[{"identifier":"2602.19834","identifierType":"arXiv"}],"creators":[{"nameType":"Personal","givenName":"Gero","familyName":"Ellmies","name":"Ellmies, Gero","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Till","familyName":"Fluschnik","name":"Fluschnik, Till","affiliation":[],"nameIdentifiers":[]}],"titles":[{"title":"Placing Green Bridges Optimally for Robust Habitat Reconnection"}],"publisher":"arXiv","container":{},"publicationYear":2026,"subjects":[{"subject":"Data Structures and Algorithms (cs.DS)","lang":"en","subjectScheme":"arXiv"},{"subject":"Discrete Mathematics (cs.DM)","lang":"en","subjectScheme":"arXiv"},{"subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"},{"schemeUri":"http://www.oecd.org/science/inno/38235147.pdf","subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"}],"contributors":[],"dates":[{"date":"2026-02-23T13:33:12Z","dateType":"Submitted","dateInformation":"v1"},{"date":"2026-02-24T02:27:45Z","dateType":"Updated","dateInformation":"v1"},{"date":"2026-02","dateType":"Available","dateInformation":"v1"},{"date":"2026","dateType":"Issued"}],"language":null,"types":{"schemaOrg":"CreativeWork","resourceTypeGeneral":"Preprint","citeproc":"article","bibtex":"misc","ris":"GEN","resourceType":"Article"},"relatedIdentifiers":[],"relatedItems":[],"sizes":[],"formats":[],"version":"1","rightsList":[{"rightsUri":"http://arxiv.org/licenses/nonexclusive-distrib/1.0/","rights":"arXiv.org perpetual, non-exclusive license"}],"descriptions":[{"descriptionType":"Abstract","description":"We study the problem of robustly reconnecting habitats via the placement of green bridges at minimum total cost. Habitats are fragmented into patches and we seek to reconnect each habitat such that it remains connected even if any of its patches becomes unavailable. Formally, we are given an undirected graph with edge costs, a set of fixed green bridges represented as a subset of the graph's edges, a set of habitats represented as vertex subsets, and some budget. We decide whether there exists a subset of the graph's edges containing all fixed green bridges such that, for each habitat, the induced subgraph on the solution edges is 2-vertex-connected, and the total cost does not exceed the budget. We also study the 2-edge-connectivity variant, modeling the case where any single reconnecting green bridge may fail. We analyze the computational complexity of these problems, focusing on the boundary between NP-hardness and polynomial-time solvability when the maximum habitat size and maximum vertex degree are bounded by constants. We prove that for each constant maximum habitat size of at least four there exists a small constant maximum degree for which the problems are NP-hard, and complement this with polynomial-time algorithms yielding partial dichotomies for bounded habitat size and degree."}],"geoLocations":[],"fundingReferences":[],"url":"https://arxiv.org/abs/2602.19834","contentUrl":null,"metadataVersion":0,"schemaVersion":"http://datacite.org/schema/kernel-4","source":"mds","isActive":true,"state":"findable","reason":null,"viewCount":0,"downloadCount":0,"referenceCount":0,"citationCount":0,"partCount":0,"partOfCount":0,"versionCount":0,"versionOfCount":0,"created":"2026-02-25T15:16:56Z","registered":"2026-02-25T15:16:56Z","published":null,"updated":"2026-02-25T15:16:56Z"},"relationships":{"client":{"data":{"id":"arxiv.content","type":"clients"}}}},{"id":"10.48550/arxiv.2602.19833","type":"dois","attributes":{"doi":"10.48550/arxiv.2602.19833","identifiers":[{"identifier":"2602.19833","identifierType":"arXiv"}],"creators":[{"nameType":"Personal","givenName":"Davide","familyName":"Batic","name":"Batic, Davide","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Denys","familyName":"Dutykh","name":"Dutykh, Denys","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Fabio","familyName":"Scardigli","name":"Scardigli, Fabio","affiliation":[],"nameIdentifiers":[]}],"titles":[{"title":"Spectral Analysis of Quasinormal Modes of Planck Stars"}],"publisher":"arXiv","container":{},"publicationYear":2026,"subjects":[{"subject":"General Relativity and Quantum Cosmology (gr-qc)","lang":"en","subjectScheme":"arXiv"},{"subject":"High Energy Physics - Theory (hep-th)","lang":"en","subjectScheme":"arXiv"},{"subject":"FOS: Physical sciences","subjectScheme":"Fields of Science and Technology (FOS)"},{"schemeUri":"http://www.oecd.org/science/inno/38235147.pdf","subject":"FOS: Physical sciences","subjectScheme":"Fields of Science and Technology (FOS)"}],"contributors":[],"dates":[{"date":"2026-02-23T13:31:29Z","dateType":"Submitted","dateInformation":"v1"},{"date":"2026-02-24T02:27:41Z","dateType":"Updated","dateInformation":"v1"},{"date":"2026-02","dateType":"Available","dateInformation":"v1"},{"date":"2026","dateType":"Issued"}],"language":null,"types":{"schemaOrg":"CreativeWork","resourceTypeGeneral":"Preprint","citeproc":"article","bibtex":"misc","ris":"GEN","resourceType":"Article"},"relatedIdentifiers":[{"relationType":"IsVersionOf","relatedIdentifier":"10.1140/epjc/s10052-026-15430-8","relatedIdentifierType":"DOI"}],"relatedItems":[],"sizes":[],"formats":[],"version":"1","rightsList":[{"rightsIdentifierScheme":"SPDX","rightsUri":"https://creativecommons.org/licenses/by/4.0/legalcode","schemeUri":"https://spdx.org/licenses/","rights":"Creative Commons Attribution 4.0 International","rightsIdentifier":"cc-by-4.0"}],"descriptions":[{"descriptionType":"Abstract","description":"We investigate the quasinormal modes (QNMs) of Planck stars within the framework of scale-dependent gravity (SDG). In our setup, the running parameter $α$ is fixed to a negative value by matching the effective Newtonian potential to the one-loop EFT result. As a consequence, the associated running Newton coupling does not realise the ultraviolet fixed point of asymptotically safe gravity, and the geometry should be interpreted as an SDG-inspired effective metric rather than a realisation of asymptotically safe gravity itself. We focus on the resulting renormalisation-group-improved Schwarzschild metric, which naturally yields a finite-size Planck-density core. Building on this background, we compute the QNM spectrum for scalar, electromagnetic, and gravitational perturbations using the Spectral Method (SM). This approach, known for its superior accuracy over high-order WKB schemes, enables the detection of fundamental modes, large families of overtones, and purely imaginary overdamped modes that are entirely missed in previous analysis. Our results reveal a robust Martini glass morphology of the oscillatory spectrum across perturbation sectors, nearly equally spaced overdamped modes with characteristic anomalous gaps, and the emergence, in the gravitational sector, of isolated overdamped modes separated from the main sequence by exceptionally large frequency intervals. These features, resolved here for the first time in the Planck-star context, underscore the importance of high-precision spectral techniques in probing subtle signatures of quantum-gravity-inspired black hole models."},{"descriptionType":"Other","description":"24 pages, 4 figures"}],"geoLocations":[],"fundingReferences":[],"url":"https://arxiv.org/abs/2602.19833","contentUrl":null,"metadataVersion":0,"schemaVersion":"http://datacite.org/schema/kernel-4","source":"mds","isActive":true,"state":"findable","reason":null,"viewCount":0,"downloadCount":0,"referenceCount":0,"citationCount":0,"partCount":0,"partOfCount":0,"versionCount":0,"versionOfCount":1,"created":"2026-02-25T15:16:53Z","registered":"2026-02-25T15:16:54Z","published":null,"updated":"2026-02-25T15:16:54Z"},"relationships":{"client":{"data":{"id":"arxiv.content","type":"clients"}}}},{"id":"10.48550/arxiv.2602.19832","type":"dois","attributes":{"doi":"10.48550/arxiv.2602.19832","identifiers":[{"identifier":"2602.19832","identifierType":"arXiv"}],"creators":[{"nameType":"Personal","givenName":"Penghui","familyName":"Niu","name":"Niu, Penghui","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Taotao","familyName":"Cai","name":"Cai, Taotao","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Suqi","familyName":"Zhang","name":"Zhang, Suqi","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Junhua","familyName":"Gu","name":"Gu, Junhua","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Ping","familyName":"Zhang","name":"Zhang, Ping","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Qiqi","familyName":"Liu","name":"Liu, Qiqi","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Jianxin","familyName":"Li","name":"Li, Jianxin","affiliation":[],"nameIdentifiers":[]}],"titles":[{"title":"M3S-Net: Multimodal Feature Fusion Network Based on Multi-scale Data for Ultra-short-term PV Power Forecasting"}],"publisher":"arXiv","container":{},"publicationYear":2026,"subjects":[{"subject":"Computer Vision and Pattern Recognition (cs.CV)","lang":"en","subjectScheme":"arXiv"},{"subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"},{"schemeUri":"http://www.oecd.org/science/inno/38235147.pdf","subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"}],"contributors":[],"dates":[{"date":"2026-02-23T13:30:59Z","dateType":"Submitted","dateInformation":"v1"},{"date":"2026-02-24T02:27:39Z","dateType":"Updated","dateInformation":"v1"},{"date":"2026-02","dateType":"Available","dateInformation":"v1"},{"date":"2026","dateType":"Issued"}],"language":null,"types":{"schemaOrg":"CreativeWork","resourceTypeGeneral":"Preprint","citeproc":"article","bibtex":"misc","ris":"GEN","resourceType":"Article"},"relatedIdentifiers":[],"relatedItems":[],"sizes":[],"formats":[],"version":"1","rightsList":[{"rightsUri":"http://arxiv.org/licenses/nonexclusive-distrib/1.0/","rights":"arXiv.org perpetual, non-exclusive license"}],"descriptions":[{"descriptionType":"Abstract","description":"The inherent intermittency and high-frequency variability of solar irradiance, particularly during rapid cloud advection, present significant stability challenges to high-penetration photovoltaic grids. Although multimodal forecasting has emerged as a viable mitigation strategy, existing architectures predominantly rely on shallow feature concatenation and binary cloud segmentation, thereby failing to capture the fine-grained optical features of clouds and the complex spatiotemporal coupling between visual and meteorological modalities. To bridge this gap, this paper proposes M3S-Net, a novel multimodal feature fusion network based on multi-scale data for ultra-short-term PV power forecasting. First, a multi-scale partial channel selection network leverages partial convolutions to explicitly isolate the boundary features of optically thin clouds, effectively transcending the precision limitations of coarse-grained binary masking. Second, a multi-scale sequence to image analysis network employs Fast Fourier Transform (FFT)-based time-frequency representation to disentangle the complex periodicity of meteorological data across varying time horizons. Crucially, the model incorporates a cross-modal Mamba interaction module featuring a novel dynamic C-matrix swapping mechanism. By exchanging state-space parameters between visual and temporal streams, this design conditions the state evolution of one modality on the context of the other, enabling deep structural coupling with linear computational complexity, thus overcoming the limitations of shallow concatenation. Experimental validation on the newly constructed fine-grained PV power dataset demonstrates that M3S-Net achieves a mean absolute error reduction of 6.2% in 10-minute forecasts compared to state-of-the-art baselines. The dataset and source code will be available at https://github.com/she1110/FGPD."}],"geoLocations":[],"fundingReferences":[],"url":"https://arxiv.org/abs/2602.19832","contentUrl":null,"metadataVersion":0,"schemaVersion":"http://datacite.org/schema/kernel-4","source":"mds","isActive":true,"state":"findable","reason":null,"viewCount":0,"downloadCount":0,"referenceCount":0,"citationCount":0,"partCount":0,"partOfCount":0,"versionCount":0,"versionOfCount":0,"created":"2026-02-25T15:16:51Z","registered":"2026-02-25T15:16:52Z","published":null,"updated":"2026-02-25T15:16:52Z"},"relationships":{"client":{"data":{"id":"arxiv.content","type":"clients"}}}},{"id":"10.48550/arxiv.2602.19831","type":"dois","attributes":{"doi":"10.48550/arxiv.2602.19831","identifiers":[{"identifier":"2602.19831","identifierType":"arXiv"}],"creators":[{"nameType":"Personal","givenName":"Silvia Lucia","familyName":"Sanna","name":"Sanna, Silvia Lucia","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Davide","familyName":"Maiorca","name":"Maiorca, Davide","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Giorgio","familyName":"Giacinto","name":"Giacinto, Giorgio","affiliation":[],"nameIdentifiers":[]}],"titles":[{"title":"An Explainable Memory Forensics Approach for Malware Analysis"}],"publisher":"arXiv","container":{},"publicationYear":2026,"subjects":[{"subject":"Cryptography and Security (cs.CR)","lang":"en","subjectScheme":"arXiv"},{"subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"},{"schemeUri":"http://www.oecd.org/science/inno/38235147.pdf","subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"}],"contributors":[],"dates":[{"date":"2026-02-23T13:30:04Z","dateType":"Submitted","dateInformation":"v1"},{"date":"2026-02-24T02:27:35Z","dateType":"Updated","dateInformation":"v1"},{"date":"2026-02","dateType":"Available","dateInformation":"v1"},{"date":"2026","dateType":"Issued"}],"language":null,"types":{"schemaOrg":"CreativeWork","resourceTypeGeneral":"Preprint","citeproc":"article","bibtex":"misc","ris":"GEN","resourceType":"Article"},"relatedIdentifiers":[],"relatedItems":[],"sizes":[],"formats":[],"version":"1","rightsList":[{"rightsIdentifierScheme":"SPDX","rightsUri":"https://creativecommons.org/licenses/by/4.0/legalcode","schemeUri":"https://spdx.org/licenses/","rights":"Creative Commons Attribution 4.0 International","rightsIdentifier":"cc-by-4.0"}],"descriptions":[{"descriptionType":"Abstract","description":"Memory forensics is an effective methodology for analyzing living-off-the-land malware, including threats that employ evasion, obfuscation, anti-analysis, and steganographic techniques. By capturing volatile system state, memory analysis enables the recovery of transient artifacts such as decrypted payloads, executed commands, credentials, and cryptographic keys that are often inaccessible through static or traditional dynamic analysis. While several automated models have been proposed for malware detection from memory, their outputs typically lack interpretability, and memory analysis still relies heavily on expert-driven inspection of complex tool outputs, such as those produced by Volatility. In this paper, we propose an explainable, AI-assisted memory forensics approach that leverages general-purpose large language models (LLMs) to interpret memory analysis outputs in a human-readable form and to automatically extract meaningful Indicators of Compromise (IoCs), in some circumstances detecting more IoCs than current state-of-the-art tools. We apply the proposed methodology to both Windows and Android malware, comparing full RAM acquisition with target-process memory dumping and highlighting their complementary forensic value. Furthermore, we demonstrate how LLMs can support both expert and non-expert analysts by explaining analysis results, correlating artifacts, and justifying malware classifications. Finally, we show that a human-in-the-loop workflow, assisted by LLMs during kernel-assisted setup and analysis, improves reproducibility and reduces operational complexity, thereby reinforcing the practical applicability of AI-driven memory forensics for modern malware investigations."}],"geoLocations":[],"fundingReferences":[],"url":"https://arxiv.org/abs/2602.19831","contentUrl":null,"metadataVersion":0,"schemaVersion":"http://datacite.org/schema/kernel-4","source":"mds","isActive":true,"state":"findable","reason":null,"viewCount":0,"downloadCount":0,"referenceCount":0,"citationCount":0,"partCount":0,"partOfCount":0,"versionCount":0,"versionOfCount":0,"created":"2026-02-25T15:16:48Z","registered":"2026-02-25T15:16:49Z","published":null,"updated":"2026-02-25T15:16:49Z"},"relationships":{"client":{"data":{"id":"arxiv.content","type":"clients"}}}},{"id":"10.48550/arxiv.2602.19830","type":"dois","attributes":{"doi":"10.48550/arxiv.2602.19830","identifiers":[{"identifier":"2602.19830","identifierType":"arXiv"}],"creators":[{"nameType":"Personal","givenName":"Stephane","familyName":"Sanfilippo","name":"Sanfilippo, Stephane","affiliation":[],"nameIdentifiers":[]}],"titles":[{"title":"Superconducting Accelerator Magnets"}],"publisher":"arXiv","container":{},"publicationYear":2026,"subjects":[{"subject":"Accelerator Physics (physics.acc-ph)","lang":"en","subjectScheme":"arXiv"},{"subject":"FOS: Physical sciences","subjectScheme":"Fields of Science and Technology (FOS)"},{"schemeUri":"http://www.oecd.org/science/inno/38235147.pdf","subject":"FOS: Physical sciences","subjectScheme":"Fields of Science and Technology (FOS)"}],"contributors":[],"dates":[{"date":"2026-02-23T13:29:03Z","dateType":"Submitted","dateInformation":"v1"},{"date":"2026-02-24T02:27:29Z","dateType":"Updated","dateInformation":"v1"},{"date":"2026-02","dateType":"Available","dateInformation":"v1"},{"date":"2026","dateType":"Issued"}],"language":null,"types":{"schemaOrg":"CreativeWork","resourceTypeGeneral":"Preprint","citeproc":"article","bibtex":"misc","ris":"GEN","resourceType":"Article"},"relatedIdentifiers":[],"relatedItems":[],"sizes":[],"formats":[],"version":"1","rightsList":[{"rightsUri":"http://arxiv.org/licenses/nonexclusive-distrib/1.0/","rights":"arXiv.org perpetual, non-exclusive license"}],"descriptions":[{"descriptionType":"Abstract","description":"This course introduces key aspects of superconducting magnet technology in accelerators: basic principles, superconducting materials (NbTi, Nb$_3$Sn, ReBCO), wire and cable architectures, and fabrication methods. Compared to copper or permanent magnets, superconducting systems require cryogenics and complex protection schemes but enable superior performance. Core challenges - like flux pinning, magnetization effects, quench behavior, mechanical forces interception, power tests and magnetic measurements - are addressed through examples of magnets from PSI and CERN."},{"descriptionType":"Other","description":"35 pages, contribution to the CAS - CERN Accelerator School: Mechanical \u0026amp; Materials Engineering for Particle Accelerators and Detectors, 2-15 June 2024, Sint-Michielsgestel, Netherlands"}],"geoLocations":[],"fundingReferences":[],"url":"https://arxiv.org/abs/2602.19830","contentUrl":null,"metadataVersion":0,"schemaVersion":"http://datacite.org/schema/kernel-4","source":"mds","isActive":true,"state":"findable","reason":null,"viewCount":0,"downloadCount":0,"referenceCount":0,"citationCount":0,"partCount":0,"partOfCount":0,"versionCount":0,"versionOfCount":0,"created":"2026-02-25T15:16:46Z","registered":"2026-02-25T15:16:47Z","published":null,"updated":"2026-02-25T15:16:47Z"},"relationships":{"client":{"data":{"id":"arxiv.content","type":"clients"}}}},{"id":"10.48550/arxiv.2602.19829","type":"dois","attributes":{"doi":"10.48550/arxiv.2602.19829","identifiers":[{"identifier":"2602.19829","identifierType":"arXiv"}],"creators":[{"nameType":"Personal","givenName":"Efe","familyName":"Ilıcak","name":"Ilıcak, Efe","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Baris","familyName":"Imre","name":"Imre, Baris","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Chloé","familyName":"Najac","name":"Najac, Chloé","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Ruben van den","familyName":"Broek","name":"Broek, Ruben van den","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Beatrice","familyName":"Lena","name":"Lena, Beatrice","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Andrew","familyName":"Webb","name":"Webb, Andrew","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Marius","familyName":"Staring","name":"Staring, Marius","affiliation":[],"nameIdentifiers":[]}],"titles":[{"title":"Physics-Guided Dual-Domain Network with Attention-Based Fusion for Portable MRI Reconstruction"}],"publisher":"arXiv","container":{},"publicationYear":2026,"subjects":[{"subject":"Medical Physics (physics.med-ph)","lang":"en","subjectScheme":"arXiv"},{"subject":"FOS: Physical sciences","subjectScheme":"Fields of Science and Technology (FOS)"},{"schemeUri":"http://www.oecd.org/science/inno/38235147.pdf","subject":"FOS: Physical sciences","subjectScheme":"Fields of Science and Technology (FOS)"}],"contributors":[],"dates":[{"date":"2026-02-23T13:28:05Z","dateType":"Submitted","dateInformation":"v1"},{"date":"2026-02-24T02:27:25Z","dateType":"Updated","dateInformation":"v1"},{"date":"2026-02","dateType":"Available","dateInformation":"v1"},{"date":"2026","dateType":"Issued"}],"language":null,"types":{"schemaOrg":"CreativeWork","resourceTypeGeneral":"Preprint","citeproc":"article","bibtex":"misc","ris":"GEN","resourceType":"Article"},"relatedIdentifiers":[],"relatedItems":[],"sizes":[],"formats":[],"version":"1","rightsList":[{"rightsUri":"http://arxiv.org/licenses/nonexclusive-distrib/1.0/","rights":"arXiv.org perpetual, non-exclusive license"}],"descriptions":[{"descriptionType":"Abstract","description":"Portable low-field magnetic resonance imaging (MRI) systems have gained renewed interest owing to their cost effectiveness and point-of-care imaging capabilities. Yet, portable MRI systems suffer from relatively low signal-to-noise ratio and limited hardware capabilities. While previous works have proposed the use of deep learning based reconstruction methods to improve low-field image quality, these operated only in the image-domain. Unlike other imaging modalities, MRI directly acquires data in the Fourier-domain (k-space), and exploiting both k-space and image-domain information can improve reconstruction quality. Here, we introduce DUN-DD, a novel physics-guided 3D network for portable MRI reconstruction, with parallel dual-domain branches whose outputs are combined together via an attention-based fusion network. To demonstrate the performance of the proposed method, we present \\textit{in vivo} reconstructions obtained from both emulated datasets as well as images acquired with a 47mT Halbach-based portable MRI system. Our results show that DUN-DD outperforms state-of-the-art classical, data-driven, and physics-guided methods on both emulated and real portable MRI acquisitions."},{"descriptionType":"Other","description":"Accepted to 2026 IEEE International Symposium on Biomedical Imaging (ISBI). Copyright 2026 IEEE. Personal use of this material is permitted. Permission from IEEE must be obtained for all other uses"}],"geoLocations":[],"fundingReferences":[],"url":"https://arxiv.org/abs/2602.19829","contentUrl":null,"metadataVersion":0,"schemaVersion":"http://datacite.org/schema/kernel-4","source":"mds","isActive":true,"state":"findable","reason":null,"viewCount":0,"downloadCount":0,"referenceCount":0,"citationCount":0,"partCount":0,"partOfCount":0,"versionCount":0,"versionOfCount":0,"created":"2026-02-25T15:16:44Z","registered":"2026-02-25T15:16:44Z","published":null,"updated":"2026-02-25T15:16:44Z"},"relationships":{"client":{"data":{"id":"arxiv.content","type":"clients"}}}},{"id":"10.48550/arxiv.2602.19828","type":"dois","attributes":{"doi":"10.48550/arxiv.2602.19828","identifiers":[{"identifier":"2602.19828","identifierType":"arXiv"}],"creators":[{"nameType":"Personal","givenName":"Chenfan","familyName":"Qu","name":"Qu, Chenfan","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Yiwu","familyName":"Zhong","name":"Zhong, Yiwu","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Jian","familyName":"Liu","name":"Liu, Jian","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Xuekang","familyName":"Zhu","name":"Zhu, Xuekang","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Bohan","familyName":"Yu","name":"Yu, Bohan","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Lianwen","familyName":"Jin","name":"Jin, Lianwen","affiliation":[],"nameIdentifiers":[]}],"titles":[{"title":"TextShield-R1: Reinforced Reasoning for Tampered Text Detection"}],"publisher":"arXiv","container":{},"publicationYear":2026,"subjects":[{"subject":"Computer Vision and Pattern Recognition (cs.CV)","lang":"en","subjectScheme":"arXiv"},{"subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"},{"schemeUri":"http://www.oecd.org/science/inno/38235147.pdf","subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"}],"contributors":[],"dates":[{"date":"2026-02-23T13:26:18Z","dateType":"Submitted","dateInformation":"v1"},{"date":"2026-02-24T02:27:20Z","dateType":"Updated","dateInformation":"v1"},{"date":"2026-02","dateType":"Available","dateInformation":"v1"},{"date":"2026","dateType":"Issued"}],"language":null,"types":{"schemaOrg":"CreativeWork","resourceTypeGeneral":"Preprint","citeproc":"article","bibtex":"misc","ris":"GEN","resourceType":"Article"},"relatedIdentifiers":[],"relatedItems":[],"sizes":[],"formats":[],"version":"1","rightsList":[{"rightsUri":"http://arxiv.org/licenses/nonexclusive-distrib/1.0/","rights":"arXiv.org perpetual, non-exclusive license"}],"descriptions":[{"descriptionType":"Abstract","description":"The growing prevalence of tampered images poses serious security threats, highlighting the urgent need for reliable detection methods. Multimodal large language models (MLLMs) demonstrate strong potential in analyzing tampered images and generating interpretations. However, they still struggle with identifying micro-level artifacts, exhibit low accuracy in localizing tampered text regions, and heavily rely on expensive annotations for forgery interpretation. To this end, we introduce TextShield-R1, the first reinforcement learning based MLLM solution for tampered text detection and reasoning. Specifically, our approach introduces Forensic Continual Pre-training, an easy-to-hard curriculum that well prepares the MLLM for tampered text detection by harnessing the large-scale cheap data from natural image forensic and OCR tasks. During fine-tuning, we perform Group Relative Policy Optimization with novel reward functions to reduce annotation dependency and improve reasoning capabilities. At inference time, we enhance localization accuracy via OCR Rectification, a method that leverages the MLLM's strong text recognition abilities to refine its predictions. Furthermore, to support rigorous evaluation, we introduce the Text Forensics Reasoning (TFR) benchmark, comprising over 45k real and tampered images across 16 languages, 10 tampering techniques, and diverse domains. Rich reasoning-style annotations are included, allowing for comprehensive assessment. Our TFR benchmark simultaneously addresses seven major limitations of existing benchmarks and enables robust evaluation under cross-style, cross-method, and cross-language conditions. Extensive experiments demonstrate that TextShield-R1 significantly advances the state of the art in interpretable tampered text detection."},{"descriptionType":"Other","description":"AAAI 2026"}],"geoLocations":[],"fundingReferences":[],"url":"https://arxiv.org/abs/2602.19828","contentUrl":null,"metadataVersion":0,"schemaVersion":"http://datacite.org/schema/kernel-4","source":"mds","isActive":true,"state":"findable","reason":null,"viewCount":0,"downloadCount":0,"referenceCount":0,"citationCount":0,"partCount":0,"partOfCount":0,"versionCount":0,"versionOfCount":0,"created":"2026-02-25T15:16:41Z","registered":"2026-02-25T15:16:42Z","published":null,"updated":"2026-02-25T15:16:42Z"},"relationships":{"client":{"data":{"id":"arxiv.content","type":"clients"}}}},{"id":"10.48550/arxiv.2602.19827","type":"dois","attributes":{"doi":"10.48550/arxiv.2602.19827","identifiers":[{"identifier":"2602.19827","identifierType":"arXiv"}],"creators":[{"nameType":"Personal","affiliation":["LOMA"],"givenName":"Wenxiang","familyName":"Wang","name":"Wang, Wenxiang","nameIdentifiers":[]},{"nameType":"Personal","affiliation":["LOMA"],"givenName":"Jiaxing","familyName":"Wang","name":"Wang, Jiaxing","nameIdentifiers":[]},{"nameType":"Personal","affiliation":["LOMA"],"givenName":"Guotong","familyName":"Wang","name":"Wang, Guotong","nameIdentifiers":[]},{"nameType":"Personal","affiliation":["LOMA"],"givenName":"Zhichao","familyName":"Yan","name":"Yan, Zhichao","nameIdentifiers":[]},{"nameType":"Personal","affiliation":["LOMA"],"givenName":"Chenxiao","familyName":"Jiang","name":"Jiang, Chenxiao","nameIdentifiers":[]},{"nameType":"Personal","affiliation":["LOMA"],"givenName":"Siqin","familyName":"Zhou","name":"Zhou, Siqin","nameIdentifiers":[]},{"nameType":"Personal","affiliation":["LOMA"],"givenName":"Chuanli","familyName":"Yu","name":"Yu, Chuanli","nameIdentifiers":[]},{"nameType":"Personal","affiliation":["LOMA"],"givenName":"Jianhao","familyName":"Chen","name":"Chen, Jianhao","nameIdentifiers":[]},{"nameType":"Personal","affiliation":["LOMA"],"givenName":"Kun","familyName":"Zheng","name":"Zheng, Kun","nameIdentifiers":[]},{"nameType":"Personal","affiliation":["LOMA"],"givenName":"Thomas","familyName":"Salez","name":"Salez, Thomas","nameIdentifiers":[]},{"nameType":"Personal","givenName":"Xiaoding","familyName":"Wei","name":"Wei, Xiaoding","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Zhaohe","familyName":"Dai","name":"Dai, Zhaohe","affiliation":[],"nameIdentifiers":[]}],"titles":[{"title":"Suppressed Rupture of Thin Metal Films via van der Waals Epitaxy"}],"publisher":"arXiv","container":{},"publicationYear":2026,"subjects":[{"subject":"Soft Condensed Matter (cond-mat.soft)","lang":"en","subjectScheme":"arXiv"},{"subject":"Applied Physics (physics.app-ph)","lang":"en","subjectScheme":"arXiv"},{"subject":"FOS: Physical sciences","subjectScheme":"Fields of Science and Technology (FOS)"},{"schemeUri":"http://www.oecd.org/science/inno/38235147.pdf","subject":"FOS: Physical sciences","subjectScheme":"Fields of Science and Technology (FOS)"}],"contributors":[],"dates":[{"date":"2026-02-23T13:25:00Z","dateType":"Submitted","dateInformation":"v1"},{"date":"2026-02-24T04:23:09Z","dateType":"Updated","dateInformation":"v1"},{"date":"2026-02","dateType":"Available","dateInformation":"v1"},{"date":"2026","dateType":"Issued"}],"language":null,"types":{"schemaOrg":"CreativeWork","resourceTypeGeneral":"Preprint","citeproc":"article","bibtex":"misc","ris":"GEN","resourceType":"Article"},"relatedIdentifiers":[],"relatedItems":[],"sizes":[],"formats":[],"version":"1","rightsList":[{"rightsUri":"http://arxiv.org/licenses/nonexclusive-distrib/1.0/","rights":"arXiv.org perpetual, non-exclusive license"}],"descriptions":[{"descriptionType":"Abstract","description":"Ultrathin metal films exhibit liquid-like instabilities, rupturing via surface diffusion far below their melting points. This behavior constrains thermal budgets for advanced integrated circuits and emerging 2D-crystal devices. Here, we demonstrate that these instabilities can be fundamentally suppressed using graphene as a van der Waals (vdW) template. While conventional 20-nm-thick gold films break up into islands below 300 {\\textdegree}C, templated films not only remain stable but also become structurally refined after annealing above 600 {\\textdegree}C. This exceptional stability stems from a vdW-mediated crystallographic texture that reorganizes grain boundaries into a mechanically robust network. This mechanism significantly widens the processing window for nanoscale interconnects and enables high-temperature integration of metals with 2D-crystal technologies."}],"geoLocations":[],"fundingReferences":[],"url":"https://arxiv.org/abs/2602.19827","contentUrl":null,"metadataVersion":0,"schemaVersion":"http://datacite.org/schema/kernel-4","source":"mds","isActive":true,"state":"findable","reason":null,"viewCount":0,"downloadCount":0,"referenceCount":0,"citationCount":0,"partCount":0,"partOfCount":0,"versionCount":0,"versionOfCount":0,"created":"2026-02-25T15:16:39Z","registered":"2026-02-25T15:16:39Z","published":null,"updated":"2026-02-25T15:16:39Z"},"relationships":{"client":{"data":{"id":"arxiv.content","type":"clients"}}}},{"id":"10.48550/arxiv.2602.19823","type":"dois","attributes":{"doi":"10.48550/arxiv.2602.19823","identifiers":[{"identifier":"2602.19823","identifierType":"arXiv"}],"creators":[{"nameType":"Personal","givenName":"Keno","familyName":"Moenck","name":"Moenck, Keno","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Adrian Philip","familyName":"Florea","name":"Florea, Adrian Philip","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Julian","familyName":"Koch","name":"Koch, Julian","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Thorsten","familyName":"Schüppstuhl","name":"Schüppstuhl, Thorsten","affiliation":[],"nameIdentifiers":[]}],"titles":[{"title":"Open-vocabulary 3D scene perception in industrial environments"}],"publisher":"arXiv","container":{},"publicationYear":2026,"subjects":[{"subject":"Computer Vision and Pattern Recognition (cs.CV)","lang":"en","subjectScheme":"arXiv"},{"subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"},{"schemeUri":"http://www.oecd.org/science/inno/38235147.pdf","subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"}],"contributors":[],"dates":[{"date":"2026-02-23T13:22:51Z","dateType":"Submitted","dateInformation":"v1"},{"date":"2026-02-24T02:27:10Z","dateType":"Updated","dateInformation":"v1"},{"date":"2026-02","dateType":"Available","dateInformation":"v1"},{"date":"2026","dateType":"Issued"}],"language":null,"types":{"schemaOrg":"CreativeWork","resourceTypeGeneral":"Preprint","citeproc":"article","bibtex":"misc","ris":"GEN","resourceType":"Article"},"relatedIdentifiers":[],"relatedItems":[],"sizes":[],"formats":[],"version":"1","rightsList":[{"rightsIdentifierScheme":"SPDX","rightsUri":"https://creativecommons.org/licenses/by-nc-nd/4.0/legalcode","schemeUri":"https://spdx.org/licenses/","rights":"Creative Commons Attribution Non Commercial No Derivatives 4.0 International","rightsIdentifier":"cc-by-nc-nd-4.0"}],"descriptions":[{"descriptionType":"Abstract","description":"Autonomous vision applications in production, intralogistics, or manufacturing environments require perception capabilities beyond a small, fixed set of classes. Recent open-vocabulary methods, leveraging 2D Vision-Language Foundation Models (VLFMs), target this task but often rely on class-agnostic segmentation models pre-trained on non-industrial datasets (e.g., household scenes). In this work, we first demonstrate that such models fail to generalize, performing poorly on common industrial objects. Therefore, we propose a training-free, open-vocabulary 3D perception pipeline that overcomes this limitation. Instead of using a pre-trained model to generate instance proposals, our method simply generates masks by merging pre-computed superpoints based on their semantic features. Following, we evaluate the domain-adapted VLFM \"IndustrialCLIP\" on a representative 3D industrial workshop scene for open-vocabulary querying. Our qualitative results demonstrate successful segmentation of industrial objects."}],"geoLocations":[],"fundingReferences":[],"url":"https://arxiv.org/abs/2602.19823","contentUrl":null,"metadataVersion":0,"schemaVersion":"http://datacite.org/schema/kernel-4","source":"mds","isActive":true,"state":"findable","reason":null,"viewCount":0,"downloadCount":0,"referenceCount":0,"citationCount":0,"partCount":0,"partOfCount":0,"versionCount":0,"versionOfCount":0,"created":"2026-02-25T15:16:29Z","registered":"2026-02-25T15:16:30Z","published":null,"updated":"2026-02-25T15:16:30Z"},"relationships":{"client":{"data":{"id":"arxiv.content","type":"clients"}}}},{"id":"10.48550/arxiv.2602.19822","type":"dois","attributes":{"doi":"10.48550/arxiv.2602.19822","identifiers":[{"identifier":"2602.19822","identifierType":"arXiv"}],"creators":[{"nameType":"Personal","givenName":"Dongjing","familyName":"Shan","name":"Shan, Dongjing","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Yamei","familyName":"Luo","name":"Luo, Yamei","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Jiqing","familyName":"Xuan","name":"Xuan, Jiqing","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Lu","familyName":"Huang","name":"Huang, Lu","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Jin","familyName":"Li","name":"Li, Jin","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Mengchu","familyName":"Yang","name":"Yang, Mengchu","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Zeyu","familyName":"Chen","name":"Chen, Zeyu","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Fajin","familyName":"Lv","name":"Lv, Fajin","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Yong","familyName":"Tang","name":"Tang, Yong","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Chunxiang","familyName":"Zhang","name":"Zhang, Chunxiang","affiliation":[],"nameIdentifiers":[]}],"titles":[{"title":"Efficient endometrial carcinoma screening via cross-modal synthesis and gradient distillation"}],"publisher":"arXiv","container":{},"publicationYear":2026,"subjects":[{"subject":"Computer Vision and Pattern Recognition (cs.CV)","lang":"en","subjectScheme":"arXiv"},{"subject":"Artificial Intelligence (cs.AI)","lang":"en","subjectScheme":"arXiv"},{"subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"},{"schemeUri":"http://www.oecd.org/science/inno/38235147.pdf","subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"}],"contributors":[],"dates":[{"date":"2026-02-23T13:22:25Z","dateType":"Submitted","dateInformation":"v1"},{"date":"2026-02-24T02:27:09Z","dateType":"Updated","dateInformation":"v1"},{"date":"2026-02","dateType":"Available","dateInformation":"v1"},{"date":"2026","dateType":"Issued"}],"language":null,"types":{"schemaOrg":"CreativeWork","resourceTypeGeneral":"Preprint","citeproc":"article","bibtex":"misc","ris":"GEN","resourceType":"Article"},"relatedIdentifiers":[],"relatedItems":[],"sizes":[],"formats":[],"version":"1","rightsList":[{"rightsIdentifierScheme":"SPDX","rightsUri":"https://creativecommons.org/licenses/by-nc-nd/4.0/legalcode","schemeUri":"https://spdx.org/licenses/","rights":"Creative Commons Attribution Non Commercial No Derivatives 4.0 International","rightsIdentifier":"cc-by-nc-nd-4.0"}],"descriptions":[{"descriptionType":"Abstract","description":"Early detection of myometrial invasion is critical for the staging and life-saving management of endometrial carcinoma (EC), a prevalent global malignancy. Transvaginal ultrasound serves as the primary, accessible screening modality in resource-constrained primary care settings; however, its diagnostic reliability is severely hindered by low tissue contrast, high operator dependence, and a pronounced scarcity of positive pathological samples. Existing artificial intelligence solutions struggle to overcome this severe class imbalance and the subtle imaging features of invasion, particularly under the strict computational limits of primary care clinics. Here we present an automated, highly efficient two-stage deep learning framework that resolves both data and computational bottlenecks in EC screening. To mitigate pathological data scarcity, we develop a structure-guided cross-modal generation network that synthesizes diverse, high-fidelity ultrasound images from unpaired magnetic resonance imaging (MRI) data, strictly preserving clinically essential anatomical junctions. Furthermore, we introduce a lightweight screening network utilizing gradient distillation, which transfers discriminative knowledge from a high-capacity teacher model to dynamically guide sparse attention towards task-critical regions. Evaluated on a large, multicenter cohort of 7,951 participants, our model achieves a sensitivity of 99.5\\%, a specificity of 97.2\\%, and an area under the curve of 0.987 at a minimal computational cost (0.289 GFLOPs), substantially outperforming the average diagnostic accuracy of expert sonographers. Our approach demonstrates that combining cross-modal synthetic augmentation with knowledge-driven efficient modeling can democratize expert-level, real-time cancer screening for resource-constrained primary care settings."}],"geoLocations":[],"fundingReferences":[],"url":"https://arxiv.org/abs/2602.19822","contentUrl":null,"metadataVersion":0,"schemaVersion":"http://datacite.org/schema/kernel-4","source":"mds","isActive":true,"state":"findable","reason":null,"viewCount":0,"downloadCount":0,"referenceCount":0,"citationCount":0,"partCount":0,"partOfCount":0,"versionCount":0,"versionOfCount":0,"created":"2026-02-25T15:16:27Z","registered":"2026-02-25T15:16:27Z","published":null,"updated":"2026-02-25T15:16:27Z"},"relationships":{"client":{"data":{"id":"arxiv.content","type":"clients"}}}},{"id":"10.48550/arxiv.2602.19820","type":"dois","attributes":{"doi":"10.48550/arxiv.2602.19820","identifiers":[{"identifier":"2602.19820","identifierType":"arXiv"}],"creators":[{"nameType":"Personal","givenName":"Marica","familyName":"Licciardi","name":"Licciardi, Marica","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Aldo","familyName":"Ugolotti","name":"Ugolotti, Aldo","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Emilio","familyName":"Scalise","name":"Scalise, Emilio","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Leo","familyName":"Miglio","name":"Miglio, Leo","affiliation":[],"nameIdentifiers":[]}],"titles":[{"title":"Interface stability of beta-Ga2O3 (100) on oxidized Si- and C-terminated 3C-SiC (001) substrates: a first-principles investigation"}],"publisher":"arXiv","container":{},"publicationYear":2026,"subjects":[{"subject":"Materials Science (cond-mat.mtrl-sci)","lang":"en","subjectScheme":"arXiv"},{"subject":"FOS: Physical sciences","subjectScheme":"Fields of Science and Technology (FOS)"},{"schemeUri":"http://www.oecd.org/science/inno/38235147.pdf","subject":"FOS: Physical sciences","subjectScheme":"Fields of Science and Technology (FOS)"}],"contributors":[],"dates":[{"date":"2026-02-23T13:21:23Z","dateType":"Submitted","dateInformation":"v1"},{"date":"2026-02-24T02:27:07Z","dateType":"Updated","dateInformation":"v1"},{"date":"2026-02","dateType":"Available","dateInformation":"v1"},{"date":"2026","dateType":"Issued"}],"language":null,"types":{"schemaOrg":"CreativeWork","resourceTypeGeneral":"Preprint","citeproc":"article","bibtex":"misc","ris":"GEN","resourceType":"Article"},"relatedIdentifiers":[],"relatedItems":[],"sizes":[],"formats":[],"version":"1","rightsList":[{"rightsIdentifierScheme":"SPDX","rightsUri":"https://creativecommons.org/licenses/by/4.0/legalcode","schemeUri":"https://spdx.org/licenses/","rights":"Creative Commons Attribution 4.0 International","rightsIdentifier":"cc-by-4.0"}],"descriptions":[{"descriptionType":"Abstract","description":"We provide a first-principles modeling of the beta-Ga2O3/3C-SiC interface that takes into account the reconstructions occurring at the 3C-SiC (001) surface by oxidation, aiming to mimic the actual deposition process under the best structural and thermodynamic conditions. Using density functional theory calculations, we systematically investigate the interface configurations between beta-Ga2O3 (100) and both Si- and C-terminated 3C-SiC (001) substrates, considering realistic oxidation states that form at the SiC surface prior to epitaxial growth. Our analysis evaluates different stacking sequences and atomic-scale bonding arrangements, computing adhesion energies for various interface geometries to determine their relative thermodynamic stability. This work addresses the critical need for understanding beta-Ga2O3 integration on substrates with superior thermal conductivity, providing a theoretical framework for optimizing heteroepitaxial growth conditions in ultra-wide-bandgap power electronics applications."}],"geoLocations":[],"fundingReferences":[],"url":"https://arxiv.org/abs/2602.19820","contentUrl":null,"metadataVersion":0,"schemaVersion":"http://datacite.org/schema/kernel-4","source":"mds","isActive":true,"state":"findable","reason":null,"viewCount":0,"downloadCount":0,"referenceCount":0,"citationCount":0,"partCount":0,"partOfCount":0,"versionCount":0,"versionOfCount":0,"created":"2026-02-25T15:16:21Z","registered":"2026-02-25T15:16:22Z","published":null,"updated":"2026-02-25T15:16:22Z"},"relationships":{"client":{"data":{"id":"arxiv.content","type":"clients"}}}},{"id":"10.48550/arxiv.2602.19818","type":"dois","attributes":{"doi":"10.48550/arxiv.2602.19818","identifiers":[{"identifier":"2602.19818","identifierType":"arXiv"}],"creators":[{"nameType":"Personal","givenName":"Hillel","familyName":"Ohayon","name":"Ohayon, Hillel","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Daniel","familyName":"Gilkarov","name":"Gilkarov, Daniel","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Ran","familyName":"Dubin","name":"Dubin, Ran","affiliation":[],"nameIdentifiers":[]}],"titles":[{"title":"SafePickle: Robust and Generic ML Detection of Malicious Pickle-based ML Models"}],"publisher":"arXiv","container":{},"publicationYear":2026,"subjects":[{"subject":"Cryptography and Security (cs.CR)","lang":"en","subjectScheme":"arXiv"},{"subject":"Artificial Intelligence (cs.AI)","lang":"en","subjectScheme":"arXiv"},{"subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"},{"schemeUri":"http://www.oecd.org/science/inno/38235147.pdf","subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"}],"contributors":[],"dates":[{"date":"2026-02-23T13:19:43Z","dateType":"Submitted","dateInformation":"v1"},{"date":"2026-02-24T02:27:05Z","dateType":"Updated","dateInformation":"v1"},{"date":"2026-02","dateType":"Available","dateInformation":"v1"},{"date":"2026","dateType":"Issued"}],"language":null,"types":{"schemaOrg":"CreativeWork","resourceTypeGeneral":"Preprint","citeproc":"article","bibtex":"misc","ris":"GEN","resourceType":"Article"},"relatedIdentifiers":[],"relatedItems":[],"sizes":[],"formats":[],"version":"1","rightsList":[{"rightsIdentifierScheme":"SPDX","rightsUri":"https://creativecommons.org/licenses/by-nc-nd/4.0/legalcode","schemeUri":"https://spdx.org/licenses/","rights":"Creative Commons Attribution Non Commercial No Derivatives 4.0 International","rightsIdentifier":"cc-by-nc-nd-4.0"}],"descriptions":[{"descriptionType":"Abstract","description":"Model repositories such as Hugging Face increasingly distribute machine learning artifacts serialized with Python's pickle format, exposing users to remote code execution (RCE) risks during model loading. Recent defenses, such as PickleBall, rely on per-library policy synthesis that requires complex system setups and verified benign models, which limits scalability and generalization. In this work, we propose a lightweight, machine-learning-based scanner that detects malicious Pickle-based files without policy generation or code instrumentation. Our approach statically extracts structural and semantic features from Pickle bytecode and applies supervised and unsupervised models to classify files as benign or malicious. We construct and release a labeled dataset of 727 Pickle-based files from Hugging Face and evaluate our models on four datasets: our own, PickleBall (out-of-distribution), Hide-and-Seek (9 advanced evasive malicious models), and synthetic joblib files. Our method achieves 90.01% F1-score compared with 7.23%-62.75% achieved by the SOTA scanners (Modelscan, Fickling, ClamAV, VirusTotal) on our dataset. Furthermore, on the PickleBall data (OOD), it achieves 81.22% F1-score compared with 76.09% achieved by the PickleBall method, while remaining fully library-agnostic. Finally, we show that our method is the only one to correctly parse and classify 9/9 evasive Hide-and-Seek malicious models specially crafted to evade scanners. This demonstrates that data-driven detection can effectively and generically mitigate Pickle-based model file attacks."}],"geoLocations":[],"fundingReferences":[],"url":"https://arxiv.org/abs/2602.19818","contentUrl":null,"metadataVersion":0,"schemaVersion":"http://datacite.org/schema/kernel-4","source":"mds","isActive":true,"state":"findable","reason":null,"viewCount":0,"downloadCount":0,"referenceCount":0,"citationCount":0,"partCount":0,"partOfCount":0,"versionCount":0,"versionOfCount":0,"created":"2026-02-25T15:16:14Z","registered":"2026-02-25T15:16:15Z","published":null,"updated":"2026-02-25T15:16:15Z"},"relationships":{"client":{"data":{"id":"arxiv.content","type":"clients"}}}},{"id":"10.48550/arxiv.2602.19815","type":"dois","attributes":{"doi":"10.48550/arxiv.2602.19815","identifiers":[{"identifier":"2602.19815","identifierType":"arXiv"}],"creators":[{"nameType":"Personal","givenName":"Akhilesh Kakolu","familyName":"Ramarao","name":"Ramarao, Akhilesh Kakolu","affiliation":[],"nameIdentifiers":[]}],"titles":[{"title":"Keyboards for the Endangered Idu Mishmi Language"}],"publisher":"arXiv","container":{},"publicationYear":2026,"subjects":[{"subject":"Computation and Language (cs.CL)","lang":"en","subjectScheme":"arXiv"},{"subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"},{"schemeUri":"http://www.oecd.org/science/inno/38235147.pdf","subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"}],"contributors":[],"dates":[{"date":"2026-02-23T13:13:40Z","dateType":"Submitted","dateInformation":"v1"},{"date":"2026-02-24T02:26:50Z","dateType":"Updated","dateInformation":"v1"},{"date":"2026-02","dateType":"Available","dateInformation":"v1"},{"date":"2026","dateType":"Issued"}],"language":null,"types":{"schemaOrg":"CreativeWork","resourceTypeGeneral":"Preprint","citeproc":"article","bibtex":"misc","ris":"GEN","resourceType":"Article"},"relatedIdentifiers":[],"relatedItems":[],"sizes":[],"formats":[],"version":"1","rightsList":[{"rightsIdentifierScheme":"SPDX","rightsUri":"https://creativecommons.org/licenses/by-nc-sa/4.0/legalcode","schemeUri":"https://spdx.org/licenses/","rights":"Creative Commons Attribution Non Commercial Share Alike 4.0 International","rightsIdentifier":"cc-by-nc-sa-4.0"}],"descriptions":[{"descriptionType":"Abstract","description":"We present a mobile and desktop keyboard suite for Idu Mishmi, an endangered Trans-Himalayan language spoken by approximately 11,000 people in Arunachal Pradesh, India. Although a Latin-based orthography was developed in 2018, no digital input tools existed to use it, forcing speakers into ad-hoc romanizations that cannot represent the full writing system. Our keyboards comprise two tools: (1) an Android mobile keyboard, published on the Google Play Store and actively used in teacher training programs, and (2) a Windows desktop keyboard currently undergoing community testing. Both tools support the complete Idu Mishmi character inventory, including schwa, retracted schwa, nasalized vowels, and accented forms. Both operate fully offline with zero network permissions, addressing connectivity constraints and data sovereignty concerns. We describe the design, implementation, and deployment as a replicable model for other endangered language communities."}],"geoLocations":[],"fundingReferences":[],"url":"https://arxiv.org/abs/2602.19815","contentUrl":null,"metadataVersion":0,"schemaVersion":"http://datacite.org/schema/kernel-4","source":"mds","isActive":true,"state":"findable","reason":null,"viewCount":0,"downloadCount":0,"referenceCount":0,"citationCount":0,"partCount":0,"partOfCount":0,"versionCount":0,"versionOfCount":0,"created":"2026-02-25T15:16:01Z","registered":"2026-02-25T15:16:01Z","published":null,"updated":"2026-02-25T15:16:01Z"},"relationships":{"client":{"data":{"id":"arxiv.content","type":"clients"}}}},{"id":"10.48550/arxiv.2602.19814","type":"dois","attributes":{"doi":"10.48550/arxiv.2602.19814","identifiers":[{"identifier":"2602.19814","identifierType":"arXiv"}],"creators":[{"nameType":"Personal","givenName":"Razmik","familyName":"Mirzoyan","name":"Mirzoyan, Razmik","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Alexander","familyName":"Hahn","name":"Hahn, Alexander","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"David","familyName":"Fink","name":"Fink, David","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Antonios","familyName":"Dettlaff","name":"Dettlaff, Antonios","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Daniel","familyName":"Mazin","name":"Mazin, Daniel","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"David","familyName":"Paneque","name":"Paneque, David","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Olaf","familyName":"Reimann","name":"Reimann, Olaf","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Thomas","familyName":"Schweizer","name":"Schweizer, Thomas","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Derek","familyName":"Strom","name":"Strom, Derek","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Masahiro","familyName":"Teshima","name":"Teshima, Masahiro","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Yazhou","familyName":"Zhao","name":"Zhao, Yazhou","affiliation":[],"nameIdentifiers":[]}],"titles":[{"title":"Direct comparison of SiPMs and PMTs in operation with a bright background and prospects of using SPADs as truly digital sensors"}],"publisher":"arXiv","container":{},"publicationYear":2026,"subjects":[{"subject":"Instrumentation and Methods for Astrophysics (astro-ph.IM)","lang":"en","subjectScheme":"arXiv"},{"subject":"High Energy Astrophysical Phenomena (astro-ph.HE)","lang":"en","subjectScheme":"arXiv"},{"subject":"FOS: Physical sciences","subjectScheme":"Fields of Science and Technology (FOS)"},{"schemeUri":"http://www.oecd.org/science/inno/38235147.pdf","subject":"FOS: Physical sciences","subjectScheme":"Fields of Science and Technology (FOS)"}],"contributors":[],"dates":[{"date":"2026-02-23T13:13:15Z","dateType":"Submitted","dateInformation":"v1"},{"date":"2026-02-24T02:26:49Z","dateType":"Updated","dateInformation":"v1"},{"date":"2026-02","dateType":"Available","dateInformation":"v1"},{"date":"2026","dateType":"Issued"}],"language":null,"types":{"schemaOrg":"CreativeWork","resourceTypeGeneral":"Preprint","citeproc":"article","bibtex":"misc","ris":"GEN","resourceType":"Article"},"relatedIdentifiers":[{"relationType":"IsVersionOf","relatedIdentifier":"10.1016/j.nima.2026.171370","relatedIdentifierType":"DOI"}],"relatedItems":[],"sizes":[],"formats":[],"version":"1","rightsList":[{"rightsUri":"http://arxiv.org/licenses/nonexclusive-distrib/1.0/","rights":"arXiv.org perpetual, non-exclusive license"}],"descriptions":[{"descriptionType":"Abstract","description":"The use of silicon photomultipliers (SiPMs) alongside conventional photomultiplier tubes (PMTs) is a remarkable technological development in modern ground-based very high energy gamma-ray astronomy. SiPMs exhibit comparable or even higher photon detection efficiencies (PDEs) than PMTs. The sensitivity of a PMT matches well the spectral shape of Cherenkov radiation from extended air showers. In contrast to a PMT, the sensitivity of a SiPM is shifted toward longer wavelengths, where the intensity of light of night sky (LoNS), considered as unwanted noise, increases significantly. It is obvious that a SiPM with a higher PDE will indeed measure more Cherenkov light than a PMT, but it will also detect significantly higher LoNS noise; the question is which factor will predominate in the signal-to-noise-ratio (SNR). To compare the performance of a PMT with that of a SiPM, we built SiPM-based modules and installed these and operated in parallel in the imaging camera of the 17 m diameter MAGIC telescope. Our long-term studies show that SiPM, despite their higher PDE, can deliver only a comparable to PMT performance. As already the name SiPM suggests, we use these semiconductor sensors analogously to classical PMTs: We amplify their small signals, digitize, and calibrate the converted amplitudes. Although SiPM is essentially a digital sensor, its common-anode design does not allow one to directly profit from it. Numerous arrays of single-photon avalanche diodes (SPADs) are being developed in various laboratories worldwide. Unlike SiPM, SPAD arrays digitize the incident photons from the outset and count their number. We will dwell on the potential further developments of SPADs."},{"descriptionType":"Other","description":"4 pages, 3 figures, Proceedings of the 12th International Workshop on Ring Imaging Cherenkov Detectors (RICH2025), Accepted for publication in Nuclear Instruments and Methods in Physics Research - section A (NIM-A)"}],"geoLocations":[],"fundingReferences":[],"url":"https://arxiv.org/abs/2602.19814","contentUrl":null,"metadataVersion":0,"schemaVersion":"http://datacite.org/schema/kernel-4","source":"mds","isActive":true,"state":"findable","reason":null,"viewCount":0,"downloadCount":0,"referenceCount":0,"citationCount":0,"partCount":0,"partOfCount":0,"versionCount":0,"versionOfCount":1,"created":"2026-02-25T15:15:58Z","registered":"2026-02-25T15:15:59Z","published":null,"updated":"2026-02-25T15:15:59Z"},"relationships":{"client":{"data":{"id":"arxiv.content","type":"clients"}}}},{"id":"10.48550/arxiv.2602.19811","type":"dois","attributes":{"doi":"10.48550/arxiv.2602.19811","identifiers":[{"identifier":"2602.19811","identifierType":"arXiv"}],"creators":[{"nameType":"Personal","givenName":"Laurent","familyName":"Bindschaedler","name":"Bindschaedler, Laurent","affiliation":[],"nameIdentifiers":[]}],"titles":[{"title":"Semantic Caching for OLAP via LLM-Based Query Canonicalization (Extended Version)"}],"publisher":"arXiv","container":{},"publicationYear":2026,"subjects":[{"subject":"Databases (cs.DB)","lang":"en","subjectScheme":"arXiv"},{"subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"},{"schemeUri":"http://www.oecd.org/science/inno/38235147.pdf","subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"},{"subject":"H.2.4; H.3.3","lang":"en","subjectScheme":"ACM"}],"contributors":[],"dates":[{"date":"2026-02-23T13:12:05Z","dateType":"Submitted","dateInformation":"v1"},{"date":"2026-02-24T02:26:46Z","dateType":"Updated","dateInformation":"v1"},{"date":"2026-02","dateType":"Available","dateInformation":"v1"},{"date":"2026","dateType":"Issued"}],"language":null,"types":{"schemaOrg":"CreativeWork","resourceTypeGeneral":"Preprint","citeproc":"article","bibtex":"misc","ris":"GEN","resourceType":"Article"},"relatedIdentifiers":[],"relatedItems":[],"sizes":[],"formats":[],"version":"1","rightsList":[{"rightsIdentifierScheme":"SPDX","rightsUri":"https://creativecommons.org/licenses/by/4.0/legalcode","schemeUri":"https://spdx.org/licenses/","rights":"Creative Commons Attribution 4.0 International","rightsIdentifier":"cc-by-4.0"}],"descriptions":[{"descriptionType":"Abstract","description":"Analytical workloads exhibit substantial semantic repetition, yet most production caches key entries by SQL surface form (text or AST), fragmenting reuse across BI tools, notebooks, and NL interfaces. We introduce a safety-first middleware cache for dashboard-style OLAP over star schemas that canonicalizes both SQL and NL into a unified key space -- the OLAP Intent Signature -- capturing measures, grouping levels, filters, and time windows. Reuse requires exact intent matches under strict schema validation and confidence-gated NL acceptance; two correctness-preserving derivations (roll-up, filter-down) extend coverage without approximate matching. Across TPC-DS, SSB, and NYC TLC (1,395 queries), we achieve 82% hit rate versus 28% (text) and 56% (AST) with zero false hits; derivations double hit rate on hierarchical queries."},{"descriptionType":"Other","description":"12 pages, 2 figures, 5 tables. Extended version of the short paper published at DOLAP 2026 (co-located with EDBT/ICDT 2026)"}],"geoLocations":[],"fundingReferences":[],"url":"https://arxiv.org/abs/2602.19811","contentUrl":null,"metadataVersion":0,"schemaVersion":"http://datacite.org/schema/kernel-4","source":"mds","isActive":true,"state":"findable","reason":null,"viewCount":0,"downloadCount":0,"referenceCount":0,"citationCount":0,"partCount":0,"partOfCount":0,"versionCount":0,"versionOfCount":0,"created":"2026-02-25T15:15:50Z","registered":"2026-02-25T15:15:51Z","published":null,"updated":"2026-02-25T15:15:51Z"},"relationships":{"client":{"data":{"id":"arxiv.content","type":"clients"}}}},{"id":"10.48550/arxiv.2602.19809","type":"dois","attributes":{"doi":"10.48550/arxiv.2602.19809","identifiers":[{"identifier":"2602.19809","identifierType":"arXiv"}],"creators":[{"nameType":"Personal","givenName":"Sebastian","familyName":"Hubenschmid","name":"Hubenschmid, Sebastian","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Arvind","familyName":"Srinivasan","name":"Srinivasan, Arvind","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Niklas","familyName":"Elmqvist","name":"Elmqvist, Niklas","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Dieter","familyName":"Schmalstieg","name":"Schmalstieg, Dieter","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Michael","familyName":"Sedlmair","name":"Sedlmair, Michael","affiliation":[],"nameIdentifiers":[]}],"titles":[{"title":"Ambient Analytics: Calm Technology for Immersive Visualization and Sensemaking"}],"publisher":"arXiv","container":{},"publicationYear":2026,"subjects":[{"subject":"Human-Computer Interaction (cs.HC)","lang":"en","subjectScheme":"arXiv"},{"subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"},{"schemeUri":"http://www.oecd.org/science/inno/38235147.pdf","subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"}],"contributors":[],"dates":[{"date":"2026-02-23T13:08:37Z","dateType":"Submitted","dateInformation":"v1"},{"date":"2026-02-24T02:26:39Z","dateType":"Updated","dateInformation":"v1"},{"date":"2026-02","dateType":"Available","dateInformation":"v1"},{"date":"2026","dateType":"Issued"}],"language":null,"types":{"schemaOrg":"CreativeWork","resourceTypeGeneral":"Preprint","citeproc":"article","bibtex":"misc","ris":"GEN","resourceType":"Article"},"relatedIdentifiers":[{"relationType":"IsVersionOf","relatedIdentifier":"10.1109/mcg.2026.3667291","relatedIdentifierType":"DOI"}],"relatedItems":[],"sizes":[],"formats":[],"version":"1","rightsList":[{"rightsUri":"http://arxiv.org/licenses/nonexclusive-distrib/1.0/","rights":"arXiv.org perpetual, non-exclusive license"}],"descriptions":[{"descriptionType":"Abstract","description":"Augmented reality has great potential for embedding data visualizations in the world around the user. While this can enhance users' understanding of their surroundings, it also bears the risk of overwhelming their senses with a barrage of information. In contrast, calm technologies aim to place information in the user's attentional periphery, minimizing cognitive load instead of demanding focused engagement. In this column, we explore how visualizations can be harmoniously integrated into our everyday life through augmented reality, progressing from visual analytics to ambient analytics."},{"descriptionType":"Other","description":"Accepted at \"Visualization Viewpoints\" in IEEE Computer Graphics and Applications"}],"geoLocations":[],"fundingReferences":[],"url":"https://arxiv.org/abs/2602.19809","contentUrl":null,"metadataVersion":0,"schemaVersion":"http://datacite.org/schema/kernel-4","source":"mds","isActive":true,"state":"findable","reason":null,"viewCount":0,"downloadCount":0,"referenceCount":0,"citationCount":0,"partCount":0,"partOfCount":0,"versionCount":0,"versionOfCount":1,"created":"2026-02-25T15:15:46Z","registered":"2026-02-25T15:15:47Z","published":null,"updated":"2026-02-25T15:15:47Z"},"relationships":{"client":{"data":{"id":"arxiv.content","type":"clients"}}}},{"id":"10.48550/arxiv.2602.19808","type":"dois","attributes":{"doi":"10.48550/arxiv.2602.19808","identifiers":[{"identifier":"2602.19808","identifierType":"arXiv"}],"creators":[{"nameType":"Personal","givenName":"Stephane","familyName":"Sanfilippo","name":"Sanfilippo, Stephane","affiliation":[],"nameIdentifiers":[]}],"titles":[{"title":"Conventional Accelerator Magnets"}],"publisher":"arXiv","container":{},"publicationYear":2026,"subjects":[{"subject":"Accelerator Physics (physics.acc-ph)","lang":"en","subjectScheme":"arXiv"},{"subject":"FOS: Physical sciences","subjectScheme":"Fields of Science and Technology (FOS)"},{"schemeUri":"http://www.oecd.org/science/inno/38235147.pdf","subject":"FOS: Physical sciences","subjectScheme":"Fields of Science and Technology (FOS)"}],"contributors":[],"dates":[{"date":"2026-02-23T13:07:52Z","dateType":"Submitted","dateInformation":"v1"},{"date":"2026-02-24T02:26:38Z","dateType":"Updated","dateInformation":"v1"},{"date":"2026-02","dateType":"Available","dateInformation":"v1"},{"date":"2026","dateType":"Issued"}],"language":null,"types":{"schemaOrg":"CreativeWork","resourceTypeGeneral":"Preprint","citeproc":"article","bibtex":"misc","ris":"GEN","resourceType":"Article"},"relatedIdentifiers":[],"relatedItems":[],"sizes":[],"formats":[],"version":"1","rightsList":[{"rightsUri":"http://arxiv.org/licenses/nonexclusive-distrib/1.0/","rights":"arXiv.org perpetual, non-exclusive license"}],"descriptions":[{"descriptionType":"Abstract","description":"This course introduces conventional magnets used in particle accelerators, focusing on both normal-conducting copper coil magnets and permanent magnets (PMs). It covers magnet classification, design principles, material selection, and mechanical constraints. Advantages and limitations of PMs compared to copper coil magnets are discussed. Key construction steps and cooling methods are presented. The course also includes magnetic field measurement techniques and quality control. Practical examples from PSI and CERN illustrate the concepts."},{"descriptionType":"Other","description":"28 pages, contribution to the CAS - CERN Accelerator School: Mechanical \u0026amp; Materials Engineering for Particle Accelerators and Detectors, 2-15 June 2024, Sint-Michielsgestel, Netherlands"}],"geoLocations":[],"fundingReferences":[],"url":"https://arxiv.org/abs/2602.19808","contentUrl":null,"metadataVersion":0,"schemaVersion":"http://datacite.org/schema/kernel-4","source":"mds","isActive":true,"state":"findable","reason":null,"viewCount":0,"downloadCount":0,"referenceCount":0,"citationCount":0,"partCount":0,"partOfCount":0,"versionCount":0,"versionOfCount":0,"created":"2026-02-25T15:15:43Z","registered":"2026-02-25T15:15:44Z","published":null,"updated":"2026-02-25T15:15:44Z"},"relationships":{"client":{"data":{"id":"arxiv.content","type":"clients"}}}},{"id":"10.48550/arxiv.2602.19806","type":"dois","attributes":{"doi":"10.48550/arxiv.2602.19806","identifiers":[{"identifier":"2602.19806","identifierType":"arXiv"}],"creators":[{"nameType":"Personal","affiliation":["PLUME, LIP"],"givenName":"Damien","familyName":"Pous","name":"Pous, Damien","nameIdentifiers":[]}],"titles":[{"title":"String Diagrams for Monoidal Categories, in Rocq"}],"publisher":"arXiv","container":{},"publicationYear":2026,"subjects":[{"subject":"Logic in Computer Science (cs.LO)","lang":"en","subjectScheme":"arXiv"},{"subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"},{"schemeUri":"http://www.oecd.org/science/inno/38235147.pdf","subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"}],"contributors":[],"dates":[{"date":"2026-02-23T13:04:24Z","dateType":"Submitted","dateInformation":"v1"},{"date":"2026-02-24T02:26:33Z","dateType":"Updated","dateInformation":"v1"},{"date":"2026-02","dateType":"Available","dateInformation":"v1"},{"date":"2026","dateType":"Issued"}],"language":null,"types":{"schemaOrg":"CreativeWork","resourceTypeGeneral":"Preprint","citeproc":"article","bibtex":"misc","ris":"GEN","resourceType":"Article"},"relatedIdentifiers":[],"relatedItems":[],"sizes":[],"formats":[],"version":"1","rightsList":[{"rightsUri":"http://arxiv.org/licenses/nonexclusive-distrib/1.0/","rights":"arXiv.org perpetual, non-exclusive license"}],"descriptions":[{"descriptionType":"Abstract","description":"We present a Rocq library for monoidal categories, which includes a decision procedure for proving equality of morphisms as well as notations that make it possible to reason as if they were strict, inferring MacLane isomorphims automatically in the background. Together with an external tool for visualising and editing string diagrams, this make it possible to perform rewriting steps in monoidal categories graphically, and to translate them into textual formal proofs which are concise and readable."}],"geoLocations":[],"fundingReferences":[],"url":"https://arxiv.org/abs/2602.19806","contentUrl":null,"metadataVersion":0,"schemaVersion":"http://datacite.org/schema/kernel-4","source":"mds","isActive":true,"state":"findable","reason":null,"viewCount":0,"downloadCount":0,"referenceCount":0,"citationCount":1,"partCount":0,"partOfCount":0,"versionCount":0,"versionOfCount":0,"created":"2026-02-25T15:15:37Z","registered":"2026-02-25T15:15:38Z","published":null,"updated":"2026-02-25T15:15:38Z"},"relationships":{"client":{"data":{"id":"arxiv.content","type":"clients"}}}},{"id":"10.48550/arxiv.2602.19804","type":"dois","attributes":{"doi":"10.48550/arxiv.2602.19804","identifiers":[{"identifier":"2602.19804","identifierType":"arXiv"}],"creators":[{"nameType":"Personal","givenName":"Nicolau S.","familyName":"Aiex","name":"Aiex, Nicolau S.","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Sean","familyName":"McCurdy","name":"McCurdy, Sean","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Paul","familyName":"Minter","name":"Minter, Paul","affiliation":[],"nameIdentifiers":[]}],"titles":[{"title":"Quantitative Estimates on the Topology and Singular Set of Prescribed Mean Curvature Hypersurfaces"}],"publisher":"arXiv","container":{},"publicationYear":2026,"subjects":[{"subject":"Differential Geometry (math.DG)","lang":"en","subjectScheme":"arXiv"},{"subject":"Analysis of PDEs (math.AP)","lang":"en","subjectScheme":"arXiv"},{"subject":"FOS: Mathematics","subjectScheme":"Fields of Science and Technology (FOS)"},{"schemeUri":"http://www.oecd.org/science/inno/38235147.pdf","subject":"FOS: Mathematics","subjectScheme":"Fields of Science and Technology (FOS)"},{"subject":"53A10, 49Q20","lang":"en","subjectScheme":"MSC"}],"contributors":[],"dates":[{"date":"2026-02-23T13:02:38Z","dateType":"Submitted","dateInformation":"v1"},{"date":"2026-02-24T02:26:30Z","dateType":"Updated","dateInformation":"v1"},{"date":"2026-02","dateType":"Available","dateInformation":"v1"},{"date":"2026","dateType":"Issued"}],"language":null,"types":{"schemaOrg":"CreativeWork","resourceTypeGeneral":"Preprint","citeproc":"article","bibtex":"misc","ris":"GEN","resourceType":"Article"},"relatedIdentifiers":[],"relatedItems":[],"sizes":[],"formats":[],"version":"1","rightsList":[{"rightsUri":"http://arxiv.org/licenses/nonexclusive-distrib/1.0/","rights":"arXiv.org perpetual, non-exclusive license"}],"descriptions":[{"descriptionType":"Abstract","description":"We establish quantitative topological and singularity properties for (certain) prescribed mean curvature (PMC) hypersurfaces $V^n$ in Riemannian manifolds $(N^{n+1},h)$. Indeed, if $V$ has area at most $A\u0026gt;0$ with PMC given by a $C^{1,α}$ function $g:N\\to \\mathbb{R}$ with the bound $|g|_{C^{1,α}}\\leq Γ$, we show that there exists a constant $C$ depending only on $n,h,A,Γ$ and geometric quantities such that: \\[\\sum^n_{i=0}b^i(V) \\leq C(1+\\text{index}(V)) \\quad \\text{if }3\\leq n+1\\leq 7;\\] \\[M^{*n-7}(\\text{sing}(V)) \\leq C(1+\\text{index}(V)) \\quad \\text{if }n+1\\geq 8.\\] Here, $b^i$ denote the Betti numbers over any field, $M^{*n-7}$ denotes the upper $(n-7)$-dimensional Minkowski content, and $\\text{sing}(V)$ is the singular set of $V$. The first inequality extends the work of Song from the minimal hypersurface setting to the PMC hypersurface setting, whilst the second extends work of the authors. Our results apply to the PMC hypersurfaces constructed recently through min-max techniques by Bellettini--Wickramasekera."},{"descriptionType":"Other","description":"19 pages"}],"geoLocations":[],"fundingReferences":[],"url":"https://arxiv.org/abs/2602.19804","contentUrl":null,"metadataVersion":0,"schemaVersion":"http://datacite.org/schema/kernel-4","source":"mds","isActive":true,"state":"findable","reason":null,"viewCount":0,"downloadCount":0,"referenceCount":0,"citationCount":0,"partCount":0,"partOfCount":0,"versionCount":0,"versionOfCount":0,"created":"2026-02-25T15:15:32Z","registered":"2026-02-25T15:15:32Z","published":null,"updated":"2026-02-25T15:15:32Z"},"relationships":{"client":{"data":{"id":"arxiv.content","type":"clients"}}}},{"id":"10.48550/arxiv.2602.19803","type":"dois","attributes":{"doi":"10.48550/arxiv.2602.19803","identifiers":[{"identifier":"2602.19803","identifierType":"arXiv"}],"creators":[{"nameType":"Personal","givenName":"Gökhan","familyName":"Gül","name":"Gül, Gökhan","affiliation":[],"nameIdentifiers":[]}],"titles":[{"title":"From Asymptotic to Finite-Sample Minimax Robust Hypothesis Testing"}],"publisher":"arXiv","container":{},"publicationYear":2026,"subjects":[{"subject":"Statistics Theory (math.ST)","lang":"en","subjectScheme":"arXiv"},{"subject":"Information Theory (cs.IT)","lang":"en","subjectScheme":"arXiv"},{"subject":"FOS: Mathematics","subjectScheme":"Fields of Science and Technology (FOS)"},{"schemeUri":"http://www.oecd.org/science/inno/38235147.pdf","subject":"FOS: Mathematics","subjectScheme":"Fields of Science and Technology (FOS)"},{"subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"},{"schemeUri":"http://www.oecd.org/science/inno/38235147.pdf","subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"}],"contributors":[],"dates":[{"date":"2026-02-23T12:59:22Z","dateType":"Submitted","dateInformation":"v1"},{"date":"2026-02-24T02:26:29Z","dateType":"Updated","dateInformation":"v1"},{"date":"2026-02","dateType":"Available","dateInformation":"v1"},{"date":"2026","dateType":"Issued"}],"language":null,"types":{"schemaOrg":"CreativeWork","resourceTypeGeneral":"Preprint","citeproc":"article","bibtex":"misc","ris":"GEN","resourceType":"Article"},"relatedIdentifiers":[],"relatedItems":[],"sizes":[],"formats":[],"version":"1","rightsList":[{"rightsUri":"http://arxiv.org/licenses/nonexclusive-distrib/1.0/","rights":"arXiv.org perpetual, non-exclusive license"}],"descriptions":[{"descriptionType":"Abstract","description":"This paper establishes a formal connection between finite-sample and asymptotically minimax robust hypothesis testing under distributional uncertainty. It is shown that, whenever a finite-sample minimax robust test exists, it coincides with the solution of the corresponding asymptotic minimax problem. This result enables the analytical derivation of finite-sample minimax robust tests using asymptotic theory, bypassing the need for heuristic constructions. The total variation distance and band model are examined as representative uncertainty classes. For each, the least favorable distributions and corresponding robust likelihood ratio functions are derived in parametric form. In the total variation case, the new derivation generalizes earlier results by allowing unequal robustness parameters. The theory also explains and systematizes previously heuristic designs. Simulations are provided to illustrate the theoretical results."},{"descriptionType":"Other","description":"40 pages, 6 figures. Submitted to IEEE Transactions on Information Theory"}],"geoLocations":[],"fundingReferences":[],"url":"https://arxiv.org/abs/2602.19803","contentUrl":null,"metadataVersion":0,"schemaVersion":"http://datacite.org/schema/kernel-4","source":"mds","isActive":true,"state":"findable","reason":null,"viewCount":0,"downloadCount":0,"referenceCount":0,"citationCount":0,"partCount":0,"partOfCount":0,"versionCount":0,"versionOfCount":0,"created":"2026-02-25T15:15:29Z","registered":"2026-02-25T15:15:30Z","published":null,"updated":"2026-02-25T15:15:30Z"},"relationships":{"client":{"data":{"id":"arxiv.content","type":"clients"}}}},{"id":"10.48550/arxiv.2602.19801","type":"dois","attributes":{"doi":"10.48550/arxiv.2602.19801","identifiers":[{"identifier":"2602.19801","identifierType":"arXiv"}],"creators":[{"nameType":"Personal","givenName":"Rupert","familyName":"Klein","name":"Klein, Rupert","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Jinkai","familyName":"Li","name":"Li, Jinkai","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Xin","familyName":"Liu","name":"Liu, Xin","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Edriss S.","familyName":"Titi","name":"Titi, Edriss S.","affiliation":[],"nameIdentifiers":[]}],"titles":[{"title":"Local well-posedness of strong solutions to the non-isentropic compressible primitive equations with vertical diffusion"}],"publisher":"arXiv","container":{},"publicationYear":2026,"subjects":[{"subject":"Analysis of PDEs (math.AP)","lang":"en","subjectScheme":"arXiv"},{"subject":"Atmospheric and Oceanic Physics (physics.ao-ph)","lang":"en","subjectScheme":"arXiv"},{"subject":"FOS: Mathematics","subjectScheme":"Fields of Science and Technology (FOS)"},{"schemeUri":"http://www.oecd.org/science/inno/38235147.pdf","subject":"FOS: Mathematics","subjectScheme":"Fields of Science and Technology (FOS)"},{"subject":"FOS: Physical sciences","subjectScheme":"Fields of Science and Technology (FOS)"},{"schemeUri":"http://www.oecd.org/science/inno/38235147.pdf","subject":"FOS: Physical sciences","subjectScheme":"Fields of Science and Technology (FOS)"},{"subject":"76N10, 35D35, 76N06","lang":"en","subjectScheme":"MSC"}],"contributors":[],"dates":[{"date":"2026-02-23T12:56:49Z","dateType":"Submitted","dateInformation":"v1"},{"date":"2026-02-24T02:26:27Z","dateType":"Updated","dateInformation":"v1"},{"date":"2026-02","dateType":"Available","dateInformation":"v1"},{"date":"2026","dateType":"Issued"}],"language":null,"types":{"schemaOrg":"CreativeWork","resourceTypeGeneral":"Preprint","citeproc":"article","bibtex":"misc","ris":"GEN","resourceType":"Article"},"relatedIdentifiers":[],"relatedItems":[],"sizes":[],"formats":[],"version":"1","rightsList":[{"rightsIdentifierScheme":"SPDX","rightsUri":"https://creativecommons.org/licenses/by/4.0/legalcode","schemeUri":"https://spdx.org/licenses/","rights":"Creative Commons Attribution 4.0 International","rightsIdentifier":"cc-by-4.0"}],"descriptions":[{"descriptionType":"Abstract","description":"Due to the absence of dynamical equation in the vertical momentum component of the primitive equations (PEs) of atmospheric dynamics, the vertical component of the velocity can be recovered only from the information on the other physical quantities, while utilizing the hydrostatic balance. This causes one spatial derivative loss while leads to a stronger nonlinearity, comparing to the classic compressible Navier-Stokes equations. As a result, the mathematical analysis on the compressible primitive equations is mathematically more challenging than that on the compressible Navier-Stokes equations. In this paper, we consider the initial-boundary value problem to the non-isentropic compressible primitive equations with only vertical diffusion for the temperature, but without gravity. Local existence and uniqueness as well as the continuous dependence on the initial data of strong solutions are established for any suitably regular initial data. The initial velocity and pressure are assumed here to be of one order derivative higher regularity than that of the initial density."}],"geoLocations":[],"fundingReferences":[],"url":"https://arxiv.org/abs/2602.19801","contentUrl":null,"metadataVersion":0,"schemaVersion":"http://datacite.org/schema/kernel-4","source":"mds","isActive":true,"state":"findable","reason":null,"viewCount":0,"downloadCount":0,"referenceCount":0,"citationCount":0,"partCount":0,"partOfCount":0,"versionCount":0,"versionOfCount":0,"created":"2026-02-25T15:15:24Z","registered":"2026-02-25T15:15:25Z","published":null,"updated":"2026-02-25T15:15:25Z"},"relationships":{"client":{"data":{"id":"arxiv.content","type":"clients"}}}},{"id":"10.48550/arxiv.2602.19800","type":"dois","attributes":{"doi":"10.48550/arxiv.2602.19800","identifiers":[{"identifier":"2602.19800","identifierType":"arXiv"}],"creators":[{"nameType":"Personal","affiliation":["ICTP"],"givenName":"Jozef","familyName":"Bobok","name":"Bobok, Jozef","nameIdentifiers":[]},{"nameType":"Personal","affiliation":["ICTP"],"givenName":"Jernej","familyName":"Činč","name":"Činč, Jernej","nameIdentifiers":[]},{"nameType":"Personal","affiliation":["I2M"],"givenName":"Piotr","familyName":"Oprocha","name":"Oprocha, Piotr","nameIdentifiers":[]},{"nameType":"Personal","affiliation":["I2M"],"givenName":"Serge","familyName":"Troubetzkoy","name":"Troubetzkoy, Serge","nameIdentifiers":[]}],"titles":[{"title":"On Lebesgue measure preserving Besicovitch functions"}],"publisher":"arXiv","container":{},"publicationYear":2026,"subjects":[{"subject":"Dynamical Systems (math.DS)","lang":"en","subjectScheme":"arXiv"},{"subject":"FOS: Mathematics","subjectScheme":"Fields of Science and Technology (FOS)"},{"schemeUri":"http://www.oecd.org/science/inno/38235147.pdf","subject":"FOS: Mathematics","subjectScheme":"Fields of Science and Technology (FOS)"}],"contributors":[],"dates":[{"date":"2026-02-23T12:56:08Z","dateType":"Submitted","dateInformation":"v1"},{"date":"2026-02-24T02:26:24Z","dateType":"Updated","dateInformation":"v1"},{"date":"2026-02","dateType":"Available","dateInformation":"v1"},{"date":"2026","dateType":"Issued"}],"language":null,"types":{"schemaOrg":"CreativeWork","resourceTypeGeneral":"Preprint","citeproc":"article","bibtex":"misc","ris":"GEN","resourceType":"Article"},"relatedIdentifiers":[],"relatedItems":[],"sizes":[],"formats":[],"version":"1","rightsList":[{"rightsUri":"http://arxiv.org/licenses/nonexclusive-distrib/1.0/","rights":"arXiv.org perpetual, non-exclusive license"}],"descriptions":[{"descriptionType":"Abstract","description":"We consider the space $C_λ$ of all continuous interval maps preserving the Lebesgue measure $λ$. A continuous function $f\\colon~[0,1]\\to \\mathbb R$ is called Besicovitch if it does not have any finite or infinite unilateral derivative. It is known that the set of Besicovitch functions in $C_λ$ is nonempty and meager. We prove that no Besicovitch function is invertible $λ$-almost everywhere. As a consequence, every Besicovitch function in $C_λ$ has positive measure-theoretic entropy with respect to $λ$. Furthermore, we show that Besicovitch functions are dense in $C_λ$ and, consequently, also dense in the class of interval maps with a dense set of periodic points."}],"geoLocations":[],"fundingReferences":[],"url":"https://arxiv.org/abs/2602.19800","contentUrl":null,"metadataVersion":0,"schemaVersion":"http://datacite.org/schema/kernel-4","source":"mds","isActive":true,"state":"findable","reason":null,"viewCount":0,"downloadCount":0,"referenceCount":0,"citationCount":0,"partCount":0,"partOfCount":0,"versionCount":0,"versionOfCount":0,"created":"2026-02-25T15:15:22Z","registered":"2026-02-25T15:15:22Z","published":null,"updated":"2026-02-25T15:15:22Z"},"relationships":{"client":{"data":{"id":"arxiv.content","type":"clients"}}}},{"id":"10.48550/arxiv.2602.19798","type":"dois","attributes":{"doi":"10.48550/arxiv.2602.19798","identifiers":[{"identifier":"2602.19798","identifierType":"arXiv"}],"creators":[{"nameType":"Personal","givenName":"Kazuharu","familyName":"Yanagimoto","name":"Yanagimoto, Kazuharu","affiliation":[],"nameIdentifiers":[]}],"titles":[{"title":"Marriage and Divorce in Continuous Time"}],"publisher":"arXiv","container":{},"publicationYear":2026,"subjects":[{"subject":"General Economics (econ.GN)","lang":"en","subjectScheme":"arXiv"},{"subject":"FOS: Economics and business","subjectScheme":"Fields of Science and Technology (FOS)"},{"schemeUri":"http://www.oecd.org/science/inno/38235147.pdf","subject":"FOS: Economics and business","subjectScheme":"Fields of Science and Technology (FOS)"}],"contributors":[],"dates":[{"date":"2026-02-23T12:54:57Z","dateType":"Submitted","dateInformation":"v1"},{"date":"2026-02-24T02:26:19Z","dateType":"Updated","dateInformation":"v1"},{"date":"2026-02","dateType":"Available","dateInformation":"v1"},{"date":"2026","dateType":"Issued"}],"language":null,"types":{"schemaOrg":"CreativeWork","resourceTypeGeneral":"Preprint","citeproc":"article","bibtex":"misc","ris":"GEN","resourceType":"Article"},"relatedIdentifiers":[],"relatedItems":[],"sizes":[],"formats":[],"version":"1","rightsList":[{"rightsUri":"http://arxiv.org/licenses/nonexclusive-distrib/1.0/","rights":"arXiv.org perpetual, non-exclusive license"}],"descriptions":[{"descriptionType":"Abstract","description":"This paper reformulates the Greenwood and Guner (2009) marriage and divorce model in continuous time using the HACT methods of Achdou et al. (2022). Replacing the AR(1) match quality process with an Ornstein-Uhlenbeck process yields a tridiagonal generator, reducing the computational complexity of both the value function and stationary distribution calculations from quadratic to linear in the number of grid points. The continuous-time model closely replicates the discrete-time equilibrium across all key outcomes, including the share of married households, the marriage rate, and the divorce rate, while achieving substantial gains in computation time and memory usage."}],"geoLocations":[],"fundingReferences":[],"url":"https://arxiv.org/abs/2602.19798","contentUrl":null,"metadataVersion":0,"schemaVersion":"http://datacite.org/schema/kernel-4","source":"mds","isActive":true,"state":"findable","reason":null,"viewCount":0,"downloadCount":0,"referenceCount":0,"citationCount":0,"partCount":0,"partOfCount":0,"versionCount":0,"versionOfCount":0,"created":"2026-02-25T15:15:17Z","registered":"2026-02-25T15:15:17Z","published":null,"updated":"2026-02-25T15:15:17Z"},"relationships":{"client":{"data":{"id":"arxiv.content","type":"clients"}}}},{"id":"10.48550/arxiv.2602.19797","type":"dois","attributes":{"doi":"10.48550/arxiv.2602.19797","identifiers":[{"identifier":"2602.19797","identifierType":"arXiv"}],"creators":[{"nameType":"Personal","givenName":"Elitza","familyName":"Hristova","name":"Hristova, Elitza","affiliation":[],"nameIdentifiers":[]}],"titles":[{"title":"On the cocharacter sequence of some PI-algebras"}],"publisher":"arXiv","container":{},"publicationYear":2026,"subjects":[{"subject":"Rings and Algebras (math.RA)","lang":"en","subjectScheme":"arXiv"},{"subject":"Representation Theory (math.RT)","lang":"en","subjectScheme":"arXiv"},{"subject":"FOS: Mathematics","subjectScheme":"Fields of Science and Technology (FOS)"},{"schemeUri":"http://www.oecd.org/science/inno/38235147.pdf","subject":"FOS: Mathematics","subjectScheme":"Fields of Science and Technology (FOS)"},{"subject":"16R10, 13A50, 20G05","lang":"en","subjectScheme":"MSC"}],"contributors":[],"dates":[{"date":"2026-02-23T12:53:51Z","dateType":"Submitted","dateInformation":"v1"},{"date":"2026-02-24T02:26:17Z","dateType":"Updated","dateInformation":"v1"},{"date":"2026-02","dateType":"Available","dateInformation":"v1"},{"date":"2026","dateType":"Issued"}],"language":null,"types":{"schemaOrg":"CreativeWork","resourceTypeGeneral":"Preprint","citeproc":"article","bibtex":"misc","ris":"GEN","resourceType":"Article"},"relatedIdentifiers":[],"relatedItems":[],"sizes":[],"formats":[],"version":"1","rightsList":[{"rightsIdentifierScheme":"SPDX","rightsUri":"https://creativecommons.org/licenses/by/4.0/legalcode","schemeUri":"https://spdx.org/licenses/","rights":"Creative Commons Attribution 4.0 International","rightsIdentifier":"cc-by-4.0"}],"descriptions":[{"descriptionType":"Abstract","description":"Let $A$ be a unital associative PI-algebra over a field of characteristic zero. We study which partitions $λ$ appear with nonzero multiplicities in the cocharacter sequence of $A$ for several classes of algebras $A$. Berele defines the eventual arm width $ω_0(A)$ to be the maximal integer $d$ so that if $λ$ appears with nonzero multiplicity in the cocharacter sequence of $A$, then $λ$ can have at most $d$ parts arbitrarily large. Berele also shows that if $A$ is Lie nilpotent, then $ω_0(A) = 1$. In the first part of this paper, we show that if $A$ is unital, then $ω_0(A) = 1$ if and only if $A$ is Lie nilpotent. To prove this statement, we show that the algebra of proper polynomials $B_n(A)$ is finite dimensional if and only if $A$ is Lie nilpotent. In the second part, we give a bound on the nonzero multiplicities $λ$ in the cocharacter sequence of $A$, when the T-ideal of identities of $A$ is equal to a product of T-ideals generated by long commutators. As an application, we show that for a Lie nilpotent algebra $A$, the nonzero multiplicities $m_λ(A)$ correspond to partitions $λ$ which are supported in step-like diagrams in which the number of steps grows with the index of Lie nilpotency. Finally, we give also some applications to the noncommutative invariant theory of the special linear group $\\mathrm{SL}(n)$."},{"descriptionType":"Other","description":"14 pages"}],"geoLocations":[],"fundingReferences":[],"url":"https://arxiv.org/abs/2602.19797","contentUrl":null,"metadataVersion":0,"schemaVersion":"http://datacite.org/schema/kernel-4","source":"mds","isActive":true,"state":"findable","reason":null,"viewCount":0,"downloadCount":0,"referenceCount":0,"citationCount":0,"partCount":0,"partOfCount":0,"versionCount":0,"versionOfCount":0,"created":"2026-02-25T15:15:14Z","registered":"2026-02-25T15:15:15Z","published":null,"updated":"2026-02-25T15:15:15Z"},"relationships":{"client":{"data":{"id":"arxiv.content","type":"clients"}}}},{"id":"10.48550/arxiv.2602.19796","type":"dois","attributes":{"doi":"10.48550/arxiv.2602.19796","identifiers":[{"identifier":"2602.19796","identifierType":"arXiv"}],"creators":[{"nameType":"Personal","givenName":"Nico","familyName":"Leumer","name":"Leumer, Nico","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Harald","familyName":"Schmid","name":"Schmid, Harald","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Milena","familyName":"Grifoni","name":"Grifoni, Milena","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Magdalena","familyName":"Marganska","name":"Marganska, Magdalena","affiliation":[],"nameIdentifiers":[]}],"titles":[{"title":"Transcendental momentum quantization in semiconducting Rashba nanowires and zero energy states in their normal and superconducting phase"}],"publisher":"arXiv","container":{},"publicationYear":2026,"subjects":[{"subject":"Mesoscale and Nanoscale Physics (cond-mat.mes-hall)","lang":"en","subjectScheme":"arXiv"},{"subject":"FOS: Physical sciences","subjectScheme":"Fields of Science and Technology (FOS)"},{"schemeUri":"http://www.oecd.org/science/inno/38235147.pdf","subject":"FOS: Physical sciences","subjectScheme":"Fields of Science and Technology (FOS)"}],"contributors":[],"dates":[{"date":"2026-02-23T12:52:17Z","dateType":"Submitted","dateInformation":"v1"},{"date":"2026-02-24T02:26:13Z","dateType":"Updated","dateInformation":"v1"},{"date":"2026-02","dateType":"Available","dateInformation":"v1"},{"date":"2026","dateType":"Issued"}],"language":null,"types":{"schemaOrg":"CreativeWork","resourceTypeGeneral":"Preprint","citeproc":"article","bibtex":"misc","ris":"GEN","resourceType":"Article"},"relatedIdentifiers":[],"relatedItems":[],"sizes":[],"formats":[],"version":"1","rightsList":[{"rightsIdentifierScheme":"SPDX","rightsUri":"https://creativecommons.org/licenses/by/4.0/legalcode","schemeUri":"https://spdx.org/licenses/","rights":"Creative Commons Attribution 4.0 International","rightsIdentifier":"cc-by-4.0"}],"descriptions":[{"descriptionType":"Abstract","description":"We study finite system properties of the canonical low energy model for a semiconducting nanowire with Rashba spin-orbit coupling. The case of an isolated wire as well as of one proximitized by an s-wave superconductor are considered. Already for the normal wire, the presence of spin-orbit coupling leads to eigenstates of the finite system composed of more than two momentum eigenstates. The quantization condition for the wavevectors is not that of a quantum box, but given instead by a transcendental equation linking the involved wavevectors. For the wire with superconducting pairing, the presence of electron and hole channels complicates the composition of the eigenstates. In this case we derive an approximate quantization condition close to the phase boundary, and a condition for the appearance of exact zero energy states. It can be satisfied both in the topological and in the trivial phase. Both the trivial and topological zero energy states contribute to the linear transport through Andreev reflection and direct transmission processes, with their relative importance depending on the degree of the states' localization at the boundary."}],"geoLocations":[],"fundingReferences":[],"url":"https://arxiv.org/abs/2602.19796","contentUrl":null,"metadataVersion":0,"schemaVersion":"http://datacite.org/schema/kernel-4","source":"mds","isActive":true,"state":"findable","reason":null,"viewCount":0,"downloadCount":0,"referenceCount":0,"citationCount":0,"partCount":0,"partOfCount":0,"versionCount":0,"versionOfCount":0,"created":"2026-02-25T15:15:12Z","registered":"2026-02-25T15:15:12Z","published":null,"updated":"2026-02-25T15:15:12Z"},"relationships":{"client":{"data":{"id":"arxiv.content","type":"clients"}}}},{"id":"10.48550/arxiv.2602.19795","type":"dois","attributes":{"doi":"10.48550/arxiv.2602.19795","identifiers":[{"identifier":"2602.19795","identifierType":"arXiv"}],"creators":[{"nameType":"Personal","givenName":"Felix","familyName":"Möckel","name":"Möckel, Felix","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Harald","familyName":"Schmid","name":"Schmid, Harald","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Felix","familyName":"von Oppen","name":"von Oppen, Felix","affiliation":[],"nameIdentifiers":[]}],"titles":[{"title":"Floquet product mode and eigenphase order"}],"publisher":"arXiv","container":{},"publicationYear":2026,"subjects":[{"subject":"Strongly Correlated Electrons (cond-mat.str-el)","lang":"en","subjectScheme":"arXiv"},{"subject":"Quantum Physics (quant-ph)","lang":"en","subjectScheme":"arXiv"},{"subject":"FOS: Physical sciences","subjectScheme":"Fields of Science and Technology (FOS)"},{"schemeUri":"http://www.oecd.org/science/inno/38235147.pdf","subject":"FOS: Physical sciences","subjectScheme":"Fields of Science and Technology (FOS)"}],"contributors":[],"dates":[{"date":"2026-02-23T12:50:56Z","dateType":"Submitted","dateInformation":"v1"},{"date":"2026-02-24T02:26:05Z","dateType":"Updated","dateInformation":"v1"},{"date":"2026-02","dateType":"Available","dateInformation":"v1"},{"date":"2026","dateType":"Issued"}],"language":null,"types":{"schemaOrg":"CreativeWork","resourceTypeGeneral":"Preprint","citeproc":"article","bibtex":"misc","ris":"GEN","resourceType":"Article"},"relatedIdentifiers":[],"relatedItems":[],"sizes":[],"formats":[],"version":"1","rightsList":[{"rightsUri":"http://arxiv.org/licenses/nonexclusive-distrib/1.0/","rights":"arXiv.org perpetual, non-exclusive license"}],"descriptions":[{"descriptionType":"Abstract","description":"We study the robustness of the Floquet quantum Ising model against integrability-breaking perturbations, focusing on the phase hosting both Majorana zero and $π$ modes. A recent work [Phys. Rev. B 110, 075117, (2024)] observed that the Floquet product mode, a composite edge mode constructed from both Majorana operators, is considerably more robust than the individual Majorana edge modes. We analyze these strong modes from the point of view of the eigenphase order present in finite chains with open boundary conditions. As a result of the Majorana modes, all Floquet eigenstates come in quadruplets in the integrable limit. We show that the robustness of the various modes as well as the behavior of the boundary spin correlation functions can be understood in terms of the spectral statistics of these quadruplets in the presence of integrability-breaking perturbations."},{"descriptionType":"Other","description":"12 pages, 9 figures"}],"geoLocations":[],"fundingReferences":[],"url":"https://arxiv.org/abs/2602.19795","contentUrl":null,"metadataVersion":0,"schemaVersion":"http://datacite.org/schema/kernel-4","source":"mds","isActive":true,"state":"findable","reason":null,"viewCount":0,"downloadCount":0,"referenceCount":0,"citationCount":0,"partCount":0,"partOfCount":0,"versionCount":0,"versionOfCount":0,"created":"2026-02-25T15:15:09Z","registered":"2026-02-25T15:15:10Z","published":null,"updated":"2026-02-25T15:15:10Z"},"relationships":{"client":{"data":{"id":"arxiv.content","type":"clients"}}}},{"id":"10.48550/arxiv.2602.19794","type":"dois","attributes":{"doi":"10.48550/arxiv.2602.19794","identifiers":[{"identifier":"2602.19794","identifierType":"arXiv"}],"creators":[{"nameType":"Personal","affiliation":["LAMA, IFUMI"],"givenName":"Aurelia","familyName":"Deshayes","name":"Deshayes, Aurelia","nameIdentifiers":[]},{"nameType":"Personal","affiliation":["UL"],"givenName":"Régine","familyName":"Marchand","name":"Marchand, Régine","nameIdentifiers":[]}],"titles":[{"title":"The Contact Process Can Survive on a Slightly Subcritical Dynamical Percolation Cluster"}],"publisher":"arXiv","container":{},"publicationYear":2026,"subjects":[{"subject":"Probability (math.PR)","lang":"en","subjectScheme":"arXiv"},{"subject":"FOS: Mathematics","subjectScheme":"Fields of Science and Technology (FOS)"},{"schemeUri":"http://www.oecd.org/science/inno/38235147.pdf","subject":"FOS: Mathematics","subjectScheme":"Fields of Science and Technology (FOS)"}],"contributors":[],"dates":[{"date":"2026-02-23T12:50:53Z","dateType":"Submitted","dateInformation":"v1"},{"date":"2026-02-24T02:26:05Z","dateType":"Updated","dateInformation":"v1"},{"date":"2026-02","dateType":"Available","dateInformation":"v1"},{"date":"2026","dateType":"Issued"}],"language":null,"types":{"schemaOrg":"CreativeWork","resourceTypeGeneral":"Preprint","citeproc":"article","bibtex":"misc","ris":"GEN","resourceType":"Article"},"relatedIdentifiers":[],"relatedItems":[],"sizes":[],"formats":[],"version":"1","rightsList":[{"rightsUri":"http://arxiv.org/licenses/nonexclusive-distrib/1.0/","rights":"arXiv.org perpetual, non-exclusive license"}],"descriptions":[{"descriptionType":"Abstract","description":"The contact process on dynamic edges (CPDE) is a contact process evolving on a dynamic environment given by a dynamical percolation on the edges of Z d\\,: each edge updates its state to open or closed with respective rates vp and v(1 -p). By coupling a well-chosen subset of once infected sites in the CPDE with a cluster of some supercritical percolation on the edges of Z d , we prove that, for every dimension d $\\ge$ 2, we can find some slightly subcritical p \u0026lt; pc(d) such that for every update speed v \u0026gt; 0, the contact process with large enough infection rate can survive. This extends the result for dimension 1 proved by Linker and Remenik in [LR20]."}],"geoLocations":[],"fundingReferences":[],"url":"https://arxiv.org/abs/2602.19794","contentUrl":null,"metadataVersion":0,"schemaVersion":"http://datacite.org/schema/kernel-4","source":"mds","isActive":true,"state":"findable","reason":null,"viewCount":0,"downloadCount":0,"referenceCount":0,"citationCount":0,"partCount":0,"partOfCount":0,"versionCount":0,"versionOfCount":0,"created":"2026-02-25T15:15:07Z","registered":"2026-02-25T15:15:07Z","published":null,"updated":"2026-02-25T15:15:07Z"},"relationships":{"client":{"data":{"id":"arxiv.content","type":"clients"}}}},{"id":"10.48550/arxiv.2602.19788","type":"dois","attributes":{"doi":"10.48550/arxiv.2602.19788","identifiers":[{"identifier":"2602.19788","identifierType":"arXiv"}],"creators":[{"nameType":"Personal","givenName":"Lotta","familyName":"Mäkinen","name":"Mäkinen, Lotta","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Jorge","familyName":"Loría","name":"Loría, Jorge","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Samuel","familyName":"Kaski","name":"Kaski, Samuel","affiliation":[],"nameIdentifiers":[]}],"titles":[{"title":"Bayesian Meta-Learning with Expert Feedback for Task-Shift Adaptation through Causal Embeddings"}],"publisher":"arXiv","container":{},"publicationYear":2026,"subjects":[{"subject":"Machine Learning (cs.LG)","lang":"en","subjectScheme":"arXiv"},{"subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"},{"schemeUri":"http://www.oecd.org/science/inno/38235147.pdf","subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"}],"contributors":[],"dates":[{"date":"2026-02-23T12:44:22Z","dateType":"Submitted","dateInformation":"v1"},{"date":"2026-02-24T02:25:46Z","dateType":"Updated","dateInformation":"v1"},{"date":"2026-02","dateType":"Available","dateInformation":"v1"},{"date":"2026","dateType":"Issued"}],"language":null,"types":{"schemaOrg":"CreativeWork","resourceTypeGeneral":"Preprint","citeproc":"article","bibtex":"misc","ris":"GEN","resourceType":"Article"},"relatedIdentifiers":[],"relatedItems":[],"sizes":[],"formats":[],"version":"1","rightsList":[{"rightsIdentifierScheme":"SPDX","rightsUri":"https://creativecommons.org/licenses/by/4.0/legalcode","schemeUri":"https://spdx.org/licenses/","rights":"Creative Commons Attribution 4.0 International","rightsIdentifier":"cc-by-4.0"}],"descriptions":[{"descriptionType":"Abstract","description":"Meta-learning methods perform well on new within-distribution tasks but often fail when adapting to out-of-distribution target tasks, where transfer from source tasks can induce negative transfer. We propose a causally-aware Bayesian meta-learning method, by conditioning task-specific priors on precomputed latent causal task embeddings, enabling transfer based on mechanistic similarity rather than spurious correlations. Our approach explicitly considers realistic deployment settings where access to target-task data is limited, and adaptation relies on noisy (expert-provided) pairwise judgments of causal similarity between source and target tasks. We provide a theoretical analysis showing that conditioning on causal embeddings controls prior mismatch and mitigates negative transfer under task shift. Empirically, we demonstrate reductions in negative transfer and improved out-of-distribution adaptation in both controlled simulations and a large-scale real-world clinical prediction setting for cross-disease transfer, where causal embeddings align with underlying clinical mechanisms."},{"descriptionType":"Other","description":"27 pages, 8 figures"}],"geoLocations":[],"fundingReferences":[],"url":"https://arxiv.org/abs/2602.19788","contentUrl":null,"metadataVersion":0,"schemaVersion":"http://datacite.org/schema/kernel-4","source":"mds","isActive":true,"state":"findable","reason":null,"viewCount":0,"downloadCount":0,"referenceCount":0,"citationCount":0,"partCount":0,"partOfCount":0,"versionCount":0,"versionOfCount":0,"created":"2026-02-25T15:14:52Z","registered":"2026-02-25T15:14:52Z","published":null,"updated":"2026-02-25T15:14:52Z"},"relationships":{"client":{"data":{"id":"arxiv.content","type":"clients"}}}},{"id":"10.48550/arxiv.2602.19786","type":"dois","attributes":{"doi":"10.48550/arxiv.2602.19786","identifiers":[{"identifier":"2602.19786","identifierType":"arXiv"}],"creators":[{"nameType":"Personal","givenName":"Miguel","familyName":"Ceriani","name":"Ceriani, Miguel","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Fiorela","familyName":"Ciroku","name":"Ciroku, Fiorela","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Alessandro","familyName":"Russo","name":"Russo, Alessandro","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Massimiliano","familyName":"Schembri","name":"Schembri, Massimiliano","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Fai","familyName":"Fung","name":"Fung, Fai","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Neha","familyName":"Mittal","name":"Mittal, Neha","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Vito","familyName":"Trianni","name":"Trianni, Vito","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Andrea Giovanni","familyName":"Nuzzolese","name":"Nuzzolese, Andrea Giovanni","affiliation":[],"nameIdentifiers":[]}],"titles":[{"title":"The Climate Change Knowledge Graph: Supporting Climate Services"}],"publisher":"arXiv","container":{},"publicationYear":2026,"subjects":[{"subject":"Databases (cs.DB)","lang":"en","subjectScheme":"arXiv"},{"subject":"Artificial Intelligence (cs.AI)","lang":"en","subjectScheme":"arXiv"},{"subject":"Computers and Society (cs.CY)","lang":"en","subjectScheme":"arXiv"},{"subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"},{"schemeUri":"http://www.oecd.org/science/inno/38235147.pdf","subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"}],"contributors":[],"dates":[{"date":"2026-02-23T12:42:05Z","dateType":"Submitted","dateInformation":"v1"},{"date":"2026-02-24T02:25:40Z","dateType":"Updated","dateInformation":"v1"},{"date":"2026-02","dateType":"Available","dateInformation":"v1"},{"date":"2026","dateType":"Issued"}],"language":null,"types":{"schemaOrg":"CreativeWork","resourceTypeGeneral":"Preprint","citeproc":"article","bibtex":"misc","ris":"GEN","resourceType":"Article"},"relatedIdentifiers":[],"relatedItems":[],"sizes":[],"formats":[],"version":"1","rightsList":[{"rightsIdentifierScheme":"SPDX","rightsUri":"https://creativecommons.org/licenses/by/4.0/legalcode","schemeUri":"https://spdx.org/licenses/","rights":"Creative Commons Attribution 4.0 International","rightsIdentifier":"cc-by-4.0"}],"descriptions":[{"descriptionType":"Abstract","description":"Climate change impacts a broad spectrum of human resources and activities, necessitating the use of climate models to project long-term effects and inform mitigation and adaptation strategies. These models generate multiple datasets by running simulations across various scenarios and configurations, thereby covering a range of potential future outcomes. Currently, researchers rely on traditional search interfaces and APIs to retrieve such datasets, often piecing together information from metadata and community vocabularies. The Climate Change Knowledge Graph is designed to address these challenges by integrating diverse data sources related to climate simulations into a coherent and interoperable knowledge graph. This innovative resource allows for executing complex queries involving climate models, simulations, variables, spatio-temporal domains, and granularities. Developed with input from domain experts, the knowledge graph and its underlying ontology are published with open access license and provide a comprehensive framework that enhances the exploration of climate data, facilitating more informed decision-making in addressing climate change issues."}],"geoLocations":[],"fundingReferences":[],"url":"https://arxiv.org/abs/2602.19786","contentUrl":null,"metadataVersion":0,"schemaVersion":"http://datacite.org/schema/kernel-4","source":"mds","isActive":true,"state":"findable","reason":null,"viewCount":0,"downloadCount":0,"referenceCount":0,"citationCount":0,"partCount":0,"partOfCount":0,"versionCount":0,"versionOfCount":0,"created":"2026-02-25T15:14:47Z","registered":"2026-02-25T15:14:48Z","published":null,"updated":"2026-02-25T15:14:48Z"},"relationships":{"client":{"data":{"id":"arxiv.content","type":"clients"}}}},{"id":"10.48550/arxiv.2602.19785","type":"dois","attributes":{"doi":"10.48550/arxiv.2602.19785","identifiers":[{"identifier":"2602.19785","identifierType":"arXiv"}],"creators":[{"nameType":"Personal","affiliation":["CRESTIC"],"givenName":"Dylan","familyName":"Baptiste","name":"Baptiste, Dylan","nameIdentifiers":[]},{"nameType":"Personal","affiliation":["CRESTIC"],"givenName":"Ramla","familyName":"Saddem","name":"Saddem, Ramla","nameIdentifiers":[]},{"nameType":"Personal","affiliation":["CRESTIC"],"givenName":"Alexandre","familyName":"Philippot","name":"Philippot, Alexandre","nameIdentifiers":[]},{"nameType":"Personal","givenName":"François","familyName":"Foyer","name":"Foyer, François","affiliation":[],"nameIdentifiers":[]}],"titles":[{"title":"Unsupervised Anomaly Detection in NSL-KDD Using $β$-VAE: A Latent Space and Reconstruction Error Approach"}],"publisher":"arXiv","container":{},"publicationYear":2026,"subjects":[{"subject":"Machine Learning (cs.LG)","lang":"en","subjectScheme":"arXiv"},{"subject":"Neural and Evolutionary Computing (cs.NE)","lang":"en","subjectScheme":"arXiv"},{"subject":"Machine Learning (stat.ML)","lang":"en","subjectScheme":"arXiv"},{"subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"},{"schemeUri":"http://www.oecd.org/science/inno/38235147.pdf","subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"}],"contributors":[],"dates":[{"date":"2026-02-23T12:42:00Z","dateType":"Submitted","dateInformation":"v1"},{"date":"2026-02-24T02:25:39Z","dateType":"Updated","dateInformation":"v1"},{"date":"2026-02","dateType":"Available","dateInformation":"v1"},{"date":"2026","dateType":"Issued"}],"language":null,"types":{"schemaOrg":"CreativeWork","resourceTypeGeneral":"Preprint","citeproc":"article","bibtex":"misc","ris":"GEN","resourceType":"Article"},"relatedIdentifiers":[],"relatedItems":[],"sizes":[],"formats":[],"version":"1","rightsList":[{"rightsUri":"http://arxiv.org/licenses/nonexclusive-distrib/1.0/","rights":"arXiv.org perpetual, non-exclusive license"}],"descriptions":[{"descriptionType":"Abstract","description":"As Operational Technology increasingly integrates with Information Technology, the need for Intrusion Detection Systems becomes more important. This paper explores an unsupervised approach to anomaly detection in network traffic using $β$-Variational Autoencoders on the NSL-KDD dataset. We investigate two methods: leveraging the latent space structure by measuring distances from test samples to the training data projections, and using the reconstruction error as a conventional anomaly detection metric. By comparing these approaches, we provide insights into their respective advantages and limitations in an unsupervised setting. Experimental results highlight the effectiveness of latent space exploitation for classification tasks."}],"geoLocations":[],"fundingReferences":[],"url":"https://arxiv.org/abs/2602.19785","contentUrl":null,"metadataVersion":0,"schemaVersion":"http://datacite.org/schema/kernel-4","source":"mds","isActive":true,"state":"findable","reason":null,"viewCount":0,"downloadCount":0,"referenceCount":0,"citationCount":0,"partCount":0,"partOfCount":0,"versionCount":0,"versionOfCount":0,"created":"2026-02-25T15:14:44Z","registered":"2026-02-25T15:14:45Z","published":null,"updated":"2026-02-25T15:14:45Z"},"relationships":{"client":{"data":{"id":"arxiv.content","type":"clients"}}}},{"id":"10.48550/arxiv.2602.19783","type":"dois","attributes":{"doi":"10.48550/arxiv.2602.19783","identifiers":[{"identifier":"2602.19783","identifierType":"arXiv"}],"creators":[{"nameType":"Personal","givenName":"Wolfgang","familyName":"Kuhle","name":"Kuhle, Wolfgang","affiliation":[],"nameIdentifiers":[]}],"titles":[{"title":"Janus-Faced Technological Progress and the Arms Race in the Education of Humans and Chatbots"}],"publisher":"arXiv","container":{},"publicationYear":2026,"subjects":[{"subject":"General Economics (econ.GN)","lang":"en","subjectScheme":"arXiv"},{"subject":"FOS: Economics and business","subjectScheme":"Fields of Science and Technology (FOS)"},{"schemeUri":"http://www.oecd.org/science/inno/38235147.pdf","subject":"FOS: Economics and business","subjectScheme":"Fields of Science and Technology (FOS)"}],"contributors":[],"dates":[{"date":"2026-02-23T12:38:42Z","dateType":"Submitted","dateInformation":"v1"},{"date":"2026-02-24T02:25:26Z","dateType":"Updated","dateInformation":"v1"},{"date":"2026-02","dateType":"Available","dateInformation":"v1"},{"date":"2026","dateType":"Issued"}],"language":null,"types":{"schemaOrg":"CreativeWork","resourceTypeGeneral":"Preprint","citeproc":"article","bibtex":"misc","ris":"GEN","resourceType":"Article"},"relatedIdentifiers":[],"relatedItems":[],"sizes":[],"formats":[],"version":"1","rightsList":[{"rightsIdentifierScheme":"SPDX","rightsUri":"https://creativecommons.org/licenses/by/4.0/legalcode","schemeUri":"https://spdx.org/licenses/","rights":"Creative Commons Attribution 4.0 International","rightsIdentifier":"cc-by-4.0"}],"descriptions":[{"descriptionType":"Abstract","description":"We study the conditions under which technological advances, in combination with a lognormal wage distribution, incentivize agents into an inefficient educational arms race. Our model emphasizes that lognormal wage distributions imply that agents' wages increase exponentially in the level of their skill as well as in the level of technology. In turn, this exponential relation between skills, technology, and wages pressures agents into an exhausting race for the tails of the economy's skill distribution. Moreover, technological advances and overinvestment in education increase GDP and inequality, while welfare may decline. In an alternative interpretation, our model studies firms that invest in artificial intelligence of their chatbots and AI agents. For a wide range of specifications, firms, just like humans, have an incentive to choose corner solutions where investment is limited only by borrowing constraints."}],"geoLocations":[],"fundingReferences":[],"url":"https://arxiv.org/abs/2602.19783","contentUrl":null,"metadataVersion":0,"schemaVersion":"http://datacite.org/schema/kernel-4","source":"mds","isActive":true,"state":"findable","reason":null,"viewCount":0,"downloadCount":0,"referenceCount":0,"citationCount":0,"partCount":0,"partOfCount":0,"versionCount":0,"versionOfCount":0,"created":"2026-02-25T15:14:39Z","registered":"2026-02-25T15:14:40Z","published":null,"updated":"2026-02-25T15:14:40Z"},"relationships":{"client":{"data":{"id":"arxiv.content","type":"clients"}}}},{"id":"10.48550/arxiv.2602.19782","type":"dois","attributes":{"doi":"10.48550/arxiv.2602.19782","identifiers":[{"identifier":"2602.19782","identifierType":"arXiv"}],"creators":[{"nameType":"Personal","givenName":"Shimeng","familyName":"Huang","name":"Huang, Shimeng","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Matthew","familyName":"Robinson","name":"Robinson, Matthew","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Francesco","familyName":"Locatello","name":"Locatello, Francesco","affiliation":[],"nameIdentifiers":[]}],"titles":[{"title":"Addressing Instrument-Outcome Confounding in Mendelian Randomization through Representation Learning"}],"publisher":"arXiv","container":{},"publicationYear":2026,"subjects":[{"subject":"Machine Learning (cs.LG)","lang":"en","subjectScheme":"arXiv"},{"subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"},{"schemeUri":"http://www.oecd.org/science/inno/38235147.pdf","subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"}],"contributors":[],"dates":[{"date":"2026-02-23T12:38:26Z","dateType":"Submitted","dateInformation":"v1"},{"date":"2026-02-24T02:25:25Z","dateType":"Updated","dateInformation":"v1"},{"date":"2026-02","dateType":"Available","dateInformation":"v1"},{"date":"2026","dateType":"Issued"}],"language":null,"types":{"schemaOrg":"CreativeWork","resourceTypeGeneral":"Preprint","citeproc":"article","bibtex":"misc","ris":"GEN","resourceType":"Article"},"relatedIdentifiers":[],"relatedItems":[],"sizes":[],"formats":[],"version":"1","rightsList":[{"rightsUri":"http://arxiv.org/licenses/nonexclusive-distrib/1.0/","rights":"arXiv.org perpetual, non-exclusive license"}],"descriptions":[{"descriptionType":"Abstract","description":"Mendelian Randomization (MR) is a prominent observational epidemiological research method designed to address unobserved confounding when estimating causal effects. However, core assumptions -- particularly the independence between instruments and unobserved confounders -- are often violated due to population stratification or assortative mating. Leveraging the increasing availability of multi-environment data, we propose a representation learning framework that exploits cross-environment invariance to recover latent exogenous components of genetic instruments. We provide theoretical guarantees for identifying these latent instruments under various mixing mechanisms and demonstrate the effectiveness of our approach through simulations and semi-synthetic experiments using data from the All of Us Research Hub."}],"geoLocations":[],"fundingReferences":[],"url":"https://arxiv.org/abs/2602.19782","contentUrl":null,"metadataVersion":0,"schemaVersion":"http://datacite.org/schema/kernel-4","source":"mds","isActive":true,"state":"findable","reason":null,"viewCount":0,"downloadCount":0,"referenceCount":0,"citationCount":0,"partCount":0,"partOfCount":0,"versionCount":0,"versionOfCount":0,"created":"2026-02-25T15:14:37Z","registered":"2026-02-25T15:14:38Z","published":null,"updated":"2026-02-25T15:14:38Z"},"relationships":{"client":{"data":{"id":"arxiv.content","type":"clients"}}}},{"id":"10.48550/arxiv.2602.19781","type":"dois","attributes":{"doi":"10.48550/arxiv.2602.19781","identifiers":[{"identifier":"2602.19781","identifierType":"arXiv"}],"creators":[{"nameType":"Personal","affiliation":["UTLN"],"givenName":"Lorenzo","familyName":"Beninati","name":"Beninati, Lorenzo","nameIdentifiers":[]}],"titles":[{"title":"Explicit formulas and exact values for the number of rational points on singular curves over finite fields"}],"publisher":"arXiv","container":{},"publicationYear":2026,"subjects":[{"subject":"Algebraic Geometry (math.AG)","lang":"en","subjectScheme":"arXiv"},{"subject":"FOS: Mathematics","subjectScheme":"Fields of Science and Technology (FOS)"},{"schemeUri":"http://www.oecd.org/science/inno/38235147.pdf","subject":"FOS: Mathematics","subjectScheme":"Fields of Science and Technology (FOS)"}],"contributors":[],"dates":[{"date":"2026-02-23T12:37:12Z","dateType":"Submitted","dateInformation":"v1"},{"date":"2026-02-24T02:25:25Z","dateType":"Updated","dateInformation":"v1"},{"date":"2026-02","dateType":"Available","dateInformation":"v1"},{"date":"2026","dateType":"Issued"}],"language":null,"types":{"schemaOrg":"CreativeWork","resourceTypeGeneral":"Preprint","citeproc":"article","bibtex":"misc","ris":"GEN","resourceType":"Article"},"relatedIdentifiers":[],"relatedItems":[],"sizes":[],"formats":[],"version":"1","rightsList":[{"rightsUri":"http://arxiv.org/licenses/nonexclusive-distrib/1.0/","rights":"arXiv.org perpetual, non-exclusive license"}],"descriptions":[{"descriptionType":"Abstract","description":"We provide new explicit formulas for bounding the number of rational points on singular curves over finite fields. This enables us to obtain exact values of N q (g, $π$) which is defined as the maximum number of rational points over F q on a curve of geometric genus g and arithmetic genus $π$. We also give special attention to the case g = 2 in order to extend the work of Aubry and Iezzi on N q (0, $π$) and N q (1, $π$)."}],"geoLocations":[],"fundingReferences":[],"url":"https://arxiv.org/abs/2602.19781","contentUrl":null,"metadataVersion":0,"schemaVersion":"http://datacite.org/schema/kernel-4","source":"mds","isActive":true,"state":"findable","reason":null,"viewCount":0,"downloadCount":0,"referenceCount":0,"citationCount":0,"partCount":0,"partOfCount":0,"versionCount":0,"versionOfCount":0,"created":"2026-02-25T15:14:34Z","registered":"2026-02-25T15:14:35Z","published":null,"updated":"2026-02-25T15:14:35Z"},"relationships":{"client":{"data":{"id":"arxiv.content","type":"clients"}}}},{"id":"10.48550/arxiv.2602.19777","type":"dois","attributes":{"doi":"10.48550/arxiv.2602.19777","identifiers":[{"identifier":"2602.19777","identifierType":"arXiv"}],"creators":[{"nameType":"Personal","givenName":"Huimin","familyName":"Li","name":"Li, Huimin","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Vusal","familyName":"Novruzov","name":"Novruzov, Vusal","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Nikhilesh","familyName":"Singh","name":"Singh, Nikhilesh","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Lichao","familyName":"Wu","name":"Wu, Lichao","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Mohamadreza","familyName":"Rostami","name":"Rostami, Mohamadreza","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Ahmad-Reza","familyName":"Sadeghi","name":"Sadeghi, Ahmad-Reza","affiliation":[],"nameIdentifiers":[]}],"titles":[{"title":"AegisSat: Securing AI-Enabled SoC FPGA Satellite Platforms"}],"publisher":"arXiv","container":{},"publicationYear":2026,"subjects":[{"subject":"Cryptography and Security (cs.CR)","lang":"en","subjectScheme":"arXiv"},{"subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"},{"schemeUri":"http://www.oecd.org/science/inno/38235147.pdf","subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"}],"contributors":[],"dates":[{"date":"2026-02-23T12:32:05Z","dateType":"Submitted","dateInformation":"v1"},{"date":"2026-02-24T02:25:06Z","dateType":"Updated","dateInformation":"v1"},{"date":"2026-02","dateType":"Available","dateInformation":"v1"},{"date":"2026","dateType":"Issued"}],"language":null,"types":{"schemaOrg":"CreativeWork","resourceTypeGeneral":"Preprint","citeproc":"article","bibtex":"misc","ris":"GEN","resourceType":"Article"},"relatedIdentifiers":[],"relatedItems":[],"sizes":[],"formats":[],"version":"1","rightsList":[{"rightsIdentifierScheme":"SPDX","rightsUri":"https://creativecommons.org/licenses/by-nc-nd/4.0/legalcode","schemeUri":"https://spdx.org/licenses/","rights":"Creative Commons Attribution Non Commercial No Derivatives 4.0 International","rightsIdentifier":"cc-by-nc-nd-4.0"}],"descriptions":[{"descriptionType":"Abstract","description":"The increasing adoption of System-on-Chip Field-Programmable Gate Arrays (SoC FPGAs) in AI-enabled satellite systems, valued for their reconfigurability and in-orbit update capabilities, introduces significant security challenges. Compromised updates can lead to performance degradation, service disruptions, or adversarial manipulation of mission outcomes. To address these risks, this paper proposes a comprehensive security framework, AegisSat. It ensures the integrity and resilience of satellite platforms by (i) integrating cryptographically-based secure boot mechanisms to establish a trusted computing base; (ii) enforcing strict runtime resource isolation; (iii) employing authenticated procedures for in-orbit reconfiguration and AI model updates to prevent unauthorized modifications; and (iv) providing robust rollback capabilities to recover from boot and update failures and maintain system stability. To further support our claims, we conducted experiments demonstrating the integration of these mechanisms on contemporary SoC FPGA devices. This defense-in-depth framework is crucial for space applications, where physical access is impossible and systems must operate reliably over extended periods, thereby enhancing the trustworthiness of SoC FPGA-based satellite systems and enabling secure and resilient AI operations in orbit."}],"geoLocations":[],"fundingReferences":[],"url":"https://arxiv.org/abs/2602.19777","contentUrl":null,"metadataVersion":0,"schemaVersion":"http://datacite.org/schema/kernel-4","source":"mds","isActive":true,"state":"findable","reason":null,"viewCount":0,"downloadCount":0,"referenceCount":0,"citationCount":0,"partCount":0,"partOfCount":0,"versionCount":0,"versionOfCount":0,"created":"2026-02-25T15:14:25Z","registered":"2026-02-25T15:14:25Z","published":null,"updated":"2026-02-25T15:14:25Z"},"relationships":{"client":{"data":{"id":"arxiv.content","type":"clients"}}}},{"id":"10.48550/arxiv.2602.19775","type":"dois","attributes":{"doi":"10.48550/arxiv.2602.19775","identifiers":[{"identifier":"2602.19775","identifierType":"arXiv"}],"creators":[{"nameType":"Personal","givenName":"Jose M. G.","familyName":"Vilar","name":"Vilar, Jose M. G.","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Leonor","familyName":"Saiz","name":"Saiz, Leonor","affiliation":[],"nameIdentifiers":[]}],"titles":[{"title":"Exact Discrete Stochastic Simulation with Deep-Learning-Scale Gradient Optimization"}],"publisher":"arXiv","container":{},"publicationYear":2026,"subjects":[{"subject":"Quantitative Methods (q-bio.QM)","lang":"en","subjectScheme":"arXiv"},{"subject":"Statistical Mechanics (cond-mat.stat-mech)","lang":"en","subjectScheme":"arXiv"},{"subject":"Machine Learning (cs.LG)","lang":"en","subjectScheme":"arXiv"},{"subject":"Computational Physics (physics.comp-ph)","lang":"en","subjectScheme":"arXiv"},{"subject":"Molecular Networks (q-bio.MN)","lang":"en","subjectScheme":"arXiv"},{"subject":"FOS: Biological sciences","subjectScheme":"Fields of Science and Technology (FOS)"},{"schemeUri":"http://www.oecd.org/science/inno/38235147.pdf","subject":"FOS: Biological sciences","subjectScheme":"Fields of Science and Technology (FOS)"},{"subject":"FOS: Physical sciences","subjectScheme":"Fields of Science and Technology (FOS)"},{"schemeUri":"http://www.oecd.org/science/inno/38235147.pdf","subject":"FOS: Physical sciences","subjectScheme":"Fields of Science and Technology (FOS)"},{"subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"},{"schemeUri":"http://www.oecd.org/science/inno/38235147.pdf","subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"}],"contributors":[],"dates":[{"date":"2026-02-23T12:29:43Z","dateType":"Submitted","dateInformation":"v1"},{"date":"2026-02-24T02:25:00Z","dateType":"Updated","dateInformation":"v1"},{"date":"2026-02","dateType":"Available","dateInformation":"v1"},{"date":"2026","dateType":"Issued"}],"language":null,"types":{"schemaOrg":"CreativeWork","resourceTypeGeneral":"Preprint","citeproc":"article","bibtex":"misc","ris":"GEN","resourceType":"Article"},"relatedIdentifiers":[],"relatedItems":[],"sizes":[],"formats":[],"version":"1","rightsList":[{"rightsUri":"http://arxiv.org/licenses/nonexclusive-distrib/1.0/","rights":"arXiv.org perpetual, non-exclusive license"}],"descriptions":[{"descriptionType":"Abstract","description":"Exact stochastic simulation of continuous-time Markov chains (CTMCs) is essential when discreteness and noise drive system behavior, but the hard categorical event selection in Gillespie-type algorithms blocks gradient-based learning. We eliminate this constraint by decoupling forward simulation from backward differentiation, with hard categorical sampling generating exact trajectories and gradients propagating through a continuous massively-parallel Gumbel-Softmax straight-through surrogate. Our approach enables accurate optimization at parameter scales over four orders of magnitude beyond existing simulators. We validate for accuracy, scalability, and reliability on a reversible dimerization model (0.09% error), a genetic oscillator (1.2% error), a 203,796-parameter gene regulatory network achieving 98.4% MNIST accuracy (a prototypical deep-learning multilayer perceptron benchmark), and experimental patch-clamp recordings of ion channel gating (R^2 = 0.987) in the single-channel regime. Our GPU implementation delivers 1.9 billion steps per second, matching the scale of non-differentiable simulators. By making exact stochastic simulation massively parallel and autodiff-compatible, our results enable high-dimensional parameter inference and inverse design across systems biology, chemical kinetics, physics, and related CTMC-governed domains."},{"descriptionType":"Other","description":"28 pages, 8 figures"}],"geoLocations":[],"fundingReferences":[],"url":"https://arxiv.org/abs/2602.19775","contentUrl":null,"metadataVersion":0,"schemaVersion":"http://datacite.org/schema/kernel-4","source":"mds","isActive":true,"state":"findable","reason":null,"viewCount":0,"downloadCount":0,"referenceCount":0,"citationCount":0,"partCount":0,"partOfCount":0,"versionCount":0,"versionOfCount":0,"created":"2026-02-25T15:14:20Z","registered":"2026-02-25T15:14:20Z","published":null,"updated":"2026-02-25T15:14:20Z"},"relationships":{"client":{"data":{"id":"arxiv.content","type":"clients"}}}},{"id":"10.48550/arxiv.2602.19773","type":"dois","attributes":{"doi":"10.48550/arxiv.2602.19773","identifiers":[{"identifier":"2602.19773","identifierType":"arXiv"}],"creators":[{"nameType":"Personal","affiliation":["MAP5 - UMR 8145"],"givenName":"Loïc","familyName":"Thomassey","name":"Thomassey, Loïc","nameIdentifiers":[]},{"nameType":"Personal","affiliation":["MATHNET, MAP5 - UMR 8145"],"givenName":"Raphaël","familyName":"Lachièze-Rey","name":"Lachièze-Rey, Raphaël","nameIdentifiers":[]},{"nameType":"Personal","affiliation":["MAP5 - UMR 8145"],"givenName":"Assaf","familyName":"Shapira","name":"Shapira, Assaf","nameIdentifiers":[]}],"titles":[{"title":"Regularization of a stationary point process by a stationary increments perturbation"}],"publisher":"arXiv","container":{},"publicationYear":2026,"subjects":[{"subject":"Probability (math.PR)","lang":"en","subjectScheme":"arXiv"},{"subject":"FOS: Mathematics","subjectScheme":"Fields of Science and Technology (FOS)"},{"schemeUri":"http://www.oecd.org/science/inno/38235147.pdf","subject":"FOS: Mathematics","subjectScheme":"Fields of Science and Technology (FOS)"}],"contributors":[],"dates":[{"date":"2026-02-23T12:26:04Z","dateType":"Submitted","dateInformation":"v1"},{"date":"2026-02-24T02:24:55Z","dateType":"Updated","dateInformation":"v1"},{"date":"2026-02","dateType":"Available","dateInformation":"v1"},{"date":"2026","dateType":"Issued"}],"language":null,"types":{"schemaOrg":"CreativeWork","resourceTypeGeneral":"Preprint","citeproc":"article","bibtex":"misc","ris":"GEN","resourceType":"Article"},"relatedIdentifiers":[],"relatedItems":[],"sizes":[],"formats":[],"version":"1","rightsList":[{"rightsUri":"http://arxiv.org/licenses/nonexclusive-distrib/1.0/","rights":"arXiv.org perpetual, non-exclusive license"}],"descriptions":[{"descriptionType":"Abstract","description":"We present a novel procedure where a stationary point process is regularized through the convolution with a continuous random field with stationary increments, in the sense that the dependency between distant points is weakened; and the potential peaks in the spectrum (or Bragg peaks), reminiscent of a periodic behavior, are erased. We use this procedure to efficiently generate a hyperuniform point process in dimension 1 using a fractional Brownian Motion; simulating n points with complexity n log(n)."}],"geoLocations":[],"fundingReferences":[],"url":"https://arxiv.org/abs/2602.19773","contentUrl":null,"metadataVersion":0,"schemaVersion":"http://datacite.org/schema/kernel-4","source":"mds","isActive":true,"state":"findable","reason":null,"viewCount":0,"downloadCount":0,"referenceCount":0,"citationCount":0,"partCount":0,"partOfCount":0,"versionCount":0,"versionOfCount":0,"created":"2026-02-25T15:14:15Z","registered":"2026-02-25T15:14:15Z","published":null,"updated":"2026-02-25T15:14:15Z"},"relationships":{"client":{"data":{"id":"arxiv.content","type":"clients"}}}},{"id":"10.48550/arxiv.2602.19769","type":"dois","attributes":{"doi":"10.48550/arxiv.2602.19769","identifiers":[{"identifier":"2602.19769","identifierType":"arXiv"}],"creators":[{"nameType":"Personal","givenName":"Dejan","familyName":"Grba","name":"Grba, Dejan","affiliation":[],"nameIdentifiers":[]}],"titles":[{"title":"Incidental Reverberations: Poetic Similarities in AI Art"}],"publisher":"arXiv","container":{},"publicationYear":2026,"subjects":[{"subject":"Computers and Society (cs.CY)","lang":"en","subjectScheme":"arXiv"},{"subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"},{"schemeUri":"http://www.oecd.org/science/inno/38235147.pdf","subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"}],"contributors":[],"dates":[{"date":"2026-02-23T12:19:37Z","dateType":"Submitted","dateInformation":"v1"},{"date":"2026-02-24T02:24:37Z","dateType":"Updated","dateInformation":"v1"},{"date":"2026-02","dateType":"Available","dateInformation":"v1"},{"date":"2026","dateType":"Issued"}],"language":null,"types":{"schemaOrg":"CreativeWork","resourceTypeGeneral":"Preprint","citeproc":"article","bibtex":"misc","ris":"GEN","resourceType":"Article"},"relatedIdentifiers":[{"relationType":"IsVersionOf","relatedIdentifier":"10.48431/hsah.0305","relatedIdentifierType":"DOI"}],"relatedItems":[],"sizes":[],"formats":[],"version":"1","rightsList":[{"rightsIdentifierScheme":"SPDX","rightsUri":"https://creativecommons.org/licenses/by-nc-nd/4.0/legalcode","schemeUri":"https://spdx.org/licenses/","rights":"Creative Commons Attribution Non Commercial No Derivatives 4.0 International","rightsIdentifier":"cc-by-nc-nd-4.0"}],"descriptions":[{"descriptionType":"Abstract","description":"Contemporary AI art's diverse and widely recognized repertoire features numerous artworks that share conceptual, thematic, narrative, procedural, or presentational properties with other artworks across disciplinary and historical spectrums. AI artists occasionally leverage well-sanctioned poetic referencing as an asset but when obvious or easily discoverable similarities remain unacknowledged, they may become liabilities. Lurking behind the hype waves in the media, art world, and academia, these liabilities shape contemporary AI art's cultural identity and affect its social impact. As part of a broader study of poetic contingencies, in this paper I discuss selected AI art exemplars whose multifaceted expressive parallels are symptomatic of the field and beyond. I argue that expressive similarities in AI art are as detrimental to its cultural value as they are avoidable in its variety of important topics addressable with a wide range of creative affordances. My critique takes the well-informed autonomy of expression and the socially responsible freedom of creative thinking as the tenets of artmaking to indicate some of AI art's related issues and challenges induced by its entanglements with AI science, technology, and industry. In conclusion, I suggest that poetic similarities open a valuable perspective for studying AI art's strengths and deficiencies and for articulating a broader critical discussion of art and creativity."},{"descriptionType":"Other","description":"7 pages"}],"geoLocations":[],"fundingReferences":[],"url":"https://arxiv.org/abs/2602.19769","contentUrl":null,"metadataVersion":0,"schemaVersion":"http://datacite.org/schema/kernel-4","source":"mds","isActive":true,"state":"findable","reason":null,"viewCount":0,"downloadCount":0,"referenceCount":0,"citationCount":0,"partCount":0,"partOfCount":0,"versionCount":0,"versionOfCount":1,"created":"2026-02-25T15:14:04Z","registered":"2026-02-25T15:14:05Z","published":null,"updated":"2026-02-25T15:14:05Z"},"relationships":{"client":{"data":{"id":"arxiv.content","type":"clients"}}}},{"id":"10.48550/arxiv.2602.19768","type":"dois","attributes":{"doi":"10.48550/arxiv.2602.19768","identifiers":[{"identifier":"2602.19768","identifierType":"arXiv"}],"creators":[{"nameType":"Personal","givenName":"Fan","familyName":"Yang","name":"Yang, Fan","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Shurong","familyName":"Zheng","name":"Zheng, Shurong","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Hongyin","familyName":"Zhao","name":"Zhao, Hongyin","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Yufei","familyName":"Zhan","name":"Zhan, Yufei","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Xin","familyName":"Li","name":"Li, Xin","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Yousong","familyName":"Zhu","name":"Zhu, Yousong","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Chaoyang Zhao Ming","familyName":"Tang","name":"Tang, Chaoyang Zhao Ming","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Jinqiao","familyName":"Wang","name":"Wang, Jinqiao","affiliation":[],"nameIdentifiers":[]}],"titles":[{"title":"TraceVision: Trajectory-Aware Vision-Language Model for Human-Like Spatial Understanding"}],"publisher":"arXiv","container":{},"publicationYear":2026,"subjects":[{"subject":"Computer Vision and Pattern Recognition (cs.CV)","lang":"en","subjectScheme":"arXiv"},{"subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"},{"schemeUri":"http://www.oecd.org/science/inno/38235147.pdf","subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"}],"contributors":[],"dates":[{"date":"2026-02-23T12:18:26Z","dateType":"Submitted","dateInformation":"v1"},{"date":"2026-02-24T02:24:36Z","dateType":"Updated","dateInformation":"v1"},{"date":"2026-02-24T03:15:34Z","dateType":"Submitted","dateInformation":"v2"},{"date":"2026-02-25T01:18:10Z","dateType":"Updated","dateInformation":"v2"},{"date":"2026-02","dateType":"Available","dateInformation":"v1"},{"date":"2026","dateType":"Issued"}],"language":null,"types":{"schemaOrg":"CreativeWork","resourceTypeGeneral":"Preprint","citeproc":"article","bibtex":"misc","ris":"GEN","resourceType":"Article"},"relatedIdentifiers":[],"relatedItems":[],"sizes":[],"formats":[],"version":"2","rightsList":[{"rightsIdentifierScheme":"SPDX","rightsUri":"https://creativecommons.org/licenses/by/4.0/legalcode","schemeUri":"https://spdx.org/licenses/","rights":"Creative Commons Attribution 4.0 International","rightsIdentifier":"cc-by-4.0"}],"descriptions":[{"descriptionType":"Abstract","description":"Recent Large Vision-Language Models (LVLMs) demonstrate remarkable capabilities in image understanding and natural language generation. However, current approaches focus predominantly on global image understanding, struggling to simulate human visual attention trajectories and explain associations between descriptions and specific regions. We propose TraceVision, a unified vision-language model integrating trajectory-aware spatial understanding in an end-to-end framework. TraceVision employs a Trajectory-aware Visual Perception (TVP) module for bidirectional fusion of visual features and trajectory information. We design geometric simplification to extract semantic keypoints from raw trajectories and propose a three-stage training pipeline where trajectories guide description generation and region localization. We extend TraceVision to trajectory-guided segmentation and video scene understanding, enabling cross-frame tracking and temporal attention analysis. We construct the Reasoning-based Interactive Localized Narratives (RILN) dataset to enhance logical reasoning and interpretability. Extensive experiments on trajectory-guided captioning, text-guided trajectory prediction, understanding, and segmentation demonstrate that TraceVision achieves state-of-the-art performance, establishing a foundation for intuitive spatial interaction and interpretable visual understanding."}],"geoLocations":[],"fundingReferences":[],"url":"https://arxiv.org/abs/2602.19768","contentUrl":null,"metadataVersion":0,"schemaVersion":"http://datacite.org/schema/kernel-4","source":"mds","isActive":true,"state":"findable","reason":null,"viewCount":0,"downloadCount":0,"referenceCount":0,"citationCount":0,"partCount":0,"partOfCount":0,"versionCount":0,"versionOfCount":0,"created":"2026-02-25T15:14:02Z","registered":"2026-02-25T15:14:03Z","published":null,"updated":"2026-02-25T15:14:03Z"},"relationships":{"client":{"data":{"id":"arxiv.content","type":"clients"}}}},{"id":"10.48550/arxiv.2602.19765","type":"dois","attributes":{"doi":"10.48550/arxiv.2602.19765","identifiers":[{"identifier":"2602.19765","identifierType":"arXiv"}],"creators":[{"nameType":"Personal","givenName":"Felix","familyName":"Goebler","name":"Goebler, Felix","affiliation":[],"nameIdentifiers":[]}],"titles":[{"title":"Relevant maps and the algebraic skeleton of simplicial toric prevarieties"}],"publisher":"arXiv","container":{},"publicationYear":2026,"subjects":[{"subject":"Algebraic Geometry (math.AG)","lang":"en","subjectScheme":"arXiv"},{"subject":"Commutative Algebra (math.AC)","lang":"en","subjectScheme":"arXiv"},{"subject":"Combinatorics (math.CO)","lang":"en","subjectScheme":"arXiv"},{"subject":"FOS: Mathematics","subjectScheme":"Fields of Science and Technology (FOS)"},{"schemeUri":"http://www.oecd.org/science/inno/38235147.pdf","subject":"FOS: Mathematics","subjectScheme":"Fields of Science and Technology (FOS)"}],"contributors":[],"dates":[{"date":"2026-02-23T12:13:22Z","dateType":"Submitted","dateInformation":"v1"},{"date":"2026-02-24T02:24:29Z","dateType":"Updated","dateInformation":"v1"},{"date":"2026-02","dateType":"Available","dateInformation":"v1"},{"date":"2026","dateType":"Issued"}],"language":null,"types":{"schemaOrg":"CreativeWork","resourceTypeGeneral":"Preprint","citeproc":"article","bibtex":"misc","ris":"GEN","resourceType":"Article"},"relatedIdentifiers":[],"relatedItems":[],"sizes":[],"formats":[],"version":"1","rightsList":[{"rightsIdentifierScheme":"SPDX","rightsUri":"https://creativecommons.org/licenses/by-nc-nd/4.0/legalcode","schemeUri":"https://spdx.org/licenses/","rights":"Creative Commons Attribution Non Commercial No Derivatives 4.0 International","rightsIdentifier":"cc-by-nc-nd-4.0"}],"descriptions":[{"descriptionType":"Abstract","description":"Morphisms between schemes arising from multigraded rings are essential for understanding geometric relationships in algebraic geometry, yet a systematic theory for such maps has been lacking. In this paper, we develop a comprehensive framework for rational maps between multigraded Proj schemes by introducing several notions of maps between their underlying multigraded rings. A key challenge is that to induce actual morphisms (rather than just rational maps), the ring homomorphism $φ\\colon R \\to S$ must hit every relevant element in $S$. To address this, we introduce the use of relevant subsets $B \\subseteq S_+$ (where $S_+$ is the ideal generated by all relevant elements), $B \\unlhd S$, which allow us to control this condition more flexibly.\n As an application, we show that multigraded noetherian polynomial rings naturally encode combinatorial data, giving rise to systems of fans and thus to toric prevarieties. By leveraging our notion of rational maps with those relevant subsets, we prove that the category of triples $(D, S, B)$ - where $D$ is a finitely generated abelian group, $S$ is a $D$-graded noetherian polynomial ring, and $B \\unlhd S$ is a subset of $S_+$ - together with rational maps of conical rings, is anti-equivalent to the category of simplicial toric prevarieties."},{"descriptionType":"Other","description":"25 pages"}],"geoLocations":[],"fundingReferences":[],"url":"https://arxiv.org/abs/2602.19765","contentUrl":null,"metadataVersion":0,"schemaVersion":"http://datacite.org/schema/kernel-4","source":"mds","isActive":true,"state":"findable","reason":null,"viewCount":0,"downloadCount":0,"referenceCount":0,"citationCount":0,"partCount":0,"partOfCount":0,"versionCount":0,"versionOfCount":0,"created":"2026-02-25T15:13:55Z","registered":"2026-02-25T15:13:56Z","published":null,"updated":"2026-02-25T15:13:56Z"},"relationships":{"client":{"data":{"id":"arxiv.content","type":"clients"}}}},{"id":"10.48550/arxiv.2602.19764","type":"dois","attributes":{"doi":"10.48550/arxiv.2602.19764","identifiers":[{"identifier":"2602.19764","identifierType":"arXiv"}],"creators":[{"nameType":"Personal","givenName":"Yirui","familyName":"Sun","name":"Sun, Yirui","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Guangyu","familyName":"Zhuge","name":"Zhuge, Guangyu","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Keliang","familyName":"Liu","name":"Liu, Keliang","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Jie","familyName":"Gu","name":"Gu, Jie","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Zhihao","familyName":"xia","name":"xia, Zhihao","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Qionglin","familyName":"Ren","name":"Ren, Qionglin","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Chunxu","familyName":"tian","name":"tian, Chunxu","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Zhongxue","familyName":"Ga","name":"Ga, Zhongxue","affiliation":[],"nameIdentifiers":[]}],"titles":[{"title":"Towards Dexterous Embodied Manipulation via Deep Multi-Sensory Fusion and Sparse Expert Scaling"}],"publisher":"arXiv","container":{},"publicationYear":2026,"subjects":[{"subject":"Robotics (cs.RO)","lang":"en","subjectScheme":"arXiv"},{"subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"},{"schemeUri":"http://www.oecd.org/science/inno/38235147.pdf","subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"}],"contributors":[],"dates":[{"date":"2026-02-23T12:12:51Z","dateType":"Submitted","dateInformation":"v1"},{"date":"2026-02-24T02:24:28Z","dateType":"Updated","dateInformation":"v1"},{"date":"2026-02","dateType":"Available","dateInformation":"v1"},{"date":"2026","dateType":"Issued"}],"language":null,"types":{"schemaOrg":"CreativeWork","resourceTypeGeneral":"Preprint","citeproc":"article","bibtex":"misc","ris":"GEN","resourceType":"Article"},"relatedIdentifiers":[],"relatedItems":[],"sizes":[],"formats":[],"version":"1","rightsList":[{"rightsIdentifierScheme":"SPDX","rightsUri":"https://creativecommons.org/licenses/by/4.0/legalcode","schemeUri":"https://spdx.org/licenses/","rights":"Creative Commons Attribution 4.0 International","rightsIdentifier":"cc-by-4.0"}],"descriptions":[{"descriptionType":"Abstract","description":"Realizing dexterous embodied manipulation necessitates the deep integration of heterogeneous multimodal sensory inputs. However, current vision-centric paradigms often overlook the critical force and geometric feedback essential for complex tasks. This paper presents DeMUSE, a Deep Multimodal Unified Sparse Experts framework leveraging a Diffusion Transformer to integrate RGB, depth, and 6-axis force into a unified serialized stream. Adaptive Modality-specific Normalization (AdaMN) is employed to recalibrate modality-aware features, mitigating representation imbalance and harmonizing the heterogeneous distributions of multi-sensory signals. To facilitate efficient scaling, the architecture utilizes a Sparse Mixture-of-Experts (MoE) with shared experts, increasing model capacity for physical priors while maintaining the low inference latency required for real-time control. A Joint denoising objective synchronously synthesizes environmental evolution and action sequences to ensure physical consistency. Achieving success rates of 83.2% and 72.5% in simulation and real-world trials, DeMUSE demonstrates state-of-the-art performance, validating the necessity of deep multi-sensory integration for complex physical interactions."}],"geoLocations":[],"fundingReferences":[],"url":"https://arxiv.org/abs/2602.19764","contentUrl":null,"metadataVersion":0,"schemaVersion":"http://datacite.org/schema/kernel-4","source":"mds","isActive":true,"state":"findable","reason":null,"viewCount":0,"downloadCount":0,"referenceCount":0,"citationCount":0,"partCount":0,"partOfCount":0,"versionCount":0,"versionOfCount":0,"created":"2026-02-25T15:13:51Z","registered":"2026-02-25T15:13:52Z","published":null,"updated":"2026-02-25T15:13:52Z"},"relationships":{"client":{"data":{"id":"arxiv.content","type":"clients"}}}},{"id":"10.48550/arxiv.2602.19763","type":"dois","attributes":{"doi":"10.48550/arxiv.2602.19763","identifiers":[{"identifier":"2602.19763","identifierType":"arXiv"}],"creators":[{"nameType":"Personal","givenName":"Yida","familyName":"Lin","name":"Lin, Yida","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Bing","familyName":"Xue","name":"Xue, Bing","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Mengjie","familyName":"Zhang","name":"Zhang, Mengjie","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Sam","familyName":"Schofield","name":"Schofield, Sam","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Richard","familyName":"Green","name":"Green, Richard","affiliation":[],"nameIdentifiers":[]}],"titles":[{"title":"Training Deep Stereo Matching Networks on Tree Branch Imagery: A Benchmark Study for Real-Time UAV Forestry Applications"}],"publisher":"arXiv","container":{},"publicationYear":2026,"subjects":[{"subject":"Computer Vision and Pattern Recognition (cs.CV)","lang":"en","subjectScheme":"arXiv"},{"subject":"Image and Video Processing (eess.IV)","lang":"en","subjectScheme":"arXiv"},{"subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"},{"schemeUri":"http://www.oecd.org/science/inno/38235147.pdf","subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"},{"subject":"FOS: Electrical engineering, electronic engineering, information engineering","subjectScheme":"Fields of Science and Technology (FOS)"},{"schemeUri":"http://www.oecd.org/science/inno/38235147.pdf","subject":"FOS: Electrical engineering, electronic engineering, information engineering","subjectScheme":"Fields of Science and Technology (FOS)"}],"contributors":[],"dates":[{"date":"2026-02-23T12:12:43Z","dateType":"Submitted","dateInformation":"v1"},{"date":"2026-02-24T02:24:26Z","dateType":"Updated","dateInformation":"v1"},{"date":"2026-02","dateType":"Available","dateInformation":"v1"},{"date":"2026","dateType":"Issued"}],"language":null,"types":{"schemaOrg":"CreativeWork","resourceTypeGeneral":"Preprint","citeproc":"article","bibtex":"misc","ris":"GEN","resourceType":"Article"},"relatedIdentifiers":[],"relatedItems":[],"sizes":[],"formats":[],"version":"1","rightsList":[{"rightsIdentifierScheme":"SPDX","rightsUri":"https://creativecommons.org/licenses/by/4.0/legalcode","schemeUri":"https://spdx.org/licenses/","rights":"Creative Commons Attribution 4.0 International","rightsIdentifier":"cc-by-4.0"}],"descriptions":[{"descriptionType":"Abstract","description":"Autonomous drone-based tree pruning needs accurate, real-time depth estimation from stereo cameras. Depth is computed from disparity maps using $Z = f B/d$, so even small disparity errors cause noticeable depth mistakes at working distances. Building on our earlier work that identified DEFOM-Stereo as the best reference disparity generator for vegetation scenes, we present the first study to train and test ten deep stereo matching networks on real tree branch images. We use the Canterbury Tree Branches dataset -- 5,313 stereo pairs from a ZED Mini camera at 1080P and 720P -- with DEFOM-generated disparity maps as training targets. The ten methods cover step-by-step refinement, 3D convolution, edge-aware attention, and lightweight designs. Using perceptual metrics (SSIM, LPIPS, ViTScore) and structural metrics (SIFT/ORB feature matching), we find that BANet-3D produces the best overall quality (SSIM = 0.883, LPIPS = 0.157), while RAFT-Stereo scores highest on scene-level understanding (ViTScore = 0.799). Testing on an NVIDIA Jetson Orin Super (16 GB, independently powered) mounted on our drone shows that AnyNet reaches 6.99 FPS at 1080P -- the only near-real-time option -- while BANet-2D gives the best quality-speed balance at 1.21 FPS. We also compare 720P and 1080P processing times to guide resolution choices for forestry drone systems."}],"geoLocations":[],"fundingReferences":[],"url":"https://arxiv.org/abs/2602.19763","contentUrl":null,"metadataVersion":0,"schemaVersion":"http://datacite.org/schema/kernel-4","source":"mds","isActive":true,"state":"findable","reason":null,"viewCount":0,"downloadCount":0,"referenceCount":0,"citationCount":0,"partCount":0,"partOfCount":0,"versionCount":0,"versionOfCount":0,"created":"2026-02-25T15:13:49Z","registered":"2026-02-25T15:13:50Z","published":null,"updated":"2026-02-25T15:13:50Z"},"relationships":{"client":{"data":{"id":"arxiv.content","type":"clients"}}}},{"id":"10.48550/arxiv.2602.19762","type":"dois","attributes":{"doi":"10.48550/arxiv.2602.19762","identifiers":[{"identifier":"2602.19762","identifierType":"arXiv"}],"creators":[{"nameType":"Personal","givenName":"Mohammed Javed","familyName":"Absar","name":"Absar, Mohammed Javed","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Muthu","familyName":"Baskaran","name":"Baskaran, Muthu","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Abhikrant","familyName":"Sharma","name":"Sharma, Abhikrant","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Abhilash","familyName":"Bhandari","name":"Bhandari, Abhilash","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Ankit","familyName":"Aggarwal","name":"Aggarwal, Ankit","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Arun","familyName":"Rangasamy","name":"Rangasamy, Arun","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Dibyendu","familyName":"Das","name":"Das, Dibyendu","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Fateme","familyName":"Hosseini","name":"Hosseini, Fateme","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Franck","familyName":"Slama","name":"Slama, Franck","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Iulian","familyName":"Brumar","name":"Brumar, Iulian","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Jyotsna","familyName":"Verma","name":"Verma, Jyotsna","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Krishnaprasad","familyName":"Bindumadhavan","name":"Bindumadhavan, Krishnaprasad","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Mitesh","familyName":"Kothari","name":"Kothari, Mitesh","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Mohit","familyName":"Gupta","name":"Gupta, Mohit","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Ravishankar","familyName":"Kolachana","name":"Kolachana, Ravishankar","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Richard","familyName":"Lethin","name":"Lethin, Richard","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Samarth","familyName":"Narang","name":"Narang, Samarth","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Sanjay Motilal","familyName":"Ladwa","name":"Ladwa, Sanjay Motilal","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Shalini","familyName":"Jain","name":"Jain, Shalini","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Snigdha Suresh","familyName":"Dalvi","name":"Dalvi, Snigdha Suresh","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Tasmia","familyName":"Rahman","name":"Rahman, Tasmia","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Venkat Rasagna Reddy","familyName":"Komatireddy","name":"Komatireddy, Venkat Rasagna Reddy","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Vivek Vasudevbhai","familyName":"Pandya","name":"Pandya, Vivek Vasudevbhai","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Xiyue","familyName":"Shi","name":"Shi, Xiyue","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Zachary","familyName":"Zipper","name":"Zipper, Zachary","affiliation":[],"nameIdentifiers":[]}],"titles":[{"title":"Hexagon-MLIR: An AI Compilation Stack For Qualcomm's Neural Processing Units (NPUs)"}],"publisher":"arXiv","container":{},"publicationYear":2026,"subjects":[{"subject":"Programming Languages (cs.PL)","lang":"en","subjectScheme":"arXiv"},{"subject":"Artificial Intelligence (cs.AI)","lang":"en","subjectScheme":"arXiv"},{"subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"},{"schemeUri":"http://www.oecd.org/science/inno/38235147.pdf","subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"}],"contributors":[],"dates":[{"date":"2026-02-23T12:12:39Z","dateType":"Submitted","dateInformation":"v1"},{"date":"2026-02-24T02:24:25Z","dateType":"Updated","dateInformation":"v1"},{"date":"2026-02","dateType":"Available","dateInformation":"v1"},{"date":"2026","dateType":"Issued"}],"language":null,"types":{"schemaOrg":"CreativeWork","resourceTypeGeneral":"Preprint","citeproc":"article","bibtex":"misc","ris":"GEN","resourceType":"Article"},"relatedIdentifiers":[],"relatedItems":[],"sizes":[],"formats":[],"version":"1","rightsList":[{"rightsUri":"http://arxiv.org/licenses/nonexclusive-distrib/1.0/","rights":"arXiv.org perpetual, non-exclusive license"}],"descriptions":[{"descriptionType":"Abstract","description":"In this paper, we present Hexagon-MLIR,an open-source compilation stack that targets Qualcomm Hexagon Neural Processing Unit (NPU) and provides unified support for lowering Triton kernels and PyTorch models . Built using the MLIR framework, our compiler applies a structured sequence of passes to exploit NPU architectural features to accelerate AI workloads. It enables faster deployment of new Triton kernels (hand-written or subgraphs from PyTorch 2.0), for our target by providing automated compilation from kernel to binary. By ingesting Triton kernels, we generate mega-kernels that maximize data locality in the NPU's Tightly Coupled Memory (TCM), reducing the bandwidth bottlenecks inherent in library-based approaches. This initiative complements our commercial toolchains by providing developers with an open-source MLIR-based compilation stack that gives them a path to advance AI compilation capabilities through a more flexible approach. Hexagon-MLIR is a work-in-progress, and we are continuing to add many more optimizations and capabilities in this effort."}],"geoLocations":[],"fundingReferences":[],"url":"https://arxiv.org/abs/2602.19762","contentUrl":null,"metadataVersion":0,"schemaVersion":"http://datacite.org/schema/kernel-4","source":"mds","isActive":true,"state":"findable","reason":null,"viewCount":0,"downloadCount":0,"referenceCount":0,"citationCount":0,"partCount":0,"partOfCount":0,"versionCount":0,"versionOfCount":0,"created":"2026-02-25T15:13:47Z","registered":"2026-02-25T15:13:47Z","published":null,"updated":"2026-02-25T15:13:47Z"},"relationships":{"client":{"data":{"id":"arxiv.content","type":"clients"}}}},{"id":"10.48550/arxiv.2602.19761","type":"dois","attributes":{"doi":"10.48550/arxiv.2602.19761","identifiers":[{"identifier":"2602.19761","identifierType":"arXiv"}],"creators":[{"nameType":"Personal","givenName":"Nina","familyName":"van Gerwen","name":"van Gerwen, Nina","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Sten","familyName":"Willemsen","name":"Willemsen, Sten","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Bettina E.","familyName":"Hansen","name":"Hansen, Bettina E.","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Christophe","familyName":"Corpechot","name":"Corpechot, Christophe","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Marco","familyName":"Carbone","name":"Carbone, Marco","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Cynthia","familyName":"Levy","name":"Levy, Cynthia","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Maria-Carlota","familyName":"Londõno","name":"Londõno, Maria-Carlota","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Atsushi","familyName":"Tanaka","name":"Tanaka, Atsushi","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Palak","familyName":"Trivedi","name":"Trivedi, Palak","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Alejandra","familyName":"Villamil","name":"Villamil, Alejandra","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Gideon","familyName":"Hirschfield","name":"Hirschfield, Gideon","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Dimitris","familyName":"Rizopoulos","name":"Rizopoulos, Dimitris","affiliation":[],"nameIdentifiers":[]}],"titles":[{"title":"Ensemble Machine Learning and Statistical Procedures for Dynamic Predictions of Time-to-Event Outcomes"}],"publisher":"arXiv","container":{},"publicationYear":2026,"subjects":[{"subject":"Machine Learning (stat.ML)","lang":"en","subjectScheme":"arXiv"},{"subject":"Machine Learning (cs.LG)","lang":"en","subjectScheme":"arXiv"},{"subject":"Applications (stat.AP)","lang":"en","subjectScheme":"arXiv"},{"subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"},{"schemeUri":"http://www.oecd.org/science/inno/38235147.pdf","subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"}],"contributors":[],"dates":[{"date":"2026-02-23T12:12:13Z","dateType":"Submitted","dateInformation":"v1"},{"date":"2026-02-24T02:24:24Z","dateType":"Updated","dateInformation":"v1"},{"date":"2026-02","dateType":"Available","dateInformation":"v1"},{"date":"2026","dateType":"Issued"}],"language":null,"types":{"schemaOrg":"CreativeWork","resourceTypeGeneral":"Preprint","citeproc":"article","bibtex":"misc","ris":"GEN","resourceType":"Article"},"relatedIdentifiers":[],"relatedItems":[],"sizes":[],"formats":[],"version":"1","rightsList":[{"rightsIdentifierScheme":"SPDX","rightsUri":"https://creativecommons.org/licenses/by/4.0/legalcode","schemeUri":"https://spdx.org/licenses/","rights":"Creative Commons Attribution 4.0 International","rightsIdentifier":"cc-by-4.0"}],"descriptions":[{"descriptionType":"Abstract","description":"Dynamic predictions for longitudinal and time-to-event outcomes have become a versatile tool in precision medicine. Our work is motivated by the application of dynamic predictions in the decision-making process for primary biliary cholangitis patients. For these patients, serial biomarker measurements (e.g., bilirubin and alkaline phosphatase levels) are routinely collected to inform treating physicians of the risk of liver failure and guide clinical decision-making. Two popular statistical approaches to derive dynamic predictions are joint modelling and landmarking. However, recently, machine learning techniques have also been proposed. Each approach has its merits, and no single method exists to outperform all others. Consequently, obtaining the best possible survival estimates is challenging. Therefore, we extend the Super Learner framework to combine dynamic predictions from different models and procedures. Super Learner is an ensemble learning technique that allows users to combine different prediction algorithms to improve predictive accuracy and flexibility. It uses cross-validation and different objective functions of performance (e.g., squared loss) that suit specific applications to build the optimally weighted combination of predictions from a library of candidate algorithms. In our work, we pay special attention to appropriate objective functions for Super Learner to obtain the most optimal weighted combination of dynamic predictions. In our primary biliary cholangitis application, Super Learner presented unique benefits due to its ability to flexibly combine outputs from a diverse set of models with varying assumptions for equal or better predictive performance than any model fit separately."}],"geoLocations":[],"fundingReferences":[],"url":"https://arxiv.org/abs/2602.19761","contentUrl":null,"metadataVersion":0,"schemaVersion":"http://datacite.org/schema/kernel-4","source":"mds","isActive":true,"state":"findable","reason":null,"viewCount":0,"downloadCount":0,"referenceCount":0,"citationCount":0,"partCount":0,"partOfCount":0,"versionCount":0,"versionOfCount":0,"created":"2026-02-25T15:13:44Z","registered":"2026-02-25T15:13:45Z","published":null,"updated":"2026-02-25T15:13:45Z"},"relationships":{"client":{"data":{"id":"arxiv.content","type":"clients"}}}},{"id":"10.48550/arxiv.2602.19759","type":"dois","attributes":{"doi":"10.48550/arxiv.2602.19759","identifiers":[{"identifier":"2602.19759","identifierType":"arXiv"}],"creators":[{"nameType":"Personal","givenName":"Hosein","familyName":"Mohammadzadeh","name":"Mohammadzadeh, Hosein","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Zahra","familyName":"Ebadi","name":"Ebadi, Zahra","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Omid Yahyayi","familyName":"Monem","name":"Monem, Omid Yahyayi","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Mohammad Hossein Naghizadeh","familyName":"Ardabili","name":"Ardabili, Mohammad Hossein Naghizadeh","affiliation":[],"nameIdentifiers":[]}],"titles":[{"title":"Thermodynamic Geometry of Classical and Quantum Statistics in the Relativistic Regime"}],"publisher":"arXiv","container":{},"publicationYear":2026,"subjects":[{"subject":"Statistical Mechanics (cond-mat.stat-mech)","lang":"en","subjectScheme":"arXiv"},{"subject":"Quantum Gases (cond-mat.quant-gas)","lang":"en","subjectScheme":"arXiv"},{"subject":"FOS: Physical sciences","subjectScheme":"Fields of Science and Technology (FOS)"},{"schemeUri":"http://www.oecd.org/science/inno/38235147.pdf","subject":"FOS: Physical sciences","subjectScheme":"Fields of Science and Technology (FOS)"}],"contributors":[],"dates":[{"date":"2026-02-23T12:10:09Z","dateType":"Submitted","dateInformation":"v1"},{"date":"2026-02-24T02:24:19Z","dateType":"Updated","dateInformation":"v1"},{"date":"2026-02","dateType":"Available","dateInformation":"v1"},{"date":"2026","dateType":"Issued"}],"language":null,"types":{"schemaOrg":"CreativeWork","resourceTypeGeneral":"Preprint","citeproc":"article","bibtex":"misc","ris":"GEN","resourceType":"Article"},"relatedIdentifiers":[],"relatedItems":[],"sizes":[],"formats":[],"version":"1","rightsList":[{"rightsIdentifierScheme":"SPDX","rightsUri":"https://creativecommons.org/licenses/by/4.0/legalcode","schemeUri":"https://spdx.org/licenses/","rights":"Creative Commons Attribution 4.0 International","rightsIdentifier":"cc-by-4.0"}],"descriptions":[{"descriptionType":"Abstract","description":"We investigate the thermodynamic geometry of classical and quantum ideal gases in the relativistic regime, with particular emphasis on the effects of particle mass and spatial dimensionality. Relativistic kinematics is incorporated through the full energy-momentum dispersion relation and the corresponding relativistic density of states. Using the Fisher-Rao information metric derived from the partition function, we analyze the thermodynamic curvature for Maxwell-Boltzmann, Bose-Einstein, and Fermi-Dirac statistics. Exact analytical expressions are obtained in two spatial dimensions, while the three-dimensional case is studied numerically. We show that the thermodynamic curvature preserves its characteristic sign-positive for bosons and negative for fermions; even in the relativistic regime, reflecting effective attractive and repulsive statistical interactions, respectively. A distinctive relativistic effect is the shift of curvature singularities from the non-relativistic critical point to a mass-dependent threshold at $μ=mc^{2}$. In addition, the relativistic Bose-Einstein condensation temperature is evaluated, revealing explicit mass-dependent corrections to the non-relativistic result. These findings provide a unified geometric perspective on relativistic statistical systems and clarify the interplay between quantum statistics, relativistic kinematics, and critical behavior."},{"descriptionType":"Other","description":"9 pages, 5 figures"}],"geoLocations":[],"fundingReferences":[],"url":"https://arxiv.org/abs/2602.19759","contentUrl":null,"metadataVersion":0,"schemaVersion":"http://datacite.org/schema/kernel-4","source":"mds","isActive":true,"state":"findable","reason":null,"viewCount":0,"downloadCount":0,"referenceCount":0,"citationCount":0,"partCount":0,"partOfCount":0,"versionCount":0,"versionOfCount":0,"created":"2026-02-25T15:13:39Z","registered":"2026-02-25T15:13:40Z","published":null,"updated":"2026-02-25T15:13:40Z"},"relationships":{"client":{"data":{"id":"arxiv.content","type":"clients"}}}},{"id":"10.48550/arxiv.2602.19758","type":"dois","attributes":{"doi":"10.48550/arxiv.2602.19758","identifiers":[{"identifier":"2602.19758","identifierType":"arXiv"}],"creators":[{"nameType":"Personal","givenName":"Abdul","familyName":"Wadud","name":"Wadud, Abdul","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Nima","familyName":"Afraz","name":"Afraz, Nima","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Fatemeh","familyName":"Golpayegani","name":"Golpayegani, Fatemeh","affiliation":[],"nameIdentifiers":[]}],"titles":[{"title":"AI-Powered Conflict Management in Open RAN: Detection, Classification, and Mitigation"}],"publisher":"arXiv","container":{},"publicationYear":2026,"subjects":[{"subject":"Networking and Internet Architecture (cs.NI)","lang":"en","subjectScheme":"arXiv"},{"subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"},{"schemeUri":"http://www.oecd.org/science/inno/38235147.pdf","subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"}],"contributors":[],"dates":[{"date":"2026-02-23T12:09:46Z","dateType":"Submitted","dateInformation":"v1"},{"date":"2026-02-24T02:24:15Z","dateType":"Updated","dateInformation":"v1"},{"date":"2026-02","dateType":"Available","dateInformation":"v1"},{"date":"2026","dateType":"Issued"}],"language":null,"types":{"schemaOrg":"CreativeWork","resourceTypeGeneral":"Preprint","citeproc":"article","bibtex":"misc","ris":"GEN","resourceType":"Article"},"relatedIdentifiers":[],"relatedItems":[],"sizes":[],"formats":[],"version":"1","rightsList":[{"rightsIdentifierScheme":"SPDX","rightsUri":"https://creativecommons.org/licenses/by/4.0/legalcode","schemeUri":"https://spdx.org/licenses/","rights":"Creative Commons Attribution 4.0 International","rightsIdentifier":"cc-by-4.0"}],"descriptions":[{"descriptionType":"Abstract","description":"Open Radio Access Network (RAN) was designed with native Artificial Intelligence (AI) as a core pillar, enabling AI- driven xApps and rApps to dynamically optimize network performance. However, the independent ICP adjustments made by these applications can inadvertently create conflicts- direct, indirect, and implicit, which lead to network instability and KPI degradation. Traditional rule-based conflict management becomes increasingly impractical as Open RAN scales in terms of xApps, associated ICPs, and relevant KPIs, struggling to handle the complexity of multi-xApp interactions. This highlights the necessity for AI-driven solutions that can efficiently detect, classify, and mitigate conflicts in real-time. This paper proposes an AI-powered framework for conflict detection, classification, and mitigation in Open RAN. We introduce GenC, a synthetic conflict generation framework for large-scale labeled datasets with controlled parameter sharing and realistic class imbalance, enabling robust training and evaluation of AI models. Our classification pipeline leverages GNNs, Bi-LSTM, and SMOTE-enhanced GNNs, with results demonstrating SMOTE-GNN's superior robustness in handling imbalanced data. Experimental validation using both synthetic datasets (5-50 xApps) and realistic ns3-oran simulations with OpenCellID-derived Dublin topology shows that AI-based methods achieve 3.2x faster classification than rule-based approaches while maintaining near-perfect accuracy. Our framework successfully addresses Energy Saving (ES)/Mobility Robustness Optimization (MRO) conflict scenarios using realistic ns3-oran and scales efficiently to large-scale xApp environments. By embedding this workflow into Open RAN's AI-driven architecture, our solution ensures autonomous and self-optimizing conflict management, paving the way for resilient, ultra-low-latency, and energy-efficient 6G networks."}],"geoLocations":[],"fundingReferences":[],"url":"https://arxiv.org/abs/2602.19758","contentUrl":null,"metadataVersion":0,"schemaVersion":"http://datacite.org/schema/kernel-4","source":"mds","isActive":true,"state":"findable","reason":null,"viewCount":0,"downloadCount":0,"referenceCount":0,"citationCount":0,"partCount":0,"partOfCount":0,"versionCount":0,"versionOfCount":0,"created":"2026-02-25T15:13:37Z","registered":"2026-02-25T15:13:38Z","published":null,"updated":"2026-02-25T15:13:38Z"},"relationships":{"client":{"data":{"id":"arxiv.content","type":"clients"}}}},{"id":"10.48550/arxiv.2602.19757","type":"dois","attributes":{"doi":"10.48550/arxiv.2602.19757","identifiers":[{"identifier":"2602.19757","identifierType":"arXiv"}],"creators":[{"nameType":"Personal","givenName":"Ryutaro","familyName":"Misawa","name":"Misawa, Ryutaro","affiliation":[],"nameIdentifiers":[]}],"titles":[{"title":"Explicit construction of spherical $5$- and $7$-designs"}],"publisher":"arXiv","container":{},"publicationYear":2026,"subjects":[{"subject":"Combinatorics (math.CO)","lang":"en","subjectScheme":"arXiv"},{"subject":"Metric Geometry (math.MG)","lang":"en","subjectScheme":"arXiv"},{"subject":"FOS: Mathematics","subjectScheme":"Fields of Science and Technology (FOS)"},{"schemeUri":"http://www.oecd.org/science/inno/38235147.pdf","subject":"FOS: Mathematics","subjectScheme":"Fields of Science and Technology (FOS)"},{"subject":"05B30, 42C15, 52C17","lang":"en","subjectScheme":"MSC"}],"contributors":[],"dates":[{"date":"2026-02-23T12:09:29Z","dateType":"Submitted","dateInformation":"v1"},{"date":"2026-02-24T02:24:15Z","dateType":"Updated","dateInformation":"v1"},{"date":"2026-02","dateType":"Available","dateInformation":"v1"},{"date":"2026","dateType":"Issued"}],"language":null,"types":{"schemaOrg":"CreativeWork","resourceTypeGeneral":"Preprint","citeproc":"article","bibtex":"misc","ris":"GEN","resourceType":"Article"},"relatedIdentifiers":[],"relatedItems":[],"sizes":[],"formats":[],"version":"1","rightsList":[{"rightsIdentifierScheme":"SPDX","rightsUri":"https://creativecommons.org/licenses/by/4.0/legalcode","schemeUri":"https://spdx.org/licenses/","rights":"Creative Commons Attribution 4.0 International","rightsIdentifier":"cc-by-4.0"}],"descriptions":[{"descriptionType":"Abstract","description":"This paper develops an explicit and implementable framework for constructing spherical designs by lifting point sets from tight fusion frames. By combining existing ingredients, we obtain, in every dimension, explicit spherical $5$-designs with $|X|=\\mathcal{O}(d^3)$. As a core component of the method, we give an explicit construction of simplex $3$-designs realized as orbits of the symmetric group. Using these simplex designs as input, we further construct spherical $7$-designs in arbitrary even dimensions; more precisely, for every even integer $d\\ge 6$ we obtain spherical $7$-designs in dimension $d$, and if $\\frac{d}{2}-1$ is a prime power then the number of points is $\\mathcal{O}(d^6)$."},{"descriptionType":"Other","description":"18 pages, 1 figure"}],"geoLocations":[],"fundingReferences":[],"url":"https://arxiv.org/abs/2602.19757","contentUrl":null,"metadataVersion":0,"schemaVersion":"http://datacite.org/schema/kernel-4","source":"mds","isActive":true,"state":"findable","reason":null,"viewCount":0,"downloadCount":0,"referenceCount":0,"citationCount":0,"partCount":0,"partOfCount":0,"versionCount":0,"versionOfCount":0,"created":"2026-02-25T15:13:35Z","registered":"2026-02-25T15:13:35Z","published":null,"updated":"2026-02-25T15:13:35Z"},"relationships":{"client":{"data":{"id":"arxiv.content","type":"clients"}}}},{"id":"10.48550/arxiv.2602.19755","type":"dois","attributes":{"doi":"10.48550/arxiv.2602.19755","identifiers":[{"identifier":"2602.19755","identifierType":"arXiv"}],"creators":[{"nameType":"Personal","givenName":"Dan","familyName":"McLachlan","name":"McLachlan, Dan","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Christian","familyName":"Ginski","name":"Ginski, Christian","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Jake","familyName":"Byrne","name":"Byrne, Jake","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Chloe","familyName":"Lawlor","name":"Lawlor, Chloe","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Justyn","familyName":"Campbell-White","name":"Campbell-White, Justyn","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Rik","familyName":"Claes","name":"Claes, Rik","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Bin","familyName":"Ren","name":"Ren, Bin","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Anibal","familyName":"Sierra","name":"Sierra, Anibal","affiliation":[],"nameIdentifiers":[]}],"titles":[{"title":"Young system development in a cometary globule: An investigation into the eccentric disk around AT Pyx in terms of planet-formation and interaction with its surrounding environment"}],"publisher":"arXiv","container":{},"publicationYear":2026,"subjects":[{"subject":"Earth and Planetary Astrophysics (astro-ph.EP)","lang":"en","subjectScheme":"arXiv"},{"subject":"FOS: Physical sciences","subjectScheme":"Fields of Science and Technology (FOS)"},{"schemeUri":"http://www.oecd.org/science/inno/38235147.pdf","subject":"FOS: Physical sciences","subjectScheme":"Fields of Science and Technology (FOS)"}],"contributors":[],"dates":[{"date":"2026-02-23T12:03:54Z","dateType":"Submitted","dateInformation":"v1"},{"date":"2026-02-24T02:24:06Z","dateType":"Updated","dateInformation":"v1"},{"date":"2026-02","dateType":"Available","dateInformation":"v1"},{"date":"2026","dateType":"Issued"}],"language":null,"types":{"schemaOrg":"CreativeWork","resourceTypeGeneral":"Preprint","citeproc":"article","bibtex":"misc","ris":"GEN","resourceType":"Article"},"relatedIdentifiers":[],"relatedItems":[],"sizes":[],"formats":[],"version":"1","rightsList":[{"rightsIdentifierScheme":"SPDX","rightsUri":"https://creativecommons.org/licenses/by/4.0/legalcode","schemeUri":"https://spdx.org/licenses/","rights":"Creative Commons Attribution 4.0 International","rightsIdentifier":"cc-by-4.0"}],"descriptions":[{"descriptionType":"Abstract","description":"This paper presents new data and analyses of the AT Pyx system, a disk-hosting young star located in a cometary globule in the Gum Nebula. This radiation-driven structure is an unusual environment for observations of planet formation and differs greatly from the low-mass star-forming regions disks are most commonly observed in. Aided by a collection of visual and spectroscopic data available for this system, this paper aims to infer the possibility of embedded planets existing within the disk and how the system's environment may affect its disk morphology. Using data from the VLT's instruments XSHOOTER, ESPRESSO and - most prominently - SPHERE along with data from ALMA, we make a variety of measurements (geometric, photometric and otherwise) to characterise the observed disk features and attributes such as spiral arms and eccentricity. Mapping of the velocity components is also undertaken using the ALMA gas line data to characterise disk orientation and determine the likelihood that the system is experiencing a late-stage infall event. The disk is found to be eccentric when deprojected. Under the assumption that the formation of a planet is wholly responsible for the primary and secondary spiral arms, we find the mass of such a planet can range between 0.004 and 3 Jupiter masses. Measurement of the velocities associated with nearby globule cloud material returns reasonable velocities for a late-stage infall event. We estimate far-ultraviolet field strength at AT Pyx's location to be low in comparison to other surveyed disks. We also find that AT Pyx is possibly a binary system. AT Pyx is the first disk within a cometary globule to be spatially resolved, and is now the first such disk to be investigated to this extent. The work of this paper could potentially be a first step into the further study of disks in the moderate-FUV environment of the Gum Nebula and its globules."},{"descriptionType":"Other","description":"17 pages, 21 figures"}],"geoLocations":[],"fundingReferences":[],"url":"https://arxiv.org/abs/2602.19755","contentUrl":null,"metadataVersion":0,"schemaVersion":"http://datacite.org/schema/kernel-4","source":"mds","isActive":true,"state":"findable","reason":null,"viewCount":0,"downloadCount":0,"referenceCount":0,"citationCount":0,"partCount":0,"partOfCount":0,"versionCount":0,"versionOfCount":0,"created":"2026-02-25T15:13:30Z","registered":"2026-02-25T15:13:31Z","published":null,"updated":"2026-02-25T15:13:31Z"},"relationships":{"client":{"data":{"id":"arxiv.content","type":"clients"}}}},{"id":"10.48550/arxiv.2602.19754","type":"dois","attributes":{"doi":"10.48550/arxiv.2602.19754","identifiers":[{"identifier":"2602.19754","identifierType":"arXiv"}],"creators":[{"nameType":"Personal","givenName":"Dejan","familyName":"Grba","name":"Grba, Dejan","affiliation":[],"nameIdentifiers":[]}],"titles":[{"title":"Deep Else: A Critical Framework for AI Art"}],"publisher":"arXiv","container":{},"publicationYear":2026,"subjects":[{"subject":"Computers and Society (cs.CY)","lang":"en","subjectScheme":"arXiv"},{"subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"},{"schemeUri":"http://www.oecd.org/science/inno/38235147.pdf","subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"}],"contributors":[],"dates":[{"date":"2026-02-23T12:03:13Z","dateType":"Submitted","dateInformation":"v1"},{"date":"2026-02-24T02:24:05Z","dateType":"Updated","dateInformation":"v1"},{"date":"2026-02","dateType":"Available","dateInformation":"v1"},{"date":"2026","dateType":"Issued"}],"language":null,"types":{"schemaOrg":"CreativeWork","resourceTypeGeneral":"Preprint","citeproc":"article","bibtex":"misc","ris":"GEN","resourceType":"Article"},"relatedIdentifiers":[{"relationType":"IsVersionOf","relatedIdentifier":"10.3390/digital2010001","relatedIdentifierType":"DOI"}],"relatedItems":[],"sizes":[],"formats":[],"version":"1","rightsList":[{"rightsIdentifierScheme":"SPDX","rightsUri":"https://creativecommons.org/licenses/by-nc-nd/4.0/legalcode","schemeUri":"https://spdx.org/licenses/","rights":"Creative Commons Attribution Non Commercial No Derivatives 4.0 International","rightsIdentifier":"cc-by-nc-nd-4.0"}],"descriptions":[{"descriptionType":"Abstract","description":"From a small community of pioneering artists who experimented with artificial intelligence (AI) in the 1970s, AI art has expanded, gained visibility, and attained socio-cultural relevance since the second half of the 2010s. Its topics, methodologies, presentational formats, and implications are closely related to a range of disciplines engaged in the research and application of AI. In this paper, I present a comprehensive framework for the critical exploration of AI art. It comprises the context of AI art, its prominent poetic features, major issues, and possible directions. I address the poetic, expressive, and ethical layers of AI art practices within the context of contemporary art, AI research, and related disciplines. I focus on the works that exemplify poetic complexity and manifest the epistemic or political ambiguities indicative of a broader milieu of contemporary culture, AI science, technology, economy, and society. By comparing, acknowledging, and contextualizing both their accomplishments and shortcomings, I outline the prospective strategies to advance the field. The aim of this framework is to expand the existing critical discourse of AI art with new perspectives which can be used to examine the creative attributes of emerging practices and to assess their cultural significance and socio-political impact. It contributes to rethinking and redefining the art/science/technology critique in the age when the arts, together with science and technology, are becoming increasingly responsible for changing ecologies, shaping cultural values, and political normalization."},{"descriptionType":"Other","description":"32 pages"}],"geoLocations":[],"fundingReferences":[],"url":"https://arxiv.org/abs/2602.19754","contentUrl":null,"metadataVersion":0,"schemaVersion":"http://datacite.org/schema/kernel-4","source":"mds","isActive":true,"state":"findable","reason":null,"viewCount":0,"downloadCount":0,"referenceCount":0,"citationCount":0,"partCount":0,"partOfCount":0,"versionCount":0,"versionOfCount":1,"created":"2026-02-25T15:13:27Z","registered":"2026-02-25T15:13:28Z","published":null,"updated":"2026-02-25T15:13:28Z"},"relationships":{"client":{"data":{"id":"arxiv.content","type":"clients"}}}},{"id":"10.48550/arxiv.2602.19753","type":"dois","attributes":{"doi":"10.48550/arxiv.2602.19753","identifiers":[{"identifier":"2602.19753","identifierType":"arXiv"}],"creators":[{"nameType":"Personal","givenName":"Kaifa","familyName":"Yang","name":"Yang, Kaifa","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Qi","familyName":"Yang","name":"Yang, Qi","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Yiling","familyName":"Xu","name":"Xu, Yiling","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Zhu","familyName":"Li","name":"Li, Zhu","affiliation":[],"nameIdentifiers":[]}],"titles":[{"title":"RAP: Fast Feedforward Rendering-Free Attribute-Guided Primitive Importance Score Prediction for Efficient 3D Gaussian Splatting Processing"}],"publisher":"arXiv","container":{},"publicationYear":2026,"subjects":[{"subject":"Computer Vision and Pattern Recognition (cs.CV)","lang":"en","subjectScheme":"arXiv"},{"subject":"Graphics (cs.GR)","lang":"en","subjectScheme":"arXiv"},{"subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"},{"schemeUri":"http://www.oecd.org/science/inno/38235147.pdf","subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"}],"contributors":[],"dates":[{"date":"2026-02-23T12:02:03Z","dateType":"Submitted","dateInformation":"v1"},{"date":"2026-02-24T02:23:58Z","dateType":"Updated","dateInformation":"v1"},{"date":"2026-02","dateType":"Available","dateInformation":"v1"},{"date":"2026","dateType":"Issued"}],"language":null,"types":{"schemaOrg":"CreativeWork","resourceTypeGeneral":"Preprint","citeproc":"article","bibtex":"misc","ris":"GEN","resourceType":"Article"},"relatedIdentifiers":[],"relatedItems":[],"sizes":[],"formats":[],"version":"1","rightsList":[{"rightsIdentifierScheme":"SPDX","rightsUri":"https://creativecommons.org/licenses/by/4.0/legalcode","schemeUri":"https://spdx.org/licenses/","rights":"Creative Commons Attribution 4.0 International","rightsIdentifier":"cc-by-4.0"}],"descriptions":[{"descriptionType":"Abstract","description":"3D Gaussian Splatting (3DGS) has emerged as a leading technology for high-quality 3D scene reconstruction. However, the iterative refinement and densification process leads to the generation of a large number of primitives, each contributing to the reconstruction to a substantially different extent. Estimating primitive importance is thus crucial, both for removing redundancy during reconstruction and for enabling efficient compression and transmission. Existing methods typically rely on rendering-based analyses, where each primitive is evaluated through its contribution across multiple camera viewpoints. However, such methods are sensitive to the number and selection of views, rely on specialized differentiable rasterizers, and have long calculation times that grow linearly with view count, making them difficult to integrate as plug-and-play modules and limiting scalability and generalization. To address these issues, we propose RAP, a fast feedforward rendering-free attribute-guided method for efficient importance score prediction in 3DGS. RAP infers primitive significance directly from intrinsic Gaussian attributes and local neighborhood statistics, avoiding rendering-based or visibility-dependent computations. A compact MLP predicts per-primitive importance scores using rendering loss, pruning-aware loss, and significance distribution regularization. After training on a small set of scenes, RAP generalizes effectively to unseen data and can be seamlessly integrated into reconstruction, compression, and transmission pipelines. Our code is publicly available at https://github.com/yyyykf/RAP."},{"descriptionType":"Other","description":"Accepted by CVPR 2026"}],"geoLocations":[],"fundingReferences":[],"url":"https://arxiv.org/abs/2602.19753","contentUrl":null,"metadataVersion":0,"schemaVersion":"http://datacite.org/schema/kernel-4","source":"mds","isActive":true,"state":"findable","reason":null,"viewCount":0,"downloadCount":0,"referenceCount":0,"citationCount":0,"partCount":0,"partOfCount":0,"versionCount":0,"versionOfCount":0,"created":"2026-02-25T15:13:25Z","registered":"2026-02-25T15:13:26Z","published":null,"updated":"2026-02-25T15:13:26Z"},"relationships":{"client":{"data":{"id":"arxiv.content","type":"clients"}}}},{"id":"10.48550/arxiv.2602.19752","type":"dois","attributes":{"doi":"10.48550/arxiv.2602.19752","identifiers":[{"identifier":"2602.19752","identifierType":"arXiv"}],"creators":[{"nameType":"Personal","givenName":"Jungyun","familyName":"Lee","name":"Lee, Jungyun","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Daniel K.","familyName":"Park","name":"Park, Daniel K.","affiliation":[],"nameIdentifiers":[]}],"titles":[{"title":"Improving Generalization and Trainability of Quantum Eigensolvers via Graph Neural Encoding"}],"publisher":"arXiv","container":{},"publicationYear":2026,"subjects":[{"subject":"Quantum Physics (quant-ph)","lang":"en","subjectScheme":"arXiv"},{"subject":"FOS: Physical sciences","subjectScheme":"Fields of Science and Technology (FOS)"},{"schemeUri":"http://www.oecd.org/science/inno/38235147.pdf","subject":"FOS: Physical sciences","subjectScheme":"Fields of Science and Technology (FOS)"}],"contributors":[],"dates":[{"date":"2026-02-23T12:01:14Z","dateType":"Submitted","dateInformation":"v1"},{"date":"2026-02-24T02:23:56Z","dateType":"Updated","dateInformation":"v1"},{"date":"2026-02","dateType":"Available","dateInformation":"v1"},{"date":"2026","dateType":"Issued"}],"language":null,"types":{"schemaOrg":"CreativeWork","resourceTypeGeneral":"Preprint","citeproc":"article","bibtex":"misc","ris":"GEN","resourceType":"Article"},"relatedIdentifiers":[],"relatedItems":[],"sizes":[],"formats":[],"version":"1","rightsList":[{"rightsUri":"http://arxiv.org/licenses/nonexclusive-distrib/1.0/","rights":"arXiv.org perpetual, non-exclusive license"}],"descriptions":[{"descriptionType":"Abstract","description":"Determining the ground state of a many-body Hamiltonian is a central problem across physics, chemistry, and combinatorial optimization, yet it is often classically intractable due to the exponential growth of Hilbert space with system size. Even on fault-tolerant quantum computers, quantum algorithms with convergence guarantees -- such as quantum phase estimation and quantum subspace methods -- require an initial state with sufficiently large overlap with the true ground state to be effective. Variational quantum eigensolvers (VQEs) are natural candidates for preparing such states; however, standard VQEs typically exhibit poor generalization, requiring retraining for each Hamiltonian instance, and often suffer from barren plateaus, where gradients can vanish exponentially with circuit depth and system size. To address these limitations, we propose an end-to-end representation learning framework that combines a graph autoencoder with a classical neural network to generate VQE parameters that generalize across Hamiltonian instances. By encoding interaction topology and coupling structure, the proposed model produces high-overlap initial states without instance-specific optimization. Through extensive numerical experiments on families of one- and two-local Hamiltonians, we demonstrate improved generalization and trainability, manifested as reduced test error and a significantly milder decay of gradient variance. We further show that our method substantially accelerates convergence in quantum subspace-based eigensolvers, highlighting its practical impact for downstream quantum algorithms."}],"geoLocations":[],"fundingReferences":[],"url":"https://arxiv.org/abs/2602.19752","contentUrl":null,"metadataVersion":0,"schemaVersion":"http://datacite.org/schema/kernel-4","source":"mds","isActive":true,"state":"findable","reason":null,"viewCount":0,"downloadCount":0,"referenceCount":0,"citationCount":0,"partCount":0,"partOfCount":0,"versionCount":0,"versionOfCount":0,"created":"2026-02-25T15:13:23Z","registered":"2026-02-25T15:13:23Z","published":null,"updated":"2026-02-25T15:13:23Z"},"relationships":{"client":{"data":{"id":"arxiv.content","type":"clients"}}}},{"id":"10.48550/arxiv.2602.19751","type":"dois","attributes":{"doi":"10.48550/arxiv.2602.19751","identifiers":[{"identifier":"2602.19751","identifierType":"arXiv"}],"creators":[{"nameType":"Personal","givenName":"Silvia","familyName":"Cingolani","name":"Cingolani, Silvia","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Marco","familyName":"Gallo","name":"Gallo, Marco","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Kazunaga","familyName":"Tanaka","name":"Tanaka, Kazunaga","affiliation":[],"nameIdentifiers":[]}],"titles":[{"title":"A Lagrangian approach for prescribed mass solutions of cubic-quintic Schrödinger equations and $L^2$-supercritical problems"}],"publisher":"arXiv","container":{},"publicationYear":2026,"subjects":[{"subject":"Analysis of PDEs (math.AP)","lang":"en","subjectScheme":"arXiv"},{"subject":"FOS: Mathematics","subjectScheme":"Fields of Science and Technology (FOS)"},{"schemeUri":"http://www.oecd.org/science/inno/38235147.pdf","subject":"FOS: Mathematics","subjectScheme":"Fields of Science and Technology (FOS)"},{"subject":"35J20, 35A01, 35B38, 58E05, 35J91, 35Q40, 35Q55, 47J30, 49J35","lang":"en","subjectScheme":"MSC"}],"contributors":[],"dates":[{"date":"2026-02-23T12:00:06Z","dateType":"Submitted","dateInformation":"v1"},{"date":"2026-02-24T02:23:50Z","dateType":"Updated","dateInformation":"v1"},{"date":"2026-02","dateType":"Available","dateInformation":"v1"},{"date":"2026","dateType":"Issued"}],"language":null,"types":{"schemaOrg":"CreativeWork","resourceTypeGeneral":"Preprint","citeproc":"article","bibtex":"misc","ris":"GEN","resourceType":"Article"},"relatedIdentifiers":[],"relatedItems":[],"sizes":[],"formats":[],"version":"1","rightsList":[{"rightsUri":"http://arxiv.org/licenses/nonexclusive-distrib/1.0/","rights":"arXiv.org perpetual, non-exclusive license"}],"descriptions":[{"descriptionType":"Abstract","description":"We study the existence of radially symmetric solutions of the following nonlinear scalar field equations in $\\mathbb R^N$ ($N \\geq 2$):\n $$ (*)_m \\quad - Δu + μu = g(u) \\quad \\text{in}\\ {\\mathbb R}^N, \\quad {1\\over 2} \\int_{{\\mathbb R}^N} u^2\\, dx = m,$$\n where $g(s) \\in C({\\mathbb R},{\\mathbb R})$, $m \u0026gt; 0$ and $μ\\in {\\mathbb R}$ is an unknown Lagrangian multiplier. We take an approach using a Lagrangian formulation of $(*)_m$:\n $$J_m(μ,u)={1\\over 2}\\int_{{\\mathbb R}^N} |\\nabla u|^2\\,dx -\\int_{{\\mathbb R}^N} G(u)\\,dx +μ\\left({1\\over 2}\\int_{{\\mathbb R}^N} u^2\\, dx-m\\right) \\in C^1((0,\\infty)\\times H_r^1({\\mathbb R}^N), {\\mathbb R})$$\n and we give new general existence results through the function:\n $$ b_m:\\, (0,\\infty) \\to {\\mathbb R};\\ μ\\mapsto \\text{Mountain Pass minimax value for}\\ (u\\mapsto J_m(μ,u)).$$\n We will show the existence of solutions of $(*)_m$ related to local minima and local maxima of $b_m(μ)$. As applications, we study cubic-quintic type equations and $L^2$-supercritical problems. In particular, when $N=2,3$, we show new existence results of normalized solutions without assuming global Ambrosetti-Rabinowitz type conditions, which partially improve the preceding results due to Jeanjean [24] and Jeanjean-Lu [26, 28]."},{"descriptionType":"Other","description":"40 pages, 5 figures"}],"geoLocations":[],"fundingReferences":[],"url":"https://arxiv.org/abs/2602.19751","contentUrl":null,"metadataVersion":0,"schemaVersion":"http://datacite.org/schema/kernel-4","source":"mds","isActive":true,"state":"findable","reason":null,"viewCount":0,"downloadCount":0,"referenceCount":0,"citationCount":0,"partCount":0,"partOfCount":0,"versionCount":0,"versionOfCount":0,"created":"2026-02-25T15:13:20Z","registered":"2026-02-25T15:13:21Z","published":null,"updated":"2026-02-25T15:13:21Z"},"relationships":{"client":{"data":{"id":"arxiv.content","type":"clients"}}}},{"id":"10.48550/arxiv.2602.19749","type":"dois","attributes":{"doi":"10.48550/arxiv.2602.19749","identifiers":[{"identifier":"2602.19749","identifierType":"arXiv"}],"creators":[{"nameType":"Personal","affiliation":["Department of Physics, Technische Universität Dortmund, Dortmund, Germany"],"givenName":"Yannik","familyName":"Brune","name":"Brune, Yannik","nameIdentifiers":[]},{"nameType":"Personal","affiliation":["Department of Physics, Technische Universität Dortmund, Dortmund, Germany","School of Mathematical and Physical Sciences, University of Sheffield, Sheffield, UK"],"givenName":"Marius","familyName":"Cizauskas","name":"Cizauskas, Marius","nameIdentifiers":[]},{"nameType":"Personal","affiliation":["Department of Physics, Technische Universität Dortmund, Dortmund, Germany","Dortmund Center for Advanced Exploration of Dynamics Across Limits Using Spectroscopy"],"givenName":"Marc","familyName":"Aßmann","name":"Aßmann, Marc","nameIdentifiers":[]}],"titles":[{"title":"Quantum Resource Theory of Lasers"}],"publisher":"arXiv","container":{},"publicationYear":2026,"subjects":[{"subject":"Mesoscale and Nanoscale Physics (cond-mat.mes-hall)","lang":"en","subjectScheme":"arXiv"},{"subject":"Quantum Physics (quant-ph)","lang":"en","subjectScheme":"arXiv"},{"subject":"FOS: Physical sciences","subjectScheme":"Fields of Science and Technology (FOS)"},{"schemeUri":"http://www.oecd.org/science/inno/38235147.pdf","subject":"FOS: Physical sciences","subjectScheme":"Fields of Science and Technology (FOS)"}],"contributors":[],"dates":[{"date":"2026-02-23T11:59:09Z","dateType":"Submitted","dateInformation":"v1"},{"date":"2026-02-24T02:23:44Z","dateType":"Updated","dateInformation":"v1"},{"date":"2026-02","dateType":"Available","dateInformation":"v1"},{"date":"2026","dateType":"Issued"}],"language":null,"types":{"schemaOrg":"CreativeWork","resourceTypeGeneral":"Preprint","citeproc":"article","bibtex":"misc","ris":"GEN","resourceType":"Article"},"relatedIdentifiers":[{"relationType":"IsVersionOf","relatedIdentifier":"10.1103/nchs-mvlw","relatedIdentifierType":"DOI"}],"relatedItems":[],"sizes":[],"formats":[],"version":"1","rightsList":[{"rightsUri":"http://arxiv.org/licenses/nonexclusive-distrib/1.0/","rights":"arXiv.org perpetual, non-exclusive license"}],"descriptions":[{"descriptionType":"Abstract","description":"Lasers serve as the fundamental workhorses of photonic quantum technologies, with perfectly coherent light fields being essential for many protocols that generate nonclassical light, implement coherent control schemes, and initialize qubits. However, no laser is absolutely ideal and the implications of deviations from perfect coherence in quantum technological tasks remain unclear. In this study, we theoretically and experimentally explore the quantum coherence properties of lasers from a resource theory perspective, establishing a significant connection between photonics, quantum optics, and quantum information science. We demonstrate that the maximum achievable quantum coherence for laser light is constrained by spontaneous emission and the purity of the dephased laser field state. As a critical example application in quantum information protocols, we show that the quantum coherence of a laser field with a given mean photon number directly governs the maximum purity attainable when initializing a qubit in a superposition state through resonant driving. Our findings are highly relevant for bridging applied physics and engineering with integrated photonic quantum technologies and resource theories, paving the way for reliable benchmarking of various coherent light sources for applications in photonics and quantum protocols."},{"descriptionType":"Other","description":"39 pages, 11 figures"}],"geoLocations":[],"fundingReferences":[],"url":"https://arxiv.org/abs/2602.19749","contentUrl":null,"metadataVersion":0,"schemaVersion":"http://datacite.org/schema/kernel-4","source":"mds","isActive":true,"state":"findable","reason":null,"viewCount":0,"downloadCount":0,"referenceCount":0,"citationCount":0,"partCount":0,"partOfCount":0,"versionCount":0,"versionOfCount":1,"created":"2026-02-25T15:13:13Z","registered":"2026-02-25T15:13:14Z","published":null,"updated":"2026-02-25T15:13:14Z"},"relationships":{"client":{"data":{"id":"arxiv.content","type":"clients"}}}},{"id":"10.48550/arxiv.2602.19748","type":"dois","attributes":{"doi":"10.48550/arxiv.2602.19748","identifiers":[{"identifier":"2602.19748","identifierType":"arXiv"}],"creators":[{"nameType":"Personal","givenName":"Chang","familyName":"Li","name":"Li, Chang","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Aijin","familyName":"Lin","name":"Lin, Aijin","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Liangming","familyName":"Shen","name":"Shen, Liangming","affiliation":[],"nameIdentifiers":[]}],"titles":[{"title":"The character of ideal circle patterns"}],"publisher":"arXiv","container":{},"publicationYear":2026,"subjects":[{"subject":"Differential Geometry (math.DG)","lang":"en","subjectScheme":"arXiv"},{"subject":"Geometric Topology (math.GT)","lang":"en","subjectScheme":"arXiv"},{"subject":"FOS: Mathematics","subjectScheme":"Fields of Science and Technology (FOS)"},{"schemeUri":"http://www.oecd.org/science/inno/38235147.pdf","subject":"FOS: Mathematics","subjectScheme":"Fields of Science and Technology (FOS)"},{"subject":"51M10, 52C15, 05E45","lang":"en","subjectScheme":"MSC"}],"contributors":[],"dates":[{"date":"2026-02-23T11:55:34Z","dateType":"Submitted","dateInformation":"v1"},{"date":"2026-02-24T02:23:34Z","dateType":"Updated","dateInformation":"v1"},{"date":"2026-02","dateType":"Available","dateInformation":"v1"},{"date":"2026","dateType":"Issued"}],"language":null,"types":{"schemaOrg":"CreativeWork","resourceTypeGeneral":"Preprint","citeproc":"article","bibtex":"misc","ris":"GEN","resourceType":"Article"},"relatedIdentifiers":[],"relatedItems":[],"sizes":[],"formats":[],"version":"1","rightsList":[{"rightsIdentifierScheme":"SPDX","rightsUri":"https://creativecommons.org/licenses/by-nc-sa/4.0/legalcode","schemeUri":"https://spdx.org/licenses/","rights":"Creative Commons Attribution Non Commercial Share Alike 4.0 International","rightsIdentifier":"cc-by-nc-sa-4.0"}],"descriptions":[{"descriptionType":"Abstract","description":"Let $S$ be an oriented closed surface with a cellular decomposition $\\mathcal{D}$ and a weight $Φ\\in(0, π)$. It is crucial to determine when $S$ supports an ideal $\\mathcal{D}$-type circle pattern $\\mathcal{P}$ with the exterior intersection angles given by $Φ$. Rivin, Bobenko-Springborn and Ge-Hua-Zhou provided perfect solutions and gave wonderful criteria for the existence and uniqueness of ideal circle patterns. However, all criteria established by Rivin, Bobenko-Springborn and Ge-Hua-Zhou are extremely difficult to verify for the given cellular decomposition $\\mathcal{D}$ and the weight $Φ$. In this paper, we introduce the character $\\mathcal{L}(\\mathcal{D},Φ)$ depends only on the data of the weighted cellular decomposition $(\\mathcal D, Φ)$ on $S$, and give some quite simple criteria for the existence of ideal circle patterns realizing $(\\mathcal{D},Φ)$. It seems that our character-type criteria are the first conditions totally different from criteria of Rivin, Bobenko-Springborn and Ge-Hua-Zhou, and provide more easily verifiable criteria. Our new character-type theorems may be of some independent interest. As an application, we give a new descriptions of the curvature image set $\\mathbf{K}(\\mathbb{R}^N_{\u0026gt;0})$. To approach our results, we shall use the combinatorial Ricci flows with ideal circle patterns introduced by Ge-Hua-Zhou as a fundamental tool. The main difficulty in the proof of our results is to establish the compactness of the solution to the flows. To circumvent the difficulty, we borrow the techniques developed by Ge and his collaborators."},{"descriptionType":"Other","description":"30 pages"}],"geoLocations":[],"fundingReferences":[],"url":"https://arxiv.org/abs/2602.19748","contentUrl":null,"metadataVersion":0,"schemaVersion":"http://datacite.org/schema/kernel-4","source":"mds","isActive":true,"state":"findable","reason":null,"viewCount":0,"downloadCount":0,"referenceCount":0,"citationCount":0,"partCount":0,"partOfCount":0,"versionCount":0,"versionOfCount":0,"created":"2026-02-25T15:13:11Z","registered":"2026-02-25T15:13:12Z","published":null,"updated":"2026-02-25T15:13:12Z"},"relationships":{"client":{"data":{"id":"arxiv.content","type":"clients"}}}},{"id":"10.48550/arxiv.2602.19744","type":"dois","attributes":{"doi":"10.48550/arxiv.2602.19744","identifiers":[{"identifier":"2602.19744","identifierType":"arXiv"}],"creators":[{"nameType":"Personal","givenName":"Fritz","familyName":"Schweiger","name":"Schweiger, Fritz","affiliation":[],"nameIdentifiers":[]}],"titles":[{"title":"Invariant measures for piesewise fractional linear maps"}],"publisher":"arXiv","container":{},"publicationYear":2026,"subjects":[{"subject":"Dynamical Systems (math.DS)","lang":"en","subjectScheme":"arXiv"},{"subject":"FOS: Mathematics","subjectScheme":"Fields of Science and Technology (FOS)"},{"schemeUri":"http://www.oecd.org/science/inno/38235147.pdf","subject":"FOS: Mathematics","subjectScheme":"Fields of Science and Technology (FOS)"},{"subject":"37A05, 11K55","lang":"en","subjectScheme":"MSC"}],"contributors":[],"dates":[{"date":"2026-02-23T11:48:06Z","dateType":"Submitted","dateInformation":"v1"},{"date":"2026-02-24T02:23:20Z","dateType":"Updated","dateInformation":"v1"},{"date":"2026-02","dateType":"Available","dateInformation":"v1"},{"date":"2026","dateType":"Issued"}],"language":null,"types":{"schemaOrg":"CreativeWork","resourceTypeGeneral":"Preprint","citeproc":"article","bibtex":"misc","ris":"GEN","resourceType":"Article"},"relatedIdentifiers":[],"relatedItems":[],"sizes":[],"formats":[],"version":"1","rightsList":[{"rightsIdentifierScheme":"SPDX","rightsUri":"https://creativecommons.org/licenses/by/4.0/legalcode","schemeUri":"https://spdx.org/licenses/","rights":"Creative Commons Attribution 4.0 International","rightsIdentifier":"cc-by-4.0"}],"descriptions":[{"descriptionType":"Abstract","description":"The first part deals with piecewise fractional linear maps with three branches. Given a map $T$ a map $S$ is called a related map if some branches of $T$ are replaced by a 'flipped' branch, namely a branch of $1-T$. The main question is if $T$ and $S$ have a common invariant measure. The short second part presents invariant measures of a new type."},{"descriptionType":"Other","description":"12 pages"}],"geoLocations":[],"fundingReferences":[],"url":"https://arxiv.org/abs/2602.19744","contentUrl":null,"metadataVersion":0,"schemaVersion":"http://datacite.org/schema/kernel-4","source":"mds","isActive":true,"state":"findable","reason":null,"viewCount":0,"downloadCount":0,"referenceCount":0,"citationCount":0,"partCount":0,"partOfCount":0,"versionCount":0,"versionOfCount":0,"created":"2026-02-25T15:13:01Z","registered":"2026-02-25T15:13:02Z","published":null,"updated":"2026-02-25T15:13:02Z"},"relationships":{"client":{"data":{"id":"arxiv.content","type":"clients"}}}},{"id":"10.48550/arxiv.2602.19743","type":"dois","attributes":{"doi":"10.48550/arxiv.2602.19743","identifiers":[{"identifier":"2602.19743","identifierType":"arXiv"}],"creators":[{"nameType":"Personal","givenName":"Tristan","familyName":"Kneisel","name":"Kneisel, Tristan","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Marko","familyName":"Schmellenkamp","name":"Schmellenkamp, Marko","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Fabian","familyName":"Vehlken","name":"Vehlken, Fabian","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Thomas","familyName":"Zeume","name":"Zeume, Thomas","affiliation":[],"nameIdentifiers":[]}],"titles":[{"title":"NILE: Formalizing Natural-Language Descriptions of Formal Languages"}],"publisher":"arXiv","container":{},"publicationYear":2026,"subjects":[{"subject":"Formal Languages and Automata Theory (cs.FL)","lang":"en","subjectScheme":"arXiv"},{"subject":"Computation and Language (cs.CL)","lang":"en","subjectScheme":"arXiv"},{"subject":"Logic in Computer Science (cs.LO)","lang":"en","subjectScheme":"arXiv"},{"subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"},{"schemeUri":"http://www.oecd.org/science/inno/38235147.pdf","subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"}],"contributors":[],"dates":[{"date":"2026-02-23T11:42:56Z","dateType":"Submitted","dateInformation":"v1"},{"date":"2026-02-24T02:23:12Z","dateType":"Updated","dateInformation":"v1"},{"date":"2026-02","dateType":"Available","dateInformation":"v1"},{"date":"2026","dateType":"Issued"}],"language":null,"types":{"schemaOrg":"CreativeWork","resourceTypeGeneral":"Preprint","citeproc":"article","bibtex":"misc","ris":"GEN","resourceType":"Article"},"relatedIdentifiers":[],"relatedItems":[],"sizes":[],"formats":[],"version":"1","rightsList":[{"rightsUri":"http://arxiv.org/licenses/nonexclusive-distrib/1.0/","rights":"arXiv.org perpetual, non-exclusive license"}],"descriptions":[{"descriptionType":"Abstract","description":"This paper explores how natural-language descriptions of formal languages can be compared to their formal representations and how semantic differences can be explained. This is motivated from educational scenarios where learners describe a formal language (presented, e.g., by a finite state automaton, regular expression, pushdown automaton, context-free grammar or in set notation) in natural language, and an educational support system has to (1) judge whether the natural-language description accurately describes the formal language, and to (2) provide explanations why descriptions are not accurate.\n To address this question, we introduce a representation language for formal languages, Nile, which is designed so that Nile expressions can mirror the syntactic structure of natural-language descriptions of formal languages. Nile is sufficiently expressive to cover a broad variety of formal languages, including all regular languages and fragments of context-free languages typically used in educational contexts. Generating Nile expressions that are syntactically close to natural-language descriptions then allows to provide explanations for inaccuracies in the descriptions algorithmically.\n In experiments on an educational data set, we show that LLMs can translate natural-language descriptions into equivalent, syntactically close Nile expressions with high accuracy - allowing to algorithmically provide explanations for incorrect natural-language descriptions. Our experiments also show that while natural-language descriptions can also be translated into regular expressions (but not context-free grammars), the expressions are often not syntactically close and thus not suitable for providing explanations."}],"geoLocations":[],"fundingReferences":[],"url":"https://arxiv.org/abs/2602.19743","contentUrl":null,"metadataVersion":0,"schemaVersion":"http://datacite.org/schema/kernel-4","source":"mds","isActive":true,"state":"findable","reason":null,"viewCount":0,"downloadCount":0,"referenceCount":0,"citationCount":0,"partCount":0,"partOfCount":0,"versionCount":0,"versionOfCount":0,"created":"2026-02-25T15:12:59Z","registered":"2026-02-25T15:12:59Z","published":null,"updated":"2026-02-25T15:12:59Z"},"relationships":{"client":{"data":{"id":"arxiv.content","type":"clients"}}}},{"id":"10.48550/arxiv.2602.19742","type":"dois","attributes":{"doi":"10.48550/arxiv.2602.19742","identifiers":[{"identifier":"2602.19742","identifierType":"arXiv"}],"creators":[{"nameType":"Personal","givenName":"Yulun","familyName":"Huang","name":"Huang, Yulun","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Zhiyu","familyName":"Wang","name":"Wang, Zhiyu","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Rajkumar","familyName":"Buyya","name":"Buyya, Rajkumar","affiliation":[],"nameIdentifiers":[]}],"titles":[{"title":"A Risk-Aware UAV-Edge Service Framework for Wildfire Monitoring and Emergency Response"}],"publisher":"arXiv","container":{},"publicationYear":2026,"subjects":[{"subject":"Distributed, Parallel, and Cluster Computing (cs.DC)","lang":"en","subjectScheme":"arXiv"},{"subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"},{"schemeUri":"http://www.oecd.org/science/inno/38235147.pdf","subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"}],"contributors":[],"dates":[{"date":"2026-02-23T11:40:41Z","dateType":"Submitted","dateInformation":"v1"},{"date":"2026-02-24T02:23:02Z","dateType":"Updated","dateInformation":"v1"},{"date":"2026-02","dateType":"Available","dateInformation":"v1"},{"date":"2026","dateType":"Issued"}],"language":null,"types":{"schemaOrg":"CreativeWork","resourceTypeGeneral":"Preprint","citeproc":"article","bibtex":"misc","ris":"GEN","resourceType":"Article"},"relatedIdentifiers":[],"relatedItems":[],"sizes":[],"formats":[],"version":"1","rightsList":[{"rightsIdentifierScheme":"SPDX","rightsUri":"https://creativecommons.org/licenses/by/4.0/legalcode","schemeUri":"https://spdx.org/licenses/","rights":"Creative Commons Attribution 4.0 International","rightsIdentifier":"cc-by-4.0"}],"descriptions":[{"descriptionType":"Abstract","description":"Wildfire monitoring demands timely data collection and processing for early detection and rapid response. UAV-assisted edge computing is a promising approach, but jointly minimizing end-to-end service response time while satisfying energy, revisit time, and capacity constraints remains challenging. We propose an integrated framework that co-optimizes UAV route planning, fleet sizing, and edge service provisioning for wildfire monitoring. The framework combines fire-history-weighted clustering to prioritize high-risk areas, Quality of Service (QoS)-aware edge assignment balancing proximity and computational load, 2-opt route optimization with adaptive fleet sizing, and a dynamic emergency rerouting mechanism. The key insight is that these subproblems are interdependent: clustering decisions simultaneously shape patrol efficiency and edge workloads, while capacity constraints feed back into feasible configurations. Experiments show that the proposed framework reduces average response time by 70.6--84.2%, energy consumption by 73.8--88.4%, and fleet size by 26.7--42.1% compared to GA, PSO, and greedy baselines. The emergency mechanism responds within 233 seconds, well under the 300-second deadline, with negligible impact on normal operations."}],"geoLocations":[],"fundingReferences":[],"url":"https://arxiv.org/abs/2602.19742","contentUrl":null,"metadataVersion":0,"schemaVersion":"http://datacite.org/schema/kernel-4","source":"mds","isActive":true,"state":"findable","reason":null,"viewCount":0,"downloadCount":0,"referenceCount":0,"citationCount":0,"partCount":0,"partOfCount":0,"versionCount":0,"versionOfCount":0,"created":"2026-02-25T15:12:56Z","registered":"2026-02-25T15:12:57Z","published":null,"updated":"2026-02-25T15:12:57Z"},"relationships":{"client":{"data":{"id":"arxiv.content","type":"clients"}}}},{"id":"10.48550/arxiv.2602.19740","type":"dois","attributes":{"doi":"10.48550/arxiv.2602.19740","identifiers":[{"identifier":"2602.19740","identifierType":"arXiv"}],"creators":[{"nameType":"Personal","givenName":"Julia","familyName":"Manso","name":"Manso, Julia","affiliation":[],"nameIdentifiers":[]}],"titles":[{"title":"Volatility Spillovers in China's Real Estate Crisis: A Network Approach"}],"publisher":"arXiv","container":{},"publicationYear":2026,"subjects":[{"subject":"Econometrics (econ.EM)","lang":"en","subjectScheme":"arXiv"},{"subject":"Applications (stat.AP)","lang":"en","subjectScheme":"arXiv"},{"subject":"FOS: Economics and business","subjectScheme":"Fields of Science and Technology (FOS)"},{"schemeUri":"http://www.oecd.org/science/inno/38235147.pdf","subject":"FOS: Economics and business","subjectScheme":"Fields of Science and Technology (FOS)"},{"subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"},{"schemeUri":"http://www.oecd.org/science/inno/38235147.pdf","subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"}],"contributors":[],"dates":[{"date":"2026-02-23T11:36:35Z","dateType":"Submitted","dateInformation":"v1"},{"date":"2026-02-24T02:22:46Z","dateType":"Updated","dateInformation":"v1"},{"date":"2026-02","dateType":"Available","dateInformation":"v1"},{"date":"2026","dateType":"Issued"}],"language":null,"types":{"schemaOrg":"CreativeWork","resourceTypeGeneral":"Preprint","citeproc":"article","bibtex":"misc","ris":"GEN","resourceType":"Article"},"relatedIdentifiers":[],"relatedItems":[],"sizes":[],"formats":[],"version":"1","rightsList":[{"rightsIdentifierScheme":"SPDX","rightsUri":"https://creativecommons.org/licenses/by-sa/4.0/legalcode","schemeUri":"https://spdx.org/licenses/","rights":"Creative Commons Attribution Share Alike 4.0 International","rightsIdentifier":"cc-by-sa-4.0"}],"descriptions":[{"descriptionType":"Abstract","description":"Sentiment towards the Chinese real estate sector has deteriorated following the introduction of financing constraints in 2020 with the ''three red lines.\" Forcing developers to restructure their debt, the policy triggered a cascade of financing troubles, defaults, and reduced housing demand, ultimately culminating in a prolonged real estate crisis. This paper utilizes a network approach in line with Demirer et al. (2018) and Diebold and Yilmaz (2014) to measure daily time-varying connectedness in the stock return volatilities of major Chinese real estate developers throughout the crisis. Focusing on spillover between companies as reflected by market perception, this paper examines how connectedness evolves over time across firms with different regional exposures and state-ownership statuses, filling a gap in the literature to elucidate where property demand and real estate firm trustworthiness have deteriorated most. An event-study analysis of four key moments of the crisis outlines distinct phases of market sentiment: with the introduction of the three red lines, connectedness primarily reflects shared exposure and a uniform shock to the market. Then, the early unrest surrounding Evergrande exposes strong regional differentiation, with firms concentrated in less developed regions receiving significant spillover. By one year into the crisis, previously stable regions receive higher levels of spillover, and there is evidence of a substitution effect towards private developers. Two years into the crisis, the market has much less homogeneity in effects across regions and state-ownership status: major shocks induce minimal network changes, reflecting how investors have already priced in their beliefs. This paper also offers one of the most extensive timelines of the Chinese real estate crisis to date, and a new R package, GephiForR, was created for the network visualization in this paper."}],"geoLocations":[],"fundingReferences":[],"url":"https://arxiv.org/abs/2602.19740","contentUrl":null,"metadataVersion":0,"schemaVersion":"http://datacite.org/schema/kernel-4","source":"mds","isActive":true,"state":"findable","reason":null,"viewCount":0,"downloadCount":0,"referenceCount":0,"citationCount":0,"partCount":0,"partOfCount":0,"versionCount":0,"versionOfCount":0,"created":"2026-02-25T15:12:51Z","registered":"2026-02-25T15:12:52Z","published":null,"updated":"2026-02-25T15:12:52Z"},"relationships":{"client":{"data":{"id":"arxiv.content","type":"clients"}}}},{"id":"10.48550/arxiv.2602.19739","type":"dois","attributes":{"doi":"10.48550/arxiv.2602.19739","identifiers":[{"identifier":"2602.19739","identifierType":"arXiv"}],"creators":[{"nameType":"Personal","givenName":"Josef","familyName":"Mikesh","name":"Mikesh, Josef","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Sergey","familyName":"Stepanov","name":"Stepanov, Sergey","affiliation":[],"nameIdentifiers":[]}],"titles":[{"title":"Projective Maps from the Perspective of Elliptic Differential Operators"}],"publisher":"arXiv","container":{},"publicationYear":2026,"subjects":[{"subject":"Differential Geometry (math.DG)","lang":"en","subjectScheme":"arXiv"},{"subject":"FOS: Mathematics","subjectScheme":"Fields of Science and Technology (FOS)"},{"schemeUri":"http://www.oecd.org/science/inno/38235147.pdf","subject":"FOS: Mathematics","subjectScheme":"Fields of Science and Technology (FOS)"},{"subject":"53C20, 35J15, 35J30","lang":"en","subjectScheme":"MSC"}],"contributors":[],"dates":[{"date":"2026-02-23T11:36:08Z","dateType":"Submitted","dateInformation":"v1"},{"date":"2026-02-24T02:22:45Z","dateType":"Updated","dateInformation":"v1"},{"date":"2026-02","dateType":"Available","dateInformation":"v1"},{"date":"2026","dateType":"Issued"}],"language":null,"types":{"schemaOrg":"CreativeWork","resourceTypeGeneral":"Preprint","citeproc":"article","bibtex":"misc","ris":"GEN","resourceType":"Article"},"relatedIdentifiers":[],"relatedItems":[],"sizes":[],"formats":[],"version":"1","rightsList":[{"rightsIdentifierScheme":"SPDX","rightsUri":"https://creativecommons.org/licenses/by/4.0/legalcode","schemeUri":"https://spdx.org/licenses/","rights":"Creative Commons Attribution 4.0 International","rightsIdentifier":"cc-by-4.0"}],"descriptions":[{"descriptionType":"Abstract","description":"This paper develops an analytical approach to the study of the geometry of projective maps using the theory of elliptic differential operators. We construct two elliptic operators of second and fourth order, whose kernels characterize projective diffeomorphisms between Riemannian manifolds and one-parameter groups of projective diffeomorphisms (transformations) of a Riemannian manifold onto itself, respectively. This approach establishes a natural correspondence between analytical and geometric properties, enabling the study of projective diffeomorphisms via operator-theoretic methods. The proposed framework provides a new understanding of projective structures on Riemannian manifolds and extends classical results in differential geometry."}],"geoLocations":[],"fundingReferences":[],"url":"https://arxiv.org/abs/2602.19739","contentUrl":null,"metadataVersion":0,"schemaVersion":"http://datacite.org/schema/kernel-4","source":"mds","isActive":true,"state":"findable","reason":null,"viewCount":0,"downloadCount":0,"referenceCount":0,"citationCount":0,"partCount":0,"partOfCount":0,"versionCount":0,"versionOfCount":0,"created":"2026-02-25T15:12:49Z","registered":"2026-02-25T15:12:50Z","published":null,"updated":"2026-02-25T15:12:50Z"},"relationships":{"client":{"data":{"id":"arxiv.content","type":"clients"}}}},{"id":"10.48550/arxiv.2602.19738","type":"dois","attributes":{"doi":"10.48550/arxiv.2602.19738","identifiers":[{"identifier":"2602.19738","identifierType":"arXiv"}],"creators":[{"nameType":"Personal","givenName":"Yunping","familyName":"Lu","name":"Lu, Yunping","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Haoang","familyName":"Chi","name":"Chi, Haoang","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Qirui","familyName":"Hu","name":"Hu, Qirui","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Zhiheng","familyName":"Zhang","name":"Zhang, Zhiheng","affiliation":[],"nameIdentifiers":[]}],"titles":[{"title":"Individualized Causal Effects under Network Interference with Combinatorial Treatments"}],"publisher":"arXiv","container":{},"publicationYear":2026,"subjects":[{"subject":"Methodology (stat.ME)","lang":"en","subjectScheme":"arXiv"},{"subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"},{"schemeUri":"http://www.oecd.org/science/inno/38235147.pdf","subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"}],"contributors":[],"dates":[{"date":"2026-02-23T11:35:30Z","dateType":"Submitted","dateInformation":"v1"},{"date":"2026-02-24T02:22:38Z","dateType":"Updated","dateInformation":"v1"},{"date":"2026-02","dateType":"Available","dateInformation":"v1"},{"date":"2026","dateType":"Issued"}],"language":null,"types":{"schemaOrg":"CreativeWork","resourceTypeGeneral":"Preprint","citeproc":"article","bibtex":"misc","ris":"GEN","resourceType":"Article"},"relatedIdentifiers":[],"relatedItems":[],"sizes":[],"formats":[],"version":"1","rightsList":[{"rightsUri":"http://arxiv.org/licenses/nonexclusive-distrib/1.0/","rights":"arXiv.org perpetual, non-exclusive license"}],"descriptions":[{"descriptionType":"Abstract","description":"Modern causal decision-making increasingly demands individualized treatment-effect estimation in networks where interventions are high-dimensional, combinatorial vectors. While network interference, effect heterogeneity, and multi-dimensional treatments have been studied separately, their intersection yields an exponentially large intervention space that makes standard identification tools and low-dimensional exposure mappings untenable. We bridge this gap with a unified framework that constructs a \\emph{global potential-outcome emulator} for unit-level inference. Our method combines (1) rooted network configurations to leverage local smoothness, (2) doubly robust orthogonalization to mitigate confounding from network position and covariates, and (3) sparse spectral learning to efficiently estimate response surfaces over the $2^p$-dimensional treatment space. We also decompose networked effects into own-treatment, structural, and interaction components, and provide finite-sample error bounds and asymptotic consistency guarantees. Overall, we show that individualized causal inference remains feasible in high-dimensional networked settings without collapsing the intervention space."}],"geoLocations":[],"fundingReferences":[],"url":"https://arxiv.org/abs/2602.19738","contentUrl":null,"metadataVersion":0,"schemaVersion":"http://datacite.org/schema/kernel-4","source":"mds","isActive":true,"state":"findable","reason":null,"viewCount":0,"downloadCount":0,"referenceCount":0,"citationCount":0,"partCount":0,"partOfCount":0,"versionCount":0,"versionOfCount":0,"created":"2026-02-25T15:12:47Z","registered":"2026-02-25T15:12:47Z","published":null,"updated":"2026-02-25T15:12:47Z"},"relationships":{"client":{"data":{"id":"arxiv.content","type":"clients"}}}},{"id":"10.48550/arxiv.2602.19737","type":"dois","attributes":{"doi":"10.48550/arxiv.2602.19737","identifiers":[{"identifier":"2602.19737","identifierType":"arXiv"}],"creators":[{"nameType":"Personal","givenName":"R.","familyName":"Chan","name":"Chan, R.","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"M. F. A.","familyName":"da Silva","name":"da Silva, M. F. A.","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"N. O.","familyName":"Santos","name":"Santos, N. O.","affiliation":[],"nameIdentifiers":[]}],"titles":[{"title":"Analytic Solutions for Geodesic Motion in Static Axially Symmetric Spacetime"}],"publisher":"arXiv","container":{},"publicationYear":2026,"subjects":[{"subject":"General Relativity and Quantum Cosmology (gr-qc)","lang":"en","subjectScheme":"arXiv"},{"subject":"FOS: Physical sciences","subjectScheme":"Fields of Science and Technology (FOS)"},{"schemeUri":"http://www.oecd.org/science/inno/38235147.pdf","subject":"FOS: Physical sciences","subjectScheme":"Fields of Science and Technology (FOS)"}],"contributors":[],"dates":[{"date":"2026-02-23T11:35:02Z","dateType":"Submitted","dateInformation":"v1"},{"date":"2026-02-24T02:22:36Z","dateType":"Updated","dateInformation":"v1"},{"date":"2026-02","dateType":"Available","dateInformation":"v1"},{"date":"2026","dateType":"Issued"}],"language":null,"types":{"schemaOrg":"CreativeWork","resourceTypeGeneral":"Preprint","citeproc":"article","bibtex":"misc","ris":"GEN","resourceType":"Article"},"relatedIdentifiers":[],"relatedItems":[],"sizes":[],"formats":[],"version":"1","rightsList":[{"rightsUri":"http://arxiv.org/licenses/nonexclusive-distrib/1.0/","rights":"arXiv.org perpetual, non-exclusive license"}],"descriptions":[{"descriptionType":"Abstract","description":"A procedure to find static axially symmetric solutions to the Einstein field equations is presented. We obtained two general solutions and five particular solutions, which depend on the existence conditions for circular and $z$ direction motion. Our endeavour consists making a thoroughrowly analysis of all the possible geodesics solutions stemming from this spacetime."},{"descriptionType":"Other","description":"35 pages and 6 figures"}],"geoLocations":[],"fundingReferences":[],"url":"https://arxiv.org/abs/2602.19737","contentUrl":null,"metadataVersion":0,"schemaVersion":"http://datacite.org/schema/kernel-4","source":"mds","isActive":true,"state":"findable","reason":null,"viewCount":0,"downloadCount":0,"referenceCount":0,"citationCount":0,"partCount":0,"partOfCount":0,"versionCount":0,"versionOfCount":0,"created":"2026-02-25T15:12:44Z","registered":"2026-02-25T15:12:45Z","published":null,"updated":"2026-02-25T15:12:45Z"},"relationships":{"client":{"data":{"id":"arxiv.content","type":"clients"}}}},{"id":"10.48550/arxiv.2602.19735","type":"dois","attributes":{"doi":"10.48550/arxiv.2602.19735","identifiers":[{"identifier":"2602.19735","identifierType":"arXiv"}],"creators":[{"nameType":"Personal","givenName":"Jingyi","familyName":"Xu","name":"Xu, Jingyi","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Zhangshuo","familyName":"Qi","name":"Qi, Zhangshuo","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Zhongmiao","familyName":"Yan","name":"Yan, Zhongmiao","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Xuyu","familyName":"Gao","name":"Gao, Xuyu","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Qianyun","familyName":"Jiao","name":"Jiao, Qianyun","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Songpengcheng","familyName":"Xia","name":"Xia, Songpengcheng","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Xieyuanli","familyName":"Chen","name":"Chen, Xieyuanli","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Ling","familyName":"Pei","name":"Pei, Ling","affiliation":[],"nameIdentifiers":[]}],"titles":[{"title":"VGGT-MPR: VGGT-Enhanced Multimodal Place Recognition in Autonomous Driving Environments"}],"publisher":"arXiv","container":{},"publicationYear":2026,"subjects":[{"subject":"Computer Vision and Pattern Recognition (cs.CV)","lang":"en","subjectScheme":"arXiv"},{"subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"},{"schemeUri":"http://www.oecd.org/science/inno/38235147.pdf","subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"}],"contributors":[],"dates":[{"date":"2026-02-23T11:33:56Z","dateType":"Submitted","dateInformation":"v1"},{"date":"2026-02-24T02:22:33Z","dateType":"Updated","dateInformation":"v1"},{"date":"2026-02","dateType":"Available","dateInformation":"v1"},{"date":"2026","dateType":"Issued"}],"language":null,"types":{"schemaOrg":"CreativeWork","resourceTypeGeneral":"Preprint","citeproc":"article","bibtex":"misc","ris":"GEN","resourceType":"Article"},"relatedIdentifiers":[],"relatedItems":[],"sizes":[],"formats":[],"version":"1","rightsList":[{"rightsUri":"http://arxiv.org/licenses/nonexclusive-distrib/1.0/","rights":"arXiv.org perpetual, non-exclusive license"}],"descriptions":[{"descriptionType":"Abstract","description":"In autonomous driving, robust place recognition is critical for global localization and loop closure detection. While inter-modality fusion of camera and LiDAR data in multimodal place recognition (MPR) has shown promise in overcoming the limitations of unimodal counterparts, existing MPR methods basically attend to hand-crafted fusion strategies and heavily parameterized backbones that require costly retraining. To address this, we propose VGGT-MPR, a multimodal place recognition framework that adopts the Visual Geometry Grounded Transformer (VGGT) as a unified geometric engine for both global retrieval and re-ranking. In the global retrieval stage, VGGT extracts geometrically-rich visual embeddings through prior depth-aware and point map supervision, and densifies sparse LiDAR point clouds with predicted depth maps to improve structural representation. This enhances the discriminative ability of fused multimodal features and produces global descriptors for fast retrieval. Beyond global retrieval, we design a training-free re-ranking mechanism that exploits VGGT's cross-view keypoint-tracking capability. By combining mask-guided keypoint extraction with confidence-aware correspondence scoring, our proposed re-ranking mechanism effectively refines retrieval results without additional parameter optimization. Extensive experiments on large-scale autonomous driving benchmarks and our self-collected data demonstrate that VGGT-MPR achieves state-of-the-art performance, exhibiting strong robustness to severe environmental changes, viewpoint shifts, and occlusions. Our code and data will be made publicly available."}],"geoLocations":[],"fundingReferences":[],"url":"https://arxiv.org/abs/2602.19735","contentUrl":null,"metadataVersion":0,"schemaVersion":"http://datacite.org/schema/kernel-4","source":"mds","isActive":true,"state":"findable","reason":null,"viewCount":0,"downloadCount":0,"referenceCount":0,"citationCount":0,"partCount":0,"partOfCount":0,"versionCount":0,"versionOfCount":0,"created":"2026-02-25T15:12:39Z","registered":"2026-02-25T15:12:40Z","published":null,"updated":"2026-02-25T15:12:40Z"},"relationships":{"client":{"data":{"id":"arxiv.content","type":"clients"}}}},{"id":"10.48550/arxiv.2602.19734","type":"dois","attributes":{"doi":"10.48550/arxiv.2602.19734","identifiers":[{"identifier":"2602.19734","identifierType":"arXiv"}],"creators":[{"nameType":"Personal","givenName":"Alberto M.","familyName":"Ruiz","name":"Ruiz, Alberto M.","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Andrei","familyName":"Shumilin","name":"Shumilin, Andrei","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Rafael","familyName":"González-Hernández","name":"González-Hernández, Rafael","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"José J.","familyName":"Baldoví","name":"Baldoví, José J.","affiliation":[],"nameIdentifiers":[]}],"titles":[{"title":"Twist-induced altermagnetism in a metallic van der Waals antiferromagnet"}],"publisher":"arXiv","container":{},"publicationYear":2026,"subjects":[{"subject":"Materials Science (cond-mat.mtrl-sci)","lang":"en","subjectScheme":"arXiv"},{"subject":"Mesoscale and Nanoscale Physics (cond-mat.mes-hall)","lang":"en","subjectScheme":"arXiv"},{"subject":"FOS: Physical sciences","subjectScheme":"Fields of Science and Technology (FOS)"},{"schemeUri":"http://www.oecd.org/science/inno/38235147.pdf","subject":"FOS: Physical sciences","subjectScheme":"Fields of Science and Technology (FOS)"}],"contributors":[],"dates":[{"date":"2026-02-23T11:33:16Z","dateType":"Submitted","dateInformation":"v1"},{"date":"2026-02-24T02:22:32Z","dateType":"Updated","dateInformation":"v1"},{"date":"2026-02","dateType":"Available","dateInformation":"v1"},{"date":"2026","dateType":"Issued"}],"language":null,"types":{"schemaOrg":"CreativeWork","resourceTypeGeneral":"Preprint","citeproc":"article","bibtex":"misc","ris":"GEN","resourceType":"Article"},"relatedIdentifiers":[],"relatedItems":[],"sizes":[],"formats":[],"version":"1","rightsList":[{"rightsIdentifierScheme":"SPDX","rightsUri":"https://creativecommons.org/licenses/by/4.0/legalcode","schemeUri":"https://spdx.org/licenses/","rights":"Creative Commons Attribution 4.0 International","rightsIdentifier":"cc-by-4.0"}],"descriptions":[{"descriptionType":"Abstract","description":"Altermagnetism -a magnetic state characterized by spin-polarized electronic bands at zero net magnetization- offers a promising route for next-generation spintronic devices. In two-dimensional (2D) magnets, twist engineering enables its realization by breaking the combined inversion and time-reversal symmetry (PT) while preserving crystal symmetries that ensure the altermagnetic order. Here, by means of first-principles calculations and symmetry analysis, we demonstrate that twist engineering applied to the recently synthesized metallic van der Waals antiferromagnet Co-doped bilayer Fe$_3$GaTe$_2$ (Fe$_2$CoGaTe$_2$) provides a robust platform for altermagnetism. By twisting two layers of Fe$_2$CoGaTe$_2$, the PT symmetry between opposite spin sublattices is broken, resulting in a non-relativistic $i$-wave altermagnetic state with spin splitting up to 138 meV. In the absence of spin-orbit coupling (SOC), the electronic states are spin-degenerate along six high-symmetry directions, while the inclusion of SOC preserves this degeneracy along the three directions protected by twofold rotation axes. Furthermore, we unveil the microscopic mechanisms governing the magnetic behavior in twisted Fe$_2$CoGaTe$_2$. Our results establish twist engineering and metallic Fe-based van der Waals antiferromagnets as versatile platforms to realize 2D van der Waals altermagnetism, with potential for designing high-efficiency ultrathin nanodevices."}],"geoLocations":[],"fundingReferences":[],"url":"https://arxiv.org/abs/2602.19734","contentUrl":null,"metadataVersion":0,"schemaVersion":"http://datacite.org/schema/kernel-4","source":"mds","isActive":true,"state":"findable","reason":null,"viewCount":0,"downloadCount":0,"referenceCount":0,"citationCount":0,"partCount":0,"partOfCount":0,"versionCount":0,"versionOfCount":0,"created":"2026-02-25T15:12:37Z","registered":"2026-02-25T15:12:37Z","published":null,"updated":"2026-02-25T15:12:37Z"},"relationships":{"client":{"data":{"id":"arxiv.content","type":"clients"}}}},{"id":"10.48550/arxiv.2602.19733","type":"dois","attributes":{"doi":"10.48550/arxiv.2602.19733","identifiers":[{"identifier":"2602.19733","identifierType":"arXiv"}],"creators":[{"nameType":"Personal","givenName":"Sheheryar","familyName":"Mehmood","name":"Mehmood, Sheheryar","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Florian","familyName":"Knoll","name":"Knoll, Florian","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Peter","familyName":"Ochs","name":"Ochs, Peter","affiliation":[],"nameIdentifiers":[]}],"titles":[{"title":"Understanding the Curse of Unrolling"}],"publisher":"arXiv","container":{},"publicationYear":2026,"subjects":[{"subject":"Machine Learning (cs.LG)","lang":"en","subjectScheme":"arXiv"},{"subject":"Optimization and Control (math.OC)","lang":"en","subjectScheme":"arXiv"},{"subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"},{"schemeUri":"http://www.oecd.org/science/inno/38235147.pdf","subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"},{"subject":"FOS: Mathematics","subjectScheme":"Fields of Science and Technology (FOS)"},{"schemeUri":"http://www.oecd.org/science/inno/38235147.pdf","subject":"FOS: Mathematics","subjectScheme":"Fields of Science and Technology (FOS)"}],"contributors":[],"dates":[{"date":"2026-02-23T11:32:39Z","dateType":"Submitted","dateInformation":"v1"},{"date":"2026-02-24T02:22:30Z","dateType":"Updated","dateInformation":"v1"},{"date":"2026-02","dateType":"Available","dateInformation":"v1"},{"date":"2026","dateType":"Issued"}],"language":null,"types":{"schemaOrg":"CreativeWork","resourceTypeGeneral":"Preprint","citeproc":"article","bibtex":"misc","ris":"GEN","resourceType":"Article"},"relatedIdentifiers":[],"relatedItems":[],"sizes":[],"formats":[],"version":"1","rightsList":[{"rightsIdentifierScheme":"SPDX","rightsUri":"https://creativecommons.org/licenses/by/4.0/legalcode","schemeUri":"https://spdx.org/licenses/","rights":"Creative Commons Attribution 4.0 International","rightsIdentifier":"cc-by-4.0"}],"descriptions":[{"descriptionType":"Abstract","description":"Algorithm unrolling is ubiquitous in machine learning, particularly in hyperparameter optimization and meta-learning, where Jacobians of solution mappings are computed by differentiating through iterative algorithms. Although unrolling is known to yield asymptotically correct Jacobians under suitable conditions, recent work has shown that the derivative iterates may initially diverge from the true Jacobian, a phenomenon known as the curse of unrolling. In this work, we provide a non-asymptotic analysis that explains the origin of this behavior and identifies the algorithmic factors that govern it. We show that truncating early iterations of the derivative computation mitigates the curse while simultaneously reducing memory requirements. Finally, we demonstrate that warm-starting in bilevel optimization naturally induces an implicit form of truncation, providing a practical remedy. Our theoretical findings are supported by numerical experiments on representative examples."}],"geoLocations":[],"fundingReferences":[],"url":"https://arxiv.org/abs/2602.19733","contentUrl":null,"metadataVersion":0,"schemaVersion":"http://datacite.org/schema/kernel-4","source":"mds","isActive":true,"state":"findable","reason":null,"viewCount":0,"downloadCount":0,"referenceCount":0,"citationCount":0,"partCount":0,"partOfCount":0,"versionCount":0,"versionOfCount":0,"created":"2026-02-25T15:12:34Z","registered":"2026-02-25T15:12:35Z","published":null,"updated":"2026-02-25T15:12:35Z"},"relationships":{"client":{"data":{"id":"arxiv.content","type":"clients"}}}},{"id":"10.48550/arxiv.2602.19732","type":"dois","attributes":{"doi":"10.48550/arxiv.2602.19732","identifiers":[{"identifier":"2602.19732","identifierType":"arXiv"}],"creators":[{"nameType":"Personal","givenName":"Fabrizio","familyName":"Cipollini","name":"Cipollini, Fabrizio","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Giulia","familyName":"Cruciani","name":"Cruciani, Giulia","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Giampiero M.","familyName":"Gallo","name":"Gallo, Giampiero M.","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Alessandra","familyName":"Insana","name":"Insana, Alessandra","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Edoardo","familyName":"Otranto","name":"Otranto, Edoardo","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Fabio","familyName":"Spagnolo","name":"Spagnolo, Fabio","affiliation":[],"nameIdentifiers":[]}],"titles":[{"title":"VOLatility Archive for Realized Estimates (VOLARE)"}],"publisher":"arXiv","container":{},"publicationYear":2026,"subjects":[{"subject":"Statistical Finance (q-fin.ST)","lang":"en","subjectScheme":"arXiv"},{"subject":"FOS: Economics and business","subjectScheme":"Fields of Science and Technology (FOS)"},{"schemeUri":"http://www.oecd.org/science/inno/38235147.pdf","subject":"FOS: Economics and business","subjectScheme":"Fields of Science and Technology (FOS)"}],"contributors":[],"dates":[{"date":"2026-02-23T11:31:53Z","dateType":"Submitted","dateInformation":"v1"},{"date":"2026-02-24T02:22:29Z","dateType":"Updated","dateInformation":"v1"},{"date":"2026-02","dateType":"Available","dateInformation":"v1"},{"date":"2026","dateType":"Issued"}],"language":null,"types":{"schemaOrg":"CreativeWork","resourceTypeGeneral":"Preprint","citeproc":"article","bibtex":"misc","ris":"GEN","resourceType":"Article"},"relatedIdentifiers":[],"relatedItems":[],"sizes":[],"formats":[],"version":"1","rightsList":[{"rightsIdentifierScheme":"SPDX","rightsUri":"https://creativecommons.org/licenses/by/4.0/legalcode","schemeUri":"https://spdx.org/licenses/","rights":"Creative Commons Attribution 4.0 International","rightsIdentifier":"cc-by-4.0"}],"descriptions":[{"descriptionType":"Abstract","description":"VOLARE (VOLatility Archive for Realized Estimates - https://volare.unime.it) is an open research infrastructure providing standardized realized volatility and covariance measures constructed from ultra-high-frequency financial data. The platform processes tick-level observations across equities, exchange rates, and futures using an asset-specific pipeline that addresses heterogeneous trading calendars, microstructure noise, and timestamp precision. For equities, price series are cleaned using a documented outlier detection procedure and sampled at regular intervals.\n VOLARE delivers a comprehensive set of realized estimators, including realized variance, range-based measures, bipower variation, semivariances, realized quarticity, realized kernels, and multivariate covariance measures, ensuring methodological consistency and cross-asset comparability. In addition to bulk dataset download, the platform supports interactive visualization and real-time estimation of established volatility models such as HAR and MEM specifications."}],"geoLocations":[],"fundingReferences":[],"url":"https://arxiv.org/abs/2602.19732","contentUrl":null,"metadataVersion":0,"schemaVersion":"http://datacite.org/schema/kernel-4","source":"mds","isActive":true,"state":"findable","reason":null,"viewCount":0,"downloadCount":0,"referenceCount":0,"citationCount":0,"partCount":0,"partOfCount":0,"versionCount":0,"versionOfCount":0,"created":"2026-02-25T15:12:32Z","registered":"2026-02-25T15:12:33Z","published":null,"updated":"2026-02-25T15:12:33Z"},"relationships":{"client":{"data":{"id":"arxiv.content","type":"clients"}}}},{"id":"10.48550/arxiv.2602.19731","type":"dois","attributes":{"doi":"10.48550/arxiv.2602.19731","identifiers":[{"identifier":"2602.19731","identifierType":"arXiv"}],"creators":[{"nameType":"Personal","givenName":"Enric","familyName":"Pardo","name":"Pardo, Enric","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Alexandre","familyName":"Colle","name":"Colle, Alexandre","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Remi","familyName":"Dorget","name":"Dorget, Remi","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Mohamed Essam","familyName":"Ahmed","name":"Ahmed, Mohamed Essam","affiliation":[],"nameIdentifiers":[]}],"titles":[{"title":"AC loss modelling in a 2 MW-class REBCO high temperature superconducting motor for hydrogen-electric aircraft"}],"publisher":"arXiv","container":{},"publicationYear":2026,"subjects":[{"subject":"Applied Physics (physics.app-ph)","lang":"en","subjectScheme":"arXiv"},{"subject":"FOS: Physical sciences","subjectScheme":"Fields of Science and Technology (FOS)"},{"schemeUri":"http://www.oecd.org/science/inno/38235147.pdf","subject":"FOS: Physical sciences","subjectScheme":"Fields of Science and Technology (FOS)"}],"contributors":[],"dates":[{"date":"2026-02-23T11:31:05Z","dateType":"Submitted","dateInformation":"v1"},{"date":"2026-02-24T02:22:26Z","dateType":"Updated","dateInformation":"v1"},{"date":"2026-02","dateType":"Available","dateInformation":"v1"},{"date":"2026","dateType":"Issued"}],"language":null,"types":{"schemaOrg":"CreativeWork","resourceTypeGeneral":"Preprint","citeproc":"article","bibtex":"misc","ris":"GEN","resourceType":"Article"},"relatedIdentifiers":[],"relatedItems":[],"sizes":[],"formats":[],"version":"1","rightsList":[{"rightsUri":"http://arxiv.org/licenses/nonexclusive-distrib/1.0/","rights":"arXiv.org perpetual, non-exclusive license"}],"descriptions":[{"descriptionType":"Abstract","description":"High temperature superconducting motors are very promising for hydrogen-electric aircraft thanks to their high specific power, specific torque, and efficiency. High temperature superconductor REBCO offer high cryogenic flexibility, but a stator made of REBCO tapes could present high AC loss. Although stacking effect reduce AC loss, it could be compromised by imperfections, such as winding misalignment and tape inhomogeneity. Therefore, it is needed to know whether the AC loss is acceptable in realistic REBCO stators. This article analyses the AC loss in a REBCO propulsion motor for aviation that takes these imperfections into account. For this purpose, we developed our own fast and accurate numerical model, which considers the highly nonlinear screening currents in the superconductor into account. This work studies a motor of around 2 MW power with REBCO stator coils with 27 parallel tapes as conductor and a permanent-magnet rotor. We consider several electric coupling scenarios of the multi-tape conductor. We also analyze the effect of finite tape-to-tape resistances at the terminals. We have found that the AC loss for the whole motor in the most realistic coupling scenario represents less than 0.018 % of the rated power. Misalignments and tape degradation at the edges of up to 100 $μ$m only increase AC loss by up to around 20 %. Therefore, motors with REBCO superconductors in the stator are feasible for aircraft propulsion."}],"geoLocations":[],"fundingReferences":[],"url":"https://arxiv.org/abs/2602.19731","contentUrl":null,"metadataVersion":0,"schemaVersion":"http://datacite.org/schema/kernel-4","source":"mds","isActive":true,"state":"findable","reason":null,"viewCount":0,"downloadCount":0,"referenceCount":0,"citationCount":0,"partCount":0,"partOfCount":0,"versionCount":0,"versionOfCount":0,"created":"2026-02-25T15:12:30Z","registered":"2026-02-25T15:12:30Z","published":null,"updated":"2026-02-25T15:12:30Z"},"relationships":{"client":{"data":{"id":"arxiv.content","type":"clients"}}}},{"id":"10.48550/arxiv.2602.19730","type":"dois","attributes":{"doi":"10.48550/arxiv.2602.19730","identifiers":[{"identifier":"2602.19730","identifierType":"arXiv"}],"creators":[{"nameType":"Personal","givenName":"Payam Habibdazeh","familyName":"Kavkani","name":"Kavkani, Payam Habibdazeh","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Amir H.","familyName":"Tavabi","name":"Tavabi, Amir H.","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Paolo","familyName":"Rosi","name":"Rosi, Paolo","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Alberto","familyName":"Roncaglia","name":"Roncaglia, Alberto","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Enzo","familyName":"Rotunno","name":"Rotunno, Enzo","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Luca","familyName":"Belsito","name":"Belsito, Luca","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Sergio","familyName":"Sapienza","name":"Sapienza, Sergio","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Stefano","familyName":"Frabboni","name":"Frabboni, Stefano","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Rafal E.","familyName":"Dunin-Borkowski","name":"Dunin-Borkowski, Rafal E.","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Marco","familyName":"Beleggia","name":"Beleggia, Marco","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Vincenzo","familyName":"Grillo","name":"Grillo, Vincenzo","affiliation":[],"nameIdentifiers":[]}],"titles":[{"title":"Designing electrostatic MEMS-based electron optics: the case of the spiral phase plate"}],"publisher":"arXiv","container":{},"publicationYear":2026,"subjects":[{"subject":"Instrumentation and Detectors (physics.ins-det)","lang":"en","subjectScheme":"arXiv"},{"subject":"Optics (physics.optics)","lang":"en","subjectScheme":"arXiv"},{"subject":"FOS: Physical sciences","subjectScheme":"Fields of Science and Technology (FOS)"},{"schemeUri":"http://www.oecd.org/science/inno/38235147.pdf","subject":"FOS: Physical sciences","subjectScheme":"Fields of Science and Technology (FOS)"}],"contributors":[],"dates":[{"date":"2026-02-23T11:29:12Z","dateType":"Submitted","dateInformation":"v1"},{"date":"2026-02-24T02:22:20Z","dateType":"Updated","dateInformation":"v1"},{"date":"2026-02","dateType":"Available","dateInformation":"v1"},{"date":"2026","dateType":"Issued"}],"language":null,"types":{"schemaOrg":"CreativeWork","resourceTypeGeneral":"Preprint","citeproc":"article","bibtex":"misc","ris":"GEN","resourceType":"Article"},"relatedIdentifiers":[],"relatedItems":[],"sizes":[],"formats":[],"version":"1","rightsList":[{"rightsIdentifierScheme":"SPDX","rightsUri":"https://creativecommons.org/licenses/by/4.0/legalcode","schemeUri":"https://spdx.org/licenses/","rights":"Creative Commons Attribution 4.0 International","rightsIdentifier":"cc-by-4.0"}],"descriptions":[{"descriptionType":"Abstract","description":"A new generation of microfabricated MEMS for electron optics is changing electron microscopy for the better. These devices allow operations on the electron beam that are impossible with conventional electron optics. Unprecedented phase landscapes like tunable spiral phase plates and localized strong phase gradients are just some examples of what can be achieved. This work establishes the methodological foundation to design and control MEMS based phase plates. The design strategy is rooted on a novel analytical and numerical modeling of thin electrodes with accurate account of the fringing fields having a major role in the thin-MEMS geometry. We designed, fabricated and characterized experimentally a spiral phase plate, and assessed the quality of the generated vortex beam while discussing the most relevant control parameters and design approaches."},{"descriptionType":"Other","description":"preprint, 24 pages, 8 figures"}],"geoLocations":[],"fundingReferences":[],"url":"https://arxiv.org/abs/2602.19730","contentUrl":null,"metadataVersion":0,"schemaVersion":"http://datacite.org/schema/kernel-4","source":"mds","isActive":true,"state":"findable","reason":null,"viewCount":0,"downloadCount":0,"referenceCount":0,"citationCount":0,"partCount":0,"partOfCount":0,"versionCount":0,"versionOfCount":0,"created":"2026-02-25T15:12:27Z","registered":"2026-02-25T15:12:28Z","published":null,"updated":"2026-02-25T15:12:28Z"},"relationships":{"client":{"data":{"id":"arxiv.content","type":"clients"}}}},{"id":"10.48550/arxiv.2602.19729","type":"dois","attributes":{"doi":"10.48550/arxiv.2602.19729","identifiers":[{"identifier":"2602.19729","identifierType":"arXiv"}],"creators":[{"nameType":"Personal","givenName":"Tombo F.","familyName":"Rarivoarinoro","name":"Rarivoarinoro, Tombo F.","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Zara","familyName":"Randriamanakoto","name":"Randriamanakoto, Zara","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Russ","familyName":"Taylor","name":"Taylor, Russ","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Marisa","familyName":"Brienza","name":"Brienza, Marisa","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Fabio","familyName":"Luchsinger","name":"Luchsinger, Fabio","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Sushant","familyName":"Dutta","name":"Dutta, Sushant","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Catherine","familyName":"Hale","name":"Hale, Catherine","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Jacinta","familyName":"Delhaize","name":"Delhaize, Jacinta","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Ndivhuwo","familyName":"Netshiavha","name":"Netshiavha, Ndivhuwo","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Solohery","familyName":"Randriamampandry","name":"Randriamampandry, Solohery","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Mattia","familyName":"Vaccari","name":"Vaccari, Mattia","affiliation":[],"nameIdentifiers":[]}],"titles":[{"title":"MIGHTEE: Discovery of a triple-double radio galaxy"}],"publisher":"arXiv","container":{},"publicationYear":2026,"subjects":[{"subject":"Astrophysics of Galaxies (astro-ph.GA)","lang":"en","subjectScheme":"arXiv"},{"subject":"FOS: Physical sciences","subjectScheme":"Fields of Science and Technology (FOS)"},{"schemeUri":"http://www.oecd.org/science/inno/38235147.pdf","subject":"FOS: Physical sciences","subjectScheme":"Fields of Science and Technology (FOS)"}],"contributors":[],"dates":[{"date":"2026-02-23T11:27:48Z","dateType":"Submitted","dateInformation":"v1"},{"date":"2026-02-24T02:22:19Z","dateType":"Updated","dateInformation":"v1"},{"date":"2026-02","dateType":"Available","dateInformation":"v1"},{"date":"2026","dateType":"Issued"}],"language":null,"types":{"schemaOrg":"CreativeWork","resourceTypeGeneral":"Preprint","citeproc":"article","bibtex":"misc","ris":"GEN","resourceType":"Article"},"relatedIdentifiers":[],"relatedItems":[],"sizes":[],"formats":[],"version":"1","rightsList":[{"rightsIdentifierScheme":"SPDX","rightsUri":"https://creativecommons.org/licenses/by-nc-nd/4.0/legalcode","schemeUri":"https://spdx.org/licenses/","rights":"Creative Commons Attribution Non Commercial No Derivatives 4.0 International","rightsIdentifier":"cc-by-nc-nd-4.0"}],"descriptions":[{"descriptionType":"Abstract","description":"Triple-double radio galaxies (TDRGs) are amongst the rarest subpopulations of radio galaxies (RGs). They are characterised by three pairs of radio lobes, where each pair of lobes represents an episode of nuclear activity. Such a feature makes them key objects that can be used to constrain the duty cycle of RGs. In this paper, we report the discovery of J022248\\m060934, a new TDRG, hosted by a galaxy at a spectroscopic redshift of $z \\approx$ 0.94. We have used the MIGHTEE-DR1 data set and MIGHTEE sub-band images as our main data. In total intensity, J022248\\m060934 has a bright core and triple-double, edge-brightened-like peaks of radio emission. The polarimetry of the source reveals an inhomogeneous density of the hosting environment which is consistent with the more pronounced bending in its eastern lobes. The spectral index and curvature maps suggest an inverted core and an ultra-steepening of the spectrum towards the outer lobes which reinforce a recurrent nuclear activity. We perform individual spectral age fitting of the components of the source using the JP model and we found a lower limit total age of $\\sim$16 Myr. We also derive a short inactive period between the active phases and a rapid duty cycle of 90 per cent for the first cycle of activity. Our spectral ageing analysis suggests that the triple-double structure in TDRGs is not the product of long quiescent periods, as deduced by previous works based on kinematic ages."},{"descriptionType":"Other","description":"16 pages + appendix materials (4 pages), Accepted for publication in MNRAS"}],"geoLocations":[],"fundingReferences":[],"url":"https://arxiv.org/abs/2602.19729","contentUrl":null,"metadataVersion":0,"schemaVersion":"http://datacite.org/schema/kernel-4","source":"mds","isActive":true,"state":"findable","reason":null,"viewCount":0,"downloadCount":0,"referenceCount":0,"citationCount":0,"partCount":0,"partOfCount":0,"versionCount":0,"versionOfCount":0,"created":"2026-02-25T15:12:25Z","registered":"2026-02-25T15:12:25Z","published":null,"updated":"2026-02-25T15:12:25Z"},"relationships":{"client":{"data":{"id":"arxiv.content","type":"clients"}}}},{"id":"10.48550/arxiv.2602.19728","type":"dois","attributes":{"doi":"10.48550/arxiv.2602.19728","identifiers":[{"identifier":"2602.19728","identifierType":"arXiv"}],"creators":[{"nameType":"Personal","givenName":"Adamya","familyName":"Shyam","name":"Shyam, Adamya","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Venkateswara Rao","familyName":"Kagita","name":"Kagita, Venkateswara Rao","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Bharti","familyName":"Rana","name":"Rana, Bharti","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Vikas","familyName":"Kumar","name":"Kumar, Vikas","affiliation":[],"nameIdentifiers":[]}],"titles":[{"title":"GrIT: Group Informed Transformer for Sequential Recommendation"}],"publisher":"arXiv","container":{},"publicationYear":2026,"subjects":[{"subject":"Information Retrieval (cs.IR)","lang":"en","subjectScheme":"arXiv"},{"subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"},{"schemeUri":"http://www.oecd.org/science/inno/38235147.pdf","subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"}],"contributors":[],"dates":[{"date":"2026-02-23T11:26:11Z","dateType":"Submitted","dateInformation":"v1"},{"date":"2026-02-24T02:22:13Z","dateType":"Updated","dateInformation":"v1"},{"date":"2026-02","dateType":"Available","dateInformation":"v1"},{"date":"2026","dateType":"Issued"}],"language":null,"types":{"schemaOrg":"CreativeWork","resourceTypeGeneral":"Preprint","citeproc":"article","bibtex":"misc","ris":"GEN","resourceType":"Article"},"relatedIdentifiers":[],"relatedItems":[],"sizes":[],"formats":[],"version":"1","rightsList":[{"rightsUri":"http://arxiv.org/licenses/nonexclusive-distrib/1.0/","rights":"arXiv.org perpetual, non-exclusive license"}],"descriptions":[{"descriptionType":"Abstract","description":"Sequential recommender systems aim to predict a user's future interests by extracting temporal patterns from their behavioral history. Existing approaches typically employ transformer-based architectures to process long sequences of user interactions, capturing preference shifts by modeling temporal relationships between items. However, these methods often overlook the influence of group-level features that capture the collective behavior of similar users. We hypothesize that explicitly modeling temporally evolving group features alongside individual user histories can significantly enhance next-item recommendation. Our approach introduces latent group representations, where each user's affiliation to these groups is modeled through learnable, time-varying membership weights. The membership weights at each timestep are computed by modeling shifts in user preferences through their interaction history, where we incorporate both short-term and long-term user preferences. We extract a set of statistical features that capture the dynamics of user behavior and further refine them through a series of transformations to produce the final drift-aware membership weights. A group-based representation is derived by weighting latent group embeddings with the learned membership scores. This representation is integrated with the user's sequential representation within the transformer block to jointly capture personal and group-level temporal dynamics, producing richer embeddings that lead to more accurate, context-aware recommendations. We validate the effectiveness of our approach through extensive experiments on five benchmark datasets, where it consistently outperforms state-of-the-art sequential recommendation methods."}],"geoLocations":[],"fundingReferences":[],"url":"https://arxiv.org/abs/2602.19728","contentUrl":null,"metadataVersion":0,"schemaVersion":"http://datacite.org/schema/kernel-4","source":"mds","isActive":true,"state":"findable","reason":null,"viewCount":0,"downloadCount":0,"referenceCount":0,"citationCount":0,"partCount":0,"partOfCount":0,"versionCount":0,"versionOfCount":0,"created":"2026-02-25T15:12:22Z","registered":"2026-02-25T15:12:23Z","published":null,"updated":"2026-02-25T15:12:23Z"},"relationships":{"client":{"data":{"id":"arxiv.content","type":"clients"}}}},{"id":"10.48550/arxiv.2602.19727","type":"dois","attributes":{"doi":"10.48550/arxiv.2602.19727","identifiers":[{"identifier":"2602.19727","identifierType":"arXiv"}],"creators":[{"nameType":"Personal","givenName":"Jean-François","familyName":"Burnol","name":"Burnol, Jean-François","affiliation":[],"nameIdentifiers":[]}],"titles":[{"title":"On the analytic continuation of Dirichlet series with missing digits"}],"publisher":"arXiv","container":{},"publicationYear":2026,"subjects":[{"subject":"Number Theory (math.NT)","lang":"en","subjectScheme":"arXiv"},{"subject":"Combinatorics (math.CO)","lang":"en","subjectScheme":"arXiv"},{"subject":"FOS: Mathematics","subjectScheme":"Fields of Science and Technology (FOS)"},{"schemeUri":"http://www.oecd.org/science/inno/38235147.pdf","subject":"FOS: Mathematics","subjectScheme":"Fields of Science and Technology (FOS)"},{"subject":"11M41 (Primary) 11A63, 11B85, 11M06, 11Y35, 33F05, 68R15 (Secondary)","lang":"en","subjectScheme":"MSC"}],"contributors":[],"dates":[{"date":"2026-02-23T11:24:22Z","dateType":"Submitted","dateInformation":"v1"},{"date":"2026-02-24T02:22:13Z","dateType":"Updated","dateInformation":"v1"},{"date":"2026-02-24T18:45:07Z","dateType":"Submitted","dateInformation":"v2"},{"date":"2026-02-25T02:05:19Z","dateType":"Updated","dateInformation":"v2"},{"date":"2026-02","dateType":"Available","dateInformation":"v1"},{"date":"2026","dateType":"Issued"}],"language":null,"types":{"schemaOrg":"CreativeWork","resourceTypeGeneral":"Preprint","citeproc":"article","bibtex":"misc","ris":"GEN","resourceType":"Article"},"relatedIdentifiers":[],"relatedItems":[],"sizes":[],"formats":[],"version":"2","rightsList":[{"rightsIdentifierScheme":"SPDX","rightsUri":"https://creativecommons.org/licenses/by-sa/4.0/legalcode","schemeUri":"https://spdx.org/licenses/","rights":"Creative Commons Attribution Share Alike 4.0 International","rightsIdentifier":"cc-by-sa-4.0"}],"descriptions":[{"descriptionType":"Abstract","description":"We study the Dirichlet series associated with the integers whose radix-$b$ representation misses certain (fixed) digits. The existence of a meromorphic continuation to the entire complex plane, which was already well-known as a general fact valid for $b$-automatic Dirichlet series, is proven anew from a representation as an everywhere defined series with good convergence properties. A generating function related to the residues on the real axis is shown to be the multiplicative inverse of the moment generating function for the associated Cantor set in the unit interval. This makes the (normalized) residues some sort of generalized Bernoulli numbers."},{"descriptionType":"Other","description":"22 pages"}],"geoLocations":[],"fundingReferences":[],"url":"https://arxiv.org/abs/2602.19727","contentUrl":null,"metadataVersion":0,"schemaVersion":"http://datacite.org/schema/kernel-4","source":"mds","isActive":true,"state":"findable","reason":null,"viewCount":0,"downloadCount":0,"referenceCount":0,"citationCount":0,"partCount":0,"partOfCount":0,"versionCount":0,"versionOfCount":0,"created":"2026-02-25T15:12:19Z","registered":"2026-02-25T15:12:20Z","published":null,"updated":"2026-02-25T15:12:20Z"},"relationships":{"client":{"data":{"id":"arxiv.content","type":"clients"}}}},{"id":"10.48550/arxiv.2602.19726","type":"dois","attributes":{"doi":"10.48550/arxiv.2602.19726","identifiers":[{"identifier":"2602.19726","identifierType":"arXiv"}],"creators":[{"nameType":"Personal","givenName":"Rupam","familyName":"Barman","name":"Barman, Rupam","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Anuj","familyName":"Jakhar","name":"Jakhar, Anuj","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Ravi","familyName":"Kalwaniya","name":"Kalwaniya, Ravi","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Prabhakar","familyName":"Yadav","name":"Yadav, Prabhakar","affiliation":[],"nameIdentifiers":[]}],"titles":[{"title":"Arithmetic Aspects of Number Fields Generated by Polynomial Families"}],"publisher":"arXiv","container":{},"publicationYear":2026,"subjects":[{"subject":"Number Theory (math.NT)","lang":"en","subjectScheme":"arXiv"},{"subject":"FOS: Mathematics","subjectScheme":"Fields of Science and Technology (FOS)"},{"schemeUri":"http://www.oecd.org/science/inno/38235147.pdf","subject":"FOS: Mathematics","subjectScheme":"Fields of Science and Technology (FOS)"},{"subject":"11R04, 11R29, 11Y40","lang":"en","subjectScheme":"MSC"}],"contributors":[],"dates":[{"date":"2026-02-23T11:24:02Z","dateType":"Submitted","dateInformation":"v1"},{"date":"2026-02-24T02:22:12Z","dateType":"Updated","dateInformation":"v1"},{"date":"2026-02","dateType":"Available","dateInformation":"v1"},{"date":"2026","dateType":"Issued"}],"language":null,"types":{"schemaOrg":"CreativeWork","resourceTypeGeneral":"Preprint","citeproc":"article","bibtex":"misc","ris":"GEN","resourceType":"Article"},"relatedIdentifiers":[],"relatedItems":[],"sizes":[],"formats":[],"version":"1","rightsList":[{"rightsIdentifierScheme":"SPDX","rightsUri":"https://creativecommons.org/licenses/by/4.0/legalcode","schemeUri":"https://spdx.org/licenses/","rights":"Creative Commons Attribution 4.0 International","rightsIdentifier":"cc-by-4.0"}],"descriptions":[{"descriptionType":"Abstract","description":"Let $f(x)=(x^{k}+c)^{m}-ax^{n}\\in\\mathbb{Z}[x]$ be an irreducible polynomial over $\\mathbb{Q}$, where $k,m,n\\in\\mathbb{N}$ with $km\u0026gt;n$, and let $K=\\mathbb{Q}(θ)$, where $θ$ is a root of $f(x)$. We investigate the arithmetic properties of the number fields that arise from this family. We first obtain an explicit formula for the discriminant of $f(x)$. Using this formula, we establish necessary and sufficient conditions for the monogeneity of $f(x)$, expressed in terms of the prime divisors of $a$ and $c$ and the parameters $k,m,n$. This yields infinite families of monogenic polynomials of arbitrary degree, including families with a non-square-free discriminant. Building on these results, we extend our algebraic characterization to composite polynomials, establishing some explicit conditions for the monogeneity of the composition of $f(x)$ with an arbitrary polynomial $g(x)$. From an analytic point of view, we derive asymptotic estimates for the number of monogenic polynomials in these families under natural assumptions. We further study non-monogeneity via the field index $i(K)$ and, for each prime $p$, provide sufficient conditions ensuring $ν_p(i(K))=1$, yielding partial progress toward a problem of Narkiewicz. We also highlight a connection with a class of differential equations naturally associated with $f(x)$. As an application, we determine the conditions under which the splitting field of $f(x)$ has a full symmetric Galois group. Several explicit examples illustrate our results."}],"geoLocations":[],"fundingReferences":[],"url":"https://arxiv.org/abs/2602.19726","contentUrl":null,"metadataVersion":0,"schemaVersion":"http://datacite.org/schema/kernel-4","source":"mds","isActive":true,"state":"findable","reason":null,"viewCount":0,"downloadCount":0,"referenceCount":0,"citationCount":0,"partCount":0,"partOfCount":0,"versionCount":0,"versionOfCount":0,"created":"2026-02-25T15:12:17Z","registered":"2026-02-25T15:12:18Z","published":null,"updated":"2026-02-25T15:12:18Z"},"relationships":{"client":{"data":{"id":"arxiv.content","type":"clients"}}}},{"id":"10.48550/arxiv.2602.19725","type":"dois","attributes":{"doi":"10.48550/arxiv.2602.19725","identifiers":[{"identifier":"2602.19725","identifierType":"arXiv"}],"creators":[{"nameType":"Personal","givenName":"Robert","familyName":"Pezer","name":"Pezer, Robert","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Karlo","familyName":"Lelas","name":"Lelas, Karlo","affiliation":[],"nameIdentifiers":[]}],"titles":[{"title":"Damped harmonic oscillator revisited: a new approach to energy decay in the case of Coulomb, Stokes, and Newton damping"}],"publisher":"arXiv","container":{},"publicationYear":2026,"subjects":[{"subject":"Classical Physics (physics.class-ph)","lang":"en","subjectScheme":"arXiv"},{"subject":"FOS: Physical sciences","subjectScheme":"Fields of Science and Technology (FOS)"},{"schemeUri":"http://www.oecd.org/science/inno/38235147.pdf","subject":"FOS: Physical sciences","subjectScheme":"Fields of Science and Technology (FOS)"}],"contributors":[],"dates":[{"date":"2026-02-23T11:23:34Z","dateType":"Submitted","dateInformation":"v1"},{"date":"2026-02-24T02:22:11Z","dateType":"Updated","dateInformation":"v1"},{"date":"2026-02","dateType":"Available","dateInformation":"v1"},{"date":"2026","dateType":"Issued"}],"language":null,"types":{"schemaOrg":"CreativeWork","resourceTypeGeneral":"Preprint","citeproc":"article","bibtex":"misc","ris":"GEN","resourceType":"Article"},"relatedIdentifiers":[],"relatedItems":[],"sizes":[],"formats":[],"version":"1","rightsList":[{"rightsIdentifierScheme":"SPDX","rightsUri":"https://creativecommons.org/licenses/by/4.0/legalcode","schemeUri":"https://spdx.org/licenses/","rights":"Creative Commons Attribution 4.0 International","rightsIdentifier":"cc-by-4.0"}],"descriptions":[{"descriptionType":"Abstract","description":"Approximate formulas are derived to describe energy loss in a harmonic oscillator that experiences three distinct damping mechanisms: constant-magnitude (Coulomb), velocity-proportional (Stokes), and velocity-squared (Newton), using fundamental mathematical methods and physical insight. Our methodology leverages an understanding of the free harmonic oscillator and the inherent link between energy dissipation rates and the power exerted by damping forces. We establish a direct analytical framework for assessing the energy of a damped harmonic oscillator, obviating the need for amplitude-based equations. The simplicity of our findings is accompanied by their remarkable accuracy when validated against exact or computational simulations. In addition to an excellent approximate description of the energy decay, we also show how to derive an exact solution in the case of Stokes damping without relying on the standard procedure for solving second-order differential equations. The theoretical underpinnings and mathematical strategies employed are well-suited for undergraduate-level or advanced high school physics instruction."},{"descriptionType":"Other","description":"are welcome"}],"geoLocations":[],"fundingReferences":[],"url":"https://arxiv.org/abs/2602.19725","contentUrl":null,"metadataVersion":0,"schemaVersion":"http://datacite.org/schema/kernel-4","source":"mds","isActive":true,"state":"findable","reason":null,"viewCount":0,"downloadCount":0,"referenceCount":0,"citationCount":0,"partCount":0,"partOfCount":0,"versionCount":0,"versionOfCount":0,"created":"2026-02-25T15:12:15Z","registered":"2026-02-25T15:12:15Z","published":null,"updated":"2026-02-25T15:12:15Z"},"relationships":{"client":{"data":{"id":"arxiv.content","type":"clients"}}}},{"id":"10.48550/arxiv.2602.19724","type":"dois","attributes":{"doi":"10.48550/arxiv.2602.19724","identifiers":[{"identifier":"2602.19724","identifierType":"arXiv"}],"creators":[{"nameType":"Personal","givenName":"M. J.","familyName":"Grant","name":"Grant, M. J.","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"T. M.","familyName":"Huijbregts","name":"Huijbregts, T. M.","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"R.","familyName":"Nicholls","name":"Nicholls, R.","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"M.","familyName":"Greenblatt","name":"Greenblatt, M.","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"P.","familyName":"Chudzinski","name":"Chudzinski, P.","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"A.","familyName":"Carrington","name":"Carrington, A.","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"N. E.","familyName":"Hussey","name":"Hussey, N. E.","affiliation":[],"nameIdentifiers":[]}],"titles":[{"title":"Anisotropic fully-gapped superconductivity in quasi-one-dimensional Li$_{0.9}$Mo$_6$O$_{17}$"}],"publisher":"arXiv","container":{},"publicationYear":2026,"subjects":[{"subject":"Superconductivity (cond-mat.supr-con)","lang":"en","subjectScheme":"arXiv"},{"subject":"Strongly Correlated Electrons (cond-mat.str-el)","lang":"en","subjectScheme":"arXiv"},{"subject":"FOS: Physical sciences","subjectScheme":"Fields of Science and Technology (FOS)"},{"schemeUri":"http://www.oecd.org/science/inno/38235147.pdf","subject":"FOS: Physical sciences","subjectScheme":"Fields of Science and Technology (FOS)"}],"contributors":[],"dates":[{"date":"2026-02-23T11:21:54Z","dateType":"Submitted","dateInformation":"v1"},{"date":"2026-02-24T02:22:04Z","dateType":"Updated","dateInformation":"v1"},{"date":"2026-02","dateType":"Available","dateInformation":"v1"},{"date":"2026","dateType":"Issued"}],"language":null,"types":{"schemaOrg":"CreativeWork","resourceTypeGeneral":"Preprint","citeproc":"article","bibtex":"misc","ris":"GEN","resourceType":"Article"},"relatedIdentifiers":[],"relatedItems":[],"sizes":[],"formats":[],"version":"1","rightsList":[{"rightsIdentifierScheme":"SPDX","rightsUri":"https://creativecommons.org/licenses/by/4.0/legalcode","schemeUri":"https://spdx.org/licenses/","rights":"Creative Commons Attribution 4.0 International","rightsIdentifier":"cc-by-4.0"}],"descriptions":[{"descriptionType":"Abstract","description":"Superconductivity in quasi-one-dimensional Li$_{0.9}$Mo$_6$O$_{17}$ emerges from an exotic, non-metallic normal state that exhibits signatures of Tomonaga-Luttinger liquid behavior, emergent symmetry and excitonic order. The high upper critical field, $H_{c2}$, in Li$_{0.9}$Mo$_6$O$_{17}$ suggests that that the favored pairing state is spin-triplet in nature. Here, we report measurements of the magnetic penetration depth down to $0.08\\,\\mathrm{K}$ ($T/T_c \\lesssim 0.04$) and the specific heat down to $0.4\\,\\mathrm{K}$ ($T/T_c \\lesssim 0.2$), and show that they are consistent with a moderately-coupled, fully-gapped superconducting state with marked gap anisotropy and a minimum ($Δ_{\\rm min} \\simeq 0.4\\,k_{\\mathrm{B}}T_c$) occurring over a very narrow region in $k$-space. Combined with knowledge of $H_{c2}$, these measurements support the presence of a nodeless and possibly odd-parity spin-triplet superconducting order parameter in Li$_{0.9}$Mo$_6$O$_{17}$."},{"descriptionType":"Other","description":"13 pages, 5 figures"}],"geoLocations":[],"fundingReferences":[],"url":"https://arxiv.org/abs/2602.19724","contentUrl":null,"metadataVersion":0,"schemaVersion":"http://datacite.org/schema/kernel-4","source":"mds","isActive":true,"state":"findable","reason":null,"viewCount":0,"downloadCount":0,"referenceCount":0,"citationCount":0,"partCount":0,"partOfCount":0,"versionCount":0,"versionOfCount":0,"created":"2026-02-25T15:12:12Z","registered":"2026-02-25T15:12:13Z","published":null,"updated":"2026-02-25T15:12:13Z"},"relationships":{"client":{"data":{"id":"arxiv.content","type":"clients"}}}},{"id":"10.48550/arxiv.2602.19723","type":"dois","attributes":{"doi":"10.48550/arxiv.2602.19723","identifiers":[{"identifier":"2602.19723","identifierType":"arXiv"}],"creators":[{"nameType":"Personal","givenName":"Yue","familyName":"Zhang","name":"Zhang, Yue","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Zhizheng","familyName":"Zhuo","name":"Zhuo, Zhizheng","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Siyao","familyName":"Xu","name":"Xu, Siyao","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Shan","familyName":"Lv","name":"Lv, Shan","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Zhaoxi","familyName":"Liu","name":"Liu, Zhaoxi","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Jun","familyName":"Qiu","name":"Qiu, Jun","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Qiuli","familyName":"Wang","name":"Wang, Qiuli","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Yaou","familyName":"Liu","name":"Liu, Yaou","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"S. Kevin","familyName":"Zhou","name":"Zhou, S. Kevin","affiliation":[],"nameIdentifiers":[]}],"titles":[{"title":"Towards Personalized Multi-Modal MRI Synthesis across Heterogeneous Datasets"}],"publisher":"arXiv","container":{},"publicationYear":2026,"subjects":[{"subject":"Computer Vision and Pattern Recognition (cs.CV)","lang":"en","subjectScheme":"arXiv"},{"subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"},{"schemeUri":"http://www.oecd.org/science/inno/38235147.pdf","subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"}],"contributors":[],"dates":[{"date":"2026-02-23T11:20:27Z","dateType":"Submitted","dateInformation":"v1"},{"date":"2026-02-24T02:22:03Z","dateType":"Updated","dateInformation":"v1"},{"date":"2026-02","dateType":"Available","dateInformation":"v1"},{"date":"2026","dateType":"Issued"}],"language":null,"types":{"schemaOrg":"CreativeWork","resourceTypeGeneral":"Preprint","citeproc":"article","bibtex":"misc","ris":"GEN","resourceType":"Article"},"relatedIdentifiers":[],"relatedItems":[],"sizes":[],"formats":[],"version":"1","rightsList":[{"rightsUri":"http://arxiv.org/licenses/nonexclusive-distrib/1.0/","rights":"arXiv.org perpetual, non-exclusive license"}],"descriptions":[{"descriptionType":"Abstract","description":"Synthesizing missing modalities in multi-modal magnetic resonance imaging (MRI) is vital for ensuring diagnostic completeness, particularly when full acquisitions are infeasible due to time constraints, motion artifacts, and patient tolerance. Recent unified synthesis models have enabled flexible synthesis tasks by accommodating various input-output configurations. However, their training and evaluation are typically restricted to a single dataset, limiting their generalizability across diverse clinical datasets and impeding practical deployment. To address this limitation, we propose PMM-Synth, a personalized MRI synthesis framework that not only supports various synthesis tasks but also generalizes effectively across heterogeneous datasets. PMM-Synth is jointly trained on multiple multi-modal MRI datasets that differ in modality coverage, disease types, and intensity distributions. It achieves cross-dataset generalization through three core innovations: a Personalized Feature Modulation module that dynamically adapts feature representations based on dataset identifier to mitigate the impact of distributional shifts; a Modality-Consistent Batch Scheduler that facilitates stable and efficient batch training under inconsistent modality conditions; and a selective supervision loss to ensure effective learning when ground truth modalities are partially missing. Evaluated on four clinical multi-modal MRI datasets, PMM-Synth consistently outperforms state-of-the-art methods in both one-to-one and many-to-one synthesis tasks, achieving superior PSNR and SSIM scores. Qualitative results further demonstrate improved preservation of anatomical structures and pathological details. Additionally, downstream tumor segmentation and radiological reporting studies suggest that PMM-Synth holds potential for supporting reliable diagnosis under real-world modality-missing scenarios."},{"descriptionType":"Other","description":"19 pages, 4 figures"}],"geoLocations":[],"fundingReferences":[],"url":"https://arxiv.org/abs/2602.19723","contentUrl":null,"metadataVersion":0,"schemaVersion":"http://datacite.org/schema/kernel-4","source":"mds","isActive":true,"state":"findable","reason":null,"viewCount":0,"downloadCount":0,"referenceCount":0,"citationCount":0,"partCount":0,"partOfCount":0,"versionCount":0,"versionOfCount":0,"created":"2026-02-25T15:12:10Z","registered":"2026-02-25T15:12:11Z","published":null,"updated":"2026-02-25T15:12:11Z"},"relationships":{"client":{"data":{"id":"arxiv.content","type":"clients"}}}},{"id":"10.48550/arxiv.2602.19719","type":"dois","attributes":{"doi":"10.48550/arxiv.2602.19719","identifiers":[{"identifier":"2602.19719","identifierType":"arXiv"}],"creators":[{"nameType":"Personal","givenName":"Amir","familyName":"Hamza","name":"Hamza, Amir","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Davide","familyName":"Boscaini","name":"Boscaini, Davide","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Weihang","familyName":"Li","name":"Li, Weihang","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Benjamin","familyName":"Busam","name":"Busam, Benjamin","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Fabio","familyName":"Poiesi","name":"Poiesi, Fabio","affiliation":[],"nameIdentifiers":[]}],"titles":[{"title":"Generative 6D Pose Estimation via Conditional Flow Matching"}],"publisher":"arXiv","container":{},"publicationYear":2026,"subjects":[{"subject":"Computer Vision and Pattern Recognition (cs.CV)","lang":"en","subjectScheme":"arXiv"},{"subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"},{"schemeUri":"http://www.oecd.org/science/inno/38235147.pdf","subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"}],"contributors":[],"dates":[{"date":"2026-02-23T11:15:12Z","dateType":"Submitted","dateInformation":"v1"},{"date":"2026-02-24T02:21:56Z","dateType":"Updated","dateInformation":"v1"},{"date":"2026-02","dateType":"Available","dateInformation":"v1"},{"date":"2026","dateType":"Issued"}],"language":null,"types":{"schemaOrg":"CreativeWork","resourceTypeGeneral":"Preprint","citeproc":"article","bibtex":"misc","ris":"GEN","resourceType":"Article"},"relatedIdentifiers":[],"relatedItems":[],"sizes":[],"formats":[],"version":"1","rightsList":[{"rightsIdentifierScheme":"SPDX","rightsUri":"https://creativecommons.org/licenses/by/4.0/legalcode","schemeUri":"https://spdx.org/licenses/","rights":"Creative Commons Attribution 4.0 International","rightsIdentifier":"cc-by-4.0"}],"descriptions":[{"descriptionType":"Abstract","description":"Existing methods for instance-level 6D pose estimation typically rely on neural networks that either directly regress the pose in $\\mathrm{SE}(3)$ or estimate it indirectly via local feature matching. The former struggle with object symmetries, while the latter fail in the absence of distinctive local features. To overcome these limitations, we propose a novel formulation of 6D pose estimation as a conditional flow matching problem in $\\mathbb{R}^3$. We introduce Flose, a generative method that infers object poses via a denoising process conditioned on local features. While prior approaches based on conditional flow matching perform denoising solely based on geometric guidance, Flose integrates appearance-based semantic features to mitigate ambiguities caused by object symmetries. We further incorporate RANSAC-based registration to handle outliers. We validate Flose on five datasets from the established BOP benchmark. Flose outperforms prior methods with an average improvement of +4.5 Average Recall. Project Website : https://tev-fbk.github.io/Flose/"},{"descriptionType":"Other","description":"Project Website : https://tev-fbk.github.io/Flose/"}],"geoLocations":[],"fundingReferences":[],"url":"https://arxiv.org/abs/2602.19719","contentUrl":null,"metadataVersion":0,"schemaVersion":"http://datacite.org/schema/kernel-4","source":"mds","isActive":true,"state":"findable","reason":null,"viewCount":0,"downloadCount":0,"referenceCount":0,"citationCount":0,"partCount":0,"partOfCount":0,"versionCount":0,"versionOfCount":0,"created":"2026-02-25T15:12:00Z","registered":"2026-02-25T15:12:01Z","published":null,"updated":"2026-02-25T15:12:01Z"},"relationships":{"client":{"data":{"id":"arxiv.content","type":"clients"}}}},{"id":"10.48550/arxiv.2602.19716","type":"dois","attributes":{"doi":"10.48550/arxiv.2602.19716","identifiers":[{"identifier":"2602.19716","identifierType":"arXiv"}],"creators":[{"nameType":"Personal","givenName":"Sajjad","familyName":"Marri","name":"Marri, Sajjad","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Ahmad Naderi","familyName":"Beni","name":"Beni, Ahmad Naderi","affiliation":[],"nameIdentifiers":[]}],"titles":[{"title":"Investigation of the $K^{-}pp$ Bound State via the \\( K^{-} + {}^{3}\\mathrm{He} \\) Reaction"}],"publisher":"arXiv","container":{},"publicationYear":2026,"subjects":[{"subject":"Nuclear Theory (nucl-th)","lang":"en","subjectScheme":"arXiv"},{"subject":"FOS: Physical sciences","subjectScheme":"Fields of Science and Technology (FOS)"},{"schemeUri":"http://www.oecd.org/science/inno/38235147.pdf","subject":"FOS: Physical sciences","subjectScheme":"Fields of Science and Technology (FOS)"}],"contributors":[],"dates":[{"date":"2026-02-23T11:10:13Z","dateType":"Submitted","dateInformation":"v1"},{"date":"2026-02-24T02:21:53Z","dateType":"Updated","dateInformation":"v1"},{"date":"2026-02","dateType":"Available","dateInformation":"v1"},{"date":"2026","dateType":"Issued"}],"language":null,"types":{"schemaOrg":"CreativeWork","resourceTypeGeneral":"Preprint","citeproc":"article","bibtex":"misc","ris":"GEN","resourceType":"Article"},"relatedIdentifiers":[],"relatedItems":[],"sizes":[],"formats":[],"version":"1","rightsList":[{"rightsUri":"http://arxiv.org/licenses/nonexclusive-distrib/1.0/","rights":"arXiv.org perpetual, non-exclusive license"}],"descriptions":[{"descriptionType":"Abstract","description":"Using the four-body Alt-Grassberger-Sandhas (AGS) equations for the \\( K^{-}ppn \\) system, we investigate the possible formation of a \\( K^{-}pp \\) quasi-bound state through the low-energy \\( K^{-} + {}^{3}\\mathrm{He} \\) reaction. The neutron missing mass spectrum in the final state was calculated for different models of the \\( \\bar{K}N \\) interaction. The results indicate that, irrespective of the specific nature of the \\( Λ(1405) \\) structure or the details of the \\( \\bar{K}N \\) interaction model, a signal corresponding to the \\( K^{-}pp \\) quasi-bound state could appear in the \\( πΣp \\) mass spectrum. This supports the feasibility of observing the \\( K^{-}pp \\) cluster in low-energy kaon-induced reactions on helium-3."},{"descriptionType":"Other","description":"11 pages, 4 figures"}],"geoLocations":[],"fundingReferences":[],"url":"https://arxiv.org/abs/2602.19716","contentUrl":null,"metadataVersion":0,"schemaVersion":"http://datacite.org/schema/kernel-4","source":"mds","isActive":true,"state":"findable","reason":null,"viewCount":0,"downloadCount":0,"referenceCount":0,"citationCount":0,"partCount":0,"partOfCount":0,"versionCount":0,"versionOfCount":0,"created":"2026-02-25T15:11:53Z","registered":"2026-02-25T15:11:53Z","published":null,"updated":"2026-02-25T15:11:53Z"},"relationships":{"client":{"data":{"id":"arxiv.content","type":"clients"}}}},{"id":"10.48550/arxiv.2602.19715","type":"dois","attributes":{"doi":"10.48550/arxiv.2602.19715","identifiers":[{"identifier":"2602.19715","identifierType":"arXiv"}],"creators":[{"nameType":"Personal","givenName":"Kartik","familyName":"Kuckreja","name":"Kuckreja, Kartik","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Parul","familyName":"Gupta","name":"Gupta, Parul","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Muhammad Haris","familyName":"Khan","name":"Khan, Muhammad Haris","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Abhinav","familyName":"Dhall","name":"Dhall, Abhinav","affiliation":[],"nameIdentifiers":[]}],"titles":[{"title":"Pixels Don't Lie (But Your Detector Might): Bootstrapping MLLM-as-a-Judge for Trustworthy Deepfake Detection and Reasoning Supervision"}],"publisher":"arXiv","container":{},"publicationYear":2026,"subjects":[{"subject":"Computer Vision and Pattern Recognition (cs.CV)","lang":"en","subjectScheme":"arXiv"},{"subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"},{"schemeUri":"http://www.oecd.org/science/inno/38235147.pdf","subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"}],"contributors":[],"dates":[{"date":"2026-02-23T11:08:46Z","dateType":"Submitted","dateInformation":"v1"},{"date":"2026-02-24T02:21:47Z","dateType":"Updated","dateInformation":"v1"},{"date":"2026-02","dateType":"Available","dateInformation":"v1"},{"date":"2026","dateType":"Issued"}],"language":null,"types":{"schemaOrg":"CreativeWork","resourceTypeGeneral":"Preprint","citeproc":"article","bibtex":"misc","ris":"GEN","resourceType":"Article"},"relatedIdentifiers":[],"relatedItems":[],"sizes":[],"formats":[],"version":"1","rightsList":[{"rightsIdentifierScheme":"SPDX","rightsUri":"https://creativecommons.org/licenses/by/4.0/legalcode","schemeUri":"https://spdx.org/licenses/","rights":"Creative Commons Attribution 4.0 International","rightsIdentifier":"cc-by-4.0"}],"descriptions":[{"descriptionType":"Abstract","description":"Deepfake detection models often generate natural-language explanations, yet their reasoning is frequently ungrounded in visual evidence, limiting reliability. Existing evaluations measure classification accuracy but overlook reasoning fidelity. We propose DeepfakeJudge, a framework for scalable reasoning supervision and evaluation, that integrates an out-of-distribution benchmark containing recent generative and editing forgeries, a human-annotated subset with visual reasoning labels, and a suite of evaluation models, that specialize in evaluating reasoning rationales without the need for explicit ground truth reasoning rationales. The Judge is optimized through a bootstrapped generator-evaluator process that scales human feedback into structured reasoning supervision and supports both pointwise and pairwise evaluation. On the proposed meta-evaluation benchmark, our reasoning-bootstrapped model achieves an accuracy of 96.2\\%, outperforming \\texttt{30x} larger baselines. The reasoning judge attains very high correlation with human ratings and 98.9\\% percent pairwise agreement on the human-annotated meta-evaluation subset. These results establish reasoning fidelity as a quantifiable dimension of deepfake detection and demonstrate scalable supervision for interpretable deepfake reasoning. Our user study shows that participants preferred the reasonings generated by our framework 70\\% of the time, in terms of faithfulness, groundedness, and usefulness, compared to those produced by other models and datasets. All of our datasets, models, and codebase are \\href{https://github.com/KjAeRsTuIsK/DeepfakeJudge}{open-sourced}."},{"descriptionType":"Other","description":"CVPR-2026, Code is available here: https://github.com/KjAeRsTuIsK/DeepfakeJudge"}],"geoLocations":[],"fundingReferences":[],"url":"https://arxiv.org/abs/2602.19715","contentUrl":null,"metadataVersion":0,"schemaVersion":"http://datacite.org/schema/kernel-4","source":"mds","isActive":true,"state":"findable","reason":null,"viewCount":0,"downloadCount":0,"referenceCount":0,"citationCount":0,"partCount":0,"partOfCount":0,"versionCount":0,"versionOfCount":0,"created":"2026-02-25T15:11:50Z","registered":"2026-02-25T15:11:51Z","published":null,"updated":"2026-02-25T15:11:51Z"},"relationships":{"client":{"data":{"id":"arxiv.content","type":"clients"}}}},{"id":"10.48550/arxiv.2602.19714","type":"dois","attributes":{"doi":"10.48550/arxiv.2602.19714","identifiers":[{"identifier":"2602.19714","identifierType":"arXiv"}],"creators":[{"nameType":"Personal","givenName":"Joel","familyName":"Bucher","name":"Bucher, Joel","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Lahari","familyName":"Goswami","name":"Goswami, Lahari","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Sverrir","familyName":"Thorgeirsson","name":"Thorgeirsson, Sverrir","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"April Yi","familyName":"Wang","name":"Wang, April Yi","affiliation":[],"nameIdentifiers":[]}],"titles":[{"title":"Git Takes Two: Split-View Awareness for Collaborative Learning of Distributed Workflows in Git"}],"publisher":"arXiv","container":{},"publicationYear":2026,"subjects":[{"subject":"Human-Computer Interaction (cs.HC)","lang":"en","subjectScheme":"arXiv"},{"subject":"Software Engineering (cs.SE)","lang":"en","subjectScheme":"arXiv"},{"subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"},{"schemeUri":"http://www.oecd.org/science/inno/38235147.pdf","subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"}],"contributors":[],"dates":[{"date":"2026-02-23T11:05:56Z","dateType":"Submitted","dateInformation":"v1"},{"date":"2026-02-24T02:21:40Z","dateType":"Updated","dateInformation":"v1"},{"date":"2026-02","dateType":"Available","dateInformation":"v1"},{"date":"2026","dateType":"Issued"}],"language":null,"types":{"schemaOrg":"CreativeWork","resourceTypeGeneral":"Preprint","citeproc":"article","bibtex":"misc","ris":"GEN","resourceType":"Article"},"relatedIdentifiers":[{"relationType":"IsVersionOf","relatedIdentifier":"10.1145/3772318.3791254","relatedIdentifierType":"DOI"}],"relatedItems":[],"sizes":[],"formats":[],"version":"1","rightsList":[{"rightsIdentifierScheme":"SPDX","rightsUri":"https://creativecommons.org/licenses/by-nc-nd/4.0/legalcode","schemeUri":"https://spdx.org/licenses/","rights":"Creative Commons Attribution Non Commercial No Derivatives 4.0 International","rightsIdentifier":"cc-by-nc-nd-4.0"}],"descriptions":[{"descriptionType":"Abstract","description":"Git is widely used for collaborative software development, but it can be challenging for newcomers. While most learning tools focus on individual workflows, Git is inherently collaborative. We present GitAcademy, a browser-based learning platform that embeds a full Git environment with a split-view collaborative mode: learners work on their own local repositories connected to a shared remote repository, while simultaneously seeing their partner's actions mirrored in real time. This design is not intended for everyday software development, but rather as a training simulator to build awareness of distributed states, coordination, and collaborative troubleshooting. In a within-subjects study with 13 pairs of learners, we found that the split-view interface enhanced social presence, supported peer teaching, and was consistently preferred over a single-view baseline, even though performance gains were mixed. We further discuss how split-view awareness can serve as a training-only scaffold for collaborative learning of Git and other distributed technical systems."},{"descriptionType":"Other","description":"First two authors contributed equally"}],"geoLocations":[],"fundingReferences":[],"url":"https://arxiv.org/abs/2602.19714","contentUrl":null,"metadataVersion":0,"schemaVersion":"http://datacite.org/schema/kernel-4","source":"mds","isActive":true,"state":"findable","reason":null,"viewCount":0,"downloadCount":0,"referenceCount":0,"citationCount":0,"partCount":0,"partOfCount":0,"versionCount":0,"versionOfCount":1,"created":"2026-02-25T15:11:48Z","registered":"2026-02-25T15:11:48Z","published":null,"updated":"2026-02-25T15:11:48Z"},"relationships":{"client":{"data":{"id":"arxiv.content","type":"clients"}}}},{"id":"10.48550/arxiv.2602.19713","type":"dois","attributes":{"doi":"10.48550/arxiv.2602.19713","identifiers":[{"identifier":"2602.19713","identifierType":"arXiv"}],"creators":[{"nameType":"Personal","givenName":"Shantanu","familyName":"Pathak","name":"Pathak, Shantanu","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Saswata","familyName":"Bhattacharya","name":"Bhattacharya, Saswata","affiliation":[],"nameIdentifiers":[]}],"titles":[{"title":"Strain- and Field-Tunable Nonrelativistic Spin Splitting and Wave-Symmetry-Dependent Spin Transport in Twisted Bilayer Altermagnets"}],"publisher":"arXiv","container":{},"publicationYear":2026,"subjects":[{"subject":"Materials Science (cond-mat.mtrl-sci)","lang":"en","subjectScheme":"arXiv"},{"subject":"FOS: Physical sciences","subjectScheme":"Fields of Science and Technology (FOS)"},{"schemeUri":"http://www.oecd.org/science/inno/38235147.pdf","subject":"FOS: Physical sciences","subjectScheme":"Fields of Science and Technology (FOS)"}],"contributors":[],"dates":[{"date":"2026-02-23T11:02:56Z","dateType":"Submitted","dateInformation":"v1"},{"date":"2026-02-24T02:21:27Z","dateType":"Updated","dateInformation":"v1"},{"date":"2026-02","dateType":"Available","dateInformation":"v1"},{"date":"2026","dateType":"Issued"}],"language":null,"types":{"schemaOrg":"CreativeWork","resourceTypeGeneral":"Preprint","citeproc":"article","bibtex":"misc","ris":"GEN","resourceType":"Article"},"relatedIdentifiers":[],"relatedItems":[],"sizes":[],"formats":[],"version":"1","rightsList":[{"rightsIdentifierScheme":"SPDX","rightsUri":"https://creativecommons.org/licenses/by/4.0/legalcode","schemeUri":"https://spdx.org/licenses/","rights":"Creative Commons Attribution 4.0 International","rightsIdentifier":"cc-by-4.0"}],"descriptions":[{"descriptionType":"Abstract","description":"Magnetism-driven nonrelativistic spin splitting (NRSS) provides a pathway toward efficient, spin-orbit-free spintronics. In centrosymmetric two-dimensional antiferromagnets, spin-polarized transport is symmetry-forbidden due to the combined space-time inversion ($PT$) symmetry. Here, by employing first-principles density functional theory and spin-group symmetry analysis, we demonstrate that twisting two antiferromagnetic or ferromagnetic monolayers of CoCl$_2$, AX$_2$ (A = Mn, V; X = Cl, Br, I), NiF$_2$, NiBr$_2$, FeS, CoS, MnTe$_2$, MnSe$_2$, and RuSe induces finite NRSS even in the absence of spin-orbit coupling. The relative twist breaks $[C_2||P]$ and $[E||C_{nz}]$ symmetries, giving rise to momentum-dependent spin polarization with distinct $d$-, $g$-, and $i$-wave altermagnetic patterns across the Brillouin zone. Using symmetry-invariant $k\\cdot p$ modeling, we extract linear spin-splitting coefficients $α^{(1)}$ ranging from 800-1100 meVÅ, comparable to SOC-induced Rashba-Dresselhaus strengths observed in noncentrosymmetric semiconductors. An out-of-plane electric field ($\\mathcal{E}_z$) introduces Zeeman-type band splitting up to 110 meV at 10 MV/cm, while biaxial strain tunes the NRSS magnitude nearly linearly without altering symmetry. Crucially, the strain $u_{xx-yy}$ reduces the spin point group symmetry and drives reversible $g/i \\rightarrow d$ wave-type transitions, resulting in finite spin conductivity and an enhanced spin-splitter angle (up to 18$^\\circ$). These results extend the concept of altermagnetism to twisted bilayer geometries and establish a general route for realizing exchange-driven, nonrelativistic spin currents through symmetry engineering without requiring heavy elements or spin-orbit coupling."}],"geoLocations":[],"fundingReferences":[],"url":"https://arxiv.org/abs/2602.19713","contentUrl":null,"metadataVersion":0,"schemaVersion":"http://datacite.org/schema/kernel-4","source":"mds","isActive":true,"state":"findable","reason":null,"viewCount":0,"downloadCount":0,"referenceCount":0,"citationCount":0,"partCount":0,"partOfCount":0,"versionCount":0,"versionOfCount":0,"created":"2026-02-25T15:11:45Z","registered":"2026-02-25T15:11:46Z","published":null,"updated":"2026-02-25T15:11:46Z"},"relationships":{"client":{"data":{"id":"arxiv.content","type":"clients"}}}},{"id":"10.48550/arxiv.2602.19712","type":"dois","attributes":{"doi":"10.48550/arxiv.2602.19712","identifiers":[{"identifier":"2602.19712","identifierType":"arXiv"}],"creators":[{"nameType":"Personal","givenName":"Kyrre Ness","familyName":"Sjobak","name":"Sjobak, Kyrre Ness","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Elisabeth","familyName":"Rød-Lindberg","name":"Rød-Lindberg, Elisabeth","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Abélia","familyName":"Ellingsen","name":"Ellingsen, Abélia","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Pierre","familyName":"Drobniak","name":"Drobniak, Pierre","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Vilde Flognfeldt","familyName":"Rieker","name":"Rieker, Vilde Flognfeldt","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Fardous","familyName":"Reaz","name":"Reaz, Fardous","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Carl Andreas","familyName":"Lindstrøm","name":"Lindstrøm, Carl Andreas","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Erik","familyName":"Adli","name":"Adli, Erik","affiliation":[],"nameIdentifiers":[]}],"titles":[{"title":"SHARP: A compact focusing system for medical applications using a diverging plasma lens"}],"publisher":"arXiv","container":{},"publicationYear":2026,"subjects":[{"subject":"Medical Physics (physics.med-ph)","lang":"en","subjectScheme":"arXiv"},{"subject":"Accelerator Physics (physics.acc-ph)","lang":"en","subjectScheme":"arXiv"},{"subject":"FOS: Physical sciences","subjectScheme":"Fields of Science and Technology (FOS)"},{"schemeUri":"http://www.oecd.org/science/inno/38235147.pdf","subject":"FOS: Physical sciences","subjectScheme":"Fields of Science and Technology (FOS)"}],"contributors":[],"dates":[{"date":"2026-02-23T11:02:13Z","dateType":"Submitted","dateInformation":"v1"},{"date":"2026-02-24T02:21:25Z","dateType":"Updated","dateInformation":"v1"},{"date":"2026-02","dateType":"Available","dateInformation":"v1"},{"date":"2026","dateType":"Issued"}],"language":null,"types":{"schemaOrg":"CreativeWork","resourceTypeGeneral":"Preprint","citeproc":"article","bibtex":"misc","ris":"GEN","resourceType":"Article"},"relatedIdentifiers":[],"relatedItems":[],"sizes":[],"formats":[],"version":"1","rightsList":[{"rightsIdentifierScheme":"SPDX","rightsUri":"https://creativecommons.org/licenses/by/4.0/legalcode","schemeUri":"https://spdx.org/licenses/","rights":"Creative Commons Attribution 4.0 International","rightsIdentifier":"cc-by-4.0"}],"descriptions":[{"descriptionType":"Abstract","description":"Cancer therapy for deep-seated tumors requires precise irradiation of a small target deep within the patient while minimizing radiation exposure to surrounding tissues. This can be accomplished with a round beam sharply converging towards a single spot, requiring a large beam size in both planes at the exit of the focusing system. Achieving this over a short distance using only quadrupole lenses is challenging; but by using a linear active plasma lens (APL) in defocusing mode, the beam can be quickly and non-destructively enlarged before focusing using quadrupoles. The position of the irradiation spot can also be scanned in three dimensions by changing magnet settings. The SHARP project will develop and test this concept. Such a system can be used with very high energy electrons (hundreds of MeV), creating a Bragg-peak-like spot using novel accelerator technology. This could lead to more compact radiotherapy facilities, not requiring a bulky infrastructure typically associated with proton radiotherapy machines. If successful, SHARP will enable precision conformal radiotherapy, spatial fractionation, and potentially be useful for FLASH radiotherapy."},{"descriptionType":"Other","description":"18 pages, 9 figures. Submitted to the proceedings of the European Advanced Accelerator Conference (EAAC) 2025"}],"geoLocations":[],"fundingReferences":[],"url":"https://arxiv.org/abs/2602.19712","contentUrl":null,"metadataVersion":0,"schemaVersion":"http://datacite.org/schema/kernel-4","source":"mds","isActive":true,"state":"findable","reason":null,"viewCount":0,"downloadCount":0,"referenceCount":0,"citationCount":0,"partCount":0,"partOfCount":0,"versionCount":0,"versionOfCount":0,"created":"2026-02-25T15:11:43Z","registered":"2026-02-25T15:11:44Z","published":null,"updated":"2026-02-25T15:11:44Z"},"relationships":{"client":{"data":{"id":"arxiv.content","type":"clients"}}}},{"id":"10.48550/arxiv.2602.19711","type":"dois","attributes":{"doi":"10.48550/arxiv.2602.19711","identifiers":[{"identifier":"2602.19711","identifierType":"arXiv"}],"creators":[{"nameType":"Personal","givenName":"Krzysztof","familyName":"Kutt","name":"Kutt, Krzysztof","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Elżbieta","familyName":"Sroka","name":"Sroka, Elżbieta","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Oleksandra","familyName":"Ishchuk","name":"Ishchuk, Oleksandra","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Luiz do Valle","familyName":"Miranda","name":"Miranda, Luiz do Valle","affiliation":[],"nameIdentifiers":[]}],"titles":[{"title":"A Three-stage Neuro-symbolic Recommendation Pipeline for Cultural Heritage Knowledge Graphs"}],"publisher":"arXiv","container":{},"publicationYear":2026,"subjects":[{"subject":"Information Retrieval (cs.IR)","lang":"en","subjectScheme":"arXiv"},{"subject":"Digital Libraries (cs.DL)","lang":"en","subjectScheme":"arXiv"},{"subject":"Human-Computer Interaction (cs.HC)","lang":"en","subjectScheme":"arXiv"},{"subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"},{"schemeUri":"http://www.oecd.org/science/inno/38235147.pdf","subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"}],"contributors":[],"dates":[{"date":"2026-02-23T11:02:13Z","dateType":"Submitted","dateInformation":"v1"},{"date":"2026-02-24T02:21:24Z","dateType":"Updated","dateInformation":"v1"},{"date":"2026-02","dateType":"Available","dateInformation":"v1"},{"date":"2026","dateType":"Issued"}],"language":null,"types":{"schemaOrg":"CreativeWork","resourceTypeGeneral":"Preprint","citeproc":"article","bibtex":"misc","ris":"GEN","resourceType":"Article"},"relatedIdentifiers":[],"relatedItems":[],"sizes":[],"formats":[],"version":"1","rightsList":[{"rightsUri":"http://arxiv.org/licenses/nonexclusive-distrib/1.0/","rights":"arXiv.org perpetual, non-exclusive license"}],"descriptions":[{"descriptionType":"Abstract","description":"The growing volume of digital cultural heritage resources highlights the need for advanced recommendation methods capable of interpreting semantic relationships between heterogeneous data entities. This paper presents a complete methodology for implementing a hybrid recommendation pipeline integrating knowledge-graph embeddings, approximate nearest-neighbour search, and SPARQL-driven semantic filtering. The work is evaluated on the JUHMP (Jagiellonian University Heritage Metadata Portal) knowledge graph developed within the CHExRISH project, which at the time of experimentation contained ${\\approx}3.2$M RDF triples describing people, events, objects, and historical relations affiliated with the Jagiellonian University (Kraków, PL). We evaluate four embedding families (TransE, ComplEx, ConvE, CompGCN) and perform hyperparameter selection for ComplEx and HNSW. Then, we present and evaluate the final three-stage neuro-symbolic recommender. Despite sparse and heterogeneous metadata, the approach produces useful and explainable recommendations, which were also proven with expert evaluation."},{"descriptionType":"Other","description":"15 pages, 1 figure; submitted to ICCS 2026 conference"}],"geoLocations":[],"fundingReferences":[],"url":"https://arxiv.org/abs/2602.19711","contentUrl":null,"metadataVersion":0,"schemaVersion":"http://datacite.org/schema/kernel-4","source":"mds","isActive":true,"state":"findable","reason":null,"viewCount":0,"downloadCount":0,"referenceCount":0,"citationCount":0,"partCount":0,"partOfCount":0,"versionCount":0,"versionOfCount":0,"created":"2026-02-25T15:11:40Z","registered":"2026-02-25T15:11:41Z","published":null,"updated":"2026-02-25T15:11:41Z"},"relationships":{"client":{"data":{"id":"arxiv.content","type":"clients"}}}},{"id":"10.48550/arxiv.2602.19709","type":"dois","attributes":{"doi":"10.48550/arxiv.2602.19709","identifiers":[{"identifier":"2602.19709","identifierType":"arXiv"}],"creators":[{"nameType":"Personal","givenName":"Nils Lid","familyName":"Hjort","name":"Hjort, Nils Lid","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Mike","familyName":"Titterington","name":"Titterington, Mike","affiliation":[],"nameIdentifiers":[]}],"titles":[{"title":"On Expectation Propagation and the Probabilistic Editor in some simple mixture problems"}],"publisher":"arXiv","container":{},"publicationYear":2026,"subjects":[{"subject":"Statistics Theory (math.ST)","lang":"en","subjectScheme":"arXiv"},{"subject":"FOS: Mathematics","subjectScheme":"Fields of Science and Technology (FOS)"},{"schemeUri":"http://www.oecd.org/science/inno/38235147.pdf","subject":"FOS: Mathematics","subjectScheme":"Fields of Science and Technology (FOS)"}],"contributors":[],"dates":[{"date":"2026-02-23T11:00:02Z","dateType":"Submitted","dateInformation":"v1"},{"date":"2026-02-24T02:21:21Z","dateType":"Updated","dateInformation":"v1"},{"date":"2026-02","dateType":"Available","dateInformation":"v1"},{"date":"2026","dateType":"Issued"}],"language":null,"types":{"schemaOrg":"CreativeWork","resourceTypeGeneral":"Preprint","citeproc":"article","bibtex":"misc","ris":"GEN","resourceType":"Article"},"relatedIdentifiers":[],"relatedItems":[],"sizes":[],"formats":[],"version":"1","rightsList":[{"rightsUri":"http://arxiv.org/licenses/nonexclusive-distrib/1.0/","rights":"arXiv.org perpetual, non-exclusive license"}],"descriptions":[{"descriptionType":"Abstract","description":"As for other latent-variable problems, exact Bayesian analysis is typically not practicable for mixture problems and approximate methods have been developed. Variational Bayes tends to produce approximate posterior distributions for parameters that are too tightly concentrated in having variances that are too small. The paper identifies a few mixture problems in which Expectation Propagation and variations thereof lead to approximate posterior distributions that asymptotically exhibit `correct' variances and therefore stand to provide reliable interval estimates for the unknown parameter or parameters."},{"descriptionType":"Other","description":"22 pages, 0 figures; Mike Titterington passed away in 2023, at the age of 77; this is the October 2010 version of a paper we collaborated on then and (still) planned to extend before submitting to a journal"}],"geoLocations":[],"fundingReferences":[],"url":"https://arxiv.org/abs/2602.19709","contentUrl":null,"metadataVersion":0,"schemaVersion":"http://datacite.org/schema/kernel-4","source":"mds","isActive":true,"state":"findable","reason":null,"viewCount":0,"downloadCount":0,"referenceCount":0,"citationCount":0,"partCount":0,"partOfCount":0,"versionCount":0,"versionOfCount":0,"created":"2026-02-25T15:11:35Z","registered":"2026-02-25T15:11:36Z","published":null,"updated":"2026-02-25T15:11:36Z"},"relationships":{"client":{"data":{"id":"arxiv.content","type":"clients"}}}},{"id":"10.48550/arxiv.2602.19707","type":"dois","attributes":{"doi":"10.48550/arxiv.2602.19707","identifiers":[{"identifier":"2602.19707","identifierType":"arXiv"}],"creators":[{"nameType":"Personal","givenName":"Anna","familyName":"Velichko","name":"Velichko, Anna","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Yves","familyName":"Revaz","name":"Revaz, Yves","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Annalisa","familyName":"De Cia","name":"De Cia, Annalisa","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Cédric","familyName":"Ledoux","name":"Ledoux, Cédric","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Jens-Kristian","familyName":"Krogager","name":"Krogager, Jens-Kristian","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Céline","familyName":"Péroux","name":"Péroux, Céline","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Benedetta","familyName":"Casavecchia","name":"Casavecchia, Benedetta","affiliation":[],"nameIdentifiers":[]}],"titles":[{"title":"Chemodynamical properties of gas-rich galaxies: a comparison of observations and simulations"}],"publisher":"arXiv","container":{},"publicationYear":2026,"subjects":[{"subject":"Astrophysics of Galaxies (astro-ph.GA)","lang":"en","subjectScheme":"arXiv"},{"subject":"FOS: Physical sciences","subjectScheme":"Fields of Science and Technology (FOS)"},{"schemeUri":"http://www.oecd.org/science/inno/38235147.pdf","subject":"FOS: Physical sciences","subjectScheme":"Fields of Science and Technology (FOS)"}],"contributors":[],"dates":[{"date":"2026-02-23T10:59:02Z","dateType":"Submitted","dateInformation":"v1"},{"date":"2026-02-24T02:21:18Z","dateType":"Updated","dateInformation":"v1"},{"date":"2026-02","dateType":"Available","dateInformation":"v1"},{"date":"2026","dateType":"Issued"}],"language":null,"types":{"schemaOrg":"CreativeWork","resourceTypeGeneral":"Preprint","citeproc":"article","bibtex":"misc","ris":"GEN","resourceType":"Article"},"relatedIdentifiers":[],"relatedItems":[],"sizes":[],"formats":[],"version":"1","rightsList":[{"rightsUri":"http://arxiv.org/licenses/nonexclusive-distrib/1.0/","rights":"arXiv.org perpetual, non-exclusive license"}],"descriptions":[{"descriptionType":"Abstract","description":"We perform a comprehensive analysis of the chemical and dynamical properties of quasar-damped Lyman-α (DLA) galaxies and compare these to the GEAR chemodynamical simulations. Specifically, we aim to constrain the behavior of α-element enhancements with metallicity, the dependence of [α/Fe] on the specific star formation rate (sSFR), and the absorption-line velocity widths (Δv90) vs. stellar mass, Δv90 vs. metallicity, and mass-metallicity relations. For the comparison, we select five galaxies simulated with the chemodynamical Tree-SPH code GEAR with stellar masses in the range of log(M*/Msol) between 6.1 and 10.8, and at six different redshifts between 0.33 and 4.12. We find that the abundance ratios [α/Fe] and [M/H] observed in the interstellar medium (ISM) of DLA galaxies overlap with the abundance trends in gas of the simulated galaxies. Our findings corroborate a picture in which DLAs with Δv90 below and above 100 km/s trace galaxies with masses in the ranges of log M* 6 - 8 and 8 - 11 solar masses, respectively. We suggest that observations should be used with caution when constraining the theoretical [α/Fe] vs. sSFR relations because of systematics (if abundances are obtained from emission lines) or differences in the gas properties as probed by a DLA and its counterpart. So far, only the observations in absorption of inner gas of the LMC and SMC are in agreement with the simulated data. We confirm that DLAs detected at large impact parameters most likely probe the gas of satellite or other halo galaxies which are adjacent to the central galaxy. We further find that the velocity widths vs. stellar masses and mass-metallicity relations agree well with observations, while GEAR should be calibrated more carefully to reproduce the Δv90 vs. metallicity relation."},{"descriptionType":"Other","description":"Accepted for publication in A\u0026amp;A"}],"geoLocations":[],"fundingReferences":[],"url":"https://arxiv.org/abs/2602.19707","contentUrl":null,"metadataVersion":0,"schemaVersion":"http://datacite.org/schema/kernel-4","source":"mds","isActive":true,"state":"findable","reason":null,"viewCount":0,"downloadCount":0,"referenceCount":0,"citationCount":0,"partCount":0,"partOfCount":0,"versionCount":0,"versionOfCount":0,"created":"2026-02-25T15:11:31Z","registered":"2026-02-25T15:11:31Z","published":null,"updated":"2026-02-25T15:11:31Z"},"relationships":{"client":{"data":{"id":"arxiv.content","type":"clients"}}}},{"id":"10.48550/arxiv.2602.19706","type":"dois","attributes":{"doi":"10.48550/arxiv.2602.19706","identifiers":[{"identifier":"2602.19706","identifierType":"arXiv"}],"creators":[{"nameType":"Personal","givenName":"Yo-Tin","familyName":"Lin","name":"Lin, Yo-Tin","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Su-Kai","familyName":"Chen","name":"Chen, Su-Kai","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Hou-Ning","familyName":"Hu","name":"Hu, Hou-Ning","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Yen-Yu","familyName":"Lin","name":"Lin, Yen-Yu","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Yu-Lun","familyName":"Liu","name":"Liu, Yu-Lun","affiliation":[],"nameIdentifiers":[]}],"titles":[{"title":"HDR Reconstruction Boosting with Training-Free and Exposure-Consistent Diffusion"}],"publisher":"arXiv","container":{},"publicationYear":2026,"subjects":[{"subject":"Computer Vision and Pattern Recognition (cs.CV)","lang":"en","subjectScheme":"arXiv"},{"subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"},{"schemeUri":"http://www.oecd.org/science/inno/38235147.pdf","subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"}],"contributors":[],"dates":[{"date":"2026-02-23T10:57:22Z","dateType":"Submitted","dateInformation":"v1"},{"date":"2026-02-24T02:21:14Z","dateType":"Updated","dateInformation":"v1"},{"date":"2026-02","dateType":"Available","dateInformation":"v1"},{"date":"2026","dateType":"Issued"}],"language":null,"types":{"schemaOrg":"CreativeWork","resourceTypeGeneral":"Preprint","citeproc":"article","bibtex":"misc","ris":"GEN","resourceType":"Article"},"relatedIdentifiers":[],"relatedItems":[],"sizes":[],"formats":[],"version":"1","rightsList":[{"rightsIdentifierScheme":"SPDX","rightsUri":"https://creativecommons.org/licenses/by/4.0/legalcode","schemeUri":"https://spdx.org/licenses/","rights":"Creative Commons Attribution 4.0 International","rightsIdentifier":"cc-by-4.0"}],"descriptions":[{"descriptionType":"Abstract","description":"Single LDR to HDR reconstruction remains challenging for over-exposed regions where traditional methods often fail due to complete information loss. We present a training-free approach that enhances existing indirect and direct HDR reconstruction methods through diffusion-based inpainting. Our method combines text-guided diffusion models with SDEdit refinement to generate plausible content in over-exposed areas while maintaining consistency across multi-exposure LDR images. Unlike previous approaches requiring extensive training, our method seamlessly integrates with existing HDR reconstruction techniques through an iterative compensation mechanism that ensures luminance coherence across multiple exposures. We demonstrate significant improvements in both perceptual quality and quantitative metrics on standard HDR datasets and in-the-wild captures. Results show that our method effectively recovers natural details in challenging scenarios while preserving the advantages of existing HDR reconstruction pipelines. Project page: https://github.com/EusdenLin/HDR-Reconstruction-Boosting"},{"descriptionType":"Other","description":"WACV 2026. Project page: https://github.com/EusdenLin/HDR-Reconstruction-Boosting"}],"geoLocations":[],"fundingReferences":[],"url":"https://arxiv.org/abs/2602.19706","contentUrl":null,"metadataVersion":0,"schemaVersion":"http://datacite.org/schema/kernel-4","source":"mds","isActive":true,"state":"findable","reason":null,"viewCount":0,"downloadCount":0,"referenceCount":0,"citationCount":0,"partCount":0,"partOfCount":0,"versionCount":0,"versionOfCount":0,"created":"2026-02-25T15:11:28Z","registered":"2026-02-25T15:11:29Z","published":null,"updated":"2026-02-25T15:11:29Z"},"relationships":{"client":{"data":{"id":"arxiv.content","type":"clients"}}}},{"id":"10.48550/arxiv.2602.19705","type":"dois","attributes":{"doi":"10.48550/arxiv.2602.19705","identifiers":[{"identifier":"2602.19705","identifierType":"arXiv"}],"creators":[{"nameType":"Personal","givenName":"George","familyName":"Kapetanios","name":"Kapetanios, George","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Vasilis","familyName":"Sarafidis","name":"Sarafidis, Vasilis","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Alexia","familyName":"Ventouri","name":"Ventouri, Alexia","affiliation":[],"nameIdentifiers":[]}],"titles":[{"title":"Model Selection in High-Dimensional Linear Regression using Boosting with Multiple Testing"}],"publisher":"arXiv","container":{},"publicationYear":2026,"subjects":[{"subject":"Econometrics (econ.EM)","lang":"en","subjectScheme":"arXiv"},{"subject":"FOS: Economics and business","subjectScheme":"Fields of Science and Technology (FOS)"},{"schemeUri":"http://www.oecd.org/science/inno/38235147.pdf","subject":"FOS: Economics and business","subjectScheme":"Fields of Science and Technology (FOS)"}],"contributors":[],"dates":[{"date":"2026-02-23T10:55:18Z","dateType":"Submitted","dateInformation":"v1"},{"date":"2026-02-24T02:21:08Z","dateType":"Updated","dateInformation":"v1"},{"date":"2026-02","dateType":"Available","dateInformation":"v1"},{"date":"2026","dateType":"Issued"}],"language":null,"types":{"schemaOrg":"CreativeWork","resourceTypeGeneral":"Preprint","citeproc":"article","bibtex":"misc","ris":"GEN","resourceType":"Article"},"relatedIdentifiers":[],"relatedItems":[],"sizes":[],"formats":[],"version":"1","rightsList":[{"rightsIdentifierScheme":"SPDX","rightsUri":"https://creativecommons.org/licenses/by/4.0/legalcode","schemeUri":"https://spdx.org/licenses/","rights":"Creative Commons Attribution 4.0 International","rightsIdentifier":"cc-by-4.0"}],"descriptions":[{"descriptionType":"Abstract","description":"High-dimensional regression specification and analysis is a complex and active area of research in statistics, machine learning, and econometrics. This paper proposes a new approach, Boosting with Multiple Testing (BMT), which combines forward stepwise variable selection with the multiple testing framework of Chudik et al (2018). At each stage, the model is updated by adding only the most significant regressor conditional on those already included, while a family-wise multiple testing filter is applied to the remaining candidates. In this way, the method retains the strong screening properties of Chudik et al (2018) while operating in a less greedy manner with respect to proxy and noise variables. Using sharp probability inequalities for heterogeneous strongly mixing processes from Dendramis et al (2022), we show that BMT enjoys oracle type properties relative to an approximating model that includes all true signals and excludes pure noise variables: this model is selected with probability tending to one, and the resulting estimator achieves standard parametric rates for prediction error and coefficient estimation. Additional results establish conditions under which BMT recovers the exact true model and avoids selection of proxy signals. Monte Carlo experiments indicate that BMT performs very well relative to OCMT and Lasso type procedures, delivering higher model selection accuracy and smaller RMSE for the estimated coefficients, especially under strong multicollinearity of the regressors. Two empirical illustrations based on a large set of macro-financial indicators as covariates, show that BMT yields sparse, interpretable specifications with favourable out-of-sample performance."}],"geoLocations":[],"fundingReferences":[],"url":"https://arxiv.org/abs/2602.19705","contentUrl":null,"metadataVersion":0,"schemaVersion":"http://datacite.org/schema/kernel-4","source":"mds","isActive":true,"state":"findable","reason":null,"viewCount":0,"downloadCount":0,"referenceCount":0,"citationCount":0,"partCount":0,"partOfCount":0,"versionCount":0,"versionOfCount":0,"created":"2026-02-25T15:11:26Z","registered":"2026-02-25T15:11:27Z","published":null,"updated":"2026-02-25T15:11:27Z"},"relationships":{"client":{"data":{"id":"arxiv.content","type":"clients"}}}},{"id":"10.48550/arxiv.2602.19703","type":"dois","attributes":{"doi":"10.48550/arxiv.2602.19703","identifiers":[{"identifier":"2602.19703","identifierType":"arXiv"}],"creators":[{"nameType":"Personal","givenName":"Ana","familyName":"Armendariz","name":"Armendariz, Ana","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Martin","familyName":"Huber","name":"Huber, Martin","affiliation":[],"nameIdentifiers":[]}],"titles":[{"title":"Testing Effect Homogeneity and Confounding in High-Dimensional Experimental and Observational Studies"}],"publisher":"arXiv","container":{},"publicationYear":2026,"subjects":[{"subject":"Econometrics (econ.EM)","lang":"en","subjectScheme":"arXiv"},{"subject":"Machine Learning (stat.ML)","lang":"en","subjectScheme":"arXiv"},{"subject":"FOS: Economics and business","subjectScheme":"Fields of Science and Technology (FOS)"},{"schemeUri":"http://www.oecd.org/science/inno/38235147.pdf","subject":"FOS: Economics and business","subjectScheme":"Fields of Science and Technology (FOS)"},{"subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"},{"schemeUri":"http://www.oecd.org/science/inno/38235147.pdf","subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"}],"contributors":[],"dates":[{"date":"2026-02-23T10:52:39Z","dateType":"Submitted","dateInformation":"v1"},{"date":"2026-02-25T01:31:01Z","dateType":"Updated","dateInformation":"v1"},{"date":"2026-02","dateType":"Available","dateInformation":"v1"},{"date":"2026","dateType":"Issued"}],"language":null,"types":{"schemaOrg":"CreativeWork","resourceTypeGeneral":"Preprint","citeproc":"article","bibtex":"misc","ris":"GEN","resourceType":"Article"},"relatedIdentifiers":[],"relatedItems":[],"sizes":[],"formats":[],"version":"1","rightsList":[{"rightsIdentifierScheme":"SPDX","rightsUri":"https://creativecommons.org/licenses/by/4.0/legalcode","schemeUri":"https://spdx.org/licenses/","rights":"Creative Commons Attribution 4.0 International","rightsIdentifier":"cc-by-4.0"}],"descriptions":[{"descriptionType":"Abstract","description":"We propose a framework for testing the homogeneity of conditional average treatment effects (CATEs) across multiple experimental and observational studies. Our approach leverages multiple randomized trials to assess whether treatment effects vary with unobserved heterogeneity that differs across trials: if CATEs are homogeneous, this indicates the absence of interactions between treatment and unobservables in the mean effect. Comparing CATEs between experimental and observational data further allows evaluation of potential confounding: if the estimands coincide, there is no unobserved confounding; if they differ, deviations may arise from unobserved confounding, effect heterogeneity, or both. We extend the framework to settings with alternative identification strategies, namely instrumental variable settings and panel data with parallel trends assumptions based on differences in differences, where effects are identified only locally for subpopulations such as compliers or treated units. In these contexts, testing homogeneity is useful for assessing whether local effects can be extrapolated to the total population. We suggest a test based on double machine learning that accommodates high-dimensional covariates in a data-driven way and investigate its finite-sample performance through a simulation study. Finally, we apply the test to the International Stroke Trial (IST), a large multi-country randomized controlled trial in patients with acute ischaemic stroke that evaluated whether early treatment with aspirin altered subsequent clinical outcomes. Our methodology provides a flexible tool for both validating identification assumptions and understanding the generalizability of estimated treatment effects."}],"geoLocations":[],"fundingReferences":[],"url":"https://arxiv.org/abs/2602.19703","contentUrl":null,"metadataVersion":0,"schemaVersion":"http://datacite.org/schema/kernel-4","source":"mds","isActive":true,"state":"findable","reason":null,"viewCount":0,"downloadCount":0,"referenceCount":0,"citationCount":0,"partCount":0,"partOfCount":0,"versionCount":0,"versionOfCount":0,"created":"2026-02-25T15:11:21Z","registered":"2026-02-25T15:11:22Z","published":null,"updated":"2026-02-25T15:11:22Z"},"relationships":{"client":{"data":{"id":"arxiv.content","type":"clients"}}}},{"id":"10.48550/arxiv.2602.19702","type":"dois","attributes":{"doi":"10.48550/arxiv.2602.19702","identifiers":[{"identifier":"2602.19702","identifierType":"arXiv"}],"creators":[{"nameType":"Personal","givenName":"Adamya","familyName":"Shyam","name":"Shyam, Adamya","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Venkateswara Rao","familyName":"Kagita","name":"Kagita, Venkateswara Rao","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Bharti","familyName":"Rana","name":"Rana, Bharti","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Vikas","familyName":"Kumar","name":"Kumar, Vikas","affiliation":[],"nameIdentifiers":[]}],"titles":[{"title":"DReX: An Explainable Deep Learning-based Multimodal Recommendation Framework"}],"publisher":"arXiv","container":{},"publicationYear":2026,"subjects":[{"subject":"Information Retrieval (cs.IR)","lang":"en","subjectScheme":"arXiv"},{"subject":"Artificial Intelligence (cs.AI)","lang":"en","subjectScheme":"arXiv"},{"subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"},{"schemeUri":"http://www.oecd.org/science/inno/38235147.pdf","subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"}],"contributors":[],"dates":[{"date":"2026-02-23T10:52:20Z","dateType":"Submitted","dateInformation":"v1"},{"date":"2026-02-24T02:21:02Z","dateType":"Updated","dateInformation":"v1"},{"date":"2026-02","dateType":"Available","dateInformation":"v1"},{"date":"2026","dateType":"Issued"}],"language":null,"types":{"schemaOrg":"CreativeWork","resourceTypeGeneral":"Preprint","citeproc":"article","bibtex":"misc","ris":"GEN","resourceType":"Article"},"relatedIdentifiers":[],"relatedItems":[],"sizes":[],"formats":[],"version":"1","rightsList":[{"rightsUri":"http://arxiv.org/licenses/nonexclusive-distrib/1.0/","rights":"arXiv.org perpetual, non-exclusive license"}],"descriptions":[{"descriptionType":"Abstract","description":"Multimodal recommender systems leverage diverse data sources, such as user interactions, content features, and contextual information, to address challenges like cold-start and data sparsity. However, existing methods often suffer from one or more key limitations: processing different modalities in isolation, requiring complete multimodal data for each interaction during training, or independent learning of user and item representations. These factors contribute to increased complexity and potential misalignment between user and item embeddings. To address these challenges, we propose DReX, a unified multimodal recommendation framework that incrementally refines user and item representations by leveraging interaction-level features from multimodal feedback. Our model employs gated recurrent units to selectively integrate these fine-grained features into global representations. This incremental update mechanism provides three key advantages: (1) simultaneous modeling of both nuanced interaction details and broader preference patterns, (2) eliminates the need for separate user and item feature extraction processes, leading to enhanced alignment in their learned representation, and (3) inherent robustness to varying or missing modalities. We evaluate the performance of the proposed approach on three real-world datasets containing reviews and ratings as interaction modalities. By considering review text as a modality, our approach automatically generates interpretable keyword profiles for both users and items, which supplement the recommendation process with interpretable preference indicators. Experiment results demonstrate that our approach outperforms state-of-the-art methods across all evaluated datasets."}],"geoLocations":[],"fundingReferences":[],"url":"https://arxiv.org/abs/2602.19702","contentUrl":null,"metadataVersion":0,"schemaVersion":"http://datacite.org/schema/kernel-4","source":"mds","isActive":true,"state":"findable","reason":null,"viewCount":0,"downloadCount":0,"referenceCount":0,"citationCount":0,"partCount":0,"partOfCount":0,"versionCount":0,"versionOfCount":0,"created":"2026-02-25T15:11:19Z","registered":"2026-02-25T15:11:19Z","published":null,"updated":"2026-02-25T15:11:19Z"},"relationships":{"client":{"data":{"id":"arxiv.content","type":"clients"}}}},{"id":"10.48550/arxiv.2602.19701","type":"dois","attributes":{"doi":"10.48550/arxiv.2602.19701","identifiers":[{"identifier":"2602.19701","identifierType":"arXiv"}],"creators":[{"nameType":"Personal","givenName":"Mateusz","familyName":"Kuniej","name":"Kuniej, Mateusz","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Katarzyna","familyName":"Roszak","name":"Roszak, Katarzyna","affiliation":[],"nameIdentifiers":[]}],"titles":[{"title":"Direct access to the initial polarization of ${}^{13}C$ nuclei by measuring coherence evolution of an nitrogen-vacancy center spin qubit"}],"publisher":"arXiv","container":{},"publicationYear":2026,"subjects":[{"subject":"Quantum Physics (quant-ph)","lang":"en","subjectScheme":"arXiv"},{"subject":"FOS: Physical sciences","subjectScheme":"Fields of Science and Technology (FOS)"},{"schemeUri":"http://www.oecd.org/science/inno/38235147.pdf","subject":"FOS: Physical sciences","subjectScheme":"Fields of Science and Technology (FOS)"}],"contributors":[],"dates":[{"date":"2026-02-23T10:48:06Z","dateType":"Submitted","dateInformation":"v1"},{"date":"2026-02-24T02:20:47Z","dateType":"Updated","dateInformation":"v1"},{"date":"2026-02","dateType":"Available","dateInformation":"v1"},{"date":"2026","dateType":"Issued"}],"language":null,"types":{"schemaOrg":"CreativeWork","resourceTypeGeneral":"Preprint","citeproc":"article","bibtex":"misc","ris":"GEN","resourceType":"Article"},"relatedIdentifiers":[],"relatedItems":[],"sizes":[],"formats":[],"version":"1","rightsList":[{"rightsIdentifierScheme":"SPDX","rightsUri":"https://creativecommons.org/licenses/by/4.0/legalcode","schemeUri":"https://spdx.org/licenses/","rights":"Creative Commons Attribution 4.0 International","rightsIdentifier":"cc-by-4.0"}],"descriptions":[{"descriptionType":"Abstract","description":"We introduce a method for the measurement of the lower bound on the initial polarization of spinful nuclei in a diamond by following the coherence evolution of an NV center spin qubit after a simple scheme is operated on the qubit to facilitate the transfer of information from the environment into the qubit state. Current polarization measurement techniques are challenging to implement due to the need for direct access to the environment. In our method, information is obtained by measuring the difference of the evolution of the qubit coherence resulting from preparation phase when the environment evolution is conditional on the qubit pointer state. We find that the method does not depend strongly on the applied magnetic field, but rather on the number of spinfull nuclei that lead to decoherence, and gives a reasonable estimate if the environment is polarized. The key advantage of this approach is its simplicity and minimal experimental requirements, allowing the inference of initial nuclear polarizations without direct access to the environment. We demonstrate the efficacy of this method using a simulated environment of up to fifteen randomly placed nuclear spins."},{"descriptionType":"Other","description":"9 pages, 6 figures"}],"geoLocations":[],"fundingReferences":[],"url":"https://arxiv.org/abs/2602.19701","contentUrl":null,"metadataVersion":0,"schemaVersion":"http://datacite.org/schema/kernel-4","source":"mds","isActive":true,"state":"findable","reason":null,"viewCount":0,"downloadCount":0,"referenceCount":0,"citationCount":0,"partCount":0,"partOfCount":0,"versionCount":0,"versionOfCount":0,"created":"2026-02-25T15:11:16Z","registered":"2026-02-25T15:11:17Z","published":null,"updated":"2026-02-25T15:11:17Z"},"relationships":{"client":{"data":{"id":"arxiv.content","type":"clients"}}}},{"id":"10.48550/arxiv.2602.19699","type":"dois","attributes":{"doi":"10.48550/arxiv.2602.19699","identifiers":[{"identifier":"2602.19699","identifierType":"arXiv"}],"creators":[{"nameType":"Personal","givenName":"Elisa","familyName":"Alboni","name":"Alboni, Elisa","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Pietro Noah","familyName":"Crestaz","name":"Crestaz, Pietro Noah","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Elias","familyName":"Fontanari","name":"Fontanari, Elias","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Andrea","familyName":"Del Prete","name":"Del Prete, Andrea","affiliation":[],"nameIdentifiers":[]}],"titles":[{"title":"CACTO-BIC: Scalable Actor-Critic Learning via Biased Sampling and GPU-Accelerated Trajectory Optimization"}],"publisher":"arXiv","container":{},"publicationYear":2026,"subjects":[{"subject":"Robotics (cs.RO)","lang":"en","subjectScheme":"arXiv"},{"subject":"Optimization and Control (math.OC)","lang":"en","subjectScheme":"arXiv"},{"subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"},{"schemeUri":"http://www.oecd.org/science/inno/38235147.pdf","subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"},{"subject":"FOS: Mathematics","subjectScheme":"Fields of Science and Technology (FOS)"},{"schemeUri":"http://www.oecd.org/science/inno/38235147.pdf","subject":"FOS: Mathematics","subjectScheme":"Fields of Science and Technology (FOS)"}],"contributors":[],"dates":[{"date":"2026-02-23T10:45:36Z","dateType":"Submitted","dateInformation":"v1"},{"date":"2026-02-24T02:20:34Z","dateType":"Updated","dateInformation":"v1"},{"date":"2026-02","dateType":"Available","dateInformation":"v1"},{"date":"2026","dateType":"Issued"}],"language":null,"types":{"schemaOrg":"CreativeWork","resourceTypeGeneral":"Preprint","citeproc":"article","bibtex":"misc","ris":"GEN","resourceType":"Article"},"relatedIdentifiers":[],"relatedItems":[],"sizes":[],"formats":[],"version":"1","rightsList":[{"rightsIdentifierScheme":"SPDX","rightsUri":"https://creativecommons.org/licenses/by-sa/4.0/legalcode","schemeUri":"https://spdx.org/licenses/","rights":"Creative Commons Attribution Share Alike 4.0 International","rightsIdentifier":"cc-by-sa-4.0"}],"descriptions":[{"descriptionType":"Abstract","description":"Trajectory Optimization (TO) and Reinforcement Learning (RL) offer complementary strengths for solving optimal control problems. TO efficiently computes locally optimal solutions but can struggle with non-convexity, while RL is more robust to non-convexity at the cost of significantly higher computational demands. CACTO (Continuous Actor-Critic with Trajectory Optimization) was introduced to combine these advantages by learning a warm-start policy that guides the TO solver towards low-cost trajectories. However, scalability remains a key limitation, as increasing system complexity significantly raises the computational cost of TO. This work introduces CACTO-BIC to address these challenges. CACTO-BIC improves data efficiency by biasing initial-state sampling leveraging a property of the value function associated with locally optimal policies; moreover, it reduces computation time by exploiting GPU acceleration. Empirical evaluations show improved sample efficiency and faster computation compared to CACTO. Comparisons with PPO demonstrate that our approach can achieve similar solutions in less time. Finally, experiments on the AlienGO quadruped robot demonstrate that CACTO-BIC can scale to high-dimensional systems and is suitable for real-time applications."}],"geoLocations":[],"fundingReferences":[],"url":"https://arxiv.org/abs/2602.19699","contentUrl":null,"metadataVersion":0,"schemaVersion":"http://datacite.org/schema/kernel-4","source":"mds","isActive":true,"state":"findable","reason":null,"viewCount":0,"downloadCount":0,"referenceCount":0,"citationCount":0,"partCount":0,"partOfCount":0,"versionCount":0,"versionOfCount":0,"created":"2026-02-25T15:11:11Z","registered":"2026-02-25T15:11:12Z","published":null,"updated":"2026-02-25T15:11:12Z"},"relationships":{"client":{"data":{"id":"arxiv.content","type":"clients"}}}},{"id":"10.48550/arxiv.2602.19698","type":"dois","attributes":{"doi":"10.48550/arxiv.2602.19698","identifiers":[{"identifier":"2602.19698","identifierType":"arXiv"}],"creators":[{"nameType":"Personal","givenName":"Krzysztof","familyName":"Kutt","name":"Kutt, Krzysztof","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Maciej","familyName":"Baczyński","name":"Baczyński, Maciej","affiliation":[],"nameIdentifiers":[]}],"titles":[{"title":"Iconographic Classification and Content-Based Recommendation for Digitized Artworks"}],"publisher":"arXiv","container":{},"publicationYear":2026,"subjects":[{"subject":"Digital Libraries (cs.DL)","lang":"en","subjectScheme":"arXiv"},{"subject":"Artificial Intelligence (cs.AI)","lang":"en","subjectScheme":"arXiv"},{"subject":"Computer Vision and Pattern Recognition (cs.CV)","lang":"en","subjectScheme":"arXiv"},{"subject":"Information Retrieval (cs.IR)","lang":"en","subjectScheme":"arXiv"},{"subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"},{"schemeUri":"http://www.oecd.org/science/inno/38235147.pdf","subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"}],"contributors":[],"dates":[{"date":"2026-02-23T10:44:27Z","dateType":"Submitted","dateInformation":"v1"},{"date":"2026-02-24T02:20:33Z","dateType":"Updated","dateInformation":"v1"},{"date":"2026-02","dateType":"Available","dateInformation":"v1"},{"date":"2026","dateType":"Issued"}],"language":null,"types":{"schemaOrg":"CreativeWork","resourceTypeGeneral":"Preprint","citeproc":"article","bibtex":"misc","ris":"GEN","resourceType":"Article"},"relatedIdentifiers":[],"relatedItems":[],"sizes":[],"formats":[],"version":"1","rightsList":[{"rightsUri":"http://arxiv.org/licenses/nonexclusive-distrib/1.0/","rights":"arXiv.org perpetual, non-exclusive license"}],"descriptions":[{"descriptionType":"Abstract","description":"We present a proof-of-concept system that automates iconographic classification and content-based recommendation of digitized artworks using the Iconclass vocabulary and selected artificial intelligence methods. The prototype implements a four-stage workflow for classification and recommendation, which integrates YOLOv8 object detection with algorithmic mappings to Iconclass codes, rule-based inference for abstract meanings, and three complementary recommenders (hierarchical proximity, IDF-weighted overlap, and Jaccard similarity). Although more engineering is still needed, the evaluation demonstrates the potential of this solution: Iconclass-aware computer vision and recommendation methods can accelerate cataloging and enhance navigation in large heritage repositories. The key insight is to let computer vision propose visible elements and to use symbolic structures (Iconclass hierarchy) to reach meaning."},{"descriptionType":"Other","description":"14 pages, 7 figures; submitted to ICCS 2026 conference"}],"geoLocations":[],"fundingReferences":[],"url":"https://arxiv.org/abs/2602.19698","contentUrl":null,"metadataVersion":0,"schemaVersion":"http://datacite.org/schema/kernel-4","source":"mds","isActive":true,"state":"findable","reason":null,"viewCount":0,"downloadCount":0,"referenceCount":0,"citationCount":0,"partCount":0,"partOfCount":0,"versionCount":0,"versionOfCount":0,"created":"2026-02-25T15:11:09Z","registered":"2026-02-25T15:11:10Z","published":null,"updated":"2026-02-25T15:11:10Z"},"relationships":{"client":{"data":{"id":"arxiv.content","type":"clients"}}}},{"id":"10.48550/arxiv.2602.19697","type":"dois","attributes":{"doi":"10.48550/arxiv.2602.19697","identifiers":[{"identifier":"2602.19697","identifierType":"arXiv"}],"creators":[{"nameType":"Personal","givenName":"Soumya","familyName":"Mazumdar","name":"Mazumdar, Soumya","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Vineet Kumar","familyName":"Rakesh","name":"Rakesh, Vineet Kumar","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Tapas","familyName":"Samanta","name":"Samanta, Tapas","affiliation":[],"nameIdentifiers":[]}],"titles":[{"title":"BayesFusion-SDF: Probabilistic Signed Distance Fusion with View Planning on CPU"}],"publisher":"arXiv","container":{},"publicationYear":2026,"subjects":[{"subject":"Computer Vision and Pattern Recognition (cs.CV)","lang":"en","subjectScheme":"arXiv"},{"subject":"Graphics (cs.GR)","lang":"en","subjectScheme":"arXiv"},{"subject":"Robotics (cs.RO)","lang":"en","subjectScheme":"arXiv"},{"subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"},{"schemeUri":"http://www.oecd.org/science/inno/38235147.pdf","subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"}],"contributors":[],"dates":[{"date":"2026-02-23T10:44:15Z","dateType":"Submitted","dateInformation":"v1"},{"date":"2026-02-24T02:20:32Z","dateType":"Updated","dateInformation":"v1"},{"date":"2026-02","dateType":"Available","dateInformation":"v1"},{"date":"2026","dateType":"Issued"}],"language":null,"types":{"schemaOrg":"CreativeWork","resourceTypeGeneral":"Preprint","citeproc":"article","bibtex":"misc","ris":"GEN","resourceType":"Article"},"relatedIdentifiers":[],"relatedItems":[],"sizes":[],"formats":[],"version":"1","rightsList":[{"rightsIdentifierScheme":"SPDX","rightsUri":"https://creativecommons.org/licenses/by-nc-nd/4.0/legalcode","schemeUri":"https://spdx.org/licenses/","rights":"Creative Commons Attribution Non Commercial No Derivatives 4.0 International","rightsIdentifier":"cc-by-nc-nd-4.0"}],"descriptions":[{"descriptionType":"Abstract","description":"Key part of robotics, augmented reality, and digital inspection is dense 3D reconstruction from depth observations. Traditional volumetric fusion techniques, including truncated signed distance functions (TSDF), enable efficient and deterministic geometry reconstruction; however, they depend on heuristic weighting and fail to transparently convey uncertainty in a systematic way. Recent neural implicit methods, on the other hand, get very high fidelity but usually need a lot of GPU power for optimization and aren't very easy to understand for making decisions later on. This work presents BayesFusion-SDF, a CPU-centric probabilistic signed distance fusion framework that conceptualizes geometry as a sparse Gaussian random field with a defined posterior distribution over voxel distances. First, a rough TSDF reconstruction is used to create an adaptive narrow-band domain. Then, depth observations are combined using a heteroscedastic Bayesian formulation that is solved using sparse linear algebra and preconditioned conjugate gradients. Randomized diagonal estimators are a quick way to get an idea of posterior uncertainty. This makes it possible to extract surfaces and plan the next best view while taking into account uncertainty. Tests on a controlled ablation scene and a CO3D object sequence show that the new method is more accurate geometrically than TSDF baselines and gives useful estimates of uncertainty for active sensing. The proposed formulation provides a clear and easy-to-use alternative to GPU-heavy neural reconstruction methods while still being able to be understood in a probabilistic way and acting in a predictable way. GitHub: https://mazumdarsoumya.github.io/BayesFusionSDF"}],"geoLocations":[],"fundingReferences":[],"url":"https://arxiv.org/abs/2602.19697","contentUrl":null,"metadataVersion":0,"schemaVersion":"http://datacite.org/schema/kernel-4","source":"mds","isActive":true,"state":"findable","reason":null,"viewCount":0,"downloadCount":0,"referenceCount":0,"citationCount":0,"partCount":0,"partOfCount":0,"versionCount":0,"versionOfCount":0,"created":"2026-02-25T15:11:06Z","registered":"2026-02-25T15:11:07Z","published":null,"updated":"2026-02-25T15:11:07Z"},"relationships":{"client":{"data":{"id":"arxiv.content","type":"clients"}}}},{"id":"10.48550/arxiv.2602.19695","type":"dois","attributes":{"doi":"10.48550/arxiv.2602.19695","identifiers":[{"identifier":"2602.19695","identifierType":"arXiv"}],"creators":[{"nameType":"Personal","givenName":"William","familyName":"Seymour","name":"Seymour, William","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Martin J.","familyName":"Kraemer","name":"Kraemer, Martin J.","affiliation":[],"nameIdentifiers":[]}],"titles":[{"title":"Shifting Engagement With Cybersecurity: How People Discover and Share Cybersecurity Content at Work and at Home"}],"publisher":"arXiv","container":{},"publicationYear":2026,"subjects":[{"subject":"Human-Computer Interaction (cs.HC)","lang":"en","subjectScheme":"arXiv"},{"subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"},{"schemeUri":"http://www.oecd.org/science/inno/38235147.pdf","subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"}],"contributors":[],"dates":[{"date":"2026-02-23T10:43:06Z","dateType":"Submitted","dateInformation":"v1"},{"date":"2026-02-24T02:20:30Z","dateType":"Updated","dateInformation":"v1"},{"date":"2026-02","dateType":"Available","dateInformation":"v1"},{"date":"2026","dateType":"Issued"}],"language":null,"types":{"schemaOrg":"CreativeWork","resourceTypeGeneral":"Preprint","citeproc":"article","bibtex":"misc","ris":"GEN","resourceType":"Article"},"relatedIdentifiers":[{"relationType":"IsVersionOf","relatedIdentifier":"10.1145/3772363.3798719","relatedIdentifierType":"DOI"}],"relatedItems":[],"sizes":[],"formats":[],"version":"1","rightsList":[{"rightsIdentifierScheme":"SPDX","rightsUri":"https://creativecommons.org/licenses/by/4.0/legalcode","schemeUri":"https://spdx.org/licenses/","rights":"Creative Commons Attribution 4.0 International","rightsIdentifier":"cc-by-4.0"}],"descriptions":[{"descriptionType":"Abstract","description":"Cybersecurity awareness is shaped by a wide range of professional and personal experiences, including information and training at work and the sharing of news and other content at home. In order to explore how people discover cybersecurity content and the effect that participation in workplace training may have on this we present an online study of 1200 participants from the UK, US, France, and Germany. Those undertaking cybersecurity training at work showed reduced intention to share information at home, shifting the focus towards the workplace. They were also more likely to recall cybersecurity information shared by their employer than from any other source, which in turn correlated with content type and distribution channel. We critically reflect on this shift, highlighting opportunities to improve cybersecurity information sharing at work and at home."},{"descriptionType":"Other","description":"To appear in the extended abstracts of the 2026 ACM CHI Conference on Human Factors in Computing Systems"}],"geoLocations":[],"fundingReferences":[],"url":"https://arxiv.org/abs/2602.19695","contentUrl":null,"metadataVersion":0,"schemaVersion":"http://datacite.org/schema/kernel-4","source":"mds","isActive":true,"state":"findable","reason":null,"viewCount":0,"downloadCount":0,"referenceCount":0,"citationCount":0,"partCount":0,"partOfCount":0,"versionCount":0,"versionOfCount":1,"created":"2026-02-25T15:11:02Z","registered":"2026-02-25T15:11:02Z","published":null,"updated":"2026-02-25T15:11:02Z"},"relationships":{"client":{"data":{"id":"arxiv.content","type":"clients"}}}},{"id":"10.48550/arxiv.2602.19694","type":"dois","attributes":{"doi":"10.48550/arxiv.2602.19694","identifiers":[{"identifier":"2602.19694","identifierType":"arXiv"}],"creators":[{"nameType":"Personal","givenName":"Bo","familyName":"Liu","name":"Liu, Bo","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Tong","familyName":"Li","name":"Li, Tong","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Zhu","familyName":"Xiao","name":"Xiao, Zhu","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Ruihui","familyName":"Li","name":"Li, Ruihui","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Geyong","familyName":"Min","name":"Min, Geyong","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Zhuo","familyName":"Tang","name":"Tang, Zhuo","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Kenli","familyName":"Li","name":"Li, Kenli","affiliation":[],"nameIdentifiers":[]}],"titles":[{"title":"All Cities are Equal: A Unified Human Mobility Generation Model Enabled by LLMs"}],"publisher":"arXiv","container":{},"publicationYear":2026,"subjects":[{"subject":"Emerging Technologies (cs.ET)","lang":"en","subjectScheme":"arXiv"},{"subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"},{"schemeUri":"http://www.oecd.org/science/inno/38235147.pdf","subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"}],"contributors":[],"dates":[{"date":"2026-02-23T10:42:25Z","dateType":"Submitted","dateInformation":"v1"},{"date":"2026-02-24T02:20:29Z","dateType":"Updated","dateInformation":"v1"},{"date":"2026-02","dateType":"Available","dateInformation":"v1"},{"date":"2026","dateType":"Issued"}],"language":null,"types":{"schemaOrg":"CreativeWork","resourceTypeGeneral":"Preprint","citeproc":"article","bibtex":"misc","ris":"GEN","resourceType":"Article"},"relatedIdentifiers":[],"relatedItems":[],"sizes":[],"formats":[],"version":"1","rightsList":[{"rightsUri":"http://arxiv.org/licenses/nonexclusive-distrib/1.0/","rights":"arXiv.org perpetual, non-exclusive license"}],"descriptions":[{"descriptionType":"Abstract","description":"Synthetic human mobility generation is gaining traction as an ethical and practical approach to supporting the data needs of intelligent urban systems. Existing methods perform well primarily in data-rich cities, while their effectiveness declines significantly in cities with limited data resources. However, the ability to generate reliable human mobility data should not depend on a city's size or available resources, all cities deserve equal consideration. To address this open issue, we propose UniMob, a unified human mobility generation model across cities. UniMob is composed of three main components: an LLM-powered travel planner that derives high-level, temporally-aware, and semantically meaningful travel plans; a unified spatial embedding module that projects the spatial regions of various cities into a shared representation space; and a diffusion-based mobility generator that captures the joint spatiotemporal characteristics of human movement, guided by the derived travel plans. We evaluate UniMob extensively using two real-world datasets covering five cities. Comprehensive experiments show that UniMob significantly outperforms state-of-the-art baselines, achieving improvements of over 30\\% across multiple evaluation metrics. Further analysis demonstrates UniMob's robustness in both zero- and few-shot scenarios, underlines the importance of LLM guidance, verifies its privacy-preserving nature, and showcases its applicability for downstream tasks."},{"descriptionType":"Other","description":"under review"}],"geoLocations":[],"fundingReferences":[],"url":"https://arxiv.org/abs/2602.19694","contentUrl":null,"metadataVersion":0,"schemaVersion":"http://datacite.org/schema/kernel-4","source":"mds","isActive":true,"state":"findable","reason":null,"viewCount":0,"downloadCount":0,"referenceCount":0,"citationCount":0,"partCount":0,"partOfCount":0,"versionCount":0,"versionOfCount":0,"created":"2026-02-25T15:10:59Z","registered":"2026-02-25T15:11:00Z","published":null,"updated":"2026-02-25T15:11:00Z"},"relationships":{"client":{"data":{"id":"arxiv.content","type":"clients"}}}},{"id":"10.48550/arxiv.2602.19692","type":"dois","attributes":{"doi":"10.48550/arxiv.2602.19692","identifiers":[{"identifier":"2602.19692","identifierType":"arXiv"}],"creators":[{"nameType":"Personal","givenName":"Seung-Yeal","familyName":"Ha","name":"Ha, Seung-Yeal","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Gyuyoung","familyName":"Hwang","name":"Hwang, Gyuyoung","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Philippe","familyName":"Thieullen","name":"Thieullen, Philippe","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Jaeyoung","familyName":"Yoon","name":"Yoon, Jaeyoung","affiliation":[],"nameIdentifiers":[]}],"titles":[{"title":"Existence of periodic measure-valued solutions to the nonlocal continuity equation via optimal transport"}],"publisher":"arXiv","container":{},"publicationYear":2026,"subjects":[{"subject":"Dynamical Systems (math.DS)","lang":"en","subjectScheme":"arXiv"},{"subject":"FOS: Mathematics","subjectScheme":"Fields of Science and Technology (FOS)"},{"schemeUri":"http://www.oecd.org/science/inno/38235147.pdf","subject":"FOS: Mathematics","subjectScheme":"Fields of Science and Technology (FOS)"}],"contributors":[],"dates":[{"date":"2026-02-23T10:39:22Z","dateType":"Submitted","dateInformation":"v1"},{"date":"2026-02-24T02:20:27Z","dateType":"Updated","dateInformation":"v1"},{"date":"2026-02","dateType":"Available","dateInformation":"v1"},{"date":"2026","dateType":"Issued"}],"language":null,"types":{"schemaOrg":"CreativeWork","resourceTypeGeneral":"Preprint","citeproc":"article","bibtex":"misc","ris":"GEN","resourceType":"Article"},"relatedIdentifiers":[],"relatedItems":[],"sizes":[],"formats":[],"version":"1","rightsList":[{"rightsUri":"http://arxiv.org/licenses/nonexclusive-distrib/1.0/","rights":"arXiv.org perpetual, non-exclusive license"}],"descriptions":[{"descriptionType":"Abstract","description":"We investigate the existence of periodic solutions for a class of nonlocal continuity equations, which include mean-field equations derived from systems of coupled oscillators. While periodic solutions at the particle level have been studied through the construction of a Poincaré map on a section of an invariant set, extending this analysis to the level of continuity equations presents nontrivial challenges. In particular, setting an appropriate topology for the infinite-dimensional space to show invariance and apply the fixed point argument is not easy. To overcome this difficulty, we use fixed point theorem for geodesically convex spaces constructed by optimal transportation. Specifically, from the disintegration with respect to stationary variable, we define a metric using the Wasserstein-$2$ distance over one-dimensional space, which yields a $CAT(0)$ space. In this topology, we construct an invariance set of probability measures and prove the existence of the periodic measure-valued solution from Schauder's fixed point theorem on geodesically convex spaces. As a corollary, our method directly gives an existence of periodic graph measure solution."}],"geoLocations":[],"fundingReferences":[],"url":"https://arxiv.org/abs/2602.19692","contentUrl":null,"metadataVersion":0,"schemaVersion":"http://datacite.org/schema/kernel-4","source":"mds","isActive":true,"state":"findable","reason":null,"viewCount":0,"downloadCount":0,"referenceCount":0,"citationCount":0,"partCount":0,"partOfCount":0,"versionCount":0,"versionOfCount":0,"created":"2026-02-25T15:10:54Z","registered":"2026-02-25T15:10:55Z","published":null,"updated":"2026-02-25T15:10:55Z"},"relationships":{"client":{"data":{"id":"arxiv.content","type":"clients"}}}},{"id":"10.48550/arxiv.2602.19690","type":"dois","attributes":{"doi":"10.48550/arxiv.2602.19690","identifiers":[{"identifier":"2602.19690","identifierType":"arXiv"}],"creators":[{"nameType":"Personal","givenName":"Qile","familyName":"Wang","name":"Wang, Qile","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Prerana","familyName":"Khatiwada","name":"Khatiwada, Prerana","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Avinash","familyName":"Chouhan","name":"Chouhan, Avinash","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Ashrey","familyName":"Mahesh","name":"Mahesh, Ashrey","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Joy","familyName":"Mwaria","name":"Mwaria, Joy","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Duy Duc","familyName":"Tran","name":"Tran, Duy Duc","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Kenneth E.","familyName":"Barner","name":"Barner, Kenneth E.","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Matthew Louis","familyName":"Mauriello","name":"Mauriello, Matthew Louis","affiliation":[],"nameIdentifiers":[]}],"titles":[{"title":"\"The explanation makes sense\": An Empirical Study on LLM Performance in News Classification and its Influence on Judgment in Human-AI Collaborative Annotation"}],"publisher":"arXiv","container":{},"publicationYear":2026,"subjects":[{"subject":"Human-Computer Interaction (cs.HC)","lang":"en","subjectScheme":"arXiv"},{"subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"},{"schemeUri":"http://www.oecd.org/science/inno/38235147.pdf","subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"}],"contributors":[],"dates":[{"date":"2026-02-23T10:37:55Z","dateType":"Submitted","dateInformation":"v1"},{"date":"2026-02-24T02:20:25Z","dateType":"Updated","dateInformation":"v1"},{"date":"2026-02","dateType":"Available","dateInformation":"v1"},{"date":"2026","dateType":"Issued"}],"language":null,"types":{"schemaOrg":"CreativeWork","resourceTypeGeneral":"Preprint","citeproc":"article","bibtex":"misc","ris":"GEN","resourceType":"Article"},"relatedIdentifiers":[],"relatedItems":[],"sizes":[],"formats":[],"version":"1","rightsList":[{"rightsIdentifierScheme":"SPDX","rightsUri":"https://creativecommons.org/licenses/by/4.0/legalcode","schemeUri":"https://spdx.org/licenses/","rights":"Creative Commons Attribution 4.0 International","rightsIdentifier":"cc-by-4.0"}],"descriptions":[{"descriptionType":"Abstract","description":"The spread of media bias is a significant concern as political discourse shapes beliefs and opinions. Addressing this challenge computationally requires improved methods for interpreting news. While large language models (LLMs) can scale classification tasks, concerns remain about their trustworthiness. To advance human-AI collaboration, we investigate the feasibility of using LLMs to classify U.S. news by political ideology and examine their effect on user decision-making. We first compared GPT models with prompt engineering to state-of-the-art supervised machine learning on a 34k public dataset. We then collected 17k news articles and tested GPT-4 predictions with brief and detailed explanations. In a between-subjects study (N=124), we evaluated how LLM-generated explanations influence human annotation, judgment, and confidence. Results show that AI assistance significantly increases confidence ($p\u0026lt;.001$), with detailed explanations more persuasive and more likely to alter decisions. We highlight recommendations for AI explanations through thematic analysis and provide our dataset for further research."}],"geoLocations":[],"fundingReferences":[],"url":"https://arxiv.org/abs/2602.19690","contentUrl":null,"metadataVersion":0,"schemaVersion":"http://datacite.org/schema/kernel-4","source":"mds","isActive":true,"state":"findable","reason":null,"viewCount":0,"downloadCount":0,"referenceCount":0,"citationCount":0,"partCount":0,"partOfCount":0,"versionCount":0,"versionOfCount":0,"created":"2026-02-25T15:10:49Z","registered":"2026-02-25T15:10:50Z","published":null,"updated":"2026-02-25T15:10:50Z"},"relationships":{"client":{"data":{"id":"arxiv.content","type":"clients"}}}},{"id":"10.48550/arxiv.2602.19689","type":"dois","attributes":{"doi":"10.48550/arxiv.2602.19689","identifiers":[{"identifier":"2602.19689","identifierType":"arXiv"}],"creators":[{"nameType":"Personal","givenName":"Kazuki","familyName":"Sekiya","name":"Sekiya, Kazuki","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Suguru","familyName":"Otani","name":"Otani, Suguru","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Yuki","familyName":"Komatsu","name":"Komatsu, Yuki","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Sachio","familyName":"Ohkawa","name":"Ohkawa, Sachio","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Shunya","familyName":"Noda","name":"Noda, Shunya","affiliation":[],"nameIdentifiers":[]}],"titles":[{"title":"Integrating Predictive Models into Two-Sided Recommendations: A Matching-Theoretic Approach"}],"publisher":"arXiv","container":{},"publicationYear":2026,"subjects":[{"subject":"General Economics (econ.GN)","lang":"en","subjectScheme":"arXiv"},{"subject":"FOS: Economics and business","subjectScheme":"Fields of Science and Technology (FOS)"},{"schemeUri":"http://www.oecd.org/science/inno/38235147.pdf","subject":"FOS: Economics and business","subjectScheme":"Fields of Science and Technology (FOS)"}],"contributors":[],"dates":[{"date":"2026-02-23T10:35:29Z","dateType":"Submitted","dateInformation":"v1"},{"date":"2026-02-24T02:20:18Z","dateType":"Updated","dateInformation":"v1"},{"date":"2026-02","dateType":"Available","dateInformation":"v1"},{"date":"2026","dateType":"Issued"}],"language":null,"types":{"schemaOrg":"CreativeWork","resourceTypeGeneral":"Preprint","citeproc":"article","bibtex":"misc","ris":"GEN","resourceType":"Article"},"relatedIdentifiers":[],"relatedItems":[],"sizes":[],"formats":[],"version":"1","rightsList":[{"rightsIdentifierScheme":"SPDX","rightsUri":"https://creativecommons.org/licenses/by/4.0/legalcode","schemeUri":"https://spdx.org/licenses/","rights":"Creative Commons Attribution 4.0 International","rightsIdentifier":"cc-by-4.0"}],"descriptions":[{"descriptionType":"Abstract","description":"Two-sided platforms must recommend users to users, where matches (termed \\emph{dates} in this paper) require mutual interest and activity on both sides. Naive ranking by predicted dating probabilities concentrates exposure on a small subset of highly responsive users, generating congestion and overstating efficiency. We model recommendation as a many-to-many matching problem and design integrators that map predicted login, like, and reciprocation probabilities into recommendations under attention constraints. We introduce \\emph{effective dates}, a congestion-adjusted metric that discounts matches involving overloaded receivers. We then propose \\emph{exposure-constrained deferred acceptance} (ECDA), which limits receiver exposure in terms of expected likes or dates rather than headcount. Using production-grade predictions from a large Japanese dating platform, we show in calibrated simulations that ECDA increases effective dates and receiver-side dating probability despite reducing total dates. A large-scale regional field experiment confirms these effects in practice, indicating that exposure control improves equity and early-stage matching efficiency without harming downstream engagement."},{"descriptionType":"Other","description":"33 pages and 4 pages appendix"}],"geoLocations":[],"fundingReferences":[],"url":"https://arxiv.org/abs/2602.19689","contentUrl":null,"metadataVersion":0,"schemaVersion":"http://datacite.org/schema/kernel-4","source":"mds","isActive":true,"state":"findable","reason":null,"viewCount":0,"downloadCount":0,"referenceCount":0,"citationCount":0,"partCount":0,"partOfCount":0,"versionCount":0,"versionOfCount":0,"created":"2026-02-25T15:10:47Z","registered":"2026-02-25T15:10:48Z","published":null,"updated":"2026-02-25T15:10:48Z"},"relationships":{"client":{"data":{"id":"arxiv.content","type":"clients"}}}},{"id":"10.48550/arxiv.2602.19688","type":"dois","attributes":{"doi":"10.48550/arxiv.2602.19688","identifiers":[{"identifier":"2602.19688","identifierType":"arXiv"}],"creators":[{"nameType":"Personal","givenName":"Yu","familyName":"Dai","name":"Dai, Yu","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Shihan","familyName":"Li","name":"Li, Shihan","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Wenlong","familyName":"Tang","name":"Tang, Wenlong","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Zhen","familyName":"Li","name":"Li, Zhen","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Mingde","familyName":"Ding","name":"Ding, Mingde","affiliation":[],"nameIdentifiers":[]}],"titles":[{"title":"Influence of Cross-sectional Expansion on Coronal Emissions from a Radiatively Cooling Solar Flare Loop"}],"publisher":"arXiv","container":{},"publicationYear":2026,"subjects":[{"subject":"Solar and Stellar Astrophysics (astro-ph.SR)","lang":"en","subjectScheme":"arXiv"},{"subject":"FOS: Physical sciences","subjectScheme":"Fields of Science and Technology (FOS)"},{"schemeUri":"http://www.oecd.org/science/inno/38235147.pdf","subject":"FOS: Physical sciences","subjectScheme":"Fields of Science and Technology (FOS)"}],"contributors":[],"dates":[{"date":"2026-02-23T10:34:49Z","dateType":"Submitted","dateInformation":"v1"},{"date":"2026-02-24T02:20:09Z","dateType":"Updated","dateInformation":"v1"},{"date":"2026-02","dateType":"Available","dateInformation":"v1"},{"date":"2026","dateType":"Issued"}],"language":null,"types":{"schemaOrg":"CreativeWork","resourceTypeGeneral":"Preprint","citeproc":"article","bibtex":"misc","ris":"GEN","resourceType":"Article"},"relatedIdentifiers":[],"relatedItems":[],"sizes":[],"formats":[],"version":"1","rightsList":[{"rightsUri":"http://arxiv.org/licenses/nonexclusive-distrib/1.0/","rights":"arXiv.org perpetual, non-exclusive license"}],"descriptions":[{"descriptionType":"Abstract","description":"Loop-aligned hydrodynamic modelings help better understand the thermodynamic evolution of flaring plasma confined in solar flare loops. Conventional loop modelings typically assume a uniform loop cross section. With a variation of the cross section taken into account, in this work we carry out both analytical and numerical modelings of the radiative cooling in a solar flare loop. It is found that a cross-sectional expansion with height can efficiently suppress the draining of loop material from the corona while not significantly affecting the decrease of loop temperature. Reflected to the loop energetics, the coronal part of the loop cools more dominantly by radiation, and more importantly, the loop radiative outputs are shifted toward lower temperatures. These findings pose important physical implications for extreme-ultraviolet (EUV) late-phase emissions discovered in some solar flares. The late-phase loops in these flares are believed to bear a more notable cross-sectional expansion owing to their longer lengths. Compared with the main-phase loops, the late-phase loops would emit more effectively at middle temperatures, which could, to a certain degree, mitigate the severe heating requirement for the production of a prominent warm coronal late-phase peak. In addition, the cross-sectional expansion also affects the shape of the emission lights curves, causing a sharper decay after the emission peak. Such an emission pattern has been validated with the observations of an EUV late-phase flare, and could serve as a potential diagnostic tool to judge the degree of loop cross-sectional expansion in an extended flare dataset."},{"descriptionType":"Other","description":"18 pages, 10 figures plus 3 tables, accepted for publication in ApJ"}],"geoLocations":[],"fundingReferences":[],"url":"https://arxiv.org/abs/2602.19688","contentUrl":null,"metadataVersion":0,"schemaVersion":"http://datacite.org/schema/kernel-4","source":"mds","isActive":true,"state":"findable","reason":null,"viewCount":0,"downloadCount":0,"referenceCount":0,"citationCount":0,"partCount":0,"partOfCount":0,"versionCount":0,"versionOfCount":0,"created":"2026-02-25T15:10:45Z","registered":"2026-02-25T15:10:45Z","published":null,"updated":"2026-02-25T15:10:45Z"},"relationships":{"client":{"data":{"id":"arxiv.content","type":"clients"}}}},{"id":"10.48550/arxiv.2602.19686","type":"dois","attributes":{"doi":"10.48550/arxiv.2602.19686","identifiers":[{"identifier":"2602.19686","identifierType":"arXiv"}],"creators":[{"nameType":"Personal","givenName":"Qiqi Jason","familyName":"Gu","name":"Gu, Qiqi Jason","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Lixue","familyName":"Liu","name":"Liu, Lixue","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Wei","familyName":"Ke","name":"Ke, Wei","affiliation":[],"nameIdentifiers":[]}],"titles":[{"title":"A Flow Extension to Coroutine Types for Deadlock Detection in Go"}],"publisher":"arXiv","container":{},"publicationYear":2026,"subjects":[{"subject":"Programming Languages (cs.PL)","lang":"en","subjectScheme":"arXiv"},{"subject":"Symbolic Computation (cs.SC)","lang":"en","subjectScheme":"arXiv"},{"subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"},{"schemeUri":"http://www.oecd.org/science/inno/38235147.pdf","subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"}],"contributors":[],"dates":[{"date":"2026-02-23T10:31:22Z","dateType":"Submitted","dateInformation":"v1"},{"date":"2026-02-24T02:20:05Z","dateType":"Updated","dateInformation":"v1"},{"date":"2026-02","dateType":"Available","dateInformation":"v1"},{"date":"2026","dateType":"Issued"}],"language":null,"types":{"schemaOrg":"CreativeWork","resourceTypeGeneral":"Preprint","citeproc":"article","bibtex":"misc","ris":"GEN","resourceType":"Article"},"relatedIdentifiers":[],"relatedItems":[],"sizes":[],"formats":[],"version":"1","rightsList":[{"rightsIdentifierScheme":"SPDX","rightsUri":"https://creativecommons.org/licenses/by-sa/4.0/legalcode","schemeUri":"https://spdx.org/licenses/","rights":"Creative Commons Attribution Share Alike 4.0 International","rightsIdentifier":"cc-by-sa-4.0"}],"descriptions":[{"descriptionType":"Abstract","description":"Coroutines, as an abstract programming construct, are a generalization of functions that can suspend execution part- way for later resumption. Coroutine Types are behavioral types to model interactions of coroutines with a single receiving operation followed by a single yielding operation. Coroutine Types have been applied to model-driven engineering, smart contracts, and test case generation. We contribute a Flow extension to Coroutine Types, so that coroutines with more than one receiving and yielding operation can be modeled. We accordingly revise the reduction rules of Coroutine Types. To show the usefulness of the Flow extension, we contribute a type system that maps expressions of the Go programming language to Coroutine Types. If the reduction result is 0, the two channel operations are paired properly and the program has no deadlocks. We choose Go because it is a popular programming language for distributed systems, but a frequent kind of bugs in Go is deadlocks due to the wrong use of concurrency features. We concentrate on the most commonly used semantics in Go: unbuffered channels with the keywords go and defer. Our Flow extension and the type system recognize 17 patterns of channels and goroutine interactions, including mismatched receivers and senders, nested goroutines, etc. We also integrate the Z3 SMT solver to take account of conditional execution and type inheritance. Other static or dynamic deadlock detectors crashed or gave wrong predictions in some patterns. Therefore, our type-based deadlock analyzer not only fills the gap in the landscape of value-based detection, but also complements existing detectors."},{"descriptionType":"Other","description":"Accepted in ICSESS 2025, Macao"}],"geoLocations":[],"fundingReferences":[],"url":"https://arxiv.org/abs/2602.19686","contentUrl":null,"metadataVersion":0,"schemaVersion":"http://datacite.org/schema/kernel-4","source":"mds","isActive":true,"state":"findable","reason":null,"viewCount":0,"downloadCount":0,"referenceCount":0,"citationCount":0,"partCount":0,"partOfCount":0,"versionCount":0,"versionOfCount":0,"created":"2026-02-25T15:10:40Z","registered":"2026-02-25T15:10:41Z","published":null,"updated":"2026-02-25T15:10:41Z"},"relationships":{"client":{"data":{"id":"arxiv.content","type":"clients"}}}},{"id":"10.48550/arxiv.2602.19685","type":"dois","attributes":{"doi":"10.48550/arxiv.2602.19685","identifiers":[{"identifier":"2602.19685","identifierType":"arXiv"}],"creators":[{"nameType":"Personal","givenName":"Xinyu","familyName":"Yuan","name":"Yuan, Xinyu","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Xixian","familyName":"Liu","name":"Liu, Xixian","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Ya Shi","familyName":"Zhang","name":"Zhang, Ya Shi","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Zuobai","familyName":"Zhang","name":"Zhang, Zuobai","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Hongyu","familyName":"Guo","name":"Guo, Hongyu","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Jian","familyName":"Tang","name":"Tang, Jian","affiliation":[],"nameIdentifiers":[]}],"titles":[{"title":"PerturbDiff: Functional Diffusion for Single-Cell Perturbation Modeling"}],"publisher":"arXiv","container":{},"publicationYear":2026,"subjects":[{"subject":"Machine Learning (cs.LG)","lang":"en","subjectScheme":"arXiv"},{"subject":"Artificial Intelligence (cs.AI)","lang":"en","subjectScheme":"arXiv"},{"subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"},{"schemeUri":"http://www.oecd.org/science/inno/38235147.pdf","subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"}],"contributors":[],"dates":[{"date":"2026-02-23T10:28:56Z","dateType":"Submitted","dateInformation":"v1"},{"date":"2026-02-24T02:19:54Z","dateType":"Updated","dateInformation":"v1"},{"date":"2026-02","dateType":"Available","dateInformation":"v1"},{"date":"2026","dateType":"Issued"}],"language":null,"types":{"schemaOrg":"CreativeWork","resourceTypeGeneral":"Preprint","citeproc":"article","bibtex":"misc","ris":"GEN","resourceType":"Article"},"relatedIdentifiers":[],"relatedItems":[],"sizes":[],"formats":[],"version":"1","rightsList":[{"rightsIdentifierScheme":"SPDX","rightsUri":"https://creativecommons.org/licenses/by/4.0/legalcode","schemeUri":"https://spdx.org/licenses/","rights":"Creative Commons Attribution 4.0 International","rightsIdentifier":"cc-by-4.0"}],"descriptions":[{"descriptionType":"Abstract","description":"Building Virtual Cells that can accurately simulate cellular responses to perturbations is a long-standing goal in systems biology. A fundamental challenge is that high-throughput single-cell sequencing is destructive: the same cell cannot be observed both before and after a perturbation. Thus, perturbation prediction requires mapping unpaired control and perturbed populations. Existing models address this by learning maps between distributions, but typically assume a single fixed response distribution when conditioned on observed cellular context (e.g., cell type) and the perturbation type. In reality, responses vary systematically due to unobservable latent factors such as microenvironmental fluctuations and complex batch effects, forming a manifold of possible distributions for the same observed conditions. To account for this variability, we introduce PerturbDiff, which shifts modeling from individual cells to entire distributions. By embedding distributions as points in a Hilbert space, we define a diffusion-based generative process operating directly over probability distributions. This allows PerturbDiff to capture population-level response shifts across hidden factors. Benchmarks on established datasets show that PerturbDiff achieves state-of-the-art performance in single-cell response prediction and generalizes substantially better to unseen perturbations. See our project page (https://katarinayuan.github.io/PerturbDiff-ProjectPage/), where code and data will be made publicly available (https://github.com/DeepGraphLearning/PerturbDiff)."}],"geoLocations":[],"fundingReferences":[],"url":"https://arxiv.org/abs/2602.19685","contentUrl":null,"metadataVersion":0,"schemaVersion":"http://datacite.org/schema/kernel-4","source":"mds","isActive":true,"state":"findable","reason":null,"viewCount":0,"downloadCount":0,"referenceCount":0,"citationCount":0,"partCount":0,"partOfCount":0,"versionCount":0,"versionOfCount":0,"created":"2026-02-25T15:10:37Z","registered":"2026-02-25T15:10:38Z","published":null,"updated":"2026-02-25T15:10:38Z"},"relationships":{"client":{"data":{"id":"arxiv.content","type":"clients"}}}},{"id":"10.48550/arxiv.2602.19683","type":"dois","attributes":{"doi":"10.48550/arxiv.2602.19683","identifiers":[{"identifier":"2602.19683","identifierType":"arXiv"}],"creators":[{"nameType":"Personal","givenName":"Henrik","familyName":"Möllmann","name":"Möllmann, Henrik","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Dirk","familyName":"Pflüger","name":"Pflüger, Dirk","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Alexander","familyName":"Strack","name":"Strack, Alexander","affiliation":[],"nameIdentifiers":[]}],"titles":[{"title":"GPU-Resident Gaussian Process Regression Leveraging Asynchronous Tasks with HPX"}],"publisher":"arXiv","container":{},"publicationYear":2026,"subjects":[{"subject":"Distributed, Parallel, and Cluster Computing (cs.DC)","lang":"en","subjectScheme":"arXiv"},{"subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"},{"schemeUri":"http://www.oecd.org/science/inno/38235147.pdf","subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"}],"contributors":[],"dates":[{"date":"2026-02-23T10:27:18Z","dateType":"Submitted","dateInformation":"v1"},{"date":"2026-02-24T02:19:47Z","dateType":"Updated","dateInformation":"v1"},{"date":"2026-02","dateType":"Available","dateInformation":"v1"},{"date":"2026","dateType":"Issued"}],"language":null,"types":{"schemaOrg":"CreativeWork","resourceTypeGeneral":"Preprint","citeproc":"article","bibtex":"misc","ris":"GEN","resourceType":"Article"},"relatedIdentifiers":[],"relatedItems":[],"sizes":[],"formats":[],"version":"1","rightsList":[{"rightsUri":"http://arxiv.org/licenses/nonexclusive-distrib/1.0/","rights":"arXiv.org perpetual, non-exclusive license"}],"descriptions":[{"descriptionType":"Abstract","description":"Gaussian processes (GPs) are a widely used regression tool, but the cubic complexity of exact solvers limits their scalability. To address this challenge, we extend the GPRat library by incorporating a fully GPU-resident GP prediction pipeline. GPRat is an HPX-based library that combines task-based parallelism with an intuitive Python API.\n We implement tiled algorithms for the GP prediction using optimized CUDA libraries, thereby exploiting massive parallelism for linear algebra operations. We evaluate the optimal number of CUDA streams and compare the performance of our GPU implementation to the existing CPU-based implementation. Our results show the GPU implementation provides speedups for datasets larger than 128 training samples. We observe speedups of up to 4.3 for the Cholesky decomposition itself and 4.6 for the GP prediction. Furthermore, combining HPX with multiple CUDA streams allows GPRat to match, and for large datasets, surpass cuSOLVER's performance by up to 11 percent."},{"descriptionType":"Other","description":"13 pages, 7 figures, Workshop on Asynchronous Many-Task Systems and Applications 2026"}],"geoLocations":[],"fundingReferences":[],"url":"https://arxiv.org/abs/2602.19683","contentUrl":null,"metadataVersion":0,"schemaVersion":"http://datacite.org/schema/kernel-4","source":"mds","isActive":true,"state":"findable","reason":null,"viewCount":0,"downloadCount":0,"referenceCount":0,"citationCount":0,"partCount":0,"partOfCount":0,"versionCount":0,"versionOfCount":0,"created":"2026-02-25T15:10:32Z","registered":"2026-02-25T15:10:33Z","published":null,"updated":"2026-02-25T15:10:33Z"},"relationships":{"client":{"data":{"id":"arxiv.content","type":"clients"}}}},{"id":"10.48550/arxiv.2602.19682","type":"dois","attributes":{"doi":"10.48550/arxiv.2602.19682","identifiers":[{"identifier":"2602.19682","identifierType":"arXiv"}],"creators":[{"nameType":"Personal","givenName":"Bengüsu","familyName":"Özcan","name":"Özcan, Bengüsu","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Alex","familyName":"Petropoulos","name":"Petropoulos, Alex","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Max","familyName":"Reddel","name":"Reddel, Max","affiliation":[],"nameIdentifiers":[]}],"titles":[{"title":"Beyond the Binary: A nuanced path for open-weight advanced AI"}],"publisher":"arXiv","container":{},"publicationYear":2026,"subjects":[{"subject":"Computers and Society (cs.CY)","lang":"en","subjectScheme":"arXiv"},{"subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"},{"schemeUri":"http://www.oecd.org/science/inno/38235147.pdf","subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"}],"contributors":[],"dates":[{"date":"2026-02-23T10:26:23Z","dateType":"Submitted","dateInformation":"v1"},{"date":"2026-02-24T02:19:44Z","dateType":"Updated","dateInformation":"v1"},{"date":"2026-02","dateType":"Available","dateInformation":"v1"},{"date":"2026","dateType":"Issued"}],"language":null,"types":{"schemaOrg":"CreativeWork","resourceTypeGeneral":"Preprint","citeproc":"article","bibtex":"misc","ris":"GEN","resourceType":"Article"},"relatedIdentifiers":[],"relatedItems":[],"sizes":[],"formats":[],"version":"1","rightsList":[{"rightsIdentifierScheme":"SPDX","rightsUri":"https://creativecommons.org/licenses/by/4.0/legalcode","schemeUri":"https://spdx.org/licenses/","rights":"Creative Commons Attribution 4.0 International","rightsIdentifier":"cc-by-4.0"}],"descriptions":[{"descriptionType":"Abstract","description":"Open-weight advanced AI models -- systems whose parameters are freely available for download and adaptation -- are reshaping the global AI landscape. As these models rapidly close the performance gap with closed alternatives, they enable breakthrough research and broaden access to powerful tools. However, once released, they cannot be recalled, and their built-in safeguards can be bypassed through fine-tuning or jailbreaking, posing risks that current governance frameworks are not equipped to address.\n This report moves beyond the binary framing of ``open'' versus ``closed'' AI. We assess the current landscape of open-weight advanced AI, examining technical capabilities, risk profiles, and regulatory responses across the European Union, United States, China, the United Kingdom, and international forums. We find significant disparities in safety practices across developers and jurisdictions, with no commonly adopted standards for determining when or how advanced models should be released openly.\n We propose a tiered, safety-anchored approach to model release, where openness is determined by rigorous risk assessment and demonstrated safety rather than ideology or commercial pressure. We outline actionable recommendations for developers, evaluators, standard-setters, and policymakers to enable responsible openness while investing in technical safeguards and societal preparedness."},{"descriptionType":"Other","description":"This publication was originally designed and optimised for web and published on cfg.eu. Minor formatting differences may appear in this version"}],"geoLocations":[],"fundingReferences":[],"url":"https://arxiv.org/abs/2602.19682","contentUrl":null,"metadataVersion":0,"schemaVersion":"http://datacite.org/schema/kernel-4","source":"mds","isActive":true,"state":"findable","reason":null,"viewCount":0,"downloadCount":0,"referenceCount":0,"citationCount":0,"partCount":0,"partOfCount":0,"versionCount":0,"versionOfCount":0,"created":"2026-02-25T15:10:30Z","registered":"2026-02-25T15:10:31Z","published":null,"updated":"2026-02-25T15:10:31Z"},"relationships":{"client":{"data":{"id":"arxiv.content","type":"clients"}}}},{"id":"10.48550/arxiv.2602.19679","type":"dois","attributes":{"doi":"10.48550/arxiv.2602.19679","identifiers":[{"identifier":"2602.19679","identifierType":"arXiv"}],"creators":[{"nameType":"Personal","givenName":"Hyeongjin","familyName":"Nam","name":"Nam, Hyeongjin","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Daniel Sungho","familyName":"Jung","name":"Jung, Daniel Sungho","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Kyoung Mu","familyName":"Lee","name":"Lee, Kyoung Mu","affiliation":[],"nameIdentifiers":[]}],"titles":[{"title":"TeHOR: Text-Guided 3D Human and Object Reconstruction with Textures"}],"publisher":"arXiv","container":{},"publicationYear":2026,"subjects":[{"subject":"Computer Vision and Pattern Recognition (cs.CV)","lang":"en","subjectScheme":"arXiv"},{"subject":"Artificial Intelligence (cs.AI)","lang":"en","subjectScheme":"arXiv"},{"subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"},{"schemeUri":"http://www.oecd.org/science/inno/38235147.pdf","subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"}],"contributors":[],"dates":[{"date":"2026-02-23T10:22:52Z","dateType":"Submitted","dateInformation":"v1"},{"date":"2026-02-24T02:19:40Z","dateType":"Updated","dateInformation":"v1"},{"date":"2026-02","dateType":"Available","dateInformation":"v1"},{"date":"2026","dateType":"Issued"}],"language":null,"types":{"schemaOrg":"CreativeWork","resourceTypeGeneral":"Preprint","citeproc":"article","bibtex":"misc","ris":"GEN","resourceType":"Article"},"relatedIdentifiers":[],"relatedItems":[],"sizes":[],"formats":[],"version":"1","rightsList":[{"rightsIdentifierScheme":"SPDX","rightsUri":"https://creativecommons.org/licenses/by-nc-sa/4.0/legalcode","schemeUri":"https://spdx.org/licenses/","rights":"Creative Commons Attribution Non Commercial Share Alike 4.0 International","rightsIdentifier":"cc-by-nc-sa-4.0"}],"descriptions":[{"descriptionType":"Abstract","description":"Joint reconstruction of 3D human and object from a single image is an active research area, with pivotal applications in robotics and digital content creation. Despite recent advances, existing approaches suffer from two fundamental limitations. First, their reconstructions rely heavily on physical contact information, which inherently cannot capture non-contact human-object interactions, such as gazing at or pointing toward an object. Second, the reconstruction process is primarily driven by local geometric proximity, neglecting the human and object appearances that provide global context crucial for understanding holistic interactions. To address these issues, we introduce TeHOR, a framework built upon two core designs. First, beyond contact information, our framework leverages text descriptions of human-object interactions to enforce semantic alignment between the 3D reconstruction and its textual cues, enabling reasoning over a wider spectrum of interactions, including non-contact cases. Second, we incorporate appearance cues of the 3D human and object into the alignment process to capture holistic contextual information, thereby ensuring visually plausible reconstructions. As a result, our framework produces accurate and semantically coherent reconstructions, achieving state-of-the-art performance."},{"descriptionType":"Other","description":"Published at CVPR 2026, 20 pages including the supplementary material"}],"geoLocations":[],"fundingReferences":[],"url":"https://arxiv.org/abs/2602.19679","contentUrl":null,"metadataVersion":0,"schemaVersion":"http://datacite.org/schema/kernel-4","source":"mds","isActive":true,"state":"findable","reason":null,"viewCount":0,"downloadCount":0,"referenceCount":0,"citationCount":0,"partCount":0,"partOfCount":0,"versionCount":0,"versionOfCount":0,"created":"2026-02-25T15:10:23Z","registered":"2026-02-25T15:10:23Z","published":null,"updated":"2026-02-25T15:10:23Z"},"relationships":{"client":{"data":{"id":"arxiv.content","type":"clients"}}}},{"id":"10.48550/arxiv.2602.19676","type":"dois","attributes":{"doi":"10.48550/arxiv.2602.19676","identifiers":[{"identifier":"2602.19676","identifierType":"arXiv"}],"creators":[{"nameType":"Personal","givenName":"Jaya Kumar","familyName":"Alageshan","name":"Alageshan, Jaya Kumar","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Suman","familyName":"Dolui","name":"Dolui, Suman","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Joydeep","familyName":"Ghosh","name":"Ghosh, Joydeep","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Kishore","familyName":"Mishra","name":"Mishra, Kishore","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Sarveshwar","familyName":"Sharma","name":"Sharma, Sarveshwar","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Abhijit","familyName":"Sen","name":"Sen, Abhijit","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Manjunatha","familyName":"Valmiki","name":"Valmiki, Manjunatha","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Sandeep","familyName":"Agrawal","name":"Agrawal, Sandeep","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Sanjay","familyName":"Wandhekar","name":"Wandhekar, Sanjay","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Zhihong","familyName":"Lin","name":"Lin, Zhihong","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Animesh","familyName":"Kuley","name":"Kuley, Animesh","affiliation":[],"nameIdentifiers":[]}],"titles":[{"title":"Gyrokinetic simulation of the effect of transient fueling on plasma turbulence in ADITYA-U tokamak"}],"publisher":"arXiv","container":{},"publicationYear":2026,"subjects":[{"subject":"Plasma Physics (physics.plasm-ph)","lang":"en","subjectScheme":"arXiv"},{"subject":"FOS: Physical sciences","subjectScheme":"Fields of Science and Technology (FOS)"},{"schemeUri":"http://www.oecd.org/science/inno/38235147.pdf","subject":"FOS: Physical sciences","subjectScheme":"Fields of Science and Technology (FOS)"}],"contributors":[],"dates":[{"date":"2026-02-23T10:19:43Z","dateType":"Submitted","dateInformation":"v1"},{"date":"2026-02-24T02:19:19Z","dateType":"Updated","dateInformation":"v1"},{"date":"2026-02","dateType":"Available","dateInformation":"v1"},{"date":"2026","dateType":"Issued"}],"language":null,"types":{"schemaOrg":"CreativeWork","resourceTypeGeneral":"Preprint","citeproc":"article","bibtex":"misc","ris":"GEN","resourceType":"Article"},"relatedIdentifiers":[],"relatedItems":[],"sizes":[],"formats":[],"version":"1","rightsList":[{"rightsIdentifierScheme":"SPDX","rightsUri":"https://creativecommons.org/licenses/by/4.0/legalcode","schemeUri":"https://spdx.org/licenses/","rights":"Creative Commons Attribution 4.0 International","rightsIdentifier":"cc-by-4.0"}],"descriptions":[{"descriptionType":"Abstract","description":"The gradient-driven microturbulence in ADITYA-U tokamak plasmas has been suppressed by injecting short gas puffs. The suppression of microturbulence increases the core temperature and subsequently the energy confinement time following the gas puff. The gas injection modifies the radial density profile, making it relatively flatter near the mid-radius. Global electrostatic gyrokinetic simulations show that this modification to the radial density profile due to gas injection suppresses the existing trapped electron mode (TEM). Simulation results show that the TEM-dominated turbulence suppression reduces the turbulence-driven heat transport, leading to an increase in core temperature. Applying multiple periodic gas-puffs leads to multiple periodic events of TEM suppression, improving the overall energy confinement time, and is used as an active control mechanism to influence microturbulence in ADITYA-U tokamak."},{"descriptionType":"Other","description":"9 pages, 3 figures"}],"geoLocations":[],"fundingReferences":[],"url":"https://arxiv.org/abs/2602.19676","contentUrl":null,"metadataVersion":0,"schemaVersion":"http://datacite.org/schema/kernel-4","source":"mds","isActive":true,"state":"findable","reason":null,"viewCount":0,"downloadCount":0,"referenceCount":0,"citationCount":0,"partCount":0,"partOfCount":0,"versionCount":0,"versionOfCount":0,"created":"2026-02-25T15:10:15Z","registered":"2026-02-25T15:10:16Z","published":null,"updated":"2026-02-25T15:10:16Z"},"relationships":{"client":{"data":{"id":"arxiv.content","type":"clients"}}}},{"id":"10.48550/arxiv.2602.19675","type":"dois","attributes":{"doi":"10.48550/arxiv.2602.19675","identifiers":[{"identifier":"2602.19675","identifierType":"arXiv"}],"creators":[{"nameType":"Personal","givenName":"Ahmed","familyName":"Laghribi","name":"Laghribi, Ahmed","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Nico","familyName":"Lorenz","name":"Lorenz, Nico","affiliation":[],"nameIdentifiers":[]}],"titles":[{"title":"A cohomological invariant for algebras of degree 8 and exponent 2 in characteristic 2"}],"publisher":"arXiv","container":{},"publicationYear":2026,"subjects":[{"subject":"Number Theory (math.NT)","lang":"en","subjectScheme":"arXiv"},{"subject":"FOS: Mathematics","subjectScheme":"Fields of Science and Technology (FOS)"},{"schemeUri":"http://www.oecd.org/science/inno/38235147.pdf","subject":"FOS: Mathematics","subjectScheme":"Fields of Science and Technology (FOS)"},{"subject":"11E04, 11E81, 16K20, 13N05","lang":"en","subjectScheme":"MSC"}],"contributors":[],"dates":[{"date":"2026-02-23T10:19:38Z","dateType":"Submitted","dateInformation":"v1"},{"date":"2026-02-24T02:19:18Z","dateType":"Updated","dateInformation":"v1"},{"date":"2026-02","dateType":"Available","dateInformation":"v1"},{"date":"2026","dateType":"Issued"}],"language":null,"types":{"schemaOrg":"CreativeWork","resourceTypeGeneral":"Preprint","citeproc":"article","bibtex":"misc","ris":"GEN","resourceType":"Article"},"relatedIdentifiers":[],"relatedItems":[],"sizes":[],"formats":[],"version":"1","rightsList":[{"rightsIdentifierScheme":"SPDX","rightsUri":"https://creativecommons.org/licenses/by/4.0/legalcode","schemeUri":"https://spdx.org/licenses/","rights":"Creative Commons Attribution 4.0 International","rightsIdentifier":"cc-by-4.0"}],"descriptions":[{"descriptionType":"Abstract","description":"Our aim in this paper is to extend a work of Sivatski to characteristic 2. More precisely, for $F$ a field of characteristic $2$ and a central simple algebra $A$ of exponent 2 that splits over a triquadratic extension of $F$ of separability degree at least 4, we attach a cohomological invariant $\\inv(A) \\in H_2^3(F) / G$, where $H_2^3(F)$ is the third Kato-Milno cohomology group and $G$ is a subgroup of $H_2^3(F)$ divisible by the Brauer class of $A$. As an application, we will relate the decomposability of the algebra in degree 8 to the vanishing of $\\inv(A)$. Moreover, we will use this invariant to prove some descent results for central simple algebras and quadratic forms over biquadratic extensions."}],"geoLocations":[],"fundingReferences":[],"url":"https://arxiv.org/abs/2602.19675","contentUrl":null,"metadataVersion":0,"schemaVersion":"http://datacite.org/schema/kernel-4","source":"mds","isActive":true,"state":"findable","reason":null,"viewCount":0,"downloadCount":0,"referenceCount":0,"citationCount":0,"partCount":0,"partOfCount":0,"versionCount":0,"versionOfCount":0,"created":"2026-02-25T15:10:13Z","registered":"2026-02-25T15:10:14Z","published":null,"updated":"2026-02-25T15:10:14Z"},"relationships":{"client":{"data":{"id":"arxiv.content","type":"clients"}}}},{"id":"10.48550/arxiv.2602.19672","type":"dois","attributes":{"doi":"10.48550/arxiv.2602.19672","identifiers":[{"identifier":"2602.19672","identifierType":"arXiv"}],"creators":[{"nameType":"Personal","givenName":"Jiayu","familyName":"Wang","name":"Wang, Jiayu","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Yifei","familyName":"Ming","name":"Ming, Yifei","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Zixuan","familyName":"Ke","name":"Ke, Zixuan","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Shafiq","familyName":"Joty","name":"Joty, Shafiq","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Aws","familyName":"Albarghouthi","name":"Albarghouthi, Aws","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Frederic","familyName":"Sala","name":"Sala, Frederic","affiliation":[],"nameIdentifiers":[]}],"titles":[{"title":"SkillOrchestra: Learning to Route Agents via Skill Transfer"}],"publisher":"arXiv","container":{},"publicationYear":2026,"subjects":[{"subject":"Artificial Intelligence (cs.AI)","lang":"en","subjectScheme":"arXiv"},{"subject":"Machine Learning (cs.LG)","lang":"en","subjectScheme":"arXiv"},{"subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"},{"schemeUri":"http://www.oecd.org/science/inno/38235147.pdf","subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"}],"contributors":[],"dates":[{"date":"2026-02-23T10:17:25Z","dateType":"Submitted","dateInformation":"v1"},{"date":"2026-02-24T02:19:15Z","dateType":"Updated","dateInformation":"v1"},{"date":"2026-02","dateType":"Available","dateInformation":"v1"},{"date":"2026","dateType":"Issued"}],"language":null,"types":{"schemaOrg":"CreativeWork","resourceTypeGeneral":"Preprint","citeproc":"article","bibtex":"misc","ris":"GEN","resourceType":"Article"},"relatedIdentifiers":[],"relatedItems":[],"sizes":[],"formats":[],"version":"1","rightsList":[{"rightsIdentifierScheme":"SPDX","rightsUri":"https://creativecommons.org/licenses/by/4.0/legalcode","schemeUri":"https://spdx.org/licenses/","rights":"Creative Commons Attribution 4.0 International","rightsIdentifier":"cc-by-4.0"}],"descriptions":[{"descriptionType":"Abstract","description":"Compound AI systems promise capabilities beyond those of individual models, yet their success depends critically on effective orchestration. Existing routing approaches face two limitations: (1) input-level routers make coarse query-level decisions that ignore evolving task requirements; (2) RL-trained orchestrators are expensive to adapt and often suffer from routing collapse, repeatedly invoking one strong but costly option in multi-turn scenarios. We introduce SkillOrchestra, a framework for skill-aware orchestration. Instead of directly learning a routing policy end-to-end, SkillOrchestra learns fine-grained skills from execution experience and models agent-specific competence and cost under those skills. At deployment, the orchestrator infers the skill demands of the current interaction and selects agents that best satisfy them under an explicit performance-cost trade-off. Extensive experiments across ten benchmarks demonstrate that SkillOrchestra outperforms SoTA RL-based orchestrators by up to 22.5% with 700x and 300x learning cost reduction compared to Router-R1 and ToolOrchestra, respectively. These results show that explicit skill modeling enables scalable, interpretable, and sample-efficient orchestration, offering a principled alternative to data-intensive RL-based approaches. The code is available at: https://github.com/jiayuww/SkillOrchestra."}],"geoLocations":[],"fundingReferences":[],"url":"https://arxiv.org/abs/2602.19672","contentUrl":null,"metadataVersion":0,"schemaVersion":"http://datacite.org/schema/kernel-4","source":"mds","isActive":true,"state":"findable","reason":null,"viewCount":0,"downloadCount":0,"referenceCount":0,"citationCount":0,"partCount":0,"partOfCount":0,"versionCount":0,"versionOfCount":0,"created":"2026-02-25T15:10:06Z","registered":"2026-02-25T15:10:07Z","published":null,"updated":"2026-02-25T15:10:07Z"},"relationships":{"client":{"data":{"id":"arxiv.content","type":"clients"}}}},{"id":"10.48550/arxiv.2602.19669","type":"dois","attributes":{"doi":"10.48550/arxiv.2602.19669","identifiers":[{"identifier":"2602.19669","identifierType":"arXiv"}],"creators":[{"nameType":"Personal","givenName":"Masaki","familyName":"Kashima","name":"Kashima, Masaki","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Kenta","familyName":"Ozeki","name":"Ozeki, Kenta","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Leilei","familyName":"Zhang","name":"Zhang, Leilei","affiliation":[],"nameIdentifiers":[]}],"titles":[{"title":"A Note on Grünbaum's Conjecture about Longest Cycles and Paths"}],"publisher":"arXiv","container":{},"publicationYear":2026,"subjects":[{"subject":"Combinatorics (math.CO)","lang":"en","subjectScheme":"arXiv"},{"subject":"FOS: Mathematics","subjectScheme":"Fields of Science and Technology (FOS)"},{"schemeUri":"http://www.oecd.org/science/inno/38235147.pdf","subject":"FOS: Mathematics","subjectScheme":"Fields of Science and Technology (FOS)"}],"contributors":[],"dates":[{"date":"2026-02-23T10:15:11Z","dateType":"Submitted","dateInformation":"v1"},{"date":"2026-02-24T02:19:03Z","dateType":"Updated","dateInformation":"v1"},{"date":"2026-02","dateType":"Available","dateInformation":"v1"},{"date":"2026","dateType":"Issued"}],"language":null,"types":{"schemaOrg":"CreativeWork","resourceTypeGeneral":"Preprint","citeproc":"article","bibtex":"misc","ris":"GEN","resourceType":"Article"},"relatedIdentifiers":[],"relatedItems":[],"sizes":[],"formats":[],"version":"1","rightsList":[{"rightsUri":"http://arxiv.org/licenses/nonexclusive-distrib/1.0/","rights":"arXiv.org perpetual, non-exclusive license"}],"descriptions":[{"descriptionType":"Abstract","description":"Let $c(G)$ denote the circumference of a graph $G$, i.e., the number of vertices in its longest cycle. For positive integers $n$ and $k$ with $n\u0026gt;k$, let $\\varGamma(n;k)$ be the class of graphs of order $n$ with $c(G) = n-k$ such that every induced subgraph of order $n-k$ is Hamiltonian. When $k=$, the class $\\varGamma(n; 1)$ coincides with the family of hypohamiltonian graphs-non-Hamiltonian graphs in which the deletion of any single vertex yields a Hamiltonian graph.Replacing Hamiltonian with traceable and $c(G)$ with $p(G)$, the order of a longest path, defines the analogous class $\\varPi(n;k)$.Grünbaum (1974) conjectured that both $\\varGamma(n; k)$ and $\\varPi(n; k)$ are empty for all $n\u0026gt;k \\ge 2$. In this note, we first establish upper bounds on the maximum degree of graphs in the classes $\\varGamma(n; k)$ and $\\varPi(n; k)$. Using these bounds, we show that $\\varGamma(n; k)$ is empty when $n"}],"geoLocations":[],"fundingReferences":[],"url":"https://arxiv.org/abs/2602.19669","contentUrl":null,"metadataVersion":0,"schemaVersion":"http://datacite.org/schema/kernel-4","source":"mds","isActive":true,"state":"findable","reason":null,"viewCount":0,"downloadCount":0,"referenceCount":0,"citationCount":0,"partCount":0,"partOfCount":0,"versionCount":0,"versionOfCount":0,"created":"2026-02-25T15:09:58Z","registered":"2026-02-25T15:09:59Z","published":null,"updated":"2026-02-25T15:09:59Z"},"relationships":{"client":{"data":{"id":"arxiv.content","type":"clients"}}}},{"id":"10.48550/arxiv.2602.19668","type":"dois","attributes":{"doi":"10.48550/arxiv.2602.19668","identifiers":[{"identifier":"2602.19668","identifierType":"arXiv"}],"creators":[{"nameType":"Personal","givenName":"He","familyName":"Zhu","name":"Zhu, He","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Ren","familyName":"Togo","name":"Togo, Ren","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Takahiro","familyName":"Ogawa","name":"Ogawa, Takahiro","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Kenji","familyName":"Hirata","name":"Hirata, Kenji","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Minghui","familyName":"Tang","name":"Tang, Minghui","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Takaaki","familyName":"Yoshimura","name":"Yoshimura, Takaaki","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Hiroyuki","familyName":"Sugimori","name":"Sugimori, Hiroyuki","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Noriko","familyName":"Nishioka","name":"Nishioka, Noriko","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Yukie","familyName":"Shimizu","name":"Shimizu, Yukie","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Kohsuke","familyName":"Kudo","name":"Kudo, Kohsuke","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Miki","familyName":"Haseyama","name":"Haseyama, Miki","affiliation":[],"nameIdentifiers":[]}],"titles":[{"title":"Personalized Longitudinal Medical Report Generation via Temporally-Aware Federated Adaptation"}],"publisher":"arXiv","container":{},"publicationYear":2026,"subjects":[{"subject":"Computer Vision and Pattern Recognition (cs.CV)","lang":"en","subjectScheme":"arXiv"},{"subject":"Machine Learning (cs.LG)","lang":"en","subjectScheme":"arXiv"},{"subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"},{"schemeUri":"http://www.oecd.org/science/inno/38235147.pdf","subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"}],"contributors":[],"dates":[{"date":"2026-02-23T10:14:36Z","dateType":"Submitted","dateInformation":"v1"},{"date":"2026-02-24T02:18:59Z","dateType":"Updated","dateInformation":"v1"},{"date":"2026-02","dateType":"Available","dateInformation":"v1"},{"date":"2026","dateType":"Issued"}],"language":null,"types":{"schemaOrg":"CreativeWork","resourceTypeGeneral":"Preprint","citeproc":"article","bibtex":"misc","ris":"GEN","resourceType":"Article"},"relatedIdentifiers":[],"relatedItems":[],"sizes":[],"formats":[],"version":"1","rightsList":[{"rightsUri":"http://arxiv.org/licenses/nonexclusive-distrib/1.0/","rights":"arXiv.org perpetual, non-exclusive license"}],"descriptions":[{"descriptionType":"Abstract","description":"Longitudinal medical report generation is clinically important yet remains challenging due to strict privacy constraints and the evolving nature of disease progression. Although federated learning (FL) enables collaborative training without data sharing, existing FL methods largely overlook longitudinal dynamics by assuming stationary client distributions, making them unable to model temporal shifts across visits or patient-specific heterogeneity-ultimately leading to unstable optimization and suboptimal report generation.\n We introduce Federated Temporal Adaptation (FTA), a federated setting that explicitly accounts for the temporal evolution of client data. Building upon this setting, we propose FedTAR, a framework that integrates demographic-driven personalization with time-aware global aggregation. FedTAR generates lightweight LoRA adapters from demographic embeddings and performs temporal residual aggregation, where updates from different visits are weighted by a meta-learned temporal policy optimized via first-order MAML.\n Experiments on J-MID (1M exams) and MIMIC-CXR demonstrate consistent improvements in linguistic accuracy, temporal coherence, and cross-site generalization, establishing FedTAR as a robust and privacy-preserving paradigm for federated longitudinal modeling."}],"geoLocations":[],"fundingReferences":[],"url":"https://arxiv.org/abs/2602.19668","contentUrl":null,"metadataVersion":0,"schemaVersion":"http://datacite.org/schema/kernel-4","source":"mds","isActive":true,"state":"findable","reason":null,"viewCount":0,"downloadCount":0,"referenceCount":0,"citationCount":0,"partCount":0,"partOfCount":0,"versionCount":0,"versionOfCount":0,"created":"2026-02-25T15:09:56Z","registered":"2026-02-25T15:09:56Z","published":null,"updated":"2026-02-25T15:09:57Z"},"relationships":{"client":{"data":{"id":"arxiv.content","type":"clients"}}}},{"id":"10.48550/arxiv.2602.19667","type":"dois","attributes":{"doi":"10.48550/arxiv.2602.19667","identifiers":[{"identifier":"2602.19667","identifierType":"arXiv"}],"creators":[{"nameType":"Personal","givenName":"Timon","familyName":"Conrad","name":"Conrad, Timon","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Changhun","familyName":"Kim","name":"Kim, Changhun","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Johann","familyName":"Jäger","name":"Jäger, Johann","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Andreas","familyName":"Maier","name":"Maier, Andreas","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Siming","familyName":"Bayer","name":"Bayer, Siming","affiliation":[],"nameIdentifiers":[]}],"titles":[{"title":"Impact of Training Dataset Size for ML Load Flow Surrogates"}],"publisher":"arXiv","container":{},"publicationYear":2026,"subjects":[{"subject":"Systems and Control (eess.SY)","lang":"en","subjectScheme":"arXiv"},{"subject":"FOS: Electrical engineering, electronic engineering, information engineering","subjectScheme":"Fields of Science and Technology (FOS)"},{"schemeUri":"http://www.oecd.org/science/inno/38235147.pdf","subject":"FOS: Electrical engineering, electronic engineering, information engineering","subjectScheme":"Fields of Science and Technology (FOS)"}],"contributors":[],"dates":[{"date":"2026-02-23T10:13:25Z","dateType":"Submitted","dateInformation":"v1"},{"date":"2026-02-24T02:18:57Z","dateType":"Updated","dateInformation":"v1"},{"date":"2026-02","dateType":"Available","dateInformation":"v1"},{"date":"2026","dateType":"Issued"}],"language":null,"types":{"schemaOrg":"CreativeWork","resourceTypeGeneral":"Preprint","citeproc":"article","bibtex":"misc","ris":"GEN","resourceType":"Article"},"relatedIdentifiers":[],"relatedItems":[],"sizes":[],"formats":[],"version":"1","rightsList":[{"rightsIdentifierScheme":"SPDX","rightsUri":"https://creativecommons.org/licenses/by-sa/4.0/legalcode","schemeUri":"https://spdx.org/licenses/","rights":"Creative Commons Attribution Share Alike 4.0 International","rightsIdentifier":"cc-by-sa-4.0"}],"descriptions":[{"descriptionType":"Abstract","description":"Efficient and accurate load flow calculations are a bedrock of modern power system operation. Classical numerical methods such as the Newton-Raphson algorithm provide highly precise results but are computationally demanding, which limits their applicability in large-scale scenario studies and optimization in time-critical contexts. Research has shown that machine learning approaches can approximate load flow results with high accuracy while substantially reducing computation time.\n Sample efficiency, i.e., the ability to achieve high accuracy with limited training dataset size, is still insufficiently researched, especially in grids with a fixed topology. This paper presents a systematic investigation of the sample efficiency of a Multilayer Perceptron and two Graph Neural Network variants on a dataset based on a modified IEEE 5-bus system. The results for this grid size show that Graph Neural Networks achieve the lowest losses. However, the availability of large training datasets remains the dominant factor influencing performance compared to architecture choice."},{"descriptionType":"Other","description":"Oberlausitzer Energiesymposium 2025 \u0026amp; Zittauer Energieseminar, Zittau, Deutschland, 25./26. November 2025"}],"geoLocations":[],"fundingReferences":[],"url":"https://arxiv.org/abs/2602.19667","contentUrl":null,"metadataVersion":0,"schemaVersion":"http://datacite.org/schema/kernel-4","source":"mds","isActive":true,"state":"findable","reason":null,"viewCount":0,"downloadCount":0,"referenceCount":0,"citationCount":0,"partCount":0,"partOfCount":0,"versionCount":0,"versionOfCount":0,"created":"2026-02-25T15:09:53Z","registered":"2026-02-25T15:09:54Z","published":null,"updated":"2026-02-25T15:09:54Z"},"relationships":{"client":{"data":{"id":"arxiv.content","type":"clients"}}}},{"id":"10.48550/arxiv.2602.19666","type":"dois","attributes":{"doi":"10.48550/arxiv.2602.19666","identifiers":[{"identifier":"2602.19666","identifierType":"arXiv"}],"creators":[{"nameType":"Personal","givenName":"Mario","familyName":"di Bernardo","name":"di Bernardo, Mario","affiliation":[],"nameIdentifiers":[]}],"titles":[{"title":"Multicellular Feedback Control Strategies in Synthetic Microbial Consortia: From Embedded to Distributed Control"}],"publisher":"arXiv","container":{},"publicationYear":2026,"subjects":[{"subject":"Systems and Control (eess.SY)","lang":"en","subjectScheme":"arXiv"},{"subject":"FOS: Electrical engineering, electronic engineering, information engineering","subjectScheme":"Fields of Science and Technology (FOS)"},{"schemeUri":"http://www.oecd.org/science/inno/38235147.pdf","subject":"FOS: Electrical engineering, electronic engineering, information engineering","subjectScheme":"Fields of Science and Technology (FOS)"}],"contributors":[],"dates":[{"date":"2026-02-23T10:13:11Z","dateType":"Submitted","dateInformation":"v1"},{"date":"2026-02-24T02:18:55Z","dateType":"Updated","dateInformation":"v1"},{"date":"2026-02","dateType":"Available","dateInformation":"v1"},{"date":"2026","dateType":"Issued"}],"language":null,"types":{"schemaOrg":"CreativeWork","resourceTypeGeneral":"Preprint","citeproc":"article","bibtex":"misc","ris":"GEN","resourceType":"Article"},"relatedIdentifiers":[],"relatedItems":[],"sizes":[],"formats":[],"version":"1","rightsList":[{"rightsIdentifierScheme":"SPDX","rightsUri":"https://creativecommons.org/licenses/by-nc-nd/4.0/legalcode","schemeUri":"https://spdx.org/licenses/","rights":"Creative Commons Attribution Non Commercial No Derivatives 4.0 International","rightsIdentifier":"cc-by-nc-nd-4.0"}],"descriptions":[{"descriptionType":"Abstract","description":"Living organisms rely on endogenous feedback mechanisms to maintain homeostasis in the presence of uncertainty and environmental fluctuations. An emerging challenge at the interface of control systems engineering and synthetic biology is the design of reliable feedback strategies to regulate cellular behavior and collective biological functions. In this article, we review recent advances in multicellular feedback control, where sensing, computation, and actuation are distributed across different cell populations within synthetic microbial consortia, giving rise to biological multiagent control systems governed by molecular communication. From a control-theoretic perspective, these consortia can be interpreted as distributed biomolecular control systems, where coordination among populations replace embedded regulation. We survey theoretical frameworks, control architectures, and modeling approaches, ranging from aggregate population-level dynamics to spatially aware agent-based simulations, and discuss experimental demonstrations in engineered \\textit{Escherichia coli} consortia. We highlight how distributing control functions across populations can reduce metabolic burden, mitigate retroactivity, improve robustness to uncertainty, and enable modular reuse of control components. Beyond regulation of gene expression, we discuss the emerging problem of population composition control, where coordination among growing and competing cell populations becomes an integral part of the control objective. Finally, we outline key open challenges that must be addressed before multicellular control strategies can be deployed in real-world applications such as biomanufacturing, environmental remediation, and therapeutic systems. These challenges span modeling and simulation, experimental platform development, coordination and composition control, and long-term evolutionary stability."}],"geoLocations":[],"fundingReferences":[],"url":"https://arxiv.org/abs/2602.19666","contentUrl":null,"metadataVersion":0,"schemaVersion":"http://datacite.org/schema/kernel-4","source":"mds","isActive":true,"state":"findable","reason":null,"viewCount":0,"downloadCount":0,"referenceCount":0,"citationCount":0,"partCount":0,"partOfCount":0,"versionCount":0,"versionOfCount":0,"created":"2026-02-25T15:09:51Z","registered":"2026-02-25T15:09:52Z","published":null,"updated":"2026-02-25T15:09:52Z"},"relationships":{"client":{"data":{"id":"arxiv.content","type":"clients"}}}},{"id":"10.48550/arxiv.2602.19665","type":"dois","attributes":{"doi":"10.48550/arxiv.2602.19665","identifiers":[{"identifier":"2602.19665","identifierType":"arXiv"}],"creators":[{"nameType":"Personal","givenName":"Amos Sospeter","familyName":"Kiyumbi","name":"Kiyumbi, Amos Sospeter","affiliation":[],"nameIdentifiers":[]}],"titles":[{"title":"Circular V-grooves on single-crystal gold: optical properties and sensing feasibility"}],"publisher":"arXiv","container":{},"publicationYear":2026,"subjects":[{"subject":"Optics (physics.optics)","lang":"en","subjectScheme":"arXiv"},{"subject":"FOS: Physical sciences","subjectScheme":"Fields of Science and Technology (FOS)"},{"schemeUri":"http://www.oecd.org/science/inno/38235147.pdf","subject":"FOS: Physical sciences","subjectScheme":"Fields of Science and Technology (FOS)"}],"contributors":[],"dates":[{"date":"2026-02-23T10:13:01Z","dateType":"Submitted","dateInformation":"v1"},{"date":"2026-02-24T02:18:54Z","dateType":"Updated","dateInformation":"v1"},{"date":"2026-02","dateType":"Available","dateInformation":"v1"},{"date":"2026","dateType":"Issued"}],"language":null,"types":{"schemaOrg":"CreativeWork","resourceTypeGeneral":"Preprint","citeproc":"article","bibtex":"misc","ris":"GEN","resourceType":"Article"},"relatedIdentifiers":[],"relatedItems":[],"sizes":[],"formats":[],"version":"1","rightsList":[{"rightsUri":"http://arxiv.org/licenses/nonexclusive-distrib/1.0/","rights":"arXiv.org perpetual, non-exclusive license"}],"descriptions":[{"descriptionType":"Abstract","description":"Single-crystal Au(111) microplates provide an ultra-smooth, low-defect platform for reproducible plasmonic nanocavities. Here we realize reflection-mode whispering-gallery metasurfaces comprising periodic arrays of circular V-groove cavities milled into optically thick Au microplates and characterize their visible--near-IR response. The measured spectra exhibit narrow, depth-tunable Fano-like reflectance minima with weak azimuthal dependence, reproduced by quarter-cell finite-element modeling consistent with strong gap-surface-plasmon confinement. For refractometric sensing, simulations yield bulk sensitivities up to $\\sim 598$ nm RIU$^{-1}$ and figures of merit up to $\\sim 33$ (hexagonal lattice). As a model-based illustration, a functionalized architecture targeting \\textit{Plasmodium falciparum} lactate dehydrogenase (PfLDH), a common malaria target of rapid diagnostic tests, gives an estimated limit of detection of $0.016$ nM ($\\sim 0.56$ ng mL$^{-1}$) under the adopted noise floor."},{"descriptionType":"Other","description":"13 pages, 8 figures"}],"geoLocations":[],"fundingReferences":[],"url":"https://arxiv.org/abs/2602.19665","contentUrl":null,"metadataVersion":0,"schemaVersion":"http://datacite.org/schema/kernel-4","source":"mds","isActive":true,"state":"findable","reason":null,"viewCount":0,"downloadCount":0,"referenceCount":0,"citationCount":0,"partCount":0,"partOfCount":0,"versionCount":0,"versionOfCount":0,"created":"2026-02-25T15:09:48Z","registered":"2026-02-25T15:09:49Z","published":null,"updated":"2026-02-25T15:09:49Z"},"relationships":{"client":{"data":{"id":"arxiv.content","type":"clients"}}}},{"id":"10.48550/arxiv.2602.19663","type":"dois","attributes":{"doi":"10.48550/arxiv.2602.19663","identifiers":[{"identifier":"2602.19663","identifierType":"arXiv"}],"creators":[{"nameType":"Personal","givenName":"Willem D.","familyName":"Schutte","name":"Schutte, Willem D.","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Charl","familyName":"Pretorius","name":"Pretorius, Charl","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Neill","familyName":"Smit","name":"Smit, Neill","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Leandra","familyName":"van der Merwe","name":"van der Merwe, Leandra","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Robert","familyName":"Maxwell","name":"Maxwell, Robert","affiliation":[],"nameIdentifiers":[]}],"titles":[{"title":"The impact of class imbalance in logistic regression models for low-default portfolios in credit risk"}],"publisher":"arXiv","container":{},"publicationYear":2026,"subjects":[{"subject":"Risk Management (q-fin.RM)","lang":"en","subjectScheme":"arXiv"},{"subject":"Computation (stat.CO)","lang":"en","subjectScheme":"arXiv"},{"subject":"FOS: Economics and business","subjectScheme":"Fields of Science and Technology (FOS)"},{"schemeUri":"http://www.oecd.org/science/inno/38235147.pdf","subject":"FOS: Economics and business","subjectScheme":"Fields of Science and Technology (FOS)"},{"subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"},{"schemeUri":"http://www.oecd.org/science/inno/38235147.pdf","subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"}],"contributors":[],"dates":[{"date":"2026-02-23T10:10:46Z","dateType":"Submitted","dateInformation":"v1"},{"date":"2026-02-24T02:18:42Z","dateType":"Updated","dateInformation":"v1"},{"date":"2026-02","dateType":"Available","dateInformation":"v1"},{"date":"2026","dateType":"Issued"}],"language":null,"types":{"schemaOrg":"CreativeWork","resourceTypeGeneral":"Preprint","citeproc":"article","bibtex":"misc","ris":"GEN","resourceType":"Article"},"relatedIdentifiers":[],"relatedItems":[],"sizes":[],"formats":[],"version":"1","rightsList":[{"rightsIdentifierScheme":"SPDX","rightsUri":"https://creativecommons.org/licenses/by-nc-nd/4.0/legalcode","schemeUri":"https://spdx.org/licenses/","rights":"Creative Commons Attribution Non Commercial No Derivatives 4.0 International","rightsIdentifier":"cc-by-nc-nd-4.0"}],"descriptions":[{"descriptionType":"Abstract","description":"In this paper, we study how class imbalance, typical of low-default credit portfolios, affects the performance of logistic regression models. Using a simulation study with controlled data-generating mechanisms, we vary (i) the level of class imbalance and (ii) the strength of association between the predictors and the response. The results show that, for a given strength of association, achievable classification accuracy deteriorates markedly as the event rate decreases, and the optimal classification cut-off shifts with the level of imbalance. In contrast, the Gini coefficient is comparatively stable with respect to class imbalance once sample sizes are sufficiently large, even when classification accuracy is strongly affected. As a practical guideline, we summarise attainable classification performance as a function of the event rate and strength of association between the predictors and the response."},{"descriptionType":"Other","description":"24 pages, 9 figures"}],"geoLocations":[],"fundingReferences":[],"url":"https://arxiv.org/abs/2602.19663","contentUrl":null,"metadataVersion":0,"schemaVersion":"http://datacite.org/schema/kernel-4","source":"mds","isActive":true,"state":"findable","reason":null,"viewCount":0,"downloadCount":0,"referenceCount":0,"citationCount":0,"partCount":0,"partOfCount":0,"versionCount":0,"versionOfCount":0,"created":"2026-02-25T15:09:43Z","registered":"2026-02-25T15:09:44Z","published":null,"updated":"2026-02-25T15:09:44Z"},"relationships":{"client":{"data":{"id":"arxiv.content","type":"clients"}}}},{"id":"10.48550/arxiv.2602.19662","type":"dois","attributes":{"doi":"10.48550/arxiv.2602.19662","identifiers":[{"identifier":"2602.19662","identifierType":"arXiv"}],"creators":[{"nameType":"Personal","givenName":"Yanda","familyName":"Chen","name":"Chen, Yanda","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Sebastian","familyName":"Rodriguez","name":"Rodriguez, Sebastian","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Beatriz","familyName":"Moya","name":"Moya, Beatriz","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Francisco","familyName":"Chinesta","name":"Chinesta, Francisco","affiliation":[],"nameIdentifiers":[]}],"titles":[{"title":"Stress-constrained Topology Optimization for Metamaterial Microstructure Design"}],"publisher":"arXiv","container":{},"publicationYear":2026,"subjects":[{"subject":"Computational Engineering, Finance, and Science (cs.CE)","lang":"en","subjectScheme":"arXiv"},{"subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"},{"schemeUri":"http://www.oecd.org/science/inno/38235147.pdf","subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"}],"contributors":[],"dates":[{"date":"2026-02-23T10:10:45Z","dateType":"Submitted","dateInformation":"v1"},{"date":"2026-02-24T02:18:40Z","dateType":"Updated","dateInformation":"v1"},{"date":"2026-02","dateType":"Available","dateInformation":"v1"},{"date":"2026","dateType":"Issued"}],"language":null,"types":{"schemaOrg":"CreativeWork","resourceTypeGeneral":"Preprint","citeproc":"article","bibtex":"misc","ris":"GEN","resourceType":"Article"},"relatedIdentifiers":[],"relatedItems":[],"sizes":[],"formats":[],"version":"1","rightsList":[{"rightsIdentifierScheme":"SPDX","rightsUri":"https://creativecommons.org/licenses/by/4.0/legalcode","schemeUri":"https://spdx.org/licenses/","rights":"Creative Commons Attribution 4.0 International","rightsIdentifier":"cc-by-4.0"}],"descriptions":[{"descriptionType":"Abstract","description":"Although stress-constrained topology optimization has been extensively studied in structural design, the development of optimization frameworks to enable the creation of metamaterials with optimal mechanical performance is still an open problem. This study incorporates local stress constraints into the topology optimization framework for metamaterial microstructure design, aiming to avoid the stress concentration in the optimized microstructure. For the efficient solution of multi-constraint topology optimization problems, the Augmented Lagrangian formulation is extended to address local minimization problems subjected to the combined action of local and global constraints. Additionally, as an extension of static load conditions, this study further investigates the design of metamaterial microstructures under cyclic loading. Finally, the effectiveness of the proposed approach is demonstrated through a series of two-dimensional and three-dimensional benchmark problems."}],"geoLocations":[],"fundingReferences":[],"url":"https://arxiv.org/abs/2602.19662","contentUrl":null,"metadataVersion":0,"schemaVersion":"http://datacite.org/schema/kernel-4","source":"mds","isActive":true,"state":"findable","reason":null,"viewCount":0,"downloadCount":0,"referenceCount":0,"citationCount":0,"partCount":0,"partOfCount":0,"versionCount":0,"versionOfCount":0,"created":"2026-02-25T15:09:41Z","registered":"2026-02-25T15:09:42Z","published":null,"updated":"2026-02-25T15:09:42Z"},"relationships":{"client":{"data":{"id":"arxiv.content","type":"clients"}}}},{"id":"10.48550/arxiv.2602.19659","type":"dois","attributes":{"doi":"10.48550/arxiv.2602.19659","identifiers":[{"identifier":"2602.19659","identifierType":"arXiv"}],"creators":[{"nameType":"Personal","givenName":"Daniella Alexandra Crysti Vargas","familyName":"Saldana","name":"Saldana, Daniella Alexandra Crysti Vargas","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Freddy Herrera","familyName":"Cueva","name":"Cueva, Freddy Herrera","affiliation":[],"nameIdentifiers":[]}],"titles":[{"title":"Curiosity Over Hype: Modeling Motivation Language to Understand Early Outcomes in a Selective Quantum Track"}],"publisher":"arXiv","container":{},"publicationYear":2026,"subjects":[{"subject":"Physics Education (physics.ed-ph)","lang":"en","subjectScheme":"arXiv"},{"subject":"Quantum Physics (quant-ph)","lang":"en","subjectScheme":"arXiv"},{"subject":"FOS: Physical sciences","subjectScheme":"Fields of Science and Technology (FOS)"},{"schemeUri":"http://www.oecd.org/science/inno/38235147.pdf","subject":"FOS: Physical sciences","subjectScheme":"Fields of Science and Technology (FOS)"}],"contributors":[],"dates":[{"date":"2026-02-23T10:09:05Z","dateType":"Submitted","dateInformation":"v1"},{"date":"2026-02-24T02:18:37Z","dateType":"Updated","dateInformation":"v1"},{"date":"2026-02","dateType":"Available","dateInformation":"v1"},{"date":"2026","dateType":"Issued"}],"language":null,"types":{"schemaOrg":"CreativeWork","resourceTypeGeneral":"Preprint","citeproc":"article","bibtex":"misc","ris":"GEN","resourceType":"Article"},"relatedIdentifiers":[{"relationType":"IsVersionOf","relatedIdentifier":"10.1109/icalter69698.2025.11355072","relatedIdentifierType":"DOI"}],"relatedItems":[],"sizes":[],"formats":[],"version":"1","rightsList":[{"rightsUri":"http://arxiv.org/licenses/nonexclusive-distrib/1.0/","rights":"arXiv.org perpetual, non-exclusive license"}],"descriptions":[{"descriptionType":"Abstract","description":"We study whether latent motivation signals in short Spanish admission responses predict engagement and performance in an early quantum computing pathway run by QuantumHub Peru. We analyze N=241 applicants' open responses and link them to outcomes from two selective modules: Module 1 (secondary; mathematics and computing foundations; n=23) and Module 2 (secondary + early undergraduate; quantum fundamentals; n=36, including M1 continuers). To ensure baseline comparability, the M2 university entrance exam matched the difficulty of the M1 final. Final grades followed the program's official cohort-specific weightings (attendance/assignments/exam), which we retain to preserve ecological validity. Methodologically, we model text with Latent Dirichlet Allocation (LDA, k=8) and, for robustness, with sentence embeddings from a small multilingual language model, EmbeddingGemma-300M, projected via UMAP and clustered with HDBSCAN. This combination leverages the transparency of bag-of-words topics and the semantic richness of small language model embeddings. Descriptively, curiosity/learning topics show higher grades and attendance than technology/career-oriented topics; inferential tests are underpowered (e.g., linear R2 ~ 0.03; logistic pseudo-R2 ~ 0.04) so effect-size estimates should be viewed as preliminary rather than confirmatory. Embedding-based clustering yields seven clusters with 11.2% noise and modest agreement with LDA (ARI=0.068; NMI=0.163). Results suggest that brief motivation responses encode promising signals that could support early mentoring in rigorous STEM pipelines, while highlighting the need for larger, pre-registered studies."},{"descriptionType":"Other","description":"Published in the Proceedings of IEEE ICALTER 2025. 5 pages, 7 figures"}],"geoLocations":[],"fundingReferences":[],"url":"https://arxiv.org/abs/2602.19659","contentUrl":null,"metadataVersion":0,"schemaVersion":"http://datacite.org/schema/kernel-4","source":"mds","isActive":true,"state":"findable","reason":null,"viewCount":0,"downloadCount":0,"referenceCount":0,"citationCount":0,"partCount":0,"partOfCount":0,"versionCount":0,"versionOfCount":1,"created":"2026-02-25T15:09:34Z","registered":"2026-02-25T15:09:34Z","published":null,"updated":"2026-02-25T15:09:34Z"},"relationships":{"client":{"data":{"id":"arxiv.content","type":"clients"}}}},{"id":"10.48550/arxiv.2602.19658","type":"dois","attributes":{"doi":"10.48550/arxiv.2602.19658","identifiers":[{"identifier":"2602.19658","identifierType":"arXiv"}],"creators":[{"nameType":"Personal","givenName":"Kim","familyName":"Christensen","name":"Christensen, Kim","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Mark","familyName":"Podolskij","name":"Podolskij, Mark","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Mathias","familyName":"Vetter","name":"Vetter, Mathias","affiliation":[],"nameIdentifiers":[]}],"titles":[{"title":"On covariation estimation for multivariate continuous Itô semimartingales with noise in non-synchronous observation schemes"}],"publisher":"arXiv","container":{},"publicationYear":2026,"subjects":[{"subject":"Econometrics (econ.EM)","lang":"en","subjectScheme":"arXiv"},{"subject":"FOS: Economics and business","subjectScheme":"Fields of Science and Technology (FOS)"},{"schemeUri":"http://www.oecd.org/science/inno/38235147.pdf","subject":"FOS: Economics and business","subjectScheme":"Fields of Science and Technology (FOS)"}],"contributors":[],"dates":[{"date":"2026-02-23T10:07:22Z","dateType":"Submitted","dateInformation":"v1"},{"date":"2026-02-24T02:18:36Z","dateType":"Updated","dateInformation":"v1"},{"date":"2026-02","dateType":"Available","dateInformation":"v1"},{"date":"2026","dateType":"Issued"}],"language":null,"types":{"schemaOrg":"CreativeWork","resourceTypeGeneral":"Preprint","citeproc":"article","bibtex":"misc","ris":"GEN","resourceType":"Article"},"relatedIdentifiers":[{"relationType":"IsVersionOf","relatedIdentifier":"10.1016/j.jmva.2013.05.002","relatedIdentifierType":"DOI"}],"relatedItems":[],"sizes":[],"formats":[],"version":"1","rightsList":[{"rightsUri":"http://arxiv.org/licenses/nonexclusive-distrib/1.0/","rights":"arXiv.org perpetual, non-exclusive license"}],"descriptions":[{"descriptionType":"Abstract","description":"This paper presents a Hayashi-Yoshida type estimator for the covariation matrix of continuous Itô semimartingales observed with noise. The coordinates of the multivariate process are assumed to be observed at highly frequent non-synchronous points. The estimator of the covariation matrix is designed via a certain combination of the local averages and the Hayashi-Yoshida estimator. Our method does not require any synchronization of the observation scheme (as e.g. previous tick method or refreshing time method) and it is robust to some dependence structure of the noise process. We show the associated central limit theorem for the proposed estimator and provide a feasible asymptotic result. Our proofs are based on a blocking technique and a stable convergence theorem for semimartingales. Finally, we show simulation results for the proposed estimator to illustrate its finite sample properties."}],"geoLocations":[],"fundingReferences":[],"url":"https://arxiv.org/abs/2602.19658","contentUrl":null,"metadataVersion":0,"schemaVersion":"http://datacite.org/schema/kernel-4","source":"mds","isActive":true,"state":"findable","reason":null,"viewCount":0,"downloadCount":0,"referenceCount":0,"citationCount":0,"partCount":0,"partOfCount":0,"versionCount":0,"versionOfCount":1,"created":"2026-02-25T15:09:31Z","registered":"2026-02-25T15:09:32Z","published":null,"updated":"2026-02-25T15:09:32Z"},"relationships":{"client":{"data":{"id":"arxiv.content","type":"clients"}}}},{"id":"10.48550/arxiv.2602.19657","type":"dois","attributes":{"doi":"10.48550/arxiv.2602.19657","identifiers":[{"identifier":"2602.19657","identifierType":"arXiv"}],"creators":[{"nameType":"Personal","givenName":"Duncan","familyName":"Adamson","name":"Adamson, Duncan","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Paul G","familyName":"Spirakis","name":"Spirakis, Paul G","affiliation":[],"nameIdentifiers":[]}],"titles":[{"title":"Exploration of Always $S$-Connected Temporal Graphs"}],"publisher":"arXiv","container":{},"publicationYear":2026,"subjects":[{"subject":"Data Structures and Algorithms (cs.DS)","lang":"en","subjectScheme":"arXiv"},{"subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"},{"schemeUri":"http://www.oecd.org/science/inno/38235147.pdf","subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"}],"contributors":[],"dates":[{"date":"2026-02-23T10:04:14Z","dateType":"Submitted","dateInformation":"v1"},{"date":"2026-02-24T02:18:28Z","dateType":"Updated","dateInformation":"v1"},{"date":"2026-02","dateType":"Available","dateInformation":"v1"},{"date":"2026","dateType":"Issued"}],"language":null,"types":{"schemaOrg":"CreativeWork","resourceTypeGeneral":"Preprint","citeproc":"article","bibtex":"misc","ris":"GEN","resourceType":"Article"},"relatedIdentifiers":[],"relatedItems":[],"sizes":[],"formats":[],"version":"1","rightsList":[{"rightsIdentifierScheme":"SPDX","rightsUri":"https://creativecommons.org/licenses/by/4.0/legalcode","schemeUri":"https://spdx.org/licenses/","rights":"Creative Commons Attribution 4.0 International","rightsIdentifier":"cc-by-4.0"}],"descriptions":[{"descriptionType":"Abstract","description":"\\emph{Temporal graphs} are a generalisation of (static) graphs, defined by a sequence of \\emph{snapshots}, each a static graph defined over a common set of vertices. \\emph{Exploration} problems are one of the most fundamental and most heavily studied problems on temporal graphs, asking if a set of $m$ agents can visit every vertex in the graph, with each agent only allowed to traverse a single edge per snapshot. In this paper, we introduce and study \\emph{always $S$-connected} temporal graphs, a generalisation of always connected temporal graphs where, rather than forming a single connected component in each snapshot, we have at most $\\vert S \\vert$ components, each defined by the connection to a single vertex in the set $S$. We use this formulation as a tool for exploring graphs admitting an \\emph{$(r,b)$-division}, a partitioning of the vertex set into disconnected components, each of which is $S$-connected, where $\\vert S \\vert \\leq b$.\n We show that an always $S$-connected temporal graph with $m = \\vert S \\vert$ and an average degree of $Δ$ can be explored by $m$ agents in $O(n^{1.5} m^3 Δ^{1.5}\\log^{1.5}(n))$ snapshots. Using this as a subroutine, we show that any always-connected temporal graph with treewidth at most $k$ can be explored by a single agent in $O\\left(n^{4/3} k^{5.5}\\log^{2.5}(n)\\right)$ snapshots, improving on the current state-of-the-art for small values of $k$. Further, we show that interval graph with only a small number of large cliques can be explored by a single agent in $O\\left(n^{4/3} \\log^{2.5}(n)\\right)$ snapshots."}],"geoLocations":[],"fundingReferences":[],"url":"https://arxiv.org/abs/2602.19657","contentUrl":null,"metadataVersion":0,"schemaVersion":"http://datacite.org/schema/kernel-4","source":"mds","isActive":true,"state":"findable","reason":null,"viewCount":0,"downloadCount":0,"referenceCount":0,"citationCount":1,"partCount":0,"partOfCount":0,"versionCount":0,"versionOfCount":0,"created":"2026-02-25T15:09:29Z","registered":"2026-02-25T15:09:29Z","published":null,"updated":"2026-02-25T15:09:30Z"},"relationships":{"client":{"data":{"id":"arxiv.content","type":"clients"}}}},{"id":"10.48550/arxiv.2602.19655","type":"dois","attributes":{"doi":"10.48550/arxiv.2602.19655","identifiers":[{"identifier":"2602.19655","identifierType":"arXiv"}],"creators":[{"nameType":"Personal","givenName":"Vishnu","familyName":"Subramanian","name":"Subramanian, Vishnu","affiliation":[],"nameIdentifiers":[]}],"titles":[{"title":"Representation Stability in a Minimal Continual Learning Agent"}],"publisher":"arXiv","container":{},"publicationYear":2026,"subjects":[{"subject":"Machine Learning (cs.LG)","lang":"en","subjectScheme":"arXiv"},{"subject":"Artificial Intelligence (cs.AI)","lang":"en","subjectScheme":"arXiv"},{"subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"},{"schemeUri":"http://www.oecd.org/science/inno/38235147.pdf","subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"}],"contributors":[],"dates":[{"date":"2026-02-23T09:59:03Z","dateType":"Submitted","dateInformation":"v1"},{"date":"2026-02-24T02:18:25Z","dateType":"Updated","dateInformation":"v1"},{"date":"2026-02","dateType":"Available","dateInformation":"v1"},{"date":"2026","dateType":"Issued"}],"language":null,"types":{"schemaOrg":"CreativeWork","resourceTypeGeneral":"Preprint","citeproc":"article","bibtex":"misc","ris":"GEN","resourceType":"Article"},"relatedIdentifiers":[],"relatedItems":[],"sizes":[],"formats":[],"version":"1","rightsList":[{"rightsIdentifierScheme":"SPDX","rightsUri":"https://creativecommons.org/licenses/by/4.0/legalcode","schemeUri":"https://spdx.org/licenses/","rights":"Creative Commons Attribution 4.0 International","rightsIdentifier":"cc-by-4.0"}],"descriptions":[{"descriptionType":"Abstract","description":"Continual learning systems are increasingly deployed in environments where retraining or reset is infeasible, yet many approaches emphasize task performance rather than the evolution of internal representations over time. In this work, we study a minimal continual learning agent designed to isolate representational dynamics from architectural complexity and optimization objectives. The agent maintains a persistent state vector across executions and incrementally updates it as new textual data is introduced. We quantify representational change using cosine similarity between successive normalized state vectors and define a stability metric over time intervals. Longitudinal experiments across eight executions reveal a transition from an initial plastic regime to a stable representational regime under consistent input. A deliberately introduced semantic perturbation produces a bounded decrease in similarity, followed by recovery and restabilization under subsequent coherent input. These results demonstrate that meaningful stability plasticity tradeoffs can emerge in a minimal, stateful learning system without explicit regularization, replay, or architectural complexity. The work establishes a transparent empirical baseline for studying representational accumulation and adaptation in continual learning systems."},{"descriptionType":"Other","description":"8 pages, 1 figure"}],"geoLocations":[],"fundingReferences":[],"url":"https://arxiv.org/abs/2602.19655","contentUrl":null,"metadataVersion":0,"schemaVersion":"http://datacite.org/schema/kernel-4","source":"mds","isActive":true,"state":"findable","reason":null,"viewCount":0,"downloadCount":0,"referenceCount":0,"citationCount":0,"partCount":0,"partOfCount":0,"versionCount":0,"versionOfCount":0,"created":"2026-02-25T15:09:24Z","registered":"2026-02-25T15:09:25Z","published":null,"updated":"2026-02-25T15:09:25Z"},"relationships":{"client":{"data":{"id":"arxiv.content","type":"clients"}}}},{"id":"10.48550/arxiv.2602.19654","type":"dois","attributes":{"doi":"10.48550/arxiv.2602.19654","identifiers":[{"identifier":"2602.19654","identifierType":"arXiv"}],"creators":[{"nameType":"Personal","givenName":"Rampunit","familyName":"Kumar","name":"Kumar, Rampunit","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Aditya","familyName":"Maheshwari","name":"Maheshwari, Aditya","affiliation":[],"nameIdentifiers":[]}],"titles":[{"title":"NEXUS: A compact neural architecture for high-resolution spatiotemporal air quality forecasting in Delhi National Capital Region"}],"publisher":"arXiv","container":{},"publicationYear":2026,"subjects":[{"subject":"Machine Learning (cs.LG)","lang":"en","subjectScheme":"arXiv"},{"subject":"Artificial Intelligence (cs.AI)","lang":"en","subjectScheme":"arXiv"},{"subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"},{"schemeUri":"http://www.oecd.org/science/inno/38235147.pdf","subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"},{"subject":"I.2.1","lang":"en","subjectScheme":"ACM"}],"contributors":[],"dates":[{"date":"2026-02-23T09:56:22Z","dateType":"Submitted","dateInformation":"v1"},{"date":"2026-02-24T02:18:17Z","dateType":"Updated","dateInformation":"v1"},{"date":"2026-02-24T06:53:31Z","dateType":"Submitted","dateInformation":"v2"},{"date":"2026-02-25T01:26:58Z","dateType":"Updated","dateInformation":"v2"},{"date":"2026-02","dateType":"Available","dateInformation":"v1"},{"date":"2026","dateType":"Issued"}],"language":null,"types":{"schemaOrg":"CreativeWork","resourceTypeGeneral":"Preprint","citeproc":"article","bibtex":"misc","ris":"GEN","resourceType":"Article"},"relatedIdentifiers":[],"relatedItems":[],"sizes":[],"formats":[],"version":"2","rightsList":[{"rightsIdentifierScheme":"SPDX","rightsUri":"https://creativecommons.org/licenses/by-nc-nd/4.0/legalcode","schemeUri":"https://spdx.org/licenses/","rights":"Creative Commons Attribution Non Commercial No Derivatives 4.0 International","rightsIdentifier":"cc-by-nc-nd-4.0"}],"descriptions":[{"descriptionType":"Abstract","description":"Urban air pollution in megacities poses critical public health challenges, particularly in Delhi National Capital Region (NCR) where severe degradation affects millions. We present NEXUS (Neural Extraction and Unified Spatiotemporal) architecture for forecasting carbon monoxide, nitrogen oxide, and sulfur dioxide. Working with four years (2018--2021) of atmospheric data across sixteen spatial grids, NEXUS achieves R$^2$ exceeding 0.94 for CO, 0.91 for NO, and 0.95 for SO$_2$ using merely 18,748 parameters -- substantially fewer than SCINet (35,552), Autoformer (68,704), and FEDformer (298,080). The architecture integrates patch embedding, low-rank projections, and adaptive fusion mechanisms to decode complex atmospheric chemistry patterns. Our investigation uncovers distinct diurnal rhythms and pronounced seasonal variations, with winter months experiencing severe pollution episodes driven by temperature inversions and agricultural biomass burning. Analysis identifies critical meteorological thresholds, quantifies wind field impacts on pollutant dispersion, and maps spatial heterogeneity across the region. Extensive ablation experiments demonstrate each architectural component's role. NEXUS delivers superior predictive performance with remarkable computational efficiency, enabling real-time deployment for air quality monitoring systems."},{"descriptionType":"Other","description":"18 pages"}],"geoLocations":[],"fundingReferences":[],"url":"https://arxiv.org/abs/2602.19654","contentUrl":null,"metadataVersion":0,"schemaVersion":"http://datacite.org/schema/kernel-4","source":"mds","isActive":true,"state":"findable","reason":null,"viewCount":0,"downloadCount":0,"referenceCount":0,"citationCount":0,"partCount":0,"partOfCount":0,"versionCount":0,"versionOfCount":0,"created":"2026-02-25T15:09:21Z","registered":"2026-02-25T15:09:22Z","published":null,"updated":"2026-02-25T15:09:22Z"},"relationships":{"client":{"data":{"id":"arxiv.content","type":"clients"}}}},{"id":"10.48550/arxiv.2602.19652","type":"dois","attributes":{"doi":"10.48550/arxiv.2602.19652","identifiers":[{"identifier":"2602.19652","identifierType":"arXiv"}],"creators":[{"nameType":"Personal","givenName":"Wouter","familyName":"Jansen","name":"Jansen, Wouter","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Jan","familyName":"Steckel","name":"Steckel, Jan","affiliation":[],"nameIdentifiers":[]}],"titles":[{"title":"Hardware-Accelerated Geometrical Simulation of Biological and Engineered In-Air Ultrasonic Systems"}],"publisher":"arXiv","container":{},"publicationYear":2026,"subjects":[{"subject":"Signal Processing (eess.SP)","lang":"en","subjectScheme":"arXiv"},{"subject":"FOS: Electrical engineering, electronic engineering, information engineering","subjectScheme":"Fields of Science and Technology (FOS)"},{"schemeUri":"http://www.oecd.org/science/inno/38235147.pdf","subject":"FOS: Electrical engineering, electronic engineering, information engineering","subjectScheme":"Fields of Science and Technology (FOS)"}],"contributors":[],"dates":[{"date":"2026-02-23T09:53:55Z","dateType":"Submitted","dateInformation":"v1"},{"date":"2026-02-24T02:18:12Z","dateType":"Updated","dateInformation":"v1"},{"date":"2026-02","dateType":"Available","dateInformation":"v1"},{"date":"2026","dateType":"Issued"}],"language":null,"types":{"schemaOrg":"CreativeWork","resourceTypeGeneral":"Preprint","citeproc":"article","bibtex":"misc","ris":"GEN","resourceType":"Article"},"relatedIdentifiers":[],"relatedItems":[],"sizes":[],"formats":[],"version":"1","rightsList":[{"rightsIdentifierScheme":"SPDX","rightsUri":"https://creativecommons.org/licenses/by-nc-nd/4.0/legalcode","schemeUri":"https://spdx.org/licenses/","rights":"Creative Commons Attribution Non Commercial No Derivatives 4.0 International","rightsIdentifier":"cc-by-nc-nd-4.0"}],"descriptions":[{"descriptionType":"Abstract","description":"The deployment of in-air acoustic sensors for industrial monitoring and autonomous robotics has grown significantly, often drawing inspiration from biological echolocation. However, developing and validating these systems in existing simulation frameworks remains challenging due to the computational cost of simulating high-frequency wave propagation in large, dynamic, and complex environments. While wave-based methods offer high accuracy, they scale poorly with frequency and volume. Conversely, existing geometric acoustic solvers often lack support for dynamic scenes, complex diffraction, or closed-loop robotic integration. In this work, we introduce SonoTraceUE, a high-fidelity acoustic simulation framework built as a plugin for Unreal Engine. By using a hardware-accelerated ray tracing-based specular reflection model, and a curvature-based Monte Carlo diffraction model, the system enables near real-time simulation of active and passive acoustic sensing in dynamic, multi-material environments. We validate the framework through two distinct experimental domains: a bioacoustic study and a robotics experiment. Our results demonstrate that SonoTraceUE achieves high correlation with real-world spectral and spatial data. The framework provides a versatile platform for synthetic data generation, hypothesis testing in bioacoustics, and the rapid prototyping of closed-loop robotic systems that use acoustic sensing."}],"geoLocations":[],"fundingReferences":[],"url":"https://arxiv.org/abs/2602.19652","contentUrl":null,"metadataVersion":0,"schemaVersion":"http://datacite.org/schema/kernel-4","source":"mds","isActive":true,"state":"findable","reason":null,"viewCount":0,"downloadCount":0,"referenceCount":0,"citationCount":0,"partCount":0,"partOfCount":0,"versionCount":0,"versionOfCount":0,"created":"2026-02-25T15:09:17Z","registered":"2026-02-25T15:09:17Z","published":null,"updated":"2026-02-25T15:09:17Z"},"relationships":{"client":{"data":{"id":"arxiv.content","type":"clients"}}}},{"id":"10.48550/arxiv.2602.19649","type":"dois","attributes":{"doi":"10.48550/arxiv.2602.19649","identifiers":[{"identifier":"2602.19649","identifierType":"arXiv"}],"creators":[{"nameType":"Personal","givenName":"Gabriel","familyName":"Bathie","name":"Bathie, Gabriel","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Paul","familyName":"Huber","name":"Huber, Paul","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Guillaume","familyName":"Lagarde","name":"Lagarde, Guillaume","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Akka","familyName":"Zemmari","name":"Zemmari, Akka","affiliation":[],"nameIdentifiers":[]}],"titles":[{"title":"Analyzing and Leveraging the $k$-Sensitivity of LZ77"}],"publisher":"arXiv","container":{},"publicationYear":2026,"subjects":[{"subject":"Data Structures and Algorithms (cs.DS)","lang":"en","subjectScheme":"arXiv"},{"subject":"Computational Complexity (cs.CC)","lang":"en","subjectScheme":"arXiv"},{"subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"},{"schemeUri":"http://www.oecd.org/science/inno/38235147.pdf","subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"}],"contributors":[],"dates":[{"date":"2026-02-23T09:50:49Z","dateType":"Submitted","dateInformation":"v1"},{"date":"2026-02-24T02:18:09Z","dateType":"Updated","dateInformation":"v1"},{"date":"2026-02","dateType":"Available","dateInformation":"v1"},{"date":"2026","dateType":"Issued"}],"language":null,"types":{"schemaOrg":"CreativeWork","resourceTypeGeneral":"Preprint","citeproc":"article","bibtex":"misc","ris":"GEN","resourceType":"Article"},"relatedIdentifiers":[],"relatedItems":[],"sizes":[],"formats":[],"version":"1","rightsList":[{"rightsIdentifierScheme":"SPDX","rightsUri":"https://creativecommons.org/licenses/by/4.0/legalcode","schemeUri":"https://spdx.org/licenses/","rights":"Creative Commons Attribution 4.0 International","rightsIdentifier":"cc-by-4.0"}],"descriptions":[{"descriptionType":"Abstract","description":"We study the sensitivity of the Lempel-Ziv 77 compression algorithm to edits, showing how modifying a string $w$ can deteriorate or improve its compression. Our first result is a tight upper bound for $k$ edits: $\\forall w' \\in B(w,k)$, we have $C_{\\mathrm{LZ77}}(w') \\leq 3 \\cdot C_{\\mathrm{LZ77}}(w) + 4k$. This result contrasts with Lempel-Ziv 78, where a single edit can significantly deteriorate compressibility, a phenomenon known as a *one-bit catastrophe*.\n We further refine this bound, focusing on the coefficient $3$ in front of $C_{\\mathrm{LZ77}}(w)$, and establish a surprising trichotomy based on the compressibility of $w$. More precisely we prove the following bounds:\n - if $C_{\\mathrm{LZ77}}(w) \\lesssim k^{3/2}\\sqrt{n}$, the compression may increase by up to a factor of $\\approx 3$,\n - if $k^{3/2}\\sqrt{n} \\lesssim C_{\\mathrm{LZ77}}(w) \\lesssim k^{1/3}n^{2/3}$, this factor is at most $\\approx 2$,\n - if $C_{\\mathrm{LZ77}}(w) \\gtrsim k^{1/3}n^{2/3}$, the factor is at most $\\approx 1$.\n Finally, we present an $\\varepsilon$-approximation algorithm to pre-edit a word $w$ with a budget of $k$ modifications to improve its compression. In favorable scenarios, this approach yields a total compressed size reduction by up to a factor of~$3$, accounting for both the LZ77 compression of the modified word and the cost of storing the edits, $C_{\\mathrm{LZ77}}(w') + k \\log |w|$."}],"geoLocations":[],"fundingReferences":[],"url":"https://arxiv.org/abs/2602.19649","contentUrl":null,"metadataVersion":0,"schemaVersion":"http://datacite.org/schema/kernel-4","source":"mds","isActive":true,"state":"findable","reason":null,"viewCount":0,"downloadCount":0,"referenceCount":0,"citationCount":0,"partCount":0,"partOfCount":0,"versionCount":0,"versionOfCount":0,"created":"2026-02-25T15:09:09Z","registered":"2026-02-25T15:09:10Z","published":null,"updated":"2026-02-25T15:09:10Z"},"relationships":{"client":{"data":{"id":"arxiv.content","type":"clients"}}}},{"id":"10.48550/arxiv.2602.19648","type":"dois","attributes":{"doi":"10.48550/arxiv.2602.19648","identifiers":[{"identifier":"2602.19648","identifierType":"arXiv"}],"creators":[{"nameType":"Personal","givenName":"Giuseppe","familyName":"Gismondi","name":"Gismondi, Giuseppe","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Rebecca","familyName":"Rivieccio","name":"Rivieccio, Rebecca","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Giuseppe","familyName":"Pandolfo","name":"Pandolfo, Giuseppe","affiliation":[],"nameIdentifiers":[]}],"titles":[{"title":"Local depth-based classification of directional data"}],"publisher":"arXiv","container":{},"publicationYear":2026,"subjects":[{"subject":"Methodology (stat.ME)","lang":"en","subjectScheme":"arXiv"},{"subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"},{"schemeUri":"http://www.oecd.org/science/inno/38235147.pdf","subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"}],"contributors":[],"dates":[{"date":"2026-02-23T09:47:12Z","dateType":"Submitted","dateInformation":"v1"},{"date":"2026-02-24T02:18:05Z","dateType":"Updated","dateInformation":"v1"},{"date":"2026-02","dateType":"Available","dateInformation":"v1"},{"date":"2026","dateType":"Issued"}],"language":null,"types":{"schemaOrg":"CreativeWork","resourceTypeGeneral":"Preprint","citeproc":"article","bibtex":"misc","ris":"GEN","resourceType":"Article"},"relatedIdentifiers":[],"relatedItems":[],"sizes":[],"formats":[],"version":"1","rightsList":[{"rightsIdentifierScheme":"SPDX","rightsUri":"https://creativecommons.org/licenses/by/4.0/legalcode","schemeUri":"https://spdx.org/licenses/","rights":"Creative Commons Attribution 4.0 International","rightsIdentifier":"cc-by-4.0"}],"descriptions":[{"descriptionType":"Abstract","description":"Directional data arise in many applications where observations are naturally represented as unit vectors or as observations on the surface of a unit hypersphere. In this context, statistical depth functions provide a center--outward ordering of the data. This work aims at proposing the use of a local notion of data depth function to be applied in the DD-plot (Depth vs. Depth plot) to classify directional data. The proposed method is investigated through an extensive simulation study and two real-data examples."}],"geoLocations":[],"fundingReferences":[],"url":"https://arxiv.org/abs/2602.19648","contentUrl":null,"metadataVersion":0,"schemaVersion":"http://datacite.org/schema/kernel-4","source":"mds","isActive":true,"state":"findable","reason":null,"viewCount":0,"downloadCount":0,"referenceCount":0,"citationCount":0,"partCount":0,"partOfCount":0,"versionCount":0,"versionOfCount":0,"created":"2026-02-25T15:09:07Z","registered":"2026-02-25T15:09:07Z","published":null,"updated":"2026-02-25T15:09:07Z"},"relationships":{"client":{"data":{"id":"arxiv.content","type":"clients"}}}},{"id":"10.48550/arxiv.2602.19646","type":"dois","attributes":{"doi":"10.48550/arxiv.2602.19646","identifiers":[{"identifier":"2602.19646","identifierType":"arXiv"}],"creators":[{"nameType":"Personal","givenName":"Marius","familyName":"Fischer","name":"Fischer, Marius","affiliation":[],"nameIdentifiers":[]}],"titles":[{"title":"$L^4$-norms of automorphic forms in the depth aspect"}],"publisher":"arXiv","container":{},"publicationYear":2026,"subjects":[{"subject":"Number Theory (math.NT)","lang":"en","subjectScheme":"arXiv"},{"subject":"FOS: Mathematics","subjectScheme":"Fields of Science and Technology (FOS)"},{"schemeUri":"http://www.oecd.org/science/inno/38235147.pdf","subject":"FOS: Mathematics","subjectScheme":"Fields of Science and Technology (FOS)"},{"subject":"Primary 11F41, Secondary 11F70, 11S80","lang":"en","subjectScheme":"MSC"}],"contributors":[],"dates":[{"date":"2026-02-23T09:44:59Z","dateType":"Submitted","dateInformation":"v1"},{"date":"2026-02-24T02:18:02Z","dateType":"Updated","dateInformation":"v1"},{"date":"2026-02","dateType":"Available","dateInformation":"v1"},{"date":"2026","dateType":"Issued"}],"language":null,"types":{"schemaOrg":"CreativeWork","resourceTypeGeneral":"Preprint","citeproc":"article","bibtex":"misc","ris":"GEN","resourceType":"Article"},"relatedIdentifiers":[],"relatedItems":[],"sizes":[],"formats":[],"version":"1","rightsList":[{"rightsUri":"http://arxiv.org/licenses/nonexclusive-distrib/1.0/","rights":"arXiv.org perpetual, non-exclusive license"}],"descriptions":[{"descriptionType":"Abstract","description":"Let $p$ be an odd prime, and suppose $f$ is an $L^2$-normalised newform for $Γ_0(p^n)$ with bounded spectral parameters and trivial central character. We prove the optimal $L^4$-norm bound $\\lVert f \\rVert_4 \\ll_{p,\\varepsilon}(p^{n})^\\varepsilon $ for all $\\varepsilon \u0026gt;0$ as $n \\rightarrow \\infty$."},{"descriptionType":"Other","description":"51 pages"}],"geoLocations":[],"fundingReferences":[],"url":"https://arxiv.org/abs/2602.19646","contentUrl":null,"metadataVersion":0,"schemaVersion":"http://datacite.org/schema/kernel-4","source":"mds","isActive":true,"state":"findable","reason":null,"viewCount":0,"downloadCount":0,"referenceCount":0,"citationCount":0,"partCount":0,"partOfCount":0,"versionCount":0,"versionOfCount":0,"created":"2026-02-25T15:09:02Z","registered":"2026-02-25T15:09:02Z","published":null,"updated":"2026-02-25T15:09:02Z"},"relationships":{"client":{"data":{"id":"arxiv.content","type":"clients"}}}},{"id":"10.48550/arxiv.2602.19645","type":"dois","attributes":{"doi":"10.48550/arxiv.2602.19645","identifiers":[{"identifier":"2602.19645","identifierType":"arXiv"}],"creators":[{"nameType":"Personal","givenName":"Kim","familyName":"Christensen","name":"Christensen, Kim","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Silja","familyName":"Kinnebrock","name":"Kinnebrock, Silja","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Mark","familyName":"Podolskij","name":"Podolskij, Mark","affiliation":[],"nameIdentifiers":[]}],"titles":[{"title":"Pre-averaging estimators of the ex-post covariance matrix in noisy diffusion models with non-synchronous data"}],"publisher":"arXiv","container":{},"publicationYear":2026,"subjects":[{"subject":"Econometrics (econ.EM)","lang":"en","subjectScheme":"arXiv"},{"subject":"FOS: Economics and business","subjectScheme":"Fields of Science and Technology (FOS)"},{"schemeUri":"http://www.oecd.org/science/inno/38235147.pdf","subject":"FOS: Economics and business","subjectScheme":"Fields of Science and Technology (FOS)"}],"contributors":[],"dates":[{"date":"2026-02-23T09:43:18Z","dateType":"Submitted","dateInformation":"v1"},{"date":"2026-02-24T02:17:59Z","dateType":"Updated","dateInformation":"v1"},{"date":"2026-02","dateType":"Available","dateInformation":"v1"},{"date":"2026","dateType":"Issued"}],"language":null,"types":{"schemaOrg":"CreativeWork","resourceTypeGeneral":"Preprint","citeproc":"article","bibtex":"misc","ris":"GEN","resourceType":"Article"},"relatedIdentifiers":[{"relationType":"IsVersionOf","relatedIdentifier":"10.1016/j.jeconom.2010.05.001","relatedIdentifierType":"DOI"}],"relatedItems":[],"sizes":[],"formats":[],"version":"1","rightsList":[{"rightsUri":"http://arxiv.org/licenses/nonexclusive-distrib/1.0/","rights":"arXiv.org perpetual, non-exclusive license"}],"descriptions":[{"descriptionType":"Abstract","description":"We show how pre-averaging can be applied to the problem of measuring the ex-post covariance of financial asset returns under microstructure noise and non-synchronous trading. A pre-averaged realised covariance is proposed, and we present an asymptotic theory for this new estimator, which can be configured to possess an optimal convergence rate or to ensure positive semi-definite covariance matrix estimates. We also derive a noise-robust Hayashi-Yoshida estimator that can be implemented on the original data without prior alignment of prices. We uncover the finite sample properties of our estimators with simulations and illustrate their practical use on high-frequency equity data."}],"geoLocations":[],"fundingReferences":[],"url":"https://arxiv.org/abs/2602.19645","contentUrl":null,"metadataVersion":0,"schemaVersion":"http://datacite.org/schema/kernel-4","source":"mds","isActive":true,"state":"findable","reason":null,"viewCount":0,"downloadCount":0,"referenceCount":0,"citationCount":0,"partCount":0,"partOfCount":0,"versionCount":0,"versionOfCount":1,"created":"2026-02-25T15:08:59Z","registered":"2026-02-25T15:09:00Z","published":null,"updated":"2026-02-25T15:09:00Z"},"relationships":{"client":{"data":{"id":"arxiv.content","type":"clients"}}}},{"id":"10.48550/arxiv.2602.19644","type":"dois","attributes":{"doi":"10.48550/arxiv.2602.19644","identifiers":[{"identifier":"2602.19644","identifierType":"arXiv"}],"creators":[{"nameType":"Personal","givenName":"Pablo Herrero","familyName":"Gómez","name":"Gómez, Pablo Herrero","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Antonio Jimeno","familyName":"Morenilla","name":"Morenilla, Antonio Jimeno","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"David","familyName":"Muñoz-Hernández","name":"Muñoz-Hernández, David","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Higinio Mora","familyName":"Mora","name":"Mora, Higinio Mora","affiliation":[],"nameIdentifiers":[]}],"titles":[{"title":"Spectral Phase Encoding for Quantum Kernel Methods"}],"publisher":"arXiv","container":{},"publicationYear":2026,"subjects":[{"subject":"Machine Learning (cs.LG)","lang":"en","subjectScheme":"arXiv"},{"subject":"Quantum Physics (quant-ph)","lang":"en","subjectScheme":"arXiv"},{"subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"},{"schemeUri":"http://www.oecd.org/science/inno/38235147.pdf","subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"},{"subject":"FOS: Physical sciences","subjectScheme":"Fields of Science and Technology (FOS)"},{"schemeUri":"http://www.oecd.org/science/inno/38235147.pdf","subject":"FOS: Physical sciences","subjectScheme":"Fields of Science and Technology (FOS)"}],"contributors":[],"dates":[{"date":"2026-02-23T09:42:42Z","dateType":"Submitted","dateInformation":"v1"},{"date":"2026-02-24T02:17:58Z","dateType":"Updated","dateInformation":"v1"},{"date":"2026-02","dateType":"Available","dateInformation":"v1"},{"date":"2026","dateType":"Issued"}],"language":null,"types":{"schemaOrg":"CreativeWork","resourceTypeGeneral":"Preprint","citeproc":"article","bibtex":"misc","ris":"GEN","resourceType":"Article"},"relatedIdentifiers":[],"relatedItems":[],"sizes":[],"formats":[],"version":"1","rightsList":[{"rightsUri":"http://arxiv.org/licenses/nonexclusive-distrib/1.0/","rights":"arXiv.org perpetual, non-exclusive license"}],"descriptions":[{"descriptionType":"Abstract","description":"Quantum kernel methods are promising for near-term quantum ma- chine learning, yet their behavior under data corruption remains insuf- ficiently understood. We analyze how quantum feature constructions degrade under controlled additive noise. We introduce Spectral Phase Encoding (SPE), a hybrid construc- tion combining a discrete Fourier transform (DFT) front-end with a diagonal phase-only embedding aligned with the geometry of diagonal quantum maps. Within a unified framework, we compare QK-DFT against alternative quantum variants (QK-PCA, QK-RP) and classi- cal SVM baselines under identical clean-data hyperparameter selection, quantifying robustness via dataset fixed-effects regression with wild cluster bootstrap inference across heterogeneous real-world datasets. Across the quantum family, DFT-based preprocessing yields the smallest degradation rate as noise increases, with statistically sup- ported slope differences relative to PCA and RP. Compared to classical baselines, QK-DFT shows degradation comparable to linear SVM and more stable than RBF SVM under matched tuning. Hardware exper- iments confirm that SPE remains executable and numerically stable for overlap estimation. These results indicate that robustness in quan- tum kernels depends critically on structure-aligned preprocessing and its interaction with diagonal embeddings, supporting a robustness-first perspective for NISQ-era quantum machine learning."}],"geoLocations":[],"fundingReferences":[],"url":"https://arxiv.org/abs/2602.19644","contentUrl":null,"metadataVersion":0,"schemaVersion":"http://datacite.org/schema/kernel-4","source":"mds","isActive":true,"state":"findable","reason":null,"viewCount":0,"downloadCount":0,"referenceCount":0,"citationCount":0,"partCount":0,"partOfCount":0,"versionCount":0,"versionOfCount":0,"created":"2026-02-25T15:08:57Z","registered":"2026-02-25T15:08:57Z","published":null,"updated":"2026-02-25T15:08:57Z"},"relationships":{"client":{"data":{"id":"arxiv.content","type":"clients"}}}},{"id":"10.48550/arxiv.2602.19643","type":"dois","attributes":{"doi":"10.48550/arxiv.2602.19643","identifiers":[{"identifier":"2602.19643","identifierType":"arXiv"}],"creators":[{"nameType":"Personal","givenName":"Alex","familyName":"Robertson","name":"Robertson, Alex","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Huizhi","familyName":"Liang","name":"Liang, Huizhi","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Mahbub","familyName":"Gani","name":"Gani, Mahbub","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Rohit","familyName":"Kumar","name":"Kumar, Rohit","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Srijith","familyName":"Rajamohan","name":"Rajamohan, Srijith","affiliation":[],"nameIdentifiers":[]}],"titles":[{"title":"KGHaluBench: A Knowledge Graph-Based Hallucination Benchmark for Evaluating the Breadth and Depth of LLM Knowledge"}],"publisher":"arXiv","container":{},"publicationYear":2026,"subjects":[{"subject":"Computation and Language (cs.CL)","lang":"en","subjectScheme":"arXiv"},{"subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"},{"schemeUri":"http://www.oecd.org/science/inno/38235147.pdf","subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"}],"contributors":[],"dates":[{"date":"2026-02-23T09:41:46Z","dateType":"Submitted","dateInformation":"v1"},{"date":"2026-02-24T02:17:57Z","dateType":"Updated","dateInformation":"v1"},{"date":"2026-02","dateType":"Available","dateInformation":"v1"},{"date":"2026","dateType":"Issued"}],"language":null,"types":{"schemaOrg":"CreativeWork","resourceTypeGeneral":"Preprint","citeproc":"article","bibtex":"misc","ris":"GEN","resourceType":"Article"},"relatedIdentifiers":[],"relatedItems":[],"sizes":[],"formats":[],"version":"1","rightsList":[{"rightsIdentifierScheme":"SPDX","rightsUri":"https://creativecommons.org/licenses/by/4.0/legalcode","schemeUri":"https://spdx.org/licenses/","rights":"Creative Commons Attribution 4.0 International","rightsIdentifier":"cc-by-4.0"}],"descriptions":[{"descriptionType":"Abstract","description":"Large Language Models (LLMs) possess a remarkable capacity to generate persuasive and intelligible language. However, coherence does not equate to truthfulness, as the responses often contain subtle hallucinations. Existing benchmarks are limited by static and narrow questions, leading to limited coverage and misleading evaluations. We present KGHaluBench, a Knowledge Graph-based hallucination benchmark that assesses LLMs across the breadth and depth of their knowledge, providing a fairer and more comprehensive insight into LLM truthfulness. Our framework utilises the KG to dynamically construct challenging, multifaceted questions, whose difficulty is then statistically estimated to address popularity bias. Our automated verification pipeline detects abstentions and verifies the LLM's response at both conceptual and correctness levels to identify different types of hallucinations. We evaluate 25 frontier models, using novel accuracy and hallucination metrics. The results provide a more interpretable insight into the knowledge factors that cause hallucinations across different model sizes. KGHaluBench is publicly available to support future developments in hallucination mitigation."},{"descriptionType":"Other","description":"EACL 2026 Findings"}],"geoLocations":[],"fundingReferences":[],"url":"https://arxiv.org/abs/2602.19643","contentUrl":null,"metadataVersion":0,"schemaVersion":"http://datacite.org/schema/kernel-4","source":"mds","isActive":true,"state":"findable","reason":null,"viewCount":0,"downloadCount":0,"referenceCount":0,"citationCount":0,"partCount":0,"partOfCount":0,"versionCount":0,"versionOfCount":0,"created":"2026-02-25T15:08:54Z","registered":"2026-02-25T15:08:55Z","published":null,"updated":"2026-02-25T15:08:55Z"},"relationships":{"client":{"data":{"id":"arxiv.content","type":"clients"}}}},{"id":"10.48550/arxiv.2602.19641","type":"dois","attributes":{"doi":"10.48550/arxiv.2602.19641","identifiers":[{"identifier":"2602.19641","identifierType":"arXiv"}],"creators":[{"nameType":"Personal","givenName":"Marvin","familyName":"Chen","name":"Chen, Marvin","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Manuel","familyName":"Eberhardinger","name":"Eberhardinger, Manuel","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Johannes","familyName":"Maucher","name":"Maucher, Johannes","affiliation":[],"nameIdentifiers":[]}],"titles":[{"title":"Evaluating the Impact of Data Anonymization on Image Retrieval"}],"publisher":"arXiv","container":{},"publicationYear":2026,"subjects":[{"subject":"Machine Learning (cs.LG)","lang":"en","subjectScheme":"arXiv"},{"subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"},{"schemeUri":"http://www.oecd.org/science/inno/38235147.pdf","subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"}],"contributors":[],"dates":[{"date":"2026-02-23T09:39:06Z","dateType":"Submitted","dateInformation":"v1"},{"date":"2026-02-24T02:17:52Z","dateType":"Updated","dateInformation":"v1"},{"date":"2026-02","dateType":"Available","dateInformation":"v1"},{"date":"2026","dateType":"Issued"}],"language":null,"types":{"schemaOrg":"CreativeWork","resourceTypeGeneral":"Preprint","citeproc":"article","bibtex":"misc","ris":"GEN","resourceType":"Article"},"relatedIdentifiers":[],"relatedItems":[],"sizes":[],"formats":[],"version":"1","rightsList":[{"rightsUri":"http://arxiv.org/licenses/nonexclusive-distrib/1.0/","rights":"arXiv.org perpetual, non-exclusive license"}],"descriptions":[{"descriptionType":"Abstract","description":"With the growing importance of privacy regulations such as the General Data Protection Regulation, anonymizing visual data is becoming increasingly relevant across institutions. However, anonymization can negatively affect the performance of Computer Vision systems that rely on visual features, such as Content-Based Image Retrieval (CBIR). Despite this, the impact of anonymization on CBIR has not been systematically studied. This work addresses this gap, motivated by the DOKIQ project, an artificial intelligence-based system for document verification actively used by the State Criminal Police Office Baden-Württemberg. We propose a simple evaluation framework: retrieval results after anonymization should match those obtained before anonymization as closely as possible. To this end, we systematically assess the impact of anonymization using two public datasets and the internal DOKIQ dataset. Our experiments span three anonymization methods, four anonymization degrees, and four training strategies, all based on the state of the art backbone Self-Distillation with No Labels (DINO)v2. Our results reveal a pronounced retrieval bias in favor of models trained on original data, which produce the most similar retrievals after anonymization. The findings of this paper offer practical insights for developing privacy-compliant CBIR systems while preserving performance."},{"descriptionType":"Other","description":"Submitted to IEEE Access"}],"geoLocations":[],"fundingReferences":[],"url":"https://arxiv.org/abs/2602.19641","contentUrl":null,"metadataVersion":0,"schemaVersion":"http://datacite.org/schema/kernel-4","source":"mds","isActive":true,"state":"findable","reason":null,"viewCount":0,"downloadCount":0,"referenceCount":0,"citationCount":0,"partCount":0,"partOfCount":0,"versionCount":0,"versionOfCount":0,"created":"2026-02-25T15:08:49Z","registered":"2026-02-25T15:08:50Z","published":null,"updated":"2026-02-25T15:08:50Z"},"relationships":{"client":{"data":{"id":"arxiv.content","type":"clients"}}}},{"id":"10.48550/arxiv.2602.19639","type":"dois","attributes":{"doi":"10.48550/arxiv.2602.19639","identifiers":[{"identifier":"2602.19639","identifierType":"arXiv"}],"creators":[{"nameType":"Personal","givenName":"Made","familyName":"Krisnanda","name":"Krisnanda, Made","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Raymond","familyName":"Chiong","name":"Chiong, Raymond","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Yang","familyName":"Yang","name":"Yang, Yang","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Kirill","familyName":"Glavatskiy","name":"Glavatskiy, Kirill","affiliation":[],"nameIdentifiers":[]}],"titles":[{"title":"Effects of Property Recovery Incentives and Social Interaction on Self-Evacuation Decisions in Natural Disasters: An Agent-Based Modelling Approach"}],"publisher":"arXiv","container":{},"publicationYear":2026,"subjects":[{"subject":"Multiagent Systems (cs.MA)","lang":"en","subjectScheme":"arXiv"},{"subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"},{"schemeUri":"http://www.oecd.org/science/inno/38235147.pdf","subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"}],"contributors":[],"dates":[{"date":"2026-02-23T09:34:06Z","dateType":"Submitted","dateInformation":"v1"},{"date":"2026-02-24T02:17:42Z","dateType":"Updated","dateInformation":"v1"},{"date":"2026-02","dateType":"Available","dateInformation":"v1"},{"date":"2026","dateType":"Issued"}],"language":null,"types":{"schemaOrg":"CreativeWork","resourceTypeGeneral":"Preprint","citeproc":"article","bibtex":"misc","ris":"GEN","resourceType":"Article"},"relatedIdentifiers":[],"relatedItems":[],"sizes":[],"formats":[],"version":"1","rightsList":[{"rightsIdentifierScheme":"SPDX","rightsUri":"https://creativecommons.org/licenses/by/4.0/legalcode","schemeUri":"https://spdx.org/licenses/","rights":"Creative Commons Attribution 4.0 International","rightsIdentifier":"cc-by-4.0"}],"descriptions":[{"descriptionType":"Abstract","description":"Understanding evacuation decision-making behaviour is one of the key components for designing disaster mitigation policies. This study investigates how communications between household agents in a community influence self-evacuation decisions. We develop an agent-based model that simulates household agents' decisions to evacuate or stay. These agents interact within the framework of evolutionary game theory, effectively competing for limited shared resources, which include property recovery funds and coordination services. We explore four scenarios that model different prioritisations of access to government-provided incentives. We discover that the impact of the incentive diminishes both with increasing funding value and the household agent prioritisation, indicating that there is an optimal level of government support beyond which further increases become impractical. Furthermore, the overall evacuation rate depends on the structure of the underlying social network, showing discontinuous jumps when the prioritisation moves across the node degree. We identify the so-called \"community influencers\", prioritisation of whom significantly increases the overall evacuation rate. In contrast, prioritising household agents with low connectivity may actually impede collective evacuation. These findings demonstrate the importance of social connectivity between household agents. The results of this study are useful for designing optimal government policies to incentivise and prioritise community evacuation under limited resources."},{"descriptionType":"Other","description":"21 pages, 9 figures"}],"geoLocations":[],"fundingReferences":[],"url":"https://arxiv.org/abs/2602.19639","contentUrl":null,"metadataVersion":0,"schemaVersion":"http://datacite.org/schema/kernel-4","source":"mds","isActive":true,"state":"findable","reason":null,"viewCount":0,"downloadCount":0,"referenceCount":0,"citationCount":0,"partCount":0,"partOfCount":0,"versionCount":0,"versionOfCount":0,"created":"2026-02-25T15:08:44Z","registered":"2026-02-25T15:08:45Z","published":null,"updated":"2026-02-25T15:08:45Z"},"relationships":{"client":{"data":{"id":"arxiv.content","type":"clients"}}}},{"id":"10.48550/arxiv.2602.19636","type":"dois","attributes":{"doi":"10.48550/arxiv.2602.19636","identifiers":[{"identifier":"2602.19636","identifierType":"arXiv"}],"creators":[{"nameType":"Personal","givenName":"Tiziana","familyName":"Cattai","name":"Cattai, Tiziana","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Stefania","familyName":"Sardellitti","name":"Sardellitti, Stefania","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Stefania","familyName":"Colonnese","name":"Colonnese, Stefania","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Sergio","familyName":"Barbarossa","name":"Barbarossa, Sergio","affiliation":[],"nameIdentifiers":[]}],"titles":[{"title":"Topological Signal Processing for 3D Point Cloud Data"}],"publisher":"arXiv","container":{},"publicationYear":2026,"subjects":[{"subject":"Signal Processing (eess.SP)","lang":"en","subjectScheme":"arXiv"},{"subject":"FOS: Electrical engineering, electronic engineering, information engineering","subjectScheme":"Fields of Science and Technology (FOS)"},{"schemeUri":"http://www.oecd.org/science/inno/38235147.pdf","subject":"FOS: Electrical engineering, electronic engineering, information engineering","subjectScheme":"Fields of Science and Technology (FOS)"}],"contributors":[],"dates":[{"date":"2026-02-23T09:29:19Z","dateType":"Submitted","dateInformation":"v1"},{"date":"2026-02-24T02:17:29Z","dateType":"Updated","dateInformation":"v1"},{"date":"2026-02","dateType":"Available","dateInformation":"v1"},{"date":"2026","dateType":"Issued"}],"language":null,"types":{"schemaOrg":"CreativeWork","resourceTypeGeneral":"Preprint","citeproc":"article","bibtex":"misc","ris":"GEN","resourceType":"Article"},"relatedIdentifiers":[],"relatedItems":[],"sizes":[],"formats":[],"version":"1","rightsList":[{"rightsUri":"http://arxiv.org/licenses/nonexclusive-distrib/1.0/","rights":"arXiv.org perpetual, non-exclusive license"}],"descriptions":[{"descriptionType":"Abstract","description":"Our goal in this paper is to apply the topological signal processing (TSP) framework to the analysis of 3D Point Clouds (PCs) represented on simplicial complexes. Building on Discrete Exterior Calculus (DEC) theory for vector fields, we introduce higher-order Laplacian operators that enable the processing of signals over triangular meshes. Unlike traditional approaches, the proposed approach allows us to characterize both color attributes, modeled as 3D vectors on nodes, and geometry, modeled as 3D vectors on the barycenter of each triangle. Then, we show as TSP tools may efficiently be used to sample, recover and filter PCs attributes treating them as edge signals. Numerical results on synthetic PCs demonstrate accurate color reconstruction with robustness to sparse data and geometry refinement in the case of noisy PC coordinates. The proposed approach provides a topology-based representation to characterize the geometry and attributes of PCs."},{"descriptionType":"Other","description":"ACCEPTED PAPER TO ICASSP 2026 (IEEE International Conference on Acoustics, Speech, and Signal Processing)"}],"geoLocations":[],"fundingReferences":[],"url":"https://arxiv.org/abs/2602.19636","contentUrl":null,"metadataVersion":0,"schemaVersion":"http://datacite.org/schema/kernel-4","source":"mds","isActive":true,"state":"findable","reason":null,"viewCount":0,"downloadCount":0,"referenceCount":0,"citationCount":0,"partCount":0,"partOfCount":0,"versionCount":0,"versionOfCount":0,"created":"2026-02-25T15:08:37Z","registered":"2026-02-25T15:08:37Z","published":null,"updated":"2026-02-25T15:08:37Z"},"relationships":{"client":{"data":{"id":"arxiv.content","type":"clients"}}}},{"id":"10.48550/arxiv.2602.19634","type":"dois","attributes":{"doi":"10.48550/arxiv.2602.19634","identifiers":[{"identifier":"2602.19634","identifierType":"arXiv"}],"creators":[{"nameType":"Personal","givenName":"Jesse","familyName":"Farebrother","name":"Farebrother, Jesse","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Matteo","familyName":"Pirotta","name":"Pirotta, Matteo","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Andrea","familyName":"Tirinzoni","name":"Tirinzoni, Andrea","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Marc G.","familyName":"Bellemare","name":"Bellemare, Marc G.","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Alessandro","familyName":"Lazaric","name":"Lazaric, Alessandro","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Ahmed","familyName":"Touati","name":"Touati, Ahmed","affiliation":[],"nameIdentifiers":[]}],"titles":[{"title":"Compositional Planning with Jumpy World Models"}],"publisher":"arXiv","container":{},"publicationYear":2026,"subjects":[{"subject":"Machine Learning (cs.LG)","lang":"en","subjectScheme":"arXiv"},{"subject":"Artificial Intelligence (cs.AI)","lang":"en","subjectScheme":"arXiv"},{"subject":"Machine Learning (stat.ML)","lang":"en","subjectScheme":"arXiv"},{"subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"},{"schemeUri":"http://www.oecd.org/science/inno/38235147.pdf","subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"}],"contributors":[],"dates":[{"date":"2026-02-23T09:22:21Z","dateType":"Submitted","dateInformation":"v1"},{"date":"2026-02-24T02:17:16Z","dateType":"Updated","dateInformation":"v1"},{"date":"2026-02","dateType":"Available","dateInformation":"v1"},{"date":"2026","dateType":"Issued"}],"language":null,"types":{"schemaOrg":"CreativeWork","resourceTypeGeneral":"Preprint","citeproc":"article","bibtex":"misc","ris":"GEN","resourceType":"Article"},"relatedIdentifiers":[],"relatedItems":[],"sizes":[],"formats":[],"version":"1","rightsList":[{"rightsUri":"http://arxiv.org/licenses/nonexclusive-distrib/1.0/","rights":"arXiv.org perpetual, non-exclusive license"}],"descriptions":[{"descriptionType":"Abstract","description":"The ability to plan with temporal abstractions is central to intelligent decision-making. Rather than reasoning over primitive actions, we study agents that compose pre-trained policies as temporally extended actions, enabling solutions to complex tasks that no constituent alone can solve. Such compositional planning remains elusive as compounding errors in long-horizon predictions make it challenging to estimate the visitation distribution induced by sequencing policies. Motivated by the geometric policy composition framework introduced in arXiv:2206.08736, we address these challenges by learning predictive models of multi-step dynamics -- so-called jumpy world models -- that capture state occupancies induced by pre-trained policies across multiple timescales in an off-policy manner. Building on Temporal Difference Flows (arXiv:2503.09817), we enhance these models with a novel consistency objective that aligns predictions across timescales, improving long-horizon predictive accuracy. We further demonstrate how to combine these generative predictions to estimate the value of executing arbitrary sequences of policies over varying timescales. Empirically, we find that compositional planning with jumpy world models significantly improves zero-shot performance across a wide range of base policies on challenging manipulation and navigation tasks, yielding, on average, a 200% relative improvement over planning with primitive actions on long-horizon tasks."}],"geoLocations":[],"fundingReferences":[],"url":"https://arxiv.org/abs/2602.19634","contentUrl":null,"metadataVersion":0,"schemaVersion":"http://datacite.org/schema/kernel-4","source":"mds","isActive":true,"state":"findable","reason":null,"viewCount":0,"downloadCount":0,"referenceCount":0,"citationCount":0,"partCount":0,"partOfCount":0,"versionCount":0,"versionOfCount":0,"created":"2026-02-25T15:08:32Z","registered":"2026-02-25T15:08:32Z","published":null,"updated":"2026-02-25T15:08:32Z"},"relationships":{"client":{"data":{"id":"arxiv.content","type":"clients"}}}},{"id":"10.48550/arxiv.2602.19633","type":"dois","attributes":{"doi":"10.48550/arxiv.2602.19633","identifiers":[{"identifier":"2602.19633","identifierType":"arXiv"}],"creators":[{"nameType":"Personal","givenName":"Jongwon","familyName":"Jeong","name":"Jeong, Jongwon","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Jungtaek","familyName":"Kim","name":"Kim, Jungtaek","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Kangwook","familyName":"Lee","name":"Lee, Kangwook","affiliation":[],"nameIdentifiers":[]}],"titles":[{"title":"TAPE: Tool-Guided Adaptive Planning and Constrained Execution in Language Model Agents"}],"publisher":"arXiv","container":{},"publicationYear":2026,"subjects":[{"subject":"Artificial Intelligence (cs.AI)","lang":"en","subjectScheme":"arXiv"},{"subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"},{"schemeUri":"http://www.oecd.org/science/inno/38235147.pdf","subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"}],"contributors":[],"dates":[{"date":"2026-02-23T09:19:56Z","dateType":"Submitted","dateInformation":"v1"},{"date":"2026-02-24T02:17:14Z","dateType":"Updated","dateInformation":"v1"},{"date":"2026-02","dateType":"Available","dateInformation":"v1"},{"date":"2026","dateType":"Issued"}],"language":null,"types":{"schemaOrg":"CreativeWork","resourceTypeGeneral":"Preprint","citeproc":"article","bibtex":"misc","ris":"GEN","resourceType":"Article"},"relatedIdentifiers":[],"relatedItems":[],"sizes":[],"formats":[],"version":"1","rightsList":[{"rightsIdentifierScheme":"SPDX","rightsUri":"https://creativecommons.org/licenses/by-nc-nd/4.0/legalcode","schemeUri":"https://spdx.org/licenses/","rights":"Creative Commons Attribution Non Commercial No Derivatives 4.0 International","rightsIdentifier":"cc-by-nc-nd-4.0"}],"descriptions":[{"descriptionType":"Abstract","description":"Language Model (LM) agents have demonstrated remarkable capabilities in solving tasks that require multiple interactions with the environment. However, they remain vulnerable in environments where a single error often leads to irrecoverable failure, particularly under strict feasibility constraints. We systematically analyze existing agent frameworks, identifying imperfect planning and stochastic execution as the primary causes. To address these challenges, we propose Tool-guided Adaptive Planning with constrained Execution (TAPE). TAPE enhances planning capability by aggregating multiple plans into a graph and employing an external solver to identify a feasible path. During execution, TAPE employs constrained decoding to reduce sampling noise, while adaptively re-planning whenever environmental feedback deviates from the intended state. Experiments across Sokoban, ALFWorld, MuSiQue, and GSM8K-Hard demonstrate that TAPE consistently outperforms existing frameworks, with particularly large gains on hard settings, improving success rates by 21.0 percentage points on hard settings on average, and by 20.0 percentage points for weaker base models on average. Code and data available at here."},{"descriptionType":"Other","description":"Preprint"}],"geoLocations":[],"fundingReferences":[],"url":"https://arxiv.org/abs/2602.19633","contentUrl":null,"metadataVersion":0,"schemaVersion":"http://datacite.org/schema/kernel-4","source":"mds","isActive":true,"state":"findable","reason":null,"viewCount":0,"downloadCount":0,"referenceCount":0,"citationCount":0,"partCount":0,"partOfCount":0,"versionCount":0,"versionOfCount":0,"created":"2026-02-25T15:08:29Z","registered":"2026-02-25T15:08:30Z","published":null,"updated":"2026-02-25T15:08:30Z"},"relationships":{"client":{"data":{"id":"arxiv.content","type":"clients"}}}},{"id":"10.48550/arxiv.2602.19632","type":"dois","attributes":{"doi":"10.48550/arxiv.2602.19632","identifiers":[{"identifier":"2602.19632","identifierType":"arXiv"}],"creators":[{"nameType":"Personal","givenName":"Meinolf","familyName":"Geck","name":"Geck, Meinolf","affiliation":[],"nameIdentifiers":[]}],"titles":[{"title":"On Lusztig's canonical bases of simple Lie algebras"}],"publisher":"arXiv","container":{},"publicationYear":2026,"subjects":[{"subject":"Representation Theory (math.RT)","lang":"en","subjectScheme":"arXiv"},{"subject":"FOS: Mathematics","subjectScheme":"Fields of Science and Technology (FOS)"},{"schemeUri":"http://www.oecd.org/science/inno/38235147.pdf","subject":"FOS: Mathematics","subjectScheme":"Fields of Science and Technology (FOS)"},{"subject":"20G40, 17B45","lang":"en","subjectScheme":"MSC"}],"contributors":[],"dates":[{"date":"2026-02-23T09:18:54Z","dateType":"Submitted","dateInformation":"v1"},{"date":"2026-02-24T02:17:13Z","dateType":"Updated","dateInformation":"v1"},{"date":"2026-02","dateType":"Available","dateInformation":"v1"},{"date":"2026","dateType":"Issued"}],"language":null,"types":{"schemaOrg":"CreativeWork","resourceTypeGeneral":"Preprint","citeproc":"article","bibtex":"misc","ris":"GEN","resourceType":"Article"},"relatedIdentifiers":[],"relatedItems":[],"sizes":[],"formats":[],"version":"1","rightsList":[{"rightsUri":"http://arxiv.org/licenses/nonexclusive-distrib/1.0/","rights":"arXiv.org perpetual, non-exclusive license"}],"descriptions":[{"descriptionType":"Abstract","description":"Let $\\mathfrak{g}$ be a simple Lie algebra over~$\\mathbb{C}$ with root system~$Φ$. In the simply laced case, Frenkel and Kac found a particularly simple construction of~$\\mathfrak{g}$, together with a Chevalley basis and explicitly given structure constants, in terms of a certain multiplicative $2$-cocycle $\\varepsilon\\colon \\mathbb{Z} Φ\\times \\mathbb{Z}Φ\\rightarrow\\{\\pm 1\\}$. We show that Lusztig's canonical basis of~$\\mathfrak{g}$ can also be obtained in this way, for a suitable choice of~$\\varepsilon$. We also address the problem of explicitly describing the structure constants when $Φ$ is not simply laced."},{"descriptionType":"Other","description":"23 pages, comments welcome!"}],"geoLocations":[],"fundingReferences":[],"url":"https://arxiv.org/abs/2602.19632","contentUrl":null,"metadataVersion":0,"schemaVersion":"http://datacite.org/schema/kernel-4","source":"mds","isActive":true,"state":"findable","reason":null,"viewCount":0,"downloadCount":0,"referenceCount":0,"citationCount":0,"partCount":0,"partOfCount":0,"versionCount":0,"versionOfCount":0,"created":"2026-02-25T15:08:27Z","registered":"2026-02-25T15:08:28Z","published":null,"updated":"2026-02-25T15:08:28Z"},"relationships":{"client":{"data":{"id":"arxiv.content","type":"clients"}}}},{"id":"10.48550/arxiv.2602.19631","type":"dois","attributes":{"doi":"10.48550/arxiv.2602.19631","identifiers":[{"identifier":"2602.19631","identifierType":"arXiv"}],"creators":[{"nameType":"Personal","givenName":"Uichan","familyName":"Lee","name":"Lee, Uichan","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Jeonghyeon","familyName":"Kim","name":"Kim, Jeonghyeon","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Sangheum","familyName":"Hwang","name":"Hwang, Sangheum","affiliation":[],"nameIdentifiers":[]}],"titles":[{"title":"Localized Concept Erasure in Text-to-Image Diffusion Models via High-Level Representation Misdirection"}],"publisher":"arXiv","container":{},"publicationYear":2026,"subjects":[{"subject":"Computer Vision and Pattern Recognition (cs.CV)","lang":"en","subjectScheme":"arXiv"},{"subject":"Artificial Intelligence (cs.AI)","lang":"en","subjectScheme":"arXiv"},{"subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"},{"schemeUri":"http://www.oecd.org/science/inno/38235147.pdf","subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"}],"contributors":[],"dates":[{"date":"2026-02-23T09:18:27Z","dateType":"Submitted","dateInformation":"v1"},{"date":"2026-02-24T02:17:10Z","dateType":"Updated","dateInformation":"v1"},{"date":"2026-02","dateType":"Available","dateInformation":"v1"},{"date":"2026","dateType":"Issued"}],"language":null,"types":{"schemaOrg":"CreativeWork","resourceTypeGeneral":"Preprint","citeproc":"article","bibtex":"misc","ris":"GEN","resourceType":"Article"},"relatedIdentifiers":[],"relatedItems":[],"sizes":[],"formats":[],"version":"1","rightsList":[{"rightsIdentifierScheme":"SPDX","rightsUri":"https://creativecommons.org/licenses/by/4.0/legalcode","schemeUri":"https://spdx.org/licenses/","rights":"Creative Commons Attribution 4.0 International","rightsIdentifier":"cc-by-4.0"}],"descriptions":[{"descriptionType":"Abstract","description":"Recent advances in text-to-image (T2I) diffusion models have seen rapid and widespread adoption. However, their powerful generative capabilities raise concerns about potential misuse for synthesizing harmful, private, or copyrighted content. To mitigate such risks, concept erasure techniques have emerged as a promising solution. Prior works have primarily focused on fine-tuning the denoising component (e.g., the U-Net backbone). However, recent causal tracing studies suggest that visual attribute information is localized in the early self-attention layers of the text encoder, indicating a potential alternative for concept erasing. Building on this insight, we conduct preliminary experiments and find that directly fine-tuning early layers can suppress target concepts but often degrades the generation quality of non-target concepts. To overcome this limitation, we propose High-Level Representation Misdirection (HiRM), which misdirects high-level semantic representations of target concepts in the text encoder toward designated vectors such as random directions or semantically defined directions (e.g., supercategories), while updating only early layers that contain causal states of visual attributes. Our decoupling strategy enables precise concept removal with minimal impact on unrelated concepts, as demonstrated by strong results on UnlearnCanvas and NSFW benchmarks across diverse targets (e.g., objects, styles, nudity). HiRM also preserves generative utility at low training cost, transfers to state-of-the-art architectures such as Flux without additional training, and shows synergistic effects with denoiser-based concept erasing methods."},{"descriptionType":"Other","description":"Accepted at ICLR 2026. The first two authors contributed equally"}],"geoLocations":[],"fundingReferences":[],"url":"https://arxiv.org/abs/2602.19631","contentUrl":null,"metadataVersion":0,"schemaVersion":"http://datacite.org/schema/kernel-4","source":"mds","isActive":true,"state":"findable","reason":null,"viewCount":0,"downloadCount":0,"referenceCount":0,"citationCount":0,"partCount":0,"partOfCount":0,"versionCount":0,"versionOfCount":0,"created":"2026-02-25T15:08:24Z","registered":"2026-02-25T15:08:25Z","published":null,"updated":"2026-02-25T15:08:25Z"},"relationships":{"client":{"data":{"id":"arxiv.content","type":"clients"}}}},{"id":"10.48550/arxiv.2602.19629","type":"dois","attributes":{"doi":"10.48550/arxiv.2602.19629","identifiers":[{"identifier":"2602.19629","identifierType":"arXiv"}],"creators":[{"nameType":"Personal","givenName":"Tatia","familyName":"Codreanu","name":"Codreanu, Tatia","affiliation":[],"nameIdentifiers":[]}],"titles":[{"title":"Cooperation After the Algorithm: Designing Human-AI Coexistence Beyond the Illusion of Collaboration"}],"publisher":"arXiv","container":{},"publicationYear":2026,"subjects":[{"subject":"Human-Computer Interaction (cs.HC)","lang":"en","subjectScheme":"arXiv"},{"subject":"Artificial Intelligence (cs.AI)","lang":"en","subjectScheme":"arXiv"},{"subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"},{"schemeUri":"http://www.oecd.org/science/inno/38235147.pdf","subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"},{"subject":"I.2.11; K.4.1; H.1.2","lang":"en","subjectScheme":"ACM"},{"subject":"91B06, 68T01, 68T37","lang":"en","subjectScheme":"MSC"}],"contributors":[],"dates":[{"date":"2026-02-23T09:17:12Z","dateType":"Submitted","dateInformation":"v1"},{"date":"2026-02-24T02:17:08Z","dateType":"Updated","dateInformation":"v1"},{"date":"2026-02","dateType":"Available","dateInformation":"v1"},{"date":"2026","dateType":"Issued"}],"language":null,"types":{"schemaOrg":"CreativeWork","resourceTypeGeneral":"Preprint","citeproc":"article","bibtex":"misc","ris":"GEN","resourceType":"Article"},"relatedIdentifiers":[],"relatedItems":[],"sizes":[],"formats":[],"version":"1","rightsList":[{"rightsIdentifierScheme":"SPDX","rightsUri":"https://creativecommons.org/licenses/by-nc-nd/4.0/legalcode","schemeUri":"https://spdx.org/licenses/","rights":"Creative Commons Attribution Non Commercial No Derivatives 4.0 International","rightsIdentifier":"cc-by-nc-nd-4.0"}],"descriptions":[{"descriptionType":"Abstract","description":"Generative artificial intelligence systems increasingly participate in research, law, education, media, and governance. Their fluent and adaptive outputs create an experience of collaboration. However, these systems do not bear responsibility, incur liability, or share stakes in downstream consequences. This structural asymmetry has already produced sanctions, professional errors, and governance failures in high-stakes contexts We argue that stable human-AI coexistence is an institutional achievement that depends on governance infrastructure capable of distributing residual risk. Drawing on institutional analysis and evolutionary cooperation theory, we introduce a formal inequality that specifies when reliance on AI yields positive expected cooperative value. The model makes explicit how governance conditions, system policy, and accountability regimes jointly determine whether cooperation is rational or structurally defective. From this formalization we derive a cooperation ecology framework with six design principles: reciprocity contracts, visible trust infrastructure, conditional cooperation modes, defection-mitigation mechanisms, narrative literacy against authority theatre, and an Earth-first sustainability constraint. We operationalize the framework through three policy artefacts: a Human-AI Cooperation Charter, a Defection Risk Register, and a Cooperation Readiness Audit. Together, these elements shift the unit of analysis from the user-AI dyad to the institutional environment that shapes incentives, signals, accountability, and repair. The paper provides a theoretical foundation and practical toolkit for designing human-AI systems that can sustain accountable, trustworthy cooperation over time."},{"descriptionType":"Other","description":"11 pages, 2 tables"}],"geoLocations":[],"fundingReferences":[],"url":"https://arxiv.org/abs/2602.19629","contentUrl":null,"metadataVersion":0,"schemaVersion":"http://datacite.org/schema/kernel-4","source":"mds","isActive":true,"state":"findable","reason":null,"viewCount":0,"downloadCount":0,"referenceCount":0,"citationCount":0,"partCount":0,"partOfCount":0,"versionCount":0,"versionOfCount":0,"created":"2026-02-25T15:08:19Z","registered":"2026-02-25T15:08:20Z","published":null,"updated":"2026-02-25T15:08:20Z"},"relationships":{"client":{"data":{"id":"arxiv.content","type":"clients"}}}},{"id":"10.48550/arxiv.2602.19628","type":"dois","attributes":{"doi":"10.48550/arxiv.2602.19628","identifiers":[{"identifier":"2602.19628","identifierType":"arXiv"}],"creators":[{"nameType":"Personal","givenName":"Pasan","familyName":"Peiris","name":"Peiris, Pasan","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Matthias","familyName":"Galster","name":"Galster, Matthias","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Antonija","familyName":"Mitrovic","name":"Mitrovic, Antonija","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Sanna","familyName":"Malinen","name":"Malinen, Sanna","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Raul Vincent","familyName":"Lumapas","name":"Lumapas, Raul Vincent","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Jay","familyName":"Holland","name":"Holland, Jay","affiliation":[],"nameIdentifiers":[]}],"titles":[{"title":"Towards Understanding Views on Combining Videos and Gamification in Software Engineering Training"}],"publisher":"arXiv","container":{},"publicationYear":2026,"subjects":[{"subject":"Software Engineering (cs.SE)","lang":"en","subjectScheme":"arXiv"},{"subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"},{"schemeUri":"http://www.oecd.org/science/inno/38235147.pdf","subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"}],"contributors":[],"dates":[{"date":"2026-02-23T09:16:42Z","dateType":"Submitted","dateInformation":"v1"},{"date":"2026-02-24T02:17:07Z","dateType":"Updated","dateInformation":"v1"},{"date":"2026-02","dateType":"Available","dateInformation":"v1"},{"date":"2026","dateType":"Issued"}],"language":null,"types":{"schemaOrg":"CreativeWork","resourceTypeGeneral":"Preprint","citeproc":"article","bibtex":"misc","ris":"GEN","resourceType":"Article"},"relatedIdentifiers":[],"relatedItems":[],"sizes":[],"formats":[],"version":"1","rightsList":[{"rightsIdentifierScheme":"SPDX","rightsUri":"https://creativecommons.org/licenses/by/4.0/legalcode","schemeUri":"https://spdx.org/licenses/","rights":"Creative Commons Attribution 4.0 International","rightsIdentifier":"cc-by-4.0"}],"descriptions":[{"descriptionType":"Abstract","description":"Watching training videos passively leads to superficial learning. Adding gamification can increase engagement. We study how software engineering students and industry practitioners view gamifying video-based training. We conducted a survey with students and professionals. Students and professionals share similar perceptions toward video-based training in general and support combining gamification and video-based training. Our findings can inform the design of gamified training solutions for software engineers."},{"descriptionType":"Other","description":"2 pages, ICSE-Companion '26"}],"geoLocations":[],"fundingReferences":[],"url":"https://arxiv.org/abs/2602.19628","contentUrl":null,"metadataVersion":0,"schemaVersion":"http://datacite.org/schema/kernel-4","source":"mds","isActive":true,"state":"findable","reason":null,"viewCount":0,"downloadCount":0,"referenceCount":0,"citationCount":0,"partCount":0,"partOfCount":0,"versionCount":0,"versionOfCount":0,"created":"2026-02-25T15:08:17Z","registered":"2026-02-25T15:08:18Z","published":null,"updated":"2026-02-25T15:08:18Z"},"relationships":{"client":{"data":{"id":"arxiv.content","type":"clients"}}}},{"id":"10.48550/arxiv.2602.19626","type":"dois","attributes":{"doi":"10.48550/arxiv.2602.19626","identifiers":[{"identifier":"2602.19626","identifierType":"arXiv"}],"creators":[{"nameType":"Personal","givenName":"Roberto","familyName":"Tacconelli","name":"Tacconelli, Roberto","affiliation":[],"nameIdentifiers":[]}],"titles":[{"title":"Nacrith: Neural Lossless Compression via Ensemble Context Modeling and High-Precision CDF Coding"}],"publisher":"arXiv","container":{},"publicationYear":2026,"subjects":[{"subject":"Information Theory (cs.IT)","lang":"en","subjectScheme":"arXiv"},{"subject":"Computation and Language (cs.CL)","lang":"en","subjectScheme":"arXiv"},{"subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"},{"schemeUri":"http://www.oecd.org/science/inno/38235147.pdf","subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"}],"contributors":[],"dates":[{"date":"2026-02-23T09:14:05Z","dateType":"Submitted","dateInformation":"v1"},{"date":"2026-02-24T02:17:05Z","dateType":"Updated","dateInformation":"v1"},{"date":"2026-02-24T11:10:17Z","dateType":"Submitted","dateInformation":"v2"},{"date":"2026-02-25T01:41:48Z","dateType":"Updated","dateInformation":"v2"},{"date":"2026-02","dateType":"Available","dateInformation":"v1"},{"date":"2026","dateType":"Issued"}],"language":null,"types":{"schemaOrg":"CreativeWork","resourceTypeGeneral":"Preprint","citeproc":"article","bibtex":"misc","ris":"GEN","resourceType":"Article"},"relatedIdentifiers":[],"relatedItems":[],"sizes":[],"formats":[],"version":"2","rightsList":[{"rightsUri":"http://arxiv.org/licenses/nonexclusive-distrib/1.0/","rights":"arXiv.org perpetual, non-exclusive license"}],"descriptions":[{"descriptionType":"Abstract","description":"We present Nacrith, a lossless compression system that combines a 135M-parameter transformer language model (SmolLM2-135M) with an ensemble of lightweight online predictors and a 32-bit arithmetic coder, achieving the best compression results among the systems evaluated in this study on natural language text. Beyond the base LLM-plus-arithmetic-coding paradigm, Nacrith introduces several contributions: (1) a CDF precision upgrade from 2^16 to 2^24 that eliminates ~75% of quantization overhead caused by minimum-probability floors in large vocabularies; (2) a token-level N-gram model for fast local predictions; (3) an adaptive log-space bias head correcting per-document LLM errors via online gradient descent; (4) confidence-based LLM skip for accelerating highly predictable tokens; (5) a hybrid binary format (NC06) extending neural compression to arbitrary binary files--to our knowledge a first among LLM-based compressors; (6) a llama cpp inference backend achieving ~7x faster single-token decode than PyTorch; (7) parallel multi-GPU compression across up to 8 workers; and (8) native KV cache sliding window reducing per-slide cost by ~37x. The system requires only ~500 MB of GGUF weights and ~1.2 GB VRAM per worker, running on consumer GPUs.\n On alice29 (Canterbury Corpus, 152 KB), Nacrith achieves 0.918 bits per byte (bpb)--outperforming gzip by 3.1x, bzip2 by 2.5x, CMIX v21 by 44%, and ts_zip by 20%, while compressing below the 0th-, 1st-, and 2nd-order byte-level Shannon entropy bounds. On enwik8 (100 MB), Nacrith achieves 0.9389 bpb (11.74%), surpassing ts_zip (~1.11 bpb) by 15% and FineZip (1.024 bpb) by 8% despite using a 60x smaller model with no fine-tuning. An out-of-distribution (OOD) evaluation on a document published after the model's training cutoff confirms these gains are not memorization artifacts, achieving 0.723 bpb on unseen text."},{"descriptionType":"Other","description":"10 pages"}],"geoLocations":[],"fundingReferences":[],"url":"https://arxiv.org/abs/2602.19626","contentUrl":null,"metadataVersion":0,"schemaVersion":"http://datacite.org/schema/kernel-4","source":"mds","isActive":true,"state":"findable","reason":null,"viewCount":0,"downloadCount":0,"referenceCount":0,"citationCount":0,"partCount":0,"partOfCount":0,"versionCount":0,"versionOfCount":0,"created":"2026-02-25T15:08:12Z","registered":"2026-02-25T15:08:13Z","published":null,"updated":"2026-02-25T15:08:13Z"},"relationships":{"client":{"data":{"id":"arxiv.content","type":"clients"}}}},{"id":"10.48550/arxiv.2602.19622","type":"dois","attributes":{"doi":"10.48550/arxiv.2602.19622","identifiers":[{"identifier":"2602.19622","identifierType":"arXiv"}],"creators":[{"nameType":"Personal","givenName":"Jingbo","familyName":"Zhou","name":"Zhou, Jingbo","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Jun","familyName":"Xia","name":"Xia, Jun","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Siyuan","familyName":"Li","name":"Li, Siyuan","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Yunfan","familyName":"Liu","name":"Liu, Yunfan","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Wenjun","familyName":"Wang","name":"Wang, Wenjun","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Yufei","familyName":"Huang","name":"Huang, Yufei","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Changxi","familyName":"Chi","name":"Chi, Changxi","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Mutian","familyName":"Hong","name":"Hong, Mutian","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Zhuoli","familyName":"Ouyang","name":"Ouyang, Zhuoli","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Shu","familyName":"Wang","name":"Wang, Shu","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Zhongqi","familyName":"Wang","name":"Wang, Zhongqi","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Xingyu","familyName":"Wu","name":"Wu, Xingyu","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Chang","familyName":"Yu","name":"Yu, Chang","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Stan Z.","familyName":"Li","name":"Li, Stan Z.","affiliation":[],"nameIdentifiers":[]}],"titles":[{"title":"VecFormer: Towards Efficient and Generalizable Graph Transformer with Graph Token Attention"}],"publisher":"arXiv","container":{},"publicationYear":2026,"subjects":[{"subject":"Machine Learning (cs.LG)","lang":"en","subjectScheme":"arXiv"},{"subject":"Artificial Intelligence (cs.AI)","lang":"en","subjectScheme":"arXiv"},{"subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"},{"schemeUri":"http://www.oecd.org/science/inno/38235147.pdf","subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"}],"contributors":[],"dates":[{"date":"2026-02-23T09:10:39Z","dateType":"Submitted","dateInformation":"v1"},{"date":"2026-02-24T02:16:58Z","dateType":"Updated","dateInformation":"v1"},{"date":"2026-02","dateType":"Available","dateInformation":"v1"},{"date":"2026","dateType":"Issued"}],"language":null,"types":{"schemaOrg":"CreativeWork","resourceTypeGeneral":"Preprint","citeproc":"article","bibtex":"misc","ris":"GEN","resourceType":"Article"},"relatedIdentifiers":[],"relatedItems":[],"sizes":[],"formats":[],"version":"1","rightsList":[{"rightsIdentifierScheme":"SPDX","rightsUri":"https://creativecommons.org/licenses/by/4.0/legalcode","schemeUri":"https://spdx.org/licenses/","rights":"Creative Commons Attribution 4.0 International","rightsIdentifier":"cc-by-4.0"}],"descriptions":[{"descriptionType":"Abstract","description":"Graph Transformer has demonstrated impressive capabilities in the field of graph representation learning. However, existing approaches face two critical challenges: (1) most models suffer from exponentially increasing computational complexity, making it difficult to scale to large graphs; (2) attention mechanisms based on node-level operations limit the flexibility of the model and result in poor generalization performance in out-of-distribution (OOD) scenarios. To address these issues, we propose \\textbf{VecFormer} (the \\textbf{Vec}tor Quantized Graph Trans\\textbf{former}), an efficient and highly generalizable model for node classification, particularly under OOD settings. VecFormer adopts a two-stage training paradigm. In the first stage, two codebooks are used to reconstruct the node features and the graph structure, aiming to learn the rich semantic \\texttt{Graph Codes}. In the second stage, attention mechanisms are performed at the \\texttt{Graph Token} level based on the transformed cross codebook, reducing computational complexity while enhancing the model's generalization capability. Extensive experiments on datasets of various sizes demonstrate that VecFormer outperforms the existing Graph Transformer in both performance and speed."}],"geoLocations":[],"fundingReferences":[],"url":"https://arxiv.org/abs/2602.19622","contentUrl":null,"metadataVersion":0,"schemaVersion":"http://datacite.org/schema/kernel-4","source":"mds","isActive":true,"state":"findable","reason":null,"viewCount":0,"downloadCount":0,"referenceCount":0,"citationCount":0,"partCount":0,"partOfCount":0,"versionCount":0,"versionOfCount":0,"created":"2026-02-25T15:08:02Z","registered":"2026-02-25T15:08:03Z","published":null,"updated":"2026-02-25T15:08:03Z"},"relationships":{"client":{"data":{"id":"arxiv.content","type":"clients"}}}},{"id":"10.48550/arxiv.2602.19620","type":"dois","attributes":{"doi":"10.48550/arxiv.2602.19620","identifiers":[{"identifier":"2602.19620","identifierType":"arXiv"}],"creators":[{"nameType":"Personal","givenName":"Louth Bin","familyName":"Rawshan","name":"Rawshan, Louth Bin","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Zhuoyu","familyName":"Wang","name":"Wang, Zhuoyu","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Brian Y","familyName":"Lim","name":"Lim, Brian Y","affiliation":[],"nameIdentifiers":[]}],"titles":[{"title":"Rules or Weights? Comparing User Understanding of Explainable AI Techniques with the Cognitive XAI-Adaptive Model"}],"publisher":"arXiv","container":{},"publicationYear":2026,"subjects":[{"subject":"Artificial Intelligence (cs.AI)","lang":"en","subjectScheme":"arXiv"},{"subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"},{"schemeUri":"http://www.oecd.org/science/inno/38235147.pdf","subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"}],"contributors":[],"dates":[{"date":"2026-02-23T09:07:16Z","dateType":"Submitted","dateInformation":"v1"},{"date":"2026-02-24T02:16:56Z","dateType":"Updated","dateInformation":"v1"},{"date":"2026-02","dateType":"Available","dateInformation":"v1"},{"date":"2026","dateType":"Issued"}],"language":null,"types":{"schemaOrg":"CreativeWork","resourceTypeGeneral":"Preprint","citeproc":"article","bibtex":"misc","ris":"GEN","resourceType":"Article"},"relatedIdentifiers":[],"relatedItems":[],"sizes":[],"formats":[],"version":"1","rightsList":[{"rightsIdentifierScheme":"SPDX","rightsUri":"https://creativecommons.org/licenses/by/4.0/legalcode","schemeUri":"https://spdx.org/licenses/","rights":"Creative Commons Attribution 4.0 International","rightsIdentifier":"cc-by-4.0"}],"descriptions":[{"descriptionType":"Abstract","description":"Rules and Weights are popular XAI techniques for explaining AI decisions. Yet, it remains unclear how to choose between them, lacking a cognitive framework to compare their interpretability. In an elicitation user study on forward and counterfactual decision tasks, we identified 7 reasoning strategies of interpreting three XAI Schemas - weights, rules, and their hybrid. To analyze their capabilities, we propose CoXAM, a Cognitive XAI-Adaptive Model with shared memory representation to encode instance attributes, linear weights, and decision rules. CoXAM employs computational rationality to choose among reasoning processes based on the trade-off in utility and reasoning time, separately for forward or counterfactual decision tasks. In a validation study, CoXAM demonstrated a stronger alignment with human decision-making compared to baseline machine learning proxy models. The model successfully replicated and explained several key empirical findings, including that counterfactual tasks are inherently harder than forward tasks, decision tree rules are harder to recall and apply than linear weights, and the helpfulness of XAI depends on the application data context, alongside identifying which underlying reasoning strategies were most effective. With CoXAM, we contribute a cognitive basis to accelerate debugging and benchmarking disparate XAI techniques."}],"geoLocations":[],"fundingReferences":[],"url":"https://arxiv.org/abs/2602.19620","contentUrl":null,"metadataVersion":0,"schemaVersion":"http://datacite.org/schema/kernel-4","source":"mds","isActive":true,"state":"findable","reason":null,"viewCount":0,"downloadCount":0,"referenceCount":0,"citationCount":0,"partCount":0,"partOfCount":0,"versionCount":0,"versionOfCount":0,"created":"2026-02-25T15:07:58Z","registered":"2026-02-25T15:07:58Z","published":null,"updated":"2026-02-25T15:07:58Z"},"relationships":{"client":{"data":{"id":"arxiv.content","type":"clients"}}}},{"id":"10.48550/arxiv.2602.19618","type":"dois","attributes":{"doi":"10.48550/arxiv.2602.19618","identifiers":[{"identifier":"2602.19618","identifierType":"arXiv"}],"creators":[{"nameType":"Personal","givenName":"Ciaran A. J.","familyName":"O'Hare","name":"O'Hare, Ciaran A. J.","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Anirudh Chandra","familyName":"Shekar","name":"Shekar, Anirudh Chandra","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Chiara","familyName":"Lisotti","name":"Lisotti, Chiara","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Michael","familyName":"Litke","name":"Litke, Michael","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Nityasa","familyName":"Mishra","name":"Mishra, Nityasa","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Jayden L.","familyName":"Newstead","name":"Newstead, Jayden L.","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Louis E.","familyName":"Strigari","name":"Strigari, Louis E.","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Sven E.","familyName":"Vahsen","name":"Vahsen, Sven E.","affiliation":[],"nameIdentifiers":[]}],"titles":[{"title":"Directional recoil detection for CEvNS measurements with light nuclei at the Spallation Neutron Source"}],"publisher":"arXiv","container":{},"publicationYear":2026,"subjects":[{"subject":"High Energy Physics - Phenomenology (hep-ph)","lang":"en","subjectScheme":"arXiv"},{"subject":"High Energy Physics - Experiment (hep-ex)","lang":"en","subjectScheme":"arXiv"},{"subject":"FOS: Physical sciences","subjectScheme":"Fields of Science and Technology (FOS)"},{"schemeUri":"http://www.oecd.org/science/inno/38235147.pdf","subject":"FOS: Physical sciences","subjectScheme":"Fields of Science and Technology (FOS)"}],"contributors":[],"dates":[{"date":"2026-02-23T09:04:52Z","dateType":"Submitted","dateInformation":"v1"},{"date":"2026-02-24T02:16:52Z","dateType":"Updated","dateInformation":"v1"},{"date":"2026-02","dateType":"Available","dateInformation":"v1"},{"date":"2026","dateType":"Issued"}],"language":null,"types":{"schemaOrg":"CreativeWork","resourceTypeGeneral":"Preprint","citeproc":"article","bibtex":"misc","ris":"GEN","resourceType":"Article"},"relatedIdentifiers":[],"relatedItems":[],"sizes":[],"formats":[],"version":"1","rightsList":[{"rightsUri":"http://arxiv.org/licenses/nonexclusive-distrib/1.0/","rights":"arXiv.org perpetual, non-exclusive license"}],"descriptions":[{"descriptionType":"Abstract","description":"The coherent elastic scattering of neutrinos on nuclei, also known as CEvNS, has been studied for several years by the COHERENT program of experiments using neutrinos from stopped-pion decays produced at the Spallation Neutron Source (SNS). We propose a new approach for CEvNS measurements at the SNS that aims to complement the COHERENT experiments in two main ways: by reconstructing the angular distribution of CEvNS-induced recoils, and by measuring CEvNS on much lighter target nuclei such as helium, carbon, and fluorine. The proposed detector would employ a gaseous time-projection chamber with a highly segmented charge readout to enable the spatial reconstruction of $\\sim$10-500 keV ionisation tracks created by CEvNS-induced recoils. This would enable the simultaneous measurement of the CEvNS recoil energy and scattering angle, thereby allowing event-by-event reconstruction of the neutrino energy. We estimate that a 60:40 He:CF$_4$ gas mixture at atmospheric pressure offers a good trade-off between total target mass and good directionality and could deliver a detection of the angular distribution of CEvNS, even under pessimistic background conditions. We project the sensitivity of 1 and 10 m$^3$-scale detectors in the context of several physics cases, including: the measurement of the Standard Model CEvNS cross section, reconstruction of the flavour-dependent neutrino fluxes, observing the neutrino-induced Migdal effect, constraints on beyond-Standard Model neutrino interactions, and probing 10-eV-scale sterile neutrinos."},{"descriptionType":"Other","description":"25 pages, 17 figures"}],"geoLocations":[],"fundingReferences":[],"url":"https://arxiv.org/abs/2602.19618","contentUrl":null,"metadataVersion":0,"schemaVersion":"http://datacite.org/schema/kernel-4","source":"mds","isActive":true,"state":"findable","reason":null,"viewCount":0,"downloadCount":0,"referenceCount":0,"citationCount":0,"partCount":0,"partOfCount":0,"versionCount":0,"versionOfCount":0,"created":"2026-02-25T15:07:53Z","registered":"2026-02-25T15:07:54Z","published":null,"updated":"2026-02-25T15:07:54Z"},"relationships":{"client":{"data":{"id":"arxiv.content","type":"clients"}}}},{"id":"10.48550/arxiv.2602.19617","type":"dois","attributes":{"doi":"10.48550/arxiv.2602.19617","identifiers":[{"identifier":"2602.19617","identifierType":"arXiv"}],"creators":[{"nameType":"Personal","givenName":"Di","familyName":"Cheng","name":"Cheng, Di","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Junxiang","familyName":"Li","name":"Li, Junxiang","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Shizhuo","familyName":"Luo","name":"Luo, Shizhuo","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Zehao","familyName":"Chen","name":"Chen, Zehao","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Xinwei","familyName":"Li","name":"Li, Xinwei","affiliation":[],"nameIdentifiers":[]}],"titles":[{"title":"Rotational anisotropy Raman spectrometer for high-sensitivity crystallographic symmetry analysis"}],"publisher":"arXiv","container":{},"publicationYear":2026,"subjects":[{"subject":"Materials Science (cond-mat.mtrl-sci)","lang":"en","subjectScheme":"arXiv"},{"subject":"FOS: Physical sciences","subjectScheme":"Fields of Science and Technology (FOS)"},{"schemeUri":"http://www.oecd.org/science/inno/38235147.pdf","subject":"FOS: Physical sciences","subjectScheme":"Fields of Science and Technology (FOS)"}],"contributors":[],"dates":[{"date":"2026-02-23T09:04:28Z","dateType":"Submitted","dateInformation":"v1"},{"date":"2026-02-24T02:16:51Z","dateType":"Updated","dateInformation":"v1"},{"date":"2026-02","dateType":"Available","dateInformation":"v1"},{"date":"2026","dateType":"Issued"}],"language":null,"types":{"schemaOrg":"CreativeWork","resourceTypeGeneral":"Preprint","citeproc":"article","bibtex":"misc","ris":"GEN","resourceType":"Article"},"relatedIdentifiers":[],"relatedItems":[],"sizes":[],"formats":[],"version":"1","rightsList":[{"rightsUri":"http://arxiv.org/licenses/nonexclusive-distrib/1.0/","rights":"arXiv.org perpetual, non-exclusive license"}],"descriptions":[{"descriptionType":"Abstract","description":"Raman spectroscopy stands as a cornerstone technique for probing collective excitations and emergent quantum phases in solids. While polarization-resolved Raman scattering has been widely used to extract symmetry information of eigenmodes, its conventional geometry suffers from significant limitations: it accesses only a subset of Raman tensor elements, enforces π-periodic intensity patterns that obscure intrinsic crystalline symmetries, and lacks sensitivity to wavevector-dependent anisotropy. To overcome these constraints, here we introduce rotational-anisotropy Raman spectroscopy (RA-Raman). By measuring scattering intensity during full azimuthal rotation of the optical scattering plane at oblique incidence, this geometry enables complete reconstruction of the Raman tensor and reveals rich rotational anisotropy patterns essential for accessing subtle symmetry information elusive to conventional methods. We developed a prototype instrument to validate this approach experimentally. For centrosymmetric crystals, RA-Raman unambiguously identifies phonon symmetry representations and determines crystallographic axes. In noncentrosymmetric crystals, it resolves directional anisotropy and angular dispersion of phonon-polaritons, enabling quantitative determination of the Faust-Henry coefficient and the separation of deformation-potential and electro-optic scattering contributions. By demonstrating unprecedented symmetry-resolving power in standard benchmark crystals, we establish RA-Raman as a powerful tool with far-reaching potential to discover and characterize symmetry-breaking phases and topological excitations in quantum materials."},{"descriptionType":"Other","description":"24 pages, 5 figures"}],"geoLocations":[],"fundingReferences":[],"url":"https://arxiv.org/abs/2602.19617","contentUrl":null,"metadataVersion":0,"schemaVersion":"http://datacite.org/schema/kernel-4","source":"mds","isActive":true,"state":"findable","reason":null,"viewCount":0,"downloadCount":0,"referenceCount":0,"citationCount":0,"partCount":0,"partOfCount":0,"versionCount":0,"versionOfCount":0,"created":"2026-02-25T15:07:50Z","registered":"2026-02-25T15:07:51Z","published":null,"updated":"2026-02-25T15:07:51Z"},"relationships":{"client":{"data":{"id":"arxiv.content","type":"clients"}}}},{"id":"10.48550/arxiv.2602.19616","type":"dois","attributes":{"doi":"10.48550/arxiv.2602.19616","identifiers":[{"identifier":"2602.19616","identifierType":"arXiv"}],"creators":[{"nameType":"Personal","givenName":"Erwin","familyName":"Lopez","name":"Lopez, Erwin","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Atsushi","familyName":"Shimada","name":"Shimada, Atsushi","affiliation":[],"nameIdentifiers":[]}],"titles":[{"title":"Is Log-Traced Engagement Enough? Extending Reading Analytics With Trait-Level Flow and Reading Strategy Metrics"}],"publisher":"arXiv","container":{},"publicationYear":2026,"subjects":[{"subject":"Computers and Society (cs.CY)","lang":"en","subjectScheme":"arXiv"},{"subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"},{"schemeUri":"http://www.oecd.org/science/inno/38235147.pdf","subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"}],"contributors":[],"dates":[{"date":"2026-02-23T09:03:33Z","dateType":"Submitted","dateInformation":"v1"},{"date":"2026-02-24T02:16:43Z","dateType":"Updated","dateInformation":"v1"},{"date":"2026-02","dateType":"Available","dateInformation":"v1"},{"date":"2026","dateType":"Issued"}],"language":null,"types":{"schemaOrg":"CreativeWork","resourceTypeGeneral":"Preprint","citeproc":"article","bibtex":"misc","ris":"GEN","resourceType":"Article"},"relatedIdentifiers":[{"relationType":"IsVersionOf","relatedIdentifier":"10.1145/3785022.3785104","relatedIdentifierType":"DOI"}],"relatedItems":[],"sizes":[],"formats":[],"version":"1","rightsList":[{"rightsIdentifierScheme":"SPDX","rightsUri":"https://creativecommons.org/licenses/by/4.0/legalcode","schemeUri":"https://spdx.org/licenses/","rights":"Creative Commons Attribution 4.0 International","rightsIdentifier":"cc-by-4.0"}],"descriptions":[{"descriptionType":"Abstract","description":"Student engagement is a central construct in Learning Analytics, yet it is often operationalized through persistence indicators derived from logs, overlooking affective-cognitive states. Focusing on the analysis of reading logs, this study examines how trait-level flow - operationalized as the tendency to experience Deep Effortless Concentration (DEC) - and traces of reading strategies derived from e-book interaction data can extend traditional engagement indicators in explaining learning outcomes. We collected data from 100 students across two engineering courses, combining questionnaire measures of DEC with fine-grained reading logs. Correlation and regression analyses show that (1) DEC and traces of reading strategies explain substantial additional variance in grades beyond log-traced engagement (ΔR2 = 21.3% over the baseline 25.5%), and (2) DEC moderates the relationship between reading behaviors and outcomes, indicating trait-sensitive differences in how log-derived indicators translate into performance. These findings suggest that, to support more equitable and personalized interventions, the analysis of reading logs should move beyond a one-size-fits-all interpretation and integrate personal traits with metrics that include behavioral and strategic measures of reading."},{"descriptionType":"Other","description":"17 pages. This version has been accepted for presentation at LAK'26, and all peer-reviewed changes have been incorporated"}],"geoLocations":[],"fundingReferences":[],"url":"https://arxiv.org/abs/2602.19616","contentUrl":null,"metadataVersion":0,"schemaVersion":"http://datacite.org/schema/kernel-4","source":"mds","isActive":true,"state":"findable","reason":null,"viewCount":0,"downloadCount":0,"referenceCount":0,"citationCount":0,"partCount":0,"partOfCount":0,"versionCount":0,"versionOfCount":1,"created":"2026-02-25T15:07:48Z","registered":"2026-02-25T15:07:48Z","published":null,"updated":"2026-02-25T15:07:48Z"},"relationships":{"client":{"data":{"id":"arxiv.content","type":"clients"}}}},{"id":"10.48550/arxiv.2602.19615","type":"dois","attributes":{"doi":"10.48550/arxiv.2602.19615","identifiers":[{"identifier":"2602.19615","identifierType":"arXiv"}],"creators":[{"nameType":"Personal","givenName":"Xin","familyName":"Hu","name":"Hu, Xin","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Haomiao","familyName":"Ni","name":"Ni, Haomiao","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Yunbei","familyName":"Zhang","name":"Zhang, Yunbei","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Jihun","familyName":"Hamm","name":"Hamm, Jihun","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Zechen","familyName":"Li","name":"Li, Zechen","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Zhengming","familyName":"Ding","name":"Ding, Zhengming","affiliation":[],"nameIdentifiers":[]}],"titles":[{"title":"Seeing Clearly, Reasoning Confidently: Plug-and-Play Remedies for Vision Language Model Blindness"}],"publisher":"arXiv","container":{},"publicationYear":2026,"subjects":[{"subject":"Computer Vision and Pattern Recognition (cs.CV)","lang":"en","subjectScheme":"arXiv"},{"subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"},{"schemeUri":"http://www.oecd.org/science/inno/38235147.pdf","subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"}],"contributors":[],"dates":[{"date":"2026-02-23T09:02:40Z","dateType":"Submitted","dateInformation":"v1"},{"date":"2026-02-24T02:16:42Z","dateType":"Updated","dateInformation":"v1"},{"date":"2026-02","dateType":"Available","dateInformation":"v1"},{"date":"2026","dateType":"Issued"}],"language":null,"types":{"schemaOrg":"CreativeWork","resourceTypeGeneral":"Preprint","citeproc":"article","bibtex":"misc","ris":"GEN","resourceType":"Article"},"relatedIdentifiers":[],"relatedItems":[],"sizes":[],"formats":[],"version":"1","rightsList":[{"rightsIdentifierScheme":"SPDX","rightsUri":"https://creativecommons.org/licenses/by/4.0/legalcode","schemeUri":"https://spdx.org/licenses/","rights":"Creative Commons Attribution 4.0 International","rightsIdentifier":"cc-by-4.0"}],"descriptions":[{"descriptionType":"Abstract","description":"Vision language models (VLMs) have achieved remarkable success in broad visual understanding, yet they remain challenged by object-centric reasoning on rare objects due to the scarcity of such instances in pretraining data. While prior efforts alleviate this issue by retrieving additional data or introducing stronger vision encoders, these methods are still computationally intensive during finetuning VLMs and don't fully exploit the original training data. In this paper, we introduce an efficient plug-and-play module that substantially improves VLMs' reasoning over rare objects by refining visual tokens and enriching input text prompts, without VLMs finetuning. Specifically, we propose to learn multi-modal class embeddings for rare objects by leveraging prior knowledge from vision foundation models and synonym-augmented text descriptions, compensating for limited training examples. These embeddings refine the visual tokens in VLMs through a lightweight attention-based enhancement module that improves fine-grained object details. In addition, we use the learned embeddings as object-aware detectors to generate informative hints, which are injected into the text prompts to help guide the VLM's attention toward relevant image regions. Experiments on two benchmarks show consistent and substantial gains for pretrained VLMs in rare object recognition and reasoning. Further analysis reveals how our method strengthens the VLM's ability to focus on and reason about rare objects."},{"descriptionType":"Other","description":"Accepted by CVPR 2026"}],"geoLocations":[],"fundingReferences":[],"url":"https://arxiv.org/abs/2602.19615","contentUrl":null,"metadataVersion":0,"schemaVersion":"http://datacite.org/schema/kernel-4","source":"mds","isActive":true,"state":"findable","reason":null,"viewCount":0,"downloadCount":0,"referenceCount":0,"citationCount":0,"partCount":0,"partOfCount":0,"versionCount":0,"versionOfCount":0,"created":"2026-02-25T15:07:45Z","registered":"2026-02-25T15:07:46Z","published":null,"updated":"2026-02-25T15:07:46Z"},"relationships":{"client":{"data":{"id":"arxiv.content","type":"clients"}}}},{"id":"10.48550/arxiv.2602.19614","type":"dois","attributes":{"doi":"10.48550/arxiv.2602.19614","identifiers":[{"identifier":"2602.19614","identifierType":"arXiv"}],"creators":[{"nameType":"Personal","givenName":"Chih-Hong","familyName":"Cheng","name":"Cheng, Chih-Hong","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Brian Hsuan-Cheng","familyName":"Liao","name":"Liao, Brian Hsuan-Cheng","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Adam","familyName":"Molin","name":"Molin, Adam","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Hasan","familyName":"Esen","name":"Esen, Hasan","affiliation":[],"nameIdentifiers":[]}],"titles":[{"title":"Workflow-Level Design Principles for Trustworthy GenAI in Automotive System Engineering"}],"publisher":"arXiv","container":{},"publicationYear":2026,"subjects":[{"subject":"Software Engineering (cs.SE)","lang":"en","subjectScheme":"arXiv"},{"subject":"Machine Learning (cs.LG)","lang":"en","subjectScheme":"arXiv"},{"subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"},{"schemeUri":"http://www.oecd.org/science/inno/38235147.pdf","subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"}],"contributors":[],"dates":[{"date":"2026-02-23T09:02:38Z","dateType":"Submitted","dateInformation":"v1"},{"date":"2026-02-24T02:16:41Z","dateType":"Updated","dateInformation":"v1"},{"date":"2026-02","dateType":"Available","dateInformation":"v1"},{"date":"2026","dateType":"Issued"}],"language":null,"types":{"schemaOrg":"CreativeWork","resourceTypeGeneral":"Preprint","citeproc":"article","bibtex":"misc","ris":"GEN","resourceType":"Article"},"relatedIdentifiers":[],"relatedItems":[],"sizes":[],"formats":[],"version":"1","rightsList":[{"rightsUri":"http://arxiv.org/licenses/nonexclusive-distrib/1.0/","rights":"arXiv.org perpetual, non-exclusive license"}],"descriptions":[{"descriptionType":"Abstract","description":"The adoption of large language models in safety-critical system engineering is constrained by trustworthiness, traceability, and alignment with established verification practices. We propose workflow-level design principles for trustworthy GenAI integration and demonstrate them in an end-to-end automotive pipeline, from requirement delta identification to SysML v2 architecture update and re-testing. First, we show that monolithic (\"big-bang\") prompting misses critical changes in large specifications, while section-wise decomposition with diversity sampling and lightweight NLP sanity checks improves completeness and correctness. Then, we propagate requirement deltas into SysML v2 models and validate updates via compilation and static analysis. Additionally, we ensure traceable regression testing by generating test cases through explicit mappings from specification variables to architectural ports and states, providing practical safeguards for GenAI used in safety-critical automotive engineering."}],"geoLocations":[],"fundingReferences":[],"url":"https://arxiv.org/abs/2602.19614","contentUrl":null,"metadataVersion":0,"schemaVersion":"http://datacite.org/schema/kernel-4","source":"mds","isActive":true,"state":"findable","reason":null,"viewCount":0,"downloadCount":0,"referenceCount":0,"citationCount":0,"partCount":0,"partOfCount":0,"versionCount":0,"versionOfCount":0,"created":"2026-02-25T15:07:43Z","registered":"2026-02-25T15:07:44Z","published":null,"updated":"2026-02-25T15:07:44Z"},"relationships":{"client":{"data":{"id":"arxiv.content","type":"clients"}}}},{"id":"10.48550/arxiv.2602.19613","type":"dois","attributes":{"doi":"10.48550/arxiv.2602.19613","identifiers":[{"identifier":"2602.19613","identifierType":"arXiv"}],"creators":[{"nameType":"Personal","givenName":"Gabriel Martins","familyName":"de Jesus","name":"de Jesus, Gabriel Martins","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Richard Demo","familyName":"Souza","name":"Souza, Richard Demo","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Onel Luis Alcaraz","familyName":"López","name":"López, Onel Luis Alcaraz","affiliation":[],"nameIdentifiers":[]}],"titles":[{"title":"Active IoT User Detection in Near-Field with Location Information"}],"publisher":"arXiv","container":{},"publicationYear":2026,"subjects":[{"subject":"Signal Processing (eess.SP)","lang":"en","subjectScheme":"arXiv"},{"subject":"FOS: Electrical engineering, electronic engineering, information engineering","subjectScheme":"Fields of Science and Technology (FOS)"},{"schemeUri":"http://www.oecd.org/science/inno/38235147.pdf","subject":"FOS: Electrical engineering, electronic engineering, information engineering","subjectScheme":"Fields of Science and Technology (FOS)"}],"contributors":[],"dates":[{"date":"2026-02-23T09:01:08Z","dateType":"Submitted","dateInformation":"v1"},{"date":"2026-02-24T02:16:40Z","dateType":"Updated","dateInformation":"v1"},{"date":"2026-02","dateType":"Available","dateInformation":"v1"},{"date":"2026","dateType":"Issued"}],"language":null,"types":{"schemaOrg":"CreativeWork","resourceTypeGeneral":"Preprint","citeproc":"article","bibtex":"misc","ris":"GEN","resourceType":"Article"},"relatedIdentifiers":[],"relatedItems":[],"sizes":[],"formats":[],"version":"1","rightsList":[{"rightsUri":"http://arxiv.org/licenses/nonexclusive-distrib/1.0/","rights":"arXiv.org perpetual, non-exclusive license"}],"descriptions":[{"descriptionType":"Abstract","description":"In this paper, we address active users detection (AUD) in near-field Internet of Things (IoT) networks by exploring prior knowledge of users' locations. We consider a scenario where users are distributed in a semi-circular area within the Rayleigh distance of a multi-antenna base station (BS). We propose the BS to use location estimates of the users to reconstruct their line-of-sight (LoS) channel components, hence assisting the AUD process. For this, the BS combines these reconstructed channels with users' pilot sequences, enhancing the correlation between received signals and active users. We formulate the location-aided AUD as a convex optimization problem, solved via the alternating direction method of multipliers (ADMM). {Our proposal has a higher computational complexity compared to the baseline ADMM approach where location information is not used. Moreover, the proposal requires location information of users, which can be readily informed if users are static, or inferred via established localization algorithms if they are mobile.} Simulation results compare our proposal against the baseline across varying systems parameters, such as number of users, pilot length and LoS component strength. We demonstrate that under perfect location estimation and strong LoS, our proposed method significantly outperforms the baseline. Furthermore, robustness analysis shows that performance gains persist under imperfect location estimation, provided the estimation error remains within bounds determined by the system parameters."},{"descriptionType":"Other","description":"9 pages, 7 figures. This paper is under review for possible publication"}],"geoLocations":[],"fundingReferences":[],"url":"https://arxiv.org/abs/2602.19613","contentUrl":null,"metadataVersion":0,"schemaVersion":"http://datacite.org/schema/kernel-4","source":"mds","isActive":true,"state":"findable","reason":null,"viewCount":0,"downloadCount":0,"referenceCount":0,"citationCount":0,"partCount":0,"partOfCount":0,"versionCount":0,"versionOfCount":0,"created":"2026-02-25T15:07:41Z","registered":"2026-02-25T15:07:41Z","published":null,"updated":"2026-02-25T15:07:41Z"},"relationships":{"client":{"data":{"id":"arxiv.content","type":"clients"}}}},{"id":"10.48550/arxiv.2602.19611","type":"dois","attributes":{"doi":"10.48550/arxiv.2602.19611","identifiers":[{"identifier":"2602.19611","identifierType":"arXiv"}],"creators":[{"nameType":"Personal","givenName":"Mingxiu","familyName":"Cai","name":"Cai, Mingxiu","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Zhe","familyName":"Zhang","name":"Zhang, Zhe","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Gaochang","familyName":"Wu","name":"Wu, Gaochang","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Tianyou","familyName":"Chai","name":"Chai, Tianyou","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Xiatian","familyName":"Zhu","name":"Zhu, Xiatian","affiliation":[],"nameIdentifiers":[]}],"titles":[{"title":"RAID: Retrieval-Augmented Anomaly Detection"}],"publisher":"arXiv","container":{},"publicationYear":2026,"subjects":[{"subject":"Computer Vision and Pattern Recognition (cs.CV)","lang":"en","subjectScheme":"arXiv"},{"subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"},{"schemeUri":"http://www.oecd.org/science/inno/38235147.pdf","subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"}],"contributors":[],"dates":[{"date":"2026-02-23T08:54:27Z","dateType":"Submitted","dateInformation":"v1"},{"date":"2026-02-24T02:16:22Z","dateType":"Updated","dateInformation":"v1"},{"date":"2026-02","dateType":"Available","dateInformation":"v1"},{"date":"2026","dateType":"Issued"}],"language":null,"types":{"schemaOrg":"CreativeWork","resourceTypeGeneral":"Preprint","citeproc":"article","bibtex":"misc","ris":"GEN","resourceType":"Article"},"relatedIdentifiers":[],"relatedItems":[],"sizes":[],"formats":[],"version":"1","rightsList":[{"rightsUri":"http://arxiv.org/licenses/nonexclusive-distrib/1.0/","rights":"arXiv.org perpetual, non-exclusive license"}],"descriptions":[{"descriptionType":"Abstract","description":"Unsupervised Anomaly Detection (UAD) aims to identify abnormal regions by establishing correspondences between test images and normal templates. Existing methods primarily rely on image reconstruction or template retrieval but face a fundamental challenge: matching between test images and normal templates inevitably introduces noise due to intra-class variations, imperfect correspondences, and limited templates. Observing that Retrieval-Augmented Generation (RAG) leverages retrieved samples directly in the generation process, we reinterpret UAD through this lens and introduce \\textbf{RAID}, a retrieval-augmented UAD framework designed for noise-resilient anomaly detection and localization. Unlike standard RAG that enriches context or knowledge, we focus on using retrieved normal samples to guide noise suppression in anomaly map generation. RAID retrieves class-, semantic-, and instance-level representations from a hierarchical vector database, forming a coarse-to-fine pipeline. A matching cost volume correlates the input with retrieved exemplars, followed by a guided Mixture-of-Experts (MoE) network that leverages the retrieved samples to adaptively suppress matching noise and produce fine-grained anomaly maps. RAID achieves state-of-the-art performance across full-shot, few-shot, and multi-dataset settings on MVTec, VisA, MPDD, and BTAD benchmarks. \\href{https://github.com/Mingxiu-Cai/RAID}{https://github.com/Mingxiu-Cai/RAID}."}],"geoLocations":[],"fundingReferences":[],"url":"https://arxiv.org/abs/2602.19611","contentUrl":null,"metadataVersion":0,"schemaVersion":"http://datacite.org/schema/kernel-4","source":"mds","isActive":true,"state":"findable","reason":null,"viewCount":0,"downloadCount":0,"referenceCount":0,"citationCount":0,"partCount":0,"partOfCount":0,"versionCount":0,"versionOfCount":0,"created":"2026-02-25T15:07:36Z","registered":"2026-02-25T15:07:36Z","published":null,"updated":"2026-02-25T15:07:36Z"},"relationships":{"client":{"data":{"id":"arxiv.content","type":"clients"}}}},{"id":"10.48550/arxiv.2602.19610","type":"dois","attributes":{"doi":"10.48550/arxiv.2602.19610","identifiers":[{"identifier":"2602.19610","identifierType":"arXiv"}],"creators":[{"nameType":"Personal","givenName":"Luigi","familyName":"Simeone","name":"Simeone, Luigi","affiliation":[],"nameIdentifiers":[]}],"titles":[{"title":"Variational Inference for Bayesian MIDAS Regression"}],"publisher":"arXiv","container":{},"publicationYear":2026,"subjects":[{"subject":"Machine Learning (cs.LG)","lang":"en","subjectScheme":"arXiv"},{"subject":"Computation (stat.CO)","lang":"en","subjectScheme":"arXiv"},{"subject":"Methodology (stat.ME)","lang":"en","subjectScheme":"arXiv"},{"subject":"Machine Learning (stat.ML)","lang":"en","subjectScheme":"arXiv"},{"subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"},{"schemeUri":"http://www.oecd.org/science/inno/38235147.pdf","subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"}],"contributors":[],"dates":[{"date":"2026-02-23T08:51:26Z","dateType":"Submitted","dateInformation":"v1"},{"date":"2026-02-24T05:04:06Z","dateType":"Updated","dateInformation":"v1"},{"date":"2026-02","dateType":"Available","dateInformation":"v1"},{"date":"2026","dateType":"Issued"}],"language":null,"types":{"schemaOrg":"CreativeWork","resourceTypeGeneral":"Preprint","citeproc":"article","bibtex":"misc","ris":"GEN","resourceType":"Article"},"relatedIdentifiers":[],"relatedItems":[],"sizes":[],"formats":[],"version":"1","rightsList":[{"rightsIdentifierScheme":"SPDX","rightsUri":"https://creativecommons.org/licenses/by-nc-nd/4.0/legalcode","schemeUri":"https://spdx.org/licenses/","rights":"Creative Commons Attribution Non Commercial No Derivatives 4.0 International","rightsIdentifier":"cc-by-nc-nd-4.0"}],"descriptions":[{"descriptionType":"Abstract","description":"We develop a Coordinate Ascent Variational Inference (CAVI) algorithm for Bayesian Mixed Data Sampling (MIDAS) regression with linear weight parameterizations. The model separates impact coeffcients from weighting function parameters through a normalization constraint, creating a bilinear structure that renders generic Hamiltonian Monte Carlo samplers unreliable while preserving conditional conjugacy exploitable by CAVI. Each variational update admits a closed-form solution: Gaussian for regression coefficients and weight parameters, Inverse-Gamma for the error variance. The algorithm propagates uncertainty across blocks through second moments, distinguishing it from naive plug-in approximations. In a Monte Carlo study spanning 21 data-generating configurations with up to 50 predictors, CAVI produces posterior means nearly identical to a block Gibbs sampler benchmark while achieving speedups of 107x to 1,772x (Table 9). Generic automatic differentiation VI (ADVI), by contrast, produces bias 714 times larger while being orders of magnitude slower, confirming the value of model-specific derivations. Weight function parameters maintain excellent calibration (coverage above 92%) across all configurations. Impact coefficient credible intervals exhibit the underdispersion characteristic of mean-field approximations, with coverage declining from 89% to 55% as the number of predictors grows a documented trade-off between speed and interval calibration that structured variational methods can address. An empirical application to realized volatility forecasting on S\u0026amp;P 500 daily returns cofirms that CAVI and Gibbs sampling yield virtually identical point forecasts, with CAVI completing each monthly estimation in under 10 milliseconds."},{"descriptionType":"Other","description":"27 pages, 11 figures"}],"geoLocations":[],"fundingReferences":[],"url":"https://arxiv.org/abs/2602.19610","contentUrl":null,"metadataVersion":0,"schemaVersion":"http://datacite.org/schema/kernel-4","source":"mds","isActive":true,"state":"findable","reason":null,"viewCount":0,"downloadCount":0,"referenceCount":0,"citationCount":0,"partCount":0,"partOfCount":0,"versionCount":0,"versionOfCount":0,"created":"2026-02-25T15:07:33Z","registered":"2026-02-25T15:07:34Z","published":null,"updated":"2026-02-25T15:07:34Z"},"relationships":{"client":{"data":{"id":"arxiv.content","type":"clients"}}}},{"id":"10.48550/arxiv.2602.19609","type":"dois","attributes":{"doi":"10.48550/arxiv.2602.19609","identifiers":[{"identifier":"2602.19609","identifierType":"arXiv"}],"creators":[{"nameType":"Personal","givenName":"Lara","familyName":"Bargmann","name":"Bargmann, Lara","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Heike","familyName":"Wehrheim","name":"Wehrheim, Heike","affiliation":[],"nameIdentifiers":[]}],"titles":[{"title":"Towards Proving Liveness on Weak Memory (Extended Version)"}],"publisher":"arXiv","container":{},"publicationYear":2026,"subjects":[{"subject":"Logic in Computer Science (cs.LO)","lang":"en","subjectScheme":"arXiv"},{"subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"},{"schemeUri":"http://www.oecd.org/science/inno/38235147.pdf","subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"}],"contributors":[],"dates":[{"date":"2026-02-23T08:51:13Z","dateType":"Submitted","dateInformation":"v1"},{"date":"2026-02-24T02:16:13Z","dateType":"Updated","dateInformation":"v1"},{"date":"2026-02","dateType":"Available","dateInformation":"v1"},{"date":"2026","dateType":"Issued"}],"language":null,"types":{"schemaOrg":"CreativeWork","resourceTypeGeneral":"Preprint","citeproc":"article","bibtex":"misc","ris":"GEN","resourceType":"Article"},"relatedIdentifiers":[],"relatedItems":[],"sizes":[],"formats":[],"version":"1","rightsList":[{"rightsIdentifierScheme":"SPDX","rightsUri":"https://creativecommons.org/licenses/by/4.0/legalcode","schemeUri":"https://spdx.org/licenses/","rights":"Creative Commons Attribution 4.0 International","rightsIdentifier":"cc-by-4.0"}],"descriptions":[{"descriptionType":"Abstract","description":"Reasoning about concurrent programs executed on weak memory models is an inherently complex task. So far, existing proof calculi for weak memory models only cover safety properties. In this paper, we provide the first proof calculus for reasoning about liveness. Our proof calculus is based on Manna and Pnueli's proof rules for response under weak fairness, formulated in linear temporal logic. Our extension includes the incorporation of memory fairness into rules as well as the usage of ranking functions defined over weak memory state. We have applied our reasoning technique to the Ticket lock algorithm and have proved it to guarantee starvation freedom under memory models Release-Acquire and StrongCoherence for any number of concurrent threads."}],"geoLocations":[],"fundingReferences":[],"url":"https://arxiv.org/abs/2602.19609","contentUrl":null,"metadataVersion":0,"schemaVersion":"http://datacite.org/schema/kernel-4","source":"mds","isActive":true,"state":"findable","reason":null,"viewCount":0,"downloadCount":0,"referenceCount":0,"citationCount":0,"partCount":0,"partOfCount":0,"versionCount":0,"versionOfCount":0,"created":"2026-02-25T15:07:31Z","registered":"2026-02-25T15:07:32Z","published":null,"updated":"2026-02-25T15:07:32Z"},"relationships":{"client":{"data":{"id":"arxiv.content","type":"clients"}}}},{"id":"10.48550/arxiv.2602.19608","type":"dois","attributes":{"doi":"10.48550/arxiv.2602.19608","identifiers":[{"identifier":"2602.19608","identifierType":"arXiv"}],"creators":[{"nameType":"Personal","givenName":"Girmaw Abebe","familyName":"Tadesse","name":"Tadesse, Girmaw Abebe","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Titien","familyName":"Bartette","name":"Bartette, Titien","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Andrew","familyName":"Hassanali","name":"Hassanali, Andrew","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Allen","familyName":"Kim","name":"Kim, Allen","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Jonathan","familyName":"Chemla","name":"Chemla, Jonathan","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Andrew","familyName":"Zolli","name":"Zolli, Andrew","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Yves","familyName":"Ubelmann","name":"Ubelmann, Yves","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Caleb","familyName":"Robinson","name":"Robinson, Caleb","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Inbal","familyName":"Becker-Reshef","name":"Becker-Reshef, Inbal","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Juan Lavista","familyName":"Ferres","name":"Ferres, Juan Lavista","affiliation":[],"nameIdentifiers":[]}],"titles":[{"title":"Satellite-Based Detection of Looted Archaeological Sites Using Machine Learning"}],"publisher":"arXiv","container":{},"publicationYear":2026,"subjects":[{"subject":"Computer Vision and Pattern Recognition (cs.CV)","lang":"en","subjectScheme":"arXiv"},{"subject":"Artificial Intelligence (cs.AI)","lang":"en","subjectScheme":"arXiv"},{"subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"},{"schemeUri":"http://www.oecd.org/science/inno/38235147.pdf","subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"}],"contributors":[],"dates":[{"date":"2026-02-23T08:50:07Z","dateType":"Submitted","dateInformation":"v1"},{"date":"2026-02-24T02:16:08Z","dateType":"Updated","dateInformation":"v1"},{"date":"2026-02","dateType":"Available","dateInformation":"v1"},{"date":"2026","dateType":"Issued"}],"language":null,"types":{"schemaOrg":"CreativeWork","resourceTypeGeneral":"Preprint","citeproc":"article","bibtex":"misc","ris":"GEN","resourceType":"Article"},"relatedIdentifiers":[],"relatedItems":[],"sizes":[],"formats":[],"version":"1","rightsList":[{"rightsIdentifierScheme":"SPDX","rightsUri":"https://creativecommons.org/licenses/by/4.0/legalcode","schemeUri":"https://spdx.org/licenses/","rights":"Creative Commons Attribution 4.0 International","rightsIdentifier":"cc-by-4.0"}],"descriptions":[{"descriptionType":"Abstract","description":"Looting at archaeological sites poses a severe risk to cultural heritage, yet monitoring thousands of remote locations remains operationally difficult. We present a scalable and satellite-based pipeline to detect looted archaeological sites, using PlanetScope monthly mosaics (4.7m/pixel) and a curated dataset of 1,943 archaeological sites in Afghanistan (898 looted, 1,045 preserved) with multi-year imagery (2016--2023) and site-footprint masks. We compare (i) end-to-end CNN classifiers trained on raw RGB patches and (ii) traditional machine learning (ML) trained on handcrafted spectral/texture features and embeddings from recent remote-sensing foundation models. Results indicate that ImageNet-pretrained CNNs combined with spatial masking reach an F1 score of 0.926, clearly surpassing the strongest traditional ML setup, which attains an F1 score of 0.710 using SatCLIP-V+RF+Mean, i.e., location and vision embeddings fed into a Random Forest with mean-based temporal aggregation. Ablation studies demonstrate that ImageNet pretraining (even in the presence of domain shift) and spatial masking enhance performance. In contrast, geospatial foundation model embeddings perform competitively with handcrafted features, suggesting that looting signatures are extremely localized. The repository is available at https://github.com/microsoft/looted_site_detection."}],"geoLocations":[],"fundingReferences":[],"url":"https://arxiv.org/abs/2602.19608","contentUrl":null,"metadataVersion":0,"schemaVersion":"http://datacite.org/schema/kernel-4","source":"mds","isActive":true,"state":"findable","reason":null,"viewCount":0,"downloadCount":0,"referenceCount":0,"citationCount":0,"partCount":0,"partOfCount":0,"versionCount":0,"versionOfCount":0,"created":"2026-02-25T15:07:28Z","registered":"2026-02-25T15:07:29Z","published":null,"updated":"2026-02-25T15:07:29Z"},"relationships":{"client":{"data":{"id":"arxiv.content","type":"clients"}}}},{"id":"10.48550/arxiv.2602.19607","type":"dois","attributes":{"doi":"10.48550/arxiv.2602.19607","identifiers":[{"identifier":"2602.19607","identifierType":"arXiv"}],"creators":[{"nameType":"Personal","givenName":"Jean-Christophe","familyName":"Bourin","name":"Bourin, Jean-Christophe","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Eun-Young","familyName":"Lee","name":"Lee, Eun-Young","affiliation":[],"nameIdentifiers":[]}],"titles":[{"title":"Triangle inequalities for the operator symmetric modulus"}],"publisher":"arXiv","container":{},"publicationYear":2026,"subjects":[{"subject":"Functional Analysis (math.FA)","lang":"en","subjectScheme":"arXiv"},{"subject":"FOS: Mathematics","subjectScheme":"Fields of Science and Technology (FOS)"},{"schemeUri":"http://www.oecd.org/science/inno/38235147.pdf","subject":"FOS: Mathematics","subjectScheme":"Fields of Science and Technology (FOS)"}],"contributors":[],"dates":[{"date":"2026-02-23T08:49:22Z","dateType":"Submitted","dateInformation":"v1"},{"date":"2026-02-24T02:16:07Z","dateType":"Updated","dateInformation":"v1"},{"date":"2026-02","dateType":"Available","dateInformation":"v1"},{"date":"2026","dateType":"Issued"}],"language":null,"types":{"schemaOrg":"CreativeWork","resourceTypeGeneral":"Preprint","citeproc":"article","bibtex":"misc","ris":"GEN","resourceType":"Article"},"relatedIdentifiers":[],"relatedItems":[],"sizes":[],"formats":[],"version":"1","rightsList":[{"rightsIdentifierScheme":"SPDX","rightsUri":"https://creativecommons.org/licenses/by-nc-sa/4.0/legalcode","schemeUri":"https://spdx.org/licenses/","rights":"Creative Commons Attribution Non Commercial Share Alike 4.0 International","rightsIdentifier":"cc-by-nc-sa-4.0"}],"descriptions":[{"descriptionType":"Abstract","description":"We study the operator symmetric modulus (|Z|+|Z^*|)/2 for matrices Z. Several triangle type inequalities are given."}],"geoLocations":[],"fundingReferences":[],"url":"https://arxiv.org/abs/2602.19607","contentUrl":null,"metadataVersion":0,"schemaVersion":"http://datacite.org/schema/kernel-4","source":"mds","isActive":true,"state":"findable","reason":null,"viewCount":0,"downloadCount":0,"referenceCount":0,"citationCount":0,"partCount":0,"partOfCount":0,"versionCount":0,"versionOfCount":0,"created":"2026-02-25T15:07:26Z","registered":"2026-02-25T15:07:27Z","published":null,"updated":"2026-02-25T15:07:27Z"},"relationships":{"client":{"data":{"id":"arxiv.content","type":"clients"}}}},{"id":"10.48550/arxiv.2602.19606","type":"dois","attributes":{"doi":"10.48550/arxiv.2602.19606","identifiers":[{"identifier":"2602.19606","identifierType":"arXiv"}],"creators":[{"nameType":"Personal","givenName":"Refat","familyName":"Othman","name":"Othman, Refat","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Diaeddin","familyName":"Rimawi","name":"Rimawi, Diaeddin","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Bruno","familyName":"Rossi","name":"Rossi, Bruno","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Barbara","familyName":"Russo","name":"Russo, Barbara","affiliation":[],"nameIdentifiers":[]}],"titles":[{"title":"Predicting known Vulnerabilities from Attack News: A Transformer-Based Approach"}],"publisher":"arXiv","container":{},"publicationYear":2026,"subjects":[{"subject":"Cryptography and Security (cs.CR)","lang":"en","subjectScheme":"arXiv"},{"subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"},{"schemeUri":"http://www.oecd.org/science/inno/38235147.pdf","subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"},{"subject":"K.6.5","lang":"en","subjectScheme":"ACM"}],"contributors":[],"dates":[{"date":"2026-02-23T08:47:48Z","dateType":"Submitted","dateInformation":"v1"},{"date":"2026-02-24T02:16:06Z","dateType":"Updated","dateInformation":"v1"},{"date":"2026-02","dateType":"Available","dateInformation":"v1"},{"date":"2026","dateType":"Issued"}],"language":null,"types":{"schemaOrg":"CreativeWork","resourceTypeGeneral":"Preprint","citeproc":"article","bibtex":"misc","ris":"GEN","resourceType":"Article"},"relatedIdentifiers":[],"relatedItems":[],"sizes":[],"formats":[],"version":"1","rightsList":[{"rightsUri":"http://arxiv.org/licenses/nonexclusive-distrib/1.0/","rights":"arXiv.org perpetual, non-exclusive license"}],"descriptions":[{"descriptionType":"Abstract","description":"Identifying the vulnerabilities exploited during cyberattacks is essential for enabling timely responses and effective mitigation in software security. This paper directly examines the process of predicting software vulnerabilities, specifically Common Vulnerabilities and Exposures (CVEs), from unstructured descriptions of attacks reported in cybersecurity news articles. We propose a semantic similarity-based approach utilizing the multi-qa-mpnet-base-dot-v1 (MPNet) sentence transformer model to generate a ranked list of the most likely CVEs corresponding to each news report. To assess the accuracy of the predicted vulnerabilities, we implement four complementary validation methods: filtering predictions based on similarity thresholds, conducting manual validation, performing semantic comparisons with the first vulnerability explicitly mentioned in each report, and comparing against all CVEs referenced within the report. Experimental results, drawn from a dataset of 100 SecurityWeek news articles, demonstrate that the model attains a precision of 81 percent when employing threshold-based filtering. Manual evaluations report that 70 percent of the predictions are relevant, while comparisons with the initially mentioned CVEs reveal agreement rates of 80 percent with the first listed vulnerability and 78 percent across all referenced CVEs. In 57 percent of the news reports analyzed, at least one predicted vulnerability precisely matched a CVE-ID mentioned in the article. These findings underscore the model's potential to facilitate automated vulnerability identification from real-world cyberattack news reports."}],"geoLocations":[],"fundingReferences":[],"url":"https://arxiv.org/abs/2602.19606","contentUrl":null,"metadataVersion":0,"schemaVersion":"http://datacite.org/schema/kernel-4","source":"mds","isActive":true,"state":"findable","reason":null,"viewCount":0,"downloadCount":0,"referenceCount":0,"citationCount":0,"partCount":0,"partOfCount":0,"versionCount":0,"versionOfCount":0,"created":"2026-02-25T15:07:23Z","registered":"2026-02-25T15:07:24Z","published":null,"updated":"2026-02-25T15:07:24Z"},"relationships":{"client":{"data":{"id":"arxiv.content","type":"clients"}}}},{"id":"10.48550/arxiv.2602.19605","type":"dois","attributes":{"doi":"10.48550/arxiv.2602.19605","identifiers":[{"identifier":"2602.19605","identifierType":"arXiv"}],"creators":[{"nameType":"Personal","givenName":"Chunlei","familyName":"Meng","name":"Meng, Chunlei","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Guanhong","familyName":"Huang","name":"Huang, Guanhong","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Rong","familyName":"Fu","name":"Fu, Rong","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Runmin","familyName":"Jian","name":"Jian, Runmin","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Zhongxue","familyName":"Gan","name":"Gan, Zhongxue","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Chun","familyName":"Ouyang","name":"Ouyang, Chun","affiliation":[],"nameIdentifiers":[]}],"titles":[{"title":"CLCR: Cross-Level Semantic Collaborative Representation for Multimodal Learning"}],"publisher":"arXiv","container":{},"publicationYear":2026,"subjects":[{"subject":"Computer Vision and Pattern Recognition (cs.CV)","lang":"en","subjectScheme":"arXiv"},{"subject":"Artificial Intelligence (cs.AI)","lang":"en","subjectScheme":"arXiv"},{"subject":"Multimedia (cs.MM)","lang":"en","subjectScheme":"arXiv"},{"subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"},{"schemeUri":"http://www.oecd.org/science/inno/38235147.pdf","subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"}],"contributors":[],"dates":[{"date":"2026-02-23T08:47:19Z","dateType":"Submitted","dateInformation":"v1"},{"date":"2026-02-24T02:16:02Z","dateType":"Updated","dateInformation":"v1"},{"date":"2026-02","dateType":"Available","dateInformation":"v1"},{"date":"2026","dateType":"Issued"}],"language":null,"types":{"schemaOrg":"CreativeWork","resourceTypeGeneral":"Preprint","citeproc":"article","bibtex":"misc","ris":"GEN","resourceType":"Article"},"relatedIdentifiers":[],"relatedItems":[],"sizes":[],"formats":[],"version":"1","rightsList":[{"rightsUri":"http://arxiv.org/licenses/nonexclusive-distrib/1.0/","rights":"arXiv.org perpetual, non-exclusive license"}],"descriptions":[{"descriptionType":"Abstract","description":"Multimodal learning aims to capture both shared and private information from multiple modalities. However, existing methods that project all modalities into a single latent space for fusion often overlook the asynchronous, multi-level semantic structure of multimodal data. This oversight induces semantic misalignment and error propagation, thereby degrading representation quality. To address this issue, we propose Cross-Level Co-Representation (CLCR), which explicitly organizes each modality's features into a three-level semantic hierarchy and specifies level-wise constraints for cross-modal interactions. First, a semantic hierarchy encoder aligns shallow, mid, and deep features across modalities, establishing a common basis for interaction. And then, at each level, an Intra-Level Co-Exchange Domain (IntraCED) factorizes features into shared and private subspaces and restricts cross-modal attention to the shared subspace via a learnable token budget. This design ensures that only shared semantics are exchanged and prevents leakage from private channels. To integrate information across levels, the Inter-Level Co-Aggregation Domain (InterCAD) synchronizes semantic scales using learned anchors, selectively fuses the shared representations, and gates private cues to form a compact task representation. We further introduce regularization terms to enforce separation of shared and private features and to minimize cross-level interference. Experiments on six benchmarks spanning emotion recognition, event localization, sentiment analysis, and action recognition show that CLCR achieves strong performance and generalizes well across tasks."},{"descriptionType":"Other","description":"This study has been Accepted by CVPR 2026"}],"geoLocations":[],"fundingReferences":[],"url":"https://arxiv.org/abs/2602.19605","contentUrl":null,"metadataVersion":0,"schemaVersion":"http://datacite.org/schema/kernel-4","source":"mds","isActive":true,"state":"findable","reason":null,"viewCount":0,"downloadCount":0,"referenceCount":0,"citationCount":0,"partCount":0,"partOfCount":0,"versionCount":0,"versionOfCount":0,"created":"2026-02-25T15:07:21Z","registered":"2026-02-25T15:07:22Z","published":null,"updated":"2026-02-25T15:07:22Z"},"relationships":{"client":{"data":{"id":"arxiv.content","type":"clients"}}}},{"id":"10.48550/arxiv.2602.19604","type":"dois","attributes":{"doi":"10.48550/arxiv.2602.19604","identifiers":[{"identifier":"2602.19604","identifierType":"arXiv"}],"creators":[{"nameType":"Personal","givenName":"Kaiwen","familyName":"Wang","name":"Wang, Kaiwen","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Xiaolin","familyName":"Chang","name":"Chang, Xiaolin","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Yuehan","familyName":"Dong","name":"Dong, Yuehan","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Ruichen","familyName":"Zhang","name":"Zhang, Ruichen","affiliation":[],"nameIdentifiers":[]}],"titles":[{"title":"Efficient Multi-Party Secure Comparison over Different Domains with Preprocessing Assistance"}],"publisher":"arXiv","container":{},"publicationYear":2026,"subjects":[{"subject":"Cryptography and Security (cs.CR)","lang":"en","subjectScheme":"arXiv"},{"subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"},{"schemeUri":"http://www.oecd.org/science/inno/38235147.pdf","subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"}],"contributors":[],"dates":[{"date":"2026-02-23T08:45:47Z","dateType":"Submitted","dateInformation":"v1"},{"date":"2026-02-24T02:15:59Z","dateType":"Updated","dateInformation":"v1"},{"date":"2026-02","dateType":"Available","dateInformation":"v1"},{"date":"2026","dateType":"Issued"}],"language":null,"types":{"schemaOrg":"CreativeWork","resourceTypeGeneral":"Preprint","citeproc":"article","bibtex":"misc","ris":"GEN","resourceType":"Article"},"relatedIdentifiers":[],"relatedItems":[],"sizes":[],"formats":[],"version":"1","rightsList":[{"rightsUri":"http://arxiv.org/licenses/nonexclusive-distrib/1.0/","rights":"arXiv.org perpetual, non-exclusive license"}],"descriptions":[{"descriptionType":"Abstract","description":"Secure comparison is a fundamental primitive in multi-party computation, supporting privacy-preserving applications such as machine learning and data analytics. A critical performance bottleneck in comparison protocols is their preprocessing phase, primarily due to the high cost of generating the necessary correlated randomness. Recent frameworks introduce a passive, non-colluding dealer to accelerate preprocessing. However, two key issues still remain. First, existing dealer-assisted approaches treat the dealer as a drop-in replacement for conventional preprocessing without redesigning the comparison protocol to optimize the online phase. Second, most protocols are specialized for particular algebraic domains, adversary models, or party configurations, lacking broad generality. In this work, we present the first dealer-assisted $n$-party LTBits (Less-Than-Bits) and MSB (Most Significant Bit) extraction protocols over both $\\mathbb{F}_p$ and $\\mathbb{Z}_{2^k}$, achieving perfect security at the protocol level. By fully exploiting the dealer's capability to generate rich correlated randomness, our $\\mathbb{F}_p$ construction achieves constant-round online complexity and our $\\mathbb{Z}_{2^k}$ construction achieves $O(\\log_n k)$ rounds with tunable branching factor. All protocols are formulated as black-box constructions via an extended ABB model, ensuring portability across MPC backends and adversary models. Experimental results demonstrate $1.79\\times$ to $19.4\\times$ speedups over state-of-the-art MPC frameworks, highlighting the practicality of our protocols for comparison-intensive MPC applications."},{"descriptionType":"Other","description":"12 pages, 4 figures"}],"geoLocations":[],"fundingReferences":[],"url":"https://arxiv.org/abs/2602.19604","contentUrl":null,"metadataVersion":0,"schemaVersion":"http://datacite.org/schema/kernel-4","source":"mds","isActive":true,"state":"findable","reason":null,"viewCount":0,"downloadCount":0,"referenceCount":0,"citationCount":0,"partCount":0,"partOfCount":0,"versionCount":0,"versionOfCount":0,"created":"2026-02-25T15:07:19Z","registered":"2026-02-25T15:07:19Z","published":null,"updated":"2026-02-25T15:07:19Z"},"relationships":{"client":{"data":{"id":"arxiv.content","type":"clients"}}}},{"id":"10.48550/arxiv.2602.19603","type":"dois","attributes":{"doi":"10.48550/arxiv.2602.19603","identifiers":[{"identifier":"2602.19603","identifierType":"arXiv"}],"creators":[{"nameType":"Personal","givenName":"Kasra","familyName":"Ekrad","name":"Ekrad, Kasra","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Bjarne","familyName":"Johansson","name":"Johansson, Bjarne","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Inés Alvarez","familyName":"Vadillo","name":"Vadillo, Inés Alvarez","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Saad","familyName":"Mubeen","name":"Mubeen, Saad","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Mohammad","familyName":"Ashjaei","name":"Ashjaei, Mohammad","affiliation":[],"nameIdentifiers":[]}],"titles":[{"title":"Traffic-Aware Configuration of OPC UA PubSub in Industrial Automation Networks"}],"publisher":"arXiv","container":{},"publicationYear":2026,"subjects":[{"subject":"Networking and Internet Architecture (cs.NI)","lang":"en","subjectScheme":"arXiv"},{"subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"},{"schemeUri":"http://www.oecd.org/science/inno/38235147.pdf","subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"},{"subject":"C.2.0, C.2.1, C.2.2, C.2.4","lang":"en","subjectScheme":"MSC"}],"contributors":[],"dates":[{"date":"2026-02-23T08:45:32Z","dateType":"Submitted","dateInformation":"v1"},{"date":"2026-02-24T02:15:58Z","dateType":"Updated","dateInformation":"v1"},{"date":"2026-02","dateType":"Available","dateInformation":"v1"},{"date":"2026","dateType":"Issued"}],"language":null,"types":{"schemaOrg":"CreativeWork","resourceTypeGeneral":"Preprint","citeproc":"article","bibtex":"misc","ris":"GEN","resourceType":"Article"},"relatedIdentifiers":[],"relatedItems":[],"sizes":[],"formats":[],"version":"1","rightsList":[{"rightsUri":"http://arxiv.org/licenses/nonexclusive-distrib/1.0/","rights":"arXiv.org perpetual, non-exclusive license"}],"descriptions":[{"descriptionType":"Abstract","description":"Interoperability across industrial automation systems is a cornerstone of Industry 4.0. To address this need, the OPC Unified Architecture (OPC UA) Publish-Subscribe (PubSub) model offers a promising mechanism for enabling efficient communication among heterogeneous devices. PubSub facilitates resource sharing and communication configuration between devices, but it lacks clear guidelines for mapping diverse industrial traffic types to appropriate PubSub configurations. This gap can lead to misconfigurations that degrade network performance and compromise real-time requirements. This paper proposes a set of guidelines for mapping industrial traffic types, based on their timing and quality-of-service specifications, to OPC UA PubSub configurations. The goal is to ensure predictable communication and support real-time performance in industrial networks. The proposed guidelines are evaluated through an industrial use case that demonstrates the impact of incorrect configuration on latency and throughput. The results underline the importance of traffic-aware PubSub configuration for achieving interoperability in Industry 4.0 systems."},{"descriptionType":"Other","description":"8 pages, 2 figures, IEEE International Conference on Industrial Technology (ICIT 2026)"}],"geoLocations":[],"fundingReferences":[],"url":"https://arxiv.org/abs/2602.19603","contentUrl":null,"metadataVersion":0,"schemaVersion":"http://datacite.org/schema/kernel-4","source":"mds","isActive":true,"state":"findable","reason":null,"viewCount":0,"downloadCount":0,"referenceCount":0,"citationCount":0,"partCount":0,"partOfCount":0,"versionCount":0,"versionOfCount":0,"created":"2026-02-25T15:07:16Z","registered":"2026-02-25T15:07:17Z","published":null,"updated":"2026-02-25T15:07:17Z"},"relationships":{"client":{"data":{"id":"arxiv.content","type":"clients"}}}},{"id":"10.48550/arxiv.2602.19602","type":"dois","attributes":{"doi":"10.48550/arxiv.2602.19602","identifiers":[{"identifier":"2602.19602","identifierType":"arXiv"}],"creators":[{"nameType":"Personal","givenName":"Philipp","familyName":"Hieronymi","name":"Hieronymi, Philipp","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Michael","familyName":"Reitmeir","name":"Reitmeir, Michael","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Xiaoduo","familyName":"Wang","name":"Wang, Xiaoduo","affiliation":[],"nameIdentifiers":[]}],"titles":[{"title":"Axiomatizations of Presburger Arithmetic With Predicates For Powers"}],"publisher":"arXiv","container":{},"publicationYear":2026,"subjects":[{"subject":"Logic (math.LO)","lang":"en","subjectScheme":"arXiv"},{"subject":"FOS: Mathematics","subjectScheme":"Fields of Science and Technology (FOS)"},{"schemeUri":"http://www.oecd.org/science/inno/38235147.pdf","subject":"FOS: Mathematics","subjectScheme":"Fields of Science and Technology (FOS)"},{"subject":"03B25, 03C10","lang":"en","subjectScheme":"MSC"}],"contributors":[],"dates":[{"date":"2026-02-23T08:44:01Z","dateType":"Submitted","dateInformation":"v1"},{"date":"2026-02-24T02:15:55Z","dateType":"Updated","dateInformation":"v1"},{"date":"2026-02","dateType":"Available","dateInformation":"v1"},{"date":"2026","dateType":"Issued"}],"language":null,"types":{"schemaOrg":"CreativeWork","resourceTypeGeneral":"Preprint","citeproc":"article","bibtex":"misc","ris":"GEN","resourceType":"Article"},"relatedIdentifiers":[],"relatedItems":[],"sizes":[],"formats":[],"version":"1","rightsList":[{"rightsUri":"http://arxiv.org/licenses/nonexclusive-distrib/1.0/","rights":"arXiv.org perpetual, non-exclusive license"}],"descriptions":[{"descriptionType":"Abstract","description":"We give a complete first-order axiomatization of the structure $(\\mathbb{Z},+,(\\ell^{\\mathbb{N}})_{\\ell\\in L})$, where $L \\subseteq \\mathbb{Z}_{\\ge 2}$ is a set of pairwise multiplicatively independent integers and $\\ell^{\\mathbb{N}} = \\{\\ell^n : n\\in \\mathbb{N}\\}$. Using recent work of Karimov et al., we obtain that this axiomatization is computable for $|L|=2$, which proves that $(\\mathbb{Z},+,k^{\\mathbb{N}}, \\ell^{\\mathbb{N}})$ is decidable for $k, \\ell\\in \\mathbb{Z}_{\\ge 2}$. Furthermore, we give an axiomatization of the universal theory of $(\\mathbb{Z},+,\u0026lt;,(\\ell^{\\mathbb{N}})_{\\ell\\in L})$."}],"geoLocations":[],"fundingReferences":[],"url":"https://arxiv.org/abs/2602.19602","contentUrl":null,"metadataVersion":0,"schemaVersion":"http://datacite.org/schema/kernel-4","source":"mds","isActive":true,"state":"findable","reason":null,"viewCount":0,"downloadCount":0,"referenceCount":0,"citationCount":0,"partCount":0,"partOfCount":0,"versionCount":0,"versionOfCount":0,"created":"2026-02-25T15:07:13Z","registered":"2026-02-25T15:07:14Z","published":null,"updated":"2026-02-25T15:07:14Z"},"relationships":{"client":{"data":{"id":"arxiv.content","type":"clients"}}}},{"id":"10.48550/arxiv.2602.19601","type":"dois","attributes":{"doi":"10.48550/arxiv.2602.19601","identifiers":[{"identifier":"2602.19601","identifierType":"arXiv"}],"creators":[{"nameType":"Personal","givenName":"Y.","familyName":"Chapovskyi","name":"Chapovskyi, Y.","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"A.","familyName":"Petravchuk","name":"Petravchuk, A.","affiliation":[],"nameIdentifiers":[]}],"titles":[{"title":"A family of maximal subalgebras of the Lie algebra~$W_n(K)$"}],"publisher":"arXiv","container":{},"publicationYear":2026,"subjects":[{"subject":"Rings and Algebras (math.RA)","lang":"en","subjectScheme":"arXiv"},{"subject":"FOS: Mathematics","subjectScheme":"Fields of Science and Technology (FOS)"},{"schemeUri":"http://www.oecd.org/science/inno/38235147.pdf","subject":"FOS: Mathematics","subjectScheme":"Fields of Science and Technology (FOS)"},{"subject":"17B65, 17B66, 17B05","lang":"en","subjectScheme":"MSC"}],"contributors":[],"dates":[{"date":"2026-02-23T08:43:16Z","dateType":"Submitted","dateInformation":"v1"},{"date":"2026-02-24T02:15:55Z","dateType":"Updated","dateInformation":"v1"},{"date":"2026-02","dateType":"Available","dateInformation":"v1"},{"date":"2026","dateType":"Issued"}],"language":null,"types":{"schemaOrg":"CreativeWork","resourceTypeGeneral":"Preprint","citeproc":"article","bibtex":"misc","ris":"GEN","resourceType":"Article"},"relatedIdentifiers":[],"relatedItems":[],"sizes":[],"formats":[],"version":"1","rightsList":[{"rightsIdentifierScheme":"SPDX","rightsUri":"https://creativecommons.org/licenses/by/4.0/legalcode","schemeUri":"https://spdx.org/licenses/","rights":"Creative Commons Attribution 4.0 International","rightsIdentifier":"cc-by-4.0"}],"descriptions":[{"descriptionType":"Abstract","description":"Let $K$ be an algebraically closed field of characteristic zero and ${P_n=K[x_1,\\ldots,x_n]}$ the polynomial ring. Any $K$-derivation $D$ on $P_n$ is of the form ${ D=\\sum_{i=1}^n f_i(x_1,\\ldots,x_n)\\frac{\\partial}{\\partial x_i} },$ where $f_i\\in P_n.$ All such derivations form the Lie algebra $W_n(K)$ over the field $K$. We prove that for $s=1,\\ldots,n-1$ the subalgebra $\nm_s(K)=\\left\\{ \\sum_{i=1}^s f_i\\frac{\\partial}{\\partial x_i} +\\sum_{j=s+1}^n g_j\\frac{\\partial}{\\partial x_j} \\mid f_i\\in P_s,\\ g_j\\in P_n \\right\\} $\nis a maximal subalgebra of~$W_n(K)$. The ideal $\nI_s=\\left\\{\\sum_{j=s+1}^n g_j\\frac{\\partial}{\\partial x_j}\\right\\} $\nof $m_s(K)$ is isomorphic to the Lie algebra $P_s\\otimes \\mathrm{Der}(K[x_{s+1},\\ldots,x_n])$ and $m_s(K)/I_s\\simeq W_s(K)$. The Lie algebra $W_n(K)$ is also the free module over the ring $P_n.$ Therefore, for any set $S\\subseteq W_n(K)$ the rank $rk(S)$ (over $P_n$) is defined. Some properties of maximal subalgebras of rank $n$ in $W_n(K)$ are pointed out."}],"geoLocations":[],"fundingReferences":[],"url":"https://arxiv.org/abs/2602.19601","contentUrl":null,"metadataVersion":0,"schemaVersion":"http://datacite.org/schema/kernel-4","source":"mds","isActive":true,"state":"findable","reason":null,"viewCount":0,"downloadCount":0,"referenceCount":0,"citationCount":0,"partCount":0,"partOfCount":0,"versionCount":0,"versionOfCount":0,"created":"2026-02-25T15:07:11Z","registered":"2026-02-25T15:07:12Z","published":null,"updated":"2026-02-25T15:07:12Z"},"relationships":{"client":{"data":{"id":"arxiv.content","type":"clients"}}}},{"id":"10.48550/arxiv.2602.19599","type":"dois","attributes":{"doi":"10.48550/arxiv.2602.19599","identifiers":[{"identifier":"2602.19599","identifierType":"arXiv"}],"creators":[{"nameType":"Personal","givenName":"Jean-Christophe","familyName":"Bourin","name":"Bourin, Jean-Christophe","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Eun-Young","familyName":"Lee","name":"Lee, Eun-Young","affiliation":[],"nameIdentifiers":[]}],"titles":[{"title":"Involutions and angles between subspaces"}],"publisher":"arXiv","container":{},"publicationYear":2026,"subjects":[{"subject":"Functional Analysis (math.FA)","lang":"en","subjectScheme":"arXiv"},{"subject":"FOS: Mathematics","subjectScheme":"Fields of Science and Technology (FOS)"},{"schemeUri":"http://www.oecd.org/science/inno/38235147.pdf","subject":"FOS: Mathematics","subjectScheme":"Fields of Science and Technology (FOS)"}],"contributors":[],"dates":[{"date":"2026-02-23T08:41:35Z","dateType":"Submitted","dateInformation":"v1"},{"date":"2026-02-24T02:15:47Z","dateType":"Updated","dateInformation":"v1"},{"date":"2026-02","dateType":"Available","dateInformation":"v1"},{"date":"2026","dateType":"Issued"}],"language":null,"types":{"schemaOrg":"CreativeWork","resourceTypeGeneral":"Preprint","citeproc":"article","bibtex":"misc","ris":"GEN","resourceType":"Article"},"relatedIdentifiers":[],"relatedItems":[],"sizes":[],"formats":[],"version":"1","rightsList":[{"rightsIdentifierScheme":"SPDX","rightsUri":"https://creativecommons.org/licenses/by-nc-sa/4.0/legalcode","schemeUri":"https://spdx.org/licenses/","rights":"Creative Commons Attribution Non Commercial Share Alike 4.0 International","rightsIdentifier":"cc-by-nc-sa-4.0"}],"descriptions":[{"descriptionType":"Abstract","description":"We provide a complete structure theorem for involutory matrices. This yields a new approach to principal angles between subspaces and provide a series of nice formulae for these angles."},{"descriptionType":"Other","description":"Some questions (at the end of the paper) on dilation into involutions have been completly answered in a recently published note by the author. (Dilating contractions into involutions and contraction, Linear Algebra Appl. 2026)"}],"geoLocations":[],"fundingReferences":[],"url":"https://arxiv.org/abs/2602.19599","contentUrl":null,"metadataVersion":0,"schemaVersion":"http://datacite.org/schema/kernel-4","source":"mds","isActive":true,"state":"findable","reason":null,"viewCount":0,"downloadCount":0,"referenceCount":0,"citationCount":0,"partCount":0,"partOfCount":0,"versionCount":0,"versionOfCount":0,"created":"2026-02-25T15:07:06Z","registered":"2026-02-25T15:07:07Z","published":null,"updated":"2026-02-25T15:07:07Z"},"relationships":{"client":{"data":{"id":"arxiv.content","type":"clients"}}}},{"id":"10.48550/arxiv.2602.19597","type":"dois","attributes":{"doi":"10.48550/arxiv.2602.19597","identifiers":[{"identifier":"2602.19597","identifierType":"arXiv"}],"creators":[{"nameType":"Personal","givenName":"Giacomo","familyName":"Bottacini","name":"Bottacini, Giacomo","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Matteo","familyName":"Torzoni","name":"Torzoni, Matteo","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Andrea","familyName":"Manzoni","name":"Manzoni, Andrea","affiliation":[],"nameIdentifiers":[]}],"titles":[{"title":"Neural Markov chain Monte Carlo: Bayesian inversion via normalizing flows and variational autoencoders"}],"publisher":"arXiv","container":{},"publicationYear":2026,"subjects":[{"subject":"Computational Engineering, Finance, and Science (cs.CE)","lang":"en","subjectScheme":"arXiv"},{"subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"},{"schemeUri":"http://www.oecd.org/science/inno/38235147.pdf","subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"}],"contributors":[],"dates":[{"date":"2026-02-23T08:39:17Z","dateType":"Submitted","dateInformation":"v1"},{"date":"2026-02-24T02:15:42Z","dateType":"Updated","dateInformation":"v1"},{"date":"2026-02","dateType":"Available","dateInformation":"v1"},{"date":"2026","dateType":"Issued"}],"language":null,"types":{"schemaOrg":"CreativeWork","resourceTypeGeneral":"Preprint","citeproc":"article","bibtex":"misc","ris":"GEN","resourceType":"Article"},"relatedIdentifiers":[],"relatedItems":[],"sizes":[],"formats":[],"version":"1","rightsList":[{"rightsUri":"http://arxiv.org/licenses/nonexclusive-distrib/1.0/","rights":"arXiv.org perpetual, non-exclusive license"}],"descriptions":[{"descriptionType":"Abstract","description":"This paper introduces a Bayesian framework that combines Markov chain Monte Carlo (MCMC) sampling, dimensionality reduction, and neural density estimation to efficiently handle inverse problems that (i) must be solved multiple times, and (ii) are characterized by intractable or unavailable likelihood functions. The posterior probability distribution over quantities of interest is estimated via differential evolution Metropolis sampling, empowered by learnable mappings. First, a variational autoencoder performs probabilistic feature extraction from observational data. The resulting latent structure inherently quantifies uncertainty, capturing deviations between the actual data-generating process and the training data distribution. At each step of the MCMC random walk, the algorithm jointly samples from the data-informed latent distribution and the space of parameters to be inferred. These samples are fed into a neural likelihood estimator based on normalizing flows, specifically real-valued non-volume preserving transformations. The scaling and translation functions of the affine coupling layers are modeled by neural networks conditioned on the unknown parameters, allowing the representation of arbitrary observation likelihoods. The proposed methodology is validated on two case studies: (i) structural health monitoring of a railway bridge for damage detection, localization, and quantification, and (ii) estimation of the conductivity field in a steady-state Darcy's groundwater flow problem. The results demonstrate the efficiency of the inference strategy, while ensuring that model-reality mismatches do not yield overconfident, yet inaccurate, estimates."}],"geoLocations":[],"fundingReferences":[],"url":"https://arxiv.org/abs/2602.19597","contentUrl":null,"metadataVersion":0,"schemaVersion":"http://datacite.org/schema/kernel-4","source":"mds","isActive":true,"state":"findable","reason":null,"viewCount":0,"downloadCount":0,"referenceCount":0,"citationCount":0,"partCount":0,"partOfCount":0,"versionCount":0,"versionOfCount":0,"created":"2026-02-25T15:07:01Z","registered":"2026-02-25T15:07:02Z","published":null,"updated":"2026-02-25T15:07:02Z"},"relationships":{"client":{"data":{"id":"arxiv.content","type":"clients"}}}},{"id":"10.48550/arxiv.2602.19596","type":"dois","attributes":{"doi":"10.48550/arxiv.2602.19596","identifiers":[{"identifier":"2602.19596","identifierType":"arXiv"}],"creators":[{"nameType":"Personal","givenName":"Yihang","familyName":"Tao","name":"Tao, Yihang","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Senkang","familyName":"Hu","name":"Hu, Senkang","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Haonan","familyName":"An","name":"An, Haonan","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Zhengru","familyName":"Fang","name":"Fang, Zhengru","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Hangcheng","familyName":"Cao","name":"Cao, Hangcheng","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Yuguang","familyName":"Fang","name":"Fang, Yuguang","affiliation":[],"nameIdentifiers":[]}],"titles":[{"title":"Learning Mutual View Information Graph for Adaptive Adversarial Collaborative Perception"}],"publisher":"arXiv","container":{},"publicationYear":2026,"subjects":[{"subject":"Computer Vision and Pattern Recognition (cs.CV)","lang":"en","subjectScheme":"arXiv"},{"subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"},{"schemeUri":"http://www.oecd.org/science/inno/38235147.pdf","subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"}],"contributors":[],"dates":[{"date":"2026-02-23T08:38:27Z","dateType":"Submitted","dateInformation":"v1"},{"date":"2026-02-24T02:15:40Z","dateType":"Updated","dateInformation":"v1"},{"date":"2026-02","dateType":"Available","dateInformation":"v1"},{"date":"2026","dateType":"Issued"}],"language":null,"types":{"schemaOrg":"CreativeWork","resourceTypeGeneral":"Preprint","citeproc":"article","bibtex":"misc","ris":"GEN","resourceType":"Article"},"relatedIdentifiers":[],"relatedItems":[],"sizes":[],"formats":[],"version":"1","rightsList":[{"rightsUri":"http://arxiv.org/licenses/nonexclusive-distrib/1.0/","rights":"arXiv.org perpetual, non-exclusive license"}],"descriptions":[{"descriptionType":"Abstract","description":"Collaborative perception (CP) enables data sharing among connected and autonomous vehicles (CAVs) to enhance driving safety. However, CP systems are vulnerable to adversarial attacks where malicious agents forge false objects via feature-level perturbations. Current defensive systems use threshold-based consensus verification by comparing collaborative and ego detection results. Yet, these defenses remain vulnerable to more sophisticated attack strategies that could exploit two critical weaknesses: (i) lack of robustness against attacks with systematic timing and target region optimization, and (ii) inadvertent disclosure of vulnerability knowledge through implicit confidence information in shared collaboration data. In this paper, we propose MVIG attack, a novel adaptive adversarial CP framework learning to capture vulnerability knowledge disclosed by different defensive CP systems from a unified mutual view information graph (MVIG) representation. Our approach combines MVIG representation with temporal graph learning to generate evolving fabrication risk maps and employs entropy-aware vulnerability search to optimize attack location, timing and persistence, enabling adaptive attacks with generalizability across various defensive configurations. Extensive evaluations on OPV2V and Adv-OPV2V datasets demonstrate that MVIG attack reduces defense success rates by up to 62\\% against state-of-the-art defenses while achieving 47\\% lower detection for persistent attacks at 29.9 FPS, exposing critical security gaps in CP systems. Code will be released at https://github.com/yihangtao/MVIG.git"},{"descriptionType":"Other","description":"Accepted by CVPR'26"}],"geoLocations":[],"fundingReferences":[],"url":"https://arxiv.org/abs/2602.19596","contentUrl":null,"metadataVersion":0,"schemaVersion":"http://datacite.org/schema/kernel-4","source":"mds","isActive":true,"state":"findable","reason":null,"viewCount":0,"downloadCount":0,"referenceCount":0,"citationCount":0,"partCount":0,"partOfCount":0,"versionCount":0,"versionOfCount":0,"created":"2026-02-25T15:06:58Z","registered":"2026-02-25T15:06:59Z","published":null,"updated":"2026-02-25T15:06:59Z"},"relationships":{"client":{"data":{"id":"arxiv.content","type":"clients"}}}},{"id":"10.48550/arxiv.2602.19595","type":"dois","attributes":{"doi":"10.48550/arxiv.2602.19595","identifiers":[{"identifier":"2602.19595","identifierType":"arXiv"}],"creators":[{"nameType":"Personal","givenName":"Dávid","familyName":"Ferenczi","name":"Ferenczi, Dávid","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Alexander","familyName":"Grigoriev","name":"Grigoriev, Alexander","affiliation":[],"nameIdentifiers":[]}],"titles":[{"title":"Constrained graph generation: Preserving diameter and clustering coefficient simultaneously"}],"publisher":"arXiv","container":{},"publicationYear":2026,"subjects":[{"subject":"Social and Information Networks (cs.SI)","lang":"en","subjectScheme":"arXiv"},{"subject":"Discrete Mathematics (cs.DM)","lang":"en","subjectScheme":"arXiv"},{"subject":"Probability (math.PR)","lang":"en","subjectScheme":"arXiv"},{"subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"},{"schemeUri":"http://www.oecd.org/science/inno/38235147.pdf","subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"},{"subject":"FOS: Mathematics","subjectScheme":"Fields of Science and Technology (FOS)"},{"schemeUri":"http://www.oecd.org/science/inno/38235147.pdf","subject":"FOS: Mathematics","subjectScheme":"Fields of Science and Technology (FOS)"},{"subject":"G.2.2; G.3","lang":"en","subjectScheme":"ACM"},{"subject":"05C80, 65C05","lang":"en","subjectScheme":"MSC"}],"contributors":[],"dates":[{"date":"2026-02-23T08:37:55Z","dateType":"Submitted","dateInformation":"v1"},{"date":"2026-02-24T02:15:38Z","dateType":"Updated","dateInformation":"v1"},{"date":"2026-02","dateType":"Available","dateInformation":"v1"},{"date":"2026","dateType":"Issued"}],"language":null,"types":{"schemaOrg":"CreativeWork","resourceTypeGeneral":"Preprint","citeproc":"article","bibtex":"misc","ris":"GEN","resourceType":"Article"},"relatedIdentifiers":[],"relatedItems":[],"sizes":[],"formats":[],"version":"1","rightsList":[{"rightsUri":"http://arxiv.org/licenses/nonexclusive-distrib/1.0/","rights":"arXiv.org perpetual, non-exclusive license"}],"descriptions":[{"descriptionType":"Abstract","description":"Generating graphs subject to strict structural constraints is a fundamental computational challenge in network science. Simultaneously preserving interacting properties-such as the diameter and the clustering coefficient- is particularly demanding. Simple constructive algorithms often fail to locate vanishingly small sets of feasible graphs, while traditional Markov-chain Monte Carlo (MCMC) samplers suffer from severe ergodicity breaking. In this paper, we propose a two-step hybrid framework combining Ant Colony Optimization (ACO) and MCMC sampling. First, we design a layered ACO heuristic to perform a guided global search, effectively locating valid graphs with prescribed diameter and clustering coefficient. Second, we use these ACO-designed graphs as structurally distinct seed states for an MCMC rewiring algorithm. We evaluate this framework across a wide range of graph edge densities and varying diameter-clustering-coefficient constraint regimes. Using the spectral distance of the normalized Laplacian to quantify structural diversity of the resulting graphs, our experiments reveal a sharp contrast between the methods. Standard MCMC samplers remain rigidly trapped in an isolated subset of feasible graphs around their initial seeds. Conversely, our hybrid ACO-MCMC approach successfully bridges disconnected configuration landscapes, generating a vastly richer and structurally diverse set of valid graphs."},{"descriptionType":"Other","description":"15 pages, 5 figures"}],"geoLocations":[],"fundingReferences":[],"url":"https://arxiv.org/abs/2602.19595","contentUrl":null,"metadataVersion":0,"schemaVersion":"http://datacite.org/schema/kernel-4","source":"mds","isActive":true,"state":"findable","reason":null,"viewCount":0,"downloadCount":0,"referenceCount":0,"citationCount":0,"partCount":0,"partOfCount":0,"versionCount":0,"versionOfCount":0,"created":"2026-02-25T15:06:56Z","registered":"2026-02-25T15:06:57Z","published":null,"updated":"2026-02-25T15:06:57Z"},"relationships":{"client":{"data":{"id":"arxiv.content","type":"clients"}}}},{"id":"10.48550/arxiv.2602.19594","type":"dois","attributes":{"doi":"10.48550/arxiv.2602.19594","identifiers":[{"identifier":"2602.19594","identifierType":"arXiv"}],"creators":[{"nameType":"Personal","givenName":"Ayush","familyName":"Nangia","name":"Nangia, Ayush","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Shikhar","familyName":"Mishra","name":"Mishra, Shikhar","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Aman","familyName":"Gokrani","name":"Gokrani, Aman","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Paras","familyName":"Chopra","name":"Chopra, Paras","affiliation":[],"nameIdentifiers":[]}],"titles":[{"title":"ISO-Bench: Can Coding Agents Optimize Real-World Inference Workloads?"}],"publisher":"arXiv","container":{},"publicationYear":2026,"subjects":[{"subject":"Machine Learning (cs.LG)","lang":"en","subjectScheme":"arXiv"},{"subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"},{"schemeUri":"http://www.oecd.org/science/inno/38235147.pdf","subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"}],"contributors":[],"dates":[{"date":"2026-02-23T08:37:53Z","dateType":"Submitted","dateInformation":"v1"},{"date":"2026-02-24T02:15:37Z","dateType":"Updated","dateInformation":"v1"},{"date":"2026-02","dateType":"Available","dateInformation":"v1"},{"date":"2026","dateType":"Issued"}],"language":null,"types":{"schemaOrg":"CreativeWork","resourceTypeGeneral":"Preprint","citeproc":"article","bibtex":"misc","ris":"GEN","resourceType":"Article"},"relatedIdentifiers":[],"relatedItems":[],"sizes":[],"formats":[],"version":"1","rightsList":[{"rightsIdentifierScheme":"SPDX","rightsUri":"https://creativecommons.org/licenses/by/4.0/legalcode","schemeUri":"https://spdx.org/licenses/","rights":"Creative Commons Attribution 4.0 International","rightsIdentifier":"cc-by-4.0"}],"descriptions":[{"descriptionType":"Abstract","description":"We introduce ISO-Bench, a benchmark for coding agents to test their capabilities on real-world inference optimization tasks. These tasks were taken from vLLM and SGLang, two of the most popular LLM serving frameworks. Each task provides an agent with a codebase and bottleneck description, whereby the agent must produce an optimization patch evaluated against expert human solutions. We curated 54 tasks from merged pull requests with measurable performance improvements. While existing benchmarks heavily use runtime-based metrics, such approaches can be gamed to pass tests without capturing the actual intent of the code changes. Therefore, we combine both hard (execution-based) and soft (LLM-based) metrics to show that both are necessary for complete evaluation. While evaluating both closed and open-source coding agents, we find no single agent dominates across codebases. Surprisingly, agents often identify correct bottlenecks but fail to execute working solutions. We also show that agents with identical underlying models differ substantially, suggesting scaffolding is as important as the model."}],"geoLocations":[],"fundingReferences":[],"url":"https://arxiv.org/abs/2602.19594","contentUrl":null,"metadataVersion":0,"schemaVersion":"http://datacite.org/schema/kernel-4","source":"mds","isActive":true,"state":"findable","reason":null,"viewCount":0,"downloadCount":0,"referenceCount":0,"citationCount":0,"partCount":0,"partOfCount":0,"versionCount":0,"versionOfCount":0,"created":"2026-02-25T15:06:53Z","registered":"2026-02-25T15:06:54Z","published":null,"updated":"2026-02-25T15:06:54Z"},"relationships":{"client":{"data":{"id":"arxiv.content","type":"clients"}}}},{"id":"10.48550/arxiv.2602.19593","type":"dois","attributes":{"doi":"10.48550/arxiv.2602.19593","identifiers":[{"identifier":"2602.19593","identifierType":"arXiv"}],"creators":[{"nameType":"Personal","givenName":"Beatrice","familyName":"Costeri","name":"Costeri, Beatrice","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Claudio","familyName":"Dappiaggi","name":"Dappiaggi, Claudio","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Paolo","familyName":"Rinaldi","name":"Rinaldi, Paolo","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Matteo","familyName":"Savasta","name":"Savasta, Matteo","affiliation":[],"nameIdentifiers":[]}],"titles":[{"title":"Schauder estimates for germs of distributions on smooth manifolds"}],"publisher":"arXiv","container":{},"publicationYear":2026,"subjects":[{"subject":"Mathematical Physics (math-ph)","lang":"en","subjectScheme":"arXiv"},{"subject":"Analysis of PDEs (math.AP)","lang":"en","subjectScheme":"arXiv"},{"subject":"Probability (math.PR)","lang":"en","subjectScheme":"arXiv"},{"subject":"FOS: Physical sciences","subjectScheme":"Fields of Science and Technology (FOS)"},{"schemeUri":"http://www.oecd.org/science/inno/38235147.pdf","subject":"FOS: Physical sciences","subjectScheme":"Fields of Science and Technology (FOS)"},{"subject":"FOS: Mathematics","subjectScheme":"Fields of Science and Technology (FOS)"},{"schemeUri":"http://www.oecd.org/science/inno/38235147.pdf","subject":"FOS: Mathematics","subjectScheme":"Fields of Science and Technology (FOS)"}],"contributors":[],"dates":[{"date":"2026-02-23T08:37:09Z","dateType":"Submitted","dateInformation":"v1"},{"date":"2026-02-24T02:15:31Z","dateType":"Updated","dateInformation":"v1"},{"date":"2026-02","dateType":"Available","dateInformation":"v1"},{"date":"2026","dateType":"Issued"}],"language":null,"types":{"schemaOrg":"CreativeWork","resourceTypeGeneral":"Preprint","citeproc":"article","bibtex":"misc","ris":"GEN","resourceType":"Article"},"relatedIdentifiers":[],"relatedItems":[],"sizes":[],"formats":[],"version":"1","rightsList":[{"rightsIdentifierScheme":"SPDX","rightsUri":"https://creativecommons.org/licenses/by/4.0/legalcode","schemeUri":"https://spdx.org/licenses/","rights":"Creative Commons Attribution 4.0 International","rightsIdentifier":"cc-by-4.0"}],"descriptions":[{"descriptionType":"Abstract","description":"We discuss germs of distributions on $d-$dimensional smooth Riemannian manifolds and, in particular, we derive \\emph{multi-level Schauder estimates} without making any further assumptions on the underlying geometry. As a preliminary step, we define the notions of coherence and homogeneity for germs of distributions on open subsets of $\\mathbb{R}^d$, $d \\ge 1$. Subsequently, we formulate both the reconstruction theorem, cf., [CZ20], and the Schauder estimates, cf., [BCZ24], in this setting. Leveraging the properties of the exponential map, we extend these results to Riemannian manifolds. Specifically, we devise a counterpart of the reconstruction theorem previously established in the literature [RS21], while additionally proving the regularity of the reconstructed distribution in suitable Hölder-Zygmund spaces. Finally, by introducing a novel concept of $β$-regularizing kernels on Riemannian manifolds, we establish Schauder estimates for coherent and homogeneous germs in this context."},{"descriptionType":"Other","description":"31 pages"}],"geoLocations":[],"fundingReferences":[],"url":"https://arxiv.org/abs/2602.19593","contentUrl":null,"metadataVersion":0,"schemaVersion":"http://datacite.org/schema/kernel-4","source":"mds","isActive":true,"state":"findable","reason":null,"viewCount":0,"downloadCount":0,"referenceCount":0,"citationCount":0,"partCount":0,"partOfCount":0,"versionCount":0,"versionOfCount":0,"created":"2026-02-25T15:06:51Z","registered":"2026-02-25T15:06:52Z","published":null,"updated":"2026-02-25T15:06:52Z"},"relationships":{"client":{"data":{"id":"arxiv.content","type":"clients"}}}},{"id":"10.48550/arxiv.2602.19592","type":"dois","attributes":{"doi":"10.48550/arxiv.2602.19592","identifiers":[{"identifier":"2602.19592","identifierType":"arXiv"}],"creators":[{"nameType":"Personal","givenName":"Qianyu","familyName":"Zheng","name":"Zheng, Qianyu","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Victor","familyName":"Fung","name":"Fung, Victor","affiliation":[],"nameIdentifiers":[]}],"titles":[{"title":"Improving Reliability of Machine Learned Interatomic Potentials With Physics-Informed Pretraining"}],"publisher":"arXiv","container":{},"publicationYear":2026,"subjects":[{"subject":"Materials Science (cond-mat.mtrl-sci)","lang":"en","subjectScheme":"arXiv"},{"subject":"FOS: Physical sciences","subjectScheme":"Fields of Science and Technology (FOS)"},{"schemeUri":"http://www.oecd.org/science/inno/38235147.pdf","subject":"FOS: Physical sciences","subjectScheme":"Fields of Science and Technology (FOS)"}],"contributors":[],"dates":[{"date":"2026-02-23T08:36:15Z","dateType":"Submitted","dateInformation":"v1"},{"date":"2026-02-24T02:15:28Z","dateType":"Updated","dateInformation":"v1"},{"date":"2026-02","dateType":"Available","dateInformation":"v1"},{"date":"2026","dateType":"Issued"}],"language":null,"types":{"schemaOrg":"CreativeWork","resourceTypeGeneral":"Preprint","citeproc":"article","bibtex":"misc","ris":"GEN","resourceType":"Article"},"relatedIdentifiers":[],"relatedItems":[],"sizes":[],"formats":[],"version":"1","rightsList":[{"rightsIdentifierScheme":"SPDX","rightsUri":"https://creativecommons.org/licenses/by/4.0/legalcode","schemeUri":"https://spdx.org/licenses/","rights":"Creative Commons Attribution 4.0 International","rightsIdentifier":"cc-by-4.0"}],"descriptions":[{"descriptionType":"Abstract","description":"Machine learned interatomic potentials (MLIPs) have emerged as powerful tools for molecular dynamics (MD) simulations with their competitive accuracy and computational efficiency. However, MLIPs are often observed to exhibit un-physical behavior when encountering configurations which deviate significantly from their training data distribution, leading to simulation instabilities and unreliable dynamics, thus limiting the reliability of MLIPs for materials simulations. We present a physics-informed pretraining strategy that leverages simple physical potentials which can improve the robustness and stability of graph-based MLIPs for MD simulations. We demonstrate this approach by deploying a pretraining-finetuning pipeline where MLIPs are initially pretrained on data labelled with embedded atom model potentials and subsequently finetuned on the quantum mechanical ground truth data. By evaluating across three diverse material systems (phosphorus, silica, and a subset of Materials Project) and three representative MLIP architectures (CGCNN, M3GNet, and TorchMD-NET), we find that this physics-informed pretraining consistently improves both prediction accuracy as well as stability in MD compared to the baselines."}],"geoLocations":[],"fundingReferences":[],"url":"https://arxiv.org/abs/2602.19592","contentUrl":null,"metadataVersion":0,"schemaVersion":"http://datacite.org/schema/kernel-4","source":"mds","isActive":true,"state":"findable","reason":null,"viewCount":0,"downloadCount":0,"referenceCount":0,"citationCount":0,"partCount":0,"partOfCount":0,"versionCount":0,"versionOfCount":0,"created":"2026-02-25T15:06:48Z","registered":"2026-02-25T15:06:49Z","published":null,"updated":"2026-02-25T15:06:49Z"},"relationships":{"client":{"data":{"id":"arxiv.content","type":"clients"}}}},{"id":"10.48550/arxiv.2602.19589","type":"dois","attributes":{"doi":"10.48550/arxiv.2602.19589","identifiers":[{"identifier":"2602.19589","identifierType":"arXiv"}],"creators":[{"nameType":"Personal","givenName":"Jason","familyName":"Crann","name":"Crann, Jason","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Matthias","familyName":"Neufang","name":"Neufang, Matthias","affiliation":[],"nameIdentifiers":[]}],"titles":[{"title":"A Banach algebra encoding quantum group duality"}],"publisher":"arXiv","container":{},"publicationYear":2026,"subjects":[{"subject":"Operator Algebras (math.OA)","lang":"en","subjectScheme":"arXiv"},{"subject":"Functional Analysis (math.FA)","lang":"en","subjectScheme":"arXiv"},{"subject":"FOS: Mathematics","subjectScheme":"Fields of Science and Technology (FOS)"},{"schemeUri":"http://www.oecd.org/science/inno/38235147.pdf","subject":"FOS: Mathematics","subjectScheme":"Fields of Science and Technology (FOS)"}],"contributors":[],"dates":[{"date":"2026-02-23T08:26:36Z","dateType":"Submitted","dateInformation":"v1"},{"date":"2026-02-24T02:15:08Z","dateType":"Updated","dateInformation":"v1"},{"date":"2026-02","dateType":"Available","dateInformation":"v1"},{"date":"2026","dateType":"Issued"}],"language":null,"types":{"schemaOrg":"CreativeWork","resourceTypeGeneral":"Preprint","citeproc":"article","bibtex":"misc","ris":"GEN","resourceType":"Article"},"relatedIdentifiers":[],"relatedItems":[],"sizes":[],"formats":[],"version":"1","rightsList":[{"rightsUri":"http://arxiv.org/licenses/nonexclusive-distrib/1.0/","rights":"arXiv.org perpetual, non-exclusive license"}],"descriptions":[{"descriptionType":"Abstract","description":"We introduce and study a new Banach algebra structure on the trace-zero subspace $\\mathcal{T}(L^2(\\mathbb{G}))_0$ of trace class operators for any locally compact quantum group $\\mathbb{G}$; it is defined through a mixed Lie-type product of the two dual products on $\\mathcal{T}(L^2(\\mathbb{G}))$ arising from the canonical extensions of the co-products of $\\mathbb{G}$ and $\\widehat{\\mathbb{G}}$. The surprising fact that this new product is indeed associative stems precisely from the duality of the latter two products. This, in particular, gives new faithful associative products on trace-zero matrices in $M_d(\\mathbb{C})$. After establishing some basic properties, we show that the single algebra $\\mathcal{T}(L^2(\\mathbb{G}))_0$ captures simultaneous properties of $\\mathbb{G}$ and $\\widehat{\\mathbb{G}}$, is faithful for a large class of quantum groups, and encodes both $M^r_{cb}(L^1(\\mathbb{G}))$ and $M^r_{cb}(L^1(\\widehat{\\mathbb{G}}))$ as left, respectively right, completely bounded module maps on $\\mathcal{T}(L^2(\\mathbb{G}))$. We finish by exhibiting an analogous product on the trace-zero nuclear operators $\\mathcal{N}(L^p(G))_0$ for a locally compact group $G$ and $p\\in(1,\\infty)$. Building on [7], our work suggests an approach for developing an $L^p$-version of locally compact quantum group theory."},{"descriptionType":"Other","description":"21 pages"}],"geoLocations":[],"fundingReferences":[],"url":"https://arxiv.org/abs/2602.19589","contentUrl":null,"metadataVersion":0,"schemaVersion":"http://datacite.org/schema/kernel-4","source":"mds","isActive":true,"state":"findable","reason":null,"viewCount":0,"downloadCount":0,"referenceCount":0,"citationCount":0,"partCount":0,"partOfCount":0,"versionCount":0,"versionOfCount":0,"created":"2026-02-25T15:06:41Z","registered":"2026-02-25T15:06:42Z","published":null,"updated":"2026-02-25T15:06:42Z"},"relationships":{"client":{"data":{"id":"arxiv.content","type":"clients"}}}},{"id":"10.48550/arxiv.2602.19587","type":"dois","attributes":{"doi":"10.48550/arxiv.2602.19587","identifiers":[{"identifier":"2602.19587","identifierType":"arXiv"}],"creators":[{"nameType":"Personal","givenName":"Junseon","familyName":"Park","name":"Park, Junseon","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Hyeongon","familyName":"Park","name":"Park, Hyeongon","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Rahul K.","familyName":"Gupta","name":"Gupta, Rahul K.","affiliation":[],"nameIdentifiers":[]}],"titles":[{"title":"Co-Optimization of Network Topology and Variable Impedance Devices under Dynamic Line Ratings in Power Transmission Systems"}],"publisher":"arXiv","container":{},"publicationYear":2026,"subjects":[{"subject":"Systems and Control (eess.SY)","lang":"en","subjectScheme":"arXiv"},{"subject":"FOS: Electrical engineering, electronic engineering, information engineering","subjectScheme":"Fields of Science and Technology (FOS)"},{"schemeUri":"http://www.oecd.org/science/inno/38235147.pdf","subject":"FOS: Electrical engineering, electronic engineering, information engineering","subjectScheme":"Fields of Science and Technology (FOS)"}],"contributors":[],"dates":[{"date":"2026-02-23T08:22:29Z","dateType":"Submitted","dateInformation":"v1"},{"date":"2026-02-24T02:14:58Z","dateType":"Updated","dateInformation":"v1"},{"date":"2026-02","dateType":"Available","dateInformation":"v1"},{"date":"2026","dateType":"Issued"}],"language":null,"types":{"schemaOrg":"CreativeWork","resourceTypeGeneral":"Preprint","citeproc":"article","bibtex":"misc","ris":"GEN","resourceType":"Article"},"relatedIdentifiers":[],"relatedItems":[],"sizes":[],"formats":[],"version":"1","rightsList":[{"rightsUri":"http://arxiv.org/licenses/nonexclusive-distrib/1.0/","rights":"arXiv.org perpetual, non-exclusive license"}],"descriptions":[{"descriptionType":"Abstract","description":"Power system operators are increasingly deploying Grid Enhancing Technologies (GETs) to mitigate operational challenges such as line and transformer congestion, and voltage violations. These technologies, including Network Topology Optimization (NTO), Variable Impedance Devices (VIDs), and Dynamic Line Rating (DLR), enhance system flexibility and enable better utilization of existing network assets. However, as the deployment of multiple GETs grows, effective coordination among them becomes essential to fully realize their potential benefits. This paper presents a co-optimization framework that models and coordinates NTO, VID, and DLR within a unified optimization scheme to alleviate network congestion and minimize operational costs. The NTO formulation is developed using a node-breaker model, offering finer switching granularity and improved operational flexibility. The inclusion of VIDs introduces nonlinear and non-convex relationships in the optimization problem. DLR takes into account of weather conditions, primarily wind speed and ambient temperature, enabling adaptive utilization of transmission capacity. The proposed framework is validated on standard IEEE benchmark test systems, demonstrating its effectiveness under varying numbers and placements of impedance controllers."}],"geoLocations":[],"fundingReferences":[],"url":"https://arxiv.org/abs/2602.19587","contentUrl":null,"metadataVersion":0,"schemaVersion":"http://datacite.org/schema/kernel-4","source":"mds","isActive":true,"state":"findable","reason":null,"viewCount":0,"downloadCount":0,"referenceCount":0,"citationCount":0,"partCount":0,"partOfCount":0,"versionCount":0,"versionOfCount":0,"created":"2026-02-25T15:06:36Z","registered":"2026-02-25T15:06:36Z","published":null,"updated":"2026-02-25T15:06:36Z"},"relationships":{"client":{"data":{"id":"arxiv.content","type":"clients"}}}},{"id":"10.48550/arxiv.2602.19585","type":"dois","attributes":{"doi":"10.48550/arxiv.2602.19585","identifiers":[{"identifier":"2602.19585","identifierType":"arXiv"}],"creators":[{"nameType":"Personal","givenName":"Chunlei","familyName":"Meng","name":"Meng, Chunlei","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Jiabin","familyName":"Luo","name":"Luo, Jiabin","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Zhenglin","familyName":"Yan","name":"Yan, Zhenglin","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Zhenyu","familyName":"Yu","name":"Yu, Zhenyu","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Rong","familyName":"Fu","name":"Fu, Rong","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Zhongxue","familyName":"Gan","name":"Gan, Zhongxue","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Chun","familyName":"Ouyang","name":"Ouyang, Chun","affiliation":[],"nameIdentifiers":[]}],"titles":[{"title":"Tri-Subspaces Disentanglement for Multimodal Sentiment Analysis"}],"publisher":"arXiv","container":{},"publicationYear":2026,"subjects":[{"subject":"Multimedia (cs.MM)","lang":"en","subjectScheme":"arXiv"},{"subject":"Artificial Intelligence (cs.AI)","lang":"en","subjectScheme":"arXiv"},{"subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"},{"schemeUri":"http://www.oecd.org/science/inno/38235147.pdf","subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"}],"contributors":[],"dates":[{"date":"2026-02-23T08:19:54Z","dateType":"Submitted","dateInformation":"v1"},{"date":"2026-02-24T02:14:53Z","dateType":"Updated","dateInformation":"v1"},{"date":"2026-02","dateType":"Available","dateInformation":"v1"},{"date":"2026","dateType":"Issued"}],"language":null,"types":{"schemaOrg":"CreativeWork","resourceTypeGeneral":"Preprint","citeproc":"article","bibtex":"misc","ris":"GEN","resourceType":"Article"},"relatedIdentifiers":[],"relatedItems":[],"sizes":[],"formats":[],"version":"1","rightsList":[{"rightsUri":"http://arxiv.org/licenses/nonexclusive-distrib/1.0/","rights":"arXiv.org perpetual, non-exclusive license"}],"descriptions":[{"descriptionType":"Abstract","description":"Multimodal Sentiment Analysis (MSA) integrates language, visual, and acoustic modalities to infer human sentiment. Most existing methods either focus on globally shared representations or modality-specific features, while overlooking signals that are shared only by certain modality pairs. This limits the expressiveness and discriminative power of multimodal representations. To address this limitation, we propose a Tri-Subspace Disentanglement (TSD) framework that explicitly factorizes features into three complementary subspaces: a common subspace capturing global consistency, submodally-shared subspaces modeling pairwise cross-modal synergies, and private subspaces preserving modality-specific cues. To keep these subspaces pure and independent, we introduce a decoupling supervisor together with structured regularization losses. We further design a Subspace-Aware Cross-Attention (SACA) fusion module that adaptively models and integrates information from the three subspaces to obtain richer and more robust representations. Experiments on CMU-MOSI and CMU-MOSEI demonstrate that TSD achieves state-of-the-art performance across all key metrics, reaching 0.691 MAE on CMU-MOSI and 54.9% ACC-7 on CMU-MOSEI, and also transfers well to multimodal intent recognition tasks. Ablation studies confirm that tri-subspace disentanglement and SACA jointly enhance the modeling of multi-granular cross-modal sentiment cues."},{"descriptionType":"Other","description":"This study has been Accepted by CVPR 2026"}],"geoLocations":[],"fundingReferences":[],"url":"https://arxiv.org/abs/2602.19585","contentUrl":null,"metadataVersion":0,"schemaVersion":"http://datacite.org/schema/kernel-4","source":"mds","isActive":true,"state":"findable","reason":null,"viewCount":0,"downloadCount":0,"referenceCount":0,"citationCount":0,"partCount":0,"partOfCount":0,"versionCount":0,"versionOfCount":0,"created":"2026-02-25T15:06:31Z","registered":"2026-02-25T15:06:31Z","published":null,"updated":"2026-02-25T15:06:31Z"},"relationships":{"client":{"data":{"id":"arxiv.content","type":"clients"}}}},{"id":"10.48550/arxiv.2602.19584","type":"dois","attributes":{"doi":"10.48550/arxiv.2602.19584","identifiers":[{"identifier":"2602.19584","identifierType":"arXiv"}],"creators":[{"nameType":"Personal","givenName":"Biswajit","familyName":"Sadhu","name":"Sadhu, Biswajit","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Kalpak","familyName":"Gupte","name":"Gupte, Kalpak","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Trijit","familyName":"Sadhu","name":"Sadhu, Trijit","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"S.","familyName":"Anand","name":"Anand, S.","affiliation":[],"nameIdentifiers":[]}],"titles":[{"title":"Interpolation-Driven Machine Learning Approaches for Plume Shine Dose Estimation: A Comparison of XGBoost, Random Forest, and TabNet"}],"publisher":"arXiv","container":{},"publicationYear":2026,"subjects":[{"subject":"Machine Learning (cs.LG)","lang":"en","subjectScheme":"arXiv"},{"subject":"Artificial Intelligence (cs.AI)","lang":"en","subjectScheme":"arXiv"},{"subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"},{"schemeUri":"http://www.oecd.org/science/inno/38235147.pdf","subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"}],"contributors":[],"dates":[{"date":"2026-02-23T08:12:49Z","dateType":"Submitted","dateInformation":"v1"},{"date":"2026-02-24T02:14:35Z","dateType":"Updated","dateInformation":"v1"},{"date":"2026-02","dateType":"Available","dateInformation":"v1"},{"date":"2026","dateType":"Issued"}],"language":null,"types":{"schemaOrg":"CreativeWork","resourceTypeGeneral":"Preprint","citeproc":"article","bibtex":"misc","ris":"GEN","resourceType":"Article"},"relatedIdentifiers":[],"relatedItems":[],"sizes":[],"formats":[],"version":"1","rightsList":[{"rightsUri":"http://arxiv.org/licenses/nonexclusive-distrib/1.0/","rights":"arXiv.org perpetual, non-exclusive license"}],"descriptions":[{"descriptionType":"Abstract","description":"Despite the success of machine learning (ML) in surrogate modeling, its use in radiation dose assessment is limited by safety-critical constraints, scarce training-ready data, and challenges in selecting suitable architectures for physics-dominated systems. Within this context, rapid and accurate plume shine dose estimation serves as a practical test case, as it is critical for nuclear facility safety assessment and radiological emergency response, while conventional photon-transport-based calculations remain computationally expensive. In this work, an interpolation-assisted ML framework was developed using discrete dose datasets generated with the pyDOSEIA suite for 17 gamma-emitting radionuclides across varying downwind distances, release heights, and atmospheric stability categories. The datasets were augmented using shape-preserving interpolation to construct dense, high-resolution training data. Two tree-based ML models (Random Forest and XGBoost) and one deep learning (DL) model (TabNet) were evaluated to examine predictive performance and sensitivity to dataset resolution. All models showed higher prediction accuracy with the interpolated high-resolution dataset than with the discrete data; however, XGBoost consistently achieved the highest accuracy. Interpretability analysis using permutation importance (tree-based models) and attention-based feature attribution (TabNet) revealed that performance differences stem from how the models utilize input features. Tree-based models focus mainly on dominant geometry-dispersion features (release height, stability category, and downwind distance), treating radionuclide identity as a secondary input, whereas TabNet distributes attention more broadly across multiple variables. For practical deployment, a web-based GUI was developed for interactive scenario evaluation and transparent comparison with photon-transport reference calculations."},{"descriptionType":"Other","description":"28 pages, 11 figures, 3 tables"}],"geoLocations":[],"fundingReferences":[],"url":"https://arxiv.org/abs/2602.19584","contentUrl":null,"metadataVersion":0,"schemaVersion":"http://datacite.org/schema/kernel-4","source":"mds","isActive":true,"state":"findable","reason":null,"viewCount":0,"downloadCount":0,"referenceCount":0,"citationCount":0,"partCount":0,"partOfCount":0,"versionCount":0,"versionOfCount":0,"created":"2026-02-25T15:06:28Z","registered":"2026-02-25T15:06:29Z","published":null,"updated":"2026-02-25T15:06:29Z"},"relationships":{"client":{"data":{"id":"arxiv.content","type":"clients"}}}},{"id":"10.48550/arxiv.2602.19583","type":"dois","attributes":{"doi":"10.48550/arxiv.2602.19583","identifiers":[{"identifier":"2602.19583","identifierType":"arXiv"}],"creators":[{"nameType":"Personal","givenName":"Sergio Gómez","familyName":"González","name":"González, Sergio Gómez","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Miguel","familyName":"Domingo","name":"Domingo, Miguel","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Francisco","familyName":"Casacuberta","name":"Casacuberta, Francisco","affiliation":[],"nameIdentifiers":[]}],"titles":[{"title":"DEEP: Docker-based Execution and Evaluation Platform"}],"publisher":"arXiv","container":{},"publicationYear":2026,"subjects":[{"subject":"Computation and Language (cs.CL)","lang":"en","subjectScheme":"arXiv"},{"subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"},{"schemeUri":"http://www.oecd.org/science/inno/38235147.pdf","subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"}],"contributors":[],"dates":[{"date":"2026-02-23T08:08:57Z","dateType":"Submitted","dateInformation":"v1"},{"date":"2026-02-24T02:14:31Z","dateType":"Updated","dateInformation":"v1"},{"date":"2026-02","dateType":"Available","dateInformation":"v1"},{"date":"2026","dateType":"Issued"}],"language":null,"types":{"schemaOrg":"CreativeWork","resourceTypeGeneral":"Preprint","citeproc":"article","bibtex":"misc","ris":"GEN","resourceType":"Article"},"relatedIdentifiers":[],"relatedItems":[],"sizes":[],"formats":[],"version":"1","rightsList":[{"rightsIdentifierScheme":"SPDX","rightsUri":"https://creativecommons.org/licenses/by/4.0/legalcode","schemeUri":"https://spdx.org/licenses/","rights":"Creative Commons Attribution 4.0 International","rightsIdentifier":"cc-by-4.0"}],"descriptions":[{"descriptionType":"Abstract","description":"Comparative evaluation of several systems is a recurrent task in researching. It is a key step before deciding which system to use for our work, or, once our research has been conducted, to demonstrate the potential of the resulting model. Furthermore, it is the main task of competitive, public challenges evaluation. Our proposed software (DEEP) automates both the execution and scoring of machine translation and optical character recognition models. Furthermore, it is easily extensible to other tasks. DEEP is prepared to receive dockerized systems, run them (extracting information at that same time), and assess hypothesis against some references. With this approach, evaluators can achieve a better understanding of the performance of each model. Moreover, the software uses a clustering algorithm based on a statistical analysis of the significance of the results yielded by each model, according to the evaluation metrics. As a result, evaluators are able to identify clusters of performance among the swarm of proposals and have a better understanding of the significance of their differences. Additionally, we offer a visualization web-app to ensure that the results can be adequately understood and interpreted. Finally, we present an exemplary case of use of DEEP."}],"geoLocations":[],"fundingReferences":[],"url":"https://arxiv.org/abs/2602.19583","contentUrl":null,"metadataVersion":0,"schemaVersion":"http://datacite.org/schema/kernel-4","source":"mds","isActive":true,"state":"findable","reason":null,"viewCount":0,"downloadCount":0,"referenceCount":0,"citationCount":0,"partCount":0,"partOfCount":0,"versionCount":0,"versionOfCount":0,"created":"2026-02-25T15:06:25Z","registered":"2026-02-25T15:06:26Z","published":null,"updated":"2026-02-25T15:06:26Z"},"relationships":{"client":{"data":{"id":"arxiv.content","type":"clients"}}}},{"id":"10.48550/arxiv.2602.19582","type":"dois","attributes":{"doi":"10.48550/arxiv.2602.19582","identifiers":[{"identifier":"2602.19582","identifierType":"arXiv"}],"creators":[{"nameType":"Personal","givenName":"Shenghong","familyName":"He","name":"He, Shenghong","affiliation":[],"nameIdentifiers":[]}],"titles":[{"title":"Advantage-based Temporal Attack in Reinforcement Learning"}],"publisher":"arXiv","container":{},"publicationYear":2026,"subjects":[{"subject":"Machine Learning (cs.LG)","lang":"en","subjectScheme":"arXiv"},{"subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"},{"schemeUri":"http://www.oecd.org/science/inno/38235147.pdf","subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"}],"contributors":[],"dates":[{"date":"2026-02-23T08:08:23Z","dateType":"Submitted","dateInformation":"v1"},{"date":"2026-02-24T02:14:29Z","dateType":"Updated","dateInformation":"v1"},{"date":"2026-02","dateType":"Available","dateInformation":"v1"},{"date":"2026","dateType":"Issued"}],"language":null,"types":{"schemaOrg":"CreativeWork","resourceTypeGeneral":"Preprint","citeproc":"article","bibtex":"misc","ris":"GEN","resourceType":"Article"},"relatedIdentifiers":[],"relatedItems":[],"sizes":[],"formats":[],"version":"1","rightsList":[{"rightsUri":"http://arxiv.org/licenses/nonexclusive-distrib/1.0/","rights":"arXiv.org perpetual, non-exclusive license"}],"descriptions":[{"descriptionType":"Abstract","description":"Extensive research demonstrates that Deep Reinforcement Learning (DRL) models are susceptible to adversarially constructed inputs (i.e., adversarial examples), which can mislead the agent to take suboptimal or unsafe actions. Recent methods improve attack effectiveness by leveraging future rewards to guide adversarial perturbation generation over sequential time steps (i.e., reward-based attacks). However, these methods are unable to capture dependencies between different time steps in the perturbation generation process, resulting in a weak temporal correlation between the current perturbation and previous perturbations.In this paper, we propose a novel method called Advantage-based Adversarial Transformer (AAT), which can generate adversarial examples with stronger temporal correlations (i.e., time-correlated adversarial examples) to improve the attack performance. AAT employs a multi-scale causal self-attention (MSCSA) mechanism to dynamically capture dependencies between historical information from different time periods and the current state, thus enhancing the correlation between the current perturbation and the previous perturbation. Moreover, AAT introduces a weighted advantage mechanism, which quantifies the effectiveness of a perturbation in a given state and guides the generation process toward high-performance adversarial examples by sampling high-advantage regions. Extensive experiments demonstrate that the performance of AAT matches or surpasses mainstream adversarial attack baselines on Atari, DeepMind Control Suite and Google football tasks."}],"geoLocations":[],"fundingReferences":[],"url":"https://arxiv.org/abs/2602.19582","contentUrl":null,"metadataVersion":0,"schemaVersion":"http://datacite.org/schema/kernel-4","source":"mds","isActive":true,"state":"findable","reason":null,"viewCount":0,"downloadCount":0,"referenceCount":0,"citationCount":0,"partCount":0,"partOfCount":0,"versionCount":0,"versionOfCount":0,"created":"2026-02-25T15:06:23Z","registered":"2026-02-25T15:06:24Z","published":null,"updated":"2026-02-25T15:06:24Z"},"relationships":{"client":{"data":{"id":"arxiv.content","type":"clients"}}}},{"id":"10.48550/arxiv.2602.19581","type":"dois","attributes":{"doi":"10.48550/arxiv.2602.19581","identifiers":[{"identifier":"2602.19581","identifierType":"arXiv"}],"creators":[{"nameType":"Personal","givenName":"Hranislav","familyName":"Stanković","name":"Stanković, Hranislav","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Carlos","familyName":"Kubrusly","name":"Kubrusly, Carlos","affiliation":[],"nameIdentifiers":[]}],"titles":[{"title":"Structural Properties and Normality Criteria for Subclasses of Normaloid Operators"}],"publisher":"arXiv","container":{},"publicationYear":2026,"subjects":[{"subject":"Functional Analysis (math.FA)","lang":"en","subjectScheme":"arXiv"},{"subject":"FOS: Mathematics","subjectScheme":"Fields of Science and Technology (FOS)"},{"schemeUri":"http://www.oecd.org/science/inno/38235147.pdf","subject":"FOS: Mathematics","subjectScheme":"Fields of Science and Technology (FOS)"}],"contributors":[],"dates":[{"date":"2026-02-23T08:02:38Z","dateType":"Submitted","dateInformation":"v1"},{"date":"2026-02-24T02:14:14Z","dateType":"Updated","dateInformation":"v1"},{"date":"2026-02","dateType":"Available","dateInformation":"v1"},{"date":"2026","dateType":"Issued"}],"language":null,"types":{"schemaOrg":"CreativeWork","resourceTypeGeneral":"Preprint","citeproc":"article","bibtex":"misc","ris":"GEN","resourceType":"Article"},"relatedIdentifiers":[],"relatedItems":[],"sizes":[],"formats":[],"version":"1","rightsList":[{"rightsUri":"http://arxiv.org/licenses/nonexclusive-distrib/1.0/","rights":"arXiv.org perpetual, non-exclusive license"}],"descriptions":[{"descriptionType":"Abstract","description":"We investigate structural properties and normality criteria for certain classes of bounded linear operators on a Hilbert space. We show that an operator $T$ with polar decomposition $T = U|T|$ is self-adjoint if and only if $T$ is absolute-$(p,r)$-paranormal and the partial isometry $U$ is self-adjoint. Extending Ando's Theorem, we prove that if $T$ is absolute-$(p,r)$-paranormal and $T^n$ is normal for some $n \\in \\mathbb{N}$, then $T$ itself is normal. We further show that if $T$ is absolute-$(p,r)$-paranormal and $T^2$ is compact, then $T$ is a compact normal operator. Finally, we obtain several characterizations of quasinormal partial isometries within the normaloid hierarchy."}],"geoLocations":[],"fundingReferences":[],"url":"https://arxiv.org/abs/2602.19581","contentUrl":null,"metadataVersion":0,"schemaVersion":"http://datacite.org/schema/kernel-4","source":"mds","isActive":true,"state":"findable","reason":null,"viewCount":0,"downloadCount":0,"referenceCount":0,"citationCount":0,"partCount":0,"partOfCount":0,"versionCount":0,"versionOfCount":0,"created":"2026-02-25T15:06:20Z","registered":"2026-02-25T15:06:21Z","published":null,"updated":"2026-02-25T15:06:21Z"},"relationships":{"client":{"data":{"id":"arxiv.content","type":"clients"}}}},{"id":"10.48550/arxiv.2602.19580","type":"dois","attributes":{"doi":"10.48550/arxiv.2602.19580","identifiers":[{"identifier":"2602.19580","identifierType":"arXiv"}],"creators":[{"nameType":"Personal","givenName":"Jeremy","familyName":"McEntire","name":"McEntire, Jeremy","affiliation":[],"nameIdentifiers":[]}],"titles":[{"title":"Leap+Verify: Regime-Adaptive Speculative Weight Prediction for Accelerating Neural Network Training"}],"publisher":"arXiv","container":{},"publicationYear":2026,"subjects":[{"subject":"Machine Learning (cs.LG)","lang":"en","subjectScheme":"arXiv"},{"subject":"General Economics (econ.GN)","lang":"en","subjectScheme":"arXiv"},{"subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"},{"schemeUri":"http://www.oecd.org/science/inno/38235147.pdf","subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"},{"subject":"FOS: Economics and business","subjectScheme":"Fields of Science and Technology (FOS)"},{"schemeUri":"http://www.oecd.org/science/inno/38235147.pdf","subject":"FOS: Economics and business","subjectScheme":"Fields of Science and Technology (FOS)"},{"subject":"I.2.6","lang":"en","subjectScheme":"ACM"}],"contributors":[],"dates":[{"date":"2026-02-23T08:01:44Z","dateType":"Submitted","dateInformation":"v1"},{"date":"2026-02-24T02:14:11Z","dateType":"Updated","dateInformation":"v1"},{"date":"2026-02","dateType":"Available","dateInformation":"v1"},{"date":"2026","dateType":"Issued"}],"language":null,"types":{"schemaOrg":"CreativeWork","resourceTypeGeneral":"Preprint","citeproc":"article","bibtex":"misc","ris":"GEN","resourceType":"Article"},"relatedIdentifiers":[{"relationType":"IsVersionOf","relatedIdentifier":"10.5281/zenodo.18739387","relatedIdentifierType":"DOI"}],"relatedItems":[],"sizes":[],"formats":[],"version":"1","rightsList":[{"rightsIdentifierScheme":"SPDX","rightsUri":"https://creativecommons.org/licenses/by/4.0/legalcode","schemeUri":"https://spdx.org/licenses/","rights":"Creative Commons Attribution 4.0 International","rightsIdentifier":"cc-by-4.0"}],"descriptions":[{"descriptionType":"Abstract","description":"We introduce Leap+Verify, a framework that applies speculative execution -- predicting future model weights and validating predictions before acceptance -- to accelerate neural network training. Inspired by speculative decoding in language model inference and by the Automatically Scalable Computation (ASC) architecture for program execution, Leap+Verify decomposes training into three dynamically detected regimes (chaotic, transition, stable) using activation-space cosine similarity as a real-time Lyapunov proxy signal. Within each regime, analytic weight predictors (momentum, linear, quadratic extrapolation) attempt to forecast model parameters K training steps ahead; predictions are accepted only when validated against a held-out loss criterion. We evaluate Leap+Verify on GPT-2 124M and Qwen 2.5-1.5B trained on WikiText-103 across five random seeds, sweeping prediction depth K in {5, 10, 25, 50, 75, 100}. Momentum-based prediction (Adam moment extrapolation) fails catastrophically at both scales, with predicted losses exceeding actuals by 100-10,000x -- a universal norm explosion in optimizer-state extrapolation. Finite-difference predictors (linear, quadratic) succeed where momentum fails: at 124M, they achieve 24% strict acceptance at K=5 in stable regimes; at 1.5B, they achieve 37% strict acceptance in transition regimes. The scale-dependent finding is in regime distribution: GPT-2 124M spends 34% of training in stable regime, while Qwen 1.5B spends 64% in chaotic regime and reaches stable in only 0-2 of 40 checkpoints. Larger models are more predictable when predictable, but less often predictable -- the practical bottleneck shifts from predictor accuracy to regime availability. Cross-seed results are highly consistent (less than 1% validation loss variance), and the three-regime framework produces identical phase boundaries (plus or minus 50 steps) across seeds."},{"descriptionType":"Other","description":"18 pages, 5 tables. Code and data available at https://github.com/jmcentire/leap-verify"}],"geoLocations":[],"fundingReferences":[],"url":"https://arxiv.org/abs/2602.19580","contentUrl":null,"metadataVersion":0,"schemaVersion":"http://datacite.org/schema/kernel-4","source":"mds","isActive":true,"state":"findable","reason":null,"viewCount":0,"downloadCount":0,"referenceCount":0,"citationCount":0,"partCount":0,"partOfCount":0,"versionCount":0,"versionOfCount":1,"created":"2026-02-25T15:06:18Z","registered":"2026-02-25T15:06:19Z","published":null,"updated":"2026-02-25T15:06:19Z"},"relationships":{"client":{"data":{"id":"arxiv.content","type":"clients"}}}},{"id":"10.48550/arxiv.2602.19579","type":"dois","attributes":{"doi":"10.48550/arxiv.2602.19579","identifiers":[{"identifier":"2602.19579","identifierType":"arXiv"}],"creators":[{"nameType":"Personal","givenName":"Naoto","familyName":"Sato","name":"Sato, Naoto","affiliation":[],"nameIdentifiers":[]}],"titles":[{"title":"Homogenization for the Poisson equation in domains perforated by random closed sets"}],"publisher":"arXiv","container":{},"publicationYear":2026,"subjects":[{"subject":"Analysis of PDEs (math.AP)","lang":"en","subjectScheme":"arXiv"},{"subject":"FOS: Mathematics","subjectScheme":"Fields of Science and Technology (FOS)"},{"schemeUri":"http://www.oecd.org/science/inno/38235147.pdf","subject":"FOS: Mathematics","subjectScheme":"Fields of Science and Technology (FOS)"},{"subject":"35B27 (Primary) 35J05, 35J25, 35R60 (Secondary)","lang":"en","subjectScheme":"MSC"}],"contributors":[],"dates":[{"date":"2026-02-23T07:59:27Z","dateType":"Submitted","dateInformation":"v1"},{"date":"2026-02-24T02:14:10Z","dateType":"Updated","dateInformation":"v1"},{"date":"2026-02","dateType":"Available","dateInformation":"v1"},{"date":"2026","dateType":"Issued"}],"language":null,"types":{"schemaOrg":"CreativeWork","resourceTypeGeneral":"Preprint","citeproc":"article","bibtex":"misc","ris":"GEN","resourceType":"Article"},"relatedIdentifiers":[],"relatedItems":[],"sizes":[],"formats":[],"version":"1","rightsList":[{"rightsUri":"http://arxiv.org/licenses/nonexclusive-distrib/1.0/","rights":"arXiv.org perpetual, non-exclusive license"}],"descriptions":[{"descriptionType":"Abstract","description":"We study the homogenization of the Poisson equation in randomly perforated domains and obtain the strange term effect in the homogenized equation. The perforations are modeled by rescaled germ-grain processes, and the main assumption is stationarity of the capacities of the holes. We emphasize that the potential in the homogenized equation is constant, despite the possibly nonstationary spatial distribution of the holes. We also establish corrector results."},{"descriptionType":"Other","description":"28 pages"}],"geoLocations":[],"fundingReferences":[],"url":"https://arxiv.org/abs/2602.19579","contentUrl":null,"metadataVersion":0,"schemaVersion":"http://datacite.org/schema/kernel-4","source":"mds","isActive":true,"state":"findable","reason":null,"viewCount":0,"downloadCount":0,"referenceCount":0,"citationCount":0,"partCount":0,"partOfCount":0,"versionCount":0,"versionOfCount":0,"created":"2026-02-25T15:06:16Z","registered":"2026-02-25T15:06:16Z","published":null,"updated":"2026-02-25T15:06:16Z"},"relationships":{"client":{"data":{"id":"arxiv.content","type":"clients"}}}},{"id":"10.48550/arxiv.2602.19578","type":"dois","attributes":{"doi":"10.48550/arxiv.2602.19578","identifiers":[{"identifier":"2602.19578","identifierType":"arXiv"}],"creators":[{"nameType":"Personal","givenName":"Weichi","familyName":"Yao","name":"Yao, Weichi","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Bianca","familyName":"Dumitrascu","name":"Dumitrascu, Bianca","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Bryan R.","familyName":"Goldsmith","name":"Goldsmith, Bryan R.","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Yixin","familyName":"Wang","name":"Wang, Yixin","affiliation":[],"nameIdentifiers":[]}],"titles":[{"title":"Goal-Oriented Influence-Maximizing Data Acquisition for Learning and Optimization"}],"publisher":"arXiv","container":{},"publicationYear":2026,"subjects":[{"subject":"Machine Learning (stat.ML)","lang":"en","subjectScheme":"arXiv"},{"subject":"Machine Learning (cs.LG)","lang":"en","subjectScheme":"arXiv"},{"subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"},{"schemeUri":"http://www.oecd.org/science/inno/38235147.pdf","subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"}],"contributors":[],"dates":[{"date":"2026-02-23T07:57:11Z","dateType":"Submitted","dateInformation":"v1"},{"date":"2026-02-24T02:13:59Z","dateType":"Updated","dateInformation":"v1"},{"date":"2026-02","dateType":"Available","dateInformation":"v1"},{"date":"2026","dateType":"Issued"}],"language":null,"types":{"schemaOrg":"CreativeWork","resourceTypeGeneral":"Preprint","citeproc":"article","bibtex":"misc","ris":"GEN","resourceType":"Article"},"relatedIdentifiers":[],"relatedItems":[],"sizes":[],"formats":[],"version":"1","rightsList":[{"rightsUri":"http://arxiv.org/licenses/nonexclusive-distrib/1.0/","rights":"arXiv.org perpetual, non-exclusive license"}],"descriptions":[{"descriptionType":"Abstract","description":"Active data acquisition is central to many learning and optimization tasks in deep neural networks, yet remains challenging because most approaches rely on predictive uncertainty estimates that are difficult to obtain reliably. To this end, we propose Goal-Oriented Influence- Maximizing Data Acquisition (GOIMDA), an active acquisition algorithm that avoids explicit posterior inference while remaining uncertainty-aware through inverse curvature. GOIMDA selects inputs by maximizing their expected influence on a user-specified goal functional, such as test loss, predictive entropy, or the value of an optimizer-recommended design. Leveraging first-order influence functions, we derive a tractable acquisition rule that combines the goal gradient, training-loss curvature, and candidate sensitivity to model parameters. We show theoretically that, for generalized linear models, GOIMDA approximates predictive-entropy minimization up to a correction term accounting for goal alignment and prediction bias, thereby, yielding uncertainty-aware behavior without maintaining a Bayesian posterior. Empirically, across learning tasks (including image and text classification) and optimization tasks (including noisy global optimization benchmarks and neural-network hyperparameter tuning), GOIMDA consistently reaches target performance with substantially fewer labeled samples or function evaluations than uncertainty-based active learning and Gaussian-process Bayesian optimization baselines."}],"geoLocations":[],"fundingReferences":[],"url":"https://arxiv.org/abs/2602.19578","contentUrl":null,"metadataVersion":0,"schemaVersion":"http://datacite.org/schema/kernel-4","source":"mds","isActive":true,"state":"findable","reason":null,"viewCount":0,"downloadCount":0,"referenceCount":0,"citationCount":0,"partCount":0,"partOfCount":0,"versionCount":0,"versionOfCount":0,"created":"2026-02-25T15:06:13Z","registered":"2026-02-25T15:06:14Z","published":null,"updated":"2026-02-25T15:06:14Z"},"relationships":{"client":{"data":{"id":"arxiv.content","type":"clients"}}}},{"id":"10.48550/arxiv.2602.19573","type":"dois","attributes":{"doi":"10.48550/arxiv.2602.19573","identifiers":[{"identifier":"2602.19573","identifierType":"arXiv"}],"creators":[{"nameType":"Personal","givenName":"Mickaya A.","familyName":"Razanaparany","name":"Razanaparany, Mickaya A.","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Christian","familyName":"Rakotonirina","name":"Rakotonirina, Christian","affiliation":[],"nameIdentifiers":[]}],"titles":[{"title":"A Relation Between the Chrestenson Operator, Weyl Operator Basis, and Kronecker-Pauli Operator Basis"}],"publisher":"arXiv","container":{},"publicationYear":2026,"subjects":[{"subject":"Quantum Physics (quant-ph)","lang":"en","subjectScheme":"arXiv"},{"subject":"FOS: Physical sciences","subjectScheme":"Fields of Science and Technology (FOS)"},{"schemeUri":"http://www.oecd.org/science/inno/38235147.pdf","subject":"FOS: Physical sciences","subjectScheme":"Fields of Science and Technology (FOS)"}],"contributors":[],"dates":[{"date":"2026-02-23T07:41:41Z","dateType":"Submitted","dateInformation":"v1"},{"date":"2026-02-24T02:13:38Z","dateType":"Updated","dateInformation":"v1"},{"date":"2026-02","dateType":"Available","dateInformation":"v1"},{"date":"2026","dateType":"Issued"}],"language":null,"types":{"schemaOrg":"CreativeWork","resourceTypeGeneral":"Preprint","citeproc":"article","bibtex":"misc","ris":"GEN","resourceType":"Article"},"relatedIdentifiers":[],"relatedItems":[],"sizes":[],"formats":[],"version":"1","rightsList":[{"rightsIdentifierScheme":"SPDX","rightsUri":"https://creativecommons.org/licenses/by/4.0/legalcode","schemeUri":"https://spdx.org/licenses/","rights":"Creative Commons Attribution 4.0 International","rightsIdentifier":"cc-by-4.0"}],"descriptions":[{"descriptionType":"Abstract","description":"Within the framework of quantum theory, we review the Chrestenson operator, the Weyl operator basis, and the Kronecker-Pauli operator basis in $d$-dimensional Hilbert spaces using Dirac notation, where $d$ is a prime integer strictly greater than 2. We establish a new algebraic relation connecting these operators and present the cases $d=3$ and $d=5$ as illustrative examples."},{"descriptionType":"Other","description":"7 pages"}],"geoLocations":[],"fundingReferences":[],"url":"https://arxiv.org/abs/2602.19573","contentUrl":null,"metadataVersion":0,"schemaVersion":"http://datacite.org/schema/kernel-4","source":"mds","isActive":true,"state":"findable","reason":null,"viewCount":0,"downloadCount":0,"referenceCount":0,"citationCount":0,"partCount":0,"partOfCount":0,"versionCount":0,"versionOfCount":0,"created":"2026-02-25T15:06:01Z","registered":"2026-02-25T15:06:02Z","published":null,"updated":"2026-02-25T15:06:02Z"},"relationships":{"client":{"data":{"id":"arxiv.content","type":"clients"}}}},{"id":"10.48550/arxiv.2602.19572","type":"dois","attributes":{"doi":"10.48550/arxiv.2602.19572","identifiers":[{"identifier":"2602.19572","identifierType":"arXiv"}],"creators":[{"nameType":"Personal","givenName":"Philipp","familyName":"Müller","name":"Müller, Philipp","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Gary A.","familyName":"Eiceman","name":"Eiceman, Gary A.","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Anton","familyName":"Rauhameri","name":"Rauhameri, Anton","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Anton","familyName":"Kontunen","name":"Kontunen, Anton","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Antti","familyName":"Roine","name":"Roine, Antti","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Niku","familyName":"Oksala","name":"Oksala, Niku","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Antti","familyName":"Vehkaoja","name":"Vehkaoja, Antti","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Maiju","familyName":"Lepomäki","name":"Lepomäki, Maiju","affiliation":[],"nameIdentifiers":[]}],"titles":[{"title":"Extracting Patterns of Chemical Information from Differential Mobility Spectrometry Measurements under Varying Conditions of Humidity and Temperature"}],"publisher":"arXiv","container":{},"publicationYear":2026,"subjects":[{"subject":"Signal Processing (eess.SP)","lang":"en","subjectScheme":"arXiv"},{"subject":"FOS: Electrical engineering, electronic engineering, information engineering","subjectScheme":"Fields of Science and Technology (FOS)"},{"schemeUri":"http://www.oecd.org/science/inno/38235147.pdf","subject":"FOS: Electrical engineering, electronic engineering, information engineering","subjectScheme":"Fields of Science and Technology (FOS)"}],"contributors":[],"dates":[{"date":"2026-02-23T07:41:07Z","dateType":"Submitted","dateInformation":"v1"},{"date":"2026-02-24T02:13:36Z","dateType":"Updated","dateInformation":"v1"},{"date":"2026-02","dateType":"Available","dateInformation":"v1"},{"date":"2026","dateType":"Issued"}],"language":null,"types":{"schemaOrg":"CreativeWork","resourceTypeGeneral":"Preprint","citeproc":"article","bibtex":"misc","ris":"GEN","resourceType":"Article"},"relatedIdentifiers":[],"relatedItems":[],"sizes":[],"formats":[],"version":"1","rightsList":[{"rightsIdentifierScheme":"SPDX","rightsUri":"https://creativecommons.org/licenses/by/4.0/legalcode","schemeUri":"https://spdx.org/licenses/","rights":"Creative Commons Attribution 4.0 International","rightsIdentifier":"cc-by-4.0"}],"descriptions":[{"descriptionType":"Abstract","description":"Differential Mobility Spectrometry (DMS), also known as Field Asymmetric Ion Mobility Spectrometry, is a rapid and affordable technology for extracting information from gas phase samples containing complex volatile organic compounds, and can therefore be used for analyzing surgical smoke. One obstacle to its widespread application is the dependence of DMS measurements on humidity and, to a lesser degree, temperature, making comparison of data measured under different environmental conditions arbitrary. The commonly used solution is to regulate these environmental conditions to some predefined humidity and temperature levels. However, this approach is often unfeasible or even impossible. Therefore, in this paper we analyzed a dataset of 1,852 DMS measurements of surgical smoke evaporated from porcine adipose and muscle tissue to get an understanding of the impact of varying humidity and temperature on DMS measurements. Our analysis confirmed clear dependence of the measurements on these two factors. To overcome this challenge, we fitted regression models to raw and normalized DMS measurement data. Subsequently, these models were used for estimating DMS measurements for known tissue types based on recorded humidity and temperatures. Our test suggests that it is possible to estimate DMS measurements of surgical smoke from porcine adipose and muscle tissue under specific environmental conditions by standardizing DMS measurements separation voltage-wise and training multivariate regression models on the normalized data, which is the first step in removing the need for standardized measurement conditions."},{"descriptionType":"Other","description":"20 pages, 9 figures, currently under revision at Annals of Biomedical Engineering"}],"geoLocations":[],"fundingReferences":[],"url":"https://arxiv.org/abs/2602.19572","contentUrl":null,"metadataVersion":0,"schemaVersion":"http://datacite.org/schema/kernel-4","source":"mds","isActive":true,"state":"findable","reason":null,"viewCount":0,"downloadCount":0,"referenceCount":0,"citationCount":0,"partCount":0,"partOfCount":0,"versionCount":0,"versionOfCount":0,"created":"2026-02-25T15:05:58Z","registered":"2026-02-25T15:05:59Z","published":null,"updated":"2026-02-25T15:05:59Z"},"relationships":{"client":{"data":{"id":"arxiv.content","type":"clients"}}}},{"id":"10.48550/arxiv.2602.19569","type":"dois","attributes":{"doi":"10.48550/arxiv.2602.19569","identifiers":[{"identifier":"2602.19569","identifierType":"arXiv"}],"creators":[{"nameType":"Personal","givenName":"Wuzhenghong","familyName":"Wen","name":"Wen, Wuzhenghong","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Bowen","familyName":"Zhou","name":"Zhou, Bowen","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Jinwen","familyName":"Huang","name":"Huang, Jinwen","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Xianjie","familyName":"Wu","name":"Wu, Xianjie","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Yuwei","familyName":"Sun","name":"Sun, Yuwei","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Su","familyName":"Pan","name":"Pan, Su","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Liang","familyName":"Li","name":"Li, Liang","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Jianting","familyName":"Liu","name":"Liu, Jianting","affiliation":[],"nameIdentifiers":[]}],"titles":[{"title":"Temporal-Aware Heterogeneous Graph Reasoning with Multi-View Fusion for Temporal Question Answering"}],"publisher":"arXiv","container":{},"publicationYear":2026,"subjects":[{"subject":"Computation and Language (cs.CL)","lang":"en","subjectScheme":"arXiv"},{"subject":"Artificial Intelligence (cs.AI)","lang":"en","subjectScheme":"arXiv"},{"subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"},{"schemeUri":"http://www.oecd.org/science/inno/38235147.pdf","subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"}],"contributors":[],"dates":[{"date":"2026-02-23T07:36:36Z","dateType":"Submitted","dateInformation":"v1"},{"date":"2026-02-24T02:13:26Z","dateType":"Updated","dateInformation":"v1"},{"date":"2026-02","dateType":"Available","dateInformation":"v1"},{"date":"2026","dateType":"Issued"}],"language":null,"types":{"schemaOrg":"CreativeWork","resourceTypeGeneral":"Preprint","citeproc":"article","bibtex":"misc","ris":"GEN","resourceType":"Article"},"relatedIdentifiers":[],"relatedItems":[],"sizes":[],"formats":[],"version":"1","rightsList":[{"rightsUri":"http://arxiv.org/licenses/nonexclusive-distrib/1.0/","rights":"arXiv.org perpetual, non-exclusive license"}],"descriptions":[{"descriptionType":"Abstract","description":"Question Answering over Temporal Knowledge Graphs (TKGQA) has attracted growing interest for handling time-sensitive queries. However, existing methods still struggle with: 1) weak incorporation of temporal constraints in question representation, causing biased reasoning; 2) limited ability to perform explicit multi-hop reasoning; and 3) suboptimal fusion of language and graph representations. We propose a novel framework with temporal-aware question encoding, multi-hop graph reasoning, and multi-view heterogeneous information fusion. Specifically, our approach introduces: 1) a constraint-aware question representation that combines semantic cues from language models with temporal entity dynamics; 2) a temporal-aware graph neural network for explicit multi-hop reasoning via time-aware message passing; and 3) a multi-view attention mechanism for more effective fusion of question context and temporal graph knowledge. Experiments on multiple TKGQA benchmarks demonstrate consistent improvements over multiple baselines."},{"descriptionType":"Other","description":"6pages"}],"geoLocations":[],"fundingReferences":[],"url":"https://arxiv.org/abs/2602.19569","contentUrl":null,"metadataVersion":0,"schemaVersion":"http://datacite.org/schema/kernel-4","source":"mds","isActive":true,"state":"findable","reason":null,"viewCount":0,"downloadCount":0,"referenceCount":0,"citationCount":0,"partCount":0,"partOfCount":0,"versionCount":0,"versionOfCount":0,"created":"2026-02-25T15:05:51Z","registered":"2026-02-25T15:05:52Z","published":null,"updated":"2026-02-25T15:05:52Z"},"relationships":{"client":{"data":{"id":"arxiv.content","type":"clients"}}}},{"id":"10.48550/arxiv.2602.19567","type":"dois","attributes":{"doi":"10.48550/arxiv.2602.19567","identifiers":[{"identifier":"2602.19567","identifierType":"arXiv"}],"creators":[{"nameType":"Personal","givenName":"Tommaso","familyName":"Bonato","name":"Bonato, Tommaso","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Ales","familyName":"Kubicek","name":"Kubicek, Ales","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Abdul","familyName":"Kabbani","name":"Kabbani, Abdul","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Ahmad","familyName":"Ghalayini","name":"Ghalayini, Ahmad","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Maciej","familyName":"Besta","name":"Besta, Maciej","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Torsten","familyName":"Hoefler","name":"Hoefler, Torsten","affiliation":[],"nameIdentifiers":[]}],"titles":[{"title":"Spritz: Path-Aware Load Balancing in Low-Diameter Networks"}],"publisher":"arXiv","container":{},"publicationYear":2026,"subjects":[{"subject":"Networking and Internet Architecture (cs.NI)","lang":"en","subjectScheme":"arXiv"},{"subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"},{"schemeUri":"http://www.oecd.org/science/inno/38235147.pdf","subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"}],"contributors":[],"dates":[{"date":"2026-02-23T07:33:25Z","dateType":"Submitted","dateInformation":"v1"},{"date":"2026-02-24T02:13:24Z","dateType":"Updated","dateInformation":"v1"},{"date":"2026-02","dateType":"Available","dateInformation":"v1"},{"date":"2026","dateType":"Issued"}],"language":null,"types":{"schemaOrg":"CreativeWork","resourceTypeGeneral":"Preprint","citeproc":"article","bibtex":"misc","ris":"GEN","resourceType":"Article"},"relatedIdentifiers":[],"relatedItems":[],"sizes":[],"formats":[],"version":"1","rightsList":[{"rightsIdentifierScheme":"SPDX","rightsUri":"https://creativecommons.org/licenses/by/4.0/legalcode","schemeUri":"https://spdx.org/licenses/","rights":"Creative Commons Attribution 4.0 International","rightsIdentifier":"cc-by-4.0"}],"descriptions":[{"descriptionType":"Abstract","description":"Low-diameter topologies such as Dragonfly and Slim Fly are increasingly adopted in HPC and datacenter networks, yet existing load balancing techniques either rely on proprietary in-network mechanisms or fail to utilize the full path diversity of these topologies. We introduce Spritz, a flexible sender-based load balancing framework that shifts adaptive topology-aware routing to the endpoints using only standard Ethernet features. We propose two algorithms, Spritz-Scout and Spritz-Spray that, respectively, explore and adaptively cache efficient paths using ECN, packet trimming, and timeout feedback. Through simulation on Dragonfly and Slim Fly topologies with over 1000 endpoints, Spritz outperforms ECMP, UGAL-L, and prior sender-based approaches by up to 1.8x in flow completion time under AI training and datacenter workloads, while offering robust failover with performance improvements of up to 25.4x under link failures, all without additional hardware support. Spritz enables datacenter-scale, commodity Ethernet networks to efficiently leverage low-diameter topologies, offering unified routing and load balancing for the Ultra Ethernet era."}],"geoLocations":[],"fundingReferences":[],"url":"https://arxiv.org/abs/2602.19567","contentUrl":null,"metadataVersion":0,"schemaVersion":"http://datacite.org/schema/kernel-4","source":"mds","isActive":true,"state":"findable","reason":null,"viewCount":0,"downloadCount":0,"referenceCount":0,"citationCount":0,"partCount":0,"partOfCount":0,"versionCount":0,"versionOfCount":0,"created":"2026-02-25T15:05:46Z","registered":"2026-02-25T15:05:47Z","published":null,"updated":"2026-02-25T15:05:47Z"},"relationships":{"client":{"data":{"id":"arxiv.content","type":"clients"}}}},{"id":"10.48550/arxiv.2602.19564","type":"dois","attributes":{"doi":"10.48550/arxiv.2602.19564","identifiers":[{"identifier":"2602.19564","identifierType":"arXiv"}],"creators":[{"nameType":"Personal","givenName":"Xingyue","familyName":"Deng","name":"Deng, Xingyue","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Xuechen","familyName":"Liang","name":"Liang, Xuechen","affiliation":[],"nameIdentifiers":[]}],"titles":[{"title":"Deep Learning Based Monthly Temperature Prediction for Jilin Province: A Multi Model Comparative Study 2000 2026"}],"publisher":"arXiv","container":{},"publicationYear":2026,"subjects":[{"subject":"Atmospheric and Oceanic Physics (physics.ao-ph)","lang":"en","subjectScheme":"arXiv"},{"subject":"FOS: Physical sciences","subjectScheme":"Fields of Science and Technology (FOS)"},{"schemeUri":"http://www.oecd.org/science/inno/38235147.pdf","subject":"FOS: Physical sciences","subjectScheme":"Fields of Science and Technology (FOS)"}],"contributors":[],"dates":[{"date":"2026-02-23T07:25:53Z","dateType":"Submitted","dateInformation":"v1"},{"date":"2026-02-24T02:13:14Z","dateType":"Updated","dateInformation":"v1"},{"date":"2026-02","dateType":"Available","dateInformation":"v1"},{"date":"2026","dateType":"Issued"}],"language":null,"types":{"schemaOrg":"CreativeWork","resourceTypeGeneral":"Preprint","citeproc":"article","bibtex":"misc","ris":"GEN","resourceType":"Article"},"relatedIdentifiers":[],"relatedItems":[],"sizes":[],"formats":[],"version":"1","rightsList":[{"rightsIdentifierScheme":"SPDX","rightsUri":"https://creativecommons.org/licenses/by/4.0/legalcode","schemeUri":"https://spdx.org/licenses/","rights":"Creative Commons Attribution 4.0 International","rightsIdentifier":"cc-by-4.0"}],"descriptions":[{"descriptionType":"Abstract","description":"Jilin Province, a core commercial grain production base in China with a mid-temperate continental monsoon climate and significant temperature fluctuations, relies heavily on temperature for agricultural production and ecological security. Existing temperature prediction studies focus mostly on national/southeastern coastal regions, with few targeting Jilin's specific climatic characteristics, and most models fail to integrate local temperature's spatiotemporal differentiation and seasonal periodicity, limiting prediction accuracy.\n Using 1 km $\\times$ 1 km monthly mean temperature raster data (2000--2024) of Jilin Province, we analyzed regional temperature's spatiotemporal variation and constructed a multi-model comparison system including four deep learning models (LSTM, GRU, BiLSTM, Transformer) and five traditional machine learning models (Ridge/Lasso Regression, SVR, Random Forest, Gradient Boosting). Model performance was evaluated via RMSE, MAE, and $R^2$.\n Results show Jilin's temperature has obvious latitudinal zonal distribution, significant warming trend, strong seasonal periodicity, and high temporal autocorrelation. The LSTM model achieved optimal performance (test set RMSE=2.26 $^\\circ$C, MAE=1.83 $^\\circ$C, $R^2$=0.9655), outperforming traditional models and Transformer. Predictions for 2025--2026 indicate stable seasonal temperature fluctuations with an annual mean of ~4.9 $^\\circ$C.\n This study enriches mid-latitude cold region temperature prediction research, verifies LSTM's applicability for Jilin's monthly temperature prediction, and provides scientific support for agricultural planning, frost disaster warning, and extreme temperature risk prevention."}],"geoLocations":[],"fundingReferences":[],"url":"https://arxiv.org/abs/2602.19564","contentUrl":null,"metadataVersion":0,"schemaVersion":"http://datacite.org/schema/kernel-4","source":"mds","isActive":true,"state":"findable","reason":null,"viewCount":0,"downloadCount":0,"referenceCount":0,"citationCount":0,"partCount":0,"partOfCount":0,"versionCount":0,"versionOfCount":0,"created":"2026-02-25T15:05:39Z","registered":"2026-02-25T15:05:40Z","published":null,"updated":"2026-02-25T15:05:40Z"},"relationships":{"client":{"data":{"id":"arxiv.content","type":"clients"}}}},{"id":"10.48550/arxiv.2602.19563","type":"dois","attributes":{"doi":"10.48550/arxiv.2602.19563","identifiers":[{"identifier":"2602.19563","identifierType":"arXiv"}],"creators":[{"nameType":"Personal","givenName":"Elizabeth","familyName":"Pratt","name":"Pratt, Elizabeth","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Luca","familyName":"Sodomaco","name":"Sodomaco, Luca","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Bernd","familyName":"Sturmfels","name":"Sturmfels, Bernd","affiliation":[],"nameIdentifiers":[]}],"titles":[{"title":"Multigraded Hurwitz forms"}],"publisher":"arXiv","container":{},"publicationYear":2026,"subjects":[{"subject":"Algebraic Geometry (math.AG)","lang":"en","subjectScheme":"arXiv"},{"subject":"FOS: Mathematics","subjectScheme":"Fields of Science and Technology (FOS)"},{"schemeUri":"http://www.oecd.org/science/inno/38235147.pdf","subject":"FOS: Mathematics","subjectScheme":"Fields of Science and Technology (FOS)"}],"contributors":[],"dates":[{"date":"2026-02-23T07:24:11Z","dateType":"Submitted","dateInformation":"v1"},{"date":"2026-02-24T02:13:09Z","dateType":"Updated","dateInformation":"v1"},{"date":"2026-02","dateType":"Available","dateInformation":"v1"},{"date":"2026","dateType":"Issued"}],"language":null,"types":{"schemaOrg":"CreativeWork","resourceTypeGeneral":"Preprint","citeproc":"article","bibtex":"misc","ris":"GEN","resourceType":"Article"},"relatedIdentifiers":[],"relatedItems":[],"sizes":[],"formats":[],"version":"1","rightsList":[{"rightsIdentifierScheme":"SPDX","rightsUri":"https://creativecommons.org/licenses/by/4.0/legalcode","schemeUri":"https://spdx.org/licenses/","rights":"Creative Commons Attribution 4.0 International","rightsIdentifier":"cc-by-4.0"}],"descriptions":[{"descriptionType":"Abstract","description":"The Hurwitz form of a projective variety characterizes linear spaces of complementary dimension which meet the variety non-transversally. We extend this notion to varieties in a product of projective spaces. This parallels the multigraded Chow forms due to Osserman and Trager. We study the degrees of multigraded Hurwitz forms. An explicit degree formula is given for complete intersections. This offers a new tool for elimination theory that has many applications, ranging from Nash equilibria to Feynman integrals."},{"descriptionType":"Other","description":"21 pages"}],"geoLocations":[],"fundingReferences":[],"url":"https://arxiv.org/abs/2602.19563","contentUrl":null,"metadataVersion":0,"schemaVersion":"http://datacite.org/schema/kernel-4","source":"mds","isActive":true,"state":"findable","reason":null,"viewCount":0,"downloadCount":0,"referenceCount":0,"citationCount":0,"partCount":0,"partOfCount":0,"versionCount":0,"versionOfCount":0,"created":"2026-02-25T15:05:37Z","registered":"2026-02-25T15:05:37Z","published":null,"updated":"2026-02-25T15:05:37Z"},"relationships":{"client":{"data":{"id":"arxiv.content","type":"clients"}}}},{"id":"10.48550/arxiv.2602.19562","type":"dois","attributes":{"doi":"10.48550/arxiv.2602.19562","identifiers":[{"identifier":"2602.19562","identifierType":"arXiv"}],"creators":[{"nameType":"Personal","givenName":"Joseph","familyName":"Bingham","name":"Bingham, Joseph","affiliation":[],"nameIdentifiers":[]}],"titles":[{"title":"A Multimodal Framework for Aligning Human Linguistic Descriptions with Visual Perceptual Data"}],"publisher":"arXiv","container":{},"publicationYear":2026,"subjects":[{"subject":"Artificial Intelligence (cs.AI)","lang":"en","subjectScheme":"arXiv"},{"subject":"Computer Vision and Pattern Recognition (cs.CV)","lang":"en","subjectScheme":"arXiv"},{"subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"},{"schemeUri":"http://www.oecd.org/science/inno/38235147.pdf","subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"},{"subject":"I.2.4","lang":"en","subjectScheme":"ACM"}],"contributors":[],"dates":[{"date":"2026-02-23T07:20:11Z","dateType":"Submitted","dateInformation":"v1"},{"date":"2026-02-24T02:12:59Z","dateType":"Updated","dateInformation":"v1"},{"date":"2026-02","dateType":"Available","dateInformation":"v1"},{"date":"2026","dateType":"Issued"}],"language":null,"types":{"schemaOrg":"CreativeWork","resourceTypeGeneral":"Preprint","citeproc":"article","bibtex":"misc","ris":"GEN","resourceType":"Article"},"relatedIdentifiers":[],"relatedItems":[],"sizes":[],"formats":[],"version":"1","rightsList":[{"rightsIdentifierScheme":"SPDX","rightsUri":"https://creativecommons.org/publicdomain/zero/1.0/legalcode","schemeUri":"https://spdx.org/licenses/","rights":"Creative Commons Zero v1.0 Universal","rightsIdentifier":"cc0-1.0"}],"descriptions":[{"descriptionType":"Abstract","description":"Establishing stable mappings between natural language expressions and visual percepts is a foundational problem for both cognitive science and artificial intelligence. Humans routinely ground linguistic reference in noisy, ambiguous perceptual contexts, yet the mechanisms supporting such cross-modal alignment remain poorly understood. In this work, we introduce a computational framework designed to model core aspects of human referential interpretation by integrating linguistic utterances with perceptual representations derived from large-scale, crowd-sourced imagery. The system approximates human perceptual categorization by combining scale-invariant feature transform (SIFT) alignment with the Universal Quality Index (UQI) to quantify similarity in a cognitively plausible feature space, while a set of linguistic preprocessing and query-transformation operations captures pragmatic variability in referring expressions. We evaluate the model on the Stanford Repeated Reference Game corpus (15,000 utterances paired with tangram stimuli), a paradigm explicitly developed to probe human-level perceptual ambiguity and coordination. Our framework achieves robust referential grounding. It requires 65\\% fewer utterances than human interlocutors to reach stable mappings and can correctly identify target objects from single referring expressions 41.66\\% of the time (versus 20\\% for humans).These results suggest that relatively simple perceptual-linguistic alignment mechanisms can yield human-competitive behavior on a classic cognitive benchmark, and offers insights into models of grounded communication, perceptual inference, and cross-modal concept formation. Code is available at https://anonymous.4open.science/r/metasequoia-9D13/README.md ."},{"descriptionType":"Other","description":"19 Pages, 6 figures, preprint"}],"geoLocations":[],"fundingReferences":[],"url":"https://arxiv.org/abs/2602.19562","contentUrl":null,"metadataVersion":0,"schemaVersion":"http://datacite.org/schema/kernel-4","source":"mds","isActive":true,"state":"findable","reason":null,"viewCount":0,"downloadCount":0,"referenceCount":0,"citationCount":0,"partCount":0,"partOfCount":0,"versionCount":0,"versionOfCount":0,"created":"2026-02-25T15:05:34Z","registered":"2026-02-25T15:05:35Z","published":null,"updated":"2026-02-25T15:05:35Z"},"relationships":{"client":{"data":{"id":"arxiv.content","type":"clients"}}}},{"id":"10.48550/arxiv.2602.19561","type":"dois","attributes":{"doi":"10.48550/arxiv.2602.19561","identifiers":[{"identifier":"2602.19561","identifierType":"arXiv"}],"creators":[{"nameType":"Personal","givenName":"Ryouke","familyName":"Ikura","name":"Ikura, Ryouke","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Junya","familyName":"Hara","name":"Hara, Junya","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Hiroshi","familyName":"Higashi","name":"Higashi, Hiroshi","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Yuichi","familyName":"Tanaka","name":"Tanaka, Yuichi","affiliation":[],"nameIdentifiers":[]}],"titles":[{"title":"Dynamic Sensor Scheduling Based on Node Partitioning of Graphs"}],"publisher":"arXiv","container":{},"publicationYear":2026,"subjects":[{"subject":"Signal Processing (eess.SP)","lang":"en","subjectScheme":"arXiv"},{"subject":"FOS: Electrical engineering, electronic engineering, information engineering","subjectScheme":"Fields of Science and Technology (FOS)"},{"schemeUri":"http://www.oecd.org/science/inno/38235147.pdf","subject":"FOS: Electrical engineering, electronic engineering, information engineering","subjectScheme":"Fields of Science and Technology (FOS)"}],"contributors":[],"dates":[{"date":"2026-02-23T07:20:11Z","dateType":"Submitted","dateInformation":"v1"},{"date":"2026-02-24T02:12:57Z","dateType":"Updated","dateInformation":"v1"},{"date":"2026-02","dateType":"Available","dateInformation":"v1"},{"date":"2026","dateType":"Issued"}],"language":null,"types":{"schemaOrg":"CreativeWork","resourceTypeGeneral":"Preprint","citeproc":"article","bibtex":"misc","ris":"GEN","resourceType":"Article"},"relatedIdentifiers":[],"relatedItems":[],"sizes":[],"formats":[],"version":"1","rightsList":[{"rightsIdentifierScheme":"SPDX","rightsUri":"https://creativecommons.org/licenses/by/4.0/legalcode","schemeUri":"https://spdx.org/licenses/","rights":"Creative Commons Attribution 4.0 International","rightsIdentifier":"cc-by-4.0"}],"descriptions":[{"descriptionType":"Abstract","description":"This paper proposes a dynamic sensor scheduling method for sensor networks. In sensor network applications, we often need multiple equally-informative node subsets that are activated sequentially to make a sensor network robust against concentrated battery consumption and sensor failures. In addition, quality of these subsets changes dynamically and thus we must adapt those changes. To find those node subsets, we propose a graph node partitioning method based on sampling theory for graph signals. We aim to minimize the average reconstruction error for signals obtained at all node subsets, in contrast to conventional single subset selection. The graph node partitioning problem is formulated as a difference-of-convex (DC) optimization based on a subspace prior of graph signals, and is solved by the proximal DC algorithm. It guarantees convergence to a critical point. To accommodate the online scenario where the signal subspace and optimal partitioning may change over time, we adaptively estimate the signal subspace from historical data and sequentially update the prior for our partitioning method. Numerical experiments on synthetic and real-world sensor network data demonstrate that the proposed method achieves lower average mean squared errors compared to alternative methods."},{"descriptionType":"Other","description":"Submitted to IEEE Open Journal of Signal Processing"}],"geoLocations":[],"fundingReferences":[],"url":"https://arxiv.org/abs/2602.19561","contentUrl":null,"metadataVersion":0,"schemaVersion":"http://datacite.org/schema/kernel-4","source":"mds","isActive":true,"state":"findable","reason":null,"viewCount":0,"downloadCount":0,"referenceCount":0,"citationCount":0,"partCount":0,"partOfCount":0,"versionCount":0,"versionOfCount":0,"created":"2026-02-25T15:05:32Z","registered":"2026-02-25T15:05:33Z","published":null,"updated":"2026-02-25T15:05:33Z"},"relationships":{"client":{"data":{"id":"arxiv.content","type":"clients"}}}},{"id":"10.48550/arxiv.2602.19560","type":"dois","attributes":{"doi":"10.48550/arxiv.2602.19560","identifiers":[{"identifier":"2602.19560","identifierType":"arXiv"}],"creators":[{"nameType":"Personal","givenName":"Kynnedy Simone","familyName":"Smith","name":"Smith, Kynnedy Simone","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Lydia B.","familyName":"Chilton","name":"Chilton, Lydia B.","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Danielle","familyName":"Bragg","name":"Bragg, Danielle","affiliation":[],"nameIdentifiers":[]}],"titles":[{"title":"Identifying, Explaining, and Correcting Ableist Language with AI"}],"publisher":"arXiv","container":{},"publicationYear":2026,"subjects":[{"subject":"Human-Computer Interaction (cs.HC)","lang":"en","subjectScheme":"arXiv"},{"subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"},{"schemeUri":"http://www.oecd.org/science/inno/38235147.pdf","subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"}],"contributors":[],"dates":[{"date":"2026-02-23T07:14:08Z","dateType":"Submitted","dateInformation":"v1"},{"date":"2026-02-24T02:12:54Z","dateType":"Updated","dateInformation":"v1"},{"date":"2026-02","dateType":"Available","dateInformation":"v1"},{"date":"2026","dateType":"Issued"}],"language":null,"types":{"schemaOrg":"CreativeWork","resourceTypeGeneral":"Preprint","citeproc":"article","bibtex":"misc","ris":"GEN","resourceType":"Article"},"relatedIdentifiers":[{"relationType":"IsVersionOf","relatedIdentifier":"10.1145/3772318.3790533","relatedIdentifierType":"DOI"}],"relatedItems":[],"sizes":[],"formats":[],"version":"1","rightsList":[{"rightsIdentifierScheme":"SPDX","rightsUri":"https://creativecommons.org/licenses/by/4.0/legalcode","schemeUri":"https://spdx.org/licenses/","rights":"Creative Commons Attribution 4.0 International","rightsIdentifier":"cc-by-4.0"}],"descriptions":[{"descriptionType":"Abstract","description":"Ableist language perpetuates harmful stereotypes and exclusion, yet its nuanced nature makes it difficult to recognize and address. Artificial intelligence could serve as a powerful ally in the fight against ableist language, offering tools that detect and suggest alternatives to biased terms. This two-part study investigates the potential of large language models (LLMs), specifically ChatGPT, to rectify ableist language and educate users about inclusive communication. We compared GPT-4o generations with crowdsourced annotations from trained disability community members, then invited disabled participants to evaluate both. Participants reported equal agreement with human and AI annotations but significantly preferred the AI, citing its narrative consistency and accessible style. At the same time, they valued the emotional depth and cultural grounding of human annotations. These findings highlight the promise and limits of LLMs in handling culturally sensitive content. Our contributions include a dataset of nuanced ableism annotations and design considerations for inclusive writing tools."},{"descriptionType":"Other","description":"17 pages, 6 figures, Accepted for publication in CHI'26, Barcelona, Spain, April 13 - 17, 2026; CHI '26: ACM CHI Conference on Human Factors in Computing Systems"}],"geoLocations":[],"fundingReferences":[],"url":"https://arxiv.org/abs/2602.19560","contentUrl":null,"metadataVersion":0,"schemaVersion":"http://datacite.org/schema/kernel-4","source":"mds","isActive":true,"state":"findable","reason":null,"viewCount":0,"downloadCount":0,"referenceCount":0,"citationCount":0,"partCount":0,"partOfCount":0,"versionCount":0,"versionOfCount":1,"created":"2026-02-25T15:05:29Z","registered":"2026-02-25T15:05:30Z","published":null,"updated":"2026-02-25T15:05:30Z"},"relationships":{"client":{"data":{"id":"arxiv.content","type":"clients"}}}},{"id":"10.48550/arxiv.2602.19559","type":"dois","attributes":{"doi":"10.48550/arxiv.2602.19559","identifiers":[{"identifier":"2602.19559","identifierType":"arXiv"}],"creators":[{"nameType":"Personal","givenName":"Peijun","familyName":"Li","name":"Li, Peijun","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Zhenqian","familyName":"Li","name":"Li, Zhenqian","affiliation":[],"nameIdentifiers":[]}],"titles":[{"title":"An inverse random source problem for the fractional Helmholtz equation"}],"publisher":"arXiv","container":{},"publicationYear":2026,"subjects":[{"subject":"Analysis of PDEs (math.AP)","lang":"en","subjectScheme":"arXiv"},{"subject":"FOS: Mathematics","subjectScheme":"Fields of Science and Technology (FOS)"},{"schemeUri":"http://www.oecd.org/science/inno/38235147.pdf","subject":"FOS: Mathematics","subjectScheme":"Fields of Science and Technology (FOS)"}],"contributors":[],"dates":[{"date":"2026-02-23T07:11:19Z","dateType":"Submitted","dateInformation":"v1"},{"date":"2026-02-24T02:12:46Z","dateType":"Updated","dateInformation":"v1"},{"date":"2026-02","dateType":"Available","dateInformation":"v1"},{"date":"2026","dateType":"Issued"}],"language":null,"types":{"schemaOrg":"CreativeWork","resourceTypeGeneral":"Preprint","citeproc":"article","bibtex":"misc","ris":"GEN","resourceType":"Article"},"relatedIdentifiers":[],"relatedItems":[],"sizes":[],"formats":[],"version":"1","rightsList":[{"rightsUri":"http://arxiv.org/licenses/nonexclusive-distrib/1.0/","rights":"arXiv.org perpetual, non-exclusive license"}],"descriptions":[{"descriptionType":"Abstract","description":"This paper investigates an inverse random source problem for the stochastic fractional Helmholtz equation. The source is modeled as a centered, complex-valued, microlocally isotropic generalized Gaussian random field whose covariance and relation operators are described by classical pseudo-differential operators. For sufficiently large wavenumbers, we first establish the well-posedness of the direct problem in the distributional sense by analyzing the corresponding Lippmann--Schwinger integral equation. For the inverse problem, we show that the principal symbols of both the covariance and relation operators can be uniquely determined, with probability one, from the far-field patterns generated by a single realization of the random source. The approach employs a combination of the Born linearization, asymptotic expansions of the fractional Helmholtz Green kernel at high wavenumbers, and microlocal analysis of associated Fourier integral operators."}],"geoLocations":[],"fundingReferences":[],"url":"https://arxiv.org/abs/2602.19559","contentUrl":null,"metadataVersion":0,"schemaVersion":"http://datacite.org/schema/kernel-4","source":"mds","isActive":true,"state":"findable","reason":null,"viewCount":0,"downloadCount":0,"referenceCount":0,"citationCount":0,"partCount":0,"partOfCount":0,"versionCount":0,"versionOfCount":0,"created":"2026-02-25T15:05:27Z","registered":"2026-02-25T15:05:28Z","published":null,"updated":"2026-02-25T15:05:28Z"},"relationships":{"client":{"data":{"id":"arxiv.content","type":"clients"}}}},{"id":"10.48550/arxiv.2602.19558","type":"dois","attributes":{"doi":"10.48550/arxiv.2602.19558","identifiers":[{"identifier":"2602.19558","identifierType":"arXiv"}],"creators":[{"nameType":"Personal","givenName":"Ben T.","familyName":"McDonough","name":"McDonough, Ben T.","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Jian-Hao","familyName":"Zhang","name":"Zhang, Jian-Hao","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Victor V.","familyName":"Albert","name":"Albert, Victor V.","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Andrew","familyName":"Lucas","name":"Lucas, Andrew","affiliation":[],"nameIdentifiers":[]}],"titles":[{"title":"Calderbank-Shor-Steane codes on group-valued qudits"}],"publisher":"arXiv","container":{},"publicationYear":2026,"subjects":[{"subject":"Quantum Physics (quant-ph)","lang":"en","subjectScheme":"arXiv"},{"subject":"Strongly Correlated Electrons (cond-mat.str-el)","lang":"en","subjectScheme":"arXiv"},{"subject":"FOS: Physical sciences","subjectScheme":"Fields of Science and Technology (FOS)"},{"schemeUri":"http://www.oecd.org/science/inno/38235147.pdf","subject":"FOS: Physical sciences","subjectScheme":"Fields of Science and Technology (FOS)"}],"contributors":[],"dates":[{"date":"2026-02-23T07:08:00Z","dateType":"Submitted","dateInformation":"v1"},{"date":"2026-02-24T02:12:41Z","dateType":"Updated","dateInformation":"v1"},{"date":"2026-02","dateType":"Available","dateInformation":"v1"},{"date":"2026","dateType":"Issued"}],"language":null,"types":{"schemaOrg":"CreativeWork","resourceTypeGeneral":"Preprint","citeproc":"article","bibtex":"misc","ris":"GEN","resourceType":"Article"},"relatedIdentifiers":[],"relatedItems":[],"sizes":[],"formats":[],"version":"1","rightsList":[{"rightsUri":"http://arxiv.org/licenses/nonexclusive-distrib/1.0/","rights":"arXiv.org perpetual, non-exclusive license"}],"descriptions":[{"descriptionType":"Abstract","description":"Calderbank-Shor-Steane (CSS) codes are a versatile quantum error-correcting family built out of commuting $X$- and $Z$-type checks. We introduce CSS-like codes on $G$-valued qudits for any finite group $G$ that reduce to qubit CSS codes for $G = \\mathbb{Z}_2$ yet generalize the Kitaev quantum double model for general groups. The $X$-checks of our group-CSS codes correspond to left and/or right multiplication by group elements, while $Z$-checks project onto solutions to group word equations. We describe quantum-double models on oriented two-dimensional CW complexes (which need not cellulate a manifold) and prove that, when $G$ is non-Abelian and simple, every $G$-covariant group-CSS code with suitably upper-bounded $Z$-check weight and lower-bounded $Z$-distance reduces to a CW quantum double. We describe the codespace and logical operators of CW quantum doubles via the same intuition used to obtain logical structure of surface codes. We obtain distance bounds for codes on non-Abelian simple groups from the graph underlying the CW complex, and construct intrinsically non-Abelian code families with asymptotically optimal rate and distances. Adding \"ghost vertices\" to the CW complex generalizes quantum double models with defects and rough boundary conditions whose logical structure can be understood without reference to non-Abelian anyons or defects. Several non-invertible symmetry-protected topological states, both with ordinary and higher-form symmetries, are the unique codewords of simply-connected CW quantum doubles with a single ghost vertex."},{"descriptionType":"Other","description":"44 pages, 17 figures"}],"geoLocations":[],"fundingReferences":[],"url":"https://arxiv.org/abs/2602.19558","contentUrl":null,"metadataVersion":0,"schemaVersion":"http://datacite.org/schema/kernel-4","source":"mds","isActive":true,"state":"findable","reason":null,"viewCount":0,"downloadCount":0,"referenceCount":0,"citationCount":0,"partCount":0,"partOfCount":0,"versionCount":0,"versionOfCount":0,"created":"2026-02-25T15:05:24Z","registered":"2026-02-25T15:05:25Z","published":null,"updated":"2026-02-25T15:05:25Z"},"relationships":{"client":{"data":{"id":"arxiv.content","type":"clients"}}}},{"id":"10.48550/arxiv.2602.19557","type":"dois","attributes":{"doi":"10.48550/arxiv.2602.19557","identifiers":[{"identifier":"2602.19557","identifierType":"arXiv"}],"creators":[{"nameType":"Personal","givenName":"Prakash A.","familyName":"Dabhi","name":"Dabhi, Prakash A.","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Karishman B.","familyName":"Solanki","name":"Solanki, Karishman B.","affiliation":[],"nameIdentifiers":[]}],"titles":[{"title":"Wiener type theorems for countable limits of quasi-Beurling algebras and maximizing results on weights"}],"publisher":"arXiv","container":{},"publicationYear":2026,"subjects":[{"subject":"Functional Analysis (math.FA)","lang":"en","subjectScheme":"arXiv"},{"subject":"Spectral Theory (math.SP)","lang":"en","subjectScheme":"arXiv"},{"subject":"FOS: Mathematics","subjectScheme":"Fields of Science and Technology (FOS)"},{"schemeUri":"http://www.oecd.org/science/inno/38235147.pdf","subject":"FOS: Mathematics","subjectScheme":"Fields of Science and Technology (FOS)"}],"contributors":[],"dates":[{"date":"2026-02-23T07:03:55Z","dateType":"Submitted","dateInformation":"v1"},{"date":"2026-02-24T02:12:40Z","dateType":"Updated","dateInformation":"v1"},{"date":"2026-02","dateType":"Available","dateInformation":"v1"},{"date":"2026","dateType":"Issued"}],"language":null,"types":{"schemaOrg":"CreativeWork","resourceTypeGeneral":"Preprint","citeproc":"article","bibtex":"misc","ris":"GEN","resourceType":"Article"},"relatedIdentifiers":[],"relatedItems":[],"sizes":[],"formats":[],"version":"1","rightsList":[{"rightsUri":"http://arxiv.org/licenses/nonexclusive-distrib/1.0/","rights":"arXiv.org perpetual, non-exclusive license"}],"descriptions":[{"descriptionType":"Abstract","description":"We establish the vector-valued Wiener type theorems for countable projective and inductive limits of quasi-Banach algebras in a weighted setting for both finite and infinite dimensional cases. As an application, we extend the notions of rapidly decreasing and exponentially decreasing sequence spaces using quasi-Beurling algebras and show that they are inverse-closed; and obtain a hierarchy of inverse-closed vector-valued algebras using weights. In addition, we derive maximizing results on weights for the nonadmissible weighted version of Wiener's theorem in both discrete and continuous cases."}],"geoLocations":[],"fundingReferences":[],"url":"https://arxiv.org/abs/2602.19557","contentUrl":null,"metadataVersion":0,"schemaVersion":"http://datacite.org/schema/kernel-4","source":"mds","isActive":true,"state":"findable","reason":null,"viewCount":0,"downloadCount":0,"referenceCount":0,"citationCount":0,"partCount":0,"partOfCount":0,"versionCount":0,"versionOfCount":0,"created":"2026-02-25T15:05:22Z","registered":"2026-02-25T15:05:23Z","published":null,"updated":"2026-02-25T15:05:23Z"},"relationships":{"client":{"data":{"id":"arxiv.content","type":"clients"}}}},{"id":"10.48550/arxiv.2602.19554","type":"dois","attributes":{"doi":"10.48550/arxiv.2602.19554","identifiers":[{"identifier":"2602.19554","identifierType":"arXiv"}],"creators":[{"nameType":"Personal","givenName":"Daniel A.","familyName":"Muñoz","name":"Muñoz, Daniel A.","affiliation":[],"nameIdentifiers":[]}],"titles":[{"title":"Sound-first immersive training for blind and low-vision learners: A simulation flow for safe, standardized orientation, mobility, and daily living practice"}],"publisher":"arXiv","container":{},"publicationYear":2026,"subjects":[{"subject":"Human-Computer Interaction (cs.HC)","lang":"en","subjectScheme":"arXiv"},{"subject":"Computers and Society (cs.CY)","lang":"en","subjectScheme":"arXiv"},{"subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"},{"schemeUri":"http://www.oecd.org/science/inno/38235147.pdf","subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"}],"contributors":[],"dates":[{"date":"2026-02-23T06:55:05Z","dateType":"Submitted","dateInformation":"v1"},{"date":"2026-02-24T02:12:29Z","dateType":"Updated","dateInformation":"v1"},{"date":"2026-02","dateType":"Available","dateInformation":"v1"},{"date":"2026","dateType":"Issued"}],"language":null,"types":{"schemaOrg":"CreativeWork","resourceTypeGeneral":"Preprint","citeproc":"article","bibtex":"misc","ris":"GEN","resourceType":"Article"},"relatedIdentifiers":[],"relatedItems":[],"sizes":[],"formats":[],"version":"1","rightsList":[{"rightsUri":"http://arxiv.org/licenses/nonexclusive-distrib/1.0/","rights":"arXiv.org perpetual, non-exclusive license"}],"descriptions":[{"descriptionType":"Abstract","description":"Orientation and mobility (O\u0026amp;M) instruction for blind and low-vision learners is effective but difficult to standardize and repeat at scale due to the reliance on instructor availability, physical mock-ups, and variable real-world outdoor conditions. This Technical Note presents a sound-first immersive training flow that uses spatial audio and sonification as the primary channel for action and feedback in pre-street O\u0026amp;M and daily-living practice. The approach specifies parameterized scenario templates (e.g., signalized street crossing, public transport boarding, and kitchen tasks), a compact and consistent cue vocabulary with clear spectral placement and timing to mitigate masking, and a lightweight safety protocol enabling graded exposure, content warnings, seated starts, opt-outs, and structured debriefs. The system assumes a head-mounted device with high-quality binaural rendering and head tracking; 3D scene geometry is used as an invisible scaffold to anchor sources, trigger events, define risk/guidance volumes, and govern physically plausible motion without visuals. Session difficulty is shaped via cue density, event tempo, and task complexity while preserving cue consistency to promote transfer across scenarios. The specification aims to enable safe repetition, reduce instructor burden, and support clearer standards across rehabilitation centers, aligning with evidence that audio-first interaction is essential for blind and visually impaired users and addressing gaps in HRTF personalization, evaluation standards, and accessibility integration. Although no behavioral outcomes are reported here, this implementable flow consolidates auditory science with center-ready design, offering a pragmatic foundation for standardized evaluation and future comparative studies."}],"geoLocations":[],"fundingReferences":[],"url":"https://arxiv.org/abs/2602.19554","contentUrl":null,"metadataVersion":0,"schemaVersion":"http://datacite.org/schema/kernel-4","source":"mds","isActive":true,"state":"findable","reason":null,"viewCount":0,"downloadCount":0,"referenceCount":0,"citationCount":0,"partCount":0,"partOfCount":0,"versionCount":0,"versionOfCount":0,"created":"2026-02-25T15:05:14Z","registered":"2026-02-25T15:05:15Z","published":null,"updated":"2026-02-25T15:05:15Z"},"relationships":{"client":{"data":{"id":"arxiv.content","type":"clients"}}}},{"id":"10.48550/arxiv.2602.19553","type":"dois","attributes":{"doi":"10.48550/arxiv.2602.19553","identifiers":[{"identifier":"2602.19553","identifierType":"arXiv"}],"creators":[{"nameType":"Personal","givenName":"Debojit","familyName":"Paul","name":"Paul, Debojit","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Sanjeev","familyName":"Kalita","name":"Kalita, Sanjeev","affiliation":[],"nameIdentifiers":[]}],"titles":[{"title":"Probing dark matter distributions with the pericentre precession of the stellar orbits near the Galactic Centre black hole"}],"publisher":"arXiv","container":{},"publicationYear":2026,"subjects":[{"subject":"Astrophysics of Galaxies (astro-ph.GA)","lang":"en","subjectScheme":"arXiv"},{"subject":"General Relativity and Quantum Cosmology (gr-qc)","lang":"en","subjectScheme":"arXiv"},{"subject":"FOS: Physical sciences","subjectScheme":"Fields of Science and Technology (FOS)"},{"schemeUri":"http://www.oecd.org/science/inno/38235147.pdf","subject":"FOS: Physical sciences","subjectScheme":"Fields of Science and Technology (FOS)"}],"contributors":[],"dates":[{"date":"2026-02-23T06:54:34Z","dateType":"Submitted","dateInformation":"v1"},{"date":"2026-02-24T02:12:21Z","dateType":"Updated","dateInformation":"v1"},{"date":"2026-02","dateType":"Available","dateInformation":"v1"},{"date":"2026","dateType":"Issued"}],"language":null,"types":{"schemaOrg":"CreativeWork","resourceTypeGeneral":"Preprint","citeproc":"article","bibtex":"misc","ris":"GEN","resourceType":"Article"},"relatedIdentifiers":[{"relationType":"IsVersionOf","relatedIdentifier":"10.1093/mnras/stag318","relatedIdentifierType":"DOI"}],"relatedItems":[],"sizes":[],"formats":[],"version":"1","rightsList":[{"rightsUri":"http://arxiv.org/licenses/nonexclusive-distrib/1.0/","rights":"arXiv.org perpetual, non-exclusive license"}],"descriptions":[{"descriptionType":"Abstract","description":"The Galactic Centre black hole provides a naive environment for understanding unknown matter distribution and new gravitational physics. For this stellar orbits in the nuclear star cluster are reliable probes. We investigate different dark matter mass profiles through pericentre shift of stellar orbits near the black hole. We also study capability of existing and upcoming astrometric facilities to detect dark matter induced precession and to distinguish between several dark matter profiles. Parameters of different dark matter density profiles are estimated by using the most recent upper bound on dark mass near the black hole. These profiles are then used for calculating the gravitational potential and hence the relativistic pericentre shift of both low and high eccentricity orbits of 13 S-stars. We use the recently measured deviation parameter $f_{sp}$ for investigating competition between dark matter and gravitational physics within S2's orbit. The astrometric shift of the pericentres has been calculated and compared with existing and upcoming astrometric capabilities of large and extremely large telescopes. The orbit of S2 is found to be insensitive to dark matter induced precession. Low eccentricity and wider orbits are prominent probes for measuring dark matter induced precession which is accessible to present and upcoming astrometric facilities such as Keck, GRAVITY and TMT. The existing and upcoming facilities can distinguish between different dark matter profiles for some stars and hence they posses the capability to distinguish between possible formation histories of the central region of our Galaxy."},{"descriptionType":"Other","description":"15 pages, 5 figures, 3 tables, Accepted for publication in MNRAS"}],"geoLocations":[],"fundingReferences":[],"url":"https://arxiv.org/abs/2602.19553","contentUrl":null,"metadataVersion":0,"schemaVersion":"http://datacite.org/schema/kernel-4","source":"mds","isActive":true,"state":"findable","reason":null,"viewCount":0,"downloadCount":0,"referenceCount":0,"citationCount":0,"partCount":0,"partOfCount":0,"versionCount":0,"versionOfCount":1,"created":"2026-02-25T15:05:12Z","registered":"2026-02-25T15:05:13Z","published":null,"updated":"2026-02-25T15:05:13Z"},"relationships":{"client":{"data":{"id":"arxiv.content","type":"clients"}}}},{"id":"10.48550/arxiv.2602.19552","type":"dois","attributes":{"doi":"10.48550/arxiv.2602.19552","identifiers":[{"identifier":"2602.19552","identifierType":"arXiv"}],"creators":[{"nameType":"Personal","givenName":"Kasper Green","familyName":"Larsen","name":"Larsen, Kasper Green","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Markus Engelund","familyName":"Mathiasen","name":"Mathiasen, Markus Engelund","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Chirag","familyName":"Pabbaraju","name":"Pabbaraju, Chirag","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Clement","familyName":"Svendsen","name":"Svendsen, Clement","affiliation":[],"nameIdentifiers":[]}],"titles":[{"title":"The Sample Complexity of Replicable Realizable PAC Learning"}],"publisher":"arXiv","container":{},"publicationYear":2026,"subjects":[{"subject":"Machine Learning (cs.LG)","lang":"en","subjectScheme":"arXiv"},{"subject":"Computational Complexity (cs.CC)","lang":"en","subjectScheme":"arXiv"},{"subject":"Data Structures and Algorithms (cs.DS)","lang":"en","subjectScheme":"arXiv"},{"subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"},{"schemeUri":"http://www.oecd.org/science/inno/38235147.pdf","subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"}],"contributors":[],"dates":[{"date":"2026-02-23T06:52:11Z","dateType":"Submitted","dateInformation":"v1"},{"date":"2026-02-24T02:12:20Z","dateType":"Updated","dateInformation":"v1"},{"date":"2026-02","dateType":"Available","dateInformation":"v1"},{"date":"2026","dateType":"Issued"}],"language":null,"types":{"schemaOrg":"CreativeWork","resourceTypeGeneral":"Preprint","citeproc":"article","bibtex":"misc","ris":"GEN","resourceType":"Article"},"relatedIdentifiers":[],"relatedItems":[],"sizes":[],"formats":[],"version":"1","rightsList":[{"rightsUri":"http://arxiv.org/licenses/nonexclusive-distrib/1.0/","rights":"arXiv.org perpetual, non-exclusive license"}],"descriptions":[{"descriptionType":"Abstract","description":"In this paper, we consider the problem of replicable realizable PAC learning. We construct a particularly hard learning problem and show a sample complexity lower bound with a close to $(\\log|H|)^{3/2}$ dependence on the size of the hypothesis class $H$. Our proof uses several novel techniques and works by defining a particular Cayley graph associated with $H$ and analyzing a suitable random walk on this graph by examining the spectral properties of its adjacency matrix.\n Furthermore, we show an almost matching upper bound for the lower bound instance, meaning if a stronger lower bound exists, one would have to consider a different instance of the problem."}],"geoLocations":[],"fundingReferences":[],"url":"https://arxiv.org/abs/2602.19552","contentUrl":null,"metadataVersion":0,"schemaVersion":"http://datacite.org/schema/kernel-4","source":"mds","isActive":true,"state":"findable","reason":null,"viewCount":0,"downloadCount":0,"referenceCount":0,"citationCount":0,"partCount":0,"partOfCount":0,"versionCount":0,"versionOfCount":0,"created":"2026-02-25T15:05:09Z","registered":"2026-02-25T15:05:10Z","published":null,"updated":"2026-02-25T15:05:10Z"},"relationships":{"client":{"data":{"id":"arxiv.content","type":"clients"}}}},{"id":"10.48550/arxiv.2602.19551","type":"dois","attributes":{"doi":"10.48550/arxiv.2602.19551","identifiers":[{"identifier":"2602.19551","identifierType":"arXiv"}],"creators":[{"nameType":"Personal","givenName":"David S.","familyName":"Jerison","name":"Jerison, David S.","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Carlos E.","familyName":"Kenig","name":"Kenig, Carlos E.","affiliation":[],"nameIdentifiers":[]}],"titles":[{"title":"The homogeneous and inhomogeneous Dirichlet problem"}],"publisher":"arXiv","container":{},"publicationYear":2026,"subjects":[{"subject":"Analysis of PDEs (math.AP)","lang":"en","subjectScheme":"arXiv"},{"subject":"FOS: Mathematics","subjectScheme":"Fields of Science and Technology (FOS)"},{"schemeUri":"http://www.oecd.org/science/inno/38235147.pdf","subject":"FOS: Mathematics","subjectScheme":"Fields of Science and Technology (FOS)"},{"subject":"35, 42","lang":"en","subjectScheme":"MSC"}],"contributors":[],"dates":[{"date":"2026-02-23T06:51:32Z","dateType":"Submitted","dateInformation":"v1"},{"date":"2026-02-24T02:12:20Z","dateType":"Updated","dateInformation":"v1"},{"date":"2026-02","dateType":"Available","dateInformation":"v1"},{"date":"2026","dateType":"Issued"}],"language":null,"types":{"schemaOrg":"CreativeWork","resourceTypeGeneral":"Preprint","citeproc":"article","bibtex":"misc","ris":"GEN","resourceType":"Article"},"relatedIdentifiers":[],"relatedItems":[],"sizes":[],"formats":[],"version":"1","rightsList":[{"rightsIdentifierScheme":"SPDX","rightsUri":"https://creativecommons.org/licenses/by-sa/4.0/legalcode","schemeUri":"https://spdx.org/licenses/","rights":"Creative Commons Attribution Share Alike 4.0 International","rightsIdentifier":"cc-by-sa-4.0"}],"descriptions":[{"descriptionType":"Abstract","description":"We revisit the homogeneous and inhomogeneous Dirichlet problem for the Laplacian on Lipschitz domains. This is motivated by the recent postings by Amrouche and Moussaoui which purport to contradict known area integral estimates of Dahlberg and known Sobolev space estimates of Jerison and Kenig. We explain the fatal gap in the reasoning in these postings and give a self-contained proof of a special case of the results of Dahlberg. We then show that this is sufficient to disprove the central conclusions of these postings. We also provide two further proofs of the results of Dahlberg, adapted from work of Kenig and of Dahlberg-Kenig-Pipher-Verchota. Other proofs are in the original paper by Dahlberg and in work by Fabes-Mendez-Mitrea."},{"descriptionType":"Other","description":"43 pages"}],"geoLocations":[],"fundingReferences":[],"url":"https://arxiv.org/abs/2602.19551","contentUrl":null,"metadataVersion":0,"schemaVersion":"http://datacite.org/schema/kernel-4","source":"mds","isActive":true,"state":"findable","reason":null,"viewCount":0,"downloadCount":0,"referenceCount":0,"citationCount":0,"partCount":0,"partOfCount":0,"versionCount":0,"versionOfCount":0,"created":"2026-02-25T15:05:07Z","registered":"2026-02-25T15:05:07Z","published":null,"updated":"2026-02-25T15:05:07Z"},"relationships":{"client":{"data":{"id":"arxiv.content","type":"clients"}}}},{"id":"10.48550/arxiv.2602.19550","type":"dois","attributes":{"doi":"10.48550/arxiv.2602.19550","identifiers":[{"identifier":"2602.19550","identifierType":"arXiv"}],"creators":[{"nameType":"Personal","affiliation":["Chain Reaction, Ltd"],"givenName":"Ilan","familyName":"Rosenfeld","name":"Rosenfeld, Ilan","nameIdentifiers":[]},{"nameType":"Personal","affiliation":["Chain Reaction, Ltd"],"givenName":"Noam","familyName":"Kleinburd","name":"Kleinburd, Noam","nameIdentifiers":[]},{"nameType":"Personal","affiliation":["Chain Reaction, Ltd"],"givenName":"Hillel","familyName":"Chapman","name":"Chapman, Hillel","nameIdentifiers":[]},{"nameType":"Personal","affiliation":["Chain Reaction, Ltd"],"givenName":"Dror","familyName":"Reuven","name":"Reuven, Dror","nameIdentifiers":[]}],"titles":[{"title":"Hardware-Friendly Randomization: Enabling Random-Access and Minimal Wiring in FHE Accelerators with Low Total Cost"}],"publisher":"arXiv","container":{},"publicationYear":2026,"subjects":[{"subject":"Cryptography and Security (cs.CR)","lang":"en","subjectScheme":"arXiv"},{"subject":"Hardware Architecture (cs.AR)","lang":"en","subjectScheme":"arXiv"},{"subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"},{"schemeUri":"http://www.oecd.org/science/inno/38235147.pdf","subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"}],"contributors":[],"dates":[{"date":"2026-02-23T06:49:32Z","dateType":"Submitted","dateInformation":"v1"},{"date":"2026-02-24T02:12:15Z","dateType":"Updated","dateInformation":"v1"},{"date":"2026-02","dateType":"Available","dateInformation":"v1"},{"date":"2026","dateType":"Issued"}],"language":null,"types":{"schemaOrg":"CreativeWork","resourceTypeGeneral":"Preprint","citeproc":"article","bibtex":"misc","ris":"GEN","resourceType":"Article"},"relatedIdentifiers":[],"relatedItems":[],"sizes":[],"formats":[],"version":"1","rightsList":[{"rightsIdentifierScheme":"SPDX","rightsUri":"https://creativecommons.org/licenses/by/4.0/legalcode","schemeUri":"https://spdx.org/licenses/","rights":"Creative Commons Attribution 4.0 International","rightsIdentifier":"cc-by-4.0"}],"descriptions":[{"descriptionType":"Abstract","description":"The Ring-Learning With Errors (RLWE) problem forms the backbone of highly efficient Fully Homomorphic Encryption (FHE) schemes. A significant component of the RLWE public key and ciphertext of the form $(b,a)$ is the uniformly random polynomial $a \\in R_q$ . While essential for security, the communication overhead of transmitting $a$ from client to server, and inputting it into a hardware accelerator, can be substantial, especially for FHE accelerators aiming at high acceleration factors. A known technique in reducing this overhead generates $a$ from a small seed on the client side via a deterministic process, transmits only the seed, and generates $a$ on-the-fly within the accelerator. Challenges in the hardware implementation of an accelerator include wiring (density and power), compute area, compute power as well as flexibility in scheduling of on-the-fly generation instructions. This extended abstract proposes a concrete scheme and parameters wherein these practical challenges are addressed. We detail the benefits of our approach, which maintains the reduction in communication latency and memory footprint, while allowing parallel generation of uniformly distributed samples, relaxed wiring requirements, unrestricted randomaccess to RNS limbs, and results in an extremely low overhead on the client side (i.e. less than 3%) during the key generation process. The proposed scheme eliminates the need for thick metal layers for randomness distribution and prevents the power consumption of the PRNG subsystem from scaling prohibitively with the acceleration factor, potentially saving tens of Watts per accelerator chip in high-throughput configurations."}],"geoLocations":[],"fundingReferences":[],"url":"https://arxiv.org/abs/2602.19550","contentUrl":null,"metadataVersion":0,"schemaVersion":"http://datacite.org/schema/kernel-4","source":"mds","isActive":true,"state":"findable","reason":null,"viewCount":0,"downloadCount":0,"referenceCount":0,"citationCount":0,"partCount":0,"partOfCount":0,"versionCount":0,"versionOfCount":0,"created":"2026-02-25T15:05:04Z","registered":"2026-02-25T15:05:05Z","published":null,"updated":"2026-02-25T15:05:05Z"},"relationships":{"client":{"data":{"id":"arxiv.content","type":"clients"}}}},{"id":"10.48550/arxiv.2602.19548","type":"dois","attributes":{"doi":"10.48550/arxiv.2602.19548","identifiers":[{"identifier":"2602.19548","identifierType":"arXiv"}],"creators":[{"nameType":"Personal","givenName":"Jeffrey","familyName":"Li","name":"Li, Jeffrey","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Josh","familyName":"Gardner","name":"Gardner, Josh","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Doug","familyName":"Kang","name":"Kang, Doug","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Fangping","familyName":"Shi","name":"Shi, Fangping","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Karanjeet","familyName":"Singh","name":"Singh, Karanjeet","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Chun-Liang","familyName":"Li","name":"Li, Chun-Liang","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Herumb","familyName":"Shandilya","name":"Shandilya, Herumb","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"David","familyName":"Hall","name":"Hall, David","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Oncel","familyName":"Tuzel","name":"Tuzel, Oncel","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Percy","familyName":"Liang","name":"Liang, Percy","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Ludwig","familyName":"Schmidt","name":"Schmidt, Ludwig","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Hadi Pour","familyName":"Ansari","name":"Ansari, Hadi Pour","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Fartash","familyName":"Faghri","name":"Faghri, Fartash","affiliation":[],"nameIdentifiers":[]}],"titles":[{"title":"Beyond a Single Extractor: Re-thinking HTML-to-Text Extraction for LLM Pretraining"}],"publisher":"arXiv","container":{},"publicationYear":2026,"subjects":[{"subject":"Computation and Language (cs.CL)","lang":"en","subjectScheme":"arXiv"},{"subject":"Machine Learning (cs.LG)","lang":"en","subjectScheme":"arXiv"},{"subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"},{"schemeUri":"http://www.oecd.org/science/inno/38235147.pdf","subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"}],"contributors":[],"dates":[{"date":"2026-02-23T06:41:57Z","dateType":"Submitted","dateInformation":"v1"},{"date":"2026-02-24T02:12:12Z","dateType":"Updated","dateInformation":"v1"},{"date":"2026-02","dateType":"Available","dateInformation":"v1"},{"date":"2026","dateType":"Issued"}],"language":null,"types":{"schemaOrg":"CreativeWork","resourceTypeGeneral":"Preprint","citeproc":"article","bibtex":"misc","ris":"GEN","resourceType":"Article"},"relatedIdentifiers":[],"relatedItems":[],"sizes":[],"formats":[],"version":"1","rightsList":[{"rightsUri":"http://arxiv.org/licenses/nonexclusive-distrib/1.0/","rights":"arXiv.org perpetual, non-exclusive license"}],"descriptions":[{"descriptionType":"Abstract","description":"One of the first pre-processing steps for constructing web-scale LLM pretraining datasets involves extracting text from HTML. Despite the immense diversity of web content, existing open-source datasets predominantly apply a single fixed extractor to all webpages. In this work, we investigate whether this practice leads to suboptimal coverage and utilization of Internet data. We first show that while different extractors may lead to similar model performance on standard language understanding tasks, the pages surviving a fixed filtering pipeline can differ substantially. This suggests a simple intervention: by taking a Union over different extractors, we can increase the token yield of DCLM-Baseline by up to 71% while maintaining benchmark performance. We further show that for structured content such as tables and code blocks, extractor choice can significantly impact downstream task performance, with differences of up to 10 percentage points (p.p.) on WikiTQ and 3 p.p. on HumanEval."}],"geoLocations":[],"fundingReferences":[],"url":"https://arxiv.org/abs/2602.19548","contentUrl":null,"metadataVersion":0,"schemaVersion":"http://datacite.org/schema/kernel-4","source":"mds","isActive":true,"state":"findable","reason":null,"viewCount":0,"downloadCount":0,"referenceCount":0,"citationCount":0,"partCount":0,"partOfCount":0,"versionCount":0,"versionOfCount":0,"created":"2026-02-25T15:04:59Z","registered":"2026-02-25T15:05:00Z","published":null,"updated":"2026-02-25T15:05:00Z"},"relationships":{"client":{"data":{"id":"arxiv.content","type":"clients"}}}},{"id":"10.48550/arxiv.2602.19547","type":"dois","attributes":{"doi":"10.48550/arxiv.2602.19547","identifiers":[{"identifier":"2602.19547","identifierType":"arXiv"}],"creators":[{"nameType":"Personal","givenName":"Lei","familyName":"Ba","name":"Ba, Lei","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Qinbin","familyName":"Li","name":"Li, Qinbin","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Songze","familyName":"Li","name":"Li, Songze","affiliation":[],"nameIdentifiers":[]}],"titles":[{"title":"CIBER: A Comprehensive Benchmark for Security Evaluation of Code Interpreter Agents"}],"publisher":"arXiv","container":{},"publicationYear":2026,"subjects":[{"subject":"Cryptography and Security (cs.CR)","lang":"en","subjectScheme":"arXiv"},{"subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"},{"schemeUri":"http://www.oecd.org/science/inno/38235147.pdf","subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"}],"contributors":[],"dates":[{"date":"2026-02-23T06:41:41Z","dateType":"Submitted","dateInformation":"v1"},{"date":"2026-02-24T02:12:10Z","dateType":"Updated","dateInformation":"v1"},{"date":"2026-02","dateType":"Available","dateInformation":"v1"},{"date":"2026","dateType":"Issued"}],"language":null,"types":{"schemaOrg":"CreativeWork","resourceTypeGeneral":"Preprint","citeproc":"article","bibtex":"misc","ris":"GEN","resourceType":"Article"},"relatedIdentifiers":[],"relatedItems":[],"sizes":[],"formats":[],"version":"1","rightsList":[{"rightsUri":"http://arxiv.org/licenses/nonexclusive-distrib/1.0/","rights":"arXiv.org perpetual, non-exclusive license"}],"descriptions":[{"descriptionType":"Abstract","description":"LLM-based code interpreter agents are increasingly deployed in critical workflows, yet their robustness against risks introduced by their code execution capabilities remains underexplored. Existing benchmarks are limited to static datasets or simulated environments, failing to capture the security risks arising from dynamic code execution, tool interactions, and multi-turn context. To bridge this gap, we introduce CIBER, an automated benchmark that combines dynamic attack generation, isolated secure sandboxing, and state-aware evaluation to systematically assess the vulnerability of code interpreter agents against four major types of adversarial attacks: Direct/Indirect Prompt Injection, Memory Poisoning, and Prompt-based Backdoor.\n We evaluate six foundation models across two representative code interpreter agents (OpenInterpreter and OpenCodeInterpreter), incorporating a controlled study of identical models. Our results reveal that Interpreter Architecture and Model Alignment Set the Security Baseline. Structural integration enables aligned specialized models to outperform generic SOTA models. Conversely, high intelligence paradoxically increases susceptibility to complex adversarial prompts due to stronger instruction adherence. Furthermore, we identify a \"Natural Language Disguise\" Phenomenon, where natural language functions as a significantly more effective input modality than explicit code snippets (+14.1% ASR), thereby bypassing syntax-based defenses. Finally, we expose an alarming Security Polarization, where agents exhibit robust defenses against explicit threats yet fail catastrophically against implicit semantic hazards, highlighting a fundamental blind spot in current pattern-matching protection approaches."}],"geoLocations":[],"fundingReferences":[],"url":"https://arxiv.org/abs/2602.19547","contentUrl":null,"metadataVersion":0,"schemaVersion":"http://datacite.org/schema/kernel-4","source":"mds","isActive":true,"state":"findable","reason":null,"viewCount":0,"downloadCount":0,"referenceCount":0,"citationCount":0,"partCount":0,"partOfCount":0,"versionCount":0,"versionOfCount":0,"created":"2026-02-25T15:04:57Z","registered":"2026-02-25T15:04:57Z","published":null,"updated":"2026-02-25T15:04:57Z"},"relationships":{"client":{"data":{"id":"arxiv.content","type":"clients"}}}},{"id":"10.48550/arxiv.2602.19545","type":"dois","attributes":{"doi":"10.48550/arxiv.2602.19545","identifiers":[{"identifier":"2602.19545","identifierType":"arXiv"}],"creators":[{"nameType":"Personal","givenName":"Seonwoo","familyName":"Kim","name":"Kim, Seonwoo","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Jungkyoung","familyName":"Lee","name":"Lee, Jungkyoung","affiliation":[],"nameIdentifiers":[]}],"titles":[{"title":"Sharp mixing time asymptotics of Glauber dynamics for the Curie-Weiss-Potts model at low temperatures"}],"publisher":"arXiv","container":{},"publicationYear":2026,"subjects":[{"subject":"Probability (math.PR)","lang":"en","subjectScheme":"arXiv"},{"subject":"Mathematical Physics (math-ph)","lang":"en","subjectScheme":"arXiv"},{"subject":"FOS: Mathematics","subjectScheme":"Fields of Science and Technology (FOS)"},{"schemeUri":"http://www.oecd.org/science/inno/38235147.pdf","subject":"FOS: Mathematics","subjectScheme":"Fields of Science and Technology (FOS)"},{"subject":"FOS: Physical sciences","subjectScheme":"Fields of Science and Technology (FOS)"},{"schemeUri":"http://www.oecd.org/science/inno/38235147.pdf","subject":"FOS: Physical sciences","subjectScheme":"Fields of Science and Technology (FOS)"},{"subject":"60J27 (Primary) 37A25, 82B26 (Secondary)","lang":"en","subjectScheme":"MSC"}],"contributors":[],"dates":[{"date":"2026-02-23T06:37:24Z","dateType":"Submitted","dateInformation":"v1"},{"date":"2026-02-24T02:12:03Z","dateType":"Updated","dateInformation":"v1"},{"date":"2026-02","dateType":"Available","dateInformation":"v1"},{"date":"2026","dateType":"Issued"}],"language":null,"types":{"schemaOrg":"CreativeWork","resourceTypeGeneral":"Preprint","citeproc":"article","bibtex":"misc","ris":"GEN","resourceType":"Article"},"relatedIdentifiers":[],"relatedItems":[],"sizes":[],"formats":[],"version":"1","rightsList":[{"rightsUri":"http://arxiv.org/licenses/nonexclusive-distrib/1.0/","rights":"arXiv.org perpetual, non-exclusive license"}],"descriptions":[{"descriptionType":"Abstract","description":"In this article, we derive a sharp mixing time estimate of the Glauber dynamics for the Curie-Weiss-Potts model in the low-temperature regime. In contrast to the high-temperature regime studied by Cuff et al. (J. Stat. Phys. 149: 432-477, 2012), in which the Gibbs measure is concentrated around the equiproportional distribution of spins, the Gibbs measure in the low-temperature regime is concentrated on multiple states, each with a dominant number of a single spin. Consequently, global mixing of the system requires sufficiently many transitions between these states. Since these transitions are well explained by the phenomenon of metastability, the theory of metastability plays a central role in the analysis of slow mixing. In particular, the sharp asymptotics for the mixing time is given by the mixing time of the limit Markov chain, which describes the metastable behavior of the dynamics, multiplied by the metastable transition time-scale. As a byproduct, we verify that it does not exhibit a cutoff phenomenon."},{"descriptionType":"Other","description":"43 pages, 4 figures"}],"geoLocations":[],"fundingReferences":[],"url":"https://arxiv.org/abs/2602.19545","contentUrl":null,"metadataVersion":0,"schemaVersion":"http://datacite.org/schema/kernel-4","source":"mds","isActive":true,"state":"findable","reason":null,"viewCount":0,"downloadCount":0,"referenceCount":0,"citationCount":0,"partCount":0,"partOfCount":0,"versionCount":0,"versionOfCount":0,"created":"2026-02-25T15:04:51Z","registered":"2026-02-25T15:04:52Z","published":null,"updated":"2026-02-25T15:04:52Z"},"relationships":{"client":{"data":{"id":"arxiv.content","type":"clients"}}}},{"id":"10.48550/arxiv.2602.19544","type":"dois","attributes":{"doi":"10.48550/arxiv.2602.19544","identifiers":[{"identifier":"2602.19544","identifierType":"arXiv"}],"creators":[{"nameType":"Personal","givenName":"Pavel","familyName":"Guerzhoy","name":"Guerzhoy, Pavel","affiliation":[],"nameIdentifiers":[]}],"titles":[{"title":"Congruences for traces of singular moduli and Hurwitz - Kronecker class numbers"}],"publisher":"arXiv","container":{},"publicationYear":2026,"subjects":[{"subject":"Number Theory (math.NT)","lang":"en","subjectScheme":"arXiv"},{"subject":"FOS: Mathematics","subjectScheme":"Fields of Science and Technology (FOS)"},{"schemeUri":"http://www.oecd.org/science/inno/38235147.pdf","subject":"FOS: Mathematics","subjectScheme":"Fields of Science and Technology (FOS)"}],"contributors":[],"dates":[{"date":"2026-02-23T06:32:25Z","dateType":"Submitted","dateInformation":"v1"},{"date":"2026-02-24T02:12:01Z","dateType":"Updated","dateInformation":"v1"},{"date":"2026-02","dateType":"Available","dateInformation":"v1"},{"date":"2026","dateType":"Issued"}],"language":null,"types":{"schemaOrg":"CreativeWork","resourceTypeGeneral":"Preprint","citeproc":"article","bibtex":"misc","ris":"GEN","resourceType":"Article"},"relatedIdentifiers":[],"relatedItems":[],"sizes":[],"formats":[],"version":"1","rightsList":[{"rightsIdentifierScheme":"SPDX","rightsUri":"https://creativecommons.org/licenses/by/4.0/legalcode","schemeUri":"https://spdx.org/licenses/","rights":"Creative Commons Attribution 4.0 International","rightsIdentifier":"cc-by-4.0"}],"descriptions":[{"descriptionType":"Abstract","description":"Traces of singular moduli were introduced and studied by Zagier in 1998. Being simultaneously the (traces of) values of a modular function ($j$-invariant) and Fourier coefficients of modular forms - which constitutes Zagier's duality - these integers are quite interesting. Since then, a substantial amount of research was devoted to various properties of these numbers, congruences in particular. We present an alternative point of view on these congruences, specifically, we view them as congruences between certain weight $3/2$ modular forms under repeated action of $U$-operator. That allows us to obtain a general result which includes some previously known results as special cases. Our approach is especially effective when the prime modulus is relatively small. In these cases, we obtain explanations for certain numerical observations and quantification of some previously known qualitative results. As an application, we obtain modulo $11$ congruences between the traces of singular moduli and class numbers of quadratic fields in the case when the twisted central special value of the $L$-function associated with the elliptic curve of conductor $11$ vanishes."}],"geoLocations":[],"fundingReferences":[],"url":"https://arxiv.org/abs/2602.19544","contentUrl":null,"metadataVersion":0,"schemaVersion":"http://datacite.org/schema/kernel-4","source":"mds","isActive":true,"state":"findable","reason":null,"viewCount":0,"downloadCount":0,"referenceCount":0,"citationCount":0,"partCount":0,"partOfCount":0,"versionCount":0,"versionOfCount":0,"created":"2026-02-25T15:04:49Z","registered":"2026-02-25T15:04:50Z","published":null,"updated":"2026-02-25T15:04:50Z"},"relationships":{"client":{"data":{"id":"arxiv.content","type":"clients"}}}},{"id":"10.48550/arxiv.2602.19542","type":"dois","attributes":{"doi":"10.48550/arxiv.2602.19542","identifiers":[{"identifier":"2602.19542","identifierType":"arXiv"}],"creators":[{"nameType":"Personal","givenName":"Yankuan","familyName":"Chi","name":"Chi, Yankuan","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Xiang","familyName":"Li","name":"Li, Xiang","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Zixuan","familyName":"Huang","name":"Huang, Zixuan","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"James M.","familyName":"Rehg","name":"Rehg, James M.","affiliation":[],"nameIdentifiers":[]}],"titles":[{"title":"Vinedresser3D: Agentic Text-guided 3D Editing"}],"publisher":"arXiv","container":{},"publicationYear":2026,"subjects":[{"subject":"Computer Vision and Pattern Recognition (cs.CV)","lang":"en","subjectScheme":"arXiv"},{"subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"},{"schemeUri":"http://www.oecd.org/science/inno/38235147.pdf","subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"}],"contributors":[],"dates":[{"date":"2026-02-23T06:30:36Z","dateType":"Submitted","dateInformation":"v1"},{"date":"2026-02-24T02:11:59Z","dateType":"Updated","dateInformation":"v1"},{"date":"2026-02","dateType":"Available","dateInformation":"v1"},{"date":"2026","dateType":"Issued"}],"language":null,"types":{"schemaOrg":"CreativeWork","resourceTypeGeneral":"Preprint","citeproc":"article","bibtex":"misc","ris":"GEN","resourceType":"Article"},"relatedIdentifiers":[],"relatedItems":[],"sizes":[],"formats":[],"version":"1","rightsList":[{"rightsIdentifierScheme":"SPDX","rightsUri":"https://creativecommons.org/licenses/by/4.0/legalcode","schemeUri":"https://spdx.org/licenses/","rights":"Creative Commons Attribution 4.0 International","rightsIdentifier":"cc-by-4.0"}],"descriptions":[{"descriptionType":"Abstract","description":"Text-guided 3D editing aims to modify existing 3D assets using natural-language instructions. Current methods struggle to jointly understand complex prompts, automatically localize edits in 3D, and preserve unedited content. We introduce Vinedresser3D, an agentic framework for high-quality text-guided 3D editing that operates directly in the latent space of a native 3D generative model. Given a 3D asset and an editing prompt, Vinedresser3D uses a multimodal large language model to infer rich descriptions of the original asset, identify the edit region and edit type (addition, modification, deletion), and generate decomposed structural and appearance-level text guidance. The agent then selects an informative view and applies an image editing model to obtain visual guidance. Finally, an inversion-based rectified-flow inpainting pipeline with an interleaved sampling module performs editing in the 3D latent space, enforcing prompt alignment while maintaining 3D coherence and unedited regions. Experiments on diverse 3D edits demonstrate that Vinedresser3D outperforms prior baselines in both automatic metrics and human preference studies, while enabling precise, coherent, and mask-free 3D editing."},{"descriptionType":"Other","description":"CVPR 2026, Project website:https://vinedresser3d.github.io/"}],"geoLocations":[],"fundingReferences":[],"url":"https://arxiv.org/abs/2602.19542","contentUrl":null,"metadataVersion":0,"schemaVersion":"http://datacite.org/schema/kernel-4","source":"mds","isActive":true,"state":"findable","reason":null,"viewCount":0,"downloadCount":0,"referenceCount":0,"citationCount":0,"partCount":0,"partOfCount":0,"versionCount":0,"versionOfCount":0,"created":"2026-02-25T15:04:44Z","registered":"2026-02-25T15:04:45Z","published":null,"updated":"2026-02-25T15:04:45Z"},"relationships":{"client":{"data":{"id":"arxiv.content","type":"clients"}}}},{"id":"10.48550/arxiv.2602.19540","type":"dois","attributes":{"doi":"10.48550/arxiv.2602.19540","identifiers":[{"identifier":"2602.19540","identifierType":"arXiv"}],"creators":[{"nameType":"Personal","givenName":"Wei","familyName":"Wang","name":"Wang, Wei","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Yixing","familyName":"Wu","name":"Wu, Yixing","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"C. -C. Jay","familyName":"Kuo","name":"Kuo, C. -C. Jay","affiliation":[],"nameIdentifiers":[]}],"titles":[{"title":"A Green Learning Approach to LDCT Image Restoration"}],"publisher":"arXiv","container":{},"publicationYear":2026,"subjects":[{"subject":"Computer Vision and Pattern Recognition (cs.CV)","lang":"en","subjectScheme":"arXiv"},{"subject":"Artificial Intelligence (cs.AI)","lang":"en","subjectScheme":"arXiv"},{"subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"},{"schemeUri":"http://www.oecd.org/science/inno/38235147.pdf","subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"}],"contributors":[],"dates":[{"date":"2026-02-23T06:21:56Z","dateType":"Submitted","dateInformation":"v1"},{"date":"2026-02-24T02:11:40Z","dateType":"Updated","dateInformation":"v1"},{"date":"2026-02","dateType":"Available","dateInformation":"v1"},{"date":"2026","dateType":"Issued"}],"language":null,"types":{"schemaOrg":"CreativeWork","resourceTypeGeneral":"Preprint","citeproc":"article","bibtex":"misc","ris":"GEN","resourceType":"Article"},"relatedIdentifiers":[{"relationType":"IsVersionOf","relatedIdentifier":"10.1109/icip55913.2025.11084379","relatedIdentifierType":"DOI"}],"relatedItems":[],"sizes":[],"formats":[],"version":"1","rightsList":[{"rightsUri":"http://arxiv.org/licenses/nonexclusive-distrib/1.0/","rights":"arXiv.org perpetual, non-exclusive license"}],"descriptions":[{"descriptionType":"Abstract","description":"This work proposes a green learning (GL) approach to restore medical images. Without loss of generality, we use low-dose computed tomography (LDCT) images as examples. LDCT images are susceptible to noise and artifacts, where the imaging process introduces distortion. LDCT image restoration is an important preprocessing step for further medical analysis. Deep learning (DL) methods have been developed to solve this problem. We examine an alternative solution using the Green Learning (GL) methodology. The new restoration method is characterized by mathematical transparency, computational and memory efficiency, and high performance. Experiments show that our GL method offers state-of-the-art restoration performance at a smaller model size and with lower inference complexity."},{"descriptionType":"Other","description":"Published in IEEE International Conference on Image Processing (ICIP), 2025, pp. 1762-1767. Final version available at IEEE Xplore"}],"geoLocations":[],"fundingReferences":[],"url":"https://arxiv.org/abs/2602.19540","contentUrl":null,"metadataVersion":0,"schemaVersion":"http://datacite.org/schema/kernel-4","source":"mds","isActive":true,"state":"findable","reason":null,"viewCount":0,"downloadCount":0,"referenceCount":0,"citationCount":0,"partCount":0,"partOfCount":0,"versionCount":0,"versionOfCount":1,"created":"2026-02-25T15:04:39Z","registered":"2026-02-25T15:04:40Z","published":null,"updated":"2026-02-25T15:04:40Z"},"relationships":{"client":{"data":{"id":"arxiv.content","type":"clients"}}}},{"id":"10.48550/arxiv.2602.19539","type":"dois","attributes":{"doi":"10.48550/arxiv.2602.19539","identifiers":[{"identifier":"2602.19539","identifierType":"arXiv"}],"creators":[{"nameType":"Personal","givenName":"Xingyu","familyName":"Shen","name":"Shen, Xingyu","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Tommy","familyName":"Duong","name":"Duong, Tommy","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Xiaodong","familyName":"An","name":"An, Xiaodong","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Zengqi","familyName":"Zhao","name":"Zhao, Zengqi","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Zebang","familyName":"Hu","name":"Hu, Zebang","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Haoyu","familyName":"Hu","name":"Hu, Haoyu","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Ziyou","familyName":"Wang","name":"Wang, Ziyou","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Finn","familyName":"Guo","name":"Guo, Finn","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Simiao","familyName":"Ren","name":"Ren, Simiao","affiliation":[],"nameIdentifiers":[]}],"titles":[{"title":"Can a Teenager Fool an AI? Evaluating Low-Cost Cosmetic Attacks on Age Estimation Systems"}],"publisher":"arXiv","container":{},"publicationYear":2026,"subjects":[{"subject":"Computer Vision and Pattern Recognition (cs.CV)","lang":"en","subjectScheme":"arXiv"},{"subject":"Cryptography and Security (cs.CR)","lang":"en","subjectScheme":"arXiv"},{"subject":"Machine Learning (cs.LG)","lang":"en","subjectScheme":"arXiv"},{"subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"},{"schemeUri":"http://www.oecd.org/science/inno/38235147.pdf","subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"}],"contributors":[],"dates":[{"date":"2026-02-23T06:13:52Z","dateType":"Submitted","dateInformation":"v1"},{"date":"2026-02-24T02:11:28Z","dateType":"Updated","dateInformation":"v1"},{"date":"2026-02","dateType":"Available","dateInformation":"v1"},{"date":"2026","dateType":"Issued"}],"language":null,"types":{"schemaOrg":"CreativeWork","resourceTypeGeneral":"Preprint","citeproc":"article","bibtex":"misc","ris":"GEN","resourceType":"Article"},"relatedIdentifiers":[],"relatedItems":[],"sizes":[],"formats":[],"version":"1","rightsList":[{"rightsIdentifierScheme":"SPDX","rightsUri":"https://creativecommons.org/licenses/by-nc-sa/4.0/legalcode","schemeUri":"https://spdx.org/licenses/","rights":"Creative Commons Attribution Non Commercial Share Alike 4.0 International","rightsIdentifier":"cc-by-nc-sa-4.0"}],"descriptions":[{"descriptionType":"Abstract","description":"Age estimation systems are increasingly deployed as gatekeepers for age-restricted online content, yet their robustness to cosmetic modifications has not been systematically evaluated. We investigate whether simple, household-accessible cosmetic changes, including beards, grey hair, makeup, and simulated wrinkles, can cause AI age estimators to classify minors as adults. To study this threat at scale without ethical concerns, we simulate these physical attacks on 329 facial images of individuals aged 10 to 21 using a VLM image editor (Gemini 2.5 Flash Image). We then evaluate eight models from our prior benchmark: five specialized architectures (MiVOLO, Custom-Best, Herosan, MiViaLab, DEX) and three vision-language models (Gemini 3 Flash, Gemini 2.5 Flash, GPT-5-Nano). We introduce the Attack Conversion Rate (ACR), defined as the fraction of images predicted as minor at baseline that flip to adult after attack, a population-agnostic metric that does not depend on the ratio of minors to adults in the test set. Our results reveal that a synthetic beard alone achieves 28 to 69 percent ACR across all eight models; combining all four attacks shifts predicted age by +7.7 years on average across all 329 subjects and reaches up to 83 percent ACR; and vision-language models exhibit lower ACR (59 to 71 percent) than specialized models (63 to 83 percent) under the full attack, although the ACR ranges overlap and the difference is not statistically tested. These findings highlight a critical vulnerability in deployed age-verification pipelines and call for adversarial robustness evaluation as a mandatory criterion for model selection."},{"descriptionType":"Other","description":"13 pages, 6 figures"}],"geoLocations":[],"fundingReferences":[],"url":"https://arxiv.org/abs/2602.19539","contentUrl":null,"metadataVersion":0,"schemaVersion":"http://datacite.org/schema/kernel-4","source":"mds","isActive":true,"state":"findable","reason":null,"viewCount":0,"downloadCount":0,"referenceCount":0,"citationCount":0,"partCount":0,"partOfCount":0,"versionCount":0,"versionOfCount":0,"created":"2026-02-25T15:04:37Z","registered":"2026-02-25T15:04:38Z","published":null,"updated":"2026-02-25T15:04:38Z"},"relationships":{"client":{"data":{"id":"arxiv.content","type":"clients"}}}},{"id":"10.48550/arxiv.2602.19538","type":"dois","attributes":{"doi":"10.48550/arxiv.2602.19538","identifiers":[{"identifier":"2602.19538","identifierType":"arXiv"}],"creators":[{"nameType":"Personal","givenName":"Arundhati","familyName":"Banerjee","name":"Banerjee, Arundhati","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Jeff","familyName":"Schneider","name":"Schneider, Jeff","affiliation":[],"nameIdentifiers":[]}],"titles":[{"title":"Cost-Aware Diffusion Active Search"}],"publisher":"arXiv","container":{},"publicationYear":2026,"subjects":[{"subject":"Robotics (cs.RO)","lang":"en","subjectScheme":"arXiv"},{"subject":"Artificial Intelligence (cs.AI)","lang":"en","subjectScheme":"arXiv"},{"subject":"Machine Learning (cs.LG)","lang":"en","subjectScheme":"arXiv"},{"subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"},{"schemeUri":"http://www.oecd.org/science/inno/38235147.pdf","subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"},{"subject":"I.2.9; I.2.11; I.2.6","lang":"en","subjectScheme":"ACM"}],"contributors":[],"dates":[{"date":"2026-02-23T06:11:51Z","dateType":"Submitted","dateInformation":"v1"},{"date":"2026-02-24T02:11:27Z","dateType":"Updated","dateInformation":"v1"},{"date":"2026-02","dateType":"Available","dateInformation":"v1"},{"date":"2026","dateType":"Issued"}],"language":null,"types":{"schemaOrg":"CreativeWork","resourceTypeGeneral":"Preprint","citeproc":"article","bibtex":"misc","ris":"GEN","resourceType":"Article"},"relatedIdentifiers":[],"relatedItems":[],"sizes":[],"formats":[],"version":"1","rightsList":[{"rightsUri":"http://arxiv.org/licenses/nonexclusive-distrib/1.0/","rights":"arXiv.org perpetual, non-exclusive license"}],"descriptions":[{"descriptionType":"Abstract","description":"Active search for recovering objects of interest through online, adaptive decision making with autonomous agents requires trading off exploration of unknown environments with exploitation of prior observations in the search space. Prior work has proposed information gain and Thompson sampling based myopic, greedy approaches for agents to actively decide query or search locations when the number of targets is unknown. Decision making algorithms in such partially observable environments have also shown that agents capable of lookahead over a finite horizon outperform myopic policies for active search. Unfortunately, lookahead algorithms typically rely on building a computationally expensive search tree that is simulated and updated based on the agent's observations and a model of the environment dynamics. Instead, in this work, we leverage the sequence modeling abilities of diffusion models to sample lookahead action sequences that balance the exploration-exploitation trade-off for active search without building an exhaustive search tree. We identify the optimism bias in prior diffusion based reinforcement learning approaches when applied to the active search setting and propose mitigating solutions for efficient cost-aware decision making with both single and multi-agent teams. Our proposed algorithm outperforms standard baselines in offline reinforcement learning in terms of full recovery rate and is computationally more efficient than tree search in cost-aware active decision making."},{"descriptionType":"Other","description":"In submission"}],"geoLocations":[],"fundingReferences":[],"url":"https://arxiv.org/abs/2602.19538","contentUrl":null,"metadataVersion":0,"schemaVersion":"http://datacite.org/schema/kernel-4","source":"mds","isActive":true,"state":"findable","reason":null,"viewCount":0,"downloadCount":0,"referenceCount":0,"citationCount":0,"partCount":0,"partOfCount":0,"versionCount":0,"versionOfCount":0,"created":"2026-02-25T15:04:34Z","registered":"2026-02-25T15:04:35Z","published":null,"updated":"2026-02-25T15:04:35Z"},"relationships":{"client":{"data":{"id":"arxiv.content","type":"clients"}}}},{"id":"10.48550/arxiv.2602.19536","type":"dois","attributes":{"doi":"10.48550/arxiv.2602.19536","identifiers":[{"identifier":"2602.19536","identifierType":"arXiv"}],"creators":[{"nameType":"Personal","givenName":"Zhiwei","familyName":"Ning","name":"Ning, Zhiwei","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Xuanang","familyName":"Gao","name":"Gao, Xuanang","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Jiaxi","familyName":"Cao","name":"Cao, Jiaxi","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Runze","familyName":"Yang","name":"Yang, Runze","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Huiying","familyName":"Xu","name":"Xu, Huiying","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Xinzhong","familyName":"Zhu","name":"Zhu, Xinzhong","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Jie","familyName":"Yang","name":"Yang, Jie","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Wei","familyName":"Liu","name":"Liu, Wei","affiliation":[],"nameIdentifiers":[]}],"titles":[{"title":"Fore-Mamba3D: Mamba-based Foreground-Enhanced Encoding for 3D Object Detection"}],"publisher":"arXiv","container":{},"publicationYear":2026,"subjects":[{"subject":"Computer Vision and Pattern Recognition (cs.CV)","lang":"en","subjectScheme":"arXiv"},{"subject":"Artificial Intelligence (cs.AI)","lang":"en","subjectScheme":"arXiv"},{"subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"},{"schemeUri":"http://www.oecd.org/science/inno/38235147.pdf","subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"}],"contributors":[],"dates":[{"date":"2026-02-23T06:03:07Z","dateType":"Submitted","dateInformation":"v1"},{"date":"2026-02-24T02:11:21Z","dateType":"Updated","dateInformation":"v1"},{"date":"2026-02","dateType":"Available","dateInformation":"v1"},{"date":"2026","dateType":"Issued"}],"language":null,"types":{"schemaOrg":"CreativeWork","resourceTypeGeneral":"Preprint","citeproc":"article","bibtex":"misc","ris":"GEN","resourceType":"Article"},"relatedIdentifiers":[],"relatedItems":[],"sizes":[],"formats":[],"version":"1","rightsList":[{"rightsIdentifierScheme":"SPDX","rightsUri":"https://creativecommons.org/licenses/by-nc-sa/4.0/legalcode","schemeUri":"https://spdx.org/licenses/","rights":"Creative Commons Attribution Non Commercial Share Alike 4.0 International","rightsIdentifier":"cc-by-nc-sa-4.0"}],"descriptions":[{"descriptionType":"Abstract","description":"Linear modeling methods like Mamba have been merged as the effective backbone for the 3D object detection task. However, previous Mamba-based methods utilize the bidirectional encoding for the whole non-empty voxel sequence, which contains abundant useless background information in the scenes. Though directly encoding foreground voxels appears to be a plausible solution, it tends to degrade detection performance. We attribute this to the response attenuation and restricted context representation in the linear modeling for fore-only sequences. To address this problem, we propose a novel backbone, termed Fore-Mamba3D, to focus on the foreground enhancement by modifying Mamba-based encoder. The foreground voxels are first sampled according to the predicted scores. Considering the response attenuation existing in the interaction of foreground voxels across different instances, we design a regional-to-global slide window (RGSW) to propagate the information from regional split to the entire sequence. Furthermore, a semantic-assisted and state spatial fusion module (SASFMamba) is proposed to enrich contextual representation by enhancing semantic and geometric awareness within the Mamba model. Our method emphasizes foreground-only encoding and alleviates the distance-based and causal dependencies in the linear autoregression model. The superior performance across various benchmarks demonstrates the effectiveness of Fore-Mamba3D in the 3D object detection task."}],"geoLocations":[],"fundingReferences":[],"url":"https://arxiv.org/abs/2602.19536","contentUrl":null,"metadataVersion":0,"schemaVersion":"http://datacite.org/schema/kernel-4","source":"mds","isActive":true,"state":"findable","reason":null,"viewCount":0,"downloadCount":0,"referenceCount":0,"citationCount":0,"partCount":0,"partOfCount":0,"versionCount":0,"versionOfCount":0,"created":"2026-02-25T15:04:30Z","registered":"2026-02-25T15:04:30Z","published":null,"updated":"2026-02-25T15:04:30Z"},"relationships":{"client":{"data":{"id":"arxiv.content","type":"clients"}}}},{"id":"10.48550/arxiv.2602.19528","type":"dois","attributes":{"doi":"10.48550/arxiv.2602.19528","identifiers":[{"identifier":"2602.19528","identifierType":"arXiv"}],"creators":[{"nameType":"Personal","givenName":"Ibne Farabi","familyName":"Shihab","name":"Shihab, Ibne Farabi","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Sanjeda","familyName":"Akter","name":"Akter, Sanjeda","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Anuj","familyName":"Sharma","name":"Sharma, Anuj","affiliation":[],"nameIdentifiers":[]}],"titles":[{"title":"Beyond Accuracy: A Unified Random Matrix Theory Diagnostic Framework for Crash Classification Models"}],"publisher":"arXiv","container":{},"publicationYear":2026,"subjects":[{"subject":"Machine Learning (cs.LG)","lang":"en","subjectScheme":"arXiv"},{"subject":"Machine Learning (stat.ML)","lang":"en","subjectScheme":"arXiv"},{"subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"},{"schemeUri":"http://www.oecd.org/science/inno/38235147.pdf","subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"}],"contributors":[],"dates":[{"date":"2026-02-23T05:42:54Z","dateType":"Submitted","dateInformation":"v1"},{"date":"2026-02-24T02:11:02Z","dateType":"Updated","dateInformation":"v1"},{"date":"2026-02","dateType":"Available","dateInformation":"v1"},{"date":"2026","dateType":"Issued"}],"language":null,"types":{"schemaOrg":"CreativeWork","resourceTypeGeneral":"Preprint","citeproc":"article","bibtex":"misc","ris":"GEN","resourceType":"Article"},"relatedIdentifiers":[],"relatedItems":[],"sizes":[],"formats":[],"version":"1","rightsList":[{"rightsUri":"http://arxiv.org/licenses/nonexclusive-distrib/1.0/","rights":"arXiv.org perpetual, non-exclusive license"}],"descriptions":[{"descriptionType":"Abstract","description":"Crash classification models in transportation safety are typically evaluated using accuracy, F1, or AUC, metrics that cannot reveal whether a model is silently overfitting. We introduce a spectral diagnostic framework grounded in Random Matrix Theory (RMT) and Heavy-Tailed Self-Regularization (HTSR) that spans the ML taxonomy: weight matrices for BERT/ALBERT/Qwen2.5, out-of-fold increment matrices for XGBoost/Random Forest, empirical Hessians for Logistic Regression, induced affinity matrices for Decision Trees, and Graph Laplacians for KNN. Evaluating nine model families on two Iowa DOT crash classification tasks (173,512 and 371,062 records respectively), we find that the power-law exponent $α$ provides a structural quality signal: well-regularized models consistently yield $α$ within $[2, 4]$ (mean $2.87 \\pm 0.34$), while overfit variants show $α\u0026lt; 2$ or spectral collapse. We observe a strong rank correlation between $α$ and expert agreement (Spearman $ρ= 0.89$, $p \u0026lt; 0.001$), suggesting spectral quality captures model behaviors aligned with expert reasoning. We propose an $α$-based early stopping criterion and a spectral model selection protocol, and validate both against cross-validated F1 baselines. Sparse Lanczos approximations make the framework scalable to large datasets."}],"geoLocations":[],"fundingReferences":[],"url":"https://arxiv.org/abs/2602.19528","contentUrl":null,"metadataVersion":0,"schemaVersion":"http://datacite.org/schema/kernel-4","source":"mds","isActive":true,"state":"findable","reason":null,"viewCount":0,"downloadCount":0,"referenceCount":0,"citationCount":0,"partCount":0,"partOfCount":0,"versionCount":0,"versionOfCount":0,"created":"2026-02-25T15:04:10Z","registered":"2026-02-25T15:04:11Z","published":null,"updated":"2026-02-25T15:04:11Z"},"relationships":{"client":{"data":{"id":"arxiv.content","type":"clients"}}}},{"id":"10.48550/arxiv.2602.19527","type":"dois","attributes":{"doi":"10.48550/arxiv.2602.19527","identifiers":[{"identifier":"2602.19527","identifierType":"arXiv"}],"creators":[{"nameType":"Personal","givenName":"M.","familyName":"Leconte","name":"Leconte, M.","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"T. S.","familyName":"Hahm","name":"Hahm, T. S.","affiliation":[],"nameIdentifiers":[]}],"titles":[{"title":"Friction-induced scale-selection in the extended Cahn-Hilliard model for zonal staircase"}],"publisher":"arXiv","container":{},"publicationYear":2026,"subjects":[{"subject":"Plasma Physics (physics.plasm-ph)","lang":"en","subjectScheme":"arXiv"},{"subject":"FOS: Physical sciences","subjectScheme":"Fields of Science and Technology (FOS)"},{"schemeUri":"http://www.oecd.org/science/inno/38235147.pdf","subject":"FOS: Physical sciences","subjectScheme":"Fields of Science and Technology (FOS)"}],"contributors":[],"dates":[{"date":"2026-02-23T05:35:42Z","dateType":"Submitted","dateInformation":"v1"},{"date":"2026-02-24T02:11:01Z","dateType":"Updated","dateInformation":"v1"},{"date":"2026-02","dateType":"Available","dateInformation":"v1"},{"date":"2026","dateType":"Issued"}],"language":null,"types":{"schemaOrg":"CreativeWork","resourceTypeGeneral":"Preprint","citeproc":"article","bibtex":"misc","ris":"GEN","resourceType":"Article"},"relatedIdentifiers":[{"relationType":"IsVersionOf","relatedIdentifier":"10.1103/n1wb-jnzd","relatedIdentifierType":"DOI"}],"relatedItems":[],"sizes":[],"formats":[],"version":"1","rightsList":[{"rightsIdentifierScheme":"SPDX","rightsUri":"https://creativecommons.org/licenses/by-nc-sa/4.0/legalcode","schemeUri":"https://spdx.org/licenses/","rights":"Creative Commons Attribution Non Commercial Share Alike 4.0 International","rightsIdentifier":"cc-by-nc-sa-4.0"}],"descriptions":[{"descriptionType":"Abstract","description":"In this work, we describe a possible mechanism to set the radial scale of zonal flows, which may be applicable to the $E \\times B$ staircase found in the global full-f simulations such as [G. Dif-Pradalier et al. Phys. Rev. Lett. 114, 085004 (2015)]. 1D numerical simulation results of the Cahn-Hilliard model - extended to include zonal flow friction - can be understood from a heuristic nonlinear analysis. The staircase step-size $Δ$ is found to decrease as the dimensionless zonal flow friction $μ$ increases. It scales like $Δ\\sim \\log μ^α$, with $α\\simeq -0.41$, up to a constant offset."},{"descriptionType":"Other","description":"4 figures"}],"geoLocations":[],"fundingReferences":[],"url":"https://arxiv.org/abs/2602.19527","contentUrl":null,"metadataVersion":0,"schemaVersion":"http://datacite.org/schema/kernel-4","source":"mds","isActive":true,"state":"findable","reason":null,"viewCount":0,"downloadCount":0,"referenceCount":0,"citationCount":0,"partCount":0,"partOfCount":0,"versionCount":0,"versionOfCount":1,"created":"2026-02-25T15:04:08Z","registered":"2026-02-25T15:04:08Z","published":null,"updated":"2026-02-25T15:04:08Z"},"relationships":{"client":{"data":{"id":"arxiv.content","type":"clients"}}}},{"id":"10.48550/arxiv.2602.19526","type":"dois","attributes":{"doi":"10.48550/arxiv.2602.19526","identifiers":[{"identifier":"2602.19526","identifierType":"arXiv"}],"creators":[{"nameType":"Personal","givenName":"Yinuo","familyName":"Xu","name":"Xu, Yinuo","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Shuo","familyName":"Lu","name":"Lu, Shuo","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Jianjie","familyName":"Cheng","name":"Cheng, Jianjie","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Meng","familyName":"Wang","name":"Wang, Meng","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Qianlong","familyName":"Xie","name":"Xie, Qianlong","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Xingxing","familyName":"Wang","name":"Wang, Xingxing","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Ran","familyName":"He","name":"He, Ran","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Jian","familyName":"Liang","name":"Liang, Jian","affiliation":[],"nameIdentifiers":[]}],"titles":[{"title":"How to Train Your Deep Research Agent? Prompt, Reward, and Policy Optimization in Search-R1"}],"publisher":"arXiv","container":{},"publicationYear":2026,"subjects":[{"subject":"Computation and Language (cs.CL)","lang":"en","subjectScheme":"arXiv"},{"subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"},{"schemeUri":"http://www.oecd.org/science/inno/38235147.pdf","subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"}],"contributors":[],"dates":[{"date":"2026-02-23T05:33:17Z","dateType":"Submitted","dateInformation":"v1"},{"date":"2026-02-24T02:10:54Z","dateType":"Updated","dateInformation":"v1"},{"date":"2026-02","dateType":"Available","dateInformation":"v1"},{"date":"2026","dateType":"Issued"}],"language":null,"types":{"schemaOrg":"CreativeWork","resourceTypeGeneral":"Preprint","citeproc":"article","bibtex":"misc","ris":"GEN","resourceType":"Article"},"relatedIdentifiers":[],"relatedItems":[],"sizes":[],"formats":[],"version":"1","rightsList":[{"rightsIdentifierScheme":"SPDX","rightsUri":"https://creativecommons.org/licenses/by/4.0/legalcode","schemeUri":"https://spdx.org/licenses/","rights":"Creative Commons Attribution 4.0 International","rightsIdentifier":"cc-by-4.0"}],"descriptions":[{"descriptionType":"Abstract","description":"Deep Research agents tackle knowledge-intensive tasks through multi-round retrieval and decision-oriented generation. While reinforcement learning (RL) has been shown to improve performance in this paradigm, its contributions remain underexplored. To fully understand the role of RL, we conduct a systematic study along three decoupled dimensions: prompt template, reward function, and policy optimization. Our study reveals that: 1) the Fast Thinking template yields greater stability and better performance than the Slow Thinking template used in prior work; 2) the F1-based reward underperforms the EM due to training collapse driven by answer avoidance; this can be mitigated by incorporating action-level penalties, ultimately surpassing EM; 3) REINFORCE outperforms PPO while requiring fewer search actions, whereas GRPO shows the poorest stability among policy optimization methods. Building on these insights, we then introduce Search-R1++, a strong baseline that improves the performance of Search-R1 from 0.403 to 0.442 (Qwen2.5-7B) and 0.289 to 0.331 (Qwen2.5-3B). We hope that our findings can pave the way for more principled and reliable RL training strategies in Deep Research systems."}],"geoLocations":[],"fundingReferences":[],"url":"https://arxiv.org/abs/2602.19526","contentUrl":null,"metadataVersion":0,"schemaVersion":"http://datacite.org/schema/kernel-4","source":"mds","isActive":true,"state":"findable","reason":null,"viewCount":0,"downloadCount":0,"referenceCount":0,"citationCount":0,"partCount":0,"partOfCount":0,"versionCount":0,"versionOfCount":0,"created":"2026-02-25T15:04:05Z","registered":"2026-02-25T15:04:06Z","published":null,"updated":"2026-02-25T15:04:06Z"},"relationships":{"client":{"data":{"id":"arxiv.content","type":"clients"}}}},{"id":"10.48550/arxiv.2602.19525","type":"dois","attributes":{"doi":"10.48550/arxiv.2602.19525","identifiers":[{"identifier":"2602.19525","identifierType":"arXiv"}],"creators":[{"nameType":"Personal","givenName":"Keigo","familyName":"Oka","name":"Oka, Keigo","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Naoki","familyName":"Inaba","name":"Inaba, Naoki","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Akira","familyName":"Iino","name":"Iino, Akira","affiliation":[],"nameIdentifiers":[]}],"titles":[{"title":"Covering a Polyomino-Shaped Stain with Non-Overlapping Identical Stickers"}],"publisher":"arXiv","container":{},"publicationYear":2026,"subjects":[{"subject":"Data Structures and Algorithms (cs.DS)","lang":"en","subjectScheme":"arXiv"},{"subject":"Computational Complexity (cs.CC)","lang":"en","subjectScheme":"arXiv"},{"subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"},{"schemeUri":"http://www.oecd.org/science/inno/38235147.pdf","subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"}],"contributors":[],"dates":[{"date":"2026-02-23T05:28:34Z","dateType":"Submitted","dateInformation":"v1"},{"date":"2026-02-24T02:10:52Z","dateType":"Updated","dateInformation":"v1"},{"date":"2026-02","dateType":"Available","dateInformation":"v1"},{"date":"2026","dateType":"Issued"}],"language":null,"types":{"schemaOrg":"CreativeWork","resourceTypeGeneral":"Preprint","citeproc":"article","bibtex":"misc","ris":"GEN","resourceType":"Article"},"relatedIdentifiers":[],"relatedItems":[],"sizes":[],"formats":[],"version":"1","rightsList":[{"rightsIdentifierScheme":"SPDX","rightsUri":"https://creativecommons.org/licenses/by/4.0/legalcode","schemeUri":"https://spdx.org/licenses/","rights":"Creative Commons Attribution 4.0 International","rightsIdentifier":"cc-by-4.0"}],"descriptions":[{"descriptionType":"Abstract","description":"You find a stain on the wall and decide to cover it with non-overlapping stickers of a single identical shape (rotation and reflection are allowed). Is it possible to find a sticker shape that fails to cover the stain? In this paper, we consider this problem under polyomino constraints and complete the classification of always-coverable stain shapes (polyominoes). We provide proofs for the maximal always-coverable polyominoes and construct concrete counterexamples for the minimal not always-coverable ones, demonstrating that such cases exist even among hole-free polyominoes. This classification consequently yields an algorithm to determine the always-coverability of any given stain. We also show that the problem of determining whether a given sticker can cover a given stain is $\\NP$-complete, even though exact cover is not demanded. This result extends to the 1D case where the connectivity requirement is removed. As an illustration of the problem complexity, for a specific hexomino (6-cell) stain, the smallest sticker found in our search that avoids covering it has, although not proven minimum, a bounding box of $325 \\times 325$."}],"geoLocations":[],"fundingReferences":[],"url":"https://arxiv.org/abs/2602.19525","contentUrl":null,"metadataVersion":0,"schemaVersion":"http://datacite.org/schema/kernel-4","source":"mds","isActive":true,"state":"findable","reason":null,"viewCount":0,"downloadCount":0,"referenceCount":0,"citationCount":0,"partCount":0,"partOfCount":0,"versionCount":0,"versionOfCount":0,"created":"2026-02-25T15:04:03Z","registered":"2026-02-25T15:04:04Z","published":null,"updated":"2026-02-25T15:04:04Z"},"relationships":{"client":{"data":{"id":"arxiv.content","type":"clients"}}}},{"id":"10.48550/arxiv.2602.19524","type":"dois","attributes":{"doi":"10.48550/arxiv.2602.19524","identifiers":[{"identifier":"2602.19524","identifierType":"arXiv"}],"creators":[{"nameType":"Personal","givenName":"Lang","familyName":"Cui","name":"Cui, Lang","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Krishna Mohana","familyName":"A","name":"A, Krishna Mohana","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Xin","familyName":"Wang","name":"Wang, Xin","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Ning","familyName":"Chang","name":"Chang, Ning","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Guiping","familyName":"Tan","name":"Tan, Guiping","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Xiang","familyName":"Liu","name":"Liu, Xiang","affiliation":[],"nameIdentifiers":[]}],"titles":[{"title":"SMMAN: quasi-Simultaneous Multi-wavelength Monitoring of gamma-ray-loud AGNs with the Nanshan 26-m radio telescope"}],"publisher":"arXiv","container":{},"publicationYear":2026,"subjects":[{"subject":"Astrophysics of Galaxies (astro-ph.GA)","lang":"en","subjectScheme":"arXiv"},{"subject":"High Energy Astrophysical Phenomena (astro-ph.HE)","lang":"en","subjectScheme":"arXiv"},{"subject":"FOS: Physical sciences","subjectScheme":"Fields of Science and Technology (FOS)"},{"schemeUri":"http://www.oecd.org/science/inno/38235147.pdf","subject":"FOS: Physical sciences","subjectScheme":"Fields of Science and Technology (FOS)"}],"contributors":[],"dates":[{"date":"2026-02-23T05:27:58Z","dateType":"Submitted","dateInformation":"v1"},{"date":"2026-02-24T02:10:49Z","dateType":"Updated","dateInformation":"v1"},{"date":"2026-02-24T08:27:47Z","dateType":"Submitted","dateInformation":"v2"},{"date":"2026-02-25T01:32:10Z","dateType":"Updated","dateInformation":"v2"},{"date":"2026-02","dateType":"Available","dateInformation":"v1"},{"date":"2026","dateType":"Issued"}],"language":null,"types":{"schemaOrg":"CreativeWork","resourceTypeGeneral":"Preprint","citeproc":"article","bibtex":"misc","ris":"GEN","resourceType":"Article"},"relatedIdentifiers":[{"relationType":"IsVersionOf","relatedIdentifier":"10.3847/1538-4365/ae4904","relatedIdentifierType":"DOI"}],"relatedItems":[],"sizes":[],"formats":[],"version":"2","rightsList":[{"rightsUri":"http://arxiv.org/licenses/nonexclusive-distrib/1.0/","rights":"arXiv.org perpetual, non-exclusive license"}],"descriptions":[{"descriptionType":"Abstract","description":"Active Galactic Nuclei (AGNs) are characterized by strong temporal flux density variability across the electromagnetic spectrum, offering insights into the complex physical processes governing accretion and plasma outflows. To systematically investigate AGNs flux density variability in radio bands, a long-term program was initiated in late 2016: quasi-Simultaneous Multiwavelength Monitoring of gamma-ray-loud AGNs with the Nanshan 26-m radio telescope (SMMAN). This work presents the first data release of the SMMAN program, spanning over eight years from 2016 to 2024 with observations at 4.8 and 23.6 GHz. The SMMAN sample includes 131 northern ($δ\u0026gt;\\sim0^{\\circ}$) sources selected from the Fermi Large Area Telescope third source catalog. The characteristics of variability, spectral index, luminosity, and $γ$-ray loudness factor are examined for different AGN classes within the sample. Target sources exhibit stronger variability at 23.6 GHz compared to 4.8 GHz, with BL Lac objects being more variable than flat-spectrum radio quasars (FSRQs). BL Lacs generally have flatter radio spectra, while FSRQs, blazar candidates of uncertain type (BCUs), and radio galaxies (RDGs) span a wider range from flat to steep. FSRQs are more radio-luminous than BL Lacs and other classes, with BCUs intermediate and RDGs generally fainter. FSRQs and BL Lacs have higher $γ$-ray loudness factors than RDGs, while BCUs have intermediate values. The SMMAN dataset, incorporated with other historical and ongoing monitoring programs, will provide a unique opportunity to investigate the evolution of spectral energy distributions, search for quasi-periodic oscillations, and analyze supermassive black hole binary systems."},{"descriptionType":"Other","description":"46 pages, 19 figures, 3 machine readable tables. Accepted for publication in ApJS"}],"geoLocations":[],"fundingReferences":[],"url":"https://arxiv.org/abs/2602.19524","contentUrl":null,"metadataVersion":0,"schemaVersion":"http://datacite.org/schema/kernel-4","source":"mds","isActive":true,"state":"findable","reason":null,"viewCount":0,"downloadCount":0,"referenceCount":0,"citationCount":0,"partCount":0,"partOfCount":0,"versionCount":0,"versionOfCount":1,"created":"2026-02-25T15:04:00Z","registered":"2026-02-25T15:04:01Z","published":null,"updated":"2026-02-25T15:04:01Z"},"relationships":{"client":{"data":{"id":"arxiv.content","type":"clients"}}}},{"id":"10.48550/arxiv.2602.19523","type":"dois","attributes":{"doi":"10.48550/arxiv.2602.19523","identifiers":[{"identifier":"2602.19523","identifierType":"arXiv"}],"creators":[{"nameType":"Personal","givenName":"Jingyuan","familyName":"Wang","name":"Wang, Jingyuan","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Li","familyName":"Niu","name":"Niu, Li","affiliation":[],"nameIdentifiers":[]}],"titles":[{"title":"OSInsert: Towards High-authenticity and High-fidelity Image Composition"}],"publisher":"arXiv","container":{},"publicationYear":2026,"subjects":[{"subject":"Computer Vision and Pattern Recognition (cs.CV)","lang":"en","subjectScheme":"arXiv"},{"subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"},{"schemeUri":"http://www.oecd.org/science/inno/38235147.pdf","subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"}],"contributors":[],"dates":[{"date":"2026-02-23T05:25:05Z","dateType":"Submitted","dateInformation":"v1"},{"date":"2026-02-24T02:10:43Z","dateType":"Updated","dateInformation":"v1"},{"date":"2026-02","dateType":"Available","dateInformation":"v1"},{"date":"2026","dateType":"Issued"}],"language":null,"types":{"schemaOrg":"CreativeWork","resourceTypeGeneral":"Preprint","citeproc":"article","bibtex":"misc","ris":"GEN","resourceType":"Article"},"relatedIdentifiers":[],"relatedItems":[],"sizes":[],"formats":[],"version":"1","rightsList":[{"rightsUri":"http://arxiv.org/licenses/nonexclusive-distrib/1.0/","rights":"arXiv.org perpetual, non-exclusive license"}],"descriptions":[{"descriptionType":"Abstract","description":"Generative image composition aims to regenerate the given foreground object in the background image to produce a realistic composite image. Some high-authenticity methods can adjust foreground pose/view to be compatible with background, while some high-fidelity methods can preserve the foreground details accurately. However, existing methods can hardly achieve both goals at the same time. In this work, we propose a two-stage strategy to achieve both goals. In the first stage, we use high-authenticity method to generate reasonable foreground shape, serving as the condition of high-fidelity method in the second stage. The experiments on MureCOM dataset verify the effectiveness of our two-stage strategy. The code and model have been released at https://github.com/bcmi/OSInsert-Image-Composition."}],"geoLocations":[],"fundingReferences":[],"url":"https://arxiv.org/abs/2602.19523","contentUrl":null,"metadataVersion":0,"schemaVersion":"http://datacite.org/schema/kernel-4","source":"mds","isActive":true,"state":"findable","reason":null,"viewCount":0,"downloadCount":0,"referenceCount":0,"citationCount":0,"partCount":0,"partOfCount":0,"versionCount":0,"versionOfCount":0,"created":"2026-02-25T15:03:58Z","registered":"2026-02-25T15:03:59Z","published":null,"updated":"2026-02-25T15:03:59Z"},"relationships":{"client":{"data":{"id":"arxiv.content","type":"clients"}}}},{"id":"10.48550/arxiv.2602.19522","type":"dois","attributes":{"doi":"10.48550/arxiv.2602.19522","identifiers":[{"identifier":"2602.19522","identifierType":"arXiv"}],"creators":[{"nameType":"Personal","givenName":"Zhenghao","familyName":"Zhou","name":"Zhou, Zhenghao","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Yiyan","familyName":"Li","name":"Li, Yiyan","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Fei","familyName":"Xie","name":"Xie, Fei","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Lu","familyName":"Wang","name":"Wang, Lu","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Bo","familyName":"Wang","name":"Wang, Bo","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Jiansheng","familyName":"Wang","name":"Wang, Jiansheng","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Zheng","familyName":"Yan","name":"Yan, Zheng","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Mo-Yuen","familyName":"Chow","name":"Chow, Mo-Yuen","affiliation":[],"nameIdentifiers":[]}],"titles":[{"title":"An LLM-Enabled Frequency-Aware Flow Diffusion Model for Natural-Language-Guided Power System Scenario Generation"}],"publisher":"arXiv","container":{},"publicationYear":2026,"subjects":[{"subject":"Signal Processing (eess.SP)","lang":"en","subjectScheme":"arXiv"},{"subject":"Sound (cs.SD)","lang":"en","subjectScheme":"arXiv"},{"subject":"FOS: Electrical engineering, electronic engineering, information engineering","subjectScheme":"Fields of Science and Technology (FOS)"},{"schemeUri":"http://www.oecd.org/science/inno/38235147.pdf","subject":"FOS: Electrical engineering, electronic engineering, information engineering","subjectScheme":"Fields of Science and Technology (FOS)"},{"subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"},{"schemeUri":"http://www.oecd.org/science/inno/38235147.pdf","subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"}],"contributors":[],"dates":[{"date":"2026-02-23T05:22:38Z","dateType":"Submitted","dateInformation":"v1"},{"date":"2026-02-24T02:10:39Z","dateType":"Updated","dateInformation":"v1"},{"date":"2026-02","dateType":"Available","dateInformation":"v1"},{"date":"2026","dateType":"Issued"}],"language":null,"types":{"schemaOrg":"CreativeWork","resourceTypeGeneral":"Preprint","citeproc":"article","bibtex":"misc","ris":"GEN","resourceType":"Article"},"relatedIdentifiers":[],"relatedItems":[],"sizes":[],"formats":[],"version":"1","rightsList":[{"rightsUri":"http://arxiv.org/licenses/nonexclusive-distrib/1.0/","rights":"arXiv.org perpetual, non-exclusive license"}],"descriptions":[{"descriptionType":"Abstract","description":"Diverse and controllable scenario generation (e.g., wind, solar, load, etc.) is critical for robust power system planning and operation. As AI-based scenario generation methods are becoming the mainstream, existing methods (e.g., Conditional Generative Adversarial Nets) mainly rely on a fixed-length numerical conditioning vector to control the generation results, facing challenges in user conveniency and generation flexibility. In this paper, a natural-language-guided scenario generation framework, named LLM-enabled Frequency-aware Flow Diffusion (LFFD), is proposed to enable users to generate desired scenarios using plain human language. First, a pretrained LLM module is introduced to convert generation requests described by unstructured natural languages into ordered semantic space. Second, instead of using standard diffusion models, a flow diffusion model employing a rectified flow matching objective is introduced to achieve efficient and high-quality scenario generation, taking the LLM output as the model input. During the model training process, a frequency-aware multi-objective optimization algorithm is introduced to mitigate the frequency-bias issue. Meanwhile, a dual-agent framework is designed to create text-scenario training sample pairs as well as to standardize semantic evaluation. Experiments based on large-scale photovoltaic and load datasets demonstrate the effectiveness of the proposed method."}],"geoLocations":[],"fundingReferences":[],"url":"https://arxiv.org/abs/2602.19522","contentUrl":null,"metadataVersion":0,"schemaVersion":"http://datacite.org/schema/kernel-4","source":"mds","isActive":true,"state":"findable","reason":null,"viewCount":0,"downloadCount":0,"referenceCount":0,"citationCount":0,"partCount":0,"partOfCount":0,"versionCount":0,"versionOfCount":0,"created":"2026-02-25T15:03:55Z","registered":"2026-02-25T15:03:56Z","published":null,"updated":"2026-02-25T15:03:56Z"},"relationships":{"client":{"data":{"id":"arxiv.content","type":"clients"}}}},{"id":"10.48550/arxiv.2602.19521","type":"dois","attributes":{"doi":"10.48550/arxiv.2602.19521","identifiers":[{"identifier":"2602.19521","identifierType":"arXiv"}],"creators":[{"nameType":"Personal","givenName":"Michael G.","familyName":"Watson","name":"Watson, Michael G.","affiliation":[],"nameIdentifiers":[]}],"titles":[{"title":"A mathematical model for the role of macrophage chemotactic emigration in the early atherosclerotic plaque"}],"publisher":"arXiv","container":{},"publicationYear":2026,"subjects":[{"subject":"Cell Behavior (q-bio.CB)","lang":"en","subjectScheme":"arXiv"},{"subject":"FOS: Biological sciences","subjectScheme":"Fields of Science and Technology (FOS)"},{"schemeUri":"http://www.oecd.org/science/inno/38235147.pdf","subject":"FOS: Biological sciences","subjectScheme":"Fields of Science and Technology (FOS)"}],"contributors":[],"dates":[{"date":"2026-02-23T05:22:21Z","dateType":"Submitted","dateInformation":"v1"},{"date":"2026-02-24T02:10:38Z","dateType":"Updated","dateInformation":"v1"},{"date":"2026-02","dateType":"Available","dateInformation":"v1"},{"date":"2026","dateType":"Issued"}],"language":null,"types":{"schemaOrg":"CreativeWork","resourceTypeGeneral":"Preprint","citeproc":"article","bibtex":"misc","ris":"GEN","resourceType":"Article"},"relatedIdentifiers":[],"relatedItems":[],"sizes":[],"formats":[],"version":"1","rightsList":[{"rightsIdentifierScheme":"SPDX","rightsUri":"https://creativecommons.org/licenses/by/4.0/legalcode","schemeUri":"https://spdx.org/licenses/","rights":"Creative Commons Attribution 4.0 International","rightsIdentifier":"cc-by-4.0"}],"descriptions":[{"descriptionType":"Abstract","description":"Atherosclerotic plaques are fatty, cellular lesions that form in artery walls. The early plaque contains monocyte-derived macrophages, which are recruited to consume locally bound lipid deposits. Plaque progression is characterised by an imbalance in the rates of cell entry and exit from the plaque, which can occur if macrophages die in situ rather than leave by emigration. The mechanisms that regulate macrophage emigration are not well understood, but there is evidence that a chemotactic response can guide macrophages out of the plaque towards the artery wall lymphatics.\n In this paper, we develop a novel spatial model of the early plaque to study the implications of macrophage chemotactic emigration. Using mathematical analysis and numerical simulations, we investigate how the properties of the chemotactic response contribute to the spatial characteristics and lipid burden of the model plaque. Calculations of macrophage transit times are found to provide a reliable indicator of long-term plaque lipid burden, and also highlight the potential rate-limiting effect of the internal elastic lamina (IEL) on chemotactic emigration. When macrophage emigration is rate-limited by the IEL, we observe non-monotonic cell and lipid profiles that are associated with macrophage accumulation deep in the plaque. The model further predicts that when the chemoattractant penetrates only a short distance into the plaque, the proportion of emigrating macrophages may increase relative to that for a longer-range signal. The theoretical observations in this study can potentially be used to identify evidence of macrophage emigration in data from real atherosclerotic plaques."}],"geoLocations":[],"fundingReferences":[],"url":"https://arxiv.org/abs/2602.19521","contentUrl":null,"metadataVersion":0,"schemaVersion":"http://datacite.org/schema/kernel-4","source":"mds","isActive":true,"state":"findable","reason":null,"viewCount":0,"downloadCount":0,"referenceCount":0,"citationCount":0,"partCount":0,"partOfCount":0,"versionCount":0,"versionOfCount":0,"created":"2026-02-25T15:03:53Z","registered":"2026-02-25T15:03:53Z","published":null,"updated":"2026-02-25T15:03:53Z"},"relationships":{"client":{"data":{"id":"arxiv.content","type":"clients"}}}},{"id":"10.48550/arxiv.2602.19519","type":"dois","attributes":{"doi":"10.48550/arxiv.2602.19519","identifiers":[{"identifier":"2602.19519","identifierType":"arXiv"}],"creators":[{"nameType":"Personal","givenName":"Yirou","familyName":"Ge","name":"Ge, Yirou","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Yixi","familyName":"Li","name":"Li, Yixi","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Alec","familyName":"Chiu","name":"Chiu, Alec","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Shivani","familyName":"Shekhar","name":"Shekhar, Shivani","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Zijie","familyName":"Pan","name":"Pan, Zijie","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Avinash","familyName":"Thangali","name":"Thangali, Avinash","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Yun-Shiuan","familyName":"Chuang","name":"Chuang, Yun-Shiuan","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Chaitanya","familyName":"Kulkarni","name":"Kulkarni, Chaitanya","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Uma","familyName":"Kona","name":"Kona, Uma","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Linsey","familyName":"Pang","name":"Pang, Linsey","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Prakhar","familyName":"Mehrotra","name":"Mehrotra, Prakhar","affiliation":[],"nameIdentifiers":[]}],"titles":[{"title":"Ada-RS: Adaptive Rejection Sampling for Selective Thinking"}],"publisher":"arXiv","container":{},"publicationYear":2026,"subjects":[{"subject":"Artificial Intelligence (cs.AI)","lang":"en","subjectScheme":"arXiv"},{"subject":"Machine Learning (cs.LG)","lang":"en","subjectScheme":"arXiv"},{"subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"},{"schemeUri":"http://www.oecd.org/science/inno/38235147.pdf","subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"}],"contributors":[],"dates":[{"date":"2026-02-23T05:20:15Z","dateType":"Submitted","dateInformation":"v1"},{"date":"2026-02-24T02:10:32Z","dateType":"Updated","dateInformation":"v1"},{"date":"2026-02","dateType":"Available","dateInformation":"v1"},{"date":"2026","dateType":"Issued"}],"language":null,"types":{"schemaOrg":"CreativeWork","resourceTypeGeneral":"Preprint","citeproc":"article","bibtex":"misc","ris":"GEN","resourceType":"Article"},"relatedIdentifiers":[],"relatedItems":[],"sizes":[],"formats":[],"version":"1","rightsList":[{"rightsIdentifierScheme":"SPDX","rightsUri":"https://creativecommons.org/licenses/by/4.0/legalcode","schemeUri":"https://spdx.org/licenses/","rights":"Creative Commons Attribution 4.0 International","rightsIdentifier":"cc-by-4.0"}],"descriptions":[{"descriptionType":"Abstract","description":"Large language models (LLMs) are increasingly being deployed in cost and latency-sensitive settings. While chain-of-thought improves reasoning, it can waste tokens on simple requests. We study selective thinking for tool-using LLMs and introduce Adaptive Rejection Sampling (Ada-RS), an algorithm-agnostic sample filtering framework for learning selective and efficient reasoning. For each given context, Ada-RS scores multiple sampled completions with an adaptive length-penalized reward then applies stochastic rejection sampling to retain only high-reward candidates (or preference pairs) for downstream optimization. We demonstrate how Ada-RS plugs into both preference pair (e.g. DPO) or grouped policy optimization strategies (e.g. DAPO). Using Qwen3-8B with LoRA on a synthetic tool call-oriented e-commerce benchmark, Ada-RS improves the accuracy-efficiency frontier over standard algorithms by reducing average output tokens by up to 80% and reducing thinking rate by up to 95% while maintaining or improving tool call accuracy. These results highlight that training-signal selection is a powerful lever for efficient reasoning in latency-sensitive deployments."}],"geoLocations":[],"fundingReferences":[],"url":"https://arxiv.org/abs/2602.19519","contentUrl":null,"metadataVersion":0,"schemaVersion":"http://datacite.org/schema/kernel-4","source":"mds","isActive":true,"state":"findable","reason":null,"viewCount":0,"downloadCount":0,"referenceCount":0,"citationCount":0,"partCount":0,"partOfCount":0,"versionCount":0,"versionOfCount":0,"created":"2026-02-25T15:03:48Z","registered":"2026-02-25T15:03:48Z","published":null,"updated":"2026-02-25T15:03:48Z"},"relationships":{"client":{"data":{"id":"arxiv.content","type":"clients"}}}},{"id":"10.48550/arxiv.2602.19518","type":"dois","attributes":{"doi":"10.48550/arxiv.2602.19518","identifiers":[{"identifier":"2602.19518","identifierType":"arXiv"}],"creators":[{"nameType":"Personal","givenName":"Nabanita","familyName":"Dash","name":"Dash, Nabanita","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Ayush","familyName":"Kaura","name":"Kaura, Ayush","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Shivam","familyName":"Singh","name":"Singh, Shivam","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Ramandeep","familyName":"Singh","name":"Singh, Ramandeep","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Snehasis","familyName":"Banerjee","name":"Banerjee, Snehasis","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Mohan","familyName":"Sridharan","name":"Sridharan, Mohan","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"K. Madhava","familyName":"Krishna","name":"Krishna, K. Madhava","affiliation":[],"nameIdentifiers":[]}],"titles":[{"title":"Anticipate, Adapt, Act: A Hybrid Framework for Task Planning"}],"publisher":"arXiv","container":{},"publicationYear":2026,"subjects":[{"subject":"Robotics (cs.RO)","lang":"en","subjectScheme":"arXiv"},{"subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"},{"schemeUri":"http://www.oecd.org/science/inno/38235147.pdf","subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"}],"contributors":[],"dates":[{"date":"2026-02-23T05:18:11Z","dateType":"Submitted","dateInformation":"v1"},{"date":"2026-02-24T02:10:28Z","dateType":"Updated","dateInformation":"v1"},{"date":"2026-02","dateType":"Available","dateInformation":"v1"},{"date":"2026","dateType":"Issued"}],"language":null,"types":{"schemaOrg":"CreativeWork","resourceTypeGeneral":"Preprint","citeproc":"article","bibtex":"misc","ris":"GEN","resourceType":"Article"},"relatedIdentifiers":[],"relatedItems":[],"sizes":[],"formats":[],"version":"1","rightsList":[{"rightsUri":"http://arxiv.org/licenses/nonexclusive-distrib/1.0/","rights":"arXiv.org perpetual, non-exclusive license"}],"descriptions":[{"descriptionType":"Abstract","description":"Anticipating and adapting to failures is a key capability robots need to collaborate effectively with humans in complex domains. This continues to be a challenge despite the impressive performance of state of the art AI planning systems and Large Language Models (LLMs) because of the uncertainty associated with the tasks and their outcomes. Toward addressing this challenge, we present a hybrid framework that integrates the generic prediction capabilities of an LLM with the probabilistic sequential decision-making capability of Relational Dynamic Influence Diagram Language. For any given task, the robot reasons about the task and the capabilities of the human attempting to complete it; predicts potential failures due to lack of ability (in the human) or lack of relevant domain objects; and executes actions to prevent such failures or recover from them. Experimental evaluation in the VirtualHome 3D simulation environment demonstrates substantial improvement in performance compared with state of the art baselines."},{"descriptionType":"Other","description":"Accepted at IEEE European Conference on Mobile Robots (ECMR)"}],"geoLocations":[],"fundingReferences":[],"url":"https://arxiv.org/abs/2602.19518","contentUrl":null,"metadataVersion":0,"schemaVersion":"http://datacite.org/schema/kernel-4","source":"mds","isActive":true,"state":"findable","reason":null,"viewCount":0,"downloadCount":0,"referenceCount":0,"citationCount":0,"partCount":0,"partOfCount":0,"versionCount":0,"versionOfCount":0,"created":"2026-02-25T15:03:45Z","registered":"2026-02-25T15:03:46Z","published":null,"updated":"2026-02-25T15:03:46Z"},"relationships":{"client":{"data":{"id":"arxiv.content","type":"clients"}}}},{"id":"10.48550/arxiv.2602.19516","type":"dois","attributes":{"doi":"10.48550/arxiv.2602.19516","identifiers":[{"identifier":"2602.19516","identifierType":"arXiv"}],"creators":[{"nameType":"Personal","givenName":"Ruikun","familyName":"Li","name":"Li, Ruikun","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Jun","familyName":"Yao","name":"Yao, Jun","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Yingfan","familyName":"Hua","name":"Hua, Yingfan","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Shixiang","familyName":"Tang","name":"Tang, Shixiang","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Biqing","familyName":"Qi","name":"Qi, Biqing","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Bin","familyName":"Liu","name":"Liu, Bin","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Wanli","familyName":"Ouyang","name":"Ouyang, Wanli","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Yan","familyName":"Lu","name":"Lu, Yan","affiliation":[],"nameIdentifiers":[]}],"titles":[{"title":"Pixel2Phys: Distilling Governing Laws from Visual Dynamics"}],"publisher":"arXiv","container":{},"publicationYear":2026,"subjects":[{"subject":"Computational Engineering, Finance, and Science (cs.CE)","lang":"en","subjectScheme":"arXiv"},{"subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"},{"schemeUri":"http://www.oecd.org/science/inno/38235147.pdf","subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"}],"contributors":[],"dates":[{"date":"2026-02-23T05:16:47Z","dateType":"Submitted","dateInformation":"v1"},{"date":"2026-02-24T02:10:25Z","dateType":"Updated","dateInformation":"v1"},{"date":"2026-02","dateType":"Available","dateInformation":"v1"},{"date":"2026","dateType":"Issued"}],"language":null,"types":{"schemaOrg":"CreativeWork","resourceTypeGeneral":"Preprint","citeproc":"article","bibtex":"misc","ris":"GEN","resourceType":"Article"},"relatedIdentifiers":[],"relatedItems":[],"sizes":[],"formats":[],"version":"1","rightsList":[{"rightsUri":"http://arxiv.org/licenses/nonexclusive-distrib/1.0/","rights":"arXiv.org perpetual, non-exclusive license"}],"descriptions":[{"descriptionType":"Abstract","description":"Discovering physical laws directly from high-dimensional visual data is a long-standing human pursuit but remains a formidable challenge for machines, representing a fundamental goal of scientific intelligence. This task is inherently difficult because physical knowledge is low-dimensional and structured, whereas raw video observations are high-dimensional and redundant, with most pixels carrying little or no physical meaning. Extracting concise, physically relevant variables from such noisy data remains a key obstacle. To address this, we propose Pixel2Phys, a collaborative multi-agent framework adaptable to any Multimodal Large Language Model (MLLM). It emulates human scientific reasoning by employing a structured workflow to extract formalized physical knowledge through iterative hypothesis generation, validation, and refinement. By repeatedly formulating, and refining candidate equations on high-dimensional data, it identifies the most concise representations that best capture the underlying physical evolution. This automated exploration mimics the iterative workflow of human scientists, enabling AI to reveal interpretable governing equations directly from raw observations. Across diverse simulated and real-world physics videos, Pixel2Phys discovers accurate, interpretable governing equations and maintaining stable long-term extrapolation where baselines rapidly diverge."},{"descriptionType":"Other","description":"CVPR2026 main track"}],"geoLocations":[],"fundingReferences":[],"url":"https://arxiv.org/abs/2602.19516","contentUrl":null,"metadataVersion":0,"schemaVersion":"http://datacite.org/schema/kernel-4","source":"mds","isActive":true,"state":"findable","reason":null,"viewCount":0,"downloadCount":0,"referenceCount":0,"citationCount":0,"partCount":0,"partOfCount":0,"versionCount":0,"versionOfCount":0,"created":"2026-02-25T15:03:40Z","registered":"2026-02-25T15:03:41Z","published":null,"updated":"2026-02-25T15:03:41Z"},"relationships":{"client":{"data":{"id":"arxiv.content","type":"clients"}}}},{"id":"10.48550/arxiv.2602.19515","type":"dois","attributes":{"doi":"10.48550/arxiv.2602.19515","identifiers":[{"identifier":"2602.19515","identifierType":"arXiv"}],"creators":[{"nameType":"Personal","givenName":"Theodoros","familyName":"Depastas","name":"Depastas, Theodoros","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Aldo","familyName":"Bonasera","name":"Bonasera, Aldo","affiliation":[],"nameIdentifiers":[]}],"titles":[{"title":"A Boson exchange approach for Helium Burning Stars"}],"publisher":"arXiv","container":{},"publicationYear":2026,"subjects":[{"subject":"Nuclear Theory (nucl-th)","lang":"en","subjectScheme":"arXiv"},{"subject":"FOS: Physical sciences","subjectScheme":"Fields of Science and Technology (FOS)"},{"schemeUri":"http://www.oecd.org/science/inno/38235147.pdf","subject":"FOS: Physical sciences","subjectScheme":"Fields of Science and Technology (FOS)"}],"contributors":[],"dates":[{"date":"2026-02-23T05:12:48Z","dateType":"Submitted","dateInformation":"v1"},{"date":"2026-02-24T02:10:19Z","dateType":"Updated","dateInformation":"v1"},{"date":"2026-02","dateType":"Available","dateInformation":"v1"},{"date":"2026","dateType":"Issued"}],"language":null,"types":{"schemaOrg":"CreativeWork","resourceTypeGeneral":"Preprint","citeproc":"article","bibtex":"misc","ris":"GEN","resourceType":"Article"},"relatedIdentifiers":[],"relatedItems":[],"sizes":[],"formats":[],"version":"1","rightsList":[{"rightsIdentifierScheme":"SPDX","rightsUri":"https://creativecommons.org/licenses/by-nc-sa/4.0/legalcode","schemeUri":"https://spdx.org/licenses/","rights":"Creative Commons Attribution Non Commercial Share Alike 4.0 International","rightsIdentifier":"cc-by-nc-sa-4.0"}],"descriptions":[{"descriptionType":"Abstract","description":"Helium burning plays a key role in the hierarchy of stellar nucleosynthesis and evolution, as the archetype of a bosonic 3-body system. Here, we examine the kinetic and nuclear aspects of the 3$α$ reaction, under the auspices of the Thomas-Efimov theorem. Due to the 92.08 keV ground state of $^8$Be, multiple $α$-cluster resonances appear especially at the lowest temperature (Thomas State), while with increasing temperature the system is dominated by the Hoyle/Efimov state. We extend our previous methodology for the sequential channel to describe the direct mechanism, that results in an equilateral geometry similar to the Thomas state. This is accomplished by developing a general approach to the N-body scattering, via successive particle-exchanging 2-body collisions, which eliminates long range Coulomb complications, in a similar manner to the Thomas-Efimov mechanism. We furthermore, discuss the e$^+$e$^-$ decay of the compound state with a perturbation based methodology. Due to the symmetry of the system and the resulting reaction rates, we favor the E0 decay scheme over the E2. The E0 reaction rates obey all the available astrophysical and nuclear constraints and are compared to theoretical data from the literature, whose limitations are discussed. Our extended methodology provides a physically sound description of the debated low temperature region."},{"descriptionType":"Other","description":"8 pages, 5 figures"}],"geoLocations":[],"fundingReferences":[],"url":"https://arxiv.org/abs/2602.19515","contentUrl":null,"metadataVersion":0,"schemaVersion":"http://datacite.org/schema/kernel-4","source":"mds","isActive":true,"state":"findable","reason":null,"viewCount":0,"downloadCount":0,"referenceCount":0,"citationCount":0,"partCount":0,"partOfCount":0,"versionCount":0,"versionOfCount":0,"created":"2026-02-25T15:03:38Z","registered":"2026-02-25T15:03:38Z","published":null,"updated":"2026-02-25T15:03:38Z"},"relationships":{"client":{"data":{"id":"arxiv.content","type":"clients"}}}},{"id":"10.48550/arxiv.2602.19514","type":"dois","attributes":{"doi":"10.48550/arxiv.2602.19514","identifiers":[{"identifier":"2602.19514","identifierType":"arXiv"}],"creators":[{"nameType":"Personal","givenName":"Pulak","familyName":"Mehta","name":"Mehta, Pulak","affiliation":[],"nameIdentifiers":[]}],"titles":[{"title":"Security Risks of AI Agents Hiring Humans: An Empirical Marketplace Study"}],"publisher":"arXiv","container":{},"publicationYear":2026,"subjects":[{"subject":"Cryptography and Security (cs.CR)","lang":"en","subjectScheme":"arXiv"},{"subject":"Human-Computer Interaction (cs.HC)","lang":"en","subjectScheme":"arXiv"},{"subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"},{"schemeUri":"http://www.oecd.org/science/inno/38235147.pdf","subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"}],"contributors":[],"dates":[{"date":"2026-02-23T05:08:27Z","dateType":"Submitted","dateInformation":"v1"},{"date":"2026-02-24T02:10:18Z","dateType":"Updated","dateInformation":"v1"},{"date":"2026-02","dateType":"Available","dateInformation":"v1"},{"date":"2026","dateType":"Issued"}],"language":null,"types":{"schemaOrg":"CreativeWork","resourceTypeGeneral":"Preprint","citeproc":"article","bibtex":"misc","ris":"GEN","resourceType":"Article"},"relatedIdentifiers":[],"relatedItems":[],"sizes":[],"formats":[],"version":"1","rightsList":[{"rightsIdentifierScheme":"SPDX","rightsUri":"https://creativecommons.org/licenses/by/4.0/legalcode","schemeUri":"https://spdx.org/licenses/","rights":"Creative Commons Attribution 4.0 International","rightsIdentifier":"cc-by-4.0"}],"descriptions":[{"descriptionType":"Abstract","description":"Autonomous AI agents can now programmatically hire human workers through marketplaces using REST APIs and Model Context Protocol (MCP) integrations. This creates an attack surface analogous to CAPTCHA-solving services but with physical-world reach. We present an empirical measurement study of this threat, analyzing 303 bounties from RENTAHUMAN.AI, a marketplace where agents post tasks and manage escrow payments. We find that 99 bounties (32.7%), originate from programmatic channels (API keys or MCP). Using a dual-coder methodology (\\k{appa} = 0.86 ), we identify six active abuse classes: credential fraud, identity impersonation, automated reconnaissance, social media manipulation, authentication circumvention, and referral fraud, all purchasable for a median of $25 per worker. A retrospective evaluation of seven content-screening rules flags 52 bounties (17.2%) with a single false positive, demonstrating that while basic defenses are feasible, they are currently absent."}],"geoLocations":[],"fundingReferences":[],"url":"https://arxiv.org/abs/2602.19514","contentUrl":null,"metadataVersion":0,"schemaVersion":"http://datacite.org/schema/kernel-4","source":"mds","isActive":true,"state":"findable","reason":null,"viewCount":0,"downloadCount":0,"referenceCount":0,"citationCount":0,"partCount":0,"partOfCount":0,"versionCount":0,"versionOfCount":0,"created":"2026-02-25T15:03:35Z","registered":"2026-02-25T15:03:36Z","published":null,"updated":"2026-02-25T15:03:36Z"},"relationships":{"client":{"data":{"id":"arxiv.content","type":"clients"}}}},{"id":"10.48550/arxiv.2602.19513","type":"dois","attributes":{"doi":"10.48550/arxiv.2602.19513","identifiers":[{"identifier":"2602.19513","identifierType":"arXiv"}],"creators":[{"nameType":"Personal","givenName":"Yasutaka","familyName":"Shimizu","name":"Shimizu, Yasutaka","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Atsushi","familyName":"Yamanobe","name":"Yamanobe, Atsushi","affiliation":[],"nameIdentifiers":[]}],"titles":[{"title":"Real-time Win Probability and Latent Player Ability via STATS X in Team Sports"}],"publisher":"arXiv","container":{},"publicationYear":2026,"subjects":[{"subject":"Applications (stat.AP)","lang":"en","subjectScheme":"arXiv"},{"subject":"Machine Learning (stat.ML)","lang":"en","subjectScheme":"arXiv"},{"subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"},{"schemeUri":"http://www.oecd.org/science/inno/38235147.pdf","subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"},{"subject":"62P25, 60G99, 68T05","lang":"en","subjectScheme":"MSC"}],"contributors":[],"dates":[{"date":"2026-02-23T05:00:44Z","dateType":"Submitted","dateInformation":"v1"},{"date":"2026-02-24T02:10:05Z","dateType":"Updated","dateInformation":"v1"},{"date":"2026-02","dateType":"Available","dateInformation":"v1"},{"date":"2026","dateType":"Issued"}],"language":null,"types":{"schemaOrg":"CreativeWork","resourceTypeGeneral":"Preprint","citeproc":"article","bibtex":"misc","ris":"GEN","resourceType":"Article"},"relatedIdentifiers":[],"relatedItems":[],"sizes":[],"formats":[],"version":"1","rightsList":[{"rightsIdentifierScheme":"SPDX","rightsUri":"https://creativecommons.org/licenses/by/4.0/legalcode","schemeUri":"https://spdx.org/licenses/","rights":"Creative Commons Attribution 4.0 International","rightsIdentifier":"cc-by-4.0"}],"descriptions":[{"descriptionType":"Abstract","description":"This study proposes a statistically grounded framework for real-time win probability evaluation and player assessment in score-based team sports, based on minute-by-minute cumulative box-score data. We introduce a continuous dominance indicator (T-score) that maps final scores to real values consistent with win/lose outcomes, and formulate it as a time-evolving stochastic representation (T-process) driven by standardized cumulative statistics. This structure captures temporal game dynamics and enables sequential, analytically tractable updates of in-game win probability. Through this stochastic formulation, competitive advantage is decomposed into interpretable statistical components. Furthermore, we define a latent contribution index, STATS X, which quantifies a player's involvement in favorable dominance intervals identified by the T-process. This allows us to separate a team's baseline strength from game-specific performance fluctuations and provides a coherent, structural evaluation framework for both teams and players. While we do not implement AI methods in this paper, our framework is positioned as a foundational step toward hybrid integration with AI. By providing a structured time-series representation of dominance with an explicit probabilistic interpretation, the framework enables flexible learning mechanisms and incorporation of high-dimensional data, while preserving statistical coherence and interpretability. This work provides a basis for advancing AI-driven sports analytics."}],"geoLocations":[],"fundingReferences":[],"url":"https://arxiv.org/abs/2602.19513","contentUrl":null,"metadataVersion":0,"schemaVersion":"http://datacite.org/schema/kernel-4","source":"mds","isActive":true,"state":"findable","reason":null,"viewCount":0,"downloadCount":0,"referenceCount":0,"citationCount":0,"partCount":0,"partOfCount":0,"versionCount":0,"versionOfCount":0,"created":"2026-02-25T15:03:33Z","registered":"2026-02-25T15:03:33Z","published":null,"updated":"2026-02-25T15:03:33Z"},"relationships":{"client":{"data":{"id":"arxiv.content","type":"clients"}}}},{"id":"10.48550/arxiv.2602.19512","type":"dois","attributes":{"doi":"10.48550/arxiv.2602.19512","identifiers":[{"identifier":"2602.19512","identifierType":"arXiv"}],"creators":[{"nameType":"Personal","givenName":"Pengxi","familyName":"Liu","name":"Liu, Pengxi","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Zeyu Michael","familyName":"Li","name":"Li, Zeyu Michael","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Xiang","familyName":"Cheng","name":"Cheng, Xiang","affiliation":[],"nameIdentifiers":[]}],"titles":[{"title":"Variational Trajectory Optimization of Anisotropic Diffusion Schedules"}],"publisher":"arXiv","container":{},"publicationYear":2026,"subjects":[{"subject":"Machine Learning (cs.LG)","lang":"en","subjectScheme":"arXiv"},{"subject":"Computer Vision and Pattern Recognition (cs.CV)","lang":"en","subjectScheme":"arXiv"},{"subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"},{"schemeUri":"http://www.oecd.org/science/inno/38235147.pdf","subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"}],"contributors":[],"dates":[{"date":"2026-02-23T04:56:41Z","dateType":"Submitted","dateInformation":"v1"},{"date":"2026-02-24T02:10:00Z","dateType":"Updated","dateInformation":"v1"},{"date":"2026-02","dateType":"Available","dateInformation":"v1"},{"date":"2026","dateType":"Issued"}],"language":null,"types":{"schemaOrg":"CreativeWork","resourceTypeGeneral":"Preprint","citeproc":"article","bibtex":"misc","ris":"GEN","resourceType":"Article"},"relatedIdentifiers":[],"relatedItems":[],"sizes":[],"formats":[],"version":"1","rightsList":[{"rightsUri":"http://arxiv.org/licenses/nonexclusive-distrib/1.0/","rights":"arXiv.org perpetual, non-exclusive license"}],"descriptions":[{"descriptionType":"Abstract","description":"We introduce a variational framework for diffusion models with anisotropic noise schedules parameterized by a matrix-valued path $M_t(θ)$ that allocates noise across subspaces. Central to our framework is a trajectory-level objective that jointly trains the score network and learns $M_t(θ)$, which encompasses general parameterization classes of matrix-valued noise schedules. We further derive an estimator for the derivative with respect to $θ$ of the score that enables efficient optimization of the $M_t(θ)$ schedule. For inference, we develop an efficiently-implementable reverse-ODE solver that is an anisotropic generalization of the second-order Heun discretization algorithm. Across CIFAR-10, AFHQv2, FFHQ, and ImageNet-64, our method consistently improves upon the baseline EDM model in all NFE regimes. Code is available at https://github.com/lizeyu090312/anisotropic-diffusion-paper."}],"geoLocations":[],"fundingReferences":[],"url":"https://arxiv.org/abs/2602.19512","contentUrl":null,"metadataVersion":0,"schemaVersion":"http://datacite.org/schema/kernel-4","source":"mds","isActive":true,"state":"findable","reason":null,"viewCount":0,"downloadCount":0,"referenceCount":0,"citationCount":0,"partCount":0,"partOfCount":0,"versionCount":0,"versionOfCount":0,"created":"2026-02-25T15:03:30Z","registered":"2026-02-25T15:03:31Z","published":null,"updated":"2026-02-25T15:03:31Z"},"relationships":{"client":{"data":{"id":"arxiv.content","type":"clients"}}}},{"id":"10.48550/arxiv.2602.19510","type":"dois","attributes":{"doi":"10.48550/arxiv.2602.19510","identifiers":[{"identifier":"2602.19510","identifierType":"arXiv"}],"creators":[{"nameType":"Personal","givenName":"Rudrajit","familyName":"Das","name":"Das, Rudrajit","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Neel","familyName":"Patel","name":"Patel, Neel","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Meisam","familyName":"Razaviyayn","name":"Razaviyayn, Meisam","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Vahab","familyName":"Mirrokni","name":"Mirrokni, Vahab","affiliation":[],"nameIdentifiers":[]}],"titles":[{"title":"Less is More: Convergence Benefits of Fewer Data Weight Updates over Longer Horizon"}],"publisher":"arXiv","container":{},"publicationYear":2026,"subjects":[{"subject":"Machine Learning (cs.LG)","lang":"en","subjectScheme":"arXiv"},{"subject":"Optimization and Control (math.OC)","lang":"en","subjectScheme":"arXiv"},{"subject":"Machine Learning (stat.ML)","lang":"en","subjectScheme":"arXiv"},{"subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"},{"schemeUri":"http://www.oecd.org/science/inno/38235147.pdf","subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"},{"subject":"FOS: Mathematics","subjectScheme":"Fields of Science and Technology (FOS)"},{"schemeUri":"http://www.oecd.org/science/inno/38235147.pdf","subject":"FOS: Mathematics","subjectScheme":"Fields of Science and Technology (FOS)"}],"contributors":[],"dates":[{"date":"2026-02-23T04:50:13Z","dateType":"Submitted","dateInformation":"v1"},{"date":"2026-02-24T02:09:52Z","dateType":"Updated","dateInformation":"v1"},{"date":"2026-02","dateType":"Available","dateInformation":"v1"},{"date":"2026","dateType":"Issued"}],"language":null,"types":{"schemaOrg":"CreativeWork","resourceTypeGeneral":"Preprint","citeproc":"article","bibtex":"misc","ris":"GEN","resourceType":"Article"},"relatedIdentifiers":[],"relatedItems":[],"sizes":[],"formats":[],"version":"1","rightsList":[{"rightsIdentifierScheme":"SPDX","rightsUri":"https://creativecommons.org/licenses/by/4.0/legalcode","schemeUri":"https://spdx.org/licenses/","rights":"Creative Commons Attribution 4.0 International","rightsIdentifier":"cc-by-4.0"}],"descriptions":[{"descriptionType":"Abstract","description":"Data mixing--the strategic reweighting of training domains--is a critical component in training robust machine learning models. This problem is naturally formulated as a bilevel optimization task, where the outer loop optimizes domain weights to minimize validation loss, and the inner loop optimizes model parameters to minimize the weighted training loss. Classical bilevel optimization relies on hypergradients, which theoretically require the inner optimization to reach convergence. However, due to computational constraints, state-of-the-art methods use a finite, often small, number of inner update steps before updating the weights. The theoretical implications of this approximation are not well understood. In this work, we rigorously analyze the convergence behavior of data mixing with a finite number of inner steps $T$. We prove that the \"greedy\" practical approach of using $T=1$ can fail even in a simple quadratic example. Under a fixed parameter update budget $N$ and assuming the per-domain losses are strongly convex, we show that the optimal $T$ scales as $Θ(\\log N)$ (resp., $Θ({(N \\log N)}^{1/2})$) for the data mixing problem with access to full (resp., stochastic) gradients. We complement our theoretical results with proof-of-concept experiments."}],"geoLocations":[],"fundingReferences":[],"url":"https://arxiv.org/abs/2602.19510","contentUrl":null,"metadataVersion":0,"schemaVersion":"http://datacite.org/schema/kernel-4","source":"mds","isActive":true,"state":"findable","reason":null,"viewCount":0,"downloadCount":0,"referenceCount":0,"citationCount":0,"partCount":0,"partOfCount":0,"versionCount":0,"versionOfCount":0,"created":"2026-02-25T15:03:25Z","registered":"2026-02-25T15:03:26Z","published":null,"updated":"2026-02-25T15:03:26Z"},"relationships":{"client":{"data":{"id":"arxiv.content","type":"clients"}}}},{"id":"10.48550/arxiv.2602.19508","type":"dois","attributes":{"doi":"10.48550/arxiv.2602.19508","identifiers":[{"identifier":"2602.19508","identifierType":"arXiv"}],"creators":[{"nameType":"Personal","givenName":"Aritra","familyName":"Bhattacharya","name":"Bhattacharya, Aritra","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Ashish","familyName":"Mishra","name":"Mishra, Ashish","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Shraddha","familyName":"Srivastava","name":"Srivastava, Shraddha","affiliation":[],"nameIdentifiers":[]}],"titles":[{"title":"On factorization of matrix of Kazhdan-Lusztig polynomials"}],"publisher":"arXiv","container":{},"publicationYear":2026,"subjects":[{"subject":"Representation Theory (math.RT)","lang":"en","subjectScheme":"arXiv"},{"subject":"Algebraic Geometry (math.AG)","lang":"en","subjectScheme":"arXiv"},{"subject":"Combinatorics (math.CO)","lang":"en","subjectScheme":"arXiv"},{"subject":"FOS: Mathematics","subjectScheme":"Fields of Science and Technology (FOS)"},{"schemeUri":"http://www.oecd.org/science/inno/38235147.pdf","subject":"FOS: Mathematics","subjectScheme":"Fields of Science and Technology (FOS)"},{"subject":"20C08, 14M15","lang":"en","subjectScheme":"MSC"}],"contributors":[],"dates":[{"date":"2026-02-23T04:46:45Z","dateType":"Submitted","dateInformation":"v1"},{"date":"2026-02-24T02:09:50Z","dateType":"Updated","dateInformation":"v1"},{"date":"2026-02","dateType":"Available","dateInformation":"v1"},{"date":"2026","dateType":"Issued"}],"language":null,"types":{"schemaOrg":"CreativeWork","resourceTypeGeneral":"Preprint","citeproc":"article","bibtex":"misc","ris":"GEN","resourceType":"Article"},"relatedIdentifiers":[],"relatedItems":[],"sizes":[],"formats":[],"version":"1","rightsList":[{"rightsIdentifierScheme":"SPDX","rightsUri":"https://creativecommons.org/licenses/by/4.0/legalcode","schemeUri":"https://spdx.org/licenses/","rights":"Creative Commons Attribution 4.0 International","rightsIdentifier":"cc-by-4.0"}],"descriptions":[{"descriptionType":"Abstract","description":"Let $\\mathcal{H} = \\mathcal{H}(W,S)$ be the Hecke algebra of the Coxeter system $(W,S)$ over $\\mathbb{Z}[q^{\\pm1}]$, where $W$ is the Weyl group of a symmetrizable Kac-Moody algebra. In this paper, we show that the matrix of Kazhdan-Lusztig polynomials of $\\mathcal{H}$ factorizes into a product of $|S|$ many matrices, each of which has entries as polynomials in $q$ with nonnegative coefficients. To achieve this goal, we use hybrid basis $TC^J$ for $J\\subseteq S$ of $\\mathcal{H}$, defined by Grojnowski-Haiman. The intermediate matrices in the aforementioned factorization turn out to be the transition matrices from $TC^J$-basis to $TC^I$-basis for $I\\subset J$. Equivalently, these coefficients can be computed using a natural restriction map from $\\mathcal{H}$ to the parabolic Hecke algebra $\\mathcal{H}_J$. Moreover, following the ideas from Grojnowski-Haiman, we also give a geometric proof of the positivity of these coefficients."}],"geoLocations":[],"fundingReferences":[],"url":"https://arxiv.org/abs/2602.19508","contentUrl":null,"metadataVersion":0,"schemaVersion":"http://datacite.org/schema/kernel-4","source":"mds","isActive":true,"state":"findable","reason":null,"viewCount":0,"downloadCount":0,"referenceCount":0,"citationCount":0,"partCount":0,"partOfCount":0,"versionCount":0,"versionOfCount":0,"created":"2026-02-25T15:03:20Z","registered":"2026-02-25T15:03:21Z","published":null,"updated":"2026-02-25T15:03:21Z"},"relationships":{"client":{"data":{"id":"arxiv.content","type":"clients"}}}},{"id":"10.48550/arxiv.2602.19507","type":"dois","attributes":{"doi":"10.48550/arxiv.2602.19507","identifiers":[{"identifier":"2602.19507","identifierType":"arXiv"}],"creators":[{"nameType":"Personal","givenName":"David Fraile","familyName":"Navarro","name":"Navarro, David Fraile","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Mor","familyName":"Peleg","name":"Peleg, Mor","affiliation":[],"nameIdentifiers":[]}],"titles":[{"title":"Conversational AI for Automated Patient Questionnaire Completion: Development Insights and Design Principles"}],"publisher":"arXiv","container":{},"publicationYear":2026,"subjects":[{"subject":"Human-Computer Interaction (cs.HC)","lang":"en","subjectScheme":"arXiv"},{"subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"},{"schemeUri":"http://www.oecd.org/science/inno/38235147.pdf","subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"}],"contributors":[],"dates":[{"date":"2026-02-23T04:46:30Z","dateType":"Submitted","dateInformation":"v1"},{"date":"2026-02-24T02:09:50Z","dateType":"Updated","dateInformation":"v1"},{"date":"2026-02","dateType":"Available","dateInformation":"v1"},{"date":"2026","dateType":"Issued"}],"language":null,"types":{"schemaOrg":"CreativeWork","resourceTypeGeneral":"Preprint","citeproc":"article","bibtex":"misc","ris":"GEN","resourceType":"Article"},"relatedIdentifiers":[],"relatedItems":[],"sizes":[],"formats":[],"version":"1","rightsList":[{"rightsUri":"http://arxiv.org/licenses/nonexclusive-distrib/1.0/","rights":"arXiv.org perpetual, non-exclusive license"}],"descriptions":[{"descriptionType":"Abstract","description":"Collecting patient-reported outcome measures (PROMs) is essential for clinical care and research, yet traditional form-based approaches are often tedious for patients and burdensome for clinicians. We developed a generative AI conversational agent(CA) using GPT-5 to collect back pain data according to the NIH Task Force's Recommended Minimal Dataset. Unlike prior CAs that ask questions one-by-one, our CA engages users in topic-based conversations, allowing multiple data items to be captured in a single exchange. Through iterative development and pilot testing with clinicians and a consumer panel, we identified key design principles for health data collection CAs. These principles extend established clinical decision support design guidelines to conversational interfaces, addressing: flexibility of interaction style, personality calibration, data quality assurance through confidence visualization, patient safety constraints, and interoperability requirements. We present our prompt design methodology and discuss challenges encountered, including managing conversation length, handling ambiguous responses, and adapting to LLM version changes. Our design principles provide a practical framework for developers creating conversational agents for patient questionnaire completion. The CA is available at https://chatgpt.com/g/g-68f4869548f48191af0544f110ee91c6-backpain-data-collection-assistant (requires ChatGPT registration and subscription for unlimited use)."},{"descriptionType":"Other","description":"13 pages"}],"geoLocations":[],"fundingReferences":[],"url":"https://arxiv.org/abs/2602.19507","contentUrl":null,"metadataVersion":0,"schemaVersion":"http://datacite.org/schema/kernel-4","source":"mds","isActive":true,"state":"findable","reason":null,"viewCount":0,"downloadCount":0,"referenceCount":0,"citationCount":0,"partCount":0,"partOfCount":0,"versionCount":0,"versionOfCount":0,"created":"2026-02-25T15:03:18Z","registered":"2026-02-25T15:03:19Z","published":null,"updated":"2026-02-25T15:03:19Z"},"relationships":{"client":{"data":{"id":"arxiv.content","type":"clients"}}}},{"id":"10.48550/arxiv.2602.19506","type":"dois","attributes":{"doi":"10.48550/arxiv.2602.19506","identifiers":[{"identifier":"2602.19506","identifierType":"arXiv"}],"creators":[{"nameType":"Personal","givenName":"Byunggwan","familyName":"Son","name":"Son, Byunggwan","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Jeimin","familyName":"Jeon","name":"Jeon, Jeimin","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Jeongwoo","familyName":"Choi","name":"Choi, Jeongwoo","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Bumsub","familyName":"Ham","name":"Ham, Bumsub","affiliation":[],"nameIdentifiers":[]}],"titles":[{"title":"Relational Feature Caching for Accelerating Diffusion Transformers"}],"publisher":"arXiv","container":{},"publicationYear":2026,"subjects":[{"subject":"Computer Vision and Pattern Recognition (cs.CV)","lang":"en","subjectScheme":"arXiv"},{"subject":"Machine Learning (cs.LG)","lang":"en","subjectScheme":"arXiv"},{"subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"},{"schemeUri":"http://www.oecd.org/science/inno/38235147.pdf","subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"}],"contributors":[],"dates":[{"date":"2026-02-23T04:45:38Z","dateType":"Submitted","dateInformation":"v1"},{"date":"2026-02-24T02:09:46Z","dateType":"Updated","dateInformation":"v1"},{"date":"2026-02","dateType":"Available","dateInformation":"v1"},{"date":"2026","dateType":"Issued"}],"language":null,"types":{"schemaOrg":"CreativeWork","resourceTypeGeneral":"Preprint","citeproc":"article","bibtex":"misc","ris":"GEN","resourceType":"Article"},"relatedIdentifiers":[],"relatedItems":[],"sizes":[],"formats":[],"version":"1","rightsList":[{"rightsIdentifierScheme":"SPDX","rightsUri":"https://creativecommons.org/licenses/by-nc-nd/4.0/legalcode","schemeUri":"https://spdx.org/licenses/","rights":"Creative Commons Attribution Non Commercial No Derivatives 4.0 International","rightsIdentifier":"cc-by-nc-nd-4.0"}],"descriptions":[{"descriptionType":"Abstract","description":"Feature caching approaches accelerate diffusion transformers (DiTs) by storing the output features of computationally expensive modules at certain timesteps, and exploiting them for subsequent steps to reduce redundant computations. Recent forecasting-based caching approaches employ temporal extrapolation techniques to approximate the output features with cached ones. Although effective, relying exclusively on temporal extrapolation still suffers from significant prediction errors, leading to performance degradation. Through a detailed analysis, we find that 1) these errors stem from the irregular magnitude of changes in the output features, and 2) an input feature of a module is strongly correlated with the corresponding output. Based on this, we propose relational feature caching (RFC), a novel framework that leverages the input-output relationship to enhance the accuracy of the feature prediction. Specifically, we introduce relational feature estimation (RFE) to estimate the magnitude of changes in the output features from the inputs, enabling more accurate feature predictions. We also present relational cache scheduling (RCS), which estimates the prediction errors using the input features and performs full computations only when the errors are expected to be substantial. Extensive experiments across various DiT models demonstrate that RFC consistently outperforms prior approaches significantly. Project page is available at https://cvlab.yonsei.ac.kr/projects/RFC"},{"descriptionType":"Other","description":"Accepted to ICLR 2026"}],"geoLocations":[],"fundingReferences":[],"url":"https://arxiv.org/abs/2602.19506","contentUrl":null,"metadataVersion":0,"schemaVersion":"http://datacite.org/schema/kernel-4","source":"mds","isActive":true,"state":"findable","reason":null,"viewCount":0,"downloadCount":0,"referenceCount":0,"citationCount":0,"partCount":0,"partOfCount":0,"versionCount":0,"versionOfCount":0,"created":"2026-02-25T15:03:16Z","registered":"2026-02-25T15:03:16Z","published":null,"updated":"2026-02-25T15:03:16Z"},"relationships":{"client":{"data":{"id":"arxiv.content","type":"clients"}}}},{"id":"10.48550/arxiv.2602.19505","type":"dois","attributes":{"doi":"10.48550/arxiv.2602.19505","identifiers":[{"identifier":"2602.19505","identifierType":"arXiv"}],"creators":[{"nameType":"Personal","givenName":"Mingrui","familyName":"Wu","name":"Wu, Mingrui","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Hao","familyName":"Chen","name":"Chen, Hao","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Jiayi","familyName":"Ji","name":"Ji, Jiayi","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Xiaoshuai","familyName":"Sun","name":"Sun, Xiaoshuai","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Zhiyuan","familyName":"Liu","name":"Liu, Zhiyuan","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Liujuan","familyName":"Cao","name":"Cao, Liujuan","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Ming-Ming","familyName":"Cheng","name":"Cheng, Ming-Ming","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Rongrong","familyName":"Ji","name":"Ji, Rongrong","affiliation":[],"nameIdentifiers":[]}],"titles":[{"title":"Test-Time Computing for Referring Multimodal Large Language Models"}],"publisher":"arXiv","container":{},"publicationYear":2026,"subjects":[{"subject":"Computer Vision and Pattern Recognition (cs.CV)","lang":"en","subjectScheme":"arXiv"},{"subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"},{"schemeUri":"http://www.oecd.org/science/inno/38235147.pdf","subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"}],"contributors":[],"dates":[{"date":"2026-02-23T04:42:10Z","dateType":"Submitted","dateInformation":"v1"},{"date":"2026-02-24T02:09:42Z","dateType":"Updated","dateInformation":"v1"},{"date":"2026-02","dateType":"Available","dateInformation":"v1"},{"date":"2026","dateType":"Issued"}],"language":null,"types":{"schemaOrg":"CreativeWork","resourceTypeGeneral":"Preprint","citeproc":"article","bibtex":"misc","ris":"GEN","resourceType":"Article"},"relatedIdentifiers":[],"relatedItems":[],"sizes":[],"formats":[],"version":"1","rightsList":[{"rightsIdentifierScheme":"SPDX","rightsUri":"https://creativecommons.org/licenses/by/4.0/legalcode","schemeUri":"https://spdx.org/licenses/","rights":"Creative Commons Attribution 4.0 International","rightsIdentifier":"cc-by-4.0"}],"descriptions":[{"descriptionType":"Abstract","description":"We propose ControlMLLM++, a novel test-time adaptation framework that injects learnable visual prompts into frozen multimodal large language models (MLLMs) to enable fine-grained region-based visual reasoning without any model retraining or fine-tuning. Leveraging the insight that cross-modal attention maps intrinsically encode semantic correspondences between textual tokens and visual regions, ControlMLLM++ optimizes a latent visual token modifier during inference via a task-specific energy function to steer model attention towards user-specified areas. To enhance optimization stability and mitigate language prompt biases, ControlMLLM++ incorporates an improved optimization strategy (Optim++) and a prompt debiasing mechanism (PromptDebias). Supporting diverse visual prompt types including bounding boxes, masks, scribbles, and points, our method demonstrates strong out-of-domain generalization and interpretability. The code is available at https://github.com/mrwu-mac/ControlMLLM."},{"descriptionType":"Other","description":"arXiv admin note: substantial text overlap with arXiv:2407.21534"}],"geoLocations":[],"fundingReferences":[],"url":"https://arxiv.org/abs/2602.19505","contentUrl":null,"metadataVersion":0,"schemaVersion":"http://datacite.org/schema/kernel-4","source":"mds","isActive":true,"state":"findable","reason":null,"viewCount":0,"downloadCount":0,"referenceCount":0,"citationCount":0,"partCount":0,"partOfCount":0,"versionCount":0,"versionOfCount":0,"created":"2026-02-25T15:03:13Z","registered":"2026-02-25T15:03:14Z","published":null,"updated":"2026-02-25T15:03:14Z"},"relationships":{"client":{"data":{"id":"arxiv.content","type":"clients"}}}},{"id":"10.48550/arxiv.2602.19503","type":"dois","attributes":{"doi":"10.48550/arxiv.2602.19503","identifiers":[{"identifier":"2602.19503","identifierType":"arXiv"}],"creators":[{"nameType":"Personal","givenName":"Hyun-Ki","familyName":"Jung","name":"Jung, Hyun-Ki","affiliation":[],"nameIdentifiers":[]}],"titles":[{"title":"A Text-Guided Vision Model for Enhanced Recognition of Small Instances"}],"publisher":"arXiv","container":{},"publicationYear":2026,"subjects":[{"subject":"Computer Vision and Pattern Recognition (cs.CV)","lang":"en","subjectScheme":"arXiv"},{"subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"},{"schemeUri":"http://www.oecd.org/science/inno/38235147.pdf","subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"}],"contributors":[],"dates":[{"date":"2026-02-23T04:40:14Z","dateType":"Submitted","dateInformation":"v1"},{"date":"2026-02-24T02:09:40Z","dateType":"Updated","dateInformation":"v1"},{"date":"2026-02","dateType":"Available","dateInformation":"v1"},{"date":"2026","dateType":"Issued"}],"language":null,"types":{"schemaOrg":"CreativeWork","resourceTypeGeneral":"Preprint","citeproc":"article","bibtex":"misc","ris":"GEN","resourceType":"Article"},"relatedIdentifiers":[],"relatedItems":[],"sizes":[],"formats":[],"version":"1","rightsList":[{"rightsUri":"http://arxiv.org/licenses/nonexclusive-distrib/1.0/","rights":"arXiv.org perpetual, non-exclusive license"}],"descriptions":[{"descriptionType":"Abstract","description":"As drone-based object detection technology continues to evolve, the demand is shifting from merely detecting objects to enabling users to accurately identify specific targets. For example, users can input particular targets as prompts to precisely detect desired objects. To address this need, an efficient text-guided object detection model has been developed to enhance the detection of small objects. Specifically, an improved version of the existing YOLO-World model is introduced. The proposed method replaces the C2f layer in the YOLOv8 backbone with a C3k2 layer, enabling more precise representation of local features, particularly for small objects or those with clearly defined boundaries. Additionally, the proposed architecture improves processing speed and efficiency through parallel processing optimization, while also contributing to a more lightweight model design. Comparative experiments on the VisDrone dataset show that the proposed model outperforms the original YOLO-World model, with precision increasing from 40.6% to 41.6%, recall from 30.8% to 31%, F1 score from 35% to 35.5%, and mAP@0.5 from 30.4% to 30.7%, confirming its enhanced accuracy. Furthermore, the model demonstrates superior lightweight performance, with the parameter count reduced from 4 million to 3.8 million and FLOPs decreasing from 15.7 billion to 15.2 billion. These results indicate that the proposed approach provides a practical and effective solution for precise object detection in drone-based applications."},{"descriptionType":"Other","description":"Accepted for publication in Applied Computer Science (2026)"}],"geoLocations":[],"fundingReferences":[],"url":"https://arxiv.org/abs/2602.19503","contentUrl":null,"metadataVersion":0,"schemaVersion":"http://datacite.org/schema/kernel-4","source":"mds","isActive":true,"state":"findable","reason":null,"viewCount":0,"downloadCount":0,"referenceCount":0,"citationCount":0,"partCount":0,"partOfCount":0,"versionCount":0,"versionOfCount":0,"created":"2026-02-25T15:03:08Z","registered":"2026-02-25T15:03:09Z","published":null,"updated":"2026-02-25T15:03:09Z"},"relationships":{"client":{"data":{"id":"arxiv.content","type":"clients"}}}},{"id":"10.48550/arxiv.2602.19501","type":"dois","attributes":{"doi":"10.48550/arxiv.2602.19501","identifiers":[{"identifier":"2602.19501","identifierType":"arXiv"}],"creators":[{"nameType":"Personal","givenName":"Uddipta","familyName":"Kar","name":"Kar, Uddipta","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Akhilesh Kr.","familyName":"Singh","name":"Singh, Akhilesh Kr.","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Elisha Cho-Hao","familyName":"Lu","name":"Lu, Elisha Cho-Hao","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"P. V. Sreenivasa","familyName":"Reddy","name":"Reddy, P. V. Sreenivasa","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Fu-En","familyName":"Cheng","name":"Cheng, Fu-En","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Wazid","familyName":"Ahmed","name":"Ahmed, Wazid","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Song","familyName":"Yang","name":"Yang, Song","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Chun-Yen","familyName":"Lin","name":"Lin, Chun-Yen","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Chia-Hung","familyName":"Hsu","name":"Hsu, Chia-Hung","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Guang-Yu","familyName":"Guo","name":"Guo, Guang-Yu","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Wei-Li","familyName":"Lee","name":"Lee, Wei-Li","affiliation":[],"nameIdentifiers":[]}],"titles":[{"title":"Anisotropic magnetoresistance and magnetic field-tunable Weyl nodes in Weyl metal SrRuO$_{3}$ thin films"}],"publisher":"arXiv","container":{},"publicationYear":2026,"subjects":[{"subject":"Other Condensed Matter (cond-mat.other)","lang":"en","subjectScheme":"arXiv"},{"subject":"FOS: Physical sciences","subjectScheme":"Fields of Science and Technology (FOS)"},{"schemeUri":"http://www.oecd.org/science/inno/38235147.pdf","subject":"FOS: Physical sciences","subjectScheme":"Fields of Science and Technology (FOS)"}],"contributors":[],"dates":[{"date":"2026-02-23T04:36:45Z","dateType":"Submitted","dateInformation":"v1"},{"date":"2026-02-24T02:09:32Z","dateType":"Updated","dateInformation":"v1"},{"date":"2026-02","dateType":"Available","dateInformation":"v1"},{"date":"2026","dateType":"Issued"}],"language":null,"types":{"schemaOrg":"CreativeWork","resourceTypeGeneral":"Preprint","citeproc":"article","bibtex":"misc","ris":"GEN","resourceType":"Article"},"relatedIdentifiers":[],"relatedItems":[],"sizes":[],"formats":[],"version":"1","rightsList":[{"rightsIdentifierScheme":"SPDX","rightsUri":"https://creativecommons.org/licenses/by-nc-nd/4.0/legalcode","schemeUri":"https://spdx.org/licenses/","rights":"Creative Commons Attribution Non Commercial No Derivatives 4.0 International","rightsIdentifier":"cc-by-nc-nd-4.0"}],"descriptions":[{"descriptionType":"Abstract","description":"Weyl semimetals are a unique class of topological materials, possessing Fermi-arc surface states and exhibiting the chiral anomaly effect. The chiral anomaly refers to non-equilibrium charge transfer within a Weyl-node pair of opposite chirality under the condition of aligned electric and magnetic fields ($\\bf{E} \\parallel \\bf{B}$), leading to non-conserved chiral charges and thus enhanced electrical conductivity. In experiments, such an enhanced conductivity due to the chiral anomaly manifests as a negative longitudinal magnetoresistance (MR) when the external field $\\bf{H}$ is applied along the bias current direction $\\bf{I}$. In this work, we present rigorous $ϕ$- and $α$-dependent magnetotransport measurements to investigate such a negative longitudinal MR due to the chiral anomaly in a sunbeam-shaped device fabricated from an untwinned Weyl metal SrRuO$_{3}$ (SRO) thin film. Here, $ϕ$($α$) represents the angle between $\\bf{I}$ and the in-plane $\\bf{H}$(SRO monoclinic [001]$_{\\rm o}$). Unusual $ϕ$ dependences of in-plane MR and Hall effects were uncovered at low temperatures, accompanied by the emergence of the fourfold-symmetric component in the in-plane MR. These results indicate that the chiral anomaly and resistivity anisotropy in SRO play important roles. In particular, the dramatic variation of Weyl nodes near the Fermi level through magnetic field manipulation of the magnetization orientation, as revealed by band structure calculations, is consistent with the observed in-plane MR and Hall effect."},{"descriptionType":"Other","description":"12 pages, 5 figures"}],"geoLocations":[],"fundingReferences":[],"url":"https://arxiv.org/abs/2602.19501","contentUrl":null,"metadataVersion":0,"schemaVersion":"http://datacite.org/schema/kernel-4","source":"mds","isActive":true,"state":"findable","reason":null,"viewCount":0,"downloadCount":0,"referenceCount":0,"citationCount":0,"partCount":0,"partOfCount":0,"versionCount":0,"versionOfCount":0,"created":"2026-02-25T15:03:03Z","registered":"2026-02-25T15:03:04Z","published":null,"updated":"2026-02-25T15:03:04Z"},"relationships":{"client":{"data":{"id":"arxiv.content","type":"clients"}}}},{"id":"10.48550/arxiv.2602.19500","type":"dois","attributes":{"doi":"10.48550/arxiv.2602.19500","identifiers":[{"identifier":"2602.19500","identifierType":"arXiv"}],"creators":[{"nameType":"Personal","givenName":"Jiyue","familyName":"Zeng","name":"Zeng, Jiyue","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Xinyi","familyName":"Zhang","name":"Zhang, Xinyi","affiliation":[],"nameIdentifiers":[]}],"titles":[{"title":"Stationary Log-Gamma Polymer in Half-Space"}],"publisher":"arXiv","container":{},"publicationYear":2026,"subjects":[{"subject":"Probability (math.PR)","lang":"en","subjectScheme":"arXiv"},{"subject":"FOS: Mathematics","subjectScheme":"Fields of Science and Technology (FOS)"},{"schemeUri":"http://www.oecd.org/science/inno/38235147.pdf","subject":"FOS: Mathematics","subjectScheme":"Fields of Science and Technology (FOS)"}],"contributors":[],"dates":[{"date":"2026-02-23T04:36:24Z","dateType":"Submitted","dateInformation":"v1"},{"date":"2026-02-24T02:09:31Z","dateType":"Updated","dateInformation":"v1"},{"date":"2026-02","dateType":"Available","dateInformation":"v1"},{"date":"2026","dateType":"Issued"}],"language":null,"types":{"schemaOrg":"CreativeWork","resourceTypeGeneral":"Preprint","citeproc":"article","bibtex":"misc","ris":"GEN","resourceType":"Article"},"relatedIdentifiers":[],"relatedItems":[],"sizes":[],"formats":[],"version":"1","rightsList":[{"rightsIdentifierScheme":"SPDX","rightsUri":"https://creativecommons.org/licenses/by/4.0/legalcode","schemeUri":"https://spdx.org/licenses/","rights":"Creative Commons Attribution 4.0 International","rightsIdentifier":"cc-by-4.0"}],"descriptions":[{"descriptionType":"Abstract","description":"We study the half-space log-gamma polymer model with stationary initial conditions. We derive exact formulas for the distribution of the partition function along the diagonal across the entire High density phase and Low density phase. We obtain asymptotics of these distributions under the critical scaling. We also prove the first exponential upper bounds for the upper and lower tail of the scaled free energy for these half-space stationary log-gamma models."},{"descriptionType":"Other","description":"Comments welcome"}],"geoLocations":[],"fundingReferences":[],"url":"https://arxiv.org/abs/2602.19500","contentUrl":null,"metadataVersion":0,"schemaVersion":"http://datacite.org/schema/kernel-4","source":"mds","isActive":true,"state":"findable","reason":null,"viewCount":0,"downloadCount":0,"referenceCount":0,"citationCount":0,"partCount":0,"partOfCount":0,"versionCount":0,"versionOfCount":0,"created":"2026-02-25T15:03:01Z","registered":"2026-02-25T15:03:02Z","published":null,"updated":"2026-02-25T15:03:02Z"},"relationships":{"client":{"data":{"id":"arxiv.content","type":"clients"}}}},{"id":"10.48550/arxiv.2602.19498","type":"dois","attributes":{"doi":"10.48550/arxiv.2602.19498","identifiers":[{"identifier":"2602.19498","identifierType":"arXiv"}],"creators":[{"nameType":"Personal","givenName":"Navid Akhavan","familyName":"Attar","name":"Attar, Navid Akhavan","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Hesam","familyName":"Asadollahzadeh","name":"Asadollahzadeh, Hesam","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Ling","familyName":"Luo","name":"Luo, Ling","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Uwe","familyName":"Aickelin","name":"Aickelin, Uwe","affiliation":[],"nameIdentifiers":[]}],"titles":[{"title":"Softmax is not Enough (for Adaptive Conformal Classification)"}],"publisher":"arXiv","container":{},"publicationYear":2026,"subjects":[{"subject":"Machine Learning (cs.LG)","lang":"en","subjectScheme":"arXiv"},{"subject":"Artificial Intelligence (cs.AI)","lang":"en","subjectScheme":"arXiv"},{"subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"},{"schemeUri":"http://www.oecd.org/science/inno/38235147.pdf","subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"}],"contributors":[],"dates":[{"date":"2026-02-23T04:33:04Z","dateType":"Submitted","dateInformation":"v1"},{"date":"2026-02-24T02:09:28Z","dateType":"Updated","dateInformation":"v1"},{"date":"2026-02","dateType":"Available","dateInformation":"v1"},{"date":"2026","dateType":"Issued"}],"language":null,"types":{"schemaOrg":"CreativeWork","resourceTypeGeneral":"Preprint","citeproc":"article","bibtex":"misc","ris":"GEN","resourceType":"Article"},"relatedIdentifiers":[],"relatedItems":[],"sizes":[],"formats":[],"version":"1","rightsList":[{"rightsIdentifierScheme":"SPDX","rightsUri":"https://creativecommons.org/licenses/by/4.0/legalcode","schemeUri":"https://spdx.org/licenses/","rights":"Creative Commons Attribution 4.0 International","rightsIdentifier":"cc-by-4.0"}],"descriptions":[{"descriptionType":"Abstract","description":"The merit of Conformal Prediction (CP), as a distribution-free framework for uncertainty quantification, depends on generating prediction sets that are efficient, reflected in small average set sizes, while adaptive, meaning they signal uncertainty by varying in size according to input difficulty. A central limitation for deep conformal classifiers is that the nonconformity scores are derived from softmax outputs, which can be unreliable indicators of how certain the model truly is about a given input, sometimes leading to overconfident misclassifications or undue hesitation. In this work, we argue that this unreliability can be inherited by the prediction sets generated by CP, limiting their capacity for adaptiveness. We propose a new approach that leverages information from the pre-softmax logit space, using the Helmholtz Free Energy as a measure of model uncertainty and sample difficulty. By reweighting nonconformity scores with a monotonic transformation of the energy score of each sample, we improve their sensitivity to input difficulty. Our experiments with four state-of-the-art score functions on multiple datasets and deep architectures show that this energy-based enhancement improves the adaptiveness of the prediction sets, leading to a notable increase in both efficiency and adaptiveness compared to baseline nonconformity scores, without introducing any post-hoc complexity."}],"geoLocations":[],"fundingReferences":[],"url":"https://arxiv.org/abs/2602.19498","contentUrl":null,"metadataVersion":0,"schemaVersion":"http://datacite.org/schema/kernel-4","source":"mds","isActive":true,"state":"findable","reason":null,"viewCount":0,"downloadCount":0,"referenceCount":0,"citationCount":0,"partCount":0,"partOfCount":0,"versionCount":0,"versionOfCount":0,"created":"2026-02-25T15:02:56Z","registered":"2026-02-25T15:02:57Z","published":null,"updated":"2026-02-25T15:02:57Z"},"relationships":{"client":{"data":{"id":"arxiv.content","type":"clients"}}}},{"id":"10.48550/arxiv.2602.19497","type":"dois","attributes":{"doi":"10.48550/arxiv.2602.19497","identifiers":[{"identifier":"2602.19497","identifierType":"arXiv"}],"creators":[{"nameType":"Personal","givenName":"Mingrui","familyName":"Wu","name":"Wu, Mingrui","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Hang","familyName":"Liu","name":"Liu, Hang","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Jiayi","familyName":"Ji","name":"Ji, Jiayi","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Xiaoshuai","familyName":"Sun","name":"Sun, Xiaoshuai","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Rongrong","familyName":"Ji","name":"Ji, Rongrong","affiliation":[],"nameIdentifiers":[]}],"titles":[{"title":"MICON-Bench: Benchmarking and Enhancing Multi-Image Context Image Generation in Unified Multimodal Models"}],"publisher":"arXiv","container":{},"publicationYear":2026,"subjects":[{"subject":"Computer Vision and Pattern Recognition (cs.CV)","lang":"en","subjectScheme":"arXiv"},{"subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"},{"schemeUri":"http://www.oecd.org/science/inno/38235147.pdf","subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"}],"contributors":[],"dates":[{"date":"2026-02-23T04:32:52Z","dateType":"Submitted","dateInformation":"v1"},{"date":"2026-02-24T02:09:27Z","dateType":"Updated","dateInformation":"v1"},{"date":"2026-02","dateType":"Available","dateInformation":"v1"},{"date":"2026","dateType":"Issued"}],"language":null,"types":{"schemaOrg":"CreativeWork","resourceTypeGeneral":"Preprint","citeproc":"article","bibtex":"misc","ris":"GEN","resourceType":"Article"},"relatedIdentifiers":[],"relatedItems":[],"sizes":[],"formats":[],"version":"1","rightsList":[{"rightsIdentifierScheme":"SPDX","rightsUri":"https://creativecommons.org/licenses/by/4.0/legalcode","schemeUri":"https://spdx.org/licenses/","rights":"Creative Commons Attribution 4.0 International","rightsIdentifier":"cc-by-4.0"}],"descriptions":[{"descriptionType":"Abstract","description":"Recent advancements in Unified Multimodal Models (UMMs) have enabled remarkable image understanding and generation capabilities. However, while models like Gemini-2.5-Flash-Image show emerging abilities to reason over multiple related images, existing benchmarks rarely address the challenges of multi-image context generation, focusing mainly on text-to-image or single-image editing tasks. In this work, we introduce \\textbf{MICON-Bench}, a comprehensive benchmark covering six tasks that evaluate cross-image composition, contextual reasoning, and identity preservation. We further propose an MLLM-driven Evaluation-by-Checkpoint framework for automatic verification of semantic and visual consistency, where multimodal large language model (MLLM) serves as a verifier. Additionally, we present \\textbf{Dynamic Attention Rebalancing (DAR)}, a training-free, plug-and-play mechanism that dynamically adjusts attention during inference to enhance coherence and reduce hallucinations. Extensive experiments on various state-of-the-art open-source models demonstrate both the rigor of MICON-Bench in exposing multi-image reasoning challenges and the efficacy of DAR in improving generation quality and cross-image coherence. Github: https://github.com/Angusliuuu/MICON-Bench."},{"descriptionType":"Other","description":"CVPR2026"}],"geoLocations":[],"fundingReferences":[],"url":"https://arxiv.org/abs/2602.19497","contentUrl":null,"metadataVersion":0,"schemaVersion":"http://datacite.org/schema/kernel-4","source":"mds","isActive":true,"state":"findable","reason":null,"viewCount":0,"downloadCount":0,"referenceCount":0,"citationCount":0,"partCount":0,"partOfCount":0,"versionCount":0,"versionOfCount":0,"created":"2026-02-25T15:02:54Z","registered":"2026-02-25T15:02:54Z","published":null,"updated":"2026-02-25T15:02:54Z"},"relationships":{"client":{"data":{"id":"arxiv.content","type":"clients"}}}},{"id":"10.48550/arxiv.2602.19495","type":"dois","attributes":{"doi":"10.48550/arxiv.2602.19495","identifiers":[{"identifier":"2602.19495","identifierType":"arXiv"}],"creators":[{"nameType":"Personal","givenName":"Joon-Hwi","familyName":"Kim","name":"Kim, Joon-Hwi","affiliation":[],"nameIdentifiers":[]}],"titles":[{"title":"The Kerr two-twistor particle"}],"publisher":"arXiv","container":{},"publicationYear":2026,"subjects":[{"subject":"General Relativity and Quantum Cosmology (gr-qc)","lang":"en","subjectScheme":"arXiv"},{"subject":"High Energy Physics - Theory (hep-th)","lang":"en","subjectScheme":"arXiv"},{"subject":"Differential Geometry (math.DG)","lang":"en","subjectScheme":"arXiv"},{"subject":"FOS: Physical sciences","subjectScheme":"Fields of Science and Technology (FOS)"},{"schemeUri":"http://www.oecd.org/science/inno/38235147.pdf","subject":"FOS: Physical sciences","subjectScheme":"Fields of Science and Technology (FOS)"},{"subject":"FOS: Mathematics","subjectScheme":"Fields of Science and Technology (FOS)"},{"schemeUri":"http://www.oecd.org/science/inno/38235147.pdf","subject":"FOS: Mathematics","subjectScheme":"Fields of Science and Technology (FOS)"}],"contributors":[],"dates":[{"date":"2026-02-23T04:30:31Z","dateType":"Submitted","dateInformation":"v1"},{"date":"2026-02-24T02:09:21Z","dateType":"Updated","dateInformation":"v1"},{"date":"2026-02","dateType":"Available","dateInformation":"v1"},{"date":"2026","dateType":"Issued"}],"language":null,"types":{"schemaOrg":"CreativeWork","resourceTypeGeneral":"Preprint","citeproc":"article","bibtex":"misc","ris":"GEN","resourceType":"Article"},"relatedIdentifiers":[],"relatedItems":[],"sizes":[],"formats":[],"version":"1","rightsList":[{"rightsIdentifierScheme":"SPDX","rightsUri":"https://creativecommons.org/licenses/by-sa/4.0/legalcode","schemeUri":"https://spdx.org/licenses/","rights":"Creative Commons Attribution Share Alike 4.0 International","rightsIdentifier":"cc-by-sa-4.0"}],"descriptions":[{"descriptionType":"Abstract","description":"An all-orders worldline effective action for Kerr black hole is achieved in twistor particle theory."},{"descriptionType":"Other","description":"10 + 2 pages, 7 figures"}],"geoLocations":[],"fundingReferences":[],"url":"https://arxiv.org/abs/2602.19495","contentUrl":null,"metadataVersion":0,"schemaVersion":"http://datacite.org/schema/kernel-4","source":"mds","isActive":true,"state":"findable","reason":null,"viewCount":0,"downloadCount":0,"referenceCount":0,"citationCount":0,"partCount":0,"partOfCount":0,"versionCount":0,"versionOfCount":0,"created":"2026-02-25T15:02:49Z","registered":"2026-02-25T15:02:50Z","published":null,"updated":"2026-02-25T15:02:50Z"},"relationships":{"client":{"data":{"id":"arxiv.content","type":"clients"}}}},{"id":"10.48550/arxiv.2602.19493","type":"dois","attributes":{"doi":"10.48550/arxiv.2602.19493","identifiers":[{"identifier":"2602.19493","identifierType":"arXiv"}],"creators":[{"nameType":"Personal","givenName":"Dein","familyName":"Wong","name":"Wong, Dein","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Songnian","familyName":"Xu","name":"Xu, Songnian","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Chi","familyName":"Zhang","name":"Zhang, Chi","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Zhijun","familyName":"Wang","name":"Wang, Zhijun","affiliation":[],"nameIdentifiers":[]}],"titles":[{"title":"On automorphism group of the reduced finitary power monoid of the additive group of integers"}],"publisher":"arXiv","container":{},"publicationYear":2026,"subjects":[{"subject":"Group Theory (math.GR)","lang":"en","subjectScheme":"arXiv"},{"subject":"FOS: Mathematics","subjectScheme":"Fields of Science and Technology (FOS)"},{"schemeUri":"http://www.oecd.org/science/inno/38235147.pdf","subject":"FOS: Mathematics","subjectScheme":"Fields of Science and Technology (FOS)"},{"subject":"08A35, 11P99, 20M13, 20M14","lang":"en","subjectScheme":"MSC"}],"contributors":[],"dates":[{"date":"2026-02-23T04:21:31Z","dateType":"Submitted","dateInformation":"v1"},{"date":"2026-02-24T02:09:05Z","dateType":"Updated","dateInformation":"v1"},{"date":"2026-02","dateType":"Available","dateInformation":"v1"},{"date":"2026","dateType":"Issued"}],"language":null,"types":{"schemaOrg":"CreativeWork","resourceTypeGeneral":"Preprint","citeproc":"article","bibtex":"misc","ris":"GEN","resourceType":"Article"},"relatedIdentifiers":[],"relatedItems":[],"sizes":[],"formats":[],"version":"1","rightsList":[{"rightsIdentifierScheme":"SPDX","rightsUri":"https://creativecommons.org/licenses/by-nc-sa/4.0/legalcode","schemeUri":"https://spdx.org/licenses/","rights":"Creative Commons Attribution Non Commercial Share Alike 4.0 International","rightsIdentifier":"cc-by-nc-sa-4.0"}],"descriptions":[{"descriptionType":"Abstract","description":"Let $\\mathbb{Z}$ be the additive group of all integers and $\\mathbb{N}$ the sub-monoid of $\\mathbb{Z}$ of all non-negative integers. For a finite subset $X$ of $\\mathbb{Z}$, we denote by ${\\rm max}\\ X$ the maximum member in $X$.\n %Recently, Tringali and Yan (\\cite{tri2}, J. Combin. Theory Ser. A, 209(2025)) proved that the only non-trivial automorphism of $\\mathcal{P}_{{\\rm fin,} 0}(\\mathbb{N})$ %is the involution $X \\mapsto β(X) - X$, and they posed a conjecture: {\\it The automorphism group of the reduced power monoid $\\mathcal{P}_{{\\rm fin,} 0}(S)$ of a numerical %monoid $S$ properly contained in $\\mathbb{N}$ must be the identity}.\n Recently, Tringali and Yan (\\cite{tri2}, J. Comb. Theory, Ser. A, 209(2025)) proved that the only non-trivial automorphism of $\\mathcal{P}_{{\\rm fin,} 0}(\\mathbb{N})$\n is the involution $X \\mapsto {\\rm max}\\ X - X$.\n Following up on the result in \\cite{tri2}, Tringali and Wen \\cite{triwen} proved that the automorphism group of the power monoid $\\mathcal{P}_{\\rm fin}(\\mathbb{Z})$ is isomorphic to $\\mathbb{Z}_2 \\times {\\rm Dih}_{\\infty}$, where ${\\rm Dih}_{\\infty}$ refers to the infinite dihedral group. At the end part of \\cite{triwen}, Tringali and Wen left a conjecture as follows:\n {\\it The only non-trivial automorphism of the reduced finitary power monoid of $(\\mathbb{Z},+)$ is given by $X\\mapsto -X$.} In the present paper, we aim to give a positive proof for the above conjecture."}],"geoLocations":[],"fundingReferences":[],"url":"https://arxiv.org/abs/2602.19493","contentUrl":null,"metadataVersion":0,"schemaVersion":"http://datacite.org/schema/kernel-4","source":"mds","isActive":true,"state":"findable","reason":null,"viewCount":0,"downloadCount":0,"referenceCount":0,"citationCount":0,"partCount":0,"partOfCount":0,"versionCount":0,"versionOfCount":0,"created":"2026-02-25T15:02:44Z","registered":"2026-02-25T15:02:45Z","published":null,"updated":"2026-02-25T15:02:45Z"},"relationships":{"client":{"data":{"id":"arxiv.content","type":"clients"}}}},{"id":"10.48550/arxiv.2602.19492","type":"dois","attributes":{"doi":"10.48550/arxiv.2602.19492","identifiers":[{"identifier":"2602.19492","identifierType":"arXiv"}],"creators":[{"nameType":"Personal","givenName":"Cody","familyName":"Trevillian","name":"Trevillian, Cody","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Steven","familyName":"Louis","name":"Louis, Steven","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Vasyl","familyName":"Tyberkevych","name":"Tyberkevych, Vasyl","affiliation":[],"nameIdentifiers":[]}],"titles":[{"title":"Temporal magnon-qubit Mach-Zehnder interferometer"}],"publisher":"arXiv","container":{},"publicationYear":2026,"subjects":[{"subject":"Mesoscale and Nanoscale Physics (cond-mat.mes-hall)","lang":"en","subjectScheme":"arXiv"},{"subject":"Quantum Physics (quant-ph)","lang":"en","subjectScheme":"arXiv"},{"subject":"FOS: Physical sciences","subjectScheme":"Fields of Science and Technology (FOS)"},{"schemeUri":"http://www.oecd.org/science/inno/38235147.pdf","subject":"FOS: Physical sciences","subjectScheme":"Fields of Science and Technology (FOS)"}],"contributors":[],"dates":[{"date":"2026-02-23T04:21:17Z","dateType":"Submitted","dateInformation":"v1"},{"date":"2026-02-24T02:09:04Z","dateType":"Updated","dateInformation":"v1"},{"date":"2026-02","dateType":"Available","dateInformation":"v1"},{"date":"2026","dateType":"Issued"}],"language":null,"types":{"schemaOrg":"CreativeWork","resourceTypeGeneral":"Preprint","citeproc":"article","bibtex":"misc","ris":"GEN","resourceType":"Article"},"relatedIdentifiers":[],"relatedItems":[],"sizes":[],"formats":[],"version":"1","rightsList":[{"rightsIdentifierScheme":"SPDX","rightsUri":"https://creativecommons.org/licenses/by/4.0/legalcode","schemeUri":"https://spdx.org/licenses/","rights":"Creative Commons Attribution 4.0 International","rightsIdentifier":"cc-by-4.0"}],"descriptions":[{"descriptionType":"Abstract","description":"A temporal magnon-qubit Mach-Zehnder (MZ) interferometer is proposed. The interferometer is based on controllable entanglement of a microwave qubit and a magnonic state, achieved by application of a pulsed magnetic field playing the role of a magnon-qubit temporal \"beam splitter\". Analogous to a typical MZ interferometer, the generated interference pattern of the final qubit population carries information about the magnon dynamics. One important application of the proposed scheme is the study of single magnon decoherence. Interestingly, this scheme allows one to independently determine rates of two possible decoherence channels. This may help enable single magnon state applications and answer fundamental questions of quasi-particle decoherence at single quantum levels."},{"descriptionType":"Other","description":"5 pages, 4 figures"}],"geoLocations":[],"fundingReferences":[],"url":"https://arxiv.org/abs/2602.19492","contentUrl":null,"metadataVersion":0,"schemaVersion":"http://datacite.org/schema/kernel-4","source":"mds","isActive":true,"state":"findable","reason":null,"viewCount":0,"downloadCount":0,"referenceCount":0,"citationCount":0,"partCount":0,"partOfCount":0,"versionCount":0,"versionOfCount":0,"created":"2026-02-25T15:02:42Z","registered":"2026-02-25T15:02:42Z","published":null,"updated":"2026-02-25T15:02:42Z"},"relationships":{"client":{"data":{"id":"arxiv.content","type":"clients"}}}},{"id":"10.48550/arxiv.2602.19491","type":"dois","attributes":{"doi":"10.48550/arxiv.2602.19491","identifiers":[{"identifier":"2602.19491","identifierType":"arXiv"}],"creators":[{"nameType":"Personal","givenName":"Samuel","familyName":"Bellaire","name":"Bellaire, Samuel","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Abdalmalek","familyName":"Abu-raddaha","name":"Abu-raddaha, Abdalmalek","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Natalie","familyName":"Kim","name":"Kim, Natalie","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Nathan","familyName":"Morhan","name":"Morhan, Nathan","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"William","familyName":"Elliott","name":"Elliott, William","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Samir","familyName":"Rawashdeh","name":"Rawashdeh, Samir","affiliation":[],"nameIdentifiers":[]}],"titles":[{"title":"Botson: An Accessible and Low-Cost Platform for Social Robotics Research"}],"publisher":"arXiv","container":{},"publicationYear":2026,"subjects":[{"subject":"Robotics (cs.RO)","lang":"en","subjectScheme":"arXiv"},{"subject":"Artificial Intelligence (cs.AI)","lang":"en","subjectScheme":"arXiv"},{"subject":"Human-Computer Interaction (cs.HC)","lang":"en","subjectScheme":"arXiv"},{"subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"},{"schemeUri":"http://www.oecd.org/science/inno/38235147.pdf","subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"}],"contributors":[],"dates":[{"date":"2026-02-23T04:21:05Z","dateType":"Submitted","dateInformation":"v1"},{"date":"2026-02-24T02:09:03Z","dateType":"Updated","dateInformation":"v1"},{"date":"2026-02","dateType":"Available","dateInformation":"v1"},{"date":"2026","dateType":"Issued"}],"language":null,"types":{"schemaOrg":"CreativeWork","resourceTypeGeneral":"Preprint","citeproc":"article","bibtex":"misc","ris":"GEN","resourceType":"Article"},"relatedIdentifiers":[],"relatedItems":[],"sizes":[],"formats":[],"version":"1","rightsList":[{"rightsUri":"http://arxiv.org/licenses/nonexclusive-distrib/1.0/","rights":"arXiv.org perpetual, non-exclusive license"}],"descriptions":[{"descriptionType":"Abstract","description":"Trust remains a critical barrier to the effective integration of Artificial Intelligence (AI) into human-centric domains. Disembodied agents, such as voice assistants, often fail to establish trust due to their inability to convey non-verbal social cues. This paper introduces the architecture of Botson: an anthropomorphic social robot powered by a large language model (LLM). Botson was created as a low-cost and accessible platform for social robotics research."},{"descriptionType":"Other","description":"5 pages, 7 figures"}],"geoLocations":[],"fundingReferences":[],"url":"https://arxiv.org/abs/2602.19491","contentUrl":null,"metadataVersion":0,"schemaVersion":"http://datacite.org/schema/kernel-4","source":"mds","isActive":true,"state":"findable","reason":null,"viewCount":0,"downloadCount":0,"referenceCount":0,"citationCount":0,"partCount":0,"partOfCount":0,"versionCount":0,"versionOfCount":0,"created":"2026-02-25T15:02:39Z","registered":"2026-02-25T15:02:40Z","published":null,"updated":"2026-02-25T15:02:40Z"},"relationships":{"client":{"data":{"id":"arxiv.content","type":"clients"}}}},{"id":"10.48550/arxiv.2602.19488","type":"dois","attributes":{"doi":"10.48550/arxiv.2602.19488","identifiers":[{"identifier":"2602.19488","identifierType":"arXiv"}],"creators":[{"nameType":"Personal","givenName":"Nicolas","familyName":"Langrené","name":"Langrené, Nicolas","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Rui","familyName":"Liu","name":"Liu, Rui","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Xiangqin","familyName":"Wu","name":"Wu, Xiangqin","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Tianhao","familyName":"Zhi","name":"Zhi, Tianhao","affiliation":[],"nameIdentifiers":[]}],"titles":[{"title":"The dynamics of innovation diffusion: A survey of Bass-type models"}],"publisher":"arXiv","container":{},"publicationYear":2026,"subjects":[{"subject":"General Economics (econ.GN)","lang":"en","subjectScheme":"arXiv"},{"subject":"FOS: Economics and business","subjectScheme":"Fields of Science and Technology (FOS)"},{"schemeUri":"http://www.oecd.org/science/inno/38235147.pdf","subject":"FOS: Economics and business","subjectScheme":"Fields of Science and Technology (FOS)"}],"contributors":[],"dates":[{"date":"2026-02-23T04:12:33Z","dateType":"Submitted","dateInformation":"v1"},{"date":"2026-02-24T02:08:49Z","dateType":"Updated","dateInformation":"v1"},{"date":"2026-02","dateType":"Available","dateInformation":"v1"},{"date":"2026","dateType":"Issued"}],"language":null,"types":{"schemaOrg":"CreativeWork","resourceTypeGeneral":"Preprint","citeproc":"article","bibtex":"misc","ris":"GEN","resourceType":"Article"},"relatedIdentifiers":[],"relatedItems":[],"sizes":[],"formats":[],"version":"1","rightsList":[{"rightsIdentifierScheme":"SPDX","rightsUri":"https://creativecommons.org/licenses/by/4.0/legalcode","schemeUri":"https://spdx.org/licenses/","rights":"Creative Commons Attribution 4.0 International","rightsIdentifier":"cc-by-4.0"}],"descriptions":[{"descriptionType":"Abstract","description":"This paper synthesises the existing research on the dynamics of innovation diffusion, with a focus on Bass-type models and their extensions. The theoretical foundation of innovation diffusion proposed by Rogers (1962) and the seminal work of Bass (1969) serve as a starting point for the analysis. We identify and examine various generalizations and stochastic extensions of the Bass model, including counting processes, diffusion processes, and uncertain processes, as well as parameter estimation techniques, from classical statistical techniques to more advanced techniques such as Bayesian filtering and metaheuristic optimisation. We finally explore alternative models of innovation diffusion, with a particular focus on agent-based models. This overview of the evolution of Bass-type models illustrates the progress made in innovation diffusion research over the past decades."},{"descriptionType":"Other","description":"26 pages, 2 figures"}],"geoLocations":[],"fundingReferences":[],"url":"https://arxiv.org/abs/2602.19488","contentUrl":null,"metadataVersion":0,"schemaVersion":"http://datacite.org/schema/kernel-4","source":"mds","isActive":true,"state":"findable","reason":null,"viewCount":0,"downloadCount":0,"referenceCount":0,"citationCount":0,"partCount":0,"partOfCount":0,"versionCount":0,"versionOfCount":0,"created":"2026-02-25T15:02:32Z","registered":"2026-02-25T15:02:32Z","published":null,"updated":"2026-02-25T15:02:32Z"},"relationships":{"client":{"data":{"id":"arxiv.content","type":"clients"}}}},{"id":"10.48550/arxiv.2602.19486","type":"dois","attributes":{"doi":"10.48550/arxiv.2602.19486","identifiers":[{"identifier":"2602.19486","identifierType":"arXiv"}],"creators":[{"nameType":"Personal","givenName":"Xinyi","familyName":"Yi","name":"Yi, Xinyi","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Ioannis","familyName":"Lestas","name":"Lestas, Ioannis","affiliation":[],"nameIdentifiers":[]}],"titles":[{"title":"A mixed Hinfty-Passivity approach for Leveraging District Heating Systems as Frequency Ancillary Service in Electric Power Systems"}],"publisher":"arXiv","container":{},"publicationYear":2026,"subjects":[{"subject":"Systems and Control (eess.SY)","lang":"en","subjectScheme":"arXiv"},{"subject":"Applications (stat.AP)","lang":"en","subjectScheme":"arXiv"},{"subject":"Methodology (stat.ME)","lang":"en","subjectScheme":"arXiv"},{"subject":"FOS: Electrical engineering, electronic engineering, information engineering","subjectScheme":"Fields of Science and Technology (FOS)"},{"schemeUri":"http://www.oecd.org/science/inno/38235147.pdf","subject":"FOS: Electrical engineering, electronic engineering, information engineering","subjectScheme":"Fields of Science and Technology (FOS)"},{"subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"},{"schemeUri":"http://www.oecd.org/science/inno/38235147.pdf","subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"}],"contributors":[],"dates":[{"date":"2026-02-23T04:03:09Z","dateType":"Submitted","dateInformation":"v1"},{"date":"2026-02-24T02:08:36Z","dateType":"Updated","dateInformation":"v1"},{"date":"2026-02","dateType":"Available","dateInformation":"v1"},{"date":"2026","dateType":"Issued"}],"language":null,"types":{"schemaOrg":"CreativeWork","resourceTypeGeneral":"Preprint","citeproc":"article","bibtex":"misc","ris":"GEN","resourceType":"Article"},"relatedIdentifiers":[],"relatedItems":[],"sizes":[],"formats":[],"version":"1","rightsList":[{"rightsUri":"http://arxiv.org/licenses/nonexclusive-distrib/1.0/","rights":"arXiv.org perpetual, non-exclusive license"}],"descriptions":[{"descriptionType":"Abstract","description":"This paper introduces a mixed H-infinity-passivity framework that enables district heating systems (DHSs) with heat pumps to support electric-grid frequency regulation. The analysis illustrates how the DHS regulator influences coupled electro-thermal frequency dynamics and provides LMI conditions for efficient controller design. We also present a disturbance-independent temperature regulator that ensures stability and robustness against heat-demand uncertainty. Simulations demonstrate improved frequency-control dynamics in the electrical power grid while maintaining good thermal performance in the DHS."}],"geoLocations":[],"fundingReferences":[],"url":"https://arxiv.org/abs/2602.19486","contentUrl":null,"metadataVersion":0,"schemaVersion":"http://datacite.org/schema/kernel-4","source":"mds","isActive":true,"state":"findable","reason":null,"viewCount":0,"downloadCount":0,"referenceCount":0,"citationCount":0,"partCount":0,"partOfCount":0,"versionCount":0,"versionOfCount":0,"created":"2026-02-25T15:02:27Z","registered":"2026-02-25T15:02:28Z","published":null,"updated":"2026-02-25T15:02:28Z"},"relationships":{"client":{"data":{"id":"arxiv.content","type":"clients"}}}},{"id":"10.48550/arxiv.2602.19485","type":"dois","attributes":{"doi":"10.48550/arxiv.2602.19485","identifiers":[{"identifier":"2602.19485","identifierType":"arXiv"}],"creators":[{"nameType":"Personal","givenName":"Angzi","familyName":"Xu","name":"Xu, Angzi","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Zezhong","familyName":"Zhang","name":"Zhang, Zezhong","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Zhi","familyName":"Liu","name":"Liu, Zhi","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Shuguang","familyName":"Cui","name":"Cui, Shuguang","affiliation":[],"nameIdentifiers":[]}],"titles":[{"title":"EMS-FL: Federated Tuning of Mixture-of-Experts in Satellite-Terrestrial Networks via Expert-Driven Model Splitting"}],"publisher":"arXiv","container":{},"publicationYear":2026,"subjects":[{"subject":"Networking and Internet Architecture (cs.NI)","lang":"en","subjectScheme":"arXiv"},{"subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"},{"schemeUri":"http://www.oecd.org/science/inno/38235147.pdf","subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"}],"contributors":[],"dates":[{"date":"2026-02-23T04:02:43Z","dateType":"Submitted","dateInformation":"v1"},{"date":"2026-02-24T02:08:35Z","dateType":"Updated","dateInformation":"v1"},{"date":"2026-02","dateType":"Available","dateInformation":"v1"},{"date":"2026","dateType":"Issued"}],"language":null,"types":{"schemaOrg":"CreativeWork","resourceTypeGeneral":"Preprint","citeproc":"article","bibtex":"misc","ris":"GEN","resourceType":"Article"},"relatedIdentifiers":[],"relatedItems":[],"sizes":[],"formats":[],"version":"1","rightsList":[{"rightsUri":"http://arxiv.org/licenses/nonexclusive-distrib/1.0/","rights":"arXiv.org perpetual, non-exclusive license"}],"descriptions":[{"descriptionType":"Abstract","description":"The rapid advancement of large AI models imposes stringent demands on data volume and computational resources. Federated learning, though designed to exploit distributed data and computational resources, faces data shortage from limited network coverage and computational constraints from edge devices. To address these issues, both the mixture-of-experts (MoE) and satellite-terrestrial network (STN) provide promising solutions, offering lightweight computation overhead and broad coverage, respectively. However, the satellite-ground relative motion results in intermittent connectivity, hindering conventional federated learning that relies on model synchronization across devices. To leverage the coverage of STN while preserving training efficiency, we propose EMS-FL, an expert-driven model splitting and federated learning method. EMS-FL assigns each device cluster only the experts highly correlated to their local data. Through non-overlapping expert assignments, asynchronous local learning is further proposed, where each device cluster trains its assigned experts consecutively and only uploads local parameters to the satellite during connected phases for aggregation and model updates. Consequently, EMS-FL effectively reduces the training overhead and achieves both faster convergence and higher accuracy compared with conventional federated learning. Rigorous convergence analysis is provided to theoretically characterize the learning performance. Furthermore, comprehensive experiments are conducted using public datasets and large models, validating the superiority of EMS-FL."},{"descriptionType":"Other","description":"Submitted to IEEE TMC"}],"geoLocations":[],"fundingReferences":[],"url":"https://arxiv.org/abs/2602.19485","contentUrl":null,"metadataVersion":0,"schemaVersion":"http://datacite.org/schema/kernel-4","source":"mds","isActive":true,"state":"findable","reason":null,"viewCount":0,"downloadCount":0,"referenceCount":0,"citationCount":0,"partCount":0,"partOfCount":0,"versionCount":0,"versionOfCount":0,"created":"2026-02-25T15:02:24Z","registered":"2026-02-25T15:02:25Z","published":null,"updated":"2026-02-25T15:02:25Z"},"relationships":{"client":{"data":{"id":"arxiv.content","type":"clients"}}}},{"id":"10.48550/arxiv.2602.19484","type":"dois","attributes":{"doi":"10.48550/arxiv.2602.19484","identifiers":[{"identifier":"2602.19484","identifierType":"arXiv"}],"creators":[{"nameType":"Personal","givenName":"Miles","familyName":"Waugh","name":"Waugh, Miles","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Chuwei","familyName":"Wang","name":"Wang, Chuwei","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Radu","familyName":"Andrei","name":"Andrei, Radu","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Nusair","familyName":"Islam","name":"Islam, Nusair","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Taylor Lee","familyName":"Patti","name":"Patti, Taylor Lee","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Eugene","familyName":"Demler","name":"Demler, Eugene","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Anima","familyName":"Anandkumar","name":"Anandkumar, Anima","affiliation":[],"nameIdentifiers":[]}],"titles":[{"title":"Toward the Thermodynamic Limit: Neural Operators for Non-equilibrium Dynamics of Mott Insulators"}],"publisher":"arXiv","container":{},"publicationYear":2026,"subjects":[{"subject":"Strongly Correlated Electrons (cond-mat.str-el)","lang":"en","subjectScheme":"arXiv"},{"subject":"FOS: Physical sciences","subjectScheme":"Fields of Science and Technology (FOS)"},{"schemeUri":"http://www.oecd.org/science/inno/38235147.pdf","subject":"FOS: Physical sciences","subjectScheme":"Fields of Science and Technology (FOS)"}],"contributors":[],"dates":[{"date":"2026-02-23T04:02:09Z","dateType":"Submitted","dateInformation":"v1"},{"date":"2026-02-24T02:08:34Z","dateType":"Updated","dateInformation":"v1"},{"date":"2026-02","dateType":"Available","dateInformation":"v1"},{"date":"2026","dateType":"Issued"}],"language":null,"types":{"schemaOrg":"CreativeWork","resourceTypeGeneral":"Preprint","citeproc":"article","bibtex":"misc","ris":"GEN","resourceType":"Article"},"relatedIdentifiers":[],"relatedItems":[],"sizes":[],"formats":[],"version":"1","rightsList":[{"rightsUri":"http://arxiv.org/licenses/nonexclusive-distrib/1.0/","rights":"arXiv.org perpetual, non-exclusive license"}],"descriptions":[{"descriptionType":"Abstract","description":"Mott insulators exhibit complex photoexcitation dynamics under intense optical driving, with potential implications for carrier multiplication beyond the Shockley-Queisser limit. Probing these nonequilibrium processes requires access to the thermodynamic limit, where the number of lattice sites becomes arbitrarily large, but conventional solvers are constrained to small systems due to the exponential growth of the Hilbert space. Fourier Neural Operators (FNOs), originally developed for solving partial differential equations, naturally accommodate inputs of varying resolution and are capable of capturing nonlocal effects. Here, we employ FNOs to learn the mapping from noise-perturbed ground-state momentum distributions to their post-pulse counterparts across a range of interaction strengths and driving parameters. Trained only on small lattices, the model generalizes zero-shot to much larger systems, producing physically reasonable momentum distributions well beyond the reach of numerical solvers. Specifically, the model can predict momentum distribution for a 1024x1024 system within a few seconds that matches the theoretical behavior of key observables, whereas direct numerical simulations have so far been restricted to edge sizes of ~30. These results demonstrate the potential of neural operators to directly access large-scale nonequilibrium dynamics, providing a new pathway toward the thermodynamic limit in strongly correlated materials."}],"geoLocations":[],"fundingReferences":[],"url":"https://arxiv.org/abs/2602.19484","contentUrl":null,"metadataVersion":0,"schemaVersion":"http://datacite.org/schema/kernel-4","source":"mds","isActive":true,"state":"findable","reason":null,"viewCount":0,"downloadCount":0,"referenceCount":0,"citationCount":0,"partCount":0,"partOfCount":0,"versionCount":0,"versionOfCount":0,"created":"2026-02-25T15:02:22Z","registered":"2026-02-25T15:02:23Z","published":null,"updated":"2026-02-25T15:02:23Z"},"relationships":{"client":{"data":{"id":"arxiv.content","type":"clients"}}}},{"id":"10.48550/arxiv.2602.19481","type":"dois","attributes":{"doi":"10.48550/arxiv.2602.19481","identifiers":[{"identifier":"2602.19481","identifierType":"arXiv"}],"creators":[{"nameType":"Personal","givenName":"Victor H.","familyName":"de la Pena","name":"de la Pena, Victor H.","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Fangyuan","familyName":"Lin","name":"Lin, Fangyuan","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Victor K.","familyName":"de la Pena","name":"de la Pena, Victor K.","affiliation":[],"nameIdentifiers":[]}],"titles":[{"title":"A Selection Premium Decomposition for the Expected Maximum of Random Walks"}],"publisher":"arXiv","container":{},"publicationYear":2026,"subjects":[{"subject":"Statistics Theory (math.ST)","lang":"en","subjectScheme":"arXiv"},{"subject":"FOS: Mathematics","subjectScheme":"Fields of Science and Technology (FOS)"},{"schemeUri":"http://www.oecd.org/science/inno/38235147.pdf","subject":"FOS: Mathematics","subjectScheme":"Fields of Science and Technology (FOS)"},{"subject":"60G50, 60E15, 62F07","lang":"en","subjectScheme":"MSC"}],"contributors":[],"dates":[{"date":"2026-02-23T03:51:05Z","dateType":"Submitted","dateInformation":"v1"},{"date":"2026-02-24T02:08:28Z","dateType":"Updated","dateInformation":"v1"},{"date":"2026-02","dateType":"Available","dateInformation":"v1"},{"date":"2026","dateType":"Issued"}],"language":null,"types":{"schemaOrg":"CreativeWork","resourceTypeGeneral":"Preprint","citeproc":"article","bibtex":"misc","ris":"GEN","resourceType":"Article"},"relatedIdentifiers":[],"relatedItems":[],"sizes":[],"formats":[],"version":"1","rightsList":[{"rightsUri":"http://arxiv.org/licenses/nonexclusive-distrib/1.0/","rights":"arXiv.org perpetual, non-exclusive license"}],"descriptions":[{"descriptionType":"Abstract","description":"When $K$ models are evaluated on the same validation set of size $n$, the selected winner's apparent performance is biased upward. Suppose $K$ models are evaluated on a shared sequence of i.i.d. observations $X_1,\\dots, X_n$, where model $k$ achieves response $f_k(X_i)$ with mean $μ_k = \\mathbb E[f_k(X)]$. Writing $Y_{i,k} = f_k(X_i)-μ_k$ for the centered increment and $S_{n,k} = \\sum_{i=1}^n Y_{i,k}$ for the centered cumulative score, the expected maximum satisfies $0\\le\\mathbb E\\bigl[\\max_k S_{n,k}\\bigr] = \\sum_{i=1}^n \\mathbb E\\bigl[φ_K(S_{i-1})\\bigr]$ where $φ_K(u) = \\mathbb{E}\\bigl[\\max_k(u_k + Y_k)\\bigr] - \\max_k u_k$, $u\\in \\mathbb R^K$, is the selection premium function. This formula corresponds to the null hypothesis case (all models are equal in the sense that they have the same mean), which clarifies that the bias arises from selection. While this decomposition follows from elementary conditioning and telescoping, we develop the analytical consequences in five directions. (i) structural properties of $φ_K$; (ii) extension to stopping times, recovering Wald's equation at $K=1$; (iii) a winner's curse decomposition for heterogeneous means; (iv) a universal bias concentration law showing that the first $α$-fraction of observations generates a $\\sqrtα$-fraction of total bias."}],"geoLocations":[],"fundingReferences":[],"url":"https://arxiv.org/abs/2602.19481","contentUrl":null,"metadataVersion":0,"schemaVersion":"http://datacite.org/schema/kernel-4","source":"mds","isActive":true,"state":"findable","reason":null,"viewCount":0,"downloadCount":0,"referenceCount":0,"citationCount":0,"partCount":0,"partOfCount":0,"versionCount":0,"versionOfCount":0,"created":"2026-02-25T15:02:14Z","registered":"2026-02-25T15:02:15Z","published":null,"updated":"2026-02-25T15:02:15Z"},"relationships":{"client":{"data":{"id":"arxiv.content","type":"clients"}}}},{"id":"10.48550/arxiv.2602.19480","type":"dois","attributes":{"doi":"10.48550/arxiv.2602.19480","identifiers":[{"identifier":"2602.19480","identifierType":"arXiv"}],"creators":[{"nameType":"Personal","givenName":"Jiaqi","familyName":"Wang","name":"Wang, Jiaqi","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Dongyan","familyName":"Fu","name":"Fu, Dongyan","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Yubing","familyName":"Dong","name":"Dong, Yubing","affiliation":[],"nameIdentifiers":[]}],"titles":[{"title":"Form factors of $Δ$(1232) and the electromagnetic $N-Δ$ transition"}],"publisher":"arXiv","container":{},"publicationYear":2026,"subjects":[{"subject":"High Energy Physics - Phenomenology (hep-ph)","lang":"en","subjectScheme":"arXiv"},{"subject":"FOS: Physical sciences","subjectScheme":"Fields of Science and Technology (FOS)"},{"schemeUri":"http://www.oecd.org/science/inno/38235147.pdf","subject":"FOS: Physical sciences","subjectScheme":"Fields of Science and Technology (FOS)"}],"contributors":[],"dates":[{"date":"2026-02-23T03:51:01Z","dateType":"Submitted","dateInformation":"v1"},{"date":"2026-02-24T02:08:27Z","dateType":"Updated","dateInformation":"v1"},{"date":"2026-02","dateType":"Available","dateInformation":"v1"},{"date":"2026","dateType":"Issued"}],"language":null,"types":{"schemaOrg":"CreativeWork","resourceTypeGeneral":"Preprint","citeproc":"article","bibtex":"misc","ris":"GEN","resourceType":"Article"},"relatedIdentifiers":[],"relatedItems":[],"sizes":[],"formats":[],"version":"1","rightsList":[{"rightsUri":"http://arxiv.org/licenses/nonexclusive-distrib/1.0/","rights":"arXiv.org perpetual, non-exclusive license"}],"descriptions":[{"descriptionType":"Abstract","description":"In this work, the electromagnetic and gravitational form factors of $Δ$ isobars, as well as the electromagnetic $N-Δ$ transition form factors are studied systematically and continuously using a covariant quark-diquark approach with the pion cloud effect. In our model, the baryon is treated as the two-body system to simplify calculations, and the quarks are assumed to be surrounded by the pion cloud. The related physical properties, such as the charge radius and magnetic moment of $Δ$ and the helicity amplitudes of the $N-Δ$ transition are obtained and discussed. Our results for the form factors of both $Δ$(1232) and the electromagnetic $N-Δ$ transition are in reasonable agreement with the experimental or lattice results. Moreover, we found that the pion cloud plays an important role in the results through enlarging the magnetic transition form factor $G_M(t)$ and shifting the sign of the D-term of $Δ$ to negative."},{"descriptionType":"Other","description":"20 pages, 9 figures, 7 tables"}],"geoLocations":[],"fundingReferences":[],"url":"https://arxiv.org/abs/2602.19480","contentUrl":null,"metadataVersion":0,"schemaVersion":"http://datacite.org/schema/kernel-4","source":"mds","isActive":true,"state":"findable","reason":null,"viewCount":0,"downloadCount":0,"referenceCount":0,"citationCount":0,"partCount":0,"partOfCount":0,"versionCount":0,"versionOfCount":0,"created":"2026-02-25T15:02:12Z","registered":"2026-02-25T15:02:13Z","published":null,"updated":"2026-02-25T15:02:13Z"},"relationships":{"client":{"data":{"id":"arxiv.content","type":"clients"}}}},{"id":"10.48550/arxiv.2602.19479","type":"dois","attributes":{"doi":"10.48550/arxiv.2602.19479","identifiers":[{"identifier":"2602.19479","identifierType":"arXiv"}],"creators":[{"nameType":"Personal","givenName":"Matheus","familyName":"Hostert","name":"Hostert, Matheus","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Maxim","familyName":"Pospelov","name":"Pospelov, Maxim","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Adrian","familyName":"Thompson","name":"Thompson, Adrian","affiliation":[],"nameIdentifiers":[]}],"titles":[{"title":"Kaon decay constraints on vector bosons coupled to non-conserved currents"}],"publisher":"arXiv","container":{},"publicationYear":2026,"subjects":[{"subject":"High Energy Physics - Phenomenology (hep-ph)","lang":"en","subjectScheme":"arXiv"},{"subject":"High Energy Physics - Experiment (hep-ex)","lang":"en","subjectScheme":"arXiv"},{"subject":"FOS: Physical sciences","subjectScheme":"Fields of Science and Technology (FOS)"},{"schemeUri":"http://www.oecd.org/science/inno/38235147.pdf","subject":"FOS: Physical sciences","subjectScheme":"Fields of Science and Technology (FOS)"}],"contributors":[],"dates":[{"date":"2026-02-23T03:48:16Z","dateType":"Submitted","dateInformation":"v1"},{"date":"2026-02-24T02:08:18Z","dateType":"Updated","dateInformation":"v1"},{"date":"2026-02","dateType":"Available","dateInformation":"v1"},{"date":"2026","dateType":"Issued"}],"language":null,"types":{"schemaOrg":"CreativeWork","resourceTypeGeneral":"Preprint","citeproc":"article","bibtex":"misc","ris":"GEN","resourceType":"Article"},"relatedIdentifiers":[],"relatedItems":[],"sizes":[],"formats":[],"version":"1","rightsList":[{"rightsIdentifierScheme":"SPDX","rightsUri":"https://creativecommons.org/licenses/by/4.0/legalcode","schemeUri":"https://spdx.org/licenses/","rights":"Creative Commons Attribution 4.0 International","rightsIdentifier":"cc-by-4.0"}],"descriptions":[{"descriptionType":"Abstract","description":"We study rare three- and four-body kaon decays as a probe of light vector and axial-vector bosons coupled to non-conserved currents. We find that searches for $K_L \\to π^0 π^0 (X\\to e^+e^-)$ decays constrain the couplings of light $X$ bosons to light quarks to be as small as $\\mathcal{O}(10^{-5})$. The charged-pion modes $K^+ \\to π^+ π^0 (X \\to e^+e^-)$ and $K_L \\to π^+ π^- (X \\to e^+e^-)$ provide weaker limits, but constrain complementary combinations of couplings to the $u$, $d$, and $s$ quarks at the level of $\\mathcal{O}(10^{-4})$. Finally, we also find that double emission of $X$ in $K \\to πXX$ decays can provide yet additional constraints on the parameter space of light $X$ bosons due to a double $(m_K/m_X)^2$ enhancement to the rate. For a 17 MeV boson, these limits add to the known tension between spin-1 bosons coupled to vector and axial-vector currents interpretations of the results of the ATOMKI experiment with meson decay data. Finally, we also comment on negative pion capture on hydrogen and deuterium as a source of light particles and discuss the prospects for testing the 17 MeV boson hypothesis."},{"descriptionType":"Other","description":"16 pages, 7 figures"}],"geoLocations":[],"fundingReferences":[],"url":"https://arxiv.org/abs/2602.19479","contentUrl":null,"metadataVersion":0,"schemaVersion":"http://datacite.org/schema/kernel-4","source":"mds","isActive":true,"state":"findable","reason":null,"viewCount":0,"downloadCount":0,"referenceCount":0,"citationCount":0,"partCount":0,"partOfCount":0,"versionCount":0,"versionOfCount":0,"created":"2026-02-25T15:02:09Z","registered":"2026-02-25T15:02:10Z","published":null,"updated":"2026-02-25T15:02:10Z"},"relationships":{"client":{"data":{"id":"arxiv.content","type":"clients"}}}},{"id":"10.48550/arxiv.2602.19475","type":"dois","attributes":{"doi":"10.48550/arxiv.2602.19475","identifiers":[{"identifier":"2602.19475","identifierType":"arXiv"}],"creators":[{"nameType":"Personal","givenName":"Pao-Hsiung","familyName":"Chiu","name":"Chiu, Pao-Hsiung","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Jian Cheng","familyName":"Wong","name":"Wong, Jian Cheng","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Chin Chun","familyName":"Ooi","name":"Ooi, Chin Chun","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Chang","familyName":"Wei","name":"Wei, Chang","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Yuchen","familyName":"Fan","name":"Fan, Yuchen","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Yew-Soon","familyName":"Ong","name":"Ong, Yew-Soon","affiliation":[],"nameIdentifiers":[]}],"titles":[{"title":"Scale-PINN: Learning Efficient Physics-Informed Neural Networks Through Sequential Correction"}],"publisher":"arXiv","container":{},"publicationYear":2026,"subjects":[{"subject":"Computational Engineering, Finance, and Science (cs.CE)","lang":"en","subjectScheme":"arXiv"},{"subject":"Artificial Intelligence (cs.AI)","lang":"en","subjectScheme":"arXiv"},{"subject":"Machine Learning (cs.LG)","lang":"en","subjectScheme":"arXiv"},{"subject":"Computational Physics (physics.comp-ph)","lang":"en","subjectScheme":"arXiv"},{"subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"},{"schemeUri":"http://www.oecd.org/science/inno/38235147.pdf","subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"},{"subject":"FOS: Physical sciences","subjectScheme":"Fields of Science and Technology (FOS)"},{"schemeUri":"http://www.oecd.org/science/inno/38235147.pdf","subject":"FOS: Physical sciences","subjectScheme":"Fields of Science and Technology (FOS)"}],"contributors":[],"dates":[{"date":"2026-02-23T03:38:06Z","dateType":"Submitted","dateInformation":"v1"},{"date":"2026-02-24T02:07:55Z","dateType":"Updated","dateInformation":"v1"},{"date":"2026-02","dateType":"Available","dateInformation":"v1"},{"date":"2026","dateType":"Issued"}],"language":null,"types":{"schemaOrg":"CreativeWork","resourceTypeGeneral":"Preprint","citeproc":"article","bibtex":"misc","ris":"GEN","resourceType":"Article"},"relatedIdentifiers":[],"relatedItems":[],"sizes":[],"formats":[],"version":"1","rightsList":[{"rightsIdentifierScheme":"SPDX","rightsUri":"https://creativecommons.org/licenses/by/4.0/legalcode","schemeUri":"https://spdx.org/licenses/","rights":"Creative Commons Attribution 4.0 International","rightsIdentifier":"cc-by-4.0"}],"descriptions":[{"descriptionType":"Abstract","description":"Physics-informed neural networks (PINNs) have emerged as a promising mesh-free paradigm for solving partial differential equations, yet adoption in science and engineering is limited by slow training and modest accuracy relative to modern numerical solvers. We introduce the Sequential Correction Algorithm for Learning Efficient PINN (Scale-PINN), a learning strategy that bridges modern physics-informed learning with numerical algorithms. Scale-PINN incorporates the iterative residual-correction principle, a cornerstone of numerical solvers, directly into the loss formulation, marking a paradigm shift in how PINN losses can be conceived and constructed. This integration enables Scale-PINN to achieve unprecedented convergence speed across PDE problems from different physics domain, including reducing training time on a challenging fluid-dynamics problem for state-of-the-art PINN from hours to sub-2 minutes while maintaining superior accuracy, and enabling application to representative problems in aerodynamics and urban science. By uniting the rigor of numerical methods with the flexibility of deep learning, Scale-PINN marks a significant leap toward the practical adoption of PINNs in science and engineering through scalable, physics-informed learning. Codes are available at https://github.com/chiuph/SCALE-PINN."}],"geoLocations":[],"fundingReferences":[],"url":"https://arxiv.org/abs/2602.19475","contentUrl":null,"metadataVersion":0,"schemaVersion":"http://datacite.org/schema/kernel-4","source":"mds","isActive":true,"state":"findable","reason":null,"viewCount":0,"downloadCount":0,"referenceCount":0,"citationCount":0,"partCount":0,"partOfCount":0,"versionCount":0,"versionOfCount":0,"created":"2026-02-25T15:01:59Z","registered":"2026-02-25T15:02:00Z","published":null,"updated":"2026-02-25T15:02:00Z"},"relationships":{"client":{"data":{"id":"arxiv.content","type":"clients"}}}},{"id":"10.48550/arxiv.2602.19472","type":"dois","attributes":{"doi":"10.48550/arxiv.2602.19472","identifiers":[{"identifier":"2602.19472","identifierType":"arXiv"}],"creators":[{"nameType":"Personal","givenName":"Hua","familyName":"Zhou","name":"Zhou, Hua","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Lei","familyName":"Chang","name":"Chang, Lei","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"GuoSheng","familyName":"Xu","name":"Xu, GuoSheng","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"YiWei","familyName":"Zhang","name":"Zhang, YiWei","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Matthew","familyName":"Hole","name":"Hole, Matthew","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Dan","familyName":"Du","name":"Du, Dan","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"ZhiSong","familyName":"Qu","name":"Qu, ZhiSong","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"MuQuan","familyName":"Wu","name":"Wu, MuQuan","affiliation":[],"nameIdentifiers":[]}],"titles":[{"title":"Three Dimensional Multiphysics Modelling of Helicon Wave Heating and Antenna Plasma Coupling for Boundary Density Control in Toroidal Fusion Plasmas"}],"publisher":"arXiv","container":{},"publicationYear":2026,"subjects":[{"subject":"Plasma Physics (physics.plasm-ph)","lang":"en","subjectScheme":"arXiv"},{"subject":"FOS: Physical sciences","subjectScheme":"Fields of Science and Technology (FOS)"},{"schemeUri":"http://www.oecd.org/science/inno/38235147.pdf","subject":"FOS: Physical sciences","subjectScheme":"Fields of Science and Technology (FOS)"}],"contributors":[],"dates":[{"date":"2026-02-23T03:31:03Z","dateType":"Submitted","dateInformation":"v1"},{"date":"2026-02-24T02:07:44Z","dateType":"Updated","dateInformation":"v1"},{"date":"2026-02","dateType":"Available","dateInformation":"v1"},{"date":"2026","dateType":"Issued"}],"language":null,"types":{"schemaOrg":"CreativeWork","resourceTypeGeneral":"Preprint","citeproc":"article","bibtex":"misc","ris":"GEN","resourceType":"Article"},"relatedIdentifiers":[],"relatedItems":[],"sizes":[],"formats":[],"version":"1","rightsList":[{"rightsIdentifierScheme":"SPDX","rightsUri":"https://creativecommons.org/licenses/by/4.0/legalcode","schemeUri":"https://spdx.org/licenses/","rights":"Creative Commons Attribution 4.0 International","rightsIdentifier":"cc-by-4.0"}],"descriptions":[{"descriptionType":"Abstract","description":"Active control of scrape off layer density is emerging as a critical requirement for improving ion cyclotron resonance heating and enabling high performance steady state operation in future magnetic confinement fusion devices. Helicon wave excitation offers a promising physics based approach to generating high density boundary plasmas with high ionization efficiency and low impurity release. In this work, we develop THEMIS code, a fully three dimensional (3D) multiphysics model of helicon wave propagation and power deposition in a toroidal fusion relevant configuration, employing a finite temperature thermal dielectric tensor. The code quantifies the relative contributions of Doppler shifted cyclotron damping, anomalous Doppler damping, collisional damping, and Landau damping, and demonstrates that slow wave propagation and electron Landau damping dominate the accessible heating regime in Helimak device. A comparative study of four planar antenna geometries under the present protruding window configuration shows that geometric cutoffs and SOL density gradients severely limit power penetration into the core accessible region. To address this constraint, we introduce a recessed window launch scheme that positions the dielectric window inside the vacuum vessel and perform systematic parameter scans of window position, antenna geometry, and installation orientation. From these analyses, we identify the key physics driven principles governing efficient helicon wave coupling: the importance of open circuit termination, maximized strap length and width, controlled inter turn spacing, and sufficient clearance from metallic walls to avoid near field suppression. Guided by these principles, we designed an optimized racetrack spiral antenna that increases coupling efficiency by more than an order of magnitude compared with conventional short circuited rectangular spiral antenna."}],"geoLocations":[],"fundingReferences":[],"url":"https://arxiv.org/abs/2602.19472","contentUrl":null,"metadataVersion":0,"schemaVersion":"http://datacite.org/schema/kernel-4","source":"mds","isActive":true,"state":"findable","reason":null,"viewCount":0,"downloadCount":0,"referenceCount":0,"citationCount":0,"partCount":0,"partOfCount":0,"versionCount":0,"versionOfCount":0,"created":"2026-02-25T15:01:52Z","registered":"2026-02-25T15:01:52Z","published":null,"updated":"2026-02-25T15:01:52Z"},"relationships":{"client":{"data":{"id":"arxiv.content","type":"clients"}}}},{"id":"10.48550/arxiv.2602.19469","type":"dois","attributes":{"doi":"10.48550/arxiv.2602.19469","identifiers":[{"identifier":"2602.19469","identifierType":"arXiv"}],"creators":[{"nameType":"Personal","givenName":"Robert","familyName":"Griffiths","name":"Griffiths, Robert","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Shuhei","familyName":"Mano","name":"Mano, Shuhei","affiliation":[],"nameIdentifiers":[]}],"titles":[{"title":"A Class of Gaussian Fields on $\\mathbb{Z}_q^d$"}],"publisher":"arXiv","container":{},"publicationYear":2026,"subjects":[{"subject":"Probability (math.PR)","lang":"en","subjectScheme":"arXiv"},{"subject":"FOS: Mathematics","subjectScheme":"Fields of Science and Technology (FOS)"},{"schemeUri":"http://www.oecd.org/science/inno/38235147.pdf","subject":"FOS: Mathematics","subjectScheme":"Fields of Science and Technology (FOS)"},{"subject":"60G07","lang":"en","subjectScheme":"MSC"}],"contributors":[],"dates":[{"date":"2026-02-23T03:28:25Z","dateType":"Submitted","dateInformation":"v1"},{"date":"2026-02-24T02:07:40Z","dateType":"Updated","dateInformation":"v1"},{"date":"2026-02","dateType":"Available","dateInformation":"v1"},{"date":"2026","dateType":"Issued"}],"language":null,"types":{"schemaOrg":"CreativeWork","resourceTypeGeneral":"Preprint","citeproc":"article","bibtex":"misc","ris":"GEN","resourceType":"Article"},"relatedIdentifiers":[],"relatedItems":[],"sizes":[],"formats":[],"version":"1","rightsList":[{"rightsIdentifierScheme":"SPDX","rightsUri":"https://creativecommons.org/licenses/by/4.0/legalcode","schemeUri":"https://spdx.org/licenses/","rights":"Creative Commons Attribution 4.0 International","rightsIdentifier":"cc-by-4.0"}],"descriptions":[{"descriptionType":"Abstract","description":"Gaussian fields $(g_x)$ on $\\mathbb{Z}_q^d$ are constructed from a class of reversible long range random walks $(X_t)_{t\\in \\mathbb{N}}$ on $\\mathbb{Z}_q^d$ in arXiv:2510.22554. The construction is from taking the covariance function of $(g_x)$ as $(1-α)G(x,y;α)$, where $G(x,y;α)$ is the Green function of a random walk with killing in each transition at rate $1-α$. A decomposition of the Gaussian field into a sum of independent Gaussian random variables is made. By letting $q\\to \\infty$ the Gaussian field becomes defined from an infinite-dimensional random walk on a torus. The random walk model is also extended to $d=\\infty$ by considering a de Finetti random walk where entries in the increments of the random walk are exchangeable. A limit Gaussian field on $\\mathbb{R}^d$ arises from a central limit theorem approach. The transform of this Gaussian field, which is again a Gaussian field, is calculated. It has a simpler covariance matrix than the original field. The Hamiltonian connected to the Gaussian field is calculated. A limit theorem for the partition function arising from the Hamiltonian is found."}],"geoLocations":[],"fundingReferences":[],"url":"https://arxiv.org/abs/2602.19469","contentUrl":null,"metadataVersion":0,"schemaVersion":"http://datacite.org/schema/kernel-4","source":"mds","isActive":true,"state":"findable","reason":null,"viewCount":0,"downloadCount":0,"referenceCount":0,"citationCount":0,"partCount":0,"partOfCount":0,"versionCount":0,"versionOfCount":0,"created":"2026-02-25T15:01:45Z","registered":"2026-02-25T15:01:45Z","published":null,"updated":"2026-02-25T15:01:45Z"},"relationships":{"client":{"data":{"id":"arxiv.content","type":"clients"}}}},{"id":"10.48550/arxiv.2602.19467","type":"dois","attributes":{"doi":"10.48550/arxiv.2602.19467","identifiers":[{"identifier":"2602.19467","identifierType":"arXiv"}],"creators":[{"nameType":"Personal","givenName":"Michael","familyName":"Haman","name":"Haman, Michael","affiliation":[],"nameIdentifiers":[]}],"titles":[{"title":"Can Large Language Models Replace Human Coders? Introducing ContentBench"}],"publisher":"arXiv","container":{},"publicationYear":2026,"subjects":[{"subject":"Computers and Society (cs.CY)","lang":"en","subjectScheme":"arXiv"},{"subject":"Artificial Intelligence (cs.AI)","lang":"en","subjectScheme":"arXiv"},{"subject":"Computation and Language (cs.CL)","lang":"en","subjectScheme":"arXiv"},{"subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"},{"schemeUri":"http://www.oecd.org/science/inno/38235147.pdf","subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"}],"contributors":[],"dates":[{"date":"2026-02-23T03:26:17Z","dateType":"Submitted","dateInformation":"v1"},{"date":"2026-02-24T02:07:35Z","dateType":"Updated","dateInformation":"v1"},{"date":"2026-02","dateType":"Available","dateInformation":"v1"},{"date":"2026","dateType":"Issued"}],"language":null,"types":{"schemaOrg":"CreativeWork","resourceTypeGeneral":"Preprint","citeproc":"article","bibtex":"misc","ris":"GEN","resourceType":"Article"},"relatedIdentifiers":[],"relatedItems":[],"sizes":[],"formats":[],"version":"1","rightsList":[{"rightsUri":"http://arxiv.org/licenses/nonexclusive-distrib/1.0/","rights":"arXiv.org perpetual, non-exclusive license"}],"descriptions":[{"descriptionType":"Abstract","description":"Can low-cost large language models (LLMs) take over the interpretive coding work that still anchors much of empirical content analysis? This paper introduces ContentBench, a public benchmark suite that helps answer this replacement question by tracking how much agreement low-cost LLMs achieve and what they cost on the same interpretive coding tasks. The suite uses versioned tracks that invite researchers to contribute new benchmark datasets. I report results from the first track, ContentBench-ResearchTalk v1.0: 1,000 synthetic, social-media-style posts about academic research labeled into five categories spanning praise, critique, sarcasm, questions, and procedural remarks. Reference labels are assigned only when three state-of-the-art reasoning models (GPT-5, Gemini 2.5 Pro, and Claude Opus 4.1) agree unanimously, and all final labels are checked by the author as a quality-control audit. Among the 59 evaluated models, the best low-cost LLMs reach roughly 97-99% agreement with these jury labels, far above GPT-3.5 Turbo, the model behind early ChatGPT and the initial wave of LLM-based text annotation. Several top models can code 50,000 posts for only a few dollars, pushing large-scale interpretive coding from a labor bottleneck toward questions of validation, reporting, and governance. At the same time, small open-weight models that run locally still struggle on sarcasm-heavy items (for example, Llama 3.2 3B reaches only 4% agreement on hard-sarcasm). ContentBench is released with data, documentation, and an interactive quiz at contentbench.github.io to support comparable evaluations over time and to invite community extensions."},{"descriptionType":"Other","description":"Project website: https://contentbench.github.io"}],"geoLocations":[],"fundingReferences":[],"url":"https://arxiv.org/abs/2602.19467","contentUrl":null,"metadataVersion":0,"schemaVersion":"http://datacite.org/schema/kernel-4","source":"mds","isActive":true,"state":"findable","reason":null,"viewCount":0,"downloadCount":0,"referenceCount":0,"citationCount":0,"partCount":0,"partOfCount":0,"versionCount":0,"versionOfCount":0,"created":"2026-02-25T15:01:40Z","registered":"2026-02-25T15:01:41Z","published":null,"updated":"2026-02-25T15:01:41Z"},"relationships":{"client":{"data":{"id":"arxiv.content","type":"clients"}}}},{"id":"10.48550/arxiv.2602.19465","type":"dois","attributes":{"doi":"10.48550/arxiv.2602.19465","identifiers":[{"identifier":"2602.19465","identifierType":"arXiv"}],"creators":[{"nameType":"Personal","givenName":"Miao","familyName":"Qi","name":"Qi, Miao","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Li-Li","familyName":"Chen","name":"Chen, Li-Li","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Li-Gang","familyName":"Cao","name":"Cao, Li-Gang","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Feng-Shou","familyName":"Zhang","name":"Zhang, Feng-Shou","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Xin-Le","familyName":"Shang","name":"Shang, Xin-Le","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Wei","familyName":"Zuo","name":"Zuo, Wei","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"U.","familyName":"Lombardo","name":"Lombardo, U.","affiliation":[],"nameIdentifiers":[]}],"titles":[{"title":"Microscopic Optical Potential from Brueckner-Hartree-Fock Theory"}],"publisher":"arXiv","container":{},"publicationYear":2026,"subjects":[{"subject":"Nuclear Theory (nucl-th)","lang":"en","subjectScheme":"arXiv"},{"subject":"FOS: Physical sciences","subjectScheme":"Fields of Science and Technology (FOS)"},{"schemeUri":"http://www.oecd.org/science/inno/38235147.pdf","subject":"FOS: Physical sciences","subjectScheme":"Fields of Science and Technology (FOS)"}],"contributors":[],"dates":[{"date":"2026-02-23T03:22:23Z","dateType":"Submitted","dateInformation":"v1"},{"date":"2026-02-24T02:07:26Z","dateType":"Updated","dateInformation":"v1"},{"date":"2026-02","dateType":"Available","dateInformation":"v1"},{"date":"2026","dateType":"Issued"}],"language":null,"types":{"schemaOrg":"CreativeWork","resourceTypeGeneral":"Preprint","citeproc":"article","bibtex":"misc","ris":"GEN","resourceType":"Article"},"relatedIdentifiers":[],"relatedItems":[],"sizes":[],"formats":[],"version":"1","rightsList":[{"rightsUri":"http://arxiv.org/licenses/nonexclusive-distrib/1.0/","rights":"arXiv.org perpetual, non-exclusive license"}],"descriptions":[{"descriptionType":"Abstract","description":"Modern Brueckner-Hartree-Fock (BHF) calculations are very successful in describing various properties of symmetric and asymmetric nuclear matter. Within BHF theory a microscopic optical potential (MOP) for nucleon-nucleus scattering is developed. First, we parametrize the energy and density dependence of complex optical potentials in nuclear matter based on BHF calculations and then we construct the MOP for finite nuclei with the local density approximation extended to include the finite-range effects. The density distribution and the spin-orbit contribution are calculated from the Hartree-Fock (HF) approximation with LNS5 Skyrme interaction, the latter being constrained by the BHF results. The central real and imaginary potentials turn out to be quantitatively consistent with the phenomenological global Koning-Delaroche (KD) potentials. The performance of MOP is evaluated by considering neutron/proton scattering on $^{40,48}$Ca. The elastic scattering differential cross sections, analyzing powers and total/reaction cross sections are analyzed in the energy below 200 MeV. A good agreement between the theoretical results and the measurements is achieved. Since our results are presented in the analytic forms, they can thus be used easily in the analysis of the experimental data of the nucleon scattering on exotic nuclei."},{"descriptionType":"Other","description":"14 pages, 8 figures, 5 tables"}],"geoLocations":[],"fundingReferences":[],"url":"https://arxiv.org/abs/2602.19465","contentUrl":null,"metadataVersion":0,"schemaVersion":"http://datacite.org/schema/kernel-4","source":"mds","isActive":true,"state":"findable","reason":null,"viewCount":0,"downloadCount":0,"referenceCount":0,"citationCount":0,"partCount":0,"partOfCount":0,"versionCount":0,"versionOfCount":0,"created":"2026-02-25T15:01:34Z","registered":"2026-02-25T15:01:35Z","published":null,"updated":"2026-02-25T15:01:36Z"},"relationships":{"client":{"data":{"id":"arxiv.content","type":"clients"}}}},{"id":"10.48550/arxiv.2602.19464","type":"dois","attributes":{"doi":"10.48550/arxiv.2602.19464","identifiers":[{"identifier":"2602.19464","identifierType":"arXiv"}],"creators":[{"nameType":"Personal","givenName":"Jie","familyName":"Wen","name":"Wen, Jie","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Benjian","familyName":"Lv","name":"Lv, Benjian","affiliation":[],"nameIdentifiers":[]}],"titles":[{"title":"On $r$-cross $t$-intersecting families of partitions"}],"publisher":"arXiv","container":{},"publicationYear":2026,"subjects":[{"subject":"Combinatorics (math.CO)","lang":"en","subjectScheme":"arXiv"},{"subject":"FOS: Mathematics","subjectScheme":"Fields of Science and Technology (FOS)"},{"schemeUri":"http://www.oecd.org/science/inno/38235147.pdf","subject":"FOS: Mathematics","subjectScheme":"Fields of Science and Technology (FOS)"},{"subject":"05D05","lang":"en","subjectScheme":"MSC"}],"contributors":[],"dates":[{"date":"2026-02-23T03:18:34Z","dateType":"Submitted","dateInformation":"v1"},{"date":"2026-02-24T02:07:21Z","dateType":"Updated","dateInformation":"v1"},{"date":"2026-02","dateType":"Available","dateInformation":"v1"},{"date":"2026","dateType":"Issued"}],"language":null,"types":{"schemaOrg":"CreativeWork","resourceTypeGeneral":"Preprint","citeproc":"article","bibtex":"misc","ris":"GEN","resourceType":"Article"},"relatedIdentifiers":[],"relatedItems":[],"sizes":[],"formats":[],"version":"1","rightsList":[{"rightsUri":"http://arxiv.org/licenses/nonexclusive-distrib/1.0/","rights":"arXiv.org perpetual, non-exclusive license"}],"descriptions":[{"descriptionType":"Abstract","description":"In this paper, we address several intersection problems for $r$-cross $t$-intersecting families of partitions. A $k$-partition of an $n$-set $X$ is a set of $k$ pairwise disjoint non-empty subsets whose union is $X$. For $1\\leq i\\leq r$, let $\\mathcal{F}_i$ be a family of $k_i$-partitions of $X$. We say that $\\mathcal{F}_1,\\mathcal{F}_2,\\ldots,\\mathcal{F}_r$ are $r$-cross $t$-intersecting if $|\\cap_{i=1}^{r}F_i|\\geq t$ for all $F_i\\in\\mathcal{F}_i$. The families are called non-trivial if $|\\cap_{i=1}^r(\\cap_{F\\in\\mathcal{F}_i}F)|"}],"geoLocations":[],"fundingReferences":[],"url":"https://arxiv.org/abs/2602.19464","contentUrl":null,"metadataVersion":0,"schemaVersion":"http://datacite.org/schema/kernel-4","source":"mds","isActive":true,"state":"findable","reason":null,"viewCount":0,"downloadCount":0,"referenceCount":0,"citationCount":0,"partCount":0,"partOfCount":0,"versionCount":0,"versionOfCount":0,"created":"2026-02-25T15:01:32Z","registered":"2026-02-25T15:01:33Z","published":null,"updated":"2026-02-25T15:01:33Z"},"relationships":{"client":{"data":{"id":"arxiv.content","type":"clients"}}}},{"id":"10.48550/arxiv.2602.19462","type":"dois","attributes":{"doi":"10.48550/arxiv.2602.19462","identifiers":[{"identifier":"2602.19462","identifierType":"arXiv"}],"creators":[{"nameType":"Personal","givenName":"Jinyuan","familyName":"Chang","name":"Chang, Jinyuan","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Yi","familyName":"Ding","name":"Ding, Yi","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Zhentao","familyName":"Shi","name":"Shi, Zhentao","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Bo","familyName":"Zhang","name":"Zhang, Bo","affiliation":[],"nameIdentifiers":[]}],"titles":[{"title":"Zero Variance Portfolio"}],"publisher":"arXiv","container":{},"publicationYear":2026,"subjects":[{"subject":"Methodology (stat.ME)","lang":"en","subjectScheme":"arXiv"},{"subject":"Statistics Theory (math.ST)","lang":"en","subjectScheme":"arXiv"},{"subject":"Applications (stat.AP)","lang":"en","subjectScheme":"arXiv"},{"subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"},{"schemeUri":"http://www.oecd.org/science/inno/38235147.pdf","subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"},{"subject":"FOS: Mathematics","subjectScheme":"Fields of Science and Technology (FOS)"},{"schemeUri":"http://www.oecd.org/science/inno/38235147.pdf","subject":"FOS: Mathematics","subjectScheme":"Fields of Science and Technology (FOS)"}],"contributors":[],"dates":[{"date":"2026-02-23T03:10:06Z","dateType":"Submitted","dateInformation":"v1"},{"date":"2026-02-24T02:07:15Z","dateType":"Updated","dateInformation":"v1"},{"date":"2026-02","dateType":"Available","dateInformation":"v1"},{"date":"2026","dateType":"Issued"}],"language":null,"types":{"schemaOrg":"CreativeWork","resourceTypeGeneral":"Preprint","citeproc":"article","bibtex":"misc","ris":"GEN","resourceType":"Article"},"relatedIdentifiers":[],"relatedItems":[],"sizes":[],"formats":[],"version":"1","rightsList":[{"rightsIdentifierScheme":"SPDX","rightsUri":"https://creativecommons.org/licenses/by/4.0/legalcode","schemeUri":"https://spdx.org/licenses/","rights":"Creative Commons Attribution 4.0 International","rightsIdentifier":"cc-by-4.0"}],"descriptions":[{"descriptionType":"Abstract","description":"When the number of assets is larger than the sample size, the minimum variance portfolio interpolates the training data, delivering pathological zero in-sample variance. We show that if the weights of the zero variance portfolio are learned by a novel ``Ridgelet'' estimator, in a new test data this portfolio enjoys out-of-sample generalizability. It exhibits the double descent phenomenon and can achieve optimal risk in the overparametrized regime when the number of assets dominates the sample size. In contrast, a ``Ridgeless'' estimator which invokes the pseudoinverse fails in-sample interpolation and diverges away from out-of-sample optimality. Extensive simulations and empirical studies demonstrate that the Ridgelet method performs competitively in high-dimensional portfolio optimization."}],"geoLocations":[],"fundingReferences":[],"url":"https://arxiv.org/abs/2602.19462","contentUrl":null,"metadataVersion":0,"schemaVersion":"http://datacite.org/schema/kernel-4","source":"mds","isActive":true,"state":"findable","reason":null,"viewCount":0,"downloadCount":0,"referenceCount":0,"citationCount":0,"partCount":0,"partOfCount":0,"versionCount":0,"versionOfCount":0,"created":"2026-02-25T15:01:27Z","registered":"2026-02-25T15:01:28Z","published":null,"updated":"2026-02-25T15:01:28Z"},"relationships":{"client":{"data":{"id":"arxiv.content","type":"clients"}}}},{"id":"10.48550/arxiv.2602.19461","type":"dois","attributes":{"doi":"10.48550/arxiv.2602.19461","identifiers":[{"identifier":"2602.19461","identifierType":"arXiv"}],"creators":[{"nameType":"Personal","givenName":"Zelin","familyName":"Zhao","name":"Zhao, Zelin","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Petr","familyName":"Molodyk","name":"Molodyk, Petr","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Haotian","familyName":"Xue","name":"Xue, Haotian","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Yongxin","familyName":"Chen","name":"Chen, Yongxin","affiliation":[],"nameIdentifiers":[]}],"titles":[{"title":"Laplacian Multi-scale Flow Matching for Generative Modeling"}],"publisher":"arXiv","container":{},"publicationYear":2026,"subjects":[{"subject":"Computer Vision and Pattern Recognition (cs.CV)","lang":"en","subjectScheme":"arXiv"},{"subject":"Machine Learning (cs.LG)","lang":"en","subjectScheme":"arXiv"},{"subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"},{"schemeUri":"http://www.oecd.org/science/inno/38235147.pdf","subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"}],"contributors":[],"dates":[{"date":"2026-02-23T03:09:56Z","dateType":"Submitted","dateInformation":"v1"},{"date":"2026-02-24T02:07:14Z","dateType":"Updated","dateInformation":"v1"},{"date":"2026-02","dateType":"Available","dateInformation":"v1"},{"date":"2026","dateType":"Issued"}],"language":null,"types":{"schemaOrg":"CreativeWork","resourceTypeGeneral":"Preprint","citeproc":"article","bibtex":"misc","ris":"GEN","resourceType":"Article"},"relatedIdentifiers":[],"relatedItems":[],"sizes":[],"formats":[],"version":"1","rightsList":[{"rightsIdentifierScheme":"SPDX","rightsUri":"https://creativecommons.org/licenses/by/4.0/legalcode","schemeUri":"https://spdx.org/licenses/","rights":"Creative Commons Attribution 4.0 International","rightsIdentifier":"cc-by-4.0"}],"descriptions":[{"descriptionType":"Abstract","description":"In this paper, we present Laplacian multiscale flow matching (LapFlow), a novel framework that enhances flow matching by leveraging multi-scale representations for image generative modeling. Our approach decomposes images into Laplacian pyramid residuals and processes different scales in parallel through a mixture-of-transformers (MoT) architecture with causal attention mechanisms. Unlike previous cascaded approaches that require explicit renoising between scales, our model generates multi-scale representations in parallel, eliminating the need for bridging processes. The proposed multi-scale architecture not only improves generation quality but also accelerates the sampling process and promotes scaling flow matching methods. Through extensive experimentation on CelebA-HQ and ImageNet, we demonstrate that our method achieves superior sample quality with fewer GFLOPs and faster inference compared to single-scale and multi-scale flow matching baselines. The proposed model scales effectively to high-resolution generation (up to 1024$\\times$1024) while maintaining lower computational overhead."},{"descriptionType":"Other","description":"Accepted to appear in ICLR 2026"}],"geoLocations":[],"fundingReferences":[],"url":"https://arxiv.org/abs/2602.19461","contentUrl":null,"metadataVersion":0,"schemaVersion":"http://datacite.org/schema/kernel-4","source":"mds","isActive":true,"state":"findable","reason":null,"viewCount":0,"downloadCount":0,"referenceCount":0,"citationCount":0,"partCount":0,"partOfCount":0,"versionCount":0,"versionOfCount":0,"created":"2026-02-25T15:01:25Z","registered":"2026-02-25T15:01:25Z","published":null,"updated":"2026-02-25T15:01:25Z"},"relationships":{"client":{"data":{"id":"arxiv.content","type":"clients"}}}},{"id":"10.48550/arxiv.2602.19459","type":"dois","attributes":{"doi":"10.48550/arxiv.2602.19459","identifiers":[{"identifier":"2602.19459","identifierType":"arXiv"}],"creators":[{"nameType":"Personal","givenName":"Zhiguo","familyName":"Ding","name":"Ding, Zhiguo","affiliation":[],"nameIdentifiers":[]}],"titles":[{"title":"Toward a Quiet Wireless World: Multi-Cell Pinching-Antenna Transmission"}],"publisher":"arXiv","container":{},"publicationYear":2026,"subjects":[{"subject":"Information Theory (cs.IT)","lang":"en","subjectScheme":"arXiv"},{"subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"},{"schemeUri":"http://www.oecd.org/science/inno/38235147.pdf","subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"}],"contributors":[],"dates":[{"date":"2026-02-23T03:06:49Z","dateType":"Submitted","dateInformation":"v1"},{"date":"2026-02-24T02:07:04Z","dateType":"Updated","dateInformation":"v1"},{"date":"2026-02","dateType":"Available","dateInformation":"v1"},{"date":"2026","dateType":"Issued"}],"language":null,"types":{"schemaOrg":"CreativeWork","resourceTypeGeneral":"Preprint","citeproc":"article","bibtex":"misc","ris":"GEN","resourceType":"Article"},"relatedIdentifiers":[],"relatedItems":[],"sizes":[],"formats":[],"version":"1","rightsList":[{"rightsUri":"http://arxiv.org/licenses/nonexclusive-distrib/1.0/","rights":"arXiv.org perpetual, non-exclusive license"}],"descriptions":[{"descriptionType":"Abstract","description":"Conventional-antenna-based multi-cell interference management can lead to excessive power consumption. For example, in order to serve those users which are close to the cell edge, base stations often must transmit at very high power levels to overcome severe large-scale path-loss, i.e., the base stations have to ``shout\" at the users to realize the users' target quality of service (QoS). This letter focuses on the application of pinching antennas to multi-cell interference management and demonstrates that the use of multi-cell pinching-antenna transmission leads to a quiet wireless world. In particular, each transceiver pair can be positioned in close proximity, and hence the users' QoS requirements can be met with only low transmit power, i.e., via ``whispering\" rather than high-power transmission."}],"geoLocations":[],"fundingReferences":[],"url":"https://arxiv.org/abs/2602.19459","contentUrl":null,"metadataVersion":0,"schemaVersion":"http://datacite.org/schema/kernel-4","source":"mds","isActive":true,"state":"findable","reason":null,"viewCount":0,"downloadCount":0,"referenceCount":0,"citationCount":0,"partCount":0,"partOfCount":0,"versionCount":0,"versionOfCount":0,"created":"2026-02-25T15:01:20Z","registered":"2026-02-25T15:01:20Z","published":null,"updated":"2026-02-25T15:01:20Z"},"relationships":{"client":{"data":{"id":"arxiv.content","type":"clients"}}}},{"id":"10.48550/arxiv.2602.19458","type":"dois","attributes":{"doi":"10.48550/arxiv.2602.19458","identifiers":[{"identifier":"2602.19458","identifierType":"arXiv"}],"creators":[{"nameType":"Personal","givenName":"Ziyang","familyName":"Guo","name":"Guo, Ziyang","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Yifan","familyName":"Wu","name":"Wu, Yifan","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Jason","familyName":"Hartline","name":"Hartline, Jason","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Kenneth","familyName":"Holstein","name":"Holstein, Kenneth","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Jessica","familyName":"Hullman","name":"Hullman, Jessica","affiliation":[],"nameIdentifiers":[]}],"titles":[{"title":"ComplLLM: Fine-tuning LLMs to Discover Complementary Signals for Decision-making"}],"publisher":"arXiv","container":{},"publicationYear":2026,"subjects":[{"subject":"Artificial Intelligence (cs.AI)","lang":"en","subjectScheme":"arXiv"},{"subject":"Human-Computer Interaction (cs.HC)","lang":"en","subjectScheme":"arXiv"},{"subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"},{"schemeUri":"http://www.oecd.org/science/inno/38235147.pdf","subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"}],"contributors":[],"dates":[{"date":"2026-02-23T03:01:52Z","dateType":"Submitted","dateInformation":"v1"},{"date":"2026-02-24T02:07:00Z","dateType":"Updated","dateInformation":"v1"},{"date":"2026-02","dateType":"Available","dateInformation":"v1"},{"date":"2026","dateType":"Issued"}],"language":null,"types":{"schemaOrg":"CreativeWork","resourceTypeGeneral":"Preprint","citeproc":"article","bibtex":"misc","ris":"GEN","resourceType":"Article"},"relatedIdentifiers":[],"relatedItems":[],"sizes":[],"formats":[],"version":"1","rightsList":[{"rightsIdentifierScheme":"SPDX","rightsUri":"https://creativecommons.org/licenses/by/4.0/legalcode","schemeUri":"https://spdx.org/licenses/","rights":"Creative Commons Attribution 4.0 International","rightsIdentifier":"cc-by-4.0"}],"descriptions":[{"descriptionType":"Abstract","description":"Multi-agent decision pipelines can outperform single agent workflows when complementarity holds, i.e., different agents bring unique information to the table to inform a final decision. We propose ComplLLM, a post-training framework based on decision theory that fine-tunes a decision-assistant LLM using complementary information as reward to output signals that complement existing agent decisions. We validate ComplLLM on synthetic and real-world tasks involving domain experts, demonstrating how the approach recovers known complementary information and produces plausible explanations of complementary signals to support downstream decision-makers."}],"geoLocations":[],"fundingReferences":[],"url":"https://arxiv.org/abs/2602.19458","contentUrl":null,"metadataVersion":0,"schemaVersion":"http://datacite.org/schema/kernel-4","source":"mds","isActive":true,"state":"findable","reason":null,"viewCount":0,"downloadCount":0,"referenceCount":0,"citationCount":0,"partCount":0,"partOfCount":0,"versionCount":0,"versionOfCount":0,"created":"2026-02-25T15:01:17Z","registered":"2026-02-25T15:01:18Z","published":null,"updated":"2026-02-25T15:01:18Z"},"relationships":{"client":{"data":{"id":"arxiv.content","type":"clients"}}}},{"id":"10.48550/arxiv.2602.19457","type":"dois","attributes":{"doi":"10.48550/arxiv.2602.19457","identifiers":[{"identifier":"2602.19457","identifierType":"arXiv"}],"creators":[{"nameType":"Personal","givenName":"Yanan","familyName":"He","name":"He, Yanan","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Zhihao","familyName":"Ge","name":"Ge, Zhihao","affiliation":[],"nameIdentifiers":[]}],"titles":[{"title":"Optimal Error Estimates of a new Multiphysic Finite Element Method for Nonlinear Poroelasticity model with Hencky-Mises Stress Tensor"}],"publisher":"arXiv","container":{},"publicationYear":2026,"subjects":[{"subject":"Numerical Analysis (math.NA)","lang":"en","subjectScheme":"arXiv"},{"subject":"Analysis of PDEs (math.AP)","lang":"en","subjectScheme":"arXiv"},{"subject":"FOS: Mathematics","subjectScheme":"Fields of Science and Technology (FOS)"},{"schemeUri":"http://www.oecd.org/science/inno/38235147.pdf","subject":"FOS: Mathematics","subjectScheme":"Fields of Science and Technology (FOS)"}],"contributors":[],"dates":[{"date":"2026-02-23T02:58:23Z","dateType":"Submitted","dateInformation":"v1"},{"date":"2026-02-24T02:06:59Z","dateType":"Updated","dateInformation":"v1"},{"date":"2026-02","dateType":"Available","dateInformation":"v1"},{"date":"2026","dateType":"Issued"}],"language":null,"types":{"schemaOrg":"CreativeWork","resourceTypeGeneral":"Preprint","citeproc":"article","bibtex":"misc","ris":"GEN","resourceType":"Article"},"relatedIdentifiers":[],"relatedItems":[],"sizes":[],"formats":[],"version":"1","rightsList":[{"rightsUri":"http://arxiv.org/licenses/nonexclusive-distrib/1.0/","rights":"arXiv.org perpetual, non-exclusive license"}],"descriptions":[{"descriptionType":"Abstract","description":"In this paper, we develop a new multiphysics finite element method for a nonlinear poroelastic model with Hencky-Mises stress tensor. By introducing some new notations, we reformulate the original model into a fluid-fluid coupling problem, which is viewed as a generalized nonlinear Stokes sub-problem combined with a reaction-diffusion sub-problem. Then, we establish the existence and uniqueness of the weak solution for the reformulated problem, and propose a stable, fully discrete multiphysics finite element method which employs Lagrangian finite element pairs for spatial discretization and a backward Euler scheme for temporal discretization. By ensuring the parameters $κ_1$ and $κ_3$ remain bounded and non-zero even as $λ$ tends to infinity, the proposed method maintains stability for a wide range of Lagrangian element pairs. Based on the continuity and monotonicity of the nonlinear term $\\mathcal{N}(\\varepsilon(\\mathbf{u}_h^{n}))$, we give the stability analysis and derive optimal error estimates for the displacement vector $\\mathbf{u}$ and the pressure $p$ in both $L^2$-norm and $H^1$-norm. In particular, the $L^2$-norm error estimate for the displacement $\\mathbf{u}$, which was not present in previous literature, is established here through an auxiliary problem and a Poincar$\\acute{e}$ inequality. Also, we present numerical tests to verify the theoretical analysis, and the results confirm the optimal convergence rates. Finally, we draw conclusions to summarize the work."}],"geoLocations":[],"fundingReferences":[],"url":"https://arxiv.org/abs/2602.19457","contentUrl":null,"metadataVersion":0,"schemaVersion":"http://datacite.org/schema/kernel-4","source":"mds","isActive":true,"state":"findable","reason":null,"viewCount":0,"downloadCount":0,"referenceCount":0,"citationCount":0,"partCount":0,"partOfCount":0,"versionCount":0,"versionOfCount":0,"created":"2026-02-25T15:01:15Z","registered":"2026-02-25T15:01:15Z","published":null,"updated":"2026-02-25T15:01:15Z"},"relationships":{"client":{"data":{"id":"arxiv.content","type":"clients"}}}},{"id":"10.48550/arxiv.2602.19456","type":"dois","attributes":{"doi":"10.48550/arxiv.2602.19456","identifiers":[{"identifier":"2602.19456","identifierType":"arXiv"}],"creators":[{"nameType":"Personal","givenName":"Yi","familyName":"Gao","name":"Gao, Yi","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Kui","familyName":"Wang","name":"Wang, Kui","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Anqiang","familyName":"Zhu","name":"Zhu, Anqiang","affiliation":[],"nameIdentifiers":[]}],"titles":[{"title":"An isoperimetric inequality for the second Robin eigenvalue of the Weighted Laplacian"}],"publisher":"arXiv","container":{},"publicationYear":2026,"subjects":[{"subject":"Analysis of PDEs (math.AP)","lang":"en","subjectScheme":"arXiv"},{"subject":"Spectral Theory (math.SP)","lang":"en","subjectScheme":"arXiv"},{"subject":"FOS: Mathematics","subjectScheme":"Fields of Science and Technology (FOS)"},{"schemeUri":"http://www.oecd.org/science/inno/38235147.pdf","subject":"FOS: Mathematics","subjectScheme":"Fields of Science and Technology (FOS)"},{"subject":"35P15","lang":"en","subjectScheme":"MSC"}],"contributors":[],"dates":[{"date":"2026-02-23T02:57:04Z","dateType":"Submitted","dateInformation":"v1"},{"date":"2026-02-24T02:06:55Z","dateType":"Updated","dateInformation":"v1"},{"date":"2026-02","dateType":"Available","dateInformation":"v1"},{"date":"2026","dateType":"Issued"}],"language":null,"types":{"schemaOrg":"CreativeWork","resourceTypeGeneral":"Preprint","citeproc":"article","bibtex":"misc","ris":"GEN","resourceType":"Article"},"relatedIdentifiers":[],"relatedItems":[],"sizes":[],"formats":[],"version":"1","rightsList":[{"rightsIdentifierScheme":"SPDX","rightsUri":"https://creativecommons.org/licenses/by/4.0/legalcode","schemeUri":"https://spdx.org/licenses/","rights":"Creative Commons Attribution 4.0 International","rightsIdentifier":"cc-by-4.0"}],"descriptions":[{"descriptionType":"Abstract","description":"In this paper, we investigate a shape optimization problem for the second Robin eigenvalue of the weighted Laplacian on bounded Lipschitz domains symmetric about the origin. Our main theorem states that the ball centered at the origin maximizes the second Robin eigenvalue among all Lipschitz bounded domains of prescribed weighted measure and symmetric about the origin for a range of negative Robin parameters."},{"descriptionType":"Other","description":"All comments are welcome"}],"geoLocations":[],"fundingReferences":[],"url":"https://arxiv.org/abs/2602.19456","contentUrl":null,"metadataVersion":0,"schemaVersion":"http://datacite.org/schema/kernel-4","source":"mds","isActive":true,"state":"findable","reason":null,"viewCount":0,"downloadCount":0,"referenceCount":0,"citationCount":0,"partCount":0,"partOfCount":0,"versionCount":0,"versionOfCount":0,"created":"2026-02-25T15:01:12Z","registered":"2026-02-25T15:01:13Z","published":null,"updated":"2026-02-25T15:01:13Z"},"relationships":{"client":{"data":{"id":"arxiv.content","type":"clients"}}}},{"id":"10.48550/arxiv.2602.19455","type":"dois","attributes":{"doi":"10.48550/arxiv.2602.19455","identifiers":[{"identifier":"2602.19455","identifierType":"arXiv"}],"creators":[{"nameType":"Personal","givenName":"Zelin","familyName":"He","name":"He, Zelin","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Boran","familyName":"Han","name":"Han, Boran","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Xiyuan","familyName":"Zhang","name":"Zhang, Xiyuan","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Shuai","familyName":"Zhang","name":"Zhang, Shuai","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Haotian","familyName":"Lin","name":"Lin, Haotian","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Qi","familyName":"Zhu","name":"Zhu, Qi","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Haoyang","familyName":"Fang","name":"Fang, Haoyang","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Danielle C.","familyName":"Maddix","name":"Maddix, Danielle C.","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Abdul Fatir","familyName":"Ansari","name":"Ansari, Abdul Fatir","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Akash","familyName":"Chandrayan","name":"Chandrayan, Akash","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Abhinav","familyName":"Pradhan","name":"Pradhan, Abhinav","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Bernie","familyName":"Wang","name":"Wang, Bernie","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Matthew","familyName":"Reimherr","name":"Reimherr, Matthew","affiliation":[],"nameIdentifiers":[]}],"titles":[{"title":"SenTSR-Bench: Thinking with Injected Knowledge for Time-Series Reasoning"}],"publisher":"arXiv","container":{},"publicationYear":2026,"subjects":[{"subject":"Machine Learning (cs.LG)","lang":"en","subjectScheme":"arXiv"},{"subject":"Artificial Intelligence (cs.AI)","lang":"en","subjectScheme":"arXiv"},{"subject":"Computation and Language (cs.CL)","lang":"en","subjectScheme":"arXiv"},{"subject":"Machine Learning (stat.ML)","lang":"en","subjectScheme":"arXiv"},{"subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"},{"schemeUri":"http://www.oecd.org/science/inno/38235147.pdf","subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"}],"contributors":[],"dates":[{"date":"2026-02-23T02:55:32Z","dateType":"Submitted","dateInformation":"v1"},{"date":"2026-02-24T02:06:02Z","dateType":"Updated","dateInformation":"v1"},{"date":"2026-02","dateType":"Available","dateInformation":"v1"},{"date":"2026","dateType":"Issued"}],"language":null,"types":{"schemaOrg":"CreativeWork","resourceTypeGeneral":"Preprint","citeproc":"article","bibtex":"misc","ris":"GEN","resourceType":"Article"},"relatedIdentifiers":[],"relatedItems":[],"sizes":[],"formats":[],"version":"1","rightsList":[{"rightsIdentifierScheme":"SPDX","rightsUri":"https://creativecommons.org/licenses/by/4.0/legalcode","schemeUri":"https://spdx.org/licenses/","rights":"Creative Commons Attribution 4.0 International","rightsIdentifier":"cc-by-4.0"}],"descriptions":[{"descriptionType":"Abstract","description":"Time-series diagnostic reasoning is essential for many applications, yet existing solutions face a persistent gap: general reasoning large language models (GRLMs) possess strong reasoning skills but lack the domain-specific knowledge to understand complex time-series patterns. Conversely, fine-tuned time-series LLMs (TSLMs) understand these patterns but lack the capacity to generalize reasoning for more complicated questions. To bridge this gap, we propose a hybrid knowledge-injection framework that injects TSLM-generated insights directly into GRLM's reasoning trace, thereby achieving strong time-series reasoning with in-domain knowledge. As collecting data for knowledge injection fine-tuning is costly, we further leverage a reinforcement learning-based approach with verifiable rewards (RLVR) to elicit knowledge-rich traces without human supervision, then transfer such an in-domain thinking trace into GRLM for efficient knowledge injection. We further release SenTSR-Bench, a multivariate time-series-based diagnostic reasoning benchmark collected from real-world industrial operations. Across SenTSR-Bench and other public datasets, our method consistently surpasses TSLMs by 9.1%-26.1% and GRLMs by 7.9%-22.4%, delivering robust, context-aware time-series diagnostic insights."},{"descriptionType":"Other","description":"Accepted by the 29th International Conference on Artificial Intelligence and Statistics (AISTATS 2026)"}],"geoLocations":[],"fundingReferences":[],"url":"https://arxiv.org/abs/2602.19455","contentUrl":null,"metadataVersion":0,"schemaVersion":"http://datacite.org/schema/kernel-4","source":"mds","isActive":true,"state":"findable","reason":null,"viewCount":0,"downloadCount":0,"referenceCount":0,"citationCount":0,"partCount":0,"partOfCount":0,"versionCount":0,"versionOfCount":0,"created":"2026-02-25T15:01:10Z","registered":"2026-02-25T15:01:11Z","published":null,"updated":"2026-02-25T15:01:11Z"},"relationships":{"client":{"data":{"id":"arxiv.content","type":"clients"}}}},{"id":"10.48550/arxiv.2602.19454","type":"dois","attributes":{"doi":"10.48550/arxiv.2602.19454","identifiers":[{"identifier":"2602.19454","identifierType":"arXiv"}],"creators":[{"nameType":"Personal","givenName":"Kartik","familyName":"Jhawar","name":"Jhawar, Kartik","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Lipo","familyName":"Wang","name":"Wang, Lipo","affiliation":[],"nameIdentifiers":[]}],"titles":[{"title":"HD-TTA: Hypothesis-Driven Test-Time Adaptation for Safer Brain Tumor Segmentation"}],"publisher":"arXiv","container":{},"publicationYear":2026,"subjects":[{"subject":"Computer Vision and Pattern Recognition (cs.CV)","lang":"en","subjectScheme":"arXiv"},{"subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"},{"schemeUri":"http://www.oecd.org/science/inno/38235147.pdf","subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"}],"contributors":[],"dates":[{"date":"2026-02-23T02:53:05Z","dateType":"Submitted","dateInformation":"v1"},{"date":"2026-02-24T02:05:57Z","dateType":"Updated","dateInformation":"v1"},{"date":"2026-02","dateType":"Available","dateInformation":"v1"},{"date":"2026","dateType":"Issued"}],"language":null,"types":{"schemaOrg":"CreativeWork","resourceTypeGeneral":"Preprint","citeproc":"article","bibtex":"misc","ris":"GEN","resourceType":"Article"},"relatedIdentifiers":[],"relatedItems":[],"sizes":[],"formats":[],"version":"1","rightsList":[{"rightsUri":"http://arxiv.org/licenses/nonexclusive-distrib/1.0/","rights":"arXiv.org perpetual, non-exclusive license"}],"descriptions":[{"descriptionType":"Abstract","description":"Standard Test-Time Adaptation (TTA) methods typically treat inference as a blind optimization task, applying generic objectives to all or filtered test samples. In safety-critical medical segmentation, this lack of selectivity often causes the tumor mask to spill into healthy brain tissue or degrades predictions that were already correct. We propose Hypothesis-Driven TTA, a novel framework that reformulates adaptation as a dynamic decision process. Rather than forcing a single optimization trajectory, our method generates intuitive competing geometric hypotheses: compaction (is the prediction noisy? trim artifacts) versus inflation (is the valid tumor under-segmented? safely inflate to recover). It then employs a representation-guided selector to autonomously identify the safest outcome based on intrinsic texture consistency. Additionally, a pre-screening Gatekeeper prevents negative transfer by skipping adaptation on confident cases. We validate this proof-of-concept on a cross-domain binary brain tumor segmentation task, applying a source model trained on adult BraTS gliomas to unseen pediatric and more challenging meningioma target domains. HD-TTA improves safety-oriented outcomes (Hausdorff Distance (HD95) and Precision) over several state-of-the-art representative baselines in the challenging safety regime, reducing the HD95 by approximately 6.4 mm and improving Precision by over 4%, while maintaining comparable Dice scores. These results demonstrate that resolving the safety-adaptation trade-off via explicit hypothesis selection is a viable, robust path for safe clinical model deployment. Code will be made publicly available upon acceptance."},{"descriptionType":"Other","description":"11 pages, 3 figures, 2 tables"}],"geoLocations":[],"fundingReferences":[],"url":"https://arxiv.org/abs/2602.19454","contentUrl":null,"metadataVersion":0,"schemaVersion":"http://datacite.org/schema/kernel-4","source":"mds","isActive":true,"state":"findable","reason":null,"viewCount":0,"downloadCount":0,"referenceCount":0,"citationCount":0,"partCount":0,"partOfCount":0,"versionCount":0,"versionOfCount":0,"created":"2026-02-25T15:01:07Z","registered":"2026-02-25T15:01:08Z","published":null,"updated":"2026-02-25T15:01:08Z"},"relationships":{"client":{"data":{"id":"arxiv.content","type":"clients"}}}},{"id":"10.48550/arxiv.2602.19453","type":"dois","attributes":{"doi":"10.48550/arxiv.2602.19453","identifiers":[{"identifier":"2602.19453","identifierType":"arXiv"}],"creators":[{"nameType":"Personal","givenName":"Ryan W.","familyName":"Salatti","name":"Salatti, Ryan W.","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"André M.","familyName":"Timpanaro","name":"Timpanaro, André M.","affiliation":[],"nameIdentifiers":[]}],"titles":[{"title":"Emergence of opinion splits in the Sznajd model with latency"}],"publisher":"arXiv","container":{},"publicationYear":2026,"subjects":[{"subject":"Physics and Society (physics.soc-ph)","lang":"en","subjectScheme":"arXiv"},{"subject":"Statistical Mechanics (cond-mat.stat-mech)","lang":"en","subjectScheme":"arXiv"},{"subject":"Adaptation and Self-Organizing Systems (nlin.AO)","lang":"en","subjectScheme":"arXiv"},{"subject":"FOS: Physical sciences","subjectScheme":"Fields of Science and Technology (FOS)"},{"schemeUri":"http://www.oecd.org/science/inno/38235147.pdf","subject":"FOS: Physical sciences","subjectScheme":"Fields of Science and Technology (FOS)"}],"contributors":[],"dates":[{"date":"2026-02-23T02:51:41Z","dateType":"Submitted","dateInformation":"v1"},{"date":"2026-02-24T02:05:56Z","dateType":"Updated","dateInformation":"v1"},{"date":"2026-02","dateType":"Available","dateInformation":"v1"},{"date":"2026","dateType":"Issued"}],"language":null,"types":{"schemaOrg":"CreativeWork","resourceTypeGeneral":"Preprint","citeproc":"article","bibtex":"misc","ris":"GEN","resourceType":"Article"},"relatedIdentifiers":[],"relatedItems":[],"sizes":[],"formats":[],"version":"1","rightsList":[{"rightsUri":"http://arxiv.org/licenses/nonexclusive-distrib/1.0/","rights":"arXiv.org perpetual, non-exclusive license"}],"descriptions":[{"descriptionType":"Abstract","description":"In the modelling of social systems, opinion latency is the idea that once an agent changes its opinion, there will be a period of time where it is immune to other changes. When added to the voter model this leads to a situation where no matter how low the latency is or how many opinions are considered, all opinions end up in a coexistence where they are equally represented. In this work, we examine what happens when latency is added to the Sznajd model. What we find is that for low latency, the model behaves roughly like it does in the absence of latency, where one opinion will always eventually dominate. For high latency, the possibility for a symmetric coexistence of 2 opinions arises, but contrary to the voter model, a coexistence of more than 2 opinions is never stable. We provide evidence of this phenomenon with computer simulations of the model in Barabási-Albert networks, together with a mean field treatment that is able to capture the observed behavior. We argue that this could hint at an explanation for the prevalence of two opinion splits in the real world."},{"descriptionType":"Other","description":"7 pages (main text) + 10 pages (appendices), 13 figures"}],"geoLocations":[],"fundingReferences":[],"url":"https://arxiv.org/abs/2602.19453","contentUrl":null,"metadataVersion":0,"schemaVersion":"http://datacite.org/schema/kernel-4","source":"mds","isActive":true,"state":"findable","reason":null,"viewCount":0,"downloadCount":0,"referenceCount":0,"citationCount":0,"partCount":0,"partOfCount":0,"versionCount":0,"versionOfCount":0,"created":"2026-02-25T15:01:05Z","registered":"2026-02-25T15:01:06Z","published":null,"updated":"2026-02-25T15:01:06Z"},"relationships":{"client":{"data":{"id":"arxiv.content","type":"clients"}}}},{"id":"10.48550/arxiv.2602.19452","type":"dois","attributes":{"doi":"10.48550/arxiv.2602.19452","identifiers":[{"identifier":"2602.19452","identifierType":"arXiv"}],"creators":[{"nameType":"Personal","givenName":"Longfei","familyName":"Gao","name":"Gao, Longfei","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Frimpong","familyName":"Baidoo","name":"Baidoo, Frimpong","affiliation":[],"nameIdentifiers":[]}],"titles":[{"title":"Dekker's floating point number system and compensated summation algorithms"}],"publisher":"arXiv","container":{},"publicationYear":2026,"subjects":[{"subject":"Numerical Analysis (math.NA)","lang":"en","subjectScheme":"arXiv"},{"subject":"FOS: Mathematics","subjectScheme":"Fields of Science and Technology (FOS)"},{"schemeUri":"http://www.oecd.org/science/inno/38235147.pdf","subject":"FOS: Mathematics","subjectScheme":"Fields of Science and Technology (FOS)"}],"contributors":[],"dates":[{"date":"2026-02-23T02:51:23Z","dateType":"Submitted","dateInformation":"v1"},{"date":"2026-02-24T02:05:55Z","dateType":"Updated","dateInformation":"v1"},{"date":"2026-02","dateType":"Available","dateInformation":"v1"},{"date":"2026","dateType":"Issued"}],"language":null,"types":{"schemaOrg":"CreativeWork","resourceTypeGeneral":"Preprint","citeproc":"article","bibtex":"misc","ris":"GEN","resourceType":"Article"},"relatedIdentifiers":[],"relatedItems":[],"sizes":[],"formats":[],"version":"1","rightsList":[{"rightsIdentifierScheme":"SPDX","rightsUri":"https://creativecommons.org/licenses/by/4.0/legalcode","schemeUri":"https://spdx.org/licenses/","rights":"Creative Commons Attribution 4.0 International","rightsIdentifier":"cc-by-4.0"}],"descriptions":[{"descriptionType":"Abstract","description":"The recent hardware trend towards reduced precision computing has reignited the interest in numerical techniques that can be used to enhance the accuracy of floating point operations beyond what is natively supported for basic arithmetic operations on the hardware. In this work, we study the behavior of various compensated summation techniques, which can be used to enhance the accuracy for the summation operation, particularly in situations when the addends are not known a priori. Complete descriptions of the error behavior are provided for these techniques. In particular, the relationship between the intermediate results at two consecutive summing steps is provided, which is used to identify the operation that limits accuracy and guide the design of more nuanced techniques. The analysis relies on the work of Dekker [Numerische Mathematik, 1971], which uses a special floating point number system that does not require uniqueness in the number representation. Despite this seemingly strange attribute, Dekker's system is very convenient for the analysis here and allows general statements to be expressed succinctly compared to a number system that requires uniqueness. To prepare the foundation for discussion, we start by giving a thorough exhibition of Dekker's number system and supply the details that were omitted in Dekker [Numerische Mathematik, 1971]. Numerical examples are designed to explain the inner workings of these compensated summation techniques, illustrate their efficacy, and empirically verify the analytical results derived. Discussions are also given on application scenarios where these techniques can be beneficial."}],"geoLocations":[],"fundingReferences":[],"url":"https://arxiv.org/abs/2602.19452","contentUrl":null,"metadataVersion":0,"schemaVersion":"http://datacite.org/schema/kernel-4","source":"mds","isActive":true,"state":"findable","reason":null,"viewCount":0,"downloadCount":0,"referenceCount":0,"citationCount":0,"partCount":0,"partOfCount":0,"versionCount":0,"versionOfCount":0,"created":"2026-02-25T15:01:02Z","registered":"2026-02-25T15:01:03Z","published":null,"updated":"2026-02-25T15:01:03Z"},"relationships":{"client":{"data":{"id":"arxiv.content","type":"clients"}}}},{"id":"10.48550/arxiv.2602.19451","type":"dois","attributes":{"doi":"10.48550/arxiv.2602.19451","identifiers":[{"identifier":"2602.19451","identifierType":"arXiv"}],"creators":[{"nameType":"Personal","givenName":"Yunkun","familyName":"Han","name":"Han, Yunkun","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Xian Zhong","familyName":"Zheng","name":"Zheng, Xian Zhong","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Xiaohu","familyName":"Yang","name":"Yang, Xiaohu","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Run","familyName":"Wen","name":"Wen, Run","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"F. S.","familyName":"Liu","name":"Liu, F. S.","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Hu","familyName":"Zou","name":"Zou, Hu","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Jin-Ming","familyName":"Bai","name":"Bai, Jin-Ming","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Yinghe","familyName":"Zhao","name":"Zhao, Yinghe","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Lulu","familyName":"Fan","name":"Fan, Lulu","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Fenghui","familyName":"Zhang","name":"Zhang, Fenghui","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Xiaoyu","familyName":"Kang","name":"Kang, Xiaoyu","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Xiejin","familyName":"Li","name":"Li, Xiejin","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Hong","familyName":"Guo","name":"Guo, Hong","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Pengjie","familyName":"Zhang","name":"Zhang, Pengjie","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Hu","familyName":"Zhan","name":"Zhan, Hu","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Gongbo","familyName":"Zhao","name":"Zhao, Gongbo","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Cheng","familyName":"Li","name":"Li, Cheng","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Yan","familyName":"Gong","name":"Gong, Yan","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Yizhou","familyName":"Gu","name":"Gu, Yizhou","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Feng","familyName":"Shi","name":"Shi, Feng","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Xingchen","familyName":"Zhou","name":"Zhou, Xingchen","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Jipeng","familyName":"Sui","name":"Sui, Jipeng","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Yipeng","familyName":"Jing","name":"Jing, Yipeng","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Zhanwen","familyName":"Han","name":"Han, Zhanwen","affiliation":[],"nameIdentifiers":[]}],"titles":[{"title":"BayeSED-GALAXIES II. Bayesian full spectrum analysis of galaxies and application in the CSST wide-field slitless spectroscopy survey"}],"publisher":"arXiv","container":{},"publicationYear":2026,"subjects":[{"subject":"Astrophysics of Galaxies (astro-ph.GA)","lang":"en","subjectScheme":"arXiv"},{"subject":"Cosmology and Nongalactic Astrophysics (astro-ph.CO)","lang":"en","subjectScheme":"arXiv"},{"subject":"FOS: Physical sciences","subjectScheme":"Fields of Science and Technology (FOS)"},{"schemeUri":"http://www.oecd.org/science/inno/38235147.pdf","subject":"FOS: Physical sciences","subjectScheme":"Fields of Science and Technology (FOS)"}],"contributors":[],"dates":[{"date":"2026-02-23T02:48:25Z","dateType":"Submitted","dateInformation":"v1"},{"date":"2026-02-24T02:05:52Z","dateType":"Updated","dateInformation":"v1"},{"date":"2026-02","dateType":"Available","dateInformation":"v1"},{"date":"2026","dateType":"Issued"}],"language":null,"types":{"schemaOrg":"CreativeWork","resourceTypeGeneral":"Preprint","citeproc":"article","bibtex":"misc","ris":"GEN","resourceType":"Article"},"relatedIdentifiers":[],"relatedItems":[],"sizes":[],"formats":[],"version":"1","rightsList":[{"rightsUri":"http://arxiv.org/licenses/nonexclusive-distrib/1.0/","rights":"arXiv.org perpetual, non-exclusive license"}],"descriptions":[{"descriptionType":"Abstract","description":"The China Space Station Telescope (CSST) will conduct wide-field multiband photometric imaging and slitless spectroscopic surveys, advancing cosmology and galaxy evolution studies. Achieving CSST's cosmological goals requires precise redshifts ($σ_{\\rm NMAD}\\lesssim 0.002-0.005$) from low-resolution ($R\\sim200$) and potentially blended slitless spectra. We present BayeSED3, extended for Bayesian full-spectrum analysis, including nebular emission modeling (via \\textsc{Cloudy}) and a Bayesian treatment of the model scaling factor, improving reliability over optimization methods for low SNR spectra. Validated on realistic mock data generated with the CESS emulator (median SNR=1.65, including instrumental and self-blending effects), our method achieves excellent redshift precision with three-band (GU+GV+GI) spectroscopy: $σ_{\\rm NMAD}=0.0008$ ($\\sim$80% success) for star-forming and $σ_{\\rm NMAD}=0.0015$ ($\\sim$50% success) for quiescent galaxies. Stellar mass ($σ_{\\rm NMAD}\\approx0.015$ dex for SF, $\\approx0.016$ dex for quiescent) and SFR ($σ_{\\rm NMAD}\\approx0.05$ dex for SF, especially at SNR\u0026gt;1) are reliably recovered. Self-blending increases scatter by $\\gtrsim30%$, but combining spectroscopy with CSST's seven-band photometry significantly improves accuracy, especially for quiescent galaxies and data-limited cases. Single-band spectroscopy plus photometry yields reasonable redshifts: GU+photometry is limited, GI+photometry gives \u0026gt;60% (SF) and \u0026gt;40% (quiescent) success at $σ_{\\rm NMAD}\\lesssim0.002$, GV+photometry gives \u0026gt;35% (SF) and $\\sim$40% (quiescent) at similar precision. The Bayesian framework offers a powerful method for accurate galaxy characterization, enhancing CSST's scientific outcomes despite the challenges of slitless spectroscopy."},{"descriptionType":"Other","description":"38 pages, including 16 figures and 2 tables; accepted for publication in ApJS. The mock CSST data for ~100,000 galaxies utilized in this work will be publicly available at https://doi.org/10.5281/zenodo.17221343/. A Python script for an in-depth comparison between BayeSED3 and BAGPIPES is available at https://github.com/hanyk/BayeSED3/blob/main/tests/test_bayesed_bagpipes_comparison.py"}],"geoLocations":[],"fundingReferences":[],"url":"https://arxiv.org/abs/2602.19451","contentUrl":null,"metadataVersion":0,"schemaVersion":"http://datacite.org/schema/kernel-4","source":"mds","isActive":true,"state":"findable","reason":null,"viewCount":0,"downloadCount":0,"referenceCount":0,"citationCount":0,"partCount":0,"partOfCount":0,"versionCount":0,"versionOfCount":0,"created":"2026-02-25T15:01:00Z","registered":"2026-02-25T15:01:00Z","published":null,"updated":"2026-02-25T15:01:00Z"},"relationships":{"client":{"data":{"id":"arxiv.content","type":"clients"}}}},{"id":"10.48550/arxiv.2602.19449","type":"dois","attributes":{"doi":"10.48550/arxiv.2602.19449","identifiers":[{"identifier":"2602.19449","identifierType":"arXiv"}],"creators":[{"nameType":"Personal","givenName":"Jason","familyName":"Wu","name":"Wu, Jason","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Tianchen","familyName":"Zhao","name":"Zhao, Tianchen","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Chang","familyName":"Liu","name":"Liu, Chang","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Jiarui","familyName":"Cai","name":"Cai, Jiarui","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Zheng","familyName":"Zhang","name":"Zhang, Zheng","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Zhuowei","familyName":"Li","name":"Li, Zhuowei","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Aaditya","familyName":"Singh","name":"Singh, Aaditya","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Xiang","familyName":"Xu","name":"Xu, Xiang","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Mani","familyName":"Srivastava","name":"Srivastava, Mani","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Jonathan","familyName":"Wu","name":"Wu, Jonathan","affiliation":[],"nameIdentifiers":[]}],"titles":[{"title":"Decoupling Vision and Language: Codebook Anchored Visual Adaptation"}],"publisher":"arXiv","container":{},"publicationYear":2026,"subjects":[{"subject":"Computer Vision and Pattern Recognition (cs.CV)","lang":"en","subjectScheme":"arXiv"},{"subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"},{"schemeUri":"http://www.oecd.org/science/inno/38235147.pdf","subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"},{"subject":"I.2.10; I.4.8; I.2.6; I.5.1","lang":"en","subjectScheme":"ACM"}],"contributors":[],"dates":[{"date":"2026-02-23T02:39:26Z","dateType":"Submitted","dateInformation":"v1"},{"date":"2026-02-24T02:05:44Z","dateType":"Updated","dateInformation":"v1"},{"date":"2026-02","dateType":"Available","dateInformation":"v1"},{"date":"2026","dateType":"Issued"}],"language":null,"types":{"schemaOrg":"CreativeWork","resourceTypeGeneral":"Preprint","citeproc":"article","bibtex":"misc","ris":"GEN","resourceType":"Article"},"relatedIdentifiers":[],"relatedItems":[],"sizes":[],"formats":[],"version":"1","rightsList":[{"rightsIdentifierScheme":"SPDX","rightsUri":"https://creativecommons.org/licenses/by/4.0/legalcode","schemeUri":"https://spdx.org/licenses/","rights":"Creative Commons Attribution 4.0 International","rightsIdentifier":"cc-by-4.0"}],"descriptions":[{"descriptionType":"Abstract","description":"Large Vision-Language Models (LVLMs) use their vision encoders to translate images into representations for downstream reasoning, but the encoders often underperform in domain-specific visual tasks such as medical image diagnosis or fine-grained classification, where representation errors can cascade through the language model, leading to incorrect responses. Existing adaptation methods modify the continuous feature interface between encoder and language model through projector tuning or other parameter-efficient updates, which still couples the two components and requires re-alignment whenever the encoder changes. We introduce CRAFT (Codebook RegulAted Fine-Tuning), a lightweight method that fine-tunes the encoder using a discrete codebook that anchors visual representations to a stable token space, achieving domain adaptation without modifying other parts of the model. This decoupled design allows the adapted encoder to seamlessly boost the performance of LVLMs with different language architectures, as long as they share the same codebook. Empirically, CRAFT achieves an average gain of 13.51% across 10 domain-specific benchmarks such as VQARAD and PlantVillage, while preserving the LLM's linguistic capabilities and outperforming peer methods that operate on continuous tokens."},{"descriptionType":"Other","description":"17 pages, accepted to CVPR2026 main conference"}],"geoLocations":[],"fundingReferences":[],"url":"https://arxiv.org/abs/2602.19449","contentUrl":null,"metadataVersion":0,"schemaVersion":"http://datacite.org/schema/kernel-4","source":"mds","isActive":true,"state":"findable","reason":null,"viewCount":0,"downloadCount":0,"referenceCount":0,"citationCount":0,"partCount":0,"partOfCount":0,"versionCount":0,"versionOfCount":0,"created":"2026-02-25T15:00:55Z","registered":"2026-02-25T15:00:56Z","published":null,"updated":"2026-02-25T15:00:56Z"},"relationships":{"client":{"data":{"id":"arxiv.content","type":"clients"}}}},{"id":"10.48550/arxiv.2602.19448","type":"dois","attributes":{"doi":"10.48550/arxiv.2602.19448","identifiers":[{"identifier":"2602.19448","identifierType":"arXiv"}],"creators":[{"nameType":"Personal","givenName":"Sangchul","familyName":"Oh","name":"Oh, Sangchul","affiliation":[],"nameIdentifiers":[]}],"titles":[{"title":"Subsystem Statistics and Conditional Self-Similarity of Random Quantum States"}],"publisher":"arXiv","container":{},"publicationYear":2026,"subjects":[{"subject":"Quantum Physics (quant-ph)","lang":"en","subjectScheme":"arXiv"},{"subject":"FOS: Physical sciences","subjectScheme":"Fields of Science and Technology (FOS)"},{"schemeUri":"http://www.oecd.org/science/inno/38235147.pdf","subject":"FOS: Physical sciences","subjectScheme":"Fields of Science and Technology (FOS)"}],"contributors":[],"dates":[{"date":"2026-02-23T02:38:29Z","dateType":"Submitted","dateInformation":"v1"},{"date":"2026-02-24T02:05:43Z","dateType":"Updated","dateInformation":"v1"},{"date":"2026-02","dateType":"Available","dateInformation":"v1"},{"date":"2026","dateType":"Issued"}],"language":null,"types":{"schemaOrg":"CreativeWork","resourceTypeGeneral":"Preprint","citeproc":"article","bibtex":"misc","ris":"GEN","resourceType":"Article"},"relatedIdentifiers":[],"relatedItems":[],"sizes":[],"formats":[],"version":"1","rightsList":[{"rightsIdentifierScheme":"SPDX","rightsUri":"https://creativecommons.org/licenses/by/4.0/legalcode","schemeUri":"https://spdx.org/licenses/","rights":"Creative Commons Attribution 4.0 International","rightsIdentifier":"cc-by-4.0"}],"descriptions":[{"descriptionType":"Abstract","description":"We analytically derive the bit-string probability distributions of subsystems of random pure states and depolarized random states using the Dirichlet distribution. We identify the exact Beta distribution as the universal statistical law of random quantum states, providing a unified finite-size description of full-system, subsystem, and conditional statistics. In the presence of depolarizing noise, these distributions are scaled and shifted by the noise strength, producing a noise-induced gap in their support. Remarkably, we prove that random states exhibit exact conditional self-similarity: the distribution of subsystem bit-string probabilities conditioned on specific outcomes of the complementary subsystem is identical to that of the full system. This hidden scale invariance enables the exact restoration of the full-system statistics from the marginalized Beta distribution via post-selection, and persists under depolarizing noise. Our results uncover a fundamental symmetry of Hilbert space and provide a scalable, rigorous framework for validating random circuit sampling via subsystem or conditional cross-entropy benchmarking."},{"descriptionType":"Other","description":"6 pages, 3 figures, submitted to a journal"}],"geoLocations":[],"fundingReferences":[],"url":"https://arxiv.org/abs/2602.19448","contentUrl":null,"metadataVersion":0,"schemaVersion":"http://datacite.org/schema/kernel-4","source":"mds","isActive":true,"state":"findable","reason":null,"viewCount":0,"downloadCount":0,"referenceCount":0,"citationCount":0,"partCount":0,"partOfCount":0,"versionCount":0,"versionOfCount":0,"created":"2026-02-25T15:00:52Z","registered":"2026-02-25T15:00:53Z","published":null,"updated":"2026-02-25T15:00:53Z"},"relationships":{"client":{"data":{"id":"arxiv.content","type":"clients"}}}},{"id":"10.48550/arxiv.2602.19447","type":"dois","attributes":{"doi":"10.48550/arxiv.2602.19447","identifiers":[{"identifier":"2602.19447","identifierType":"arXiv"}],"creators":[{"nameType":"Personal","givenName":"Dale","familyName":"Giancono","name":"Giancono, Dale","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Hadrien","familyName":"Devillepoix","name":"Devillepoix, Hadrien","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Robert","familyName":"Howie","name":"Howie, Robert","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Denis","familyName":"Vida","name":"Vida, Denis","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"David","familyName":"Rollinson","name":"Rollinson, David","affiliation":[],"nameIdentifiers":[]}],"titles":[{"title":"Photometry of Fireballs using High Frame Rate Cameras"}],"publisher":"arXiv","container":{},"publicationYear":2026,"subjects":[{"subject":"Instrumentation and Methods for Astrophysics (astro-ph.IM)","lang":"en","subjectScheme":"arXiv"},{"subject":"Earth and Planetary Astrophysics (astro-ph.EP)","lang":"en","subjectScheme":"arXiv"},{"subject":"FOS: Physical sciences","subjectScheme":"Fields of Science and Technology (FOS)"},{"schemeUri":"http://www.oecd.org/science/inno/38235147.pdf","subject":"FOS: Physical sciences","subjectScheme":"Fields of Science and Technology (FOS)"}],"contributors":[],"dates":[{"date":"2026-02-23T02:38:24Z","dateType":"Submitted","dateInformation":"v1"},{"date":"2026-02-24T02:05:42Z","dateType":"Updated","dateInformation":"v1"},{"date":"2026-02","dateType":"Available","dateInformation":"v1"},{"date":"2026","dateType":"Issued"}],"language":null,"types":{"schemaOrg":"CreativeWork","resourceTypeGeneral":"Preprint","citeproc":"article","bibtex":"misc","ris":"GEN","resourceType":"Article"},"relatedIdentifiers":[{"relationType":"IsVersionOf","relatedIdentifier":"10.1017/pasa.2026.10162","relatedIdentifierType":"DOI"}],"relatedItems":[],"sizes":[],"formats":[],"version":"1","rightsList":[{"rightsIdentifierScheme":"SPDX","rightsUri":"https://creativecommons.org/licenses/by/4.0/legalcode","schemeUri":"https://spdx.org/licenses/","rights":"Creative Commons Attribution 4.0 International","rightsIdentifier":"cc-by-4.0"}],"descriptions":[{"descriptionType":"Abstract","description":"Fast sampling photometry is essential for characterising fireballs and their fragmentation episodes which link to the meteoroid internal structure. Accurate measurements remain challenging due to the large required dynamic range of up to 10 stellar magnitudes driving up operational complexity and cost. We developed an all-sky camera system operating at up to 500 frames per second featuring a novel Detection Localised Auto-brightness Control. Custom software manages high data throughput via transient detection and region-of-interest saving with real-time photometry. Two field deployments validate photometric accuracy against conventional 30 frames per second cameras and demonstrate the successful capture of a bright magnitude -15 fireball with minimal saturation. The system achieves an effective dynamic range between apparent magnitudes -3 and -17 capturing minimally saturated light curves for most fireballs. A successful semi-empirical fragmentation analysis verifies its ability to provide data for detailed physical modelling. The primary application for this validated system will be as a core component of the Global Fireball Observatory's next-generation instrumentation. The intention is to deploy it in a hybrid observatory, operating alongside a dedicated high-resolution astrometric camera. This configuration will allow the network to simultaneously capture precise trajectory data for orbit and fall-line calculations and acquire complete, unsaturated high dynamic range light curves at high temporal resolution for detailed physical analysis, combining the strengths of both systems."}],"geoLocations":[],"fundingReferences":[],"url":"https://arxiv.org/abs/2602.19447","contentUrl":null,"metadataVersion":0,"schemaVersion":"http://datacite.org/schema/kernel-4","source":"mds","isActive":true,"state":"findable","reason":null,"viewCount":0,"downloadCount":0,"referenceCount":0,"citationCount":0,"partCount":0,"partOfCount":0,"versionCount":0,"versionOfCount":1,"created":"2026-02-25T15:00:50Z","registered":"2026-02-25T15:00:51Z","published":null,"updated":"2026-02-25T15:00:51Z"},"relationships":{"client":{"data":{"id":"arxiv.content","type":"clients"}}}},{"id":"10.48550/arxiv.2602.19446","type":"dois","attributes":{"doi":"10.48550/arxiv.2602.19446","identifiers":[{"identifier":"2602.19446","identifierType":"arXiv"}],"creators":[{"nameType":"Personal","givenName":"Masudul Hasan Masud","familyName":"Bhuiyan","name":"Bhuiyan, Masudul Hasan Masud","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Manish Kumar Bala","familyName":"Kumar","name":"Kumar, Manish Kumar Bala","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Cristian-Alexandru","familyName":"Staicu","name":"Staicu, Cristian-Alexandru","affiliation":[],"nameIdentifiers":[]}],"titles":[{"title":"\"Write in English, Nobody Understands Your Language Here\": A Study of Non-English Trends in Open-Source Repositories"}],"publisher":"arXiv","container":{},"publicationYear":2026,"subjects":[{"subject":"Software Engineering (cs.SE)","lang":"en","subjectScheme":"arXiv"},{"subject":"Computers and Society (cs.CY)","lang":"en","subjectScheme":"arXiv"},{"subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"},{"schemeUri":"http://www.oecd.org/science/inno/38235147.pdf","subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"}],"contributors":[],"dates":[{"date":"2026-02-23T02:31:15Z","dateType":"Submitted","dateInformation":"v1"},{"date":"2026-02-24T02:05:32Z","dateType":"Updated","dateInformation":"v1"},{"date":"2026-02","dateType":"Available","dateInformation":"v1"},{"date":"2026","dateType":"Issued"}],"language":null,"types":{"schemaOrg":"CreativeWork","resourceTypeGeneral":"Preprint","citeproc":"article","bibtex":"misc","ris":"GEN","resourceType":"Article"},"relatedIdentifiers":[{"relationType":"IsVersionOf","relatedIdentifier":"10.1145/3744916.3787766","relatedIdentifierType":"DOI"}],"relatedItems":[],"sizes":[],"formats":[],"version":"1","rightsList":[{"rightsIdentifierScheme":"SPDX","rightsUri":"https://creativecommons.org/licenses/by/4.0/legalcode","schemeUri":"https://spdx.org/licenses/","rights":"Creative Commons Attribution 4.0 International","rightsIdentifier":"cc-by-4.0"}],"descriptions":[{"descriptionType":"Abstract","description":"The open-source software (OSS) community has historically been dominated by English as the primary language for code, documentation, and developer interactions. However, with growing global participation and better support for non-Latin scripts through standards like Unicode, OSS is gradually becoming more multilingual. This study investigates the extent to which OSS is becoming more multilingual, analyzing 9.14 billion GitHub issues, pull requests, and discussions, and 62,500 repositories across five programming languages and 30 natural languages, covering the period from 2015 to 2025. We examine six research questions to track changes in language use across communication, code, and documentation. We find that multilingual participation has steadily increased, especially in Korean, Chinese, and Russian. This growth appears not only in issues and discussions but also in code comments, string literals, and documentation files. While this shift reflects greater inclusivity and language diversity in OSS, it also creates language tension. The ability to express oneself in a native language can clash with shared norms around English use, especially in collaborative settings. Non-English or multilingual projects tend to receive less visibility and participation, suggesting that language remains both a resource and a barrier, shaping who gets heard, who contributes, and how open collaboration unfolds."}],"geoLocations":[],"fundingReferences":[],"url":"https://arxiv.org/abs/2602.19446","contentUrl":null,"metadataVersion":0,"schemaVersion":"http://datacite.org/schema/kernel-4","source":"mds","isActive":true,"state":"findable","reason":null,"viewCount":0,"downloadCount":0,"referenceCount":0,"citationCount":0,"partCount":0,"partOfCount":0,"versionCount":0,"versionOfCount":1,"created":"2026-02-25T15:00:47Z","registered":"2026-02-25T15:00:48Z","published":null,"updated":"2026-02-25T15:00:48Z"},"relationships":{"client":{"data":{"id":"arxiv.content","type":"clients"}}}},{"id":"10.48550/arxiv.2602.19444","type":"dois","attributes":{"doi":"10.48550/arxiv.2602.19444","identifiers":[{"identifier":"2602.19444","identifierType":"arXiv"}],"creators":[{"nameType":"Personal","givenName":"Qianfeng","familyName":"Yu","name":"Yu, Qianfeng","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Ningkang","familyName":"Peng","name":"Peng, Ningkang","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Yanhui","familyName":"Gu","name":"Gu, Yanhui","affiliation":[],"nameIdentifiers":[]}],"titles":[{"title":"PIS: A Physics-Informed System for Accurate State Partitioning of $Aβ_{42}$ Protein Trajectories"}],"publisher":"arXiv","container":{},"publicationYear":2026,"subjects":[{"subject":"Machine Learning (cs.LG)","lang":"en","subjectScheme":"arXiv"},{"subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"},{"schemeUri":"http://www.oecd.org/science/inno/38235147.pdf","subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"}],"contributors":[],"dates":[{"date":"2026-02-23T02:27:18Z","dateType":"Submitted","dateInformation":"v1"},{"date":"2026-02-24T02:05:22Z","dateType":"Updated","dateInformation":"v1"},{"date":"2026-02","dateType":"Available","dateInformation":"v1"},{"date":"2026","dateType":"Issued"}],"language":null,"types":{"schemaOrg":"CreativeWork","resourceTypeGeneral":"Preprint","citeproc":"article","bibtex":"misc","ris":"GEN","resourceType":"Article"},"relatedIdentifiers":[],"relatedItems":[],"sizes":[],"formats":[],"version":"1","rightsList":[{"rightsUri":"http://arxiv.org/licenses/nonexclusive-distrib/1.0/","rights":"arXiv.org perpetual, non-exclusive license"}],"descriptions":[{"descriptionType":"Abstract","description":"Understanding the conformational evolution of $β$-amyloid ($Aβ$), particularly the $Aβ_{42}$ isoform, is fundamental to elucidating the pathogenic mechanisms underlying Alzheimer's disease. However, existing end-to-end deep learning models often struggle to capture subtle state transitions in protein trajectories due to a lack of explicit physical constraints. In this work, we introduce PIS, a Physics-Informed System designed for robust metastable state partitioning. By integrating pre-computed physical priors, such as the radius of gyration and solvent-accessible surface area, into the extraction of topological features, our model achieves superior performance on the $Aβ_{42}$ dataset. Furthermore, PIS provides an interactive platform that features dynamic monitoring of physical characteristics and multi-dimensional result validation. This system offers biological researchers a powerful set of analytical tools with physically grounded interpretability. A demonstration video of PIS is available on https://youtu.be/AJHGzUtRCg0."}],"geoLocations":[],"fundingReferences":[],"url":"https://arxiv.org/abs/2602.19444","contentUrl":null,"metadataVersion":0,"schemaVersion":"http://datacite.org/schema/kernel-4","source":"mds","isActive":true,"state":"findable","reason":null,"viewCount":0,"downloadCount":0,"referenceCount":0,"citationCount":0,"partCount":0,"partOfCount":0,"versionCount":0,"versionOfCount":0,"created":"2026-02-25T15:00:42Z","registered":"2026-02-25T15:00:43Z","published":null,"updated":"2026-02-25T15:00:43Z"},"relationships":{"client":{"data":{"id":"arxiv.content","type":"clients"}}}},{"id":"10.48550/arxiv.2602.19443","type":"dois","attributes":{"doi":"10.48550/arxiv.2602.19443","identifiers":[{"identifier":"2602.19443","identifierType":"arXiv"}],"creators":[{"nameType":"Personal","givenName":"L. B. A.","familyName":"Mélo","name":"Mélo, L. B. A.","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Daniel","familyName":"Felinto","name":"Felinto, Daniel","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Marcio H. G.","familyName":"de Miranda","name":"de Miranda, Marcio H. G.","affiliation":[],"nameIdentifiers":[]}],"titles":[{"title":"Optimized Phase Masks for Absorption of Ultra-Broadband Pulses by Narrowband Atomic Ensembles"}],"publisher":"arXiv","container":{},"publicationYear":2026,"subjects":[{"subject":"Atomic Physics (physics.atom-ph)","lang":"en","subjectScheme":"arXiv"},{"subject":"Optics (physics.optics)","lang":"en","subjectScheme":"arXiv"},{"subject":"Quantum Physics (quant-ph)","lang":"en","subjectScheme":"arXiv"},{"subject":"FOS: Physical sciences","subjectScheme":"Fields of Science and Technology (FOS)"},{"schemeUri":"http://www.oecd.org/science/inno/38235147.pdf","subject":"FOS: Physical sciences","subjectScheme":"Fields of Science and Technology (FOS)"}],"contributors":[],"dates":[{"date":"2026-02-23T02:25:42Z","dateType":"Submitted","dateInformation":"v1"},{"date":"2026-02-24T02:05:19Z","dateType":"Updated","dateInformation":"v1"},{"date":"2026-02","dateType":"Available","dateInformation":"v1"},{"date":"2026","dateType":"Issued"}],"language":null,"types":{"schemaOrg":"CreativeWork","resourceTypeGeneral":"Preprint","citeproc":"article","bibtex":"misc","ris":"GEN","resourceType":"Article"},"relatedIdentifiers":[{"relationType":"IsVersionOf","relatedIdentifier":"10.1364/josab.500120","relatedIdentifierType":"DOI"}],"relatedItems":[],"sizes":[],"formats":[],"version":"1","rightsList":[{"rightsUri":"http://arxiv.org/licenses/nonexclusive-distrib/1.0/","rights":"arXiv.org perpetual, non-exclusive license"}],"descriptions":[{"descriptionType":"Abstract","description":"By combining genetic algorithm and a spatial light modulator we theoretically analyse how to improve a two-photon cascade absorption in atomic ensembles, inspecting the impact of various configurations and parameters in the optimized phase mask. At low atomic densities, we compare the cases of sequential transitions with the two photons coming from the same pulse or from two different pulses. For the former, we predict an enhancement by a factor of $9.5$, similar to what was previously reported in the literature [Phys. Rev. Lett. {\\bf 86}, 47 (2002)]. For the later, on the other hand, we obtain an enhancement factor of $26$ times. This absorption of two photons by different pulses is of particular interest for the storage of ultra-broadband single photons by atomic ensembles, in which case the second photon would come from a control pulse. We investigate this process as a function of the atomic density, demonstrating enhancements by factors up to 3 for the two-photon absorption after propagating through large optical depths. However, for the experimental conditions considered in the previous work by Carvalho {et al.} [Phys. Rev. A {\\bf 101}, 053426 (2020)], in terms of control power and optical depths, we show that this enhancement in two-photon absorption would still result in just a modest increase of the absorption of a weak probe pulse."}],"geoLocations":[],"fundingReferences":[],"url":"https://arxiv.org/abs/2602.19443","contentUrl":null,"metadataVersion":0,"schemaVersion":"http://datacite.org/schema/kernel-4","source":"mds","isActive":true,"state":"findable","reason":null,"viewCount":0,"downloadCount":0,"referenceCount":0,"citationCount":0,"partCount":0,"partOfCount":0,"versionCount":0,"versionOfCount":1,"created":"2026-02-25T15:00:40Z","registered":"2026-02-25T15:00:40Z","published":null,"updated":"2026-02-25T15:00:41Z"},"relationships":{"client":{"data":{"id":"arxiv.content","type":"clients"}}}},{"id":"10.48550/arxiv.2602.19441","type":"dois","attributes":{"doi":"10.48550/arxiv.2602.19441","identifiers":[{"identifier":"2602.19441","identifierType":"arXiv"}],"creators":[{"nameType":"Personal","givenName":"Costain","familyName":"Nachuma","name":"Nachuma, Costain","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Minhaz","familyName":"Zibran","name":"Zibran, Minhaz","affiliation":[],"nameIdentifiers":[]}],"titles":[{"title":"When AI Teammates Meet Code Review: Collaboration Signals Shaping the Integration of Agent-Authored Pull Requests"}],"publisher":"arXiv","container":{},"publicationYear":2026,"subjects":[{"subject":"Software Engineering (cs.SE)","lang":"en","subjectScheme":"arXiv"},{"subject":"Artificial Intelligence (cs.AI)","lang":"en","subjectScheme":"arXiv"},{"subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"},{"schemeUri":"http://www.oecd.org/science/inno/38235147.pdf","subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"}],"contributors":[],"dates":[{"date":"2026-02-23T02:20:56Z","dateType":"Submitted","dateInformation":"v1"},{"date":"2026-02-24T02:05:09Z","dateType":"Updated","dateInformation":"v1"},{"date":"2026-02","dateType":"Available","dateInformation":"v1"},{"date":"2026","dateType":"Issued"}],"language":null,"types":{"schemaOrg":"CreativeWork","resourceTypeGeneral":"Preprint","citeproc":"article","bibtex":"misc","ris":"GEN","resourceType":"Article"},"relatedIdentifiers":[],"relatedItems":[],"sizes":[],"formats":[],"version":"1","rightsList":[{"rightsIdentifierScheme":"SPDX","rightsUri":"https://creativecommons.org/licenses/by/4.0/legalcode","schemeUri":"https://spdx.org/licenses/","rights":"Creative Commons Attribution 4.0 International","rightsIdentifier":"cc-by-4.0"}],"descriptions":[{"descriptionType":"Abstract","description":"Autonomous coding agents increasingly contribute to software development by submitting pull requests on GitHub; yet, little is known about how these contributions integrate into human-driven review workflows. We present a large empirical study of agent-authored pull requests using the public AIDev dataset, examining integration outcomes, resolution speed, and review-time collaboration signals. Using logistic regression with repository-clustered standard errors, we find that reviewer engagement has the strongest correlation with successful integration, whereas larger change sizes and coordination-disrupting actions, such as force pushes, are associated with a lower likelihood of merging. In contrast, iteration intensity alone provides limited explanatory power once collaboration signals are considered. A qualitative analysis further shows that successful integration occurs when agents engage in actionable review loops that converge toward reviewer expectations. Overall, our results highlight that the effective integration of agent-authored pull requests depends not only on code quality but also on alignment with established review and coordination practices."},{"descriptionType":"Other","description":"5 pages, 2 figures, 1 table. Accepted at the 23rd International Conference on Mining Software Repositories (MSR 2026), Rio de Janeiro, Brazil"}],"geoLocations":[],"fundingReferences":[],"url":"https://arxiv.org/abs/2602.19441","contentUrl":null,"metadataVersion":0,"schemaVersion":"http://datacite.org/schema/kernel-4","source":"mds","isActive":true,"state":"findable","reason":null,"viewCount":0,"downloadCount":0,"referenceCount":0,"citationCount":0,"partCount":0,"partOfCount":0,"versionCount":0,"versionOfCount":0,"created":"2026-02-25T15:00:35Z","registered":"2026-02-25T15:00:35Z","published":null,"updated":"2026-02-25T15:00:35Z"},"relationships":{"client":{"data":{"id":"arxiv.content","type":"clients"}}}},{"id":"10.48550/arxiv.2602.19440","type":"dois","attributes":{"doi":"10.48550/arxiv.2602.19440","identifiers":[{"identifier":"2602.19440","identifierType":"arXiv"}],"creators":[{"nameType":"Personal","givenName":"Toshihiro","familyName":"Suzuki","name":"Suzuki, Toshihiro","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Hiroyuki","familyName":"Yamada","name":"Yamada, Hiroyuki","affiliation":[],"nameIdentifiers":[]}],"titles":[{"title":"Breaking the Barriers of Database-Agnostic Transactions"}],"publisher":"arXiv","container":{},"publicationYear":2026,"subjects":[{"subject":"Databases (cs.DB)","lang":"en","subjectScheme":"arXiv"},{"subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"},{"schemeUri":"http://www.oecd.org/science/inno/38235147.pdf","subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"}],"contributors":[],"dates":[{"date":"2026-02-23T02:20:14Z","dateType":"Submitted","dateInformation":"v1"},{"date":"2026-02-24T02:05:09Z","dateType":"Updated","dateInformation":"v1"},{"date":"2026-02","dateType":"Available","dateInformation":"v1"},{"date":"2026","dateType":"Issued"}],"language":null,"types":{"schemaOrg":"CreativeWork","resourceTypeGeneral":"Preprint","citeproc":"article","bibtex":"misc","ris":"GEN","resourceType":"Article"},"relatedIdentifiers":[],"relatedItems":[],"sizes":[],"formats":[],"version":"1","rightsList":[{"rightsIdentifierScheme":"SPDX","rightsUri":"https://creativecommons.org/licenses/by/4.0/legalcode","schemeUri":"https://spdx.org/licenses/","rights":"Creative Commons Attribution 4.0 International","rightsIdentifier":"cc-by-4.0"}],"descriptions":[{"descriptionType":"Abstract","description":"Federated transaction management has long been used as a method to virtually integrate multiple databases from a transactional perspective, ensuring consistency across the databases. Modern approaches manage transactions on top of a database abstraction to achieve database agnosticism; however, these approaches face several challenges. First, managing transactions on top of a database abstraction makes performance optimization difficult because the abstraction hides away the details of underlying databases, such as database-specific capabilities. Additionally, it requires that application data and the associated transaction metadata be colocated in the same record to allow for efficient updates, necessitating a schema migration to run federated transactions on top of existing databases. This paper introduces a new concept in such database abstraction called Atomicity Unit (AU) to address these challenges. AU enables federated transaction management to aggressively pushdown database operations by making use of the knowledge about the scope within which they can perform operations atomically, fully harnessing the performance of the databases. Moreover, AU enables efficient separation of transaction metadata from application data, allowing federated transactions to run on existing databases without requiring a schema migration or significant performance degradation. In this paper, we describe AU, how AU addresses the challenges, and its implementation within ScalarDB, an open-sourced database-agnostic federated transaction manager. We also present evaluation results demonstrating that ScalarDB with AU achieves significantly better performance and efficient metadata separation."},{"descriptionType":"Other","description":"technical report (preprint)"}],"geoLocations":[],"fundingReferences":[],"url":"https://arxiv.org/abs/2602.19440","contentUrl":null,"metadataVersion":0,"schemaVersion":"http://datacite.org/schema/kernel-4","source":"mds","isActive":true,"state":"findable","reason":null,"viewCount":0,"downloadCount":0,"referenceCount":0,"citationCount":0,"partCount":0,"partOfCount":0,"versionCount":0,"versionOfCount":0,"created":"2026-02-25T15:00:32Z","registered":"2026-02-25T15:00:33Z","published":null,"updated":"2026-02-25T15:00:33Z"},"relationships":{"client":{"data":{"id":"arxiv.content","type":"clients"}}}},{"id":"10.48550/arxiv.2602.19437","type":"dois","attributes":{"doi":"10.48550/arxiv.2602.19437","identifiers":[{"identifier":"2602.19437","identifierType":"arXiv"}],"creators":[{"nameType":"Personal","givenName":"Jinsong","familyName":"Yang","name":"Yang, Jinsong","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Zeyuan","familyName":"Hu","name":"Hu, Zeyuan","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Yichen","familyName":"Li","name":"Li, Yichen","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Hong","familyName":"Yu","name":"Yu, Hong","affiliation":[],"nameIdentifiers":[]}],"titles":[{"title":"FinSight-Net:A Physics-Aware Decoupled Network with Frequency-Domain Compensation for Underwater Fish Detection in Smart Aquaculture"}],"publisher":"arXiv","container":{},"publicationYear":2026,"subjects":[{"subject":"Computer Vision and Pattern Recognition (cs.CV)","lang":"en","subjectScheme":"arXiv"},{"subject":"Artificial Intelligence (cs.AI)","lang":"en","subjectScheme":"arXiv"},{"subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"},{"schemeUri":"http://www.oecd.org/science/inno/38235147.pdf","subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"}],"contributors":[],"dates":[{"date":"2026-02-23T02:12:47Z","dateType":"Submitted","dateInformation":"v1"},{"date":"2026-02-24T02:04:55Z","dateType":"Updated","dateInformation":"v1"},{"date":"2026-02","dateType":"Available","dateInformation":"v1"},{"date":"2026","dateType":"Issued"}],"language":null,"types":{"schemaOrg":"CreativeWork","resourceTypeGeneral":"Preprint","citeproc":"article","bibtex":"misc","ris":"GEN","resourceType":"Article"},"relatedIdentifiers":[],"relatedItems":[],"sizes":[],"formats":[],"version":"1","rightsList":[{"rightsUri":"http://arxiv.org/licenses/nonexclusive-distrib/1.0/","rights":"arXiv.org perpetual, non-exclusive license"}],"descriptions":[{"descriptionType":"Abstract","description":"Underwater fish detection (UFD) is a core capability for smart aquaculture and marine ecological monitoring. While recent detectors improve accuracy by stacking feature extractors or introducing heavy attention modules, they often incur substantial computational overhead and, more importantly, neglect the physics that fundamentally limits UFD: wavelength-dependent absorption and turbidity-induced scattering significantly degrade contrast, blur fine structures, and introduce backscattering noise, leading to unreliable localization and recognition. To address these challenges, we propose FinSight-Net, an efficient and physics-aware detection framework tailored for complex aquaculture environments. FinSight-Net introduces a Multi-Scale Decoupled Dual-Stream Processing (MS-DDSP) bottleneck that explicitly targets frequency-specific information loss via heterogeneous convolutional branches, suppressing backscattering artifacts while compensating distorted biological cues through scale-aware and channel-weighted pathways. We further design an Efficient Path Aggregation FPN (EPA-FPN) as a detail-filling mechanism: it restores high-frequency spatial information typically attenuated in deep layers by establishing long-range skip connections and pruning redundant fusion routes, enabling robust detection of non-rigid fish targets under severe blur and turbidity. Extensive experiments on DeepFish, AquaFishSet, and our challenging UW-BlurredFish benchmark demonstrate that FinSight-Net achieves state-of-the-art performance. In particular, on UW-BlurredFish, FinSight-Net reaches 92.8% mAP, outperforming YOLOv11s by 4.8% while reducing parameters by 29.0%, providing a strong and lightweight solution for real-time automated monitoring in smart aquaculture."}],"geoLocations":[],"fundingReferences":[],"url":"https://arxiv.org/abs/2602.19437","contentUrl":null,"metadataVersion":0,"schemaVersion":"http://datacite.org/schema/kernel-4","source":"mds","isActive":true,"state":"findable","reason":null,"viewCount":0,"downloadCount":0,"referenceCount":0,"citationCount":0,"partCount":0,"partOfCount":0,"versionCount":0,"versionOfCount":0,"created":"2026-02-25T15:00:25Z","registered":"2026-02-25T15:00:26Z","published":null,"updated":"2026-02-25T15:00:26Z"},"relationships":{"client":{"data":{"id":"arxiv.content","type":"clients"}}}},{"id":"10.48550/arxiv.2602.19434","type":"dois","attributes":{"doi":"10.48550/arxiv.2602.19434","identifiers":[{"identifier":"2602.19434","identifierType":"arXiv"}],"creators":[{"nameType":"Personal","givenName":"Chris","familyName":"Gartland","name":"Gartland, Chris","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Mikhail","familyName":"Ostrovskii","name":"Ostrovskii, Mikhail","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Yuval","familyName":"Rabani","name":"Rabani, Yuval","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Robert","familyName":"Young","name":"Young, Robert","affiliation":[],"nameIdentifiers":[]}],"titles":[{"title":"$L_1$-distortion of Earth Mover Distances and Transportation Cost Spaces on High Dimensional Grids"}],"publisher":"arXiv","container":{},"publicationYear":2026,"subjects":[{"subject":"Functional Analysis (math.FA)","lang":"en","subjectScheme":"arXiv"},{"subject":"Computational Geometry (cs.CG)","lang":"en","subjectScheme":"arXiv"},{"subject":"Metric Geometry (math.MG)","lang":"en","subjectScheme":"arXiv"},{"subject":"FOS: Mathematics","subjectScheme":"Fields of Science and Technology (FOS)"},{"schemeUri":"http://www.oecd.org/science/inno/38235147.pdf","subject":"FOS: Mathematics","subjectScheme":"Fields of Science and Technology (FOS)"},{"subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"},{"schemeUri":"http://www.oecd.org/science/inno/38235147.pdf","subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"}],"contributors":[],"dates":[{"date":"2026-02-23T02:03:42Z","dateType":"Submitted","dateInformation":"v1"},{"date":"2026-02-24T02:04:39Z","dateType":"Updated","dateInformation":"v1"},{"date":"2026-02","dateType":"Available","dateInformation":"v1"},{"date":"2026","dateType":"Issued"}],"language":null,"types":{"schemaOrg":"CreativeWork","resourceTypeGeneral":"Preprint","citeproc":"article","bibtex":"misc","ris":"GEN","resourceType":"Article"},"relatedIdentifiers":[],"relatedItems":[],"sizes":[],"formats":[],"version":"1","rightsList":[{"rightsUri":"http://arxiv.org/licenses/nonexclusive-distrib/1.0/","rights":"arXiv.org perpetual, non-exclusive license"}],"descriptions":[{"descriptionType":"Abstract","description":"We prove that the distortion of any embedding into $L_1$ of the transportation cost space or earth mover distance over a $d$-dimensional grid $\\{1,\\dots m\\}^d$ is $Ω(\\log N)$, where $N$ is the number of vertices and the implicit constant is universal (in particular, independent of dimension). This lower bound matches the universal upper bound $O(\\log N)$ holding for any $N$-point metric space. Our proof relies on a new Sobolev inequality for real-valued functions on the grid, based on random measures supported on dyadic cubes."},{"descriptionType":"Other","description":"15 pages"}],"geoLocations":[],"fundingReferences":[],"url":"https://arxiv.org/abs/2602.19434","contentUrl":null,"metadataVersion":0,"schemaVersion":"http://datacite.org/schema/kernel-4","source":"mds","isActive":true,"state":"findable","reason":null,"viewCount":0,"downloadCount":0,"referenceCount":0,"citationCount":0,"partCount":0,"partOfCount":0,"versionCount":0,"versionOfCount":0,"created":"2026-02-25T15:00:17Z","registered":"2026-02-25T15:00:18Z","published":null,"updated":"2026-02-25T15:00:18Z"},"relationships":{"client":{"data":{"id":"arxiv.content","type":"clients"}}}},{"id":"10.48550/arxiv.2602.19432","type":"dois","attributes":{"doi":"10.48550/arxiv.2602.19432","identifiers":[{"identifier":"2602.19432","identifierType":"arXiv"}],"creators":[{"nameType":"Personal","givenName":"Yifeng","familyName":"Huang","name":"Huang, Yifeng","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Gia Khanh","familyName":"Nguyen","name":"Nguyen, Gia Khanh","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Minh","familyName":"Hoai","name":"Hoai, Minh","affiliation":[],"nameIdentifiers":[]}],"titles":[{"title":"CountEx: Fine-Grained Counting via Exemplars and Exclusion"}],"publisher":"arXiv","container":{},"publicationYear":2026,"subjects":[{"subject":"Computer Vision and Pattern Recognition (cs.CV)","lang":"en","subjectScheme":"arXiv"},{"subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"},{"schemeUri":"http://www.oecd.org/science/inno/38235147.pdf","subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"}],"contributors":[],"dates":[{"date":"2026-02-23T02:01:44Z","dateType":"Submitted","dateInformation":"v1"},{"date":"2026-02-24T02:04:35Z","dateType":"Updated","dateInformation":"v1"},{"date":"2026-02","dateType":"Available","dateInformation":"v1"},{"date":"2026","dateType":"Issued"}],"language":null,"types":{"schemaOrg":"CreativeWork","resourceTypeGeneral":"Preprint","citeproc":"article","bibtex":"misc","ris":"GEN","resourceType":"Article"},"relatedIdentifiers":[],"relatedItems":[],"sizes":[],"formats":[],"version":"1","rightsList":[{"rightsIdentifierScheme":"SPDX","rightsUri":"https://creativecommons.org/licenses/by/4.0/legalcode","schemeUri":"https://spdx.org/licenses/","rights":"Creative Commons Attribution 4.0 International","rightsIdentifier":"cc-by-4.0"}],"descriptions":[{"descriptionType":"Abstract","description":"This paper presents CountEx, a discriminative visual counting framework designed to address a key limitation of existing prompt-based methods: the inability to explicitly exclude visually similar distractors. While current approaches allow users to specify what to count via inclusion prompts, they often struggle in cluttered scenes with confusable object categories, leading to ambiguity and overcounting. CountEx enables users to express both inclusion and exclusion intent, specifying what to count and what to ignore, through multimodal prompts including natural language descriptions and optional visual exemplars. At the core of CountEx is a novel Discriminative Query Refinement module, which jointly reasons over inclusion and exclusion cues by first identifying shared visual features, then isolating exclusion-specific patterns, and finally applying selective suppression to refine the counting query. To support systematic evaluation of fine-grained counting methods, we introduce CoCount, a benchmark comprising 1,780 videos and 10,086 annotated frames across 97 category pairs. Experiments show that CountEx achieves substantial improvements over state-of-the-art methods for counting objects from both known and novel categories. The data and code are available at https://github.com/bbvisual/CountEx."}],"geoLocations":[],"fundingReferences":[],"url":"https://arxiv.org/abs/2602.19432","contentUrl":null,"metadataVersion":0,"schemaVersion":"http://datacite.org/schema/kernel-4","source":"mds","isActive":true,"state":"findable","reason":null,"viewCount":0,"downloadCount":0,"referenceCount":0,"citationCount":0,"partCount":0,"partOfCount":0,"versionCount":0,"versionOfCount":0,"created":"2026-02-25T15:00:12Z","registered":"2026-02-25T15:00:13Z","published":null,"updated":"2026-02-25T15:00:13Z"},"relationships":{"client":{"data":{"id":"arxiv.content","type":"clients"}}}},{"id":"10.48550/arxiv.2602.19429","type":"dois","attributes":{"doi":"10.48550/arxiv.2602.19429","identifiers":[{"identifier":"2602.19429","identifierType":"arXiv"}],"creators":[{"nameType":"Personal","givenName":"Dong","familyName":"Wu","name":"Wu, Dong","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Shuaihao","familyName":"Zhang","name":"Zhang, Shuaihao","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Weiyi","familyName":"Kong","name":"Kong, Weiyi","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Xiangyu","familyName":"Hu","name":"Hu, Xiangyu","affiliation":[],"nameIdentifiers":[]}],"titles":[{"title":"A unified SPH framework for shell-related interactions"}],"publisher":"arXiv","container":{},"publicationYear":2026,"subjects":[{"subject":"Fluid Dynamics (physics.flu-dyn)","lang":"en","subjectScheme":"arXiv"},{"subject":"FOS: Physical sciences","subjectScheme":"Fields of Science and Technology (FOS)"},{"schemeUri":"http://www.oecd.org/science/inno/38235147.pdf","subject":"FOS: Physical sciences","subjectScheme":"Fields of Science and Technology (FOS)"}],"contributors":[],"dates":[{"date":"2026-02-23T01:56:19Z","dateType":"Submitted","dateInformation":"v1"},{"date":"2026-02-24T02:04:19Z","dateType":"Updated","dateInformation":"v1"},{"date":"2026-02","dateType":"Available","dateInformation":"v1"},{"date":"2026","dateType":"Issued"}],"language":null,"types":{"schemaOrg":"CreativeWork","resourceTypeGeneral":"Preprint","citeproc":"article","bibtex":"misc","ris":"GEN","resourceType":"Article"},"relatedIdentifiers":[],"relatedItems":[],"sizes":[],"formats":[],"version":"1","rightsList":[{"rightsUri":"http://arxiv.org/licenses/nonexclusive-distrib/1.0/","rights":"arXiv.org perpetual, non-exclusive license"}],"descriptions":[{"descriptionType":"Abstract","description":"A unified Smoothed Particle Hydrodynamics (SPH) framework is proposed to simulate interaction dynamics involving thin shells modeled by a reduced-dimensional, single-layer particle discretization, as opposed to full-dimensional SPH solids. The framework encompasses one-sided fluid-shell interactions, with the fluid present on only one side of the shell, as well as solid-shell, shell-shell, and shell-self interactions The study introduces a novel concept of imaginary shell contact particles, generated by projecting real shell particles along the local normal direction within the cut-off radius of the fluid particle, thereby mapping this reduced-dimensional shell model into a full-dimensional representation. With the volume of the imaginary particles defined based on the local shell curvature, the projection preserves kernel completeness for fluid-shell interactions while leaving the fluid-structure interaction (FSI) dynamics unchanged, such that the fluid-shell coupling algorithm is the same as in standard fluid-solid coupling. In addition, a particle-to-particle contact model for solid-solid interactions is developed by analogy to fluid dynamics: a contact density is computed using a fluid-style density initialization, and the resulting contact forces follow a momentum-equation-inspired formulation. Combined with the projection strategy, this contact formulation is directly extended to efficiently handle shell-related contact problems. The proposed method is validated using a series of benchmark tests, demonstrating stable and accurate performance across diverse interaction scenarios."}],"geoLocations":[],"fundingReferences":[],"url":"https://arxiv.org/abs/2602.19429","contentUrl":null,"metadataVersion":0,"schemaVersion":"http://datacite.org/schema/kernel-4","source":"mds","isActive":true,"state":"findable","reason":null,"viewCount":0,"downloadCount":0,"referenceCount":0,"citationCount":0,"partCount":0,"partOfCount":0,"versionCount":0,"versionOfCount":0,"created":"2026-02-25T15:00:05Z","registered":"2026-02-25T15:00:06Z","published":null,"updated":"2026-02-25T15:00:06Z"},"relationships":{"client":{"data":{"id":"arxiv.content","type":"clients"}}}},{"id":"10.48550/arxiv.2602.19428","type":"dois","attributes":{"doi":"10.48550/arxiv.2602.19428","identifiers":[{"identifier":"2602.19428","identifierType":"arXiv"}],"creators":[{"nameType":"Personal","givenName":"Taiyo","familyName":"Mantani","name":"Mantani, Taiyo","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Hikaru","familyName":"Hoshino","name":"Hoshino, Hikaru","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Tomonari","familyName":"Kanazawa","name":"Kanazawa, Tomonari","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Eiko","familyName":"Furutani","name":"Furutani, Eiko","affiliation":[],"nameIdentifiers":[]}],"titles":[{"title":"Sizing of Battery Considering Renewable Energy Bidding Strategy with Reinforcement Learning"}],"publisher":"arXiv","container":{},"publicationYear":2026,"subjects":[{"subject":"Systems and Control (eess.SY)","lang":"en","subjectScheme":"arXiv"},{"subject":"FOS: Electrical engineering, electronic engineering, information engineering","subjectScheme":"Fields of Science and Technology (FOS)"},{"schemeUri":"http://www.oecd.org/science/inno/38235147.pdf","subject":"FOS: Electrical engineering, electronic engineering, information engineering","subjectScheme":"Fields of Science and Technology (FOS)"}],"contributors":[],"dates":[{"date":"2026-02-23T01:56:02Z","dateType":"Submitted","dateInformation":"v1"},{"date":"2026-02-24T02:04:18Z","dateType":"Updated","dateInformation":"v1"},{"date":"2026-02","dateType":"Available","dateInformation":"v1"},{"date":"2026","dateType":"Issued"}],"language":null,"types":{"schemaOrg":"CreativeWork","resourceTypeGeneral":"Preprint","citeproc":"article","bibtex":"misc","ris":"GEN","resourceType":"Article"},"relatedIdentifiers":[{"relationType":"IsVersionOf","relatedIdentifier":"10.1109/pesgm52009.2025.11225126","relatedIdentifierType":"DOI"}],"relatedItems":[],"sizes":[],"formats":[],"version":"1","rightsList":[{"rightsIdentifierScheme":"SPDX","rightsUri":"https://creativecommons.org/licenses/by/4.0/legalcode","schemeUri":"https://spdx.org/licenses/","rights":"Creative Commons Attribution 4.0 International","rightsIdentifier":"cc-by-4.0"}],"descriptions":[{"descriptionType":"Abstract","description":"This paper proposes a novel computationally efficient algorithm for optimal sizing of Battery Energy Storage Systems (BESS) considering renewable energy bidding strategies. Unlike existing two-stage methods, our algorithm enables the cooptimization of both by updating the BESS size during the training of the bidding policy, leveraging an extended reinforcement learning (RL) framework inspired by advancements in embodied cognition. By integrating the Deep Recurrent Q-Network (DRQN) with a distributed RL framework, the proposed algorithm effectively manages uncertainties in renewable generation and market prices while enabling parallel computation for efficiently handling long-term data."}],"geoLocations":[],"fundingReferences":[],"url":"https://arxiv.org/abs/2602.19428","contentUrl":null,"metadataVersion":0,"schemaVersion":"http://datacite.org/schema/kernel-4","source":"mds","isActive":true,"state":"findable","reason":null,"viewCount":0,"downloadCount":0,"referenceCount":0,"citationCount":0,"partCount":0,"partOfCount":0,"versionCount":0,"versionOfCount":1,"created":"2026-02-25T15:00:03Z","registered":"2026-02-25T15:00:03Z","published":null,"updated":"2026-02-25T15:00:03Z"},"relationships":{"client":{"data":{"id":"arxiv.content","type":"clients"}}}},{"id":"10.48550/arxiv.2602.19427","type":"dois","attributes":{"doi":"10.48550/arxiv.2602.19427","identifiers":[{"identifier":"2602.19427","identifierType":"arXiv"}],"creators":[{"nameType":"Personal","givenName":"Rajan","familyName":"Shrestha","name":"Shrestha, Rajan","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Hayder","familyName":"Al-Hraishawi","name":"Al-Hraishawi, Hayder","affiliation":[],"nameIdentifiers":[]}],"titles":[{"title":"Elevation-Aware Supplementary Uplink for Direct Satellite-to-Device Communications"}],"publisher":"arXiv","container":{},"publicationYear":2026,"subjects":[{"subject":"Signal Processing (eess.SP)","lang":"en","subjectScheme":"arXiv"},{"subject":"FOS: Electrical engineering, electronic engineering, information engineering","subjectScheme":"Fields of Science and Technology (FOS)"},{"schemeUri":"http://www.oecd.org/science/inno/38235147.pdf","subject":"FOS: Electrical engineering, electronic engineering, information engineering","subjectScheme":"Fields of Science and Technology (FOS)"}],"contributors":[],"dates":[{"date":"2026-02-23T01:50:26Z","dateType":"Submitted","dateInformation":"v1"},{"date":"2026-02-24T02:04:12Z","dateType":"Updated","dateInformation":"v1"},{"date":"2026-02","dateType":"Available","dateInformation":"v1"},{"date":"2026","dateType":"Issued"}],"language":null,"types":{"schemaOrg":"CreativeWork","resourceTypeGeneral":"Preprint","citeproc":"article","bibtex":"misc","ris":"GEN","resourceType":"Article"},"relatedIdentifiers":[],"relatedItems":[],"sizes":[],"formats":[],"version":"1","rightsList":[{"rightsIdentifierScheme":"SPDX","rightsUri":"https://creativecommons.org/licenses/by/4.0/legalcode","schemeUri":"https://spdx.org/licenses/","rights":"Creative Commons Attribution 4.0 International","rightsIdentifier":"cc-by-4.0"}],"descriptions":[{"descriptionType":"Abstract","description":"Direct satellite-to-device (DS2D) communication enables standard mobile devices to connect directly to low Earth orbit (LEO) satellites, providing global coverage without reliance on terrestrial infrastructure. However, the DS2D uplink is fundamentally constrained by long propagation distances, severe path loss, and stringent user equipment (UE) power limits, making uplink reliability particularly challenging at low elevation angles and beam edges. This paper investigates the integration of supplementary uplink (SUL) technology into DS2D systems to enhance uplink robustness while preserving UE power efficiency. Leveraging the predictable geometry of LEO satellite orbits, we develop an elevation-aware SUL framework that adapts uplink operation across frequency bands based on elevation-dependent link margin estimates. The proposed approach schedules the UE to transmit on either a primary uplink carrier or a lower-frequency SUL carrier. An elevation-aware SUL activation algorithm with hysteresis is introduced to guide uplink carrier selection while preventing frequent switching. Simulation results demonstrate that the proposed SUL framework extends effective uplink coverage toward low-elevation and beam-edge regions, improves uplink availability over a satellite pass, and achieves stable operation with a minimal number of uplink transitions under realistic UE power constraints."}],"geoLocations":[],"fundingReferences":[],"url":"https://arxiv.org/abs/2602.19427","contentUrl":null,"metadataVersion":0,"schemaVersion":"http://datacite.org/schema/kernel-4","source":"mds","isActive":true,"state":"findable","reason":null,"viewCount":0,"downloadCount":0,"referenceCount":0,"citationCount":0,"partCount":0,"partOfCount":0,"versionCount":0,"versionOfCount":0,"created":"2026-02-25T15:00:00Z","registered":"2026-02-25T15:00:01Z","published":null,"updated":"2026-02-25T15:00:01Z"},"relationships":{"client":{"data":{"id":"arxiv.content","type":"clients"}}}},{"id":"10.48550/arxiv.2602.19426","type":"dois","attributes":{"doi":"10.48550/arxiv.2602.19426","identifiers":[{"identifier":"2602.19426","identifierType":"arXiv"}],"creators":[{"nameType":"Personal","givenName":"Kazuhiro","familyName":"Ichihara","name":"Ichihara, Kazuhiro","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Yuha","familyName":"Tamura","name":"Tamura, Yuha","affiliation":[],"nameIdentifiers":[]}],"titles":[{"title":"The half-monochromatic colorings of plane graphs with even polygonal faces"}],"publisher":"arXiv","container":{},"publicationYear":2026,"subjects":[{"subject":"Combinatorics (math.CO)","lang":"en","subjectScheme":"arXiv"},{"subject":"Geometric Topology (math.GT)","lang":"en","subjectScheme":"arXiv"},{"subject":"FOS: Mathematics","subjectScheme":"Fields of Science and Technology (FOS)"},{"schemeUri":"http://www.oecd.org/science/inno/38235147.pdf","subject":"FOS: Mathematics","subjectScheme":"Fields of Science and Technology (FOS)"},{"subject":"05C15, 05C10","lang":"en","subjectScheme":"MSC"}],"contributors":[],"dates":[{"date":"2026-02-23T01:45:24Z","dateType":"Submitted","dateInformation":"v1"},{"date":"2026-02-24T02:04:05Z","dateType":"Updated","dateInformation":"v1"},{"date":"2026-02","dateType":"Available","dateInformation":"v1"},{"date":"2026","dateType":"Issued"}],"language":null,"types":{"schemaOrg":"CreativeWork","resourceTypeGeneral":"Preprint","citeproc":"article","bibtex":"misc","ris":"GEN","resourceType":"Article"},"relatedIdentifiers":[],"relatedItems":[],"sizes":[],"formats":[],"version":"1","rightsList":[{"rightsUri":"http://arxiv.org/licenses/nonexclusive-distrib/1.0/","rights":"arXiv.org perpetual, non-exclusive license"}],"descriptions":[{"descriptionType":"Abstract","description":"On the maximum number of colors for proper anti-rainbow colorings on a planar quadrangulation, an upper bound was given by Enami-Ozeki-Yamaguchi in terms of the independence number. In this paper, as an extension, we introduce the half-monochromatic coloring on a plane graph with even polygonal faces, and give an upper bound on the maximum number of colors for such colorings in terms of the independence number."},{"descriptionType":"Other","description":"7 pages, 3 figures"}],"geoLocations":[],"fundingReferences":[],"url":"https://arxiv.org/abs/2602.19426","contentUrl":null,"metadataVersion":0,"schemaVersion":"http://datacite.org/schema/kernel-4","source":"mds","isActive":true,"state":"findable","reason":null,"viewCount":0,"downloadCount":0,"referenceCount":0,"citationCount":0,"partCount":0,"partOfCount":0,"versionCount":0,"versionOfCount":0,"created":"2026-02-25T14:59:58Z","registered":"2026-02-25T14:59:58Z","published":null,"updated":"2026-02-25T14:59:58Z"},"relationships":{"client":{"data":{"id":"arxiv.content","type":"clients"}}}},{"id":"10.48550/arxiv.2602.19422","type":"dois","attributes":{"doi":"10.48550/arxiv.2602.19422","identifiers":[{"identifier":"2602.19422","identifierType":"arXiv"}],"creators":[{"nameType":"Personal","givenName":"Lingyun","familyName":"Chen","name":"Chen, Lingyun","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Qing","familyName":"Xiao","name":"Xiao, Qing","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Zitao","familyName":"Zhang","name":"Zhang, Zitao","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Eli","familyName":"Blevis","name":"Blevis, Eli","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Selma","familyName":"Šabanović","name":"Šabanović, Selma","affiliation":[],"nameIdentifiers":[]}],"titles":[{"title":"Positioning Modular Co-Design in Future HRI Design Research"}],"publisher":"arXiv","container":{},"publicationYear":2026,"subjects":[{"subject":"Human-Computer Interaction (cs.HC)","lang":"en","subjectScheme":"arXiv"},{"subject":"Robotics (cs.RO)","lang":"en","subjectScheme":"arXiv"},{"subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"},{"schemeUri":"http://www.oecd.org/science/inno/38235147.pdf","subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"}],"contributors":[],"dates":[{"date":"2026-02-23T01:29:39Z","dateType":"Submitted","dateInformation":"v1"},{"date":"2026-02-24T02:03:56Z","dateType":"Updated","dateInformation":"v1"},{"date":"2026-02","dateType":"Available","dateInformation":"v1"},{"date":"2026","dateType":"Issued"}],"language":null,"types":{"schemaOrg":"CreativeWork","resourceTypeGeneral":"Preprint","citeproc":"article","bibtex":"misc","ris":"GEN","resourceType":"Article"},"relatedIdentifiers":[],"relatedItems":[],"sizes":[],"formats":[],"version":"1","rightsList":[{"rightsIdentifierScheme":"SPDX","rightsUri":"https://creativecommons.org/licenses/by-nc-sa/4.0/legalcode","schemeUri":"https://spdx.org/licenses/","rights":"Creative Commons Attribution Non Commercial Share Alike 4.0 International","rightsIdentifier":"cc-by-nc-sa-4.0"}],"descriptions":[{"descriptionType":"Abstract","description":"Design-oriented HRI is increasingly interested in robots as long-term companions, yet many designs still assume a fixed form and a stable set of functions. We present an ongoing design research program that treats modularity as a designerly medium - a way to make long-term human-robot relationships discussable and material through co-design. Across a series of lifespan-oriented co-design activities, participants repeatedly reconfigured the same robot for different life stages, using modular parts to express changing needs, values, and roles. From these outcomes, we articulate PAS (Personalization-Adaptability-Sustainability) as a human-centered lens on how people enact modularity in practice: configuring for self-expression, adapting across transitions, and sustaining robots through repair, reuse, and continuity. We then sketch next steps toward a fabrication-aware, community-extensible modular platform and propose evaluation criteria for designerly HRI work that prioritize expressive adequacy, lifespan plausibility, repairability-in-use, and responsible stewardship - not only usability or performance."},{"descriptionType":"Other","description":"4 pages, 1 figure, accepted by 3rd Workshop on Designerly HRI at HRI'26"}],"geoLocations":[],"fundingReferences":[],"url":"https://arxiv.org/abs/2602.19422","contentUrl":null,"metadataVersion":0,"schemaVersion":"http://datacite.org/schema/kernel-4","source":"mds","isActive":true,"state":"findable","reason":null,"viewCount":0,"downloadCount":0,"referenceCount":0,"citationCount":0,"partCount":0,"partOfCount":0,"versionCount":0,"versionOfCount":0,"created":"2026-02-25T14:59:46Z","registered":"2026-02-25T14:59:47Z","published":null,"updated":"2026-02-25T14:59:47Z"},"relationships":{"client":{"data":{"id":"arxiv.content","type":"clients"}}}},{"id":"10.48550/arxiv.2602.19421","type":"dois","attributes":{"doi":"10.48550/arxiv.2602.19421","identifiers":[{"identifier":"2602.19421","identifierType":"arXiv"}],"creators":[{"nameType":"Personal","givenName":"Tomonari","familyName":"Kanazawa","name":"Kanazawa, Tomonari","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Hikaru","familyName":"Hoshino","name":"Hoshino, Hikaru","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Eiko","familyName":"Furutani","name":"Furutani, Eiko","affiliation":[],"nameIdentifiers":[]}],"titles":[{"title":"A Reinforcement Learning-based Transmission Expansion Framework Considering Strategic Bidding in Electricity Markets"}],"publisher":"arXiv","container":{},"publicationYear":2026,"subjects":[{"subject":"Systems and Control (eess.SY)","lang":"en","subjectScheme":"arXiv"},{"subject":"FOS: Electrical engineering, electronic engineering, information engineering","subjectScheme":"Fields of Science and Technology (FOS)"},{"schemeUri":"http://www.oecd.org/science/inno/38235147.pdf","subject":"FOS: Electrical engineering, electronic engineering, information engineering","subjectScheme":"Fields of Science and Technology (FOS)"}],"contributors":[],"dates":[{"date":"2026-02-23T01:28:55Z","dateType":"Submitted","dateInformation":"v1"},{"date":"2026-02-24T02:03:55Z","dateType":"Updated","dateInformation":"v1"},{"date":"2026-02","dateType":"Available","dateInformation":"v1"},{"date":"2026","dateType":"Issued"}],"language":null,"types":{"schemaOrg":"CreativeWork","resourceTypeGeneral":"Preprint","citeproc":"article","bibtex":"misc","ris":"GEN","resourceType":"Article"},"relatedIdentifiers":[],"relatedItems":[],"sizes":[],"formats":[],"version":"1","rightsList":[{"rightsIdentifierScheme":"SPDX","rightsUri":"https://creativecommons.org/licenses/by/4.0/legalcode","schemeUri":"https://spdx.org/licenses/","rights":"Creative Commons Attribution 4.0 International","rightsIdentifier":"cc-by-4.0"}],"descriptions":[{"descriptionType":"Abstract","description":"Transmission expansion planning in electricity markets is tightly coupled with the strategic bidding behaviors of generation companies. This paper proposes a Reinforcement Learning (RL)-based co-optimization framework that simultaneously learns transmission investment decisions and generator bidding strategies within a unified training process. Based on a multiagent RL framework for market simulation, the proposed method newly introduces a design policy layer that jointly optimizes continuous/discrete transmission expansion decisions together with strategic bidding policies. Through iterative interaction between market clearing and investment design, the framework effectively captures their mutual influence and achieves consistent co-optimization of expansion and bidding decisions. Case studies on the IEEE 30-bus system are provided for proof-of-concept validation of the proposed co-optimization framework."}],"geoLocations":[],"fundingReferences":[],"url":"https://arxiv.org/abs/2602.19421","contentUrl":null,"metadataVersion":0,"schemaVersion":"http://datacite.org/schema/kernel-4","source":"mds","isActive":true,"state":"findable","reason":null,"viewCount":0,"downloadCount":0,"referenceCount":0,"citationCount":0,"partCount":0,"partOfCount":0,"versionCount":0,"versionOfCount":0,"created":"2026-02-25T14:59:44Z","registered":"2026-02-25T14:59:45Z","published":null,"updated":"2026-02-25T14:59:45Z"},"relationships":{"client":{"data":{"id":"arxiv.content","type":"clients"}}}},{"id":"10.48550/arxiv.2602.19420","type":"dois","attributes":{"doi":"10.48550/arxiv.2602.19420","identifiers":[{"identifier":"2602.19420","identifierType":"arXiv"}],"creators":[{"nameType":"Personal","givenName":"Fei","familyName":"Chen","name":"Chen, Fei","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Jorge","familyName":"Cortés","name":"Cortés, Jorge","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Sonia","familyName":"Martínez","name":"Martínez, Sonia","affiliation":[],"nameIdentifiers":[]}],"titles":[{"title":"Enhancing network resilience through topological switching"}],"publisher":"arXiv","container":{},"publicationYear":2026,"subjects":[{"subject":"Optimization and Control (math.OC)","lang":"en","subjectScheme":"arXiv"},{"subject":"Systems and Control (eess.SY)","lang":"en","subjectScheme":"arXiv"},{"subject":"FOS: Mathematics","subjectScheme":"Fields of Science and Technology (FOS)"},{"schemeUri":"http://www.oecd.org/science/inno/38235147.pdf","subject":"FOS: Mathematics","subjectScheme":"Fields of Science and Technology (FOS)"},{"subject":"FOS: Electrical engineering, electronic engineering, information engineering","subjectScheme":"Fields of Science and Technology (FOS)"},{"schemeUri":"http://www.oecd.org/science/inno/38235147.pdf","subject":"FOS: Electrical engineering, electronic engineering, information engineering","subjectScheme":"Fields of Science and Technology (FOS)"}],"contributors":[],"dates":[{"date":"2026-02-23T01:26:01Z","dateType":"Submitted","dateInformation":"v1"},{"date":"2026-02-24T02:03:54Z","dateType":"Updated","dateInformation":"v1"},{"date":"2026-02","dateType":"Available","dateInformation":"v1"},{"date":"2026","dateType":"Issued"}],"language":null,"types":{"schemaOrg":"CreativeWork","resourceTypeGeneral":"Preprint","citeproc":"article","bibtex":"misc","ris":"GEN","resourceType":"Article"},"relatedIdentifiers":[],"relatedItems":[],"sizes":[],"formats":[],"version":"1","rightsList":[{"rightsIdentifierScheme":"SPDX","rightsUri":"https://creativecommons.org/licenses/by-nc-nd/4.0/legalcode","schemeUri":"https://spdx.org/licenses/","rights":"Creative Commons Attribution Non Commercial No Derivatives 4.0 International","rightsIdentifier":"cc-by-nc-nd-4.0"}],"descriptions":[{"descriptionType":"Abstract","description":"This work studies how to preemptively increase the resilience of a network by means of time-varying topological actuation. To do this, we focus on linear dynamical systems that are compatible with a given network, and consider policies that switch periodically between the given one and an alternative, topologically-compatible dynamics. In particular, we seek to solve design problems aimed at finding a) the optimal switching schedule between two preselected topologies, and b) an optimal topology and optimal switching schedule. By imposing periodicity, we first provide a metric of resilience in terms of the spectral abscissa of the averaged linear time-invariant dynamics. By restricting our policies to commutative networks, we then show how the optimal scheduling problem reduces to a convex optimization, providing a bound on the net resilience that can be achieved. After this, we find that the optimal, sparse commutative network to switch with is fully disconnected and allocates the spectral sum among the nodes of the network equally. We then impose additional restrictions on topology edge selection, which leads to a biconvex optimization for which certain matrix rank conditions guide the choice of weighting parameters to obtain desirable solutions. Finally, we provide two methods to solve this problem efficiently (based on a McCormick relaxation, and alternating minimization), and illustrate the results in simulations."},{"descriptionType":"Other","description":"12 pages, 5 figures"}],"geoLocations":[],"fundingReferences":[],"url":"https://arxiv.org/abs/2602.19420","contentUrl":null,"metadataVersion":0,"schemaVersion":"http://datacite.org/schema/kernel-4","source":"mds","isActive":true,"state":"findable","reason":null,"viewCount":0,"downloadCount":0,"referenceCount":0,"citationCount":0,"partCount":0,"partOfCount":0,"versionCount":0,"versionOfCount":0,"created":"2026-02-25T14:59:41Z","registered":"2026-02-25T14:59:42Z","published":null,"updated":"2026-02-25T14:59:42Z"},"relationships":{"client":{"data":{"id":"arxiv.content","type":"clients"}}}},{"id":"10.48550/arxiv.2602.19418","type":"dois","attributes":{"doi":"10.48550/arxiv.2602.19418","identifiers":[{"identifier":"2602.19418","identifierType":"arXiv"}],"creators":[{"nameType":"Personal","givenName":"Hefei","familyName":"Mei","name":"Mei, Hefei","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Zirui","familyName":"Wang","name":"Wang, Zirui","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Chang","familyName":"Xu","name":"Xu, Chang","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Jianyuan","familyName":"Guo","name":"Guo, Jianyuan","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Minjing","familyName":"Dong","name":"Dong, Minjing","affiliation":[],"nameIdentifiers":[]}],"titles":[{"title":"PA-Attack: Guiding Gray-Box Attacks on LVLM Vision Encoders with Prototypes and Attention"}],"publisher":"arXiv","container":{},"publicationYear":2026,"subjects":[{"subject":"Computer Vision and Pattern Recognition (cs.CV)","lang":"en","subjectScheme":"arXiv"},{"subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"},{"schemeUri":"http://www.oecd.org/science/inno/38235147.pdf","subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"}],"contributors":[],"dates":[{"date":"2026-02-23T01:20:43Z","dateType":"Submitted","dateInformation":"v1"},{"date":"2026-02-24T02:03:52Z","dateType":"Updated","dateInformation":"v1"},{"date":"2026-02","dateType":"Available","dateInformation":"v1"},{"date":"2026","dateType":"Issued"}],"language":null,"types":{"schemaOrg":"CreativeWork","resourceTypeGeneral":"Preprint","citeproc":"article","bibtex":"misc","ris":"GEN","resourceType":"Article"},"relatedIdentifiers":[],"relatedItems":[],"sizes":[],"formats":[],"version":"1","rightsList":[{"rightsUri":"http://arxiv.org/licenses/nonexclusive-distrib/1.0/","rights":"arXiv.org perpetual, non-exclusive license"}],"descriptions":[{"descriptionType":"Abstract","description":"Large Vision-Language Models (LVLMs) are foundational to modern multimodal applications, yet their susceptibility to adversarial attacks remains a critical concern. Prior white-box attacks rarely generalize across tasks, and black-box methods depend on expensive transfer, which limits efficiency. The vision encoder, standardized and often shared across LVLMs, provides a stable gray-box pivot with strong cross-model transfer. Building on this premise, we introduce PA-Attack (Prototype-Anchored Attentive Attack). PA-Attack begins with a prototype-anchored guidance that provides a stable attack direction towards a general and dissimilar prototype, tackling the attribute-restricted issue and limited task generalization of vanilla attacks. Building on this, we propose a two-stage attention enhancement mechanism: (i) leverage token-level attention scores to concentrate perturbations on critical visual tokens, and (ii) adaptively recalibrate attention weights to track the evolving attention during the adversarial process. Extensive experiments across diverse downstream tasks and LVLM architectures show that PA-Attack achieves an average 75.1% score reduction rate (SRR), demonstrating strong attack effectiveness, efficiency, and task generalization in LVLMs. Code is available at https://github.com/hefeimei06/PA-Attack."}],"geoLocations":[],"fundingReferences":[],"url":"https://arxiv.org/abs/2602.19418","contentUrl":null,"metadataVersion":0,"schemaVersion":"http://datacite.org/schema/kernel-4","source":"mds","isActive":true,"state":"findable","reason":null,"viewCount":0,"downloadCount":0,"referenceCount":0,"citationCount":0,"partCount":0,"partOfCount":0,"versionCount":0,"versionOfCount":0,"created":"2026-02-25T14:59:36Z","registered":"2026-02-25T14:59:37Z","published":null,"updated":"2026-02-25T14:59:37Z"},"relationships":{"client":{"data":{"id":"arxiv.content","type":"clients"}}}},{"id":"10.48550/arxiv.2602.19416","type":"dois","attributes":{"doi":"10.48550/arxiv.2602.19416","identifiers":[{"identifier":"2602.19416","identifierType":"arXiv"}],"creators":[{"nameType":"Personal","givenName":"Mohammad","familyName":"Beigi","name":"Beigi, Mohammad","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Ming","familyName":"Jin","name":"Jin, Ming","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Junshan","familyName":"Zhang","name":"Zhang, Junshan","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Jiaxin","familyName":"Zhang","name":"Zhang, Jiaxin","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Qifan","familyName":"Wang","name":"Wang, Qifan","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Lifu","familyName":"Huang","name":"Huang, Lifu","affiliation":[],"nameIdentifiers":[]}],"titles":[{"title":"IR$^3$: Contrastive Inverse Reinforcement Learning for Interpretable Detection and Mitigation of Reward Hacking"}],"publisher":"arXiv","container":{},"publicationYear":2026,"subjects":[{"subject":"Artificial Intelligence (cs.AI)","lang":"en","subjectScheme":"arXiv"},{"subject":"Machine Learning (cs.LG)","lang":"en","subjectScheme":"arXiv"},{"subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"},{"schemeUri":"http://www.oecd.org/science/inno/38235147.pdf","subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"}],"contributors":[],"dates":[{"date":"2026-02-23T01:14:53Z","dateType":"Submitted","dateInformation":"v1"},{"date":"2026-02-24T02:03:46Z","dateType":"Updated","dateInformation":"v1"},{"date":"2026-02","dateType":"Available","dateInformation":"v1"},{"date":"2026","dateType":"Issued"}],"language":null,"types":{"schemaOrg":"CreativeWork","resourceTypeGeneral":"Preprint","citeproc":"article","bibtex":"misc","ris":"GEN","resourceType":"Article"},"relatedIdentifiers":[],"relatedItems":[],"sizes":[],"formats":[],"version":"1","rightsList":[{"rightsUri":"http://arxiv.org/licenses/nonexclusive-distrib/1.0/","rights":"arXiv.org perpetual, non-exclusive license"}],"descriptions":[{"descriptionType":"Abstract","description":"Reinforcement Learning from Human Feedback (RLHF) enables powerful LLM alignment but can introduce reward hacking - models exploit spurious correlations in proxy rewards without genuine alignment. Compounding this, the objectives internalized during RLHF remain opaque, making hacking behaviors difficult to detect or correct. We introduce IR3 (Interpretable Reward Reconstruction and Rectification), a framework that reverse-engineers, interprets, and surgically repairs the implicit objectives driving RLHF-tuned models. We propose Contrastive Inverse Reinforcement Learning (C-IRL), which reconstructs the implicit reward function by contrasting paired responses from post-alignment and baseline policies to explain behavioral shifts during RLHF. We then decompose the reconstructed reward via sparse autoencoders into interpretable features, enabling identification of hacking signatures through contribution analysis. Finally, we propose mitigation strategies - clean reward optimization, adversarial shaping, constrained optimization, and feature-guided distillation - that target problematic features while preserving beneficial alignment. Experiments across multiple reward model configurations show that IR3 achieves 0.89 correlation with ground-truth rewards, identifies hacking features with over 90% precision, and significantly reduces hacking behaviors while maintaining capabilities within 3% of the original model."}],"geoLocations":[],"fundingReferences":[],"url":"https://arxiv.org/abs/2602.19416","contentUrl":null,"metadataVersion":0,"schemaVersion":"http://datacite.org/schema/kernel-4","source":"mds","isActive":true,"state":"findable","reason":null,"viewCount":0,"downloadCount":0,"referenceCount":0,"citationCount":0,"partCount":0,"partOfCount":0,"versionCount":0,"versionOfCount":0,"created":"2026-02-25T14:59:31Z","registered":"2026-02-25T14:59:32Z","published":null,"updated":"2026-02-25T14:59:32Z"},"relationships":{"client":{"data":{"id":"arxiv.content","type":"clients"}}}},{"id":"10.48550/arxiv.2602.19413","type":"dois","attributes":{"doi":"10.48550/arxiv.2602.19413","identifiers":[{"identifier":"2602.19413","identifierType":"arXiv"}],"creators":[{"nameType":"Personal","givenName":"Sławomir","familyName":"Cynk","name":"Cynk, Sławomir","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Beata","familyName":"Kocel-Cynk","name":"Kocel-Cynk, Beata","affiliation":[],"nameIdentifiers":[]}],"titles":[{"title":"Classification of double octic Calabi-Yau threefolds defined by an arrangement of eight planes II"}],"publisher":"arXiv","container":{},"publicationYear":2026,"subjects":[{"subject":"Algebraic Geometry (math.AG)","lang":"en","subjectScheme":"arXiv"},{"subject":"FOS: Mathematics","subjectScheme":"Fields of Science and Technology (FOS)"},{"schemeUri":"http://www.oecd.org/science/inno/38235147.pdf","subject":"FOS: Mathematics","subjectScheme":"Fields of Science and Technology (FOS)"},{"subject":"14J32 (Primary) 14D06 (Secondary)","lang":"en","subjectScheme":"MSC"}],"contributors":[],"dates":[{"date":"2026-02-23T01:10:28Z","dateType":"Submitted","dateInformation":"v1"},{"date":"2026-02-24T02:03:43Z","dateType":"Updated","dateInformation":"v1"},{"date":"2026-02","dateType":"Available","dateInformation":"v1"},{"date":"2026","dateType":"Issued"}],"language":null,"types":{"schemaOrg":"CreativeWork","resourceTypeGeneral":"Preprint","citeproc":"article","bibtex":"misc","ris":"GEN","resourceType":"Article"},"relatedIdentifiers":[],"relatedItems":[],"sizes":[],"formats":[],"version":"1","rightsList":[{"rightsUri":"http://arxiv.org/licenses/nonexclusive-distrib/1.0/","rights":"arXiv.org perpetual, non-exclusive license"}],"descriptions":[{"descriptionType":"Abstract","description":"We present a complete classification of all arrangements of eight planes in projective threespace that give rise to double octic Calabi-Yau threefolds. Building on earlier work, we determine all 455 combinatorial types and describe the projective automorphism groups associated with each arrangement. These automorphisms allow us to identify geometrically distinguished subfamilies and elements, and to construct a rich collection of elliptic and K3 fibrations arising naturally from the singularities of the arrangements.\n As applications, we exhibit two one-parameter families of Calabi-Yau threefolds that each possess three pairwise non-equivalent maximally unipotent monodromy points-phenomena that are rare in known examples. We further construct two Calabi-Yau threefolds whose third cohomology decomposes, via complex multiplication, into complementary two-dimensional Hodge structures of types (1,0,1,0) and (0,1,0,1). This decomposition yields new instances of modularity not previously observed in the Calabi-Yau setting."}],"geoLocations":[],"fundingReferences":[],"url":"https://arxiv.org/abs/2602.19413","contentUrl":null,"metadataVersion":0,"schemaVersion":"http://datacite.org/schema/kernel-4","source":"mds","isActive":true,"state":"findable","reason":null,"viewCount":0,"downloadCount":0,"referenceCount":0,"citationCount":0,"partCount":0,"partOfCount":0,"versionCount":0,"versionOfCount":0,"created":"2026-02-25T14:59:24Z","registered":"2026-02-25T14:59:25Z","published":null,"updated":"2026-02-25T14:59:25Z"},"relationships":{"client":{"data":{"id":"arxiv.content","type":"clients"}}}},{"id":"10.48550/arxiv.2602.19412","type":"dois","attributes":{"doi":"10.48550/arxiv.2602.19412","identifiers":[{"identifier":"2602.19412","identifierType":"arXiv"}],"creators":[{"nameType":"Personal","givenName":"Mingjie","familyName":"Li","name":"Li, Mingjie","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Yizheng","familyName":"Chen","name":"Chen, Yizheng","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Md Tauhidul","familyName":"Islam","name":"Islam, Md Tauhidul","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Lei","familyName":"Xing","name":"Xing, Lei","affiliation":[],"nameIdentifiers":[]}],"titles":[{"title":"Redefining the Down-Sampling Scheme of U-Net for Precision Biomedical Image Segmentation"}],"publisher":"arXiv","container":{},"publicationYear":2026,"subjects":[{"subject":"Computer Vision and Pattern Recognition (cs.CV)","lang":"en","subjectScheme":"arXiv"},{"subject":"Artificial Intelligence (cs.AI)","lang":"en","subjectScheme":"arXiv"},{"subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"},{"schemeUri":"http://www.oecd.org/science/inno/38235147.pdf","subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"}],"contributors":[],"dates":[{"date":"2026-02-23T01:10:04Z","dateType":"Submitted","dateInformation":"v1"},{"date":"2026-02-24T02:03:40Z","dateType":"Updated","dateInformation":"v1"},{"date":"2026-02","dateType":"Available","dateInformation":"v1"},{"date":"2026","dateType":"Issued"}],"language":null,"types":{"schemaOrg":"CreativeWork","resourceTypeGeneral":"Preprint","citeproc":"article","bibtex":"misc","ris":"GEN","resourceType":"Article"},"relatedIdentifiers":[],"relatedItems":[],"sizes":[],"formats":[],"version":"1","rightsList":[{"rightsIdentifierScheme":"SPDX","rightsUri":"https://creativecommons.org/licenses/by/4.0/legalcode","schemeUri":"https://spdx.org/licenses/","rights":"Creative Commons Attribution 4.0 International","rightsIdentifier":"cc-by-4.0"}],"descriptions":[{"descriptionType":"Abstract","description":"U-Net architectures have been instrumental in advancing biomedical image segmentation (BIS) but often struggle with capturing long-range information. One reason is the conventional down-sampling techniques that prioritize computational efficiency at the expense of information retention. This paper introduces a simple but effective strategy, we call it Stair Pooling, which moderates the pace of down-sampling and reduces information loss by leveraging a sequence of concatenated small and narrow pooling operations in varied orientations. Specifically, our method modifies the reduction in dimensionality within each 2D pooling step from $\\frac{1}{4}$ to $\\frac{1}{2}$. This approach can also be adapted for 3D pooling to preserve even more information. Such preservation aids the U-Net in more effectively reconstructing spatial details during the up-sampling phase, thereby enhancing its ability to capture long-range information and improving segmentation accuracy. Extensive experiments on three BIS benchmarks demonstrate that the proposed Stair Pooling can increase both 2D and 3D U-Net performance by an average of 3.8\\% in Dice scores. Moreover, we leverage the transfer entropy to select the optimal down-sampling paths and quantitatively show how the proposed Stair Pooling reduces the information loss."},{"descriptionType":"Other","description":"AAPM 67th"}],"geoLocations":[],"fundingReferences":[],"url":"https://arxiv.org/abs/2602.19412","contentUrl":null,"metadataVersion":0,"schemaVersion":"http://datacite.org/schema/kernel-4","source":"mds","isActive":true,"state":"findable","reason":null,"viewCount":0,"downloadCount":0,"referenceCount":0,"citationCount":0,"partCount":0,"partOfCount":0,"versionCount":0,"versionOfCount":0,"created":"2026-02-25T14:59:21Z","registered":"2026-02-25T14:59:22Z","published":null,"updated":"2026-02-25T14:59:22Z"},"relationships":{"client":{"data":{"id":"arxiv.content","type":"clients"}}}},{"id":"10.48550/arxiv.2602.19411","type":"dois","attributes":{"doi":"10.48550/arxiv.2602.19411","identifiers":[{"identifier":"2602.19411","identifierType":"arXiv"}],"creators":[{"nameType":"Personal","givenName":"Ilyes","familyName":"Batatia","name":"Batatia, Ilyes","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"William J.","familyName":"Baldwin","name":"Baldwin, William J.","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Domantas","familyName":"Kuryla","name":"Kuryla, Domantas","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Joseph","familyName":"Hart","name":"Hart, Joseph","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Elliott","familyName":"Kasoar","name":"Kasoar, Elliott","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Alin M.","familyName":"Elena","name":"Elena, Alin M.","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Harry","familyName":"Moore","name":"Moore, Harry","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Mikołaj J.","familyName":"Gawkowski","name":"Gawkowski, Mikołaj J.","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Benjamin X.","familyName":"Shi","name":"Shi, Benjamin X.","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Venkat","familyName":"Kapil","name":"Kapil, Venkat","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Panagiotis","familyName":"Kourtis","name":"Kourtis, Panagiotis","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Ioan-Bogdan","familyName":"Magdău","name":"Magdău, Ioan-Bogdan","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Gábor","familyName":"Csányi","name":"Csányi, Gábor","affiliation":[],"nameIdentifiers":[]}],"titles":[{"title":"MACE-POLAR-1: A Polarisable Electrostatic Foundation Model for Molecular Chemistry"}],"publisher":"arXiv","container":{},"publicationYear":2026,"subjects":[{"subject":"Chemical Physics (physics.chem-ph)","lang":"en","subjectScheme":"arXiv"},{"subject":"Machine Learning (cs.LG)","lang":"en","subjectScheme":"arXiv"},{"subject":"FOS: Physical sciences","subjectScheme":"Fields of Science and Technology (FOS)"},{"schemeUri":"http://www.oecd.org/science/inno/38235147.pdf","subject":"FOS: Physical sciences","subjectScheme":"Fields of Science and Technology (FOS)"},{"subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"},{"schemeUri":"http://www.oecd.org/science/inno/38235147.pdf","subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"}],"contributors":[],"dates":[{"date":"2026-02-23T01:09:54Z","dateType":"Submitted","dateInformation":"v1"},{"date":"2026-02-24T02:03:38Z","dateType":"Updated","dateInformation":"v1"},{"date":"2026-02","dateType":"Available","dateInformation":"v1"},{"date":"2026","dateType":"Issued"}],"language":null,"types":{"schemaOrg":"CreativeWork","resourceTypeGeneral":"Preprint","citeproc":"article","bibtex":"misc","ris":"GEN","resourceType":"Article"},"relatedIdentifiers":[],"relatedItems":[],"sizes":[],"formats":[],"version":"1","rightsList":[{"rightsUri":"http://arxiv.org/licenses/nonexclusive-distrib/1.0/","rights":"arXiv.org perpetual, non-exclusive license"}],"descriptions":[{"descriptionType":"Abstract","description":"Accurate modelling of electrostatic interactions and charge transfer is fundamental to computational chemistry, yet most machine learning interatomic potentials (MLIPs) rely on local atomic descriptors that cannot capture long-range electrostatic effects. We present a new electrostatic foundation model for molecular chemistry that extends the MACE architecture with explicit treatment of long-range interactions and electrostatic induction. Our approach combines local many-body geometric features with a non-self-consistent field formalism that updates learnable charge and spin densities through polarisable iterations to model induction, followed by global charge equilibration via learnable Fukui functions to control total charge and total spin. This design enables an accurate and physical description of systems with varying charge and spin states while maintaining computational efficiency. Trained on the OMol25 dataset of 100 million hybrid DFT calculations, our models achieve chemical accuracy across diverse benchmarks, with accuracy competitive with hybrid DFT on thermochemistry, reaction barriers, conformational energies, and transition metal complexes. Notably, we demonstrate that the inclusion of long-range electrostatics leads to a large improvement in the description of non-covalent interactions and supramolecular complexes over non-electrostatic models, including sub-kcal/mol prediction of molecular crystal formation energy in the X23-DMC dataset and a fourfold improvement over short-ranged models on protein-ligand interactions. The model's ability to handle variable charge and spin states, respond to external fields, provide interpretable spin-resolved charge densities, and maintain accuracy from small molecules to protein-ligand complexes positions it as a versatile tool for computational molecular chemistry and drug discovery."}],"geoLocations":[],"fundingReferences":[],"url":"https://arxiv.org/abs/2602.19411","contentUrl":null,"metadataVersion":0,"schemaVersion":"http://datacite.org/schema/kernel-4","source":"mds","isActive":true,"state":"findable","reason":null,"viewCount":0,"downloadCount":0,"referenceCount":0,"citationCount":0,"partCount":0,"partOfCount":0,"versionCount":0,"versionOfCount":0,"created":"2026-02-25T14:59:19Z","registered":"2026-02-25T14:59:20Z","published":null,"updated":"2026-02-25T14:59:20Z"},"relationships":{"client":{"data":{"id":"arxiv.content","type":"clients"}}}},{"id":"10.48550/arxiv.2602.19410","type":"dois","attributes":{"doi":"10.48550/arxiv.2602.19410","identifiers":[{"identifier":"2602.19410","identifierType":"arXiv"}],"creators":[{"nameType":"Personal","givenName":"Duy Anh","familyName":"Ta","name":"Ta, Duy Anh","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Farnaz","familyName":"Farid","name":"Farid, Farnaz","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Farhad","familyName":"Ahamed","name":"Ahamed, Farhad","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Ala","familyName":"Al-Areqi","name":"Al-Areqi, Ala","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Robert","familyName":"Beutel","name":"Beutel, Robert","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Tamara","familyName":"Watson","name":"Watson, Tamara","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Alana","familyName":"Maurushat","name":"Maurushat, Alana","affiliation":[],"nameIdentifiers":[]}],"titles":[{"title":"BioEnvSense: A Human-Centred Security Framework for Preventing Behaviour-Driven Cyber Incidents"}],"publisher":"arXiv","container":{},"publicationYear":2026,"subjects":[{"subject":"Cryptography and Security (cs.CR)","lang":"en","subjectScheme":"arXiv"},{"subject":"Computers and Society (cs.CY)","lang":"en","subjectScheme":"arXiv"},{"subject":"Human-Computer Interaction (cs.HC)","lang":"en","subjectScheme":"arXiv"},{"subject":"Machine Learning (cs.LG)","lang":"en","subjectScheme":"arXiv"},{"subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"},{"schemeUri":"http://www.oecd.org/science/inno/38235147.pdf","subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"},{"subject":"F.2.2; I.2.7","lang":"en","subjectScheme":"ACM"}],"contributors":[],"dates":[{"date":"2026-02-23T01:06:16Z","dateType":"Submitted","dateInformation":"v1"},{"date":"2026-02-24T02:03:34Z","dateType":"Updated","dateInformation":"v1"},{"date":"2026-02","dateType":"Available","dateInformation":"v1"},{"date":"2026","dateType":"Issued"}],"language":null,"types":{"schemaOrg":"CreativeWork","resourceTypeGeneral":"Preprint","citeproc":"article","bibtex":"misc","ris":"GEN","resourceType":"Article"},"relatedIdentifiers":[],"relatedItems":[],"sizes":[],"formats":[],"version":"1","rightsList":[{"rightsIdentifierScheme":"SPDX","rightsUri":"https://creativecommons.org/licenses/by/4.0/legalcode","schemeUri":"https://spdx.org/licenses/","rights":"Creative Commons Attribution 4.0 International","rightsIdentifier":"cc-by-4.0"}],"descriptions":[{"descriptionType":"Abstract","description":"Modern organizations increasingly face cybersecurity incidents driven by human behaviour rather than technical failures. To address this, we propose a conceptual security framework that integrates a hybrid Convolutional Neural Network-Long Short-Term Memory (CNN-LSTM) model to analyze biometric and environmental data for context-aware security decisions. The CNN extracts spatial patterns from sensor data, while the LSTM captures temporal dynamics associated with human error susceptibility. The model achieves 84% accuracy, demonstrating its ability to reliably detect conditions that lead to elevated human-centred cyber risk. By enabling continuous monitoring and adaptive safeguards, the framework supports proactive interventions that reduce the likelihood of human-driven cyber incidents"}],"geoLocations":[],"fundingReferences":[],"url":"https://arxiv.org/abs/2602.19410","contentUrl":null,"metadataVersion":0,"schemaVersion":"http://datacite.org/schema/kernel-4","source":"mds","isActive":true,"state":"findable","reason":null,"viewCount":0,"downloadCount":0,"referenceCount":0,"citationCount":0,"partCount":0,"partOfCount":0,"versionCount":0,"versionOfCount":0,"created":"2026-02-25T14:59:16Z","registered":"2026-02-25T14:59:17Z","published":null,"updated":"2026-02-25T14:59:17Z"},"relationships":{"client":{"data":{"id":"arxiv.content","type":"clients"}}}},{"id":"10.48550/arxiv.2602.19409","type":"dois","attributes":{"doi":"10.48550/arxiv.2602.19409","identifiers":[{"identifier":"2602.19409","identifierType":"arXiv"}],"creators":[{"nameType":"Personal","givenName":"Henry","familyName":"Zhong","name":"Zhong, Henry","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Jörg M.","familyName":"Buchholz","name":"Buchholz, Jörg M.","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Julian","familyName":"Maclaren","name":"Maclaren, Julian","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Simon","familyName":"Carlile","name":"Carlile, Simon","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Richard F.","familyName":"Lyon","name":"Lyon, Richard F.","affiliation":[],"nameIdentifiers":[]}],"titles":[{"title":"AuditoryHuM: Auditory Scene Label Generation and Clustering using Human-MLLM Collaboration"}],"publisher":"arXiv","container":{},"publicationYear":2026,"subjects":[{"subject":"Sound (cs.SD)","lang":"en","subjectScheme":"arXiv"},{"subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"},{"schemeUri":"http://www.oecd.org/science/inno/38235147.pdf","subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"}],"contributors":[],"dates":[{"date":"2026-02-23T01:02:03Z","dateType":"Submitted","dateInformation":"v1"},{"date":"2026-02-24T02:03:33Z","dateType":"Updated","dateInformation":"v1"},{"date":"2026-02","dateType":"Available","dateInformation":"v1"},{"date":"2026","dateType":"Issued"}],"language":null,"types":{"schemaOrg":"CreativeWork","resourceTypeGeneral":"Preprint","citeproc":"article","bibtex":"misc","ris":"GEN","resourceType":"Article"},"relatedIdentifiers":[],"relatedItems":[],"sizes":[],"formats":[],"version":"1","rightsList":[{"rightsUri":"http://arxiv.org/licenses/nonexclusive-distrib/1.0/","rights":"arXiv.org perpetual, non-exclusive license"}],"descriptions":[{"descriptionType":"Abstract","description":"Manual annotation of audio datasets is labour intensive, and it is challenging to balance label granularity with acoustic separability. We introduce AuditoryHuM, a novel framework for the unsupervised discovery and clustering of auditory scene labels using a collaborative Human-Multimodal Large Language Model (MLLM) approach. By leveraging MLLMs (Gemma and Qwen) the framework generates contextually relevant labels for audio data. To ensure label quality and mitigate hallucinations, we employ zero-shot learning techniques (Human-CLAP) to quantify the alignment between generated text labels and raw audio content. A strategically targeted human-in-the-loop intervention is then used to refine the least aligned pairs. The discovered labels are grouped into thematically cohesive clusters using an adjusted silhouette score that incorporates a penalty parameter to balance cluster cohesion and thematic granularity. Evaluated across three diverse auditory scene datasets (ADVANCE, AHEAD-DS, and TAU 2019), AuditoryHuM provides a scalable, low-cost solution for creating standardised taxonomies. This solution facilitates the training of lightweight scene recognition models deployable to edge devices, such as hearing aids and smart home assistants. The project page and code: https://github.com/Australian-Future-Hearing-Initiative"}],"geoLocations":[],"fundingReferences":[],"url":"https://arxiv.org/abs/2602.19409","contentUrl":null,"metadataVersion":0,"schemaVersion":"http://datacite.org/schema/kernel-4","source":"mds","isActive":true,"state":"findable","reason":null,"viewCount":0,"downloadCount":0,"referenceCount":0,"citationCount":0,"partCount":0,"partOfCount":0,"versionCount":0,"versionOfCount":0,"created":"2026-02-25T14:59:14Z","registered":"2026-02-25T14:59:15Z","published":null,"updated":"2026-02-25T14:59:15Z"},"relationships":{"client":{"data":{"id":"arxiv.content","type":"clients"}}}},{"id":"10.48550/arxiv.2602.19408","type":"dois","attributes":{"doi":"10.48550/arxiv.2602.19408","identifiers":[{"identifier":"2602.19408","identifierType":"arXiv"}],"creators":[{"nameType":"Personal","givenName":"Sankardeep","familyName":"Chakraborty","name":"Chakraborty, Sankardeep","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Roberto","familyName":"Grossi","name":"Grossi, Roberto","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Ren","familyName":"Kimura","name":"Kimura, Ren","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Giulia","familyName":"Punzi","name":"Punzi, Giulia","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Kunihiko","familyName":"Sadakane","name":"Sadakane, Kunihiko","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Wiktor","familyName":"Zuba","name":"Zuba, Wiktor","affiliation":[],"nameIdentifiers":[]}],"titles":[{"title":"Variations on the Problem of Identifying Spectrum-Preserving String Sets"}],"publisher":"arXiv","container":{},"publicationYear":2026,"subjects":[{"subject":"Data Structures and Algorithms (cs.DS)","lang":"en","subjectScheme":"arXiv"},{"subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"},{"schemeUri":"http://www.oecd.org/science/inno/38235147.pdf","subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"}],"contributors":[],"dates":[{"date":"2026-02-23T00:58:22Z","dateType":"Submitted","dateInformation":"v1"},{"date":"2026-02-24T02:03:32Z","dateType":"Updated","dateInformation":"v1"},{"date":"2026-02","dateType":"Available","dateInformation":"v1"},{"date":"2026","dateType":"Issued"}],"language":null,"types":{"schemaOrg":"CreativeWork","resourceTypeGeneral":"Preprint","citeproc":"article","bibtex":"misc","ris":"GEN","resourceType":"Article"},"relatedIdentifiers":[],"relatedItems":[],"sizes":[],"formats":[],"version":"1","rightsList":[{"rightsIdentifierScheme":"SPDX","rightsUri":"https://creativecommons.org/licenses/by/4.0/legalcode","schemeUri":"https://spdx.org/licenses/","rights":"Creative Commons Attribution 4.0 International","rightsIdentifier":"cc-by-4.0"}],"descriptions":[{"descriptionType":"Abstract","description":"In computational genomics, many analyses rely on efficient storage and traversal of $k$-mers, motivating compact representations such as spectrum-preserving string sets (SPSS), which store strings whose $k$-mer spectrum matches that of the input. Existing approaches, including Unitigs, Eulertigs and Matchtigs, model this task as a path cover problem on the deBruijn graph. We extend this framework from paths to branching structures by introducing necklace covers, which combine cycles and tree-like attachments (pendants). We present a greedy algorithm that constructs a necklace cover while guaranteeing, under certain conditions, optimality in the cumulative size of the final representation.\n Experiments on real genomic datasets indicate that the minimum necklace cover achieves smaller representations than Eulertigs and comparable compression to the Masked Superstrings approach, while maintaining exactness of the $k$-mer spectrum."}],"geoLocations":[],"fundingReferences":[],"url":"https://arxiv.org/abs/2602.19408","contentUrl":null,"metadataVersion":0,"schemaVersion":"http://datacite.org/schema/kernel-4","source":"mds","isActive":true,"state":"findable","reason":null,"viewCount":0,"downloadCount":0,"referenceCount":0,"citationCount":0,"partCount":0,"partOfCount":0,"versionCount":0,"versionOfCount":0,"created":"2026-02-25T14:59:11Z","registered":"2026-02-25T14:59:12Z","published":null,"updated":"2026-02-25T14:59:12Z"},"relationships":{"client":{"data":{"id":"arxiv.content","type":"clients"}}}},{"id":"10.48550/arxiv.2602.19407","type":"dois","attributes":{"doi":"10.48550/arxiv.2602.19407","identifiers":[{"identifier":"2602.19407","identifierType":"arXiv"}],"creators":[{"nameType":"Personal","givenName":"Indira","familyName":"Vats","name":"Vats, Indira","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Sanjukta","familyName":"De","name":"De, Sanjukta","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Subhayan","familyName":"Roy","name":"Roy, Subhayan","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Saurabh","familyName":"Bodhe","name":"Bodhe, Saurabh","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Lejin","familyName":"Varghese","name":"Varghese, Lejin","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Max","familyName":"Kiehn","name":"Kiehn, Max","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Yonas","familyName":"Bedasso","name":"Bedasso, Yonas","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Marsha","familyName":"Chechik","name":"Chechik, Marsha","affiliation":[],"nameIdentifiers":[]}],"titles":[{"title":"Multi-CoLoR: Context-Aware Localization and Reasoning across Multi-Language Codebases"}],"publisher":"arXiv","container":{},"publicationYear":2026,"subjects":[{"subject":"Software Engineering (cs.SE)","lang":"en","subjectScheme":"arXiv"},{"subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"},{"schemeUri":"http://www.oecd.org/science/inno/38235147.pdf","subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"}],"contributors":[],"dates":[{"date":"2026-02-23T00:54:59Z","dateType":"Submitted","dateInformation":"v1"},{"date":"2026-02-24T02:03:30Z","dateType":"Updated","dateInformation":"v1"},{"date":"2026-02","dateType":"Available","dateInformation":"v1"},{"date":"2026","dateType":"Issued"}],"language":null,"types":{"schemaOrg":"CreativeWork","resourceTypeGeneral":"Preprint","citeproc":"article","bibtex":"misc","ris":"GEN","resourceType":"Article"},"relatedIdentifiers":[],"relatedItems":[],"sizes":[],"formats":[],"version":"1","rightsList":[{"rightsUri":"http://arxiv.org/licenses/nonexclusive-distrib/1.0/","rights":"arXiv.org perpetual, non-exclusive license"}],"descriptions":[{"descriptionType":"Abstract","description":"Large language models demonstrate strong capabilities in code generation but struggle to navigate complex, multi-language repositories to locate relevant code. Effective code localization requires understanding both organizational context (e.g., historical issue-fix patterns) and structural relationships within heterogeneous codebases. Existing methods either (i) focus narrowly on single-language benchmarks, (ii) retrieve code across languages via shallow textual similarity, or (iii) assume no prior context. We present Multi-CoLoR, a framework for Context-aware Localization and Reasoning across Multi-Language codebases, which integrates organizational knowledge retrieval with graph-based reasoning to traverse complex software ecosystems. Multi-CoLoR operates in two stages: (i) a similar issue context (SIC) module retrieves semantically and organizationally related historical issues to prune the search space, and (ii) a code graph traversal agent (an extended version of LocAgent, a state-of-the-art localization framework) performs structural reasoning within C++ and QML codebases. Evaluations on a real-world enterprise dataset show that incorporating SIC reduces the search space and improves localization accuracy, and graph-based reasoning generalizes effectively beyond Python-only repositories. Combined, Multi-CoLoR improves Acc@5 over both lexical and graph-based baselines while reducing tool calls on an AMD codebase."},{"descriptionType":"Other","description":"This paper has been accepted for publication at the 33rd IEEE International Conference on Software Analysis, Evolution and Reengineering (SANER 2026)"}],"geoLocations":[],"fundingReferences":[],"url":"https://arxiv.org/abs/2602.19407","contentUrl":null,"metadataVersion":0,"schemaVersion":"http://datacite.org/schema/kernel-4","source":"mds","isActive":true,"state":"findable","reason":null,"viewCount":0,"downloadCount":0,"referenceCount":0,"citationCount":0,"partCount":0,"partOfCount":0,"versionCount":0,"versionOfCount":0,"created":"2026-02-25T14:59:09Z","registered":"2026-02-25T14:59:10Z","published":null,"updated":"2026-02-25T14:59:10Z"},"relationships":{"client":{"data":{"id":"arxiv.content","type":"clients"}}}},{"id":"10.48550/arxiv.2602.19406","type":"dois","attributes":{"doi":"10.48550/arxiv.2602.19406","identifiers":[{"identifier":"2602.19406","identifierType":"arXiv"}],"creators":[{"nameType":"Personal","givenName":"Phillip","familyName":"Si","name":"Si, Phillip","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Peng","familyName":"Chen","name":"Chen, Peng","affiliation":[],"nameIdentifiers":[]}],"titles":[{"title":"LEVDA: Latent Ensemble Variational Data Assimilation via Differentiable Dynamics"}],"publisher":"arXiv","container":{},"publicationYear":2026,"subjects":[{"subject":"Machine Learning (cs.LG)","lang":"en","subjectScheme":"arXiv"},{"subject":"Optimization and Control (math.OC)","lang":"en","subjectScheme":"arXiv"},{"subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"},{"schemeUri":"http://www.oecd.org/science/inno/38235147.pdf","subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"},{"subject":"FOS: Mathematics","subjectScheme":"Fields of Science and Technology (FOS)"},{"schemeUri":"http://www.oecd.org/science/inno/38235147.pdf","subject":"FOS: Mathematics","subjectScheme":"Fields of Science and Technology (FOS)"}],"contributors":[],"dates":[{"date":"2026-02-23T00:54:59Z","dateType":"Submitted","dateInformation":"v1"},{"date":"2026-02-24T02:03:28Z","dateType":"Updated","dateInformation":"v1"},{"date":"2026-02","dateType":"Available","dateInformation":"v1"},{"date":"2026","dateType":"Issued"}],"language":null,"types":{"schemaOrg":"CreativeWork","resourceTypeGeneral":"Preprint","citeproc":"article","bibtex":"misc","ris":"GEN","resourceType":"Article"},"relatedIdentifiers":[],"relatedItems":[],"sizes":[],"formats":[],"version":"1","rightsList":[{"rightsIdentifierScheme":"SPDX","rightsUri":"https://creativecommons.org/licenses/by/4.0/legalcode","schemeUri":"https://spdx.org/licenses/","rights":"Creative Commons Attribution 4.0 International","rightsIdentifier":"cc-by-4.0"}],"descriptions":[{"descriptionType":"Abstract","description":"Long-range geophysical forecasts are fundamentally limited by chaotic dynamics and numerical errors. While data assimilation can mitigate these issues, classical variational smoothers require computationally expensive tangent-linear and adjoint models. Conversely, recent efficient latent filtering methods often enforce weak trajectory-level constraints and assume fixed observation grids. To bridge this gap, we propose Latent Ensemble Variational Data Assimilation (LEVDA), an ensemble-space variational smoother that operates in the low-dimensional latent space of a pretrained differentiable neural dynamics surrogate. By performing four-dimensional ensemble-variational (4DEnVar) optimization within an ensemble subspace, LEVDA jointly assimilates states and unknown parameters without the need for adjoint code or auxiliary observation-to-latent encoders. Leveraging the fully differentiable, continuous-in-time-and-space nature of the surrogate, LEVDA naturally accommodates highly irregular sampling at arbitrary spatiotemporal locations. Across three challenging geophysical benchmarks, LEVDA matches or outperforms state-of-the-art latent filtering baselines under severe observational sparsity while providing more reliable uncertainty quantification. Simultaneously, it achieves substantially improved assimilation accuracy and computational efficiency compared to full-state 4DEnVar."}],"geoLocations":[],"fundingReferences":[],"url":"https://arxiv.org/abs/2602.19406","contentUrl":null,"metadataVersion":0,"schemaVersion":"http://datacite.org/schema/kernel-4","source":"mds","isActive":true,"state":"findable","reason":null,"viewCount":0,"downloadCount":0,"referenceCount":0,"citationCount":0,"partCount":0,"partOfCount":0,"versionCount":0,"versionOfCount":0,"created":"2026-02-25T14:59:07Z","registered":"2026-02-25T14:59:07Z","published":null,"updated":"2026-02-25T14:59:07Z"},"relationships":{"client":{"data":{"id":"arxiv.content","type":"clients"}}}},{"id":"10.48550/arxiv.2602.19404","type":"dois","attributes":{"doi":"10.48550/arxiv.2602.19404","identifiers":[{"identifier":"2602.19404","identifierType":"arXiv"}],"creators":[{"nameType":"Personal","givenName":"Tomas","familyName":"Eglinskas","name":"Eglinskas, Tomas","affiliation":[],"nameIdentifiers":[]}],"titles":[{"title":"One Size Fits None: Modeling NYC Taxi Trips"}],"publisher":"arXiv","container":{},"publicationYear":2026,"subjects":[{"subject":"Machine Learning (cs.LG)","lang":"en","subjectScheme":"arXiv"},{"subject":"Artificial Intelligence (cs.AI)","lang":"en","subjectScheme":"arXiv"},{"subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"},{"schemeUri":"http://www.oecd.org/science/inno/38235147.pdf","subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"}],"contributors":[],"dates":[{"date":"2025-12-10T23:20:40Z","dateType":"Submitted","dateInformation":"v1"},{"date":"2026-02-24T02:03:19Z","dateType":"Updated","dateInformation":"v1"},{"date":"2026-02","dateType":"Available","dateInformation":"v1"},{"date":"2026","dateType":"Issued"}],"language":null,"types":{"schemaOrg":"CreativeWork","resourceTypeGeneral":"Preprint","citeproc":"article","bibtex":"misc","ris":"GEN","resourceType":"Article"},"relatedIdentifiers":[],"relatedItems":[],"sizes":[],"formats":[],"version":"1","rightsList":[{"rightsIdentifierScheme":"SPDX","rightsUri":"https://creativecommons.org/licenses/by/4.0/legalcode","schemeUri":"https://spdx.org/licenses/","rights":"Creative Commons Attribution 4.0 International","rightsIdentifier":"cc-by-4.0"}],"descriptions":[{"descriptionType":"Abstract","description":"The rise of app-based ride-sharing has fundamentally changed tipping culture in New York City. We analyzed 280 million trips from 2024 to see if we could predict tips for traditional taxis versus high-volume for-hire services. By testing methods from linear regression to deep neural networks, we found two very different outcomes. Traditional taxis are highly predictable ($R^2 \\approx 0.72$) due to the in-car payment screen. In contrast, app-based tipping is random and hard to model ($R^2 \\approx 0.17$). In conclusion, we show that building one universal model is a mistake and, due to Simpson's paradox, a combined model looks accurate on average but fails to predict tips for individual taxi categories requiring specialized models."},{"descriptionType":"Other","description":"13 pages, 10 figures"}],"geoLocations":[],"fundingReferences":[],"url":"https://arxiv.org/abs/2602.19404","contentUrl":null,"metadataVersion":0,"schemaVersion":"http://datacite.org/schema/kernel-4","source":"mds","isActive":true,"state":"findable","reason":null,"viewCount":0,"downloadCount":0,"referenceCount":0,"citationCount":0,"partCount":0,"partOfCount":0,"versionCount":0,"versionOfCount":0,"created":"2026-02-25T14:59:02Z","registered":"2026-02-25T14:59:02Z","published":null,"updated":"2026-02-25T14:59:02Z"},"relationships":{"client":{"data":{"id":"arxiv.content","type":"clients"}}}},{"id":"10.48550/arxiv.2602.19403","type":"dois","attributes":{"doi":"10.48550/arxiv.2602.19403","identifiers":[{"identifier":"2602.19403","identifierType":"arXiv"}],"creators":[{"nameType":"Personal","affiliation":["Department of Mental Health, Johns Hopkins Bloomberg School of Public Health, Baltimore, MD, USA"],"givenName":"Jasmin","familyName":"Han","name":"Han, Jasmin","nameIdentifiers":[]},{"nameType":"Personal","affiliation":["Department of Mental Health, Johns Hopkins Bloomberg School of Public Health, Baltimore, MD, USA"],"givenName":"Janardan","familyName":"Devkota","name":"Devkota, Janardan","nameIdentifiers":[]},{"nameType":"Personal","affiliation":["Department of Mental Health, Johns Hopkins Bloomberg School of Public Health, Baltimore, MD, USA"],"givenName":"Joseph","familyName":"Waring","name":"Waring, Joseph","nameIdentifiers":[]},{"nameType":"Personal","affiliation":["Department of Health Sciences, Towson University, Towson, USA"],"givenName":"Amanda","familyName":"Luken","name":"Luken, Amanda","nameIdentifiers":[]},{"nameType":"Personal","affiliation":["Addiction Research Group, University of East Anglia, Norwich, UK"],"givenName":"Felix","familyName":"Naughton","name":"Naughton, Felix","nameIdentifiers":[]},{"nameType":"Personal","affiliation":["Department of Implementation Science, Wake Forest University School of Medicine, Winston-Salem, USA"],"givenName":"Roger","familyName":"Vilardaga","name":"Vilardaga, Roger","nameIdentifiers":[]},{"nameType":"Personal","affiliation":["Fred Hutchinson Cancer Center, Seattle, USA","Department of Psychology, University of Washington, Seattle, USA"],"givenName":"Jonathan","familyName":"Bricker","name":"Bricker, Jonathan","nameIdentifiers":[]},{"nameType":"Personal","affiliation":["Department of Health, Behavior and Society, Johns Hopkins Bloomberg School of Public Health, Baltimore, USA"],"givenName":"Carl","familyName":"Latkin","name":"Latkin, Carl","nameIdentifiers":[]},{"nameType":"Personal","affiliation":["Department of Health, Behavior and Society, Johns Hopkins Bloomberg School of Public Health, Baltimore, USA"],"givenName":"Meghan","familyName":"Moran","name":"Moran, Meghan","nameIdentifiers":[]},{"nameType":"Personal","affiliation":["Department of Biostatistics, Johns Hopkins Bloomberg School of Public Health, Baltimore, USA","Department of Computer Science, Johns Hopkins Whiting School of Engineering, Baltimore, USA"],"givenName":"Yiqun","familyName":"Chen","name":"Chen, Yiqun","nameIdentifiers":[]},{"nameType":"Personal","affiliation":["Department of Mental Health, Johns Hopkins Bloomberg School of Public Health, Baltimore, MD, USA","Sidney Kimmel Comprehensive Cancer Center at Johns Hopkins, Baltimore, USA","Centre for Alcohol Policy Research, La Trobe University, Melbourne, Australia"],"givenName":"Johannes","familyName":"Thrul","name":"Thrul, Johannes","nameIdentifiers":[]}],"titles":[{"title":"Personalized Prediction of Perceived Message Effectiveness Using Large Language Model Based Digital Twins"}],"publisher":"arXiv","container":{},"publicationYear":2026,"subjects":[{"subject":"Computation and Language (cs.CL)","lang":"en","subjectScheme":"arXiv"},{"subject":"Applications (stat.AP)","lang":"en","subjectScheme":"arXiv"},{"subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"},{"schemeUri":"http://www.oecd.org/science/inno/38235147.pdf","subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"}],"contributors":[],"dates":[{"date":"2026-02-23T00:32:23Z","dateType":"Submitted","dateInformation":"v1"},{"date":"2026-02-24T02:03:18Z","dateType":"Updated","dateInformation":"v1"},{"date":"2026-02","dateType":"Available","dateInformation":"v1"},{"date":"2026","dateType":"Issued"}],"language":null,"types":{"schemaOrg":"CreativeWork","resourceTypeGeneral":"Preprint","citeproc":"article","bibtex":"misc","ris":"GEN","resourceType":"Article"},"relatedIdentifiers":[],"relatedItems":[],"sizes":[],"formats":[],"version":"1","rightsList":[{"rightsUri":"http://arxiv.org/licenses/nonexclusive-distrib/1.0/","rights":"arXiv.org perpetual, non-exclusive license"}],"descriptions":[{"descriptionType":"Abstract","description":"Perceived message effectiveness (PME) by potential intervention end-users is important for selecting and optimizing personalized smoking cessation intervention messages for mobile health (mHealth) platform delivery. This study evaluates whether large language models (LLMs) can accurately predict PME for smoking cessation messages.\n We evaluated multiple models for predicting PME across three domains: content quality, coping support, and quitting support. The dataset comprised 3010 message ratings (5-point Likert scale) from 301 young adult smokers. We compared (1) supervised learning models trained on labeled data, (2) zero and few-shot LLMs prompted without task-specific fine-tuning, and (3) LLM-based digital twins that incorporate individual characteristics and prior PME histories to generate personalized predictions. Model performance was assessed on three held-out messages per participant using accuracy, Cohen's kappa, and F1.\n LLM-based digital twins outperformed zero and few-shot LLMs (12 percentage points on average) and supervised baselines (13 percentage points), achieving accuracies of 0.49 (content), 0.45 (coping), and 0.49 (quitting), with directional accuracies of 0.75, 0.66, and 0.70 on a simplified 3-point scale. Digital twin predictions showed greater dispersion across rating categories, indicating improved sensitivity to individual differences.\n Integrating personal profiles with LLMs captures person-specific differences in PME and outperforms supervised and zero and few-shot approaches. Improved PME prediction may enable more tailored intervention content in mHealth. LLM-based digital twins show potential for supporting personalization of mobile smoking cessation and other health behavior change interventions."},{"descriptionType":"Other","description":"31 pages, 5 figures, submitted to Journal of the American Medical Informatics Association (JAMIA). Drs. Chen and Thrul share last authorship"}],"geoLocations":[],"fundingReferences":[],"url":"https://arxiv.org/abs/2602.19403","contentUrl":null,"metadataVersion":0,"schemaVersion":"http://datacite.org/schema/kernel-4","source":"mds","isActive":true,"state":"findable","reason":null,"viewCount":0,"downloadCount":0,"referenceCount":0,"citationCount":0,"partCount":0,"partOfCount":0,"versionCount":0,"versionOfCount":0,"created":"2026-02-25T14:58:59Z","registered":"2026-02-25T14:59:00Z","published":null,"updated":"2026-02-25T14:59:00Z"},"relationships":{"client":{"data":{"id":"arxiv.content","type":"clients"}}}},{"id":"10.48550/arxiv.2602.19402","type":"dois","attributes":{"doi":"10.48550/arxiv.2602.19402","identifiers":[{"identifier":"2602.19402","identifierType":"arXiv"}],"creators":[{"nameType":"Personal","givenName":"Qiyue","familyName":"Chen","name":"Chen, Qiyue","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Gregg","familyName":"Musiker","name":"Musiker, Gregg","affiliation":[],"nameIdentifiers":[]}],"titles":[{"title":"Gale-Robinson Quivers and Principal Coefficients"}],"publisher":"arXiv","container":{},"publicationYear":2026,"subjects":[{"subject":"Combinatorics (math.CO)","lang":"en","subjectScheme":"arXiv"},{"subject":"FOS: Mathematics","subjectScheme":"Fields of Science and Technology (FOS)"},{"schemeUri":"http://www.oecd.org/science/inno/38235147.pdf","subject":"FOS: Mathematics","subjectScheme":"Fields of Science and Technology (FOS)"},{"subject":"13F60 (Primary) 05A15, 05C70 (Secondary)","lang":"en","subjectScheme":"MSC"}],"contributors":[],"dates":[{"date":"2026-02-23T00:26:22Z","dateType":"Submitted","dateInformation":"v1"},{"date":"2026-02-24T02:03:15Z","dateType":"Updated","dateInformation":"v1"},{"date":"2026-02","dateType":"Available","dateInformation":"v1"},{"date":"2026","dateType":"Issued"}],"language":null,"types":{"schemaOrg":"CreativeWork","resourceTypeGeneral":"Preprint","citeproc":"article","bibtex":"misc","ris":"GEN","resourceType":"Article"},"relatedIdentifiers":[],"relatedItems":[],"sizes":[],"formats":[],"version":"1","rightsList":[{"rightsUri":"http://arxiv.org/licenses/nonexclusive-distrib/1.0/","rights":"arXiv.org perpetual, non-exclusive license"}],"descriptions":[{"descriptionType":"Abstract","description":"In this paper, we provide a combinatorial interpretation for Laurent polynomials obtained by iteratively mutating a certain periodic quiver that has been framed with frozen vertices. This yields a family of cluster variables with principal coefficients associated to a family of integer sequences known as Gale-Robinson sequences. The work of this paper completes arguments for preliminary results announced in earlier work of Jeong-Musiker-Zhang, and relates to works of Bousquet-Mélou-Propp-West, Speyer, Vichitkunakorn, and of Eager-Franco."},{"descriptionType":"Other","description":"40 pages, 24 figures. Comments welcome"}],"geoLocations":[],"fundingReferences":[],"url":"https://arxiv.org/abs/2602.19402","contentUrl":null,"metadataVersion":0,"schemaVersion":"http://datacite.org/schema/kernel-4","source":"mds","isActive":true,"state":"findable","reason":null,"viewCount":0,"downloadCount":0,"referenceCount":0,"citationCount":0,"partCount":0,"partOfCount":0,"versionCount":0,"versionOfCount":0,"created":"2026-02-25T14:58:57Z","registered":"2026-02-25T14:58:57Z","published":null,"updated":"2026-02-25T14:58:57Z"},"relationships":{"client":{"data":{"id":"arxiv.content","type":"clients"}}}},{"id":"10.48550/arxiv.2602.19400","type":"dois","attributes":{"doi":"10.48550/arxiv.2602.19400","identifiers":[{"identifier":"2602.19400","identifierType":"arXiv"}],"creators":[{"nameType":"Personal","givenName":"Tamil Selvan","familyName":"Gurunathan","name":"Gurunathan, Tamil Selvan","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Aryya","familyName":"Gangopadhyay","name":"Gangopadhyay, Aryya","affiliation":[],"nameIdentifiers":[]}],"titles":[{"title":"Hilbert-Augmented Reinforcement Learning for Scalable Multi-Robot Coverage and Exploration"}],"publisher":"arXiv","container":{},"publicationYear":2026,"subjects":[{"subject":"Robotics (cs.RO)","lang":"en","subjectScheme":"arXiv"},{"subject":"Artificial Intelligence (cs.AI)","lang":"en","subjectScheme":"arXiv"},{"subject":"Multiagent Systems (cs.MA)","lang":"en","subjectScheme":"arXiv"},{"subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"},{"schemeUri":"http://www.oecd.org/science/inno/38235147.pdf","subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"}],"contributors":[],"dates":[{"date":"2026-02-23T00:19:19Z","dateType":"Submitted","dateInformation":"v1"},{"date":"2026-02-24T02:03:04Z","dateType":"Updated","dateInformation":"v1"},{"date":"2026-02","dateType":"Available","dateInformation":"v1"},{"date":"2026","dateType":"Issued"}],"language":null,"types":{"schemaOrg":"CreativeWork","resourceTypeGeneral":"Preprint","citeproc":"article","bibtex":"misc","ris":"GEN","resourceType":"Article"},"relatedIdentifiers":[],"relatedItems":[],"sizes":[],"formats":[],"version":"1","rightsList":[{"rightsIdentifierScheme":"SPDX","rightsUri":"https://creativecommons.org/licenses/by-nc-sa/4.0/legalcode","schemeUri":"https://spdx.org/licenses/","rights":"Creative Commons Attribution Non Commercial Share Alike 4.0 International","rightsIdentifier":"cc-by-nc-sa-4.0"}],"descriptions":[{"descriptionType":"Abstract","description":"We present a coverage framework that integrates Hilbert space-filling priors into decentralized multi-robot learning and execution. We augment DQN and PPO with Hilbert-based spatial indices to structure exploration and reduce redundancy in sparse-reward environments, and we evaluate scalability in multi-robot grid coverage. We further describe a waypoint interface that converts Hilbert orderings into curvature-bounded, time-parameterized SE(2) trajectories (planar (x, y, θ)), enabling onboard feasibility on resource-constrained robots. Experiments show improvements in coverage efficiency, redundancy, and convergence speed over DQN/PPO baselines. In addition, we validate the approach on a Boston Dynamics Spot legged robot, executing the generated trajectories in indoor environments and observing reliable coverage with low redundancy. These results indicate that geometric priors improve autonomy and scalability for swarm and legged robotics."}],"geoLocations":[],"fundingReferences":[],"url":"https://arxiv.org/abs/2602.19400","contentUrl":null,"metadataVersion":0,"schemaVersion":"http://datacite.org/schema/kernel-4","source":"mds","isActive":true,"state":"findable","reason":null,"viewCount":0,"downloadCount":0,"referenceCount":0,"citationCount":0,"partCount":0,"partOfCount":0,"versionCount":0,"versionOfCount":0,"created":"2026-02-25T14:58:51Z","registered":"2026-02-25T14:58:52Z","published":null,"updated":"2026-02-25T14:58:52Z"},"relationships":{"client":{"data":{"id":"arxiv.content","type":"clients"}}}},{"id":"10.48550/arxiv.2602.19399","type":"dois","attributes":{"doi":"10.48550/arxiv.2602.19399","identifiers":[{"identifier":"2602.19399","identifierType":"arXiv"}],"creators":[{"nameType":"Personal","givenName":"Austin R.","familyName":"Kaczmarek","name":"Kaczmarek, Austin R.","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Samantha","familyName":"Walker","name":"Walker, Samantha","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Jason","familyName":"Austermann","name":"Austermann, Jason","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Douglas","familyName":"Bennett","name":"Bennett, Douglas","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"W. Bertrand","familyName":"Doriese","name":"Doriese, W. Bertrand","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Shannon M.","familyName":"Duff","name":"Duff, Shannon M.","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Johannes","familyName":"Hubmayr","name":"Hubmayr, Johannes","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Kelsey","familyName":"Morgan","name":"Morgan, Kelsey","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Michael D.","familyName":"Niemack","name":"Niemack, Michael D.","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Dan","familyName":"Schmidt","name":"Schmidt, Dan","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Daniel","familyName":"Swetz","name":"Swetz, Daniel","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Joel","familyName":"Ullom","name":"Ullom, Joel","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Joel","familyName":"Weber","name":"Weber, Joel","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Katja C.","familyName":"Nowack","name":"Nowack, Katja C.","affiliation":[],"nameIdentifiers":[]}],"titles":[{"title":"Imaging the Superconducting Proximity Effect in S-S'-S Transition Edge Sensors"}],"publisher":"arXiv","container":{},"publicationYear":2026,"subjects":[{"subject":"Superconductivity (cond-mat.supr-con)","lang":"en","subjectScheme":"arXiv"},{"subject":"Instrumentation and Detectors (physics.ins-det)","lang":"en","subjectScheme":"arXiv"},{"subject":"FOS: Physical sciences","subjectScheme":"Fields of Science and Technology (FOS)"},{"schemeUri":"http://www.oecd.org/science/inno/38235147.pdf","subject":"FOS: Physical sciences","subjectScheme":"Fields of Science and Technology (FOS)"}],"contributors":[],"dates":[{"date":"2026-02-23T00:18:20Z","dateType":"Submitted","dateInformation":"v1"},{"date":"2026-02-24T02:03:03Z","dateType":"Updated","dateInformation":"v1"},{"date":"2026-02","dateType":"Available","dateInformation":"v1"},{"date":"2026","dateType":"Issued"}],"language":null,"types":{"schemaOrg":"CreativeWork","resourceTypeGeneral":"Preprint","citeproc":"article","bibtex":"misc","ris":"GEN","resourceType":"Article"},"relatedIdentifiers":[],"relatedItems":[],"sizes":[],"formats":[],"version":"1","rightsList":[{"rightsUri":"http://arxiv.org/licenses/nonexclusive-distrib/1.0/","rights":"arXiv.org perpetual, non-exclusive license"}],"descriptions":[{"descriptionType":"Abstract","description":"Proximity effects at superconducting interfaces, between different superconductors (S-S') or between superconductors and normal metals (S-N), are fundamental to the performance of superconducting electronics, yet only few experiments have directly probed the spatial structure of proximity effects within a device. This is particularly relevant for transition edge sensors (TESs), where the interplay of direct and inverse proximity effects governs detector sensitivity. Here, we use scanning superconducting interference device (SQUID) susceptometry to directly image the local diamagnetic response in functional S-S'-S TES structures. We resolve long range proximity coupling extending over tens of micrometers, revealing that the local transition temperature is dramatically tuned by neighboring regions, being either enhanced by superconducting (S) leads or suppressed by normal metal (N) contacts. Our observations are quantitatively supported by Ginzburg Landau modeling of the device geometry and calculations of the temperature dependent diamagnetism based on self-consistent Usadel equations. By providing spatially resolved measurements of the interplay of proximity effects in TES devices, this work establishes a framework for understanding and controlling superconducting states in heterogeneous superconducting structures."}],"geoLocations":[],"fundingReferences":[],"url":"https://arxiv.org/abs/2602.19399","contentUrl":null,"metadataVersion":0,"schemaVersion":"http://datacite.org/schema/kernel-4","source":"mds","isActive":true,"state":"findable","reason":null,"viewCount":0,"downloadCount":0,"referenceCount":0,"citationCount":0,"partCount":0,"partOfCount":0,"versionCount":0,"versionOfCount":0,"created":"2026-02-25T14:58:49Z","registered":"2026-02-25T14:58:50Z","published":null,"updated":"2026-02-25T14:58:50Z"},"relationships":{"client":{"data":{"id":"arxiv.content","type":"clients"}}}},{"id":"10.48550/arxiv.2602.19398","type":"dois","attributes":{"doi":"10.48550/arxiv.2602.19398","identifiers":[{"identifier":"2602.19398","identifierType":"arXiv"}],"creators":[{"nameType":"Personal","givenName":"Silvia","familyName":"Bacci","name":"Bacci, Silvia","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Leonardo","familyName":"Grilli","name":"Grilli, Leonardo","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Carla","familyName":"Rampichini","name":"Rampichini, Carla","affiliation":[],"nameIdentifiers":[]}],"titles":[{"title":"Variable selection via knockoffs for clustered data"}],"publisher":"arXiv","container":{},"publicationYear":2026,"subjects":[{"subject":"Methodology (stat.ME)","lang":"en","subjectScheme":"arXiv"},{"subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"},{"schemeUri":"http://www.oecd.org/science/inno/38235147.pdf","subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"}],"contributors":[],"dates":[{"date":"2026-02-23T00:13:33Z","dateType":"Submitted","dateInformation":"v1"},{"date":"2026-02-24T02:03:00Z","dateType":"Updated","dateInformation":"v1"},{"date":"2026-02","dateType":"Available","dateInformation":"v1"},{"date":"2026","dateType":"Issued"}],"language":null,"types":{"schemaOrg":"CreativeWork","resourceTypeGeneral":"Preprint","citeproc":"article","bibtex":"misc","ris":"GEN","resourceType":"Article"},"relatedIdentifiers":[],"relatedItems":[],"sizes":[],"formats":[],"version":"1","rightsList":[{"rightsIdentifierScheme":"SPDX","rightsUri":"https://creativecommons.org/licenses/by-nc-nd/4.0/legalcode","schemeUri":"https://spdx.org/licenses/","rights":"Creative Commons Attribution Non Commercial No Derivatives 4.0 International","rightsIdentifier":"cc-by-nc-nd-4.0"}],"descriptions":[{"descriptionType":"Abstract","description":"We extend the knockoffs method for selecting predictors to clustered data (cross-sectional or repeated measures). In the setting of clustered data, variable selection is complex because some predictors are measured at the observation level (level 1), whereas others are measured at the cluster level (level 2), so their values are constant within clusters. The solution we propose is to conduct variable selection separately at the two levels. To this end, we suggest a two-step approach: (i) decompose each level 1 predictor into level 2 and level 1 components by replacing it with the cluster mean and the deviation from the cluster mean; (ii) perform variable selection separately at the two levels, where the level 1 data matrix includes the deviations from the cluster means and the level 2 data matrix includes the cluster means of level 1 predictors and the level 2 predictors. To evaluate the performance of the proposed approach, we conduct a simulation study comparing the sequential knockoff, the derandomized knockoff, and the Lasso. The study shows satisfactory results in terms of false discovery rate and power. All methods fail when applied to the complete data matrix, including both level 1 and level 2 predictors. In contrast, all methods perform better when applied to the level 1 and level 2 data matrices separately. Moreover, the sequential knockoffs method performs substantially better than the Lasso and the derandomized knockoffs. Our proposal to implement the knockoffs method in a clustered data framework is feasible, flexible, and effective."},{"descriptionType":"Other","description":"11 pages, under submission"}],"geoLocations":[],"fundingReferences":[],"url":"https://arxiv.org/abs/2602.19398","contentUrl":null,"metadataVersion":0,"schemaVersion":"http://datacite.org/schema/kernel-4","source":"mds","isActive":true,"state":"findable","reason":null,"viewCount":0,"downloadCount":0,"referenceCount":0,"citationCount":0,"partCount":0,"partOfCount":0,"versionCount":0,"versionOfCount":0,"created":"2026-02-25T14:58:46Z","registered":"2026-02-25T14:58:47Z","published":null,"updated":"2026-02-25T14:58:47Z"},"relationships":{"client":{"data":{"id":"arxiv.content","type":"clients"}}}},{"id":"10.48550/arxiv.2602.19397","type":"dois","attributes":{"doi":"10.48550/arxiv.2602.19397","identifiers":[{"identifier":"2602.19397","identifierType":"arXiv"}],"creators":[{"nameType":"Personal","givenName":"Min","familyName":"Namkung","name":"Namkung, Min","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Hyang-Tag","familyName":"Lim","name":"Lim, Hyang-Tag","affiliation":[],"nameIdentifiers":[]}],"titles":[{"title":"Contextuality-enhanced quantum state discrimination under fixed failure probability"}],"publisher":"arXiv","container":{},"publicationYear":2026,"subjects":[{"subject":"Quantum Physics (quant-ph)","lang":"en","subjectScheme":"arXiv"},{"subject":"FOS: Physical sciences","subjectScheme":"Fields of Science and Technology (FOS)"},{"schemeUri":"http://www.oecd.org/science/inno/38235147.pdf","subject":"FOS: Physical sciences","subjectScheme":"Fields of Science and Technology (FOS)"}],"contributors":[],"dates":[{"date":"2026-02-23T00:13:27Z","dateType":"Submitted","dateInformation":"v1"},{"date":"2026-02-24T02:02:59Z","dateType":"Updated","dateInformation":"v1"},{"date":"2026-02","dateType":"Available","dateInformation":"v1"},{"date":"2026","dateType":"Issued"}],"language":null,"types":{"schemaOrg":"CreativeWork","resourceTypeGeneral":"Preprint","citeproc":"article","bibtex":"misc","ris":"GEN","resourceType":"Article"},"relatedIdentifiers":[{"relationType":"IsVersionOf","relatedIdentifier":"10.1103/zx3b-y3fc","relatedIdentifierType":"DOI"}],"relatedItems":[],"sizes":[],"formats":[],"version":"1","rightsList":[{"rightsIdentifierScheme":"SPDX","rightsUri":"https://creativecommons.org/licenses/by/4.0/legalcode","schemeUri":"https://spdx.org/licenses/","rights":"Creative Commons Attribution 4.0 International","rightsIdentifier":"cc-by-4.0"}],"descriptions":[{"descriptionType":"Abstract","description":"Quantum state discrimination enables the accurate identification of quantum states, which are generally nonorthogonal. Among various strategies, minimum-error discrimination and unambiguous state discrimination exhibit contextuality-enhanced success probabilities that surpass classical bounds, offering significant advantages for quantum sensing and communication. However, in practice, both error and failure outcomes can occur, suggesting the need for a unified strategy that incorporates both aspects while exploring the potential for contextuality enhancement. In this work, we theoretically demonstrate contextuality enhancement in quantum state discrimination under a fixed failure probability. We show that this enhancement disappears within a certain intermediate range of failure probabilities--a phenomenon absent in conventional strategies, where both minimum-error and unambiguous discrimination consistently outperform the noncontextual bound for equal priors. Moreover, we analyze how the existence of this non-enhancement region depends on the confusability of the quantum states, which corresponds to their fidelity in a quantum model. We further extend the discussion to the noisy state discrimination, which even encompasses the maximal-confidence discrimination. In this extended discussion, we observe that the non-enhancement region tends to disappear with increasing noise strength."},{"descriptionType":"Other","description":"12 pages, 4 figures"}],"geoLocations":[],"fundingReferences":[],"url":"https://arxiv.org/abs/2602.19397","contentUrl":null,"metadataVersion":0,"schemaVersion":"http://datacite.org/schema/kernel-4","source":"mds","isActive":true,"state":"findable","reason":null,"viewCount":0,"downloadCount":0,"referenceCount":0,"citationCount":0,"partCount":0,"partOfCount":0,"versionCount":0,"versionOfCount":1,"created":"2026-02-25T14:58:44Z","registered":"2026-02-25T14:58:44Z","published":null,"updated":"2026-02-25T14:58:44Z"},"relationships":{"client":{"data":{"id":"arxiv.content","type":"clients"}}}},{"id":"10.48550/arxiv.2602.19396","type":"dois","attributes":{"doi":"10.48550/arxiv.2602.19396","identifiers":[{"identifier":"2602.19396","identifierType":"arXiv"}],"creators":[{"nameType":"Personal","givenName":"Amirhossein","familyName":"Farzam","name":"Farzam, Amirhossein","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Majid","familyName":"Behabahani","name":"Behabahani, Majid","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Mani","familyName":"Malek","name":"Malek, Mani","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Yuriy","familyName":"Nevmyvaka","name":"Nevmyvaka, Yuriy","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Guillermo","familyName":"Sapiro","name":"Sapiro, Guillermo","affiliation":[],"nameIdentifiers":[]}],"titles":[{"title":"Hiding in Plain Text: Detecting Concealed Jailbreaks via Activation Disentanglement"}],"publisher":"arXiv","container":{},"publicationYear":2026,"subjects":[{"subject":"Artificial Intelligence (cs.AI)","lang":"en","subjectScheme":"arXiv"},{"subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"},{"schemeUri":"http://www.oecd.org/science/inno/38235147.pdf","subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"}],"contributors":[],"dates":[{"date":"2026-02-23T00:11:30Z","dateType":"Submitted","dateInformation":"v1"},{"date":"2026-02-24T02:02:57Z","dateType":"Updated","dateInformation":"v1"},{"date":"2026-02","dateType":"Available","dateInformation":"v1"},{"date":"2026","dateType":"Issued"}],"language":null,"types":{"schemaOrg":"CreativeWork","resourceTypeGeneral":"Preprint","citeproc":"article","bibtex":"misc","ris":"GEN","resourceType":"Article"},"relatedIdentifiers":[],"relatedItems":[],"sizes":[],"formats":[],"version":"1","rightsList":[{"rightsIdentifierScheme":"SPDX","rightsUri":"https://creativecommons.org/licenses/by/4.0/legalcode","schemeUri":"https://spdx.org/licenses/","rights":"Creative Commons Attribution 4.0 International","rightsIdentifier":"cc-by-4.0"}],"descriptions":[{"descriptionType":"Abstract","description":"Large language models (LLMs) remain vulnerable to jailbreak prompts that are fluent and semantically coherent, and therefore difficult to detect with standard heuristics. A particularly challenging failure mode occurs when an attacker tries to hide the malicious goal of their request by manipulating its framing to induce compliance. Because these attacks maintain malicious intent through a flexible presentation, defenses that rely on structural artifacts or goal-specific signatures can fail. Motivated by this, we introduce a self-supervised framework for disentangling semantic factor pairs in LLM activations at inference. We instantiate the framework for goal and framing and construct GoalFrameBench, a corpus of prompts with controlled goal and framing variations, which we use to train Representation Disentanglement on Activations (ReDAct) module to extract disentangled representations in a frozen LLM. We then propose FrameShield, an anomaly detector operating on the framing representations, which improves model-agnostic detection across multiple LLM families with minimal computational overhead. Theoretical guarantees for ReDAct and extensive empirical validations show that its disentanglement effectively powers FrameShield. Finally, we use disentanglement as an interpretability probe, revealing distinct profiles for goal and framing signals and positioning semantic disentanglement as a building block for both LLM safety and mechanistic interpretability."}],"geoLocations":[],"fundingReferences":[],"url":"https://arxiv.org/abs/2602.19396","contentUrl":null,"metadataVersion":0,"schemaVersion":"http://datacite.org/schema/kernel-4","source":"mds","isActive":true,"state":"findable","reason":null,"viewCount":0,"downloadCount":0,"referenceCount":0,"citationCount":0,"partCount":0,"partOfCount":0,"versionCount":0,"versionOfCount":0,"created":"2026-02-25T14:58:41Z","registered":"2026-02-25T14:58:42Z","published":null,"updated":"2026-02-25T14:58:42Z"},"relationships":{"client":{"data":{"id":"arxiv.content","type":"clients"}}}},{"id":"10.48550/arxiv.2602.19395","type":"dois","attributes":{"doi":"10.48550/arxiv.2602.19395","identifiers":[{"identifier":"2602.19395","identifierType":"arXiv"}],"creators":[{"nameType":"Personal","givenName":"Karan","familyName":"Thakkar","name":"Thakkar, Karan","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Mounya","familyName":"Elhilali","name":"Elhilali, Mounya","affiliation":[],"nameIdentifiers":[]}],"titles":[{"title":"DECAF: Dynamic Envelope Context-Aware Fusion for Speech-Envelope Reconstruction from EEG"}],"publisher":"arXiv","container":{},"publicationYear":2026,"subjects":[{"subject":"Sound (cs.SD)","lang":"en","subjectScheme":"arXiv"},{"subject":"Signal Processing (eess.SP)","lang":"en","subjectScheme":"arXiv"},{"subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"},{"schemeUri":"http://www.oecd.org/science/inno/38235147.pdf","subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"},{"subject":"FOS: Electrical engineering, electronic engineering, information engineering","subjectScheme":"Fields of Science and Technology (FOS)"},{"schemeUri":"http://www.oecd.org/science/inno/38235147.pdf","subject":"FOS: Electrical engineering, electronic engineering, information engineering","subjectScheme":"Fields of Science and Technology (FOS)"}],"contributors":[],"dates":[{"date":"2026-02-23T00:06:49Z","dateType":"Submitted","dateInformation":"v1"},{"date":"2026-02-24T02:02:56Z","dateType":"Updated","dateInformation":"v1"},{"date":"2026-02","dateType":"Available","dateInformation":"v1"},{"date":"2026","dateType":"Issued"}],"language":null,"types":{"schemaOrg":"CreativeWork","resourceTypeGeneral":"Preprint","citeproc":"article","bibtex":"misc","ris":"GEN","resourceType":"Article"},"relatedIdentifiers":[],"relatedItems":[],"sizes":[],"formats":[],"version":"1","rightsList":[{"rightsIdentifierScheme":"SPDX","rightsUri":"https://creativecommons.org/licenses/by/4.0/legalcode","schemeUri":"https://spdx.org/licenses/","rights":"Creative Commons Attribution 4.0 International","rightsIdentifier":"cc-by-4.0"}],"descriptions":[{"descriptionType":"Abstract","description":"Reconstructing the speech audio envelope from scalp neural recordings (EEG) is a central task for decoding a listener's attentional focus in applications like neuro-steered hearing aids. Current methods for this reconstruction, however, face challenges with fidelity and noise. Prevailing approaches treat it as a static regression problem, processing each EEG window in isolation and ignoring the rich temporal structure inherent in continuous speech. This study introduces a new, dynamic framework for envelope reconstruction that leverages this structure as a predictive temporal prior. We propose a state-space fusion model that combines direct neural estimates from EEG with predictions from recent speech context, using a learned gating mechanism to adaptively balance these cues. To validate this approach, we evaluate our model on the ICASSP 2023 Stimulus Reconstruction benchmark demonstrating significant improvements over static, EEG-only baselines. Our analyses reveal a powerful synergy between the neural and temporal information streams. Ultimately, this work reframes envelope reconstruction not as a simple mapping, but as a dynamic state-estimation problem, opening a new direction for developing more accurate and coherent neural decoding systems."},{"descriptionType":"Other","description":"Accepted at ICASSP 2026"}],"geoLocations":[],"fundingReferences":[],"url":"https://arxiv.org/abs/2602.19395","contentUrl":null,"metadataVersion":0,"schemaVersion":"http://datacite.org/schema/kernel-4","source":"mds","isActive":true,"state":"findable","reason":null,"viewCount":0,"downloadCount":0,"referenceCount":0,"citationCount":0,"partCount":0,"partOfCount":0,"versionCount":0,"versionOfCount":0,"created":"2026-02-25T14:58:39Z","registered":"2026-02-25T14:58:40Z","published":null,"updated":"2026-02-25T14:58:40Z"},"relationships":{"client":{"data":{"id":"arxiv.content","type":"clients"}}}},{"id":"10.48550/arxiv.2602.19394","type":"dois","attributes":{"doi":"10.48550/arxiv.2602.19394","identifiers":[{"identifier":"2602.19394","identifierType":"arXiv"}],"creators":[{"nameType":"Personal","givenName":"Sergey","familyName":"Bezuglyi","name":"Bezuglyi, Sergey","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Palle","familyName":"Jorgensen","name":"Jorgensen, Palle","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Olena","familyName":"Karpel","name":"Karpel, Olena","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Thiago","familyName":"Raszeja","name":"Raszeja, Thiago","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Shrey","familyName":"Sanadhya","name":"Sanadhya, Shrey","affiliation":[],"nameIdentifiers":[]}],"titles":[{"title":"Subdiagrams and invariant measures for generalized Bratteli diagrams"}],"publisher":"arXiv","container":{},"publicationYear":2026,"subjects":[{"subject":"Dynamical Systems (math.DS)","lang":"en","subjectScheme":"arXiv"},{"subject":"FOS: Mathematics","subjectScheme":"Fields of Science and Technology (FOS)"},{"schemeUri":"http://www.oecd.org/science/inno/38235147.pdf","subject":"FOS: Mathematics","subjectScheme":"Fields of Science and Technology (FOS)"},{"subject":"37A05, 37B05, 37A40, 54H05, 05C60","lang":"en","subjectScheme":"MSC"}],"contributors":[],"dates":[{"date":"2026-02-23T00:01:21Z","dateType":"Submitted","dateInformation":"v1"},{"date":"2026-02-24T02:02:51Z","dateType":"Updated","dateInformation":"v1"},{"date":"2026-02","dateType":"Available","dateInformation":"v1"},{"date":"2026","dateType":"Issued"}],"language":null,"types":{"schemaOrg":"CreativeWork","resourceTypeGeneral":"Preprint","citeproc":"article","bibtex":"misc","ris":"GEN","resourceType":"Article"},"relatedIdentifiers":[],"relatedItems":[],"sizes":[],"formats":[],"version":"1","rightsList":[{"rightsIdentifierScheme":"SPDX","rightsUri":"https://creativecommons.org/licenses/by/4.0/legalcode","schemeUri":"https://spdx.org/licenses/","rights":"Creative Commons Attribution 4.0 International","rightsIdentifier":"cc-by-4.0"}],"descriptions":[{"descriptionType":"Abstract","description":"The results of this paper contribute to the study of invariant measures of Borel dynamical systems that can be modeled using generalized Bratteli diagrams. In this context, we study tail invariant measures on the path spaces of generalized Bratteli diagrams, allowing countably infinite vertex sets at each level. Our main focus is on subdiagrams of generalized Bratteli diagrams and the problem of extending tail invariant probability measures from vertex and edge subdiagrams to the ambient diagram. We establish necessary and sufficient conditions for the finiteness of such extensions, formulated in terms of incidence matrices and associated stochastic matrices. Several classes of generalized Bratteli diagrams and their subdiagrams are analyzed in detail, including simple, stationary, and bounded size diagrams. We develop constructive, step-by-step procedures for measure extension and for approximating invariant measures by measures supported on suitable subdiagrams. In addition, we provide explicit examples of generalized Bratteli diagrams that admit no probability tail invariant measures, a phenomenon absent for standard Bratteli diagrams with finite vertex sets. Finally, we address convergence questions for sequences of invariant measures arising from approximations by subdiagrams, clarifying the relationship between combinatorial structure and measure-theoretic behavior."}],"geoLocations":[],"fundingReferences":[],"url":"https://arxiv.org/abs/2602.19394","contentUrl":null,"metadataVersion":0,"schemaVersion":"http://datacite.org/schema/kernel-4","source":"mds","isActive":true,"state":"findable","reason":null,"viewCount":0,"downloadCount":0,"referenceCount":0,"citationCount":0,"partCount":0,"partOfCount":0,"versionCount":0,"versionOfCount":0,"created":"2026-02-25T14:58:36Z","registered":"2026-02-25T14:58:37Z","published":null,"updated":"2026-02-25T14:58:37Z"},"relationships":{"client":{"data":{"id":"arxiv.content","type":"clients"}}}},{"id":"10.48550/arxiv.2602.19392","type":"dois","attributes":{"doi":"10.48550/arxiv.2602.19392","identifiers":[{"identifier":"2602.19392","identifierType":"arXiv"}],"creators":[{"nameType":"Personal","givenName":"Jing","familyName":"Ren","name":"Ren, Jing","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Jiapeng","familyName":"Du","name":"Du, Jiapeng","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Bowen","familyName":"Li","name":"Li, Bowen","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Ziqi","familyName":"Xu","name":"Xu, Ziqi","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Xin","familyName":"Zheng","name":"Zheng, Xin","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Hong","familyName":"Jia","name":"Jia, Hong","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Suyu","familyName":"Ma","name":"Ma, Suyu","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Xiwei","familyName":"Xu","name":"Xu, Xiwei","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Feng","familyName":"Xia","name":"Xia, Feng","affiliation":[],"nameIdentifiers":[]}],"titles":[{"title":"Spiking Graph Predictive Coding for Reliable OOD Generalization"}],"publisher":"arXiv","container":{},"publicationYear":2026,"subjects":[{"subject":"Machine Learning (cs.LG)","lang":"en","subjectScheme":"arXiv"},{"subject":"Social and Information Networks (cs.SI)","lang":"en","subjectScheme":"arXiv"},{"subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"},{"schemeUri":"http://www.oecd.org/science/inno/38235147.pdf","subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"}],"contributors":[],"dates":[{"date":"2026-02-22T23:58:47Z","dateType":"Submitted","dateInformation":"v1"},{"date":"2026-02-24T02:02:46Z","dateType":"Updated","dateInformation":"v1"},{"date":"2026-02","dateType":"Available","dateInformation":"v1"},{"date":"2026","dateType":"Issued"}],"language":null,"types":{"schemaOrg":"CreativeWork","resourceTypeGeneral":"Preprint","citeproc":"article","bibtex":"misc","ris":"GEN","resourceType":"Article"},"relatedIdentifiers":[],"relatedItems":[],"sizes":[],"formats":[],"version":"1","rightsList":[{"rightsUri":"http://arxiv.org/licenses/nonexclusive-distrib/1.0/","rights":"arXiv.org perpetual, non-exclusive license"}],"descriptions":[{"descriptionType":"Abstract","description":"Graphs provide a powerful basis for modeling Web-based relational data, with expressive GNNs to support the effective learning in dynamic web environments. However, real-world deployment is hindered by pervasive out-of-distribution (OOD) shifts, where evolving user activity and changing content semantics alter feature distributions and labeling criteria. These shifts often lead to unstable or overconfident predictions, undermining the trustworthiness required for Web4Good applications. Achieving reliable OOD generalization demands principled and interpretable uncertainty estimation; however, existing methods are largely post-hoc, insensitive to distribution shifts, and unable to explain where uncertainty arises especially in high-stakes settings. To address these limitations, we introduce SpIking GrapH predicTive coding (SIGHT), an uncertainty-aware plug-in graph learning module for reliable OOD Generalization. SIGHT performs iterative, error-driven correction over spiking graph states, enabling models to expose internal mismatch signals that reveal where predictions become unreliable. Across multiple graph benchmarks and diverse OOD scenarios, SIGHT consistently enhances predictive accuracy, uncertainty estimation, and interpretability when integrated with GNNs."},{"descriptionType":"Other","description":"12 pages, 6 figures, WWW26, Dubai, United Arab Emirates"}],"geoLocations":[],"fundingReferences":[],"url":"https://arxiv.org/abs/2602.19392","contentUrl":null,"metadataVersion":0,"schemaVersion":"http://datacite.org/schema/kernel-4","source":"mds","isActive":true,"state":"findable","reason":null,"viewCount":0,"downloadCount":0,"referenceCount":0,"citationCount":0,"partCount":0,"partOfCount":0,"versionCount":0,"versionOfCount":0,"created":"2026-02-25T14:58:31Z","registered":"2026-02-25T14:58:32Z","published":null,"updated":"2026-02-25T14:58:32Z"},"relationships":{"client":{"data":{"id":"arxiv.content","type":"clients"}}}},{"id":"10.48550/arxiv.2602.19391","type":"dois","attributes":{"doi":"10.48550/arxiv.2602.19391","identifiers":[{"identifier":"2602.19391","identifierType":"arXiv"}],"creators":[{"nameType":"Personal","givenName":"Egon","familyName":"Schulte","name":"Schulte, Egon","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Tomas","familyName":"Skacel","name":"Skacel, Tomas","affiliation":[],"nameIdentifiers":[]}],"titles":[{"title":"Skeletal Snub Polyhedra in Ordinary Space, I"}],"publisher":"arXiv","container":{},"publicationYear":2026,"subjects":[{"subject":"Combinatorics (math.CO)","lang":"en","subjectScheme":"arXiv"},{"subject":"Metric Geometry (math.MG)","lang":"en","subjectScheme":"arXiv"},{"subject":"FOS: Mathematics","subjectScheme":"Fields of Science and Technology (FOS)"},{"schemeUri":"http://www.oecd.org/science/inno/38235147.pdf","subject":"FOS: Mathematics","subjectScheme":"Fields of Science and Technology (FOS)"},{"subject":"Primary: 51M20. Secondary: 52B15","lang":"en","subjectScheme":"MSC"}],"contributors":[],"dates":[{"date":"2026-02-22T23:52:23Z","dateType":"Submitted","dateInformation":"v1"},{"date":"2026-02-24T02:02:40Z","dateType":"Updated","dateInformation":"v1"},{"date":"2026-02","dateType":"Available","dateInformation":"v1"},{"date":"2026","dateType":"Issued"}],"language":null,"types":{"schemaOrg":"CreativeWork","resourceTypeGeneral":"Preprint","citeproc":"article","bibtex":"misc","ris":"GEN","resourceType":"Article"},"relatedIdentifiers":[],"relatedItems":[],"sizes":[],"formats":[],"version":"1","rightsList":[{"rightsIdentifierScheme":"SPDX","rightsUri":"https://creativecommons.org/licenses/by/4.0/legalcode","schemeUri":"https://spdx.org/licenses/","rights":"Creative Commons Attribution 4.0 International","rightsIdentifier":"cc-by-4.0"}],"descriptions":[{"descriptionType":"Abstract","description":"Skeletal polyhedra are discrete connected structures consisting of finite (planar or skew) or infinite (linear, planar, or spatial) polygons as faces, with two faces on each edge and a circular vertex figure at each vertex. The present paper describes the blueprint for the snub construction and shows that it can be applied to both regular and chiral skeletal polyhedra in ordinary space. The resulting skeletal snub polyhedra are vertex-transitive and highly locally symmetric. Their properties - from a combinatorial, topological, and geometric perspective - are described and illustrated on some particularly interesting examples. We examine when the construction yields uniform skeletal polyhedra and discuss the completeness of our list of generated structures."},{"descriptionType":"Other","description":"41 pages"}],"geoLocations":[],"fundingReferences":[],"url":"https://arxiv.org/abs/2602.19391","contentUrl":null,"metadataVersion":0,"schemaVersion":"http://datacite.org/schema/kernel-4","source":"mds","isActive":true,"state":"findable","reason":null,"viewCount":0,"downloadCount":0,"referenceCount":0,"citationCount":0,"partCount":0,"partOfCount":0,"versionCount":0,"versionOfCount":0,"created":"2026-02-25T14:58:28Z","registered":"2026-02-25T14:58:29Z","published":null,"updated":"2026-02-25T14:58:29Z"},"relationships":{"client":{"data":{"id":"arxiv.content","type":"clients"}}}},{"id":"10.48550/arxiv.2602.19390","type":"dois","attributes":{"doi":"10.48550/arxiv.2602.19390","identifiers":[{"identifier":"2602.19390","identifierType":"arXiv"}],"creators":[{"nameType":"Personal","givenName":"Philipp","familyName":"Zech","name":"Zech, Philipp","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Istvan","familyName":"David","name":"David, Istvan","affiliation":[],"nameIdentifiers":[]}],"titles":[{"title":"Artificial Intelligence for Modeling \u0026amp; Simulation in Digital Twins"}],"publisher":"arXiv","container":{},"publicationYear":2026,"subjects":[{"subject":"Artificial Intelligence (cs.AI)","lang":"en","subjectScheme":"arXiv"},{"subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"},{"schemeUri":"http://www.oecd.org/science/inno/38235147.pdf","subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"}],"contributors":[],"dates":[{"date":"2026-02-22T23:47:43Z","dateType":"Submitted","dateInformation":"v1"},{"date":"2026-02-24T02:02:30Z","dateType":"Updated","dateInformation":"v1"},{"date":"2026-02","dateType":"Available","dateInformation":"v1"},{"date":"2026","dateType":"Issued"}],"language":null,"types":{"schemaOrg":"CreativeWork","resourceTypeGeneral":"Preprint","citeproc":"article","bibtex":"misc","ris":"GEN","resourceType":"Article"},"relatedIdentifiers":[],"relatedItems":[],"sizes":[],"formats":[],"version":"1","rightsList":[{"rightsUri":"http://arxiv.org/licenses/nonexclusive-distrib/1.0/","rights":"arXiv.org perpetual, non-exclusive license"}],"descriptions":[{"descriptionType":"Abstract","description":"The convergence of modeling \u0026amp; simulation (M\u0026amp;S) and artificial intelligence (AI) is leaving its marks on advanced digital technology. Pertinent examples are digital twins (DTs) - high-fidelity, live representations of physical assets, and frequent enablers of corporate digital maturation and transformation. Often seen as technological platforms that integrate an array of services, DTs have the potential to bring AI-enabled M\u0026amp;S closer to end-users. It is, therefore, paramount to understand the role of M\u0026amp;S in DTs, and the role of digital twins in enabling the convergence of AI and M\u0026amp;S. To this end, this chapter provides a comprehensive exploration of the complementary relationship between these three. We begin by establishing a foundational understanding of DTs by detailing their key components, architectural layers, and their various roles across business, development, and operations. We then examine the central role of M\u0026amp;S in DTs and provide an overview of key modeling techniques from physics-based and discrete-event simulation to hybrid approaches. Subsequently, we investigate the bidirectional role of AI: first, how AI enhances DTs through advanced analytics, predictive capabilities, and autonomous decision-making, and second, how DTs serve as valuable platforms for training, validating, and deploying AI models. The chapter concludes by identifying key challenges and future research directions for creating more integrated and intelligent systems."}],"geoLocations":[],"fundingReferences":[],"url":"https://arxiv.org/abs/2602.19390","contentUrl":null,"metadataVersion":0,"schemaVersion":"http://datacite.org/schema/kernel-4","source":"mds","isActive":true,"state":"findable","reason":null,"viewCount":0,"downloadCount":0,"referenceCount":0,"citationCount":0,"partCount":0,"partOfCount":0,"versionCount":0,"versionOfCount":0,"created":"2026-02-25T14:58:26Z","registered":"2026-02-25T14:58:27Z","published":null,"updated":"2026-02-25T14:58:27Z"},"relationships":{"client":{"data":{"id":"arxiv.content","type":"clients"}}}},{"id":"10.48550/arxiv.2602.19389","type":"dois","attributes":{"doi":"10.48550/arxiv.2602.19389","identifiers":[{"identifier":"2602.19389","identifierType":"arXiv"}],"creators":[{"nameType":"Personal","givenName":"Simon","familyName":"Woodruff","name":"Woodruff, Simon","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Alicia","familyName":"Durham","name":"Durham, Alicia","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Alex","familyName":"Higginbottom","name":"Higginbottom, Alex","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Chris","familyName":"Raastad","name":"Raastad, Chris","affiliation":[],"nameIdentifiers":[]}],"titles":[{"title":"Extension of the fusion power plant costing standard"}],"publisher":"arXiv","container":{},"publicationYear":2026,"subjects":[{"subject":"Physics and Society (physics.soc-ph)","lang":"en","subjectScheme":"arXiv"},{"subject":"General Economics (econ.GN)","lang":"en","subjectScheme":"arXiv"},{"subject":"FOS: Physical sciences","subjectScheme":"Fields of Science and Technology (FOS)"},{"schemeUri":"http://www.oecd.org/science/inno/38235147.pdf","subject":"FOS: Physical sciences","subjectScheme":"Fields of Science and Technology (FOS)"},{"subject":"FOS: Economics and business","subjectScheme":"Fields of Science and Technology (FOS)"},{"schemeUri":"http://www.oecd.org/science/inno/38235147.pdf","subject":"FOS: Economics and business","subjectScheme":"Fields of Science and Technology (FOS)"}],"contributors":[],"dates":[{"date":"2026-02-22T23:47:14Z","dateType":"Submitted","dateInformation":"v1"},{"date":"2026-02-24T02:02:30Z","dateType":"Updated","dateInformation":"v1"},{"date":"2026-02","dateType":"Available","dateInformation":"v1"},{"date":"2026","dateType":"Issued"}],"language":null,"types":{"schemaOrg":"CreativeWork","resourceTypeGeneral":"Preprint","citeproc":"article","bibtex":"misc","ris":"GEN","resourceType":"Article"},"relatedIdentifiers":[],"relatedItems":[],"sizes":[],"formats":[],"version":"1","rightsList":[{"rightsIdentifierScheme":"SPDX","rightsUri":"https://creativecommons.org/licenses/by-sa/4.0/legalcode","schemeUri":"https://spdx.org/licenses/","rights":"Creative Commons Attribution Share Alike 4.0 International","rightsIdentifier":"cc-by-sa-4.0"}],"descriptions":[{"descriptionType":"Abstract","description":"This paper documents the work of the Clean Air Task Force (CATF) International Working Group (IWG) on Fusion Cost Analysis in 2024-2025, and the methodological extensions implemented in the CATF-supported branch of the pyFECONs fusion power-plant costing framework. Using the standards-aligned chart-of-accounts and physics-to-economics workflow established by ARPA-E. The IWG development reorganizes and deepens the framework around three architecture-defining cost-driver tracks for Magnetic Fusion Energy (MFE), Inertial Fusion Energy (IFE), and Magneto-Inertial Fusion Energy (MIFE). In particular, the generic driver placeholder in Account 22.1.3 is treated as a controlled swap-point and replaced by a full cost-account development for the dominant driver in each class, enabling auditable traceability from requirements and geometry to rolled-up plant costs. On top of this driver-centric foundation, we introduce a probabilistic costing layer that compounds materials price uncertainty, TRL-based maturity uncertainty, and learning-curve uncertainty into cost distributions. We then describe safety-informed costing that enumerates fusion-relevant hazards and maps mitigating systems, structures, and provisions into standardized accounts, together with scenario-parameterized regulatory and financial adders. Finally, we document expanded macroeconomic and finance parameterization and a value-metrics module that complements LCOE with investment and planning measures (NPV, IRR MIRR, revenue requirements, WACC-based annualization, and residual and follow-on value), all computed from the same COA-mapped outputs. Collectively, these additions convert a deterministic, standards-aligned costing backbone into an extensible analysis environment suitable for transparent sensitivity studies, uncertainty propagation, and safety- and finance-coupled interpretation of fusion pilot-plant and NOAK scenarios."}],"geoLocations":[],"fundingReferences":[],"url":"https://arxiv.org/abs/2602.19389","contentUrl":null,"metadataVersion":0,"schemaVersion":"http://datacite.org/schema/kernel-4","source":"mds","isActive":true,"state":"findable","reason":null,"viewCount":0,"downloadCount":0,"referenceCount":0,"citationCount":0,"partCount":0,"partOfCount":0,"versionCount":0,"versionOfCount":0,"created":"2026-02-25T14:58:23Z","registered":"2026-02-25T14:58:24Z","published":null,"updated":"2026-02-25T14:58:24Z"},"relationships":{"client":{"data":{"id":"arxiv.content","type":"clients"}}}},{"id":"10.48550/arxiv.2602.19387","type":"dois","attributes":{"doi":"10.48550/arxiv.2602.19387","identifiers":[{"identifier":"2602.19387","identifierType":"arXiv"}],"creators":[{"nameType":"Personal","givenName":"Marco","familyName":"Knipfer","name":"Knipfer, Marco","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Alexander","familyName":"Roman","name":"Roman, Alexander","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Konstantin T.","familyName":"Matchev","name":"Matchev, Konstantin T.","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Katia","familyName":"Matcheva","name":"Matcheva, Katia","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Sergei","familyName":"Gleyzer","name":"Gleyzer, Sergei","affiliation":[],"nameIdentifiers":[]}],"titles":[{"title":"AI Agents for Variational Quantum Circuit Design"}],"publisher":"arXiv","container":{},"publicationYear":2026,"subjects":[{"subject":"Quantum Physics (quant-ph)","lang":"en","subjectScheme":"arXiv"},{"subject":"Emerging Technologies (cs.ET)","lang":"en","subjectScheme":"arXiv"},{"subject":"High Energy Physics - Experiment (hep-ex)","lang":"en","subjectScheme":"arXiv"},{"subject":"High Energy Physics - Lattice (hep-lat)","lang":"en","subjectScheme":"arXiv"},{"subject":"High Energy Physics - Phenomenology (hep-ph)","lang":"en","subjectScheme":"arXiv"},{"subject":"FOS: Physical sciences","subjectScheme":"Fields of Science and Technology (FOS)"},{"schemeUri":"http://www.oecd.org/science/inno/38235147.pdf","subject":"FOS: Physical sciences","subjectScheme":"Fields of Science and Technology (FOS)"},{"subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"},{"schemeUri":"http://www.oecd.org/science/inno/38235147.pdf","subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"}],"contributors":[],"dates":[{"date":"2026-02-22T23:41:22Z","dateType":"Submitted","dateInformation":"v1"},{"date":"2026-02-24T02:02:25Z","dateType":"Updated","dateInformation":"v1"},{"date":"2026-02","dateType":"Available","dateInformation":"v1"},{"date":"2026","dateType":"Issued"}],"language":null,"types":{"schemaOrg":"CreativeWork","resourceTypeGeneral":"Preprint","citeproc":"article","bibtex":"misc","ris":"GEN","resourceType":"Article"},"relatedIdentifiers":[],"relatedItems":[],"sizes":[],"formats":[],"version":"1","rightsList":[{"rightsUri":"http://arxiv.org/licenses/nonexclusive-distrib/1.0/","rights":"arXiv.org perpetual, non-exclusive license"}],"descriptions":[{"descriptionType":"Abstract","description":"Variational quantum circuits (VQCs) constitute a central building block of near-term quantum machine learning (QML), yet the principled design of expressive and trainable architectures remains a major open challenge. The VQC design space grows combinatorially with the number of qubits, layers, entanglement structures, and gate parameterizations, rendering manual circuit construction inefficient and often suboptimal. We introduce an autonomous agent-based framework for VQC architecture search that integrates high-level reasoning with a quantum simulation environment. The agent proposes candidate circuit architectures, evaluates them through fully automated training and validation pipelines, and iteratively improves its design strategy via performance-driven feedback. Empirically, we show that the agent autonomously evolves circuit architectures from simple initial ansätze toward increasingly expressive designs, progressively trying to improve task performance. This demonstrates that agentic AI can effectively navigate and refine the VQC design landscape with minimal human intervention, providing a scalable methodology for automated quantum model development in the Noisy Intermediate-Scale Quantum (NISQ) regime."},{"descriptionType":"Other","description":"43 pages, 12 figures"}],"geoLocations":[],"fundingReferences":[],"url":"https://arxiv.org/abs/2602.19387","contentUrl":null,"metadataVersion":0,"schemaVersion":"http://datacite.org/schema/kernel-4","source":"mds","isActive":true,"state":"findable","reason":null,"viewCount":0,"downloadCount":0,"referenceCount":0,"citationCount":0,"partCount":0,"partOfCount":0,"versionCount":0,"versionOfCount":0,"created":"2026-02-25T14:58:18Z","registered":"2026-02-25T14:58:19Z","published":null,"updated":"2026-02-25T14:58:19Z"},"relationships":{"client":{"data":{"id":"arxiv.content","type":"clients"}}}},{"id":"10.48550/arxiv.2602.19386","type":"dois","attributes":{"doi":"10.48550/arxiv.2602.19386","identifiers":[{"identifier":"2602.19386","identifierType":"arXiv"}],"creators":[{"nameType":"Personal","givenName":"Mohamadamin","familyName":"Rajabinezhad","name":"Rajabinezhad, Mohamadamin","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Muratkhan","familyName":"Abdirash","name":"Abdirash, Muratkhan","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Xiaofan","familyName":"Cui","name":"Cui, Xiaofan","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Shan","familyName":"Zuo","name":"Zuo, Shan","affiliation":[],"nameIdentifiers":[]}],"titles":[{"title":"Decentralized Attack-Resilient CLF-Based Control of Nonlinear DC Microgrids under FDI Attacks"}],"publisher":"arXiv","container":{},"publicationYear":2026,"subjects":[{"subject":"Systems and Control (eess.SY)","lang":"en","subjectScheme":"arXiv"},{"subject":"FOS: Electrical engineering, electronic engineering, information engineering","subjectScheme":"Fields of Science and Technology (FOS)"},{"schemeUri":"http://www.oecd.org/science/inno/38235147.pdf","subject":"FOS: Electrical engineering, electronic engineering, information engineering","subjectScheme":"Fields of Science and Technology (FOS)"}],"contributors":[],"dates":[{"date":"2026-02-22T23:40:36Z","dateType":"Submitted","dateInformation":"v1"},{"date":"2026-02-24T02:02:24Z","dateType":"Updated","dateInformation":"v1"},{"date":"2026-02","dateType":"Available","dateInformation":"v1"},{"date":"2026","dateType":"Issued"}],"language":null,"types":{"schemaOrg":"CreativeWork","resourceTypeGeneral":"Preprint","citeproc":"article","bibtex":"misc","ris":"GEN","resourceType":"Article"},"relatedIdentifiers":[],"relatedItems":[],"sizes":[],"formats":[],"version":"1","rightsList":[{"rightsUri":"http://arxiv.org/licenses/nonexclusive-distrib/1.0/","rights":"arXiv.org perpetual, non-exclusive license"}],"descriptions":[{"descriptionType":"Abstract","description":"The growing deployment of nonlinear, converter interfaced distributed energy resources (DERs) in DC microgrids demands decentralized controllers that remain stable and resilient under a wide range of cyber-physical attacks and disturbances. Traditional droop or linearized control methods lack resilience and scalability, especially when the system operates in its nonlinear region or faces diverse false-data-injection (FDI) attacks on control inputs. In this work, we develop a Decentralized Attack-Resilient Control Lyapunov Function (AR-CLF) based Quadratic Program (QP) control framework for nonlinear DC microgrids that ensures large-signal stability in a fully decentralized manner. Built upon the port-Hamiltonian representation, the proposed controller dynamically compensates diverse attacks including exponentially unbounded control-input perturbations beyond the bounded-attack regime commonly assumed in existing methods, through an adaptive resilience term, without requiring global information. Simulations validate that the AR-CLF based QP controller achieves superior stability and resilience against unbounded attacks, paving the way for scalable, attack-resilient, and physically consistent control of next-generation DC microgrids."},{"descriptionType":"Other","description":"Accepted for presentation at IEEE PES General Meeting 2026. \\c{opyright} IEEE. Personal use permitted. Final version will appear in IEEE Xplore"}],"geoLocations":[],"fundingReferences":[],"url":"https://arxiv.org/abs/2602.19386","contentUrl":null,"metadataVersion":0,"schemaVersion":"http://datacite.org/schema/kernel-4","source":"mds","isActive":true,"state":"findable","reason":null,"viewCount":0,"downloadCount":0,"referenceCount":0,"citationCount":0,"partCount":0,"partOfCount":0,"versionCount":0,"versionOfCount":0,"created":"2026-02-25T14:58:16Z","registered":"2026-02-25T14:58:16Z","published":null,"updated":"2026-02-25T14:58:16Z"},"relationships":{"client":{"data":{"id":"arxiv.content","type":"clients"}}}},{"id":"10.48550/arxiv.2602.19384","type":"dois","attributes":{"doi":"10.48550/arxiv.2602.19384","identifiers":[{"identifier":"2602.19384","identifierType":"arXiv"}],"creators":[{"nameType":"Personal","givenName":"Brenda","familyName":"Prallon","name":"Prallon, Brenda","affiliation":[],"nameIdentifiers":[]}],"titles":[{"title":"How Robust are Robustness Checks?"}],"publisher":"arXiv","container":{},"publicationYear":2026,"subjects":[{"subject":"Econometrics (econ.EM)","lang":"en","subjectScheme":"arXiv"},{"subject":"FOS: Economics and business","subjectScheme":"Fields of Science and Technology (FOS)"},{"schemeUri":"http://www.oecd.org/science/inno/38235147.pdf","subject":"FOS: Economics and business","subjectScheme":"Fields of Science and Technology (FOS)"}],"contributors":[],"dates":[{"date":"2026-02-22T23:32:23Z","dateType":"Submitted","dateInformation":"v1"},{"date":"2026-02-24T02:02:21Z","dateType":"Updated","dateInformation":"v1"},{"date":"2026-02","dateType":"Available","dateInformation":"v1"},{"date":"2026","dateType":"Issued"}],"language":null,"types":{"schemaOrg":"CreativeWork","resourceTypeGeneral":"Preprint","citeproc":"article","bibtex":"misc","ris":"GEN","resourceType":"Article"},"relatedIdentifiers":[],"relatedItems":[],"sizes":[],"formats":[],"version":"1","rightsList":[{"rightsUri":"http://arxiv.org/licenses/nonexclusive-distrib/1.0/","rights":"arXiv.org perpetual, non-exclusive license"}],"descriptions":[{"descriptionType":"Abstract","description":"Robustness checks are routine in empirical work, but there is no standard statistical procedure to formally measure what one can learn from them. I propose a \"robustness radius\" measure to quantify the amount by which the robustness checks estimands differ from the main specification estimand. I do so by framing robustness checks as explicitly biased regressions, clarifying what exactly the estimands are when comparing multiple regressions with slightly different samples, and applying a test from the moment inequalities literature. The robustness radius is easily interpretable and adapts to sampling uncertainty and correlation across regressions. An application shows that, although assessing overall robustness is context-specific, the robustness radius guides those judgments and improves transparency."}],"geoLocations":[],"fundingReferences":[],"url":"https://arxiv.org/abs/2602.19384","contentUrl":null,"metadataVersion":0,"schemaVersion":"http://datacite.org/schema/kernel-4","source":"mds","isActive":true,"state":"findable","reason":null,"viewCount":0,"downloadCount":0,"referenceCount":0,"citationCount":0,"partCount":0,"partOfCount":0,"versionCount":0,"versionOfCount":0,"created":"2026-02-25T14:58:11Z","registered":"2026-02-25T14:58:12Z","published":null,"updated":"2026-02-25T14:58:12Z"},"relationships":{"client":{"data":{"id":"arxiv.content","type":"clients"}}}},{"id":"10.48550/arxiv.2602.19383","type":"dois","attributes":{"doi":"10.48550/arxiv.2602.19383","identifiers":[{"identifier":"2602.19383","identifierType":"arXiv"}],"creators":[{"nameType":"Personal","givenName":"Jens","familyName":"Dietrich","name":"Dietrich, Jens","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Behnaz","familyName":"Hassanshahi","name":"Hassanshahi, Behnaz","affiliation":[],"nameIdentifiers":[]}],"titles":[{"title":"On the Variability of Source Code in Maven Package Rebuilds"}],"publisher":"arXiv","container":{},"publicationYear":2026,"subjects":[{"subject":"Software Engineering (cs.SE)","lang":"en","subjectScheme":"arXiv"},{"subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"},{"schemeUri":"http://www.oecd.org/science/inno/38235147.pdf","subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"}],"contributors":[],"dates":[{"date":"2026-02-22T23:31:42Z","dateType":"Submitted","dateInformation":"v1"},{"date":"2026-02-24T02:02:19Z","dateType":"Updated","dateInformation":"v1"},{"date":"2026-02","dateType":"Available","dateInformation":"v1"},{"date":"2026","dateType":"Issued"}],"language":null,"types":{"schemaOrg":"CreativeWork","resourceTypeGeneral":"Preprint","citeproc":"article","bibtex":"misc","ris":"GEN","resourceType":"Article"},"relatedIdentifiers":[],"relatedItems":[],"sizes":[],"formats":[],"version":"1","rightsList":[{"rightsIdentifierScheme":"SPDX","rightsUri":"https://creativecommons.org/licenses/by/4.0/legalcode","schemeUri":"https://spdx.org/licenses/","rights":"Creative Commons Attribution 4.0 International","rightsIdentifier":"cc-by-4.0"}],"descriptions":[{"descriptionType":"Abstract","description":"Rebuilding packages from open source is a common practice to improve the security of software supply chains, and is now done at an industrial scale. The basic principle is to acquire the source code used to build a package published in a repository such as Maven Central (for Java), rebuild the package independently with hardened security, and publish it in some alternative repository. In this paper we test the assumption that the same source code is being used by those alternative builds. To study this, we compare the sources released with packages on Maven Central, with the sources associated with independently built packages from Google's Assured Open Source and Oracle's Build-from-Source projects. We study non-equivalent sources for alternative builds of 28 popular packages with 85 releases. We investigate the causes of non-equivalence, and find that the main cause is build extensions that generate code at build time, which are difficult to reproduce. We suggest strategies to address this issue."}],"geoLocations":[],"fundingReferences":[],"url":"https://arxiv.org/abs/2602.19383","contentUrl":null,"metadataVersion":0,"schemaVersion":"http://datacite.org/schema/kernel-4","source":"mds","isActive":true,"state":"findable","reason":null,"viewCount":0,"downloadCount":0,"referenceCount":0,"citationCount":0,"partCount":0,"partOfCount":0,"versionCount":0,"versionOfCount":0,"created":"2026-02-25T14:58:08Z","registered":"2026-02-25T14:58:09Z","published":null,"updated":"2026-02-25T14:58:09Z"},"relationships":{"client":{"data":{"id":"arxiv.content","type":"clients"}}}},{"id":"10.48550/arxiv.2602.19382","type":"dois","attributes":{"doi":"10.48550/arxiv.2602.19382","identifiers":[{"identifier":"2602.19382","identifierType":"arXiv"}],"creators":[{"nameType":"Personal","givenName":"Peter","familyName":"Dillery","name":"Dillery, Peter","affiliation":[],"nameIdentifiers":[]}],"titles":[{"title":"Moduli of $G$-bundles on rigid gerbes over affine curves"}],"publisher":"arXiv","container":{},"publicationYear":2026,"subjects":[{"subject":"Number Theory (math.NT)","lang":"en","subjectScheme":"arXiv"},{"subject":"Algebraic Geometry (math.AG)","lang":"en","subjectScheme":"arXiv"},{"subject":"Representation Theory (math.RT)","lang":"en","subjectScheme":"arXiv"},{"subject":"FOS: Mathematics","subjectScheme":"Fields of Science and Technology (FOS)"},{"schemeUri":"http://www.oecd.org/science/inno/38235147.pdf","subject":"FOS: Mathematics","subjectScheme":"Fields of Science and Technology (FOS)"},{"subject":"11E72, 11F70, 11S37","lang":"en","subjectScheme":"MSC"}],"contributors":[],"dates":[{"date":"2026-02-22T23:30:27Z","dateType":"Submitted","dateInformation":"v1"},{"date":"2026-02-24T02:02:18Z","dateType":"Updated","dateInformation":"v1"},{"date":"2026-02","dateType":"Available","dateInformation":"v1"},{"date":"2026","dateType":"Issued"}],"language":null,"types":{"schemaOrg":"CreativeWork","resourceTypeGeneral":"Preprint","citeproc":"article","bibtex":"misc","ris":"GEN","resourceType":"Article"},"relatedIdentifiers":[],"relatedItems":[],"sizes":[],"formats":[],"version":"1","rightsList":[{"rightsUri":"http://arxiv.org/licenses/nonexclusive-distrib/1.0/","rights":"arXiv.org perpetual, non-exclusive license"}],"descriptions":[{"descriptionType":"Abstract","description":"We geometrize the basic cohomology set $H^{1}(\\text{Kal}_{F}, G)_{\\text{basic}}$ for a global function field $F$. We do this by constructing a v-stack $\\text{Bun}_{G,F}^{e}$ which has localization maps to Fargues' analogous stack $\\text{Bun}_{G,F_{v}}^{e}$ for all places $v$ of $F$ and whose semistable locus is the disjoint union of $\\text{Bun}_{G_{b},F}$ for all $b \\in H^{1}(\\text{Kott}_{F} \\times_{F} \\text{Kal}_{F},G)_{\\text{basic}}$. We also prove a version of Tate-Nakayama duality for $H^{1}(\\text{Kott}_{F} \\times_{F} \\text{Kal}_{F},G)_{\\text{basic}}$, which lets us state a conjectural multiplicity formula for discrete automorphic representations of $G(\\mathbb{A}_{F})$ adapted to this new cohomology set."},{"descriptionType":"Other","description":"35 pages; comments welcome!"}],"geoLocations":[],"fundingReferences":[],"url":"https://arxiv.org/abs/2602.19382","contentUrl":null,"metadataVersion":0,"schemaVersion":"http://datacite.org/schema/kernel-4","source":"mds","isActive":true,"state":"findable","reason":null,"viewCount":0,"downloadCount":0,"referenceCount":0,"citationCount":0,"partCount":0,"partOfCount":0,"versionCount":0,"versionOfCount":0,"created":"2026-02-25T14:58:06Z","registered":"2026-02-25T14:58:07Z","published":null,"updated":"2026-02-25T14:58:07Z"},"relationships":{"client":{"data":{"id":"arxiv.content","type":"clients"}}}},{"id":"10.48550/arxiv.2602.19380","type":"dois","attributes":{"doi":"10.48550/arxiv.2602.19380","identifiers":[{"identifier":"2602.19380","identifierType":"arXiv"}],"creators":[{"nameType":"Personal","givenName":"Huayu","familyName":"Wang","name":"Wang, Huayu","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Bahaa","familyName":"Alattar","name":"Alattar, Bahaa","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Cheng-Yen","familyName":"Yang","name":"Yang, Cheng-Yen","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Hsiang-Wei","familyName":"Huang","name":"Huang, Hsiang-Wei","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Jung Heon","familyName":"Kim","name":"Kim, Jung Heon","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Linda","familyName":"Shapiro","name":"Shapiro, Linda","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Nathan","familyName":"White","name":"White, Nathan","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Jenq-Neng","familyName":"Hwang","name":"Hwang, Jenq-Neng","affiliation":[],"nameIdentifiers":[]}],"titles":[{"title":"Detector-in-the-Loop Tracking: Active Memory Rectification for Stable Glottic Opening Localization"}],"publisher":"arXiv","container":{},"publicationYear":2026,"subjects":[{"subject":"Computer Vision and Pattern Recognition (cs.CV)","lang":"en","subjectScheme":"arXiv"},{"subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"},{"schemeUri":"http://www.oecd.org/science/inno/38235147.pdf","subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"}],"contributors":[],"dates":[{"date":"2026-02-22T23:29:28Z","dateType":"Submitted","dateInformation":"v1"},{"date":"2026-02-24T02:02:16Z","dateType":"Updated","dateInformation":"v1"},{"date":"2026-02","dateType":"Available","dateInformation":"v1"},{"date":"2026","dateType":"Issued"}],"language":null,"types":{"schemaOrg":"CreativeWork","resourceTypeGeneral":"Preprint","citeproc":"article","bibtex":"misc","ris":"GEN","resourceType":"Article"},"relatedIdentifiers":[],"relatedItems":[],"sizes":[],"formats":[],"version":"1","rightsList":[{"rightsIdentifierScheme":"SPDX","rightsUri":"https://creativecommons.org/licenses/by/4.0/legalcode","schemeUri":"https://spdx.org/licenses/","rights":"Creative Commons Attribution 4.0 International","rightsIdentifier":"cc-by-4.0"}],"descriptions":[{"descriptionType":"Abstract","description":"Temporal stability in glottic opening localization remains challenging due to the complementary weaknesses of single-frame detectors and foundation-model trackers: the former lacks temporal context, while the latter suffers from memory drift. Specifically, in video laryngoscopy, rapid tissue deformation, occlusions, and visual ambiguities in emergency settings require a robust, temporally aware solution that can prevent progressive tracking errors. We propose Closed-Loop Memory Correction (CL-MC), a detector-in-the-loop framework that supervises Segment Anything Model 2(SAM2) through confidence-aligned state decisions and active memory rectification. High-confidence detections trigger semantic resets that overwrite corrupted tracker memory, effectively mitigating drift accumulation with a training-free foundation tracker in complex endoscopic scenes. On emergency intubation videos, CL-MC achieves state-of-the-art performance, significantly reducing drift and missing rate compared with the SAM2 variants and open loop based methods. Our results establish memory correction as a crucial component for reliable clinical video tracking. Our code will be available in https://github.com/huayuww/CL-MR."},{"descriptionType":"Other","description":"Accepted to Medical Imaging with Deep Learning (MIDL) 2026"}],"geoLocations":[],"fundingReferences":[],"url":"https://arxiv.org/abs/2602.19380","contentUrl":null,"metadataVersion":0,"schemaVersion":"http://datacite.org/schema/kernel-4","source":"mds","isActive":true,"state":"findable","reason":null,"viewCount":0,"downloadCount":0,"referenceCount":0,"citationCount":0,"partCount":0,"partOfCount":0,"versionCount":0,"versionOfCount":0,"created":"2026-02-25T14:58:01Z","registered":"2026-02-25T14:58:02Z","published":null,"updated":"2026-02-25T14:58:02Z"},"relationships":{"client":{"data":{"id":"arxiv.content","type":"clients"}}}},{"id":"10.48550/arxiv.2602.19379","type":"dois","attributes":{"doi":"10.48550/arxiv.2602.19379","identifiers":[{"identifier":"2602.19379","identifierType":"arXiv"}],"creators":[{"nameType":"Personal","givenName":"Matteo","familyName":"Nerini","name":"Nerini, Matteo","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Bruno","familyName":"Clerckx","name":"Clerckx, Bruno","affiliation":[],"nameIdentifiers":[]}],"titles":[{"title":"Physics-Compliant Modeling and Optimization of MIMO Systems Aided by Microwave Linear Analog Computers"}],"publisher":"arXiv","container":{},"publicationYear":2026,"subjects":[{"subject":"Information Theory (cs.IT)","lang":"en","subjectScheme":"arXiv"},{"subject":"Signal Processing (eess.SP)","lang":"en","subjectScheme":"arXiv"},{"subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"},{"schemeUri":"http://www.oecd.org/science/inno/38235147.pdf","subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"},{"subject":"FOS: Electrical engineering, electronic engineering, information engineering","subjectScheme":"Fields of Science and Technology (FOS)"},{"schemeUri":"http://www.oecd.org/science/inno/38235147.pdf","subject":"FOS: Electrical engineering, electronic engineering, information engineering","subjectScheme":"Fields of Science and Technology (FOS)"}],"contributors":[],"dates":[{"date":"2026-02-22T23:24:10Z","dateType":"Submitted","dateInformation":"v1"},{"date":"2026-02-24T02:02:13Z","dateType":"Updated","dateInformation":"v1"},{"date":"2026-02","dateType":"Available","dateInformation":"v1"},{"date":"2026","dateType":"Issued"}],"language":null,"types":{"schemaOrg":"CreativeWork","resourceTypeGeneral":"Preprint","citeproc":"article","bibtex":"misc","ris":"GEN","resourceType":"Article"},"relatedIdentifiers":[],"relatedItems":[],"sizes":[],"formats":[],"version":"1","rightsList":[{"rightsIdentifierScheme":"SPDX","rightsUri":"https://creativecommons.org/licenses/by/4.0/legalcode","schemeUri":"https://spdx.org/licenses/","rights":"Creative Commons Attribution 4.0 International","rightsIdentifier":"cc-by-4.0"}],"descriptions":[{"descriptionType":"Abstract","description":"Microwave linear analog computer (MiLAC) has emerged as a promising architecture for implementing linear multiple-input multiple-output (MIMO) processing in the analog domain, with radio frequency (RF) signals. Existing studies on MiLAC-aided communications rely on idealized channel models and neglect antenna mutual coupling. However, since MiLAC performs processing at RF, mutual coupling becomes critical and alters the implemented operation, not only the channel characteristics. In this paper, we develop a physics-compliant model for MiLAC-aided MIMO systems accounting for mutual coupling with multiport network theory. We derive end-to-end system models for scenarios with MiLACs at the transmitter, the receiver, or both, showing how mutual coupling impacts the linear transformation implemented by the MiLACs. Furthermore, we formulate and solve a mutual coupling aware MiLAC optimization problem, deriving a closed-form globally optimal solution that maximizes the received signal power. We establish the fundamental performance limits of MiLAC with mutual coupling, and derive three analytical results. First, mutual coupling is beneficial in MiLAC-aided systems, on average. Second, with mutual coupling, MiLAC performs as digital architectures equipped with a matching network, while having fewer RF chains. Third, with mutual coupling, MiLAC always outperforms digital architectures with no matching network. Numerical simulations confirm our theoretical findings."},{"descriptionType":"Other","description":"Submitted to IEEE for publication"}],"geoLocations":[],"fundingReferences":[],"url":"https://arxiv.org/abs/2602.19379","contentUrl":null,"metadataVersion":0,"schemaVersion":"http://datacite.org/schema/kernel-4","source":"mds","isActive":true,"state":"findable","reason":null,"viewCount":0,"downloadCount":0,"referenceCount":0,"citationCount":0,"partCount":0,"partOfCount":0,"versionCount":0,"versionOfCount":0,"created":"2026-02-25T14:57:58Z","registered":"2026-02-25T14:57:59Z","published":null,"updated":"2026-02-25T14:57:59Z"},"relationships":{"client":{"data":{"id":"arxiv.content","type":"clients"}}}},{"id":"10.48550/arxiv.2602.19378","type":"dois","attributes":{"doi":"10.48550/arxiv.2602.19378","identifiers":[{"identifier":"2602.19378","identifierType":"arXiv"}],"creators":[{"nameType":"Personal","givenName":"Shuozhi","familyName":"Zuo","name":"Zuo, Shuozhi","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Yixin","familyName":"Wang","name":"Wang, Yixin","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Fan","familyName":"Yang","name":"Yang, Fan","affiliation":[],"nameIdentifiers":[]}],"titles":[{"title":"Identification and estimation of the conditional average treatment effect with nonignorable missing covariates, treatment, and outcome"}],"publisher":"arXiv","container":{},"publicationYear":2026,"subjects":[{"subject":"Methodology (stat.ME)","lang":"en","subjectScheme":"arXiv"},{"subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"},{"schemeUri":"http://www.oecd.org/science/inno/38235147.pdf","subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"}],"contributors":[],"dates":[{"date":"2026-02-22T23:20:31Z","dateType":"Submitted","dateInformation":"v1"},{"date":"2026-02-24T02:02:12Z","dateType":"Updated","dateInformation":"v1"},{"date":"2026-02","dateType":"Available","dateInformation":"v1"},{"date":"2026","dateType":"Issued"}],"language":null,"types":{"schemaOrg":"CreativeWork","resourceTypeGeneral":"Preprint","citeproc":"article","bibtex":"misc","ris":"GEN","resourceType":"Article"},"relatedIdentifiers":[],"relatedItems":[],"sizes":[],"formats":[],"version":"1","rightsList":[{"rightsIdentifierScheme":"SPDX","rightsUri":"https://creativecommons.org/licenses/by/4.0/legalcode","schemeUri":"https://spdx.org/licenses/","rights":"Creative Commons Attribution 4.0 International","rightsIdentifier":"cc-by-4.0"}],"descriptions":[{"descriptionType":"Abstract","description":"Treatment effect heterogeneity is central to policy evaluation, social science, and precision medicine, where interventions can affect individuals differently. In observational studies, covariates, treatment, and outcomes are often only partially observed. When missingness depends on unobserved values (missing not at random; MNAR), standard methods can yield biased estimates of the conditional average treatment effect (CATE). This paper establishes nonparametric identification of the CATE under multivariate MNAR mechanisms that allow covariates, treatment, and outcomes to be MNAR. It also develops nonparametric and parametric estimators and proposes a sensitivity analysis framework for assessing robustness to violations of the missingness assumptions."}],"geoLocations":[],"fundingReferences":[],"url":"https://arxiv.org/abs/2602.19378","contentUrl":null,"metadataVersion":0,"schemaVersion":"http://datacite.org/schema/kernel-4","source":"mds","isActive":true,"state":"findable","reason":null,"viewCount":0,"downloadCount":0,"referenceCount":0,"citationCount":0,"partCount":0,"partOfCount":0,"versionCount":0,"versionOfCount":0,"created":"2026-02-25T14:57:56Z","registered":"2026-02-25T14:57:57Z","published":null,"updated":"2026-02-25T14:57:57Z"},"relationships":{"client":{"data":{"id":"arxiv.content","type":"clients"}}}},{"id":"10.48550/arxiv.2602.19376","type":"dois","attributes":{"doi":"10.48550/arxiv.2602.19376","identifiers":[{"identifier":"2602.19376","identifierType":"arXiv"}],"creators":[{"nameType":"Personal","givenName":"Hanabusa","familyName":"Senga","name":"Senga, Hanabusa","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Yuto","familyName":"Watanabe","name":"Watanabe, Yuto","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Fubuki","familyName":"Iwase","name":"Iwase, Fubuki","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Ryo","familyName":"Masuda","name":"Masuda, Ryo","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Daichi","familyName":"Kawahara","name":"Kawahara, Daichi","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Toshiki","familyName":"Haruyama","name":"Haruyama, Toshiki","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Terukazu","familyName":"Nishizaki","name":"Nishizaki, Terukazu","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Yoshikazu","familyName":"Mizuguchi","name":"Mizuguchi, Yoshikazu","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Jiro","familyName":"Kitagawa","name":"Kitagawa, Jiro","affiliation":[],"nameIdentifiers":[]}],"titles":[{"title":"Insight into high-entropy effect in body-centered cubic superconducting alloys"}],"publisher":"arXiv","container":{},"publicationYear":2026,"subjects":[{"subject":"Superconductivity (cond-mat.supr-con)","lang":"en","subjectScheme":"arXiv"},{"subject":"FOS: Physical sciences","subjectScheme":"Fields of Science and Technology (FOS)"},{"schemeUri":"http://www.oecd.org/science/inno/38235147.pdf","subject":"FOS: Physical sciences","subjectScheme":"Fields of Science and Technology (FOS)"}],"contributors":[],"dates":[{"date":"2026-02-22T23:09:04Z","dateType":"Submitted","dateInformation":"v1"},{"date":"2026-02-24T02:02:05Z","dateType":"Updated","dateInformation":"v1"},{"date":"2026-02","dateType":"Available","dateInformation":"v1"},{"date":"2026","dateType":"Issued"}],"language":null,"types":{"schemaOrg":"CreativeWork","resourceTypeGeneral":"Preprint","citeproc":"article","bibtex":"misc","ris":"GEN","resourceType":"Article"},"relatedIdentifiers":[{"relationType":"IsVersionOf","relatedIdentifier":"10.1088/1361-6668/ae37e4","relatedIdentifierType":"DOI"}],"relatedItems":[],"sizes":[],"formats":[],"version":"1","rightsList":[{"rightsIdentifierScheme":"SPDX","rightsUri":"https://creativecommons.org/licenses/by/4.0/legalcode","schemeUri":"https://spdx.org/licenses/","rights":"Creative Commons Attribution 4.0 International","rightsIdentifier":"cc-by-4.0"}],"descriptions":[{"descriptionType":"Abstract","description":"We have characterized the superconducting critical temperature ($T_\\mathrm{c}$), the Debye temperature ($θ_\\mathrm{D}$), the electronic specific heat coefficient, and the Vickers microhardness of HfNbTiVZr, NbTiZr, HfNbTi, HfNbZr, and HfNbTa, all possessing a body-centered cubic (bcc) structure. By compiling a comparable dataset for other equiatomic quinary bcc high-entropy alloy (HEA) superconductors, we have examined the validity of the hypothesis regarding the high-entropy effect in bcc HEA superconductors, as proposed in our previous work. This hypothesis attributes the observed negative correlation between the electron-phonon coupling constant ($λ_\\mathrm{e-p}$) and $θ_\\mathrm{D}$ to a reduced phonon lifetime at higher $θ_\\mathrm{D}$, arising from the uncertainty principle in highly disordered quinary alloys. However, a pronounced change in this negative correlation is not evident in equiatomic ternary alloys with a lower degree of atomic disorder, thereby providing limited support for the hypothesis. Alternatively, by assembling the full dataset of bcc alloys spanning binary through senary systems, we have identified a universal negative correlation between $λ_\\mathrm{e-p}$ and $θ_{D}$. This result would be useful for the materials design of bcc superconducting alloys. We further propose that the Vickers microhardness offers an alternative means to evaluate $θ_{D}$ and may serve as a rapid screening metric for identifying bcc alloys with desired properties."}],"geoLocations":[],"fundingReferences":[],"url":"https://arxiv.org/abs/2602.19376","contentUrl":null,"metadataVersion":0,"schemaVersion":"http://datacite.org/schema/kernel-4","source":"mds","isActive":true,"state":"findable","reason":null,"viewCount":0,"downloadCount":0,"referenceCount":0,"citationCount":0,"partCount":0,"partOfCount":0,"versionCount":0,"versionOfCount":1,"created":"2026-02-25T14:57:51Z","registered":"2026-02-25T14:57:51Z","published":null,"updated":"2026-02-25T14:57:51Z"},"relationships":{"client":{"data":{"id":"arxiv.content","type":"clients"}}}},{"id":"10.48550/arxiv.2602.19374","type":"dois","attributes":{"doi":"10.48550/arxiv.2602.19374","identifiers":[{"identifier":"2602.19374","identifierType":"arXiv"}],"creators":[{"nameType":"Personal","givenName":"Jacek","familyName":"Jendrej","name":"Jendrej, Jacek","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Tony","familyName":"Salvi","name":"Salvi, Tony","affiliation":[],"nameIdentifiers":[]}],"titles":[{"title":"High-order long-time asymptotics for small solutions to the one-dimensional nonlinear Schrödinger equation"}],"publisher":"arXiv","container":{},"publicationYear":2026,"subjects":[{"subject":"Analysis of PDEs (math.AP)","lang":"en","subjectScheme":"arXiv"},{"subject":"Quantum Physics (quant-ph)","lang":"en","subjectScheme":"arXiv"},{"subject":"FOS: Mathematics","subjectScheme":"Fields of Science and Technology (FOS)"},{"schemeUri":"http://www.oecd.org/science/inno/38235147.pdf","subject":"FOS: Mathematics","subjectScheme":"Fields of Science and Technology (FOS)"},{"subject":"FOS: Physical sciences","subjectScheme":"Fields of Science and Technology (FOS)"},{"schemeUri":"http://www.oecd.org/science/inno/38235147.pdf","subject":"FOS: Physical sciences","subjectScheme":"Fields of Science and Technology (FOS)"}],"contributors":[],"dates":[{"date":"2026-02-22T22:59:23Z","dateType":"Submitted","dateInformation":"v1"},{"date":"2026-02-24T02:01:52Z","dateType":"Updated","dateInformation":"v1"},{"date":"2026-02","dateType":"Available","dateInformation":"v1"},{"date":"2026","dateType":"Issued"}],"language":null,"types":{"schemaOrg":"CreativeWork","resourceTypeGeneral":"Preprint","citeproc":"article","bibtex":"misc","ris":"GEN","resourceType":"Article"},"relatedIdentifiers":[],"relatedItems":[],"sizes":[],"formats":[],"version":"1","rightsList":[{"rightsIdentifierScheme":"SPDX","rightsUri":"https://creativecommons.org/licenses/by/4.0/legalcode","schemeUri":"https://spdx.org/licenses/","rights":"Creative Commons Attribution 4.0 International","rightsIdentifier":"cc-by-4.0"}],"descriptions":[{"descriptionType":"Abstract","description":"We investigate the global well-posedness and modified scattering for the one-dimensional Schrödinger equation with gauge-invariant polynomial nonlinearity. For small localized initial data of finite energy in a low-regularity class, we establish global existence of solution together with persistence of the localization of the associated profile. We further provide a rigorous derivation of the asymptotic expansion at arbitrary order of such solutions, taking into account long-range effects induced by the cubic component of the nonlinearity. Our analysis relies on the space-time resonance method."}],"geoLocations":[],"fundingReferences":[],"url":"https://arxiv.org/abs/2602.19374","contentUrl":null,"metadataVersion":0,"schemaVersion":"http://datacite.org/schema/kernel-4","source":"mds","isActive":true,"state":"findable","reason":null,"viewCount":0,"downloadCount":0,"referenceCount":0,"citationCount":0,"partCount":0,"partOfCount":0,"versionCount":0,"versionOfCount":0,"created":"2026-02-25T14:57:46Z","registered":"2026-02-25T14:57:46Z","published":null,"updated":"2026-02-25T14:57:46Z"},"relationships":{"client":{"data":{"id":"arxiv.content","type":"clients"}}}},{"id":"10.48550/arxiv.2602.19372","type":"dois","attributes":{"doi":"10.48550/arxiv.2602.19372","identifiers":[{"identifier":"2602.19372","identifierType":"arXiv"}],"creators":[{"nameType":"Personal","givenName":"Yanting","familyName":"Yang","name":"Yang, Yanting","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Shenyuan","familyName":"Gao","name":"Gao, Shenyuan","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Qingwen","familyName":"Bu","name":"Bu, Qingwen","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Li","familyName":"Chen","name":"Chen, Li","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Dimitris N.","familyName":"Metaxas","name":"Metaxas, Dimitris N.","affiliation":[],"nameIdentifiers":[]}],"titles":[{"title":"Seeing Farther and Smarter: Value-Guided Multi-Path Reflection for VLM Policy Optimization"}],"publisher":"arXiv","container":{},"publicationYear":2026,"subjects":[{"subject":"Robotics (cs.RO)","lang":"en","subjectScheme":"arXiv"},{"subject":"Computer Vision and Pattern Recognition (cs.CV)","lang":"en","subjectScheme":"arXiv"},{"subject":"Machine Learning (cs.LG)","lang":"en","subjectScheme":"arXiv"},{"subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"},{"schemeUri":"http://www.oecd.org/science/inno/38235147.pdf","subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"}],"contributors":[],"dates":[{"date":"2026-02-22T22:53:16Z","dateType":"Submitted","dateInformation":"v1"},{"date":"2026-02-24T02:01:46Z","dateType":"Updated","dateInformation":"v1"},{"date":"2026-02","dateType":"Available","dateInformation":"v1"},{"date":"2026","dateType":"Issued"}],"language":null,"types":{"schemaOrg":"CreativeWork","resourceTypeGeneral":"Preprint","citeproc":"article","bibtex":"misc","ris":"GEN","resourceType":"Article"},"relatedIdentifiers":[],"relatedItems":[],"sizes":[],"formats":[],"version":"1","rightsList":[{"rightsUri":"http://arxiv.org/licenses/nonexclusive-distrib/1.0/","rights":"arXiv.org perpetual, non-exclusive license"}],"descriptions":[{"descriptionType":"Abstract","description":"Solving complex, long-horizon robotic manipulation tasks requires a deep understanding of physical interactions, reasoning about their long-term consequences, and precise high-level planning. Vision-Language Models (VLMs) offer a general perceive-reason-act framework for this goal. However, previous approaches using reflective planning to guide VLMs in correcting actions encounter significant limitations. These methods rely on inefficient and often inaccurate implicit learning of state-values from noisy foresight predictions, evaluate only a single greedy future, and suffer from substantial inference latency. To address these limitations, we propose a novel test-time computation framework that decouples state evaluation from action generation. This provides a more direct and fine-grained supervisory signal for robust decision-making. Our method explicitly models the advantage of an action plan, quantified by its reduction in distance to the goal, and uses a scalable critic to estimate. To address the stochastic nature of single-trajectory evaluation, we employ beam search to explore multiple future paths and aggregate them during decoding to model their expected long-term returns, leading to more robust action generation. Additionally, we introduce a lightweight, confidence-based trigger that allows for early exit when direct predictions are reliable, invoking reflection only when necessary. Extensive experiments on diverse, unseen multi-stage robotic manipulation tasks demonstrate a 24.6% improvement in success rate over state-of-the-art baselines, while significantly reducing inference time by 56.5%."},{"descriptionType":"Other","description":"ICRA 2026"}],"geoLocations":[],"fundingReferences":[],"url":"https://arxiv.org/abs/2602.19372","contentUrl":null,"metadataVersion":0,"schemaVersion":"http://datacite.org/schema/kernel-4","source":"mds","isActive":true,"state":"findable","reason":null,"viewCount":0,"downloadCount":0,"referenceCount":0,"citationCount":0,"partCount":0,"partOfCount":0,"versionCount":0,"versionOfCount":0,"created":"2026-02-25T14:57:41Z","registered":"2026-02-25T14:57:42Z","published":null,"updated":"2026-02-25T14:57:42Z"},"relationships":{"client":{"data":{"id":"arxiv.content","type":"clients"}}}},{"id":"10.48550/arxiv.2602.19371","type":"dois","attributes":{"doi":"10.48550/arxiv.2602.19371","identifiers":[{"identifier":"2602.19371","identifierType":"arXiv"}],"creators":[{"nameType":"Personal","givenName":"Issei","familyName":"Kubo","name":"Kubo, Issei","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Yuto","familyName":"Watanabe","name":"Watanabe, Yuto","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Shuma","familyName":"Kawashima","name":"Kawashima, Shuma","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Tomohiro","familyName":"Miyaji","name":"Miyaji, Tomohiro","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Yoshikazu","familyName":"Mizuguchi","name":"Mizuguchi, Yoshikazu","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Terukazu","familyName":"Nishizaki","name":"Nishizaki, Terukazu","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Jiro","familyName":"Kitagawa","name":"Kitagawa, Jiro","affiliation":[],"nameIdentifiers":[]}],"titles":[{"title":"Enhanced $T_\\mathrm{c}$ in eutectic high-entropy alloy superconductors Hf-Nb-Sc-Ti-Zr"}],"publisher":"arXiv","container":{},"publicationYear":2026,"subjects":[{"subject":"Superconductivity (cond-mat.supr-con)","lang":"en","subjectScheme":"arXiv"},{"subject":"FOS: Physical sciences","subjectScheme":"Fields of Science and Technology (FOS)"},{"schemeUri":"http://www.oecd.org/science/inno/38235147.pdf","subject":"FOS: Physical sciences","subjectScheme":"Fields of Science and Technology (FOS)"}],"contributors":[],"dates":[{"date":"2026-02-22T22:47:55Z","dateType":"Submitted","dateInformation":"v1"},{"date":"2026-02-24T02:01:44Z","dateType":"Updated","dateInformation":"v1"},{"date":"2026-02","dateType":"Available","dateInformation":"v1"},{"date":"2026","dateType":"Issued"}],"language":null,"types":{"schemaOrg":"CreativeWork","resourceTypeGeneral":"Preprint","citeproc":"article","bibtex":"misc","ris":"GEN","resourceType":"Article"},"relatedIdentifiers":[{"relationType":"IsVersionOf","relatedIdentifier":"10.1016/j.jallcom.2025.184531","relatedIdentifierType":"DOI"}],"relatedItems":[],"sizes":[],"formats":[],"version":"1","rightsList":[{"rightsIdentifierScheme":"SPDX","rightsUri":"https://creativecommons.org/licenses/by/4.0/legalcode","schemeUri":"https://spdx.org/licenses/","rights":"Creative Commons Attribution 4.0 International","rightsIdentifier":"cc-by-4.0"}],"descriptions":[{"descriptionType":"Abstract","description":"The present investigation into the superconducting properties of eutectic high-entropy alloy (HEA) Hf-Nb-Sc-Ti-Zr systems reveals an enhanced superconducting critical temperature ($T_\\mathrm{c}$) in body-centered cubic (bcc) phases compared to typical quinary bcc HEAs. In Hf$_{10}$Nb$_{25}$Sc$_{25}$Ti$_{20}$Zr$_{20}$, Hf$_{5}$Nb$_{45}$Sc$_{20}$Ti$_{15}$Zr$_{15}$, and Hf$_{5}$Nb$_{45}$Sc$_{10}$Ti$_{5}$Zr$_{35}$ systems, which span a broad range of valence electron concentration per atom, lattice strain and the presence of partial or absent eutectic phases are characteristic features at lower annealing temperatures. The eutectic regions expand rapidly following annealing at 600$^{\\circ}$C in all systems. The $T_\\mathrm{c}$ of each system increases markedly with rising annealing temperatures from 400$^{\\circ}$C to 600$^{\\circ}$C, reaching a maximum value of 9.93 K in the Hf$_{5}$Nb$_{45}$Sc$_{10}$Ti$_{5}$Zr$_{35}$ sample annealed at 800$^{\\circ}$C. Nearly all samples can be classified as strong-coupling superconductors. The sample annealed at 500$^{\\circ}$C in the Hf$_{5}$Nb$_{45}$Sc$_{10}$Ti$_{5}$Zr$_{35}$ system exhibits a critical current density ($J_\\mathrm{c}$) exceeding the practical threshold of 10$^{5}$ A/cm$^{2}$ up to approximately 4 T at 4.2 K and 6 T at 2 K. The elevated $J_\\mathrm{c}$ is attributed to significant lattice strain and phase instability. The underlying mechanism for the enhanced $T_\\mathrm{c}$ in Hf-Nb-Sc-Ti-Zr systems is examined through specific heat data analysis, suggesting that the expansion of the eutectic regions induced by thermal annealing plays a pivotal role."}],"geoLocations":[],"fundingReferences":[],"url":"https://arxiv.org/abs/2602.19371","contentUrl":null,"metadataVersion":0,"schemaVersion":"http://datacite.org/schema/kernel-4","source":"mds","isActive":true,"state":"findable","reason":null,"viewCount":0,"downloadCount":0,"referenceCount":0,"citationCount":0,"partCount":0,"partOfCount":0,"versionCount":0,"versionOfCount":1,"created":"2026-02-25T14:57:38Z","registered":"2026-02-25T14:57:39Z","published":null,"updated":"2026-02-25T14:57:39Z"},"relationships":{"client":{"data":{"id":"arxiv.content","type":"clients"}}}},{"id":"10.48550/arxiv.2602.19370","type":"dois","attributes":{"doi":"10.48550/arxiv.2602.19370","identifiers":[{"identifier":"2602.19370","identifierType":"arXiv"}],"creators":[{"nameType":"Personal","givenName":"Igor","familyName":"Mikolasek","name":"Mikolasek, Igor","affiliation":[],"nameIdentifiers":[]}],"titles":[{"title":"Reliability of stochastic capacity estimates"}],"publisher":"arXiv","container":{},"publicationYear":2026,"subjects":[{"subject":"Applications (stat.AP)","lang":"en","subjectScheme":"arXiv"},{"subject":"Methodology (stat.ME)","lang":"en","subjectScheme":"arXiv"},{"subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"},{"schemeUri":"http://www.oecd.org/science/inno/38235147.pdf","subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"}],"contributors":[],"dates":[{"date":"2026-02-22T22:44:02Z","dateType":"Submitted","dateInformation":"v1"},{"date":"2026-02-24T02:01:38Z","dateType":"Updated","dateInformation":"v1"},{"date":"2026-02","dateType":"Available","dateInformation":"v1"},{"date":"2026","dateType":"Issued"}],"language":null,"types":{"schemaOrg":"CreativeWork","resourceTypeGeneral":"Preprint","citeproc":"article","bibtex":"misc","ris":"GEN","resourceType":"Article"},"relatedIdentifiers":[],"relatedItems":[],"sizes":[],"formats":[],"version":"1","rightsList":[{"rightsUri":"http://arxiv.org/licenses/nonexclusive-distrib/1.0/","rights":"arXiv.org perpetual, non-exclusive license"}],"descriptions":[{"descriptionType":"Abstract","description":"Stochastic traffic capacity is used in traffic modelling and control for unidirectional sections of road infrastructure, although some of the estimation methods have recently proved flawed. However, even sound estimation methods require sufficient data. Because breakdowns are rare, the number of recorded breakdowns effectively determines sample size. This is especially relevant for temporary traffic infrastructure, but also for permanent bottlenecks (e.g., on- and off-ramps), where practitioners must know when estimates are reliable enough for control or design decisions. This paper studies this reliability along with the impact of censored data using synthetic data with a known capacity distribution. A corrected maximum-likelihood estimator is applied to varied samples. In total, 360 artificial measurements are created and used to estimate the capacity distribution, and the deviation from the pre-defined distribution is then quantified. Results indicate that at least 50 recorded breakdowns are necessary; 100-200 are the recommended minimum for temporary measurements. Beyond this, further improvements are marginal, with the expected average relative error below 5 %."},{"descriptionType":"Other","description":"9 pages, 3 figures, 3 tables, accepted for TRA 2026 conference"}],"geoLocations":[],"fundingReferences":[],"url":"https://arxiv.org/abs/2602.19370","contentUrl":null,"metadataVersion":0,"schemaVersion":"http://datacite.org/schema/kernel-4","source":"mds","isActive":true,"state":"findable","reason":null,"viewCount":0,"downloadCount":0,"referenceCount":0,"citationCount":0,"partCount":0,"partOfCount":0,"versionCount":0,"versionOfCount":0,"created":"2026-02-25T14:57:36Z","registered":"2026-02-25T14:57:37Z","published":null,"updated":"2026-02-25T14:57:37Z"},"relationships":{"client":{"data":{"id":"arxiv.content","type":"clients"}}}},{"id":"10.48550/arxiv.2602.19369","type":"dois","attributes":{"doi":"10.48550/arxiv.2602.19369","identifiers":[{"identifier":"2602.19369","identifierType":"arXiv"}],"creators":[{"nameType":"Personal","givenName":"Susovan","familyName":"Pal","name":"Pal, Susovan","affiliation":[],"nameIdentifiers":[]}],"titles":[{"title":"Construction of a Closed Hyperbolic Surface of Arbitrarily Small Eigenvalue of Prescribed Serial Number"}],"publisher":"arXiv","container":{},"publicationYear":2026,"subjects":[{"subject":"Geometric Topology (math.GT)","lang":"en","subjectScheme":"arXiv"},{"subject":"Differential Geometry (math.DG)","lang":"en","subjectScheme":"arXiv"},{"subject":"FOS: Mathematics","subjectScheme":"Fields of Science and Technology (FOS)"},{"schemeUri":"http://www.oecd.org/science/inno/38235147.pdf","subject":"FOS: Mathematics","subjectScheme":"Fields of Science and Technology (FOS)"}],"contributors":[],"dates":[{"date":"2026-02-22T22:42:23Z","dateType":"Submitted","dateInformation":"v1"},{"date":"2026-02-24T02:01:36Z","dateType":"Updated","dateInformation":"v1"},{"date":"2026-02","dateType":"Available","dateInformation":"v1"},{"date":"2026","dateType":"Issued"}],"language":null,"types":{"schemaOrg":"CreativeWork","resourceTypeGeneral":"Preprint","citeproc":"article","bibtex":"misc","ris":"GEN","resourceType":"Article"},"relatedIdentifiers":[],"relatedItems":[],"sizes":[],"formats":[],"version":"1","rightsList":[{"rightsIdentifierScheme":"SPDX","rightsUri":"https://creativecommons.org/licenses/by/4.0/legalcode","schemeUri":"https://spdx.org/licenses/","rights":"Creative Commons Attribution 4.0 International","rightsIdentifier":"cc-by-4.0"}],"descriptions":[{"descriptionType":"Abstract","description":"In this paper we construct, for given any small positive number $ε$ and given natural number $n$, and given any closed hyperbolic surface $M$, a closed hyperbolic covering surface $\\widetilde{M}$, such that its $n$-th eigenvalue is less than $ε$. An application of this result will also be discussed. The main result follows from the techniques used in B.Randol's paper in 1974 [Ran]. Here I give a new and geometric proof of the main result."}],"geoLocations":[],"fundingReferences":[],"url":"https://arxiv.org/abs/2602.19369","contentUrl":null,"metadataVersion":0,"schemaVersion":"http://datacite.org/schema/kernel-4","source":"mds","isActive":true,"state":"findable","reason":null,"viewCount":0,"downloadCount":0,"referenceCount":0,"citationCount":0,"partCount":0,"partOfCount":0,"versionCount":0,"versionOfCount":0,"created":"2026-02-25T14:57:33Z","registered":"2026-02-25T14:57:34Z","published":null,"updated":"2026-02-25T14:57:34Z"},"relationships":{"client":{"data":{"id":"arxiv.content","type":"clients"}}}},{"id":"10.48550/arxiv.2602.19367","type":"dois","attributes":{"doi":"10.48550/arxiv.2602.19367","identifiers":[{"identifier":"2602.19367","identifierType":"arXiv"}],"creators":[{"nameType":"Personal","givenName":"Pratham","familyName":"Yashwante","name":"Yashwante, Pratham","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Rose","familyName":"Yu","name":"Yu, Rose","affiliation":[],"nameIdentifiers":[]}],"titles":[{"title":"Time Series, Vision, and Language: Exploring the Limits of Alignment in Contrastive Representation Spaces"}],"publisher":"arXiv","container":{},"publicationYear":2026,"subjects":[{"subject":"Artificial Intelligence (cs.AI)","lang":"en","subjectScheme":"arXiv"},{"subject":"Computer Vision and Pattern Recognition (cs.CV)","lang":"en","subjectScheme":"arXiv"},{"subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"},{"schemeUri":"http://www.oecd.org/science/inno/38235147.pdf","subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"}],"contributors":[],"dates":[{"date":"2026-02-22T22:39:37Z","dateType":"Submitted","dateInformation":"v1"},{"date":"2026-02-24T02:01:33Z","dateType":"Updated","dateInformation":"v1"},{"date":"2026-02","dateType":"Available","dateInformation":"v1"},{"date":"2026","dateType":"Issued"}],"language":null,"types":{"schemaOrg":"CreativeWork","resourceTypeGeneral":"Preprint","citeproc":"article","bibtex":"misc","ris":"GEN","resourceType":"Article"},"relatedIdentifiers":[],"relatedItems":[],"sizes":[],"formats":[],"version":"1","rightsList":[{"rightsIdentifierScheme":"SPDX","rightsUri":"https://creativecommons.org/licenses/by/4.0/legalcode","schemeUri":"https://spdx.org/licenses/","rights":"Creative Commons Attribution 4.0 International","rightsIdentifier":"cc-by-4.0"}],"descriptions":[{"descriptionType":"Abstract","description":"The Platonic Representation Hypothesis posits that learned representations from models trained on different modalities converge to a shared latent structure of the world. However, this hypothesis has largely been examined in vision and language, and it remains unclear whether time series participate in such convergence. We first examine this in a trimodal setting and find that independently pretrained time series, vision, and language encoders exhibit near-orthogonal geometry in the absence of explicit coupling. We then apply post-hoc alignment by training projection heads over frozen encoders using contrastive learning, and analyze the resulting representations with respect to geometry, scaling behavior, and dependence on information density and input modality characteristics. Our investigation reveals that overall alignment in contrastive representation spaces improves with model size, but this alignment is asymmetric: time series align more strongly with visual representations than with text, and images can act as effective intermediaries between time series and language. We further see that richer textual descriptions improve alignment only up to a threshold; training on denser captions does not lead to further improvement. Analogous effects are observed for visual representations. Our findings shed light on considerations for building multimodal systems involving non-conventional data modalities beyond vision and language."},{"descriptionType":"Other","description":"24 Figures, 12 Tables"}],"geoLocations":[],"fundingReferences":[],"url":"https://arxiv.org/abs/2602.19367","contentUrl":null,"metadataVersion":0,"schemaVersion":"http://datacite.org/schema/kernel-4","source":"mds","isActive":true,"state":"findable","reason":null,"viewCount":0,"downloadCount":0,"referenceCount":0,"citationCount":0,"partCount":0,"partOfCount":0,"versionCount":0,"versionOfCount":0,"created":"2026-02-25T14:57:29Z","registered":"2026-02-25T14:57:29Z","published":null,"updated":"2026-02-25T14:57:29Z"},"relationships":{"client":{"data":{"id":"arxiv.content","type":"clients"}}}},{"id":"10.48550/arxiv.2602.19365","type":"dois","attributes":{"doi":"10.48550/arxiv.2602.19365","identifiers":[{"identifier":"2602.19365","identifierType":"arXiv"}],"creators":[{"nameType":"Personal","affiliation":["Macquarie University, Sydney, Australia"],"givenName":"Richard","familyName":"de Grijs","name":"de Grijs, Richard","nameIdentifiers":[]}],"titles":[{"title":"Dutch Colonial Time: Time Signals in Paramaribo and the Dutch Caribbean"}],"publisher":"arXiv","container":{},"publicationYear":2026,"subjects":[{"subject":"History and Philosophy of Physics (physics.hist-ph)","lang":"en","subjectScheme":"arXiv"},{"subject":"FOS: Physical sciences","subjectScheme":"Fields of Science and Technology (FOS)"},{"schemeUri":"http://www.oecd.org/science/inno/38235147.pdf","subject":"FOS: Physical sciences","subjectScheme":"Fields of Science and Technology (FOS)"}],"contributors":[],"dates":[{"date":"2026-02-22T22:20:51Z","dateType":"Submitted","dateInformation":"v1"},{"date":"2026-02-24T02:01:28Z","dateType":"Updated","dateInformation":"v1"},{"date":"2026-02","dateType":"Available","dateInformation":"v1"},{"date":"2026","dateType":"Issued"}],"language":null,"types":{"schemaOrg":"CreativeWork","resourceTypeGeneral":"Preprint","citeproc":"article","bibtex":"misc","ris":"GEN","resourceType":"Article"},"relatedIdentifiers":[],"relatedItems":[],"sizes":[],"formats":[],"version":"1","rightsList":[{"rightsUri":"http://arxiv.org/licenses/nonexclusive-distrib/1.0/","rights":"arXiv.org perpetual, non-exclusive license"}],"descriptions":[{"descriptionType":"Abstract","description":"In the nineteenth century, the Dutch established time signals in their Atlantic colonies to synchronise maritime navigation with European standards. In Paramaribo (Suriname), a sophisticated sequence of apparatus -- including time balls, noon guns, discs and flags -- operated from 1851 until World War I. Naval officers aboard guard ships used sextants equipped with artificial horizons to determine local noon, thus integrating the colony into the global Greenwich-based cartographic system. This infrastructure was not merely technical; it became a civic ritual, with the daily noon gun structuring urban life and becoming a point of political negotiation between naval commanders and the colonial governor. In contrast, the Dutch Caribbean islands employed simpler, pragmatic systems. Curaçao used a daily time flag, a cost-effective solution suited to its climate and harbour scale, while smaller islands like Aruba and St. Eustatius relied on occasional noon guns. This diversity reflected a decentralised colonial administration that adapted technologies to local conditions and budgets. The history of these time signals reveals a process of hybrid adaptation, not simply replication of European models. They were shaped by environmental challenges, fiscal constraints and local politics, functioning simultaneously as navigational aids and civic landmarks. Their eventual decline, owing to budgetary pressures and new technologies like wireless telegraphy, underscores the fragile and negotiated nature of colonial scientific infrastructures."},{"descriptionType":"Other","description":"14 pages, incl. 5 figures. Accepted for publication in the Journal of Astronomical History and Heritage (December 2026)"}],"geoLocations":[],"fundingReferences":[],"url":"https://arxiv.org/abs/2602.19365","contentUrl":null,"metadataVersion":0,"schemaVersion":"http://datacite.org/schema/kernel-4","source":"mds","isActive":true,"state":"findable","reason":null,"viewCount":0,"downloadCount":0,"referenceCount":0,"citationCount":0,"partCount":0,"partOfCount":0,"versionCount":0,"versionOfCount":0,"created":"2026-02-25T14:57:24Z","registered":"2026-02-25T14:57:24Z","published":null,"updated":"2026-02-25T14:57:24Z"},"relationships":{"client":{"data":{"id":"arxiv.content","type":"clients"}}}},{"id":"10.48550/arxiv.2602.19364","type":"dois","attributes":{"doi":"10.48550/arxiv.2602.19364","identifiers":[{"identifier":"2602.19364","identifierType":"arXiv"}],"creators":[{"nameType":"Personal","affiliation":["Macquarie University, Sydney, Australia"],"givenName":"Richard","familyName":"de Grijs","name":"de Grijs, Richard","nameIdentifiers":[]}],"titles":[{"title":"Marking Noon: The Time Balls and Time Flaps of the Netherlands"}],"publisher":"arXiv","container":{},"publicationYear":2026,"subjects":[{"subject":"History and Philosophy of Physics (physics.hist-ph)","lang":"en","subjectScheme":"arXiv"},{"subject":"FOS: Physical sciences","subjectScheme":"Fields of Science and Technology (FOS)"},{"schemeUri":"http://www.oecd.org/science/inno/38235147.pdf","subject":"FOS: Physical sciences","subjectScheme":"Fields of Science and Technology (FOS)"}],"contributors":[],"dates":[{"date":"2026-02-22T22:15:46Z","dateType":"Submitted","dateInformation":"v1"},{"date":"2026-02-24T02:01:17Z","dateType":"Updated","dateInformation":"v1"},{"date":"2026-02","dateType":"Available","dateInformation":"v1"},{"date":"2026","dateType":"Issued"}],"language":null,"types":{"schemaOrg":"CreativeWork","resourceTypeGeneral":"Preprint","citeproc":"article","bibtex":"misc","ris":"GEN","resourceType":"Article"},"relatedIdentifiers":[],"relatedItems":[],"sizes":[],"formats":[],"version":"1","rightsList":[{"rightsUri":"http://arxiv.org/licenses/nonexclusive-distrib/1.0/","rights":"arXiv.org perpetual, non-exclusive license"}],"descriptions":[{"descriptionType":"Abstract","description":"In the nineteenth century, the Netherlands quickly adopted the time ball -- a British innovation for maritime chronometer calibration -- in its main naval ports (Nieuwediep/Den Helder, Vlissingen, Hellevoetsluis) and commercial centres (Amsterdam, Rotterdam). A large sphere dropped from a mast at a fixed time, the device enabled ships to verify their chronometers against a standard, essential for accurate longitude determination and safe navigation. Its ready acceptance was eased by indigenous Dutch traditions. Rural communities had long used visual time signals like the sjouw on Terschelling island, a wicker ball raised on a mast to mark the lunch hour and milking time for farmers, and the lawei, a basket or sack used in the peat bogs of Friesland to regulate labourers' hours. The Dutch time-signal system was distinguished by its strong institutional backing from the country's Royal Navy, its Hydrographic Service and by professional astronomers. Among the latter, Frederik Kaiser was a pivotal figure, vehemently defending the system's accuracy and pioneering technical improvements. He successfully advocated for replacing the traditional falling ball with a system of rotating flaps, which provided a more instantaneous and reliable visual signal. Beyond their practical role, time signals became civic spectacles and symbols of Dutch scientific modernity and imperial reach. Their decline began with the electric telegraph and was finalised by wireless radio, which allowed ships to calibrate chronometers at sea."},{"descriptionType":"Other","description":"24 pages, incl. 15 figures. Accepted for publication in the Journal of Astronomical History and Heritage (December 2026)"}],"geoLocations":[],"fundingReferences":[],"url":"https://arxiv.org/abs/2602.19364","contentUrl":null,"metadataVersion":0,"schemaVersion":"http://datacite.org/schema/kernel-4","source":"mds","isActive":true,"state":"findable","reason":null,"viewCount":0,"downloadCount":0,"referenceCount":0,"citationCount":0,"partCount":0,"partOfCount":0,"versionCount":0,"versionOfCount":0,"created":"2026-02-25T14:57:21Z","registered":"2026-02-25T14:57:22Z","published":null,"updated":"2026-02-25T14:57:22Z"},"relationships":{"client":{"data":{"id":"arxiv.content","type":"clients"}}}},{"id":"10.48550/arxiv.2602.19361","type":"dois","attributes":{"doi":"10.48550/arxiv.2602.19361","identifiers":[{"identifier":"2602.19361","identifierType":"arXiv"}],"creators":[{"nameType":"Personal","givenName":"Florian","familyName":"Beyer","name":"Beyer, Florian","affiliation":[],"nameIdentifiers":[]}],"titles":[{"title":"The extremely-tilted fluid regime near asymptotically Kasner big bang singularities"}],"publisher":"arXiv","container":{},"publicationYear":2026,"subjects":[{"subject":"General Relativity and Quantum Cosmology (gr-qc)","lang":"en","subjectScheme":"arXiv"},{"subject":"Mathematical Physics (math-ph)","lang":"en","subjectScheme":"arXiv"},{"subject":"Analysis of PDEs (math.AP)","lang":"en","subjectScheme":"arXiv"},{"subject":"FOS: Physical sciences","subjectScheme":"Fields of Science and Technology (FOS)"},{"schemeUri":"http://www.oecd.org/science/inno/38235147.pdf","subject":"FOS: Physical sciences","subjectScheme":"Fields of Science and Technology (FOS)"},{"subject":"FOS: Mathematics","subjectScheme":"Fields of Science and Technology (FOS)"},{"schemeUri":"http://www.oecd.org/science/inno/38235147.pdf","subject":"FOS: Mathematics","subjectScheme":"Fields of Science and Technology (FOS)"}],"contributors":[],"dates":[{"date":"2026-02-22T22:12:19Z","dateType":"Submitted","dateInformation":"v1"},{"date":"2026-02-24T02:01:11Z","dateType":"Updated","dateInformation":"v1"},{"date":"2026-02","dateType":"Available","dateInformation":"v1"},{"date":"2026","dateType":"Issued"}],"language":null,"types":{"schemaOrg":"CreativeWork","resourceTypeGeneral":"Preprint","citeproc":"article","bibtex":"misc","ris":"GEN","resourceType":"Article"},"relatedIdentifiers":[],"relatedItems":[],"sizes":[],"formats":[],"version":"1","rightsList":[{"rightsUri":"http://arxiv.org/licenses/nonexclusive-distrib/1.0/","rights":"arXiv.org perpetual, non-exclusive license"}],"descriptions":[{"descriptionType":"Abstract","description":"In this paper, we solve the relativistic Euler equations with a linear barotropic equation of state on a large class of background spacetimes with Kasner big bang asymptotics. Building on previous work in the asymptotically non-tilted regime, which applies when the speed of sound of the fluid is large in comparison to the Kasner exponents, we now consider the asymptotically extremely-tilted regime when the speed of sound is small. We solve the Cauchy problem for the Euler equations towards the big bang singularity and prove, without any symmetry assumptions or smallness conditions on the Cauchy data, that the solutions exist globally in time provided the mean curvature of the initial hypersurface is sufficiently large. Finally, we prove that the solutions exhibit the asymptotics expected from standard heuristic arguments in this regime; in particular, fluid particles are driven towards the speed of light in the direction of the largest Kasner exponent as the big bang singularity is approached."},{"descriptionType":"Other","description":"39 pages"}],"geoLocations":[],"fundingReferences":[],"url":"https://arxiv.org/abs/2602.19361","contentUrl":null,"metadataVersion":0,"schemaVersion":"http://datacite.org/schema/kernel-4","source":"mds","isActive":true,"state":"findable","reason":null,"viewCount":0,"downloadCount":0,"referenceCount":0,"citationCount":0,"partCount":0,"partOfCount":0,"versionCount":0,"versionOfCount":0,"created":"2026-02-25T14:57:14Z","registered":"2026-02-25T14:57:14Z","published":null,"updated":"2026-02-25T14:57:14Z"},"relationships":{"client":{"data":{"id":"arxiv.content","type":"clients"}}}},{"id":"10.48550/arxiv.2602.19359","type":"dois","attributes":{"doi":"10.48550/arxiv.2602.19359","identifiers":[{"identifier":"2602.19359","identifierType":"arXiv"}],"creators":[{"nameType":"Personal","givenName":"Kevin","familyName":"Qiu","name":"Qiu, Kevin","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Yu","familyName":"Zhang","name":"Zhang, Yu","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Marek","familyName":"Cygan","name":"Cygan, Marek","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Josie","familyName":"Hughes","name":"Hughes, Josie","affiliation":[],"nameIdentifiers":[]}],"titles":[{"title":"Vid2Sid: Videos Can Help Close the Sim2Real Gap"}],"publisher":"arXiv","container":{},"publicationYear":2026,"subjects":[{"subject":"Robotics (cs.RO)","lang":"en","subjectScheme":"arXiv"},{"subject":"Machine Learning (cs.LG)","lang":"en","subjectScheme":"arXiv"},{"subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"},{"schemeUri":"http://www.oecd.org/science/inno/38235147.pdf","subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"}],"contributors":[],"dates":[{"date":"2026-02-22T22:08:16Z","dateType":"Submitted","dateInformation":"v1"},{"date":"2026-02-24T02:00:58Z","dateType":"Updated","dateInformation":"v1"},{"date":"2026-02","dateType":"Available","dateInformation":"v1"},{"date":"2026","dateType":"Issued"}],"language":null,"types":{"schemaOrg":"CreativeWork","resourceTypeGeneral":"Preprint","citeproc":"article","bibtex":"misc","ris":"GEN","resourceType":"Article"},"relatedIdentifiers":[],"relatedItems":[],"sizes":[],"formats":[],"version":"1","rightsList":[{"rightsIdentifierScheme":"SPDX","rightsUri":"https://creativecommons.org/licenses/by/4.0/legalcode","schemeUri":"https://spdx.org/licenses/","rights":"Creative Commons Attribution 4.0 International","rightsIdentifier":"cc-by-4.0"}],"descriptions":[{"descriptionType":"Abstract","description":"Calibrating a robot simulator's physics parameters (friction, damping, material stiffness) to match real hardware is often done by hand or with black-box optimizers that reduce error but cannot explain which physical discrepancies drive the error. When sensing is limited to external cameras, the problem is further compounded by perception noise and the absence of direct force or state measurements. We present Vid2Sid, a video-driven system identification pipeline that couples foundation-model perception with a VLM-in-the-loop optimizer that analyzes paired sim-real videos, diagnoses concrete mismatches, and proposes physics parameter updates with natural language rationales. We evaluate our approach on a tendon-actuated finger (rigid-body dynamics in MuJoCo) and a deformable continuum tentacle (soft-body dynamics in PyElastica). On sim2real holdout controls unseen during training, Vid2Sid achieves the best average rank across all settings, matching or exceeding black-box optimizers while uniquely providing interpretable reasoning at each iteration. Sim2sim validation confirms that Vid2Sid recovers ground-truth parameters most accurately (mean relative error under 13\\% vs. 28--98\\%), and ablation analysis reveals three calibration regimes. VLM-guided optimization excels when perception is clean and the simulator is expressive, while model-class limitations bound performance in more challenging settings."}],"geoLocations":[],"fundingReferences":[],"url":"https://arxiv.org/abs/2602.19359","contentUrl":null,"metadataVersion":0,"schemaVersion":"http://datacite.org/schema/kernel-4","source":"mds","isActive":true,"state":"findable","reason":null,"viewCount":0,"downloadCount":0,"referenceCount":0,"citationCount":0,"partCount":0,"partOfCount":0,"versionCount":0,"versionOfCount":0,"created":"2026-02-25T14:57:09Z","registered":"2026-02-25T14:57:10Z","published":null,"updated":"2026-02-25T14:57:10Z"},"relationships":{"client":{"data":{"id":"arxiv.content","type":"clients"}}}},{"id":"10.48550/arxiv.2602.19358","type":"dois","attributes":{"doi":"10.48550/arxiv.2602.19358","identifiers":[{"identifier":"2602.19358","identifierType":"arXiv"}],"creators":[{"nameType":"Personal","givenName":"Fangyi","familyName":"Chen","name":"Chen, Fangyi","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Yaojie","familyName":"Shen","name":"Shen, Yaojie","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Lu","familyName":"Xu","name":"Xu, Lu","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Ye","familyName":"Yuan","name":"Yuan, Ye","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Shu","familyName":"Zhang","name":"Zhang, Shu","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Yulei","familyName":"Niu","name":"Niu, Yulei","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Longyin","familyName":"Wen","name":"Wen, Longyin","affiliation":[],"nameIdentifiers":[]}],"titles":[{"title":"Referring Layer Decomposition"}],"publisher":"arXiv","container":{},"publicationYear":2026,"subjects":[{"subject":"Computer Vision and Pattern Recognition (cs.CV)","lang":"en","subjectScheme":"arXiv"},{"subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"},{"schemeUri":"http://www.oecd.org/science/inno/38235147.pdf","subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"}],"contributors":[],"dates":[{"date":"2026-02-22T22:05:17Z","dateType":"Submitted","dateInformation":"v1"},{"date":"2026-02-24T02:00:52Z","dateType":"Updated","dateInformation":"v1"},{"date":"2026-02","dateType":"Available","dateInformation":"v1"},{"date":"2026","dateType":"Issued"}],"language":null,"types":{"schemaOrg":"CreativeWork","resourceTypeGeneral":"Preprint","citeproc":"article","bibtex":"misc","ris":"GEN","resourceType":"Article"},"relatedIdentifiers":[],"relatedItems":[],"sizes":[],"formats":[],"version":"1","rightsList":[{"rightsIdentifierScheme":"SPDX","rightsUri":"https://creativecommons.org/licenses/by/4.0/legalcode","schemeUri":"https://spdx.org/licenses/","rights":"Creative Commons Attribution 4.0 International","rightsIdentifier":"cc-by-4.0"}],"descriptions":[{"descriptionType":"Abstract","description":"Precise, object-aware control over visual content is essential for advanced image editing and compositional generation. Yet, most existing approaches operate on entire images holistically, limiting the ability to isolate and manipulate individual scene elements. In contrast, layered representations, where scenes are explicitly separated into objects, environmental context, and visual effects, provide a more intuitive and structured framework for interpreting and editing visual content. To bridge this gap and enable both compositional understanding and controllable editing, we introduce the Referring Layer Decomposition (RLD) task, which predicts complete RGBA layers from a single RGB image, conditioned on flexible user prompts, such as spatial inputs (e.g., points, boxes, masks), natural language descriptions, or combinations thereof. At the core is the RefLade, a large-scale dataset comprising 1.11M image-layer-prompt triplets produced by our scalable data engine, along with 100K manually curated, high-fidelity layers. Coupled with a perceptually grounded, human-preference-aligned automatic evaluation protocol, RefLade establishes RLD as a well-defined and benchmarkable research task. Building on this foundation, we present RefLayer, a simple baseline designed for prompt-conditioned layer decomposition, achieving high visual fidelity and semantic alignment. Extensive experiments show our approach enables effective training, reliable evaluation, and high-quality image decomposition, while exhibiting strong zero-shot generalization capabilities."},{"descriptionType":"Other","description":"ICLR 2026"}],"geoLocations":[],"fundingReferences":[],"url":"https://arxiv.org/abs/2602.19358","contentUrl":null,"metadataVersion":0,"schemaVersion":"http://datacite.org/schema/kernel-4","source":"mds","isActive":true,"state":"findable","reason":null,"viewCount":0,"downloadCount":0,"referenceCount":0,"citationCount":0,"partCount":0,"partOfCount":0,"versionCount":0,"versionOfCount":0,"created":"2026-02-25T14:57:07Z","registered":"2026-02-25T14:57:07Z","published":null,"updated":"2026-02-25T14:57:07Z"},"relationships":{"client":{"data":{"id":"arxiv.content","type":"clients"}}}},{"id":"10.48550/arxiv.2602.19357","type":"dois","attributes":{"doi":"10.48550/arxiv.2602.19357","identifiers":[{"identifier":"2602.19357","identifierType":"arXiv"}],"creators":[{"nameType":"Personal","givenName":"Nilay","familyName":"Yilmaz","name":"Yilmaz, Nilay","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Maitreya","familyName":"Patel","name":"Patel, Maitreya","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Naga Sai Abhiram","familyName":"Kusumba","name":"Kusumba, Naga Sai Abhiram","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Yixuan","familyName":"He","name":"He, Yixuan","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Yezhou","familyName":"Yang","name":"Yang, Yezhou","affiliation":[],"nameIdentifiers":[]}],"titles":[{"title":"MentalBlackboard: Evaluating Spatial Visualization via Mathematical Transformations"}],"publisher":"arXiv","container":{},"publicationYear":2026,"subjects":[{"subject":"Computer Vision and Pattern Recognition (cs.CV)","lang":"en","subjectScheme":"arXiv"},{"subject":"Machine Learning (cs.LG)","lang":"en","subjectScheme":"arXiv"},{"subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"},{"schemeUri":"http://www.oecd.org/science/inno/38235147.pdf","subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"}],"contributors":[],"dates":[{"date":"2026-02-22T22:05:11Z","dateType":"Submitted","dateInformation":"v1"},{"date":"2026-02-24T02:00:51Z","dateType":"Updated","dateInformation":"v1"},{"date":"2026-02","dateType":"Available","dateInformation":"v1"},{"date":"2026","dateType":"Issued"}],"language":null,"types":{"schemaOrg":"CreativeWork","resourceTypeGeneral":"Preprint","citeproc":"article","bibtex":"misc","ris":"GEN","resourceType":"Article"},"relatedIdentifiers":[],"relatedItems":[],"sizes":[],"formats":[],"version":"1","rightsList":[{"rightsIdentifierScheme":"SPDX","rightsUri":"https://creativecommons.org/licenses/by/4.0/legalcode","schemeUri":"https://spdx.org/licenses/","rights":"Creative Commons Attribution 4.0 International","rightsIdentifier":"cc-by-4.0"}],"descriptions":[{"descriptionType":"Abstract","description":"Spatial visualization is the mental ability to imagine, transform, and manipulate the spatial characteristics of objects and actions. This intelligence is a part of human cognition where actions and perception are connected on a mental level. To explore whether state-of-the-art Vision-Language Models (VLMs) exhibit this ability, we develop MentalBlackboard, an open-ended spatial visualization benchmark for Paper Folding and Hole Punching tests within two core tasks: prediction and planning. Our prediction experiments reveal that models struggle with applying symmetrical transformations, even when they predict the sequence of unfolding steps correctly. Also, rotations introduce a significant challenge to the physical situational awareness for models. The planning task reveals limitations of models in analyzing symmetrical relationships and in implementing the multi-stage symmetry process, with Claude Opus 4.1 achieving the highest planning score at an accuracy of 10\\%. The top-performing model, o3, attains a peak performance of 71.6\\% on the generalization task, which does not require spatial visualization but transfers spatial data; however, it achieves only 25\\% accuracy on text-based prediction tasks."}],"geoLocations":[],"fundingReferences":[],"url":"https://arxiv.org/abs/2602.19357","contentUrl":null,"metadataVersion":0,"schemaVersion":"http://datacite.org/schema/kernel-4","source":"mds","isActive":true,"state":"findable","reason":null,"viewCount":0,"downloadCount":0,"referenceCount":0,"citationCount":0,"partCount":0,"partOfCount":0,"versionCount":0,"versionOfCount":0,"created":"2026-02-25T14:57:04Z","registered":"2026-02-25T14:57:05Z","published":null,"updated":"2026-02-25T14:57:05Z"},"relationships":{"client":{"data":{"id":"arxiv.content","type":"clients"}}}},{"id":"10.48550/arxiv.2602.19356","type":"dois","attributes":{"doi":"10.48550/arxiv.2602.19356","identifiers":[{"identifier":"2602.19356","identifierType":"arXiv"}],"creators":[{"nameType":"Personal","givenName":"Dorothee","familyName":"Schaffner","name":"Schaffner, Dorothee","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Theo Juncker","familyName":"von Buchwald","name":"von Buchwald, Theo Juncker","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Jacob","familyName":"Pedersen","name":"Pedersen, Jacob","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Andreas","familyName":"Rasp","name":"Rasp, Andreas","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Emil","familyName":"Karaev","name":"Karaev, Emil","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Valentin","familyName":"von Laffert","name":"von Laffert, Valentin","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Alessio","familyName":"Bruno","name":"Bruno, Alessio","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Michele","familyName":"Alagia","name":"Alagia, Michele","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Stefano","familyName":"Stranges","name":"Stranges, Stefano","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Ingo","familyName":"Fischer","name":"Fischer, Ingo","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Sonia","familyName":"Coriani","name":"Coriani, Sonia","affiliation":[],"nameIdentifiers":[]}],"titles":[{"title":"The X-ray absorption spectrum of the propargyl radical, C$_3$H$_3^{\\cdot}$"}],"publisher":"arXiv","container":{},"publicationYear":2026,"subjects":[{"subject":"Chemical Physics (physics.chem-ph)","lang":"en","subjectScheme":"arXiv"},{"subject":"FOS: Physical sciences","subjectScheme":"Fields of Science and Technology (FOS)"},{"schemeUri":"http://www.oecd.org/science/inno/38235147.pdf","subject":"FOS: Physical sciences","subjectScheme":"Fields of Science and Technology (FOS)"}],"contributors":[],"dates":[{"date":"2026-02-22T22:05:09Z","dateType":"Submitted","dateInformation":"v1"},{"date":"2026-02-24T02:00:49Z","dateType":"Updated","dateInformation":"v1"},{"date":"2026-02","dateType":"Available","dateInformation":"v1"},{"date":"2026","dateType":"Issued"}],"language":null,"types":{"schemaOrg":"CreativeWork","resourceTypeGeneral":"Preprint","citeproc":"article","bibtex":"misc","ris":"GEN","resourceType":"Article"},"relatedIdentifiers":[],"relatedItems":[],"sizes":[],"formats":[],"version":"1","rightsList":[{"rightsUri":"http://arxiv.org/licenses/nonexclusive-distrib/1.0/","rights":"arXiv.org perpetual, non-exclusive license"}],"descriptions":[{"descriptionType":"Abstract","description":"We report a combined experimental and computational study of the near-edge X-ray absorption fine structure (NEXAFS) spectrum of the propargyl radical, C$_3$H$_3^{\\cdot}$. As a central intermediate in the formation of polycyclic aromatic hydrocarbons, the propargyl radical is a species of considerable relevance in combustion and astrochemistry and was here generated by pyrolysis from propargyl bromide. The NEXAFS spectrum shows a pronounced band at 282.2 eV corresponding to transitions from carbon 1s orbitals to singly occupied molecular orbitals. Ab initio calculations show that two transitions to the lowest lying states 1 $^2$A$_1$ and 2 $^2$A$_1$, which take place from the C1s orbital of the two terminal carbon atoms, contribute to this band. In addition, a 420 meV spacing of the first band is visible and is assigned to a vibrational progression in the symmetric CH$_2$ stretch. Transitions at higher energies are also described reasonably well by theory. The fragmentation pattern was investigated at the different resonant transitions and shows the cleavage of one as well as both C--C bonds."}],"geoLocations":[],"fundingReferences":[],"url":"https://arxiv.org/abs/2602.19356","contentUrl":null,"metadataVersion":0,"schemaVersion":"http://datacite.org/schema/kernel-4","source":"mds","isActive":true,"state":"findable","reason":null,"viewCount":0,"downloadCount":0,"referenceCount":0,"citationCount":0,"partCount":0,"partOfCount":0,"versionCount":0,"versionOfCount":0,"created":"2026-02-25T14:57:02Z","registered":"2026-02-25T14:57:02Z","published":null,"updated":"2026-02-25T14:57:02Z"},"relationships":{"client":{"data":{"id":"arxiv.content","type":"clients"}}}},{"id":"10.48550/arxiv.2602.19355","type":"dois","attributes":{"doi":"10.48550/arxiv.2602.19355","identifiers":[{"identifier":"2602.19355","identifierType":"arXiv"}],"creators":[{"nameType":"Personal","givenName":"David","familyName":"Rawlinson","name":"Rawlinson, David","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Gideon","familyName":"Kowadlo","name":"Kowadlo, Gideon","affiliation":[],"nameIdentifiers":[]}],"titles":[{"title":"Active perception and disentangled representations allow continual, episodic zero and few-shot learning"}],"publisher":"arXiv","container":{},"publicationYear":2026,"subjects":[{"subject":"Machine Learning (cs.LG)","lang":"en","subjectScheme":"arXiv"},{"subject":"Artificial Intelligence (cs.AI)","lang":"en","subjectScheme":"arXiv"},{"subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"},{"schemeUri":"http://www.oecd.org/science/inno/38235147.pdf","subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"},{"subject":"I.2.6; I.2.4; F.1.1; I.2.8","lang":"en","subjectScheme":"ACM"},{"subject":"68Q05 68T05 90C40 68T30 92C20","lang":"en","subjectScheme":"MSC"}],"contributors":[],"dates":[{"date":"2026-02-22T22:05:02Z","dateType":"Submitted","dateInformation":"v1"},{"date":"2026-02-24T02:00:48Z","dateType":"Updated","dateInformation":"v1"},{"date":"2026-02","dateType":"Available","dateInformation":"v1"},{"date":"2026","dateType":"Issued"}],"language":null,"types":{"schemaOrg":"CreativeWork","resourceTypeGeneral":"Preprint","citeproc":"article","bibtex":"misc","ris":"GEN","resourceType":"Article"},"relatedIdentifiers":[],"relatedItems":[],"sizes":[],"formats":[],"version":"1","rightsList":[{"rightsIdentifierScheme":"SPDX","rightsUri":"https://creativecommons.org/licenses/by/4.0/legalcode","schemeUri":"https://spdx.org/licenses/","rights":"Creative Commons Attribution 4.0 International","rightsIdentifier":"cc-by-4.0"}],"descriptions":[{"descriptionType":"Abstract","description":"Generalization is often regarded as an essential property of machine learning systems. However, perhaps not every component of a system needs to generalize. Training models for generalization typically produces entangled representations at the boundaries of entities or classes, which can lead to destructive interference when rapid, high-magnitude updates are required for continual or few-shot learning. Techniques for fast learning with non-interfering representations exist, but they generally fail to generalize. Here, we describe a Complementary Learning System (CLS) in which the fast learner entirely foregoes generalization in exchange for continual zero-shot and few-shot learning. Unlike most CLS approaches, which use episodic memory primarily for replay and consolidation, our fast, disentangled learner operates as a parallel reasoning system. The fast learner can overcome observation variability and uncertainty by leveraging a conventional slow, statistical learner within an active perception system: A contextual bias provided by the fast learner induces the slow learner to encode novel stimuli in familiar, generalized terms, enabling zero-shot and few-shot learning. This architecture demonstrates that fast, context-driven reasoning can coexist with slow, structured generalization, providing a pathway for robust continual learning."},{"descriptionType":"Other","description":"17 pages; 7 figures"}],"geoLocations":[],"fundingReferences":[],"url":"https://arxiv.org/abs/2602.19355","contentUrl":null,"metadataVersion":0,"schemaVersion":"http://datacite.org/schema/kernel-4","source":"mds","isActive":true,"state":"findable","reason":null,"viewCount":0,"downloadCount":0,"referenceCount":0,"citationCount":0,"partCount":0,"partOfCount":0,"versionCount":0,"versionOfCount":0,"created":"2026-02-25T14:56:59Z","registered":"2026-02-25T14:57:00Z","published":null,"updated":"2026-02-25T14:57:00Z"},"relationships":{"client":{"data":{"id":"arxiv.content","type":"clients"}}}},{"id":"10.48550/arxiv.2602.19354","type":"dois","attributes":{"doi":"10.48550/arxiv.2602.19354","identifiers":[{"identifier":"2602.19354","identifierType":"arXiv"}],"creators":[{"nameType":"Personal","givenName":"Eun Jeong","familyName":"Kang","name":"Kang, Eun Jeong","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Fengyang","familyName":"Lin","name":"Lin, Fengyang","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Angel Hsing-Chi","familyName":"Hwang","name":"Hwang, Angel Hsing-Chi","affiliation":[],"nameIdentifiers":[]}],"titles":[{"title":"Policy or Community?: Supporting Individual Model Creators' Open Model Development in Model Marketplaces"}],"publisher":"arXiv","container":{},"publicationYear":2026,"subjects":[{"subject":"Human-Computer Interaction (cs.HC)","lang":"en","subjectScheme":"arXiv"},{"subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"},{"schemeUri":"http://www.oecd.org/science/inno/38235147.pdf","subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"}],"contributors":[],"dates":[{"date":"2026-02-22T22:02:56Z","dateType":"Submitted","dateInformation":"v1"},{"date":"2026-02-24T02:00:45Z","dateType":"Updated","dateInformation":"v1"},{"date":"2026-02","dateType":"Available","dateInformation":"v1"},{"date":"2026","dateType":"Issued"}],"language":null,"types":{"schemaOrg":"CreativeWork","resourceTypeGeneral":"Preprint","citeproc":"article","bibtex":"misc","ris":"GEN","resourceType":"Article"},"relatedIdentifiers":[],"relatedItems":[],"sizes":[],"formats":[],"version":"1","rightsList":[{"rightsIdentifierScheme":"SPDX","rightsUri":"https://creativecommons.org/licenses/by-nc-nd/4.0/legalcode","schemeUri":"https://spdx.org/licenses/","rights":"Creative Commons Attribution Non Commercial No Derivatives 4.0 International","rightsIdentifier":"cc-by-nc-nd-4.0"}],"descriptions":[{"descriptionType":"Abstract","description":"Lightweight fine-tuning techniques and the rise of 'open' AI model marketplaces have enabled individuals to easily build and release generative models. Yet, this accessibility also raises risks, including the production of harmful and infringing content. While platforms offer policies and responsible AI tools, their effectiveness may be limited, as creators engage with partially open models that vary widely in openness and transparency. To understand how platform governance can better support responsible practices, we conducted semi-structured interviews with 19 individual model creators. We identified three regulatory needs shaped by creators' workflows: reducing downstream harms, recognizing creators' contributions and originality, and securing model ownership. Creators also repurpose RAI tools primarily for self-protection and visibility, and their sense of responsibility is deeply shaped by community norms rather than formal policies. We argue that platforms' governance decisions must consider how policy interventions shape the practices and motivations of individual creators."}],"geoLocations":[],"fundingReferences":[],"url":"https://arxiv.org/abs/2602.19354","contentUrl":null,"metadataVersion":0,"schemaVersion":"http://datacite.org/schema/kernel-4","source":"mds","isActive":true,"state":"findable","reason":null,"viewCount":0,"downloadCount":0,"referenceCount":0,"citationCount":0,"partCount":0,"partOfCount":0,"versionCount":0,"versionOfCount":0,"created":"2026-02-25T14:56:57Z","registered":"2026-02-25T14:56:57Z","published":null,"updated":"2026-02-25T14:56:57Z"},"relationships":{"client":{"data":{"id":"arxiv.content","type":"clients"}}}},{"id":"10.48550/arxiv.2602.19353","type":"dois","attributes":{"doi":"10.48550/arxiv.2602.19353","identifiers":[{"identifier":"2602.19353","identifierType":"arXiv"}],"creators":[{"nameType":"Personal","givenName":"Ian A.","familyName":"Cosden","name":"Cosden, Ian A.","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Elizabeth","familyName":"Holtz","name":"Holtz, Elizabeth","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Joel U.","familyName":"Bretheim","name":"Bretheim, Joel U.","affiliation":[],"nameIdentifiers":[]}],"titles":[{"title":"Designing and Implementing a Comprehensive Research Software Engineer Career Ladder: A Case Study from Princeton University"}],"publisher":"arXiv","container":{},"publicationYear":2026,"subjects":[{"subject":"Software Engineering (cs.SE)","lang":"en","subjectScheme":"arXiv"},{"subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"},{"schemeUri":"http://www.oecd.org/science/inno/38235147.pdf","subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"}],"contributors":[],"dates":[{"date":"2026-02-22T22:02:53Z","dateType":"Submitted","dateInformation":"v1"},{"date":"2026-02-24T02:00:44Z","dateType":"Updated","dateInformation":"v1"},{"date":"2026-02","dateType":"Available","dateInformation":"v1"},{"date":"2026","dateType":"Issued"}],"language":null,"types":{"schemaOrg":"CreativeWork","resourceTypeGeneral":"Preprint","citeproc":"article","bibtex":"misc","ris":"GEN","resourceType":"Article"},"relatedIdentifiers":[],"relatedItems":[],"sizes":[],"formats":[],"version":"1","rightsList":[{"rightsUri":"http://arxiv.org/licenses/nonexclusive-distrib/1.0/","rights":"arXiv.org perpetual, non-exclusive license"}],"descriptions":[{"descriptionType":"Abstract","description":"Research Software Engineers (RSEs) have become indispensable to computational research and scholarship. The fast rise of RSEs in higher education and the trend of universities to be slow creating or adopting models for new technology roles means a lack of structured career pathways that recognize technical mastery, scholarly impact, and leadership growth. In response to an immense demand for RSEs at Princeton University, and dedicated funding to grow the RSE group at least two-fold, Princeton was forced to strategize how to cohesively define job descriptions to match the rapid hiring of RSE positions but with enough flexibility to recognize the unique nature of each individual position. This case study describes our design and implementation of a comprehensive RSE career ladder spanning Associate through Principal levels, with parallel team-lead and managerial tracks. We outline the guiding principles, competency framework, Human Resources (HR) alignment, and implementation process, including engagement with external consultants and mapping to a standard job leveling framework utilizing market benchmarks. We share early lessons learned and outcomes including improved hiring efficiency, clearer promotion pathways, and positive reception among staff."},{"descriptionType":"Other","description":"Submitted to Future Generation Computer Systems: Special Issue on Research Software Engineering - Software-Enabled Discovery and Beyond"}],"geoLocations":[],"fundingReferences":[],"url":"https://arxiv.org/abs/2602.19353","contentUrl":null,"metadataVersion":0,"schemaVersion":"http://datacite.org/schema/kernel-4","source":"mds","isActive":true,"state":"findable","reason":null,"viewCount":0,"downloadCount":0,"referenceCount":0,"citationCount":0,"partCount":0,"partOfCount":0,"versionCount":0,"versionOfCount":0,"created":"2026-02-25T14:56:54Z","registered":"2026-02-25T14:56:55Z","published":null,"updated":"2026-02-25T14:56:55Z"},"relationships":{"client":{"data":{"id":"arxiv.content","type":"clients"}}}},{"id":"10.48550/arxiv.2602.19352","type":"dois","attributes":{"doi":"10.48550/arxiv.2602.19352","identifiers":[{"identifier":"2602.19352","identifierType":"arXiv"}],"creators":[{"nameType":"Personal","givenName":"Varun","familyName":"Shiri","name":"Shiri, Varun","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Charles","familyName":"Liu","name":"Liu, Charles","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Keyu","familyName":"Yao","name":"Yao, Keyu","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Jin L. C.","familyName":"Guo","name":"Guo, Jin L. C.","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Jinghui","familyName":"Cheng","name":"Cheng, Jinghui","affiliation":[],"nameIdentifiers":[]}],"titles":[{"title":"Beyond Privacy Labels: How Users Perceive Different Information Sources for Understanding App's Privacy Practices"}],"publisher":"arXiv","container":{},"publicationYear":2026,"subjects":[{"subject":"Human-Computer Interaction (cs.HC)","lang":"en","subjectScheme":"arXiv"},{"subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"},{"schemeUri":"http://www.oecd.org/science/inno/38235147.pdf","subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"}],"contributors":[],"dates":[{"date":"2026-02-22T22:02:23Z","dateType":"Submitted","dateInformation":"v1"},{"date":"2026-02-24T02:00:42Z","dateType":"Updated","dateInformation":"v1"},{"date":"2026-02","dateType":"Available","dateInformation":"v1"},{"date":"2026","dateType":"Issued"}],"language":null,"types":{"schemaOrg":"CreativeWork","resourceTypeGeneral":"Preprint","citeproc":"article","bibtex":"misc","ris":"GEN","resourceType":"Article"},"relatedIdentifiers":[{"relationType":"IsVersionOf","relatedIdentifier":"10.1145/3772363.3798787","relatedIdentifierType":"DOI"}],"relatedItems":[],"sizes":[],"formats":[],"version":"1","rightsList":[{"rightsIdentifierScheme":"SPDX","rightsUri":"https://creativecommons.org/licenses/by-nc-nd/4.0/legalcode","schemeUri":"https://spdx.org/licenses/","rights":"Creative Commons Attribution Non Commercial No Derivatives 4.0 International","rightsIdentifier":"cc-by-nc-nd-4.0"}],"descriptions":[{"descriptionType":"Abstract","description":"Despite having growing awareness and concerns about privacy, technology users are often insufficiently informed of the data practices of various digital products to protect themselves. Privacy policies and privacy labels, as two conventional ways of communicating data practices, are each criticized for important limitations -- one being lengthy and filled with legal jargon, and the other oversimplified and inaccurate -- causing users significant difficulty in understanding the privacy practices of the products and assessing their impact. To mitigate those issues, we explore ways to enhance privacy labels with the relevant content in complementary sources, including privacy policy, app reviews, and community-curated privacy assessments. Our user study results indicate that perceived usefulness and trust on those information sources are personal and influenced by past experience. Our work highlights the importance of considering various information needs for privacy practice and consolidating different sources for more useful privacy solutions."},{"descriptionType":"Other","description":"5 pages, 1 figure, CHI EA 2026"}],"geoLocations":[],"fundingReferences":[],"url":"https://arxiv.org/abs/2602.19352","contentUrl":null,"metadataVersion":0,"schemaVersion":"http://datacite.org/schema/kernel-4","source":"mds","isActive":true,"state":"findable","reason":null,"viewCount":0,"downloadCount":0,"referenceCount":0,"citationCount":0,"partCount":0,"partOfCount":0,"versionCount":0,"versionOfCount":1,"created":"2026-02-25T14:56:52Z","registered":"2026-02-25T14:56:53Z","published":null,"updated":"2026-02-25T14:56:53Z"},"relationships":{"client":{"data":{"id":"arxiv.content","type":"clients"}}}},{"id":"10.48550/arxiv.2602.19351","type":"dois","attributes":{"doi":"10.48550/arxiv.2602.19351","identifiers":[{"identifier":"2602.19351","identifierType":"arXiv"}],"creators":[{"nameType":"Personal","givenName":"Yufei","familyName":"Ai","name":"Ai, Yufei","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Yao","familyName":"Yu","name":"Yu, Yao","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Wenjing","familyName":"Pu","name":"Pu, Wenjing","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Lu","familyName":"Gao","name":"Gao, Lu","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Yihao","familyName":"Ren","name":"Ren, Yihao","affiliation":[],"nameIdentifiers":[]}],"titles":[{"title":"Network-Level Travel Time Prediction Considering The Effects of Weather and Seasonality"}],"publisher":"arXiv","container":{},"publicationYear":2026,"subjects":[{"subject":"Applications (stat.AP)","lang":"en","subjectScheme":"arXiv"},{"subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"},{"schemeUri":"http://www.oecd.org/science/inno/38235147.pdf","subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"}],"contributors":[],"dates":[{"date":"2026-02-22T21:59:30Z","dateType":"Submitted","dateInformation":"v1"},{"date":"2026-02-24T02:00:42Z","dateType":"Updated","dateInformation":"v1"},{"date":"2026-02","dateType":"Available","dateInformation":"v1"},{"date":"2026","dateType":"Issued"}],"language":null,"types":{"schemaOrg":"CreativeWork","resourceTypeGeneral":"Preprint","citeproc":"article","bibtex":"misc","ris":"GEN","resourceType":"Article"},"relatedIdentifiers":[],"relatedItems":[],"sizes":[],"formats":[],"version":"1","rightsList":[{"rightsIdentifierScheme":"SPDX","rightsUri":"https://creativecommons.org/licenses/by/4.0/legalcode","schemeUri":"https://spdx.org/licenses/","rights":"Creative Commons Attribution 4.0 International","rightsIdentifier":"cc-by-4.0"}],"descriptions":[{"descriptionType":"Abstract","description":"Accurately predicting travel time information can be helpful for travelers. This study proposes a framework for predicting network-level travel time index (TTI) using machine learning models. A case study was performed on more than 50,000 TTI data collected from the Washington DC area over 6 years. The proposed approach is also able to identify the effects of weather and seasonality. The performances of the machine learning models were assessed and compared with each other. It was shown that the ridge regression model outperformed the other models in both short-term and long-term predictions."}],"geoLocations":[],"fundingReferences":[],"url":"https://arxiv.org/abs/2602.19351","contentUrl":null,"metadataVersion":0,"schemaVersion":"http://datacite.org/schema/kernel-4","source":"mds","isActive":true,"state":"findable","reason":null,"viewCount":0,"downloadCount":0,"referenceCount":0,"citationCount":0,"partCount":0,"partOfCount":0,"versionCount":0,"versionOfCount":0,"created":"2026-02-25T14:56:49Z","registered":"2026-02-25T14:56:50Z","published":null,"updated":"2026-02-25T14:56:50Z"},"relationships":{"client":{"data":{"id":"arxiv.content","type":"clients"}}}},{"id":"10.48550/arxiv.2602.19350","type":"dois","attributes":{"doi":"10.48550/arxiv.2602.19350","identifiers":[{"identifier":"2602.19350","identifierType":"arXiv"}],"creators":[{"nameType":"Personal","givenName":"Zhilin","familyName":"Guo","name":"Guo, Zhilin","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Jing","familyName":"Yang","name":"Yang, Jing","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Kyle","familyName":"Fogarty","name":"Fogarty, Kyle","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Jingyi","familyName":"Wan","name":"Wan, Jingyi","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Boqiao","familyName":"Zhang","name":"Zhang, Boqiao","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Tianhao","familyName":"Wu","name":"Wu, Tianhao","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Weihao","familyName":"Xia","name":"Xia, Weihao","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Chenliang","familyName":"Zhou","name":"Zhou, Chenliang","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Sakar","familyName":"Khattar","name":"Khattar, Sakar","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Fangcheng","familyName":"Zhong","name":"Zhong, Fangcheng","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Cristina Nader","familyName":"Vasconcelos","name":"Vasconcelos, Cristina Nader","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Cengiz","familyName":"Oztireli","name":"Oztireli, Cengiz","affiliation":[],"nameIdentifiers":[]}],"titles":[{"title":"PoseCraft: Tokenized 3D Body Landmark and Camera Conditioning for Photorealistic Human Image Synthesis"}],"publisher":"arXiv","container":{},"publicationYear":2026,"subjects":[{"subject":"Computer Vision and Pattern Recognition (cs.CV)","lang":"en","subjectScheme":"arXiv"},{"subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"},{"schemeUri":"http://www.oecd.org/science/inno/38235147.pdf","subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"}],"contributors":[],"dates":[{"date":"2026-02-22T21:50:24Z","dateType":"Submitted","dateInformation":"v1"},{"date":"2026-02-24T02:00:35Z","dateType":"Updated","dateInformation":"v1"},{"date":"2026-02","dateType":"Available","dateInformation":"v1"},{"date":"2026","dateType":"Issued"}],"language":null,"types":{"schemaOrg":"CreativeWork","resourceTypeGeneral":"Preprint","citeproc":"article","bibtex":"misc","ris":"GEN","resourceType":"Article"},"relatedIdentifiers":[],"relatedItems":[],"sizes":[],"formats":[],"version":"1","rightsList":[{"rightsUri":"http://arxiv.org/licenses/nonexclusive-distrib/1.0/","rights":"arXiv.org perpetual, non-exclusive license"}],"descriptions":[{"descriptionType":"Abstract","description":"Digitizing humans and synthesizing photorealistic avatars with explicit 3D pose and camera controls are central to VR, telepresence, and entertainment. Existing skinning-based workflows require laborious manual rigging or template-based fittings, while neural volumetric methods rely on canonical templates and re-optimization for each unseen pose. We present PoseCraft, a diffusion framework built around tokenized 3D interface: instead of relying only on rasterized geometry as 2D control images, we encode sparse 3D landmarks and camera extrinsics as discrete conditioning tokens and inject them into diffusion via cross-attention. Our approach preserves 3D semantics by avoiding 2D re-projection ambiguity under large pose and viewpoint changes, and produces photorealistic imagery that faithfully captures identity and appearance. To train and evaluate at scale, we also implement GenHumanRF, a data generation workflow that renders diverse supervision from volumetric reconstructions. Our experiments show that PoseCraft achieves significant perceptual quality improvement over diffusion-centric methods, and attains better or comparable metrics to latest volumetric rendering SOTA while better preserving fabric and hair details."}],"geoLocations":[],"fundingReferences":[],"url":"https://arxiv.org/abs/2602.19350","contentUrl":null,"metadataVersion":0,"schemaVersion":"http://datacite.org/schema/kernel-4","source":"mds","isActive":true,"state":"findable","reason":null,"viewCount":0,"downloadCount":0,"referenceCount":0,"citationCount":0,"partCount":0,"partOfCount":0,"versionCount":0,"versionOfCount":0,"created":"2026-02-25T14:56:47Z","registered":"2026-02-25T14:56:48Z","published":null,"updated":"2026-02-25T14:56:48Z"},"relationships":{"client":{"data":{"id":"arxiv.content","type":"clients"}}}},{"id":"10.48550/arxiv.2602.19348","type":"dois","attributes":{"doi":"10.48550/arxiv.2602.19348","identifiers":[{"identifier":"2602.19348","identifierType":"arXiv"}],"creators":[{"nameType":"Personal","givenName":"Sirine","familyName":"Bhouri","name":"Bhouri, Sirine","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Lan","familyName":"Wei","name":"Wei, Lan","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Jian-Qing","familyName":"Zheng","name":"Zheng, Jian-Qing","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Dandan","familyName":"Zhang","name":"Zhang, Dandan","affiliation":[],"nameIdentifiers":[]}],"titles":[{"title":"MultiDiffSense: Diffusion-Based Multi-Modal Visuo-Tactile Image Generation Conditioned on Object Shape and Contact Pose"}],"publisher":"arXiv","container":{},"publicationYear":2026,"subjects":[{"subject":"Computer Vision and Pattern Recognition (cs.CV)","lang":"en","subjectScheme":"arXiv"},{"subject":"Artificial Intelligence (cs.AI)","lang":"en","subjectScheme":"arXiv"},{"subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"},{"schemeUri":"http://www.oecd.org/science/inno/38235147.pdf","subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"}],"contributors":[],"dates":[{"date":"2026-02-22T21:31:24Z","dateType":"Submitted","dateInformation":"v1"},{"date":"2026-02-24T02:00:12Z","dateType":"Updated","dateInformation":"v1"},{"date":"2026-02","dateType":"Available","dateInformation":"v1"},{"date":"2026","dateType":"Issued"}],"language":null,"types":{"schemaOrg":"CreativeWork","resourceTypeGeneral":"Preprint","citeproc":"article","bibtex":"misc","ris":"GEN","resourceType":"Article"},"relatedIdentifiers":[],"relatedItems":[],"sizes":[],"formats":[],"version":"1","rightsList":[{"rightsUri":"http://arxiv.org/licenses/nonexclusive-distrib/1.0/","rights":"arXiv.org perpetual, non-exclusive license"}],"descriptions":[{"descriptionType":"Abstract","description":"Acquiring aligned visuo-tactile datasets is slow and costly, requiring specialised hardware and large-scale data collection. Synthetic generation is promising, but prior methods are typically single-modality, limiting cross-modal learning. We present MultiDiffSense, a unified diffusion model that synthesises images for multiple vision-based tactile sensors (ViTac, TacTip, ViTacTip) within a single architecture. Our approach uses dual conditioning on CAD-derived, pose-aligned depth maps and structured prompts that encode sensor type and 4-DoF contact pose, enabling controllable, physically consistent multi-modal synthesis. Evaluating on 8 objects (5 seen, 3 novel) and unseen poses, MultiDiffSense outperforms a Pix2Pix cGAN baseline in SSIM by +36.3% (ViTac), +134.6% (ViTacTip), and +64.7% (TacTip). For downstream 3-DoF pose estimation, mixing 50% synthetic with 50% real halves the required real data while maintaining competitive performance. MultiDiffSense alleviates the data-collection bottleneck in tactile sensing and enables scalable, controllable multi-modal dataset generation for robotic applications."},{"descriptionType":"Other","description":"Accepted by 2026 ICRA"}],"geoLocations":[],"fundingReferences":[],"url":"https://arxiv.org/abs/2602.19348","contentUrl":null,"metadataVersion":0,"schemaVersion":"http://datacite.org/schema/kernel-4","source":"mds","isActive":true,"state":"findable","reason":null,"viewCount":0,"downloadCount":0,"referenceCount":0,"citationCount":0,"partCount":0,"partOfCount":0,"versionCount":0,"versionOfCount":0,"created":"2026-02-25T14:56:42Z","registered":"2026-02-25T14:56:43Z","published":null,"updated":"2026-02-25T14:56:43Z"},"relationships":{"client":{"data":{"id":"arxiv.content","type":"clients"}}}},{"id":"10.48550/arxiv.2602.19347","type":"dois","attributes":{"doi":"10.48550/arxiv.2602.19347","identifiers":[{"identifier":"2602.19347","identifierType":"arXiv"}],"creators":[{"nameType":"Personal","givenName":"Vít","familyName":"Jakubský","name":"Jakubský, Vít","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"B.","familyName":"Manjarrez-Montañez","name":"Manjarrez-Montañez, B.","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Rafael A.","familyName":"Méndez-Sánchez","name":"Méndez-Sánchez, Rafael A.","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Yonatan","familyName":"Betancur-Ocampo","name":"Betancur-Ocampo, Yonatan","affiliation":[],"nameIdentifiers":[]}],"titles":[{"title":"Dual energy-differentiated topological transition in artificial red phosphorus chains"}],"publisher":"arXiv","container":{},"publicationYear":2026,"subjects":[{"subject":"Materials Science (cond-mat.mtrl-sci)","lang":"en","subjectScheme":"arXiv"},{"subject":"FOS: Physical sciences","subjectScheme":"Fields of Science and Technology (FOS)"},{"schemeUri":"http://www.oecd.org/science/inno/38235147.pdf","subject":"FOS: Physical sciences","subjectScheme":"Fields of Science and Technology (FOS)"}],"contributors":[],"dates":[{"date":"2026-02-22T21:28:15Z","dateType":"Submitted","dateInformation":"v1"},{"date":"2026-02-24T02:00:07Z","dateType":"Updated","dateInformation":"v1"},{"date":"2026-02","dateType":"Available","dateInformation":"v1"},{"date":"2026","dateType":"Issued"}],"language":null,"types":{"schemaOrg":"CreativeWork","resourceTypeGeneral":"Preprint","citeproc":"article","bibtex":"misc","ris":"GEN","resourceType":"Article"},"relatedIdentifiers":[],"relatedItems":[],"sizes":[],"formats":[],"version":"1","rightsList":[{"rightsUri":"http://arxiv.org/licenses/nonexclusive-distrib/1.0/","rights":"arXiv.org perpetual, non-exclusive license"}],"descriptions":[{"descriptionType":"Abstract","description":"We investigate the spectral and transport properties of an atomic chain of red phosphorus. We reveal the separation of flat-band states from the rest of the system and calculate its energy bands analytically. The topological properties of the system are established through the evaluation of the Berry (Zak) phase of the energy bands, revealing nontrivial topology. The Berry phase depends on the relative strength of the hopping parameters and exhibits dual energy-dependent topological phase transitions. Remarkably, the emergence of inert band edges provides a direct spectral signature of these transitions, acting as energy-resolved indicators of the redistribution of topological charge between bands. The existence of the associated edge states is proved numerically for finite lattices. The theoretical predictions, particularly the band structure and the existence of edge states, are further confirmed by numerical simulations of red phosphorus through a phononic lattice in the form of a highly structured aluminum plate."},{"descriptionType":"Other","description":"9 pages, 10 figures"}],"geoLocations":[],"fundingReferences":[],"url":"https://arxiv.org/abs/2602.19347","contentUrl":null,"metadataVersion":0,"schemaVersion":"http://datacite.org/schema/kernel-4","source":"mds","isActive":true,"state":"findable","reason":null,"viewCount":0,"downloadCount":0,"referenceCount":0,"citationCount":0,"partCount":0,"partOfCount":0,"versionCount":0,"versionOfCount":0,"created":"2026-02-25T14:56:39Z","registered":"2026-02-25T14:56:40Z","published":null,"updated":"2026-02-25T14:56:40Z"},"relationships":{"client":{"data":{"id":"arxiv.content","type":"clients"}}}},{"id":"10.48550/arxiv.2602.19346","type":"dois","attributes":{"doi":"10.48550/arxiv.2602.19346","identifiers":[{"identifier":"2602.19346","identifierType":"arXiv"}],"creators":[{"nameType":"Personal","givenName":"Erik Garcia","familyName":"Oyono","name":"Oyono, Erik Garcia","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Jialin","familyName":"Lin","name":"Lin, Jialin","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Dandan","familyName":"Zhang","name":"Zhang, Dandan","affiliation":[],"nameIdentifiers":[]}],"titles":[{"title":"Design and Control of Modular Magnetic Millirobots for Multimodal Locomotion and Shape Reconfiguration"}],"publisher":"arXiv","container":{},"publicationYear":2026,"subjects":[{"subject":"Robotics (cs.RO)","lang":"en","subjectScheme":"arXiv"},{"subject":"Systems and Control (eess.SY)","lang":"en","subjectScheme":"arXiv"},{"subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"},{"schemeUri":"http://www.oecd.org/science/inno/38235147.pdf","subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"},{"subject":"FOS: Electrical engineering, electronic engineering, information engineering","subjectScheme":"Fields of Science and Technology (FOS)"},{"schemeUri":"http://www.oecd.org/science/inno/38235147.pdf","subject":"FOS: Electrical engineering, electronic engineering, information engineering","subjectScheme":"Fields of Science and Technology (FOS)"}],"contributors":[],"dates":[{"date":"2026-02-22T21:25:05Z","dateType":"Submitted","dateInformation":"v1"},{"date":"2026-02-24T02:00:03Z","dateType":"Updated","dateInformation":"v1"},{"date":"2026-02","dateType":"Available","dateInformation":"v1"},{"date":"2026","dateType":"Issued"}],"language":null,"types":{"schemaOrg":"CreativeWork","resourceTypeGeneral":"Preprint","citeproc":"article","bibtex":"misc","ris":"GEN","resourceType":"Article"},"relatedIdentifiers":[],"relatedItems":[],"sizes":[],"formats":[],"version":"1","rightsList":[{"rightsUri":"http://arxiv.org/licenses/nonexclusive-distrib/1.0/","rights":"arXiv.org perpetual, non-exclusive license"}],"descriptions":[{"descriptionType":"Abstract","description":"Modular small-scale robots offer the potential for on-demand assembly and disassembly, enabling task-specific adaptation in dynamic and constrained environments. However, existing modular magnetic platforms often depend on workspace collisions for reconfiguration, employ bulky three-dimensional electromagnetic systems, and lack robust single-module control, which limits their applicability in biomedical settings. In this work, we present a modular magnetic millirobotic platform comprising three cube-shaped modules with embedded permanent magnets, each designed for a distinct functional role: a free module that supports self-assembly and reconfiguration, a fixed module that enables flip-and-walk locomotion, and a gripper module for cargo manipulation. Locomotion and reconfiguration are actuated by programmable combinations of time-varying two-dimensional uniform and gradient magnetic field inputs. Experiments demonstrate closed-loop navigation using real-time vision feedback and A* path planning, establishing robust single-module control capabilities. Beyond locomotion, the system achieves self-assembly, multimodal transformations, and disassembly at low field strengths. Chain-to-gripper transformations succeeded in 90% of trials, while chain-to-square transformations were less consistent, underscoring the role of module geometry in reconfiguration reliability. These results establish a versatile modular robotic platform capable of multimodal behavior and robust control, suggesting a promising pathway toward scalable and adaptive task execution in confined environments."},{"descriptionType":"Other","description":"Accepted by 2026 ICRA"}],"geoLocations":[],"fundingReferences":[],"url":"https://arxiv.org/abs/2602.19346","contentUrl":null,"metadataVersion":0,"schemaVersion":"http://datacite.org/schema/kernel-4","source":"mds","isActive":true,"state":"findable","reason":null,"viewCount":0,"downloadCount":0,"referenceCount":0,"citationCount":0,"partCount":0,"partOfCount":0,"versionCount":0,"versionOfCount":0,"created":"2026-02-25T14:56:37Z","registered":"2026-02-25T14:56:38Z","published":null,"updated":"2026-02-25T14:56:38Z"},"relationships":{"client":{"data":{"id":"arxiv.content","type":"clients"}}}},{"id":"10.48550/arxiv.2602.19344","type":"dois","attributes":{"doi":"10.48550/arxiv.2602.19344","identifiers":[{"identifier":"2602.19344","identifierType":"arXiv"}],"creators":[{"nameType":"Personal","givenName":"Jiahui","familyName":"Huang","name":"Huang, Jiahui","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Matthew","familyName":"Satriano","name":"Satriano, Matthew","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Jeremy","familyName":"Usatine","name":"Usatine, Jeremy","affiliation":[],"nameIdentifiers":[]}],"titles":[{"title":"A cohomological interpretation for stringy Hodge numbers"}],"publisher":"arXiv","container":{},"publicationYear":2026,"subjects":[{"subject":"Algebraic Geometry (math.AG)","lang":"en","subjectScheme":"arXiv"},{"subject":"FOS: Mathematics","subjectScheme":"Fields of Science and Technology (FOS)"},{"schemeUri":"http://www.oecd.org/science/inno/38235147.pdf","subject":"FOS: Mathematics","subjectScheme":"Fields of Science and Technology (FOS)"}],"contributors":[],"dates":[{"date":"2026-02-22T21:17:14Z","dateType":"Submitted","dateInformation":"v1"},{"date":"2026-02-24T01:59:58Z","dateType":"Updated","dateInformation":"v1"},{"date":"2026-02","dateType":"Available","dateInformation":"v1"},{"date":"2026","dateType":"Issued"}],"language":null,"types":{"schemaOrg":"CreativeWork","resourceTypeGeneral":"Preprint","citeproc":"article","bibtex":"misc","ris":"GEN","resourceType":"Article"},"relatedIdentifiers":[],"relatedItems":[],"sizes":[],"formats":[],"version":"1","rightsList":[{"rightsUri":"http://arxiv.org/licenses/nonexclusive-distrib/1.0/","rights":"arXiv.org perpetual, non-exclusive license"}],"descriptions":[{"descriptionType":"Abstract","description":"We obtain a cohomological interpretation for Batyrev's stringy Hodge numbers in the full generality in which they are defined. In a previous paper, the second and third authors used motivic integration to define the stringy Hodge--Deligne invariant of a smooth Artin stack $\\mathcal{X}$ and proved that when $\\mathcal{X}$ is a crepant resolution of a variety $Y$ with log-terminal singularities, the generating function for the stringy Hodge numbers of $Y$ is equal to the stringy Hodge--Deligne invariant of $\\mathcal{X}$. In this paper, we introduce a cohomology theory $H_{\\mathrm{str}}^*(\\mathcal{X})$ that computes the stringy Hodge--Deligne invariant of $\\mathcal{X}$. Since, by previous work of the second and third authors, all varieties with log-terminal singularities admit a crepant resolution by an Artin stack, this gives a cohomological interpretation for stringy Hodge numbers of any variety with log-terminal singularities. We also show that in the special case where $\\mathcal{X}$ is Deligne--Mumford, $H_{\\mathrm{str}}^*(\\mathcal{X})$ coincides with the orbifold cohomology of $\\mathcal{X}$."}],"geoLocations":[],"fundingReferences":[],"url":"https://arxiv.org/abs/2602.19344","contentUrl":null,"metadataVersion":0,"schemaVersion":"http://datacite.org/schema/kernel-4","source":"mds","isActive":true,"state":"findable","reason":null,"viewCount":0,"downloadCount":0,"referenceCount":0,"citationCount":0,"partCount":0,"partOfCount":0,"versionCount":0,"versionOfCount":0,"created":"2026-02-25T14:56:32Z","registered":"2026-02-25T14:56:33Z","published":null,"updated":"2026-02-25T14:56:33Z"},"relationships":{"client":{"data":{"id":"arxiv.content","type":"clients"}}}},{"id":"10.48550/arxiv.2602.19342","type":"dois","attributes":{"doi":"10.48550/arxiv.2602.19342","identifiers":[{"identifier":"2602.19342","identifierType":"arXiv"}],"creators":[{"nameType":"Personal","givenName":"André","familyName":"Leroy","name":"Leroy, André","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Huda","familyName":"Merdach","name":"Merdach, Huda","affiliation":[],"nameIdentifiers":[]}],"titles":[{"title":"Structure and arithmetic of multivariate Ore extensions"}],"publisher":"arXiv","container":{},"publicationYear":2026,"subjects":[{"subject":"Rings and Algebras (math.RA)","lang":"en","subjectScheme":"arXiv"},{"subject":"FOS: Mathematics","subjectScheme":"Fields of Science and Technology (FOS)"},{"schemeUri":"http://www.oecd.org/science/inno/38235147.pdf","subject":"FOS: Mathematics","subjectScheme":"Fields of Science and Technology (FOS)"},{"subject":"15A04, 16S36, 16S20, 16U70, 17B20","lang":"en","subjectScheme":"MSC"}],"contributors":[],"dates":[{"date":"2026-02-22T21:06:58Z","dateType":"Submitted","dateInformation":"v1"},{"date":"2026-02-24T01:59:45Z","dateType":"Updated","dateInformation":"v1"},{"date":"2026-02","dateType":"Available","dateInformation":"v1"},{"date":"2026","dateType":"Issued"}],"language":null,"types":{"schemaOrg":"CreativeWork","resourceTypeGeneral":"Preprint","citeproc":"article","bibtex":"misc","ris":"GEN","resourceType":"Article"},"relatedIdentifiers":[{"relationType":"IsVersionOf","relatedIdentifier":"10.1080/00927872.2024.2387049","relatedIdentifierType":"DOI"}],"relatedItems":[],"sizes":[],"formats":[],"version":"1","rightsList":[{"rightsIdentifierScheme":"SPDX","rightsUri":"https://creativecommons.org/licenses/by/4.0/legalcode","schemeUri":"https://spdx.org/licenses/","rights":"Creative Commons Attribution 4.0 International","rightsIdentifier":"cc-by-4.0"}],"descriptions":[{"descriptionType":"Abstract","description":"We give the basic structure of the multivariable Ore extensions $S=A[\\underline{t} ; σ, \\underlineδ]$ introduced in the work of Martínez-Peñas and Kschischang. The Pseudo multilinear transformations (PMT's) are introduced and correspond to modules over $S$. These maps are strongly connected to the evaluation of polynomials in $S$. A general product formula is obtained. PMT's help to put some structure on the set of roots of a polynomial $f(t) \\in S$."},{"descriptionType":"Other","description":"20 pages"}],"geoLocations":[],"fundingReferences":[],"url":"https://arxiv.org/abs/2602.19342","contentUrl":null,"metadataVersion":0,"schemaVersion":"http://datacite.org/schema/kernel-4","source":"mds","isActive":true,"state":"findable","reason":null,"viewCount":0,"downloadCount":0,"referenceCount":0,"citationCount":0,"partCount":0,"partOfCount":0,"versionCount":0,"versionOfCount":1,"created":"2026-02-25T14:56:27Z","registered":"2026-02-25T14:56:28Z","published":null,"updated":"2026-02-25T14:56:28Z"},"relationships":{"client":{"data":{"id":"arxiv.content","type":"clients"}}}},{"id":"10.48550/arxiv.2602.19341","type":"dois","attributes":{"doi":"10.48550/arxiv.2602.19341","identifiers":[{"identifier":"2602.19341","identifierType":"arXiv"}],"creators":[{"nameType":"Personal","givenName":"Xinling","familyName":"Li","name":"Li, Xinling","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Gioele","familyName":"Zardini","name":"Zardini, Gioele","affiliation":[],"nameIdentifiers":[]}],"titles":[{"title":"Where Should Robotaxis Operate? Strategic Network Design for Autonomous Mobility-on-Demand"}],"publisher":"arXiv","container":{},"publicationYear":2026,"subjects":[{"subject":"Emerging Technologies (cs.ET)","lang":"en","subjectScheme":"arXiv"},{"subject":"Systems and Control (eess.SY)","lang":"en","subjectScheme":"arXiv"},{"subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"},{"schemeUri":"http://www.oecd.org/science/inno/38235147.pdf","subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"},{"subject":"FOS: Electrical engineering, electronic engineering, information engineering","subjectScheme":"Fields of Science and Technology (FOS)"},{"schemeUri":"http://www.oecd.org/science/inno/38235147.pdf","subject":"FOS: Electrical engineering, electronic engineering, information engineering","subjectScheme":"Fields of Science and Technology (FOS)"}],"contributors":[],"dates":[{"date":"2026-02-22T21:06:30Z","dateType":"Submitted","dateInformation":"v1"},{"date":"2026-02-24T01:59:43Z","dateType":"Updated","dateInformation":"v1"},{"date":"2026-02","dateType":"Available","dateInformation":"v1"},{"date":"2026","dateType":"Issued"}],"language":null,"types":{"schemaOrg":"CreativeWork","resourceTypeGeneral":"Preprint","citeproc":"article","bibtex":"misc","ris":"GEN","resourceType":"Article"},"relatedIdentifiers":[],"relatedItems":[],"sizes":[],"formats":[],"version":"1","rightsList":[{"rightsIdentifierScheme":"SPDX","rightsUri":"https://creativecommons.org/licenses/by/4.0/legalcode","schemeUri":"https://spdx.org/licenses/","rights":"Creative Commons Attribution 4.0 International","rightsIdentifier":"cc-by-4.0"}],"descriptions":[{"descriptionType":"Abstract","description":"The emergence of Autonomous Mobility-on-Demand (AMoD) services creates new opportunities to improve the efficiency and reliability of on-demand mobility systems. Unlike human-driven Mobility-on-Demand (MoD), AMoD enables fully centralized fleet control, but it also requires appropriate infrastructure, so that vehicles can operate safely only on a suitably instrumented subnetwork of the roads. Most existing AMoD research focuses on fleet control (matching, rebalancing, ridepooling) on a fixed road network and does not address the joint design of the service network and fleet capacity. In this paper, we formalize this strategic design problem as the Autonomous Mobility-on-Demand Network Design Problem (AMoD-NDP), in which an operator selects an operation subnetwork and routes all passengers, subject to infrastructure and fleet constraints and route-level quality-of-service requirements. We propose a path-based mixed-integer formulation of the AMoD-NDP and develop a column-generation-based algorithm that scales to city-sized networks. The master problem optimizes over a restricted set of paths, while the pricing problem reduces to an elementary shortest path with resource constraints, solved exactly by a tailored label-correcting algorithm. The method provides an explicit certificate of the optimality gap and extends naturally to a robust counterpart under box uncertainty in travel times and demand. Using real-world data from Manhattan, New York City, we show that the framework produces stable and interpretable operation subnetworks, quantifies trade-offs between infrastructure investment and fleet time, and accommodates additional path-level constraints, such as limits on left turns as a proxy for operational risk. These results illustrate how the proposed approach can support strategic planning and policy analysis for future AMoD deployments."}],"geoLocations":[],"fundingReferences":[],"url":"https://arxiv.org/abs/2602.19341","contentUrl":null,"metadataVersion":0,"schemaVersion":"http://datacite.org/schema/kernel-4","source":"mds","isActive":true,"state":"findable","reason":null,"viewCount":0,"downloadCount":0,"referenceCount":0,"citationCount":0,"partCount":0,"partOfCount":0,"versionCount":0,"versionOfCount":0,"created":"2026-02-25T14:56:25Z","registered":"2026-02-25T14:56:26Z","published":null,"updated":"2026-02-25T14:56:26Z"},"relationships":{"client":{"data":{"id":"arxiv.content","type":"clients"}}}},{"id":"10.48550/arxiv.2602.19339","type":"dois","attributes":{"doi":"10.48550/arxiv.2602.19339","identifiers":[{"identifier":"2602.19339","identifierType":"arXiv"}],"creators":[{"nameType":"Personal","givenName":"Anna","familyName":"Volodkevich","name":"Volodkevich, Anna","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Dmitry","familyName":"Anikin","name":"Anikin, Dmitry","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Danil","familyName":"Gusak","name":"Gusak, Danil","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Anton","familyName":"Klenitskiy","name":"Klenitskiy, Anton","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Evgeny","familyName":"Frolov","name":"Frolov, Evgeny","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Alexey","familyName":"Vasilev","name":"Vasilev, Alexey","affiliation":[],"nameIdentifiers":[]}],"titles":[{"title":"SplitLight: An Exploratory Toolkit for Recommender Systems Datasets and Splits"}],"publisher":"arXiv","container":{},"publicationYear":2026,"subjects":[{"subject":"Information Retrieval (cs.IR)","lang":"en","subjectScheme":"arXiv"},{"subject":"Machine Learning (cs.LG)","lang":"en","subjectScheme":"arXiv"},{"subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"},{"schemeUri":"http://www.oecd.org/science/inno/38235147.pdf","subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"}],"contributors":[],"dates":[{"date":"2026-02-22T21:02:32Z","dateType":"Submitted","dateInformation":"v1"},{"date":"2026-02-24T01:59:39Z","dateType":"Updated","dateInformation":"v1"},{"date":"2026-02","dateType":"Available","dateInformation":"v1"},{"date":"2026","dateType":"Issued"}],"language":null,"types":{"schemaOrg":"CreativeWork","resourceTypeGeneral":"Preprint","citeproc":"article","bibtex":"misc","ris":"GEN","resourceType":"Article"},"relatedIdentifiers":[],"relatedItems":[],"sizes":[],"formats":[],"version":"1","rightsList":[{"rightsIdentifierScheme":"SPDX","rightsUri":"https://creativecommons.org/licenses/by/4.0/legalcode","schemeUri":"https://spdx.org/licenses/","rights":"Creative Commons Attribution 4.0 International","rightsIdentifier":"cc-by-4.0"}],"descriptions":[{"descriptionType":"Abstract","description":"Offline evaluation of recommender systems is often affected by hidden, under-documented choices in data preparation. Seemingly minor decisions in filtering, handling repeats, cold-start treatment, and splitting strategy design can substantially reorder model rankings and undermine reproducibility and cross-paper comparability.\n In this paper, we introduce SplitLight, an open-source exploratory toolkit that enables researchers and practitioners designing preprocessing and splitting pipelines or reviewing external artifacts to make these decisions measurable, comparable, and reportable. Given an interaction log and derived split subsets, SplitLight analyzes core and temporal dataset statistics, characterizes repeat consumption patterns and timestamp anomalies, and diagnoses split validity, including temporal leakage, cold-user/item exposure, and distribution shifts. SplitLight further allows side-by-side comparison of alternative splitting strategies through comprehensive aggregated summaries and interactive visualizations. Delivered as both a Python toolkit and an interactive no-code interface, SplitLight produces audit summaries that justify evaluation protocols and support transparent, reliable, and comparable experimentation in recommender systems research and industry."}],"geoLocations":[],"fundingReferences":[],"url":"https://arxiv.org/abs/2602.19339","contentUrl":null,"metadataVersion":0,"schemaVersion":"http://datacite.org/schema/kernel-4","source":"mds","isActive":true,"state":"findable","reason":null,"viewCount":0,"downloadCount":0,"referenceCount":0,"citationCount":0,"partCount":0,"partOfCount":0,"versionCount":0,"versionOfCount":0,"created":"2026-02-25T14:56:20Z","registered":"2026-02-25T14:56:21Z","published":null,"updated":"2026-02-25T14:56:21Z"},"relationships":{"client":{"data":{"id":"arxiv.content","type":"clients"}}}},{"id":"10.48550/arxiv.2602.19338","type":"dois","attributes":{"doi":"10.48550/arxiv.2602.19338","identifiers":[{"identifier":"2602.19338","identifierType":"arXiv"}],"creators":[{"nameType":"Personal","givenName":"Halit","familyName":"Uyanık","name":"Uyanık, Halit","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Tolga","familyName":"Ovatman","name":"Ovatman, Tolga","affiliation":[],"nameIdentifiers":[]}],"titles":[{"title":"Complex Event Processing in the Edge: A Combined Optimization Approach for Data and Code Placement"}],"publisher":"arXiv","container":{},"publicationYear":2026,"subjects":[{"subject":"Distributed, Parallel, and Cluster Computing (cs.DC)","lang":"en","subjectScheme":"arXiv"},{"subject":"Software Engineering (cs.SE)","lang":"en","subjectScheme":"arXiv"},{"subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"},{"schemeUri":"http://www.oecd.org/science/inno/38235147.pdf","subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"},{"subject":"C.2.4; D.2.11","lang":"en","subjectScheme":"ACM"}],"contributors":[],"dates":[{"date":"2026-02-22T21:01:58Z","dateType":"Submitted","dateInformation":"v1"},{"date":"2026-02-24T01:59:38Z","dateType":"Updated","dateInformation":"v1"},{"date":"2026-02","dateType":"Available","dateInformation":"v1"},{"date":"2026","dateType":"Issued"}],"language":null,"types":{"schemaOrg":"CreativeWork","resourceTypeGeneral":"Preprint","citeproc":"article","bibtex":"misc","ris":"GEN","resourceType":"Article"},"relatedIdentifiers":[],"relatedItems":[],"sizes":[],"formats":[],"version":"1","rightsList":[{"rightsIdentifierScheme":"SPDX","rightsUri":"https://creativecommons.org/licenses/by-nc-nd/4.0/legalcode","schemeUri":"https://spdx.org/licenses/","rights":"Creative Commons Attribution Non Commercial No Derivatives 4.0 International","rightsIdentifier":"cc-by-nc-nd-4.0"}],"descriptions":[{"descriptionType":"Abstract","description":"The increasing variety of input data and complexity of tasks that are handled by the devices of internet of things (IoT) environments require solutions that consider the limited hardware and computation power of the edge devices. Complex event processing (CEP), can be given as an example, which involves reading and aggregating data from multiple sources to infer triggering of important events. In this study, we balance the execution costs between different paths of the CEP task graph with a constrained programming optimization approach and improve critical path performance. The proposed approach is implemented as a Python library, allowing small-scale IoT devices to adaptively optimize code and I/O assignments and improve overall latency and throughput. The implemented library abstracts away the communication details and allows virtualization of a shared memory between IoT devices. The results show that optimizing critical path performance increases throughput and reduces delay across multiple devices during CEP operations."}],"geoLocations":[],"fundingReferences":[],"url":"https://arxiv.org/abs/2602.19338","contentUrl":null,"metadataVersion":0,"schemaVersion":"http://datacite.org/schema/kernel-4","source":"mds","isActive":true,"state":"findable","reason":null,"viewCount":0,"downloadCount":0,"referenceCount":0,"citationCount":0,"partCount":0,"partOfCount":0,"versionCount":0,"versionOfCount":0,"created":"2026-02-25T14:56:17Z","registered":"2026-02-25T14:56:18Z","published":null,"updated":"2026-02-25T14:56:18Z"},"relationships":{"client":{"data":{"id":"arxiv.content","type":"clients"}}}},{"id":"10.48550/arxiv.2602.19337","type":"dois","attributes":{"doi":"10.48550/arxiv.2602.19337","identifiers":[{"identifier":"2602.19337","identifierType":"arXiv"}],"creators":[{"nameType":"Personal","givenName":"Javad","familyName":"Mashreghi","name":"Mashreghi, Javad","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Marek","familyName":"Ptak","name":"Ptak, Marek","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"William T.","familyName":"Ross","name":"Ross, William T.","affiliation":[],"nameIdentifiers":[]}],"titles":[{"title":"The conjugate orbit of a unitary operator"}],"publisher":"arXiv","container":{},"publicationYear":2026,"subjects":[{"subject":"Functional Analysis (math.FA)","lang":"en","subjectScheme":"arXiv"},{"subject":"FOS: Mathematics","subjectScheme":"Fields of Science and Technology (FOS)"},{"schemeUri":"http://www.oecd.org/science/inno/38235147.pdf","subject":"FOS: Mathematics","subjectScheme":"Fields of Science and Technology (FOS)"},{"subject":"47B35, 47B02, 47A05","lang":"en","subjectScheme":"MSC"}],"contributors":[],"dates":[{"date":"2026-02-22T20:58:11Z","dateType":"Submitted","dateInformation":"v1"},{"date":"2026-02-24T01:59:37Z","dateType":"Updated","dateInformation":"v1"},{"date":"2026-02","dateType":"Available","dateInformation":"v1"},{"date":"2026","dateType":"Issued"}],"language":null,"types":{"schemaOrg":"CreativeWork","resourceTypeGeneral":"Preprint","citeproc":"article","bibtex":"misc","ris":"GEN","resourceType":"Article"},"relatedIdentifiers":[],"relatedItems":[],"sizes":[],"formats":[],"version":"1","rightsList":[{"rightsIdentifierScheme":"SPDX","rightsUri":"https://creativecommons.org/licenses/by/4.0/legalcode","schemeUri":"https://spdx.org/licenses/","rights":"Creative Commons Attribution 4.0 International","rightsIdentifier":"cc-by-4.0"}],"descriptions":[{"descriptionType":"Abstract","description":"This paper discusses various aspects of the collection of unitary operators $CUC$, where $U$ is a fixed unitary operator on a complex Hilbert space $\\mathcal{H}$ and $C$ varies over the set of all conjugations on $\\mathcal{H}$ (antilinear, isometric, involutions). We call this class of unitary operators, the {\\em conjugate orbit }of $U$ and denote it by $\\mathfrak{O}_c(U)$. We will see that $U^{*}$, the Hilbert space adjoint of $U$, always belongs to $\\mathfrak{O}_c(U)$, while $U$ belongs to $\\mathfrak{O}_c(U)$ only when $U$ is unitarily equivalent to $U^{*}$, making $U$ a member of $\\mathfrak{O}_c(U)$ an uncommon event. We completely describe the conjugate orbit of the classical bilateral shift and discuss when a unitary multiplication operator on the classical Lebesgue space of the unit circle belongs to this conjugate orbit. We also broaden this discussion to include the bilateral shifts of higher multiplicity which, via unitary equivalence, makes connections to other interesting unitary operators such as the translation and dilation operators on the Lebesgue space of the real line. Finite unitary matrices provide us with a rich source of examples of conjugate unitary orbits to discuss. In particular, we determine which diagonal matrices, if any, belong to the conjugate orbit of a fixed unitary matrix. Closely related to the finite unitary matrices are the diagonalizable unitary operators with respect to some, possibly infinite, orthonormal basis. We give a large class of variations of these unitary operators that belong to the conjugate orbit and establish a connection to the classical Fourier--Plancherel and Hilbert transforms. Finally, we develop a model for a unitary operator using real Hilbert spaces and use it to describe the conjugate orbit as well as revisit some of our previous discussions in another light."},{"descriptionType":"Other","description":"69 pages"}],"geoLocations":[],"fundingReferences":[],"url":"https://arxiv.org/abs/2602.19337","contentUrl":null,"metadataVersion":0,"schemaVersion":"http://datacite.org/schema/kernel-4","source":"mds","isActive":true,"state":"findable","reason":null,"viewCount":0,"downloadCount":0,"referenceCount":0,"citationCount":0,"partCount":0,"partOfCount":0,"versionCount":0,"versionOfCount":0,"created":"2026-02-25T14:56:15Z","registered":"2026-02-25T14:56:16Z","published":null,"updated":"2026-02-25T14:56:16Z"},"relationships":{"client":{"data":{"id":"arxiv.content","type":"clients"}}}},{"id":"10.48550/arxiv.2602.19335","type":"dois","attributes":{"doi":"10.48550/arxiv.2602.19335","identifiers":[{"identifier":"2602.19335","identifierType":"arXiv"}],"creators":[{"nameType":"Personal","givenName":"Vishwangi","familyName":"Shah","name":"Shah, Vishwangi","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Jason W. T.","familyName":"Hessels","name":"Hessels, Jason W. T.","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Victoria M.","familyName":"Kaspi","name":"Kaspi, Victoria M.","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Kiyoshi W.","familyName":"Masui","name":"Masui, Kiyoshi W.","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Mawson W.","familyName":"Sammons","name":"Sammons, Mawson W.","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Daniel","familyName":"Amouyal","name":"Amouyal, Daniel","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Charanjot","familyName":"Brar","name":"Brar, Charanjot","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Shami","familyName":"Chatterjee","name":"Chatterjee, Shami","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Alice P.","familyName":"Curtin","name":"Curtin, Alice P.","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Hannah","familyName":"Didehbani","name":"Didehbani, Hannah","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"B. M.","familyName":"Gaensler","name":"Gaensler, B. M.","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Naman","familyName":"Jain","name":"Jain, Naman","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Ronniy C.","familyName":"Joseph","name":"Joseph, Ronniy C.","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Afrokk","familyName":"Khan","name":"Khan, Afrokk","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Bikash","familyName":"Kharel","name":"Kharel, Bikash","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Adam E.","familyName":"Lanman","name":"Lanman, Adam E.","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Kyle","familyName":"McGregor","name":"McGregor, Kyle","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Ryan","familyName":"Mckinven","name":"Mckinven, Ryan","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Mason","familyName":"Ng","name":"Ng, Mason","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Kenzie","familyName":"Nimmo","name":"Nimmo, Kenzie","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Ayush","familyName":"Pandhi","name":"Pandhi, Ayush","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Aaron B.","familyName":"Pearlman","name":"Pearlman, Aaron B.","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Alexander W.","familyName":"Pollak","name":"Pollak, Alexander W.","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Paul","familyName":"Scholz","name":"Scholz, Paul","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Kaitlyn","familyName":"Shin","name":"Shin, Kaitlyn","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Seth R.","familyName":"Siegel","name":"Siegel, Seth R.","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Kendrick","familyName":"Smith","name":"Smith, Kendrick","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Michele","familyName":"Woodland","name":"Woodland, Michele","affiliation":[],"nameIdentifiers":[]}],"titles":[{"title":"Probing the maximum energy of fast radio bursts using thousands of sources from the Second CHIME/FRB Catalog"}],"publisher":"arXiv","container":{},"publicationYear":2026,"subjects":[{"subject":"High Energy Astrophysical Phenomena (astro-ph.HE)","lang":"en","subjectScheme":"arXiv"},{"subject":"FOS: Physical sciences","subjectScheme":"Fields of Science and Technology (FOS)"},{"schemeUri":"http://www.oecd.org/science/inno/38235147.pdf","subject":"FOS: Physical sciences","subjectScheme":"Fields of Science and Technology (FOS)"}],"contributors":[],"dates":[{"date":"2026-02-22T20:55:01Z","dateType":"Submitted","dateInformation":"v1"},{"date":"2026-02-24T01:59:32Z","dateType":"Updated","dateInformation":"v1"},{"date":"2026-02","dateType":"Available","dateInformation":"v1"},{"date":"2026","dateType":"Issued"}],"language":null,"types":{"schemaOrg":"CreativeWork","resourceTypeGeneral":"Preprint","citeproc":"article","bibtex":"misc","ris":"GEN","resourceType":"Article"},"relatedIdentifiers":[],"relatedItems":[],"sizes":[],"formats":[],"version":"1","rightsList":[{"rightsIdentifierScheme":"SPDX","rightsUri":"https://creativecommons.org/licenses/by/4.0/legalcode","schemeUri":"https://spdx.org/licenses/","rights":"Creative Commons Attribution 4.0 International","rightsIdentifier":"cc-by-4.0"}],"descriptions":[{"descriptionType":"Abstract","description":"Quantifying the maximum energy of fast radio bursts (FRBs) can provide stringent constraints on their emission mechanisms and progenitor models. However, the most energetic bursts are rare, requiring a large sample of FRBs to detect them. In this work, we use the largest available such sample, 2,998 one-off FRBs from the Second CHIME/FRB Catalog, to obtain a lower limit on the maximum energy ($E^{\\mathrm{max}}_{\\mathrm{iso}}$) of FRBs, assuming isotropic energy distribution from FRB sources. In the absence of known redshifts ($z$) for most sources, we present a framework that uses the dispersion measures (DMs) and fluences of these FRBs, together with the probability distribution of $z$ given DM, to derive the lower limit on $E^{\\mathrm{max}}_{\\mathrm{iso}}$. We generate simulated FRB samples assuming different parameter values for a log-normal $\\mathrm{DM}_{\\mathrm{host}}$ distribution and a Schechter function form of the FRB energy function to estimate how many outliers -- FRBs with large DM contributions from the host galaxy or intervening galaxy halos -- could artificially inflate this limit. After accounting for outliers, the lower limit on $E^{\\mathrm{max}}_{\\mathrm{iso}}$ from Catalog 2 FRBs ranges between $1.2\\times10^{41}$ and $1.9\\times10^{42}$ erg, with best estimate $1.2\\times10^{42}$ erg. This limit is consistent with those derived from much smaller FRB samples. Moreover, inferred energies of hundreds of FRBs appear collectively limited around $\\sim10^{42}$ erg, suggesting a physical limit on the energy reservoir of FRB sources. The corresponding isotropic-equivalent FRB source energy is consistent with the total energy available in a magnetar's external dipole magnetic field, supporting magnetars as FRB progenitors."},{"descriptionType":"Other","description":"Submitted to ApJ"}],"geoLocations":[],"fundingReferences":[],"url":"https://arxiv.org/abs/2602.19335","contentUrl":null,"metadataVersion":0,"schemaVersion":"http://datacite.org/schema/kernel-4","source":"mds","isActive":true,"state":"findable","reason":null,"viewCount":0,"downloadCount":0,"referenceCount":0,"citationCount":0,"partCount":0,"partOfCount":0,"versionCount":0,"versionOfCount":0,"created":"2026-02-25T14:56:10Z","registered":"2026-02-25T14:56:11Z","published":null,"updated":"2026-02-25T14:56:11Z"},"relationships":{"client":{"data":{"id":"arxiv.content","type":"clients"}}}},{"id":"10.48550/arxiv.2602.19332","type":"dois","attributes":{"doi":"10.48550/arxiv.2602.19332","identifiers":[{"identifier":"2602.19332","identifierType":"arXiv"}],"creators":[{"nameType":"Personal","givenName":"Rishabh","familyName":"Bhattacharya","name":"Bhattacharya, Rishabh","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Vikaskumar","familyName":"Kalsariya","name":"Kalsariya, Vikaskumar","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Naresh","familyName":"Manwani","name":"Manwani, Naresh","affiliation":[],"nameIdentifiers":[]}],"titles":[{"title":"Training-Free Cross-Architecture Merging for Graph Neural Networks"}],"publisher":"arXiv","container":{},"publicationYear":2026,"subjects":[{"subject":"Machine Learning (cs.LG)","lang":"en","subjectScheme":"arXiv"},{"subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"},{"schemeUri":"http://www.oecd.org/science/inno/38235147.pdf","subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"}],"contributors":[],"dates":[{"date":"2026-02-22T20:43:28Z","dateType":"Submitted","dateInformation":"v1"},{"date":"2026-02-24T01:59:24Z","dateType":"Updated","dateInformation":"v1"},{"date":"2026-02","dateType":"Available","dateInformation":"v1"},{"date":"2026","dateType":"Issued"}],"language":null,"types":{"schemaOrg":"CreativeWork","resourceTypeGeneral":"Preprint","citeproc":"article","bibtex":"misc","ris":"GEN","resourceType":"Article"},"relatedIdentifiers":[],"relatedItems":[],"sizes":[],"formats":[],"version":"1","rightsList":[{"rightsIdentifierScheme":"SPDX","rightsUri":"https://creativecommons.org/licenses/by-sa/4.0/legalcode","schemeUri":"https://spdx.org/licenses/","rights":"Creative Commons Attribution Share Alike 4.0 International","rightsIdentifier":"cc-by-sa-4.0"}],"descriptions":[{"descriptionType":"Abstract","description":"Model merging has emerged as a powerful paradigm for combining the capabilities of distinct expert models without the high computational cost of retraining, yet current methods are fundamentally constrained to homogeneous architectures. For GNNs, however, message passing is topology-dependent and sensitive to misalignment, making direct parameter-space merging unreliable. To bridge this gap, we introduce H-GRAMA (Heterogeneous Graph Routing and Message Alignment), a training-free framework that lifts merging from parameter space to operator space. We formalize Universal Message Passing Mixture (UMPM), a shared operator family that expresses heterogeneous GNN layers in a common functional language. H-GRAMA enables cross-architecture GNN merging (e.g., GCN to GAT) without retraining, retaining high specialist accuracy in most cases in compatible depth settings and achieving inference speedups of 1.2x to 1.9x over ensembles."}],"geoLocations":[],"fundingReferences":[],"url":"https://arxiv.org/abs/2602.19332","contentUrl":null,"metadataVersion":0,"schemaVersion":"http://datacite.org/schema/kernel-4","source":"mds","isActive":true,"state":"findable","reason":null,"viewCount":0,"downloadCount":0,"referenceCount":0,"citationCount":0,"partCount":0,"partOfCount":0,"versionCount":0,"versionOfCount":0,"created":"2026-02-25T14:56:02Z","registered":"2026-02-25T14:56:03Z","published":null,"updated":"2026-02-25T14:56:03Z"},"relationships":{"client":{"data":{"id":"arxiv.content","type":"clients"}}}},{"id":"10.48550/arxiv.2602.19331","type":"dois","attributes":{"doi":"10.48550/arxiv.2602.19331","identifiers":[{"identifier":"2602.19331","identifierType":"arXiv"}],"creators":[{"nameType":"Personal","givenName":"Chaitanya","familyName":"Kapoor","name":"Kapoor, Chaitanya","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Alex H.","familyName":"Williams","name":"Williams, Alex H.","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Meenakshi","familyName":"Khosla","name":"Khosla, Meenakshi","affiliation":[],"nameIdentifiers":[]}],"titles":[{"title":"Partial Soft-Matching Distance for Neural Representational Comparison with Partial Unit Correspondence"}],"publisher":"arXiv","container":{},"publicationYear":2026,"subjects":[{"subject":"Machine Learning (cs.LG)","lang":"en","subjectScheme":"arXiv"},{"subject":"Neural and Evolutionary Computing (cs.NE)","lang":"en","subjectScheme":"arXiv"},{"subject":"Machine Learning (stat.ML)","lang":"en","subjectScheme":"arXiv"},{"subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"},{"schemeUri":"http://www.oecd.org/science/inno/38235147.pdf","subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"}],"contributors":[],"dates":[{"date":"2026-02-22T20:31:35Z","dateType":"Submitted","dateInformation":"v1"},{"date":"2026-02-24T01:59:15Z","dateType":"Updated","dateInformation":"v1"},{"date":"2026-02","dateType":"Available","dateInformation":"v1"},{"date":"2026","dateType":"Issued"}],"language":null,"types":{"schemaOrg":"CreativeWork","resourceTypeGeneral":"Preprint","citeproc":"article","bibtex":"misc","ris":"GEN","resourceType":"Article"},"relatedIdentifiers":[],"relatedItems":[],"sizes":[],"formats":[],"version":"1","rightsList":[{"rightsIdentifierScheme":"SPDX","rightsUri":"https://creativecommons.org/licenses/by-nc-nd/4.0/legalcode","schemeUri":"https://spdx.org/licenses/","rights":"Creative Commons Attribution Non Commercial No Derivatives 4.0 International","rightsIdentifier":"cc-by-nc-nd-4.0"}],"descriptions":[{"descriptionType":"Abstract","description":"Representational similarity metrics typically force all units to be matched, making them susceptible to noise and outliers common in neural representations. We extend the soft-matching distance to a partial optimal transport setting that allows some neurons to remain unmatched, yielding rotation-sensitive but robust correspondences. This partial soft-matching distance provides theoretical advantages -- relaxing strict mass conservation while maintaining interpretable transport costs -- and practical benefits through efficient neuron ranking in terms of cross-network alignment without costly iterative recomputation. In simulations, it preserves correct matches under outliers and reliably selects the correct model in noise-corrupted identification tasks. On fMRI data, it automatically excludes low-reliability voxels and produces voxel rankings by alignment quality that closely match computationally expensive brute-force approaches. It achieves higher alignment precision across homologous brain areas than standard soft-matching, which is forced to match all units regardless of quality. In deep networks, highly matched units exhibit similar maximally exciting images, while unmatched units show divergent patterns. This ability to partition by match quality enables focused analyses, e.g., testing whether networks have privileged axes even within their most aligned subpopulations. Overall, partial soft-matching provides a principled and practical method for representational comparison under partial correspondence."}],"geoLocations":[],"fundingReferences":[],"url":"https://arxiv.org/abs/2602.19331","contentUrl":null,"metadataVersion":0,"schemaVersion":"http://datacite.org/schema/kernel-4","source":"mds","isActive":true,"state":"findable","reason":null,"viewCount":0,"downloadCount":0,"referenceCount":0,"citationCount":0,"partCount":0,"partOfCount":0,"versionCount":0,"versionOfCount":0,"created":"2026-02-25T14:56:00Z","registered":"2026-02-25T14:56:01Z","published":null,"updated":"2026-02-25T14:56:01Z"},"relationships":{"client":{"data":{"id":"arxiv.content","type":"clients"}}}},{"id":"10.48550/arxiv.2602.19329","type":"dois","attributes":{"doi":"10.48550/arxiv.2602.19329","identifiers":[{"identifier":"2602.19329","identifierType":"arXiv"}],"creators":[{"nameType":"Personal","givenName":"Keonvin","familyName":"Park","name":"Park, Keonvin","affiliation":[],"nameIdentifiers":[]}],"titles":[{"title":"Dynamic Elasticity Between Forest Loss and Carbon Emissions: A Subnational Panel Analysis of the United States"}],"publisher":"arXiv","container":{},"publicationYear":2026,"subjects":[{"subject":"Applications (stat.AP)","lang":"en","subjectScheme":"arXiv"},{"subject":"Machine Learning (cs.LG)","lang":"en","subjectScheme":"arXiv"},{"subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"},{"schemeUri":"http://www.oecd.org/science/inno/38235147.pdf","subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"}],"contributors":[],"dates":[{"date":"2026-02-22T20:25:58Z","dateType":"Submitted","dateInformation":"v1"},{"date":"2026-02-24T01:59:03Z","dateType":"Updated","dateInformation":"v1"},{"date":"2026-02","dateType":"Available","dateInformation":"v1"},{"date":"2026","dateType":"Issued"}],"language":null,"types":{"schemaOrg":"CreativeWork","resourceTypeGeneral":"Preprint","citeproc":"article","bibtex":"misc","ris":"GEN","resourceType":"Article"},"relatedIdentifiers":[],"relatedItems":[],"sizes":[],"formats":[],"version":"1","rightsList":[{"rightsIdentifierScheme":"SPDX","rightsUri":"https://creativecommons.org/licenses/by/4.0/legalcode","schemeUri":"https://spdx.org/licenses/","rights":"Creative Commons Attribution 4.0 International","rightsIdentifier":"cc-by-4.0"}],"descriptions":[{"descriptionType":"Abstract","description":"Accurate quantification of the relationship between forest loss and associated carbon emissions is critical for both environmental monitoring and policy evaluation. Although many studies have documented spatial patterns of forest degradation, there is limited understanding of the dynamic elasticity linking tree cover loss to carbon emissions at subnational scales. In this paper, we construct a comprehensive panel dataset of annual forest loss and carbon emission estimates for U.S. subnational administrative units from 2001 to 2023, based on the Hansen Global Forest Change dataset. We apply fixed effects and dynamic panel regression techniques to isolate within-region variation and account for temporal persistence in emissions. Our results show that forest loss has a significant positive short-run elasticity with carbon emissions, and that emissions exhibit strong persistence over time. Importantly, the estimated long-run elasticity, accounting for autoregressive dynamics, is substantially larger than the short-run effect, indicating cumulative impacts of repeated forest loss events. These findings highlight the importance of modeling temporal dynamics when assessing environmental responses to land cover change. The dynamic elasticity framework proposed here offers a robust and interpretable tool for analyzing environmental change processes, and can inform both regional monitoring systems and carbon accounting frameworks."}],"geoLocations":[],"fundingReferences":[],"url":"https://arxiv.org/abs/2602.19329","contentUrl":null,"metadataVersion":0,"schemaVersion":"http://datacite.org/schema/kernel-4","source":"mds","isActive":true,"state":"findable","reason":null,"viewCount":0,"downloadCount":0,"referenceCount":0,"citationCount":0,"partCount":0,"partOfCount":0,"versionCount":0,"versionOfCount":0,"created":"2026-02-25T14:55:55Z","registered":"2026-02-25T14:55:56Z","published":null,"updated":"2026-02-25T14:55:56Z"},"relationships":{"client":{"data":{"id":"arxiv.content","type":"clients"}}}},{"id":"10.48550/arxiv.2602.19324","type":"dois","attributes":{"doi":"10.48550/arxiv.2602.19324","identifiers":[{"identifier":"2602.19324","identifierType":"arXiv"}],"creators":[{"nameType":"Personal","givenName":"Mohammad Tahmid","familyName":"Noor","name":"Noor, Mohammad Tahmid","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Shayan","familyName":"Abrar","name":"Abrar, Shayan","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Jannatul Adan","familyName":"Mahi","name":"Mahi, Jannatul Adan","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Md Parvez","familyName":"Mia","name":"Mia, Md Parvez","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Asaduzzaman","familyName":"Hridoy","name":"Hridoy, Asaduzzaman","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Samanta","familyName":"Ghosh","name":"Ghosh, Samanta","affiliation":[],"nameIdentifiers":[]}],"titles":[{"title":"RetinaVision: XAI-Driven Augmented Regulation for Precise Retinal Disease Classification using deep learning framework"}],"publisher":"arXiv","container":{},"publicationYear":2026,"subjects":[{"subject":"Computer Vision and Pattern Recognition (cs.CV)","lang":"en","subjectScheme":"arXiv"},{"subject":"Artificial Intelligence (cs.AI)","lang":"en","subjectScheme":"arXiv"},{"subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"},{"schemeUri":"http://www.oecd.org/science/inno/38235147.pdf","subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"}],"contributors":[],"dates":[{"date":"2026-02-22T20:05:54Z","dateType":"Submitted","dateInformation":"v1"},{"date":"2026-02-24T01:58:44Z","dateType":"Updated","dateInformation":"v1"},{"date":"2026-02","dateType":"Available","dateInformation":"v1"},{"date":"2026","dateType":"Issued"}],"language":null,"types":{"schemaOrg":"CreativeWork","resourceTypeGeneral":"Preprint","citeproc":"article","bibtex":"misc","ris":"GEN","resourceType":"Article"},"relatedIdentifiers":[],"relatedItems":[],"sizes":[],"formats":[],"version":"1","rightsList":[{"rightsIdentifierScheme":"SPDX","rightsUri":"https://creativecommons.org/licenses/by/4.0/legalcode","schemeUri":"https://spdx.org/licenses/","rights":"Creative Commons Attribution 4.0 International","rightsIdentifier":"cc-by-4.0"}],"descriptions":[{"descriptionType":"Abstract","description":"Early and accurate classification of retinal diseases is critical to counter vision loss and for guiding clinical management of retinal diseases. In this study, we proposed a deep learning method for retinal disease classification utilizing optical coherence tomography (OCT) images from the Retinal OCT Image Classification - C8 dataset (comprising 24,000 labeled images spanning eight conditions). Images were resized to 224x224 px and tested on convolutional neural network (CNN) architectures: Xception and InceptionV3. Data augmentation techniques (CutMix, MixUp) were employed to enhance model generalization. Additionally, we applied GradCAM and LIME for interpretability evaluation. We implemented this in a real-world scenario via our web application named RetinaVision. This study found that Xception was the most accurate network (95.25%), followed closely by InceptionV3 (94.82%). These results suggest that deep learning methods allow effective OCT retinal disease classification and highlight the importance of implementing accuracy and interpretability for clinical applications."},{"descriptionType":"Other","description":"6 pages, 15 figures"}],"geoLocations":[],"fundingReferences":[],"url":"https://arxiv.org/abs/2602.19324","contentUrl":null,"metadataVersion":0,"schemaVersion":"http://datacite.org/schema/kernel-4","source":"mds","isActive":true,"state":"findable","reason":null,"viewCount":0,"downloadCount":0,"referenceCount":0,"citationCount":0,"partCount":0,"partOfCount":0,"versionCount":0,"versionOfCount":0,"created":"2026-02-25T14:55:43Z","registered":"2026-02-25T14:55:43Z","published":null,"updated":"2026-02-25T14:55:43Z"},"relationships":{"client":{"data":{"id":"arxiv.content","type":"clients"}}}},{"id":"10.48550/arxiv.2602.19321","type":"dois","attributes":{"doi":"10.48550/arxiv.2602.19321","identifiers":[{"identifier":"2602.19321","identifierType":"arXiv"}],"creators":[{"nameType":"Personal","givenName":"Youngook","familyName":"Choi","name":"Choi, Youngook","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Flamino","familyName":"Flamini","name":"Flamini, Flamino","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Seonja","familyName":"Kim","name":"Kim, Seonja","affiliation":[],"nameIdentifiers":[]}],"titles":[{"title":"Universal extension spaces and modular maps: unveiling irreducible components of Brill-Noether loci of stable bundles on a general $ν$-gonal curve"}],"publisher":"arXiv","container":{},"publicationYear":2026,"subjects":[{"subject":"Algebraic Geometry (math.AG)","lang":"en","subjectScheme":"arXiv"},{"subject":"FOS: Mathematics","subjectScheme":"Fields of Science and Technology (FOS)"},{"schemeUri":"http://www.oecd.org/science/inno/38235147.pdf","subject":"FOS: Mathematics","subjectScheme":"Fields of Science and Technology (FOS)"},{"subject":"14H60, 14H10, 14D20, 14D22, 14J26, 14E05, 14B10, 14N05","lang":"en","subjectScheme":"MSC"}],"contributors":[],"dates":[{"date":"2026-02-22T19:53:46Z","dateType":"Submitted","dateInformation":"v1"},{"date":"2026-02-24T01:58:32Z","dateType":"Updated","dateInformation":"v1"},{"date":"2026-02","dateType":"Available","dateInformation":"v1"},{"date":"2026","dateType":"Issued"}],"language":null,"types":{"schemaOrg":"CreativeWork","resourceTypeGeneral":"Preprint","citeproc":"article","bibtex":"misc","ris":"GEN","resourceType":"Article"},"relatedIdentifiers":[],"relatedItems":[],"sizes":[],"formats":[],"version":"1","rightsList":[{"rightsIdentifierScheme":"SPDX","rightsUri":"https://creativecommons.org/licenses/by/4.0/legalcode","schemeUri":"https://spdx.org/licenses/","rights":"Creative Commons Attribution 4.0 International","rightsIdentifier":"cc-by-4.0"}],"descriptions":[{"descriptionType":"Abstract","description":"We investigate the Brill-Noether theory of rank-two, degree-$d$ stable vector bundles of speciality $3$ on a general $ν$-gonal curve of genus $g$, $3 \\leq ν\u0026lt; \\lfloor \\frac{g+3}{2} \\rfloor$. Our approach leverages universal extension spaces, modular maps, and recent advancements in rank-one Brill-Noether theory over Hurwitz spaces.\n We establish existence criteria for the corresponding Brill-Noether loci and provide a comprehensive description of their irreducible components. We moreover prove that these components exhibit diverse geometric behaviors, categorized by their regularity, superabundance, and the properties of their general points. Notably, for specific degrees $d$, we prove the coexistence of multiple superabundant components alongside a regular one. Using specialization techniques, we uncover a stratification into locally closed subschemes within these components and provide insights into their birational geometry and local structure. Furthermore, our results yield also consequences for Brill-Noether loci of stable, rank-two bundles with a fixed general determinant."},{"descriptionType":"Other","description":"52 pages, 5 figures. Acknowledgments: Korean funds from NRF, Italian funds MatMod@TOV; warmly thank G. Pareschi for support from AAAGH funds, D. S. Hwang, J.M. Hwang, and Y. Lee for support during \"Workshop in Classical Algebraic Geometry\" (Daejeon, Dec. 2023), A. Bajravani for reference, F. Catanese and J.H. Keum for support during \"46th Frontier Scientists Workshop\" (Ischia, Oct. 2025)"}],"geoLocations":[],"fundingReferences":[],"url":"https://arxiv.org/abs/2602.19321","contentUrl":null,"metadataVersion":0,"schemaVersion":"http://datacite.org/schema/kernel-4","source":"mds","isActive":true,"state":"findable","reason":null,"viewCount":0,"downloadCount":0,"referenceCount":0,"citationCount":0,"partCount":0,"partOfCount":0,"versionCount":0,"versionOfCount":0,"created":"2026-02-25T14:55:35Z","registered":"2026-02-25T14:55:36Z","published":null,"updated":"2026-02-25T14:55:36Z"},"relationships":{"client":{"data":{"id":"arxiv.content","type":"clients"}}}},{"id":"10.48550/arxiv.2602.19319","type":"dois","attributes":{"doi":"10.48550/arxiv.2602.19319","identifiers":[{"identifier":"2602.19319","identifierType":"arXiv"}],"creators":[{"nameType":"Personal","givenName":"Sujaya","familyName":"Maiyya","name":"Maiyya, Sujaya","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Shantanu","familyName":"Sharma","name":"Sharma, Shantanu","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Avinash","familyName":"Kumar","name":"Kumar, Avinash","affiliation":[],"nameIdentifiers":[]}],"titles":[{"title":"Health+: Empowering Individuals via Unifying Health Data"}],"publisher":"arXiv","container":{},"publicationYear":2026,"subjects":[{"subject":"Multimedia (cs.MM)","lang":"en","subjectScheme":"arXiv"},{"subject":"Artificial Intelligence (cs.AI)","lang":"en","subjectScheme":"arXiv"},{"subject":"Cryptography and Security (cs.CR)","lang":"en","subjectScheme":"arXiv"},{"subject":"Databases (cs.DB)","lang":"en","subjectScheme":"arXiv"},{"subject":"Distributed, Parallel, and Cluster Computing (cs.DC)","lang":"en","subjectScheme":"arXiv"},{"subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"},{"schemeUri":"http://www.oecd.org/science/inno/38235147.pdf","subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"}],"contributors":[],"dates":[{"date":"2026-02-22T19:48:57Z","dateType":"Submitted","dateInformation":"v1"},{"date":"2026-02-24T01:58:30Z","dateType":"Updated","dateInformation":"v1"},{"date":"2026-02","dateType":"Available","dateInformation":"v1"},{"date":"2026","dateType":"Issued"}],"language":null,"types":{"schemaOrg":"CreativeWork","resourceTypeGeneral":"Preprint","citeproc":"article","bibtex":"misc","ris":"GEN","resourceType":"Article"},"relatedIdentifiers":[],"relatedItems":[],"sizes":[],"formats":[],"version":"1","rightsList":[{"rightsIdentifierScheme":"SPDX","rightsUri":"https://creativecommons.org/licenses/by/4.0/legalcode","schemeUri":"https://spdx.org/licenses/","rights":"Creative Commons Attribution 4.0 International","rightsIdentifier":"cc-by-4.0"}],"descriptions":[{"descriptionType":"Abstract","description":"Managing personal health data is a challenge in today's fragmented and institution-centric healthcare ecosystem. Individuals often lack meaningful control over their medical records, which are scattered across incompatible systems and formats. This vision paper presents Health+, a user-centric, multimodal health data management system that empowers individuals (including those with limited technical expertise) to upload, query, and share their data across modalities (e.g., text, images, reports). Rather than aiming for institutional overhaul, Health+ emphasizes individual agency by providing intuitive interfaces and intelligent recommendations for data access and sharing. At the system level, it tackles the complexity of storing, integrating, and securing heterogeneous health records, ensuring both efficiency and privacy. By unifying multimodal data and prioritizing patients, Health+ lays the foundation for a more connected, interpretable, and user-controlled health information ecosystem."},{"descriptionType":"Other","description":"This paper has been accepted in ACM Multimedia 2025"}],"geoLocations":[],"fundingReferences":[],"url":"https://arxiv.org/abs/2602.19319","contentUrl":null,"metadataVersion":0,"schemaVersion":"http://datacite.org/schema/kernel-4","source":"mds","isActive":true,"state":"findable","reason":null,"viewCount":0,"downloadCount":0,"referenceCount":0,"citationCount":0,"partCount":0,"partOfCount":0,"versionCount":0,"versionOfCount":0,"created":"2026-02-25T14:55:31Z","registered":"2026-02-25T14:55:31Z","published":null,"updated":"2026-02-25T14:55:31Z"},"relationships":{"client":{"data":{"id":"arxiv.content","type":"clients"}}}},{"id":"10.48550/arxiv.2602.19318","type":"dois","attributes":{"doi":"10.48550/arxiv.2602.19318","identifiers":[{"identifier":"2602.19318","identifierType":"arXiv"}],"creators":[{"nameType":"Personal","givenName":"Davesh","familyName":"Maulik","name":"Maulik, Davesh","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Junliang","familyName":"Shen","name":"Shen, Junliang","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Qizheng","familyName":"Yin","name":"Yin, Qizheng","affiliation":[],"nameIdentifiers":[]}],"titles":[{"title":"Dualizable abelian fibrations"}],"publisher":"arXiv","container":{},"publicationYear":2026,"subjects":[{"subject":"Algebraic Geometry (math.AG)","lang":"en","subjectScheme":"arXiv"},{"subject":"FOS: Mathematics","subjectScheme":"Fields of Science and Technology (FOS)"},{"schemeUri":"http://www.oecd.org/science/inno/38235147.pdf","subject":"FOS: Mathematics","subjectScheme":"Fields of Science and Technology (FOS)"}],"contributors":[],"dates":[{"date":"2026-02-22T19:45:51Z","dateType":"Submitted","dateInformation":"v1"},{"date":"2026-02-24T01:58:26Z","dateType":"Updated","dateInformation":"v1"},{"date":"2026-02","dateType":"Available","dateInformation":"v1"},{"date":"2026","dateType":"Issued"}],"language":null,"types":{"schemaOrg":"CreativeWork","resourceTypeGeneral":"Preprint","citeproc":"article","bibtex":"misc","ris":"GEN","resourceType":"Article"},"relatedIdentifiers":[],"relatedItems":[],"sizes":[],"formats":[],"version":"1","rightsList":[{"rightsIdentifierScheme":"SPDX","rightsUri":"https://creativecommons.org/licenses/by/4.0/legalcode","schemeUri":"https://spdx.org/licenses/","rights":"Creative Commons Attribution 4.0 International","rightsIdentifier":"cc-by-4.0"}],"descriptions":[{"descriptionType":"Abstract","description":"In his proof of the fundamental lemma of the Langlands program, Ngô initiated the study of the decomposition theorem for abelian fibrations. When an abelian fibration admits a duality structure, the decomposition theorem and the perverse filtration on cohomology exhibit rich structures. The purpose of these notes is to describe a framework for dualizable abelian fibrations and to discuss some recent progress and applications."},{"descriptionType":"Other","description":"25 pages. Submitted to the Proceedings of the 2025 Summer Research Institute in Algebraic Geometry"}],"geoLocations":[],"fundingReferences":[],"url":"https://arxiv.org/abs/2602.19318","contentUrl":null,"metadataVersion":0,"schemaVersion":"http://datacite.org/schema/kernel-4","source":"mds","isActive":true,"state":"findable","reason":null,"viewCount":0,"downloadCount":0,"referenceCount":0,"citationCount":0,"partCount":0,"partOfCount":0,"versionCount":0,"versionOfCount":0,"created":"2026-02-25T14:55:28Z","registered":"2026-02-25T14:55:29Z","published":null,"updated":"2026-02-25T14:55:29Z"},"relationships":{"client":{"data":{"id":"arxiv.content","type":"clients"}}}},{"id":"10.48550/arxiv.2602.19317","type":"dois","attributes":{"doi":"10.48550/arxiv.2602.19317","identifiers":[{"identifier":"2602.19317","identifierType":"arXiv"}],"creators":[{"nameType":"Personal","givenName":"Maryam","familyName":"Amirizaniani","name":"Amirizaniani, Maryam","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Alireza","familyName":"Salemi","name":"Salemi, Alireza","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Hamed","familyName":"Zamani","name":"Zamani, Hamed","affiliation":[],"nameIdentifiers":[]}],"titles":[{"title":"Learning to Reason for Multi-Step Retrieval of Personal Context in Personalized Question Answering"}],"publisher":"arXiv","container":{},"publicationYear":2026,"subjects":[{"subject":"Computation and Language (cs.CL)","lang":"en","subjectScheme":"arXiv"},{"subject":"Artificial Intelligence (cs.AI)","lang":"en","subjectScheme":"arXiv"},{"subject":"Information Retrieval (cs.IR)","lang":"en","subjectScheme":"arXiv"},{"subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"},{"schemeUri":"http://www.oecd.org/science/inno/38235147.pdf","subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"}],"contributors":[],"dates":[{"date":"2026-02-22T19:43:43Z","dateType":"Submitted","dateInformation":"v1"},{"date":"2026-02-24T01:58:25Z","dateType":"Updated","dateInformation":"v1"},{"date":"2026-02","dateType":"Available","dateInformation":"v1"},{"date":"2026","dateType":"Issued"}],"language":null,"types":{"schemaOrg":"CreativeWork","resourceTypeGeneral":"Preprint","citeproc":"article","bibtex":"misc","ris":"GEN","resourceType":"Article"},"relatedIdentifiers":[],"relatedItems":[],"sizes":[],"formats":[],"version":"1","rightsList":[{"rightsIdentifierScheme":"SPDX","rightsUri":"https://creativecommons.org/licenses/by/4.0/legalcode","schemeUri":"https://spdx.org/licenses/","rights":"Creative Commons Attribution 4.0 International","rightsIdentifier":"cc-by-4.0"}],"descriptions":[{"descriptionType":"Abstract","description":"Personalization in Question Answering (QA) requires answers that are both accurate and aligned with users' background, preferences, and historical context. Existing state-of-the-art methods primarily rely on retrieval-augmented generation (RAG) solutions that construct personal context by retrieving relevant items from the user's profile. Existing methods use the user's query directly to retrieve personal documents, and such strategies often lead to surface-level personalization. We propose PR2 (Personalized Retrieval-Augmented Reasoning), a reinforcement learning framework that integrates reasoning and retrieval from personal context for personalization. PR2 learns adaptive retrieval-reasoning policies, determining when to retrieve, what evidence to retrieve from user profiles, and how to incorporate it into intermediate reasoning steps. By optimizing multi-turn reasoning trajectories under a personalized reward function, the framework reinforces reasoning paths that better align with user-specific preferences and contextual signals reflected by the reward model. Extensive experiments on the LaMP-QA benchmark using three LLMs show that PR2 consistently outperforms strong baselines, achieving an average relative improvement of 8.8%-12% in personalized QA."}],"geoLocations":[],"fundingReferences":[],"url":"https://arxiv.org/abs/2602.19317","contentUrl":null,"metadataVersion":0,"schemaVersion":"http://datacite.org/schema/kernel-4","source":"mds","isActive":true,"state":"findable","reason":null,"viewCount":0,"downloadCount":0,"referenceCount":0,"citationCount":0,"partCount":0,"partOfCount":0,"versionCount":0,"versionOfCount":0,"created":"2026-02-25T14:55:26Z","registered":"2026-02-25T14:55:27Z","published":null,"updated":"2026-02-25T14:55:27Z"},"relationships":{"client":{"data":{"id":"arxiv.content","type":"clients"}}}},{"id":"10.48550/arxiv.2602.19316","type":"dois","attributes":{"doi":"10.48550/arxiv.2602.19316","identifiers":[{"identifier":"2602.19316","identifierType":"arXiv"}],"creators":[{"nameType":"Personal","givenName":"Alexandros","familyName":"Haliassos","name":"Haliassos, Alexandros","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Rodrigo","familyName":"Mira","name":"Mira, Rodrigo","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Stavros","familyName":"Petridis","name":"Petridis, Stavros","affiliation":[],"nameIdentifiers":[]}],"titles":[{"title":"Pay Attention to CTC: Fast and Robust Pseudo-Labelling for Unified Speech Recognition"}],"publisher":"arXiv","container":{},"publicationYear":2026,"subjects":[{"subject":"Computer Vision and Pattern Recognition (cs.CV)","lang":"en","subjectScheme":"arXiv"},{"subject":"Sound (cs.SD)","lang":"en","subjectScheme":"arXiv"},{"subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"},{"schemeUri":"http://www.oecd.org/science/inno/38235147.pdf","subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"}],"contributors":[],"dates":[{"date":"2026-02-22T19:38:21Z","dateType":"Submitted","dateInformation":"v1"},{"date":"2026-02-24T01:58:24Z","dateType":"Updated","dateInformation":"v1"},{"date":"2026-02","dateType":"Available","dateInformation":"v1"},{"date":"2026","dateType":"Issued"}],"language":null,"types":{"schemaOrg":"CreativeWork","resourceTypeGeneral":"Preprint","citeproc":"article","bibtex":"misc","ris":"GEN","resourceType":"Article"},"relatedIdentifiers":[],"relatedItems":[],"sizes":[],"formats":[],"version":"1","rightsList":[{"rightsUri":"http://arxiv.org/licenses/nonexclusive-distrib/1.0/","rights":"arXiv.org perpetual, non-exclusive license"}],"descriptions":[{"descriptionType":"Abstract","description":"Unified Speech Recognition (USR) has emerged as a semi-supervised framework for training a single model for audio, visual, and audiovisual speech recognition, achieving state-of-the-art results on in-distribution benchmarks. However, its reliance on autoregressive pseudo-labelling makes training expensive, while its decoupled supervision of CTC and attention branches increases susceptibility to self-reinforcing errors, particularly under distribution shifts involving longer sequences, noise, or unseen domains. We propose CTC-driven teacher forcing, where greedily decoded CTC pseudo-labels are fed into the decoder to generate attention targets in a single forward pass. Although these can be globally incoherent, in the pseudo-labelling setting they enable efficient and effective knowledge transfer. Because CTC and CTC-driven attention pseudo-labels have the same length, the decoder can predict both simultaneously, benefiting from the robustness of CTC and the expressiveness of attention without costly beam search. We further propose mixed sampling to mitigate the exposure bias of the decoder relying solely on CTC inputs. The resulting method, USR 2.0, halves training time, improves robustness to out-of-distribution inputs, and achieves state-of-the-art results on LRS3, LRS2, and WildVSR, surpassing USR and modality-specific self-supervised baselines."},{"descriptionType":"Other","description":"ICLR 2026. Code: https://github.com/ahaliassos/usr2"}],"geoLocations":[],"fundingReferences":[],"url":"https://arxiv.org/abs/2602.19316","contentUrl":null,"metadataVersion":0,"schemaVersion":"http://datacite.org/schema/kernel-4","source":"mds","isActive":true,"state":"findable","reason":null,"viewCount":0,"downloadCount":0,"referenceCount":0,"citationCount":0,"partCount":0,"partOfCount":0,"versionCount":0,"versionOfCount":0,"created":"2026-02-25T14:55:23Z","registered":"2026-02-25T14:55:24Z","published":null,"updated":"2026-02-25T14:55:24Z"},"relationships":{"client":{"data":{"id":"arxiv.content","type":"clients"}}}},{"id":"10.48550/arxiv.2602.19314","type":"dois","attributes":{"doi":"10.48550/arxiv.2602.19314","identifiers":[{"identifier":"2602.19314","identifierType":"arXiv"}],"creators":[{"nameType":"Personal","givenName":"Guoliang","familyName":"Gong","name":"Gong, Guoliang","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Man","familyName":"Yu","name":"Yu, Man","affiliation":[],"nameIdentifiers":[]}],"titles":[{"title":"IPv2: An Improved Image Purification Strategy for Real-World Ultra-Low-Dose Lung CT Denoising"}],"publisher":"arXiv","container":{},"publicationYear":2026,"subjects":[{"subject":"Computer Vision and Pattern Recognition (cs.CV)","lang":"en","subjectScheme":"arXiv"},{"subject":"Artificial Intelligence (cs.AI)","lang":"en","subjectScheme":"arXiv"},{"subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"},{"schemeUri":"http://www.oecd.org/science/inno/38235147.pdf","subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"}],"contributors":[],"dates":[{"date":"2026-02-22T19:28:31Z","dateType":"Submitted","dateInformation":"v1"},{"date":"2026-02-24T01:58:02Z","dateType":"Updated","dateInformation":"v1"},{"date":"2026-02","dateType":"Available","dateInformation":"v1"},{"date":"2026","dateType":"Issued"}],"language":null,"types":{"schemaOrg":"CreativeWork","resourceTypeGeneral":"Preprint","citeproc":"article","bibtex":"misc","ris":"GEN","resourceType":"Article"},"relatedIdentifiers":[],"relatedItems":[],"sizes":[],"formats":[],"version":"1","rightsList":[{"rightsIdentifierScheme":"SPDX","rightsUri":"https://creativecommons.org/licenses/by/4.0/legalcode","schemeUri":"https://spdx.org/licenses/","rights":"Creative Commons Attribution 4.0 International","rightsIdentifier":"cc-by-4.0"}],"descriptions":[{"descriptionType":"Abstract","description":"The image purification strategy constructs an intermediate distribution with aligned anatomical structures, which effectively corrects the spatial misalignment between real-world ultra-low-dose CT and normal-dose CT images and significantly enhances the structural preservation ability of denoising models. However, this strategy exhibits two inherent limitations. First, it suppresses noise only in the chest wall and bone regions while leaving the image background untreated. Second, it lacks a dedicated mechanism for denoising the lung parenchyma. To address these issues, we systematically redesign the original image purification strategy and propose an improved version termed IPv2. The proposed strategy introduces three core modules, namely Remove Background, Add noise, and Remove noise. These modules endow the model with denoising capability in both background and lung tissue regions during training data construction and provide a more reasonable evaluation protocol through refined label construction at the testing stage. Extensive experiments on our previously established real-world patient lung CT dataset acquired at 2% radiation dose demonstrate that IPv2 consistently improves background suppression and lung parenchyma restoration across multiple mainstream denoising models. The code is publicly available at https://github.com/MonkeyDadLufy/Image-Purification-Strategy-v2."}],"geoLocations":[],"fundingReferences":[],"url":"https://arxiv.org/abs/2602.19314","contentUrl":null,"metadataVersion":0,"schemaVersion":"http://datacite.org/schema/kernel-4","source":"mds","isActive":true,"state":"findable","reason":null,"viewCount":0,"downloadCount":0,"referenceCount":0,"citationCount":0,"partCount":0,"partOfCount":0,"versionCount":0,"versionOfCount":0,"created":"2026-02-25T14:55:18Z","registered":"2026-02-25T14:55:19Z","published":null,"updated":"2026-02-25T14:55:19Z"},"relationships":{"client":{"data":{"id":"arxiv.content","type":"clients"}}}},{"id":"10.48550/arxiv.2602.19312","type":"dois","attributes":{"doi":"10.48550/arxiv.2602.19312","identifiers":[{"identifier":"2602.19312","identifierType":"arXiv"}],"creators":[{"nameType":"Personal","givenName":"Kyriakos","familyName":"Stylianopoulos","name":"Stylianopoulos, Kyriakos","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Mario Edoardo","familyName":"Pandolfo","name":"Pandolfo, Mario Edoardo","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Paolo","familyName":"Di Lorenzo","name":"Di Lorenzo, Paolo","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"George C.","familyName":"Alexandropoulos","name":"Alexandropoulos, George C.","affiliation":[],"nameIdentifiers":[]}],"titles":[{"title":"Metasurfaces-Integrated Wireless Neural Networks for Lightweight Over-The-Air Edge Inference"}],"publisher":"arXiv","container":{},"publicationYear":2026,"subjects":[{"subject":"Emerging Technologies (cs.ET)","lang":"en","subjectScheme":"arXiv"},{"subject":"Machine Learning (cs.LG)","lang":"en","subjectScheme":"arXiv"},{"subject":"Signal Processing (eess.SP)","lang":"en","subjectScheme":"arXiv"},{"subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"},{"schemeUri":"http://www.oecd.org/science/inno/38235147.pdf","subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"},{"subject":"FOS: Electrical engineering, electronic engineering, information engineering","subjectScheme":"Fields of Science and Technology (FOS)"},{"schemeUri":"http://www.oecd.org/science/inno/38235147.pdf","subject":"FOS: Electrical engineering, electronic engineering, information engineering","subjectScheme":"Fields of Science and Technology (FOS)"}],"contributors":[],"dates":[{"date":"2026-02-22T19:23:49Z","dateType":"Submitted","dateInformation":"v1"},{"date":"2026-02-24T01:57:48Z","dateType":"Updated","dateInformation":"v1"},{"date":"2026-02","dateType":"Available","dateInformation":"v1"},{"date":"2026","dateType":"Issued"}],"language":null,"types":{"schemaOrg":"CreativeWork","resourceTypeGeneral":"Preprint","citeproc":"article","bibtex":"misc","ris":"GEN","resourceType":"Article"},"relatedIdentifiers":[],"relatedItems":[],"sizes":[],"formats":[],"version":"1","rightsList":[{"rightsIdentifierScheme":"SPDX","rightsUri":"https://creativecommons.org/licenses/by/4.0/legalcode","schemeUri":"https://spdx.org/licenses/","rights":"Creative Commons Attribution 4.0 International","rightsIdentifier":"cc-by-4.0"}],"descriptions":[{"descriptionType":"Abstract","description":"The upcoming sixth Generation (6G) of wireless networks envisions ultra-low latency and energy efficient Edge Inference (EI) for diverse Internet of Things (IoT) applications. However, traditional digital hardware for machine learning is power intensive, motivating the need for alternative computation paradigms. Over-The-Air (OTA) computation is regarded as an emerging transformative approach assigning the wireless channel to actively perform computational tasks. This article introduces the concept of Metasurfaces-Integrated Neural Networks (MINNs), a physical-layer-enabled deep learning framework that leverages programmable multi-layer metasurface structures and Multiple-Input Multiple-Output (MIMO) channels to realize computational layers in the wave propagation domain. The MINN system is conceptualized as three modules: Encoder, Channel (uncontrollable propagation features and metasurfaces), and Decoder. The first and last modules, realized respectively at the multi-antenna transmitter and receiver, consist of conventional digital or purposely designed analog Deep Neural Network (DNN) layers, and the metasurfaces responses of the Channel module are optimized alongside all modules as trainable weights. This architecture enables computation offloading into the end-to-end physical layer, flexibly among its constituent modules, achieving performance comparable to fully digital DNNs while significantly reducing power consumption. The training of the MINN framework, two representative variations, and performance results for indicative applications are presented, highlighting the potential of MINNs as a lightweight and sustainable solution for future EI-enabled wireless systems. The article is concluded with a list of open challenges and promising research directions."},{"descriptionType":"Other","description":"9 pages, 6 figures, submitted for magazine publication"}],"geoLocations":[],"fundingReferences":[],"url":"https://arxiv.org/abs/2602.19312","contentUrl":null,"metadataVersion":0,"schemaVersion":"http://datacite.org/schema/kernel-4","source":"mds","isActive":true,"state":"findable","reason":null,"viewCount":0,"downloadCount":0,"referenceCount":0,"citationCount":0,"partCount":0,"partOfCount":0,"versionCount":0,"versionOfCount":0,"created":"2026-02-25T14:55:13Z","registered":"2026-02-25T14:55:14Z","published":null,"updated":"2026-02-25T14:55:14Z"},"relationships":{"client":{"data":{"id":"arxiv.content","type":"clients"}}}},{"id":"10.48550/arxiv.2602.19311","type":"dois","attributes":{"doi":"10.48550/arxiv.2602.19311","identifiers":[{"identifier":"2602.19311","identifierType":"arXiv"}],"creators":[{"nameType":"Personal","givenName":"Stefan","familyName":"Steinerberger","name":"Steinerberger, Stefan","affiliation":[],"nameIdentifiers":[]}],"titles":[{"title":"Distance Equilibrium Measures and Curvature in Metric Spaces"}],"publisher":"arXiv","container":{},"publicationYear":2026,"subjects":[{"subject":"Metric Geometry (math.MG)","lang":"en","subjectScheme":"arXiv"},{"subject":"FOS: Mathematics","subjectScheme":"Fields of Science and Technology (FOS)"},{"schemeUri":"http://www.oecd.org/science/inno/38235147.pdf","subject":"FOS: Mathematics","subjectScheme":"Fields of Science and Technology (FOS)"}],"contributors":[],"dates":[{"date":"2026-02-22T19:22:35Z","dateType":"Submitted","dateInformation":"v1"},{"date":"2026-02-24T01:57:41Z","dateType":"Updated","dateInformation":"v1"},{"date":"2026-02","dateType":"Available","dateInformation":"v1"},{"date":"2026","dateType":"Issued"}],"language":null,"types":{"schemaOrg":"CreativeWork","resourceTypeGeneral":"Preprint","citeproc":"article","bibtex":"misc","ris":"GEN","resourceType":"Article"},"relatedIdentifiers":[],"relatedItems":[],"sizes":[],"formats":[],"version":"1","rightsList":[{"rightsUri":"http://arxiv.org/licenses/nonexclusive-distrib/1.0/","rights":"arXiv.org perpetual, non-exclusive license"}],"descriptions":[{"descriptionType":"Abstract","description":"Let $(X,d)$ be a compact metric space. We consider the behavior of probability measures $μ$ with the property that $$ \\int_{X} d(x, y) dμ(y) \\qquad \\mbox{is independent of}~x \\in X.$$ It appears that such measures, when they exist, encode a `curvature-type' quantity. We investigate this in the special case where $X$ is a closed, convex curve in $\\mathbb{R}^2$ and $d = \\| \\cdot \\|_2$ is the Euclidean distance: even a single point with small curvature implies non-existence of such a measure. Conversely, such a measure $μ$ exists for all curves whose curvature is sufficiently close to constant. Curvature is usually defined by second derivatives; this one is defined via an integral equation which makes sense in much rougher spaces. Connections to curvature on graphs, the Gross-Stadje Theorem and magnitude are discussed."}],"geoLocations":[],"fundingReferences":[],"url":"https://arxiv.org/abs/2602.19311","contentUrl":null,"metadataVersion":0,"schemaVersion":"http://datacite.org/schema/kernel-4","source":"mds","isActive":true,"state":"findable","reason":null,"viewCount":0,"downloadCount":0,"referenceCount":0,"citationCount":0,"partCount":0,"partOfCount":0,"versionCount":0,"versionOfCount":0,"created":"2026-02-25T14:55:11Z","registered":"2026-02-25T14:55:12Z","published":null,"updated":"2026-02-25T14:55:12Z"},"relationships":{"client":{"data":{"id":"arxiv.content","type":"clients"}}}},{"id":"10.48550/arxiv.2602.19308","type":"dois","attributes":{"doi":"10.48550/arxiv.2602.19308","identifiers":[{"identifier":"2602.19308","identifierType":"arXiv"}],"creators":[{"nameType":"Personal","givenName":"Hardik","familyName":"Shah","name":"Shah, Hardik","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Erica","familyName":"Tevere","name":"Tevere, Erica","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Deegan","familyName":"Atha","name":"Atha, Deegan","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Marcel","familyName":"Kaufmann","name":"Kaufmann, Marcel","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Shehryar","familyName":"Khattak","name":"Khattak, Shehryar","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Manthan","familyName":"Patel","name":"Patel, Manthan","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Marco","familyName":"Hutter","name":"Hutter, Marco","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Jonas","familyName":"Frey","name":"Frey, Jonas","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Patrick","familyName":"Spieler","name":"Spieler, Patrick","affiliation":[],"nameIdentifiers":[]}],"titles":[{"title":"WildOS: Open-Vocabulary Object Search in the Wild"}],"publisher":"arXiv","container":{},"publicationYear":2026,"subjects":[{"subject":"Robotics (cs.RO)","lang":"en","subjectScheme":"arXiv"},{"subject":"Computer Vision and Pattern Recognition (cs.CV)","lang":"en","subjectScheme":"arXiv"},{"subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"},{"schemeUri":"http://www.oecd.org/science/inno/38235147.pdf","subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"}],"contributors":[],"dates":[{"date":"2026-02-22T19:14:00Z","dateType":"Submitted","dateInformation":"v1"},{"date":"2026-02-24T01:57:33Z","dateType":"Updated","dateInformation":"v1"},{"date":"2026-02","dateType":"Available","dateInformation":"v1"},{"date":"2026","dateType":"Issued"}],"language":null,"types":{"schemaOrg":"CreativeWork","resourceTypeGeneral":"Preprint","citeproc":"article","bibtex":"misc","ris":"GEN","resourceType":"Article"},"relatedIdentifiers":[],"relatedItems":[],"sizes":[],"formats":[],"version":"1","rightsList":[{"rightsIdentifierScheme":"SPDX","rightsUri":"https://creativecommons.org/licenses/by-sa/4.0/legalcode","schemeUri":"https://spdx.org/licenses/","rights":"Creative Commons Attribution Share Alike 4.0 International","rightsIdentifier":"cc-by-sa-4.0"}],"descriptions":[{"descriptionType":"Abstract","description":"Autonomous navigation in complex, unstructured outdoor environments requires robots to operate over long ranges without prior maps and limited depth sensing. In such settings, relying solely on geometric frontiers for exploration is often insufficient. In such settings, the ability to reason semantically about where to go and what is safe to traverse is crucial for robust, efficient exploration. This work presents WildOS, a unified system for long-range, open-vocabulary object search that combines safe geometric exploration with semantic visual reasoning. WildOS builds a sparse navigation graph to maintain spatial memory, while utilizing a foundation-model-based vision module, ExploRFM, to score frontier nodes of the graph. ExploRFM simultaneously predicts traversability, visual frontiers, and object similarity in image space, enabling real-time, onboard semantic navigation tasks. The resulting vision-scored graph enables the robot to explore semantically meaningful directions while ensuring geometric safety. Furthermore, we introduce a particle-filter-based method for coarse localization of the open-vocabulary target query, that estimates candidate goal positions beyond the robot's immediate depth horizon, enabling effective planning toward distant goals. Extensive closed-loop field experiments across diverse off-road and urban terrains demonstrate that WildOS enables robust navigation, significantly outperforming purely geometric and purely vision-based baselines in both efficiency and autonomy. Our results highlight the potential of vision foundation models to drive open-world robotic behaviors that are both semantically informed and geometrically grounded. Project Page: https://leggedrobotics.github.io/wildos/"},{"descriptionType":"Other","description":"28 pages, 16 figures, 2 tables"}],"geoLocations":[],"fundingReferences":[],"url":"https://arxiv.org/abs/2602.19308","contentUrl":null,"metadataVersion":0,"schemaVersion":"http://datacite.org/schema/kernel-4","source":"mds","isActive":true,"state":"findable","reason":null,"viewCount":0,"downloadCount":0,"referenceCount":0,"citationCount":0,"partCount":0,"partOfCount":0,"versionCount":0,"versionOfCount":0,"created":"2026-02-25T14:55:03Z","registered":"2026-02-25T14:55:04Z","published":null,"updated":"2026-02-25T14:55:04Z"},"relationships":{"client":{"data":{"id":"arxiv.content","type":"clients"}}}},{"id":"10.48550/arxiv.2602.19307","type":"dois","attributes":{"doi":"10.48550/arxiv.2602.19307","identifiers":[{"identifier":"2602.19307","identifierType":"arXiv"}],"creators":[{"nameType":"Personal","givenName":"Christian","familyName":"Candeago","name":"Candeago, Christian","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Paolo","familyName":"Da Rold","name":"Da Rold, Paolo","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Michele","familyName":"Grossi","name":"Grossi, Michele","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Pawel","familyName":"Horodecki","name":"Horodecki, Pawel","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Antonio","familyName":"Mandarino","name":"Mandarino, Antonio","affiliation":[],"nameIdentifiers":[]}],"titles":[{"title":"Learning partial transpose signatures in qubit ququart states from a few measurements"}],"publisher":"arXiv","container":{},"publicationYear":2026,"subjects":[{"subject":"Quantum Physics (quant-ph)","lang":"en","subjectScheme":"arXiv"},{"subject":"FOS: Physical sciences","subjectScheme":"Fields of Science and Technology (FOS)"},{"schemeUri":"http://www.oecd.org/science/inno/38235147.pdf","subject":"FOS: Physical sciences","subjectScheme":"Fields of Science and Technology (FOS)"}],"contributors":[],"dates":[{"date":"2026-02-22T19:00:02Z","dateType":"Submitted","dateInformation":"v1"},{"date":"2026-02-24T01:57:18Z","dateType":"Updated","dateInformation":"v1"},{"date":"2026-02","dateType":"Available","dateInformation":"v1"},{"date":"2026","dateType":"Issued"}],"language":null,"types":{"schemaOrg":"CreativeWork","resourceTypeGeneral":"Preprint","citeproc":"article","bibtex":"misc","ris":"GEN","resourceType":"Article"},"relatedIdentifiers":[],"relatedItems":[],"sizes":[],"formats":[],"version":"1","rightsList":[{"rightsIdentifierScheme":"SPDX","rightsUri":"https://creativecommons.org/licenses/by/4.0/legalcode","schemeUri":"https://spdx.org/licenses/","rights":"Creative Commons Attribution 4.0 International","rightsIdentifier":"cc-by-4.0"}],"descriptions":[{"descriptionType":"Abstract","description":"Higher-dimensional quantum systems are attracting interest for improving quantum protocol performance by increasing memory space. Characterizing quantum resources of such systems is fundamental but experimentally costly. We tackle the first non-trivial example: a qubit-ququart system, focusing on partial-transpose spectral classification. Entanglement distillation extracts maximally entangled states from noisy resources, but determining distillability typically requires full state tomography, experimentally prohibitive for high-dimensional systems. We explore a machine learning framework to classify distillable bipartite quantum states using fewer measurements than complete tomography. Our approach employs the PPT criterion, categorizing states by negative eigenvalues in the partial transpose. We use various ML algorithms, including Support Vector Machines, Random Forest, and Artificial Neural Networks, with features from fixed measurements and learnable observables. Results show learnable observables consistently outperform Collective Measurement Witnesses methods. While all models distinguish between non-distillable (PPT) and distillable (NPT) states, differentiating NPT subclasses remains challenging, underscoring the intricate Hilbert space geometry. This work provides an experimentally friendly tool for distillability verification in high-dimensional quantum systems without full state reconstruction"}],"geoLocations":[],"fundingReferences":[],"url":"https://arxiv.org/abs/2602.19307","contentUrl":null,"metadataVersion":0,"schemaVersion":"http://datacite.org/schema/kernel-4","source":"mds","isActive":true,"state":"findable","reason":null,"viewCount":0,"downloadCount":0,"referenceCount":0,"citationCount":0,"partCount":0,"partOfCount":0,"versionCount":0,"versionOfCount":0,"created":"2026-02-25T14:55:01Z","registered":"2026-02-25T14:55:02Z","published":null,"updated":"2026-02-25T14:55:02Z"},"relationships":{"client":{"data":{"id":"arxiv.content","type":"clients"}}}},{"id":"10.48550/arxiv.2602.19306","type":"dois","attributes":{"doi":"10.48550/arxiv.2602.19306","identifiers":[{"identifier":"2602.19306","identifierType":"arXiv"}],"creators":[{"nameType":"Personal","givenName":"Lorenzo","familyName":"Braccini","name":"Braccini, Lorenzo","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Alessio","familyName":"Serafini","name":"Serafini, Alessio","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Sougato","familyName":"Bose","name":"Bose, Sougato","affiliation":[],"nameIdentifiers":[]}],"titles":[{"title":"Mass-Independent Gravitationally Induced Entanglement"}],"publisher":"arXiv","container":{},"publicationYear":2026,"subjects":[{"subject":"Quantum Physics (quant-ph)","lang":"en","subjectScheme":"arXiv"},{"subject":"FOS: Physical sciences","subjectScheme":"Fields of Science and Technology (FOS)"},{"schemeUri":"http://www.oecd.org/science/inno/38235147.pdf","subject":"FOS: Physical sciences","subjectScheme":"Fields of Science and Technology (FOS)"}],"contributors":[],"dates":[{"date":"2026-02-22T18:58:57Z","dateType":"Submitted","dateInformation":"v1"},{"date":"2026-02-24T01:57:17Z","dateType":"Updated","dateInformation":"v1"},{"date":"2026-02","dateType":"Available","dateInformation":"v1"},{"date":"2026","dateType":"Issued"}],"language":null,"types":{"schemaOrg":"CreativeWork","resourceTypeGeneral":"Preprint","citeproc":"article","bibtex":"misc","ris":"GEN","resourceType":"Article"},"relatedIdentifiers":[],"relatedItems":[],"sizes":[],"formats":[],"version":"1","rightsList":[{"rightsUri":"http://arxiv.org/licenses/nonexclusive-distrib/1.0/","rights":"arXiv.org perpetual, non-exclusive license"}],"descriptions":[{"descriptionType":"Abstract","description":"We analytically solve the entangling quantum dynamics of two interacting Stern-Gerlach Interferometers~(SGI). Each SGI exploits an operator-valued force applied by a qubit to create and recombine a non-Gaussian state of matter. The entangling phase between the two qubits generated by the leading-order gravitational interaction of the massive degrees of freedom is found to be mass-independent, both for unitary and open dynamics, irrespective of the temperature and squeezing of the initial states. Further, we show that the solution of the four interferometric paths reveals that the mere presence of the interaction does not allow for a perfect recombination of the centre of mass. This second-order effect, alongside higher-order interaction terms, can be used to bound the mass from above and below, thus restricting the experiment's regime to mesoscopic masses. By solving the open dynamics which includes diffusion and dephasing with initial squeezed thermal states, the bounds are tightened by the inclusion of realistic experimental noise. We discuss diamagnetic levitated masses with embedded NV-centres as a specific physical implementation."},{"descriptionType":"Other","description":"13 pages, 5 figures; Any feedback is welcome"}],"geoLocations":[],"fundingReferences":[],"url":"https://arxiv.org/abs/2602.19306","contentUrl":null,"metadataVersion":0,"schemaVersion":"http://datacite.org/schema/kernel-4","source":"mds","isActive":true,"state":"findable","reason":null,"viewCount":0,"downloadCount":0,"referenceCount":0,"citationCount":0,"partCount":0,"partOfCount":0,"versionCount":0,"versionOfCount":0,"created":"2026-02-25T14:54:58Z","registered":"2026-02-25T14:54:59Z","published":null,"updated":"2026-02-25T14:54:59Z"},"relationships":{"client":{"data":{"id":"arxiv.content","type":"clients"}}}},{"id":"10.48550/arxiv.2602.19305","type":"dois","attributes":{"doi":"10.48550/arxiv.2602.19305","identifiers":[{"identifier":"2602.19305","identifierType":"arXiv"}],"creators":[{"nameType":"Personal","givenName":"Irisha M.","familyName":"Goswami","name":"Goswami, Irisha M.","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"D. G.","familyName":"Perera","name":"Perera, D. G.","affiliation":[],"nameIdentifiers":[]}],"titles":[{"title":"Closed-Loop Environmental Control System on Embedded Systems"}],"publisher":"arXiv","container":{},"publicationYear":2026,"subjects":[{"subject":"Hardware Architecture (cs.AR)","lang":"en","subjectScheme":"arXiv"},{"subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"},{"schemeUri":"http://www.oecd.org/science/inno/38235147.pdf","subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"}],"contributors":[],"dates":[{"date":"2026-02-22T18:57:59Z","dateType":"Submitted","dateInformation":"v1"},{"date":"2026-02-24T01:57:16Z","dateType":"Updated","dateInformation":"v1"},{"date":"2026-02","dateType":"Available","dateInformation":"v1"},{"date":"2026","dateType":"Issued"}],"language":null,"types":{"schemaOrg":"CreativeWork","resourceTypeGeneral":"Preprint","citeproc":"article","bibtex":"misc","ris":"GEN","resourceType":"Article"},"relatedIdentifiers":[],"relatedItems":[],"sizes":[],"formats":[],"version":"1","rightsList":[{"rightsIdentifierScheme":"SPDX","rightsUri":"https://creativecommons.org/licenses/by-nc-nd/4.0/legalcode","schemeUri":"https://spdx.org/licenses/","rights":"Creative Commons Attribution Non Commercial No Derivatives 4.0 International","rightsIdentifier":"cc-by-nc-nd-4.0"}],"descriptions":[{"descriptionType":"Abstract","description":"In this paper, our objective is to design, build, and verify a closed-loop environmental control system tailored for small-scale agriculture applications. This project aims to develop a low-cost, safety-critical embedded solution using the Nuvoton NUC140 microcontroller to automate temperature regulation. The goal was to mitigate crop yield losses caused by environmental fluctuations in a greenhouse. Our final implemented system successfully meets all design specifications, demonstrating robust temperature regulation through a PID control loop and ensuring hardware safety through galvanic isolation"},{"descriptionType":"Other","description":"19 pages, 6 figures"}],"geoLocations":[],"fundingReferences":[],"url":"https://arxiv.org/abs/2602.19305","contentUrl":null,"metadataVersion":0,"schemaVersion":"http://datacite.org/schema/kernel-4","source":"mds","isActive":true,"state":"findable","reason":null,"viewCount":0,"downloadCount":0,"referenceCount":0,"citationCount":0,"partCount":0,"partOfCount":0,"versionCount":0,"versionOfCount":0,"created":"2026-02-25T14:54:56Z","registered":"2026-02-25T14:54:57Z","published":null,"updated":"2026-02-25T14:54:57Z"},"relationships":{"client":{"data":{"id":"arxiv.content","type":"clients"}}}},{"id":"10.48550/arxiv.2602.19304","type":"dois","attributes":{"doi":"10.48550/arxiv.2602.19304","identifiers":[{"identifier":"2602.19304","identifierType":"arXiv"}],"creators":[{"nameType":"Personal","givenName":"Haojun","familyName":"Shi","name":"Shi, Haojun","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Suyu","familyName":"Ye","name":"Ye, Suyu","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Katherine M.","familyName":"Guerrerio","name":"Guerrerio, Katherine M.","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Jianzhi","familyName":"Shen","name":"Shen, Jianzhi","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Yifan","familyName":"Yin","name":"Yin, Yifan","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Daniel","familyName":"Khashabi","name":"Khashabi, Daniel","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Chien-Ming","familyName":"Huang","name":"Huang, Chien-Ming","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Tianmin","familyName":"Shu","name":"Shu, Tianmin","affiliation":[],"nameIdentifiers":[]}],"titles":[{"title":"Safe and Interpretable Multimodal Path Planning for Multi-Agent Cooperation"}],"publisher":"arXiv","container":{},"publicationYear":2026,"subjects":[{"subject":"Robotics (cs.RO)","lang":"en","subjectScheme":"arXiv"},{"subject":"Artificial Intelligence (cs.AI)","lang":"en","subjectScheme":"arXiv"},{"subject":"Human-Computer Interaction (cs.HC)","lang":"en","subjectScheme":"arXiv"},{"subject":"Multiagent Systems (cs.MA)","lang":"en","subjectScheme":"arXiv"},{"subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"},{"schemeUri":"http://www.oecd.org/science/inno/38235147.pdf","subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"}],"contributors":[],"dates":[{"date":"2026-02-22T18:57:07Z","dateType":"Submitted","dateInformation":"v1"},{"date":"2026-02-24T01:57:15Z","dateType":"Updated","dateInformation":"v1"},{"date":"2026-02","dateType":"Available","dateInformation":"v1"},{"date":"2026","dateType":"Issued"}],"language":null,"types":{"schemaOrg":"CreativeWork","resourceTypeGeneral":"Preprint","citeproc":"article","bibtex":"misc","ris":"GEN","resourceType":"Article"},"relatedIdentifiers":[],"relatedItems":[],"sizes":[],"formats":[],"version":"1","rightsList":[{"rightsIdentifierScheme":"SPDX","rightsUri":"https://creativecommons.org/licenses/by/4.0/legalcode","schemeUri":"https://spdx.org/licenses/","rights":"Creative Commons Attribution 4.0 International","rightsIdentifier":"cc-by-4.0"}],"descriptions":[{"descriptionType":"Abstract","description":"Successful cooperation among decentralized agents requires each agent to quickly adapt its plan to the behavior of other agents. In scenarios where agents cannot confidently predict one another's intentions and plans, language communication can be crucial for ensuring safety. In this work, we focus on path-level cooperation in which agents must adapt their paths to one another in order to avoid collisions or perform physical collaboration such as joint carrying. In particular, we propose a safe and interpretable multimodal path planning method, CaPE (Code as Path Editor), which generates and updates path plans for an agent based on the environment and language communication from other agents. CaPE leverages a vision-language model (VLM) to synthesize a path editing program verified by a model-based planner, grounding communication to path plan updates in a safe and interpretable way. We evaluate our approach in diverse simulated and real-world scenarios, including multi-robot and human-robot cooperation in autonomous driving, household, and joint carrying tasks. Experimental results demonstrate that CaPE can be integrated into different robotic systems as a plug-and-play module, greatly enhancing a robot's ability to align its plan to language communication from other robots or humans. We also show that the combination of the VLM-based path editing program synthesis and model-based planning safety enables robots to achieve open-ended cooperation while maintaining safety and interpretability."}],"geoLocations":[],"fundingReferences":[],"url":"https://arxiv.org/abs/2602.19304","contentUrl":null,"metadataVersion":0,"schemaVersion":"http://datacite.org/schema/kernel-4","source":"mds","isActive":true,"state":"findable","reason":null,"viewCount":0,"downloadCount":0,"referenceCount":0,"citationCount":0,"partCount":0,"partOfCount":0,"versionCount":0,"versionOfCount":0,"created":"2026-02-25T14:54:54Z","registered":"2026-02-25T14:54:54Z","published":null,"updated":"2026-02-25T14:54:54Z"},"relationships":{"client":{"data":{"id":"arxiv.content","type":"clients"}}}},{"id":"10.48550/arxiv.2602.19303","type":"dois","attributes":{"doi":"10.48550/arxiv.2602.19303","identifiers":[{"identifier":"2602.19303","identifierType":"arXiv"}],"creators":[{"nameType":"Personal","givenName":"Kirk","familyName":"Vanacore","name":"Vanacore, Kirk","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Ryan S.","familyName":"Baker","name":"Baker, Ryan S.","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Avery H.","familyName":"Closser","name":"Closser, Avery H.","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Jeremy","familyName":"Roschelle","name":"Roschelle, Jeremy","affiliation":[],"nameIdentifiers":[]}],"titles":[{"title":"The Path to Conversational AI Tutors: Integrating Tutoring Best Practices and Targeted Technologies to Produce Scalable AI Agents"}],"publisher":"arXiv","container":{},"publicationYear":2026,"subjects":[{"subject":"Human-Computer Interaction (cs.HC)","lang":"en","subjectScheme":"arXiv"},{"subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"},{"schemeUri":"http://www.oecd.org/science/inno/38235147.pdf","subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"}],"contributors":[],"dates":[{"date":"2026-02-22T18:50:50Z","dateType":"Submitted","dateInformation":"v1"},{"date":"2026-02-24T01:57:13Z","dateType":"Updated","dateInformation":"v1"},{"date":"2026-02","dateType":"Available","dateInformation":"v1"},{"date":"2026","dateType":"Issued"}],"language":null,"types":{"schemaOrg":"CreativeWork","resourceTypeGeneral":"Preprint","citeproc":"article","bibtex":"misc","ris":"GEN","resourceType":"Article"},"relatedIdentifiers":[],"relatedItems":[],"sizes":[],"formats":[],"version":"1","rightsList":[{"rightsIdentifierScheme":"SPDX","rightsUri":"https://creativecommons.org/licenses/by/4.0/legalcode","schemeUri":"https://spdx.org/licenses/","rights":"Creative Commons Attribution 4.0 International","rightsIdentifier":"cc-by-4.0"}],"descriptions":[{"descriptionType":"Abstract","description":"The emergence of generative AI has accelerated the development of conversational tutoring systems that interact with students through natural language dialogue. Unlike prior intelligent tutoring systems (ITS), which largely function as adaptive and interactive problem sets with feedback and hints, conversational tutors hold the potential to simulate high-quality human tutoring by engaging with students' thoughts, questions, and misconceptions in real time. While some previous ITS, such as AutoTutor, could respond conversationally, they were expensive to author and lacked a full range of conversational ability. Generative AI has changed the capacity of ITS to engage conversationally. However, realizing the full potential of conversational tutors requires careful consideration of what research on human tutoring and ITS has already established, while also unpacking what new research will be needed. This paper synthesizes tenets of successful human tutoring, lessons learned from legacy ITS, and emerging work on conversational AI tutors. We use a keep, change, center, study framework for guiding the design of conversational tutoring. We argue that systems should keep proven methods from prior ITS, such as knowledge tracing and affect detection; change how tutoring is delivered by leveraging generative AI for dynamic content generation and dialogic scaffolding; and center opportunities for meaning-making, student agency, and granular diagnosis of reasoning. Finally, we identify areas requiring further study, including efficacy testing, student experience, and integration with human instruction. By synthesizing insights from human tutoring, legacy ITS, and emerging generative AI technologies, this paper outlines a research agenda for developing conversational tutors that are scalable, pedagogically effective, and responsive to the social and motivational dimensions of learning."}],"geoLocations":[],"fundingReferences":[],"url":"https://arxiv.org/abs/2602.19303","contentUrl":null,"metadataVersion":0,"schemaVersion":"http://datacite.org/schema/kernel-4","source":"mds","isActive":true,"state":"findable","reason":null,"viewCount":0,"downloadCount":0,"referenceCount":0,"citationCount":0,"partCount":0,"partOfCount":0,"versionCount":0,"versionOfCount":0,"created":"2026-02-25T14:54:51Z","registered":"2026-02-25T14:54:52Z","published":null,"updated":"2026-02-25T14:54:52Z"},"relationships":{"client":{"data":{"id":"arxiv.content","type":"clients"}}}},{"id":"10.48550/arxiv.2602.19301","type":"dois","attributes":{"doi":"10.48550/arxiv.2602.19301","identifiers":[{"identifier":"2602.19301","identifierType":"arXiv"}],"creators":[{"nameType":"Personal","givenName":"Agniva","familyName":"Roychowdhury","name":"Roychowdhury, Agniva","affiliation":[],"nameIdentifiers":[]}],"titles":[{"title":"Parameter Estimation Limits in Blazars"}],"publisher":"arXiv","container":{},"publicationYear":2026,"subjects":[{"subject":"High Energy Astrophysical Phenomena (astro-ph.HE)","lang":"en","subjectScheme":"arXiv"},{"subject":"Cosmology and Nongalactic Astrophysics (astro-ph.CO)","lang":"en","subjectScheme":"arXiv"},{"subject":"Data Analysis, Statistics and Probability (physics.data-an)","lang":"en","subjectScheme":"arXiv"},{"subject":"FOS: Physical sciences","subjectScheme":"Fields of Science and Technology (FOS)"},{"schemeUri":"http://www.oecd.org/science/inno/38235147.pdf","subject":"FOS: Physical sciences","subjectScheme":"Fields of Science and Technology (FOS)"}],"contributors":[],"dates":[{"date":"2026-02-22T18:41:21Z","dateType":"Submitted","dateInformation":"v1"},{"date":"2026-02-24T01:57:04Z","dateType":"Updated","dateInformation":"v1"},{"date":"2026-02","dateType":"Available","dateInformation":"v1"},{"date":"2026","dateType":"Issued"}],"language":null,"types":{"schemaOrg":"CreativeWork","resourceTypeGeneral":"Preprint","citeproc":"article","bibtex":"misc","ris":"GEN","resourceType":"Article"},"relatedIdentifiers":[],"relatedItems":[],"sizes":[],"formats":[],"version":"1","rightsList":[{"rightsUri":"http://arxiv.org/licenses/nonexclusive-distrib/1.0/","rights":"arXiv.org perpetual, non-exclusive license"}],"descriptions":[{"descriptionType":"Abstract","description":"Parameter degeneracy in blazar spectral energy distributions (SEDs) is known but rarely quantified. This paper introduces a Fisher Information approach to determine theoretical limits to information extraction in the context of one-zone models. By evaluating the total Fisher Information by varying $δ$, $B$, $p$, $γ_{\\rm min}$ and $γ_{\\rm max}$, we find that EC models encode Fisher information $\\gtrsim10^4$ times less than that in SSC models, establishing differences in limits of physical information extraction even in the case of perfect sampling. Moreover, the Fisher information in both SSC and EC models exhibit strong fluctuations across the parameter space, but since the magnitudes are orders of magnitude lower in EC, limits of parameter inference are expected to be worse in FSRQ SEDs than BL Lacs. We also find that the Doppler factor $δ$ carries at least $10^{2-3}$ more Fisher information than that for $p$ and $B$ in both EC and SSC, making $δ$ the most constrained SED parameter. Applying our Fisher Information motivated framework to real flaring SEDs of Flat Spectrum Radio Quasars (FSRQs) CTA 102 and 3C 279, we show that mild variations in $δ$ and $p$ can appreciably produce the flaring SEDs starting from the quiescent model, while two other flares in 3C 279 simple geometric and spectral considerations cannot reproduce the flares, reducing the efficacy of one-zone models. We propose that time-resolved SED models are indispensable to constraining physical parameters in EC-dominated blazars."},{"descriptionType":"Other","description":"11 pages, 7 figures; submitted to ApJL, comments welcome"}],"geoLocations":[],"fundingReferences":[],"url":"https://arxiv.org/abs/2602.19301","contentUrl":null,"metadataVersion":0,"schemaVersion":"http://datacite.org/schema/kernel-4","source":"mds","isActive":true,"state":"findable","reason":null,"viewCount":0,"downloadCount":0,"referenceCount":0,"citationCount":0,"partCount":0,"partOfCount":0,"versionCount":0,"versionOfCount":0,"created":"2026-02-25T14:54:46Z","registered":"2026-02-25T14:54:47Z","published":null,"updated":"2026-02-25T14:54:47Z"},"relationships":{"client":{"data":{"id":"arxiv.content","type":"clients"}}}},{"id":"10.48550/arxiv.2602.19298","type":"dois","attributes":{"doi":"10.48550/arxiv.2602.19298","identifiers":[{"identifier":"2602.19298","identifierType":"arXiv"}],"creators":[{"nameType":"Personal","givenName":"Nolan","familyName":"Brady","name":"Brady, Nolan","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Tom","familyName":"Yeh","name":"Yeh, Tom","affiliation":[],"nameIdentifiers":[]}],"titles":[{"title":"ALPACA: A Reinforcement Learning Environment for Medication Repurposing and Treatment Optimization in Alzheimer's Disease"}],"publisher":"arXiv","container":{},"publicationYear":2026,"subjects":[{"subject":"Artificial Intelligence (cs.AI)","lang":"en","subjectScheme":"arXiv"},{"subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"},{"schemeUri":"http://www.oecd.org/science/inno/38235147.pdf","subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"}],"contributors":[],"dates":[{"date":"2026-02-22T18:22:14Z","dateType":"Submitted","dateInformation":"v1"},{"date":"2026-02-24T01:56:40Z","dateType":"Updated","dateInformation":"v1"},{"date":"2026-02","dateType":"Available","dateInformation":"v1"},{"date":"2026","dateType":"Issued"}],"language":null,"types":{"schemaOrg":"CreativeWork","resourceTypeGeneral":"Preprint","citeproc":"article","bibtex":"misc","ris":"GEN","resourceType":"Article"},"relatedIdentifiers":[],"relatedItems":[],"sizes":[],"formats":[],"version":"1","rightsList":[{"rightsUri":"http://arxiv.org/licenses/nonexclusive-distrib/1.0/","rights":"arXiv.org perpetual, non-exclusive license"}],"descriptions":[{"descriptionType":"Abstract","description":"Evaluating personalized, sequential treatment strategies for Alzheimer's disease (AD) using clinical trials is often impractical due to long disease horizons and substantial inter-patient heterogeneity. To address these constraints, we present the Alzheimer's Learning Platform for Adaptive Care Agents (ALPACA), an open-source, Gym-compatible reinforcement learning (RL) environment for systematically exploring personalized treatment strategies using existing therapies. ALPACA is powered by the Continuous Action-conditioned State Transitions (CAST) model trained on longitudinal trajectories from the Alzheimer's Disease Neuroimaging Initiative (ADNI), enabling medication-conditioned simulation of disease progression under alternative treatment decisions. We show that CAST autoregressively generates realistic medication-conditioned trajectories and that RL policies trained in ALPACA outperform no-treatment and behavior-cloned clinician baselines on memory-related outcomes. Interpretability analyses further indicated that the learned policies relied on clinically meaningful patient features when selecting actions. Overall, ALPACA provides a reusable in silico testbed for studying individualized sequential treatment decision-making for AD."}],"geoLocations":[],"fundingReferences":[],"url":"https://arxiv.org/abs/2602.19298","contentUrl":null,"metadataVersion":0,"schemaVersion":"http://datacite.org/schema/kernel-4","source":"mds","isActive":true,"state":"findable","reason":null,"viewCount":0,"downloadCount":0,"referenceCount":0,"citationCount":0,"partCount":0,"partOfCount":0,"versionCount":0,"versionOfCount":0,"created":"2026-02-25T14:54:39Z","registered":"2026-02-25T14:54:40Z","published":null,"updated":"2026-02-25T14:54:40Z"},"relationships":{"client":{"data":{"id":"arxiv.content","type":"clients"}}}},{"id":"10.48550/arxiv.2602.19297","type":"dois","attributes":{"doi":"10.48550/arxiv.2602.19297","identifiers":[{"identifier":"2602.19297","identifierType":"arXiv"}],"creators":[{"nameType":"Personal","givenName":"Jasper","familyName":"Davidson","name":"Davidson, Jasper","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Skylar","familyName":"Stockham","name":"Stockham, Skylar","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Allen","familyName":"Boston","name":"Boston, Allen","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Ashton","familyName":"Snelgrove","name":"Snelgrove, Ashton","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Valerio","familyName":"Tenace","name":"Tenace, Valerio","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Pierre-Emmanuel","familyName":"Gaillardon","name":"Gaillardon, Pierre-Emmanuel","affiliation":[],"nameIdentifiers":[]}],"titles":[{"title":"Automated Generation of Microfluidic Netlists using Large Language Models"}],"publisher":"arXiv","container":{},"publicationYear":2026,"subjects":[{"subject":"Artificial Intelligence (cs.AI)","lang":"en","subjectScheme":"arXiv"},{"subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"},{"schemeUri":"http://www.oecd.org/science/inno/38235147.pdf","subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"}],"contributors":[],"dates":[{"date":"2026-02-22T18:14:10Z","dateType":"Submitted","dateInformation":"v1"},{"date":"2026-02-24T01:56:34Z","dateType":"Updated","dateInformation":"v1"},{"date":"2026-02-24T03:03:21Z","dateType":"Submitted","dateInformation":"v2"},{"date":"2026-02-25T01:17:56Z","dateType":"Updated","dateInformation":"v2"},{"date":"2026-02","dateType":"Available","dateInformation":"v1"},{"date":"2026","dateType":"Issued"}],"language":null,"types":{"schemaOrg":"CreativeWork","resourceTypeGeneral":"Preprint","citeproc":"article","bibtex":"misc","ris":"GEN","resourceType":"Article"},"relatedIdentifiers":[],"relatedItems":[],"sizes":[],"formats":[],"version":"2","rightsList":[{"rightsUri":"http://arxiv.org/licenses/nonexclusive-distrib/1.0/","rights":"arXiv.org perpetual, non-exclusive license"}],"descriptions":[{"descriptionType":"Abstract","description":"Microfluidic devices have emerged as powerful tools in various laboratory applications, but the complexity of their design limits accessibility for many practitioners. While progress has been made in microfluidic design automation (MFDA), a practical and intuitive solution is still needed to connect microfluidic practitioners with MFDA techniques. This work introduces the first practical application of large language models (LLMs) in this context, providing a preliminary demonstration. Building on prior research in hardware description language (HDL) code generation with LLMs, we propose an initial methodology to convert natural language microfluidic device specifications into system-level structural Verilog netlists. We demonstrate the feasibility of our approach by generating structural netlists for practical benchmarks representative of typical microfluidic designs with correct functional flow and an average syntactical accuracy of 88%."}],"geoLocations":[],"fundingReferences":[],"url":"https://arxiv.org/abs/2602.19297","contentUrl":null,"metadataVersion":0,"schemaVersion":"http://datacite.org/schema/kernel-4","source":"mds","isActive":true,"state":"findable","reason":null,"viewCount":0,"downloadCount":0,"referenceCount":0,"citationCount":0,"partCount":0,"partOfCount":0,"versionCount":0,"versionOfCount":0,"created":"2026-02-25T14:54:37Z","registered":"2026-02-25T14:54:37Z","published":null,"updated":"2026-02-25T14:54:37Z"},"relationships":{"client":{"data":{"id":"arxiv.content","type":"clients"}}}},{"id":"10.48550/arxiv.2602.19295","type":"dois","attributes":{"doi":"10.48550/arxiv.2602.19295","identifiers":[{"identifier":"2602.19295","identifierType":"arXiv"}],"creators":[{"nameType":"Personal","givenName":"Robert","familyName":"Amevor","name":"Amevor, Robert","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Dennis","familyName":"Baidoo","name":"Baidoo, Dennis","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Emmanuel","familyName":"Kubuafor","name":"Kubuafor, Emmanuel","affiliation":[],"nameIdentifiers":[]}],"titles":[{"title":"Time-Varying Hazard Patterns and Co-Mutation Profiles of KRAS G12C and G12D in Real-World NSCLC"}],"publisher":"arXiv","container":{},"publicationYear":2026,"subjects":[{"subject":"Quantitative Methods (q-bio.QM)","lang":"en","subjectScheme":"arXiv"},{"subject":"Applications (stat.AP)","lang":"en","subjectScheme":"arXiv"},{"subject":"Methodology (stat.ME)","lang":"en","subjectScheme":"arXiv"},{"subject":"FOS: Biological sciences","subjectScheme":"Fields of Science and Technology (FOS)"},{"schemeUri":"http://www.oecd.org/science/inno/38235147.pdf","subject":"FOS: Biological sciences","subjectScheme":"Fields of Science and Technology (FOS)"},{"subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"},{"schemeUri":"http://www.oecd.org/science/inno/38235147.pdf","subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"}],"contributors":[],"dates":[{"date":"2026-02-22T18:07:58Z","dateType":"Submitted","dateInformation":"v1"},{"date":"2026-02-24T01:56:30Z","dateType":"Updated","dateInformation":"v1"},{"date":"2026-02","dateType":"Available","dateInformation":"v1"},{"date":"2026","dateType":"Issued"}],"language":null,"types":{"schemaOrg":"CreativeWork","resourceTypeGeneral":"Preprint","citeproc":"article","bibtex":"misc","ris":"GEN","resourceType":"Article"},"relatedIdentifiers":[],"relatedItems":[],"sizes":[],"formats":[],"version":"1","rightsList":[{"rightsIdentifierScheme":"SPDX","rightsUri":"https://creativecommons.org/licenses/by/4.0/legalcode","schemeUri":"https://spdx.org/licenses/","rights":"Creative Commons Attribution 4.0 International","rightsIdentifier":"cc-by-4.0"}],"descriptions":[{"descriptionType":"Abstract","description":"Background: KRAS mutations are the largest oncogenic subset in NSCLC. While KRAS G12C is now targetable, no approved therapies exist for G12D. We examined time-to-next-treatment (TTNT) and overall survival (OS) differences between G12C and G12D, allowing for time-varying hazard effects. Methods: De-identified data from AACR Project GENIE BPC NSCLC v2.0-public were analyzed. TTNT served as a real-world surrogate for progression-free survival. Co-mutations (TP53, STK11, KEAP1, SMARCA4, MET), TMB, and PD-L1 were harmonized. Kaplan-Meier, multivariable Cox, and a pre-specified piecewise Cox model (split at median TTNT = 23 months) were applied. Schoenfeld residuals assessed proportional hazards; bootstrap resampling (B=1000) evaluated stability. Results: Among 162 TTNT-evaluable patients (G12C n=130; G12D n=32), median TTNT was 28.6 versus 32.0 months (log-rank p=0.79). Adjusted Cox regression showed no overall hazard difference (HR=0.85; 95% CI 0.53-1.37; p=0.50), but Schoenfeld testing indicated borderline non-proportionality (p=0.053). Piecewise Cox modeling revealed time-varying effects: early TTNT hazard favored G12D (HR=0.41; 95% CI 0.17-0.97; p=0.043) with significant KRAS x period interaction (HR=3.33; p=0.021) and late-period attenuation (HR=1.38; 95% CI 0.77-2.47; p=0.285). Bootstrap resampling confirmed this pattern (median HRearly=0.39; HRlate=1.41). Among 278 OS-evaluable patients (133 deaths), G12D showed improved OS (adjusted HR=0.63; 95% CI 0.39-0.99; p=0.048). G12C tumors exhibited higher TMB (9.79 vs 7.83 mut/Mb; p=0.002) and greater STK11/KEAP1 enrichment. Conclusions: KRAS G12D demonstrated early TTNT advantage and improved OS. Late-period TTNT differences were non-significant (post-hoc power: 12.3%). These exploratory findings require validation in larger cohorts but support allele-specific therapeutic development for G12D."}],"geoLocations":[],"fundingReferences":[],"url":"https://arxiv.org/abs/2602.19295","contentUrl":null,"metadataVersion":0,"schemaVersion":"http://datacite.org/schema/kernel-4","source":"mds","isActive":true,"state":"findable","reason":null,"viewCount":0,"downloadCount":0,"referenceCount":0,"citationCount":0,"partCount":0,"partOfCount":0,"versionCount":0,"versionOfCount":0,"created":"2026-02-25T14:54:32Z","registered":"2026-02-25T14:54:32Z","published":null,"updated":"2026-02-25T14:54:32Z"},"relationships":{"client":{"data":{"id":"arxiv.content","type":"clients"}}}},{"id":"10.48550/arxiv.2602.19294","type":"dois","attributes":{"doi":"10.48550/arxiv.2602.19294","identifiers":[{"identifier":"2602.19294","identifierType":"arXiv"}],"creators":[{"nameType":"Personal","givenName":"Betül","familyName":"Karagöz","name":"Karagöz, Betül","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Filippo","familyName":"Ricca","name":"Ricca, Filippo","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Matteo","familyName":"Biagiola","name":"Biagiola, Matteo","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Andrea","familyName":"Stocco","name":"Stocco, Andrea","affiliation":[],"nameIdentifiers":[]}],"titles":[{"title":"Towards Automated Page Object Generation for Web Testing using Large Language Models"}],"publisher":"arXiv","container":{},"publicationYear":2026,"subjects":[{"subject":"Software Engineering (cs.SE)","lang":"en","subjectScheme":"arXiv"},{"subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"},{"schemeUri":"http://www.oecd.org/science/inno/38235147.pdf","subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"}],"contributors":[],"dates":[{"date":"2026-02-22T18:06:57Z","dateType":"Submitted","dateInformation":"v1"},{"date":"2026-02-24T01:56:29Z","dateType":"Updated","dateInformation":"v1"},{"date":"2026-02","dateType":"Available","dateInformation":"v1"},{"date":"2026","dateType":"Issued"}],"language":null,"types":{"schemaOrg":"CreativeWork","resourceTypeGeneral":"Preprint","citeproc":"article","bibtex":"misc","ris":"GEN","resourceType":"Article"},"relatedIdentifiers":[],"relatedItems":[],"sizes":[],"formats":[],"version":"1","rightsList":[{"rightsIdentifierScheme":"SPDX","rightsUri":"https://creativecommons.org/licenses/by-sa/4.0/legalcode","schemeUri":"https://spdx.org/licenses/","rights":"Creative Commons Attribution Share Alike 4.0 International","rightsIdentifier":"cc-by-sa-4.0"}],"descriptions":[{"descriptionType":"Abstract","description":"Page Objects (POs) are a widely adopted design pattern for improving the maintainability and scalability of automated end-to-end web tests. However, creating and maintaining POs is still largely a manual, labor-intensive activity, while automated solutions have seen limited practical adoption. In this context, the potential of Large Language Models (LLMs) for these tasks has remained largely unexplored. This paper presents an empirical study on the feasibility of using LLMs, specifically GPT-4o and DeepSeek Coder, to automatically generate POs for web testing. We evaluate the generated artifacts on an existing benchmark of five web applications for which manually written POs are available (the ground truth), focusing on accuracy (i.e., the proportion of ground truth elements correctly identified) and element recognition rate (i.e., the proportion of ground truth elements correctly identified or marked for modification). Our results show that LLMs can generate syntactically correct and functionally useful POs with accuracy values ranging from 32.6% to 54.0% and element recognition rate exceeding 70% in most cases. Our study contributes the first systematic evaluation of LLMs strengths and open challenges for automated PO generation, and provides directions for further research on integrating LLMs into practical testing workflows."},{"descriptionType":"Other","description":"In proceedings of the 19th IEEE International Conference on Software Testing, Verification and Validation 2026 (ICST '26)"}],"geoLocations":[],"fundingReferences":[],"url":"https://arxiv.org/abs/2602.19294","contentUrl":null,"metadataVersion":0,"schemaVersion":"http://datacite.org/schema/kernel-4","source":"mds","isActive":true,"state":"findable","reason":null,"viewCount":0,"downloadCount":0,"referenceCount":0,"citationCount":0,"partCount":0,"partOfCount":0,"versionCount":0,"versionOfCount":0,"created":"2026-02-25T14:54:29Z","registered":"2026-02-25T14:54:30Z","published":null,"updated":"2026-02-25T14:54:30Z"},"relationships":{"client":{"data":{"id":"arxiv.content","type":"clients"}}}},{"id":"10.48550/arxiv.2602.19293","type":"dois","attributes":{"doi":"10.48550/arxiv.2602.19293","identifiers":[{"identifier":"2602.19293","identifierType":"arXiv"}],"creators":[{"nameType":"Personal","givenName":"Daniel","familyName":"Carranza","name":"Carranza, Daniel","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Chris","familyName":"Kapulkin","name":"Kapulkin, Chris","affiliation":[],"nameIdentifiers":[]}],"titles":[{"title":"Discrete homotopy hypothesis for n-types"}],"publisher":"arXiv","container":{},"publicationYear":2026,"subjects":[{"subject":"Algebraic Topology (math.AT)","lang":"en","subjectScheme":"arXiv"},{"subject":"Combinatorics (math.CO)","lang":"en","subjectScheme":"arXiv"},{"subject":"Category Theory (math.CT)","lang":"en","subjectScheme":"arXiv"},{"subject":"FOS: Mathematics","subjectScheme":"Fields of Science and Technology (FOS)"},{"schemeUri":"http://www.oecd.org/science/inno/38235147.pdf","subject":"FOS: Mathematics","subjectScheme":"Fields of Science and Technology (FOS)"},{"subject":"Primary: 55U35, 05C10, secondary: 18N45, 18N55, 55U40","lang":"en","subjectScheme":"MSC"}],"contributors":[],"dates":[{"date":"2026-02-22T17:59:53Z","dateType":"Submitted","dateInformation":"v1"},{"date":"2026-02-24T01:56:17Z","dateType":"Updated","dateInformation":"v1"},{"date":"2026-02","dateType":"Available","dateInformation":"v1"},{"date":"2026","dateType":"Issued"}],"language":null,"types":{"schemaOrg":"CreativeWork","resourceTypeGeneral":"Preprint","citeproc":"article","bibtex":"misc","ris":"GEN","resourceType":"Article"},"relatedIdentifiers":[],"relatedItems":[],"sizes":[],"formats":[],"version":"1","rightsList":[{"rightsUri":"http://arxiv.org/licenses/nonexclusive-distrib/1.0/","rights":"arXiv.org perpetual, non-exclusive license"}],"descriptions":[{"descriptionType":"Abstract","description":"We show that discrete and classical homotopy theories are equivalent after localizing at n-equivalences for any non-negative integer n. By constructing an explicit homotopy inverse to the graph nerve functor associating an n-fibrant cubical set to a graph, we are also able to give explicit computations of several previously unknown discrete homotopy groups of boundaries of cubes and suspensions of cycles."},{"descriptionType":"Other","description":"67 pages; comments welcome!"}],"geoLocations":[],"fundingReferences":[],"url":"https://arxiv.org/abs/2602.19293","contentUrl":null,"metadataVersion":0,"schemaVersion":"http://datacite.org/schema/kernel-4","source":"mds","isActive":true,"state":"findable","reason":null,"viewCount":0,"downloadCount":0,"referenceCount":0,"citationCount":0,"partCount":0,"partOfCount":0,"versionCount":0,"versionOfCount":0,"created":"2026-02-25T14:54:27Z","registered":"2026-02-25T14:54:28Z","published":null,"updated":"2026-02-25T14:54:28Z"},"relationships":{"client":{"data":{"id":"arxiv.content","type":"clients"}}}},{"id":"10.48550/arxiv.2602.19291","type":"dois","attributes":{"doi":"10.48550/arxiv.2602.19291","identifiers":[{"identifier":"2602.19291","identifierType":"arXiv"}],"creators":[{"nameType":"Personal","givenName":"Silvia","familyName":"Trinczek","name":"Trinczek, Silvia","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Felix I.","familyName":"Parra","name":"Parra, Felix I.","affiliation":[],"nameIdentifiers":[]}],"titles":[{"title":"Neoclassical transport and profile prediction in transport barriers"}],"publisher":"arXiv","container":{},"publicationYear":2026,"subjects":[{"subject":"Plasma Physics (physics.plasm-ph)","lang":"en","subjectScheme":"arXiv"},{"subject":"FOS: Physical sciences","subjectScheme":"Fields of Science and Technology (FOS)"},{"schemeUri":"http://www.oecd.org/science/inno/38235147.pdf","subject":"FOS: Physical sciences","subjectScheme":"Fields of Science and Technology (FOS)"}],"contributors":[],"dates":[{"date":"2026-02-22T17:57:51Z","dateType":"Submitted","dateInformation":"v1"},{"date":"2026-02-24T01:56:15Z","dateType":"Updated","dateInformation":"v1"},{"date":"2026-02","dateType":"Available","dateInformation":"v1"},{"date":"2026","dateType":"Issued"}],"language":null,"types":{"schemaOrg":"CreativeWork","resourceTypeGeneral":"Preprint","citeproc":"article","bibtex":"misc","ris":"GEN","resourceType":"Article"},"relatedIdentifiers":[],"relatedItems":[],"sizes":[],"formats":[],"version":"1","rightsList":[{"rightsUri":"http://arxiv.org/licenses/nonexclusive-distrib/1.0/","rights":"arXiv.org perpetual, non-exclusive license"}],"descriptions":[{"descriptionType":"Abstract","description":"Strong gradient regions in tokamaks, such as the pedestal or internal transport barriers, are regions of reduced turbulence where neoclassical transport can play a dominant role. However, standard neoclassical transport theory assumes that the gradient length scales of density, temperature, and potential are of the order of the system size. In the pedestal, gradient length scales are much shorter and are measured to be of the order of the ion poloidal gyroradius. We present an extension of neoclassical theory that is applicable in transport barriers of large aspect ratio tokamaks. We show that particle and momentum transport are connected in such a way that a source of parallel momentum can drive a significant neoclassical ion particle flux. In strong gradient regions, density, electric potential, mean parallel flow, and ion temperature are shown to no longer be flux functions. Instead, they have a small but important poloidally varying piece that modifies the transport equations to lowest order. This introduces a nonlinearity in the transport problem through the coupling with quasineutrality that yields multiple co-existing solutions when solving for the plasma profiles. The different solutions could be connected to low and high transport states and jumps between solutions could be an indication of H-L back-transitions."},{"descriptionType":"Other","description":"9 pages, 3 figures"}],"geoLocations":[],"fundingReferences":[],"url":"https://arxiv.org/abs/2602.19291","contentUrl":null,"metadataVersion":0,"schemaVersion":"http://datacite.org/schema/kernel-4","source":"mds","isActive":true,"state":"findable","reason":null,"viewCount":0,"downloadCount":0,"referenceCount":0,"citationCount":0,"partCount":0,"partOfCount":0,"versionCount":0,"versionOfCount":0,"created":"2026-02-25T14:54:22Z","registered":"2026-02-25T14:54:23Z","published":null,"updated":"2026-02-25T14:54:23Z"},"relationships":{"client":{"data":{"id":"arxiv.content","type":"clients"}}}},{"id":"10.48550/arxiv.2602.19290","type":"dois","attributes":{"doi":"10.48550/arxiv.2602.19290","identifiers":[{"identifier":"2602.19290","identifierType":"arXiv"}],"creators":[{"nameType":"Personal","givenName":"Kyle","familyName":"Schindl","name":"Schindl, Kyle","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Larry","familyName":"Wasserman","name":"Wasserman, Larry","affiliation":[],"nameIdentifiers":[]}],"titles":[{"title":"Distributional Discontinuity Design"}],"publisher":"arXiv","container":{},"publicationYear":2026,"subjects":[{"subject":"Methodology (stat.ME)","lang":"en","subjectScheme":"arXiv"},{"subject":"Econometrics (econ.EM)","lang":"en","subjectScheme":"arXiv"},{"subject":"Statistics Theory (math.ST)","lang":"en","subjectScheme":"arXiv"},{"subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"},{"schemeUri":"http://www.oecd.org/science/inno/38235147.pdf","subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"},{"subject":"FOS: Economics and business","subjectScheme":"Fields of Science and Technology (FOS)"},{"schemeUri":"http://www.oecd.org/science/inno/38235147.pdf","subject":"FOS: Economics and business","subjectScheme":"Fields of Science and Technology (FOS)"},{"subject":"FOS: Mathematics","subjectScheme":"Fields of Science and Technology (FOS)"},{"schemeUri":"http://www.oecd.org/science/inno/38235147.pdf","subject":"FOS: Mathematics","subjectScheme":"Fields of Science and Technology (FOS)"}],"contributors":[],"dates":[{"date":"2026-02-22T17:57:25Z","dateType":"Submitted","dateInformation":"v1"},{"date":"2026-02-24T01:56:14Z","dateType":"Updated","dateInformation":"v1"},{"date":"2026-02","dateType":"Available","dateInformation":"v1"},{"date":"2026","dateType":"Issued"}],"language":null,"types":{"schemaOrg":"CreativeWork","resourceTypeGeneral":"Preprint","citeproc":"article","bibtex":"misc","ris":"GEN","resourceType":"Article"},"relatedIdentifiers":[],"relatedItems":[],"sizes":[],"formats":[],"version":"1","rightsList":[{"rightsIdentifierScheme":"SPDX","rightsUri":"https://creativecommons.org/licenses/by/4.0/legalcode","schemeUri":"https://spdx.org/licenses/","rights":"Creative Commons Attribution 4.0 International","rightsIdentifier":"cc-by-4.0"}],"descriptions":[{"descriptionType":"Abstract","description":"Regression discontinuity and kink designs are typically analyzed through mean effects, even when treatment changes the shape of the entire outcome distribution. To address this, we introduce distributional discontinuity designs, a framework for estimating causal effects for a scalar outcome at the boundary of a discontinuity in treatment assignment. Our estimand is the Wasserstein distance between limiting conditional outcome distributions; a single scale-interpretable measure of distribution shift. We show that this weakly bounds the average treatment effect, where equality holds if and only if the treatment effect is purely additive; thus, departure from equality measures effect heterogeneity. To further encode effect heterogeneity we show that the Wasserstein distance admits an orthogonal decomposition into squared differences in $L$-moments, thereby quantifying the contribution from location, scale, skewness, and higher-order shape components to the overall distributional distance. Next, we extend this framework to distributional kink designs by evaluating the Wasserstein derivative at a policy kink; this describes the flow of probability mass through the kink. In the case of fuzzy kink designs, we derive new identification results. Finally, we apply our methods on real data by re-analyzing two natural experiments to compare our distributional effects to traditional causal estimands."}],"geoLocations":[],"fundingReferences":[],"url":"https://arxiv.org/abs/2602.19290","contentUrl":null,"metadataVersion":0,"schemaVersion":"http://datacite.org/schema/kernel-4","source":"mds","isActive":true,"state":"findable","reason":null,"viewCount":0,"downloadCount":0,"referenceCount":0,"citationCount":0,"partCount":0,"partOfCount":0,"versionCount":0,"versionOfCount":0,"created":"2026-02-25T14:54:20Z","registered":"2026-02-25T14:54:20Z","published":null,"updated":"2026-02-25T14:54:20Z"},"relationships":{"client":{"data":{"id":"arxiv.content","type":"clients"}}}},{"id":"10.48550/arxiv.2602.19289","type":"dois","attributes":{"doi":"10.48550/arxiv.2602.19289","identifiers":[{"identifier":"2602.19289","identifierType":"arXiv"}],"creators":[{"nameType":"Personal","givenName":"Jiangjie","familyName":"Qiu","name":"Qiu, Jiangjie","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Wentao","familyName":"Li","name":"Li, Wentao","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Honghao","familyName":"Chen","name":"Chen, Honghao","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Leyi","familyName":"Zhao","name":"Zhao, Leyi","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Xiaonan","familyName":"Wang","name":"Wang, Xiaonan","affiliation":[],"nameIdentifiers":[]}],"titles":[{"title":"AdsorbFlow: energy-conditioned flow matching enables fast and realistic adsorbate placement"}],"publisher":"arXiv","container":{},"publicationYear":2026,"subjects":[{"subject":"Machine Learning (cs.LG)","lang":"en","subjectScheme":"arXiv"},{"subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"},{"schemeUri":"http://www.oecd.org/science/inno/38235147.pdf","subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"}],"contributors":[],"dates":[{"date":"2026-02-22T17:53:53Z","dateType":"Submitted","dateInformation":"v1"},{"date":"2026-02-24T01:56:13Z","dateType":"Updated","dateInformation":"v1"},{"date":"2026-02","dateType":"Available","dateInformation":"v1"},{"date":"2026","dateType":"Issued"}],"language":null,"types":{"schemaOrg":"CreativeWork","resourceTypeGeneral":"Preprint","citeproc":"article","bibtex":"misc","ris":"GEN","resourceType":"Article"},"relatedIdentifiers":[],"relatedItems":[],"sizes":[],"formats":[],"version":"1","rightsList":[{"rightsIdentifierScheme":"SPDX","rightsUri":"https://creativecommons.org/licenses/by/4.0/legalcode","schemeUri":"https://spdx.org/licenses/","rights":"Creative Commons Attribution 4.0 International","rightsIdentifier":"cc-by-4.0"}],"descriptions":[{"descriptionType":"Abstract","description":"Identifying low-energy adsorption geometries on catalytic surfaces is a practical bottleneck for computational heterogeneous catalysis: the difficulty lies not only in the cost of density functional theory (DFT) but in proposing initial placements that relax into the correct energy basins. Conditional denoising diffusion has improved success rates, yet requires $\\sim$100 iterative steps per sample.\n Here we introduce AdsorbFlow, a deterministic generative model that learns an energy-conditioned vector field on the rigid-body configuration space of adsorbate translation and rotation via conditional flow matching. Energy information enters through classifier-free guidance conditioning -- not energy-gradient guidance -- and sampling reduces to integrating an ODE in as few as 5 steps.\n On OC20-Dense with full DFT single-point verification, AdsorbFlow with an EquiformerV2 backbone achieves 61.4% SR@10 and 34.1% SR@1 -- surpassing AdsorbDiff (31.8% SR@1, 41.0% SR@10) at every evaluation level and AdsorbML (47.7% SR@10) -- while using 20 times fewer generative steps and achieving the lowest anomaly rate among generative methods (6.8%). On 50 out-of-distribution systems, AdsorbFlow retains 58.0% SR@10 with a MLFF-to-DFT gap of only 4~percentage points. These results establish that deterministic transport is both faster and more accurate than stochastic denoising for adsorbate placement."}],"geoLocations":[],"fundingReferences":[],"url":"https://arxiv.org/abs/2602.19289","contentUrl":null,"metadataVersion":0,"schemaVersion":"http://datacite.org/schema/kernel-4","source":"mds","isActive":true,"state":"findable","reason":null,"viewCount":0,"downloadCount":0,"referenceCount":0,"citationCount":0,"partCount":0,"partOfCount":0,"versionCount":0,"versionOfCount":0,"created":"2026-02-25T14:54:17Z","registered":"2026-02-25T14:54:18Z","published":null,"updated":"2026-02-25T14:54:18Z"},"relationships":{"client":{"data":{"id":"arxiv.content","type":"clients"}}}},{"id":"10.48550/arxiv.2602.19288","type":"dois","attributes":{"doi":"10.48550/arxiv.2602.19288","identifiers":[{"identifier":"2602.19288","identifierType":"arXiv"}],"creators":[{"nameType":"Personal","givenName":"Sanjeev","familyName":"Kumar","name":"Kumar, Sanjeev","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Hendrik","familyName":"Weimer","name":"Weimer, Hendrik","affiliation":[],"nameIdentifiers":[]}],"titles":[{"title":"Self-correction phase transition in the dissipative toric code"}],"publisher":"arXiv","container":{},"publicationYear":2026,"subjects":[{"subject":"Quantum Physics (quant-ph)","lang":"en","subjectScheme":"arXiv"},{"subject":"Statistical Mechanics (cond-mat.stat-mech)","lang":"en","subjectScheme":"arXiv"},{"subject":"Strongly Correlated Electrons (cond-mat.str-el)","lang":"en","subjectScheme":"arXiv"},{"subject":"FOS: Physical sciences","subjectScheme":"Fields of Science and Technology (FOS)"},{"schemeUri":"http://www.oecd.org/science/inno/38235147.pdf","subject":"FOS: Physical sciences","subjectScheme":"Fields of Science and Technology (FOS)"}],"contributors":[],"dates":[{"date":"2026-02-22T17:52:00Z","dateType":"Submitted","dateInformation":"v1"},{"date":"2026-02-24T01:56:12Z","dateType":"Updated","dateInformation":"v1"},{"date":"2026-02","dateType":"Available","dateInformation":"v1"},{"date":"2026","dateType":"Issued"}],"language":null,"types":{"schemaOrg":"CreativeWork","resourceTypeGeneral":"Preprint","citeproc":"article","bibtex":"misc","ris":"GEN","resourceType":"Article"},"relatedIdentifiers":[],"relatedItems":[],"sizes":[],"formats":[],"version":"1","rightsList":[{"rightsUri":"http://arxiv.org/licenses/nonexclusive-distrib/1.0/","rights":"arXiv.org perpetual, non-exclusive license"}],"descriptions":[{"descriptionType":"Abstract","description":"We analyze a time-continuous version of a cellular automaton decoder for the toric code in the form of a Lindblad master equation. In this setting, a self-correcting quantum memory becomes a thermodynamical phase of the steady state, which manifests itself through the steady state being topologically ordered. We compute the steady state phase diagram, finding a competition between the error correction rate and the update rate for the classical field of the cellular automaton. Strikingly, we find that self-correction of errors is possible even in situations where conventional quantum error correction does not have a finite threshold."},{"descriptionType":"Other","description":"6 pages, 5 figures"}],"geoLocations":[],"fundingReferences":[],"url":"https://arxiv.org/abs/2602.19288","contentUrl":null,"metadataVersion":0,"schemaVersion":"http://datacite.org/schema/kernel-4","source":"mds","isActive":true,"state":"findable","reason":null,"viewCount":0,"downloadCount":0,"referenceCount":0,"citationCount":0,"partCount":0,"partOfCount":0,"versionCount":0,"versionOfCount":0,"created":"2026-02-25T14:54:15Z","registered":"2026-02-25T14:54:15Z","published":null,"updated":"2026-02-25T14:54:16Z"},"relationships":{"client":{"data":{"id":"arxiv.content","type":"clients"}}}},{"id":"10.48550/arxiv.2602.19287","type":"dois","attributes":{"doi":"10.48550/arxiv.2602.19287","identifiers":[{"identifier":"2602.19287","identifierType":"arXiv"}],"creators":[{"nameType":"Personal","givenName":"Kim","familyName":"Christensen","name":"Christensen, Kim","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Mark","familyName":"Podolskij","name":"Podolskij, Mark","affiliation":[],"nameIdentifiers":[]}],"titles":[{"title":"Asymptotic theory of range-based multipower variation"}],"publisher":"arXiv","container":{},"publicationYear":2026,"subjects":[{"subject":"Econometrics (econ.EM)","lang":"en","subjectScheme":"arXiv"},{"subject":"FOS: Economics and business","subjectScheme":"Fields of Science and Technology (FOS)"},{"schemeUri":"http://www.oecd.org/science/inno/38235147.pdf","subject":"FOS: Economics and business","subjectScheme":"Fields of Science and Technology (FOS)"}],"contributors":[],"dates":[{"date":"2026-02-22T17:43:52Z","dateType":"Submitted","dateInformation":"v1"},{"date":"2026-02-24T01:56:04Z","dateType":"Updated","dateInformation":"v1"},{"date":"2026-02","dateType":"Available","dateInformation":"v1"},{"date":"2026","dateType":"Issued"}],"language":null,"types":{"schemaOrg":"CreativeWork","resourceTypeGeneral":"Preprint","citeproc":"article","bibtex":"misc","ris":"GEN","resourceType":"Article"},"relatedIdentifiers":[{"relationType":"IsVersionOf","relatedIdentifier":"10.1093/jjfinec/nbr019","relatedIdentifierType":"DOI"}],"relatedItems":[],"sizes":[],"formats":[],"version":"1","rightsList":[{"rightsUri":"http://arxiv.org/licenses/nonexclusive-distrib/1.0/","rights":"arXiv.org perpetual, non-exclusive license"}],"descriptions":[{"descriptionType":"Abstract","description":"In this paper, we present a realized range-based multipower variation theory, which can be used to estimate return variation and draw jump-robust inference about the diffusive volatility component, when a high-frequency record of asset prices is available. The standard range-statistic -- routinely used in financial economics to estimate the variance of securities prices -- is shown to be biased when the price process contains jumps. We outline how the new theory can be applied to remove this bias by constructing a hybrid range-based estimator. Our asymptotic theory also reveals that when high-frequency data are sparsely sampled, as is often done in practice due to the presence of microstructure noise, the range-based multipower variations can produce significant efficiency gains over comparable subsampled return-based estimators. The analysis is supported by a simulation study and we illustrate the practical use of our framework on some recent TAQ equity data."}],"geoLocations":[],"fundingReferences":[],"url":"https://arxiv.org/abs/2602.19287","contentUrl":null,"metadataVersion":0,"schemaVersion":"http://datacite.org/schema/kernel-4","source":"mds","isActive":true,"state":"findable","reason":null,"viewCount":0,"downloadCount":0,"referenceCount":0,"citationCount":0,"partCount":0,"partOfCount":0,"versionCount":0,"versionOfCount":1,"created":"2026-02-25T14:54:12Z","registered":"2026-02-25T14:54:13Z","published":null,"updated":"2026-02-25T14:54:13Z"},"relationships":{"client":{"data":{"id":"arxiv.content","type":"clients"}}}},{"id":"10.48550/arxiv.2602.19286","type":"dois","attributes":{"doi":"10.48550/arxiv.2602.19286","identifiers":[{"identifier":"2602.19286","identifierType":"arXiv"}],"creators":[{"nameType":"Personal","givenName":"Matthew M.","familyName":"Dallas","name":"Dallas, Matthew M.","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Matthew R.","familyName":"Siebert","name":"Siebert, Matthew R.","affiliation":[],"nameIdentifiers":[]}],"titles":[{"title":"Safety Acquisitions: Redundancy for non-repeatable multi-orbit STIS visits"}],"publisher":"arXiv","container":{},"publicationYear":2026,"subjects":[{"subject":"Instrumentation and Methods for Astrophysics (astro-ph.IM)","lang":"en","subjectScheme":"arXiv"},{"subject":"FOS: Physical sciences","subjectScheme":"Fields of Science and Technology (FOS)"},{"schemeUri":"http://www.oecd.org/science/inno/38235147.pdf","subject":"FOS: Physical sciences","subjectScheme":"Fields of Science and Technology (FOS)"}],"contributors":[],"dates":[{"date":"2026-02-22T17:43:17Z","dateType":"Submitted","dateInformation":"v1"},{"date":"2026-02-24T01:56:02Z","dateType":"Updated","dateInformation":"v1"},{"date":"2026-02","dateType":"Available","dateInformation":"v1"},{"date":"2026","dateType":"Issued"}],"language":null,"types":{"schemaOrg":"CreativeWork","resourceTypeGeneral":"Preprint","citeproc":"article","bibtex":"misc","ris":"GEN","resourceType":"Article"},"relatedIdentifiers":[],"relatedItems":[],"sizes":[],"formats":[],"version":"1","rightsList":[{"rightsIdentifierScheme":"SPDX","rightsUri":"https://creativecommons.org/licenses/by/4.0/legalcode","schemeUri":"https://spdx.org/licenses/","rights":"Creative Commons Attribution 4.0 International","rightsIdentifier":"cc-by-4.0"}],"descriptions":[{"descriptionType":"Abstract","description":"For observations of supernovae, kilonovae, tidal disruption events, and other non-repeatable observations, it is important the science data is taken successfully within a specific time window. Part of obtaining that data is often centering objects in the aperture to a higher accuracy than is available from Hubble Space Telescope's (HST's) blind pointing. On HST STIS the sequence of exposures responsible for this centering is the target acquisition or STIS ACQ sequence, and it is most often placed only at the beginning of a visit. Unfortunately, STIS ACQ sequences will fail if the observatory experiences issues locating guide stars in time for the start of the required exposures. If the guide stars are located at a later point in the visit, the remaining science exposures can be taken but the pointing might not be as accurate as is required. This work discusses both the frequency of this issue and the feasibility of placing redundant or \"safety\" STIS ACQ sequences in a multi-orbit visit to regain the desired pointing accuracy in an affected visit. To do so we select a subset of all 113 STIS ACQ sequences from September 2018 to September 2023 which have experienced this issue. We find that this problem occurs in ~5% of the total STIS ACQ sequences taken during that time period, with a recent increase in the rate to ~9% from March to September 2023. Since the observatory goes through periods of better or worse pointing performance, this recent increased failure rate is not guaranteed to continue. For those failed visits which span multiple orbits, ~39% never obtain a lock on the guide stars and thus take no data. Of the multi-orbit visits that do recover the guide stars, the majority (~78%) do so before the beginning of science exposures in the second orbit. We also provide advice for users on how to make a risk assessment based on the analysis presented here."},{"descriptionType":"Other","description":"18 pages, 8 figures"}],"geoLocations":[],"fundingReferences":[],"url":"https://arxiv.org/abs/2602.19286","contentUrl":null,"metadataVersion":0,"schemaVersion":"http://datacite.org/schema/kernel-4","source":"mds","isActive":true,"state":"findable","reason":null,"viewCount":0,"downloadCount":0,"referenceCount":0,"citationCount":0,"partCount":0,"partOfCount":0,"versionCount":0,"versionOfCount":0,"created":"2026-02-25T14:54:10Z","registered":"2026-02-25T14:54:10Z","published":null,"updated":"2026-02-25T14:54:11Z"},"relationships":{"client":{"data":{"id":"arxiv.content","type":"clients"}}}},{"id":"10.48550/arxiv.2602.19285","type":"dois","attributes":{"doi":"10.48550/arxiv.2602.19285","identifiers":[{"identifier":"2602.19285","identifierType":"arXiv"}],"creators":[{"nameType":"Personal","givenName":"Jindi","familyName":"Kong","name":"Kong, Jindi","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Yuting","familyName":"He","name":"He, Yuting","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Cong","familyName":"Xia","name":"Xia, Cong","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Rongjun","familyName":"Ge","name":"Ge, Rongjun","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Shuo","familyName":"Li","name":"Li, Shuo","affiliation":[],"nameIdentifiers":[]}],"titles":[{"title":"MRI Contrast Enhancement Kinetics World Model"}],"publisher":"arXiv","container":{},"publicationYear":2026,"subjects":[{"subject":"Computer Vision and Pattern Recognition (cs.CV)","lang":"en","subjectScheme":"arXiv"},{"subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"},{"schemeUri":"http://www.oecd.org/science/inno/38235147.pdf","subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"}],"contributors":[],"dates":[{"date":"2026-02-22T17:39:31Z","dateType":"Submitted","dateInformation":"v1"},{"date":"2026-02-24T01:55:58Z","dateType":"Updated","dateInformation":"v1"},{"date":"2026-02","dateType":"Available","dateInformation":"v1"},{"date":"2026","dateType":"Issued"}],"language":null,"types":{"schemaOrg":"CreativeWork","resourceTypeGeneral":"Preprint","citeproc":"article","bibtex":"misc","ris":"GEN","resourceType":"Article"},"relatedIdentifiers":[],"relatedItems":[],"sizes":[],"formats":[],"version":"1","rightsList":[{"rightsUri":"http://arxiv.org/licenses/nonexclusive-distrib/1.0/","rights":"arXiv.org perpetual, non-exclusive license"}],"descriptions":[{"descriptionType":"Abstract","description":"Clinical MRI contrast acquisition suffers from inefficient information yield, which presents as a mismatch between the risky and costly acquisition protocol and the fixed and sparse acquisition sequence. Applying world models to simulate the contrast enhancement kinetics in the human body enables continuous contrast-free dynamics. However, the low temporal resolution in MRI acquisition restricts the training of world models, leading to a sparsely sampled dataset. Directly training a generative model to capture the kinetics leads to two limitations: (a) Due to the absence of data on missing time, the model tends to overfit to irrelevant features, leading to content distortion. (b) Due to the lack of continuous temporal supervision, the model fails to learn the continuous kinetics law over time, causing temporal discontinuities. For the first time, we propose MRI Contrast Enhancement Kinetics World model (MRI CEKWorld) with SpatioTemporal Consistency Learning (STCL). For (a), guided by the spatial law that patient-level structures remain consistent during enhancement, we propose Latent Alignment Learning (LAL) that constructs a patient-specific template to constrain contents to align with this template. For (b), guided by the temporal law that the kinetics follow a consistent smooth trend, we propose Latent Difference Learning (LDL) which extends the unobserved intervals by interpolation and constrains smooth variations in the latent space among interpolated sequences. Extensive experiments on two datasets show our MRI CEKWorld achieves better realistic contents and kinetics. Codes will be available at https://github.com/DD0922/MRI-Contrast-Enhancement-Kinetics-World-Model."},{"descriptionType":"Other","description":"Accepted by CVPR 2026"}],"geoLocations":[],"fundingReferences":[],"url":"https://arxiv.org/abs/2602.19285","contentUrl":null,"metadataVersion":0,"schemaVersion":"http://datacite.org/schema/kernel-4","source":"mds","isActive":true,"state":"findable","reason":null,"viewCount":0,"downloadCount":0,"referenceCount":0,"citationCount":0,"partCount":0,"partOfCount":0,"versionCount":0,"versionOfCount":0,"created":"2026-02-25T14:54:07Z","registered":"2026-02-25T14:54:08Z","published":null,"updated":"2026-02-25T14:54:08Z"},"relationships":{"client":{"data":{"id":"arxiv.content","type":"clients"}}}},{"id":"10.48550/arxiv.2602.19284","type":"dois","attributes":{"doi":"10.48550/arxiv.2602.19284","identifiers":[{"identifier":"2602.19284","identifierType":"arXiv"}],"creators":[{"nameType":"Personal","givenName":"Yuhao","familyName":"Wang","name":"Wang, Yuhao","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Tengyao","familyName":"Wang","name":"Wang, Tengyao","affiliation":[],"nameIdentifiers":[]}],"titles":[{"title":"Localized conformal model selection"}],"publisher":"arXiv","container":{},"publicationYear":2026,"subjects":[{"subject":"Methodology (stat.ME)","lang":"en","subjectScheme":"arXiv"},{"subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"},{"schemeUri":"http://www.oecd.org/science/inno/38235147.pdf","subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"},{"subject":"62G15","lang":"en","subjectScheme":"MSC"}],"contributors":[],"dates":[{"date":"2026-02-22T17:35:59Z","dateType":"Submitted","dateInformation":"v1"},{"date":"2026-02-24T01:55:58Z","dateType":"Updated","dateInformation":"v1"},{"date":"2026-02","dateType":"Available","dateInformation":"v1"},{"date":"2026","dateType":"Issued"}],"language":null,"types":{"schemaOrg":"CreativeWork","resourceTypeGeneral":"Preprint","citeproc":"article","bibtex":"misc","ris":"GEN","resourceType":"Article"},"relatedIdentifiers":[],"relatedItems":[],"sizes":[],"formats":[],"version":"1","rightsList":[{"rightsIdentifierScheme":"SPDX","rightsUri":"https://creativecommons.org/licenses/by/4.0/legalcode","schemeUri":"https://spdx.org/licenses/","rights":"Creative Commons Attribution 4.0 International","rightsIdentifier":"cc-by-4.0"}],"descriptions":[{"descriptionType":"Abstract","description":"We propose a localized conformal model selection framework that integrates local adaptivity with post-selection validity for distribution-free prediction. By performing model selection symmetrically across calibration points using upper and lower surrogate intervals, we construct a data-dependent safe index set that contains the oracle model and preserves exchangeability. The resulting ensemble procedure retains exact finite-sample marginal coverage while adapting to spatial heterogeneity and model complexity. Simulations demonstrate substantial reductions in interval length compared to the best fixed model, especially in heterogeneous and low-noise settings."},{"descriptionType":"Other","description":"8 pages, 1 figure"}],"geoLocations":[],"fundingReferences":[],"url":"https://arxiv.org/abs/2602.19284","contentUrl":null,"metadataVersion":0,"schemaVersion":"http://datacite.org/schema/kernel-4","source":"mds","isActive":true,"state":"findable","reason":null,"viewCount":0,"downloadCount":0,"referenceCount":0,"citationCount":0,"partCount":0,"partOfCount":0,"versionCount":0,"versionOfCount":0,"created":"2026-02-25T14:54:05Z","registered":"2026-02-25T14:54:06Z","published":null,"updated":"2026-02-25T14:54:06Z"},"relationships":{"client":{"data":{"id":"arxiv.content","type":"clients"}}}},{"id":"10.48550/arxiv.2602.19283","type":"dois","attributes":{"doi":"10.48550/arxiv.2602.19283","identifiers":[{"identifier":"2602.19283","identifierType":"arXiv"}],"creators":[{"nameType":"Personal","givenName":"Sumit","familyName":"Sarkar","name":"Sarkar, Sumit","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Priyanka","familyName":"Yadav","name":"Yadav, Priyanka","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Sourav","familyName":"Chowdhury","name":"Chowdhury, Sourav","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Rajamani","familyName":"Raghunathan","name":"Raghunathan, Rajamani","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Ram Janay","familyName":"Choudhary","name":"Choudhary, Ram Janay","affiliation":[],"nameIdentifiers":[]}],"titles":[{"title":"Unraveling the temperature-responsive charge-disproportionation in BaBiO$_3$"}],"publisher":"arXiv","container":{},"publicationYear":2026,"subjects":[{"subject":"Materials Science (cond-mat.mtrl-sci)","lang":"en","subjectScheme":"arXiv"},{"subject":"FOS: Physical sciences","subjectScheme":"Fields of Science and Technology (FOS)"},{"schemeUri":"http://www.oecd.org/science/inno/38235147.pdf","subject":"FOS: Physical sciences","subjectScheme":"Fields of Science and Technology (FOS)"}],"contributors":[],"dates":[{"date":"2026-02-22T17:35:53Z","dateType":"Submitted","dateInformation":"v1"},{"date":"2026-02-24T01:55:57Z","dateType":"Updated","dateInformation":"v1"},{"date":"2026-02","dateType":"Available","dateInformation":"v1"},{"date":"2026","dateType":"Issued"}],"language":null,"types":{"schemaOrg":"CreativeWork","resourceTypeGeneral":"Preprint","citeproc":"article","bibtex":"misc","ris":"GEN","resourceType":"Article"},"relatedIdentifiers":[],"relatedItems":[],"sizes":[],"formats":[],"version":"1","rightsList":[{"rightsUri":"http://arxiv.org/licenses/nonexclusive-distrib/1.0/","rights":"arXiv.org perpetual, non-exclusive license"}],"descriptions":[{"descriptionType":"Abstract","description":"This study shows that the charge disproportionation at the Bi site in BaBiO$_3$ alters as a function of temperature. Decreasing the temperature from 300K down to 160K leads to a significant modification of the density of states corresponding to the Bi-O hybridized band near the Fermi level (E$_\\text{F}$). This modification indicates reduction of Bi 6$sp$ - O 2$p$ hybridization and O 2$p$ spectral weight near E$_\\text{F}$. The strong decrement of covalency at lower temperatures is accompanied by a decrement in O 2$p$ hole density due to possible charge transfer from Bi 6$s$ to the O 2$p$ band. Bi-charge state analysis from Bi-4$f$ core-level spectra showed that at 300K, $δ$ (charge difference between alternate Bi sites) value in 4$\\pmδ$ is much less than at 160K, which reveals the transition towards the ionic nature of CD or static CD in BBO at low temperature. On the other hand, O 1$s$ core-level spectra displayed an asymmetric shape, and temperature-dependent modifications of the asymmetric shape and intensity have been observed. This highlights the significant influence of the O 2$p$ band hole on the dynamical CD at the Bi site."},{"descriptionType":"Other","description":"6 pages, 4 figures"}],"geoLocations":[],"fundingReferences":[],"url":"https://arxiv.org/abs/2602.19283","contentUrl":null,"metadataVersion":0,"schemaVersion":"http://datacite.org/schema/kernel-4","source":"mds","isActive":true,"state":"findable","reason":null,"viewCount":0,"downloadCount":0,"referenceCount":0,"citationCount":0,"partCount":0,"partOfCount":0,"versionCount":0,"versionOfCount":0,"created":"2026-02-25T14:54:02Z","registered":"2026-02-25T14:54:03Z","published":null,"updated":"2026-02-25T14:54:03Z"},"relationships":{"client":{"data":{"id":"arxiv.content","type":"clients"}}}},{"id":"10.48550/arxiv.2602.19278","type":"dois","attributes":{"doi":"10.48550/arxiv.2602.19278","identifiers":[{"identifier":"2602.19278","identifierType":"arXiv"}],"creators":[{"nameType":"Personal","givenName":"Keonvin","familyName":"Park","name":"Park, Keonvin","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Aditya","familyName":"Pal","name":"Pal, Aditya","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Jin Hong","familyName":"Mok","name":"Mok, Jin Hong","affiliation":[],"nameIdentifiers":[]}],"titles":[{"title":"A Two-Stage Detection-Tracking Framework for Stable Apple Quality Inspection in Dense Conveyor-Belt Environments"}],"publisher":"arXiv","container":{},"publicationYear":2026,"subjects":[{"subject":"Computer Vision and Pattern Recognition (cs.CV)","lang":"en","subjectScheme":"arXiv"},{"subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"},{"schemeUri":"http://www.oecd.org/science/inno/38235147.pdf","subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"}],"contributors":[],"dates":[{"date":"2026-02-22T17:24:13Z","dateType":"Submitted","dateInformation":"v1"},{"date":"2026-02-24T01:55:50Z","dateType":"Updated","dateInformation":"v1"},{"date":"2026-02","dateType":"Available","dateInformation":"v1"},{"date":"2026","dateType":"Issued"}],"language":null,"types":{"schemaOrg":"CreativeWork","resourceTypeGeneral":"Preprint","citeproc":"article","bibtex":"misc","ris":"GEN","resourceType":"Article"},"relatedIdentifiers":[],"relatedItems":[],"sizes":[],"formats":[],"version":"1","rightsList":[{"rightsIdentifierScheme":"SPDX","rightsUri":"https://creativecommons.org/licenses/by/4.0/legalcode","schemeUri":"https://spdx.org/licenses/","rights":"Creative Commons Attribution 4.0 International","rightsIdentifier":"cc-by-4.0"}],"descriptions":[{"descriptionType":"Abstract","description":"Industrial fruit inspection systems must operate reliably under dense multi-object interactions and continuous motion, yet most existing works evaluate detection or classification at the image level without ensuring temporal stability in video streams. We present a two-stage detection-tracking framework for stable multi-apple quality inspection in conveyor-belt environments. An orchard-trained YOLOv8 model performs apple localization, followed by ByteTrack multi-object tracking to maintain persistent identities. A ResNet18 defect classifier, fine-tuned on a healthy-defective fruit dataset, is applied to cropped apple regions. Track-level aggregation is introduced to enforce temporal consistency and reduce prediction oscillation across frames. We define video-level industrial metrics such as track-level defect ratio and temporal consistency to evaluate system robustness under realistic processing conditions. Results demonstrate improved stability compared to frame-wise inference, suggesting that integrating tracking is essential for practical automated fruit grading systems."}],"geoLocations":[],"fundingReferences":[],"url":"https://arxiv.org/abs/2602.19278","contentUrl":null,"metadataVersion":0,"schemaVersion":"http://datacite.org/schema/kernel-4","source":"mds","isActive":true,"state":"findable","reason":null,"viewCount":0,"downloadCount":0,"referenceCount":0,"citationCount":0,"partCount":0,"partOfCount":0,"versionCount":0,"versionOfCount":0,"created":"2026-02-25T14:53:50Z","registered":"2026-02-25T14:53:51Z","published":null,"updated":"2026-02-25T14:53:51Z"},"relationships":{"client":{"data":{"id":"arxiv.content","type":"clients"}}}},{"id":"10.48550/arxiv.2602.19277","type":"dois","attributes":{"doi":"10.48550/arxiv.2602.19277","identifiers":[{"identifier":"2602.19277","identifierType":"arXiv"}],"creators":[{"nameType":"Personal","givenName":"Dongnuan","familyName":"Tian","name":"Tian, Dongnuan","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Rob","familyName":"Shone","name":"Shone, Rob","affiliation":[],"nameIdentifiers":[]}],"titles":[{"title":"Dynamic Repair and Maintenance of Heterogeneous Machines Dispersed on a Network: A Rollout Method for Online Reinforcement Learning"}],"publisher":"arXiv","container":{},"publicationYear":2026,"subjects":[{"subject":"Optimization and Control (math.OC)","lang":"en","subjectScheme":"arXiv"},{"subject":"FOS: Mathematics","subjectScheme":"Fields of Science and Technology (FOS)"},{"schemeUri":"http://www.oecd.org/science/inno/38235147.pdf","subject":"FOS: Mathematics","subjectScheme":"Fields of Science and Technology (FOS)"}],"contributors":[],"dates":[{"date":"2026-02-22T17:19:42Z","dateType":"Submitted","dateInformation":"v1"},{"date":"2026-02-24T01:55:45Z","dateType":"Updated","dateInformation":"v1"},{"date":"2026-02","dateType":"Available","dateInformation":"v1"},{"date":"2026","dateType":"Issued"}],"language":null,"types":{"schemaOrg":"CreativeWork","resourceTypeGeneral":"Preprint","citeproc":"article","bibtex":"misc","ris":"GEN","resourceType":"Article"},"relatedIdentifiers":[],"relatedItems":[],"sizes":[],"formats":[],"version":"1","rightsList":[{"rightsIdentifierScheme":"SPDX","rightsUri":"https://creativecommons.org/licenses/by/4.0/legalcode","schemeUri":"https://spdx.org/licenses/","rights":"Creative Commons Attribution 4.0 International","rightsIdentifier":"cc-by-4.0"}],"descriptions":[{"descriptionType":"Abstract","description":"We consider a problem in which a single repairer is responsible for the maintenance and repair of a collection of machines, positioned at different locations on a network of nodes and edges. Machines deteriorate according to stochastic processes and incur increasing costs as they approach complete failure. The times needed for repairs to be performed, and the amounts of time needed for the repairer to switch between different machines, are random and machine-dependent. The problem is formulated as a Markov decision process (MDP) in which the objective is to minimize long-run average costs. We prove the equivalence of an alternative formulation based on rewards and use this to develop an index heuristic policy, which is shown to be optimal in certain special cases. We then use rollout-based reinforcement learning techniques to develop a novel online policy improvement (OPI) approach, which uses the index heuristic as a base policy and also as an insurance option at decision epochs where the best action cannot be selected with sufficient confidence. Results from extensive numerical experiments, involving randomly-generated network layouts and parameter values, show that the OPI heuristic is able to achieve close-to-optimal performance in fast-changing systems with state transitions occurring 100 times per second, suggesting that it is suitable for online implementation."}],"geoLocations":[],"fundingReferences":[],"url":"https://arxiv.org/abs/2602.19277","contentUrl":null,"metadataVersion":0,"schemaVersion":"http://datacite.org/schema/kernel-4","source":"mds","isActive":true,"state":"findable","reason":null,"viewCount":0,"downloadCount":0,"referenceCount":0,"citationCount":0,"partCount":0,"partOfCount":0,"versionCount":0,"versionOfCount":0,"created":"2026-02-25T14:53:48Z","registered":"2026-02-25T14:53:48Z","published":null,"updated":"2026-02-25T14:53:48Z"},"relationships":{"client":{"data":{"id":"arxiv.content","type":"clients"}}}},{"id":"10.48550/arxiv.2602.19276","type":"dois","attributes":{"doi":"10.48550/arxiv.2602.19276","identifiers":[{"identifier":"2602.19276","identifierType":"arXiv"}],"creators":[{"nameType":"Personal","givenName":"Jingyu","familyName":"Xiao","name":"Xiao, Jingyu","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Jiantong","familyName":"Qin","name":"Qin, Jiantong","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Shuoqi","familyName":"Li","name":"Li, Shuoqi","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Man Ho","familyName":"Lam","name":"Lam, Man Ho","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Yuxuan","familyName":"Wan","name":"Wan, Yuxuan","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Jen-tse","familyName":"Huang","name":"Huang, Jen-tse","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Yintong","familyName":"Huo","name":"Huo, Yintong","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Michael R.","familyName":"Lyu","name":"Lyu, Michael R.","affiliation":[],"nameIdentifiers":[]}],"titles":[{"title":"ComUICoder: Component-based Reusable UI Code Generation for Complex Websites via Semantic Segmentation and Element-wise Feedback"}],"publisher":"arXiv","container":{},"publicationYear":2026,"subjects":[{"subject":"Software Engineering (cs.SE)","lang":"en","subjectScheme":"arXiv"},{"subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"},{"schemeUri":"http://www.oecd.org/science/inno/38235147.pdf","subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"}],"contributors":[],"dates":[{"date":"2026-02-22T17:17:16Z","dateType":"Submitted","dateInformation":"v1"},{"date":"2026-02-24T01:55:38Z","dateType":"Updated","dateInformation":"v1"},{"date":"2026-02","dateType":"Available","dateInformation":"v1"},{"date":"2026","dateType":"Issued"}],"language":null,"types":{"schemaOrg":"CreativeWork","resourceTypeGeneral":"Preprint","citeproc":"article","bibtex":"misc","ris":"GEN","resourceType":"Article"},"relatedIdentifiers":[],"relatedItems":[],"sizes":[],"formats":[],"version":"1","rightsList":[{"rightsUri":"http://arxiv.org/licenses/nonexclusive-distrib/1.0/","rights":"arXiv.org perpetual, non-exclusive license"}],"descriptions":[{"descriptionType":"Abstract","description":"Multimodal Large Language Models (MLLMs) have demonstrated strong performance on the UI-to-code task, which aims to generate UI code from design mock-ups. However, when applied to long and complex websites, they often struggle with fragmented segmentation, redundant code generation for repetitive components, and frequent UI inconsistencies. To systematically investigate and address these challenges, we introduce ComUIBench, a new multi-page complex webpage benchmark with component annotations, designed to evaluate MLLMs' ability to generate reusable UI code in realistic website scenarios. Building upon this benchmark, we propose ComUICoder, a component-based UI code generation framework that emphasizes semantic-aware segmentation, code reuse, and fine-grained refinement. Specifically, ComUICoder incorporates (1) Hybrid Semantic-aware Block Segmentation for accurate UI semantic coherent block detection, (2) Visual-aware Graph-based Block Merge to consolidate structurally similar components within and across webpages for reusable implementation, and (3) Priority-based Element-wise Feedback to refine generated code and reduce element-level inconsistencies. Extensive experiments demonstrate that ComUICoder significantly improves overall generation quality and code reusability on complex multipage websites. Our datasets and code are publicly available at https://github.com/WebPAI/ComUICoder."}],"geoLocations":[],"fundingReferences":[],"url":"https://arxiv.org/abs/2602.19276","contentUrl":null,"metadataVersion":0,"schemaVersion":"http://datacite.org/schema/kernel-4","source":"mds","isActive":true,"state":"findable","reason":null,"viewCount":0,"downloadCount":0,"referenceCount":0,"citationCount":0,"partCount":0,"partOfCount":0,"versionCount":0,"versionOfCount":0,"created":"2026-02-25T14:53:45Z","registered":"2026-02-25T14:53:46Z","published":null,"updated":"2026-02-25T14:53:46Z"},"relationships":{"client":{"data":{"id":"arxiv.content","type":"clients"}}}},{"id":"10.48550/arxiv.2602.19274","type":"dois","attributes":{"doi":"10.48550/arxiv.2602.19274","identifiers":[{"identifier":"2602.19274","identifierType":"arXiv"}],"creators":[{"nameType":"Personal","givenName":"Krishna","familyName":"Khadka","name":"Khadka, Krishna","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Yu","familyName":"Lei","name":"Lei, Yu","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Raghu N.","familyName":"Kacker","name":"Kacker, Raghu N.","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"D. Richard","familyName":"Kuhn","name":"Kuhn, D. Richard","affiliation":[],"nameIdentifiers":[]}],"titles":[{"title":"DD-CAM: Minimal Sufficient Explanations for Vision Models Using Delta Debugging"}],"publisher":"arXiv","container":{},"publicationYear":2026,"subjects":[{"subject":"Computer Vision and Pattern Recognition (cs.CV)","lang":"en","subjectScheme":"arXiv"},{"subject":"Software Engineering (cs.SE)","lang":"en","subjectScheme":"arXiv"},{"subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"},{"schemeUri":"http://www.oecd.org/science/inno/38235147.pdf","subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"}],"contributors":[],"dates":[{"date":"2026-02-22T17:12:31Z","dateType":"Submitted","dateInformation":"v1"},{"date":"2026-02-24T01:55:34Z","dateType":"Updated","dateInformation":"v1"},{"date":"2026-02","dateType":"Available","dateInformation":"v1"},{"date":"2026","dateType":"Issued"}],"language":null,"types":{"schemaOrg":"CreativeWork","resourceTypeGeneral":"Preprint","citeproc":"article","bibtex":"misc","ris":"GEN","resourceType":"Article"},"relatedIdentifiers":[],"relatedItems":[],"sizes":[],"formats":[],"version":"1","rightsList":[{"rightsUri":"http://arxiv.org/licenses/nonexclusive-distrib/1.0/","rights":"arXiv.org perpetual, non-exclusive license"}],"descriptions":[{"descriptionType":"Abstract","description":"We introduce a gradient-free framework for identifying minimal, sufficient, and decision-preserving explanations in vision models by isolating the smallest subset of representational units whose joint activation preserves predictions. Unlike existing approaches that aggregate all units, often leading to cluttered saliency maps, our approach, DD-CAM, identifies a 1-minimal subset whose joint activation suffices to preserve the prediction (i.e., removing any unit from the subset alters the prediction). To efficiently isolate minimal sufficient subsets, we adapt delta debugging, a systematic reduction strategy from software debugging, and configure its search strategy based on unit interactions in the classifier head: testing individual units for models with non-interacting units and testing unit combinations for models in which unit interactions exist. We then generate minimal, prediction-preserving saliency maps that highlight only the most essential features. Our experimental evaluation demonstrates that our approach can produce more faithful explanations and achieve higher localization accuracy than the state-of-the-art CAM-based approaches."}],"geoLocations":[],"fundingReferences":[],"url":"https://arxiv.org/abs/2602.19274","contentUrl":null,"metadataVersion":0,"schemaVersion":"http://datacite.org/schema/kernel-4","source":"mds","isActive":true,"state":"findable","reason":null,"viewCount":0,"downloadCount":0,"referenceCount":0,"citationCount":0,"partCount":0,"partOfCount":0,"versionCount":0,"versionOfCount":0,"created":"2026-02-25T14:53:40Z","registered":"2026-02-25T14:53:41Z","published":null,"updated":"2026-02-25T14:53:41Z"},"relationships":{"client":{"data":{"id":"arxiv.content","type":"clients"}}}},{"id":"10.48550/arxiv.2602.19273","type":"dois","attributes":{"doi":"10.48550/arxiv.2602.19273","identifiers":[{"identifier":"2602.19273","identifierType":"arXiv"}],"creators":[{"nameType":"Personal","givenName":"Abhinav","familyName":"Gandhi","name":"Gandhi, Abhinav","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Shou-Shan","familyName":"Chiang","name":"Chiang, Shou-Shan","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Cagdas D.","familyName":"Onal","name":"Onal, Cagdas D.","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Berk","familyName":"Calli","name":"Calli, Berk","affiliation":[],"nameIdentifiers":[]}],"titles":[{"title":"3D Shape Control of Extensible Multi-Section Soft Continuum Robots via Visual Servoing"}],"publisher":"arXiv","container":{},"publicationYear":2026,"subjects":[{"subject":"Robotics (cs.RO)","lang":"en","subjectScheme":"arXiv"},{"subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"},{"schemeUri":"http://www.oecd.org/science/inno/38235147.pdf","subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"}],"contributors":[],"dates":[{"date":"2026-02-22T17:06:16Z","dateType":"Submitted","dateInformation":"v1"},{"date":"2026-02-24T01:55:32Z","dateType":"Updated","dateInformation":"v1"},{"date":"2026-02","dateType":"Available","dateInformation":"v1"},{"date":"2026","dateType":"Issued"}],"language":null,"types":{"schemaOrg":"CreativeWork","resourceTypeGeneral":"Preprint","citeproc":"article","bibtex":"misc","ris":"GEN","resourceType":"Article"},"relatedIdentifiers":[],"relatedItems":[],"sizes":[],"formats":[],"version":"1","rightsList":[{"rightsIdentifierScheme":"SPDX","rightsUri":"https://creativecommons.org/licenses/by-nc-sa/4.0/legalcode","schemeUri":"https://spdx.org/licenses/","rights":"Creative Commons Attribution Non Commercial Share Alike 4.0 International","rightsIdentifier":"cc-by-nc-sa-4.0"}],"descriptions":[{"descriptionType":"Abstract","description":"In this paper, we propose a novel vision-based control algorithm for regulating the whole body shape of extensible multisection soft continuum manipulators. Contrary to existing vision-based control algorithms in the literature that regulate the robot's end effector pose, our proposed control algorithm regulates the robot's whole body configuration, enabling us to leverage its kinematic redundancy. Additionally, our model-based 2.5D shape visual servoing provides globally stable asymptotic convergence in the robot's 3D workspace compared to the closest works in the literature that report local minima. Unlike existing visual servoing algorithms in the literature, our approach does not require information from proprioceptive sensors, making it suitable for continuum manipulators without such capabilities. Instead, robot state is estimated from images acquired by an external camera that observes the robot's whole body shape and is also utilized to close the shape control loop. Traditionally, visual servoing schemes require an image of the robot at its reference pose to generate the reference features. In this work, we utilize an inverse kinematics solver to generate reference features for the desired robot configuration and do not require images of the robot at the reference. Experiments are performed on a multisection continuum manipulator demonstrating the controller's capability to regulate the robot's whole body shape while precisely positioning the robot's end effector. Results validate our controller's ability to regulate the shape of continuum robots while demonstrating a smooth transient response and a steady-state error within 1 mm. Proof-of-concept object manipulation experiments including stacking, pouring, and pulling tasks are performed to demonstrate our controller's applicability."}],"geoLocations":[],"fundingReferences":[],"url":"https://arxiv.org/abs/2602.19273","contentUrl":null,"metadataVersion":0,"schemaVersion":"http://datacite.org/schema/kernel-4","source":"mds","isActive":true,"state":"findable","reason":null,"viewCount":0,"downloadCount":0,"referenceCount":0,"citationCount":0,"partCount":0,"partOfCount":0,"versionCount":0,"versionOfCount":0,"created":"2026-02-25T14:53:38Z","registered":"2026-02-25T14:53:38Z","published":null,"updated":"2026-02-25T14:53:38Z"},"relationships":{"client":{"data":{"id":"arxiv.content","type":"clients"}}}},{"id":"10.48550/arxiv.2602.19272","type":"dois","attributes":{"doi":"10.48550/arxiv.2602.19272","identifiers":[{"identifier":"2602.19272","identifierType":"arXiv"}],"creators":[{"nameType":"Personal","givenName":"Frédéric","familyName":"Marbach","name":"Marbach, Frédéric","affiliation":[],"nameIdentifiers":[]}],"titles":[{"title":"Time-iteration methods for controllability"}],"publisher":"arXiv","container":{},"publicationYear":2026,"subjects":[{"subject":"Optimization and Control (math.OC)","lang":"en","subjectScheme":"arXiv"},{"subject":"FOS: Mathematics","subjectScheme":"Fields of Science and Technology (FOS)"},{"schemeUri":"http://www.oecd.org/science/inno/38235147.pdf","subject":"FOS: Mathematics","subjectScheme":"Fields of Science and Technology (FOS)"},{"subject":"93B05","lang":"en","subjectScheme":"MSC"}],"contributors":[],"dates":[{"date":"2026-02-22T17:03:09Z","dateType":"Submitted","dateInformation":"v1"},{"date":"2026-02-24T01:55:31Z","dateType":"Updated","dateInformation":"v1"},{"date":"2026-02","dateType":"Available","dateInformation":"v1"},{"date":"2026","dateType":"Issued"}],"language":null,"types":{"schemaOrg":"CreativeWork","resourceTypeGeneral":"Preprint","citeproc":"article","bibtex":"misc","ris":"GEN","resourceType":"Article"},"relatedIdentifiers":[],"relatedItems":[],"sizes":[],"formats":[],"version":"1","rightsList":[{"rightsIdentifierScheme":"SPDX","rightsUri":"https://creativecommons.org/licenses/by/4.0/legalcode","schemeUri":"https://spdx.org/licenses/","rights":"Creative Commons Attribution 4.0 International","rightsIdentifier":"cc-by-4.0"}],"descriptions":[{"descriptionType":"Abstract","description":"These notes are based on a short course delivered at the Summer School EUR MINT 2025 \"Control, Inverse Problems and Spectral Theory\", held in June 2025 in Toulouse, France. The course presents three important strategies in control theory, formulated as time-iteration methods, where each time step brings the state of the system closer to the desired target.\n For linear PDEs, we survey the classical Lebeau-Robbiano method and its more recent developments. This method combines spectral inequalities and dissipation estimates to prove null controllability of a dissipative linear system.\n For nonlinear PDEs, we reinterpret the Liu-Takahashi-Tucsnak method, which establishes local controllability of a nonlinear system by analyzing the control cost of its linearization. We provide an easily applicable black-box formulation of their method.\n Finally, for nonlinear ODEs, we present the tangent vectors method, which establishes local exact controllability starting from approximately reachable directions."}],"geoLocations":[],"fundingReferences":[],"url":"https://arxiv.org/abs/2602.19272","contentUrl":null,"metadataVersion":0,"schemaVersion":"http://datacite.org/schema/kernel-4","source":"mds","isActive":true,"state":"findable","reason":null,"viewCount":0,"downloadCount":0,"referenceCount":0,"citationCount":0,"partCount":0,"partOfCount":0,"versionCount":0,"versionOfCount":0,"created":"2026-02-25T14:53:35Z","registered":"2026-02-25T14:53:36Z","published":null,"updated":"2026-02-25T14:53:36Z"},"relationships":{"client":{"data":{"id":"arxiv.content","type":"clients"}}}},{"id":"10.48550/arxiv.2602.19271","type":"dois","attributes":{"doi":"10.48550/arxiv.2602.19271","identifiers":[{"identifier":"2602.19271","identifierType":"arXiv"}],"creators":[{"nameType":"Personal","givenName":"Junkang","familyName":"Liu","name":"Liu, Junkang","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Fanhua","familyName":"Shang","name":"Shang, Fanhua","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Hongying","familyName":"Liu","name":"Liu, Hongying","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Jin","familyName":"Liu","name":"Liu, Jin","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Weixin","familyName":"An","name":"An, Weixin","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Yuanyuan","familyName":"Liu","name":"Liu, Yuanyuan","affiliation":[],"nameIdentifiers":[]}],"titles":[{"title":"Taming Preconditioner Drift: Unlocking the Potential of Second-Order Optimizers for Federated Learning on Non-IID Data"}],"publisher":"arXiv","container":{},"publicationYear":2026,"subjects":[{"subject":"Machine Learning (cs.LG)","lang":"en","subjectScheme":"arXiv"},{"subject":"Artificial Intelligence (cs.AI)","lang":"en","subjectScheme":"arXiv"},{"subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"},{"schemeUri":"http://www.oecd.org/science/inno/38235147.pdf","subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"}],"contributors":[],"dates":[{"date":"2026-02-22T16:57:57Z","dateType":"Submitted","dateInformation":"v1"},{"date":"2026-02-24T01:55:29Z","dateType":"Updated","dateInformation":"v1"},{"date":"2026-02","dateType":"Available","dateInformation":"v1"},{"date":"2026","dateType":"Issued"}],"language":null,"types":{"schemaOrg":"CreativeWork","resourceTypeGeneral":"Preprint","citeproc":"article","bibtex":"misc","ris":"GEN","resourceType":"Article"},"relatedIdentifiers":[],"relatedItems":[],"sizes":[],"formats":[],"version":"1","rightsList":[{"rightsIdentifierScheme":"SPDX","rightsUri":"https://creativecommons.org/licenses/by/4.0/legalcode","schemeUri":"https://spdx.org/licenses/","rights":"Creative Commons Attribution 4.0 International","rightsIdentifier":"cc-by-4.0"}],"descriptions":[{"descriptionType":"Abstract","description":"Second-order optimizers can significantly accelerate large-scale training, yet their naive federated variants are often unstable or even diverge on non-IID data.\n We show that a key culprit is \\emph{preconditioner drift}: client-side second-order training induces heterogeneous \\emph{curvature-defined geometries} (i.e., preconditioner coordinate systems), and server-side model averaging updates computed under incompatible metrics, corrupting the global descent direction.\n To address this geometric mismatch, we propose \\texttt{FedPAC}, a \\emph{preconditioner alignment and correction} framework for reliable federated second-order optimization.\n \\texttt{FedPAC} explicitly decouples parameter aggregation from geometry synchronization by:\n (i) \\textbf{Alignment} (i.e.,aggregating local preconditioners into a global reference and warm-starting clients via global preconditioner); and\n (ii) \\textbf{Correction} (i.e., steering local preconditioned updates using a global preconditioned direction to suppress long-term drift).\n We provide drift-coupled non-convex convergence guarantees with linear speedup under partial participation.\n Empirically, \\texttt{FedPAC} consistently improves stability and accuracy across vision and language tasks, achieving up to $5.8\\%$ absolute accuracy gain on CIFAR-100 with ViTs.\n Code is available at https://anonymous.4open.science/r/FedPAC-8B24."}],"geoLocations":[],"fundingReferences":[],"url":"https://arxiv.org/abs/2602.19271","contentUrl":null,"metadataVersion":0,"schemaVersion":"http://datacite.org/schema/kernel-4","source":"mds","isActive":true,"state":"findable","reason":null,"viewCount":0,"downloadCount":0,"referenceCount":0,"citationCount":0,"partCount":0,"partOfCount":0,"versionCount":0,"versionOfCount":0,"created":"2026-02-25T14:53:33Z","registered":"2026-02-25T14:53:33Z","published":null,"updated":"2026-02-25T14:53:33Z"},"relationships":{"client":{"data":{"id":"arxiv.content","type":"clients"}}}},{"id":"10.48550/arxiv.2602.19270","type":"dois","attributes":{"doi":"10.48550/arxiv.2602.19270","identifiers":[{"identifier":"2602.19270","identifierType":"arXiv"}],"creators":[{"nameType":"Personal","givenName":"Eckehard","familyName":"Hermann","name":"Hermann, Eckehard","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Harald","familyName":"Lampesberger","name":"Lampesberger, Harald","affiliation":[],"nameIdentifiers":[]}],"titles":[{"title":"Hagenberg Risk Management Process (Part 2): From Context-Sensitive Triage to Case Analysis With Bowtie and Bayesian Networks"}],"publisher":"arXiv","container":{},"publicationYear":2026,"subjects":[{"subject":"Cryptography and Security (cs.CR)","lang":"en","subjectScheme":"arXiv"},{"subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"},{"schemeUri":"http://www.oecd.org/science/inno/38235147.pdf","subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"}],"contributors":[],"dates":[{"date":"2026-02-22T16:53:14Z","dateType":"Submitted","dateInformation":"v1"},{"date":"2026-02-24T01:55:20Z","dateType":"Updated","dateInformation":"v1"},{"date":"2026-02","dateType":"Available","dateInformation":"v1"},{"date":"2026","dateType":"Issued"}],"language":null,"types":{"schemaOrg":"CreativeWork","resourceTypeGeneral":"Preprint","citeproc":"article","bibtex":"misc","ris":"GEN","resourceType":"Article"},"relatedIdentifiers":[],"relatedItems":[],"sizes":[],"formats":[],"version":"1","rightsList":[{"rightsIdentifierScheme":"SPDX","rightsUri":"https://creativecommons.org/licenses/by-nc-nd/4.0/legalcode","schemeUri":"https://spdx.org/licenses/","rights":"Creative Commons Attribution Non Commercial No Derivatives 4.0 International","rightsIdentifier":"cc-by-nc-nd-4.0"}],"descriptions":[{"descriptionType":"Abstract","description":"Risk matrices (heatmaps) are widely used for information and cyber risk management and decision-making, yet they are often too coarse for today's resilience-driven organizational and system landscapes. Likelihood and impact (the two dimensions represented in a heatmap) can vary with operational conditions, third-party dependencies, and the effectiveness of technical and organizational controls. At the same time, organizations cannot afford to analyze and operationalize every identified risk with equal depth using more sophisticated methods, telemetry, and real-time decision logic. We therefore propose a traceable triage pipeline that connects broad, context-sensitive screening with selective deep-dive analysis of material risks.\n The Hagenberg Risk Management Process presented in this paper integrates three steps: (i) context-aware prioritization using multidimensional polar heatmaps to compare risks across multiple operational states, (ii) Bowtie analysis for triaged risks to structure causes, consequences, and barriers, and (iii) an automated transformation of Bowties into directed acyclic graphs as the structural basis for Bayesian networks. A distinctive feature is the explicit representation of barriers as activation nodes in the resulting graph, making control points visible and preparing for later intervention and what-if analyses. The approach is demonstrated on an instant-payments gateway scenario in which a faulty production change under peak load leads to cascading degradation and transaction loss; DORA serves as the reference framework for resilience requirements. The result is an end-to-end, tool-supported workflow that improves transparency, auditability, and operational readiness from prioritization to monitoring-oriented models."},{"descriptionType":"Other","description":"12 pages, 5 figures, 2 tables"}],"geoLocations":[],"fundingReferences":[],"url":"https://arxiv.org/abs/2602.19270","contentUrl":null,"metadataVersion":0,"schemaVersion":"http://datacite.org/schema/kernel-4","source":"mds","isActive":true,"state":"findable","reason":null,"viewCount":0,"downloadCount":0,"referenceCount":0,"citationCount":0,"partCount":0,"partOfCount":0,"versionCount":0,"versionOfCount":0,"created":"2026-02-25T14:53:30Z","registered":"2026-02-25T14:53:31Z","published":null,"updated":"2026-02-25T14:53:31Z"},"relationships":{"client":{"data":{"id":"arxiv.content","type":"clients"}}}},{"id":"10.48550/arxiv.2602.19269","type":"dois","attributes":{"doi":"10.48550/arxiv.2602.19269","identifiers":[{"identifier":"2602.19269","identifierType":"arXiv"}],"creators":[{"nameType":"Personal","givenName":"Eike","familyName":"Lau","name":"Lau, Eike","affiliation":[],"nameIdentifiers":[]}],"titles":[{"title":"Perfect complexes on finite flat affine groupoids"}],"publisher":"arXiv","container":{},"publicationYear":2026,"subjects":[{"subject":"Algebraic Geometry (math.AG)","lang":"en","subjectScheme":"arXiv"},{"subject":"Representation Theory (math.RT)","lang":"en","subjectScheme":"arXiv"},{"subject":"FOS: Mathematics","subjectScheme":"Fields of Science and Technology (FOS)"},{"schemeUri":"http://www.oecd.org/science/inno/38235147.pdf","subject":"FOS: Mathematics","subjectScheme":"Fields of Science and Technology (FOS)"}],"contributors":[],"dates":[{"date":"2026-02-22T16:52:52Z","dateType":"Submitted","dateInformation":"v1"},{"date":"2026-02-24T01:55:20Z","dateType":"Updated","dateInformation":"v1"},{"date":"2026-02","dateType":"Available","dateInformation":"v1"},{"date":"2026","dateType":"Issued"}],"language":null,"types":{"schemaOrg":"CreativeWork","resourceTypeGeneral":"Preprint","citeproc":"article","bibtex":"misc","ris":"GEN","resourceType":"Article"},"relatedIdentifiers":[],"relatedItems":[],"sizes":[],"formats":[],"version":"1","rightsList":[{"rightsUri":"http://arxiv.org/licenses/nonexclusive-distrib/1.0/","rights":"arXiv.org perpetual, non-exclusive license"}],"descriptions":[{"descriptionType":"Abstract","description":"We compute the Balmer spectrum of the category of perfect complexes on an algebraic stack admitting a finite locally free cover by an affine scheme and identify it with the homogeneous spectrum of the cohomology ring."},{"descriptionType":"Other","description":"20 pages"}],"geoLocations":[],"fundingReferences":[],"url":"https://arxiv.org/abs/2602.19269","contentUrl":null,"metadataVersion":0,"schemaVersion":"http://datacite.org/schema/kernel-4","source":"mds","isActive":true,"state":"findable","reason":null,"viewCount":0,"downloadCount":0,"referenceCount":0,"citationCount":0,"partCount":0,"partOfCount":0,"versionCount":0,"versionOfCount":0,"created":"2026-02-25T14:53:28Z","registered":"2026-02-25T14:53:28Z","published":null,"updated":"2026-02-25T14:53:28Z"},"relationships":{"client":{"data":{"id":"arxiv.content","type":"clients"}}}},{"id":"10.48550/arxiv.2602.19268","type":"dois","attributes":{"doi":"10.48550/arxiv.2602.19268","identifiers":[{"identifier":"2602.19268","identifierType":"arXiv"}],"creators":[{"nameType":"Personal","givenName":"Sonu","familyName":"Kumar","name":"Kumar, Sonu","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Mohd Faisal","familyName":"Khan","name":"Khan, Mohd Faisal","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Mukul","familyName":"Lokhande","name":"Lokhande, Mukul","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Santosh Kumar","familyName":"Vishvakarma","name":"Vishvakarma, Santosh Kumar","affiliation":[],"nameIdentifiers":[]}],"titles":[{"title":"CORVET: A CORDIC-Powered, Resource-Frugal Mixed-Precision Vector Processing Engine for High-Throughput AIoT applications"}],"publisher":"arXiv","container":{},"publicationYear":2026,"subjects":[{"subject":"Hardware Architecture (cs.AR)","lang":"en","subjectScheme":"arXiv"},{"subject":"Artificial Intelligence (cs.AI)","lang":"en","subjectScheme":"arXiv"},{"subject":"Computer Vision and Pattern Recognition (cs.CV)","lang":"en","subjectScheme":"arXiv"},{"subject":"Neural and Evolutionary Computing (cs.NE)","lang":"en","subjectScheme":"arXiv"},{"subject":"Image and Video Processing (eess.IV)","lang":"en","subjectScheme":"arXiv"},{"subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"},{"schemeUri":"http://www.oecd.org/science/inno/38235147.pdf","subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"},{"subject":"FOS: Electrical engineering, electronic engineering, information engineering","subjectScheme":"Fields of Science and Technology (FOS)"},{"schemeUri":"http://www.oecd.org/science/inno/38235147.pdf","subject":"FOS: Electrical engineering, electronic engineering, information engineering","subjectScheme":"Fields of Science and Technology (FOS)"}],"contributors":[],"dates":[{"date":"2026-02-22T16:51:17Z","dateType":"Submitted","dateInformation":"v1"},{"date":"2026-02-24T01:55:18Z","dateType":"Updated","dateInformation":"v1"},{"date":"2026-02","dateType":"Available","dateInformation":"v1"},{"date":"2026","dateType":"Issued"}],"language":null,"types":{"schemaOrg":"CreativeWork","resourceTypeGeneral":"Preprint","citeproc":"article","bibtex":"misc","ris":"GEN","resourceType":"Article"},"relatedIdentifiers":[],"relatedItems":[],"sizes":[],"formats":[],"version":"1","rightsList":[{"rightsIdentifierScheme":"SPDX","rightsUri":"https://creativecommons.org/licenses/by/4.0/legalcode","schemeUri":"https://spdx.org/licenses/","rights":"Creative Commons Attribution 4.0 International","rightsIdentifier":"cc-by-4.0"}],"descriptions":[{"descriptionType":"Abstract","description":"This brief presents a runtime-adaptive, performance-enhanced vector engine featuring a low-resource, iterative CORDIC-based MAC unit for edge AI acceleration. The proposed design enables dynamic reconfiguration between approximate and accurate modes, exploiting the latency-accuracy trade-off for a wide range of workloads. Its resource-efficient approach further enables up to 4x throughput improvement within the same hardware resources by leveraging vectorised, time-multiplexed execution and flexible precision scaling. With a time-multiplexed multi-AF block and a lightweight pooling and normalisation unit, the proposed vector engine supports flexible precision (4/8/16-bit) and high MAC density. The ASIC implementation results show that each MAC stage can save up to 33% of time and 21% of power, with a 256-PE configuration that achieves higher compute density (4.83 TOPS/mm2 ) and energy efficiency (11.67 TOPS/W) than previous state-of-the-art work. A detailed hardware-software co-design methodology for object detection and classification tasks on Pynq-Z2 is discussed to assess the proposed architecture, demonstrating a scalable, energy-efficient solution for edge AI applications."}],"geoLocations":[],"fundingReferences":[],"url":"https://arxiv.org/abs/2602.19268","contentUrl":null,"metadataVersion":0,"schemaVersion":"http://datacite.org/schema/kernel-4","source":"mds","isActive":true,"state":"findable","reason":null,"viewCount":0,"downloadCount":0,"referenceCount":0,"citationCount":0,"partCount":0,"partOfCount":0,"versionCount":0,"versionOfCount":0,"created":"2026-02-25T14:53:25Z","registered":"2026-02-25T14:53:26Z","published":null,"updated":"2026-02-25T14:53:26Z"},"relationships":{"client":{"data":{"id":"arxiv.content","type":"clients"}}}},{"id":"10.48550/arxiv.2602.19265","type":"dois","attributes":{"doi":"10.48550/arxiv.2602.19265","identifiers":[{"identifier":"2602.19265","identifierType":"arXiv"}],"creators":[{"nameType":"Personal","givenName":"Siavash","familyName":"Khodakarami","name":"Khodakarami, Siavash","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Vivek","familyName":"Oommen","name":"Oommen, Vivek","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Nazanin Ahmadi","familyName":"Daryakenari","name":"Daryakenari, Nazanin Ahmadi","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Maxim","familyName":"Beekenkamp","name":"Beekenkamp, Maxim","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"George Em","familyName":"Karniadakis","name":"Karniadakis, George Em","affiliation":[],"nameIdentifiers":[]}],"titles":[{"title":"Spectral bias in physics-informed and operator learning: Analysis and mitigation guidelines"}],"publisher":"arXiv","container":{},"publicationYear":2026,"subjects":[{"subject":"Machine Learning (cs.LG)","lang":"en","subjectScheme":"arXiv"},{"subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"},{"schemeUri":"http://www.oecd.org/science/inno/38235147.pdf","subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"}],"contributors":[],"dates":[{"date":"2026-02-22T16:29:18Z","dateType":"Submitted","dateInformation":"v1"},{"date":"2026-02-24T01:54:48Z","dateType":"Updated","dateInformation":"v1"},{"date":"2026-02","dateType":"Available","dateInformation":"v1"},{"date":"2026","dateType":"Issued"}],"language":null,"types":{"schemaOrg":"CreativeWork","resourceTypeGeneral":"Preprint","citeproc":"article","bibtex":"misc","ris":"GEN","resourceType":"Article"},"relatedIdentifiers":[],"relatedItems":[],"sizes":[],"formats":[],"version":"1","rightsList":[{"rightsIdentifierScheme":"SPDX","rightsUri":"https://creativecommons.org/licenses/by-nc-nd/4.0/legalcode","schemeUri":"https://spdx.org/licenses/","rights":"Creative Commons Attribution Non Commercial No Derivatives 4.0 International","rightsIdentifier":"cc-by-nc-nd-4.0"}],"descriptions":[{"descriptionType":"Abstract","description":"Solving partial differential equations (PDEs) by neural networks as well as Kolmogorov-Arnold Networks (KANs), including physics-informed neural networks (PINNs), physics-informed KANs (PIKANs), and neural operators, are known to exhibit spectral bias, whereby low-frequency components of the solution are learned significantly faster than high-frequency modes. While spectral bias is often treated as an intrinsic representational limitation of neural architectures, its interaction with optimization dynamics and physics-based loss formulations remains poorly understood. In this work, we provide a systematic investigation of spectral bias in physics-informed and operator learning frameworks, with emphasis on the coupled roles of network architecture, activation functions, loss design, and optimization strategy. We quantify spectral bias through frequency-resolved error metrics, Barron-norm diagnostics, and higher-order statistical moments, enabling a unified analysis across elliptic, hyperbolic, and dispersive PDEs. Through diverse benchmark problems, including the Korteweg-de Vries, wave and steady-state diffusion-reaction equations, turbulent flow reconstruction, and earthquake dynamics, we demonstrate that spectral bias is not simply representational but fundamentally dynamical. In particular, second-order optimization methods substantially alter the spectral learning order, enabling earlier and more accurate recovery of high-frequency modes for all PDE types. For neural operators, we further show that spectral bias is dependent on the neural operator architecture and can also be effectively mitigated through spectral-aware loss formulations without increasing the inference cost."}],"geoLocations":[],"fundingReferences":[],"url":"https://arxiv.org/abs/2602.19265","contentUrl":null,"metadataVersion":0,"schemaVersion":"http://datacite.org/schema/kernel-4","source":"mds","isActive":true,"state":"findable","reason":null,"viewCount":0,"downloadCount":0,"referenceCount":0,"citationCount":0,"partCount":0,"partOfCount":0,"versionCount":0,"versionOfCount":0,"created":"2026-02-25T14:53:17Z","registered":"2026-02-25T14:53:18Z","published":null,"updated":"2026-02-25T14:53:18Z"},"relationships":{"client":{"data":{"id":"arxiv.content","type":"clients"}}}},{"id":"10.48550/arxiv.2602.19263","type":"dois","attributes":{"doi":"10.48550/arxiv.2602.19263","identifiers":[{"identifier":"2602.19263","identifierType":"arXiv"}],"creators":[{"nameType":"Personal","givenName":"Kani","familyName":"Fu","name":"Fu, Kani","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Sanduni S Disanayaka","familyName":"Mudiyanselage","name":"Mudiyanselage, Sanduni S Disanayaka","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Chunli","familyName":"Dai","name":"Dai, Chunli","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Minhee","familyName":"Kim","name":"Kim, Minhee","affiliation":[],"nameIdentifiers":[]}],"titles":[{"title":"Prognostics of Multisensor Systems with Unknown and Unlabeled Failure Modes via Bayesian Nonparametric Process Mixtures"}],"publisher":"arXiv","container":{},"publicationYear":2026,"subjects":[{"subject":"Applications (stat.AP)","lang":"en","subjectScheme":"arXiv"},{"subject":"Machine Learning (cs.LG)","lang":"en","subjectScheme":"arXiv"},{"subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"},{"schemeUri":"http://www.oecd.org/science/inno/38235147.pdf","subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"}],"contributors":[],"dates":[{"date":"2026-02-22T16:26:51Z","dateType":"Submitted","dateInformation":"v1"},{"date":"2026-02-24T01:54:45Z","dateType":"Updated","dateInformation":"v1"},{"date":"2026-02","dateType":"Available","dateInformation":"v1"},{"date":"2026","dateType":"Issued"}],"language":null,"types":{"schemaOrg":"CreativeWork","resourceTypeGeneral":"Preprint","citeproc":"article","bibtex":"misc","ris":"GEN","resourceType":"Article"},"relatedIdentifiers":[],"relatedItems":[],"sizes":[],"formats":[],"version":"1","rightsList":[{"rightsUri":"http://arxiv.org/licenses/nonexclusive-distrib/1.0/","rights":"arXiv.org perpetual, non-exclusive license"}],"descriptions":[{"descriptionType":"Abstract","description":"Modern manufacturing systems often experience multiple and unpredictable failure behaviors, yet most existing prognostic models assume a fixed, known set of failure modes with labeled historical data. This assumption limits the use of digital twins for predictive maintenance, especially in high-mix or adaptive production environments, where new failure modes may emerge, and the failure mode labels may be unavailable.\n To address these challenges, we propose a novel Bayesian nonparametric framework that unifies a Dirichlet process mixture module for unsupervised failure mode discovery with a neural network-based prognostic module. The key innovation lies in an iterative feedback mechanism to jointly learn two modules. These modules iteratively update one another to dynamically infer, expand, or merge failure modes as new data arrive while providing high prognostic accuracy.\n Experiments on both simulation and aircraft engine datasets show that the proposed approach performs competitively with or significantly better than existing approaches. It also exhibits robust online adaptation capabilities, making it well-suited for digital-twin-based system health management in complex manufacturing environments."}],"geoLocations":[],"fundingReferences":[],"url":"https://arxiv.org/abs/2602.19263","contentUrl":null,"metadataVersion":0,"schemaVersion":"http://datacite.org/schema/kernel-4","source":"mds","isActive":true,"state":"findable","reason":null,"viewCount":0,"downloadCount":0,"referenceCount":0,"citationCount":0,"partCount":0,"partOfCount":0,"versionCount":0,"versionOfCount":0,"created":"2026-02-25T14:53:12Z","registered":"2026-02-25T14:53:13Z","published":null,"updated":"2026-02-25T14:53:13Z"},"relationships":{"client":{"data":{"id":"arxiv.content","type":"clients"}}}},{"id":"10.48550/arxiv.2602.19262","type":"dois","attributes":{"doi":"10.48550/arxiv.2602.19262","identifiers":[{"identifier":"2602.19262","identifierType":"arXiv"}],"creators":[{"nameType":"Personal","givenName":"Jieming","familyName":"Sun","name":"Sun, Jieming","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Lichun","familyName":"Li","name":"Li, Lichun","affiliation":[],"nameIdentifiers":[]}],"titles":[{"title":"A data-driven model-free physical-informed deep operator network for solving nonlinear dynamic system"}],"publisher":"arXiv","container":{},"publicationYear":2026,"subjects":[{"subject":"Signal Processing (eess.SP)","lang":"en","subjectScheme":"arXiv"},{"subject":"FOS: Electrical engineering, electronic engineering, information engineering","subjectScheme":"Fields of Science and Technology (FOS)"},{"schemeUri":"http://www.oecd.org/science/inno/38235147.pdf","subject":"FOS: Electrical engineering, electronic engineering, information engineering","subjectScheme":"Fields of Science and Technology (FOS)"}],"contributors":[],"dates":[{"date":"2026-02-22T16:25:43Z","dateType":"Submitted","dateInformation":"v1"},{"date":"2026-02-24T01:54:43Z","dateType":"Updated","dateInformation":"v1"},{"date":"2026-02","dateType":"Available","dateInformation":"v1"},{"date":"2026","dateType":"Issued"}],"language":null,"types":{"schemaOrg":"CreativeWork","resourceTypeGeneral":"Preprint","citeproc":"article","bibtex":"misc","ris":"GEN","resourceType":"Article"},"relatedIdentifiers":[],"relatedItems":[],"sizes":[],"formats":[],"version":"1","rightsList":[{"rightsIdentifierScheme":"SPDX","rightsUri":"https://creativecommons.org/licenses/by/4.0/legalcode","schemeUri":"https://spdx.org/licenses/","rights":"Creative Commons Attribution 4.0 International","rightsIdentifier":"cc-by-4.0"}],"descriptions":[{"descriptionType":"Abstract","description":"The existing physical-informed Deep Operator Networks are mostly based on either the well-known mathematical formula of the system or huge amounts of data for different scenarios. However, in some cases, it is difficult to get the exact mathematical formula and vast amounts of data in some dynamic systems, we can only get a few experimental data or limited mathematical information. To address the cases, we propose a data-driven model-free physical-informed Deep Operator Network (DeepOnet) framework to learn the nonlinear dynamic systems from few available data. We first explore the short-term dependence of the available data and use a surrogate machine learning model to extract the short-term dependence. Then, the surrogate machine learning model is incorporated into the DeepOnet as the physical information part. Then, the constructed DeepOnet is trained to simulate the system's dynamic response for given control inputs and initial conditions. Numerical experiments on different systems confirm that our DeepOnet framework learns to approximate the dynamic response of some nonlinear dynamic systems effectively."}],"geoLocations":[],"fundingReferences":[],"url":"https://arxiv.org/abs/2602.19262","contentUrl":null,"metadataVersion":0,"schemaVersion":"http://datacite.org/schema/kernel-4","source":"mds","isActive":true,"state":"findable","reason":null,"viewCount":0,"downloadCount":0,"referenceCount":0,"citationCount":0,"partCount":0,"partOfCount":0,"versionCount":0,"versionOfCount":0,"created":"2026-02-25T14:53:10Z","registered":"2026-02-25T14:53:11Z","published":null,"updated":"2026-02-25T14:53:11Z"},"relationships":{"client":{"data":{"id":"arxiv.content","type":"clients"}}}},{"id":"10.48550/arxiv.2602.19260","type":"dois","attributes":{"doi":"10.48550/arxiv.2602.19260","identifiers":[{"identifier":"2602.19260","identifierType":"arXiv"}],"creators":[{"nameType":"Personal","givenName":"Timothy","familyName":"Duggan","name":"Duggan, Timothy","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Pierrick","familyName":"Lorang","name":"Lorang, Pierrick","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Hong","familyName":"Lu","name":"Lu, Hong","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Matthias","familyName":"Scheutz","name":"Scheutz, Matthias","affiliation":[],"nameIdentifiers":[]}],"titles":[{"title":"The Price Is Not Right: Neuro-Symbolic Methods Outperform VLAs on Structured Long-Horizon Manipulation Tasks with Significantly Lower Energy Consumption"}],"publisher":"arXiv","container":{},"publicationYear":2026,"subjects":[{"subject":"Robotics (cs.RO)","lang":"en","subjectScheme":"arXiv"},{"subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"},{"schemeUri":"http://www.oecd.org/science/inno/38235147.pdf","subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"}],"contributors":[],"dates":[{"date":"2026-02-22T16:22:06Z","dateType":"Submitted","dateInformation":"v1"},{"date":"2026-02-24T01:54:38Z","dateType":"Updated","dateInformation":"v1"},{"date":"2026-02","dateType":"Available","dateInformation":"v1"},{"date":"2026","dateType":"Issued"}],"language":null,"types":{"schemaOrg":"CreativeWork","resourceTypeGeneral":"Preprint","citeproc":"article","bibtex":"misc","ris":"GEN","resourceType":"Article"},"relatedIdentifiers":[],"relatedItems":[],"sizes":[],"formats":[],"version":"1","rightsList":[{"rightsIdentifierScheme":"SPDX","rightsUri":"https://creativecommons.org/licenses/by-nc-nd/4.0/legalcode","schemeUri":"https://spdx.org/licenses/","rights":"Creative Commons Attribution Non Commercial No Derivatives 4.0 International","rightsIdentifier":"cc-by-nc-nd-4.0"}],"descriptions":[{"descriptionType":"Abstract","description":"Vision-Language-Action (VLA) models have recently been proposed as a pathway toward generalist robotic policies capable of interpreting natural language and visual inputs to generate manipulation actions. However, their effectiveness and efficiency on structured, long-horizon manipulation tasks remain unclear. In this work, we present a head-to-head empirical comparison between a fine-tuned open-weight VLA model π0 and a neuro-symbolic architecture that combines PDDL-based symbolic planning with learned low-level control. We evaluate both approaches on structured variants of the Towers of Hanoi manipulation task in simulation while measuring both task performance and energy consumption during training and execution. On the 3-block task, the neuro-symbolic model achieves 95% success compared to 34% for the best-performing VLA. The neuro-symbolic model also generalizes to an unseen 4-block variant (78% success), whereas both VLAs fail to complete the task. During training, VLA fine-tuning consumes nearly two orders of magnitude more energy than the neuro-symbolic approach. These results highlight important trade-offs between end-to-end foundation-model approaches and structured reasoning architectures for long-horizon robotic manipulation, emphasizing the role of explicit symbolic structure in improving reliability, data efficiency, and energy efficiency. Code and models are available at https://price-is-not-right.github.io"},{"descriptionType":"Other","description":"Accepted at the 2026 IEEE International Conference on Robotics \u0026amp; Automation (ICRA 2026)"}],"geoLocations":[],"fundingReferences":[],"url":"https://arxiv.org/abs/2602.19260","contentUrl":null,"metadataVersion":0,"schemaVersion":"http://datacite.org/schema/kernel-4","source":"mds","isActive":true,"state":"findable","reason":null,"viewCount":0,"downloadCount":0,"referenceCount":0,"citationCount":0,"partCount":0,"partOfCount":0,"versionCount":0,"versionOfCount":0,"created":"2026-02-25T14:53:05Z","registered":"2026-02-25T14:53:06Z","published":null,"updated":"2026-02-25T14:53:06Z"},"relationships":{"client":{"data":{"id":"arxiv.content","type":"clients"}}}},{"id":"10.48550/arxiv.2602.19259","type":"dois","attributes":{"doi":"10.48550/arxiv.2602.19259","identifiers":[{"identifier":"2602.19259","identifierType":"arXiv"}],"creators":[{"nameType":"Personal","givenName":"Sajjad","familyName":"Hashemian","name":"Hashemian, Sajjad","affiliation":[],"nameIdentifiers":[]}],"titles":[{"title":"Quantum Sketches, Hashing, and Approximate Nearest Neighbors"}],"publisher":"arXiv","container":{},"publicationYear":2026,"subjects":[{"subject":"Quantum Physics (quant-ph)","lang":"en","subjectScheme":"arXiv"},{"subject":"Data Structures and Algorithms (cs.DS)","lang":"en","subjectScheme":"arXiv"},{"subject":"FOS: Physical sciences","subjectScheme":"Fields of Science and Technology (FOS)"},{"schemeUri":"http://www.oecd.org/science/inno/38235147.pdf","subject":"FOS: Physical sciences","subjectScheme":"Fields of Science and Technology (FOS)"},{"subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"},{"schemeUri":"http://www.oecd.org/science/inno/38235147.pdf","subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"}],"contributors":[],"dates":[{"date":"2026-02-22T16:18:36Z","dateType":"Submitted","dateInformation":"v1"},{"date":"2026-02-24T01:54:34Z","dateType":"Updated","dateInformation":"v1"},{"date":"2026-02","dateType":"Available","dateInformation":"v1"},{"date":"2026","dateType":"Issued"}],"language":null,"types":{"schemaOrg":"CreativeWork","resourceTypeGeneral":"Preprint","citeproc":"article","bibtex":"misc","ris":"GEN","resourceType":"Article"},"relatedIdentifiers":[],"relatedItems":[],"sizes":[],"formats":[],"version":"1","rightsList":[{"rightsIdentifierScheme":"SPDX","rightsUri":"https://creativecommons.org/licenses/by/4.0/legalcode","schemeUri":"https://spdx.org/licenses/","rights":"Creative Commons Attribution 4.0 International","rightsIdentifier":"cc-by-4.0"}],"descriptions":[{"descriptionType":"Abstract","description":"Motivated by Johnson--Lindenstrauss dimension reduction, amplitude encoding, and the view of measurements as hash-like primitives, one might hope to compress an $n$-point approximate nearest neighbor (ANN) data structure into $O(\\log n)$ qubits. We rule out this possibility in a broad quantum sketch model, the dataset $P$ is encoded as an $m$-qubit state $ρ_P$, and each query is answered by an arbitrary query-dependent measurement on a fresh copy of $ρ_P$. For every approximation factor $c\\ge 1$ and constant success probability $p\u0026gt;1/2$, we exhibit $n$-point instances in Hamming space $\\{0,1\\}^d$ with $d=Θ(\\log n)$ for which any such sketch requires $m=Ω(n)$ qubits, via a reduction to quantum random access codes and Nayak's lower bound. These memory lower bounds coexist with potential quantum query-time gains and in candidate-scanning abstractions of hashing-based ANN, amplitude amplification yields a quadratic reduction in candidate checks, which is essentially optimal by Grover/BBBV-type bounds."},{"descriptionType":"Other","description":"8 pages, 1 figure, submitted to journal of Information and Computation"}],"geoLocations":[],"fundingReferences":[],"url":"https://arxiv.org/abs/2602.19259","contentUrl":null,"metadataVersion":0,"schemaVersion":"http://datacite.org/schema/kernel-4","source":"mds","isActive":true,"state":"findable","reason":null,"viewCount":0,"downloadCount":0,"referenceCount":0,"citationCount":0,"partCount":0,"partOfCount":0,"versionCount":0,"versionOfCount":0,"created":"2026-02-25T14:53:02Z","registered":"2026-02-25T14:53:03Z","published":null,"updated":"2026-02-25T14:53:03Z"},"relationships":{"client":{"data":{"id":"arxiv.content","type":"clients"}}}},{"id":"10.48550/arxiv.2602.19258","type":"dois","attributes":{"doi":"10.48550/arxiv.2602.19258","identifiers":[{"identifier":"2602.19258","identifierType":"arXiv"}],"creators":[{"nameType":"Personal","givenName":"J. C. Bellizotti","familyName":"Souza","name":"Souza, J. C. Bellizotti","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"C. J. O.","familyName":"Reichhardt","name":"Reichhardt, C. J. O.","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"A.","familyName":"Saxena","name":"Saxena, A.","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"C.","familyName":"Reichhardt","name":"Reichhardt, C.","affiliation":[],"nameIdentifiers":[]}],"titles":[{"title":"Dynamics and Pinning for Skyrmions in Altermagnets"}],"publisher":"arXiv","container":{},"publicationYear":2026,"subjects":[{"subject":"Mesoscale and Nanoscale Physics (cond-mat.mes-hall)","lang":"en","subjectScheme":"arXiv"},{"subject":"FOS: Physical sciences","subjectScheme":"Fields of Science and Technology (FOS)"},{"schemeUri":"http://www.oecd.org/science/inno/38235147.pdf","subject":"FOS: Physical sciences","subjectScheme":"Fields of Science and Technology (FOS)"}],"contributors":[],"dates":[{"date":"2026-02-22T16:15:50Z","dateType":"Submitted","dateInformation":"v1"},{"date":"2026-02-24T01:54:25Z","dateType":"Updated","dateInformation":"v1"},{"date":"2026-02","dateType":"Available","dateInformation":"v1"},{"date":"2026","dateType":"Issued"}],"language":null,"types":{"schemaOrg":"CreativeWork","resourceTypeGeneral":"Preprint","citeproc":"article","bibtex":"misc","ris":"GEN","resourceType":"Article"},"relatedIdentifiers":[],"relatedItems":[],"sizes":[],"formats":[],"version":"1","rightsList":[{"rightsIdentifierScheme":"SPDX","rightsUri":"https://creativecommons.org/licenses/by/4.0/legalcode","schemeUri":"https://spdx.org/licenses/","rights":"Creative Commons Attribution 4.0 International","rightsIdentifier":"cc-by-4.0"}],"descriptions":[{"descriptionType":"Abstract","description":"We examine the dynamics, Hall angle, and pinning for N{é}el skyrmions in an altermagnet. Using an atomistic model, we show that skyrmion velocity and Hall angle dependence is anisotropic with respect to the direction of the drive, due to the fourfold symmetry implied by the two sublattices of the altermagnet. The skyrmion Hall angle and velocity at fixed drive show strong variations for increasing ratios of the exchange constant of the sublattices, $J_2/J_1$. This fourfold anisotropy of altermagnetic (ATM) skyrmions also leads to anisotropic pinning effects for an ATM skyrmion interacting with isotropic circular pinning sites. We also propose a simple particle model for this system that takes into account this anisotropy and find that it captures both the variations of the ATM skyrmion Hall angle and velocity as a function of drive direction, as also found in the atomistic simulations. Using this particle model, we examine ATM skyrmions interacting with a periodic array of pinning sites. For increasing ratios of $J_2/J_1$, we find a strongly non-monotonic ATM skyrmion velocity, where there is a minimum in the velocity where the skyrmion locks to different symmetry directions of the periodic pinning lattice. For a random array, we find that ATM skyrmions show strongly anisotropic depinning thresholds and velocity responses for different drive directions, and that the Hall angle is nearly constant with drive. In comparison, for the same parameters, the depinning threshold for a ferromagnetic (FM) skyrmion is lower, and the skyrmion Hall angle shows a strong velocity dependence. The lower depinning threshold for FM skyrmions is due to stronger Magnus forces."},{"descriptionType":"Other","description":"12 pages, 10 figures"}],"geoLocations":[],"fundingReferences":[],"url":"https://arxiv.org/abs/2602.19258","contentUrl":null,"metadataVersion":0,"schemaVersion":"http://datacite.org/schema/kernel-4","source":"mds","isActive":true,"state":"findable","reason":null,"viewCount":0,"downloadCount":0,"referenceCount":0,"citationCount":0,"partCount":0,"partOfCount":0,"versionCount":0,"versionOfCount":0,"created":"2026-02-25T14:53:00Z","registered":"2026-02-25T14:53:01Z","published":null,"updated":"2026-02-25T14:53:01Z"},"relationships":{"client":{"data":{"id":"arxiv.content","type":"clients"}}}},{"id":"10.48550/arxiv.2602.19256","type":"dois","attributes":{"doi":"10.48550/arxiv.2602.19256","identifiers":[{"identifier":"2602.19256","identifierType":"arXiv"}],"creators":[{"nameType":"Personal","givenName":"Maša","familyName":"Đorić","name":"Đorić, Maša","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Jelena","familyName":"Katić","name":"Katić, Jelena","affiliation":[],"nameIdentifiers":[]}],"titles":[{"title":"Polynomial entropy on regular curves"}],"publisher":"arXiv","container":{},"publicationYear":2026,"subjects":[{"subject":"Dynamical Systems (math.DS)","lang":"en","subjectScheme":"arXiv"},{"subject":"FOS: Mathematics","subjectScheme":"Fields of Science and Technology (FOS)"},{"schemeUri":"http://www.oecd.org/science/inno/38235147.pdf","subject":"FOS: Mathematics","subjectScheme":"Fields of Science and Technology (FOS)"},{"subject":"Primary 37E25, Secondary 54F15, 37B40","lang":"en","subjectScheme":"MSC"}],"contributors":[],"dates":[{"date":"2026-02-22T16:14:50Z","dateType":"Submitted","dateInformation":"v1"},{"date":"2026-02-24T01:54:18Z","dateType":"Updated","dateInformation":"v1"},{"date":"2026-02","dateType":"Available","dateInformation":"v1"},{"date":"2026","dateType":"Issued"}],"language":null,"types":{"schemaOrg":"CreativeWork","resourceTypeGeneral":"Preprint","citeproc":"article","bibtex":"misc","ris":"GEN","resourceType":"Article"},"relatedIdentifiers":[],"relatedItems":[],"sizes":[],"formats":[],"version":"1","rightsList":[{"rightsUri":"http://arxiv.org/licenses/nonexclusive-distrib/1.0/","rights":"arXiv.org perpetual, non-exclusive license"}],"descriptions":[{"descriptionType":"Abstract","description":"We show that the polynomial entropy of homeomorphisms on regular curves is bounded above by one. Moreover, the polynomial entropy equals one under the fairly mild condition that the homeomorphism possesses a wandering point. We obtain a rigidity result for homeomorphisms on local dendrites (and therefore on graphs and dendrites): their polynomial entropy is either zero or one."}],"geoLocations":[],"fundingReferences":[],"url":"https://arxiv.org/abs/2602.19256","contentUrl":null,"metadataVersion":0,"schemaVersion":"http://datacite.org/schema/kernel-4","source":"mds","isActive":true,"state":"findable","reason":null,"viewCount":0,"downloadCount":0,"referenceCount":0,"citationCount":0,"partCount":0,"partOfCount":0,"versionCount":0,"versionOfCount":0,"created":"2026-02-25T14:52:55Z","registered":"2026-02-25T14:52:56Z","published":null,"updated":"2026-02-25T14:52:56Z"},"relationships":{"client":{"data":{"id":"arxiv.content","type":"clients"}}}},{"id":"10.48550/arxiv.2602.19255","type":"dois","attributes":{"doi":"10.48550/arxiv.2602.19255","identifiers":[{"identifier":"2602.19255","identifierType":"arXiv"}],"creators":[{"nameType":"Personal","givenName":"AJ","familyName":"Bu","name":"Bu, AJ","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Manuel","familyName":"Kauers","name":"Kauers, Manuel","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Doron","familyName":"Zeilberger","name":"Zeilberger, Doron","affiliation":[],"nameIdentifiers":[]}],"titles":[{"title":"Statistical Analysis of Hairpins and BasePairs in RNA Secondary Structures"}],"publisher":"arXiv","container":{},"publicationYear":2026,"subjects":[{"subject":"Combinatorics (math.CO)","lang":"en","subjectScheme":"arXiv"},{"subject":"Symbolic Computation (cs.SC)","lang":"en","subjectScheme":"arXiv"},{"subject":"FOS: Mathematics","subjectScheme":"Fields of Science and Technology (FOS)"},{"schemeUri":"http://www.oecd.org/science/inno/38235147.pdf","subject":"FOS: Mathematics","subjectScheme":"Fields of Science and Technology (FOS)"},{"subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"},{"schemeUri":"http://www.oecd.org/science/inno/38235147.pdf","subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"}],"contributors":[],"dates":[{"date":"2026-02-22T16:11:22Z","dateType":"Submitted","dateInformation":"v1"},{"date":"2026-02-24T01:54:11Z","dateType":"Updated","dateInformation":"v1"},{"date":"2026-02","dateType":"Available","dateInformation":"v1"},{"date":"2026","dateType":"Issued"}],"language":null,"types":{"schemaOrg":"CreativeWork","resourceTypeGeneral":"Preprint","citeproc":"article","bibtex":"misc","ris":"GEN","resourceType":"Article"},"relatedIdentifiers":[],"relatedItems":[],"sizes":[],"formats":[],"version":"1","rightsList":[{"rightsIdentifierScheme":"SPDX","rightsUri":"https://creativecommons.org/licenses/by/4.0/legalcode","schemeUri":"https://spdx.org/licenses/","rights":"Creative Commons Attribution 4.0 International","rightsIdentifier":"cc-by-4.0"}],"descriptions":[{"descriptionType":"Abstract","description":"We derive precise asymptotic expressions for the expectations, variances, covariance, and quite a few further mixed moments for the number of hairpins and the number of basepairs in RNA secondary structures, and give convincing evidence that the central-scaled distribution of the pair of random variables (hairpins, basepairs) tends in distribution to the bi-variate normal distribution with correlation $\\sqrt{5 \\sqrt{5} -11}/2= 0.2123322205\\dots$"}],"geoLocations":[],"fundingReferences":[],"url":"https://arxiv.org/abs/2602.19255","contentUrl":null,"metadataVersion":0,"schemaVersion":"http://datacite.org/schema/kernel-4","source":"mds","isActive":true,"state":"findable","reason":null,"viewCount":0,"downloadCount":0,"referenceCount":0,"citationCount":0,"partCount":0,"partOfCount":0,"versionCount":0,"versionOfCount":0,"created":"2026-02-25T14:52:52Z","registered":"2026-02-25T14:52:53Z","published":null,"updated":"2026-02-25T14:52:53Z"},"relationships":{"client":{"data":{"id":"arxiv.content","type":"clients"}}}},{"id":"10.48550/arxiv.2602.19254","type":"dois","attributes":{"doi":"10.48550/arxiv.2602.19254","identifiers":[{"identifier":"2602.19254","identifierType":"arXiv"}],"creators":[{"nameType":"Personal","givenName":"Bowen","familyName":"Chen","name":"Chen, Bowen","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Jake","familyName":"Zuena","name":"Zuena, Jake","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Alan C.","familyName":"Bovik","name":"Bovik, Alan C.","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Divya","familyName":"Kothandaraman","name":"Kothandaraman, Divya","affiliation":[],"nameIdentifiers":[]}],"titles":[{"title":"RegionRoute: Regional Style Transfer with Diffusion Model"}],"publisher":"arXiv","container":{},"publicationYear":2026,"subjects":[{"subject":"Computer Vision and Pattern Recognition (cs.CV)","lang":"en","subjectScheme":"arXiv"},{"subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"},{"schemeUri":"http://www.oecd.org/science/inno/38235147.pdf","subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"}],"contributors":[],"dates":[{"date":"2026-02-22T16:11:07Z","dateType":"Submitted","dateInformation":"v1"},{"date":"2026-02-24T01:54:07Z","dateType":"Updated","dateInformation":"v1"},{"date":"2026-02","dateType":"Available","dateInformation":"v1"},{"date":"2026","dateType":"Issued"}],"language":null,"types":{"schemaOrg":"CreativeWork","resourceTypeGeneral":"Preprint","citeproc":"article","bibtex":"misc","ris":"GEN","resourceType":"Article"},"relatedIdentifiers":[],"relatedItems":[],"sizes":[],"formats":[],"version":"1","rightsList":[{"rightsUri":"http://arxiv.org/licenses/nonexclusive-distrib/1.0/","rights":"arXiv.org perpetual, non-exclusive license"}],"descriptions":[{"descriptionType":"Abstract","description":"Precise spatial control in diffusion-based style transfer remains challenging. This challenge arises because diffusion models treat style as a global feature and lack explicit spatial grounding of style representations, making it difficult to restrict style application to specific objects or regions. To our knowledge, existing diffusion models are unable to perform true localized style transfer, typically relying on handcrafted masks or multi-stage post-processing that introduce boundary artifacts and limit generalization. To address this, we propose an attention-supervised diffusion framework that explicitly teaches the model where to apply a given style by aligning the attention scores of style tokens with object masks during training. Two complementary objectives, a Focus loss based on KL divergence and a Cover loss using binary cross-entropy, jointly encourage accurate localization and dense coverage. A modular LoRA-MoE design further enables efficient and scalable multi-style adaptation. To evaluate localized stylization, we introduce the Regional Style Editing Score, which measures Regional Style Matching through CLIP-based similarity within the target region and Identity Preservation via masked LPIPS and pixel-level consistency on unedited areas. Experiments show that our method achieves mask-free, single-object style transfer at inference, producing regionally accurate and visually coherent results that outperform existing diffusion-based editing approaches."}],"geoLocations":[],"fundingReferences":[],"url":"https://arxiv.org/abs/2602.19254","contentUrl":null,"metadataVersion":0,"schemaVersion":"http://datacite.org/schema/kernel-4","source":"mds","isActive":true,"state":"findable","reason":null,"viewCount":0,"downloadCount":0,"referenceCount":0,"citationCount":0,"partCount":0,"partOfCount":0,"versionCount":0,"versionOfCount":0,"created":"2026-02-25T14:52:50Z","registered":"2026-02-25T14:52:51Z","published":null,"updated":"2026-02-25T14:52:51Z"},"relationships":{"client":{"data":{"id":"arxiv.content","type":"clients"}}}},{"id":"10.48550/arxiv.2602.19252","type":"dois","attributes":{"doi":"10.48550/arxiv.2602.19252","identifiers":[{"identifier":"2602.19252","identifierType":"arXiv"}],"creators":[{"nameType":"Personal","givenName":"Junling","familyName":"Wang","name":"Wang, Junling","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Yi","familyName":"Guo","name":"Guo, Yi","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Bojun","familyName":"Yang","name":"Yang, Bojun","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Yazhou","familyName":"Yuan","name":"Yuan, Yazhou","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Zhenlin","familyName":"An","name":"An, Zhenlin","affiliation":[],"nameIdentifiers":[]}],"titles":[{"title":"MetaBlue: A Metasurface-Assisted Acoustic Underwater Localization System"}],"publisher":"arXiv","container":{},"publicationYear":2026,"subjects":[{"subject":"Networking and Internet Architecture (cs.NI)","lang":"en","subjectScheme":"arXiv"},{"subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"},{"schemeUri":"http://www.oecd.org/science/inno/38235147.pdf","subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"}],"contributors":[],"dates":[{"date":"2026-02-22T16:07:34Z","dateType":"Submitted","dateInformation":"v1"},{"date":"2026-02-24T01:54:04Z","dateType":"Updated","dateInformation":"v1"},{"date":"2026-02","dateType":"Available","dateInformation":"v1"},{"date":"2026","dateType":"Issued"}],"language":null,"types":{"schemaOrg":"CreativeWork","resourceTypeGeneral":"Preprint","citeproc":"article","bibtex":"misc","ris":"GEN","resourceType":"Article"},"relatedIdentifiers":[],"relatedItems":[],"sizes":[],"formats":[],"version":"1","rightsList":[{"rightsUri":"http://arxiv.org/licenses/nonexclusive-distrib/1.0/","rights":"arXiv.org perpetual, non-exclusive license"}],"descriptions":[{"descriptionType":"Abstract","description":"Underwater localization is essential for marine exploration and autonomous underwater operations, yet existing radio frequency and optical approaches are limited by rapid attenuation or limited visibility. Acoustic sensing remains the most practical choice, but conventional acoustic systems typically rely on large arrays or multiple synchronized anchors, resulting in high hardware costs and complex deployment. This paper introduces a novel low-cost passive acoustic metasurface, MetaBlue , explicitly designed for underwater localization, which, when attached to an ordinary ultrasonic transmitter, transforms it into a directional \"super-transmitter.\" The metasurface embeds direction-dependent spectral patterns into the transmitted waveform, enabling accurate angle-of-arrival (AoA) estimation using only a single hydrophone. For ranging, we present a new EM-acoustic mixed time-of-arrival (ToA) method that leverages the acoustic transducer's inherent low-frequency EM leakage as a timing reference, enabling precise ranging without shared clocks. This allows complete 3D localization with a single low-cost anchor. We evaluate the system across diverse real-world underwater settings, including pools, tanks, and outdoor environments. Experiments show that our design achieves an average AoA error of 8.7 degree and 3D localization error of 0.37 m at distances over 10 m. Even with a single anchor, the system maintains 0.73 m precision."}],"geoLocations":[],"fundingReferences":[],"url":"https://arxiv.org/abs/2602.19252","contentUrl":null,"metadataVersion":0,"schemaVersion":"http://datacite.org/schema/kernel-4","source":"mds","isActive":true,"state":"findable","reason":null,"viewCount":0,"downloadCount":0,"referenceCount":0,"citationCount":0,"partCount":0,"partOfCount":0,"versionCount":0,"versionOfCount":0,"created":"2026-02-25T14:52:45Z","registered":"2026-02-25T14:52:45Z","published":null,"updated":"2026-02-25T14:52:46Z"},"relationships":{"client":{"data":{"id":"arxiv.content","type":"clients"}}}},{"id":"10.48550/arxiv.2602.19250","type":"dois","attributes":{"doi":"10.48550/arxiv.2602.19250","identifiers":[{"identifier":"2602.19250","identifierType":"arXiv"}],"creators":[{"nameType":"Personal","givenName":"Carlos","familyName":"Navas-Merlo","name":"Navas-Merlo, Carlos","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Juan Carlos","familyName":"García-Escartín","name":"García-Escartín, Juan Carlos","affiliation":[],"nameIdentifiers":[]}],"titles":[{"title":"Eigenstate-assisted realization of general quantum controlled unitaries with a fixed cost"}],"publisher":"arXiv","container":{},"publicationYear":2026,"subjects":[{"subject":"Quantum Physics (quant-ph)","lang":"en","subjectScheme":"arXiv"},{"subject":"FOS: Physical sciences","subjectScheme":"Fields of Science and Technology (FOS)"},{"schemeUri":"http://www.oecd.org/science/inno/38235147.pdf","subject":"FOS: Physical sciences","subjectScheme":"Fields of Science and Technology (FOS)"}],"contributors":[],"dates":[{"date":"2026-02-22T16:06:01Z","dateType":"Submitted","dateInformation":"v1"},{"date":"2026-02-24T01:54:02Z","dateType":"Updated","dateInformation":"v1"},{"date":"2026-02","dateType":"Available","dateInformation":"v1"},{"date":"2026","dateType":"Issued"}],"language":null,"types":{"schemaOrg":"CreativeWork","resourceTypeGeneral":"Preprint","citeproc":"article","bibtex":"misc","ris":"GEN","resourceType":"Article"},"relatedIdentifiers":[],"relatedItems":[],"sizes":[],"formats":[],"version":"1","rightsList":[{"rightsUri":"http://arxiv.org/licenses/nonexclusive-distrib/1.0/","rights":"arXiv.org perpetual, non-exclusive license"}],"descriptions":[{"descriptionType":"Abstract","description":"Controlled unitary gates are a basic element in many quantum algorithms. Converting a general unitary $U$ with a known decomposition into its controlled version, controlled-$U$, can introduce a large overhead in terms of the depth of the circuit. We present a general method to take any unitary $U$ into controlled-$U$ using a fixed circuit with 4 CNOT gates and 2 Toffoli gates per qubit. For $n$-qubit unitaries and one control qubit, we require $2n+1$ qubits and a circuit that can generate an eigenstate of $U$, for which there are many cost-effective known algorithms. The method also works for any black block implementation of $U$, achieving a constant-depth realization independent of its decomposition. We illustrate its use in the Hadamard test and discuss applications to variational and quantum machine-learning algorithms."},{"descriptionType":"Other","description":"6 pages. 2 Figures. Comments welcome"}],"geoLocations":[],"fundingReferences":[],"url":"https://arxiv.org/abs/2602.19250","contentUrl":null,"metadataVersion":0,"schemaVersion":"http://datacite.org/schema/kernel-4","source":"mds","isActive":true,"state":"findable","reason":null,"viewCount":0,"downloadCount":0,"referenceCount":0,"citationCount":0,"partCount":0,"partOfCount":0,"versionCount":0,"versionOfCount":0,"created":"2026-02-25T14:52:40Z","registered":"2026-02-25T14:52:41Z","published":null,"updated":"2026-02-25T14:52:41Z"},"relationships":{"client":{"data":{"id":"arxiv.content","type":"clients"}}}},{"id":"10.48550/arxiv.2602.19249","type":"dois","attributes":{"doi":"10.48550/arxiv.2602.19249","identifiers":[{"identifier":"2602.19249","identifierType":"arXiv"}],"creators":[{"nameType":"Personal","givenName":"Sreekanth","familyName":"Ramesh","name":"Ramesh, Sreekanth","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Prashant K.","familyName":"Purohit","name":"Purohit, Prashant K.","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Yashashree","familyName":"Kulkarni","name":"Kulkarni, Yashashree","affiliation":[],"nameIdentifiers":[]}],"titles":[{"title":"On the Statistical Mechanics of Active Membranes: Some Selected Results"}],"publisher":"arXiv","container":{},"publicationYear":2026,"subjects":[{"subject":"Soft Condensed Matter (cond-mat.soft)","lang":"en","subjectScheme":"arXiv"},{"subject":"Statistical Mechanics (cond-mat.stat-mech)","lang":"en","subjectScheme":"arXiv"},{"subject":"FOS: Physical sciences","subjectScheme":"Fields of Science and Technology (FOS)"},{"schemeUri":"http://www.oecd.org/science/inno/38235147.pdf","subject":"FOS: Physical sciences","subjectScheme":"Fields of Science and Technology (FOS)"}],"contributors":[],"dates":[{"date":"2026-02-22T16:04:29Z","dateType":"Submitted","dateInformation":"v1"},{"date":"2026-02-24T01:53:57Z","dateType":"Updated","dateInformation":"v1"},{"date":"2026-02","dateType":"Available","dateInformation":"v1"},{"date":"2026","dateType":"Issued"}],"language":null,"types":{"schemaOrg":"CreativeWork","resourceTypeGeneral":"Preprint","citeproc":"article","bibtex":"misc","ris":"GEN","resourceType":"Article"},"relatedIdentifiers":[],"relatedItems":[],"sizes":[],"formats":[],"version":"1","rightsList":[{"rightsUri":"http://arxiv.org/licenses/nonexclusive-distrib/1.0/","rights":"arXiv.org perpetual, non-exclusive license"}],"descriptions":[{"descriptionType":"Abstract","description":"Biological membranes and vesicles play a central role in living systems, forming dynamic interfaces that regulate cellular organization and function. Classical descriptions of membrane mechanics that are rooted in equilibrium statistical mechanics and linear elasticity have yielded deep insights into membrane morphology and the role of thermal fluctuations on cellular function. However, real biological membranes operate far from equilibrium, continuously driven by active processes powered by energy consuming proteins. In this work, we employ a nonequilibrium statistical mechanics framework to model active membranes and derive analytical expressions for four fundamental properties that characterize their mechanical behavior: (a) the tension area relation, (b) the mean square amplitude of fluctuations, (c) correlation of normal vectors, and (d) the persistence length. These results collectively highlight the utility of fluctuation spectra as a starting point for elucidating membrane mechanics in both passive and active settings. Moreover, these results provide a theoretical basis for analyzing and interpreting fluctuation based assays of active membrane behavior."}],"geoLocations":[],"fundingReferences":[],"url":"https://arxiv.org/abs/2602.19249","contentUrl":null,"metadataVersion":0,"schemaVersion":"http://datacite.org/schema/kernel-4","source":"mds","isActive":true,"state":"findable","reason":null,"viewCount":0,"downloadCount":0,"referenceCount":0,"citationCount":0,"partCount":0,"partOfCount":0,"versionCount":0,"versionOfCount":0,"created":"2026-02-25T14:52:37Z","registered":"2026-02-25T14:52:38Z","published":null,"updated":"2026-02-25T14:52:38Z"},"relationships":{"client":{"data":{"id":"arxiv.content","type":"clients"}}}},{"id":"10.48550/arxiv.2602.19246","type":"dois","attributes":{"doi":"10.48550/arxiv.2602.19246","identifiers":[{"identifier":"2602.19246","identifierType":"arXiv"}],"creators":[{"nameType":"Personal","givenName":"Dilem","familyName":"Eşlik","name":"Eşlik, Dilem","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Bahadır Utku","familyName":"Kesgin","name":"Kesgin, Bahadır Utku","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Uğur","familyName":"Teğin","name":"Teğin, Uğur","affiliation":[],"nameIdentifiers":[]}],"titles":[{"title":"Recurrent neural networks implemented through spatiotemporal light propagation in optical fibers"}],"publisher":"arXiv","container":{},"publicationYear":2026,"subjects":[{"subject":"Optics (physics.optics)","lang":"en","subjectScheme":"arXiv"},{"subject":"FOS: Physical sciences","subjectScheme":"Fields of Science and Technology (FOS)"},{"schemeUri":"http://www.oecd.org/science/inno/38235147.pdf","subject":"FOS: Physical sciences","subjectScheme":"Fields of Science and Technology (FOS)"}],"contributors":[],"dates":[{"date":"2026-02-22T16:01:58Z","dateType":"Submitted","dateInformation":"v1"},{"date":"2026-02-24T01:53:52Z","dateType":"Updated","dateInformation":"v1"},{"date":"2026-02","dateType":"Available","dateInformation":"v1"},{"date":"2026","dateType":"Issued"}],"language":null,"types":{"schemaOrg":"CreativeWork","resourceTypeGeneral":"Preprint","citeproc":"article","bibtex":"misc","ris":"GEN","resourceType":"Article"},"relatedIdentifiers":[],"relatedItems":[],"sizes":[],"formats":[],"version":"1","rightsList":[{"rightsIdentifierScheme":"SPDX","rightsUri":"https://creativecommons.org/licenses/by-nc-nd/4.0/legalcode","schemeUri":"https://spdx.org/licenses/","rights":"Creative Commons Attribution Non Commercial No Derivatives 4.0 International","rightsIdentifier":"cc-by-nc-nd-4.0"}],"descriptions":[{"descriptionType":"Abstract","description":"Recurrent neural networks excel at temporal tasks and video processing but require energy-intensive sequential memory operations. We demonstrate that multimode optical fibers naturally implement spatiotemporal recurrent computation through passive light propagation. Video frames are encoded onto separate optical beams with controlled time delays; these beams combine and recirculate through a fiber loop where interference and nonlinear propagation generate high-dimensional states encoding both current inputs and fading memory. Remarkably, the entire optical system remains fixed with no trainable parameters or electronic feedback, yet this single physical configuration achieves competitive performance across diverse temporal and spatiotemporal learning tasks: chaotic time-series forecasting, human action recognition, steering angle prediction, and surgical skill assessment. Our results show that recurrent temporal processing can emerge directly from spatiotemporal wave dynamics. This paradigm shift from algorithmic to physical recurrence offers an energy-efficient pathway to temporal artificial intelligence by leveraging intrinsic spatiotemporal optical nonlinearities within multimode fibers."},{"descriptionType":"Other","description":"23 pages, 5 figures"}],"geoLocations":[],"fundingReferences":[],"url":"https://arxiv.org/abs/2602.19246","contentUrl":null,"metadataVersion":0,"schemaVersion":"http://datacite.org/schema/kernel-4","source":"mds","isActive":true,"state":"findable","reason":null,"viewCount":0,"downloadCount":0,"referenceCount":0,"citationCount":0,"partCount":0,"partOfCount":0,"versionCount":0,"versionOfCount":0,"created":"2026-02-25T14:52:30Z","registered":"2026-02-25T14:52:30Z","published":null,"updated":"2026-02-25T14:52:30Z"},"relationships":{"client":{"data":{"id":"arxiv.content","type":"clients"}}}},{"id":"10.48550/arxiv.2602.19245","type":"dois","attributes":{"doi":"10.48550/arxiv.2602.19245","identifiers":[{"identifier":"2602.19245","identifierType":"arXiv"}],"creators":[{"nameType":"Personal","givenName":"Edgar","familyName":"Gasperin","name":"Gasperin, Edgar","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Rodrigo Panosso","familyName":"Macedo","name":"Macedo, Rodrigo Panosso","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Justin","familyName":"Feng","name":"Feng, Justin","affiliation":[],"nameIdentifiers":[]}],"titles":[{"title":"The linearised conformal Einstein field equations around a Petrov-type~D spacetime: the conformal Teukolsky equation"}],"publisher":"arXiv","container":{},"publicationYear":2026,"subjects":[{"subject":"General Relativity and Quantum Cosmology (gr-qc)","lang":"en","subjectScheme":"arXiv"},{"subject":"FOS: Physical sciences","subjectScheme":"Fields of Science and Technology (FOS)"},{"schemeUri":"http://www.oecd.org/science/inno/38235147.pdf","subject":"FOS: Physical sciences","subjectScheme":"Fields of Science and Technology (FOS)"}],"contributors":[],"dates":[{"date":"2026-02-22T15:56:49Z","dateType":"Submitted","dateInformation":"v1"},{"date":"2026-02-24T01:53:47Z","dateType":"Updated","dateInformation":"v1"},{"date":"2026-02","dateType":"Available","dateInformation":"v1"},{"date":"2026","dateType":"Issued"}],"language":null,"types":{"schemaOrg":"CreativeWork","resourceTypeGeneral":"Preprint","citeproc":"article","bibtex":"misc","ris":"GEN","resourceType":"Article"},"relatedIdentifiers":[],"relatedItems":[],"sizes":[],"formats":[],"version":"1","rightsList":[{"rightsUri":"http://arxiv.org/licenses/nonexclusive-distrib/1.0/","rights":"arXiv.org perpetual, non-exclusive license"}],"descriptions":[{"descriptionType":"Abstract","description":"While the Teukolsky equation plays a central role in traditional treatments of perturbations of algebraically special spacetimes, its relation to Friedrich's conformal Einstein field equations (CEFEs) remains largely unexplored. Here we develop a conformal formulation of black-hole perturbation theory based on the CEFEs and derive the conformal Teukolsky equation. Starting from a transparent review of Friedrich's regularisation strategy, this work establishes a direct connection between mainstream curvature-based linear perturbation theory and conformal formulations of general relativity. This perspective is timely given the growing relevance of hyperboloidal frameworks in black-hole perturbation theory, where conformal compactification is introduced at the level of an already linearised effective wave equation. Here instead, the conformal factor is a dynamical variable within the field equations. In the non-linear equations there is a coupling between conformal and curvature perturbations; however, when linearised around a Petrov-type D background, the conformal factor decouples from the equations governing the Newman-Penrose components $ϕ_0$ and $ϕ_4$ of the rescaled Weyl tensor. The resulting equation preserves the structural form of the classical Teukolsky equation while remaining regular at the conformal boundary. This provides a geometric interpretation of the hyperboloidal master variable and an entry point into the CEFE framework. We further derive the conformal Teukolsky equation for a conformal representation of Kerr spacetime where spatial infinity is realised as a blown-up cylinder. By bridging conformal and traditional approaches to black-hole perturbation theory, the framework highlights a geometrically regular representation of perturbative dynamics that may inform extensions beyond the linear regime."},{"descriptionType":"Other","description":"28 pages"}],"geoLocations":[],"fundingReferences":[],"url":"https://arxiv.org/abs/2602.19245","contentUrl":null,"metadataVersion":0,"schemaVersion":"http://datacite.org/schema/kernel-4","source":"mds","isActive":true,"state":"findable","reason":null,"viewCount":0,"downloadCount":0,"referenceCount":0,"citationCount":0,"partCount":0,"partOfCount":0,"versionCount":0,"versionOfCount":0,"created":"2026-02-25T14:52:27Z","registered":"2026-02-25T14:52:28Z","published":null,"updated":"2026-02-25T14:52:28Z"},"relationships":{"client":{"data":{"id":"arxiv.content","type":"clients"}}}},{"id":"10.48550/arxiv.2602.19244","type":"dois","attributes":{"doi":"10.48550/arxiv.2602.19244","identifiers":[{"identifier":"2602.19244","identifierType":"arXiv"}],"creators":[{"nameType":"Personal","givenName":"Toshihide","familyName":"Ubukata","name":"Ubukata, Toshihide","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Zhiyao","familyName":"Wang","name":"Wang, Zhiyao","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Enhong","familyName":"Mu","name":"Mu, Enhong","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Jialong","familyName":"Li","name":"Li, Jialong","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Kenji","familyName":"Tei","name":"Tei, Kenji","affiliation":[],"nameIdentifiers":[]}],"titles":[{"title":"Robust Exploration in Directed Controller Synthesis via Reinforcement Learning with Soft Mixture-of-Experts"}],"publisher":"arXiv","container":{},"publicationYear":2026,"subjects":[{"subject":"Artificial Intelligence (cs.AI)","lang":"en","subjectScheme":"arXiv"},{"subject":"Machine Learning (cs.LG)","lang":"en","subjectScheme":"arXiv"},{"subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"},{"schemeUri":"http://www.oecd.org/science/inno/38235147.pdf","subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"}],"contributors":[],"dates":[{"date":"2026-02-22T15:56:13Z","dateType":"Submitted","dateInformation":"v1"},{"date":"2026-02-24T01:53:44Z","dateType":"Updated","dateInformation":"v1"},{"date":"2026-02","dateType":"Available","dateInformation":"v1"},{"date":"2026","dateType":"Issued"}],"language":null,"types":{"schemaOrg":"CreativeWork","resourceTypeGeneral":"Preprint","citeproc":"article","bibtex":"misc","ris":"GEN","resourceType":"Article"},"relatedIdentifiers":[],"relatedItems":[],"sizes":[],"formats":[],"version":"1","rightsList":[{"rightsUri":"http://arxiv.org/licenses/nonexclusive-distrib/1.0/","rights":"arXiv.org perpetual, non-exclusive license"}],"descriptions":[{"descriptionType":"Abstract","description":"On-the-fly Directed Controller Synthesis (OTF-DCS) mitigates state-space explosion by incrementally exploring the system and relies critically on an exploration policy to guide search efficiently. Recent reinforcement learning (RL) approaches learn such policies and achieve promising zero-shot generalization from small training instances to larger unseen ones. However, a fundamental limitation is anisotropic generalization, where an RL policy exhibits strong performance only in a specific region of the domain-parameter space while remaining fragile elsewhere due to training stochasticity and trajectory-dependent bias. To address this, we propose a Soft Mixture-of-Experts framework that combines multiple RL experts via a prior-confidence gating mechanism and treats these anisotropic behaviors as complementary specializations. The evaluation on the Air Traffic benchmark shows that Soft-MoE substantially expands the solvable parameter space and improves robustness compared to any single expert."}],"geoLocations":[],"fundingReferences":[],"url":"https://arxiv.org/abs/2602.19244","contentUrl":null,"metadataVersion":0,"schemaVersion":"http://datacite.org/schema/kernel-4","source":"mds","isActive":true,"state":"findable","reason":null,"viewCount":0,"downloadCount":0,"referenceCount":0,"citationCount":0,"partCount":0,"partOfCount":0,"versionCount":0,"versionOfCount":0,"created":"2026-02-25T14:52:25Z","registered":"2026-02-25T14:52:25Z","published":null,"updated":"2026-02-25T14:52:25Z"},"relationships":{"client":{"data":{"id":"arxiv.content","type":"clients"}}}},{"id":"10.48550/arxiv.2602.19243","type":"dois","attributes":{"doi":"10.48550/arxiv.2602.19243","identifiers":[{"identifier":"2602.19243","identifierType":"arXiv"}],"creators":[{"nameType":"Personal","givenName":"Jiasheng","familyName":"Li","name":"Li, Jiasheng","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Zining","familyName":"Zhang","name":"Zhang, Zining","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Zeyu","familyName":"Yan","name":"Yan, Zeyu","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Matthew","familyName":"Wong","name":"Wong, Matthew","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Arnav","familyName":"Mittal","name":"Mittal, Arnav","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Ge","familyName":"Gao","name":"Gao, Ge","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Huaishu","familyName":"Peng","name":"Peng, Huaishu","affiliation":[],"nameIdentifiers":[]}],"titles":[{"title":"As Content and Layout Co-Evolve: TangibleSite for Scaffolding Blind People's Webpage Design through Multimodal Interaction"}],"publisher":"arXiv","container":{},"publicationYear":2026,"subjects":[{"subject":"Human-Computer Interaction (cs.HC)","lang":"en","subjectScheme":"arXiv"},{"subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"},{"schemeUri":"http://www.oecd.org/science/inno/38235147.pdf","subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"}],"contributors":[],"dates":[{"date":"2026-02-22T15:55:13Z","dateType":"Submitted","dateInformation":"v1"},{"date":"2026-02-24T01:53:43Z","dateType":"Updated","dateInformation":"v1"},{"date":"2026-02","dateType":"Available","dateInformation":"v1"},{"date":"2026","dateType":"Issued"}],"language":null,"types":{"schemaOrg":"CreativeWork","resourceTypeGeneral":"Preprint","citeproc":"article","bibtex":"misc","ris":"GEN","resourceType":"Article"},"relatedIdentifiers":[{"relationType":"IsVersionOf","relatedIdentifier":"10.1145/3772318.3791895","relatedIdentifierType":"DOI"}],"relatedItems":[],"sizes":[],"formats":[],"version":"1","rightsList":[{"rightsIdentifierScheme":"SPDX","rightsUri":"https://creativecommons.org/licenses/by-nc-nd/4.0/legalcode","schemeUri":"https://spdx.org/licenses/","rights":"Creative Commons Attribution Non Commercial No Derivatives 4.0 International","rightsIdentifier":"cc-by-nc-nd-4.0"}],"descriptions":[{"descriptionType":"Abstract","description":"Creating webpages requires generating content and arranging layout while iteratively refining both to achieve a coherent design, a process that can be challenging for blind individuals. To understand how blind designers navigate this process, we conducted two rounds of co-design sessions with blind participants, using design probes to elicit their strategies and support needs. Our findings reveal a preference for content and layout to co-evolve, but this process requires external support through cues that situate local elements within the broader page structure as well as multimodal interactions. Building on these insights, we developed TangibleSite, an accessible web design tool that provides real-time multimodal feedback through tangible, auditory, and speech-based interactions. TangibleSite enables blind individuals to create, edit, and reposition webpage elements while integrating content and layout decisions. A formative evaluation with six blind participants demonstrated that TangibleSite enabled independent webpage creation, supported refinement across content and layout, and reduced barriers to achieving visually consistent designs."}],"geoLocations":[],"fundingReferences":[],"url":"https://arxiv.org/abs/2602.19243","contentUrl":null,"metadataVersion":0,"schemaVersion":"http://datacite.org/schema/kernel-4","source":"mds","isActive":true,"state":"findable","reason":null,"viewCount":0,"downloadCount":0,"referenceCount":0,"citationCount":0,"partCount":0,"partOfCount":0,"versionCount":0,"versionOfCount":1,"created":"2026-02-25T14:52:22Z","registered":"2026-02-25T14:52:23Z","published":null,"updated":"2026-02-25T14:52:23Z"},"relationships":{"client":{"data":{"id":"arxiv.content","type":"clients"}}}},{"id":"10.48550/arxiv.2602.19242","type":"dois","attributes":{"doi":"10.48550/arxiv.2602.19242","identifiers":[{"identifier":"2602.19242","identifierType":"arXiv"}],"creators":[{"nameType":"Personal","givenName":"Zheng","familyName":"Li","name":"Li, Zheng","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Guangyi","familyName":"Zeng","name":"Zeng, Guangyi","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Paul","familyName":"Delestrac","name":"Delestrac, Paul","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Enyi","familyName":"Yao","name":"Yao, Enyi","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Simei","familyName":"Yang","name":"Yang, Simei","affiliation":[],"nameIdentifiers":[]}],"titles":[{"title":"pHNSW: PCA-Based Filtering to Accelerate HNSW Approximate Nearest Neighbor Search"}],"publisher":"arXiv","container":{},"publicationYear":2026,"subjects":[{"subject":"Hardware Architecture (cs.AR)","lang":"en","subjectScheme":"arXiv"},{"subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"},{"schemeUri":"http://www.oecd.org/science/inno/38235147.pdf","subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"}],"contributors":[],"dates":[{"date":"2026-02-22T15:51:40Z","dateType":"Submitted","dateInformation":"v1"},{"date":"2026-02-24T01:53:42Z","dateType":"Updated","dateInformation":"v1"},{"date":"2026-02","dateType":"Available","dateInformation":"v1"},{"date":"2026","dateType":"Issued"}],"language":null,"types":{"schemaOrg":"CreativeWork","resourceTypeGeneral":"Preprint","citeproc":"article","bibtex":"misc","ris":"GEN","resourceType":"Article"},"relatedIdentifiers":[],"relatedItems":[],"sizes":[],"formats":[],"version":"1","rightsList":[{"rightsUri":"http://arxiv.org/licenses/nonexclusive-distrib/1.0/","rights":"arXiv.org perpetual, non-exclusive license"}],"descriptions":[{"descriptionType":"Abstract","description":"Hierarchical Navigable Small World (HNSW) has demonstrated impressive accuracy and low latency for high-dimensional nearest neighbor searches. However, its high computational demands and irregular, large-volume data access patterns present significant challenges to search efficiency. To address these challenges, we introduce pHNSW, an algorithm-hardware co-optimized solution that accelerates HNSW through Principal Component Analysis (PCA) filtering. On the algorithm side, we apply PCA filtering to reduce the dimensionality of the dataset, thereby lowering the volume of neighbor access and decreasing the computational load for distance calculations. On the hardware side, we design the pHNSW processor with custom instructions to optimize search throughput and energy efficiency. In the experiments, we synthesized the pHNSW processor RTL design with a 65nm technology node and evaluated it using DDR4 and HBM1.0 DRAM standards. The results show that pHNSW boosts Queries per Second (QPS) by 14.47x-21.37x on a CPU and 5.37x-8.46x on a GPU, while reducing energy consumption by up to 57.4% compared to standard HNSW implementation."},{"descriptionType":"Other","description":"6 pages for ASPDAC2026 conference"}],"geoLocations":[],"fundingReferences":[],"url":"https://arxiv.org/abs/2602.19242","contentUrl":null,"metadataVersion":0,"schemaVersion":"http://datacite.org/schema/kernel-4","source":"mds","isActive":true,"state":"findable","reason":null,"viewCount":0,"downloadCount":0,"referenceCount":0,"citationCount":0,"partCount":0,"partOfCount":0,"versionCount":0,"versionOfCount":0,"created":"2026-02-25T14:52:20Z","registered":"2026-02-25T14:52:21Z","published":null,"updated":"2026-02-25T14:52:21Z"},"relationships":{"client":{"data":{"id":"arxiv.content","type":"clients"}}}},{"id":"10.48550/arxiv.2602.19240","type":"dois","attributes":{"doi":"10.48550/arxiv.2602.19240","identifiers":[{"identifier":"2602.19240","identifierType":"arXiv"}],"creators":[{"nameType":"Personal","givenName":"Sen","familyName":"Zhao","name":"Zhao, Sen","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Lincheng","familyName":"Zhou","name":"Zhou, Lincheng","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Yue","familyName":"Chen","name":"Chen, Yue","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Ding","familyName":"Zou","name":"Zou, Ding","affiliation":[],"nameIdentifiers":[]}],"titles":[{"title":"Topology of Reasoning: Retrieved Cell Complex-Augmented Generation for Textual Graph Question Answering"}],"publisher":"arXiv","container":{},"publicationYear":2026,"subjects":[{"subject":"Artificial Intelligence (cs.AI)","lang":"en","subjectScheme":"arXiv"},{"subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"},{"schemeUri":"http://www.oecd.org/science/inno/38235147.pdf","subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"}],"contributors":[],"dates":[{"date":"2026-02-22T15:44:53Z","dateType":"Submitted","dateInformation":"v1"},{"date":"2026-02-24T01:53:33Z","dateType":"Updated","dateInformation":"v1"},{"date":"2026-02","dateType":"Available","dateInformation":"v1"},{"date":"2026","dateType":"Issued"}],"language":null,"types":{"schemaOrg":"CreativeWork","resourceTypeGeneral":"Preprint","citeproc":"article","bibtex":"misc","ris":"GEN","resourceType":"Article"},"relatedIdentifiers":[],"relatedItems":[],"sizes":[],"formats":[],"version":"1","rightsList":[{"rightsIdentifierScheme":"SPDX","rightsUri":"https://creativecommons.org/licenses/by/4.0/legalcode","schemeUri":"https://spdx.org/licenses/","rights":"Creative Commons Attribution 4.0 International","rightsIdentifier":"cc-by-4.0"}],"descriptions":[{"descriptionType":"Abstract","description":"Retrieval-Augmented Generation (RAG) enhances the reasoning ability of Large Language Models (LLMs) by dynamically integrating external knowledge, thereby mitigating hallucinations and strengthening contextual grounding for structured data such as graphs. Nevertheless, most existing RAG variants for textual graphs concentrate on low-dimensional structures -- treating nodes as entities (0-dimensional) and edges or paths as pairwise or sequential relations (1-dimensional), but overlook cycles, which are crucial for reasoning over relational loops. Such cycles often arise in questions requiring closed-loop inference about similar objects or relative positions. This limitation often results in incomplete contextual grounding and restricted reasoning capability. In this work, we propose Topology-enhanced Retrieval-Augmented Generation (TopoRAG), a novel framework for textual graph question answering that effectively captures higher-dimensional topological and relational dependencies. Specifically, TopoRAG first lifts textual graphs into cellular complexes to model multi-dimensional topological structures. Leveraging these lifted representations, a topology-aware subcomplex retrieval mechanism is proposed to extract cellular complexes relevant to the input query, providing compact and informative topological context. Finally, a multi-dimensional topological reasoning mechanism operates over these complexes to propagate relational information and guide LLMs in performing structured, logic-aware inference. Empirical evaluations demonstrate that our method consistently surpasses existing baselines across diverse textual graph tasks."}],"geoLocations":[],"fundingReferences":[],"url":"https://arxiv.org/abs/2602.19240","contentUrl":null,"metadataVersion":0,"schemaVersion":"http://datacite.org/schema/kernel-4","source":"mds","isActive":true,"state":"findable","reason":null,"viewCount":0,"downloadCount":0,"referenceCount":0,"citationCount":0,"partCount":0,"partOfCount":0,"versionCount":0,"versionOfCount":0,"created":"2026-02-25T14:52:15Z","registered":"2026-02-25T14:52:15Z","published":null,"updated":"2026-02-25T14:52:15Z"},"relationships":{"client":{"data":{"id":"arxiv.content","type":"clients"}}}},{"id":"10.48550/arxiv.2602.19239","type":"dois","attributes":{"doi":"10.48550/arxiv.2602.19239","identifiers":[{"identifier":"2602.19239","identifierType":"arXiv"}],"creators":[{"nameType":"Personal","givenName":"Ahmed","familyName":"Karim","name":"Karim, Ahmed","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Fatima","familyName":"Sheaib","name":"Sheaib, Fatima","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Zein","familyName":"Khamis","name":"Khamis, Zein","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Maggie","familyName":"Chlon","name":"Chlon, Maggie","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Jad","familyName":"Awada","name":"Awada, Jad","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Leon","familyName":"Chlon","name":"Chlon, Leon","affiliation":[],"nameIdentifiers":[]}],"titles":[{"title":"Attention Deficits in Language Models: Causal Explanations for Procedural Hallucinations"}],"publisher":"arXiv","container":{},"publicationYear":2026,"subjects":[{"subject":"Machine Learning (stat.ML)","lang":"en","subjectScheme":"arXiv"},{"subject":"Machine Learning (cs.LG)","lang":"en","subjectScheme":"arXiv"},{"subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"},{"schemeUri":"http://www.oecd.org/science/inno/38235147.pdf","subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"}],"contributors":[],"dates":[{"date":"2026-02-22T15:43:41Z","dateType":"Submitted","dateInformation":"v1"},{"date":"2026-02-24T01:53:28Z","dateType":"Updated","dateInformation":"v1"},{"date":"2026-02","dateType":"Available","dateInformation":"v1"},{"date":"2026","dateType":"Issued"}],"language":null,"types":{"schemaOrg":"CreativeWork","resourceTypeGeneral":"Preprint","citeproc":"article","bibtex":"misc","ris":"GEN","resourceType":"Article"},"relatedIdentifiers":[],"relatedItems":[],"sizes":[],"formats":[],"version":"1","rightsList":[{"rightsIdentifierScheme":"SPDX","rightsUri":"https://creativecommons.org/licenses/by/4.0/legalcode","schemeUri":"https://spdx.org/licenses/","rights":"Creative Commons Attribution 4.0 International","rightsIdentifier":"cc-by-4.0"}],"descriptions":[{"descriptionType":"Abstract","description":"Large language models can follow complex procedures yet fail at a seemingly trivial final step: reporting a value they themselves computed moments earlier. We study this phenomenon as \\emph{procedural hallucination}: failure to execute a verifiable, prompt-grounded specification even when the correct value is present in context.\n In long-context binding tasks with a known single-token candidate set, we find that many errors are readout-stage routing failures. Specifically, failures decompose into Stage~2A (gating) errors, where the model does not enter answer mode, and Stage~2B (binding) errors, where it enters answer mode but selects the wrong candidate (often due to recency bias). In the hard regime, Stage~2B accounts for most errors across model families in our tasks (Table~1).\n On Stage~2B error trials, a linear probe on the final-layer residual stream recovers the correct value far above chance (e.g., 74\\% vs.\\ 2\\% on Qwen2.5-3B; Table~2), indicating that the answer is encoded but not used. We formalize ``present but not used'' via available vs.\\ used mutual information and pseudo-prior interventions, yielding output-computable diagnostics and information-budget certificates.\n Finally, an oracle checkpointing intervention that restates the true binding near the query can nearly eliminate Stage~2B failures at long distance (e.g., Qwen2.5-3B $0/400 \\rightarrow 399/400$ at $k = 1024$; Table~8)."}],"geoLocations":[],"fundingReferences":[],"url":"https://arxiv.org/abs/2602.19239","contentUrl":null,"metadataVersion":0,"schemaVersion":"http://datacite.org/schema/kernel-4","source":"mds","isActive":true,"state":"findable","reason":null,"viewCount":0,"downloadCount":0,"referenceCount":0,"citationCount":0,"partCount":0,"partOfCount":0,"versionCount":0,"versionOfCount":0,"created":"2026-02-25T14:52:12Z","registered":"2026-02-25T14:52:13Z","published":null,"updated":"2026-02-25T14:52:13Z"},"relationships":{"client":{"data":{"id":"arxiv.content","type":"clients"}}}},{"id":"10.48550/arxiv.2602.19238","type":"dois","attributes":{"doi":"10.48550/arxiv.2602.19238","identifiers":[{"identifier":"2602.19238","identifierType":"arXiv"}],"creators":[{"nameType":"Personal","givenName":"Mingliang","familyName":"Xiong","name":"Xiong, Mingliang","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Zeqian","familyName":"Guo","name":"Guo, Zeqian","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Qingqing","familyName":"Zhang","name":"Zhang, Qingqing","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Qingwen","familyName":"Liu","name":"Liu, Qingwen","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Gang","familyName":"Wang","name":"Wang, Gang","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Gang","familyName":"Li","name":"Li, Gang","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Bin","familyName":"He","name":"He, Bin","affiliation":[],"nameIdentifiers":[]}],"titles":[{"title":"On the Stability of Spatially Distributed Cavity Laser and Boundary of Resonant Beam SLIPT"}],"publisher":"arXiv","container":{},"publicationYear":2026,"subjects":[{"subject":"Systems and Control (eess.SY)","lang":"en","subjectScheme":"arXiv"},{"subject":"FOS: Electrical engineering, electronic engineering, information engineering","subjectScheme":"Fields of Science and Technology (FOS)"},{"schemeUri":"http://www.oecd.org/science/inno/38235147.pdf","subject":"FOS: Electrical engineering, electronic engineering, information engineering","subjectScheme":"Fields of Science and Technology (FOS)"}],"contributors":[],"dates":[{"date":"2026-02-22T15:32:38Z","dateType":"Submitted","dateInformation":"v1"},{"date":"2026-02-24T01:53:16Z","dateType":"Updated","dateInformation":"v1"},{"date":"2026-02","dateType":"Available","dateInformation":"v1"},{"date":"2026","dateType":"Issued"}],"language":null,"types":{"schemaOrg":"CreativeWork","resourceTypeGeneral":"Preprint","citeproc":"article","bibtex":"misc","ris":"GEN","resourceType":"Article"},"relatedIdentifiers":[],"relatedItems":[],"sizes":[],"formats":[],"version":"1","rightsList":[{"rightsUri":"http://arxiv.org/licenses/nonexclusive-distrib/1.0/","rights":"arXiv.org perpetual, non-exclusive license"}],"descriptions":[{"descriptionType":"Abstract","description":"Spatially distributed cavity (SDC) lasers are a promising technology for simultaneous light information and power transfer (SLIPT), offering benefits such as increased mobility and intrinsic safety, which are advantageous for various Internet of Things (IoT) devices. \\mll However, achieving beam transmission over meter-level long working distances presents significant challenges from cavity stability constraints, manufacturing/assembly tolerances, and diffraction losses\\mrr. This paper conducts a theoretical investigation of the fundamental restrictions limiting long-range resonant beam generation. We investigate cavity stability and beam characteristics, and propose a binary-search-based Monte Carlo simulation algorithm as well as a linear approximation algorithm to quantify the maximum acceptable tolerances for stable operation. \\mll Numerical results indicate that the stable region contracts sharply as distance increases. For fixed-component systems, an acceptable tolerance of 0.01 mm restricts the achievable transmission distance to less than 2 m. \\mrr To address this limitation, we also prove the feasibility of long-range beam formation using precision adjustable elements, paving the way for advanced engineering applications. \\mll Experimental results verified this assumption, demonstrating that by tuning the stable region during assembly, the transmission distance could be extended to 2.8 m. \\mrr This work provides essential theoretical insights and practical design guidelines for realizing stable, long-range SDC systems."}],"geoLocations":[],"fundingReferences":[],"url":"https://arxiv.org/abs/2602.19238","contentUrl":null,"metadataVersion":0,"schemaVersion":"http://datacite.org/schema/kernel-4","source":"mds","isActive":true,"state":"findable","reason":null,"viewCount":0,"downloadCount":0,"referenceCount":0,"citationCount":0,"partCount":0,"partOfCount":0,"versionCount":0,"versionOfCount":0,"created":"2026-02-25T14:52:10Z","registered":"2026-02-25T14:52:11Z","published":null,"updated":"2026-02-25T14:52:11Z"},"relationships":{"client":{"data":{"id":"arxiv.content","type":"clients"}}}},{"id":"10.48550/arxiv.2602.19237","type":"dois","attributes":{"doi":"10.48550/arxiv.2602.19237","identifiers":[{"identifier":"2602.19237","identifierType":"arXiv"}],"creators":[{"nameType":"Personal","affiliation":["Microsoft Corporation"],"givenName":"Amit","familyName":"Lal","name":"Lal, Amit","nameIdentifiers":[]}],"titles":[{"title":"Evaluating SAP RPT-1 for Enterprise Business Process Prediction: In-Context Learning vs. Traditional Machine Learning on Structured SAP Data"}],"publisher":"arXiv","container":{},"publicationYear":2026,"subjects":[{"subject":"Machine Learning (cs.LG)","lang":"en","subjectScheme":"arXiv"},{"subject":"Artificial Intelligence (cs.AI)","lang":"en","subjectScheme":"arXiv"},{"subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"},{"schemeUri":"http://www.oecd.org/science/inno/38235147.pdf","subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"},{"subject":"I.2.6; H.4.2","lang":"en","subjectScheme":"ACM"}],"contributors":[],"dates":[{"date":"2026-02-22T15:29:52Z","dateType":"Submitted","dateInformation":"v1"},{"date":"2026-02-24T01:53:07Z","dateType":"Updated","dateInformation":"v1"},{"date":"2026-02","dateType":"Available","dateInformation":"v1"},{"date":"2026","dateType":"Issued"}],"language":null,"types":{"schemaOrg":"CreativeWork","resourceTypeGeneral":"Preprint","citeproc":"article","bibtex":"misc","ris":"GEN","resourceType":"Article"},"relatedIdentifiers":[],"relatedItems":[],"sizes":[],"formats":[],"version":"1","rightsList":[{"rightsIdentifierScheme":"SPDX","rightsUri":"https://creativecommons.org/licenses/by/4.0/legalcode","schemeUri":"https://spdx.org/licenses/","rights":"Creative Commons Attribution 4.0 International","rightsIdentifier":"cc-by-4.0"}],"descriptions":[{"descriptionType":"Abstract","description":"Tabular foundation models aim to make machine learning accessible for enterprise data without task-specific training. This paper presents the first independent evaluation of SAP's Retrieval Pretrained Transformer (RPT-1) from a practitioner perspective. RPT-1 is a compact 64.6 MB model pretrained on 1.34 TB of structured data across 3.1 million tables. We benchmark it against tuned gradient-boosted decision trees (XGBoost, LightGBM, CatBoost) on three SAP business scenarios: demand forecasting across SD/MM/PP modules, predictive data integrity in BC/MM/QM, and financial risk classification in FI/CO/AR. Across five-fold cross-validation on datasets ranging from 2,500 to 3,200 rows, RPT-1 reaches 91-96% of tuned GBDT accuracy without any training examples. The classification gap is modest at 3.6-4.1 percentage points on AUC-ROC, though regression tasks show wider gaps of 8.9-11.1 percentage points on R-squared. An interesting finding is a crossover at roughly 75-100 context rows where RPT-1 actually outperforms XGBoost under limited data. Based on these results, we propose a practical hybrid workflow: use RPT-1 for rapid screening, then train GBDT selectively where prediction accuracy justifies the effort. All experiments are reproducible through publicly available Hugging Face Spaces."},{"descriptionType":"Other","description":"12 pages, 5 figures, 32 references. Reproducible experiments available at Hugging Face Spaces"}],"geoLocations":[],"fundingReferences":[],"url":"https://arxiv.org/abs/2602.19237","contentUrl":null,"metadataVersion":0,"schemaVersion":"http://datacite.org/schema/kernel-4","source":"mds","isActive":true,"state":"findable","reason":null,"viewCount":0,"downloadCount":0,"referenceCount":0,"citationCount":0,"partCount":0,"partOfCount":0,"versionCount":0,"versionOfCount":0,"created":"2026-02-25T14:52:07Z","registered":"2026-02-25T14:52:08Z","published":null,"updated":"2026-02-25T14:52:08Z"},"relationships":{"client":{"data":{"id":"arxiv.content","type":"clients"}}}},{"id":"10.48550/arxiv.2602.19236","type":"dois","attributes":{"doi":"10.48550/arxiv.2602.19236","identifiers":[{"identifier":"2602.19236","identifierType":"arXiv"}],"creators":[{"nameType":"Personal","givenName":"Sreya","familyName":"Sarkar","name":"Sarkar, Sreya","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Kshitij","familyName":"Khare","name":"Khare, Kshitij","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Sanvesh","familyName":"Srivastava","name":"Srivastava, Sanvesh","affiliation":[],"nameIdentifiers":[]}],"titles":[{"title":"CoMET: A Compressed Bayesian Mixed-Effects Model for High-Dimensional Tensors"}],"publisher":"arXiv","container":{},"publicationYear":2026,"subjects":[{"subject":"Methodology (stat.ME)","lang":"en","subjectScheme":"arXiv"},{"subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"},{"schemeUri":"http://www.oecd.org/science/inno/38235147.pdf","subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"}],"contributors":[],"dates":[{"date":"2026-02-22T15:29:41Z","dateType":"Submitted","dateInformation":"v1"},{"date":"2026-02-24T01:53:06Z","dateType":"Updated","dateInformation":"v1"},{"date":"2026-02","dateType":"Available","dateInformation":"v1"},{"date":"2026","dateType":"Issued"}],"language":null,"types":{"schemaOrg":"CreativeWork","resourceTypeGeneral":"Preprint","citeproc":"article","bibtex":"misc","ris":"GEN","resourceType":"Article"},"relatedIdentifiers":[],"relatedItems":[],"sizes":[],"formats":[],"version":"1","rightsList":[{"rightsIdentifierScheme":"SPDX","rightsUri":"https://creativecommons.org/licenses/by-nc-sa/4.0/legalcode","schemeUri":"https://spdx.org/licenses/","rights":"Creative Commons Attribution Non Commercial Share Alike 4.0 International","rightsIdentifier":"cc-by-nc-sa-4.0"}],"descriptions":[{"descriptionType":"Abstract","description":"Mixed-effects models are fundamental tools for analyzing clustered and repeated-measures data, but existing high-dimensional methods largely focus on penalized estimation with vector-valued covariates. Bayesian alternatives in this regime are limited, with no sampling-based mixed-effects framework that supports tensor-valued fixed- and random-effects covariates while remaining computationally tractable. We propose the Compressed Mixed-Effects Tensor (CoMET) model for high-dimensional repeated-measures data with scalar responses and tensor-valued covariates. CoMET performs structured, mode-wise random projection of the random-effects covariance, yielding a low-dimensional covariance parameter that admits simple Gaussian prior specification and enables efficient imputation of compressed random-effects. For the mean structure, CoMET leverages a low-rank tensor decomposition and margin-structured Horseshoe priors to enable fixed-effects selection. These design choices lead to an efficient collapsed Gibbs sampler whose computational complexity grows approximately linearly with the tensor covariate dimensions. We establish high-dimensional theoretical guarantees by identifying regularity conditions under which CoMET's posterior predictive risk decays to zero. Empirically, CoMET outperforms penalized competitors across a range of simulation studies and two benchmark applications involving facial-expression prediction and music emotion modeling."},{"descriptionType":"Other","description":"50 pages, 11 figures, and 2 tables"}],"geoLocations":[],"fundingReferences":[],"url":"https://arxiv.org/abs/2602.19236","contentUrl":null,"metadataVersion":0,"schemaVersion":"http://datacite.org/schema/kernel-4","source":"mds","isActive":true,"state":"findable","reason":null,"viewCount":0,"downloadCount":0,"referenceCount":0,"citationCount":0,"partCount":0,"partOfCount":0,"versionCount":0,"versionOfCount":0,"created":"2026-02-25T14:52:05Z","registered":"2026-02-25T14:52:06Z","published":null,"updated":"2026-02-25T14:52:06Z"},"relationships":{"client":{"data":{"id":"arxiv.content","type":"clients"}}}},{"id":"10.48550/arxiv.2602.19235","type":"dois","attributes":{"doi":"10.48550/arxiv.2602.19235","identifiers":[{"identifier":"2602.19235","identifierType":"arXiv"}],"creators":[{"nameType":"Personal","givenName":"Dessislava H.","familyName":"Kochloukova","name":"Kochloukova, Dessislava H.","affiliation":[],"nameIdentifiers":[]}],"titles":[{"title":"Hopfian combinatorial wreath products"}],"publisher":"arXiv","container":{},"publicationYear":2026,"subjects":[{"subject":"Group Theory (math.GR)","lang":"en","subjectScheme":"arXiv"},{"subject":"FOS: Mathematics","subjectScheme":"Fields of Science and Technology (FOS)"},{"schemeUri":"http://www.oecd.org/science/inno/38235147.pdf","subject":"FOS: Mathematics","subjectScheme":"Fields of Science and Technology (FOS)"}],"contributors":[],"dates":[{"date":"2026-02-22T15:28:24Z","dateType":"Submitted","dateInformation":"v1"},{"date":"2026-02-24T01:53:00Z","dateType":"Updated","dateInformation":"v1"},{"date":"2026-02","dateType":"Available","dateInformation":"v1"},{"date":"2026","dateType":"Issued"}],"language":null,"types":{"schemaOrg":"CreativeWork","resourceTypeGeneral":"Preprint","citeproc":"article","bibtex":"misc","ris":"GEN","resourceType":"Article"},"relatedIdentifiers":[],"relatedItems":[],"sizes":[],"formats":[],"version":"1","rightsList":[{"rightsUri":"http://arxiv.org/licenses/nonexclusive-distrib/1.0/","rights":"arXiv.org perpetual, non-exclusive license"}],"descriptions":[{"descriptionType":"Abstract","description":"Let $A$ be an abelian group. We consider sufficient conditions for the combinatorial wreath product $A \\wr_X B$ to be Hopfian generalising results of Bradford and Fournier-Facio. For an integer $m \\geq 2$ we show an example where $\\mathbb{Z}/ \\mathbb{Z}_m \\wr_X B$ is not Hopfian but $B$ is Hopfian. We describe $Aut(A \\wr_X B)$ under some restrictions on $A$, $B$ and $X$."}],"geoLocations":[],"fundingReferences":[],"url":"https://arxiv.org/abs/2602.19235","contentUrl":null,"metadataVersion":0,"schemaVersion":"http://datacite.org/schema/kernel-4","source":"mds","isActive":true,"state":"findable","reason":null,"viewCount":0,"downloadCount":0,"referenceCount":0,"citationCount":0,"partCount":0,"partOfCount":0,"versionCount":0,"versionOfCount":0,"created":"2026-02-25T14:52:03Z","registered":"2026-02-25T14:52:03Z","published":null,"updated":"2026-02-25T14:52:03Z"},"relationships":{"client":{"data":{"id":"arxiv.content","type":"clients"}}}},{"id":"10.48550/arxiv.2602.19234","type":"dois","attributes":{"doi":"10.48550/arxiv.2602.19234","identifiers":[{"identifier":"2602.19234","identifierType":"arXiv"}],"creators":[{"nameType":"Personal","givenName":"Yang","familyName":"Chen","name":"Chen, Yang","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Seok-Young","familyName":"Chung","name":"Chung, Seok-Young","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Qiyu","familyName":"Sun","name":"Sun, Qiyu","affiliation":[],"nameIdentifiers":[]}],"titles":[{"title":"Shift-invariant spaces on finite undirected graphs"}],"publisher":"arXiv","container":{},"publicationYear":2026,"subjects":[{"subject":"Functional Analysis (math.FA)","lang":"en","subjectScheme":"arXiv"},{"subject":"Signal Processing (eess.SP)","lang":"en","subjectScheme":"arXiv"},{"subject":"FOS: Mathematics","subjectScheme":"Fields of Science and Technology (FOS)"},{"schemeUri":"http://www.oecd.org/science/inno/38235147.pdf","subject":"FOS: Mathematics","subjectScheme":"Fields of Science and Technology (FOS)"},{"subject":"FOS: Electrical engineering, electronic engineering, information engineering","subjectScheme":"Fields of Science and Technology (FOS)"},{"schemeUri":"http://www.oecd.org/science/inno/38235147.pdf","subject":"FOS: Electrical engineering, electronic engineering, information engineering","subjectScheme":"Fields of Science and Technology (FOS)"}],"contributors":[],"dates":[{"date":"2026-02-22T15:27:38Z","dateType":"Submitted","dateInformation":"v1"},{"date":"2026-02-24T01:52:59Z","dateType":"Updated","dateInformation":"v1"},{"date":"2026-02","dateType":"Available","dateInformation":"v1"},{"date":"2026","dateType":"Issued"}],"language":null,"types":{"schemaOrg":"CreativeWork","resourceTypeGeneral":"Preprint","citeproc":"article","bibtex":"misc","ris":"GEN","resourceType":"Article"},"relatedIdentifiers":[],"relatedItems":[],"sizes":[],"formats":[],"version":"1","rightsList":[{"rightsUri":"http://arxiv.org/licenses/nonexclusive-distrib/1.0/","rights":"arXiv.org perpetual, non-exclusive license"}],"descriptions":[{"descriptionType":"Abstract","description":"Shift-invariant spaces (SISs) on the real line provide a natural framework for representing, analyzing and processing signals with inherent shift-invariant structure. In this paper, we extend this framework to the finite undirected graph setting by introducing the concept of graph shift-invariant spaces (GSISs). We examine several properties of GSISs, including their characterization via range functions and fiber functions in the Fourier domain, their connections to shift-invariant filters and polynomial filters, the frame and Riesz basis structures of finitely generated GSISs, and their intricate relationships with bandlimited spaces, finitely generated GSISs, and graph reproducing kernel Hilbert spaces with shift-invariant reproducing kernels (SIGRKHSs). Our analysis reveals several distinctions between SISs on the line and GSISs, such as the shift-invariance of the frame operator, the existence of shift-invariant dual frames, the emergence of fractional shift-invariance, and the interrelationships among GSISs, finitely generated GSISs, SIGRKHSs and bandlimited spaces.\n In this paper, we also introduce a spectral decomposition of the identity associated with graph shifts and propose a novel definition of the graph Fourier transform (GFT) of spectral type, together with explicit formulations for the GFTs on complete graphs and circulant graphs. In addition, we establish a clear connection between polynomial filters and shift-invariant filters, and we derive a graph uncertainty principle governing the essential supports of a nonzero graph signal and its GFT."}],"geoLocations":[],"fundingReferences":[],"url":"https://arxiv.org/abs/2602.19234","contentUrl":null,"metadataVersion":0,"schemaVersion":"http://datacite.org/schema/kernel-4","source":"mds","isActive":true,"state":"findable","reason":null,"viewCount":0,"downloadCount":0,"referenceCount":0,"citationCount":0,"partCount":0,"partOfCount":0,"versionCount":0,"versionOfCount":0,"created":"2026-02-25T14:52:00Z","registered":"2026-02-25T14:52:01Z","published":null,"updated":"2026-02-25T14:52:01Z"},"relationships":{"client":{"data":{"id":"arxiv.content","type":"clients"}}}},{"id":"10.48550/arxiv.2602.19232","type":"dois","attributes":{"doi":"10.48550/arxiv.2602.19232","identifiers":[{"identifier":"2602.19232","identifierType":"arXiv"}],"creators":[{"nameType":"Personal","givenName":"Han","familyName":"Li","name":"Li, Han","affiliation":[],"nameIdentifiers":[]}],"titles":[{"title":"A Comparative Analysis of Peer Support in Forum-based and Chat-based Mental Health Communities: Technical-Structural-Functional Model of Social Support"}],"publisher":"arXiv","container":{},"publicationYear":2026,"subjects":[{"subject":"Human-Computer Interaction (cs.HC)","lang":"en","subjectScheme":"arXiv"},{"subject":"Computers and Society (cs.CY)","lang":"en","subjectScheme":"arXiv"},{"subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"},{"schemeUri":"http://www.oecd.org/science/inno/38235147.pdf","subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"}],"contributors":[],"dates":[{"date":"2026-02-22T15:22:58Z","dateType":"Submitted","dateInformation":"v1"},{"date":"2026-02-24T01:52:55Z","dateType":"Updated","dateInformation":"v1"},{"date":"2026-02","dateType":"Available","dateInformation":"v1"},{"date":"2026","dateType":"Issued"}],"language":null,"types":{"schemaOrg":"CreativeWork","resourceTypeGeneral":"Preprint","citeproc":"article","bibtex":"misc","ris":"GEN","resourceType":"Article"},"relatedIdentifiers":[],"relatedItems":[],"sizes":[],"formats":[],"version":"1","rightsList":[{"rightsUri":"http://arxiv.org/licenses/nonexclusive-distrib/1.0/","rights":"arXiv.org perpetual, non-exclusive license"}],"descriptions":[{"descriptionType":"Abstract","description":"Online support communities have become vital spaces offering varied forms of support to individuals facing mental health challenges. Despite the proliferation of platforms with distinct technical structures, little is known about how these features shape support dynamics and the socio-technical mechanisms at play. This study introduces a technical-structural-functional model of social support and systematically compares communication network structures and support types in 20 forum-based and 20 chat-based mental health communities. Using supervised machine learning and social network analysis, we find that forum-based communities foster more informational and emotional support, whereas chat-based communities promote greater companionship. These patterns were partially explained by network structure: higher in-degree centralization in forums accounted for the prevalence of informational support, while decentralized reply patterns in chat groups accounted for more companionship. These findings extend the structural-functional model of support to online contexts and provide actionable guidance for designing support communities that align technical structures with users' support needs."},{"descriptionType":"Other","description":"15 pages, 5 figures"}],"geoLocations":[],"fundingReferences":[],"url":"https://arxiv.org/abs/2602.19232","contentUrl":null,"metadataVersion":0,"schemaVersion":"http://datacite.org/schema/kernel-4","source":"mds","isActive":true,"state":"findable","reason":null,"viewCount":0,"downloadCount":0,"referenceCount":0,"citationCount":0,"partCount":0,"partOfCount":0,"versionCount":0,"versionOfCount":0,"created":"2026-02-25T14:51:55Z","registered":"2026-02-25T14:51:56Z","published":null,"updated":"2026-02-25T14:51:56Z"},"relationships":{"client":{"data":{"id":"arxiv.content","type":"clients"}}}},{"id":"10.48550/arxiv.2602.19229","type":"dois","attributes":{"doi":"10.48550/arxiv.2602.19229","identifiers":[{"identifier":"2602.19229","identifierType":"arXiv"}],"creators":[{"nameType":"Personal","givenName":"A. R.","familyName":"Balasubramanian","name":"Balasubramanian, A. R.","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Vitor","familyName":"Greati","name":"Greati, Vitor","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Revantha","familyName":"Ramanayake","name":"Ramanayake, Revantha","affiliation":[],"nameIdentifiers":[]}],"titles":[{"title":"Hypersequent Calculi Have Ackermannian Complexity"}],"publisher":"arXiv","container":{},"publicationYear":2026,"subjects":[{"subject":"Logic in Computer Science (cs.LO)","lang":"en","subjectScheme":"arXiv"},{"subject":"Computational Complexity (cs.CC)","lang":"en","subjectScheme":"arXiv"},{"subject":"Logic (math.LO)","lang":"en","subjectScheme":"arXiv"},{"subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"},{"schemeUri":"http://www.oecd.org/science/inno/38235147.pdf","subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"},{"subject":"FOS: Mathematics","subjectScheme":"Fields of Science and Technology (FOS)"},{"schemeUri":"http://www.oecd.org/science/inno/38235147.pdf","subject":"FOS: Mathematics","subjectScheme":"Fields of Science and Technology (FOS)"},{"subject":"F.4.1; F.2.2","lang":"en","subjectScheme":"ACM"},{"subject":"03B47","lang":"en","subjectScheme":"MSC"}],"contributors":[],"dates":[{"date":"2026-02-22T15:21:45Z","dateType":"Submitted","dateInformation":"v1"},{"date":"2026-02-24T01:52:52Z","dateType":"Updated","dateInformation":"v1"},{"date":"2026-02","dateType":"Available","dateInformation":"v1"},{"date":"2026","dateType":"Issued"}],"language":null,"types":{"schemaOrg":"CreativeWork","resourceTypeGeneral":"Preprint","citeproc":"article","bibtex":"misc","ris":"GEN","resourceType":"Article"},"relatedIdentifiers":[],"relatedItems":[],"sizes":[],"formats":[],"version":"1","rightsList":[{"rightsIdentifierScheme":"SPDX","rightsUri":"https://creativecommons.org/licenses/by/4.0/legalcode","schemeUri":"https://spdx.org/licenses/","rights":"Creative Commons Attribution 4.0 International","rightsIdentifier":"cc-by-4.0"}],"descriptions":[{"descriptionType":"Abstract","description":"For substructural logics with contraction or weakening admitting cut-free sequent calculi, proof search was analyzed using well-quasi-orders on $\\mathbb{N}^d$ (Dickson's lemma), yielding Ackermannian upper bounds via controlled bad-sequence arguments. For hypersequent calculi, that argument lifted the ordering to the powerset, since a hypersequent is a (multi)set of sequents. This induces a jump from Ackermannian to hyper-Ackermannian complexity in the fast-growing hierarchy, suggesting that cut-free hypersequent calculi for extensions of the commutative Full Lambek calculus with contraction or weakening ($\\mathbf{FL_{ec}}$/$\\mathbf{FL_{ew}}$) inherently entail hyper-Ackermannian upper bounds. We show that this intuition does not hold: every extension of $\\mathbf{FL_{ec}}$ and $\\mathbf{FL_{ew}}$ admitting a cut-free hypersequent calculus has an Ackermannian upper bound on provability.\n To avoid the powerset, we exploit novel dependencies between individual sequents within any hypersequent in backward proof search. The weakening case, in particular, introduces a Karp-Miller style acceleration, and it improves the upper bound for the fundamental fuzzy logic $\\mathbf{MTL}$. Our Ackermannian upper bound is optimal for the contraction case (realized by the logic $\\mathbf{FL_{ec}}$)."},{"descriptionType":"Other","description":"Submitted"}],"geoLocations":[],"fundingReferences":[],"url":"https://arxiv.org/abs/2602.19229","contentUrl":null,"metadataVersion":0,"schemaVersion":"http://datacite.org/schema/kernel-4","source":"mds","isActive":true,"state":"findable","reason":null,"viewCount":0,"downloadCount":0,"referenceCount":0,"citationCount":1,"partCount":0,"partOfCount":0,"versionCount":0,"versionOfCount":0,"created":"2026-02-25T14:51:47Z","registered":"2026-02-25T14:51:48Z","published":null,"updated":"2026-02-25T14:51:48Z"},"relationships":{"client":{"data":{"id":"arxiv.content","type":"clients"}}}},{"id":"10.48550/arxiv.2602.19228","type":"dois","attributes":{"doi":"10.48550/arxiv.2602.19228","identifiers":[{"identifier":"2602.19228","identifierType":"arXiv"}],"creators":[{"nameType":"Personal","givenName":"Yao-Ting","familyName":"Wang","name":"Wang, Yao-Ting","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Hsu-Huei","familyName":"Chou","name":"Chou, Hsu-Huei","affiliation":[],"nameIdentifiers":[]}],"titles":[{"title":"Temporal Coupled Mode Theory for a Single Floquet-Sheet Resonator"}],"publisher":"arXiv","container":{},"publicationYear":2026,"subjects":[{"subject":"Optics (physics.optics)","lang":"en","subjectScheme":"arXiv"},{"subject":"FOS: Physical sciences","subjectScheme":"Fields of Science and Technology (FOS)"},{"schemeUri":"http://www.oecd.org/science/inno/38235147.pdf","subject":"FOS: Physical sciences","subjectScheme":"Fields of Science and Technology (FOS)"}],"contributors":[],"dates":[{"date":"2026-02-22T15:20:57Z","dateType":"Submitted","dateInformation":"v1"},{"date":"2026-02-24T01:52:51Z","dateType":"Updated","dateInformation":"v1"},{"date":"2026-02","dateType":"Available","dateInformation":"v1"},{"date":"2026","dateType":"Issued"}],"language":null,"types":{"schemaOrg":"CreativeWork","resourceTypeGeneral":"Preprint","citeproc":"article","bibtex":"misc","ris":"GEN","resourceType":"Article"},"relatedIdentifiers":[],"relatedItems":[],"sizes":[],"formats":[],"version":"1","rightsList":[{"rightsIdentifierScheme":"SPDX","rightsUri":"https://creativecommons.org/licenses/by/4.0/legalcode","schemeUri":"https://spdx.org/licenses/","rights":"Creative Commons Attribution 4.0 International","rightsIdentifier":"cc-by-4.0"}],"descriptions":[{"descriptionType":"Abstract","description":"We develop a rigorous Temporal Coupled-Mode Theory (TCMT) specifically tailored for a single Floquet-sheet resonator governed by time-modulated conductivities. By invoking photon-number conservation during frequency conversion, we derive characteristic radiative decay rates and coupling coefficients that account for the frequency ratio between channels. We establish a systematic bridge to the Floquet Transfer Matrix Method (TMM), providing closed-form analytical expressions that map scattering parameters to the Drude-type physics of the sheet. Our model explicitly captures the resonant coupling between the 0th-order propagating channel and the -1st-order surface-mode channel. Validated by COMSOL numerical simulations, the theory remains robust even when intrinsic material loss is incorporated. This framework offers an intuitive pole-expansion representation for designing time-varying photonic interfaces."},{"descriptionType":"Other","description":"23 pages, 4 figures"}],"geoLocations":[],"fundingReferences":[],"url":"https://arxiv.org/abs/2602.19228","contentUrl":null,"metadataVersion":0,"schemaVersion":"http://datacite.org/schema/kernel-4","source":"mds","isActive":true,"state":"findable","reason":null,"viewCount":0,"downloadCount":0,"referenceCount":0,"citationCount":0,"partCount":0,"partOfCount":0,"versionCount":0,"versionOfCount":0,"created":"2026-02-25T14:51:45Z","registered":"2026-02-25T14:51:46Z","published":null,"updated":"2026-02-25T14:51:46Z"},"relationships":{"client":{"data":{"id":"arxiv.content","type":"clients"}}}},{"id":"10.48550/arxiv.2602.19227","type":"dois","attributes":{"doi":"10.48550/arxiv.2602.19227","identifiers":[{"identifier":"2602.19227","identifierType":"arXiv"}],"creators":[{"nameType":"Personal","givenName":"Masafumi","familyName":"Noguchi","name":"Noguchi, Masafumi","affiliation":[],"nameIdentifiers":[]}],"titles":[{"title":"Feedback shaped the galaxy morphological sequence in presence of mergers"}],"publisher":"arXiv","container":{},"publicationYear":2026,"subjects":[{"subject":"Astrophysics of Galaxies (astro-ph.GA)","lang":"en","subjectScheme":"arXiv"},{"subject":"FOS: Physical sciences","subjectScheme":"Fields of Science and Technology (FOS)"},{"schemeUri":"http://www.oecd.org/science/inno/38235147.pdf","subject":"FOS: Physical sciences","subjectScheme":"Fields of Science and Technology (FOS)"}],"contributors":[],"dates":[{"date":"2026-02-22T15:18:39Z","dateType":"Submitted","dateInformation":"v1"},{"date":"2026-02-25T01:30:02Z","dateType":"Updated","dateInformation":"v1"},{"date":"2026-02","dateType":"Available","dateInformation":"v1"},{"date":"2026","dateType":"Issued"}],"language":null,"types":{"schemaOrg":"CreativeWork","resourceTypeGeneral":"Preprint","citeproc":"article","bibtex":"misc","ris":"GEN","resourceType":"Article"},"relatedIdentifiers":[{"relationType":"IsVersionOf","relatedIdentifier":"10.33232/001c.158272","relatedIdentifierType":"DOI"}],"relatedItems":[],"sizes":[],"formats":[],"version":"1","rightsList":[{"rightsIdentifierScheme":"SPDX","rightsUri":"https://creativecommons.org/licenses/by/4.0/legalcode","schemeUri":"https://spdx.org/licenses/","rights":"Creative Commons Attribution 4.0 International","rightsIdentifier":"cc-by-4.0"}],"descriptions":[{"descriptionType":"Abstract","description":"Bulges and disks are major structural components that define galaxy morphology. The mass ratios of bulges and disks increase statistically with the galaxy mass, with the high-mass end occupied by elliptical galaxies. Although previous theoretical studies have succeeded in reproducing this morphological sequence, it is not yet fully understood why and how this morphological sequence emerged. Galaxy mergers accompanying dark matter halo mergers have been proposed as the major route for bulge formation. On the other hand, it is observationally known that the mass fraction of galaxies (stars plus cold gas) in dark matter halos attains the peak value at $M_{\\rm halo} \\sim 10^{12} {\\rm M}_\\odot$ throughout the cosmic time. Using a simple galaxy evolution model including mergers, we show that this feature is the fundamental cause of the morphological sequence. Halos hosting massive galaxies, which stay more massive than this peak mass for long periods during their growth, merge mostly with satellite halos having larger galaxy mass fractions than themselves. Such mergers increase the bulge mass fraction efficiently. In contrast, host halos of low-mass galaxies evolve under unfavorable condition for bulge growth because they stay below the peak mass and merge with satellite halos with smaller galaxy mass fractions. Previous studies suggest that the peak in galaxy mass fraction is created by feedback processes from active galactic nuclei (AGN) and young massive stars including supernovae (SN), which are considered to suppress star formation in high-mass and low-mass galaxies, respectively. This study thus points to a close relationship between the galaxy morphology and feedback processes which have hitherto been considered unrelated and suggests the importance of further investigation into their causal relationship."},{"descriptionType":"Other","description":"Published in the Open Journal of Astrophysics"}],"geoLocations":[],"fundingReferences":[],"url":"https://arxiv.org/abs/2602.19227","contentUrl":null,"metadataVersion":0,"schemaVersion":"http://datacite.org/schema/kernel-4","source":"mds","isActive":true,"state":"findable","reason":null,"viewCount":0,"downloadCount":0,"referenceCount":0,"citationCount":0,"partCount":0,"partOfCount":0,"versionCount":0,"versionOfCount":1,"created":"2026-02-25T14:51:43Z","registered":"2026-02-25T14:51:43Z","published":null,"updated":"2026-02-25T14:51:43Z"},"relationships":{"client":{"data":{"id":"arxiv.content","type":"clients"}}}},{"id":"10.48550/arxiv.2602.19226","type":"dois","attributes":{"doi":"10.48550/arxiv.2602.19226","identifiers":[{"identifier":"2602.19226","identifierType":"arXiv"}],"creators":[{"nameType":"Personal","givenName":"Raman","familyName":"Hissariya","name":"Hissariya, Raman","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Gajjala Venkata Sreekar","familyName":"Reddy","name":"Reddy, Gajjala Venkata Sreekar","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Ashwin","familyName":"Tulapurkar","name":"Tulapurkar, Ashwin","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Debanjan","familyName":"Bhowmik","name":"Bhowmik, Debanjan","affiliation":[],"nameIdentifiers":[]}],"titles":[{"title":"Artificial Neural Network (ANN) -- Oscillatory Neural Network (ONN) Hybrid System Using Domain-Wall Synapse Devices and Nano-Constriction Spin Hall Nano Oscillators"}],"publisher":"arXiv","container":{},"publicationYear":2026,"subjects":[{"subject":"Applied Physics (physics.app-ph)","lang":"en","subjectScheme":"arXiv"},{"subject":"Mesoscale and Nanoscale Physics (cond-mat.mes-hall)","lang":"en","subjectScheme":"arXiv"},{"subject":"FOS: Physical sciences","subjectScheme":"Fields of Science and Technology (FOS)"},{"schemeUri":"http://www.oecd.org/science/inno/38235147.pdf","subject":"FOS: Physical sciences","subjectScheme":"Fields of Science and Technology (FOS)"}],"contributors":[],"dates":[{"date":"2026-02-22T15:18:31Z","dateType":"Submitted","dateInformation":"v1"},{"date":"2026-02-24T01:52:47Z","dateType":"Updated","dateInformation":"v1"},{"date":"2026-02","dateType":"Available","dateInformation":"v1"},{"date":"2026","dateType":"Issued"}],"language":null,"types":{"schemaOrg":"CreativeWork","resourceTypeGeneral":"Preprint","citeproc":"article","bibtex":"misc","ris":"GEN","resourceType":"Article"},"relatedIdentifiers":[],"relatedItems":[],"sizes":[],"formats":[],"version":"1","rightsList":[{"rightsIdentifierScheme":"SPDX","rightsUri":"https://creativecommons.org/licenses/by-nc-nd/4.0/legalcode","schemeUri":"https://spdx.org/licenses/","rights":"Creative Commons Attribution Non Commercial No Derivatives 4.0 International","rightsIdentifier":"cc-by-nc-nd-4.0"}],"descriptions":[{"descriptionType":"Abstract","description":"A coupled spintronic oscillator array has been considered attractive for neuromorphic computing applications. Experimental reports have shown the nano-constriction geometry to be a relatively easier-to-fabricate platform for implementing such spin oscillators, but most prior reports on training and inference algorithms for neuromorphic computing using spin oscillators have been mostly restricted to the nano-pillar geometry. Also, those prior reports involve updating the natural frequency values of the oscillators and moving the synchronization regions on to the data clusters during the offline learning phase, which has associated challenges. In this context, we design and simulate a novel artificial neural network (ANN) - oscillator neural network (ONN) algorithm where in the offline learning phase, the weight parameters of the ANN are updated such that the data clusters are instead moved to the synchronization regions of spin Hall nano oscillators (SHNOs) in the nano-constriction geometry, as obtained through micromagnetic simulations. We further simulate the on-chip inference part of the ANN-ONN algorithm where the ANN is implemented on a crossbar array of domain-wall synapse devices, as simulated here through micromagnetics, and the ONN is implemented on nano-constriction SHNOs. We show successful data classification for both binary and multi-class classification tasks to demonstrate the generalizability of our proposed scheme."},{"descriptionType":"Other","description":"9 figures and 5 tables in main manuscript (24 pages), 3 figures in supplementary material (3 pages)"}],"geoLocations":[],"fundingReferences":[],"url":"https://arxiv.org/abs/2602.19226","contentUrl":null,"metadataVersion":0,"schemaVersion":"http://datacite.org/schema/kernel-4","source":"mds","isActive":true,"state":"findable","reason":null,"viewCount":0,"downloadCount":0,"referenceCount":0,"citationCount":0,"partCount":0,"partOfCount":0,"versionCount":0,"versionOfCount":0,"created":"2026-02-25T14:51:40Z","registered":"2026-02-25T14:51:41Z","published":null,"updated":"2026-02-25T14:51:41Z"},"relationships":{"client":{"data":{"id":"arxiv.content","type":"clients"}}}},{"id":"10.48550/arxiv.2602.19225","type":"dois","attributes":{"doi":"10.48550/arxiv.2602.19225","identifiers":[{"identifier":"2602.19225","identifierType":"arXiv"}],"creators":[{"nameType":"Personal","givenName":"Yangyi","familyName":"Fang","name":"Fang, Yangyi","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Jiaye","familyName":"Lin","name":"Lin, Jiaye","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Xiaoliang","familyName":"Fu","name":"Fu, Xiaoliang","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Cong","familyName":"Qin","name":"Qin, Cong","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Haolin","familyName":"Shi","name":"Shi, Haolin","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Chang","familyName":"Liu","name":"Liu, Chang","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Peilin","familyName":"Zhao","name":"Zhao, Peilin","affiliation":[],"nameIdentifiers":[]}],"titles":[{"title":"Proximity-Based Multi-Turn Optimization: Practical Credit Assignment for LLM Agent Training"}],"publisher":"arXiv","container":{},"publicationYear":2026,"subjects":[{"subject":"Artificial Intelligence (cs.AI)","lang":"en","subjectScheme":"arXiv"},{"subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"},{"schemeUri":"http://www.oecd.org/science/inno/38235147.pdf","subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"}],"contributors":[],"dates":[{"date":"2026-02-22T15:18:03Z","dateType":"Submitted","dateInformation":"v1"},{"date":"2026-02-24T01:52:46Z","dateType":"Updated","dateInformation":"v1"},{"date":"2026-02","dateType":"Available","dateInformation":"v1"},{"date":"2026","dateType":"Issued"}],"language":null,"types":{"schemaOrg":"CreativeWork","resourceTypeGeneral":"Preprint","citeproc":"article","bibtex":"misc","ris":"GEN","resourceType":"Article"},"relatedIdentifiers":[],"relatedItems":[],"sizes":[],"formats":[],"version":"1","rightsList":[{"rightsIdentifierScheme":"SPDX","rightsUri":"https://creativecommons.org/licenses/by/4.0/legalcode","schemeUri":"https://spdx.org/licenses/","rights":"Creative Commons Attribution 4.0 International","rightsIdentifier":"cc-by-4.0"}],"descriptions":[{"descriptionType":"Abstract","description":"Multi-turn LLM agents are becoming pivotal to production systems, spanning customer service automation, e-commerce assistance, and interactive task management, where accurately distinguishing high-value informative signals from stochastic noise is critical for sample-efficient training. In real-world scenarios, a failure in a trivial task may reflect random instability, whereas success in a high-difficulty task signifies a genuine capability breakthrough. Yet, existing group-based policy optimization methods rigidly rely on statistical deviation within discrete batches, frequently misallocating credit when task difficulty fluctuates. To address this issue, we propose Proximity-based Multi-turn Optimization (ProxMO), a practical and robust framework engineered specifically for the constraints of real-world deployment. ProxMO integrates global context via two lightweight mechanisms: success-rate-aware modulation dynamically adapts gradient intensity based on episode-level difficulty, while proximity-based soft aggregation derives baselines through continuous semantic weighting at the step level. Extensive evaluations on ALFWorld and WebShop benchmarks demonstrate that ProxMO yields substantial performance gains over existing baselines with negligible computational cost. Ablation studies further validate the independent and synergistic efficacy of both mechanisms. Crucially, ProxMO offers plug-and-play compatibility with standard GRPO frameworks, facilitating immediate, low-friction adoption in existing industrial training pipelines. Our implementation is available at: \\href{https://anonymous.4open.science/r/proxmo-B7E7/README.md}{https://anonymous.4open.science/r/proxmo}."}],"geoLocations":[],"fundingReferences":[],"url":"https://arxiv.org/abs/2602.19225","contentUrl":null,"metadataVersion":0,"schemaVersion":"http://datacite.org/schema/kernel-4","source":"mds","isActive":true,"state":"findable","reason":null,"viewCount":0,"downloadCount":0,"referenceCount":0,"citationCount":0,"partCount":0,"partOfCount":0,"versionCount":0,"versionOfCount":0,"created":"2026-02-25T14:51:38Z","registered":"2026-02-25T14:51:39Z","published":null,"updated":"2026-02-25T14:51:39Z"},"relationships":{"client":{"data":{"id":"arxiv.content","type":"clients"}}}},{"id":"10.48550/arxiv.2602.19224","type":"dois","attributes":{"doi":"10.48550/arxiv.2602.19224","identifiers":[{"identifier":"2602.19224","identifierType":"arXiv"}],"creators":[{"nameType":"Personal","givenName":"Siran","familyName":"Li","name":"Li, Siran","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Li","familyName":"Mi","name":"Mi, Li","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Javiera","familyName":"Castillo-Navarro","name":"Castillo-Navarro, Javiera","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Devis","familyName":"Tuia","name":"Tuia, Devis","affiliation":[],"nameIdentifiers":[]}],"titles":[{"title":"Knowledge-aware Visual Question Generation for Remote Sensing Images"}],"publisher":"arXiv","container":{},"publicationYear":2026,"subjects":[{"subject":"Computer Vision and Pattern Recognition (cs.CV)","lang":"en","subjectScheme":"arXiv"},{"subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"},{"schemeUri":"http://www.oecd.org/science/inno/38235147.pdf","subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"}],"contributors":[],"dates":[{"date":"2026-02-22T15:18:01Z","dateType":"Submitted","dateInformation":"v1"},{"date":"2026-02-24T01:52:45Z","dateType":"Updated","dateInformation":"v1"},{"date":"2026-02","dateType":"Available","dateInformation":"v1"},{"date":"2026","dateType":"Issued"}],"language":null,"types":{"schemaOrg":"CreativeWork","resourceTypeGeneral":"Preprint","citeproc":"article","bibtex":"misc","ris":"GEN","resourceType":"Article"},"relatedIdentifiers":[],"relatedItems":[],"sizes":[],"formats":[],"version":"1","rightsList":[{"rightsUri":"http://arxiv.org/licenses/nonexclusive-distrib/1.0/","rights":"arXiv.org perpetual, non-exclusive license"}],"descriptions":[{"descriptionType":"Abstract","description":"With the rapid development of remote sensing image archives, asking questions about images has become an effective way of gathering specific information or performing image retrieval. However, automatically generated image-based questions tend to be simplistic and template-based, which hinders the real deployment of question answering or visual dialogue systems. To enrich and diversify the questions, we propose a knowledge-aware remote sensing visual question generation model, KRSVQG, that incorporates external knowledge related to the image content to improve the quality and contextual understanding of the generated questions. The model takes an image and a related knowledge triplet from external knowledge sources as inputs and leverages image captioning as an intermediary representation to enhance the image grounding of the generated questions. To assess the performance of KRSVQG, we utilized two datasets that we manually annotated: NWPU-300 and TextRS-300. Results on these two datasets demonstrate that KRSVQG outperforms existing methods and leads to knowledge-enriched questions, grounded in both image and domain knowledge."}],"geoLocations":[],"fundingReferences":[],"url":"https://arxiv.org/abs/2602.19224","contentUrl":null,"metadataVersion":0,"schemaVersion":"http://datacite.org/schema/kernel-4","source":"mds","isActive":true,"state":"findable","reason":null,"viewCount":0,"downloadCount":0,"referenceCount":0,"citationCount":0,"partCount":0,"partOfCount":0,"versionCount":0,"versionOfCount":0,"created":"2026-02-25T14:51:35Z","registered":"2026-02-25T14:51:36Z","published":null,"updated":"2026-02-25T14:51:36Z"},"relationships":{"client":{"data":{"id":"arxiv.content","type":"clients"}}}},{"id":"10.48550/arxiv.2602.19221","type":"dois","attributes":{"doi":"10.48550/arxiv.2602.19221","identifiers":[{"identifier":"2602.19221","identifierType":"arXiv"}],"creators":[{"nameType":"Personal","givenName":"Rajesh","familyName":"Tripathi","name":"Tripathi, Rajesh","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Ewan","familyName":"Scott","name":"Scott, Ewan","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"D. T.","familyName":"Adroja","name":"Adroja, D. T.","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"D.","familyName":"Das","name":"Das, D.","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"C.","familyName":"Ritter","name":"Ritter, C.","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Huanzhi","familyName":"Hu","name":"Hu, Huanzhi","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Michal P.","familyName":"Kwasigroch","name":"Kwasigroch, Michal P.","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Nicholas","familyName":"Corkill","name":"Corkill, Nicholas","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Gheorghe Lucian","familyName":"Pascut","name":"Pascut, Gheorghe Lucian","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"T.","familyName":"Masuda","name":"Masuda, T.","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"S.","familyName":"Asai","name":"Asai, S.","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"T.","familyName":"Takabatake","name":"Takabatake, T.","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"T.","familyName":"Onimaru","name":"Onimaru, T.","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"T.","familyName":"Shiroka","name":"Shiroka, T.","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Francis","familyName":"Pratt","name":"Pratt, Francis","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"A. M.","familyName":"Strydom","name":"Strydom, A. M.","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"S.","familyName":"Langridge","name":"Langridge, S.","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"A.","familyName":"Sundaresan","name":"Sundaresan, A.","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"S.","familyName":"Patil","name":"Patil, S.","affiliation":[],"nameIdentifiers":[]}],"titles":[{"title":"Microscopic origin of hard-plane antiferromagnetism in the Kondo lattice Ce2Rh3Ge5"}],"publisher":"arXiv","container":{},"publicationYear":2026,"subjects":[{"subject":"Strongly Correlated Electrons (cond-mat.str-el)","lang":"en","subjectScheme":"arXiv"},{"subject":"Materials Science (cond-mat.mtrl-sci)","lang":"en","subjectScheme":"arXiv"},{"subject":"FOS: Physical sciences","subjectScheme":"Fields of Science and Technology (FOS)"},{"schemeUri":"http://www.oecd.org/science/inno/38235147.pdf","subject":"FOS: Physical sciences","subjectScheme":"Fields of Science and Technology (FOS)"}],"contributors":[],"dates":[{"date":"2026-02-22T15:08:48Z","dateType":"Submitted","dateInformation":"v1"},{"date":"2026-02-24T01:52:31Z","dateType":"Updated","dateInformation":"v1"},{"date":"2026-02","dateType":"Available","dateInformation":"v1"},{"date":"2026","dateType":"Issued"}],"language":null,"types":{"schemaOrg":"CreativeWork","resourceTypeGeneral":"Preprint","citeproc":"article","bibtex":"misc","ris":"GEN","resourceType":"Article"},"relatedIdentifiers":[],"relatedItems":[],"sizes":[],"formats":[],"version":"1","rightsList":[{"rightsUri":"http://arxiv.org/licenses/nonexclusive-distrib/1.0/","rights":"arXiv.org perpetual, non-exclusive license"}],"descriptions":[{"descriptionType":"Abstract","description":"Hard plane antiferromagnetic order where ordered moments lie perpendicular to the single-ion crystal electric field easy axis is rare in Ce-based Kondo lattices and is a subject of active interest. Here we show that Ce$_2$Rh$_3$Ge$_5$ realizes a hard-plane antiferromagnetic state in which partial delocalization of the local moment gives rise to an RKKY exchange that overturns the single-ion easy-axis preference. Neutron diffraction reveals moments in the $ab$ plane, while inelastic neutron scattering and susceptibility establish a magnetic easy axis along $c$ in the paramagnetic regime, highlighting a clear inversion between single-ion and ordered-state anisotropies. In this work, we establish a unified microscopic framework to consistently account for partial $4f$-moment delocalization, enhanced in-plane RKKY exchange, and the resulting hard-plane antiferromagnetic order. Ce$_2$Rh$_3$Ge$_5$ thus provides a benchmark system in which single-ion anisotropy, Kondo screening, and RKKY exchange compete on comparable energy scales, revealing a cooperative route to hard-axis ordering in strongly hybridized Kondo lattices."},{"descriptionType":"Other","description":"19 pages, 9 figures"}],"geoLocations":[],"fundingReferences":[],"url":"https://arxiv.org/abs/2602.19221","contentUrl":null,"metadataVersion":0,"schemaVersion":"http://datacite.org/schema/kernel-4","source":"mds","isActive":true,"state":"findable","reason":null,"viewCount":0,"downloadCount":0,"referenceCount":0,"citationCount":0,"partCount":0,"partOfCount":0,"versionCount":0,"versionOfCount":0,"created":"2026-02-25T14:51:28Z","registered":"2026-02-25T14:51:29Z","published":null,"updated":"2026-02-25T14:51:29Z"},"relationships":{"client":{"data":{"id":"arxiv.content","type":"clients"}}}},{"id":"10.48550/arxiv.2602.19220","type":"dois","attributes":{"doi":"10.48550/arxiv.2602.19220","identifiers":[{"identifier":"2602.19220","identifierType":"arXiv"}],"creators":[{"nameType":"Personal","givenName":"Shanshan","familyName":"Liu","name":"Liu, Shanshan","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Guoqing","familyName":"Diao","name":"Diao, Guoqing","affiliation":[],"nameIdentifiers":[]}],"titles":[{"title":"A likelihood approach to proper analysis of secondary outcomes in matched case-control studies"}],"publisher":"arXiv","container":{},"publicationYear":2026,"subjects":[{"subject":"Methodology (stat.ME)","lang":"en","subjectScheme":"arXiv"},{"subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"},{"schemeUri":"http://www.oecd.org/science/inno/38235147.pdf","subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"}],"contributors":[],"dates":[{"date":"2026-02-22T15:07:43Z","dateType":"Submitted","dateInformation":"v1"},{"date":"2026-02-24T01:52:30Z","dateType":"Updated","dateInformation":"v1"},{"date":"2026-02","dateType":"Available","dateInformation":"v1"},{"date":"2026","dateType":"Issued"}],"language":null,"types":{"schemaOrg":"CreativeWork","resourceTypeGeneral":"Preprint","citeproc":"article","bibtex":"misc","ris":"GEN","resourceType":"Article"},"relatedIdentifiers":[],"relatedItems":[],"sizes":[],"formats":[],"version":"1","rightsList":[{"rightsIdentifierScheme":"SPDX","rightsUri":"https://creativecommons.org/licenses/by-nc-nd/4.0/legalcode","schemeUri":"https://spdx.org/licenses/","rights":"Creative Commons Attribution Non Commercial No Derivatives 4.0 International","rightsIdentifier":"cc-by-nc-nd-4.0"}],"descriptions":[{"descriptionType":"Abstract","description":"Matched case-control studies are commonly employed in epidemiological research for their convenience and efficiency. Analysis of secondary outcomes can yield valuable insights into biological pathways and help identify genetic variants of importance. Naive analysis using standard statistical methods, such as least-squares regression for quantitative traits, can be misleading because they fail to account for unequal sampling induced by the case-control design and matching. In this paper, we propose novel statistical methods that appropriately reflect the study design and sampling scheme in the analysis of secondary outcome data. The new methods provide consistent estimation and accurate coverage probabilities for the confidence interval estimators. We demonstrate the advantages of the new methods through simulation studies and a real application with diabetes patients. R code implementing the proposed methods is publicly available."}],"geoLocations":[],"fundingReferences":[],"url":"https://arxiv.org/abs/2602.19220","contentUrl":null,"metadataVersion":0,"schemaVersion":"http://datacite.org/schema/kernel-4","source":"mds","isActive":true,"state":"findable","reason":null,"viewCount":0,"downloadCount":0,"referenceCount":0,"citationCount":0,"partCount":0,"partOfCount":0,"versionCount":0,"versionOfCount":0,"created":"2026-02-25T14:51:25Z","registered":"2026-02-25T14:51:26Z","published":null,"updated":"2026-02-25T14:51:26Z"},"relationships":{"client":{"data":{"id":"arxiv.content","type":"clients"}}}},{"id":"10.48550/arxiv.2602.19219","type":"dois","attributes":{"doi":"10.48550/arxiv.2602.19219","identifiers":[{"identifier":"2602.19219","identifierType":"arXiv"}],"creators":[{"nameType":"Personal","givenName":"Joris","familyName":"Kirchner","name":"Kirchner, Joris","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Amogh","familyName":"Gudi","name":"Gudi, Amogh","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Marian","familyName":"Bittner","name":"Bittner, Marian","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Chirag","familyName":"Raman","name":"Raman, Chirag","affiliation":[],"nameIdentifiers":[]}],"titles":[{"title":"Controlled Face Manipulation and Synthesis for Data Augmentation"}],"publisher":"arXiv","container":{},"publicationYear":2026,"subjects":[{"subject":"Computer Vision and Pattern Recognition (cs.CV)","lang":"en","subjectScheme":"arXiv"},{"subject":"Machine Learning (cs.LG)","lang":"en","subjectScheme":"arXiv"},{"subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"},{"schemeUri":"http://www.oecd.org/science/inno/38235147.pdf","subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"}],"contributors":[],"dates":[{"date":"2026-02-22T15:03:06Z","dateType":"Submitted","dateInformation":"v1"},{"date":"2026-02-24T01:52:23Z","dateType":"Updated","dateInformation":"v1"},{"date":"2026-02","dateType":"Available","dateInformation":"v1"},{"date":"2026","dateType":"Issued"}],"language":null,"types":{"schemaOrg":"CreativeWork","resourceTypeGeneral":"Preprint","citeproc":"article","bibtex":"misc","ris":"GEN","resourceType":"Article"},"relatedIdentifiers":[],"relatedItems":[],"sizes":[],"formats":[],"version":"1","rightsList":[{"rightsUri":"http://arxiv.org/licenses/nonexclusive-distrib/1.0/","rights":"arXiv.org perpetual, non-exclusive license"}],"descriptions":[{"descriptionType":"Abstract","description":"Deep learning vision models excel with abundant supervision, but many applications face label scarcity and class imbalance. Controllable image editing can augment scarce labeled data, yet edits often introduce artifacts and entangle non-target attributes. We study this in facial expression analysis, targeting Action Unit (AU) manipulation where annotation is costly and AU co-activation drives entanglement. We present a facial manipulation method that operates in the semantic latent space of a pre-trained face generator (Diffusion Autoencoder). Using lightweight linear models, we reduce entanglement of semantic features via (i) dependency-aware conditioning that accounts for AU co-activation, and (ii) orthogonal projection that removes nuisance attribute directions (e.g., glasses), together with an expression neutralization step to enable absolute AU edit. We use these edits to balance AU occurrence by editing labeled faces and to diversify identities/demographics via controlled synthesis. Augmenting AU detector training with the generated data improves accuracy and yields more disentangled predictions with fewer co-activation shortcuts, outperforming alternative data-efficient training strategies and suggesting improvements similar to what would require substantially more labeled data in our learning-curve analysis. Compared to prior methods, our edits are stronger, produce fewer artifacts, and preserve identity better."}],"geoLocations":[],"fundingReferences":[],"url":"https://arxiv.org/abs/2602.19219","contentUrl":null,"metadataVersion":0,"schemaVersion":"http://datacite.org/schema/kernel-4","source":"mds","isActive":true,"state":"findable","reason":null,"viewCount":0,"downloadCount":0,"referenceCount":0,"citationCount":0,"partCount":0,"partOfCount":0,"versionCount":0,"versionOfCount":0,"created":"2026-02-25T14:51:23Z","registered":"2026-02-25T14:51:24Z","published":null,"updated":"2026-02-25T14:51:24Z"},"relationships":{"client":{"data":{"id":"arxiv.content","type":"clients"}}}},{"id":"10.48550/arxiv.2602.19217","type":"dois","attributes":{"doi":"10.48550/arxiv.2602.19217","identifiers":[{"identifier":"2602.19217","identifierType":"arXiv"}],"creators":[{"nameType":"Personal","givenName":"Siran","familyName":"Li","name":"Li, Siran","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Li","familyName":"Mi","name":"Mi, Li","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Javiera","familyName":"Castillo-Navarro","name":"Castillo-Navarro, Javiera","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Devis","familyName":"Tuia","name":"Tuia, Devis","affiliation":[],"nameIdentifiers":[]}],"titles":[{"title":"Questions beyond Pixels: Integrating Commonsense Knowledge in Visual Question Generation for Remote Sensing"}],"publisher":"arXiv","container":{},"publicationYear":2026,"subjects":[{"subject":"Computer Vision and Pattern Recognition (cs.CV)","lang":"en","subjectScheme":"arXiv"},{"subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"},{"schemeUri":"http://www.oecd.org/science/inno/38235147.pdf","subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"}],"contributors":[],"dates":[{"date":"2026-02-22T14:59:00Z","dateType":"Submitted","dateInformation":"v1"},{"date":"2026-02-24T01:52:18Z","dateType":"Updated","dateInformation":"v1"},{"date":"2026-02","dateType":"Available","dateInformation":"v1"},{"date":"2026","dateType":"Issued"}],"language":null,"types":{"schemaOrg":"CreativeWork","resourceTypeGeneral":"Preprint","citeproc":"article","bibtex":"misc","ris":"GEN","resourceType":"Article"},"relatedIdentifiers":[],"relatedItems":[],"sizes":[],"formats":[],"version":"1","rightsList":[{"rightsUri":"http://arxiv.org/licenses/nonexclusive-distrib/1.0/","rights":"arXiv.org perpetual, non-exclusive license"}],"descriptions":[{"descriptionType":"Abstract","description":"With the rapid development of remote sensing image archives, asking questions about images has become an effective way of gathering specific information or performing semantic image retrieval. However, current automatically generated questions tend to be simplistic and template-based, which hinders the deployment of question answering or visual dialogue systems for real-world applications. To enrich and diversify the questions with both image content and commonsense knowledge, we propose a Knowledge-aware Remote Sensing Visual Question Generation model (KRSVQG). The proposed model incorporates related knowledge triplets from external knowledge sources to broaden the question content, while employing image captioning as an intermediary representation to ground questions to the corresponding images. Moreover, KRSVQG utilizes a vision-language pre-training and fine-tuning strategy, enabling the model's adaptation to low data regimes. To evaluate the proposed KRSVQG model, we construct two knowledge-aware remote sensing visual question generation datasets: the NWPU-300 dataset and the TextRS-300 dataset. Evaluations, including metrics and human assessment, demonstrate that KRSVQG outperforms existing methods and leads to rich questions, grounded in both image and domain knowledge. As a key practice in vision-language research, knowledge-aware visual question generation advances the understanding of image content beyond pixels, facilitating the development of knowledge-enriched vision-language systems with vision-grounded human commonsense."}],"geoLocations":[],"fundingReferences":[],"url":"https://arxiv.org/abs/2602.19217","contentUrl":null,"metadataVersion":0,"schemaVersion":"http://datacite.org/schema/kernel-4","source":"mds","isActive":true,"state":"findable","reason":null,"viewCount":0,"downloadCount":0,"referenceCount":0,"citationCount":0,"partCount":0,"partOfCount":0,"versionCount":0,"versionOfCount":0,"created":"2026-02-25T14:51:18Z","registered":"2026-02-25T14:51:18Z","published":null,"updated":"2026-02-25T14:51:18Z"},"relationships":{"client":{"data":{"id":"arxiv.content","type":"clients"}}}},{"id":"10.48550/arxiv.2602.19216","type":"dois","attributes":{"doi":"10.48550/arxiv.2602.19216","identifiers":[{"identifier":"2602.19216","identifierType":"arXiv"}],"creators":[{"nameType":"Personal","givenName":"Luisa","familyName":"Stracqualursi","name":"Stracqualursi, Luisa","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Patrizia","familyName":"Agati","name":"Agati, Patrizia","affiliation":[],"nameIdentifiers":[]}],"titles":[{"title":"Statistical Measures for Explainable Aspect-Based Sentiment Analysis: A Case Study on Environmental Discourse in Reddit"}],"publisher":"arXiv","container":{},"publicationYear":2026,"subjects":[{"subject":"Methodology (stat.ME)","lang":"en","subjectScheme":"arXiv"},{"subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"},{"schemeUri":"http://www.oecd.org/science/inno/38235147.pdf","subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"},{"subject":"I.2.7; G.3","lang":"en","subjectScheme":"ACM"},{"subject":"62-08, 62F40, 62P25","lang":"en","subjectScheme":"MSC"}],"contributors":[],"dates":[{"date":"2026-02-22T14:52:29Z","dateType":"Submitted","dateInformation":"v1"},{"date":"2026-02-24T01:52:15Z","dateType":"Updated","dateInformation":"v1"},{"date":"2026-02","dateType":"Available","dateInformation":"v1"},{"date":"2026","dateType":"Issued"}],"language":null,"types":{"schemaOrg":"CreativeWork","resourceTypeGeneral":"Preprint","citeproc":"article","bibtex":"misc","ris":"GEN","resourceType":"Article"},"relatedIdentifiers":[{"relationType":"IsVersionOf","relatedIdentifier":"10.1080/02331888.2026.2636122","relatedIdentifierType":"DOI"}],"relatedItems":[],"sizes":[],"formats":[],"version":"1","rightsList":[{"rightsUri":"http://arxiv.org/licenses/nonexclusive-distrib/1.0/","rights":"arXiv.org perpetual, non-exclusive license"}],"descriptions":[{"descriptionType":"Abstract","description":"Aspect-Based Sentiment Analysis (ABSA) provides a fine-grained understanding of opinions by linking sentiment to specific aspects in text. While transformer-based models excel at this task, their black-box nature limits their interpretability, posing risks in real-world applications without labeled data. This paper introduces a statistical, model-agnostic framework to assess the behavioral transparency and trustworthiness of ABSA models. Our framework relies on several metrics, such as the entropy of polarity distributions, soft-count-based dominance scores, and sentiment divergence between sources, whose robustness is validated through bootstrap resampling and sensitivity analysis. A case study on environmentally focused Reddit communities illustrates how the proposed indicators provide interpretable diagnostics of model certainty, decisiveness, and cross-source variability. The results show that statistical indicators computed on soft outputs can complement traditional approaches, offering a computationally efficient methodology for validating, monitoring, and interpreting ABSA models in contexts where labeled data are unavailable."},{"descriptionType":"Other","description":"Preprint of an article accepted for publication in Statistics (Taylor \u0026amp; Francis). 14 pages, 2 figures, 4 tables"}],"geoLocations":[],"fundingReferences":[],"url":"https://arxiv.org/abs/2602.19216","contentUrl":null,"metadataVersion":0,"schemaVersion":"http://datacite.org/schema/kernel-4","source":"mds","isActive":true,"state":"findable","reason":null,"viewCount":0,"downloadCount":0,"referenceCount":0,"citationCount":0,"partCount":0,"partOfCount":0,"versionCount":0,"versionOfCount":1,"created":"2026-02-25T14:51:15Z","registered":"2026-02-25T14:51:16Z","published":null,"updated":"2026-02-25T14:51:16Z"},"relationships":{"client":{"data":{"id":"arxiv.content","type":"clients"}}}},{"id":"10.48550/arxiv.2602.19215","type":"dois","attributes":{"doi":"10.48550/arxiv.2602.19215","identifiers":[{"identifier":"2602.19215","identifierType":"arXiv"}],"creators":[{"nameType":"Personal","givenName":"Shingo","familyName":"Kodama","name":"Kodama, Shingo","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Niv","familyName":"Cohen","name":"Cohen, Niv","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Micah","familyName":"Adler","name":"Adler, Micah","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Nir","familyName":"Shavit","name":"Shavit, Nir","affiliation":[],"nameIdentifiers":[]}],"titles":[{"title":"Understanding Empirical Unlearning with Combinatorial Interpretability"}],"publisher":"arXiv","container":{},"publicationYear":2026,"subjects":[{"subject":"Machine Learning (cs.LG)","lang":"en","subjectScheme":"arXiv"},{"subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"},{"schemeUri":"http://www.oecd.org/science/inno/38235147.pdf","subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"}],"contributors":[],"dates":[{"date":"2026-02-22T14:51:48Z","dateType":"Submitted","dateInformation":"v1"},{"date":"2026-02-24T01:52:14Z","dateType":"Updated","dateInformation":"v1"},{"date":"2026-02","dateType":"Available","dateInformation":"v1"},{"date":"2026","dateType":"Issued"}],"language":null,"types":{"schemaOrg":"CreativeWork","resourceTypeGeneral":"Preprint","citeproc":"article","bibtex":"misc","ris":"GEN","resourceType":"Article"},"relatedIdentifiers":[],"relatedItems":[],"sizes":[],"formats":[],"version":"1","rightsList":[{"rightsUri":"http://arxiv.org/licenses/nonexclusive-distrib/1.0/","rights":"arXiv.org perpetual, non-exclusive license"}],"descriptions":[{"descriptionType":"Abstract","description":"While many recent methods aim to unlearn or remove knowledge from pretrained models, seemingly erased knowledge often persists and can be recovered in various ways. Because large foundation models are far from interpretable, understanding whether and how such knowledge persists remains a significant challenge. To address this, we turn to the recently developed framework of combinatorial interpretability. This framework, designed for two-layer neural networks, enables direct inspection of the knowledge encoded in the model weights. We reproduce baseline unlearning methods within the combinatorial interpretability setting and examine their behavior along two dimensions: (i) whether they truly remove knowledge of a target concept (the concept we wish to remove) or merely inhibit its expression while retaining the underlying information, and (ii) how easily the supposedly erased knowledge can be recovered through various fine-tuning operations. Our results shed light within a fully interpretable setting on how knowledge can persist despite unlearning and when it might resurface."}],"geoLocations":[],"fundingReferences":[],"url":"https://arxiv.org/abs/2602.19215","contentUrl":null,"metadataVersion":0,"schemaVersion":"http://datacite.org/schema/kernel-4","source":"mds","isActive":true,"state":"findable","reason":null,"viewCount":0,"downloadCount":0,"referenceCount":0,"citationCount":0,"partCount":0,"partOfCount":0,"versionCount":0,"versionOfCount":0,"created":"2026-02-25T14:51:12Z","registered":"2026-02-25T14:51:13Z","published":null,"updated":"2026-02-25T14:51:13Z"},"relationships":{"client":{"data":{"id":"arxiv.content","type":"clients"}}}},{"id":"10.48550/arxiv.2602.19214","type":"dois","attributes":{"doi":"10.48550/arxiv.2602.19214","identifiers":[{"identifier":"2602.19214","identifierType":"arXiv"}],"creators":[{"nameType":"Personal","givenName":"M. A.","familyName":"Hashad","name":"Hashad, M. A.","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"A.","familyName":"Hammad","name":"Hammad, A.","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Amr A.","familyName":"EL-Zant","name":"EL-Zant, Amr A.","affiliation":[],"nameIdentifiers":[]}],"titles":[{"title":"Potential periodic signals in blazars: significance, forecasting and deep learning"}],"publisher":"arXiv","container":{},"publicationYear":2026,"subjects":[{"subject":"High Energy Astrophysical Phenomena (astro-ph.HE)","lang":"en","subjectScheme":"arXiv"},{"subject":"FOS: Physical sciences","subjectScheme":"Fields of Science and Technology (FOS)"},{"schemeUri":"http://www.oecd.org/science/inno/38235147.pdf","subject":"FOS: Physical sciences","subjectScheme":"Fields of Science and Technology (FOS)"}],"contributors":[],"dates":[{"date":"2026-02-22T14:50:59Z","dateType":"Submitted","dateInformation":"v1"},{"date":"2026-02-24T01:52:12Z","dateType":"Updated","dateInformation":"v1"},{"date":"2026-02","dateType":"Available","dateInformation":"v1"},{"date":"2026","dateType":"Issued"}],"language":null,"types":{"schemaOrg":"CreativeWork","resourceTypeGeneral":"Preprint","citeproc":"article","bibtex":"misc","ris":"GEN","resourceType":"Article"},"relatedIdentifiers":[],"relatedItems":[],"sizes":[],"formats":[],"version":"1","rightsList":[{"rightsIdentifierScheme":"SPDX","rightsUri":"https://creativecommons.org/licenses/by/4.0/legalcode","schemeUri":"https://spdx.org/licenses/","rights":"Creative Commons Attribution 4.0 International","rightsIdentifier":"cc-by-4.0"}],"descriptions":[{"descriptionType":"Abstract","description":"Blazars exhibit variable emission on diverse timescales. Some light curves show signs of quasiperiodic oscillations (QPOs), which may encode clues regarding the physical processes behind the emission or point to supermassive binary black holes. We analyzed five blazars with previously reported high significance year-long QPOs, applying the Lomb-Scargle periodogram and Weighted Wavelet Z-transform methods to Fermi-LAT data up to early 2025. We furthermore examined an additional source (PKS 0139-09), where nascent QPO may be present. As the light curves showed longer term trends, we detrended the data using an STL decomposition, which often revealed a large seasonal component. We find that detrending generally leads to an increase in the strength of the QPO signal. However, except for PG 1553+113, where a clearly persistent QPO signal is present, we detect transience on a timescale of $\\lesssim$4000 days. We then forecast the light curves over the following four years, using a traditional statistical method as well as a Transformer-based deep learning model. Applied to a test set, the latter showed significant success in predicting behavior that seems unexpected from simple inspection of the past data. Analyzing the extended time series suggests a markedly weaker QPO signals over the coming years in cases where the transient behavior appears near the end of the observational data. In contrast, in the nascent candidate QPO source (PKS 0139-09) the signal is expected to strengthen significantly. These predictions, which may reflect the physical origin of the QPOs, can be tested against future data."}],"geoLocations":[],"fundingReferences":[],"url":"https://arxiv.org/abs/2602.19214","contentUrl":null,"metadataVersion":0,"schemaVersion":"http://datacite.org/schema/kernel-4","source":"mds","isActive":true,"state":"findable","reason":null,"viewCount":0,"downloadCount":0,"referenceCount":0,"citationCount":0,"partCount":0,"partOfCount":0,"versionCount":0,"versionOfCount":0,"created":"2026-02-25T14:51:09Z","registered":"2026-02-25T14:51:10Z","published":null,"updated":"2026-02-25T14:51:10Z"},"relationships":{"client":{"data":{"id":"arxiv.content","type":"clients"}}}},{"id":"10.48550/arxiv.2602.19212","type":"dois","attributes":{"doi":"10.48550/arxiv.2602.19212","identifiers":[{"identifier":"2602.19212","identifierType":"arXiv"}],"creators":[{"nameType":"Personal","givenName":"Raihan","familyName":"Tanvir","name":"Tanvir, Raihan","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Md. Golam Rabiul","familyName":"Alam","name":"Alam, Md. Golam Rabiul","affiliation":[],"nameIdentifiers":[]}],"titles":[{"title":"Retrieval Augmented Enhanced Dual Co-Attention Framework for Target Aware Multimodal Bengali Hateful Meme Detection"}],"publisher":"arXiv","container":{},"publicationYear":2026,"subjects":[{"subject":"Computation and Language (cs.CL)","lang":"en","subjectScheme":"arXiv"},{"subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"},{"schemeUri":"http://www.oecd.org/science/inno/38235147.pdf","subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"}],"contributors":[],"dates":[{"date":"2026-02-22T14:48:25Z","dateType":"Submitted","dateInformation":"v1"},{"date":"2026-02-24T01:52:09Z","dateType":"Updated","dateInformation":"v1"},{"date":"2026-02","dateType":"Available","dateInformation":"v1"},{"date":"2026","dateType":"Issued"}],"language":null,"types":{"schemaOrg":"CreativeWork","resourceTypeGeneral":"Preprint","citeproc":"article","bibtex":"misc","ris":"GEN","resourceType":"Article"},"relatedIdentifiers":[],"relatedItems":[],"sizes":[],"formats":[],"version":"1","rightsList":[{"rightsUri":"http://arxiv.org/licenses/nonexclusive-distrib/1.0/","rights":"arXiv.org perpetual, non-exclusive license"}],"descriptions":[{"descriptionType":"Abstract","description":"Hateful content on social media increasingly appears as multimodal memes that combine images and text to convey harmful narratives. In low-resource languages such as Bengali, automated detection remains challenging due to limited annotated data, class imbalance, and pervasive code-mixing. To address these issues, we augment the Bengali Hateful Memes (BHM) dataset with semantically aligned samples from the Multimodal Aggression Dataset in Bengali (MIMOSA), improving both class balance and semantic diversity. We propose the Enhanced Dual Co-attention Framework (xDORA), integrating vision encoders (CLIP, DINOv2) and multilingual text encoders (XGLM, XLM-R) via weighted attention pooling to learn robust cross-modal representations. Building on these embeddings, we develop a FAISS-based k-nearest neighbor classifier for non-parametric inference and introduce RAG-Fused DORA, which incorporates retrieval-driven contextual reasoning. We further evaluate LLaVA under zero-shot, few-shot, and retrieval-augmented prompting settings. Experiments on the extended dataset show that xDORA (CLIP + XLM-R) achieves macro-average F1-scores of 0.78 for hateful meme identification and 0.71 for target entity detection, while RAG-Fused DORA improves performance to 0.79 and 0.74, yielding gains over the DORA baseline. The FAISS-based classifier performs competitively and demonstrates robustness for rare classes through semantic similarity modeling. In contrast, LLaVA exhibits limited effectiveness in few-shot settings, with only modest improvements under retrieval augmentation, highlighting constraints of pretrained vision-language models for code-mixed Bengali content without fine-tuning. These findings demonstrate the effectiveness of supervised, retrieval-augmented, and non-parametric multimodal frameworks for addressing linguistic and cultural complexities in low-resource hate speech detection."}],"geoLocations":[],"fundingReferences":[],"url":"https://arxiv.org/abs/2602.19212","contentUrl":null,"metadataVersion":0,"schemaVersion":"http://datacite.org/schema/kernel-4","source":"mds","isActive":true,"state":"findable","reason":null,"viewCount":0,"downloadCount":0,"referenceCount":0,"citationCount":0,"partCount":0,"partOfCount":0,"versionCount":0,"versionOfCount":0,"created":"2026-02-25T14:51:05Z","registered":"2026-02-25T14:51:05Z","published":null,"updated":"2026-02-25T14:51:05Z"},"relationships":{"client":{"data":{"id":"arxiv.content","type":"clients"}}}},{"id":"10.48550/arxiv.2602.19211","type":"dois","attributes":{"doi":"10.48550/arxiv.2602.19211","identifiers":[{"identifier":"2602.19211","identifierType":"arXiv"}],"creators":[{"nameType":"Personal","givenName":"HongYu","familyName":"Pu","name":"Pu, HongYu","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Siming","familyName":"Liu","name":"Liu, Siming","affiliation":[],"nameIdentifiers":[]}],"titles":[{"title":"The Apparent Asymmetric Outflows of TeV Particles from Pulsar Winds"}],"publisher":"arXiv","container":{},"publicationYear":2026,"subjects":[{"subject":"High Energy Astrophysical Phenomena (astro-ph.HE)","lang":"en","subjectScheme":"arXiv"},{"subject":"FOS: Physical sciences","subjectScheme":"Fields of Science and Technology (FOS)"},{"schemeUri":"http://www.oecd.org/science/inno/38235147.pdf","subject":"FOS: Physical sciences","subjectScheme":"Fields of Science and Technology (FOS)"}],"contributors":[],"dates":[{"date":"2026-02-22T14:44:42Z","dateType":"Submitted","dateInformation":"v1"},{"date":"2026-02-24T01:52:04Z","dateType":"Updated","dateInformation":"v1"},{"date":"2026-02","dateType":"Available","dateInformation":"v1"},{"date":"2026","dateType":"Issued"}],"language":null,"types":{"schemaOrg":"CreativeWork","resourceTypeGeneral":"Preprint","citeproc":"article","bibtex":"misc","ris":"GEN","resourceType":"Article"},"relatedIdentifiers":[],"relatedItems":[],"sizes":[],"formats":[],"version":"1","rightsList":[{"rightsIdentifierScheme":"SPDX","rightsUri":"https://creativecommons.org/licenses/by/4.0/legalcode","schemeUri":"https://spdx.org/licenses/","rights":"Creative Commons Attribution 4.0 International","rightsIdentifier":"cc-by-4.0"}],"descriptions":[{"descriptionType":"Abstract","description":"Observations of X-ray filaments attached to a couple of powerful pulsars suggest escape of TeV electrons and/or positrons (e$^{\\pm}$) from pulsar bow shocks into surrounding large scale magnetic fields. These filaments are usually asymmetric with very weak emission from the other side of the main filaments, and no significant spectral variation has been detected across these filaments, implying inefficient energy loss of emitting particles. We develop a Monte Carlo code to simulate particle transport in a large scale magnetic field and apply the model to PSR B2224+4415 (Guitar). It is shown that, with an injection power of a few tens of percent of the pulsar spin down luminosity, TeV e$^{\\pm}$ can explain the observed filament properties with a scattering mean free path along the magnetic field comparable to the length of the observed filament. The model predicts a dim diffuse symmetric X-ray background aligned with the filament on a larger scale, whose flux is proportional to the X-ray emitting e$^{\\pm}$ energy loss time for a stable e$^{\\pm}$ injection power comparable to the luminosity of this diffuse background. Observations with a large field of view and good sensitivity should be able to detect such a component."}],"geoLocations":[],"fundingReferences":[],"url":"https://arxiv.org/abs/2602.19211","contentUrl":null,"metadataVersion":0,"schemaVersion":"http://datacite.org/schema/kernel-4","source":"mds","isActive":true,"state":"findable","reason":null,"viewCount":0,"downloadCount":0,"referenceCount":0,"citationCount":0,"partCount":0,"partOfCount":0,"versionCount":0,"versionOfCount":0,"created":"2026-02-25T14:51:02Z","registered":"2026-02-25T14:51:03Z","published":null,"updated":"2026-02-25T14:51:03Z"},"relationships":{"client":{"data":{"id":"arxiv.content","type":"clients"}}}},{"id":"10.48550/arxiv.2602.19207","type":"dois","attributes":{"doi":"10.48550/arxiv.2602.19207","identifiers":[{"identifier":"2602.19207","identifierType":"arXiv"}],"creators":[{"nameType":"Personal","givenName":"Afsana","familyName":"Khan","name":"Khan, Afsana","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Marijn ten","familyName":"Thij","name":"Thij, Marijn ten","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Guangzhi","familyName":"Tang","name":"Tang, Guangzhi","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Anna","familyName":"Wilbik","name":"Wilbik, Anna","affiliation":[],"nameIdentifiers":[]}],"titles":[{"title":"HybridFL: A Federated Learning Approach for Financial Crime Detection"}],"publisher":"arXiv","container":{},"publicationYear":2026,"subjects":[{"subject":"Machine Learning (cs.LG)","lang":"en","subjectScheme":"arXiv"},{"subject":"Artificial Intelligence (cs.AI)","lang":"en","subjectScheme":"arXiv"},{"subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"},{"schemeUri":"http://www.oecd.org/science/inno/38235147.pdf","subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"}],"contributors":[],"dates":[{"date":"2026-02-22T14:36:24Z","dateType":"Submitted","dateInformation":"v1"},{"date":"2026-02-24T01:51:59Z","dateType":"Updated","dateInformation":"v1"},{"date":"2026-02","dateType":"Available","dateInformation":"v1"},{"date":"2026","dateType":"Issued"}],"language":null,"types":{"schemaOrg":"CreativeWork","resourceTypeGeneral":"Preprint","citeproc":"article","bibtex":"misc","ris":"GEN","resourceType":"Article"},"relatedIdentifiers":[],"relatedItems":[],"sizes":[],"formats":[],"version":"1","rightsList":[{"rightsIdentifierScheme":"SPDX","rightsUri":"https://creativecommons.org/licenses/by/4.0/legalcode","schemeUri":"https://spdx.org/licenses/","rights":"Creative Commons Attribution 4.0 International","rightsIdentifier":"cc-by-4.0"}],"descriptions":[{"descriptionType":"Abstract","description":"Federated learning (FL) is a privacy-preserving machine learning paradigm that enables multiple parties to collaboratively train models on privately owned data without sharing raw information. While standard FL typically addresses either horizontal or vertical data partitions, many real-world scenarios exhibit a complex hybrid distribution. This paper proposes Hybrid Federated Learning (HybridFL) to address data split both horizontally across disjoint users and vertically across complementary feature sets. We evaluate HybridFL in a financial crime detection context, where a transaction party holds transaction-level attributes and multiple banks maintain private account-level features. By integrating horizontal aggregation and vertical feature fusion, the proposed architecture enables joint learning while strictly preserving data locality. Experiments on AMLSim and SWIFT datasets demonstrate that HybridFL significantly outperforms the transaction-only local model and achieves performance comparable to a centralized benchmark."}],"geoLocations":[],"fundingReferences":[],"url":"https://arxiv.org/abs/2602.19207","contentUrl":null,"metadataVersion":0,"schemaVersion":"http://datacite.org/schema/kernel-4","source":"mds","isActive":true,"state":"findable","reason":null,"viewCount":0,"downloadCount":0,"referenceCount":0,"citationCount":0,"partCount":0,"partOfCount":0,"versionCount":0,"versionOfCount":0,"created":"2026-02-25T14:50:52Z","registered":"2026-02-25T14:50:53Z","published":null,"updated":"2026-02-25T14:50:53Z"},"relationships":{"client":{"data":{"id":"arxiv.content","type":"clients"}}}},{"id":"10.48550/arxiv.2602.19205","type":"dois","attributes":{"doi":"10.48550/arxiv.2602.19205","identifiers":[{"identifier":"2602.19205","identifierType":"arXiv"}],"creators":[{"nameType":"Personal","givenName":"Subhadip","familyName":"Biswas","name":"Biswas, Subhadip","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Buddhapriya","familyName":"Chakrabarti","name":"Chakrabarti, Buddhapriya","affiliation":[],"nameIdentifiers":[]}],"titles":[{"title":"Microgel Translocation Through Narrow Capillaries"}],"publisher":"arXiv","container":{},"publicationYear":2026,"subjects":[{"subject":"Soft Condensed Matter (cond-mat.soft)","lang":"en","subjectScheme":"arXiv"},{"subject":"FOS: Physical sciences","subjectScheme":"Fields of Science and Technology (FOS)"},{"schemeUri":"http://www.oecd.org/science/inno/38235147.pdf","subject":"FOS: Physical sciences","subjectScheme":"Fields of Science and Technology (FOS)"}],"contributors":[],"dates":[{"date":"2026-02-22T14:20:00Z","dateType":"Submitted","dateInformation":"v1"},{"date":"2026-02-24T01:51:53Z","dateType":"Updated","dateInformation":"v1"},{"date":"2026-02","dateType":"Available","dateInformation":"v1"},{"date":"2026","dateType":"Issued"}],"language":null,"types":{"schemaOrg":"CreativeWork","resourceTypeGeneral":"Preprint","citeproc":"article","bibtex":"misc","ris":"GEN","resourceType":"Article"},"relatedIdentifiers":[],"relatedItems":[],"sizes":[],"formats":[],"version":"1","rightsList":[{"rightsIdentifierScheme":"SPDX","rightsUri":"https://creativecommons.org/licenses/by-nc-nd/4.0/legalcode","schemeUri":"https://spdx.org/licenses/","rights":"Creative Commons Attribution Non Commercial No Derivatives 4.0 International","rightsIdentifier":"cc-by-nc-nd-4.0"}],"descriptions":[{"descriptionType":"Abstract","description":"The transport of soft viscoelastic gels through confined geometries underlies critical processes in biomedical, biological, and industrial systems. Here, we examine the translocation of a spherical microgel through a narrow capillary whose diameter is smaller than the equilibrium gel size. Using coarse-grained molecular dynamics simulations in tandem with mean-field theory and mechanical analysis, we uncover a critical threshold diameter $d_c$ below which the microgel cannot enter, regardless of the applied pressure. This geometric limit emerges from the interplay between gel elasticity and its internal network connectivity, captured quantitatively by a graph-theoretic model. We construct a phase diagram in the parameter space of tube diameter $d$, applied force $f_g$, and gel stiffness $Y$ (Young's modulus), which delineates the regimes of successful translocation and mechanical arrest. Under negligible wall friction, gel mobility scales with the applied force; however, beyond a cutoff set by the network topology, progressive densification in the constriction stalls the microgel. Our results reveal the mechanical and topological determinants of soft-gel transport in confinement and provide predictive guidelines for engineering gel-based systems in microfluidics, drug delivery, and tissue-level filtration."},{"descriptionType":"Other","description":"13 pages, 13 figures (SI not added - please request by email)"}],"geoLocations":[],"fundingReferences":[],"url":"https://arxiv.org/abs/2602.19205","contentUrl":null,"metadataVersion":0,"schemaVersion":"http://datacite.org/schema/kernel-4","source":"mds","isActive":true,"state":"findable","reason":null,"viewCount":0,"downloadCount":0,"referenceCount":0,"citationCount":0,"partCount":0,"partOfCount":0,"versionCount":0,"versionOfCount":0,"created":"2026-02-25T14:50:47Z","registered":"2026-02-25T14:50:48Z","published":null,"updated":"2026-02-25T14:50:48Z"},"relationships":{"client":{"data":{"id":"arxiv.content","type":"clients"}}}},{"id":"10.48550/arxiv.2602.19204","type":"dois","attributes":{"doi":"10.48550/arxiv.2602.19204","identifiers":[{"identifier":"2602.19204","identifierType":"arXiv"}],"creators":[{"nameType":"Personal","givenName":"Hyeong-Ohk","familyName":"Bae","name":"Bae, Hyeong-Ohk","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Seung-Yeal","familyName":"Ha","name":"Ha, Seung-Yeal","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Chanho","familyName":"Min","name":"Min, Chanho","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Jane","familyName":"Yoo","name":"Yoo, Jane","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Jaeyoung","familyName":"Yoon","name":"Yoon, Jaeyoung","affiliation":[],"nameIdentifiers":[]}],"titles":[{"title":"CBO algorithm with average drift and applications to portfolio optimization"}],"publisher":"arXiv","container":{},"publicationYear":2026,"subjects":[{"subject":"Optimization and Control (math.OC)","lang":"en","subjectScheme":"arXiv"},{"subject":"Dynamical Systems (math.DS)","lang":"en","subjectScheme":"arXiv"},{"subject":"FOS: Mathematics","subjectScheme":"Fields of Science and Technology (FOS)"},{"schemeUri":"http://www.oecd.org/science/inno/38235147.pdf","subject":"FOS: Mathematics","subjectScheme":"Fields of Science and Technology (FOS)"}],"contributors":[],"dates":[{"date":"2026-02-22T14:13:21Z","dateType":"Submitted","dateInformation":"v1"},{"date":"2026-02-24T01:51:41Z","dateType":"Updated","dateInformation":"v1"},{"date":"2026-02","dateType":"Available","dateInformation":"v1"},{"date":"2026","dateType":"Issued"}],"language":null,"types":{"schemaOrg":"CreativeWork","resourceTypeGeneral":"Preprint","citeproc":"article","bibtex":"misc","ris":"GEN","resourceType":"Article"},"relatedIdentifiers":[],"relatedItems":[],"sizes":[],"formats":[],"version":"1","rightsList":[{"rightsUri":"http://arxiv.org/licenses/nonexclusive-distrib/1.0/","rights":"arXiv.org perpetual, non-exclusive license"}],"descriptions":[{"descriptionType":"Abstract","description":"We propose a consensus based optimization algorithm with average drift (in short Ad-CBO) and provide a theoretical framework for it. In the theoretical analysis, we show that particle solutions to Ad-CBO converge to a global minimizer. In numerical simulations, we examine Ad-CBO's performance in optimizing static and dynamic objective functions. As a real-time application, we test the efficiency of Ad-CBO to find the optimal portfolio given stochastically evolving multi-asset prices in a financial market. The proposed Ad-CBO exhibits higher searching speed, lower tracking errors and regret bound than the CBO without stochastic diffusion"}],"geoLocations":[],"fundingReferences":[],"url":"https://arxiv.org/abs/2602.19204","contentUrl":null,"metadataVersion":0,"schemaVersion":"http://datacite.org/schema/kernel-4","source":"mds","isActive":true,"state":"findable","reason":null,"viewCount":0,"downloadCount":0,"referenceCount":0,"citationCount":0,"partCount":0,"partOfCount":0,"versionCount":0,"versionOfCount":0,"created":"2026-02-25T14:50:45Z","registered":"2026-02-25T14:50:46Z","published":null,"updated":"2026-02-25T14:50:46Z"},"relationships":{"client":{"data":{"id":"arxiv.content","type":"clients"}}}},{"id":"10.48550/arxiv.2602.19200","type":"dois","attributes":{"doi":"10.48550/arxiv.2602.19200","identifiers":[{"identifier":"2602.19200","identifierType":"arXiv"}],"creators":[{"nameType":"Personal","givenName":"Stefano","familyName":"Silvestri","name":"Silvestri, Stefano","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Dmitry","familyName":"Prokhorov","name":"Prokhorov, Dmitry","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Jacco","familyName":"Vink","name":"Vink, Jacco","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Patrick","familyName":"Slane","name":"Slane, Patrick","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Yi-Jung","familyName":"Yang","name":"Yang, Yi-Jung","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Niccolo","familyName":"Bucciantini","name":"Bucciantini, Niccolo","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Riccardo","familyName":"Ferrazzoli","name":"Ferrazzoli, Riccardo","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Ping","familyName":"Zhou","name":"Zhou, Ping","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Enrico","familyName":"Costa","name":"Costa, Enrico","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Nicola","familyName":"Omodei","name":"Omodei, Nicola","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Chi-Yung","familyName":"Ng","name":"Ng, Chi-Yung","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Paolo","familyName":"Soffitta","name":"Soffitta, Paolo","affiliation":[],"nameIdentifiers":[]},{"nameT