a","name":"Privitera, Daniel","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Sören","familyName":"Mindermann","name":"Mindermann, Sören","affiliation":[],"nameIdentifiers":[]}],"titles":[{"title":"International AI Safety Report 2026"}],"publisher":"arXiv","container":{},"publicationYear":2026,"subjects":[{"subject":"Computers and Society (cs.CY)","lang":"en","subjectScheme":"arXiv"},{"subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"},{"schemeUri":"http://www.oecd.org/science/inno/38235147.pdf","subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"}],"contributors":[],"dates":[{"date":"2026-02-24T15:30:29Z","dateType":"Submitted","dateInformation":"v1"},{"date":"2026-02-25T01:55:42Z","dateType":"Updated","dateInformation":"v1"},{"date":"2026-02","dateType":"Available","dateInformation":"v1"},{"date":"2026","dateType":"Issued"}],"language":null,"types":{"schemaOrg":"CreativeWork","resourceTypeGeneral":"Preprint","citeproc":"article","bibtex":"misc","ris":"GEN","resourceType":"Article"},"relatedIdentifiers":[],"relatedItems":[],"sizes":[],"formats":[],"version":"1","rightsList":[{"rightsIdentifierScheme":"SPDX","rightsUri":"https://creativecommons.org/licenses/by/4.0/legalcode","schemeUri":"https://spdx.org/licenses/","rights":"Creative Commons Attribution 4.0 International","rightsIdentifier":"cc-by-4.0"}],"descriptions":[{"descriptionType":"Abstract","description":"The International AI Safety Report 2026 synthesises the current scientific evidence on the capabilities, emerging risks, and safety of general-purpose AI systems. The report series was mandated by the nations attending the AI Safety Summit in Bletchley, UK. 29 nations, the UN, the OECD, and the EU each nominated a representative to the report's Expert Advisory Panel. Over 100 AI experts contributed, representing diverse perspectives and disciplines. Led by the Report's Chair, these independent experts collectively had full discretion over the report's content."}],"geoLocations":[],"fundingReferences":[],"url":"https://arxiv.org/abs/2602.21012","contentUrl":null,"metadataVersion":0,"schemaVersion":"http://datacite.org/schema/kernel-4","source":"mds","isActive":true,"state":"findable","reason":null,"viewCount":0,"downloadCount":0,"referenceCount":0,"citationCount":0,"partCount":0,"partOfCount":0,"versionCount":0,"versionOfCount":0,"created":"2026-02-25T15:35:09Z","registered":"2026-02-25T15:35:10Z","published":null,"updated":"2026-02-25T15:35:10Z"},"relationships":{"client":{"data":{"id":"arxiv.content","type":"clients"}}}},{"id":"10.48550/arxiv.2602.21010","type":"dois","attributes":{"doi":"10.48550/arxiv.2602.21010","identifiers":[{"identifier":"2602.21010","identifierType":"arXiv"}],"creators":[{"nameType":"Personal","givenName":"Jiannan","familyName":"Huang","name":"Huang, Jiannan","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Aditya","familyName":"Kane","name":"Kane, Aditya","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Fengzhe","familyName":"Zhou","name":"Zhou, Fengzhe","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Yunchao","familyName":"Wei","name":"Wei, Yunchao","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Humphrey","familyName":"Shi","name":"Shi, Humphrey","affiliation":[],"nameIdentifiers":[]}],"titles":[{"title":"Le-DETR: Revisiting Real-Time Detection Transformer with Efficient Encoder Design"}],"publisher":"arXiv","container":{},"publicationYear":2026,"subjects":[{"subject":"Computer Vision and Pattern Recognition (cs.CV)","lang":"en","subjectScheme":"arXiv"},{"subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"},{"schemeUri":"http://www.oecd.org/science/inno/38235147.pdf","subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"}],"contributors":[],"dates":[{"date":"2026-02-24T15:29:55Z","dateType":"Submitted","dateInformation":"v1"},{"date":"2026-02-25T01:55:40Z","dateType":"Updated","dateInformation":"v1"},{"date":"2026-02","dateType":"Available","dateInformation":"v1"},{"date":"2026","dateType":"Issued"}],"language":null,"types":{"schemaOrg":"CreativeWork","resourceTypeGeneral":"Preprint","citeproc":"article","bibtex":"misc","ris":"GEN","resourceType":"Article"},"relatedIdentifiers":[],"relatedItems":[],"sizes":[],"formats":[],"version":"1","rightsList":[{"rightsIdentifierScheme":"SPDX","rightsUri":"https://creativecommons.org/licenses/by/4.0/legalcode","schemeUri":"https://spdx.org/licenses/","rights":"Creative Commons Attribution 4.0 International","rightsIdentifier":"cc-by-4.0"}],"descriptions":[{"descriptionType":"Abstract","description":"Real-time object detection is crucial for real-world applications as it requires high accuracy with low latency. While Detection Transformers (DETR) have demonstrated significant performance improvements, current real-time DETR models are challenging to reproduce from scratch due to excessive pre-training overheads on the backbone, constraining research advancements by hindering the exploration of novel backbone architectures. In this paper, we want to show that by using general good design, it is possible to have \\textbf{high performance} with \\textbf{low pre-training cost}. After a thorough study of the backbone architecture, we propose EfficientNAT at various scales, which incorporates modern efficient convolution and local attention mechanisms. Moreover, we re-design the hybrid encoder with local attention, significantly enhancing both performance and inference speed. Based on these advancements, we present Le-DETR (\\textbf{L}ow-cost and \\textbf{E}fficient \\textbf{DE}tection \\textbf{TR}ansformer), which achieves a new \\textbf{SOTA} in real-time detection using only ImageNet1K and COCO2017 training datasets, saving about 80\\% images in pre-training stage compared with previous methods. We demonstrate that with well-designed, real-time DETR models can achieve strong performance without the need for complex and computationally expensive pretraining. Extensive experiments show that Le-DETR-M/L/X achieves \\textbf{52.9/54.3/55.1 mAP} on COCO Val2017 with \\textbf{4.45/5.01/6.68 ms} on an RTX4090. It surpasses YOLOv12-L/X by \\textbf{+0.6/-0.1 mAP} while achieving similar speed and \\textbf{+20\\%} speedup. Compared with DEIM-D-FINE, Le-DETR-M achieves \\textbf{+0.2 mAP} with slightly faster inference, and surpasses DEIM-D-FINE-L by \\textbf{+0.4 mAP} with only \\textbf{0.4 ms} additional latency. Code and weights will be open-sourced."},{"descriptionType":"Other","description":"CVPR Findings"}],"geoLocations":[],"fundingReferences":[],"url":"https://arxiv.org/abs/2602.21010","contentUrl":null,"metadataVersion":0,"schemaVersion":"http://datacite.org/schema/kernel-4","source":"mds","isActive":true,"state":"findable","reason":null,"viewCount":0,"downloadCount":0,"referenceCount":0,"citationCount":0,"partCount":0,"partOfCount":0,"versionCount":0,"versionOfCount":0,"created":"2026-02-25T15:35:04Z","registered":"2026-02-25T15:35:05Z","published":null,"updated":"2026-02-25T15:35:05Z"},"relationships":{"client":{"data":{"id":"arxiv.content","type":"clients"}}}},{"id":"10.48550/arxiv.2602.21007","type":"dois","attributes":{"doi":"10.48550/arxiv.2602.21007","identifiers":[{"identifier":"2602.21007","identifierType":"arXiv"}],"creators":[{"nameType":"Personal","givenName":"Masaki","familyName":"Nagai","name":"Nagai, Masaki","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Hideaki","familyName":"Kawaguchi","name":"Kawaguchi, Hideaki","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Shin","familyName":"Nishio","name":"Nishio, Shin","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Takahiko","familyName":"Satoh","name":"Satoh, Takahiko","affiliation":[],"nameIdentifiers":[]}],"titles":[{"title":"Telemetry-Based Server Selection in the Quantum Internet via Cross-Layer Runtime Estimation"}],"publisher":"arXiv","container":{},"publicationYear":2026,"subjects":[{"subject":"Quantum Physics (quant-ph)","lang":"en","subjectScheme":"arXiv"},{"subject":"Networking and Internet Architecture (cs.NI)","lang":"en","subjectScheme":"arXiv"},{"subject":"FOS: Physical sciences","subjectScheme":"Fields of Science and Technology (FOS)"},{"schemeUri":"http://www.oecd.org/science/inno/38235147.pdf","subject":"FOS: Physical sciences","subjectScheme":"Fields of Science and Technology (FOS)"},{"subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"},{"schemeUri":"http://www.oecd.org/science/inno/38235147.pdf","subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"}],"contributors":[],"dates":[{"date":"2026-02-24T15:25:55Z","dateType":"Submitted","dateInformation":"v1"},{"date":"2026-02-25T01:55:25Z","dateType":"Updated","dateInformation":"v1"},{"date":"2026-02","dateType":"Available","dateInformation":"v1"},{"date":"2026","dateType":"Issued"}],"language":null,"types":{"schemaOrg":"CreativeWork","resourceTypeGeneral":"Preprint","citeproc":"article","bibtex":"misc","ris":"GEN","resourceType":"Article"},"relatedIdentifiers":[],"relatedItems":[],"sizes":[],"formats":[],"version":"1","rightsList":[{"rightsUri":"http://arxiv.org/licenses/nonexclusive-distrib/1.0/","rights":"arXiv.org perpetual, non-exclusive license"}],"descriptions":[{"descriptionType":"Abstract","description":"The Quantum Internet will allow clients to delegate quantum workloads to remote servers over heterogeneous networks, but choosing the server that minimizes end-to-end execution time is difficult because server processing, feedforward classical communication, and entanglement distribution can overlap in protocol-dependent ways and shift the runtime bottleneck. We propose $T_{\\max}$, a lightweight runtime score that sums coarse telemetry from multiple layers to obtain a conservative ranking for online server selection without calibrating weights for each deployment. Using NetSquid discrete-event simulations of a modified parameter-blind VQE (PB-VQE) workload, we evaluate $T_{\\max}$ on pools of 10,000 heterogeneous candidates (selecting among up to 100 per decision) across crossover and bottleneck-dominated regimes, including temporal jitter scenarios and jobs with multiple shots. $T_{\\max}$ achieves single-digit mean regret normalized by the oracle (below 10%) in both regimes and remains in the single-digit range under classical communication latency jitter for multi-shot jobs, while performance degrades for single-shot jobs under severe jitter. To connect performance to deployment planning, we derive an operating map based on requirements relating distance and entanglement rate requirements to protocol level counts, quantify how simple multiuser contention shifts the crossover, and use Sobol global sensitivity analysis to identify regime-dependent bottlenecks. These findings suggest that simple cross-layer telemetry can enable practical server selection while providing actionable provisioning guidance for emerging Quantum Internet services."},{"descriptionType":"Other","description":"13 pages, 10 figures"}],"geoLocations":[],"fundingReferences":[],"url":"https://arxiv.org/abs/2602.21007","contentUrl":null,"metadataVersion":0,"schemaVersion":"http://datacite.org/schema/kernel-4","source":"mds","isActive":true,"state":"findable","reason":null,"viewCount":0,"downloadCount":0,"referenceCount":0,"citationCount":0,"partCount":0,"partOfCount":0,"versionCount":0,"versionOfCount":0,"created":"2026-02-25T15:34:56Z","registered":"2026-02-25T15:34:57Z","published":null,"updated":"2026-02-25T15:34:57Z"},"relationships":{"client":{"data":{"id":"arxiv.content","type":"clients"}}}},{"id":"10.48550/arxiv.2602.21006","type":"dois","attributes":{"doi":"10.48550/arxiv.2602.21006","identifiers":[{"identifier":"2602.21006","identifierType":"arXiv"}],"creators":[{"nameType":"Personal","givenName":"Sofia","familyName":"Sartore","name":"Sartore, Sofia","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Daniel","familyName":"Nagel","name":"Nagel, Daniel","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Georg","familyName":"Diez","name":"Diez, Georg","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Gerhard","familyName":"Stock","name":"Stock, Gerhard","affiliation":[],"nameIdentifiers":[]}],"titles":[{"title":"Lost in Projection? Gaussian Filtering Recovers Hidden Conformational States"}],"publisher":"arXiv","container":{},"publicationYear":2026,"subjects":[{"subject":"Soft Condensed Matter (cond-mat.soft)","lang":"en","subjectScheme":"arXiv"},{"subject":"Biological Physics (physics.bio-ph)","lang":"en","subjectScheme":"arXiv"},{"subject":"Computational Physics (physics.comp-ph)","lang":"en","subjectScheme":"arXiv"},{"subject":"Data Analysis, Statistics and Probability (physics.data-an)","lang":"en","subjectScheme":"arXiv"},{"subject":"FOS: Physical sciences","subjectScheme":"Fields of Science and Technology (FOS)"},{"schemeUri":"http://www.oecd.org/science/inno/38235147.pdf","subject":"FOS: Physical sciences","subjectScheme":"Fields of Science and Technology (FOS)"}],"contributors":[],"dates":[{"date":"2026-02-24T15:25:38Z","dateType":"Submitted","dateInformation":"v1"},{"date":"2026-02-25T01:55:25Z","dateType":"Updated","dateInformation":"v1"},{"date":"2026-02","dateType":"Available","dateInformation":"v1"},{"date":"2026","dateType":"Issued"}],"language":null,"types":{"schemaOrg":"CreativeWork","resourceTypeGeneral":"Preprint","citeproc":"article","bibtex":"misc","ris":"GEN","resourceType":"Article"},"relatedIdentifiers":[],"relatedItems":[],"sizes":[],"formats":[],"version":"1","rightsList":[{"rightsUri":"http://arxiv.org/licenses/nonexclusive-distrib/1.0/","rights":"arXiv.org perpetual, non-exclusive license"}],"descriptions":[{"descriptionType":"Abstract","description":"To interpret molecular dynamics (MD) simulations, it is common practice to reduce the dimensionality of the molecular coordinates to a low-dimensional collective variable $x$. Projecting the high-dimensional MD data onto $x$ yields a free energy landscape $ΔG(x)$, which highlights low-energy regions corresponding to conformational states. The accurate definition of these states, however, is often impeded by projection artifacts, resulting in artificially shortened state lifetimes or even the complete disappearance of states from the analysis. As demonstrated for a two-dimensional toy model, Gaussian low-pass filtering of the high-dimensional MD coordinates can restore the underlying free energy landscape, allowing to recover previously hidden states. When applied to an all-atom folding trajectory of HP35, the number of microstates increases by an order of magnitude, which leads to metastable states that are long-lived and much better defined structurally, even compared to dynamically cored state trajectories."}],"geoLocations":[],"fundingReferences":[],"url":"https://arxiv.org/abs/2602.21006","contentUrl":null,"metadataVersion":0,"schemaVersion":"http://datacite.org/schema/kernel-4","source":"mds","isActive":true,"state":"findable","reason":null,"viewCount":0,"downloadCount":0,"referenceCount":0,"citationCount":0,"partCount":0,"partOfCount":0,"versionCount":0,"versionOfCount":0,"created":"2026-02-25T15:34:54Z","registered":"2026-02-25T15:34:54Z","published":null,"updated":"2026-02-25T15:34:54Z"},"relationships":{"client":{"data":{"id":"arxiv.content","type":"clients"}}}},{"id":"10.48550/arxiv.2602.21003","type":"dois","attributes":{"doi":"10.48550/arxiv.2602.21003","identifiers":[{"identifier":"2602.21003","identifierType":"arXiv"}],"creators":[{"nameType":"Personal","givenName":"Loris","familyName":"Di Cairano","name":"Di Cairano, Loris","affiliation":[],"nameIdentifiers":[]}],"titles":[{"title":"Criticality Beyond Nonanalyticity: Intrinsic Microcanonical Signatures of Phase Transitions"}],"publisher":"arXiv","container":{},"publicationYear":2026,"subjects":[{"subject":"Statistical Mechanics (cond-mat.stat-mech)","lang":"en","subjectScheme":"arXiv"},{"subject":"FOS: Physical sciences","subjectScheme":"Fields of Science and Technology (FOS)"},{"schemeUri":"http://www.oecd.org/science/inno/38235147.pdf","subject":"FOS: Physical sciences","subjectScheme":"Fields of Science and Technology (FOS)"}],"contributors":[],"dates":[{"date":"2026-02-24T15:23:17Z","dateType":"Submitted","dateInformation":"v1"},{"date":"2026-02-25T01:55:19Z","dateType":"Updated","dateInformation":"v1"},{"date":"2026-02","dateType":"Available","dateInformation":"v1"},{"date":"2026","dateType":"Issued"}],"language":null,"types":{"schemaOrg":"CreativeWork","resourceTypeGeneral":"Preprint","citeproc":"article","bibtex":"misc","ris":"GEN","resourceType":"Article"},"relatedIdentifiers":[],"relatedItems":[],"sizes":[],"formats":[],"version":"1","rightsList":[{"rightsIdentifierScheme":"SPDX","rightsUri":"https://creativecommons.org/licenses/by/4.0/legalcode","schemeUri":"https://spdx.org/licenses/","rights":"Creative Commons Attribution 4.0 International","rightsIdentifier":"cc-by-4.0"}],"descriptions":[{"descriptionType":"Abstract","description":"Phase transitions are conventionally defined by nonanalyticities of thermodynamic potentials in the thermodynamic limit. In this Letter, we show that the singularity is not the definition of criticality but its asymptotic outcome: criticality is already written in the microcanonical entropy derivatives at any finite size as intrinsic morphological structures -- inflection points and extrema. The singularity is then the endpoint of a sharpening process that evolves with increasing system size. Combining microcanonical inflection-point analysis (MIPA) with the Berlin-Kac spherical model -- for which the microcanonical density of states is known in closed form at every finite $N$ -- we systematically identify these structures in the energy profiles of entropy derivatives that encode the transition. An inflection point in the inverse temperature $β_N(ε)=\\partial_εS_N$ and a pronounced peak in its derivative $γ_N(ε)=\\partial^2_εS_N$ define a well-controlled pseudocritical trajectory whose controlled sharpening and drift culminate in the macroscopic cusp at the critical energy $ε_c$ in the thermodynamic limit. This establishes an intrinsic, order-parameter-free notion of criticality that precedes its singular asymptotic representation."}],"geoLocations":[],"fundingReferences":[],"url":"https://arxiv.org/abs/2602.21003","contentUrl":null,"metadataVersion":0,"schemaVersion":"http://datacite.org/schema/kernel-4","source":"mds","isActive":true,"state":"findable","reason":null,"viewCount":0,"downloadCount":0,"referenceCount":0,"citationCount":0,"partCount":0,"partOfCount":0,"versionCount":0,"versionOfCount":0,"created":"2026-02-25T15:34:46Z","registered":"2026-02-25T15:34:47Z","published":null,"updated":"2026-02-25T15:34:47Z"},"relationships":{"client":{"data":{"id":"arxiv.content","type":"clients"}}}},{"id":"10.48550/arxiv.2602.21000","type":"dois","attributes":{"doi":"10.48550/arxiv.2602.21000","identifiers":[{"identifier":"2602.21000","identifierType":"arXiv"}],"creators":[{"nameType":"Personal","givenName":"Rumana","familyName":"Lakdawala","name":"Lakdawala, Rumana","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Roger","familyName":"Leenders","name":"Leenders, Roger","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Peter","familyName":"Ejbye-Ernst","name":"Ejbye-Ernst, Peter","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Joris","familyName":"Mulder","name":"Mulder, Joris","affiliation":[],"nameIdentifiers":[]}],"titles":[{"title":"Modelling Interaction Duration in Relational Event Models"}],"publisher":"arXiv","container":{},"publicationYear":2026,"subjects":[{"subject":"Social and Information Networks (cs.SI)","lang":"en","subjectScheme":"arXiv"},{"subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"},{"schemeUri":"http://www.oecd.org/science/inno/38235147.pdf","subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"}],"contributors":[],"dates":[{"date":"2026-02-24T15:20:34Z","dateType":"Submitted","dateInformation":"v1"},{"date":"2026-02-25T01:55:05Z","dateType":"Updated","dateInformation":"v1"},{"date":"2026-02","dateType":"Available","dateInformation":"v1"},{"date":"2026","dateType":"Issued"}],"language":null,"types":{"schemaOrg":"CreativeWork","resourceTypeGeneral":"Preprint","citeproc":"article","bibtex":"misc","ris":"GEN","resourceType":"Article"},"relatedIdentifiers":[],"relatedItems":[],"sizes":[],"formats":[],"version":"1","rightsList":[{"rightsIdentifierScheme":"SPDX","rightsUri":"https://creativecommons.org/licenses/by/4.0/legalcode","schemeUri":"https://spdx.org/licenses/","rights":"Creative Commons Attribution 4.0 International","rightsIdentifier":"cc-by-4.0"}],"descriptions":[{"descriptionType":"Abstract","description":"The study of relational events, which are interactions occurring between actors over time, has gained significant traction recently. Traditional relational event models typically focus on modelling the occurrence and sequence of events without considering their duration even though duration information is frequently available in empirical relational event data. We introduce a novel Duration Relational Event Model (DuREM) that incorporates the temporal duration of events into the analysis. The proposed model extends the existing framework by (i) allowing the inclusion of past event durations in the endogenous statistics to account for how the duration of past events affects the rate of future interactions, and (ii) extending the traditional relational event model by also modelling when events will end based on past event history and covariates. This is achieved by extending the risk set to include both ongoing events at risk of ending and idle dyads at risk of starting new events. The methodology is implemented in a new R package `durem'. Two case studies concerning team dynamics and inter-personal violence are presented to illustrate the applicability of the model."},{"descriptionType":"Other","description":"This paper is adapted from the dissertation of Rumana Lakdawala https://doi.org/10.26116/tsb.32104538"}],"geoLocations":[],"fundingReferences":[],"url":"https://arxiv.org/abs/2602.21000","contentUrl":null,"metadataVersion":0,"schemaVersion":"http://datacite.org/schema/kernel-4","source":"mds","isActive":true,"state":"findable","reason":null,"viewCount":0,"downloadCount":0,"referenceCount":0,"citationCount":0,"partCount":0,"partOfCount":0,"versionCount":0,"versionOfCount":0,"created":"2026-02-25T15:34:39Z","registered":"2026-02-25T15:34:40Z","published":null,"updated":"2026-02-25T15:34:40Z"},"relationships":{"client":{"data":{"id":"arxiv.content","type":"clients"}}}},{"id":"10.48550/arxiv.2602.20998","type":"dois","attributes":{"doi":"10.48550/arxiv.2602.20998","identifiers":[{"identifier":"2602.20998","identifierType":"arXiv"}],"creators":[{"nameType":"Personal","givenName":"Zezhi","familyName":"Wang","name":"Wang, Zezhi","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Dong","familyName":"Xing","name":"Xing, Dong","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Bingbing","familyName":"Tong","name":"Tong, Bingbing","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Senyang","familyName":"Pan","name":"Pan, Senyang","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Guangtong","familyName":"Liu","name":"Liu, Guangtong","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Li","familyName":"Lu","name":"Lu, Li","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Jinglei","familyName":"Zhang","name":"Zhang, Jinglei","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Cheng-Long","familyName":"Zhang","name":"Zhang, Cheng-Long","affiliation":[],"nameIdentifiers":[]}],"titles":[{"title":"Observation of sequential quantum oscillations induced by mini-Landau bands in a three-dimensional Dirac semiconductor"}],"publisher":"arXiv","container":{},"publicationYear":2026,"subjects":[{"subject":"Mesoscale and Nanoscale Physics (cond-mat.mes-hall)","lang":"en","subjectScheme":"arXiv"},{"subject":"Materials Science (cond-mat.mtrl-sci)","lang":"en","subjectScheme":"arXiv"},{"subject":"FOS: Physical sciences","subjectScheme":"Fields of Science and Technology (FOS)"},{"schemeUri":"http://www.oecd.org/science/inno/38235147.pdf","subject":"FOS: Physical sciences","subjectScheme":"Fields of Science and Technology (FOS)"}],"contributors":[],"dates":[{"date":"2026-02-24T15:18:16Z","dateType":"Submitted","dateInformation":"v1"},{"date":"2026-02-25T01:54:55Z","dateType":"Updated","dateInformation":"v1"},{"date":"2026-02","dateType":"Available","dateInformation":"v1"},{"date":"2026","dateType":"Issued"}],"language":null,"types":{"schemaOrg":"CreativeWork","resourceTypeGeneral":"Preprint","citeproc":"article","bibtex":"misc","ris":"GEN","resourceType":"Article"},"relatedIdentifiers":[],"relatedItems":[],"sizes":[],"formats":[],"version":"1","rightsList":[{"rightsIdentifierScheme":"SPDX","rightsUri":"https://creativecommons.org/licenses/by-nc-nd/4.0/legalcode","schemeUri":"https://spdx.org/licenses/","rights":"Creative Commons Attribution Non Commercial No Derivatives 4.0 International","rightsIdentifier":"cc-by-nc-nd-4.0"}],"descriptions":[{"descriptionType":"Abstract","description":"Quantum oscillations, the oscillatory behavior of electrical and thermodynamic properties, are typically observed in metals and vanish in the quantum limit under strong magnetic fields1. Phenomena such as the fractional quantum Hall effect2, the Hofstadter butterfly3,4, and recent observations of quantum oscillations in exotic insulators are notable exceptions5-12. The narrow-gap Dirac semiconductor ZrTe5, a less exotic material without strong correlations or artificially engineered superlattices, nevertheless exhibits resistance oscillations in the quantum limit13 but can be interpreted within a simple Zeeman-effect-based picture14,15, which remains conventional quantum oscillations without exotic properties. Here, we report the observation of unexpected mini-oscillations superimposed on Zeeman-effect-induced main oscillations in the quantum limit. The subtracted mini-oscillations are periodic in 1/B with the highest frequency equal to 2.1% of the first Brillouin zone and have extremely heavy effective mass ~ 2me, which is unexpected in ZrTe5 given its ultralow carrier density. Additionally, the mini-oscillations exhibit sequential features that are synchronized with the main oscillations, suggesting an internal structure of the Landau bands. However, they appear incompatible with the Hofstadter butterfly due to the highly anisotropic/three-dimensional crystal structure. These sequential mini-oscillations correlate with the commensurability resonance effect with subunity fractions observed in angular magnetoresistance, relating to the formation of mini-Landau bands. Our results present solid experimental evidence of exotic quantum oscillations in the quantum limit beyond currently available mechanisms, and establish ZrTe5, a prototypical Dirac semiconductor, as a simple platform parallel to correlated insulators for exploring exotic oscillations."},{"descriptionType":"Other","description":"35 pages, 13 figures"}],"geoLocations":[],"fundingReferences":[],"url":"https://arxiv.org/abs/2602.20998","contentUrl":null,"metadataVersion":0,"schemaVersion":"http://datacite.org/schema/kernel-4","source":"mds","isActive":true,"state":"findable","reason":null,"viewCount":0,"downloadCount":0,"referenceCount":0,"citationCount":0,"partCount":0,"partOfCount":0,"versionCount":0,"versionOfCount":0,"created":"2026-02-25T15:34:34Z","registered":"2026-02-25T15:34:34Z","published":null,"updated":"2026-02-25T15:34:34Z"},"relationships":{"client":{"data":{"id":"arxiv.content","type":"clients"}}}},{"id":"10.48550/arxiv.2602.20996","type":"dois","attributes":{"doi":"10.48550/arxiv.2602.20996","identifiers":[{"identifier":"2602.20996","identifierType":"arXiv"}],"creators":[{"nameType":"Personal","givenName":"Björn","familyName":"Schäfer","name":"Schäfer, Björn","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Mariusz","familyName":"Tobolski","name":"Tobolski, Mariusz","affiliation":[],"nameIdentifiers":[]}],"titles":[{"title":"Voltage quantum graphs and a Gross-Tucker theorem for quantum graphs"}],"publisher":"arXiv","container":{},"publicationYear":2026,"subjects":[{"subject":"Operator Algebras (math.OA)","lang":"en","subjectScheme":"arXiv"},{"subject":"FOS: Mathematics","subjectScheme":"Fields of Science and Technology (FOS)"},{"schemeUri":"http://www.oecd.org/science/inno/38235147.pdf","subject":"FOS: Mathematics","subjectScheme":"Fields of Science and Technology (FOS)"},{"subject":"46L89 (Primary) 46L55, 05C76, 05C60, 05C25 (Secondary)","lang":"en","subjectScheme":"MSC"}],"contributors":[],"dates":[{"date":"2026-02-24T15:15:17Z","dateType":"Submitted","dateInformation":"v1"},{"date":"2026-02-25T01:54:43Z","dateType":"Updated","dateInformation":"v1"},{"date":"2026-02","dateType":"Available","dateInformation":"v1"},{"date":"2026","dateType":"Issued"}],"language":null,"types":{"schemaOrg":"CreativeWork","resourceTypeGeneral":"Preprint","citeproc":"article","bibtex":"misc","ris":"GEN","resourceType":"Article"},"relatedIdentifiers":[],"relatedItems":[],"sizes":[],"formats":[],"version":"1","rightsList":[{"rightsIdentifierScheme":"SPDX","rightsUri":"https://creativecommons.org/licenses/by/4.0/legalcode","schemeUri":"https://spdx.org/licenses/","rights":"Creative Commons Attribution 4.0 International","rightsIdentifier":"cc-by-4.0"}],"descriptions":[{"descriptionType":"Abstract","description":"A voltage graph is a finite directed graph whose edges are labeled by elements of a finite group $G$. A classical construction of Gross and Tucker associates to every voltage graph with vertex set $V$ a so-called derived graph with vertex set $V \\times G$. We generalize their construction to quantum graphs and finite abelian groups. Remarkably, the construction can produce true quantum graphs starting from a classical voltage graph. In this case the obtained quantum graph is quantum isomorphic to a classical graph. As a main result we also prove a quantum version of the Gross-Tucker theorem which characterizes precisely which graphs can be written as derived graphs of voltage graphs."},{"descriptionType":"Other","description":"38 pages, comments welcome!"}],"geoLocations":[],"fundingReferences":[],"url":"https://arxiv.org/abs/2602.20996","contentUrl":null,"metadataVersion":0,"schemaVersion":"http://datacite.org/schema/kernel-4","source":"mds","isActive":true,"state":"findable","reason":null,"viewCount":0,"downloadCount":0,"referenceCount":0,"citationCount":0,"partCount":0,"partOfCount":0,"versionCount":0,"versionOfCount":0,"created":"2026-02-25T15:34:29Z","registered":"2026-02-25T15:34:29Z","published":null,"updated":"2026-02-25T15:34:29Z"},"relationships":{"client":{"data":{"id":"arxiv.content","type":"clients"}}}},{"id":"10.48550/arxiv.2602.20994","type":"dois","attributes":{"doi":"10.48550/arxiv.2602.20994","identifiers":[{"identifier":"2602.20994","identifierType":"arXiv"}],"creators":[{"nameType":"Personal","givenName":"Yubin","familyName":"Ge","name":"Ge, Yubin","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Yongsong","familyName":"Huang","name":"Huang, Yongsong","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Xiaofeng","familyName":"Liu","name":"Liu, Xiaofeng","affiliation":[],"nameIdentifiers":[]}],"titles":[{"title":"Multimodal MRI Report Findings Supervised Brain Lesion Segmentation with Substructures"}],"publisher":"arXiv","container":{},"publicationYear":2026,"subjects":[{"subject":"Image and Video Processing (eess.IV)","lang":"en","subjectScheme":"arXiv"},{"subject":"Artificial Intelligence (cs.AI)","lang":"en","subjectScheme":"arXiv"},{"subject":"Computation and Language (cs.CL)","lang":"en","subjectScheme":"arXiv"},{"subject":"Computer Vision and Pattern Recognition (cs.CV)","lang":"en","subjectScheme":"arXiv"},{"subject":"Machine Learning (cs.LG)","lang":"en","subjectScheme":"arXiv"},{"subject":"FOS: Electrical engineering, electronic engineering, information engineering","subjectScheme":"Fields of Science and Technology (FOS)"},{"schemeUri":"http://www.oecd.org/science/inno/38235147.pdf","subject":"FOS: Electrical engineering, electronic engineering, information engineering","subjectScheme":"Fields of Science and Technology (FOS)"},{"subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"},{"schemeUri":"http://www.oecd.org/science/inno/38235147.pdf","subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"}],"contributors":[],"dates":[{"date":"2026-02-24T15:14:04Z","dateType":"Submitted","dateInformation":"v1"},{"date":"2026-02-25T01:54:40Z","dateType":"Updated","dateInformation":"v1"},{"date":"2026-02","dateType":"Available","dateInformation":"v1"},{"date":"2026","dateType":"Issued"}],"language":null,"types":{"schemaOrg":"CreativeWork","resourceTypeGeneral":"Preprint","citeproc":"article","bibtex":"misc","ris":"GEN","resourceType":"Article"},"relatedIdentifiers":[],"relatedItems":[],"sizes":[],"formats":[],"version":"1","rightsList":[{"rightsIdentifierScheme":"SPDX","rightsUri":"https://creativecommons.org/licenses/by/4.0/legalcode","schemeUri":"https://spdx.org/licenses/","rights":"Creative Commons Attribution 4.0 International","rightsIdentifier":"cc-by-4.0"}],"descriptions":[{"descriptionType":"Abstract","description":"Report-supervised (RSuper) learning seeks to alleviate the need for dense tumor voxel labels with constraints derived from radiology reports (e.g., volumes, counts, sizes, locations). In MRI studies of brain tumors, however, we often involve multi-parametric scans and substructures. Here, fine-grained modality/parameter-wise reports are usually provided along with global findings and are correlated with different substructures. Moreover, the reports often describe only the largest lesion and provide qualitative or uncertain cues (``mild,'' ``possible''). Classical RSuper losses (e.g., sum volume consistency) can over-constrain or hallucinate unreported findings under such incompleteness, and are unable to utilize these hierarchical findings or exploit the priors of varied lesion types in a merged dataset. We explicitly parse the global quantitative and modality-wise qualitative findings and introduce a unified, one-sided, uncertainty-aware formulation (MS-RSuper) that: (i) aligns modality-specific qualitative cues (e.g., T1c enhancement, FLAIR edema) with their corresponding substructures using existence and absence losses; (ii) enforces one-sided lower-bounds for partial quantitative cues (e.g., largest lesion size, minimal multiplicity); and (iii) adds extra- vs. intra-axial anatomical priors to respect cohort differences. Certainty tokens scale penalties; missing cues are down-weighted. On 1238 report-labeled BraTS-MET/MEN scans, our MS-RSuper largely outperforms both a sparsely-supervised baseline and a naive RSuper method."},{"descriptionType":"Other","description":"IEEE International Symposium on Biomedical Imaging (ISBI) 2026"}],"geoLocations":[],"fundingReferences":[],"url":"https://arxiv.org/abs/2602.20994","contentUrl":null,"metadataVersion":0,"schemaVersion":"http://datacite.org/schema/kernel-4","source":"mds","isActive":true,"state":"findable","reason":null,"viewCount":0,"downloadCount":0,"referenceCount":0,"citationCount":0,"partCount":0,"partOfCount":0,"versionCount":0,"versionOfCount":0,"created":"2026-02-25T15:34:23Z","registered":"2026-02-25T15:34:24Z","published":null,"updated":"2026-02-25T15:34:24Z"},"relationships":{"client":{"data":{"id":"arxiv.content","type":"clients"}}}},{"id":"10.48550/arxiv.2602.20993","type":"dois","attributes":{"doi":"10.48550/arxiv.2602.20993","identifiers":[{"identifier":"2602.20993","identifierType":"arXiv"}],"creators":[{"nameType":"Personal","givenName":"Jiajun","familyName":"He","name":"He, Jiajun","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Han","familyName":"Yu","name":"Yu, Han","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Yiran","familyName":"Guo","name":"Guo, Yiran","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Xinping","familyName":"Yi","name":"Yi, Xinping","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Fan","familyName":"Liu","name":"Liu, Fan","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Hing Cheung","familyName":"So","name":"So, Hing Cheung","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Hien Quoc","familyName":"Ngo","name":"Ngo, Hien Quoc","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Michail","familyName":"Matthaiou","name":"Matthaiou, Michail","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Giuseppe","familyName":"Caire","name":"Caire, Giuseppe","affiliation":[],"nameIdentifiers":[]}],"titles":[{"title":"Topology-Aware Coordination for Multi-Functional Low-Altitude Wireless Networks"}],"publisher":"arXiv","container":{},"publicationYear":2026,"subjects":[{"subject":"Information Theory (cs.IT)","lang":"en","subjectScheme":"arXiv"},{"subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"},{"schemeUri":"http://www.oecd.org/science/inno/38235147.pdf","subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"}],"contributors":[],"dates":[{"date":"2026-02-24T15:13:33Z","dateType":"Submitted","dateInformation":"v1"},{"date":"2026-02-25T01:54:39Z","dateType":"Updated","dateInformation":"v1"},{"date":"2026-02","dateType":"Available","dateInformation":"v1"},{"date":"2026","dateType":"Issued"}],"language":null,"types":{"schemaOrg":"CreativeWork","resourceTypeGeneral":"Preprint","citeproc":"article","bibtex":"misc","ris":"GEN","resourceType":"Article"},"relatedIdentifiers":[],"relatedItems":[],"sizes":[],"formats":[],"version":"1","rightsList":[{"rightsUri":"http://arxiv.org/licenses/nonexclusive-distrib/1.0/","rights":"arXiv.org perpetual, non-exclusive license"}],"descriptions":[{"descriptionType":"Abstract","description":"Low-altitude wireless networks (LAWNs) are expected to consist of multi-tier, heterogeneous terrestrial and non-terrestrial devices, where effective coordination is essential to fully unlock the complementary capabilities of diverse systems from different vendors. To address this issue, we propose a novel multi-functional coordination framework that enables seamless cooperation within the LAWN while supporting efficient execution of diverse network functions. In the proposed architecture, each device or infrastructure element is assigned to a specific functional role, namely, edge mobile terminal (E-MT), distributed MT (D-MT), or computing center. E-MTs are equipped with lightweight, independent signal processing and computing capabilities, while D-MTs and the computing center handle regional and global coordination, respectively. To enhance the overall network efficiency, we model the LAWN as a sparse graph, where nodes represent network nodes and edges are defined according to a set of controllable connection rules. This topology-aware (TA) representation allows for efficiently solving various coordination tasks across the network. Numerical results show that the proposed TA coordination framework outperforms baseline approaches that lack topological insights, achieving higher efficiency in multi-task coordination. Finally, we discuss key technical challenges and outline potential solutions for future deployment."},{"descriptionType":"Other","description":"The paper has been submitted to IEEE Communication Magazine"}],"geoLocations":[],"fundingReferences":[],"url":"https://arxiv.org/abs/2602.20993","contentUrl":null,"metadataVersion":0,"schemaVersion":"http://datacite.org/schema/kernel-4","source":"mds","isActive":true,"state":"findable","reason":null,"viewCount":0,"downloadCount":0,"referenceCount":0,"citationCount":0,"partCount":0,"partOfCount":0,"versionCount":0,"versionOfCount":0,"created":"2026-02-25T15:34:21Z","registered":"2026-02-25T15:34:22Z","published":null,"updated":"2026-02-25T15:34:22Z"},"relationships":{"client":{"data":{"id":"arxiv.content","type":"clients"}}}},{"id":"10.48550/arxiv.2602.20992","type":"dois","attributes":{"doi":"10.48550/arxiv.2602.20992","identifiers":[{"identifier":"2602.20992","identifierType":"arXiv"}],"creators":[{"nameType":"Personal","givenName":"Naghme","familyName":"Shahami","name":"Shahami, Naghme","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Behrooz","familyName":"Mashayekhy","name":"Mashayekhy, Behrooz","affiliation":[],"nameIdentifiers":[]}],"titles":[{"title":"Comparison of Topologies on Homotopy Groups with Subgroup Topology Viewpoint"}],"publisher":"arXiv","container":{},"publicationYear":2026,"subjects":[{"subject":"Algebraic Topology (math.AT)","lang":"en","subjectScheme":"arXiv"},{"subject":"FOS: Mathematics","subjectScheme":"Fields of Science and Technology (FOS)"},{"schemeUri":"http://www.oecd.org/science/inno/38235147.pdf","subject":"FOS: Mathematics","subjectScheme":"Fields of Science and Technology (FOS)"},{"subject":"55Q05, 55Q07, 55Q52","lang":"en","subjectScheme":"MSC"}],"contributors":[],"dates":[{"date":"2026-02-24T15:13:02Z","dateType":"Submitted","dateInformation":"v1"},{"date":"2026-02-25T01:54:32Z","dateType":"Updated","dateInformation":"v1"},{"date":"2026-02","dateType":"Available","dateInformation":"v1"},{"date":"2026","dateType":"Issued"}],"language":null,"types":{"schemaOrg":"CreativeWork","resourceTypeGeneral":"Preprint","citeproc":"article","bibtex":"misc","ris":"GEN","resourceType":"Article"},"relatedIdentifiers":[],"relatedItems":[],"sizes":[],"formats":[],"version":"1","rightsList":[{"rightsIdentifierScheme":"SPDX","rightsUri":"https://creativecommons.org/licenses/by/4.0/legalcode","schemeUri":"https://spdx.org/licenses/","rights":"Creative Commons Attribution 4.0 International","rightsIdentifier":"cc-by-4.0"}],"descriptions":[{"descriptionType":"Abstract","description":"By introducing various topologies on the homotopy groups of a topological space, some researchers make these well known notions in algebraic topology more useful and powerful. In this paper, first we recall and review some known topologies on homotopy groups. Then by reviewing some famous subgroups of homotopy groups and using the concept of subgroup topology, we intend to compare these topologies in order to present some results on topologized homotopy groups."},{"descriptionType":"Other","description":"18 pages"}],"geoLocations":[],"fundingReferences":[],"url":"https://arxiv.org/abs/2602.20992","contentUrl":null,"metadataVersion":0,"schemaVersion":"http://datacite.org/schema/kernel-4","source":"mds","isActive":true,"state":"findable","reason":null,"viewCount":0,"downloadCount":0,"referenceCount":0,"citationCount":0,"partCount":0,"partOfCount":0,"versionCount":0,"versionOfCount":0,"created":"2026-02-25T15:34:18Z","registered":"2026-02-25T15:34:19Z","published":null,"updated":"2026-02-25T15:34:19Z"},"relationships":{"client":{"data":{"id":"arxiv.content","type":"clients"}}}},{"id":"10.48550/arxiv.2602.20991","type":"dois","attributes":{"doi":"10.48550/arxiv.2602.20991","identifiers":[{"identifier":"2602.20991","identifierType":"arXiv"}],"creators":[{"nameType":"Personal","givenName":"Robin A.","familyName":"Heinonen","name":"Heinonen, Robin A.","affiliation":[],"nameIdentifiers":[]}],"titles":[{"title":"Asymptotics of solutions to the linear search problem"}],"publisher":"arXiv","container":{},"publicationYear":2026,"subjects":[{"subject":"Optimization and Control (math.OC)","lang":"en","subjectScheme":"arXiv"},{"subject":"Data Structures and Algorithms (cs.DS)","lang":"en","subjectScheme":"arXiv"},{"subject":"Probability (math.PR)","lang":"en","subjectScheme":"arXiv"},{"subject":"FOS: Mathematics","subjectScheme":"Fields of Science and Technology (FOS)"},{"schemeUri":"http://www.oecd.org/science/inno/38235147.pdf","subject":"FOS: Mathematics","subjectScheme":"Fields of Science and Technology (FOS)"},{"subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"},{"schemeUri":"http://www.oecd.org/science/inno/38235147.pdf","subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"}],"contributors":[],"dates":[{"date":"2026-02-24T15:12:33Z","dateType":"Submitted","dateInformation":"v1"},{"date":"2026-02-25T01:54:31Z","dateType":"Updated","dateInformation":"v1"},{"date":"2026-02","dateType":"Available","dateInformation":"v1"},{"date":"2026","dateType":"Issued"}],"language":null,"types":{"schemaOrg":"CreativeWork","resourceTypeGeneral":"Preprint","citeproc":"article","bibtex":"misc","ris":"GEN","resourceType":"Article"},"relatedIdentifiers":[],"relatedItems":[],"sizes":[],"formats":[],"version":"1","rightsList":[{"rightsUri":"http://arxiv.org/licenses/nonexclusive-distrib/1.0/","rights":"arXiv.org perpetual, non-exclusive license"}],"descriptions":[{"descriptionType":"Abstract","description":"The exact leading asymptotics of solutions to the symmetric linear search problem are obtained for any positive probability density on the real line with a monotonic, sufficiently regular tail. A similar result holds for densities on a compact interval."}],"geoLocations":[],"fundingReferences":[],"url":"https://arxiv.org/abs/2602.20991","contentUrl":null,"metadataVersion":0,"schemaVersion":"http://datacite.org/schema/kernel-4","source":"mds","isActive":true,"state":"findable","reason":null,"viewCount":0,"downloadCount":0,"referenceCount":0,"citationCount":0,"partCount":0,"partOfCount":0,"versionCount":0,"versionOfCount":0,"created":"2026-02-25T15:34:16Z","registered":"2026-02-25T15:34:17Z","published":null,"updated":"2026-02-25T15:34:17Z"},"relationships":{"client":{"data":{"id":"arxiv.content","type":"clients"}}}},{"id":"10.48550/arxiv.2602.20988","type":"dois","attributes":{"doi":"10.48550/arxiv.2602.20988","identifiers":[{"identifier":"2602.20988","identifierType":"arXiv"}],"creators":[{"nameType":"Personal","affiliation":["IIT Madras"],"givenName":"Prakhar","familyName":"Maheshwari","name":"Maheshwari, Prakhar","nameIdentifiers":[]},{"nameType":"Personal","affiliation":["IIT Hyderabad"],"givenName":"Mayukh","familyName":"Pahari","name":"Pahari, Mayukh","nameIdentifiers":[]},{"nameType":"Personal","affiliation":["IIT Hyderabad"],"givenName":"Anish","familyName":"Sarkar","name":"Sarkar, Anish","nameIdentifiers":[]},{"nameType":"Personal","affiliation":["IIT Hyderabad"],"givenName":"Saurabh","familyName":"Sharma","name":"Sharma, Saurabh","nameIdentifiers":[]}],"titles":[{"title":"Black hole-Neutron star distinction based on long-term MAXI and Swift study of 42 low mass X-ray binaries"}],"publisher":"arXiv","container":{},"publicationYear":2026,"subjects":[{"subject":"High Energy Astrophysical Phenomena (astro-ph.HE)","lang":"en","subjectScheme":"arXiv"},{"subject":"FOS: Physical sciences","subjectScheme":"Fields of Science and Technology (FOS)"},{"schemeUri":"http://www.oecd.org/science/inno/38235147.pdf","subject":"FOS: Physical sciences","subjectScheme":"Fields of Science and Technology (FOS)"}],"contributors":[],"dates":[{"date":"2026-02-24T15:10:18Z","dateType":"Submitted","dateInformation":"v1"},{"date":"2026-02-25T01:54:18Z","dateType":"Updated","dateInformation":"v1"},{"date":"2026-02","dateType":"Available","dateInformation":"v1"},{"date":"2026","dateType":"Issued"}],"language":null,"types":{"schemaOrg":"CreativeWork","resourceTypeGeneral":"Preprint","citeproc":"article","bibtex":"misc","ris":"GEN","resourceType":"Article"},"relatedIdentifiers":[],"relatedItems":[],"sizes":[],"formats":[],"version":"1","rightsList":[{"rightsUri":"http://arxiv.org/licenses/nonexclusive-distrib/1.0/","rights":"arXiv.org perpetual, non-exclusive license"}],"descriptions":[{"descriptionType":"Abstract","description":"In this study, we analysed about $\\sim$13 years of publicly available data from MAXI and Swift/BAT to examine the long-term source evolution of 42 transient low-mass X-ray binaries. The sample consists of 11 confirmed black hole X-ray binaries (BHXBs), 10 black hole candidates (BHC), and 21 neutron star X-ray binaries (NSXBs). Outbursts and flaring activities studied over 13 years show that 19/21 NSXBs spend significantly longer time in the hard state (observations for which hardness ratio is $\\geq$ 0.2) while 15/21 BHXB+XRC spend substantially longer time in the soft state (observations for which hardness ratio is $\u0026lt;$ 0.2). The frequency distribution of the hardness ratio clearly shows two distinct distributions for BHXBs and NSXBs, with their peaks separated: NSXBs prefer harder values, while BHXBs prefer softer values of hardness. Our model-independent analysis for 42 transient sources shows that statistically NSXBs do not prefer to show a canonical high soft state as observed in BHXBs. Additionally, the probability distribution of the duration of the 2-20 keV X-ray outburst is observed to peak at a significantly longer duration ($\u0026gt;$100 days) for BHXBs than for NSXBs (15-60 days). Our analysis shows that among candidate sources, Swift J1728.9-3613, MAXI J1535-571, MAXI J1659-152, EXO 1846-031 show a `q' diagram in the HID and prefer to align with the HID frequency distribution of BHXBs that show `q' diagram, MAXI J1305-704 and MAXI J1836-194 align with frequency distribution of black hole sources without `q' diagram while MAXI J1848-015 shows the HID distribution similar to NSXBs, indicating a neutron star accretor. Therefore, a long-term statistical study of MAXI and Swift/BAT X-ray outbursts from a large sample of transient sources may be used to distinguish BHXB from NSXB."},{"descriptionType":"Other","description":"42 pages, 46 figures, 2 tables, Accepted for publication in Journal of Astrophysics and Astronomy (JOAA)"}],"geoLocations":[],"fundingReferences":[],"url":"https://arxiv.org/abs/2602.20988","contentUrl":null,"metadataVersion":0,"schemaVersion":"http://datacite.org/schema/kernel-4","source":"mds","isActive":true,"state":"findable","reason":null,"viewCount":0,"downloadCount":0,"referenceCount":0,"citationCount":0,"partCount":0,"partOfCount":0,"versionCount":0,"versionOfCount":0,"created":"2026-02-25T15:34:09Z","registered":"2026-02-25T15:34:09Z","published":null,"updated":"2026-02-25T15:34:09Z"},"relationships":{"client":{"data":{"id":"arxiv.content","type":"clients"}}}},{"id":"10.48550/arxiv.2602.20987","type":"dois","attributes":{"doi":"10.48550/arxiv.2602.20987","identifiers":[{"identifier":"2602.20987","identifierType":"arXiv"}],"creators":[{"nameType":"Personal","givenName":"Tianfeng","familyName":"Feng","name":"Feng, Tianfeng","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Yue","familyName":"Cao","name":"Cao, Yue","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Wenjun","familyName":"Yu","name":"Yu, Wenjun","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Junkai","familyName":"Zeng","name":"Zeng, Junkai","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Xiaopeng","familyName":"Li","name":"Li, Xiaopeng","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Xiu-Hao","familyName":"Deng","name":"Deng, Xiu-Hao","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Qi","familyName":"Zhao","name":"Zhao, Qi","affiliation":[],"nameIdentifiers":[]}],"titles":[{"title":"Entanglement-Induced Resilience of Quantum Dynamics"}],"publisher":"arXiv","container":{},"publicationYear":2026,"subjects":[{"subject":"Quantum Physics (quant-ph)","lang":"en","subjectScheme":"arXiv"},{"subject":"FOS: Physical sciences","subjectScheme":"Fields of Science and Technology (FOS)"},{"schemeUri":"http://www.oecd.org/science/inno/38235147.pdf","subject":"FOS: Physical sciences","subjectScheme":"Fields of Science and Technology (FOS)"}],"contributors":[],"dates":[{"date":"2026-02-24T15:10:17Z","dateType":"Submitted","dateInformation":"v1"},{"date":"2026-02-25T01:54:17Z","dateType":"Updated","dateInformation":"v1"},{"date":"2026-02","dateType":"Available","dateInformation":"v1"},{"date":"2026","dateType":"Issued"}],"language":null,"types":{"schemaOrg":"CreativeWork","resourceTypeGeneral":"Preprint","citeproc":"article","bibtex":"misc","ris":"GEN","resourceType":"Article"},"relatedIdentifiers":[],"relatedItems":[],"sizes":[],"formats":[],"version":"1","rightsList":[{"rightsUri":"http://arxiv.org/licenses/nonexclusive-distrib/1.0/","rights":"arXiv.org perpetual, non-exclusive license"}],"descriptions":[{"descriptionType":"Abstract","description":"Quantum many-body devices suffer from imperfections that destabilize dynamics and limit scalability. We show that the dynamical growth of entanglement can intrinsically protect generic quantum dynamics against coherent and perturbative noise. Through rigorous theoretical analysis of general quantum dynamics and numerical simulations of spin chains and fermionic lattices, we prove that entanglement-entropy growth confines the influence of local Hamiltonian perturbations, thereby suppressing errors in dynamical errors. The degree of protection correlates quantitatively with the entanglement entropy of subsystems on which the perturbations act, and applies broadly to both analog quantum simulators and real-time control protocols. This entanglement-induced resilience is conceptually distinct from quantum error correction or dynamical decoupling: it passively leverages native many-body correlations without additional qubits, measurements, or control overhead. Our results reveal a generic mechanism linking entanglement growth to dynamical stability and provide practical guidelines for designing noise-resilient quantum devices."},{"descriptionType":"Other","description":"29 pages, 11 figures, 1 tatble"}],"geoLocations":[],"fundingReferences":[],"url":"https://arxiv.org/abs/2602.20987","contentUrl":null,"metadataVersion":0,"schemaVersion":"http://datacite.org/schema/kernel-4","source":"mds","isActive":true,"state":"findable","reason":null,"viewCount":0,"downloadCount":0,"referenceCount":0,"citationCount":0,"partCount":0,"partOfCount":0,"versionCount":0,"versionOfCount":0,"created":"2026-02-25T15:34:06Z","registered":"2026-02-25T15:34:07Z","published":null,"updated":"2026-02-25T15:34:07Z"},"relationships":{"client":{"data":{"id":"arxiv.content","type":"clients"}}}},{"id":"10.48550/arxiv.2602.20986","type":"dois","attributes":{"doi":"10.48550/arxiv.2602.20986","identifiers":[{"identifier":"2602.20986","identifierType":"arXiv"}],"creators":[{"nameType":"Personal","givenName":"Thibault","familyName":"Formal","name":"Formal, Thibault","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Maxime","familyName":"Louis","name":"Louis, Maxime","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Hervé","familyName":"Déjean","name":"Déjean, Hervé","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Stéphane","familyName":"Clinchant","name":"Clinchant, Stéphane","affiliation":[],"nameIdentifiers":[]}],"titles":[{"title":"Naver Labs Europe @ WSDM CUP | Multilingual Retrieval"}],"publisher":"arXiv","container":{},"publicationYear":2026,"subjects":[{"subject":"Information Retrieval (cs.IR)","lang":"en","subjectScheme":"arXiv"},{"subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"},{"schemeUri":"http://www.oecd.org/science/inno/38235147.pdf","subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"}],"contributors":[],"dates":[{"date":"2026-02-24T15:09:01Z","dateType":"Submitted","dateInformation":"v1"},{"date":"2026-02-25T01:54:15Z","dateType":"Updated","dateInformation":"v1"},{"date":"2026-02","dateType":"Available","dateInformation":"v1"},{"date":"2026","dateType":"Issued"}],"language":null,"types":{"schemaOrg":"CreativeWork","resourceTypeGeneral":"Preprint","citeproc":"article","bibtex":"misc","ris":"GEN","resourceType":"Article"},"relatedIdentifiers":[],"relatedItems":[],"sizes":[],"formats":[],"version":"1","rightsList":[{"rightsIdentifierScheme":"SPDX","rightsUri":"https://creativecommons.org/licenses/by-nc-sa/4.0/legalcode","schemeUri":"https://spdx.org/licenses/","rights":"Creative Commons Attribution Non Commercial Share Alike 4.0 International","rightsIdentifier":"cc-by-nc-sa-4.0"}],"descriptions":[{"descriptionType":"Abstract","description":"This report presents our participation to the WSDM Cup 2026 shared task on multilingual document retrieval from English queries. The task provides a challenging benchmark for cross-lingual generalization. It also provides a natural testbed for evaluating SPLARE, our recently proposed learned sparse retrieval model, which produces generalizable sparse latent representations and is particularly well suited to multilingual retrieval settings.\n We evaluate five progressively enhanced runs, starting from a SPLARE-7B model and incorporating lightweight improvements, including reranking with Qwen3-Reranker-4B and simple score fusion strategies. Our results demonstrate the strength of SPLARE compared to state-of-the-art dense baselines such as Qwen3-8B-Embed. More broadly, our submission highlights the continued relevance and competitiveness of learned sparse retrieval models beyond English-centric scenarios."},{"descriptionType":"Other","description":"Report paper of our submission to the WSDM Cup 2026"}],"geoLocations":[],"fundingReferences":[],"url":"https://arxiv.org/abs/2602.20986","contentUrl":null,"metadataVersion":0,"schemaVersion":"http://datacite.org/schema/kernel-4","source":"mds","isActive":true,"state":"findable","reason":null,"viewCount":0,"downloadCount":0,"referenceCount":0,"citationCount":0,"partCount":0,"partOfCount":0,"versionCount":0,"versionOfCount":0,"created":"2026-02-25T15:34:03Z","registered":"2026-02-25T15:34:04Z","published":null,"updated":"2026-02-25T15:34:04Z"},"relationships":{"client":{"data":{"id":"arxiv.content","type":"clients"}}}},{"id":"10.48550/arxiv.2602.20984","type":"dois","attributes":{"doi":"10.48550/arxiv.2602.20984","identifiers":[{"identifier":"2602.20984","identifierType":"arXiv"}],"creators":[{"nameType":"Personal","givenName":"Andrew","familyName":"Curtis","name":"Curtis, Andrew","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Karen","familyName":"Lythgoe","name":"Lythgoe, Karen","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Stephen P.","familyName":"Hicks","name":"Hicks, Stephen P.","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Lidong","familyName":"Bie","name":"Bie, Lidong","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Dominik","familyName":"Strutz","name":"Strutz, Dominik","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","g