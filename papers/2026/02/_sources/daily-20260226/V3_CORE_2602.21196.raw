<th id="S2.T2.5.1.2" class="ltx_td ltx_align_center ltx_th ltx_th_column ltx_border_tt"><span id="S2.T2.5.1.2.1" class="ltx_text ltx_font_bold">Before attn block</span></th>
<th id="S2.T2.5.1.3" class="ltx_td ltx_align_center ltx_th ltx_th_column ltx_border_tt"><span id="S2.T2.5.1.3.1" class="ltx_text ltx_font_bold">During inp_all_to_all</span></th>
