<th id="S2.T2.5.5.1" class="ltx_td ltx_align_left ltx_th ltx_th_row ltx_border_bb ltx_border_t">Untied Ulysses</th>
<td id="S2.T2.5.5.2" class="ltx_td ltx_align_center ltx_border_bb ltx_border_t"><math id="S2.T2.m19" class="ltx_Math" alttext="\frac{S}{C}" display="inline" intent=":literal"><semantics><mfrac><mi>S</mi><mi>C</mi></mfrac><annotation encoding="application/x-tex">\frac{S}{C}</annotation></semantics></math></td>
