<td id="S4.T5.3.2.2" class="ltx_td ltx_align_center ltx_border_t">58.4</td>
<td id="S4.T5.3.2.3" class="ltx_td ltx_align_center ltx_border_t">43.5</td>
<td id="S4.T5.3.2.4" class="ltx_td ltx_align_center ltx_border_t">50.9</td></tr>
<tr id="S4.T5.3.3" class="ltx_tr">
<td id="S4.T5.3.3.1" class="ltx_td ltx_align_left ltx_border_r">Seq. Append.</td>
<td id="S4.T5.3.3.2" class="ltx_td ltx_align_center">58.5</td>
