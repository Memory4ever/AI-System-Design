<td id="S3.T1.3.1.19.5" class="ltx_td ltx_align_center ltx_border_bb"><span id="S3.T1.3.1.19.5.1" class="ltx_text ltx_font_bold">70.6</span></td>
<td id="S3.T1.3.1.19.6" class="ltx_td ltx_align_center ltx_border_bb"><span id="S3.T1.3.1.19.6.1" class="ltx_text ltx_font_bold">62.8</span></td>
