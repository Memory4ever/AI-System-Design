<td id="S4.T4.3.1.2" class="ltx_td ltx_align_center ltx_border_tt" style="padding-left:3.0pt;padding-right:3.0pt;"><span id="S4.T4.3.1.2.1" class="ltx_text ltx_font_bold">DINO</span></td>
<td id="S4.T4.3.1.3" class="ltx_td ltx_align_center ltx_border_r ltx_border_tt" style="padding-left:3.0pt;padding-right:3.0pt;"><span id="S4.T4.3.1.3.1" class="ltx_text ltx_font_bold">CLIP</span></td>
