<td id="S3.T1.3.1.19.9" class="ltx_td ltx_align_center ltx_border_bb"><span id="S3.T1.3.1.19.9.1" class="ltx_text ltx_font_bold">36.1</span></td>
<td id="S3.T1.3.1.19.10" class="ltx_td ltx_align_center ltx_border_bb"><span id="S3.T1.3.1.19.10.1" class="ltx_text ltx_underline">73.6</span></td></tr>
