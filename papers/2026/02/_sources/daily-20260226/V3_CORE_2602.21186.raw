<td id="S4.T3.3.2.4" class="ltx_td ltx_align_center ltx_border_t">50.9</td></tr>
<tr id="S4.T3.3.3" class="ltx_tr">
<td id="S4.T3.3.3.1" class="ltx_td ltx_align_left ltx_border_r">VGGT</td>
<td id="S4.T3.3.3.2" class="ltx_td ltx_align_center"><span id="S4.T3.3.3.2.1" class="ltx_text ltx_font_bold">60.5</span></td>
