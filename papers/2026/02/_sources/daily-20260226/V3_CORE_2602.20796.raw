</div>
<div id="alg1.l6" class="ltx_listingline">
              
              
               Sample <math id="alg1.l6.m1" class="ltx_Math" alttext="x_{1}\sim\mathcal{D}_{1}" display="inline" intent=":literal"><semantics><mrow><msub><mi>x</mi><mn>1</mn></msub><mo>∼</mo><msub><mi class="ltx_font_mathcaligraphic">𝒟</mi><mn>1</mn></msub></mrow><annotation encoding="application/x-tex">x_{1}\sim\mathcal{D}_{1}</annotation></semantics></math>

