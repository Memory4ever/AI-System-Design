<td id="S4.T1.5.1.9.7" class="ltx_td ltx_align_center">29.21 <math id="S4.T1.m30" class="ltx_Math" alttext="\pm" display="inline" intent=":literal"><semantics><mo>±</mo><annotation encoding="application/x-tex">\pm</annotation></semantics></math> 0.03</td></tr>
