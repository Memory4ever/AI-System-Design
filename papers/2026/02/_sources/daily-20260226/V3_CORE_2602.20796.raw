<td id="S4.T1.5.1.10.2" class="ltx_td ltx_align_center"><span id="S4.T1.5.1.10.2.1" class="ltx_text ltx_font_bold">50.21 <math id="S4.T1.m31" class="ltx_Math" alttext="\pm" display="inline" intent=":literal"><semantics><mo>±</mo><annotation encoding="application/x-tex">\pm</annotation></semantics></math> 0.17</span></td>
<td id="S4.T1.5.1.10.3" class="ltx_td ltx_align_center"><span id="S4.T1.5.1.10.3.1" class="ltx_text ltx_font_bold">20.03 <math id="S4.T1.m32" class="ltx_Math" alttext="\pm" display="inline" intent=":literal"><semantics><mo>±</mo><annotation encoding="application/x-tex">\pm</annotation></semantics></math> 0.12</span></td>
