</div>
<div id="alg1.l3" class="ltx_listingline">
              
              
             <span id="alg1.l3.2" class="ltx_text ltx_font_bold">for</span> <math id="alg1.l3.m1" class="ltx_Math" alttext="t=1" display="inline" intent=":literal"><semantics><mrow><mi>t</mi><mo>=</mo><mn>1</mn></mrow><annotation encoding="application/x-tex">t=1</annotation></semantics></math> <span id="alg1.l3.3" class="ltx_text ltx_font_bold">to</span> <math id="alg1.l3.m2" class="ltx_Math" alttext="M" display="inline" intent=":literal"><semantics><mi>M</mi><annotation encoding="application/x-tex">M</annotation></semantics></math> <span id="alg1.l3.4" class="ltx_text ltx_font_bold">do</span>



</div>
<div id="alg1.l4" class="ltx_listingline">
              
              
              <span id="alg1.l4.2" class="ltx_text ltx_font_bold">if</span> <math id="alg1.l4.m1" class="ltx_Math" alttext="t=1" display="inline" intent=":literal"><semantics><mrow><mi>t</mi><mo>=</mo><mn>1</mn></mrow><annotation encoding="application/x-tex">t=1</annotation></semantics></math> <span id="alg1.l4.3" class="ltx_text ltx_font_bold">then</span>



