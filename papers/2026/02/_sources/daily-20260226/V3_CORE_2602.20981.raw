</thead>
<tbody class="ltx_tbody">
<tr id="S5.T1.3.1.2" class="ltx_tr">
<th id="S5.T1.3.1.2.1" class="ltx_td ltx_align_left ltx_th ltx_th_row ltx_border_t" style="padding:1.1pt 4.0pt;" rowspan="2"><span id="S5.T1.3.1.2.1.1" class="ltx_text ltx_font_bold" style="font-size:144%;">Method</span></th>
<td id="S5.T1.3.1.2.2" class="ltx_td ltx_align_center ltx_border_t" style="padding:1.1pt 4.0pt;" rowspan="2"><span id="S5.T1.3.1.2.2.1" class="ltx_text ltx_font_bold" style="font-size:144%;">Size</span></td>
<td id="S5.T1.3.1.2.3" class="ltx_td ltx_align_center ltx_border_t" style="padding:1.1pt 4.0pt;" colspan="4"><span id="S5.T1.3.1.2.3.1" class="ltx_text" style="font-size:144%;">Distribution Matching</span></td>
<td id="S5.T1.3.1.2.4" class="ltx_td ltx_border_t" style="padding:1.1pt 4.0pt;"></td>
<td id="S5.T1.3.1.2.5" class="ltx_td ltx_align_center ltx_border_t" style="padding:1.1pt 4.0pt;" colspan="2"><span id="S5.T1.3.1.2.5.1" class="ltx_text" style="font-size:144%;">Audio Quality</span></td>
<td id="S5.T1.3.1.2.6" class="ltx_td ltx_border_t" style="padding:1.1pt 4.0pt;"></td>
<td id="S5.T1.3.1.2.7" class="ltx_td ltx_align_center ltx_border_t" style="padding:1.1pt 4.0pt;"><span id="S5.T1.3.1.2.7.1" class="ltx_text" style="font-size:144%;">MM Align.</span></td>
<td id="S5.T1.3.1.2.8" class="ltx_td ltx_align_center ltx_border_t" style="padding:1.1pt 4.0pt;"><span id="S5.T1.3.1.2.8.1" class="ltx_text" style="font-size:144%;">Temporal Align.</span></td></tr>
<tr id="S5.T1.3.1.3" class="ltx_tr">
<td id="S5.T1.3.1.3.1" class="ltx_td ltx_align_center ltx_border_t" style="padding:1.1pt 4.0pt;"><span id="S5.T1.3.1.3.1.1" class="ltx_text ltx_font_bold" style="font-size:144%;">FD<math id="S5.T1.m1" class="ltx_Math" alttext="{}_{\textrm{VGG}}" display="inline" intent=":literal"><semantics><msub><mrow></mrow><mtext class="ltx_mathvariant_bold">VGG</mtext></msub><annotation encoding="application/x-tex">{}_{\textrm{VGG}}</annotation></semantics></math> <math id="S5.T1.m2" class="ltx_Math" alttext="\downarrow" display="inline" intent=":literal"><semantics><mo stretchy="false">↓</mo><annotation encoding="application/x-tex">\downarrow</annotation></semantics></math></span></td>
<td id="S5.T1.3.1.3.2" class="ltx_td ltx_align_center ltx_border_t" style="padding:1.1pt 4.0pt;"><span id="S5.T1.3.1.3.2.1" class="ltx_text ltx_font_bold" style="font-size:144%;">FD<math id="S5.T1.m3" class="ltx_Math" alttext="{}_{\textrm{PANNs}}" display="inline" intent=":literal"><semantics><msub><mrow></mrow><mtext class="ltx_mathvariant_bold">PANNs</mtext></msub><annotation encoding="application/x-tex">{}_{\textrm{PANNs}}</annotation></semantics></math> <math id="S5.T1.m4" class="ltx_Math" alttext="\downarrow" display="inline" intent=":literal"><semantics><mo stretchy="false">↓</mo><annotation encoding="application/x-tex">\downarrow</annotation></semantics></math></span></td>
<td id="S5.T1.3.1.3.3" class="ltx_td ltx_align_center ltx_border_t" style="padding:1.1pt 4.0pt;"><span id="S5.T1.3.1.3.3.1" class="ltx_text ltx_font_bold" style="font-size:144%;">FD<math id="S5.T1.m5" class="ltx_Math" alttext="{}_{\textrm{PASST}}" display="inline" intent=":literal"><semantics><msub><mrow></mrow><mtext class="ltx_mathvariant_bold">PASST</mtext></msub><annotation encoding="application/x-tex">{}_{\textrm{PASST}}</annotation></semantics></math> <math id="S5.T1.m6" class="ltx_Math" alttext="\downarrow" display="inline" intent=":literal"><semantics><mo stretchy="false">↓</mo><annotation encoding="application/x-tex">\downarrow</annotation></semantics></math></span></td>
<td id="S5.T1.3.1.3.4" class="ltx_td ltx_align_center ltx_border_t" style="padding:1.1pt 4.0pt;"><span id="S5.T1.3.1.3.4.1" class="ltx_text ltx_font_bold" style="font-size:144%;">KL<math id="S5.T1.m7" class="ltx_Math" alttext="{}_{\textrm{PASST}}" display="inline" intent=":literal"><semantics><msub><mrow></mrow><mtext class="ltx_mathvariant_bold">PASST</mtext></msub><annotation encoding="application/x-tex">{}_{\textrm{PASST}}</annotation></semantics></math> <math id="S5.T1.m8" class="ltx_Math" alttext="\downarrow" display="inline" intent=":literal"><semantics><mo stretchy="false">↓</mo><annotation encoding="application/x-tex">\downarrow</annotation></semantics></math></span></td>
<td id="S5.T1.3.1.3.5" class="ltx_td" style="padding:1.1pt 4.0pt;"></td>
<td id="S5.T1.3.1.3.6" class="ltx_td ltx_align_center ltx_border_t" style="padding:1.1pt 4.0pt;"><span id="S5.T1.3.1.3.6.1" class="ltx_text ltx_font_bold" style="font-size:144%;">ISC<math id="S5.T1.m9" class="ltx_Math" alttext="{}_{\textrm{PANNs}}" display="inline" intent=":literal"><semantics><msub><mrow></mrow><mtext class="ltx_mathvariant_bold">PANNs</mtext></msub><annotation encoding="application/x-tex">{}_{\textrm{PANNs}}</annotation></semantics></math> <math id="S5.T1.m10" class="ltx_Math" alttext="\uparrow" display="inline" intent=":literal"><semantics><mo stretchy="false">↑</mo><annotation encoding="application/x-tex">\uparrow</annotation></semantics></math></span></td>
<td id="S5.T1.3.1.3.7" class="ltx_td ltx_align_center ltx_border_t" style="padding:1.1pt 4.0pt;"><span id="S5.T1.3.1.3.7.1" class="ltx_text ltx_font_bold" style="font-size:144%;">ISC<math id="S5.T1.m11" class="ltx_Math" alttext="{}_{\textrm{PASST}}" display="inline" intent=":literal"><semantics><msub><mrow></mrow><mtext class="ltx_mathvariant_bold">PASST</mtext></msub><annotation encoding="application/x-tex">{}_{\textrm{PASST}}</annotation></semantics></math> <math id="S5.T1.m12" class="ltx_Math" alttext="\uparrow" display="inline" intent=":literal"><semantics><mo stretchy="false">↑</mo><annotation encoding="application/x-tex">\uparrow</annotation></semantics></math></span></td>
<td id="S5.T1.3.1.3.8" class="ltx_td" style="padding:1.1pt 4.0pt;"></td>
<td id="S5.T1.3.1.3.9" class="ltx_td ltx_align_center ltx_border_t" style="padding:1.1pt 4.0pt;"><span id="S5.T1.3.1.3.9.1" class="ltx_text ltx_font_bold" style="font-size:144%;">IB-Score <math id="S5.T1.m13" class="ltx_Math" alttext="\uparrow" display="inline" intent=":literal"><semantics><mo stretchy="false">↑</mo><annotation encoding="application/x-tex">\uparrow</annotation></semantics></math></span></td>
<td id="S5.T1.3.1.3.10" class="ltx_td ltx_align_center ltx_border_t" style="padding:1.1pt 4.0pt;"><span id="S5.T1.3.1.3.10.1" class="ltx_text ltx_font_bold" style="font-size:144%;">DeSync <math id="S5.T1.m14" class="ltx_Math" alttext="\downarrow" display="inline" intent=":literal"><semantics><mo stretchy="false">↓</mo><annotation encoding="application/x-tex">\downarrow</annotation></semantics></math></span></td></tr>
<tr id="S5.T1.3.1.4" class="ltx_tr">
<th id="S5.T1.3.1.4.1" class="ltx_td ltx_align_left ltx_th ltx_th_row ltx_border_tt" style="padding:1.1pt 4.0pt;"><span id="S5.T1.3.1.4.1.1" class="ltx_text" style="font-size:144%;">MMAudio-S <cite class="ltx_cite ltx_citemacro_cite">[<a href="#bib.bib1" title="" class="ltx_ref">4</a>]</cite></span></th>
<td id="S5.T1.3.1.4.2" class="ltx_td ltx_align_center ltx_border_tt" style="padding:1.1pt 4.0pt;"><span id="S5.T1.3.1.4.2.1" class="ltx_text" style="font-size:144%;">157M</span></td>
