<td id="S5.T5.3.1.4.5" class="ltx_td ltx_align_center" style="padding:1.1pt 5.5pt;"><span id="S5.T5.3.1.4.5.1" class="ltx_text ltx_font_bold" style="font-size:144%;--ltx-bg-color:#EBEBEB;">36.27</span></td>
<td id="S5.T5.3.1.4.6" class="ltx_td ltx_align_center" style="padding:1.1pt 5.5pt;"><span id="S5.T5.3.1.4.6.1" class="ltx_text ltx_font_bold" style="font-size:144%;--ltx-bg-color:#EBEBEB;">0.410</span></td></tr>
<tr id="S5.T5.3.1.5" class="ltx_tr">
<td id="S5.T5.3.1.5.1" class="ltx_td ltx_align_center" style="padding:1.1pt 5.5pt;"><span id="S5.T5.3.1.5.1.1" class="ltx_text" style="font-size:144%;">0.6</span></td>
<td id="S5.T5.3.1.5.2" class="ltx_td ltx_align_center" style="padding:1.1pt 5.5pt;"><span id="S5.T5.3.1.5.2.1" class="ltx_text" style="font-size:144%;">3.64</span></td>
<td id="S5.T5.3.1.5.3" class="ltx_td ltx_align_center" style="padding:1.1pt 5.5pt;"><span id="S5.T5.3.1.5.3.1" class="ltx_text" style="font-size:144%;">6.91</span></td>
<td id="S5.T5.3.1.5.4" class="ltx_td ltx_align_center" style="padding:1.1pt 5.5pt;"><span id="S5.T5.3.1.5.4.1" class="ltx_text ltx_font_bold" style="font-size:144%;">8.66</span></td>
