]},{"nameType":"Personal","givenName":"Laura A.","familyName":"Busch","name":"Busch, Laura A.","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Natalie O.","familyName":"Butterfield","name":"Butterfield, Natalie O.","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Mélanie","familyName":"Chevance","name":"Chevance, Mélanie","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Samuel","familyName":"Crowe","name":"Crowe, Samuel","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Ana Karla","familyName":"Díaz-Rodríguez","name":"Díaz-Rodríguez, Ana Karla","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Katarzyna M.","familyName":"Dutkowska","name":"Dutkowska, Katarzyna M.","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Christoph","familyName":"Federrath","name":"Federrath, Christoph","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Rubén","familyName":"Fedriani","name":"Fedriani, Rubén","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Pablo","familyName":"García","name":"García, Pablo","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Simon C. O.","familyName":"Glover","name":"Glover, Simon C. O.","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Qi-Lao","familyName":"Gu","name":"Gu, Qi-Lao","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"H Perry","familyName":"Hatchfield","name":"Hatchfield, H Perry","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Rebecca J.","familyName":"Houghton","name":"Houghton, Rebecca J.","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Yue","familyName":"Hu","name":"Hu, Yue","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Janik","familyName":"Karoly","name":"Karoly, Janik","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Ralf S.","familyName":"Klessen","name":"Klessen, Ralf S.","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Mark R.","familyName":"Krumholz","name":"Krumholz, Mark R.","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Farideh","familyName":"Mazoochi","name":"Mazoochi, Farideh","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Francisco","familyName":"Nogueras-Lara","name":"Nogueras-Lara, Francisco","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Dylan","familyName":"Paré","name":"Paré, Dylan","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Denise","familyName":"Riquelme-Vásquez","name":"Riquelme-Vásquez, Denise","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Víctor M.","familyName":"Rivilla","name":"Rivilla, Víctor M.","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Miriam G.","familyName":"Santa-Maria","name":"Santa-Maria, Miriam G.","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Anika","familyName":"Schmiedeke","name":"Schmiedeke, Anika","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Yoshiaki","familyName":"Sofue","name":"Sofue, Yoshiaki","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Volker","familyName":"Tolls","name":"Tolls, Volker","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Q. Daniel","familyName":"Wang","name":"Wang, Q. Daniel","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Gwenllian M.","familyName":"Williams","name":"Williams, Gwenllian M.","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Fengwei","familyName":"Xu","name":"Xu, Fengwei","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Suinan","familyName":"Zhang","name":"Zhang, Suinan","affiliation":[],"nameIdentifiers":[]}],"titles":[{"title":"ALMA Central molecular zone Exploration Survey (ACES) III: Molecular line data reduction and HNCO and HCO$^{+}$ data"}],"publisher":"arXiv","container":{},"publicationYear":2026,"subjects":[{"subject":"Astrophysics of Galaxies (astro-ph.GA)","lang":"en","subjectScheme":"arXiv"},{"subject":"FOS: Physical sciences","subjectScheme":"Fields of Science and Technology (FOS)"},{"schemeUri":"http://www.oecd.org/science/inno/38235147.pdf","subject":"FOS: Physical sciences","subjectScheme":"Fields of Science and Technology (FOS)"}],"contributors":[],"dates":[{"date":"2026-02-23T19:02:46Z","dateType":"Submitted","dateInformation":"v1"},{"date":"2026-02-25T01:02:44Z","dateType":"Updated","dateInformation":"v1"},{"date":"2026-02","dateType":"Available","dateInformation":"v1"},{"date":"2026","dateType":"Issued"}],"language":null,"types":{"schemaOrg":"CreativeWork","resourceTypeGeneral":"Preprint","citeproc":"article","bibtex":"misc","ris":"GEN","resourceType":"Article"},"relatedIdentifiers":[],"relatedItems":[],"sizes":[],"formats":[],"version":"1","rightsList":[{"rightsIdentifierScheme":"SPDX","rightsUri":"https://creativecommons.org/licenses/by/4.0/legalcode","schemeUri":"https://spdx.org/licenses/","rights":"Creative Commons Attribution 4.0 International","rightsIdentifier":"cc-by-4.0"}],"descriptions":[{"descriptionType":"Abstract","description":"The ALMA Central molecular zone Exploration Survey (ACES) large program has observed the inner ~ 200 pc of the Milky Way at 3 mm (Band 3) using ALMA's 12m, 7m, and Total Power arrays. With an angular resolution of ~ 2\", ACES provides a contiguous, multi-scale view of the Central Molecular Zone (CMZ) via the dust continuum and a suite of molecular lines. We present an overview of the molecular line data processing for ACES and describe the first data release. We showcase the HNCO (4-3) and HCO$^{+}$ (1-0) data, which were targeted at high spectral resolution (0.2 km s$^{-1}$) to trace the kinematics of the molecular gas in the CMZ. The HNCO and HCO$^{+}$ maps are compared with previous single-dish CMZ surveys and discrete ALMA observations of CMZ clouds to demonstrate the quality of the data. We highlight the ubiquity of parsec-scale, linear absorption features traced by HCO$^{+}$. Their origin is unknown, and ACES provides the first opportunity to study these enigmatic features throughout the CMZ. We release the HNCO and HCO$^{+}$ cubes for all 45 ACES fields, along with the full cube mosaics which combine all fields into a contiguous mosaic of the CMZ. We additionally provide advanced products of these full mosaics, including integrated and peak intensity, noise, and position-velocity maps. These products provide substantial legacy value for the community, offering an unparalleled view of the physical and kinematic structure of the dense gas in the CMZ."},{"descriptionType":"Other","description":"Accepted for publication in MNRAS. Website is https://sites.google.com/view/aces-cmz/home and data release is linked from there. Pipeline code is at https://github.com/ACES-CMZ/reduction_ACES/releases/tag/2026-02-18"}],"geoLocations":[],"fundingReferences":[],"url":"https://arxiv.org/abs/2602.20276","contentUrl":null,"metadataVersion":0,"schemaVersion":"http://datacite.org/schema/kernel-4","source":"mds","isActive":true,"state":"findable","reason":null,"viewCount":0,"downloadCount":0,"referenceCount":0,"citationCount":0,"partCount":0,"partOfCount":0,"versionCount":0,"versionOfCount":0,"created":"2026-02-25T02:46:16Z","registered":"2026-02-25T02:46:16Z","published":null,"updated":"2026-02-25T02:46:16Z"},"relationships":{"client":{"data":{"id":"arxiv.content","type":"clients"}}}},{"id":"10.48550/arxiv.2602.20275","type":"dois","attributes":{"doi":"10.48550/arxiv.2602.20275","identifiers":[{"identifier":"2602.20275","identifierType":"arXiv"}],"creators":[{"nameType":"Personal","givenName":"K. De La Ossa","familyName":"Doria","name":"Doria, K. De La Ossa","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"T. Merlo","familyName":"Vergara","name":"Vergara, T. Merlo","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"D.","familyName":"Goyeneche","name":"Goyeneche, D.","affiliation":[],"nameIdentifiers":[]}],"titles":[{"title":"Pulse-level control for quantum resource preparation"}],"publisher":"arXiv","container":{},"publicationYear":2026,"subjects":[{"subject":"Quantum Physics (quant-ph)","lang":"en","subjectScheme":"arXiv"},{"subject":"FOS: Physical sciences","subjectScheme":"Fields of Science and Technology (FOS)"},{"schemeUri":"http://www.oecd.org/science/inno/38235147.pdf","subject":"FOS: Physical sciences","subjectScheme":"Fields of Science and Technology (FOS)"}],"contributors":[],"dates":[{"date":"2026-02-23T19:02:31Z","dateType":"Submitted","dateInformation":"v1"},{"date":"2026-02-25T01:02:43Z","dateType":"Updated","dateInformation":"v1"},{"date":"2026-02","dateType":"Available","dateInformation":"v1"},{"date":"2026","dateType":"Issued"}],"language":null,"types":{"schemaOrg":"CreativeWork","resourceTypeGeneral":"Preprint","citeproc":"article","bibtex":"misc","ris":"GEN","resourceType":"Article"},"relatedIdentifiers":[],"relatedItems":[],"sizes":[],"formats":[],"version":"1","rightsList":[{"rightsIdentifierScheme":"SPDX","rightsUri":"https://creativecommons.org/licenses/by/4.0/legalcode","schemeUri":"https://spdx.org/licenses/","rights":"Creative Commons Attribution 4.0 International","rightsIdentifier":"cc-by-4.0"}],"descriptions":[{"descriptionType":"Abstract","description":"Minimizing the time required for quantum state preparation is crucial to mitigate decoherence and enable practical quantum algorithms on near-term hardware. In this work, we introduce a technique for quantum state preparation in transmon-qubit systems using optimized electromagnetic pulse sequences rather than discrete quantum gates. By directly targeting quantum correlations instead of specific target states, we identify minimal-time pulse protocols that optimize relevant entanglement resources, such as concurrence and the three-tangle for two and three qubit systems, respectively. For the figures of merit considered, this approach successfully achieves maximal entanglement in each case: Bell, GHZ and W like states. Beyond state preparation, the resource-oriented nature of the approach leads to a reduced effective expressivity of the control scheme, a feature that represents an advantage in algorithmic settings where excessive control freedom is known to hinder performance."},{"descriptionType":"Other","description":"12 pages, 21 figures"}],"geoLocations":[],"fundingReferences":[],"url":"https://arxiv.org/abs/2602.20275","contentUrl":null,"metadataVersion":0,"schemaVersion":"http://datacite.org/schema/kernel-4","source":"mds","isActive":true,"state":"findable","reason":null,"viewCount":0,"downloadCount":0,"referenceCount":0,"citationCount":0,"partCount":0,"partOfCount":0,"versionCount":0,"versionOfCount":0,"created":"2026-02-25T02:46:14Z","registered":"2026-02-25T02:46:15Z","published":null,"updated":"2026-02-25T02:46:15Z"},"relationships":{"client":{"data":{"id":"arxiv.content","type":"clients"}}}},{"id":"10.48550/arxiv.2602.20274","type":"dois","attributes":{"doi":"10.48550/arxiv.2602.20274","identifiers":[{"identifier":"2602.20274","identifierType":"arXiv"}],"creators":[{"nameType":"Personal","givenName":"Tatyana","familyName":"Barron","name":"Barron, Tatyana","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Sarah","familyName":"Lanthier","name":"Lanthier, Sarah","affiliation":[],"nameIdentifiers":[]}],"titles":[{"title":"Geometry and biological processes"}],"publisher":"arXiv","container":{},"publicationYear":2026,"subjects":[{"subject":"Differential Geometry (math.DG)","lang":"en","subjectScheme":"arXiv"},{"subject":"FOS: Mathematics","subjectScheme":"Fields of Science and Technology (FOS)"},{"schemeUri":"http://www.oecd.org/science/inno/38235147.pdf","subject":"FOS: Mathematics","subjectScheme":"Fields of Science and Technology (FOS)"}],"contributors":[],"dates":[{"date":"2026-02-23T19:01:36Z","dateType":"Submitted","dateInformation":"v1"},{"date":"2026-02-25T01:02:42Z","dateType":"Updated","dateInformation":"v1"},{"date":"2026-02","dateType":"Available","dateInformation":"v1"},{"date":"2026","dateType":"Issued"}],"language":null,"types":{"schemaOrg":"CreativeWork","resourceTypeGeneral":"Preprint","citeproc":"article","bibtex":"misc","ris":"GEN","resourceType":"Article"},"relatedIdentifiers":[],"relatedItems":[],"sizes":[],"formats":[],"version":"1","rightsList":[{"rightsUri":"http://arxiv.org/licenses/nonexclusive-distrib/1.0/","rights":"arXiv.org perpetual, non-exclusive license"}],"descriptions":[{"descriptionType":"Abstract","description":"We suggest a geometric approach to modeling biochemical processes, aiming at those processes that occur in humans with food sensitivities or chemical sensitivities."}],"geoLocations":[],"fundingReferences":[],"url":"https://arxiv.org/abs/2602.20274","contentUrl":null,"metadataVersion":0,"schemaVersion":"http://datacite.org/schema/kernel-4","source":"mds","isActive":true,"state":"findable","reason":null,"viewCount":0,"downloadCount":0,"referenceCount":0,"citationCount":0,"partCount":0,"partOfCount":0,"versionCount":0,"versionOfCount":0,"created":"2026-02-25T02:46:13Z","registered":"2026-02-25T02:46:13Z","published":null,"updated":"2026-02-25T02:46:13Z"},"relationships":{"client":{"data":{"id":"arxiv.content","type":"clients"}}}},{"id":"10.48550/arxiv.2602.20273","type":"dois","attributes":{"doi":"10.48550/arxiv.2602.20273","identifiers":[{"identifier":"2602.20273","identifierType":"arXiv"}],"creators":[{"nameType":"Personal","givenName":"Zhuofan Josh","familyName":"Ying","name":"Ying, Zhuofan Josh","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Shauli","familyName":"Ravfogel","name":"Ravfogel, Shauli","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Nikolaus","familyName":"Kriegeskorte","name":"Kriegeskorte, Nikolaus","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Peter","familyName":"Hase","name":"Hase, Peter","affiliation":[],"nameIdentifiers":[]}],"titles":[{"title":"The Truthfulness Spectrum Hypothesis"}],"publisher":"arXiv","container":{},"publicationYear":2026,"subjects":[{"subject":"Machine Learning (cs.LG)","lang":"en","subjectScheme":"arXiv"},{"subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"},{"schemeUri":"http://www.oecd.org/science/inno/38235147.pdf","subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"}],"contributors":[],"dates":[{"date":"2026-02-23T19:01:31Z","dateType":"Submitted","dateInformation":"v1"},{"date":"2026-02-25T01:02:41Z","dateType":"Updated","dateInformation":"v1"},{"date":"2026-02","dateType":"Available","dateInformation":"v1"},{"date":"2026","dateType":"Issued"}],"language":null,"types":{"schemaOrg":"CreativeWork","resourceTypeGeneral":"Preprint","citeproc":"article","bibtex":"misc","ris":"GEN","resourceType":"Article"},"relatedIdentifiers":[],"relatedItems":[],"sizes":[],"formats":[],"version":"1","rightsList":[{"rightsIdentifierScheme":"SPDX","rightsUri":"https://creativecommons.org/licenses/by/4.0/legalcode","schemeUri":"https://spdx.org/licenses/","rights":"Creative Commons Attribution 4.0 International","rightsIdentifier":"cc-by-4.0"}],"descriptions":[{"descriptionType":"Abstract","description":"Large language models (LLMs) have been reported to linearly encode truthfulness, yet recent work questions this finding's generality. We reconcile these views with the truthfulness spectrum hypothesis: the representational space contains directions ranging from broadly domain-general to narrowly domain-specific. To test this hypothesis, we systematically evaluate probe generalization across five truth types (definitional, empirical, logical, fictional, and ethical), sycophantic and expectation-inverted lying, and existing honesty benchmarks. Linear probes generalize well across most domains but fail on sycophantic and expectation-inverted lying. Yet training on all domains jointly recovers strong performance, confirming that domain-general directions exist despite poor pairwise transfer. The geometry of probe directions explains these patterns: Mahalanobis cosine similarity between probes near-perfectly predicts cross-domain generalization (R^2=0.98). Concept-erasure methods further isolate truth directions that are (1) domain-general, (2) domain-specific, or (3) shared only across particular domain subsets. Causal interventions reveal that domain-specific directions steer more effectively than domain-general ones. Finally, post-training reshapes truth geometry, pushing sycophantic lying further from other truth types, suggesting a representational basis for chat models' sycophantic tendencies. Together, our results support the truthfulness spectrum hypothesis: truth directions of varying generality coexist in representational space, with post-training reshaping their geometry. Code for all experiments is provided in https://github.com/zfying/truth_spec."},{"descriptionType":"Other","description":"28 pages, 26 figures"}],"geoLocations":[],"fundingReferences":[],"url":"https://arxiv.org/abs/2602.20273","contentUrl":null,"metadataVersion":0,"schemaVersion":"http://datacite.org/schema/kernel-4","source":"mds","isActive":true,"state":"findable","reason":null,"viewCount":0,"downloadCount":0,"referenceCount":0,"citationCount":0,"partCount":0,"partOfCount":0,"versionCount":0,"versionOfCount":0,"created":"2026-02-25T02:46:11Z","registered":"2026-02-25T02:46:12Z","published":null,"updated":"2026-02-25T02:46:12Z"},"relationships":{"client":{"data":{"id":"arxiv.content","type":"clients"}}}},{"id":"10.48550/arxiv.2602.20271","type":"dois","attributes":{"doi":"10.48550/arxiv.2602.20271","identifiers":[{"identifier":"2602.20271","identifierType":"arXiv"}],"creators":[{"nameType":"Personal","givenName":"Stefan","familyName":"Faulkner","name":"Faulkner, Stefan","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Reza","familyName":"Zandehshahvar","name":"Zandehshahvar, Reza","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Vahid Eghbal","familyName":"Akhlaghi","name":"Akhlaghi, Vahid Eghbal","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Sebastien","familyName":"Ouellet","name":"Ouellet, Sebastien","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Carsten","familyName":"Jordan","name":"Jordan, Carsten","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Pascal","familyName":"Van Hentenryck","name":"Van Hentenryck, Pascal","affiliation":[],"nameIdentifiers":[]}],"titles":[{"title":"Uncertainty-Aware Delivery Delay Duration Prediction via Multi-Task Deep Learning"}],"publisher":"arXiv","container":{},"publicationYear":2026,"subjects":[{"subject":"Machine Learning (cs.LG)","lang":"en","subjectScheme":"arXiv"},{"subject":"Artificial Intelligence (cs.AI)","lang":"en","subjectScheme":"arXiv"},{"subject":"Optimization and Control (math.OC)","lang":"en","subjectScheme":"arXiv"},{"subject":"Applications (stat.AP)","lang":"en","subjectScheme":"arXiv"},{"subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"},{"schemeUri":"http://www.oecd.org/science/inno/38235147.pdf","subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"},{"subject":"FOS: Mathematics","subjectScheme":"Fields of Science and Technology (FOS)"},{"schemeUri":"http://www.oecd.org/science/inno/38235147.pdf","subject":"FOS: Mathematics","subjectScheme":"Fields of Science and Technology (FOS)"}],"contributors":[],"dates":[{"date":"2026-02-23T19:01:03Z","dateType":"Submitted","dateInformation":"v1"},{"date":"2026-02-25T01:02:39Z","dateType":"Updated","dateInformation":"v1"},{"date":"2026-02","dateType":"Available","dateInformation":"v1"},{"date":"2026","dateType":"Issued"}],"language":null,"types":{"schemaOrg":"CreativeWork","resourceTypeGeneral":"Preprint","citeproc":"article","bibtex":"misc","ris":"GEN","resourceType":"Article"},"relatedIdentifiers":[],"relatedItems":[],"sizes":[],"formats":[],"version":"1","rightsList":[{"rightsIdentifierScheme":"SPDX","rightsUri":"https://creativecommons.org/licenses/by-nc-nd/4.0/legalcode","schemeUri":"https://spdx.org/licenses/","rights":"Creative Commons Attribution Non Commercial No Derivatives 4.0 International","rightsIdentifier":"cc-by-nc-nd-4.0"}],"descriptions":[{"descriptionType":"Abstract","description":"Accurate delivery delay prediction is critical for maintaining operational efficiency and customer satisfaction across modern supply chains. Yet the increasing complexity of logistics networks, spanning multimodal transportation, cross-country routing, and pronounced regional variability, makes this prediction task inherently challenging. This paper introduces a multi-task deep learning model for delivery delay duration prediction in the presence of significant imbalanced data, where delayed shipments are rare but operationally consequential. The model embeds high-dimensional shipment features with dedicated embedding layers for tabular data, and then uses a classification-then-regression strategy to predict the delivery delay duration for on-time and delayed shipments. Unlike sequential pipelines, this approach enables end-to-end training, improves the detection of delayed cases, and supports probabilistic forecasting for uncertainty-aware decision making. The proposed approach is evaluated on a large-scale real-world dataset from an industrial partner, comprising more than 10 million historical shipment records across four major source locations with distinct regional characteristics. The proposed model is compared with traditional machine learning methods. Experimental results show that the proposed method achieves a mean absolute error of 0.67-0.91 days for delayed-shipment predictions, outperforming single-step tree-based regression baselines by 41-64% and two-step classify-then-regress tree-based models by 15-35%. These gains demonstrate the effectiveness of the proposed model in operational delivery delay forecasting under highly imbalanced and heterogeneous conditions."}],"geoLocations":[],"fundingReferences":[],"url":"https://arxiv.org/abs/2602.20271","contentUrl":null,"metadataVersion":0,"schemaVersion":"http://datacite.org/schema/kernel-4","source":"mds","isActive":true,"state":"findable","reason":null,"viewCount":0,"downloadCount":0,"referenceCount":0,"citationCount":0,"partCount":0,"partOfCount":0,"versionCount":0,"versionOfCount":0,"created":"2026-02-25T02:46:08Z","registered":"2026-02-25T02:46:09Z","published":null,"updated":"2026-02-25T02:46:09Z"},"relationships":{"client":{"data":{"id":"arxiv.content","type":"clients"}}}},{"id":"10.48550/arxiv.2602.20269","type":"dois","attributes":{"doi":"10.48550/arxiv.2602.20269","identifiers":[{"identifier":"2602.20269","identifierType":"arXiv"}],"creators":[{"nameType":"Personal","givenName":"Mert","familyName":"Esencan","name":"Esencan, Mert","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"A. I.","familyName":"Lvovsky","name":"Lvovsky, A. I.","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Berislav","familyName":"Buča","name":"Buča, Berislav","affiliation":[],"nameIdentifiers":[]}],"titles":[{"title":"Time Crystals as Passively Protected Oscillating Qubits"}],"publisher":"arXiv","container":{},"publicationYear":2026,"subjects":[{"subject":"Quantum Physics (quant-ph)","lang":"en","subjectScheme":"arXiv"},{"subject":"FOS: Physical sciences","subjectScheme":"Fields of Science and Technology (FOS)"},{"schemeUri":"http://www.oecd.org/science/inno/38235147.pdf","subject":"FOS: Physical sciences","subjectScheme":"Fields of Science and Technology (FOS)"}],"contributors":[],"dates":[{"date":"2026-02-23T19:01:02Z","dateType":"Submitted","dateInformation":"v1"},{"date":"2026-02-25T01:02:36Z","dateType":"Updated","dateInformation":"v1"},{"date":"2026-02","dateType":"Available","dateInformation":"v1"},{"date":"2026","dateType":"Issued"}],"language":null,"types":{"schemaOrg":"CreativeWork","resourceTypeGeneral":"Preprint","citeproc":"article","bibtex":"misc","ris":"GEN","resourceType":"Article"},"relatedIdentifiers":[],"relatedItems":[],"sizes":[],"formats":[],"version":"1","rightsList":[{"rightsUri":"http://arxiv.org/licenses/nonexclusive-distrib/1.0/","rights":"arXiv.org perpetual, non-exclusive license"}],"descriptions":[{"descriptionType":"Abstract","description":"Protecting information against decoherence in open quantum systems remains a central challenge for quantum computing. In particular, passive error correction schemes have so far been limited to static memories rather than dynamical qubits. We demonstrate that a driven-dissipative bosonic system can encode a persistently oscillating qubit within a noiseless subsystem, realized explicitly in the Bose-Hubbard dimer (BHD). The strong parity symmetry of the model leads to degenerate stationary states. This symmetry is further broken into non-stationary states in the thermodynamic limit, which exhibit persistent oscillations. As the driving force increases, the Liouvillian spectrum of these states features a phase transition. Above the transition point, the non-stationary state encodes quantum information, preserving it in a noiseless subsystem. In addition to global loss that affects both bosonic modes identically, we further add global dephasing and show that the oscillating qubit is preserved. Finally, in order to gain additional physical insight, we study the effect of phase perturbation to both modes and observe that likewise they are passively protected, returning approximately to their initial configurations. These results establish dissipative time-crystalline dynamics as a mechanism for passive protection of dynamical quantum information, enabling autonomously stabilized oscillating qubits."},{"descriptionType":"Other","description":"5 pages, 5 figures. Supplemental material included"}],"geoLocations":[],"fundingReferences":[],"url":"https://arxiv.org/abs/2602.20269","contentUrl":null,"metadataVersion":0,"schemaVersion":"http://datacite.org/schema/kernel-4","source":"mds","isActive":true,"state":"findable","reason":null,"viewCount":0,"downloadCount":0,"referenceCount":0,"citationCount":0,"partCount":0,"partOfCount":0,"versionCount":0,"versionOfCount":0,"created":"2026-02-25T02:46:05Z","registered":"2026-02-25T02:46:06Z","published":null,"updated":"2026-02-25T02:46:06Z"},"relationships":{"client":{"data":{"id":"arxiv.content","type":"clients"}}}},{"id":"10.48550/arxiv.2602.20263","type":"dois","attributes":{"doi":"10.48550/arxiv.2602.20263","identifiers":[{"identifier":"2602.20263","identifierType":"arXiv"}],"creators":[{"nameType":"Personal","givenName":"Raymond","familyName":"Cheng","name":"Cheng, Raymond","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Noah","familyName":"Olander","name":"Olander, Noah","affiliation":[],"nameIdentifiers":[]}],"titles":[{"title":"Derived categories of quadric bundles and moduli stacks of spinor sheaves"}],"publisher":"arXiv","container":{},"publicationYear":2026,"subjects":[{"subject":"Algebraic Geometry (math.AG)","lang":"en","subjectScheme":"arXiv"},{"subject":"FOS: Mathematics","subjectScheme":"Fields of Science and Technology (FOS)"},{"schemeUri":"http://www.oecd.org/science/inno/38235147.pdf","subject":"FOS: Mathematics","subjectScheme":"Fields of Science and Technology (FOS)"},{"subject":"14F08, 14D23 (primary), 14F22, 14D10 (secondary)","lang":"en","subjectScheme":"MSC"}],"contributors":[],"dates":[{"date":"2026-02-23T19:00:07Z","dateType":"Submitted","dateInformation":"v1"},{"date":"2026-02-25T01:02:22Z","dateType":"Updated","dateInformation":"v1"},{"date":"2026-02","dateType":"Available","dateInformation":"v1"},{"date":"2026","dateType":"Issued"}],"language":null,"types":{"schemaOrg":"CreativeWork","resourceTypeGeneral":"Preprint","citeproc":"article","bibtex":"misc","ris":"GEN","resourceType":"Article"},"relatedIdentifiers":[],"relatedItems":[],"sizes":[],"formats":[],"version":"1","rightsList":[{"rightsIdentifierScheme":"SPDX","rightsUri":"https://creativecommons.org/licenses/by/4.0/legalcode","schemeUri":"https://spdx.org/licenses/","rights":"Creative Commons Attribution 4.0 International","rightsIdentifier":"cc-by-4.0"}],"descriptions":[{"descriptionType":"Abstract","description":"We prove that the Kuznetsov component of a flat family of even-dimensional quadrics of corank at most 2 is equivalent to the twisted derived category of an algebraic space whenever: (i) the open subset of the base over which the quadrics has corank at most 1 is scheme-theoretically dense; and (ii) a certain étale double cover of the closed complement admits a section. This provides the first general geometricity result for Kuznetsov components of higher dimensional quadrics, thereby generalizing works of Kapranov, Bondal, Orlov, Kuznetsov, Moschetti, Xie, and others. Our main tool is the moduli stack of spinor sheaves on a family of quadrics, which we define and study in detail. In the situation of our main result, we produce an open substack which is a $\\mathbf{G}_m$-gerbe, and show that the associated twisted derived category is equivalent to the Kuznetsov component of the family of quadrics, thereby providing a geometric interpretation of the Brauer classes appearing in previous works."},{"descriptionType":"Other","description":"66 pages, comments very welcome!"}],"geoLocations":[],"fundingReferences":[],"url":"https://arxiv.org/abs/2602.20263","contentUrl":null,"metadataVersion":0,"schemaVersion":"http://datacite.org/schema/kernel-4","source":"mds","isActive":true,"state":"findable","reason":null,"viewCount":0,"downloadCount":0,"referenceCount":0,"citationCount":0,"partCount":0,"partOfCount":0,"versionCount":0,"versionOfCount":0,"created":"2026-02-25T02:45:57Z","registered":"2026-02-25T02:45:57Z","published":null,"updated":"2026-02-25T02:45:57Z"},"relationships":{"client":{"data":{"id":"arxiv.content","type":"clients"}}}},{"id":"10.48550/arxiv.2602.20260","type":"dois","attributes":{"doi":"10.48550/arxiv.2602.20260","identifiers":[{"identifier":"2602.20260","identifierType":"arXiv"}],"creators":[{"nameType":"Personal","givenName":"Xiaofei","familyName":"Huang","name":"Huang, Xiaofei","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Xiaolin","familyName":"Ma","name":"Ma, Xiaolin","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Zitong","familyName":"Xu","name":"Xu, Zitong","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Itay M.","familyName":"Bloch","name":"Bloch, Itay M.","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Kai","familyName":"Wei","name":"Wei, Kai","affiliation":[],"nameIdentifiers":[]}],"titles":[{"title":"Earth Matter Enhanced Axion Dark Matter Search"}],"publisher":"arXiv","container":{},"publicationYear":2026,"subjects":[{"subject":"High Energy Physics - Phenomenology (hep-ph)","lang":"en","subjectScheme":"arXiv"},{"subject":"High Energy Physics - Experiment (hep-ex)","lang":"en","subjectScheme":"arXiv"},{"subject":"Atomic Physics (physics.atom-ph)","lang":"en","subjectScheme":"arXiv"},{"subject":"FOS: Physical sciences","subjectScheme":"Fields of Science and Technology (FOS)"},{"schemeUri":"http://www.oecd.org/science/inno/38235147.pdf","subject":"FOS: Physical sciences","subjectScheme":"Fields of Science and Technology (FOS)"}],"contributors":[],"dates":[{"date":"2026-02-23T19:00:06Z","dateType":"Submitted","dateInformation":"v1"},{"date":"2026-02-25T01:02:18Z","dateType":"Updated","dateInformation":"v1"},{"date":"2026-02","dateType":"Available","dateInformation":"v1"},{"date":"2026","dateType":"Issued"}],"language":null,"types":{"schemaOrg":"CreativeWork","resourceTypeGeneral":"Preprint","citeproc":"article","bibtex":"misc","ris":"GEN","resourceType":"Article"},"relatedIdentifiers":[],"relatedItems":[],"sizes":[],"formats":[],"version":"1","rightsList":[{"rightsUri":"http://arxiv.org/licenses/nonexclusive-distrib/1.0/","rights":"arXiv.org perpetual, non-exclusive license"}],"descriptions":[{"descriptionType":"Abstract","description":"Laboratory searches for ultralight axion dark matter (DM) have traditionally assumed the terrestrial density of axions is equal to the average density of DM in the solar system. However, quadratic couplings to matter introduce a non-trivial field profile near the Earth. In this work, we present the first dedicated experimental implementation of this environment-aware axion DM wind search framework. Leveraging the extreme sensitivity of a K--Rb--$^{21}$Ne comagnetometer to pseudo-magnetic fields induced by axion DM, we analyzed our data in the context of the massively enhanced local gradient of axions due to interactions with matter, though no signal candidates were found. Consequently, we have set the most stringent limits on axion-neutron derivative interactions for masses $m_a \\in [0.041, ~28.9]~\\rm feV$, improving from previous experiments that ignore terrestrial matter effects by as much as three orders of magnitude for certain masses. Our work highlights the necessity of accounting for environmental modifications in precision frontier experiments and demonstrates how geophysical variations can be harnessed to act as a natural amplifier for DM possibly enabling future detection in parts of the parameter space that were previously beyond reach."},{"descriptionType":"Other","description":"19 pages, 10 figures"}],"geoLocations":[],"fundingReferences":[],"url":"https://arxiv.org/abs/2602.20260","contentUrl":null,"metadataVersion":0,"schemaVersion":"http://datacite.org/schema/kernel-4","source":"mds","isActive":true,"state":"findable","reason":null,"viewCount":0,"downloadCount":0,"referenceCount":0,"citationCount":0,"partCount":0,"partOfCount":0,"versionCount":0,"versionOfCount":0,"created":"2026-02-25T02:45:52Z","registered":"2026-02-25T02:45:53Z","published":null,"updated":"2026-02-25T02:45:53Z"},"relationships":{"client":{"data":{"id":"arxiv.content","type":"clients"}}}},{"id":"10.48550/arxiv.2602.20259","type":"dois","attributes":{"doi":"10.48550/arxiv.2602.20259","identifiers":[{"identifier":"2602.20259","identifierType":"arXiv"}],"creators":[{"nameType":"Personal","givenName":"Anish","familyName":"Chaudhuri","name":"Chaudhuri, Anish","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Lokrshi Prawar","familyName":"Dadhichi","name":"Dadhichi, Lokrshi Prawar","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Arijit","familyName":"Haldar","name":"Haldar, Arijit","affiliation":[],"nameIdentifiers":[]}],"titles":[{"title":"Breakdown and Restoration of Hydrodynamics in Dipole-conserving Active Fluids"}],"publisher":"arXiv","container":{},"publicationYear":2026,"subjects":[{"subject":"Soft Condensed Matter (cond-mat.soft)","lang":"en","subjectScheme":"arXiv"},{"subject":"Statistical Mechanics (cond-mat.stat-mech)","lang":"en","subjectScheme":"arXiv"},{"subject":"FOS: Physical sciences","subjectScheme":"Fields of Science and Technology (FOS)"},{"schemeUri":"http://www.oecd.org/science/inno/38235147.pdf","subject":"FOS: Physical sciences","subjectScheme":"Fields of Science and Technology (FOS)"}],"contributors":[],"dates":[{"date":"2026-02-23T19:00:06Z","dateType":"Submitted","dateInformation":"v1"},{"date":"2026-02-25T01:02:17Z","dateType":"Updated","dateInformation":"v1"},{"date":"2026-02","dateType":"Available","dateInformation":"v1"},{"date":"2026","dateType":"Issued"}],"language":null,"types":{"schemaOrg":"CreativeWork","resourceTypeGeneral":"Preprint","citeproc":"article","bibtex":"misc","ris":"GEN","resourceType":"Article"},"relatedIdentifiers":[],"relatedItems":[],"sizes":[],"formats":[],"version":"1","rightsList":[{"rightsUri":"http://arxiv.org/licenses/nonexclusive-distrib/1.0/","rights":"arXiv.org perpetual, non-exclusive license"}],"descriptions":[{"descriptionType":"Abstract","description":"We present a general hydrodynamic theory for active fluids, capable of describing living matter, that conserve center of mass or dipole moment. Imposition of dipole or center-of-mass conservation has been reported to yield peculiar behavior: breaking Galilean invariance in classical systems and potentially enabling exotic immobile excitations in quantum settings. In passive fluids, dipole conservation has been shown to cause a breakdown of linear hydrodynamics in all experimentally relevant dimensions. We show that introducing activity changes this picture: it can either restore or break linear hydrodynamics depending on spatial dimensions. Using our formulation, we predict universal dynamical scaling exponents for single-component active fluids in $d=1,2,3$ dimensions and find agreement with microscopic lattice-field simulations. Strikingly, for $d\\geq 2$, activity revives linear hydrodynamics, while for $d\u0026lt;2$ it leads to a breakdown; both cases flow to previously unexplored universality classes. Our results suggest that dipole-conserving active fluids are far more experimentally accessible than their passive counterparts."},{"descriptionType":"Other","description":"17 pages, 2 figures, 2 tables, main text 6 pages"}],"geoLocations":[],"fundingReferences":[],"url":"https://arxiv.org/abs/2602.20259","contentUrl":null,"metadataVersion":0,"schemaVersion":"http://datacite.org/schema/kernel-4","source":"mds","isActive":true,"state":"findable","reason":null,"viewCount":0,"downloadCount":0,"referenceCount":0,"citationCount":0,"partCount":0,"partOfCount":0,"versionCount":0,"versionOfCount":0,"created":"2026-02-25T02:45:51Z","registered":"2026-02-25T02:45:51Z","published":null,"updated":"2026-02-25T02:45:51Z"},"relationships":{"client":{"data":{"id":"arxiv.content","type":"clients"}}}},{"id":"10.48550/arxiv.2602.20258","type":"dois","attributes":{"doi":"10.48550/arxiv.2602.20258","identifiers":[{"identifier":"2602.20258","identifierType":"arXiv"}],"creators":[{"nameType":"Personal","givenName":"Bojun","familyName":"Tao","name":"Tao, Bojun","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Hong-Xin","familyName":"Zhang","name":"Zhang, Hong-Xin","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Wenting","familyName":"Wang","name":"Wang, Wenting","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Enci","familyName":"Wang","name":"Wang, Enci","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Guangwen","familyName":"Chen","name":"Chen, Guangwen","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Huiyuan","familyName":"Wang","name":"Wang, Huiyuan","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Lijun","familyName":"Chen","name":"Chen, Lijun","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Qian-Hui","familyName":"Chen","name":"Chen, Qian-Hui","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Song","familyName":"Huang","name":"Huang, Song","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Xu","familyName":"Kong","name":"Kong, Xu","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Yu","familyName":"Rong","name":"Rong, Yu","affiliation":[],"nameIdentifiers":[]}],"titles":[{"title":"The First Systematic Survey of Stellar Halos in High-Inclination Galaxies Reveals Unusually Quiescent Merger Histories of Nearby Galaxies"}],"publisher":"arXiv","container":{},"publicationYear":2026,"subjects":[{"subject":"Astrophysics of Galaxies (astro-ph.GA)","lang":"en","subjectScheme":"arXiv"},{"subject":"Cosmology and Nongalactic Astrophysics (astro-ph.CO)","lang":"en","subjectScheme":"arXiv"},{"subject":"FOS: Physical sciences","subjectScheme":"Fields of Science and Technology (FOS)"},{"schemeUri":"http://www.oecd.org/science/inno/38235147.pdf","subject":"FOS: Physical sciences","subjectScheme":"Fields of Science and Technology (FOS)"}],"contributors":[],"dates":[{"date":"2026-02-23T19:00:06Z","dateType":"Submitted","dateInformation":"v1"},{"date":"2026-02-25T01:02:16Z","dateType":"Updated","dateInformation":"v1"},{"date":"2026-02","dateType":"Available","dateInformation":"v1"},{"date":"2026","dateType":"Issued"}],"language":null,"types":{"schemaOrg":"CreativeWork","resourceTypeGeneral":"Preprint","citeproc":"article","bibtex":"misc","ris":"GEN","resourceType":"Article"},"relatedIdentifiers":[],"relatedItems":[],"sizes":[],"formats":[],"version":"1","rightsList":[{"rightsUri":"http://arxiv.org/licenses/nonexclusive-distrib/1.0/","rights":"arXiv.org perpetual, non-exclusive license"}],"descriptions":[{"descriptionType":"Abstract","description":"Stellar halos are the only major stellar component of disk galaxies that lack systematic observational characterization, yet they encode critical information about galaxy merger histories. We present the first systematic census of stellar halos in a large, flux-limited sample of 169 high-inclination central galaxies with stellar masses 7.3 \u0026lt;= log Mstar/Msun \u0026lt;= 11.0 and redshift z \u0026lt; 0.1, using HSC-SSP Deep optical images. Stellar halos are detected in 93 galaxies, primarily through their low isophotal ellipticities in the outskirts, improving upon conventional methods of stellar halo identification. The halo detection rate reaches ~ 50% at log Mstar/Msun \u0026gt; 9.9 and \u0026gt;= 70% for Milky Way (MW)-mass galaxies. We derive halo surface brightness profiles, colors, and masses, finding that stellar halos generally follow power-law radial profiles. Higher-mass galaxies, on average, exhibit smaller power-law indices and larger halo mass fractions, indicating more extended halos and more active merger histories. A significant stellar halo color-mass correlation, driven mainly by the mass-metallicity relation, suggests dominance by a few massive accretion events. MW-mass galaxies have a median stellar halo fraction of 10% +/- 5%. Among nearby galaxies with halo measurements within 25 Mpc, two thirds (including the MW) lie below the mean stellar halo fraction-galaxy mass relation. Overall, the nearby galaxies show a median halo deficit of ~ 0.3 dex, implying unusually quiescent merger histories. We show that this deficit follows a broader trend in which typical halo fractions increase with heliocentric distance, tracking the gradual rise in matter density toward the cosmic average by z \u0026lt;= 0.07."},{"descriptionType":"Other","description":"31 pages, 15 figures. Accepted for publication in ApJS"}],"geoLocations":[],"fundingReferences":[],"url":"https://arxiv.org/abs/2602.20258","contentUrl":null,"metadataVersion":0,"schemaVersion":"http://datacite.org/schema/kernel-4","source":"mds","isActive":true,"state":"findable","reason":null,"viewCount":0,"downloadCount":0,"referenceCount":0,"citationCount":0,"partCount":0,"partOfCount":0,"versionCount":0,"versionOfCount":0,"created":"2026-02-25T02:45:49Z","registered":"2026-02-25T02:45:50Z","published":null,"updated":"2026-02-25T02:45:50Z"},"relationships":{"client":{"data":{"id":"arxiv.content","type":"clients"}}}},{"id":"10.48550/arxiv.2602.20255","type":"dois","attributes":{"doi":"10.48550/arxiv.2602.20255","identifiers":[{"identifier":"2602.20255","identifierType":"arXiv"}],"creators":[{"nameType":"Personal","givenName":"Gonzalo","familyName":"Herrera","name":"Herrera, Gonzalo","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Abraham","familyName":"Loeb","name":"Loeb, Abraham","affiliation":[],"nameIdentifiers":[]}],"titles":[{"title":"Electromagnetic Radiation from Cosmic-Ray Scatterings on Relic Neutrinos"}],"publisher":"arXiv","container":{},"publicationYear":2026,"subjects":[{"subject":"High Energy Physics - Phenomenology (hep-ph)","lang":"en","subjectScheme":"arXiv"},{"subject":"Cosmology and Nongalactic Astrophysics (astro-ph.CO)","lang":"en","subjectScheme":"arXiv"},{"subject":"High Energy Astrophysical Phenomena (astro-ph.HE)","lang":"en","subjectScheme":"arXiv"},{"subject":"FOS: Physical sciences","subjectScheme":"Fields of Science and Technology (FOS)"},{"schemeUri":"http://www.oecd.org/science/inno/38235147.pdf","subject":"FOS: Physical sciences","subjectScheme":"Fields of Science and Technology (FOS)"}],"contributors":[],"dates":[{"date":"2026-02-23T19:00:05Z","dateType":"Submitted","dateInformation":"v1"},{"date":"2026-02-25T01:02:11Z","dateType":"Updated","dateInformation":"v1"},{"date":"2026-02","dateType":"Available","dateInformation":"v1"},{"date":"2026","dateType":"Issued"}],"language":null,"types":{"schemaOrg":"CreativeWork","resourceTypeGeneral":"Preprint","citeproc":"article","bibtex":"misc","ris":"GEN","resourceType":"Article"},"relatedIdentifiers":[],"relatedItems":[],"sizes":[],"formats":[],"version":"1","rightsList":[{"rightsIdentifierScheme":"SPDX","rightsUri":"https://creativecommons.org/licenses/by/4.0/legalcode","schemeUri":"https://spdx.org/licenses/","rights":"Creative Commons Attribution 4.0 International","rightsIdentifier":"cc-by-4.0"}],"descriptions":[{"descriptionType":"Abstract","description":"Cosmic-ray scatterings on the cosmic neutrino background induce a flux of gamma-rays and X-rays from boosted meson decays and charged lepton processes. Here we present the first estimate of this flux and its cumulative cosmological contribution. Confronting expectations with Fermi-LAT diffuse gamma-ray data, we find a limit on the cosmic neutrino background overdensity at the level of $η\\lesssim 2 \\times 10^{4}$ for a lightest neutrino mass of $m_ν\\gtrsim0.1$ eV, orders of magnitude stronger than current direct laboratory probes, and comparable to constraints on the cosmic neutrino background obtained with IceCube. We further show that X-ray synchrotron emission from cascade electron-positron pairs in intergalactic magnetic fields provides a complementary, albeit weaker, constraint. We discuss how anisotropic signatures and future gamma-ray data from CTA could further improve bounds on the relic neutrino overdensity, approaching in sensitivity the $Λ$CDM expected density."},{"descriptionType":"Other","description":"10 pages, 5 figures"}],"geoLocations":[],"fundingReferences":[],"url":"https://arxiv.org/abs/2602.20255","contentUrl":null,"metadataVersion":0,"schemaVersion":"http://datacite.org/schema/kernel-4","source":"mds","isActive":true,"state":"findable","reason":null,"viewCount":0,"downloadCount":0,"referenceCount":0,"citationCount":0,"partCount":0,"partOfCount":0,"versionCount":0,"versionOfCount":0,"created":"2026-02-25T02:45:45Z","registered":"2026-02-25T02:45:45Z","published":null,"updated":"2026-02-25T02:45:45Z"},"relationships":{"client":{"data":{"id":"arxiv.content","type":"clients"}}}},{"id":"10.48550/arxiv.2602.20245","type":"dois","attributes":{"doi":"10.48550/arxiv.2602.20245","identifiers":[{"identifier":"2602.20245","identifierType":"arXiv"}],"creators":[{"nameType":"Personal","givenName":"Nicolas","familyName":"Esser","name":"Esser, Nicolas","affiliation":[],"nameIdentifiers":[]}],"titles":[{"title":"Dynamical friction on binary stars in dark matter dominated environments"}],"publisher":"arXiv","container":{},"publicationYear":2026,"subjects":[{"subject":"Astrophysics of Galaxies (astro-ph.GA)","lang":"en","subjectScheme":"arXiv"},{"subject":"FOS: Physical sciences","subjectScheme":"Fields of Science and Technology (FOS)"},{"schemeUri":"http://www.oecd.org/science/inno/38235147.pdf","subject":"FOS: Physical sciences","subjectScheme":"Fields of Science and Technology (FOS)"}],"contributors":[],"dates":[{"date":"2026-02-23T19:00:01Z","dateType":"Submitted","dateInformation":"v1"},{"date":"2026-02-25T01:02:01Z","dateType":"Updated","dateInformation":"v1"},{"date":"2026-02","dateType":"Available","dateInformation":"v1"},{"date":"2026","dateType":"Issued"}],"language":null,"types":{"schemaOrg":"CreativeWork","resourceTypeGeneral":"Preprint","citeproc":"article","bibtex":"misc","ris":"GEN","resourceType":"Article"},"relatedIdentifiers":[],"relatedItems":[],"sizes":[],"formats":[],"version":"1","rightsList":[{"rightsIdentifierScheme":"SPDX","rightsUri":"https://creativecommons.org/licenses/by/4.0/legalcode","schemeUri":"https://spdx.org/licenses/","rights":"Creative Commons Attribution 4.0 International","rightsIdentifier":"cc-by-4.0"}],"descriptions":[{"descriptionType":"Abstract","description":"We study binary stars moving through a uniform dark matter background and experiencing dynamical friction. The centre-of-mass motion of the pairs is taken into account. We derive formulas and timescales for the secular evolution of the orbital parameters for both wide and close binaries. We apply these results to environments typical of dark matter dominated ultra-faint dwarf galaxies and show that some binaries undergo significant eccentricity oscillations, while their semi-major axes decrease more gradually. We consider a simple binary star population and find that dynamical friction, notably, can enhance the bias from unresolved binaries in velocity dispersion measurements. With future, more detailed theoretical studies and improving observational capabilities, binary stars may serve as a tool to probe the dark matter content of some of the faintest galaxies."},{"descriptionType":"Other","description":"7+2 pages"}],"geoLocations":[],"fundingReferences":[],"url":"https://arxiv.org/abs/2602.20245","contentUrl":null,"metadataVersion":0,"schemaVersion":"http://datacite.org/schema/kernel-4","source":"mds","isActive":true,"state":"findable","reason":null,"viewCount":0,"downloadCount":0,"referenceCount":0,"citationCount":0,"partCount":0,"partOfCount":0,"versionCount":0,"versionOfCount":0,"created":"2026-02-25T02:45:30Z","registered":"2026-02-25T02:45:31Z","published":null,"updated":"2026-02-25T02:45:31Z"},"relationships":{"client":{"data":{"id":"arxiv.content","type":"clients"}}}},{"id":"10.48550/arxiv.2602.20241","type":"dois","attributes":{"doi":"10.48550/arxiv.2602.20241","identifiers":[{"identifier":"2602.20241","identifierType":"arXiv"}],"creators":[{"nameType":"Personal","givenName":"Wuji","familyName":"Wang","name":"Wang, Wuji","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Andreas L.","familyName":"Faisst","name":"Faisst, Andreas L.","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Kyle","familyName":"Finner","name":"Finner, Kyle","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Livia","familyName":"Vallini","name":"Vallini, Livia","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Andrea","familyName":"Pallottini","name":"Pallottini, Andrea","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Enrico","familyName":"Veraldi","name":"Veraldi, Enrico","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Bahram","familyName":"Mobasher","name":"Mobasher, Bahram","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Yu-Heng","familyName":"Lin","name":"Lin, Yu-Heng","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Giovanni","familyName":"Zamorani","name":"Zamorani, Giovanni","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Vicente","familyName":"Villanueva","name":"Villanueva, Vicente","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Sylvain","familyName":"Veilleux","name":"Veilleux, Sylvain","affiliation":[],"name