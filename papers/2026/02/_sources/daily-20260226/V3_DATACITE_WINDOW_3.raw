nameType":"Personal","givenName":"Yue","familyName":"Hu","name":"Hu, Yue","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Janik","familyName":"Karoly","name":"Karoly, Janik","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Ralf S.","familyName":"Klessen","name":"Klessen, Ralf S.","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Mark R.","familyName":"Krumholz","name":"Krumholz, Mark R.","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Xunchuan","familyName":"Liu","name":"Liu, Xunchuan","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Farideh","familyName":"Mazoochi","name":"Mazoochi, Farideh","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Francisco","familyName":"Nogueras-Lara","name":"Nogueras-Lara, Francisco","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Dylan","familyName":"Pare","name":"Pare, Dylan","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Denise","familyName":"Riquelme-Vasquez","name":"Riquelme-Vasquez, Denise","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Victor M.","familyName":"Rivilla","name":"Rivilla, Victor M.","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Miriam G.","familyName":"Santa-Maria","name":"Santa-Maria, Miriam G.","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Anika","familyName":"Schmiedeke","name":"Schmiedeke, Anika","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Yoshiaki","familyName":"Sofue","name":"Sofue, Yoshiaki","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Volker","familyName":"Tolls","name":"Tolls, Volker","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Q. Daniel","familyName":"Wang","name":"Wang, Q. Daniel","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Gwenllian M.","familyName":"Williams","name":"Williams, Gwenllian M.","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Fengwei","familyName":"Xu","name":"Xu, Fengwei","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Suinan","familyName":"Zhang","name":"Zhang, Suinan","affiliation":[],"nameIdentifiers":[]}],"titles":[{"title":"ALMA Central Molecular Zone Exploration Survey (ACES)-IV. Data of the two intermediate-width spectral windows"}],"publisher":"arXiv","container":{},"publicationYear":2026,"subjects":[{"subject":"Astrophysics of Galaxies (astro-ph.GA)","lang":"en","subjectScheme":"arXiv"},{"subject":"FOS: Physical sciences","subjectScheme":"Fields of Science and Technology (FOS)"},{"schemeUri":"http://www.oecd.org/science/inno/38235147.pdf","subject":"FOS: Physical sciences","subjectScheme":"Fields of Science and Technology (FOS)"}],"contributors":[],"dates":[{"date":"2026-02-24T01:15:03Z","dateType":"Submitted","dateInformation":"v1"},{"date":"2026-02-25T01:13:57Z","dateType":"Updated","dateInformation":"v1"},{"date":"2026-02","dateType":"Available","dateInformation":"v1"},{"date":"2026","dateType":"Issued"}],"language":null,"types":{"schemaOrg":"CreativeWork","resourceTypeGeneral":"Preprint","citeproc":"article","bibtex":"misc","ris":"GEN","resourceType":"Article"},"relatedIdentifiers":[],"relatedItems":[],"sizes":[],"formats":[],"version":"1","rightsList":[{"rightsIdentifierScheme":"SPDX","rightsUri":"https://creativecommons.org/licenses/by/4.0/legalcode","schemeUri":"https://spdx.org/licenses/","rights":"Creative Commons Attribution 4.0 International","rightsIdentifier":"cc-by-4.0"}],"descriptions":[{"descriptionType":"Abstract","description":"We release the intermediate-width spectral window data from the ALMA Central Molecular Zone Exploration Survey (ACES) Large Program, which covers SiO(2-1), SO(2_2-1_1), H13CO+(1-0), H13CN(1-0), HN13C(1-0), and HC15N (1-0), among other molecular line transitions, with an angular resolution of ~2 arcsec and a velocity resolution of 1.7 km s-1 . The full cubes of the two spectral windows as well as the key data products will be available to the community. We also present the integrated brightness, peak brightness, centroid velocity, and Galactic longitude-velocity maps of the six lines. We briefly discuss morphological correlations between the continuum and the molecular line emission, and brightness ratios between pairs of isotopologue or isotopomer lines. We highlight features and trends in the data that will be followed up in upcoming ACES science papers."},{"descriptionType":"Other","description":"Accepted to MNRAS. High-resolution figures will be available in the journal paper. Website is https://sites.google.com/view/aces-cmz/home and data release is linked from there. Pipeline code is at https://github.com/ACES-CMZ/reduction_ACES/releases/tag/2026-02-18"}],"geoLocations":[],"fundingReferences":[],"url":"https://arxiv.org/abs/2602.20445","contentUrl":null,"metadataVersion":0,"schemaVersion":"http://datacite.org/schema/kernel-4","source":"mds","isActive":true,"state":"findable","reason":null,"viewCount":0,"downloadCount":0,"referenceCount":0,"citationCount":0,"partCount":0,"partOfCount":0,"versionCount":0,"versionOfCount":0,"created":"2026-02-25T02:50:16Z","registered":"2026-02-25T02:50:17Z","published":null,"updated":"2026-02-25T02:50:17Z"},"relationships":{"client":{"data":{"id":"arxiv.content","type":"clients"}}}},{"id":"10.48550/arxiv.2602.20444","type":"dois","attributes":{"doi":"10.48550/arxiv.2602.20444","identifiers":[{"identifier":"2602.20444","identifierType":"arXiv"}],"creators":[{"nameType":"Personal","givenName":"Paul","familyName":"Borrill","name":"Borrill, Paul","affiliation":[],"nameIdentifiers":[]}],"titles":[{"title":"Circumventing the FLP Impossibility Result with Open Atomic Ethernet"}],"publisher":"arXiv","container":{},"publicationYear":2026,"subjects":[{"subject":"Distributed, Parallel, and Cluster Computing (cs.DC)","lang":"en","subjectScheme":"arXiv"},{"subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"},{"schemeUri":"http://www.oecd.org/science/inno/38235147.pdf","subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"}],"contributors":[],"dates":[{"date":"2026-02-24T01:05:44Z","dateType":"Submitted","dateInformation":"v1"},{"date":"2026-02-25T01:13:50Z","dateType":"Updated","dateInformation":"v1"},{"date":"2026-02","dateType":"Available","dateInformation":"v1"},{"date":"2026","dateType":"Issued"}],"language":null,"types":{"schemaOrg":"CreativeWork","resourceTypeGeneral":"Preprint","citeproc":"article","bibtex":"misc","ris":"GEN","resourceType":"Article"},"relatedIdentifiers":[],"relatedItems":[],"sizes":[],"formats":[],"version":"1","rightsList":[{"rightsIdentifierScheme":"SPDX","rightsUri":"https://creativecommons.org/licenses/by/4.0/legalcode","schemeUri":"https://spdx.org/licenses/","rights":"Creative Commons Attribution 4.0 International","rightsIdentifier":"cc-by-4.0"}],"descriptions":[{"descriptionType":"Abstract","description":"The Fischer--Lynch--Paterson (FLP) impossibility result is widely regarded as one of the most fundamental negative results in distributed computing: no deterministic protocol can guarantee consensus in an asynchronous system with even one faulty process. For forty years, the field has treated this as an immovable constraint, designing around it with randomized protocols, failure detectors, and weakened consistency models. This essay argues that FLP is not a law of physics but a theorem about a particular system model -- and that Open Atomic Ethernet (OAE) circumvents it by rejecting the asynchronous model at its foundation. We introduce the term bisynchronous to describe OAE's key property: bounded-time bilateral resolution in which both parties reach common knowledge of outcome at every round boundary -- a strictly stronger guarantee than synchrony alone. By constructing a bisynchronous, swap-based protocol at Layer 2, OAE sidesteps the load-bearing assumptions of FLP's asynchronous model, achieving deterministic atomic coordination without violating any impossibility result."},{"descriptionType":"Other","description":"12 pages, 3 figures, 1 table"}],"geoLocations":[],"fundingReferences":[],"url":"https://arxiv.org/abs/2602.20444","contentUrl":null,"metadataVersion":0,"schemaVersion":"http://datacite.org/schema/kernel-4","source":"mds","isActive":true,"state":"findable","reason":null,"viewCount":0,"downloadCount":0,"referenceCount":0,"citationCount":0,"partCount":0,"partOfCount":0,"versionCount":0,"versionOfCount":0,"created":"2026-02-25T02:50:15Z","registered":"2026-02-25T02:50:15Z","published":null,"updated":"2026-02-25T02:50:15Z"},"relationships":{"client":{"data":{"id":"arxiv.content","type":"clients"}}}},{"id":"10.48550/arxiv.2602.20443","type":"dois","attributes":{"doi":"10.48550/arxiv.2602.20443","identifiers":[{"identifier":"2602.20443","identifierType":"arXiv"}],"creators":[{"nameType":"Personal","givenName":"Vineet","familyName":"Dawara","name":"Dawara, Vineet","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Koushik","familyName":"Viswanathan","name":"Viswanathan, Koushik","affiliation":[],"nameIdentifiers":[]}],"titles":[{"title":"Dynamic fragmentation of residually stressed solids: From microscopic instabilities to universal scaling"}],"publisher":"arXiv","container":{},"publicationYear":2026,"subjects":[{"subject":"Soft Condensed Matter (cond-mat.soft)","lang":"en","subjectScheme":"arXiv"},{"subject":"Mesoscale and Nanoscale Physics (cond-mat.mes-hall)","lang":"en","subjectScheme":"arXiv"},{"subject":"FOS: Physical sciences","subjectScheme":"Fields of Science and Technology (FOS)"},{"schemeUri":"http://www.oecd.org/science/inno/38235147.pdf","subject":"FOS: Physical sciences","subjectScheme":"Fields of Science and Technology (FOS)"}],"contributors":[],"dates":[{"date":"2026-02-24T01:04:11Z","dateType":"Submitted","dateInformation":"v1"},{"date":"2026-02-25T01:13:48Z","dateType":"Updated","dateInformation":"v1"},{"date":"2026-02","dateType":"Available","dateInformation":"v1"},{"date":"2026","dateType":"Issued"}],"language":null,"types":{"schemaOrg":"CreativeWork","resourceTypeGeneral":"Preprint","citeproc":"article","bibtex":"misc","ris":"GEN","resourceType":"Article"},"relatedIdentifiers":[],"relatedItems":[],"sizes":[],"formats":[],"version":"1","rightsList":[{"rightsIdentifierScheme":"SPDX","rightsUri":"https://creativecommons.org/licenses/by/4.0/legalcode","schemeUri":"https://spdx.org/licenses/","rights":"Creative Commons Attribution 4.0 International","rightsIdentifier":"cc-by-4.0"}],"descriptions":[{"descriptionType":"Abstract","description":"The dynamic fragmentation of residually stressed solids involves a complex interplay between stored elastic energy, stress wave propagation, and crack instabilities. In this work, we investigate the fracture mechanics of chemically toughened glass through high-velocity projectile impact experiments and a novel micromechanical network model. We rigorously incorporate residual stress into the discrete lattice framework via a prescribed inelastic strain (eigenstrain) distribution, formulated as equivalent body and surface forces to ensure mesh-independent fracture paths. Our experiments and simulations demonstrate that while the fracture topology shifts from coarse to fine with increasing impact energy, the cumulative fragment size distribution consistently follows an exponential decay. Crucially, we reveal a universal scaling law: fragment size distributions from diverse loading conditions and stress profiles collapse onto a single master curve when normalized by the mean fragment area. Furthermore, the model elucidates the determinants of fragmentation, showing that the resulting fragment size is governed not only by the magnitude of residual stress but also by the steepness of the stress gradient. At the microscopic scale, we identify a mechanism for dynamic instability where non-sequential bond breaking ahead of the crack tip leads to apparent local crack speeds exceeding the Rayleigh wave speed ($c_r$). These arrested micro-branches, analogous to the Burridge-Andrews mechanism, provide a physical explanation for the \"tongue-like\" features and hackle zones observed in post-mortem fractography."}],"geoLocations":[],"fundingReferences":[],"url":"https://arxiv.org/abs/2602.20443","contentUrl":null,"metadataVersion":0,"schemaVersion":"http://datacite.org/schema/kernel-4","source":"mds","isActive":true,"state":"findable","reason":null,"viewCount":0,"downloadCount":0,"referenceCount":0,"citationCount":0,"partCount":0,"partOfCount":0,"versionCount":0,"versionOfCount":0,"created":"2026-02-25T02:50:13Z","registered":"2026-02-25T02:50:14Z","published":null,"updated":"2026-02-25T02:50:14Z"},"relationships":{"client":{"data":{"id":"arxiv.content","type":"clients"}}}},{"id":"10.48550/arxiv.2602.20442","type":"dois","attributes":{"doi":"10.48550/arxiv.2602.20442","identifiers":[{"identifier":"2602.20442","identifierType":"arXiv"}],"creators":[{"nameType":"Personal","givenName":"Jun","familyName":"Han","name":"Han, Jun","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Josue","familyName":"Nassar","name":"Nassar, Josue","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Sanjit Singh","familyName":"Batra","name":"Batra, Sanjit Singh","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Aldo","familyName":"Cordova-Palomera","name":"Cordova-Palomera, Aldo","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Vijay","familyName":"Nori","name":"Nori, Vijay","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Robert E.","familyName":"Tillman","name":"Tillman, Robert E.","affiliation":[],"nameIdentifiers":[]}],"titles":[{"title":"Imputation of Unknown Missingness in Sparse Electronic Health Records"}],"publisher":"arXiv","container":{},"publicationYear":2026,"subjects":[{"subject":"Machine Learning (cs.LG)","lang":"en","subjectScheme":"arXiv"},{"subject":"Artificial Intelligence (cs.AI)","lang":"en","subjectScheme":"arXiv"},{"subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"},{"schemeUri":"http://www.oecd.org/science/inno/38235147.pdf","subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"}],"contributors":[],"dates":[{"date":"2026-02-24T01:04:02Z","dateType":"Submitted","dateInformation":"v1"},{"date":"2026-02-25T01:13:46Z","dateType":"Updated","dateInformation":"v1"},{"date":"2026-02","dateType":"Available","dateInformation":"v1"},{"date":"2026","dateType":"Issued"}],"language":null,"types":{"schemaOrg":"CreativeWork","resourceTypeGeneral":"Preprint","citeproc":"article","bibtex":"misc","ris":"GEN","resourceType":"Article"},"relatedIdentifiers":[],"relatedItems":[],"sizes":[],"formats":[],"version":"1","rightsList":[{"rightsIdentifierScheme":"SPDX","rightsUri":"https://creativecommons.org/licenses/by/4.0/legalcode","schemeUri":"https://spdx.org/licenses/","rights":"Creative Commons Attribution 4.0 International","rightsIdentifier":"cc-by-4.0"}],"descriptions":[{"descriptionType":"Abstract","description":"Machine learning holds great promise for advancing the field of medicine, with electronic health records (EHRs) serving as a primary data source. However, EHRs are often sparse and contain missing data due to various challenges and limitations in data collection and sharing between healthcare providers. Existing techniques for imputing missing values predominantly focus on known unknowns, such as missing or unavailable values of lab test results; most do not explicitly address situations where it is difficult to distinguish what is missing. For instance, a missing diagnosis code in an EHR could signify either that the patient has not been diagnosed with the condition or that a diagnosis was made, but not shared by a provider. Such situations fall into the paradigm of unknown unknowns. To address this challenge, we develop a general purpose algorithm for denoising data to recover unknown missing values in binary EHRs. We design a transformer-based denoising neural network where the output is thresholded adaptively to recover values in cases where we predict data are missing. Our results demonstrate improved accuracy in denoising medical codes within a real EHR dataset compared to existing imputation approaches and leads to increased performance on downstream tasks using the denoised data. In particular, when applying our method to a real world application, predicting hospital readmission from EHRs, our method achieves statistically significant improvement over all existing baselines."}],"geoLocations":[],"fundingReferences":[],"url":"https://arxiv.org/abs/2602.20442","contentUrl":null,"metadataVersion":0,"schemaVersion":"http://datacite.org/schema/kernel-4","source":"mds","isActive":true,"state":"findable","reason":null,"viewCount":0,"downloadCount":0,"referenceCount":0,"citationCount":0,"partCount":0,"partOfCount":0,"versionCount":0,"versionOfCount":0,"created":"2026-02-25T02:50:12Z","registered":"2026-02-25T02:50:13Z","published":null,"updated":"2026-02-25T02:50:13Z"},"relationships":{"client":{"data":{"id":"arxiv.content","type":"clients"}}}},{"id":"10.48550/arxiv.2602.20441","type":"dois","attributes":{"doi":"10.48550/arxiv.2602.20441","identifiers":[{"identifier":"2602.20441","identifierType":"arXiv"}],"creators":[{"nameType":"Personal","givenName":"Geunyoung","familyName":"Kim","name":"Kim, Geunyoung","affiliation":[],"nameIdentifiers":[]}],"titles":[{"title":"An algorithm for Seifert surfaces in 3-manifolds via surgery presentations"}],"publisher":"arXiv","container":{},"publicationYear":2026,"subjects":[{"subject":"Geometric Topology (math.GT)","lang":"en","subjectScheme":"arXiv"},{"subject":"FOS: Mathematics","subjectScheme":"Fields of Science and Technology (FOS)"},{"schemeUri":"http://www.oecd.org/science/inno/38235147.pdf","subject":"FOS: Mathematics","subjectScheme":"Fields of Science and Technology (FOS)"},{"subject":"57K10, 57K30","lang":"en","subjectScheme":"MSC"}],"contributors":[],"dates":[{"date":"2026-02-24T00:57:05Z","dateType":"Submitted","dateInformation":"v1"},{"date":"2026-02-25T01:13:34Z","dateType":"Updated","dateInformation":"v1"},{"date":"2026-02","dateType":"Available","dateInformation":"v1"},{"date":"2026","dateType":"Issued"}],"language":null,"types":{"schemaOrg":"CreativeWork","resourceTypeGeneral":"Preprint","citeproc":"article","bibtex":"misc","ris":"GEN","resourceType":"Article"},"relatedIdentifiers":[],"relatedItems":[],"sizes":[],"formats":[],"version":"1","rightsList":[{"rightsIdentifierScheme":"SPDX","rightsUri":"https://creativecommons.org/licenses/by/4.0/legalcode","schemeUri":"https://spdx.org/licenses/","rights":"Creative Commons Attribution 4.0 International","rightsIdentifier":"cc-by-4.0"}],"descriptions":[{"descriptionType":"Abstract","description":"The classical Seifert algorithm provides an explicit construction of a Seifert surface for any link in $S^3$. Alegria and Menasco extended this construction to integral homology $3$-spheres using Heegaard splittings. In this paper, we extend the Seifert algorithm to null-homologous links in arbitrary $3$-manifolds via surgery on framed links in $S^3$."},{"descriptionType":"Other","description":"8 pages, 1 figure"}],"geoLocations":[],"fundingReferences":[],"url":"https://arxiv.org/abs/2602.20441","contentUrl":null,"metadataVersion":0,"schemaVersion":"http://datacite.org/schema/kernel-4","source":"mds","isActive":true,"state":"findable","reason":null,"viewCount":0,"downloadCount":0,"referenceCount":0,"citationCount":0,"partCount":0,"partOfCount":0,"versionCount":0,"versionOfCount":0,"created":"2026-02-25T02:50:11Z","registered":"2026-02-25T02:50:11Z","published":null,"updated":"2026-02-25T02:50:11Z"},"relationships":{"client":{"data":{"id":"arxiv.content","type":"clients"}}}},{"id":"10.48550/arxiv.2602.20439","type":"dois","attributes":{"doi":"10.48550/arxiv.2602.20439","identifiers":[{"identifier":"2602.20439","identifierType":"arXiv"}],"creators":[{"nameType":"Personal","givenName":"Jason","familyName":"Hartline","name":"Hartline, Jason","affiliation":[],"nameIdentifiers":[]}],"titles":[{"title":"Revenue Non-monotonicity in Matching Markets"}],"publisher":"arXiv","container":{},"publicationYear":2026,"subjects":[{"subject":"Theoretical Economics (econ.TH)","lang":"en","subjectScheme":"arXiv"},{"subject":"Computer Science and Game Theory (cs.GT)","lang":"en","subjectScheme":"arXiv"},{"subject":"FOS: Economics and business","subjectScheme":"Fields of Science and Technology (FOS)"},{"schemeUri":"http://www.oecd.org/science/inno/38235147.pdf","subject":"FOS: Economics and business","subjectScheme":"Fields of Science and Technology (FOS)"},{"subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"},{"schemeUri":"http://www.oecd.org/science/inno/38235147.pdf","subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"}],"contributors":[],"dates":[{"date":"2026-02-24T00:47:41Z","dateType":"Submitted","dateInformation":"v1"},{"date":"2026-02-25T01:13:24Z","dateType":"Updated","dateInformation":"v1"},{"date":"2026-02","dateType":"Available","dateInformation":"v1"},{"date":"2026","dateType":"Issued"}],"language":null,"types":{"schemaOrg":"CreativeWork","resourceTypeGeneral":"Preprint","citeproc":"article","bibtex":"misc","ris":"GEN","resourceType":"Article"},"relatedIdentifiers":[],"relatedItems":[],"sizes":[],"formats":[],"version":"1","rightsList":[{"rightsUri":"http://arxiv.org/licenses/nonexclusive-distrib/1.0/","rights":"arXiv.org perpetual, non-exclusive license"}],"descriptions":[{"descriptionType":"Abstract","description":"The Vickrey-Clarke-Groves (VCG) mechanism is infamously revenue\n non-monotone in combinatorial auctions. I.e., when a buyer increases\n their value for a bundle of items, the total auction revenue may decrease.\n Combinatorial auctions exhibit complementarities which broadly\n result in complexities in auction theory. This brief note shows\n that non-monotonicity in multi-item auctions is not a result of\n complementarities, and in fact, VCG is revenue non-monotone even in matching\n markets."}],"geoLocations":[],"fundingReferences":[],"url":"https://arxiv.org/abs/2602.20439","contentUrl":null,"metadataVersion":0,"schemaVersion":"http://datacite.org/schema/kernel-4","source":"mds","isActive":true,"state":"findable","reason":null,"viewCount":0,"downloadCount":0,"referenceCount":0,"citationCount":0,"partCount":0,"partOfCount":0,"versionCount":0,"versionOfCount":0,"created":"2026-02-25T02:50:08Z","registered":"2026-02-25T02:50:08Z","published":null,"updated":"2026-02-25T02:50:08Z"},"relationships":{"client":{"data":{"id":"arxiv.content","type":"clients"}}}},{"id":"10.48550/arxiv.2602.20438","type":"dois","attributes":{"doi":"10.48550/arxiv.2602.20438","identifiers":[{"identifier":"2602.20438","identifierType":"arXiv"}],"creators":[{"nameType":"Personal","givenName":"Peter","familyName":"Breiding","name":"Breiding, Peter","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Michael","familyName":"Eracleous","name":"Eracleous, Michael","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Tamara","familyName":"Bogdanović","name":"Bogdanović, Tamara","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Sarah","familyName":"Burke-Spolaor","name":"Burke-Spolaor, Sarah","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"T. Joseph W.","familyName":"Lazio","name":"Lazio, T. Joseph W.","affiliation":[],"nameIdentifiers":[]}],"titles":[{"title":"Chandra X-ray Observations of Quasars with Velocity-Offset Broad Lines: Assessing the Binary Supermassive Black Hole Hypothesis"}],"publisher":"arXiv","container":{},"publicationYear":2026,"subjects":[{"subject":"Astrophysics of Galaxies (astro-ph.GA)","lang":"en","subjectScheme":"arXiv"},{"subject":"FOS: Physical sciences","subjectScheme":"Fields of Science and Technology (FOS)"},{"schemeUri":"http://www.oecd.org/science/inno/38235147.pdf","subject":"FOS: Physical sciences","subjectScheme":"Fields of Science and Technology (FOS)"}],"contributors":[],"dates":[{"date":"2026-02-24T00:46:53Z","dateType":"Submitted","dateInformation":"v1"},{"date":"2026-02-25T01:13:22Z","dateType":"Updated","dateInformation":"v1"},{"date":"2026-02","dateType":"Available","dateInformation":"v1"},{"date":"2026","dateType":"Issued"}],"language":null,"types":{"schemaOrg":"CreativeWork","resourceTypeGeneral":"Preprint","citeproc":"article","bibtex":"misc","ris":"GEN","resourceType":"Article"},"relatedIdentifiers":[],"relatedItems":[],"sizes":[],"formats":[],"version":"1","rightsList":[{"rightsUri":"http://arxiv.org/licenses/nonexclusive-distrib/1.0/","rights":"arXiv.org perpetual, non-exclusive license"}],"descriptions":[{"descriptionType":"Abstract","description":"During the final stages of a galaxy merger, dynamical friction acting on the supermassive black holes (SMBHs) in the post-merger remnant can lead to the formation of a gravitationally bound binary SMBH. In the event that at least one of these SMBHs is actively accreting, the system can appear phenomenologically as an active galactic nucleus (AGN) with a broad line region (BLR) kinematically offset from the host galaxy rest frame. Such velocity offsets have been interpreted as signatures of binary SMBHs, recoiling SMBHs, or BLR gas dynamics within a single-SMBH system. We present deep Chandra X-ray observations of five nearby (0.1 \u0026lt; z \u0026lt; 0.2) Sloan Digital Sky Survey quasars whose broad emission lines are Doppler-shifted relative to their host galaxies' systemic velocities, along with archival Chandra observations of 11 additional sources from the same sample. Using our Chandra data, we constrain SMBH masses with multiple independent techniques. We find systematic, method-dependent differences among black hole mass estimates, with masses inferred from the fundamental plane of black hole activity generally lower and single-epoch virial masses typically higher than those obtained using other methods. We also compare the X-ray photon indices and optical-to-X-ray spectral indices of our quasars to the broader quasar population. While we find no strong differences in optical-to-X-ray spectral indices, we do find systematically harder X-ray photon indices than typically observed in comparable quasars. These results constrain competing physical models but do not provide conclusive evidence for or against a binary SMBH origin of the velocity-offset BLRs."},{"descriptionType":"Other","description":"Submitted to ApJ"}],"geoLocations":[],"fundingReferences":[],"url":"https://arxiv.org/abs/2602.20438","contentUrl":null,"metadataVersion":0,"schemaVersion":"http://datacite.org/schema/kernel-4","source":"mds","isActive":true,"state":"findable","reason":null,"viewCount":0,"downloadCount":0,"referenceCount":0,"citationCount":0,"partCount":0,"partOfCount":0,"versionCount":0,"versionOfCount":0,"created":"2026-02-25T02:50:06Z","registered":"2026-02-25T02:50:07Z","published":null,"updated":"2026-02-25T02:50:07Z"},"relationships":{"client":{"data":{"id":"arxiv.content","type":"clients"}}}},{"id":"10.48550/arxiv.2602.20437","type":"dois","attributes":{"doi":"10.48550/arxiv.2602.20437","identifiers":[{"identifier":"2602.20437","identifierType":"arXiv"}],"creators":[{"nameType":"Personal","givenName":"Ioannis","familyName":"Varveris","name":"Varveris, Ioannis","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Gianni D.","familyName":"Aliberti","name":"Aliberti, Gianni D.","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Felix J.","familyName":"Barzilaij","name":"Barzilaij, Felix J.","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Zhi","familyName":"Jin","name":"Jin, Zhi","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Samantha A.","familyName":"van Rijs","name":"van Rijs, Samantha A.","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Qiangrui","familyName":"Dong","name":"Dong, Qiangrui","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Daan","familyName":"Brinks","name":"Brinks, Daan","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Salahuddin","familyName":"Nur","name":"Nur, Salahuddin","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Ryoichi","familyName":"Ishihara","name":"Ishihara, Ryoichi","affiliation":[],"nameIdentifiers":[]}],"titles":[{"title":"Toward a CMOS-integrated quantum diamond biosensor based on NV centers"}],"publisher":"arXiv","container":{},"publicationYear":2026,"subjects":[{"subject":"Applied Physics (physics.app-ph)","lang":"en","subjectScheme":"arXiv"},{"subject":"Quantum Physics (quant-ph)","lang":"en","subjectScheme":"arXiv"},{"subject":"FOS: Physical sciences","subjectScheme":"Fields of Science and Technology (FOS)"},{"schemeUri":"http://www.oecd.org/science/inno/38235147.pdf","subject":"FOS: Physical sciences","subjectScheme":"Fields of Science and Technology (FOS)"}],"contributors":[],"dates":[{"date":"2026-02-24T00:37:17Z","dateType":"Submitted","dateInformation":"v1"},{"date":"2026-02-25T01:13:09Z","dateType":"Updated","dateInformation":"v1"},{"date":"2026-02","dateType":"Available","dateInformation":"v1"},{"date":"2026","dateType":"Issued"}],"language":null,"types":{"schemaOrg":"CreativeWork","resourceTypeGeneral":"Preprint","citeproc":"article","bibtex":"misc","ris":"GEN","resourceType":"Article"},"relatedIdentifiers":[],"relatedItems":[],"sizes":[],"formats":[],"version":"1","rightsList":[{"rightsIdentifierScheme":"SPDX","rightsUri":"https://creativecommons.org/licenses/by/4.0/legalcode","schemeUri":"https://spdx.org/licenses/","rights":"Creative Commons Attribution 4.0 International","rightsIdentifier":"cc-by-4.0"}],"descriptions":[{"descriptionType":"Abstract","description":"We report progress toward a CMOS-integrated quantum diamond biosensing platform that combines nitrogen-vacancy (NV) centers in diamond with a custom 40 nm CMOS Single-Photon Avalanche Diode (SPAD) array. The system integrates on-chip active quenching and digital readout with external FPGA-based photon counting, compact microwave delivery, and practical optical excitation and collection schemes to support widefield optically detected magnetic resonance (ODMR). System-level design considerations spanning fluorescence collection efficiency, detector count-rate capability, and microwave homogeneity are analyzed with biological compatibility and scalability in mind. Using superparamagnetic iron oxide nanoparticle (SPION)-labeled HEK293T cells as a representative use case, simple dipole-field estimates indicate that sub-$μ$T sensitivity is required to resolve ODMR shifts within typical ensemble linewidths. Based on the proposed architecture and efficiency analysis, a magnetic field sensitivity of approximately 90 nT/$\\sqrt{\\mathrm{Hz}}$ per pixel is estimated. These results outline a practical path from optics-heavy quantum diamond microscopes toward compact, CMOS-integrated NV-based biosensors for quantitative magnetic imaging in complex biological environments."},{"descriptionType":"Other","description":"19 pages, 20 figures"}],"geoLocations":[],"fundingReferences":[],"url":"https://arxiv.org/abs/2602.20437","contentUrl":null,"metadataVersion":0,"schemaVersion":"http://datacite.org/schema/kernel-4","source":"mds","isActive":true,"state":"findable","reason":null,"viewCount":0,"downloadCount":0,"referenceCount":0,"citationCount":0,"partCount":0,"partOfCount":0,"versionCount":0,"versionOfCount":0,"created":"2026-02-25T02:50:05Z","registered":"2026-02-25T02:50:05Z","published":null,"updated":"2026-02-25T02:50:05Z"},"relationships":{"client":{"data":{"id":"arxiv.content","type":"clients"}}}},{"id":"10.48550/arxiv.2602.20436","type":"dois","attributes":{"doi":"10.48550/arxiv.2602.20436","identifiers":[{"identifier":"2602.20436","identifierType":"arXiv"}],"creators":[{"nameType":"Personal","givenName":"Kyoungsu","familyName":"Heo","name":"Heo, Kyoungsu","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Heesung","familyName":"Kwon","name":"Kwon, Heesung","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Jaewon","familyName":"Kim","name":"Kim, Jaewon","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Jubin","familyName":"Park","name":"Park, Jubin","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Myung-Ki","familyName":"Cheoun","name":"Cheoun, Myung-Ki","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Eunja","familyName":"Ha","name":"Ha, Eunja","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Kyung Kwang","familyName":"Joo","name":"Joo, Kyung Kwang","affiliation":[],"nameIdentifiers":[]}],"titles":[{"title":"Probing Neutron Skins with KDAR Neutrinos: From Coherent to Diffractive Elastic Neutrino--Nucleus Scattering"}],"publisher":"arXiv","container":{},"publicationYear":2026,"subjects":[{"subject":"Nuclear Theory (nucl-th)","lang":"en","subjectScheme":"arXiv"},{"subject":"Nuclear Experiment (nucl-ex)","lang":"en","subjectScheme":"arXiv"},{"subject":"FOS: Physical sciences","subjectScheme":"Fields of Science and Technology (FOS)"},{"schemeUri":"http://www.oecd.org/science/inno/38235147.pdf","subject":"FOS: Physical sciences","subjectScheme":"Fields of Science and Technology (FOS)"}],"contributors":[],"dates":[{"date":"2026-02-24T00:36:31Z","dateType":"Submitted","dateInformation":"v1"},{"date":"2026-02-25T01:13:04Z","dateType":"Updated","dateInformation":"v1"},{"date":"2026-02","dateType":"Available","dateInformation":"v1"},{"date":"2026","dateType":"Issued"}],"language":null,"types":{"schemaOrg":"CreativeWork","resourceTypeGeneral":"Preprint","citeproc":"article","bibtex":"misc","ris":"GEN","resourceType":"Article"},"relatedIdentifiers":[],"relatedItems":[],"sizes":[],"formats":[],"version":"1","rightsList":[{"rightsIdentifierScheme":"SPDX","rightsUri":"https://creativecommons.org/licenses/by/4.0/legalcode","schemeUri":"https://spdx.org/licenses/","rights":"Creative Commons Attribution 4.0 International","rightsIdentifier":"cc-by-4.0"}],"descriptions":[{"descriptionType":"Abstract","description":"We investigate coherent elastic neutrino--nucleus scattering (CE$ν$NS) induced by pion--decay--at--rest ($π$DAR) and kaon--decay--at--rest (KDAR) neutrinos, with emphasis on the transition from strict coherence to the diffractive regime. Organizing CE$ν$NS observables in terms of the dimensionless variable $qR$, we show that $π$DAR measurements remain confined to the near--coherent region for all nuclei, whereas KDAR neutrinos ($E_ν=236$~MeV) extend the kinematics into $qR\\gtrsim1$, where recoil spectra develop genuine shape sensitivity to the nuclear weak form factor. Using representative light, medium--mass, and heavy nuclei ($^{12}$C, $^{40}$Ca, $^{48}$Ca, and $^{208}$Pb), we examine relevant cross sections and quantify the statistical sensitivity to the neutron skin thickness achievable at a JSNS$^2$--like facility. For a total exposure of 10~ton$\\cdot$year and realistic KDAR fluences, projected $1σ$ sensitivities reach $ΔR_{np}^{\\,(1 σ)}$ $\\simeq0.09$--$0.02$~fm for $^{48}$Ca and $\\simeq0.07$--$0.02$~fm for $^{208}$Pb as the fluence increases. These sensitivities are competitive with, and complementary to, parity--violating electron--scattering measurements such as CREX and PREX, while relying on an electroweakly clean neutral--current probe with distinct systematic uncertainties. \nOur results establish KDAR--based CE$ν$NS as a quantitatively robust and complementary avenue for probing neutron skins and nuclear weak densities beyond the coherent limit."}],"geoLocations":[],"fundingReferences":[],"url":"https://arxiv.org/abs/2602.20436","contentUrl":null,"metadataVersion":0,"schemaVersion":"http://datacite.org/schema/kernel-4","source":"mds","isActive":true,"state":"findable","reason":null,"viewCount":0,"downloadCount":0,"referenceCount":0,"citationCount":0,"partCount":0,"partOfCount":0,"versionCount":0,"versionOfCount":0,"created":"2026-02-25T02:50:03Z","registered":"2026-02-25T02:50:04Z","published":null,"updated":"2026-02-25T02:50:04Z"},"relationships":{"client":{"data":{"id":"arxiv.content","type":"clients"}}}},{"id":"10.48550/arxiv.2602.20434","type":"dois","attributes":{"doi":"10.48550/arxiv.2602.20434","identifiers":[{"identifier":"2602.20434","identifierType":"arXiv"}],"creators":[{"nameType":"Personal","givenName":"Dmitry","familyName":"Beliaev","name":"Beliaev, Dmitry","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Akshay","familyName":"Hegde","name":"Hegde, Akshay","affiliation":[],"nameIdentifiers":[]}],"titles":[{"title":"High local maxima of stationary smooth Gaussian fields"}],"publisher":"arXiv","container":{},"publicationYear":2026,"subjects":[{"subject":"Probability (math.PR)","lang":"en","subjectScheme":"arXiv"},{"subject":"FOS: Mathematics","subjectScheme":"Fields of Science and Technology (FOS)"},{"schemeUri":"http://www.oecd.org/science/inno/38235147.pdf","subject":"FOS: Mathematics","subjectScheme":"Fields of Science and Technology (FOS)"},{"subject":"60G60, 60G55, 60G70, 58K05","lang":"en","subjectScheme":"MSC"}],"contributors":[],"dates":[{"date":"2026-02-24T00:33:28Z","dateType":"Submitted","dateInformation":"v1"},{"date":"2026-02-25T01:12:54Z","dateType":"Updated","dateInformation":"v1"},{"date":"2026-02","dateType":"Available","dateInformation":"v1"},{"date":"2026","dateType":"Issued"}],"language":null,"types":{"schemaOrg":"CreativeWork","resourceTypeGeneral":"Preprint","citeproc":"article","bibtex":"misc","ris":"GEN","resourceType":"Article"},"relatedIdentifiers":[],"relatedItems":[],"sizes":[],"formats":[],"version":"1","rightsList":[{"rightsIdentifierScheme":"SPDX","rightsUri":"https://creativecommons.org/licenses/by/4.0/legalcode","schemeUri":"https://spdx.org/licenses/","rights":"Creative Commons Attribution 4.0 International","rightsIdentifier":"cc-by-4.0"}],"descriptions":[{"descriptionType":"Abstract","description":"Consider the point process (in $\\mathbb{R}^d$) of local maxima of smooth Gaussian fields, with sufficient decay of correlation at infinity, above a level $u$. We show that this point process, rescaled appropriately, converges weakly to a Poisson point process in the limit $u \\to \\infty$. Our proof relies on the classical observation that simple point processes are characterised by avoidance probabilities (i.e. $\\mathbb{P}(η(B)=0)$ for a point process $η$ and Borel set $B$). Then we approximate avoidance probability with the excursion probability, where the latter is well studied. Second main result is a quantified version of the Poisson convergence of high local maxima of the Bargmann-Fock field in $\\mathbb{R}^2$. We prove that, for Bargmann-Fock field in two dimensions, the total variation distance between a Poisson random variable and the number of local maxima of the field above a threshold $u$ in an $R \\times R$ box in $\\mathbb{R}^2$ decays like $\\exp(- βu^2)$, for some fixed $β\u0026gt;0$. As an immediate consequence, when the level $u$ is a function of $R$ such that $u(R) \\to \\infty$ and $u(R)/ \\sqrt{\\log R} \\to 0$ as $R \\to \\infty$, we have a quantitative central limit theorem for the number of high local maxima. The proof is based on the Chen-Stein method for quantitative Poisson approximation. We produce a close coupling of a stationary smooth field and its Palm version, which might be of independent interest."},{"descriptionType":"Other","description":"41 pages, 5 figures. Comments welcome!"}],"geoLocations":[],"fundingReferences":[],"url":"https://arxiv.org/abs/2602.20434","contentUrl":null,"metadataVersion":0,"schemaVersion":"http://datacite.org/schema/kernel-4","source":"mds","isActive":true,"state":"findable","reason":null,"viewCount":0,"downloadCount":0,"referenceCount":0,"citationCount":0,"partCount":0,"partOfCount":0,"versionCount":0,"versionOfCount":0,"created":"2026-02-25T02:50:01Z","registered":"2026-02-25T02:50:01Z","published":null,"updated":"2026-02-25T02:50:01Z"},"relationships":{"client":{"data":{"id":"arxiv.content","type":"clients"}}}},{"id":"10.48550/arxiv.2602.20431","type":"dois","attributes":{"doi":"10.48550/arxiv.2602.20431","identifiers":[{"identifier":"2602.20431","identifierType":"arXiv"}],"creators":[{"nameType":"Personal","givenName":"Naonori","familyName":"Sugiyama","name":"Sugiyama, Naonori","affiliation":[],"nameIdentifiers":[]}],"titles":[{"title":"IR-Safe and IR-Resummed Bispectra Before and After Reconstruction in Unified Lagrangian Perturbation Theory"}],"publisher":"arXiv","container":{},"publicationYear":2026,"subjects":[{"subject":"Cosmology and Nongalactic Astrophysics (astro-ph.CO)","lang":"en","subjectScheme":"arXiv"},{"subject":"FOS: Physical sciences","subjectScheme":"Fields of Science and Technology (FOS)"},{"schemeUri":"http://www.oecd.org/science/inno/38235147.pdf","subject":"FOS: Physical sciences","subjectScheme":"Fields of Science and Technology (FOS)"}],"contributors":[],"dates":[{"date":"2026-02-24T00:08:36Z","dateType":"Submitted","dateInformation":"v1"},{"date":"2026-02-25T01:12:44Z","dateType":"Updated","dateInformation":"v1"},{"date":"2026-02","dateType":"Available","dateInformation":"v1"},{"date":"2026","dateType":"Issued"}],"language":null,"types":{"schemaOrg":"CreativeWork","resourceTypeGeneral":"Preprint","citeproc":"article","bibtex":"misc","ris":"GEN","resourceType":"Article"},"relatedIdentifiers":[],"relatedItems":[],"sizes":[],"formats":[],"version":"1","rightsList":[{"rightsIdentifierScheme":"SPDX","rightsUri":"https://creativecommons.org/licenses/by/4.0/legalcode","schemeUri":"https://spdx.org/licenses/","rights":"Creative Commons Attribution 4.0 International","rightsIdentifier":"cc-by-4.0"}],"descriptions":[{"descriptionType":"Abstract","description":"We develop a unified analytic framework for modeling the real-space dark matter bispectrum, including both auto and cross bispectra constructed from pre- and post-reconstruction density fields, based on Unified Lagrangian Perturbation Theory (ULPT). ULPT reorganizes the standard Lagrangian approach by separating the Jacobian deviation, which generates the nonlinear source bispectrum, from the displacement-mapping effect that determines how long-wavelength bulk flows distort observed configurations. Within this structure, we derive general one-loop ULPT expressions for the bispectrum and analyze their infrared (IR) behavior, demonstrating exact, nonperturbative IR cancellation and the natural emergence of an IR-resummed description of baryon acoustic oscillation (BAO) damping. In particular, ULPT enables a detailed and fully analytic treatment of the wiggle-wiggle contribution to the IR-resummed bispectrum, whose structure has remained comparatively unexplored in previous approaches. We further construct IR-resummed models for the cross bispectra of all pre- and post-reconstruction combinations. For configurations in which the displacement fields differ, ULPT captures not only the overall exponential damping but also the more intricate BAO-scale modulation characteristic of mixed pre/post bispectra. Our results clarify the physical origin of nonlinear BAO suppression and provide a compact theoretical framework in which the full ULPT bispectrum, once implemented numerically through displacement-mapping convolution integrals, will automatically encode all nonlinear BAO and IR effects. The framework developed here therefore offers a unified and IR-safe foundation for interpreting next-generation bispectrum measurements."},{"descriptionType":"Other","description":"27 pages"}],"geoLocations":[],"fundingReferences":[],"url":"https://arxiv.org/abs/2602.20431","contentUrl":null,"metadataVersion":0,"schemaVersion":"http://datacite.org/schema/kernel-4","source":"mds","isActive":true,"state":"findable","reason":null,"viewCount":0,"downloadCount":0,"referenceCount":0,"citationCount":0,"partCount":0,"partOfCount":0,"versionCount":0,"versionOfCount":0,"created":"2026-02-25T02:49:56Z","registered":"2026-02-25T02:49:57Z","published":null,"updated":"2026-02-25T02:49:57Z"},"relationships":{"client":{"data":{"id":"arxiv.content","type":"clients"}}}},{"id":"10.48550/arxiv.2602.20425","type":"dois","attributes":{"doi":"10.48550/arxiv.2602.20425","identifiers":[{"identifier":"2602.20425","identifierType":"arXiv"}],"creators":[{"nameType":"Personal","givenName":"Mikael","familyName":"Vejdemo-Johansson","name":"Vejdemo-Johansson, Mikael","affiliation":[],"nameIdentifiers":[]}],"titles":[{"title":"Incomplete Open Platonic Solids"}],"publisher":"arXiv","container":{},"publicationYear":2026,"subjects":[{"subject":"Combinatorics (math.CO)","lang":"en","subjectScheme":"arXiv"},{"subject":"Computational Geometry (cs.CG)","lang":"en","subjectScheme":"arXiv"},{"subject":"FOS: Mathematics","subjectScheme":"Fields of Science and Technology (FOS)"},{"schemeUri":"http://www.oecd.org/science/inno/38235147.pdf","subject":"FOS: Mathematics","subjectScheme":"Fields of Science and Technology (FOS)"},{"subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"},{"schemeUri":"http://www.oecd.org/science/inno/38235147.pdf","subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"}],"contributors":[],"dates":[{"date":"2026-02-23T23:48:45Z","dateType":"Submitted","dateInformation":"v1"},{"date":"2026-02-25T01:11:54Z","dateType":"Updated","dateInformation":"v1"},{"date":"2026-02","dateType":"Available","dateInformation":"v1"},{"date":"2026","dateType":"Issued"}],"language":null,"types":{"schemaOrg":"CreativeWork","resourceTypeGeneral":"Preprint","citeproc":"article","bibtex":"misc","ris":"GEN","resourceType":"Article"},"relatedIdentifiers":[],"relatedItems":[],"sizes":[],"formats":[],"version":"1","rightsList":[{"rightsIdentifierScheme":"SPDX","rightsUri":"https://creativecommons.org/licenses/by/4.0/legalcode","schemeUri":"https://spdx.org/licenses/","rights":"Creative Commons Attribution 4.0 International","rightsIdentifier":"cc-by-4.0"}],"descriptions":[{"descriptionType":"Abstract","description":"Sol LeWitt famously enumerated all the incomplete open cubes, finding 122 of these connected, non-planar subsets of the edges of the cube.\n Since then, while several projects have revisited the cube enumeration, no such enumeration has been published for any other interesting solid.\n In this paper we present work on enumerating all the incomplete open platonic solids, finding 6 tetrahedra, 122 cubes (just like LeWitt), 185 octahedra, 2\\,423\\,206 dodecahedra and 16\\,096\\,166 icosahedra."},{"descriptionType":"Other","description":"Submitted to Bridges 2026"}],"geoLocations":[],"fundingReferences":[],"url":"https://arxiv.org/abs/2602.20425","contentUrl":null,"metadataVersion":0,"schemaVersion":"http://datacite.org/schema/kernel-4","source":"mds","isActive":true,"state":"findable","reason":null,"viewCount":0,"downloadCount":0,"referenceCount":0,"citationCount":0,"partCount":0,"partOfCount":0,"versionCount":0,"versionOfCount":0,"created":"2026-02-25T02:49:48Z","registered":"2026-02-25T02:49:48Z","published":null,"updated":"2026-02-25T02:49:48Z"},"relationships":{"client":{"data":{"id":"arxiv.content","type":"clients"}}}},{"id":"10.48550/arxiv.2602.20424","type":"dois","attributes":{"doi":"10.48550/arxiv.2602.20424","identifiers":[{"identifier":"2602.20424","identifierType":"arXiv"}],"creators":[{"nameType":"Personal","givenName":"Ved","familyName":"Sirdeshmukh","name":"Sirdeshmukh, Ved","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Marc","familyName":"Wetter","name":"Wetter, Marc","affiliation":[],"nameIdentifiers":[]}],"titles":[{"title":"Implicit Intelligence -- Evaluating Agents on What Users Don't Say"}],"publisher":"arXiv","container":{},"publicationYear":2026,"subjects":[{"subject":"Artificial Intelligence (cs.AI)","lang":"en","subjectScheme":"arXiv"},{"subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"},{"schemeUri":"http://www.oecd.org/science/inno/38235147.pdf","subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"}],"contributors":[],"dates":[{"date":"2026-02-23T23:46:55Z","dateType":"Submitted","dateInformation":"v1"},{"date":"2026-02-25T01:11:53Z","dateType":"Updated","dateInformation":"v1"},{"date":"2026-02","dateType":"Available","dateInformation":"v1"},{"date":"2026","dateType":"Issued"}],"language":null,"types":{"schemaOrg":"CreativeWork","resourceTypeGeneral":"Preprint","citeproc":"article","bibtex":"misc","ris":"GEN","resourceType":"Article"},"relatedIdentifiers":[],"relatedItems":[],"sizes":[],"formats":[],"version":"1","rightsList":[{"rightsIdentifierScheme":"SPDX","rightsUri":"https://creativecommons.org/licenses/by/4.0/legalcode","schemeUri":"https://spdx.org/licenses/","rights":"Creative Commons Attribution 4.0 International","rightsIdentifier":"cc-by-4.0"}],"descriptions":[{"descriptionType":"Abstract","description":"Real-world requests to AI agents are fundamentally underspecified. Natural human communication relies on shared context and unstated constraints that speakers expect listeners to infer. Current agentic benchmarks test explicit instruction-following but fail to evaluate whether agents can reason about implicit requirements spanning accessibility needs, privacy boundaries, catastrophic risks, and contextual constraints. We present Implicit Intelligence, an evaluation framework testing whether AI agents can move beyond prompt-following to become genuine goal-fulfillers, paired with Agent-as-a-World (AaW), a harness where interactive worlds are defined in human-readable YAML files and simulated by language models. Our scenarios feature apparent simplicity in user requests, hidden complexity in correct solutions, and discoverability of constraints through environmental exploration. Evaluating 16 frontier and open-weight models across 205 scenarios, we find that even the best-performing model achieves only 48.3% scenario pass rate, revealing substantial room for improvement in bridging the gap between literal instruction-following and human-like contextual reasoning."}],"geoLocations":[],"fundingReferences":[],"url":"https://arxiv.org/abs/2602.20424","contentUrl":null,"metadataVersion":0,"schemaVersion":"http://datacite.org/schema/kernel-4","source":"mds","isActive":true,"state":"findable","reason":null,"viewCount":0,"downloadCount":0,"referenceCount":0,"citationCount":0,"partCount":0,"partOfCount":0,"versionCount":0,"versionOfCount":0,"created":"2026-02-25T02:49:46Z","registered":"2026-02-25T02:49:47Z","published":null,"updated":"2026-02-25T02:49:47Z"},"relationships":{"client":{"data":{"id":"arxiv.content","type":"clients"}}}},{"id":"10.48550/arxiv.2602.20423","type":"dois","attributes":{"doi":"10.48550/arxiv.2602.20423","identifiers":[{"identifier":"2602.20423","identifierType":"arXiv"}],"creators":[{"nameType":"Personal","givenName":"Taha","familyName":"Koleilat","name":"Koleilat, Taha","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Hojat","familyName":"Asgariandehkordi","name":"Asgariandehkordi, Hojat","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Omid Nejati","familyName":"Manzari","name":"Manzari, Omid Nejati","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Berardino","familyName":"Barile","name":"Barile, Berardino","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Yiming","familyName":"Xiao","name":"Xiao, Yiming","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Hassan","familyName":"Rivaz","name":"Rivaz, Hassan","affiliation":[],"nameIdentifiers":[]}],"titles":[{"title":"MedCLIPSeg: Probabilistic Vision-Language Adaptation for Data-Efficient and Generalizable Medical Image Segmentation"}],"publisher":"arXiv","container":{},"publicationYear":2026,"subjects":[{"subject":"Computer Vision and Pattern Recognition (cs.CV)","lang":"en","subjectScheme":"arXiv"},{"subject":"Computation and Language (cs.CL)","lang":"en","subjectScheme":"arXiv"},{"subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"},{"schemeUri":"http://www.oecd.org/science/inno/38235147.pdf","subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"}],"contributors":[],"dates":[{"date":"2026-02-23T23:46:05Z","dateType":"Submitted","dateInformation":"v1"},{"date":"2026-02-25T01:11:49Z","dateType":"Updated","dateInformation":"v1"},{"date":"2026-02","dateType":"Available","dateInformation":"v1"},{"date":"2026","dateType":"Issued"}],"language":null,"types":{"schemaOrg":"CreativeWork","resourceTypeGeneral":"Preprint","citeproc":"article","bibtex":"misc","ris":"GEN","resourceType":"Article"},"relatedIdentifiers":[],"relatedItems":[],"sizes":[],"formats":[],"version":"1","rightsList":[{"rightsIdentifierScheme":"SPDX","rightsUri":"https://creativecommons.org/licenses/by-nc-sa/4.0/legalcode","schemeUri":"https://spdx.org/licenses/","rights":"Creative Commons Attribution Non Commercial Share Alike 4.0 International","rightsIdentifier":"cc-by-nc-sa-4.0"}],"descriptions":[{"descriptionType":"Abstract","description":"Medical image segmentation remains challenging due to limited annotations for training, ambiguous anatomical features, and domain shifts. While vision-language models such as CLIP offer strong cross-modal representations, their potential for dense, text-guided medical image segmentation remains underexplored. We present MedCLIPSeg, a novel framework that adapts CLIP for robust, data-efficient, and uncertainty-aware medical image segmentation. Our approach leverages patch-level CLIP embeddings through probabilistic cross-modal attention, enabling bidirectional interaction between image and text tokens and explicit modeling of predictive uncertainty. Together with a soft patch-level contrastive loss that encourages more nuanced semantic learning across diverse textual prompts, MedCLIPSeg effectively improves data efficiency and domain generalizability. Extensive experiments across 16 datasets spanning five imaging modalities and six organs demonstrate that MedCLIPSeg outperforms prior methods in accuracy, efficiency, and robustness, while providing interpretable uncertainty maps that highlight local reliability of segmentation results. This work demonstrates the potential of probabilistic vision-language modeling for text-driven medical image segmentation."},{"descriptionType":"Other","description":"CVPR 2026; Project Page: https://tahakoleilat.github.io/MedCLIPSeg"}],"geoLocations":[],"fundingReferences":[],"url":"https://arxiv.org/abs/2602.20423","contentUrl":null,"metadataVersion":0,"schemaVersion":"http://datacite.org/schema/kernel-4","source":"mds","isActive":true,"state":"findable","reason":null,"viewCount":0,"downloadCount":0,"referenceCount":0,"citationCount":0,"partCount":0,"partOfCount":0,"versionCount":0,"versionOfCount":0,"created":"2026-02-25T02:49:45Z","registered":"2026-02-25T02:49:46Z","published":null,"updated":"2026-02-25T02:49:46Z"},"relationships":{"client":{"data":{"id":"arxiv.content","type":"clients"}}}},{"id":"10.48550/arxiv.2602.20422","type":"dois","attributes":{"doi":"10.48550/arxiv.2602.20422","identifiers":[{"identifier":"2602.20422","identifierType":"arXiv"}],"creators":[{"nameType":"Personal","givenName":"Hanping","familyName":"Zhang","name":"Zhang, Hanping","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Yuhong","familyName":"Guo","name":"Guo, Yuhong","affiliation":[],"nameIdentifiers":[]}],"titles":[{"title":"Diffusion Modulation via Environment Mechanism Modeling for Planning"}],"publisher":"arXiv","container":{},"publicationYear":2026,"subjects":[{"subject":"Artificial Intelligence (cs.AI)","lang":"en","subjectScheme":"arXiv"},{"subject":"Machine Learning (cs.LG)","lang":"en","subjectScheme":"arXiv"},{"subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"},{"schemeUri":"http://www.oecd.org/science/inno/38235147.pdf","subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"}],"contributors":[],"dates":[{"date":"2026-02-23T23:41:22Z","dateType":"Submitted","dateInformation":"v1"},{"date":"2026-02-25T01:11:48Z","dateType":"Updated","dateInformation":"v1"},{"date":"2026-02","dateType":"Available","dateInformation":"v1"},{"date":"2026","dateType":"Issued"}],"language":null,"types":{"schemaOrg":"CreativeWork","resourceTypeGeneral":"Preprint","citeproc":"article","bibtex":"misc","ris":"GEN","resourceType":"Article"},"relatedIdentifiers":[],"relatedItems":[],"sizes":[],"formats":[],"version":"1","rightsList":[{"rightsUri":"http://arxiv.org/licenses/nonexclusive-distrib/1.0/","rights":"arXiv.org perpetual, non-exclusive license"}],"descriptions":[{"descriptionType":"Abstract","description":"Diffusion models have shown promising capabilities in trajectory generation for planning in offline reinforcement learning (RL). However, conventional diffusion-based planning methods often fail to account for the fact that generating trajectories in RL requires unique consistency between transitions to ensure coherence in real environments. This oversight can result in considerable discrepancies between the generated trajectories and the underlying mechanisms of a real environment. To address this problem, we propose a novel diffusion-based planning method, termed as Diffusion Modulation via Environment Mechanism Modeling (DMEMM). DMEMM modulates diffusion model training by incorporating key RL environment mechanisms, particularly transition dynamics and reward functions. Experimental results demonstrate that DMEMM achieves state-of-the-art performance for planning with offline reinforcement learning."}],"geoLocations":[],"fundingReferences":[],"url":"https://arxiv.org/abs/2602.20422","contentUrl":null,"metadataVersion":0,"schemaVersion":"http://datacite.org/schema/kernel-4","source":"mds","isActive":true,"state":"findable","reason":null,"viewCount":0,"downloadCount":0,"referenceCount":0,"citationCount":0,"partCount":0,"partOfCount":0,"versionCount":0,"versionOfCount":0,"created":"2026-02-25T02:49:43Z","registered":"2026-02-25T02:49:44Z","published":null,"updated":"2026-02-25T02:49:44Z"},"relationships":{"client":{"data":{"id":"arxiv.content","type":"clients"}}}},{"id":"10.48550/arxiv.2602.20421","type":"dois","attributes":{"doi":"10.48550/arxiv.2602.20421","identifiers":[{"identifier":"2602.20421","identifierType":"arXiv"}],"creators":[{"nameType":"Personal","givenName":"Brice","familyName":"Bakkali-Hassani","name":"Bakkali-Hassani, Brice","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Joyce","familyName":"Kwan","name":"Kwan, Joyce","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Perrin","familyName":"Segura","name":"Segura, Perrin","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Yanfei","familyName":"Li","name":"Li, Yanfei","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Isaac","familyName":"Tesfaye","name":"Tesfaye, Isaac","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Gerard","familyName":"Valentí-Rojas","name":"Valentí-Rojas, Gerard","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"André","familyName":"Eckardt","name":"Eckardt, André","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Markus","familyName":"Greiner","name":"Greiner, Markus","affiliation":[],"nameIdentifiers":[]}],"titles":[{"title":"Revealing Pseudo-Fermionization and Chiral Binding of One-Dimensional Anyons using Adiabatic State Preparation"}],"publisher":"arXiv","container":{},"publicationYear":2026,"subjects":[{"subject":"Quantum Gases (cond-mat.quant-gas)","lang":"en","subjectScheme":"arXiv"},{"subject":"Atomic Physics (physics.atom-ph)","lang":"en","subjectScheme":"arXiv"},{"subject":"Quantum Physics (quant-ph)","lang":"en","subjectScheme":"arXiv"},{"subject":"FOS: Physical sciences","subjectScheme":"Fields of Science and Technology (FOS)"},{"schemeUri":"http://www.oecd.org/science/inno/38235147.pdf","subject":"FOS: Physical sciences","subjectScheme":"Fields of Science and Technology (FOS)"}],"contributors":[],"dates":[{"date":"2026-02-23T23:40:38Z","dateType":"Submitted","dateInformation":"v1"},{"date":"2026-02-25T01:11:46Z","dateType":"Updated","dateInformation":"v1"},{"date":"2026-02","dateType":"Available","dateInformation":"v1"},{"date":"2026","dateType":"Issued"}],"language":null,"types":{"schemaOrg":"CreativeWork","resourceTypeGeneral":"Preprint","citeproc":"article","bibtex":"misc","ris":"GEN","resourceType":"Article"},"relatedIdentifiers":[],"relatedItems":[],"sizes":[],"formats":[],"version":"1","rightsList":[{"rightsIdentifierScheme":"SPDX","rightsUri":"https://creativecommons.org/licenses/by/4.0/legalcode","schemeUri":"https://spdx.org/licenses/","rights":"Creative Commons Attribution 4.0 International","rightsIdentifier":"cc-by-4.0"}],"descriptions":[{"descriptionType":"Abstract","description":"Fractional statistics give rise to quantum behaviors that differ fundamentally from those of bosons and fermions. While two-dimensional anyons play a major role in strongly correlated systems and topological quantum computing, the nature of their one-dimensional (1D) counterparts remains the subject of intense debate, with renewed interest fueled by recent experimental progress. Theoretically, 1D anyons are predicted to host exotic many-body phases and quantum phase transitions, yet experimental signatures have remained elusive. Using ultracold atoms in an optical lattice, we prepare two-body ground states of the 1D anyon-Hubbard model by combining Hamiltonian engineering via quasiperiodic drives and adiabatic state manipulation. We uncover the effects of statistical interactions that lead to pseudo-fermionization and to the formation of chiral bound states when particles remain close together. Our results establish a link between lattice and continuum realizations of anyon models, and mark important steps towards the precise control of 1D anyons in both equilibrium and out-of-equilibrium settings."},{"descriptionType":"Other","description":"7 pages (4 figures) + 18 pages (11 figures)"}],"geoLocations":[],"fundingReferences":[],"url":"https://arxiv.org/abs/2602.20421","contentUrl":null,"metadataVersion":0,"schemaVersion":"http://datacite.org/schema/kernel-4","source":"mds","isActive":true,"state":"findable","reason":null,"viewCount":0,"downloadCount":0,"referenceCount":0,"citationCount":0,"partCount":0,"partOfCount":0,"versionCount":0,"versionOfCount":0,"created":"2026-02-25T02:49:42Z","registered":"2026-02-25T02:49:43Z","published":null,"updated":"2026-02-25T02:49:43Z"},"relationships":{"client":{"data":{"id":"arxiv.content","type":"clients"}}}},{"id":"10.48550/arxiv.2602.20420","type":"dois","attributes":{"doi":"10.48550/arxiv.2602.20420","identifiers":[{"identifier":"2602.20420","identifierType":"arXiv"}],"creators":[{"nameType":"Personal","givenName":"D. K.","familyName":"Watson","name":"Watson, D. K.","affiliation":[],"nameIdentifiers":[]}],"titles":[{"title":"Zero-point energy of a trapped ultracold Fermi gas at unitarity: squeezing the Heisenberg uncertainty principle and suppressing the Pauli principle to produce a superfluid state"}],"publisher":"arXiv","container":{},"publicationYear":2026,"subjects":[{"subject":"Quantum Gases (cond-mat.quant-gas)","lang":"en","subjectScheme":"arXiv"},{"subject":"Quantum Physics (quant-ph)","lang":"en","subjectScheme":"arXiv"},{"subject":"FOS: Physical sciences","subjectScheme":"Fields of Science and Technology (FOS)"},{"schemeUri":"http://www.oecd.org/science/inno/38235147.pdf","subject":"FOS: Physical sciences","subjectScheme":"Fields of Science and Technology (FOS)"}],"contributors":[],"dates":[{"date":"2026-02-23T23:37:06Z","dateType":"Submitted","dateInformation":"v1"},{"date":"2026-02-25T01:11:38Z","dateType":"Updated","dateInformation":"v1"},{"date":"2026-02","dateType":"Available","dateInformation":"v1"},{"date":"2026","dateType":"Issued"}],"language":null,"types":{"schemaOrg":"CreativeWork","resourceTypeGeneral":"Preprint","citeproc":"article","bibtex":"misc","ris":"GEN","resourceType":"Article"},"relatedIdentifiers":[],"relatedItems":[],"sizes":[],"formats":[],"version":"1","rightsList":[{"rightsIdentifierScheme":"SPDX","rightsUri":"https://creativecommons.org/licenses/by/4.0/legalcode","schemeUri":"https://spdx.org/licenses/","rights":"Creative Commons Attribution 4.0 International","rightsIdentifier":"cc-by-4.0"}],"descriptions":[{"descriptionType":"Abstract","description":"The zero-point energy of a trapped ultracold Fermi gas at unitarity is investigated in relation to the combined effects of the Heisenberg uncertainty principle and the Pauli principle. This lowest allowed quantum state is a superfluid state which has been studied extensively both experimentally and theoretically. The method used for the current investigation is based on a recent series of papers that proposed microscopic dynamics based on normal modes to describe superfluidity instead of real-space Cooper pairs. This approach yielded excellent agreement with experimental data for multiple properties and allowed the microscopic behavior underlying these results as well as the basis of universal behavior to be analyzed in detail using the group theoretic basis of this general N-body approach. This microscopic picture is now used to illucidate the roles played by the uncertainty principle and the Pauli principle in determining the energy and character of the lowest allowed quantum state including the squeezed character of this superfluid state and the suppression of the Pauli principle."},{"descriptionType":"Other","description":"27 pages, 10 figures"}],"geoLocations":[],"fundingReferences":[],"url":"https://arxiv.org/abs/2602.20420","contentUrl":null,"metadataVersion":0,"schemaVersion":"http://datacite.org/schema/kernel-4","source":"mds","isActive":true,"state":"findable","reason":null,"viewCount":0,"downloadCount":0,"referenceCount":0,"citationCount":0,"partCount":0,"partOfCount":0,"versionCount":0,"versionOfCount":0,"created":"2026-02-25T02:49:40Z","registered":"2026-02-25T02:49:41Z","published":null,"updated":"2026-02-25T02:49:41Z"},"relationships":{"client":{"data":{"id":"arxiv.content","type":"clients"}}}},{"id":"10.48550/arxiv.2602.20419","type":"dois","attributes":{"doi":"10.48550/arxiv.2602.20419","identifiers":[{"identifier":"2602.20419","identifierType":"arXiv"}],"creators":[{"nameType":"Personal","givenName":"Bolin","familyName":"Shen","name":"Shen, Bolin","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Zhan","familyName":"Cheng","name":"Cheng, Zhan","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Neil Zhenqiang","familyName":"Gong","name":"Gong, Neil Zhenqiang","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Fan","familyName":"Yao","name":"Yao, Fan","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Yushun","familyName":"Dong","name":"Dong, Yushun","affiliation":[],"nameIdentifiers":[]}],"titles":[{"title":"CREDIT: Certified Ownership Verification of Deep Neural Networks Against Model Extraction Attacks"}],"publisher":"arXiv","container":{},"publicationYear":2026,"subjects":[{"subject":"Machine Learning (cs.LG)","lang":"en","subjectScheme":"arXiv"},{"subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"},{"schemeUri":"http://www.oecd.org/science/inno/38235147.pdf","subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"}],"contributors":[],"dates":[{"date":"2026-02-23T23:36:25Z","dateType":"Submitted","dateInformation":"v1"},{"date":"2026-02-25T01:11:36Z","dateType":"Updated","dateInformation":"v1"},{"date":"2026-02","dateType":"Available","dateInformation":"v1"},{"date":"2026","dateType":"Issued"}],"language":null,"types":{"schemaOrg":"CreativeWork","resourceTypeGeneral":"Preprint","citeproc":"article","bibtex":"misc","ris":"GEN","resourceType":"Article"},"relatedIdentifiers":[],"relatedItems":[],"sizes":[],"formats":[],"version":"1","rightsList":[{"rightsUri":"http://arxiv.org/licenses/nonexclusive-distrib/1.0/","rights":"arXiv.org perpetual, non-exclusive license"}],"descriptions":[{"descriptionType":"Abstract","description":"Machine Learning as a Service (MLaaS) has emerged as a widely adopted paradigm for providing access to deep neural network (DNN) models, enabling users to conveniently leverage these models through standardized APIs. However, such services are highly vulnerable to Model Extraction Attacks (MEAs), where an adversary repeatedly queries a target model to collect input-output pairs and uses them to train a surrogate model that closely replicates its functionality. While numerous defense strategies have been proposed, verifying the ownership of a suspicious model with strict theoretical guarantees remains a challenging task. To address this gap, we introduce CREDIT, a certified ownership verification against MEAs. Specifically, we employ mutual information to quantify the similarity between DNN models, propose a practical verification threshold, and provide rigorous theoretical guarantees for ownership verification based on this threshold. We extensively evaluate our approach on several mainstream datasets across different domains and tasks, achieving state-of-the-art performance. Our implementation is publicly available at: https://github.com/LabRAI/CREDIT."}],"geoLocations":[],"fundingReferences":[],"url":"https://arxiv.org/abs/2602.20419","contentUrl":null,"metadataVersion":0,"schemaVersion":"http://datacite.org/schema/kernel-4","source":"mds","isActive":true,"state":"findable","reason":null,"viewCount":0,"downloadCount":0,"referenceCount":0,"citationCount":0,"partCount":0,"partOfCount":0,"versionCount":0,"versionOfCount":0,"created":"2026-02-25T02:49:39Z","registered":"2026-02-25T02:49:40Z","published":null,"updated":"2026-02-25T02:49:40Z"},"relationships":{"client":{"data":{"id":"arxiv.content","type":"clients"}}}},{"id":"10.48550/arxiv.2602.20418","type":"dois","attributes":{"doi":"10.48550/arxiv.2602.20418","identifiers":[{"identifier":"2602.20418","identifierType":"arXiv"}],"creators":[{"nameType":"Personal","givenName":"Bolin","familyName":"Shen","name":"Shen, Bolin","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Md Shamim","familyName":"Seraj","name":"Seraj, Md Shamim","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Zhan","familyName":"Cheng","name":"Cheng, Zhan","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Shayok","familyName":"Chakraborty","name":"Chakraborty, Shayok","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Yushun","familyName":"Dong","name":"Dong, Yushun","affiliation":[],"nameIdentifiers":[]}],"titles":[{"title":"CITED: A Decision Boundary-Aware Signature for GNNs Towards Model Extraction Defense"}],"publisher":"arXiv","container":{},"publicationYear":2026,"subjects":[{"subject":"Machine Learning (cs.LG)","lang":"en","subjectScheme":"arXiv"},{"subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"},{"schemeUri":"http://www.oecd.org/science/inno/38235147.pdf","subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"}],"contributors":[],"dates":[{"date":"2026-02-23T23:33:31Z","dateType":"Submitted","dateInformation":"v1"},{"date":"2026-02-25T01:11:35Z","dateType":"Updated","dateInformation":"v1"},{"date":"2026-02","dateType":"Available","dateInformation":"v1"},{"date":"2026","dateType":"Issued"}],"language":null,"types":{"schemaOrg":"CreativeWork","resourceTypeGeneral":"Preprint","citeproc":"article","bibtex":"misc","ris":"GEN","resourceType":"Article"},"relatedIdentifiers":[],"relatedItems":[],"sizes":[],"formats":[],"version":"1","rightsList":[{"rightsUri":"http://arxiv.org/licenses/nonexclusive-distrib/1.0/","rights":"arXiv.org perpetual, non-exclusive license"}],"descriptions":[{"descriptionType":"Abstract","description":"Graph neural networks (GNNs) have demonstrated superior performance in various applications, such as recommendation systems and financial risk management. However, deploying large-scale GNN models locally is particularly challenging for users, as it requires significant computational resources and extensive property data. Consequently, Machine Learning as a Service (MLaaS) has become increasingly popular, offering a convenient way to deploy and access various models, including GNNs. However, an emerging threat known as Model Extraction Attacks (MEAs) presents significant risks, as adversaries can readily obtain surrogate GNN models exhibiting similar functionality. Specifically, attackers repeatedly query the target model using subgraph inputs to collect corresponding responses. These input-output pairs are subsequently utilized to train their own surrogate models at minimal cost. Many techniques have been proposed to defend against MEAs, but most are limited to specific output levels (e.g., embedding or label) and suffer from inherent technical drawbacks. To address these limitations, we propose a novel ownership verification framework CITED which is a first-of-its-kind method to achieve ownership verification on both embedding and label levels. Moreover, CITED is a novel signature-based method that neither harms downstream performance nor introduces auxiliary models that reduce efficiency, while still outperforming all watermarking and fingerprinting approaches. Extensive experiments demonstrate the effectiveness and robustness of our CITED framework. Code is available at: https://github.com/LabRAI/CITED."}],"geoLocations":[],"fundingReferences":[],"url":"https://arxiv.org/abs/2602.20418","contentUrl":null,"metadataVersion":0,"schemaVersion":"http://datacite.org/schema/kernel-4","source":"mds","isActive":true,"state":"findable","reason":null,"viewCount":0,"downloadCount":0,"referenceCount":0,"citationCount":0,"partCount":0,"partOfCount":0,"versionCount":0,"versionOfCount":0,"created":"2026-02-25T02:49:38Z","registered":"2026-02-25T02:49:38Z","published":null,"updated":"2026-02-25T02:49:38Z"},"relationships":{"client":{"data":{"id":"arxiv.content","type":"clients"}}}},{"id":"10.48550/arxiv.2602.20417","type":"dois","attributes":{"doi":"10.48550/arxiv.2602.20417","identifiers":[{"identifier":"2602.20417","identifierType":"arXiv"}],"creators":[{"nameType":"Personal","givenName":"Aryan","familyName":"Garg","name":"Garg, Aryan","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Sizhuo","familyName":"Ma","name":"Ma, Sizhuo","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Mohit","familyName":"Gupta","name":"Gupta, Mohit","affiliation":[],"nameIdentifiers":[]}],"titles":[{"title":"gQIR: Generative Quanta Image Reconstruction"}],"publisher":"arXiv","container":{},"publicationYear":2026,"subjects":[{"subject":"Computer Vision and Pattern Recognition (cs.CV)","lang":"en","subjectScheme":"arXiv"},{"subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"},{"schemeUri":"http://www.oecd.org/science/inno/38235147.pdf","subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"}],"contributors":[],"dates":[{"date":"2026-02-23T23:33:00Z","dateType":"Submitted","dateInformation":"v1"},{"date":"2026-02-25T01:11:33Z","dateType":"Updated","dateInformation":"v1"},{"date":"2026-02","dateType":"Available","dateInformation":"v1"},{"date":"2026","dateType":"Issued"}],"language":null,"types":{"schemaOrg":"CreativeWork","resourceTypeGeneral":"Preprint","citeproc":"article","bibtex":"misc","ris":"GEN","resourceType":"Article"},"relatedIdentifiers":[],"relatedItems":[],"sizes":[],"formats":[],"version":"1","rightsList":[{"rightsIdentifierScheme":"SPDX","rightsUri":"https://creativecommons.org/licenses/by/4.0/legalcode","schemeUri":"https://spdx.org/licenses/","rights":"Creative Commons Attribution 4.0 International","rightsIdentifier":"cc-by-4.0"}],"descriptions":[{"descriptionType":"Abstract","description":"Capturing high-quality images from only a few detected photons is a fundamental challenge in computational imaging. Single-photon avalanche diode (SPAD) sensors promise high-quality imaging in regimes where conventional cameras fail, but raw \\emph{quanta frames} contain only sparse, noisy, binary photon detections. Recovering a coherent image from a burst of such frames requires handling alignment, denoising, and demosaicing (for color) under noise statistics far outside those assumed by standard restoration pipelines or modern generative models. We present an approach that adapts large text-to-image latent diffusion models to the photon-limited domain of quanta burst imaging. Our method leverages the structural and semantic priors of internet-scale diffusion models while introducing mechanisms to handle Bernoulli photon statistics. By integrating latent-space restoration with burst-level spatio-temporal reasoning, our approach produces reconstructions that are both photometrically faithful and perceptually pleasing, even under high-speed motion. We evaluate the method on synthetic benchmarks and new real-world datasets, including the first color SPAD burst dataset and a challenging \\textit{Deforming (XD)} video benchmark. Across all settings, the approach substantially improves perceptual quality over classical and modern learning-based baselines, demonstrating the promise of adapting large generative priors to extreme photon-limited sensing. Code at \\href{https://github.com/Aryan-Garg/gQIR}{https://github.com/Aryan-Garg/gQIR}."},{"descriptionType":"Other","description":"CVPR 2026"}],"geoLocations":[],"fundingReferences":[],"url":"https://arxiv.org/abs/2602.20417","contentUrl":null,"metadataVersion":0,"schemaVersion":"http://datacite.org/schema/kernel-4","source":"mds","isActive":true,"state":"findable","reason":null,"viewCount":0,"downloadCount":0,"referenceCount":0,"citationCount":0,"partCount":0,"partOfCount":0,"versionCount":0,"versionOfCount":0,"created":"2026-02-25T02:49:36Z","registered":"2026-02-25T02:49:37Z","published":null,"updated":"2026-02-25T02:49:37Z"},"relationships":{"client":{"data":{"id":"arxiv.content","type":"clients"}}}},{"id":"10.48550/arxiv.2602.20416","type":"dois","attributes":{"doi":"10.48550/arxiv.2602.20416","identifiers":[{"identifier":"2602.20416","identifierType":"arXiv"}],"creators":[{"nameType":"Personal","givenName":"Gane Samb","familyName":"Lo","name":"Lo, Gane Samb","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"El Hadji","familyName":"Babou","name":"Babou, El Hadji","affiliation":[],"nameIdentifiers":[]}],"titles":[{"title":"Independence of the indicator functions of record values for Multivariate independent data"}],"publisher":"arXiv","container":{},"publicationYear":2026,"subjects":[{"subject":"Probability (math.PR)","lang":"en","subjectScheme":"arXiv"},{"subject":"FOS: Mathematics","subjectScheme":"Fields of Science and Technology (FOS)"},{"schemeUri":"http://www.oecd.org/science/inno/38235147.pdf","subject":"FOS: Mathematics","subjectScheme":"Fields of Science and Technology (FOS)"},{"subject":"records theory, time records, indicator functions of records.\\\\ 60F05, 60E07","lang":"en","subjectScheme":"MSC"}],"contributors":[],"dates":[{"date":"2026-02-23T23:32:29Z","dateType":"Submitted","dateInformation":"v1"},{"date":"2026-02-25T01:11:32Z","dateType":"Updated","dateInformation":"v1"},{"date":"2026-02","dateType":"Available","dateInformation":"v1"},{"date":"2026","dateType":"Issued"}],"language":null,"types":{"schemaOrg":"CreativeWork","resourceTypeGeneral":"Preprint","citeproc":"article","bibtex":"misc","ris":"GEN","resourceType":"Article"},"relatedIdentifiers":[],"relatedItems":[],"sizes":[],"formats":[],"version":"1","rightsList":[{"rightsIdentifierScheme":"SPDX","rightsUri":"https://creativecommons.org/licenses/by/4.0/legalcode","schemeUri":"https://spdx.org/licenses/","rights":"Creative Commons Attribution 4.0 International","rightsIdentifier":"cc-by-4.0"}],"descriptions":[{"descriptionType":"Abstract","description":"We consider a sequence of random vectors on \\(\\mathbb{R}^d, \\ d\\geq 1\\). We consider the record values based on the simultaneous strict inequality of the coordinates. The indicator record variable (irv) of the j-th observation is the function that assigns the value 1 (one) if that observation is a record value and the null value otherwise. Here, we give a detailed and a thorough proof that the indicator functions are independent, whenever the data are themselves independent, not necessarily \u003ci\u003eiid\u003c/i\u003e, in \\(\\mathbb{R}^d, \\ d\\geq 1\\). We compare that proof with available proofs in dimension one. Indeed, in seminal works on records, in particular in Ahsanullah(2024), Nevzorov(2001), Resnick (1987), Ahsanullah and Nevzorov (2015), etc., the independence of record indicator functions is usually validated based on logical reasoning, and so, is not rigorously proved. This allows us to undertake a detailed and thorough proof for independent data, not necessity \u003ci\u003eiid\u003c/i\u003e, in \\(\\mathbb{R}^d, \\ d\\geq 1\\). The proof includes leads for not even independent data."}],"geoLocations":[],"fundingReferences":[],"url":"https://arxiv.org/abs/2602.20416","contentUrl":null,"metadataVersion":0,"schemaVersion":"http://datacite.org/schema/kernel-4","source":"mds","isActive":true,"state":"findable","reason":null,"viewCount":0,"downloadCount":0,"referenceCount":0,"citationCount":0,"partCount":0,"partOfCount":0,"versionCount":0,"versionOfCount":0,"created":"2026-02-25T02:49:35Z","registered":"2026-02-25T02:49:35Z","published":null,"updated":"2026-02-25T02:49:35Z"},"relationships":{"client":{"data":{"id":"arxiv.content","type":"clients"}}}},{"id":"10.48550/arxiv.2602.20415","type":"dois","attributes":{"doi":"10.48550/arxiv.2602.20415","identifiers":[{"identifier":"2602.20415","identifierType":"arXiv"}],"creators":[{"nameType":"Personal","givenName":"Philip Z.","familyName":"Maymin","name":"Maymin, Philip Z.","affiliation":[],"nameIdentifiers":[]}],"titles":[{"title":"Markets are competitive if and only if P != NP"}],"publisher":"arXiv","container":{},"publicationYear":2026,"subjects":[{"subject":"Computer Science and Game Theory (cs.GT)","lang":"en","subjectScheme":"arXiv"},{"subject":"Computational Complexity (cs.CC)","lang":"en","subjectScheme":"arXiv"},{"subject":"Theoretical Economics (econ.TH)","lang":"en","subjectScheme":"arXiv"},{"subject":"Computational Finance (q-fin.CP)","lang":"en","subjectScheme":"arXiv"},{"subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"},{"schemeUri":"http://www.oecd.org/science/inno/38235147.pdf","subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"},{"subject":"FOS: Economics and business","subjectScheme":"Fields of Science and Technology (FOS)"},{"schemeUri":"http://www.oecd.org/science/inno/38235147.pdf","subject":"FOS: Economics and business","subjectScheme":"Fields of Science and Technology (FOS)"},{"subject":"91B26, 68Q17, 91A20","lang":"en","subjectScheme":"MSC"}],"contributors":[],"dates":[{"date":"2026-02-23T23:31:43Z","dateType":"Submitted","dateInformation":"v1"},{"date":"2026-02-25T01:11:32Z","dateType":"Updated","dateInformation":"v1"},{"date":"2026-02","dateType":"Available","dateInformation":"v1"},{"date":"2026","dateType":"Issued"}],"language":null,"types":{"schemaOrg":"CreativeWork","resourceTypeGeneral":"Preprint","citeproc":"article","bibtex":"misc","ris":"GEN","resourceType":"Article"},"relatedIdentifiers":[],"relatedItems":[],"sizes":[],"formats":[],"version":"1","rightsList":[{"rightsIdentifierScheme":"SPDX","rightsUri":"https://creativecommons.org/licenses/by/4.0/legalcode","schemeUri":"https://spdx.org/licenses/","rights":"Creative Commons Attribution 4.0 International","rightsIdentifier":"cc-by-4.0"}],"descriptions":[{"descriptionType":"Abstract","description":"I prove that competitive market outcomes require computational intractability. If P = NP, firms can efficiently solve the collusion detection problem, identifying deviations from cooperative agreements in complex, noisy markets and thereby making collusion sustainable as an equilibrium. If P != NP, the collusion detection problem is computationally infeasible for markets satisfying a natural instance-hardness condition on their demand structure, rendering punishment threats non-credible and collusion unstable. Combined with Maymin (2011), who proved that market efficiency requires P = NP, this yields a fundamental impossibility: markets can be informationally efficient or competitive, but not both. Artificial intelligence, by expanding firms' computational capabilities, is pushing markets from the competitive regime toward the collusive regime, explaining the empirical emergence of algorithmic collusion without explicit coordination."},{"descriptionType":"Other","description":"31 pages, 1 figure"}],"geoLocations":[],"fundingReferences":[],"url":"https://arxiv.org/abs/2602.20415","contentUrl":null,"metadataVersion":0,"schemaVersion":"http://datacite.org/schema/kernel-4","source":"mds","isActive":true,"state":"findable","reason":null,"viewCount":0,"downloadCount":0,"referenceCount":0,"citationCount":0,"partCount":0,"partOfCount":0,"versionCount":0,"versionOfCount":0,"created":"2026-02-25T02:49:33Z","registered":"2026-02-25T02:49:34Z","published":null,"updated":"2026-02-25T02:49:34Z"},"relationships":{"client":{"data":{"id":"arxiv.content","type":"clients"}}}},{"id":"10.48550/arxiv.2602.20412","type":"dois","attributes":{"doi":"10.48550/arxiv.2602.20412","identifiers":[{"identifier":"2602.20412","identifierType":"arXiv"}],"creators":[{"nameType":"Personal","givenName":"Aayush","familyName":"Dhakal","name":"Dhakal, Aayush","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Subash","familyName":"Khanal","name":"Khanal, Subash","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Srikumar","familyName":"Sastry","name":"Sastry, Srikumar","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Jacob","familyName":"Arndt","name":"Arndt, Jacob","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Philipe Ambrozio","familyName":"Dias","name":"Dias, Philipe Ambrozio","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Dalton","familyName":"Lunga","name":"Lunga, Dalton","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Nathan","familyName":"Jacobs","name":"Jacobs, Nathan","affiliation":[],"nameIdentifiers":[]}],"titles":[{"title":"SimLBR: Learning to Detect Fake Images by Learning to Detect Real Images"}],"publisher":"arXiv","container":{},"publicationYear":2026,"subjects":[{"subject":"Computer Vision and Pattern Recognition (cs.CV)","lang":"en","subjectScheme":"arXiv"},{"subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"},{"schemeUri":"http://www.oecd.org/science/inno/38235147.pdf","subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"}],"contributors":[],"dates":[{"date":"2026-02-23T23:22:41Z","dateType":"Submitted","dateInformation":"v1"},{"date":"2026-02-25T01:11:27Z","dateType":"Updated","dateInformation":"v1"},{"date":"2026-02","dateType":"Available","dateInformation":"v1"},{"date":"2026","dateType":"Issued"}],"language":null,"types":{"schemaOrg":"CreativeWork","resourceTypeGeneral":"Preprint","citeproc":"article","bibtex":"misc","ris":"GEN","resourceType":"Article"},"relatedIdentifiers":[],"relatedItems":[],"sizes":[],"formats":[],"version":"1","rightsList":[{"rightsIdentifierScheme":"SPDX","rightsUri":"https://creativecommons.org/licenses/by/4.0/legalcode","schemeUri":"https://spdx.org/licenses/","rights":"Creative Commons Attribution 4.0 International","rightsIdentifier":"cc-by-4.0"}],"descriptions":[{"descriptionType":"Abstract","description":"The rapid advancement of generative models has made the detection of AI-generated images a critical challenge for both research and society. Recent works have shown that most state-of-the-art fake image detection methods overfit to their training data and catastrophically fail when evaluated on curated hard test sets with strong distribution shifts. In this work, we argue that it is more principled to learn a tight decision boundary around the real image distribution and treat the fake category as a sink class. To this end, we propose SimLBR, a simple and efficient framework for fake image detection using Latent Blending Regularization (LBR). Our method significantly improves cross-generator generalization, achieving up to +24.85\\% accuracy and +69.62\\% recall on the challenging Chameleon benchmark. SimLBR is also highly efficient, training orders of magnitude faster than existing approaches. Furthermore, we emphasize the need for reliability-oriented evaluation in fake image detection, introducing risk-adjusted metrics and worst-case estimates to better assess model robustness. All code and models will be released on HuggingFace and GitHub."},{"descriptionType":"Other","description":"Accepted to CVPR 2026"}],"geoLocations":[],"fundingReferences":[],"url":"https://arxiv.org/abs/2602.20412","contentUrl":null,"metadataVersion":0,"schemaVersion":"http://datacite.org/schema/kernel-4","source":"mds","isActive":true,"state":"findable","reason":null,"viewCount":0,"downloadCount":0,"referenceCount":0,"citationCount":0,"partCount":0,"partOfCount":0,"versionCount":0,"versionOfCount":0,"created":"2026-02-25T02:49:29Z","registered":"2026-02-25T02:49:30Z","published":null,"updated":"2026-02-25T02:49:30Z"},"relationships":{"client":{"data":{"id":"arxiv.content","type":"clients"}}}},{"id":"10.48550/arxiv.2602.20411","type":"dois","attributes":{"doi":"10.48550/arxiv.2602.20411","identifiers":[{"identifier":"2602.20411","identifierType":"arXiv"}],"creators":[{"nameType":"Personal","givenName":"D.","familyName":"Kalvik","name":"Kalvik, D.","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"E.","familyName":"Adli","name":"Adli, E.","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"P.","familyName":"Drobniak","name":"Drobniak, P.","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"F.","familyName":"Peña","name":"Peña, F.","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"C. A.","familyName":"Lindstrøm","name":"Lindstrøm, C. A.","affiliation":[],"nameIdentifiers":[]}],"titles":[{"title":"Driver-delay chicanes for a multistage plasma-based accelerator facility"}],"publisher":"arXiv","container":{},"publicationYear":2026,"subjects":[{"subject":"Accelerator Physics (physics.acc-ph)","lang":"en","subjectScheme":"arXiv"},{"subject":"FOS: Physical sciences","subjectScheme":"Fields of Science and Technology (FOS)"},{"schemeUri":"http://www.oecd.org/science/inno/38235147.pdf","subject":"FOS: Physical sciences","subjectScheme":"Fields of Science and Technology (FOS)"}],"contributors":[],"dates":[{"date":"2026-02-23T23:17:52Z","dateType":"Submitted","dateInformation":"v1"},{"date":"2026-02-25T01:11:21Z","dateType":"Updated","dateInformation":"v1"},{"date":"2026-02","dateType":"Available","dateInformation":"v1"},{"date":"2026","dateType":"Issued"}],"language":null,"types":{"schemaOrg":"CreativeWork","resourceTypeGeneral":"Preprint","citeproc":"article","bibtex":"misc","ris":"GEN","resourceType":"Article"},"relatedIdentifiers":[],"relatedItems":[],"sizes":[],"formats":[],"version":"1","rightsList":[{"rightsUri":"http://arxiv.org/licenses/nonexclusive-distrib/1.0/","rights":"arXiv.org perpetual, non-exclusive license"}],"descriptions":[{"descriptionType":"Abstract","description":"The SPARTA project aims to design a medium-sized accelerator facility that facilitates new experiments in strong-field quantum electrodynamics using plasma-based accelerators. For this, we need several plasma stages and, therefore, several drivers. Drivers can be either an ultra-relativistic charged particle beam or a high-intensity laser beam. In case we use particle beams, we need a method of distributing these beams from a radio-frequency accelerator to the different plasma stages. A central part of this is a delay scheme that ensures temporal synchronization of the drivers. In this paper, we demonstrate how to achieve a 2 ns delay in $\\sim$12 m, while keeping the first-order beam parameters periodic."},{"descriptionType":"Other","description":"10 pages, 7 figures. This paper is being submitted to the European Advanced Accelerator Conference proceedings"}],"geoLocations":[],"fundingReferences":[],"url":"https://arxiv.org/abs/2602.20411","contentUrl":null,"metadataVersion":0,"schemaVersion":"http://datacite.org/schema/kernel-4","source":"mds","isActive":true,"state":"findable","reason":null,"viewCount":0,"downloadCount":0,"referenceCount":0,"citationCount":0,"partCount":0,"partOfCount":0,"versionCount":0,"versionOfCount":0,"created":"2026-02-25T02:49:27Z","registered":"2026-02-25T02:49:28Z","published":null,"updated":"2026-02-25T02:49:28Z"},"relationships":{"client":{"data":{"id":"arxiv.content","type":"clients"}}}},{"id":"10.48550/arxiv.2602.20408","type":"dois","attributes":{"doi":"10.48550/arxiv.2602.20408","identifiers":[{"identifier":"2602.20408","identifierType":"arXiv"}],"creators":[{"nameType":"Personal","givenName":"Yuting","familyName":"Deng","name":"Deng, Yuting","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Melanie","familyName":"Brucks","name":"Brucks, Melanie","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Olivier","familyName":"Toubia","name":"Toubia, Olivier","affiliation":[],"nameIdentifiers":[]}],"titles":[{"title":"Examining and Addressing Barriers to Diversity in LLM-Generated Ideas"}],"publisher":"arXiv","container":{},"publicationYear":2026,"subjects":[{"subject":"Computers and Society (cs.CY)","lang":"en","subjectScheme":"arXiv"},{"subject":"Artificial Intelligence (cs.AI)","lang":"en","subjectScheme":"arXiv"},{"subject":"Human-Computer Interaction (cs.HC)","lang":"en","subjectScheme":"arXiv"},{"subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"},{"schemeUri":"http://www.oecd.org/science/inno/38235147.pdf","subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"}],"contributors":[],"dates":[{"date":"2026-02-23T23:10:47Z","dateType":"Submitted","dateInformation":"v1"},{"date":"2026-02-25T01:11:14Z","dateType":"Updated","dateInformation":"v1"},{"date":"2026-02","dateType":"Available","dateInformation":"v1"},{"date":"2026","dateType":"Issued"}],"language":null,"types":{"schemaOrg":"CreativeWork","resourceTypeGeneral":"Preprint","citeproc":"article","bibtex":"misc","ris":"GEN","resourceType":"Article"},"relatedIdentifiers":[],"relatedItems":[],"sizes":[],"formats":[],"version":"1","rightsList":[{"rightsIdentifierScheme":"SPDX","rightsUri":"https://creativecommons.org/licenses/by/4.0/legalcode","schemeUri":"https://spdx.org/licenses/","rights":"Creative Commons Attribution 4.0 International","rightsIdentifier":"cc-by-4.0"}],"descriptions":[{"descriptionType":"Abstract","description":"Ideas generated by independent samples of humans tend to be more diverse than ideas generated from independent LLM samples, raising concerns that widespread reliance on LLMs could homogenize ideation and undermine innovation at a societal level. Drawing on cognitive psychology, we identify (both theoretically and empirically) two mechanisms undermining LLM idea diversity. First, at the individual level, LLMs exhibit fixation just as humans do, where early outputs constrain subsequent ideation. Second, at the collective level, LLMs aggregate knowledge into a unified distribution rather than exhibiting the knowledge partitioning inherent to human populations, where each person occupies a distinct region of the knowledge space. Through four studies, we demonstrate that targeted prompting interventions can address each mechanism independently: Chain-of-Thought (CoT) prompting reduces fixation by encouraging structured reasoning (only in LLMs, not humans), while ordinary personas (versus \"creative entrepreneurs\" such as Steve Jobs) improve knowledge partitioning by serving as diverse sampling cues, anchoring generation in distinct regions of the semantic space. Combining both approaches produces the highest idea diversity, outperforming humans. These findings offer a theoretically grounded framework for understanding LLM idea diversity and practical strategies for human-AI collaborations that leverage AI's efficiency without compromising the diversity essential to a healthy innovation ecosystem."}],"geoLocations":[],"fundingReferences":[],"url":"https://arxiv.org/abs/2602.20408","contentUrl":null,"metadataVersion":0,"schemaVersion":"http://datacite.org/schema/kernel-4","source":"mds","isActive":true,"state":"findable","reason":null,"viewCount":0,"downloadCount":0,"referenceCount":0,"citationCount":0,"partCount":0,"partOfCount":0,"versionCount":0,"versionOfCount":0,"created":"2026-02-25T02:49:23Z","registered":"2026-02-25T02:49:24Z","published":null,"updated":"2026-02-25T02:49:24Z"},"relationships":{"client":{"data":{"id":"arxiv.content","type":"clients"}}}},{"id":"10.48550/arxiv.2602.20407","type":"dois","attributes":{"doi":"10.48550/arxiv.2602.20407","identifiers":[{"identifier":"2602.20407","identifierType":"arXiv"}],"creators":[{"nameType":"Personal","givenName":"Lucas A. M.","familyName":"Rattighieri","name":"Rattighieri, Lucas A. M.","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Pedro M.","familyName":"Prado","name":"Prado, Pedro M.","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Marcos C.","familyName":"de Oliveira","name":"de Oliveira, Marcos C.","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Felipe F.","familyName":"Fanchini","name":"Fanchini, Felipe F.","affiliation":[],"nameIdentifiers":[]}],"titles":[{"title":"Measurement-Guided State Refinement for Shallow Feedback-Based Quantum Optimization Algorithm"}],"publisher":"arXiv","container":{},"publicationYear":2026,"subjects":[{"subject":"Quantum Physics (quant-ph)","lang":"en","subjectScheme":"arXiv"},{"subject":"FOS: Physical sciences","subjectScheme":"Fields of Science and Technology (FOS)"},{"schemeUri":"http://www.oecd.org/science/inno/38235147.pdf","subject":"FOS: Physical sciences","subjectScheme":"Fields of Science and Technology (FOS)"}],"contributors":[],"dates":[{"date":"2026-02-23T23:07:11Z","dateType":"Submitted","dateInformation":"v1"},{"date":"2026-02-25T01:11:13Z","dateType":"Updated","dateInformation":"v1"},{"date":"2026-02","dateType":"Available","dateInformation":"v1"},{"date":"2026","dateType":"Issued"}],"language":null,"types":{"schemaOrg":"CreativeWork","resourceTypeGeneral":"Preprint","citeproc":"article","bibtex":"misc","ris":"GEN","resourceType":"Article"},"relatedIdentifiers":[],"relatedItems":[],"sizes":[],"formats":[],"version":"1","rightsList":[{"rightsIdentifierScheme":"SPDX","rightsUri":"https://creativecommons.org/licenses/by/4.0/legalcode","schemeUri":"https://spdx.org/licenses/","rights":"Creative Commons Attribution 4.0 International","rightsIdentifier":"cc-by-4.0"}],"descriptions":[{"descriptionType":"Abstract","description":"Limited circuit depth remains a central constraint for quantum optimization in the noisy intermediate-scale quantum (NISQ) regime, where shallow unitary dynamics may fail to sufficiently concentrate probability on low-energy configurations. We introduce Measurement-Guided Initialization (MGI), an iterative strategy that uses measurement outcomes from previous executions to update the initialization of subsequent runs. The method extracts single-qubit marginal probabilities from dominant measurement outcomes and prepares a biased product-state initialization, allowing information obtained during optimization to be reused without introducing classical parameter optimization. We implement this approach in the context of the Feedback-Based Algorithm for Quantum Optimization (FALQON) and evaluate its performance on weighted MaxCut instances. Numerical results show that measurement-guided initialization improves the performance of shallow-depth circuits and enables iterative refinement toward high-quality solutions while preserving the non-variational structure of the algorithm. These results indicate that measurement statistics can be exploited to improve shallow quantum optimization protocols compatible with NISQ devices."},{"descriptionType":"Other","description":"12 pages, 6 figures"}],"geoLocations":[],"fundingReferences":[],"url":"https://arxiv.org/abs/2602.20407","contentUrl":null,"metadataVersion":0,"schemaVersion":"http://datacite.org/schema/kernel-4","source":"mds","isActive":true,"state":"findable","reason":null,"viewCount":0,"downloadCount":0,"referenceCount":0,"citationCount":0,"partCount":0,"partOfCount":0,"versionCount":0,"versionOfCount":0,"created":"2026-02-25T02:49:22Z","registered":"2026-02-25T02:49:22Z","published":null,"updated":"2026-02-25T02:49:22Z"},"relationships":{"client":{"data":{"id":"arxiv.content","type":"clients"}}}},{"id":"10.48550/arxiv.2602.20406","type":"dois","attributes":{"doi":"10.48550/arxiv.2602.20406","identifiers":[{"identifier":"2602.20406","identifierType":"arXiv"}],"creators":[{"nameType":"Personal","givenName":"Iman","familyName":"Taghavi","name":"Taghavi, Iman","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Alexander","familyName":"Tofini","name":"Tofini, Alexander","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Edward K.","familyName":"Leung","name":"Leung, Edward K.","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Cory","familyName":"Pecinovsky","name":"Pecinovsky, Cory","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Nicolas A. F.","familyName":"Jaeger","name":"Jaeger, Nicolas A. F.","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Lukas","familyName":"Chrostowski","name":"Chrostowski, Lukas","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Sudip","familyName":"Shekhar","name":"Shekhar, Sudip","affiliation":[],"nameIdentifiers":[]}],"titles":[{"title":"DC-to-GHz Modulation In Microring Modulators Using Ferroelectric Nematic Liquid Crystal-on-Silicon in a Foundry Photonic Process"}],"publisher":"arXiv","container":{},"publicationYear":2026,"subjects":[{"subject":"Optics (physics.optics)","lang":"en","subjectScheme":"arXiv"},{"subject":"Applied Physics (physics.app-ph)","lang":"en","subjectScheme":"arXiv"},{"subject":"FOS: Physical sciences","subjectScheme":"Fields of Science and Technology (FOS)"},{"schemeUri":"http://www.oecd.org/science/inno/38235147.pdf","subject":"FOS: Physical sciences","subjectScheme":"Fields of Science and Technology (FOS)"}],"contributors":[],"dates":[{"date":"2026-02-23T23:05:07Z","dateType":"Submitted","dateInformation":"v1"},{"date":"2026-02-25T01:11:09Z","dateType":"Updated","dateInformation":"v1"},{"date":"2026-02","dateType":"Available","dateInformation":"v1"},{"date":"2026","dateType":"Issued"}],"language":null,"types":{"schemaOrg":"CreativeWork","resourceTypeGeneral":"Preprint","citeproc":"article","bibtex":"misc","ris":"GEN","resourceType":"Article"},"relatedIdentifiers":[],"relatedItems":[],"sizes":[],"formats":[],"version":"1","rightsList":[{"rightsIdentifierScheme":"SPDX","rightsUri":"https://creativecommons.org/licenses/by/4.0/legalcode","schemeUri":"https://spdx.org/licenses/","rights":"Creative Commons Attribution 4.0 International","rightsIdentifier":"cc-by-4.0"}],"descriptions":[{"descriptionType":"Abstract","description":"Silicon-organic hybrid (SOH) platforms exhibit exceptional electro-optic (EO) properties, including high-speed operation, low energy consumption, and compact footprints. However, the absence of a scalable poling method for EO polymers, combined with the slow switching speeds characteristic of liquid crystals, has impeded the integration and compatibility of these materials with commercial silicon photonic foundries. On the other hand, the realization of very-large-scale photonic integrated circuits (PICs) in the native silicon photonics platform itself is impeded by the complexities associated with the wavelength and thermal stabilization for microring modulators (MRMs). This study establishes the foundation for a poling-free, CMOS-compatible SOH MRM platform by exploiting simultaneous AC phase shifts in ferroelectric nematic liquid crystals (FN-LCs). We present the first demonstration of an MRM coated with FN-LC, with both the RF signal and the DC bias applied to the same electrodes, taking advantage of the dual phase shift uniquely available in FN-LC. An EO bandwidth of f$_{-6dB}\\approx$ 7.8 GHz is achieved \\textendash~ the highest reported value for an SOH MRM to date. As a proof of concept, we demonstrate an approximately linear resonance shift across the full width at half maximum ($\\approx$ 150 pm/V), with a static power efficiency of $\\approx$ 4.5 nW/$π$ for an MRM occupying a total footprint of $\\approx$ 0.084 mm$^2$ and exhibiting an on-chip optical insertion loss of $\\approx$ 0.78 dB. Successful infiltration of FN-LC, selectively patterned on top of phase shifters, along with optical input/output channels established using free-form photonic wire bonds, is demonstrated in the proposed PIC."},{"descriptionType":"Other","description":"16 pages, 6 figures"}],"geoLocations":[],"fundingReferences":[],"url":"https://arxiv.org/abs/2602.20406","contentUrl":null,"metadataVersion":0,"schemaVersion":"http://datacite.org/schema/kernel-4","source":"mds","isActive":true,"state":"findable","reason":null,"viewCount":0,"downloadCount":0,"referenceCount":0,"citationCount":0,"partCount":0,"partOfCount":0,"versionCount":0,"versionOfCount":0,"created":"2026-02-25T02:49:20Z","registered":"2026-02-25T02:49:21Z","published":null,"updated":"2026-02-25T02:49:21Z"},"relationships":{"client":{"data":{"id":"arxiv.content","type":"clients"}}}},{"id":"10.48550/arxiv.2602.20404","type":"dois","attributes":{"doi":"10.48550/arxiv.2602.20404","identifiers":[{"identifier":"2602.20404","identifierType":"arXiv"}],"creators":[{"nameType":"Personal","givenName":"Xihe","familyName":"Gu","name":"Gu, Xihe","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Urbashi","familyName":"Mitra","name":"Mitra, Urbashi","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Tara","familyName":"Javidi","name":"Javidi, Tara","affiliation":[],"nameIdentifiers":[]}],"titles":[{"title":"$κ$-Explorer: A Unified Framework for Active Model Estimation in MDPs"}],"publisher":"arXiv","container":{},"publicationYear":2026,"subjects":[{"subject":"Machine Learning (cs.LG)","lang":"en","subjectScheme":"arXiv"},{"subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"},{"schemeUri":"http://www.oecd.org/science/inno/38235147.pdf","subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"}],"contributors":[],"dates":[{"date":"2026-02-23T22:56:32Z","dateType":"Submitted","dateInformation":"v1"},{"date":"2026-02-25T01:10:59Z","dateType":"Updated","dateInformation":"v1"},{"date":"2026-02","dateType":"Available","dateInformation":"v1"},{"date":"2026","dateType":"Issued"}],"language":null,"types":{"schemaOrg":"CreativeWork","resourceTypeGeneral":"Preprint","citeproc":"article","bibtex":"misc","ris":"GEN","resourceType":"Article"},"relatedIdentifiers":[],"relatedItems":[],"sizes":[],"formats":[],"version":"1","rightsList":[{"rightsUri":"http://arxiv.org/licenses/nonexclusive-distrib/1.0/","rights":"arXiv.org perpetual, non-exclusive license"}],"descriptions":[{"descriptionType":"Abstract","description":"In tabular Markov decision processes (MDPs) with perfect state observability, each trajectory provides active samples from the transition distributions conditioned on state-action pairs. Consequently, accurate model estimation depends on how the exploration policy allocates visitation frequencies in accordance with the intrinsic complexity of each transition distribution. Building on recent work on coverage-based exploration, we introduce a parameterized family of decomposable and concave objective functions $U_κ$ that explicitly incorporate both intrinsic estimation complexity and extrinsic visitation frequency. Moreover, the curvature $κ$ provides a unified treatment of various global objectives, such as the average-case and worst-case estimation error objectives. Using the closed-form characterization of the gradient of $U_κ$, we propose $κ$-Explorer, an active exploration algorithm that performs Frank-Wolfe-style optimization over state-action occupancy measures. The diminishing-returns structure of $U_κ$ naturally prioritizes underexplored and high-variance transitions, while preserving smoothness properties that enable efficient optimization. We establish tight regret guarantees for $κ$-Explorer and further introduce a fully online and computationally efficient surrogate algorithm for practical use. Experiments on benchmark MDPs demonstrate that $κ$-Explorer provides superior performance compared to existing exploration strategies."}],"geoLocations":[],"fundingReferences":[],"url":"https://arxiv.org/abs/2602.20404","contentUrl":null,"metadataVersion":0,"schemaVersion":"http://datacite.org/schema/kernel-4","source":"mds","isActive":true,"state":"findable","reason":null,"viewCount":0,"downloadCount":0,"referenceCount":0,"citationCount":0,"partCount":0,"partOfCount":0,"versionCount":0,"versionOfCount":0,"created":"2026-02-25T02:49:17Z","registered":"2026-02-25T02:49:18Z","published":null,"updated":"2026-02-25T02:49:18Z"},"relationships":{"client":{"data":{"id":"arxiv.content","type":"clients"}}}},{"id":"10.48550/arxiv.2602.20401","type":"dois","attributes":{"doi":"10.48550/arxiv.2602.20401","identifiers":[{"identifier":"2602.20401","identifierType":"arXiv"}],"creators":[{"nameType":"Personal","givenName":"Soumyadip","familyName":"Bhunia","name":"Bhunia, Soumyadip","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Yueze","familyName":"Gao","name":"Gao, Yueze","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Jack","familyName":"Woolley","name":"Woolley, Jack","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Ross","familyName":"Milverton","name":"Milverton, Ross","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Harry L","familyName":"Anderson","name":"Anderson, Harry L","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Raj","familyName":"Pandya","name":"Pandya, Raj","affiliation":[],"nameIdentifiers":[]}],"titles":[{"title":"Electronic dynamics in long linear and cyclic polyynes towards the carbyne limit"}],"publisher":"arXiv","container":{},"publicationYear":2026,"subjects":[{"subject":"Mesoscale and Nanoscale Physics (cond-mat.mes-hall)","lang":"en","subjectScheme":"arXiv"},{"subject":"Materials Science (cond-mat.mtrl-sci)","lang":"en","subjectScheme":"arXiv"},{"subject":"FOS: Physical sciences","subjectScheme":"Fields of Science and Technology (FOS)"},{"schemeUri":"http://www.oecd.org/science/inno/38235147.pdf","subject":"FOS: Physical sciences","subjectScheme":"Fields of Science and Technology (FOS)"}],"contributors":[],"dates":[{"date":"2026-02-23T22:44:02Z","dateType":"Submitted","dateInformation":"v1"},{"date":"2026-02-25T01:10:47Z","dateType":"Updated","dateInformation":"v1"},{"date":"2026-02","dateType":"Available","dateInformation":"v1"},{"date":"2026","dateType":"Issued"}],"language":null,"types":{"schemaOrg":"CreativeWork","resourceTypeGeneral":"Preprint","citeproc":"article","bibtex":"misc","ris":"GEN","resourceType":"Article"},"relatedIdentifiers":[],"relatedItems":[],"sizes":[],"formats":[],"version":"1","rightsList":[{"rightsIdentifierScheme":"SPDX","rightsUri":"https://creativecommons.org/licenses/by/4.0/legalcode","schemeUri":"https://spdx.org/licenses/","rights":"Creative Commons Attribution 4.0 International","rightsIdentifier":"cc-by-4.0"}],"descriptions":[{"descriptionType":"Abstract","description":"Carbyne-the one-dimensional sp-hybridised allotrope of carbon-has long been predicted to exhibit unique properties, yet its synthesis remains elusive. To probe its behaviour, finite sp-carbon chains such as cumulenes and polyynes have been studied, but work to date has focused almost exclusively on short, linear systems far from the infinite carbyne limit and without considering topology. Here, we investigate long (48-carbon) linear and cyclic polyynes using steady-state and ultrafast, temperature- and polarization-resolved optical and vibrational spectroscopy. We find highly delocalized ground states in both topologies, with Peierls distortions markedly weaker than in short chains. In contrast, excited states undergo rapid self-localisation, with the localisation pathway and subsequent intersystem crossing strongly dependent on chain length and topology. Unlike shorter polyynes, excited-state structural rearrangements are minimal, and comparison with theoretical predictions shows that properties, such as Huang-Rhys factors, have plateaued by 48 carbons. Our results reveal how topology influences the electronic dynamics of long polyynes and refines our understanding of sp-carbon systems approaching the carbyne limit"},{"descriptionType":"Other","description":"14 pages, 6 Figures"}],"geoLocations":[],"fundingReferences":[],"url":"https://arxiv.org/abs/2602.20401","contentUrl":null,"metadataVersion":0,"schemaVersion":"http://datacite.org/schema/kernel-4","source":"mds","isActive":true,"state":"findable","reason":null,"viewCount":0,"downloadCount":0,"referenceCount":0,"citationCount":0,"partCount":0,"partOfCount":0,"versionCount":0,"versionOfCount":0,"created":"2026-02-25T02:49:13Z","registered":"2026-02-25T02:49:14Z","published":null,"updated":"2026-02-25T02:49:14Z"},"relationships":{"client":{"data":{"id":"arxiv.content","type":"clients"}}}},{"id":"10.48550/arxiv.2602.20400","type":"dois","attributes":{"doi":"10.48550/arxiv.2602.20400","identifiers":[{"identifier":"2602.20400","identifierType":"arXiv"}],"creators":[{"nameType":"Personal","givenName":"Callum","familyName":"Canavan","name":"Canavan, Callum","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Aditya","familyName":"Shrivastava","name":"Shrivastava, Aditya","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Allison","familyName":"Qi","name":"Qi, Allison","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Jonathan","familyName":"Michala","name":"Michala, Jonathan","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Fabien","familyName":"Roger","name":"Roger, Fabien","affiliation":[],"nameIdentifiers":[]}],"titles":[{"title":"Three Concrete Challenges and Two Hopes for the Safety of Unsupervised Elicitation"}],"publisher":"arXiv","container":{},"publicationYear":2026,"subjects":[{"subject":"Machine Learning (cs.LG)","lang":"en","subjectScheme":"arXiv"},{"subject":"Artificial Intelligence (cs.AI)","lang":"en","subjectScheme":"arXiv"},{"subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"},{"schemeUri":"http://www.oecd.org/science/inno/38235147.pdf","subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"}],"contributors":[],"dates":[{"date":"2026-02-23T22:39:40Z","dateType":"Submitted","dateInformation":"v1"},{"date":"2026-02-25T01:10:46Z","dateType":"Updated","dateInformation":"v1"},{"date":"2026-02","dateType":"Available","dateInformation":"v1"},{"date":"2026","dateType":"Issued"}],"language":null,"types":{"schemaOrg":"CreativeWork","resourceTypeGeneral":"Preprint","citeproc":"article","bibtex":"misc","ris":"GEN","resourceType":"Article"},"relatedIdentifiers":[],"relatedItems":[],"sizes":[],"formats":[],"version":"1","rightsList":[{"rightsIdentifierScheme":"SPDX","rightsUri":"https://creativecommons.org/licenses/by/4.0/legalcode","schemeUri":"https://spdx.org/licenses/","rights":"Creative Commons Attribution 4.0 International","rightsIdentifier":"cc-by-4.0"}],"descriptions":[{"descriptionType":"Abstract","description":"To steer language models towards truthful outputs on tasks which are beyond human capability, previous work has suggested training models on easy tasks to steer them on harder ones (easy-to-hard generalization), or using unsupervised training algorithms to steer models with no external labels at all (unsupervised elicitation). Although techniques from both paradigms have been shown to improve model accuracy on a wide variety of tasks, we argue that the datasets used for these evaluations could cause overoptimistic evaluation results. Unlike many real-world datasets, they often (1) have no features with more salience than truthfulness, (2) have balanced training sets, and (3) contain only data points to which the model can give a well-defined answer. We construct datasets that lack each of these properties to stress-test a range of standard unsupervised elicitation and easy-to-hard generalization techniques. We find that no technique reliably performs well on any of these challenges. We also study ensembling and combining easy-to-hard and unsupervised techniques, and find they only partially mitigate performance degradation due to these challenges. We believe that overcoming these challenges should be a priority for future work on unsupervised elicitation."},{"descriptionType":"Other","description":"19 pages, 9 figures"}],"geoLocations":[],"fundingReferences":[],"url":"https://arxiv.org/abs/2602.20400","contentUrl":null,"metadataVersion":0,"schemaVersion":"http://datacite.org/schema/kernel-4","source":"mds","isActive":true,"state":"findable","reason":null,"viewCount":0,"downloadCount":0,"referenceCount":0,"citationCount":0,"partCount":0,"partOfCount":0,"versionCount":0,"versionOfCount":0,"created":"2026-02-25T02:49:11Z","registered":"2026-02-25T02:49:12Z","published":null,"updated":"2026-02-25T02:49:12Z"},"relationships":{"client":{"data":{"id":"arxiv.content","type":"clients"}}}},{"id":"10.48550/arxiv.2602.20398","type":"dois","attributes":{"doi":"10.48550/arxiv.2602.20398","identifiers":[{"identifier":"2602.20398","identifierType":"arXiv"}],"creators":[{"nameType":"Personal","givenName":"Eugenio","familyName":"Cruz-Ossa","name":"Cruz-Ossa, Eugenio","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Sebastian","familyName":"Perez-Salazar","name":"Perez-Salazar, Sebastian","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Victor","familyName":"Verdugo","name":"Verdugo, Victor","affiliation":[],"nameIdentifiers":[]}],"titles":[{"title":"Competition Versus Complexity in Multiple-Selection Prophet Inequalities"}],"publisher":"arXiv","container":{},"publicationYear":2026,"subjects":[{"subject":"Computer Science and Game Theory (cs.GT)","lang":"en","subjectScheme":"arXiv"},{"subject":"Optimization and Control (math.OC)","lang":"en","subjectScheme":"arXiv"},{"subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"},{"schemeUri":"http://www.oecd.org/science/inno/38235147.pdf","subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"},{"subject":"FOS: Mathematics","subjectScheme":"Fields of Science and Technology (FOS)"},{"schemeUri":"http://www.oecd.org/science/inno/38235147.pdf","subject":"FOS: Mathematics","subjectScheme":"Fields of Science and Technology (FOS)"}],"contributors":[],"dates":[{"date":"2026-02-23T22:22:55Z","dateType":"Submitted","dateInformation":"v1"},{"date":"2026-02-25T01:10:02Z","dateType":"Updated","dateInformation":"v1"},{"date":"2026-02","dateType":"Available","dateInformation":"v1"},{"date":"2026","dateType":"Issued"}],"language":null,"types":{"schemaOrg":"CreativeWork","resourceTypeGeneral":"Preprint","citeproc":"article","bibtex":"misc","ris":"GEN","resourceType":"Article"},"relatedIdentifiers":[],"relatedItems":[],"sizes":[],"formats":[],"version":"1","rightsList":[{"rightsIdentifierScheme":"SPDX","rightsUri":"https://creativecommons.org/licenses/by/4.0/legalcode","schemeUri":"https://spdx.org/licenses/","rights":"Creative Commons Attribution 4.0 International","rightsIdentifier":"cc-by-4.0"}],"descriptions":[{"descriptionType":"Abstract","description":"Competition complexity formalizes a compelling intuition: rather than refining the mechanism, how much additional competition is sufficient for a simple mechanism to compete with an optimal one? We begin the study of this question in multi-unit pricing for welfare maximization using prophet inequalities. An online decision-maker observes $m \\geq k$ nonnegative values drawn independently from a known distribution, may select up to $k$ of them, and aims to maximize the expected sum of selected values. The benchmark is a prophet who observes a sequence of length $n \\geq k$ and selects the $k$ largest values. We focus on the widely adopted class of single-threshold algorithms and fully characterize their $(1-\\varepsilon)$-competition complexity. Notably, our results reveal a sharp competition-induced phase transition: in the absence of competition, single-threshold algorithms are fundamentally limited to a $1-1/\\sqrt{2kπ}$ fraction of the prophet value, whereas even a $1\\%$ multiplicative increase beyond $n$ observations suffices to achieve a $1-\\exp(-Θ(k))$ fraction. Another notable result happens when $k=1$: we show that the $(1-\\varepsilon)$-competition complexity is exactly $\\ln(1/\\varepsilon)$, fully resolving an open question by Brustle et al. [Math. Oper. Res. 2024]. Our analysis is based on infinite-dimensional linear programming and duality arguments."}],"geoLocations":[],"fundingReferences":[],"url":"https://arxiv.org/abs/2602.20398","contentUrl":null,"metadataVersion":0,"schemaVersion":"http://datacite.org/schema/kernel-4","source":"mds","isActive":true,"state":"findable","reason":null,"viewCount":0,"downloadCount":0,"referenceCount":0,"citationCount":0,"partCount":0,"partOfCount":0,"versionCount":0,"versionOfCount":0,"created":"2026-02-25T02:49:08Z","registered":"2026-02-25T02:49:09Z","published":null,"updated":"2026-02-25T02:49:09Z"},"relationships":{"client":{"data":{"id":"arxiv.content","type":"clients"}}}},{"id":"10.48550/arxiv.2602.20397","type":"dois","attributes":{"doi":"10.48550/arxiv.2602.20397","identifiers":[{"identifier":"2602.20397","identifierType":"arXiv"}],"creators":[{"nameType":"Personal","givenName":"Erik B.","familyName":"Monson","name":"Monson, Erik B.","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Bret D.","familyName":"Lehmer","name":"Lehmer, Bret D.","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Amirnezam","familyName":"Amiri","name":"Amiri, Amirnezam","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Karina","familyName":"Barboza","name":"Barboza, Karina","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Ashley","familyName":"Barnes","name":"Barnes, Ashley","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Antara R.","familyName":"Basu-Zych","name":"Basu-Zych, Antara R.","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Daniel A.","familyName":"Dale","name":"Dale, Daniel A.","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Sanskriti","familyName":"Das","name":"Das, Sanskriti","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Simthembile","familyName":"Dlamini","name":"Dlamini, Simthembile","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Simon C. O.","familyName":"Glover","name":"Glover, Simon C. O.","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Kathryn","familyName":"Kreckel","name":"Kreckel, Kathryn","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Laura A.","familyName":"Lopez","name":"Lopez, Laura A.","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Sebastian","familyName":"Lopez","name":"Lopez, Sebastian","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Smita","familyName":"Mathur","name":"Mathur, Smita","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Hsi-An","familyName":"Pan","name":"Pan, Hsi-An","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Jennifer A.","familyName":"Rodriguez","name":"Rodriguez, Jennifer A.","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Karin M.","familyName":"Sandstrom","name":"Sandstrom, Karin M.","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Sumit K.","familyName":"Sarbadhicary","name":"Sarbadhicary, Sumit K.","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Jiayi","familyName":"Sun","name":"Sun, Jiayi","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Thomas G.","familyName":"Williams","name":"Williams, Thomas G.","affiliation":[],"nameIdentifiers":[]}],"titles":[{"title":"Constraining the Sub-Galactic Relationship Between Star Formation and the Hot Interstellar Medium in NGC 4254"}],"publisher":"arXiv","container":{},"publicationYear":2026,"subjects":[{"subject":"Astrophysics of Galaxies (astro-ph.GA)","lang":"en","subjectScheme":"arXiv"},{"subject":"FOS: Physical sciences","subjectScheme":"Fields of Science and Technology (FOS)"},{"schemeUri":"http://www.oecd.org/science/inno/38235147.pdf","subject":"FOS: Physical sciences","subjectScheme":"Fields of Science and Technology (FOS)"}],"contributors":[],"dates":[{"date":"2026-02-23T22:21:30Z","dateType":"Submitted","dateInformation":"v1"},{"date":"2026-02-25T01:10:00Z","dateType":"Updated","dateInformation":"v1"},{"date":"2026-02","dateType":"Available","dateInformation":"v1"},{"date":"2026","dateType":"Issued"}],"language":null,"types":{"schemaOrg":"CreativeWork","resourceTypeGeneral":"Preprint","citeproc":"article","bibtex":"misc","ris":"GEN","resourceType":"Article"},"relatedIdentifiers":[],"relatedItems":[],"sizes":[],"formats":[],"version":"1","rightsList":[{"rightsIdentifierScheme":"SPDX","rightsUri":"https://creativecommons.org/licenses/by/4.0/legalcode","schemeUri":"https://spdx.org/licenses/","rights":"Creative Commons Attribution 4.0 International","rightsIdentifier":"cc-by-4.0"}],"descriptions":[{"descriptionType":"Abstract","description":"We investigate the relationship between star formation and X-ray emission from the hot interstellar medium (ISM) on $\\sim$kpc scales in NGC 4254 (M99) by combining spatially resolved star formation histories (SFHs) and Bayesian X-ray spectral fitting. We measure sub-galactic star formation rates (SFR) by modeling spectrophotometric UV-IR data with flexible SFHs, and we produce point-source-subtracted maps of the diffuse X-ray emission using Chandra data. We extract and fit the spectra of 5 regions selected by their SFR density $Σ_{\\rm SFR}$, deriving hot gas luminosities and plasma temperatures. We examine the sub-galactic $kT-Σ_{\\rm SFR}$ and $L^{\\rm gas}_X-Σ_{\\rm SFR}$ scaling relations in NGC 4254, and compare to predictions from simple models of the feedback into the ISM from core collapse supernovae (CCSNe). The hot gas emission from NGC 4254 is consistent with thermalization of $\\approx 40-50\\%$ of the energy from CCSNe in the ISM, and mass-loading of the CCSNe ejecta which decreases as $Σ_{\\rm SFR}^{-1/3}$. Our optimized model implies a temperature and X-ray production efficiency that scale as $kT = (0.72^{+0.26}_{-0.18}~{\\rm keV}) Σ_{\\rm SFR}^{0.34\\pm0.10}$ and $η= (0.03^{+0.02}_{-0.01}) Σ_{\\rm SFR}^{0.34\\pm0.18}$, respectively, for $Σ_{\\rm SFR} = 0.01-0.13~{\\rm M_{\\odot}~yr^{-1}~kpc^{-2}}$. We also compare the properties of the hot ISM to other ISM phases using data from the PHANGS program. The diffuse X-ray emission of a given region is on average 200 times fainter than the H$α$ emission, and we see evidence that the hot ISM is over-pressurized compared to the large-scale dynamical equilibrium pressure of the galaxy, consistent with expansion of the hot ISM into the ambient medium."},{"descriptionType":"Other","description":"28 pages, 2 page appendix, 18 figures, 8 tables. Submitted to AAS journals"}],"geoLocations":[],"fundingReferences":[],"url":"https://arxiv.org/abs/2602.20397","contentUrl":null,"metadataVersion":0,"schemaVersion":"http://datacite.org/schema/kernel-4","source":"mds","isActive":true,"state":"findable","reason":null,"viewCount":0,"downloadCount":0,"referenceCount":0,"citationCount":0,"partCount":0,"partOfCount":0,"versionCount":0,"versionOfCount":0,"created":"2026-02-25T02:49:07Z","registered":"2026-02-25T02:49:08Z","published":null,"updated":"2026-02-25T02:49:08Z"},"relationships":{"client":{"data":{"id":"arxiv.content","type":"clients"}}}},{"id":"10.48550/arxiv.2602.20395","type":"dois","attributes":{"doi":"10.48550/arxiv.2602.20395","identifiers":[{"identifier":"2602.20395","identifierType":"arXiv"}],"creators":[{"nameType":"Personal","givenName":"Tristan","familyName":"Goodwill","name":"Goodwill, Tristan","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Jeremy","familyName":"Hoskins","name":"Hoskins, Jeremy","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Zydrunas","familyName":"Gimbutas","name":"Gimbutas, Zydrunas","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Bowei","familyName":"Wu","name":"Wu, Bowei","affiliation":[],"nameIdentifiers":[]}],"titles":[{"title":"A parametrix for the surface Stokes equation"}],"publisher":"arXiv","container":{},"publicationYear":2026,"subjects":[{"subject":"Numerical Analysis (math.NA)","lang":"en","subjectScheme":"arXiv"},{"subject":"FOS: Mathematics","subjectScheme":"Fields of Science and Technology (FOS)"},{"schemeUri":"http://www.oecd.org/science/inno/38235147.pdf","subject":"FOS: Mathematics","subjectScheme":"Fields of Science and Technology (FOS)"},{"subject":"65N38, 65N80, 65R20, 65D05","lang":"en","subjectScheme":"MSC"}],"contributors":[],"dates":[{"date":"2026-02-23T22:20:03Z","dateType":"Submitted","dateInformation":"v1"},{"date":"2026-02-25T01:09:58Z","dateType":"Updated","dateInformation":"v1"},{"date":"2026-02","dateType":"Available","dateInformation":"v1"},{"date":"2026","dateType":"Issued"}],"language":null,"types":{"schemaOrg":"CreativeWork","resourceTypeGeneral":"Preprint","citeproc":"article","bibtex":"misc","ris":"GEN","resourceType":"Article"},"relatedIdentifiers":[],"relatedItems":[],"sizes":[],"formats":[],"version":"1","rightsList":[{"rightsUri":"http://arxiv.org/licenses/nonexclusive-distrib/1.0/","rights":"arXiv.org perpetual, non-exclusive license"}],"descriptions":[{"descriptionType":"Abstract","description":"We introduce an integral equation formulation of the surface Stokes equations, constructed using two-dimensional Stokeslets. The resulting integral equations are Fredholm integral equations of the second kind and can be discretized to high order using standard tools. Since the resulting discrete linear systems are dense, we describe and analyze a proxy shell method to construct fast direct solvers for these systems. The properties of our integral equation, and the performance of the resulting numerical scheme, are illustrated with several representative numerical examples."}],"geoLocations":[],"fundingReferences":[],"url":"https://arxiv.org/abs/2602.20395","contentUrl":null,"metadataVersion":0,"schemaVersion":"http://datacite.org/schema/kernel-4","source":"mds","isActive":true,"state":"findable","reason":null,"viewCount":0,"downloadCount":0,"referenceCount":0,"citationCount":0,"partCount":0,"partOfCount":0,"versionCount":0,"versionOfCount":0,"created":"2026-02-25T02:49:04Z","registered":"2026-02-25T02:49:05Z","published":null,"updated":"2026-02-25T02:49:05Z"},"relationships":{"client":{"data":{"id":"arxiv.content","type":"clients"}}}},{"id":"10.48550/arxiv.2602.20392","type":"dois","attributes":{"doi":"10.48550/arxiv.2602.20392","identifiers":[{"identifier":"2602.20392","identifierType":"arXiv"}],"creators":[{"nameType":"Personal","givenName":"Travis","familyName":"Cunningham","name":"Cunningham, Travis","affiliation":[],"nameIdentifiers":[]}],"titles":[{"title":"Improved fractal Weyl bounds matching improved spectral gaps for hyperbolic surfaces and open quantum maps"}],"publisher":"arXiv","container":{},"publicationYear":2026,"subjects":[{"subject":"Spectral Theory (math.SP)","lang":"en","subjectScheme":"arXiv"},{"subject":"Analysis of PDEs (math.AP)","lang":"en","subjectScheme":"arXiv"},{"subject":"FOS: Mathematics","subjectScheme":"Fields of Science and Technology (FOS)"},{"schemeUri":"http://www.oecd.org/science/inno/38235147.pdf","subject":"FOS: Mathematics","subjectScheme":"Fields of Science and Technology (FOS)"},{"subject":"81U24 (Primary)35P25, 58J50 (Secondary)","lang":"en","subjectScheme":"MSC"}],"contributors":[],"dates":[{"date":"2026-02-23T22:12:11Z","dateType":"Submitted","dateInformation":"v1"},{"date":"2026-02-25T01:09:50Z","dateType":"Updated","dateInformation":"v1"},{"date":"2026-02","dateType":"Available","dateInformation":"v1"},{"date":"2026","dateType":"Issued"}],"language":null,"types":{"schemaOrg":"CreativeWork","resourceTypeGeneral":"Preprint","citeproc":"article","bibtex":"misc","ris":"GEN","resourceType":"Article"},"relatedIdentifiers":[],"relatedItems":[],"sizes":[],"formats":[],"version":"1","rightsList":[{"rightsUri":"http://arxiv.org/licenses/nonexclusive-distrib/1.0/","rights":"arXiv.org perpetual, non-exclusive license"}],"descriptions":[{"descriptionType":"Abstract","description":"We prove a new fractal Weyl upper bound for the high-energy distribution of resonances of convex co-compact hyperbolic surfaces which matches the improved spectral gap given by Fourier decay. This improves upon the fractal Weyl bound of Dyatlov which matches the Patterson-Sullivan spectral gap. We also give a new resolvent estimate improving the ones given by Dyatlov-Zahl and Dyatlov. Analogous results are obtained for quantum open baker's maps, improving an estimate of Dyatlov-Jin, where we also give an improved fractal Weyl bound matching a spectral gap given by additive energy estimates. We refine known methods for proving fractal Weyl bounds which reduce the problem to an estimate of a certain determinant function; however, we use a different determinant function which allows us to make sharper estimates by applying the methods of proof of the fractal uncertainty principle in each setting."},{"descriptionType":"Other","description":"23 pages, 2 figures"}],"geoLocations":[],"fundingReferences":[],"url":"https://arxiv.org/abs/2602.20392","contentUrl":null,"metadataVersion":0,"schemaVersion":"http://datacite.org/schema/kernel-4","source":"mds","isActive":true,"state":"findable","reason":null,"viewCount":0,"downloadCount":0,"referenceCount":0,"citationCount":0,"partCount":0,"partOfCount":0,"versionCount":0,"versionOfCount":0,"created":"2026-02-25T02:48:59Z","registered":"2026-02-25T02:49:00Z","published":null,"updated":"2026-02-25T02:49:00Z"},"relationships":{"client":{"data":{"id":"arxiv.content","type":"clients"}}}},{"id":"10.48550/arxiv.2602.20389","type":"dois","attributes":{"doi":"10.48550/arxiv.2602.20389","identifiers":[{"identifier":"2602.20389","identifierType":"arXiv"}],"creators":[{"nameType":"Personal","givenName":"Iris","familyName":"Breda","name":"Breda, Iris","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Glenn","familyName":"van de Ven","name":"van de Ven, Glenn","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Sabine","familyName":"Thater","name":"Thater, Sabine","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Federica","familyName":"Mauro","name":"Mauro, Federica","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Stergios","familyName":"Amarantidis","name":"Amarantidis, Stergios","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"J.","familyName":"Falcón-Barroso","name":"Falcón-Barroso, J.","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Prashin","familyName":"Jethwa","name":"Jethwa, Prashin","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Anja","familyName":"Feldmeier-Krause","name":"Feldmeier-Krause, Anja","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Masato","familyName":"Onodera","name":"Onodera, Masato","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Gerhard","familyName":"Hensler","name":"Hensler, Gerhard","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Gauri","familyName":"Sharma","name":"Sharma, Gauri","affiliation":[],"nameIdentifiers":[]}],"titles":[{"title":"Glance: A Comprehensive Framework for Galactic Archaeology"}],"publisher":"arXiv","container":{},"publicationYear":2026,"subjects":[{"subject":"Astrophysics of Galaxies (astro-ph.GA)","lang":"en","subjectScheme":"arXiv"},{"subject":"FOS: Physical sciences","subjectScheme":"Fields of Science and Technology (FOS)"},{"schemeUri":"http://www.oecd.org/science/inno/38235147.pdf","subject":"FOS: Physical sciences","subjectScheme":"Fields of Science and Technology (FOS)"}],"contributors":[],"dates":[{"date":"2026-02-23T22:05:14Z","dateType":"Submitted","dateInformation":"v1"},{"date":"2026-02-25T01:09:34Z","dateType":"Updated","dateInformation":"v1"},{"date":"2026-02","dateType":"Available","dateInformation":"v1"},{"date":"2026","dateType":"Issued"}],"language":null,"types":{"schemaOrg":"CreativeWork","resourceTypeGeneral":"Preprint","citeproc":"article","bibtex":"misc","ris":"GEN","resourceType":"Article"},"relatedIdentifiers":[],"relatedItems":[],"sizes":[],"formats":[],"version":"1","rightsList":[{"rightsUri":"http://arxiv.org/licenses/nonexclusive-distrib/1.0/","rights":"arXiv.org perpetual, non-exclusive license"}],"descriptions":[{"descriptionType":"Abstract","description":"A central topic in extragalactic astronomy is understanding the formation and evolutionary histories of galaxies. These systems often comprise multiple structural components with distinct physical and dynamical properties, making it challenging to disentangle their individual contributions. Aiming at investigating the true structure of the inner stellar disk, we have developed a comprehensive pipeline for the chronochemical and dynamical analysis of galaxies (Glance: Galactic archaeoLogy via chronochemicAl \u0026amp; dyNamiCal modElling). The presented pipeline employs several state-of-the-art techniques by integrating them into a single, automated pipeline, enabling streamlined analysis of integral-field spectroscopy data, by allowing users to easily and directly extract valuable information on stellar populations, kinematics, dynamics, and gas properties. It automates multiple analysis techniques, including stellar population synthesis (Fado, Starlight, post-processing with RemoveYoung, kinematic extraction (pPXF, Bayes-LOSVD), and dynamical modelling (Dynamite). It handles tasks such as Galactic extinction correction, de-redshifting, Voronoi binning, and nebular continuum correction, while offering extensive customization options. Parallel processing significantly reduces computational time. When applied to MUSE data sampling the central region of NGC 1566, this methodology reveals that its stellar disk significantly deviates from the conventional exponential model, challenging the assumption of universality in disk morphology. In summary, this work presents a powerful, publicly available pipeline for conducting galactic archaeology, designed to advance our understanding of the formation and evolution of galaxies."},{"descriptionType":"Other","description":"accepted for publication in MNRAS; pipeline available at https://gitlab.com/iris.b/glance"}],"geoLocations":[],"fundingReferences":[],"url":"https://arxiv.org/abs/2602.20389","contentUrl":null,"metadataVersion":0,"schemaVersion":"http://datacite.org/schema/kernel-4","source":"mds","isActive":true,"state":"findable","reason":null,"viewCount":0,"downloadCount":0,"referenceCount":0,"citationCount":0,"partCount":0,"partOfCount":0,"versionCount":0,"versionOfCount":0,"created":"2026-02-25T02:48:55Z","registered":"2026-02-25T02:48:56Z","published":null,"updated":"2026-02-25T02:48:56Z"},"relationships":{"client":{"data":{"id":"arxiv.content","type":"clients"}}}},{"id":"10.48550/arxiv.2602.20388","type":"dois","attributes":{"doi":"10.48550/arxiv.2602.20388","identifiers":[{"identifier":"2602.20388","identifierType":"arXiv"}],"creators":[{"nameType":"Personal","givenName":"Robert","familyName":"Cardona","name":"Cardona, Robert","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Fabio","familyName":"Gironella","name":"Gironella, Fabio","affiliation":[],"nameIdentifiers":[]}],"titles":[{"title":"$C^0$-Poisson geometry, coisotropic submanifolds, and clean intersection points"}],"publisher":"arXiv","container":{},"publicationYear":2026,"subjects":[{"subject":"Symplectic Geometry (math.SG)","lang":"en","subjectScheme":"arXiv"},{"subject":"Differential Geometry (math.DG)","lang":"en","subjectScheme":"arXiv"},{"subject":"FOS: Mathematics","subjectScheme":"Fields of Science and Technology (FOS)"},{"schemeUri":"http://www.oecd.org/science/inno/38235147.pdf","subject":"FOS: Mathematics","subjectScheme":"Fields of Science and Technology (FOS)"},{"subject":"53D17, 57R30","lang":"en","subjectScheme":"MSC"}],"contributors":[],"dates":[{"date":"2026-02-23T22:02:03Z","dateType":"Submitted","dateInformation":"v1"},{"date":"2026-02-25T01:09:33Z","dateType":"Updated","dateInformation":"v1"},{"date":"2026-02","dateType":"Available","dateInformation":"v1"},{"date":"2026","dateType":"Issued"}],"language":null,"types":{"schemaOrg":"CreativeWork","resourceTypeGeneral":"Preprint","citeproc":"article","bibtex":"misc","ris":"GEN","resourceType":"Article"},"relatedIdentifiers":[],"relatedItems":[],"sizes":[],"formats":[],"version":"1","rightsList":[{"rightsUri":"http://arxiv.org/licenses/nonexclusive-distrib/1.0/","rights":"arXiv.org perpetual, non-exclusive license"}],"descriptions":[{"descriptionType":"Abstract","description":"In this work, we initiate the study of rigidity and non-rigidity phenomena for Poisson homeomorphisms, defined as uniform $C^0$-limits of Poisson diffeomorphisms. First, we prove that Poisson homeomorphisms preserve the singular symplectic foliation: they map symplectic leaves to symplectic leaves by symplectic homeomorphisms. Second, we establish the $C^0$-rigidity of coisotropic submanifolds in Poisson manifolds. A key ingredient is the notion of ''clean intersection point'' between a submanifold and the leaves of a singular foliation, whose study is of independent interest for singular foliation theory and Poisson geometry. In contrast with the symplectic case, characteristic foliations of coisotropic submanifolds are not rigid under Poisson homeomorphisms, exhibiting flexibility phenomena specific to the Poisson setting. We discuss partial rigidity results, introduce a topological invariant of coisotropic submanifolds, the $C^0$-characteristic partition, and show that $C^0$-coisotropic submanifolds are non-smooth objects whose vanishing ideal defines a Lie subalgebra of the Poisson algebra. Finally, we consider Poisson homeomorphisms that lift to symplectic homeomorphisms of a symplectic realization and show that nearly all Poisson manifolds admit non-liftable Poisson homeomorphisms. Our main results answer three questions posed by Joksimović and Mărcuţ."},{"descriptionType":"Other","description":"55 pages, 2 figures. Comments are welcome!"}],"geoLocations":[],"fundingReferences":[],"url":"https://arxiv.org/abs/2602.20388","contentUrl":null,"metadataVersion":0,"schemaVersion":"http://datacite.org/schema/kernel-4","source":"mds","isActive":true,"state":"findable","reason":null,"viewCount":0,"downloadCount":0,"referenceCount":0,"citationCount":0,"partCount":0,"partOfCount":0,"versionCount":0,"versionOfCount":0,"created":"2026-02-25T02:48:54Z","registered":"2026-02-25T02:48:54Z","published":null,"updated":"2026-02-25T02:48:54Z"},"relationships":{"client":{"data":{"id":"arxiv.content","type":"clients"}}}},{"id":"10.48550/arxiv.2602.20387","type":"dois","attributes":{"doi":"10.48550/arxiv.2602.20387","identifiers":[{"identifier":"2602.20387","identifierType":"arXiv"}],"creators":[{"nameType":"Personal","givenName":"Herbert","familyName":"Batte","name":"Batte, Herbert","affiliation":[],"nameIdentifiers":[]}],"titles":[{"title":"On Wagstaff primes in the $k$-Lucas number sequence"}],"publisher":"arXiv","container":{},"publicationYear":2026,"subjects":[{"subject":"Number Theory (math.NT)","lang":"en","subjectScheme":"arXiv"},{"subject":"FOS: Mathematics","subjectScheme":"Fields of Science and Technology (FOS)"},{"schemeUri":"http://www.oecd.org/science/inno/38235147.pdf","subject":"FOS: Mathematics","subjectScheme":"Fields of Science and Technology (FOS)"},{"subject":"11A41, 11B39, 11D61, 11D45","lang":"en","subjectScheme":"MSC"}],"contributors":[],"dates":[{"date":"2026-02-23T22:01:45Z","dateType":"Submitted","dateInformation":"v1"},{"date":"2026-02-25T01:09:32Z","dateType":"Updated","dateInformation":"v1"},{"date":"2026-02","dateType":"Available","dateInformation":"v1"},{"date":"2026","dateType":"Issued"}],"language":null,"types":{"schemaOrg":"CreativeWork","resourceTypeGeneral":"Preprint","citeproc":"article","bibtex":"misc","ris":"GEN","resourceType":"Article"},"relatedIdentifiers":[],"relatedItems":[],"sizes":[],"formats":[],"version":"1","rightsList":[{"rightsIdentifierScheme":"SPDX","rightsUri":"https://creativecommons.org/licenses/by/4.0/legalcode","schemeUri":"https://spdx.org/licenses/","rights":"Creative Commons Attribution 4.0 International","rightsIdentifier":"cc-by-4.0"}],"descriptions":[{"descriptionType":"Abstract","description":"A Wagstaff prime is a prime number of the form $(2^{\\mathfrak{p}}+1)/3$, where $\\mathfrak{p}$ is an odd prime. Let $(L_n^{(k)})_{n\\geq 2-k}$ be the $k$-Lucas number sequence defined by the recurrence relation\n $ L_n^{(k)} = L_{n-1}^{(k)} + \\cdots + L_{n-k}^{(k)}$, for all $n \\ge 2$, with initial terms \\( L_0^{(k)} = 2 \\) and \\( L_1^{(k)} = 1 \\) for all \\( k \\ge 2 \\), and \\( L_{2-k}^{(k)} = \\cdots = L_{-1}^{(k)} = 0 \\) for \\( k \\ge 3 \\). In this paper, we show that the only solutions to the Diophantine equation $L_n^{(k)} = (2^{\\mathfrak{p}}+1)/3$ are $(n,k,\\mathfrak{p})\\in\\{(5,2,5),(6,4,7)\\}\\cup \\{(2,k,3):k\\ge 2\\}$. We use linear forms in logarithms and the LLL reduction method to prove our result."},{"descriptionType":"Other","description":"9 pages. arXiv admin note: text overlap with arXiv:2602.17903"}],"geoLocations":[],"fundingReferences":[],"url":"https://arxiv.org/abs/2602.20387","contentUrl":null,"metadataVersion":0,"schemaVersion":"http://datacite.org/schema/kernel-4","source":"mds","isActive":true,"state":"findable","reason":null,"viewCount":0,"downloadCount":0,"referenceCount":0,"citationCount":0,"partCount":0,"partOfCount":0,"versionCount":0,"versionOfCount":0,"created":"2026-02-25T02:48:52Z","registered":"2026-02-25T02:48:53Z","published":null,"updated":"2026-02-25T02:48:53Z"},"relationships":{"client":{"data":{"id":"arxiv.content","type":"clients"}}}},{"id":"10.48550/arxiv.2602.20385","type":"dois","attributes":{"doi":"10.48550/arxiv.2602.20385","identifiers":[{"identifier":"2602.20385","identifierType":"arXiv"}],"creators":[{"nameType":"Personal","givenName":"Junghyun","familyName":"Koo","name":"Koo, Junghyun","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Weideng","familyName":"Sun","name":"Sun, Weideng","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Donghwan","familyName":"Kim","name":"Kim, Donghwan","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Hongseung","familyName":"Lee","name":"Lee, Hongseung","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Chengyu","familyName":"Zhu","name":"Zhu, Chengyu","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Kiyoung","familyName":"Lee","name":"Lee, Kiyoung","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Hagyoul","familyName":"Bae","name":"Bae, Hagyoul","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Bharat","familyName":"Jalan","name":"Jalan, Bharat","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Gang","familyName":"Qiu","name":"Qiu, Gang","affiliation":[],"nameIdentifiers":[]}],"titles":[{"title":"Demonstration of High-Performance Ultra-Wide Bandgap SrSnO$_3$ Top-Gated MOSFETs"}],"publisher":"arXiv","container":{},"publicationYear":2026,"subjects":[{"subject":"Materials Science (cond-mat.mtrl-sci)","lang":"en","subjectScheme":"arXiv"},{"subject":"FOS: Physical sciences","subjectScheme":"Fields of Science and Technology (FOS)"},{"schemeUri":"http://www.oecd.org/science/inno/38235147.pdf","subject":"FOS: Physical sciences","subjectScheme":"Fields of Science and Technology (FOS)"}],"contributors":[],"dates":[{"date":"2026-02-23T21:55:31Z","dateType":"Submitted","dateInformation":"v1"},{"date":"2026-02-25T01:09:22Z","dateType":"Updated","dateInformation":"v1"},{"date":"2026-02","dateType":"Available","dateInformation":"v1"},{"date":"2026","dateType":"Issued"}],"language":null,"types":{"schemaOrg":"CreativeWork","resourceTypeGeneral":"Preprint","citeproc":"article","bibtex":"misc","ris":"GEN","resourceType":"Article"},"relatedIdentifiers":[],"relatedItems":[],"sizes":[],"formats":[],"version":"1","rightsList":[{"rightsIdentifierScheme":"SPDX","rightsUri":"https://creativecommons.org/licenses/by/4.0/legalcode","schemeUri":"https://spdx.org/licenses/","rights":"Creative Commons Attribution 4.0 International","rightsIdentifier":"cc-by-4.0"}],"descriptions":[{"descriptionType":"Abstract","description":"We report the demonstration of high-performance top-gated metal-oxide-semiconductor field-effect transistors (MOSFETs) based on the ultra-wide bandgap perovskite oxide SrSnO$_3$ (SSO). Using hybrid molecular beam epitaxy-grown SSO channels and ALD-deposited HfO$_2$ gate dielectrics, the devices exhibit field-effect mobility exceeding 65 cm$^2$/V$\\cdot$s, an on-state current up to 194 mA/mm, an on/off current ratio above $10^8$, and a contact resistance of 0.66 $Ω\\cdot$mm. The devices also show a near-ideal subthreshold slope of 68 mV/dec and negligible hysteresis, indicating a high-quality dielectric/semiconductor interface. These results establish SrSnO$_3$ as a promising ultra-wide bandgap oxide semiconductor platform for high-performance power electronic applications."}],"geoLocations":[],"fundingReferences":[],"url":"https://arxiv.org/abs/2602.20385","contentUrl":null,"metadataVersion":0,"schemaVersion":"http://datacite.org/schema/kernel-4","source":"mds","isActive":true,"state":"findable","reason":null,"viewCount":0,"downloadCount":0,"referenceCount":0,"citationCount":0,"partCount":0,"partOfCount":0,"versionCount":0,"versionOfCount":0,"created":"2026-02-25T02:48:49Z","registered":"2026-02-25T02:48:50Z","published":null,"updated":"2026-02-25T02:48:50Z"},"relationships":{"client":{"data":{"id":"arxiv.content","type":"clients"}}}},{"id":"10.48550/arxiv.2602.20383","type":"dois","attributes":{"doi":"10.48550/arxiv.2602.20383","identifiers":[{"identifier":"2602.20383","identifierType":"arXiv"}],"creators":[{"nameType":"Personal","givenName":"Joel","familyName":"Persson","name":"Persson, Joel","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Jurriën","familyName":"Bakker","name":"Bakker, Jurriën","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Dennis","familyName":"Bohle","name":"Bohle, Dennis","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Stefan","familyName":"Feuerriegel","name":"Feuerriegel, Stefan","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Florian","familyName":"von Wangenheim","name":"von Wangenheim, Florian","affiliation":[],"nameIdentifiers":[]}],"titles":[{"title":"Detecting and Mitigating Group Bias in Heterogeneous Treatment Effects"}],"publisher":"arXiv","container":{},"publicationYear":2026,"subjects":[{"subject":"Methodology (stat.ME)","lang":"en","subjectScheme":"arXiv"},{"subject":"Machine Learning (cs.LG)","lang":"en","subjectScheme":"arXiv"},{"subject":"Econometrics (econ.EM)","lang":"en","subjectScheme":"arXiv"},{"subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"},{"schemeUri":"http://www.oecd.org/science/inno/38235147.pdf","subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"},{"subject":"FOS: Economics and business","subjectScheme":"Fields of Science and Technology (FOS)"},{"schemeUri":"http://www.oecd.org/science/inno/38235147.pdf","subject":"FOS: Economics and business","subjectScheme":"Fields of Science and Technology (FOS)"}],"contributors":[],"dates":[{"date":"2026-02-23T21:47:01Z","dateType":"Submitted","dateInformation":"v1"},{"date":"2026-02-25T01:09:09Z","dateType":"Updated","dateInformation":"v1"},{"date":"2026-02","dateType":"Available","dateInformation":"v1"},{"date":"2026","dateType":"Issued"}],"language":null,"types":{"schemaOrg":"CreativeWork","resourceTypeGeneral":"Preprint","citeproc":"article","bibtex":"misc","ris":"GEN","resourceType":"Article"},"relatedIdentifiers":[],"relatedItems":[],"sizes":[],"formats":[],"version":"1","rightsList":[{"rightsIdentifierScheme":"SPDX","rightsUri":"https://creativecommons.org/licenses/by/4.0/legalcode","schemeUri":"https://spdx.org/licenses/","rights":"Creative Commons Attribution 4.0 International","rightsIdentifier":"cc-by-4.0"}],"descriptions":[{"descriptionType":"Abstract","description":"Heterogeneous treatment effects (HTEs) are increasingly estimated using machine learning models that produce highly personalized predictions of treatment effects. In practice, however, predicted treatment effects are rarely interpreted, reported, or audited at the individual level but, instead, are often aggregated to broader subgroups, such as demographic segments, risk strata, or markets. We show that such aggregation can induce systematic bias of the group-level causal effect: even when models for predicting the individual-level conditional average treatment effect (CATE) are correctly specified and trained on data from randomized experiments, aggregating the predicted CATEs up to the group level does not, in general, recover the corresponding group average treatment effect (GATE). We develop a unified statistical framework to detect and mitigate this form of group bias in randomized experiments. We first define group bias as the discrepancy between the model-implied and experimentally identified GATEs, derive an asymptotically normal estimator, and then provide a simple-to-implement statistical test. For mitigation, we propose a shrinkage-based bias-correction, and show that the theoretically optimal and empirically feasible solutions have closed-form expressions. The framework is fully general, imposes minimal assumptions, and only requires computing sample moments. We analyze the economic implications of mitigating detected group bias for profit-maximizing personalized targeting, thereby characterizing when bias correction alters targeting decisions and profits, and the trade-offs involved. Applications to large-scale experimental data at major digital platforms validate our theoretical results and demonstrate empirical performance."}],"geoLocations":[],"fundingReferences":[],"url":"https://arxiv.org/abs/2602.20383","contentUrl":null,"metadataVersion":0,"schemaVersion":"http://datacite.org/schema/kernel-4","source":"mds","isActive":true,"state":"findable","reason":null,"viewCount":0,"downloadCount":0,"referenceCount":0,"citationCount":0,"partCount":0,"partOfCount":0,"versionCount":0,"versionOfCount":0,"created":"2026-02-25T02:48:46Z","registered":"2026-02-25T02:48:47Z","published":null,"updated":"2026-02-25T02:48:47Z"},"relationships":{"client":{"data":{"id":"arxiv.content","type":"clients"}}}},{"id":"10.48550/arxiv.2602.20382","type":"dois","attributes":{"doi":"10.48550/arxiv.2602.20382","identifiers":[{"identifier":"2602.20382","identifierType":"arXiv"}],"creators":[{"nameType":"Personal","givenName":"David","familyName":"Nesvorny","name":"Nesvorny, David","affiliation":[],"nameIdentifiers":[]}],"titles":[{"title":"A Census Before Rubin of Asteroid Families in the Main Belt"}],"publisher":"arXiv","container":{},"publicationYear":2026,"subjects":[{"subject":"Earth and Planetary Astrophysics (astro-ph.EP)","lang":"en","subjectScheme":"arXiv"},{"subject":"FOS: Physical sciences","subjectScheme":"Fields of Science and Technology (FOS)"},{"schemeUri":"http://www.oecd.org/science/inno/38235147.pdf","subject":"FOS: Physical sciences","subjectScheme":"Fields of Science and Technology (FOS)"}],"contributors":[],"dates":[{"date":"2026-02-23T21:45:42Z","dateType":"Submitted","dateInformation":"v1"},{"date":"2026-02-25T01:08:59Z","dateType":"Updated","dateInformation":"v1"},{"date":"2026-02","dateType":"Available","dateInformation":"v1"},{"date":"2026","dateType":"Issued"}],"language":null,"types":{"schemaOrg":"CreativeWork","resourceTypeGeneral":"Preprint","citeproc":"article","bibtex":"misc","ris":"GEN","resourceType":"Article"},"relatedIdentifiers":[],"relatedItems":[],"sizes":[],"formats":[],"version":"1","rightsList":[{"rightsUri":"http://arxiv.org/licenses/nonexclusive-distrib/1.0/","rights":"arXiv.org perpetual, non-exclusive license"}],"descriptions":[{"descriptionType":"Abstract","description":"A collisional family is a collection of \u0026gt;km-size asteroid fragments produced by a large scale collision between asteroids. Here we cataloged 335 notable collisional families in the main asteroid belt. When possible, we estimated each family's formation age, mean visible albedo, taxonomic type, and parent body size. We found that older families (t_age\u0026gt;10 Myr) produced by impacts on small parent bodies (diameter D\u0026lt;5 km) are rarely identified because small members of these families have drifted over time by the Yarkovsky effect and blended with the background. The young families (t_age\u0026lt;10 Myr) typically have small parent bodies (D\u0026lt;10 km) as large asteroids do not disrupt often enough. The full catalog, including membership files for 335 individual asteroid families, is available for download (https://www.boulder.swri.edu/~davidn/Proper25)."},{"descriptionType":"Other","description":"ApJS"}],"geoLocations":[],"fundingReferences":[],"url":"https://arxiv.org/abs/2602.20382","contentUrl":null,"metadataVersion":0,"schemaVersion":"http://datacite.org/schema/kernel-4","source":"mds","isActive":true,"state":"findable","reason":null,"viewCount":0,"downloadCount":0,"referenceCount":0,"citationCount":0,"partCount":0,"partOfCount":0,"versionCount":0,"versionOfCount":0,"created":"2026-02-25T02:48:45Z","registered":"2026-02-25T02:48:46Z","published":null,"updated":"2026-02-25T02:48:46Z"},"relationships":{"client":{"data":{"id":"arxiv.content","type":"clients"}}}},{"id":"10.48550/arxiv.2602.20379","type":"dois","attributes":{"doi":"10.48550/arxiv.2602.20379","identifiers":[{"identifier":"2602.20379","identifierType":"arXiv"}],"creators":[{"nameType":"Personal","givenName":"Mukul","familyName":"Chhabra","name":"Chhabra, Mukul","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Luigi","familyName":"Medrano","name":"Medrano, Luigi","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Arush","familyName":"Verma","name":"Verma, Arush","affiliation":[],"nameIdentifiers":[]}],"titles":[{"title":"Case-Aware LLM-as-a-Judge Evaluation for Enterprise-Scale RAG Systems"}],"publisher":"arXiv","container":{},"publicationYear":2026,"subjects":[{"subject":"Computation and Language (cs.CL)","lang":"en","subjectScheme":"arXiv"},{"subject":"Artificial Intelligence (cs.AI)","lang":"en","subjectScheme":"arXiv"},{"subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"},{"schemeUri":"http://www.oecd.org/science/inno/38235147.pdf","subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"}],"contributors":[],"dates":[{"date":"2026-02-23T21:37:06Z","dateType":"Submitted","dateInformation":"v1"},{"date":"2026-02-25T01:08:41Z","dateType":"Updated","dateInformation":"v1"},{"date":"2026-02","dateType":"Available","dateInformation":"v1"},{"date":"2026","dateType":"Issued"}],"language":null,"types":{"schemaOrg":"CreativeWork","resourceTypeGeneral":"Preprint","citeproc":"article","bibtex":"misc","ris":"GEN","resourceType":"Article"},"relatedIdentifiers":[],"relatedItems":[],"sizes":[],"formats":[],"version":"1","rightsList":[{"rightsUri":"http://arxiv.org/licenses/nonexclusive-distrib/1.0/","rights":"arXiv.org perpetual, non-exclusive license"}],"descriptions":[{"descriptionType":"Abstract","description":"Enterprise Retrieval-Augmented Generation (RAG) assistants operate in multi-turn, case-based workflows such as technical support and IT operations, where evaluation must reflect operational constraints, structured identifiers (e.g., error codes, versions), and resolution workflows. Existing RAG evaluation frameworks are primarily designed for benchmark-style or single-turn settings and often fail to capture enterprise-specific failure modes such as case misidentification, workflow misalignment, and partial resolution across turns.\n We present a case-aware LLM-as-a-Judge evaluation framework for enterprise multi-turn RAG systems. The framework evaluates each turn using eight operationally grounded metrics that separate retrieval quality, grounding fidelity, answer utility, precision integrity, and case/workflow alignment. A severity-aware scoring protocol reduces score inflation and improves diagnostic clarity across heterogeneous enterprise cases. The system uses deterministic prompting with strict JSON outputs, enabling scalable batch evaluation, regression testing, and production monitoring.\n Through a comparative study of two instruction-tuned models across short and long workflows, we show that generic proxy metrics provide ambiguous signals, while the proposed framework exposes enterprise-critical tradeoffs that are actionable for system improvement."},{"descriptionType":"Other","description":"12 pages including appendix, 6 figures"}],"geoLocations":[],"fundingReferences":[],"url":"https://arxiv.org/abs/2602.20379","contentUrl":null,"metadataVersion":0,"schemaVersion":"http://datacite.org/schema/kernel-4","source":"mds","isActive":true,"state":"findable","reason":null,"viewCount":0,"downloadCount":0,"referenceCount":0,"citationCount":0,"partCount":0,"partOfCount":0,"versionCount":0,"versionOfCount":0,"created":"2026-02-25T02:48:41Z","registered":"2026-02-25T02:48:42Z","published":null,"updated":"2026-02-25T02:48:42Z"},"relationships":{"client":{"data":{"id":"arxiv.content","type":"clients"}}}},{"id":"10.48550/arxiv.2602.20378","type":"dois","attributes":{"doi":"10.48550/arxiv.2602.20378","identifiers":[{"identifier":"2602.20378","identifierType":"arXiv"}],"creators":[{"nameType":"Personal","givenName":"Yana","familyName":"Rodgers","name":"Rodgers, Yana","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Joseph","familyName":"Zveglich","name":"Zveglich, Joseph","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Khadija","familyName":"Ali","name":"Ali, Khadija","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Hanna","familyName":"Xue","name":"Xue, Hanna","affiliation":[],"nameIdentifiers":[]}],"titles":[{"title":"The Role of Family Support in the Well-Being of Older People: Evidence from Malaysia and Viet Nam"}],"publisher":"arXiv","container":{},"publicationYear":2026,"subjects":[{"subject":"General Economics (econ.GN)","lang":"en","subjectScheme":"arXiv"},{"subject":"FOS: Economics and business","subjectScheme":"Fields of Science and Technology (FOS)"},{"schemeUri":"http://www.oecd.org/science/inno/38235147.pdf","subject":"FOS: Economics and business","subjectScheme":"Fields of Science and Technology (FOS)"}],"contributors":[],"dates":[{"date":"2026-02-23T21:34:44Z","dateType":"Submitted","dateInformation":"v1"},{"date":"2026-02-25T01:08:40Z","dateType":"Updated","dateInformation":"v1"},{"date":"2026-02","dateType":"Available","dateInformation":"v1"},{"date":"2026","dateType":"Issued"}],"language":null,"types":{"schemaOrg":"CreativeWork","resourceTypeGeneral":"Preprint","citeproc":"article","bibtex":"misc","ris":"GEN","resourceType":"Article"},"relatedIdentifiers":[{"relationType":"IsVersionOf","relatedIdentifier":"10.1016/j.asieco.2025.101937","relatedIdentifierType":"DOI"}],"relatedItems":[],"sizes":[],"formats":[],"version":"1","rightsList":[{"rightsIdentifierScheme":"SPDX","rightsUri":"https://creativecommons.org/licenses/by/4.0/legalcode","schemeUri":"https://spdx.org/licenses/","rights":"Creative Commons Attribution 4.0 International","rightsIdentifier":"cc-by-4.0"}],"descriptions":[{"descriptionType":"Abstract","description":"Demographics in Malaysia and Viet Nam are evolving rapidly, potentially disrupting traditional family support to older people. We estimate a set of Poisson random effects models with panel data from the Malaysia Ageing and Retirement Survey and the Viet Nam Aging Survey to analyze how living arrangements, marital status, and support from children influence the mental and physical health of older people. In Malaysia, having living children plays an important protective role for both mental and physical health, while living with a son appears to have a protective effect for physical health. Results are similar for Viet Nam, except older women, who are at greater risk of mental and physical health problems, appear to enjoy a greater protective effect for their mental health from a child living nearby than do men. Our analysis underscores the importance of social safety nets for the health of senior citizens living alone."},{"descriptionType":"Other","description":"Published in Journal of Asian Economics"}],"geoLocations":[],"fundingReferences":[],"url":"https://arxiv.org/abs/2602.20378","contentUrl":null,"metadataVersion":0,"schemaVersion":"http://datacite.org/schema/kernel-4","source":"mds","isActive":true,"state":"findable","reason":null,"viewCount":0,"downloadCount":0,"referenceCount":0,"citationCount":0,"partCount":0,"partOfCount":0,"versionCount":0,"versionOfCount":1,"created":"2026-02-25T02:48:39Z","registered":"2026-02-25T02:48:40Z","published":null,"updated":"2026-02-25T02:48:40Z"},"relationships":{"client":{"data":{"id":"arxiv.content","type":"clients"}}}},{"id":"10.48550/arxiv.2602.20377","type":"dois","attributes":{"doi":"10.48550/arxiv.2602.20377","identifiers":[{"identifier":"2602.20377","identifierType":"arXiv"}],"creators":[{"nameType":"Personal","givenName":"Shidong","familyName":"Wang","name":"Wang, Shidong","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Renato","familyName":"Pajarola","name":"Pajarola, Renato","affiliation":[],"nameIdentifiers":[]}],"titles":[{"title":"Directly from Alpha to Omega: Controllable End-to-End Vector Floor Plan Generation"}],"publisher":"arXiv","container":{},"publicationYear":2026,"subjects":[{"subject":"Graphics (cs.GR)","lang":"en","subjectScheme":"arXiv"},{"subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"},{"schemeUri":"http://www.oecd.org/science/inno/38235147.pdf","subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"}],"contributors":[],"dates":[{"date":"2026-02-23T21:31:08Z","dateType":"Submitted","dateInformation":"v1"},{"date":"2026-02-25T01:08:28Z","dateType":"Updated","dateInformation":"v1"},{"date":"2026-02","dateType":"Available","dateInformation":"v1"},{"date":"2026","dateType":"Issued"}],"language":null,"types":{"schemaOrg":"CreativeWork","resourceTypeGeneral":"Preprint","citeproc":"article","bibtex":"misc","ris":"GEN","resourceType":"Article"},"relatedIdentifiers":[{"relationType":"IsVersionOf","relatedIdentifier":"10.1109/tvcg.2026.3665422","relatedIdentifierType":"DOI"}],"relatedItems":[],"sizes":[],"formats":[],"version":"1","rightsList":[{"rightsIdentifierScheme":"SPDX","rightsUri":"https://creativecommons.org/licenses/by-nc-nd/4.0/legalcode","schemeUri":"https://spdx.org/licenses/","rights":"Creative Commons Attribution Non Commercial No Derivatives 4.0 International","rightsIdentifier":"cc-by-nc-nd-4.0"}],"descriptions":[{"descriptionType":"Abstract","description":"Automated floor plan generation aims to create residential layouts by arranging rooms within a given boundary, balancing topological, geometric, and aesthetic considerations. The existing methods typically use a multi-step pipeline with intermediate representations to decompose the prediction process into several sub-tasks, limiting model flexibility and imposing predefined solution paths. This often results in unreasonable outputs when applied to data unsuitable for these predefined paths, making it challenging for these methods to match human designers, who do not restrict themselves to a specific set of design workflows. To address these limitations, we introduce CE2EPlan, a controllable end-to-end topology- and geometry-enhanced diffusion model that removes restrictions on the generative process of AI design tools. Instead, it enables the model to learn how to design floor plans directly from data, capturing a wide range of solution paths from input boundaries to complete layouts. Extensive experiments demonstrate that our method surpasses all existing approaches using the multi-step pipeline, delivering higher-quality results with enhanced user control and greater diversity in output, bringing AI design tools closer to the versatility of human designers."},{"descriptionType":"Other","description":"accepted to IEEE Transactions on Visualization and Computer Graphics"}],"geoLocations":[],"fundingReferences":[],"url":"https://arxiv.org/abs/2602.20377","contentUrl":null,"metadataVersion":0,"schemaVersion":"http://datacite.org/schema/kernel-4","source":"mds","isActive":true,"state":"findable","reason":null,"viewCount":0,"downloadCount":0,"referenceCount":0,"citationCount":0,"partCount":0,"partOfCount":0,"versionCount":0,"versionOfCount":1,"created":"2026-02-25T02:48:38Z","registered":"2026-02-25T02:48:39Z","published":null,"updated":"2026-02-25T02:48:39Z"},"relationships":{"client":{"data":{"id":"arxiv.content","type":"clients"}}}},{"id":"10.48550/arxiv.2602.20375","type":"dois","attributes":{"doi":"10.48550/arxiv.2602.20375","identifiers":[{"identifier":"2602.20375","identifierType":"arXiv"}],"creators":[{"nameType":"Personal","givenName":"Jiashun","familyName":"Wang","name":"Wang, Jiashun","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"M. Eva","familyName":"Mungai","name":"Mungai, M. Eva","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"He","familyName":"Li","name":"Li, He","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Jean Pierre","familyName":"Sleiman","name":"Sleiman, Jean Pierre","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Jessica","familyName":"Hodgins","name":"Hodgins, Jessica","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Farbod","familyName":"Farshidian","name":"Farshidian, Farbod","affiliation":[],"nameIdentifiers":[]}],"titles":[{"title":"Generalizing from References using a Multi-Task Reference and Goal-Driven RL Framework"}],"publisher":"arXiv","container":{},"publicationYear":2026,"subjects":[{"subject":"Robotics (cs.RO)","lang":"en","subjectScheme":"arXiv"},{"subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"},{"schemeUri":"http://www.oecd.org/science/inno/38235147.pdf","subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"}],"contributors":[],"dates":[{"date":"2026-02-23T21:25:06Z","dateType":"Submitted","dateInformation":"v1"},{"date":"2026-02-25T01:08:20Z","dateType":"Updated","dateInformation":"v1"},{"date":"2026-02","dateType":"Available","dateInformation":"v1"},{"date":"2026","dateType":"Issued"}],"language":null,"types":{"schemaOrg":"CreativeWork","resourceTypeGeneral":"Preprint","citeproc":"article","bibtex":"misc","ris":"GEN","resourceType":"Article"},"relatedIdentifiers":[],"relatedItems":[],"sizes":[],"formats":[],"version":"1","rightsList":[{"rightsIdentifierScheme":"SPDX","rightsUri":"https://creativecommons.org/licenses/by/4.0/legalcode","schemeUri":"https://spdx.org/licenses/","rights":"Creative Commons Attribution 4.0 International","rightsIdentifier":"cc-by-4.0"}],"descriptions":[{"descriptionType":"Abstract","description":"Learning agile humanoid behaviors from human motion offers a powerful route to natural, coordinated control, but existing approaches face a persistent trade-off: reference-tracking policies are often brittle outside the demonstration dataset, while purely task-driven Reinforcement Learning (RL) can achieve adaptability at the cost of motion quality. We introduce a unified multi-task RL framework that bridges this gap by treating reference motion as a prior for behavioral shaping rather than a deployment-time constraint. A single goal-conditioned policy is trained jointly on two tasks that share the same observation and action spaces, but differ in their initialization schemes, command spaces, and reward structures: (i) a reference-guided imitation task in which reference trajectories define dense imitation rewards but are not provided as policy inputs, and (ii) a goal-conditioned generalization task in which goals are sampled independently of any reference and where rewards reflect only task success. By co-optimizing these objectives within a shared formulation, the policy acquires structured, human-like motor skills from dense reference supervision while learning to adapt these skills to novel goals and initial conditions. This is achieved without adversarial objectives, explicit trajectory tracking, phase variables, or reference-dependent inference. We evaluate the method on a challenging box-based parkour playground that demands diverse athletic behaviors (e.g., jumping and climbing), and show that the learned controller transfers beyond the reference distribution while preserving motion naturalness. Finally, we demonstrate long-horizon behavior generation by composing multiple learned skills, illustrating the flexibility of the learned polices in complex scenarios."}],"geoLocations":[],"fundingReferences":[],"url":"https://arxiv.org/abs/2602.20375","contentUrl":null,"metadataVersion":0,"schemaVersion":"http://datacite.org/schema/kernel-4","source":"mds","isActive":true,"state":"findable","reason":null,"viewCount":0,"downloadCount":0,"referenceCount":0,"citationCount":0,"partCount":0,"partOfCount":0,"versionCount":0,"versionOfCount":0,"created":"2026-02-25T02:48:35Z","registered":"2026-02-25T02:48:36Z","published":null,"updated":"2026-02-25T02:48:36Z"},"relationships":{"client":{"data":{"id":"arxiv.content","type":"clients"}}}},{"id":"10.48550/arxiv.2602.20374","type":"dois","attributes":{"doi":"10.48550/arxiv.2602.20374","identifiers":[{"identifier":"2602.20374","identifierType":"arXiv"}],"creators":[{"nameType":"Personal","givenName":"J.","familyName":"Qiu","name":"Qiu, J.","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"A.","familyName":"Ciurlo","name":"Ciurlo, A.","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"M. R.","familyName":"Morris","name":"Morris, M. R.","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"P.","familyName":"Vermot","name":"Vermot, P.","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"J. L.","familyName":"Bourlot","name":"Bourlot, J. L.","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"D.","familyName":"Rouan","name":"Rouan, D.","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"A.","familyName":"Togi","name":"Togi, A.","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"T.","familyName":"Do","name":"Do, T.","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"A. M.","familyName":"Ghez","name":"Ghez, A. M.","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"E.","familyName":"Bron","name":"Bron, E.","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"F. L.","familyName":"Petit","name":"Petit, F. L.","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Y.","familyName":"Clénet","name":"Clénet, Y.","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"E. A. C.","familyName":"Mills","name":"Mills, E. A. C.","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"J. R.","familyName":"Lu","name":"Lu, J. R.","affiliation":[],"nameIdentifiers":[]}],"titles":[{"title":"First Observation of CO$_2$ Emission and foreground absorption Toward the Galactic Center with JWST"}],"publisher":"arXiv","container":{},"publicationYear":2026,"subjects":[{"subject":"Astrophysics of Galaxies (astro-ph.GA)","lang":"en","subjectScheme":"arXiv"},{"subject":"FOS: Physical sciences","subjectScheme":"Fields of Science and Technology (FOS)"},{"schemeUri":"http://www.oecd.org/science/inno/38235147.pdf","subject":"FOS: Physical sciences","subjectScheme":"Fields of Science and Technology (FOS)"}],"contributors":[],"dates":[{"date":"2026-02-23T21:23:19Z","dateType":"Submitted","dateInformation":"v1"},{"date":"2026-02-25T01:08:19Z","dateType":"Updated","dateInformation":"v1"},{"date":"2026-02","dateType":"Available","dateInformation":"v1"},{"date":"2026","dateType":"Issued"}],"language":null,"types":{"schemaOrg":"CreativeWork","resourceTypeGeneral":"Preprint","citeproc":"article","bibtex":"misc","ris":"GEN","resourceType":"Article"},"relatedIdentifiers":[],"relatedItems":[],"sizes":[],"formats":[],"version":"1","rightsList":[{"rightsIdentifierScheme":"SPDX","rightsUri":"https://creativecommons.org/licenses/by-sa/4.0/legalcode","schemeUri":"https://spdx.org/licenses/","rights":"Creative Commons Attribution Share Alike 4.0 International","rightsIdentifier":"cc-by-sa-4.0"}],"descriptions":[{"descriptionType":"Abstract","description":"CO$_2$ is an important, stable, and abundant molecule in the Universe, but it is very difficult to detect because it has no observable pure rotational transitions. The unique sensitivity and resolution of the James Webb Space Telescope (JWST) provide a fresh way to investigate it. CO$_2$ is typically found in the solid phase (ice) on grain mantles in dense molecular clouds, but is less commonly detected in the gas phase (compared to common molecules such as CO and H$_2$O) and has mostly been found in protostellar and proto-planetary environments. Here, we report and characterize the first observations of gas-phase CO$_2$ absorption toward two IR-bright regions of the Galactic Center, thanks to the high sensitivity of JWST. Using an LTE model we find a CO$_2$ gas excitation temperature between 20 and 50~K, a column density around 2$\\times$10$^{15}$~cm$^{-2}$ and a radial velocity consistent with 0. We also report: 1) simultaneous detections of C$_2$H$_2$ and HCN absorption bands (near 13.7 and 14.0 $μ$m, respectively), with column densitiy ratios of 1:3 and 3:2 with respect to gas-phase CO$_2$, and 2) CO$_2$ ice absorption with a ice-to-gas ratio of 90, consistent with previous findings. We conclude that the absorbing medium is likely in the foreground, most likely from one or more somewhat clumpy cloud(s), located between 0.15 and 4~kpc away from Earth. Additionally, we detected point-like CO$_2$ emission likely associated with a Galactic Center star (IRS~11SW), which is also spatially coincident with a previously reported X-ray source, raising the possibility that the system is a symbiotic binary."},{"descriptionType":"Other","description":"16 pages, 13 figures; submitted to ApJ"}],"geoLocations":[],"fundingReferences":[],"url":"https://arxiv.org/abs/2602.20374","contentUrl":null,"metadataVersion":0,"schemaVersion":"http://datacite.org/schema/kernel-4","source":"mds","isActive":true,"state":"findable","reason":null,"viewCount":0,"downloadCount":0,"referenceCount":0,"citationCount":0,"partCount":0,"partOfCount":0,"versionCount":0,"versionOfCount":0,"created":"2026-02-25T02:48:33Z","registered":"2026-02-25T02:48:34Z","published":null,"updated":"2026-02-25T02:48:34Z"},"relationships":{"client":{"data":{"id":"arxiv.content","type":"clients"}}}},{"id":"10.48550/arxiv.2602.20372","type":"dois","attributes":{"doi":"10.48550/arxiv.2602.20372","identifiers":[{"identifier":"2602.20372","identifierType":"arXiv"}],"creators":[{"nameType":"Personal","givenName":"Chundra","familyName":"Cathcart","name":"Cathcart, Chundra","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Arne","familyName":"Rubehn","name":"Rubehn, Arne","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Katja","familyName":"Bocklage","name":"Bocklage, Katja","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Luca","familyName":"Ciucci","name":"Ciucci, Luca","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Kellen Parker","familyName":"van Dam","name":"van Dam, Kellen Parker","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Alžběta","familyName":"Kučerová","name":"Kučerová, Alžběta","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Jekaterina","familyName":"Mažara","name":"Mažara, Jekaterina","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Carlo Y.","familyName":"Meloni","name":"Meloni, Carlo Y.","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"David","familyName":"Snee","name":"Snee, David","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Johann-Mattis","familyName":"List","name":"List, Johann-Mattis","affiliation":[],"nameIdentifiers":[]}],"titles":[{"title":"How communicatively optimal are exact numeral systems? Once more on lexicon size and morphosyntactic complexity"}],"publisher":"arXiv","container":{},"publicationYear":2026,"subjects":[{"subject":"Computation and Language (cs.CL)","lang":"en","subjectScheme":"arXiv"},{"subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"},{"schemeUri":"http://www.oecd.org/science/inno/38235147.pdf","subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"}],"contributors":[],"dates":[{"date":"2026-02-23T21:19:07Z","dateType":"Submitted","dateInformation":"v1"},{"date":"2026-02-25T01:08:16Z","dateType":"Updated","dateInformation":"v1"},{"date":"2026-02","dateType":"Available","dateInformation":"v1"},{"date":"2026","dateType":"Issued"}],"language":null,"types":{"schemaOrg":"CreativeWork","resourceTypeGeneral":"Preprint","citeproc":"article","bibtex":"misc","ris":"GEN","resourceType":"Article"},"relatedIdentifiers":[],"relatedItems":[],"sizes":[],"formats":[],"version":"1","rightsList":[{"rightsIdentifierScheme":"SPDX","rightsUri":"https://creativecommons.org/licenses/by/4.0/legalcode","schemeUri":"https://spdx.org/licenses/","rights":"Creative Commons Attribution 4.0 International","rightsIdentifier":"cc-by-4.0"}],"descriptions":[{"descriptionType":"Abstract","description":"Recent research argues that exact recursive numeral systems optimize communicative efficiency by balancing a tradeoff between the size of the numeral lexicon and the average morphosyntactic complexity (roughly length in morphemes) of numeral terms. We argue that previous studies have not characterized the data in a fashion that accounts for the degree of complexity languages display. Using data from 52 genetically diverse languages and an annotation scheme distinguishing between predictable and unpredictable allomorphy (formal variation), we show that many of the world's languages are decisively less efficient than one would expect. We discuss the implications of our findings for the study of numeral systems and linguistic evolution more generally."}],"geoLocations":[],"fundingReferences":[],"url":"https://arxiv.org/abs/2602.20372","contentUrl":null,"metadataVersion":0,"schemaVersion":"http://datacite.org/schema/kernel-4","source":"mds","isActive":true,"state":"findable","reason":null,"viewCount":0,"downloadCount":0,"referenceCount":0,"citationCount":0,"partCount":0,"partOfCount":0,"versionCount":0,"versionOfCount":0,"created":"2026-02-25T02:48:31Z","registered":"2026-02-25T02:48:31Z","published":null,"updated":"2026-02-25T02:48:31Z"},"relationships":{"client":{"data":{"id":"arxiv.content","type":"clients"}}}},{"id":"10.48550/arxiv.2602.20371","type":"dois","attributes":{"doi":"10.48550/arxiv.2602.20371","identifiers":[{"identifier":"2602.20371","identifierType":"arXiv"}],"creators":[{"nameType":"Personal","givenName":"Magid","familyName":"Sabbagh","name":"Sabbagh, Magid","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"David A.","familyName":"Stephens","name":"Stephens, David A.","affiliation":[],"nameIdentifiers":[]}],"titles":[{"title":"Semi-parametric Bayesian inference under Neyman orthogonality"}],"publisher":"arXiv","container":{},"publicationYear":2026,"subjects":[{"subject":"Statistics Theory (math.ST)","lang":"en","subjectScheme":"arXiv"},{"subject":"Methodology (stat.ME)","lang":"en","subjectScheme":"arXiv"},{"subject":"FOS: Mathematics","subjectScheme":"Fields of Science and Technology (FOS)"},{"schemeUri":"http://www.oecd.org/science/inno/38235147.pdf","subject":"FOS: Mathematics","subjectScheme":"Fields of Science and Technology (FOS)"},{"subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"},{"schemeUri":"http://www.oecd.org/science/inno/38235147.pdf","subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"}],"contributors":[],"dates":[{"date":"2026-02-23T21:18:45Z","dateType":"Submitted","dateInformation":"v1"},{"date":"2026-02-25T01:08:15Z","dateType":"Updated","dateInformation":"v1"},{"date":"2026-02","dateType":"Available","dateInformation":"v1"},{"date":"2026","dateType":"Issued"}],"language":null,"types":{"schemaOrg":"CreativeWork","resourceTypeGeneral":"Preprint","citeproc":"article","bibtex":"misc","ris":"GEN","resourceType":"Article"},"relatedIdentifiers":[],"relatedItems":[],"sizes":[],"formats":[],"version":"1","rightsList":[{"rightsIdentifierScheme":"SPDX","rightsUri":"https://creativecommons.org/licenses/by-nc-nd/4.0/legalcode","schemeUri":"https://spdx.org/licenses/","rights":"Creative Commons Attribution Non Commercial No Derivatives 4.0 International","rightsIdentifier":"cc-by-nc-nd-4.0"}],"descriptions":[{"descriptionType":"Abstract","description":"The validity of two-step or plug-in inference methods is questioned in the Bayesian framework. We study semi-parametric models where the plug-in of a non-parametrically modelled nuisance component is used. We show that when the nuisance and targeted parameters satisfy a Neyman orthogonal score property, the approach of cutting feedback through a two-step procedure is a valid way of conducting Bayesian inference. Our method relies on a non-parametric Bayesian formulation based on the Dirichlet process and the Bayesian bootstrap. We show that the marginal posterior of the targeted parameter exhibits good frequentist properties despite not accounting for the inferential uncertainty of the nuisance parameter. We adopt this approach in Bayesian causal inference problems where the nuisance propensity score model is estimated to obtain marginal inference for the treatment effect parameter, and demonstrate that a plug-in of the propensity score has a negligible effect on marginal posterior inference for the causal contrast. We investigate the absence of Neyman orthogonality and exploit our findings to show that in conventional two-step procedures, the posterior distribution converges under weaker restrictions than those needed in the frequentist sequel. For a simple family of useful scores, we demonstrate that even in the absence of Neyman orthogonality, the posterior distribution is asymptotically unchanged by the estimation of the nuisance parameter, merely provided the latter estimator is consistent."},{"descriptionType":"Other","description":"18 pages"}],"geoLocations":[],"fundingReferences":[],"url":"https://arxiv.org/abs/2602.20371","contentUrl":null,"metadataVersion":0,"schemaVersion":"http://datacite.org/schema/kernel-4","source":"mds","isActive":true,"state":"findable","reason":null,"viewCount":0,"downloadCount":0,"referenceCount":0,"citationCount":0,"partCount":0,"partOfCount":0,"versionCount":0,"versionOfCount":0,"created":"2026-02-25T02:48:29Z","registered":"2026-02-25T02:48:30Z","published":null,"updated":"2026-02-25T02:48:30Z"},"relationships":{"client":{"data":{"id":"arxiv.content","type":"clients"}}}},{"id":"10.48550/arxiv.2602.20369","type":"dois","attributes":{"doi":"10.48550/arxiv.2602.20369","identifiers":[{"identifier":"2602.20369","identifierType":"arXiv"}],"creators":[{"nameType":"Personal","givenName":"Giorgio","familyName":"Del Castello","name":"Del Castello, Giorgio","affiliation":[],"nameIdentifiers":[]}],"titles":[{"title":"LANTERN: Characterization technology for low threshold cryogenic detectors"}],"publisher":"arXiv","container":{},"publicationYear":2026,"subjects":[{"subject":"Instrumentation and Detectors (physics.ins-det)","lang":"en","subjectScheme":"arXiv"},{"subject":"FOS: Physical sciences","subjectScheme":"Fields of Science and Technology (FOS)"},{"schemeUri":"http://www.oecd.org/science/inno/38235147.pdf","subject":"FOS: Physical sciences","subjectScheme":"Fields of Science and Technology (FOS)"}],"contributors":[],"dates":[{"date":"2026-02-23T21:14:10Z","dateType":"Submitted","dateInformation":"v1"},{"date":"2026-02-25T01:08:04Z","dateType":"Updated","dateInformation":"v1"},{"date":"2026-02","dateType":"Available","dateInformation":"v1"},{"date":"2026","dateType":"Issued"}],"language":null,"types":{"schemaOrg":"CreativeWork","resourceTypeGeneral":"Preprint","citeproc":"article","bibtex":"misc","ris":"GEN","resourceType":"Article"},"relatedIdentifiers":[],"relatedItems":[],"sizes":[],"formats":[],"version":"1","rightsList":[{"rightsIdentifierScheme":"SPDX","rightsUri":"https://creativecommons.org/licenses/by/4.0/legalcode","schemeUri":"https://spdx.org/licenses/","rights":"Creative Commons Attribution 4.0 International","rightsIdentifier":"cc-by-4.0"}],"descriptions":[{"descriptionType":"Abstract","description":"The use of low-temperature detectors, such as cryogenic calorimeters, has pioneered the recent advancements in low-energy rare event searches. These detectors provide a low-noise environment essential for the direct detection of dark matter and neutrinos. Characterizing these detectors within the region of interest (ROI), typically spanning from O(10~eV) to O(1~keV), has proven to be a challenging task. Conventional radioactive sources produce signals above this range, leading to nonlinearities and saturation effects. Moreover, these detectors are usually deployed in low background environments, meaning that having a radioactive source during physics runs can spoil the measurement making the use of this type of solution unfeasible.\n As a solution to these issues, we introduce LANTERN, an optical calibration system designed for highly segmented cryogenic calorimeters. LANTERN utilizes the photostatistics resulting from the absorption of monochromatic UV-Vis photons emitted by LEDs to analyze the detector response curve, without needing prior knowledge of the total energy deposited. The system employs a fast-switching LED matrix that operates at excitation times faster than the typical response of cryogenic detectors and can currently characterize up to 64 calorimeters independently.\n In this work, the validation of the final electronics designed for the project is shown. The first test was carried out by calibrating one of the cryogenic detectors of the BULLKID-DM experiment and checking the energy-reconstruction error of the spectral features produced by the surrounding lead casing. An error of $\\approx 2\\%$ has been observed in the energy reconstruction. The second validation was carried out by cross-calibrating one of the CALDER thin detectors with a commercial LED driver, and compatible results between the two setups were achieved."}],"geoLocations":[],"fundingReferences":[],"url":"https://arxiv.org/abs/2602.20369","contentUrl":null,"metadataVersion":0,"schemaVersion":"http://datacite.org/schema/kernel-4","source":"mds","isActive":true,"state":"findable","reason":null,"viewCount":0,"downloadCount":0,"referenceCount":0,"citationCount":0,"partCount":0,"partOfCount":0,"versionCount":0,"versionOfCount":0,"created":"2026-02-25T02:48:26Z","registered":"2026-02-25T02:48:27Z","published":null,"updated":"2026-02-25T02:48:27Z"},"relationships":{"client":{"data":{"id":"arxiv.content","type":"clients"}}}},{"id":"10.48550/arxiv.2602.20368","type":"dois","attributes":{"doi":"10.48550/arxiv.2602.20368","identifiers":[{"identifier":"2602.20368","identifierType":"arXiv"}],"creators":[{"nameType":"Personal","givenName":"Mays S. Abdul","familyName":"Ameer","name":"Ameer, Mays S. Abdul","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Abdul Rahman S.","familyName":"Juma","name":"Juma, Abdul Rahman S.","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Raheam A.","familyName":"Al-Saphory","name":"Al-Saphory, Raheam A.","affiliation":[],"nameIdentifiers":[]}],"titles":[{"title":"On Harmonic Univalent Functions Defined by Dziok-Srivastava Operator"}],"publisher":"arXiv","container":{},"publicationYear":2026,"subjects":[{"subject":"Complex Variables (math.CV)","lang":"en","subjectScheme":"arXiv"},{"subject":"FOS: Mathematics","subjectScheme":"Fields of Science and Technology (FOS)"},{"schemeUri":"http://www.oecd.org/science/inno/38235147.pdf","subject":"FOS: Mathematics","subjectScheme":"Fields of Science and Technology (FOS)"},{"subject":"30C45, 30C50","lang":"en","subjectScheme":"MSC"}],"contributors":[],"dates":[{"date":"2026-02-23T21:13:09Z","dateType":"Submitted","dateInformation":"v1"},{"date":"2026-02-25T01:08:03Z","dateType":"Updated","dateInformation":"v1"},{"date":"2026-02","dateType":"Available","dateInformation":"v1"},{"date":"2026","dateType":"Issued"}],"language":null,"types":{"schemaOrg":"CreativeWork","resourceTypeGeneral":"Preprint","citeproc":"article","bibtex":"misc","ris":"GEN","resourceType":"Article"},"relatedIdentifiers":[{"relationType":"IsVersionOf","relatedIdentifier":"10.25130/tjps.v26i1.110","relatedIdentifierType":"DOI"}],"relatedItems":[],"sizes":[],"formats":[],"version":"1","rightsList":[{"rightsIdentifierScheme":"SPDX","rightsUri":"https://creativecommons.org/licenses/by/4.0/legalcode","schemeUri":"https://spdx.org/licenses/","rights":"Creative Commons Attribution 4.0 International","rightsIdentifier":"cc-by-4.0"}],"descriptions":[{"descriptionType":"Abstract","description":"The purpose of this work is to present a class of harmonic univalent functions defined by the Dziok-Srivastava operator. Some geometric properties like coefficients conditions, distortion theorem, convolution (Hadamard product), convex combination and extreme points are investigated."},{"descriptionType":"Other","description":"4 pages"}],"geoLocations":[],"fundingReferences":[],"url":"https://arxiv.org/abs/2602.20368","contentUrl":null,"metadataVersion":0,"schemaVersion":"http://datacite.org/schema/kernel-4","source":"mds","isActive":true,"state":"findable","reason":null,"viewCount":0,"downloadCount":0,"referenceCount":0,"citationCount":0,"partCount":0,"partOfCount":0,"versionCount":0,"versionOfCount":1,"created":"2026-02-25T02:48:25Z","registered":"2026-02-25T02:48:25Z","published":null,"updated":"2026-02-25T02:48:26Z"},"relationships":{"client":{"data":{"id":"arxiv.content","type":"clients"}}}},{"id":"10.48550/arxiv.2602.20367","type":"dois","attributes":{"doi":"10.48550/arxiv.2602.20367","identifiers":[{"identifier":"2602.20367","identifierType":"arXiv"}],"creators":[{"nameType":"Personal","givenName":"Lorenzo","familyName":"Mantovani","name":"Mantovani, Lorenzo","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Ákos K.","familyName":"Matszangosz","name":"Matszangosz, Ákos K.","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Matthias","familyName":"Wendt","name":"Wendt, Matthias","affiliation":[],"nameIdentifiers":[]}],"titles":[{"title":"Equivariant real cycle class map and Witt-sheaf cohomology of classifying spaces"}],"publisher":"arXiv","container":{},"publicationYear":2026,"subjects":[{"subject":"Algebraic Topology (math.AT)","lang":"en","subjectScheme":"arXiv"},{"subject":"Algebraic Geometry (math.AG)","lang":"en","subjectScheme":"arXiv"},{"subject":"FOS: Mathematics","subjectScheme":"Fields of Science and Technology (FOS)"},{"schemeUri":"http://www.oecd.org/science/inno/38235147.pdf","subject":"FOS: Mathematics","subjectScheme":"Fields of Science and Technology (FOS)"},{"subject":"14F43, 55N91, 19G12","lang":"en","subjectScheme":"MSC"}],"contributors":[],"dates":[{"date":"2026-02-23T21:12:08Z","dateType":"Submitted","dateInformation":"v1"},{"date":"2026-02-25T01:08:03Z","dateType":"Updated","dateInformation":"v1"},{"date":"2026-02","dateType":"Available","dateInformation":"v1"},{"date":"2026","dateType":"Issued"}],"language":null,"types":{"schemaOrg":"CreativeWork","resourceTypeGeneral":"Preprint","citeproc":"article","bibtex":"misc","ris":"GEN","resourceType":"Article"},"relatedIdentifiers":[],"relatedItems":[],"sizes":[],"formats":[],"version":"1","rightsList":[{"rightsUri":"http://arxiv.org/licenses/nonexclusive-distrib/1.0/","rights":"arXiv.org perpetual, non-exclusive license"}],"descriptions":[{"descriptionType":"Abstract","description":"In this paper, we study equivariant real cycle class maps for group actions on real schemes, with a view toward Witt-sheaf characteristic classes. The cycle class maps take values in singular cohomology of the real points of the quotient stack, which are identified with the homotopy fixed-points of complex conjugation on the complex points. This provides a strong relation between Witt-sheaf cohomology of the geometric classifying space of a real algebraic group and the singular cohomology of the classifying spaces of its strong real forms, which we discuss in a number of examples. As a sample application, we compute the number of Witt-sheaf cohomological invariants of spin groups over the reals."},{"descriptionType":"Other","description":"65 pages"}],"geoLocations":[],"fundingReferences":[],"url":"https://arxiv.org/abs/2602.20367","contentUrl":null,"metadataVersion":0,"schemaVersion":"http://datacite.org/schema/kernel-4","source":"mds","isActive":true,"state":"findable","reason":null,"viewCount":0,"downloadCount":0,"referenceCount":0,"citationCount":0,"partCount":0,"partOfCount":0,"versionCount":0,"versionOfCount":0,"created":"2026-02-25T02:48:23Z","registered":"2026-02-25T02:48:24Z","published":null,"updated":"2026-02-25T02:48:24Z"},"relationships":{"client":{"data":{"id":"arxiv.content","type":"clients"}}}},{"id":"10.48550/arxiv.2602.20366","type":"dois","attributes":{"doi":"10.48550/arxiv.2602.20366","identifiers":[{"identifier":"2602.20366","identifierType":"arXiv"}],"creators":[{"nameType":"Personal","givenName":"Ron M.","familyName":"Roth","name":"Roth, Ron M.","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Ziyuan","familyName":"Zhu","name":"Zhu, Ziyuan","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Changcheng","familyName":"Yuan","name":"Yuan, Changcheng","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Paul H.","familyName":"Siegel","name":"Siegel, Paul H.","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Anxiao","familyName":"Jiang","name":"Jiang, Anxiao","affiliation":[],"nameIdentifiers":[]}],"titles":[{"title":"On the Height Profile of Analog Error-Correcting Codes"}],"publisher":"arXiv","container":{},"publicationYear":2026,"subjects":[{"subject":"Information Theory (cs.IT)","lang":"en","subjectScheme":"arXiv"},{"subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"},{"schemeUri":"http://www.oecd.org/science/inno/38235147.pdf","subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"}],"contributors":[],"dates":[{"date":"2026-02-23T21:10:14Z","dateType":"Submitted","dateInformation":"v1"},{"date":"2026-02-25T01:07:58Z","dateType":"Updated","dateInformation":"v1"},{"date":"2026-02","dateType":"Available","dateInformation":"v1"},{"date":"2026","dateType":"Issued"}],"language":null,"types":{"schemaOrg":"CreativeWork","resourceTypeGeneral":"Preprint","citeproc":"article","bibtex":"misc","ris":"GEN","resourceType":"Article"},"relatedIdentifiers":[],"relatedItems":[],"sizes":[],"formats":[],"version":"1","rightsList":[{"rightsUri":"http://arxiv.org/licenses/nonexclusive-distrib/1.0/","rights":"arXiv.org perpetual, non-exclusive license"}],"descriptions":[{"descriptionType":"Abstract","description":"In recent work, it has been shown that maintaining reliability in analog vector--matrix multipliers can be modeled as the following coding problem. Vectors in $\\mathbb{R}^k$ are encoded into codewords of a linear $[n,k,d]$ code $C$ over $\\mathbb{R}$. For prescribed positive reals $δ\u0026lt; Δ$, additive errors of magnitude at most $δ$ are tolerable and need no handling, yet outlying errors of magnitude greater than $Δ$ are to be located or detected. The trade-off between the ratio $Δ/δ$ and the number of outlying errors that can be handled is determined by the height profile of $C$; as such, the height profile provides a finer description of the error handling capability of $C$, compared to the minimum distance $d$, which only determines the number of correctable errors. This work contains a further study of the notion of the height profile. Several characterizations of the height profile are presented, thereby yielding methods for computing it. The starting point is formulating this computation as an optimization problem that is solved by a set of linear programs. This, in turn, leads to a combinatorial characterization of the height profile as a maximum (or max--min) over a certain finite set of codewords of $C$. Moreover, this characterization is shown to have a simple geometric interpretation when the columns of the generator matrix of $C$ all have the same $L_2$ norm. Through examples of several code families, it is demonstrated how the results herein can be used to compute the height profile explicitly."}],"geoLocations":[],"fundingReferences":[],"url":"https://arxiv.org/abs/2602.20366","contentUrl":null,"metadataVersion":0,"schemaVersion":"http://datacite.org/schema/kernel-4","source":"mds","isActive":true,"state":"findable","reason":null,"viewCount":0,"downloadCount":0,"referenceCount":0,"citationCount":0,"partCount":0,"partOfCount":0,"versionCount":0,"versionOfCount":0,"created":"2026-02-25T02:48:22Z","registered":"2026-02-25T02:48:22Z","published":null,"updated":"2026-02-25T02:48:22Z"},"relationships":{"client":{"data":{"id":"arxiv.content","type":"clients"}}}},{"id":"10.48550/arxiv.2602.20365","type":"dois","attributes":{"doi":"10.48550/arxiv.2602.20365","identifiers":[{"identifier":"2602.20365","identifierType":"arXiv"}],"creators":[{"nameType":"Personal","givenName":"Moein","familyName":"Khalighi","name":"Khalighi, Moein","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Chandler","familyName":"Ross","name":"Ross, Chandler","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Ville","familyName":"Laitinen","name":"Laitinen, Ville","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Guilhem","familyName":"Sommeria-Klein","name":"Sommeria-Klein, Guilhem","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Leo","familyName":"Lahti","name":"Lahti, Leo","affiliation":[],"nameIdentifiers":[]}],"titles":[{"title":"Memory reshapes stability landscapes: resilience-resistance tradeoffs and critical transitions"}],"publisher":"arXiv","container":{},"publicationYear":2026,"subjects":[{"subject":"Dynamical Systems (math.DS)","lang":"en","subjectScheme":"arXiv"},{"subject":"FOS: Mathematics","subjectScheme":"Fields of Science and Technology (FOS)"},{"schemeUri":"http://www.oecd.org/science/inno/38235147.pdf","subject":"FOS: Mathematics","subjectScheme":"Fields of Science and Technology (FOS)"}],"contributors":[],"dates":[{"date":"2026-02-23T21:09:26Z","dateType":"Submitted","dateInformation":"v1"},{"date":"2026-02-25T01:07:54Z","dateType":"Updated","dateInformation":"v1"},{"date":"2026-02","dateType":"Available","dateInformation":"v1"},{"date":"2026","dateType":"Issued"}],"language":null,"types":{"schemaOrg":"CreativeWork","resourceTypeGeneral":"Preprint","citeproc":"article","bibtex":"misc","ris":"GEN","resourceType":"Article"},"relatedIdentifiers":[],"relatedItems":[],"sizes":[],"formats":[],"version":"1","rightsList":[{"rightsIdentifierScheme":"SPDX","rightsUri":"https://creativecommons.org/licenses/by/4.0/legalcode","schemeUri":"https://spdx.org/licenses/","rights":"Creative Commons Attribution 4.0 International","rightsIdentifier":"cc-by-4.0"}],"descriptions":[{"descriptionType":"Abstract","description":"Regime shifts in biology, ecology, and other complex systems are often interpreted through stability landscapes and early warning signals that implicitly assume dynamics without memory effects. Yet many real systems exhibit these effects, thus present dynamics depend on past states and past forcing. Here, we study how memory reshapes bistable stability landscapes and regime shifts using a minimal bistable model with a fractional derivative that controls memory strength. We connect landscape geometry to classical notions of resilience and resistance by quantifying basin curvature and the perturbation magnitude required to cross the unstable threshold, and we track how these quantities evolve in time after perturbations. Memory typically flattens basin floors, slowing recovery, while often increasing the perturbation threshold for stability transitions, revealing a tradeoff between resilience and resistance. Because the landscape becomes history-dependent and time-evolving, memory generates qualitative behaviors that do not appear in memory-free models, including delayed collapse or recovery after stress ends, rebound after apparently successful transition, and broadened hysteresis under gradual parameter change. Finally, we show that fitting a memory-free model to memory-driven data can reproduce trajectories while systematically shifting equilibrium branches and tipping locations, risking incorrect diagnosis and management of regime shifts. These results motivate a moving landscape view and provide practical guidance for interpreting observed anomalies and distinguishing memory-driven effects from noise."}],"geoLocations":[],"fundingReferences":[],"url":"https://arxiv.org/abs/2602.20365","contentUrl":null,"metadataVersion":0,"schemaVersion":"http://datacite.org/schema/kernel-4","source":"mds","isActive":true,"state":"findable","reason":null,"viewCount":0,"downloadCount":0,"referenceCount":0,"citationCount":0,"partCount":0,"partOfCount":0,"versionCount":0,"versionOfCount":0,"created":"2026-02-25T02:48:20Z","registered":"2026-02-25T02:48:21Z","published":null,"updated":"2026-02-25T02:48:21Z"},"relationships":{"client":{"data":{"id":"arxiv.content","type":"clients"}}}},{"id":"10.48550/arxiv.2602.20363","type":"dois","attributes":{"doi":"10.48550/arxiv.2602.20363","identifiers":[{"identifier":"2602.20363","identifierType":"arXiv"}],"creators":[{"nameType":"Personal","givenName":"Sheyang","familyName":"Tang","name":"Tang, Sheyang","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Armin Shafiee","familyName":"Sarvestani","name":"Sarvestani, Armin Shafiee","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Jialu","familyName":"Xu","name":"Xu, Jialu","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Xiaoyu","familyName":"Xu","name":"Xu, Xiaoyu","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Zhou","familyName":"Wang","name":"Wang, Zhou","affiliation":[],"nameIdentifiers":[]}],"titles":[{"title":"Aesthetic Camera Viewpoint Suggestion with 3D Aesthetic Field"}],"publisher":"arXiv","container":{},"publicationYear":2026,"subjects":[{"subject":"Computer Vision and Pattern Recognition (cs.CV)","lang":"en","subjectScheme":"arXiv"},{"subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"},{"schemeUri":"http://www.oecd.org/science/inno/38235147.pdf","subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"}],"contributors":[],"dates":[{"date":"2026-02-23T21:08:23Z","dateType":"Submitted","dateInformation":"v1"},{"date":"2026-02-25T01:07:46Z","dateType":"Updated","dateInformation":"v1"},{"date":"2026-02","dateType":"Available","dateInformation":"v1"},{"date":"2026","dateType":"Issued"}],"language":null,"types":{"schemaOrg":"CreativeWork","resourceTypeGeneral":"Preprint","citeproc":"article","bibtex":"misc","ris":"GEN","resourceType":"Article"},"relatedIdentifiers":[],"relatedItems":[],"sizes":[],"formats":[],"version":"1","rightsList":[{"rightsIdentifierScheme":"SPDX","rightsUri":"https://creativecommons.org/licenses/by/4.0/legalcode","schemeUri":"https://spdx.org/licenses/","rights":"Creative Commons Attribution 4.0 International","rightsIdentifier":"cc-by-4.0"}],"descriptions":[{"descriptionType":"Abstract","description":"The aesthetic quality of a scene depends strongly on camera viewpoint. Existing approaches for aesthetic viewpoint suggestion are either single-view adjustments, predicting limited camera adjustments from a single image without understanding scene geometry, or 3D exploration approaches, which rely on dense captures or prebuilt 3D environments coupled with costly reinforcement learning (RL) searches. In this work, we introduce the notion of 3D aesthetic field that enables geometry-grounded aesthetic reasoning in 3D with sparse captures, allowing efficient viewpoint suggestions in contrast to costly RL searches. We opt to learn this 3D aesthetic field using a feedforward 3D Gaussian Splatting network that distills high-level aesthetic knowledge from a pretrained 2D aesthetic model into 3D space, enabling aesthetic prediction for novel viewpoints from only sparse input views. Building on this field, we propose a two-stage search pipeline that combines coarse viewpoint sampling with gradient-based refinement, efficiently identifying aesthetically appealing viewpoints without dense captures or RL exploration. Extensive experiments show that our method consistently suggests viewpoints with superior framing and composition compared to existing approaches, establishing a new direction toward 3D-aware aesthetic modeling."},{"descriptionType":"Other","description":"14 pages, 10 figures"}],"geoLocations":[],"fundingReferences":[],"url":"https://arxiv.org/abs/2602.20363","contentUrl":null,"metadataVersion":0,"schemaVersion":"http://datacite.org/schema/kernel-4","source":"mds","isActive":true,"state":"findable","reason":null,"viewCount":0,"downloadCount":0,"referenceCount":0,"citationCount":0,"partCount":0,"partOfCount":0,"versionCount":0,"versionOfCount":0,"created":"2026-02-25T02:48:17Z","registered":"2026-02-25T02:48:18Z","published":null,"updated":"2026-02-25T02:48:18Z"},"relationships":{"client":{"data":{"id":"arxiv.content","type":"clients"}}}},{"id":"10.48550/arxiv.2602.20362","type":"dois","attributes":{"doi":"10.48550/arxiv.2602.20362","identifiers":[{"identifier":"2602.20362","identifierType":"arXiv"}],"creators":[{"nameType":"Personal","givenName":"Robin Jeanne","familyName":"Kirschner","name":"Kirschner, Robin Jeanne","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Anna","familyName":"Huber","name":"Huber, Anna","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Carina M.","familyName":"Micheler","name":"Micheler, Carina M.","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Dirk","familyName":"Müller","name":"Müller, Dirk","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Nader","familyName":"Rajaei","name":"Rajaei, Nader","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Rainer","familyName":"Burgkart","name":"Burgkart, Rainer","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Sami","familyName":"Haddadin","name":"Haddadin, Sami","affiliation":[],"nameIdentifiers":[]}],"titles":[{"title":"Energy-Based Injury Protection Database: Including Shearing Contact Thresholds for Hand and Finger Using Porcine Surrogates"}],"publisher":"arXiv","container":{},"publicationYear":2026,"subjects":[{"subject":"Robotics (cs.RO)","lang":"en","subjectScheme":"arXiv"},{"subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"},{"schemeUri":"http://www.oecd.org/science/inno/38235147.pdf","subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"}],"contributors":[],"dates":[{"date":"2026-02-23T21:07:48Z","dateType":"Submitted","dateInformation":"v1"},{"date":"2026-02-25T01:07:45Z","dateType":"Updated","dateInformation":"v1"},{"date":"2026-02","dateType":"Available","dateInformation":"v1"},{"date":"2026","dateType":"Issued"}],"language":null,"types":{"schemaOrg":"CreativeWork","resourceTypeGeneral":"Preprint","citeproc":"article","bibtex":"misc","ris":"GEN","resourceType":"Article"},"relatedIdentifiers":[],"relatedItems":[],"sizes":[],"formats":[],"version":"1","rightsList":[{"rightsIdentifierScheme":"SPDX","rightsUri":"https://creativecommons.org/licenses/by/4.0/legalcode","schemeUri":"https://spdx.org/licenses/","rights":"Creative Commons Attribution 4.0 International","rightsIdentifier":"cc-by-4.0"}],"descriptions":[{"descriptionType":"Abstract","description":"While robotics research continues to propose strategies for collision avoidance in human-robot interaction, the reality of constrained environments and future humanoid systems makes contact inevitable. To mitigate injury risks, energy-constraining control approaches are commonly used, often relying on safety thresholds derived from blunt impact data in EN ISO 10218-2:2025. However, this dataset does not extend to edged or pointed collisions. Without scalable, clinically grounded datasets covering diverse contact scenarios, safety validation remains limited. Previous studies have laid the groundwork by assessing surrogate-based velocity and mass limits across various geometries, focusing on perpendicular impacts. This study expands those datasets by including shearing contact scenarios in unconstrained collisions, revealing that collision angle significantly affects injury outcomes. Notably, unconstrained shearing contacts result in fewer injuries than perpendicular ones. By reevaluating all prior porcine surrogate data, we establish energy thresholds across geometries and contact types, forming the first energy-based Injury Protection Database. This enables the development of meaningful energy-limiting controllers that ensure safety across a wide range of realistic collision events."},{"descriptionType":"Other","description":"9 pages, 11 figures"}],"geoLocations":[],"fundingReferences":[],"url":"https://arxiv.org/abs/2602.20362","contentUrl":null,"metadataVersion":0,"schemaVersion":"http://datacite.org/schema/kernel-4","source":"mds","isActive":true,"state":"findable","reason":null,"viewCount":0,"downloadCount":0,"referenceCount":0,"citationCount":0,"partCount":0,"partOfCount":0,"versionCount":0,"versionOfCount":0,"created":"2026-02-25T02:48:16Z","registered":"2026-02-25T02:48:17Z","published":null,"updated":"2026-02-25T02:48:17Z"},"relationships":{"client":{"data":{"id":"arxiv.content","type":"clients"}}}},{"id":"10.48550/arxiv.2602.20361","type":"dois","attributes":{"doi":"10.48550/arxiv.2602.20361","identifiers":[{"identifier":"2602.20361","identifierType":"arXiv"}],"creators":[{"nameType":"Personal","givenName":"Mohanad","familyName":"Obeed","name":"Obeed, Mohanad","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Ming","familyName":"Jian","name":"Jian, Ming","affiliation":[],"nameIdentifiers":[]}],"titles":[{"title":"Learning During Detection: Continual Learning for Neural OFDM Receivers via DMRS"}],"publisher":"arXiv","container":{},"publicationYear":2026,"subjects":[{"subject":"Information Theory (cs.IT)","lang":"en","subjectScheme":"arXiv"},{"subject":"Artificial Intelligence (cs.AI)","lang":"en","subjectScheme":"arXiv"},{"subject":"Machine Learning (cs.LG)","lang":"en","subjectScheme":"arXiv"},{"subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"},{"schemeUri":"http://www.oecd.org/science/inno/38235147.pdf","subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"}],"contributors":[],"dates":[{"date":"2026-02-23T21:07:36Z","dateType":"Submitted","dateInformation":"v1"},{"date":"2026-02-25T01:07:40Z","dateType":"Updated","dateInformation":"v1"},{"date":"2026-02","dateType":"Available","dateInformation":"v1"},{"date":"2026","dateType":"Issued"}],"language":null,"types":{"schemaOrg":"CreativeWork","resourceTypeGeneral":"Preprint","citeproc":"article","bibtex":"misc","ris":"GEN","resourceType":"Article"},"relatedIdentifiers":[],"relatedItems":[],"sizes":[],"formats":[],"version":"1","rightsList":[{"rightsIdentifierScheme":"SPDX","rightsUri":"https://creativecommons.org/publicdomain/zero/1.0/legalcode","schemeUri":"https://spdx.org/licenses/","rights":"Creative Commons Zero v1.0 Universal","rightsIdentifier":"cc0-1.0"}],"descriptions":[{"descriptionType":"Abstract","description":"Deep neural networks (DNNs) have been increasingly explored for receiver design because they can handle complex environments without relying on explicit channel models. Nevertheless, because communication channels change rapidly, their distributions can shift over time, often making periodic retraining necessary. This paper proposes a zero-overhead online and continual learning framework for orthogonal frequency-division multiplexing (OFDM) neural receivers that directly detect the soft bits of received signals. Unlike conventional fine-tuning methods that rely on dedicated training intervals or full resource grids, our approach leverages existing demodulation reference signals (DMRS) to simultaneously enable signal demodulation and model adaptation. We introduce three pilot designs: fully randomized, hybrid, and additional pilots that flexibly support joint demodulation and learning. To accommodate these pilot designs, we develop two receiver architectures: (i) a parallel design that separates inference and fine-tuning for uninterrupted operation, and (ii) a forward-pass reusing design that reduces computational complexity. Simulation results show that the proposed method effectively tracks both slow and fast channel distribution variations without additional overhead, service interruption, or catastrophic performance degradation under distribution shift."}],"geoLocations":[],"fundingReferences":[],"url":"https://arxiv.org/abs/2602.20361","contentUrl":null,"metadataVersion":0,"schemaVersion":"http://datacite.org/schema/kernel-4","source":"mds","isActive":true,"state":"findable","reason":null,"viewCount":0,"downloadCount":0,"referenceCount":0,"citationCount":0,"partCount":0,"partOfCount":0,"versionCount":0,"versionOfCount":0,"created":"2026-02-25T02:48:15Z","registered":"2026-02-25T02:48:15Z","published":null,"updated":"2026-02-25T02:48:15Z"},"relationships":{"client":{"data":{"id":"arxiv.content","type":"clients"}}}},{"id":"10.48550/arxiv.2602.20357","type":"dois","attributes":{"doi":"10.48550/arxiv.2602.20357","identifiers":[{"identifier":"2602.20357","identifierType":"arXiv"}],"creators":[{"nameType":"Personal","givenName":"Muhammad","familyName":"Khan","name":"Khan, Muhammad","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Yangyang","familyName":"Xu","name":"Xu, Yangyang","affiliation":[],"nameIdentifiers":[]}],"titles":[{"title":"A variance reduced framework for (non)smooth nonconvex-nonconcave stochastic minimax problems with extended Kurdyka-Lojasiewicz property"}],"publisher":"arXiv","container":{},"publicationYear":2026,"subjects":[{"subject":"Optimization and Control (math.OC)","lang":"en","subjectScheme":"arXiv"},{"subject":"FOS: Mathematics","subjectScheme":"Fields of Science and Technology (FOS)"},{"schemeUri":"http://www.oecd.org/science/inno/38235147.pdf","subject":"FOS: Mathematics","subjectScheme":"Fields of Science and Technology (FOS)"}],"contributors":[],"dates":[{"date":"2026-02-23T21:05:14Z","dateType":"Submitted","dateInformation":"v1"},{"date":"2026-02-25T01:07:28Z","dateType":"Updated","dateInformation":"v1"},{"date":"2026-02","dateType":"Available","dateInformation":"v1"},{"date":"2026","dateType":"Issued"}],"language":null,"types":{"schemaOrg":"CreativeWork","resourceTypeGeneral":"Preprint","citeproc":"article","bibtex":"misc","ris":"GEN","resourceType":"Article"},"relatedIdentifiers":[],"relatedItems":[],"sizes":[],"formats":[],"version":"1","rightsList":[{"rightsIdentifierScheme":"SPDX","rightsUri":"https://creativecommons.org/licenses/by-sa/4.0/legalcode","schemeUri":"https://spdx.org/licenses/","rights":"Creative Commons Attribution Share Alike 4.0 International","rightsIdentifier":"cc-by-sa-4.0"}],"descriptions":[{"descriptionType":"Abstract","description":"In this paper, we study stochastic constrained minimax optimization problems with nonconvex-nonconcave structure, a central problem in modern machine learning, for which reliable and efficient algorithms remain largely unexplored due to its inherent challenges. Prior approaches for nonconvex minimax optimization often require (strong) concavity on the maximization part, or certain restrictive geometric assumptions on the joint objective to have guaranteed convergence. In contrast, our method only assumes weak convexity in the primal variable and the extended Kurdyka-Lojasiewicz (KL) property, with exponent $θ\\in [0,1]$, in the dual variable, significantly broadening the class of tractable problems. To this end, we propose a variance reduced algorithm that provably handles this general setting and achieves an $\\varepsilon$-stationary solution with state-of-the-art sample complexity: in the smooth finite-sum setting, the sample complexity is $\\mathcal{O}\\left(\\sqrt{N}\\,\\varepsilon^{-\\max\\{4θ,2\\}}\\right)$, where $N$ is the number of total samples, and in the online smooth setting, it is $\\mathcal{O}\\Big(\\varepsilon^{-\\max\\{6θ,3\\}}\\Big)$. For the structured nonsmooth problem, the sample complexity is $\\mathcal{O}\\left(\\sqrt{N}\\,\\max\\Big\\{\\varepsilon^{-3}, \\varepsilon^{-5θ}, \\varepsilon^{-\\frac{11θ-3}{2θ}}\\Big\\}\\right)$ and $\\mathcal{O}\\left(\\max\\left\\{\\varepsilon^{-4}, \\varepsilon^{-\\frac{15θ-1}{2}}, \\varepsilon^{-\\frac{31θ-9}{4θ}}\\right\\}\\right)$ respectively for the two settings. To the best of our knowledge, this is the first unified framework that jointly accommodates weak convexity, the extended KL property, and variance-reduced stochastic updates, making it highly suitable for large-scale applications."}],"geoLocations":[],"fundingReferences":[],"url":"https://arxiv.org/abs/2602.20357","contentUrl":null,"metadataVersion":0,"schemaVersion":"http://datacite.org/schema/kernel-4","source":"mds","isActive":true,"state":"findable","reason":null,"viewCount":0,"downloadCount":0,"referenceCount":0,"citationCount":0,"partCount":0,"partOfCount":0,"versionCount":0,"versionOfCount":0,"created":"2026-02-25T02:48:09Z","registered":"2026-02-25T02:48:10Z","published":null,"updated":"2026-02-25T02:48:10Z"},"relationships":{"client":{"data":{"id":"arxiv.content","type":"clients"}}}},{"id":"10.48550/arxiv.2602.20356","type":"dois","attributes":{"doi":"10.48550/arxiv.2602.20356","identifiers":[{"identifier":"2602.20356","identifierType":"arXiv"}],"creators":[{"nameType":"Personal","givenName":"Jennifer","familyName":"Cohen","name":"Cohen, Jennifer","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Yana","familyName":"Rodgers","name":"Rodgers, Yana","affiliation":[],"nameIdentifiers":[]}],"titles":[{"title":"Prevalence of Food and Housing Insecurity among Direct Support Professionals in New York"}],"publisher":"arXiv","container":{},"publicationYear":2026,"subjects":[{"subject":"General Economics (econ.GN)","lang":"en","subjectScheme":"arXiv"},{"subject":"FOS: Economics and business","subjectScheme":"Fields of Science and Technology (FOS)"},{"schemeUri":"http://www.oecd.org/science/inno/38235147.pdf","subject":"FOS: Economics and business","subjectScheme":"Fields of Science and Technology (FOS)"}],"contributors":[],"dates":[{"date":"2026-02-23T21:03:31Z","dateType":"Submitted","dateInformation":"v1"},{"date":"2026-02-25T01:07:21Z","dateType":"Updated","dateInformation":"v1"},{"date":"2026-02","dateType":"Available","dateInformation":"v1"},{"date":"2026","dateType":"Issued"}],"language":null,"types":{"schemaOrg":"CreativeWork","resourceTypeGeneral":"Preprint","citeproc":"article","bibtex":"misc","ris":"GEN","resourceType":"Article"},"relatedIdentifiers":[{"relationType":"IsVersionOf","relatedIdentifier":"10.1016/j.dhjo.2024.101769","relatedIdentifierType":"DOI"}],"relatedItems":[],"sizes":[],"formats":[],"version":"1","rightsList":[{"rightsIdentifierScheme":"SPDX","rightsUri":"https://creativecommons.org/licenses/by/4.0/legalcode","schemeUri":"https://spdx.org/licenses/","rights":"Creative Commons Attribution 4.0 International","rightsIdentifier":"cc-by-4.0"}],"descriptions":[{"descriptionType":"Abstract","description":"Background. Low earnings are associated with household insecurity. Direct Support Professionals (DSPs) provide support for people with intellectual and developmental disabilities, typically for wages close to state minimums, and may experience insecurity.\n Objective. The purpose of the study was to evaluate the prevalence of food and housing insecurity among DSPs.\n Methods. We conducted a statewide, cross-sectional survey of DSPs in New York State (2022-2023). Measures included detailed questions about food and housing insecurity. We used chi-square analyses and logistic regressions to examine relationships between insecurity and demographic characteristics as proxies for social determinants of health. A total of 4,503 DSPs responded to the survey. The analytic sample contained 2,766 respondents with complete data for all relevant variables.\n Results. Overall, 62.6% experienced food and/or housing insecurity, with over half of those respondents experiencing both. Insecurity was highest among DSPs with a disability (76.2%), DSPs of color (75.7%), and those with lower income (72.4%), but over 50% of DSPs across demographic groups experienced insecurity.\n Conclusions. The widespread insecurity this study demonstrates is an occupational hazard that reduces worker welfare. At the macro-level, household insecurity is a critical threat to the stability of the care and support delivery system. The human services sector is projected to grow rapidly in the future. If growth continues along low wage lines, it implies an equally rapid expansion of worker insecurity. Government action to raise pay and interventions that enhance food and housing security are needed to support workers in the care delivery system for people with intellectual and developmental disabilities."},{"descriptionType":"Other","description":"Published in Disability and Health Journal"}],"geoLocations":[],"fundingReferences":[],"url":"https://arxiv.org/abs/2602.20356","contentUrl":null,"metadataVersion":0,"schemaVersion":"http://datacite.org/schema/kernel-4","source":"mds","isActive":true,"state":"findable","reason":null,"viewCount":0,"downloadCount":0,"referenceCount":0,"citationCount":0,"partCount":0,"partOfCount":0,"versionCount":0,"versionOfCount":1,"created":"2026-02-25T02:48:08Z","registered":"2026-02-25T02:48:08Z","published":null,"updated":"2026-02-25T02:48:08Z"},"relationships":{"client":{"data":{"id":"arxiv.content","type":"clients"}}}},{"id":"10.48550/arxiv.2602.20354","type":"dois","attributes":{"doi":"10.48550/arxiv.2602.20354","identifiers":[{"identifier":"2602.20354","identifierType":"arXiv"}],"creators":[{"nameType":"Personal","givenName":"Bhavik","familyName":"Chandna","name":"Chandna, Bhavik","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Kelsey R.","familyName":"Allen","name":"Allen, Kelsey R.","affiliation":[],"nameIdentifiers":[]}],"titles":[{"title":"3DSPA: A 3D Semantic Point Autoencoder for Evaluating Video Realism"}],"publisher":"arXiv","container":{},"publicationYear":2026,"subjects":[{"subject":"Computer Vision and Pattern Recognition (cs.CV)","lang":"en","subjectScheme":"arXiv"},{"subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"},{"schemeUri":"http://www.oecd.org/science/inno/38235147.pdf","subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"}],"contributors":[],"dates":[{"date":"2026-02-23T21:00:48Z","dateType":"Submitted","dateInformation":"v1"},{"date":"2026-02-25T01:07:19Z","dateType":"Updated","dateInformation":"v1"},{"date":"2026-02","dateType":"Available","dateInformation":"v1"},{"date":"2026","dateType":"Issued"}],"language":null,"types":{"schemaOrg":"CreativeWork","resourceTypeGeneral":"Preprint","citeproc":"article","bibtex":"misc","ris":"GEN","resourceType":"Article"},"relatedIdentifiers":[],"relatedItems":[],"sizes":[],"formats":[],"version":"1","rightsList":[{"rightsIdentifierScheme":"SPDX","rightsUri":"https://creativecommons.org/licenses/by/4.0/legalcode","schemeUri":"https://spdx.org/licenses/","rights":"Creative Commons Attribution 4.0 International","rightsIdentifier":"cc-by-4.0"}],"descriptions":[{"descriptionType":"Abstract","description":"AI video generation is evolving rapidly. For video generators to be useful for applications ranging from robotics to film-making, they must consistently produce realistic videos. However, evaluating the realism of generated videos remains a largely manual process -- requiring human annotation or bespoke evaluation datasets which have restricted scope. Here we develop an automated evaluation framework for video realism which captures both semantics and coherent 3D structure and which does not require access to a reference video. Our method, 3DSPA, is a 3D spatiotemporal point autoencoder which integrates 3D point trajectories, depth cues, and DINO semantic features into a unified representation for video evaluation. 3DSPA models how objects move and what is happening in the scene, enabling robust assessments of realism, temporal consistency, and physical plausibility. Experiments show that 3DSPA reliably identifies videos which violate physical laws, is more sensitive to motion artifacts, and aligns more closely with human judgments of video quality and realism across multiple datasets. Our results demonstrate that enriching trajectory-based representations with 3D semantics offers a stronger foundation for benchmarking generative video models, and implicitly captures physical rule violations. The code and pretrained model weights will be available at https://github.com/TheProParadox/3dspa_code."}],"geoLocations":[],"fundingReferences":[],"url":"https://arxiv.org/abs/2602.20354","contentUrl":null,"metadataVersion":0,"schemaVersion":"http://datacite.org/schema/kernel-4","source":"mds","isActive":true,"state":"findable","reason":null,"viewCount":0,"downloadCount":0,"referenceCount":0,"citationCount":0,"partCount":0,"partOfCount":0,"versionCount":0,"versionOfCount":0,"created":"2026-02-25T02:48:05Z","registered":"2026-02-25T02:48:06Z","published":null,"updated":"2026-02-25T02:48:06Z"},"relationships":{"client":{"data":{"id":"arxiv.content","type":"clients"}}}},{"id":"10.48550/arxiv.2602.20353","type":"dois","attributes":{"doi":"10.48550/arxiv.2602.20353","identifiers":[{"identifier":"2602.20353","identifierType":"arXiv"}],"creators":[{"nameType":"Personal","givenName":"Xi","familyName":"Nan","name":"Nan, Xi","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Rugui","familyName":"Yao","name":"Yao, Rugui","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Ye","familyName":"Fan","name":"Fan, Ye","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Ruikang","familyName":"Zhong","name":"Zhong, Ruikang","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Xiaoya","familyName":"Zuo","name":"Zuo, Xiaoya","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Theodoros A.","familyName":"Tsiftsis","name":"Tsiftsis, Theodoros A.","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Alexandros-Apostolos A.","familyName":"Boulogeorgos","name":"Boulogeorgos, Alexandros-Apostolos A.","affiliation":[],"nameIdentifiers":[]}],"titles":[{"title":"Waveform Design for Partial-Time Superimposed ISAC Systems"}],"publisher":"arXiv","container":{},"publicationYear":2026,"subjects":[{"subject":"Signal Processing (eess.SP)","lang":"en","subjectScheme":"arXiv"},{"subject":"FOS: Electrical engineering, electronic engineering, information engineering","subjectScheme":"Fields of Science and Technology (FOS)"},{"schemeUri":"http://www.oecd.org/science/inno/38235147.pdf","subject":"FOS: Electrical engineering, electronic engineering, information engineering","subjectScheme":"Fields of Science and Technology (FOS)"}],"contributors":[],"dates":[{"date":"2026-02-23T20:56:33Z","dateType":"Submitted","dateInformation":"v1"},{"date":"2026-02-25T01:07:15Z","dateType":"Updated","dateInformation":"v1"},{"date":"2026-02","dateType":"Available","dateInformation":"v1"},{"date":"2026","dateType":"Issued"}],"language":null,"types":{"schemaOrg":"CreativeWork","resourceTypeGeneral":"Preprint","citeproc":"article","bibtex":"misc","ris":"GEN","resourceType":"Article"},"relatedIdentifiers":[{"relationType":"IsVersionOf","relatedIdentifier":"10.1109/tgcn.2026.3664405","relatedIdentifierType":"DOI"}],"relatedItems":[],"sizes":[],"formats":[],"version":"1","rightsList":[{"rightsUri":"http://arxiv.org/licenses/nonexclusive-distrib/1.0/","rights":"arXiv.org perpetual, non-exclusive license"}],"descriptions":[{"descriptionType":"Abstract","description":"Nowadays, waveforms of integrated sensing and communication (ISAC) are almost based on conventional communication and sensing signal, which bounds both the communication and sensing performance. To deal with this issue, in this paper, a novel waveform design is presented for the partial-time superimposed (PTS) ISAC system. At the base station (BS), a parameter-adjustable linear frequency modulation (LFM) pulse signal and a continuous communication orthogonal frequency division multiplexing (OFDM) signal are employed to broadcast public information and perform sensing tasks, respectively, using a PTS scheme. Pulse compression gain enhances the system's long-range sensing capability, while OFDM ensures the system's high-speed data transmission capability. Meanwhile, the LFM signal is utilized as superimposed pilot for channel estimation, which has higher time-frequency resource utilization and stronger real-time performance compared to orthogonal pilots. We present an accurate parameter estimation method of multi-path sensing signal for reconstructing and interference cancellation in communication users. Additionally, a cyclic maximum likelihood method is introduced for channel estimation and the Cramer-Rao lower bound (CRLB) of channel estimation is derived. Simulations demonstrate the accuracy and robustness of the proposed parameter estimation algorithm as well as the improved channel estimation performance over traditional methods. The proposed waveform design method can achieve reliable data transmission and accurate target sensing."},{"descriptionType":"Other","description":"15 pages, 17 figures, journal"}],"geoLocations":[],"fundingReferences":[],"url":"https://arxiv.org/abs/2602.20353","contentUrl":null,"metadataVersion":0,"schemaVersion":"http://datacite.org/schema/kernel-4","source":"mds","isActive":true,"state":"findable","reason":null,"viewCount":0,"downloadCount":0,"referenceCount":0,"citationCount":0,"partCount":0,"partOfCount":0,"versionCount":0,"versionOfCount":1,"created":"2026-02-25T02:48:04Z","registered":"2026-02-25T02:48:04Z","published":null,"updated":"2026-02-25T02:48:04Z"},"relationships":{"client":{"data":{"id":"arxiv.content","type":"clients"}}}},{"id":"10.48550/arxiv.2602.20352","type":"dois","attributes":{"doi":"10.48550/arxiv.2602.20352","identifiers":[{"identifier":"2602.20352","identifierType":"arXiv"}],"creators":[{"nameType":"Personal","givenName":"Vinit","familyName":"Singh","name":"Singh, Vinit","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Amandeep Singh","familyName":"Bhatia","name":"Bhatia, Amandeep Singh","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Mandeep Kaur","familyName":"Saggi","name":"Saggi, Mandeep Kaur","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Manas","familyName":"Sajjan","name":"Sajjan, Manas","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Sabre","familyName":"Kais","name":"Kais, Sabre","affiliation":[],"nameIdentifiers":[]}],"titles":[{"title":"Quantum Machine Learning for Complex Systems"}],"publisher":"arXiv","container":{},"publicationYear":2026,"subjects":[{"subject":"Quantum Physics (quant-ph)","lang":"en","subjectScheme":"arXiv"},{"subject":"FOS: Physical sciences","subjectScheme":"Fields of Science and Technology (FOS)"},{"schemeUri":"http://www.oecd.org/science/inno/38235147.pdf","subject":"FOS: Physical sciences","subjectScheme":"Fields of Science and Technology (FOS)"}],"contributors":[],"dates":[{"date":"2026-02-23T20:54:08Z","dateType":"Submitted","dateInformation":"v1"},{"date":"2026-02-25T01:07:13Z","dateType":"Updated","dateInformation":"v1"},{"date":"2026-02","dateType":"Available","dateInformation":"v1"},{"date":"2026","dateType":"Issued"}],"language":null,"types":{"schemaOrg":"CreativeWork","resourceTypeGeneral":"Preprint","citeproc":"article","bibtex":"misc","ris":"GEN","resourceType":"Article"},"relatedIdentifiers":[],"relatedItems":[],"sizes":[],"formats":[],"version":"1","rightsList":[{"rightsIdentifierScheme":"SPDX","rightsUri":"https://creativecommons.org/licenses/by/4.0/legalcode","schemeUri":"https://spdx.org/licenses/","rights":"Creative Commons Attribution 4.0 International","rightsIdentifier":"cc-by-4.0"}],"descriptions":[{"descriptionType":"Abstract","description":"Quantum machine learning (QML) is rapidly transitioning from theoretical promise to practical relevance across data-intensive scientific domains. In this Review, we provide a structured overview of recent advances that bridge foundational quantum learning principles with real-world applications. We survey foundational QML paradigms, including variational quantum algorithms, quantum kernel methods, and neural-network quantum states, with emphasis on their applicability to complex quantum systems. We examine neural-network quantum states as expressive variational models for correlated matter, non-equilibrium dynamics, and open quantum systems, and discuss fundamental challenges associated with training and sampling. Recent advances in quantum-enhanced sampling and diagnostics of learning dynamics, including information-theoretic tools, are reviewed as mechanisms for improving scalability and trainability. The Review further highlights application-driven QML frameworks in drug discovery, cancer biology, and agro-climate modeling, where data complexity and constraints motivate hybrid quantum-classical approaches. We conclude with a discussion of federated quantum machine learning as a route to distributed, privacy-preserving quantum intelligence. Overall, this Review presents a unified perspective on the opportunities and limitations of QML for complex systems."}],"geoLocations":[],"fundingReferences":[],"url":"https://arxiv.org/abs/2602.20352","contentUrl":null,"metadataVersion":0,"schemaVersion":"http://datacite.org/schema/kernel-4","source":"mds","isActive":true,"state":"findable","reason":null,"viewCount":0,"downloadCount":0,"referenceCount":0,"citationCount":0,"partCount":0,"partOfCount":0,"versionCount":0,"versionOfCount":0,"created":"2026-02-25T02:48:02Z","registered":"2026-02-25T02:48:03Z","published":null,"updated":"2026-02-25T02:48:03Z"},"relationships":{"client":{"data":{"id":"arxiv.content","type":"clients"}}}},{"id":"10.48550/arxiv.2602.20351","type":"dois","attributes":{"doi":"10.48550/arxiv.2602.20351","identifiers":[{"identifier":"2602.20351","identifierType":"arXiv"}],"creators":[{"nameType":"Personal","givenName":"Aleksandr","familyName":"Gushchin","name":"Gushchin, Aleksandr","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Dmitriy S.","familyName":"Vatolin","name":"Vatolin, Dmitriy S.","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Anastasia","familyName":"Antsiferova","name":"Antsiferova, Anastasia","affiliation":[],"nameIdentifiers":[]}],"titles":[{"title":"BiRQA: Bidirectional Robust Quality Assessment for Images"}],"publisher":"arXiv","container":{},"publicationYear":2026,"subjects":[{"subject":"Computer Vision and Pattern Recognition (cs.CV)","lang":"en","subjectScheme":"arXiv"},{"subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"},{"schemeUri":"http://www.oecd.org/science/inno/38235147.pdf","subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"}],"contributors":[],"dates":[{"date":"2026-02-23T20:52:56Z","dateType":"Submitted","dateInformation":"v1"},{"date":"2026-02-25T01:07:09Z","dateType":"Updated","dateInformation":"v1"},{"date":"2026-02","dateType":"Available","dateInformation":"v1"},{"date":"2026","dateType":"Issued"}],"language":null,"types":{"schemaOrg":"CreativeWork","resourceTypeGeneral":"Preprint","citeproc":"article","bibtex":"misc","ris":"GEN","resourceType":"Article"},"relatedIdentifiers":[],"relatedItems":[],"sizes":[],"formats":[],"version":"1","rightsList":[{"rightsIdentifierScheme":"SPDX","rightsUri":"https://creativecommons.org/licenses/by/4.0/legalcode","schemeUri":"https://spdx.org/licenses/","rights":"Creative Commons Attribution 4.0 International","rightsIdentifier":"cc-by-4.0"}],"descriptions":[{"descriptionType":"Abstract","description":"Full-Reference image quality assessment (FR IQA) is important for image compression, restoration and generative modeling, yet current neural metrics remain slow and vulnerable to adversarial perturbations. We present BiRQA, a compact FR IQA metric model that processes four fast complementary features within a bidirectional multiscale pyramid. A bottom-up attention module injects fine-scale cues into coarse levels through an uncertainty-aware gate, while a top-down cross-gating block routes semantic context back to high resolution. To enhance robustness, we introduce Anchored Adversarial Training, a theoretically grounded strategy that uses clean \"anchor\" samples and a ranking loss to bound pointwise prediction error under attacks. On five public FR IQA benchmarks BiRQA outperforms or matches the previous state of the art (SOTA) while running ~3x faster than previous SOTA models. Under unseen white-box attacks it lifts SROCC from 0.30-0.57 to 0.60-0.84 on KADID-10k, demonstrating substantial robustness gains. To our knowledge, BiRQA is the only FR IQA model combining competitive accuracy with real-time throughput and strong adversarial resilience."}],"geoLocations":[],"fundingReferences":[],"url":"https://arxiv.org/abs/2602.20351","contentUrl":null,"metadataVersion":0,"schemaVersion":"http://datacite.org/schema/kernel-4","source":"mds","isActive":true,"state":"findable","reason":null,"viewCount":0,"downloadCount":0,"referenceCount":0,"citationCount":0,"partCount":0,"partOfCount":0,"versionCount":0,"versionOfCount":0,"created":"2026-02-25T02:48:01Z","registered":"2026-02-25T02:48:01Z","published":null,"updated":"2026-02-25T02:48:01Z"},"relationships":{"client":{"data":{"id":"arxiv.content","type":"clients"}}}},{"id":"10.48550/arxiv.2602.20350","type":"dois","attributes":{"doi":"10.48550/arxiv.2602.20350","identifiers":[{"identifier":"2602.20350","identifierType":"arXiv"}],"creators":[{"nameType":"Personal","givenName":"Yibo","familyName":"Meng","name":"Meng, Yibo","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Bingyi","familyName":"Liu","name":"Liu, Bingyi","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Ruiqi","familyName":"Chen","name":"Chen, Ruiqi","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Yan","familyName":"Guan","name":"Guan, Yan","affiliation":[],"nameIdentifiers":[]}],"titles":[{"title":"Misty Forest VR: Turning Real ADHD Attention Patterns into Shared Momentum for Youth Collaboration"}],"publisher":"arXiv","container":{},"publicationYear":2026,"subjects":[{"subject":"Human-Computer Interaction (cs.HC)","lang":"en","subjectScheme":"arXiv"},{"subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"},{"schemeUri":"http://www.oecd.org/science/inno/38235147.pdf","subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"},{"subject":"H.5.1; H.5.2","lang":"en","subjectScheme":"ACM"}],"contributors":[],"dates":[{"date":"2026-02-23T20:51:56Z","dateType":"Submitted","dateInformation":"v1"},{"date":"2026-02-25T01:07:04Z","dateType":"Updated","dateInformation":"v1"},{"date":"2026-02","dateType":"Available","dateInformation":"v1"},{"date":"2026","dateType":"Issued"}],"language":null,"types":{"schemaOrg":"CreativeWork","resourceTypeGeneral":"Preprint","citeproc":"article","bibtex":"misc","ris":"GEN","resourceType":"Article"},"relatedIdentifiers":[],"relatedItems":[],"sizes":[],"formats":[],"version":"1","rightsList":[{"rightsIdentifierScheme":"SPDX","rightsUri":"https://creativecommons.org/licenses/by/4.0/legalcode","schemeUri":"https://spdx.org/licenses/","rights":"Creative Commons Attribution 4.0 International","rightsIdentifier":"cc-by-4.0"}],"descriptions":[{"descriptionType":"Abstract","description":"Attention Deficit Hyperactivity Disorder (ADHD) remains highly stigmatized in many cultural contexts, particularly in China, where ADHD-related behaviors are often moralized rather than understood as neurodevelopmental differences. As a result, challenges of self-perception, social misunderstanding, and collaboration between ADHD and non-ADHD individuals remain largely unaddressed. We present Misty Forest, a VR-based collaborative game that explores ADHD through asymmetric co-play. The system translates empirically grounded ADHD behavioral patterns -- such as fluctuating attention and time blindness -- into complementary roles that require mutual coordination between players. Rather than compensating for deficits, the design treats cognitive differences as a source of interdependence. In a controlled study with mixed ADHD--non-ADHD dyads, Misty Forest led to higher task completion, increased self-acceptance among ADHD participants, improved ADHD knowledge, and greater empathy among non-ADHD players. These findings suggest that neurodiversity-centered interactive design can foster understanding, reciprocity, and inclusive collaboration."},{"descriptionType":"Other","description":"Accepted by CHI Poster 2026"}],"geoLocations":[],"fundingReferences":[],"url":"https://arxiv.org/abs/2602.20350","contentUrl":null,"metadataVersion":0,"schemaVersion":"http://datacite.org/schema/kernel-4","source":"mds","isActive":true,"state":"findable","reason":null,"viewCount":0,"downloadCount":0,"referenceCount":0,"citationCount":0,"partCount":0,"partOfCount":0,"versionCount":0,"versionOfCount":0,"created":"2026-02-25T02:47:59Z","registered":"2026-02-25T02:48:00Z","published":null,"updated":"2026-02-25T02:48:00Z"},"relationships":{"client":{"data":{"id":"arxiv.content","type":"clients"}}}},{"id":"10.48550/arxiv.2602.20348","type":"dois","attributes":{"doi":"10.48550/arxiv.2602.20348","identifiers":[{"identifier":"2602.20348","identifierType":"arXiv"}],"creators":[{"nameType":"Personal","givenName":"Yibo","familyName":"Meng","name":"Meng, Yibo","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Bingyi","familyName":"Liu","name":"Liu, Bingyi","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Ruiqi","familyName":"Chen","name":"Chen, Ruiqi","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Xin","familyName":"Chen","name":"Chen, Xin","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Yan","familyName":"Guan","name":"Guan, Yan","affiliation":[],"nameIdentifiers":[]}],"titles":[{"title":"52-Hz Whale Song: An Embodied VR Experience for Exploring Misunderstanding and Empathy"}],"publisher":"arXiv","container":{},"publicationYear":2026,"subjects":[{"subject":"Human-Computer Interaction (cs.HC)","lang":"en","subjectScheme":"arXiv"},{"subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"},{"schemeUri":"http://www.oecd.org/science/inno/38235147.pdf","subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"},{"subject":"H.5.1; H.5.2","lang":"en","subjectScheme":"ACM"}],"contributors":[],"dates":[{"date":"2026-02-23T20:49:07Z","dateType":"Submitted","dateInformation":"v1"},{"date":"2026-02-25T01:06:56Z","dateType":"Updated","dateInformation":"v1"},{"date":"2026-02","dateType":"Available","dateInformation":"v1"},{"date":"2026","dateType":"Issued"}],"language":null,"types":{"schemaOrg":"CreativeWork","resourceTypeGeneral":"Preprint","citeproc":"article","bibtex":"misc","ris":"GEN","resourceType":"Article"},"relatedIdentifiers":[],"relatedItems":[],"sizes":[],"formats":[],"version":"1","rightsList":[{"rightsIdentifierScheme":"SPDX","rightsUri":"https://creativecommons.org/licenses/by/4.0/legalcode","schemeUri":"https://spdx.org/licenses/","rights":"Creative Commons Attribution 4.0 International","rightsIdentifier":"cc-by-4.0"}],"descriptions":[{"descriptionType":"Abstract","description":"Experiences of being misunderstood often stem not from a lack of voice, but from mismatches between how individuals express themselves and how others listen. Such communicative mismatches arise across many social settings, including situations involving linguistic and cultural displacement. While prior HCI research has explored empathy through virtual reality, many approaches rely on narrative explanation, positioning users as observers rather than embodied participants. We present 52-Hz Whale Song, an embodied VR experience that explores miscommunication through metaphor and perspective-shifting. Inspired by the real-world \"52-Hz whale,\" whose calls are not responded to by others, the experience uses this phenomenon as an experiential lens on communicative mismatch rather than representing any specific social group. Players progress through a three-act arc that moves from failed communication to agency and ultimately to mediation. A preliminary mixed-methods study (N = 30) suggests increased perspective-taking and reduced self-reported social distance in immigrant-related situations. This work highlights how embodied metaphor and role-shifting can support empathic engagement and offers transferable design insights for empathy-oriented interactive systems."},{"descriptionType":"Other","description":"Accepted as CHI 26 Poster"}],"geoLocations":[],"fundingReferences":[],"url":"https://arxiv.org/abs/2602.20348","contentUrl":null,"metadataVersion":0,"schemaVersion":"http://datacite.org/schema/kernel-4","source":"mds","isActive":true,"state":"findable","reason":null,"viewCount":0,"downloadCount":0,"referenceCount":0,"citationCount":0,"partCount":0,"partOfCount":0,"versionCount":0,"versionOfCount":0,"created":"2026-02-25T02:47:56Z","registered":"2026-02-25T02:47:57Z","published":null,"updated":"2026-02-25T02:47:57Z"},"relationships":{"client":{"data":{"id":"arxiv.content","type":"clients"}}}},{"id":"10.48550/arxiv.2602.20347","type":"dois","attributes":{"doi":"10.48550/arxiv.2602.20347","identifiers":[{"identifier":"2602.20347","identifierType":"arXiv"}],"creators":[{"nameType":"Personal","givenName":"Hideyasu","familyName":"Yamashita","name":"Yamashita, Hideyasu","affiliation":[],"nameIdentifiers":[]}],"titles":[{"title":"A note on the conceptual problems on the Unruh effect"}],"publisher":"arXiv","container":{},"publicationYear":2026,"subjects":[{"subject":"General Relativity and Quantum Cosmology (gr-qc)","lang":"en","subjectScheme":"arXiv"},{"subject":"Mathematical Physics (math-ph)","lang":"en","subjectScheme":"arXiv"},{"subject":"Quantum Physics (quant-ph)","lang":"en","subjectScheme":"arXiv"},{"subject":"FOS: Physical sciences","subjectScheme":"Fields of Science and Technology (FOS)"},{"schemeUri":"http://www.oecd.org/science/inno/38235147.pdf","subject":"FOS: Physical sciences","subjectScheme":"Fields of Science and Technology (FOS)"},{"subject":"81T20 (Primary) 81P05, 81T05 (Secondary)","lang":"en","subjectScheme":"MSC"}],"contributors":[],"dates":[{"date":"2026-02-23T20:45:09Z","dateType":"Submitted","dateInformation":"v1"},{"date":"2026-02-25T01:06:50Z","dateType":"Updated","dateInformation":"v1"},{"date":"2026-02","dateType":"Available","dateInformation":"v1"},{"date":"2026","dateType":"Issued"}],"language":null,"types":{"schemaOrg":"CreativeWork","resourceTypeGeneral":"Preprint","citeproc":"article","bibtex":"misc","ris":"GEN","resourceType":"Article"},"relatedIdentifiers":[],"relatedItems":[],"sizes":[],"formats":[],"version":"1","rightsList":[{"rightsUri":"http://arxiv.org/licenses/nonexclusive-distrib/1.0/","rights":"arXiv.org perpetual, non-exclusive license"}],"descriptions":[{"descriptionType":"Abstract","description":"This brief note is written with a somewhat similar purpose to Earman's 2011 paper on the conceptual problems on the Unruh effect. However, we confine ourselves to Sewell's modular approach to the Unruh effect, which is based on the theorems of Tomita-Takesaki and Bisognano-Wichmann. This approach is rigorous, and has an advantage of being model-independent. However, we will see that a number of conceptual problems remain unsolved on this approach."},{"descriptionType":"Other","description":"10 pages"}],"geoLocations":[],"fundingReferences":[],"url":"https://arxiv.org/abs/2602.20347","contentUrl":null,"metadataVersion":0,"schemaVersion":"http://datacite.org/schema/kernel-4","source":"mds","isActive":true,"state":"findable","reason":null,"viewCount":0,"downloadCount":0,"referenceCount":0,"citationCount":0,"partCount":0,"partOfCount":0,"versionCount":0,"versionOfCount":0,"created":"2026-02-25T02:47:55Z","registered":"2026-02-25T02:47:56Z","published":null,"updated":"2026-02-25T02:47:56Z"},"relationships":{"client":{"data":{"id":"arxiv.content","type":"clients"}}}},{"id":"10.48550/arxiv.2602.20345","type":"dois","attributes":{"doi":"10.48550/arxiv.2602.20345","identifiers":[{"identifier":"2602.20345","identifierType":"arXiv"}],"creators":[{"nameType":"Personal","givenName":"Subash Chandra","familyName":"Behera","name":"Behera, Subash Chandra","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Dukhishyam","familyName":"Mallick","name":"Mallick, Dukhishyam","affiliation":[],"nameIdentifiers":[]}],"titles":[{"title":"Exploring differential two-particle correlations in $γp$ and low-multiplicity pp collisions using PYTHIA8"}],"publisher":"arXiv","container":{},"publicationYear":2026,"subjects":[{"subject":"Nuclear Experiment (nucl-ex)","lang":"en","subjectScheme":"arXiv"},{"subject":"High Energy Physics - Experiment (hep-ex)","lang":"en","subjectScheme":"arXiv"},{"subject":"High Energy Physics - Phenomenology (hep-ph)","lang":"en","subjectScheme":"arXiv"},{"subject":"FOS: Physical sciences","subjectScheme":"Fields of Science and Technology (FOS)"},{"schemeUri":"http://www.oecd.org/science/inno/38235147.pdf","subject":"FOS: Physical sciences","subjectScheme":"Fields of Science and Technology (FOS)"}],"contributors":[],"dates":[{"date":"2026-02-23T20:42:09Z","dateType":"Submitted","dateInformation":"v1"},{"date":"2026-02-25T01:06:38Z","dateType":"Updated","dateInformation":"v1"},{"date":"2026-02","dateType":"Available","dateInformation":"v1"},{"date":"2026","dateType":"Issued"}],"language":null,"types":{"schemaOrg":"CreativeWork","resourceTypeGeneral":"Preprint","citeproc":"article","bibtex":"misc","ris":"GEN","resourceType":"Article"},"relatedIdentifiers":[],"relatedItems":[],"sizes":[],"formats":[],"version":"1","rightsList":[{"rightsIdentifierScheme":"SPDX","rightsUri":"https://creativecommons.org/licenses/by-nc-nd/4.0/legalcode","schemeUri":"https://spdx.org/licenses/","rights":"Creative Commons Attribution Non Commercial No Derivatives 4.0 International","rightsIdentifier":"cc-by-nc-nd-4.0"}],"descriptions":[{"descriptionType":"Abstract","description":"A study of two-particle differential number ($B$) and transverse momentum ($P_{2}^\\mathrm{CD}$) balance functions in photon-proton ($γp$) and proton-proton (pp) collisions at $\\sqrt{s}=$ 5.36 TeV is presented. The analysis focuses on inclusive charged hadrons within the pseudorapidity coverage $|η|\u0026lt;2.4$ and the transverse momentum interval $0.3 \u0026lt; p_\\mathrm{T} \u0026lt; 3.0$ GeV and examines their correlations in terms of relative pseudorapidity ($Δη$) and relative azimuthal angle ($Δϕ$). The correlation functions are evaluated for same- and opposite-sign pairs, and their combinations are used to extract charge-dependent (CD) and charge-independent (CI) components. The evolution of the near-side peak of the CD correlations is investigated in terms of $Δη$ and $Δϕ$ as a function of charged-particle multiplicity ($N_\\mathrm{ch}$) for $γp$ collisions and compared to pp collisions at a similar multiplicity range. A clear multiplicity dependence of the balance function width is obtained. The width is found systematically lower in $γp$ events than in pp collisions. This study provides valuable information on particle correlations and production mechanisms in low-$N_\\mathrm{ch}$ regimes for upcoming measurements in small systems."},{"descriptionType":"Other","description":"13 pages, 9 figures"}],"geoLocations":[],"fundingReferences":[],"url":"https://arxiv.org/abs/2602.20345","contentUrl":null,"metadataVersion":0,"schemaVersion":"http://datacite.org/schema/kernel-4","source":"mds","isActive":true,"state":"findable","reason":null,"viewCount":0,"downloadCount":0,"referenceCount":0,"citationCount":0,"partCount":0,"partOfCount":0,"versionCount":0,"versionOfCount":0,"created":"2026-02-25T02:47:52Z","registered":"2026-02-25T02:47:53Z","published":null,"updated":"2026-02-25T02:47:53Z"},"relationships":{"client":{"data":{"id":"arxiv.content","type":"clients"}}}},{"id":"10.48550/arxiv.2602.20344","type":"dois","attributes":{"doi":"10.48550/arxiv.2602.20344","identifiers":[{"identifier":"2602.20344","identifierType":"arXiv"}],"creators":[{"nameType":"Personal","givenName":"Jiele","familyName":"Wu","name":"Wu, Jiele","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Haozhe","familyName":"Ma","name":"Ma, Haozhe","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Zhihan","familyName":"Guo","name":"Guo, Zhihan","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Thanh Vinh","familyName":"Vo","name":"Vo, Thanh Vinh","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Tze Yun","familyName":"Leong","name":"Leong, Tze Yun","affiliation":[],"nameIdentifiers":[]}],"titles":[{"title":"Hierarchical Molecular Representation Learning via Fragment-Based Self-Supervised Embedding Prediction"}],"publisher":"arXiv","container":{},"publicationYear":2026,"subjects":[{"subject":"Machine Learning (cs.LG)","lang":"en","subjectScheme":"arXiv"},{"subject":"Artificial Intelligence (cs.AI)","lang":"en","subjectScheme":"arXiv"},{"subject":"Quantitative Methods (q-bio.QM)","lang":"en","subjectScheme":"arXiv"},{"subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"},{"schemeUri":"http://www.oecd.org/science/inno/38235147.pdf","subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"},{"subject":"FOS: Biological sciences","subjectScheme":"Fields of Science and Technology (FOS)"},{"schemeUri":"http://www.oecd.org/science/inno/38235147.pdf","subject":"FOS: Biological sciences","subjectScheme":"Fields of Science and Technology (FOS)"}],"contributors":[],"dates":[{"date":"2026-02-23T20:41:44Z","dateType":"Submitted","dateInformation":"v1"},{"date":"2026-02-25T01:06:37Z","dateType":"Updated","dateInformation":"v1"},{"date":"2026-02","dateType":"Available","dateInformation":"v1"},{"date":"2026","dateType":"Issued"}],"language":null,"types":{"schemaOrg":"CreativeWork","resourceTypeGeneral":"Preprint","citeproc":"article","bibtex":"misc","ris":"GEN","resourceType":"Article"},"relatedIdentifiers":[],"relatedItems":[],"sizes":[],"formats":[],"version":"1","rightsList":[{"rightsUri":"http://arxiv.org/licenses/nonexclusive-distrib/1.0/","rights":"arXiv.org perpetual, non-exclusive license"}],"descriptions":[{"descriptionType":"Abstract","description":"Graph self-supervised learning (GSSL) has demonstrated strong potential for generating expressive graph embeddings without the need for human annotations, making it particularly valuable in domains with high labeling costs such as molecular graph analysis. However, existing GSSL methods mostly focus on node- or edge-level information, often ignoring chemically relevant substructures which strongly influence molecular properties. In this work, we propose Graph Semantic Predictive Network (GraSPNet), a hierarchical self-supervised framework that explicitly models both atomic-level and fragment-level semantics. GraSPNet decomposes molecular graphs into chemically meaningful fragments without predefined vocabularies and learns node- and fragment-level representations through multi-level message passing with masked semantic prediction at both levels. This hierarchical semantic supervision enables GraSPNet to learn multi-resolution structural information that is both expressive and transferable. Extensive experiments on multiple molecular property prediction benchmarks demonstrate that GraSPNet learns chemically meaningful representations and consistently outperforms state-of-the-art GSSL methods in transfer learning settings."},{"descriptionType":"Other","description":"15 pages (8 pages main text),8 figures"}],"geoLocations":[],"fundingReferences":[],"url":"https://arxiv.org/abs/2602.20344","contentUrl":null,"metadataVersion":0,"schemaVersion":"http://datacite.org/schema/kernel-4","source":"mds","isActive":true,"state":"findable","reason":null,"viewCount":0,"downloadCount":0,"referenceCount":0,"citationCount":0,"partCount":0,"partOfCount":0,"versionCount":0,"versionOfCount":0,"created":"2026-02-25T02:47:51Z","registered":"2026-02-25T02:47:51Z","published":null,"updated":"2026-02-25T02:47:51Z"},"relationships":{"client":{"data":{"id":"arxiv.content","type":"clients"}}}},{"id":"10.48550/arxiv.2602.20343","type":"dois","attributes":{"doi":"10.48550/arxiv.2602.20343","identifiers":[{"identifier":"2602.20343","identifierType":"arXiv"}],"creators":[{"nameType":"Personal","givenName":"C.","familyName":"Daoutis","name":"Daoutis, C.","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"A.","familyName":"Zezas","name":"Zezas, A.","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"E.","familyName":"Kyritsis","name":"Kyritsis, E.","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"K.","familyName":"Kouroumpatzakis","name":"Kouroumpatzakis, K.","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"P.","familyName":"Bonfini","name":"Bonfini, P.","affiliation":[],"nameIdentifiers":[]}],"titles":[{"title":"An automated activity classification tool for optical galaxy spectra"}],"publisher":"arXiv","container":{},"publicationYear":2026,"subjects":[{"subject":"Astrophysics of Galaxies (astro-ph.GA)","lang":"en","subjectScheme":"arXiv"},{"subject":"FOS: Physical sciences","subjectScheme":"Fields of Science and Technology (FOS)"},{"schemeUri":"http://www.oecd.org/science/inno/38235147.pdf","subject":"FOS: Physical sciences","subjectScheme":"Fields of Science and Technology (FOS)"}],"contributors":[],"dates":[{"date":"2026-02-23T20:40:27Z","dateType":"Submitted","dateInformation":"v1"},{"date":"2026-02-25T01:06:36Z","dateType":"Updated","dateInformation":"v1"},{"date":"2026-02","dateType":"Available","dateInformation":"v1"},{"date":"2026","dateType":"Issued"}],"language":null,"types":{"schemaOrg":"CreativeWork","resourceTypeGeneral":"Preprint","citeproc":"article","bibtex":"misc","ris":"GEN","resourceType":"Article"},"relatedIdentifiers":[],"relatedItems":[],"sizes":[],"formats":[],"version":"1","rightsList":[{"rightsIdentifierScheme":"SPDX","rightsUri":"https://creativecommons.org/licenses/by/4.0/legalcode","schemeUri":"https://spdx.org/licenses/","rights":"Creative Commons Attribution 4.0 International","rightsIdentifier":"cc-by-4.0"}],"descriptions":[{"descriptionType":"Abstract","description":"Reliable, versatile galaxy activity diagnostics are essential for understanding galaxy evolution. Traditional methods frequently necessitate extensive preprocessing, such as starlight subtraction and emission line deblending (e.g., Hα and [N II]), which can introduce substantial biases and uncertainties due to their model-dependent nature. In this work we developed an automated, diagnostic tool capable of distinguishing between star-forming (SF), active galactic nuclei (AGN), low-ionization nuclear emission-line regions (LINERs), composite, and passive galaxies. We developed a diagnostic tool based on a support vector machine trained on data from optical emission-line ratios and color selection criteria. From literature studies and exploring combinations of discriminatory feature schemes, we found that the equivalent widths of Hβ, [O III]λ5007, and Hα+[N II]λ6548,84 as key diagnostic features. Additionally, galaxies classified as AGN can be distinguished into broad- and narrow-line AGN by measuring the full quarter at the half-maximum of Hα and [N II] complex. We have developed a diagnostic tool that encompasses all activities of galaxies while achieving high performance scores across all of them. Our diagnostic achieves overall accuracy of 83% and recall of 79% for SF, 94% for AGN, 85% for LINER, 77% for composite, and 96% for passive galaxies. Our diagnostic tool significantly improves upon existing diagnostics as it eliminates the need for preprocessing (i.e., starlight subtraction or flux calibration) and spectral line fitting, includes all activity classes under one scheme, and distinguishes the two main AGN types. In addition, omitting starlight subtraction does not significantly reduce performance. Furthermore, Its narrow wavelength requirement enables use across a wide redshift range, making it ideal for high-z studies."},{"descriptionType":"Other","description":"Accepted for publication in A\u0026amp;A, 14 pages, 11 figures"}],"geoLocations":[],"fundingReferences":[],"url":"https://arxiv.org/abs/2602.20343","contentUrl":null,"metadataVersion":0,"schemaVersion":"http://datacite.org/schema/kernel-4","source":"mds","isActive":true,"state":"findable","reason":null,"viewCount":0,"downloadCount":0,"referenceCount":0,"citationCount":0,"partCount":0,"partOfCount":0,"versionCount":0,"versionOfCount":0,"created":"2026-02-25T02:47:49Z","registered":"2026-02-25T02:47:50Z","published":null,"updated":"2026-02-25T02:47:50Z"},"relationships":{"client":{"data":{"id":"arxiv.content","type":"clients"}}}},{"id":"10.48550/arxiv.2602.20342","type":"dois","attributes":{"doi":"10.48550/arxiv.2602.20342","identifiers":[{"identifier":"2602.20342","identifierType":"arXiv"}],"creators":[{"nameType":"Personal","givenName":"Christos","familyName":"Maikos","name":"Maikos, Christos","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Georgios","familyName":"Angelidis","name":"Angelidis, Georgios","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Georgios Th.","familyName":"Papadopoulos","name":"Papadopoulos, Georgios Th.","affiliation":[],"nameIdentifiers":[]}],"titles":[{"title":"Large-scale Photorealistic Outdoor 3D Scene Reconstruction from UAV Imagery Using Gaussian Splatting Techniques"}],"publisher":"arXiv","container":{},"publicationYear":2026,"subjects":[{"subject":"Computer Vision and Pattern Recognition (cs.CV)","lang":"en","subjectScheme":"arXiv"},{"subject":"Robotics (cs.RO)","lang":"en","subjectScheme":"arXiv"},{"subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"},{"schemeUri":"http://www.oecd.org/science/inno/38235147.pdf","subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"}],"contributors":[],"dates":[{"date":"2026-02-23T20:40:26Z","dateType":"Submitted","dateInformation":"v1"},{"date":"2026-02-25T01:06:35Z","dateType":"Updated","dateInformation":"v1"},{"date":"2026-02","dateType":"Available","dateInformation":"v1"},{"date":"2026","dateType":"Issued"}],"language":null,"types":{"schemaOrg":"CreativeWork","resourceTypeGeneral":"Preprint","citeproc":"article","bibtex":"misc","ris":"GEN","resourceType":"Article"},"relatedIdentifiers":[],"relatedItems":[],"sizes":[],"formats":[],"version":"1","rightsList":[{"rightsIdentifierScheme":"SPDX","rightsUri":"https://creativecommons.org/licenses/by/4.0/legalcode","schemeUri":"https://spdx.org/licenses/","rights":"Creative Commons Attribution 4.0 International","rightsIdentifier":"cc-by-4.0"}],"descriptions":[{"descriptionType":"Abstract","description":"In this study, we present an end-to-end pipeline capable of converting drone-captured video streams into high-fidelity 3D reconstructions with minimal latency. Unmanned aerial vehicles (UAVs) are extensively used in aerial real-time perception applications. Moreover, recent advances in 3D Gaussian Splatting (3DGS) have demonstrated significant potential for real-time neural rendering. However, their integration into end-to-end UAV-based reconstruction and visualization systems remains underexplored. Our goal is to propose an efficient architecture that combines live video acquisition via RTMP streaming, synchronized sensor fusion, camera pose estimation, and 3DGS optimization, achieving continuous model updates and low-latency deployment within interactive visualization environments that supports immersive augmented and virtual reality (AR/VR) applications. Experimental results demonstrate that the proposed method achieves competitive visual fidelity, while delivering significantly higher rendering performance and substantially reduced end-to-end latency, compared to NeRF-based approaches. Reconstruction quality remains within 4-7\\% of high-fidelity offline references, confirming the suitability of the proposed system for real-time, scalable augmented perception from aerial platforms."},{"descriptionType":"Other","description":"7 pages, 2 figures"}],"geoLocations":[],"fundingReferences":[],"url":"https://arxiv.org/abs/2602.20342","contentUrl":null,"metadataVersion":0,"schemaVersion":"http://datacite.org/schema/kernel-4","source":"mds","isActive":true,"state":"findable","reason":null,"viewCount":0,"downloadCount":0,"referenceCount":0,"citationCount":0,"partCount":0,"partOfCount":0,"versionCount":0,"versionOfCount":0,"created":"2026-02-25T02:47:48Z","registered":"2026-02-25T02:47:49Z","published":null,"updated":"2026-02-25T02:47:49Z"},"relationships":{"client":{"data":{"id":"arxiv.content","type":"clients"}}}},{"id":"10.48550/arxiv.2602.20341","type":"dois","attributes":{"doi":"10.48550/arxiv.2602.20341","identifiers":[{"identifier":"2602.20341","identifierType":"arXiv"}],"creators":[{"nameType":"Personal","givenName":"Ignacio","familyName":"Amores-Sesar","name":"Amores-Sesar, Ignacio","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Mirza Ahad","familyName":"Baig","name":"Baig, Mirza Ahad","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Seth","familyName":"Gilbert","name":"Gilbert, Seth","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Ray","familyName":"Neiheiser","name":"Neiheiser, Ray","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Michelle X.","familyName":"Yeo","name":"Yeo, Michelle X.","affiliation":[],"nameIdentifiers":[]}],"titles":[{"title":"The Tragedy of Chain Commons"}],"publisher":"arXiv","container":{},"publicationYear":2026,"subjects":[{"subject":"Distributed, Parallel, and Cluster Computing (cs.DC)","lang":"en","subjectScheme":"arXiv"},{"subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"},{"schemeUri":"http://www.oecd.org/science/inno/38235147.pdf","subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"}],"contributors":[],"dates":[{"date":"2026-02-23T20:39:47Z","dateType":"Submitted","dateInformation":"v1"},{"date":"2026-02-25T01:06:34Z","dateType":"Updated","dateInformation":"v1"},{"date":"2026-02","dateType":"Available","dateInformation":"v1"},{"date":"2026","dateType":"Issued"}],"language":null,"types":{"schemaOrg":"CreativeWork","resourceTypeGeneral":"Preprint","citeproc":"article","bibtex":"misc","ris":"GEN","resourceType":"Article"},"relatedIdentifiers":[],"relatedItems":[],"sizes":[],"formats":[],"version":"1","rightsList":[{"rightsIdentifierScheme":"SPDX","rightsUri":"https://creativecommons.org/licenses/by/4.0/legalcode","schemeUri":"https://spdx.org/licenses/","rights":"Creative Commons Attribution 4.0 International","rightsIdentifier":"cc-by-4.0"}],"descriptions":[{"descriptionType":"Abstract","description":"Byzantine Fault Tolerant (BFT) consensus forms the foundation of many modern blockchains striving for both high throughput and low latency. A growing bottleneck is transaction execution and validation on the critical path of consensus, which has led to modular decoupled designs that separate ordering from execution: Consensus orders only metadata, while transactions are executed and validated concurrently. While this approach improves performance, it can leave invalid transactions in the ledger, increasing storage costs and enabling new forms of strategic behavior. We present the first systematic study of this setting, providing a formal framework to reason about the interaction between consensus and execution. Using this framework, we show that the decoupled design enables a previously unidentified attack, which we term gaslighting. We prove a fundamental trade-off between resilience to this attack and resource capacity utilization, where both are impossible to achieve deterministically in the decoupled model. To address this trade-off, we discuss an intermediate model for leader-based protocols that is robust to gaslighting attacks while achieving high throughput and low latency."}],"geoLocations":[],"fundingReferences":[],"url":"https://arxiv.org/abs/2602.20341","contentUrl":null,"metadataVersion":0,"schemaVersion":"http://datacite.org/schema/kernel-4","source":"mds","isActive":true,"state":"findable","reason":null,"viewCount":0,"downloadCount":0,"referenceCount":0,"citationCount":0,"partCount":0,"partOfCount":0,"versionCount":0,"versionOfCount":0,"created":"2026-02-25T02:47:47Z","registered":"2026-02-25T02:47:47Z","published":null,"updated":"2026-02-25T02:47:47Z"},"relationships":{"client":{"data":{"id":"arxiv.content","type":"clients"}}}},{"id":"10.48550/arxiv.2602.20340","type":"dois","attributes":{"doi":"10.48550/arxiv.2602.20340","identifiers":[{"identifier":"2602.20340","identifierType":"arXiv"}],"creators":[{"nameType":"Personal","givenName":"Steven N.","familyName":"Longmore","name":"Longmore, Steven N.","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"John","familyName":"Bally","name":"Bally, John","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Ashley T.","familyName":"Barnes","name":"Barnes, Ashley T.","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Cara","familyName":"Battersby","name":"Battersby, Cara","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Laura","familyName":"Colzi","name":"Colzi, Laura","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Adam","familyName":"Ginsburg","name":"Ginsburg, Adam","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Jonathan D.","familyName":"Henshaw","name":"Henshaw, Jonathan D.","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Paul T. P.","familyName":"Ho","name":"Ho, Paul T. P.","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Izaskun","familyName":"Jiménez-Serra","name":"Jiménez-Serra, Izaskun","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"J. M. Diederik","familyName":"Kruijssen","name":"Kruijssen, J. M. Diederik","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Elisabeth A. C.","familyName":"Mills","name":"Mills, Elisabeth A. C.","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Maya A.","familyName":"Petkova","name":"Petkova, Maya A.","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Mattia C.","familyName":"Sormani","name":"Sormani, Mattia C.","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Robin G.","familyName":"Tress","name":"Tress, Robin G.","affiliation":[],"nameI