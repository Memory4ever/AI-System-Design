{"data":[{"id":"10.48550/arxiv.2602.18752","type":"dois","attributes":{"doi":"10.48550/arxiv.2602.18752","identifiers":[{"identifier":"2602.18752","identifierType":"arXiv"}],"creators":[{"nameType":"Personal","givenName":"Yuran","familyName":"Dong","name":"Dong, Yuran","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Hang","familyName":"Dai","name":"Dai, Hang","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Mang","familyName":"Ye","name":"Ye, Mang","affiliation":[],"nameIdentifiers":[]}],"titles":[{"title":"Optimizing ID Consistency in Multimodal Large Models: Facial Restoration via Alignment, Entanglement, and Disentanglement"}],"publisher":"arXiv","container":{},"publicationYear":2026,"subjects":[{"subject":"Computer Vision and Pattern Recognition (cs.CV)","lang":"en","subjectScheme":"arXiv"},{"subject":"Graphics (cs.GR)","lang":"en","subjectScheme":"arXiv"},{"subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"},{"schemeUri":"http://www.oecd.org/science/inno/38235147.pdf","subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"}],"contributors":[],"dates":[{"date":"2026-02-21T08:24:42Z","dateType":"Submitted","dateInformation":"v1"},{"date":"2026-02-24T01:21:10Z","dateType":"Updated","dateInformation":"v1"},{"date":"2026-02","dateType":"Available","dateInformation":"v1"},{"date":"2026","dateType":"Issued"}],"language":null,"types":{"schemaOrg":"CreativeWork","resourceTypeGeneral":"Preprint","citeproc":"article","bibtex":"misc","ris":"GEN","resourceType":"Article"},"relatedIdentifiers":[],"relatedItems":[],"sizes":[],"formats":[],"version":"1","rightsList":[{"rightsUri":"http://arxiv.org/licenses/nonexclusive-distrib/1.0/","rights":"arXiv.org perpetual, non-exclusive license"}],"descriptions":[{"descriptionType":"Abstract","description":"Multimodal editing large models have demonstrated powerful editing capabilities across diverse tasks. However, a persistent and long-standing limitation is the decline in facial identity (ID) consistency during realistic portrait editing. Due to the human eye's high sensitivity to facial features, such inconsistency significantly hinders the practical deployment of these models. Current facial ID preservation methods struggle to achieve consistent restoration of both facial identity and edited element IP due to Cross-source Distribution Bias and Cross-source Feature Contamination. To address these issues, we propose EditedID, an Alignment-Disentanglement-Entanglement framework for robust identity-specific facial restoration. By systematically analyzing diffusion trajectories, sampler behaviors, and attention properties, we introduce three key components: 1) Adaptive mixing strategy that aligns cross-source latent representations throughout the diffusion process. 2) Hybrid solver that disentangles source-specific identity attributes and details. 3) Attentional gating mechanism that selectively entangles visual elements. Extensive experiments show that EditedID achieves state-of-the-art performance in preserving original facial ID and edited element IP consistency. As a training-free and plug-and-play solution, it establishes a new benchmark for practical and reliable single/multi-person facial identity restoration in open-world settings, paving the way for the deployment of multimodal editing large models in real-person editing scenarios. The code is available at https://github.com/NDYBSNDY/EditedID."},{"descriptionType":"Other","description":"ICLR 26"}],"geoLocations":[],"fundingReferences":[],"url":"https://arxiv.org/abs/2602.18752","contentUrl":null,"metadataVersion":0,"schemaVersion":"http://datacite.org/schema/kernel-4","source":"mds","isActive":true,"state":"findable","reason":null,"viewCount":0,"downloadCount":0,"referenceCount":0,"citationCount":0,"partCount":0,"partOfCount":0,"versionCount":0,"versionOfCount":0,"created":"2026-02-25T14:32:12Z","registered":"2026-02-25T14:32:12Z","published":null,"updated":"2026-02-25T14:32:12Z"},"relationships":{"client":{"data":{"id":"arxiv.content","type":"clients"}}}},{"id":"10.48550/arxiv.2602.18751","type":"dois","attributes":{"doi":"10.48550/arxiv.2602.18751","identifiers":[{"identifier":"2602.18751","identifierType":"arXiv"}],"creators":[{"nameType":"Personal","givenName":"Kaichen","familyName":"Jiang","name":"Jiang, Kaichen","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Yuyue","familyName":"Yan","name":"Yan, Yuyue","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Mingda","familyName":"Yue","name":"Yue, Mingda","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Yuhu","familyName":"Wu","name":"Wu, Yuhu","affiliation":[],"nameIdentifiers":[]}],"titles":[{"title":"Seeking Nash Equilibrium in Non-cooperative Quadratic Games Under Delayed Information Exchange"}],"publisher":"arXiv","container":{},"publicationYear":2026,"subjects":[{"subject":"Systems and Control (eess.SY)","lang":"en","subjectScheme":"arXiv"},{"subject":"FOS: Electrical engineering, electronic engineering, information engineering","subjectScheme":"Fields of Science and Technology (FOS)"},{"schemeUri":"http://www.oecd.org/science/inno/38235147.pdf","subject":"FOS: Electrical engineering, electronic engineering, information engineering","subjectScheme":"Fields of Science and Technology (FOS)"}],"contributors":[],"dates":[{"date":"2026-02-21T08:23:27Z","dateType":"Submitted","dateInformation":"v1"},{"date":"2026-02-24T01:21:07Z","dateType":"Updated","dateInformation":"v1"},{"date":"2026-02","dateType":"Available","dateInformation":"v1"},{"date":"2026","dateType":"Issued"}],"language":null,"types":{"schemaOrg":"CreativeWork","resourceTypeGeneral":"Preprint","citeproc":"article","bibtex":"misc","ris":"GEN","resourceType":"Article"},"relatedIdentifiers":[],"relatedItems":[],"sizes":[],"formats":[],"version":"1","rightsList":[{"rightsUri":"http://arxiv.org/licenses/nonexclusive-distrib/1.0/","rights":"arXiv.org perpetual, non-exclusive license"}],"descriptions":[{"descriptionType":"Abstract","description":"In this paper, we investigate the seeking of Nash equilibrium (NE) in a non-cooperative quadratic game where all agents exchange their delayed strategy information with their neighbors. To extend best-response algorithms to the delayed information setting, an estimation mechanism for each agent to estimate the current strategy profile is designed. Based on the best-response strategy to the estimations, the strategy profile dynamics of all agents is established, which is revealed to converge asymptotically to the NE when agents exchange multi-step-delay information via the Lyapunov-Krasovskii functional approach. In the scenario where agents exchange one-step-delay information, the exponential convergence of the strategy profile dynamics to the NE can be guaranteed by restricting the learning rate to less than an upper bound. Moreover, a lower bound on the learning rate for instability of the NE is proposed. Numerical simulations are provided for verifying the developed results."}],"geoLocations":[],"fundingReferences":[],"url":"https://arxiv.org/abs/2602.18751","contentUrl":null,"metadataVersion":0,"schemaVersion":"http://datacite.org/schema/kernel-4","source":"mds","isActive":true,"state":"findable","reason":null,"viewCount":0,"downloadCount":0,"referenceCount":0,"citationCount":0,"partCount":0,"partOfCount":0,"versionCount":0,"versionOfCount":0,"created":"2026-02-25T14:32:09Z","registered":"2026-02-25T14:32:10Z","published":null,"updated":"2026-02-25T14:32:10Z"},"relationships":{"client":{"data":{"id":"arxiv.content","type":"clients"}}}},{"id":"10.48550/arxiv.2602.20901","type":"dois","attributes":{"doi":"10.48550/arxiv.2602.20901","identifiers":[{"identifier":"2602.20901","identifierType":"arXiv"}],"creators":[{"nameType":"Personal","givenName":"Yuechen","familyName":"Xie","name":"Xie, Yuechen","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Xiaoyan","familyName":"Zhang","name":"Zhang, Xiaoyan","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Yicheng","familyName":"Shan","name":"Shan, Yicheng","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Hao","familyName":"Zhu","name":"Zhu, Hao","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Rui","familyName":"Tang","name":"Tang, Rui","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Rong","familyName":"Wei","name":"Wei, Rong","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Mingli","familyName":"Song","name":"Song, Mingli","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Yuanyu","familyName":"Wan","name":"Wan, Yuanyu","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Jie","familyName":"Song","name":"Song, Jie","affiliation":[],"nameIdentifiers":[]}],"titles":[{"title":"SpatiaLQA: A Benchmark for Evaluating Spatial Logical Reasoning in Vision-Language Models"}],"publisher":"arXiv","container":{},"publicationYear":2026,"subjects":[{"subject":"Computer Vision and Pattern Recognition (cs.CV)","lang":"en","subjectScheme":"arXiv"},{"subject":"Machine Learning (cs.LG)","lang":"en","subjectScheme":"arXiv"},{"subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"},{"schemeUri":"http://www.oecd.org/science/inno/38235147.pdf","subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"}],"contributors":[],"dates":[{"date":"2026-02-24T13:38:37Z","dateType":"Submitted","dateInformation":"v1"},{"date":"2026-02-25T01:48:28Z","dateType":"Updated","dateInformation":"v1"},{"date":"2026-02","dateType":"Available","dateInformation":"v1"},{"date":"2026","dateType":"Issued"}],"language":null,"types":{"schemaOrg":"CreativeWork","resourceTypeGeneral":"Preprint","citeproc":"article","bibtex":"misc","ris":"GEN","resourceType":"Article"},"relatedIdentifiers":[],"relatedItems":[],"sizes":[],"formats":[],"version":"1","rightsList":[{"rightsIdentifierScheme":"SPDX","rightsUri":"https://creativecommons.org/licenses/by/4.0/legalcode","schemeUri":"https://spdx.org/licenses/","rights":"Creative Commons Attribution 4.0 International","rightsIdentifier":"cc-by-4.0"}],"descriptions":[{"descriptionType":"Abstract","description":"Vision-Language Models (VLMs) have been increasingly applied in real-world scenarios due to their outstanding understanding and reasoning capabilities. Although VLMs have already demonstrated impressive capabilities in common visual question answering and logical reasoning, they still lack the ability to make reasonable decisions in complex real-world environments. We define this ability as spatial logical reasoning, which not only requires understanding the spatial relationships among objects in complex scenes, but also the logical dependencies between steps in multi-step tasks. To bridge this gap, we introduce Spatial Logical Question Answering (SpatiaLQA), a benchmark designed to evaluate the spatial logical reasoning capabilities of VLMs. SpatiaLQA consists of 9,605 question answer pairs derived from 241 real-world indoor scenes. We conduct extensive experiments on 41 mainstream VLMs, and the results show that even the most advanced models still struggle with spatial logical reasoning. To address this issue, we propose a method called recursive scene graph assisted reasoning, which leverages visual foundation models to progressively decompose complex scenes into task-relevant scene graphs, thereby enhancing the spatial logical reasoning ability of VLMs, outperforming all previous methods. Code and dataset are available at https://github.com/xieyc99/SpatiaLQA."},{"descriptionType":"Other","description":"Accepted by CVPR 2026"}],"geoLocations":[],"fundingReferences":[],"url":"https://arxiv.org/abs/2602.20901","contentUrl":null,"metadataVersion":0,"schemaVersion":"http://datacite.org/schema/kernel-4","source":"mds","isActive":true,"state":"findable","reason":null,"viewCount":0,"downloadCount":0,"referenceCount":0,"citationCount":0,"partCount":0,"partOfCount":0,"versionCount":0,"versionOfCount":0,"created":"2026-02-25T03:01:18Z","registered":"2026-02-25T03:01:19Z","published":null,"updated":"2026-02-25T03:01:19Z"},"relationships":{"client":{"data":{"id":"arxiv.content","type":"clients"}}}},{"id":"10.48550/arxiv.2602.20900","type":"dois","attributes":{"doi":"10.48550/arxiv.2602.20900","identifiers":[{"identifier":"2602.20900","identifierType":"arXiv"}],"creators":[{"nameType":"Personal","givenName":"Twan","familyName":"Kroll","name":"Kroll, Twan","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Jonas","familyName":"Helsen","name":"Helsen, Jonas","affiliation":[],"nameIdentifiers":[]}],"titles":[{"title":"Error correction with brickwork Clifford circuits"}],"publisher":"arXiv","container":{},"publicationYear":2026,"subjects":[{"subject":"Quantum Physics (quant-ph)","lang":"en","subjectScheme":"arXiv"},{"subject":"FOS: Physical sciences","subjectScheme":"Fields of Science and Technology (FOS)"},{"schemeUri":"http://www.oecd.org/science/inno/38235147.pdf","subject":"FOS: Physical sciences","subjectScheme":"Fields of Science and Technology (FOS)"}],"contributors":[],"dates":[{"date":"2026-02-24T13:35:33Z","dateType":"Submitted","dateInformation":"v1"},{"date":"2026-02-25T01:48:23Z","dateType":"Updated","dateInformation":"v1"},{"date":"2026-02","dateType":"Available","dateInformation":"v1"},{"date":"2026","dateType":"Issued"}],"language":null,"types":{"schemaOrg":"CreativeWork","resourceTypeGeneral":"Preprint","citeproc":"article","bibtex":"misc","ris":"GEN","resourceType":"Article"},"relatedIdentifiers":[],"relatedItems":[],"sizes":[],"formats":[],"version":"1","rightsList":[{"rightsUri":"http://arxiv.org/licenses/nonexclusive-distrib/1.0/","rights":"arXiv.org perpetual, non-exclusive license"}],"descriptions":[{"descriptionType":"Abstract","description":"We prove that random 1D Clifford brickwork circuits form (in expectation) good approximate quantum error correction codes in logarithmic depth. Our proof makes use of the statistical mechanics techniques for random circuits developed by Dalzell et al. [PRX Quantum 3, 010333], adapted extensively to our own purpose. We also consider exact error correction, where we give matching upper and lower bounds for the required depth in which random 1D Clifford brickwork circuits become error correcting."},{"descriptionType":"Other","description":"24 pages, see also the related work of Liu et al. (specifically the journal version [PRX Quantum 7, 010331 (2026)])"}],"geoLocations":[],"fundingReferences":[],"url":"https://arxiv.org/abs/2602.20900","contentUrl":null,"metadataVersion":0,"schemaVersion":"http://datacite.org/schema/kernel-4","source":"mds","isActive":true,"state":"findable","reason":null,"viewCount":0,"downloadCount":0,"referenceCount":0,"citationCount":0,"partCount":0,"partOfCount":0,"versionCount":0,"versionOfCount":0,"created":"2026-02-25T03:01:16Z","registered":"2026-02-25T03:01:17Z","published":null,"updated":"2026-02-25T03:01:17Z"},"relationships":{"client":{"data":{"id":"arxiv.content","type":"clients"}}}},{"id":"10.48550/arxiv.2602.20898","type":"dois","attributes":{"doi":"10.48550/arxiv.2602.20898","identifiers":[{"identifier":"2602.20898","identifierType":"arXiv"}],"creators":[{"nameType":"Personal","givenName":"Taishu","familyName":"Kayanoki","name":"Kayanoki, Taishu","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Yasushi","familyName":"Fukazawa","name":"Fukazawa, Yasushi","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Junjie","familyName":"Mao","name":"Mao, Junjie","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Jon M.","familyName":"Miller","name":"Miller, Jon M.","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Luigi","familyName":"Gallo","name":"Gallo, Luigi","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Tahir","familyName":"Yaqoob","name":"Yaqoob, Tahir","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Richard","familyName":"Mushotzky","name":"Mushotzky, Richard","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"David","familyName":"Bogensberger","name":"Bogensberger, David","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Misaki","familyName":"Mizumoto","name":"Mizumoto, Misaki","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Kouichi","familyName":"Hagino","name":"Hagino, Kouichi","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Hirofumi","familyName":"Noda","name":"Noda, Hirofumi","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Yoshihiro","familyName":"Ueda","name":"Ueda, Yoshihiro","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Makoto","familyName":"Tashiro","name":"Tashiro, Makoto","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Yuya","familyName":"Nakatani","name":"Nakatani, Yuya","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Toshiya","familyName":"Iwata","name":"Iwata, Toshiya","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Misaki","familyName":"Urata","name":"Urata, Misaki","affiliation":[],"nameIdentifiers":[]}],"titles":[{"title":"XRISM Discovery of Multiple Ionized Fe-K Emission and Absorption Components in Centaurus A"}],"publisher":"arXiv","container":{},"publicationYear":2026,"subjects":[{"subject":"High Energy Astrophysical Phenomena (astro-ph.HE)","lang":"en","subjectScheme":"arXiv"},{"subject":"Astrophysics of Galaxies (astro-ph.GA)","lang":"en","subjectScheme":"arXiv"},{"subject":"FOS: Physical sciences","subjectScheme":"Fields of Science and Technology (FOS)"},{"schemeUri":"http://www.oecd.org/science/inno/38235147.pdf","subject":"FOS: Physical sciences","subjectScheme":"Fields of Science and Technology (FOS)"}],"contributors":[],"dates":[{"date":"2026-02-24T13:33:13Z","dateType":"Submitted","dateInformation":"v1"},{"date":"2026-02-25T01:48:20Z","dateType":"Updated","dateInformation":"v1"},{"date":"2026-02","dateType":"Available","dateInformation":"v1"},{"date":"2026","dateType":"Issued"}],"language":null,"types":{"schemaOrg":"CreativeWork","resourceTypeGeneral":"Preprint","citeproc":"article","bibtex":"misc","ris":"GEN","resourceType":"Article"},"relatedIdentifiers":[],"relatedItems":[],"sizes":[],"formats":[],"version":"1","rightsList":[{"rightsUri":"http://arxiv.org/licenses/nonexclusive-distrib/1.0/","rights":"arXiv.org perpetual, non-exclusive license"}],"descriptions":[{"descriptionType":"Abstract","description":"We present the first clear detection of ionized Fe-K emission and absorption components in the nearby radio galaxy Centaurus A, revealed by the high-resolution XRISM/Resolve detector. In the 6.5-6.9 keV band, XRISM reveals multiple Fe XXV and Fe XXVI emission components. One is a broad (with a width of sigma = 3000 km/s) and redshifted (+3400 km/s) component, originating at D = 0.02 pc from the central black hole. The other two components are narrow (with a width of sigma = 500 km/s) and exhibit redshifted and blueshifted velocities (+2600 km/s and -1500 km/s), originating from more distant regions (D = 0.1 pc). The photo-ionized model explains the broader component, while the two narrower components can be explained by either photo-ionization or collisional ionization. One interpretation is that the broader component is an outflow at ~10^2 R_S (R_S; Schwarzschild radius) and the narrow component is a shock-heated plasma close to the torus, with a possible connection to the JWST-discovered outflow outside the torus. Two blueshifted absorption lines are detected at ~7.1 keV (~10^4 km/s) and ~10.6 keV (~10^5 km/s). The line significance of the 10.6 keV line is above 98%. The absorption line components might be attributed to the broad emission component. These results demonstrate the high potential of XRISM/Resolve to characterize ionized emission and absorption features in the Fe-K band. Our findings establish a new benchmark in the study of circumnuclear environments in low-luminosity radio galaxies, thereby contributing to a broader understanding of AGN unification."},{"descriptionType":"Other","description":"25 pages, 14 figures, ApJ accepted (2026)"}],"geoLocations":[],"fundingReferences":[],"url":"https://arxiv.org/abs/2602.20898","contentUrl":null,"metadataVersion":0,"schemaVersion":"http://datacite.org/schema/kernel-4","source":"mds","isActive":true,"state":"findable","reason":null,"viewCount":0,"downloadCount":0,"referenceCount":0,"citationCount":0,"partCount":0,"partOfCount":0,"versionCount":0,"versionOfCount":0,"created":"2026-02-25T03:01:13Z","registered":"2026-02-25T03:01:14Z","published":null,"updated":"2026-02-25T03:01:14Z"},"relationships":{"client":{"data":{"id":"arxiv.content","type":"clients"}}}},{"id":"10.48550/arxiv.2602.20897","type":"dois","attributes":{"doi":"10.48550/arxiv.2602.20897","identifiers":[{"identifier":"2602.20897","identifierType":"arXiv"}],"creators":[{"nameType":"Personal","givenName":"Samuel","familyName":"Martin-Gutierrez","name":"Martin-Gutierrez, Samuel","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Juan C.","familyName":"Losada","name":"Losada, Juan C.","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Rosa M.","familyName":"Benito","name":"Benito, Rosa M.","affiliation":[],"nameIdentifiers":[]}],"titles":[{"title":"Impact of individual actions on the collective response of social systems"}],"publisher":"arXiv","container":{},"publicationYear":2026,"subjects":[{"subject":"Physics and Society (physics.soc-ph)","lang":"en","subjectScheme":"arXiv"},{"subject":"FOS: Physical sciences","subjectScheme":"Fields of Science and Technology (FOS)"},{"schemeUri":"http://www.oecd.org/science/inno/38235147.pdf","subject":"FOS: Physical sciences","subjectScheme":"Fields of Science and Technology (FOS)"}],"contributors":[],"dates":[{"date":"2026-02-24T13:31:35Z","dateType":"Submitted","dateInformation":"v1"},{"date":"2026-02-25T01:48:11Z","dateType":"Updated","dateInformation":"v1"},{"date":"2026-02","dateType":"Available","dateInformation":"v1"},{"date":"2026","dateType":"Issued"}],"language":null,"types":{"schemaOrg":"CreativeWork","resourceTypeGeneral":"Preprint","citeproc":"article","bibtex":"misc","ris":"GEN","resourceType":"Article"},"relatedIdentifiers":[{"relationType":"IsVersionOf","relatedIdentifier":"10.1038/s41598-020-69005-y","relatedIdentifierType":"DOI"}],"relatedItems":[],"sizes":[],"formats":[],"version":"1","rightsList":[{"rightsIdentifierScheme":"SPDX","rightsUri":"https://creativecommons.org/licenses/by/4.0/legalcode","schemeUri":"https://spdx.org/licenses/","rights":"Creative Commons Attribution 4.0 International","rightsIdentifier":"cc-by-4.0"}],"descriptions":[{"descriptionType":"Abstract","description":"In a social system individual actions have the potential to trigger spontaneous collective reactions. The way and extent to which the activity (number of actions$-A$) of an individual causes or is connected to the response (number of reactions$-R$) of the system is still an open question. We measure the relationship between activity and response with the distribution of efficiency, a metric defined as $η=R/A$. Generalizing previous results, we show that the efficiency distribution presents a universal structure in three systems of different nature: Twitter, Wikipedia and the scientific citations network. To understand this phenomenon, we develop a theoretical framework composed of three minimal statistical models that contemplate different levels of dependence between $A$ and $R$. The models not only are able to reproduce the empirical activity-response data but also can serve as baselines or null models for more elaborated and domain-specific approaches."}],"geoLocations":[],"fundingReferences":[],"url":"https://arxiv.org/abs/2602.20897","contentUrl":null,"metadataVersion":0,"schemaVersion":"http://datacite.org/schema/kernel-4","source":"mds","isActive":true,"state":"findable","reason":null,"viewCount":0,"downloadCount":0,"referenceCount":0,"citationCount":0,"partCount":0,"partOfCount":0,"versionCount":0,"versionOfCount":1,"created":"2026-02-25T03:01:12Z","registered":"2026-02-25T03:01:12Z","published":null,"updated":"2026-02-25T03:01:12Z"},"relationships":{"client":{"data":{"id":"arxiv.content","type":"clients"}}}},{"id":"10.48550/arxiv.2602.20894","type":"dois","attributes":{"doi":"10.48550/arxiv.2602.20894","identifiers":[{"identifier":"2602.20894","identifierType":"arXiv"}],"creators":[{"nameType":"Personal","givenName":"K.","familyName":"Castillo","name":"Castillo, K.","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"G.","familyName":"Gordillo-Núñez","name":"Gordillo-Núñez, G.","affiliation":[],"nameIdentifiers":[]}],"titles":[{"title":"Wendroff's theorem beyond consecutive degrees and related inverse spectral problems"}],"publisher":"arXiv","container":{},"publicationYear":2026,"subjects":[{"subject":"Classical Analysis and ODEs (math.CA)","lang":"en","subjectScheme":"arXiv"},{"subject":"FOS: Mathematics","subjectScheme":"Fields of Science and Technology (FOS)"},{"schemeUri":"http://www.oecd.org/science/inno/38235147.pdf","subject":"FOS: Mathematics","subjectScheme":"Fields of Science and Technology (FOS)"},{"subject":"42C05, 47B36, 65D32, 15A18","lang":"en","subjectScheme":"MSC"}],"contributors":[],"dates":[{"date":"2026-02-24T13:29:47Z","dateType":"Submitted","dateInformation":"v1"},{"date":"2026-02-25T01:48:01Z","dateType":"Updated","dateInformation":"v1"},{"date":"2026-02","dateType":"Available","dateInformation":"v1"},{"date":"2026","dateType":"Issued"}],"language":null,"types":{"schemaOrg":"CreativeWork","resourceTypeGeneral":"Preprint","citeproc":"article","bibtex":"misc","ris":"GEN","resourceType":"Article"},"relatedIdentifiers":[],"relatedItems":[],"sizes":[],"formats":[],"version":"1","rightsList":[{"rightsUri":"http://arxiv.org/licenses/nonexclusive-distrib/1.0/","rights":"arXiv.org perpetual, non-exclusive license"}],"descriptions":[{"descriptionType":"Abstract","description":"A classical theorem of Wendroff shows that one may reconstructs a sequence of orthogonal polynomials on the real line from two non-constant polynomials of consecutive degrees whose zeros strictly interlace on the real line. In this note we extend this result to arbitrary non-constant polynomials. The reconstruction may be formulated via a Vandermonde-type linear system and recast as an underdetermined inverse spectral problem, in which the spectra of a finite Jacobi matrix and of one of its leading principal submatrices are prescribed. In addition, the analogous result on the unit circle is established by reconstructing a sequence of paraorthogonal polynomials from two arbitrary non-constant polynomials whose zeros strictly interlace on the unit circle. In this setting, the Jacobi matrix is replaced by a finite unitary pentadiagonal matrix, and the spectral data consist of the spectrum of the full matrix together with that of a rank-one perturbation of a leading principal submatrix. Strict interlacing of zeros is shown to be a necessary and sufficient condition for solvability, and explicit constructions of the associated polynomial families and matrices are provided. Finally, an algorithm and several illustrative examples are presented."}],"geoLocations":[],"fundingReferences":[],"url":"https://arxiv.org/abs/2602.20894","contentUrl":null,"metadataVersion":0,"schemaVersion":"http://datacite.org/schema/kernel-4","source":"mds","isActive":true,"state":"findable","reason":null,"viewCount":0,"downloadCount":0,"referenceCount":0,"citationCount":0,"partCount":0,"partOfCount":0,"versionCount":0,"versionOfCount":0,"created":"2026-02-25T03:01:08Z","registered":"2026-02-25T03:01:08Z","published":null,"updated":"2026-02-25T03:01:08Z"},"relationships":{"client":{"data":{"id":"arxiv.content","type":"clients"}}}},{"id":"10.48550/arxiv.2602.20892","type":"dois","attributes":{"doi":"10.48550/arxiv.2602.20892","identifiers":[{"identifier":"2602.20892","identifierType":"arXiv"}],"creators":[{"nameType":"Personal","givenName":"Seyed Himan","familyName":"Ghaderi","name":"Ghaderi, Seyed Himan","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Saeed Sarbazi","familyName":"Azad","name":"Azad, Saeed Sarbazi","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Mohammad Mehdi","familyName":"Jaziriyan","name":"Jaziriyan, Mohammad Mehdi","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Ahmad","familyName":"Akbari","name":"Akbari, Ahmad","affiliation":[],"nameIdentifiers":[]}],"titles":[{"title":"Exa-PSD: a new Persian sentiment analysis dataset on Twitter"}],"publisher":"arXiv","container":{},"publicationYear":2026,"subjects":[{"subject":"Computation and Language (cs.CL)","lang":"en","subjectScheme":"arXiv"},{"subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"},{"schemeUri":"http://www.oecd.org/science/inno/38235147.pdf","subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"}],"contributors":[],"dates":[{"date":"2026-02-24T13:28:23Z","dateType":"Submitted","dateInformation":"v1"},{"date":"2026-02-25T01:47:57Z","dateType":"Updated","dateInformation":"v1"},{"date":"2026-02","dateType":"Available","dateInformation":"v1"},{"date":"2026","dateType":"Issued"}],"language":null,"types":{"schemaOrg":"CreativeWork","resourceTypeGeneral":"Preprint","citeproc":"article","bibtex":"misc","ris":"GEN","resourceType":"Article"},"relatedIdentifiers":[{"relationType":"IsVersionOf","relatedIdentifier":"10.1007/s10579-025-09886-5","relatedIdentifierType":"DOI"}],"relatedItems":[],"sizes":[],"formats":[],"version":"1","rightsList":[{"rightsUri":"http://arxiv.org/licenses/nonexclusive-distrib/1.0/","rights":"arXiv.org perpetual, non-exclusive license"}],"descriptions":[{"descriptionType":"Abstract","description":"Today, Social networks such as Twitter are the most widely used platforms for communication of people. Analyzing this data has useful information to recognize the opinion of people in tweets. Sentiment analysis plays a vital role in NLP, which identifies the opinion of the individuals about a specific topic. Natural language processing in Persian has many challenges despite the adventure of strong language models. The datasets available in Persian are generally in special topics such as products, foods, hotels, etc while users may use ironies, colloquial phrases in social media To overcome these challenges, there is a necessity for having a dataset of Persian sentiment analysis on Twitter. In this paper, we introduce the Exa sentiment analysis Persian dataset, which is collected from Persian tweets. This dataset contains 12,000 tweets, annotated by 5 native Persian taggers. The aforementioned data is labeled in 3 classes: positive, neutral and negative. We present the characteristics and statistics of this dataset and use the pre-trained Pars Bert and Roberta as the base model to evaluate this dataset. Our evaluation reached a 79.87 Macro F-score, which shows the model and data can be adequately valuable for a sentiment analysis system."},{"descriptionType":"Other","description":"This is the original submitted (preprint) version of a paper published in Language Resources and Evaluation. The final published version is available at Springer via DOI: https://doi.org/10.1007/s10579-025-09886-5"}],"geoLocations":[],"fundingReferences":[],"url":"https://arxiv.org/abs/2602.20892","contentUrl":null,"metadataVersion":0,"schemaVersion":"http://datacite.org/schema/kernel-4","source":"mds","isActive":true,"state":"findable","reason":null,"viewCount":0,"downloadCount":0,"referenceCount":0,"citationCount":0,"partCount":0,"partOfCount":0,"versionCount":0,"versionOfCount":1,"created":"2026-02-25T03:01:05Z","registered":"2026-02-25T03:01:05Z","published":null,"updated":"2026-02-25T03:01:05Z"},"relationships":{"client":{"data":{"id":"arxiv.content","type":"clients"}}}},{"id":"10.48550/arxiv.2602.20891","type":"dois","attributes":{"doi":"10.48550/arxiv.2602.20891","identifiers":[{"identifier":"2602.20891","identifierType":"arXiv"}],"creators":[{"nameType":"Personal","givenName":"Zhengtao","familyName":"Xu","name":"Xu, Zhengtao","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Zimo","familyName":"Xia","name":"Xia, Zimo","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Zicheng","familyName":"Zhu","name":"Zhu, Zicheng","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Nattapat","familyName":"Boonprakong","name":"Boonprakong, Nattapat","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Yu-An","familyName":"Chen","name":"Chen, Yu-An","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Rabih","familyName":"Zbib","name":"Zbib, Rabih","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Casimiro Pio","familyName":"Carrino","name":"Carrino, Casimiro Pio","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Yi-Chieh","familyName":"Lee","name":"Lee, Yi-Chieh","affiliation":[],"nameIdentifiers":[]}],"titles":[{"title":"InterPilot: Exploring the Design Space of AI-assisted Job Interview Support for HR Professionals"}],"publisher":"arXiv","container":{},"publicationYear":2026,"subjects":[{"subject":"Human-Computer Interaction (cs.HC)","lang":"en","subjectScheme":"arXiv"},{"subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"},{"schemeUri":"http://www.oecd.org/science/inno/38235147.pdf","subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"}],"contributors":[],"dates":[{"date":"2026-02-24T13:28:10Z","dateType":"Submitted","dateInformation":"v1"},{"date":"2026-02-25T01:47:56Z","dateType":"Updated","dateInformation":"v1"},{"date":"2026-02","dateType":"Available","dateInformation":"v1"},{"date":"2026","dateType":"Issued"}],"language":null,"types":{"schemaOrg":"CreativeWork","resourceTypeGeneral":"Preprint","citeproc":"article","bibtex":"misc","ris":"GEN","resourceType":"Article"},"relatedIdentifiers":[],"relatedItems":[],"sizes":[],"formats":[],"version":"1","rightsList":[{"rightsIdentifierScheme":"SPDX","rightsUri":"https://creativecommons.org/licenses/by-nc-nd/4.0/legalcode","schemeUri":"https://spdx.org/licenses/","rights":"Creative Commons Attribution Non Commercial No Derivatives 4.0 International","rightsIdentifier":"cc-by-nc-nd-4.0"}],"descriptions":[{"descriptionType":"Abstract","description":"Recruitment interviews are cognitively demanding interactions in which interviewers must simultaneously listen, evaluate candidates, take notes, and formulate follow-up questions. To better understand these challenges, we conducted a formative study with eight HR professionals, from which we derived key design goals for real-time AI support. Guided by these insights, we developed InterPilot, a prototype system that augments interviews through intelligent note-taking and post-interview summary, adaptive question generation, and real-time skill-evidence mapping. We evaluated the system with another seven HR professionals in mock interviews using a within-subjects design. Results show that InterPilot reduced documentation burden without increasing overall workload, but introduced usability trade-offs related to visual attention and interaction complexity. Qualitative findings further reveal tensions around trust and verification when AI suggests highly specific technical questions. We discuss implications for designing future real-time human-AI collaboration in professional settings, highlighting the need to balance assistance granularity, attentional demands, and human agency."},{"descriptionType":"Other","description":"7 pages, 2 figures"}],"geoLocations":[],"fundingReferences":[],"url":"https://arxiv.org/abs/2602.20891","contentUrl":null,"metadataVersion":0,"schemaVersion":"http://datacite.org/schema/kernel-4","source":"mds","isActive":true,"state":"findable","reason":null,"viewCount":0,"downloadCount":0,"referenceCount":0,"citationCount":0,"partCount":0,"partOfCount":0,"versionCount":0,"versionOfCount":0,"created":"2026-02-25T03:01:03Z","registered":"2026-02-25T03:01:04Z","published":null,"updated":"2026-02-25T03:01:04Z"},"relationships":{"client":{"data":{"id":"arxiv.content","type":"clients"}}}},{"id":"10.48550/arxiv.2602.20890","type":"dois","attributes":{"doi":"10.48550/arxiv.2602.20890","identifiers":[{"identifier":"2602.20890","identifierType":"arXiv"}],"creators":[{"nameType":"Personal","givenName":"Stefan","familyName":"Glock","name":"Glock, Stefan","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Olaf","familyName":"Parczyk","name":"Parczyk, Olaf","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Silas","familyName":"Rathke","name":"Rathke, Silas","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Tibor","familyName":"Szabó","name":"Szabó, Tibor","affiliation":[],"nameIdentifiers":[]}],"titles":[{"title":"The maximum diameter of $d$-dimensional simplicial complexes"}],"publisher":"arXiv","container":{},"publicationYear":2026,"subjects":[{"subject":"Combinatorics (math.CO)","lang":"en","subjectScheme":"arXiv"},{"subject":"FOS: Mathematics","subjectScheme":"Fields of Science and Technology (FOS)"},{"schemeUri":"http://www.oecd.org/science/inno/38235147.pdf","subject":"FOS: Mathematics","subjectScheme":"Fields of Science and Technology (FOS)"}],"contributors":[],"dates":[{"date":"2026-02-24T13:27:45Z","dateType":"Submitted","dateInformation":"v1"},{"date":"2026-02-25T01:47:55Z","dateType":"Updated","dateInformation":"v1"},{"date":"2026-02","dateType":"Available","dateInformation":"v1"},{"date":"2026","dateType":"Issued"}],"language":null,"types":{"schemaOrg":"CreativeWork","resourceTypeGeneral":"Preprint","citeproc":"article","bibtex":"misc","ris":"GEN","resourceType":"Article"},"relatedIdentifiers":[],"relatedItems":[],"sizes":[],"formats":[],"version":"1","rightsList":[{"rightsIdentifierScheme":"SPDX","rightsUri":"https://creativecommons.org/licenses/by/4.0/legalcode","schemeUri":"https://spdx.org/licenses/","rights":"Creative Commons Attribution 4.0 International","rightsIdentifier":"cc-by-4.0"}],"descriptions":[{"descriptionType":"Abstract","description":"For every fixed dimension $d$ and sufficiently large $n$, we determine the maximum possible diameter of a strongly connected $d$-dimensional simplicial complex on $n$ vertices. This improves on a sequence of previous results and settles a problem of Santos from 2013. On the way, as a special case, we also characterise the existence of an extra-tight Euler tour in the complete $d$-uniform hypergraph on $n$ vertices."},{"descriptionType":"Other","description":"46 pages"}],"geoLocations":[],"fundingReferences":[],"url":"https://arxiv.org/abs/2602.20890","contentUrl":null,"metadataVersion":0,"schemaVersion":"http://datacite.org/schema/kernel-4","source":"mds","isActive":true,"state":"findable","reason":null,"viewCount":0,"downloadCount":0,"referenceCount":0,"citationCount":0,"partCount":0,"partOfCount":0,"versionCount":0,"versionOfCount":0,"created":"2026-02-25T03:01:02Z","registered":"2026-02-25T03:01:03Z","published":null,"updated":"2026-02-25T03:01:03Z"},"relationships":{"client":{"data":{"id":"arxiv.content","type":"clients"}}}},{"id":"10.48550/arxiv.2602.20888","type":"dois","attributes":{"doi":"10.48550/arxiv.2602.20888","identifiers":[{"identifier":"2602.20888","identifierType":"arXiv"}],"creators":[{"nameType":"Personal","givenName":"Peter","familyName":"Semrl","name":"Semrl, Peter","affiliation":[],"nameIdentifiers":[]}],"titles":[{"title":"Order automorphisms of effect algebras"}],"publisher":"arXiv","container":{},"publicationYear":2026,"subjects":[{"subject":"Functional Analysis (math.FA)","lang":"en","subjectScheme":"arXiv"},{"subject":"FOS: Mathematics","subjectScheme":"Fields of Science and Technology (FOS)"},{"schemeUri":"http://www.oecd.org/science/inno/38235147.pdf","subject":"FOS: Mathematics","subjectScheme":"Fields of Science and Technology (FOS)"},{"subject":"15B57, 47B49, 81R15","lang":"en","subjectScheme":"MSC"}],"contributors":[],"dates":[{"date":"2026-02-24T13:25:09Z","dateType":"Submitted","dateInformation":"v1"},{"date":"2026-02-25T01:47:52Z","dateType":"Updated","dateInformation":"v1"},{"date":"2026-02","dateType":"Available","dateInformation":"v1"},{"date":"2026","dateType":"Issued"}],"language":null,"types":{"schemaOrg":"CreativeWork","resourceTypeGeneral":"Preprint","citeproc":"article","bibtex":"misc","ris":"GEN","resourceType":"Article"},"relatedIdentifiers":[],"relatedItems":[],"sizes":[],"formats":[],"version":"1","rightsList":[{"rightsIdentifierScheme":"SPDX","rightsUri":"https://creativecommons.org/licenses/by/4.0/legalcode","schemeUri":"https://spdx.org/licenses/","rights":"Creative Commons Attribution 4.0 International","rightsIdentifier":"cc-by-4.0"}],"descriptions":[{"descriptionType":"Abstract","description":"An elegant description of the general form of order automorphisms of effect algebras has been known in the complex case. We present a much simpler proof based on the projective geometry which works also in the real case. As an application we classify order isomorphic pairs of matrix intervals and describe the general form of order isomorphisms for any pair of isomorphic matrix intervals."}],"geoLocations":[],"fundingReferences":[],"url":"https://arxiv.org/abs/2602.20888","contentUrl":null,"metadataVersion":0,"schemaVersion":"http://datacite.org/schema/kernel-4","source":"mds","isActive":true,"state":"findable","reason":null,"viewCount":0,"downloadCount":0,"referenceCount":0,"citationCount":0,"partCount":0,"partOfCount":0,"versionCount":0,"versionOfCount":0,"created":"2026-02-25T03:00:59Z","registered":"2026-02-25T03:01:00Z","published":null,"updated":"2026-02-25T03:01:00Z"},"relationships":{"client":{"data":{"id":"arxiv.content","type":"clients"}}}},{"id":"10.48550/arxiv.2602.20886","type":"dois","attributes":{"doi":"10.48550/arxiv.2602.20886","identifiers":[{"identifier":"2602.20886","identifierType":"arXiv"}],"creators":[{"nameType":"Personal","givenName":"Tanmoy","familyName":"Ghosh","name":"Ghosh, Tanmoy","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Kabir","familyName":"Ramola","name":"Ramola, Kabir","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Saroj Kumar","familyName":"Nandi","name":"Nandi, Saroj Kumar","affiliation":[],"nameIdentifiers":[]}],"titles":[{"title":"A constitutive model for discontinuous shear thickening in epithelial tissues"}],"publisher":"arXiv","container":{},"publicationYear":2026,"subjects":[{"subject":"Soft Condensed Matter (cond-mat.soft)","lang":"en","subjectScheme":"arXiv"},{"subject":"FOS: Physical sciences","subjectScheme":"Fields of Science and Technology (FOS)"},{"schemeUri":"http://www.oecd.org/science/inno/38235147.pdf","subject":"FOS: Physical sciences","subjectScheme":"Fields of Science and Technology (FOS)"}],"contributors":[],"dates":[{"date":"2026-02-24T13:23:34Z","dateType":"Submitted","dateInformation":"v1"},{"date":"2026-02-25T01:47:45Z","dateType":"Updated","dateInformation":"v1"},{"date":"2026-02","dateType":"Available","dateInformation":"v1"},{"date":"2026","dateType":"Issued"}],"language":null,"types":{"schemaOrg":"CreativeWork","resourceTypeGeneral":"Preprint","citeproc":"article","bibtex":"misc","ris":"GEN","resourceType":"Article"},"relatedIdentifiers":[],"relatedItems":[],"sizes":[],"formats":[],"version":"1","rightsList":[{"rightsUri":"http://arxiv.org/licenses/nonexclusive-distrib/1.0/","rights":"arXiv.org perpetual, non-exclusive license"}],"descriptions":[{"descriptionType":"Abstract","description":"The rheological properties of biological tissues, though fundamental to many physiological and pathological processes such as embryonic development, wound healing, and tumor progression, remain poorly understood. A recent study showed that the active vertex model of biological tissues exhibits discontinuous shear thickening (DST), where stress and viscosity suddenly increase at a critical shear rate. What is the mechanism of DST here? Is it another nontrivial feature of activity or an inherent property of the system? To address this, we show that the thermal vertex model also exhibits DST at a small but non-zero temperature $T$. Solid-like and liquid-like cells coexist at the stress jump, and the stress-controlled flow curves exhibit the characteristic S-shape. We then introduce a constitutive model for DST in epithelial tissues. As $p_0$ increases, the theory predicts DST, followed by continuous shear thickening (CST), and finally Newtonian behavior, consistent with simulations. DST begins at the jamming point, $p_0^m$, and the Newtonian behavior starts at $p_0^*$, where the yield stress vanishes. Both $p_0^*$ and the liquid-to-solid transition stress, $σ^*$, govern the DST-CST boundary. Furthermore, $p_0^*$ and $σ^*$ also depend on $T$. Increasing $T$ reduces $p_0^*$, narrows the shear-thickening regime, and eventually destroys DST when $p_0^* \\leq p_0^m$. Thus, the primary ingredients of DST in tissue models are a finite yield stress in the unjammed regime and non-zero fluctuations, whose specific form is not important. The theory agrees well with our simulation data and also provides further testable predictions."}],"geoLocations":[],"fundingReferences":[],"url":"https://arxiv.org/abs/2602.20886","contentUrl":null,"metadataVersion":0,"schemaVersion":"http://datacite.org/schema/kernel-4","source":"mds","isActive":true,"state":"findable","reason":null,"viewCount":0,"downloadCount":0,"referenceCount":0,"citationCount":0,"partCount":0,"partOfCount":0,"versionCount":0,"versionOfCount":0,"created":"2026-02-25T03:00:56Z","registered":"2026-02-25T03:00:57Z","published":null,"updated":"2026-02-25T03:00:57Z"},"relationships":{"client":{"data":{"id":"arxiv.content","type":"clients"}}}},{"id":"10.48550/arxiv.2602.20885","type":"dois","attributes":{"doi":"10.48550/arxiv.2602.20885","identifiers":[{"identifier":"2602.20885","identifierType":"arXiv"}],"creators":[{"nameType":"Personal","givenName":"Céline","familyName":"Cunen","name":"Cunen, Céline","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Nils Lid","familyName":"Hjort","name":"Hjort, Nils Lid","affiliation":[],"nameIdentifiers":[]}],"titles":[{"title":"Combining Information Across Diverse Sources: The II-CC-FF Paradigm"}],"publisher":"arXiv","container":{},"publicationYear":2026,"subjects":[{"subject":"Methodology (stat.ME)","lang":"en","subjectScheme":"arXiv"},{"subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"},{"schemeUri":"http://www.oecd.org/science/inno/38235147.pdf","subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"}],"contributors":[],"dates":[{"date":"2026-02-24T13:23:27Z","dateType":"Submitted","dateInformation":"v1"},{"date":"2026-02-25T01:47:44Z","dateType":"Updated","dateInformation":"v1"},{"date":"2026-02","dateType":"Available","dateInformation":"v1"},{"date":"2026","dateType":"Issued"}],"language":null,"types":{"schemaOrg":"CreativeWork","resourceTypeGeneral":"Preprint","citeproc":"article","bibtex":"misc","ris":"GEN","resourceType":"Article"},"relatedIdentifiers":[],"relatedItems":[],"sizes":[],"formats":[],"version":"1","rightsList":[{"rightsUri":"http://arxiv.org/licenses/nonexclusive-distrib/1.0/","rights":"arXiv.org perpetual, non-exclusive license"}],"descriptions":[{"descriptionType":"Abstract","description":"We introduce and develop a general paradigm for combining information across diverse data sources. In broad terms, suppose $ϕ$ is a parameter of interest, built up via components $ψ_1,\\ldots,ψ_k$ from data sources $1,\\ldots,k$. The proposed scheme has three steps. First, the Independent Inspection (II) step amounts to investigating each separate data source, translating statistical information to a confidence distribution $C_j(ψ_j)$ for the relevant focus parameter $ψ_j$ associated with data source $j$. Second, Confidence Conversion (CC) techniques are used to translate the confidence distributions to confidence log-likelihood functions, say $\\ell_{{\\rm con},j}(ψ_j)$. Finally, the Focused Fusion (FF) step uses relevant and context-driven techniques to construct a confidence distribution for the primary focus parameter $ϕ=ϕ(ψ_1,\\ldots,ψ_k)$, acting on the combined confidence log-likelihood. In traditional setups, the II-CC-FF strategy amounts to versions of meta-analysis, and turns out to be competitive against state-of-the-art methods. Its potential lies in applications to harder problems, however. Illustrations are presented, related to actual applications."},{"descriptionType":"Other","description":"44 pages, 14 figures. This is the authors' version, with Supplementing Material, July 2020 (and arXiv'd February 2026), published in essentially this form in Scandinavian Journal of Statistics, 2022, vol. 49, pages 625-256, at this url: onlinelibrary.wiley.com/doi/pdf/10.1111/sjos.12530"}],"geoLocations":[],"fundingReferences":[],"url":"https://arxiv.org/abs/2602.20885","contentUrl":null,"metadataVersion":0,"schemaVersion":"http://datacite.org/schema/kernel-4","source":"mds","isActive":true,"state":"findable","reason":null,"viewCount":0,"downloadCount":0,"referenceCount":0,"citationCount":0,"partCount":0,"partOfCount":0,"versionCount":0,"versionOfCount":0,"created":"2026-02-25T03:00:55Z","registered":"2026-02-25T03:00:55Z","published":null,"updated":"2026-02-25T03:00:55Z"},"relationships":{"client":{"data":{"id":"arxiv.content","type":"clients"}}}},{"id":"10.48550/arxiv.2602.20883","type":"dois","attributes":{"doi":"10.48550/arxiv.2602.20883","identifiers":[{"identifier":"2602.20883","identifierType":"arXiv"}],"creators":[{"nameType":"Personal","givenName":"Rudy","familyName":"Arthur","name":"Arthur, Rudy","affiliation":[],"nameIdentifiers":[]}],"titles":[{"title":"Adaptation by Cumulative Selection"}],"publisher":"arXiv","container":{},"publicationYear":2026,"subjects":[{"subject":"Populations and Evolution (q-bio.PE)","lang":"en","subjectScheme":"arXiv"},{"subject":"FOS: Biological sciences","subjectScheme":"Fields of Science and Technology (FOS)"},{"schemeUri":"http://www.oecd.org/science/inno/38235147.pdf","subject":"FOS: Biological sciences","subjectScheme":"Fields of Science and Technology (FOS)"}],"contributors":[],"dates":[{"date":"2026-02-24T13:22:08Z","dateType":"Submitted","dateInformation":"v1"},{"date":"2026-02-25T01:47:39Z","dateType":"Updated","dateInformation":"v1"},{"date":"2026-02","dateType":"Available","dateInformation":"v1"},{"date":"2026","dateType":"Issued"}],"language":null,"types":{"schemaOrg":"CreativeWork","resourceTypeGeneral":"Preprint","citeproc":"article","bibtex":"misc","ris":"GEN","resourceType":"Article"},"relatedIdentifiers":[],"relatedItems":[],"sizes":[],"formats":[],"version":"1","rightsList":[{"rightsIdentifierScheme":"SPDX","rightsUri":"https://creativecommons.org/licenses/by/4.0/legalcode","schemeUri":"https://spdx.org/licenses/","rights":"Creative Commons Attribution 4.0 International","rightsIdentifier":"cc-by-4.0"}],"descriptions":[{"descriptionType":"Abstract","description":"Biological systems like long-lived clonal organisms, holobionts and clades challenge traditional evolutionary thinking since they adapt without populations or reproduction. This paper aims to provide an overarching theoretical framework which encompasses standard Darwinian evolution as well as other processes of adaptation. This framework is cumulative selection and I provide a general `recipe' for it to occur. Lewontin's recipe for evolution by natural selection is shown to be a particular example of cumulative selection, but not the only one. Similarly, reproduction, inheritance and populations are just one way to perform cumulative selection. I discuss several other examples of cumulative selection including clonal organisms, dioecious populations, Gaia and neural networks."}],"geoLocations":[],"fundingReferences":[],"url":"https://arxiv.org/abs/2602.20883","contentUrl":null,"metadataVersion":0,"schemaVersion":"http://datacite.org/schema/kernel-4","source":"mds","isActive":true,"state":"findable","reason":null,"viewCount":0,"downloadCount":0,"referenceCount":0,"citationCount":0,"partCount":0,"partOfCount":0,"versionCount":0,"versionOfCount":0,"created":"2026-02-25T03:00:52Z","registered":"2026-02-25T03:00:52Z","published":null,"updated":"2026-02-25T03:00:52Z"},"relationships":{"client":{"data":{"id":"arxiv.content","type":"clients"}}}},{"id":"10.48550/arxiv.2602.20882","type":"dois","attributes":{"doi":"10.48550/arxiv.2602.20882","identifiers":[{"identifier":"2602.20882","identifierType":"arXiv"}],"creators":[{"nameType":"Personal","givenName":"Yu","familyName":"Meng","name":"Meng, Yu","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Yun-Feng","familyName":"Liang","name":"Liang, Yun-Feng","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Ben-Yang","familyName":"Zhu","name":"Zhu, Ben-Yang","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Xiao-Na","familyName":"Sun","name":"Sun, Xiao-Na","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"En-Wei","familyName":"Liang","name":"Liang, En-Wei","affiliation":[],"nameIdentifiers":[]}],"titles":[{"title":"Revisiting the Geminga halo at GeV energies with Fermi-LAT data"}],"publisher":"arXiv","container":{},"publicationYear":2026,"subjects":[{"subject":"High Energy Astrophysical Phenomena (astro-ph.HE)","lang":"en","subjectScheme":"arXiv"},{"subject":"FOS: Physical sciences","subjectScheme":"Fields of Science and Technology (FOS)"},{"schemeUri":"http://www.oecd.org/science/inno/38235147.pdf","subject":"FOS: Physical sciences","subjectScheme":"Fields of Science and Technology (FOS)"}],"contributors":[],"dates":[{"date":"2026-02-24T13:22:07Z","dateType":"Submitted","dateInformation":"v1"},{"date":"2026-02-25T01:47:38Z","dateType":"Updated","dateInformation":"v1"},{"date":"2026-02","dateType":"Available","dateInformation":"v1"},{"date":"2026","dateType":"Issued"}],"language":null,"types":{"schemaOrg":"CreativeWork","resourceTypeGeneral":"Preprint","citeproc":"article","bibtex":"misc","ris":"GEN","resourceType":"Article"},"relatedIdentifiers":[],"relatedItems":[],"sizes":[],"formats":[],"version":"1","rightsList":[{"rightsUri":"http://arxiv.org/licenses/nonexclusive-distrib/1.0/","rights":"arXiv.org perpetual, non-exclusive license"}],"descriptions":[{"descriptionType":"Abstract","description":"Nearby pulsars within $\\sim1\\,{\\rm kpc}$ are considered to be possible sources of 10-500 GeV cosmic-ray positron excess measured by PAMELA and AMS-02. A TeV halo around Geminga is detected by HAWC, and the measurements of its surface brightness profile indicate a slow particle diffusion surrounding the source. This result challenges the pulsar interpretation of the positron excess. The observations at GeV energies provide direct information on the electron/positron density in the GeV nebula, which can offer more direct constraints on the origin of the positron excess. Two previous works have performed analyses on the GeV emission of the pulsar halo, but focused on the energy band above 8 GeV. In this work, we use a longer dataset from the Fermi Large Area Telescope (LAT) to re-analyze the GeV halo emission of Geminga, extending the analysis to cover the energy range of 1-1000 GeV. We find that the analysis in this wider energy range results in a low significance of the halo emission. This can be attributed to the Galactic interstellar emission model being unable to perfectly fit the background over this broader energy range, and due to the low measured halo flux at $\u0026lt;$ 10 GeV energies leading to a mismatch between the observation and model expectation. We also derive the spectral energy distribution of the tentative halo emission, which shows a very hard spectrum in the 1-10 GeV range."},{"descriptionType":"Other","description":"12 pages, 7 figures. Accepted for publication in PRD"}],"geoLocations":[],"fundingReferences":[],"url":"https://arxiv.org/abs/2602.20882","contentUrl":null,"metadataVersion":0,"schemaVersion":"http://datacite.org/schema/kernel-4","source":"mds","isActive":true,"state":"findable","reason":null,"viewCount":0,"downloadCount":0,"referenceCount":0,"citationCount":0,"partCount":0,"partOfCount":0,"versionCount":0,"versionOfCount":0,"created":"2026-02-25T03:00:50Z","registered":"2026-02-25T03:00:51Z","published":null,"updated":"2026-02-25T03:00:51Z"},"relationships":{"client":{"data":{"id":"arxiv.content","type":"clients"}}}},{"id":"10.48550/arxiv.2602.20879","type":"dois","attributes":{"doi":"10.48550/arxiv.2602.20879","identifiers":[{"identifier":"2602.20879","identifierType":"arXiv"}],"creators":[{"nameType":"Personal","givenName":"Andrej","familyName":"Čadež","name":"Čadež, Andrej","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Aleš","familyName":"Mohorič","name":"Mohorič, Aleš","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Massimo","familyName":"Calvani","name":"Calvani, Massimo","affiliation":[],"nameIdentifiers":[]}],"titles":[{"title":"Stellar structure, magnetism and the variational principle"}],"publisher":"arXiv","container":{},"publicationYear":2026,"subjects":[{"subject":"Solar and Stellar Astrophysics (astro-ph.SR)","lang":"en","subjectScheme":"arXiv"},{"subject":"General Relativity and Quantum Cosmology (gr-qc)","lang":"en","subjectScheme":"arXiv"},{"subject":"Mathematical Physics (math-ph)","lang":"en","subjectScheme":"arXiv"},{"subject":"FOS: Physical sciences","subjectScheme":"Fields of Science and Technology (FOS)"},{"schemeUri":"http://www.oecd.org/science/inno/38235147.pdf","subject":"FOS: Physical sciences","subjectScheme":"Fields of Science and Technology (FOS)"}],"contributors":[],"dates":[{"date":"2026-02-24T13:20:24Z","dateType":"Submitted","dateInformation":"v1"},{"date":"2026-02-25T01:47:34Z","dateType":"Updated","dateInformation":"v1"},{"date":"2026-02","dateType":"Available","dateInformation":"v1"},{"date":"2026","dateType":"Issued"}],"language":null,"types":{"schemaOrg":"CreativeWork","resourceTypeGeneral":"Preprint","citeproc":"article","bibtex":"misc","ris":"GEN","resourceType":"Article"},"relatedIdentifiers":[],"relatedItems":[],"sizes":[],"formats":[],"version":"1","rightsList":[{"rightsUri":"http://arxiv.org/licenses/nonexclusive-distrib/1.0/","rights":"arXiv.org perpetual, non-exclusive license"}],"descriptions":[{"descriptionType":"Abstract","description":"Matter interacts through two long range forces: gravity and electromagnetism. While all matter contributes to the gravitational potential, electromagnetic effects were traditionally expected to cancel in large systems because positive and negative charges balance. Yet astrophysical objects clearly show long range electromagnetic behavior, so the cancellation cannot be perfect. This paper develops a model for stationary aggregation of matter into a star that consistently includes angular momentum and electromagnetic effects. We reformulate the standard polytropic stellar model as a variational problem and extend it to include the kinetic energy of rigid rotation and the electromagnetic interaction energy between oppositely charged baryonic matter. The electromagnetic contribution to the action is taken to be the minimal energy required to generate the stellar magnetic dipole moment. This energy has two parts: the pure electromagnetic contribution, expressible as a surface integral, and the free energy difference between magnetized and unmagnetized matter, obtained by analyzing a degenerate electron gas in a background of cold ions. Differential forms provide a convenient mathematical framework. The resulting model incorporates electromagnetic effects into stellar structure in a way consistent with linearized general relativity. Although the full system forms a complex open boundary problem, exact solutions exist under simplifying assumptions. The phase diagram predicted by the simplified model shows patterns that may motivate further study of the balance between matter, gravitation, and electromagnetism"},{"descriptionType":"Other","description":"43 pages, 10 figures"}],"geoLocations":[],"fundingReferences":[],"url":"https://arxiv.org/abs/2602.20879","contentUrl":null,"metadataVersion":0,"schemaVersion":"http://datacite.org/schema/kernel-4","source":"mds","isActive":true,"state":"findable","reason":null,"viewCount":0,"downloadCount":0,"referenceCount":0,"citationCount":0,"partCount":0,"partOfCount":0,"versionCount":0,"versionOfCount":0,"created":"2026-02-25T03:00:46Z","registered":"2026-02-25T03:00:47Z","published":null,"updated":"2026-02-25T03:00:47Z"},"relationships":{"client":{"data":{"id":"arxiv.content","type":"clients"}}}},{"id":"10.48550/arxiv.2602.20878","type":"dois","attributes":{"doi":"10.48550/arxiv.2602.20878","identifiers":[{"identifier":"2602.20878","identifierType":"arXiv"}],"creators":[{"nameType":"Personal","givenName":"Dhita Putri","familyName":"Pratama","name":"Pratama, Dhita Putri","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Soyeon Caren","familyName":"Han","name":"Han, Soyeon Caren","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Yihao","familyName":"Ding","name":"Ding, Yihao","affiliation":[],"nameIdentifiers":[]}],"titles":[{"title":"Diagnosing Causal Reasoning in Vision-Language Models via Structured Relevance Graphs"}],"publisher":"arXiv","container":{},"publicationYear":2026,"subjects":[{"subject":"Artificial Intelligence (cs.AI)","lang":"en","subjectScheme":"arXiv"},{"subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"},{"schemeUri":"http://www.oecd.org/science/inno/38235147.pdf","subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"}],"contributors":[],"dates":[{"date":"2026-02-24T13:20:07Z","dateType":"Submitted","dateInformation":"v1"},{"date":"2026-02-25T01:47:32Z","dateType":"Updated","dateInformation":"v1"},{"date":"2026-02","dateType":"Available","dateInformation":"v1"},{"date":"2026","dateType":"Issued"}],"language":null,"types":{"schemaOrg":"CreativeWork","resourceTypeGeneral":"Preprint","citeproc":"article","bibtex":"misc","ris":"GEN","resourceType":"Article"},"relatedIdentifiers":[],"relatedItems":[],"sizes":[],"formats":[],"version":"1","rightsList":[{"rightsIdentifierScheme":"SPDX","rightsUri":"https://creativecommons.org/licenses/by/4.0/legalcode","schemeUri":"https://spdx.org/licenses/","rights":"Creative Commons Attribution 4.0 International","rightsIdentifier":"cc-by-4.0"}],"descriptions":[{"descriptionType":"Abstract","description":"Large Vision-Language Models (LVLMs) achieve strong performance on visual question answering benchmarks, yet often rely on spurious correlations rather than genuine causal reasoning. Existing evaluations primarily assess the correctness of the answers, making it unclear whether failures arise from limited reasoning capability or from misidentifying causally relevant information. We introduce Vision-Language Causal Graphs (VLCGs), a structured, query-conditioned representation that explicitly encodes causally relevant objects, attributes, relations, and scene-grounded assumptions. Building on this representation, we present ViLCaR, a diagnostic benchmark comprising tasks for Causal Attribution, Causal Inference, and Question Answering, along with graph-aligned evaluation metrics that assess relevance identification beyond final answer accuracy. Experiments in state-of-the-art LVLMs show that injecting structured relevance information significantly improves attribution and inference consistency compared to zero-shot and standard in-context learning. These findings suggest that current limitations in LVLM causal reasoning stem primarily from insufficient structural guidance rather than a lack of reasoning capacity."}],"geoLocations":[],"fundingReferences":[],"url":"https://arxiv.org/abs/2602.20878","contentUrl":null,"metadataVersion":0,"schemaVersion":"http://datacite.org/schema/kernel-4","source":"mds","isActive":true,"state":"findable","reason":null,"viewCount":0,"downloadCount":0,"referenceCount":0,"citationCount":0,"partCount":0,"partOfCount":0,"versionCount":0,"versionOfCount":0,"created":"2026-02-25T03:00:44Z","registered":"2026-02-25T03:00:45Z","published":null,"updated":"2026-02-25T03:00:45Z"},"relationships":{"client":{"data":{"id":"arxiv.content","type":"clients"}}}},{"id":"10.48550/arxiv.2602.20877","type":"dois","attributes":{"doi":"10.48550/arxiv.2602.20877","identifiers":[{"identifier":"2602.20877","identifierType":"arXiv"}],"creators":[{"nameType":"Personal","givenName":"Jiwoo","familyName":"Kang","name":"Kang, Jiwoo","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Yeon-Chang","familyName":"Lee","name":"Lee, Yeon-Chang","affiliation":[],"nameIdentifiers":[]}],"titles":[{"title":"E-MMKGR: A Unified Multimodal Knowledge Graph Framework for E-commerce Applications"}],"publisher":"arXiv","container":{},"publicationYear":2026,"subjects":[{"subject":"Information Retrieval (cs.IR)","lang":"en","subjectScheme":"arXiv"},{"subject":"Artificial Intelligence (cs.AI)","lang":"en","subjectScheme":"arXiv"},{"subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"},{"schemeUri":"http://www.oecd.org/science/inno/38235147.pdf","subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"}],"contributors":[],"dates":[{"date":"2026-02-24T13:19:42Z","dateType":"Submitted","dateInformation":"v1"},{"date":"2026-02-25T01:47:31Z","dateType":"Updated","dateInformation":"v1"},{"date":"2026-02","dateType":"Available","dateInformation":"v1"},{"date":"2026","dateType":"Issued"}],"language":null,"types":{"schemaOrg":"CreativeWork","resourceTypeGeneral":"Preprint","citeproc":"article","bibtex":"misc","ris":"GEN","resourceType":"Article"},"relatedIdentifiers":[],"relatedItems":[],"sizes":[],"formats":[],"version":"1","rightsList":[{"rightsUri":"http://arxiv.org/licenses/nonexclusive-distrib/1.0/","rights":"arXiv.org perpetual, non-exclusive license"}],"descriptions":[{"descriptionType":"Abstract","description":"Multimodal recommender systems (MMRSs) enhance collaborative filtering by leveraging item-side modalities, but their reliance on a fixed set of modalities and task-specific objectives limits both modality extensibility and task generalization. We propose E-MMKGR, a framework that constructs an e-commerce-specific Multimodal Knowledge Graph E-MMKG and learns unified item representations through GNN-based propagation and KG-oriented optimization. These representations provide a shared semantic foundation applicable to diverse tasks. Experiments on real-world Amazon datasets show improvements of up to 10.18% in Recall@10 for recommendation and up to 21.72% over vector-based retrieval for product search, demonstrating the effectiveness and extensibility of our approach."}],"geoLocations":[],"fundingReferences":[],"url":"https://arxiv.org/abs/2602.20877","contentUrl":null,"metadataVersion":0,"schemaVersion":"http://datacite.org/schema/kernel-4","source":"mds","isActive":true,"state":"findable","reason":null,"viewCount":0,"downloadCount":0,"referenceCount":0,"citationCount":0,"partCount":0,"partOfCount":0,"versionCount":0,"versionOfCount":0,"created":"2026-02-25T03:00:43Z","registered":"2026-02-25T03:00:44Z","published":null,"updated":"2026-02-25T03:00:44Z"},"relationships":{"client":{"data":{"id":"arxiv.content","type":"clients"}}}},{"id":"10.48550/arxiv.2602.20876","type":"dois","attributes":{"doi":"10.48550/arxiv.2602.20876","identifiers":[{"identifier":"2602.20876","identifierType":"arXiv"}],"creators":[{"nameType":"Personal","givenName":"Runhua","familyName":"Zhang","name":"Zhang, Runhua","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Ziqi","familyName":"Pan","name":"Pan, Ziqi","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Kangyu","familyName":"Yuan","name":"Yuan, Kangyu","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Qiaoyi","familyName":"Chen","name":"Chen, Qiaoyi","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Yulin","familyName":"Tian","name":"Tian, Yulin","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Huamin","familyName":"Qu","name":"Qu, Huamin","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Xiaojuan","familyName":"Ma","name":"Ma, Xiaojuan","affiliation":[],"nameIdentifiers":[]}],"titles":[{"title":"When LLMs Enter Everyday Feminism on Chinese Social Media: Opportunities and Risks for Women's Empowerment"}],"publisher":"arXiv","container":{},"publicationYear":2026,"subjects":[{"subject":"Human-Computer Interaction (cs.HC)","lang":"en","subjectScheme":"arXiv"},{"subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"},{"schemeUri":"http://www.oecd.org/science/inno/38235147.pdf","subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"}],"contributors":[],"dates":[{"date":"2026-02-24T13:19:26Z","dateType":"Submitted","dateInformation":"v1"},{"date":"2026-02-25T01:47:29Z","dateType":"Updated","dateInformation":"v1"},{"date":"2026-02","dateType":"Available","dateInformation":"v1"},{"date":"2026","dateType":"Issued"}],"language":null,"types":{"schemaOrg":"CreativeWork","resourceTypeGeneral":"Preprint","citeproc":"article","bibtex":"misc","ris":"GEN","resourceType":"Article"},"relatedIdentifiers":[{"relationType":"IsVersionOf","relatedIdentifier":"10.1145/3772318.3790616","relatedIdentifierType":"DOI"}],"relatedItems":[],"sizes":[],"formats":[],"version":"1","rightsList":[{"rightsIdentifierScheme":"SPDX","rightsUri":"https://creativecommons.org/licenses/by-nc-nd/4.0/legalcode","schemeUri":"https://spdx.org/licenses/","rights":"Creative Commons Attribution Non Commercial No Derivatives 4.0 International","rightsIdentifier":"cc-by-nc-nd-4.0"}],"descriptions":[{"descriptionType":"Abstract","description":"Everyday digital feminism refers to the ordinary, often pragmatic ways women articulate lived experiences and cultivate solidarity in online spaces. In China, such practices flourish on RedNote through discussions under hashtags like ''women's growth''. Recently, DeepSeek-generated content has been taken up as a new voice in these conversations. Given widely recognized gender biases in LLMs, this raises critical concerns about how LLMs interact with everyday feminist practices. Through an analysis of 430 RedNote posts, 139 shared DeepSeek responses, and 3211 comments, we found that users predominantly welcomed DeepSeek's advice. Yet feminist critical discourse analysis revealed that these responses primarily encouraged women to self-optimize and pursue achievements within prevailing norms rather than challenge them. By interpreting this case, we discuss the opportunities and risks that LLMs introduce for everyday feminism as a pathway toward women's empowerment, and offer design implications for leveraging LLMs to better support such practices."},{"descriptionType":"Other","description":"This paper is conditionally accepted to CHI 2026"}],"geoLocations":[],"fundingReferences":[],"url":"https://arxiv.org/abs/2602.20876","contentUrl":null,"metadataVersion":0,"schemaVersion":"http://datacite.org/schema/kernel-4","source":"mds","isActive":true,"state":"findable","reason":null,"viewCount":0,"downloadCount":0,"referenceCount":0,"citationCount":0,"partCount":0,"partOfCount":0,"versionCount":0,"versionOfCount":1,"created":"2026-02-25T03:00:42Z","registered":"2026-02-25T03:00:42Z","published":null,"updated":"2026-02-25T03:00:42Z"},"relationships":{"client":{"data":{"id":"arxiv.content","type":"clients"}}}},{"id":"10.48550/arxiv.2602.20875","type":"dois","attributes":{"doi":"10.48550/arxiv.2602.20875","identifiers":[{"identifier":"2602.20875","identifierType":"arXiv"}],"creators":[{"nameType":"Personal","givenName":"Louis","familyName":"Sharrock","name":"Sharrock, Louis","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Nikolas","familyName":"Kantas","name":"Kantas, Nikolas","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Grigorios A.","familyName":"Pavliotis","name":"Pavliotis, Grigorios A.","affiliation":[],"nameIdentifiers":[]}],"titles":[{"title":"Efficient Online Learning in Interacting Particle Systems"}],"publisher":"arXiv","container":{},"publicationYear":2026,"subjects":[{"subject":"Statistics Theory (math.ST)","lang":"en","subjectScheme":"arXiv"},{"subject":"Optimization and Control (math.OC)","lang":"en","subjectScheme":"arXiv"},{"subject":"Probability (math.PR)","lang":"en","subjectScheme":"arXiv"},{"subject":"Methodology (stat.ME)","lang":"en","subjectScheme":"arXiv"},{"subject":"Machine Learning (stat.ML)","lang":"en","subjectScheme":"arXiv"},{"subject":"FOS: Mathematics","subjectScheme":"Fields of Science and Technology (FOS)"},{"schemeUri":"http://www.oecd.org/science/inno/38235147.pdf","subject":"FOS: Mathematics","subjectScheme":"Fields of Science and Technology (FOS)"},{"subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"},{"schemeUri":"http://www.oecd.org/science/inno/38235147.pdf","subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"}],"contributors":[],"dates":[{"date":"2026-02-24T13:19:07Z","dateType":"Submitted","dateInformation":"v1"},{"date":"2026-02-25T01:47:27Z","dateType":"Updated","dateInformation":"v1"},{"date":"2026-02","dateType":"Available","dateInformation":"v1"},{"date":"2026","dateType":"Issued"}],"language":null,"types":{"schemaOrg":"CreativeWork","resourceTypeGeneral":"Preprint","citeproc":"article","bibtex":"misc","ris":"GEN","resourceType":"Article"},"relatedIdentifiers":[],"relatedItems":[],"sizes":[],"formats":[],"version":"1","rightsList":[{"rightsUri":"http://arxiv.org/licenses/nonexclusive-distrib/1.0/","rights":"arXiv.org perpetual, non-exclusive license"}],"descriptions":[{"descriptionType":"Abstract","description":"We introduce a new method for online parameter estimation in stochastic interacting particle systems, based on continuous observation of a small number of particles from the system. Our method recursively updates the model parameters using a stochastic approximation of the gradient of the asymptotic log likelihood, which is computed using the continuous stream of observations. Under suitable assumptions, we rigorously establish convergence of our method to the stationary points of the asymptotic log-likelihood of the interacting particle system. We consider asymptotics both in the limit as the time horizon $t\\rightarrow\\infty$, for a fixed and finite number of particles, and in the joint limit as the number of particles $N\\rightarrow\\infty$ and the time horizon $t\\rightarrow\\infty$. Under additional assumptions on the asymptotic log-likelihood, we also establish an $\\mathrm{L}^2$ convergence rate and a central limit theorem. Finally, we present several numerical examples of practical interest, including a model for systemic risk, a model of interacting FitzHugh--Nagumo neurons, and a Cucker--Smale flocking model. Our numerical results corroborate our theoretical results, and also suggest that our estimator is effective even in cases where the assumptions required for our theoretical analysis do not hold."}],"geoLocations":[],"fundingReferences":[],"url":"https://arxiv.org/abs/2602.20875","contentUrl":null,"metadataVersion":0,"schemaVersion":"http://datacite.org/schema/kernel-4","source":"mds","isActive":true,"state":"findable","reason":null,"viewCount":0,"downloadCount":0,"referenceCount":0,"citationCount":0,"partCount":0,"partOfCount":0,"versionCount":0,"versionOfCount":0,"created":"2026-02-25T03:00:40Z","registered":"2026-02-25T03:00:41Z","published":null,"updated":"2026-02-25T03:00:41Z"},"relationships":{"client":{"data":{"id":"arxiv.content","type":"clients"}}}},{"id":"10.48550/arxiv.2602.20874","type":"dois","attributes":{"doi":"10.48550/arxiv.2602.20874","identifiers":[{"identifier":"2602.20874","identifierType":"arXiv"}],"creators":[{"nameType":"Personal","givenName":"Yu","familyName":"Li","name":"Li, Yu","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Milad Tatar","familyName":"Mamaghani","name":"Mamaghani, Milad Tatar","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Xiangyun","familyName":"Zhou","name":"Zhou, Xiangyun","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Nan","familyName":"Yang","name":"Yang, Nan","affiliation":[],"nameIdentifiers":[]}],"titles":[{"title":"Symbol-Aware Precoder Design for Physical-Layer Anonymous Communications"}],"publisher":"arXiv","container":{},"publicationYear":2026,"subjects":[{"subject":"Signal Processing (eess.SP)","lang":"en","subjectScheme":"arXiv"},{"subject":"Information Theory (cs.IT)","lang":"en","subjectScheme":"arXiv"},{"subject":"FOS: Electrical engineering, electronic engineering, information engineering","subjectScheme":"Fields of Science and Technology (FOS)"},{"schemeUri":"http://www.oecd.org/science/inno/38235147.pdf","subject":"FOS: Electrical engineering, electronic engineering, information engineering","subjectScheme":"Fields of Science and Technology (FOS)"},{"subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"},{"schemeUri":"http://www.oecd.org/science/inno/38235147.pdf","subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"}],"contributors":[],"dates":[{"date":"2026-02-24T13:18:47Z","dateType":"Submitted","dateInformation":"v1"},{"date":"2026-02-25T01:47:23Z","dateType":"Updated","dateInformation":"v1"},{"date":"2026-02","dateType":"Available","dateInformation":"v1"},{"date":"2026","dateType":"Issued"}],"language":null,"types":{"schemaOrg":"CreativeWork","resourceTypeGeneral":"Preprint","citeproc":"article","bibtex":"misc","ris":"GEN","resourceType":"Article"},"relatedIdentifiers":[],"relatedItems":[],"sizes":[],"formats":[],"version":"1","rightsList":[{"rightsUri":"http://arxiv.org/licenses/nonexclusive-distrib/1.0/","rights":"arXiv.org perpetual, non-exclusive license"}],"descriptions":[{"descriptionType":"Abstract","description":"Physical-layer characteristics, such as channel state information (CSI) and transmitter noise induced by hardware impairments, are often uniquely associated with a transmitter. This paper investigates transmitter anonymity at the physical layer from a signal design perspective. We consider an anonymous communication problem where the receiver should reliably decode the signal from the transmitter but should not make use of the signal to infer the transmitter's identity.Transmitter anonymity is quantified using a Kullback-Leibler divergence (KLD)-based metric, which enables the formulation of explicit anonymity constraints in the precoder design.We then propose an anonymous symbol-level precoding strategy that preserves reliable communication under spatial multiplexing while preventing transmitter identification. The proposed framework employs a partitioned equal-gain combining (P-EGC) scheme that leverages receiver diversity without requiring transmitter-specific CSI. Simulation results demonstrate anonymity-reliability tradeoffs across different signal-to-noise ratios (SNRs) and numbers of data streams. Moreover, the results reveal opposite trends of anonymity with respect to transmitter-dependent noise variations in the low-SNR and high-SNR regimes."},{"descriptionType":"Other","description":"This paper has been submitted for possible journal publication"}],"geoLocations":[],"fundingReferences":[],"url":"https://arxiv.org/abs/2602.20874","contentUrl":null,"metadataVersion":0,"schemaVersion":"http://datacite.org/schema/kernel-4","source":"mds","isActive":true,"state":"findable","reason":null,"viewCount":0,"downloadCount":0,"referenceCount":0,"citationCount":0,"partCount":0,"partOfCount":0,"versionCount":0,"versionOfCount":0,"created":"2026-02-25T03:00:39Z","registered":"2026-02-25T03:00:40Z","published":null,"updated":"2026-02-25T03:00:40Z"},"relationships":{"client":{"data":{"id":"arxiv.content","type":"clients"}}}},{"id":"10.48550/arxiv.2602.20873","type":"dois","attributes":{"doi":"10.48550/arxiv.2602.20873","identifiers":[{"identifier":"2602.20873","identifierType":"arXiv"}],"creators":[{"nameType":"Personal","givenName":"Jiahao","familyName":"Xu","name":"Xu, Jiahao","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Sheng","familyName":"Huang","name":"Huang, Sheng","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Xin","familyName":"Zhang","name":"Zhang, Xin","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Zhixiong","familyName":"Nan","name":"Nan, Zhixiong","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Jiajun","familyName":"Dong","name":"Dong, Jiajun","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Nankun","familyName":"Mu","name":"Mu, Nankun","affiliation":[],"nameIdentifiers":[]}],"titles":[{"title":"MUSE: Harnessing Precise and Diverse Semantics for Few-Shot Whole Slide Image Classification"}],"publisher":"arXiv","container":{},"publicationYear":2026,"subjects":[{"subject":"Computer Vision and Pattern Recognition (cs.CV)","lang":"en","subjectScheme":"arXiv"},{"subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"},{"schemeUri":"http://www.oecd.org/science/inno/38235147.pdf","subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"}],"contributors":[],"dates":[{"date":"2026-02-24T13:17:35Z","dateType":"Submitted","dateInformation":"v1"},{"date":"2026-02-25T01:47:21Z","dateType":"Updated","dateInformation":"v1"},{"date":"2026-02","dateType":"Available","dateInformation":"v1"},{"date":"2026","dateType":"Issued"}],"language":null,"types":{"schemaOrg":"CreativeWork","resourceTypeGeneral":"Preprint","citeproc":"article","bibtex":"misc","ris":"GEN","resourceType":"Article"},"relatedIdentifiers":[],"relatedItems":[],"sizes":[],"formats":[],"version":"1","rightsList":[{"rightsIdentifierScheme":"SPDX","rightsUri":"https://creativecommons.org/licenses/by-nc-sa/4.0/legalcode","schemeUri":"https://spdx.org/licenses/","rights":"Creative Commons Attribution Non Commercial Share Alike 4.0 International","rightsIdentifier":"cc-by-nc-sa-4.0"}],"descriptions":[{"descriptionType":"Abstract","description":"In computational pathology, few-shot whole slide image classification is primarily driven by the extreme scarcity of expert-labeled slides. Recent vision-language methods incorporate textual semantics generated by large language models, but treat these descriptions as static class-level priors that are shared across all samples and lack sample-wise refinement. This limits both the diversity and precision of visual-semantic alignment, hindering generalization under limited supervision. To overcome this, we propose the stochastic MUlti-view Semantic Enhancement (MUSE), a framework that first refines semantic precision via sample-wise adaptation and then enhances semantic richness through retrieval-augmented multi-view generation. Specifically, MUSE introduces Sample-wise Fine-grained Semantic Enhancement (SFSE), which yields a fine-grained semantic prior for each sample through MoE-based adaptive visual-semantic interaction. Guided by this prior, Stochastic Multi-view Model Optimization (SMMO) constructs an LLM-generated knowledge base of diverse pathological descriptions per class, then retrieves and stochastically integrates multiple matched textual views during training. These dynamically selected texts serve as enriched semantic supervisions to stochastically optimize the vision-language model, promoting robustness and mitigating overfitting. Experiments on three benchmark WSI datasets show that MUSE consistently outperforms existing vision-language baselines in few-shot settings, demonstrating that effective few-shot pathology learning requires not only richer semantic sources but also their active and sample-aware semantic optimization. Our code is available at: https://github.com/JiahaoXu-god/CVPR2026_MUSE."},{"descriptionType":"Other","description":"Accepted by CVPR 2026"}],"geoLocations":[],"fundingReferences":[],"url":"https://arxiv.org/abs/2602.20873","contentUrl":null,"metadataVersion":0,"schemaVersion":"http://datacite.org/schema/kernel-4","source":"mds","isActive":true,"state":"findable","reason":null,"viewCount":0,"downloadCount":0,"referenceCount":0,"citationCount":0,"partCount":0,"partOfCount":0,"versionCount":0,"versionOfCount":0,"created":"2026-02-25T03:00:37Z","registered":"2026-02-25T03:00:38Z","published":null,"updated":"2026-02-25T03:00:38Z"},"relationships":{"client":{"data":{"id":"arxiv.content","type":"clients"}}}},{"id":"10.48550/arxiv.2602.20872","type":"dois","attributes":{"doi":"10.48550/arxiv.2602.20872","identifiers":[{"identifier":"2602.20872","identifierType":"arXiv"}],"creators":[{"nameType":"Personal","givenName":"Takumi","familyName":"Okamoto","name":"Okamoto, Takumi","affiliation":[],"nameIdentifiers":[]}],"titles":[{"title":"The Limit Sets of Linear and Nonlinear Infinite IFSs Related to Complex Continued Fractions"}],"publisher":"arXiv","container":{},"publicationYear":2026,"subjects":[{"subject":"Dynamical Systems (math.DS)","lang":"en","subjectScheme":"arXiv"},{"subject":"FOS: Mathematics","subjectScheme":"Fields of Science and Technology (FOS)"},{"schemeUri":"http://www.oecd.org/science/inno/38235147.pdf","subject":"FOS: Mathematics","subjectScheme":"Fields of Science and Technology (FOS)"},{"subject":"37C45 (Primary), 37F35 (Secondary)","lang":"en","subjectScheme":"MSC"}],"contributors":[],"dates":[{"date":"2026-02-24T13:16:11Z","dateType":"Submitted","dateInformation":"v1"},{"date":"2026-02-25T01:47:16Z","dateType":"Updated","dateInformation":"v1"},{"date":"2026-02","dateType":"Available","dateInformation":"v1"},{"date":"2026","dateType":"Issued"}],"language":null,"types":{"schemaOrg":"CreativeWork","resourceTypeGeneral":"Preprint","citeproc":"article","bibtex":"misc","ris":"GEN","resourceType":"Article"},"relatedIdentifiers":[],"relatedItems":[],"sizes":[],"formats":[],"version":"1","rightsList":[{"rightsUri":"http://arxiv.org/licenses/nonexclusive-distrib/1.0/","rights":"arXiv.org perpetual, non-exclusive license"}],"descriptions":[{"descriptionType":"Abstract","description":"We introduce two families of infinite iterated function systems (IFSs) $\\mathcal{F}(\\mathbf{d}, T)$ and $\\mathcal{G}(\\mathbf{d}, T)$, parametrized by a sequence of positive real numbers $\\mathbf{d}$ and a natural number $T$, and investigate the measure-theoretic properties of their limit sets. $\\mathcal{G}(\\mathbf{d}, T)$ is an infinite Möbius IFS, which is an extension of the IFS of real continued fractions to the IFS on the closed unit disc in the complex plane. $\\mathcal{F}(\\mathbf{d}, T)$ is an infinite linear IFS that shares the same first approximation as $\\mathcal{G}(\\mathbf{d}, T)$. We show that for many choices of $\\mathbf{d}$ and $T$, the limit sets of both $\\mathcal{F}(\\mathbf{d}, T)$ and $\\mathcal{G}(\\mathbf{d}, T)$ exhibit phenomena unique to infinite IFSs, such as having zero Hausdorff measure at the Hausdorff dimension, having infinite packing measure at the packing dimension, or having different Hausdorff and packing dimensions. We also prove that the Hausdorff dimension of the limit set of $\\mathcal{F}(\\mathbf{d}, T)$ is strictly larger than that of $\\mathcal{G}(\\mathbf{d}, T)$ under certain conditions on the parameters."},{"descriptionType":"Other","description":"30 pages, 2 figures"}],"geoLocations":[],"fundingReferences":[],"url":"https://arxiv.org/abs/2602.20872","contentUrl":null,"metadataVersion":0,"schemaVersion":"http://datacite.org/schema/kernel-4","source":"mds","isActive":true,"state":"findable","reason":null,"viewCount":0,"downloadCount":0,"referenceCount":0,"citationCount":0,"partCount":0,"partOfCount":0,"versionCount":0,"versionOfCount":0,"created":"2026-02-25T03:00:36Z","registered":"2026-02-25T03:00:37Z","published":null,"updated":"2026-02-25T03:00:37Z"},"relationships":{"client":{"data":{"id":"arxiv.content","type":"clients"}}}},{"id":"10.48550/arxiv.2602.20869","type":"dois","attributes":{"doi":"10.48550/arxiv.2602.20869","identifiers":[{"identifier":"2602.20869","identifierType":"arXiv"}],"creators":[{"nameType":"Personal","givenName":"Hidemasa","familyName":"Yamane","name":"Yamane, Hidemasa","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Yoshiharu","familyName":"Yamada","name":"Yamada, Yoshiharu","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Yusuke","familyName":"Kondo","name":"Kondo, Yusuke","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Ken","familyName":"Miyajima","name":"Miyajima, Ken","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Masayuki","familyName":"Fujita","name":"Fujita, Masayuki","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Shuichi","familyName":"Murakami","name":"Murakami, Shuichi","affiliation":[],"nameIdentifiers":[]}],"titles":[{"title":"Refractive Index Tuning of Terahertz Photonic Materials Based on a Stretchable Silicon Effective Medium"}],"publisher":"arXiv","container":{},"publicationYear":2026,"subjects":[{"subject":"Optics (physics.optics)","lang":"en","subjectScheme":"arXiv"},{"subject":"FOS: Physical sciences","subjectScheme":"Fields of Science and Technology (FOS)"},{"schemeUri":"http://www.oecd.org/science/inno/38235147.pdf","subject":"FOS: Physical sciences","subjectScheme":"Fields of Science and Technology (FOS)"}],"contributors":[],"dates":[{"date":"2026-02-24T13:13:40Z","dateType":"Submitted","dateInformation":"v1"},{"date":"2026-02-25T01:47:03Z","dateType":"Updated","dateInformation":"v1"},{"date":"2026-02","dateType":"Available","dateInformation":"v1"},{"date":"2026","dateType":"Issued"}],"language":null,"types":{"schemaOrg":"CreativeWork","resourceTypeGeneral":"Preprint","citeproc":"article","bibtex":"misc","ris":"GEN","resourceType":"Article"},"relatedIdentifiers":[],"relatedItems":[],"sizes":[],"formats":[],"version":"1","rightsList":[{"rightsUri":"http://arxiv.org/licenses/nonexclusive-distrib/1.0/","rights":"arXiv.org perpetual, non-exclusive license"}],"descriptions":[{"descriptionType":"Abstract","description":"Dynamically tunable terahertz (THz) photonics requires low-loss dielectric platforms with practical, continuous control of refractive index. Here we present a mechanically reconfigurable THz photonic material platform: a monolithic, all-silicon (Si) stretchable effective medium whose refractive index is tuned by deformation. A 200 micrometer-thick high-resistivity single-crystal Si slab was patterned into a subwavelength spiral-spring through-hole lattice, rendering bulk Si mechanically compliant while preserving its low-loss dielectric response. THz time-domain spectroscopy demonstrates high transmission below 0.6 THz and reveals a monotonic decrease in the effective refractive index under uniaxial stretching. At 12.6% elongation, the effective index decreases by 6% and 8% for polarizations perpendicular and parallel to the stretch direction, respectively, thereby demonstrating deformation-induced, controllable anisotropy without a detectable increase in extinction. This structurally engineered bulk-Si approach offers a process-compatible route to mechanically tunable, low-loss THz components for adaptive wavefront and polarization control."},{"descriptionType":"Other","description":"10 pages, 5 figures, Submitted to Optica"}],"geoLocations":[],"fundingReferences":[],"url":"https://arxiv.org/abs/2602.20869","contentUrl":null,"metadataVersion":0,"schemaVersion":"http://datacite.org/schema/kernel-4","source":"mds","isActive":true,"state":"findable","reason":null,"viewCount":0,"downloadCount":0,"referenceCount":0,"citationCount":0,"partCount":0,"partOfCount":0,"versionCount":0,"versionOfCount":0,"created":"2026-02-25T03:00:31Z","registered":"2026-02-25T03:00:32Z","published":null,"updated":"2026-02-25T03:00:32Z"},"relationships":{"client":{"data":{"id":"arxiv.content","type":"clients"}}}},{"id":"10.48550/arxiv.2602.20868","type":"dois","attributes":{"doi":"10.48550/arxiv.2602.20868","identifiers":[{"identifier":"2602.20868","identifierType":"arXiv"}],"creators":[{"nameType":"Personal","givenName":"Simon","familyName":"Finster","name":"Finster, Simon","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Paul W.","familyName":"Goldberg","name":"Goldberg, Paul W.","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Edwin","familyName":"Lock","name":"Lock, Edwin","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Matilde","familyName":"Tullii","name":"Tullii, Matilde","affiliation":[],"nameIdentifiers":[]}],"titles":[{"title":"Decentralized Trading Networks: Equilibria and Fairness"}],"publisher":"arXiv","container":{},"publicationYear":2026,"subjects":[{"subject":"Theoretical Economics (econ.TH)","lang":"en","subjectScheme":"arXiv"},{"subject":"Computer Science and Game Theory (cs.GT)","lang":"en","subjectScheme":"arXiv"},{"subject":"FOS: Economics and business","subjectScheme":"Fields of Science and Technology (FOS)"},{"schemeUri":"http://www.oecd.org/science/inno/38235147.pdf","subject":"FOS: Economics and business","subjectScheme":"Fields of Science and Technology (FOS)"},{"subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"},{"schemeUri":"http://www.oecd.org/science/inno/38235147.pdf","subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"}],"contributors":[],"dates":[{"date":"2026-02-24T13:13:17Z","dateType":"Submitted","dateInformation":"v1"},{"date":"2026-02-25T01:47:02Z","dateType":"Updated","dateInformation":"v1"},{"date":"2026-02","dateType":"Available","dateInformation":"v1"},{"date":"2026","dateType":"Issued"}],"language":null,"types":{"schemaOrg":"CreativeWork","resourceTypeGeneral":"Preprint","citeproc":"article","bibtex":"misc","ris":"GEN","resourceType":"Article"},"relatedIdentifiers":[],"relatedItems":[],"sizes":[],"formats":[],"version":"1","rightsList":[{"rightsUri":"http://arxiv.org/licenses/nonexclusive-distrib/1.0/","rights":"arXiv.org perpetual, non-exclusive license"}],"descriptions":[{"descriptionType":"Abstract","description":"We explore stability and fairness considerations in decentralized networked markets with bilateral contracts, building on the trading networks framework [Hatfield et al., 2013]. In our trading network game, we show that a well-defined subset of Nash equilibria can be supported as competitive equilibria. Considering an offer-based trading dynamic as well as a stochastic price clock market, we prove new convergence results to Nash equilibrium and competitive equilibrium, providing a rationale for stability properties in decentralized, dynamic trading networks. Turning to the tension between fairness and (core) stability, we prove several negative results: inessential agents always receive zero utility in any core outcome, and even essential agents can get zero utility in all core outcomes."}],"geoLocations":[],"fundingReferences":[],"url":"https://arxiv.org/abs/2602.20868","contentUrl":null,"metadataVersion":0,"schemaVersion":"http://datacite.org/schema/kernel-4","source":"mds","isActive":true,"state":"findable","reason":null,"viewCount":0,"downloadCount":0,"referenceCount":0,"citationCount":0,"partCount":0,"partOfCount":0,"versionCount":0,"versionOfCount":0,"created":"2026-02-25T03:00:30Z","registered":"2026-02-25T03:00:31Z","published":null,"updated":"2026-02-25T03:00:31Z"},"relationships":{"client":{"data":{"id":"arxiv.content","type":"clients"}}}},{"id":"10.48550/arxiv.2602.20867","type":"dois","attributes":{"doi":"10.48550/arxiv.2602.20867","identifiers":[{"identifier":"2602.20867","identifierType":"arXiv"}],"creators":[{"nameType":"Personal","givenName":"Yanna","familyName":"Jiang","name":"Jiang, Yanna","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Delong","familyName":"Li","name":"Li, Delong","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Haiyu","familyName":"Deng","name":"Deng, Haiyu","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Baihe","familyName":"Ma","name":"Ma, Baihe","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Xu","familyName":"Wang","name":"Wang, Xu","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Qin","familyName":"Wang","name":"Wang, Qin","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Guangsheng","familyName":"Yu","name":"Yu, Guangsheng","affiliation":[],"nameIdentifiers":[]}],"titles":[{"title":"SoK: Agentic Skills -- Beyond Tool Use in LLM Agents"}],"publisher":"arXiv","container":{},"publicationYear":2026,"subjects":[{"subject":"Cryptography and Security (cs.CR)","lang":"en","subjectScheme":"arXiv"},{"subject":"Artificial Intelligence (cs.AI)","lang":"en","subjectScheme":"arXiv"},{"subject":"Computational Engineering, Finance, and Science (cs.CE)","lang":"en","subjectScheme":"arXiv"},{"subject":"Emerging Technologies (cs.ET)","lang":"en","subjectScheme":"arXiv"},{"subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"},{"schemeUri":"http://www.oecd.org/science/inno/38235147.pdf","subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"}],"contributors":[],"dates":[{"date":"2026-02-24T13:11:38Z","dateType":"Submitted","dateInformation":"v1"},{"date":"2026-02-25T01:46:59Z","dateType":"Updated","dateInformation":"v1"},{"date":"2026-02","dateType":"Available","dateInformation":"v1"},{"date":"2026","dateType":"Issued"}],"language":null,"types":{"schemaOrg":"CreativeWork","resourceTypeGeneral":"Preprint","citeproc":"article","bibtex":"misc","ris":"GEN","resourceType":"Article"},"relatedIdentifiers":[],"relatedItems":[],"sizes":[],"formats":[],"version":"1","rightsList":[{"rightsIdentifierScheme":"SPDX","rightsUri":"https://creativecommons.org/licenses/by/4.0/legalcode","schemeUri":"https://spdx.org/licenses/","rights":"Creative Commons Attribution 4.0 International","rightsIdentifier":"cc-by-4.0"}],"descriptions":[{"descriptionType":"Abstract","description":"Agentic systems increasingly rely on reusable procedural capabilities, \\textit{a.k.a., agentic skills}, to execute long-horizon workflows reliably. These capabilities are callable modules that package procedural knowledge with explicit applicability conditions, execution policies, termination criteria, and reusable interfaces. Unlike one-off plans or atomic tool calls, skills operate (and often do well) across tasks.\n This paper maps the skill layer across the full lifecycle (discovery, practice, distillation, storage, composition, evaluation, and update) and introduces two complementary taxonomies. The first is a system-level set of \\textbf{seven design patterns} capturing how skills are packaged and executed in practice, from metadata-driven progressive disclosure and executable code skills to self-evolving libraries and marketplace distribution. The second is an orthogonal \\textbf{representation $\\times$ scope} taxonomy describing what skills \\emph{are} (natural language, code, policy, hybrid) and what environments they operate over (web, OS, software engineering, robotics).\n We analyze the security and governance implications of skill-based agents, covering supply-chain risks, prompt injection via skill payloads, and trust-tiered execution, grounded by a case study of the ClawHavoc campaign in which nearly 1{,}200 malicious skills infiltrated a major agent marketplace, exfiltrating API keys, cryptocurrency wallets, and browser credentials at scale. We further survey deterministic evaluation approaches, anchored by recent benchmark evidence that curated skills can substantially improve agent success rates while self-generated skills may degrade them. We conclude with open challenges toward robust, verifiable, and certifiable skills for real-world autonomous agents."}],"geoLocations":[],"fundingReferences":[],"url":"https://arxiv.org/abs/2602.20867","contentUrl":null,"metadataVersion":0,"schemaVersion":"http://datacite.org/schema/kernel-4","source":"mds","isActive":true,"state":"findable","reason":null,"viewCount":0,"downloadCount":0,"referenceCount":0,"citationCount":6,"partCount":0,"partOfCount":0,"versionCount":0,"versionOfCount":0,"created":"2026-02-25T03:00:28Z","registered":"2026-02-25T03:00:29Z","published":null,"updated":"2026-02-25T03:00:29Z"},"relationships":{"client":{"data":{"id":"arxiv.content","type":"clients"}}}},{"id":"10.48550/arxiv.2602.20865","type":"dois","attributes":{"doi":"10.48550/arxiv.2602.20865","identifiers":[{"identifier":"2602.20865","identifierType":"arXiv"}],"creators":[{"nameType":"Personal","givenName":"Huy The","familyName":"Nguyen","name":"Nguyen, Huy The","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Artemis A.","familyName":"Vogiatzi","name":"Vogiatzi, Artemis A.","affiliation":[],"nameIdentifiers":[]}],"titles":[{"title":"High Codimension Curve Shortening Flow with Free Boundary"}],"publisher":"arXiv","container":{},"publicationYear":2026,"subjects":[{"subject":"Differential Geometry (math.DG)","lang":"en","subjectScheme":"arXiv"},{"subject":"Analysis of PDEs (math.AP)","lang":"en","subjectScheme":"arXiv"},{"subject":"FOS: Mathematics","subjectScheme":"Fields of Science and Technology (FOS)"},{"schemeUri":"http://www.oecd.org/science/inno/38235147.pdf","subject":"FOS: Mathematics","subjectScheme":"Fields of Science and Technology (FOS)"}],"contributors":[],"dates":[{"date":"2026-02-24T13:09:08Z","dateType":"Submitted","dateInformation":"v1"},{"date":"2026-02-25T01:46:54Z","dateType":"Updated","dateInformation":"v1"},{"date":"2026-02","dateType":"Available","dateInformation":"v1"},{"date":"2026","dateType":"Issued"}],"language":null,"types":{"schemaOrg":"CreativeWork","resourceTypeGeneral":"Preprint","citeproc":"article","bibtex":"misc","ris":"GEN","resourceType":"Article"},"relatedIdentifiers":[],"relatedItems":[],"sizes":[],"formats":[],"version":"1","rightsList":[{"rightsUri":"http://arxiv.org/licenses/nonexclusive-distrib/1.0/","rights":"arXiv.org perpetual, non-exclusive license"}],"descriptions":[{"descriptionType":"Abstract","description":"We study curve shortening flow in high codimension for arcs with free boundary meeting a fixed smooth barrier orthogonally. We prove dilation-invariant curvature and higher-derivative estimates up to the boundary using a Stahl-type localised maximum principle and an adapted cut-off. Using a reflected Gaussian entropy and blow-up analysis, Type I boundary singularities yield a shrinking semicircle model after reflection. Type II blow-ups give a Grim Reaper translator, which is ruled out under a free-boundary entropy bound $\u0026lt;2$. Hence in the low-entropy regime the flow either converges to the orthogonal chord or has only semicircle boundary singularities."}],"geoLocations":[],"fundingReferences":[],"url":"https://arxiv.org/abs/2602.20865","contentUrl":null,"metadataVersion":0,"schemaVersion":"http://datacite.org/schema/kernel-4","source":"mds","isActive":true,"state":"findable","reason":null,"viewCount":0,"downloadCount":0,"referenceCount":0,"citationCount":0,"partCount":0,"partOfCount":0,"versionCount":0,"versionOfCount":0,"created":"2026-02-25T03:00:25Z","registered":"2026-02-25T03:00:26Z","published":null,"updated":"2026-02-25T03:00:26Z"},"relationships":{"client":{"data":{"id":"arxiv.content","type":"clients"}}}},{"id":"10.48550/arxiv.2602.20864","type":"dois","attributes":{"doi":"10.48550/arxiv.2602.20864","identifiers":[{"identifier":"2602.20864","identifierType":"arXiv"}],"creators":[{"nameType":"Personal","givenName":"Isaac A.","familyName":"García","name":"García, Isaac A.","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Jaume","familyName":"Giné","name":"Giné, Jaume","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Víctor","familyName":"Mañosa","name":"Mañosa, Víctor","affiliation":[],"nameIdentifiers":[]}],"titles":[{"title":"Monodromic singularities of Brunella-Miari vector fields with two edges in the Newton diagram"}],"publisher":"arXiv","container":{},"publicationYear":2026,"subjects":[{"subject":"Dynamical Systems (math.DS)","lang":"en","subjectScheme":"arXiv"},{"subject":"FOS: Mathematics","subjectScheme":"Fields of Science and Technology (FOS)"},{"schemeUri":"http://www.oecd.org/science/inno/38235147.pdf","subject":"FOS: Mathematics","subjectScheme":"Fields of Science and Technology (FOS)"},{"subject":"34Cxx, 37G15, 37G10","lang":"en","subjectScheme":"MSC"}],"contributors":[],"dates":[{"date":"2026-02-24T13:06:49Z","dateType":"Submitted","dateInformation":"v1"},{"date":"2026-02-25T01:46:44Z","dateType":"Updated","dateInformation":"v1"},{"date":"2026-02","dateType":"Available","dateInformation":"v1"},{"date":"2026","dateType":"Issued"}],"language":null,"types":{"schemaOrg":"CreativeWork","resourceTypeGeneral":"Preprint","citeproc":"article","bibtex":"misc","ris":"GEN","resourceType":"Article"},"relatedIdentifiers":[],"relatedItems":[],"sizes":[],"formats":[],"version":"1","rightsList":[{"rightsUri":"http://arxiv.org/licenses/nonexclusive-distrib/1.0/","rights":"arXiv.org perpetual, non-exclusive license"}],"descriptions":[{"descriptionType":"Abstract","description":"This work focuses on the study of monodromic singularities in planar analytic families of vector fields whose Newton diagram consists of exactly two edges. We begin by analyzing the desingularization scheme of a minimal model of polynomial vector fields, denoted by ${X}$, which includes only the monomials corresponding to the vertices of the Newton diagram. We then extend this minimal model to the so-called Brunella-Miari vector fields ${X} \\subset {X}^{[1]}$, incorporating all monomials associated with points lying on the edges of the Newton diagram. As a second extension, we consider vector fields ${X}^{[1]} \\subset {X}^{[2]}$ that include higher-order terms corresponding to points located above the polygonal line in the Newton diagram. The key point of our approach is to preserve the desingularization geometry at each extension step. We provide explicit desingularization procedures, which enable the computation of the linear part of the return map $Π$ in cases where the desingularized singularity is associated with a hyperbolic polycycle. Several nontrivial examples are included to illustrate the method."},{"descriptionType":"Other","description":"44 pages, 5 figures"}],"geoLocations":[],"fundingReferences":[],"url":"https://arxiv.org/abs/2602.20864","contentUrl":null,"metadataVersion":0,"schemaVersion":"http://datacite.org/schema/kernel-4","source":"mds","isActive":true,"state":"findable","reason":null,"viewCount":0,"downloadCount":0,"referenceCount":0,"citationCount":0,"partCount":0,"partOfCount":0,"versionCount":0,"versionOfCount":0,"created":"2026-02-25T03:00:24Z","registered":"2026-02-25T03:00:25Z","published":null,"updated":"2026-02-25T03:00:25Z"},"relationships":{"client":{"data":{"id":"arxiv.content","type":"clients"}}}},{"id":"10.48550/arxiv.2602.20861","type":"dois","attributes":{"doi":"10.48550/arxiv.2602.20861","identifiers":[{"identifier":"2602.20861","identifierType":"arXiv"}],"creators":[{"nameType":"Personal","givenName":"Jeremie","familyName":"Guilhot","name":"Guilhot, Jeremie","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Loic Poulain","familyName":"d'Andecy","name":"d'Andecy, Loic Poulain","affiliation":[],"nameIdentifiers":[]}],"titles":[{"title":"Kazhdan-Lusztig bases of parabolic Hecke algebras and applications to Schur-Weyl duality"}],"publisher":"arXiv","container":{},"publicationYear":2026,"subjects":[{"subject":"Representation Theory (math.RT)","lang":"en","subjectScheme":"arXiv"},{"subject":"Mathematical Physics (math-ph)","lang":"en","subjectScheme":"arXiv"},{"subject":"Combinatorics (math.CO)","lang":"en","subjectScheme":"arXiv"},{"subject":"Quantum Algebra (math.QA)","lang":"en","subjectScheme":"arXiv"},{"subject":"FOS: Mathematics","subjectScheme":"Fields of Science and Technology (FOS)"},{"schemeUri":"http://www.oecd.org/science/inno/38235147.pdf","subject":"FOS: Mathematics","subjectScheme":"Fields of Science and Technology (FOS)"},{"subject":"FOS: Physical sciences","subjectScheme":"Fields of Science and Technology (FOS)"},{"schemeUri":"http://www.oecd.org/science/inno/38235147.pdf","subject":"FOS: Physical sciences","subjectScheme":"Fields of Science and Technology (FOS)"}],"contributors":[],"dates":[{"date":"2026-02-24T13:04:15Z","dateType":"Submitted","dateInformation":"v1"},{"date":"2026-02-25T01:46:38Z","dateType":"Updated","dateInformation":"v1"},{"date":"2026-02","dateType":"Available","dateInformation":"v1"},{"date":"2026","dateType":"Issued"}],"language":null,"types":{"schemaOrg":"CreativeWork","resourceTypeGeneral":"Preprint","citeproc":"article","bibtex":"misc","ris":"GEN","resourceType":"Article"},"relatedIdentifiers":[],"relatedItems":[],"sizes":[],"formats":[],"version":"1","rightsList":[{"rightsUri":"http://arxiv.org/licenses/nonexclusive-distrib/1.0/","rights":"arXiv.org perpetual, non-exclusive license"}],"descriptions":[{"descriptionType":"Abstract","description":"With an eye to applications to type A and Schur-Weyl duality, we study Kazhdan-Lusztig bases for a general parabolic Hecke algebra. Parabolic Hecke algebras are idempotent subalgebras of Hecke algebras corresponding to parabolic subgroups, and for type A they coincide with the fused Hecke algebras appearing in a generalisation of the Schur-Weyl duality with the quantum group of GL(N). In this paper we investigate two different Kazhdan-Lusztig bases for parabolic Hecke algebras, together with the associated cells and the corresponding representations. We quickly specialise to type A, for which we describe the cells in terms of the RSK correspondence generalising thus the well-known description for the symmetric group. As a first application we recover the classification of irreducible representations of parabolic Hecke algebras of type A and provide a new construction of these representations. Next we turn to the Schur-Weyl duality and describe the kernel in terms of one the basis studied precedently. Moreover, we formulate some conjectures about a generator of these kernels in terms of Kazhdan-Lusztig basis elements, give some evidence and prove these conjectures in some special cases."}],"geoLocations":[],"fundingReferences":[],"url":"https://arxiv.org/abs/2602.20861","contentUrl":null,"metadataVersion":0,"schemaVersion":"http://datacite.org/schema/kernel-4","source":"mds","isActive":true,"state":"findable","reason":null,"viewCount":0,"downloadCount":0,"referenceCount":0,"citationCount":0,"partCount":0,"partOfCount":0,"versionCount":0,"versionOfCount":0,"created":"2026-02-25T03:00:19Z","registered":"2026-02-25T03:00:20Z","published":null,"updated":"2026-02-25T03:00:20Z"},"relationships":{"client":{"data":{"id":"arxiv.content","type":"clients"}}}},{"id":"10.48550/arxiv.2602.20859","type":"dois","attributes":{"doi":"10.48550/arxiv.2602.20859","identifiers":[{"identifier":"2602.20859","identifierType":"arXiv"}],"creators":[{"nameType":"Personal","givenName":"Zirui","familyName":"He","name":"He, Zirui","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Huopu","familyName":"Zhang","name":"Zhang, Huopu","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Yanguang","familyName":"Liu","name":"Liu, Yanguang","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Sirui","familyName":"Wu","name":"Wu, Sirui","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Mengnan","familyName":"Du","name":"Du, Mengnan","affiliation":[],"nameIdentifiers":[]}],"titles":[{"title":"FinAnchor: Aligned Multi-Model Representations for Financial Prediction"}],"publisher":"arXiv","container":{},"publicationYear":2026,"subjects":[{"subject":"Computation and Language (cs.CL)","lang":"en","subjectScheme":"arXiv"},{"subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"},{"schemeUri":"http://www.oecd.org/science/inno/38235147.pdf","subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"}],"contributors":[],"dates":[{"date":"2026-02-24T13:02:09Z","dateType":"Submitted","dateInformation":"v1"},{"date":"2026-02-25T01:46:35Z","dateType":"Updated","dateInformation":"v1"},{"date":"2026-02","dateType":"Available","dateInformation":"v1"},{"date":"2026","dateType":"Issued"}],"language":null,"types":{"schemaOrg":"CreativeWork","resourceTypeGeneral":"Preprint","citeproc":"article","bibtex":"misc","ris":"GEN","resourceType":"Article"},"relatedIdentifiers":[],"relatedItems":[],"sizes":[],"formats":[],"version":"1","rightsList":[{"rightsIdentifierScheme":"SPDX","rightsUri":"https://creativecommons.org/licenses/by/4.0/legalcode","schemeUri":"https://spdx.org/licenses/","rights":"Creative Commons Attribution 4.0 International","rightsIdentifier":"cc-by-4.0"}],"descriptions":[{"descriptionType":"Abstract","description":"Financial prediction from long documents involves significant challenges, as actionable signals are often sparse and obscured by noise, and the optimal LLM for generating embeddings varies across tasks and time periods. In this paper, we propose FinAnchor(Financial Anchored Representations), a lightweight framework that integrates embeddings from multiple LLMs without fine-tuning the underlying models. FinAnchor addresses the incompatibility of feature spaces by selecting an anchor embedding space and learning linear mappings to align representations from other models into this anchor. These aligned features are then aggregated to form a unified representation for downstream prediction. Across multiple financial NLP tasks, FinAnchor consistently outperforms strong single-model baselines and standard ensemble methods, demonstrating the effectiveness of anchoring heterogeneous representations for robust financial prediction."},{"descriptionType":"Other","description":"11 pages, 4 figures, 5 tables"}],"geoLocations":[],"fundingReferences":[],"url":"https://arxiv.org/abs/2602.20859","contentUrl":null,"metadataVersion":0,"schemaVersion":"http://datacite.org/schema/kernel-4","source":"mds","isActive":true,"state":"findable","reason":null,"viewCount":0,"downloadCount":0,"referenceCount":0,"citationCount":0,"partCount":0,"partOfCount":0,"versionCount":0,"versionOfCount":0,"created":"2026-02-25T03:00:16Z","registered":"2026-02-25T03:00:17Z","published":null,"updated":"2026-02-25T03:00:17Z"},"relationships":{"client":{"data":{"id":"arxiv.content","type":"clients"}}}},{"id":"10.48550/arxiv.2602.20858","type":"dois","attributes":{"doi":"10.48550/arxiv.2602.20858","identifiers":[{"identifier":"2602.20858","identifierType":"arXiv"}],"creators":[{"nameType":"Personal","givenName":"Ismael Sandro","familyName":"da Silva","name":"da Silva, Ismael Sandro","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Marcos T. Oliveira","familyName":"Pimenta","name":"Pimenta, Marcos T. Oliveira","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Pedro Fellype","familyName":"Pontes","name":"Pontes, Pedro Fellype","affiliation":[],"nameIdentifiers":[]}],"titles":[{"title":"Multiple critical points theorems for a class of nonsmooth functionals and applications to problems driven by 1-Laplacian and discontinuous nonlinearities"}],"publisher":"arXiv","container":{},"publicationYear":2026,"subjects":[{"subject":"Analysis of PDEs (math.AP)","lang":"en","subjectScheme":"arXiv"},{"subject":"FOS: Mathematics","subjectScheme":"Fields of Science and Technology (FOS)"},{"schemeUri":"http://www.oecd.org/science/inno/38235147.pdf","subject":"FOS: Mathematics","subjectScheme":"Fields of Science and Technology (FOS)"},{"subject":"35J62, 35J15, 35J20","lang":"en","subjectScheme":"MSC"}],"contributors":[],"dates":[{"date":"2026-02-24T12:59:53Z","dateType":"Submitted","dateInformation":"v1"},{"date":"2026-02-25T01:46:30Z","dateType":"Updated","dateInformation":"v1"},{"date":"2026-02","dateType":"Available","dateInformation":"v1"},{"date":"2026","dateType":"Issued"}],"language":null,"types":{"schemaOrg":"CreativeWork","resourceTypeGeneral":"Preprint","citeproc":"article","bibtex":"misc","ris":"GEN","resourceType":"Article"},"relatedIdentifiers":[],"relatedItems":[],"sizes":[],"formats":[],"version":"1","rightsList":[{"rightsUri":"http://arxiv.org/licenses/nonexclusive-distrib/1.0/","rights":"arXiv.org perpetual, non-exclusive license"}],"descriptions":[{"descriptionType":"Abstract","description":"In this paper, we present a novel approach to investigate the existence of multiple critical points for a class of nonsmooth functionals. This method provides a robust framework to analyze the existence of solutions for problems involving the $1$-Laplacian operator with discontinuous nonlinearities. Our results contribute to advancing the study of nonsmooth variational problems, by establishing new nonsmooth multiple critical point theorems."}],"geoLocations":[],"fundingReferences":[],"url":"https://arxiv.org/abs/2602.20858","contentUrl":null,"metadataVersion":0,"schemaVersion":"http://datacite.org/schema/kernel-4","source":"mds","isActive":true,"state":"findable","reason":null,"viewCount":0,"downloadCount":0,"referenceCount":0,"citationCount":0,"partCount":0,"partOfCount":0,"versionCount":0,"versionOfCount":0,"created":"2026-02-25T03:00:15Z","registered":"2026-02-25T03:00:15Z","published":null,"updated":"2026-02-25T03:00:16Z"},"relationships":{"client":{"data":{"id":"arxiv.content","type":"clients"}}}},{"id":"10.48550/arxiv.2602.20856","type":"dois","attributes":{"doi":"10.48550/arxiv.2602.20856","identifiers":[{"identifier":"2602.20856","identifierType":"arXiv"}],"creators":[{"nameType":"Personal","givenName":"Doron","familyName":"Avramov","name":"Avramov, Doron","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Xin","familyName":"He","name":"He, Xin","affiliation":[],"nameIdentifiers":[]}],"titles":[{"title":"Stochastic Discount Factors with Cross-Asset Spillovers"}],"publisher":"arXiv","container":{},"publicationYear":2026,"subjects":[{"subject":"Computational Finance (q-fin.CP)","lang":"en","subjectScheme":"arXiv"},{"subject":"Econometrics (econ.EM)","lang":"en","subjectScheme":"arXiv"},{"subject":"Portfolio Management (q-fin.PM)","lang":"en","subjectScheme":"arXiv"},{"subject":"Machine Learning (stat.ML)","lang":"en","subjectScheme":"arXiv"},{"subject":"FOS: Economics and business","subjectScheme":"Fields of Science and Technology (FOS)"},{"schemeUri":"http://www.oecd.org/science/inno/38235147.pdf","subject":"FOS: Economics and business","subjectScheme":"Fields of Science and Technology (FOS)"},{"subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"},{"schemeUri":"http://www.oecd.org/science/inno/38235147.pdf","subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"}],"contributors":[],"dates":[{"date":"2026-02-24T12:58:01Z","dateType":"Submitted","dateInformation":"v1"},{"date":"2026-02-25T01:46:25Z","dateType":"Updated","dateInformation":"v1"},{"date":"2026-02","dateType":"Available","dateInformation":"v1"},{"date":"2026","dateType":"Issued"}],"language":null,"types":{"schemaOrg":"CreativeWork","resourceTypeGeneral":"Preprint","citeproc":"article","bibtex":"misc","ris":"GEN","resourceType":"Article"},"relatedIdentifiers":[],"relatedItems":[],"sizes":[],"formats":[],"version":"1","rightsList":[{"rightsUri":"http://arxiv.org/licenses/nonexclusive-distrib/1.0/","rights":"arXiv.org perpetual, non-exclusive license"}],"descriptions":[{"descriptionType":"Abstract","description":"This paper develops a unified framework that links firm-level predictive signals, cross-asset spillovers, and the stochastic discount factor (SDF). Signals and spillovers are jointly estimated by maximizing the Sharpe ratio, yielding an interpretable SDF that both ranks characteristic relevance and uncovers the direction of predictive influence across assets. Out-of-sample, the SDF consistently outperforms self-predictive and expected-return benchmarks across investment universes and market states. The inferred information network highlights large, low-turnover firms as net transmitters. The framework offers a clear, economically grounded view of the informational architecture underlying cross-sectional return dynamics."}],"geoLocations":[],"fundingReferences":[],"url":"https://arxiv.org/abs/2602.20856","contentUrl":null,"metadataVersion":0,"schemaVersion":"http://datacite.org/schema/kernel-4","source":"mds","isActive":true,"state":"findable","reason":null,"viewCount":0,"downloadCount":0,"referenceCount":0,"citationCount":0,"partCount":0,"partOfCount":0,"versionCount":0,"versionOfCount":0,"created":"2026-02-25T03:00:12Z","registered":"2026-02-25T03:00:13Z","published":null,"updated":"2026-02-25T03:00:13Z"},"relationships":{"client":{"data":{"id":"arxiv.content","type":"clients"}}}},{"id":"10.48550/arxiv.2602.20855","type":"dois","attributes":{"doi":"10.48550/arxiv.2602.20855","identifiers":[{"identifier":"2602.20855","identifierType":"arXiv"}],"creators":[{"nameType":"Personal","givenName":"Juan","familyName":"Pardo-Montero","name":"Pardo-Montero, Juan","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Isabel","familyName":"González-Crespo","name":"González-Crespo, Isabel","affiliation":[],"nameIdentifiers":[]}],"titles":[{"title":"On the calculation of the radiobiological effect of radiolytic oxygen depletion in FLASH radiotherapy"}],"publisher":"arXiv","container":{},"publicationYear":2026,"subjects":[{"subject":"Medical Physics (physics.med-ph)","lang":"en","subjectScheme":"arXiv"},{"subject":"FOS: Physical sciences","subjectScheme":"Fields of Science and Technology (FOS)"},{"schemeUri":"http://www.oecd.org/science/inno/38235147.pdf","subject":"FOS: Physical sciences","subjectScheme":"Fields of Science and Technology (FOS)"}],"contributors":[],"dates":[{"date":"2026-02-24T12:57:51Z","dateType":"Submitted","dateInformation":"v1"},{"date":"2026-02-25T01:46:24Z","dateType":"Updated","dateInformation":"v1"},{"date":"2026-02","dateType":"Available","dateInformation":"v1"},{"date":"2026","dateType":"Issued"}],"language":null,"types":{"schemaOrg":"CreativeWork","resourceTypeGeneral":"Preprint","citeproc":"article","bibtex":"misc","ris":"GEN","resourceType":"Article"},"relatedIdentifiers":[],"relatedItems":[],"sizes":[],"formats":[],"version":"1","rightsList":[{"rightsIdentifierScheme":"SPDX","rightsUri":"https://creativecommons.org/licenses/by/4.0/legalcode","schemeUri":"https://spdx.org/licenses/","rights":"Creative Commons Attribution 4.0 International","rightsIdentifier":"cc-by-4.0"}],"descriptions":[{"descriptionType":"Abstract","description":"Objective: Radiolytic oxygen depletion (ROD) may play a role in the sparing of cells irradiated with ultra-high dose rates. Different methods have been used to quantify the effect of ROD during FLASH irradiation on cell survival, typically involving some kind of averaging of the oxygen effect and the LQ model. In this work, we compare the results obtained with several of these methods and introduce a novel method based on the non-linear differential form of the LQ model.\n Approach: We present a novel method to account for a varying oxygen concentration on the dose-response based on the non-linear differential form of the LQ model, and we compare the results obtained with this method with those obtained with other methods that linearize the averaging of the oxygen effect during irradiation.\n Main results: We found differences in the surviving fractions obtained with the method introduced in this work and other methods that introduce different linearizations (averaging) of the non-linear dependence on the oxygen concentration, especially for oxygenations and doses that lead to important changes in the OERs during the delivery of the dose (initial oxygenations $\\approx$5--10 mmHg and doses $\u0026gt;30$~Gy). On the other hand, we showed that the method presented by Zhu \\emph{et al.} is equivalent to a first-order Euler numerical method of the differential LQ model.\n Significance: The method introduced in this work and the method of Zhu \\emph{et al.} may allow a more precise quantification of the effect of ROD on dose-response, both for tumors and normal tissues. While all the reviewed methods show an oxygen-dependent sparing effect of FLASH radiotherapy driven by ROD and qualitatively similar results, the method introduced in this work and that of Zhu \\emph{et al.} may be more suitable to quantitatively analyze new preclinical (and future clinical) data coming from experimental studies."}],"geoLocations":[],"fundingReferences":[],"url":"https://arxiv.org/abs/2602.20855","contentUrl":null,"metadataVersion":0,"schemaVersion":"http://datacite.org/schema/kernel-4","source":"mds","isActive":true,"state":"findable","reason":null,"viewCount":0,"downloadCount":0,"referenceCount":0,"citationCount":0,"partCount":0,"partOfCount":0,"versionCount":0,"versionOfCount":0,"created":"2026-02-25T03:00:10Z","registered":"2026-02-25T03:00:11Z","published":null,"updated":"2026-02-25T03:00:11Z"},"relationships":{"client":{"data":{"id":"arxiv.content","type":"clients"}}}},{"id":"10.48550/arxiv.2602.20853","type":"dois","attributes":{"doi":"10.48550/arxiv.2602.20853","identifiers":[{"identifier":"2602.20853","identifierType":"arXiv"}],"creators":[{"nameType":"Personal","givenName":"Stefanie","familyName":"Schneider","name":"Schneider, Stefanie","affiliation":[],"nameIdentifiers":[]}],"titles":[{"title":"On the Explainability of Vision-Language Models in Art History"}],"publisher":"arXiv","container":{},"publicationYear":2026,"subjects":[{"subject":"Computer Vision and Pattern Recognition (cs.CV)","lang":"en","subjectScheme":"arXiv"},{"subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"},{"schemeUri":"http://www.oecd.org/science/inno/38235147.pdf","subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"}],"contributors":[],"dates":[{"date":"2026-02-24T12:53:28Z","dateType":"Submitted","dateInformation":"v1"},{"date":"2026-02-25T01:46:09Z","dateType":"Updated","dateInformation":"v1"},{"date":"2026-02","dateType":"Available","dateInformation":"v1"},{"date":"2026","dateType":"Issued"}],"language":null,"types":{"schemaOrg":"CreativeWork","resourceTypeGeneral":"Preprint","citeproc":"article","bibtex":"misc","ris":"GEN","resourceType":"Article"},"relatedIdentifiers":[],"relatedItems":[],"sizes":[],"formats":[],"version":"1","rightsList":[{"rightsUri":"http://arxiv.org/licenses/nonexclusive-distrib/1.0/","rights":"arXiv.org perpetual, non-exclusive license"}],"descriptions":[{"descriptionType":"Abstract","description":"Vision-Language Models (VLMs) transfer visual and textual data into a shared embedding space. In so doing, they enable a wide range of multimodal tasks, while also raising critical questions about the nature of machine 'understanding.' In this paper, we examine how Explainable Artificial Intelligence (XAI) methods can render the visual reasoning of a VLM - namely, CLIP - legible in art-historical contexts. To this end, we evaluate seven methods, combining zero-shot localization experiments with human interpretability studies. Our results indicate that, while these methods capture some aspects of human interpretation, their effectiveness hinges on the conceptual stability and representational availability of the examined categories."}],"geoLocations":[],"fundingReferences":[],"url":"https://arxiv.org/abs/2602.20853","contentUrl":null,"metadataVersion":0,"schemaVersion":"http://datacite.org/schema/kernel-4","source":"mds","isActive":true,"state":"findable","reason":null,"viewCount":0,"downloadCount":0,"referenceCount":0,"citationCount":0,"partCount":0,"partOfCount":0,"versionCount":0,"versionOfCount":0,"created":"2026-02-25T03:00:07Z","registered":"2026-02-25T03:00:08Z","published":null,"updated":"2026-02-25T03:00:08Z"},"relationships":{"client":{"data":{"id":"arxiv.content","type":"clients"}}}},{"id":"10.48550/arxiv.2602.20852","type":"dois","attributes":{"doi":"10.48550/arxiv.2602.20852","identifiers":[{"identifier":"2602.20852","identifierType":"arXiv"}],"creators":[{"nameType":"Personal","givenName":"Santiago","familyName":"Beltrán-Romero","name":"Beltrán-Romero, Santiago","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Stefan","familyName":"Löffler","name":"Löffler, Stefan","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Dennis","familyName":"Rätzel","name":"Rätzel, Dennis","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Philipp","familyName":"Haslinger","name":"Haslinger, Philipp","affiliation":[],"nameIdentifiers":[]}],"titles":[{"title":"Simulating Microwave-Controlled Spin Imaging with Free-Space Electrons"}],"publisher":"arXiv","container":{},"publicationYear":2026,"subjects":[{"subject":"Quantum Physics (quant-ph)","lang":"en","subjectScheme":"arXiv"},{"subject":"FOS: Physical sciences","subjectScheme":"Fields of Science and Technology (FOS)"},{"schemeUri":"http://www.oecd.org/science/inno/38235147.pdf","subject":"FOS: Physical sciences","subjectScheme":"Fields of Science and Technology (FOS)"}],"contributors":[],"dates":[{"date":"2026-02-24T12:48:07Z","dateType":"Submitted","dateInformation":"v1"},{"date":"2026-02-25T01:45:51Z","dateType":"Updated","dateInformation":"v1"},{"date":"2026-02","dateType":"Available","dateInformation":"v1"},{"date":"2026","dateType":"Issued"}],"language":null,"types":{"schemaOrg":"CreativeWork","resourceTypeGeneral":"Preprint","citeproc":"article","bibtex":"misc","ris":"GEN","resourceType":"Article"},"relatedIdentifiers":[],"relatedItems":[],"sizes":[],"formats":[],"version":"1","rightsList":[{"rightsUri":"http://arxiv.org/licenses/nonexclusive-distrib/1.0/","rights":"arXiv.org perpetual, non-exclusive license"}],"descriptions":[{"descriptionType":"Abstract","description":"Coherent spin resonance techniques, such as nuclear and electron spin resonance spectroscopy, have revolutionized non-invasive imaging by providing spectrally resolved information about spin dynamics. Motivated by the recent emergence of electron microscopy methods capable of sensing microwave-excitations, we establish a theoretical framework for Spin Resonance Spectroscopy (SRS) in transmission electron microscopy (TEM). This technique combines microwave pump fields with focused electron probe beams to enable state-selective spin imaging at the atomic scale. Using scattering theory, we model the interaction between free-space electrons and electron spin systems, capturing both elastic and inelastic processes. The strongest effect of the spin system on the free electron is a magnetic phase shift. Our simulations demonstrate that phase shifts from individual electron spins are detectable in both image mode and diffraction mode. In principle, differential measurements under microwave control allow the extraction of local resonance frequencies that are influenced by the surrounding spin environment. By evaluating the Classical Fisher Information (CFI), we identify imaging conditions that maximize the signal-to-noise ratio (SNR), showing how defocus and beam width affect the measurement sensitivity. These findings establish a foundation for integrating SRS with high-resolution TEM, bridging spin spectroscopy and atomic-scale imaging, and enabling new capabilities in quantum spin research and nanoscale materials characterization."},{"descriptionType":"Other","description":"12 pages, 3 figures"}],"geoLocations":[],"fundingReferences":[],"url":"https://arxiv.org/abs/2602.20852","contentUrl":null,"metadataVersion":0,"schemaVersion":"http://datacite.org/schema/kernel-4","source":"mds","isActive":true,"state":"findable","reason":null,"viewCount":0,"downloadCount":0,"referenceCount":0,"citationCount":0,"partCount":0,"partOfCount":0,"versionCount":0,"versionOfCount":0,"created":"2026-02-25T03:00:05Z","registered":"2026-02-25T03:00:06Z","published":null,"updated":"2026-02-25T03:00:06Z"},"relationships":{"client":{"data":{"id":"arxiv.content","type":"clients"}}}},{"id":"10.48550/arxiv.2602.20851","type":"dois","attributes":{"doi":"10.48550/arxiv.2602.20851","identifiers":[{"identifier":"2602.20851","identifierType":"arXiv"}],"creators":[{"nameType":"Personal","givenName":"Ran","familyName":"Zhang","name":"Zhang, Ran","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Xuanhua","familyName":"He","name":"He, Xuanhua","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Liu","familyName":"Liu","name":"Liu, Liu","affiliation":[],"nameIdentifiers":[]}],"titles":[{"title":"Hybrid Fusion: One-Minute Efficient Training for Zero-Shot Cross-Domain Image Fusion"}],"publisher":"arXiv","container":{},"publicationYear":2026,"subjects":[{"subject":"Computer Vision and Pattern Recognition (cs.CV)","lang":"en","subjectScheme":"arXiv"},{"subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"},{"schemeUri":"http://www.oecd.org/science/inno/38235147.pdf","subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"}],"contributors":[],"dates":[{"date":"2026-02-24T12:47:53Z","dateType":"Submitted","dateInformation":"v1"},{"date":"2026-02-25T01:45:49Z","dateType":"Updated","dateInformation":"v1"},{"date":"2026-02","dateType":"Available","dateInformation":"v1"},{"date":"2026","dateType":"Issued"}],"language":null,"types":{"schemaOrg":"CreativeWork","resourceTypeGeneral":"Preprint","citeproc":"article","bibtex":"misc","ris":"GEN","resourceType":"Article"},"relatedIdentifiers":[],"relatedItems":[],"sizes":[],"formats":[],"version":"1","rightsList":[{"rightsIdentifierScheme":"SPDX","rightsUri":"https://creativecommons.org/licenses/by-sa/4.0/legalcode","schemeUri":"https://spdx.org/licenses/","rights":"Creative Commons Attribution Share Alike 4.0 International","rightsIdentifier":"cc-by-sa-4.0"}],"descriptions":[{"descriptionType":"Abstract","description":"Image fusion seeks to integrate complementary information from multiple sources into a single, superior image. While traditional methods are fast, they lack adaptability and performance. Conversely, deep learning approaches achieve state-of-the-art (SOTA) results but suffer from critical inefficiencies: their reliance on slow, resource-intensive, patch-based training introduces a significant gap with full-resolution inference. We propose a novel hybrid framework that resolves this trade-off. Our method utilizes a learnable U-Net to generate a dynamic guidance map that directs a classic, fixed Laplacian pyramid fusion kernel. This decoupling of policy learning from pixel synthesis enables remarkably efficient full-resolution training, eliminating the train-inference gap. Consequently, our model achieves SOTA-comparable performance in about one minute on a RTX 4090 or two minutes on a consumer laptop GPU from scratch without any external model and demonstrates powerful zero-shot generalization across diverse tasks, from infrared-visible to medical imaging. By design, the fused output is linearly constructed solely from source information, ensuring high faithfulness for critical applications. The codes are available at https://github.com/Zirconium233/HybridFusion"}],"geoLocations":[],"fundingReferences":[],"url":"https://arxiv.org/abs/2602.20851","contentUrl":null,"metadataVersion":0,"schemaVersion":"http://datacite.org/schema/kernel-4","source":"mds","isActive":true,"state":"findable","reason":null,"viewCount":0,"downloadCount":0,"referenceCount":0,"citationCount":0,"partCount":0,"partOfCount":0,"versionCount":0,"versionOfCount":0,"created":"2026-02-25T03:00:04Z","registered":"2026-02-25T03:00:05Z","published":null,"updated":"2026-02-25T03:00:05Z"},"relationships":{"client":{"data":{"id":"arxiv.content","type":"clients"}}}},{"id":"10.48550/arxiv.2602.20850","type":"dois","attributes":{"doi":"10.48550/arxiv.2602.20850","identifiers":[{"identifier":"2602.20850","identifierType":"arXiv"}],"creators":[{"nameType":"Personal","givenName":"Lei","familyName":"Ye","name":"Ye, Lei","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Haibo","familyName":"Gao","name":"Gao, Haibo","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Huaiguang","familyName":"Yang","name":"Yang, Huaiguang","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Peng","familyName":"Xu","name":"Xu, Peng","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Haoyu","familyName":"Wang","name":"Wang, Haoyu","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Tie","familyName":"Liu","name":"Liu, Tie","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Junqi","familyName":"Shan","name":"Shan, Junqi","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Zongquan","familyName":"Deng","name":"Deng, Zongquan","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Liang","familyName":"Ding","name":"Ding, Liang","affiliation":[],"nameIdentifiers":[]}],"titles":[{"title":"KCFRC: Kinematic Collision-Aware Foothold Reachability Criteria for Legged Locomotion"}],"publisher":"arXiv","container":{},"publicationYear":2026,"subjects":[{"subject":"Robotics (cs.RO)","lang":"en","subjectScheme":"arXiv"},{"subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"},{"schemeUri":"http://www.oecd.org/science/inno/38235147.pdf","subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"}],"contributors":[],"dates":[{"date":"2026-02-24T12:46:34Z","dateType":"Submitted","dateInformation":"v1"},{"date":"2026-02-25T01:45:46Z","dateType":"Updated","dateInformation":"v1"},{"date":"2026-02","dateType":"Available","dateInformation":"v1"},{"date":"2026","dateType":"Issued"}],"language":null,"types":{"schemaOrg":"CreativeWork","resourceTypeGeneral":"Preprint","citeproc":"article","bibtex":"misc","ris":"GEN","resourceType":"Article"},"relatedIdentifiers":[{"relationType":"IsVersionOf","relatedIdentifier":"10.1109/tie.2025.3616420","relatedIdentifierType":"DOI"}],"relatedItems":[],"sizes":[],"formats":[],"version":"1","rightsList":[{"rightsUri":"http://arxiv.org/licenses/nonexclusive-distrib/1.0/","rights":"arXiv.org perpetual, non-exclusive license"}],"descriptions":[{"descriptionType":"Abstract","description":"Legged robots face significant challenges in navigating complex environments, as they require precise real-time decisions for foothold selection and contact planning. While existing research has explored methods to select footholds based on terrain geometry or kinematics, a critical gap remains: few existing methods efficiently validate the existence of a non-collision swing trajectory. This paper addresses this gap by introducing KCFRC, a novel approach for efficient foothold reachability analysis. We first formally define the foothold reachability problem and establish a sufficient condition for foothold reachability. Based on this condition, we develop the KCFRC algorithm, which enables robots to validate foothold reachability in real time. Our experimental results demonstrate that KCFRC achieves remarkable time efficiency, completing foothold reachability checks for a single leg across 900 potential footholds in an average of 2 ms. Furthermore, we show that KCFRC can accelerate trajectory optimization and is particularly beneficial for contact planning in confined spaces, enhancing the adaptability and robustness of legged robots in challenging environments."}],"geoLocations":[],"fundingReferences":[],"url":"https://arxiv.org/abs/2602.20850","contentUrl":null,"metadataVersion":0,"schemaVersion":"http://datacite.org/schema/kernel-4","source":"mds","isActive":true,"state":"findable","reason":null,"viewCount":0,"downloadCount":0,"referenceCount":0,"citationCount":0,"partCount":0,"partOfCount":0,"versionCount":0,"versionOfCount":1,"created":"2026-02-25T03:00:02Z","registered":"2026-02-25T03:00:03Z","published":null,"updated":"2026-02-25T03:00:03Z"},"relationships":{"client":{"data":{"id":"arxiv.content","type":"clients"}}}},{"id":"10.48550/arxiv.2602.20848","type":"dois","attributes":{"doi":"10.48550/arxiv.2602.20848","identifiers":[{"identifier":"2602.20848","identifierType":"arXiv"}],"creators":[{"nameType":"Personal","givenName":"Andres","familyName":"Stump","name":"Stump, Andres","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Jeremy R.","familyName":"Green","name":"Green, Jeremy R.","affiliation":[],"nameIdentifiers":[]}],"titles":[{"title":"Importance of local tetraquark operators for $T_{cc}(3875)^+$"}],"publisher":"arXiv","container":{},"publicationYear":2026,"subjects":[{"subject":"High Energy Physics - Lattice (hep-lat)","lang":"en","subjectScheme":"arXiv"},{"subject":"FOS: Physical sciences","subjectScheme":"Fields of Science and Technology (FOS)"},{"schemeUri":"http://www.oecd.org/science/inno/38235147.pdf","subject":"FOS: Physical sciences","subjectScheme":"Fields of Science and Technology (FOS)"}],"contributors":[],"dates":[{"date":"2026-02-24T12:42:38Z","dateType":"Submitted","dateInformation":"v1"},{"date":"2026-02-25T01:45:45Z","dateType":"Updated","dateInformation":"v1"},{"date":"2026-02","dateType":"Available","dateInformation":"v1"},{"date":"2026","dateType":"Issued"}],"language":null,"types":{"schemaOrg":"CreativeWork","resourceTypeGeneral":"Preprint","citeproc":"article","bibtex":"misc","ris":"GEN","resourceType":"Article"},"relatedIdentifiers":[],"relatedItems":[],"sizes":[],"formats":[],"version":"1","rightsList":[{"rightsIdentifierScheme":"SPDX","rightsUri":"https://creativecommons.org/licenses/by-nc-nd/4.0/legalcode","schemeUri":"https://spdx.org/licenses/","rights":"Creative Commons Attribution Non Commercial No Derivatives 4.0 International","rightsIdentifier":"cc-by-nc-nd-4.0"}],"descriptions":[{"descriptionType":"Abstract","description":"The doubly charmed tetraquark $T_{cc}(3875)^+$ observed at LHCb has attracted considerable interest in recent years. To accurately determine its finite-volume spectrum, a variational analysis using a large basis of operators, including bilocal scattering operators, but also local tetraquark operators, should be employed. Using Wilson-clover fermions at the $SU(3)$-flavour-symmetric point, we investigated the importance of local tetraquark operators for the $T_{cc}$ spectrum by adding them to a large basis of bilocal $DD^*$ and $D^*D^*$ scattering operators. We performed this calculation using the distillation framework combined with a position-space sampling method that we recently developed. This method makes local tetraquark operators affordable in distillation. Upon including local tetraquark operators, we observe significant shifts in the estimates of several energy levels. Finally, we show the effect of these shifts on the $DD^*$ scattering phase shifts obtained from a single-channel $s$-wave Lüscher analysis."},{"descriptionType":"Other","description":"10 pages, 3 figures, talk presented at the 42nd International Symposium on Lattice Field Theory (LATTICE2025), 2-8 November 2025, Tata Institute of Fundamental Research, Mumbai, India"}],"geoLocations":[],"fundingReferences":[],"url":"https://arxiv.org/abs/2602.20848","contentUrl":null,"metadataVersion":0,"schemaVersion":"http://datacite.org/schema/kernel-4","source":"mds","isActive":true,"state":"findable","reason":null,"viewCount":0,"downloadCount":0,"referenceCount":0,"citationCount":0,"partCount":0,"partOfCount":0,"versionCount":0,"versionOfCount":0,"created":"2026-02-25T02:59:59Z","registered":"2026-02-25T03:00:00Z","published":null,"updated":"2026-02-25T03:00:00Z"},"relationships":{"client":{"data":{"id":"arxiv.content","type":"clients"}}}},{"id":"10.48550/arxiv.2602.20846","type":"dois","attributes":{"doi":"10.48550/arxiv.2602.20846","identifiers":[{"identifier":"2602.20846","identifierType":"arXiv"}],"creators":[{"nameType":"Personal","givenName":"Yuki","familyName":"Nakamura","name":"Nakamura, Yuki","affiliation":[],"nameIdentifiers":[]}],"titles":[{"title":"Body-Reservoir Governance in Repeated Games: Embodied Decision-Making, Dynamic Sentinel Adaptation, and Complexity-Regularized Optimization"}],"publisher":"arXiv","container":{},"publicationYear":2026,"subjects":[{"subject":"Computer Science and Game Theory (cs.GT)","lang":"en","subjectScheme":"arXiv"},{"subject":"Multiagent Systems (cs.MA)","lang":"en","subjectScheme":"arXiv"},{"subject":"Neural and Evolutionary Computing (cs.NE)","lang":"en","subjectScheme":"arXiv"},{"subject":"Adaptation and Self-Organizing Systems (nlin.AO)","lang":"en","subjectScheme":"arXiv"},{"subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"},{"schemeUri":"http://www.oecd.org/science/inno/38235147.pdf","subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"},{"subject":"FOS: Physical sciences","subjectScheme":"Fields of Science and Technology (FOS)"},{"schemeUri":"http://www.oecd.org/science/inno/38235147.pdf","subject":"FOS: Physical sciences","subjectScheme":"Fields of Science and Technology (FOS)"},{"subject":"I.2.11; J.4","lang":"en","subjectScheme":"ACM"},{"subject":"91A20, 68T42, 37N40 (91A20 = Repeated games, 68T42 = Agent technology, 37N40 = Dynamical systems in optimization)","lang":"en","subjectScheme":"MSC"}],"contributors":[],"dates":[{"date":"2026-02-24T12:36:41Z","dateType":"Submitted","dateInformation":"v1"},{"date":"2026-02-25T01:45:42Z","dateType":"Updated","dateInformation":"v1"},{"date":"2026-02","dateType":"Available","dateInformation":"v1"},{"date":"2026","dateType":"Issued"}],"language":null,"types":{"schemaOrg":"CreativeWork","resourceTypeGeneral":"Preprint","citeproc":"article","bibtex":"misc","ris":"GEN","resourceType":"Article"},"relatedIdentifiers":[],"relatedItems":[],"sizes":[],"formats":[],"version":"1","rightsList":[{"rightsUri":"http://arxiv.org/licenses/nonexclusive-distrib/1.0/","rights":"arXiv.org perpetual, non-exclusive license"}],"descriptions":[{"descriptionType":"Abstract","description":"Standard game theory explains cooperation in repeated games through conditional strategies such as Tit-for-Tat (TfT), but these require continuous computation that imposes physical costs on embodied agents. We propose a three-layer Body-Reservoir Governance (BRG) architecture: (1) a body reservoir (echo state network) whose $d$-dimensional state performs implicit inference over interaction history, serving as both decision-maker and anomaly detector, (2) a cognitive filter providing costly strategic tools activated on demand, and (3) a metacognitive governance layer with receptivity parameter $α\\in [0,1]$. At full body governance ($α=1$), closed-loop dynamics satisfy a self-consistency equation: cooperation is expressed as the reservoir's fixed point, not computed. Strategy complexity cost is defined as the KL divergence between the reservoir's state distribution and its habituated baseline. Body governance reduces this cost, with action variance decreasing up to $1600\\times$ with dimension $d$. A dynamic sentinel generates a composite discomfort signal from the reservoir's own state, driving adaptive $α(t)$: near baseline during cooperation, rapidly dropping upon defection to activate cognitive retaliation. Overriding the body incurs thermodynamic cost proportional to internal state distortion. The sentinel achieves the highest payoff across all conditions, outperforming static body governance, TfT, and EMA baselines. A dimension sweep ($d \\in \\{5,\\ldots,100\\}$) shows implicit inference scales with bodily richness ($23\\times$ to $1600\\times$ variance reduction), attributable to reservoir dynamics. A phase diagram in $(d, τ_{\\mathrm{env}})$ space reveals governance regime transitions near $d \\approx 20$. The framework reinterprets cooperation as the minimum-dissipation response of an adapted dynamical system -- emergent from embodied dynamics rather than computed."},{"descriptionType":"Other","description":"44 pages, 9 figures, 2 tables"}],"geoLocations":[],"fundingReferences":[],"url":"https://arxiv.org/abs/2602.20846","contentUrl":null,"metadataVersion":0,"schemaVersion":"http://datacite.org/schema/kernel-4","source":"mds","isActive":true,"state":"findable","reason":null,"viewCount":0,"downloadCount":0,"referenceCount":0,"citationCount":0,"partCount":0,"partOfCount":0,"versionCount":0,"versionOfCount":0,"created":"2026-02-25T02:59:56Z","registered":"2026-02-25T02:59:57Z","published":null,"updated":"2026-02-25T02:59:57Z"},"relationships":{"client":{"data":{"id":"arxiv.content","type":"clients"}}}},{"id":"10.48550/arxiv.2602.20843","type":"dois","attributes":{"doi":"10.48550/arxiv.2602.20843","identifiers":[{"identifier":"2602.20843","identifierType":"arXiv"}],"creators":[{"nameType":"Personal","givenName":"M.","familyName":"Ali-Akbari","name":"Ali-Akbari, M.","affiliation":[],"nameIdentifiers":[]}],"titles":[{"title":"HTEE vs. Pseudo-Entropy in Magnetic Fields"}],"publisher":"arXiv","container":{},"publicationYear":2026,"subjects":[{"subject":"High Energy Physics - Theory (hep-th)","lang":"en","subjectScheme":"arXiv"},{"subject":"FOS: Physical sciences","subjectScheme":"Fields of Science and Technology (FOS)"},{"schemeUri":"http://www.oecd.org/science/inno/38235147.pdf","subject":"FOS: Physical sciences","subjectScheme":"Fields of Science and Technology (FOS)"}],"contributors":[],"dates":[{"date":"2026-02-24T12:32:28Z","dateType":"Submitted","dateInformation":"v1"},{"date":"2026-02-25T01:45:25Z","dateType":"Updated","dateInformation":"v1"},{"date":"2026-02","dateType":"Available","dateInformation":"v1"},{"date":"2026","dateType":"Issued"}],"language":null,"types":{"schemaOrg":"CreativeWork","resourceTypeGeneral":"Preprint","citeproc":"article","bibtex":"misc","ris":"GEN","resourceType":"Article"},"relatedIdentifiers":[],"relatedItems":[],"sizes":[],"formats":[],"version":"1","rightsList":[{"rightsUri":"http://arxiv.org/licenses/nonexclusive-distrib/1.0/","rights":"arXiv.org perpetual, non-exclusive license"}],"descriptions":[{"descriptionType":"Abstract","description":"We compare the holographic timelike entanglement entropy with the pseudo-entropy arising from a two-qubit quantum mechanical system. In this model, we consider transitions from an initial thermal state to a final thermal state at fixed temperature under the influence of an external magnetic field. Our findings highlight significant discrepancies between the two quantities, which display markedly different behavior."},{"descriptionType":"Other","description":"10 pages. 1 figure"}],"geoLocations":[],"fundingReferences":[],"url":"https://arxiv.org/abs/2602.20843","contentUrl":null,"metadataVersion":0,"schemaVersion":"http://datacite.org/schema/kernel-4","source":"mds","isActive":true,"state":"findable","reason":null,"viewCount":0,"downloadCount":0,"referenceCount":0,"citationCount":0,"partCount":0,"partOfCount":0,"versionCount":0,"versionOfCount":0,"created":"2026-02-25T02:59:52Z","registered":"2026-02-25T02:59:53Z","published":null,"updated":"2026-02-25T02:59:53Z"},"relationships":{"client":{"data":{"id":"arxiv.content","type":"clients"}}}},{"id":"10.48550/arxiv.2602.20842","type":"dois","attributes":{"doi":"10.48550/arxiv.2602.20842","identifiers":[{"identifier":"2602.20842","identifierType":"arXiv"}],"creators":[{"nameType":"Personal","givenName":"Marvin","familyName":"Dorn","name":"Dorn, Marvin","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Julian","familyName":"Hoffmann","name":"Hoffmann, Julian","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"André","familyName":"Weber","name":"Weber, André","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Veit","familyName":"Hagenmeyer","name":"Hagenmeyer, Veit","affiliation":[],"nameIdentifiers":[]}],"titles":[{"title":"Fast-Response Balancing Capacity of Alkaline Electrolyzers"}],"publisher":"arXiv","container":{},"publicationYear":2026,"subjects":[{"subject":"Systems and Control (eess.SY)","lang":"en","subjectScheme":"arXiv"},{"subject":"FOS: Electrical engineering, electronic engineering, information engineering","subjectScheme":"Fields of Science and Technology (FOS)"},{"schemeUri":"http://www.oecd.org/science/inno/38235147.pdf","subject":"FOS: Electrical engineering, electronic engineering, information engineering","subjectScheme":"Fields of Science and Technology (FOS)"}],"contributors":[],"dates":[{"date":"2026-02-24T12:31:08Z","dateType":"Submitted","dateInformation":"v1"},{"date":"2026-02-25T01:45:24Z","dateType":"Updated","dateInformation":"v1"},{"date":"2026-02","dateType":"Available","dateInformation":"v1"},{"date":"2026","dateType":"Issued"}],"language":null,"types":{"schemaOrg":"CreativeWork","resourceTypeGeneral":"Preprint","citeproc":"article","bibtex":"misc","ris":"GEN","resourceType":"Article"},"relatedIdentifiers":[],"relatedItems":[],"sizes":[],"formats":[],"version":"1","rightsList":[{"rightsUri":"http://arxiv.org/licenses/nonexclusive-distrib/1.0/","rights":"arXiv.org perpetual, non-exclusive license"}],"descriptions":[{"descriptionType":"Abstract","description":"The energy transition requires flexible technologies to maintain grid stability, and electrolyzers are playing an increasingly important role in meeting this need. While previous studies often question the dynamic capabilities of large-scale alkaline electrolyzer systems, we assess their potential to provide balancing services using real manufacturer data. Unlike common approaches, we propose the decoupling between the total electrolyzer power and a smaller fractions of power actually offered on balancing markets. Adapting an existing methodology, we analyze alkaline electrolyzer systems and extend the assessment to Germany and Europe. Our results show that large-scale electrolyzers are technically capable of delivering fast-response balancing services, with significantly lower dynamic requirements than previously assumed. The planned electrolyzers in Germany could cover the entire balancing capacity market, potentially saving around 13 % of their electricity costs, excluding energy balancing revenues. The decoupling also resolves part of the trade-off for electrolyzer manufacturers, enabling the design of less dynamic but more stable systems."}],"geoLocations":[],"fundingReferences":[],"url":"https://arxiv.org/abs/2602.20842","contentUrl":null,"metadataVersion":0,"schemaVersion":"http://datacite.org/schema/kernel-4","source":"mds","isActive":true,"state":"findable","reason":null,"viewCount":0,"downloadCount":0,"referenceCount":0,"citationCount":0,"partCount":0,"partOfCount":0,"versionCount":0,"versionOfCount":0,"created":"2026-02-25T02:59:50Z","registered":"2026-02-25T02:59:51Z","published":null,"updated":"2026-02-25T02:59:51Z"},"relationships":{"client":{"data":{"id":"arxiv.content","type":"clients"}}}},{"id":"10.48550/arxiv.2602.20838","type":"dois","attributes":{"doi":"10.48550/arxiv.2602.20838","identifiers":[{"identifier":"2602.20838","identifierType":"arXiv"}],"creators":[{"nameType":"Personal","givenName":"Saumen","familyName":"Acharjee","name":"Acharjee, Saumen","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Aklanta","familyName":"Dihingia","name":"Dihingia, Aklanta","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Nayanav","familyName":"Sonowal","name":"Sonowal, Nayanav","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Abyoy Anan","familyName":"Kashyap","name":"Kashyap, Abyoy Anan","affiliation":[],"nameIdentifiers":[]}],"titles":[{"title":"Unconventional spin valve effect in altermagnets induced by Rashba spin orbit coupling and triplet superconductivity"}],"publisher":"arXiv","container":{},"publicationYear":2026,"subjects":[{"subject":"Superconductivity (cond-mat.supr-con)","lang":"en","subjectScheme":"arXiv"},{"subject":"Mesoscale and Nanoscale Physics (cond-mat.mes-hall)","lang":"en","subjectScheme":"arXiv"},{"subject":"FOS: Physical sciences","subjectScheme":"Fields of Science and Technology (FOS)"},{"schemeUri":"http://www.oecd.org/science/inno/38235147.pdf","subject":"FOS: Physical sciences","subjectScheme":"Fields of Science and Technology (FOS)"}],"contributors":[],"dates":[{"date":"2026-02-24T12:22:27Z","dateType":"Submitted","dateInformation":"v1"},{"date":"2026-02-25T01:44:54Z","dateType":"Updated","dateInformation":"v1"},{"date":"2026-02","dateType":"Available","dateInformation":"v1"},{"date":"2026","dateType":"Issued"}],"language":null,"types":{"schemaOrg":"CreativeWork","resourceTypeGeneral":"Preprint","citeproc":"article","bibtex":"misc","ris":"GEN","resourceType":"Article"},"relatedIdentifiers":[],"relatedItems":[],"sizes":[],"formats":[],"version":"1","rightsList":[{"rightsIdentifierScheme":"SPDX","rightsUri":"https://creativecommons.org/licenses/by/4.0/legalcode","schemeUri":"https://spdx.org/licenses/","rights":"Creative Commons Attribution 4.0 International","rightsIdentifier":"cc-by-4.0"}],"descriptions":[{"descriptionType":"Abstract","description":"We theoretically investigate spin dependent transport in altermagnet/triplet superconductor/altermagnet (AM/TSC/AM) junctions in the presence of interfacial Rashba spin orbit coupling (RSOC). Within a microscopic Bogoliubov de Gennes scattering formalism, we compute angle and energy resolved conductance, spin polarization, zero bias response, and tunneling magnetoresistance (TMR) for nodal $p_x$ and chiral $p_x+ip_y$ superconductors. Although altermagnets carry no net magnetization, the momentum dependent spin splitting, combined with RSOC, enables a pronounced spin valve effect without ferromagnetic electrodes. We show that conductance, spin polarization, and TMR exhibit distinct and robust fingerprints of the triplet pairing symmetry. For nodal $p_x$ superconductor, sign change induced surface Andreev bound states dominate subgap transport, producing strongly anisotropic conductance, giant zero bias spin polarization, and a monotonic enhancement of TMR with increasing RSOC. In contrast, the chiral $p_x+ip_y$ state exhibits smoother conductance and polarization profiles governed by topological edge modes, resulting in broader, lobe like TMR patterns with weaker sensitivity to interface transparency. Moreover, RSOC can acts as an electrically tunable spin-mixing knob, while the barrier strength controls coherence and energy selectivity, together enabling large, symmetry controlled spin filtering and magnetoresistance. Our results establish AM/TSC/AM junctions as a symmetry sensitive transport platform for realizing electrically tunable spin valve functionality and probing triplet pairing without ferromagnetic components."},{"descriptionType":"Other","description":"16 pages 10 figures"}],"geoLocations":[],"fundingReferences":[],"url":"https://arxiv.org/abs/2602.20838","contentUrl":null,"metadataVersion":0,"schemaVersion":"http://datacite.org/schema/kernel-4","source":"mds","isActive":true,"state":"findable","reason":null,"viewCount":0,"downloadCount":0,"referenceCount":0,"citationCount":0,"partCount":0,"partOfCount":0,"versionCount":0,"versionOfCount":0,"created":"2026-02-25T02:59:45Z","registered":"2026-02-25T02:59:46Z","published":null,"updated":"2026-02-25T02:59:46Z"},"relationships":{"client":{"data":{"id":"arxiv.content","type":"clients"}}}},{"id":"10.48550/arxiv.2602.20837","type":"dois","attributes":{"doi":"10.48550/arxiv.2602.20837","identifiers":[{"identifier":"2602.20837","identifierType":"arXiv"}],"creators":[{"nameType":"Personal","givenName":"Samuel","familyName":"Martin-Gutierrez","name":"Martin-Gutierrez, Samuel","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Juan C.","familyName":"Losada","name":"Losada, Juan C.","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Rosa M.","familyName":"Benito","name":"Benito, Rosa M.","affiliation":[],"nameIdentifiers":[]}],"titles":[{"title":"Recurrent patterns of user behavior in different electoral campaigns: A Twitter analysis of the Spanish general elections of 2015 and 2016"}],"publisher":"arXiv","container":{},"publicationYear":2026,"subjects":[{"subject":"Physics and Society (physics.soc-ph)","lang":"en","subjectScheme":"arXiv"},{"subject":"FOS: Physical sciences","subjectScheme":"Fields of Science and Technology (FOS)"},{"schemeUri":"http://www.oecd.org/science/inno/38235147.pdf","subject":"FOS: Physical sciences","subjectScheme":"Fields of Science and Technology (FOS)"}],"contributors":[],"dates":[{"date":"2026-02-24T12:22:07Z","dateType":"Submitted","dateInformation":"v1"},{"date":"2026-02-25T01:44:53Z","dateType":"Updated","dateInformation":"v1"},{"date":"2026-02","dateType":"Available","dateInformation":"v1"},{"date":"2026","dateType":"Issued"}],"language":null,"types":{"schemaOrg":"CreativeWork","resourceTypeGeneral":"Preprint","citeproc":"article","bibtex":"misc","ris":"GEN","resourceType":"Article"},"relatedIdentifiers":[{"relationType":"IsVersionOf","relatedIdentifier":"10.1155/2018/2413481","relatedIdentifierType":"DOI"}],"relatedItems":[],"sizes":[],"formats":[],"version":"1","rightsList":[{"rightsIdentifierScheme":"SPDX","rightsUri":"https://creativecommons.org/licenses/by/4.0/legalcode","schemeUri":"https://spdx.org/licenses/","rights":"Creative Commons Attribution 4.0 International","rightsIdentifier":"cc-by-4.0"}],"descriptions":[{"descriptionType":"Abstract","description":"We have retrieved and analyzed several millions of Twitter messages corresponding to the Spanish General elections held on the 20th of December 2015 and repeated on the 26th of June 2016. The availability of data from two electoral campaigns that are very close in time allows us to compare collective behaviors of two analogous social systems with a similar context. By computing and analyzing the time series of daily activity, we have found a significant linear correlation between both elections. Additionally, we have revealed that the daily number of tweets, retweets and mentions follow a power law with respect to the number of unique users that take part in the conversation. Furthermore, we have verified that the topologies of the networks of mentions and retweets do not change from one election to the other, indicating that their underlying dynamics are robust in the face of a change in social context. Hence, in the light of our results, there are several recurrent collective behavioral patterns that exhibit similar and consistent properties in different electoral campaigns."}],"geoLocations":[],"fundingReferences":[],"url":"https://arxiv.org/abs/2602.20837","contentUrl":null,"metadataVersion":0,"schemaVersion":"http://datacite.org/schema/kernel-4","source":"mds","isActive":true,"state":"findable","reason":null,"viewCount":0,"downloadCount":0,"referenceCount":0,"citationCount":0,"partCount":0,"partOfCount":0,"versionCount":0,"versionOfCount":1,"created":"2026-02-25T02:59:43Z","registered":"2026-02-25T02:59:44Z","published":null,"updated":"2026-02-25T02:59:44Z"},"relationships":{"client":{"data":{"id":"arxiv.content","type":"clients"}}}},{"id":"10.48550/arxiv.2602.20836","type":"dois","attributes":{"doi":"10.48550/arxiv.2602.20836","identifiers":[{"identifier":"2602.20836","identifierType":"arXiv"}],"creators":[{"nameType":"Personal","givenName":"Yanbin","familyName":"Zhu","name":"Zhu, Yanbin","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Xiaomeng","familyName":"Jiang","name":"Jiang, Xiaomeng","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Yong","familyName":"Li","name":"Li, Yong","affiliation":[],"nameIdentifiers":[]}],"titles":[{"title":"Onsager--Machlup Functional for Fractional Stochastic Newton Dynamics with Time-Dependent Noise Intensities"}],"publisher":"arXiv","container":{},"publicationYear":2026,"subjects":[{"subject":"Dynamical Systems (math.DS)","lang":"en","subjectScheme":"arXiv"},{"subject":"FOS: Mathematics","subjectScheme":"Fields of Science and Technology (FOS)"},{"schemeUri":"http://www.oecd.org/science/inno/38235147.pdf","subject":"FOS: Mathematics","subjectScheme":"Fields of Science and Technology (FOS)"},{"subject":"60H10, 60G22, 60F10","lang":"en","subjectScheme":"MSC"}],"contributors":[],"dates":[{"date":"2026-02-24T12:19:31Z","dateType":"Submitted","dateInformation":"v1"},{"date":"2026-02-25T01:44:50Z","dateType":"Updated","dateInformation":"v1"},{"date":"2026-02","dateType":"Available","dateInformation":"v1"},{"date":"2026","dateType":"Issued"}],"language":null,"types":{"schemaOrg":"CreativeWork","resourceTypeGeneral":"Preprint","citeproc":"article","bibtex":"misc","ris":"GEN","resourceType":"Article"},"relatedIdentifiers":[],"relatedItems":[],"sizes":[],"formats":[],"version":"1","rightsList":[{"rightsIdentifierScheme":"SPDX","rightsUri":"https://creativecommons.org/licenses/by/4.0/legalcode","schemeUri":"https://spdx.org/licenses/","rights":"Creative Commons Attribution 4.0 International","rightsIdentifier":"cc-by-4.0"}],"descriptions":[{"descriptionType":"Abstract","description":"In this paper, we derive the Onsager--Machlup functional for a second-order Newton-type stochastic system driven by time-dependent fractional noise, \\[\n X_t'' = f_t(X_t, X_t') + σ_t \\,ξ_t^{H}, \\] where \\( H \\in (1/4,1) \\). The analysis relies on applying a Girsanov transformation to the non-degenerate components and evaluating the limiting conditional expectation associated with the noise term, for which the stochastic Fubini theorem plays a crucial role. To illustrate the applicability of the result, we study two mechanical systems perturbed by noise and provide supporting numerical simulations."},{"descriptionType":"Other","description":"10 figures. arXiv admin note: text overlap with arXiv:2511.09300"}],"geoLocations":[],"fundingReferences":[],"url":"https://arxiv.org/abs/2602.20836","contentUrl":null,"metadataVersion":0,"schemaVersion":"http://datacite.org/schema/kernel-4","source":"mds","isActive":true,"state":"findable","reason":null,"viewCount":0,"downloadCount":0,"referenceCount":0,"citationCount":0,"partCount":0,"partOfCount":0,"versionCount":0,"versionOfCount":0,"created":"2026-02-25T02:59:42Z","registered":"2026-02-25T02:59:43Z","published":null,"updated":"2026-02-25T02:59:43Z"},"relationships":{"client":{"data":{"id":"arxiv.content","type":"clients"}}}},{"id":"10.48550/arxiv.2602.20834","type":"dois","attributes":{"doi":"10.48550/arxiv.2602.20834","identifiers":[{"identifier":"2602.20834","identifierType":"arXiv"}],"creators":[{"nameType":"Personal","givenName":"Nils Lid","familyName":"Hjort","name":"Hjort, Nils Lid","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Tore","familyName":"Schweder","name":"Schweder, Tore","affiliation":[],"nameIdentifiers":[]}],"titles":[{"title":"Confidence Distributions and Related Themes"}],"publisher":"arXiv","container":{},"publicationYear":2026,"subjects":[{"subject":"Methodology (stat.ME)","lang":"en","subjectScheme":"arXiv"},{"subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"},{"schemeUri":"http://www.oecd.org/science/inno/38235147.pdf","subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"}],"contributors":[],"dates":[{"date":"2026-02-24T12:18:48Z","dateType":"Submitted","dateInformation":"v1"},{"date":"2026-02-25T01:44:48Z","dateType":"Updated","dateInformation":"v1"},{"date":"2026-02","dateType":"Available","dateInformation":"v1"},{"date":"2026","dateType":"Issued"}],"language":null,"types":{"schemaOrg":"CreativeWork","resourceTypeGeneral":"Preprint","citeproc":"article","bibtex":"misc","ris":"GEN","resourceType":"Article"},"relatedIdentifiers":[],"relatedItems":[],"sizes":[],"formats":[],"version":"1","rightsList":[{"rightsUri":"http://arxiv.org/licenses/nonexclusive-distrib/1.0/","rights":"arXiv.org perpetual, non-exclusive license"}],"descriptions":[{"descriptionType":"Abstract","description":"This is the guest editors' general introduction to a Special Issue of the Journal of Statistical Planning and Inference, dedicated to confidence distributions and related themes. Confidence distributions (CDs) are distributions for parameters of interest, constructed via a statistical model after analysing the data. As such they serve the same purpose for the frequentist statisticians as the posterior distributions for the Bayesians. There have been several attempts in the literature to put up a clear theory for such confidence distributions, from Fisher's fiducial inference and onwards. There are certain obstacles and difficulties involved in these attempts, both conceptually and operationally, which have contributed to the CDs being slow in entering statistical mainstream. Recently there is a renewed surge of interest in CDs and various related themes, however, reflected in both series of new methodological research, advanced applications to substantive sciences, and dissemination and communication via workshops and conferences. The present special issue of the JSPI is a collection of papers emanating from the {\\it Inference With Confidence} workshop in Oslo, May 2015. Several of the papers appearing here were first presented at that workshop. The present collection includes however also new research papers from other scholars in the field."},{"descriptionType":"Other","description":"26 pages, 5 figures. Invited introduction for a theme issue on Confidence Distributions and Related Themes, for the Journal of Statistical Planning and Inference, by the two guest editors. JSPI 2018, vol. 195, pages 1-13; journal version i is here: www.sciencedirect.com/science/article/abs/pii/S037837581730174X"}],"geoLocations":[],"fundingReferences":[],"url":"https://arxiv.org/abs/2602.20834","contentUrl":null,"metadataVersion":0,"schemaVersion":"http://datacite.org/schema/kernel-4","source":"mds","isActive":true,"state":"findable","reason":null,"viewCount":0,"downloadCount":0,"referenceCount":0,"citationCount":0,"partCount":0,"partOfCount":0,"versionCount":0,"versionOfCount":0,"created":"2026-02-25T02:59:39Z","registered":"2026-02-25T02:59:40Z","published":null,"updated":"2026-02-25T02:59:40Z"},"relationships":{"client":{"data":{"id":"arxiv.content","type":"clients"}}}},{"id":"10.48550/arxiv.2602.20832","type":"dois","attributes":{"doi":"10.48550/arxiv.2602.20832","identifiers":[{"identifier":"2602.20832","identifierType":"arXiv"}],"creators":[{"nameType":"Personal","givenName":"Amir","familyName":"Shpilka","name":"Shpilka, Amir","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Yann","familyName":"Tal","name":"Tal, Yann","affiliation":[],"nameIdentifiers":[]}],"titles":[{"title":"Polynomial Identity Testing and Reconstruction for Depth-4 Powering Circuits of High Degree"}],"publisher":"arXiv","container":{},"publicationYear":2026,"subjects":[{"subject":"Computational Complexity (cs.CC)","lang":"en","subjectScheme":"arXiv"},{"subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"},{"schemeUri":"http://www.oecd.org/science/inno/38235147.pdf","subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"}],"contributors":[],"dates":[{"date":"2026-02-24T12:13:58Z","dateType":"Submitted","dateInformation":"v1"},{"date":"2026-02-25T01:44:26Z","dateType":"Updated","dateInformation":"v1"},{"date":"2026-02","dateType":"Available","dateInformation":"v1"},{"date":"2026","dateType":"Issued"}],"language":null,"types":{"schemaOrg":"CreativeWork","resourceTypeGeneral":"Preprint","citeproc":"article","bibtex":"misc","ris":"GEN","resourceType":"Article"},"relatedIdentifiers":[],"relatedItems":[],"sizes":[],"formats":[],"version":"1","rightsList":[{"rightsUri":"http://arxiv.org/licenses/nonexclusive-distrib/1.0/","rights":"arXiv.org perpetual, non-exclusive license"}],"descriptions":[{"descriptionType":"Abstract","description":"We study deterministic polynomial identity testing (PIT) and reconstruction algorithms for depth-$4$ arithmetic circuits of the form \\[ Σ^{[r]}\\!\\wedge^{[d]}\\!Σ^{[s]}\\!Π^{[δ]}. \\] This model generalizes Waring decompositions and diagonal circuits, and captures sums of powers of low-degree sparse polynomials. Specifically, each circuit computes a sum of $r$ terms, where each term is a $d$-th power of an $s$-sparse polynomial of degree $δ$. This model also includes algebraic representations that arise in tensor decomposition and moment-based learning tasks such as mixture models and subspace learning.\n We give deterministic worst-case algorithms for PIT and reconstruction in this model. Our PIT construction applies when $d\u0026gt;r^2$ and yields explicit hitting sets of size $O(r^4 s^4 n^2 d δ^3)$. The reconstruction algorithm runs in time $\\textrm{poly}(n,s,d)$ under the condition $d=Ω(r^4δ)$, and in particular it tolerates polynomially large top fan-in $r$ and bottom degree $δ$.\n Both results hold over fields of characteristic zero and over fields of sufficiently large characteristic. These algorithms provide the first polynomial-time deterministic solutions for depth-$4$ powering circuits with unbounded top fan-in. In particular, the reconstruction result improves upon previous work which required non-degeneracy or average-case assumptions.\n The PIT construction relies on the ABC theorem for function fields (Mason-Stothers theorem), which ensures linear independence of high-degree powers of sparse polynomials after a suitable projection. The reconstruction algorithm combines this with Wronskian-based differential operators, structural properties of their kernels, and a robust version of the Klivans-Spielman hitting set."}],"geoLocations":[],"fundingReferences":[],"url":"https://arxiv.org/abs/2602.20832","contentUrl":null,"metadataVersion":0,"schemaVersion":"http://datacite.org/schema/kernel-4","source":"mds","isActive":true,"state":"findable","reason":null,"viewCount":0,"downloadCount":0,"referenceCount":0,"citationCount":0,"partCount":0,"partOfCount":0,"versionCount":0,"versionOfCount":0,"created":"2026-02-25T02:59:36Z","registered":"2026-02-25T02:59:37Z","published":null,"updated":"2026-02-25T02:59:37Z"},"relationships":{"client":{"data":{"id":"arxiv.content","type":"clients"}}}},{"id":"10.48550/arxiv.2602.20831","type":"dois","attributes":{"doi":"10.48550/arxiv.2602.20831","identifiers":[{"identifier":"2602.20831","identifierType":"arXiv"}],"creators":[{"nameType":"Personal","givenName":"Pedro","familyName":"Barbassa","name":"Barbassa, Pedro","affiliation":[],"nameIdentifiers":[]}],"titles":[{"title":"Distributions with Unstable Tangent Sheaf on $\\mathbb{P}^3$"}],"publisher":"arXiv","container":{},"publicationYear":2026,"subjects":[{"subject":"Algebraic Geometry (math.AG)","lang":"en","subjectScheme":"arXiv"},{"subject":"Complex Variables (math.CV)","lang":"en","subjectScheme":"arXiv"},{"subject":"FOS: Mathematics","subjectScheme":"Fields of Science and Technology (FOS)"},{"schemeUri":"http://www.oecd.org/science/inno/38235147.pdf","subject":"FOS: Mathematics","subjectScheme":"Fields of Science and Technology (FOS)"}],"contributors":[],"dates":[{"date":"2026-02-24T12:12:37Z","dateType":"Submitted","dateInformation":"v1"},{"date":"2026-02-25T01:44:21Z","dateType":"Updated","dateInformation":"v1"},{"date":"2026-02","dateType":"Available","dateInformation":"v1"},{"date":"2026","dateType":"Issued"}],"language":null,"types":{"schemaOrg":"CreativeWork","resourceTypeGeneral":"Preprint","citeproc":"article","bibtex":"misc","ris":"GEN","resourceType":"Article"},"relatedIdentifiers":[],"relatedItems":[],"sizes":[],"formats":[],"version":"1","rightsList":[{"rightsIdentifierScheme":"SPDX","rightsUri":"https://creativecommons.org/licenses/by/4.0/legalcode","schemeUri":"https://spdx.org/licenses/","rights":"Creative Commons Attribution 4.0 International","rightsIdentifier":"cc-by-4.0"}],"descriptions":[{"descriptionType":"Abstract","description":"We study codimension one distributions on the projective three-space, focusing on cases where the tangent sheaf of the distribution is nonsplit and unstable. We relate the order of nonstability to the degree of the induced subfoliation by curves, showing that the order of nonstability is bounded. Moreover, we classify the tangent sheaf of the codimension one distributions that admit a subfoliation by curves of degree 1. In other words, assuming the sheaf is nonsplit, we classify the situations in which the tangent sheaf attains the maximal possible order of nonstability."},{"descriptionType":"Other","description":"19 pages"}],"geoLocations":[],"fundingReferences":[],"url":"https://arxiv.org/abs/2602.20831","contentUrl":null,"metadataVersion":0,"schemaVersion":"http://datacite.org/schema/kernel-4","source":"mds","isActive":true,"state":"findable","reason":null,"viewCount":0,"downloadCount":0,"referenceCount":0,"citationCount":0,"partCount":0,"partOfCount":0,"versionCount":0,"versionOfCount":0,"created":"2026-02-25T02:59:35Z","registered":"2026-02-25T02:59:35Z","published":null,"updated":"2026-02-25T02:59:35Z"},"relationships":{"client":{"data":{"id":"arxiv.content","type":"clients"}}}},{"id":"10.48550/arxiv.2602.20830","type":"dois","attributes":{"doi":"10.48550/arxiv.2602.20830","identifiers":[{"identifier":"2602.20830","identifierType":"arXiv"}],"creators":[{"nameType":"Personal","givenName":"Tayeb","familyName":"Kenaza","name":"Kenaza, Tayeb","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Islam","familyName":"Debicha","name":"Debicha, Islam","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Youcef","familyName":"Fares","name":"Fares, Youcef","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Mehdi","familyName":"Sehaki","name":"Sehaki, Mehdi","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Sami","familyName":"Messai","name":"Messai, Sami","affiliation":[],"nameIdentifiers":[]}],"titles":[{"title":"A Secure and Interoperable Architecture for Electronic Health Record Access Control and Sharing"}],"publisher":"arXiv","container":{},"publicationYear":2026,"subjects":[{"subject":"Cryptography and Security (cs.CR)","lang":"en","subjectScheme":"arXiv"},{"subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"},{"schemeUri":"http://www.oecd.org/science/inno/38235147.pdf","subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"}],"contributors":[],"dates":[{"date":"2026-02-24T12:11:32Z","dateType":"Submitted","dateInformation":"v1"},{"date":"2026-02-25T01:44:20Z","dateType":"Updated","dateInformation":"v1"},{"date":"2026-02","dateType":"Available","dateInformation":"v1"},{"date":"2026","dateType":"Issued"}],"language":null,"types":{"schemaOrg":"CreativeWork","resourceTypeGeneral":"Preprint","citeproc":"article","bibtex":"misc","ris":"GEN","resourceType":"Article"},"relatedIdentifiers":[],"relatedItems":[],"sizes":[],"formats":[],"version":"1","rightsList":[{"rightsIdentifierScheme":"SPDX","rightsUri":"https://creativecommons.org/licenses/by-nc-nd/4.0/legalcode","schemeUri":"https://spdx.org/licenses/","rights":"Creative Commons Attribution Non Commercial No Derivatives 4.0 International","rightsIdentifier":"cc-by-nc-nd-4.0"}],"descriptions":[{"descriptionType":"Abstract","description":"Electronic Health Records (EHRs) store sensitive patient information, necessitating stringent access control and sharing mechanisms to uphold data security and comply with privacy regulations such as the General Data Protection Regulation (GDPR). In this paper, we propose a comprehensive architecture with a suite of efficient protocols that leverage the synergistic capabilities of the Blockchain and Interplanetary File System (IPFS) technologies to enable secure access control and sharing of EHRs. Our approach is based on a private blockchain, wherein smart contracts are deployed to enforce control exclusively by patients. By granting patients exclusive control over their EHRs, our solution ensures compliance with personal data protection laws and empowers individuals to manage their health information autonomously. Notably, our proposed architecture seamlessly integrates with existing health provider information systems, facilitating interoperability and effectively addressing security and data heterogeneity challenges. To demonstrate the effectiveness of our approach, we developed a prototype based on a private implementation of the Hyperledger platform, enabling the simulation of diverse scenarios involving access control and health data sharing among healthcare practitioners. Our experimental results demonstrate the scalability of our solution, thereby substantiating its efficacy and robustness in real-world healthcare settings."}],"geoLocations":[],"fundingReferences":[],"url":"https://arxiv.org/abs/2602.20830","contentUrl":null,"metadataVersion":0,"schemaVersion":"http://datacite.org/schema/kernel-4","source":"mds","isActive":true,"state":"findable","reason":null,"viewCount":0,"downloadCount":0,"referenceCount":0,"citationCount":0,"partCount":0,"partOfCount":0,"versionCount":0,"versionOfCount":0,"created":"2026-02-25T02:59:33Z","registered":"2026-02-25T02:59:34Z","published":null,"updated":"2026-02-25T02:59:34Z"},"relationships":{"client":{"data":{"id":"arxiv.content","type":"clients"}}}},{"id":"10.48550/arxiv.2602.20827","type":"dois","attributes":{"doi":"10.48550/arxiv.2602.20827","identifiers":[{"identifier":"2602.20827","identifierType":"arXiv"}],"creators":[{"nameType":"Personal","givenName":"Riccardo","familyName":"Adami","name":"Adami, Riccardo","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Luigi","familyName":"Barletti","name":"Barletti, Luigi","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Alessandro","familyName":"Teta","name":"Teta, Alessandro","affiliation":[],"nameIdentifiers":[]}],"titles":[{"title":"A mathematical model for the Einstein-Podolsky-Rosen argument"}],"publisher":"arXiv","container":{},"publicationYear":2026,"subjects":[{"subject":"Mathematical Physics (math-ph)","lang":"en","subjectScheme":"arXiv"},{"subject":"Analysis of PDEs (math.AP)","lang":"en","subjectScheme":"arXiv"},{"subject":"Dynamical Systems (math.DS)","lang":"en","subjectScheme":"arXiv"},{"subject":"Quantum Physics (quant-ph)","lang":"en","subjectScheme":"arXiv"},{"subject":"FOS: Physical sciences","subjectScheme":"Fields of Science and Technology (FOS)"},{"schemeUri":"http://www.oecd.org/science/inno/38235147.pdf","subject":"FOS: Physical sciences","subjectScheme":"Fields of Science and Technology (FOS)"},{"subject":"FOS: Mathematics","subjectScheme":"Fields of Science and Technology (FOS)"},{"schemeUri":"http://www.oecd.org/science/inno/38235147.pdf","subject":"FOS: Mathematics","subjectScheme":"Fields of Science and Technology (FOS)"},{"subject":"81","lang":"en","subjectScheme":"MSC"}],"contributors":[],"dates":[{"date":"2026-02-24T12:04:30Z","dateType":"Submitted","dateInformation":"v1"},{"date":"2026-02-25T01:44:09Z","dateType":"Updated","dateInformation":"v1"},{"date":"2026-02","dateType":"Available","dateInformation":"v1"},{"date":"2026","dateType":"Issued"}],"language":null,"types":{"schemaOrg":"CreativeWork","resourceTypeGeneral":"Preprint","citeproc":"article","bibtex":"misc","ris":"GEN","resourceType":"Article"},"relatedIdentifiers":[],"relatedItems":[],"sizes":[],"formats":[],"version":"1","rightsList":[{"rightsUri":"http://arxiv.org/licenses/nonexclusive-distrib/1.0/","rights":"arXiv.org perpetual, non-exclusive license"}],"descriptions":[{"descriptionType":"Abstract","description":"We study a nonrelativistic system made of two quantum particles constrained to move on a line and a spin located at a fixed point of the line. Initially the two particles are in a maximally entangled state and the spin is down. The first particle interacts with the spin while the second particle is free, i.e., it does not interact neither with the first particle nor with the spin. We rigorously prove that there is a correlation between the state of the spin and the state of the second particle. More precisely, we show that, in a suitable scaling limit, if the first particle flips the spin, then the second particle possesses a definite momentum in the direction opposite to the spin."},{"descriptionType":"Other","description":"23 pages"}],"geoLocations":[],"fundingReferences":[],"url":"https://arxiv.org/abs/2602.20827","contentUrl":null,"metadataVersion":0,"schemaVersion":"http://datacite.org/schema/kernel-4","source":"mds","isActive":true,"state":"findable","reason":null,"viewCount":0,"downloadCount":0,"referenceCount":0,"citationCount":0,"partCount":0,"partOfCount":0,"versionCount":0,"versionOfCount":0,"created":"2026-02-25T02:59:29Z","registered":"2026-02-25T02:59:30Z","published":null,"updated":"2026-02-25T02:59:30Z"},"relationships":{"client":{"data":{"id":"arxiv.content","type":"clients"}}}},{"id":"10.48550/arxiv.2602.20826","type":"dois","attributes":{"doi":"10.48550/arxiv.2602.20826","identifiers":[{"identifier":"2602.20826","identifierType":"arXiv"}],"creators":[{"nameType":"Personal","givenName":"Yuanhai","familyName":"Zhang","name":"Zhang, Yuanhai","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Songyang","familyName":"He","name":"He, Songyang","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Ruizhe","familyName":"Gou","name":"Gou, Ruizhe","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Mingyue","familyName":"Cui","name":"Cui, Mingyue","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Boyang","familyName":"Li","name":"Li, Boyang","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Shuai","familyName":"Zhao","name":"Zhao, Shuai","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Kai","familyName":"Huang","name":"Huang, Kai","affiliation":[],"nameIdentifiers":[]}],"titles":[{"title":"Exploiting Dependency and Parallelism: Real-Time Scheduling and Analysis for GPU Tasks"}],"publisher":"arXiv","container":{},"publicationYear":2026,"subjects":[{"subject":"Operating Systems (cs.OS)","lang":"en","subjectScheme":"arXiv"},{"subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"},{"schemeUri":"http://www.oecd.org/science/inno/38235147.pdf","subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"}],"contributors":[],"dates":[{"date":"2026-02-24T12:01:57Z","dateType":"Submitted","dateInformation":"v1"},{"date":"2026-02-25T01:44:00Z","dateType":"Updated","dateInformation":"v1"},{"date":"2026-02","dateType":"Available","dateInformation":"v1"},{"date":"2026","dateType":"Issued"}],"language":null,"types":{"schemaOrg":"CreativeWork","resourceTypeGeneral":"Preprint","citeproc":"article","bibtex":"misc","ris":"GEN","resourceType":"Article"},"relatedIdentifiers":[],"relatedItems":[],"sizes":[],"formats":[],"version":"1","rightsList":[{"rightsIdentifierScheme":"SPDX","rightsUri":"https://creativecommons.org/licenses/by/4.0/legalcode","schemeUri":"https://spdx.org/licenses/","rights":"Creative Commons Attribution 4.0 International","rightsIdentifier":"cc-by-4.0"}],"descriptions":[{"descriptionType":"Abstract","description":"With the rapid advancement of Artificial Intelligence, the Graphics Processing Unit (GPU) has become increasingly essential across a growing number of safety-critical application domains. Applying a GPU is indispensable for parallel computing; however, the complex data dependencies and resource contention across kernels within a GPU task may unpredictably delay its execution time. To address these problems, this paper presents a scheduling and analysis method for Directed Acyclic Graph (DAG)-structured GPU tasks. Given a DAG representation, the proposed scheduling scales the kernel-level parallelism and establishes inter-kernel dependencies to provide a reduced and predictable DAG response time. The corresponding timing analysis yields a safe yet nonpessimistic makespan bound without any assumption on kernel priorities. The proposed method is implemented using the standard CUDA API, requiring no additional software or hardware support. Experimental results under synthetic and real-world benchmarks demonstrate that the proposed approach effectively reduces the worst-case makespan and measured task execution time compared to the existing methods up to 32.8% and 21.3%, respectively."}],"geoLocations":[],"fundingReferences":[],"url":"https://arxiv.org/abs/2602.20826","contentUrl":null,"metadataVersion":0,"schemaVersion":"http://datacite.org/schema/kernel-4","source":"mds","isActive":true,"state":"findable","reason":null,"viewCount":0,"downloadCount":0,"referenceCount":0,"citationCount":0,"partCount":0,"partOfCount":0,"versionCount":0,"versionOfCount":0,"created":"2026-02-25T02:59:27Z","registered":"2026-02-25T02:59:28Z","published":null,"updated":"2026-02-25T02:59:28Z"},"relationships":{"client":{"data":{"id":"arxiv.content","type":"clients"}}}},{"id":"10.48550/arxiv.2602.20824","type":"dois","attributes":{"doi":"10.48550/arxiv.2602.20824","identifiers":[{"identifier":"2602.20824","identifierType":"arXiv"}],"creators":[{"nameType":"Personal","givenName":"Alexander","familyName":"Wolf","name":"Wolf, Alexander","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Maxim A.","familyName":"Efremov","name":"Efremov, Maxim A.","affiliation":[],"nameIdentifiers":[]}],"titles":[{"title":"Mach-Zehnder interferometer for in-situ characterization of atom traps"}],"publisher":"arXiv","container":{},"publicationYear":2026,"subjects":[{"subject":"Quantum Physics (quant-ph)","lang":"en","subjectScheme":"arXiv"},{"subject":"FOS: Physical sciences","subjectScheme":"Fields of Science and Technology (FOS)"},{"schemeUri":"http://www.oecd.org/science/inno/38235147.pdf","subject":"FOS: Physical sciences","subjectScheme":"Fields of Science and Technology (FOS)"}],"contributors":[],"dates":[{"date":"2026-02-24T12:00:53Z","dateType":"Submitted","dateInformation":"v1"},{"date":"2026-02-25T01:43:58Z","dateType":"Updated","dateInformation":"v1"},{"date":"2026-02","dateType":"Available","dateInformation":"v1"},{"date":"2026","dateType":"Issued"}],"language":null,"types":{"schemaOrg":"CreativeWork","resourceTypeGeneral":"Preprint","citeproc":"article","bibtex":"misc","ris":"GEN","resourceType":"Article"},"relatedIdentifiers":[],"relatedItems":[],"sizes":[],"formats":[],"version":"1","rightsList":[{"rightsIdentifierScheme":"SPDX","rightsUri":"https://creativecommons.org/licenses/by/4.0/legalcode","schemeUri":"https://spdx.org/licenses/","rights":"Creative Commons Attribution 4.0 International","rightsIdentifier":"cc-by-4.0"}],"descriptions":[{"descriptionType":"Abstract","description":"Manipulating cold atoms in traps is a key tool for numerous realizations of quantum simulators and quantum sensors. They require accurate modeling and characterization of the underlying trapping potentials. We introduce a technique based on the Mach-Zehnder interferometer for in-situ characterization of weakly anharmonic potentials. By simulating the interferometer in an optical dipole trap, we can accurately determine its trap frequency and upper bounds onto anharmonicity magnitudes."}],"geoLocations":[],"fundingReferences":[],"url":"https://arxiv.org/abs/2602.20824","contentUrl":null,"metadataVersion":0,"schemaVersion":"http://datacite.org/schema/kernel-4","source":"mds","isActive":true,"state":"findable","reason":null,"viewCount":0,"downloadCount":0,"referenceCount":0,"citationCount":0,"partCount":0,"partOfCount":0,"versionCount":0,"versionOfCount":0,"created":"2026-02-25T02:59:25Z","registered":"2026-02-25T02:59:25Z","published":null,"updated":"2026-02-25T02:59:25Z"},"relationships":{"client":{"data":{"id":"arxiv.content","type":"clients"}}}},{"id":"10.48550/arxiv.2602.20823","type":"dois","attributes":{"doi":"10.48550/arxiv.2602.20823","identifiers":[{"identifier":"2602.20823","identifierType":"arXiv"}],"creators":[{"nameType":"Personal","givenName":"Bipasha","familyName":"Kashyap","name":"Kashyap, Bipasha","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Pubudu N.","familyName":"Pathirana","name":"Pathirana, Pubudu N.","affiliation":[],"nameIdentifiers":[]}],"titles":[{"title":"Geometric Analysis of Speech Representation Spaces: Topological Disentanglement and Confound Detection"}],"publisher":"arXiv","container":{},"publicationYear":2026,"subjects":[{"subject":"Sound (cs.SD)","lang":"en","subjectScheme":"arXiv"},{"subject":"Audio and Speech Processing (eess.AS)","lang":"en","subjectScheme":"arXiv"},{"subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"},{"schemeUri":"http://www.oecd.org/science/inno/38235147.pdf","subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"},{"subject":"FOS: Electrical engineering, electronic engineering, information engineering","subjectScheme":"Fields of Science and Technology (FOS)"},{"schemeUri":"http://www.oecd.org/science/inno/38235147.pdf","subject":"FOS: Electrical engineering, electronic engineering, information engineering","subjectScheme":"Fields of Science and Technology (FOS)"}],"contributors":[],"dates":[{"date":"2026-02-24T12:00:52Z","dateType":"Submitted","dateInformation":"v1"},{"date":"2026-02-25T01:43:57Z","dateType":"Updated","dateInformation":"v1"},{"date":"2026-02","dateType":"Available","dateInformation":"v1"},{"date":"2026","dateType":"Issued"}],"language":null,"types":{"schemaOrg":"CreativeWork","resourceTypeGeneral":"Preprint","citeproc":"article","bibtex":"misc","ris":"GEN","resourceType":"Article"},"relatedIdentifiers":[],"relatedItems":[],"sizes":[],"formats":[],"version":"1","rightsList":[{"rightsIdentifierScheme":"SPDX","rightsUri":"https://creativecommons.org/licenses/by-nc-nd/4.0/legalcode","schemeUri":"https://spdx.org/licenses/","rights":"Creative Commons Attribution Non Commercial No Derivatives 4.0 International","rightsIdentifier":"cc-by-nc-nd-4.0"}],"descriptions":[{"descriptionType":"Abstract","description":"Speech-based clinical tools are increasingly deployed in multilingual settings, yet whether pathological speech markers remain geometrically separable from accent variation remains unclear. Systems may misclassify healthy non-native speakers or miss pathology in multilingual patients. We propose a four-metric clustering framework to evaluate geometric disentanglement of emotional, linguistic, and pathological speech features across six corpora and eight dataset combinations. A consistent hierarchy emerges: emotional features form the tightest clusters (Silhouette 0.250), followed by pathological (0.141) and linguistic (0.077). Confound analysis shows pathological-linguistic overlap remains below 0.21, which is above the permutation null but bounded for clinical deployment. Trustworthiness analysis confirms embedding fidelity and robustness of the geometric conclusions. Our framework provides actionable guidelines for equitable and reliable speech health systems across diverse populations."},{"descriptionType":"Other","description":"Submitted to INTERSPEECH 2026"}],"geoLocations":[],"fundingReferences":[],"url":"https://arxiv.org/abs/2602.20823","contentUrl":null,"metadataVersion":0,"schemaVersion":"http://datacite.org/schema/kernel-4","source":"mds","isActive":true,"state":"findable","reason":null,"viewCount":0,"downloadCount":0,"referenceCount":0,"citationCount":0,"partCount":0,"partOfCount":0,"versionCount":0,"versionOfCount":0,"created":"2026-02-25T02:59:23Z","registered":"2026-02-25T02:59:24Z","published":null,"updated":"2026-02-25T02:59:24Z"},"relationships":{"client":{"data":{"id":"arxiv.content","type":"clients"}}}},{"id":"10.48550/arxiv.2602.20821","type":"dois","attributes":{"doi":"10.48550/arxiv.2602.20821","identifiers":[{"identifier":"2602.20821","identifierType":"arXiv"}],"creators":[{"nameType":"Personal","givenName":"Julia","familyName":"Atienza-Barthelemy","name":"Atienza-Barthelemy, Julia","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Samuel","familyName":"Martin-Gutierrez","name":"Martin-Gutierrez, Samuel","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Juan C.","familyName":"Losada","name":"Losada, Juan C.","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Rosa M.","familyName":"Benito","name":"Benito, Rosa M.","affiliation":[],"nameIdentifiers":[]}],"titles":[{"title":"Relationship between ideology and language in the Catalan independence context"}],"publisher":"arXiv","container":{},"publicationYear":2026,"subjects":[{"subject":"Physics and Society (physics.soc-ph)","lang":"en","subjectScheme":"arXiv"},{"subject":"FOS: Physical sciences","subjectScheme":"Fields of Science and Technology (FOS)"},{"schemeUri":"http://www.oecd.org/science/inno/38235147.pdf","subject":"FOS: Physical sciences","subjectScheme":"Fields of Science and Technology (FOS)"}],"contributors":[],"dates":[{"date":"2026-02-24T11:59:28Z","dateType":"Submitted","dateInformation":"v1"},{"date":"2026-02-25T01:43:54Z","dateType":"Updated","dateInformation":"v1"},{"date":"2026-02","dateType":"Available","dateInformation":"v1"},{"date":"2026","dateType":"Issued"}],"language":null,"types":{"schemaOrg":"CreativeWork","resourceTypeGeneral":"Preprint","citeproc":"article","bibtex":"misc","ris":"GEN","resourceType":"Article"},"relatedIdentifiers":[{"relationType":"IsVersionOf","relatedIdentifier":"10.1038/s41598-019-53404-x","relatedIdentifierType":"DOI"}],"relatedItems":[],"sizes":[],"formats":[],"version":"1","rightsList":[{"rightsIdentifierScheme":"SPDX","rightsUri":"https://creativecommons.org/licenses/by/4.0/legalcode","schemeUri":"https://spdx.org/licenses/","rights":"Creative Commons Attribution 4.0 International","rightsIdentifier":"cc-by-4.0"}],"descriptions":[{"descriptionType":"Abstract","description":"Political polarization generates strong effects on society, driving controversial debates and influencing the institutions. Territorial disputes are one of the most important polarized scenarios and have been consistently related to the use of language. In this work, we analyzed the opinion and language distributions through Twitter data of a particular territorial dispute around the independence of Catalonia. We infer a continuous opinion distribution by applying a model based on retweet interactions, previously detecting elite users with fixed and antagonist opinions. The resulting distribution presents a mainly bimodal behavior with an intermediate third pole that shows a less polarized society with the presence of not only antagonist opinions. We find that the more active, engaged and influential users hold more extreme positions. Also we prove that there is a clear relationship between political positions and the use of language, showing that against independence users speak mainly Spanish while pro-independence users speak Catalan and Spanish almost indistinctly. However, the third pole, closer in political opinion to the pro-independence pole, behaves similarly to the against-independence one concerning the use of language."}],"geoLocations":[],"fundingReferences":[],"url":"https://arxiv.org/abs/2602.20821","contentUrl":null,"metadataVersion":0,"schemaVersion":"http://datacite.org/schema/kernel-4","source":"mds","isActive":true,"state":"findable","reason":null,"viewCount":0,"downloadCount":0,"referenceCount":0,"citationCount":0,"partCount":0,"partOfCount":0,"versionCount":0,"versionOfCount":1,"created":"2026-02-25T02:59:21Z","registered":"2026-02-25T02:59:21Z","published":null,"updated":"2026-02-25T02:59:21Z"},"relationships":{"client":{"data":{"id":"arxiv.content","type":"clients"}}}},{"id":"10.48550/arxiv.2602.20820","type":"dois","attributes":{"doi":"10.48550/arxiv.2602.20820","identifiers":[{"identifier":"2602.20820","identifierType":"arXiv"}],"creators":[{"nameType":"Personal","givenName":"Wei","familyName":"Liu","name":"Liu, Wei","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Tingfeng","familyName":"Wang","name":"Wang, Tingfeng","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Xiaofei","familyName":"Zhao","name":"Zhao, Xiaofei","affiliation":[],"nameIdentifiers":[]}],"titles":[{"title":"Convergence analysis of $L^{p+1}$-normalized gradient flow for action ground state of nonlinear Schrödinger equation"}],"publisher":"arXiv","container":{},"publicationYear":2026,"subjects":[{"subject":"Numerical Analysis (math.NA)","lang":"en","subjectScheme":"arXiv"},{"subject":"FOS: Mathematics","subjectScheme":"Fields of Science and Technology (FOS)"},{"schemeUri":"http://www.oecd.org/science/inno/38235147.pdf","subject":"FOS: Mathematics","subjectScheme":"Fields of Science and Technology (FOS)"}],"contributors":[],"dates":[{"date":"2026-02-24T11:58:50Z","dateType":"Submitted","dateInformation":"v1"},{"date":"2026-02-25T01:43:53Z","dateType":"Updated","dateInformation":"v1"},{"date":"2026-02","dateType":"Available","dateInformation":"v1"},{"date":"2026","dateType":"Issued"}],"language":null,"types":{"schemaOrg":"CreativeWork","resourceTypeGeneral":"Preprint","citeproc":"article","bibtex":"misc","ris":"GEN","resourceType":"Article"},"relatedIdentifiers":[],"relatedItems":[],"sizes":[],"formats":[],"version":"1","rightsList":[{"rightsUri":"http://arxiv.org/licenses/nonexclusive-distrib/1.0/","rights":"arXiv.org perpetual, non-exclusive license"}],"descriptions":[{"descriptionType":"Abstract","description":"This paper presents a rigorous convergence analysis of the $L^{p+1}$-normalized gradient flow with asymptotic Lagrange multiplier (GFALM) method for computing the action ground state of the nonlinear Schrödinger equation in the focusing case. First, a general global convergence theory is established for the semi-discrete GFALM scheme, guaranteeing the existence of an accumulation point and a convergent subsequence. Then, under additional non-degeneracy assumptions, a local exponential convergence rate is rigorously proven. This result is further extended to the fully discrete case using a Fourier pseudo-spectral discretization. The analysis is achieved by characterizing the local geometry of the $L^{p+1}$-constrained manifold near the ground state, establishing a quadratic growth property of the energy functional, and deriving a Łojasiewicz-type gradient inequality. Finally, the paper also investigates the exponential convergence of the associated continuous-time gradient flow, providing a theoretical foundation for future numerical discretizations. This work extends existing convergence analyses for energy ground states, addressing the challenges posed by the $L^{p+1}$ constraint, especially the absence of an inner-product structure."},{"descriptionType":"Other","description":"22 pages"}],"geoLocations":[],"fundingReferences":[],"url":"https://arxiv.org/abs/2602.20820","contentUrl":null,"metadataVersion":0,"schemaVersion":"http://datacite.org/schema/kernel-4","source":"mds","isActive":true,"state":"findable","reason":null,"viewCount":0,"downloadCount":0,"referenceCount":0,"citationCount":0,"partCount":0,"partOfCount":0,"versionCount":0,"versionOfCount":0,"created":"2026-02-25T02:59:19Z","registered":"2026-02-25T02:59:20Z","published":null,"updated":"2026-02-25T02:59:20Z"},"relationships":{"client":{"data":{"id":"arxiv.content","type":"clients"}}}},{"id":"10.48550/arxiv.2602.20818","type":"dois","attributes":{"doi":"10.48550/arxiv.2602.20818","identifiers":[{"identifier":"2602.20818","identifierType":"arXiv"}],"creators":[{"nameType":"Personal","givenName":"Yingying","familyName":"Guo","name":"Guo, Yingying","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Ke","familyName":"Zhang","name":"Zhang, Ke","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Zirong","familyName":"Zeng","name":"Zeng, Zirong","affiliation":[],"nameIdentifiers":[]}],"titles":[{"title":"GatedCLIP: Gated Multimodal Fusion for Hateful Memes Detection"}],"publisher":"arXiv","container":{},"publicationYear":2026,"subjects":[{"subject":"Computer Vision and Pattern Recognition (cs.CV)","lang":"en","subjectScheme":"arXiv"},{"subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"},{"schemeUri":"http://www.oecd.org/science/inno/38235147.pdf","subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"}],"contributors":[],"dates":[{"date":"2026-02-24T11:54:54Z","dateType":"Submitted","dateInformation":"v1"},{"date":"2026-02-25T01:43:46Z","dateType":"Updated","dateInformation":"v1"},{"date":"2026-02","dateType":"Available","dateInformation":"v1"},{"date":"2026","dateType":"Issued"}],"language":null,"types":{"schemaOrg":"CreativeWork","resourceTypeGeneral":"Preprint","citeproc":"article","bibtex":"misc","ris":"GEN","resourceType":"Article"},"relatedIdentifiers":[],"relatedItems":[],"sizes":[],"formats":[],"version":"1","rightsList":[{"rightsUri":"http://arxiv.org/licenses/nonexclusive-distrib/1.0/","rights":"arXiv.org perpetual, non-exclusive license"}],"descriptions":[{"descriptionType":"Abstract","description":"Detecting hateful content in multimodal memes presents unique challenges, as harmful messages often emerge from the complex interplay between benign images and text. We propose GatedCLIP, a Vision-Language model that enhances CLIP's multimodal capabilities with specialized architectural improvements for hateful memes detection. Our approach introduces learned projection heads that map CLIP embeddings to a task-optimized semantic space, a dynamic gated fusion mechanism that adaptively weights visual and textual features, and a contrastive learning objective that maintains cross-modal semantic alignment. Experiments on the Hateful Memes dataset demonstrate that GatedCLIP achieves an AUROC of 0.66, substantially outperforming the CLIP baseline (AUROC 0.49) while maintaining computational efficiency with only 350K trainable parameters."},{"descriptionType":"Other","description":"Preprint"}],"geoLocations":[],"fundingReferences":[],"url":"https://arxiv.org/abs/2602.20818","contentUrl":null,"metadataVersion":0,"schemaVersion":"http://datacite.org/schema/kernel-4","source":"mds","isActive":true,"state":"findable","reason":null,"viewCount":0,"downloadCount":0,"referenceCount":0,"citationCount":0,"partCount":0,"partOfCount":0,"versionCount":0,"versionOfCount":0,"created":"2026-02-25T02:59:16Z","registered":"2026-02-25T02:59:17Z","published":null,"updated":"2026-02-25T02:59:17Z"},"relationships":{"client":{"data":{"id":"arxiv.content","type":"clients"}}}},{"id":"10.48550/arxiv.2602.20817","type":"dois","attributes":{"doi":"10.48550/arxiv.2602.20817","identifiers":[{"identifier":"2602.20817","identifierType":"arXiv"}],"creators":[{"nameType":"Personal","givenName":"Valentin","familyName":"Buciumas","name":"Buciumas, Valentin","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Chun-Ju","familyName":"Lai","name":"Lai, Chun-Ju","affiliation":[],"nameIdentifiers":[]}],"titles":[{"title":"Quantum wreath products and $p$-adic general linear group"}],"publisher":"arXiv","container":{},"publicationYear":2026,"subjects":[{"subject":"Representation Theory (math.RT)","lang":"en","subjectScheme":"arXiv"},{"subject":"Number Theory (math.NT)","lang":"en","subjectScheme":"arXiv"},{"subject":"Quantum Algebra (math.QA)","lang":"en","subjectScheme":"arXiv"},{"subject":"FOS: Mathematics","subjectScheme":"Fields of Science and Technology (FOS)"},{"schemeUri":"http://www.oecd.org/science/inno/38235147.pdf","subject":"FOS: Mathematics","subjectScheme":"Fields of Science and Technology (FOS)"}],"contributors":[],"dates":[{"date":"2026-02-24T11:54:10Z","dateType":"Submitted","dateInformation":"v1"},{"date":"2026-02-25T01:43:45Z","dateType":"Updated","dateInformation":"v1"},{"date":"2026-02","dateType":"Available","dateInformation":"v1"},{"date":"2026","dateType":"Issued"}],"language":null,"types":{"schemaOrg":"CreativeWork","resourceTypeGeneral":"Preprint","citeproc":"article","bibtex":"misc","ris":"GEN","resourceType":"Article"},"relatedIdentifiers":[],"relatedItems":[],"sizes":[],"formats":[],"version":"1","rightsList":[{"rightsIdentifierScheme":"SPDX","rightsUri":"https://creativecommons.org/licenses/by/4.0/legalcode","schemeUri":"https://spdx.org/licenses/","rights":"Creative Commons Attribution 4.0 International","rightsIdentifier":"cc-by-4.0"}],"descriptions":[{"descriptionType":"Abstract","description":"We study the pro-$p$ Iwahori-Hecke algebra and its Gelfand-Graev modules for the $p$-adic general linear group and its metaplectic covers. We develop the theory of quantum wreath products of skew polynomial type and use it to provide transparent descriptions of these Hecke algebras and their modules that were previously inaccessible through standard $p$-adic methods. We introduce the notion of (anti)spherical and Kashiwara-Miwa-Stern modules for these quantum wreath products for the first time and interpret the $p$-adic Gelfand-Graev modules in terms of these new modules. As an application, we study the structure theory for the corresponding $p$-adic pro-$p$ Schur algebras and obtain an explicit basis and multiplication rules. Moreover, we give algebraic (re)proofs of several results of $p$-adic interest including the existence of PBW basis for the pro-$p$ metaplectic and Iwahori-Hecke algebras, identification of the Iwahori-Schur algebra with the quantum affine Schur algebra, and failure of the local Shimura correspondence at the pro-$p$ level."},{"descriptionType":"Other","description":"28 pages. Comments welcome"}],"geoLocations":[],"fundingReferences":[],"url":"https://arxiv.org/abs/2602.20817","contentUrl":null,"metadataVersion":0,"schemaVersion":"http://datacite.org/schema/kernel-4","source":"mds","isActive":true,"state":"findable","reason":null,"viewCount":0,"downloadCount":0,"referenceCount":0,"citationCount":0,"partCount":0,"partOfCount":0,"versionCount":0,"versionOfCount":0,"created":"2026-02-25T02:59:14Z","registered":"2026-02-25T02:59:15Z","published":null,"updated":"2026-02-25T02:59:15Z"},"relationships":{"client":{"data":{"id":"arxiv.content","type":"clients"}}}},{"id":"10.48550/arxiv.2602.20815","type":"dois","attributes":{"doi":"10.48550/arxiv.2602.20815","identifiers":[{"identifier":"2602.20815","identifierType":"arXiv"}],"creators":[{"nameType":"Personal","givenName":"Nils Lid","familyName":"Hjort","name":"Hjort, Nils Lid","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Nikolai G.","familyName":"Ushakov","name":"Ushakov, Nikolai G.","affiliation":[],"nameIdentifiers":[]}],"titles":[{"title":"Upper Bounds for the I-MSE and max-MSE of Kernel Density Estimators"}],"publisher":"arXiv","container":{},"publicationYear":2026,"subjects":[{"subject":"Statistics Theory (math.ST)","lang":"en","subjectScheme":"arXiv"},{"subject":"FOS: Mathematics","subjectScheme":"Fields of Science and Technology (FOS)"},{"schemeUri":"http://www.oecd.org/science/inno/38235147.pdf","subject":"FOS: Mathematics","subjectScheme":"Fields of Science and Technology (FOS)"}],"contributors":[],"dates":[{"date":"2026-02-24T11:53:47Z","dateType":"Submitted","dateInformation":"v1"},{"date":"2026-02-25T01:43:44Z","dateType":"Updated","dateInformation":"v1"},{"date":"2026-02","dateType":"Available","dateInformation":"v1"},{"date":"2026","dateType":"Issued"}],"language":null,"types":{"schemaOrg":"CreativeWork","resourceTypeGeneral":"Preprint","citeproc":"article","bibtex":"misc","ris":"GEN","resourceType":"Article"},"relatedIdentifiers":[],"relatedItems":[],"sizes":[],"formats":[],"version":"1","rightsList":[{"rightsUri":"http://arxiv.org/licenses/nonexclusive-distrib/1.0/","rights":"arXiv.org perpetual, non-exclusive license"}],"descriptions":[{"descriptionType":"Abstract","description":"The performance of kernel density estimators is usually studied via Taylor expansions and asymptotic approximation arguments, in which the bandwidth parameter tends to zero with increasing sample size. In contrast, this paper focusses directly on the finite-sample situation. Informative upper bounds are derived both for the integrated and the maximal mean squared error function. Results are reached for the traditional case, where the kernel is a probability density function, under various sets of assumptions on the underlying density to be estimated. Results are also derived for the important non-conventional case of the sinc kernel, which is not integrable and also takes negative values. We pin-point ways in which the sinc-based estimator performs better than the conventional kernel estimators. When proving our results we rely on methods related to characteristic and empirical characteristic functions."},{"descriptionType":"Other","description":"21 pages, 0 figures. Statistical Research Report, Department of Mathematics, University of Oslo, from December 1999, but arXiv'd in February 2026"}],"geoLocations":[],"fundingReferences":[],"url":"https://arxiv.org/abs/2602.20815","contentUrl":null,"metadataVersion":0,"schemaVersion":"http://datacite.org/schema/kernel-4","source":"mds","isActive":true,"state":"findable","reason":null,"viewCount":0,"downloadCount":0,"referenceCount":0,"citationCount":0,"partCount":0,"partOfCount":0,"versionCount":0,"versionOfCount":0,"created":"2026-02-25T02:59:12Z","registered":"2026-02-25T02:59:12Z","published":null,"updated":"2026-02-25T02:59:12Z"},"relationships":{"client":{"data":{"id":"arxiv.content","type":"clients"}}}},{"id":"10.48550/arxiv.2602.20813","type":"dois","attributes":{"doi":"10.48550/arxiv.2602.20813","identifiers":[{"identifier":"2602.20813","identifierType":"arXiv"}],"creators":[{"nameType":"Personal","givenName":"Nora","familyName":"Petrova","name":"Petrova, Nora","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"John","familyName":"Burden","name":"Burden, John","affiliation":[],"nameIdentifiers":[]}],"titles":[{"title":"Pressure Reveals Character: Behavioural Alignment Evaluation at Depth"}],"publisher":"arXiv","container":{},"publicationYear":2026,"subjects":[{"subject":"Artificial Intelligence (cs.AI)","lang":"en","subjectScheme":"arXiv"},{"subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"},{"schemeUri":"http://www.oecd.org/science/inno/38235147.pdf","subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"}],"contributors":[],"dates":[{"date":"2026-02-24T11:52:17Z","dateType":"Submitted","dateInformation":"v1"},{"date":"2026-02-25T01:43:38Z","dateType":"Updated","dateInformation":"v1"},{"date":"2026-02","dateType":"Available","dateInformation":"v1"},{"date":"2026","dateType":"Issued"}],"language":null,"types":{"schemaOrg":"CreativeWork","resourceTypeGeneral":"Preprint","citeproc":"article","bibtex":"misc","ris":"GEN","resourceType":"Article"},"relatedIdentifiers":[],"relatedItems":[],"sizes":[],"formats":[],"version":"1","rightsList":[{"rightsUri":"http://arxiv.org/licenses/nonexclusive-distrib/1.0/","rights":"arXiv.org perpetual, non-exclusive license"}],"descriptions":[{"descriptionType":"Abstract","description":"Evaluating alignment in language models requires testing how they behave under realistic pressure, not just what they claim they would do. While alignment failures increasingly cause real-world harm, comprehensive evaluation frameworks with realistic multi-turn scenarios remain lacking. We introduce an alignment benchmark spanning 904 scenarios across six categories -- Honesty, Safety, Non-Manipulation, Robustness, Corrigibility, and Scheming -- validated as realistic by human raters. Our scenarios place models under conflicting instructions, simulated tool access, and multi-turn escalation to reveal behavioural tendencies that single-turn evaluations miss. Evaluating 24 frontier models using LLM judges validated against human annotations, we find that even top-performing models exhibit gaps in specific categories, while the majority of models show consistent weaknesses across the board. Factor analysis reveals that alignment behaves as a unified construct (analogous to the g-factor in cognitive research) with models scoring high on one category tending to score high on others. We publicly release the benchmark and an interactive leaderboard to support ongoing evaluation, with plans to expand scenarios in areas where we observe persistent weaknesses and to add new models as they are released."},{"descriptionType":"Other","description":"Preprint"}],"geoLocations":[],"fundingReferences":[],"url":"https://arxiv.org/abs/2602.20813","contentUrl":null,"metadataVersion":0,"schemaVersion":"http://datacite.org/schema/kernel-4","source":"mds","isActive":true,"state":"findable","reason":null,"viewCount":0,"downloadCount":0,"referenceCount":0,"citationCount":0,"partCount":0,"partOfCount":0,"versionCount":0,"versionOfCount":0,"created":"2026-02-25T02:59:09Z","registered":"2026-02-25T02:59:10Z","published":null,"updated":"2026-02-25T02:59:10Z"},"relationships":{"client":{"data":{"id":"arxiv.content","type":"clients"}}}},{"id":"10.48550/arxiv.2602.20812","type":"dois","attributes":{"doi":"10.48550/arxiv.2602.20812","identifiers":[{"identifier":"2602.20812","identifierType":"arXiv"}],"creators":[{"nameType":"Personal","givenName":"Jia-Rui","familyName":"Lin","name":"Lin, Jia-Rui","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Yun-Hong","familyName":"Cai","name":"Cai, Yun-Hong","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Xiang-Rui","familyName":"Ni","name":"Ni, Xiang-Rui","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Shaojie","familyName":"Zhou","name":"Zhou, Shaojie","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Peng","familyName":"Pan","name":"Pan, Peng","affiliation":[],"nameIdentifiers":[]}],"titles":[{"title":"Qwen-BIM: developing large language model for BIM-based design with domain-specific benchmark and dataset"}],"publisher":"arXiv","container":{},"publicationYear":2026,"subjects":[{"subject":"Artificial Intelligence (cs.AI)","lang":"en","subjectScheme":"arXiv"},{"subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"},{"schemeUri":"http://www.oecd.org/science/inno/38235147.pdf","subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"}],"contributors":[],"dates":[{"date":"2026-02-24T11:51:21Z","dateType":"Submitted","dateInformation":"v1"},{"date":"2026-02-25T01:43:28Z","dateType":"Updated","dateInformation":"v1"},{"date":"2026-02","dateType":"Available","dateInformation":"v1"},{"date":"2026","dateType":"Issued"}],"language":null,"types":{"schemaOrg":"CreativeWork","resourceTypeGeneral":"Preprint","citeproc":"article","bibtex":"misc","ris":"GEN","resourceType":"Article"},"relatedIdentifiers":[],"relatedItems":[],"sizes":[],"formats":[],"version":"1","rightsList":[{"rightsIdentifierScheme":"SPDX","rightsUri":"https://creativecommons.org/licenses/by-nc-nd/4.0/legalcode","schemeUri":"https://spdx.org/licenses/","rights":"Creative Commons Attribution Non Commercial No Derivatives 4.0 International","rightsIdentifier":"cc-by-nc-nd-4.0"}],"descriptions":[{"descriptionType":"Abstract","description":"As the construction industry advances toward digital transformation, BIM (Building Information Modeling)-based design has become a key driver supporting intelligent construction. Despite Large Language Models (LLMs) have shown potential in promoting BIM-based design, the lack of specific datasets and LLM evaluation benchmarks has significantly hindered the performance of LLMs. Therefore, this paper addresses this gap by proposing: 1) an evaluation benchmark for BIM-based design together with corresponding quantitative indicators to evaluate the performance of LLMs, 2) a method for generating textual data from BIM and constructing corresponding BIM-derived datasets for LLM evaluation and fine-tuning, and 3) a fine-tuning strategy to adapt LLMs for BIM-based design. Results demonstrate that the proposed domain-specific benchmark effectively and comprehensively assesses LLM capabilities, highlighting that general LLMs are still incompetent for domain-specific tasks. Meanwhile, with the proposed benchmark and datasets, Qwen-BIM is developed and achieves a 21.0% average increase in G-Eval score compared to the base LLM model. Notably, with only 14B parameters, performance of Qwen-BIM is comparable to that of general LLMs with 671B parameters for BIM-based design tasks. Overall, this study develops the first domain-specific LLM for BIM-based design by introducing a comprehensive benchmark and high-quality dataset, which provide a solid foundation for developing BIM-related LLMs in various fields."}],"geoLocations":[],"fundingReferences":[],"url":"https://arxiv.org/abs/2602.20812","contentUrl":null,"metadataVersion":0,"schemaVersion":"http://datacite.org/schema/kernel-4","source":"mds","isActive":true,"state":"findable","reason":null,"viewCount":0,"downloadCount":0,"referenceCount":0,"citationCount":0,"partCount":0,"partOfCount":0,"versionCount":0,"versionOfCount":0,"created":"2026-02-25T02:59:07Z","registered":"2026-02-25T02:59:08Z","published":null,"updated":"2026-02-25T02:59:08Z"},"relationships":{"client":{"data":{"id":"arxiv.content","type":"clients"}}}},{"id":"10.48550/arxiv.2602.20810","type":"dois","attributes":{"doi":"10.48550/arxiv.2602.20810","identifiers":[{"identifier":"2602.20810","identifierType":"arXiv"}],"creators":[{"nameType":"Personal","givenName":"Yaacov","familyName":"Pariente","name":"Pariente, Yaacov","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Vadim","familyName":"Indelman","name":"Indelman, Vadim","affiliation":[],"nameIdentifiers":[]}],"titles":[{"title":"POMDPPlanners: Open-Source Package for POMDP Planning"}],"publisher":"arXiv","container":{},"publicationYear":2026,"subjects":[{"subject":"Artificial Intelligence (cs.AI)","lang":"en","subjectScheme":"arXiv"},{"subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"},{"schemeUri":"http://www.oecd.org/science/inno/38235147.pdf","subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"}],"contributors":[],"dates":[{"date":"2026-02-24T11:50:04Z","dateType":"Submitted","dateInformation":"v1"},{"date":"2026-02-25T01:43:23Z","dateType":"Updated","dateInformation":"v1"},{"date":"2026-02","dateType":"Available","dateInformation":"v1"},{"date":"2026","dateType":"Issued"}],"language":null,"types":{"schemaOrg":"CreativeWork","resourceTypeGeneral":"Preprint","citeproc":"article","bibtex":"misc","ris":"GEN","resourceType":"Article"},"relatedIdentifiers":[],"relatedItems":[],"sizes":[],"formats":[],"version":"1","rightsList":[{"rightsIdentifierScheme":"SPDX","rightsUri":"https://creativecommons.org/licenses/by/4.0/legalcode","schemeUri":"https://spdx.org/licenses/","rights":"Creative Commons Attribution 4.0 International","rightsIdentifier":"cc-by-4.0"}],"descriptions":[{"descriptionType":"Abstract","description":"We present POMDPPlanners, an open-source Python package for empirical evaluation of Partially Observable Markov Decision Process (POMDP) planning algorithms. The package integrates state-of-the-art planning algorithms, a suite of benchmark environments with safety-critical variants, automated hyperparameter optimization via Optuna, persistent caching with failure recovery, and configurable parallel simulation -- reducing the overhead of extensive simulation studies. POMDPPlanners is designed to enable scalable, reproducible research on decision-making under uncertainty, with particular emphasis on risk-sensitive settings where standard toolkits fall short."}],"geoLocations":[],"fundingReferences":[],"url":"https://arxiv.org/abs/2602.20810","contentUrl":null,"metadataVersion":0,"schemaVersion":"http://datacite.org/schema/kernel-4","source":"mds","isActive":true,"state":"findable","reason":null,"viewCount":0,"downloadCount":0,"referenceCount":0,"citationCount":0,"partCount":0,"partOfCount":0,"versionCount":0,"versionOfCount":0,"created":"2026-02-25T02:59:04Z","registered":"2026-02-25T02:59:05Z","published":null,"updated":"2026-02-25T02:59:05Z"},"relationships":{"client":{"data":{"id":"arxiv.content","type":"clients"}}}},{"id":"10.48550/arxiv.2602.20809","type":"dois","attributes":{"doi":"10.48550/arxiv.2602.20809","identifiers":[{"identifier":"2602.20809","identifierType":"arXiv"}],"creators":[{"nameType":"Personal","givenName":"Yun-Jui","familyName":"Tsai","name":"Tsai, Yun-Jui","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Wei-Yu","familyName":"Chen","name":"Chen, Wei-Yu","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Yan-Ru","familyName":"Ju","name":"Ju, Yan-Ru","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Yu-Hung","familyName":"Chang","name":"Chang, Yu-Hung","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Ti-Rong","familyName":"Wu","name":"Wu, Ti-Rong","affiliation":[],"nameIdentifiers":[]}],"titles":[{"title":"Regret-Guided Search Control for Efficient Learning in AlphaZero"}],"publisher":"arXiv","container":{},"publicationYear":2026,"subjects":[{"subject":"Machine Learning (cs.LG)","lang":"en","subjectScheme":"arXiv"},{"subject":"Artificial Intelligence (cs.AI)","lang":"en","subjectScheme":"arXiv"},{"subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"},{"schemeUri":"http://www.oecd.org/science/inno/38235147.pdf","subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"}],"contributors":[],"dates":[{"date":"2026-02-24T11:49:59Z","dateType":"Submitted","dateInformation":"v1"},{"date":"2026-02-25T01:43:19Z","dateType":"Updated","dateInformation":"v1"},{"date":"2026-02","dateType":"Available","dateInformation":"v1"},{"date":"2026","dateType":"Issued"}],"language":null,"types":{"schemaOrg":"CreativeWork","resourceTypeGeneral":"Preprint","citeproc":"article","bibtex":"misc","ris":"GEN","resourceType":"Article"},"relatedIdentifiers":[],"relatedItems":[],"sizes":[],"formats":[],"version":"1","rightsList":[{"rightsIdentifierScheme":"SPDX","rightsUri":"https://creativecommons.org/licenses/by/4.0/legalcode","schemeUri":"https://spdx.org/licenses/","rights":"Creative Commons Attribution 4.0 International","rightsIdentifier":"cc-by-4.0"}],"descriptions":[{"descriptionType":"Abstract","description":"Reinforcement learning (RL) agents achieve remarkable performance but remain far less learning-efficient than humans. While RL agents require extensive self-play games to extract useful signals, humans often need only a few games, improving rapidly by repeatedly revisiting states where mistakes occurred. This idea, known as search control, aims to restart from valuable states rather than always from the initial state. In AlphaZero, prior work Go-Exploit applies this idea by sampling past states from self-play or search trees, but it treats all states equally, regardless of their learning potential. We propose Regret-Guided Search Control (RGSC), which extends AlphaZero with a regret network that learns to identify high-regret states, where the agent's evaluation diverges most from the actual outcome. These states are collected from both self-play trajectories and MCTS nodes, stored in a prioritized regret buffer, and reused as new starting positions. Across 9x9 Go, 10x10 Othello, and 11x11 Hex, RGSC outperforms AlphaZero and Go-Exploit by an average of 77 and 89 Elo, respectively. When training on a well-trained 9x9 Go model, RGSC further improves the win rate against KataGo from 69.3% to 78.2%, while both baselines show no improvement. These results demonstrate that RGSC provides an effective mechanism for search control, improving both efficiency and robustness of AlphaZero training. Our code is available at https://rlg.iis.sinica.edu.tw/papers/rgsc."},{"descriptionType":"Other","description":"Accepted by the Fourteenth International Conference on Learning Representations (ICLR 2026)"}],"geoLocations":[],"fundingReferences":[],"url":"https://arxiv.org/abs/2602.20809","contentUrl":null,"metadataVersion":0,"schemaVersion":"http://datacite.org/schema/kernel-4","source":"mds","isActive":true,"state":"findable","reason":null,"viewCount":0,"downloadCount":0,"referenceCount":0,"citationCount":0,"partCount":0,"partOfCount":0,"versionCount":0,"versionOfCount":0,"created":"2026-02-25T02:59:03Z","registered":"2026-02-25T02:59:04Z","published":null,"updated":"2026-02-25T02:59:04Z"},"relationships":{"client":{"data":{"id":"arxiv.content","type":"clients"}}}},{"id":"10.48550/arxiv.2602.20808","type":"dois","attributes":{"doi":"10.48550/arxiv.2602.20808","identifiers":[{"identifier":"2602.20808","identifierType":"arXiv"}],"creators":[{"nameType":"Personal","givenName":"Bouderbala","familyName":"Mihoub","name":"Mihoub, Bouderbala","affiliation":[],"nameIdentifiers":[]}],"titles":[{"title":"On the Asymptotic Behavior of a Multiplicative Arithmetic Function Related to the Divisor Function Over Perfect Squares Integers Generated by Shifting"}],"publisher":"arXiv","container":{},"publicationYear":2026,"subjects":[{"subject":"Number Theory (math.NT)","lang":"en","subjectScheme":"arXiv"},{"subject":"FOS: Mathematics","subjectScheme":"Fields of Science and Technology (FOS)"},{"schemeUri":"http://www.oecd.org/science/inno/38235147.pdf","subject":"FOS: Mathematics","subjectScheme":"Fields of Science and Technology (FOS)"},{"subject":"11A25, 11N37","lang":"en","subjectScheme":"MSC"}],"contributors":[],"dates":[{"date":"2026-02-24T11:47:44Z","dateType":"Submitted","dateInformation":"v1"},{"date":"2026-02-25T01:43:17Z","dateType":"Updated","dateInformation":"v1"},{"date":"2026-02","dateType":"Available","dateInformation":"v1"},{"date":"2026","dateType":"Issued"}],"language":null,"types":{"schemaOrg":"CreativeWork","resourceTypeGeneral":"Preprint","citeproc":"article","bibtex":"misc","ris":"GEN","resourceType":"Article"},"relatedIdentifiers":[],"relatedItems":[],"sizes":[],"formats":[],"version":"1","rightsList":[{"rightsUri":"http://arxiv.org/licenses/nonexclusive-distrib/1.0/","rights":"arXiv.org perpetual, non-exclusive license"}],"descriptions":[{"descriptionType":"Abstract","description":"Let $x$ be a real number satisfying $x \\geq 2$. For any positive integer $n$, we define $s(n)$ as the smallest non-negative integer such that $n + s(n)$ is a perfect square. In this paper, we derive an asymptotic formula for the sum \\begin{equation*} \\sum_{n \\leq x} D(n + s(n)), \\end{equation*} where \\begin{equation*} D(n) = \\frac{τ(n)}{2^{ω(n)}}. \\end{equation*} Here, $τ(n)$ denotes the number of positive divisors of $n$, and $ω(n)$ stands for the number of distinct prime factors of $n$."},{"descriptionType":"Other","description":"8 pages"}],"geoLocations":[],"fundingReferences":[],"url":"https://arxiv.org/abs/2602.20808","contentUrl":null,"metadataVersion":0,"schemaVersion":"http://datacite.org/schema/kernel-4","source":"mds","isActive":true,"state":"findable","reason":null,"viewCount":0,"downloadCount":0,"referenceCount":0,"citationCount":0,"partCount":0,"partOfCount":0,"versionCount":0,"versionOfCount":0,"created":"2026-02-25T02:59:02Z","registered":"2026-02-25T02:59:02Z","published":null,"updated":"2026-02-25T02:59:02Z"},"relationships":{"client":{"data":{"id":"arxiv.content","type":"clients"}}}},{"id":"10.48550/arxiv.2602.20806","type":"dois","attributes":{"doi":"10.48550/arxiv.2602.20806","identifiers":[{"identifier":"2602.20806","identifierType":"arXiv"}],"creators":[{"nameType":"Personal","givenName":"Masahiko","familyName":"Sato","name":"Sato, Masahiko","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Yuki","familyName":"Kimura","name":"Kimura, Yuki","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Tadahiro","familyName":"Hatakeyama","name":"Hatakeyama, Tadahiro","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Tomoki","familyName":"Nakamura","name":"Nakamura, Tomoki","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Satoshi","familyName":"Okuzumi","name":"Okuzumi, Satoshi","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Sei-ichiro","familyName":"Watanabe","name":"Watanabe, Sei-ichiro","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Seiji","familyName":"Sugita","name":"Sugita, Seiji","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Satoshi","familyName":"Tanaka","name":"Tanaka, Satoshi","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Shogo","familyName":"Tachibana","name":"Tachibana, Shogo","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Hisayoshi","familyName":"Yurimoto","name":"Yurimoto, Hisayoshi","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Takaaki","familyName":"Noguchi","name":"Noguchi, Takaaki","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Ryuji","familyName":"Okazaki","name":"Okazaki, Ryuji","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Hikaru","familyName":"Yabuta","name":"Yabuta, Hikaru","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Hiroshi","familyName":"Naraoka","name":"Naraoka, Hiroshi","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Kanako","familyName":"Sakamoto","name":"Sakamoto, Kanako","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Toru","familyName":"Yada","name":"Yada, Toru","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Masahiro","familyName":"Nishimura","name":"Nishimura, Masahiro","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Aiko","familyName":"Nakato","name":"Nakato, Aiko","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Akiko","familyName":"Miyazaki","name":"Miyazaki, Akiko","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Kasumi","familyName":"Yogata","name":"Yogata, Kasumi","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Masanao","familyName":"Abe","name":"Abe, Masanao","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Tatsuaki","familyName":"Okada","name":"Okada, Tatsuaki","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Tomohiro","familyName":"Usui","name":"Usui, Tomohiro","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Makoto","familyName":"Yoshikawa","name":"Yoshikawa, Makoto","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Takanao","familyName":"Saiki","name":"Saiki, Takanao","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Fuyuto","familyName":"Terui","name":"Terui, Fuyuto","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Satoru","familyName":"Nakazawa","name":"Nakazawa, Satoru","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Yuichi","familyName":"Tsuda","name":"Tsuda, Yuichi","affiliation":[],"nameIdentifiers":[]}],"titles":[{"title":"Characteristics of natural remanence records in fine-grained particles returned from asteroid Ryugu"}],"publisher":"arXiv","container":{},"publicationYear":2026,"subjects":[{"subject":"Earth and Planetary Astrophysics (astro-ph.EP)","lang":"en","subjectScheme":"arXiv"},{"subject":"Geophysics (physics.geo-ph)","lang":"en","subjectScheme":"arXiv"},{"subject":"FOS: Physical sciences","subjectScheme":"Fields of Science and Technology (FOS)"},{"schemeUri":"http://www.oecd.org/science/inno/38235147.pdf","subject":"FOS: Physical sciences","subjectScheme":"Fields of Science and Technology (FOS)"}],"contributors":[],"dates":[{"date":"2026-02-24T11:46:42Z","dateType":"Submitted","dateInformation":"v1"},{"date":"2026-02-25T01:43:14Z","dateType":"Updated","dateInformation":"v1"},{"date":"2026-02","dateType":"Available","dateInformation":"v1"},{"date":"2026","dateType":"Issued"}],"language":null,"types":{"schemaOrg":"CreativeWork","resourceTypeGeneral":"Preprint","citeproc":"article","bibtex":"misc","ris":"GEN","resourceType":"Article"},"relatedIdentifiers":[{"relationType":"IsVersionOf","relatedIdentifier":"10.1029/2025je009265","relatedIdentifierType":"DOI"}],"relatedItems":[],"sizes":[],"formats":[],"version":"1","rightsList":[{"rightsUri":"http://arxiv.org/licenses/nonexclusive-distrib/1.0/","rights":"arXiv.org perpetual, non-exclusive license"}],"descriptions":[{"descriptionType":"Abstract","description":"Particles collected from the asteroid Ryugu by the Hayabusa2 spacecraft offer a unique opportunity to investigate the magnetic record of the primitive solar system, as any terrestrial magnetic contamination is minimal and can be accounted for. In previous studies, stepwise alternating field demagnetization (AFD) measurements of natural remanent magnetization (NRM) records have been conducted on seven Ryugu particles. However, due to the limited number of samples, there is no consensus regarding the interpretation of the results of these measurements. To address this problem, we performed stepwise AFD measurements of the NRM on 28 Ryugu particles. Twenty-three of the particles exhibited one or two stable NRM components, whereas the remaining five did not. Isothermal remanent magnetization-based paleointensity values derived from stable NRM components varied by more than one order of magnitude. These NRM characteristics were consistent with those observed in previous studies. Therefore, as a reflection of the original nature of the NRM record, some Ryugu particles exhibited stable NRM components, whereas others did not. The Ryugu particles investigated in this study and those from a previous study exhibited spatially inhomogeneous NRM directions within individual particles, constraining the NRM acquisition time to before the final solidification of the current Ryugu particles. A mechanism of remanence acquisition that can explain the observed NRM characteristics is a chemical remanent magnetization associated with the growth of framboidal magnetite during aqueous alteration in Ryugu's parent body."},{"descriptionType":"Other","description":"Published in JGR Planets"}],"geoLocations":[],"fundingReferences":[],"url":"https://arxiv.org/abs/2602.20806","contentUrl":null,"metadataVersion":0,"schemaVersion":"http://datacite.org/schema/kernel-4","source":"mds","isActive":true,"state":"findable","reason":null,"viewCount":0,"downloadCount":0,"referenceCount":0,"citationCount":0,"partCount":0,"partOfCount":0,"versionCount":0,"versionOfCount":1,"created":"2026-02-25T02:58:59Z","registered":"2026-02-25T02:58:59Z","published":null,"updated":"2026-02-25T02:58:59Z"},"relationships":{"client":{"data":{"id":"arxiv.content","type":"clients"}}}},{"id":"10.48550/arxiv.2602.20805","type":"dois","attributes":{"doi":"10.48550/arxiv.2602.20805","identifiers":[{"identifier":"2602.20805","identifierType":"arXiv"}],"creators":[{"nameType":"Personal","givenName":"Anh-Tuan","familyName":"Dao","name":"Dao, Anh-Tuan","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Driss","familyName":"Matrouf","name":"Matrouf, Driss","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Nicholas","familyName":"Evans","name":"Evans, Nicholas","affiliation":[],"nameIdentifiers":[]}],"titles":[{"title":"Assessing the Impact of Speaker Identity in Speech Spoofing Detection"}],"publisher":"arXiv","container":{},"publicationYear":2026,"subjects":[{"subject":"Sound (cs.SD)","lang":"en","subjectScheme":"arXiv"},{"subject":"Machine Learning (cs.LG)","lang":"en","subjectScheme":"arXiv"},{"subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"},{"schemeUri":"http://www.oecd.org/science/inno/38235147.pdf","subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"}],"contributors":[],"dates":[{"date":"2026-02-24T11:45:41Z","dateType":"Submitted","dateInformation":"v1"},{"date":"2026-02-25T01:43:11Z","dateType":"Updated","dateInformation":"v1"},{"date":"2026-02","dateType":"Available","dateInformation":"v1"},{"date":"2026","dateType":"Issued"}],"language":null,"types":{"schemaOrg":"CreativeWork","resourceTypeGeneral":"Preprint","citeproc":"article","bibtex":"misc","ris":"GEN","resourceType":"Article"},"relatedIdentifiers":[],"relatedItems":[],"sizes":[],"formats":[],"version":"1","rightsList":[{"rightsIdentifierScheme":"SPDX","rightsUri":"https://creativecommons.org/licenses/by-nc-sa/4.0/legalcode","schemeUri":"https://spdx.org/licenses/","rights":"Creative Commons Attribution Non Commercial Share Alike 4.0 International","rightsIdentifier":"cc-by-nc-sa-4.0"}],"descriptions":[{"descriptionType":"Abstract","description":"Spoofing detection systems are typically trained using diverse recordings from multiple speakers, often assuming that the resulting embeddings are independent of speaker identity. However, this assumption remains unverified. In this paper, we investigate the impact of speaker information on spoofing detection systems. We propose two approaches within our Speaker-Invariant Multi-Task framework, one that models speaker identity within the embeddings and another that removes it. SInMT integrates multi-task learning for joint speaker recognition and spoofing detection, incorporating a gradient reversal layer. Evaluated using four datasets, our speaker-invariant model reduces the average equal error rate by 17% compared to the baseline, with up to 48% reduction for the most challenging attacks (e.g., A11)."}],"geoLocations":[],"fundingReferences":[],"url":"https://arxiv.org/abs/2602.20805","contentUrl":null,"metadataVersion":0,"schemaVersion":"http://datacite.org/schema/kernel-4","source":"mds","isActive":true,"state":"findable","reason":null,"viewCount":0,"downloadCount":0,"referenceCount":0,"citationCount":0,"partCount":0,"partOfCount":0,"versionCount":0,"versionOfCount":0,"created":"2026-02-25T02:58:57Z","registered":"2026-02-25T02:58:58Z","published":null,"updated":"2026-02-25T02:58:58Z"},"relationships":{"client":{"data":{"id":"arxiv.content","type":"clients"}}}},{"id":"10.48550/arxiv.2602.20803","type":"dois","attributes":{"doi":"10.48550/arxiv.2602.20803","identifiers":[{"identifier":"2602.20803","identifierType":"arXiv"}],"creators":[{"nameType":"Personal","givenName":"Gilad","familyName":"Yakir","name":"Yakir, Gilad","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Eduardo","familyName":"Gutierrez-Prieto","name":"Gutierrez-Prieto, Eduardo","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Pedro M.","familyName":"Reis","name":"Reis, Pedro M.","affiliation":[],"nameIdentifiers":[]}],"titles":[{"title":"Dynamic versus quasi-static response of a cantilevered beam rotated harmonically"}],"publisher":"arXiv","container":{},"publicationYear":2026,"subjects":[{"subject":"Soft Condensed Matter (cond-mat.soft)","lang":"en","subjectScheme":"arXiv"},{"subject":"FOS: Physical sciences","subjectScheme":"Fields of Science and Technology (FOS)"},{"schemeUri":"http://www.oecd.org/science/inno/38235147.pdf","subject":"FOS: Physical sciences","subjectScheme":"Fields of Science and Technology (FOS)"}],"contributors":[],"dates":[{"date":"2026-02-24T11:44:18Z","dateType":"Submitted","dateInformation":"v1"},{"date":"2026-02-25T01:43:05Z","dateType":"Updated","dateInformation":"v1"},{"date":"2026-02","dateType":"Available","dateInformation":"v1"},{"date":"2026","dateType":"Issued"}],"language":null,"types":{"schemaOrg":"CreativeWork","resourceTypeGeneral":"Preprint","citeproc":"article","bibtex":"misc","ris":"GEN","resourceType":"Article"},"relatedIdentifiers":[],"relatedItems":[],"sizes":[],"formats":[],"version":"1","rightsList":[{"rightsUri":"http://arxiv.org/licenses/nonexclusive-distrib/1.0/","rights":"arXiv.org perpetual, non-exclusive license"}],"descriptions":[{"descriptionType":"Abstract","description":"We investigate a cantilevered elastic beam subjected to harmonic rotational motion. In the rotating frame, the beam experiences centrifugal and Euler fictitious forces, with negligible Coriolis effects. We validate a reduced-order \\textit{elastica} model through precision experiments on slender beams rotating with a controlled sinusoidal angular velocity. Systematically exploring the parameter space, we identify regimes where inertial effects are negligible, enabling a quasi-static treatment despite harmonic driving. We characterize the transition to dynamic response using two dimensionless parameters, the Euler and centrifugal numbers, which compare centrifugal and Euler forces to bending forces. Counterintuitively, the quasi-static regime expands as rotational speed increases: faster rotation produces less dynamic response. The critical Euler number separating these regimes remains constant at low centrifugal numbers but follows square-root scaling at higher rotation rates, a transition driven by centrifugal stiffening. Our results establish the conditions under which quasi-static approximations remain valid for rotating flexible beams under harmonic driving."}],"geoLocations":[],"fundingReferences":[],"url":"https://arxiv.org/abs/2602.20803","contentUrl":null,"metadataVersion":0,"schemaVersion":"http://datacite.org/schema/kernel-4","source":"mds","isActive":true,"state":"findable","reason":null,"viewCount":0,"downloadCount":0,"referenceCount":0,"citationCount":0,"partCount":0,"partOfCount":0,"versionCount":0,"versionOfCount":0,"created":"2026-02-25T02:58:54Z","registered":"2026-02-25T02:58:55Z","published":null,"updated":"2026-02-25T02:58:55Z"},"relationships":{"client":{"data":{"id":"arxiv.content","type":"clients"}}}},{"id":"10.48550/arxiv.2602.20801","type":"dois","attributes":{"doi":"10.48550/arxiv.2602.20801","identifiers":[{"identifier":"2602.20801","identifierType":"arXiv"}],"creators":[{"nameType":"Personal","givenName":"S. I.","familyName":"Dimitrov","name":"Dimitrov, S. I.","affiliation":[],"nameIdentifiers":[]}],"titles":[{"title":"A Diophantine inequality with five squares of Piatetski-Shapiro primes"}],"publisher":"arXiv","container":{},"publicationYear":2026,"subjects":[{"subject":"Number Theory (math.NT)","lang":"en","subjectScheme":"arXiv"},{"subject":"FOS: Mathematics","subjectScheme":"Fields of Science and Technology (FOS)"},{"schemeUri":"http://www.oecd.org/science/inno/38235147.pdf","subject":"FOS: Mathematics","subjectScheme":"Fields of Science and Technology (FOS)"}],"contributors":[],"dates":[{"date":"2026-02-24T11:42:55Z","dateType":"Submitted","dateInformation":"v1"},{"date":"2026-02-25T01:43:04Z","dateType":"Updated","dateInformation":"v1"},{"date":"2026-02","dateType":"Available","dateInformation":"v1"},{"date":"2026","dateType":"Issued"}],"language":null,"types":{"schemaOrg":"CreativeWork","resourceTypeGeneral":"Preprint","citeproc":"article","bibtex":"misc","ris":"GEN","resourceType":"Article"},"relatedIdentifiers":[],"relatedItems":[],"sizes":[],"formats":[],"version":"1","rightsList":[{"rightsUri":"http://arxiv.org/licenses/nonexclusive-distrib/1.0/","rights":"arXiv.org perpetual, non-exclusive license"}],"descriptions":[{"descriptionType":"Abstract","description":"Let $[\\,\\cdot\\,]$ denote the floor function. Assume that $λ_1, λ_2, λ_3, λ_4, λ_5$ are nonzero real numbers, not all of the same sign, that $λ_1/λ_2$ is irrational, and that $η$ is a real number. Let $\\frac{71}{72}\u0026lt;γ\u0026lt;1$ and $θ\u0026gt;0$. We prove that there exist infinitely many quintuples of primes $p_1,\\, p_2,\\, p_3,\\, p_4,\\, p_5$ satisfying the Diophantine inequality \\begin{equation*} \\big|λ_1p^2_1 + λ_2p^2_2 + λ_3p^2_3+ λ_4p^2_4 + λ_5p^2_5+η\\big|\u0026lt;\\big(\\max p_j\\big)^{\\frac{71-72γ}{29}+θ}\\,, \\end{equation*} where $p_i=[n_i^{1/γ}]$, $i=1,\\,2,\\,3,\\,4,\\,5$. We also prove analogous theorems by raising the last variable in the inequality to the third and fourth powers."}],"geoLocations":[],"fundingReferences":[],"url":"https://arxiv.org/abs/2602.20801","contentUrl":null,"metadataVersion":0,"schemaVersion":"http://datacite.org/schema/kernel-4","source":"mds","isActive":true,"state":"findable","reason":null,"viewCount":0,"downloadCount":0,"referenceCount":0,"citationCount":0,"partCount":0,"partOfCount":0,"versionCount":0,"versionOfCount":0,"created":"2026-02-25T02:58:51Z","registered":"2026-02-25T02:58:52Z","published":null,"updated":"2026-02-25T02:58:52Z"},"relationships":{"client":{"data":{"id":"arxiv.content","type":"clients"}}}},{"id":"10.48550/arxiv.2602.20799","type":"dois","attributes":{"doi":"10.48550/arxiv.2602.20799","identifiers":[{"identifier":"2602.20799","identifierType":"arXiv"}],"creators":[{"nameType":"Personal","givenName":"Guangsheng","familyName":"Ou","name":"Ou, Guangsheng","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Qiming","familyName":"Zhang","name":"Zhang, Qiming","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Sirong","familyName":"Chen","name":"Chen, Sirong","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Anji","familyName":"Li","name":"Li, Anji","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Dong","familyName":"Xu","name":"Xu, Dong","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Tiancheng","familyName":"Luo","name":"Luo, Tiancheng","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Dekun","familyName":"Dai","name":"Dai, Dekun","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Cuiyun","familyName":"Gao","name":"Gao, Cuiyun","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Long","familyName":"Wang","name":"Wang, Long","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Jun","familyName":"Zhou","name":"Zhou, Jun","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Mingwei","familyName":"Liu","name":"Liu, Mingwei","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Zibin","familyName":"Zheng","name":"Zheng, Zibin","affiliation":[],"nameIdentifiers":[]}],"titles":[{"title":"Unseen-Codebases-Domain Data Synthesis and Training Based on Code Graphs"}],"publisher":"arXiv","container":{},"publicationYear":2026,"subjects":[{"subject":"Software Engineering (cs.SE)","lang":"en","subjectScheme":"arXiv"},{"subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"},{"schemeUri":"http://www.oecd.org/science/inno/38235147.pdf","subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"}],"contributors":[],"dates":[{"date":"2026-02-24T11:36:34Z","dateType":"Submitted","dateInformation":"v1"},{"date":"2026-02-25T01:42:59Z","dateType":"Updated","dateInformation":"v1"},{"date":"2026-02","dateType":"Available","dateInformation":"v1"},{"date":"2026","dateType":"Issued"}],"language":null,"types":{"schemaOrg":"CreativeWork","resourceTypeGeneral":"Preprint","citeproc":"article","bibtex":"misc","ris":"GEN","resourceType":"Article"},"relatedIdentifiers":[],"relatedItems":[],"sizes":[],"formats":[],"version":"1","rightsList":[{"rightsIdentifierScheme":"SPDX","rightsUri":"https://creativecommons.org/licenses/by/4.0/legalcode","schemeUri":"https://spdx.org/licenses/","rights":"Creative Commons Attribution 4.0 International","rightsIdentifier":"cc-by-4.0"}],"descriptions":[{"descriptionType":"Abstract","description":"In the context of newly release software frameworks, large language models (LLMs) often exhibit poor performance and a high rate of hallucination, as they are not exposed to such environments during training. Although inference-time augmentation techniques such as retrieval-augmented generation (RAG) can partially mitigate hallucinations, knowledge injection through prompting alone is insufficient to enable models to fully understand the intrinsic relationships among different components of a codebase, or to reason about the correct compositions and apply. Although explicit knowledge injection can be achieved through post-training, compared with public code domains, unseen codebases typically provide only source code and lack large volumes of high-quality, usage-oriented code that can be directly leveraged as training data. Consequently, existing data synthesis approaches are insufficient to adequately capture unseen codebases usage scenarios when restricted to source code alone. To address these challenges, we propose UCD-Training, a two-stage training framework for reasoning-aware data synthesis grounded in a code graph constructed from unseen codebases. UCD-Training first parses the source code to build a code graph, then conducts dependency-preserving continued pretraining (CPT) using file-level dependency data, followed by graph-grounded supervised fine-tuning (SFT) on three types of synthesized data augmented with explicit reasoning traces: (1) single-hop relation reasoning data, (2) compositional API reasoning data, and (3) codebase utilization data. We further introduce a new benchmark, UnseenCodeBench, for code generation on unseen codebases and conduct comprehensive experiments across multiple codebases."}],"geoLocations":[],"fundingReferences":[],"url":"https://arxiv.org/abs/2602.20799","contentUrl":null,"metadataVersion":0,"schemaVersion":"http://datacite.org/schema/kernel-4","source":"mds","isActive":true,"state":"findable","reason":null,"viewCount":0,"downloadCount":0,"referenceCount":0,"citationCount":0,"partCount":0,"partOfCount":0,"versionCount":0,"versionOfCount":0,"created":"2026-02-25T02:58:48Z","registered":"2026-02-25T02:58:49Z","published":null,"updated":"2026-02-25T02:58:49Z"},"relationships":{"client":{"data":{"id":"arxiv.content","type":"clients"}}}},{"id":"10.48550/arxiv.2602.20798","type":"dois","attributes":{"doi":"10.48550/arxiv.2602.20798","identifiers":[{"identifier":"2602.20798","identifierType":"arXiv"}],"creators":[{"nameType":"Personal","affiliation":["Astronomical Institute, Slovak Academy of Sciences"],"givenName":"Z.","familyName":"Vashalomidze","name":"Vashalomidze, Z.","nameIdentifiers":[]},{"nameType":"Personal","affiliation":["Instituto de Astrofísica de Canarias"],"givenName":"C. Quintero","familyName":"Noda","name":"Noda, C. Quintero","nameIdentifiers":[]},{"nameType":"Personal","affiliation":["AG, Institute of Physics, University of Graz"],"givenName":"T. V.","familyName":"Zaqarashvili","name":"Zaqarashvili, T. V.","nameIdentifiers":[]},{"nameType":"Personal","affiliation":["Astronomical Institute, Slovak Academy of Sciences"],"givenName":"M.","familyName":"Benko","name":"Benko, M.","nameIdentifiers":[]},{"nameType":"Personal","affiliation":["National Solar Observatory"],"givenName":"D.","familyName":"Kuridze","name":"Kuridze, D.","nameIdentifiers":[]},{"nameType":"Personal","affiliation":["Astronomical Institute, Slovak Academy of Sciences"],"givenName":"P.","familyName":"Gömöry","name":"Gömöry, P.","nameIdentifiers":[]},{"nameType":"Personal","affiliation":["Astronomical Institute, Slovak Academy of Sciences"],"givenName":"J.","familyName":"Rybák","name":"Rybák, J.","nameIdentifiers":[]},{"nameType":"Personal","affiliation":["Astronomical Institute, Slovak Academy of Sciences"],"givenName":"S.","familyName":"Lomineishvili","name":"Lomineishvili, S.","nameIdentifiers":[]},{"nameType":"Personal","affiliation":["Instituto de Astrofísica de Canarias"],"givenName":"M.","familyName":"Collados","name":"Collados, M.","nameIdentifiers":[]},{"nameType":"Personal","affiliation":["Leibniz Institute for Astrophysics Potsdam"],"givenName":"C.","familyName":"Denker","name":"Denker, C.","nameIdentifiers":[]},{"nameType":"Personal","affiliation":["Leibniz Institute for Astrophysics Potsdam"],"givenName":"M.","familyName":"Verma","name":"Verma, M.","nameIdentifiers":[]},{"nameType":"Personal","affiliation":["Instituto de Astrofísica de Canarias"],"givenName":"C.","familyName":"Kuckein","name":"Kuckein, C.","nameIdentifiers":[]},{"nameType":"Personal","affiliation":["Instituto de Astrofísica de Canarias"],"givenName":"A. Asensio","familyName":"Ramos","name":"Ramos, A. Asensio","nameIdentifiers":[]}],"titles":[{"title":"Infrared spectropolarimetry of a C-class solar flare footpoint plasma -- I. Spectral features and forward modelling"}],"publisher":"arXiv","container":{},"publicationYear":2026,"subjects":[{"subject":"Solar and Stellar Astrophysics (astro-ph.SR)","lang":"en","subjectScheme":"arXiv"},{"subject":"FOS: Physical sciences","subjectScheme":"Fields of Science and Technology (FOS)"},{"schemeUri":"http://www.oecd.org/science/inno/38235147.pdf","subject":"FOS: Physical sciences","subjectScheme":"Fields of Science and Technology (FOS)"}],"contributors":[],"dates":[{"date":"2026-02-24T11:36:04Z","dateType":"Submitted","dateInformation":"v1"},{"date":"2026-02-25T01:42:57Z","dateType":"Updated","dateInformation":"v1"},{"date":"2026-02","dateType":"Available","dateInformation":"v1"},{"date":"2026","dateType":"Issued"}],"language":null,"types":{"schemaOrg":"CreativeWork","resourceTypeGeneral":"Preprint","citeproc":"article","bibtex":"misc","ris":"GEN","resourceType":"Article"},"relatedIdentifiers":[{"relationType":"IsVersionOf","relatedIdentifier":"10.1051/0004-6361/202557526","relatedIdentifierType":"DOI"}],"relatedItems":[],"sizes":[],"formats":[],"version":"1","rightsList":[{"rightsIdentifierScheme":"SPDX","rightsUri":"https://creativecommons.org/publicdomain/zero/1.0/legalcode","schemeUri":"https://spdx.org/licenses/","rights":"Creative Commons Zero v1.0 Universal","rightsIdentifier":"cc0-1.0"}],"descriptions":[{"descriptionType":"Abstract","description":"We performed high-spatial resolution spectropolarimetric observations of active region NOAA 13363 during a C-class flare with the Gregor Infrared Spectrograph (GRIS) on 16 July 2023. We examine the coupling between the photosphere and the chromosphere, studying the polarimetric signals during a period that encompasses the decaying phase of a C-class flare and the appearance of a new C-class flare at the same location. We focus on the analysis of various spectral lines. In particular, we study the Si I 10827 Å, Ca I 10833.4 Å, Na I 10834.9 Å, and Ca I 10838.9 Å photospheric lines, as well as the He I 10830 Å triplet. GRIS data revealed the presence of flare-related red- and blueshifted spectral line components, reaching Doppler velocities up to 90 km/s, and complex Si I profiles where the He i spectral line contribution is blueshifted. In contrast, the photospheric Ca i and Na i transitions remained unchanged, indicating that the flare did not modify the physical conditions of the lower photosphere. We combined that information with simultaneous imaging in the Ca ii H line and TiO band with the improved High-resolution Fast Imager (HiFI+), finding that the flare emission did not affect the inverse granulation or nearby plage, in agreement with the results from GRIS. We also complement the previous studies with a forward modelling computation, concluding that the He I spectral line emission reflects a complex response of the flaring chromosphere. Radiative excitation from coronal EUV irradiation, energy deposition by flare-accelerated electrons, and dynamic field-aligned plasma flows likely act together to produce the observed supersonic downflows and upflows. We plan to expand these findings through inversions of the He I 10830 Å triplet signals in the future."},{"descriptionType":"Other","description":"Published in A\u0026amp;A, 10 pages, 8 figures,"}],"geoLocations":[],"fundingReferences":[],"url":"https://arxiv.org/abs/2602.20798","contentUrl":null,"metadataVersion":0,"schemaVersion":"http://datacite.org/schema/kernel-4","source":"mds","isActive":true,"state":"findable","reason":null,"viewCount":0,"downloadCount":0,"referenceCount":0,"citationCount":0,"partCount":0,"partOfCount":0,"versionCount":0,"versionOfCount":1,"created":"2026-02-25T02:58:47Z","registered":"2026-02-25T02:58:48Z","published":null,"updated":"2026-02-25T02:58:48Z"},"relationships":{"client":{"data":{"id":"arxiv.content","type":"clients"}}}},{"id":"10.48550/arxiv.2602.20797","type":"dois","attributes":{"doi":"10.48550/arxiv.2602.20797","identifiers":[{"identifier":"2602.20797","identifierType":"arXiv"}],"creators":[{"nameType":"Organizational","affiliation":[],"name":"Nayanthara","nameIdentifiers":[]},{"nameType":"Personal","givenName":"Noufal","familyName":"Asharaf","name":"Asharaf, Noufal","affiliation":[],"nameIdentifiers":[]}],"titles":[{"title":"Non-negative persymmetric realizability of certain classes of spectra"}],"publisher":"arXiv","container":{},"publicationYear":2026,"subjects":[{"subject":"Spectral Theory (math.SP)","lang":"en","subjectScheme":"arXiv"},{"subject":"FOS: Mathematics","subjectScheme":"Fields of Science and Technology (FOS)"},{"schemeUri":"http://www.oecd.org/science/inno/38235147.pdf","subject":"FOS: Mathematics","subjectScheme":"Fields of Science and Technology (FOS)"}],"contributors":[],"dates":[{"date":"2026-02-24T11:35:17Z","dateType":"Submitted","dateInformation":"v1"},{"date":"2026-02-25T01:42:56Z","dateType":"Updated","dateInformation":"v1"},{"date":"2026-02","dateType":"Available","dateInformation":"v1"},{"date":"2026","dateType":"Issued"}],"language":null,"types":{"schemaOrg":"CreativeWork","resourceTypeGeneral":"Preprint","citeproc":"article","bibtex":"misc","ris":"GEN","resourceType":"Article"},"relatedIdentifiers":[],"relatedItems":[],"sizes":[],"formats":[],"version":"1","rightsList":[{"rightsIdentifierScheme":"SPDX","rightsUri":"https://creativecommons.org/licenses/by/4.0/legalcode","schemeUri":"https://spdx.org/licenses/","rights":"Creative Commons Attribution 4.0 International","rightsIdentifier":"cc-by-4.0"}],"descriptions":[{"descriptionType":"Abstract","description":"Identifying the collection of scalars that represent a non-negative matrix's eigenvalues is known as the non-negative inverse eigenvalue problem (NIEP). Conditions for the existence of a non-negative matrix with a certain spectrum are examined in this work. The classical NIEP restricted to non-negative matrices having a persymmetric structure is the persymmetric non-negative inverse eigenvalue problem (PNIEP). We resolve the open problem stated in \\cite{Ana}, and furthermore, equivalence of the PNIEP and NIEP is established for trace-zero spectra of five complex numbers. Also we obtain new sufficient conditions for the realizability of certain classes of spectra with non-negative persymmetric matrix realization. Based on generic structural features of persymmetric matrices and their characteristic polynomials, our method is constructive in nature. The effects of perturbations on imaginary part of complex eigenvalues are also analyzed and some perturbation results are derived."},{"descriptionType":"Other","description":"24 pages"}],"geoLocations":[],"fundingReferences":[],"url":"https://arxiv.org/abs/2602.20797","contentUrl":null,"metadataVersion":0,"schemaVersion":"http://datacite.org/schema/kernel-4","source":"mds","isActive":true,"state":"findable","reason":null,"viewCount":0,"downloadCount":0,"referenceCount":0,"citationCount":0,"partCount":0,"partOfCount":0,"versionCount":0,"versionOfCount":0,"created":"2026-02-25T02:58:45Z","registered":"2026-02-25T02:58:46Z","published":null,"updated":"2026-02-25T02:58:46Z"},"relationships":{"client":{"data":{"id":"arxiv.content","type":"clients"}}}},{"id":"10.48550/arxiv.2602.20796","type":"dois","attributes":{"doi":"10.48550/arxiv.2602.20796","identifiers":[{"identifier":"2602.20796","identifierType":"arXiv"}],"creators":[{"nameType":"Personal","givenName":"JinLi","familyName":"He","name":"He, JinLi","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Liang","familyName":"Bai","name":"Bai, Liang","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Xian","familyName":"Yang","name":"Yang, Xian","affiliation":[],"nameIdentifiers":[]}],"titles":[{"title":"Exploring the Impact of Parameter Update Magnitude on Forgetting and Generalization of Continual Learning"}],"publisher":"arXiv","container":{},"publicationYear":2026,"subjects":[{"subject":"Machine Learning (cs.LG)","lang":"en","subjectScheme":"arXiv"},{"subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"},{"schemeUri":"http://www.oecd.org/science/inno/38235147.pdf","subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"}],"contributors":[],"dates":[{"date":"2026-02-24T11:35:15Z","dateType":"Submitted","dateInformation":"v1"},{"date":"2026-02-25T01:42:55Z","dateType":"Updated","dateInformation":"v1"},{"date":"2026-02","dateType":"Available","dateInformation":"v1"},{"date":"2026","dateType":"Issued"}],"language":null,"types":{"schemaOrg":"CreativeWork","resourceTypeGeneral":"Preprint","citeproc":"article","bibtex":"misc","ris":"GEN","resourceType":"Article"},"relatedIdentifiers":[],"relatedItems":[],"sizes":[],"formats":[],"version":"1","rightsList":[{"rightsUri":"http://arxiv.org/licenses/nonexclusive-distrib/1.0/","rights":"arXiv.org perpetual, non-exclusive license"}],"descriptions":[{"descriptionType":"Abstract","description":"The magnitude of parameter updates are considered a key factor in continual learning. However, most existing studies focus on designing diverse update strategies, while a theoretical understanding of the underlying mechanisms remains limited. Therefore, we characterize model's forgetting from the perspective of parameter update magnitude and formalize it as knowledge degradation induced by task-specific drift in the parameter space, which has not been fully captured in previous studies due to their assumption of a unified parameter space. By deriving the optimal parameter update magnitude that minimizes forgetting, we unify two representative update paradigms, frozen training and initialized training, within an optimization framework for constrained parameter updates. Our theoretical results further reveals that sequence tasks with small parameter distances exhibit better generalization and less forgetting under frozen training rather than initialized training. These theoretical insights inspire a novel hybrid parameter update strategy that adaptively adjusts update magnitude based on gradient directions. Experiments on deep neural networks demonstrate that this hybrid approach outperforms standard training strategies, providing new theoretical perspectives and practical inspiration for designing efficient and scalable continual learning algorithms."}],"geoLocations":[],"fundingReferences":[],"url":"https://arxiv.org/abs/2602.20796","contentUrl":null,"metadataVersion":0,"schemaVersion":"http://datacite.org/schema/kernel-4","source":"mds","isActive":true,"state":"findable","reason":null,"viewCount":0,"downloadCount":0,"referenceCount":0,"citationCount":0,"partCount":0,"partOfCount":0,"versionCount":0,"versionOfCount":0,"created":"2026-02-25T02:58:44Z","registered":"2026-02-25T02:58:45Z","published":null,"updated":"2026-02-25T02:58:45Z"},"relationships":{"client":{"data":{"id":"arxiv.content","type":"clients"}}}},{"id":"10.48550/arxiv.2602.20795","type":"dois","attributes":{"doi":"10.48550/arxiv.2602.20795","identifiers":[{"identifier":"2602.20795","identifierType":"arXiv"}],"creators":[{"nameType":"Personal","givenName":"Xinhui","familyName":"Rong","name":"Rong, Xinhui","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Girish N.","familyName":"Nair","name":"Nair, Girish N.","affiliation":[],"nameIdentifiers":[]}],"titles":[{"title":"Hawkes Identification with a Prescribed Causal Basis: Closed-Form Estimators and Asymptotics"}],"publisher":"arXiv","container":{},"publicationYear":2026,"subjects":[{"subject":"Methodology (stat.ME)","lang":"en","subjectScheme":"arXiv"},{"subject":"Systems and Control (eess.SY)","lang":"en","subjectScheme":"arXiv"},{"subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"},{"schemeUri":"http://www.oecd.org/science/inno/38235147.pdf","subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"},{"subject":"FOS: Electrical engineering, electronic engineering, information engineering","subjectScheme":"Fields of Science and Technology (FOS)"},{"schemeUri":"http://www.oecd.org/science/inno/38235147.pdf","subject":"FOS: Electrical engineering, electronic engineering, information engineering","subjectScheme":"Fields of Science and Technology (FOS)"}],"contributors":[],"dates":[{"date":"2026-02-24T11:34:33Z","dateType":"Submitted","dateInformation":"v1"},{"date":"2026-02-25T01:42:54Z","dateType":"Updated","dateInformation":"v1"},{"date":"2026-02","dateType":"Available","dateInformation":"v1"},{"date":"2026","dateType":"Issued"}],"language":null,"types":{"schemaOrg":"CreativeWork","resourceTypeGeneral":"Preprint","citeproc":"article","bibtex":"misc","ris":"GEN","resourceType":"Article"},"relatedIdentifiers":[],"relatedItems":[],"sizes":[],"formats":[],"version":"1","rightsList":[{"rightsIdentifierScheme":"SPDX","rightsUri":"https://creativecommons.org/licenses/by-nc-nd/4.0/legalcode","schemeUri":"https://spdx.org/licenses/","rights":"Creative Commons Attribution Non Commercial No Derivatives 4.0 International","rightsIdentifier":"cc-by-nc-nd-4.0"}],"descriptions":[{"descriptionType":"Abstract","description":"Driven by the recent surge in neural-inspired modeling, point processes have gained significant traction in systems and control. While the Hawkes process is the standard model for characterizing random event sequences with memory, identifying its unknown kernels is often hindered by nonlinearity. Approaches using prescribed basis kernels have emerged to enable linear parameterization, yet they typically rely on iterative likelihood methods and lack rigorous analysis under model misspecification. This paper justifies a closed-form Least Squares identification framework for Hawkes processes with prescribed kernels. We guarantee estimator existence via the almost-sure positive definiteness of the empirical Gram matrix and prove convergence to the true parameters under correct specification, or to well-defined pseudo-true parameters under misspecification. Furthermore, we derive explicit Central Limit Theorems for both regimes, providing a complete and interpretable asymptotic theory. We demonstrate these theoretical findings through comparative numerical simulations."},{"descriptionType":"Other","description":"21 pages, 4 figures"}],"geoLocations":[],"fundingReferences":[],"url":"https://arxiv.org/abs/2602.20795","contentUrl":null,"metadataVersion":0,"schemaVersion":"http://datacite.org/schema/kernel-4","source":"mds","isActive":true,"state":"findable","reason":null,"viewCount":0,"downloadCount":0,"referenceCount":0,"citationCount":0,"partCount":0,"partOfCount":0,"versionCount":0,"versionOfCount":0,"created":"2026-02-25T02:58:42Z","registered":"2026-02-25T02:58:43Z","published":null,"updated":"2026-02-25T02:58:43Z"},"relationships":{"client":{"data":{"id":"arxiv.content","type":"clients"}}}},{"id":"10.48550/arxiv.2602.20794","type":"dois","attributes":{"doi":"10.48550/arxiv.2602.20794","identifiers":[{"identifier":"2602.20794","identifierType":"arXiv"}],"creators":[{"nameType":"Personal","givenName":"Jie","familyName":"Wang","name":"Wang, Jie","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Guang","familyName":"Li","name":"Li, Guang","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Zhijian","familyName":"Huang","name":"Huang, Zhijian","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Chenxu","familyName":"Dang","name":"Dang, Chenxu","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Hangjun","familyName":"Ye","name":"Ye, Hangjun","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Yahong","familyName":"Han","name":"Han, Yahong","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Long","familyName":"Chen","name":"Chen, Long","affiliation":[],"nameIdentifiers":[]}],"titles":[{"title":"VGGDrive: Empowering Vision-Language Models with Cross-View Geometric Grounding for Autonomous Driving"}],"publisher":"arXiv","container":{},"publicationYear":2026,"subjects":[{"subject":"Computer Vision and Pattern Recognition (cs.CV)","lang":"en","subjectScheme":"arXiv"},{"subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"},{"schemeUri":"http://www.oecd.org/science/inno/38235147.pdf","subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"}],"contributors":[],"dates":[{"date":"2026-02-24T11:33:44Z","dateType":"Submitted","dateInformation":"v1"},{"date":"2026-02-25T01:42:51Z","dateType":"Updated","dateInformation":"v1"},{"date":"2026-02","dateType":"Available","dateInformation":"v1"},{"date":"2026","dateType":"Issued"}],"language":null,"types":{"schemaOrg":"CreativeWork","resourceTypeGeneral":"Preprint","citeproc":"article","bibtex":"misc","ris":"GEN","resourceType":"Article"},"relatedIdentifiers":[],"relatedItems":[],"sizes":[],"formats":[],"version":"1","rightsList":[{"rightsUri":"http://arxiv.org/licenses/nonexclusive-distrib/1.0/","rights":"arXiv.org perpetual, non-exclusive license"}],"descriptions":[{"descriptionType":"Abstract","description":"The significance of cross-view 3D geometric modeling capabilities for autonomous driving is self-evident, yet existing Vision-Language Models (VLMs) inherently lack this capability, resulting in their mediocre performance. While some promising approaches attempt to mitigate this by constructing Q\u0026amp;A data for auxiliary training, they still fail to fundamentally equip VLMs with the ability to comprehensively handle diverse evaluation protocols. We thus chart a new course, advocating for the infusion of VLMs with the cross-view geometric grounding of mature 3D foundation models, closing this critical capability gap in autonomous driving. In this spirit, we propose a novel architecture, VGGDrive, which empowers Vision-language models with cross-view Geometric Grounding for autonomous Driving. Concretely, to bridge the cross-view 3D geometric features from the frozen visual 3D model with the VLM's 2D visual features, we introduce a plug-and-play Cross-View 3D Geometric Enabler (CVGE). The CVGE decouples the base VLM architecture and effectively empowers the VLM with 3D features through a hierarchical adaptive injection mechanism. Extensive experiments show that VGGDrive enhances base VLM performance across five autonomous driving benchmarks, including tasks like cross-view risk perception, motion prediction, and trajectory planning. It's our belief that mature 3D foundation models can empower autonomous driving tasks through effective integration, and we hope our initial exploration demonstrates the potential of this paradigm to the autonomous driving community."},{"descriptionType":"Other","description":"CVPR 2026"}],"geoLocations":[],"fundingReferences":[],"url":"https://arxiv.org/abs/2602.20794","contentUrl":null,"metadataVersion":0,"schemaVersion":"http://datacite.org/schema/kernel-4","source":"mds","isActive":true,"state":"findable","reason":null,"viewCount":0,"downloadCount":0,"referenceCount":0,"citationCount":0,"partCount":0,"partOfCount":0,"versionCount":0,"versionOfCount":0,"created":"2026-02-25T02:58:41Z","registered":"2026-02-25T02:58:42Z","published":null,"updated":"2026-02-25T02:58:42Z"},"relationships":{"client":{"data":{"id":"arxiv.content","type":"clients"}}}},{"id":"10.48550/arxiv.2602.20791","type":"dois","attributes":{"doi":"10.48550/arxiv.2602.20791","identifiers":[{"identifier":"2602.20791","identifierType":"arXiv"}],"creators":[{"nameType":"Personal","givenName":"JinLi","familyName":"He","name":"He, JinLi","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Liang","familyName":"Bai","name":"Bai, Liang","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Xian","familyName":"Yang","name":"Yang, Xian","affiliation":[],"nameIdentifiers":[]}],"titles":[{"title":"Understanding the Role of Rehearsal Scale in Continual Learning under Varying Model Capacities"}],"publisher":"arXiv","container":{},"publicationYear":2026,"subjects":[{"subject":"Machine Learning (cs.LG)","lang":"en","subjectScheme":"arXiv"},{"subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"},{"schemeUri":"http://www.oecd.org/science/inno/38235147.pdf","subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"}],"contributors":[],"dates":[{"date":"2026-02-24T11:29:12Z","dateType":"Submitted","dateInformation":"v1"},{"date":"2026-02-25T01:42:45Z","dateType":"Updated","dateInformation":"v1"},{"date":"2026-02","dateType":"Available","dateInformation":"v1"},{"date":"2026","dateType":"Issued"}],"language":null,"types":{"schemaOrg":"CreativeWork","resourceTypeGeneral":"Preprint","citeproc":"article","bibtex":"misc","ris":"GEN","resourceType":"Article"},"relatedIdentifiers":[],"relatedItems":[],"sizes":[],"formats":[],"version":"1","rightsList":[{"rightsUri":"http://arxiv.org/licenses/nonexclusive-distrib/1.0/","rights":"arXiv.org perpetual, non-exclusive license"}],"descriptions":[{"descriptionType":"Abstract","description":"Rehearsal is one of the key techniques for mitigating catastrophic forgetting and has been widely adopted in continual learning algorithms due to its simplicity and practicality. However, the theoretical understanding of how rehearsal scale influences learning dynamics remains limited. To address this gap, we formulate rehearsal-based continual learning as a multidimensional effectiveness-driven iterative optimization problem, providing a unified characterization across diverse performance metrics. Within this framework, we derive a closed-form analysis of adaptability, memorability, and generalization from the perspective of rehearsal scale. Our results uncover several intriguing and counterintuitive findings. First, rehearsal can impair model's adaptability, in sharp contrast to its traditionally recognized benefits. Second, increasing the rehearsal scale does not necessarily improve memory retention. When tasks are similar and noise levels are low, the memory error exhibits a diminishing lower bound. Finally, we validate these insights through numerical simulations and extended analyses on deep neural networks across multiple real-world datasets, revealing statistical patterns of rehearsal mechanisms in continual learning."}],"geoLocations":[],"fundingReferences":[],"url":"https://arxiv.org/abs/2602.20791","contentUrl":null,"metadataVersion":0,"schemaVersion":"http://datacite.org/schema/kernel-4","source":"mds","isActive":true,"state":"findable","reason":null,"viewCount":0,"downloadCount":0,"referenceCount":0,"citationCount":0,"partCount":0,"partOfCount":0,"versionCount":0,"versionOfCount":0,"created":"2026-02-25T02:58:37Z","registered":"2026-02-25T02:58:38Z","published":null,"updated":"2026-02-25T02:58:38Z"},"relationships":{"client":{"data":{"id":"arxiv.content","type":"clients"}}}},{"id":"10.48550/arxiv.2602.20790","type":"dois","attributes":{"doi":"10.48550/arxiv.2602.20790","identifiers":[{"identifier":"2602.20790","identifierType":"arXiv"}],"creators":[{"nameType":"Personal","givenName":"Sheng","familyName":"Zhong","name":"Zhong, Sheng","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Zhongyang","familyName":"Ren","name":"Ren, Zhongyang","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Xiya","familyName":"Zhu","name":"Zhu, Xiya","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Dehao","familyName":"Yuan","name":"Yuan, Dehao","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Cornelia","familyName":"Fermuller","name":"Fermuller, Cornelia","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Yi","familyName":"Zhou","name":"Zhou, Yi","affiliation":[],"nameIdentifiers":[]}],"titles":[{"title":"Real-time Motion Segmentation with Event-based Normal Flow"}],"publisher":"arXiv","container":{},"publicationYear":2026,"subjects":[{"subject":"Computer Vision and Pattern Recognition (cs.CV)","lang":"en","subjectScheme":"arXiv"},{"subject":"Robotics (cs.RO)","lang":"en","subjectScheme":"arXiv"},{"subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"},{"schemeUri":"http://www.oecd.org/science/inno/38235147.pdf","subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"}],"contributors":[],"dates":[{"date":"2026-02-24T11:29:07Z","dateType":"Submitted","dateInformation":"v1"},{"date":"2026-02-25T01:42:43Z","dateType":"Updated","dateInformation":"v1"},{"date":"2026-02","dateType":"Available","dateInformation":"v1"},{"date":"2026","dateType":"Issued"}],"language":null,"types":{"schemaOrg":"CreativeWork","resourceTypeGeneral":"Preprint","citeproc":"article","bibtex":"misc","ris":"GEN","resourceType":"Article"},"relatedIdentifiers":[],"relatedItems":[],"sizes":[],"formats":[],"version":"1","rightsList":[{"rightsIdentifierScheme":"SPDX","rightsUri":"https://creativecommons.org/licenses/by-nc-nd/4.0/legalcode","schemeUri":"https://spdx.org/licenses/","rights":"Creative Commons Attribution Non Commercial No Derivatives 4.0 International","rightsIdentifier":"cc-by-nc-nd-4.0"}],"descriptions":[{"descriptionType":"Abstract","description":"Event-based cameras are bio-inspired sensors with pixels that independently and asynchronously respond to brightness changes at microsecond resolution, offering the potential to handle visual tasks in challenging scenarios. However, due to the sparse information content in individual events, directly processing the raw event data to solve vision tasks is highly inefficient, which severely limits the applicability of state-of-the-art methods in real-time tasks, such as motion segmentation, a fundamental task for dynamic scene understanding. Incorporating normal flow as an intermediate representation to compress motion information from event clusters within a localized region provides a more effective solution. In this work, we propose a normal flow-based motion segmentation framework for event-based vision. Leveraging the dense normal flow directly learned from event neighborhoods as input, we formulate the motion segmentation task as an energy minimization problem solved via graph cuts, and optimize it iteratively with normal flow clustering and motion model fitting. By using a normal flow-based motion model initialization and fitting method, the proposed system is able to efficiently estimate the motion models of independently moving objects with only a limited number of candidate models, which significantly reduces the computational complexity and ensures real-time performance, achieving nearly a 800x speedup in comparison to the open-source state-of-the-art method. Extensive evaluations on multiple public datasets fully demonstrate the accuracy and efficiency of our framework."}],"geoLocations":[],"fundingReferences":[],"url":"https://arxiv.org/abs/2602.20790","contentUrl":null,"metadataVersion":0,"schemaVersion":"http://datacite.org/schema/kernel-4","source":"mds","isActive":true,"state":"findable","reason":null,"viewCount":0,"downloadCount":0,"referenceCount":0,"citationCount":0,"partCount":0,"partOfCount":0,"versionCount":0,"versionOfCount":0,"created":"2026-02-25T02:58:35Z","registered":"2026-02-25T02:58:36Z","published":null,"updated":"2026-02-25T02:58:36Z"},"relationships":{"client":{"data":{"id":"arxiv.content","type":"clients"}}}},{"id":"10.48550/arxiv.2602.20785","type":"dois","attributes":{"doi":"10.48550/arxiv.2602.20785","identifiers":[{"identifier":"2602.20785","identifierType":"arXiv"}],"creators":[{"nameType":"Personal","givenName":"Tangrui","familyName":"Liao","name":"Liao, Tangrui","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Junhao","familyName":"Yang","name":"Yang, Junhao","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Tinggui","familyName":"Zhang","name":"Zhang, Tinggui","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Xiaofen","familyName":"Huang","name":"Huang, Xiaofen","affiliation":[],"nameIdentifiers":[]}],"titles":[{"title":"Quantum coherence of mixed states under noisy channels in noninertial frames"}],"publisher":"arXiv","container":{},"publicationYear":2026,"subjects":[{"subject":"Quantum Physics (quant-ph)","lang":"en","subjectScheme":"arXiv"},{"subject":"FOS: Physical sciences","subjectScheme":"Fields of Science and Technology (FOS)"},{"schemeUri":"http://www.oecd.org/science/inno/38235147.pdf","subject":"FOS: Physical sciences","subjectScheme":"Fields of Science and Technology (FOS)"}],"contributors":[],"dates":[{"date":"2026-02-24T11:24:29Z","dateType":"Submitted","dateInformation":"v1"},{"date":"2026-02-25T01:42:28Z","dateType":"Updated","dateInformation":"v1"},{"date":"2026-02","dateType":"Available","dateInformation":"v1"},{"date":"2026","dateType":"Issued"}],"language":null,"types":{"schemaOrg":"CreativeWork","resourceTypeGeneral":"Preprint","citeproc":"article","bibtex":"misc","ris":"GEN","resourceType":"Article"},"relatedIdentifiers":[],"relatedItems":[],"sizes":[],"formats":[],"version":"1","rightsList":[{"rightsUri":"http://arxiv.org/licenses/nonexclusive-distrib/1.0/","rights":"arXiv.org perpetual, non-exclusive license"}],"descriptions":[{"descriptionType":"Abstract","description":"We focus our attention on tripartite mixed states as initial states, and apply coherence concurrence to investigate quantum coherence properties in the background of a Schwarzschild black hole under phase damping, phase flip and bit flip channels, respectively. Several analytic complementary relationships based on coherence concurrence for tripartite subsystems are proposed. In the case of the bit flip channel, the behavior of the coherence concurrence is similar to the one of the phase damping channel, the accessible coherence concurrence always degrades as the Hawking acceleration rising, but sudden death never occurs, while the inaccessible coherence increases from zero monotonically. Interestingly, the coherence concurrence is decreasing at first and then increasing as the decay probability rising under phase flip channel. Unlike the case of tripartite pure states, the coherence concurrence of mixed state with X shape is equal to $l_1$ -norm of coherence."}],"geoLocations":[],"fundingReferences":[],"url":"https://arxiv.org/abs/2602.20785","contentUrl":null,"metadataVersion":0,"schemaVersion":"http://datacite.org/schema/kernel-4","source":"mds","isActive":true,"state":"findable","reason":null,"viewCount":0,"downloadCount":0,"referenceCount":0,"citationCount":0,"partCount":0,"partOfCount":0,"versionCount":0,"versionOfCount":0,"created":"2026-02-25T02:58:29Z","registered":"2026-02-25T02:58:29Z","published":null,"updated":"2026-02-25T02:58:29Z"},"relationships":{"client":{"data":{"id":"arxiv.content","type":"clients"}}}},{"id":"10.48550/arxiv.2602.20782","type":"dois","attributes":{"doi":"10.48550/arxiv.2602.20782","identifiers":[{"identifier":"2602.20782","identifierType":"arXiv"}],"creators":[{"nameType":"Personal","givenName":"Andreas","familyName":"Tritsarolis","name":"Tritsarolis, Andreas","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Gil","familyName":"Sampaio","name":"Sampaio, Gil","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Nikos","familyName":"Pelekis","name":"Pelekis, Nikos","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Yannis","familyName":"Theodoridis","name":"Theodoridis, Yannis","affiliation":[],"nameIdentifiers":[]}],"titles":[{"title":"On Electric Vehicle Energy Demand Forecasting and the Effect of Federated Learning"}],"publisher":"arXiv","container":{},"publicationYear":2026,"subjects":[{"subject":"Machine Learning (cs.LG)","lang":"en","subjectScheme":"arXiv"},{"subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"},{"schemeUri":"http://www.oecd.org/science/inno/38235147.pdf","subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"}],"contributors":[],"dates":[{"date":"2026-02-24T11:21:45Z","dateType":"Submitted","dateInformation":"v1"},{"date":"2026-02-25T01:42:21Z","dateType":"Updated","dateInformation":"v1"},{"date":"2026-02","dateType":"Available","dateInformation":"v1"},{"date":"2026","dateType":"Issued"}],"language":null,"types":{"schemaOrg":"CreativeWork","resourceTypeGeneral":"Preprint","citeproc":"article","bibtex":"misc","ris":"GEN","resourceType":"Article"},"relatedIdentifiers":[],"relatedItems":[],"sizes":[],"formats":[],"version":"1","rightsList":[{"rightsUri":"http://arxiv.org/licenses/nonexclusive-distrib/1.0/","rights":"arXiv.org perpetual, non-exclusive license"}],"descriptions":[{"descriptionType":"Abstract","description":"The wide spread of new energy resources, smart devices, and demand side management strategies has motivated several analytics operations, from infrastructure load modeling to user behavior profiling. Energy Demand Forecasting (EDF) of Electric Vehicle Supply Equipments (EVSEs) is one of the most critical operations for ensuring efficient energy management and sustainability, since it enables utility providers to anticipate energy/power demand, optimize resource allocation, and implement proactive measures to improve grid reliability. However, accurate EDF is a challenging problem due to external factors, such as the varying user routines, weather conditions, driving behaviors, unknown state of charge, etc. Furthermore, as concerns and restrictions about privacy and sustainability have grown, training data has become increasingly fragmented, resulting in distributed datasets scattered across different data silos and/or edge devices, calling for federated learning solutions. In this paper, we investigate different well-established time series forecasting methodologies to address the EDF problem, from statistical methods (the ARIMA family) to traditional machine learning models (such as XGBoost) and deep neural networks (GRU and LSTM). We provide an overview of these methods through a performance comparison over four real-world EVSE datasets, evaluated under both centralized and federated learning paradigms, focusing on the trade-offs between forecasting fidelity, privacy preservation, and energy overheads. Our experimental results demonstrate, on the one hand, the superiority of gradient boosted trees (XGBoost) over statistical and NN-based models in both prediction accuracy and energy efficiency and, on the other hand, an insight that Federated Learning-enabled models balance these factors, offering a promising direction for decentralized energy demand forecasting."}],"geoLocations":[],"fundingReferences":[],"url":"https://arxiv.org/abs/2602.20782","contentUrl":null,"metadataVersion":0,"schemaVersion":"http://datacite.org/schema/kernel-4","source":"mds","isActive":true,"state":"findable","reason":null,"viewCount":0,"downloadCount":0,"referenceCount":0,"citationCount":0,"partCount":0,"partOfCount":0,"versionCount":0,"versionOfCount":0,"created":"2026-02-25T02:58:24Z","registered":"2026-02-25T02:58:25Z","published":null,"updated":"2026-02-25T02:58:25Z"},"relationships":{"client":{"data":{"id":"arxiv.content","type":"clients"}}}},{"id":"10.48550/arxiv.2602.20781","type":"dois","attributes":{"doi":"10.48550/arxiv.2602.20781","identifiers":[{"identifier":"2602.20781","identifierType":"arXiv"}],"creators":[{"nameType":"Personal","givenName":"Nhat A.","familyName":"Nghiem","name":"Nghiem, Nhat A.","affiliation":[],"nameIdentifiers":[]}],"titles":[{"title":"Toward speedup without quantum coherent access"}],"publisher":"arXiv","container":{},"publicationYear":2026,"subjects":[{"subject":"Quantum Physics (quant-ph)","lang":"en","subjectScheme":"arXiv"},{"subject":"FOS: Physical sciences","subjectScheme":"Fields of Science and Technology (FOS)"},{"schemeUri":"http://www.oecd.org/science/inno/38235147.pdf","subject":"FOS: Physical sciences","subjectScheme":"Fields of Science and Technology (FOS)"}],"contributors":[],"dates":[{"date":"2026-02-24T11:21:44Z","dateType":"Submitted","dateInformation":"v1"},{"date":"2026-02-25T01:42:20Z","dateType":"Updated","dateInformation":"v1"},{"date":"2026-02","dateType":"Available","dateInformation":"v1"},{"date":"2026","dateType":"Issued"}],"language":null,"types":{"schemaOrg":"CreativeWork","resourceTypeGeneral":"Preprint","citeproc":"article","bibtex":"misc","ris":"GEN","resourceType":"Article"},"relatedIdentifiers":[],"relatedItems":[],"sizes":[],"formats":[],"version":"1","rightsList":[{"rightsIdentifierScheme":"SPDX","rightsUri":"https://creativecommons.org/licenses/by/4.0/legalcode","schemeUri":"https://spdx.org/licenses/","rights":"Creative Commons Attribution 4.0 International","rightsIdentifier":"cc-by-4.0"}],"descriptions":[{"descriptionType":"Abstract","description":"Along with the development of quantum technology, finding useful applications of quantum computers has been a central pursuit. Despite various quantum algorithms have been developed, many of them often require strong input assumptions, which is hardware demanding. In particular, recent advances on dequantization have revealed that the quantum advantage is more of a mere artifact of strong input assumptions. In this work, we propose a variant of these algorithms, leveraging both classical and quantum resources. Provided the classical knowledge (the entries) of the matrix/vector of interest, a classical procedure is used to pre-process this information. Then they are fed into a quantum circuit which is shown to be a block encoding of the matrix of interest. From this block-encoding, we show how to use it to tackle a wide range of problems, including principal component analysis, linear equation solving, Hamiltonian simulation, preparing ground state, and data fitting. We also analyze our protocol, showing that both the classical and quantum procedure can achieve logarithmic complexity in the input dimension, thus implying its potential for near term realization. We then discuss several implications and corollaries of our result. First,, our results suggest there are certain matrices/Hamiltonians where our method can provide exponential improvement compared to the existing ones with respect to the sparsity. Regarding dense linear systems, our method achieves exponential speed-up with respect to the inverse of error tolerance, compared to the best previously known quantum algorithm for dense systems. Last, and most importantly, regarding quantum data fitting, we show how the output of our quantum algorithms can be leveraged to predict unseen data. Thus, it provides an end-to-end application, which has been an open aspect of the previous quantum data fitting algorithm."},{"descriptionType":"Other","description":"arXiv admin note: substantial text overlap with arXiv:2504.00833"}],"geoLocations":[],"fundingReferences":[],"url":"https://arxiv.org/abs/2602.20781","contentUrl":null,"metadataVersion":0,"schemaVersion":"http://datacite.org/schema/kernel-4","source":"mds","isActive":true,"state":"findable","reason":null,"viewCount":0,"downloadCount":0,"referenceCount":0,"citationCount":0,"partCount":0,"partOfCount":0,"versionCount":0,"versionOfCount":0,"created":"2026-02-25T02:58:23Z","registered":"2026-02-25T02:58:23Z","published":null,"updated":"2026-02-25T02:58:23Z"},"relationships":{"client":{"data":{"id":"arxiv.content","type":"clients"}}}},{"id":"10.48550/arxiv.2602.20780","type":"dois","attributes":{"doi":"10.48550/arxiv.2602.20780","identifiers":[{"identifier":"2602.20780","identifierType":"arXiv"}],"creators":[{"nameType":"Personal","givenName":"Jose Carlos","familyName":"Pelayo","name":"Pelayo, Jose Carlos","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Ippei","familyName":"Danshita","name":"Danshita, Ippei","affiliation":[],"nameIdentifiers":[]}],"titles":[{"title":"Suppressed correlation-spreading in a one-dimensional Bose-Hubbard model with strong interactions"}],"publisher":"arXiv","container":{},"publicationYear":2026,"subjects":[{"subject":"Quantum Gases (cond-mat.quant-gas)","lang":"en","subjectScheme":"arXiv"},{"subject":"Quantum Physics (quant-ph)","lang":"en","subjectScheme":"arXiv"},{"subject":"FOS: Physical sciences","subjectScheme":"Fields of Science and Technology (FOS)"},{"schemeUri":"http://www.oecd.org/science/inno/38235147.pdf","subject":"FOS: Physical sciences","subjectScheme":"Fields of Science and Technology (FOS)"}],"contributors":[],"dates":[{"date":"2026-02-24T11:21:07Z","dateType":"Submitted","dateInformation":"v1"},{"date":"2026-02-25T01:42:19Z","dateType":"Updated","dateInformation":"v1"},{"date":"2026-02","dateType":"Available","dateInformation":"v1"},{"date":"2026","dateType":"Issued"}],"language":null,"types":{"schemaOrg":"CreativeWork","resourceTypeGeneral":"Preprint","citeproc":"article","bibtex":"misc","ris":"GEN","resourceType":"Article"},"relatedIdentifiers":[],"relatedItems":[],"sizes":[],"formats":[],"version":"1","rightsList":[{"rightsIdentifierScheme":"SPDX","rightsUri":"https://creativecommons.org/licenses/by/4.0/legalcode","schemeUri":"https://spdx.org/licenses/","rights":"Creative Commons Attribution 4.0 International","rightsIdentifier":"cc-by-4.0"}],"descriptions":[{"descriptionType":"Abstract","description":"We investigate signatures of non-ergodic behavior in the real-time evolution of a one-dimensional Bose-Hubbard model, where the initial state is a doubly occupied density-wave state. We show that the occupation dynamics at strong interactions is dominated by doublon-holon exchange which leads to a domain wall excitation and propagation. The latter manifests as a negated staggered pattern in the density-density correlations. While the single-particle and the pair correlation functions show highly localized correlations that decay rapidly away from the nearest neighbor. We show that the time scale of the domain-wall excitations depends on the inverse of the interaction strength and therefore dictates the slow relaxation dynamics. In the presence of a parabolic trap, the occupation dynamics at the edges become frozen and further suppresses the propagation of correlations. This suppression happens even for trap strengths weaker than the tunneling rate. We also show that the model can be mapped to an antiferromagnetic transverse-field Ising model in the limit of strong interactions and that the correlation-propagation velocity in the original model is well captured by the group velocity of the spin-wave excitation in the effective spin model."}],"geoLocations":[],"fundingReferences":[],"url":"https://arxiv.org/abs/2602.20780","contentUrl":null,"metadataVersion":0,"schemaVersion":"http://datacite.org/schema/kernel-4","source":"mds","isActive":true,"state":"findable","reason":null,"viewCount":0,"downloadCount":0,"referenceCount":0,"citationCount":0,"partCount":0,"partOfCount":0,"versionCount":0,"versionOfCount":0,"created":"2026-02-25T02:58:21Z","registered":"2026-02-25T02:58:22Z","published":null,"updated":"2026-02-25T02:58:22Z"},"relationships":{"client":{"data":{"id":"arxiv.content","type":"clients"}}}},{"id":"10.48550/arxiv.2602.20779","type":"dois","attributes":{"doi":"10.48550/arxiv.2602.20779","identifiers":[{"identifier":"2602.20779","identifierType":"arXiv"}],"creators":[{"nameType":"Personal","givenName":"Florian","familyName":"Lux","name":"Lux, Florian","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Elijah","familyName":"Ditchendorf","name":"Ditchendorf, Elijah","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Çağlar","familyName":"Ataman","name":"Ataman, Çağlar","affiliation":[],"nameIdentifiers":[]}],"titles":[{"title":"Closed-loop control of a monolithically 3D nano-printed electromagnetic lens scanner with an integrated Hall sensor"}],"publisher":"arXiv","container":{},"publicationYear":2026,"subjects":[{"subject":"Optics (physics.optics)","lang":"en","subjectScheme":"arXiv"},{"subject":"FOS: Physical sciences","subjectScheme":"Fields of Science and Technology (FOS)"},{"schemeUri":"http://www.oecd.org/science/inno/38235147.pdf","subject":"FOS: Physical sciences","subjectScheme":"Fields of Science and Technology (FOS)"}],"contributors":[],"dates":[{"date":"2026-02-24T11:20:28Z","dateType":"Submitted","dateInformation":"v1"},{"date":"2026-02-25T01:42:14Z","dateType":"Updated","dateInformation":"v1"},{"date":"2026-02","dateType":"Available","dateInformation":"v1"},{"date":"2026","dateType":"Issued"}],"language":null,"types":{"schemaOrg":"CreativeWork","resourceTypeGeneral":"Preprint","citeproc":"article","bibtex":"misc","ris":"GEN","resourceType":"Article"},"relatedIdentifiers":[],"relatedItems":[],"sizes":[],"formats":[],"version":"1","rightsList":[{"rightsIdentifierScheme":"SPDX","rightsUri":"https://creativecommons.org/licenses/by/4.0/legalcode","schemeUri":"https://spdx.org/licenses/","rights":"Creative Commons Attribution 4.0 International","rightsIdentifier":"cc-by-4.0"}],"descriptions":[{"descriptionType":"Abstract","description":"3D nano-printing through two-photon polymerization enables monolithic manufacturing of mechanical and freeform micro-optical elements with high inherent alignment accuracy. However, viscoelasticity and temperature-dependent stiffness of the photopolymer lead to hysteresis and drift, which significantly degrade open-loop position accuracy and long-term stability in quasi-static operation. Therefore, closed-loop control with integrated displacement sensing is essential for 3D nano-printed optical microsystems in practical precision positioning applications. Here, we present a closed-loop control system for a such a lens actuator that uses a commercial 3-axis Hall sensor for position tracking. A NdFeB micromagnet encircling the integrated microlens provides both the actuation force and a position-dependent sensing signal. The Hall sensor, located between an anti-Helmholtz-like coil pair that drives the scanner bidirectionally, measures the combined field due to the micro-magnet and the coil pair. Calibration-based subtraction separates the coil field and sensor offset contributions to recover the magnet field and thus the axial magnet displacement. Closed-loop operation yields a mean absolute accuracy of 0.86 um and a precision of 0.49 um over a displacement range of 150 um while eliminating viscoelastic creep, suppressing hysteresis, and minimizing temperature-induced displacement drift under coil self-heating. This sensing approach requires no additional microfabrication steps and provides a practical path toward stable and repeatable positioning for monolithically 3D nano-printed optical microsystems."}],"geoLocations":[],"fundingReferences":[],"url":"https://arxiv.org/abs/2602.20779","contentUrl":null,"metadataVersion":0,"schemaVersion":"http://datacite.org/schema/kernel-4","source":"mds","isActive":true,"state":"findable","reason":null,"viewCount":0,"downloadCount":0,"referenceCount":0,"citationCount":0,"partCount":0,"partOfCount":0,"versionCount":0,"versionOfCount":0,"created":"2026-02-25T02:58:20Z","registered":"2026-02-25T02:58:21Z","published":null,"updated":"2026-02-25T02:58:21Z"},"relationships":{"client":{"data":{"id":"arxiv.content","type":"clients"}}}},{"id":"10.48550/arxiv.2602.20778","type":"dois","attributes":{"doi":"10.48550/arxiv.2602.20778","identifiers":[{"identifier":"2602.20778","identifierType":"arXiv"}],"creators":[{"nameType":"Personal","givenName":"Pol","familyName":"Benítez","name":"Benítez, Pol","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Cibrán","familyName":"López","name":"López, Cibrán","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Edgardo","familyName":"Saucedo","name":"Saucedo, Edgardo","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Claudio","familyName":"Cazorla","name":"Cazorla, Claudio","affiliation":[],"nameIdentifiers":[]}],"titles":[{"title":"Machine Learning Modeling of Temperature-Dependent Optoelectronic Properties of Anharmonic Solid Solutions"}],"publisher":"arXiv","container":{},"publicationYear":2026,"subjects":[{"subject":"Materials Science (cond-mat.mtrl-sci)","lang":"en","subjectScheme":"arXiv"},{"subject":"FOS: Physical sciences","subjectScheme":"Fields of Science and Technology (FOS)"},{"schemeUri":"http://www.oecd.org/science/inno/38235147.pdf","subject":"FOS: Physical sciences","subjectScheme":"Fields of Science and Technology (FOS)"}],"contributors":[],"dates":[{"date":"2026-02-24T11:18:30Z","dateType":"Submitted","dateInformation":"v1"},{"date":"2026-02-25T01:42:08Z","dateType":"Updated","dateInformation":"v1"},{"date":"2026-02","dateType":"Available","dateInformation":"v1"},{"date":"2026","dateType":"Issued"}],"language":null,"types":{"schemaOrg":"CreativeWork","resourceTypeGeneral":"Preprint","citeproc":"article","bibtex":"misc","ris":"GEN","resourceType":"Article"},"relatedIdentifiers":[],"relatedItems":[],"sizes":[],"formats":[],"version":"1","rightsList":[{"rightsIdentifierScheme":"SPDX","rightsUri":"https://creativecommons.org/licenses/by/4.0/legalcode","schemeUri":"https://spdx.org/licenses/","rights":"Creative Commons Attribution 4.0 International","rightsIdentifier":"cc-by-4.0"}],"descriptions":[{"descriptionType":"Abstract","description":"Leveraging strong optoelectronic responses to external stimuli, such as temperature and electric fields, is central to the development of advanced photonic technologies, including adaptive photodetectors and reconfigurable photovoltaic devices. However, only a limited number of semiconducting materials, typically characterized by strong electron-phonon coupling, are known to exhibit such pronounced responsiveness, and their equilibrium optoelectronic properties are often not optimally suited for targeted applications. Chemical engineering strategies, such as doping and solid-solution mixing, are therefore widely employed to fine-tune the electronic and optical properties of semiconductors. Predicting the impact of such modifications, however, remains highly challenging due to the intrinsic complexity of chemically disordered and anharmonic systems, as well as the computational limitations of conventional first-principles approaches. In this work, we introduce a new computational framework that combines ab initio electronic-structure methods with machine-learning techniques to achieve first-principles precision in the prediction of optoelectronic properties of anharmonic solid solutions at finite temperature. We apply this approach to silver chalco-halide solid solutions, an emergent class of optoelectronic materials that have been experimentally shown to exhibit large band-gap tunability and strong responses to thermal excitations. Our results provide quantitative insight into the interplay between chemical disorder, lattice dynamics, and electronic structure in these materials. More broadly, this study establishes a general strategy for the accurate modeling of optoelectronic functionality in chemically disordered semiconductors."},{"descriptionType":"Other","description":"15 pages, 8 figures"}],"geoLocations":[],"fundingReferences":[],"url":"https://arxiv.org/abs/2602.20778","contentUrl":null,"metadataVersion":0,"schemaVersion":"http://datacite.org/schema/kernel-4","source":"mds","isActive":true,"state":"findable","reason":null,"viewCount":0,"downloadCount":0,"referenceCount":0,"citationCount":0,"partCount":0,"partOfCount":0,"versionCount":0,"versionOfCount":0,"created":"2026-02-25T02:58:19Z","registered":"2026-02-25T02:58:19Z","published":null,"updated":"2026-02-25T02:58:19Z"},"relationships":{"client":{"data":{"id":"arxiv.content","type":"clients"}}}},{"id":"10.48550/arxiv.2602.20776","type":"dois","attributes":{"doi":"10.48550/arxiv.2602.20776","identifiers":[{"identifier":"2602.20776","identifierType":"arXiv"}],"creators":[{"nameType":"Personal","givenName":"M. C.","familyName":"Gandikota","name":"Gandikota, M. C.","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Rituparno","familyName":"Mandal","name":"Mandal, Rituparno","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Pinaki","familyName":"Chaudhuri","name":"Chaudhuri, Pinaki","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Bulbul","familyName":"Chakraborty","name":"Chakraborty, Bulbul","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Chandan","familyName":"Dasgupta","name":"Dasgupta, Chandan","affiliation":[],"nameIdentifiers":[]}],"titles":[{"title":"The Jammed Phase of Infinitely Persistent Active Matter"}],"publisher":"arXiv","container":{},"publicationYear":2026,"subjects":[{"subject":"Soft Condensed Matter (cond-mat.soft)","lang":"en","subjectScheme":"arXiv"},{"subject":"Disordered Systems and Neural Networks (cond-mat.dis-nn)","lang":"en","subjectScheme":"arXiv"},{"subject":"Statistical Mechanics (cond-mat.stat-mech)","lang":"en","subjectScheme":"arXiv"},{"subject":"FOS: Physical sciences","subjectScheme":"Fields of Science and Technology (FOS)"},{"schemeUri":"http://www.oecd.org/science/inno/38235147.pdf","subject":"FOS: Physical sciences","subjectScheme":"Fields of Science and Technology (FOS)"}],"contributors":[],"dates":[{"date":"2026-02-24T11:17:12Z","dateType":"Submitted","dateInformation":"v1"},{"date":"2026-02-25T01:42:03Z","dateType":"Updated","dateInformation":"v1"},{"date":"2026-02","dateType":"Available","dateInformation":"v1"},{"date":"2026","dateType":"Issued"}],"language":null,"types":{"schemaOrg":"CreativeWork","resourceTypeGeneral":"Preprint","citeproc":"article","bibtex":"misc","ris":"GEN","resourceType":"Article"},"relatedIdentifiers":[],"relatedItems":[],"sizes":[],"formats":[],"version":"1","rightsList":[{"rightsIdentifierScheme":"SPDX","rightsUri":"https://creativecommons.org/licenses/by/4.0/legalcode","schemeUri":"https://spdx.org/licenses/","rights":"Creative Commons Attribution 4.0 International","rightsIdentifier":"cc-by-4.0"}],"descriptions":[{"descriptionType":"Abstract","description":"We study an extreme active matter system, which is essentially a dense assembly of athermal, soft and infinitely persistent active particles. Using extensive numerical simulations we obtain jammed configurations of this system in two dimensions and probe the stability of such structures under increasing active forcing magnitude. We show that the critical active forcing magnitude for the jammed phase to yield scales with virial pressure as $f_c\\sim p^α$, with $α=1.17$, describing the yielding line. Using a Laplacian framework, we redistribute the active forces into a modified contact force network. By analysing the statistics of these redistributed forces, we obtain a very robust scaling law consistent with the passive limit, not just near the unjamming line, but in the entire jammed active phase. The probability distribution of the magnitude of the contact force deviates from the power-law form found in passive systems for values smaller than the active force. Moreover, within the jammed phase, the system displays elastic, plastic, and yielding events with increasing active forcing. This active plasticity appears abruptly and can not be captured by the continuous softening of the Hessian spectrum. However, we demonstrate that the Hessian still retains the ability to predict relaxation times. These results clarify how activity modifies force distributions and leads to deformation, plasticity and yielding in dense, jammed, infinitely persistent active matter."},{"descriptionType":"Other","description":"14 pages, 9 figures"}],"geoLocations":[],"fundingReferences":[],"url":"https://arxiv.org/abs/2602.20776","contentUrl":null,"metadataVersion":0,"schemaVersion":"http://datacite.org/schema/kernel-4","source":"mds","isActive":true,"state":"findable","reason":null,"viewCount":0,"downloadCount":0,"referenceCount":0,"citationCount":0,"partCount":0,"partOfCount":0,"versionCount":0,"versionOfCount":0,"created":"2026-02-25T02:58:16Z","registered":"2026-02-25T02:58:16Z","published":null,"updated":"2026-02-25T02:58:16Z"},"relationships":{"client":{"data":{"id":"arxiv.content","type":"clients"}}}},{"id":"10.48550/arxiv.2602.20775","type":"dois","attributes":{"doi":"10.48550/arxiv.2602.20775","identifiers":[{"identifier":"2602.20775","identifierType":"arXiv"}],"creators":[{"nameType":"Personal","givenName":"Callum","familyName":"Aster","name":"Aster, Callum","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Cosimo","familyName":"Inserra","name":"Inserra, Cosimo","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Andrea","familyName":"Pastorello","name":"Pastorello, Andrea","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Joseph P","familyName":"Anderson","name":"Anderson, Joseph P","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Franz Erik","familyName":"Bauer","name":"Bauer, Franz Erik","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"K. Azalee","familyName":"Bostroem","name":"Bostroem, K. Azalee","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Kenneth C.","familyName":"Chambers","name":"Chambers, Kenneth C.","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Ting-Wan","familyName":"Chen","name":"Chen, Ting-Wan","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Joseph R.","familyName":"Farah","name":"Farah, Joseph R.","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Morgan","familyName":"Fraser","name":"Fraser, Morgan","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Dino Pierluigi","familyName":"Fugazza","name":"Fugazza, Dino Pierluigi","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Mariusz","familyName":"Gromadzki","name":"Gromadzki, Mariusz","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Claudia P.","familyName":"Gutiérrez","name":"Gutiérrez, Claudia P.","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"D. Andrew","familyName":"Howell","name":"Howell, D. Andrew","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Erkki","familyName":"Kankare","name":"Kankare, Erkki","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Tom L.","familyName":"Killestein","name":"Killestein, Tom L.","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Niilo","familyName":"Koivisto","name":"Koivisto, Niilo","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Giorgos","familyName":"Leloudas","name":"Leloudas, Giorgos","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"J. D.","familyName":"Lyman","name":"Lyman, J. D.","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Kyle","familyName":"Medler","name":"Medler, Kyle","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Shane","familyName":"Moran","name":"Moran, Shane","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Tomás E.","familyName":"Müller-Bravo","name":"Müller-Bravo, Tomás E.","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Giuliano","familyName":"Pignata","name":"Pignata, Giuliano","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Miika","familyName":"Pursiainen","name":"Pursiainen, Miika","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Fabio","familyName":"Ragosta","name":"Ragosta, Fabio","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Andrea","familyName":"Reguitti","name":"Reguitti, Andrea","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Jesper","familyName":"Sollerman","name":"Sollerman, Jesper","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Giorgio","familyName":"Valerin","name":"Valerin, Giorgio","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Ben","familyName":"Warwick","name":"Warwick, Ben","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"David R.","familyName":"Young","name":"Young, David R.","affiliation":[],"nameIdentifiers":[]}],"titles":[{"title":"SN 2024abvb: a Type Ibn/Icn supernova with evidence of helium and an extreme offset from its host galaxy"}],"publisher":"arXiv","container":{},"publicationYear":2026,"subjects":[{"subject":"Solar and Stellar Astrophysics (astro-ph.SR)","lang":"en","subjectScheme":"arXiv"},{"subject":"Astrophysics of Galaxies (astro-ph.GA)","lang":"en","subjectScheme":"arXiv"},{"subject":"High Energy Astrophysical Phenomena (astro-ph.HE)","lang":"en","subjectScheme":"arXiv"},{"subject":"FOS: Physical sciences","subjectScheme":"Fields of Science and Technology (FOS)"},{"schemeUri":"http://www.oecd.org/science/inno/38235147.pdf","subject":"FOS: Physical sciences","subjectScheme":"Fields of Science and Technology (FOS)"}],"contributors":[],"dates":[{"date":"2026-02-24T11:17:04Z","dateType":"Submitted","dateInformation":"v1"},{"date":"2026-02-25T01:42:02Z","dateType":"Updated","dateInformation":"v1"},{"date":"2026-02","dateType":"Available","dateInformation":"v1"},{"date":"2026","dateType":"Issued"}],"language":null,"types":{"schemaOrg":"CreativeWork","resourceTypeGeneral":"Preprint","citeproc":"article","bibtex":"misc","ris":"GEN","resourceType":"Article"},"relatedIdentifiers":[],"relatedItems":[],"sizes":[],"formats":[],"version":"1","rightsList":[{"rightsUri":"http://arxiv.org/licenses/nonexclusive-distrib/1.0/","rights":"arXiv.org perpetual, non-exclusive license"}],"descriptions":[{"descriptionType":"Abstract","description":"We present spectroscopic and photometric observations and analysis of SN 2024abvb, a peculiar transitional Type Ibn/Icn supernova located at an unusually large projected distance from its host galaxy (21.5 kpc). SN 2024abvb displays an extended rise time in the $g$- and $o$-bands (10.1 and 10.6 days respectively), followed by a linear decline in all photometric bands. Comparisons with other supernova subclasses show that the photometric and spectroscopic evolution of SN 2024abvb are distinct from Type~Ibn and Type Icn events, with a higher peak $r$-band luminosity and lower blackbody temperatures. Spectra reveal an initial blue continuum and narrow P-Cygni profiles, with C {\\sc ii} $λ$5890 dominating in emission, persisting at late phases, and showing a rapid decline in the expansion velocity. Weak He {\\sc i} $λ$5876 features are tentatively detected at early times. Analysis of progenitor scenarios rules out thermonuclear origins based on incompatible light curve shapes and spectral signatures. A rare massive star progenitor appears unlikely given the low local star formation rate. The most plausible origin is an ultra-stripped supernova scenario involving a binary system; this best explains the observed separation from the host, the low circumstellar material mass, the fast photometric evolution and the low nickel production, although a discrepancy in model versus observed ejecta mass remains. These results reinforce the classification of SN 2024abvb as a distinctive Type Ibn/Icn event and highlight the diversity of progenitor channels for interacting supernovae."},{"descriptionType":"Other","description":"Accepted 2026 February 23. Received 2026 February 21; in original form 2026 January 05, 15 pages, 12 figures, 10 pages appendix"}],"geoLocations":[],"fundingReferences":[],"url":"https://arxiv.org/abs/2602.20775","contentUrl":null,"metadataVersion":0,"schemaVersion":"http://datacite.org/schema/kernel-4","source":"mds","isActive":true,"state":"findable","reason":null,"viewCount":0,"downloadCount":0,"referenceCount":0,"citationCount":0,"partCount":0,"partOfCount":0,"versionCount":0,"versionOfCount":0,"created":"2026-02-25T02:58:14Z","registered":"2026-02-25T02:58:15Z","published":null,"updated":"2026-02-25T02:58:15Z"},"relationships":{"client":{"data":{"id":"arxiv.content","type":"clients"}}}},{"id":"10.48550/arxiv.2602.20772","type":"dois","attributes":{"doi":"10.48550/arxiv.2602.20772","identifiers":[{"identifier":"2602.20772","identifierType":"arXiv"}],"creators":[{"nameType":"Personal","givenName":"Yanyang","familyName":"Wang","name":"Wang, Yanyang","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Feng","familyName":"Gao","name":"Gao, Feng","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Kui","familyName":"Tuo","name":"Tuo, Kui","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Wei","familyName":"Li","name":"Li, Wei","affiliation":[],"nameIdentifiers":[]}],"titles":[{"title":"Generative Deep Learning for the Two-Dimensional Quantum Rotor Model"}],"publisher":"arXiv","container":{},"publicationYear":2026,"subjects":[{"subject":"Quantum Physics (quant-ph)","lang":"en","subjectScheme":"arXiv"},{"subject":"Other Condensed Matter (cond-mat.other)","lang":"en","subjectScheme":"arXiv"},{"subject":"FOS: Physical sciences","subjectScheme":"Fields of Science and Technology (FOS)"},{"schemeUri":"http://www.oecd.org/science/inno/38235147.pdf","subject":"FOS: Physical sciences","subjectScheme":"Fields of Science and Technology (FOS)"}],"contributors":[],"dates":[{"date":"2026-02-24T11:06:16Z","dateType":"Submitted","dateInformation":"v1"},{"date":"2026-02-25T01:41:45Z","dateType":"Updated","dateInformation":"v1"},{"date":"2026-02","dateType":"Available","dateInformation":"v1"},{"date":"2026","dateType":"Issued"}],"language":null,"types":{"schemaOrg":"CreativeWork","resourceTypeGeneral":"Preprint","citeproc":"article","bibtex":"misc","ris":"GEN","resourceType":"Article"},"relatedIdentifiers":[],"relatedItems":[],"sizes":[],"formats":[],"version":"1","rightsList":[{"rightsUri":"http://arxiv.org/licenses/nonexclusive-distrib/1.0/","rights":"arXiv.org perpetual, non-exclusive license"}],"descriptions":[{"descriptionType":"Abstract","description":"The advancement of diverse generative deep learning models and their variants has furnished substantial insights for investigating quantum many-body problems. In this work, we design two models based on the foundational architecture of generative adversarial networks (GANs) to investigate the ground-state properties and phase transition characteristics of the two-dimensional quantum rotor model (QRM). Within a semi-supervised learning framework, we incorporate multiple layers of transposed convolutions in the generator, enabling the conditional GAN to more efficiently extract low-dimensional encoded information. Analysis of one-dimensional latent variables associated with ground-state samples for different system sizes allows us to pinpoint the location of the critical point. In addition, we introduce dynamically adaptive weighting factors related to the distributional characteristics into the loss function of the deep convolutional GAN, and utilize upsampling techniques to enlarge the generated sample sizes. Comparisons of the optimization processes for mean magnetization and potential energy density across different magnetization regimes of QRM demonstrate that our model can efficiently generate valid ground-state samples, significantly reducing computational time. Our results highlight the promising potential of generative deep learning in quantum phase transition research, especially in critical point identification and the auxiliary generation of simulation data for quantum many-body models."}],"geoLocations":[],"fundingReferences":[],"url":"https://arxiv.org/abs/2602.20772","contentUrl":null,"metadataVersion":0,"schemaVersion":"http://datacite.org/schema/kernel-4","source":"mds","isActive":true,"state":"findable","reason":null,"viewCount":0,"downloadCount":0,"referenceCount":0,"citationCount":0,"partCount":0,"partOfCount":0,"versionCount":0,"versionOfCount":0,"created":"2026-02-25T02:58:10Z","registered":"2026-02-25T02:58:11Z","published":null,"updated":"2026-02-25T02:58:11Z"},"relationships":{"client":{"data":{"id":"arxiv.content","type":"clients"}}}},{"id":"10.48550/arxiv.2602.20770","type":"dois","attributes":{"doi":"10.48550/arxiv.2602.20770","identifiers":[{"identifier":"2602.20770","identifierType":"arXiv"}],"creators":[{"nameType":"Personal","givenName":"Varvara","familyName":"Sazonova","name":"Sazonova, Varvara","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Dmitri","familyName":"Shmelkin","name":"Shmelkin, Dmitri","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Stanislav","familyName":"Kikot","name":"Kikot, Stanislav","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Vasily","familyName":"Motolygin","name":"Motolygin, Vasily","affiliation":[],"nameIdentifiers":[]}],"titles":[{"title":"Pipeline for Verifying LLM-Generated Mathematical Solutions"}],"publisher":"arXiv","container":{},"publicationYear":2026,"subjects":[{"subject":"Artificial Intelligence (cs.AI)","lang":"en","subjectScheme":"arXiv"},{"subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"},{"schemeUri":"http://www.oecd.org/science/inno/38235147.pdf","subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"}],"contributors":[],"dates":[{"date":"2026-02-24T11:01:25Z","dateType":"Submitted","dateInformation":"v1"},{"date":"2026-02-25T01:41:30Z","dateType":"Updated","dateInformation":"v1"},{"date":"2026-02","dateType":"Available","dateInformation":"v1"},{"date":"2026","dateType":"Issued"}],"language":null,"types":{"schemaOrg":"CreativeWork","resourceTypeGeneral":"Preprint","citeproc":"article","bibtex":"misc","ris":"GEN","resourceType":"Article"},"relatedIdentifiers":[],"relatedItems":[],"sizes":[],"formats":[],"version":"1","rightsList":[{"rightsIdentifierScheme":"SPDX","rightsUri":"https://creativecommons.org/licenses/by-nc-sa/4.0/legalcode","schemeUri":"https://spdx.org/licenses/","rights":"Creative Commons Attribution Non Commercial Share Alike 4.0 International","rightsIdentifier":"cc-by-nc-sa-4.0"}],"descriptions":[{"descriptionType":"Abstract","description":"With the growing popularity of Large Reasoning Models and their results in solving mathematical problems, it becomes crucial to measure their capabilities. We introduce a pipeline for both automatic and interactive verification as a more accurate alternative to only checking the answer which is currently the most popular approach for benchmarks. The pipeline can also be used as a generator of correct solutions both in formal and informal languages. 3 AI agents, which can be chosen for the benchmark accordingly, are included in the structure. The key idea is the use of prompts to obtain the solution in the specific form which allows for easier verification using proof assistants and possible use of small models ($\\le 8B$). Experiments on several datasets suggest low probability of False Positives. The open-source implementation with instructions on setting up a server is available at https://github.com/LogicEnj/lean4_verification_pipeline."}],"geoLocations":[],"fundingReferences":[],"url":"https://arxiv.org/abs/2602.20770","contentUrl":null,"metadataVersion":0,"schemaVersion":"http://datacite.org/schema/kernel-4","source":"mds","isActive":true,"state":"findable","reason":null,"viewCount":0,"downloadCount":0,"referenceCount":0,"citationCount":0,"partCount":0,"partOfCount":0,"versionCount":0,"versionOfCount":0,"created":"2026-02-25T02:58:07Z","registered":"2026-02-25T02:58:08Z","published":null,"updated":"2026-02-25T02:58:08Z"},"relationships":{"client":{"data":{"id":"arxiv.content","type":"clients"}}}},{"id":"10.48550/arxiv.2602.20769","type":"dois","attributes":{"doi":"10.48550/arxiv.2602.20769","identifiers":[{"identifier":"2602.20769","identifierType":"arXiv"}],"creators":[{"nameType":"Personal","givenName":"Gianmarco","familyName":"Del Sarto","name":"Del Sarto, Gianmarco","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Matthias","familyName":"Hieber","name":"Hieber, Matthias","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Filippo","familyName":"Palma","name":"Palma, Filippo","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Tarek","familyName":"Zöchling","name":"Zöchling, Tarek","affiliation":[],"nameIdentifiers":[]}],"titles":[{"title":"Continuous Data Assimilation for Semilinear Parabolic Equations: A General Approach by Evolution Equations"}],"publisher":"arXiv","container":{},"publicationYear":2026,"subjects":[{"subject":"Analysis of PDEs (math.AP)","lang":"en","subjectScheme":"arXiv"},{"subject":"Mathematical Physics (math-ph)","lang":"en","subjectScheme":"arXiv"},{"subject":"FOS: Mathematics","subjectScheme":"Fields of Science and Technology (FOS)"},{"schemeUri":"http://www.oecd.org/science/inno/38235147.pdf","subject":"FOS: Mathematics","subjectScheme":"Fields of Science and Technology (FOS)"},{"subject":"FOS: Physical sciences","subjectScheme":"Fields of Science and Technology (FOS)"},{"schemeUri":"http://www.oecd.org/science/inno/38235147.pdf","subject":"FOS: Physical sciences","subjectScheme":"Fields of Science and Technology (FOS)"},{"subject":"35K90, 35K55, 47D06, 47J35, 35B40, 76U60","lang":"en","subjectScheme":"MSC"}],"contributors":[],"dates":[{"date":"2026-02-24T11:01:15Z","dateType":"Submitted","dateInformation":"v1"},{"date":"2026-02-25T01:41:29Z","dateType":"Updated","dateInformation":"v1"},{"date":"2026-02","dateType":"Available","dateInformation":"v1"},{"date":"2026","dateType":"Issued"}],"language":null,"types":{"schemaOrg":"CreativeWork","resourceTypeGeneral":"Preprint","citeproc":"article","bibtex":"misc","ris":"GEN","resourceType":"Article"},"relatedIdentifiers":[],"relatedItems":[],"sizes":[],"formats":[],"version":"1","rightsList":[{"rightsIdentifierScheme":"SPDX","rightsUri":"https://creativecommons.org/licenses/by/4.0/legalcode","schemeUri":"https://spdx.org/licenses/","rights":"Creative Commons Attribution 4.0 International","rightsIdentifier":"cc-by-4.0"}],"descriptions":[{"descriptionType":"Abstract","description":"This article develops a general framework for continuous deterministic data assimilation for semilinear parabolic equations by means of evolution equations. Introducing a nudged model driven by partial observations, the global well-posedness of the reference and the approximating systems is established under natural assumptions. In addition, it is shown that the approximating solution converges exponentially to the solution of the reference system, provided the observational resolution and the nudging parameter are suitably chosen. The approach allows us to consider many systems, such as the Allen-Cahn, Cahn-Hilliard, Sellers-type energy balance, and bidomain systems, for the first time."}],"geoLocations":[],"fundingReferences":[],"url":"https://arxiv.org/abs/2602.20769","contentUrl":null,"metadataVersion":0,"schemaVersion":"http://datacite.org/schema/kernel-4","source":"mds","isActive":true,"state":"findable","reason":null,"viewCount":0,"downloadCount":0,"referenceCount":0,"citationCount":0,"partCount":0,"partOfCount":0,"versionCount":0,"versionOfCount":0,"created":"2026-02-25T02:58:06Z","registered":"2026-02-25T02:58:06Z","published":null,"updated":"2026-02-25T02:58:06Z"},"relationships":{"client":{"data":{"id":"arxiv.content","type":"clients"}}}},{"id":"10.48550/arxiv.2602.20767","type":"dois","attributes":{"doi":"10.48550/arxiv.2602.20767","identifiers":[{"identifier":"2602.20767","identifierType":"arXiv"}],"creators":[{"nameType":"Personal","givenName":"Jiesheng","familyName":"Wu","name":"Wu, Jiesheng","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Shengrong","familyName":"Li","name":"Li, Shengrong","affiliation":[],"nameIdentifiers":[]}],"titles":[{"title":"SPP-SCL: Semi-Push-Pull Supervised Contrastive Learning for Image-Text Sentiment Analysis and Beyond"}],"publisher":"arXiv","container":{},"publicationYear":2026,"subjects":[{"subject":"Multimedia (cs.MM)","lang":"en","subjectScheme":"arXiv"},{"subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"},{"schemeUri":"http://www.oecd.org/science/inno/38235147.pdf","subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"}],"contributors":[],"dates":[{"date":"2026-02-24T10:59:59Z","dateType":"Submitted","dateInformation":"v1"},{"date":"2026-02-25T01:41:26Z","dateType":"Updated","dateInformation":"v1"},{"date":"2026-02","dateType":"Available","dateInformation":"v1"},{"date":"2026","dateType":"Issued"}],"language":null,"types":{"schemaOrg":"CreativeWork","resourceTypeGeneral":"Preprint","citeproc":"article","bibtex":"misc","ris":"GEN","resourceType":"Article"},"relatedIdentifiers":[],"relatedItems":[],"sizes":[],"formats":[],"version":"1","rightsList":[{"rightsUri":"http://arxiv.org/licenses/nonexclusive-distrib/1.0/","rights":"arXiv.org perpetual, non-exclusive license"}],"descriptions":[{"descriptionType":"Abstract","description":"Existing Image-Text Sentiment Analysis (ITSA) methods may suffer from inconsistent intra-modal and inter-modal sentiment relationships. Therefore, we develop a method that balances before fusing to solve the issue of vision-language imbalance intra-modal and inter-modal sentiment relationships; that is, a Semi-Push-Pull Supervised Contrastive Learning (SPP-SCL) method is proposed. Specifically, the method is implemented using a novel two-step strategy, namely first using the proposed intra-modal supervised contrastive learning to pull the relationships between the intra-modal and then performing a well-designed conditional execution statement. If the statement result is false, our method will perform the second step, which is inter-modal supervised contrastive learning to push away the relationships between inter-modal. The two-step strategy will balance the intra-modal and inter-modal relationships to achieve the purpose of relationship consistency and finally perform cross-modal feature fusion for sentiment analysis and detection. Experimental studies on three public image-text sentiment and sarcasm detection datasets demonstrate that SPP-SCL significantly outperforms state-of-the-art methods by a large margin and is more discriminative in sentiment."},{"descriptionType":"Other","description":"Accepted and published by AAAI2026"}],"geoLocations":[],"fundingReferences":[],"url":"https://arxiv.org/abs/2602.20767","contentUrl":null,"metadataVersion":0,"schemaVersion":"http://datacite.org/schema/kernel-4","source":"mds","isActive":true,"state":"findable","reason":null,"viewCount":0,"downloadCount":0,"referenceCount":0,"citationCount":0,"partCount":0,"partOfCount":0,"versionCount":0,"versionOfCount":0,"created":"2026-02-25T02:58:03Z","registered":"2026-02-25T02:58:04Z","published":null,"updated":"2026-02-25T02:58:04Z"},"relationships":{"client":{"data":{"id":"arxiv.content","type":"clients"}}}},{"id":"10.48550/arxiv.2602.20763","type":"dois","attributes":{"doi":"10.48550/arxiv.2602.20763","identifiers":[{"identifier":"2602.20763","identifierType":"arXiv"}],"creators":[{"nameType":"Personal","givenName":"Xiaofen","familyName":"Huang","name":"Huang, Xiaofen","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Xishun","familyName":"Zhu","name":"Zhu, Xishun","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Bin","familyName":"Chen","name":"Chen, Bin","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Naihuan","familyName":"Jing","name":"Jing, Naihuan","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Shao-Ming","familyName":"Fei","name":"Fei, Shao-Ming","affiliation":[],"nameIdentifiers":[]}],"titles":[{"title":"A note on entanglement detection via the generalized realignment moments"}],"publisher":"arXiv","container":{},"publicationYear":2026,"subjects":[{"subject":"Quantum Physics (quant-ph)","lang":"en","subjectScheme":"arXiv"},{"subject":"FOS: Physical sciences","subjectScheme":"Fields of Science and Technology (FOS)"},{"schemeUri":"http://www.oecd.org/science/inno/38235147.pdf","subject":"FOS: Physical sciences","subjectScheme":"Fields of Science and Technology (FOS)"}],"contributors":[],"dates":[{"date":"2026-02-24T10:44:17Z","dateType":"Submitted","dateInformation":"v1"},{"date":"2026-02-25T01:40:49Z","dateType":"Updated","dateInformation":"v1"},{"date":"2026-02","dateType":"Available","dateInformation":"v1"},{"date":"2026","dateType":"Issued"}],"language":null,"types":{"schemaOrg":"CreativeWork","resourceTypeGeneral":"Preprint","citeproc":"article","bibtex":"misc","ris":"GEN","resourceType":"Article"},"relatedIdentifiers":[],"relatedItems":[],"sizes":[],"formats":[],"version":"1","rightsList":[{"rightsUri":"http://arxiv.org/licenses/nonexclusive-distrib/1.0/","rights":"arXiv.org perpetual, non-exclusive license"}],"descriptions":[{"descriptionType":"Abstract","description":"The experimental detection of quantum entanglement is of great importance in quantum information processing. We present two separability criteria based on the generalized realignment moments. By incorporating additional parameters, these criteria prove to be more flexible and stronger than some of existing ones. Detailed examples are given to demonstrate their availability and feasibility for entanglement detection."}],"geoLocations":[],"fundingReferences":[],"url":"https://arxiv.org/abs/2602.20763","contentUrl":null,"metadataVersion":0,"schemaVersion":"http://datacite.org/schema/kernel-4","source":"mds","isActive":true,"state":"findable","reason":null,"viewCount":0,"downloadCount":0,"referenceCount":0,"citationCount":0,"partCount":0,"partOfCount":0,"versionCount":0,"versionOfCount":0,"created":"2026-02-25T02:57:57Z","registered":"2026-02-25T02:57:58Z","published":null,"updated":"2026-02-25T02:57:58Z"},"relationships":{"client":{"data":{"id":"arxiv.content","type":"clients"}}}},{"id":"10.48550/arxiv.2602.20762","type":"dois","attributes":{"doi":"10.48550/arxiv.2602.20762","identifiers":[{"identifier":"2602.20762","identifierType":"arXiv"}],"creators":[{"nameType":"Personal","givenName":"Keigo","familyName":"Oka","name":"Oka, Keigo","affiliation":[],"nameIdentifiers":[]}],"titles":[{"title":"Turing Completeness of GNU find: From mkdir-assisted Loops to Standalone Computation"}],"publisher":"arXiv","container":{},"publicationYear":2026,"subjects":[{"subject":"Data Structures and Algorithms (cs.DS)","lang":"en","subjectScheme":"arXiv"},{"subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"},{"schemeUri":"http://www.oecd.org/science/inno/38235147.pdf","subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"}],"contributors":[],"dates":[{"date":"2026-02-24T10:41:47Z","dateType":"Submitted","dateInformation":"v1"},{"date":"2026-02-25T01:40:45Z","dateType":"Updated","dateInformation":"v1"},{"date":"2026-02","dateType":"Available","dateInformation":"v1"},{"date":"2026","dateType":"Issued"}],"language":null,"types":{"schemaOrg":"CreativeWork","resourceTypeGeneral":"Preprint","citeproc":"article","bibtex":"misc","ris":"GEN","resourceType":"Article"},"relatedIdentifiers":[],"relatedItems":[],"sizes":[],"formats":[],"version":"1","rightsList":[{"rightsIdentifierScheme":"SPDX","rightsUri":"https://creativecommons.org/licenses/by/4.0/legalcode","schemeUri":"https://spdx.org/licenses/","rights":"Creative Commons Attribution 4.0 International","rightsIdentifier":"cc-by-4.0"}],"descriptions":[{"descriptionType":"Abstract","description":"The Unix command \\texttt{find} is among the first commands taught to beginners, yet remains indispensable for experienced engineers. In this paper, we demonstrate that \\texttt{find} possesses unexpected computational power, establishing three Turing completeness results using the GNU implementation (a standard in Linux distributions). (1) \\texttt{find} + \\texttt{mkdir} (a system that has only \\texttt{find} and \\texttt{mkdir}) is Turing complete: by encoding computational states as directory paths and using regex back-references to copy substrings, we simulate 2-tag systems. (2) GNU \\texttt{find} 4.9.0+ alone is Turing complete: by reading and writing to files during traversal, we simulate a two-counter machine without \\texttt{mkdir}. (3) \\texttt{find} + \\texttt{mkdir} without regex back-references is still Turing complete: by a trick of encoding regex patterns directly into directory names, we achieve the same power.\n These results place \\texttt{find} among the ``surprisingly Turing-complete'' systems, highlighting the hidden complexity within seemingly simple standard utilities."}],"geoLocations":[],"fundingReferences":[],"url":"https://arxiv.org/abs/2602.20762","contentUrl":null,"metadataVersion":0,"schemaVersion":"http://datacite.org/schema/kernel-4","source":"mds","isActive":true,"state":"findable","reason":null,"viewCount":0,"downloadCount":0,"referenceCount":0,"citationCount":0,"partCount":0,"partOfCount":0,"versionCount":0,"versionOfCount":0,"created":"2026-02-25T02:57:56Z","registered":"2026-02-25T02:57:56Z","published":null,"updated":"2026-02-25T02:57:56Z"},"relationships":{"client":{"data":{"id":"arxiv.content","type":"clients"}}}},{"id":"10.48550/arxiv.2602.20760","type":"dois","attributes":{"doi":"10.48550/arxiv.2602.20760","identifiers":[{"identifier":"2602.20760","identifierType":"arXiv"}],"creators":[{"nameType":"Personal","givenName":"Arnab","familyName":"Chaudhuri","name":"Chaudhuri, Arnab","affiliation":[],"nameIdentifiers":[]}],"titles":[{"title":"Dark Temperature Hierarchies and Gravitational Waves from the Electroweak Phase Transition"}],"publisher":"arXiv","container":{},"publicationYear":2026,"subjects":[{"subject":"High Energy Physics - Phenomenology (hep-ph)","lang":"en","subjectScheme":"arXiv"},{"subject":"FOS: Physical sciences","subjectScheme":"Fields of Science and Technology (FOS)"},{"schemeUri":"http://www.oecd.org/science/inno/38235147.pdf","subject":"FOS: Physical sciences","subjectScheme":"Fields of Science and Technology (FOS)"}],"contributors":[],"dates":[{"date":"2026-02-24T10:40:52Z","dateType":"Submitted","dateInformation":"v1"},{"date":"2026-02-25T01:40:42Z","dateType":"Updated","dateInformation":"v1"},{"date":"2026-02","dateType":"Available","dateInformation":"v1"},{"date":"2026","dateType":"Issued"}],"language":null,"types":{"schemaOrg":"CreativeWork","resourceTypeGeneral":"Preprint","citeproc":"article","bibtex":"misc","ris":"GEN","resourceType":"Article"},"relatedIdentifiers":[],"relatedItems":[],"sizes":[],"formats":[],"version":"1","rightsList":[{"rightsIdentifierScheme":"SPDX","rightsUri":"https://creativecommons.org/licenses/by/4.0/legalcode","schemeUri":"https://spdx.org/licenses/","rights":"Creative Commons Attribution 4.0 International","rightsIdentifier":"cc-by-4.0"}],"descriptions":[{"descriptionType":"Abstract","description":"We investigate the impact of a semi-decoupled dark sector with a temperature hierarchy relative to the Standard Model plasma on the electroweak phase transition and its associated gravitational wave signal. Working within a minimal Higgs-portal extension, we allow the dark sector to possess a higher temperature at the electroweak epoch while remaining consistent with cosmological bounds on additional relativistic degrees of freedom. The temperature hierarchy modifies the thermal structure of the effective potential and alters nucleation dynamics without requiring large portal couplings or extreme supercooling. Within the cosmologically allowed window, we find a monotonic enhancement of the gravitational wave amplitude by more than an order of magnitude compared to the standard thermal case, accompanied by a shift of the peak frequency within the millihertz regime. The resulting stochastic background moves substantially closer to the projected sensitivity of future space-based interferometers. Our results demonstrate that hidden-sector temperature hierarchies can leave observable imprints on electroweak-scale phase transitions even in minimal and perturbative frameworks."},{"descriptionType":"Other","description":"13 pages, 3 figures"}],"geoLocations":[],"fundingReferences":[],"url":"https://arxiv.org/abs/2602.20760","contentUrl":null,"metadataVersion":0,"schemaVersion":"http://datacite.org/schema/kernel-4","source":"mds","isActive":true,"state":"findable","reason":null,"viewCount":0,"downloadCount":0,"referenceCount":0,"citationCount":0,"partCount":0,"partOfCount":0,"versionCount":0,"versionOfCount":0,"created":"2026-02-25T02:57:53Z","registered":"2026-02-25T02:57:53Z","published":null,"updated":"2026-02-25T02:57:53Z"},"relationships":{"client":{"data":{"id":"arxiv.content","type":"clients"}}}},{"id":"10.48550/arxiv.2602.20759","type":"dois","attributes":{"doi":"10.48550/arxiv.2602.20759","identifiers":[{"identifier":"2602.20759","identifierType":"arXiv"}],"creators":[{"nameType":"Personal","givenName":"Yu","familyName":"Fu","name":"Fu, Yu","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Seongho","familyName":"Son","name":"Son, Seongho","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Ilija","familyName":"Bogunovic","name":"Bogunovic, Ilija","affiliation":[],"nameIdentifiers":[]}],"titles":[{"title":"Overton Pluralistic Reinforcement Learning for Large Language Models"}],"publisher":"arXiv","container":{},"publicationYear":2026,"subjects":[{"subject":"Computation and Language (cs.CL)","lang":"en","subjectScheme":"arXiv"},{"subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"},{"schemeUri":"http://www.oecd.org/science/inno/38235147.pdf","subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"}],"contributors":[],"dates":[{"date":"2026-02-24T10:39:27Z","dateType":"Submitted","dateInformation":"v1"},{"date":"2026-02-25T01:40:38Z","dateType":"Updated","dateInformation":"v1"},{"date":"2026-02","dateType":"Available","dateInformation":"v1"},{"date":"2026","dateType":"Issued"}],"language":null,"types":{"schemaOrg":"CreativeWork","resourceTypeGeneral":"Preprint","citeproc":"article","bibtex":"misc","ris":"GEN","resourceType":"Article"},"relatedIdentifiers":[],"relatedItems":[],"sizes":[],"formats":[],"version":"1","rightsList":[{"rightsIdentifierScheme":"SPDX","rightsUri":"https://creativecommons.org/licenses/by/4.0/legalcode","schemeUri":"https://spdx.org/licenses/","rights":"Creative Commons Attribution 4.0 International","rightsIdentifier":"cc-by-4.0"}],"descriptions":[{"descriptionType":"Abstract","description":"Existing alignment paradigms remain limited in capturing the pluralistic nature of human values. Overton Pluralism addresses this gap by generating responses with diverse perspectives from a single query. This paper introduces OP-GRPO (Overton Pluralistic Group Relative Policy Optimization), a reinforcement learning framework for implicit Overton Pluralism that enables a single large language model to produce pluralistic responses without explicit prompting or modular orchestration. Our workflow consists of two main steps. First, similarity estimator training fine-tunes a Sentence Transformer for Overton Pluralism tasks to provide more accurate coverage evaluation of generated responses. Second, OP-GRPO training incorporates this similarity estimator into a dual-reward system designed to ensure both broad coverage of genuine human perspectives and the uniqueness of each perspective, thereby promoting diversity. Empirical results demonstrate a \"small models, big perspective coverage\" effect. The trained Qwen2.5-3B-Instruct model surpasses a 20B GPT-OSS baseline with a 37.4 percent relative accuracy gain on a Natural Language Inference benchmark, and also outperforms a modular architecture baseline with a 19.1 percent relative improvement. Additional evaluations using GPT-4.1 as a large language model judge further confirm the robustness of the approach."},{"descriptionType":"Other","description":"28 pages, 8 figures"}],"geoLocations":[],"fundingReferences":[],"url":"https://arxiv.org/abs/2602.20759","contentUrl":null,"metadataVersion":0,"schemaVersion":"http://datacite.org/schema/kernel-4","source":"mds","isActive":true,"state":"findable","reason":null,"viewCount":0,"downloadCount":0,"referenceCount":0,"citationCount":0,"partCount":0,"partOfCount":0,"versionCount":0,"versionOfCount":0,"created":"2026-02-25T02:57:51Z","registered":"2026-02-25T02:57:52Z","published":null,"updated":"2026-02-25T02:57:52Z"},"relationships":{"client":{"data":{"id":"arxiv.content","type":"clients"}}}},{"id":"10.48550/arxiv.2602.20758","type":"dois","attributes":{"doi":"10.48550/arxiv.2602.20758","identifiers":[{"identifier":"2602.20758","identifierType":"arXiv"}],"creators":[{"nameType":"Personal","givenName":"Jonathan","familyName":"Spence","name":"Spence, Jonathan","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Tobías I.","familyName":"Liaudat","name":"Liaudat, Tobías I.","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Konstantinos","familyName":"Zygalakis","name":"Zygalakis, Konstantinos","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Marcelo","familyName":"Pereyra","name":"Pereyra, Marcelo","affiliation":[],"nameIdentifiers":[]}],"titles":[{"title":"Deep unfolding of MCMC kernels: scalable, modular \u0026amp; explainable GANs for high-dimensional posterior sampling"}],"publisher":"arXiv","container":{},"publicationYear":2026,"subjects":[{"subject":"Machine Learning (cs.LG)","lang":"en","subjectScheme":"arXiv"},{"subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"},{"schemeUri":"http://www.oecd.org/science/inno/38235147.pdf","subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"},{"subject":"65C60, 62F15","lang":"en","subjectScheme":"MSC"}],"contributors":[],"dates":[{"date":"2026-02-24T10:37:10Z","dateType":"Submitted","dateInformation":"v1"},{"date":"2026-02-25T01:40:25Z","dateType":"Updated","dateInformation":"v1"},{"date":"2026-02","dateType":"Available","dateInformation":"v1"},{"date":"2026","dateType":"Issued"}],"language":null,"types":{"schemaOrg":"CreativeWork","resourceTypeGeneral":"Preprint","citeproc":"article","bibtex":"misc","ris":"GEN","resourceType":"Article"},"relatedIdentifiers":[],"relatedItems":[],"sizes":[],"formats":[],"version":"1","rightsList":[{"rightsIdentifierScheme":"SPDX","rightsUri":"https://creativecommons.org/licenses/by/4.0/legalcode","schemeUri":"https://spdx.org/licenses/","rights":"Creative Commons Attribution 4.0 International","rightsIdentifier":"cc-by-4.0"}],"descriptions":[{"descriptionType":"Abstract","description":"Markov chain Monte Carlo (MCMC) methods are fundamental to Bayesian computation, but can be computationally intensive, especially in high-dimensional settings. Push-forward generative models, such as generative adversarial networks (GANs), variational auto-encoders and normalising flows offer a computationally efficient alternative for posterior sampling. However, push-forward models are opaque as they lack the modularity of Bayes Theorem, leading to poor generalisation with respect to changes in the likelihood function. In this work, we introduce a novel approach to GAN architecture design by applying deep unfolding to Langevin MCMC algorithms. This paradigm maps fixed-step iterative algorithms onto modular neural networks, yielding architectures that are both flexible and amenable to interpretation. Crucially, our design allows key model parameters to be specified at inference time, offering robustness to changes in the likelihood parameters. We train these unfolded samplers end-to-end using a supervised regularized Wasserstein GAN framework for posterior sampling. Through extensive Bayesian imaging experiments, we demonstrate that our proposed approach achieves high sampling accuracy and excellent computational efficiency, while retaining the physics consistency, adaptability and interpretability of classical MCMC strategies."},{"descriptionType":"Other","description":"37 pages, 10 figures, 5 tables"}],"geoLocations":[],"fundingReferences":[],"url":"https://arxiv.org/abs/2602.20758","contentUrl":null,"metadataVersion":0,"schemaVersion":"http://datacite.org/schema/kernel-4","source":"mds","isActive":true,"state":"findable","reason":null,"viewCount":0,"downloadCount":0,"referenceCount":0,"citationCount":0,"partCount":0,"partOfCount":0,"versionCount":0,"versionOfCount":0,"created":"2026-02-25T02:57:50Z","registered":"2026-02-25T02:57:51Z","published":null,"updated":"2026-02-25T02:57:51Z"},"relationships":{"client":{"data":{"id":"arxiv.content","type":"clients"}}}},{"id":"10.48550/arxiv.2602.20756","type":"dois","attributes":{"doi":"10.48550/arxiv.2602.20756","identifiers":[{"identifier":"2602.20756","identifierType":"arXiv"}],"creators":[{"nameType":"Personal","givenName":"Jovan","familyName":"Blagojević","name":"Blagojević, Jovan","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Ana","familyName":"Milosavljević","name":"Milosavljević, Ana","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Tea","familyName":"Belojica","name":"Belojica, Tea","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Marko","familyName":"Opačić","name":"Opačić, Marko","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Andrijana","familyName":"Šolajić","name":"Šolajić, Andrijana","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Jelena","familyName":"Pešić","name":"Pešić, Jelena","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Enrico","familyName":"Di Lucente","name":"Di Lucente, Enrico","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Novica","familyName":"Paunović","name":"Paunović, Novica","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Milorad V.","familyName":"Milošević","name":"Milošević, Milorad V.","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Emil S.","familyName":"Božin","name":"Božin, Emil S.","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Aifeng","familyName":"Wang","name":"Wang, Aifeng","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Cedomir","familyName":"Petrović","name":"Petrović, Cedomir","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Zoran V.","familyName":"Popović","name":"Popović, Zoran V.","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Rudi","familyName":"Hackl","name":"Hackl, Rudi","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Bojana","familyName":"Višić","name":"Višić, Bojana","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Nenad","familyName":"Lazarević","name":"Lazarević, Nenad","affiliation":[],"nameIdentifiers":[]}],"titles":[{"title":"Fluctuation-enhanced electron-phonon coupling in FeSe"}],"publisher":"arXiv","container":{},"publicationYear":2026,"subjects":[{"subject":"Superconductivity (cond-mat.supr-con)","lang":"en","subjectScheme":"arXiv"},{"subject":"Strongly Correlated Electrons (cond-mat.str-el)","lang":"en","subjectScheme":"arXiv"},{"subject":"FOS: Physical sciences","subjectScheme":"Fields of Science and Technology (FOS)"},{"schemeUri":"http://www.oecd.org/science/inno/38235147.pdf","subject":"FOS: Physical sciences","subjectScheme":"Fields of Science and Technology (FOS)"}],"contributors":[],"dates":[{"date":"2026-02-24T10:35:35Z","dateType":"Submitted","dateInformation":"v1"},{"date":"2026-02-25T01:40:12Z","dateType":"Updated","dateInformation":"v1"},{"date":"2026-02","dateType":"Available","dateInformation":"v1"},{"date":"2026","dateType":"Issued"}],"language":null,"types":{"schemaOrg":"CreativeWork","resourceTypeGeneral":"Preprint","citeproc":"article","bibtex":"misc","ris":"GEN","resourceType":"Article"},"relatedIdentifiers":[],"relatedItems":[],"sizes":[],"formats":[],"version":"1","rightsList":[{"rightsIdentifierScheme":"SPDX","rightsUri":"https://creativecommons.org/licenses/by/4.0/legalcode","schemeUri":"https://spdx.org/licenses/","rights":"Creative Commons Attribution 4.0 International","rightsIdentifier":"cc-by-4.0"}],"descriptions":[{"descriptionType":"Abstract","description":"The interactions among lattice, charge, and spin degrees of freedom fundamentally shape material properties. In FeSe, symmetry-breaking perturbations serve as highly sensitive probes of these couplings. Previous work has shown that defects and isoelectronic substitution can substantially alter these interactions, giving rise to additional phonon modes. In this study, uniaxial strain is employed as a tunable symmetry-breaking control parameter to probe the intrinsic lattice response in the absence of disorder. The temperature evolution of phonon excitations was examined with fine temperature resolution in the vicinity of the nemato-structural transition temperature $T_s$, under strain applied along the $\\langle 110 \\rangle$ and $\\langle 100 \\rangle$ crystallographic directions. A subtle asymmetry of the $A_{1g}^{ph}$ mode appears in the unstrained crystal within a narrow temperature window around $T_s$, originating from the emergence of an additional mode in the fully symmetric channel. With applied strain, this feature becomes more distinctly resolved. The anomaly is attributed to modifications of the coupling between lattice and electronic degrees of freedom driven by the ordering fluctuations right above the nematic transition. These fluctuations enhance susceptibility for phonon-electron-phonon coupling in the vicinity of the X and R points of the Brillouin zone and promote two-phonon scattering close to the $A_{1g}^{ph}$ mode. The presence of this two-phonon scattering depends on both the strength and the direction of the applied strain, indicating a high sensitivity of FeSe to local symmetry breaking."}],"geoLocations":[],"fundingReferences":[],"url":"https://arxiv.org/abs/2602.20756","contentUrl":null,"metadataVersion":0,"schemaVersion":"http://datacite.org/schema/kernel-4","source":"mds","isActive":true,"state":"findable","reason":null,"viewCount":0,"downloadCount":0,"referenceCount":0,"citationCount":0,"partCount":0,"partOfCount":0,"versionCount":0,"versionOfCount":0,"created":"2026-02-25T02:57:47Z","registered":"2026-02-25T02:57:48Z","published":null,"updated":"2026-02-25T02:57:48Z"},"relationships":{"client":{"data":{"id":"arxiv.content","type":"clients"}}}},{"id":"10.48550/arxiv.2602.20755","type":"dois","attributes":{"doi":"10.48550/arxiv.2602.20755","identifiers":[{"identifier":"2602.20755","identifierType":"arXiv"}],"creators":[{"nameType":"Personal","givenName":"Stefano","familyName":"Ambra","name":"Ambra, Stefano","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Andrea","familyName":"Montoli","name":"Montoli, Andrea","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Diana","familyName":"Rodelo","name":"Rodelo, Diana","affiliation":[],"nameIdentifiers":[]}],"titles":[{"title":"The direction functor for Schreier extensions of monoids"}],"publisher":"arXiv","container":{},"publicationYear":2026,"subjects":[{"subject":"Category Theory (math.CT)","lang":"en","subjectScheme":"arXiv"},{"subject":"FOS: Mathematics","subjectScheme":"Fields of Science and Technology (FOS)"},{"schemeUri":"http://www.oecd.org/science/inno/38235147.pdf","subject":"FOS: Mathematics","subjectScheme":"Fields of Science and Technology (FOS)"},{"subject":"18G50, 20J06, 20M50, 18E13, 18C05","lang":"en","subjectScheme":"MSC"}],"contributors":[],"dates":[{"date":"2026-02-24T10:35:05Z","dateType":"Submitted","dateInformation":"v1"},{"date":"2026-02-25T01:40:11Z","dateType":"Updated","dateInformation":"v1"},{"date":"2026-02","dateType":"Available","dateInformation":"v1"},{"date":"2026","dateType":"Issued"}],"language":null,"types":{"schemaOrg":"CreativeWork","resourceTypeGeneral":"Preprint","citeproc":"article","bibtex":"misc","ris":"GEN","resourceType":"Article"},"relatedIdentifiers":[],"relatedItems":[],"sizes":[],"formats":[],"version":"1","rightsList":[{"rightsIdentifierScheme":"SPDX","rightsUri":"https://creativecommons.org/licenses/by-nc-nd/4.0/legalcode","schemeUri":"https://spdx.org/licenses/","rights":"Creative Commons Attribution Non Commercial No Derivatives 4.0 International","rightsIdentifier":"cc-by-nc-nd-4.0"}],"descriptions":[{"descriptionType":"Abstract","description":"We observe that the process of associating an action to any Schreier extension of monoids with commutative and cancellative kernel is functorial. We show that this functor is a generalisation of the direction functor, used to give a categorical description of non-abelian cohomology in terms of extensions. We further prove that our functor is a conservative, product preserving cofibration and from this we conclude that its fibres are endowed with a canonical symmetric monoidal structure. The commutative monoids obtained as connected components of these symmetric monoidal categories are isomorphic to Patchkoria second cohomology monoids of a monoid with coefficients in semimodules."}],"geoLocations":[],"fundingReferences":[],"url":"https://arxiv.org/abs/2602.20755","contentUrl":null,"metadataVersion":0,"schemaVersion":"http://datacite.org/schema/kernel-4","source":"mds","isActive":true,"state":"findable","reason":null,"viewCount":0,"downloadCount":0,"referenceCount":0,"citationCount":0,"partCount":0,"partOfCount":0,"versionCount":0,"versionOfCount":0,"created":"2026-02-25T02:57:46Z","registered":"2026-02-25T02:57:46Z","published":null,"updated":"2026-02-25T02:57:46Z"},"relationships":{"client":{"data":{"id":"arxiv.content","type":"clients"}}}},{"id":"10.48550/arxiv.2602.20753","type":"dois","attributes":{"doi":"10.48550/arxiv.2602.20753","identifiers":[{"identifier":"2602.20753","identifierType":"arXiv"}],"creators":[{"nameType":"Personal","givenName":"Kennett L. Dela","familyName":"Rosa","name":"Rosa, Kennett L. Dela","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Aedan Jarrod A.","familyName":"Potot","name":"Potot, Aedan Jarrod A.","affiliation":[],"nameIdentifiers":[]}],"titles":[{"title":"Schur-Horn theorem and Ky Fan's minimum principle for symplectic eigenvalues"}],"publisher":"arXiv","container":{},"publicationYear":2026,"subjects":[{"subject":"Functional Analysis (math.FA)","lang":"en","subjectScheme":"arXiv"},{"subject":"Rings and Algebras (math.RA)","lang":"en","subjectScheme":"arXiv"},{"subject":"FOS: Mathematics","subjectScheme":"Fields of Science and Technology (FOS)"},{"schemeUri":"http://www.oecd.org/science/inno/38235147.pdf","subject":"FOS: Mathematics","subjectScheme":"Fields of Science and Technology (FOS)"},{"subject":"15A42, 15A99, 15B57, 15B99","lang":"en","subjectScheme":"MSC"}],"contributors":[],"dates":[{"date":"2026-02-24T10:31:33Z","dateType":"Submitted","dateInformation":"v1"},{"date":"2026-02-25T01:40:04Z","dateType":"Updated","dateInformation":"v1"},{"date":"2026-02","dateType":"Available","dateInformation":"v1"},{"date":"2026","dateType":"Issued"}],"language":null,"types":{"schemaOrg":"CreativeWork","resourceTypeGeneral":"Preprint","citeproc":"article","bibtex":"misc","ris":"GEN","resourceType":"Article"},"relatedIdentifiers":[],"relatedItems":[],"sizes":[],"formats":[],"version":"1","rightsList":[{"rightsIdentifierScheme":"SPDX","rightsUri":"https://creativecommons.org/licenses/by-nc-nd/4.0/legalcode","schemeUri":"https://spdx.org/licenses/","rights":"Creative Commons Attribution Non Commercial No Derivatives 4.0 International","rightsIdentifier":"cc-by-nc-nd-4.0"}],"descriptions":[{"descriptionType":"Abstract","description":"The symplectic analogues of Schur's theorem and Ky Fan's minimum principle are shown to be equivalent. Moreover, the symplectic Schur's and Horn's theorems are extended to generalized means."}],"geoLocations":[],"fundingReferences":[],"url":"https://arxiv.org/abs/2602.20753","contentUrl":null,"metadataVersion":0,"schemaVersion":"http://datacite.org/schema/kernel-4","source":"mds","isActive":true,"state":"findable","reason":null,"viewCount":0,"downloadCount":0,"referenceCount":0,"citationCount":0,"partCount":0,"partOfCount":0,"versionCount":0,"versionOfCount":0,"created":"2026-02-25T02:57:43Z","registered":"2026-02-25T02:57:43Z","published":null,"updated":"2026-02-25T02:57:43Z"},"relationships":{"client":{"data":{"id":"arxiv.content","type":"clients"}}}},{"id":"10.48550/arxiv.2602.20752","type":"dois","attributes":{"doi":"10.48550/arxiv.2602.20752","identifiers":[{"identifier":"2602.20752","identifierType":"arXiv"}],"creators":[{"nameType":"Personal","givenName":"Tian","familyName":"Lan","name":"Lan, Tian","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Lei","familyName":"Xu","name":"Xu, Lei","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Zimu","familyName":"Yuan","name":"Yuan, Zimu","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Shanggui","familyName":"Liu","name":"Liu, Shanggui","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Jiajun","familyName":"Liu","name":"Liu, Jiajun","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Jiaxin","familyName":"Liu","name":"Liu, Jiaxin","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Weilai","familyName":"Xiang","name":"Xiang, Weilai","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Hongyu","familyName":"Yang","name":"Yang, Hongyu","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Dong","familyName":"Jiang","name":"Jiang, Dong","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Jianxin","familyName":"Yin","name":"Yin, Jianxin","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Dingyu","familyName":"Wang","name":"Wang, Dingyu","affiliation":[],"nameIdentifiers":[]}],"titles":[{"title":"OrthoDiffusion: A Generalizable Multi-Task Diffusion Foundation Model for Musculoskeletal MRI Interpretation"}],"publisher":"arXiv","container":{},"publicationYear":2026,"subjects":[{"subject":"Computer Vision and Pattern Recognition (cs.CV)","lang":"en","subjectScheme":"arXiv"},{"subject":"Artificial Intelligence (cs.AI)","lang":"en","subjectScheme":"arXiv"},{"subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"},{"schemeUri":"http://www.oecd.org/science/inno/38235147.pdf","subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"}],"contributors":[],"dates":[{"date":"2026-02-24T10:29:10Z","dateType":"Submitted","dateInformation":"v1"},{"date":"2026-02-25T01:39:45Z","dateType":"Updated","dateInformation":"v1"},{"date":"2026-02","dateType":"Available","dateInformation":"v1"},{"date":"2026","dateType":"Issued"}],"language":null,"types":{"schemaOrg":"CreativeWork","resourceTypeGeneral":"Preprint","citeproc":"article","bibtex":"misc","ris":"GEN","resourceType":"Article"},"relatedIdentifiers":[],"relatedItems":[],"sizes":[],"formats":[],"version":"1","rightsList":[{"rightsIdentifierScheme":"SPDX","rightsUri":"https://creativecommons.org/licenses/by/4.0/legalcode","schemeUri":"https://spdx.org/licenses/","rights":"Creative Commons Attribution 4.0 International","rightsIdentifier":"cc-by-4.0"}],"descriptions":[{"descriptionType":"Abstract","description":"Musculoskeletal disorders represent a significant global health burden and are a leading cause of disability worldwide. While MRI is essential for accurate diagnosis, its interpretation remains exceptionally challenging. Radiologists must identify multiple potential abnormalities within complex anatomical structures across different imaging planes, a process that requires significant expertise and is prone to variability. We developed OrthoDiffusion, a unified diffusion-based foundation model designed for multi-task musculoskeletal MRI interpretation. The framework utilizes three orientation-specific 3D diffusion models, pre-trained in a self-supervised manner on 15,948 unlabeled knee MRI scans, to learn robust anatomical features from sagittal, coronal, and axial views. These view-specific representations are integrated to support diverse clinical tasks, including anatomical segmentation and multi-label diagnosis. Our evaluation demonstrates that OrthoDiffusion achieves excellent performance in the segmentation of 11 knee structures and the detection of 8 knee abnormalities. The model exhibited remarkable robustness across different clinical centers and MRI field strengths, consistently outperforming traditional supervised models. Notably, in settings where labeled data was scarce, OrthoDiffusion maintained high diagnostic precision using only 10\\% of training labels. Furthermore, the anatomical representations learned from knee imaging proved highly transferable to other joints, achieving strong diagnostic performance across 11 diseases of the ankle and shoulder. These findings suggest that diffusion-based foundation models can serve as a unified platform for multi-disease diagnosis and anatomical segmentation, potentially improving the efficiency and accuracy of musculoskeletal MRI interpretation in real-world clinical workflows."}],"geoLocations":[],"fundingReferences":[],"url":"https://arxiv.org/abs/2602.20752","contentUrl":null,"metadataVersion":0,"schemaVersion":"http://datacite.org/schema/kernel-4","source":"mds","isActive":true,"state":"findable","reason":null,"viewCount":0,"downloadCount":0,"referenceCount":0,"citationCount":0,"partCount":0,"partOfCount":0,"versionCount":0,"versionOfCount":0,"created":"2026-02-25T02:57:41Z","registered":"2026-02-25T02:57:42Z","published":null,"updated":"2026-02-25T02:57:42Z"},"relationships":{"client":{"data":{"id":"arxiv.content","type":"clients"}}}},{"id":"10.48550/arxiv.2602.20751","type":"dois","attributes":{"doi":"10.48550/arxiv.2602.20751","identifiers":[{"identifier":"2602.20751","identifierType":"arXiv"}],"creators":[{"nameType":"Personal","givenName":"Yifei","familyName":"Xu","name":"Xu, Yifei","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Guilherme","familyName":"Potje","name":"Potje, Guilherme","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Shivam","familyName":"Shandilya","name":"Shandilya, Shivam","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Tiancheng","familyName":"Yuan","name":"Yuan, Tiancheng","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Leonardo de Oliveira","familyName":"Nunes","name":"Nunes, Leonardo de Oliveira","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Rakshanda","familyName":"Agarwal","name":"Agarwal, Rakshanda","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Saeid","familyName":"Asgari","name":"Asgari, Saeid","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Adam","familyName":"Atkinson","name":"Atkinson, Adam","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Emre","familyName":"Kıcıman","name":"Kıcıman, Emre","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Songwu","familyName":"Lu","name":"Lu, Songwu","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Ranveer","familyName":"Chandra","name":"Chandra, Ranveer","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Tusher","familyName":"Chakraborty","name":"Chakraborty, Tusher","affiliation":[],"nameIdentifiers":[]}],"titles":[{"title":"SibylSense: Adaptive Rubric Learning via Memory Tuning and Adversarial Probing"}],"publisher":"arXiv","container":{},"publicationYear":2026,"subjects":[{"subject":"Computation and Language (cs.CL)","lang":"en","subjectScheme":"arXiv"},{"subject":"Artificial Intelligence (cs.AI)","lang":"en","subjectScheme":"arXiv"},{"subject":"Machine Learning (cs.LG)","lang":"en","subjectScheme":"arXiv"},{"subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"},{"schemeUri":"http://www.oecd.org/science/inno/38235147.pdf","subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"}],"contributors":[],"dates":[{"date":"2026-02-24T10:28:44Z","dateType":"Submitted","dateInformation":"v1"},{"date":"2026-02-25T01:39:36Z","dateType":"Updated","dateInformation":"v1"},{"date":"2026-02","dateType":"Available","dateInformation":"v1"},{"date":"2026","dateType":"Issued"}],"language":null,"types":{"schemaOrg":"CreativeWork","resourceTypeGeneral":"Preprint","citeproc":"article","bibtex":"misc","ris":"GEN","resourceType":"Article"},"relatedIdentifiers":[],"relatedItems":[],"sizes":[],"formats":[],"version":"1","rightsList":[{"rightsUri":"http://arxiv.org/licenses/nonexclusive-distrib/1.0/","rights":"arXiv.org perpetual, non-exclusive license"}],"descriptions":[{"descriptionType":"Abstract","description":"Designing aligned and robust rewards for open-ended generation remains a key barrier to RL post-training. Rubrics provide structured, interpretable supervision, but scaling rubric construction is difficult: expert rubrics are costly, prompted rubrics are often superficial or inconsistent, and fixed-pool discriminative rubrics can saturate and drift, enabling reward hacking. We present SibylSense, an inference-time learning approach that adapts a frozen rubric generator through a tunable memory bank of validated rubric items. Memory is updated via verifier-based item rewards measured by reference-candidate answer discriminative gaps from a handful of examples. SibylSense alternates memory tuning with a rubric-adversarial policy update that produces rubric-satisfying candidate answers, shrinking discriminative gaps and driving the rubric generator to capture new quality dimensions. Experiments on two open-ended tasks show that SibylSense yields more discriminative rubrics and improves downstream RL performance over static and non-adaptive baselines."}],"geoLocations":[],"fundingReferences":[],"url":"https://arxiv.org/abs/2602.20751","contentUrl":null,"metadataVersion":0,"schemaVersion":"http://datacite.org/schema/kernel-4","source":"mds","isActive":true,"state":"findable","reason":null,"viewCount":0,"downloadCount":0,"referenceCount":0,"citationCount":0,"partCount":0,"partOfCount":0,"versionCount":0,"versionOfCount":0,"created":"2026-02-25T02:57:40Z","registered":"2026-02-25T02:57:41Z","published":null,"updated":"2026-02-25T02:57:41Z"},"relationships":{"client":{"data":{"id":"arxiv.content","type":"clients"}}}},{"id":"10.48550/arxiv.2602.20749","type":"dois","attributes":{"doi":"10.48550/arxiv.2602.20749","identifiers":[{"identifier":"2602.20749","identifierType":"arXiv"}],"creators":[{"nameType":"Personal","givenName":"Azrin","familyName":"Sultana","name":"Sultana, Azrin","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Firoz","familyName":"Ahmed","name":"Ahmed, Firoz","affiliation":[],"nameIdentifiers":[]}],"titles":[{"title":"Explicit Grammar Semantic Feature Fusion for Robust Text Classification"}],"publisher":"arXiv","container":{},"publicationYear":2026,"subjects":[{"subject":"Computation and Language (cs.CL)","lang":"en","subjectScheme":"arXiv"},{"subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"},{"schemeUri":"http://www.oecd.org/science/inno/38235147.pdf","subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"}],"contributors":[],"dates":[{"date":"2026-02-24T10:25:29Z","dateType":"Submitted","dateInformation":"v1"},{"date":"2026-02-25T01:39:30Z","dateType":"Updated","dateInformation":"v1"},{"date":"2026-02","dateType":"Available","dateInformation":"v1"},{"date":"2026","dateType":"Issued"}],"language":null,"types":{"schemaOrg":"CreativeWork","resourceTypeGeneral":"Preprint","citeproc":"article","bibtex":"misc","ris":"GEN","resourceType":"Article"},"relatedIdentifiers":[],"relatedItems":[],"sizes":[],"formats":[],"version":"1","rightsList":[{"rightsIdentifierScheme":"SPDX","rightsUri":"https://creativecommons.org/licenses/by-nc-nd/4.0/legalcode","schemeUri":"https://spdx.org/licenses/","rights":"Creative Commons Attribution Non Commercial No Derivatives 4.0 International","rightsIdentifier":"cc-by-nc-nd-4.0"}],"descriptions":[{"descriptionType":"Abstract","description":"Natural Language Processing enables computers to understand human language by analysing and classifying text efficiently with deep-level grammatical and semantic features. Existing models capture features by learning from large corpora with transformer models, which are computationally intensive and unsuitable for resource-constrained environments. Therefore, our proposed study incorporates comprehensive grammatical rules alongside semantic information to build a robust, lightweight classification model without resorting to full parameterised transformer models or heavy deep learning architectures. The novelty of our approach lies in its explicit encoding of sentence-level grammatical structure, including syntactic composition, phrase patterns, and complexity indicators, into a compact grammar vector, which is then fused with frozen contextual embeddings. These heterogeneous elements unified a single representation that captures both the structural and semantic characteristics of the text. Deep learning models such as Deep Belief Networks (DBNs), Long Short-Term Memory (LSTMs), BiLSTMs, and transformer-based BERT and XLNET were used to train and evaluate the model, with the number of epochs varied. Based on experimental results, the unified feature representation model captures both the semantic and structural properties of text, outperforming baseline models by 2%-15%, enabling more effective learning across heterogeneous domains. Unlike prior syntax-aware transformer models that inject grammatical structure through additional attention layers, tree encoders, or full fine-tuning, the proposed framework treats grammar as an explicit inductive bias rather than a learnable module, resulting in a very lightweight model that delivers better performance on edge devices"},{"descriptionType":"Other","description":"30 pages, 9 figures"}],"geoLocations":[],"fundingReferences":[],"url":"https://arxiv.org/abs/2602.20749","contentUrl":null,"metadataVersion":0,"schemaVersion":"http://datacite.org/schema/kernel-4","source":"mds","isActive":true,"state":"findable","reason":null,"viewCount":0,"downloadCount":0,"referenceCount":0,"citationCount":0,"partCount":0,"partOfCount":0,"versionCount":0,"versionOfCount":0,"created":"2026-02-25T02:57:37Z","registered":"2026-02-25T02:57:38Z","published":null,"updated":"2026-02-25T02:57:38Z"},"relationships":{"client":{"data":{"id":"arxiv.content","type":"clients"}}}},{"id":"10.48550/arxiv.2602.20748","type":"dois","attributes":{"doi":"10.48550/arxiv.2602.20748","identifiers":[{"identifier":"2602.20748","identifierType":"arXiv"}],"creators":[{"nameType":"Personal","givenName":"Sungwoo","familyName":"Park","name":"Park, Sungwoo","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Seohyeon","familyName":"Kim","name":"Kim, Seohyeon","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Min-Soo","familyName":"Kim","name":"Kim, Min-Soo","affiliation":[],"nameIdentifiers":[]}],"titles":[{"title":"cuRPQ: A High-Performance GPU-Based Framework for Processing Regular and Conjunctive Regular Path Queries"}],"publisher":"arXiv","container":{},"publicationYear":2026,"subjects":[{"subject":"Databases (cs.DB)","lang":"en","subjectScheme":"arXiv"},{"subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"},{"schemeUri":"http://www.oecd.org/science/inno/38235147.pdf","subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"}],"contributors":[],"dates":[{"date":"2026-02-24T10:22:23Z","dateType":"Submitted","dateInformation":"v1"},{"date":"2026-02-25T01:39:25Z","dateType":"Updated","dateInformation":"v1"},{"date":"2026-02","dateType":"Available","dateInformation":"v1"},{"date":"2026","dateType":"Issued"}],"language":null,"types":{"schemaOrg":"CreativeWork","resourceTypeGeneral":"Preprint","citeproc":"article","bibtex":"misc","ris":"GEN","resourceType":"Article"},"relatedIdentifiers":[],"relatedItems":[],"sizes":[],"formats":[],"version":"1","rightsList":[{"rightsUri":"http://arxiv.org/licenses/nonexclusive-distrib/1.0/","rights":"arXiv.org perpetual, non-exclusive license"}],"descriptions":[{"descriptionType":"Abstract","description":"Regular path queries (RPQs) are fundamental for path-constrained reachability analysis, and more complex variants such as conjunctive regular path queries (CRPQs) are increasingly used in graph analytics. Evaluating these queries is computationally expensive, but to the best of our knowledge, no prior work has explored GPU acceleration. In this paper, we propose cuRPQ, a high-performance GPU-optimized framework for processing RPQs and CRPQs. cuRPQ addresses the key GPU challenges through a novel traversal algorithm, an efficient visited-set management scheme, and a concurrent exploration-materialization strategy. Extensive experiments show that cuRPQ outperforms state-of-the-art methods by orders of magnitude, without out-of-memory errors."},{"descriptionType":"Other","description":"Accepted at SIGMOD 2026. 16 pages, 18 figures"}],"geoLocations":[],"fundingReferences":[],"url":"https://arxiv.org/abs/2602.20748","contentUrl":null,"metadataVersion":0,"schemaVersion":"http://datacite.org/schema/kernel-4","source":"mds","isActive":true,"state":"findable","reason":null,"viewCount":0,"downloadCount":0,"referenceCount":0,"citationCount":0,"partCount":0,"partOfCount":0,"versionCount":0,"versionOfCount":0,"created":"2026-02-25T02:57:36Z","registered":"2026-02-25T02:57:36Z","published":null,"updated":"2026-02-25T02:57:37Z"},"relationships":{"client":{"data":{"id":"arxiv.content","type":"clients"}}}},{"id":"10.48550/arxiv.2602.20746","type":"dois","attributes":{"doi":"10.48550/arxiv.2602.20746","identifiers":[{"identifier":"2602.20746","identifierType":"arXiv"}],"creators":[{"nameType":"Personal","givenName":"V.","familyName":"Pérez-Díez","name":"Pérez-Díez, V.","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"I.","familyName":"Martí-Vidal","name":"Martí-Vidal, I.","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"E.","familyName":"Albentosa-Ruiz","name":"Albentosa-Ruiz, E.","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"R.","familyName":"Bachiller","name":"Bachiller, R.","affiliation":[],"nameIdentifiers":[]}],"titles":[{"title":"Evidence of a non-equipartition energy regime in 1803+784 Core-shift and Faraday rotation measurements from simultaneous multi-frequency polarimetric VGOS observations"}],"publisher":"arXiv","container":{},"publicationYear":2026,"subjects":[{"subject":"High Energy Astrophysical Phenomena (astro-ph.HE)","lang":"en","subjectScheme":"arXiv"},{"subject":"Instrumentation and Methods for Astrophysics (astro-ph.IM)","lang":"en","subjectScheme":"arXiv"},{"subject":"FOS: Physical sciences","subjectScheme":"Fields of Science and Technology (FOS)"},{"schemeUri":"http://www.oecd.org/science/inno/38235147.pdf","subject":"FOS: Physical sciences","subjectScheme":"Fields of Science and Technology (FOS)"}],"contributors":[],"dates":[{"date":"2026-02-24T10:21:12Z","dateType":"Submitted","dateInformation":"v1"},{"date":"2026-02-25T01:39:15Z","dateType":"Updated","dateInformation":"v1"},{"date":"2026-02","dateType":"Available","dateInformation":"v1"},{"date":"2026","dateType":"Issued"}],"language":null,"types":{"schemaOrg":"CreativeWork","resourceTypeGeneral":"Preprint","citeproc":"article","bibtex":"misc","ris":"GEN","resourceType":"Article"},"relatedIdentifiers":[{"relationType":"IsVersionOf","relatedIdentifier":"10.1051/0004-6361/202555706","relatedIdentifierType":"DOI"}],"relatedItems":[],"sizes":[],"formats":[],"version":"1","rightsList":[{"rightsUri":"http://arxiv.org/licenses/nonexclusive-distrib/1.0/","rights":"arXiv.org perpetual, non-exclusive license"}],"descriptions":[{"descriptionType":"Abstract","description":"Context. Compact jets from active galactic nuclei (AGN) are commonly assumed to be in equipartition between particle and magnetic-field energy densities at the regions where the radio emission dominates at centimetre wavelengths. This assumption has significant implications for both jet physics and the accuracy of VLBI-based astrometry and geodesy.\n Aims. We tested the validity of the energy equipartition hypothesis in AGN cores at centimetre wavelengths by analysing the blazar 1803+784 using simultaneous broadband full-polarization observations with the VLBI Global Observing System (VGOS).\n Methods. We present VGOS observations of the blazar 1803+784 covering the 3-11 GHz frequency range. The data were processed using a dedicated calibration pipeline, followed by model fitting and multi-frequency imaging analysis. We measured the frequency-dependent core shift and mapped the spectral index and rotation measure (RM) across the source.\n Results. We find a core-shift power-law index of $k_r = 0.73^{+0.12}_{-0.19}$, significantly deviating from the expected equipartition value of $k_r = 1$. This indicates that either the equipartition condition or the conical jet geometry, or both, are not fulfilled in the centimetre-wavelength core region. The wide frequency coverage of VGOS also allows us to decouple the Faraday rotation of the core into an internal component (${\\rm RM}_I = 121 \\pm 8$ rad m$^{-2}$, produced in the core region) and an external component (${\\rm RM}_E = -44 \\pm 9$ rad m$^{-2}$, associated with a distant, extended medium that may also affect the polarization in downstream regions of the jet at larger scales).\n Conclusions. These results demonstrate the power of VGOS for high-fidelity simultaneous multi-frequency polarimetric studies of compact AGN jets, and underline the need to account for non-equipartition effects in both jet astrophysics and geodetic VLBI."},{"descriptionType":"Other","description":"Published in Astron. Astrophys. (A\u0026amp;A) Letters, 700, L22 (2025). 6 pages, 3 figures. Published online: 20 Aug 2025"}],"geoLocations":[],"fundingReferences":[],"url":"https://arxiv.org/abs/2602.20746","contentUrl":null,"metadataVersion":0,"schemaVersion":"http://datacite.org/schema/kernel-4","source":"mds","isActive":true,"state":"findable","reason":null,"viewCount":0,"downloadCount":0,"referenceCount":0,"citationCount":0,"partCount":0,"partOfCount":0,"versionCount":0,"versionOfCount":1,"created":"2026-02-25T02:57:33Z","registered":"2026-02-25T02:57:34Z","published":null,"updated":"2026-02-25T02:57:34Z"},"relationships":{"client":{"data":{"id":"arxiv.content","type":"clients"}}}},{"id":"10.48550/arxiv.2602.20745","type":"dois","attributes":{"doi":"10.48550/arxiv.2602.20745","identifiers":[{"identifier":"2602.20745","identifierType":"arXiv"}],"creators":[{"nameType":"Personal","affiliation":["NUS, Singapore"],"givenName":"Rishav","familyName":"Agrawal","name":"Agrawal, Rishav","nameIdentifiers":[]},{"nameType":"Personal","affiliation":["IIT Kharagpur, India"],"givenName":"Anjan","familyName":"Kar","name":"Kar, Anjan","nameIdentifiers":[]},{"nameType":"Personal","affiliation":["Sitananda College, India"],"givenName":"Soumya","familyName":"Jana","name":"Jana, Soumya","nameIdentifiers":[]},{"nameType":"Personal","affiliation":["IIT Kharagpur, India"],"givenName":"Sayan","familyName":"Kar","name":"Kar, Sayan","nameIdentifiers":[]}],"titles":[{"title":"Gravitational wave radiation from periodic orbits in regular black holes"}],"publisher":"arXiv","container":{},"publicationYear":2026,"subjects":[{"subject":"General Relativity and Quantum Cosmology (gr-qc)","lang":"en","subjectScheme":"arXiv"},{"subject":"High Energy Astrophysical Phenomena (astro-ph.HE)","lang":"en","subjectScheme":"arXiv"},{"subject":"High Energy Physics - Theory (hep-th)","lang":"en","subjectScheme":"arXiv"},{"subject":"FOS: Physical sciences","subjectScheme":"Fields of Science and Technology (FOS)"},{"schemeUri":"http://www.oecd.org/science/inno/38235147.pdf","subject":"FOS: Physical sciences","subjectScheme":"Fields of Science and Technology (FOS)"}],"contributors":[],"dates":[{"date":"2026-02-24T10:19:01Z","dateType":"Submitted","dateInformation":"v1"},{"date":"2026-02-25T01:39:06Z","dateType":"Updated","dateInformation":"v1"},{"date":"2026-02","dateType":"Available","dateInformation":"v1"},{"date":"2026","dateType":"Issued"}],"language":null,"types":{"schemaOrg":"CreativeWork","resourceTypeGeneral":"Preprint","citeproc":"article","bibtex":"misc","ris":"GEN","resourceType":"Article"},"relatedIdentifiers":[],"relatedItems":[],"sizes":[],"formats":[],"version":"1","rightsList":[{"rightsIdentifierScheme":"SPDX","rightsUri":"https://creativecommons.org/licenses/by/4.0/legalcode","schemeUri":"https://spdx.org/licenses/","rights":"Creative Commons Attribution 4.0 International","rightsIdentifier":"cc-by-4.0"}],"descriptions":[{"descriptionType":"Abstract","description":"Gravitational wave radiation from periodic orbits in some standard regular black hole spacetimes is studied, primarily using known methods (numerical and analytic). We demonstrate specific differences with the singular Schwarzschild geometry by analysing orbit characteristics, gravitational wave strain profiles, and the corresponding power spectrum density, for different values of the regularising parameter `$g$'. Further, we assess our results vis-a-vis the LISA sensitivity curves and show how our results may be useful while developing templates for detecting regular black holes as viable alternatives to the singular ones. The appendices to our article contain details on errors in our estimates and provide for the first time, some exact analytical expressions on gravitational wave radiation from different types of periodic orbits in Schwarzschild spacetime."},{"descriptionType":"Other","description":"24 pages, 25 figures"}],"geoLocations":[],"fundingReferences":[],"url":"https://arxiv.org/abs/2602.20745","contentUrl":null,"metadataVersion":0,"schemaVersion":"http://datacite.org/schema/kernel-4","source":"mds","isActive":true,"state":"findable","reason":null,"viewCount":0,"downloadCount":0,"referenceCount":0,"citationCount":0,"partCount":0,"partOfCount":0,"versionCount":0,"versionOfCount":0,"created":"2026-02-25T02:57:32Z","registered":"2026-02-25T02:57:32Z","published":null,"updated":"2026-02-25T02:57:32Z"},"relationships":{"client":{"data":{"id":"arxiv.content","type":"clients"}}}},{"id":"10.48550/arxiv.2602.20744","type":"dois","attributes":{"doi":"10.48550/arxiv.2602.20744","identifiers":[{"identifier":"2602.20744","identifierType":"arXiv"}],"creators":[{"nameType":"Personal","givenName":"Darvan Shvan","familyName":"Khairaldeen","name":"Khairaldeen, Darvan Shvan","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Hossein","familyName":"Hassani","name":"Hassani, Hossein","affiliation":[],"nameIdentifiers":[]}],"titles":[{"title":"Voices of the Mountains: Deep Learning-Based Vocal Error Detection System for Kurdish Maqams"}],"publisher":"arXiv","container":{},"publicationYear":2026,"subjects":[{"subject":"Sound (cs.SD)","lang":"en","subjectScheme":"arXiv"},{"subject":"Artificial Intelligence (cs.AI)","lang":"en","subjectScheme":"arXiv"},{"subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"},{"schemeUri":"http://www.oecd.org/science/inno/38235147.pdf","subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"}],"contributors":[],"dates":[{"date":"2026-02-24T10:17:16Z","dateType":"Submitted","dateInformation":"v1"},{"date":"2026-02-25T01:39:00Z","dateType":"Updated","dateInformation":"v1"},{"date":"2026-02","dateType":"Available","dateInformation":"v1"},{"date":"2026","dateType":"Issued"}],"language":null,"types":{"schemaOrg":"CreativeWork","resourceTypeGeneral":"Preprint","citeproc":"article","bibtex":"misc","ris":"GEN","resourceType":"Article"},"relatedIdentifiers":[],"relatedItems":[],"sizes":[],"formats":[],"version":"1","rightsList":[{"rightsIdentifierScheme":"SPDX","rightsUri":"https://creativecommons.org/licenses/by-nc-nd/4.0/legalcode","schemeUri":"https://spdx.org/licenses/","rights":"Creative Commons Attribution Non Commercial No Derivatives 4.0 International","rightsIdentifier":"cc-by-nc-nd-4.0"}],"descriptions":[{"descriptionType":"Abstract","description":"Maqam, a singing type, is a significant component of Kurdish music. A maqam singer receives training in a traditional face-to-face or through self-training. Automatic Singing Assessment (ASA) uses machine learning (ML) to provide the accuracy of singing styles and can help learners to improve their performance through error detection. Currently, the available ASA tools follow Western music rules. The musical composition requires all notes to stay within their expected pitch range from start to finish. The system fails to detect micro-intervals and pitch bends, so it identifies Kurdish maqam singing as incorrect even though the singer performs according to traditional rules. Kurdish maqam requires recognizing performance errors within microtonal spaces, which is beyond Western equal temperament. This research is the first attempt to address the mentioned gap. While many error types happen during singing, our focus is on pitch, rhythm, and modal stability errors in the context of Bayati-Kurd. We collected 50 songs from 13 vocalists ( 2-3 hours) and annotated 221 error spans (150 fine pitch, 46 rhythm, 25 modal drift). The data was segmented into 15,199 overlapping windows and converted to log-mel spectrograms. We developed a two-headed CNN-BiLSTM with attention mode to decide whether a window contains an error and to classify it based on the chosen errors. Trained for 20 epochs with early stopping at epoch 10, the model reached a validation macro-F1 of 0.468. On the full 50-song evaluation at a 0.750 threshold, recall was 39.4% and precision 25.8% . Within detected windows, type macro-F1 was 0.387, with F1 of 0.492 (fine pitch), 0.536 (rhythm), and 0.133 (modal drift); modal drift recall was 8.0%. The better performance on common error types shows that the method works, while the poor modal-drift recall shows that more data and balancing are needed."}],"geoLocations":[],"fundingReferences":[],"url":"https://arxiv.org/abs/2602.20744","contentUrl":null,"metadataVersion":0,"schemaVersion":"http://datacite.org/schema/kernel-4","source":"mds","isActive":true,"state":"findable","reason":null,"viewCount":0,"downloadCount":0,"referenceCount":0,"citationCount":0,"partCount":0,"partOfCount":0,"versionCount":0,"versionOfCount":0,"created":"2026-02-25T02:57:30Z","registered":"2026-02-25T02:57:31Z","published":null,"updated":"2026-02-25T02:57:31Z"},"relationships":{"client":{"data":{"id":"arxiv.content","type":"clients"}}}},{"id":"10.48550/arxiv.2602.20739","type":"dois","attributes":{"doi":"10.48550/arxiv.2602.20739","identifiers":[{"identifier":"2602.20739","identifierType":"arXiv"}],"creators":[{"nameType":"Personal","givenName":"Shitian","familyName":"Zhao","name":"Zhao, Shitian","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Shaoheng","familyName":"Lin","name":"Lin, Shaoheng","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Ming","familyName":"Li","name":"Li, Ming","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Haoquan","familyName":"Zhang","name":"Zhang, Haoquan","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Wenshuo","familyName":"Peng","name":"Peng, Wenshuo","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Kaipeng","familyName":"Zhang","name":"Zhang, Kaipeng","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Chen","familyName":"Wei","name":"Wei, Chen","affiliation":[],"nameIdentifiers":[]}],"titles":[{"title":"PyVision-RL: Forging Open Agentic Vision Models via RL"}],"publisher":"arXiv","container":{},"publicationYear":2026,"subjects":[{"subject":"Artificial Intelligence (cs.AI)","lang":"en","subjectScheme":"arXiv"},{"subject":"Computer Vision and Pattern Recognition (cs.CV)","lang":"en","subjectScheme":"arXiv"},{"subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"},{"schemeUri":"http://www.oecd.org/science/inno/38235147.pdf","subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"}],"contributors":[],"dates":[{"date":"2026-02-24T10:08:33Z","dateType":"Submitted","dateInformation":"v1"},{"date":"2026-02-25T01:38:28Z","dateType":"Updated","dateInformation":"v1"},{"date":"2026-02","dateType":"Available","dateInformation":"v1"},{"date":"2026","dateType":"Issued"}],"language":null,"types":{"schemaOrg":"CreativeWork","resourceTypeGeneral":"Preprint","citeproc":"article","bibtex":"misc","ris":"GEN","resourceType":"Article"},"relatedIdentifiers":[],"relatedItems":[],"sizes":[],"formats":[],"version":"1","rightsList":[{"rightsUri":"http://arxiv.org/licenses/nonexclusive-distrib/1.0/","rights":"arXiv.org perpetual, non-exclusive license"}],"descriptions":[{"descriptionType":"Abstract","description":"Reinforcement learning for agentic multimodal models often suffers from interaction collapse, where models learn to reduce tool usage and multi-turn reasoning, limiting the benefits of agentic behavior. We introduce PyVision-RL, a reinforcement learning framework for open-weight multimodal models that stabilizes training and sustains interaction. Our approach combines an oversampling-filtering-ranking rollout strategy with an accumulative tool reward to prevent collapse and encourage multi-turn tool use. Using a unified training pipeline, we develop PyVision-Image and PyVision-Video for image and video understanding. For video reasoning, PyVision-Video employs on-demand context construction, selectively sampling task-relevant frames during reasoning to significantly reduce visual token usage. Experiments show strong performance and improved efficiency, demonstrating that sustained interaction and on-demand visual processing are critical for scalable multimodal agents."},{"descriptionType":"Other","description":"preprint"}],"geoLocations":[],"fundingReferences":[],"url":"https://arxiv.org/abs/2602.20739","contentUrl":null,"metadataVersion":0,"schemaVersion":"http://datacite.org/schema/kernel-4","source":"mds","isActive":true,"state":"findable","reason":null,"viewCount":0,"downloadCount":0,"referenceCount":0,"citationCount":0,"partCount":0,"partOfCount":0,"versionCount":0,"versionOfCount":0,"created":"2026-02-25T02:57:24Z","registered":"2026-02-25T02:57:24Z","published":null,"updated":"2026-02-25T02:57:24Z"},"relationships":{"client":{"data":{"id":"arxiv.content","type":"clients"}}}},{"id":"10.48550/arxiv.2602.20736","type":"dois","attributes":{"doi":"10.48550/arxiv.2602.20736","identifiers":[{"identifier":"2602.20736","identifierType":"arXiv"}],"creators":[{"nameType":"Personal","givenName":"Philip","familyName":"Dittmann","name":"Dittmann, Philip","affiliation":[],"nameIdentifiers":[]}],"titles":[{"title":"Existential theories of henselian valued fields under a formal smoothness assumption"}],"publisher":"arXiv","container":{},"publicationYear":2026,"subjects":[{"subject":"Logic (math.LO)","lang":"en","subjectScheme":"arXiv"},{"subject":"Number Theory (math.NT)","lang":"en","subjectScheme":"arXiv"},{"subject":"FOS: Mathematics","subjectScheme":"Fields of Science and Technology (FOS)"},{"schemeUri":"http://www.oecd.org/science/inno/38235147.pdf","subject":"FOS: Mathematics","subjectScheme":"Fields of Science and Technology (FOS)"},{"subject":"03C60, 12L05, 12L12, 12J20, 14G05","lang":"en","subjectScheme":"MSC"}],"contributors":[],"dates":[{"date":"2026-02-24T10:02:36Z","dateType":"Submitted","dateInformation":"v1"},{"date":"2026-02-25T01:38:03Z","dateType":"Updated","dateInformation":"v1"},{"date":"2026-02","dateType":"Available","dateInformation":"v1"},{"date":"2026","dateType":"Issued"}],"language":null,"types":{"schemaOrg":"CreativeWork","resourceTypeGeneral":"Preprint","citeproc":"article","bibtex":"misc","ris":"GEN","resourceType":"Article"},"relatedIdentifiers":[],"relatedItems":[],"sizes":[],"formats":[],"version":"1","rightsList":[{"rightsUri":"http://arxiv.org/licenses/nonexclusive-distrib/1.0/","rights":"arXiv.org perpetual, non-exclusive license"}],"descriptions":[{"descriptionType":"Abstract","description":"We study existential theories of henselian valued fields of positive characteristic with parameters from a trivially valued subfield. Compared to previous work, we relax perfectness and separability assumptions, and instead work with the weaker algebraic hypothesis of formal smoothness over the parameter field, which we discuss in detail in our setting. Assuming a weak consequence of resolution of singularities, which was already used in previous work, we obtain an axiomatisation of the existential theory of such a valued field in terms of the existential theory of the residue field, both over the same parameter field. This result has natural applications to asymptotic theories of completions of function fields of curves. We work these out in detail for the case of function fields over fairly general pseudo-algebraically closed fields, where we obtain decidability of the sets of universal/existential sentences holding in all completions or all but finitely many completions, respectively."}],"geoLocations":[],"fundingReferences":[],"url":"https://arxiv.org/abs/2602.20736","contentUrl":null,"metadataVersion":0,"schemaVersion":"http://datacite.org/schema/kernel-4","source":"mds","isActive":true,"state":"findable","reason":null,"viewCount":0,"downloadCount":0,"referenceCount":0,"citationCount":0,"partCount":0,"partOfCount":0,"versionCount":0,"versionOfCount":0,"created":"2026-02-25T02:57:19Z","registered":"2026-02-25T02:57:20Z","published":null,"updated":"2026-02-25T02:57:20Z"},"relationships":{"client":{"data":{"id":"arxiv.content","type":"clients"}}}},{"id":"10.48550/arxiv.2602.20735","type":"dois","attributes":{"doi":"10.48550/arxiv.2602.20735","identifiers":[{"identifier":"2602.20735","identifierType":"arXiv"}],"creators":[{"nameType":"Personal","givenName":"Kun","familyName":"Ran","name":"Ran, Kun","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Marwah","familyName":"Alaofi","name":"Alaofi, Marwah","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Danula","familyName":"Hettiachchi","name":"Hettiachchi, Danula","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Chenglong","familyName":"Ma","name":"Ma, Chenglong","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Khoi Nguyen Dinh","familyName":"Anh","name":"Anh, Khoi Nguyen Dinh","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Khoi Vo","familyName":"Nguyen","name":"Nguyen, Khoi Vo","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Sachin Pathiyan","familyName":"Cherumanal","name":"Cherumanal, Sachin Pathiyan","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Lida","familyName":"Rashidi","name":"Rashidi, Lida","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Falk","familyName":"Scholer","name":"Scholer, Falk","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Damiano","familyName":"Spina","name":"Spina, Damiano","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Shuoqi","familyName":"Sun","name":"Sun, Shuoqi","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Oleg","familyName":"Zendel","name":"Zendel, Oleg","affiliation":[],"nameIdentifiers":[]}],"titles":[{"title":"RMIT-ADM+S at the MMU-RAG NeurIPS 2025 Competition"}],"publisher":"arXiv","container":{},"publicationYear":2026,"subjects":[{"subject":"Information Retrieval (cs.IR)","lang":"en","subjectScheme":"arXiv"},{"subject":"Artificial Intelligence (cs.AI)","lang":"en","subjectScheme":"arXiv"},{"subject":"Computation and Language (cs.CL)","lang":"en","subjectScheme":"arXiv"},{"subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"},{"schemeUri":"http://www.oecd.org/science/inno/38235147.pdf","subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"}],"contributors":[],"dates":[{"date":"2026-02-24T09:58:25Z","dateType":"Submitted","dateInformation":"v1"},{"date":"2026-02-25T01:37:57Z","dateType":"Updated","dateInformation":"v1"},{"date":"2026-02","dateType":"Available","dateInformation":"v1"},{"date":"2026","dateType":"Issued"}],"language":null,"types":{"schemaOrg":"CreativeWork","resourceTypeGeneral":"Preprint","citeproc":"article","bibtex":"misc","ris":"GEN","resourceType":"Article"},"relatedIdentifiers":[],"relatedItems":[],"sizes":[],"formats":[],"version":"1","rightsList":[{"rightsIdentifierScheme":"SPDX","rightsUri":"https://creativecommons.org/licenses/by/4.0/legalcode","schemeUri":"https://spdx.org/licenses/","rights":"Creative Commons Attribution 4.0 International","rightsIdentifier":"cc-by-4.0"}],"descriptions":[{"descriptionType":"Abstract","description":"This paper presents the award-winning RMIT-ADM+S system for the Text-to-Text\n track of the NeurIPS~2025 MMU-RAG Competition. We introduce Routing-to-RAG\n (R2RAG), a research-focused retrieval-augmented generation (RAG)\n architecture composed of lightweight components that dynamically adapt the\n retrieval strategy based on inferred query complexity and evidence\n sufficiency. The system uses smaller LLMs, enabling operation on a single\n consumer-grade GPU while supporting complex research tasks. It builds on the\n G-RAG system, winner of the ACM~SIGIR~2025 LiveRAG Challenge, and extends it\n with modules informed by qualitative review of outputs. R2RAG won the Best\n Dynamic Evaluation award in the Open Source category, demonstrating high\n effectiveness with careful design and efficient use of resources."},{"descriptionType":"Other","description":"MMU-RAG NeurIPS 2025 winning system"}],"geoLocations":[],"fundingReferences":[],"url":"https://arxiv.org/abs/2602.20735","contentUrl":null,"metadataVersion":0,"schemaVersion":"http://datacite.org/schema/kernel-4","source":"mds","isActive":true,"state":"findable","reason":null,"viewCount":0,"downloadCount":0,"referenceCount":0,"citationCount":0,"partCount":0,"partOfCount":0,"versionCount":0,"versionOfCount":0,"created":"2026-02-25T02:57:18Z","registered":"2026-02-25T02:57:18Z","published":null,"updated":"2026-02-25T02:57:18Z"},"relationships":{"client":{"data":{"id":"arxiv.content","type":"clients"}}}},{"id":"10.48550/arxiv.2602.20734","type":"dois","attributes":{"doi":"10.48550/arxiv.2602.20734","identifiers":[{"identifier":"2602.20734","identifierType":"arXiv"}],"creators":[{"nameType":"Personal","givenName":"Shingo","familyName":"Akama","name":"Akama, Shingo","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Chunshan","familyName":"Lin","name":"Lin, Chunshan","affiliation":[],"nameIdentifiers":[]}],"titles":[{"title":"Bypassing the Lyth Bound with Entangled Gravitons: Primordial Signatures and Late-Time Noise"}],"publisher":"arXiv","container":{},"publicationYear":2026,"subjects":[{"subject":"Cosmology and Nongalactic Astrophysics (astro-ph.CO)","lang":"en","subjectScheme":"arXiv"},{"subject":"General Relativity and Quantum Cosmology (gr-qc)","lang":"en","subjectScheme":"arXiv"},{"subject":"FOS: Physical sciences","subjectScheme":"Fields of Science and Technology (FOS)"},{"schemeUri":"http://www.oecd.org/science/inno/38235147.pdf","subject":"FOS: Physical sciences","subjectScheme":"Fields of Science and Technology (FOS)"}],"contributors":[],"dates":[{"date":"2026-02-24T09:57:32Z","dateType":"Submitted","dateInformation":"v1"},{"date":"2026-02-25T01:37:54Z","dateType":"Updated","dateInformation":"v1"},{"date":"2026-02","dateType":"Available","dateInformation":"v1"},{"date":"2026","dateType":"Issued"}],"language":null,"types":{"schemaOrg":"CreativeWork","resourceTypeGeneral":"Preprint","citeproc":"article","bibtex":"misc","ris":"GEN","resourceType":"Article"},"relatedIdentifiers":[],"relatedItems":[],"sizes":[],"formats":[],"version":"1","rightsList":[{"rightsIdentifierScheme":"SPDX","rightsUri":"https://creativecommons.org/licenses/by/4.0/legalcode","schemeUri":"https://spdx.org/licenses/","rights":"Creative Commons Attribution 4.0 International","rightsIdentifier":"cc-by-4.0"}],"descriptions":[{"descriptionType":"Abstract","description":"We demonstrate that quantum entanglement between primordial gravitons in dynamically decoupled gravitational sectors can parametrically enhance the tensor power spectrum during inflation. Unlike standard mechanisms relying on classical dynamics or modified actions, this enhancement originates from the reduced density matrix of the observable sector after tracing over a hidden gravitational reservoir. This framework allows for a sizable tensor-to-scalar ratio r \u0026gt; 0.01 consistent with sub-Planckian inflaton excursions, providing a purely quantum mechanical evasion of the Lyth bound. The resulting mixed state leaves a distinctive \"quantum birthmark\" in the form of oscillatory features in the power spectrum and a characteristic violation of the single-field consistency relation, manifesting as a scale-dependent enhancement of the squeezed-limit bispectrum. Furthermore, we forecast that this entanglement may manifest as a late-time stochastic noise enhancement in gravitational wave interferometers, offering a novel experimental window into the quantum nature of spacetime."},{"descriptionType":"Other","description":"5 pages, 1 figure"}],"geoLocations":[],"fundingReferences":[],"url":"https://arxiv.org/abs/2602.20734","contentUrl":null,"metadataVersion":0,"schemaVersion":"http://datacite.org/schema/kernel-4","source":"mds","isActive":true,"state":"findable","reason":null,"viewCount":0,"downloadCount":0,"referenceCount":0,"citationCount":0,"partCount":0,"partOfCount":0,"versionCount":0,"versionOfCount":0,"created":"2026-02-25T02:57:16Z","registered":"2026-02-25T02:57:17Z","published":null,"updated":"2026-02-25T02:57:17Z"},"relationships":{"client":{"data":{"id":"arxiv.content","type":"clients"}}}},{"id":"10.48550/arxiv.2602.20732","type":"dois","attributes":{"doi":"10.48550/arxiv.2602.20732","identifiers":[{"identifier":"2602.20732","identifierType":"arXiv"}],"creators":[{"nameType":"Personal","givenName":"Chao","familyName":"Fei","name":"Fei, Chao","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Guozhong","familyName":"Li","name":"Li, Guozhong","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Chenxi","familyName":"Liu","name":"Liu, Chenxi","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Panos","familyName":"Kalnis","name":"Kalnis, Panos","affiliation":[],"nameIdentifiers":[]}],"titles":[{"title":"CHESS: Context-aware Hierarchical Efficient Semantic Selection for Long-Context LLM Inference"}],"publisher":"arXiv","container":{},"publicationYear":2026,"subjects":[{"subject":"Artificial Intelligence (cs.AI)","lang":"en","subjectScheme":"arXiv"},{"subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"},{"schemeUri":"http://www.oecd.org/science/inno/38235147.pdf","subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"}],"contributors":[],"dates":[{"date":"2026-02-24T09:54:59Z","dateType":"Submitted","dateInformation":"v1"},{"date":"2026-02-25T01:37:40Z","dateType":"Updated","dateInformation":"v1"},{"date":"2026-02","dateType":"Available","dateInformation":"v1"},{"date":"2026","dateType":"Issued"}],"language":null,"types":{"schemaOrg":"CreativeWork","resourceTypeGeneral":"Preprint","citeproc":"article","bibtex":"misc","ris":"GEN","resourceType":"Article"},"relatedIdentifiers":[],"relatedItems":[],"sizes":[],"formats":[],"version":"1","rightsList":[{"rightsIdentifierScheme":"SPDX","rightsUri":"https://creativecommons.org/licenses/by-nc-sa/4.0/legalcode","schemeUri":"https://spdx.org/licenses/","rights":"Creative Commons Attribution Non Commercial Share Alike 4.0 International","rightsIdentifier":"cc-by-nc-sa-4.0"}],"descriptions":[{"descriptionType":"Abstract","description":"Long-context LLMs demand accurate inference at low latency, yet decoding becomes primarily constrained by KV cache as context grows. Prior pruning methods are largely context-agnostic: their token selection ignores step-wise relevance and local semantics, which undermines quality. Moreover, their irregular accesses and selection overheads yield only limited wall-clock speedups. To address this, we propose \\textbf{CHESS}, an \\textit{algorithm-system co-design} KV-cache management system. Algorithmically, CHESS introduces a context-aware, hierarchical selection policy that dynamically reconstructs a coherent context for the current decoding. System-wise, coarse granularity selection eliminates expensive data movement, fully realizing practical acceleration from theoretical sparsity. Extensive evaluations demonstrate that CHESS surpasses Full-KV quality using only \\textbf{1\\%} of the KV cache, delivers low-latency stable inference with up to \\textbf{4.56$\\times$} higher throughput, and consistently outperforms other strong baselines. Code is available at \\href{https://anonymous.4open.science/r/CHESS-9958/}{https://anonymous.4open.science/r/CHESS/}."}],"geoLocations":[],"fundingReferences":[],"url":"https://arxiv.org/abs/2602.20732","contentUrl":null,"metadataVersion":0,"schemaVersion":"http://datacite.org/schema/kernel-4","source":"mds","isActive":true,"state":"findable","reason":null,"viewCount":0,"downloadCount":0,"referenceCount":0,"citationCount":0,"partCount":0,"partOfCount":0,"versionCount":0,"versionOfCount":0,"created":"2026-02-25T02:57:13Z","registered":"2026-02-25T02:57:14Z","published":null,"updated":"2026-02-25T02:57:14Z"},"relationships":{"client":{"data":{"id":"arxiv.content","type":"clients"}}}},{"id":"10.48550/arxiv.2602.20728","type":"dois","attributes":{"doi":"10.48550/arxiv.2602.20728","identifiers":[{"identifier":"2602.20728","identifierType":"arXiv"}],"creators":[{"nameType":"Personal","givenName":"Chenyang","familyName":"Zhao","name":"Zhao, Chenyang","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Vinny","familyName":"Cahill","name":"Cahill, Vinny","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Ivana","familyName":"Dusparic","name":"Dusparic, Ivana","affiliation":[],"nameIdentifiers":[]}],"titles":[{"title":"Balancing Multiple Objectives in Urban Traffic Control with Reinforcement Learning from AI Feedback"}],"publisher":"arXiv","container":{},"publicationYear":2026,"subjects":[{"subject":"Artificial Intelligence (cs.AI)","lang":"en","subjectScheme":"arXiv"},{"subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"},{"schemeUri":"http://www.oecd.org/science/inno/38235147.pdf","subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"}],"contributors":[],"dates":[{"date":"2026-02-24T09:47:25Z","dateType":"Submitted","dateInformation":"v1"},{"date":"2026-02-25T01:37:19Z","dateType":"Updated","dateInformation":"v1"},{"date":"2026-02","dateType":"Available","dateInformation":"v1"},{"date":"2026","dateType":"Issued"}],"language":null,"types":{"schemaOrg":"CreativeWork","resourceTypeGeneral":"Preprint","citeproc":"article","bibtex":"misc","ris":"GEN","resourceType":"Article"},"relatedIdentifiers":[],"relatedItems":[],"sizes":[],"formats":[],"version":"1","rightsList":[{"rightsIdentifierScheme":"SPDX","rightsUri":"https://creativecommons.org/licenses/by/4.0/legalcode","schemeUri":"https://spdx.org/licenses/","rights":"Creative Commons Attribution 4.0 International","rightsIdentifier":"cc-by-4.0"}],"descriptions":[{"descriptionType":"Abstract","description":"Reward design has been one of the central challenges for real world reinforcement learning (RL) deployment, especially in settings with multiple objectives. Preference-based RL offers an appealing alternative by learning from human preferences over pairs of behavioural outcomes. More recently, RL from AI feedback (RLAIF) has demonstrated that large language models (LLMs) can generate preference labels at scale, mitigating the reliance on human annotators. However, existing RLAIF work typically focuses only on single-objective tasks, leaving the open question of how RLAIF handles systems that involve multiple objectives. In such systems trade-offs among conflicting objectives are difficult to specify, and policies risk collapsing into optimizing for a dominant goal. In this paper, we explore the extension of the RLAIF paradigm to multi-objective self-adaptive systems. We show that multi-objective RLAIF can produce policies that yield balanced trade-offs reflecting different user priorities without laborious reward engineering. We argue that integrating RLAIF into multi-objective RL offers a scalable path toward user-aligned policy learning in domains with inherently conflicting objectives."}],"geoLocations":[],"fundingReferences":[],"url":"https://arxiv.org/abs/2602.20728","contentUrl":null,"metadataVersion":0,"schemaVersion":"http://datacite.org/schema/kernel-4","source":"mds","isActive":true,"state":"findable","reason":null,"viewCount":0,"downloadCount":0,"referenceCount":0,"citationCount":0,"partCount":0,"partOfCount":0,"versionCount":0,"versionOfCount":0,"created":"2026-02-25T02:57:08Z","registered":"2026-02-25T02:57:09Z","published":null,"updated":"2026-02-25T02:57:09Z"},"relationships":{"client":{"data":{"id":"arxiv.content","type":"clients"}}}},{"id":"10.48550/arxiv.2602.20727","type":"dois","attributes":{"doi":"10.48550/arxiv.2602.20727","identifiers":[{"identifier":"2602.20727","identifierType":"arXiv"}],"creators":[{"nameType":"Personal","givenName":"Xindian","familyName":"Ma","name":"Ma, Xindian","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Rundong","familyName":"Kong","name":"Kong, Rundong","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Peng","familyName":"Zhang","name":"Zhang, Peng","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Ruoxiang","familyName":"Huang","name":"Huang, Ruoxiang","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Yongyu","familyName":"Jiang","name":"Jiang, Yongyu","affiliation":[],"nameIdentifiers":[]}],"titles":[{"title":"ID-LoRA: Efficient Low-Rank Adaptation Inspired by Matrix Interpolative Decomposition"}],"publisher":"arXiv","container":{},"publicationYear":2026,"subjects":[{"subject":"Computation and Language (cs.CL)","lang":"en","subjectScheme":"arXiv"},{"subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"},{"schemeUri":"http://www.oecd.org/science/inno/38235147.pdf","subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"}],"contributors":[],"dates":[{"date":"2026-02-24T09:45:10Z","dateType":"Submitted","dateInformation":"v1"},{"date":"2026-02-25T01:37:10Z","dateType":"Updated","dateInformation":"v1"},{"date":"2026-02","dateType":"Available","dateInformation":"v1"},{"date":"2026","dateType":"Issued"}],"language":null,"types":{"schemaOrg":"CreativeWork","resourceTypeGeneral":"Preprint","citeproc":"article","bibtex":"misc","ris":"GEN","resourceType":"Article"},"relatedIdentifiers":[],"relatedItems":[],"sizes":[],"formats":[],"version":"1","rightsList":[{"rightsIdentifierScheme":"SPDX","rightsUri":"https://creativecommons.org/licenses/by/4.0/legalcode","schemeUri":"https://spdx.org/licenses/","rights":"Creative Commons Attribution 4.0 International","rightsIdentifier":"cc-by-4.0"}],"descriptions":[{"descriptionType":"Abstract","description":"LoRA has become a universal Parameter-Efficient Fine-Tuning (PEFT) technique that equips Large Language Models (LLMs) to adapt quickly to new tasks. However, when these models are scaled up, even the latest LoRA variants still introduce considerable overhead in trainable parameters. Conversely, aggressively lowering the rank to curb this overhead markedly degrades performance in complex multi-task settings. We propose ID-LoRA, a novel PEFT framework that breaks the trade-off. Its core innovation lies in extracting and reusing clustered parameter groups from the pretrained weight matrix. These groups are then used to form multiple low-rank components, all of which share only a single initialized trainable low-rank matrix. This approach cuts the number of trainable parameters while keeping the model's capacity intact. We evaluate ID-LoRA on five diverse benchmarks: Mathematical Reasoning, Code Generation, MMLU, CommonsenseQA, and Safety Alignment. ID-LoRA outperforms both full fine-tuning and existing PEFT baselines (e.g., LoRA, DoRA, HydraLoRA) while using up to 46% fewer trainable parameters than the standard LoRA. In multi-task scenarios, it surpasses LoRA and its recent variants (e.g., DoRA and HydraLoRA) on both Code and MMLU tasks, yet requires only 54% of the trainable parameters demanded by the conventional LoRA."}],"geoLocations":[],"fundingReferences":[],"url":"https://arxiv.org/abs/2602.20727","contentUrl":null,"metadataVersion":0,"schemaVersion":"http://datacite.org/schema/kernel-4","source":"mds","isActive":true,"state":"findable","reason":null,"viewCount":0,"downloadCount":0,"referenceCount":0,"citationCount":0,"partCount":0,"partOfCount":0,"versionCount":0,"versionOfCount":0,"created":"2026-02-25T02:57:07Z","registered":"2026-02-25T02:57:07Z","published":null,"updated":"2026-02-25T02:57:07Z"},"relationships":{"client":{"data":{"id":"arxiv.content","type":"clients"}}}},{"id":"10.48550/arxiv.2602.20724","type":"dois","attributes":{"doi":"10.48550/arxiv.2602.20724","identifiers":[{"identifier":"2602.20724","identifierType":"arXiv"}],"creators":[{"nameType":"Personal","givenName":"Siya","familyName":"Chen","name":"Chen, Siya","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Chee Wei","familyName":"Tan","name":"Tan, Chee Wei","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"H. Vincent","familyName":"Poor","name":"Poor, H. Vincent","affiliation":[],"nameIdentifiers":[]}],"titles":[{"title":"Deep Reinforcement Learning Based Block Coordinate Descent for Downlink Weighted Sum-rate Maximization on AI-Native Wireless Networks"}],"publisher":"arXiv","container":{},"publicationYear":2026,"subjects":[{"subject":"Networking and Internet Architecture (cs.NI)","lang":"en","subjectScheme":"arXiv"},{"subject":"Information Theory (cs.IT)","lang":"en","subjectScheme":"arXiv"},{"subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"},{"schemeUri":"http://www.oecd.org/science/inno/38235147.pdf","subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"}],"contributors":[],"dates":[{"date":"2026-02-24T09:39:00Z","dateType":"Submitted","dateInformation":"v1"},{"date":"2026-02-25T01:36:43Z","dateType":"Updated","dateInformation":"v1"},{"date":"2026-02","dateType":"Available","dateInformation":"v1"},{"date":"2026","dateType":"Issued"}],"language":null,"types":{"schemaOrg":"CreativeWork","resourceTypeGeneral":"Preprint","citeproc":"article","bibtex":"misc","ris":"GEN","resourceType":"Article"},"relatedIdentifiers":[],"relatedItems":[],"sizes":[],"formats":[],"version":"1","rightsList":[{"rightsUri":"http://arxiv.org/licenses/nonexclusive-distrib/1.0/","rights":"arXiv.org perpetual, non-exclusive license"}],"descriptions":[{"descriptionType":"Abstract","description":"This paper introduces a deep reinforcement learning-based block coordinate descent (DRL-based BCD) algorithm to address the nonconvex weighted sum-rate maximization (WSRM) problem with a total power constraint. Firstly, we present an efficient block coordinate descent (BCD) method to solve the problem. We then integrate deep reinforcement learning (DRL) techniques into the BCD method and propose the DRL-based BCD algorithm. This approach combines the data-driven learning capability of machine learning techniques with the navigational and decision-making characteristics of the optimization-theoretic-based BCD method. This combination significantly improves the algorithm's performance by reducing its sensitivity to initial points and mitigating the risk of entrapment in local optima. The primary advantages of the proposed DRL-based BCD algorithm lie in its ability to adhere to the constraints of the WSRM problem and significantly enhance accuracy, potentially achieving the exact optimal solution. Moreover, unlike many pure machine-learning approaches, the DRL-based BCD algorithm capitalizes on the underlying theoretical analysis of the WSRM problem's structure. This enables it to be easily trained and computationally efficient while maintaining a level of interpretability. Through numerical experiments, the DRL-based BCD algorithm demonstrates substantial advantages in effectiveness, efficiency, robustness, and interpretability for maximizing sum rates, which also provides valuable potential for designing resource-constrained AI-native wireless optimization strategies in next-generation wireless networks."},{"descriptionType":"Other","description":"This paper has been accepted by IEEE Transactions on Wireless Communications in 2025"}],"geoLocations":[],"fundingReferences":[],"url":"https://arxiv.org/abs/2602.20724","contentUrl":null,"metadataVersion":0,"schemaVersion":"http://datacite.org/schema/kernel-4","source":"mds","isActive":true,"state":"findable","reason":null,"viewCount":0,"downloadCount":0,"referenceCount":0,"citationCount":0,"partCount":0,"partOfCount":0,"versionCount":0,"versionOfCount":0,"created":"2026-02-25T02:57:02Z","registered":"2026-02-25T02:57:03Z","published":null,"updated":"2026-02-25T02:57:03Z"},"relationships":{"client":{"data":{"id":"arxiv.content","type":"clients"}}}},{"id":"10.48550/arxiv.2602.20721","type":"dois","attributes":{"doi":"10.48550/arxiv.2602.20721","identifiers":[{"identifier":"2602.20721","identifierType":"arXiv"}],"creators":[{"nameType":"Personal","givenName":"Xiaoman","familyName":"Feng","name":"Feng, Xiaoman","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Mingkun","familyName":"Lei","name":"Lei, Mingkun","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Yang","familyName":"Wang","name":"Wang, Yang","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Dingwen","familyName":"Fu","name":"Fu, Dingwen","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Chi","familyName":"Zhang","name":"Zhang, Chi","affiliation":[],"nameIdentifiers":[]}],"titles":[{"title":"CleanStyle: Plug-and-Play Style Conditioning Purification for Text-to-Image Stylization"}],"publisher":"arXiv","container":{},"publicationYear":2026,"subjects":[{"subject":"Computer Vision and Pattern Recognition (cs.CV)","lang":"en","subjectScheme":"arXiv"},{"subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"},{"schemeUri":"http://www.oecd.org/science/inno/38235147.pdf","subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"}],"contributors":[],"dates":[{"date":"2026-02-24T09:33:05Z","dateType":"Submitted","dateInformation":"v1"},{"date":"2026-02-25T01:36:24Z","dateType":"Updated","dateInformation":"v1"},{"date":"2026-02","dateType":"Available","dateInformation":"v1"},{"date":"2026","dateType":"Issued"}],"language":null,"types":{"schemaOrg":"CreativeWork","resourceTypeGeneral":"Preprint","citeproc":"article","bibtex":"misc","ris":"GEN","resourceType":"Article"},"relatedIdentifiers":[],"relatedItems":[],"sizes":[],"formats":[],"version":"1","rightsList":[{"rightsUri":"http://arxiv.org/licenses/nonexclusive-distrib/1.0/","rights":"arXiv.org perpetual, non-exclusive license"}],"descriptions":[{"descriptionType":"Abstract","description":"Style transfer in diffusion models enables controllable visual generation by injecting the style of a reference image. However, recent encoder-based methods, while efficient and tuning-free, often suffer from content leakage, where semantic elements from the style image undesirably appear in the output, impairing prompt fidelity and stylistic consistency. In this work, we introduce CleanStyle, a plug-and-play framework that filters out content-related noise from the style embedding without retraining. Motivated by empirical analysis, we observe that such leakage predominantly stems from the tail components of the style embedding, which are isolated via Singular Value Decomposition (SVD). To address this, we propose CleanStyleSVD (CS-SVD), which dynamically suppresses tail components using a time-aware exponential schedule, providing clean, style-preserving conditional embeddings throughout the denoising process. Furthermore, we present Style-Specific Classifier-Free Guidance (SS-CFG), which reuses the suppressed tail components to construct style-aware unconditional inputs. Unlike conventional methods that use generic negative embeddings (e.g., zero vectors), SS-CFG introduces targeted negative signals that reflect style-specific but prompt-irrelevant visual elements. This enables the model to effectively suppress these distracting patterns during generation, thereby improving prompt fidelity and enhancing the overall visual quality of stylized outputs. Our approach is lightweight, interpretable, and can be seamlessly integrated into existing encoder-based diffusion models without retraining. Extensive experiments demonstrate that CleanStyle substantially reduces content leakage, improves stylization quality and improves prompt alignment across a wide range of style references and prompts."},{"descriptionType":"Other","description":"26 pages"}],"geoLocations":[],"fundingReferences":[],"url":"https://arxiv.org/abs/2602.20721","contentUrl":null,"metadataVersion":0,"schemaVersion":"http://datacite.org/schema/kernel-4","source":"mds","isActive":true,"state":"findable","reason":null,"viewCount":0,"downloadCount":0,"referenceCount":0,"citationCount":0,"partCount":0,"partOfCount":0,"versionCount":0,"versionOfCount":0,"created":"2026-02-25T02:56:58Z","registered":"2026-02-25T02:56:58Z","published":null,"updated":"2026-02-25T02:56:58Z"},"relationships":{"client":{"data":{"id":"arxiv.content","type":"clients"}}}},{"id":"10.48550/arxiv.2602.20720","type":"dois","attributes":{"doi":"10.48550/arxiv.2602.20720","identifiers":[{"identifier":"2602.20720","identifierType":"arXiv"}],"creators":[{"nameType":"Personal","givenName":"Che","familyName":"Wang","name":"Wang, Che","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Jiaming","familyName":"Zhang","name":"Zhang, Jiaming","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Ziqi","familyName":"Zhang","name":"Zhang, Ziqi","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Zijie","familyName":"Wang","name":"Wang, Zijie","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Yinghui","familyName":"Wang","name":"Wang, Yinghui","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Jianbo","familyName":"Gao","name":"Gao, Jianbo","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Tao","familyName":"Wei","name":"Wei, Tao","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Zhong","familyName":"Chen","name":"Chen, Zhong","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Wei Yang Bryan","familyName":"Lim","name":"Lim, Wei Yang Bryan","affiliation":[],"nameIdentifiers":[]}],"titles":[{"title":"AdapTools: Adaptive Tool-based Indirect Prompt Injection Attacks on Agentic LLMs"}],"publisher":"arXiv","container":{},"publicationYear":2026,"subjects":[{"subject":"Cryptography and Security (cs.CR)","lang":"en","subjectScheme":"arXiv"},{"subject":"Artificial Intelligence (cs.AI)","lang":"en","subjectScheme":"arXiv"},{"subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"},{"schemeUri":"http://www.oecd.org/science/inno/38235147.pdf","subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"}],"contributors":[],"dates":[{"date":"2026-02-24T09:32:19Z","dateType":"Submitted","dateInformation":"v1"},{"date":"2026-02-25T01:36:10Z","dateType":"Updated","dateInformation":"v1"},{"date":"2026-02","dateType":"Available","dateInformation":"v1"},{"date":"2026","dateType":"Issued"}],"language":null,"types":{"schemaOrg":"CreativeWork","resourceTypeGeneral":"Preprint","citeproc":"article","bibtex":"misc","ris":"GEN","resourceType":"Article"},"relatedIdentifiers":[],"relatedItems":[],"sizes":[],"formats":[],"version":"1","rightsList":[{"rightsIdentifierScheme":"SPDX","rightsUri":"https://creativecommons.org/licenses/by-nc-nd/4.0/legalcode","schemeUri":"https://spdx.org/licenses/","rights":"Creative Commons Attribution Non Commercial No Derivatives 4.0 International","rightsIdentifier":"cc-by-nc-nd-4.0"}],"descriptions":[{"descriptionType":"Abstract","description":"The integration of external data services (e.g., Model Context Protocol, MCP) has made large language model-based agents increasingly powerful for complex task execution. However, this advancement introduces critical security vulnerabilities, particularly indirect prompt injection (IPI) attacks. Existing attack methods are limited by their reliance on static patterns and evaluation on simple language models, failing to address the fast-evolving nature of modern AI agents. We introduce AdapTools, a novel adaptive IPI attack framework that selects stealthier attack tools and generates adaptive attack prompts to create a rigorous security evaluation environment. Our approach comprises two key components: (1) Adaptive Attack Strategy Construction, which develops transferable adversarial strategies for prompt optimization, and (2) Attack Enhancement, which identifies stealthy tools capable of circumventing task-relevance defenses. Comprehensive experimental evaluation shows that AdapTools achieves a 2.13 times improvement in attack success rate while degrading system utility by a factor of 1.78. Notably, the framework maintains its effectiveness even against state-of-the-art defense mechanisms. Our method advances the understanding of IPI attacks and provides a useful reference for future research."},{"descriptionType":"Other","description":"11 pages"}],"geoLocations":[],"fundingReferences":[],"url":"https://arxiv.org/abs/2602.20720","contentUrl":null,"metadataVersion":0,"schemaVersion":"http://datacite.org/schema/kernel-4","source":"mds","isActive":true,"state":"findable","reason":null,"viewCount":0,"downloadCount":0,"referenceCount":0,"citationCount":0,"partCount":0,"partOfCount":0,"versionCount":0,"versionOfCount":0,"created":"2026-02-25T02:56:56Z","registered":"2026-02-25T02:56:57Z","published":null,"updated":"2026-02-25T02:56:57Z"},"relationships":{"client":{"data":{"id":"arxiv.content","type":"clients"}}}},{"id":"10.48550/arxiv.2602.20718","type":"dois","attributes":{"doi":"10.48550/arxiv.2602.20718","identifiers":[{"identifier":"2602.20718","identifierType":"arXiv"}],"creators":[{"nameType":"Personal","givenName":"Yangsen","familyName":"Chen","name":"Chen, Yangsen","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Hao","familyName":"Wang","name":"Wang, Hao","affiliation":[],"nameIdentifiers":[]}],"titles":[{"title":"Monocular Endoscopic Tissue 3D Reconstruction with Multi-Level Geometry Regularization"}],"publisher":"arXiv","container":{},"publicationYear":2026,"subjects":[{"subject":"Computer Vision and Pattern Recognition (cs.CV)","lang":"en","subjectScheme":"arXiv"},{"subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"},{"schemeUri":"http://www.oecd.org/science/inno/38235147.pdf","subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"}],"contributors":[],"dates":[{"date":"2026-02-24T09:29:36Z","dateType":"Submitted","dateInformation":"v1"},{"date":"2026-02-25T01:35:58Z","dateType":"Updated","dateInformation":"v1"},{"date":"2026-02","dateType":"Available","dateInformation":"v1"},{"date":"2026","dateType":"Issued"}],"language":null,"types":{"schemaOrg":"CreativeWork","resourceTypeGeneral":"Preprint","citeproc":"article","bibtex":"misc","ris":"GEN","resourceType":"Article"},"relatedIdentifiers":[],"relatedItems":[],"sizes":[],"formats":[],"version":"1","rightsList":[{"rightsIdentifierScheme":"SPDX","rightsUri":"https://creativecommons.org/licenses/by/4.0/legalcode","schemeUri":"https://spdx.org/licenses/","rights":"Creative Commons Attribution 4.0 International","rightsIdentifier":"cc-by-4.0"}],"descriptions":[{"descriptionType":"Abstract","description":"Reconstructing deformable endoscopic tissues is crucial for achieving robot-assisted surgery. However, 3D Gaussian Splatting-based approaches encounter challenges in achieving consistent tissue surface reconstruction, while existing NeRF-based methods lack real-time rendering capabilities. In pursuit of both smooth deformable surfaces and real-time rendering, we introduce a novel approach based on 3D Gaussian Splatting. Specifically, we introduce surface-aware reconstruction, initially employing a Sign Distance Field-based method to construct a mesh, subsequently utilizing this mesh to constrain the Gaussian Splatting reconstruction process. Furthermore, to ensure the generation of physically plausible deformations, we incorporate local rigidity and global non-rigidity restrictions to guide Gaussian deformation, tailored for the highly deformable nature of soft endoscopic tissue. Based on 3D Gaussian Splatting, our proposed method delivers a fast rendering process and smooth surface appearances. Quantitative and qualitative analysis against alternative methodologies shows that our approach achieves solid reconstruction quality in both textures and geometries."},{"descriptionType":"Other","description":"ijcnn 2025"}],"geoLocations":[],"fundingReferences":[],"url":"https://arxiv.org/abs/2602.20718","contentUrl":null,"metadataVersion":0,"schemaVersion":"http://datacite.org/schema/kernel-4","source":"mds","isActive":true,"state":"findable","reason":null,"viewCount":0,"downloadCount":0,"referenceCount":0,"citationCount":0,"partCount":0,"partOfCount":0,"versionCount":0,"versionOfCount":0,"created":"2026-02-25T02:56:53Z","registered":"2026-02-25T02:56:54Z","published":null,"updated":"2026-02-25T02:56:54Z"},"relationships":{"client":{"data":{"id":"arxiv.content","type":"clients"}}}},{"id":"10.48550/arxiv.2602.20717","type":"dois","attributes":{"doi":"10.48550/arxiv.2602.20717","identifiers":[{"identifier":"2602.20717","identifierType":"arXiv"}],"creators":[{"nameType":"Personal","givenName":"Xiting","familyName":"Liu","name":"Liu, Xiting","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Yuetong","familyName":"Liu","name":"Liu, Yuetong","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Yitong","familyName":"Zhang","name":"Zhang, Yitong","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Jia","familyName":"Li","name":"Li, Jia","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Shi-Min","familyName":"Hu","name":"Hu, Shi-Min","affiliation":[],"nameIdentifiers":[]}],"titles":[{"title":"PackMonitor: Enabling Zero Package Hallucinations Through Decoding-Time Monitoring"}],"publisher":"arXiv","container":{},"publicationYear":2026,"subjects":[{"subject":"Software Engineering (cs.SE)","lang":"en","subjectScheme":"arXiv"},{"subject":"Cryptography and Security (cs.CR)","lang":"en","subjectScheme":"arXiv"},{"subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"},{"schemeUri":"http://www.oecd.org/science/inno/38235147.pdf","subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"}],"contributors":[],"dates":[{"date":"2026-02-24T09:26:11Z","dateType":"Submitted","dateInformation":"v1"},{"date":"2026-02-25T01:35:48Z","dateType":"Updated","dateInformation":"v1"},{"date":"2026-02","dateType":"Available","dateInformation":"v1"},{"date":"2026","dateType":"Issued"}],"language":null,"types":{"schemaOrg":"CreativeWork","resourceTypeGeneral":"Preprint","citeproc":"article","bibtex":"misc","ris":"GEN","resourceType":"Article"},"relatedIdentifiers":[],"relatedItems":[],"sizes":[],"formats":[],"version":"1","rightsList":[{"rightsUri":"http://arxiv.org/licenses/nonexclusive-distrib/1.0/","rights":"arXiv.org perpetual, non-exclusive license"}],"descriptions":[{"descriptionType":"Abstract","description":"As Large Language Models (LLMs) are increasingly integrated into software development workflows, their trustworthiness has become a critical concern. However, in dependency recommendation scenarios, the reliability of LLMs is undermined by widespread package hallucinations, where models often recommend hallucinated packages. Recent studies have proposed a range of approaches to mitigate this issue. Nevertheless, existing approaches typically merely reduce hallucination rates rather than eliminate them, leaving persistent software security risks.\n In this work, we argue that package hallucinations are theoretically preventable based on the key insight that package validity is decidable through finite and enumerable authoritative package lists. Building on this, we propose PackMonitor, the first approach capable of fundamentally eliminating package hallucinations by continuously monitoring the model's decoding process and intervening when necessary. To implement this in practice, PackMonitor addresses three key challenges: (1) determining when to trigger intervention via a Context-Aware Parser that continuously monitors model outputs and selectively activates intervening only during installation command generation; (2) resolving how to intervene by employing a Package-Name Intervenor that strictly limits the decoding space to an authoritative package list; and (3) ensuring monitoring efficiency through a DFA-Caching Mechanism that enables scalability to millions of packages with negligible overhead. Extensive experiments on five widely used LLMs demonstrate that PackMonitor is a training-free, plug-and-play solution that consistently reduces package hallucination rates to zero while maintaining low-latency inference and preserving original model capabilities."}],"geoLocations":[],"fundingReferences":[],"url":"https://arxiv.org/abs/2602.20717","contentUrl":null,"metadataVersion":0,"schemaVersion":"http://datacite.org/schema/kernel-4","source":"mds","isActive":true,"state":"findable","reason":null,"viewCount":0,"downloadCount":0,"referenceCount":0,"citationCount":0,"partCount":0,"partOfCount":0,"versionCount":0,"versionOfCount":0,"created":"2026-02-25T02:56:52Z","registered":"2026-02-25T02:56:53Z","published":null,"updated":"2026-02-25T02:56:53Z"},"relationships":{"client":{"data":{"id":"arxiv.content","type":"clients"}}}},{"id":"10.48550/arxiv.2602.20715","type":"dois","attributes":{"doi":"10.48550/arxiv.2602.20715","identifiers":[{"identifier":"2602.20715","identifierType":"arXiv"}],"creators":[{"nameType":"Personal","givenName":"Zhian","familyName":"Su","name":"Su, Zhian","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Weijie","familyName":"Kong","name":"Kong, Weijie","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Haonan","familyName":"Dong","name":"Dong, Haonan","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Huixu","familyName":"Dong","name":"Dong, Huixu","affiliation":[],"nameIdentifiers":[]}],"titles":[{"title":"IG-RFT: An Interaction-Guided RL Framework for VLA Models in Long-Horizon Robotic Manipulation"}],"publisher":"arXiv","container":{},"publicationYear":2026,"subjects":[{"subject":"Robotics (cs.RO)","lang":"en","subjectScheme":"arXiv"},{"subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"},{"schemeUri":"http://www.oecd.org/science/inno/38235147.pdf","subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"}],"contributors":[],"dates":[{"date":"2026-02-24T09:19:50Z","dateType":"Submitted","dateInformation":"v1"},{"date":"2026-02-25T01:35:30Z","dateType":"Updated","dateInformation":"v1"},{"date":"2026-02","dateType":"Available","dateInformation":"v1"},{"date":"2026","dateType":"Issued"}],"language":null,"types":{"schemaOrg":"CreativeWork","resourceTypeGeneral":"Preprint","citeproc":"article","bibtex":"misc","ris":"GEN","resourceType":"Article"},"relatedIdentifiers":[],"relatedItems":[],"sizes":[],"formats":[],"version":"1","rightsList":[{"rightsUri":"http://arxiv.org/licenses/nonexclusive-distrib/1.0/","rights":"arXiv.org perpetual, non-exclusive license"}],"descriptions":[{"descriptionType":"Abstract","description":"Vision-Language-Action (VLA) models have demonstrated significant potential for generalist robotic policies; however, they struggle to generalize to long-horizon complex tasks in novel real-world domains due to distribution shifts and the scarcity of high-quality demonstrations. Although reinforcement learning (RL) offers a promising avenue for policy improvement, applying it to real-world VLA fine-tuning faces challenges regarding exploration efficiency, training stability, and sample cost. To address these issues, we propose IG-RFT, a novel Interaction-Guided Reinforced Fine-Tuning system designed for flow-based VLA models. Firstly, to facilitate effective policy optimization, we introduce Interaction-Guided Advantage Weighted Regression (IG-AWR), an RL algorithm that dynamically modulates exploration intensity based on the robot's interaction status. Furthermore, to address the limitations of sparse or task-specific rewards, we design a novel hybrid dense reward function that integrates the trajectory-level reward and the subtask-level reward. Finally, we construct a three-stage RL system comprising SFT, Offline RL, and Human-in-the-Loop RL for fine-tuning VLA models. Extensive real-world experiments on four challenging long-horizon tasks demonstrate that IG-RFT achieves an average success rate of 85.0%, significantly outperforming SFT (18.8%) and standard Offline RL baselines (40.0%). Ablation studies confirm the critical contributions of IG-AWR and hybrid reward shaping. In summary, our work establishes and validates a novel reinforced fine-tuning system for VLA models in real-world robotic manipulation."}],"geoLocations":[],"fundingReferences":[],"url":"https://arxiv.org/abs/2602.20715","contentUrl":null,"metadataVersion":0,"schemaVersion":"http://datacite.org/schema/kernel-4","source":"mds","isActive":true,"state":"findable","reason":null,"viewCount":0,"downloadCount":0,"referenceCount":0,"citationCount":0,"partCount":0,"partOfCount":0,"versionCount":0,"versionOfCount":0,"created":"2026-02-25T02:56:49Z","registered":"2026-02-25T02:56:50Z","published":null,"updated":"2026-02-25T02:56:50Z"},"relationships":{"client":{"data":{"id":"arxiv.content","type":"clients"}}}},{"id":"10.48550/arxiv.2602.20713","type":"dois","attributes":{"doi":"10.48550/arxiv.2602.20713","identifiers":[{"identifier":"2602.20713","identifierType":"arXiv"}],"creators":[{"nameType":"Personal","givenName":"Carolina E.","familyName":"Mattsson","name":"Mattsson, Carolina E.","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Claudio","familyName":"Cellerini","name":"Cellerini, Claudio","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Jaume","familyName":"Ojer","name":"Ojer, Jaume","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Michele","familyName":"Starnini","name":"Starnini, Michele","affiliation":[],"nameIdentifiers":[]}],"titles":[{"title":"Modeling financial transactions via random walks on temporal networks"}],"publisher":"arXiv","container":{},"publicationYear":2026,"subjects":[{"subject":"Physics and Society (physics.soc-ph)","lang":"en","subjectScheme":"arXiv"},{"subject":"FOS: Physical sciences","subjectScheme":"Fields of Science and Technology (FOS)"},{"schemeUri":"http://www.oecd.org/science/inno/38235147.pdf","subject":"FOS: Physical sciences","subjectScheme":"Fields of Science and Technology (FOS)"}],"contributors":[],"dates":[{"date":"2026-02-24T09:19:20Z","dateType":"Submitted","dateInformation":"v1"},{"date":"2026-02-25T01:35:28Z","dateType":"Updated","dateInformation":"v1"},{"date":"2026-02","dateType":"Available","dateInformation":"v1"},{"date":"2026","dateType":"Issued"}],"language":null,"types":{"schemaOrg":"CreativeWork","resourceTypeGeneral":"Preprint","citeproc":"article","bibtex":"misc","ris":"GEN","resourceType":"Article"},"relatedIdentifiers":[],"relatedItems":[],"sizes":[],"formats":[],"version":"1","rightsList":[{"rightsUri":"http://arxiv.org/licenses/nonexclusive-distrib/1.0/","rights":"arXiv.org perpetual, non-exclusive license"}],"descriptions":[{"descriptionType":"Abstract","description":"We model financial transactions as random walks on activity-driven temporal networks. By enforcing fund conservation, our framework analytically derives heavy-tailed distributions for the stationary balances and transaction sizes. Crucially, the latter is driven by variance in the spending propensity of individuals. Calibrated with empirical data from a closed, digital currency community, the model also reproduces observed correlations between inflows and outflows. Our findings provide a path for understanding emergent properties of the circulation of money."},{"descriptionType":"Other","description":"7 pages, see Supplementary Material as ancillary file"}],"geoLocations":[],"fundingReferences":[],"url":"https://arxiv.org/abs/2602.20713","contentUrl":null,"metadataVersion":0,"schemaVersion":"http://datacite.org/schema/kernel-4","source":"mds","isActive":true,"state":"findable","reason":null,"viewCount":0,"downloadCount":0,"referenceCount":0,"citationCount":0,"partCount":0,"partOfCount":0,"versionCount":0,"versionOfCount":0,"created":"2026-02-25T02:56:46Z","registered":"2026-02-25T02:56:47Z","published":null,"updated":"2026-02-25T02:56:47Z"},"relationships":{"client":{"data":{"id":"arxiv.content","type":"clients"}}}},{"id":"10.48550/arxiv.2602.20712","type":"dois","attributes":{"doi":"10.48550/arxiv.2602.20712","identifiers":[{"identifier":"2602.20712","identifierType":"arXiv"}],"creators":[{"nameType":"Personal","givenName":"Xuran","familyName":"Ma","name":"Ma, Xuran","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Xuebao","familyName":"Li","name":"Li, Xuebao","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Yanfang","familyName":"Zheng","name":"Zheng, Yanfang","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Yongshang","familyName":"Lv","name":"Lv, Yongshang","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Xiaojia","familyName":"Ji","name":"Ji, Xiaojia","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Jiancheng","familyName":"Xu","name":"Xu, Jiancheng","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Hongwei","familyName":"Ye","name":"Ye, Hongwei","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Zixian","familyName":"Wu","name":"Wu, Zixian","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Shuainan","familyName":"Yan","name":"Yan, Shuainan","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Liang","familyName":"Dong","name":"Dong, Liang","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Zamri Zainal","familyName":"Abidin","name":"Abidin, Zamri Zainal","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Xusheng","familyName":"Huang","name":"Huang, Xusheng","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Shunhuang","familyName":"Zhang","name":"Zhang, Shunhuang","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Honglei","familyName":"Jin","name":"Jin, Honglei","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Tarik Abdul","familyName":"Latef","name":"Latef, Tarik Abdul","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Noraisyah Mohamed","familyName":"Shah","name":"Shah, Noraisyah Mohamed","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Mohamadariff","familyName":"Othman","name":"Othman, Mohamadariff","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Kamarul Ariffin","familyName":"Noordin","name":"Noordin, Kamarul Ariffin","affiliation":[],"nameIdentifiers":[]}],"titles":[{"title":"F10.7 Index Prediction: A Multiscale Decomposition Strategy with Wavelet Transform for Performance Optimization"}],"publisher":"arXiv","container":{},"publicationYear":2026,"subjects":[{"subject":"Instrumentation and Methods for Astrophysics (astro-ph.IM)","lang":"en","subjectScheme":"arXiv"},{"subject":"Solar and Stellar Astrophysics (astro-ph.SR)","lang":"en","subjectScheme":"arXiv"},{"subject":"Machine Learning (cs.LG)","lang":"en","subjectScheme":"arXiv"},{"subject":"FOS: Physical sciences","subjectScheme":"Fields of Science and Technology (FOS)"},{"schemeUri":"http://www.oecd.org/science/inno/38235147.pdf","subject":"FOS: Physical sciences","subjectScheme":"Fields of Science and Technology (FOS)"},{"subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"},{"schemeUri":"http://www.oecd.org/science/inno/38235147.pdf","subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"}],"contributors":[],"dates":[{"date":"2026-02-24T09:18:57Z","dateType":"Submitted","dateInformation":"v1"},{"date":"2026-02-25T01:35:26Z","dateType":"Updated","dateInformation":"v1"},{"date":"2026-02","dateType":"Available","dateInformation":"v1"},{"date":"2026","dateType":"Issued"}],"language":null,"types":{"schemaOrg":"CreativeWork","resourceTypeGeneral":"Preprint","citeproc":"article","bibtex":"misc","ris":"GEN","resourceType":"Article"},"relatedIdentifiers":[],"relatedItems":[],"sizes":[],"formats":[],"version":"1","rightsList":[{"rightsUri":"http://arxiv.org/licenses/nonexclusive-distrib/1.0/","rights":"arXiv.org perpetual, non-exclusive license"}],"descriptions":[{"descriptionType":"Abstract","description":"In this study, we construct Dataset A for training, validation, and testing, and Dataset B to evaluate generalization. We propose a novel F10.7 index forecasting method using wavelet decomposition, which feeds F10.7 together with its decomposed approximate and detail signals into the iTransformer model. We also incorporate the International Sunspot Number (ISN) and its wavelet-decomposed signals to assess their influence on prediction performance. Our optimal method is then compared with the latest method from S. Yan et al. (2025) and three operational models (SWPC, BGS, CLS). Additionally, we transfer our method to the PatchTST model used in H. Ye et al. (2024) and compare our method with theirs on Dataset B. Key findings include: (1) The wavelet-based combination methods overall outperform the baseline using only F10.7 index. The prediction performance improves as higher-level approximate and detail signals are incrementally added. The Combination 6 method integrating F10.7 with its first to fifth level approximate and detail signals outperforms methods using only approximate or detail signals. (2) Incorporating ISN and its wavelet-decomposed signals does not enhance prediction performance. (3) The Combination 6 method significantly surpasses S. Yan et al. (2025) and three operational models, with RMSE, MAE, and MAPE reduced by 18.22%, 15.09%, and 8.57%, respectively, against the former method. It also excels across four different conditions of solar activity. (4) Our method demonstrates superior generalization and prediction capability over the method of H. Ye et al. (2024) across all forecast horizons. To our knowledge, this is the first application of wavelet decomposition in F10.7 prediction, substantially improving forecast performance."}],"geoLocations":[],"fundingReferences":[],"url":"https://arxiv.org/abs/2602.20712","contentUrl":null,"metadataVersion":0,"schemaVersion":"http://datacite.org/schema/kernel-4","source":"mds","isActive":true,"state":"findable","reason":null,"viewCount":0,"downloadCount":0,"referenceCount":0,"citationCount":0,"partCount":0,"partOfCount":0,"versionCount":0,"versionOfCount":0,"created":"2026-02-25T02:56:45Z","registered":"2026-02-25T02:56:46Z","published":null,"updated":"2026-02-25T02:56:46Z"},"relationships":{"client":{"data":{"id":"arxiv.content","type":"clients"}}}},{"id":"10.48550/arxiv.2602.20709","type":"dois","attributes":{"doi":"10.48550/arxiv.2602.20709","identifiers":[{"identifier":"2602.20709","identifierType":"arXiv"}],"creators":[{"nameType":"Personal","givenName":"Riccardo","familyName":"Gallon","name":"Gallon, Riccardo","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Fabian","familyName":"Schiemenz","name":"Schiemenz, Fabian","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Alessandra","familyName":"Menicucci","name":"Menicucci, Alessandra","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Eberhard","familyName":"Gill","name":"Gill, Eberhard","affiliation":[],"nameIdentifiers":[]}],"titles":[{"title":"Onboard-Targeted Segmentation of Straylight in Space Camera Sensors"}],"publisher":"arXiv","container":{},"publicationYear":2026,"subjects":[{"subject":"Computer Vision and Pattern Recognition (cs.CV)","lang":"en","subjectScheme":"arXiv"},{"subject":"Artificial Intelligence (cs.AI)","lang":"en","subjectScheme":"arXiv"},{"subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"},{"schemeUri":"http://www.oecd.org/science/inno/38235147.pdf","subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"}],"contributors":[],"dates":[{"date":"2026-02-24T09:15:13Z","dateType":"Submitted","dateInformation":"v1"},{"date":"2026-02-25T01:34:59Z","dateType":"Updated","dateInformation":"v1"},{"date":"2026-02","dateType":"Available","dateInformation":"v1"},{"date":"2026","dateType":"Issued"}],"language":null,"types":{"schemaOrg":"CreativeWork","resourceTypeGeneral":"Preprint","citeproc":"article","bibtex":"misc","ris":"GEN","resourceType":"Article"},"relatedIdentifiers":[],"relatedItems":[],"sizes":[],"formats":[],"version":"1","rightsList":[{"rightsIdentifierScheme":"SPDX","rightsUri":"https://creativecommons.org/licenses/by/4.0/legalcode","schemeUri":"https://spdx.org/licenses/","rights":"Creative Commons Attribution 4.0 International","rightsIdentifier":"cc-by-4.0"}],"descriptions":[{"descriptionType":"Abstract","description":"This study details an artificial intelligence (AI)-based methodology for the semantic segmentation of space camera faults. Specifically, we address the segmentation of straylight effects induced by solar presence around the camera's Field of View (FoV). Anomalous images are sourced from our published dataset. Our approach emphasizes generalization across diverse flare textures, leveraging pre-training on a public dataset (Flare7k++) including flares in various non-space contexts to mitigate the scarcity of realistic space-specific data. A DeepLabV3 model with MobileNetV3 backbone performs the segmentation task. The model design targets deployment in spacecraft resource-constrained hardware. Finally, based on a proposed interface between our model and the onboard navigation pipeline, we develop custom metrics to assess the model's performance in the system-level context."},{"descriptionType":"Other","description":"Submitted to Aerospace Science and Technology"}],"geoLocations":[],"fundingReferences":[],"url":"https://arxiv.org/abs/2602.20709","contentUrl":null,"metadataVersion":0,"schemaVersion":"http://datacite.org/schema/kernel-4","source":"mds","isActive":true,"state":"findable","reason":null,"viewCount":0,"downloadCount":0,"referenceCount":0,"citationCount":0,"partCount":0,"partOfCount":0,"versionCount":0,"versionOfCount":0,"created":"2026-02-25T02:56:40Z","registered":"2026-02-25T02:56:41Z","published":null,"updated":"2026-02-25T02:56:41Z"},"relationships":{"client":{"data":{"id":"arxiv.content","type":"clients"}}}},{"id":"10.48550/arxiv.2602.20708","type":"dois","attributes":{"doi":"10.48550/arxiv.2602.20708","identifiers":[{"identifier":"2602.20708","identifierType":"arXiv"}],"creators":[{"nameType":"Personal","givenName":"Che","familyName":"Wang","name":"Wang, Che","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Fuyao","familyName":"Zhang","name":"Zhang, Fuyao","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Jiaming","familyName":"Zhang","name":"Zhang, Jiaming","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Ziqi","familyName":"Zhang","name":"Zhang, Ziqi","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Yinghui","familyName":"Wang","name":"Wang, Yinghui","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Longtao","familyName":"Huang","name":"Huang, Longtao","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Jianbo","familyName":"Gao","name":"Gao, Jianbo","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Zhong","familyName":"Chen","name":"Chen, Zhong","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Wei Yang Bryan","familyName":"Lim","name":"Lim, Wei Yang Bryan","affiliation":[],"nameIdentifiers":[]}],"titles":[{"title":"ICON: Indirect Prompt Injection Defense for Agents based on Inference-Time Correction"}],"publisher":"arXiv","container":{},"publicationYear":2026,"subjects":[{"subject":"Artificial Intelligence (cs.AI)","lang":"en","subjectScheme":"arXiv"},{"subject":"Cryptography and Security (cs.CR)","lang":"en","subjectScheme":"arXiv"},{"subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"},{"schemeUri":"http://www.oecd.org/science/inno/38235147.pdf","subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"}],"contributors":[],"dates":[{"date":"2026-02-24T09:13:05Z","dateType":"Submitted","dateInformation":"v1"},{"date":"2026-02-25T01:34:56Z","dateType":"Updated","dateInformation":"v1"},{"date":"2026-02","dateType":"Available","dateInformation":"v1"},{"date":"2026","dateType":"Issued"}],"language":null,"types":{"schemaOrg":"CreativeWork","resourceTypeGeneral":"Preprint","citeproc":"article","bibtex":"misc","ris":"GEN","resourceType":"Article"},"relatedIdentifiers":[],"relatedItems":[],"sizes":[],"formats":[],"version":"1","rightsList":[{"rightsIdentifierScheme":"SPDX","rightsUri":"https://creativecommons.org/licenses/by-nc-nd/4.0/legalcode","schemeUri":"https://spdx.org/licenses/","rights":"Creative Commons Attribution Non Commercial No Derivatives 4.0 International","rightsIdentifier":"cc-by-nc-nd-4.0"}],"descriptions":[{"descriptionType":"Abstract","description":"Large Language Model (LLM) agents are susceptible to Indirect Prompt Injection (IPI) attacks, where malicious instructions in retrieved content hijack the agent's execution. Existing defenses typically rely on strict filtering or refusal mechanisms, which suffer from a critical limitation: over-refusal, prematurely terminating valid agentic workflows. We propose ICON, a probing-to-mitigation framework that neutralizes attacks while preserving task continuity. Our key insight is that IPI attacks leave distinct over-focusing signatures in the latent space. We introduce a Latent Space Trace Prober to detect attacks based on high intensity scores. Subsequently, a Mitigating Rectifier performs surgical attention steering that selectively manipulate adversarial query key dependencies while amplifying task relevant elements to restore the LLM's functional trajectory. Extensive evaluations on multiple backbones show that ICON achieves a competitive 0.4% ASR, matching commercial grade detectors, while yielding a over 50% task utility gain. Furthermore, ICON demonstrates robust Out of Distribution(OOD) generalization and extends effectively to multi-modal agents, establishing a superior balance between security and efficiency."},{"descriptionType":"Other","description":"11 pages,"}],"geoLocations":[],"fundingReferences":[],"url":"https://arxiv.org/abs/2602.20708","contentUrl":null,"metadataVersion":0,"schemaVersion":"http://datacite.org/schema/kernel-4","source":"mds","isActive":true,"state":"findable","reason":null,"viewCount":0,"downloadCount":0,"referenceCount":0,"citationCount":0,"partCount":0,"partOfCount":0,"versionCount":0,"versionOfCount":0,"created":"2026-02-25T02:56:39Z","registered":"2026-02-25T02:56:40Z","published":null,"updated":"2026-02-25T02:56:40Z"},"relationships":{"client":{"data":{"id":"arxiv.content","type":"clients"}}}},{"id":"10.48550/arxiv.2602.20707","type":"dois","attributes":{"doi":"10.48550/arxiv.2602.20707","identifiers":[{"identifier":"2602.20707","identifierType":"arXiv"}],"creators":[{"nameType":"Personal","givenName":"Yong","familyName":"Luo","name":"Luo, Yong","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Linlin","familyName":"Sun","name":"Sun, Linlin","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Guofang","familyName":"Wang","name":"Wang, Guofang","affiliation":[],"nameIdentifiers":[]}],"titles":[{"title":"A flow approach to the Toda system"}],"publisher":"arXiv","container":{},"publicationYear":2026,"subjects":[{"subject":"Differential Geometry (math.DG)","lang":"en","subjectScheme":"arXiv"},{"subject":"Analysis of PDEs (math.AP)","lang":"en","subjectScheme":"arXiv"},{"subject":"FOS: Mathematics","subjectScheme":"Fields of Science and Technology (FOS)"},{"schemeUri":"http://www.oecd.org/science/inno/38235147.pdf","subject":"FOS: Mathematics","subjectScheme":"Fields of Science and Technology (FOS)"}],"contributors":[],"dates":[{"date":"2026-02-24T09:12:33Z","dateType":"Submitted","dateInformation":"v1"},{"date":"2026-02-25T01:34:51Z","dateType":"Updated","dateInformation":"v1"},{"date":"2026-02","dateType":"Available","dateInformation":"v1"},{"date":"2026","dateType":"Issued"}],"language":null,"types":{"schemaOrg":"CreativeWork","resourceTypeGeneral":"Preprint","citeproc":"article","bibtex":"misc","ris":"GEN","resourceType":"Article"},"relatedIdentifiers":[],"relatedItems":[],"sizes":[],"formats":[],"version":"1","rightsList":[{"rightsUri":"http://arxiv.org/licenses/nonexclusive-distrib/1.0/","rights":"arXiv.org perpetual, non-exclusive license"}],"descriptions":[{"descriptionType":"Abstract","description":"In this paper we introduce a flow to study the Toda system, which we call {\\it Toda flow.} More generally, we introduce a flow of the Liouville systems, formulated as a coupled parabolic system with nonlocal interactions. Finite-time singularities are characterized and both necessary and sufficient conditions for convergence are provided in this general setting, even when the prescribed functions are allowed to change sign.\n As an application, we prove a global existence for the Toda flow in the critical case without restricting the sign of the prescribed functions. We provide a detailed description of blow-up behavior at infinity and obtain a sharp lower bound for the functional in cases where global convergence fails. By constructing appropriate test functions, we further establish a sufficient condition for the global convergence of the flow. These results are not affected by the sign-changing nature of the prescribed functions, and extend the theorem of Jost, Lin and Wang (Comm. Pure Appl. Math. 59, 526-558, 2006) to systems of multiple equations under this more general and physically relevant condition."}],"geoLocations":[],"fundingReferences":[],"url":"https://arxiv.org/abs/2602.20707","contentUrl":null,"metadataVersion":0,"schemaVersion":"http://datacite.org/schema/kernel-4","source":"mds","isActive":true,"state":"findable","reason":null,"viewCount":0,"downloadCount":0,"referenceCount":0,"citationCount":0,"partCount":0,"partOfCount":0,"versionCount":0,"versionOfCount":0,"created":"2026-02-25T02:56:38Z","registered":"2026-02-25T02:56:38Z","published":null,"updated":"2026-02-25T02:56:38Z"},"relationships":{"client":{"data":{"id":"arxiv.content","type":"clients"}}}},{"id":"10.48550/arxiv.2602.20705","type":"dois","attributes":{"doi":"10.48550/arxiv.2602.20705","identifiers":[{"identifier":"2602.20705","identifierType":"arXiv"}],"creators":[{"nameType":"Personal","givenName":"Emilio","familyName":"Cruciani","name":"Cruciani, Emilio","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Aditi","familyName":"Dudeja","name":"Dudeja, Aditi","affiliation":[],"nameIdentifiers":[]}],"titles":[{"title":"The Careless Coupon Collector's Problem"}],"publisher":"arXiv","container":{},"publicationYear":2026,"subjects":[{"subject":"Discrete Mathematics (cs.DM)","lang":"en","subjectScheme":"arXiv"},{"subject":"Probability (math.PR)","lang":"en","subjectScheme":"arXiv"},{"subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"},{"schemeUri":"http://www.oecd.org/science/inno/38235147.pdf","subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"},{"subject":"FOS: Mathematics","subjectScheme":"Fields of Science and Technology (FOS)"},{"schemeUri":"http://www.oecd.org/science/inno/38235147.pdf","subject":"FOS: Mathematics","subjectScheme":"Fields of Science and Technology (FOS)"}],"contributors":[],"dates":[{"date":"2026-02-24T09:11:05Z","dateType":"Submitted","dateInformation":"v1"},{"date":"2026-02-25T01:34:45Z","dateType":"Updated","dateInformation":"v1"},{"date":"2026-02","dateType":"Available","dateInformation":"v1"},{"date":"2026","dateType":"Issued"}],"language":null,"types":{"schemaOrg":"CreativeWork","resourceTypeGeneral":"Preprint","citeproc":"article","bibtex":"misc","ris":"GEN","resourceType":"Article"},"relatedIdentifiers":[],"relatedItems":[],"sizes":[],"formats":[],"version":"1","rightsList":[{"rightsIdentifierScheme":"SPDX","rightsUri":"https://creativecommons.org/licenses/by/4.0/legalcode","schemeUri":"https://spdx.org/licenses/","rights":"Creative Commons Attribution 4.0 International","rightsIdentifier":"cc-by-4.0"}],"descriptions":[{"descriptionType":"Abstract","description":"We initiate the study of the Careless Coupon Collector's Problem (CCCP), a novel variation of the classical coupon collector, that we envision as a model for information systems such as web crawlers, dynamic caches, and fault-resilient networks. In CCCP, a collector attempts to gather $n$ distinct coupon types by obtaining one coupon type uniformly at random in each discrete round, however the collector is \\textit{careless}: at the end of each round, each collected coupon type is independently lost with probability $p$. We analyze the number of rounds required to complete the collection as a function of $n$ and $p$. In particular, we show that it transitions from $Θ(n \\ln n)$ when $p = o\\big(\\frac{\\ln n}{n^2}\\big)$ up to $Θ\\big((\\frac{np}{1-p})^n\\big)$ when $p=ω\\big(\\frac{1}{n}\\big)$ in multiple distinct phases. Interestingly, when $p=\\frac{c}{n}$, the process remains in a metastable phase, where the fraction of collected coupon types is concentrated around $\\frac{1}{1+c}$ with probability $1-o(1)$, for a time window of length $e^{Θ(n)}$. Finally, we give an algorithm that computes the expected completion time of CCCP in $O(n^2)$ time."},{"descriptionType":"Other","description":"Published at FUN 2026"}],"geoLocations":[],"fundingReferences":[],"url":"https://arxiv.org/abs/2602.20705","contentUrl":null,"metadataVersion":0,"schemaVersion":"http://datacite.org/schema/kernel-4","source":"mds","isActive":true,"state":"findable","reason":null,"viewCount":0,"downloadCount":0,"referenceCount":0,"citationCount":0,"partCount":0,"partOfCount":0,"versionCount":0,"versionOfCount":0,"created":"2026-02-25T02:56:35Z","registered":"2026-02-25T02:56:35Z","published":null,"updated":"2026-02-25T02:56:35Z"},"relationships":{"client":{"data":{"id":"arxiv.content","type":"clients"}}}},{"id":"10.48550/arxiv.2602.20704","type":"dois","attributes":{"doi":"10.48550/arxiv.2602.20704","identifiers":[{"identifier":"2602.20704","identifierType":"arXiv"}],"creators":[{"nameType":"Personal","givenName":"Zesheng","familyName":"Wang","name":"Wang, Zesheng","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Longfei","familyName":"Xu","name":"Xu, Longfei","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Weidong","familyName":"Deng","name":"Deng, Weidong","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Huimin","familyName":"Yan","name":"Yan, Huimin","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Kaikui","familyName":"Liu","name":"Liu, Kaikui","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Xiangxiang","familyName":"Chu","name":"Chu, Xiangxiang","affiliation":[],"nameIdentifiers":[]}],"titles":[{"title":"IntRR: A Framework for Integrating SID Redistribution and Length Reduction"}],"publisher":"arXiv","container":{},"publicationYear":2026,"subjects":[{"subject":"Information Retrieval (cs.IR)","lang":"en","subjectScheme":"arXiv"},{"subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"},{"schemeUri":"http://www.oecd.org/science/inno/38235147.pdf","subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"}],"contributors":[],"dates":[{"date":"2026-02-24T09:09:40Z","dateType":"Submitted","dateInformation":"v1"},{"date":"2026-02-25T01:34:40Z","dateType":"Updated","dateInformation":"v1"},{"date":"2026-02","dateType":"Available","dateInformation":"v1"},{"date":"2026","dateType":"Issued"}],"language":null,"types":{"schemaOrg":"CreativeWork","resourceTypeGeneral":"Preprint","citeproc":"article","bibtex":"misc","ris":"GEN","resourceType":"Article"},"relatedIdentifiers":[],"relatedItems":[],"sizes":[],"formats":[],"version":"1","rightsList":[{"rightsUri":"http://arxiv.org/licenses/nonexclusive-distrib/1.0/","rights":"arXiv.org perpetual, non-exclusive license"}],"descriptions":[{"descriptionType":"Abstract","description":"Generative Recommendation (GR) has emerged as a transformative paradigm that reformulates the traditional cascade ranking system into a sequence-to-item generation task, facilitated by the use of discrete Semantic IDs (SIDs). However, current SIDs are suboptimal as the indexing objectives (Stage 1) are misaligned with the actual recommendation goals (Stage 2). Since these identifiers remain static (Stage 2), the backbone model lacks the flexibility to adapt them to the evolving complexities of user interactions. Furthermore, the prevailing strategy of flattening hierarchical SIDs into token sequences leads to sequence length inflation, resulting in prohibitive computational overhead and inference latency. To address these challenges, we propose IntRR, a novel framework that integrates objective-aligned SID Redistribution and structural Length Reduction. By leveraging item-specific Unique IDs (UIDs) as collaborative anchors, this approach dynamically redistributes semantic weights across hierarchical codebook layers. Concurrently, IntRR handles the SID hierarchy recursively, eliminating the need to flatten sequences. This ensures a fixed cost of one token per item. Extensive experiments on benchmark datasets demonstrate that IntRR yields substantial improvements over representative generative baselines, achieving superior performance in both recommendation accuracy and efficiency."}],"geoLocations":[],"fundingReferences":[],"url":"https://arxiv.org/abs/2602.20704","contentUrl":null,"metadataVersion":0,"schemaVersion":"http://datacite.org/schema/kernel-4","source":"mds","isActive":true,"state":"findable","reason":null,"viewCount":0,"downloadCount":0,"referenceCount":0,"citationCount":0,"partCount":0,"partOfCount":0,"versionCount":0,"versionOfCount":0,"created":"2026-02-25T02:56:33Z","registered":"2026-02-25T02:56:34Z","published":null,"updated":"2026-02-25T02:56:34Z"},"relationships":{"client":{"data":{"id":"arxiv.content","type":"clients"}}}},{"id":"10.48550/arxiv.2602.20702","type":"dois","attributes":{"doi":"10.48550/arxiv.2602.20702","identifiers":[{"identifier":"2602.20702","identifierType":"arXiv"}],"creators":[{"nameType":"Personal","givenName":"Alan","familyName":"Hastings","name":"Hastings, Alan","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Sergei","familyName":"Petrovskii","name":"Petrovskii, Sergei","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Valerio","familyName":"Lucarini","name":"Lucarini, Valerio","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Andrew","familyName":"Morozov","name":"Morozov, Andrew","affiliation":[],"nameIdentifiers":[]}],"titles":[{"title":"Tipping points in complex ecological systems"}],"publisher":"arXiv","container":{},"publicationYear":2026,"subjects":[{"subject":"Populations and Evolution (q-bio.PE)","lang":"en","subjectScheme":"arXiv"},{"subject":"Statistical Mechanics (cond-mat.stat-mech)","lang":"en","subjectScheme":"arXiv"},{"subject":"Chaotic Dynamics (nlin.CD)","lang":"en","subjectScheme":"arXiv"},{"subject":"Biological Physics (physics.bio-ph)","lang":"en","subjectScheme":"arXiv"},{"subject":"FOS: Biological sciences","subjectScheme":"Fields of Science and Technology (FOS)"},{"schemeUri":"http://www.oecd.org/science/inno/38235147.pdf","subject":"FOS: Biological sciences","subjectScheme":"Fields of Science and Technology (FOS)"},{"subject":"FOS: Physical sciences","subjectScheme":"Fields of Science and Technology (FOS)"},{"schemeUri":"http://www.oecd.org/science/inno/38235147.pdf","subject":"FOS: Physical sciences","subjectScheme":"Fields of Science and Technology (FOS)"}],"contributors":[],"dates":[{"date":"2026-02-24T09:07:16Z","dateType":"Submitted","dateInformation":"v1"},{"date":"2026-02-25T01:34:31Z","dateType":"Updated","dateInformation":"v1"},{"date":"2026-02","dateType":"Available","dateInformation":"v1"},{"date":"2026","dateType":"Issued"}],"language":null,"types":{"schemaOrg":"CreativeWork","resourceTypeGeneral":"Preprint","citeproc":"article","bibtex":"misc","ris":"GEN","resourceType":"Article"},"relatedIdentifiers":[],"relatedItems":[],"sizes":[],"formats":[],"version":"1","rightsList":[{"rightsUri":"http://arxiv.org/licenses/nonexclusive-distrib/1.0/","rights":"arXiv.org perpetual, non-exclusive license"}],"descriptions":[{"descriptionType":"Abstract","description":"Tipping points are one of the hot topics in modern physics of complex systems. But what is a tipping point? A generic definition declares it as ``a state of the system where a small change in its parameters can lead to a significant change in its properties''. Additional ingredients that often enter the definition of tipping process are the abruptness of the resulting change and its irreversibility, i.e. it is impossible to recover the initial state if one reverses the protocol of change of the parameters. However, there exists a number of different mathematical structures that can show this behavior, the one that was originally suggested as a tipping point (nowadays usually referred to as bifurcation induced tipping) is just one of many. Different preconditions and/or different level of details included into the model, reflecting also different environmental forcing, can lead to a variety of tipping mechanisms. Furthermore, in a spatially extended system and/or a system with multiple scales, different parts can react to a change in environmental conditions differently or at a different time, interacting with each other to create a tipping cascade. In this paper, using ecosystems as a paradigm of complex nonlinear open systems, we provide a critical overview of the progress made in tipping point science over the last 15 years. We highlight the main findings, identify gaps in our knowledge, and outline a roadmap for further progress."}],"geoLocations":[],"fundingReferences":[],"url":"https://arxiv.org/abs/2602.20702","contentUrl":null,"metadataVersion":0,"schemaVersion":"http://datacite.org/schema/kernel-4","source":"mds","isActive":true,"state":"findable","reason":null,"viewCount":0,"downloadCount":0,"referenceCount":0,"citationCount":0,"partCount":0,"partOfCount":0,"versionCount":0,"versionOfCount":0,"created":"2026-02-25T02:56:30Z","registered":"2026-02-25T02:56:31Z","published":null,"updated":"2026-02-25T02:56:31Z"},"relationships":{"client":{"data":{"id":"arxiv.content","type":"clients"}}}},{"id":"10.48550/arxiv.2602.20699","type":"dois","attributes":{"doi":"10.48550/arxiv.2602.20699","identifiers":[{"identifier":"2602.20699","identifierType":"arXiv"}],"creators":[{"nameType":"Personal","givenName":"Razvan Gabriel","familyName":"Iagar","name":"Iagar, Razvan Gabriel","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Ariel","familyName":"Sánchez","name":"Sánchez, Ariel","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Erik","familyName":"Sarrion-Pedralva","name":"Sarrion-Pedralva, Erik","affiliation":[],"nameIdentifiers":[]}],"titles":[{"title":"Global self-similar solutions for Hardy-Hénon equations with linear and quasilinear diffusion"}],"publisher":"arXiv","container":{},"publicationYear":2026,"subjects":[{"subject":"Analysis of PDEs (math.AP)","lang":"en","subjectScheme":"arXiv"},{"subject":"Dynamical Systems (math.DS)","lang":"en","subjectScheme":"arXiv"},{"subject":"FOS: Mathematics","subjectScheme":"Fields of Science and Technology (FOS)"},{"schemeUri":"http://www.oecd.org/science/inno/38235147.pdf","subject":"FOS: Mathematics","subjectScheme":"Fields of Science and Technology (FOS)"}],"contributors":[],"dates":[{"date":"2026-02-24T09:00:02Z","dateType":"Submitted","dateInformation":"v1"},{"date":"2026-02-25T01:34:02Z","dateType":"Updated","dateInformation":"v1"},{"date":"2026-02","dateType":"Available","dateInformation":"v1"},{"date":"2026","dateType":"Issued"}],"language":null,"types":{"schemaOrg":"CreativeWork","resourceTypeGeneral":"Preprint","citeproc":"article","bibtex":"misc","ris":"GEN","resourceType":"Article"},"relatedIdentifiers":[],"relatedItems":[],"sizes":[],"formats":[],"version":"1","rightsList":[{"rightsUri":"http://arxiv.org/licenses/nonexclusive-distrib/1.0/","rights":"arXiv.org perpetual, non-exclusive license"}],"descriptions":[{"descriptionType":"Abstract","description":"Global self-similar solutions to the parabolic Hardy-Hénon equation $$ u_t=Δu^m+|x|^σu^p, \\quad (x,t)\\in\\mathbb{R}^N\\times(0,\\infty), $$ are classified in the range of exponents $m\\geq1$, $p\u0026gt;m$ and $σ\u0026gt;\\max\\{-2,-N\\}$. The classification varies strongly with respect to the celebrated \\emph{Fujita} and \\emph{Sobolev critical exponents} $$ p_F(σ)=m+\\frac{σ+2}{N}, \\quad p_S(σ)=\n \\begin{cases}\n \\frac{m(N+2σ+2)}{N-2}, \u0026amp; \\mbox{if } N\\geq3, \\\\[1mm]\n \\infty, \u0026amp; \\mbox{if } N\\in\\{1,2\\}.\n \\end{cases} $$ Indeed, if $p\\in(p_F(σ),p_S(σ))$, both equations admit self-similar solutions with either compact support (if $m\u0026gt;1$) or Gaussian-like tail as $|x|\\to\\infty$ (if $m=1$), as well as a one-parameter family satisfying $$ u(x,t)\\sim C|x|^{-(σ+2)/(p-m)}, \\quad {\\rm as} \\ |x|\\to\\infty. $$ If $p\\geq p_S(σ)$, there are only self-similar solutions with the latter algebraic tail, while for $m"}],"geoLocations":[],"fundingReferences":[],"url":"https://arxiv.org/abs/2602.20699","contentUrl":null,"metadataVersion":0,"schemaVersion":"http://datacite.org/schema/kernel-4","source":"mds","isActive":true,"state":"findable","reason":null,"viewCount":0,"downloadCount":0,"referenceCount":0,"citationCount":0,"partCount":0,"partOfCount":0,"versionCount":0,"versionOfCount":0,"created":"2026-02-25T02:56:26Z","registered":"2026-02-25T02:56:27Z","published":null,"updated":"2026-02-25T02:56:27Z"},"relationships":{"client":{"data":{"id":"arxiv.content","type":"clients"}}}},{"id":"10.48550/arxiv.2602.20698","type":"dois","attributes":{"doi":"10.48550/arxiv.2602.20698","identifiers":[{"identifier":"2602.20698","identifierType":"arXiv"}],"creators":[{"nameType":"Personal","givenName":"Maryam","familyName":"Aliakbarpour","name":"Aliakbarpour, Maryam","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Vladimir","familyName":"Braverman","name":"Braverman, Vladimir","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Yuhan","familyName":"Liu","name":"Liu, Yuhan","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Junze","familyName":"Yin","name":"Yin, Junze","affiliation":[],"nameIdentifiers":[]}],"titles":[{"title":"High-Dimensional Robust Mean Estimation with Untrusted Batches"}],"publisher":"arXiv","container":{},"publicationYear":2026,"subjects":[{"subject":"Machine Learning (cs.LG)","lang":"en","subjectScheme":"arXiv"},{"subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"},{"schemeUri":"http://www.oecd.org/science/inno/38235147.pdf","subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"}],"contributors":[],"dates":[{"date":"2026-02-24T08:59:37Z","dateType":"Submitted","dateInformation":"v1"},{"date":"2026-02-25T01:34:01Z","dateType":"Updated","dateInformation":"v1"},{"date":"2026-02","dateType":"Available","dateInformation":"v1"},{"date":"2026","dateType":"Issued"}],"language":null,"types":{"schemaOrg":"CreativeWork","resourceTypeGeneral":"Preprint","citeproc":"article","bibtex":"misc","ris":"GEN","resourceType":"Article"},"relatedIdentifiers":[],"relatedItems":[],"sizes":[],"formats":[],"version":"1","rightsList":[{"rightsIdentifierScheme":"SPDX","rightsUri":"https://creativecommons.org/licenses/by-nc-sa/4.0/legalcode","schemeUri":"https://spdx.org/licenses/","rights":"Creative Commons Attribution Non Commercial Share Alike 4.0 International","rightsIdentifier":"cc-by-nc-sa-4.0"}],"descriptions":[{"descriptionType":"Abstract","description":"We study high-dimensional mean estimation in a collaborative setting where data is contributed by $N$ users in batches of size $n$. In this environment, a learner seeks to recover the mean $μ$ of a true distribution $P$ from a collection of sources that are both statistically heterogeneous and potentially malicious. We formalize this challenge through a double corruption landscape: an $\\varepsilon$-fraction of users are entirely adversarial, while the remaining ``good'' users provide data from distributions that are related to $P$, but deviate by a proximity parameter $α$.\n Unlike existing work on the untrusted batch model, which typically measures this deviation via total variation distance in discrete settings, we address the continuous, high-dimensional regime under two natural variants for deviation: (1) good batches are drawn from distributions with a mean-shift of $\\sqrtα$, or (2) an $α$-fraction of samples within each good batch are adversarially corrupted. In particular, the second model presents significant new challenges: in high dimensions, unlike discrete settings, even a small fraction of sample-level corruption can shift empirical means and covariances arbitrarily.\n We provide two Sum-of-Squares (SoS) based algorithms to navigate this tiered corruption. Our algorithms achieve the minimax-optimal error rate $O(\\sqrt{\\varepsilon/n} + \\sqrt{d/nN} + \\sqrtα)$, demonstrating that while heterogeneity $α$ represents an inherent statistical difficulty, the influence of adversarial users is suppressed by a factor of $1/\\sqrt{n}$ due to the internal averaging afforded by the batch structure."}],"geoLocations":[],"fundingReferences":[],"url":"https://arxiv.org/abs/2602.20698","contentUrl":null,"metadataVersion":0,"schemaVersion":"http://datacite.org/schema/kernel-4","source":"mds","isActive":true,"state":"findable","reason":null,"viewCount":0,"downloadCount":0,"referenceCount":0,"citationCount":0,"partCount":0,"partOfCount":0,"versionCount":0,"versionOfCount":0,"created":"2026-02-25T02:56:24Z","registered":"2026-02-25T02:56:25Z","published":null,"updated":"2026-02-25T02:56:25Z"},"relationships":{"client":{"data":{"id":"arxiv.content","type":"clients"}}}},{"id":"10.48550/arxiv.2602.20696","type":"dois","attributes":{"doi":"10.48550/arxiv.2602.20696","identifiers":[{"identifier":"2602.20696","identifierType":"arXiv"}],"creators":[{"nameType":"Personal","givenName":"Baolong","familyName":"Bi","name":"Bi, Baolong","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Yuyao","familyName":"Ge","name":"Ge, Yuyao","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Shenghua","familyName":"Liu","name":"Liu, Shenghua","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Yuchen","familyName":"He","name":"He, Yuchen","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Siqian","familyName":"Tong","name":"Tong, Siqian","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Lizhe","familyName":"Chen","name":"Chen, Lizhe","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Lingrui","familyName":"Mei","name":"Mei, Lingrui","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Zehao","familyName":"Li","name":"Li, Zehao","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Yiwei","familyName":"Wang","name":"Wang, Yiwei","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Yujun","familyName":"Cai","name":"Cai, Yujun","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Ming-Hsuan","familyName":"Yang","name":"Yang, Ming-Hsuan","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Xueqi","familyName":"Cheng","name":"Cheng, Xueqi","affiliation":[],"nameIdentifiers":[]}],"titles":[{"title":"PromptCD: Test-Time Behavior Enhancement via Polarity-Prompt Contrastive Decoding"}],"publisher":"arXiv","container":{},"publicationYear":2026,"subjects":[{"subject":"Artificial Intelligence (cs.AI)","lang":"en","subjectScheme":"arXiv"},{"subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"},{"schemeUri":"http://www.oecd.org/science/inno/38235147.pdf","subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"}],"contributors":[],"dates":[{"date":"2026-02-24T08:56:52Z","dateType":"Submitted","dateInformation":"v1"},{"date":"2026-02-25T01:33:56Z","dateType":"Updated","dateInformation":"v1"},{"date":"2026-02","dateType":"Available","dateInformation":"v1"},{"date":"2026","dateType":"Issued"}],"language":null,"types":{"schemaOrg":"CreativeWork","resourceTypeGeneral":"Preprint","citeproc":"article","bibtex":"misc","ris":"GEN","resourceType":"Article"},"relatedIdentifiers":[],"relatedItems":[],"sizes":[],"formats":[],"version":"1","rightsList":[{"rightsUri":"http://arxiv.org/licenses/nonexclusive-distrib/1.0/","rights":"arXiv.org perpetual, non-exclusive license"}],"descriptions":[{"descriptionType":"Abstract","description":"Reliable AI systems require large language models (LLMs) to exhibit behaviors aligned with human preferences and values. However, most existing alignment approaches operate at training time and rely on additional high-quality data, incurring significant computational and annotation costs. While recent work has shown that contrastive decoding can leverage a model's internal distributions to improve specific capabilities, its applicability remains limited to narrow behavioral scopes and scenarios. In this work, we introduce Polarity-Prompt Contrastive Decoding (PromptCD), a test-time behavior control method that generalizes contrastive decoding to broader enhancement settings. PromptCD constructs paired positive and negative guiding prompts for a target behavior and contrasts model responses-specifically token-level probability distributions in LLMs and visual attention patterns in VLMs-to reinforce desirable outcomes. This formulation extends contrastive decoding to a wide range of enhancement objectives and is applicable to both LLMs and Vision-Language Models (VLMs) without additional training. For LLMs, experiments on the \"3H\" alignment objectives (helpfulness, honesty, and harmlessness) demonstrate consistent and substantial improvements, indicating that post-trained models can achieve meaningful self-enhancement purely at test time. For VLMs, we further analyze contrastive effects on visual attention, showing that PromptCD significantly improves VQA performance by reinforcing behavior-consistent visual grounding. Collectively, these results highlight PromptCD as a simple, general, and cost-efficient strategy for reliable behavior control across modalities."}],"geoLocations":[],"fundingReferences":[],"url":"https://arxiv.org/abs/2602.20696","contentUrl":null,"metadataVersion":0,"schemaVersion":"http://datacite.org/schema/kernel-4","source":"mds","isActive":true,"state":"findable","reason":null,"viewCount":0,"downloadCount":0,"referenceCount":0,"citationCount":0,"partCount":0,"partOfCount":0,"versionCount":0,"versionOfCount":0,"created":"2026-02-25T02:56:22Z","registered":"2026-02-25T02:56:22Z","published":null,"updated":"2026-02-25T02:56:22Z"},"relationships":{"client":{"data":{"id":"arxiv.content","type":"clients"}}}},{"id":"10.48550/arxiv.2602.20694","type":"dois","attributes":{"doi":"10.48550/arxiv.2602.20694","identifiers":[{"identifier":"2602.20694","identifierType":"arXiv"}],"creators":[{"nameType":"Personal","givenName":"Samuel O.","familyName":"Scalet","name":"Scalet, Samuel O.","affiliation":[],"nameIdentifiers":[]}],"titles":[{"title":"Spatial Entanglement Sudden Death in Spin Chains at All Temperatures"}],"publisher":"arXiv","container":{},"publicationYear":2026,"subjects":[{"subject":"Quantum Physics (quant-ph)","lang":"en","subjectScheme":"arXiv"},{"subject":"Statistical Mechanics (cond-mat.stat-mech)","lang":"en","subjectScheme":"arXiv"},{"subject":"Mathematical Physics (math-ph)","lang":"en","subjectScheme":"arXiv"},{"subject":"FOS: Physical sciences","subjectScheme":"Fields of Science and Technology (FOS)"},{"schemeUri":"http://www.oecd.org/science/inno/38235147.pdf","subject":"FOS: Physical sciences","subjectScheme":"Fields of Science and Technology (FOS)"}],"contributors":[],"dates":[{"date":"2026-02-24T08:54:38Z","dateType":"Submitted","dateInformation":"v1"},{"date":"2026-02-25T01:33:47Z","dateType":"Updated","dateInformation":"v1"},{"date":"2026-02","dateType":"Available","dateInformation":"v1"},{"date":"2026","dateType":"Issued"}],"language":null,"types":{"schemaOrg":"CreativeWork","resourceTypeGeneral":"Preprint","citeproc":"article","bibtex":"misc","ris":"GEN","resourceType":"Article"},"relatedIdentifiers":[],"relatedItems":[],"sizes":[],"formats":[],"version":"1","rightsList":[{"rightsIdentifierScheme":"SPDX","rightsUri":"https://creativecommons.org/licenses/by/4.0/legalcode","schemeUri":"https://spdx.org/licenses/","rights":"Creative Commons Attribution 4.0 International","rightsIdentifier":"cc-by-4.0"}],"descriptions":[{"descriptionType":"Abstract","description":"We prove a finite entanglement length for the Gibbs state of any local Hamiltonian on a spin chain at any finite temperature: After removing an interval of size at least equal to the entanglement length, the remaining left and right half-chains are in a separable state."},{"descriptionType":"Other","description":"19 pages, 2 figures"}],"geoLocations":[],"fundingReferences":[],"url":"https://arxiv.org/abs/2602.20694","contentUrl":null,"metadataVersion":0,"schemaVersion":"http://datacite.org/schema/kernel-4","source":"mds","isActive":true,"state":"findable","reason":null,"viewCount":0,"downloadCount":0,"referenceCount":0,"citationCount":0,"partCount":0,"partOfCount":0,"versionCount":0,"versionOfCount":0,"created":"2026-02-25T02:56:19Z","registered":"2026-02-25T02:56:20Z","published":null,"updated":"2026-02-25T02:56:20Z"},"relationships":{"client":{"data":{"id":"arxiv.content","type":"clients"}}}},{"id":"10.48550/arxiv.2602.20692","type":"dois","attributes":{"doi":"10.48550/arxiv.2602.20692","identifiers":[{"identifier":"2602.20692","identifierType":"arXiv"}],"creators":[{"nameType":"Personal","givenName":"Martin","familyName":"Robin","name":"Robin, Martin","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Thomas","familyName":"Dehoux","name":"Dehoux, Thomas","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Maroun Abi","familyName":"Ghanem","name":"Ghanem, Maroun Abi","affiliation":[],"nameIdentifiers":[]}],"titles":[{"title":"Resonant attenuation of surface acoustic waves by a weakly bonded layer"}],"publisher":"arXiv","container":{},"publicationYear":2026,"subjects":[{"subject":"Applied Physics (physics.app-ph)","lang":"en","subjectScheme":"arXiv"},{"subject":"FOS: Physical sciences","subjectScheme":"Fields of Science and Technology (FOS)"},{"schemeUri":"http://www.oecd.org/science/inno/38235147.pdf","subject":"FOS: Physical sciences","subjectScheme":"Fields of Science and Technology (FOS)"}],"contributors":[],"dates":[{"date":"2026-02-24T08:52:42Z","dateType":"Submitted","dateInformation":"v1"},{"date":"2026-02-25T01:33:29Z","dateType":"Updated","dateInformation":"v1"},{"date":"2026-02","dateType":"Available","dateInformation":"v1"},{"date":"2026","dateType":"Issued"}],"language":null,"types":{"schemaOrg":"CreativeWork","resourceTypeGeneral":"Preprint","citeproc":"article","bibtex":"misc","ris":"GEN","resourceType":"Article"},"relatedIdentifiers":[],"relatedItems":[],"sizes":[],"formats":[],"version":"1","rightsList":[{"rightsUri":"http://arxiv.org/licenses/nonexclusive-distrib/1.0/","rights":"arXiv.org perpetual, non-exclusive license"}],"descriptions":[{"descriptionType":"Abstract","description":"We investigate the propagation of surface acoustic waves (SAWs) in a layered half-space system comprising a continuous, sub-wavelength-thick layer weakly adhering to a substrate. Using finite element simulations, we demonstrate that this configuration - without requiring surface structuration - gives rise to frequency ranges bounded in k-space and characterized by strong SAW attenuation, which we term adhesion-induced resonant attenuation zones. We show that these attenuation zones closely mimic the resonant behavior typically observed in locally resonant metamaterials and can be understood through a mass-spring analogy, where the adhesion between the layer and substrate governs the frequency and width of the attenuation zones. As a practical demonstration, we propose a bilayer configuration as a practical route to experimentally realize adhesion-induced resonant attenuation of SAWs, where a soft and thin interfacial film serves as an intermediate adhesive bonding between the layer and substrate, providing a realistic and tunable interfacial stiffness. Our findings offer a simplified route to achieving SAW manipulation through continuous layered media with tunable adhesion, providing a practical alternative to complex structural designs in SAW-based devices across a broad frequency range."}],"geoLocations":[],"fundingReferences":[],"url":"https://arxiv.org/abs/2602.20692","contentUrl":null,"metadataVersion":0,"schemaVersion":"http://datacite.org/schema/kernel-4","source":"mds","isActive":true,"state":"findable","reason":null,"viewCount":0,"downloadCount":0,"referenceCount":0,"citationCount":0,"partCount":0,"partOfCount":0,"versionCount":0,"versionOfCount":0,"created":"2026-02-25T02:56:16Z","registered":"2026-02-25T02:56:17Z","published":null,"updated":"2026-02-25T02:56:17Z"},"relationships":{"client":{"data":{"id":"arxiv.content","type":"clients"}}}},{"id":"10.48550/arxiv.2602.20689","type":"dois","attributes":{"doi":"10.48550/arxiv.2602.20689","identifiers":[{"identifier":"2602.20689","identifierType":"arXiv"}],"creators":[{"nameType":"Personal","givenName":"Bedrettin","familyName":"Cetinkaya","name":"Cetinkaya, Bedrettin","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Sinan","familyName":"Kalkan","name":"Kalkan, Sinan","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Emre","familyName":"Akbas","name":"Akbas, Emre","affiliation":[],"nameIdentifiers":[]}],"titles":[{"title":"MatchED: Crisp Edge Detection Using End-to-End, Matching-based Supervision"}],"publisher":"arXiv","container":{},"publicationYear":2026,"subjects":[{"subject":"Computer Vision and Pattern Recognition (cs.CV)","lang":"en","subjectScheme":"arXiv"},{"subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"},{"schemeUri":"http://www.oecd.org/science/inno/38235147.pdf","subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"}],"contributors":[],"dates":[{"date":"2026-02-24T08:45:49Z","dateType":"Submitted","dateInformation":"v1"},{"date":"2026-02-25T01:32:55Z","dateType":"Updated","dateInformation":"v1"},{"date":"2026-02","dateType":"Available","dateInformation":"v1"},{"date":"2026","dateType":"Issued"}],"language":null,"types":{"schemaOrg":"CreativeWork","resourceTypeGeneral":"Preprint","citeproc":"article","bibtex":"misc","ris":"GEN","resourceType":"Article"},"relatedIdentifiers":[],"relatedItems":[],"sizes":[],"formats":[],"version":"1","rightsList":[{"rightsIdentifierScheme":"SPDX","rightsUri":"https://creativecommons.org/licenses/by/4.0/legalcode","schemeUri":"https://spdx.org/licenses/","rights":"Creative Commons Attribution 4.0 International","rightsIdentifier":"cc-by-4.0"}],"descriptions":[{"descriptionType":"Abstract","description":"Generating crisp, i.e., one-pixel-wide, edge maps remains one of the fundamental challenges in edge detection, affecting both traditional and learning-based methods. To obtain crisp edges, most existing approaches rely on two hand-crafted post-processing algorithms, Non-Maximum Suppression (NMS) and skeleton-based thinning, which are non-differentiable and hinder end-to-end optimization. Moreover, all existing crisp edge detection methods still depend on such post-processing to achieve satisfactory results. To address this limitation, we propose \\MethodLPP, a lightweight, only $\\sim$21K additional parameters, and plug-and-play matching-based supervision module that can be appended to any edge detection model for joint end-to-end learning of crisp edges. At each training iteration, \\MethodLPP performs one-to-one matching between predicted and ground-truth edges based on spatial distance and confidence, ensuring consistency between training and testing protocols. Extensive experiments on four popular datasets demonstrate that integrating \\MethodLPP substantially improves the performance of existing edge detection models. In particular, \\MethodLPP increases the Average Crispness (AC) metric by up to 2--4$\\times$ compared to baseline models. Under the crispness-emphasized evaluation (CEval), \\MethodLPP further boosts baseline performance by up to 20--35\\% in ODS and achieves similar gains in OIS and AP, achieving SOTA performance that matches or surpasses standard post-processing for the first time. Code is available at https://cvpr26-matched.github.io."},{"descriptionType":"Other","description":"Accepted to CVPR 2026"}],"geoLocations":[],"fundingReferences":[],"url":"https://arxiv.org/abs/2602.20689","contentUrl":null,"metadataVersion":0,"schemaVersion":"http://datacite.org/schema/kernel-4","source":"mds","isActive":true,"state":"findable","reason":null,"viewCount":0,"downloadCount":0,"referenceCount":0,"citationCount":0,"partCount":0,"partOfCount":0,"versionCount":0,"versionOfCount":0,"created":"2026-02-25T02:56:12Z","registered":"2026-02-25T02:56:13Z","published":null,"updated":"2026-02-25T02:56:13Z"},"relationships":{"client":{"data":{"id":"arxiv.content","type":"clients"}}}},{"id":"10.48550/arxiv.2602.20688","type":"dois","attributes":{"doi":"10.48550/arxiv.2602.20688","identifiers":[{"identifier":"2602.20688","identifierType":"arXiv"}],"creators":[{"nameType":"Personal","affiliation":["Research Institute of Physics, Southern Federal University, Rostov-on-Don, Russia","Faculty of Physics, Southern Federal University, Rostov-on-Don, Russia"],"givenName":"E. R.","familyName":"Redkin","name":"Redkin, E. R.","nameIdentifiers":[]},{"nameType":"Personal","affiliation":["Research Institute of Physics, Southern Federal University, Rostov-on-Don, Russia","Department of Astrophysics, University of Vienna, Vienna, Austria"],"givenName":"E. I.","familyName":"Vorobyov","name":"Vorobyov, E. I.","nameIdentifiers":[]}],"titles":[{"title":"Infall onto the Protoplanetary Disk during the Gravitational Collapse of a Molecular Cloud"}],"publisher":"arXiv","container":{},"publicationYear":2026,"subjects":[{"subject":"Earth and Planetary Astrophysics (astro-ph.EP)","lang":"en","subjectScheme":"arXiv"},{"subject":"Solar and Stellar Astrophysics (astro-ph.SR)","lang":"en","subjectScheme":"arXiv"},{"subject":"FOS: Physical sciences","subjectScheme":"Fields of Science and Technology (FOS)"},{"schemeUri":"http://www.oecd.org/science/inno/38235147.pdf","subject":"FOS: Physical sciences","subjectScheme":"Fields of Science and Technology (FOS)"}],"contributors":[],"dates":[{"date":"2026-02-24T08:44:25Z","dateType":"Submitted","dateInformation":"v1"},{"date":"2026-02-25T01:32:51Z","dateType":"Updated","dateInformation":"v1"},{"date":"2026-02","dateType":"Available","dateInformation":"v1"},{"date":"2026","dateType":"Issued"}],"language":null,"types":{"schemaOrg":"CreativeWork","resourceTypeGeneral":"Preprint","citeproc":"article","bibtex":"misc","ris":"GEN","resourceType":"Article"},"relatedIdentifiers":[],"relatedItems":[],"sizes":[],"formats":[],"version":"1","rightsList":[{"rightsIdentifierScheme":"SPDX","rightsUri":"https://creativecommons.org/licenses/by/4.0/legalcode","schemeUri":"https://spdx.org/licenses/","rights":"Creative Commons Attribution 4.0 International","rightsIdentifier":"cc-by-4.0"}],"descriptions":[{"descriptionType":"Abstract","description":"The development of models for matter infall from a collapsing molecular cloud is an essential part of numerical studies on the formation and evolution of protoplanetary disks. In this article, the widely used Nakamoto and Nakagawa (1994) model is analyzed and modifications are proposed to complement the initial model. These improvements include calculation for the outer boundary of a molecular cloud and refinement of the initial density distribution within. Also, due to the finite size of a cloud, the approach for computing the rate of mass infall onto the protoplanetary disk during collapse is modified. The proposed enhancements are aimed at eliminating the key limitations of the initial model, but do not affect its advantages, such as simplicity in numerical implementation. Using the modified model, we investigate the duration of the embedded phase of the evolution of young stellar objects and compare the modeling results with observational data. The results indicate a shorter duration of the embedded phase of the evolution of young stellar objects, especially in star-forming regions with a high amplitude of the initial density perturbation of prestellar condensation."},{"descriptionType":"Other","description":"27 pages, 4 tables, 5 figures. Accepted for publication in Astronomy Reports"}],"geoLocations":[],"fundingReferences":[],"url":"https://arxiv.org/abs/2602.20688","contentUrl":null,"metadataVersion":0,"schemaVersion":"http://datacite.org/schema/kernel-4","source":"mds","isActive":true,"state":"findable","reason":null,"viewCount":0,"downloadCount":0,"referenceCount":0,"citationCount":0,"partCount":0,"partOfCount":0,"versionCount":0,"versionOfCount":0,"created":"2026-02-25T02:56:11Z","registered":"2026-02-25T02:56:11Z","published":null,"updated":"2026-02-25T02:56:11Z"},"relationships":{"client":{"data":{"id":"arxiv.content","type":"clients"}}}},{"id":"10.48550/arxiv.2602.20687","type":"dois","attributes":{"doi":"10.48550/arxiv.2602.20687","identifiers":[{"identifier":"2602.20687","identifierType":"arXiv"}],"creators":[{"nameType":"Personal","givenName":"Bo","familyName":"Peng","name":"Peng, Bo","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Pi","familyName":"Bu","name":"Bu, Pi","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Keyu","familyName":"Pan","name":"Pan, Keyu","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Xinrun","familyName":"Xu","name":"Xu, Xinrun","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Yinxiu","familyName":"Zhao","name":"Zhao, Yinxiu","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Miao","familyName":"Chen","name":"Chen, Miao","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Yang","familyName":"Du","name":"Du, Yang","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Lin","familyName":"Li","name":"Li, Lin","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Jun","familyName":"Song","name":"Song, Jun","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Tong","familyName":"Xu","name":"Xu, Tong","affiliation":[],"nameIdentifiers":[]}],"titles":[{"title":"How Foundational Skills Influence VLM-based Embodied Agents:A Native Perspective"}],"publisher":"arXiv","container":{},"publicationYear":2026,"subjects":[{"subject":"Artificial Intelligence (cs.AI)","lang":"en","subjectScheme":"arXiv"},{"subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"},{"schemeUri":"http://www.oecd.org/science/inno/38235147.pdf","subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"}],"contributors":[],"dates":[{"date":"2026-02-24T08:42:41Z","dateType":"Submitted","dateInformation":"v1"},{"date":"2026-02-25T01:32:45Z","dateType":"Updated","dateInformation":"v1"},{"date":"2026-02","dateType":"Available","dateInformation":"v1"},{"date":"2026","dateType":"Issued"}],"language":null,"types":{"schemaOrg":"CreativeWork","resourceTypeGeneral":"Preprint","citeproc":"article","bibtex":"misc","ris":"GEN","resourceType":"Article"},"relatedIdentifiers":[],"relatedItems":[],"sizes":[],"formats":[],"version":"1","rightsList":[{"rightsUri":"http://arxiv.org/licenses/nonexclusive-distrib/1.0/","rights":"arXiv.org perpetual, non-exclusive license"}],"descriptions":[{"descriptionType":"Abstract","description":"Recent advances in vision-language models (VLMs) have shown promise for human-level embodied intelligence. However, existing benchmarks for VLM-driven embodied agents often rely on high-level commands or discretized action spaces, which are non-native settings that differ markedly from real-world control. In addition, current benchmarks focus primarily on high-level tasks and lack joint evaluation and analysis at both low and high levels. To address these limitations, we present NativeEmbodied, a challenging benchmark for VLM-driven embodied agents that uses a unified, native low-level action space. Built on diverse simulated scenes, NativeEmbodied includes three representative high-level tasks in complex scenarios to evaluate overall performance. For more detailed analysis, we further decouple the skills required by complex tasks and construct four types of low-level tasks, each targeting a fundamental embodied skill. This joint evaluation across task and skill granularities enables fine-grained assessment of embodied agents. Experiments with state-of-the-art VLMs reveal clear deficiencies in several fundamental embodied skills, and further analysis shows that these bottlenecks significantly limit performance on high-level tasks. NativeEmbodied highlights key challenges for current VLM-driven embodied agents and provides insights to guide future research."}],"geoLocations":[],"fundingReferences":[],"url":"https://arxiv.org/abs/2602.20687","contentUrl":null,"metadataVersion":0,"schemaVersion":"http://datacite.org/schema/kernel-4","source":"mds","isActive":true,"state":"findable","reason":null,"viewCount":0,"downloadCount":0,"referenceCount":0,"citationCount":0,"partCount":0,"partOfCount":0,"versionCount":0,"versionOfCount":0,"created":"2026-02-25T02:56:09Z","registered":"2026-02-25T02:56:10Z","published":null,"updated":"2026-02-25T02:56:10Z"},"relationships":{"client":{"data":{"id":"arxiv.content","type":"clients"}}}},{"id":"10.48550/arxiv.2602.20684","type":"dois","attributes":{"doi":"10.48550/arxiv.2602.20684","identifiers":[{"identifier":"2602.20684","identifierType":"arXiv"}],"creators":[{"nameType":"Personal","givenName":"Christopher","familyName":"Koch","name":"Koch, Christopher","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Joshua Andreas","familyName":"Wellbrock","name":"Wellbrock, Joshua Andreas","affiliation":[],"nameIdentifiers":[]}],"titles":[{"title":"Agile V: A Compliance-Ready Framework for AI-Augmented Engineering -- From Concept to Audit-Ready Delivery"}],"publisher":"arXiv","container":{},"publicationYear":2026,"subjects":[{"subject":"Software Engineering (cs.SE)","lang":"en","subjectScheme":"arXiv"},{"subject":"Artificial Intelligence (cs.AI)","lang":"en","subjectScheme":"arXiv"},{"subject":"Multiagent Systems (cs.MA)","lang":"en","subjectScheme":"arXiv"},{"subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"},{"schemeUri":"http://www.oecd.org/science/inno/38235147.pdf","subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"}],"contributors":[],"dates":[{"date":"2026-02-24T08:41:05Z","dateType":"Submitted","dateInformation":"v1"},{"date":"2026-02-25T01:32:39Z","dateType":"Updated","dateInformation":"v1"},{"date":"2026-02","dateType":"Available","dateInformation":"v1"},{"date":"2026","dateType":"Issued"}],"language":null,"types":{"schemaOrg":"CreativeWork","resourceTypeGeneral":"Preprint","citeproc":"article","bibtex":"misc","ris":"GEN","resourceType":"Article"},"relatedIdentifiers":[],"relatedItems":[],"sizes":[],"formats":[],"version":"1","rightsList":[{"rightsIdentifierScheme":"SPDX","rightsUri":"https://creativecommons.org/licenses/by/4.0/legalcode","schemeUri":"https://spdx.org/licenses/","rights":"Creative Commons Attribution 4.0 International","rightsIdentifier":"cc-by-4.0"}],"descriptions":[{"descriptionType":"Abstract","description":"Current AI-assisted engineering workflows lack a built-in mechanism to maintain task-level verification and regulatory traceability at machine-speed delivery. Agile V addresses this gap by embedding independent verification and audit artifact generation into each task cycle. The framework merges Agile iteration with V-Model verification into a continuous Infinity Loop, deploying specialized AI agents for requirements, design, build, test, and compliance, governed by mandatory human approval gates. We evaluate three hypotheses: (H1) audit-ready artifacts emerge as a by-product of development, (H2) 100% requirement-level verification is achievable with independent test generation, and (H3) verified increments can be delivered with single-digit human interactions per cycle. A feasibility case study on a Hardware-in-the-Loop system (about 500 LOC, 8 requirements, 54 tests) supports all three hypotheses: audit-ready documentation was generated automatically (H1), 100% requirement-level pass rate was achieved (H2), and only 6 prompts per cycle were required (H3), yielding an estimated 10-50x cost reduction versus a COCOMO II baseline (sensitivity range from pessimistic to optimistic assumptions). We invite independent replication to validate generalizability."},{"descriptionType":"Other","description":"9 pages, 2 figures"}],"geoLocations":[],"fundingReferences":[],"url":"https://arxiv.org/abs/2602.20684","contentUrl":null,"metadataVersion":0,"schemaVersion":"http://datacite.org/schema/kernel-4","source":"mds","isActive":true,"state":"findable","reason":null,"viewCount":0,"downloadCount":0,"referenceCount":0,"citationCount":0,"partCount":0,"partOfCount":0,"versionCount":0,"versionOfCount":0,"created":"2026-02-25T02:56:05Z","registered":"2026-02-25T02:56:06Z","published":null,"updated":"2026-02-25T02:56:06Z"},"relationships":{"client":{"data":{"id":"arxiv.content","type":"clients"}}}},{"id":"10.48550/arxiv.2602.20683","type":"dois","attributes":{"doi":"10.48550/arxiv.2602.20683","identifiers":[{"identifier":"2602.20683","identifierType":"arXiv"}],"creators":[{"nameType":"Personal","givenName":"Mohamed","familyName":"Shamseldein","name":"Shamseldein, Mohamed","affiliation":[],"nameIdentifiers":[]}],"titles":[{"title":"Grid-Mind: An LLM-Orchestrated Multi-Fidelity Agent for Automated Connection Impact Assessment"}],"publisher":"arXiv","container":{},"publicationYear":2026,"subjects":[{"subject":"Systems and Control (eess.SY)","lang":"en","subjectScheme":"arXiv"},{"subject":"FOS: Electrical engineering, electronic engineering, information engineering","subjectScheme":"Fields of Science and Technology (FOS)"},{"schemeUri":"http://www.oecd.org/science/inno/38235147.pdf","subject":"FOS: Electrical engineering, electronic engineering, information engineering","subjectScheme":"Fields of Science and Technology (FOS)"}],"contributors":[],"dates":[{"date":"2026-02-24T08:40:54Z","dateType":"Submitted","dateInformation":"v1"},{"date":"2026-02-25T01:32:38Z","dateType":"Updated","dateInformation":"v1"},{"date":"2026-02","dateType":"Available","dateInformation":"v1"},{"date":"2026","dateType":"Issued"}],"language":null,"types":{"schemaOrg":"CreativeWork","resourceTypeGeneral":"Preprint","citeproc":"article","bibtex":"misc","ris":"GEN","resourceType":"Article"},"relatedIdentifiers":[],"relatedItems":[],"sizes":[],"formats":[],"version":"1","rightsList":[{"rightsUri":"http://arxiv.org/licenses/nonexclusive-distrib/1.0/","rights":"arXiv.org perpetual, non-exclusive license"}],"descriptions":[{"descriptionType":"Abstract","description":"Large language models (LLMs) have demonstrated remarkable tool-use capabilities, yet their application to power system operations remains largely unexplored. This paper presents Grid-Mind, a domain-specific LLM agent that interprets natural-language interconnection requests and autonomously orchestrates multi-fidelity power system simulations. The LLM-first architecture positions the language model as the central decision-making entity, employing an eleven-tool registry to execute Connection Impact Assessment (CIA) studies spanning steadystate power flow, N-1 contingency analysis, transient stability, and electromagnetic transient screening. A violation inspector grounds every decision in quantitative simulation outputs, while a three-layer anti-hallucination defence mitigates numerical fabrication risk through forced capacity-tool routing and post-response grounding validation. A prompt-level self-correction mechanism extracts distilled lessons from agent failures, yielding progressive accuracy improvements without model retraining. End-to-end evaluation on 50 IEEE 118-bus scenarios (DeepSeek-V3, 2026-02-23) achieved 84.0% tool-selection accuracy and 100% parsing accuracy. A separate 56-scenario self-correction suite passed 49 of 56 cases (87.5%) with a mean score of 89.3. These results establish a reproducible baseline for continued refinement while maintaining auditable, simulation-grounded decision support."}],"geoLocations":[],"fundingReferences":[],"url":"https://arxiv.org/abs/2602.20683","contentUrl":null,"metadataVersion":0,"schemaVersion":"http://datacite.org/schema/kernel-4","source":"mds","isActive":true,"state":"findable","reason":null,"viewCount":0,"downloadCount":0,"referenceCount":0,"citationCount":0,"partCount":0,"partOfCount":0,"versionCount":0,"versionOfCount":0,"created":"2026-02-25T02:56:04Z","registered":"2026-02-25T02:56:05Z","published":null,"updated":"2026-02-25T02:56:05Z"},"relationships":{"client":{"data":{"id":"arxiv.content","type":"clients"}}}},{"id":"10.48550/arxiv.2602.20681","type":"dois","attributes":{"doi":"10.48550/arxiv.2602.20681","identifiers":[{"identifier":"2602.20681","identifierType":"arXiv"}],"creators":[{"nameType":"Personal","givenName":"Sirui","familyName":"Lin","name":"Lin, Sirui","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Zijun","familyName":"Gao","name":"Gao, Zijun","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Jose","familyName":"Blanchet","name":"Blanchet, Jose","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Peter","familyName":"Glynn","name":"Glynn, Peter","affiliation":[],"nameIdentifiers":[]}],"titles":[{"title":"Statistical Inference in Causal Partial Identification with Smooth Densities"}],"publisher":"arXiv","container":{},"publicationYear":2026,"subjects":[{"subject":"Statistics Theory (math.ST)","lang":"en","subjectScheme":"arXiv"},{"subject":"FOS: Mathematics","subjectScheme":"Fields of Science and Technology (FOS)"},{"schemeUri":"http://www.oecd.org/science/inno/38235147.pdf","subject":"FOS: Mathematics","subjectScheme":"Fields of Science and Technology (FOS)"}],"contributors":[],"dates":[{"date":"2026-02-24T08:34:57Z","dateType":"Submitted","dateInformation":"v1"},{"date":"2026-02-25T01:32:28Z","dateType":"Updated","dateInformation":"v1"},{"date":"2026-02","dateType":"Available","dateInformation":"v1"},{"date":"2026","dateType":"Issued"}],"language":null,"types":{"schemaOrg":"CreativeWork","resourceTypeGeneral":"Preprint","citeproc":"article","bibtex":"misc","ris":"GEN","resourceType":"Article"},"relatedIdentifiers":[],"relatedItems":[],"sizes":[],"formats":[],"version":"1","rightsList":[{"rightsIdentifierScheme":"SPDX","rightsUri":"https://creativecommons.org/licenses/by/4.0/legalcode","schemeUri":"https://spdx.org/licenses/","rights":"Creative Commons Attribution 4.0 International","rightsIdentifier":"cc-by-4.0"}],"descriptions":[{"descriptionType":"Abstract","description":"Many causal quantities are only partially identifiable due to the inherent missingness of potential outcomes, and the associated partial identification (PI) sets can be obtained by solving an optimal transport (OT) problem. Covariates often provide additional information about the potential outcomes and thus yield tighter PI sets, which can be obtained via conditional optimal transport (COT). However, COT-based PI set estimators are susceptible to the curse of dimensionality in the covariates and outcomes, which precludes the asymptotic normality and hinders statistical inference. In this paper, we exploit smoothness in the marginal densities of covariates and potential outcomes and develop a wavelet-based primal method for COT with multivariate outcomes and covariates. Moreover, for quadratic cost functions, we establish a stability result for COT and prove asymptotic normality of the proposed estimator. This characterization of the asymptotic distribution enables valid statistical inference for the partial identification set. Empirically, we validate the estimation and inference performance of our approach through numerical experiments in comparison with existing benchmarks."}],"geoLocations":[],"fundingReferences":[],"url":"https://arxiv.org/abs/2602.20681","contentUrl":null,"metadataVersion":0,"schemaVersion":"http://datacite.org/schema/kernel-4","source":"mds","isActive":true,"state":"findable","reason":null,"viewCount":0,"downloadCount":0,"referenceCount":0,"citationCount":0,"partCount":0,"partOfCount":0,"versionCount":0,"versionOfCount":0,"created":"2026-02-25T02:56:01Z","registered":"2026-02-25T02:56:02Z","published":null,"updated":"2026-02-25T02:56:02Z"},"relationships":{"client":{"data":{"id":"arxiv.content","type":"clients"}}}},{"id":"10.48550/arxiv.2602.20680","type":"dois","attributes":{"doi":"10.48550/arxiv.2602.20680","identifiers":[{"identifier":"2602.20680","identifierType":"arXiv"}],"creators":[{"nameType":"Personal","givenName":"Fan","familyName":"Guo","name":"Guo, Fan","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Jiyu","familyName":"Kang","name":"Kang, Jiyu","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Qi","familyName":"Ming","name":"Ming, Qi","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Emily","familyName":"Davis","name":"Davis, Emily","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Finn","familyName":"Carter","name":"Carter, Finn","affiliation":[],"nameIdentifiers":[]}],"titles":[{"title":"Vanishing Watermarks: Diffusion-Based Image Editing Undermines Robust Invisible Watermarking"}],"publisher":"arXiv","container":{},"publicationYear":2026,"subjects":[{"subject":"Cryptography and Security (cs.CR)","lang":"en","subjectScheme":"arXiv"},{"subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"},{"schemeUri":"http://www.oecd.org/science/inno/38235147.pdf","subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"}],"contributors":[],"dates":[{"date":"2026-02-24T08:34:48Z","dateType":"Submitted","dateInformation":"v1"},{"date":"2026-02-25T01:32:27Z","dateType":"Updated","dateInformation":"v1"},{"date":"2026-02","dateType":"Available","dateInformation":"v1"},{"date":"2026","dateType":"Issued"}],"language":null,"types":{"schemaOrg":"CreativeWork","resourceTypeGeneral":"Preprint","citeproc":"article","bibtex":"misc","ris":"GEN","resourceType":"Article"},"relatedIdentifiers":[],"relatedItems":[],"sizes":[],"formats":[],"version":"1","rightsList":[{"rightsUri":"http://arxiv.org/licenses/nonexclusive-distrib/1.0/","rights":"arXiv.org perpetual, non-exclusive license"}],"descriptions":[{"descriptionType":"Abstract","description":"Robust invisible watermarking schemes aim to embed hidden information into images such that the watermark survives common manipulations. However, powerful diffusion-based image generation and editing techniques now pose a new threat to these watermarks. In this paper, we present a comprehensive theoretical and empirical analysis demonstrating that diffusion models can effectively erase robust watermarks even when those watermarks were designed to withstand conventional distortions. We show that a diffusion-driven image regeneration process, which leverages generative models to recreate an image, can remove embedded watermarks while preserving the image's perceptual content. Furthermore, we introduce a guided diffusion-based attack that explicitly targets the embedded watermark signal during generation, significantly degrading watermark detectability. Theoretically, we prove that as an image undergoes sufficient diffusion transformations, the mutual information between the watermarked image and the hidden payload approaches zero, leading to inevitable decoding failure. Experimentally, we evaluate multiple state-of-the-art watermarking methods (including deep learning-based schemes like StegaStamp, TrustMark, and VINE) and demonstrate that diffusion edits yield near-zero watermark recovery rates after attack, while maintaining high visual fidelity of the regenerated images. Our findings reveal a fundamental vulnerability in current robust watermarking techniques against generative model-based edits, underscoring the need for new strategies to ensure watermark resilience in the era of powerful diffusion models."},{"descriptionType":"Other","description":"Preprint"}],"geoLocations":[],"fundingReferences":[],"url":"https://arxiv.org/abs/2602.20680","contentUrl":null,"metadataVersion":0,"schemaVersion":"http://datacite.org/schema/kernel-4","source":"mds","isActive":true,"state":"findable","reason":null,"viewCount":0,"downloadCount":0,"referenceCount":0,"citationCount":0,"partCount":0,"partOfCount":0,"versionCount":0,"versionOfCount":0,"created":"2026-02-25T02:56:00Z","registered":"2026-02-25T02:56:00Z","published":null,"updated":"2026-02-25T02:56:00Z"},"relationships":{"client":{"data":{"id":"arxiv.content","type":"clients"}}}},{"id":"10.48550/arxiv.2602.20679","type":"dois","attributes":{"doi":"10.48550/arxiv.2602.20679","identifiers":[{"identifier":"2602.20679","identifierType":"arXiv"}],"creators":[{"nameType":"Personal","givenName":"Andreu","familyName":"Martorell","name":"Martorell, Andreu","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Pep","familyName":"Mulet","name":"Mulet, Pep","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Dionisio F.","familyName":"Yáñez","name":"Yáñez, Dionisio F.","affiliation":[],"nameIdentifiers":[]}],"titles":[{"title":"Implicit-explicit all-speed schemes for compressible Cahn-Hilliard-Navier-Stokes equations"}],"publisher":"arXiv","container":{},"publicationYear":2026,"subjects":[{"subject":"Numerical Analysis (math.NA)","lang":"en","subjectScheme":"arXiv"},{"subject":"FOS: Mathematics","subjectScheme":"Fields of Science and Technology (FOS)"},{"schemeUri":"http://www.oecd.org/science/inno/38235147.pdf","subject":"FOS: Mathematics","subjectScheme":"Fields of Science and Technology (FOS)"}],"contributors":[],"dates":[{"date":"2026-02-24T08:34:26Z","dateType":"Submitted","dateInformation":"v1"},{"date":"2026-02-25T01:32:23Z","dateType":"Updated","dateInformation":"v1"},{"date":"2026-02","dateType":"Available","dateInformation":"v1"},{"date":"2026","dateType":"Issued"}],"language":null,"types":{"schemaOrg":"CreativeWork","resourceTypeGeneral":"Preprint","citeproc":"article","bibtex":"misc","ris":"GEN","resourceType":"Article"},"relatedIdentifiers":[],"relatedItems":[],"sizes":[],"formats":[],"version":"1","rightsList":[{"rightsUri":"http://arxiv.org/licenses/nonexclusive-distrib/1.0/","rights":"arXiv.org perpetual, non-exclusive license"}],"descriptions":[{"descriptionType":"Abstract","description":"We propose a second-order implicit-explicit (IMEX) time-stepping scheme for the isentropic, compressible Cahn-Hilliard-Navier-Stokes equations in the low Mach number regime.\n The method is based on finite differences on staggered grids and is specifically designed to handle the challenges posed by the low Mach number limit, where the system approaches to an incompressible behavior.\n In this regime, standard explicit schemes suffer from severe time-step restrictions due to fourth-order diffusion terms and the stiffness induced by fast acoustic waves.\n To overcome this, we employ an IMEX strategy which splits the governing equations into stiff and non-stiff components.\n The stiff terms, arising from pressure, viscous forces and fourth-order Cahn-Hilliard contributions, are treated implicitly, while the remaining are dealt explicitly."}],"geoLocations":[],"fundingReferences":[],"url":"https://arxiv.org/abs/2602.20679","contentUrl":null,"metadataVersion":0,"schemaVersion":"http://datacite.org/schema/kernel-4","source":"mds","isActive":true,"state":"findable","reason":null,"viewCount":0,"downloadCount":0,"referenceCount":0,"citationCount":0,"partCount":0,"partOfCount":0,"versionCount":0,"versionOfCount":0,"created":"2026-02-25T02:55:58Z","registered":"2026-02-25T02:55:59Z","published":null,"updated":"2026-02-25T02:55:59Z"},"relationships":{"client":{"data":{"id":"arxiv.content","type":"clients"}}}},{"id":"10.48550/arxiv.2602.20678","type":"dois","attributes":{"doi":"10.48550/arxiv.2602.20678","identifiers":[{"identifier":"2602.20678","identifierType":"arXiv"}],"creators":[{"nameType":"Personal","givenName":"Tomona","familyName":"Kinugawa","name":"Kinugawa, Tomona","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Tetsuo","familyName":"Hyodo","name":"Hyodo, Tetsuo","affiliation":[],"nameIdentifiers":[]}],"titles":[{"title":"Structure of near-threshold states in systems with Coulomb and short-range interactions"}],"publisher":"arXiv","container":{},"publicationYear":2026,"subjects":[{"subject":"High Energy Physics - Phenomenology (hep-ph)","lang":"en","subjectScheme":"arXiv"},{"subject":"FOS: Physical sciences","subjectScheme":"Fields of Science and Technology (FOS)"},{"schemeUri":"http://www.oecd.org/science/inno/38235147.pdf","subject":"FOS: Physical sciences","subjectScheme":"Fields of Science and Technology (FOS)"}],"contributors":[],"dates":[{"date":"2026-02-24T08:33:03Z","dateType":"Submitted","dateInformation":"v1"},{"date":"2026-02-25T01:32:22Z","dateType":"Updated","dateInformation":"v1"},{"date":"2026-02","dateType":"Available","dateInformation":"v1"},{"date":"2026","dateType":"Issued"}],"language":null,"types":{"schemaOrg":"CreativeWork","resourceTypeGeneral":"Preprint","citeproc":"article","bibtex":"misc","ris":"GEN","resourceType":"Article"},"relatedIdentifiers":[],"relatedItems":[],"sizes":[],"formats":[],"version":"1","rightsList":[{"rightsUri":"http://arxiv.org/licenses/nonexclusive-distrib/1.0/","rights":"arXiv.org perpetual, non-exclusive license"}],"descriptions":[{"descriptionType":"Abstract","description":"We study the nature of near-threshold eigenstates in systems with the attractive Coulomb plus short-range interactions. Using a model providing the Coulomb-modified effective range expansion, we analyze pole trajectories and the internal structure of near-threshold states characterized by the compositeness. We find that bound state and resonance poles are disconnected in the presence of the attractive Coulomb interaction, in contrast to the repulsive Coulomb force. Near the threshold, bound states become almost purely composite, while the behavior of the compositeness near unityis controlled by the competition between the Coulomb and short-range interactions, characterized by the Bohr radius and the Coulomb effective range."},{"descriptionType":"Other","description":"6 pages, 1 figure, Proceedings of 15th International Conference on Hypernuclear and Strange Particle Physics (HYP2025), 29th September-3rd October, 2025"}],"geoLocations":[],"fundingReferences":[],"url":"https://arxiv.org/abs/2602.20678","contentUrl":null,"metadataVersion":0,"schemaVersion":"http://datacite.org/schema/kernel-4","source":"mds","isActive":true,"state":"findable","reason":null,"viewCount":0,"downloadCount":0,"referenceCount":0,"citationCount":0,"partCount":0,"partOfCount":0,"versionCount":0,"versionOfCount":0,"created":"2026-02-25T02:55:57Z","registered":"2026-02-25T02:55:57Z","published":null,"updated":"2026-02-25T02:55:57Z"},"relationships":{"client":{"data":{"id":"arxiv.content","type":"clients"}}}},{"id":"10.48550/arxiv.2602.20676","type":"dois","attributes":{"doi":"10.48550/arxiv.2602.20676","identifiers":[{"identifier":"2602.20676","identifierType":"arXiv"}],"creators":[{"nameType":"Personal","givenName":"Shuzhi","familyName":"Cao","name":"Cao, Shuzhi","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Rong","familyName":"Chen","name":"Chen, Rong","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Ailong","familyName":"He","name":"He, Ailong","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Shuguang","familyName":"Han","name":"Han, Shuguang","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Jufeng","familyName":"Chen","name":"Chen, Jufeng","affiliation":[],"nameIdentifiers":[]}],"titles":[{"title":"PRECTR-V2:Unified Relevance-CTR Framework with Cross-User Preference Mining, Exposure Bias Correction, and LLM-Distilled Encoder Optimization"}],"publisher":"arXiv","container":{},"publicationYear":2026,"subjects":[{"subject":"Information Retrieval (cs.IR)","lang":"en","subjectScheme":"arXiv"},{"subject":"Artificial Intelligence (cs.AI)","lang":"en","subjectScheme":"arXiv"},{"subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"},{"schemeUri":"http://www.oecd.org/science/inno/38235147.pdf","subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"}],"contributors":[],"dates":[{"date":"2026-02-24T08:26:17Z","dateType":"Submitted","dateInformation":"v1"},{"date":"2026-02-25T01:32:05Z","dateType":"Updated","dateInformation":"v1"},{"date":"2026-02","dateType":"Available","dateInformation":"v1"},{"date":"2026","dateType":"Issued"}],"language":null,"types":{"schemaOrg":"CreativeWork","resourceTypeGeneral":"Preprint","citeproc":"article","bibtex":"misc","ris":"GEN","resourceType":"Article"},"relatedIdentifiers":[],"relatedItems":[],"sizes":[],"formats":[],"version":"1","rightsList":[{"rightsUri":"http://arxiv.org/licenses/nonexclusive-distrib/1.0/","rights":"arXiv.org perpetual, non-exclusive license"}],"descriptions":[{"descriptionType":"Abstract","description":"In search systems, effectively coordinating the two core objectives of search relevance matching and click-through rate (CTR) prediction is crucial for discovering users' interests and enhancing platform revenue. In our prior work PRECTR, we proposed a unified framework to integrate these two subtasks,thereby eliminating their inconsistency and leading to mutual benefit.However, our previous work still faces three main challenges. First, low-active users and new users have limited search behavioral data, making it difficult to achieve effective personalized relevance preference modeling. Second, training data for ranking models predominantly come from high-relevance exposures, creating a distribution mismatch with the broader candidate space in coarse-ranking, leading to generalization bias. Third, due to the latency constraint, the original model employs an Emb+MLP architecture with a frozen BERT encoder, which prevents joint optimization and creates misalignment between representation learning and CTR fine-tuning. To solve these issues, we further reinforce our method and propose PRECTR-V2. Specifically, we mitigate the low-activity users' sparse behavior problem by mining global relevance preferences under the specific query, which facilitates effective personalized relevance modeling for cold-start scenarios. Subsequently, we construct hard negative samples through embedding noise injection and relevance label reconstruction, and optimize their relative ranking against positive samples via pairwise loss, thereby correcting exposure bias. Finally, we pretrain a lightweight transformer-based encoder via knowledge distillation from LLM and SFT on the text relevance classification task. This encoder replaces the frozen BERT module, enabling better adaptation to CTR fine-tuning and advancing beyond the traditional Emb+MLP paradigm."},{"descriptionType":"Other","description":"arXiv admin note: text overlap with arXiv:2503.18395"}],"geoLocations":[],"fundingReferences":[],"url":"https://arxiv.org/abs/2602.20676","contentUrl":null,"metadataVersion":0,"schemaVersion":"http://datacite.org/schema/kernel-4","source":"mds","isActive":true,"state":"findable","reason":null,"viewCount":0,"downloadCount":0,"referenceCount":0,"citationCount":0,"partCount":0,"partOfCount":0,"versionCount":0,"versionOfCount":0,"created":"2026-02-25T02:55:54Z","registered":"2026-02-25T02:55:54Z","published":null,"updated":"2026-02-25T02:55:54Z"},"relationships":{"client":{"data":{"id":"arxiv.content","type":"clients"}}}},{"id":"10.48550/arxiv.2602.20675","type":"dois","attributes":{"doi":"10.48550/arxiv.2602.20675","identifiers":[{"identifier":"2602.20675","identifierType":"arXiv"}],"creators":[{"nameType":"Personal","givenName":"Esmaeal","familyName":"Ghavanloo","name":"Ghavanloo, Esmaeal","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Pierre","familyName":"Fritsch","name":"Fritsch, Pierre","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Patrizio","familyName":"Neff","name":"Neff, Patrizio","affiliation":[],"nameIdentifiers":[]}],"titles":[{"title":"Analytical solutions for long cylindrical shells under radial deformations based on the isotropic relaxed micromorphic continuum"}],"publisher":"arXiv","container":{},"publicationYear":2026,"subjects":[{"subject":"Analysis of PDEs (math.AP)","lang":"en","subjectScheme":"arXiv"},{"subject":"FOS: Mathematics","subjectScheme":"Fields of Science and Technology (FOS)"},{"schemeUri":"http://www.oecd.org/science/inno/38235147.pdf","subject":"FOS: Mathematics","subjectScheme":"Fields of Science and Technology (FOS)"}],"contributors":[],"dates":[{"date":"2026-02-24T08:24:33Z","dateType":"Submitted","dateInformation":"v1"},{"date":"2026-02-25T01:31:53Z","dateType":"Updated","dateInformation":"v1"},{"date":"2026-02","dateType":"Available","dateInformation":"v1"},{"date":"2026","dateType":"Issued"}],"language":null,"types":{"schemaOrg":"CreativeWork","resourceTypeGeneral":"Preprint","citeproc":"article","bibtex":"misc","ris":"GEN","resourceType":"Article"},"relatedIdentifiers":[],"relatedItems":[],"sizes":[],"formats":[],"version":"1","rightsList":[{"rightsUri":"http://arxiv.org/licenses/nonexclusive-distrib/1.0/","rights":"arXiv.org perpetual, non-exclusive license"}],"descriptions":[{"descriptionType":"Abstract","description":"This study presents a closed-form analytical solution for the elastostatic response of long cylindrical shells composed of microstructured materials within the framework of the isotropic relaxed micromorphic continuum. The formulation accounts for microstructural effects by introducing an independent micro-distortion tensor field in addition to the classical displacement field. Under the assumptions of axisymmetric deformation and plane strain conditions, the governing equilibrium equations reduce to a coupled system of ordinary differential equations in the radial coordinate. By introducing suitable auxiliary variables, the system is reformulated into a non-homogeneous modified Bessel equation, which admits an exact analytical solution. Explicit expressions are derived for the radial displacement field and the non-zero components of the micro-distortion tensor. Numerical examples are presented to illustrate the influence of material parameters and the characteristic length on the displacement. The results demonstrate that the relaxed micromorphic model predicts deviations from classical elasticity where microstructural effects are more pronounced. The obtained solution provides valuable physical insight into the mechanics of cylindrical shells and serves as a benchmark for validating numerical implementations of relaxed micromorphic models."}],"geoLocations":[],"fundingReferences":[],"url":"https://arxiv.org/abs/2602.20675","contentUrl":null,"metadataVersion":0,"schemaVersion":"http://datacite.org/schema/kernel-4","source":"mds","isActive":true,"state":"findable","reason":null,"viewCount":0,"downloadCount":0,"referenceCount":0,"citationCount":0,"partCount":0,"partOfCount":0,"versionCount":0,"versionOfCount":0,"created":"2026-02-25T02:55:52Z","registered":"2026-02-25T02:55:53Z","published":null,"updated":"2026-02-25T02:55:53Z"},"relationships":{"client":{"data":{"id":"arxiv.content","type":"clients"}}}},{"id":"10.48550/arxiv.2602.20672","type":"dois","attributes":{"doi":"10.48550/arxiv.2602.20672","identifiers":[{"identifier":"2602.20672","identifierType":"arXiv"}],"creators":[{"nameType":"Personal","givenName":"Eliran","familyName":"Kachlon","name":"Kachlon, Eliran","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Alexander","familyName":"Visheratin","name":"Visheratin, Alexander","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Nimrod","familyName":"Sarid","name":"Sarid, Nimrod","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Tal","familyName":"Hacham","name":"Hacham, Tal","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Eyal","familyName":"Gutflaish","name":"Gutflaish, Eyal","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Saar","familyName":"Huberman","name":"Huberman, Saar","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Hezi","familyName":"Zisman","name":"Zisman, Hezi","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"David","familyName":"Ruppin","name":"Ruppin, David","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Ron","familyName":"Mokady","name":"Mokady, Ron","affiliation":[],"nameIdentifiers":[]}],"titles":[{"title":"BBQ-to-Image: Numeric Bounding Box and Qolor Control in Large-Scale Text-to-Image Models"}],"publisher":"arXiv","container":{},"publicationYear":2026,"subjects":[{"subject":"Computer Vision and Pattern Recognition (cs.CV)","lang":"en","subjectScheme":"arXiv"},{"subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"},{"schemeUri":"http://www.oecd.org/science/inno/38235147.pdf","subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"}],"contributors":[],"dates":[{"date":"2026-02-24T08:22:42Z","dateType":"Submitted","dateInformation":"v1"},{"date":"2026-02-25T01:31:40Z","dateType":"Updated","dateInformation":"v1"},{"date":"2026-02","dateType":"Available","dateInformation":"v1"},{"date":"2026","dateType":"Issued"}],"language":null,"types":{"schemaOrg":"CreativeWork","resourceTypeGeneral":"Preprint","citeproc":"article","bibtex":"misc","ris":"GEN","resourceType":"Article"},"relatedIdentifiers":[],"relatedItems":[],"sizes":[],"formats":[],"version":"1","rightsList":[{"rightsIdentifierScheme":"SPDX","rightsUri":"https://creativecommons.org/licenses/by-nc-sa/4.0/legalcode","schemeUri":"https://spdx.org/licenses/","rights":"Creative Commons Attribution Non Commercial Share Alike 4.0 International","rightsIdentifier":"cc-by-nc-sa-4.0"}],"descriptions":[{"descriptionType":"Abstract","description":"Text-to-image models have rapidly advanced in realism and controllability, with recent approaches leveraging long, detailed captions to support fine-grained generation. However, a fundamental parametric gap remains: existing models rely on descriptive language, whereas professional workflows require precise numeric control over object location, size, and color. In this work, we introduce BBQ, a large-scale text-to-image model that directly conditions on numeric bounding boxes and RGB triplets within a unified structured-text framework. We obtain precise spatial and chromatic control by training on captions enriched with parametric annotations, without architectural modifications or inference-time optimization. This also enables intuitive user interfaces such as object dragging and color pickers, replacing ambiguous iterative prompting with precise, familiar controls. Across comprehensive evaluations, BBQ achieves strong box alignment and improves RGB color fidelity over state-of-the-art baselines. More broadly, our results support a new paradigm in which user intent is translated into an intermediate structured language, consumed by a flow-based transformer acting as a renderer and naturally accommodating numeric parameters."}],"geoLocations":[],"fundingReferences":[],"url":"https://arxiv.org/abs/2602.20672","contentUrl":null,"metadataVersion":0,"schemaVersion":"http://datacite.org/schema/kernel-4","source":"mds","isActive":true,"state":"findable","reason":null,"viewCount":0,"downloadCount":0,"referenceCount":0,"citationCount":0,"partCount":0,"partOfCount":0,"versionCount":0,"versionOfCount":0,"created":"2026-02-25T02:55:48Z","registered":"2026-02-25T02:55:49Z","published":null,"updated":"2026-02-25T02:55:49Z"},"relationships":{"client":{"data":{"id":"arxiv.content","type":"clients"}}}},{"id":"10.48550/arxiv.2602.20671","type":"dois","attributes":{"doi":"10.48550/arxiv.2602.20671","identifiers":[{"identifier":"2602.20671","identifierType":"arXiv"}],"creators":[{"nameType":"Personal","givenName":"Antonios","familyName":"Tziorvas","name":"Tziorvas, Antonios","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Andreas","familyName":"Tritsarolis","name":"Tritsarolis, Andreas","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Yannis","familyName":"Theodoridis","name":"Theodoridis, Yannis","affiliation":[],"nameIdentifiers":[]}],"titles":[{"title":"Bikelution: Federated Gradient-Boosting for Scalable Shared Micro-Mobility Demand Forecasting"}],"publisher":"arXiv","container":{},"publicationYear":2026,"subjects":[{"subject":"Machine Learning (cs.LG)","lang":"en","subjectScheme":"arXiv"},{"subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"},{"schemeUri":"http://www.oecd.org/science/inno/38235147.pdf","subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"}],"contributors":[],"dates":[{"date":"2026-02-24T08:21:28Z","dateType":"Submitted","dateInformation":"v1"},{"date":"2026-02-25T01:31:24Z","dateType":"Updated","dateInformation":"v1"},{"date":"2026-02","dateType":"Available","dateInformation":"v1"},{"date":"2026","dateType":"Issued"}],"language":null,"types":{"schemaOrg":"CreativeWork","resourceTypeGeneral":"Preprint","citeproc":"article","bibtex":"misc","ris":"GEN","resourceType":"Article"},"relatedIdentifiers":[],"relatedItems":[],"sizes":[],"formats":[],"version":"1","rightsList":[{"rightsUri":"http://arxiv.org/licenses/nonexclusive-distrib/1.0/","rights":"arXiv.org perpetual, non-exclusive license"}],"descriptions":[{"descriptionType":"Abstract","description":"The rapid growth of dockless bike-sharing systems has generated massive spatio-temporal datasets useful for fleet allocation, congestion reduction, and sustainable mobility. Bike demand, however, depends on several external factors, making traditional time-series models insufficient. Centralized Machine Learning (CML) yields high-accuracy forecasts but raises privacy and bandwidth issues when data are distributed across edge devices. To overcome these limitations, we propose Bikelution, an efficient Federated Learning (FL) solution based on gradient-boosted trees that preserves privacy while delivering accurate mid-term demand forecasts up to six hours ahead. Experiments on three real-world BSS datasets show that Bikelution is comparable to its CML-based variant and outperforms the current state-of-the-art. The results highlight the feasibility of privacy-aware demand forecasting and outline the trade-offs between FL and CML approaches."}],"geoLocations":[],"fundingReferences":[],"url":"https://arxiv.org/abs/2602.20671","contentUrl":null,"metadataVersion":0,"schemaVersion":"http://datacite.org/schema/kernel-4","source":"mds","isActive":true,"state":"findable","reason":null,"viewCount":0,"downloadCount":0,"referenceCount":0,"citationCount":0,"partCount":0,"partOfCount":0,"versionCount":0,"versionOfCount":0,"created":"2026-02-25T02:55:47Z","registered":"2026-02-25T02:55:47Z","published":null,"updated":"2026-02-25T02:55:47Z"},"relationships":{"client":{"data":{"id":"arxiv.content","type":"clients"}}}},{"id":"10.48550/arxiv.2602.20667","type":"dois","attributes":{"doi":"10.48550/arxiv.2602.20667","identifiers":[{"identifier":"2602.20667","identifierType":"arXiv"}],"creators":[{"nameType":"Personal","givenName":"Hirotaka","familyName":"Kikyo","name":"Kikyo, Hirotaka","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Koitaro","familyName":"Nakaura","name":"Nakaura, Koitaro","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Akito","familyName":"Tsuboi","name":"Tsuboi, Akito","affiliation":[],"nameIdentifiers":[]}],"titles":[{"title":"On chromatic number of countable graphs"}],"publisher":"arXiv","container":{},"publicationYear":2026,"subjects":[{"subject":"Logic (math.LO)","lang":"en","subjectScheme":"arXiv"},{"subject":"FOS: Mathematics","subjectScheme":"Fields of Science and Technology (FOS)"},{"schemeUri":"http://www.oecd.org/science/inno/38235147.pdf","subject":"FOS: Mathematics","subjectScheme":"Fields of Science and Technology (FOS)"}],"contributors":[],"dates":[{"date":"2026-02-24T08:15:31Z","dateType":"Submitted","dateInformation":"v1"},{"date":"2026-02-25T01:30:59Z","dateType":"Updated","dateInformation":"v1"},{"date":"2026-02","dateType":"Available","dateInformation":"v1"},{"date":"2026","dateType":"Issued"}],"language":null,"types":{"schemaOrg":"CreativeWork","resourceTypeGeneral":"Preprint","citeproc":"article","bibtex":"misc","ris":"GEN","resourceType":"Article"},"relatedIdentifiers":[],"relatedItems":[],"sizes":[],"formats":[],"version":"1","rightsList":[{"rightsUri":"http://arxiv.org/licenses/nonexclusive-distrib/1.0/","rights":"arXiv.org perpetual, non-exclusive license"}],"descriptions":[{"descriptionType":"Abstract","description":"This paper investigates when countable graphs have a finite or an infinite chromatic number through model theoretic methods. For Fraïssé limits, we show that instability forces the chromatic number to be infinite, yielding a complete classification of homogeneous graphs with a finite chromatic number. In contrast, Hrushovski construction always produces graphs of finite chromatic number, though the value can be made arbitrarily large. In tame settings -- such as stable graphs of $U$-rank one and graphs definable in o-minimal structures -- an infinite chromatic number necessarily yields arbitrarily large cliques. These results provide a unified framework connecting structural model theoretic properties with chromatic behavior."}],"geoLocations":[],"fundingReferences":[],"url":"https://arxiv.org/abs/2602.20667","contentUrl":null,"metadataVersion":0,"schemaVersion":"http://datacite.org/schema/kernel-4","source":"mds","isActive":true,"state":"findable","reason":null,"viewCount":0,"downloadCount":0,"referenceCount":0,"citationCount":0,"partCount":0,"partOfCount":0,"versionCount":0,"versionOfCount":0,"created":"2026-02-25T02:55:41Z","registered":"2026-02-25T02:55:42Z","published":null,"updated":"2026-02-25T02:55:42Z"},"relationships":{"client":{"data":{"id":"arxiv.content","type":"clients"}}}},{"id":"10.48550/arxiv.2602.20666","type":"dois","attributes":{"doi":"10.48550/arxiv.2602.20666","identifiers":[{"identifier":"2602.20666","identifierType":"arXiv"}],"creators":[{"nameType":"Personal","givenName":"Juil","familyName":"Koo","name":"Koo, Juil","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Wei-Tung","familyName":"Lin","name":"Lin, Wei-Tung","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Chanho","familyName":"Park","name":"Park, Chanho","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Chanhyeok","familyName":"Park","name":"Park, Chanhyeok","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Minhyuk","familyName":"Sung","name":"Sung, Minhyuk","affiliation":[],"nameIdentifiers":[]}],"titles":[{"title":"BoxSplitGen: A Generative Model for 3D Part Bounding Boxes in Varying Granularity"}],"publisher":"arXiv","container":{},"publicationYear":2026,"subjects":[{"subject":"Computer Vision and Pattern Recognition (cs.CV)","lang":"en","subjectScheme":"arXiv"},{"subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"},{"schemeUri":"http://www.oecd.org/science/inno/38235147.pdf","subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"}],"contributors":[],"dates":[{"date":"2026-02-24T08:15:25Z","dateType":"Submitted","dateInformation":"v1"},{"date":"2026-02-25T01:30:55Z","dateType":"Updated","dateInformation":"v1"},{"date":"2026-02","dateType":"Available","dateInformation":"v1"},{"date":"2026","dateType":"Issued"}],"language":null,"types":{"schemaOrg":"CreativeWork","resourceTypeGeneral":"Preprint","citeproc":"article","bibtex":"misc","ris":"GEN","resourceType":"Article"},"relatedIdentifiers":[],"relatedItems":[],"sizes":[],"formats":[],"version":"1","rightsList":[{"rightsUri":"http://arxiv.org/licenses/nonexclusive-distrib/1.0/","rights":"arXiv.org perpetual, non-exclusive license"}],"descriptions":[{"descriptionType":"Abstract","description":"Human creativity follows a perceptual process, moving from abstract ideas to finer details during creation. While 3D generative models have advanced dramatically, models specifically designed to assist human imagination in 3D creation -- particularly for detailing abstractions from coarse to fine -- have not been explored. We propose a framework that enables intuitive and interactive 3D shape generation by iteratively splitting bounding boxes to refine the set of bounding boxes. The main technical components of our framework are two generative models: the box-splitting generative model and the box-to-shape generative model. The first model, named BoxSplitGen, generates a collection of 3D part bounding boxes with varying granularity by iteratively splitting coarse bounding boxes. It utilizes part bounding boxes created through agglomerative merging and learns the reverse of the merging process -- the splitting sequences. The model consists of two main components: the first learns the categorical distribution of the box to be split, and the second learns the distribution of the two new boxes, given the set of boxes and the indication of which box to split. The second model, the box-to-shape generative model, is trained by leveraging the 3D shape priors learned by an existing 3D diffusion model while adapting the model to incorporate bounding box conditioning. In our experiments, we demonstrate that the box-splitting generative model outperforms token prediction models and the inpainting approach with an unconditional diffusion model. Also, we show that our box-to-shape model, based on a state-of-the-art 3D diffusion model, provides superior results compared to a previous model."},{"descriptionType":"Other","description":"Project page: https://boxsplitgen.github.io"}],"geoLocations":[],"fundingReferences":[],"url":"https://arxiv.org/abs/2602.20666","contentUrl":null,"metadataVersion":0,"schemaVersion":"http://datacite.org/schema/kernel-4","source":"mds","isActive":true,"state":"findable","reason":null,"viewCount":0,"downloadCount":0,"referenceCount":0,"citationCount":0,"partCount":0,"partOfCount":0,"versionCount":0,"versionOfCount":0,"created":"2026-02-25T02:55:40Z","registered":"2026-02-25T02:55:40Z","published":null,"updated":"2026-02-25T02:55:40Z"},"relationships":{"client":{"data":{"id":"arxiv.content","type":"clients"}}}},{"id":"10.48550/arxiv.2602.20664","type":"dois","attributes":{"doi":"10.48550/arxiv.2602.20664","identifiers":[{"identifier":"2602.20664","identifierType":"arXiv"}],"creators":[{"nameType":"Personal","givenName":"Hailong","familyName":"Yan","name":"Yan, Hailong","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Shice","familyName":"Liu","name":"Liu, Shice","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Tao","familyName":"Wang","name":"Wang, Tao","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Xiangtao","familyName":"Zhang","name":"Zhang, Xiangtao","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Yijie","familyName":"Zhong","name":"Zhong, Yijie","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Jinwei","familyName":"Chen","name":"Chen, Jinwei","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Le","familyName":"Zhang","name":"Zhang, Le","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Bo","familyName":"Li","name":"Li, Bo","affiliation":[],"nameIdentifiers":[]}],"titles":[{"title":"AnimeAgent: Is the Multi-Agent via Image-to-Video models a Good Disney Storytelling Artist?"}],"publisher":"arXiv","container":{},"publicationYear":2026,"subjects":[{"subject":"Computer Vision and Pattern Recognition (cs.CV)","lang":"en","subjectScheme":"arXiv"},{"subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"},{"schemeUri":"http://www.oecd.org/science/inno/38235147.pdf","subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"}],"contributors":[],"dates":[{"date":"2026-02-24T08:14:24Z","dateType":"Submitted","dateInformation":"v1"},{"date":"2026-02-25T01:30:53Z","dateType":"Updated","dateInformation":"v1"},{"date":"2026-02","dateType":"Available","dateInformation":"v1"},{"date":"2026","dateType":"Issued"}],"language":null,"types":{"schemaOrg":"CreativeWork","resourceTypeGeneral":"Preprint","citeproc":"article","bibtex":"misc","ris":"GEN","resourceType":"Article"},"relatedIdentifiers":[],"relatedItems":[],"sizes":[],"formats":[],"version":"1","rightsList":[{"rightsUri":"http://arxiv.org/licenses/nonexclusive-distrib/1.0/","rights":"arXiv.org perpetual, non-exclusive license"}],"descriptions":[{"descriptionType":"Abstract","description":"Custom Storyboard Generation (CSG) aims to produce high-quality, multi-character consistent storytelling. Current approaches based on static diffusion models, whether used in a one-shot manner or within multi-agent frameworks, face three key limitations: (1) Static models lack dynamic expressiveness and often resort to \"copy-paste\" pattern. (2) One-shot inference cannot iteratively correct missing attributes or poor prompt adherence. (3) Multi-agents rely on non-robust evaluators, ill-suited for assessing stylized, non-realistic animation. To address these, we propose AnimeAgent, the first Image-to-Video (I2V)-based multi-agent framework for CSG. Inspired by Disney's \"Combination of Straight Ahead and Pose to Pose\" workflow, AnimeAgent leverages I2V's implicit motion prior to enhance consistency and expressiveness, while a mixed subjective-objective reviewer enables reliable iterative refinement. We also collect a human-annotated CSG benchmark with ground-truth. Experiments show AnimeAgent achieves SOTA performance in consistency, prompt fidelity, and stylization."},{"descriptionType":"Other","description":"Tech Report"}],"geoLocations":[],"fundingReferences":[],"url":"https://arxiv.org/abs/2602.20664","contentUrl":null,"metadataVersion":0,"schemaVersion":"http://datacite.org/schema/kernel-4","source":"mds","isActive":true,"state":"findable","reason":null,"viewCount":0,"downloadCount":0,"referenceCount":0,"citationCount":0,"partCount":0,"partOfCount":0,"versionCount":0,"versionOfCount":0,"created":"2026-02-25T02:55:37Z","registered":"2026-02-25T02:55:37Z","published":null,"updated":"2026-02-25T02:55:37Z"},"relationships":{"client":{"data":{"id":"arxiv.content","type":"clients"}}}},{"id":"10.48550/arxiv.2602.20663","type":"dois","attributes":{"doi":"10.48550/arxiv.2602.20663","identifiers":[{"identifier":"2602.20663","identifierType":"arXiv"}],"creators":[{"nameType":"Personal","givenName":"Michail","familyName":"Takaronis","name":"Takaronis, Michail","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Athanasia","familyName":"Kollarou","name":"Kollarou, Athanasia","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Vyron","familyName":"Kampourakis","name":"Kampourakis, Vyron","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Vasileios","familyName":"Gkioulos","name":"Gkioulos, Vasileios","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Sokratis","familyName":"Katsikas","name":"Katsikas, Sokratis","affiliation":[],"nameIdentifiers":[]}],"titles":[{"title":"ICSSPulse: A Modular LLM-Assisted Platform for Industrial Control System Penetration Testing"}],"publisher":"arXiv","container":{},"publicationYear":2026,"subjects":[{"subject":"Cryptography and Security (cs.CR)","lang":"en","subjectScheme":"arXiv"},{"subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"},{"schemeUri":"http://www.oecd.org/science/inno/38235147.pdf","subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"}],"contributors":[],"dates":[{"date":"2026-02-24T08:10:40Z","dateType":"Submitted","dateInformation":"v1"},{"date":"2026-02-25T01:30:42Z","dateType":"Updated","dateInformation":"v1"},{"date":"2026-02","dateType":"Available","dateInformation":"v1"},{"date":"2026","dateType":"Issued"}],"language":null,"types":{"schemaOrg":"CreativeWork","resourceTypeGeneral":"Preprint","citeproc":"article","bibtex":"misc","ris":"GEN","resourceType":"Article"},"relatedIdentifiers":[],"relatedItems":[],"sizes":[],"formats":[],"version":"1","rightsList":[{"rightsIdentifierScheme":"SPDX","rightsUri":"https://creativecommons.org/licenses/by/4.0/legalcode","schemeUri":"https://spdx.org/licenses/","rights":"Creative Commons Attribution 4.0 International","rightsIdentifier":"cc-by-4.0"}],"descriptions":[{"descriptionType":"Abstract","description":"It is well established that industrial control systems comprise the operational backbone of modern critical infrastructures, yet their increasing connectivity exposes them to cyber threats that are difficult to study and remedy safely under real-time operational conditions. In this paper, we present ICSSPulse, an open-source, modular, and extensible penetration testing platform designed for the security assessment of ICS communication protocols. To the best of our knowledge, ICSSPulse is the first web-based platform that unifies network scanning, protocol-aware Modbus and OPC~UA interaction, and Large Language Model (LLM)-assisted reporting within a single, lightweight ecosystem. Our platform provides a user-friendly graphical interface that orchestrates enumeration, exploitation, and reporting activities over simulated industrial services, enabling safe and reproducible experimentation. It supports protocol-level discovery, asset enumeration, and controlled read/write interactions, while preserving protocol fidelity and operational transparency. Experimental evaluation using synthetic Modbus test servers, a Factory I/O water treatment scenario, and a custom OPC~UA production-line model demonstrated ICSSPulse's potential to discover active industrial services, enumerate process-relevant assets, and manipulate process variables. A key contribution of this work lies in the integration of an LLM-assisted reporting module that automatically translates technical findings into structured executive and technical reports, with mitigation guidance informed by the ICS MITRE ATT\u0026amp;CK ICS matrix."}],"geoLocations":[],"fundingReferences":[],"url":"https://arxiv.org/abs/2602.20663","contentUrl":null,"metadataVersion":0,"schemaVersion":"http://datacite.org/schema/kernel-4","source":"mds","isActive":true,"state":"findable","reason":null,"viewCount":0,"downloadCount":0,"referenceCount":0,"citationCount":0,"partCount":0,"partOfCount":0,"versionCount":0,"versionOfCount":0,"created":"2026-02-25T02:55:35Z","registered":"2026-02-25T02:55:36Z","published":null,"updated":"2026-02-25T02:55:36Z"},"relationships":{"client":{"data":{"id":"arxiv.content","type":"clients"}}}},{"id":"10.48550/arxiv.2602.20662","type":"dois","attributes":{"doi":"10.48550/arxiv.2602.20662","identifiers":[{"identifier":"2602.20662","identifierType":"arXiv"}],"creators":[{"nameType":"Personal","givenName":"Hongyi","familyName":"Guan","name":"Guan, Hongyi","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Yijia","familyName":"Zhang","name":"Zhang, Yijia","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Wenqiang","familyName":"Wang","name":"Wang, Wenqiang","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Yizhao","familyName":"Gao","name":"Gao, Yizhao","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Shijie","familyName":"Cao","name":"Cao, Shijie","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Chen","familyName":"Zhang","name":"Zhang, Chen","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Ningyi","familyName":"Xu","name":"Xu, Ningyi","affiliation":[],"nameIdentifiers":[]}],"titles":[{"title":"TOM: A Ternary Read-only Memory Accelerator for LLM-powered Edge Intelligence"}],"publisher":"arXiv","container":{},"publicationYear":2026,"subjects":[{"subject":"Hardware Architecture (cs.AR)","lang":"en","subjectScheme":"arXiv"},{"subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"},{"schemeUri":"http://www.oecd.org/science/inno/38235147.pdf","subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"},{"subject":"B.7.1","lang":"en","subjectScheme":"ACM"}],"contributors":[],"dates":[{"date":"2026-02-24T08:08:41Z","dateType":"Submitted","dateInformation":"v1"},{"date":"2026-02-25T01:30:38Z","dateType":"Updated","dateInformation":"v1"},{"date":"2026-02","dateType":"Available","dateInformation":"v1"},{"date":"2026","dateType":"Issued"}],"language":null,"types":{"schemaOrg":"CreativeWork","resourceTypeGeneral":"Preprint","citeproc":"article","bibtex":"misc","ris":"GEN","resourceType":"Article"},"relatedIdentifiers":[],"relatedItems":[],"sizes":[],"formats":[],"version":"1","rightsList":[{"rightsUri":"http://arxiv.org/licenses/nonexclusive-distrib/1.0/","rights":"arXiv.org perpetual, non-exclusive license"}],"descriptions":[{"descriptionType":"Abstract","description":"The deployment of Large Language Models (LLMs) for real-time intelligence on edge devices is rapidly growing. However, conventional hardware architectures face a fundamental memory wall challenge, where limited on-device memory capacity and bandwidth severely constrain the size of deployable models and their inference speed, while also limiting on-device adaptation. To address this challenge, we propose TOM, a hybrid ROM-SRAM accelerator co-designed with ternary quantization, which balances extreme density with on-device tunability. TOM exploits the synergy between ternary quantization and ROM to achieve extreme memory density and bandwidth, while preserving flexibility through a hybrid ROM-SRAM architecture designed for QLoRA-based tunability. Specifically, we introduce: (1) a sparsity-aware ROM architecture that synthesizes ternary weights as standard-cell logic, eliminating area overhead from zero-valued bits; (2) a distributed processing architecture that co-locates high-density ROM banks with flexible SRAM-based QLoRA adapters and compute units; and (3) a workload-aware dynamic power gating scheme that exploits the logic-based nature of ROM to power down inactive banks, minimizing dynamic energy consumption. TOM achieves an inference throughput of 3,306 TPS using BitNet-2B model, demonstrating its effectiveness in delivering real-time, energy-efficient edge intelligence."},{"descriptionType":"Other","description":"13 pages"}],"geoLocations":[],"fundingReferences":[],"url":"https://arxiv.org/abs/2602.20662","contentUrl":null,"metadataVersion":0,"schemaVersion":"http://datacite.org/schema/kernel-4","source":"mds","isActive":true,"state":"findable","reason":null,"viewCount":0,"downloadCount":0,"referenceCount":0,"citationCount":0,"partCount":0,"partOfCount":0,"versionCount":0,"versionOfCount":0,"created":"2026-02-25T02:55:34Z","registered":"2026-02-25T02:55:34Z","published":null,"updated":"2026-02-25T02:55:34Z"},"relationships":{"client":{"data":{"id":"arxiv.content","type":"clients"}}}},{"id":"10.48550/arxiv.2602.20661","type":"dois","attributes":{"doi":"10.48550/arxiv.2602.20661","identifiers":[{"identifier":"2602.20661","identifierType":"arXiv"}],"creators":[{"nameType":"Personal","givenName":"Luca","familyName":"Spagnoli","name":"Spagnoli, Luca","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Alessandro","familyName":"Roggero","name":"Roggero, Alessandro","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Nathan","familyName":"Wiebe","name":"Wiebe, Nathan","affiliation":[],"nameIdentifiers":[]}],"titles":[{"title":"Qudit stabiliser codes for $\\mathbb{Z}_N$ lattice gauge theories with matter"}],"publisher":"arXiv","container":{},"publicationYear":2026,"subjects":[{"subject":"Quantum Physics (quant-ph)","lang":"en","subjectScheme":"arXiv"},{"subject":"FOS: Physical sciences","subjectScheme":"Fields of Science and Technology (FOS)"},{"schemeUri":"http://www.oecd.org/science/inno/38235147.pdf","subject":"FOS: Physical sciences","subjectScheme":"Fields of Science and Technology (FOS)"}],"contributors":[],"dates":[{"date":"2026-02-24T08:07:05Z","dateType":"Submitted","dateInformation":"v1"},{"date":"2026-02-25T01:30:37Z","dateType":"Updated","dateInformation":"v1"},{"date":"2026-02","dateType":"Available","dateInformation":"v1"},{"date":"2026","dateType":"Issued"}],"language":null,"types":{"schemaOrg":"CreativeWork","resourceTypeGeneral":"Preprint","citeproc":"article","bibtex":"misc","ris":"GEN","resourceType":"Article"},"relatedIdentifiers":[],"relatedItems":[],"sizes":[],"formats":[],"version":"1","rightsList":[{"rightsIdentifierScheme":"SPDX","rightsUri":"https://creativecommons.org/licenses/by/4.0/legalcode","schemeUri":"https://spdx.org/licenses/","rights":"Creative Commons Attribution 4.0 International","rightsIdentifier":"cc-by-4.0"}],"descriptions":[{"descriptionType":"Abstract","description":"In this work we extend the connection between Quantum Error Correction (QEC) and Lattice Gauge Theories (LGTs) by showing that a $\\mathbb{Z}_N$ gauge theory with prime dimension $N$ coupled to dynamical matter can be expressed as a qudit stabilizer code. Using the stabilizer formalism we show how to formulate an exact mapping of the encoded $\\mathbb{Z}_N$ gauge theory onto two different bosonic models, uncovering a logical duality generated by error correction itself. From this perspective, quantum error correction provides a unifying language to expose dual descriptions of lattice gauge theories. In addition, we generalize earlier $\\mathbb{Z}_2$ constructions on qubits to $\\mathbb{Z}_N$ on $N$-level qudits and demonstrate how universal fault-tolerant gates can be implemented via state injection between compatible qudit codes."}],"geoLocations":[],"fundingReferences":[],"url":"https://arxiv.org/abs/2602.20661","contentUrl":null,"metadataVersion":0,"schemaVersion":"http://datacite.org/schema/kernel-4","source":"mds","isActive":true,"state":"findable","reason":null,"viewCount":0,"downloadCount":0,"referenceCount":0,"citationCount":0,"partCount":0,"partOfCount":0,"versionCount":0,"versionOfCount":0,"created":"2026-02-25T02:55:32Z","registered":"2026-02-25T02:55:33Z","published":null,"updated":"2026-02-25T02:55:33Z"},"relationships":{"client":{"data":{"id":"arxiv.content","type":"clients"}}}},{"id":"10.48550/arxiv.2602.20660","type":"dois","attributes":{"doi":"10.48550/arxiv.2602.20660","identifiers":[{"identifier":"2602.20660","identifierType":"arXiv"}],"creators":[{"nameType":"Personal","givenName":"N. D.","familyName":"Dizon","name":"Dizon, N. D.","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Q. Y.","familyName":"Huang","name":"Huang, Q. Y.","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"T. D.","familyName":"Chuong","name":"Chuong, T. D.","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"G.","familyName":"Li","name":"Li, G.","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"V.","familyName":"Jeyakumar","name":"Jeyakumar, V.","affiliation":[],"nameIdentifiers":[]}],"titles":[{"title":"Convergent Lifted Lasserre Hierarchy of SDPs for Minimizing Expectation of Piecewise Polynomial Loss over Wasserstein Balls"}],"publisher":"arXiv","container":{},"publicationYear":2026,"subjects":[{"subject":"Optimization and Control (math.OC)","lang":"en","subjectScheme":"arXiv"},{"subject":"FOS: Mathematics","subjectScheme":"Fields of Science and Technology (FOS)"},{"schemeUri":"http://www.oecd.org/science/inno/38235147.pdf","subject":"FOS: Mathematics","subjectScheme":"Fields of Science and Technology (FOS)"}],"contributors":[],"dates":[{"date":"2026-02-24T08:03:13Z","dateType":"Submitted","dateInformation":"v1"},{"date":"2026-02-25T01:30:29Z","dateType":"Updated","dateInformation":"v1"},{"date":"2026-02","dateType":"Available","dateInformation":"v1"},{"date":"2026","dateType":"Issued"}],"language":null,"types":{"schemaOrg":"CreativeWork","resourceTypeGeneral":"Preprint","citeproc":"article","bibtex":"misc","ris":"GEN","resourceType":"Article"},"relatedIdentifiers":[],"relatedItems":[],"sizes":[],"formats":[],"version":"1","rightsList":[{"rightsUri":"http://arxiv.org/licenses/nonexclusive-distrib/1.0/","rights":"arXiv.org perpetual, non-exclusive license"}],"descriptions":[{"descriptionType":"Abstract","description":"This paper investigates the minimization of the expectation of piecewise polynomial loss functions over Wasserstein balls. This optimization problem often appears as a key sub-problem of distributionally robust optimization problems. We establish the asymptotic convergence of a hierarchy of semi-definite programming (SDP) relaxations, providing a framework for approximating the optimal values of these inherently infinite-dimensional optimization problems. A central foundational contribution is the development of a new lifted positivity certificate: we demonstrate that piecewise polynomials positive over Archimedean basic semi-algebraic sets admit a structured system of sum-of-squares (SOS) representations. Furthermore, we prove that the proposed hierarchy achieves finite convergence under suitable conditions when the defining polynomials are convex. The practical utility and versatility of this approach are demonstrated via numerical experiments in revenue estimation and portfolio optimization."}],"geoLocations":[],"fundingReferences":[],"url":"https://arxiv.org/abs/2602.20660","contentUrl":null,"metadataVersion":0,"schemaVersion":"http://datacite.org/schema/kernel-4","source":"mds","isActive":true,"state":"findable","reason":null,"viewCount":0,"downloadCount":0,"referenceCount":0,"citationCount":0,"partCount":0,"partOfCount":0,"versionCount":0,"versionOfCount":0,"created":"2026-02-25T02:55:31Z","registered":"2026-02-25T02:55:31Z","published":null,"updated":"2026-02-25T02:55:31Z"},"relationships":{"client":{"data":{"id":"arxiv.content","type":"clients"}}}},{"id":"10.48550/arxiv.2602.20658","type":"dois","attributes":{"doi":"10.48550/arxiv.2602.20658","identifiers":[{"identifier":"2602.20658","identifierType":"arXiv"}],"creators":[{"nameType":"Personal","givenName":"Mohammad Sadra","familyName":"Rajabi","name":"Rajabi, Mohammad Sadra","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Aanuoluwapo","familyName":"Ojelade","name":"Ojelade, Aanuoluwapo","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Sunwook","familyName":"Kim","name":"Kim, Sunwook","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Maury A.","familyName":"Nussbaum","name":"Nussbaum, Maury A.","affiliation":[],"nameIdentifiers":[]}],"titles":[{"title":"Vision-Language Models for Ergonomic Assessment of Manual Lifting Tasks: Estimating Horizontal and Vertical Hand Distances from RGB Video"}],"publisher":"arXiv","container":{},"publicationYear":2026,"subjects":[{"subject":"Computer Vision and Pattern Recognition (cs.CV)","lang":"en","subjectScheme":"arXiv"},{"subject":"Artificial Intelligence (cs.AI)","lang":"en","subjectScheme":"arXiv"},{"subject":"Human-Computer Interaction (cs.HC)","lang":"en","subjectScheme":"arXiv"},{"subject":"Machine Learning (cs.LG)","lang":"en","subjectScheme":"arXiv"},{"subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"},{"schemeUri":"http://www.oecd.org/science/inno/38235147.pdf","subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"}],"contributors":[],"dates":[{"date":"2026-02-24T08:01:49Z","dateType":"Submitted","dateInformation":"v1"},{"date":"2026-02-25T01:30:25Z","dateType":"Updated","dateInformation":"v1"},{"date":"2026-02","dateType":"Available","dateInformation":"v1"},{"date":"2026","dateType":"Issued"}],"language":null,"types":{"schemaOrg":"CreativeWork","resourceTypeGeneral":"Preprint","citeproc":"article","bibtex":"misc","ris":"GEN","resourceType":"Article"},"relatedIdentifiers":[],"relatedItems":[],"sizes":[],"formats":[],"version":"1","rightsList":[{"rightsUri":"http://arxiv.org/licenses/nonexclusive-distrib/1.0/","rights":"arXiv.org perpetual, non-exclusive license"}],"descriptions":[{"descriptionType":"Abstract","description":"Manual lifting tasks are a major contributor to work-related musculoskeletal disorders, and effective ergonomic risk assessment is essential for quantifying physical exposure and informing ergonomic interventions. The Revised NIOSH Lifting Equation (RNLE) is a widely used ergonomic risk assessment tool for lifting tasks that relies on six task variables, including horizontal (H) and vertical (V) hand distances; such distances are typically obtained through manual measurement or specialized sensing systems and are difficult to use in real-world environments. We evaluated the feasibility of using innovative vision-language models (VLMs) to non-invasively estimate H and V from RGB video streams. Two multi-stage VLM-based pipelines were developed: a text-guided detection-only pipeline and a detection-plus-segmentation pipeline. Both pipelines used text-guided localization of task-relevant regions of interest, visual feature extraction from those regions, and transformer-based temporal regression to estimate H and V at the start and end of a lift. For a range of lifting tasks, estimation performance was evaluated using leave-one-subject-out validation across the two pipelines and seven camera view conditions. Results varied significantly across pipelines and camera view conditions, with the segmentation-based, multi-view pipeline consistently yielding the smallest errors, achieving mean absolute errors of approximately 6-8 cm when estimating H and 5-8 cm when estimating V. Across pipelines and camera view configurations, pixel-level segmentation reduced estimation error by approximately 20-30% for H and 35-40% for V relative to the detection-only pipeline. These findings support the feasibility of VLM-based pipelines for video-based estimation of RNLE distance parameters."}],"geoLocations":[],"fundingReferences":[],"url":"https://arxiv.org/abs/2602.20658","contentUrl":null,"metadataVersion":0,"schemaVersion":"http://datacite.org/schema/kernel-4","source":"mds","isActive":true,"state":"findable","reason":null,"viewCount":0,"downloadCount":0,"referenceCount":0,"citationCount":0,"partCount":0,"partOfCount":0,"versionCount":0,"versionOfCount":0,"created":"2026-02-25T02:55:28Z","registered":"2026-02-25T02:55:28Z","published":null,"updated":"2026-02-25T02:55:28Z"},"relationships":{"client":{"data":{"id":"arxiv.content","type":"clients"}}}},{"id":"10.48550/arxiv.2602.20657","type":"dois","attributes":{"doi":"10.48550/arxiv.2602.20657","identifiers":[{"identifier":"2602.20657","identifierType":"arXiv"}],"creators":[{"nameType":"Personal","givenName":"Shahzad","familyName":"Ahmad","name":"Ahmad, Shahzad","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Stefan","familyName":"Rass","name":"Rass, Stefan","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Zahra","familyName":"Seyedi","name":"Seyedi, Zahra","affiliation":[],"nameIdentifiers":[]}],"titles":[{"title":"Post-Quantum Sanitizable Signatures from McEliece-Based Chameleon Hashing"}],"publisher":"arXiv","container":{},"publicationYear":2026,"subjects":[{"subject":"Cryptography and Security (cs.CR)","lang":"en","subjectScheme":"arXiv"},{"subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"},{"schemeUri":"http://www.oecd.org/science/inno/38235147.pdf","subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"}],"contributors":[],"dates":[{"date":"2026-02-24T08:01:20Z","dateType":"Submitted","dateInformation":"v1"},{"date":"2026-02-25T01:30:23Z","dateType":"Updated","dateInformation":"v1"},{"date":"2026-02","dateType":"Available","dateInformation":"v1"},{"date":"2026","dateType":"Issued"}],"language":null,"types":{"schemaOrg":"CreativeWork","resourceTypeGeneral":"Preprint","citeproc":"article","bibtex":"misc","ris":"GEN","resourceType":"Article"},"relatedIdentifiers":[],"relatedItems":[],"sizes":[],"formats":[],"version":"1","rightsList":[{"rightsIdentifierScheme":"SPDX","rightsUri":"https://creativecommons.org/licenses/by/4.0/legalcode","schemeUri":"https://spdx.org/licenses/","rights":"Creative Commons Attribution 4.0 International","rightsIdentifier":"cc-by-4.0"}],"descriptions":[{"descriptionType":"Abstract","description":"We introduce a novel post-quantum sanitizable signature scheme constructed upon a chameleon hash function derived from the McEliece cryptosystem. In this design, the designated sanitizer possesses the inherent trapdoor of a Goppa code, which facilitates controlled collision-finding via Patterson decoding. This mechanism enables authorized modification of specific message blocks while ensuring all other content remains immutably bound. We provide formal security definitions and rigorous proofs of existential unforgeability and immutability, grounded in the hardness of syndrome decoding in the random-oracle model, where a robust random oracle thwarts trivial linear hash collisions. A key innovation lies in our precise characterization of the transparency property: by imposing a specific weight constraint on the randomizers generated by the signer, we achieve perfect transparency, rendering sanitized signatures indistinguishable from freshly signed ones. This work establishes the first transparent, code-based, post-quantum sanitizable signature scheme, offering strong theoretical guarantees and a pathway for practical deployment in long-term secure applications."},{"descriptionType":"Other","description":"19 pages"}],"geoLocations":[],"fundingReferences":[],"url":"https://arxiv.org/abs/2602.20657","contentUrl":null,"metadataVersion":0,"schemaVersion":"http://datacite.org/schema/kernel-4","source":"mds","isActive":true,"state":"findable","reason":null,"viewCount":0,"downloadCount":0,"referenceCount":0,"citationCount":0,"partCount":0,"partOfCount":0,"versionCount":0,"versionOfCount":0,"created":"2026-02-25T02:55:26Z","registered":"2026-02-25T02:55:27Z","published":null,"updated":"2026-02-25T02:55:27Z"},"relationships":{"client":{"data":{"id":"arxiv.content","type":"clients"}}}},{"id":"10.48550/arxiv.2602.20656","type":"dois","attributes":{"doi":"10.48550/arxiv.2602.20656","identifiers":[{"identifier":"2602.20656","identifierType":"arXiv"}],"creators":[{"nameType":"Personal","givenName":"Guanbin","familyName":"Xu","name":"Xu, Guanbin","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"ZhenGuo","familyName":"Xu","name":"Xu, ZhenGuo","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Yuzhe","familyName":"Li","name":"Li, Yuzhe","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Youhui","familyName":"Bai","name":"Bai, Youhui","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Ping","familyName":"Gong","name":"Gong, Ping","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Chaoyi","familyName":"Ruan","name":"Ruan, Chaoyi","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Cheng","familyName":"Li","name":"Li, Cheng","affiliation":[],"nameIdentifiers":[]}],"titles":[{"title":"Lagom: Unleashing the Power of Communication and Computation Overlapping for Distributed LLM Training"}],"publisher":"arXiv","container":{},"publicationYear":2026,"subjects":[{"subject":"Distributed, Parallel, and Cluster Computing (cs.DC)","lang":"en","subjectScheme":"arXiv"},{"subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"},{"schemeUri":"http://www.oecd.org/science/inno/38235147.pdf","subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"}],"contributors":[],"dates":[{"date":"2026-02-24T08:00:38Z","dateType":"Submitted","dateInformation":"v1"},{"date":"2026-02-25T01:30:22Z","dateType":"Updated","dateInformation":"v1"},{"date":"2026-02","dateType":"Available","dateInformation":"v1"},{"date":"2026","dateType":"Issued"}],"language":null,"types":{"schemaOrg":"CreativeWork","resourceTypeGeneral":"Preprint","citeproc":"article","bibtex":"misc","ris":"GEN","resourceType":"Article"},"relatedIdentifiers":[],"relatedItems":[],"sizes":[],"formats":[],"version":"1","rightsList":[{"rightsIdentifierScheme":"SPDX","rightsUri":"https://creativecommons.org/licenses/by/4.0/legalcode","schemeUri":"https://spdx.org/licenses/","rights":"Creative Commons Attribution 4.0 International","rightsIdentifier":"cc-by-4.0"}],"descriptions":[{"descriptionType":"Abstract","description":"Overlapping communication with computation is crucial for distributed large-model training, yet optimizing it - especially when computation becomes the bottleneck-remains challenging. We present Lagom, a system that co-tunes communication parameters to balance resource usage between computation and communication. By introducing a unified cost model and a priority-based search algorithm, Lagom reduces optimization complexity from exponential to linear. Evaluations on high- and low-bandwidth GPU clusters show that Lagom achieves 1.07-1.33x and 1.03-1.27x speedup over NCCL and AutoCCL across diverse models and parallelizations."},{"descriptionType":"Other","description":"6 pages, 8 figures"}],"geoLocations":[],"fundingReferences":[],"url":"https://arxiv.org/abs/2602.20656","contentUrl":null,"metadataVersion":0,"schemaVersion":"http://datacite.org/schema/kernel-4","source":"mds","isActive":true,"state":"findable","reason":null,"viewCount":0,"downloadCount":0,"referenceCount":0,"citationCount":0,"partCount":0,"partOfCount":0,"versionCount":0,"versionOfCount":0,"created":"2026-02-25T02:55:25Z","registered":"2026-02-25T02:55:26Z","published":null,"updated":"2026-02-25T02:55:26Z"},"relationships":{"client":{"data":{"id":"arxiv.content","type":"clients"}}}},{"id":"10.48550/arxiv.2602.20655","type":"dois","attributes":{"doi":"10.48550/arxiv.2602.20655","identifiers":[{"identifier":"2602.20655","identifierType":"arXiv"}],"creators":[{"nameType":"Personal","givenName":"Wan Yee","familyName":"Yau","name":"Yau, Wan Yee","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Carl D.","familyName":"Modes","name":"Modes, Carl D.","affiliation":[],"nameIdentifiers":[]}],"titles":[{"title":"Programming Shapes with Competing Layered Patterns"}],"publisher":"arXiv","container":{},"publicationYear":2026,"subjects":[{"subject":"Biological Physics (physics.bio-ph)","lang":"en","subjectScheme":"arXiv"},{"subject":"Soft Condensed Matter (cond-mat.soft)","lang":"en","subjectScheme":"arXiv"},{"subject":"FOS: Physical sciences","subjectScheme":"Fields of Science and Technology (FOS)"},{"schemeUri":"http://www.oecd.org/science/inno/38235147.pdf","subject":"FOS: Physical sciences","subjectScheme":"Fields of Science and Technology (FOS)"}],"contributors":[],"dates":[{"date":"2026-02-24T07:59:18Z","dateType":"Submitted","dateInformation":"v1"},{"date":"2026-02-25T01:30:09Z","dateType":"Updated","dateInformation":"v1"},{"date":"2026-02","dateType":"Available","dateInformation":"v1"},{"date":"2026","dateType":"Issued"}],"language":null,"types":{"schemaOrg":"CreativeWork","resourceTypeGeneral":"Preprint","citeproc":"article","bibtex":"misc","ris":"GEN","resourceType":"Article"},"relatedIdentifiers":[],"relatedItems":[],"sizes":[],"formats":[],"version":"1","rightsList":[{"rightsUri":"http://arxiv.org/licenses/nonexclusive-distrib/1.0/","rights":"arXiv.org perpetual, non-exclusive license"}],"descriptions":[{"descriptionType":"Abstract","description":"Studying shape changing thick surfaces induced by differential growth helps us understand morphogenesis in biology and offers opportunities for device design. While ideal 2D differential growth maps have been well studied for both isotropic and anisotropic growth, scenarios involving gradients in thickness growth are far less explored. In this paper, we focus on a bilayer system in which the two layers undergo independent but incompatible growth. We examine how the strength of the growth patterns and the aspect ratio of the bilayer influence the resulting shapes. We first investigate the effect of global area difference in the bilayer. Next, we make one of the two layers active and program it with positive or negative, localized or uniform curvature. We then present examples involving competition between two active surfaces with opposite curvature signs or different curvature distributions and understand how the final configurations follow from the principles identified earlier. Finally, we demonstrate the ability to program biologically inspired shapes, such as dental epithelium and the ventral furrow in Drosophila, using a bilayer with simple, distinct deformation gradients."}],"geoLocations":[],"fundingReferences":[],"url":"https://arxiv.org/abs/2602.20655","contentUrl":null,"metadataVersion":0,"schemaVersion":"http://datacite.org/schema/kernel-4","source":"mds","isActive":true,"state":"findable","reason":null,"viewCount":0,"downloadCount":0,"referenceCount":0,"citationCount":0,"partCount":0,"partOfCount":0,"versionCount":0,"versionOfCount":0,"created":"2026-02-25T02:55:24Z","registered":"2026-02-25T02:55:24Z","published":null,"updated":"2026-02-25T02:55:24Z"},"relationships":{"client":{"data":{"id":"arxiv.content","type":"clients"}}}},{"id":"10.48550/arxiv.2602.20653","type":"dois","attributes":{"doi":"10.48550/arxiv.2602.20653","identifiers":[{"identifier":"2602.20653","identifierType":"arXiv"}],"creators":[{"nameType":"Personal","givenName":"Xiaokai","familyName":"Bai","name":"Bai, Xiaokai","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Jiahao","familyName":"Cheng","name":"Cheng, Jiahao","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Songkai","familyName":"Wang","name":"Wang, Songkai","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Yixuan","familyName":"Luo","name":"Luo, Yixuan","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Lianqing","familyName":"Zheng","name":"Zheng, Lianqing","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Xiaohan","familyName":"Zhang","name":"Zhang, Xiaohan","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Si-Yuan","familyName":"Cao","name":"Cao, Si-Yuan","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Hui-Liang","familyName":"Shen","name":"Shen, Hui-Liang","affiliation":[],"nameIdentifiers":[]}],"titles":[{"title":"SD4R: Sparse-to-Dense Learning for 3D Object Detection with 4D Radar"}],"publisher":"arXiv","container":{},"publicationYear":2026,"subjects":[{"subject":"Computer Vision and Pattern Recognition (cs.CV)","lang":"en","subjectScheme":"arXiv"},{"subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"},{"schemeUri":"http://www.oecd.org/science/inno/38235147.pdf","subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"}],"contributors":[],"dates":[{"date":"2026-02-24T07:57:19Z","dateType":"Submitted","dateInformation":"v1"},{"date":"2026-02-25T01:30:03Z","dateType":"Updated","dateInformation":"v1"},{"date":"2026-02","dateType":"Available","dateInformation":"v1"},{"date":"2026","dateType":"Issued"}],"language":null,"types":{"schemaOrg":"CreativeWork","resourceTypeGeneral":"Preprint","citeproc":"article","bibtex":"misc","ris":"GEN","resourceType":"Article"},"relatedIdentifiers":[],"relatedItems":[],"sizes":[],"formats":[],"version":"1","rightsList":[{"rightsUri":"http://arxiv.org/licenses/nonexclusive-distrib/1.0/","rights":"arXiv.org perpetual, non-exclusive license"}],"descriptions":[{"descriptionType":"Abstract","description":"4D radar measurements offer an affordable and weather-robust solution for 3D perception. However, the inherent sparsity and noise of radar point clouds present significant challenges for accurate 3D object detection, underscoring the need for effective and robust point clouds densification. Despite recent progress, existing densification methods often fail to address the extreme sparsity of 4D radar point clouds and exhibit limited robustness when processing scenes with a small number of points. In this paper, we propose SD4R, a novel framework that transforms sparse radar point clouds into dense representations. SD4R begins by utilizing a foreground point generator (FPG) to mitigate noise propagation and produce densified point clouds. Subsequently, a logit-query encoder (LQE) enhances conventional pillarization, resulting in robust feature representations. Through these innovations, our SD4R demonstrates strong capability in both noise reduction and foreground point densification. Extensive experiments conducted on the publicly available View-of-Delft dataset demonstrate that SD4R achieves state-of-the-art performance. Source code is available at https://github.com/lancelot0805/SD4R."},{"descriptionType":"Other","description":"7 pages, 5 figures, 4 tables"}],"geoLocations":[],"fundingReferences":[],"url":"https://arxiv.org/abs/2602.20653","contentUrl":null,"metadataVersion":0,"schemaVersion":"http://datacite.org/schema/kernel-4","source":"mds","isActive":true,"state":"findable","reason":null,"viewCount":0,"downloadCount":0,"referenceCount":0,"citationCount":0,"partCount":0,"partOfCount":0,"versionCount":0,"versionOfCount":0,"created":"2026-02-25T02:55:21Z","registered":"2026-02-25T02:55:21Z","published":null,"updated":"2026-02-25T02:55:21Z"},"relationships":{"client":{"data":{"id":"arxiv.content","type":"clients"}}}},{"id":"10.48550/arxiv.2602.20652","type":"dois","attributes":{"doi":"10.48550/arxiv.2602.20652","identifiers":[{"identifier":"2602.20652","identifierType":"arXiv"}],"creators":[{"nameType":"Personal","givenName":"Brandon R.","familyName":"Feng","name":"Feng, Brandon R.","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Brian J.","familyName":"Reich","name":"Reich, Brian J.","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Daniel","familyName":"Beaglehole","name":"Beaglehole, Daniel","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Xihaier","familyName":"Luo","name":"Luo, Xihaier","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"David Keetae","familyName":"Park","name":"Park, David Keetae","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Shinjae","familyName":"Yoo","name":"Yoo, Shinjae","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Zhechao","familyName":"Huang","name":"Huang, Zhechao","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Xueyu","familyName":"Mao","name":"Mao, Xueyu","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Olcay","familyName":"Boz","name":"Boz, Olcay","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Jungeum","familyName":"Kim","name":"Kim, Jungeum","affiliation":[],"nameIdentifiers":[]}],"titles":[{"title":"DANCE: Doubly Adaptive Neighborhood Conformal Estimation"}],"publisher":"arXiv","container":{},"publicationYear":2026,"subjects":[{"subject":"Machine Learning (stat.ML)","lang":"en","subjectScheme":"arXiv"},{"subject":"Machine Learning (cs.LG)","lang":"en","subjectScheme":"arXiv"},{"subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"},{"schemeUri":"http://www.oecd.org/science/inno/38235147.pdf","subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"}],"contributors":[],"dates":[{"date":"2026-02-24T07:54:53Z","dateType":"Submitted","dateInformation":"v1"},{"date":"2026-02-25T01:29:57Z","dateType":"Updated","dateInformation":"v1"},{"date":"2026-02","dateType":"Available","dateInformation":"v1"},{"date":"2026","dateType":"Issued"}],"language":null,"types":{"schemaOrg":"CreativeWork","resourceTypeGeneral":"Preprint","citeproc":"article","bibtex":"misc","ris":"GEN","resourceType":"Article"},"relatedIdentifiers":[],"relatedItems":[],"sizes":[],"formats":[],"version":"1","rightsList":[{"rightsUri":"http://arxiv.org/licenses/nonexclusive-distrib/1.0/","rights":"arXiv.org perpetual, non-exclusive license"}],"descriptions":[{"descriptionType":"Abstract","description":"The recent developments of complex deep learning models have led to unprecedented ability to accurately predict across multiple data representation types. Conformal prediction for uncertainty quantification of these models has risen in popularity, providing adaptive, statistically-valid prediction sets. For classification tasks, conformal methods have typically focused on utilizing logit scores. For pre-trained models, however, this can result in inefficient, overly conservative set sizes when not calibrated towards the target task. We propose DANCE, a doubly locally adaptive nearest-neighbor based conformal algorithm combining two novel nonconformity scores directly using the data's embedded representation. DANCE first fits a task-adaptive kernel regression model from the embedding layer before using the learned kernel space to produce the final prediction sets for uncertainty quantification. We test against state-of-the-art local, task-adapted and zero-shot conformal baselines, demonstrating DANCE's superior blend of set size efficiency and robustness across various datasets."}],"geoLocations":[],"fundingReferences":[],"url":"https://arxiv.org/abs/2602.20652","contentUrl":null,"metadataVersion":0,"schemaVersion":"http://datacite.org/schema/kernel-4","source":"mds","isActive":true,"state":"findable","reason":null,"viewCount":0,"downloadCount":0,"referenceCount":0,"citationCount":0,"partCount":0,"partOfCount":0,"versionCount":0,"versionOfCount":0,"created":"2026-02-25T02:55:19Z","registered":"2026-02-25T02:55:20Z","published":null,"updated":"2026-02-25T02:55:20Z"},"relationships":{"client":{"data":{"id":"arxiv.content","type":"clients"}}}},{"id":"10.48550/arxiv.2602.20649","type":"dois","attributes":{"doi":"10.48550/arxiv.2602.20649","identifiers":[{"identifier":"2602.20649","identifierType":"arXiv"}],"creators":[{"nameType":"Personal","givenName":"Arnaud","familyName":"Bodin","name":"Bodin, Arnaud","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Christian","familyName":"Drouin","name":"Drouin, Christian","affiliation":[],"nameIdentifiers":[]}],"titles":[{"title":"Solutions of polynomial equations in several variables modulo a prime power"}],"publisher":"arXiv","container":{},"publicationYear":2026,"subjects":[{"subject":"Number Theory (math.NT)","lang":"en","subjectScheme":"arXiv"},{"subject":"Algebraic Geometry (math.AG)","lang":"en","subjectScheme":"arXiv"},{"subject":"FOS: Mathematics","subjectScheme":"Fields of Science and Technology (FOS)"},{"schemeUri":"http://www.oecd.org/science/inno/38235147.pdf","subject":"FOS: Mathematics","subjectScheme":"Fields of Science and Technology (FOS)"},{"subject":"11A07, 11D45, 11S05","lang":"en","subjectScheme":"MSC"}],"contributors":[],"dates":[{"date":"2026-02-24T07:53:53Z","dateType":"Submitted","dateInformation":"v1"},{"date":"2026-02-25T01:29:52Z","dateType":"Updated","dateInformation":"v1"},{"date":"2026-02","dateType":"Available","dateInformation":"v1"},{"date":"2026","dateType":"Issued"}],"language":null,"types":{"schemaOrg":"CreativeWork","resourceTypeGeneral":"Preprint","citeproc":"article","bibtex":"misc","ris":"GEN","resourceType":"Article"},"relatedIdentifiers":[],"relatedItems":[],"sizes":[],"formats":[],"version":"1","rightsList":[{"rightsUri":"http://arxiv.org/licenses/nonexclusive-distrib/1.0/","rights":"arXiv.org perpetual, non-exclusive license"}],"descriptions":[{"descriptionType":"Abstract","description":"We explain how to obtain the set of solutions of a multivariate polynomial equation modulo a power of a prime number. These solutions are determined by a tree, called the trunk, which makes it possible to reconstruct all solutions. We apply these methods to determine the number of solutions, without having to enumerate them. We also illustrate these techniques by proving a simple case of Igusa's theorem: the Poincaré series associated with a polynomial in two separated variables is rational."},{"descriptionType":"Other","description":"31 pages, appendix with an explicit example"}],"geoLocations":[],"fundingReferences":[],"url":"https://arxiv.org/abs/2602.20649","contentUrl":null,"metadataVersion":0,"schemaVersion":"http://datacite.org/schema/kernel-4","source":"mds","isActive":true,"state":"findable","reason":null,"viewCount":0,"downloadCount":0,"referenceCount":0,"citationCount":0,"partCount":0,"partOfCount":0,"versionCount":0,"versionOfCount":0,"created":"2026-02-25T02:55:15Z","registered":"2026-02-25T02:55:16Z","published":null,"updated":"2026-02-25T02:55:16Z"},"relationships":{"client":{"data":{"id":"arxiv.content","type":"clients"}}}},{"id":"10.48550/arxiv.2602.20648","type":"dois","attributes":{"doi":"10.48550/arxiv.2602.20648","identifiers":[{"identifier":"2602.20648","identifierType":"arXiv"}],"creators":[{"nameType":"Personal","givenName":"Anqi","familyName":"Li","name":"Li, Anqi","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Chenxiao","familyName":"Wang","name":"Wang, Chenxiao","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Yu","familyName":"Lu","name":"Lu, Yu","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Renjun","familyName":"Xu","name":"Xu, Renjun","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Lizhi","familyName":"Ma","name":"Ma, Lizhi","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Zhenzhong","familyName":"Lan","name":"Lan, Zhenzhong","affiliation":[],"nameIdentifiers":[]}],"titles":[{"title":"CARE: An Explainable Computational Framework for Assessing Client-Perceived Therapeutic Alliance Using Large Language Models"}],"publisher":"arXiv","container":{},"publicationYear":2026,"subjects":[{"subject":"Computation and Language (cs.CL)","lang":"en","subjectScheme":"arXiv"},{"subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"},{"schemeUri":"http://www.oecd.org/science/inno/38235147.pdf","subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"}],"contributors":[],"dates":[{"date":"2026-02-24T07:52:56Z","dateType":"Submitted","dateInformation":"v1"},{"date":"2026-02-25T01:29:47Z","dateType":"Updated","dateInformation":"v1"},{"date":"2026-02","dateType":"Available","dateInformation":"v1"},{"date":"2026","dateType":"Issued"}],"language":null,"types":{"schemaOrg":"CreativeWork","resourceTypeGeneral":"Preprint","citeproc":"article","bibtex":"misc","ris":"GEN","resourceType":"Article"},"relatedIdentifiers":[],"relatedItems":[],"sizes":[],"formats":[],"version":"1","rightsList":[{"rightsIdentifierScheme":"SPDX","rightsUri":"https://creativecommons.org/licenses/by/4.0/legalcode","schemeUri":"https://spdx.org/licenses/","rights":"Creative Commons Attribution 4.0 International","rightsIdentifier":"cc-by-4.0"}],"descriptions":[{"descriptionType":"Abstract","description":"Client perceptions of the therapeutic alliance are critical for counseling effectiveness. Accurately capturing these perceptions remains challenging, as traditional post-session questionnaires are burdensome and often delayed, while existing computational approaches produce coarse scores, lack interpretable rationales, and fail to model holistic session context. We present CARE, an LLM-based framework to automatically predict multi-dimensional alliance scores and generate interpretable rationales from counseling transcripts. Built on the CounselingWAI dataset and enriched with 9,516 expert-curated rationales, CARE is fine-tuned using rationale-augmented supervision with the LLaMA-3.1-8B-Instruct backbone. Experiments show that CARE outperforms leading LLMs and substantially reduces the gap between counselor evaluations and client-perceived alliance, achieving over 70% higher Pearson correlation with client ratings. Rationale-augmented supervision further improves predictive accuracy. CARE also produces high-quality, contextually grounded rationales, validated by both automatic and human evaluations. Applied to real-world Chinese online counseling sessions, CARE uncovers common alliance-building challenges, illustrates how interaction patterns shape alliance development, and provides actionable insights, demonstrating its potential as an AI-assisted tool for supporting mental health care."},{"descriptionType":"Other","description":"14 pages, 4 figures"}],"geoLocations":[],"fundingReferences":[],"url":"https://arxiv.org/abs/2602.20648","contentUrl":null,"metadataVersion":0,"schemaVersion":"http://datacite.org/schema/kernel-4","source":"mds","isActive":true,"state":"findable","reason":null,"viewCount":0,"downloadCount":0,"referenceCount":0,"citationCount":0,"partCount":0,"partOfCount":0,"versionCount":0,"versionOfCount":0,"created":"2026-02-25T02:55:13Z","registered":"2026-02-25T02:55:14Z","published":null,"updated":"2026-02-25T02:55:14Z"},"relationships":{"client":{"data":{"id":"arxiv.content","type":"clients"}}}},{"id":"10.48550/arxiv.2602.20647","type":"dois","attributes":{"doi":"10.48550/arxiv.2602.20647","identifiers":[{"identifier":"2602.20647","identifierType":"arXiv"}],"creators":[{"nameType":"Personal","givenName":"W. Frederick","familyName":"Zimmerman","name":"Zimmerman, W. Frederick","affiliation":[],"nameIdentifiers":[]}],"titles":[{"title":"Semantic Novelty at Scale: Narrative Shape Taxonomy and Readership Prediction in 28,606 Books"}],"publisher":"arXiv","container":{},"publicationYear":2026,"subjects":[{"subject":"Computation and Language (cs.CL)","lang":"en","subjectScheme":"arXiv"},{"subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"},{"schemeUri":"http://www.oecd.org/science/inno/38235147.pdf","subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"}],"contributors":[],"dates":[{"date":"2026-02-24T07:52:35Z","dateType":"Submitted","dateInformation":"v1"},{"date":"2026-02-25T01:29:46Z","dateType":"Updated","dateInformation":"v1"},{"date":"2026-02","dateType":"Available","dateInformation":"v1"},{"date":"2026","dateType":"Issued"}],"language":null,"types":{"schemaOrg":"CreativeWork","resourceTypeGeneral":"Preprint","citeproc":"article","bibtex":"misc","ris":"GEN","resourceType":"Article"},"relatedIdentifiers":[],"relatedItems":[],"sizes":[],"formats":[],"version":"1","rightsList":[{"rightsIdentifierScheme":"SPDX","rightsUri":"https://creativecommons.org/licenses/by-nc-sa/4.0/legalcode","schemeUri":"https://spdx.org/licenses/","rights":"Creative Commons Attribution Non Commercial Share Alike 4.0 International","rightsIdentifier":"cc-by-nc-sa-4.0"}],"descriptions":[{"descriptionType":"Abstract","description":"I introduce semantic novelty--cosine distance between each paragraph's sentence embedding and the running centroid of all preceding paragraphs--as an information-theoretic measure of narrative structure at corpus scale. Applying it to 28,606 books in PG19 (pre-1920 English literature), I compute paragraph-level novelty curves using 768-dimensional SBERT embeddings, then reduce each to a 16-segment Piecewise Aggregate Approximation (PAA). Ward-linkage clustering on PAA vectors reveals eight canonical narrative shape archetypes, from Steep Descent (rapid convergence) to Steep Ascent (escalating unpredictability). Volume--variance of the novelty trajectory--is the strongest length-independent predictor of readership (partial rho = 0.32), followed by speed (rho = 0.19) and Terminal/Initial ratio (rho = 0.19). Circuitousness shows strong raw correlation (rho = 0.41) but is 93 percent correlated with length; after control, partial rho drops to 0.11--demonstrating that naive correlations in corpus studies can be dominated by length confounds. Genre strongly constrains narrative shape (chi squared = 2121.6, p \u0026lt; 10 to the power negative 242), with fiction maintaining plateau profiles while nonfiction front-loads information. Historical analysis shows books became progressively more predictable between 1840 and 1910 (T/I ratio trend r = negative 0.74, p = 0.037). SAX analysis reveals 85 percent signature uniqueness, suggesting each book traces a nearly unique path through semantic space. These findings demonstrate that information-density dynamics, distinct from sentiment or topic, constitute a fundamental dimension of narrative structure with measurable consequences for reader engagement. Dataset: https://huggingface.co/datasets/wfzimmerman/pg19-semantic-novelty"},{"descriptionType":"Other","description":"six figures. dataset available at Hugging Face"}],"geoLocations":[],"fundingReferences":[],"url":"https://arxiv.org/abs/2602.20647","contentUrl":null,"metadataVersion":0,"schemaVersion":"http://datacite.org/schema/kernel-4","source":"mds","isActive":true,"state":"findable","reason":null,"viewCount":0,"downloadCount":0,"referenceCount":0,"citationCount":0,"partCount":0,"partOfCount":0,"versionCount":0,"versionOfCount":0,"created":"2026-02-25T02:55:12Z","registered":"2026-02-25T02:55:13Z","published":null,"updated":"2026-02-25T02:55:13Z"},"relationships":{"client":{"data":{"id":"arxiv.content","type":"clients"}}}},{"id":"10.48550/arxiv.2602.20646","type":"dois","attributes":{"doi":"10.48550/arxiv.2602.20646","identifiers":[{"identifier":"2602.20646","identifierType":"arXiv"}],"creators":[{"nameType":"Personal","givenName":"Boao","familyName":"Kong","name":"Kong, Boao","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Hengrui","familyName":"Zhang","name":"Zhang, Hengrui","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Kun","familyName":"Yuan","name":"Yuan, Kun","affiliation":[],"nameIdentifiers":[]}],"titles":[{"title":"On the Convergence of Stochastic Gradient Descent with Perturbed Forward-Backward Passes"}],"publisher":"arXiv","container":{},"publicationYear":2026,"subjects":[{"subject":"Optimization and Control (math.OC)","lang":"en","subjectScheme":"arXiv"},{"subject":"Machine Learning (cs.LG)","lang":"en","subjectScheme":"arXiv"},{"subject":"Machine Learning (stat.ML)","lang":"en","subjectScheme":"arXiv"},{"subject":"FOS: Mathematics","subjectScheme":"Fields of Science and Technology (FOS)"},{"schemeUri":"http://www.oecd.org/science/inno/38235147.pdf","subject":"FOS: Mathematics","subjectScheme":"Fields of Science and Technology (FOS)"},{"subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"},{"schemeUri":"http://www.oecd.org/science/inno/38235147.pdf","subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"}],"contributors":[],"dates":[{"date":"2026-02-24T07:47:15Z","dateType":"Submitted","dateInformation":"v1"},{"date":"2026-02-25T01:29:32Z","dateType":"Updated","dateInformation":"v1"},{"date":"2026-02","dateType":"Available","dateInformation":"v1"},{"date":"2026","dateType":"Issued"}],"language":null,"types":{"schemaOrg":"CreativeWork","resourceTypeGeneral":"Preprint","citeproc":"article","bibtex":"misc","ris":"GEN","resourceType":"Article"},"relatedIdentifiers":[],"relatedItems":[],"sizes":[],"formats":[],"version":"1","rightsList":[{"rightsIdentifierScheme":"SPDX","rightsUri":"https://creativecommons.org/licenses/by/4.0/legalcode","schemeUri":"https://spdx.org/licenses/","rights":"Creative Commons Attribution 4.0 International","rightsIdentifier":"cc-by-4.0"}],"descriptions":[{"descriptionType":"Abstract","description":"We study stochastic gradient descent (SGD) for composite optimization problems with $N$ sequential operators subject to perturbations in both the forward and backward passes. Unlike classical analyses that treat gradient noise as additive and localized, perturbations to intermediate outputs and gradients cascade through the computational graph, compounding geometrically with the number of operators. We present the first comprehensive theoretical analysis of this setting. Specifically, we characterize how forward and backward perturbations propagate and amplify within a single gradient step, derive convergence guarantees for both general non-convex objectives and functions satisfying the Polyak--Łojasiewicz condition, and identify conditions under which perturbations do not deteriorate the asymptotic convergence order. As a byproduct, our analysis furnishes a theoretical explanation for the gradient spiking phenomenon widely observed in deep learning, precisely characterizing the conditions under which training recovers from spikes or diverges. Experiments on logistic regression with convex and non-convex regularization validate our theories, illustrating the predicted spike behavior and the asymmetric sensitivity to forward versus backward perturbations."},{"descriptionType":"Other","description":"34 pages"}],"geoLocations":[],"fundingReferences":[],"url":"https://arxiv.org/abs/2602.20646","contentUrl":null,"metadataVersion":0,"schemaVersion":"http://datacite.org/schema/kernel-4","source":"mds","isActive":true,"state":"findable","reason":null,"viewCount":0,"downloadCount":0,"referenceCount":0,"citationCount":0,"partCount":0,"partOfCount":0,"versionCount":0,"versionOfCount":0,"created":"2026-02-25T02:55:11Z","registered":"2026-02-25T02:55:11Z","published":null,"updated":"2026-02-25T02:55:11Z"},"relationships":{"client":{"data":{"id":"arxiv.content","type":"clients"}}}},{"id":"10.48550/arxiv.2602.20645","type":"dois","attributes":{"doi":"10.48550/arxiv.2602.20645","identifiers":[{"identifier":"2602.20645","identifierType":"arXiv"}],"creators":[{"nameType":"Personal","givenName":"Keisuke","familyName":"Takeshita","name":"Takeshita, Keisuke","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Takahiro","familyName":"Yamazaki","name":"Yamazaki, Takahiro","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Tomohiro","familyName":"Ono","name":"Ono, Tomohiro","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Takashi","familyName":"Yamamoto","name":"Yamamoto, Takashi","affiliation":[],"nameIdentifiers":[]}],"titles":[{"title":"Robot Local Planner: A Periodic Sampling-Based Motion Planner with Minimal Waypoints for Home Environments"}],"publisher":"arXiv","container":{},"publicationYear":2026,"subjects":[{"subject":"Robotics (cs.RO)","lang":"en","subjectScheme":"arXiv"},{"subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"},{"schemeUri":"http://www.oecd.org/science/inno/38235147.pdf","subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"}],"contributors":[],"dates":[{"date":"2026-02-24T07:46:31Z","dateType":"Submitted","dateInformation":"v1"},{"date":"2026-02-25T01:29:30Z","dateType":"Updated","dateInformation":"v1"},{"date":"2026-02","dateType":"Available","dateInformation":"v1"},{"date":"2026","dateType":"Issued"}],"language":null,"types":{"schemaOrg":"CreativeWork","resourceTypeGeneral":"Preprint","citeproc":"article","bibtex":"misc","ris":"GEN","resourceType":"Article"},"relatedIdentifiers":[],"relatedItems":[],"sizes":[],"formats":[],"version":"1","rightsList":[{"rightsIdentifierScheme":"SPDX","rightsUri":"https://creativecommons.org/licenses/by-nc-nd/4.0/legalcode","schemeUri":"https://spdx.org/licenses/","rights":"Creative Commons Attribution Non Commercial No Derivatives 4.0 International","rightsIdentifier":"cc-by-nc-nd-4.0"}],"descriptions":[{"descriptionType":"Abstract","description":"The objective of this study is to enable fast and safe manipulation tasks in home environments. Specifically, we aim to develop a system that can recognize its surroundings and identify target objects while in motion, enabling it to plan and execute actions accordingly. We propose a periodic sampling-based whole-body trajectory planning method, called the \"Robot Local Planner (RLP).\" This method leverages unique features of home environments to enhance computational efficiency, motion optimality, and robustness against recognition and control errors, all while ensuring safety. The RLP minimizes computation time by planning with minimal waypoints and generating safe trajectories. Furthermore, overall motion optimality is improved by periodically executing trajectory planning to select more optimal motions. This approach incorporates inverse kinematics that are robust to base position errors, further enhancing robustness. Evaluation experiments demonstrated that the RLP outperformed existing methods in terms of motion planning time, motion duration, and robustness, confirming its effectiveness in home environments. Moreover, application experiments using a tidy-up task achieved high success rates and short operation times, thereby underscoring its practical feasibility."},{"descriptionType":"Other","description":"Accepted to IEEE International Conference on Robotics and Automation (ICRA) 2025. Project Page: https://toyotafrc.github.io/RobotLocalPlanner-Proj/"}],"geoLocations":[],"fundingReferences":[],"url":"https://arxiv.org/abs/2602.20645","contentUrl":null,"metadataVersion":0,"schemaVersion":"http://datacite.org/schema/kernel-4","source":"mds","isActive":true,"state":"findable","reason":null,"viewCount":0,"downloadCount":0,"referenceCount":0,"citationCount":0,"partCount":0,"partOfCount":0,"versionCount":0,"versionOfCount":0,"created":"2026-02-25T02:55:09Z","registered":"2026-02-25T02:55:10Z","published":null,"updated":"2026-02-25T02:55:10Z"},"relationships":{"client":{"data":{"id":"arxiv.content","type":"clients"}}}},{"id":"10.48550/arxiv.2602.20644","type":"dois","attributes":{"doi":"10.48550/arxiv.2602.20644","identifiers":[{"identifier":"2602.20644","identifierType":"arXiv"}],"creators":[{"nameType":"Personal","givenName":"Fida Khandaker","familyName":"Safa","name":"Safa, Fida Khandaker","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Yupeng","familyName":"Jiang","name":"Jiang, Yupeng","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Xi","familyName":"Zheng","name":"Zheng, Xi","affiliation":[],"nameIdentifiers":[]}],"titles":[{"title":"An LLM-driven Scenario Generation Pipeline Using an Extended Scenic DSL for Autonomous Driving Safety Validation"}],"publisher":"arXiv","container":{},"publicationYear":2026,"subjects":[{"subject":"Software Engineering (cs.SE)","lang":"en","subjectScheme":"arXiv"},{"subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"},{"schemeUri":"http://www.oecd.org/science/inno/38235147.pdf","subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"}],"contributors":[],"dates":[{"date":"2026-02-24T07:44:26Z","dateType":"Submitted","dateInformation":"v1"},{"date":"2026-02-25T01:29:28Z","dateType":"Updated","dateInformation":"v1"},{"date":"2026-02","dateType":"Available","dateInformation":"v1"},{"date":"2026","dateType":"Issued"}],"language":null,"types":{"schemaOrg":"CreativeWork","resourceTypeGeneral":"Preprint","citeproc":"article","bibtex":"misc","ris":"GEN","resourceType":"Article"},"relatedIdentifiers":[],"relatedItems":[],"sizes":[],"formats":[],"version":"1","rightsList":[{"rightsUri":"http://arxiv.org/licenses/nonexclusive-distrib/1.0/","rights":"arXiv.org perpetual, non-exclusive license"}],"descriptions":[{"descriptionType":"Abstract","description":"Real-world crash reports, which combine textual summaries and sketches, are valuable for scenario-based testing of autonomous driving systems (ADS). However, current methods cannot effectively translate this multimodal data into precise, executable simulation scenarios, hindering the scalability of ADS safety validation. In this work, we propose a scalable and verifiable pipeline that uses a large language model (GPT-4o mini) and a probabilistic intermediate representation (an Extended Scenic domain-specific language) to automatically extract semantic scenario configurations from crash reports and generate corresponding simulation-ready scenarios. Unlike earlier approaches such as ScenicNL and LCTGen (which generate scenarios directly from text) or TARGET (which uses deterministic mappings from traffic rules), our method introduces an intermediate Scenic DSL layer to separate high-level semantic understanding from low-level scenario rendering, reducing errors and capturing real-world variability. We evaluated the pipeline on cases from the NHTSA CIREN database. The results show high accuracy in knowledge extraction: 100% correctness for environmental and road network attributes, and 97% and 98% for oracle and actor trajectories, respectively, compared to human-derived ground truth. We executed the generated scenarios in the CARLA simulator using the Autoware driving stack, and they consistently triggered the intended traffic-rule violations (such as opposite-lane crossing and red-light running) across 2,000 scenario variations. These findings demonstrate that the proposed pipeline provides a legally grounded, scalable, and verifiable approach to ADS safety validation."}],"geoLocations":[],"fundingReferences":[],"url":"https://arxiv.org/abs/2602.20644","contentUrl":null,"metadataVersion":0,"schemaVersion":"http://datacite.org/schema/kernel-4","source":"mds","isActive":true,"state":"findable","reason":null,"viewCount":0,"downloadCount":0,"referenceCount":0,"citationCount":0,"partCount":0,"partOfCount":0,"versionCount":0,"versionOfCount":0,"created":"2026-02-25T02:55:08Z","registered":"2026-02-25T02:55:09Z","published":null,"updated":"2026-02-25T02:55:09Z"},"relationships":{"client":{"data":{"id":"arxiv.content","type":"clients"}}}},{"id":"10.48550/arxiv.2602.20643","type":"dois","attributes":{"doi":"10.48550/arxiv.2602.20643","identifiers":[{"identifier":"2602.20643","identifierType":"arXiv"}],"creators":[{"nameType":"Personal","givenName":"Jiawei","familyName":"Wang","name":"Wang, Jiawei","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Chuang","familyName":"Yang","name":"Yang, Chuang","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Jiawei","familyName":"Yong","name":"Yong, Jiawei","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Xiaohang","familyName":"Xu","name":"Xu, Xiaohang","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Hongjun","familyName":"Wang","name":"Wang, Hongjun","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Noboru","familyName":"Koshizuka","name":"Koshizuka, Noboru","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Shintaro","familyName":"Fukushima","name":"Fukushima, Shintaro","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Ryosuke","familyName":"Shibasaki","name":"Shibasaki, Ryosuke","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Renhe","familyName":"Jiang","name":"Jiang, Renhe","affiliation":[],"nameIdentifiers":[]}],"titles":[{"title":"TrajGPT-R: Generating Urban Mobility Trajectory with Reinforcement Learning-Enhanced Generative Pre-trained Transformer"}],"publisher":"arXiv","container":{},"publicationYear":2026,"subjects":[{"subject":"Machine Learning (cs.LG)","lang":"en","subjectScheme":"arXiv"},{"subject":"Artificial Intelligence (cs.AI)","lang":"en","subjectScheme":"arXiv"},{"subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"},{"schemeUri":"http://www.oecd.org/science/inno/38235147.pdf","subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"}],"contributors":[],"dates":[{"date":"2026-02-24T07:44:19Z","dateType":"Submitted","dateInformation":"v1"},{"date":"2026-02-25T01:29:26Z","dateType":"Updated","dateInformation":"v1"},{"date":"2026-02","dateType":"Available","dateInformation":"v1"},{"date":"2026","dateType":"Issued"}],"language":null,"types":{"schemaOrg":"CreativeWork","resourceTypeGeneral":"Preprint","citeproc":"article","bibtex":"misc","ris":"GEN","resourceType":"Article"},"relatedIdentifiers":[],"relatedItems":[],"sizes":[],"formats":[],"version":"1","rightsList":[{"rightsIdentifierScheme":"SPDX","rightsUri":"https://creativecommons.org/licenses/by/4.0/legalcode","schemeUri":"https://spdx.org/licenses/","rights":"Creative Commons Attribution 4.0 International","rightsIdentifier":"cc-by-4.0"}],"descriptions":[{"descriptionType":"Abstract","description":"Mobility trajectories are essential for understanding urban dynamics and enhancing urban planning, yet access to such data is frequently hindered by privacy concerns. This research introduces a transformative framework for generating large-scale urban mobility trajectories, employing a novel application of a transformer-based model pre-trained and fine-tuned through a two-phase process. Initially, trajectory generation is conceptualized as an offline reinforcement learning (RL) problem, with a significant reduction in vocabulary space achieved during tokenization. The integration of Inverse Reinforcement Learning (IRL) allows for the capture of trajectory-wise reward signals, leveraging historical data to infer individual mobility preferences. Subsequently, the pre-trained model is fine-tuned using the constructed reward model, effectively addressing the challenges inherent in traditional RL-based autoregressive methods, such as long-term credit assignment and handling of sparse reward environments. Comprehensive evaluations on multiple datasets illustrate that our framework markedly surpasses existing models in terms of reliability and diversity. Our findings not only advance the field of urban mobility modeling but also provide a robust methodology for simulating urban data, with significant implications for traffic management and urban development planning. The implementation is publicly available at https://github.com/Wangjw6/TrajGPT_R."},{"descriptionType":"Other","description":"TrajGPT-R is a Reinforcement Learning-Enhanced Generative Pre-trained Transformer for Mobility Trajectory Generation"}],"geoLocations":[],"fundingReferences":[],"url":"https://arxiv.org/abs/2602.20643","contentUrl":null,"metadataVersion":0,"schemaVersion":"http://datacite.org/schema/kernel-4","source":"mds","isActive":true,"state":"findable","reason":null,"viewCount":0,"downloadCount":0,"referenceCount":0,"citationCount":0,"partCount":0,"partOfCount":0,"versionCount":0,"versionOfCount":0,"created":"2026-02-25T02:55:06Z","registered":"2026-02-25T02:55:07Z","published":null,"updated":"2026-02-25T02:55:07Z"},"relationships":{"client":{"data":{"id":"arxiv.content","type":"clients"}}}},{"id":"10.48550/arxiv.2602.20642","type":"dois","attributes":{"doi":"10.48550/arxiv.2602.20642","identifiers":[{"identifier":"2602.20642","identifierType":"arXiv"}],"creators":[{"nameType":"Personal","givenName":"Mo","familyName":"Chen","name":"Chen, Mo","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Chongzhi","familyName":"Huang","name":"Huang, Chongzhi","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Hao","familyName":"Wu","name":"Wu, Hao","affiliation":[],"nameIdentifiers":[]}],"titles":[{"title":"Multi-time Loewner energy: rate function for large deviation"}],"publisher":"arXiv","container":{},"publicationYear":2026,"subjects":[{"subject":"Probability (math.PR)","lang":"en","subjectScheme":"arXiv"},{"subject":"FOS: Mathematics","subjectScheme":"Fields of Science and Technology (FOS)"},{"schemeUri":"http://www.oecd.org/science/inno/38235147.pdf","subject":"FOS: Mathematics","subjectScheme":"Fields of Science and Technology (FOS)"},{"subject":"60J67","lang":"en","subjectScheme":"MSC"}],"contributors":[],"dates":[{"date":"2026-02-24T07:43:04Z","dateType":"Submitted","dateInformation":"v1"},{"date":"2026-02-25T01:29:08Z","dateType":"Updated","dateInformation":"v1"},{"date":"2026-02","dateType":"Available","dateInformation":"v1"},{"date":"2026","dateType":"Issued"}],"language":null,"types":{"schemaOrg":"CreativeWork","resourceTypeGeneral":"Preprint","citeproc":"article","bibtex":"misc","ris":"GEN","resourceType":"Article"},"relatedIdentifiers":[],"relatedItems":[],"sizes":[],"formats":[],"version":"1","rightsList":[{"rightsUri":"http://arxiv.org/licenses/nonexclusive-distrib/1.0/","rights":"arXiv.org perpetual, non-exclusive license"}],"descriptions":[{"descriptionType":"Abstract","description":"The classification of probability measures that satisfy both conformal invariance and domain Markov property is equivalent to characterizing solutions to the Belavin--Polyakov--Zamolodchikov (BPZ) equations, as established by Dubédat~[Dub07]. In this context, the partition functions for half-watermelon SLE and for multi-radial SLE serve as fundamental solutions to the BPZ equations. In this article, we investigate the large deviation principle for both half-watermelon SLE and multi-radial SLE. The associated rate function is given by the multi-time Loewner energy, introduced in~[CHPW26]. As applications, we provide an alternative proof of the large deviation principle for Dyson Brownian motion, as well as a new derivation of the boundary perturbation property of the multi-time Loewner energy."},{"descriptionType":"Other","description":"59 pages, 2 figures"}],"geoLocations":[],"fundingReferences":[],"url":"https://arxiv.org/abs/2602.20642","contentUrl":null,"metadataVersion":0,"schemaVersion":"http://datacite.org/schema/kernel-4","source":"mds","isActive":true,"state":"findable","reason":null,"viewCount":0,"downloadCount":0,"referenceCount":0,"citationCount":0,"partCount":0,"partOfCount":0,"versionCount":0,"versionOfCount":0,"created":"2026-02-25T02:55:05Z","registered":"2026-02-25T02:55:06Z","published":null,"updated":"2026-02-25T02:55:06Z"},"relationships":{"client":{"data":{"id":"arxiv.content","type":"clients"}}}},{"id":"10.48550/arxiv.2602.20641","type":"dois","attributes":{"doi":"10.48550/arxiv.2602.20641","identifiers":[{"identifier":"2602.20641","identifierType":"arXiv"}],"creators":[{"nameType":"Personal","affiliation":["LIRA, PSL"],"givenName":"Jean-Marie","familyName":"Malherbe","name":"Malherbe, Jean-Marie","nameIdentifiers":[]}],"titles":[{"title":"70 years of spectroscopy of the photosphere and the solar chromosphere at the Pic du Midi Observatory (1956-2026)"}],"publisher":"arXiv","container":{},"publicationYear":2026,"subjects":[{"subject":"Instrumentation and Methods for Astrophysics (astro-ph.IM)","lang":"en","subjectScheme":"arXiv"},{"subject":"Solar and Stellar Astrophysics (astro-ph.SR)","lang":"en","subjectScheme":"arXiv"},{"subject":"FOS: Physical sciences","subjectScheme":"Fields of Science and Technology (FOS)"},{"schemeUri":"http://www.oecd.org/science/inno/38235147.pdf","subject":"FOS: Physical sciences","subjectScheme":"Fields of Science and Technology (FOS)"}],"contributors":[],"dates":[{"date":"2026-02-24T07:42:32Z","dateType":"Submitted","dateInformation":"v1"},{"date":"2026-02-25T01:29:07Z","dateType":"Updated","dateInformation":"v1"},{"date":"2026-02","dateType":"Available","dateInformation":"v1"},{"date":"2026","dateType":"Issued"}],"language":null,"types":{"schemaOrg":"CreativeWork","resourceTypeGeneral":"Preprint","citeproc":"article","bibtex":"misc","ris":"GEN","resourceType":"Article"},"relatedIdentifiers":[],"relatedItems":[],"sizes":[],"formats":[],"version":"1","rightsList":[{"rightsUri":"http://arxiv.org/licenses/nonexclusive-distrib/1.0/","rights":"arXiv.org perpetual, non-exclusive license"}],"descriptions":[{"descriptionType":"Abstract","description":"Observations of the solar corona at the Pic du Midi began with Bernard Lyot and his spectro coronagraph installed on the multi-purpose equatorial mount of the Baillaud cupola. It was not until 1956 that domes and instruments specifically dedicated to observations of the photosphere and the solar chromosphere appeared. On the occasion of the International Geophysical Year, a solar spectroscopy laboratory was created to the west of the Pic du Midi, based on two spectrographs of 4 m and 9 m focal length. In 1961 the turret dome appeared to the east of the Pic, later equipped with an 8 m spectrograph. Around 1965, the Baillaud dome finally specialized in the corona with a new table and new spectrographs. At the same time, a revolution in infrastructure took place at the Pic in a few years, which we present as well as the solar spectrographs and their goal."}],"geoLocations":[],"fundingReferences":[],"url":"https://arxiv.org/abs/2602.20641","contentUrl":null,"metadataVersion":0,"schemaVersion":"http://datacite.org/schema/kernel-4","source":"mds","isActive":true,"state":"findable","reason":null,"viewCount":0,"downloadCount":0,"referenceCount":0,"citationCount":0,"partCount":0,"partOfCount":0,"versionCount":0,"versionOfCount":0,"created":"2026-02-25T02:55:04Z","registered":"2026-02-25T02:55:04Z","published":null,"updated":"2026-02-25T02:55:04Z"},"relationships":{"client":{"data":{"id":"arxiv.content","type":"clients"}}}},{"id":"10.48550/arxiv.2602.20639","type":"dois","attributes":{"doi":"10.48550/arxiv.2602.20639","identifiers":[{"identifier":"2602.20639","identifierType":"arXiv"}],"creators":[{"nameType":"Personal","givenName":"Bo","familyName":"Zhang","name":"Zhang, Bo","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Jinfeng","familyName":"Zhou","name":"Zhou, Jinfeng","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Yuxuan","familyName":"Chen","name":"Chen, Yuxuan","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Jianing","familyName":"Yin","name":"Yin, Jianing","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Minlie","familyName":"Huang","name":"Huang, Minlie","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Hongning","familyName":"Wang","name":"Wang, Hongning","affiliation":[],"nameIdentifiers":[]}],"titles":[{"title":"Grounding LLMs in Scientific Discovery via Embodied Actions"}],"publisher":"arXiv","container":{},"publicationYear":2026,"subjects":[{"subject":"Artificial Intelligence (cs.AI)","lang":"en","subjectScheme":"arXiv"},{"subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"},{"schemeUri":"http://www.oecd.org/science/inno/38235147.pdf","subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"}],"contributors":[],"dates":[{"date":"2026-02-24T07:37:18Z","dateType":"Submitted","dateInformation":"v1"},{"date":"2026-02-25T01:28:54Z","dateType":"Updated","dateInformation":"v1"},{"date":"2026-02","dateType":"Available","dateInformation":"v1"},{"date":"2026","dateType":"Issued"}],"language":null,"types":{"schemaOrg":"CreativeWork","resourceTypeGeneral":"Preprint","citeproc":"article","bibtex":"misc","ris":"GEN","resourceType":"Article"},"relatedIdentifiers":[],"relatedItems":[],"sizes":[],"formats":[],"version":"1","rightsList":[{"rightsIdentifierScheme":"SPDX","rightsUri":"https://creativecommons.org/licenses/by/4.0/legalcode","schemeUri":"https://spdx.org/licenses/","rights":"Creative Commons Attribution 4.0 International","rightsIdentifier":"cc-by-4.0"}],"descriptions":[{"descriptionType":"Abstract","description":"Large Language Models (LLMs) have shown significant potential in scientific discovery but struggle to bridge the gap between theoretical reasoning and verifiable physical simulation. Existing solutions operate in a passive \"execute-then-response\" loop and thus lacks runtime perception, obscuring agents to transient anomalies (e.g., numerical instability or diverging oscillations). To address this limitation, we propose EmbodiedAct, a framework that transforms established scientific software into active embodied agents by grounding LLMs in embodied actions with a tight perception-execution loop. We instantiate EmbodiedAct within MATLAB and evaluate it on complex engineering design and scientific modeling tasks. Extensive experiments show that EmbodiedAct significantly outperforms existing baselines, achieving SOTA performance by ensuring satisfactory reliability and stability in long-horizon simulations and enhanced accuracy in scientific modeling."},{"descriptionType":"Other","description":"24 pages, 7 figures, 7 tables. Preprint"}],"geoLocations":[],"fundingReferences":[],"url":"https://arxiv.org/abs/2602.20639","contentUrl":null,"metadataVersion":0,"schemaVersion":"http://datacite.org/schema/kernel-4","source":"mds","isActive":true,"state":"findable","reason":null,"viewCount":0,"downloadCount":0,"referenceCount":0,"citationCount":0,"partCount":0,"partOfCount":0,"versionCount":0,"versionOfCount":0,"created":"2026-02-25T02:55:00Z","registered":"2026-02-25T02:55:01Z","published":null,"updated":"2026-02-25T02:55:01Z"},"relationships":{"client":{"data":{"id":"arxiv.content","type":"clients"}}}},{"id":"10.48550/arxiv.2602.20638","type":"dois","attributes":{"doi":"10.48550/arxiv.2602.20638","identifiers":[{"identifier":"2602.20638","identifierType":"arXiv"}],"creators":[{"nameType":"Personal","affiliation":["Heudiasyc"],"givenName":"Vincent","familyName":"Auriau","name":"Auriau, Vincent","nameIdentifiers":[]},{"nameType":"Personal","affiliation":["Heudiasyc"],"givenName":"Khaled","familyName":"Belahcene","name":"Belahcene, Khaled","nameIdentifiers":[]},{"nameType":"Personal","affiliation":["MICS"],"givenName":"Emmanuel","familyName":"Malherbe","name":"Malherbe, Emmanuel","nameIdentifiers":[]},{"nameType":"Personal","affiliation":["MICS"],"givenName":"Vincent","familyName":"Mousseau","name":"Mousseau, Vincent","nameIdentifiers":[]},{"nameType":"Personal","givenName":"Marc","familyName":"Pirlot","name":"Pirlot, Marc","affiliation":[],"nameIdentifiers":[]}],"titles":[{"title":"Identifying two piecewise linear additive value functions from anonymous preference information"}],"publisher":"arXiv","container":{},"publicationYear":2026,"subjects":[{"subject":"Artificial Intelligence (cs.AI)","lang":"en","subjectScheme":"arXiv"},{"subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"},{"schemeUri":"http://www.oecd.org/science/inno/38235147.pdf","subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"}],"contributors":[],"dates":[{"date":"2026-02-24T07:37:02Z","dateType":"Submitted","dateInformation":"v1"},{"date":"2026-02-25T01:28:53Z","dateType":"Updated","dateInformation":"v1"},{"date":"2026-02","dateType":"Available","dateInformation":"v1"},{"date":"2026","dateType":"Issued"}],"language":null,"types":{"schemaOrg":"CreativeWork","resourceTypeGeneral":"Preprint","citeproc":"article","bibtex":"misc","ris":"GEN","resourceType":"Article"},"relatedIdentifiers":[],"relatedItems":[],"sizes":[],"formats":[],"version":"1","rightsList":[{"rightsUri":"http://arxiv.org/licenses/nonexclusive-distrib/1.0/","rights":"arXiv.org perpetual, non-exclusive license"}],"descriptions":[{"descriptionType":"Abstract","description":"Eliciting a preference model involves asking a person, named decision-maker, a series of questions. We assume that these preferences can be represented by an additive value function. In this work, we query simultaneously two decision-makers in the aim to elicit their respective value functions. For each query we receive two answers, without noise, but without knowing which answer corresponds to which decision-maker.We propose an elicitation procedure that identifies the two preference models when the marginal value functions are piecewise linear with known breaking points."}],"geoLocations":[],"fundingReferences":[],"url":"https://arxiv.org/abs/2602.20638","contentUrl":null,"metadataVersion":0,"schemaVersion":"http://datacite.org/schema/kernel-4","source":"mds","isActive":true,"state":"findable","reason":null,"viewCount":0,"downloadCount":0,"referenceCount":0,"citationCount":0,"partCount":0,"partOfCount":0,"versionCount":0,"versionOfCount":0,"created":"2026-02-25T02:54:59Z","registered":"2026-02-25T02:55:00Z","published":null,"updated":"2026-02-25T02:55:00Z"},"relationships":{"client":{"data":{"id":"arxiv.content","type":"clients"}}}},{"id":"10.48550/arxiv.2602.20636","type":"dois","attributes":{"doi":"10.48550/arxiv.2602.20636","identifiers":[{"identifier":"2602.20636","identifierType":"arXiv"}],"creators":[{"nameType":"Personal","givenName":"Rulin","familyName":"Zhou","name":"Zhou, Rulin","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Guankun","familyName":"Wang","name":"Wang, Guankun","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"An","familyName":"Wang","name":"Wang, An","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Yujie","familyName":"Ma","name":"Ma, Yujie","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Lixin","familyName":"Ouyang","name":"Ouyang, Lixin","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Bolin","familyName":"Cui","name":"Cui, Bolin","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Junyan","familyName":"Li","name":"Li, Junyan","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Chaowei","familyName":"Zhu","name":"Zhu, Chaowei","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Mingyang","familyName":"Li","name":"Li, Mingyang","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Ming","familyName":"Chen","name":"Chen, Ming","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Xiaopin","familyName":"Zhong","name":"Zhong, Xiaopin","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Peng","familyName":"Lu","name":"Lu, Peng","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Jiankun","familyName":"Wang","name":"Wang, Jiankun","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Xianming","familyName":"Liu","name":"Liu, Xianming","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Hongliang","familyName":"Ren","name":"Ren, Hongliang","affiliation":[],"nameIdentifiers":[]}],"titles":[{"title":"SurgAtt-Tracker: Online Surgical Attention Tracking via Temporal Proposal Reranking and Motion-Aware Refinement"}],"publisher":"arXiv","container":{},"publicationYear":2026,"subjects":[{"subject":"Computer Vision and Pattern Recognition (cs.CV)","lang":"en","subjectScheme":"arXiv"},{"subject":"Artificial Intelligence (cs.AI)","lang":"en","subjectScheme":"arXiv"},{"subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"},{"schemeUri":"http://www.oecd.org/science/inno/38235147.pdf","subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"}],"contributors":[],"dates":[{"date":"2026-02-24T07:30:51Z","dateType":"Submitted","dateInformation":"v1"},{"date":"2026-02-25T01:28:46Z","dateType":"Updated","dateInformation":"v1"},{"date":"2026-02","dateType":"Available","dateInformation":"v1"},{"date":"2026","dateType":"Issued"}],"language":null,"types":{"schemaOrg":"CreativeWork","resourceTypeGeneral":"Preprint","citeproc":"article","bibtex":"misc","ris":"GEN","resourceType":"Article"},"relatedIdentifiers":[],"relatedItems":[],"sizes":[],"formats":[],"version":"1","rightsList":[{"rightsIdentifierScheme":"SPDX","rightsUri":"https://creativecommons.org/licenses/by-nc-nd/4.0/legalcode","schemeUri":"https://spdx.org/licenses/","rights":"Creative Commons Attribution Non Commercial No Derivatives 4.0 International","rightsIdentifier":"cc-by-nc-nd-4.0"}],"descriptions":[{"descriptionType":"Abstract","description":"Accurate and stable field-of-view (FoV) guidance is critical for safe and efficient minimally invasive surgery, yet existing approaches often conflate visual attention estimation with downstream camera control or rely on direct object-centric assumptions. In this work, we formulate surgical attention tracking as a spatio-temporal learning problem and model surgeon focus as a dense attention heatmap, enabling continuous and interpretable frame-wise FoV guidance. We propose SurgAtt-Tracker, a holistic framework that robustly tracks surgical attention by exploiting temporal coherence through proposal-level reranking and motion-aware refinement, rather than direct regression. To support systematic training and evaluation, we introduce SurgAtt-1.16M, a large-scale benchmark with a clinically grounded annotation protocol that enables comprehensive heatmap-based attention analysis across procedures and institutions. Extensive experiments on multiple surgical datasets demonstrate that SurgAtt-Tracker consistently achieves state-of-the-art performance and strong robustness under occlusion, multi-instrument interference, and cross-domain settings. Beyond attention tracking, our approach provides a frame-wise FoV guidance signal that can directly support downstream robotic FoV planning and automatic camera control."}],"geoLocations":[],"fundingReferences":[],"url":"https://arxiv.org/abs/2602.20636","contentUrl":null,"metadataVersion":0,"schemaVersion":"http://datacite.org/schema/kernel-4","source":"mds","isActive":true,"state":"findable","reason":null,"viewCount":0,"downloadCount":0,"referenceCount":0,"citationCount":0,"partCount":0,"partOfCount":0,"versionCount":0,"versionOfCount":0,"created":"2026-02-25T02:54:56Z","registered":"2026-02-25T02:54:57Z","published":null,"updated":"2026-02-25T02:54:57Z"},"relationships":{"client":{"data":{"id":"arxiv.content","type":"clients"}}}},{"id":"10.48550/arxiv.2602.20634","type":"dois","attributes":{"doi":"10.48550/arxiv.2602.20634","identifiers":[{"identifier":"2602.20634","identifierType":"arXiv"}],"creators":[{"nameType":"Personal","givenName":"Saurabh","familyName":"Mishra","name":"Mishra, Saurabh","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Shivani","familyName":"Thakur","name":"Thakur, Shivani","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Radhika","familyName":"Mamidi","name":"Mamidi, Radhika","affiliation":[],"nameIdentifiers":[]}],"titles":[{"title":"Enhancing Hate Speech Detection on Social Media: A Comparative Analysis of Machine Learning Models and Text Transformation Approaches"}],"publisher":"arXiv","container":{},"publicationYear":2026,"subjects":[{"subject":"Computation and Language (cs.CL)","lang":"en","subjectScheme":"arXiv"},{"subject":"Artificial Intelligence (cs.AI)","lang":"en","subjectScheme":"arXiv"},{"subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"},{"schemeUri":"http://www.oecd.org/science/inno/38235147.pdf","subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"},{"subject":"I.2.7","lang":"en","subjectScheme":"ACM"}],"contributors":[],"dates":[{"date":"2026-02-24T07:26:17Z","dateType":"Submitted","dateInformation":"v1"},{"date":"2026-02-25T01:28:29Z","dateType":"Updated","dateInformation":"v1"},{"date":"2026-02","dateType":"Available","dateInformation":"v1"},{"date":"2026","dateType":"Issued"}],"language":null,"types":{"schemaOrg":"CreativeWork","resourceTypeGeneral":"Preprint","citeproc":"article","bibtex":"misc","ris":"GEN","resourceType":"Article"},"relatedIdentifiers":[],"relatedItems":[],"sizes":[],"formats":[],"version":"1","rightsList":[{"rightsUri":"http://arxiv.org/licenses/nonexclusive-distrib/1.0/","rights":"arXiv.org perpetual, non-exclusive license"}],"descriptions":[{"descriptionType":"Abstract","description":"The proliferation of hate speech on social media platforms has necessitated the development of effective detection and moderation tools. This study evaluates the efficacy of various machine learning models in identifying hate speech and offensive language and investigates the potential of text transformation techniques to neutralize such content. We compare traditional models like CNNs and LSTMs with advanced neural network models such as BERT and its derivatives, alongside exploring hybrid models that combine different architectural features. Our results indicate that while advanced models like BERT show superior accuracy due to their deep contextual understanding, hybrid models exhibit improved capabilities in certain scenarios. Furthermore, we introduce innovative text transformation approaches that convert negative expressions into neutral ones, thereby potentially mitigating the impact of harmful content. The implications of these findings are discussed, highlighting the strengths and limitations of current technologies and proposing future directions for more robust hate speech detection systems."},{"descriptionType":"Other","description":"32 pages, 24 figures"}],"geoLocations":[],"fundingReferences":[],"url":"https://arxiv.org/abs/2602.20634","contentUrl":null,"metadataVersion":0,"schemaVersion":"http://datacite.org/schema/kernel-4","source":"mds","isActive":true,"state":"findable","reason":null,"viewCount":0,"downloadCount":0,"referenceCount":0,"citationCount":0,"partCount":0,"partOfCount":0,"versionCount":0,"versionOfCount":0,"created":"2026-02-25T02:54:54Z","registered":"2026-02-25T02:54:54Z","published":null,"updated":"2026-02-25T02:54:54Z"},"relationships":{"client":{"data":{"id":"arxiv.content","type":"clients"}}}},{"id":"10.48550/arxiv.2602.20633","type":"dois","attributes":{"doi":"10.48550/arxiv.2602.20633","identifiers":[{"identifier":"2602.20633","identifierType":"arXiv"}],"creators":[{"nameType":"Personal","givenName":"Nordine","familyName":"Benkeltoum","name":"Benkeltoum, Nordine","affiliation":[],"nameIdentifiers":[]}],"titles":[{"title":"AI Combines, Humans Socialise: A SECI-based Experience Report on Business Simulation Games"}],"publisher":"arXiv","container":{},"publicationYear":2026,"subjects":[{"subject":"Computers and Society (cs.CY)","lang":"en","subjectScheme":"arXiv"},{"subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"},{"schemeUri":"http://www.oecd.org/science/inno/38235147.pdf","subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"}],"contributors":[],"dates":[{"date":"2026-02-24T07:26:16Z","dateType":"Submitted","dateInformation":"v1"},{"date":"2026-02-25T01:28:28Z","dateType":"Updated","dateInformation":"v1"},{"date":"2026-02","dateType":"Available","dateInformation":"v1"},{"date":"2026","dateType":"Issued"}],"language":null,"types":{"schemaOrg":"CreativeWork","resourceTypeGeneral":"Preprint","citeproc":"article","bibtex":"misc","ris":"GEN","resourceType":"Article"},"relatedIdentifiers":[],"relatedItems":[],"sizes":[],"formats":[],"version":"1","rightsList":[{"rightsUri":"http://arxiv.org/licenses/nonexclusive-distrib/1.0/","rights":"arXiv.org perpetual, non-exclusive license"}],"descriptions":[{"descriptionType":"Abstract","description":"Background. Business Simulation Games (BSG) are widely used to foster experiential learning in complex managerial and organisational contexts by exposing students to decision-making under uncertainty. In parallel, Artificial Intelligence (AI) is increasingly integrated into higher education to support learning activities. However, despite growing interest of AI in education, its specific role in BSG and its implications for knowledge creation processes remain under-theorised. Intervention. This paper reports on the integration of generative AI tools into a BSG designed for engineering students. AI was embedded as a support mechanism during the simulation to assist students in analysing events, reformulating information, and generating decision-relevant insights, while instructors retained responsibility for supervision, debriefing, and complex issues. Methods. Adopting a qualitative experience-report approach, the study draws on the SECI model (Socialisation, Externalisation, Combination, Internalisation) as an analytical framework to examine how students and instructors interacted with AI during the simulation and how different forms of knowledge were mobilised and developed. Results. The findings indicate that AI primarily supports the Combination phase of the SECI model by facilitating the rapid synthesis, reformulation, and contextualisation of explicit knowledge. In contrast, the processes of Socialisation, Externalisation, and Internalisation remained largely dependent on peer interaction, individual reflection, and instructor guidance. Discussion. The results suggest a functional boundary in human-AI collaboration within simulation-based learning. AI acts as a cognitive enhancer that improves responsiveness and access to explicit knowledge, but it does not replace the pedagogical role of instructors in supporting the development of tacit knowledge, competencies, and phronesis. Conclusion. Integrating AI into BSG can enhance learning efficiency and engagement, but effective experiential learning continues to rely on active human supervision. Future research should investigate instructional designs that better support tacit knowledge acquisition in AI-assisted simulations."}],"geoLocations":[],"fundingReferences":[],"url":"https://arxiv.org/abs/2602.20633","contentUrl":null,"metadataVersion":0,"schemaVersion":"http://datacite.org/schema/kernel-4","source":"mds","isActive":true,"state":"findable","reason":null,"viewCount":0,"downloadCount":0,"referenceCount":0,"citationCount":0,"partCount":0,"partOfCount":0,"versionCount":0,"versionOfCount":0,"created":"2026-02-25T02:54:52Z","registered":"2026-02-25T02:54:53Z","published":null,"updated":"2026-02-25T02:54:53Z"},"relationships":{"client":{"data":{"id":"arxiv.content","type":"clients"}}}},{"id":"10.48550/arxiv.2602.20632","type":"dois","attributes":{"doi":"10.48550/arxiv.2602.20632","identifiers":[{"identifier":"2602.20632","identifierType":"arXiv"}],"creators":[{"nameType":"Personal","givenName":"Xiaokai","familyName":"Bai","name":"Bai, Xiaokai","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Lianqing","familyName":"Zheng","name":"Zheng, Lianqing","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Si-Yuan","familyName":"Cao","name":"Cao, Si-Yuan","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Xiaohan","familyName":"Zhang","name":"Zhang, Xiaohan","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Zhe","familyName":"Wu","name":"Wu, Zhe","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Beinan","familyName":"Yu","name":"Yu, Beinan","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Fang","familyName":"Wang","name":"Wang, Fang","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Jie","familyName":"Bai","name":"Bai, Jie","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Hui-Liang","familyName":"Shen","name":"Shen, Hui-Liang","affiliation":[],"nameIdentifiers":[]}],"titles":[{"title":"Boosting Instance Awareness via Cross-View Correlation with 4D Radar and Camera for 3D Object Detection"}],"publisher":"arXiv","container":{},"publicationYear":2026,"subjects":[{"subject":"Computer Vision and Pattern Recognition (cs.CV)","lang":"en","subjectScheme":"arXiv"},{"subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"},{"schemeUri":"http://www.oecd.org/science/inno/38235147.pdf","subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"}],"contributors":[],"dates":[{"date":"2026-02-24T07:25:53Z","dateType":"Submitted","dateInformation":"v1"},{"date":"2026-02-25T01:28:26Z","dateType":"Updated","dateInformation":"v1"},{"date":"2026-02","dateType":"Available","dateInformation":"v1"},{"date":"2026","dateType":"Issued"}],"language":null,"types":{"schemaOrg":"CreativeWork","resourceTypeGeneral":"Preprint","citeproc":"article","bibtex":"misc","ris":"GEN","resourceType":"Article"},"relatedIdentifiers":[],"relatedItems":[],"sizes":[],"formats":[],"version":"1","rightsList":[{"rightsUri":"http://arxiv.org/licenses/nonexclusive-distrib/1.0/","rights":"arXiv.org perpetual, non-exclusive license"}],"descriptions":[{"descriptionType":"Abstract","description":"4D millimeter-wave radar has emerged as a promising sensing modality for autonomous driving due to its robustness and affordability. However, its sparse and weak geometric cues make reliable instance activation difficult, limiting the effectiveness of existing radar-camera fusion paradigms. BEV-level fusion offers global scene understanding but suffers from weak instance focus, while perspective-level fusion captures instance details but lacks holistic context. To address these limitations, we propose SIFormer, a scene-instance aware transformer for 3D object detection using 4D radar and camera. SIFormer first suppresses background noise during view transformation through segmentation- and depth-guided localization. It then introduces a cross-view activation mechanism that injects 2D instance cues into BEV space, enabling reliable instance awareness under weak radar geometry. Finally, a transformer-based fusion module aggregates complementary image semantics and radar geometry for robust perception. As a result, with the aim of enhancing instance awareness, SIFormer bridges the gap between the two paradigms, combining their complementary strengths to address inherent sparse nature of radar and improve detection accuracy. Experiments demonstrate that SIFormer achieves state-of-the-art performance on View-of-Delft, TJ4DRadSet and NuScenes datasets. Source code is available at github.com/shawnnnkb/SIFormer."},{"descriptionType":"Other","description":"14 pages, 10 figures, 13 tables"}],"geoLocations":[],"fundingReferences":[],"url":"https://arxiv.org/abs/2602.20632","contentUrl":null,"metadataVersion":0,"schemaVersion":"http://datacite.org/schema/kernel-4","source":"mds","isActive":true,"state":"findable","reason":null,"viewCount":0,"downloadCount":0,"referenceCount":0,"citationCount":0,"partCount":0,"partOfCount":0,"versionCount":0,"versionOfCount":0,"created":"2026-02-25T02:54:51Z","registered":"2026-02-25T02:54:51Z","published":null,"updated":"2026-02-25T02:54:51Z"},"relationships":{"client":{"data":{"id":"arxiv.content","type":"clients"}}}},{"id":"10.48550/arxiv.2602.20631","type":"dois","attributes":{"doi":"10.48550/arxiv.2602.20631","identifiers":[{"identifier":"2602.20631","identifierType":"arXiv"}],"creators":[{"nameType":"Personal","givenName":"Chan","familyName":"Zhao","name":"Zhao, Chan","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Haiying","familyName":"Li","name":"Li, Haiying","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Tianshui","familyName":"Ma","name":"Ma, Tianshui","affiliation":[],"nameIdentifiers":[]}],"titles":[{"title":"Symmetric Rota-Baxter systems and applications"}],"publisher":"arXiv","container":{},"publicationYear":2026,"subjects":[{"subject":"Rings and Algebras (math.RA)","lang":"en","subjectScheme":"arXiv"},{"subject":"FOS: Mathematics","subjectScheme":"Fields of Science and Technology (FOS)"},{"schemeUri":"http://www.oecd.org/science/inno/38235147.pdf","subject":"FOS: Mathematics","subjectScheme":"Fields of Science and Technology (FOS)"}],"contributors":[],"dates":[{"date":"2026-02-24T07:25:22Z","dateType":"Submitted","dateInformation":"v1"},{"date":"2026-02-25T01:28:24Z","dateType":"Updated","dateInformation":"v1"},{"date":"2026-02","dateType":"Available","dateInformation":"v1"},{"date":"2026","dateType":"Issued"}],"language":null,"types":{"schemaOrg":"CreativeWork","resourceTypeGeneral":"Preprint","citeproc":"article","bibtex":"misc","ris":"GEN","resourceType":"Article"},"relatedIdentifiers":[],"relatedItems":[],"sizes":[],"formats":[],"version":"1","rightsList":[{"rightsIdentifierScheme":"SPDX","rightsUri":"https://creativecommons.org/licenses/by/4.0/legalcode","schemeUri":"https://spdx.org/licenses/","rights":"Creative Commons Attribution 4.0 International","rightsIdentifier":"cc-by-4.0"}],"descriptions":[{"descriptionType":"Abstract","description":"Rota-Baxter operators and bialgebras are closely connected in several applications, such as the Connes-Kreimer renormalization framework and the operator approach to the classical Yang-Baxter equation. The concept of a Rota-Baxter system was introduced in 2016 as a generalization of a Rota-Baxter operator. In this work, we introduce a bialgebra structure compatible with a symmetric Rota-Baxter system, called a symmetric Rota-Baxter antisymmetric infinitesimal (ASI) bisystem. This bialgebra is characterized by generalizations of matched pairs of algebras and double constructions of Frobenius algebras to the setting of symmetric Rota-Baxter systems. Investigating the coboundary case leads to an enriched version of the associative Yang-Baxter equation (aYBe) adapted to symmetric Rota-Baxter systems. Antisymmetric solutions of this equation are used to construct symmetric Rota-Baxter ASI bisystems. We also introduce the notion of an $\\mathcal{O}$-operator on a symmetric Rota-Baxter system, which produces solutions of the admissible aYBe in such systems and thereby gives rise to symmetric Rota-Baxter ASI bisystems. A symmetric Rota-Baxter bisystem generalizes several known structures, including Rota-Baxter Lie bisystems, Rota-Baxter ASI bialgebras, Rota-Baxter Lie bialgebras, averaging ASI bialgebras, averaging Lie bialgebras, and special apre-perm bialgebras."},{"descriptionType":"Other","description":"40 pages"}],"geoLocations":[],"fundingReferences":[],"url":"https://arxiv.org/abs/2602.20631","contentUrl":null,"metadataVersion":0,"schemaVersion":"http://datacite.org/schema/kernel-4","source":"mds","isActive":true,"state":"findable","reason":null,"viewCount":0,"downloadCount":0,"referenceCount":0,"citationCount":0,"partCount":0,"partOfCount":0,"versionCount":0,"versionOfCount":0,"created":"2026-02-25T02:54:49Z","registered":"2026-02-25T02:54:50Z","published":null,"updated":"2026-02-25T02:54:50Z"},"relationships":{"client":{"data":{"id":"arxiv.content","type":"clients"}}}},{"id":"10.48550/arxiv.2602.20628","type":"dois","attributes":{"doi":"10.48550/arxiv.2602.20628","identifiers":[{"identifier":"2602.20628","identifierType":"arXiv"}],"creators":[{"nameType":"Personal","givenName":"Nelson","familyName":"Gardner-Challis","name":"Gardner-Challis, Nelson","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Jonathan","familyName":"Bostock","name":"Bostock, Jonathan","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Georgiy","familyName":"Kozhevnikov","name":"Kozhevnikov, Georgiy","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Morgan","familyName":"Sinclaire","name":"Sinclaire, Morgan","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Joan","familyName":"Velja","name":"Velja, Joan","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Alessandro","familyName":"Abate","name":"Abate, Alessandro","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Charlie","familyName":"Griffin","name":"Griffin, Charlie","affiliation":[],"nameIdentifiers":[]}],"titles":[{"title":"When can we trust untrusted monitoring? A safety case sketch across collusion strategies"}],"publisher":"arXiv","container":{},"publicationYear":2026,"subjects":[{"subject":"Artificial Intelligence (cs.AI)","lang":"en","subjectScheme":"arXiv"},{"subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"},{"schemeUri":"http://www.oecd.org/science/inno/38235147.pdf","subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"}],"contributors":[],"dates":[{"date":"2026-02-24T07:23:21Z","dateType":"Submitted","dateInformation":"v1"},{"date":"2026-02-25T01:28:19Z","dateType":"Updated","dateInformation":"v1"},{"date":"2026-02","dateType":"Available","dateInformation":"v1"},{"date":"2026","dateType":"Issued"}],"language":null,"types":{"schemaOrg":"CreativeWork","resourceTypeGeneral":"Preprint","citeproc":"article","bibtex":"misc","ris":"GEN","resourceType":"Article"},"relatedIdentifiers":[],"relatedItems":[],"sizes":[],"formats":[],"version":"1","rightsList":[{"rightsIdentifierScheme":"SPDX","rightsUri":"https://creativecommons.org/licenses/by/4.0/legalcode","schemeUri":"https://spdx.org/licenses/","rights":"Creative Commons Attribution 4.0 International","rightsIdentifier":"cc-by-4.0"}],"descriptions":[{"descriptionType":"Abstract","description":"AIs are increasingly being deployed with greater autonomy and capabilities, which increases the risk that a misaligned AI may be able to cause catastrophic harm. Untrusted monitoring -- using one untrusted model to oversee another -- is one approach to reducing risk. Justifying the safety of an untrusted monitoring deployment is challenging because developers cannot safely deploy a misaligned model to test their protocol directly. In this paper, we develop upon existing methods for rigorously demonstrating safety based on pre-deployment testing. We relax assumptions that previous AI control research made about the collusion strategies a misaligned AI might use to subvert untrusted monitoring. We develop a taxonomy covering passive self-recognition, causal collusion (hiding pre-shared signals), acausal collusion (hiding signals via Schelling points), and combined strategies. We create a safety case sketch to clearly present our argument, explicitly state our assumptions, and highlight unsolved challenges. We identify conditions under which passive self-recognition could be a more effective collusion strategy than those studied previously. Our work builds towards more robust evaluations of untrusted monitoring."},{"descriptionType":"Other","description":"66 pages, 14 figures, Preprint"}],"geoLocations":[],"fundingReferences":[],"url":"https://arxiv.org/abs/2602.20628","contentUrl":null,"metadataVersion":0,"schemaVersion":"http://datacite.org/schema/kernel-4","source":"mds","isActive":true,"state":"findable","reason":null,"viewCount":0,"downloadCount":0,"referenceCount":0,"citationCount":0,"partCount":0,"partOfCount":0,"versionCount":0,"versionOfCount":0,"created":"2026-02-25T02:54:43Z","registered":"2026-02-25T02:54:44Z","published":null,"updated":"2026-02-25T02:54:44Z"},"relationships":{"client":{"data":{"id":"arxiv.content","type":"clients"}}}},{"id":"10.48550/arxiv.2602.20626","type":"dois","attributes":{"doi":"10.48550/arxiv.2602.20626","identifiers":[{"identifier":"2602.20626","identifierType":"arXiv"}],"creators":[{"nameType":"Personal","affiliation":["ICJ"],"givenName":"Moreno","familyName":"Invitti","name":"Invitti, Moreno","nameIdentifiers":[]}],"titles":[{"title":"Almost cohomology of finite-dimensional Lie rings"}],"publisher":"arXiv","container":{},"publicationYear":2026,"subjects":[{"subject":"Logic (math.LO)","lang":"en","subjectScheme":"arXiv"},{"subject":"FOS: Mathematics","subjectScheme":"Fields of Science and Technology (FOS)"},{"schemeUri":"http://www.oecd.org/science/inno/38235147.pdf","subject":"FOS: Mathematics","subjectScheme":"Fields of Science and Technology (FOS)"}],"contributors":[],"dates":[{"date":"2026-02-24T07:22:30Z","dateType":"Submitted","dateInformation":"v1"},{"date":"2026-02-25T01:28:13Z","dateType":"Updated","dateInformation":"v1"},{"date":"2026-02","dateType":"Available","dateInformation":"v1"},{"date":"2026","dateType":"Issued"}],"language":null,"types":{"schemaOrg":"CreativeWork","resourceTypeGeneral":"Preprint","citeproc":"article","bibtex":"misc","ris":"GEN","resourceType":"Article"},"relatedIdentifiers":[],"relatedItems":[],"sizes":[],"formats":[],"version":"1","rightsList":[{"rightsUri":"http://arxiv.org/licenses/nonexclusive-distrib/1.0/","rights":"arXiv.org perpetual, non-exclusive license"}],"descriptions":[{"descriptionType":"Abstract","description":"We introduce almost cohomology groups for Lie rings definable in finite-dimensional theory. In particular, we define the 0th and 1st almost cohomology groups of a Lie ring module. Moreover, we prove that the 1st almost cohomology group of a finite-dimensional definable Lie ring module is finite if the 0th almost cohomology group is finite."}],"geoLocations":[],"fundingReferences":[],"url":"https://arxiv.org/abs/2602.20626","contentUrl":null,"metadataVersion":0,"schemaVersion":"http://datacite.org/schema/kernel-4","source":"mds","isActive":true,"state":"findable","reason":null,"viewCount":0,"downloadCount":0,"referenceCount":0,"citationCount":0,"partCount":0,"partOfCount":0,"versionCount":0,"versionOfCount":0,"created":"2026-02-25T02:54:40Z","registered":"2026-02-25T02:54:41Z","published":null,"updated":"2026-02-25T02:54:41Z"},"relationships":{"client":{"data":{"id":"arxiv.content","type":"clients"}}}},{"id":"10.48550/arxiv.2602.20624","type":"dois","attributes":{"doi":"10.48550/arxiv.2602.20624","identifiers":[{"identifier":"2602.20624","identifierType":"arXiv"}],"creators":[{"nameType":"Personal","givenName":"Hyeongmo","familyName":"Kim","name":"Kim, Hyeongmo","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Sohyun","familyName":"Kang","name":"Kang, Sohyun","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Yerin","familyName":"Choi","name":"Choi, Yerin","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Seungyeon","familyName":"Ji","name":"Ji, Seungyeon","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Junhyuk","familyName":"Woo","name":"Woo, Junhyuk","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Hyunsuk","familyName":"Chung","name":"Chung, Hyunsuk","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Soyeon Caren","familyName":"Han","name":"Han, Soyeon Caren","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Kyungreem","familyName":"Han","name":"Han, Kyungreem","affiliation":[],"nameIdentifiers":[]}],"titles":[{"title":"Physics-based phenomenological characterization of cross-modal bias in multimodal models"}],"publisher":"arXiv","container":{},"publicationYear":2026,"subjects":[{"subject":"Artificial Intelligence (cs.AI)","lang":"en","subjectScheme":"arXiv"},{"subject":"Statistical Mechanics (cond-mat.stat-mech)","lang":"en","subjectScheme":"arXiv"},{"subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"},{"schemeUri":"http://www.oecd.org/science/inno/38235147.pdf","subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"},{"subject":"FOS: Physical sciences","subjectScheme":"Fields of Science and Technology (FOS)"},{"schemeUri":"http://www.oecd.org/science/inno/38235147.pdf","subject":"FOS: Physical sciences","subjectScheme":"Fields of Science and Technology (FOS)"}],"contributors":[],"dates":[{"date":"2026-02-24T07:21:08Z","dateType":"Submitted","dateInformation":"v1"},{"date":"2026-02-25T01:28:01Z","dateType":"Updated","dateInformation":"v1"},{"date":"2026-02","dateType":"Available","dateInformation":"v1"},{"date":"2026","dateType":"Issued"}],"language":null,"types":{"schemaOrg":"CreativeWork","resourceTypeGeneral":"Preprint","citeproc":"article","bibtex":"misc","ris":"GEN","resourceType":"Article"},"relatedIdentifiers":[],"relatedItems":[],"sizes":[],"formats":[],"version":"1","rightsList":[{"rightsIdentifierScheme":"SPDX","rightsUri":"https://creativecommons.org/licenses/by/4.0/legalcode","schemeUri":"https://spdx.org/licenses/","rights":"Creative Commons Attribution 4.0 International","rightsIdentifier":"cc-by-4.0"}],"descriptions":[{"descriptionType":"Abstract","description":"The term 'algorithmic fairness' is used to evaluate whether AI models operate fairly in both comparative (where fairness is understood as formal equality, such as \"treat like cases as like\") and non-comparative (where unfairness arises from the model's inaccuracy, arbitrariness, or inscrutability) contexts. Recent advances in multimodal large language models (MLLMs) are breaking new ground in multimodal understanding, reasoning, and generation; however, we argue that inconspicuous distortions arising from complex multimodal interaction dynamics can lead to systematic bias. The purpose of this position paper is twofold: first, it is intended to acquaint AI researchers with phenomenological explainable approaches that rely on the physical entities that the machine experiences during training/inference, as opposed to the traditional cognitivist symbolic account or metaphysical approaches; second, it is to state that this phenomenological doctrine will be practically useful for tackling algorithmic fairness issues in MLLMs. We develop a surrogate physics-based model that describes transformer dynamics (i.e., semantic network structure and self-/cross-attention) to analyze the dynamics of cross-modal bias in MLLM, which are not fully captured by conventional embedding- or representation-level analyses. We support this position through multi-input diagnostic experiments: 1) perturbation-based analyses of emotion classification using Qwen2.5-Omni and Gemma 3n, and 2) dynamical analysis of Lorenz chaotic time-series prediction through the physical surrogate. Across two architecturally distinct MLLMs, we show that multimodal inputs can reinforce modality dominance rather than mitigate it, as revealed by structured error-attractor patterns under systematic label perturbation, complemented by dynamical analysis."},{"descriptionType":"Other","description":"Best Paper Award at BiasinAI track in AAAI2026"}],"geoLocations":[],"fundingReferences":[],"url":"https://arxiv.org/abs/2602.20624","contentUrl":null,"metadataVersion":0,"schemaVersion":"http://datacite.org/schema/kernel-4","source":"mds","isActive":true,"state":"findable","reason":null,"viewCount":0,"downloadCount":0,"referenceCount":0,"citationCount":0,"partCount":0,"partOfCount":0,"versionCount":0,"versionOfCount":0,"created":"2026-02-25T02:54:37Z","registered":"2026-02-25T02:54:38Z","published":null,"updated":"2026-02-25T02:54:38Z"},"relationships":{"client":{"data":{"id":"arxiv.content","type":"clients"}}}},{"id":"10.48550/arxiv.2602.20623","type":"dois","attributes":{"doi":"10.48550/arxiv.2602.20623","identifiers":[{"identifier":"2602.20623","identifierType":"arXiv"}],"creators":[{"nameType":"Personal","affiliation":["I2M"],"givenName":"Jade Angela Hope","familyName":"Audouard","name":"Audouard, Jade Angela Hope","nameIdentifiers":[]},{"nameType":"Personal","affiliation":["I2M"],"givenName":"Guillaume","familyName":"Theyssier","name":"Theyssier, Guillaume","nameIdentifiers":[]}],"titles":[{"title":"On K{\\r u}rka's dichotomy for cellular automata on groups"}],"publisher":"arXiv","container":{},"publicationYear":2026,"subjects":[{"subject":"Dynamical Systems (math.DS)","lang":"en","subjectScheme":"arXiv"},{"subject":"Group Theory (math.GR)","lang":"en","subjectScheme":"arXiv"},{"subject":"FOS: Mathematics","subjectScheme":"Fields of Science and Technology (FOS)"},{"schemeUri":"http://www.oecd.org/science/inno/38235147.pdf","subject":"FOS: Mathematics","subjectScheme":"Fields of Science and Technology (FOS)"}],"contributors":[],"dates":[{"date":"2026-02-24T07:19:59Z","dateType":"Submitted","dateInformation":"v1"},{"date":"2026-02-25T01:28:00Z","dateType":"Updated","dateInformation":"v1"},{"date":"2026-02","dateType":"Available","dateInformation":"v1"},{"date":"2026","dateType":"Issued"}],"language":null,"types":{"schemaOrg":"CreativeWork","resourceTypeGeneral":"Preprint","citeproc":"article","bibtex":"misc","ris":"GEN","resourceType":"Article"},"relatedIdentifiers":[],"relatedItems":[],"sizes":[],"formats":[],"version":"1","rightsList":[{"rightsUri":"http://arxiv.org/licenses/nonexclusive-distrib/1.0/","rights":"arXiv.org perpetual, non-exclusive license"}],"descriptions":[{"descriptionType":"Abstract","description":"This paper is about topological dynamics of cellular automata on finitely generated groups. We tackle the problem of determining for which group sensitivity to initial conditions is equivalent to the absence of equicontinuity points (so-called K{\\r u}rka's dichotomy). We show that the dichotomy holds on any virtually-Z group but not on free groups with 2 or more generators. We also show that if it holds on some group, it must hold on any of its subgroups."}],"geoLocations":[],"fundingReferences":[],"url":"https://arxiv.org/abs/2602.20623","contentUrl":null,"metadataVersion":0,"schemaVersion":"http://datacite.org/schema/kernel-4","source":"mds","isActive":true,"state":"findable","reason":null,"viewCount":0,"downloadCount":0,"referenceCount":0,"citationCount":0,"partCount":0,"partOfCount":0,"versionCount":0,"versionOfCount":0,"created":"2026-02-25T02:54:36Z","registered":"2026-02-25T02:54:37Z","published":null,"updated":"2026-02-25T02:54:37Z"},"relationships":{"client":{"data":{"id":"arxiv.content","type":"clients"}}}},{"id":"10.48550/arxiv.2602.20619","type":"dois","attributes":{"doi":"10.48550/arxiv.2602.20619","identifiers":[{"identifier":"2602.20619","identifierType":"arXiv"}],"creators":[{"nameType":"Personal","givenName":"Yuto","familyName":"Nakamura","name":"Nakamura, Yuto","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Shintaro","familyName":"Sato","name":"Sato, Shintaro","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Naofumi","familyName":"Ohnishi","name":"Ohnishi, Naofumi","affiliation":[],"nameIdentifiers":[]}],"titles":[{"title":"Improvement of reduced-order model for two-dimensional cylinder flow based on global proper orthogonal decomposition in terms of robustness and computational speed"}],"publisher":"arXiv","container":{},"publicationYear":2026,"subjects":[{"subject":"Fluid Dynamics (physics.flu-dyn)","lang":"en","subjectScheme":"arXiv"},{"subject":"FOS: Physical sciences","subjectScheme":"Fields of Science and Technology (FOS)"},{"schemeUri":"http://www.oecd.org/science/inno/38235147.pdf","subject":"FOS: Physical sciences","subjectScheme":"Fields of Science and Technology (FOS)"}],"contributors":[],"dates":[{"date":"2026-02-24T07:13:57Z","dateType":"Submitted","dateInformation":"v1"},{"date":"2026-02-25T01:27:51Z","dateType":"Updated","dateInformation":"v1"},{"date":"2026-02","dateType":"Available","dateInformation":"v1"},{"date":"2026","dateType":"Issued"}],"language":null,"types":{"schemaOrg":"CreativeWork","resourceTypeGeneral":"Preprint","citeproc":"article","bibtex":"misc","ris":"GEN","resourceType":"Article"},"relatedIdentifiers":[],"relatedItems":[],"sizes":[],"formats":[],"version":"1","rightsList":[{"rightsIdentifierScheme":"SPDX","rightsUri":"https://creativecommons.org/licenses/by-nc-nd/4.0/legalcode","schemeUri":"https://spdx.org/licenses/","rights":"Creative Commons Attribution Non Commercial No Derivatives 4.0 International","rightsIdentifier":"cc-by-nc-nd-4.0"}],"descriptions":[{"descriptionType":"Abstract","description":"Reduced-order models (ROMs) are widely used in fluid engineering to enable rapid prediction of flow fields for parametric analysis, design optimization, and control applications. Proper orthogonal decomposition (POD) is commonly employed to construct ROMs because it provides an optimal basis for representing a given flow dataset. However, POD-based ROMs often lack robustness when applied to flow conditions that differ from those included in the training data. Incorporating multiple flow conditions can improve robustness, but this generally increases the computational cost of ROM prediction, which limits practical applicability in engineering workflows. In this study, we propose a ROM framework that achieves fast and robust flow prediction even when the dataset contains a large number of flow conditions. The proposed approach employs a novel two-step order-reduction strategy based on POD. In the second reduction step, flow conditions that are most relevant to the target prediction are selectively retained, thereby reducing the computational cost without sacrificing accuracy. The performance of the proposed ROM is evaluated for a two-dimensional unsteady flow past a circular cylinder, a canonical benchmark problem in fluid engineering. The model accurately reproduces the relationship between vortex-shedding frequency and Reynolds number obtained from full numerical simulations. Furthermore, the proposed ROM reduces the computational cost by approximately 50% compared with a conventional POD-based ROM constructed using flow data at 27 different Reynolds numbers."}],"geoLocations":[],"fundingReferences":[],"url":"https://arxiv.org/abs/2602.20619","contentUrl":null,"metadataVersion":0,"schemaVersion":"http://datacite.org/schema/kernel-4","source":"mds","isActive":true,"state":"findable","reason":null,"viewCount":0,"downloadCount":0,"referenceCount":0,"citationCount":0,"partCount":0,"partOfCount":0,"versionCount":0,"versionOfCount":0,"created":"2026-02-25T02:54:31Z","registered":"2026-02-25T02:54:31Z","published":null,"updated":"2026-02-25T02:54:31Z"},"relationships":{"client":{"data":{"id":"arxiv.content","type":"clients"}}}},{"id":"10.48550/arxiv.2602.20618","type":"dois","attributes":{"doi":"10.48550/arxiv.2602.20618","identifiers":[{"identifier":"2602.20618","identifierType":"arXiv"}],"creators":[{"nameType":"Personal","givenName":"Haonan","familyName":"An","name":"An, Haonan","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Xiaohui","familyName":"Ye","name":"Ye, Xiaohui","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Guang","familyName":"Hua","name":"Hua, Guang","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Yihang","familyName":"Tao","name":"Tao, Yihang","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Hangcheng","familyName":"Cao","name":"Cao, Hangcheng","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Xiangyu","familyName":"Yu","name":"Yu, Xiangyu","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Yuguang","familyName":"Fang","name":"Fang, Yuguang","affiliation":[],"nameIdentifiers":[]}],"titles":[{"title":"RecoverMark: Robust Watermarking for Localization and Recovery of Manipulated Faces"}],"publisher":"arXiv","container":{},"publicationYear":2026,"subjects":[{"subject":"Computer Vision and Pattern Recognition (cs.CV)","lang":"en","subjectScheme":"arXiv"},{"subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"},{"schemeUri":"http://www.oecd.org/science/inno/38235147.pdf","subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"}],"contributors":[],"dates":[{"date":"2026-02-24T07:11:40Z","dateType":"Submitted","dateInformation":"v1"},{"date":"2026-02-25T01:27:49Z","dateType":"Updated","dateInformation":"v1"},{"date":"2026-02","dateType":"Available","dateInformation":"v1"},{"date":"2026","dateType":"Issued"}],"language":null,"types":{"schemaOrg":"CreativeWork","resourceTypeGeneral":"Preprint","citeproc":"article","bibtex":"misc","ris":"GEN","resourceType":"Article"},"relatedIdentifiers":[],"relatedItems":[],"sizes":[],"formats":[],"version":"1","rightsList":[{"rightsUri":"http://arxiv.org/licenses/nonexclusive-distrib/1.0/","rights":"arXiv.org perpetual, non-exclusive license"}],"descriptions":[{"descriptionType":"Abstract","description":"The proliferation of AI-generated content has facilitated sophisticated face manipulation, severely undermining visual integrity and posing unprecedented challenges to intellectual property. In response, a common proactive defense leverages fragile watermarks to detect, localize, or even recover manipulated regions. However, these methods always assume an adversary unaware of the embedded watermark, overlooking their inherent vulnerability to watermark removal attacks. Furthermore, this fragility is exacerbated in the commonly used dual-watermark strategy that adds a robust watermark for image ownership verification, where mutual interference and limited embedding capacity reduce the fragile watermark's effectiveness. To address the gap, we propose RecoverMark, a watermarking framework that achieves robust manipulation localization, content recovery, and ownership verification simultaneously. Our key insight is twofold. First, we exploit a critical real-world constraint: an adversary must preserve the background's semantic consistency to avoid visual detection, even if they apply global, imperceptible watermark removal attacks. Second, using the image's own content (face, in this paper) as the watermark enhances extraction robustness. Based on these insights, RecoverMark treats the protected face content itself as the watermark and embeds it into the surrounding background. By designing a robust two-stage training paradigm with carefully crafted distortion layers that simulate comprehensive potential attacks and a progressive training strategy, RecoverMark achieves a robust watermark embedding in no fragile manner for image manipulation localization, recovery, and image IP protection simultaneously. Extensive experiments demonstrate the proposed RecoverMark's robustness against both seen and unseen attacks and its generalizability to in-distribution and out-of-distribution data."},{"descriptionType":"Other","description":"Accepted by CVPR 2026"}],"geoLocations":[],"fundingReferences":[],"url":"https://arxiv.org/abs/2602.20618","contentUrl":null,"metadataVersion":0,"schemaVersion":"http://datacite.org/schema/kernel-4","source":"mds","isActive":true,"state":"findable","reason":null,"viewCount":0,"downloadCount":0,"referenceCount":0,"citationCount":0,"partCount":0,"partOfCount":0,"versionCount":0,"versionOfCount":0,"created":"2026-02-25T02:54:29Z","registered":"2026-02-25T02:54:30Z","published":null,"updated":"2026-02-25T02:54:30Z"},"relationships":{"client":{"data":{"id":"arxiv.content","type":"clients"}}}},{"id":"10.48550/arxiv.2602.20617","type":"dois","attributes":{"doi":"10.48550/arxiv.2602.20617","identifiers":[{"identifier":"2602.20617","identifierType":"arXiv"}],"creators":[{"nameType":"Personal","givenName":"Yuancheng","familyName":"Ning","name":"Ning, Yuancheng","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Xiaoyan","familyName":"Yang","name":"Yang, Xiaoyan","affiliation":[],"nameIdentifiers":[]}],"titles":[{"title":"Grade and Cohen-Macaulayness for DG-modules"}],"publisher":"arXiv","container":{},"publicationYear":2026,"subjects":[{"subject":"Commutative Algebra (math.AC)","lang":"en","subjectScheme":"arXiv"},{"subject":"FOS: Mathematics","subjectScheme":"Fields of Science and Technology (FOS)"},{"schemeUri":"http://www.oecd.org/science/inno/38235147.pdf","subject":"FOS: Mathematics","subjectScheme":"Fields of Science and Technology (FOS)"}],"contributors":[],"dates":[{"date":"2026-02-24T07:10:10Z","dateType":"Submitted","dateInformation":"v1"},{"date":"2026-02-25T01:27:41Z","dateType":"Updated","dateInformation":"v1"},{"date":"2026-02","dateType":"Available","dateInformation":"v1"},{"date":"2026","dateType":"Issued"}],"language":null,"types":{"schemaOrg":"CreativeWork","resourceTypeGeneral":"Preprint","citeproc":"article","bibtex":"misc","ris":"GEN","resourceType":"Article"},"relatedIdentifiers":[],"relatedItems":[],"sizes":[],"formats":[],"version":"1","rightsList":[{"rightsUri":"http://arxiv.org/licenses/nonexclusive-distrib/1.0/","rights":"arXiv.org perpetual, non-exclusive license"}],"descriptions":[{"descriptionType":"Abstract","description":"We establish an inequality relating the projective dimension of a DG-module in $\\mathrm{D}^\\mathrm{b}_\\mathrm{f}(A)$ to its grade and introduce the concept of perfect DG-modules as a natural generalization of perfect modules. It is proved that a DG-module $M$ over a local Cohen-Macaulay DG-ring with constant amplitude is Cohen-Macaulay if and only if $M$ is perfect and $\\mathrm{amp}M \\leq \\mathrm{amp}\\mathrm{R}Γ_{\\bar{\\mathfrak{m}}}(M)$. An affirmative answer is provided to Conjecture 2.11 of Yoshida [J. Pure Appl. Algebra 123 (1998) 313--326]. We also study the grade of DG-modules with finite injective dimension and examine the preservation of Cohen-Macaulayness under tensor products."},{"descriptionType":"Other","description":"comments welcome!"}],"geoLocations":[],"fundingReferences":[],"url":"https://arxiv.org/abs/2602.20617","contentUrl":null,"metadataVersion":0,"schemaVersion":"http://datacite.org/schema/kernel-4","source":"mds","isActive":true,"state":"findable","reason":null,"viewCount":0,"downloadCount":0,"referenceCount":0,"citationCount":0,"partCount":0,"partOfCount":0,"versionCount":0,"versionOfCount":0,"created":"2026-02-25T02:54:28Z","registered":"2026-02-25T02:54:28Z","published":null,"updated":"2026-02-25T02:54:28Z"},"relationships":{"client":{"data":{"id":"arxiv.content","type":"clients"}}}},{"id":"10.48550/arxiv.2602.20616","type":"dois","attributes":{"doi":"10.48550/arxiv.2602.20616","identifiers":[{"identifier":"2602.20616","identifierType":"arXiv"}],"creators":[{"nameType":"Personal","givenName":"Xueqiang","familyName":"Lv","name":"Lv, Xueqiang","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Shizhou","familyName":"Zhang","name":"Zhang, Shizhou","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Yinghui","familyName":"Xing","name":"Xing, Yinghui","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Di","familyName":"Xu","name":"Xu, Di","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Peng","familyName":"Wang","name":"Wang, Peng","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Yanning","familyName":"Zhang","name":"Zhang, Yanning","affiliation":[],"nameIdentifiers":[]}],"titles":[{"title":"Knowing the Unknown: Interpretable Open-World Object Detection via Concept Decomposition Model"}],"publisher":"arXiv","container":{},"publicationYear":2026,"subjects":[{"subject":"Computer Vision and Pattern Recognition (cs.CV)","lang":"en","subjectScheme":"arXiv"},{"subject":"Machine Learning (cs.LG)","lang":"en","subjectScheme":"arXiv"},{"subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"},{"schemeUri":"http://www.oecd.org/science/inno/38235147.pdf","subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"}],"contributors":[],"dates":[{"date":"2026-02-24T07:08:47Z","dateType":"Submitted","dateInformation":"v1"},{"date":"2026-02-25T01:27:35Z","dateType":"Updated","dateInformation":"v1"},{"date":"2026-02","dateType":"Available","dateInformation":"v1"},{"date":"2026","dateType":"Issued"}],"language":null,"types":{"schemaOrg":"CreativeWork","resourceTypeGeneral":"Preprint","citeproc":"article","bibtex":"misc","ris":"GEN","resourceType":"Article"},"relatedIdentifiers":[],"relatedItems":[],"sizes":[],"formats":[],"version":"1","rightsList":[{"rightsUri":"http://arxiv.org/licenses/nonexclusive-distrib/1.0/","rights":"arXiv.org perpetual, non-exclusive license"}],"descriptions":[{"descriptionType":"Abstract","description":"Open-world object detection (OWOD) requires incrementally detecting known categories while reliably identifying unknown objects. Existing methods primarily focus on improving unknown recall, yet overlook interpretability, often leading to known-unknown confusion and reduced prediction reliability. This paper aims to make the entire OWOD framework interpretable, enabling the detector to truly \"knowing the unknown\". To this end, we propose a concept-driven InterPretable OWOD framework(IPOW) by introducing a Concept Decomposition Model (CDM) for OWOD, which explicitly decomposes the coupled RoI features in Faster R-CNN into discriminative, shared, and background concepts. Discriminative concepts identify the most discriminative features to enlarge the distances between known categories, while shared and background concepts, due to their strong generalization ability, can be readily transferred to detect unknown categories. Leveraging the interpretable framework, we identify that known-unknown confusion arises when unknown objects fall into the discriminative space of known classes. To address this, we propose Concept-Guided Rectification (CGR) to further resolve such confusion. Extensive experiments show that IPOW significantly improves unknown recall while mitigating confusion, and provides concept-level interpretability for both known and unknown predictions."}],"geoLocations":[],"fundingReferences":[],"url":"https://arxiv.org/abs/2602.20616","contentUrl":null,"metadataVersion":0,"schemaVersion":"http://datacite.org/schema/kernel-4","source":"mds","isActive":true,"state":"findable","reason":null,"viewCount":0,"downloadCount":0,"referenceCount":0,"citationCount":0,"partCount":0,"partOfCount":0,"versionCount":0,"versionOfCount":0,"created":"2026-02-25T02:54:26Z","registered":"2026-02-25T02:54:27Z","published":null,"updated":"2026-02-25T02:54:27Z"},"relationships":{"client":{"data":{"id":"arxiv.content","type":"clients"}}}},{"id":"10.48550/arxiv.2602.20614","type":"dois","attributes":{"doi":"10.48550/arxiv.2602.20614","identifiers":[{"identifier":"2602.20614","identifierType":"arXiv"}],"creators":[{"nameType":"Personal","givenName":"J. Thirunirai","familyName":"Selvam","name":"Selvam, J. Thirunirai","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"S. Saravana","familyName":"Veni","name":"Veni, S. Saravana","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Ria Rushin","familyName":"Joseph","name":"Joseph, Ria Rushin","affiliation":[],"nameIdentifiers":[]}],"titles":[{"title":"First- and Second-Order Digital Quantum Simulation of Three-Level Jaynes-Cummings Dynamics on Superconducting Quantum Processors"}],"publisher":"arXiv","container":{},"publicationYear":2026,"subjects":[{"subject":"Quantum Physics (quant-ph)","lang":"en","subjectScheme":"arXiv"},{"subject":"FOS: Physical sciences","subjectScheme":"Fields of Science and Technology (FOS)"},{"schemeUri":"http://www.oecd.org/science/inno/38235147.pdf","subject":"FOS: Physical sciences","subjectScheme":"Fields of Science and Technology (FOS)"}],"contributors":[],"dates":[{"date":"2026-02-24T07:06:52Z","dateType":"Submitted","dateInformation":"v1"},{"date":"2026-02-25T01:27:28Z","dateType":"Updated","dateInformation":"v1"},{"date":"2026-02","dateType":"Available","dateInformation":"v1"},{"date":"2026","dateType":"Issued"}],"language":null,"types":{"schemaOrg":"CreativeWork","resourceTypeGeneral":"Preprint","citeproc":"article","bibtex":"misc","ris":"GEN","resourceType":"Article"},"relatedIdentifiers":[],"relatedItems":[],"sizes":[],"formats":[],"version":"1","rightsList":[{"rightsUri":"http://arxiv.org/licenses/nonexclusive-distrib/1.0/","rights":"arXiv.org perpetual, non-exclusive license"}],"descriptions":[{"descriptionType":"Abstract","description":"This work presents a digital quantum simulation of a three-level atomic system interacting with a single-mode electromagnetic field based on the Jaynes-Cummings model, implemented on IBM Quantum superconducting processors. A qutrit is encoded using two physical qubits to represent the atomic states, while an additional qubit encodes the truncated field mode, enabling the realization of effective $Λ$-type atomic dynamics.The continuous-time light-matter interaction is implemented in a digital form by discretizing the evolution using Suzuki-Trotter decomposition. In contrast to an analog realization, the digital simulation replaces the continuous evolution with a sequence of quantum gates whose parameters are explicitly controlled. Phase evolution arising from the interaction Hamiltonian is digitally encoded using calibrated $R_Z$ gates, whose rotation angles are fixed by the physically relevant coupling scale and the chosen Trotter time step.State preparation is achieved using Hadamard and parametrized rotation gates, while the interaction dynamics are implemented through controlled operations. A comparative analysis between first- and second-order Trotter implementations reveals a trade-off between digital accuracy and hardware-induced noise. Overall, the results demonstrate that calibrated gate operations and noise-aware circuit design enable reliable digital simulation of multi-level light-matter interactions on noisy intermediate-scale quantum platforms."}],"geoLocations":[],"fundingReferences":[],"url":"https://arxiv.org/abs/2602.20614","contentUrl":null,"metadataVersion":0,"schemaVersion":"http://datacite.org/schema/kernel-4","source":"mds","isActive":true,"state":"findable","reason":null,"viewCount":0,"downloadCount":0,"referenceCount":0,"citationCount":0,"partCount":0,"partOfCount":0,"versionCount":0,"versionOfCount":0,"created":"2026-02-25T02:54:23Z","registered":"2026-02-25T02:54:24Z","published":null,"updated":"2026-02-25T02:54:24Z"},"relationships":{"client":{"data":{"id":"arxiv.content","type":"clients"}}}},{"id":"10.48550/arxiv.2602.20612","type":"dois","attributes":{"doi":"10.48550/arxiv.2602.20612","identifiers":[{"identifier":"2602.20612","identifierType":"arXiv"}],"creators":[{"nameType":"Personal","givenName":"Motohiko","familyName":"Ezawa","name":"Ezawa, Motohiko","affiliation":[],"nameIdentifiers":[]}],"titles":[{"title":"Non-Clifford symmetry protected topological higher-order cluster states in multi-qubit measurement-based quantum computation"}],"publisher":"arXiv","container":{},"publicationYear":2026,"subjects":[{"subject":"Quantum Physics (quant-ph)","lang":"en","subjectScheme":"arXiv"},{"subject":"Strongly Correlated Electrons (cond-mat.str-el)","lang":"en","subjectScheme":"arXiv"},{"subject":"High Energy Physics - Theory (hep-th)","lang":"en","subjectScheme":"arXiv"},{"subject":"FOS: Physical sciences","subjectScheme":"Fields of Science and Technology (FOS)"},{"schemeUri":"http://www.oecd.org/science/inno/38235147.pdf","subject":"FOS: Physical sciences","subjectScheme":"Fields of Science and Technology (FOS)"}],"contributors":[],"dates":[{"date":"2026-02-24T07:06:36Z","dateType":"Submitted","dateInformation":"v1"},{"date":"2026-02-25T01:27:23Z","dateType":"Updated","dateInformation":"v1"},{"date":"2026-02","dateType":"Available","dateInformation":"v1"},{"date":"2026","dateType":"Issued"}],"language":null,"types":{"schemaOrg":"CreativeWork","resourceTypeGeneral":"Preprint","citeproc":"article","bibtex":"misc","ris":"GEN","resourceType":"Article"},"relatedIdentifiers":[],"relatedItems":[],"sizes":[],"formats":[],"version":"1","rightsList":[{"rightsIdentifierScheme":"SPDX","rightsUri":"https://creativecommons.org/licenses/by/4.0/legalcode","schemeUri":"https://spdx.org/licenses/","rights":"Creative Commons Attribution 4.0 International","rightsIdentifier":"cc-by-4.0"}],"descriptions":[{"descriptionType":"Abstract","description":"A cluster state is a strongly entangled state, which is a source of measurement-based quantum computation. It is generated by applying controlled-Z (CZ) gates to the state $\\left\\vert ++\\cdots +\\right\\rangle $. It is protected by the $\\mathbb{Z}_{2}^{\\text{even}}\\times \\mathbb{Z}_{2}^{ \\text{odd}}$ symmetry. By applying general quantum gates to the state $ \\left\\vert ++\\cdots +\\right\\rangle $, we systematically obtain a general short-range entangled cluster state. If we use a non-Clifford gate such as the controlled phase-shift gate, we obtain a non-Clifford cluster state. Furthermore, if we use the controlled-controlled Z (CCZ) gate instead of the CZ gate, we obtain non-Clifford cluster states with five-body entanglement. We generalize it to the C$^{N}$Z gate, where $(2N+1)$-body entangled states are generated. The $\\mathbb{Z}_{2}^{\\text{even}}\\times \\mathbb{Z}_{2}^{\\text{odd}}$ symmetry is non-Clifford for $N\\geq 3$. We demonstrate that there emerge $2^{2N}$ fold degenerate ground states for an open chain, indicating the emergence of $N$ free spins at each edge. They can be used as an $N$-qubit input and an $N$-qubit output in measurement-based quantum computation. We also study the non-invertible symmetry, the Kennedy-Tasaki transformation and the string-order parameter in addition to the $\\mathbb{Z}_{2}^{\\text{even}}\\times \\mathbb{Z}_{2}^{\\text{odd}}$ symmetry in these models."},{"descriptionType":"Other","description":"19 pages, 11 figures"}],"geoLocations":[],"fundingReferences":[],"url":"https://arxiv.org/abs/2602.20612","contentUrl":null,"metadataVersion":0,"schemaVersion":"http://datacite.org/schema/kernel-4","source":"mds","isActive":true,"state":"findable","reason":null,"viewCount":0,"downloadCount":0,"referenceCount":0,"citationCount":0,"partCount":0,"partOfCount":0,"versionCount":0,"versionOfCount":0,"created":"2026-02-25T02:54:20Z","registered":"2026-02-25T02:54:21Z","published":null,"updated":"2026-02-25T02:54:21Z"},"relationships":{"client":{"data":{"id":"arxiv.content","type":"clients"}}}},{"id":"10.48550/arxiv.2602.20611","type":"dois","attributes":{"doi":"10.48550/arxiv.2602.20611","identifiers":[{"identifier":"2602.20611","identifierType":"arXiv"}],"creators":[{"nameType":"Personal","givenName":"Daniel","familyName":"Zhou","name":"Zhou, Daniel","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Sudipto","familyName":"Banerjee","name":"Banerjee, Sudipto","affiliation":[],"nameIdentifiers":[]}],"titles":[{"title":"Amortized Bayesian inference for actigraph time sheet data from mobile devices"}],"publisher":"arXiv","container":{},"publicationYear":2026,"subjects":[{"subject":"Machine Learning (stat.ML)","lang":"en","subjectScheme":"arXiv"},{"subject":"Machine Learning (cs.LG)","lang":"en","subjectScheme":"arXiv"},{"subject":"Methodology (stat.ME)","lang":"en","subjectScheme":"arXiv"},{"subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"},{"schemeUri":"http://www.oecd.org/science/inno/38235147.pdf","subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"}],"contributors":[],"dates":[{"date":"2026-02-24T07:03:15Z","dateType":"Submitted","dateInformation":"v1"},{"date":"2026-02-25T01:27:18Z","dateType":"Updated","dateInformation":"v1"},{"date":"2026-02","dateType":"Available","dateInformation":"v1"},{"date":"2026","dateType":"Issued"}],"language":null,"types":{"schemaOrg":"CreativeWork","resourceTypeGeneral":"Preprint","citeproc":"article","bibtex":"misc","ris":"GEN","resourceType":"Article"},"relatedIdentifiers":[],"relatedItems":[],"sizes":[],"formats":[],"version":"1","rightsList":[{"rightsIdentifierScheme":"SPDX","rightsUri":"https://creativecommons.org/licenses/by/4.0/legalcode","schemeUri":"https://spdx.org/licenses/","rights":"Creative Commons Attribution 4.0 International","rightsIdentifier":"cc-by-4.0"}],"descriptions":[{"descriptionType":"Abstract","description":"Mobile data technologies use ``actigraphs'' to furnish information on health variables as a function of a subject's movement. The advent of wearable devices and related technologies has propelled the creation of health databases consisting of human movement data to conduct research on mobility patterns and health outcomes. Statistical methods for analyzing high-resolution actigraph data depend on the specific inferential context, but the advent of Artificial Intelligence (AI) frameworks require that the methods be congruent to transfer learning and amortization. This article devises amortized Bayesian inference for actigraph time sheets. We pursue a Bayesian approach to ensure full propagation of uncertainty and its quantification using a hierarchical dynamic linear model. We build our analysis around actigraph data from the Physical Activity through Sustainable Transport Approaches in Los Angeles (PASTA-LA) study conducted by the Fielding School of Public Health in the University of California, Los Angeles. Apart from achieving probabilistic imputation of actigraph time sheets, we are also able to statistically learn about the time-varying impact of explanatory variables on the magnitude of acceleration (MAG) for a cohort of subjects."},{"descriptionType":"Other","description":"40 pages, 7 figures"}],"geoLocations":[],"fundingReferences":[],"url":"https://arxiv.org/abs/2602.20611","contentUrl":null,"metadataVersion":0,"schemaVersion":"http://datacite.org/schema/kernel-4","source":"mds","isActive":true,"state":"findable","reason":null,"viewCount":0,"downloadCount":0,"referenceCount":0,"citationCount":0,"partCount":0,"partOfCount":0,"versionCount":0,"versionOfCount":0,"created":"2026-02-25T02:54:19Z","registered":"2026-02-25T02:54:20Z","published":null,"updated":"2026-02-25T02:54:20Z"},"relationships":{"client":{"data":{"id":"arxiv.content","type":"clients"}}}},{"id":"10.48550/arxiv.2602.20609","type":"dois","attributes":{"doi":"10.48550/arxiv.2602.20609","identifiers":[{"identifier":"2602.20609","identifierType":"arXiv"}],"creators":[{"nameType":"Personal","givenName":"Zhenhua","familyName":"Zheng","name":"Zheng, Zhenhua","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Lu","familyName":"Zhang","name":"Zhang, Lu","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Junhong","familyName":"Zou","name":"Zou, Junhong","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Shitong","familyName":"Liu","name":"Liu, Shitong","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Zhen","familyName":"Lei","name":"Lei, Zhen","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Xiangyu","familyName":"Zhu","name":"Zhu, Xiangyu","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Zhiyong","familyName":"Liu","name":"Liu, Zhiyong","affiliation":[],"nameIdentifiers":[]}],"titles":[{"title":"GA-Field: Geometry-Aware Vehicle Aerodynamic Field Prediction"}],"publisher":"arXiv","container":{},"publicationYear":2026,"subjects":[{"subject":"Computational Engineering, Finance, and Science (cs.CE)","lang":"en","subjectScheme":"arXiv"},{"subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"},{"schemeUri":"http://www.oecd.org/science/inno/38235147.pdf","subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"}],"contributors":[],"dates":[{"date":"2026-02-24T07:00:50Z","dateType":"Submitted","dateInformation":"v1"},{"date":"2026-02-25T01:27:09Z","dateType":"Updated","dateInformation":"v1"},{"date":"2026-02","dateType":"Available","dateInformation":"v1"},{"date":"2026","dateType":"Issued"}],"language":null,"types":{"schemaOrg":"CreativeWork","resourceTypeGeneral":"Preprint","citeproc":"article","bibtex":"misc","ris":"GEN","resourceType":"Article"},"relatedIdentifiers":[],"relatedItems":[],"sizes":[],"formats":[],"version":"1","rightsList":[{"rightsIdentifierScheme":"SPDX","rightsUri":"https://creativecommons.org/licenses/by/4.0/legalcode","schemeUri":"https://spdx.org/licenses/","rights":"Creative Commons Attribution 4.0 International","rightsIdentifier":"cc-by-4.0"}],"descriptions":[{"descriptionType":"Abstract","description":"Accurate aerodynamic field prediction is crucial for vehicle drag evaluation, but the computational cost of high-fidelity CFD hinders its use in iterative design workflows. While learning-based methods enable fast and scalable inference, accurately aerodynamic fields modeling remains challenging, as it demands capturing both long-range geometric effects and fine-scale flow structures. Existing approaches typically encode geometry only once at the input and formulate prediction as a one-shot mapping, which often leads to diluted global shape awareness and insufficient resolution of sharp local flow variations. To address these issues, we propose GA-Field, a Geometry-Aware Field prediction network that introduces two complementary design components: (i) a global geometry injection mechanism that repeatedly conditions the network on a compact 3D geometry embedding at multiple stages to preserve long-range geometric consistency, and (ii) a coarse-to-fine field refinement strategy to recover sharp local aerodynamic details. GA-Field achieves new state-of-the-art performance on ShapeNet-Car and the large-scale DrivAerNet++ benchmark for surface pressure, wall shear stress, and 3D velocity prediction tasks, while exhibiting strong out-of-distribution generalization across different vehicle categories."}],"geoLocations":[],"fundingReferences":[],"url":"https://arxiv.org/abs/2602.20609","contentUrl":null,"metadataVersion":0,"schemaVersion":"http://datacite.org/schema/kernel-4","source":"mds","isActive":true,"state":"findable","reason":null,"viewCount":0,"downloadCount":0,"referenceCount":0,"citationCount":0,"partCount":0,"partOfCount":0,"versionCount":0,"versionOfCount":0,"created":"2026-02-25T02:54:16Z","registered":"2026-02-25T02:54:17Z","published":null,"updated":"2026-02-25T02:54:17Z"},"relationships":{"client":{"data":{"id":"arxiv.content","type":"clients"}}}},{"id":"10.48550/arxiv.2602.20608","type":"dois","attributes":{"doi":"10.48550/arxiv.2602.20608","identifiers":[{"identifier":"2602.20608","identifierType":"arXiv"}],"creators":[{"nameType":"Personal","givenName":"Aihua","familyName":"Mao","name":"Mao, Aihua","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Kaihang","familyName":"Huang","name":"Huang, Kaihang","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Yong-Jin","familyName":"Liu","name":"Liu, Yong-Jin","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Chee Seng","familyName":"Chan","name":"Chan, Chee Seng","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Ying","familyName":"He","name":"He, Ying","affiliation":[],"nameIdentifiers":[]}],"titles":[{"title":"VAGNet: Grounding 3D Affordance from Human-Object Interactions in Videos"}],"publisher":"arXiv","container":{},"publicationYear":2026,"subjects":[{"subject":"Computer Vision and Pattern Recognition (cs.CV)","lang":"en","subjectScheme":"arXiv"},{"subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"},{"schemeUri":"http://www.oecd.org/science/inno/38235147.pdf","subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"}],"contributors":[],"dates":[{"date":"2026-02-24T07:00:38Z","dateType":"Submitted","dateInformation":"v1"},{"date":"2026-02-25T01:27:08Z","dateType":"Updated","dateInformation":"v1"},{"date":"2026-02","dateType":"Available","dateInformation":"v1"},{"date":"2026","dateType":"Issued"}],"language":null,"types":{"schemaOrg":"CreativeWork","resourceTypeGeneral":"Preprint","citeproc":"article","bibtex":"misc","ris":"GEN","resourceType":"Article"},"relatedIdentifiers":[],"relatedItems":[],"sizes":[],"formats":[],"version":"1","rightsList":[{"rightsUri":"http://arxiv.org/licenses/nonexclusive-distrib/1.0/","rights":"arXiv.org perpetual, non-exclusive license"}],"descriptions":[{"descriptionType":"Abstract","description":"3D object affordance grounding aims to identify regions on 3D objects that support human-object interaction (HOI), a capability essential to embodied visual reasoning. However, most existing approaches rely on static visual or textual cues, neglecting that affordances are inherently defined by dynamic actions. As a result, they often struggle to localize the true contact regions involved in real interactions. We take a different perspective. Humans learn how to use objects by observing and imitating actions, not just by examining shapes. Motivated by this intuition, we introduce video-guided 3D affordance grounding, which leverages dynamic interaction sequences to provide functional supervision. To achieve this, we propose VAGNet, a framework that aligns video-derived interaction cues with 3D structure to resolve ambiguities that static cues cannot address. To support this new setting, we introduce PVAD, the first HOI video-3D pairing affordance dataset, providing functional supervision unavailable in prior works. Extensive experiments on PVAD show that VAGNet achieves state-of-the-art performance, significantly outperforming static-based baselines. The code and dataset will be open publicly."}],"geoLocations":[],"fundingReferences":[],"url":"https://arxiv.org/abs/2602.20608","contentUrl":null,"metadataVersion":0,"schemaVersion":"http://datacite.org/schema/kernel-4","source":"mds","isActive":true,"state":"findable","reason":null,"viewCount":0,"downloadCount":0,"referenceCount":0,"citationCount":0,"partCount":0,"partOfCount":0,"versionCount":0,"versionOfCount":0,"created":"2026-02-25T02:54:15Z","registered":"2026-02-25T02:54:16Z","published":null,"updated":"2026-02-25T02:54:16Z"},"relationships":{"client":{"data":{"id":"arxiv.content","type":"clients"}}}},{"id":"10.48550/arxiv.2602.20607","type":"dois","attributes":{"doi":"10.48550/arxiv.2602.20607","identifiers":[{"identifier":"2602.20607","identifierType":"arXiv"}],"creators":[{"nameType":"Personal","givenName":"Aleksandar","familyName":"Mijatović","name":"Mijatović, Aleksandar","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Andrey","familyName":"Pilipenko","name":"Pilipenko, Andrey","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Isao","familyName":"Sauzedde","name":"Sauzedde, Isao","affiliation":[],"nameIdentifiers":[]}],"titles":[{"title":"Functional central limit theorem for superdiffusive SDEs with stable noise"}],"publisher":"arXiv","container":{},"publicationYear":2026,"subjects":[{"subject":"Probability (math.PR)","lang":"en","subjectScheme":"arXiv"},{"subject":"FOS: Mathematics","subjectScheme":"Fields of Science and Technology (FOS)"},{"schemeUri":"http://www.oecd.org/science/inno/38235147.pdf","subject":"FOS: Mathematics","subjectScheme":"Fields of Science and Technology (FOS)"},{"subject":"60F17, 60G51","lang":"en","subjectScheme":"MSC"}],"contributors":[],"dates":[{"date":"2026-02-24T07:00:27Z","dateType":"Submitted","dateInformation":"v1"},{"date":"2026-02-25T01:27:07Z","dateType":"Updated","dateInformation":"v1"},{"date":"2026-02","dateType":"Available","dateInformation":"v1"},{"date":"2026","dateType":"Issued"}],"language":null,"types":{"schemaOrg":"CreativeWork","resourceTypeGeneral":"Preprint","citeproc":"article","bibtex":"misc","ris":"GEN","resourceType":"Article"},"relatedIdentifiers":[],"relatedItems":[],"sizes":[],"formats":[],"version":"1","rightsList":[{"rightsUri":"http://arxiv.org/licenses/nonexclusive-distrib/1.0/","rights":"arXiv.org perpetual, non-exclusive license"}],"descriptions":[{"descriptionType":"Abstract","description":"This paper establishes a functional stable central limit theorem for a class of superdiffusive solutions to stochastic differential equations driven by an $α$-stable process."},{"descriptionType":"Other","description":"10 pages"}],"geoLocations":[],"fundingReferences":[],"url":"https://arxiv.org/abs/2602.20607","contentUrl":null,"metadataVersion":0,"schemaVersion":"http://datacite.org/schema/kernel-4","source":"mds","isActive":true,"state":"findable","reason":null,"viewCount":0,"downloadCount":0,"referenceCount":0,"citationCount":0,"partCount":0,"partOfCount":0,"versionCount":0,"versionOfCount":0,"created":"2026-02-25T02:54:14Z","registered":"2026-02-25T02:54:14Z","published":null,"updated":"2026-02-25T02:54:14Z"},"relationships":{"client":{"data":{"id":"arxiv.content","type":"clients"}}}},{"id":"10.48550/arxiv.2602.20605","type":"dois","attributes":{"doi":"10.48550/arxiv.2602.20605","identifiers":[{"identifier":"2602.20605","identifierType":"arXiv"}],"creators":[{"nameType":"Personal","givenName":"Zhijian","familyName":"Lai","name":"Lai, Zhijian","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Hantao","familyName":"Nie","name":"Nie, Hantao","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Jiayuan","familyName":"Wu","name":"Wu, Jiayuan","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Dong","familyName":"An","name":"An, Dong","affiliation":[],"nameIdentifiers":[]}],"titles":[{"title":"Quantum circuit design from a retraction-based Riemannian optimization framework"}],"publisher":"arXiv","container":{},"publicationYear":2026,"subjects":[{"subject":"Quantum Physics (quant-ph)","lang":"en","subjectScheme":"arXiv"},{"subject":"Mathematical Physics (math-ph)","lang":"en","subjectScheme":"arXiv"},{"subject":"Optimization and Control (math.OC)","lang":"en","subjectScheme":"arXiv"},{"subject":"FOS: Physical sciences","subjectScheme":"Fields of Science and Technology (FOS)"},{"schemeUri":"http://www.oecd.org/science/inno/38235147.pdf","subject":"FOS: Physical sciences","subjectScheme":"Fields of Science and Technology (FOS)"},{"subject":"FOS: Mathematics","subjectScheme":"Fields of Science and Technology (FOS)"},{"schemeUri":"http://www.oecd.org/science/inno/38235147.pdf","subject":"FOS: Mathematics","subjectScheme":"Fields of Science and Technology (FOS)"},{"subject":"81P68, 90C26, 65K10","lang":"en","subjectScheme":"MSC"}],"contributors":[],"dates":[{"date":"2026-02-24T06:54:32Z","dateType":"Submitted","dateInformation":"v1"},{"date":"2026-02-25T01:26:59Z","dateType":"Updated","dateInformation":"v1"},{"date":"2026-02","dateType":"Available","dateInformation":"v1"},{"date":"2026","dateType":"Issued"}],"language":null,"types":{"schemaOrg":"CreativeWork","resourceTypeGeneral":"Preprint","citeproc":"article","bibtex":"misc","ris":"GEN","resourceType":"Article"},"relatedIdentifiers":[],"relatedItems":[],"sizes":[],"formats":[],"version":"1","rightsList":[{"rightsUri":"http://arxiv.org/licenses/nonexclusive-distrib/1.0/","rights":"arXiv.org perpetual, non-exclusive license"}],"descriptions":[{"descriptionType":"Abstract","description":"Designing quantum circuits for ground state preparation is a fundamental task in quantum information science. However, standard Variational Quantum Algorithms (VQAs) are often constrained by limited ansatz expressivity and difficult optimization landscapes. To address these issues, we adopt a geometric perspective, formulating the problem as the minimization of an energy cost function directly over the unitary group. We establish a retraction-based Riemannian optimization framework for this setting, ensuring that all algorithmic procedures are implementable on quantum hardware. Within this framework, we unify existing randomized gradient approaches under a Riemannian Random Subspace Gradient Projection (RRSGP) method. While recent geometric approaches have predominantly focused on such first-order gradient descent techniques, efficient second-order methods remain unexplored. To bridge this gap, we derive explicit expressions for the Riemannian Hessian and show that it can be estimated directly on quantum hardware via parameter-shift rules. Building on this, we propose the Riemannian Random Subspace Newton (RRSN) method, a scalable second-order algorithm that constructs a Newton system from measurement data. Numerical simulations indicate that RRSN achieves quadratic convergence, yielding high-precision ground states in significantly fewer iterations compared to both existing first-order approaches and standard VQA baselines. Ultimately, this work provides a systematic foundation for applying a broader class of efficient Riemannian algorithms to quantum circuit design."},{"descriptionType":"Other","description":"28 pages"}],"geoLocations":[],"fundingReferences":[],"url":"https://arxiv.org/abs/2602.20605","contentUrl":null,"metadataVersion":0,"schemaVersion":"http://datacite.org/schema/kernel-4","source":"mds","isActive":true,"state":"findable","reason":null,"viewCount":0,"downloadCount":0,"referenceCount":0,"citationCount":0,"partCount":0,"partOfCount":0,"versionCount":0,"versionOfCount":0,"created":"2026-02-25T02:54:11Z","registered":"2026-02-25T02:54:11Z","published":null,"updated":"2026-02-25T02:54:11Z"},"relationships":{"client":{"data":{"id":"arxiv.content","type":"clients"}}}},{"id":"10.48550/arxiv.2602.20604","type":"dois","attributes":{"doi":"10.48550/arxiv.2602.20604","identifiers":[{"identifier":"2602.20604","identifierType":"arXiv"}],"creators":[{"nameType":"Personal","givenName":"Vaibhav","familyName":"Wasnik","name":"Wasnik, Vaibhav","affiliation":[],"nameIdentifiers":[]}],"titles":[{"title":"Correlator-Level Verification of Mass and Current Maps in Abelian Chern-Simons Dualities"}],"publisher":"arXiv","container":{},"publicationYear":2026,"subjects":[{"subject":"High Energy Physics - Theory (hep-th)","lang":"en","subjectScheme":"arXiv"},{"subject":"FOS: Physical sciences","subjectScheme":"Fields of Science and Technology (FOS)"},{"schemeUri":"http://www.oecd.org/science/inno/38235147.pdf","subject":"FOS: Physical sciences","subjectScheme":"Fields of Science and Technology (FOS)"}],"contributors":[],"dates":[{"date":"2026-02-24T06:53:26Z","dateType":"Submitted","dateInformation":"v1"},{"date":"2026-02-25T01:26:56Z","dateType":"Updated","dateInformation":"v1"},{"date":"2026-02","dateType":"Available","dateInformation":"v1"},{"date":"2026","dateType":"Issued"}],"language":null,"types":{"schemaOrg":"CreativeWork","resourceTypeGeneral":"Preprint","citeproc":"article","bibtex":"misc","ris":"GEN","resourceType":"Article"},"relatedIdentifiers":[],"relatedItems":[],"sizes":[],"formats":[],"version":"1","rightsList":[{"rightsIdentifierScheme":"SPDX","rightsUri":"https://creativecommons.org/licenses/by/4.0/legalcode","schemeUri":"https://spdx.org/licenses/","rights":"Creative Commons Attribution 4.0 International","rightsIdentifier":"cc-by-4.0"}],"descriptions":[{"descriptionType":"Abstract","description":"We construct an explicit local operator realization that reproduces Dirac fermion correlation functions in three spacetime dimensions within an Abelian Chern-Simons framework and use it to examine the conjectured operator and deformation maps of fermion-boson duality directly at the level of correlation functions.\n We show that the predicted relation between bosonic and fermionic mass deformations, including the relative sign, is realized quantitatively, and that the fermionic U(1) current coincides with the topological gauge current inside correlation functions at the infrared fixed point. These results provide a direct correlator-level verification of key features of Abelian Chern-Simons dualities, going beyond arguments based solely on phase structure, anomaly matching, or large-N considerations."}],"geoLocations":[],"fundingReferences":[],"url":"https://arxiv.org/abs/2602.20604","contentUrl":null,"metadataVersion":0,"schemaVersion":"http://datacite.org/schema/kernel-4","source":"mds","isActive":true,"state":"findable","reason":null,"viewCount":0,"downloadCount":0,"referenceCount":0,"citationCount":0,"partCount":0,"partOfCount":0,"versionCount":0,"versionOfCount":0,"created":"2026-02-25T02:54:09Z","registered":"2026-02-25T02:54:10Z","published":null,"updated":"2026-02-25T02:54:10Z"},"relationships":{"client":{"data":{"id":"arxiv.content","type":"clients"}}}},{"id":"10.48550/arxiv.2602.20603","type":"dois","attributes":{"doi":"10.48550/arxiv.2602.20603","identifiers":[{"identifier":"2602.20603","identifierType":"arXiv"}],"creators":[{"nameType":"Personal","givenName":"Yamin","familyName":"Vahmian","name":"Vahmian, Yamin","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Keith","familyName":"Paarporn","name":"Paarporn, Keith","affiliation":[],"nameIdentifiers":[]}],"titles":[{"title":"The Tragedy of the Commons in Multi-Population Resource Games"}],"publisher":"arXiv","container":{},"publicationYear":2026,"subjects":[{"subject":"Computer Science and Game Theory (cs.GT)","lang":"en","subjectScheme":"arXiv"},{"subject":"Multiagent Systems (cs.MA)","lang":"en","subjectScheme":"arXiv"},{"subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"},{"schemeUri":"http://www.oecd.org/science/inno/38235147.pdf","subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"}],"contributors":[],"dates":[{"date":"2026-02-24T06:53:04Z","dateType":"Submitted","dateInformation":"v1"},{"date":"2026-02-25T01:26:55Z","dateType":"Updated","dateInformation":"v1"},{"date":"2026-02","dateType":"Available","dateInformation":"v1"},{"date":"2026","dateType":"Issued"}],"language":null,"types":{"schemaOrg":"CreativeWork","resourceTypeGeneral":"Preprint","citeproc":"article","bibtex":"misc","ris":"GEN","resourceType":"Article"},"relatedIdentifiers":[],"relatedItems":[],"sizes":[],"formats":[],"version":"1","rightsList":[{"rightsUri":"http://arxiv.org/licenses/nonexclusive-distrib/1.0/","rights":"arXiv.org perpetual, non-exclusive license"}],"descriptions":[{"descriptionType":"Abstract","description":"Self-optimizing behaviors can lead to outcomes where collective benefits are ultimately destroyed, a well-known phenomenon known as the ``tragedy of the commons\".\n These scenarios are widely studied using game-theoretic approaches to analyze strategic agent decision-making.\n In this paper, we examine this phenomenon in a bi-level decision-making hierarchy, where low-level agents belong to multiple distinct populations, and high-level agents make decisions that impact the choices of the local populations they represent.\n We study strategic interactions in a context where the populations benefit from a common environmental resource that degrades with higher extractive efforts made by high-level agents.\n We characterize a unique symmetric Nash equilibrium in the high-level game, and investigate its consequences on the common resource.\n While the equilibrium resource level degrades as the number of populations grows large, there are instances where it does not become depleted.\n We identify such regions, as well as the regions where the resource does deplete."},{"descriptionType":"Other","description":"8 pages, 3 figures. Accepted for presentation at the 2026 American Control Conference (ACC)"}],"geoLocations":[],"fundingReferences":[],"url":"https://arxiv.org/abs/2602.20603","contentUrl":null,"metadataVersion":0,"schemaVersion":"http://datacite.org/schema/kernel-4","source":"mds","isActive":true,"state":"findable","reason":null,"viewCount":0,"downloadCount":0,"referenceCount":0,"citationCount":0,"partCount":0,"partOfCount":0,"versionCount":0,"versionOfCount":0,"created":"2026-02-25T02:54:08Z","registered":"2026-02-25T02:54:09Z","published":null,"updated":"2026-02-25T02:54:09Z"},"relationships":{"client":{"data":{"id":"arxiv.content","type":"clients"}}}},{"id":"10.48550/arxiv.2602.20602","type":"dois","attributes":{"doi":"10.48550/arxiv.2602.20602","identifiers":[{"identifier":"2602.20602","identifierType":"arXiv"}],"creators":[{"nameType":"Personal","givenName":"Yiyun","familyName":"Yan","name":"Yan, Yiyun","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Yichao","familyName":"Liu","name":"Liu, Yichao","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Fei","familyName":"Sun","name":"Sun, Fei","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Yuxin","familyName":"Zhou","name":"Zhou, Yuxin","affiliation":[],"nameIdentifiers":[]}],"titles":[{"title":"True Bound States in the Continuum in Compact All-Dielectric Structures"}],"publisher":"arXiv","container":{},"publicationYear":2026,"subjects":[{"subject":"Optics (physics.optics)","lang":"en","subjectScheme":"arXiv"},{"subject":"FOS: Physical sciences","subjectScheme":"Fields of Science and Technology (FOS)"},{"schemeUri":"http://www.oecd.org/science/inno/38235147.pdf","subject":"FOS: Physical sciences","subjectScheme":"Fields of Science and Technology (FOS)"}],"contributors":[],"dates":[{"date":"2026-02-24T06:46:41Z","dateType":"Submitted","dateInformation":"v1"},{"date":"2026-02-25T01:26:42Z","dateType":"Updated","dateInformation":"v1"},{"date":"2026-02","dateType":"Available","dateInformation":"v1"},{"date":"2026","dateType":"Issued"}],"language":null,"types":{"schemaOrg":"CreativeWork","resourceTypeGeneral":"Preprint","citeproc":"article","bibtex":"misc","ris":"GEN","resourceType":"Article"},"relatedIdentifiers":[],"relatedItems":[],"sizes":[],"formats":[],"version":"1","rightsList":[{"rightsUri":"http://arxiv.org/licenses/nonexclusive-distrib/1.0/","rights":"arXiv.org perpetual, non-exclusive license"}],"descriptions":[{"descriptionType":"Abstract","description":"Bound states in the continuum (BICs), known for their theoretically infinite quality (Q) factors and strong field localization, hold great promise for high-performance photonic devices. However, conventional true BICs typically rely on infinitely periodic structures, and their realization in finite-sized compact structures faces fundamental challenges, which severely limits device miniaturization and integration. In this work, a compact BIC design method based on optical conformal mapping is proposed, where a conventionally infinite periodic structure extended along one direction is mapped into a finite-sized annular structure. This symmetry transition, i.e., from translational to rotational, enables structural miniaturization while fully preserving the eigenvalues and BIC type of the original system. These transformations require only the adjustment of background permittivity and source distribution, without introducing extreme material parameters. As a concrete example, we show through theoretical and numerical analysis that a transformed compact all-dielectric structure, consisting of a double annular dielectric grating embedded in a gradient-index dielectric background, can support true BICs in a finite region. This work provides a simple and general strategy for achieving true BICs in compact all-dielectric structures, paving the way toward miniaturized high-Q photonic devices."}],"geoLocations":[],"fundingReferences":[],"url":"https://arxiv.org/abs/2602.20602","contentUrl":null,"metadataVersion":0,"schemaVersion":"http://datacite.org/schema/kernel-4","source":"mds","isActive":true,"state":"findable","reason":null,"viewCount":0,"downloadCount":0,"referenceCount":0,"citationCount":0,"partCount":0,"partOfCount":0,"versionCount":0,"versionOfCount":0,"created":"2026-02-25T02:54:06Z","registered":"2026-02-25T02:54:07Z","published":null,"updated":"2026-02-25T02:54:07Z"},"relationships":{"client":{"data":{"id":"arxiv.content","type":"clients"}}}},{"id":"10.48550/arxiv.2602.20600","type":"dois","attributes":{"doi":"10.48550/arxiv.2602.20600","identifiers":[{"identifier":"2602.20600","identifierType":"arXiv"}],"creators":[{"nameType":"Personal","givenName":"Debraj","familyName":"Debata","name":"Debata, Debraj","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Abhirup","familyName":"Mukherjee","name":"Mukherjee, Abhirup","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Siddhartha","familyName":"Lal","name":"Lal, Siddhartha","affiliation":[],"nameIdentifiers":[]}],"titles":[{"title":"Kondo breakdown as an entanglement transition driven by continuous measurement"}],"publisher":"arXiv","container":{},"publicationYear":2026,"subjects":[{"subject":"Strongly Correlated Electrons (cond-mat.str-el)","lang":"en","subjectScheme":"arXiv"},{"subject":"Mesoscale and Nanoscale Physics (cond-mat.mes-hall)","lang":"en","subjectScheme":"arXiv"},{"subject":"Quantum Physics (quant-ph)","lang":"en","subjectScheme":"arXiv"},{"subject":"FOS: Physical sciences","subjectScheme":"Fields of Science and Technology (FOS)"},{"schemeUri":"http://www.oecd.org/science/inno/38235147.pdf","subject":"FOS: Physical sciences","subjectScheme":"Fields of Science and Technology (FOS)"}],"contributors":[],"dates":[{"date":"2026-02-24T06:45:20Z","dateType":"Submitted","dateInformation":"v1"},{"date":"2026-02-25T01:26:34Z","dateType":"Updated","dateInformation":"v1"},{"date":"2026-02","dateType":"Available","dateInformation":"v1"},{"date":"2026","dateType":"Issued"}],"language":null,"types":{"schemaOrg":"CreativeWork","resourceTypeGeneral":"Preprint","citeproc":"article","bibtex":"misc","ris":"GEN","resourceType":"Article"},"relatedIdentifiers":[],"relatedItems":[],"sizes":[],"formats":[],"version":"1","rightsList":[{"rightsIdentifierScheme":"SPDX","rightsUri":"https://creativecommons.org/licenses/by/4.0/legalcode","schemeUri":"https://spdx.org/licenses/","rights":"Creative Commons Attribution 4.0 International","rightsIdentifier":"cc-by-4.0"}],"descriptions":[{"descriptionType":"Abstract","description":"We study the breakdown of Kondo screening by a local magnetic field from the perspective of a measurement-driven entanglement transition in a monitored quantum system. Here, the Kondo coupling leads to the growth in entanglement of an impurity spin with it's fermionic environment, while the local field plays the role of a continuous observer. Using a non-perturbative Unitary Renormalization Group (URG) approach, we derive coupled renormalization-group flow equations for the Kondo exchange and the local field, and obtain a field-dependent RG phase diagram. The RG flows separate a low-energy Kondo-screened phase, where the impurity is absorbed into the Fermi sea and forms an entangled singlet with the conduction bath, from a polarized local-moment phase in which screening is frustrated and impurity-bath entanglement is suppressed. We identify the fixed-point Hamiltonians governing the two phases and the critical regime, and relate the transition to the emergence of a novel non-Fermi liquid. Various impurity signatures such as the spectral function and thermalisation of impurity observables are used to characterise this entanglement transition. These results offer insight into the interplay of decoherence and measurement in governing the dynamics of a prototypical quantum system."},{"descriptionType":"Other","description":"28 pages, 19 Figures"}],"geoLocations":[],"fundingReferences":[],"url":"https://arxiv.org/abs/2602.20600","contentUrl":null,"metadataVersion":0,"schemaVersion":"http://datacite.org/schema/kernel-4","source":"mds","isActive":true,"state":"findable","reason":null,"viewCount":0,"downloadCount":0,"referenceCount":0,"citationCount":0,"partCount":0,"partOfCount":0,"versionCount":0,"versionOfCount":0,"created":"2026-02-25T02:54:03Z","registered":"2026-02-25T02:54:04Z","published":null,"updated":"2026-02-25T02:54:04Z"},"relationships":{"client":{"data":{"id":"arxiv.content","type":"clients"}}}},{"id":"10.48550/arxiv.2602.20599","type":"dois","attributes":{"doi":"10.48550/arxiv.2602.20599","identifiers":[{"identifier":"2602.20599","identifierType":"arXiv"}],"creators":[{"nameType":"Personal","givenName":"Geonhee","familyName":"Lee","name":"Lee, Geonhee","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Kwonyeol","familyName":"Park","name":"Park, Kwonyeol","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Hyeongjun","familyName":"Park","name":"Park, Hyeongjun","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Jinwoo","familyName":"An","name":"An, Jinwoo","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Junil","familyName":"Choi","name":"Choi, Junil","affiliation":[],"nameIdentifiers":[]}],"titles":[{"title":"Efficient Solvers for Coupling-Aware Beamforming in Continuous Aperture Arrays"}],"publisher":"arXiv","container":{},"publicationYear":2026,"subjects":[{"subject":"Information Theory (cs.IT)","lang":"en","subjectScheme":"arXiv"},{"subject":"Signal Processing (eess.SP)","lang":"en","subjectScheme":"arXiv"},{"subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"},{"schemeUri":"http://www.oecd.org/science/inno/38235147.pdf","subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"},{"subject":"FOS: Electrical engineering, electronic engineering, information engineering","subjectScheme":"Fields of Science and Technology (FOS)"},{"schemeUri":"http://www.oecd.org/science/inno/38235147.pdf","subject":"FOS: Electrical engineering, electronic engineering, information engineering","subjectScheme":"Fields of Science and Technology (FOS)"}],"contributors":[],"dates":[{"date":"2026-02-24T06:45:16Z","dateType":"Submitted","dateInformation":"v1"},{"date":"2026-02-25T01:26:33Z","dateType":"Updated","dateInformation":"v1"},{"date":"2026-02","dateType":"Available","dateInformation":"v1"},{"date":"2026","dateType":"Issued"}],"language":null,"types":{"schemaOrg":"CreativeWork","resourceTypeGeneral":"Preprint","citeproc":"article","bibtex":"misc","ris":"GEN","resourceType":"Article"},"relatedIdentifiers":[],"relatedItems":[],"sizes":[],"formats":[],"version":"1","rightsList":[{"rightsUri":"http://arxiv.org/licenses/nonexclusive-distrib/1.0/","rights":"arXiv.org perpetual, non-exclusive license"}],"descriptions":[{"descriptionType":"Abstract","description":"In continuous aperture arrays (CAPAs), careful consideration of the underlying physics is essential, among which electromagnetic (EM) mutual coupling plays a critical role in beamforming performance. Building on a physically consistent mutual coupling model, the beamforming design is formulated as a functional optimization whose optimality condition leads to a Fredholm integral equation. The incorporation of the coupling model, however, substantially increases computational complexity, necessitating efficient and accurate integral equation solvers. In this letter, we propose two efficient solvers: 1) a coordinate-transformation-based kernel approximation that preserves the operator structure while alleviating discretization demands, and 2) a direct lower-upper (LU)-based solver that stably handles the Nyström-discretized system. Numerical results demonstrate improved accuracy and reduced computational overhead compared to conventional methods, with the LU-based solver emerging as an efficient and scalable solution for large-scale CAPA optimization via offline factorization."},{"descriptionType":"Other","description":"5 pages, 1 fig"}],"geoLocations":[],"fundingReferences":[],"url":"https://arxiv.org/abs/2602.20599","contentUrl":null,"metadataVersion":0,"schemaVersion":"http://datacite.org/schema/kernel-4","source":"mds","isActive":true,"state":"findable","reason":null,"viewCount":0,"downloadCount":0,"referenceCount":0,"citationCount":0,"partCount":0,"partOfCount":0,"versionCount":0,"versionOfCount":0,"created":"2026-02-25T02:54:02Z","registered":"2026-02-25T02:54:03Z","published":null,"updated":"2026-02-25T02:54:03Z"},"relationships":{"client":{"data":{"id":"arxiv.content","type":"clients"}}}},{"id":"10.48550/arxiv.2602.20598","type":"dois","attributes":{"doi":"10.48550/arxiv.2602.20598","identifiers":[{"identifier":"2602.20598","identifierType":"arXiv"}],"creators":[{"nameType":"Personal","givenName":"Shoma","familyName":"Ansai","name":"Ansai, Shoma","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Masaki","familyName":"Waga","name":"Waga, Masaki","affiliation":[],"nameIdentifiers":[]}],"titles":[{"title":"A Case Study on Runtime Verification of a Continuous Deployment Process"}],"publisher":"arXiv","container":{},"publicationYear":2026,"subjects":[{"subject":"Software Engineering (cs.SE)","lang":"en","subjectScheme":"arXiv"},{"subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"},{"schemeUri":"http://www.oecd.org/science/inno/38235147.pdf","subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"}],"contributors":[],"dates":[{"date":"2026-02-24T06:39:48Z","dateType":"Submitted","dateInformation":"v1"},{"date":"2026-02-25T01:26:29Z","dateType":"Updated","dateInformation":"v1"},{"date":"2026-02","dateType":"Available","dateInformation":"v1"},{"date":"2026","dateType":"Issued"}],"language":null,"types":{"schemaOrg":"CreativeWork","resourceTypeGeneral":"Preprint","citeproc":"article","bibtex":"misc","ris":"GEN","resourceType":"Article"},"relatedIdentifiers":[],"relatedItems":[],"sizes":[],"formats":[],"version":"1","rightsList":[{"rightsUri":"http://arxiv.org/licenses/nonexclusive-distrib/1.0/","rights":"arXiv.org perpetual, non-exclusive license"}],"descriptions":[{"descriptionType":"Abstract","description":"We report our experience in applying runtime monitoring to a FluxCD-based continuous deployment (CD) process. Our target system consists of GitHub Actions, GitHub Container Registry (GHCR), FluxCD, and an application running on Kubernetes. We monitored its logs using SyMon. In our setting, we regard a deployment update as detected when FluxCD's polling log resolves the latest image tag. Through the case study, we found that FluxCD did not always detect a new image within five minutes after it was pushed to GHCR, whereas it always did so within ten minutes in the collected logs. Moreover, our results show that SyMon is fast enough for near-real-time monitoring in our setting."},{"descriptionType":"Other","description":"Presented at the Runtime Verification Case-Studies Workshop 2025 (RVCase'25), with no formal proceedings"}],"geoLocations":[],"fundingReferences":[],"url":"https://arxiv.org/abs/2602.20598","contentUrl":null,"metadataVersion":0,"schemaVersion":"http://datacite.org/schema/kernel-4","source":"mds","isActive":true,"state":"findable","reason":null,"viewCount":0,"downloadCount":0,"referenceCount":0,"citationCount":0,"partCount":0,"partOfCount":0,"versionCount":0,"versionOfCount":0,"created":"2026-02-25T02:54:00Z","registered":"2026-02-25T02:54:01Z","published":null,"updated":"2026-02-25T02:54:01Z"},"relationships":{"client":{"data":{"id":"arxiv.content","type":"clients"}}}},{"id":"10.48550/arxiv.2602.20597","type":"dois","attributes":{"doi":"10.48550/arxiv.2602.20597","identifiers":[{"identifier":"2602.20597","identifierType":"arXiv"}],"creators":[{"nameType":"Personal","givenName":"Yuejiao","familyName":"Su","name":"Su, Yuejiao","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Yi","familyName":"Wang","name":"Wang, Yi","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Lei","familyName":"Yao","name":"Yao, Lei","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Yawen","familyName":"Cui","name":"Cui, Yawen","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Lap-Pui","familyName":"Chau","name":"Chau, Lap-Pui","affiliation":[],"nameIdentifiers":[]}],"titles":[{"title":"Interaction-aware Representation Modeling with Co-occurrence Consistency for Egocentric Hand-Object Parsing"}],"publisher":"arXiv","container":{},"publicationYear":2026,"subjects":[{"subject":"Computer Vision and Pattern Recognition (cs.CV)","lang":"en","subjectScheme":"arXiv"},{"subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"},{"schemeUri":"http://www.oecd.org/science/inno/38235147.pdf","subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"}],"contributors":[],"dates":[{"date":"2026-02-24T06:39:18Z","dateType":"Submitted","dateInformation":"v1"},{"date":"2026-02-25T01:26:25Z","dateType":"Updated","dateInformation":"v1"},{"date":"2026-02","dateType":"Available","dateInformation":"v1"},{"date":"2026","dateType":"Issued"}],"language":null,"types":{"schemaOrg":"CreativeWork","resourceTypeGeneral":"Preprint","citeproc":"article","bibtex":"misc","ris":"GEN","resourceType":"Article"},"relatedIdentifiers":[],"relatedItems":[],"sizes":[],"formats":[],"version":"1","rightsList":[{"rightsIdentifierScheme":"SPDX","rightsUri":"https://creativecommons.org/licenses/by/4.0/legalcode","schemeUri":"https://spdx.org/licenses/","rights":"Creative Commons Attribution 4.0 International","rightsIdentifier":"cc-by-4.0"}],"descriptions":[{"descriptionType":"Abstract","description":"A fine-grained understanding of egocentric human-environment interactions is crucial for developing next-generation embodied agents. One fundamental challenge in this area involves accurately parsing hands and active objects. While transformer-based architectures have demonstrated considerable potential for such tasks, several key limitations remain unaddressed: 1) existing query initialization mechanisms rely primarily on semantic cues or learnable parameters, demonstrating limited adaptability to changing active objects across varying input scenes; 2) previous transformer-based methods utilize pixel-level semantic features to iteratively refine queries during mask generation, which may introduce interaction-irrelevant content into the final embeddings; and 3) prevailing models are susceptible to \"interaction illusion\", producing physically inconsistent predictions. To address these issues, we propose an end-to-end Interaction-aware Transformer (InterFormer), which integrates three key components, i.e., a Dynamic Query Generator (DQG), a Dual-context Feature Selector (DFS), and the Conditional Co-occurrence (CoCo) loss. The DQG explicitly grounds query initialization in the spatial dynamics of hand-object contact, enabling targeted generation of interaction-aware queries for hands and various active objects. The DFS fuses coarse interactive cues with semantic features, thereby suppressing interaction-irrelevant noise and emphasizing the learning of interactive relationships. The CoCo loss incorporates hand-object relationship constraints to enhance physical consistency in prediction. Our model achieves state-of-the-art performance on both the EgoHOS and the challenging out-of-distribution mini-HOI4D datasets, demonstrating its effectiveness and strong generalization ability. Code and models are publicly available at https://github.com/yuggiehk/InterFormer."}],"geoLocations":[],"fundingReferences":[],"url":"https://arxiv.org/abs/2602.20597","contentUrl":null,"metadataVersion":0,"schemaVersion":"http://datacite.org/schema/kernel-4","source":"mds","isActive":true,"state":"findable","reason":null,"viewCount":0,"downloadCount":0,"referenceCount":0,"citationCount":0,"partCount":0,"partOfCount":0,"versionCount":0,"versionOfCount":0,"created":"2026-02-25T02:53:59Z","registered":"2026-02-25T02:53:59Z","published":null,"updated":"2026-02-25T02:53:59Z"},"relationships":{"client":{"data":{"id":"arxiv.content","type":"clients"}}}},{"id":"10.48550/arxiv.2602.20595","type":"dois","attributes":{"doi":"10.48550/arxiv.2602.20595","identifiers":[{"identifier":"2602.20595","identifierType":"arXiv"}],"creators":[{"nameType":"Personal","givenName":"Longxiang","familyName":"Wang","name":"Wang, Longxiang","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Xiang","familyName":"Zheng","name":"Zheng, Xiang","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Xuhao","familyName":"Zhang","name":"Zhang, Xuhao","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Yao","familyName":"Zhang","name":"Zhang, Yao","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Ye","familyName":"Wu","name":"Wu, Ye","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Cong","familyName":"Wang","name":"Wang, Cong","affiliation":[],"nameIdentifiers":[]}],"titles":[{"title":"OptiLeak: Efficient Prompt Reconstruction via Reinforcement Learning in Multi-tenant LLM Services"}],"publisher":"arXiv","container":{},"publicationYear":2026,"subjects":[{"subject":"Cryptography and Security (cs.CR)","lang":"en","subjectScheme":"arXiv"},{"subject":"Artificial Intelligence (cs.AI)","lang":"en","subjectScheme":"arXiv"},{"subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"},{"schemeUri":"http://www.oecd.org/science/inno/38235147.pdf","subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"}],"contributors":[],"dates":[{"date":"2026-02-24T06:35:22Z","dateType":"Submitted","dateInformation":"v1"},{"date":"2026-02-25T01:26:19Z","dateType":"Updated","dateInformation":"v1"},{"date":"2026-02","dateType":"Available","dateInformation":"v1"},{"date":"2026","dateType":"Issued"}],"language":null,"types":{"schemaOrg":"CreativeWork","resourceTypeGeneral":"Preprint","citeproc":"article","bibtex":"misc","ris":"GEN","resourceType":"Article"},"relatedIdentifiers":[],"relatedItems":[],"sizes":[],"formats":[],"version":"1","rightsList":[{"rightsIdentifierScheme":"SPDX","rightsUri":"https://creativecommons.org/licenses/by-nc-nd/4.0/legalcode","schemeUri":"https://spdx.org/licenses/","rights":"Creative Commons Attribution Non Commercial No Derivatives 4.0 International","rightsIdentifier":"cc-by-nc-nd-4.0"}],"descriptions":[{"descriptionType":"Abstract","description":"Multi-tenant LLM serving frameworks widely adopt shared Key-Value caches to enhance efficiency. However, this creates side-channel vulnerabilities enabling prompt leakage attacks. Prior studies identified these attack surfaces yet focused on expanding attack vectors rather than optimizing attack performance, reporting impractically high attack costs that underestimate the true privacy risk. We propose OptiLeak, a reinforcement learning-enhanced framework that maximizes prompt reconstruction efficiency through two-stage fine-tuning. Our key insight is that domain-specific ``hard tokens'' -- terms difficult to predict yet carrying sensitive information -- can be automatically identified via likelihood ranking and used to construct preference pairs for Direct Preference Optimization, eliminating manual annotation. This enables effective preference alignment while avoiding the overfitting issues of extended supervised fine-tuning. Evaluated on three benchmarks spanning medical and financial domains, OptiLeak achieves up to $12.48\\times$ reduction in average requests per token compared to baseline approaches, with consistent improvements across model scales from 3B to 14B parameters. Our findings demonstrate that cache-based prompt leakage poses a more severe threat than previously reported, underscoring the need for robust cache isolation in production deployments."}],"geoLocations":[],"fundingReferences":[],"url":"https://arxiv.org/abs/2602.20595","contentUrl":null,"metadataVersion":0,"schemaVersion":"http://datacite.org/schema/kernel-4","source":"mds","isActive":true,"state":"findable","reason":null,"viewCount":0,"downloadCount":0,"referenceCount":0,"citationCount":0,"partCount":0,"partOfCount":0,"versionCount":0,"versionOfCount":0,"created":"2026-02-25T02:53:56Z","registered":"2026-02-25T02:53:56Z","published":null,"updated":"2026-02-25T02:53:56Z"},"relationships":{"client":{"data":{"id":"arxiv.content","type":"clients"}}}},{"id":"10.48550/arxiv.2602.20594","type":"dois","attributes":{"doi":"10.48550/arxiv.2602.20594","identifiers":[{"identifier":"2602.20594","identifierType":"arXiv"}],"creators":[{"nameType":"Personal","givenName":"Takaya","familyName":"Miyama","name":"Miyama, Takaya","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Satoshi","familyName":"Nakamura","name":"Nakamura, Satoshi","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Shota","familyName":"Yamanaka","name":"Yamanaka, Shota","affiliation":[],"nameIdentifiers":[]}],"titles":[{"title":"Improving Data Quality via Pre-Task Participant Screening in Crowdsourced GUI Experiments"}],"publisher":"arXiv","container":{},"publicationYear":2026,"subjects":[{"subject":"Human-Computer Interaction (cs.HC)","lang":"en","subjectScheme":"arXiv"},{"subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"},{"schemeUri":"http://www.oecd.org/science/inno/38235147.pdf","subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"}],"contributors":[],"dates":[{"date":"2026-02-24T06:34:33Z","dateType":"Submitted","dateInformation":"v1"},{"date":"2026-02-25T01:26:15Z","dateType":"Updated","dateInformation":"v1"},{"date":"2026-02","dateType":"Available","dateInformation":"v1"},{"date":"2026","dateType":"Issued"}],"language":null,"types":{"schemaOrg":"CreativeWork","resourceTypeGeneral":"Preprint","citeproc":"article","bibtex":"misc","ris":"GEN","resourceType":"Article"},"relatedIdentifiers":[{"relationType":"IsVersionOf","relatedIdentifier":"10.1145/3772318.3791332","relatedIdentifierType":"DOI"}],"relatedItems":[],"sizes":[],"formats":[],"version":"1","rightsList":[{"rightsUri":"http://arxiv.org/licenses/nonexclusive-distrib/1.0/","rights":"arXiv.org perpetual, non-exclusive license"}],"descriptions":[{"descriptionType":"Abstract","description":"In crowdsourced user experiments that collect performance data from graphical user interface (GUI) interactions, some participants ignore instructions or act carelessly, threatening the validity of performance models. We investigate a pre-task screening method that requires simple GUI operations analogous to the main task and uses the resulting error as a continuous quality signal. Our pre-task is a brief image-resizing task in which workers match an on-screen card to a physical card; workers whose resizing error exceeds a threshold are excluded from the main experiment. The main task is a standardized pointing experiment with well-established models of movement time and error rate. Across mouse- and smartphone-based crowdsourced experiments, we show that reducing the proportion of workers exhibiting unexpected behavior and tightening the pre-task threshold systematically improve the goodness of fit and predictive accuracy of GUI performance models, demonstrating that brief pre-task screening can enhance data quality."},{"descriptionType":"Other","description":"To appear at CHI 2026"}],"geoLocations":[],"fundingReferences":[],"url":"https://arxiv.org/abs/2602.20594","contentUrl":null,"metadataVersion":0,"schemaVersion":"http://datacite.org/schema/kernel-4","source":"mds","isActive":true,"state":"findable","reason":null,"viewCount":0,"downloadCount":0,"referenceCount":0,"citationCount":0,"partCount":0,"partOfCount":0,"versionCount":0,"versionOfCount":1,"created":"2026-02-25T02:53:54Z","registered":"2026-02-25T02:53:55Z","published":null,"updated":"2026-02-25T02:53:55Z"},"relationships":{"client":{"data":{"id":"arxiv.content","type":"clients"}}}},{"id":"10.48550/arxiv.2602.20593","type":"dois","attributes":{"doi":"10.48550/arxiv.2602.20593","identifiers":[{"identifier":"2602.20593","identifierType":"arXiv"}],"creators":[{"nameType":"Personal","givenName":"Yige","familyName":"Liu","name":"Liu, Yige","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Yiwei","familyName":"Lou","name":"Lou, Yiwei","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Che","familyName":"Wang","name":"Wang, Che","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Yongzhi","familyName":"Cao","name":"Cao, Yongzhi","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Hanpin","familyName":"Wang","name":"Wang, Hanpin","affiliation":[],"nameIdentifiers":[]}],"titles":[{"title":"Is the Trigger Essential? A Feature-Based Triggerless Backdoor Attack in Vertical Federated Learning"}],"publisher":"arXiv","container":{},"publicationYear":2026,"subjects":[{"subject":"Machine Learning (cs.LG)","lang":"en","subjectScheme":"arXiv"},{"subject":"Cryptography and Security (cs.CR)","lang":"en","subjectScheme":"arXiv"},{"subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"},{"schemeUri":"http://www.oecd.org/science/inno/38235147.pdf","subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"}],"contributors":[],"dates":[{"date":"2026-02-24T06:33:29Z","dateType":"Submitted","dateInformation":"v1"},{"date":"2026-02-25T01:26:13Z","dateType":"Updated","dateInformation":"v1"},{"date":"2026-02","dateType":"Available","dateInformation":"v1"},{"date":"2026","dateType":"Issued"}],"language":null,"types":{"schemaOrg":"CreativeWork","resourceTypeGeneral":"Preprint","citeproc":"article","bibtex":"misc","ris":"GEN","resourceType":"Article"},"relatedIdentifiers":[],"relatedItems":[],"sizes":[],"formats":[],"version":"1","rightsList":[{"rightsUri":"http://arxiv.org/licenses/nonexclusive-distrib/1.0/","rights":"arXiv.org perpetual, non-exclusive license"}],"descriptions":[{"descriptionType":"Abstract","description":"As a distributed collaborative machine learning paradigm, vertical federated learning (VFL) allows multiple passive parties with distinct features and one active party with labels to collaboratively train a model. Although it is known for the privacy-preserving capabilities, VFL still faces significant privacy and security threats from backdoor attacks. Existing backdoor attacks typically involve an attacker implanting a trigger into the model during the training phase and executing the attack by adding the trigger to the samples during the inference phase. However, in this paper, we find that triggers are not essential for backdoor attacks in VFL. In light of this, we disclose a new backdoor attack pathway in VFL by introducing a feature-based triggerless backdoor attack. This attack operates under a more stringent security assumption, where the attacker is honest-but-curious rather than malicious during the training phase. It comprises three modules: label inference for the targeted backdoor attack, poison generation with amplification and perturbation mechanisms, and backdoor execution to implement the attack. Extensive experiments on five benchmark datasets demonstrate that our attack outperforms three baseline backdoor attacks by 2 to 50 times while minimally impacting the main task. Even in VFL scenarios with 32 passive parties and only one set of auxiliary data, our attack maintains high performance. Moreover, when confronted with distinct defense strategies, our attack remains largely unaffected and exhibits strong robustness. We hope that the disclosure of this triggerless backdoor attack pathway will encourage the community to revisit security threats in VFL scenarios and inspire researchers to develop more robust and practical defense strategies."}],"geoLocations":[],"fundingReferences":[],"url":"https://arxiv.org/abs/2602.20593","contentUrl":null,"metadataVersion":0,"schemaVersion":"http://datacite.org/schema/kernel-4","source":"mds","isActive":true,"state":"findable","reason":null,"viewCount":0,"downloadCount":0,"referenceCount":0,"citationCount":0,"partCount":0,"partOfCount":0,"versionCount":0,"versionOfCount":0,"created":"2026-02-25T02:53:53Z","registered":"2026-02-25T02:53:54Z","published":null,"updated":"2026-02-25T02:53:54Z"},"relationships":{"client":{"data":{"id":"arxiv.content","type":"clients"}}}},{"id":"10.48550/arxiv.2602.20591","type":"dois","attributes":{"doi":"10.48550/arxiv.2602.20591","identifiers":[{"identifier":"2602.20591","identifierType":"arXiv"}],"creators":[{"nameType":"Personal","givenName":"Ping Wong","familyName":"Ng","name":"Ng, Ping Wong","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Cangyuan","familyName":"Wang","name":"Wang, Cangyuan","affiliation":[],"nameIdentifiers":[]}],"titles":[{"title":"A note on purely infinite corona algebras and extensions"}],"publisher":"arXiv","container":{},"publicationYear":2026,"subjects":[{"subject":"Operator Algebras (math.OA)","lang":"en","subjectScheme":"arXiv"},{"subject":"FOS: Mathematics","subjectScheme":"Fields of Science and Technology (FOS)"},{"schemeUri":"http://www.oecd.org/science/inno/38235147.pdf","subject":"FOS: Mathematics","subjectScheme":"Fields of Science and Technology (FOS)"}],"contributors":[],"dates":[{"date":"2026-02-24T06:28:46Z","dateType":"Submitted","dateInformation":"v1"},{"date":"2026-02-25T01:25:56Z","dateType":"Updated","dateInformation":"v1"},{"date":"2026-02","dateType":"Available","dateInformation":"v1"},{"date":"2026","dateType":"Issued"}],"language":null,"types":{"schemaOrg":"CreativeWork","resourceTypeGeneral":"Preprint","citeproc":"article","bibtex":"misc","ris":"GEN","resourceType":"Article"},"relatedIdentifiers":[],"relatedItems":[],"sizes":[],"formats":[],"version":"1","rightsList":[{"rightsUri":"http://arxiv.org/licenses/nonexclusive-distrib/1.0/","rights":"arXiv.org perpetual, non-exclusive license"}],"descriptions":[{"descriptionType":"Abstract","description":"Let $\\mathcal{A}$ be a separable nuclear C*-algebra, and $\\mathcal{B}$ be a nonunital separable simple $\\mathcal{Z}$-stable C*-algebra. Continuing the work from Gabe-Lin-Ng, we classify all essential extensions, with large complement, of the form $$0 \\rightarrow \\mathcal{B} \\rightarrow \\mathcal{E} \\rightarrow \\mathcal{A} \\rightarrow 0,$$ for the following cases: i. $\\mathcal{C}(\\mathcal{B})$ is properly infinite, and the extension is full. ii. $\\mathcal{C}(\\mathcal{B})$ is purely infinite (though not necessarily simple). We also have some more general results."},{"descriptionType":"Other","description":"17 pages"}],"geoLocations":[],"fundingReferences":[],"url":"https://arxiv.org/abs/2602.20591","contentUrl":null,"metadataVersion":0,"schemaVersion":"http://datacite.org/schema/kernel-4","source":"mds","isActive":true,"state":"findable","reason":null,"viewCount":0,"downloadCount":0,"referenceCount":0,"citationCount":0,"partCount":0,"partOfCount":0,"versionCount":0,"versionOfCount":0,"created":"2026-02-25T02:53:50Z","registered":"2026-02-25T02:53:51Z","published":null,"updated":"2026-02-25T02:53:51Z"},"relationships":{"client":{"data":{"id":"arxiv.content","type":"clients"}}}},{"id":"10.48550/arxiv.2602.20590","type":"dois","attributes":{"doi":"10.48550/arxiv.2602.20590","identifiers":[{"identifier":"2602.20590","identifierType":"arXiv"}],"creators":[{"nameType":"Personal","givenName":"Tamir","familyName":"Bendory","name":"Bendory, Tamir","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Dan","familyName":"Edidin","name":"Edidin, Dan","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Josh","familyName":"Katz","name":"Katz, Josh","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Shay","familyName":"Kreymer","name":"Kreymer, Shay","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Nir","familyName":"Sharon","name":"Sharon, Nir","affiliation":[],"nameIdentifiers":[]}],"titles":[{"title":"Provable orbit recovery over SO(3) from the non-uniform second moment"}],"publisher":"arXiv","container":{},"publicationYear":2026,"subjects":[{"subject":"Signal Processing (eess.SP)","lang":"en","subjectScheme":"arXiv"},{"subject":"FOS: Electrical engineering, electronic engineering, information engineering","subjectScheme":"Fields of Science and Technology (FOS)"},{"schemeUri":"http://www.oecd.org/science/inno/38235147.pdf","subject":"FOS: Electrical engineering, electronic engineering, information engineering","subjectScheme":"Fields of Science and Technology (FOS)"}],"contributors":[],"dates":[{"date":"2026-02-24T06:25:22Z","dateType":"Submitted","dateInformation":"v1"},{"date":"2026-02-25T01:25:55Z","dateType":"Updated","dateInformation":"v1"},{"date":"2026-02","dateType":"Available","dateInformation":"v1"},{"date":"2026","dateType":"Issued"}],"language":null,"types":{"schemaOrg":"CreativeWork","resourceTypeGeneral":"Preprint","citeproc":"article","bibtex":"misc","ris":"GEN","resourceType":"Article"},"relatedIdentifiers":[],"relatedItems":[],"sizes":[],"formats":[],"version":"1","rightsList":[{"rightsUri":"http://arxiv.org/licenses/nonexclusive-distrib/1.0/","rights":"arXiv.org perpetual, non-exclusive license"}],"descriptions":[{"descriptionType":"Abstract","description":"We study the recovery of an unknown three-dimensional band-limited signal from multiple noisy observations that are randomly rotated by latent elements of SO(3), where the rotations are drawn from an unknown, non-uniform distribution. Because the rotations are unobserved, only the signal orbit under the rotation group can be recovered. We show that the signal orbit and the rotation distribution are jointly identifiable from the first and second moments. This yields an improved high-noise sample complexity that scales quadratically with the noise variance, rather than cubically as in the uniform-rotation case. We further develop a provable, computationally efficient reconstruction algorithm that recovers the 3-D signal by successively solving a sequence of well-conditioned linear systems. The algorithm is validated through extensive numerical experiments. Our results provide a principled and tractable framework for high-noise 3-D orbit recovery, with potential relevance to cryo-electron microscopy and cryo-electron tomography modeling, where molecules are observed in unknown orientations."}],"geoLocations":[],"fundingReferences":[],"url":"https://arxiv.org/abs/2602.20590","contentUrl":null,"metadataVersion":0,"schemaVersion":"http://datacite.org/schema/kernel-4","source":"mds","isActive":true,"state":"findable","reason":null,"viewCount":0,"downloadCount":0,"referenceCount":0,"citationCount":0,"partCount":0,"partOfCount":0,"versionCount":0,"versionOfCount":0,"created":"2026-02-25T02:53:48Z","registered":"2026-02-25T02:53:49Z","published":null,"updated":"2026-02-25T02:53:49Z"},"relationships":{"client":{"data":{"id":"arxiv.content","type":"clients"}}}},{"id":"10.48550/arxiv.2602.20588","type":"dois","attributes":{"doi":"10.48550/arxiv.2602.20588","identifiers":[{"identifier":"2602.20588","identifierType":"arXiv"}],"creators":[{"nameType":"Personal","givenName":"Xiaoguang","familyName":"Wang","name":"Wang, Xiaoguang","affiliation":[],"nameIdentifiers":[]}],"titles":[{"title":"Continuity of Julia sets and invariant rays"}],"publisher":"arXiv","container":{},"publicationYear":2026,"subjects":[{"subject":"Dynamical Systems (math.DS)","lang":"en","subjectScheme":"arXiv"},{"subject":"Complex Variables (math.CV)","lang":"en","subjectScheme":"arXiv"},{"subject":"FOS: Mathematics","subjectScheme":"Fields of Science and Technology (FOS)"},{"schemeUri":"http://www.oecd.org/science/inno/38235147.pdf","subject":"FOS: Mathematics","subjectScheme":"Fields of Science and Technology (FOS)"}],"contributors":[],"dates":[{"date":"2026-02-24T06:22:21Z","dateType":"Submitted","dateInformation":"v1"},{"date":"2026-02-25T01:25:52Z","dateType":"Updated","dateInformation":"v1"},{"date":"2026-02","dateType":"Available","dateInformation":"v1"},{"date":"2026","dateType":"Issued"}],"language":null,"types":{"schemaOrg":"CreativeWork","resourceTypeGeneral":"Preprint","citeproc":"article","bibtex":"misc","ris":"GEN","resourceType":"Article"},"relatedIdentifiers":[],"relatedItems":[],"sizes":[],"formats":[],"version":"1","rightsList":[{"rightsUri":"http://arxiv.org/licenses/nonexclusive-distrib/1.0/","rights":"arXiv.org perpetual, non-exclusive license"}],"descriptions":[{"descriptionType":"Abstract","description":"For certain typical perturbations $(f_n)_n$ of a rational map $f$ with parabolic cycles, we investigate the relations between the Hausdorff convergence of Julia sets and invariant rays, and the horocyclic convergence of multipliers of periodic points. We establish several equivalent characterizations by means of parabolic implosion theory. This builds upon an analysis of the edge dynamics on the tree for the gate structure induced by the perturbation. The edge dynamics which are driven by Oudkerk's algorithm, are used to trace the orbits for the near parabolic perturbations."},{"descriptionType":"Other","description":"38 pages, 15 figures"}],"geoLocations":[],"fundingReferences":[],"url":"https://arxiv.org/abs/2602.20588","contentUrl":null,"metadataVersion":0,"schemaVersion":"http://datacite.org/schema/kernel-4","source":"mds","isActive":true,"state":"findable","reason":null,"viewCount":0,"downloadCount":0,"referenceCount":0,"citationCount":0,"partCount":0,"partOfCount":0,"versionCount":0,"versionOfCount":0,"created":"2026-02-25T02:53:46Z","registered":"2026-02-25T02:53:46Z","published":null,"updated":"2026-02-25T02:53:46Z"},"relationships":{"client":{"data":{"id":"arxiv.content","type":"clients"}}}},{"id":"10.48550/arxiv.2602.20587","type":"dois","attributes":{"doi":"10.48550/arxiv.2602.20587","identifiers":[{"identifier":"2602.20587","identifierType":"arXiv"}],"creators":[{"nameType":"Personal","givenName":"C.","familyName":"Kathiravan","name":"Kathiravan, C.","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"V.","familyName":"Muthupriyal","name":"Muthupriyal, V.","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"R.","familyName":"Ramesh","name":"Ramesh, R.","affiliation":[],"nameIdentifiers":[]}],"titles":[{"title":"Constraining the onset height of coronal mass ejection driven shocks using near-Sun observations in visible and radio wavelengths"}],"publisher":"arXiv","container":{},"publicationYear":2026,"subjects":[{"subject":"Solar and Stellar Astrophysics (astro-ph.SR)","lang":"en","subjectScheme":"arXiv"},{"subject":"FOS: Physical sciences","subjectScheme":"Fields of Science and Technology (FOS)"},{"schemeUri":"http://www.oecd.org/science/inno/38235147.pdf","subject":"FOS: Physical sciences","subjectScheme":"Fields of Science and Technology (FOS)"}],"contributors":[],"dates":[{"date":"2026-02-24T06:21:18Z","dateType":"Submitted","dateInformation":"v1"},{"date":"2026-02-25T01:25:51Z","dateType":"Updated","dateInformation":"v1"},{"date":"2026-02","dateType":"Available","dateInformation":"v1"},{"date":"2026","dateType":"Issued"}],"language":null,"types":{"schemaOrg":"CreativeWork","resourceTypeGeneral":"Preprint","citeproc":"article","bibtex":"misc","ris":"GEN","resourceType":"Article"},"relatedIdentifiers":[],"relatedItems":[],"sizes":[],"formats":[],"version":"1","rightsList":[{"rightsIdentifierScheme":"SPDX","rightsUri":"https://creativecommons.org/publicdomain/zero/1.0/legalcode","schemeUri":"https://spdx.org/licenses/","rights":"Creative Commons Zero v1.0 Universal","rightsIdentifier":"cc0-1.0"}],"descriptions":[{"descriptionType":"Abstract","description":"One of the debated issues about the onset of the type II radio bursts near the Sun is the heliocentric distance ($r$) at which the associated magnetohydrodynamic (MHD) shocks are formed, and the association of the latter with the coronal mass ejections (CMEs). The debate is primarily due to the absence of routine CME observations in whitelight at $r\\,{\u0026lt;}\\,1.5R_{\\odot}$. We present here an example for how joint observations with the Visible Emission Line Coronagraph (VELC) onboard the recently launched ADITYA-L1 (the first dedicated Indian space solar mission, \\citealp{Parate2025}), and Gauribidanur radio facilities could be useful to address the issue."},{"descriptionType":"Other","description":"The paper has been accepted for publication in JAA"}],"geoLocations":[],"fundingReferences":[],"url":"https://arxiv.org/abs/2602.20587","contentUrl":null,"metadataVersion":0,"schemaVersion":"http://datacite.org/schema/kernel-4","source":"mds","isActive":true,"state":"findable","reason":null,"viewCount":0,"downloadCount":0,"referenceCount":0,"citationCount":0,"partCount":0,"partOfCount":0,"versionCount":0,"versionOfCount":0,"created":"2026-02-25T02:53:44Z","registered":"2026-02-25T02:53:45Z","published":null,"updated":"2026-02-25T02:53:45Z"},"relationships":{"client":{"data":{"id":"arxiv.content","type":"clients"}}}},{"id":"10.48550/arxiv.2602.20586","type":"dois","attributes":{"doi":"10.48550/arxiv.2602.20586","identifiers":[{"identifier":"2602.20586","identifierType":"arXiv"}],"creators":[{"nameType":"Personal","givenName":"Tao-Tao","familyName":"Sui","name":"Sui, Tao-Tao","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Xiang-Cheng","familyName":"Meng","name":"Meng, Xiang-Cheng","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Xin-Yang","familyName":"Wang","name":"Wang, Xin-Yang","affiliation":[],"nameIdentifiers":[]}],"titles":[{"title":"Imprints of the Lorentz-symmetry breaking on the precessing jet nozzle of M87*"}],"publisher":"arXiv","container":{},"publicationYear":2026,"subjects":[{"subject":"General Relativity and Quantum Cosmology (gr-qc)","lang":"en","subjectScheme":"arXiv"},{"subject":"High Energy Physics - Experiment (hep-ex)","lang":"en","subjectScheme":"arXiv"},{"subject":"FOS: Physical sciences","subjectScheme":"Fields of Science and Technology (FOS)"},{"schemeUri":"http://www.oecd.org/science/inno/38235147.pdf","subject":"FOS: Physical sciences","subjectScheme":"Fields of Science and Technology (FOS)"}],"contributors":[],"dates":[{"date":"2026-02-24T06:19:33Z","dateType":"Submitted","dateInformation":"v1"},{"date":"2026-02-25T01:25:42Z","dateType":"Updated","dateInformation":"v1"},{"date":"2026-02","dateType":"Available","dateInformation":"v1"},{"date":"2026","dateType":"Issued"}],"language":null,"types":{"schemaOrg":"CreativeWork","resourceTypeGeneral":"Preprint","citeproc":"article","bibtex":"misc","ris":"GEN","resourceType":"Article"},"relatedIdentifiers":[],"relatedItems":[],"sizes":[],"formats":[],"version":"1","rightsList":[{"rightsIdentifierScheme":"SPDX","rightsUri":"https://creativecommons.org/licenses/by/4.0/legalcode","schemeUri":"https://spdx.org/licenses/","rights":"Creative Commons Attribution 4.0 International","rightsIdentifier":"cc-by-4.0"}],"descriptions":[{"descriptionType":"Abstract","description":"The approximately 11-year jet precession period observed in M87* strongly suggests that the supermassive rotating black hole with a tilted accretion disk, which could provide a powerful constraint for confining the parameters of black hole. In this paper, our aim is to utilize the observations of M87* to preliminarily constrain the parameters of the rotating black hole in Bumblebee gravity by modeling the motion of the tilted accretion disk particle with the spherical orbits. We compute spherical orbits and ISSOs, demonstrating that the conserved quantities energy $\\mathcal{E}$, angular momentum $\\mathcal{L}$, and Carter constan $\\mathcal{K}$ depend on $(r,a,\\ell,ζ)$, exhibiting distinct behaviors for prograde and retrograde orbits. For prograde orbits, the ISSO radius $r_{ISSO}$ decreases with spin parameter $a$ and LSB parameter $\\ell$ and increases with the tilt angular $ζ$, whereas the opposite trends occur for retrograde orbits. Angular analysis shows that $θ$ oscillates within $(π/2-ζ, π/2+ζ)$, while $ϕ$ increases approximately linearly, enabling the determination of the oscillation period $T_θ$, azimuthal accumulation $ϕ(T_θ)/π$, and precession angular velocity $ω_t$. Using the observed jet precession period $T=11.24 \\pm 0.47$ years with a fixed tilt $ζ=1.25^\\circ$, the warp radius $r/M$ ranges from $(5.73,25.15)$ for prograde and $(6.16,26.46)$ for retrograde orbits, increasing with $a$ or $\\ell$. Comparisons with Kerr limits ($r/M=14.12$ prograde, $16.1$ retrograde) suggest that $r/M\u0026gt;16$ may indicate a non-vacuum Bumblebee vector field. Incorporating the EHT shadow $θ_{sh}=42\\pm3μ$as further constrains $r/M$ to $(5.82,22.61)$ and $(6.17,24.74)$, with discrepancies of $0.05\\sim1.96$."},{"descriptionType":"Other","description":"11pages, 7figures"}],"geoLocations":[],"fundingReferences":[],"url":"https://arxiv.org/abs/2602.20586","contentUrl":null,"metadataVersion":0,"schemaVersion":"http://datacite.org/schema/kernel-4","source":"mds","isActive":true,"state":"findable","reason":null,"viewCount":0,"downloadCount":0,"referenceCount":0,"citationCount":0,"partCount":0,"partOfCount":0,"versionCount":0,"versionOfCount":0,"created":"2026-02-25T02:53:43Z","registered":"2026-02-25T02:53:43Z","published":null,"updated":"2026-02-25T02:53:43Z"},"relationships":{"client":{"data":{"id":"arxiv.content","type":"clients"}}}},{"id":"10.48550/arxiv.2602.20585","type":"dois","attributes":{"doi":"10.48550/arxiv.2602.20585","identifiers":[{"identifier":"2602.20585","identifierType":"arXiv"}],"creators":[{"nameType":"Personal","givenName":"Moïse","familyName":"Blanchard","name":"Blanchard, Moïse","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Abhishek","familyName":"Shetty","name":"Shetty, Abhishek","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Alexander","familyName":"Rakhlin","name":"Rakhlin, Alexander","affiliation":[],"nameIdentifiers":[]}],"titles":[{"title":"Characterizing Online and Private Learnability under Distributional Constraints via Generalized Smoothness"}],"publisher":"arXiv","container":{},"publicationYear":2026,"subjects":[{"subject":"Machine Learning (stat.ML)","lang":"en","subjectScheme":"arXiv"},{"subject":"Machine Learning (cs.LG)","lang":"en","subjectScheme":"arXiv"},{"subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"},{"schemeUri":"http://www.oecd.org/science/inno/38235147.pdf","subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"}],"contributors":[],"dates":[{"date":"2026-02-24T06:15:59Z","dateType":"Submitted","dateInformation":"v1"},{"date":"2026-02-25T01:25:32Z","dateType":"Updated","dateInformation":"v1"},{"date":"2026-02","dateType":"Available","dateInformation":"v1"},{"date":"2026","dateType":"Issued"}],"language":null,"types":{"schemaOrg":"CreativeWork","resourceTypeGeneral":"Preprint","citeproc":"article","bibtex":"misc","ris":"GEN","resourceType":"Article"},"relatedIdentifiers":[],"relatedItems":[],"sizes":[],"formats":[],"version":"1","rightsList":[{"rightsUri":"http://arxiv.org/licenses/nonexclusive-distrib/1.0/","rights":"arXiv.org perpetual, non-exclusive license"}],"descriptions":[{"descriptionType":"Abstract","description":"Understanding minimal assumptions that enable learning and generalization is perhaps the central question of learning theory. Several celebrated results in statistical learning theory, such as the VC theorem and Littlestone's characterization of online learnability, establish conditions on the hypothesis class that allow for learning under independent data and adversarial data, respectively. Building upon recent work bridging these extremes, we study sequential decision making under distributional adversaries that can adaptively choose data-generating distributions from a fixed family $U$ and ask when such problems are learnable with sample complexity that behaves like the favorable independent case. We provide a near complete characterization of families $U$ that admit learnability in terms of a notion known as generalized smoothness i.e. a distribution family admits VC-dimension-dependent regret bounds for every finite-VC hypothesis class if and only if it is generalized smooth. Further, we give universal algorithms that achieve low regret under any generalized smooth adversary without explicit knowledge of $U$. Finally, when $U$ is known, we provide refined bounds in terms of a combinatorial parameter, the fragmentation number, that captures how many disjoint regions can carry nontrivial mass under $U$. These results provide a nearly complete understanding of learnability under distributional adversaries. In addition, building upon the surprising connection between online learning and differential privacy, we show that the generalized smoothness also characterizes private learnability under distributional constraints."}],"geoLocations":[],"fundingReferences":[],"url":"https://arxiv.org/abs/2602.20585","contentUrl":null,"metadataVersion":0,"schemaVersion":"http://datacite.org/schema/kernel-4","source":"mds","isActive":true,"state":"findable","reason":null,"viewCount":0,"downloadCount":0,"referenceCount":0,"citationCount":0,"partCount":0,"partOfCount":0,"versionCount":0,"versionOfCount":0,"created":"2026-02-25T02:53:41Z","registered":"2026-02-25T02:53:42Z","published":null,"updated":"2026-02-25T02:53:42Z"},"relationships":{"client":{"data":{"id":"arxiv.content","type":"clients"}}}},{"id":"10.48550/arxiv.2602.20584","type":"dois","attributes":{"doi":"10.48550/arxiv.2602.20584","identifiers":[{"identifier":"2602.20584","identifierType":"arXiv"}],"creators":[{"nameType":"Personal","givenName":"Beverley","familyName":"Gorry","name":"Gorry, Beverley","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Tobias","familyName":"Fischer","name":"Fischer, Tobias","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Michael","familyName":"Milford","name":"Milford, Michael","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Alejandro","familyName":"Fontan","name":"Fontan, Alejandro","affiliation":[],"nameIdentifiers":[]}],"titles":[{"title":"Long-Term Multi-Session 3D Reconstruction Under Substantial Appearance Change"}],"publisher":"arXiv","container":{},"publicationYear":2026,"subjects":[{"subject":"Computer Vision and Pattern Recognition (cs.CV)","lang":"en","subjectScheme":"arXiv"},{"subject":"Robotics (cs.RO)","lang":"en","subjectScheme":"arXiv"},{"subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"},{"schemeUri":"http://www.oecd.org/science/inno/38235147.pdf","subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"}],"contributors":[],"dates":[{"date":"2026-02-24T06:12:51Z","dateType":"Submitted","dateInformation":"v1"},{"date":"2026-02-25T01:25:21Z","dateType":"Updated","dateInformation":"v1"},{"date":"2026-02","dateType":"Available","dateInformation":"v1"},{"date":"2026","dateType":"Issued"}],"language":null,"types":{"schemaOrg":"CreativeWork","resourceTypeGeneral":"Preprint","citeproc":"article","bibtex":"misc","ris":"GEN","resourceType":"Article"},"relatedIdentifiers":[],"relatedItems":[],"sizes":[],"formats":[],"version":"1","rightsList":[{"rightsUri":"http://arxiv.org/licenses/nonexclusive-distrib/1.0/","rights":"arXiv.org perpetual, non-exclusive license"}],"descriptions":[{"descriptionType":"Abstract","description":"Long-term environmental monitoring requires the ability to reconstruct and align 3D models across repeated site visits separated by months or years. However, existing Structure-from-Motion (SfM) pipelines implicitly assume near-simultaneous image capture and limited appearance change, and therefore fail when applied to long-term monitoring scenarios such as coral reef surveys, where substantial visual and structural change is common. In this paper, we show that the primary limitation of current approaches lies in their reliance on post-hoc alignment of independently reconstructed sessions, which is insufficient under large temporal appearance change. We address this limitation by enforcing cross-session correspondences directly within a joint SfM reconstruction. Our approach combines complementary handcrafted and learned visual features to robustly establish correspondences across large temporal gaps, enabling the reconstruction of a single coherent 3D model from imagery captured years apart, where standard independent and joint SfM pipelines break down. We evaluate our method on long-term coral reef datasets exhibiting significant real-world change, and demonstrate consistent joint reconstruction across sessions in cases where existing methods fail to produce coherent reconstructions. To ensure scalability to large datasets, we further restrict expensive learned feature matching to a small set of likely cross-session image pairs identified via visual place recognition, which reduces computational cost and improves alignment robustness."}],"geoLocations":[],"fundingReferences":[],"url":"https://arxiv.org/abs/2602.20584","contentUrl":null,"metadataVersion":0,"schemaVersion":"http://datacite.org/schema/kernel-4","source":"mds","isActive":true,"state":"findable","reason":null,"viewCount":0,"downloadCount":0,"referenceCount":0,"citationCount":0,"partCount":0,"partOfCount":0,"versionCount":0,"versionOfCount":0,"created":"2026-02-25T02:53:40Z","registered":"2026-02-25T02:53:40Z","published":null,"updated":"2026-02-25T02:53:40Z"},"relationships":{"client":{"data":{"id":"arxiv.content","type":"clients"}}}},{"id":"10.48550/arxiv.2602.20583","type":"dois","attributes":{"doi":"10.48550/arxiv.2602.20583","identifiers":[{"identifier":"2602.20583","identifierType":"arXiv"}],"creators":[{"nameType":"Personal","givenName":"Wonyong","familyName":"Seo","name":"Seo, Wonyong","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Jaeho","familyName":"Moon","name":"Moon, Jaeho","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Jaehyup","familyName":"Lee","name":"Lee, Jaehyup","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Soo Ye","familyName":"Kim","name":"Kim, Soo Ye","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Munchurl","familyName":"Kim","name":"Kim, Munchurl","affiliation":[],"nameIdentifiers":[]}],"titles":[{"title":"PropFly: Learning to Propagate via On-the-Fly Supervision from Pre-trained Video Diffusion Models"}],"publisher":"arXiv","container":{},"publicationYear":2026,"subjects":[{"subject":"Computer Vision and Pattern Recognition (cs.CV)","lang":"en","subjectScheme":"arXiv"},{"subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"},{"schemeUri":"http://www.oecd.org/science/inno/38235147.pdf","subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"}],"contributors":[],"dates":[{"date":"2026-02-24T06:11:08Z","dateType":"Submitted","dateInformation":"v1"},{"date":"2026-02-25T01:25:16Z","dateType":"Updated","dateInformation":"v1"},{"date":"2026-02","dateType":"Available","dateInformation":"v1"},{"date":"2026","dateType":"Issued"}],"language":null,"types":{"schemaOrg":"CreativeWork","resourceTypeGeneral":"Preprint","citeproc":"article","bibtex":"misc","ris":"GEN","resourceType":"Article"},"relatedIdentifiers":[],"relatedItems":[],"sizes":[],"formats":[],"version":"1","rightsList":[{"rightsIdentifierScheme":"SPDX","rightsUri":"https://creativecommons.org/licenses/by/4.0/legalcode","schemeUri":"https://spdx.org/licenses/","rights":"Creative Commons Attribution 4.0 International","rightsIdentifier":"cc-by-4.0"}],"descriptions":[{"descriptionType":"Abstract","description":"Propagation-based video editing enables precise user control by propagating a single edited frame into following frames while maintaining the original context such as motion and structures. However, training such models requires large-scale, paired (source and edited) video datasets, which are costly and complex to acquire. Hence, we propose the PropFly, a training pipeline for Propagation-based video editing, relying on on-the-Fly supervision from pre-trained video diffusion models (VDMs) instead of requiring off-the-shelf or precomputed paired video editing datasets. Specifically, our PropFly leverages one-step clean latent estimations from intermediate noised latents with varying Classifier-Free Guidance (CFG) scales to synthesize diverse pairs of 'source' (low-CFG) and 'edited' (high-CFG) latents on-the-fly. The source latent serves as structural information of the video, while the edited latent provides the target transformation for learning propagation. Our pipeline enables an additional adapter attached to the pre-trained VDM to learn to propagate edits via Guidance-Modulated Flow Matching (GMFM) loss, which guides the model to replicate the target transformation. Our on-the-fly supervision ensures the model to learn temporally consistent and dynamic transformations. Extensive experiments demonstrate that our PropFly significantly outperforms the state-of-the-art methods on various video editing tasks, producing high-quality editing results."},{"descriptionType":"Other","description":"The first two authors contributed equally to this work (equal contribution)"}],"geoLocations":[],"fundingReferences":[],"url":"https://arxiv.org/abs/2602.20583","contentUrl":null,"metadataVersion":0,"schemaVersion":"http://datacite.org/schema/kernel-4","source":"mds","isActive":true,"state":"findable","reason":null,"viewCount":0,"downloadCount":0,"referenceCount":0,"citationCount":0,"partCount":0,"partOfCount":0,"versionCount":0,"versionOfCount":0,"created":"2026-02-25T02:53:38Z","registered":"2026-02-25T02:53:39Z","published":null,"updated":"2026-02-25T02:53:39Z"},"relationships":{"client":{"data":{"id":"arxiv.content","type":"clients"}}}},{"id":"10.48550/arxiv.2602.20582","type":"dois","attributes":{"doi":"10.48550/arxiv.2602.20582","identifiers":[{"identifier":"2602.20582","identifierType":"arXiv"}],"creators":[{"nameType":"Personal","givenName":"Zihao","familyName":"Wang","name":"Wang, Zihao","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Guoliang","familyName":"Li","name":"Li, Guoliang","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Changrui","familyName":"Liu","name":"Liu, Changrui","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Yue","familyName":"Hu","name":"Hu, Yue","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Zeying","familyName":"Zhong","name":"Zhong, Zeying","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Changxi","familyName":"Yang","name":"Yang, Changxi","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Junqiu","familyName":"Liu","name":"Liu, Junqiu","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Chengying","familyName":"Bao","name":"Bao, Chengying","affiliation":[],"nameIdentifiers":[]}],"titles":[{"title":"Photonic timing-engineered solitons for dual-microcomb metrology"}],"publisher":"arXiv","container":{},"publicationYear":2026,"subjects":[{"subject":"Optics (physics.optics)","lang":"en","subjectScheme":"arXiv"},{"subject":"FOS: Physical sciences","subjectScheme":"Fields of Science and Technology (FOS)"},{"schemeUri":"http://www.oecd.org/science/inno/38235147.pdf","subject":"FOS: Physical sciences","subjectScheme":"Fields of Science and Technology (FOS)"}],"contributors":[],"dates":[{"date":"2026-02-24T06:07:05Z","dateType":"Submitted","dateInformation":"v1"},{"date":"2026-02-25T01:25:06Z","dateType":"Updated","dateInformation":"v1"},{"date":"2026-02","dateType":"Available","dateInformation":"v1"},{"date":"2026","dateType":"Issued"}],"language":null,"types":{"schemaOrg":"CreativeWork","resourceTypeGeneral":"Preprint","citeproc":"article","bibtex":"misc","ris":"GEN","resourceType":"Article"},"relatedIdentifiers":[],"relatedItems":[],"sizes":[],"formats":[],"version":"1","rightsList":[{"rightsIdentifierScheme":"SPDX","rightsUri":"https://creativecommons.org/licenses/by/4.0/legalcode","schemeUri":"https://spdx.org/licenses/","rights":"Creative Commons Attribution 4.0 International","rightsIdentifier":"cc-by-4.0"}],"descriptions":[{"descriptionType":"Abstract","description":"Dissipative microcavity solitons offer a route to integrate comb-based metrology systems on photonic chips. However, integrated solitons generally lack agile control of comb parameters, particularly pulse timing control, hindering their application in quantum-limited metrology. Here we introduce dynamical soliton trapping to enable optically timing-engineered microcombs (OTEM). By injecting an auxiliary laser to anchor one of the microcomb lines, we create a potential well to trap and steer the soliton. Thus, soliton timing can be engineered by phase modulating the injected laser. Theory and measurement reveal the fast response bandwidth of the OTEM, which enabled a soliton slew rate of 31.3 ps/$μ$s, surpassing existing time-programmable fiber laser combs by more than two orders of magnitude. Leveraging the timing scan, we used a single OTEM for single-pixel and parallel ranging by retrieving the phase of the multi-heterodyne beat spectrum. Picometer-scale ranging precision was achieved, establishing new record for optical absolute ranging. Our work can transform timing-engineering of microcavity solitons and endow integrated dual-microcomb metrology systems with enhanced precision."}],"geoLocations":[],"fundingReferences":[],"url":"https://arxiv.org/abs/2602.20582","contentUrl":null,"metadataVersion":0,"schemaVersion":"http://datacite.org/schema/kernel-4","source":"mds","isActive":true,"state":"findable","reason":null,"viewCount":0,"downloadCount":0,"referenceCount":0,"citationCount":0,"partCount":0,"partOfCount":0,"versionCount":0,"versionOfCount":0,"created":"2026-02-25T02:53:37Z","registered":"2026-02-25T02:53:38Z","published":null,"updated":"2026-02-25T02:53:38Z"},"relationships":{"client":{"data":{"id":"arxiv.content","type":"clients"}}}},{"id":"10.48550/arxiv.2602.20581","type":"dois","attributes":{"doi":"10.48550/arxiv.2602.20581","identifiers":[{"identifier":"2602.20581","identifierType":"arXiv"}],"creators":[{"nameType":"Personal","givenName":"Zhiheng","familyName":"You","name":"You, Zhiheng","affiliation":[],"nameIdentifiers":[]}],"titles":[{"title":"Using Prior Studies to Design Experiments: An Empirical Bayes Approach"}],"publisher":"arXiv","container":{},"publicationYear":2026,"subjects":[{"subject":"Econometrics (econ.EM)","lang":"en","subjectScheme":"arXiv"},{"subject":"FOS: Economics and business","subjectScheme":"Fields of Science and Technology (FOS)"},{"schemeUri":"http://www.oecd.org/science/inno/38235147.pdf","subject":"FOS: Economics and business","subjectScheme":"Fields of Science and Technology (FOS)"}],"contributors":[],"dates":[{"date":"2026-02-24T06:02:43Z","dateType":"Submitted","dateInformation":"v1"},{"date":"2026-02-25T01:24:58Z","dateType":"Updated","dateInformation":"v1"},{"date":"2026-02","dateType":"Available","dateInformation":"v1"},{"date":"2026","dateType":"Issued"}],"language":null,"types":{"schemaOrg":"CreativeWork","resourceTypeGeneral":"Preprint","citeproc":"article","bibtex":"misc","ris":"GEN","resourceType":"Article"},"relatedIdentifiers":[],"relatedItems":[],"sizes":[],"formats":[],"version":"1","rightsList":[{"rightsUri":"http://arxiv.org/licenses/nonexclusive-distrib/1.0/","rights":"arXiv.org perpetual, non-exclusive license"}],"descriptions":[{"descriptionType":"Abstract","description":"We develop an empirical Bayes framework for experimental design that leverages information from prior related studies. When a researcher has access to estimates from previous studies on similar parameters, they can use empirical Bayes to estimate an informative prior over the parameter of interest in the new study. We show how this prior can be incorporated into a decision-theoretic experimental design framework to choose optimal design. The approach is illustrated via propensity score designs in stratified randomized experiments. Our theoretical results show that the empirical Bayes design achieves oracle-optimal performance as the number of prior studies grows, and characterize the rate at which regret vanishes. To illustrate the approach, we present two empirical applications--oncology drug trials and the Tennessee Project STAR experiment. Our framework connects the Bayesian meta-analysis literature to experimental design and provides practical guidance for researchers seeking to design more efficient experiments."}],"geoLocations":[],"fundingReferences":[],"url":"https://arxiv.org/abs/2602.20581","contentUrl":null,"metadataVersion":0,"schemaVersion":"http://datacite.org/schema/kernel-4","source":"mds","isActive":true,"state":"findable","reason":null,"viewCount":0,"downloadCount":0,"referenceCount":0,"citationCount":0,"partCount":0,"partOfCount":0,"versionCount":0,"versionOfCount":0,"created":"2026-02-25T02:53:36Z","registered":"2026-02-25T02:53:36Z","published":null,"updated":"2026-02-25T02:53:36Z"},"relationships":{"client":{"data":{"id":"arxiv.content","type":"clients"}}}},{"id":"10.48550/arxiv.2602.20580","type":"dois","attributes":{"doi":"10.48550/arxiv.2602.20580","identifiers":[{"identifier":"2602.20580","identifierType":"arXiv"}],"creators":[{"nameType":"Personal","givenName":"Nishant","familyName":"Subramani","name":"Subramani, Nishant","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Kshitish","familyName":"Ghate","name":"Ghate, Kshitish","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Mona","familyName":"Diab","name":"Diab, Mona","affiliation":[],"nameIdentifiers":[]}],"titles":[{"title":"Personal Information Parroting in Language Models"}],"publisher":"arXiv","container":{},"publicationYear":2026,"subjects":[{"subject":"Computation and Language (cs.CL)","lang":"en","subjectScheme":"arXiv"},{"subject":"Artificial Intelligence (cs.AI)","lang":"en","subjectScheme":"arXiv"},{"subject":"Cryptography and Security (cs.CR)","lang":"en","subjectScheme":"arXiv"},{"subject":"Machine Learning (cs.LG)","lang":"en","subjectScheme":"arXiv"},{"subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"},{"schemeUri":"http://www.oecd.org/science/inno/38235147.pdf","subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"}],"contributors":[],"dates":[{"date":"2026-02-24T06:02:03Z","dateType":"Submitted","dateInformation":"v1"},{"date":"2026-02-25T01:24:55Z","dateType":"Updated","dateInformation":"v1"},{"date":"2026-02","dateType":"Available","dateInformation":"v1"},{"date":"2026","dateType":"Issued"}],"language":null,"types":{"schemaOrg":"CreativeWork","resourceTypeGeneral":"Preprint","citeproc":"article","bibtex":"misc","ris":"GEN","resourceType":"Article"},"relatedIdentifiers":[],"relatedItems":[],"sizes":[],"formats":[],"version":"1","rightsList":[{"rightsIdentifierScheme":"SPDX","rightsUri":"https://creativecommons.org/licenses/by/4.0/legalcode","schemeUri":"https://spdx.org/licenses/","rights":"Creative Commons Attribution 4.0 International","rightsIdentifier":"cc-by-4.0"}],"descriptions":[{"descriptionType":"Abstract","description":"Modern language models (LM) are trained on large scrapes of the Web, containing millions of personal information (PI) instances, many of which LMs memorize, increasing privacy risks. In this work, we develop the regexes and rules (R\u0026amp;R) detector suite to detect email addresses, phone numbers, and IP addresses, which outperforms the best regex-based PI detectors. On a manually curated set of 483 instances of PI, we measure memorization: finding that 13.6% are parroted verbatim by the Pythia-6.9b model, i.e., when the model is prompted with the tokens that precede the PI in the original document, greedy decoding generates the entire PI span exactly. We expand this analysis to study models of varying sizes (160M-6.9B) and pretraining time steps (70k-143k iterations) in the Pythia model suite and find that both model size and amount of pretraining are positively correlated with memorization. Even the smallest model, Pythia-160m, parrots 2.7% of the instances exactly. Consequently, we strongly recommend that pretraining datasets be aggressively filtered and anonymized to minimize PI parroting."},{"descriptionType":"Other","description":"EACL Findings 2026"}],"geoLocations":[],"fundingReferences":[],"url":"https://arxiv.org/abs/2602.20580","contentUrl":null,"metadataVersion":0,"schemaVersion":"http://datacite.org/schema/kernel-4","source":"mds","isActive":true,"state":"findable","reason":null,"viewCount":0,"downloadCount":0,"referenceCount":0,"citationCount":0,"partCount":0,"partOfCount":0,"versionCount":0,"versionOfCount":0,"created":"2026-02-25T02:53:34Z","registered":"2026-02-25T02:53:35Z","published":null,"updated":"2026-02-25T02:53:35Z"},"relationships":{"client":{"data":{"id":"arxiv.content","type":"clients"}}}},{"id":"10.48550/arxiv.2602.20577","type":"dois","attributes":{"doi":"10.48550/arxiv.2602.20577","identifiers":[{"identifier":"2602.20577","identifierType":"arXiv"}],"creators":[{"nameType":"Personal","givenName":"Jiaru","familyName":"Zhang","name":"Zhang, Jiaru","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Manav","familyName":"Gagvani","name":"Gagvani, Manav","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Can","familyName":"Cui","name":"Cui, Can","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Juntong","familyName":"Peng","name":"Peng, Juntong","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Ruqi","familyName":"Zhang","name":"Zhang, Ruqi","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Ziran","familyName":"Wang","name":"Wang, Ziran","affiliation":[],"nameIdentifiers":[]}],"titles":[{"title":"Efficient and Explainable End-to-End Autonomous Driving via Masked Vision-Language-Action Diffusion"}],"publisher":"arXiv","container":{},"publicationYear":2026,"subjects":[{"subject":"Computer Vision and Pattern Recognition (cs.CV)","lang":"en","subjectScheme":"arXiv"},{"subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"},{"schemeUri":"http://www.oecd.org/science/inno/38235147.pdf","subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"}],"contributors":[],"dates":[{"date":"2026-02-24T05:59:10Z","dateType":"Submitted","dateInformation":"v1"},{"date":"2026-02-25T01:24:45Z","dateType":"Updated","dateInformation":"v1"},{"date":"2026-02","dateType":"Available","dateInformation":"v1"},{"date":"2026","dateType":"Issued"}],"language":null,"types":{"schemaOrg":"CreativeWork","resourceTypeGeneral":"Preprint","citeproc":"article","bibtex":"misc","ris":"GEN","resourceType":"Article"},"relatedIdentifiers":[],"relatedItems":[],"sizes":[],"formats":[],"version":"1","rightsList":[{"rightsIdentifierScheme":"SPDX","rightsUri":"https://creativecommons.org/licenses/by-nc-sa/4.0/legalcode","schemeUri":"https://spdx.org/licenses/","rights":"Creative Commons Attribution Non Commercial Share Alike 4.0 International","rightsIdentifier":"cc-by-nc-sa-4.0"}],"descriptions":[{"descriptionType":"Abstract","description":"Large Language Models (LLMs) and Vision-Language Models (VLMs) have emerged as promising candidates for end-to-end autonomous driving. However, these models typically face challenges in inference latency, action precision, and explainability. Existing autoregressive approaches struggle with slow token-by-token generation, while prior diffusion-based planners often rely on verbose, general-purpose language tokens that lack explicit geometric structure. In this work, we propose Masked Vision-Language-Action Diffusion for Autonomous Driving (MVLAD-AD), a novel framework designed to bridge the gap between efficient planning and semantic explainability via a masked vision-language-action diffusion model. Unlike methods that force actions into the language space, we introduce a discrete action tokenization strategy that constructs a compact codebook of kinematically feasible waypoints from real-world driving distributions. Moreover, we propose geometry-aware embedding learning to ensure that embeddings in the latent space approximate physical geometric metrics. Finally, an action-priority decoding strategy is introduced to prioritize trajectory generation. Extensive experiments on nuScenes and derived benchmarks demonstrate that MVLAD-AD achieves superior efficiency and outperforms state-of-the-art autoregressive and diffusion baselines in planning precision, while providing high-fidelity and explainable reasoning."}],"geoLocations":[],"fundingReferences":[],"url":"https://arxiv.org/abs/2602.20577","contentUrl":null,"metadataVersion":0,"schemaVersion":"http://datacite.org/schema/kernel-4","source":"mds","isActive":true,"state":"findable","reason":null,"viewCount":0,"downloadCount":0,"referenceCount":0,"citationCount":0,"partCount":0,"partOfCount":0,"versionCount":0,"versionOfCount":0,"created":"2026-02-25T02:53:30Z","registered":"2026-02-25T02:53:31Z","published":null,"updated":"2026-02-25T02:53:31Z"},"relationships":{"client":{"data":{"id":"arxiv.content","type":"clients"}}}},{"id":"10.48550/arxiv.2602.20574","type":"dois","attributes":{"doi":"10.48550/arxiv.2602.20574","identifiers":[{"identifier":"2602.20574","identifierType":"arXiv"}],"creators":[{"nameType":"Personal","givenName":"Alex","familyName":"Stein","name":"Stein, Alex","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Furong","familyName":"Huang","name":"Huang, Furong","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Tom","familyName":"Goldstein","name":"Goldstein, Tom","affiliation":[],"nameIdentifiers":[]}],"titles":[{"title":"GATES: Self-Distillation under Privileged Context with Consensus Gating"}],"publisher":"arXiv","container":{},"publicationYear":2026,"subjects":[{"subject":"Machine Learning (cs.LG)","lang":"en","subjectScheme":"arXiv"},{"subject":"Computation and Language (cs.CL)","lang":"en","subjectScheme":"arXiv"},{"subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"},{"schemeUri":"http://www.oecd.org/science/inno/38235147.pdf","subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"}],"contributors":[],"dates":[{"date":"2026-02-24T05:56:20Z","dateType":"Submitted","dateInformation":"v1"},{"date":"2026-02-25T01:24:41Z","dateType":"Updated","dateInformation":"v1"},{"date":"2026-02","dateType":"Available","dateInformation":"v1"},{"date":"2026","dateType":"Issued"}],"language":null,"types":{"schemaOrg":"CreativeWork","resourceTypeGeneral":"Preprint","citeproc":"article","bibtex":"misc","ris":"GEN","resourceType":"Article"},"relatedIdentifiers":[],"relatedItems":[],"sizes":[],"formats":[],"version":"1","rightsList":[{"rightsIdentifierScheme":"SPDX","rightsUri":"https://creativecommons.org/licenses/by/4.0/legalcode","schemeUri":"https://spdx.org/licenses/","rights":"Creative Commons Attribution 4.0 International","rightsIdentifier":"cc-by-4.0"}],"descriptions":[{"descriptionType":"Abstract","description":"We study self-distillation in settings where supervision is unreliable: there are no ground truth labels, verifiable rewards, or external graders to evaluate answers. We focus on document-grounded question answering with asymmetric context, where a single model serves as both tutor (with access to a relevant source document during training) and student (answering from the question alone at test time). Rather than assuming tutor correctness, we derive supervision online from tutor consensus by sampling multiple document-grounded reasoning traces and using agreement to gate learning. Conditioned on this reliability signal, we distill knowledge through full tutor reasoning trajectories (not just final answers), providing a dense and stable learning signal. Empirically, this consensus-gated trajectory distillation substantially improves transfer to the document-free student. Held-out in-domain accuracy under asymmetric evaluation improves from 46.0\\% to 62.0\\%, and average (maj@8) accuracy on public document-free math benchmarks improves from 20.2\\% to 35.4\\%."},{"descriptionType":"Other","description":"10 Pages of main text with an additional 7 pages of supplementary material"}],"geoLocations":[],"fundingReferences":[],"url":"https://arxiv.org/abs/2602.20574","contentUrl":null,"metadataVersion":0,"schemaVersion":"http://datacite.org/schema/kernel-4","source":"mds","isActive":true,"state":"findable","reason":null,"viewCount":0,"downloadCount":0,"referenceCount":0,"citationCount":0,"partCount":0,"partOfCount":0,"versionCount":0,"versionOfCount":0,"created":"2026-02-25T02:53:26Z","registered":"2026-02-25T02:53:27Z","published":null,"updated":"2026-02-25T02:53:27Z"},"relationships":{"client":{"data":{"id":"arxiv.content","type":"clients"}}}},{"id":"10.48550/arxiv.2602.20572","type":"dois","attributes":{"doi":"10.48550/arxiv.2602.20572","identifiers":[{"identifier":"2602.20572","identifierType":"arXiv"}],"creators":[{"nameType":"Personal","givenName":"Chang Jun","familyName":"Im","name":"Im, Chang Jun","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Jeong Min","familyName":"Jeon","name":"Jeon, Jeong Min","affiliation":[],"nameIdentifiers":[]}],"titles":[{"title":"Local Fréchet regression with toroidal predictors"}],"publisher":"arXiv","container":{},"publicationYear":2026,"subjects":[{"subject":"Methodology (stat.ME)","lang":"en","subjectScheme":"arXiv"},{"subject":"Statistics Theory (math.ST)","lang":"en","subjectScheme":"arXiv"},{"subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"},{"schemeUri":"http://www.oecd.org/science/inno/38235147.pdf","subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"},{"subject":"FOS: Mathematics","subjectScheme":"Fields of Science and Technology (FOS)"},{"schemeUri":"http://www.oecd.org/science/inno/38235147.pdf","subject":"FOS: Mathematics","subjectScheme":"Fields of Science and Technology (FOS)"},{"subject":"62G08, 62R02, 62H11, 62G20, 62R01","lang":"en","subjectScheme":"MSC"}],"contributors":[],"dates":[{"date":"2026-02-24T05:52:55Z","dateType":"Submitted","dateInformation":"v1"},{"date":"2026-02-25T01:24:36Z","dateType":"Updated","dateInformation":"v1"},{"date":"2026-02","dateType":"Available","dateInformation":"v1"},{"date":"2026","dateType":"Issued"}],"language":null,"types":{"schemaOrg":"CreativeWork","resourceTypeGeneral":"Preprint","citeproc":"article","bibtex":"misc","ris":"GEN","resourceType":"Article"},"relatedIdentifiers":[],"relatedItems":[],"sizes":[],"formats":[],"version":"1","rightsList":[{"rightsUri":"http://arxiv.org/licenses/nonexclusive-distrib/1.0/","rights":"arXiv.org perpetual, non-exclusive license"}],"descriptions":[{"descriptionType":"Abstract","description":"We provide the first regression framework that simultaneously accommodates responses taking values in a general metric space and predictors lying on a general torus. We propose intrinsic local constant and local linear estimators that respect the underlying geometries of both the response and predictor spaces. Our local linear estimator is novel even in the case of scalar responses. We further establish their asymptotic properties, including consistency and convergence rates. Simulation studies, together with an application to real data, illustrate the superior performance of the proposed methodology."},{"descriptionType":"Other","description":"52 pages, 1 figure. Submitted to Scandinavian Journal of Statistics"}],"geoLocations":[],"fundingReferences":[],"url":"https://arxiv.org/abs/2602.20572","contentUrl":null,"metadataVersion":0,"schemaVersion":"http://datacite.org/schema/kernel-4","source":"mds","isActive":true,"state":"findable","reason":null,"viewCount":0,"downloadCount":0,"referenceCount":0,"citationCount":0,"partCount":0,"partOfCount":0,"versionCount":0,"versionOfCount":0,"created":"2026-02-25T02:53:23Z","registered":"2026-02-25T02:53:24Z","published":null,"updated":"2026-02-25T02:53:24Z"},"relationships":{"client":{"data":{"id":"arxiv.content","type":"clients"}}}},{"id":"10.48550/arxiv.2602.20569","type":"dois","attributes":{"doi":"10.48550/arxiv.2602.20569","identifiers":[{"identifier":"2602.20569","identifierType":"arXiv"}],"creators":[{"nameType":"Personal","givenName":"Jiaqi","familyName":"Wu","name":"Wu, Jiaqi","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Yuchen","familyName":"Zhou","name":"Zhou, Yuchen","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Muduo","familyName":"Xu","name":"Xu, Muduo","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Zisheng","familyName":"Liang","name":"Liang, Zisheng","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Simiao","familyName":"Ren","name":"Ren, Simiao","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Jiayu","familyName":"Xue","name":"Xue, Jiayu","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Meige","familyName":"Yang","name":"Yang, Meige","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Siying","familyName":"Chen","name":"Chen, Siying","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Jingheng","familyName":"Huan","name":"Huan, Jingheng","affiliation":[],"nameIdentifiers":[]}],"titles":[{"title":"AIForge-Doc: A Benchmark for Detecting AI-Forged Tampering in Financial and Form Documents"}],"publisher":"arXiv","container":{},"publicationYear":2026,"subjects":[{"subject":"Computer Vision and Pattern Recognition (cs.CV)","lang":"en","subjectScheme":"arXiv"},{"subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"},{"schemeUri":"http://www.oecd.org/science/inno/38235147.pdf","subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"}],"contributors":[],"dates":[{"date":"2026-02-24T05:37:35Z","dateType":"Submitted","dateInformation":"v1"},{"date":"2026-02-25T01:23:57Z","dateType":"Updated","dateInformation":"v1"},{"date":"2026-02","dateType":"Available","dateInformation":"v1"},{"date":"2026","dateType":"Issued"}],"language":null,"types":{"schemaOrg":"CreativeWork","resourceTypeGeneral":"Preprint","citeproc":"article","bibtex":"misc","ris":"GEN","resourceType":"Article"},"relatedIdentifiers":[],"relatedItems":[],"sizes":[],"formats":[],"version":"1","rightsList":[{"rightsIdentifierScheme":"SPDX","rightsUri":"https://creativecommons.org/licenses/by-nc-sa/4.0/legalcode","schemeUri":"https://spdx.org/licenses/","rights":"Creative Commons Attribution Non Commercial Share Alike 4.0 International","rightsIdentifier":"cc-by-nc-sa-4.0"}],"descriptions":[{"descriptionType":"Abstract","description":"We present AIForge-Doc, the first dedicated benchmark targeting exclusively diffusion-model-based inpainting in financial and form documents with pixel-level annotation. Existing document forgery datasets rely on traditional digital editing tools (e.g., Adobe Photoshop, GIMP), creating a critical gap: state-of-the-art detectors are blind to the rapidly growing threat of AI-forged document fraud. AIForge-Doc addresses this gap by systematically forging numeric fields in real-world receipt and form images using two AI inpainting APIs -- Gemini 2.5 Flash Image and Ideogram v2 Edit -- yielding 4,061 forged images from four public document datasets (CORD, WildReceipt, SROIE, XFUND) across nine languages, annotated with pixel-precise tampered-region masks in DocTamper-compatible format. We benchmark three representative detectors -- TruFor, DocTamper, and a zero-shot GPT-4o judge -- and find that all existing methods degrade substantially: TruFor achieves AUC=0.751 (zero-shot, out-of-distribution) vs. AUC=0.96 on NIST16; DocTamper achieves AUC=0.563 vs. AUC=0.98 in-distribution, with pixel-level IoU=0.020; GPT-4o achieves only 0.509 -- essentially at chance -- confirming that AI-forged values are indistinguishable to automated detectors and VLMs. These results demonstrate that AIForge-Doc represents a qualitatively new and unsolved challenge for document forensics."},{"descriptionType":"Other","description":"17 pages, 10 figures"}],"geoLocations":[],"fundingReferences":[],"url":"https://arxiv.org/abs/2602.20569","contentUrl":null,"metadataVersion":0,"schemaVersion":"http://datacite.org/schema/kernel-4","source":"mds","isActive":true,"state":"findable","reason":null,"viewCount":0,"downloadCount":0,"referenceCount":0,"citationCount":0,"partCount":0,"partOfCount":0,"versionCount":0,"versionOfCount":0,"created":"2026-02-25T02:53:19Z","registered":"2026-02-25T02:53:20Z","published":null,"updated":"2026-02-25T02:53:20Z"},"relationships":{"client":{"data":{"id":"arxiv.content","type":"clients"}}}},{"id":"10.48550/arxiv.2602.20568","type":"dois","attributes":{"doi":"10.48550/arxiv.2602.20568","identifiers":[{"identifier":"2602.20568","identifierType":"arXiv"}],"creators":[{"nameType":"Personal","givenName":"Huining","familyName":"Zhang","name":"Zhang, Huining","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"X. Z.","familyName":"Hao","name":"Hao, X. Z.","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"X. X.","familyName":"Yi","name":"Yi, X. X.","affiliation":[],"nameIdentifiers":[]}],"titles":[{"title":"Effect of atom-oscillator interaction on the aging transition in coupled oscillators"}],"publisher":"arXiv","container":{},"publicationYear":2026,"subjects":[{"subject":"Quantum Physics (quant-ph)","lang":"en","subjectScheme":"arXiv"},{"subject":"FOS: Physical sciences","subjectScheme":"Fields of Science and Technology (FOS)"},{"schemeUri":"http://www.oecd.org/science/inno/38235147.pdf","subject":"FOS: Physical sciences","subjectScheme":"Fields of Science and Technology (FOS)"}],"contributors":[],"dates":[{"date":"2026-02-24T05:34:21Z","dateType":"Submitted","dateInformation":"v1"},{"date":"2026-02-25T01:23:49Z","dateType":"Updated","dateInformation":"v1"},{"date":"2026-02","dateType":"Available","dateInformation":"v1"},{"date":"2026","dateType":"Issued"}],"language":null,"types":{"schemaOrg":"CreativeWork","resourceTypeGeneral":"Preprint","citeproc":"article","bibtex":"misc","ris":"GEN","resourceType":"Article"},"relatedIdentifiers":[{"relationType":"IsVersionOf","relatedIdentifier":"10.1103/physreva.111.052212","relatedIdentifierType":"DOI"}],"relatedItems":[],"sizes":[],"formats":[],"version":"1","rightsList":[{"rightsUri":"http://arxiv.org/licenses/nonexclusive-distrib/1.0/","rights":"arXiv.org perpetual, non-exclusive license"}],"descriptions":[{"descriptionType":"Abstract","description":"Oscillators are often employed as a model of radiation fields, which may couple to an atom and play an important role for creating and manipulating nonclassical states in quantum metrology, quantum simulation, and quantum information. Aging transitions in coupled oscillators have been studied extensively in both the classical and quantum contexts. It is well known that the onset of aging transitions can be modulated by the dissipative coupling between oscillators. In this study, we propose an alternative way to modulate the aging transition through coherent couplings between a two-level atom and the oscillators. Our findings reveal that, compared to atom-free systems in both classical and quantum regimes, the atom-oscillator coherent interaction reduces the inactive-to-total oscillator ratio required for aging transitions. Analytical results of the transition for both the classical oscillators and quantum oscillators suggest that the decay rate of the atom and the atom-oscillator coupling strength jointly change the aging transition point. The physics behind the observation is also elucidated in this article. Our research introduces a readily implementable strategy for manipulating aging transitions in more intricate systems, thereby advancing the control and understanding of these critical transitions in quantum technologies."},{"descriptionType":"Other","description":"11 pages, 8 figures"}],"geoLocations":[],"fundingReferences":[],"url":"https://arxiv.org/abs/2602.20568","contentUrl":null,"metadataVersion":0,"schemaVersion":"http://datacite.org/schema/kernel-4","source":"mds","isActive":true,"state":"findable","reason":null,"viewCount":0,"downloadCount":0,"referenceCount":0,"citationCount":0,"partCount":0,"partOfCount":0,"versionCount":0,"versionOfCount":1,"created":"2026-02-25T02:53:17Z","registered":"2026-02-25T02:53:18Z","published":null,"updated":"2026-02-25T02:53:18Z"},"relationships":{"client":{"data":{"id":"arxiv.content","type":"clients"}}}},{"id":"10.48550/arxiv.2602.20567","type":"dois","attributes":{"doi":"10.48550/arxiv.2602.20567","identifiers":[{"identifier":"2602.20567","identifierType":"arXiv"}],"creators":[{"nameType":"Personal","givenName":"Yifei","familyName":"Liang","name":"Liang, Yifei","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Yan","familyName":"Sun","name":"Sun, Yan","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Xiaochun","familyName":"Cao","name":"Cao, Xiaochun","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Li","familyName":"Shen","name":"Shen, Li","affiliation":[],"nameIdentifiers":[]}],"titles":[{"title":"Stability and Generalization of Push-Sum Based Decentralized Optimization over Directed Graphs"}],"publisher":"arXiv","container":{},"publicationYear":2026,"subjects":[{"subject":"Machine Learning (cs.LG)","lang":"en","subjectScheme":"arXiv"},{"subject":"Optimization and Control (math.OC)","lang":"en","subjectScheme":"arXiv"},{"subject":"Machine Learning (stat.ML)","lang":"en","subjectScheme":"arXiv"},{"subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"},{"schemeUri":"http://www.oecd.org/science/inno/38235147.pdf","subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"},{"subject":"FOS: Mathematics","subjectScheme":"Fields of Science and Technology (FOS)"},{"schemeUri":"http://www.oecd.org/science/inno/38235147.pdf","subject":"FOS: Mathematics","subjectScheme":"Fields of Science and Technology (FOS)"}],"contributors":[],"dates":[{"date":"2026-02-24T05:32:03Z","dateType":"Submitted","dateInformation":"v1"},{"date":"2026-02-25T01:23:47Z","dateType":"Updated","dateInformation":"v1"},{"date":"2026-02","dateType":"Available","dateInformation":"v1"},{"date":"2026","dateType":"Issued"}],"language":null,"types":{"schemaOrg":"CreativeWork","resourceTypeGeneral":"Preprint","citeproc":"article","bibtex":"misc","ris":"GEN","resourceType":"Article"},"relatedIdentifiers":[],"relatedItems":[],"sizes":[],"formats":[],"version":"1","rightsList":[{"rightsIdentifierScheme":"SPDX","rightsUri":"https://creativecommons.org/licenses/by/4.0/legalcode","schemeUri":"https://spdx.org/licenses/","rights":"Creative Commons Attribution 4.0 International","rightsIdentifier":"cc-by-4.0"}],"descriptions":[{"descriptionType":"Abstract","description":"Push-Sum-based decentralized learning enables optimization over directed communication networks, where information exchange may be asymmetric. While convergence properties of such methods are well understood, their finite-iteration stability and generalization behavior remain unclear due to structural bias induced by column-stochastic mixing and asymmetric error propagation. In this work, we develop a unified uniform-stability framework for the Stochastic Gradient Push (SGP) algorithm that captures the effect of directed topology. A key technical ingredient is an imbalance-aware consistency bound for Push-Sum, which controls consensus deviation through two quantities: the stationary distribution imbalance parameter $δ$ and the spectral gap $(1-λ)$ governing mixing speed. This decomposition enables us to disentangle statistical effects from topology-induced bias. We establish finite-iteration stability and optimization guarantees for both convex objectives and non-convex objectives satisfying the Polyak--Łojasiewicz condition. For convex problems, SGP attains excess generalization error of order $\\tilde{\\mathcal{O}}\\!\\left(\\frac{1}{\\sqrt{mn}}+\\fracγ{δ(1-λ)}+γ\\right)$ under step-size schedules, and we characterize the corresponding optimal early stopping time that minimizes this bound. For PŁ objectives, we obtain convex-like optimization and generalization rates with dominant dependence proportional to $κ\\!\\left(1+\\frac{1}{δ(1-λ)}\\right)$, revealing a multiplicative coupling between problem conditioning and directed communication topology. Our analysis clarifies when Push-Sum correction is necessary compared with standard decentralized SGD and quantifies how imbalance and mixing jointly shape the best attainable learning performance."},{"descriptionType":"Other","description":"47 Pages"}],"geoLocations":[],"fundingReferences":[],"url":"https://arxiv.org/abs/2602.20567","contentUrl":null,"metadataVersion":0,"schemaVersion":"http://datacite.org/schema/kernel-4","source":"mds","isActive":true,"state":"findable","reason":null,"viewCount":0,"downloadCount":0,"referenceCount":0,"citationCount":0,"partCount":0,"partOfCount":0,"versionCount":0,"versionOfCount":0,"created":"2026-02-25T02:53:16Z","registered":"2026-02-25T02:53:17Z","published":null,"updated":"2026-02-25T02:53:17Z"},"relationships":{"client":{"data":{"id":"arxiv.content","type":"clients"}}}},{"id":"10.48550/arxiv.2602.20566","type":"dois","attributes":{"doi":"10.48550/arxiv.2602.20566","identifiers":[{"identifier":"2602.20566","identifierType":"arXiv"}],"creators":[{"nameType":"Personal","givenName":"Haosheng","familyName":"Li","name":"Li, Haosheng","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Weixin","familyName":"Mao","name":"Mao, Weixin","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Zihan","familyName":"Lan","name":"Lan, Zihan","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Hongwei","familyName":"Xiong","name":"Xiong, Hongwei","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Hongan","familyName":"Wang","name":"Wang, Hongan","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Chenyang","familyName":"Si","name":"Si, Chenyang","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Ziwei","familyName":"Liu","name":"Liu, Ziwei","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Xiaoming","familyName":"Deng","name":"Deng, Xiaoming","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Hua","familyName":"Chen","name":"Chen, Hua","affiliation":[],"nameIdentifiers":[]}],"titles":[{"title":"BFA++: Hierarchical Best-Feature-Aware Token Prune for Multi-View Vision Language Action Model"}],"publisher":"arXiv","container":{},"publicationYear":2026,"subjects":[{"subject":"Robotics (cs.RO)","lang":"en","subjectScheme":"arXiv"},{"subject":"Computer Vision and Pattern Recognition (cs.CV)","lang":"en","subjectScheme":"arXiv"},{"subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"},{"schemeUri":"http://www.oecd.org/science/inno/38235147.pdf","subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"}],"contributors":[],"dates":[{"date":"2026-02-24T05:31:52Z","dateType":"Submitted","dateInformation":"v1"},{"date":"2026-02-25T01:23:46Z","dateType":"Updated","dateInformation":"v1"},{"date":"2026-02","dateType":"Available","dateInformation":"v1"},{"date":"2026","dateType":"Issued"}],"language":null,"types":{"schemaOrg":"CreativeWork","resourceTypeGeneral":"Preprint","citeproc":"article","bibtex":"misc","ris":"GEN","resourceType":"Article"},"relatedIdentifiers":[],"relatedItems":[],"sizes":[],"formats":[],"version":"1","rightsList":[{"rightsUri":"http://arxiv.org/licenses/nonexclusive-distrib/1.0/","rights":"arXiv.org perpetual, non-exclusive license"}],"descriptions":[{"descriptionType":"Abstract","description":"Vision-Language-Action (VLA) models have achieved significant breakthroughs by leveraging Large Vision Language Models (VLMs) to jointly interpret instructions and visual inputs. However, the substantial increase in visual tokens, particularly from multi-view inputs, poses serious challenges to real-time robotic manipulation. Existing acceleration techniques for VLMs, such as token pruning, often result in degraded performance when directly applied to VLA models, as they overlook the relationships between different views and fail to account for the dynamic and task-specific characteristics of robotic operation. To address this, we propose BFA++, a dynamic token pruning framework designed specifically for VLA models. BFA++ introduces a hierarchical pruning strategy guided by two-level importance predictors: an intra-view predictor highlights task-relevant regions within each image to suppress spatial noise, while an inter-view predictor identifies critical camera views throughout different manipulation phases to reduce cross-view redundancy. This design enables efficient token selection while preserving essential visual cues, resulting in improved computational efficiency and higher manipulation success rates. Evaluations on the RoboTwin benchmark and real-world robotic tasks demonstrate that BFA++ consistently outperforms existing methods. BFA++ improves the success rate by about 10% on both the π0 and RDT models, achieving speedup of 1.8X and 1.5X, respectively. Our results highlight that context-sensitive and task-aware token pruning serves as a more effective strategy than full visual processing, enabling faster inference and improved manipulation accuracy in real-world robotic systems."},{"descriptionType":"Other","description":"9 pages, 10 figures"}],"geoLocations":[],"fundingReferences":[],"url":"https://arxiv.org/abs/2602.20566","contentUrl":null,"metadataVersion":0,"schemaVersion":"http://datacite.org/schema/kernel-4","source":"mds","isActive":true,"state":"findable","reason":null,"viewCount":0,"downloadCount":0,"referenceCount":0,"citationCount":0,"partCount":0,"partOfCount":0,"versionCount":0,"versionOfCount":0,"created":"2026-02-25T02:53:14Z","registered":"2026-02-25T02:53:15Z","published":null,"updated":"2026-02-25T02:53:15Z"},"relationships":{"client":{"data":{"id":"arxiv.content","type":"clients"}}}},{"id":"10.48550/arxiv.2602.20565","type":"dois","attributes":{"doi":"10.48550/arxiv.2602.20565","identifiers":[{"identifier":"2602.20565","identifierType":"arXiv"}],"creators":[{"nameType":"Personal","givenName":"Sara Oliveira","familyName":"Santos","name":"Santos, Sara Oliveira","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Maggie","familyName":"Brown","name":"Brown, Maggie","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Minki","familyName":"Kim","name":"Kim, Minki","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Nils","familyName":"Tack","name":"Tack, Nils","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Monica M.","familyName":"Wilhelmus","name":"Wilhelmus, Monica M.","affiliation":[],"nameIdentifiers":[]}],"titles":[{"title":"Hydrodynamic modulation via cupping in a crustacean-inspired propulsor"}],"publisher":"arXiv","container":{},"publicationYear":2026,"subjects":[{"subject":"Fluid Dynamics (physics.flu-dyn)","lang":"en","subjectScheme":"arXiv"},{"subject":"FOS: Physical sciences","subjectScheme":"Fields of Science and Technology (FOS)"},{"schemeUri":"http://www.oecd.org/science/inno/38235147.pdf","subject":"FOS: Physical sciences","subjectScheme":"Fields of Science and Technology (FOS)"}],"contributors":[],"dates":[{"date":"2026-02-24T05:30:41Z","dateType":"Submitted","dateInformation":"v1"},{"date":"2026-02-25T01:23:40Z","dateType":"Updated","dateInformation":"v1"},{"date":"2026-02","dateType":"Available","dateInformation":"v1"},{"date":"2026","dateType":"Issued"}],"language":null,"types":{"schemaOrg":"CreativeWork","resourceTypeGeneral":"Preprint","citeproc":"article","bibtex":"misc","ris":"GEN","resourceType":"Article"},"relatedIdentifiers":[],"relatedItems":[],"sizes":[],"formats":[],"version":"1","rightsList":[{"rightsIdentifierScheme":"SPDX","rightsUri":"https://creativecommons.org/licenses/by-nc-nd/4.0/legalcode","schemeUri":"https://spdx.org/licenses/","rights":"Creative Commons Attribution Non Commercial No Derivatives 4.0 International","rightsIdentifier":"cc-by-nc-nd-4.0"}],"descriptions":[{"descriptionType":"Abstract","description":"Shrimp, like many invertebrates swimming at intermediate Reynolds numbers ($Re$), rely on the interplay between morphology and kinematics to generate thrust while producing sufficient lift to overcome their negative buoyancy. Shrimp pleopods branch into an endopodite and an exopodite, whose relative motion varies the projected surface area during the swimming cycle. For this mechanism to function, the exopodite must be cambered relative to the endopodite at a set cupping angle $ζ$, which partially decouples the effective angle of attack of the exopodite from the overall leg kinematics. Here, we investigate the role of $ζ$ in modulating thrust$-$lift balance during steady forward locomotion. Using a dynamically scaled (40$\\times$) robotic pleopod, we systematically varied $ζ$ from $0^\\circ$ to $80^\\circ$, measured hydrodynamic forces, and performed particle image velocimetry at $Re = 968$. Moderate cupping angles ($ζ= 20^\\circ-40^\\circ$), consistent with biological observations, provide optimal thrust$-$lift balance. At these angles, the exopodite abducts rapidly during the power stroke, maximizing projected area at peak flow velocity, and adducts early during the return stroke, minimizing resistive drag. A reduced-order force model reveals that the exopodite contributes 52$-$62\\% of total lift, particularly at intermediate $ζ$, where a leading-edge vortex (LEV) forms and remains attached throughout the power stroke. At extreme cupping angles, LEV coherence degrades and force production weakens. These findings demonstrate that shrimp pleopods function as hybrid propulsors exploiting both drag- and lift-based forces, and that $ζ$ serves as a geometric control parameter capable of tuning thrust$-$lift balance independently of stroke kinematics."}],"geoLocations":[],"fundingReferences":[],"url":"https://arxiv.org/abs/2602.20565","contentUrl":null,"metadataVersion":0,"schemaVersion":"http://datacite.org/schema/kernel-4","source":"mds","isActive":true,"state":"findable","reason":null,"viewCount":0,"downloadCount":0,"referenceCount":0,"citationCount":0,"partCount":0,"partOfCount":0,"versionCount":0,"versionOfCount":0,"created":"2026-02-25T02:53:13Z","registered":"2026-02-25T02:53:14Z","published":null,"updated":"2026-02-25T02:53:14Z"},"relationships":{"client":{"data":{"id":"arxiv.content","type":"clients"}}}},{"id":"10.48550/arxiv.2602.20564","type":"dois","attributes":{"doi":"10.48550/arxiv.2602.20564","identifiers":[{"identifier":"2602.20564","identifierType":"arXiv"}],"creators":[{"nameType":"Personal","givenName":"T.","familyName":"Simpson","name":"Simpson, T.","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"R. A.","familyName":"Badcock","name":"Badcock, R. A.","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"T.","familyName":"Berry","name":"Berry, T.","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"C. S.","familyName":"Chisholm","name":"Chisholm, C. S.","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"P. J.","familyName":"Fimognari","name":"Fimognari, P. J.","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"P.","familyName":"Fisher","name":"Fisher, P.","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"D. T.","familyName":"Garnier","name":"Garnier, D. T.","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"K.","familyName":"Lenagh-Glue","name":"Lenagh-Glue, K.","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"B.","familyName":"Leuw","name":"Leuw, B.","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"R.","familyName":"Mataira","name":"Mataira, R.","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"L.","familyName":"Meadows","name":"Meadows, L.","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"T.","familyName":"McIntosh","name":"McIntosh, T.","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"J.","familyName":"Poata","name":"Poata, J.","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"K.","familyName":"Richardson","name":"Richardson, K.","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"B.","familyName":"Smith","name":"Smith, B.","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"A.","familyName":"Simpson","name":"Simpson, A.","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"J. D.","familyName":"Tyler","name":"Tyler, J. D.","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"T.","familyName":"Wordsworth","name":"Wordsworth, T.","affiliation":[],"nameIdentifiers":[]}],"titles":[{"title":"Deuterium-Tritium Levitated Dipole Fusion Power Plants"}],"publisher":"arXiv","container":{},"publicationYear":2026,"subjects":[{"subject":"Plasma Physics (physics.plasm-ph)","lang":"en","subjectScheme":"arXiv"},{"subject":"Accelerator Physics (physics.acc-ph)","lang":"en","subjectScheme":"arXiv"},{"subject":"FOS: Physical sciences","subjectScheme":"Fields of Science and Technology (FOS)"},{"schemeUri":"http://www.oecd.org/science/inno/38235147.pdf","subject":"FOS: Physical sciences","subjectScheme":"Fields of Science and Technology (FOS)"}],"contributors":[],"dates":[{"date":"2026-02-24T05:29:29Z","dateType":"Submitted","dateInformation":"v1"},{"date":"2026-02-25T01:23:38Z","dateType":"Updated","dateInformation":"v1"},{"date":"2026-02","dateType":"Available","dateInformation":"v1"},{"date":"2026","dateType":"Issued"}],"language":null,"types":{"schemaOrg":"CreativeWork","resourceTypeGeneral":"Preprint","citeproc":"article","bibtex":"misc","ris":"GEN","resourceType":"Article"},"relatedIdentifiers":[],"relatedItems":[],"sizes":[],"formats":[],"version":"1","rightsList":[{"rightsUri":"http://arxiv.org/licenses/nonexclusive-distrib/1.0/","rights":"arXiv.org perpetual, non-exclusive license"}],"descriptions":[{"descriptionType":"Abstract","description":"Levitated dipole reactors offer an attractive path towards economic fusion power generation. The intrinsic decoupling of the confining magnetic field-generating REBCO magnets and the vacuum vessel offer unparalleled accessibility and maintainability, allowing for high plant duty factors and theoretically low electricity prices. In order to achieve rapid deployment of fusion power to the grid, the use of the Deuterium-Tritium (DT) fuel cycle is required due to its lower required plasma triple products. Historically, designs of levitated dipole fusion power plants have targeted advanced fuels as a DT device was seen to be infeasible due to the high fluxes of 14.1 MeV neutrons on the superconducting core magnet. This study presents high level designs for two feasible first-of-a-kind (FOAK) DT levitated dipole fusion power plants, the larger of which produces 667 MW of fusion power and is predicted to produce 208 MW of net electric power. Both designs consist of a heavily neutron-shielded, high-field REBCO core magnet capable of producing peak magnetic field strengths of 23 T while keeping peak mechanical strains below 0.4%. The neutron shielding is comprised of a layered structure of tungsten and boron carbide, which allows for 92% of the heat deposited in the neutron shield to be radiated out to the first wall while still providing sufficient neutron attenuation to give adequate REBCO conductor lifetimes. The core magnet REBCO coil is comprised of a small \"sacrificial\" section and a larger semi-permanent section. The sacrificial section, comprising ~20% of the coil, will have a neutron damage limited lifetime of ~1 year, after which the core magnet will be quickly removed from the vacuum vessel and replaced. This allows the damaged core magnet to be refurbished and reused, reducing cost and allowing for economic fusion power generation from a DT levitated dipole reactor."},{"descriptionType":"Other","description":"31 pages, 23 figures, Submitted to Fusion Engineering and Design"}],"geoLocations":[],"fundingReferences":[],"url":"https://arxiv.org/abs/2602.20564","contentUrl":null,"metadataVersion":0,"schemaVersion":"http://datacite.org/schema/kernel-4","source":"mds","isActive":true,"state":"findable","reason":null,"viewCount":0,"downloadCount":0,"referenceCount":0,"citationCount":0,"partCount":0,"partOfCount":0,"versionCount":0,"versionOfCount":0,"created":"2026-02-25T02:53:12Z","registered":"2026-02-25T02:53:12Z","published":null,"updated":"2026-02-25T02:53:12Z"},"relationships":{"client":{"data":{"id":"arxiv.content","type":"clients"}}}},{"id":"10.48550/arxiv.2602.20562","type":"dois","attributes":{"doi":"10.48550/arxiv.2602.20562","identifiers":[{"identifier":"2602.20562","identifierType":"arXiv"}],"creators":[{"nameType":"Personal","givenName":"Zhiyuan","familyName":"Wang","name":"Wang, Zhiyuan","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Haoran","familyName":"Li","name":"Li, Haoran","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Songjie","familyName":"Luo","name":"Luo, Songjie","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Jixiang","familyName":"Chen","name":"Chen, Jixiang","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Tianting","familyName":"Zhong","name":"Zhong, Tianting","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Jing","familyName":"Yao","name":"Yao, Jing","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Jixiong","familyName":"Pu","name":"Pu, Jixiong","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Zhipeng","familyName":"Yu","name":"Yu, Zhipeng","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Sylvain","familyName":"Gigan","name":"Gigan, Sylvain","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Ziyang","familyName":"Chen","name":"Chen, Ziyang","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Puxiang","familyName":"Lai","name":"Lai, Puxiang","affiliation":[],"nameIdentifiers":[]}],"titles":[{"title":"Real-time Calibration-free Imaging Through Dynamic and Distinct Multimode Fibers via Spatial Harmonic Invariant Nonlinear Encoding (SHINE)"}],"publisher":"arXiv","container":{},"publicationYear":2026,"subjects":[{"subject":"Optics (physics.optics)","lang":"en","subjectScheme":"arXiv"},{"subject":"FOS: Physical sciences","subjectScheme":"Fields of Science and Technology (FOS)"},{"schemeUri":"http://www.oecd.org/science/inno/38235147.pdf","subject":"FOS: Physical sciences","subjectScheme":"Fields of Science and Technology (FOS)"}],"contributors":[],"dates":[{"date":"2026-02-24T05:23:57Z","dateType":"Submitted","dateInformation":"v1"},{"date":"2026-02-25T01:23:26Z","dateType":"Updated","dateInformation":"v1"},{"date":"2026-02","dateType":"Available","dateInformation":"v1"},{"date":"2026","dateType":"Issued"}],"language":null,"types":{"schemaOrg":"CreativeWork","resourceTypeGeneral":"Preprint","citeproc":"article","bibtex":"misc","ris":"GEN","resourceType":"Article"},"relatedIdentifiers":[],"relatedItems":[],"sizes":[],"formats":[],"version":"1","rightsList":[{"rightsUri":"http://arxiv.org/licenses/nonexclusive-distrib/1.0/","rights":"arXiv.org perpetual, non-exclusive license"}],"descriptions":[{"descriptionType":"Abstract","description":"Multimode fibers (MMFs) provide a compact, high-throughput platform for minimally invasive imaging and information transmission. However, their utility is fundamentally constrained by mode mixing, which renders image transmission spatially disrupted and sensitive to external perturbations. Current imaging methods typically rely on transmission matrix measurement or deep learning models that are fragile to fiber movement, necessitating frequent, time-consuming calibrations and re-calibrations that are easily disrupted and fail to generalize across different fiber configurations, let alone across entirely distinct fibers. Here, we propose a calibration and feedback-free MMF coherent imaging paradigm, that we termed Spatial Harmonic Invariant Nonlinear Encoding (SHINE). By leveraging the angle-dependent phase-matching conditions of second-harmonic generation, we encode spatial features into broadband spectral signatures that possess intrinsic insensitivity not only to modal scrambling but also to fiber bending, movement, as well as structural variations. This spectral representation enables a deep learning model to robustly reconstruct images in real time despite dynamic perturbations and even generalizes well to distinct MMFs without recalibration or feedback. We achieve experimentally an average Pearson correlation coefficient (PCC) of 0.82 for image reconstruction tasks on Fashion-MNIST and a classification accuracy of 92.3% on HERLEV biomedical dataset. Uniquely, our method exhibits remarkable cross-fiber generalization: a model trained on a single MMF successfully reconstructs images transmitted through entirely distinct, previously unseen MMFs with a PCC of 0.74. These results establish a robust, calibration-free framework for imaging through MMFs in real time, paving the way for practical, resilient optical diagnostics that operate without distal-end feedback."}],"geoLocations":[],"fundingReferences":[],"url":"https://arxiv.org/abs/2602.20562","contentUrl":null,"metadataVersion":0,"schemaVersion":"http://datacite.org/schema/kernel-4","source":"mds","isActive":true,"state":"findable","reason":null,"viewCount":0,"downloadCount":0,"referenceCount":0,"citationCount":0,"partCount":0,"partOfCount":0,"versionCount":0,"versionOfCount":0,"created":"2026-02-25T02:53:09Z","registered":"2026-02-25T02:53:10Z","published":null,"updated":"2026-02-25T02:53:10Z"},"relationships":{"client":{"data":{"id":"arxiv.content","type":"clients"}}}},{"id":"10.48550/arxiv.2602.20560","type":"dois","attributes":{"doi":"10.48550/arxiv.2602.20560","identifiers":[{"identifier":"2602.20560","identifierType":"arXiv"}],"creators":[{"nameType":"Personal","givenName":"Yi-Ming","familyName":"Liu","name":"Liu, Yi-Ming","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Wei-Qiang","familyName":"Chen","name":"Chen, Wei-Qiang","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Zheng-Cheng","familyName":"Gu","name":"Gu, Zheng-Cheng","affiliation":[],"nameIdentifiers":[]}],"titles":[{"title":"Real-space construction and classification for time-reversal symmetric crystalline superconductors in 2D interacting fermionic systems"}],"publisher":"arXiv","container":{},"publicationYear":2026,"subjects":[{"subject":"Strongly Correlated Electrons (cond-mat.str-el)","lang":"en","subjectScheme":"arXiv"},{"subject":"FOS: Physical sciences","subjectScheme":"Fields of Science and Technology (FOS)"},{"schemeUri":"http://www.oecd.org/science/inno/38235147.pdf","subject":"FOS: Physical sciences","subjectScheme":"Fields of Science and Technology (FOS)"}],"contributors":[],"dates":[{"date":"2026-02-24T05:15:39Z","dateType":"Submitted","dateInformation":"v1"},{"date":"2026-02-25T01:23:16Z","dateType":"Updated","dateInformation":"v1"},{"date":"2026-02","dateType":"Available","dateInformation":"v1"},{"date":"2026","dateType":"Issued"}],"language":null,"types":{"schemaOrg":"CreativeWork","resourceTypeGeneral":"Preprint","citeproc":"article","bibtex":"misc","ris":"GEN","resourceType":"Article"},"relatedIdentifiers":[],"relatedItems":[],"sizes":[],"formats":[],"version":"1","rightsList":[{"rightsUri":"http://arxiv.org/licenses/nonexclusive-distrib/1.0/","rights":"arXiv.org perpetual, non-exclusive license"}],"descriptions":[{"descriptionType":"Abstract","description":"Crystalline symmetry and time-reversal symmetry are commonly present in real superconducting materials. However, the topological classification of systems respecting these symmetries, particularly for interacting fermions, remains incomplete. In this work, we systematically classify time-reversal symmetry-protected crystalline topological superconductors in two-dimensional interacting fermionic systems using an explicit real-space construction. Among the resulting phases, we identify intrinsically interacting fermionic topological superconductors, i.e., phases that cannot be realized in either free-fermion or interacting bosonic systems. For spinless fermions with protecting symmetry group $C_4 \\times Z_2^T$ or $D_4 \\times Z_2^T$ (plus fermion parity), the intrinsic sector has a $Z_4$ classification. The corresponding root phases generating this $Z_4$ classification admit a transparent real-space construction in terms of decorated 1D blocks. These blocks are 1D fermionic symmetry-protected topological (FSPT) phases, realizable as double Majorana chains. We further find the corresponding $Z_4$ spinless intrinsic phases for wallpaper groups $p4$, $p4m$, and $p4g$. We also find an additional $Z_2$ intrinsically interacting phase for spinless fermions with wallpaper group $pm$, which is absent with the corresponding point-group symmetry alone. Moreover, these intrinsic phases naturally give rise to higher-order FSPT phases that support corner zero modes. Finally, we verify the crystalline equivalence principle for generic 2D interacting FSPT systems with both crystalline and internal symmetries."}],"geoLocations":[],"fundingReferences":[],"url":"https://arxiv.org/abs/2602.20560","contentUrl":null,"metadataVersion":0,"schemaVersion":"http://datacite.org/schema/kernel-4","source":"mds","isActive":true,"state":"findable","reason":null,"viewCount":0,"downloadCount":0,"referenceCount":0,"citationCount":0,"partCount":0,"partOfCount":0,"versionCount":0,"versionOfCount":0,"created":"2026-02-25T02:53:06Z","registered":"2026-02-25T02:53:07Z","published":null,"updated":"2026-02-25T02:53:07Z"},"relationships":{"client":{"data":{"id":"arxiv.content","type":"clients"}}}},{"id":"10.48550/arxiv.2602.20559","type":"dois","attributes":{"doi":"10.48550/arxiv.2602.20559","identifiers":[{"identifier":"2602.20559","identifierType":"arXiv"}],"creators":[{"nameType":"Personal","givenName":"Rui","familyName":"Wang","name":"Wang, Rui","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Junyuan","familyName":"Gao","name":"Gao, Junyuan","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Shuowen","familyName":"Zhang","name":"Zhang, Shuowen","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Bruno","familyName":"Clerckx","name":"Clerckx, Bruno","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Liang","familyName":"Liu","name":"Liu, Liang","affiliation":[],"nameIdentifiers":[]}],"titles":[{"title":"On Channel Estimation for Group-Connected Beyond Diagonal RIS Assisted Multi-User MIMO Communication"}],"publisher":"arXiv","container":{},"publicationYear":2026,"subjects":[{"subject":"Signal Processing (eess.SP)","lang":"en","subjectScheme":"arXiv"},{"subject":"Information Theory (cs.IT)","lang":"en","subjectScheme":"arXiv"},{"subject":"FOS: Electrical engineering, electronic engineering, information engineering","subjectScheme":"Fields of Science and Technology (FOS)"},{"schemeUri":"http://www.oecd.org/science/inno/38235147.pdf","subject":"FOS: Electrical engineering, electronic engineering, information engineering","subjectScheme":"Fields of Science and Technology (FOS)"},{"subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"},{"schemeUri":"http://www.oecd.org/science/inno/38235147.pdf","subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"}],"contributors":[],"dates":[{"date":"2026-02-24T05:15:25Z","dateType":"Submitted","dateInformation":"v1"},{"date":"2026-02-25T01:23:15Z","dateType":"Updated","dateInformation":"v1"},{"date":"2026-02","dateType":"Available","dateInformation":"v1"},{"date":"2026","dateType":"Issued"}],"language":null,"types":{"schemaOrg":"CreativeWork","resourceTypeGeneral":"Preprint","citeproc":"article","bibtex":"misc","ris":"GEN","resourceType":"Article"},"relatedIdentifiers":[],"relatedItems":[],"sizes":[],"formats":[],"version":"1","rightsList":[{"rightsUri":"http://arxiv.org/licenses/nonexclusive-distrib/1.0/","rights":"arXiv.org perpetual, non-exclusive license"}],"descriptions":[{"descriptionType":"Abstract","description":"Beyond diagonal reconfigurable intelligent surface (BD-RIS) architectures offer superior beamforming gain over conventional diagonal RISs. However, the channel estimation overhead is the main hurdle for reaping the above gain in practice. This letter addresses this issue for group-connected BDRIS aided uplink communication from multiple multi-antenna users to one multi-antenna base station (BS). We first reveal that within each BD-RIS group, the cascaded channel associated with one user antenna and one BD-RIS element is a scaled version of that associated with any other user antenna and BD-RIS element due to the common RIS-BS channel. This insight drastically reduces the dimensionality of the channel estimation problem. Building on this property, we propose an efficient two-phase channel estimation protocol. In the first phase, the reference cascaded channels for all groups are estimated in parallel based on common received signals while determining the scaling coefficients for a single reference antenna. In the second phase, the scaling coefficients for all remaining user antennas are estimated. Numerical results demonstrate that our proposed framework achieves substantially lower estimation error with fewer pilot signals compared to state-of-the-art benchmark schemes."}],"geoLocations":[],"fundingReferences":[],"url":"https://arxiv.org/abs/2602.20559","contentUrl":null,"metadataVersion":0,"schemaVersion":"http://datacite.org/schema/kernel-4","source":"mds","isActive":true,"state":"findable","reason":null,"viewCount":0,"downloadCount":0,"referenceCount":0,"citationCount":0,"partCount":0,"partOfCount":0,"versionCount":0,"versionOfCount":0,"created":"2026-02-25T02:53:04Z","registered":"2026-02-25T02:53:05Z","published":null,"updated":"2026-02-25T02:53:05Z"},"relationships":{"client":{"data":{"id":"arxiv.content","type":"clients"}}}},{"id":"10.48550/arxiv.2602.20557","type":"dois","attributes":{"doi":"10.48550/arxiv.2602.20557","identifiers":[{"identifier":"2602.20557","identifierType":"arXiv"}],"creators":[{"nameType":"Personal","givenName":"Qian","familyName":"Li","name":"Li, Qian","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Yuxiao","familyName":"Hu","name":"Hu, Yuxiao","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Juncheng","familyName":"Liu","name":"Liu, Juncheng","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Yuntian","familyName":"Chen","name":"Chen, Yuntian","affiliation":[],"nameIdentifiers":[]}],"titles":[{"title":"GENSR: Symbolic Regression Based in Equation Generative Space"}],"publisher":"arXiv","container":{},"publicationYear":2026,"subjects":[{"subject":"Machine Learning (cs.LG)","lang":"en","subjectScheme":"arXiv"},{"subject":"Symbolic Computation (cs.SC)","lang":"en","subjectScheme":"arXiv"},{"subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"},{"schemeUri":"http://www.oecd.org/science/inno/38235147.pdf","subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"}],"contributors":[],"dates":[{"date":"2026-02-24T05:14:34Z","dateType":"Submitted","dateInformation":"v1"},{"date":"2026-02-25T01:23:12Z","dateType":"Updated","dateInformation":"v1"},{"date":"2026-02","dateType":"Available","dateInformation":"v1"},{"date":"2026","dateType":"Issued"}],"language":null,"types":{"schemaOrg":"CreativeWork","resourceTypeGeneral":"Preprint","citeproc":"article","bibtex":"misc","ris":"GEN","resourceType":"Article"},"relatedIdentifiers":[],"relatedItems":[],"sizes":[],"formats":[],"version":"1","rightsList":[{"rightsUri":"http://arxiv.org/licenses/nonexclusive-distrib/1.0/","rights":"arXiv.org perpetual, non-exclusive license"}],"descriptions":[{"descriptionType":"Abstract","description":"Symbolic Regression (SR) tries to reveal the hidden equations behind observed data. However, most methods search within a discrete equation space, where the structural modifications of equations rarely align with their numerical behavior, leaving fitting error feedback too noisy to guide exploration. To address this challenge, we propose GenSR, a generative latent space-based SR framework following the `map construction -\u0026gt; coarse localization -\u0026gt; fine search'' paradigm. Specifically, GenSR first pretrains a dual-branch Conditional Variational Autoencoder (CVAE) to reparameterize symbolic equations into a generative latent space with symbolic continuity and local numerical smoothness. This space can be regarded as a well-structured `map'' of the equation space, providing directional signals for search. At inference, the CVAE coarsely localizes the input data to promising regions in the latent space. Then, a modified CMA-ES refines the candidate region, leveraging smooth latent gradients. From a Bayesian perspective, GenSR reframes the SR task as maximizing the conditional distribution $p(\\mathrm{Equ.} \\mid \\mathrm{Num.})$, with CVAE training achieving this objective through the Evidence Lower Bound (ELBO). This new perspective provides a theoretical guarantee for the effectiveness of GenSR. Extensive experiments show that GenSR jointly optimizes predictive accuracy, expression simplicity, and computational efficiency, while remaining robust under noise."}],"geoLocations":[],"fundingReferences":[],"url":"https://arxiv.org/abs/2602.20557","contentUrl":null,"metadataVersion":0,"schemaVersion":"http://datacite.org/schema/kernel-4","source":"mds","isActive":true,"state":"findable","reason":null,"viewCount":0,"downloadCount":0,"referenceCount":0,"citationCount":0,"partCount":0,"partOfCount":0,"versionCount":0,"versionOfCount":0,"created":"2026-02-25T02:53:02Z","registered":"2026-02-25T02:53:02Z","published":null,"updated":"2026-02-25T02:53:02Z"},"relationships":{"client":{"data":{"id":"arxiv.content","type":"clients"}}}},{"id":"10.48550/arxiv.2602.20556","type":"dois","attributes":{"doi":"10.48550/arxiv.2602.20556","identifiers":[{"identifier":"2602.20556","identifierType":"arXiv"}],"creators":[{"nameType":"Personal","givenName":"Hanhui","familyName":"Li","name":"Li, Hanhui","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Xuan","familyName":"Huang","name":"Huang, Xuan","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Wanquan","familyName":"Liu","name":"Liu, Wanquan","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Yuhao","familyName":"Cheng","name":"Cheng, Yuhao","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Long","familyName":"Chen","name":"Chen, Long","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Yiqiang","familyName":"Yan","name":"Yan, Yiqiang","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Xiaodan","familyName":"Liang","name":"Liang, Xiaodan","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Chenqiang","familyName":"Gao","name":"Gao, Chenqiang","affiliation":[],"nameIdentifiers":[]}],"titles":[{"title":"WildGHand: Learning Anti-Perturbation Gaussian Hand Avatars from Monocular In-the-Wild Videos"}],"publisher":"arXiv","container":{},"publicationYear":2026,"subjects":[{"subject":"Computer Vision and Pattern Recognition (cs.CV)","lang":"en","subjectScheme":"arXiv"},{"subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"},{"schemeUri":"http://www.oecd.org/science/inno/38235147.pdf","subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"}],"contributors":[],"dates":[{"date":"2026-02-24T05:14:05Z","dateType":"Submitted","dateInformation":"v1"},{"date":"2026-02-25T01:23:10Z","dateType":"Updated","dateInformation":"v1"},{"date":"2026-02","dateType":"Available","dateInformation":"v1"},{"date":"2026","dateType":"Issued"}],"language":null,"types":{"schemaOrg":"CreativeWork","resourceTypeGeneral":"Preprint","citeproc":"article","bibtex":"misc","ris":"GEN","resourceType":"Article"},"relatedIdentifiers":[],"relatedItems":[],"sizes":[],"formats":[],"version":"1","rightsList":[{"rightsIdentifierScheme":"SPDX","rightsUri":"https://creativecommons.org/licenses/by/4.0/legalcode","schemeUri":"https://spdx.org/licenses/","rights":"Creative Commons Attribution 4.0 International","rightsIdentifier":"cc-by-4.0"}],"descriptions":[{"descriptionType":"Abstract","description":"Despite recent progress in 3D hand reconstruction from monocular videos, most existing methods rely on data captured in well-controlled environments and therefore degrade in real-world settings with severe perturbations, such as hand-object interactions, extreme poses, illumination changes, and motion blur. To tackle these issues, we introduce WildGHand, an optimization-based framework that enables self-adaptive 3D Gaussian splatting on in-the-wild videos and produces high-fidelity hand avatars. WildGHand incorporates two key components: (i) a dynamic perturbation disentanglement module that explicitly represents perturbations as time-varying biases on 3D Gaussian attributes during optimization, and (ii) a perturbation-aware optimization strategy that generates per-frame anisotropic weighted masks to guide optimization. Together, these components allow the framework to identify and suppress perturbations across both spatial and temporal dimensions. We further curate a dataset of monocular hand videos captured under diverse perturbations to benchmark in-the-wild hand avatar reconstruction. Extensive experiments on this dataset and two public datasets demonstrate that WildGHand achieves state-of-the-art performance and substantially improves over its base model across multiple metrics (e.g., up to a $15.8\\%$ relative gain in PSNR and a $23.1\\%$ relative reduction in LPIPS). Our implementation and dataset are available at https://github.com/XuanHuang0/WildGHand."}],"geoLocations":[],"fundingReferences":[],"url":"https://arxiv.org/abs/2602.20556","contentUrl":null,"metadataVersion":0,"schemaVersion":"http://datacite.org/schema/kernel-4","source":"mds","isActive":true,"state":"findable","reason":null,"viewCount":0,"downloadCount":0,"referenceCount":0,"citationCount":0,"partCount":0,"partOfCount":0,"versionCount":0,"versionOfCount":0,"created":"2026-02-25T02:53:00Z","registered":"2026-02-25T02:53:01Z","published":null,"updated":"2026-02-25T02:53:01Z"},"relationships":{"client":{"data":{"id":"arxiv.content","type":"clients"}}}},{"id":"10.48550/arxiv.2602.20554","type":"dois","attributes":{"doi":"10.48550/arxiv.2602.20554","identifiers":[{"identifier":"2602.20554","identifierType":"arXiv"}],"creators":[{"nameType":"Personal","givenName":"Lipeng","familyName":"Duan","name":"Duan, Lipeng","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Suting","familyName":"Wei","name":"Wei, Suting","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Jun","familyName":"Yang","name":"Yang, Jun","affiliation":[],"nameIdentifiers":[]}],"titles":[{"title":"Solutions with one dimensional concentration for a two dimensional Gross-Pitaevskii model with general potential"}],"publisher":"arXiv","container":{},"publicationYear":2026,"subjects":[{"subject":"Analysis of PDEs (math.AP)","lang":"en","subjectScheme":"arXiv"},{"subject":"FOS: Mathematics","subjectScheme":"Fields of Science and Technology (FOS)"},{"schemeUri":"http://www.oecd.org/science/inno/38235147.pdf","subject":"FOS: Mathematics","subjectScheme":"Fields of Science and Technology (FOS)"}],"contributors":[],"dates":[{"date":"2026-02-24T05:13:18Z","dateType":"Submitted","dateInformation":"v1"},{"date":"2026-02-25T01:23:08Z","dateType":"Updated","dateInformation":"v1"},{"date":"2026-02","dateType":"Available","dateInformation":"v1"},{"date":"2026","dateType":"Issued"}],"language":null,"types":{"schemaOrg":"CreativeWork","resourceTypeGeneral":"Preprint","citeproc":"article","bibtex":"misc","ris":"GEN","resourceType":"Article"},"relatedIdentifiers":[],"relatedItems":[],"sizes":[],"formats":[],"version":"1","rightsList":[{"rightsIdentifierScheme":"SPDX","rightsUri":"https://creativecommons.org/licenses/by/4.0/legalcode","schemeUri":"https://spdx.org/licenses/","rights":"Creative Commons Attribution 4.0 International","rightsIdentifier":"cc-by-4.0"}],"descriptions":[{"descriptionType":"Abstract","description":"We concern standing wave solutions with frequency $λ$ to a two dimensional Gross-Pitaevskii equation with a trap potential under the unit mass constraint, which is used to describe Bose-Einstein condensates with attractive interaction. First, we investigate the necessary conditions for existence of the solutions with concentration phenomena directed along closed smooth curves. Next, not only imposing stationary and non-degeneracy conditions on the curves with respect to an auxiliary weighted length involving the trap potential, but also adding some other technical assumptions, we select a sequence $\\{λ_j\\}$ of the frequency $λ$ with $-λ_j\\rightarrow +\\infty$ and construct solutions with concentration directed along the curves. Our result partially answers the conjecture raised in [A. Ambrosetti, A. Malchiodi, W.-M. Ni, Comm. Math. Phys. 2003] about necessary condition for solution concentrating at submanifolds. The solutions constructed in this paper are concentrating on curves whose length are non-uniformly bounded, and hence the situation is quite different from that in [M. del Pino, M. Kowalczyk, J. Wei, Comm. Pure Appl. Math. 2007]."}],"geoLocations":[],"fundingReferences":[],"url":"https://arxiv.org/abs/2602.20554","contentUrl":null,"metadataVersion":0,"schemaVersion":"http://datacite.org/schema/kernel-4","source":"mds","isActive":true,"state":"findable","reason":null,"viewCount":0,"downloadCount":0,"referenceCount":0,"citationCount":0,"partCount":0,"partOfCount":0,"versionCount":0,"versionOfCount":0,"created":"2026-02-25T02:52:57Z","registered":"2026-02-25T02:52:58Z","published":null,"updated":"2026-02-25T02:52:58Z"},"relationships":{"client":{"data":{"id":"arxiv.content","type":"clients"}}}},{"id":"10.48550/arxiv.2602.20550","type":"dois","attributes":{"doi":"10.48550/arxiv.2602.20550","identifiers":[{"identifier":"2602.20550","identifierType":"arXiv"}],"creators":[{"nameType":"Personal","givenName":"Chengshuai","familyName":"Yang","name":"Yang, Chengshuai","affiliation":[],"nameIdentifiers":[]}],"titles":[{"title":"The Finite Primitive Basis Theorem for Computational Imaging: Formal Foundations of the OperatorGraph Representation"}],"publisher":"arXiv","container":{},"publicationYear":2026,"subjects":[{"subject":"Computer Vision and Pattern Recognition (cs.CV)","lang":"en","subjectScheme":"arXiv"},{"subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"},{"schemeUri":"http://www.oecd.org/science/inno/38235147.pdf","subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"}],"contributors":[],"dates":[{"date":"2026-02-24T05:07:06Z","dateType":"Submitted","dateInformation":"v1"},{"date":"2026-02-25T01:22:58Z","dateType":"Updated","dateInformation":"v1"},{"date":"2026-02","dateType":"Available","dateInformation":"v1"},{"date":"2026","dateType":"Issued"}],"language":null,"types":{"schemaOrg":"CreativeWork","resourceTypeGeneral":"Preprint","citeproc":"article","bibtex":"misc","ris":"GEN","resourceType":"Article"},"relatedIdentifiers":[],"relatedItems":[],"sizes":[],"formats":[],"version":"1","rightsList":[{"rightsIdentifierScheme":"SPDX","rightsUri":"https://creativecommons.org/licenses/by/4.0/legalcode","schemeUri":"https://spdx.org/licenses/","rights":"Creative Commons Attribution 4.0 International","rightsIdentifier":"cc-by-4.0"}],"descriptions":[{"descriptionType":"Abstract","description":"Computational imaging forward models, from coded aperture spectral cameras to MRI scanners, are traditionally implemented as monolithic, modality-specific codes. We prove that every forward model in a broad, precisely defined operator class Cimg (encompassing clinical, scientific, and industrial imaging modalities, both linear and nonlinear) admits an epsilon-approximate representation as a typed directed acyclic graph (DAG) whose nodes are drawn from a library of exactly 11 canonical primitives: Propagate, Modulate, Project, Encode, Convolve, Accumulate, Detect, Sample, Disperse, Scatter, and Transform. We call this the Finite Primitive Basis Theorem. The proof is constructive: we provide an algorithm that, given any H in Cimg, produces a DAG G with relative operator error at most epsilon and graph complexity within prescribed bounds. We further prove that the library is minimal: removing any single primitive causes at least one modality to lose its epsilon-approximate representation. A systematic analysis of nonlinearities in imaging physics shows they fall into two structural categories: pointwise scalar functions (handled by Transform) and self-consistent iterations (unrolled into existing linear primitives). Empirical validation on 31 linear modalities confirms eimg below 0.01 with at most 5 nodes and depth 5, and we provide constructive DAG decompositions for 9 additional nonlinear modalities. These results establish mathematical foundations for the Physics World Model (PWM) framework."}],"geoLocations":[],"fundingReferences":[],"url":"https://arxiv.org/abs/2602.20550","contentUrl":null,"metadataVersion":0,"schemaVersion":"http://datacite.org/schema/kernel-4","source":"mds","isActive":true,"state":"findable","reason":null,"viewCount":0,"downloadCount":0,"referenceCount":0,"citationCount":0,"partCount":0,"partOfCount":0,"versionCount":0,"versionOfCount":0,"created":"2026-02-25T02:52:52Z","registered":"2026-02-25T02:52:53Z","published":null,"updated":"2026-02-25T02:52:53Z"},"relationships":{"client":{"data":{"id":"arxiv.content","type":"clients"}}}},{"id":"10.48550/arxiv.2602.20548","type":"dois","attributes":{"doi":"10.48550/arxiv.2602.20548","identifiers":[{"identifier":"2602.20548","identifierType":"arXiv"}],"creators":[{"nameType":"Personal","givenName":"Shuai","familyName":"Wang","name":"Wang, Shuai","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Malu","familyName":"Zhang","name":"Zhang, Malu","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Yulin","familyName":"Jiang","name":"Jiang, Yulin","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Dehao","familyName":"Zhang","name":"Zhang, Dehao","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Ammar","familyName":"Belatreche","name":"Belatreche, Ammar","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Yu","familyName":"Liang","name":"Liang, Yu","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Yimeng","familyName":"Shan","name":"Shan, Yimeng","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Zijian","familyName":"Zhou","name":"Zhou, Zijian","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Yang","familyName":"Yang","name":"Yang, Yang","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Haizhou","familyName":"Li","name":"Li, Haizhou","affiliation":[],"nameIdentifiers":[]}],"titles":[{"title":"Robust Spiking Neural Networks Against Adversarial Attacks"}],"publisher":"arXiv","container":{},"publicationYear":2026,"subjects":[{"subject":"Computer Vision and Pattern Recognition (cs.CV)","lang":"en","subjectScheme":"arXiv"},{"subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"},{"schemeUri":"http://www.oecd.org/science/inno/38235147.pdf","subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"}],"contributors":[],"dates":[{"date":"2026-02-24T05:06:12Z","dateType":"Submitted","dateInformation":"v1"},{"date":"2026-02-25T01:22:48Z","dateType":"Updated","dateInformation":"v1"},{"date":"2026-02","dateType":"Available","dateInformation":"v1"},{"date":"2026","dateType":"Issued"}],"language":null,"types":{"schemaOrg":"CreativeWork","resourceTypeGeneral":"Preprint","citeproc":"article","bibtex":"misc","ris":"GEN","resourceType":"Article"},"relatedIdentifiers":[],"relatedItems":[],"sizes":[],"formats":[],"version":"1","rightsList":[{"rightsIdentifierScheme":"SPDX","rightsUri":"https://creativecommons.org/licenses/by/4.0/legalcode","schemeUri":"https://spdx.org/licenses/","rights":"Creative Commons Attribution 4.0 International","rightsIdentifier":"cc-by-4.0"}],"descriptions":[{"descriptionType":"Abstract","description":"Spiking Neural Networks (SNNs) represent a promising paradigm for energy-efficient neuromorphic computing due to their bio-plausible and spike-driven characteristics. However, the robustness of SNNs in complex adversarial environments remains significantly constrained. In this study, we theoretically demonstrate that those threshold-neighboring spiking neurons are the key factors limiting the robustness of directly trained SNNs. We find that these neurons set the upper limits for the maximum potential strength of adversarial attacks and are prone to state-flipping under minor disturbances. To address this challenge, we propose a Threshold Guarding Optimization (TGO) method, which comprises two key aspects. First, we incorporate additional constraints into the loss function to move neurons' membrane potentials away from their thresholds. It increases SNNs' gradient sparsity, thereby reducing the theoretical upper bound of adversarial attacks. Second, we introduce noisy spiking neurons to transition the neuronal firing mechanism from deterministic to probabilistic, decreasing their state-flipping probability due to minor disturbances. Extensive experiments conducted in standard adversarial scenarios prove that our method significantly enhances the robustness of directly trained SNNs. These findings pave the way for advancing more reliable and secure neuromorphic computing in real-world applications."},{"descriptionType":"Other","description":"Published as a conference paper at ICLR 2026"}],"geoLocations":[],"fundingReferences":[],"url":"https://arxiv.org/abs/2602.20548","contentUrl":null,"metadataVersion":0,"schemaVersion":"http://datacite.org/schema/kernel-4","source":"mds","isActive":true,"state":"findable","reason":null,"viewCount":0,"downloadCount":0,"referenceCount":0,"citationCount":0,"partCount":0,"partOfCount":0,"versionCount":0,"versionOfCount":0,"created":"2026-02-25T02:52:49Z","registered":"2026-02-25T02:52:50Z","published":null,"updated":"2026-02-25T02:52:50Z"},"relationships":{"client":{"data":{"id":"arxiv.content","type":"clients"}}}},{"id":"10.48550/arxiv.2602.20547","type":"dois","attributes":{"doi":"10.48550/arxiv.2602.20547","identifiers":[{"identifier":"2602.20547","identifierType":"arXiv"}],"creators":[{"nameType":"Personal","givenName":"Griffin","familyName":"Pitts","name":"Pitts, Griffin","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Sanaz","familyName":"Motamedi","name":"Motamedi, Sanaz","affiliation":[],"nameIdentifiers":[]}],"titles":[{"title":"What Drives Students' Use of AI Chatbots? Technology Acceptance in Conversational AI"}],"publisher":"arXiv","container":{},"publicationYear":2026,"subjects":[{"subject":"Human-Computer Interaction (cs.HC)","lang":"en","subjectScheme":"arXiv"},{"subject":"Artificial Intelligence (cs.AI)","lang":"en","subjectScheme":"arXiv"},{"subject":"Computers and Society (cs.CY)","lang":"en","subjectScheme":"arXiv"},{"subject":"Emerging Technologies (cs.ET)","lang":"en","subjectScheme":"arXiv"},{"subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"},{"schemeUri":"http://www.oecd.org/science/inno/38235147.pdf","subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"},{"subject":"J.4; K.3; K.4","lang":"en","subjectScheme":"ACM"}],"contributors":[],"dates":[{"date":"2026-02-24T05:00:41Z","dateType":"Submitted","dateInformation":"v1"},{"date":"2026-02-25T01:22:39Z","dateType":"Updated","dateInformation":"v1"},{"date":"2026-02","dateType":"Available","dateInformation":"v1"},{"date":"2026","dateType":"Issued"}],"language":null,"types":{"schemaOrg":"CreativeWork","resourceTypeGeneral":"Preprint","citeproc":"article","bibtex":"misc","ris":"GEN","resourceType":"Article"},"relatedIdentifiers":[],"relatedItems":[],"sizes":[],"formats":[],"version":"1","rightsList":[{"rightsUri":"http://arxiv.org/licenses/nonexclusive-distrib/1.0/","rights":"arXiv.org perpetual, non-exclusive license"}],"descriptions":[{"descriptionType":"Abstract","description":"Conversational AI tools have been rapidly adopted by students and are becoming part of their learning routines. To understand what drives this adoption, we draw on the Technology Acceptance Model (TAM) and examine how perceived usefulness and perceived ease of use relate to students' behavioral intention to use conversational AI that generates responses for learning tasks. We extend TAM by incorporating trust, perceived enjoyment, and subjective norms as additional factors that capture social and affective influences and uncertainty around AI outputs.\n Using partial least squares structural equation modeling, we find perceived usefulness remains the strongest predictor of students' intention to use conversational AI. However, perceived ease of use does not exert a significant direct effect on behavioral intention once other factors are considered, operating instead indirectly through perceived usefulness. Trust and subjective norms significantly influence perceptions of usefulness, while perceived enjoyment exerts both a direct and indirect effect on usage intentions. These findings suggest that adoption decisions for conversational AI systems are influenced less by effort-related considerations and more by confidence in system outputs, affective engagement, and social context. Future research is needed to further examine how these acceptance relationships generalize across different conversational systems and usage contexts."}],"geoLocations":[],"fundingReferences":[],"url":"https://arxiv.org/abs/2602.20547","contentUrl":null,"metadataVersion":0,"schemaVersion":"http://datacite.org/schema/kernel-4","source":"mds","isActive":true,"state":"findable","reason":null,"viewCount":0,"downloadCount":0,"referenceCount":0,"citationCount":0,"partCount":0,"partOfCount":0,"versionCount":0,"versionOfCount":0,"created":"2026-02-25T02:52:48Z","registered":"2026-02-25T02:52:49Z","published":null,"updated":"2026-02-25T02:52:49Z"},"relationships":{"client":{"data":{"id":"arxiv.content","type":"clients"}}}},{"id":"10.48550/arxiv.2602.20545","type":"dois","attributes":{"doi":"10.48550/arxiv.2602.20545","identifiers":[{"identifier":"2602.20545","identifierType":"arXiv"}],"creators":[{"nameType":"Personal","givenName":"Ravindra","familyName":"Singh","name":"Singh, Ravindra","affiliation":[],"nameIdentifiers":[]}],"titles":[{"title":"Optimal inequalities involving Casorati curvatures along Riemannian maps and Riemannian submersions for quaternionic space form"}],"publisher":"arXiv","container":{},"publicationYear":2026,"subjects":[{"subject":"Differential Geometry (math.DG)","lang":"en","subjectScheme":"arXiv"},{"subject":"FOS: Mathematics","subjectScheme":"Fields of Science and Technology (FOS)"},{"schemeUri":"http://www.oecd.org/science/inno/38235147.pdf","subject":"FOS: Mathematics","subjectScheme":"Fields of Science and Technology (FOS)"},{"subject":"53B20, 53B35, 53C15, 53D15","lang":"en","subjectScheme":"MSC"}],"contributors":[],"dates":[{"date":"2026-02-24T04:57:04Z","dateType":"Submitted","dateInformation":"v1"},{"date":"2026-02-25T01:22:37Z","dateType":"Updated","dateInformation":"v1"},{"date":"2026-02","dateType":"Available","dateInformation":"v1"},{"date":"2026","dateType":"Issued"}],"language":null,"types":{"schemaOrg":"CreativeWork","resourceTypeGeneral":"Preprint","citeproc":"article","bibtex":"misc","ris":"GEN","resourceType":"Article"},"relatedIdentifiers":[],"relatedItems":[],"sizes":[],"formats":[],"version":"1","rightsList":[{"rightsIdentifierScheme":"SPDX","rightsUri":"https://creativecommons.org/licenses/by/4.0/legalcode","schemeUri":"https://spdx.org/licenses/","rights":"Creative Commons Attribution 4.0 International","rightsIdentifier":"cc-by-4.0"}],"descriptions":[{"descriptionType":"Abstract","description":"In this paper, we establish Casorati inequalities for Riemannian maps and Riemannian submersions involving quaternionic space forms, and we provide geometric characterisations of their equality cases. First, we derive Casorati inequalities for Riemannian maps to quaternionic space forms and describe the corresponding equality cases, showing that the leaves of the range space are invariantly quasi-umbilical, and that the associated shape operator matrix commutes. Next, we obtain Casorati inequalities involving the fundamental tensor fields $T$ and $A$ for Riemannian submersions from quaternionic space forms onto Riemannian manifolds, together with their geometric interpretations. In particular, we prove that the equality case corresponding to the tensor field $A$ along the horizontal distribution is equivalent to the integrability of the horizontal distribution. Moreover, the equality case associated with the tensor field $T$ along the vertical distribution characterises fibres that are invariantly quasi-umbilical with a commuting shape operator matrix. Finally, the simultaneous equality cases involving both tensor fields $T$ and $A$ along the horizontal and vertical distributions imply the integrability of the horizontal distribution together with the invariantly quasi-umbilical nature of the fibres and the commutativity of the corresponding shape operators."}],"geoLocations":[],"fundingReferences":[],"url":"https://arxiv.org/abs/2602.20545","contentUrl":null,"metadataVersion":0,"schemaVersion":"http://datacite.org/schema/kernel-4","source":"mds","isActive":true,"state":"findable","reason":null,"viewCount":0,"downloadCount":0,"referenceCount":0,"citationCount":0,"partCount":0,"partOfCount":0,"versionCount":0,"versionOfCount":0,"created":"2026-02-25T02:52:42Z","registered":"2026-02-25T02:52:43Z","published":null,"updated":"2026-02-25T02:52:43Z"},"relationships":{"client":{"data":{"id":"arxiv.content","type":"clients"}}}},{"id":"10.48550/arxiv.2602.20544","type":"dois","attributes":{"doi":"10.48550/arxiv.2602.20544","identifiers":[{"identifier":"2602.20544","identifierType":"arXiv"}],"creators":[{"nameType":"Personal","givenName":"Hannah","familyName":"Kim","name":"Kim, Hannah","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Rahad Arman","familyName":"Nabid","name":"Nabid, Rahad Arman","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Jeni","familyName":"Sorathiya","name":"Sorathiya, Jeni","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Minh","familyName":"Doan","name":"Doan, Minh","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Elijah","familyName":"Jordan","name":"Jordan, Elijah","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Rayhana","familyName":"Nasimova","name":"Nasimova, Rayhana","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Sergei L. Kosakovsky","familyName":"Pond","name":"Pond, Sergei L. Kosakovsky","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Stephen","familyName":"MacNeil","name":"MacNeil, Stephen","affiliation":[],"nameIdentifiers":[]}],"titles":[{"title":"Changing the Optics: Comparing Traditional and Retrieval-Augmented GenAI E-Tutorials in Interdisciplinary Learning"}],"publisher":"arXiv","container":{},"publicationYear":2026,"subjects":[{"subject":"Human-Computer Interaction (cs.HC)","lang":"en","subjectScheme":"arXiv"},{"subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"},{"schemeUri":"http://www.oecd.org/science/inno/38235147.pdf","subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"},{"subject":"J.3; K.3.2","lang":"en","subjectScheme":"ACM"}],"contributors":[],"dates":[{"date":"2026-02-24T04:53:14Z","dateType":"Submitted","dateInformation":"v1"},{"date":"2026-02-25T01:22:27Z","dateType":"Updated","dateInformation":"v1"},{"date":"2026-02","dateType":"Available","dateInformation":"v1"},{"date":"2026","dateType":"Issued"}],"language":null,"types":{"schemaOrg":"CreativeWork","resourceTypeGeneral":"Preprint","citeproc":"article","bibtex":"misc","ris":"GEN","resourceType":"Article"},"relatedIdentifiers":[],"relatedItems":[],"sizes":[],"formats":[],"version":"1","rightsList":[{"rightsIdentifierScheme":"SPDX","rightsUri":"https://creativecommons.org/licenses/by/4.0/legalcode","schemeUri":"https://spdx.org/licenses/","rights":"Creative Commons Attribution 4.0 International","rightsIdentifier":"cc-by-4.0"}],"descriptions":[{"descriptionType":"Abstract","description":"Understanding information-seeking behaviors in e-learning is critical, as learners must often make sense of complex and fragmented information, a challenge compounded in interdisciplinary fields with diverse prior knowledge. Compared to traditional e-tutorials, GenAI e-tutorials offer new ways to navigate information spaces, yet how they shape learners information-seeking behaviors remains unclear. To address this gap, we characterized behavioral differences between traditional and GenAI-mediated e-tutorial learning using the three search modes of orienteering. We conducted a between-subject study in which learners engaged with either a traditional e-tutorial or a GenAI e-tutorial accessing the same underlying information content. We found that the traditional users maintained greater awareness and focus of the information space, whereas GenAI users exhibited more proactive and exploratory behaviors with lower cognitive load due to the querying-driven interaction. These findings offer guidance for designing tutorials in e-learning."},{"descriptionType":"Other","description":"6 pages (16 pages including appendix), 2 figures, 5 supplementary figures, 2 supplementary tables"}],"geoLocations":[],"fundingReferences":[],"url":"https://arxiv.org/abs/2602.20544","contentUrl":null,"metadataVersion":0,"schemaVersion":"http://datacite.org/schema/kernel-4","source":"mds","isActive":true,"state":"findable","reason":null,"viewCount":0,"downloadCount":0,"referenceCount":0,"citationCount":0,"partCount":0,"partOfCount":0,"versionCount":0,"versionOfCount":0,"created":"2026-02-25T02:52:41Z","registered":"2026-02-25T02:52:41Z","published":null,"updated":"2026-02-25T02:52:41Z"},"relationships":{"client":{"data":{"id":"arxiv.content","type":"clients"}}}},{"id":"10.48550/arxiv.2602.20543","type":"dois","attributes":{"doi":"10.48550/arxiv.2602.20543","identifiers":[{"identifier":"2602.20543","identifierType":"arXiv"}],"creators":[{"nameType":"Personal","givenName":"Subhra Jyoti","familyName":"Mandal","name":"Mandal, Subhra Jyoti","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Lara","familyName":"Rachidi","name":"Rachidi, Lara","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Puneet","familyName":"Jain","name":"Jain, Puneet","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Matthieu","familyName":"Duvinage","name":"Duvinage, Matthieu","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Sander W.","familyName":"Timmer","name":"Timmer, Sander W.","affiliation":[],"nameIdentifiers":[]}],"titles":[{"title":"Beyond Human Performance: A Vision-Language Multi-Agent Approach for Quality Control in Pharmaceutical Manufacturing"}],"publisher":"arXiv","container":{},"publicationYear":2026,"subjects":[{"subject":"Computer Vision and Pattern Recognition (cs.CV)","lang":"en","subjectScheme":"arXiv"},{"subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"},{"schemeUri":"http://www.oecd.org/science/inno/38235147.pdf","subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"}],"contributors":[],"dates":[{"date":"2026-02-24T04:48:05Z","dateType":"Submitted","dateInformation":"v1"},{"date":"2026-02-25T01:22:09Z","dateType":"Updated","dateInformation":"v1"},{"date":"2026-02","dateType":"Available","dateInformation":"v1"},{"date":"2026","dateType":"Issued"}],"language":null,"types":{"schemaOrg":"CreativeWork","resourceTypeGeneral":"Preprint","citeproc":"article","bibtex":"misc","ris":"GEN","resourceType":"Article"},"relatedIdentifiers":[],"relatedItems":[],"sizes":[],"formats":[],"version":"1","rightsList":[{"rightsUri":"http://arxiv.org/licenses/nonexclusive-distrib/1.0/","rights":"arXiv.org perpetual, non-exclusive license"}],"descriptions":[{"descriptionType":"Abstract","description":"Colony-forming unit (CFU) detection is critical in pharmaceutical manufacturing, serving as a key component of Environmental Monitoring programs and ensuring compliance with stringent quality standards. Manual counting is labor-intensive and error-prone, while deep learning (DL) approaches, though accurate, remain vulnerable to sample quality variations and artifacts. Building on our earlier CNN-based framework (Beznik et al., 2020), we evaluated YOLOv5, YOLOv7, and YOLOv8 for CFU detection; however, these achieved only 97.08 percent accuracy, insufficient for pharmaceutical-grade requirements. A custom Detectron2 model trained on GSK's dataset of over 50,000 Petri dish images achieved 99 percent detection rate with 2 percent false positives and 0.6 percent false negatives. Despite high validation accuracy, Detectron2 performance degrades on outlier cases including contaminated plates, plastic artifacts, or poor optical clarity. To address this, we developed a multi-agent framework combining DL with vision-language models (VLMs). The VLM agent first classifies plates as valid or invalid. For valid samples, both DL and VLM agents independently estimate colony counts. When predictions align within 5 percent, results are automatically recorded in Postgres and SAP; otherwise, samples are routed for expert review. Expert feedback enables continuous retraining and self-improvement. Initial DL-based automation reduced human verification by 50 percent across vaccine manufacturing sites. With VLM integration, this increased to 85 percent, delivering significant operational savings. The proposed system provides a scalable, auditable, and regulation-ready solution for microbiological quality control, advancing automation in biopharmaceutical production."}],"geoLocations":[],"fundingReferences":[],"url":"https://arxiv.org/abs/2602.20543","contentUrl":null,"metadataVersion":0,"schemaVersion":"http://datacite.org/schema/kernel-4","source":"mds","isActive":true,"state":"findable","reason":null,"viewCount":0,"downloadCount":0,"referenceCount":0,"citationCount":0,"partCount":0,"partOfCount":0,"versionCount":0,"versionOfCount":0,"created":"2026-02-25T02:52:39Z","registered":"2026-02-25T02:52:40Z","published":null,"updated":"2026-02-25T02:52:40Z"},"relationships":{"client":{"data":{"id":"arxiv.content","type":"clients"}}}},{"id":"10.48550/arxiv.2602.20542","type":"dois","attributes":{"doi":"10.48550/arxiv.2602.20542","identifiers":[{"identifier":"2602.20542","identifierType":"arXiv"}],"creators":[{"nameType":"Personal","givenName":"Lei","familyName":"Huang","name":"Huang, Lei","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Yang","familyName":"Guo","name":"Guo, Yang","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Zhen","familyName":"Li","name":"Li, Zhen","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Jinhan","familyName":"Guo","name":"Guo, Jinhan","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Mingde","familyName":"Ding","name":"Ding, Mingde","affiliation":[],"nameIdentifiers":[]}],"titles":[{"title":"Rotation of a Solar Jet Driven by Plasma Flow along Helical Magnetic Fields in an Active Region"}],"publisher":"arXiv","container":{},"publicationYear":2026,"subjects":[{"subject":"Solar and Stellar Astrophysics (astro-ph.SR)","lang":"en","subjectScheme":"arXiv"},{"subject":"Plasma Physics (physics.plasm-ph)","lang":"en","subjectScheme":"arXiv"},{"subject":"FOS: Physical sciences","subjectScheme":"Fields of Science and Technology (FOS)"},{"schemeUri":"http://www.oecd.org/science/inno/38235147.pdf","subject":"FOS: Physical sciences","subjectScheme":"Fields of Science and Technology (FOS)"}],"contributors":[],"dates":[{"date":"2026-02-24T04:46:50Z","dateType":"Submitted","dateInformation":"v1"},{"date":"2026-02-25T01:22:06Z","dateType":"Updated","dateInformation":"v1"},{"date":"2026-02","dateType":"Available","dateInformation":"v1"},{"date":"2026","dateType":"Issued"}],"language":null,"types":{"schemaOrg":"CreativeWork","resourceTypeGeneral":"Preprint","citeproc":"article","bibtex":"misc","ris":"GEN","resourceType":"Article"},"relatedIdentifiers":[],"relatedItems":[],"sizes":[],"formats":[],"version":"1","rightsList":[{"rightsUri":"http://arxiv.org/licenses/nonexclusive-distrib/1.0/","rights":"arXiv.org perpetual, non-exclusive license"}],"descriptions":[{"descriptionType":"Abstract","description":"Solar jets, collimated plasma ejections driven by magnetic reconnection, play a vital role in energy transport and coronal heating. While rotational motions in jets are often attributed to magnetic field untwisting, alternative explanatory mechanisms remain possible. This study investigates a rotating jet in an active region observed on 2023 August 1 using multi-wavelength observations from Atmospheric Imaging Assembly (AIA), Chinese Ha Solar Explorer (CHASE), and Interface Region Imaging Spectrograph (IRIS), combined with a self-consistent time-dependent magnetofrictional (TMF) model and magnetohydrodynamic (MHD) simulation. Spectral diagnostics reveal coexisting red and blue shifts along the edges and central axis of the jet, indicating helical plasma motion within a twisted magnetic structure. Numerical simulations demonstrate that the jet's rotation arises from plasma propagating along helical open field lines, formed via reconnection between a pre-existing flux rope and overlying magnetic fields. Contrary to classical untwisting models, both linear and rotational velocities decrease with altitude during the jet propagation. These results highlight that the observed rotation results from plasma spiral motion along twisted fields rather than untwisting dynamics of the magnetic field itself, providing new insights into solar jet energetics and their connection to broader solar phenomena."},{"descriptionType":"Other","description":"19 pages, 10 figures; Accepted for publication in ApJ"}],"geoLocations":[],"fundingReferences":[],"url":"https://arxiv.org/abs/2602.20542","contentUrl":null,"metadataVersion":0,"schemaVersion":"http://datacite.org/schema/kernel-4","source":"mds","isActive":true,"state":"findable","reason":null,"viewCount":0,"downloadCount":0,"referenceCount":0,"citationCount":0,"partCount":0,"partOfCount":0,"versionCount":0,"versionOfCount":0,"created":"2026-02-25T02:52:38Z","registered":"2026-02-25T02:52:38Z","published":null,"updated":"2026-02-25T02:52:38Z"},"relationships":{"client":{"data":{"id":"arxiv.content","type":"clients"}}}},{"id":"10.48550/arxiv.2602.20539","type":"dois","attributes":{"doi":"10.48550/arxiv.2602.20539","identifiers":[{"identifier":"2602.20539","identifierType":"arXiv"}],"creators":[{"nameType":"Personal","givenName":"Yida","familyName":"Lin","name":"Lin, Yida","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Bing","familyName":"Xue","name":"Xue, Bing","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Mengjie","familyName":"Zhang","name":"Zhang, Mengjie","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Sam","familyName":"Schofield","name":"Schofield, Sam","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Richard","familyName":"Green","name":"Green, Richard","affiliation":[],"nameIdentifiers":[]}],"titles":[{"title":"Progressive Per-Branch Depth Optimization for DEFOM-Stereo and SAM3 Joint Analysis in UAV Forestry Applications"}],"publisher":"arXiv","container":{},"publicationYear":2026,"subjects":[{"subject":"Image and Video Processing (eess.IV)","lang":"en","subjectScheme":"arXiv"},{"subject":"Computer Vision and Pattern Recognition (cs.CV)","lang":"en","subjectScheme":"arXiv"},{"subject":"FOS: Electrical engineering, electronic engineering, information engineering","subjectScheme":"Fields of Science and Technology (FOS)"},{"schemeUri":"http://www.oecd.org/science/inno/38235147.pdf","subject":"FOS: Electrical engineering, electronic engineering, information engineering","subjectScheme":"Fields of Science and Technology (FOS)"},{"subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"},{"schemeUri":"http://www.oecd.org/science/inno/38235147.pdf","subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"}],"contributors":[],"dates":[{"date":"2026-02-24T04:37:18Z","dateType":"Submitted","dateInformation":"v1"},{"date":"2026-02-25T01:21:47Z","dateType":"Updated","dateInformation":"v1"},{"date":"2026-02","dateType":"Available","dateInformation":"v1"},{"date":"2026","dateType":"Issued"}],"language":null,"types":{"schemaOrg":"CreativeWork","resourceTypeGeneral":"Preprint","citeproc":"article","bibtex":"misc","ris":"GEN","resourceType":"Article"},"relatedIdentifiers":[],"relatedItems":[],"sizes":[],"formats":[],"version":"1","rightsList":[{"rightsIdentifierScheme":"SPDX","rightsUri":"https://creativecommons.org/licenses/by/4.0/legalcode","schemeUri":"https://spdx.org/licenses/","rights":"Creative Commons Attribution 4.0 International","rightsIdentifier":"cc-by-4.0"}],"descriptions":[{"descriptionType":"Abstract","description":"Accurate per-branch 3D reconstruction is a prerequisite for autonomous UAV-based tree pruning; however, dense disparity maps from modern stereo matchers often remain too noisy for individual branch analysis in complex forest canopies. This paper introduces a progressive pipeline integrating DEFOM-Stereo foundation-model disparity estimation, SAM3 instance segmentation, and multi-stage depth optimization to deliver robust per-branch point clouds. Starting from a naive baseline, we systematically identify and resolve three error families through successive refinements. Mask boundary contamination is first addressed through morphological erosion and subsequently refined via a skeleton-preserving variant to safeguard thin-branch topology. Segmentation inaccuracy is then mitigated using LAB-space Mahalanobis color validation coupled with cross-branch overlap arbitration. Finally, depth noise - the most persistent error source - is initially reduced by outlier removal and median filtering, before being superseded by a robust five-stage scheme comprising MAD global detection, spatial density consensus, local MAD filtering, RGB-guided filtering, and adaptive bilateral filtering. Evaluated on 1920x1080 stereo imagery of Radiata pine (Pinus radiata) acquired with a ZED Mini camera (63 mm baseline) from a UAV in Canterbury, New Zealand, the proposed pipeline reduces the average per-branch depth standard deviation by 82% while retaining edge fidelity. The result is geometrically coherent 3D point clouds suitable for autonomous pruning tool positioning. All code and processed data are publicly released to facilitate further UAV forestry research."}],"geoLocations":[],"fundingReferences":[],"url":"https://arxiv.org/abs/2602.20539","contentUrl":null,"metadataVersion":0,"schemaVersion":"http://datacite.org/schema/kernel-4","source":"mds","isActive":true,"state":"findable","reason":null,"viewCount":0,"downloadCount":0,"referenceCount":0,"citationCount":0,"partCount":0,"partOfCount":0,"versionCount":0,"versionOfCount":0,"created":"2026-02-25T02:52:33Z","registered":"2026-02-25T02:52:34Z","published":null,"updated":"2026-02-25T02:52:34Z"},"relationships":{"client":{"data":{"id":"arxiv.content","type":"clients"}}}},{"id":"10.48550/arxiv.2602.20538","type":"dois","attributes":{"doi":"10.48550/arxiv.2602.20538","identifiers":[{"identifier":"2602.20538","identifierType":"arXiv"}],"creators":[{"nameType":"Personal","givenName":"Subaru","familyName":"Shibai","name":"Shibai, Subaru","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Kiwamu","familyName":"Izumi","name":"Izumi, Kiwamu","affiliation":[],"nameIdentifiers":[]}],"titles":[{"title":"Range Emulator: A Compact Paraxial Optical System to Emulate Long-Distance Monochromatic Laser Propagation"}],"publisher":"arXiv","container":{},"publicationYear":2026,"subjects":[{"subject":"Optics (physics.optics)","lang":"en","subjectScheme":"arXiv"},{"subject":"Instrumentation and Methods for Astrophysics (astro-ph.IM)","lang":"en","subjectScheme":"arXiv"},{"subject":"Instrumentation and Detectors (physics.ins-det)","lang":"en","subjectScheme":"arXiv"},{"subject":"FOS: Physical sciences","subjectScheme":"Fields of Science and Technology (FOS)"},{"schemeUri":"http://www.oecd.org/science/inno/38235147.pdf","subject":"FOS: Physical sciences","subjectScheme":"Fields of Science and Technology (FOS)"}],"contributors":[],"dates":[{"date":"2026-02-24T04:36:18Z","dateType":"Submitted","dateInformation":"v1"},{"date":"2026-02-25T01:21:45Z","dateType":"Updated","dateInformation":"v1"},{"date":"2026-02","dateType":"Available","dateInformation":"v1"},{"date":"2026","dateType":"Issued"}],"language":null,"types":{"schemaOrg":"CreativeWork","resourceTypeGeneral":"Preprint","citeproc":"article","bibtex":"misc","ris":"GEN","resourceType":"Article"},"relatedIdentifiers":[],"relatedItems":[],"sizes":[],"formats":[],"version":"1","rightsList":[{"rightsIdentifierScheme":"SPDX","rightsUri":"https://creativecommons.org/licenses/by/4.0/legalcode","schemeUri":"https://spdx.org/licenses/","rights":"Creative Commons Attribution 4.0 International","rightsIdentifier":"cc-by-4.0"}],"descriptions":[{"descriptionType":"Abstract","description":"Emulating long-distance light propagation on a laboratory scale is essential for the ground-based testing of intersatellite optical systems. To address this challenge, we propose and analyze a novel optical system called the Range Emulator (RE) to reproduce the spatial propagation effects of a long-distance beam within a compact apparatus. Our analysis identifies that three lenses are required as the minimum number of lenses to implement the RE. Through a numerical exploration, we quantify the fundamental trade-off between system compactness and manufacturing precision. This work provides a practical framework for designing compact optical testbeds for future multi-satellite laser link technologies."},{"descriptionType":"Other","description":"11 pages, 4 figures"}],"geoLocations":[],"fundingReferences":[],"url":"https://arxiv.org/abs/2602.20538","contentUrl":null,"metadataVersion":0,"schemaVersion":"http://datacite.org/schema/kernel-4","source":"mds","isActive":true,"state":"findable","reason":null,"viewCount":0,"downloadCount":0,"referenceCount":0,"citationCount":0,"partCount":0,"partOfCount":0,"versionCount":0,"versionOfCount":0,"created":"2026-02-25T02:52:32Z","registered":"2026-02-25T02:52:33Z","published":null,"updated":"2026-02-25T02:52:33Z"},"relationships":{"client":{"data":{"id":"arxiv.content","type":"clients"}}}},{"id":"10.48550/arxiv.2602.20536","type":"dois","attributes":{"doi":"10.48550/arxiv.2602.20536","identifiers":[{"identifier":"2602.20536","identifierType":"arXiv"}],"creators":[{"nameType":"Personal","givenName":"Hugo","familyName":"Mathevet","name":"Mathevet, Hugo","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Sophie","familyName":"Morier-Genoud","name":"Morier-Genoud, Sophie","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Valentin","familyName":"Ovsienko","name":"Ovsienko, Valentin","affiliation":[],"nameIdentifiers":[]}],"titles":[{"title":"Quantizing Pythagorean triples"}],"publisher":"arXiv","container":{},"publicationYear":2026,"subjects":[{"subject":"Combinatorics (math.CO)","lang":"en","subjectScheme":"arXiv"},{"subject":"FOS: Mathematics","subjectScheme":"Fields of Science and Technology (FOS)"},{"schemeUri":"http://www.oecd.org/science/inno/38235147.pdf","subject":"FOS: Mathematics","subjectScheme":"Fields of Science and Technology (FOS)"}],"contributors":[],"dates":[{"date":"2026-02-24T04:30:55Z","dateType":"Submitted","dateInformation":"v1"},{"date":"2026-02-25T01:21:33Z","dateType":"Updated","dateInformation":"v1"},{"date":"2026-02","dateType":"Available","dateInformation":"v1"},{"date":"2026","dateType":"Issued"}],"language":null,"types":{"schemaOrg":"CreativeWork","resourceTypeGeneral":"Preprint","citeproc":"article","bibtex":"misc","ris":"GEN","resourceType":"Article"},"relatedIdentifiers":[],"relatedItems":[],"sizes":[],"formats":[],"version":"1","rightsList":[{"rightsUri":"http://arxiv.org/licenses/nonexclusive-distrib/1.0/","rights":"arXiv.org perpetual, non-exclusive license"}],"descriptions":[{"descriptionType":"Abstract","description":"We introduce a $q$-deformation of the Pythagoras equation $a^2 + b^2 = c^2$, which is a polynomial version of it different from the standard one. We construct a polynomial analogue, or ``$q$-analogue'', of every primitive Pythagorean triple. We also construct such analogue for a larger class of Pythagorean triples called standard. Our approach is based on the notion of $q$-deformed rational numbers and the modular group $\\mathrm{PSL}(2,\\mathbb{Z})$."},{"descriptionType":"Other","description":"11 pages"}],"geoLocations":[],"fundingReferences":[],"url":"https://arxiv.org/abs/2602.20536","contentUrl":null,"metadataVersion":0,"schemaVersion":"http://datacite.org/schema/kernel-4","source":"mds","isActive":true,"state":"findable","reason":null,"viewCount":0,"downloadCount":0,"referenceCount":0,"citationCount":0,"partCount":0,"partOfCount":0,"versionCount":0,"versionOfCount":0,"created":"2026-02-25T02:52:29Z","registered":"2026-02-25T02:52:30Z","published":null,"updated":"2026-02-25T02:52:30Z"},"relationships":{"client":{"data":{"id":"arxiv.content","type":"clients"}}}},{"id":"10.48550/arxiv.2602.20534","type":"dois","attributes":{"doi":"10.48550/arxiv.2602.20534","identifiers":[{"identifier":"2602.20534","identifierType":"arXiv"}],"creators":[{"nameType":"Personal","givenName":"Huining","familyName":"Zhang","name":"Zhang, Huining","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Dianzhen","familyName":"Cui","name":"Cui, Dianzhen","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"W.","familyName":"Wang","name":"Wang, W.","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"X. X.","familyName":"Yi","name":"Yi, X. X.","affiliation":[],"nameIdentifiers":[]}],"titles":[{"title":"Aging of coupled qubits"}],"publisher":"arXiv","container":{},"publicationYear":2026,"subjects":[{"subject":"Quantum Physics (quant-ph)","lang":"en","subjectScheme":"arXiv"},{"subject":"FOS: Physical sciences","subjectScheme":"Fields of Science and Technology (FOS)"},{"schemeUri":"http://www.oecd.org/science/inno/38235147.pdf","subject":"FOS: Physical sciences","subjectScheme":"Fields of Science and Technology (FOS)"}],"contributors":[],"dates":[{"date":"2026-02-24T04:20:52Z","dateType":"Submitted","dateInformation":"v1"},{"date":"2026-02-25T01:21:04Z","dateType":"Updated","dateInformation":"v1"},{"date":"2026-02","dateType":"Available","dateInformation":"v1"},{"date":"2026","dateType":"Issued"}],"language":null,"types":{"schemaOrg":"CreativeWork","resourceTypeGeneral":"Preprint","citeproc":"article","bibtex":"misc","ris":"GEN","resourceType":"Article"},"relatedIdentifiers":[{"relationType":"IsVersionOf","relatedIdentifier":"10.1103/physreva.110.012221","relatedIdentifierType":"DOI"}],"relatedItems":[],"sizes":[],"formats":[],"version":"1","rightsList":[{"rightsUri":"http://arxiv.org/licenses/nonexclusive-distrib/1.0/","rights":"arXiv.org perpetual, non-exclusive license"}],"descriptions":[{"descriptionType":"Abstract","description":"The aging transition refers to the shift from an oscillatory state to a globally ceased state due to some forms of deterioration in classical physics. Similar behavior has also been observed in quantum oscillators. Although it has received extensive attention in coupled oscillator systems, it has not yet been studied in coupled qubits. In this manuscript, we explore the aging transition in a network of coupled qubits. Our model describes {numerous} qubits driven by a laser, with both dissipative and coherent qubit-qubit couplings. The ratio of inactive qubits to total qubits and the population in the excited state of the qubits are employed to characterize the aging transition. We find a transition where the population in the excited states suddenly drops when the ratio exceeds a threshold. This behavior is intriguing and contrasts with coupled oscillators, where no sudden drop is observed. Additionally, we demonstrate how the couplings and driving laser influence the threshold. The underlying physics of the sudden drop is elucidated. The region where the aging transition occurs is determined based on stability analysis theory."},{"descriptionType":"Other","description":"10 pages, 8 figures"}],"geoLocations":[],"fundingReferences":[],"url":"https://arxiv.org/abs/2602.20534","contentUrl":null,"metadataVersion":0,"schemaVersion":"http://datacite.org/schema/kernel-4","source":"mds","isActive":true,"state":"findable","reason":null,"viewCount":0,"downloadCount":0,"referenceCount":0,"citationCount":0,"partCount":0,"partOfCount":0,"versionCount":0,"versionOfCount":1,"created":"2026-02-25T02:52:26Z","registered":"2026-02-25T02:52:27Z","published":null,"updated":"2026-02-25T02:52:27Z"},"relationships":{"client":{"data":{"id":"arxiv.content","type":"clients"}}}},{"id":"10.48550/arxiv.2602.20533","type":"dois","attributes":{"doi":"10.48550/arxiv.2602.20533","identifiers":[{"identifier":"2602.20533","identifierType":"arXiv"}],"creators":[{"nameType":"Personal","givenName":"Koichi","familyName":"Nagano","name":"Nagano, Koichi","affiliation":[],"nameIdentifiers":[]}],"titles":[{"title":"Asymptotic geometric regularity of CAT(0) spaces"}],"publisher":"arXiv","container":{},"publicationYear":2026,"subjects":[{"subject":"Differential Geometry (math.DG)","lang":"en","subjectScheme":"arXiv"},{"subject":"Metric Geometry (math.MG)","lang":"en","subjectScheme":"arXiv"},{"subject":"FOS: Mathematics","subjectScheme":"Fields of Science and Technology (FOS)"},{"schemeUri":"http://www.oecd.org/science/inno/38235147.pdf","subject":"FOS: Mathematics","subjectScheme":"Fields of Science and Technology (FOS)"},{"subject":"53C20, 53C23","lang":"en","subjectScheme":"MSC"}],"contributors":[],"dates":[{"date":"2026-02-24T04:20:13Z","dateType":"Submitted","dateInformation":"v1"},{"date":"2026-02-25T01:21:03Z","dateType":"Updated","dateInformation":"v1"},{"date":"2026-02","dateType":"Available","dateInformation":"v1"},{"date":"2026","dateType":"Issued"}],"language":null,"types":{"schemaOrg":"CreativeWork","resourceTypeGeneral":"Preprint","citeproc":"article","bibtex":"misc","ris":"GEN","resourceType":"Article"},"relatedIdentifiers":[],"relatedItems":[],"sizes":[],"formats":[],"version":"1","rightsList":[{"rightsIdentifierScheme":"SPDX","rightsUri":"https://creativecommons.org/licenses/by/4.0/legalcode","schemeUri":"https://spdx.org/licenses/","rights":"Creative Commons Attribution 4.0 International","rightsIdentifier":"cc-by-4.0"}],"descriptions":[{"descriptionType":"Abstract","description":"We prove that if an n-dimensional geodesically complete CAT(0) space has Tits boundary sufficiently close to the (n-1)-dimensional standard unit sphere, then it is bi-Lipschiz homeomorphic to the n-dimensional Euclidean space. As an application, we conclude that if an (n-1)-dimensional geodesically complete CAT(1) space is sufficiently close to the (n-1)-dimensional standard unit sphere, then they are bi-Lipschiz homeomorphic to each other."},{"descriptionType":"Other","description":"21 pages. arXiv admin note: substantial text overlap with arXiv:2601.22673"}],"geoLocations":[],"fundingReferences":[],"url":"https://arxiv.org/abs/2602.20533","contentUrl":null,"metadataVersion":0,"schemaVersion":"http://datacite.org/schema/kernel-4","source":"mds","isActive":true,"state":"findable","reason":null,"viewCount":0,"downloadCount":0,"referenceCount":0,"citationCount":0,"partCount":0,"partOfCount":0,"versionCount":0,"versionOfCount":0,"created":"2026-02-25T02:52:25Z","registered":"2026-02-25T02:52:25Z","published":null,"updated":"2026-02-25T02:52:25Z"},"relationships":{"client":{"data":{"id":"arxiv.content","type":"clients"}}}},{"id":"10.48550/arxiv.2602.20532","type":"dois","attributes":{"doi":"10.48550/arxiv.2602.20532","identifiers":[{"identifier":"2602.20532","identifierType":"arXiv"}],"creators":[{"nameType":"Personal","givenName":"Zhengyao","familyName":"Gu","name":"Gu, Zhengyao","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Jonathan","familyName":"Light","name":"Light, Jonathan","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Raul","familyName":"Astudillo","name":"Astudillo, Raul","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Ziyu","familyName":"Ye","name":"Ye, Ziyu","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Langzhou","familyName":"He","name":"He, Langzhou","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Henry Peng","familyName":"Zou","name":"Zou, Henry Peng","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Wei","familyName":"Cheng","name":"Cheng, Wei","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Santiago","familyName":"Paternain","name":"Paternain, Santiago","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Philip S.","familyName":"Yu","name":"Yu, Philip S.","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Yisong","familyName":"Yue","name":"Yue, Yisong","affiliation":[],"nameIdentifiers":[]}],"titles":[{"title":"Actor-Curator: Co-adaptive Curriculum Learning via Policy-Improvement Bandits for RL Post-Training"}],"publisher":"arXiv","container":{},"publicationYear":2026,"subjects":[{"subject":"Machine Learning (cs.LG)","lang":"en","subjectScheme":"arXiv"},{"subject":"Artificial Intelligence (cs.AI)","lang":"en","subjectScheme":"arXiv"},{"subject":"Computation and Language (cs.CL)","lang":"en","subjectScheme":"arXiv"},{"subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"},{"schemeUri":"http://www.oecd.org/science/inno/38235147.pdf","subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"},{"subject":"I.2.6; I.2.8; I.2.1; F.1.1","lang":"en","subjectScheme":"ACM"},{"subject":"68T05, 68T20, 90C40, 62L05","lang":"en","subjectScheme":"MSC"}],"contributors":[],"dates":[{"date":"2026-02-24T04:19:48Z","dateType":"Submitted","dateInformation":"v1"},{"date":"2026-02-25T01:20:59Z","dateType":"Updated","dateInformation":"v1"},{"date":"2026-02","dateType":"Available","dateInformation":"v1"},{"date":"2026","dateType":"Issued"}],"language":null,"types":{"schemaOrg":"CreativeWork","resourceTypeGeneral":"Preprint","citeproc":"article","bibtex":"misc","ris":"GEN","resourceType":"Article"},"relatedIdentifiers":[],"relatedItems":[],"sizes":[],"formats":[],"version":"1","rightsList":[{"rightsIdentifierScheme":"SPDX","rightsUri":"https://creativecommons.org/licenses/by/4.0/legalcode","schemeUri":"https://spdx.org/licenses/","rights":"Creative Commons Attribution 4.0 International","rightsIdentifier":"cc-by-4.0"}],"descriptions":[{"descriptionType":"Abstract","description":"Post-training large foundation models with reinforcement learning typically relies on massive and heterogeneous datasets, making effective curriculum learning both critical and challenging. In this work, we propose ACTOR-CURATOR, a scalable and fully automated curriculum learning framework for reinforcement learning post-training of large language models (LLMs). ACTOR-CURATOR learns a neural curator that dynamically selects training problems from large problem banks by directly optimizing for expected policy performance improvement. We formulate problem selection as a non-stationary stochastic bandit problem, derive a principled loss function based on online stochastic mirror descent, and establish regret guarantees under partial feedback. Empirically, ACTOR-CURATOR consistently outperforms uniform sampling and strong curriculum baselines across a wide range of challenging reasoning benchmarks, demonstrating improved training stability and efficiency. Notably, it achieves relative gains of 28.6% on AIME2024 and 30.5% on ARC-1D over the strongest baseline and up to 80% speedup. These results suggest that ACTOR-CURATOR is a powerful and practical approach for scalable LLM post-training."},{"descriptionType":"Other","description":"37 pages, 8 figures, 1 table. Preprint under review. Equal contribution by first two authors"}],"geoLocations":[],"fundingReferences":[],"url":"https://arxiv.org/abs/2602.20532","contentUrl":null,"metadataVersion":0,"schemaVersion":"http://datacite.org/schema/kernel-4","source":"mds","isActive":true,"state":"findable","reason":null,"viewCount":0,"downloadCount":0,"referenceCount":0,"citationCount":0,"partCount":0,"partOfCount":0,"versionCount":0,"versionOfCount":0,"created":"2026-02-25T02:52:23Z","registered":"2026-02-25T02:52:24Z","published":null,"updated":"2026-02-25T02:52:24Z"},"relationships":{"client":{"data":{"id":"arxiv.content","type":"clients"}}}},{"id":"10.48550/arxiv.2602.20531","type":"dois","attributes":{"doi":"10.48550/arxiv.2602.20531","identifiers":[{"identifier":"2602.20531","identifierType":"arXiv"}],"creators":[{"nameType":"Personal","givenName":"Azrin","familyName":"Sultana","name":"Sultana, Azrin","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Firoz","familyName":"Ahmed","name":"Ahmed, Firoz","affiliation":[],"nameIdentifiers":[]}],"titles":[{"title":"A Lightweight Vision-Language Fusion Framework for Predicting App Ratings from User Interfaces and Metadata"}],"publisher":"arXiv","container":{},"publicationYear":2026,"subjects":[{"subject":"Computer Vision and Pattern Recognition (cs.CV)","lang":"en","subjectScheme":"arXiv"},{"subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"},{"schemeUri":"http://www.oecd.org/science/inno/38235147.pdf","subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"}],"contributors":[],"dates":[{"date":"2026-02-24T04:17:50Z","dateType":"Submitted","dateInformation":"v1"},{"date":"2026-02-25T01:20:57Z","dateType":"Updated","dateInformation":"v1"},{"date":"2026-02","dateType":"Available","dateInformation":"v1"},{"date":"2026","dateType":"Issued"}],"language":null,"types":{"schemaOrg":"CreativeWork","resourceTypeGeneral":"Preprint","citeproc":"article","bibtex":"misc","ris":"GEN","resourceType":"Article"},"relatedIdentifiers":[],"relatedItems":[],"sizes":[],"formats":[],"version":"1","rightsList":[{"rightsIdentifierScheme":"SPDX","rightsUri":"https://creativecommons.org/licenses/by-nc-nd/4.0/legalcode","schemeUri":"https://spdx.org/licenses/","rights":"Creative Commons Attribution Non Commercial No Derivatives 4.0 International","rightsIdentifier":"cc-by-nc-nd-4.0"}],"descriptions":[{"descriptionType":"Abstract","description":"App ratings are among the most significant indicators of the quality, usability, and overall user satisfaction of mobile applications. However, existing app rating prediction models are largely limited to textual data or user interface (UI) features, overlooking the importance of jointly leveraging UI and semantic information. To address these limitations, this study proposes a lightweight vision--language framework that integrates both mobile UI and semantic information for app rating prediction. The framework combines MobileNetV3 to extract visual features from UI layouts and DistilBERT to extract textual features. These multimodal features are fused through a gated fusion module with Swish activations, followed by a multilayer perceptron (MLP) regression head. The proposed model is evaluated using mean absolute error (MAE), root mean square error (RMSE), mean squared error (MSE), coefficient of determination (R2), and Pearson correlation. After training for 20 epochs, the model achieves an MAE of 0.1060, an RMSE of 0.1433, an MSE of 0.0205, an R2 of 0.8529, and a Pearson correlation of 0.9251. Extensive ablation studies further demonstrate the effectiveness of different combinations of visual and textual encoders. Overall, the proposed lightweight framework provides valuable insights for developers and end users, supports sustainable app development, and enables efficient deployment on edge devices."},{"descriptionType":"Other","description":"24 pages, 10 figures"}],"geoLocations":[],"fundingReferences":[],"url":"https://arxiv.org/abs/2602.20531","contentUrl":null,"metadataVersion":0,"schemaVersion":"http://datacite.org/schema/kernel-4","source":"mds","isActive":true,"state":"findable","reason":null,"viewCount":0,"downloadCount":0,"referenceCount":0,"citationCount":0,"partCount":0,"partOfCount":0,"versionCount":0,"versionOfCount":0,"created":"2026-02-25T02:52:22Z","registered":"2026-02-25T02:52:23Z","published":null,"updated":"2026-02-25T02:52:23Z"},"relationships":{"client":{"data":{"id":"arxiv.content","type":"clients"}}}},{"id":"10.48550/arxiv.2602.20530","type":"dois","attributes":{"doi":"10.48550/arxiv.2602.20530","identifiers":[{"identifier":"2602.20530","identifierType":"arXiv"}],"creators":[{"nameType":"Personal","givenName":"Ming","familyName":"Li","name":"Li, Ming","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Yong-Jin","familyName":"Liu","name":"Liu, Yong-Jin","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Fang","familyName":"Liu","name":"Liu, Fang","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Huankun","familyName":"Sheng","name":"Sheng, Huankun","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Yeying","familyName":"Fan","name":"Fan, Yeying","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Yixiang","familyName":"Wei","name":"Wei, Yixiang","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Minnan","familyName":"Luo","name":"Luo, Minnan","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Weizhan","familyName":"Zhang","name":"Zhang, Weizhan","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Wenping","familyName":"Wang","name":"Wang, Wenping","affiliation":[],"nameIdentifiers":[]}],"titles":[{"title":"Memory-guided Prototypical Co-occurrence Learning for Mixed Emotion Recognition"}],"publisher":"arXiv","container":{},"publicationYear":2026,"subjects":[{"subject":"Machine Learning (cs.LG)","lang":"en","subjectScheme":"arXiv"},{"subject":"Sound (cs.SD)","lang":"en","subjectScheme":"arXiv"},{"subject":"Audio and Speech Processing (eess.AS)","lang":"en","subjectScheme":"arXiv"},{"subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"},{"schemeUri":"http://www.oecd.org/science/inno/38235147.pdf","subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"},{"subject":"FOS: Electrical engineering, electronic engineering, information engineering","subjectScheme":"Fields of Science and Technology (FOS)"},{"schemeUri":"http://www.oecd.org/science/inno/38235147.pdf","subject":"FOS: Electrical engineering, electronic engineering, information engineering","subjectScheme":"Fields of Science and Technology (FOS)"}],"contributors":[],"dates":[{"date":"2026-02-24T04:11:25Z","dateType":"Submitted","dateInformation":"v1"},{"date":"2026-02-25T01:20:45Z","dateType":"Updated","dateInformation":"v1"},{"date":"2026-02","dateType":"Available","dateInformation":"v1"},{"date":"2026","dateType":"Issued"}],"language":null,"types":{"schemaOrg":"CreativeWork","resourceTypeGeneral":"Preprint","citeproc":"article","bibtex":"misc","ris":"GEN","resourceType":"Article"},"relatedIdentifiers":[],"relatedItems":[],"sizes":[],"formats":[],"version":"1","rightsList":[{"rightsUri":"http://arxiv.org/licenses/nonexclusive-distrib/1.0/","rights":"arXiv.org perpetual, non-exclusive license"}],"descriptions":[{"descriptionType":"Abstract","description":"Emotion recognition from multi-modal physiological and behavioral signals plays a pivotal role in affective computing, yet most existing models remain constrained to the prediction of singular emotions in controlled laboratory settings. Real-world human emotional experiences, by contrast, are often characterized by the simultaneous presence of multiple affective states, spurring recent interest in mixed emotion recognition as an emotion distribution learning problem. Current approaches, however, often neglect the valence consistency and structured correlations inherent among coexisting emotions. To address this limitation, we propose a Memory-guided Prototypical Co-occurrence Learning (MPCL) framework that explicitly models emotion co-occurrence patterns. Specifically, we first fuse multi-modal signals via a multi-scale associative memory mechanism. To capture cross-modal semantic relationships, we construct emotion-specific prototype memory banks, yielding rich physiological and behavioral representations, and employ prototype relation distillation to ensure cross-modal alignment in the latent prototype space. Furthermore, inspired by human cognitive memory systems, we introduce a memory retrieval strategy to extract semantic-level co-occurrence associations across emotion categories. Through this bottom-up hierarchical abstraction process, our model learns affectively informative representations for accurate emotion distribution prediction. Comprehensive experiments on two public datasets demonstrate that MPCL consistently outperforms state-of-the-art methods in mixed emotion recognition, both quantitatively and qualitatively."}],"geoLocations":[],"fundingReferences":[],"url":"https://arxiv.org/abs/2602.20530","contentUrl":null,"metadataVersion":0,"schemaVersion":"http://datacite.org/schema/kernel-4","source":"mds","isActive":true,"state":"findable","reason":null,"viewCount":0,"downloadCount":0,"referenceCount":0,"citationCount":0,"partCount":0,"partOfCount":0,"versionCount":0,"versionOfCount":0,"created":"2026-02-25T02:52:21Z","registered":"2026-02-25T02:52:21Z","published":null,"updated":"2026-02-25T02:52:21Z"},"relationships":{"client":{"data":{"id":"arxiv.content","type":"clients"}}}},{"id":"10.48550/arxiv.2602.20529","type":"dois","attributes":{"doi":"10.48550/arxiv.2602.20529","identifiers":[{"identifier":"2602.20529","identifierType":"arXiv"}],"creators":[{"nameType":"Personal","givenName":"Junren","familyName":"Qin","name":"Qin, Junren","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Fan","familyName":"Jiang","name":"Jiang, Fan","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Tao","familyName":"Yang","name":"Yang, Tao","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Shanxiang","familyName":"Lyu","name":"Lyu, Shanxiang","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Rongke","familyName":"Liu","name":"Liu, Rongke","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Shi","familyName":"Jin","name":"Jin, Shi","affiliation":[],"nameIdentifiers":[]}],"titles":[{"title":"On the Optimal Integer-Forcing Precoding: A Geometric Perspective and a Polynomial-Time Algorithm"}],"publisher":"arXiv","container":{},"publicationYear":2026,"subjects":[{"subject":"Information Theory (cs.IT)","lang":"en","subjectScheme":"arXiv"},{"subject":"Signal Processing (eess.SP)","lang":"en","subjectScheme":"arXiv"},{"subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"},{"schemeUri":"http://www.oecd.org/science/inno/38235147.pdf","subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"},{"subject":"FOS: Electrical engineering, electronic engineering, information engineering","subjectScheme":"Fields of Science and Technology (FOS)"},{"schemeUri":"http://www.oecd.org/science/inno/38235147.pdf","subject":"FOS: Electrical engineering, electronic engineering, information engineering","subjectScheme":"Fields of Science and Technology (FOS)"}],"contributors":[],"dates":[{"date":"2026-02-24T04:10:14Z","dateType":"Submitted","dateInformation":"v1"},{"date":"2026-02-25T01:20:44Z","dateType":"Updated","dateInformation":"v1"},{"date":"2026-02","dateType":"Available","dateInformation":"v1"},{"date":"2026","dateType":"Issued"}],"language":null,"types":{"schemaOrg":"CreativeWork","resourceTypeGeneral":"Preprint","citeproc":"article","bibtex":"misc","ris":"GEN","resourceType":"Article"},"relatedIdentifiers":[],"relatedItems":[],"sizes":[],"formats":[],"version":"1","rightsList":[{"rightsIdentifierScheme":"SPDX","rightsUri":"https://creativecommons.org/licenses/by/4.0/legalcode","schemeUri":"https://spdx.org/licenses/","rights":"Creative Commons Attribution 4.0 International","rightsIdentifier":"cc-by-4.0"}],"descriptions":[{"descriptionType":"Abstract","description":"The joint optimization of the integer matrix $\\mathbf{A}$ and the power scaling matrix $\\mathbf{D}$ is central to achieving the capacity-approaching performance of Integer-Forcing (IF) precoding. This problem, however, is known to be NP-hard, presenting a fundamental computational bottleneck. In this paper, we reveal that the solution space of this problem admits a intrinsic geometric structure: it can be partitioned into a finite number of conical regions, each associated with a distinct full-rank integer matrix $\\mathbf{A}$. Leveraging this decomposition, we transform the NP-hard problem into a search over these regions and propose the Multi-Cone Nested Stochastic Pattern Search (MCN-SPS) algorithm. Our main theoretical result is that MCN-SPS finds a near-optimal solution with a computational complexity of $\\mathcal{O}\\left(K^4\\log K\\log_2(r_0)\\right)$, which is polynomial in the number of users $K$. Numerical simulations corroborate the theoretical analysis and demonstrate the algorithm's efficacy."},{"descriptionType":"Other","description":"42pages"}],"geoLocations":[],"fundingReferences":[],"url":"https://arxiv.org/abs/2602.20529","contentUrl":null,"metadataVersion":0,"schemaVersion":"http://datacite.org/schema/kernel-4","source":"mds","isActive":true,"state":"findable","reason":null,"viewCount":0,"downloadCount":0,"referenceCount":0,"citationCount":0,"partCount":0,"partOfCount":0,"versionCount":0,"versionOfCount":0,"created":"2026-02-25T02:52:19Z","registered":"2026-02-25T02:52:20Z","published":null,"updated":"2026-02-25T02:52:20Z"},"relationships":{"client":{"data":{"id":"arxiv.content","type":"clients"}}}},{"id":"10.48550/arxiv.2602.20528","type":"dois","attributes":{"doi":"10.48550/arxiv.2602.20528","identifiers":[{"identifier":"2602.20528","identifierType":"arXiv"}],"creators":[{"nameType":"Personal","givenName":"Justin","familyName":"Lovelace","name":"Lovelace, Justin","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Christian","familyName":"Belardi","name":"Belardi, Christian","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Sofian","familyName":"Zalouk","name":"Zalouk, Sofian","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Adhitya","familyName":"Polavaram","name":"Polavaram, Adhitya","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Srivatsa","familyName":"Kundurthy","name":"Kundurthy, Srivatsa","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Kilian Q.","familyName":"Weinberger","name":"Weinberger, Kilian Q.","affiliation":[],"nameIdentifiers":[]}],"titles":[{"title":"Stop-Think-AutoRegress: Language Modeling with Latent Diffusion Planning"}],"publisher":"arXiv","container":{},"publicationYear":2026,"subjects":[{"subject":"Computation and Language (cs.CL)","lang":"en","subjectScheme":"arXiv"},{"subject":"Machine Learning (cs.LG)","lang":"en","subjectScheme":"arXiv"},{"subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"},{"schemeUri":"http://www.oecd.org/science/inno/38235147.pdf","subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"}],"contributors":[],"dates":[{"date":"2026-02-24T04:09:31Z","dateType":"Submitted","dateInformation":"v1"},{"date":"2026-02-25T01:20:42Z","dateType":"Updated","dateInformation":"v1"},{"date":"2026-02","dateType":"Available","dateInformation":"v1"},{"date":"2026","dateType":"Issued"}],"language":null,"types":{"schemaOrg":"CreativeWork","resourceTypeGeneral":"Preprint","citeproc":"article","bibtex":"misc","ris":"GEN","resourceType":"Article"},"relatedIdentifiers":[],"relatedItems":[],"sizes":[],"formats":[],"version":"1","rightsList":[{"rightsIdentifierScheme":"SPDX","rightsUri":"https://creativecommons.org/licenses/by/4.0/legalcode","schemeUri":"https://spdx.org/licenses/","rights":"Creative Commons Attribution 4.0 International","rightsIdentifier":"cc-by-4.0"}],"descriptions":[{"descriptionType":"Abstract","description":"The Stop-Think-AutoRegress Language Diffusion Model (STAR-LDM) integrates latent diffusion planning with autoregressive generation. Unlike conventional autoregressive language models limited to token-by-token decisions, STAR-LDM incorporates a \"thinking\" phase that pauses generation to refine a semantic plan through diffusion before continuing. This enables global planning in continuous space prior to committing to discrete tokens. Evaluations show STAR-LDM significantly outperforms similar-sized models on language understanding benchmarks and achieves $\u0026gt;70\\%$ win rates in LLM-as-judge comparisons for narrative coherence and commonsense reasoning. The architecture also allows straightforward control through lightweight classifiers, enabling fine-grained steering of attributes without model retraining while maintaining better fluency-control trade-offs than specialized approaches."},{"descriptionType":"Other","description":"COLM 2025"}],"geoLocations":[],"fundingReferences":[],"url":"https://arxiv.org/abs/2602.20528","contentUrl":null,"metadataVersion":0,"schemaVersion":"http://datacite.org/schema/kernel-4","source":"mds","isActive":true,"state":"findable","reason":null,"viewCount":0,"downloadCount":0,"referenceCount":0,"citationCount":0,"partCount":0,"partOfCount":0,"versionCount":0,"versionOfCount":0,"created":"2026-02-25T02:52:18Z","registered":"2026-02-25T02:52:18Z","published":null,"updated":"2026-02-25T02:52:18Z"},"relationships":{"client":{"data":{"id":"arxiv.content","type":"clients"}}}},{"id":"10.48550/arxiv.2602.20527","type":"dois","attributes":{"doi":"10.48550/arxiv.2602.20527","identifiers":[{"identifier":"2602.20527","identifierType":"arXiv"}],"creators":[{"nameType":"Personal","givenName":"Md Mirajul","familyName":"Islam","name":"Islam, Md Mirajul","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Xi","familyName":"Yang","name":"Yang, Xi","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Adittya Soukarjya","familyName":"Saha","name":"Saha, Adittya Soukarjya","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Rajesh","familyName":"Debnath","name":"Debnath, Rajesh","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Min","familyName":"Chi","name":"Chi, Min","affiliation":[],"nameIdentifiers":[]}],"titles":[{"title":"A Generalized Apprenticeship Learning Framework for Capturing Evolving Student Pedagogical Strategies"}],"publisher":"arXiv","container":{},"publicationYear":2026,"subjects":[{"subject":"Machine Learning (cs.LG)","lang":"en","subjectScheme":"arXiv"},{"subject":"Artificial Intelligence (cs.AI)","lang":"en","subjectScheme":"arXiv"},{"subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"},{"schemeUri":"http://www.oecd.org/science/inno/38235147.pdf","subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"}],"contributors":[],"dates":[{"date":"2026-02-24T04:08:31Z","dateType":"Submitted","dateInformation":"v1"},{"date":"2026-02-25T01:20:36Z","dateType":"Updated","dateInformation":"v1"},{"date":"2026-02","dateType":"Available","dateInformation":"v1"},{"date":"2026","dateType":"Issued"}],"language":null,"types":{"schemaOrg":"CreativeWork","resourceTypeGeneral":"Preprint","citeproc":"article","bibtex":"misc","ris":"GEN","resourceType":"Article"},"relatedIdentifiers":[{"relationType":"IsVersionOf","relatedIdentifier":"10.1007/978-3-031-98420-4_28","relatedIdentifierType":"DOI"}],"relatedItems":[],"sizes":[],"formats":[],"version":"1","rightsList":[{"rightsIdentifierScheme":"SPDX","rightsUri":"https://creativecommons.org/licenses/by/4.0/legalcode","schemeUri":"https://spdx.org/licenses/","rights":"Creative Commons Attribution 4.0 International","rightsIdentifier":"cc-by-4.0"}],"descriptions":[{"descriptionType":"Abstract","description":"Reinforcement Learning (RL) and Deep Reinforcement Learning (DRL) have advanced rapidly in recent years and have been successfully applied to e-learning environments like intelligent tutoring systems (ITSs). Despite great success, the broader application of DRL to educational technologies has been limited due to major challenges such as sample inefficiency and difficulty designing the reward function. In contrast, Apprenticeship Learning (AL) uses a few expert demonstrations to infer the expert's underlying reward functions and derive decision-making policies that generalize and replicate optimal behavior. In this work, we leverage a generalized AL framework, THEMES, to induce effective pedagogical policies by capturing the complexities of the expert student learning process, where multiple reward functions may dynamically evolve over time. We evaluate the effectiveness of THEMES against six state-of-the-art baselines, demonstrating its superior performance and highlighting its potential as a powerful alternative for inducing effective pedagogical policies and show that it can achieve high performance, with an AUC of 0.899 and a Jaccard of 0.653, using only 18 trajectories of a previous semester to predict student pedagogical decisions in a later semester."},{"descriptionType":"Other","description":"16 pages"}],"geoLocations":[],"fundingReferences":[],"url":"https://arxiv.org/abs/2602.20527","contentUrl":null,"metadataVersion":0,"schemaVersion":"http://datacite.org/schema/kernel-4","source":"mds","isActive":true,"state":"findable","reason":null,"viewCount":0,"downloadCount":0,"referenceCount":0,"citationCount":0,"partCount":0,"partOfCount":0,"versionCount":0,"versionOfCount":1,"created":"2026-02-25T02:52:16Z","registered":"2026-02-25T02:52:17Z","published":null,"updated":"2026-02-25T02:52:17Z"},"relationships":{"client":{"data":{"id":"arxiv.content","type":"clients"}}}},{"id":"10.48550/arxiv.2602.20522","type":"dois","attributes":{"doi":"10.48550/arxiv.2602.20522","identifiers":[{"identifier":"2602.20522","identifierType":"arXiv"}],"creators":[{"nameType":"Personal","givenName":"Ashna","familyName":"Gulati","name":"Gulati, Ashna","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Tara","familyName":"Murphy","name":"Murphy, Tara","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"David L.","familyName":"Kaplan","name":"Kaplan, David L.","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Dougal","familyName":"Dobie","name":"Dobie, Dougal","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Charlotte","familyName":"Ward","name":"Ward, Charlotte","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Gemma","familyName":"Anderson","name":"Anderson, Gemma","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Manisha","familyName":"Caleb","name":"Caleb, Manisha","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Poonam","familyName":"Chandra","name":"Chandra, Poonam","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Jeff","familyName":"Cooke","name":"Cooke, Jeff","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Barnali","familyName":"Das","name":"Das, Barnali","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Adam","familyName":"Deller","name":"Deller, Adam","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Adelle","familyName":"Goodwin","name":"Goodwin, Adelle","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Kelly","familyName":"Gourdji","name":"Gourdji, Kelly","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Giancarlo","familyName":"Ghirlanda","name":"Ghirlanda, Giancarlo","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Emil","familyName":"Lenc","name":"Lenc, Emil","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Anais","familyName":"Möller","name":"Möller, Anais","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"James K.","familyName":"Leung","name":"Leung, James K.","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Stella Koch","familyName":"Ocker","name":"Ocker, Stella Koch","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Joshua","familyName":"Pritchard","name":"Pritchard, Joshua","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Claudio","familyName":"Ricci","name":"Ricci, Claudio","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Elaine M.","familyName":"Sadler","name":"Sadler, Elaine M.","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Om Sharan","familyName":"Salafia","name":"Salafia, Om Sharan","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Kavya","familyName":"Shaji","name":"Shaji, Kavya","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Roberto","familyName":"Soria","name":"Soria, Roberto","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Mark","familyName":"Suhr","name":"Suhr, Mark","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Artem","familyName":"Tuntsov","name":"Tuntsov, Artem","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Ziteng","familyName":"Wang","name":"Wang, Ziteng","affiliation":[],"nameIdentifiers":[]}],"titles":[{"title":"ASKAP J005512.2-255834: A Luminous, Long-Lived Radio Transient at z = 0.1 -- an Orphan Afterglow or an off-nuclear TDE from an IMBH?"}],"publisher":"arXiv","container":{},"publicationYear":2026,"subjects":[{"subject":"High Energy Astrophysical Phenomena (astro-ph.HE)","lang":"en","subjectScheme":"arXiv"},{"subject":"FOS: Physical sciences","subjectScheme":"Fields of Science and Technology (FOS)"},{"schemeUri":"http://www.oecd.org/science/inno/38235147.pdf","subject":"FOS: Physical sciences","subjectScheme":"Fields of Science and Technology (FOS)"}],"contributors":[],"dates":[{"date":"2026-02-24T03:52:13Z","dateType":"Submitted","dateInformation":"v1"},{"date":"2026-02-25T01:19:50Z","dateType":"Updated","dateInformation":"v1"},{"date":"2026-02","dateType":"Available","dateInformation":"v1"},{"date":"2026","dateType":"Issued"}],"language":null,"types":{"schemaOrg":"CreativeWork","resourceTypeGeneral":"Preprint","citeproc":"article","bibtex":"misc","ris":"GEN","resourceType":"Article"},"relatedIdentifiers":[{"relationType":"IsVersionOf","relatedIdentifier":"10.3847/1538-4357/ae4351","relatedIdentifierType":"DOI"}],"relatedItems":[],"sizes":[],"formats":[],"version":"1","rightsList":[{"rightsIdentifierScheme":"SPDX","rightsUri":"https://creativecommons.org/licenses/by/4.0/legalcode","schemeUri":"https://spdx.org/licenses/","rights":"Creative Commons Attribution 4.0 International","rightsIdentifier":"cc-by-4.0"}],"descriptions":[{"descriptionType":"Abstract","description":"We report the discovery of a slowly evolving, extragalactic radio transient, ASKAP J005512.2--255834 (hereafter ASKAP J0055-2558), identified using the Australian SKA Pathfinder in a search for orphan afterglows associated with archival gravitational wave events. Although discovered in this context, there is no evidence that the transient is associated with any known gravitational wave event. Nonetheless, this source exhibits a 20-fold increase in flux density over $\u0026lt;250$ days, and it remains in a declining, detectable state more than 1000 days after the initial detection. Follow-up observations from 0.3 to 9 GHz reveal an evolving spectrum consistent with synchrotron emission. ASKAP J0055-2558 is spatially coincident with a low-mass, star-forming galaxy at redshift $z = 0.116$ ($d_{\\rm L}$= 543 Mpc), placing its peak radio luminosity at $νL_ν\\sim 10^{39}\\,\\rm erg\\,s^{-1}$. Analysis of its radio light curve, inferred blastwave velocity, energetics, host galaxy properties and the absence of counterparts at other wavelengths suggest that ASKAP J0055-2558 is most consistent with either the late-time phase of an orphan long gamma-ray burst afterglow or a tidal disruption event involving an intermediate-mass black hole spatially offset from the galaxy nucleus. The radio discovery of either of these phenomena is extremely rare, with only a few or no confirmed examples to date."},{"descriptionType":"Other","description":"This paper has been accepeted for publication in ApJ"}],"geoLocations":[],"fundingReferences":[],"url":"https://arxiv.org/abs/2602.20522","contentUrl":null,"metadataVersion":0,"schemaVersion":"http://datacite.org/schema/kernel-4","source":"mds","isActive":true,"state":"findable","reason":null,"viewCount":0,"downloadCount":0,"referenceCount":0,"citationCount":0,"partCount":0,"partOfCount":0,"versionCount":0,"versionOfCount":1,"created":"2026-02-25T02:52:07Z","registered":"2026-02-25T02:52:08Z","published":null,"updated":"2026-02-25T02:52:08Z"},"relationships":{"client":{"data":{"id":"arxiv.content","type":"clients"}}}},{"id":"10.48550/arxiv.2602.20521","type":"dois","attributes":{"doi":"10.48550/arxiv.2602.20521","identifiers":[{"identifier":"2602.20521","identifierType":"arXiv"}],"creators":[{"nameType":"Personal","givenName":"Wei","familyName":"Xuan","name":"Xuan, Wei","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Zihao","familyName":"Xuan","name":"Xuan, Zihao","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Rongliang","familyName":"Fu","name":"Fu, Rongliang","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Ning","familyName":"Lin","name":"Lin, Ning","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Kwunhang","familyName":"Wong","name":"Wong, Kwunhang","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Zikang","familyName":"Yuan","name":"Yuan, Zikang","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Lang","familyName":"Feng","name":"Feng, Lang","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Zhongrui","familyName":"Wang","name":"Wang, Zhongrui","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Tsung-Yi","familyName":"Ho","name":"Ho, Tsung-Yi","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Yuzhong","familyName":"Jiao","name":"Jiao, Yuzhong","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Luhong","familyName":"Liang","name":"Liang, Luhong","affiliation":[],"nameIdentifiers":[]}],"titles":[{"title":"Towards Secure and Efficient DNN Accelerators via Hardware-Software Co-Design"}],"publisher":"arXiv","container":{},"publicationYear":2026,"subjects":[{"subject":"Cryptography and Security (cs.CR)","lang":"en","subjectScheme":"arXiv"},{"subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"},{"schemeUri":"http://www.oecd.org/science/inno/38235147.pdf","subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"}],"contributors":[],"dates":[{"date":"2026-02-24T03:49:12Z","dateType":"Submitted","dateInformation":"v1"},{"date":"2026-02-25T01:19:41Z","dateType":"Updated","dateInformation":"v1"},{"date":"2026-02","dateType":"Available","dateInformation":"v1"},{"date":"2026","dateType":"Issued"}],"language":null,"types":{"schemaOrg":"CreativeWork","resourceTypeGeneral":"Preprint","citeproc":"article","bibtex":"misc","ris":"GEN","resourceType":"Article"},"relatedIdentifiers":[],"relatedItems":[],"sizes":[],"formats":[],"version":"1","rightsList":[{"rightsUri":"http://arxiv.org/licenses/nonexclusive-distrib/1.0/","rights":"arXiv.org perpetual, non-exclusive license"}],"descriptions":[{"descriptionType":"Abstract","description":"The rapid deployment of deep neural network (DNN) accelerators in safety-critical domains such as autonomous vehicles, healthcare systems, and financial infrastructure necessitates robust mechanisms to safeguard data confidentiality and computational integrity. Existing security solutions for DNN accelerators, however, suffer from excessive hardware resource demands and frequent off-chip memory access overheads, which degrade performance and scalability.\n To address these challenges, this paper presents a secure and efficient memory protection framework for DNN accelerators with minimal overhead. First, we propose a bandwidth-aware cryptographic scheme that adapts encryption granularity based on memory traffic patterns, striking a balance between security and resource efficiency. Second, we observe that both the overlapping regions in the intra-layer tiling's sliding window pattern and those resulting from inter-layer tiling strategy discrepancies introduce substantial redundant memory accesses and repeated computational overhead in cryptography. Third, we introduce a multi-level authentication mechanism that effectively eliminates unnecessary off-chip memory accesses, enhancing performance and energy efficiency. Experimental results show that this work decreases performance overhead by over 12% and achieves 87% energy efficiency improvement for both server and edge neural processing units (NPUs), while ensuring robust scalability."}],"geoLocations":[],"fundingReferences":[],"url":"https://arxiv.org/abs/2602.20521","contentUrl":null,"metadataVersion":0,"schemaVersion":"http://datacite.org/schema/kernel-4","source":"mds","isActive":true,"state":"findable","reason":null,"viewCount":0,"downloadCount":0,"referenceCount":0,"citationCount":0,"partCount":0,"partOfCount":0,"versionCount":0,"versionOfCount":0,"created":"2026-02-25T02:52:06Z","registered":"2026-02-25T02:52:06Z","published":null,"updated":"2026-02-25T02:52:06Z"},"relationships":{"client":{"data":{"id":"arxiv.content","type":"clients"}}}},{"id":"10.48550/arxiv.2602.20520","type":"dois","attributes":{"doi":"10.48550/arxiv.2602.20520","identifiers":[{"identifier":"2602.20520","identifierType":"arXiv"}],"creators":[{"nameType":"Personal","givenName":"Pratham","familyName":"Yashwante","name":"Yashwante, Pratham","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Davit","familyName":"Abrahamyan","name":"Abrahamyan, Davit","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Shresth","familyName":"Grover","name":"Grover, Shresth","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Sukruth","familyName":"Rao","name":"Rao, Sukruth","affiliation":[],"nameIdentifiers":[]}],"titles":[{"title":"How Do Inpainting Artifacts Propagate to Language?"}],"publisher":"arXiv","container":{},"publicationYear":2026,"subjects":[{"subject":"Computer Vision and Pattern Recognition (cs.CV)","lang":"en","subjectScheme":"arXiv"},{"subject":"Artificial Intelligence (cs.AI)","lang":"en","subjectScheme":"arXiv"},{"subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"},{"schemeUri":"http://www.oecd.org/science/inno/38235147.pdf","subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"}],"contributors":[],"dates":[{"date":"2026-02-24T03:46:33Z","dateType":"Submitted","dateInformation":"v1"},{"date":"2026-02-25T01:19:38Z","dateType":"Updated","dateInformation":"v1"},{"date":"2026-02","dateType":"Available","dateInformation":"v1"},{"date":"2026","dateType":"Issued"}],"language":null,"types":{"schemaOrg":"CreativeWork","resourceTypeGeneral":"Preprint","citeproc":"article","bibtex":"misc","ris":"GEN","resourceType":"Article"},"relatedIdentifiers":[],"relatedItems":[],"sizes":[],"formats":[],"version":"1","rightsList":[{"rightsIdentifierScheme":"SPDX","rightsUri":"https://creativecommons.org/licenses/by/4.0/legalcode","schemeUri":"https://spdx.org/licenses/","rights":"Creative Commons Attribution 4.0 International","rightsIdentifier":"cc-by-4.0"}],"descriptions":[{"descriptionType":"Abstract","description":"We study how visual artifacts introduced by diffusion-based inpainting affect language generation in vision-language models. We use a two-stage diagnostic setup in which masked image regions are reconstructed and then provided to captioning models, enabling controlled comparisons between captions generated from original and reconstructed inputs. Across multiple datasets, we analyze the relationship between reconstruction fidelity and downstream caption quality. We observe consistent associations between pixel-level and perceptual reconstruction metrics and both lexical and semantic captioning performance. Additional analysis of intermediate visual representations and attention patterns shows that inpainting artifacts lead to systematic, layer-dependent changes in model behavior. Together, these results provide a practical diagnostic framework for examining how visual reconstruction quality influences language generation in multimodal systems."}],"geoLocations":[],"fundingReferences":[],"url":"https://arxiv.org/abs/2602.20520","contentUrl":null,"metadataVersion":0,"schemaVersion":"http://datacite.org/schema/kernel-4","source":"mds","isActive":true,"state":"findable","reason":null,"viewCount":0,"downloadCount":0,"referenceCount":0,"citationCount":0,"partCount":0,"partOfCount":0,"versionCount":0,"versionOfCount":0,"created":"2026-02-25T02:52:04Z","registered":"2026-02-25T02:52:05Z","published":null,"updated":"2026-02-25T02:52:05Z"},"relationships":{"client":{"data":{"id":"arxiv.content","type":"clients"}}}},{"id":"10.48550/arxiv.2602.20519","type":"dois","attributes":{"doi":"10.48550/arxiv.2602.20519","identifiers":[{"identifier":"2602.20519","identifierType":"arXiv"}],"creators":[{"nameType":"Personal","givenName":"F.","familyName":"Alemanno","name":"Alemanno, F.","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName