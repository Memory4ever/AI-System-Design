venName":"Edo","familyName":"Ibar","name":"Ibar, Edo","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Rodrigo","familyName":"Herrera-Camus","name":"Herrera-Camus, Rodrigo","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Ali","familyName":"Hadi","name":"Hadi, Ali","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Nicol","familyName":"Gutierrez-Vera","name":"Gutierrez-Vera, Nicol","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Michele","familyName":"Ginolfi","name":"Ginolfi, Michele","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Seiji","familyName":"Fujimoto","name":"Fujimoto, Seiji","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Miroslava","familyName":"Dessauges-Zavadsky","name":"Dessauges-Zavadsky, Miroslava","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Ilse","familyName":"De Looze","name":"De Looze, Ilse","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Poulomi","familyName":"Dam","name":"Dam, Poulomi","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Elisabete","familyName":"da Cunha","name":"da Cunha, Elisabete","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Mederic","familyName":"Boquien","name":"Boquien, Mederic","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Roberto J.","familyName":"Assef","name":"Assef, Roberto J.","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Manuel","familyName":"Aravena","name":"Aravena, Manuel","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"David B.","familyName":"Sanders","name":"Sanders, David B.","affiliation":[],"nameIdentifiers":[]}],"titles":[{"title":"The ALPINE-CRISTAL-JWST Survey: Chemical Abundance Comparison Between the ISM and CGM of Main-Sequence Galaxies at z=4-6"}],"publisher":"arXiv","container":{},"publicationYear":2026,"subjects":[{"subject":"Astrophysics of Galaxies (astro-ph.GA)","lang":"en","subjectScheme":"arXiv"},{"subject":"FOS: Physical sciences","subjectScheme":"Fields of Science and Technology (FOS)"},{"schemeUri":"http://www.oecd.org/science/inno/38235147.pdf","subject":"FOS: Physical sciences","subjectScheme":"Fields of Science and Technology (FOS)"}],"contributors":[],"dates":[{"date":"2026-02-23T19:00:01Z","dateType":"Submitted","dateInformation":"v1"},{"date":"2026-02-25T01:01:56Z","dateType":"Updated","dateInformation":"v1"},{"date":"2026-02","dateType":"Available","dateInformation":"v1"},{"date":"2026","dateType":"Issued"}],"language":null,"types":{"schemaOrg":"CreativeWork","resourceTypeGeneral":"Preprint","citeproc":"article","bibtex":"misc","ris":"GEN","resourceType":"Article"},"relatedIdentifiers":[],"relatedItems":[],"sizes":[],"formats":[],"version":"1","rightsList":[{"rightsIdentifierScheme":"SPDX","rightsUri":"https://creativecommons.org/licenses/by/4.0/legalcode","schemeUri":"https://spdx.org/licenses/","rights":"Creative Commons Attribution 4.0 International","rightsIdentifier":"cc-by-4.0"}],"descriptions":[{"descriptionType":"Abstract","description":"Gaseous halos around galaxies play an important role in galaxy evolution. The exchange of metals from the interstellar medium (ISM) to the circumgalactic medium (CGM) are caused by the formation, feedback, and/or merging history of galaxies. We study the variation in chemical composition between the ISM ($\\lesssim3\\,$kpc) and CGM ($\\sim5-10\\,$kpc) for a sample of $M_{\\star}\u0026gt;10^{9.5}\\,M_{\\odot}$ main-sequence galaxies at $4"},{"descriptionType":"Other","description":"Accepted for publication by ApJ. Main text 15 pages, 6 figures"}],"geoLocations":[],"fundingReferences":[],"url":"https://arxiv.org/abs/2602.20241","contentUrl":null,"metadataVersion":0,"schemaVersion":"http://datacite.org/schema/kernel-4","source":"mds","isActive":true,"state":"