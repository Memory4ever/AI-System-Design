x(1 0 0 -1 0 6.73)" width="191.44"><span class="ltx_foreignobject_container"><span class="ltx_foreignobject_content"><span id="S1.F2.pic1.9" class="ltx_text ltx_font_bold" style="font-size:70%;--ltx-fg-color:#B35900;">SSHFS  <math id="S1.F2.pic1.m1" class="ltx_Math" alttext="|" display="inline" intent=":literal"><semantics><mo style="--ltx-fg-color:#B35900;" fence="false" mathcolor="#B35900" stretchy="false">|</mo><annotation encoding="application/x-tex">|</annotation></semantics></math>  Archive  <math id="S1.F2.pic1.m2" class="ltx_Math" alttext="|" display="inline" intent=":literal"><semantics><mo style="--ltx-fg-color:#B35900;" fence="false" mathcolor="#B35900" stretchy="false">|</mo><annotation encoding="application/x-tex">|</annotation></semantics></math>  Storage  <math id="S1.F2.pic1.m3" class="ltx_Math" alttext="|" display="inline" intent=":literal"><semantics><mo style="--ltx-fg-color:#B35900;" fence="false" mathcolor="#B35900" stretchy="false">|</mo><annotation encoding="application/x-tex">|</annotation></semantics></math>  Git</span></span></span></foreignObject></g><g style="--ltx-stroke-color:#999999;--ltx-fill-color:#999999;" fill="#999999" stroke="#999999" transform="matrix(1.0 0.0 0.0 1.0 294.76 -110.69)"><foreignObject style="--ltx-fg-color:#999999;--ltx-fo-width:9.51em;--ltx-fo-height:0.61em;--ltx-fo-depth:0.17em;font-size:7.97pt;" color="#999999" height="8.61" overflow="visible" transform="matrix(1 0 0 -1 0 6.73)" width="104.89"><span class="ltx_foreignobject_container"><span class="ltx_foreignobject_content"><span id="S1.F2.pic1.10" class="ltx_text" style="font-size:70%;">Workspace Transport</span></span></span></foreignObject></g><g style="--ltx-stroke-color:#FFB973;--ltx-fill-color:#FFB973;--ltx-fg-color:#FFB973;" color="#FFB973" fill="#FFB973" stroke="#FFB973" stroke-width="1.0pt"><path style="fill:none" d="M 244.09 -34.02 L 244.09 -49.21"></path></g><g style="--ltx-stroke-color:#FFB973;--ltx-fill-color:#FFB973;--ltx-fg-color:#FFB973;" color="