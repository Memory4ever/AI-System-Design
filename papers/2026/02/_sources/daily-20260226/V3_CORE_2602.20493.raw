ible" transform="matrix(1 0 0 -1 0 4.17)" width="44.75"><span class="ltx_foreignobject_container"><span class="ltx_foreignobject_content"><span id="S3.F5.pic1.30" class="ltx_text ltx_font_italic" style="font-size:70%;">any non-</span></span></span></foreignObject></g></g><g class="ltx_tikzmatrix_row" transform="matrix(1 0 0 1 0 12.78)"><g class="ltx_tikzmatrix_col ltx_nopad_r" transform="matrix(1 0 0 -1 2.7 0)"><foreignObject style="--ltx-fo-width:3.6em;--ltx-fo-height:0.58em;--ltx-fo-depth:0em;font-size:8.44pt;" height="6.73" overflow="visible" transform="matrix(1 0 0 -1 0 6.73)" width="42.05"><span class="ltx_foreignobject_container"><span class="ltx_foreignobject_content"><span id="S3.F5.pic1.31" class="ltx_text ltx_font_italic" style="font-size:70%;">terminal</span></span></span></foreignObject></g></g></g></g><g style="--ltx-stroke-color:#999999;--ltx-fill-color:#999999;" fill="#999999" stroke="#999999" transform="matrix(1.0 0.0 0.0 1.0 288.66 -344.83)"><foreignObject style="--ltx-fg-color:#999999;--ltx-fo-width:8.68em;--ltx-fo-height:0.75em;--ltx-fo-depth:0.25em;font-size:7pt;" color="#999999" height="9.69" overflow="visible" transform="matrix(1 0 0 -1 0 7.26)" width="84.09"><span class="ltx_foreignobject_container"><span class="ltx_foreignobject_content"><span id="S3.F5.pic1.32" class="ltx_text" style="font-size:70%;">via </span><span id="S3.F5.pic1.33" class="ltx_text ltx_font_smallcaps" style="font-size:70%;">error</span><span id="S3.F5.pic1.34" class="ltx_text" style="font-size:70%;"> / </span><span id="S3.F5.pic1.35" class="ltx_text ltx_font_smallcaps" style="font-size:70%;">cancel</span></span></span></foreignObject></g><g style="--ltx-stroke-color:#666666;--ltx-fill-color:#666666;" fill="#666666" stroke="#666666" transform="matrix(1.0 0.0 0.0 1.0 198.02 44.13)"><foreignObject style="--ltx-fo-width:11.12em;--ltx-fo-height:0.59em;--ltx-fo-depth:0.16em;font-size:10.65pt;" height="11.07" overflow="visible" transform="matrix(1 0 0 -1 0 8.65)" width="163.84"><span class="ltx_foreignobject_container"><span class="ltx_foreignobject_content"><span id="S3.F5.pic1.36" class="ltx_text ltx_font_bold" style="font-size:90%;--ltx-fg-color:#666666;">AssignmentStateMachine</span></span></span></foreignObject></g><g style="--ltx-stroke-color:#999999;--ltx-fill-color:#999999;" fill="#999999" stroke="#999999" transform="matrix(1.0 0.0 0.0 1.0 242.38 29.07)"><foreignObject style="--ltx-fo-width:6.73em;--ltx-fo-height:0.66em;--ltx-fo-depth:0.22em;font-size:7.97pt;" height="9.69" overflow="visible" transform="matrix(1 0 0 -1 0 7.26)" width="74.29"><span class="ltx_foreignobject_container"><span class="ltx_foreignobject_content"><span id="S3.F5.pic1.37" class="ltx_text" style="font-size:70%;--ltx-fg-color:#999999;">(Executor side)</span></span></span></foreignObject></g></g><g style="--ltx-fg-color:#7373FF;" color="#7373FF" stroke-dasharray="3.0pt,2.0pt" stroke-dashoffset="0.0pt" stroke-width="0.8pt"><g style="--ltx-stroke-color:#7373FF;--ltx-fill-color:#7373FF;" fill="#7373FF" stroke="#7373FF"><path style="fill:none" d="M 35.99 -61.02 M 41.89 -61.02 L 196.52 -61.02"></path></g><g style="--ltx-stroke-color:#7373FF;--ltx-fill-color:#7373FF;" fill="#7373FF" stroke="#7373FF" stroke-dasharray="none" stroke-dashoffset="0.0pt" stroke-linejoin="miter" transform="matrix(1.0 0.0 0.0 1.0 193.54 -61.02)"><path d="M 7.31 0 L 1.69 2.27 L 3.25 0 L 1.69 -2.27 Z"></path></g><g style="--ltx-fill-color:#FFFFFF;--ltx-fg-color:#000000;" color="#000000" fill="#FFFFFF"><path style="stroke:none" d="M 104.72 -60.47 h 34.66 v 10.07 h -34.66 Z"></path></g><g style="--ltx-stroke-color:#6666FF;--ltx-fill-color:#6666FF;--ltx-fg-color:#000000;" color="#000000" fill="#6666FF" stroke="#6666FF" transform="matrix(1.0 0.0 0.0 1.0 106.79 -58.39)"><foreignObject style="--ltx-fo-width:3em;--ltx-fo-height:0.58em;--ltx-fo-depth:0em;font-size:7.35pt;" height="5.92" overflow="visible" transform="matrix(1 0 0 -1 0 5.92)" width="30.51"><span class="ltx_foreignobject_container"><span class="ltx_foreignobject_content"><span id="S3.F5.pic1.38" class="ltx_text ltx_font_typewriter" style="font-size:70%;--ltx-fg-color:#6666FF;">ACCEPT</span></span></span></foreignObject></g></g><g style="--ltx-fg-color:#7373FF;" color="#7373FF" stroke-dasharray="3.0pt,2.0pt" stroke-dashoffset="0.0pt" stroke-width="0.8pt"><g style="--ltx-stroke-color:#7373FF;--ltx-fill-color:#7373FF;" fill="#7373FF" stroke="#7373FF"><path style="fill:none" d="M 35.99 -122.05 M 41.89 -122.05 L 65.51 -122.05 L 65.51 -183.07 L 196.52 -183.07"></path></g><g style="--ltx-stroke-color:#7373FF;--ltx-fill-color:#7373FF;" fill="#7373FF" stroke="#7373FF" stroke-dasharray="none" stroke-dashoffset="0.0pt" stroke-linejoin="miter" transform="matrix(1.0 0.0 0.0 1.0 193.54 -183.07)"><path d="M 7.31 0 L 1.69 2.27 L 3.25 0 L 1.69 -2.27 Z"></path></g><g style="--ltx-fill-color:#FFFFFF;--ltx-fg-color:#000000;" color="#000000" fill="#FFFFFF"><path style="stroke:none" d="M 119.07 -182.52 h 29.58 v 10.07 h -29.58 Z"></path></g><g style="--ltx-stroke-color:#6666FF;--ltx-fill-color:#6666FF;--ltx-fg-color:#000000;" color="#000000" fill="#6666FF" stroke="#6666FF" transform="matrix(1.0 0.0 0.0 1.0 121.15 -180.44)"><foreignObject style="--ltx-fo-width:2.5em;--ltx-fo-height:0.58em;--ltx-fo-depth:0em;font-size:7.35pt;" height="5.92" overflow="visible" transform="matrix(1 0 0 -1 0 5.92)" width="25.43"><span class="ltx_foreignobject_container"><span class="ltx_foreignobject_content"><span id="S3.F5.pic1.39" class="ltx_text ltx_font_typewriter" style="font-size:70%;--ltx-fg-color:#6666FF;">START</span></span></span></foreignObject></g></g><g style="--ltx-fg-color:#7373FF;" color="#7373FF" stroke-dasharray="3.0pt,2.0pt" stroke-dashoffset="0.0pt" stroke-width="0.8pt"><g style="--ltx-stroke-color:#7373FF;--ltx-fill-color:#7373FF;" fill="#7373FF" stroke="#7373FF"><path style="fill:none" d="M 35.99 -244.09 M 47.58 -244.09 L 65.51 -244.09 L 65.51 -305.12 L 202.2 -305.12"></path></g><g style="--ltx-stroke-color:#7373FF;--ltx-fill-color:#7373FF;" fill="#7373FF" stroke="#7373FF" stroke-dasharray="none" stroke-dashoffset="0.0pt" stroke-linejoin="miter" transform="matrix(-1.0 0.0 0.0 -1.0 50.55 -244.09)"><path d="M 7.31 0 L 1.69 2.27 L 3.25 0 L 1.69 -2.27 Z"></path></g><g style="--ltx-fill-color:#FFFFFF;--ltx-fg-color:#000000;" color="#000000" fill="#FFFFFF"><path style="stroke:none" d="M 121.61 -304.56 h 24.49 v 10.07 h -24.49 Z"></path></g><g style="--ltx-stroke-color:#6666FF;--ltx-fill-color:#6666FF;--ltx-fg-color:#000000;" color="#000000" fill="#6666FF" stroke="#6666FF" transform="matrix(1.0 0.0 0.0 1.0 123.69 -302.49)"><foreignObject style="--ltx-fo-width:2em;--ltx-fo-height:0.58em;--ltx-fo-depth:0em;font-size:7.35pt;" height="5.92" overflow="visible" transform="matrix(1 0 0 -1 0 5.92)" width="20.34"><span class="ltx_foreignobject_container"><span class="ltx_foreignobject_content"><span id="S3.F5.pic1.40" class="ltx_text ltx_font_typewriter" style="font-size:70%;--ltx-fg-color:#6666FF;">DONE</span></span></span></foreignObject></g></g></g></svg></span>
</span></div>
<figcaption class="ltx_caption ltx_centering"><span class="ltx_tag ltx_tag_figure">Figure 5: </span>Dual state machines governing the AWCP delegation lifecycle. The <span id="S3.F5.5" class="ltx_text ltx_font_italic">DelegationStateMachine</span> (left) tracks nine states on the Delegator side; the <span id="S3.F5.6" class="ltx_text ltx_font_italic">AssignmentStateMachine</span> (right) tracks four states on the Executor side. Solid arrows trace the happy path; a single dashed red path indicates that any non-terminal state may transition to a terminal state upon error, cancellation, or lease expiration. Blue dashed arrows mark cross-machine synchronization via protocol messages.</figcaption>
</figure>
<div id="S3.SS2.SSS0.Px1.p5" class="ltx_para ltx_noindent">
<p id="S3.SS2.SSS0.Px1.p5.1" class="ltx_p">Three protocol messages serve as synchronization points between the two machines.
When the Executor sends <span id="S3.SS2.SSS0.Px1.p5.1.1" class="ltx_text ltx_font_typewriter">ACCEPT</span>, the Delegator transitions from <span id="S3.SS2.SSS0.Px1.p5.1.2" class="ltx_text ltx_font_typewriter">invited</span> to <span id="S3.SS2.SSS0.Px1.p5.1.3" class="ltx_text ltx_font_typewriter">accepted</span> while the Executor creates a new assignment in the <span id="S3.SS2.SSS0.Px1.p5.1.4" class="ltx_text ltx_font_typewriter">pending</span> state.
When the Delegator sends <span id="S3.SS2.SSS0.Px1.p5.1.5" class="ltx_text ltx_font_typewriter">START</span>, it transitions to <span id="S3.SS2.SSS0.Px1.p5.1.6" class="ltx_text ltx_font_typewriter">started</span> and the Executor advances from <span id="S3.SS2.SSS0.Px1.p5.1.7" class="ltx_text ltx_font_typewriter">pending</span> to <span id="S3.SS2.SSS0.Px1.p5.1.8" class="ltx_text ltx_font_typewriter">active</span>.
When the Executor emits <span id="S3.SS2.SSS0.Px1.p5.1.9" class="ltx_text ltx_font_typewriter">DONE</span>, it reaches <span id="S3.SS2.SSS0.Px1.p5.1.10" class="ltx_text ltx_font_typewriter">completed</span> and the Delegator transitions from <span id="S3.SS2.SSS0.Px1.p5.1.11" class="ltx_text ltx_font_typewriter">running</span> to <span id="S3.SS2.SSS0.Px1.p5.1.12" class="ltx_text ltx_font_typewriter">completed</span>.
This synchronization design ensures that both parties maintain consistent views of the delegation progress without requiring a shared state store.</p>
</div>
</section>
<section id="S3.SS2.SSS0.Px2" class="ltx_paragraph">
<h4 class="ltx_title ltx_title_paragraph">Four-phase protocol flow.</h4>

<div id="S3.SS2.SSS0.Px2.p1" class="ltx_para ltx_noindent">
<p id="S3.SS2.SSS0.Px2.p1.1" class="ltx_p">The lifecycle unfolds across four sequential phases.</p>
</div>
<div id="S3.SS2.SSS0.Px2.p2" class="ltx_para ltx_noindent">
<p id="S3.SS2.SSS0.Px2.p2.1" class="ltx_p">During <span id="S3.SS2.SSS0.Px2.p2.1.1" class="ltx_text ltx_font_italic">Negotiation</span>, the Delegator proposes a task via an <span id="S3.SS2.SSS0.Px2.p2.1.2" class="ltx_text ltx_font_typewriter">INVITE</span> message.
The Executor evaluates the proposal against local policies and responds with <span id="S3.SS2.SSS0.Px2.p2.1.3" class="ltx_text ltx_font_typewriter">ACCEPT</span>, optionally narrowing the terms (e.g., capping the lease duration), or <span id="S3.SS2.SSS0.Px2.p2.1.4" class="ltx_text ltx_font_typewriter">ERROR</span> to decline.</p>
</div>
<div id="S3.SS2.SSS0.Px2.p3" class="ltx_para ltx_noindent">
<p id="S3.SS2.SSS0.Px2.p3.1" class="ltx_p"><span id="S3.SS2.SSS0.Px2.p3.1.1" class="ltx_text ltx_font_italic">Provisioning</span> activates the data plane.
The Delegator packages transport-specific credentials into a <span id="S3.SS2.SSS0.Px2.p3.1.2" class="ltx_text ltx_font_typewriter">START</span> message, and the Executor provisions workspace access upon receipt.</p>
</div>
<div id="S3.SS2.SSS0.Px2.p4" class="ltx_para ltx_noindent">
<p id="S3.SS2.SSS0.Px2.p4.1" class="ltx_p"><span id="S3.SS2.SSS0.Px2.p4.1.1" class="ltx_text ltx_font_italic">Execution</span> is the functional core of the protocol.
The Executor operates on the delegated workspace using its native toolchains, streaming progress and intermediate results back to the Delegator via SSE.
Upon completion, the Executor tears down transport resources and signals <span id="S3.SS2.SSS0.Px2.p4.1.2" class="ltx_text ltx_font_typewriter">DONE</span>.</p>
</div>
<div id="S3.SS2.SSS0.Px2.p5" class="ltx_para ltx_noindent">
<p id="S3.SS2.SSS0.Px2.p5.1" class="ltx_p">Finally, <span id="S3.SS2.SSS0.Px2.p5.1.1" class="ltx_text ltx_font_italic">Completion</span> reconciles results: the Delegator processes any received snapshots, acknowledges receipt, and both parties perform a two-phase cleanup, which involves gracefully disconnecting transport resources, followed by reclaiming temporary files.
Section <a href="#S4" title="4 Protocol Specification and Implementation ‣ AWCP: A Workspace Delegation Protocol for Deep-Engagement Collaboration across Remote Agents" class="ltx_ref"><span class="ltx_text ltx_ref_tag">4</span></a> specifies the message payloads, transport mechanisms, and reconciliation policies that realize each phase.</p>
</div>
</section>
</section>
</section>
<section id="S4" class="ltx_section">
<h2 class="ltx_title ltx_title_section"><span class="ltx_tag ltx_tag_section">4 </span>Protocol Specification and Implementation</h2>

<div id="S4.p1" class="ltx_para ltx_noindent">
<p id="S4.p1.1" class="ltx_p">This section specifies the concrete protocol artifacts that realize the AWCP framework: the message semantics governing the control plane (§<a href="#S4.SS1" title="4.1 Message Protocol ‣ 4 Protocol Specification and Implementation ‣ AWCP: A Workspace Delegation Protocol for Deep-Engagement Collaboration across Remote Agents" class="ltx_ref"><span class="ltx_text ltx_ref_tag">4.1</span></a>), the transport adapters provisioning the data plane (§<a href="#S4.SS2" title="4.2 Transport Adapters ‣ 4 Protocol Specification and Implementation ‣ AWCP: A Workspace Delegation Protocol for Deep-Engagement Collaboration across Remote Agents" class="ltx_ref"><span class="ltx_text ltx_ref_tag">4.2</span></a>), and an engineering overview of the open-source reference implementation in TypeScript (§<a href="#S4.SS3" title="4.3 Engineering Overview ‣ 4 Protocol Specification and Implementation ‣ AWCP: A Workspace Delegation Protocol for Deep-Engagement Collaboration across Remote Agents" class="ltx_ref"><span class="ltx_text ltx_ref_tag">4.3</span></a>).</p>
</div>
<section id="S4.SS1" class="ltx_subsection">
<h3 class="ltx_title ltx_title_subsection"><span class="ltx_tag ltx_tag_subsection">4.1 </span>Message Protocol</h3>

<div id="S4.SS1.p1" class="ltx_para ltx_noindent">
<p id="S4.SS1.p1.1" class="ltx_p">Section <a href="#S3.SS2" title="3.2 Delegation Lifecycle ‣ 3 AWCP Framework ‣ AWCP: A Workspace Delegation Protocol for Deep-Engagement Collaboration across Remote Agents" class="ltx_ref"><span class="ltx_text ltx_ref_tag">3.2</span></a> defined five message types that drive the four-phase delegation lifecycle; here we specify their payload-level semantics.
All messages share a common header comprising a protocol version identifier, a message type discriminant, and a unique delegation identifier.
Table <a href="#S4.T1" title="Table 1 ‣ 4.1 Message Protocol ‣ 4 Protocol Specification and Implementation ‣ AWCP: A Workspace Delegation Protocol for Deep-Engagement Collaboration across Remote Agents" class="ltx_ref"><span class="ltx_text ltx_ref_tag">1</span></a> summarizes each message type, its directionality, and primary payload.</p>
</div>
<figure id="S4.T1" class="ltx_table">
<figcaption class="ltx_caption ltx_centering"><span class="ltx_tag ltx_tag_table">Table 1: </span>AWCP message types. All messages carry a shared header with protocol version, type discriminant, and delegation identifier. D and E denote Delegator and Executor, respectively.</figcaption>
<table id="S4.T1.2" class="ltx_tabular ltx_centering ltx_guessed_headers ltx_align_middle">
<thead class="ltx_thead">
<tr id="S4.T1.2.1" class="ltx_tr">
<th id="S4.T1.2.1.1" class="ltx_td ltx_align_left ltx_th ltx_th_column ltx_border_tt"><span id="S4.T1.2.1.1.1" class="ltx_text ltx_font_bold" style="font-size:90%;">Type</span></th>
<th id="S4.T1.2.1.2" class="ltx_td ltx_align_left ltx_th ltx_th_column ltx_border_tt"><span id="S4.T1.2.1.2.1" class="ltx_text ltx_font_bold" style="font-size:90%;">Direction</span></th>
<th id="S4.T1.2.1.3" class="ltx_td ltx_align_left ltx_th ltx_th_column ltx_border_tt"><span id="S4.T1.2.1.3.1" class="ltx_text ltx_font_bold" style="font-size:90%;">Phase</span></th>
<th id="S4.T1.2.1.4" class="ltx_td ltx_nopad_r ltx_align_left ltx_th ltx_th_column ltx_border_tt"><span id="S4.T1.2.1.4.1" class="ltx_text ltx_font_bold" style="font-size:90%;">Key Payload Fields</span></th></tr>
</thead>
<tbody class="ltx_tbody">
<tr id="S4.T1.2.2" class="ltx_tr">
<td id="S4.T1.2.2.1" class="ltx_td ltx_align_left ltx_border_t"><span id="S4.T1.2.2.1.1" class="ltx_text ltx_font_typewriter" style="font-size:90%;">INVITE</span></td>
<td id="S4.T1.2.2.2" class="ltx_td ltx_align_left ltx_border_t"><span id="S4.T1.2.2.2.1" class="ltx_text" style="font-size:90%;">D <math id="S4.T1.m1" class="ltx_Math" alttext="\to" display="inline" intent=":literal"><semantics><mo stretchy="false">→</mo><annotation encoding="application/x-tex">\to</annotation></semantics></math> E</span></td>
<td id="S4.T1.2.2.3" class="ltx_td ltx_align_left ltx_border_t"><span id="S4.T1.2.2.3.1" class="ltx_text" style="font-size:90%;">Negotiation</span></td>
<td id="S4.T1.2.2.4" class="ltx_td ltx_nopad_r ltx_align_left ltx_border_t"><span id="S4.T1.2.2.4.1" class="ltx_text" style="font-size:90%;">TaskSpec, LeaseConfig, EnvironmentDecl</span></td></tr>
<tr id="S4.T1.2.3" class="ltx_tr">
<td id="S4.T1.2.3.1" class="ltx_td ltx_align_left"><span id="S4.T1.2.3.1.1" class="ltx_text ltx_font_typewriter" style="font-size:90%;">ACCEPT</span></td>
<td id="S4.T1.2.3.2" class="ltx_td ltx_align_left"><span id="S4.T1.2.3.2.1" class="ltx_text" style="font-size:90%;">E <math id="S4.T1.m2" class="ltx_Math" alttext="\to" display="inline" intent=":literal"><semantics><mo stretchy="false">→</mo><annotation encoding="application/x-tex">\to</annotation></semantics></math> D</span></td>
<td id="S4.T1.2.3.3" class="ltx_td ltx_align_left"><span id="S4.T1.2.3.3.1" class="ltx_text" style="font-size:90%;">Negotiation</span></td>
<td id="S4.T1.2.3.4" class="ltx_td ltx_nopad_r ltx_align_left"><span id="S4.T1.2.3.4.1" class="ltx_text" style="font-size:90%;">ExecutorWorkDir, ExecutorConstraints</span></td></tr>
<tr id="S4.T1.2.4" class="ltx_tr">
<td id="S4.T1.2.4.1" class="ltx_td ltx_align_left"><span id="S4.T1.2.4.1.1" class="ltx_text ltx_font_typewriter" style="font-size:90%;">START</span></td>
<td id="S4.T1.2.4.2" class="ltx_td ltx_align_left"><span id="S4.T1.2.4.2.1" class="ltx_text" style="font-size:90%;">D <math id="S4.T1.m3" class="ltx_Math" alttext="\to" display="inline" intent=":literal"><semantics><mo stretchy="false">→</mo><annotation encoding="application/x-tex">\to</annotation></semantics></math> E</span></td>
<td id="S4.T1.2.4.3" class="ltx_td ltx_align_left"><span id="S4.T1.2.4.3.1" class="ltx_text" style="font-size:90%;">Provisioning</span></td>
<td id="S4.T1.2.4.4" class="ltx_td ltx_nopad_r ltx_align_left"><span id="S4.T1.2.4.4.1" class="ltx_text" style="font-size:90%;">ActiveLease, TransportHandle</span></td></tr>
<tr id="S4.T1.2.5" class="ltx_tr">
<td id="S4.T1.2.5.1" class="ltx_td ltx_align_left"><span id="S4.T1.2.5.1.1" class="ltx_text ltx_font_typewriter" style="font-size:90%;">DONE</span></td>
<td id="S4.T1.2.5.2" class="ltx_td ltx_align_left"><span id="S4.T1.2.5.2.1" class="ltx_text" style="font-size:90%;">E <math id="S4.T1.m4" class="ltx_Math" alttext="\to" display="inline" intent=":literal"><semantics><mo stretchy="false">→</mo><annotation encoding="application/x-tex">\to</annotation></semantics></math> D</span></td>
<td id="S4.T1.2.5.3" class="ltx_td ltx_align_left"><span id="S4.T1.2.5.3.1" class="ltx_text" style="font-size:90%;">Completion</span></td>
<td id="S4.T1.2.5.4" class="ltx_td ltx_nopad_r ltx_align_left"><span id="S4.T1.2.5.4.1" class="ltx_text" style="font-size:90%;">FinalSummary, Highlights</span></td></tr>
<tr id="S4.T1.2.6" class="ltx_tr">
<td id="S4.T1.2.6.1" class="ltx_td ltx_align_left ltx_border_bb"><span id="S4.T1.2.6.1.1" class="ltx_text ltx_font_typewriter" style="font-size:90%;">ERROR</span></td>
<td id="S4.T1.2.6.2" class="ltx_td ltx_align_left ltx_border_bb"><span id="S4.T1.2.6.2.1" class="ltx_text" style="font-size:90%;">Bidirectional</span></td>
<td id="S4.T1.2.6.3" class="ltx_td ltx_align_left ltx_border_bb"><span id="S4.T1.2.6.3.1" class="ltx_text" style="font-size:90%;">Any</span></td>
<td id="S4.T1.2.6.4" class="ltx_td ltx_nopad_r ltx_align_left ltx_border_bb"><span id="S4.T1.2.6.4.1" class="ltx_text" style="font-size:90%;">ErrorCode, Message, Hint</span></td></tr>
</tbody>
</table>
</figure>
<div id="S4.SS1.p2" class="ltx_para ltx_noindent">
<p id="S4.SS1.p2.1" class="ltx_p">The <span id="S4.SS1.p2.1.1" class="ltx_text ltx_font_typewriter">INVITE</span> message encapsulates the full delegation proposal: a <span id="S4.SS1.p2.1.2" class="ltx_text ltx_font_italic">TaskSpec</span> containing a natural-language description and agent prompt; a <span id="S4.SS1.p2.1.3" class="ltx_text ltx_font_italic">LeaseConfig</span> specifying the time-to-live in seconds and the access mode (read-only or read-write); and an <span id="S4.SS1.p2.1.4" class="ltx_text ltx_font_italic">EnvironmentDeclaration</span> listing the filesystem resources to be projected.
Optional fields include executor requirements and authentication credentials.</p>
</div>
<div id="S4.SS1.p3" class="ltx_para ltx_noindent">
<p id="S4.SS1.p3.1" class="ltx_p">The <span id="S4.SS1.p3.1.1" class="ltx_text ltx_font_typewriter">ACCEPT</span> response carries the Executor’s allocated working directory and an <span id="S4.SS1.p3.1.2" class="ltx_text ltx_font_italic">ExecutorConstraints</span> structure that allows the Executor to narrow the proposed lease, for example by capping the time-to-live at a locally configured maximum or restricting the access mode to read-only.
This negotiation mechanism allows Executors to enforce local resource policies without rejecting the delegation outright.</p>
</div>
<div id="S4.SS1.p4" class="ltx_para ltx_noindent">
<p id="S4.SS1.p4.1" class="ltx_p">The <span id="S4.SS1.p4.1.1" class="ltx_text ltx_font_typewriter">START</span> message activates the data plane by conveying an <span id="S4.SS1.p4.1.2" class="ltx_text ltx_font_italic">ActiveLease</span> with an absolute expiration timestamp and a <span id="S4.SS1.p4.1.3" class="ltx_text ltx_font_italic">TransportHandle</span>, which is a discriminated union whose variant is determined by the selected transport type.
Each variant carries the transport-specific credentials required to establish the data channel, as detailed in §<a href="#S4.SS2" title="4.2 Transport Adapters ‣ 4 Protocol Specification and Implementation ‣ AWCP: A Workspace Delegation Protocol for Deep-Engagement Collaboration across Remote Agents" class="ltx_ref"><span class="ltx_text ltx_ref_tag">4.2</span></a>.</p>
</div>
<div id="S4.SS1.p5" class="ltx_para ltx_noindent">
<p id="S4.SS1.p5.1" class="ltx_p">The <span id="S4.SS1.p5.1.1" class="ltx_text ltx_font_typewriter">DONE</span> message signals successful task completion with a textual summary and optional highlights enumerating key changes.
The <span id="S4.SS1.p5.1.2" class="ltx_text ltx_font_typewriter">ERROR</span> message is unique in being bidirectional: either party may emit it to signal failure, carrying a machine-readable error code, a human-readable description, and an optional hint suggesting corrective action.</p>
</div>
</section>
<section id="S4.SS2" class="ltx_subsection">
<h3 class="ltx_title ltx_title_subsection"><span class="ltx_tag ltx_tag_subsection">4.2 </span>Transport Adapters</h3>

<div id="S4.SS2.p1" class="ltx_para ltx_noindent">
<p id="S4.SS2.p1.1" class="ltx_p">As established in §<a href="#S3.SS1" title="3.1 Architecture ‣ 3 AWCP Framework ‣ AWCP: A Workspace Delegation Protocol for Deep-Engagement Collaboration across Remote Agents" class="ltx_ref"><span class="ltx_text ltx_ref_tag">3.1</span></a>, the transport layer is realized through pluggable adapter pairs whose concrete interfaces are detailed below.</p>
</div>
<section id="S4.SS2.SSS0.Px1" class="ltx_paragraph">
<h4 class="ltx_title ltx_title_paragraph">Adapter interfaces.</h4>

<div id="S4.SS2.SSS0.Px1.p1" class="ltx_para ltx_noindent">
<p id="S4.SS2.SSS0.Px1.p1.1" class="ltx_p">Rather than a single unified abstraction, the implementation defines two complementary adapter interfaces reflecting the inherently asymmetric roles in workspace delegation.
The <span id="S4.SS2.SSS0.Px1.p1.1.1" class="ltx_text ltx_font_italic">DelegatorTransportAdapter</span> is responsible for packaging the local workspace into a transport-specific handle and integrating result snapshots received from the Executor.
The <span id="S4.SS2.SSS0.Px1.p1.1.2" class="ltx_text ltx_font_italic">ExecutorTransportAdapter</span> handles the inverse: verifying system-level prerequisites, provisioning the workspace from the received handle, and capturing snapshots for return transmission.
Both adapters share a two-phase cleanup contract that includes <span id="S4.SS2.SSS0.Px1.p1.1.3" class="ltx_text ltx_font_typewriter">detach</span> for graceful disconnection followed by <span id="S4.SS2.SSS0.Px1.p1.1.4" class="ltx_text ltx_font_typewriter">release</span> for final resource reclamation, which mirrors the protocol’s completion semantics defined in §<a href="#S3.SS2" title="3.2 Delegation Lifecycle ‣ 3 AWCP Framework ‣ AWCP: A Workspace Delegation Protocol for Deep-Engagement Collaboration across Remote Agents" class="ltx_ref"><span class="ltx_text ltx_ref_tag">3.2</span></a>.</p>
</div>
<div id="S4.SS2.SSS0.Px1.p2" class="ltx_para ltx_noindent">
<p id="S4.SS2.SSS0.Px1.p2.1" class="ltx_p">As introduced in §<a href="#S3.SS1" title="3.1 Architecture ‣ 3 AWCP Framework ‣ AWCP: A Workspace Delegation Protocol for Deep-Engagement Collaboration across Remote Agents" class="ltx_ref"><span class="ltx_text ltx_ref_tag">3.1</span></a>, each adapter declares its <span id="S4.SS2.SSS0.Px1.p2.1.1" class="ltx_text ltx_font_italic">capabilities</span>, particularly its support for live synchronization, which enables the control layer to select the appropriate reconciliation strategy at runtime.</p>
</div>
<figure id="S4.T2" class="ltx_table">
<figcaption class="ltx_caption ltx_centering"><span class="ltx_tag ltx_tag_table">Table 2: </span>Comparison of AWCP transport adapters across key operational dimensions.</figcaption>
<table id="S4.T2.2" class="ltx_tabular ltx_centering ltx_guessed_headers ltx_align_middle">
