urce-price-table th:first-child{width:25%}.post-content .omni-source .source-price-table td:first-child{white-space:nowrap}.post-content .omni-source .source-benchmark-table{width:100%;min-width:720px;max-width:none;margin-inline:auto}.post-content .omni-source .source-wide-benchmark{width:100%;max-width:100%;margin-left:0;padding-top:0;padding-bottom:0;transform:none}.post-content .omni-source .source-language-table{min-width:780px;table-layout:fixed}.post-content .omni-source .source-language-table th,.post-content .omni-source .source-language-table td{text-align:left;vertical-align:top;line-height:1.6}.post-content .omni-source .source-language-table td:first-child{padding-left:7px}.post-content .omni-source .source-plugin-table{min-width:900px;table-layout:fixed}.post-content .omni-source .source-plugin-table th:first-child,.post-content .omni-source .source-plugin-table td:first-child{width:22%}.post-content .omni-source .source-plugin-table td:nth-child(2){text-align:left}.post-content .omni-source .source-wide-plugin{width:100%;max-width:100%;margin-left:0;transform:none}.post-content .omni-source .source-performance-scroll{width:100%;max-width:100%;margin-left:0;transform:none}.post-content .omni-source .source-performance-table{width:100%!important;min-width:0;table-layout:fixed;font-size:13px}.post-content .omni-source .source-performance-table th{font-size:15px;line-height:1.2}.post-content .omni-source .source-performance-table th:first-child{width:24%}.post-content .omni-source .source-omni-table{min-width:0}.post-content .omni-source .source-omni-table th:first-child{width:24%}.post-content .omni-source .source-omni-table .score-benchmark{white-space:normal;overflow-wrap:anywhere}.post-content .omni-source .source-omni-table th:nth-child(4){width:13%}.post-content .omni-source .source-agentic-understanding-table th:first-child{width:20%}.post-content .omni-source .source-agentic-understanding-table{min-width:0}.post-content .omni-source .source-text-table{min-width:0}.post-content .omni-source .source-text-table th:first-child,.post-content .omni-source .source-vision-table th:first-child{width:24%}.post-content .omni-source .source-text-table th:nth-child(2){width:16%}.post-content .omni-source .source-text-table th:nth-child(3),.post-content .omni-source .source-text-table th:nth-child(4),.post-content .omni-source .source-text-table th:nth-child(5){width:11%}.post-content .omni-source .source-vision-table{min-width:0}.post-content .omni-source .source-vision-table th:nth-child(2){width:18%}.post-content .omni-source .source-vision-table th:nth-child(3),.post-content .omni-source .source-vision-table th:nth-child(4),.post-content .omni-source .source-vision-table th:nth-child(5){width:12%}.post-content .omni-source .source-realtime-table th:first-child{width:16%}.post-content .omni-source .source-realtime-table{min-width:0}.post-content .omni-source .source-realtime-table th:nth-child(3){width:18%}.post-content .omni-source .source-realtime-table th{white-space:normal}.post-content .omni-source .source-performance-table th,.post-content .omni-source .source-performance-table td{padding:6px 7px;text-align:center;vertical-align:middle}.post-content .omni-source .source-performance-table td:not(:first-child){font-size:15px;line-height:1.2}.post-content .omni-source .source-performance-table td:first-child{padding-left:16px;text-align:left}.post-content .omni-source .source-performance-table .score-target{background:rgba(10,46,254,8%)}.post-content .omni-source .source-performance-table .score-group td{padding:6px 12px;border-bottom:1px solid rgba(10,46,254,.2);color:#0a2efe;background:#d6dafc;font-size:15px;font-weight:600;text-align:left}.post-content .omni-source .score-capability{margin-top:4px;color:#777;font-size:11px;font-weight:400;line-height:1.2}.post-content .omni-source .source-performance-table .metric-stack{display:flex;flex-direction:column;gap:7px;padding:3px 0}.post-content .omni-source .source-performance-table .metric-label{font-size:10px;font-weight:400;line-height:1.1;color:#777}.post-content .omni-source .source-performance-table .metric-value{margin-top:2px;font-size:15px;line-height:1.15;color:#171717}.post-content .omni-source .score-benchmark{color:#171717;font-size:15px;font-weight:600;line-height:1.22;white-space:nowrap}.post-content .omni-source .source-score-note{margin-top:12px;margin-bottom:14px;font-size:10px;line-height:1.4;opacity:.7}.post-content .omni-source .source-footnote-ref{font-size:10px;line-height:0;vertical-align:super}.post-content .omni-source table th,.post-content .omni-source table td{padding:6px 7px;border:0;border-bottom:1px solid rgba(128,128,128,.15);background:0 0;text-align:center;vertical-align:middle;white-space:normal;font-weight:400;line-height:1.5;min-width:0}.post-content .omni-source table th{padding:6px 7px;border-bottom:2px solid #0a2efe;color:#0a2efe;font-size:14px;font-weight:500}.post-content .omni-source table th:first-child{text-align:left;font-weight:600}.post-content .omni-source table[class] td{padding:6px 7px;border-bottom:1px solid rgba(128,128,128,.15)}.post-content .omni-source table[class] td:first-child{padding-left:20px;text-align:start}body.dark .post-content .omni-source table td{color:#e8e8e8}body.dark .post-content .omni-source table th,body.dark .post-content .omni-source .source-performance-table .score-group td{color:#8da2ff!important;border-bottom-color:#8da2ff!important}body.dark .post-content .omni-source .source-performance-table .score-group td{background:rgba(10,46,254,.22)}body.dark .post-content .omni-source .score-benchmark,body.dark .post-content .omni-source .source-performance-table .metric-value{color:#e8e8e8!important}body.dark .post-content .omni-source .score-capability,body.dark .post-content .omni-source .source-performance-table .metric-label,body.dark .post-content .omni-source .source-score-note{color:#a3a3a3!important}@media(prefers-color-scheme:dark){.post-content .