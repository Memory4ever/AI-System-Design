</div>
<div id="alg1.l26" class="ltx_listingline">
                <span class="ltx_tag ltx_tag_listingline"><span id="alg1.l26.1" class="ltx_text" style="font-size:80%;">26:</span></span>
                
                <span id="alg1.l26.2" class="ltx_text ltx_font_bold">if</span> Update Interval <span id="alg1.l26.3" class="ltx_text ltx_font_bold">then</span>

</div>
<div id="alg1.l27" class="ltx_listingline">
                <span class="ltx_tag ltx_tag_listingline"><span id="alg1.l27.1" class="ltx_text" style="font-size:80%;">27:</span></span>
                
                 Sample batch <math id="alg1.l27.m1" class="ltx_Math" alttext="\mathcal{B}_{\text{real}}\sim\mathcal{D}_{\text{real}}" display="inline" intent=":literal"><semantics><mrow><msub><mi class="ltx_font_mathcaligraphic">ℬ</mi><mtext>real</mtext></msub><mo>∼</mo><msub><mi class="ltx_font_mathcaligraphic">𝒟</mi><mtext>real</mtext></msub></mrow><annotation encoding="application/x-tex">\mathcal{B}_{\text{real}}\sim\mathcal{D}_{\text{real}}</annotation></semantics></math>.

</div>
<div id="alg1.l28" class="ltx_listingline">
                <span class="ltx_tag ltx_tag_listingline"><span id="alg1.l28.1" class="ltx_text" style="font-size:80%;">28:</span></span>
                
                 Sample equal-sized batch <math id="alg1.l28.m1" class="ltx_Math" alttext="\mathcal{B}_{\text{demo}}\sim\mathcal{D}_{\text{demo}}" display="inline" intent=":literal"><semantics><mrow><msub><mi class="ltx_font_mathcaligraphic">ℬ</mi><mtext>demo</mtext></msub><mo>∼</mo><msub><mi class="ltx_font_mathcaligraphic">𝒟</mi><mtext>demo</mtext></msub></mrow><annotation encoding="application/x-tex">\mathcal{B}_{\text{demo}}\sim\mathcal{D}_{\text{demo}}</annotation></semantics></math>.

</div>
<div id="alg1.l29" class="ltx_listingline">
                <span class="ltx_tag ltx_tag_listingline"><span id="alg1.l29.1" class="ltx_text" style="font-size:80%;">29:</span></span>
                
                 Construct Hybrid Dataset <math id="alg1.l29.m1" class="ltx_Math" alttext="\mathcal{B}_{\text{hybrid}}=\mathcal{B}_{\text{real}}\cup\mathcal{B}_{\text{demo}}" display="inline" intent=":literal"><semantics><mrow><msub><mi class="ltx_font_mathcaligraphic">ℬ</mi><mtext>hybrid</mtext></msub><mo>=</mo><mrow><msub><mi class="ltx_font_mathcaligraphic">ℬ</mi><mtext>real</mtext></msub><mo>∪</mo><msub><mi class="ltx_font_mathcaligraphic">ℬ</mi><mtext>demo</mtext></msub></mrow></mrow><annotation encoding="application/x-tex">\mathcal{B}_{\text{hybrid}}=\mathcal{B}_{\text{real}}\cup\mathcal{B}_{\text{demo}}</annotation></semantics></math>.

</div>
