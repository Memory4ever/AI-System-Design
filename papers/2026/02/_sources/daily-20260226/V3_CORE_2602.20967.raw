<td id="S2.T3.fig1.3.1.4.8" class="ltx_td ltx_align_center" style="padding-top:1pt;padding-bottom:1pt;">15.75</td>
<td id="S2.T3.fig1.3.1.4.9" class="ltx_td ltx_align_center" style="padding-top:1pt;padding-bottom:1pt;">14.72</td>
<td id="S2.T3.fig1.3.1.4.10" class="ltx_td ltx_align_center" style="padding-top:1pt;padding-bottom:1pt;">30.91</td></tr>
<tr id="S2.T3.fig1.3.1.5" class="ltx_tr">
<td id="S2.T3.fig1.3.1.5.1" class="ltx_td ltx_align_center ltx_border_r ltx_border_t" style="padding-top:1pt;padding-bottom:1pt;">SNR-OA<math id="S2.T3.m5" class="ltx_Math" alttext="{}_{\text{no-clip}}" display="inline" intent=":literal"><semantics><msub><mrow></mrow><mtext>no-clip</mtext></msub><annotation encoding="application/x-tex">{}_{\text{no-clip}}</annotation></semantics></math> <cite class="ltx_cite ltx_citemacro_cite">[<a href="#bib.bib5" title="" class="ltx_ref">20</a>]</cite></td>
<td id="S2.T3.fig1.3.1.5.2" class="ltx_td ltx_align_center ltx_border_t" style="padding-top:1pt;padding-bottom:1pt;">2.40</td>
<td id="S2.T3.fig1.3.1.5.3" class="ltx_td ltx_align_center ltx_border_t" style="padding-top:1pt;padding-bottom:1pt;">1.79</td>
<td id="S2.T3.fig1.3.1.5.4" class="ltx_td ltx_align_center ltx_border_r ltx_border_t" style="padding-top:1pt;padding-bottom:1pt;">8.01</td>
