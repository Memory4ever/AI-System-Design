-color:#000000;--ltx-fill-color:#000000;" fill="#000000" stroke="#000000" transform="matrix(1.0 0.0 0.0 1.0 244.21 -50.05)"><foreignObject style="--ltx-fo-width:0.92em;--ltx-fo-height:0.43em;--ltx-fo-depth:0.15em;font-size:10pt;" height="8.03" overflow="visible" transform="matrix(1 0 0 -1 0 5.96)" width="12.69"><span class="ltx_foreignobject_container"><span class="ltx_foreignobject_content"><math id="A2.F4.pic1.m7" class="ltx_Math" alttext="s_{6}" display="inline" intent=":literal"><semantics><msub><mi>s</mi><mn>6</mn></msub><annotation encoding="application/x-tex">s_{6}</annotation></semantics></math></span></span></foreignObject></g><path style="fill:none" d="M 357.69 48.11 C 357.69 58.98 348.88 67.8 338 67.8 C 327.13 67.8 318.32 58.98 318.32 48.11 C 318.32 37.24 327.13 28.43 338 28.43 C 348.88 28.43 357.69 37.24 357.69 48.11 Z M 338 48.11"></path><g style="--ltx-stroke-color:#000000;--ltx-fill-color:#000000;" fill="#000000" stroke="#000000" transform="matrix(1.0 0.0 0.0 1.0 323.98 46.17)"><foreignObject style="--ltx-fo-width:2.03em;--ltx-fo-height:0.43em;--ltx-fo-depth:0.15em;font-size:10pt;" height="8.03" overflow="visible" transform="matrix(1 0 0 -1 0 5.96)" width="28.05"><span class="ltx_foreignobject_container"><span class="ltx_foreignobject_content"><math id="A2.F4.pic1.m8" class="ltx_Math" alttext="s_{2k-1}" display="inline" intent=":literal"><semantics><msub><mi>s</mi><mrow><mrow><mn>2</mn><mo lspace="0em" rspace="0em">​</mo><mi>k</mi></mrow><mo>−</mo><mn>1</mn></mrow></msub><annotation encoding="application/x-tex">s_{2k-1}</annotation></semantics></math></span></span></foreignObject></g><path style="fill:none" d="M 357.69 -48.11 C 357.69 -37.24 348.88 -28.43 338 -28.43 C 327.13 -28.43 318.32 -37.24 318.32 -48.11 C 318.32 -58.98 327.13 -67.8 338 -67.8 C 348.88 -67.8 357.69 -58.98 357.69 -48.11 Z M 338 -48.11"></path><g style="--ltx-stroke-color:#000000;--ltx-fill-color:#000000;" fill="#000000" stroke="#000000" transform="matrix(1.0 0.0 0.0 1.0 328.6 -50.05)"><foreignObject style="--ltx-fo-width:1.36em;--ltx-fo-height:0.43em;--ltx-fo-depth:0.15em;font-size:10pt;" height="8.03" overflow="visible" transform="matrix(1 0 0 -1 0 5.96)" width="18.81"><span class="ltx_foreignobject_container"><span class="ltx_foreignobject_content"><math id="A2.F4.pic1.m9" class="ltx_Math" alttext="s_{2k}" display="inline" intent=":literal"><semantics><msub><mi>s</mi><mrow><mn>2</mn><mo lspace="0em" rspace="0em">​</mo><mi>k</mi></mrow></msub><annotation encoding="application/x-tex">s_{2k}</annotation></semantics></math></span></span></foreignObject></g><g style="--ltx-stroke-color:#000000;--ltx-fill-color:#000000;" fill="#000000" stroke="#000000" transform="matrix(1.0 0.0 0.0 1.0 410.42 44.65)"><foreignObject style="--ltx-fo-width:0.75em;--ltx-fo-height:0.7em;--ltx-fo-depth:0.2em;font-size:10pt;" height="12.45" overflow="visible" transform="matrix(1 0 0 -1 0 9.69)" width="10.38"><span class="ltx_foreignobject_container"><span class="ltx_foreignobject_content"><math id="A2.F4.pic1.m10" class="ltx_Math" alttext="\dots" display="inline" intent=":literal"><semantics><mi mathvariant="normal">…</mi><annotation encoding="application/x-tex">\dots</annotation></semantics></math></span></span></foreignObject></g><g style="--ltx-stroke-color:#000000;--ltx-fill-color:#000000;" fill="#000000" stroke="#000000" transform="matrix(1.0 0.0 0.0 1.0 410.42 -51.57)"><foreignObject style="--ltx-fo-width:0.75em;--ltx-fo-height:0.7em;--ltx-fo-depth:0.2em;font-size:10pt;" height="12.45" overflow="visible" transform="matrix(1 0 0 -1 0 9.69)" width="10.38"><span class="ltx_foreignobject_container"><span class="ltx_foreignobject_content"><math id="A2.F4.pic1.m11" class="ltx_Math" alttext="\dots" display="inline" intent=":literal"><semantics><mi mathvariant="normal">…</mi><annotation encoding="application/x-tex">\dots</annotation></semantics></math></span></span></foreignObject></g><path style="fill:none" d="M 16.96 10.78 L 53.18 33.81"></path><g stroke-dasharray="none" stroke-dashoffset="0.0pt" stroke-linejoin="miter" transform="matrix(0.84389 0.53654 -0.53654 0.84389 50.88 32.35)"><path d="M 6.78 0 L 1.34 2.03 L 2.92 0 L 1.34 -2.03 Z"></path></g><g style="--ltx-stroke-color:#000000;--ltx-fill-color:#000000;" fill="#000000" stroke="#000000" transform="matrix(1.0 0.0 0.0 1.0 -11.15 32.54)"><foreignObject style="--ltx-fo-width:3.18em;--ltx-fo-height:0.75em;--ltx-fo-depth:0.25em;font-size:10pt;" height="13.84" overflow="visible" transform="matrix(1 0 0 -1 0 10.38)" width="43.96"><span class="ltx_foreignobject_container"><span class="ltx_foreignobject_content"><math id="A2.F4.pic1.m12" class="ltx_Math" alttext="(a_{2},a_{1})" display="inline" intent=":literal"><semantics><mrow><mo stretchy="false">(</mo><msub><mi>a</mi><mn>2</mn></msub><mo>,</mo><msub><mi>a</mi><mn>1</mn></msub><mo stretchy="false">)</mo></mrow><annotation encoding="application/x-tex">(a_{2},a_{1})</annotation></semantics></math></span></span></foreignObject></g><path style="fill:none" d="M 16.96 -10.78 L 53.18 -33.81"></path><g stroke-dasharray="none" stroke-dashoffset="0.0pt" stroke-linejoin="miter" transform="matrix(0.84389 -0.53654 0.53654 0.84389 50.88 -32.35)"><path d="M 6.78 0 L 1.34 2.03 L 2.92 0 L 1.34 -2.03 Z"></path></g><g style="--ltx-stroke-color:#000000;--ltx-fill-color:#000000;" fill="#000000" stroke="#000000" transform="matrix(1.0 0.0 0.0 1.0 42.86 -19.03)"><foreignObject style="--ltx-fo-width:1.56em;--ltx-fo-height:0.69em;--ltx-fo-depth:0em;font-size:10pt;" height="9.61" overflow="visible" transform="matrix(1 0 0 -1 0 9.61)" width="21.6"><span class="ltx_foreignobject_container"><span class="ltx_foreignobject_content"><span id="A2.F4.pic1.1" class="ltx_text">else</span></span></span></foreignObject></g><path style="fill:none" d="M 95.77 48.11 L 136.46 48.11"></path><g stroke-dasharray="none" stroke-dashoffset="0.0pt" stroke-linejoin="miter" transform="matrix(1.0 0.0 0.0 1.0 133.74 48.11)"><path d="M 6.78 0 L 1.34 2.03 L 2.92 0 L 1.34 -2.03 Z"></path></g><g style="--ltx-stroke-color:#000000;--ltx-fill-color:#000000;" fill="#000000" stroke="#000000" transform="matrix(1.0 0.0 0.0 1.0 97.41 56.6)"><foreignObject style="--ltx-fo-width:3.18em;--ltx-fo-height:0.75em;--ltx-fo-depth:0.25em;font-size:10pt;" height="13.84" overflow="visible" transform="matrix(1 0 0 -1 0 10.38)" width="43.96"><span class="ltx_foreignobject_container"><span class="ltx_foreignobject_content"><math id="A2.F4.pic1.m13" class="ltx_Math" alttext="(a_{2},a_{1})" display="inline" intent=":literal"><semantics><mrow><mo stretchy="false">(</mo><msub><mi>a</mi><mn>2</mn></msub><mo>,</mo><msub><mi>a</mi><mn>1</mn></msub><mo stretchy="false">)</mo></mrow><annotation encoding="application/x-tex">(a_{2},a_{1})</annotation></semantics></math></span></span></foreignObject></g><path style="fill:none" d="M 89.19 33.24 L 145.19 -28.38"></path><g stroke-dasharray="none" stroke-dashoffset="0.0pt" stroke-linejoin="miter" transform="matrix(0.67255 -0.74005 0.74005 0.67255 143.36 -26.37)"><path d="M 6.78 0 L 1.34 2.03 L 2.92 0 L 1.34 -2.03 Z"></path></g><g style="--ltx-stroke-color:#000000;--ltx-fill-color:#000000;" fill="#000000" stroke="#000000" transform="matrix(1.0 0.0 0.0 1.0 124.42 5.03)"><foreignObject style="--ltx-fo-width:1.56em;--ltx-fo-height:0.69em;--ltx-fo-depth:0em;font-size:10pt;" height="9.61" overflow="visible" transform="matrix(1 0 0 -1 0 9.61)" width="21.6"><span class="ltx_foreignobject_container"><span class="ltx_foreignobject_content"><span id="A2.F4.pic1.2" class="ltx_text">else</span></span></span></foreignObject></g><path style="fill:none" d="M 95.77 -48.11 L 136.46 -48.11"></path><g stroke-dasharray="none" stroke-dashoffset="0.0pt" stroke-linejoin="miter" transform="matrix(1.0 0.0 0.0 1.0 133.74 -48.11)"><path d="M 6.78 0 L 1.34 2.03 L 2.92 0 L 1.34 -2.03 Z"></path></g><g style="--ltx-stroke-color:#000000;--ltx-fill-color:#000000;" fill="#000000" stroke="#000000" transform="matrix(1.0 0.0 0.0 1.0 112.09 -43.08)"><foreignObject style="--ltx-fo-width:1.06em;--ltx-fo-height:0.69em;--ltx-fo-depth:0em;font-size:10pt;" height="9.61" overflow="visible" transform="matrix(1 0 0 -1 0 9.61)" width="14.61"><span class="ltx_foreignobject_container"><span class="ltx_foreignobject_content"><span id="A2.F4.pic1.3" class="ltx_text">all</span></span></span></foreignObject></g><path style="fill:none" d="M 183.21 48.11 L 223.9 48.11"></path><g stroke-dasharray="none" stroke-dashoffset="0.0pt" stroke-linejoin="miter" transform="matrix(1.0 0.0 0.0 1.0 221.19 48.11)"><path d="M 6.78 0 L 1.34 2.03 L 2.92 0 L 1.34 -2.03 Z"></path></g><g style="--ltx-stroke-color:#000000;--ltx-fill-color:#000000;" fill="#000000" stroke="#000000" transform="matrix(1.0 0.0 0.0 1.0 199.53 53.14)"><foreignObject style="--ltx-fo-width:1.06em;--ltx-fo-height:0.69em;--ltx-fo-depth:0em;font-size:10pt;" height="9.61" overflow="visible" transform="matrix(1 0 0 -1 0 9.61)" width="14.61"><span class="ltx_foreignobject_container"><span class="ltx_foreignobject_content"><span id="A2.F4.pic1.4" class="ltx_text">all</span></span></span></foreignObject></g><path style="fill:none" d="M 183.21 -48.11 L 223.9 -48.11"></path><g stroke-dasharray="none" stroke-dashoffset="0.0pt" stroke-linejoin="miter" transform="matrix(1.0 0.0 0.0 1.0 221.19 -48.11)"><path d="M 6.78 0 L 1.34 2.03 L 2.92 0 L 1.34 -2.03 Z"></path></g><g style="--ltx-stroke-color:#000000;--ltx-fill-color:#000000;" fill="#000000" stroke="#000000" transform="matrix(1.0 0.0 0.0 1.0 199.53 -43.08)"><foreignObject style="--ltx-fo-width:1.06em;--ltx-fo-height:0.69em;--ltx-fo-depth:0em;font-size:10pt;" height="9.61" overflow="visible" transform="matrix(1 0 0 -1 0 9.61)" width="14.61"><span class="ltx_foreignobject_container"><span class="ltx_foreignobject_content"><span id="A2.F4.pic1.5" class="ltx_text">all</span></span></span></foreignObject></g><path style="fill:none" d="M 270.66 48.11 L 311.35 48.11"></path><g stroke-dasharray="none" stroke-dashoffset="0.0pt" stroke-linejoin="miter" transform="matrix(1.0 0.0 0.0 1.0 308.63 48.11)"><path d="M 6.78 0 L 1.34 2.03 L 2.92 0 L 1.34 -2.03 Z"></path></g><g style="--ltx-stroke-color:#000000;--ltx-fill-color:#000000;" fill="#000000" stroke="#000000" transform="matrix(1.0 0.0 0.0 1.0 289.09 55.91)"><foreignObject style="--ltx-fo-width:0.75em;--ltx-fo-height:0.7em;--ltx-fo-depth:0.2em;font-size:10pt;" height="12.45" overflow="visible" transform="matrix(1 0 0 -1 0 9.69)" width="10.38"><span class="ltx_foreignobject_container"><span class="ltx_foreignobject_content"><math id="A2.F4.pic1.m14" class="ltx_Math" alttext="\cdots" display="inline" intent=":literal"><semantics><mo>⋯</mo><annotation encoding="application/x-tex">\cdots</annotation></semantics></math></span></span></foreignObject></g><path style="fill:none" d="M 270.66 -48.11 L 311.35 -48.11"></path><g stroke-dasharray="none" stroke-dashoffset="0.0pt" stroke-linejoin="miter" transform="matrix(1.0 0.0 0.0 1.0 308.63 -48.11)"><path d="M 6.78 0 L 1.34 2.03 L 2.92 0 L 1.34 -2.03 Z"></path></g><g style="--ltx-stroke-color:#000000;--ltx-fill-color:#000000;" fill="#000000" stroke="#000000" transform="matrix(1.0 0.0 0.0 1.0 289.09 -40.32)"><foreignObject style="--ltx-fo-width:0.75em;--ltx-fo-height:0.7em;--ltx-fo-depth:0.2em;font-size:10pt;" height="12.45" overflow="visible" transform="matrix(1 0 0 -1 0 9.69)" width="10.38"><span class="ltx_foreignobject_container"><span class="ltx_foreignobject_content"><math id="A2.F4.pic1.m15" class="ltx_Math" alttext="\cdots" display="inline" intent=":literal"><semantics><mo>⋯</mo><annotation encoding="application/x-tex">\cdots</annotation></semantics></math></span></span></foreignObject></g><path style="fill:none" d="M 358.1 48.11 L 398.79 48.11"></path><g stroke-dasharray="none" stroke-dashoffset="0.0pt" stroke-linejoin="miter" transform="matrix(1.0 0.0 0.0 1.0 396.08 48.11)"><path d="M 6.78 0 L 1.34 2.03 L 2.92 0 L 1.34 -2.03 Z"></path></g><path style="fill:none" d="M 358.1 -48.11 L 398.79 -48.11"></path><g stroke-dasharray="none" stroke-dashoffset="0.0pt" stroke-linejoin="miter" transform="matrix(1.0 0.0 0.0 1.0 396.08 -48.11)"><path d="M 6.78 0 L 1.34 2.03 L 2.92 0 L 1.34 -2.03 Z"></path></g></g></svg></span>
<figcaption class="ltx_caption"><span class="ltx_tag ltx_tag_figure">Figure 4: </span>Transition dynamics for the two-player game. <math id="A2.F4.m3" class="ltx_Math" alttext="s_{0}" display="inline" intent=":literal"><semantics><msub><mi>s</mi><mn>0</mn></msub><annotation encoding="application/x-tex">s_{0}</annotation></semantics></math> is the initial state. The top branch contains all odd states while the bottom branch together with <math id="A2.F4.m4" class="ltx_Math" alttext="s_{0}" display="inline" intent=":literal"><semantics><msub><mi>s</mi><mn>0</mn></msub><annotation encoding="application/x-tex">s_{0}</annotation></semantics></math> comprises all even states.</figcaption>
</figure>
<div id="A2.SS3.p5" class="ltx_para ltx_noindent">
<p id="A2.SS3.p5.1" class="ltx_p"><span id="A2.SS3.p5.1.1" class="ltx_text">We define the expert as the Nash policy <math id="A2.SS3.p5.m1" class="ltx_Math" alttext="\pi^{E}" display="inline" intent=":literal"><semantics><msup><mi>π</mi><mi>E</mi></msup><annotation encoding="application/x-tex">\pi^{E}</annotation></semantics></math> such that <math id="A2.SS3.p5.m2" class="ltx_Math" alttext="\pi^{E}((a_{1},a_{1})|s_{0})=1" display="inline" intent=":literal"><semantics><mrow><mrow><msup><mi>π</mi><mi>E</mi></msup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mrow><mo stretchy="false">(</mo><msub><mi>a</mi><mn>1</mn></msub><mo>,</mo><msub><mi>a</mi><mn>1</mn></msub><mo stretchy="false">)</mo></mrow><mo lspace="0em" rspace="0em">|</mo><msub><mi>s</mi><mn>0</mn></msub><mo stretchy="false">)</mo></mrow></mrow><mo>=</mo><mn>1</mn></mrow><annotation encoding="application/x-tex">\pi^{E}((a_{1},a_{1})|s_{0})=1</annotation></semantics></math>, <math id="A2.SS3.p5.m3" class="ltx_Math" alttext="\pi^{E}((a_{3},a_{3})|s_{1})=1" display="inline" intent=":literal"><semantics><mrow><mrow><msup><mi>π</mi><mi>E</mi></msup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mrow><mo stretchy="false">(</mo><msub><mi>a</mi><mn>3</mn></msub><mo>,</mo><msub><mi>a</mi><mn>3</mn></msub><mo stretchy="false">)</mo></mrow><mo lspace="0em" rspace="0em">|</mo><msub><mi>s</mi><mn>1</mn></msub><mo stretchy="false">)</mo></mrow></mrow><mo>=</mo><mn>1</mn></mrow><annotation encoding="application/x-tex">\pi^{E}((a_{3},a_{3})|s_{1})=1</annotation></semantics></math> and the actions for the other states are arbitrary.</span></p>
</div>
<div id="A2.SS3.p6" class="ltx_para ltx_noindent">
<p id="A2.SS3.p6.1" class="ltx_p"><span id="A2.SS3.p6.1.1" class="ltx_text">Similarly, we define the trained policy <math id="A2.SS3.p6.m1" class="ltx_Math" alttext="\pi" display="inline" intent=":literal"><semantics><mi>π</mi><annotation encoding="application/x-tex">\pi</annotation></semantics></math> such that <math id="A2.SS3.p6.m2" class="ltx_Math" alttext="\pi((a_{1},a_{1})|s_{0})=1" display="inline" intent=":literal"><semantics><mrow><mrow><mi>π</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mrow><mo stretchy="false">(</mo><msub><mi>a</mi><mn>1</mn></msub><mo>,</mo><msub><mi>a</mi><mn>1</mn></msub><mo stretchy="false">)</mo></mrow><mo lspace="0em" rspace="0em">|</mo><msub><mi>s</mi><mn>0</mn></msub><mo stretchy="false">)</mo></mrow></mrow><mo>=</mo><mn>1</mn></mrow><annotation encoding="application/x-tex">\pi((a_{1},a_{1})|s_{0})=1</annotation></semantics></math> and <math id="A2.SS3.p6.m3" class="ltx_Math" alttext="\pi((a_{1},a_{1})|s_{1})=1" display="inline" intent=":literal"><semantics><mrow><mrow><mi>π</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mrow><mo stretchy="false">(</mo><msub><mi>a</mi><mn>1</mn></msub><mo>,</mo><msub><mi>a</mi><mn>1</mn></msub><mo stretchy="false">)</mo></mrow><mo lspace="0em" rspace="0em">|</mo><msub><mi>s</mi><mn>1</mn></msub><mo stretchy="false">)</mo></mrow></mrow><mo>=</mo><mn>1</mn></mrow><annotation encoding="application/x-tex">\pi((a_{1},a_{1})|s_{1})=1</annotation></semantics></math>, and plays the same as the expert on the other states.</span></p>
</div>
<div id="A2.SS3.p7" class="ltx_para ltx_noindent">
<p id="A2.SS3.p7.1" class="ltx_p"><span id="A2.SS3.p7.1.1" class="ltx_text">In this case <math id="A2.SS3.p7.m1" class="ltx_Math" alttext="\rho_{\pi}=\rho_{\pi^{E}}" display="inline" intent=":literal"><semantics><mrow><msub><mi>ρ</mi><mi>π</mi></msub><mo>=</mo><msub><mi>ρ</mi><msup><mi>π</mi><mi>E</mi></msup></msub></mrow><annotation encoding="application/x-tex">\rho_{\pi}=\rho_{\pi^{E}}</annotation></semantics></math> but</span></p>
<table id="A2.Ex22" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="A2.Ex22.m1" class="ltx_Math" alttext="\operatorname{NashGap}(\pi)\geq V_{1}^{\pi^{\prime}_{1},\pi_{2}}(s_{0})-V_{1}^{\pi}(s_{0})=\frac{1}{1-\gamma}-1\geq\Omega\left(\frac{1}{1-\gamma}\right)" display="block" intent=":literal"><semantics><mrow><mrow><mi>NashGap</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>π</mi><mo stretchy="false">)</mo></mrow></mrow><mo>≥</mo><mrow><mrow><msubsup><mi>V</mi><mn>1</mn><mrow><msubsup><mi>π</mi><mn>1</mn><mo>′</mo></msubsup><mo>,</mo><msub><mi>π</mi><mn>2</mn></msub></mrow></msubsup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mi>s</mi><mn>0</mn></msub><mo stretchy="false">)</mo></mrow></mrow><mo>−</mo><mrow><msubsup><mi>V</mi><mn>1</mn><mi>π</mi></msubsup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mi>s</mi><mn>0</mn></msub><mo stretchy="false">)</mo></mrow></mrow></mrow><mo>=</mo><mrow><mfrac><mn>1</mn><mrow><mn>1</mn><mo>−</mo><mi>γ</mi></mrow></mfrac><mo>−</mo><mn>1</mn></mrow><mo>≥</mo><mrow><mi mathvariant="normal">Ω</mi><mo>⁡</mo><mrow><mo>(</mo><mfrac><mn>1</mn><mrow><mn>1</mn><mo>−</mo><mi>γ</mi></mrow></mfrac><mo>)</mo></mrow></mrow></mrow><annotation encoding="application/x-tex">\operatorname{NashGap}(\pi)\geq V_{1}^{\pi^{\prime}_{1},\pi_{2}}(s_{0})-V_{1}^{\pi}(s_{0})=\frac{1}{1-\gamma}-1\geq\Omega\left(\frac{1}{1-\gamma}\right)</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="A2.SS3.p7.2" class="ltx_p"><span id="A2.SS3.p7.2.1" class="ltx_text">where</span></p>
<table id="A2.Ex23" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="A2.Ex23.m1" class="ltx_Math" alttext="\pi^{\prime}_{1}(a^{1}|s)=\begin{cases}1&amp;\text{if }a^{1}=a_{2}\text{ and }s\in\{s_{0},s_{1}\}\\
0&amp;\text{if }a^{1}\neq a_{2}\text{ and }s\in\{s_{0},s_{1}\}\\
\pi_{1}(a^{1}|s)&amp;\text{otherwise}\end{cases}" display="block" intent=":literal"><semantics><mrow><mrow><msubsup><mi>π</mi><mn>1</mn><mo>′</mo></msubsup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msup><mi>a</mi><mn>1</mn></msup><mo lspace="0em" rspace="0em">|</mo><mi>s</mi><mo stretchy="false">)</mo></mrow></mrow><mo>=</mo><mrow><mo>{</mo><mtable columnspacing="5pt" displaystyle="true" rowspacing="0pt"><mtr><mtd class="ltx_align_left" columnalign="left"><mn>1</mn></mtd><mtd class="ltx_align_left" columnalign="left"><mrow><mrow><mtext>if </mtext><mo lspace="0em" rspace="0em">​</mo><msup><mi>a</mi><mn>1</mn></msup></mrow><mo>=</mo><mrow><msub><mi>a</mi><mn>2</mn></msub><mo lspace="0em" rspace="0em">​</mo><mtext> and </mtext><mo lspace="0em" rspace="0em">​</mo><mi>s</mi></mrow><mo>∈</mo><mrow><mo stretchy="false">{</mo><msub><mi>s</mi><mn>0</mn></msub><mo>,</mo><msub><mi>s</mi><mn>1</mn></msub><mo stretchy="false">}</mo></mrow></mrow></mtd></mtr><mtr><mtd class="ltx_align_left" columnalign="left"><mn>0</mn></mtd><mtd class="ltx_align_left" columnalign="left"><mrow><mrow><mtext>if </mtext><mo lspace="0em" rspace="0em">​</mo><msup><mi>a</mi><mn>1</mn></msup></mrow><mo>≠</mo><mrow><msub><mi>a</mi><mn>2</mn></msub><mo lspace="0em" rspace="0em">​</mo><mtext> and </mtext><mo lspace="0em" rspace="0em">​</mo><mi>s</mi></mrow><mo>∈</mo><mrow><mo stretchy="false">{</mo><msub><mi>s</mi><mn>0</mn></msub><mo>,</mo><msub><mi>s</mi><mn>1</mn></msub><mo stretchy="false">}</mo></mrow></mrow></mtd></mtr><mtr><mtd class="ltx_align_left" columnalign="left"><mrow><msub><mi>π</mi><mn>1</mn></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msup><mi>a</mi><mn>1</mn></msup><mo lspace="0em" rspace="0em">|</mo><mi>s</mi><mo stretchy="false">)</mo></mrow></mrow></mtd><mtd class="ltx_align_left" columnalign="left"><mtext>otherwise</mtext></mtd></mtr></mtable></mrow></mrow><annotation encoding="application/x-tex">\pi^{\prime}_{1}(a^{1}|s)=\begin{cases}1&amp;\text{if }a^{1}=a_{2}\text{ and }s\in\{s_{0},s_{1}\}\\
0&amp;\text{if }a^{1}\neq a_{2}\text{ and }s\in\{s_{0},s_{1}\}\\
\pi_{1}(a^{1}|s)&amp;\text{otherwise}\end{cases}</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="A2.SS3.p7.3" class="ltx_p"><span id="A2.SS3.p7.3.1" class="ltx_text">∎</span></p>
</div>
</div>
</section>
<section id="A2.SS4" class="ltx_subsection">
<h3 class="ltx_title ltx_title_subsection"><span class="ltx_tag ltx_tag_subsection">B.4 </span>Proof of Theorem <a href="#Thmtheorem3" title="Theorem 3. ‣ 5 On the Infeasibility of Tractable Lower Bounds for Exploitability ‣ Matching Multiple Experts: On the Exploitability of Multi-Agent Imitation Learning" class="ltx_ref"><span class="ltx_text ltx_ref_tag">3</span></a></h3>

<div id="A2.SS4.p1" class="ltx_para ltx_noindent">
<p id="A2.SS4.p1.1" class="ltx_p">See <a href="#Thmtheorem3" title="Theorem 3. ‣ 5 On the Infeasibility of Tractable Lower Bounds for Exploitability ‣ Matching Multiple Experts: On the Exploitability of Multi-Agent Imitation Learning" class="ltx_ref"><span class="ltx_text ltx_ref_tag">3</span></a></p>
</div>
<div id="A2.SS4.p2" class="ltx_para ltx_noindent">
<p id="A2.SS4.p2.1" class="ltx_p">Before proving Theorem <a href="#Thmtheorem3" title="Theorem 3. ‣ 5 On the Infeasibility of Tractable Lower Bounds for Exploitability ‣ Matching Multiple Experts: On the Exploitability of Multi-Agent Imitation Learning" class="ltx_ref"><span class="ltx_text ltx_ref_tag">3</span></a>, let us prove the following intermediary lemma. This will allow us to conclude by doing a reduction to the problem of finding an <math id="A2.SS4.p2.m1" class="ltx_Math" alttext="\epsilon" display="inline" intent=":literal"><semantics><mi>ϵ</mi><annotation encoding="application/x-tex">\epsilon</annotation></semantics></math>-Nash equilibrium.</p>
</div>
<div id="Thmlemma5" class="ltx_theorem ltx_theorem_lemma">
<h6 class="ltx_title ltx_runin ltx_title_theorem"><span class="ltx_tag ltx_tag_theorem"><span id="Thmlemma5.2" class="ltx_text ltx_font_bold">Lemma 5</span></span><span id="Thmlemma5.3" class="ltx_text ltx_font_bold">.</span></h6>
<div id="Thmlemma5.p1" class="ltx_para">
<p id="Thmlemma5.p1.1" class="ltx_p"><span id="Thmlemma5.p1.1.1" class="ltx_text ltx_font_italic">Finding an <math id="Thmlemma5.p1.m1" class="ltx_Math" alttext="\epsilon" display="inline" intent=":literal"><semantics><mi>ϵ</mi><annotation encoding="application/x-tex">\epsilon</annotation></semantics></math>-Nash equilibrium support in a general bimatrix game is PPAD-complete.</span></p>
</div>
</div>
<section id="A2.SS4.SSS1" class="ltx_subsubsection">
<h4 class="ltx_title ltx_title_subsubsection"><span class="ltx_tag ltx_tag_subsubsection">B.4.1 </span>Proof of Lemma <a href="#Thmlemma5" title="Lemma 5. ‣ B.4 Proof of Theorem ‣ Appendix B Proofs of hardness results ‣ Matching Multiple Experts: On the Exploitability of Multi-Agent Imitation Learning" class="ltx_ref"><span class="ltx_text ltx_ref_tag">5</span></a></h4>

<div id="A2.SS4.SSS1.p1" class="ltx_para ltx_noindent">
<p id="A2.SS4.SSS1.p1.1" class="ltx_p">Before proving Theorem <a href="#Thmlemma5" title="Lemma 5. ‣ B.4 Proof of Theorem ‣ Appendix B Proofs of hardness results ‣ Matching Multiple Experts: On the Exploitability of Multi-Agent Imitation Learning" class="ltx_ref"><span class="ltx_text ltx_ref_tag">5</span></a>, we introduce below a simpler version for exact Nash equilibria.</p>
</div>
<div id="Thmtheorem4" class="ltx_theorem ltx_theorem_theorem">
<h6 class="ltx_title ltx_runin ltx_title_theorem"><span class="ltx_tag ltx_tag_theorem"><span id="Thmtheorem4.2" class="ltx_text ltx_font_bold">Theorem 4</span></span><span id="Thmtheorem4.3" class="ltx_text ltx_font_bold">.</span></h6>
<div id="Thmtheorem4.p1" class="ltx_para">
<p id="Thmtheorem4.p1.1" class="ltx_p"><span id="Thmtheorem4.p1.1.1" class="ltx_text ltx_font_italic">Finding the support of any Nash equilibrium in a bimatrix game is PPAD-complete.</span></p>
</div>
</div>
<div id="A2.SS4.SSS1.2" class="ltx_proof">
<h6 class="ltx_title ltx_runin ltx_font_italic ltx_title_proof">Proof.</h6>
<div id="A2.SS4.SSS1.p2" class="ltx_para ltx_noindent">
<p id="A2.SS4.SSS1.p2.1" class="ltx_p"><span id="A2.SS4.SSS1.p2.1.1" class="ltx_text">We prove this by a polynomial reduction from the problem of finding the equilibrium in a bimatrix game to the problem of finding its support. The other direction is trivial.</span></p>
</div>
<div id="A2.SS4.SSS1.p3" class="ltx_para ltx_noindent">
<p id="A2.SS4.SSS1.p3.1" class="ltx_p"><span id="A2.SS4.SSS1.p3.1.1" class="ltx_text">Let <math id="A2.SS4.SSS1.p3.m1" class="ltx_Math" alttext="\mathcal{G}=(A_{1},A_{2})" display="inline" intent=":literal"><semantics><mrow><mi class="ltx_font_mathcaligraphic">𝒢</mi><mo>=</mo><mrow><mo stretchy="false">(</mo><msub><mi>A</mi><mn>1</mn></msub><mo>,</mo><msub><mi>A</mi><mn>2</mn></msub><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">\mathcal{G}=(A_{1},A_{2})</annotation></semantics></math> be a bimatrix game with payoff matrices <math id="A2.SS4.SSS1.p3.m2" class="ltx_Math" alttext="A_{i}" display="inline" intent=":literal"><semantics><msub><mi>A</mi><mi>i</mi></msub><annotation encoding="application/x-tex">A_{i}</annotation></semantics></math> for each player <math id="A2.SS4.SSS1.p3.m3" class="ltx_Math" alttext="i\in\{1,2\}" display="inline" intent=":literal"><semantics><mrow><mi>i</mi><mo>∈</mo><mrow><mo stretchy="false">{</mo><mrow><mn>1</mn><mo>,</mo><mn>2</mn></mrow><mo stretchy="false">}</mo></mrow></mrow><annotation encoding="application/x-tex">i\in\{1,2\}</annotation></semantics></math>. For simplicity we further assume that <math id="A2.SS4.SSS1.p3.m4" class="ltx_Math" alttext="A_{1},A_{2}\in\mathbb{R}^{n\times n}" display="inline" intent=":literal"><semantics><mrow><msub><mi>A</mi><mn>1</mn></msub><mo>,</mo><mrow><msub><mi>A</mi><mn>2</mn></msub><mo>∈</mo><msup><mi>ℝ</mi><mrow><mi>n</mi><mo lspace="0.222em" rspace="0.222em">×</mo><mi>n</mi></mrow></msup></mrow></mrow><annotation encoding="application/x-tex">A_{1},A_{2}\in\mathbb{R}^{n\times n}</annotation></semantics></math> (i.e. both players have the same number of actions <math id="A2.SS4.SSS1.p3.m5" class="ltx_Math" alttext="n" display="inline" intent=":literal"><semantics><mi>n</mi><annotation encoding="application/x-tex">n</annotation></semantics></math>).</span></p>
</div>
<div id="A2.SS4.SSS1.p4" class="ltx_para ltx_noindent">
<p id="A2.SS4.SSS1.p4.1" class="ltx_p"><span id="A2.SS4.SSS1.p4.1.1" class="ltx_text">Let <math id="A2.SS4.SSS1.p4.m1" class="ltx_Math" alttext="\pi_{1},\pi_{2}" display="inline" intent=":literal"><semantics><mrow><msub><mi>π</mi><mn>1</mn></msub><mo>,</mo><msub><mi>π</mi><mn>2</mn></msub></mrow><annotation encoding="application/x-tex">\pi_{1},\pi_{2}</annotation></semantics></math> the unknown policies at equilibrium of our game, with respective supports <math id="A2.SS4.SSS1.p4.m2" class="ltx_Math" alttext="\nu_{1},\nu_{2}\subseteq\{1,\dots,n\}" display="inline" intent=":literal"><semantics><mrow><msub><mi>ν</mi><mn>1</mn></msub><mo>,</mo><mrow><msub><mi>ν</mi><mn>2</mn></msub><mo>⊆</mo><mrow><mo stretchy="false">{</mo><mn>1</mn><mo>,</mo><mi mathvariant="normal">…</mi><mo>,</mo><mi>n</mi><mo stretchy="false">}</mo></mrow></mrow></mrow><annotation encoding="application/x-tex">\nu_{1},\nu_{2}\subseteq\{1,\dots,n\}</annotation></semantics></math>. Using our support finding oracle, we compute <math id="A2.SS4.SSS1.p4.m3" class="ltx_Math" alttext="\nu_{1},\nu_{2}" display="inline" intent=":literal"><semantics><mrow><msub><mi>ν</mi><mn>1</mn></msub><mo>,</mo><msub><mi>ν</mi><mn>2</mn></msub></mrow><annotation encoding="application/x-tex">\nu_{1},\nu_{2}</annotation></semantics></math> from the payoff matrices.</span></p>
</div>
<div id="A2.SS4.SSS1.p5" class="ltx_para ltx_noindent">
<p id="A2.SS4.SSS1.p5.1" class="ltx_p"><span id="A2.SS4.SSS1.p5.1.1" class="ltx_text">We note that from the definition of a Nash equilibrium, <math id="A2.SS4.SSS1.p5.m1" class="ltx_Math" alttext="\pi_{1}" display="inline" intent=":literal"><semantics><msub><mi>π</mi><mn>1</mn></msub><annotation encoding="application/x-tex">\pi_{1}</annotation></semantics></math> is a best-response of player 1 to player 2 having policy <math id="A2.SS4.SSS1.p5.m2" class="ltx_Math" alttext="\pi_{2}" display="inline" intent=":literal"><semantics><msub><mi>π</mi><mn>2</mn></msub><annotation encoding="application/x-tex">\pi_{2}</annotation></semantics></math>. This means:</span></p>
<table id="A2.Ex24" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="A2.Ex24.m1" class="ltx_Math" alttext="\pi_{1}^{\top}A_{1}\pi_{2}=\max_{i}{A_{1,i}}^{\top}\pi_{2}\implies{A_{1,j}}^{\top}\pi_{2}={A_{1,k}}^{\top}\pi_{2}\ \forall j,k\in\nu_{1}," display="block" intent=":literal"><semantics><mrow><mrow><mrow><mrow><msubsup><mi>π</mi><mn>1</mn><mo>⊤</mo></msubsup><mo lspace="0em" rspace="0em">​</mo><msub><mi>A</mi><mn>1</mn></msub><mo lspace="0em" rspace="0em">​</mo><msub><mi>π</mi><mn>2</mn></msub></mrow><mo>=</mo><mrow><mrow><munder><mi>max</mi><mi>i</mi></munder><mo lspace="0.167em">⁡</mo><mmultiscripts><mi>A</mi><mrow><mn>1</mn><mo>,</mo><mi>i</mi></mrow><mrow></mrow><mrow></mrow><mo>⊤</mo></mmultiscripts></mrow><mo lspace="0em" rspace="0em">​</mo><msub><mi>π</mi><mn>2</mn></msub></mrow><mo stretchy="false">⟹</mo><mrow><mmultiscripts><mi>A</mi><mrow><mn>1</mn><mo>,</mo><mi>j</mi></mrow><mrow></mrow><mrow></mrow><mo>⊤</mo></mmultiscripts><mo lspace="0em" rspace="0em">​</mo><msub><mi>π</mi><mn>2</mn></msub></mrow><mo>=</mo><mrow><mmultiscripts><mi>A</mi><mrow><mn>1</mn><mo>,</mo><mi>k</mi></mrow><mrow></mrow><mrow></mrow><mo>⊤</mo></mmultiscripts><mo lspace="0em" rspace="0em">​</mo><msub><mi>π</mi><mn>2</mn></msub><mo lspace="0.167em" rspace="0em">​</mo><mrow><mo rspace="0.167em">∀</mo><mi>j</mi></mrow></mrow></mrow><mo>,</mo><mrow><mi>k</mi><mo>∈</mo><msub><mi>ν</mi><mn>1</mn></msub></mrow></mrow><mo>,</mo></mrow><annotation encoding="application/x-tex">\pi_{1}^{\top}A_{1}\pi_{2}=\max_{i}{A_{1,i}}^{\top}\pi_{2}\implies{A_{1,j}}^{\top}\pi_{2}={A_{1,k}}^{\top}\pi_{2}\ \forall j,k\in\nu_{1},</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
</div>
<div id="A2.SS4.SSS1.p6" class="ltx_para ltx_noindent">
<p id="A2.SS4.SSS1.p6.1" class="ltx_p"><span id="A2.SS4.SSS1.p6.1.1" class="ltx_text">and a similar argument holds for <math id="A2.SS4.SSS1.p6.m1" class="ltx_Math" alttext="\pi_{2}" display="inline" intent=":literal"><semantics><msub><mi>π</mi><mn>2</mn></msub><annotation encoding="application/x-tex">\pi_{2}</annotation></semantics></math>, this is known as the indifference principle.</span></p>
</div>
<div id="A2.SS4.SSS1.p7" class="ltx_para ltx_noindent">
<p id="A2.SS4.SSS1.p7.1" class="ltx_p"><span id="A2.SS4.SSS1.p7.1.1" class="ltx_text">Using this, we can rewrite the problem of finding a Nash equilibrium as follows:</span></p>
<table id="A2.Ex25" class="ltx_equationgroup ltx_eqn_table">

<tbody id="A2.Ex25X"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_align_right ltx_eqn_cell"><math id="A2.Ex25X.m2" class="ltx_Math" alttext="\displaystyle\textrm{Find}" display="inline" intent=":literal"><semantics><mtext>Find</mtext><annotation encoding="application/x-tex">\displaystyle\textrm{Find}</annotation></semantics></math></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A2.Ex25X.m3" class="ltx_Math" alttext="\displaystyle x\in\mathbb{R}^{|\nu_{1}|},\ y\in\mathbb{R}^{|\nu_{2}|}" display="inline" intent=":literal"><semantics><mrow><mrow><mi>x</mi><mo>∈</mo><msup><mi>ℝ</mi><mrow><mo stretchy="false">|</mo><msub><mi>ν</mi><mn>1</mn></msub><mo stretchy="false">|</mo></mrow></msup></mrow><mo rspace="0.667em">,</mo><mrow><mi>y</mi><mo>∈</mo><msup><mi>ℝ</mi><mrow><mo stretchy="false">|</mo><msub><mi>ν</mi><mn>2</mn></msub><mo stretchy="false">|</mo></mrow></msup></mrow></mrow><annotation encoding="application/x-tex">\displaystyle x\in\mathbb{R}^{|\nu_{1}|},\ y\in\mathbb{R}^{|\nu_{2}|}</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
<tbody id="A2.Ex25Xa"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_align_right ltx_eqn_cell"><math id="A2.Ex25Xa.m2" class="ltx_Math" alttext="\displaystyle\textrm{s.t.}" display="inline" intent=":literal"><semantics><mtext>s.t.</mtext><annotation encoding="application/x-tex">\displaystyle\textrm{s.t.}</annotation></semantics></math></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A2.Ex25Xa.m3" class="ltx_Math" alttext="\displaystyle\sum_{i=1}^{|\nu_{1}|}x_{i}=\sum_{i=1}^{|\nu_{2}|}y_{i}=1" display="inline" intent=":literal"><semantics><mrow><mrow><mstyle displaystyle="true"><munderover><mo movablelimits="false">∑</mo><mrow><mi>i</mi><mo>=</mo><mn>1</mn></mrow><mrow><mo stretchy="false">|</mo><msub><mi>ν</mi><mn>1</mn></msub><mo stretchy="false">|</mo></mrow></munderover></mstyle><msub><mi>x</mi><mi>i</mi></msub></mrow><mo>=</mo><mrow><mstyle displaystyle="true"><munderover><mo movablelimits="false">∑</mo><mrow><mi>i</mi><mo>=</mo><mn>1</mn></mrow><mrow><mo stretchy="false">|</mo><msub><mi>ν</mi><mn>2</mn></msub><mo stretchy="false">|</mo></mrow></munderover></mstyle><msub><mi>y</mi><mi>i</mi></msub></mrow><mo>=</mo><mn>1</mn></mrow><annotation encoding="application/x-tex">\displaystyle\sum_{i=1}^{|\nu_{1}|}x_{i}=\sum_{i=1}^{|\nu_{2}|}y_{i}=1</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
<tbody id="A2.Ex25Xb"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_eqn_cell"></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A2.Ex25Xb.m2" class="ltx_Math" alttext="\displaystyle(A_{2,j}-A_{2,k})^{\top}x=0\quad\forall j,k\in\nu_{2}" display="inline" intent=":literal"><semantics><mrow><mrow><mrow><msup><mrow><mo stretchy="false">(</mo><mrow><msub><mi>A</mi><mrow><mn>2</mn><mo>,</mo><mi>j</mi></mrow></msub><mo>−</mo><msub><mi>A</mi><mrow><mn>2</mn><mo>,</mo><mi>k</mi></mrow></msub></mrow><mo stretchy="false">)</mo></mrow><mo>⊤</mo></msup><mo lspace="0em" rspace="0em">​</mo><mi>x</mi></mrow><mo>=</mo><mn>0</mn></mrow><mspace style="width:1.167em;" width="1.167em"></mspace><mrow><mo rspace="0.167em">∀</mo><mi>j</mi></mrow><mo>,</mo><mrow><mi>k</mi><mo>∈</mo><msub><mi>ν</mi><mn>2</mn></msub></mrow></mrow><annotation encoding="application/x-tex">\displaystyle(A_{2,j}-A_{2,k})^{\top}x=0\quad\forall j,k\in\nu_{2}</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
<tbody id="A2.Ex25Xc"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_eqn_cell"></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A2.Ex25Xc.m2" class="ltx_Math" alttext="\displaystyle(A_{1,j}-A_{1,k})^{\top}y=0\quad\forall j,k\in\nu_{1}" display="inline" intent=":literal"><semantics><mrow><mrow><mrow><msup><mrow><mo stretchy="false">(</mo><mrow><msub><mi>A</mi><mrow><mn>1</mn><mo>,</mo><mi>j</mi></mrow></msub><mo>−</mo><msub><mi>A</mi><mrow><mn>1</mn><mo>,</mo><mi>k</mi></mrow></msub></mrow><mo stretchy="false">)</mo></mrow><mo>⊤</mo></msup><mo lspace="0em" rspace="0em">​</mo><mi>y</mi></mrow><mo>=</mo><mn>0</mn></mrow><mspace style="width:1.167em;" width="1.167em"></mspace><mrow><mo rspace="0.167em">∀</mo><mi>j</mi></mrow><mo>,</mo><mrow><mi>k</mi><mo>∈</mo><msub><mi>ν</mi><mn>1</mn></msub></mrow></mrow><annotation encoding="application/x-tex">\displaystyle(A_{1,j}-A_{1,k})^{\top}y=0\quad\forall j,k\in\nu_{1}</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
<tbody id="A2.Ex25Xd"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_eqn_cell"></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A2.Ex25Xd.m2" class="ltx_Math" alttext="\displaystyle x_{i}\geq 0\quad\forall i\in\nu_{1}" display="inline" intent=":literal"><semantics><mrow><mrow><msub><mi>x</mi><mi>i</mi></msub><mo>≥</mo><mn>0</mn></mrow><mspace style="width:1.167em;" width="1.167em"></mspace><mrow><mrow><mo rspace="0.167em">∀</mo><mi>i</mi></mrow><mo>∈</mo><msub><mi>ν</mi><mn>1</mn></msub></mrow></mrow><annotation encoding="application/x-tex">\displaystyle x_{i}\geq 0\quad\forall i\in\nu_{1}</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
<tbody id="A2.Ex25Xe"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_eqn_cell"></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A2.Ex25Xe.m2" class="ltx_Math" alttext="\displaystyle y_{i}\geq 0\quad\forall i\in\nu_{2}" display="inline" intent=":literal"><semantics><mrow><mrow><msub><mi>y</mi><mi>i</mi></msub><mo>≥</mo><mn>0</mn></mrow><mspace style="width:1.167em;" width="1.167em"></mspace><mrow><mrow><mo rspace="0.167em">∀</mo><mi>i</mi></mrow><mo>∈</mo><msub><mi>ν</mi><mn>2</mn></msub></mrow></mrow><annotation encoding="application/x-tex">\displaystyle y_{i}\geq 0\quad\forall i\in\nu_{2}</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
</div>
<div id="A2.SS4.SSS1.p8" class="ltx_para ltx_noindent">
<p id="A2.SS4.SSS1.p8.1" class="ltx_p"><span id="A2.SS4.SSS1.p8.1.1" class="ltx_text">This is a linear program that can be solved in polynomial time. By solving this optimization problem we recover <math id="A2.SS4.SSS1.p8.m1" class="ltx_Math" alttext="\pi_{1}=x" display="inline" intent=":literal"><semantics><mrow><msub><mi>π</mi><mn>1</mn></msub><mo>=</mo><mi>x</mi></mrow><annotation encoding="application/x-tex">\pi_{1}=x</annotation></semantics></math> and <math id="A2.SS4.SSS1.p8.m2" class="ltx_Math" alttext="\pi_{2}=y" display="inline" intent=":literal"><semantics><mrow><msub><mi>π</mi><mn>2</mn></msub><mo>=</mo><mi>y</mi></mrow><annotation encoding="application/x-tex">\pi_{2}=y</annotation></semantics></math> (see also Algorithm 3.4 in <cite class="ltx_cite ltx_citemacro_citet"><a href="#bib.bib42" title="" class="ltx_ref">von Stengel ()</a></cite>), which is valid with our assumptions of equilibrium supports <math id="A2.SS4.SSS1.p8.m3" class="ltx_Math" alttext="\nu_{1},\nu_{2}" display="inline" intent=":literal"><semantics><mrow><msub><mi>ν</mi><mn>1</mn></msub><mo>,</mo><msub><mi>ν</mi><mn>2</mn></msub></mrow><annotation encoding="application/x-tex">\nu_{1},\nu_{2}</annotation></semantics></math>.</span></p>
</div>
<div id="A2.SS4.SSS1.p9" class="ltx_para">
<p id="A2.SS4.SSS1.p9.1" class="ltx_p"><span id="A2.SS4.SSS1.p9.1.1" class="ltx_text">However, as shown in <cite class="ltx_cite ltx_citemacro_citet"><a href="#bib.bib8" title="" class="ltx_ref">Chen et al. (2009)</a></cite>, finding an equilibrium of a bimatrix game is PPAD-complete. This concludes our proof by showing that finding the support of a Nash equilibrium in general bimatrix games is PPAD-complete.
∎</span></p>
</div>
</div>
<div id="A2.SS4.SSS1.p10" class="ltx_para ltx_noindent">
<p id="A2.SS4.SSS1.p10.1" class="ltx_p">Using similar arguments, we argue that the theorem also holds for epsilon Nash equilibria with the following proof.</p>
</div>
<div id="A2.SS4.SSS1.3" class="ltx_proof">
<h6 class="ltx_title ltx_runin ltx_font_italic ltx_title_proof">Proof of Lemma <a href="#Thmlemma5" title="Lemma 5. ‣ B.4 Proof of Theorem ‣ Appendix B Proofs of hardness results ‣ Matching Multiple Experts: On the Exploitability of Multi-Agent Imitation Learning" class="ltx_ref"><span class="ltx_text ltx_ref_tag">5</span></a>.</h6>
<div id="A2.SS4.SSS1.p11" class="ltx_para ltx_noindent">
<p id="A2.SS4.SSS1.p11.1" class="ltx_p"><span id="A2.SS4.SSS1.p11.1.1" class="ltx_text">The proof follows by adapting the linear program used in the proof of Theorem <a href="#Thmtheorem4" title="Theorem 4. ‣ B.4.1 Proof of Lemma ‣ B.4 Proof of Theorem ‣ Appendix B Proofs of hardness results ‣ Matching Multiple Experts: On the Exploitability of Multi-Agent Imitation Learning" class="ltx_ref"><span class="ltx_text ltx_ref_tag">4</span></a>, replacing the equality constraints due to the indifference principle by two inequality constraints allowing some slackness of magnitude less <math id="A2.SS4.SSS1.p11.m1" class="ltx_Math" alttext="\epsilon" display="inline" intent=":literal"><semantics><mi>ϵ</mi><annotation encoding="application/x-tex">\epsilon</annotation></semantics></math> as follows</span></p>
</div>
<div id="A2.SS4.SSS1.p12" class="ltx_para ltx_noindent">
<table id="A2.Ex26" class="ltx_equationgroup ltx_eqn_table">

<tbody id="A2.Ex26X"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_align_right ltx_eqn_cell"><math id="A2.Ex26X.m2" class="ltx_Math" alttext="\displaystyle\textrm{Find}" display="inline" intent=":literal"><semantics><mtext>Find</mtext><annotation encoding="application/x-tex">\displaystyle\textrm{Find}</annotation></semantics></math></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A2.Ex26X.m3" class="ltx_Math" alttext="\displaystyle x\in\mathbb{R}^{|\nu_{1}|},\ y\in\mathbb{R}^{|\nu_{2}|}" display="inline" intent=":literal"><semantics><mrow><mrow><mi>x</mi><mo>∈</mo><msup><mi>ℝ</mi><mrow><mo stretchy="false">|</mo><msub><mi>ν</mi><mn>1</mn></msub><mo stretchy="false">|</mo></mrow></msup></mrow><mo rspace="0.667em">,</mo><mrow><mi>y</mi><mo>∈</mo><msup><mi>ℝ</mi><mrow><mo stretchy="false">|</mo><msub><mi>ν</mi><mn>2</mn></msub><mo stretchy="false">|</mo></mrow></msup></mrow></mrow><annotation encoding="application/x-tex">\displaystyle x\in\mathbb{R}^{|\nu_{1}|},\ y\in\mathbb{R}^{|\nu_{2}|}</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
<tbody id="A2.Ex26Xa"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_align_right ltx_eqn_cell"><math id="A2.Ex26Xa.m2" class="ltx_Math" alttext="\displaystyle\textrm{s.t.}" display="inline" intent=":literal"><semantics><mtext>s.t.</mtext><annotation encoding="application/x-tex">\displaystyle\textrm{s.t.}</annotation></semantics></math></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A2.Ex26Xa.m3" class="ltx_Math" alttext="\displaystyle\sum_{i=1}^{|\nu_{1}|}x_{i}=\sum_{i=1}^{|\nu_{2}|}y_{i}=1" display="inline" intent=":literal"><semantics><mrow><mrow><mstyle displaystyle="true"><munderover><mo movablelimits="false">∑</mo><mrow><mi>i</mi><mo>=</mo><mn>1</mn></mrow><mrow><mo stretchy="false">|</mo><msub><mi>ν</mi><mn>1</mn></msub><mo stretchy="false">|</mo></mrow></munderover></mstyle><msub><mi>x</mi><mi>i</mi></msub></mrow><mo>=</mo><mrow><mstyle displaystyle="true"><munderover><mo movablelimits="false">∑</mo><mrow><mi>i</mi><mo>=</mo><mn>1</mn></mrow><mrow><mo stretchy="false">|</mo><msub><mi>ν</mi><mn>2</mn></msub><mo stretchy="false">|</mo></mrow></munderover></mstyle><msub><mi>y</mi><mi>i</mi></msub></mrow><mo>=</mo><mn>1</mn></mrow><annotation encoding="application/x-tex">\displaystyle\sum_{i=1}^{|\nu_{1}|}x_{i}=\sum_{i=1}^{|\nu_{2}|}y_{i}=1</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
<tbody id="A2.Ex26Xb"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_eqn_cell"></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A2.Ex26Xb.m2" class="ltx_Math" alttext="\displaystyle(A_{2,j}-A_{2,k})^{\top}x\leq\epsilon\quad\forall j,k\in\nu_{2}" display="inline" intent=":literal"><semantics><mrow><mrow><mrow><msup><mrow><mo stretchy="false">(</mo><mrow><msub><mi>A</mi><mrow><mn>2</mn><mo>,</mo><mi>j</mi></mrow></msub><mo>−</mo><msub><mi>A</mi><mrow><mn>2</mn><mo>,</mo><mi>k</mi></mrow></msub></mrow><mo stretchy="false">)</mo></mrow><mo>⊤</mo></msup><mo lspace="0em" rspace="0em">​</mo><mi>x</mi></mrow><mo>≤</mo><mi>ϵ</mi></mrow><mspace style="width:1.167em;" width="1.167em"></mspace><mrow><mo rspace="0.167em">∀</mo><mi>j</mi></mrow><mo>,</mo><mrow><mi>k</mi><mo>∈</mo><msub><mi>ν</mi><mn>2</mn></msub></mrow></mrow><annotation encoding="application/x-tex">\displaystyle(A_{2,j}-A_{2,k})^{\top}x\leq\epsilon\quad\forall j,k\in\nu_{2}</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
<tbody id="A2.Ex26Xc"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_eqn_cell"></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A2.Ex26Xc.m2" class="ltx_Math" alttext="\displaystyle(A_{1,j}-A_{1,k})^{\top}y\leq\epsilon\quad\forall j,k\in\nu_{1}" display="inline" intent=":literal"><semantics><mrow><mrow><mrow><msup><mrow><mo stretchy="false">(</mo><mrow><msub><mi>A</mi><mrow><mn>1</mn><mo>,</mo><mi>j</mi></mrow></msub><mo>−</mo><msub><mi>A</mi><mrow><mn>1</mn><mo>,</mo><mi>k</mi></mrow></msub></mrow><mo stretchy="false">)</mo></mrow><mo>⊤</mo></msup><mo lspace="0em" rspace="0em">​</mo><mi>y</mi></mrow><mo>≤</mo><mi>ϵ</mi></mrow><mspace style="width:1.167em;" width="1.167em"></mspace><mrow><mo rspace="0.167em">∀</mo><mi>j</mi></mrow><mo>,</mo><mrow><mi>k</mi><mo>∈</mo><msub><mi>ν</mi><mn>1</mn></msub></mrow></mrow><annotation encoding="application/x-tex">\displaystyle(A_{1,j}-A_{1,k})^{\top}y\leq\epsilon\quad\forall j,k\in\nu_{1}</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
