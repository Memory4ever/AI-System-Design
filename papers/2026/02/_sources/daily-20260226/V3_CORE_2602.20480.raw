6 L 85.94 0 Z M 85.94 204.36"></path></g><g></g><g style="--ltx-stroke-color:#000000;--ltx-fill-color:#00008B;" fill="#00008B" stroke="#000000"><path d="M 85.94 0 M 85.94 0 L 85.94 213.49 L 92.42 213.49 L 92.42 0 Z M 92.42 213.49"></path></g><g></g><g style="--ltx-stroke-color:#000000;--ltx-fill-color:#00008B;" fill="#00008B" stroke="#000000"><path d="M 92.42 0 M 92.42 0 L 92.42 142.32 L 98.89 142.32 L 98.89 0 Z M 98.89 142.32"></path></g><g></g><g style="--ltx-stroke-color:#000000;--ltx-fill-color:#00008B;" fill="#00008B" stroke="#000000"><path d="M 98.89 0 M 98.89 0 L 98.89 59.3 L 105.36 59.3 L 105.36 0 Z M 105.36 59.3"></path></g><g></g><g style="--ltx-stroke-color:#000000;--ltx-fill-color:#00008B;" fill="#00008B" stroke="#000000"><path d="M 105.36 0 M 105.36 0 L 105.36 24.63 L 111.83 24.63 L 111.83 0 Z M 111.83 24.63"></path></g><g></g><g style="--ltx-stroke-color:#000000;--ltx-fill-color:#00008B;" fill="#00008B" stroke="#000000"><path d="M 111.83 0 M 111.83 0 L 111.83 3.65 L 118.3 3.65 L 118.3 0 Z M 118.3 3.65"></path></g><g></g><g style="--ltx-stroke-color:#000000;--ltx-fill-color:#00008B;" fill="#00008B" stroke="#000000"><path d="M 118.3 0 M 118.3 0 L 118.3 0.91 L 124.78 0.91 L 124.78 0 Z M 124.78 0.91"></path></g><g></g><g stroke-dasharray="3.0pt,3.0pt" stroke-dashoffset="0.0pt"><path style="fill:none" d="M 160.39 0 L 160.39 224.16"></path></g><g></g></g><g style="--ltx-stroke-color:#000000;--ltx-fill-color:#000000;" fill="#000000" stroke="#000000" transform="matrix(1.0 0.0 0.0 1.0 95.4 -38.82)"><foreignObject style="--ltx-fo-width:5.79em;--ltx-fo-height:0.69em;--ltx-fo-depth:0.19em;font-size:10pt;" height="12.3" overflow="visible" transform="matrix(1 0 0 -1 0 9.61)" width="80.18"><span class="ltx_foreignobject_container"><span class="ltx_foreignobject_content"><span id="S4.F10.pic1.1" class="ltx_text">Water Depth</span></span></span></foreignObject></g><g style="--ltx-stroke-color:#000000;--ltx-fill-color:#000000;" fill="#000000" stroke="#000000" transform=