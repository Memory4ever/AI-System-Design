3"><span class="ltx_foreignobject_container"><span class="ltx_foreignobject_content"><span id="S4.F3.sf3.pic1.5" class="ltx_text ltx_font_bold" style="--ltx-fg-color:#FF0000;">SC</span></span></span></foreignObject></g><g style="--ltx-stroke-color:#FF0000;--ltx-fill-color:#FF0000;--ltx-fg-color:#FF0000;" color="#FF0000" fill="#FF0000" stroke="#FF0000" transform="matrix(1.0 0.0 0.0 1.0 247.96 -24.43)"><foreignObject style="--ltx-fg-color:#000000;--ltx-fo-width:2.05em;--ltx-fo-height:0.6em;--ltx-fo-depth:0em;font-size:11.5pt;" color="#000000" height="9.49" overflow="visible" transform="matrix(1 0 0 -1 0 9.49)" width="32.57"><span class="ltx_foreignobject_container"><span class="ltx_foreignobject_content"><span id="S4.F3.sf3.pic1.6" class="ltx_text ltx_font_bold" style="--ltx-fg-color:#FF0000;">USC</span></span></span></foreignObject></g><g style="--ltx-stroke-color:#000000;--ltx-fill-color:#B3B3FF;" fill="#B3B3FF" stroke="#000000" stroke-width="0.8pt"><path d="M 192.91 0 L 179.28 23.62 L 179.28 9.08 L 41.2 9.08 L 41.2 23.62 L 27.56 0 L 41.2 -23.62 L 41.2 -9.08 L 179.28 -9.08 L 179.28 -23.62 Z"></path></g><g style="--ltx-stroke-color:#000000;--ltx-fill-color:#000000;" fill="#000000" stroke="#000000" transform="matrix(1.0 0.0 0.0 1.0 31.19 -4.8)"><foreignObject style="--ltx-fo-width:11.54em;--ltx-fo-height:0.69em;--ltx-fo-depth:0em;font-size:10pt;" height="9.61" overflow="visible" transform="matrix(1 0 0 -1 0 9.61)" width="159.63"><span class="ltx_foreignobject_container"><span class="ltx_foreignobject_content"><span id="S4.F3.sf3.pic1.7" class="ltx_text">Invertible Neural Network</span></span></span></foreignObject></g></g><g stroke-dasharray="3.0pt,3.0pt" stroke-dashoffset="0.0pt" stroke-width="0.8pt"><g style="--ltx-stroke-color:#808080;--ltx-fill-color:#808080;--ltx-fg-color:#808080;" color="#808080" fill="#808080" stroke="#808080"><path style="fill:none" d="M 14.33 35 L 200.18 35"></path></g><g style="--ltx-stroke-color:#808080;--ltx-fill-color:#808080;--ltx-fg-color:#808080;" color="#808080" fill="#808080" stroke="#808080" stroke-dasharray="none" stroke-dashoffset="0.0pt" stroke-linejoin="miter" transform="matrix(1.0 0.0 0.0 1.0 197.01 35)"><path d="M 7.66 0 L 1.79 2.18 L 3.45 0 L 1.79 -2.18 Z"></path></g><g style="--ltx-stroke-color:#808080;--ltx-fill-color:#808080;" fill="#808080" stroke="#808080" transform="matrix(1.0 0.0 0.0 1.0 61.32 42.59)"><foreignObject style="--ltx-fo-width:7.64em;--ltx-fo-height:0.68em;--ltx-fo-depth:0.19em;font-size:9.25pt;" height="11.07" overflow="visible" transform="matrix(1 0 0 -1 0 8.65)" width="97.83"><span class="ltx_foreignobject_container"><span class="ltx_foreignobject_content"><span id="S4.F3.sf3.pic1.8" class="ltx_text" style="font-size:90%;--ltx-fg-color:#808080;">forward modeling</span></span></span></foreignObject></g></g><g stroke-dasharray="3.0pt,3.0pt" stroke-dashoffset="0.0pt" stroke-width="0.8pt"><g style="--ltx-stroke-color:#808080;--ltx-fill-color:#808080;--ltx-fg-color:#808080;" color="#808080" fill="#808080" stroke="#808080"><path style="fill:none" d="M 206.14 -35 L 20.29 -35"></path></g><g style="--ltx-stroke-color:#808080;--ltx-fill-color:#808080;--ltx-fg-color:#808080;" color="#808080" fill="#808080" stroke="#808080" stroke-dasharray="none" stroke-dashoffset="0.0pt" stroke-linejoin="miter" transform="matrix(-1.0 0.0 0.0 -1.0 23.47 -35)"><path d="M 7.66 0 L 1.79 2.18 L 3.45 0 L 1.79 -2.18 Z"></path></g><g style="--ltx-stroke-color:#808080;--ltx-fill-color:#808080;" fill="#808080" stroke="#808080" transform="matrix(1.0 0.0 0.0 1.0 60.92 -48.82)"><foreignObject style="--ltx-fo-width:7.76em;--ltx-fo-height:0.68em;--ltx-fo-depth:0.19em;font-size:9.25pt;" height="11.07" overflow="visible" transform="matrix(1 0 0 -1 0 8.65)" width="99.34"><span class="ltx_foreignobject_container"><span class="ltx_foreignobject_content"><span id="S4.F3.sf3.pic1.9" class="ltx_text" style="font-size:90%;--ltx-fg-color:#808080;">inverse prediction</span></span></span></foreignObject></g></g></g></g></svg></span>
<figcaption class="ltx_caption"><span class="ltx_tag ltx_tag_figure"><span id="S4.F3.sf3.3" class="ltx_text" style="font-size:90%;">(c)</span> </span></figcaption>
</figure></div></div>
<figcaption class="ltx_caption ltx_centering"><span class="ltx_tag ltx_tag_figure"><span id="S4.F3.5" class="ltx_text" style="font-size:90%;">Figure 3</span>: </span><span id="S4.F3.6" class="ltx_text" style="font-size:90%;">Schematic illustration of how different training paradigms are used to solve inverse problems in the Gaussian setting. (a) Bayesian neural network for solving inverse problem. There is supervised cost (SC) between predicted and true <span id="S4.F3.6.1" class="ltx_text ltx_markedasmath ltx_font_bold">x</span>. (b) INN Trained without <math id="S4.F3.m6" class="ltx_Math" alttext="\prescript{p}{}{L_{x}}" display="inline" intent=":literal"><semantics><mmultiscripts><mi>L</mi><mi>x</mi><mrow></mrow><mprescripts></mprescripts><mrow></mrow><mi>p</mi></mmultiscripts><annotation encoding="application/x-tex">\prescript{p}{}{L_{x}}</annotation></semantics></math>. There is unsupervised cost (USC) between predicted and true <span id="S4.F3.6.2" class="ltx_text ltx_markedasmath ltx_font_bold">x</span>. (c) Shows an INN model trained with <math id="S4.F3.m8" class="ltx_Math" alttext="\prescript{p}{}{L_{x}}" display="inline" intent=":literal"><semantics><mmultiscripts><mi>L</mi><mi>x</mi><mrow></mrow><mprescripts></mprescripts><mrow></mrow><mi>p</mi></mmultiscripts><annotation encoding="application/x-tex">\prescript{p}{}{L_{x}}</annotation></semantics></math>, which serves as a reconstruction loss.</span></figcaption>
</figure>
<div id="S4.SS1.SSS1.p6" class="ltx_para">
<p id="S4.SS1.SSS1.p6.1" class="ltx_p">To demonstrate the effect of incorporating a prior objective during training, the prior weight <math id="S4.SS1.SSS1.p6.m1" class="ltx_Math" alttext="\lambda^{\prime}" display="inline" intent=":literal"><semantics><msup><mi>λ</mi><mo>′</mo></msup><annotation encoding="application/x-tex">\lambda^{\prime}</annotation></semantics></math> was set to values of <math id="S4.SS1.SSS1.p6.m2" class="ltx_Math" alttext="0" display="inline" intent=":literal"><semantics><mn>0</mn><annotation encoding="application/x-tex">0</annotation></semantics></math>, <math id="S4.SS1.SSS1.p6.m3" class="ltx_Math" alttext="1" display="inline" intent=":literal"><semantics><mn>1</mn><annotation encoding="application/x-tex">1</annotation></semantics></math>, and <math id="S4.SS1.SSS1.p6.m4" class="ltx_Math" alttext="100" display="inline" intent=":literal"><semantics><mn>100</mn><annotation encoding="application/x-tex">100</annotation></semantics></math>. Figure <a href="#S4.F2" title="Figure 2 ‣ 4.1.1 Effect of prior on training ‣ 4.1 Effect of design choices on training ‣ 4 Empirical Results ‣ VINA: Variational Invertible Neural Architectures" class="ltx_ref"><span class="ltx_text ltx_ref_tag">2</span></a> illustrates the effect of incorporating the prior loss <math id="S4.SS1.SSS1.p6.m5" class="ltx_Math" alttext="{}^{p}L_{x}" display="inline" intent=":literal"><semantics><mmultiscripts><mi>L</mi><mprescripts></mprescripts><mi>x</mi><mrow></mrow><mrow></mrow><mi>p</mi></mmultiscripts><annotation encoding="application/x-tex">{}^{p}L_{x}</annotation></semantics></math> into the training objective. We observe that using a suitable prior, along with a well-chosen prior weight <math id="S4.SS1.SSS1.p6.m6" class="ltx_Math" alttext="\lambda^{\prime}" display="inline" intent=":literal"><semantics><msup><mi>λ</mi><mo>′</mo></msup><annotation encoding="application/x-tex">\lambda^{\prime}</annotation></semantics></math>, leads to more plausible samples. In the context of the inverse kinematics case study, this corresponds to configurations that keep joint angles close to zero, resulting in “straighter” arm trajectories, as shown in Figure <a href="#S4.F2.sf2" title="Figure 2(b) ‣ Figure 2 ‣ 4.1.1 Effect of prior on training ‣ 4.1 Effect of design choices on training ‣ 4 Empirical Results ‣ VINA: Variational Invertible Neural Architectures" class="ltx_ref"><span class="ltx_text ltx_ref_tag">2(b)</span></a>. Since the prior had a mean of <math id="S4.SS1.SSS1.p6.m7" class="ltx_Math" alttext="0" display="inline" intent=":literal"><semantics><mn>0</mn><annotation encoding="application/x-tex">0</annotation></semantics></math> and a small variance, it led to samples that favored configurations where the arm positions were straight, with all joint angles close to <math id="S4.SS1.SSS1.p6.m8" class="ltx_Math" alttext="0" display="inline" intent=":literal"><semantics><mn>0</mn><annotation encoding="application/x-tex">0</annotation></semantics></math> degrees. However, when the assumed prior is incorrect, incorporating it into the training objective leads to
inaccurate joint configurations, as seen in Figure <a href="#S4.F2.sf3" title="Figure 2(c) ‣ Figure 2 ‣ 4.1.1 Effect of prior on training ‣ 4.1 Effect of design choices on training ‣ 4 Empirical Results ‣ VINA: Variational Invertible Neural Architectures" class="ltx_ref"><span class="ltx_text ltx_ref_tag">2(c)</span></a>. Finally, Figure <a href="#S4.F2.sf4" title="Figure 2(d) ‣ Figure 2 ‣ 4.1.1 Effect of prior on training ‣ 4.1 Effect of design choices on training ‣ 4 Empirical Results ‣ VINA: Variational Invertible Neural Architectures" class="ltx_ref"><span class="ltx_text ltx_ref_tag">2(d)</span></a> demonstrates that when the prior weight <math id="S4.SS1.SSS1.p6.m9" class="ltx_Math" alttext="\lambda^{\prime}" display="inline" intent=":literal"><semantics><msup><mi>λ</mi><mo>′</mo></msup><annotation encoding="application/x-tex">\lambda^{\prime}</annotation></semantics></math> is set too high, even with a suitable prior, the prior loss dominates the training, resulting in degraded performance and unrealistic outputs.
Increasing the coefficient for <math id="S4.SS1.SSS1.p6.m10" class="ltx_Math" alttext="\prescript{p}{}{L_{x}}" display="inline" intent=":literal"><semantics><mmultiscripts><mi>L</mi><mi>x</mi><mrow></mrow><mprescripts></mprescripts><mrow></mrow><mi>p</mi></mmultiscripts><annotation encoding="application/x-tex">\prescript{p}{}{L_{x}}</annotation></semantics></math> highlights this effect further.</p>
</div>
<div id="S4.SS1.SSS1.p7" class="ltx_para">
<p id="S4.SS1.SSS1.p7.1" class="ltx_p">We conclude that using prior distribution knowledge in training <abbr title="" class="ltx_glossaryref ltx_missing">INN</abbr> acts as a form of regularization by constraining the estimated posterior to align with known distributions. By incorporating such priors, the model is guided toward more plausible solutions, preventing it from learning overly complex or irrelevant patterns. Essentially, the prior acts as a form of bias that encourages the model to explore a more reasonable subset of possible solutions, leading to robustness in generation tasks.
The designers need to navigate the fine line between Bayesian wisdom and risky assumptions. A well-chosen prior can improve the <abbr title="" class="ltx_glossaryref ltx_missing">INN</abbr> performance by effectively regularizing the model, and poorly chosen priors can dominate the results, leading to biased or misleading conclusions.</p>
</div>
<div id="S4.SS1.SSS1.p8" class="ltx_para">
<p id="S4.SS1.SSS1.p8.1" class="ltx_p">We conclude this section by discussing the reason behind the importance of prior cost on training by focusing on the Gaussian case. Fig. <a href="#S4.F3" title="Figure 3 ‣ 4.1.1 Effect of prior on training ‣ 4.1 Effect of design choices on training ‣ 4 Empirical Results ‣ VINA: Variational Invertible Neural Architectures" class="ltx_ref"><span class="ltx_text ltx_ref_tag">3</span></a> compares the training procedure of  <span title="" class="ltx_glossaryref ltx_missing">BNN</span> (<abbr title="" class="ltx_glossaryref ltx_missing">BNN</abbr>), <abbr title="" class="ltx_glossaryref ltx_missing">INN</abbr>, and <abbr title="" class="ltx_glossaryref ltx_missing">INN</abbr> with prior for solving an inverse problem.
The standard direct formulation in <abbr title="" class="ltx_glossaryref ltx_missing">BNN</abbr> depends on a discriminative supervised loss term on <math id="S4.SS1.SSS1.p8.m1" class="ltx_Math" alttext="X" display="inline" intent=":literal"><semantics><mi>X</mi><annotation encoding="application/x-tex">X</annotation></semantics></math>, which is one motivation for introducing <abbr title="" class="ltx_glossaryref ltx_missing">INN</abbr> for inverse problems <cite class="ltx_cite ltx_citemacro_citep">(<a href="#bib.bib8" title="" class="ltx_ref">Ardizzone et al., 2018</a>)</cite>.
In the case of Gaussian distributions, we have demonstrated that <math id="S4.SS1.SSS1.p8.m2" class="ltx_Math" alttext="\prescript{p}{}{L_{x}}" display="inline" intent=":literal"><semantics><mmultiscripts><mi>L</mi><mi>x</mi><mrow></mrow><mprescripts></mprescripts><mrow></mrow><mi>p</mi></mmultiscripts><annotation encoding="application/x-tex">\prescript{p}{}{L_{x}}</annotation></semantics></math> can serve as an effective regularizer by imposing a supervised cost on <math id="S4.SS1.SSS1.p8.m3" class="ltx_Math" alttext="X" display="inline" intent=":literal"><semantics><mi>X</mi><annotation encoding="application/x-tex">X</annotation></semantics></math>. In this case, as demonstrated in Fig. <a href="#S4.F3.sf3" title="Figure 3(c) ‣ Figure 3 ‣ 4.1.1 Effect of prior on training ‣ 4.1 Effect of design choices on training ‣ 4 Empirical Results ‣ VINA: Variational Invertible Neural Architectures" class="ltx_ref"><span class="ltx_text ltx_ref_tag">3(c)</span></a>,
training with prior propose a hybrid approach applying both supervised and unsupervised costs on <math id="S4.SS1.SSS1.p8.m4" class="ltx_Math" alttext="X" display="inline" intent=":literal"><semantics><mi>X</mi><annotation encoding="application/x-tex">X</annotation></semantics></math>. This approach leverages the regularization with prior to enhance the performance of <abbr title="" class="ltx_glossaryref ltx_missing">INN</abbr>.</p>
</div>
</section>
<section id="S4.SS1.SSS2" class="ltx_subsubsection">
<h4 class="ltx_title ltx_title_subsubsection"><span class="ltx_tag ltx_tag_subsubsection">4.1.2 </span>Comparison of architectures</h4>

<div id="S4.SS1.SSS2.p1" class="ltx_para">
<p id="S4.SS1.SSS2.p1.1" class="ltx_p">This observation compares the performance of <abbr title="" class="ltx_glossaryref ltx_missing">INN</abbr> on an inverse problem using coupling-based and iResNet architectures, trained with different variational f-divergences as loss functions, considering both forward and backward losses.
In general, it is challenging to optimize over all measurable function in the the critic class <math id="S4.SS1.SSS2.p1.m1" class="ltx_Math" alttext="\mathcal{G}" display="inline" intent=":literal"><semantics><mi class="ltx_font_mathcaligraphic">𝒢</mi><annotation encoding="application/x-tex">\mathcal{G}</annotation></semantics></math>, defined in Section <a href="#S3.SS1" title="3.1 Variational () ‣ 3 Main Results ‣ VINA: Variational Invertible Neural Architectures" class="ltx_ref"><span class="ltx_text ltx_ref_tag">3.1</span></a>. Hence, in practice, finite-parameter family of functions are used to approximate the optimal critic function. We adopt the method proposed in <cite class="ltx_cite ltx_citemacro_citet"><a href="#bib.bib40" title="" class="ltx_ref">Nowozin et al. (2016)</a></cite>, to approximate the critic function
by a neural network. In this case, we replace the function <math id="S4.SS1.SSS2.p1.m2" class="ltx_Math" alttext="g" display="inline" intent=":literal"><semantics><mi>g</mi><annotation encoding="application/x-tex">g</annotation></semantics></math> in equation (<a href="#S3.E10" title="Equation 10 ‣ 3.1 Variational () ‣ 3 Main Results ‣ VINA: Variational Invertible Neural Architectures" class="ltx_ref"><span class="ltx_text ltx_ref_tag">10</span></a>) with
<math id="S4.SS1.SSS2.p1.m3" class="ltx_Math" alttext="V_{\omega}(x)=g_{f}(V^{\prime}_{\omega}(x))" display="inline" intent=":literal"><semantics><mrow><mrow><msub><mi>V</mi><mi>ω</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>x</mi><mo stretchy="false">)</mo></mrow></mrow><mo>=</mo><mrow><msub><mi>g</mi><mi>f</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mrow><msubsup><mi>V</mi><mi>ω</mi><mo>′</mo></msubsup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>x</mi><mo stretchy="false">)</mo></mrow></mrow><mo stretchy="false">)</mo></mrow></mrow></mrow><annotation encoding="application/x-tex">V_{\omega}(x)=g_{f}(V^{\prime}_{\omega}(x))</annotation></semantics></math>,
where <math id="S4.SS1.SSS2.p1.m4" class="ltx_Math" alttext="V^{\prime}_{\omega}:\mathcal{X}\to\mathbb{R}" display="inline" intent=":literal"><semantics><mrow><msubsup><mi>V</mi><mi>ω</mi><mo>′</mo></msubsup><mo lspace="0.278em" rspace="0.278em">:</mo><mrow><mi class="ltx_font_mathcaligraphic">𝒳</mi><mo stretchy="false">→</mo><mi>ℝ</mi></mrow></mrow><annotation encoding="application/x-tex">V^{\prime}_{\omega}:\mathcal{X}\to\mathbb{R}</annotation></semantics></math> denotes a neural network with parameters <math id="S4.SS1.SSS2.p1.m5" class="ltx_Math" alttext="\omega" display="inline" intent=":literal"><semantics><mi>ω</mi><annotation encoding="application/x-tex">\omega</annotation></semantics></math>, and <math id="S4.SS1.SSS2.p1.m6" class="ltx_Math" alttext="g_{f}" display="inline" intent=":literal"><semantics><msub><mi>g</mi><mi>f</mi></msub><annotation encoding="application/x-tex">g_{f}</annotation></semantics></math> is a monotonic activation function (mapping into the domain of <math id="S4.SS1.SSS2.p1.m7" class="ltx_Math" alttext="f^{*}" display="inline" intent=":literal"><semantics><msup><mi>f</mi><mo>∗</mo></msup><annotation encoding="application/x-tex">f^{*}</annotation></semantics></math>). Here, <math id="S4.SS1.SSS2.p1.m8" class="ltx_Math" alttext="V^{\prime}_{\omega}" display="inline" intent=":literal"><semantics><msubsup><mi>V</mi><mi>ω</mi><mo>′</mo></msubsup><annotation encoding="application/x-tex">V^{\prime}_{\omega}</annotation></semantics></math> is implemented as a fully connected network with two hidden layers of size 64 with ReLU activations <cite class="ltx_cite ltx_citemacro_citep">(<a href="#bib.bib25" title="" class="ltx_ref">Goodfellow et al., 2016</a>)</cite>. The function <math id="S4.SS1.SSS2.p1.m9" class="ltx_Math" alttext="g_{f}" display="inline" intent=":literal"><semantics><msub><mi>g</mi><mi>f</mi></msub><annotation encoding="application/x-tex">g_{f}</annotation></semantics></math> is determined by the specific choice of the <math id="S4.SS1.SSS2.p1.m10" class="ltx_Math" alttext="f" display="inline" intent=":literal"><semantics><mi>f</mi><annotation encoding="application/x-tex">f</annotation></semantics></math>-divergence <cite class="ltx_cite ltx_citemacro_citep">(<a href="#bib.bib40" title="" class="ltx_ref">Nowozin et al., 2016</a>)</cite>.
For the Kullback–Leibler (KL) divergence, <math id="S4.SS1.SSS2.p1.m11" class="ltx_Math" alttext="g_{f}" display="inline" intent=":literal"><semantics><msub><mi>g</mi><mi>f</mi></msub><annotation encoding="application/x-tex">g_{f}</annotation></semantics></math> employs an identity activation, i.e., <math id="S4.SS1.SSS2.p1.m12" class="ltx_Math" alttext="g_{f}(v)=v" display="inline" intent=":literal"><semantics><mrow><mrow><msub><mi>g</mi><mi>f</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>v</mi><mo stretchy="false">)</mo></mrow></mrow><mo>=</mo><mi>v</mi></mrow><annotation encoding="application/x-tex">g_{f}(v)=v</annotation></semantics></math>. In the case of the Reverse KL divergence, the activation is given by <math id="S4.SS1.SSS2.p1.m13" class="ltx_Math" alttext="g_{f}(v)=-\exp(-v)" display="inline" intent=":literal"><semantics><mrow><mrow><msub><mi>g</mi><mi>f</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>v</mi><mo stretchy="false">)</mo></mrow></mrow><mo>=</mo><mrow><mo rspace="0.167em">−</mo><mrow><mi>exp</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mrow><mo>−</mo><mi>v</mi></mrow><mo stretchy="false">)</mo></mrow></mrow></mrow></mrow><annotation encoding="application/x-tex">g_{f}(v)=-\exp(-v)</annotation></semantics></math>, whereas for the Jensen–Shannon (JS) divergence, the activation takes the form <math id="S4.SS1.SSS2.p1.m14" class="ltx_Math" alttext="g_{f}(v)=\log(2)-\log(1+\exp(-v))" display="inline" intent=":literal"><semantics><mrow><mrow><msub><mi>g</mi><mi>f</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>v</mi><mo stretchy="false">)</mo></mrow></mrow><mo>=</mo><mrow><mrow><mi>log</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mn>2</mn><mo stretchy="false">)</mo></mrow></mrow><mo>−</mo><mrow><mi>log</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mrow><mn>1</mn><mo>+</mo><mrow><mi>exp</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mrow><mo>−</mo><mi>v</mi></mrow><mo stretchy="false">)</mo></mrow></mrow></mrow><mo stretchy="false">)</mo></mrow></mrow></mrow></mrow><annotation encoding="application/x-tex">g_{f}(v)=\log(2)-\log(1+\exp(-v))</annotation></semantics></math>.</p>
</div>
<div id="S4.SS1.SSS2.p2" class="ltx_para">
<p id="S4.SS1.SSS2.p2.1" class="ltx_p">In this numerical study, we consider the <abbr title="" class="ltx_glossaryref ltx_missing">USL</abbr> in both the backward and forward directions. In the backward direction, we wish to minimize <math id="S4.SS1.SSS2.p2.m1" class="ltx_math_unparsed" alttext="D_{f}(P_{T^{-1}(Y,Z)}\parallel P_{X})" display="inline" intent=":literal"><semantics><mrow><msub><mi>D</mi><mi>f</mi></msub><mrow><mo stretchy="false">(</mo><msub><mi>P</mi><mrow><msup><mi>T</mi><mrow><mo>−</mo><mn>1</mn></mrow></msup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>Y</mi><mo>,</mo><mi>Z</mi><mo stretchy="false">)</mo></mrow></mrow></msub><mo lspace="0em" rspace="0.167em">∥</mo><msub><mi>P</mi><mi>X</mi></msub><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">D_{f}(P_{T^{-1}(Y,Z)}\parallel P_{X})</annotation></semantics></math> using the following joint objective function</p>
<table id="S4.E49" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="S4.E49.m1" class="ltx_math_unparsed" alttext="\mathcal{F}(\theta,\omega)=\mathbb{E}[V_{\omega}(T^{-1}_{\theta}(Y,Z)]-\mathbb{E}[f^{*}(V_{\omega}(X))]," display="block" intent=":literal"><semantics><mrow><mi class="ltx_font_mathcaligraphic">ℱ</mi><mrow><mo stretchy="false">(</mo><mi>θ</mi><mo>,</mo><mi>ω</mi><mo stretchy="false">)</mo></mrow><mo>=</mo><mi>𝔼</mi><mrow><mo stretchy="false">[</mo><msub><mi>V</mi><mi>ω</mi></msub><mrow><mo stretchy="false">(</mo><msubsup><mi>T</mi><mi>θ</mi><mrow><mo>−</mo><mn>1</mn></mrow></msubsup><mrow><mo stretchy="false">(</mo><mi>Y</mi><mo>,</mo><mi>Z</mi><mo stretchy="false">)</mo></mrow><mo stretchy="false">]</mo></mrow><mo>−</mo><mi>𝔼</mi><mrow><mo stretchy="false">[</mo><msup><mi>f</mi><mo>∗</mo></msup><mrow><mo stretchy="false">(</mo><msub><mi>V</mi><mi>ω</mi></msub><mrow><mo stretchy="false">(</mo><mi>X</mi><mo stretchy="false">)</mo></mrow><mo stretchy="false">)</mo></mrow><mo stretchy="false">]</mo></mrow><mo>,</mo></mrow></mrow><annotation encoding="application/x-tex">\mathcal{F}(\theta,\omega)=\mathbb{E}[V_{\omega}(T^{-1}_{\theta}(Y,Z)]-\mathbb{E}[f^{*}(V_{\omega}(X))],</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td>
<td rowspan="1" class="ltx_eqn_cell ltx_eqn_eqno ltx_align_middle ltx_align_right"><span class="ltx_tag ltx_tag_equation ltx_align_right">(49)</span></td></tr></tbody>
</table>
<p id="S4.SS1.SSS2.p2.2" class="ltx_p">where <math id="S4.SS1.SSS2.p2.m2" class="ltx_Math" alttext="T^{-1}" display="inline" intent=":literal"><semantics><msup><mi>T</mi><mrow><mo>−</mo><mn>1</mn></mrow></msup><annotation encoding="application/x-tex">T^{-1}</annotation></semantics></math> and <math id="S4.SS1.SSS2.p2.m3" class="ltx_Math" alttext="V" display="inline" intent=":literal"><semantics><mi>V</mi><annotation encoding="application/x-tex">V</annotation></semantics></math> are parametrized by <math id="S4.SS1.SSS2.p2.m4" class="ltx_Math" alttext="\theta" display="inline" intent=":literal"><semantics><mi>θ</mi><annotation encoding="application/x-tex">\theta</annotation></semantics></math> and <math id="S4.SS1.SSS2.p2.m5" class="ltx_Math" alttext="\omega" display="inline" intent=":literal"><semantics><mi>ω</mi><annotation encoding="application/x-tex">\omega</annotation></semantics></math>, respectively. In particular, in this case study, we refer to the following regularized empirical estimation as the <span id="S4.SS1.SSS2.p2.2.1" class="ltx_text ltx_font_italic">backward loss</span></p>
<table id="S4.E50" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="S4.E50.m1" class="ltx_Math" alttext="\mathcal{L}_{\text{backward}}(\theta,\omega)=\frac{1}{N}\sum_{i=1}^{N}V_{\omega}(T^{-1}_{\theta}(Y_{i},Z_{i}))-\frac{1}{N}\sum_{i=1}^{N}f^{*}(V_{\omega}(X_{i}))+\frac{1}{N}\sum_{i=1}^{N}\|T^{-1}_{\theta}(Y_{i},Z_{i})-X_{i}\|^{2}" display="block" intent=":literal"><semantics><mrow><mrow><msub><mi class="ltx_font_mathcaligraphic">ℒ</mi><mtext>backward</mtext></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>θ</mi><mo>,</mo><mi>ω</mi><mo stretchy="false">)</mo></mrow></mrow><mo>=</mo><mrow><mrow><mrow><mfrac><mn>1</mn><mi>N</mi></mfrac><mo lspace="0em" rspace="0em">​</mo><mrow><munderover><mo movablelimits="false">∑</mo><mrow><mi>i</mi><mo>=</mo><mn>1</mn></mrow><mi>N</mi></munderover><mrow><msub><mi>V</mi><mi>ω</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mrow><msubsup><mi>T</mi><mi>θ</mi><mrow><mo>−</mo><mn>1</mn></mrow></msubsup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mi>Y</mi><mi>i</mi></msub><mo>,</mo><msub><mi>Z</mi><mi>i</mi></msub><mo stretchy="false">)</mo></mrow></mrow><mo stretchy="false">)</mo></mrow></mrow></mrow></mrow><mo>−</mo><mrow><mfrac><mn>1</mn><mi>N</mi></mfrac><mo lspace="0em" rspace="0em">​</mo><mrow><munderover><mo movablelimits="false">∑</mo><mrow><mi>i</mi><mo>=</mo><mn>1</mn></mrow><mi>N</mi></munderover><mrow><msup><mi>f</mi><mo>∗</mo></msup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mrow><msub><mi>V</mi><mi>ω</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mi>X</mi><mi>i</mi></msub><mo stretchy="false">)</mo></mrow></mrow><mo stretchy="false">)</mo></mrow></mrow></mrow></mrow></mrow><mo>+</mo><mrow><mfrac><mn>1</mn><mi>N</mi></mfrac><mo lspace="0em" rspace="0em">​</mo><mrow><munderover><mo movablelimits="false" rspace="0em">∑</mo><mrow><mi>i</mi><mo>=</mo><mn>1</mn></mrow><mi>N</mi></munderover><msup><mrow><mo stretchy="false">‖</mo><mrow><mrow><msubsup><mi>T</mi><mi>θ</mi><mrow><mo>−</mo><mn>1</mn></mrow></msubsup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mi>Y</mi><mi>i</mi></msub><mo>,</mo><msub><mi>Z</mi><mi>i</mi></msub><mo stretchy="false">)</mo></mrow></mrow><mo>−</mo><msub><mi>X</mi><mi>i</mi></msub></mrow><mo stretchy="false">‖</mo></mrow><mn>2</mn></msup></mrow></mrow></mrow></mrow><annotation encoding="application/x-tex">\mathcal{L}_{\text{backward}}(\theta,\omega)=\frac{1}{N}\sum_{i=1}^{N}V_{\omega}(T^{-1}_{\theta}(Y_{i},Z_{i}))-\frac{1}{N}\sum_{i=1}^{N}f^{*}(V_{\omega}(X_{i}))+\frac{1}{N}\sum_{i=1}^{N}\|T^{-1}_{\theta}(Y_{i},Z_{i})-X_{i}\|^{2}</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td>
<td rowspan="1" class="ltx_eqn_cell ltx_eqn_eqno ltx_align_middle ltx_align_right"><span class="ltx_tag ltx_tag_equation ltx_align_right">(50)</span></td></tr></tbody>
</table>
<p id="S4.SS1.SSS2.p2.3" class="ltx_p">Similarly, in the forward direction, we wish to minimize <math id="S4.SS1.SSS2.p2.m6" class="ltx_math_unparsed" alttext="D_{f}(P_{Y,Z}\parallel P_{T(X)})" display="inline" intent=":literal"><semantics><mrow><msub><mi>D</mi><mi>f</mi></msub><mrow><mo stretchy="false">(</mo><msub><mi>P</mi><mrow><mi>Y</mi><mo>,</mo><mi>Z</mi></mrow></msub><mo lspace="0em" rspace="0.167em">∥</mo><msub><mi>P</mi><mrow><mi>T</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>X</mi><mo stretchy="false">)</mo></mrow></mrow></msub><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">D_{f}(P_{Y,Z}\parallel P_{T(X)})</annotation></semantics></math>, using the the objective function</p>
<table id="S4.E51" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="S4.E51.m1" class="ltx_Math" alttext="\mathcal{F}(\theta,\omega)=\mathbb{E}[V_{\omega}(Y,Z)]-\mathbb{E}[f^{*}(V_{\omega}(T_{\theta}(X)))]." display="block" intent=":literal"><semantics><mrow><mrow><mrow><mi class="ltx_font_mathcaligraphic">ℱ</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>θ</mi><mo>,</mo><mi>ω</mi><mo stretchy="false">)</mo></mrow></mrow><mo>=</mo><mrow><mrow><mi>𝔼</mi><mo>⁡</mo><mrow><mo stretchy="false">[</mo><mrow><msub><mi>V</mi><mi>ω</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>Y</mi><mo>,</mo><mi>Z</mi><mo stretchy="false">)</mo></mrow></mrow><mo stretchy="false">]</mo></mrow></mrow><mo>−</mo><mrow><mi>𝔼</mi><mo>⁡</mo><mrow><mo stretchy="false">[</mo><mrow><msup><mi>f</mi><mo>∗</mo></msup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mrow><msub><mi>V</mi><mi>ω</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mrow><msub><mi>T</mi><mi>θ</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>X</mi><mo stretchy="false">)</mo></mrow></mrow><mo stretchy="false">)</mo></mrow></mrow><mo stretchy="false">)</mo></mrow></mrow><mo stretchy="false">]</mo></mrow></mrow></mrow></mrow><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">\mathcal{F}(\theta,\omega)=\mathbb{E}[V_{\omega}(Y,Z)]-\mathbb{E}[f^{*}(V_{\omega}(T_{\theta}(X)))].</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td>
<td rowspan="1" class="ltx_eqn_cell ltx_eqn_eqno ltx_align_middle ltx_align_right"><span class="ltx_tag ltx_tag_equation ltx_align_right">(51)</span></td></tr></tbody>
</table>
<p id="S4.SS1.SSS2.p2.4" class="ltx_p">Here, the following empirical estimation is called the <span id="S4.SS1.SSS2.p2.4.1" class="ltx_text ltx_font_italic">forward loss</span></p>
<table id="S4.E52" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="S4.E52.m1" class="ltx_Math" alttext="\mathcal{L}_{\text{forward}}(\theta,\omega)=\frac{1}{N}\sum_{i=1}^{N}V_{\omega}(Y_{i},Z_{i})-\frac{1}{N}\sum_{i=1}^{N}f^{*}(V_{\omega}(T_{\theta}(X_{i})))+\frac{1}{N}\sum_{i=1}^{N}\|T_{\theta}(X_{i})-(Y_{i},Z_{i})\|^{2}\,." display="block" intent=":literal"><semantics><mrow><mrow><mrow><msub><mi class="ltx_font_mathcaligraphic">ℒ</mi><mtext>forward</mtext></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>θ</mi><mo>,</mo><mi>ω</mi><mo stretchy="false">)</mo></mrow></mrow><mo>=</mo><mrow><mrow><mrow><mfrac><mn>1</mn><mi>N</mi></mfrac><mo lspace="0em" rspace="0em">​</mo><mrow><munderover><mo movablelimits="false">∑</mo><mrow><mi>i</mi><mo>=</mo><mn>1</mn></mrow><mi>N</mi></munderover><mrow><msub><mi>V</mi><mi>ω</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mi>Y</mi><mi>i</mi></msub><mo>,</mo><msub><mi>Z</mi><mi>i</mi></msub><mo stretchy="false">)</mo></mrow></mrow></mrow></mrow><mo>−</mo><mrow><mfrac><mn>1</mn><mi>N</mi></mfrac><mo lspace="0em" rspace="0em">​</mo><mrow><munderover><mo movablelimits="false">∑</mo><mrow><mi>i</mi><mo>=</mo><mn>1</mn></mrow><mi>N</mi></munderover><mrow><msup><mi>f</mi><mo>∗</mo></msup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mrow><msub><mi>V</mi><mi>ω</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mrow><msub><mi>T</mi><mi>θ</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mi>X</mi><mi>i</mi></msub><mo stretchy="false">)</mo></mrow></mrow><mo stretchy="false">)</mo></mrow></mrow><mo stretchy="false">)</mo></mrow></mrow></mrow></mrow></mrow><mo>+</mo><mrow><mfrac><mn>1</mn><mi>N</mi></mfrac><mo lspace="0em" rspace="0em">​</mo><mrow><munderover><mo movablelimits="false" rspace="0em">∑</mo><mrow><mi>i</mi><mo>=</mo><mn>1</mn></mrow><mi>N</mi></munderover><msup><mrow><mo stretchy="false">‖</mo><mrow><mrow><msub><mi>T</mi><mi>θ</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mi>X</mi><mi>i</mi></msub><mo stretchy="false">)</mo></mrow></mrow><mo>−</mo><mrow><mo stretchy="false">(</mo><msub><mi>Y</mi><mi>i</mi></msub><mo>,</mo><msub><mi>Z</mi><mi>i</mi></msub><mo stretchy="false">)</mo></mrow></mrow><mo stretchy="false">‖</mo></mrow><mn>2</mn></msup></mrow></mrow></mrow></mrow><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">\mathcal{L}_{\text{forward}}(\theta,\omega)=\frac{1}{N}\sum_{i=1}^{N}V_{\omega}(Y_{i},Z_{i})-\frac{1}{N}\sum_{i=1}^{N}f^{*}(V_{\omega}(T_{\theta}(X_{i})))+\frac{1}{N}\sum_{i=1}^{N}\|T_{\theta}(X_{i})-(Y_{i},Z_{i})\|^{2}\,.</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td>
<td rowspan="1" class="ltx_eqn_cell ltx_eqn_eqno ltx_align_middle ltx_align_right"><span class="ltx_tag ltx_tag_equation ltx_align_right">(52)</span></td></tr></tbody>
</table>
</div>
<figure id="S4.F4" class="ltx_figure">
