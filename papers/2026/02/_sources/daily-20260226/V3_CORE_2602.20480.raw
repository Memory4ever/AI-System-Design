<th id="S2.T1.5.1.1" class="ltx_td ltx_align_left ltx_align_middle ltx_th ltx_th_row ltx_border_t" style="padding-top:2.5pt;padding-bottom:2.5pt;">
<span id="S2.T1.5.1.1.1" class="ltx_inline-block ltx_align_middle" style="width:34.1pt;--ltx-bg-color:#E5FFF9;">
<span id="S2.T1.5.1.1.1.1" class="ltx_p"><abbr title="" class="ltx_glossaryref ltx_missing">NF</abbr></span>
</span></th>
<td id="S2.T1.5.1.2" class="ltx_td ltx_align_left ltx_align_middle ltx_border_r ltx_border_t" style="padding-top:2.5pt;padding-bottom:2.5pt;">
<span id="S2.T1.5.1.2.1" class="ltx_inline-block ltx_align_middle" style="width:150.8pt;--ltx-bg-color:#E5FFF9;">
