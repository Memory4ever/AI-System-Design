</span></td>
<th id="S2.T1.5.1.3" class="ltx_td ltx_align_left ltx_align_middle ltx_th ltx_th_row ltx_border_t" style="padding-top:2.5pt;padding-bottom:2.5pt;">
<span id="S2.T1.5.1.3.1" class="ltx_inline-block ltx_align_middle" style="width:34.1pt;--ltx-bg-color:#E5FFF9;">
<span id="S2.T1.5.1.3.1.1" class="ltx_p"><abbr title="" class="ltx_glossaryref ltx_missing">INN</abbr></span>
</span></th>
<td id="S2.T1.5.1.4" class="ltx_td ltx_align_left ltx_align_middle ltx_border_t" style="padding-top:2.5pt;padding-bottom:2.5pt;">
<span id="S2.T1.5.1.4.1" class="ltx_inline-block ltx_align_middle" style="width:150.8pt;--ltx-bg-color:#E5FFF9;">
<span id="S2.T1.5.1.4.1.1" class="ltx_p"><span title="" class="ltx_glossaryref ltx_missing">INN</span></span>
</span></td></tr>
<tr id="S2.T1.5.2" class="ltx_tr">
<th id="S2.T1.5.2.1" class="ltx_td ltx_align_left ltx_align_middle ltx_th ltx_th_row" style="padding-top:2.5pt;padding-bottom:2.5pt;">
<span id="S2.T1.5.2.1.1" class="ltx_inline-block ltx_align_middle" style="width:34.1pt;">
<span id="S2.T1.5.2.1.1.1" class="ltx_p"><abbr title="" class="ltx_glossaryref ltx_missing">IK</abbr></span>
</span></th>
<td id="S2.T1.5.2.2" class="ltx_td ltx_align_left ltx_align_middle ltx_border_r" style="padding-top:2.5pt;padding-bottom:2.5pt;">
<span id="S2.T1.5.2.2.1" class="ltx_inline-block ltx_align_middle" style="width:150.8pt;">
<span id="S2.T1.5.2.2.1.1" class="ltx_p"><span title="" class="ltx_glossaryref ltx_missing">IK</span></span>
</span></td>
<th id="S2.T1.5.2.3" class="ltx_td ltx_align_left ltx_align_middle ltx_th ltx_th_row" style="padding-top:2.5pt;padding-bottom:2.5pt;">
<span id="S2.T1.5.2.3.1" class="ltx_inline-block ltx_align_middle" style="width:34.1pt;">
<span id="S2.T1.5.2.3.1.1" class="ltx_p"><abbr title="" class="ltx_glossaryref ltx_missing">BNN</abbr></span>
</span></th>
