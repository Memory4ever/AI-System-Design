<section id="A1.SSx5" class="ltx_subsection">
<h3 class="ltx_title ltx_title_subsection">Training Algorithm</h3>

<figure id="alg1" class="ltx_float ltx_float_algorithm ltx_framed ltx_framed_top">
<figcaption class="ltx_caption"><span class="ltx_tag ltx_tag_float"><span id="alg1.3" class="ltx_text ltx_font_bold">Algorithm 1</span> </span> SOM-VQ Joint Training (Phase 2)</figcaption>
<div id="alg1.4" class="ltx_listing ltx_framed ltx_framed_topbottom ltx_listing">
<div id="alg1.l0" class="ltx_listingline">
              <span class="ltx_tag ltx_tag_listingline"><span id="alg1.l0.1" class="ltx_text" style="font-size:80%;">0:</span></span>
              
              
             Latent vectors <math id="alg1.l0.m1" class="ltx_Math" alttext="\{z_{i}\}_{i=1}^{N}" display="inline" intent=":literal"><semantics><msubsup><mrow><mo stretchy="false">{</mo><msub><mi>z</mi><mi>i</mi></msub><mo stretchy="false">}</mo></mrow><mrow><mi>i</mi><mo>=</mo><mn>1</mn></mrow><mi>N</mi></msubsup><annotation encoding="application/x-tex">\{z_{i}\}_{i=1}^{N}</annotation></semantics></math>, grid coordinates <math id="alg1.l0.m2" class="ltx_Math" alttext="\{c_{k}\}_{k=1}^{K}" display="inline" intent=":literal"><semantics><msubsup><mrow><mo stretchy="false">{</mo><msub><mi>c</mi><mi>k</mi></msub><mo stretchy="false">}</mo></mrow><mrow><mi>k</mi><mo>=</mo><mn>1</mn></mrow><mi>K</mi></msubsup><annotation encoding="application/x-tex">\{c_{k}\}_{k=1}^{K}</annotation></semantics></math>

</div>
<div id="alg1.l0a" class="ltx_listingline">
              <span class="ltx_tag ltx_tag_listingline"><span id="alg1.l0a.1" class="ltx_text" style="font-size:80%;">0:</span></span>
              
              
             Topology lr <math id="alg1.l0a.m1" class="ltx_Math" alttext="\eta" display="inline" intent=":literal"><semantics><mi>η</mi><annotation encoding="application/x-tex">\eta</annotation></semantics></math>, EMA rate <math id="alg1.l0a.m2" class="ltx_Math" alttext="\alpha" display="inline" intent=":literal"><semantics><mi>α</mi><annotation encoding="application/x-tex">\alpha</annotation></semantics></math>, fixed bandwidth <math id="alg1.l0a.m3" class="ltx_Math" alttext="\sigma" display="inline" intent=":literal"><semantics><mi>σ</mi><annotation encoding="application/x-tex">\sigma</annotation></semantics></math>

</div>
<div id="alg1.l1" class="ltx_listingline">
              <span class="ltx_tag ltx_tag_listingline"><span id="alg1.l1.1" class="ltx_text" style="font-size:80%;">1:</span></span>
              
              
             Initialize codebook <math id="alg1.l1.m1" class="ltx_Math" alttext="\{e_{k}\}" display="inline" intent=":literal"><semantics><mrow><mo stretchy="false">{</mo><msub><mi>e</mi><mi>k</mi></msub><mo stretchy="false">}</mo></mrow><annotation encoding="application/x-tex">\{e_{k}\}</annotation></semantics></math> from 10-epoch SOM pre-training

</div>
<div id="alg1.l2" class="ltx_listingline">
              <span class="ltx_tag ltx_tag_listingline"><span id="alg1.l2.1" class="ltx_text" style="font-size:80%;">2:</span></span>
              
              
             <span id="alg1.l2.3" class="ltx_text ltx_font_bold">for</span> epoch <math id="alg1.l2.m1" class="ltx_Math" alttext="t=1" display="inline" intent=":literal"><semantics><mrow><mi>t</mi><mo>=</mo><mn>1</mn></mrow><annotation encoding="application/x-tex">t=1</annotation></semantics></math> to <math id="alg1.l2.m2" class="ltx_Math" alttext="T" display="inline" intent=":literal"><semantics><mi>T</mi><annotation encoding="application/x-tex">T</annotation></semantics></math> <span id="alg1.l2.4" class="ltx_text ltx_font_bold">do</span>



</div>
<div id="alg1.l3" class="ltx_listingline">
              <span class="ltx_tag ltx_tag_listingline"><span id="alg1.l3.1" class="ltx_text" style="font-size:80%;">3:</span></span>
              
              
              <span id="alg1.l3.3" class="ltx_text ltx_font_bold">for</span> each <math id="alg1.l3.m1" class="ltx_Math" alttext="z_{i}" display="inline" intent=":literal"><semantics><msub><mi>z</mi><mi>i</mi></msub><annotation encoding="application/x-tex">z_{i}</annotation></semantics></math> in random order <span id="alg1.l3.4" class="ltx_text ltx_font_bold">do</span>



</div>
<div id="alg1.l4" class="ltx_listingline">
              <span class="ltx_tag ltx_tag_listingline"><span id="alg1.l4.1" class="ltx_text" style="font-size:80%;">4:</span></span>
              
              
               <math id="alg1.l4.m1" class="ltx_Math" alttext="k^{*}\leftarrow\arg\min_{k}\|z_{i}-e_{k}\|_{2}" display="inline" intent=":literal"><semantics><mrow><msup><mi>k</mi><mo>∗</mo></msup><mo stretchy="false">←</mo><mrow><mi>arg</mi><mo lspace="0.167em">⁡</mo><mrow><msub><mi>min</mi><mi>k</mi></msub><mo>⁡</mo><msub><mrow><mo stretchy="false">‖</mo><mrow><msub><mi>z</mi><mi>i</mi></msub><mo>−</mo><msub><mi>e</mi><mi>k</mi></msub></mrow><mo stretchy="false">‖</mo></mrow><mn>2</mn></msub></mrow></mrow></mrow><annotation encoding="application/x-tex">k^{*}\leftarrow\arg\min_{k}\|z_{i}-e_{k}\|_{2}</annotation></semantics></math>

</div>
<div id="alg1.l5" class="ltx_listingline">
              <span class="ltx_tag ltx_tag_listingline"><span id="alg1.l5.1" class="ltx_text" style="font-size:80%;">5:</span></span>
              
              
