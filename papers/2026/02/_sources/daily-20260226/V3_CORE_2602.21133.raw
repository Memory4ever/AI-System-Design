<td id="S3.T1.2.6.5" class="ltx_td ltx_align_center ltx_border_t" style="padding-left:4.5pt;padding-right:4.5pt;"><span id="S3.T1.2.6.5.1" class="ltx_text" style="font-size:50%;">0.898</span></td>
