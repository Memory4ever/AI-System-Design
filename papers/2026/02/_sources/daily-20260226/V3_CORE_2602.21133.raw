                <math id="alg1.l7.m1" class="ltx_math_unparsed" alttext="h\leftarrow\exp(-d^{2}/2\sigma^{2})" display="inline" intent=":literal"><semantics><mrow><mi>h</mi><mo stretchy="false">←</mo><mi>exp</mi><mrow><mo stretchy="false">(</mo><mo lspace="0em">−</mo><msup><mi>d</mi><mn>2</mn></msup><mo>/</mo><mn>2</mn><msup><mi>σ</mi><mn>2</mn></msup><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">h\leftarrow\exp(-d^{2}/2\sigma^{2})</annotation></semantics></math>

