<td id="A3.T5.7.3.4" class="ltx_td ltx_align_center ltx_border_bb" style="padding:0.45pt 5.0pt;"><math id="A3.T5.m4" class="ltx_Math" alttext="\sim" display="inline" intent=":literal"><semantics><mo mathsize="0.800em">∼</mo><annotation encoding="application/x-tex">\sim</annotation></semantics></math><span id="A3.T5.7.3.4.1" class="ltx_text" style="font-size:80%;">145.6</span></td>
