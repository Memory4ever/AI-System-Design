<th id="S4.T1.8.1.6" class="ltx_td ltx_align_center ltx_th ltx_th_column ltx_border_tt" style="padding:0.9pt 4.0pt;"><span id="S4.T1.8.1.6.1" class="ltx_text" style="font-size:90%;">IPGuard</span></th>
<th id="S4.T1.8.1.7" class="ltx_td ltx_align_center ltx_th ltx_th_column ltx_border_tt" style="padding:0.9pt 4.0pt;"><span id="S4.T1.8.1.7.1" class="ltx_text" style="font-size:90%;">UAP</span></th>
<th id="S4.T1.8.1.8" class="ltx_td ltx_align_center ltx_th ltx_th_column ltx_border_tt" style="padding:0.9pt 4.0pt;"><span id="S4.T1.8.1.8.1" class="ltx_text ltx_font_bold" style="font-size:90%;">CREDIT</span></th></tr>
</thead>
<tbody class="ltx_tbody">
<tr id="S4.T1.8.2" class="ltx_tr">
<th id="S4.T1.8.2.1" class="ltx_td ltx_align_left ltx_th ltx_th_row ltx_border_t" style="padding:0.9pt 4.0pt;" rowspan="4"><span id="S4.T1.8.2.1.1" class="ltx_text" style="font-size:90%;">CIFAR-10</span></th>
<th id="S4.T1.8.2.2" class="ltx_td ltx_align_left ltx_th ltx_th_row ltx_border_t" style="padding:0.9pt 4.0pt;"><span id="S4.T1.8.2.2.1" class="ltx_text" style="font-size:90%;">ResNet</span></th>
<td id="S4.T1.8.2.3" class="ltx_td ltx_align_center ltx_border_t" style="padding:0.9pt 4.0pt;"><math id="S4.T1.m1" class="ltx_Math" alttext="95.70\pm 0.03" display="inline" intent=":literal"><semantics><mrow><mn mathsize="0.900em">95.70</mn><mo mathsize="0.900em">±</mo><mn mathsize="0.900em">0.03</mn></mrow><annotation encoding="application/x-tex">95.70\pm 0.03</annotation></semantics></math></td>
<td id="S4.T1.8.2.4" class="ltx_td ltx_align_center ltx_border_t" style="padding:0.9pt 4.0pt;"><math id="S4.T1.m2" class="ltx_Math" alttext="78.10\pm 2.18" display="inline" intent=":literal"><semantics><mrow><mn mathsize="0.900em">78.10</mn><mo mathsize="0.900em">±</mo><mn mathsize="0.900em">2.18</mn></mrow><annotation encoding="application/x-tex">78.10\pm 2.18</annotation></semantics></math></td>
<td id="S4.T1.8.2.5" class="ltx_td ltx_align_center ltx_border_t" style="padding:0.9pt 4.0pt;"><math id="S4.T1.m3" class="ltx_Math" alttext="90.25\pm 0.02" display="inline" intent=":literal"><semantics><mrow><mn mathsize="0.900em">90.25</mn><mo mathsize="0.900em">±</mo><mn mathsize="0.900em">0.02</mn></mrow><annotation encoding="application/x-tex">90.25\pm 0.02</annotation></semantics></math></td>
<td id="S4.T1.8.2.6" class="ltx_td ltx_align_center ltx_border_t" style="padding:0.9pt 4.0pt;"><math id="S4.T1.m4" class="ltx_Math" alttext="91.08\pm 0.00" display="inline" intent=":literal"><semantics><mrow><mn mathsize="0.900em">91.08</mn><mo mathsize="0.900em">±</mo><mn mathsize="0.900em">0.00</mn></mrow><annotation encoding="application/x-tex">91.08\pm 0.00</annotation></semantics></math></td>
<td id="S4.T1.8.2.7" class="ltx_td ltx_align_center ltx_border_t" style="padding:0.9pt 4.0pt;"><math id="S4.T1.m5" class="ltx_Math" alttext="84.73\pm 2.26" display="inline" intent=":literal"><semantics><mrow><mn mathsize="0.900em">84.73</mn><mo mathsize="0.900em">±</mo><mn mathsize="0.900em">2.26</mn></mrow><annotation encoding="application/x-tex">84.73\pm 2.26</annotation></semantics></math></td>
<td id="S4.T1.8.2.8" class="ltx_td ltx_align_center ltx_border_t" style="padding:0.9pt 4.0pt;"><math id="S4.T1.m6" class="ltx_Math" alttext="\mathbf{94.67\pm 0.22}" display="inline" intent=":literal"><semantics><mrow><mn class="ltx_mathvariant_bold" mathsize="0.900em" mathvariant="bold">94.67</mn><mo mathsize="0.900em">±</mo><mn class="ltx_mathvariant_bold" mathsize="0.900em" mathvariant="bold">0.22</mn></mrow><annotation encoding="application/x-tex">\mathbf{94.67\pm 0.22}</annotation></semantics></math></td></tr>
<tr id="S4.T1.8.3" class="ltx_tr">
