<th id="A3.T5.7.1.2" class="ltx_td ltx_align_center ltx_th ltx_th_column ltx_border_tt" style="padding:0.45pt 5.0pt;"><span id="A3.T5.7.1.2.1" class="ltx_text" style="font-size:80%;">#Graphs</span></th>
<th id="A3.T5.7.1.3" class="ltx_td ltx_align_center ltx_th ltx_th_column ltx_border_tt" style="padding:0.45pt 5.0pt;"><span id="A3.T5.7.1.3.1" class="ltx_text" style="font-size:80%;">Avg. #Nodes</span></th>
