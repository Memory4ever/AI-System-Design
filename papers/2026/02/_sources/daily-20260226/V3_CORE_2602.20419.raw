<th id="A4.T7.5.1.2" class="ltx_td ltx_align_center ltx_th ltx_th_column ltx_border_r ltx_border_tt"><span id="A4.T7.5.1.2.1" class="ltx_text ltx_font_bold">ResNet</span></th>
<th id="A4.T7.5.1.3" class="ltx_td ltx_align_center ltx_th ltx_th_column ltx_border_r ltx_border_tt"><span id="A4.T7.5.1.3.1" class="ltx_text ltx_font_bold">VGG</span></th>
<th id="A4.T7.5.1.4" class="ltx_td ltx_align_center ltx_th ltx_th_column ltx_border_r ltx_border_tt"><span id="A4.T7.5.1.4.1" class="ltx_text ltx_font_bold">DenseNet</span></th>
<th id="A4.T7.5.1.5" class="ltx_td ltx_align_center ltx_th ltx_th_column ltx_border_tt"><span id="A4.T7.5.1.5.1" class="ltx_text ltx_font_bold">GoogLeNet</span></th></tr>
</thead>
<tbody class="ltx_tbody">
<tr id="A4.T7.5.2" class="ltx_tr">
