<th id="A3.T5.7.2.1" class="ltx_td ltx_align_left ltx_th ltx_th_row ltx_border_t" style="padding:0.45pt 5.0pt;"><span id="A3.T5.7.2.1.1" class="ltx_text" style="font-size:80%;">ENZYMES</span></th>
<td id="A3.T5.7.2.2" class="ltx_td ltx_align_center ltx_border_t" style="padding:0.45pt 5.0pt;"><span id="A3.T5.7.2.2.1" class="ltx_text" style="font-size:80%;">600</span></td>
<td id="A3.T5.7.2.3" class="ltx_td ltx_align_center ltx_border_t" style="padding:0.45pt 5.0pt;"><math id="A3.T5.m1" class="ltx_Math" alttext="\sim" display="inline" intent=":literal"><semantics><mo mathsize="0.800em">∼</mo><annotation encoding="application/x-tex">\sim</annotation></semantics></math><span id="A3.T5.7.2.3.1" class="ltx_text" style="font-size:80%;">32.6</span></td>
<td id="A3.T5.7.2.4" class="ltx_td ltx_align_center ltx_border_t" style="padding:0.45pt 5.0pt;"><math id="A3.T5.m2" class="ltx_Math" alttext="\sim" display="inline" intent=":literal"><semantics><mo mathsize="0.800em">∼</mo><annotation encoding="application/x-tex">\sim</annotation></semantics></math><span id="A3.T5.7.2.4.1" class="ltx_text" style="font-size:80%;">124.3</span></td>
<td id="A3.T5.7.2.5" class="ltx_td ltx_align_center ltx_border_t" style="padding:0.45pt 5.0pt;"><span id="A3.T5.7.2.5.1" class="ltx_text" style="font-size:80%;">3</span></td>
<td id="A3.T5.7.2.6" class="ltx_td ltx_align_center ltx_border_t" style="padding:0.45pt 5.0pt;"><span id="A3.T5.7.2.6.1" class="ltx_text" style="font-size:80%;">6</span></td></tr>
<tr id="A3.T5.7.3" class="ltx_tr">
