<td id="S4.T1.6.9.4" class="ltx_td ltx_align_center ltx_border_t" style="padding:0.25pt 4.0pt;"><span id="S4.T1.6.9.4.1" class="ltx_text ltx_font_bold">83.00</span></td>
<td id="S4.T1.6.9.5" class="ltx_td ltx_align_center ltx_border_t" style="padding:0.25pt 4.0pt;"><span id="S4.T1.6.9.5.1" class="ltx_text ltx_font_smallcaps">81.00</span></td>
<td id="S4.T1.6.9.6" class="ltx_td ltx_align_center ltx_border_t" style="padding:0.25pt 4.0pt;"><span id="S4.T1.6.9.6.1" class="ltx_text ltx_font_smallcaps">79.79</span></td>
<td id="S4.T1.6.9.7" class="ltx_td ltx_align_center ltx_border_t" style="padding:0.25pt 4.0pt;"><span id="S4.T1.6.9.7.1" class="ltx_text ltx_font_smallcaps">81.00</span></td>
<td id="S4.T1.6.9.8" class="ltx_td ltx_align_center ltx_border_t" style="padding:0.25pt 4.0pt;"><span id="S4.T1.6.9.8.1" class="ltx_text ltx_font_smallcaps">-2.00</span></td>
<td id="S4.T1.6.9.9" class="ltx_td ltx_align_center ltx_border_t" style="padding:0.25pt 4.0pt;"><span id="S4.T1.6.9.9.1" class="ltx_text ltx_font_smallcaps">-2.41</span></td></tr>
<tr id="S4.T1.6.10" class="ltx_tr">
<th id="S4.T1.6.10.1" class="ltx_td ltx_align_left ltx_th ltx_th_row ltx_border_bb" style="padding:0.25pt 4.0pt;"><span id="S4.T1.6.10.1.1" class="ltx_text ltx_font_smallcaps">AIME24</span></th>
<td id="S4.T1.6.10.2" class="ltx_td ltx_align_center ltx_border_bb" style="padding:0.25pt 4.0pt;"><span id="S4.T1.6.10.2.1" class="ltx_text ltx_font_smallcaps">3.33</span></td>
