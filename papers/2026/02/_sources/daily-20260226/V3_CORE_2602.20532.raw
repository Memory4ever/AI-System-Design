<td id="A7.T2.2.25.2" class="ltx_td ltx_align_left"><math id="A7.T2.m10" class="ltx_Math" alttext="1\times 10^{-6}" display="inline" intent=":literal"><semantics><mrow><mn>1</mn><mo lspace="0.222em" rspace="0.222em">×</mo><msup><mn>10</mn><mrow><mo>−</mo><mn>6</mn></mrow></msup></mrow><annotation encoding="application/x-tex">1\times 10^{-6}</annotation></semantics></math></td></tr>
