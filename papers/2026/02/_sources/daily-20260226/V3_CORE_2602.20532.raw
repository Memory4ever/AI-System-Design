<th id="A7.T2.2.20.1" class="ltx_td ltx_align_left ltx_th ltx_th_row ltx_border_t" colspan="2"><span id="A7.T2.2.20.1.1" class="ltx_text ltx_font_italic">Curator optimization</span></th></tr>
