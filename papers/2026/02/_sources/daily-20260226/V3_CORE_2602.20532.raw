<th id="A7.T2.2.26.1" class="ltx_td ltx_align_left ltx_th ltx_th_row ltx_border_bb">Curator PPO clip range <math id="A7.T2.m11" class="ltx_Math" alttext="\rho_{\max}-\rho_{\min}" display="inline" intent=":literal"><semantics><mrow><msub><mi>ρ</mi><mi>max</mi></msub><mo>−</mo><msub><mi>ρ</mi><mi>min</mi></msub></mrow><annotation encoding="application/x-tex">\rho_{\max}-\rho_{\min}</annotation></semantics></math></th>
<td id="A7.T2.2.26.2" class="ltx_td ltx_align_left ltx_border_bb">0.2</td></tr>
