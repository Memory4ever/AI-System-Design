<span id="S1.F1.2.1.4.1" class="ltx_inline-block ltx_minipage ltx_align_top" style="width:79.3pt;"><img src="2602.20520v1/figs/original_1034_124622_158004.png" id="S1.F1.g7" class="ltx_graphics ltx_centering ltx_img_square" style="aspect-ratio:53/53;" width="53" height="53" alt="Refer to caption"><img src="2602.20520v1/figs/inpainted_1034_124622_158004.png" id="S1.F1.g8" class="ltx_graphics ltx_centering ltx_img_square" style="aspect-ratio:53/53;" width="53" height="53" alt="Refer to caption">
<span id="S1.F1.2.1.4.1.1" class="ltx_p ltx_align_center"><span id="S1.F1.2.1.4.1.1.1" class="ltx_text ltx_font_bold">Orig:</span> <span id="S1.F1.2.1.4.1.1.2" class="ltx_text" style="--ltx-fg-color:#009900;">a blue and white plane</span></span>
