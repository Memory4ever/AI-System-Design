<td id="S3.T3.3.1.5.7" class="ltx_td ltx_align_center ltx_border_bb ltx_border_r" style="padding:0.65pt 4.6pt;"><span id="S3.T3.3.1.5.7.1" class="ltx_text" style="font-size:80%;">7.1</span></td>
<td id="S3.T3.3.1.5.8" class="ltx_td ltx_align_center ltx_border_bb" style="padding:0.65pt 4.6pt;"><span id="S3.T3.3.1.5.8.1" class="ltx_text" style="font-size:80%;">-12.2</span></td></tr>
