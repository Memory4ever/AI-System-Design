                  <span id="alg1.l8.3" class="ltx_text ltx_font_bold">for</span> <math id="alg1.l8.m1" class="ltx_Math" alttext="i\in R" display="inline" intent=":literal"><semantics><mrow><mi>i</mi><mo>∈</mo><mi>R</mi></mrow><annotation encoding="application/x-tex">i\in R</annotation></semantics></math> <span id="alg1.l8.4" class="ltx_text ltx_font_bold">do</span>

</div>
<div id="alg1.l9" class="ltx_listingline">
                  <span class="ltx_tag ltx_tag_listingline"><span id="alg1.l9.1" class="ltx_text" style="font-size:80%;">9:</span></span>
                  
                  
                   <math id="alg1.l9.m1" class="ltx_Math" alttext="O\leftarrow U\setminus C_{i}" display="inline" intent=":literal"><semantics><mrow><mi>O</mi><mo stretchy="false">←</mo><mrow><mi>U</mi><mo>∖</mo><msub><mi>C</mi><mi>i</mi></msub></mrow></mrow><annotation encoding="application/x-tex">O\leftarrow U\setminus C_{i}</annotation></semantics></math> <span id="alg1.l9.3" class="ltx_text" style="float:right;"><math id="alg1.l9.m2" class="ltx_Math" alttext="\triangleright" display="inline" intent=":literal"><semantics><mo>⊳</mo><annotation encoding="application/x-tex">\triangleright</annotation></semantics></math> Voxels occupied by other pieces
</span>
</div>
<div id="alg1.l10" class="ltx_listingline">
                  <span class="ltx_tag ltx_tag_listingline"><span id="alg1.l10.1" class="ltx_text" style="font-size:80%;">10:</span></span>
                  
                  
                   <span id="alg1.l10.3" class="ltx_text ltx_font_bold">for</span> <math id="alg1.l10.m1" class="ltx_Math" alttext="\mathbf{d}\in\{+\vec{x},-\vec{x},+\vec{y},-\vec{y},+\vec{z},-\vec{z}\}" display="inline" intent=":literal"><semantics><mrow><mi>𝐝</mi><mo>∈</mo><mrow><mo stretchy="false">{</mo><mrow><mrow><mo>+</mo><mover accent="true"><mi>x</mi><mo stretchy="false">→</mo></mover></mrow><mo>,</mo><mrow><mo>−</mo><mover accent="true"><mi>x</mi><mo stretchy="false">→</mo></mover></mrow><mo>,</mo><mrow><mo>+</mo><mover accent="true"><mi>y</mi><mo stretchy="false">→</mo></mover></mrow><mo>,</mo><mrow><mo>−</mo><mover accent="true"><mi>y</mi><mo stretchy="false">→</mo></mover></mrow><mo>,</mo><mrow><mo>+</mo><mover accent="true"><mi>z</mi><mo stretchy="false">→</mo></mover></mrow><mo>,</mo><mrow><mo>−</mo><mover accent="true"><mi>z</mi><mo stretchy="false">→</mo></mover></mrow></mrow><mo stretchy="false">}</mo></mrow></mrow><annotation encoding="application/x-tex">\mathbf{d}\in\{+\vec{x},-\vec{x},+\vec{y},-\vec{y},+\vec{z},-\vec{z}\}</annotation></semantics></math> <span id="alg1.l10.4" class="ltx_text ltx_font_bold">do</span>

</div>
<div id="alg1.l11" class="ltx_listingline">
                  <span class="ltx_tag ltx_tag_listingline"><span id="alg1.l11.1" class="ltx_text" style="font-size:80%;">11:</span></span>
                  
                  
                     <span id="alg1.l11.3" class="ltx_text ltx_font_bold">if</span> <span id="alg1.l11.4" class="ltx_text ltx_font_smallcaps">Removable</span>(<math id="alg1.l11.m1" class="ltx_Math" alttext="C_{i},O,\mathbf{d}" display="inline" intent=":literal"><semantics><mrow><msub><mi>C</mi><mi>i</mi></msub><mo>,</mo><mi>O</mi><mo>,</mo><mi>𝐝</mi></mrow><annotation encoding="application/x-tex">C_{i},O,\mathbf{d}</annotation></semantics></math>) <span id="alg1.l11.5" class="ltx_text ltx_font_bold">then</span>

</div>
<div id="alg1.l12" class="ltx_listingline">
                  <span class="ltx_tag ltx_tag_listingline"><span id="alg1.l12.1" class="ltx_text" style="font-size:80%;">12:</span></span>
                  
                  
                      Append <math id="alg1.l12.m1" class="ltx_Math" alttext="(i,\mathbf{d})" display="inline" intent=":literal"><semantics><mrow><mo stretchy="false">(</mo><mi>i</mi><mo>,</mo><mi>𝐝</mi><mo stretchy="false">)</mo></mrow><annotation encoding="application/x-tex">(i,\mathbf{d})</annotation></semantics></math> to <math id="alg1.l12.m2" class="ltx_Math" alttext="\mathit{removal}" display="inline" intent=":literal"><semantics><mi>𝑟𝑒𝑚𝑜𝑣𝑎𝑙</mi><annotation encoding="application/x-tex">\mathit{removal}</annotation></semantics></math>

</div>
<div id="alg1.l13" class="ltx_listingline">
                  <span class="ltx_tag ltx_tag_listingline"><span id="alg1.l13.1" class="ltx_text" style="font-size:80%;">13:</span></span>
                  
                  
                      <math id="alg1.l13.m1" class="ltx_Math" alttext="R\leftarrow R\setminus\{i\}" display="inline" intent=":literal"><semantics><mrow><mi>R</mi><mo stretchy="false">←</mo><mrow><mi>R</mi><mo>∖</mo><mrow><mo stretchy="false">{</mo><mi>i</mi><mo stretchy="false">}</mo></mrow></mrow></mrow><annotation encoding="application/x-tex">R\leftarrow R\setminus\{i\}</annotation></semantics></math>

</div>
<div id="alg1.l14" class="ltx_listingline">
                  <span class="ltx_tag ltx_tag_listingline"><span id="alg1.l14.1" class="ltx_text" style="font-size:80%;">14:</span></span>
                  
                  
                      <math id="alg1.l14.m1" class="ltx_Math" alttext="\mathit{found}\leftarrow\textbf{true}" display="inline" intent=":literal"><semantics><mrow><mi>𝑓𝑜𝑢𝑛𝑑</mi><mo stretchy="false">←</mo><mtext class="ltx_mathvariant_bold">true</mtext></mrow><annotation encoding="application/x-tex">\mathit{found}\leftarrow\textbf{true}</annotation></semantics></math>

</div>
<div id="alg1.l15" class="ltx_listingline">
                  <span class="ltx_tag ltx_tag_listingline"><span id="alg1.l15.1" class="ltx_text" style="font-size:80%;">15:</span></span>
                  
                  
                      <span id="alg1.l15.3" class="ltx_text ltx_font_bold">break</span>

</div>
<div id="alg1.l16" class="ltx_listingline">
                  <span class="ltx_tag ltx_tag_listingline"><span id="alg1.l16.1" class="ltx_text" style="font-size:80%;">16:</span></span>
                  
                  
                     <span id="alg1.l16.3" class="ltx_text ltx_font_bold">end</span> <span id="alg1.l16.4" class="ltx_text ltx_font_bold">if</span>
</div>
<div id="alg1.l17" class="ltx_listingline">
                  <span class="ltx_tag ltx_tag_listingline"><span id="alg1.l17.1" class="ltx_text" style="font-size:80%;">17:</span></span>
                  
                  
                   <span id="alg1.l17.3" class="ltx_text ltx_font_bold">end</span> <span id="alg1.l17.4" class="ltx_text ltx_font_bold">for</span>
</div>
<div id="alg1.l18" class="ltx_listingline">
                  <span class="ltx_tag ltx_tag_listingline"><span id="alg1.l18.1" class="ltx_text" style="font-size:80%;">18:</span></span>
                  
                  
                   <span id="alg1.l18.3" class="ltx_text ltx_font_bold">if</span> <math id="alg1.l18.m1" class="ltx_Math" alttext="\mathit{found}" display="inline" intent=":literal"><semantics><mi>𝑓𝑜𝑢𝑛𝑑</mi><annotation encoding="application/x-tex">\mathit{found}</annotation></semantics></math> <span id="alg1.l18.4" class="ltx_text ltx_font_bold">then</span>

</div>
<div id="alg1.l19" class="ltx_listingline">
                  <span class="ltx_tag ltx_tag_listingline"><span id="alg1.l19.1" class="ltx_text" style="font-size:80%;">19:</span></span>
                  
                  
                     <span id="alg1.l19.3" class="ltx_text ltx_font_bold">break</span>

</div>
<div id="alg1.l20" class="ltx_listingline">
                  <span class="ltx_tag ltx_tag_listingline"><span id="alg1.l20.1" class="ltx_text" style="font-size:80%;">20:</span></span>
                  
                  
                   <span id="alg1.l20.3" class="ltx_text ltx_font_bold">end</span> <span id="alg1.l20.4" class="ltx_text ltx_font_bold">if</span>
</div>
<div id="alg1.l21" class="ltx_listingline">
                  <span class="ltx_tag ltx_tag_listingline"><span id="alg1.l21.1" class="ltx_text" style="font-size:80%;">21:</span></span>
                  
                  
                  <span id="alg1.l21.3" class="ltx_text ltx_font_bold">end</span> <span id="alg1.l21.4" class="ltx_text ltx_font_bold">for</span>
</div>
<div id="alg1.l22" class="ltx_listingline">
                  <span class="ltx_tag ltx_tag_listingline"><span id="alg1.l22.1" class="ltx_text" style="font-size:80%;">22:</span></span>
                  
                  
                  <span id="alg1.l22.3" class="ltx_text ltx_font_bold">if</span> <span id="alg1.l22.4" class="ltx_text ltx_font_bold">not</span> <math id="alg1.l22.m1" class="ltx_Math" alttext="\mathit{found}" display="inline" intent=":literal"><semantics><mi>𝑓𝑜𝑢𝑛𝑑</mi><annotation encoding="application/x-tex">\mathit{found}</annotation></semantics></math> <span id="alg1.l22.5" class="ltx_text ltx_font_bold">then</span>

</div>
<div id="alg1.l23" class="ltx_listingline">
