<td id="S3.T3.3.1.4.4" class="ltx_td ltx_align_center ltx_border_r" style="padding:0.65pt 4.6pt;"><span id="S3.T3.3.1.4.4.1" class="ltx_text" style="font-size:80%;">13.8</span></td>
