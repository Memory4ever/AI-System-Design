lities. \\\",\\\"datePublished\\\":\\\"2026-02-25T17:00:00.000Z\\\",\\\"dateModified\\\":\\\"2026-09-09T21:13:17.000Z\\\",\\\"author\\\":{\\\"@type\\\":\\\"Organization\\\",\\\"name\\\":\\\"Anthropic\\\",\\\"url\\\":\\\"https://www.anthropic.com\\\"},\\\"publisher\\\":{\\\"@type\\\":\\\"Organization\\\",\\\"name\\\":\\\"Anthropic\\\",\\\"url\\\":\\\"https://www.anthropic.com\\\"},\\\"mainEntityOfPage\\\":\\\"https://www.anthropic.com/news/acquires-vercept\\\",\\\"url\\\":\\\"https://www.anthropic.com/news/acquires-vercept\\\"}\"}],[\"$\",\"$L17\",null,{\"children\":[null,[\"$\",\"$L18\",null,{\"isMinimalNavigation\":\"$undefined\",\"siteSettings\":{\"headerNavigation\":\"$16:props:children:1:props:siteSettings:headerNavigation\",\"claudeCta\":\"$16:props:children:1:props:siteSettings:claudeCta\"},\"page\":\"$undefined\",\"theme\":\"$undefined\",\"hideOnScroll\":\"$undefined\"}],[\"$\",\"main\",null,{\"id\":\"main-content\",\"className\":\"\",\"children\":[\"$\",\"article\",null,{\"className\":\"\",\"children\":[[\"$\",\"div\",null,{\"className\":\"page-wrapper PostDetail-module-scss-module__UQuRMa__hero\",\"children\":[[\"$\",\"div\",null,{\"className\":\"PostDetail-module-scss-module__UQuRMa__header\",\"children\":[[\"$\",\"div\",null,{\"className\":\"PostDetail-module-scss-module__UQuRMa__subjects body-3 bold\",\"children\":[[\"$\",\"span\",\"0\",{\"children\":\"Announcements\"}]]}],[\"$\",\"h1\",null,{\"className\":\"headline-1 PostDetail-module-scss-module__UQuRMa__title\",\"children\":\"Anthropic acquires Vercept to advance Claude's computer use capabilities\"}],[\"$\",\"div\",null,{\"className\":\"body-3 agate\",\"children\":[\"$\",\"time\",null,{\"dateTime\":\"2026-02-25T17:00:00.000Z\",\"children\":\"Feb 25, 2026\"}]}],\"$undefined\"]}],[\"$\",\"div\",null,{\"className\":\"PostDetail-module-scss-module__UQuRMa__illustrationHeroWrapper\",\"children\":[\"$\",\"div\",null,{\"className\":\"Illustration-module-scss-module__WyGOtq__root Illustration-module-scss-module__WyGOtq__aspect-wide Illustration-module-scss-module__WyGOtq__padding-lg Illustration-module-scss-module__WyGOtq__radius-lg bg-coral\",\"children\":[\"$\",\"div\",null,{\"className\":\"Illustration-module-scss-module__WyGOtq__inner\",\"children\":[\"$\",\"$L1a\",null,{\"src\":\"https://www-cdn.anthropic.com/images/4zrzovbb/website/8925ac952fa2cb8eb5e845b2e44f3e71b33fd695-1000x1000.svg\",\"alt\":\"Anthropic acquires Vercept to advance Claude's computer use capabilities\",\"width\":1000,\"height\":1000,\"className\":\"\"}]}]}]}]]}],[\"$\",\"div\",null,{\"className\":\"page-wrapper\",\"children\":[\"$\",\"$L1b\",null,{\"body\":[{\"_key\":\"a05ec873b2db\",\"_type\":\"block\",\"children\":[{\"_key\":\"e6a02277fe36\",\"_type\":\"span\",\"marks\":[],\"text\":\"People are using Claude for increasingly complex work—writing and running code across entire repositories, synthesizing research from dozens of sources, and managing workflows that span multiple tools and teams. Computer use enables Claude to do all of that inside live applications, the way a person at a keyboard would. That means Claude can take on multi-step tasks in live applications, and solve problems impossible with code alone. Today, we're announcing that Anthropic has acquired Vercept to help us push those capabilities further.\"}],\"markDefs\":[],\"style\":\"normal\"},{\"_key\":\"1472a66d8778\",\"_type\":\"block\",\"children\":[{\"_key\":\"11cc7652fd37\",\"_type\":\"span\",\"marks\":[],\"text\":\"\"}],\"markDefs\":[],\"style\":\"normal\"},{\"_key\":\"d2f86b9ff568\",\"_type\":\"block\",\"children\":[{\"_key\":\"6a01a7ce6eab\",\"_type\":\"span\",\"marks\":[],\"text\":\"Vercept was built around a clear thesis: making AI genuinely useful for completing complex tasks requires solving hard perception and interaction problems. The Vercept team—including co-founders Kiana Ehsani, Luca Weihs, and Ross Girshick—have spent years thinking carefully about how AI systems can see and act within the same software humans use every day. That expertise maps directly onto some of the hardest problems we're working on at Anthropic. Vercept will wind down its external product in the coming weeks and join Anthropic in pushing the frontiers of computer use.\"}],\"markDefs\":[],\"style\":\"normal\"},{\"_key\":\"90d602d3beb6\",\"_type\":\"block\",\"children\":[{\"_key\":\"d0bbd1538f4f\",\"_type\":\"span\",\"marks\":[],\"text\":\"\"}],\"markDefs\":[],\"style\":\"normal\"},{\"_key\":\"8dc513a4b8a8\",\"_type\":\"block\",\"children\":[{\"_key\":\"a2f7d2a491b7\",\"_type\":\"span\",\"marks\":[],\"text\":\"This acquisition follows the recent launch of Claude \"},{\"_key\":\"71b644f81cea\",\"_type\":\"span\",\"marks\":[\"fe8fa529290d\"],\"text\":\"Sonnet 4.6\"},{\"_key\":\"c820a3e84019\",\"_type\":\"span\",\"marks\":[],\"text\":\", which shows a major improvement in computer use skills: on OSWorld, a widely-used evaluation for AI computer use, our Sonnet models went from under 15% in late 2024, when we first released computer use, to 72.5% today. Sonnet 4.6 is now approaching human-level performance on tasks like navigating complex spreadsheets and completing web forms across browser tabs.\"}],\"markDefs\":[{\"_key\":\"fe8fa529290d\",\"_type\":\"link\",\"href\":\"https://www.anthropic.com/news/claude-sonnet-4-6\"}],\"style\":\"normal\"},{\"_key\":\"d7f986577f71\",\"_type\":\"block\",\"children\":[{\"_key\":\"314a14786710\",\"_type\":\"span\",\"marks\":[],\"text\":\"\"}],\"markDefs\":[],\"style\":\"normal\"},{\"_key\":\"8889c4148459\",\"_type\":\"block\",\"children\":[{\"_key\":\"9d3519e6c377\",\"_type\":\"span\",\"marks\":[],\"text\":\"Vercept is the latest team we’ve brought into Anthropic, following the acquisition of \"},{\"_key\":\"e9a60fd7e1da\",\"_type\":\"span\",\"marks\":[\"c59c9b57844c\"],\"text\":\"Bun\"},{\"_key\":\"0577865d3df5\",\"_type\":\"span\",\"marks\":[],\"text\":\". We look for teams whose technical ambitions match ours, whose work advances our capabilities, and whose approach to building AI is grounded in the same principles of safety and rigor that guide everything we do.\"}],\"markDefs\":[{\"_key\":\"c59c9b57844c\",\"_type\":\"link\",\"href\":\"https://www.anthropic.com/news/anthropic-acquires-bun-as-claude-code-reaches-usd1b-milestone\"}],\"style\":\"normal\"},{\"_key\":\"6a21ba16c772\",\"_type\":\"block\",\"children\":[{\"_key\":\"dc7925aabda4\",\"_type\":\"span\",\"marks\":[],\"text\":\"We’re also looking for individuals. If you're interested in joining Anthropic’s engineering team, visit our \"},{\"_key\":\"558e296cb70a\",\"_type\":\"span\",\"marks\":[\"4ce51115b19a\"],\"text\":\"careers page\"},{\"_key\":\"fdd41c58f0ac\",\"_type\":\"span\",\"marks\":[],\"text\":\".\"}],\"markDefs\":[{\"_key\":\"4ce51115b19a\",\"_type\":\"link\",\"href\":\"https://www.anthropic.com/jobs\"}],\"style\":\"normal\"}],\"footnotes\":{\"body\":\"$6:1:props:children:2:props:children:props:children:1:props:children:props:body\",\"count\":0,\"numberByListItemKey\":{},\"referenced\":\"$W1c\"},\"sidebar\":{\"isVisible\":false}}]}],\"$L1d\",\"$L1e\",\"$L1f\"]}]}],\"$L20\"]}]]\n9:null\ne:[[\"$\",\"title\",\"0\",{\"children\":\"Anthropic acquires Vercept \\\\ Anthropic\"}],[\"$\",\"meta\",\"1\",{\"name\":\"description\",\"content\":\"Anthropic has acquired Vercept to strengthen Claude's computer use capabilities. \"}],[\"$\",\"meta\",\"2\",{\"name\":\"msapplication-TileColor\",\"content\":\"141413\"}],[\"$\",\"meta\",\"3\",{\"name\":\"msapplication-config\",\"content\":\"/browserconfig.xml\"}],[\"$\",\"link\",\"4\",{\"rel\":\"canonical\",\"href\":\"https://www.anthropic.com/news/acquires-vercept\"}],[\"$\",\"meta\",\"5\",{\"name\":\"google-site-verification\",\"content\":\"BqiAW_sWOg-KrPk-Accxm6ge9dtnFEyV6DB6vzVZSGs\"}],[\"$\",\"meta\",\"6\",{\"property\":\"og:title\",\"content\":\"Anthropic acquires Vercept\"}],[\"$\",\"meta\",\"7\",{\"property\":\"og:description\",\"content\":\"Anthropic has acquired Vercept to strengthen Claude's computer use capabilities. \"}