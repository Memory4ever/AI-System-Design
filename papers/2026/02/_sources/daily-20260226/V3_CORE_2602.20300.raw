ter">affecting</span><span id="lstnumberx15.24" class="ltx_text ltx_lst_space ltx_font_typewriter"> </span><span id="lstnumberx15.25" class="ltx_text ltx_lst_identifier ltx_font_typewriter">the</span><span id="lstnumberx15.26" class="ltx_text ltx_lst_space ltx_font_typewriter"> </span><span id="lstnumberx15.27" class="ltx_text ltx_lst_identifier ltx_font_typewriter">main</span><span id="lstnumberx15.28" class="ltx_text ltx_lst_space ltx_font_typewriter"> </span><span id="lstnumberx15.29" class="ltx_text ltx_lst_identifier ltx_font_typewriter">predicate</span><span id="lstnumberx15.30" class="ltx_text ltx_font_typewriter">."</span>
