<td id="A7.T8.2.2.1" class="ltx_td ltx_align_left ltx_align_top ltx_border_t" style="padding-top:2.5pt;padding-bottom:2.5pt;">
<span id="A7.T8.2.2.1.1" class="ltx_inline-block ltx_align_top" style="width:42.7pt;">
<span id="A7.T8.2.2.1.1.1" class="ltx_p">Anaphora Usage</span>
</span></td>
<td id="A7.T8.2.2.2" class="ltx_td ltx_align_center ltx_border_t" style="padding-top:2.5pt;padding-bottom:2.5pt;">✓</td>
