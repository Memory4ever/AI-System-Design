<td id="A7.T7.2.3.1" class="ltx_td ltx_align_left" style="padding:2.5pt 8.0pt;">Anaphoric Reference</td>
<td id="A7.T7.2.3.2" class="ltx_td ltx_align_left ltx_align_top" style="padding:2.5pt 8.0pt;">
<span id="A7.T7.2.3.2.1" class="ltx_inline-block ltx_align_top" style="width:142.3pt;">
