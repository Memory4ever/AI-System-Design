</span></span><span id="S5.T8.2.2.1.3" class="ltx_text"></span></td>
<td id="S5.T8.2.2.2" class="ltx_td ltx_align_center ltx_border_t">15.07<math id="S5.T8.m1" class="ltx_Math" alttext="\%" display="inline" intent=":literal"><semantics><mo>%</mo><annotation encoding="application/x-tex">\%</annotation></semantics></math></td>
<td id="S5.T8.2.2.3" class="ltx_td ltx_align_center ltx_border_t">45.79<math id="S5.T8.m2" class="ltx_Math" alttext="\%" display="inline" intent=":literal"><semantics><mo>%</mo><annotation encoding="application/x-tex">\%</annotation></semantics></math></td></tr>
<tr id="S5.T8.2.3" class="ltx_tr">
<td id="S5.T8.2.3.1" class="ltx_td ltx_align_center ltx_border_r ltx_border_t"><span id="S5.T8.2.3.1.1" class="ltx_text"></span><span id="S5.T8.2.3.1.2" class="ltx_text">
<span id="S5.T8.2.3.1.2.1" class="ltx_tabular ltx_align_middle">
