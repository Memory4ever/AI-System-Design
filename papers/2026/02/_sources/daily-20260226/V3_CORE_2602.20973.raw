<td id="A7.T13.2.3.4" class="ltx_td ltx_align_center ltx_border_t">36.84</td>
<td id="A7.T13.2.3.5" class="ltx_td ltx_align_center ltx_border_t">-</td>
<td id="A7.T13.2.3.6" class="ltx_td ltx_align_center ltx_border_t">47.37</td></tr>
<tr id="A7.T13.2.4" class="ltx_tr">
<td id="A7.T13.2.4.1" class="ltx_td ltx_align_center ltx_border_r">Case</td>
<td id="A7.T13.2.4.2" class="ltx_td ltx_align_center">72.37</td>
<td id="A7.T13.2.4.3" class="ltx_td ltx_align_center">-</td>
<td id="A7.T13.2.4.4" class="ltx_td ltx_align_center">51.32</td>
<td id="A7.T13.2.4.5" class="ltx_td ltx_align_center">-</td></tr>
<tr id="A7.T13.2.5" class="ltx_tr">
