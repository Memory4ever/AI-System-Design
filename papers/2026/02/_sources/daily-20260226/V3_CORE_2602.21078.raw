<td id="S6.T3.8.8.4" class="ltx_td ltx_nopad_l ltx_nopad_r ltx_align_center" style="padding-left:0.8pt;padding-right:0.8pt;"><span id="S6.T3.8.8.4.1" class="ltx_text" style="font-size:70%;">124</span></td>
<td id="S6.T3.8.8.5" class="ltx_td ltx_nopad_l ltx_nopad_r ltx_align_center" style="padding-left:0.8pt;padding-right:0.8pt;"><math id="S6.T3.m24" class="ltx_Math" alttext="\times" display="inline" intent=":literal"><semantics><mo mathsize="0.700em">×</mo><annotation encoding="application/x-tex">\times</annotation></semantics></math><span id="S6.T3.8.8.5.1" class="ltx_text" style="font-size:70%;">1.95</span></td>
<td id="S6.T3.8.8.6" class="ltx_td ltx_nopad_l ltx_nopad_r ltx_align_center" style="padding-left:0.8pt;padding-right:0.8pt;"><span id="S6.T3.8.8.6.1" class="ltx_text" style="font-size:70%;">267</span></td>
<td id="S6.T3.8.8.7" class="ltx_td ltx_nopad_l ltx_nopad_r ltx_align_center" style="padding-left:0.8pt;padding-right:0.8pt;"><math id="S6.T3.m25" class="ltx_Math" alttext="\times" display="inline" intent=":literal"><semantics><mo mathsize="0.700em">×</mo><annotation encoding="application/x-tex">\times</annotation></semantics></math><span id="S6.T3.8.8.7.1" class="ltx_text" style="font-size:70%;">2.10</span></td></tr>
<tr id="S6.T3.8.9" class="ltx_tr">
<th id="S6.T3.8.9.1" class="ltx_td ltx_nopad_l ltx_nopad_r ltx_align_center ltx_th ltx_th_row ltx_border_bb" style="padding-left:0.8pt;padding-right:0.8pt;"><span id="S6.T3.8.9.1.1" class="ltx_text ltx_font_bold" style="font-size:70%;">ProxyFL</span></th>
<td id="S6.T3.8.9.2" class="ltx_td ltx_nopad_l ltx_nopad_r ltx_align_center ltx_border_bb" style="--ltx-bg-color:#E6E6E6;padding-left:0.8pt;padding-right:0.8pt;"><span id="S6.T3.8.9.2.1" class="ltx_text ltx_font_bold" style="font-size:70%;--ltx-bg-color:#E6E6E6;">45</span></td>
<td id="S6.T3.8.9.3" class="ltx_td ltx_nopad_l ltx_nopad_r ltx_align_center ltx_border_bb" style="--ltx-bg-color:#E6E6E6;padding-left:0.8pt;padding-right:0.8pt;"><math id="S6.T3.m26" class="ltx_Math" alttext="\times" display="inline" intent=":literal"><semantics><mo style="--ltx-bg-color:#E6E6E6;" mathbackground="#E6E6E6" mathsize="0.700em">×</mo><annotation encoding="application/x-tex">\times</annotation></semantics></math><span id="S6.T3.8.9.3.1" class="ltx_text ltx_font_bold" style="font-size:70%;--ltx-bg-color:#E6E6E6;">2.64</span></td>
<td id="S6.T3.8.9.4" class="ltx_td ltx_nopad_l ltx_nopad_r ltx_align_center ltx_border_bb" style="--ltx-bg-color:#E6E6E6;padding-left:0.8pt;padding-right:0.8pt;"><span id="S6.T3.8.9.4.1" class="ltx_text ltx_font_bold" style="font-size:70%;--ltx-bg-color:#E6E6E6;">89</span></td>
