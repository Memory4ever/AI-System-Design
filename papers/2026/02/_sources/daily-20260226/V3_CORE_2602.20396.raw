<span id="S4.F4.3.5.3.1.1" class="ltx_p ltx_align_center"><math id="S4.F4.m6" class="ltx_Math" alttext="I_{\mathrm{do}(B)}(G)" display="inline" intent=":literal"><semantics><mrow><msub><mi>I</mi><mrow><mi>do</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>B</mi><mo stretchy="false">)</mo></mrow></mrow></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>G</mi><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">I_{\mathrm{do}(B)}(G)</annotation></semantics></math></span>
</span></td></tr>
