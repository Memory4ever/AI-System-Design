</span></span></span></span></foreignObject></g><g fill-opacity="1.0" transform="matrix(1.0 0.0 0.0 1.0 12.93 12.93)"><foreignObject style="--ltx-fo-width:38.39em;--ltx-fo-height:34.68em;--ltx-fo-depth:0.2em;font-size:10pt;" height="482.7" overflow="visible" transform="matrix(1 0 0 -1 0 479.93)" width="531.21"><span class="ltx_foreignobject_container"><span class="ltx_foreignobject_content">
