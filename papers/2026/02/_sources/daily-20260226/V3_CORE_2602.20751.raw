<span id="S3.SS3.p7.pic1.2.2.2.1" class="ltx_td ltx_align_left ltx_align_top ltx_border_t" style="padding:0.5pt 4.0pt;">
<span id="S3.SS3.p7.pic1.2.2.2.1.1" class="ltx_inline-block ltx_align_top" style="width:78.3pt;">
<span id="S3.SS3.p7.pic1.2.2.2.1.1.1" class="ltx_p ltx_align_left"><span id="S3.SS3.p7.pic1.2.2.2.1.1.1.1" class="ltx_text" style="font-size:80%;--ltx-fg-color:#000000;">Formatting / presentation</span></span>
</span></span>
<span id="S3.SS3.p7.pic1.2.2.2.2" class="ltx_td ltx_align_left ltx_border_t" style="padding:0.5pt 4.0pt;">
