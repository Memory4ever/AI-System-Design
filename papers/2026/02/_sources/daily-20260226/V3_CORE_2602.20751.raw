<span id="S3.SS3.p7.pic1.2.2.2.3.1.1" class="ltx_p ltx_align_left"><span id="S3.SS3.p7.pic1.2.2.2.3.1.1.1" class="ltx_text" style="font-size:80%;--ltx-fg-color:#000000;">up to </span><math id="S3.SS3.p7.pic1.m1" class="ltx_Math" alttext="+1.000" display="inline" intent=":literal"><semantics><mrow><mo style="--ltx-fg-color:#000000;" mathcolor="#000000" mathsize="0.800em">+</mo><mn style="--ltx-fg-color:#000000;" mathcolor="#000000" mathsize="0.800em">1.000</mn></mrow><annotation encoding="application/x-tex">+1.000</annotation></semantics></math></span>
</span></span></span>
<span id="S3.SS3.p7.pic1.2.2.3" class="ltx_tr">
<span id="S3.SS3.p7.pic1.2.2.3.1" class="ltx_td ltx_align_left ltx_align_top" style="padding:0.5pt 4.0pt;">
<span id="S3.SS3.p7.pic1.2.2.3.1.1" class="ltx_inline-block ltx_align_top" style="width:78.3pt;">
<span id="S3.SS3.p7.pic1.2.2.3.1.1.1" class="ltx_p ltx_align_left"><span id="S3.SS3.p7.pic1.2.2.3.1.1.1.1" class="ltx_text" style="font-size:80%;--ltx-fg-color:#000000;">Avoiding extraneous details</span></span>
</span></span>
<span id="S3.SS3.p7.pic1.2.2.3.2" class="ltx_td ltx_align_left" style="padding:0.5pt 4.0pt;">
<span id="S3.SS3.p7.pic1.2.2.3.2.1" class="ltx_inline-block ltx_align_top">
<span id="S3.SS3.p7.pic1.2.2.3.2.1.1" class="ltx_p ltx_align_left"><span id="S3.SS3.p7.pic1.2.2.3.2.1.1.1" class="ltx_text" style="font-size:80%;--ltx-fg-color:#000000;">“Avoids excessive detail on adjunctive therapies or extended criteria not explicitly requested.”; “Limits explanations to directly relevant clinical criteria …without extraneous details.”</span></span>
</span></span>
<span id="S3.SS3.p7.pic1.2.2.3.3" class="ltx_td ltx_nopad_r ltx_align_left ltx_align_top" style="padding:0.5pt 4.0pt;">
