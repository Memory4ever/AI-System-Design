  <li class="arxiv-result">
    <div class="is-marginless">
      <p class="list-title is-inline-block"><a href="https://arxiv.org/abs/2602.21496">arXiv:2602.21496</a>
        <span>&nbsp;[<a href="https://arxiv.org/pdf/2602.21496">pdf</a>, <a href="https://arxiv.org/ps/2602.21496">ps</a>, <a href="https://arxiv.org/format/2602.21496">other</a>]&nbsp;</span>
