        <span>&nbsp;[<a href="https://arxiv.org/pdf/2602.20566">pdf</a>, <a href="https://arxiv.org/ps/2602.20566">ps</a>, <a href="https://arxiv.org/format/2602.20566">other</a>]&nbsp;</span>
