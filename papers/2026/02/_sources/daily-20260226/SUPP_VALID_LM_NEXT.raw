  <li class="arxiv-result">
    <div class="is-marginless">
      <p class="list-title is-inline-block"><a href="https://arxiv.org/abs/2602.22242">arXiv:2602.22242</a>
        <span>&nbsp;[<a href="https://arxiv.org/pdf/2602.22242">pdf</a>, <a href="https://arxiv.org/ps/2602.22242">ps</a>, <a href="https://arxiv.org/format/2602.22242">other</a>]&nbsp;</span>
