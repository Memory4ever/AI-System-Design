        <span>&nbsp;[<a href="https://arxiv.org/pdf/2602.21461">pdf</a>, <a href="https://arxiv.org/ps/2602.21461">ps</a>, <a href="https://arxiv.org/format/2602.21461">other</a>]&nbsp;</span>
