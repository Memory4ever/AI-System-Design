        <span>&nbsp;[<a href="https://arxiv.org/pdf/2602.21144">pdf</a>, <a href="https://arxiv.org/ps/2602.21144">ps</a>, <a href="https://arxiv.org/format/2602.21144">other</a>]&nbsp;</span>
