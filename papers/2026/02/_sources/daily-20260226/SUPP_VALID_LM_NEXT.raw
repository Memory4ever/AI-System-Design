      <a href="/search/?searchtype=author&amp;query=Olausson%2C+T+X">Theo X. Olausson</a>, 
      
      <a href="/search/?searchtype=author&amp;query=Hjelm%2C+D">Devon Hjelm</a>, 
      
      <a href="/search/?searchtype=author&amp;query=Dixon%2C+P">Paul Dixon</a>, 
      
      <a href="/search/?searchtype=author&amp;query=Monteiro%2C+J">Joao Monteiro</a>, 
      
      <a href="/search/?searchtype=author&amp;query=Ablin%2C+P">Pierre Ablin</a>, 
      
      <a href="/search/?searchtype=author&amp;query=Banna%2C+V">Vishnu Banna</a>, 
      
      <a href="/search/?searchtype=author&amp;query=Blaas%2C+A">Arno Blaas</a>, 
      
      <a href="/search/?searchtype=author&amp;query=Henderson%2C+N">Nick Henderson</a>, 
      
      <a href="/search/?searchtype=author&amp;query=Noriy%2C+K">Kari Noriy</a>, 
      
      <a href="/search/?searchtype=author&amp;query=Busbridge%2C+D">Dan Busbridge</a>, 
      
      <a href="/search/?searchtype=author&amp;query=Susskind%2C+J">Josh Susskind</a>, 
      
      <a href="/search/?searchtype=author&amp;query=Cuturi%2C+M">Marco Cuturi</a>, 
      
      <a href="/search/?searchtype=author&amp;query=Belousova%2C+I">Irina Belousova</a>, 
      
