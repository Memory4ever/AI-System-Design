      <a href="/search/?searchtype=author&amp;query=Paul%2C+D">Debjit Paul</a>, 
      
      <a href="/search/?searchtype=author&amp;query=Murphy%2C+D">Daniel Murphy</a>, 
      
      <a href="/search/?searchtype=author&amp;query=Gritta%2C+M">Milan Gritta</a>, 
      
