        <span>&nbsp;[<a href="https://arxiv.org/pdf/2602.20749">pdf</a>, <a href="https://arxiv.org/ps/2602.20749">ps</a>, <a href="https://arxiv.org/format/2602.20749">other</a>]&nbsp;</span>
