  <li class="arxiv-result">
    <div class="is-marginless">
      <p class="list-title is-inline-block"><a href="https://arxiv.org/abs/2603.19252">arXiv:2603.19252</a>
        <span>&nbsp;[<a href="https://arxiv.org/pdf/2603.19252">pdf</a>, <a href="https://arxiv.org/ps/2603.19252">ps</a>, <a href="https://arxiv.org/format/2603.19252">other</a>]&nbsp;</span>
      </p>
      <div class="tags is-inline-block">
