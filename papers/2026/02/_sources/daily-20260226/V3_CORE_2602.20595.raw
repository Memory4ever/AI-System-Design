<section id="A1" class="ltx_appendix">
<h2 class="ltx_title ltx_title_appendix"><span class="ltx_tag ltx_tag_appendix">Appendix A </span><span id="A1.2" class="ltx_text" style="--ltx-fg-color:#000000;">Algorithm Procedure of <span id="A1.2.1" class="ltx_text ltx_markedasmath ltx_font_smallcaps">OptiLeak</span></span></h2>

<figure id="alg1" class="ltx_float ltx_algorithm ltx_minipage ltx_align_center ltx_align_middle ltx_framed ltx_framed_top" style="width:327.8pt;">
<figcaption class="ltx_caption" style="font-size:90%;"><span class="ltx_tag ltx_tag_float"><span id="alg1.7" class="ltx_text ltx_font_bold">Algorithm 1</span> </span> Operation pipeline of <span id="alg1.8" class="ltx_text ltx_markedasmath ltx_font_smallcaps">OptiLeak</span> </figcaption>
<div id="alg1.9" class="ltx_listing ltx_lst_numbers_left ltx_framed ltx_framed_topbottom ltx_listing">
<div id="alg1.9.1" class="ltx_listingline"><span id="alg1.9.1.1" class="ltx_text" style="font-size:90%;">
</span>
</div>
<div id="alg1.9.2" class="ltx_listingline"><span id="alg1.9.2.1" class="ltx_text" style="font-size:90%;"><span id="alg1.9.2.1.1" class="ltx_text ltx_font_bold">Input:</span> </span><span id="alg1.9.2.2" class="ltx_text" style="font-size:90%;">Auxiliary dataset </span><math id="alg1.m3" class="ltx_Math" alttext="\mathcal{D}_{\text{aux}}" display="inline" intent=":literal"><semantics><msub><mi class="ltx_font_mathcaligraphic" mathsize="0.900em">𝒟</mi><mtext mathsize="0.900em">aux</mtext></msub><annotation encoding="application/x-tex">\mathcal{D}_{\text{aux}}</annotation></semantics></math><span id="alg1.9.2.3" class="ltx_text" style="font-size:90%;">, base adversarial model </span><math id="alg1.m4" class="ltx_Math" alttext="\pi_{\text{base}}" display="inline" intent=":literal"><semantics><msub><mi mathsize="0.900em">π</mi><mtext mathsize="0.900em">base</mtext></msub><annotation encoding="application/x-tex">\pi_{\text{base}}</annotation></semantics></math><span id="alg1.9.2.4" class="ltx_text" style="font-size:90%;">, hard token threshold </span><math id="alg1.m5" class="ltx_Math" alttext="\gamma" display="inline" intent=":literal"><semantics><mi mathsize="0.900em">γ</mi><annotation encoding="application/x-tex">\gamma</annotation></semantics></math><span id="alg1.9.2.5" class="ltx_text" style="font-size:90%;">, max guess attempts per token </span><math id="alg1.m6" class="ltx_Math" alttext="\kappa" display="inline" intent=":literal"><semantics><mi mathsize="0.900em">κ</mi><annotation encoding="application/x-tex">\kappa</annotation></semantics></math><span id="alg1.9.2.6" class="ltx_text" style="font-size:90%;">.</span>
</div>
<div id="alg1.9.3" class="ltx_listingline"><span id="alg1.9.3.1" class="ltx_text" style="font-size:90%;"><span id="alg1.9.3.1.1" class="ltx_text ltx_font_bold">Output:</span> </span><span id="alg1.9.3.2" class="ltx_text" style="font-size:90%;">Recovered target query </span><math id="alg1.m7" class="ltx_Math" alttext="s^{\text{recover}}" display="inline" intent=":literal"><semantics><msup><mi mathsize="0.900em">s</mi><mtext mathsize="0.900em">recover</mtext></msup><annotation encoding="application/x-tex">s^{\text{recover}}</annotation></semantics></math><span id="alg1.9.3.3" class="ltx_text" style="font-size:90%;">.</span>
</div>
<div id="alg1.9.4" class="ltx_listingline"><span id="alg1.9.4.1" class="ltx_text ltx_font_typewriter" style="font-size:90%;">/* </span><span id="alg1.9.4.2" class="ltx_text ltx_font_typewriter" style="font-size:90%;">Phase 1: Local model training  */</span>
</div>
<div id="alg1.9.5" class="ltx_listingline">
            <span class="ltx_tag ltx_tag_listingline"><span id="alg1.9.5.1" class="ltx_text ltx_font_bold" style="font-size:90%;">1</span></span>
          <span id="alg1.9.5.2" class="ltx_text" style="font-size:90%;">Initialize preference dataset </span><math id="alg1.m8" class="ltx_Math" alttext="\mathcal{D}_{\text{pref}}\leftarrow\emptyset" display="inline" intent=":literal"><semantics><mrow><msub><mi class="ltx_font_mathcaligraphic" mathsize="0.900em">𝒟</mi><mtext mathsize="0.900em">pref</mtext></msub><mo mathsize="0.900em" stretchy="false">←</mo><mi mathsize="0.900em" mathvariant="normal">∅</mi></mrow><annotation encoding="application/x-tex">\mathcal{D}_{\text{pref}}\leftarrow\emptyset</annotation></semantics></math><span id="alg1.9.5.3" class="ltx_text" style="font-size:90%;">;</span>
</div>
<div id="alg1.9.6" class="ltx_listingline">
            <span class="ltx_tag ltx_tag_listingline"><span id="alg1.9.6.1" class="ltx_text ltx_font_bold" style="font-size:90%;">2</span></span>
          <math id="alg1.m9" class="ltx_Math" alttext="\pi_{\text{SFT}}\leftarrow\text{Supervised finetune }(\pi_{\text{base}},\mathcal{D}_{\text{aux}})" display="inline" intent=":literal"><semantics><mrow><msub><mi mathsize="0.900em">π</mi><mtext mathsize="0.900em">SFT</mtext></msub><mo mathsize="0.900em" stretchy="false">←</mo><mrow><mtext mathsize="0.900em">Supervised finetune </mtext><mo lspace="0em" rspace="0em">​</mo><mrow><mo maxsize="0.900em" minsize="0.900em">(</mo><msub><mi mathsize="0.900em">π</mi><mtext mathsize="0.900em">base</mtext></msub><mo mathsize="0.900em">,</mo><msub><mi class="ltx_font_mathcaligraphic" mathsize="0.900em">𝒟</mi><mtext mathsize="0.900em">aux</mtext></msub><mo maxsize="0.900em" minsize="0.900em">)</mo></mrow></mrow></mrow><annotation encoding="application/x-tex">\pi_{\text{SFT}}\leftarrow\text{Supervised finetune }(\pi_{\text{base}},\mathcal{D}_{\text{aux}})</annotation></semantics></math><span id="alg1.9.6.2" class="ltx_text" style="font-size:90%;">;</span>
</div>
<div id="alg1.9.7" class="ltx_listingline">
            <span class="ltx_tag ltx_tag_listingline"><span id="alg1.9.7.1" class="ltx_text ltx_font_bold" style="font-size:90%;">3</span></span>
          <span id="alg1.9.7.2" class="ltx_text ltx_font_bold" style="font-size:90%;">foreach</span><span id="alg1.9.7.3" class="ltx_text" style="font-size:90%;"> </span><em id="alg1.9.7.4" class="ltx_emph ltx_font_italic" style="font-size:90%;">Query <math id="alg1.m10" class="ltx_Math" alttext="s\in\mathcal{D}_{\text{aux}}" display="inline" intent=":literal"><semantics><mrow><mi>s</mi><mo>∈</mo><msub><mi class="ltx_font_mathcaligraphic">𝒟</mi><mtext class="ltx_mathvariant_italic">aux</mtext></msub></mrow><annotation encoding="application/x-tex">s\in\mathcal{D}_{\text{aux}}</annotation></semantics></math></em><span id="alg1.9.7.5" class="ltx_text" style="font-size:90%;"> </span><span id="alg1.9.7.6" class="ltx_text ltx_font_bold" style="font-size:90%;">do</span>
</div>
<div id="alg1.9.8" class="ltx_listingline"><span id="alg1.9.8.1" class="ltx_text" style="font-size:90%;"> </span><span class="ltx_rule" style="width:1px;height:100%;--ltx-bg-color:black;display:inline-block;"> </span><span id="alg1.9.8.2" class="ltx_text" style="font-size:90%;">  </span>
            <span class="ltx_tag ltx_tag_listingline"><span id="alg1.9.8.3" class="ltx_text ltx_font_bold" style="font-size:90%;">4</span></span>
          <span id="alg1.9.8.4" class="ltx_text ltx_font_bold" style="font-size:90%;">foreach</span><span id="alg1.9.8.5" class="ltx_text" style="font-size:90%;"> </span><em id="alg1.9.8.6" class="ltx_emph ltx_font_italic" style="font-size:90%;">Token <math id="alg1.m11" class="ltx_Math" alttext="s_{t}\in s" display="inline" intent=":literal"><semantics><mrow><msub><mi>s</mi><mi>t</mi></msub><mo>∈</mo><mi>s</mi></mrow><annotation encoding="application/x-tex">s_{t}\in s</annotation></semantics></math></em><span id="alg1.9.8.7" class="ltx_text" style="font-size:90%;"> </span><span id="alg1.9.8.8" class="ltx_text ltx_font_bold" style="font-size:90%;">do</span>
</div>
