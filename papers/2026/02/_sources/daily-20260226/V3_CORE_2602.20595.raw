            <span class="ltx_tag ltx_tag_listingline"><span id="alg1.9.24.3" class="ltx_text ltx_font_bold" style="font-size:90%;">19</span></span>
          <span id="alg1.9.24.4" class="ltx_text ltx_font_bold" style="font-size:90%;">if</span><span id="alg1.9.24.5" class="ltx_text" style="font-size:90%;"> </span><em id="alg1.9.24.6" class="ltx_emph ltx_font_italic" style="font-size:90%;"><math id="alg1.m26" class="ltx_Math" alttext="\mathsf{D_{\text{hit}}}=1" display="inline" intent=":literal"><semantics><mrow><msub><mi>𝖣</mi><mtext class="ltx_mathvariant_italic">hit</mtext></msub><mo>=</mo><mn>1</mn></mrow><annotation encoding="application/x-tex">\mathsf{D_{\text{hit}}}=1</annotation></semantics></math></em><span id="alg1.9.24.7" class="ltx_text" style="font-size:90%;"> </span><span id="alg1.9.24.8" class="ltx_text ltx_font_bold" style="font-size:90%;">then</span>
</div>
<div id="alg1.9.25" class="ltx_listingline"><span id="alg1.9.25.1" class="ltx_text" style="font-size:90%;"> </span><span class="ltx_rule" style="width:1px;height:100%;--ltx-bg-color:black;display:inline-block;"> </span><span id="alg1.9.25.2" class="ltx_text" style="font-size:90%;">   </span><span class="ltx_rule" style="width:1px;height:100%;--ltx-bg-color:black;display:inline-block;"> </span><span id="alg1.9.25.3" class="ltx_text" style="font-size:90%;">  </span>
            <span class="ltx_tag ltx_tag_listingline"><span id="alg1.9.25.4" class="ltx_text ltx_font_bold" style="font-size:90%;">20</span></span>
          <span id="alg1.9.25.5" class="ltx_text" style="font-size:90%;">Append token </span><math id="alg1.m27" class="ltx_Math" alttext="\tilde{q}" display="inline" intent=":literal"><semantics><mover accent="true"><mi mathsize="0.900em">q</mi><mo>~</mo></mover><annotation encoding="application/x-tex">\tilde{q}</annotation></semantics></math><span id="alg1.9.25.6" class="ltx_text" style="font-size:90%;"> to </span><math id="alg1.m28" class="ltx_Math" alttext="s^{\text{recover}}" display="inline" intent=":literal"><semantics><msup><mi mathsize="0.900em">s</mi><mtext mathsize="0.900em">recover</mtext></msup><annotation encoding="application/x-tex">s^{\text{recover}}</annotation></semantics></math><span id="alg1.9.25.7" class="ltx_text" style="font-size:90%;">;</span>
</div>
<div id="alg1.9.26" class="ltx_listingline"><span id="alg1.9.26.1" class="ltx_text" style="font-size:90%;"> </span><span class="ltx_rule" style="width:1px;height:100%;--ltx-bg-color:black;display:inline-block;"> </span><span id="alg1.9.26.2" class="ltx_text" style="font-size:90%;">  </span>
