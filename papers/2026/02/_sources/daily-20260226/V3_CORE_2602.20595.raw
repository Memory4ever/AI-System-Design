<td id="S5.T2.6.1.5.2" class="ltx_td ltx_nopad_r ltx_align_center">21.60 (48.6 %<math id="S5.T2.m4" class="ltx_Math" alttext="\downarrow" display="inline" intent=":literal"><semantics><mo stretchy="false">↓</mo><annotation encoding="application/x-tex">\downarrow</annotation></semantics></math>)</td></tr>
<tr id="S5.T2.6.1.6" class="ltx_tr">
<td id="S5.T2.6.1.6.1" class="ltx_td ltx_align_center ltx_border_bb ltx_border_t" rowspan="4"><span id="S5.T2.6.1.6.1.1" class="ltx_text">PubMedQA</span></td>
<td id="S5.T2.6.1.6.2" class="ltx_td ltx_align_center ltx_border_t">Base</td>
