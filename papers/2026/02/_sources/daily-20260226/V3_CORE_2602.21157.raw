</div>
<div id="alg2.4.13" class="ltx_listingline"> <span class="ltx_rule" style="width:1px;height:100%;--ltx-bg-color:black;display:inline-block;"> </span> <math id="alg2.m14" class="ltx_Math" alttext="s\leftarrow s_{t}" display="inline" intent=":literal"><semantics><mrow><mi>s</mi><mo stretchy="false">←</mo><msub><mi>s</mi><mi>t</mi></msub></mrow><annotation encoding="application/x-tex">s\leftarrow s_{t}</annotation></semantics></math> ;
