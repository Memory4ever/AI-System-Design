<td id="S3.T1.5.1.4.4" class="ltx_td ltx_align_center" style="padding-top:-0.5pt;padding-bottom:-0.5pt;">77</td>
<td id="S3.T1.5.1.4.5" class="ltx_td ltx_align_center" style="padding-top:-0.5pt;padding-bottom:-0.5pt;">37</td>
<td id="S3.T1.5.1.4.6" class="ltx_td ltx_align_center" style="padding-top:-0.5pt;padding-bottom:-0.5pt;">42</td>
