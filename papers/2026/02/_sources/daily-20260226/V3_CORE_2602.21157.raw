<td id="S3.T1.5.1.2.2" class="ltx_td ltx_align_center ltx_border_t" style="padding-top:-0.5pt;padding-bottom:-0.5pt;"><span id="S3.T1.5.1.2.2.1" class="ltx_text ltx_font_bold">Hard</span></td>
<td id="S3.T1.5.1.2.3" class="ltx_td ltx_align_center ltx_border_t" style="padding-top:-0.5pt;padding-bottom:-0.5pt;"><span id="S3.T1.5.1.2.3.1" class="ltx_text ltx_font_bold">Easy</span></td>
<td id="S3.T1.5.1.2.4" class="ltx_td ltx_align_center ltx_border_t" style="padding-top:-0.5pt;padding-bottom:-0.5pt;"><span id="S3.T1.5.1.2.4.1" class="ltx_text ltx_font_bold">Hard</span></td>
