<td id="S4.T2.4.1.5.1" class="ltx_td ltx_align_left" style="padding-left:8.0pt;padding-right:8.0pt;"><span id="S4.T2.4.1.5.1.1" class="ltx_text ltx_font_bold" style="--ltx-bg-color:#F2FFF2;">4. Intersection<span id="S4.T2.4.1.5.1.1.1" class="ltx_text ltx_font_medium"> (<math id="S4.T2.m4" class="ltx_Math" alttext="|\mathcal{S}_{q}^{\cap}|" display="inline" intent=":literal"><semantics><mrow><mo style="--ltx-bg-color:#F2FFF2;" mathbackground="#F2FFF2" stretchy="false">|</mo><msubsup><mi style="--ltx-bg-color:#F2FFF2;" class="ltx_font_mathcaligraphic" mathbackground="#F2FFF2">𝒮</mi><mi style="--ltx-bg-color:#F2FFF2;" mathbackground="#F2FFF2">q</mi><mo style="--ltx-bg-color:#F2FFF2;" mathbackground="#F2FFF2">∩</mo></msubsup><mo style="--ltx-bg-color:#F2FFF2;" mathbackground="#F2FFF2" stretchy="false">|</mo></mrow><annotation encoding="application/x-tex">|\mathcal{S}_{q}^{\cap}|</annotation></semantics></math>)</span></span></td>
