<td id="S4.T2.4.1.4.1" class="ltx_td ltx_align_left" style="padding-left:8.0pt;padding-right:8.0pt;">3. Judge B Valid (<math id="S4.T2.m3" class="ltx_Math" alttext="|\mathcal{S}_{q}^{B}|" display="inline" intent=":literal"><semantics><mrow><mo stretchy="false">|</mo><msubsup><mi class="ltx_font_mathcaligraphic">𝒮</mi><mi>q</mi><mi>B</mi></msubsup><mo stretchy="false">|</mo></mrow><annotation encoding="application/x-tex">|\mathcal{S}_{q}^{B}|</annotation></semantics></math>)</td>
