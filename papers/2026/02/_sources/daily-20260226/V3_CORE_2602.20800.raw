<td id="S4.T2.4.1.5.3" class="ltx_td ltx_align_right" style="padding-left:8.0pt;padding-right:8.0pt;"><span id="S4.T2.4.1.5.3.1" class="ltx_text ltx_font_bold" style="--ltx-bg-color:#F2FFF2;">51</span></td>
