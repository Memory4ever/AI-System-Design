<td id="S4.T2.4.1.3.1" class="ltx_td ltx_align_left" style="padding-left:8.0pt;padding-right:8.0pt;">2. Judge A Valid (<math id="S4.T2.m2" class="ltx_Math" alttext="|\mathcal{S}_{q}^{A}|" display="inline" intent=":literal"><semantics><mrow><mo stretchy="false">|</mo><msubsup><mi class="ltx_font_mathcaligraphic">𝒮</mi><mi>q</mi><mi>A</mi></msubsup><mo stretchy="false">|</mo></mrow><annotation encoding="application/x-tex">|\mathcal{S}_{q}^{A}|</annotation></semantics></math>)</td>
<td id="S4.T2.4.1.3.2" class="ltx_td ltx_align_right" style="padding-left:8.0pt;padding-right:8.0pt;">20</td>
<td id="S4.T2.4.1.3.3" class="ltx_td ltx_align_right" style="padding-left:8.0pt;padding-right:8.0pt;">69</td>
<td id="S4.T2.4.1.3.4" class="ltx_td ltx_align_right" style="padding-left:8.0pt;padding-right:8.0pt;">70.7</td>
