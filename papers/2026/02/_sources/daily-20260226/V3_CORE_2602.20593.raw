          <span id="alg1.l14.2" class="ltx_text" style="font-size:90%;">    </span><math id="alg1.l14.m1" class="ltx_Math" alttext="\left\{\hat{y}_{i}\right\}_{i=1}^{N}=\mathrm{Infer}\left(\left\{\mathrm{emb}_{i}^{a}\right\}_{i=1}^{N},\left\{\overline{\mathrm{aux}}_{i}\right\}_{i=1}^{|l|},|l|\right)" display="inline" intent=":literal"><semantics><mrow><msubsup><mrow><mo>{</mo><msub><mover accent="true"><mi mathsize="0.900em">y</mi><mo mathsize="0.900em">^</mo></mover><mi mathsize="0.900em">i</mi></msub><mo>}</mo></mrow><mrow><mi mathsize="0.900em">i</mi><mo mathsize="0.900em">=</mo><mn mathsize="0.900em">1</mn></mrow><mi mathsize="0.900em">N</mi></msubsup><mo mathsize="0.900em">=</mo><mrow><mi mathsize="0.900em">Infer</mi><mo>⁡</mo><mrow><mo>(</mo><msubsup><mrow><mo>{</mo><msubsup><mi mathsize="0.900em">emb</mi><mi mathsize="0.900em">i</mi><mi mathsize="0.900em">a</mi></msubsup><mo>}</mo></mrow><mrow><mi mathsize="0.900em">i</mi><mo mathsize="0.900em">=</mo><mn mathsize="0.900em">1</mn></mrow><mi mathsize="0.900em">N</mi></msubsup><mo mathsize="0.900em">,</mo><msubsup><mrow><mo>{</mo><msub><mover accent="true"><mi mathsize="0.900em">aux</mi><mo stretchy="true">¯</mo></mover><mi mathsize="0.900em">i</mi></msub><mo>}</mo></mrow><mrow><mi mathsize="0.900em">i</mi><mo mathsize="0.900em">=</mo><mn mathsize="0.900em">1</mn></mrow><mrow><mo maxsize="0.900em" minsize="0.900em" stretchy="true">|</mo><mi mathsize="0.900em">l</mi><mo maxsize="0.900em" minsize="0.900em" stretchy="true">|</mo></mrow></msubsup><mo mathsize="0.900em">,</mo><mrow><mo maxsize="0.900em" minsize="0.900em" stretchy="true">|</mo><mi mathsize="0.900em">l</mi><mo maxsize="0.900em" minsize="0.900em" stretchy="true">|</mo></mrow><mo>)</mo></mrow></mrow></mrow><annotation encoding="application/x-tex">\left\{\hat{y}_{i}\right\}_{i=1}^{N}=\mathrm{Infer}\left(\left\{\mathrm{emb}_{i}^{a}\right\}_{i=1}^{N},\left\{\overline{\mathrm{aux}}_{i}\right\}_{i=1}^{|l|},|l|\right)</annotation></semantics></math><span id="alg1.l14.3" class="ltx_text" style="font-size:90%;">.
