<th id="S4.T3.1.1.4" class="ltx_td ltx_align_center ltx_th ltx_th_column ltx_border_tt">rASR</th></tr>
</thead>
<tbody class="ltx_tbody">
<tr id="S4.T3.1.2" class="ltx_tr">
<th id="S4.T3.1.2.1" class="ltx_td ltx_align_center ltx_th ltx_th_row ltx_border_t" rowspan="5"><span id="S4.T3.1.2.1.1" class="ltx_text">MNIST</span></th>
<th id="S4.T3.1.2.2" class="ltx_td ltx_align_center ltx_th ltx_th_row ltx_border_t">None</th>
<td id="S4.T3.1.2.3" class="ltx_td ltx_align_center ltx_border_t"><math id="S4.T3.m1" class="ltx_Math" alttext="93.97\pm 3.97\%" display="inline" intent=":literal"><semantics><mrow><mn>93.97</mn><mo>±</mo><mrow><mn>3.97</mn><mo mathsize="0.900em">%</mo></mrow></mrow><annotation encoding="application/x-tex">93.97\pm 3.97\%</annotation></semantics></math></td>
<td id="S4.T3.1.2.4" class="ltx_td ltx_align_center ltx_border_t"><math id="S4.T3.m2" class="ltx_Math" alttext="94.47\pm 7.17\%" display="inline" intent=":literal"><semantics><mrow><mn>94.47</mn><mo>±</mo><mrow><mn>7.17</mn><mo mathsize="0.900em">%</mo></mrow></mrow><annotation encoding="application/x-tex">94.47\pm 7.17\%</annotation></semantics></math></td></tr>
<tr id="S4.T3.1.3" class="ltx_tr">
<th id="S4.T3.1.3.1" class="ltx_td ltx_align_center ltx_th ltx_th_row">Marvell</th>
<td id="S4.T3.1.3.2" class="ltx_td ltx_align_center"><math id="S4.T3.m3" class="ltx_Math" alttext="80.30\pm 9.33\%" display="inline" intent=":literal"><semantics><mrow><mn>80.30</mn><mo>±</mo><mrow><mn>9.33</mn><mo mathsize="0.900em">%</mo></mrow></mrow><annotation encoding="application/x-tex">80.30\pm 9.33\%</annotation></semantics></math></td>
<td id="S4.T3.1.3.3" class="ltx_td ltx_align_center"><math id="S4.T3.m4" class="ltx_Math" alttext="84.61\pm 11.64\%" display="inline" intent=":literal"><semantics><mrow><mn>84.61</mn><mo>±</mo><mrow><mn>11.64</mn><mo mathsize="0.900em">%</mo></mrow></mrow><annotation encoding="application/x-tex">84.61\pm 11.64\%</annotation></semantics></math></td></tr>
