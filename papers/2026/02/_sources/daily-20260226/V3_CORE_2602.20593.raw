<td id="S4.T1.1.4.3" class="ltx_td ltx_align_center" style="padding-left:3.6pt;padding-right:3.6pt;"><math id="S4.T1.m9" class="ltx_Math" alttext="75.47\pm 5.82\%" display="inline" intent=":literal"><semantics><mrow><mn>75.47</mn><mo>±</mo><mrow><mn>5.82</mn><mo mathsize="0.900em">%</mo></mrow></mrow><annotation encoding="application/x-tex">75.47\pm 5.82\%</annotation></semantics></math></td>
