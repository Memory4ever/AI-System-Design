          <span id="alg1.l13.2" class="ltx_text" style="font-size:90%;">    Calculate the mean embeddings </span><math id="alg1.l13.m1" class="ltx_Math" alttext="\left\{\overline{\mathrm{aux}}_{i}\right\}_{i=1}^{|l|}" display="inline" intent=":literal"><semantics><msubsup><mrow><mo>{</mo><msub><mover accent="true"><mi mathsize="0.900em">aux</mi><mo stretchy="true">¯</mo></mover><mi mathsize="0.900em">i</mi></msub><mo>}</mo></mrow><mrow><mi mathsize="0.900em">i</mi><mo mathsize="0.900em">=</mo><mn mathsize="0.900em">1</mn></mrow><mrow><mo maxsize="0.900em" minsize="0.900em" stretchy="true">|</mo><mi mathsize="0.900em">l</mi><mo maxsize="0.900em" minsize="0.900em" stretchy="true">|</mo></mrow></msubsup><annotation encoding="application/x-tex">\left\{\overline{\mathrm{aux}}_{i}\right\}_{i=1}^{|l|}</annotation></semantics></math><span id="alg1.l13.3" class="ltx_text" style="font-size:90%;"> for the auxiliary data associated with each label </span><math id="alg1.l13.m2" class="ltx_Math" alttext="l_{i}" display="inline" intent=":literal"><semantics><msub><mi mathsize="0.900em">l</mi><mi mathsize="0.900em">i</mi></msub><annotation encoding="application/x-tex">l_{i}</annotation></semantics></math><span id="alg1.l13.4" class="ltx_text" style="font-size:90%;">.
</span>
