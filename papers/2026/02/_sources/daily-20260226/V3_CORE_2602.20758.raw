<td id="A2.T3.3.3.7" class="ltx_td ltx_align_center ltx_border_r"><span id="A2.T3.3.3.7.1" class="ltx_text" style="--ltx-bg-color:#F0F0F0;">11.72</span></td></tr>
<tr id="A2.T3.3.4" class="ltx_tr" style="--ltx-bg-color:#F0F0F0;">
<td id="A2.T3.3.4.1" class="ltx_td ltx_align_center ltx_border_l ltx_border_r"><span id="A2.T3.3.4.1.1" class="ltx_text" style="--ltx-bg-color:#F0F0F0;">U-SGS (16)</span></td>
<td id="A2.T3.3.4.2" class="ltx_td ltx_align_center"><span id="A2.T3.3.4.2.1" class="ltx_text" style="--ltx-bg-color:#F0F0F0;">23.78</span></td>
<td id="A2.T3.3.4.3" class="ltx_td ltx_align_center"><span id="A2.T3.3.4.3.1" class="ltx_text" style="--ltx-bg-color:#F0F0F0;">25.59</span></td>
