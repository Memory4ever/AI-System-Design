<p id="S2.F1.sf1.pic1.2.1" class="ltx_p"><math id="S2.F1.sf1.pic1.m2" class="ltx_Math" alttext="G_{0,\vartheta_{0},\theta}(\cdot,y)" display="inline" intent=":literal"><semantics><mrow><msub><mi>G</mi><mrow><mn>0</mn><mo>,</mo><msub><mi>ϑ</mi><mn>0</mn></msub><mo>,</mo><mi>θ</mi></mrow></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mo lspace="0em" rspace="0em">⋅</mo><mo>,</mo><mi>y</mi><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">G_{0,\vartheta_{0},\theta}(\cdot,y)</annotation></semantics></math></p>
</span></div></span></span></foreignObject></g></g><g stroke-width="1.0pt"><g style="--ltx-fill-color:#EBEBFF;" fill="#EBEBFF"><path style="stroke:none" d="M 127.99 -64.96 h 19.6 v 129.92 h -19.6 Z"></path></g><g style="--ltx-stroke-color:#000000;--ltx-fill-color:#000000;" fill="#000000" stroke="#000000" transform="matrix(1.0 0.0 0.0 1.0 132.61 -3.46)"><foreignObject style="--ltx-fo-width:0.75em;--ltx-fo-height:0.7em;--ltx-fo-depth:0.2em;font-size:10pt;" height="12.45" overflow="visible" transform="matrix(1 0 0 -1 0 9.69)" width="10.38"><span class="ltx_foreignobject_container"><span class="ltx_foreignobject_content"><span id="S2.F1.sf1.pic1.3" class="ltx_text">…</span></span></span></foreignObject></g></g><g stroke-width="1.0pt"><g style="--ltx-fill-color:#EBEBFF;" fill="#EBEBFF"><path d="M 133.25 -64.96 h 127.2 v 129.92 h -127.2 Z"></path></g><g style="--ltx-stroke-color:#000000;--ltx-fill-color:#000000;" fill="#000000" stroke="#000000" transform="matrix(1.0 0.0 0.0 1.0 137.86 -3.21)"><foreignObject style="--ltx-fo-width:1.04em;--ltx-fo-height:0.75em;--ltx-fo-depth:0.29em;font-size:10pt;" height="14.34" overflow="visible" transform="matrix(1 0 0 -1 0 10.38)" width="14.39"><span class="ltx_foreignobject_container"><span class="ltx_foreignobject_content">
